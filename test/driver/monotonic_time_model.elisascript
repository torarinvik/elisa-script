include "../../src/runtime/monotonic_time_model.elisa"

using EsMonotonicTime


@test
def elapsed_time_handles_nanosecond_borrow() -> void:
    elapsed: u64 = try monotonic_elapsed_microseconds(MonotonicTimestamp{seconds: 10, nanoseconds: 900000000}, MonotonicTimestamp{seconds: 11, nanoseconds: 100000000}) else err:
        assert false
        return
    assert elapsed == 200000u64


@test
def fractional_microseconds_round_up_for_deadline_safety() -> void:
    elapsed: u64 = try monotonic_elapsed_microseconds(MonotonicTimestamp{seconds: 7, nanoseconds: 100}, MonotonicTimestamp{seconds: 7, nanoseconds: 101}) else err:
        assert false
        return
    assert elapsed == 1u64


@test
def invalid_and_backwards_clock_samples_are_rejected() -> void:
    invalid_rejected: mutable bool = false
    catch validate_monotonic_timestamp(MonotonicTimestamp{seconds: 1, nanoseconds: 1000000000}):
        ok value:
            assert false
        error failure:
            assert failure == MonotonicTimeError.InvalidTimestamp
            invalid_rejected <- true
    assert invalid_rejected
    backwards_rejected: mutable bool = false
    catch monotonic_elapsed_microseconds(MonotonicTimestamp{seconds: 8, nanoseconds: 0}, MonotonicTimestamp{seconds: 7, nanoseconds: 999999999}):
        ok value:
            assert false
        error failure:
            assert failure == MonotonicTimeError.ClockMovedBackwards
            backwards_rejected <- true
    assert backwards_rejected


@test
def elapsed_microsecond_conversion_is_bounded() -> void:
    largest: u64 = try monotonic_elapsed_microseconds(MonotonicTimestamp{seconds: 0, nanoseconds: 0}, MonotonicTimestamp{seconds: 9223372036854, nanoseconds: 775807000}) else err:
        assert false
        return
    assert largest == Limits::MAX_MICROSECONDS
    overflow_rejected: mutable bool = false
    catch monotonic_elapsed_microseconds(MonotonicTimestamp{seconds: 0, nanoseconds: 0}, MonotonicTimestamp{seconds: 9223372036854, nanoseconds: 775807001}):
        ok value:
            assert false
        error failure:
            assert failure == MonotonicTimeError.DurationOverflow
            overflow_rejected <- true
    assert overflow_rejected
