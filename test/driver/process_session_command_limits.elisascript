include "../../src/runtime/process_model.elisa"
include "../../src/runtime/process_session_model.elisa"

using EsProcess
using EsProcessSession


@test
def session_inherits_the_command_capture_ceiling() -> void:
    command: ProcessCommand = ProcessCommand{executable: "git", stdout_mode: ProcessStdioMode.Capture, stderr_mode: ProcessStdioMode.Null, capture_output_limit_bytes: 4096}
    session: ProcessSession = try process_session_for_command(command) else err:
        assert false
        return
    assert session.max_output_bytes == 4096
    assert validate_process_session(session)


@test
def session_cannot_widen_the_command_capture_ceiling() -> void:
    command: ProcessCommand = ProcessCommand{executable: "git", stdout_mode: ProcessStdioMode.Capture, stderr_mode: ProcessStdioMode.Null, capture_output_limit_bytes: 4096}
    session: ProcessSession = ProcessSession{command: command, max_output_bytes: 4097}
    rejected: mutable bool = false
    catch validate_process_session(session):
        ok value:
            assert false
        error failure:
            assert failure == ProcessSessionError.InvalidLimit
            rejected <- true
    assert rejected


@test
def poll_elapsed_time_enforces_the_command_deadline() -> void:
    command: ProcessCommand = ProcessCommand{executable: "git", stdout_mode: ProcessStdioMode.Capture, stderr_mode: ProcessStdioMode.Null, timeout_micros: 100u64}
    session: mutable ProcessSession = try process_session_for_command(command) else err:
        assert false
        return
    assert advance_process_session(session, ProcessSessionEvent.Spawn, child_resource_id: 1, stdout_resource_id: 2) == ProcessSessionState.Running
    missing_sample_rejected: mutable bool = false
    catch advance_process_session(session, ProcessSessionEvent.Poll):
        ok state:
            assert false
        error failure:
            assert failure == ProcessSessionError.ClockSampleMissing
            missing_sample_rejected <- true
    assert missing_sample_rejected
    assert session.polls == 0 and session.elapsed_micros == 0u64
    assert advance_process_session(session, ProcessSessionEvent.Poll, elapsed_micros_delta: 99u64, elapsed_sampled: true) == ProcessSessionState.Running
    assert advance_process_session(session, ProcessSessionEvent.Poll, elapsed_micros_delta: 1u64, elapsed_sampled: true) == ProcessSessionState.TimingOut
    assert session.elapsed_micros == 100u64
    assert session.result_kind == ProcessResultKind.TimedOut
    assert advance_process_session(session, ProcessSessionEvent.TimeoutAck) == ProcessSessionState.TimedOut
    assert validate_process_session(session)


@test
def deadline_overshoot_saturates_at_timeout() -> void:
    command: ProcessCommand = ProcessCommand{executable: "git", stdout_mode: ProcessStdioMode.Capture, stderr_mode: ProcessStdioMode.Null, timeout_micros: 100u64}
    session: mutable ProcessSession = try process_session_for_command(command) else err:
        assert false
        return
    assert advance_process_session(session, ProcessSessionEvent.Spawn, child_resource_id: 1, stdout_resource_id: 2) == ProcessSessionState.Running
    assert advance_process_session(session, ProcessSessionEvent.Poll, elapsed_micros_delta: 18446744073709551615u64, elapsed_sampled: true) == ProcessSessionState.TimingOut
    assert session.elapsed_micros == 100u64
    assert advance_process_session(session, ProcessSessionEvent.TimeoutAck) == ProcessSessionState.TimedOut
    assert validate_process_session(session)


@test
def command_can_exit_before_deadline() -> void:
    command: ProcessCommand = ProcessCommand{executable: "git", stdout_mode: ProcessStdioMode.Capture, stderr_mode: ProcessStdioMode.Null, timeout_micros: 100u64}
    session: mutable ProcessSession = try process_session_for_command(command) else err:
        assert false
        return
    assert advance_process_session(session, ProcessSessionEvent.Spawn, child_resource_id: 1, stdout_resource_id: 2) == ProcessSessionState.Running
    assert advance_process_session(session, ProcessSessionEvent.Poll, elapsed_micros_delta: 99u64, elapsed_sampled: true) == ProcessSessionState.Running
    assert advance_process_session(session, ProcessSessionEvent.Exit, result_kind: ProcessResultKind.Exited, exit_status: 0) == ProcessSessionState.Exited
    assert session.elapsed_micros == 99u64
    assert validate_process_session(session)


@test
def timeout_ack_requires_cleanup_to_be_pending() -> void:
    command: ProcessCommand = ProcessCommand{executable: "git", stdout_mode: ProcessStdioMode.Capture, stderr_mode: ProcessStdioMode.Null, timeout_micros: 100u64}
    session: mutable ProcessSession = try process_session_for_command(command) else err:
        assert false
        return
    assert advance_process_session(session, ProcessSessionEvent.Spawn, child_resource_id: 1, stdout_resource_id: 2) == ProcessSessionState.Running
    rejected: mutable bool = false
    catch advance_process_session(session, ProcessSessionEvent.TimeoutAck):
        ok state:
            assert false
        error failure:
            assert failure == ProcessSessionError.TimeoutNotReady
            rejected <- true
    assert rejected
    assert session.state == ProcessSessionState.Running
