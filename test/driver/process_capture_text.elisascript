# The registry's sview spelling must accept both literals and typed text values.
def main(arguments: darray[sview]) -> i64:
    empty_input: sview = ""
    literal: ProcessCapture = capture_process_result(exe"printf", ["%s", "alpha beta"], "")
    typed: ProcessCapture = capture_process_result(exe"printf", ["%s", "gamma"], empty_input)
    if literal.exit_status != 0 or typed.exit_status != 0:
        return 1
    if literal.stdout != "alpha beta" or typed.stdout != "gamma":
        return 2
    if literal.stderr != "" or typed.stderr != "":
        return 3
    failure_status: i64 = run_process(exe"false", [])
    return 0 if failure_status == 1 else 4
