include "../../src/runtime/lua_bundle_publication_model.elisa"

using EsLuaBundlePublication


def unlink_error_is_not_reported_as_clean_cleanup() -> bool can[Memory.Allocate, Abort.Panic]:
    request: PublicationRequest = PublicationRequest{destination: "build/meta.json", staging: "build/.meta.json.tmp", directory: "build", bytes: 3}
    session: mutable PublicationSession = PublicationSession{request: request}
    parent_proof: PublicationParentProof = PublicationParentProof{device: 7, inode: 11, descriptor_token: 23, owner_token: 19, directory: true}
    staging_proof: PublicationStagingProof = PublicationStagingProof{device: 7, inode: 13, parent_device: 7, parent_inode: 11, descriptor_token: 29, owner_token: 19, link_count: 1, regular: true, private_mode: true}

    _ = try advance_publication(session, PublicationEvent.Begin) else err:
        return false
    _ = try advance_publication(session, PublicationEvent.StageCreated, 0, true, true, true, true, false, parent_proof, staging_proof, true) else err:
        return false
    _ = try advance_publication(session, PublicationEvent.Close) else err:
        return false

    uncertain: PublicationState = try advance_publication(session, PublicationEvent.StageRemoveOutcomeUnknown) else err:
        return false
    return false if uncertain != PublicationState.CleanupUncertain or not session.stage_entry_removal_uncertain
    return false if session.parent_descriptor_owned or session.descriptor_owned

    action_rejected: mutable bool = false
    catch advance_publication(session, PublicationEvent.Fail):
        ok state:
            assert false
        error failure:
            action_rejected <- failure == PublicationError.CleanupUncertain
    return action_rejected


def main(_arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic]:
    return 0i64 if unlink_error_is_not_reported_as_clean_cleanup()
    return 1i64
