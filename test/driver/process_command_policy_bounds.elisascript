include "../../src/runtime/process_model.elisa"

using EsProcess


@test
def accepts_explicit_finite_process_policy() -> void:
    command: ProcessCommand = ProcessCommand{executable: "git", timeout_micros: 5000000u64, capture_output_limit_bytes: 65536}
    assert validate_process_command(command)


@test
def rejects_process_timeout_outside_signed_clock_range() -> void:
    command: ProcessCommand = ProcessCommand{executable: "git", timeout_micros: PROCESS_COMMAND_MAX_TIMEOUT_MICROS + 1u64}
    rejected: mutable bool = false
    catch validate_process_command(command):
        ok value:
            assert false
        error failure:
            assert failure == ProcessCommandError.TimeoutLimitExceeded
            rejected <- true
    assert rejected


@test
def rejects_process_capture_limit_above_runtime_ceiling() -> void:
    command: ProcessCommand = ProcessCommand{executable: "git", capture_output_limit_bytes: PROCESS_COMMAND_MAX_CAPTURE_OUTPUT_BYTES + 1}
    rejected: mutable bool = false
    catch validate_process_command(command):
        ok value:
            assert false
        error failure:
            assert failure == ProcessCommandError.CaptureLimitExceeded
            rejected <- true
    assert rejected
