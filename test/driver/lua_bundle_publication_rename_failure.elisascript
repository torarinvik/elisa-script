include "../../src/runtime/lua_bundle_publication_model.elisa"

using EsLuaBundlePublication


def confirmed_rename_failure_is_retryable_as_failure() -> bool can[Memory.Allocate, Abort.Panic]:
    request: PublicationRequest = PublicationRequest{destination: "build/meta.json", staging: "build/.meta.json.tmp", directory: "build", bytes: 3}
    session: mutable PublicationSession = PublicationSession{request: request}
    parent_proof: PublicationParentProof = PublicationParentProof{device: 7, inode: 11, descriptor_token: 23, owner_token: 19, directory: true}
    staging_proof: PublicationStagingProof = PublicationStagingProof{device: 7, inode: 13, parent_device: 7, parent_inode: 11, descriptor_token: 29, owner_token: 19, link_count: 1, regular: true, private_mode: true}

    begun: PublicationState = try advance_publication(session, PublicationEvent.Begin) else err:
        return false
    return false if begun != PublicationState.Staging
    staged: PublicationState = try advance_publication(session, PublicationEvent.StageCreated, 0, true, true, true, true, false, parent_proof, staging_proof, true) else err:
        return false
    return false if staged != PublicationState.Staging
    written: PublicationState = try advance_publication(session, PublicationEvent.Write, 3) else err:
        return false
    return false if written != PublicationState.Staging
    synced: PublicationState = try advance_publication(session, PublicationEvent.Sync) else err:
        return false
    return false if synced != PublicationState.Staged
    publishing: PublicationState = try advance_publication(session, PublicationEvent.Publish) else err:
        return false
    return false if publishing != PublicationState.Publishing

    rejected: PublicationState = try advance_publication(session, PublicationEvent.PublishFailed) else err:
        return false
    return false if rejected != PublicationState.Staged or not session.destination_preserved_on_failure
    closed: PublicationState = try advance_publication(session, PublicationEvent.Close) else err:
        return false
    return false if closed != PublicationState.Staged or not session.parent_descriptor_closed or not session.descriptor_closed
    failed: PublicationState = try advance_publication(session, PublicationEvent.Fail) else err:
        return false
    return failed == PublicationState.Failed and session.destination_preserved_on_failure


def main(_arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic]:
    return 0i64 if confirmed_rename_failure_is_retryable_as_failure()
    return 1i64
