include "../../src/runtime/lua_bundle_publication_model.elisa"

using EsLuaBundlePublication


def close_failure_is_not_reported_as_a_clean_close() -> bool can[Memory.Allocate, Abort.Panic]:
    request: PublicationRequest = PublicationRequest{destination: "build/meta.json", staging: "build/.meta.json.tmp", directory: "build", bytes: 3}
    session: mutable PublicationSession = PublicationSession{request: request}
    parent_proof: PublicationParentProof = PublicationParentProof{device: 7, inode: 11, descriptor_token: 23, owner_token: 19, directory: true}
    staging_proof: PublicationStagingProof = PublicationStagingProof{device: 7, inode: 13, parent_device: 7, parent_inode: 11, descriptor_token: 29, owner_token: 19, link_count: 1, regular: true, private_mode: true}

    _ = try advance_publication(session, PublicationEvent.Begin) else err:
        return false
    _ = try advance_publication(session, PublicationEvent.StageCreated, 0, true, true, true, true, false, parent_proof, staging_proof, true) else err:
        return false
    _ = try advance_publication(session, PublicationEvent.Write, 3) else err:
        return false
    _ = try advance_publication(session, PublicationEvent.Sync) else err:
        return false
    _ = try advance_publication(session, PublicationEvent.Publish) else err:
        return false
    _ = try advance_publication(session, PublicationEvent.PublishAck, directory_synced: true) else err:
        return false

    closed: PublicationState = try advance_publication(session, PublicationEvent.CloseOutcomeUnknown, stage_close_succeeded: true, parent_close_succeeded: false) else err:
        return false
    return false if closed != PublicationState.CleanupUncertain
    return false if not session.rename_acknowledged or not session.descriptor_closed or not session.parent_descriptor_close_uncertain
    return false if session.descriptor_owned or session.parent_descriptor_owned or session.parent_descriptor_closed

    further_action_rejected: mutable bool = false
    catch advance_publication(session, PublicationEvent.Fail):
        ok state:
            assert false
        error failure:
            further_action_rejected <- failure == PublicationError.CleanupUncertain
    return further_action_rejected


def main(_arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic]:
    return 0i64 if close_failure_is_not_reported_as_a_clean_close()
    return 1i64
