# A value block keeps its helper binding private; a function tail returns the
# resulting value without an explicit `return` statement.
def answer() -> i64:
    value: i64 =
        hidden: i64 = 41
        hidden + 1
    value


def main(arguments: darray[sview]) -> i64:
    result: ProcessCapture =
        empty_input: sview = ""
        capture_process_result(executable("/usr/bin/true"), [], empty_input)
    result.exit_status + answer() - 42
