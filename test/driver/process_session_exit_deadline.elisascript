include "../../src/runtime/process_model.elisa"
include "../../src/runtime/process_session_model.elisa"

using EsProcess
using EsProcessSession


@test
def finite_deadline_exit_requires_a_clock_sample() -> void:
    command: ProcessCommand = ProcessCommand{executable: "git", stdout_mode: ProcessStdioMode.Capture, stderr_mode: ProcessStdioMode.Null, timeout_micros: 100u64}
    session: mutable ProcessSession = try process_session_for_command(command) else err:
        assert false
        return
    assert advance_process_session(session, ProcessSessionEvent.Spawn, child_resource_id: 1, stdout_resource_id: 2) == ProcessSessionState.Running
    rejected: mutable bool = false
    catch advance_process_session(session, ProcessSessionEvent.Exit, result_kind: ProcessResultKind.Exited, exit_status: 0):
        ok state:
            assert false
        error failure:
            assert failure == ProcessSessionError.ClockSampleMissing
            rejected <- true
    assert rejected
    assert session.state == ProcessSessionState.Running and session.elapsed_micros == 0u64


@test
def exit_observed_at_deadline_enters_timeout_cleanup() -> void:
    command: ProcessCommand = ProcessCommand{executable: "git", stdout_mode: ProcessStdioMode.Capture, stderr_mode: ProcessStdioMode.Null, timeout_micros: 100u64}
    session: mutable ProcessSession = try process_session_for_command(command) else err:
        assert false
        return
    assert advance_process_session(session, ProcessSessionEvent.Spawn, child_resource_id: 1, stdout_resource_id: 2) == ProcessSessionState.Running
    assert advance_process_session(session, ProcessSessionEvent.Poll, elapsed_micros_delta: 99u64, elapsed_sampled: true) == ProcessSessionState.Running
    assert advance_process_session(session, ProcessSessionEvent.Exit, result_kind: ProcessResultKind.Exited, exit_status: 0, elapsed_micros_delta: 1u64, elapsed_sampled: true) == ProcessSessionState.TimingOut
    assert session.elapsed_micros == 100u64 and session.result_kind == ProcessResultKind.TimedOut and session.exit_status == 0
    assert advance_process_session(session, ProcessSessionEvent.TimeoutAck) == ProcessSessionState.TimedOut
    assert validate_process_session(session)


@test
def exit_observed_before_deadline_preserves_exit_status() -> void:
    command: ProcessCommand = ProcessCommand{executable: "git", stdout_mode: ProcessStdioMode.Capture, stderr_mode: ProcessStdioMode.Null, timeout_micros: 100u64}
    session: mutable ProcessSession = try process_session_for_command(command) else err:
        assert false
        return
    assert advance_process_session(session, ProcessSessionEvent.Spawn, child_resource_id: 1, stdout_resource_id: 2) == ProcessSessionState.Running
    assert advance_process_session(session, ProcessSessionEvent.Exit, result_kind: ProcessResultKind.Exited, exit_status: 7, elapsed_micros_delta: 99u64, elapsed_sampled: true) == ProcessSessionState.Exited
    assert session.elapsed_micros == 99u64 and session.exit_status == 7
    assert validate_process_session(session)
