include "../../src/runtime/process_model.elisa"
include "../../src/runtime/lua_bundle_metadata_model.elisa"

using EsProcess
using EsLuaBundleMetadata


def empty_repo_root_uses_current_directory() -> bool can[Memory.Allocate, Abort.Panic]:
    parsed: MetadataArguments = try parse_metadata_arguments(["--output", "metadata.json", "--bundle-type", "profile", "--repo-root", "", "--out-dir", "build"]) else err:
        return false

    git: ProcessCommand = try metadata_host_command(MetadataHostCommandKind.GitHead, parsed.repo_root) else err:
        return false

    return parsed.repo_root == "" and git.working_directory == "."


def main(_arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic]:
    return 0i64 if empty_repo_root_uses_current_directory()
    return 1i64
