include "../../vendor/elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../../vendor/elisa-compiler/src/lexer/lexer.elisa"


def expect_kind(tokens: darray[Token], index: usize, expected: TokenKind) -> bool:
    false return if index >= tokens.count
    return tokens[index].kind == expected


def expect_text(source: u8&, tokens: darray[Token], index: usize, expected: static u8&) -> bool:
    false return if index >= tokens.count
    actual: sview = get Lexer::text(tokens[index], source) else return false
    return actual == expected


@test
def shebang_is_source_metadata() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "#!/usr/bin/env elisascript\ndef main() -> void:\n    pass\n"
        tokens: darray[Token] = frontend_tokenize("hello.elisascript", source)

        assert expect_kind(tokens, 0, TokenKind.Def)
        assert tokens[0].line == 2

        comments: darray[Token] = frontend_tokenize_comments_with_length(
            "hello.elisascript",
            source,
            Lexer::cstring_length(source)
        )
        assert comments.count == 0


@test
def typed_literal_prefixes_remain_regular_elisa_tokens() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "path\"src/main.elisa\" glob\"**/*.elisa\" regex\"[a-z]+\" exe\"git\" url\"https://example.com\"\n"
        tokens: darray[Token] = frontend_tokenize("literals.elisascript", source)

        assert expect_kind(tokens, 0, TokenKind.Ident)
        assert expect_text(source, tokens, 0, "path")
        assert expect_kind(tokens, 1, TokenKind.StringLit)
        assert expect_text(source, tokens, 1, "src/main.elisa")

        assert expect_kind(tokens, 2, TokenKind.Ident)
        assert expect_text(source, tokens, 2, "glob")
        assert expect_kind(tokens, 3, TokenKind.StringLit)
        assert expect_text(source, tokens, 3, "**/*.elisa")

        assert expect_kind(tokens, 4, TokenKind.Ident)
        assert expect_text(source, tokens, 4, "regex")
        assert expect_kind(tokens, 5, TokenKind.StringLit)
        assert expect_text(source, tokens, 5, "[a-z]+")

        assert expect_kind(tokens, 6, TokenKind.Ident)
        assert expect_text(source, tokens, 6, "exe")
        assert expect_kind(tokens, 7, TokenKind.StringLit)
        assert expect_text(source, tokens, 7, "git")

        assert expect_kind(tokens, 8, TokenKind.Ident)
        assert expect_text(source, tokens, 8, "url")
        assert expect_kind(tokens, 9, TokenKind.StringLit)
        assert expect_text(source, tokens, 9, "https://example.com")
        assert expect_kind(tokens, 10, TokenKind.Newline)
        assert expect_kind(tokens, 11, TokenKind.Eof)


@test
def octal_literals_are_integer_tokens() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "0o755 0O7_55u64 0o12\n"
        tokens: darray[Token] = frontend_tokenize("octal.elisascript", source)

        assert expect_kind(tokens, 0, TokenKind.IntLit)
        assert expect_text(source, tokens, 0, "0o755")
        assert expect_kind(tokens, 1, TokenKind.IntLit)
        assert expect_text(source, tokens, 1, "0O7_55")
        assert expect_kind(tokens, 2, TokenKind.IntLit)
        assert expect_text(source, tokens, 2, "0o12")
        assert expect_kind(tokens, 3, TokenKind.Newline)
        assert expect_kind(tokens, 4, TokenKind.Eof)


@test
def binary_literals_are_integer_tokens() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "0b1010 0B1_010u16 0b1\n"
        tokens: darray[Token] = frontend_tokenize("binary.elisascript", source)

        assert expect_kind(tokens, 0, TokenKind.IntLit)
        assert expect_text(source, tokens, 0, "0b1010")
        assert expect_kind(tokens, 1, TokenKind.IntLit)
        assert expect_text(source, tokens, 1, "0B1_010")
        assert expect_kind(tokens, 2, TokenKind.IntLit)
        assert expect_text(source, tokens, 2, "0b1")
        assert expect_kind(tokens, 3, TokenKind.Newline)
        assert expect_kind(tokens, 4, TokenKind.Eof)


@test
def invalid_octal_digits_are_single_error_tokens() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "0o8 + 1\n"
        tokens: darray[Token] = frontend_tokenize("invalid-octal.elisascript", source)

        assert expect_kind(tokens, 0, TokenKind.Error)
        assert expect_text(source, tokens, 0, "0o8")
        assert expect_kind(tokens, 1, TokenKind.Plus)
        assert expect_kind(tokens, 2, TokenKind.IntLit)
        assert expect_kind(tokens, 3, TokenKind.Newline)
        assert expect_kind(tokens, 4, TokenKind.Eof)


@test
def invalid_binary_digits_are_single_error_tokens() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "0b2 - 1\n"
        tokens: darray[Token] = frontend_tokenize("invalid-binary.elisascript", source)

        assert expect_kind(tokens, 0, TokenKind.Error)
        assert expect_text(source, tokens, 0, "0b2")
        assert expect_kind(tokens, 1, TokenKind.Minus)
        assert expect_kind(tokens, 2, TokenKind.IntLit)
        assert expect_kind(tokens, 3, TokenKind.Newline)
        assert expect_kind(tokens, 4, TokenKind.Eof)


@test
def adjacent_triple_literals_span_newlines_without_changing_block_comments() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "\"\"\" block comment \"\"\"\nregex\"\"\"first line\nsecond \\d+\"\"\"\n"
        tokens: darray[Token] = frontend_tokenize("multiline.elisascript", source)
        assert expect_kind(tokens, 0, TokenKind.Ident)
        assert expect_text(source, tokens, 0, "regex")
        assert expect_kind(tokens, 1, TokenKind.StringLit)
        assert expect_text(source, tokens, 1, "first line\nsecond \\d+")
        assert tokens[1].line == 2
        assert expect_kind(tokens, 2, TokenKind.Newline)
        assert expect_kind(tokens, 3, TokenKind.Eof)

        comments: darray[Token] = frontend_tokenize_comments_with_length(
            "multiline.elisascript",
            source,
            Lexer::cstring_length(source)
        )
        assert comments.count == 1


@test
def adjacent_triple_literals_preserve_escaped_quote_runs() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "regex\"\"\"quote \\\"\"\" still\"\"\"\n"
        tokens: darray[Token] = frontend_tokenize("escaped-delimiter.elisascript", source)
        assert expect_kind(tokens, 0, TokenKind.Ident)
        assert expect_kind(tokens, 1, TokenKind.StringLit)
        assert expect_text(source, tokens, 1, "quote \\\"\"\" still")
        assert expect_kind(tokens, 2, TokenKind.Newline)
        assert expect_kind(tokens, 3, TokenKind.Eof)
