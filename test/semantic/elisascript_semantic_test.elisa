include "../../vendor/elisa-compiler/src/semantic/semantic.elisa"

using Ast


def check_script(source: u8&) -> Semantic::SymbolTable:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        tokens: darray[Token] = frontend_tokenize("test.elisascript", source)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        assert file.errors.count == 0
        return Semantic::check(file)


def diagnostic_count(table: Semantic::SymbolTable&, kind: Semantic::DiagnosticKind) -> usize:
    count: mutable usize = 0
    for diagnostic in table.diagnostics |count|:
        count <- count + 1 if diagnostic.kind == kind
    return count


def builtin_return_type(table: Semantic::SymbolTable&, name: sview) -> sview:
    for symbol in table.symbols:
        symbol.return_type return if symbol.kind == Semantic::SymbolKind.Func and symbol.name == name
    return ""


@test
def typed_literals_resolve_and_have_nominal_types() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script() -> void:\n    p = path\"src/main.elisa\"\n    g = glob\"src/**/*.elisa\"\n    r = regex\"(?<name>[a-z]+)\"\n    e = exe\"git\"\n    u = url\"https://example.com/path\"\n"
        table: Semantic::SymbolTable = check_script(source)

        assert diagnostic_count(table, Semantic::DiagnosticKind.UndefinedName) == 0
        assert diagnostic_count(table, Semantic::DiagnosticKind.InvalidTypedLiteral) == 0
        assert builtin_return_type(table, "path") == "Path"
        assert builtin_return_type(table, "glob") == "Glob"
        assert builtin_return_type(table, "regex") == "Regex"
        assert builtin_return_type(table, "exe") == "Executable"
        assert builtin_return_type(table, "url") == "Url"


@test
def malformed_typed_literals_are_compile_time_diagnostics() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script() -> void:\n    p = path\"\"\n    g = glob\"src/[abc\"\n    r = regex\"(abc\"\n    e = exe\"/usr/bin/git\"\n    u = url\"example.com\"\n"
        table: Semantic::SymbolTable = check_script(source)

        assert diagnostic_count(table, Semantic::DiagnosticKind.InvalidTypedLiteral) == 5

        first_message: darray[u8] = Semantic::diagnostic_message(table.diagnostics[0])
        assert first_message.count > 0


@test
def typed_literal_result_participates_in_type_checking() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script() -> void:\n    good: Path = path\"src\"\n    bad: i64 = path\"src\"\n"
        table: Semantic::SymbolTable = check_script(source)

        assert diagnostic_count(table, Semantic::DiagnosticKind.UnknownTypeName) == 0
        assert diagnostic_count(table, Semantic::DiagnosticKind.TypeMismatch) == 1
