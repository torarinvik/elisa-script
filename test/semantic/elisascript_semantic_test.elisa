    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def link(target: Path, link_path: Path) -> bool:\n    return create_symlink(target, link_path)\n\ndef resume_clause(payload: i64) -> i64:\n    return resume(\"echo\", payload)\n"
