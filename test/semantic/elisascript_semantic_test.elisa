        assert diagnostic_count(table, Semantic::DiagnosticKind.UndefinedName) == 0
        assert semantic_error_count(table) == 0


@test
def qualified_python_filesystem_calls_preserve_static_result_types() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script(path_value: Path) -> void:\n    size: usize = os.path.getsize(path_value)\n    changed: i64 = os.path.getmtime(path_value)\n    present: bool = os.path.exists(path_value)\n    working: Path = os.getcwd()\n    entries: darray[sview] = os.listdir(path_value)\n    copied: bool = shutil.copyfile(path_value, path_value)\n"
        table: Semantic::SymbolTable = check_script(source)

        assert semantic_error_count(table) == 0

        invalid_source: static u8& = "def invalid(path_value: Path) -> void:\n    wrong: bool = os.path.getsize(path_value)\n"
        invalid: Semantic::SymbolTable = check_script(invalid_source)
        assert diagnostic_count(invalid, Semantic::DiagnosticKind.TypeMismatch) == 1


@test
def qualified_subprocess_calls_preserve_typed_process_results() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script(arguments: darray[sview]) -> void:\n    command: Executable = subprocess.executable(\"tool\")\n    status: i64 = subprocess.run(command, arguments)\n    output: sview = subprocess.capture_stdout(command, arguments)\n    captured: ProcessCapture = subprocess.capture_result(command, arguments, \"\")\n    exit_status: i64 = subprocess.exit_status(captured)\n    captured_output: sview = subprocess.stdout(captured)\n    observe(status)\n    observe(output)\n    observe(exit_status)\n    observe(captured_output)\n"
        table: Semantic::SymbolTable = check_script(source)

        assert diagnostic_count(table, Semantic::DiagnosticKind.UnknownFieldAccess) == 0
        assert semantic_error_count(table) == 0

        invalid_source: static u8& = "def invalid(command: Executable, arguments: darray[sview]) -> void:\n    wrong: bool = subprocess.run(command, arguments)\n"
        invalid: Semantic::SymbolTable = check_script(invalid_source)
        assert diagnostic_count(invalid, Semantic::DiagnosticKind.TypeMismatch) == 1


@test
def direct_scripting_builtins_preserve_static_result_types() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script(values: darray[i64], text: sview, path_value: Path) -> void:\n    count: usize = len(values)\n    rendered: sview = str(1)\n    parsed: i64 = parse_int(\"1\")\n    ratio: f64 = parse_float(\"1.0\")\n    present: bool = path_exists(path_value)\n    normalized: Path = normpath(path_value)\n    command: Executable = executable(\"tool\")\n    observe(count)\n    observe(rendered)\n    observe(parsed)\n    observe(ratio)\n    observe(present)\n    observe(normalized)\n    observe(command)\n"
        table: Semantic::SymbolTable = check_script(source)

        assert semantic_error_count(table) == 0

        invalid_source: static u8& = "def invalid(values: darray[i64]) -> void:\n    wrong: bool = len(values)\n"
        invalid: Semantic::SymbolTable = check_script(invalid_source)
        assert diagnostic_count(invalid, Semantic::DiagnosticKind.TypeMismatch) == 1

        invalid_executable_source: static u8& = "def invalid_executable() -> void:\n    wrong: Path = executable(\"tool\")\n"
        invalid_executable: Semantic::SymbolTable = check_script(invalid_executable_source)
        assert diagnostic_count(invalid_executable, Semantic::DiagnosticKind.TypeMismatch) == 1


@test
def direct_builtin_result_typing_respects_source_shadowing() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def len() -> bool:\n    return true\n\ndef script() -> void:\n    value: bool = len()\n"
        table: Semantic::SymbolTable = check_script(source)

        assert semantic_error_count(table) == 0


@test
def numeric_polymorphic_builtin_result_types_are_preserved() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script(value: i64, ratio: f64, flags: darray[bool]) -> void:\n    magnitude: i64 = abs(value)\n    decimal: f64 = abs(ratio)\n    all_flags: bool = all(flags)\n    any_flags: bool = any(flags)\n    observe(magnitude)\n    observe(decimal)\n    observe(all_flags)\n    observe(any_flags)\n"
        table: Semantic::SymbolTable = check_script(source)

        assert semantic_error_count(table) == 0

        invalid_source: static u8& = "def invalid(value: i64) -> void:\n    wrong: bool = abs(value)\n"
        invalid: Semantic::SymbolTable = check_script(invalid_source)
        assert diagnostic_count(invalid, Semantic::DiagnosticKind.TypeMismatch) == 1


@test
def source_effect_operation_is_known_to_the_source_semantic_pass() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "effect Writer:\n    def write(value: sview) -> void\n\ndef emit(value: sview) -> void can[Writer.write]:\n    signal Writer.write(value)\n"
        table: Semantic::SymbolTable = check_script(source)

        assert diagnostic_count(table, Semantic::DiagnosticKind.UnknownPermissionMember) == 0


