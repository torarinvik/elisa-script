@test
def qualified_python_filesystem_calls_preserve_static_result_types() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script(path_value: Path) -> void:\n    size: usize = os.path.getsize(path_value)\n    changed: i64 = os.path.getmtime(path_value)\n    present: bool = os.path.exists(path_value)\n    working: Path = os.getcwd()\n    entries: darray[sview] = os.listdir(path_value)\n    copied: bool = shutil.copyfile(path_value, path_value)\n"
        table: Semantic::SymbolTable = check_script(source)

        assert semantic_error_count(table) == 0

        invalid_source: static u8& = "def invalid(path_value: Path) -> void:\n    wrong: bool = os.path.getsize(path_value)\n"
        invalid: Semantic::SymbolTable = check_script(invalid_source)
        assert diagnostic_count(invalid, Semantic::DiagnosticKind.TypeMismatch) == 1


@test
def qualified_subprocess_calls_preserve_typed_process_results() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script(arguments: darray[sview]) -> void:\n    command: Executable = subprocess.executable(\"tool\")\n    status: i64 = subprocess.run(command, arguments)\n    output: sview = subprocess.capture_stdout(command, arguments)\n    captured: ProcessCapture = subprocess.capture_result(command, arguments, \"\")\n    exit_status: i64 = subprocess.exit_status(captured)\n    captured_output: sview = subprocess.stdout(captured)\n    observe(status)\n    observe(output)\n    observe(exit_status)\n    observe(captured_output)\n"
        table: Semantic::SymbolTable = check_script(source)

        assert diagnostic_count(table, Semantic::DiagnosticKind.UnknownFieldAccess) == 0
        assert semantic_error_count(table) == 0

        invalid_source: static u8& = "def invalid(command: Executable, arguments: darray[sview]) -> void:\n    wrong: bool = subprocess.run(command, arguments)\n"
        invalid: Semantic::SymbolTable = check_script(invalid_source)
        assert diagnostic_count(invalid, Semantic::DiagnosticKind.TypeMismatch) == 1


@test
def qualified_regex_calls_preserve_python_pattern_first_types() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script() -> void:\n    pattern: Regex = regex\"[a-z]+\"\n    searched: bool = re.search(pattern, \"abc\")\n    matched: bool = re.match(pattern, \"abc\")\n    full: bool = re.fullmatch(pattern, \"abc\")\n    found: darray[sview] = re.findall(pattern, \"abc 123\")\n    fields: darray[sview] = re.split(regex\"[ ]+\", \"a b\")\n    replaced: sview = re.sub(regex\"[0-9]+\", \"#\", \"id=42\")\n    observe(searched)\n    observe(matched)\n    observe(full)\n    observe(found)\n    observe(fields)\n    observe(replaced)\n"
        table: Semantic::SymbolTable = check_script(source)

        assert diagnostic_count(table, Semantic::DiagnosticKind.UnknownFieldAccess) == 0
        assert semantic_error_count(table) == 0

        invalid_source: static u8& = "def invalid(pattern: Regex) -> void:\n    wrong: bool = re.findall(pattern, \"abc\")\n"
        invalid: Semantic::SymbolTable = check_script(invalid_source)
        assert diagnostic_count(invalid, Semantic::DiagnosticKind.TypeMismatch) == 1


@test
def direct_scripting_builtins_preserve_static_result_types() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script(values: darray[i64], text: sview, path_value: Path) -> void:\n    count: usize = len(values)\n    rendered: sview = str(1)\n    parsed: i64 = parse_int(\"1\")\n    ratio: f64 = parse_float(\"1.0\")\n    present: bool = path_exists(path_value)\n    normalized: Path = normpath(path_value)\n    command: Executable = executable(\"tool\")\n    printed: usize = print(\"value\")\n    line: usize = println(\"line\")\n    shell_alias: usize = echo(\"shell\")\n    diagnostic: usize = eprint(\"error\")\n    observe(count)\n    observe(rendered)\n    observe(parsed)\n    observe(ratio)\n    observe(present)\n    observe(normalized)\n    observe(command)\n    observe(printed)\n    observe(line)\n    observe(shell_alias)\n    observe(diagnostic)\n"
        table: Semantic::SymbolTable = check_script(source)

        assert semantic_error_count(table) == 0

        invalid_source: static u8& = "def invalid(values: darray[i64]) -> void:\n    wrong: bool = len(values)\n"
        invalid: Semantic::SymbolTable = check_script(invalid_source)
        assert diagnostic_count(invalid, Semantic::DiagnosticKind.TypeMismatch) == 1

        invalid_print_source: static u8& = "def invalid_print() -> void:\n    wrong: bool = print(\"value\")\n"
        invalid_print: Semantic::SymbolTable = check_script(invalid_print_source)
        assert diagnostic_count(invalid_print, Semantic::DiagnosticKind.TypeMismatch) == 1

        invalid_executable_source: static u8& = "def invalid_executable() -> void:\n    wrong: Path = executable(\"tool\")\n"
        invalid_executable: Semantic::SymbolTable = check_script(invalid_executable_source)
        assert diagnostic_count(invalid_executable, Semantic::DiagnosticKind.TypeMismatch) == 1


@test
def collection_and_capture_builtins_preserve_static_result_shapes() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script(path_value: Path, mapping: dict[sview, i64], values: darray[i64], text: sview) -> void:\n    bytes: darray[u8] = read_bytes(path_value)\n    entries: darray[sview] = list_directory(path_value)\n    matches: darray[sview] = expand_glob(glob\"src/*.elisa\")\n    fields: darray[sview] = split(text, \",\")\n    lines: darray[sview] = split_lines(text)\n    parts: darray[sview] = partition(text, \":\")\n    regex_fields: darray[sview] = split_regex(text, regex\"[ ]+\")\n    regex_matches: darray[sview] = find_regex(text, regex\"[a-z]+\")\n    captures: darray[sview] = capture_regex(text, regex\"(?<word>[a-z]+)\")\n    map_keys: darray[sview] = keys(mapping)\n    map_values: darray[i64] = values(mapping)\n    copied: darray[i64] = values.copy()\n    count: usize = values.count(1)\n    found: i64 = values.find(1)\n    text_index: i64 = text.index(\"x\")\n    path_entries: darray[sview] = path_value.glob(\"*.elisa\")\n    observe(bytes)\n    observe(entries)\n    observe(matches)\n    observe(fields)\n    observe(lines)\n    observe(parts)\n    observe(regex_fields)\n    observe(regex_matches)\n    observe(captures)\n    observe(map_keys)\n    observe(map_values)\n    observe(copied)\n    observe(count)\n    observe(found)\n    observe(text_index)\n    observe(path_entries)\n"
        table: Semantic::SymbolTable = check_script(source)

        assert semantic_error_count(table) == 0

        invalid_source: static u8& = "def invalid(path_value: Path) -> void:\n    wrong: bool = read_bytes(path_value)\n"
        invalid: Semantic::SymbolTable = check_script(invalid_source)
        assert diagnostic_count(invalid, Semantic::DiagnosticKind.TypeMismatch) == 1


@test
def receiver_methods_preserve_static_result_shapes() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script(path_value: Path, values: darray[i64], mapping: dict[sview, i64], text: sview) -> void:\n    parent: Path = path_value.parent()\n    renamed: Path = path_value.with_name(\"renamed\")\n    suffixed: Path = path_value.with_suffix(\".out\")\n    relative: Path = path_value.relative_to(path\".\")\n    normalized: Path = path_value.normalize()\n    absolute: Path = path_value.absolute()\n    resolved: Path = path_value.resolve()\n    name: sview = path_value.name()\n    suffix: sview = path_value.suffix()\n    stem: sview = path_value.stem()\n    contents: sview = path_value.read_text()\n    bytes: darray[u8] = path_value.read_bytes()\n    written: usize = path_value.write_text(contents)\n    absolute_flag: bool = path_value.is_absolute()\n    readable: bool = path_value.is_readable()\n    copied: darray[i64] = values.copy()\n    count: usize = values.count(1)\n    found: i64 = values.find(1)\n    fields: darray[sview] = text.split(\",\")\n    parts: darray[sview] = text.partition(\":\")\n    starts: bool = text.startswith(\"x\")\n    letters: bool = text.isalpha()\n    pattern: Regex = regex\"[a-z]+\"\n    searched: bool = pattern.search(text)\n    matches: darray[sview] = pattern.findall(text)\n    captures: darray[sview] = pattern.capture(text)\n    regex_parts: darray[sview] = pattern.split(text)\n    replaced: sview = pattern.sub(\"#\", text)\n    map_keys: darray[sview] = mapping.keys()\n    map_values: darray[i64] = mapping.values()\n    observe(parent)\n    observe(renamed)\n    observe(suffixed)\n    observe(relative)\n    observe(normalized)\n    observe(absolute)\n    observe(resolved)\n    observe(name)\n    observe(suffix)\n    observe(stem)\n    observe(contents)\n    observe(bytes)\n    observe(written)\n    observe(absolute_flag)\n    observe(readable)\n    observe(copied)\n    observe(count)\n    observe(found)\n    observe(fields)\n    observe(parts)\n    observe(starts)\n    observe(letters)\n    observe(searched)\n    observe(matches)\n    observe(captures)\n    observe(regex_parts)\n    observe(replaced)\n    observe(map_keys)\n    observe(map_values)\n"
        table: Semantic::SymbolTable = check_script(source)

        assert semantic_error_count(table) == 0

        invalid_source: static u8& = "def invalid(path_value: Path) -> void:\n    wrong: bool = path_value.read_bytes()\n"
        invalid: Semantic::SymbolTable = check_script(invalid_source)
        assert diagnostic_count(invalid, Semantic::DiagnosticKind.TypeMismatch) == 1


@test
def collection_accessors_and_process_capture_fields_preserve_static_result_types() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script(values: mutable darray[i64], mapping: mutable dict[sview, i64], result: ProcessCapture) -> void:\n    removed: i64 = values.pop()\n    looked_up: i64 = mapping.get(\"key\", 0)\n    popped: i64 = mapping.pop(\"key\", 0)\n    defaulted: i64 = mapping.setdefault(\"key\", 0)\n    copied: dict[sview, i64] = mapping.copy()\n    status: i64 = result.returncode\n    exit_status: i64 = result.exit_status\n    output: sview = result.stdout\n    error_output: sview = result.stderr\n    observe(removed)\n    observe(looked_up)\n    observe(popped)\n    observe(defaulted)\n    observe(copied)\n    observe(status)\n    observe(exit_status)\n    observe(output)\n    observe(error_output)\n"
        table: Semantic::SymbolTable = check_script(source)

        assert semantic_error_count(table) == 0

        invalid_source: static u8& = "def invalid(values: darray[i64], mapping: dict[sview, i64], result: ProcessCapture) -> void:\n    wrong_pop: bool = values.pop()\n    wrong_copy: darray[i64] = mapping.copy()\n    wrong_status: sview = result.status\n"
        invalid: Semantic::SymbolTable = check_script(invalid_source)
        assert diagnostic_count(invalid, Semantic::DiagnosticKind.TypeMismatch) == 3


