@test
def source_effect_operation_payload_arity_is_checked() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "effect Writer:\n    def write(value: sview) -> void\n\ndef emit() -> void can[Writer.write]:\n    signal Writer.write\n"
        table: Semantic::SymbolTable = check_script(source)

        assert diagnostic_count(table, Semantic::DiagnosticKind.UnknownPermissionMember) == 1


@test
def source_effect_perform_operation_is_checked() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "effect Writer:\n    def write(value: sview) -> void\n\ndef emit(value: sview) -> void can[Writer.write]:\n    if true:\n        return perform(\"Writer.write\", value)\n"
        table: Semantic::SymbolTable = check_script(source)

        assert diagnostic_count(table, Semantic::DiagnosticKind.UnknownPermissionMember) == 0


@test
def source_effect_perform_unknown_operation_is_rejected() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "effect Writer:\n    def write(value: sview) -> void\n\ndef emit(value: sview) -> void can[Writer.write]:\n    return perform(\"Writer.flush\", value)\n"
        table: Semantic::SymbolTable = check_script(source)

        assert diagnostic_count(table, Semantic::DiagnosticKind.UnknownPermissionMember) == 1


@test
def source_effect_perform_payload_arity_is_checked() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "effect Writer:\n    def write(value: sview) -> void\n\ndef emit() -> void can[Writer.write]:\n    return perform(\"Writer.write\")\n"
        table: Semantic::SymbolTable = check_script(source)

        assert diagnostic_count(table, Semantic::DiagnosticKind.UnknownPermissionMember) == 1


@test
def process_execution_variants_are_known_to_the_source_semantic_pass() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script() -> void:\n    run_process_with_stdin(exe\"tool\", [], \"input\")\n    run_process_in_directory(exe\"tool\", [], path\".\")\n    run_process_with_environment(exe\"tool\", [], {\"KEY\": \"value\"})\n    run_process_in_directory_with_environment(exe\"tool\", [], path\".\", {\"KEY\": \"value\"})\n    capture_process_pipeline([exe\"tool\"], [[]], \"input\")\n"
        table: Semantic::SymbolTable = check_script(source)

        assert diagnostic_count(table, Semantic::DiagnosticKind.UndefinedName) == 0
