@test
def polymorphic_collection_builtins_preserve_known_element_types() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def script(values: darray[i64]) -> void:\n    minimum: i64 = min(values)\n    maximum: i64 = max(values)\n    total: i64 = sum(values)\n    product_value: i64 = product(values, 1)\n    sorted_values: darray[i64] = sorted(values)\n    reversed_values: darray[i64] = reversed(values)\n    variadic_minimum: i64 = min(3, 1)\n    observe(minimum)\n    observe(maximum)\n    observe(total)\n    observe(product_value)\n    observe(sorted_values)\n    observe(reversed_values)\n    observe(variadic_minimum)\n"
