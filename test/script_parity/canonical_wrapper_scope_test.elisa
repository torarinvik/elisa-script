# No launcher, compiler, process runner or execution gate is imported.
include "canonical_wrapper_scope.elisa"

using EsCanonicalWrapperScope


@test
def canonical_lint_wave_excludes_larger_wrappers_and_unknown_sources() -> void:
    assert includes_reference(Wave.LintOnly, "lint_canonical.sh")
    assert not includes_reference(Wave.LintOnly, "test_canonical.sh")
    assert not includes_reference(Wave.LintOnly, "test_campaign.sh")
    assert includes_source(Wave.LintOnly, "scripts/lint_canonical.sh")
    assert includes_source(Wave.LintOnly, "scripts/lint_canonical.elisascript")
    assert includes_source(Wave.LintOnly, "scripts/lint_canonical_invocation.elisa")
    assert includes_source(Wave.LintOnly, "scripts/ruff-signal-probe.sh")
    assert includes_source(Wave.LintOnly, "scripts/pwd-environment-probe.sh")
    assert not includes_source(Wave.LintOnly, "scripts/canonical_test.elisascript")
    assert not includes_source(Wave.LintOnly, "scripts/test_canonical.elisascript")
    assert not includes_source(Wave.WrapperFamily, "scripts/unknown.elisascript")
    assert not includes_reference(Wave.WrapperFamily, "unknown.sh")


@test
def canonical_campaign_wave_isolates_the_small_forwarding_wrapper() -> void:
    assert includes_reference(Wave.CampaignOnly, "test_campaign.sh")
    assert not includes_reference(Wave.CampaignOnly, "test_canonical.sh")
    assert not includes_reference(Wave.CampaignOnly, "lint_canonical.sh")
    assert includes_source(Wave.CampaignOnly, "scripts/test_canonical.sh")
    assert includes_source(Wave.CampaignOnly, "scripts/test_campaign.sh")
    assert includes_source(Wave.CampaignOnly, "scripts/canonical_test.elisascript")
    assert includes_source(Wave.CampaignOnly, "scripts/test_campaign.elisascript")
    assert not includes_source(Wave.CampaignOnly, "scripts/test_canonical.elisascript")
    assert not includes_source(Wave.CampaignOnly, "scripts/lint_canonical.elisascript")
    assert not includes_source(Wave.CampaignOnly, "scripts/unknown.elisascript")


@test
def canonical_only_wave_selects_shared_mode_runner_without_campaign_shim() -> void:
    assert includes_reference(Wave.CanonicalOnly, "test_canonical.sh")
    assert not includes_reference(Wave.CanonicalOnly, "test_campaign.sh")
    assert not includes_reference(Wave.CanonicalOnly, "lint_canonical.sh")
    assert includes_source(Wave.CanonicalOnly, "scripts/test_canonical.sh")
    assert includes_source(Wave.CanonicalOnly, "scripts/canonical_test.elisascript")
    assert includes_source(Wave.CanonicalOnly, "scripts/test_canonical.elisascript")
    assert not includes_source(Wave.CanonicalOnly, "scripts/test_campaign.sh")
    assert not includes_source(Wave.CanonicalOnly, "scripts/test_campaign.elisascript")
    assert not includes_source(Wave.CanonicalOnly, "scripts/lint_canonical.elisascript")


@test
def canonical_wrapper_family_remains_an_explicit_larger_wave() -> void:
    assert includes_reference(Wave.WrapperFamily, "lint_canonical.sh")
    assert includes_reference(Wave.WrapperFamily, "test_canonical.sh")
    assert includes_reference(Wave.WrapperFamily, "test_campaign.sh")
    assert includes_source(Wave.WrapperFamily, "scripts/canonical_test.elisascript")
    assert includes_source(Wave.WrapperFamily, "scripts/test_canonical.elisascript")
    assert includes_source(Wave.WrapperFamily, "scripts/test_campaign.elisascript")
    assert includes_source(Wave.WrapperFamily, "scripts/test_canonical.sh")
    assert includes_source(Wave.WrapperFamily, "scripts/test_campaign.sh")


@test
def wrapper_wave_fixture_shapes_are_small_and_disjoint() -> void:
    can Memory.Allocate, Abort.Panic:
        selected_directories: darray[sview] = directories(Wave.LintOnly)
        selected_probes: darray[sview] = probes(Wave.LintOnly)
        assert selected_directories.count == 2 and selected_probes.count == 3
        assert selected_directories[0] == "scripts" and selected_directories[1] == "tools"
        assert selected_probes[0] == "tools/ruff" and selected_probes[1] == "tools/probe with spaces"
        assert selected_probes[2] == "tools/probe $HOME; '*.py' \"quoted\" \\tail"
        wider_directories: darray[sview] = directories(Wave.WrapperFamily)
        wider_probes: darray[sview] = probes(Wave.WrapperFamily)
        assert wider_directories.count == 4 and wider_probes.count == 4
        assert wider_directories[2] == ".venv" and wider_directories[3] == ".venv/bin"
        assert wider_probes[0] == ".venv/bin/python"
        assert wider_probes[3] == selected_probes[2]
        campaign_directories: darray[sview] = directories(Wave.CampaignOnly)
        assert campaign_directories.count == 4
        assert campaign_directories[0] == "scripts" and campaign_directories[1] == "tools"
        assert campaign_directories[2] == ".venv" and campaign_directories[3] == ".venv/bin"
        canonical_directories: darray[sview] = directories(Wave.CanonicalOnly)
        assert canonical_directories.count == 4
        assert canonical_directories[0] == "scripts" and canonical_directories[1] == "tools"
        assert canonical_directories[2] == ".venv" and canonical_directories[3] == ".venv/bin"
        campaign_probes: darray[sview] = probes(Wave.CampaignOnly)
        assert campaign_probes.count == 3
        assert campaign_probes[0] == ".venv/bin/python"
        assert campaign_probes[1] == "tools/probe with spaces"
        assert campaign_probes[2] == selected_probes[2]
        canonical_probes: darray[sview] = probes(Wave.CanonicalOnly)
        assert canonical_probes.count == 3
        assert canonical_probes[0] == campaign_probes[0] and canonical_probes[1] == campaign_probes[1]
        assert canonical_probes[2] == campaign_probes[2]
