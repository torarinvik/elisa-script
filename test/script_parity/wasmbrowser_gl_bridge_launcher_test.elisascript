# Dormant read-only GL-bridge parity check for WasmBrowser's real decision data.
# Every child launch requires explicit authorization and the external RSS guard.
include "../../src/testing/differential.elisa"
include "../../src/testing/checksum_record_model.elisa"
include "skia_environment_launcher_plan.elisa"

using EsDifferential


module EsWasmBrowserGlBridgeParity:
    private:
        const module Tools:
            PYTHON: sview = "/usr/bin/python3"
            PYTHON_SHA256: sview = "34129c71a01a74f7f3b2443521519b2e5447553fa187f5fcafaaf8c42cc192e2"
            SHA256: sview = "/usr/bin/shasum"
            SHA256_SHA256: sview = "0812595f981a26f813d98dc380af14d4af427626c9339eda29eb849ae13de1e3"
            COMPILER: sview = EsSkiaEnvironmentLauncherPlan::Pins::COMPILER
            PATH_VALUE: sview = "/usr/bin:/bin:/usr/sbin:/sbin"
            TIMEOUT_STEPS: u64 = 10000
            OUTPUT_BYTES: u64 = 65536
            PIN_BYTES: usize = 67108864
            SUCCESS: sview = "GL bridge evaluation valid: contract specified, bridge unselected, fixture prerequisite explicit\n"


        const module Paths:
            REFERENCE: sview = "test/compatibility/check_gl_bridge_evaluation.py"
            DOCUMENT: sview = "docs/gl-bridge-evaluation.json"
            CONTRACT: sview = "docs/gl-bridge-contract.md"
            CANDIDATE: sview = "scripts/check_wasmbrowser_gl_bridge_evaluation.elisascript"
            MODEL: sview = "src/runtime/gl_bridge_evaluation_model.elisa"
            ENCODING: sview = "src/runtime/encoding.elisa"
            DATA_MODEL: sview = "src/runtime/data_model.elisa"
            JSON_MODEL: sview = "src/runtime/json_model.elisa"
            JSON_LEXER: sview = "src/runtime/json_lexer_model.elisa"
            JSON_PARSER: sview = "src/runtime/json_parse_model.elisa"
            PYTHON_JSON_PROJECTION: sview = "src/runtime/python_json_projection.elisa"
            BOUNDED_TEXT: sview = "src/runtime/bounded_text_posix.elisa"
            FILE_RUNTIME: sview = "src/runtime/file_posix.elisa"
            DIRECTORY_RUNTIME: sview = "src/runtime/directory_posix.elisa"
            STDIO_RUNTIME: sview = "src/runtime/stdio_posix.elisa"
            LAUNCHER_PLAN: sview = "test/script_parity/skia_environment_launcher_plan.elisa"
            DIFFERENTIAL: sview = "src/testing/differential.elisa"
            CHECKSUM_MODEL: sview = "src/testing/checksum_record_model.elisa"


        struct Identity:
            path: sview
            sha256: sview


        struct Authorization:
            launcher: Identity
            compiler_sha256: sview


        error GateError:
            Disabled
            MissingGuard
            WrongCompiler
            InvalidIdentity


        def environment_value(name: sview) -> sview can[Environment.Read]:
            return try getenv(name, "") else ""


        def repository_root() -> Path error[GateError] can[Blocking.IO, Memory.Allocate, Unsafe.PointerCast]:
            test_file: Path = try path_real(path(Script::source_path())) else err:
                raise GateError.InvalidIdentity
            test_directory: Path = test_file.parent()
            return test_directory.parent().parent()


        def authorization() -> Authorization error[GateError] can[Environment.Read]:
            raise GateError.Disabled if environment_value("ELISASCRIPT_VALIDATION_REAUTHORIZED") != "1" or environment_value("ELISASCRIPT_WB_GL_BRIDGE_LAUNCHER_QUALIFIED") != "1"
            raise GateError.MissingGuard if environment_value("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD") != "active"
            raise GateError.WrongCompiler if environment_value("ELISA_LOCAL_COMPILER") != Tools::COMPILER or environment_value("ELISACORE_BIN") != Tools::COMPILER
            launcher: Identity = Identity{path: environment_value("ELISASCRIPT_PUBLIC_LAUNCHER"), sha256: environment_value("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256")}
            compiler_sha256: sview = environment_value("ELISASCRIPT_LOCAL_COMPILER_SHA256")
            try EsSkiaEnvironmentLauncherPlan::validate_roles(
                EsSkiaEnvironmentLauncherPlan::Identity{path: launcher.path, hash: launcher.sha256},
                EsSkiaEnvironmentLauncherPlan::Identity{path: Tools::PYTHON, hash: Tools::PYTHON_SHA256},
                compiler_sha256) else err:
                raise GateError.InvalidIdentity
            return Authorization{launcher: launcher, compiler_sha256: compiler_sha256}


        def valid_sha256(value: sview) -> bool:
            return EsSkiaEnvironmentLauncherPlan::valid_hash(value)


        def has_sha256(target: sview, expected: sview) -> bool can[Blocking.IO, Memory.Allocate, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if not valid_sha256(expected) or target == "" or target == "-" or len(target) > EsChecksumRecord::Limits::FILENAME_BYTES
            for byte in target:
                return false if byte == 0u8
            file: Path = path(target)
            return false if not is_file(file) or is_symlink(file)
            size: usize = try file_size(file) else err:
                return false
            return false if size == 0 or size > Tools::PIN_BYTES
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "wasmbrowser-gl-bridge-source-identity",
                target: Tools::SHA256,
                arguments: ["-a", "256", "-t", "--", target],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Tools::TIMEOUT_STEPS,
                max_output_bytes: Tools::OUTPUT_BYTES
            }
            observed: DifferentialRun = try run_differential_process(runner) else err:
                return false
            return false if observed.outcome != DifferentialRunOutcome.Completed or observed.error_text != "" or observed.exit_status != 0 or observed.stderr != ""
            return try EsChecksumRecord::sha256_text_record_matches(observed.stdout, expected, target) else false


        def native_artifact(target: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if not EsSkiaEnvironmentLauncherPlan::absolute_identity_path(target)
            file: Path = path(target)
            return false if not is_file(file) or is_symlink(file) or not is_executable(file)
            size: usize = try file_size(file) else err:
                return false
            return false if size < 4 or size > Tools::PIN_BYTES
            name: mutable darray[u8] = []
            for byte in target |name|:
                name.push(byte)
            name.push(0u8)
            mode: darray[u8] = [114u8, 98u8, 0u8]
            stream: mutable heap void&? = fopen(&name[0], &mode[0])
            return false if stream == null
            opened: mutable heap void& = stream
            header: mutable darray[u8] = [0u8, 0u8, 0u8, 0u8]
            amount: usize = fread((&header[0]).cast[mutable void&], 1, 4, opened)
            closed: int = fclose(opened)
            return amount == 4 and closed == 0 and EsSkiaEnvironmentLauncherPlan::native_container_header(header) and not is_symlink(file)


        def input_pins(root: Path) -> darray[Identity] can[Memory.Allocate, Abort.Panic]:
            project_root: Path = root.parent().joinpath("WasmBrowser")
            return [
                Identity{path: f"{project_root.joinpath(Paths::REFERENCE)}", sha256: "561442f7cb96ac14427e49212a4d9243143430fc8bfaa5cd0801df8f1492e5ed"},
                Identity{path: f"{project_root.joinpath(Paths::DOCUMENT)}", sha256: "b43421708221040ae171bbf425dec24b68711b98f5005f39c74aa186a5468d40"},
                Identity{path: f"{project_root.joinpath(Paths::CONTRACT)}", sha256: "857a58970b3a8bb103851fb313cbc3b5ce46e9e35910fe9bb6fa49be3160c9fd"},
                Identity{path: f"{root.joinpath(Paths::CANDIDATE)}", sha256: "83fb4613683e9ad3d1c92ab1158342049fa47f362abff40ad65a88ed9b64911c"},
                Identity{path: f"{root.joinpath(Paths::MODEL)}", sha256: "6ec3dbf10185ea0a61b64175eee3915cb93a957f9ff1b3ae24b71ef0094c7e4a"},
                Identity{path: f"{root.joinpath(Paths::ENCODING)}", sha256: "67815c728730d891c2e5fc0cc53a33d672d0f40003cfd468de903c4fbfcd9a53"},
                Identity{path: f"{root.joinpath(Paths::DATA_MODEL)}", sha256: "a2aa9cb5a80ea904f681c1f5e1eb7bf59a0afcf3ee381cd64e8461172dc9eca1"},
                Identity{path: f"{root.joinpath(Paths::JSON_MODEL)}", sha256: "cf6d6c74e0b19c9f5e2e622500e4dd5b6fbeb1b4824355418f0938c06a463947"},
                Identity{path: f"{root.joinpath(Paths::JSON_LEXER)}", sha256: "18a598afe996ff9249e46e0330b592b7cb1bfecec6983f8ba37e4ef8247d3667"},
                Identity{path: f"{root.joinpath(Paths::JSON_PARSER)}", sha256: "8ab7ff8004ffc945ba28fef703b8cad5c0dcff996f71f5ca41bbdb2c3fbb3438"},
                Identity{path: f"{root.joinpath(Paths::PYTHON_JSON_PROJECTION)}", sha256: "9deffc8d07ff5a6e3ae23c599adda50b17b693039bc6d5d4fd825fdd5f563e3d"},
                Identity{path: f"{root.joinpath(Paths::BOUNDED_TEXT)}", sha256: "a0c8d8144e4ebd9f90402489696b153bed6e7b292722ba2ca11eda551c27cda0"},
                Identity{path: f"{root.joinpath(Paths::FILE_RUNTIME)}", sha256: "14e1e3a9f0d95ee3e45509bd7d76c1ba2694992d5530f82edf8533d9cf149643"},
                Identity{path: f"{root.joinpath(Paths::DIRECTORY_RUNTIME)}", sha256: "065d21370e93a1487a5ccc0adcfff5dcc04aa78e98361de181eeb08dbc0d402d"},
                Identity{path: f"{root.joinpath(Paths::STDIO_RUNTIME)}", sha256: "c02cac5eec931a2f2aa9131616482df4e17333948961c4b6d0d215b0ab0e766c"},
                Identity{path: f"{root.joinpath(Paths::LAUNCHER_PLAN)}", sha256: "abab8c053a9b3db5e63521784d6296c335212bca217e46b0f4f449c5431a32ea"},
                Identity{path: f"{root.joinpath(Paths::DIFFERENTIAL)}", sha256: "ee6daaf3410af5e861c5e61205615a5cba62ca9636b73cf7fd245e00f8566e62"},
                Identity{path: f"{root.joinpath(Paths::CHECKSUM_MODEL)}", sha256: "1b3cec1235d42076e50b15491d3d6b906f3841ea966937779dc665f1e8a59488"}
            ]


        def pinned_inputs(auth: Authorization, root: Path) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast]:
            project_root: Path = root.parent().joinpath("WasmBrowser")
            return false if not is_directory(project_root) or is_symlink(project_root)
            return false if not native_artifact(Tools::COMPILER) or not native_artifact(Tools::PYTHON) or not native_artifact(auth.launcher.path)
            return false if not has_sha256(Tools::SHA256, Tools::SHA256_SHA256)
            return false if not has_sha256(Tools::PYTHON, Tools::PYTHON_SHA256) or not has_sha256(Tools::COMPILER, auth.compiler_sha256) or not has_sha256(auth.launcher.path, auth.launcher.sha256)
            for identity in input_pins(root):
                return false if not has_sha256(identity.path, identity.sha256)
            return true


        def exact_success(run: DifferentialRun) -> bool:
            return run.outcome == DifferentialRunOutcome.Completed and run.error_text == "" and run.exit_status == 0 and run.stdout == Tools::SUCCESS and run.stderr == ""


    public:
        def public_launcher_parity() -> bool can[Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Write, Console.Format]:
            auth: Authorization = try authorization() else err:
                _ = write_stderr("WasmBrowser GL-bridge parity: validation gate is not qualified\n")
                return false
            root: Path = try repository_root() else err:
                return false
            return false if not pinned_inputs(auth, root)

            wasmbrowser_root: Path = root.parent().joinpath("WasmBrowser")
            reference_path: sview = f"{wasmbrowser_root.joinpath(Paths::REFERENCE)}"
            candidate_path: sview = f"{root.joinpath(Paths::CANDIDATE)}"
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Tools::PATH_VALUE},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "PYTHONDONTWRITEBYTECODE", value: "1"}
            ]
            reference: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "wasmbrowser-gl-bridge-python-reference",
                target: Tools::PYTHON,
                arguments: ["-I", "-B", reference_path],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Tools::TIMEOUT_STEPS,
                max_output_bytes: Tools::OUTPUT_BYTES
            }
            candidate: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "wasmbrowser-gl-bridge-public-candidate",
                target: auth.launcher.path,
                arguments: EsSkiaEnvironmentLauncherPlan::candidate_arguments(candidate_path, []),
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Tools::TIMEOUT_STEPS,
                max_output_bytes: Tools::OUTPUT_BYTES
            }

            reference_run: DifferentialRun = try run_differential_process(reference) else err:
                return false
            return false if not exact_success(reference_run) or not pinned_inputs(auth, root)
            candidate_run: DifferentialRun = try run_differential_process(candidate) else err:
                return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return comparison.equal and exact_success(candidate_run) and pinned_inputs(auth, root)


@test
def wasmbrowser_gl_bridge_public_launcher_matches_pinned_python() -> void can[Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Write, Console.Format]:
    assert EsWasmBrowserGlBridgeParity::public_launcher_parity()
