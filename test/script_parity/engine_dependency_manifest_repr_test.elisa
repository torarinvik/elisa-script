include "../../ports/elisa-engine/scripts/dependency_manifest_repr_model.elisa"

using EsEngineDependencyManifestRepr


@test
def dependency_manifest_repr_selects_python_compatible_quotes() -> void can[Memory.Allocate, Abort.Panic]:
    assert string_repr("") == "''"
    assert string_repr("library") == "'library'"
    assert string_repr("O'Reilly") == "\"O'Reilly\""
    assert string_repr("say \"hi\"") == "'say \"hi\"'"
    assert string_repr("café") == "'café'"


@test
def dependency_manifest_repr_escapes_ascii_controls_and_backslashes() -> void can[Memory.Allocate, Abort.Panic]:
    assert string_repr("a\\b") == "'a\\\\b'"
    assert string_repr("a\x00\t\n\r\x7f") == "'a\\x00\\t\\n\\r\\x7f'"


@test
def dependency_manifest_repr_escapes_common_unicode_nonprintables() -> void can[Memory.Allocate, Abort.Panic]:
    assert string_repr("\xc2\x85") == "'\\x85'"
    assert string_repr("\xc2\xa0") == "'\\xa0'"
    assert string_repr("\xe2\x80\x8b") == "'\\u200b'"
    assert string_repr("\xe2\x80\xa8") == "'\\u2028'"
    assert string_repr("\xee\x80\x80") == "'\\ue000'"
    assert string_repr("\xf0\x9f\x98\x80") == "'\xf0\x9f\x98\x80'"
    assert string_repr("\xcd\xb7") == "'\xcd\xb7'"
    assert string_repr("\xcd\xb8") == "'\\u0378'"
    assert string_repr("\xe1\x9a\x80") == "'\\u1680'"
    assert string_repr("\xe3\x80\x80") == "'\\u3000'"
