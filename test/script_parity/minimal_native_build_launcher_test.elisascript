            stale_symlink_ready <- stale_symlink_ready and (try symlink(stale_symlink_target, obsolete_header) else false)
            stale_symlink_cache_before: darray[u8] = try read_bytes(candidate_cache) else err:
                print("minimal native parity: could not snapshot cache before stale symlink refusal")
                _ = remove_workspace(workspace)
                return false
            stale_symlink_rejected: mutable bool = false
            if stale_symlink_ready:
                catch run_process(tools.launcher, candidate_variant_arguments, repository_text, "elisascript-refuses-stale-output-symlink", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                    ok stale_symlink_run:
                        stale_symlink_rejected <- stale_symlink_run.outcome == DifferentialRunOutcome.Completed and stale_symlink_run.exit_status == 1 and stale_symlink_run.stdout == "" and stale_symlink_run.stderr == "minimal native build: build graph execution failed before completion\n"
                    error failure:
                        stale_symlink_rejected <- false
            stale_symlink_target_after: sview = try read_text(stale_symlink_target) else ""
            stale_symlink_cache_after: darray[u8] = try read_bytes(candidate_cache) else err:
                print("minimal native parity: stale symlink refusal removed the prior cache")
                _ = remove_workspace(workspace)
                return false
            if not stale_symlink_ready or not stale_symlink_rejected or not is_symlink(obsolete_header) or stale_symlink_target_after != stale_symlink_contents or not byte_arrays_equal(stale_symlink_cache_before, stale_symlink_cache_after):
                print("minimal native parity: stale-output symlink or its target was not preserved")
                _ = remove_workspace(workspace)
                return false

            remove_stale_symlink: darray[sview] = ["-E", "rm", "-f", f"{obsolete_header}"]
            if not run_checked_process(tools.cmake, remove_stale_symlink, repository_text, "remove-stale-output-symlink", environment):
                _ = remove_workspace(workspace)
                return false
            restore_stale_regular_output: darray[sview] = ["-E", "copy", f"{elisa_generated_header}", f"{obsolete_header}"]
            if not run_checked_process(tools.cmake, restore_stale_regular_output, repository_text, "restore-stale-output-after-symlink", environment):
                _ = remove_workspace(workspace)
                return false
            stale_symlink_recovery: mutable bool = false
            catch run_process(tools.launcher, candidate_variant_arguments, repository_text, "elisascript-cleans-restored-stale-output", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok symlink_recovery_run:
                    stale_symlink_recovery <- symlink_recovery_run.outcome == DifferentialRunOutcome.Completed and symlink_recovery_run.exit_status == 0 and symlink_recovery_run.stdout == "build_cache=up_to_date\n" and symlink_recovery_run.stderr == ""
                error failure:
                    stale_symlink_recovery <- false
            if not stale_symlink_recovery or is_file(obsolete_header):
                print("minimal native parity: build did not recover after preserving a stale symlink")
                _ = remove_workspace(workspace)
                return false

            stale_directory_target_matches: mutable bool = false
            catch run_process(tools.launcher, obsolete_target_arguments, repository_text, "elisascript-restore-obsolete-target-for-directory-case", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok stale_directory_target_run:
                    stale_directory_target_matches <- stale_directory_target_run.outcome == DifferentialRunOutcome.Completed and stale_directory_target_run.exit_status == 0 and stale_directory_target_run.stdout == "build_cache=rebuilt\nrebuilt=obsolete-config-copy\n" and stale_directory_target_run.stderr == ""
                error failure:
                    stale_directory_target_matches <- false
            remove_obsolete_for_directory: darray[sview] = ["-E", "rm", "-f", f"{obsolete_header}"]
            if not stale_directory_target_matches or not run_checked_process(tools.cmake, remove_obsolete_for_directory, repository_text, "prepare-stale-output-directory", environment) or not (try create_directory(obsolete_header) else false):
                print("minimal native parity: could not prepare directory at stale output path")
                _ = remove_workspace(workspace)
                return false
            stale_directory_cache_before: darray[u8] = try read_bytes(candidate_cache) else err:
                print("minimal native parity: could not snapshot cache before stale directory refusal")
                _ = remove_workspace(workspace)
                return false
            stale_directory_rejected: mutable bool = false
            catch run_process(tools.launcher, candidate_variant_arguments, repository_text, "elisascript-refuses-stale-output-directory", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok stale_directory_run:
                    stale_directory_rejected <- stale_directory_run.outcome == DifferentialRunOutcome.Completed and stale_directory_run.exit_status == 1 and stale_directory_run.stdout == "" and stale_directory_run.stderr == "minimal native build: build graph execution failed before completion\n"
                error failure:
                    stale_directory_rejected <- false
            stale_directory_cache_after: darray[u8] = try read_bytes(candidate_cache) else err:
                print("minimal native parity: stale directory refusal removed the prior cache")
                _ = remove_workspace(workspace)
                return false
            if not stale_directory_rejected or not is_directory(obsolete_header) or not byte_arrays_equal(stale_directory_cache_before, stale_directory_cache_after):
                print("minimal native parity: non-regular stale output or cache was not preserved")
                _ = remove_workspace(workspace)
                return false
            if not (try remove_directory(obsolete_header) else false):
                print("minimal native parity: could not remove isolated stale output directory")
                _ = remove_workspace(workspace)
                return false
            restore_stale_regular_after_directory: darray[sview] = ["-E", "copy", f"{elisa_generated_header}", f"{obsolete_header}"]
            if not run_checked_process(tools.cmake, restore_stale_regular_after_directory, repository_text, "restore-stale-output-after-directory", environment):
                _ = remove_workspace(workspace)
                return false
            stale_directory_recovery: mutable bool = false
            catch run_process(tools.launcher, candidate_variant_arguments, repository_text, "elisascript-cleans-restored-stale-output-directory", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok stale_directory_recovery_run:
                    stale_directory_recovery <- stale_directory_recovery_run.outcome == DifferentialRunOutcome.Completed and stale_directory_recovery_run.exit_status == 0 and stale_directory_recovery_run.stdout == "build_cache=up_to_date\n" and stale_directory_recovery_run.stderr == ""
                error failure:
                    stale_directory_recovery <- false
            if not stale_directory_recovery or is_file(obsolete_header):
                print("minimal native parity: build did not recover after preserving a stale output directory")
                _ = remove_workspace(workspace)
                return false

            candidate_executable: Path = elisa_build.joinpath("minimal-native")
            main_object_seed: Path = elisa_build.joinpath("main.o.byte-identical-seed")
            candidate_executable_text: sview = canonical_external_file(f"{candidate_executable}", repository_text)
            cache_before_no_write: darray[u8] = try read_bytes(candidate_cache) else err:
                print("minimal native parity: could not snapshot cache before no-write compile")
                _ = remove_workspace(workspace)
                return false
            no_write_arguments: darray[sview] = [build_script_text, elisa_build_text, "no-write-compile"]
            no_write_compile_rejected: mutable bool = false
            catch run_process(tools.launcher, no_write_arguments, repository_text, "elisascript-rejects-successful-no-write-compile", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok no_write_run:
                    expected_no_write_error: sview = "minimal native build: target compile-main failed\n  declared output missing: " + f"{candidate_main_object}" + "\n"
                    no_write_compile_rejected <- no_write_run.outcome == DifferentialRunOutcome.Completed and no_write_run.exit_status == 1 and no_write_run.stdout == "" and no_write_run.stderr == expected_no_write_error
                error failure:
                    no_write_compile_rejected <- false
            cache_after_no_write: darray[u8] = try read_bytes(candidate_cache) else err:
                print("minimal native parity: no-write compile removed the previous cache")
                _ = remove_workspace(workspace)
                return false
            if not no_write_compile_rejected or is_file(elisa_build.joinpath("generated_build_config.h")) or is_file(candidate_main_object) or not is_file(candidate_executable) or not byte_arrays_equal(cache_before_no_write, cache_after_no_write):
                print("minimal native parity: successful command without its declared output was accepted or damaged prior outputs")
                _ = remove_workspace(workspace)
                return false
            no_write_binary_preserved: mutable bool = false
            if candidate_executable_text != "":
                catch run_executable(candidate_executable_text, elisa_build_text, "elisascript-binary-preserved-after-no-write-compile"):
                    ok no_write_binary_run:
                        no_write_binary_preserved <- process_succeeded(no_write_binary_run) and no_write_binary_run.stdout == "answer=42\n" and no_write_binary_run.stderr == ""
                    error failure:
                        no_write_binary_preserved <- false
            if not no_write_binary_preserved:
                print("minimal native parity: previous executable did not survive successful no-write compile")
                _ = remove_workspace(workspace)
                return false
            no_write_retry_matches: mutable bool = false
            catch run_process(tools.launcher, candidate_variant_arguments, repository_text, "elisascript-recovers-after-successful-no-write-compile", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok no_write_retry_run:
                    no_write_retry_matches <- no_write_retry_run.outcome == DifferentialRunOutcome.Completed and no_write_retry_run.exit_status == 0 and no_write_retry_run.stdout == "build_cache=rebuilt\nrebuilt=generate-config-header\nrebuilt=compile-main\nrebuilt=minimal-native\n" and no_write_retry_run.stderr == ""
                error failure:
                    no_write_retry_matches <- false
            no_write_retry_noop: mutable bool = false
            if no_write_retry_matches:
                catch run_process(tools.launcher, candidate_variant_arguments, repository_text, "elisascript-noop-after-no-write-compile-recovery", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                    ok no_write_noop_run:
                        no_write_retry_noop <- no_write_noop_run.outcome == DifferentialRunOutcome.Completed and no_write_noop_run.exit_status == 0 and no_write_noop_run.stdout == "build_cache=up_to_date\n" and no_write_noop_run.stderr == ""
                    error failure:
                        no_write_retry_noop <- false
            if not no_write_retry_matches or not no_write_retry_noop:
                print("minimal native parity: build did not recover after successful no-write compile")
                _ = remove_workspace(workspace)
                return false

            seed_main_object_arguments: darray[sview] = ["-E", "copy", f"{candidate_main_object}", f"{main_object_seed}"]
            if not run_checked_process(tools.cmake, seed_main_object_arguments, repository_text, "seed-byte-identical-object", environment):
                _ = remove_workspace(workspace)
                return false
            byte_identical_seed: darray[u8] = try read_bytes(main_object_seed) else err:
                print("minimal native parity: could not read byte-identical object seed")
                _ = remove_workspace(workspace)
                return false
            byte_identical_arguments: darray[sview] = [build_script_text, elisa_build_text, "byte-identical-variant"]
            byte_identical_rebuild_matches: mutable bool = false
            catch run_process(tools.launcher, byte_identical_arguments, repository_text, "elisascript-accepts-byte-identical-rebuild", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok byte_identical_run:
                    byte_identical_rebuild_matches <- byte_identical_run.outcome == DifferentialRunOutcome.Completed and byte_identical_run.exit_status == 0 and byte_identical_run.stdout == "build_cache=rebuilt\nrebuilt=compile-main\nrebuilt=minimal-native\n" and byte_identical_run.stderr == ""
                error failure:
                    byte_identical_rebuild_matches <- false
            byte_identical_object: darray[u8] = try read_bytes(candidate_main_object) else err:
                print("minimal native parity: rebuilt object is missing after byte-identical compile")
                _ = remove_workspace(workspace)
                return false
            if not byte_identical_rebuild_matches or not byte_arrays_equal(byte_identical_seed, byte_identical_object):
                print("minimal native parity: byte-identical output was not accepted after rebuild")
                _ = remove_workspace(workspace)
                return false
            byte_identical_noop: mutable bool = false
            catch run_process(tools.launcher, byte_identical_arguments, repository_text, "elisascript-cache-hit-after-byte-identical-rebuild", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok byte_identical_noop_run:
                    byte_identical_noop <- byte_identical_noop_run.outcome == DifferentialRunOutcome.Completed and byte_identical_noop_run.exit_status == 0 and byte_identical_noop_run.stdout == "build_cache=up_to_date\n" and byte_identical_noop_run.stderr == ""
                error failure:
                    byte_identical_noop <- false
            if not byte_identical_noop:
                print("minimal native parity: byte-identical rebuild did not produce a reusable cache")
                _ = remove_workspace(workspace)
                return false

            restore_standard_compiler: mutable bool = false
            catch run_process(tools.launcher, candidate_variant_arguments, repository_text, "elisascript-restores-standard-compiler-recipe", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok standard_compiler_run:
                    restore_standard_compiler <- standard_compiler_run.outcome == DifferentialRunOutcome.Completed and standard_compiler_run.exit_status == 0 and standard_compiler_run.stdout == "build_cache=rebuilt\nrebuilt=compile-main\nrebuilt=minimal-native\n" and standard_compiler_run.stderr == ""
                error failure:
                    restore_standard_compiler <- false
            if not restore_standard_compiler:
                print("minimal native parity: standard compiler recipe was not restored")
                _ = remove_workspace(workspace)
                return false
            remove_byte_identical_seed_arguments: darray[sview] = ["-E", "rm", "-f", f"{main_object_seed}"]
            if not run_checked_process(tools.cmake, remove_byte_identical_seed_arguments, repository_text, "remove-byte-identical-object-seed", environment):
                _ = remove_workspace(workspace)
                return false

            cache_before_failure: darray[u8] = try read_bytes(candidate_cache) else err:
                print("minimal native parity: could not snapshot cache before partial compile failure")
                _ = remove_workspace(workspace)
                return false
            partial_compile_arguments: darray[sview] = [build_script_text, elisa_build_text, "partial-fail-compile"]
            compile_failure_matches: mutable bool = false
            catch run_process(tools.launcher, partial_compile_arguments, repository_text, "elisascript-compile-failure-cleans-started-outputs", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok failed_compile_run:
                    compile_failure_matches <- failed_compile_run.outcome == DifferentialRunOutcome.Completed and failed_compile_run.exit_status == 1 and failed_compile_run.stdout == "" and failed_compile_run.stderr == "minimal native build: target compile-main failed\n  exit status: 1\n  stdout:\npartial-object-created\n"
                error failure:
                    compile_failure_matches <- false
            if not compile_failure_matches or is_file(variant_generated_header) or is_file(candidate_main_object) or not is_file(candidate_executable):
                print("minimal native parity: failed graph did not clean started outputs or preserve later unstarted outputs")
                _ = remove_workspace(workspace)
                return false
            cache_after_failure: darray[u8] = try read_bytes(candidate_cache) else err:
                print("minimal native parity: failed build removed the prior cache")
                _ = remove_workspace(workspace)
                return false
            if not byte_arrays_equal(cache_before_failure, cache_after_failure):
                print("minimal native parity: failed build replaced the prior cache")
                _ = remove_workspace(workspace)
                return false

            preserved_binary_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_executable(candidate_executable_text, elisa_build_text, "elisascript-binary-preserved-after-compile-failure"):
                ok value:
                    preserved_binary_run <- value
                error failure:
                    print("minimal native parity: preserved executable could not run after compile failure")
                    _ = remove_workspace(workspace)
                    return false
            if not process_succeeded(preserved_binary_run) or preserved_binary_run.stdout != "answer=42\n" or preserved_binary_run.stderr != "":
                print("minimal native parity: compile failure damaged the previous executable")
                _ = remove_workspace(workspace)
                return false

            recovered_after_failure: mutable bool = false
            catch run_process(tools.launcher, candidate_variant_arguments, repository_text, "elisascript-recover-after-partial-compile-failure", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok recovered_run:
                    recovered_after_failure <- recovered_run.outcome == DifferentialRunOutcome.Completed and recovered_run.exit_status == 0 and recovered_run.stdout == "build_cache=rebuilt\nrebuilt=generate-config-header\nrebuilt=compile-main\nrebuilt=minimal-native\n" and recovered_run.stderr == ""
                error failure:
                    recovered_after_failure <- false
            if not recovered_after_failure:
                print("minimal native parity: build did not recover from partial compile failure")
                _ = remove_workspace(workspace)
                return false

            recovered_cache_noop: mutable bool = false
            catch run_process(tools.launcher, candidate_variant_arguments, repository_text, "elisascript-noop-after-partial-compile-recovery", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok recovered_noop:
                    recovered_cache_noop <- recovered_noop.outcome == DifferentialRunOutcome.Completed and recovered_noop.exit_status == 0 and recovered_noop.stdout == "build_cache=up_to_date\n" and recovered_noop.stderr == ""
                error failure:
                    recovered_cache_noop <- false
            if not recovered_cache_noop:
                print("minimal native parity: partial-compile recovery cache was not reusable")
                _ = remove_workspace(workspace)
                return false

            cache_before_generator_failure: darray[u8] = try read_bytes(candidate_cache) else err:
                print("minimal native parity: could not snapshot cache before generator failure")
                _ = remove_workspace(workspace)
                return false
            partial_generator_arguments: darray[sview] = [build_script_text, elisa_build_text, "partial-fail-generator"]
            generator_failure_matches: mutable bool = false
            catch run_process(tools.launcher, partial_generator_arguments, repository_text, "elisascript-generator-failure-cleans-partial-header", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok failed_generator_run:
                    generator_failure_matches <- failed_generator_run.outcome == DifferentialRunOutcome.Completed and failed_generator_run.exit_status == 1 and failed_generator_run.stdout == "" and failed_generator_run.stderr == "minimal native build: target generate-config-header failed\n  exit status: 1\n  stdout:\npartial-header-created\n"
                error failure:
                    generator_failure_matches <- false
            cache_after_generator_failure: darray[u8] = try read_bytes(candidate_cache) else err:
                print("minimal native parity: generator failure removed the prior cache")
                _ = remove_workspace(workspace)
                return false
            if not generator_failure_matches or is_file(variant_generated_header) or not is_file(candidate_main_object) or not is_file(candidate_executable) or not byte_arrays_equal(cache_before_generator_failure, cache_after_generator_failure):
                print("minimal native parity: failed generator did not clean only its started output and preserve the prior cache")
                _ = remove_workspace(workspace)
                return false
            generator_preserved_binary_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_executable(candidate_executable_text, elisa_build_text, "elisascript-binary-preserved-after-generator-failure"):
                ok generator_preserved_binary_run_value:
                    generator_preserved_binary_run <- generator_preserved_binary_run_value
                error failure:
                    print("minimal native parity: preserved executable could not run after generator failure")
                    _ = remove_workspace(workspace)
                    return false
            if not process_succeeded(generator_preserved_binary_run) or generator_preserved_binary_run.stdout != "answer=42\n" or generator_preserved_binary_run.stderr != "":
                print("minimal native parity: generator failure damaged the previous executable")
                _ = remove_workspace(workspace)
                return false
            generator_recovery_matches: mutable bool = false
            catch run_process(tools.launcher, candidate_variant_arguments, repository_text, "elisascript-recovers-after-partial-generator-failure", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok recovered_generator_run:
                    generator_recovery_matches <- recovered_generator_run.outcome == DifferentialRunOutcome.Completed and recovered_generator_run.exit_status == 0 and recovered_generator_run.stdout == "build_cache=rebuilt\nrebuilt=generate-config-header\nrebuilt=compile-main\nrebuilt=minimal-native\n" and recovered_generator_run.stderr == ""
                error failure:
                    generator_recovery_matches <- false
            generator_recovery_noop: mutable bool = false
            if generator_recovery_matches:
                catch run_process(tools.launcher, candidate_variant_arguments, repository_text, "elisascript-noop-after-generator-recovery", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                    ok generator_noop_run:
                        generator_recovery_noop <- generator_noop_run.outcome == DifferentialRunOutcome.Completed and generator_noop_run.exit_status == 0 and generator_noop_run.stdout == "build_cache=up_to_date\n" and generator_noop_run.stderr == ""
                    error failure:
                        generator_recovery_noop <- false
            if not generator_recovery_matches or not generator_recovery_noop:
                print("minimal native parity: build did not recover from partial generator failure")
                _ = remove_workspace(workspace)
                return false

            reference_binary: Path = cmake_build.joinpath("minimal-native")
            candidate_binary: Path = elisa_build.joinpath("minimal-native")
            reference_library: Path = cmake_build.joinpath("libminimal-answer.a")
            candidate_library: Path = elisa_build.joinpath("libminimal-answer.a")
            reference_binary_text: sview = canonical_external_file(f"{reference_binary}", repository_text)
            candidate_binary_text: sview = canonical_external_file(f"{candidate_binary}", repository_text)
            reference_library_text: sview = canonical_external_file(f"{reference_library}", repository_text)
            candidate_library_text: sview = canonical_external_file(f"{candidate_library}", repository_text)
            if reference_binary_text == "" or candidate_binary_text == "" or reference_binary_text == candidate_binary_text or reference_library_text == "" or candidate_library_text == "" or reference_library_text == candidate_library_text:
                print("minimal native parity: one or both build routes omitted the expected library or executable")
                _ = remove_workspace(workspace)
                return false

            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_executable(reference_binary_text, cmake_build_text, "cmake-minimal-native"):
                ok value:
                    reference_run <- value
                error failure:
                    print("minimal native parity: unable to run CMake executable")
                    _ = remove_workspace(workspace)
                    return false

            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_executable(candidate_binary_text, elisa_build_text, "elisascript-minimal-native"):
                ok value:
                    candidate_run <- value
                error failure:
                    print("minimal native parity: unable to run ElisaScript executable")
                    _ = remove_workspace(workspace)
                    return false

            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            matches: bool = process_succeeded(reference_run) and process_succeeded(candidate_run) and comparison.equal
            matches <- reference_run.stdout == "answer=42\n" and reference_run.stderr == "" and matches
            matches <- candidate_run.stdout == "answer=42\n" and candidate_run.stderr == "" and matches
            if not matches:
                print("minimal native parity: executable status/stdout/stderr mismatch")
            cleanup_ok: bool = remove_workspace(workspace)
            return matches and cleanup_ok


@test
def minimal_native_cmake_and_elisascript_builds_match_process_behavior() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        cmake: sview = try getenv("ELISASCRIPT_MINIMAL_NATIVE_CMAKE", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsMinimalNativeBuildParity::pinned_compiler_path()
        assert elisacore_bin == EsMinimalNativeBuildParity::pinned_compiler_path()
        assert cmake != ""
        assert launcher != ""

        script_directory: Path = try path_real(Script::source_path().parent()) else err:
            assert false
            return
        repository_root: Path = script_directory.parent().parent()
        assert EsMinimalNativeBuildParity::build_and_compare(repository_root)
