# Compare the independently built CMake and ElisaScript E01 executables.
# Run only through scripts/run_bounded_test.sh after explicit reauthorization.
# This fixture runs the two binaries only; it never starts a compiler or build.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsMinimalNativeBuildParity:
    private:
        const module Limits:
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            CONTROLLED_PATH: sview = "/usr/bin:/bin"
            TIMEOUT_STEPS: u64 = 10000
            MAX_OUTPUT_BYTES: u64 = 4096
            MAX_EXECUTABLE_BYTES: usize = 67108864


        struct Executables:
            reference: sview
            candidate: sview
            reference_directory: sview
            candidate_directory: sview


        def path_is_within(root: sview, candidate: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if root == candidate
            prefix: sview = if root == "/": "/" else root + "/"
            return candidate.startswith(prefix)


        def canonical_executable(raw_path: sview, repository_root: sview) -> sview can[Blocking.IO, Memory.Allocate, Abort.Panic, File.Read, Directory.Read]:
            input: Path = path(raw_path)
            return "" if not path_is_absolute(input) or is_symlink(input) or not is_file(input)
            input_size: usize = try file_size(input) else err:
                return ""
            return "" if input_size == 0 or input_size > Limits::MAX_EXECUTABLE_BYTES
            resolved: Path = try path_real(input) else err:
                return ""
            resolved_text: sview = f"{resolved}"
            return "" if path_is_within(repository_root, resolved_text)
            return resolved_text


        def executables_from_environment(repository_root: sview) -> Executables can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Environment.Read, File.Read, Directory.Read]:
            reference_argument: sview = try getenv("ELISASCRIPT_MINIMAL_NATIVE_CMAKE_BINARY", "") else err:
                ""
            candidate_argument: sview = try getenv("ELISASCRIPT_MINIMAL_NATIVE_ELISA_BINARY", "") else err:
                ""
            reference: sview = canonical_executable(reference_argument, repository_root)
            candidate: sview = canonical_executable(candidate_argument, repository_root)
            return Executables{reference: "", candidate: "", reference_directory: "", candidate_directory: ""} if reference == "" or candidate == "" or reference == candidate
            reference_directory: sview = f"{path(reference).parent()}"
            candidate_directory: sview = f"{path(candidate).parent()}"
            return Executables{reference: "", candidate: "", reference_directory: "", candidate_directory: ""} if reference_directory == candidate_directory
            return Executables{reference: reference, candidate: candidate, reference_directory: reference_directory, candidate_directory: candidate_directory}


        def run_executable(target: sview, working_directory: sview, name: sview) -> DifferentialRun error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: name,
                target: target,
                arguments: [],
                working_directory: working_directory,
                environment: [
                    DifferentialEnvironmentEntry{name: "PATH", value: Limits::CONTROLLED_PATH},
                    DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                    DifferentialEnvironmentEntry{name: "LANG", value: "C"}
                ],
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                stdin: "",
                timeout_steps: Limits::TIMEOUT_STEPS,
                max_output_bytes: Limits::MAX_OUTPUT_BYTES
            }
            return try run_differential_process(runner)


    public:
        def pinned_compiler_path() -> sview:
            return Limits::PINNED_COMPILER


        def binaries_match(repository_root: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Environment.Read, File.Read, Directory.Read, Unsafe.PointerCast]:
            executables: Executables = executables_from_environment(repository_root)
            return false if executables.reference == "" or executables.candidate == ""

            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_executable(executables.reference, executables.reference_directory, "cmake-minimal-native"):
                ok value:
                    reference_run <- value
                error failure:
                    eprint("minimal native CMake executable failed to launch")
                    return false

            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_executable(executables.candidate, executables.candidate_directory, "elisascript-minimal-native"):
                ok value:
                    candidate_run <- value
                error failure:
                    eprint("minimal native ElisaScript executable failed to launch")
                    return false

            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return false if reference_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed
            return false if not comparison.equal
            return false if reference_run.exit_status != 0 or reference_run.stdout != "answer=42\n" or reference_run.stderr != ""
            return candidate_run.exit_status == 0 and candidate_run.stdout == "answer=42\n" and candidate_run.stderr == ""


@test
def minimal_native_cmake_and_elisascript_binaries_match_process_behavior() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, Directory.Read, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsMinimalNativeBuildParity::pinned_compiler_path()
        assert elisacore_bin == EsMinimalNativeBuildParity::pinned_compiler_path()

        script_directory: Path = try path_real(Script::source_path().parent()) else err:
            assert false
            return
        repository_root: Path = script_directory.parent().parent()
        assert EsMinimalNativeBuildParity::binaries_match(f"{repository_root}")
