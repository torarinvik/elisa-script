# Build and compare the CMake and ElisaScript E01/E02/E06 artifacts and executable.
# Run only through scripts/run_bounded_test.sh after explicit reauthorization.
# The bounded wrapper samples RSS across its root process group and descendants.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsMinimalNativeBuildParity:
    private:
        const module Limits:
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            C_COMPILER: sview = "/usr/bin/cc"
            MKFIFO: sview = "/usr/bin/mkfifo"
            CONTROLLED_SYSTEM_PATH: sview = "/usr/bin:/bin:/usr/sbin:/sbin"
            TIMEOUT_STEPS: u64 = 60000
            MAX_PROCESS_OUTPUT_BYTES: u64 = 262144
            MAX_BINARY_OUTPUT_BYTES: u64 = 4096
            MAX_GENERATED_HEADER_BYTES: usize = 4096
            MAX_TOOL_BYTES: usize = 67108864


        struct Tools:
            cmake: sview
            ctest: sview
            launcher: sview
            cmake_directory: sview
            mkfifo: sview


        def path_is_within(root: sview, candidate: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if root == candidate
            prefix: sview = if root == "/": "/" else root + "/"
            return candidate.startswith(prefix)


        def canonical_external_file(raw_path: sview, repository_root: sview) -> sview can[Blocking.IO, Memory.Allocate, Abort.Panic, File.Read, Directory.Read]:
            input: Path = path(raw_path)
            return "" if not path_is_absolute(input)
            resolved: Path = try path_real(input) else err:
                return ""
            return "" if not is_file(resolved)
            resolved_size: usize = try file_size(resolved) else err:
                return ""
            resolved_text: sview = f"{resolved}"
            return "" if resolved_size == 0 or resolved_size > Limits::MAX_TOOL_BYTES or path_is_within(repository_root, resolved_text)
            return resolved_text


        def tools_from_environment(repository_root: sview) -> Tools can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Environment.Read, File.Read, Directory.Read]:
            cmake_argument: sview = try getenv("ELISASCRIPT_MINIMAL_NATIVE_CMAKE", "") else err:
                ""
            launcher_argument: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
                ""
            cmake: sview = canonical_external_file(cmake_argument, repository_root)
            launcher: sview = canonical_external_file(launcher_argument, repository_root)
            mkfifo: sview = canonical_external_file(Limits::MKFIFO, repository_root)
            pinned_launcher: sview = canonical_external_file(Limits::PINNED_COMPILER, repository_root)
            return Tools{cmake: "", ctest: "", launcher: "", cmake_directory: "", mkfifo: ""} if cmake == "" or launcher == "" or mkfifo == "" or launcher != pinned_launcher or cmake == launcher
            cmake_directory: sview = f"{path(cmake).parent()}"
            ctest_path: Path = path(cmake_directory).joinpath("ctest")
            ctest: sview = canonical_external_file(f"{ctest_path}", repository_root)
            return Tools{cmake: "", ctest: "", launcher: "", cmake_directory: "", mkfifo: ""} if ctest == ""
            return Tools{cmake: cmake, ctest: ctest, launcher: launcher, cmake_directory: cmake_directory, mkfifo: mkfifo}


        def controlled_environment(cmake_directory: sview) -> darray[DifferentialEnvironmentEntry] can[Memory.Allocate, Abort.Panic]:
            return [
                DifferentialEnvironmentEntry{name: "PATH", value: cmake_directory + ":" + Limits::CONTROLLED_SYSTEM_PATH},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "LANG", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Limits::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Limits::PINNED_COMPILER}
            ]


        def run_process(target: sview, arguments: darray[sview], working_directory: sview, name: sview, environment: darray[DifferentialEnvironmentEntry], output_limit: u64) -> DifferentialRun error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: name,
                target: target,
                arguments: arguments,
                working_directory: working_directory,
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                stdin: "",
                timeout_steps: Limits::TIMEOUT_STEPS,
                max_output_bytes: output_limit
            }
            return try run_differential_process(runner)


        def process_succeeded(run: DifferentialRun) -> bool:
            return run.outcome == DifferentialRunOutcome.Completed and run.exit_status == 0


        def generated_header_artifacts_match(fixture: Path, cmake_build: Path, elisa_build: Path, use_variant: bool) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read]:
            template_name: sview = "generated_build_config_variant.h.in" if use_variant else "generated_build_config.h.in"
            template: Path = fixture.joinpath("include").joinpath(template_name)
            cmake_header: Path = cmake_build.joinpath("generated_build_config.h")
            elisa_header: Path = elisa_build.joinpath("generated_build_config.h")
            return generated_header_matches_template(template, cmake_header) and generated_header_matches_template(template, elisa_header)


        def generated_header_matches_template(template: Path, output: Path) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read]:
            return false if is_symlink(template) or is_symlink(output)
            template_size: usize = try file_size(template) else err:
                return false
            output_size: usize = try file_size(output) else err:
                return false
            return false if template_size == 0 or template_size > Limits::MAX_GENERATED_HEADER_BYTES
            return false if output_size != template_size
            template_text: sview = try read_text(template) else err:
                return false
            output_text: sview = try read_text(output) else err:
                return false
            return output_text == template_text


        def byte_arrays_equal(left: darray[u8], right: darray[u8]) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            return true


        def run_checked_process(target: sview, arguments: darray[sview], working_directory: sview, name: sview, environment: darray[DifferentialEnvironmentEntry]) -> bool can[Memory.Allocate, Abort.Panic, Console.Write, Unsafe.PointerCast]:
            catch run_process(target, arguments, working_directory, name, environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok run:
                    return true if process_succeeded(run)
                    print("minimal native parity: " + name + " exited unsuccessfully")
                    if run.stderr != "":
                        print(run.stderr)
                    if run.stdout != "":
                        print(run.stdout)
                    return false
                error failure:
                    print("minimal native parity: " + name + " could not complete within process bounds")
                    return false


        def run_executable(target: sview, working_directory: sview, name: sview) -> DifferentialRun error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            environment: darray[DifferentialEnvironmentEntry] = controlled_environment("/usr/bin")
            return try run_process(target, [], working_directory, name, environment, Limits::MAX_BINARY_OUTPUT_BYTES)


        def source_tree_build_path_is_refused(launcher: sview, build_script: sview, repository_directory: sview, cmake_directory: sview) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            environment: darray[DifferentialEnvironmentEntry] = controlled_environment(cmake_directory)
            arguments: darray[sview] = [build_script, repository_directory]
            catch run_process(launcher, arguments, "/", "elisascript-refuses-source-tree-build-directory", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok run:
                    return run.outcome == DifferentialRunOutcome.Completed and run.exit_status == 2 and run.stdout == "minimal native build: refusing a build directory inside the source repository\n" and run.stderr == ""
                error failure:
                    return false


        def remove_workspace(root: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write]:
            return try remove_tree(root) else false


    public:
        def pinned_compiler_path() -> sview:
            return Limits::PINNED_COMPILER


        def build_and_compare(repository_root: Path) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Environment.Read, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            repository_text: sview = f"{repository_root}"
            tools: Tools = tools_from_environment(repository_text)
            return false if tools.cmake == "" or tools.ctest == "" or tools.launcher == ""

            fixture: Path = repository_root.joinpath("test").joinpath("fixtures").joinpath("script_parity").joinpath("minimal_native_build")
            fixture_directory: Path = try path_real(fixture) else err:
                return false
            build_script: Path = fixture_directory.joinpath("build.elisascript")
            return false if not is_file(build_script)
            fixture_text: sview = f"{fixture_directory}"
            build_script_text: sview = f"{build_script}"
            if not source_tree_build_path_is_refused(tools.launcher, build_script_text, repository_text, tools.cmake_directory):
                print("minimal native parity: source-tree build directory was not refused exactly")
                return false

            temporary_path: Path = try temp_directory("elisascript-minimal-native-parity") else err:
                return false
            workspace: Path = try path_real(temporary_path) else err:
                _ = remove_workspace(temporary_path)
                return false
            workspace_text: sview = f"{workspace}"
            if workspace_text == "/" or path_is_within(repository_text, workspace_text):
                if workspace_text != "/":
                    _ = remove_workspace(workspace)
                return false

            cmake_build: Path = workspace.joinpath("cmake-build")
            elisa_build: Path = workspace.joinpath("elisa-build")
            symlink_build: Path = workspace.joinpath("symlink-build")
            cmake_build_text: sview = f"{cmake_build}"
            elisa_build_text: sview = f"{elisa_build}"
            symlink_build_text: sview = f"{symlink_build}"
            workspace_ready: bool = try create_directory(cmake_build) else false
            workspace_ready <- (try create_directory(elisa_build) else false) and workspace_ready
            workspace_ready <- (try create_directory(symlink_build) else false) and workspace_ready
            if not workspace_ready:
                print("minimal native parity: unable to create isolated build directories")
                _ = remove_workspace(workspace)
                return false

            environment: darray[DifferentialEnvironmentEntry] = controlled_environment(tools.cmake_directory)
            sentinel_path: Path = symlink_build.joinpath("preserve-me.txt")
            output_symlink_path: Path = symlink_build.joinpath("minimal-native")
            sentinel_contents: sview = "existing output target must remain unchanged\n"
            sentinel_written: usize = try write_text(sentinel_path, sentinel_contents) else 0u64
            symlink_created: bool = sentinel_written == len(sentinel_contents) and (try symlink(sentinel_path, output_symlink_path) else false)
            symlink_case_matches: mutable bool = false
            if symlink_created:
                symlink_case_arguments: darray[sview] = [build_script_text, symlink_build_text]
                catch run_process(tools.launcher, symlink_case_arguments, "/", "elisascript-refuses-symlink-build-output", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                    ok symlink_case_run:
                        symlink_case_matches <- symlink_case_run.outcome == DifferentialRunOutcome.Completed and symlink_case_run.exit_status == 2 and symlink_case_run.stdout == "minimal native build: refusing a symlink at the target output path\n" and symlink_case_run.stderr == ""
                    error failure:
                        symlink_case_matches <- false
                sentinel_after: sview = try read_text(sentinel_path) else ""
                symlink_case_matches <- symlink_case_matches and is_symlink(output_symlink_path) and sentinel_after == sentinel_contents
            if not symlink_case_matches:
                print("minimal native parity: symlink output was not refused without modifying its target")
                _ = remove_workspace(workspace)
                return false

            configure_arguments: darray[sview] = ["-S", fixture_text, "-B", cmake_build_text, "-G", "Unix Makefiles", "-DCMAKE_C_COMPILER=" + Limits::C_COMPILER, "-DCMAKE_AR=/usr/bin/ar", "-DBUILD_TESTING=ON"]
            configured: bool = run_checked_process(tools.cmake, configure_arguments, repository_text, "cmake-configure-minimal-native", environment)
            if not configured:
                _ = remove_workspace(workspace)
                return false

            build_arguments: darray[sview] = ["--build", cmake_build_text, "--parallel", "1"]
            reference_built: bool = run_checked_process(tools.cmake, build_arguments, repository_text, "cmake-build-minimal-native", environment)
            if not reference_built:
                _ = remove_workspace(workspace)
                return false

            ctest_arguments: darray[sview] = ["--test-dir", cmake_build_text, "--output-on-failure"]
            reference_tested: bool = run_checked_process(tools.ctest, ctest_arguments, repository_text, "ctest-minimal-native", environment)
            if not reference_tested:
                _ = remove_workspace(workspace)
                return false

            candidate_arguments: darray[sview] = [build_script_text, elisa_build_text]
            candidate_built: bool = run_checked_process(tools.launcher, candidate_arguments, repository_text, "elisascript-build-minimal-native", environment)
            if not candidate_built:
                _ = remove_workspace(workspace)
                return false

            candidate_noop_matches: mutable bool = false
            catch run_process(tools.launcher, candidate_arguments, repository_text, "elisascript-noop-build-minimal-native", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok noop_run:
                    candidate_noop_matches <- noop_run.outcome == DifferentialRunOutcome.Completed and noop_run.exit_status == 0 and noop_run.stdout == "build_cache=up_to_date\n" and noop_run.stderr == ""
                error failure:
                    candidate_noop_matches <- false
            if not candidate_noop_matches:
                print("minimal native parity: second Elisascript build was not an up-to-date no-op")
                _ = remove_workspace(workspace)
                return false
            if not generated_header_artifacts_match(fixture_directory, cmake_build, elisa_build, false):
                print("minimal native parity: clean generated-header bytes differ from the default template")
                _ = remove_workspace(workspace)
                return false

            variant_template: Path = fixture_directory.joinpath("include").joinpath("generated_build_config_variant.h.in")
            variant_template_text: sview = f"{variant_template}"
            variant_configure_arguments: darray[sview] = ["-S", fixture_text, "-B", cmake_build_text, "-DMINIMAL_BUILD_CONFIG_INPUT=" + variant_template_text]
            variant_configured: bool = run_checked_process(tools.cmake, variant_configure_arguments, repository_text, "cmake-configure-minimal-native-variant", environment)
            if not variant_configured:
                _ = remove_workspace(workspace)
                return false

            reference_variant_build: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_process(tools.cmake, ["--build", cmake_build_text, "--parallel", "1"], repository_text, "cmake-incremental-minimal-native", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok value:
                    reference_variant_build <- value
                error failure:
                    print("minimal native parity: CMake incremental build could not complete")
                    _ = remove_workspace(workspace)
                    return false
            reference_frontier_matches: bool = process_succeeded(reference_variant_build) and reference_variant_build.stdout.contains("main.c.o") and reference_variant_build.stdout.contains("Linking C executable") and not reference_variant_build.stdout.contains("answer.c.o") and not reference_variant_build.stdout.contains("Linking C static library")
            if not reference_frontier_matches:
                print("minimal native parity: CMake variant rebuild frontier was unexpected")
                _ = remove_workspace(workspace)
                return false

            ctest_variant_arguments: darray[sview] = ["--test-dir", cmake_build_text, "--output-on-failure"]
            if not run_checked_process(tools.ctest, ctest_variant_arguments, repository_text, "ctest-minimal-native-variant", environment):
                _ = remove_workspace(workspace)
                return false

            candidate_variant_arguments: darray[sview] = [build_script_text, elisa_build_text, "variant"]
            candidate_variant_matches: mutable bool = false
            catch run_process(tools.launcher, candidate_variant_arguments, repository_text, "elisascript-incremental-minimal-native-variant", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok variant_run:
                    candidate_variant_matches <- variant_run.outcome == DifferentialRunOutcome.Completed and variant_run.exit_status == 0 and variant_run.stdout == "build_cache=rebuilt\nrebuilt=generate-config-header\nrebuilt=compile-main\nrebuilt=minimal-native\n" and variant_run.stderr == ""
                error failure:
                    candidate_variant_matches <- false
            if not candidate_variant_matches:
                print("minimal native parity: Elisascript variant rebuild frontier was unexpected")
                _ = remove_workspace(workspace)
                return false

            if not generated_header_artifacts_match(fixture_directory, cmake_build, elisa_build, true):
                print("minimal native parity: generated header bytes differ from the configure_file input")
                _ = remove_workspace(workspace)
                return false

            flag_variant_configure_arguments: darray[sview] = ["-S", fixture_text, "-B", cmake_build_text, "-DMINIMAL_BUILD_CONFIG_INPUT=" + variant_template_text, "-DMINIMAL_MAIN_VARIANT=1"]
            if not run_checked_process(tools.cmake, flag_variant_configure_arguments, repository_text, "cmake-configure-minimal-native-flag-variant", environment):
                _ = remove_workspace(workspace)
                return false
            reference_flag_variant_build: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_process(tools.cmake, ["--build", cmake_build_text, "--parallel", "1"], repository_text, "cmake-compile-flag-variant-minimal-native", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok value:
                    reference_flag_variant_build <- value
                error failure:
                    print("minimal native parity: CMake compile-flag rebuild could not complete")
                    _ = remove_workspace(workspace)
                    return false
            reference_flag_variant_frontier_matches: bool = process_succeeded(reference_flag_variant_build) and reference_flag_variant_build.stdout.contains("main.c.o") and reference_flag_variant_build.stdout.contains("Linking C executable") and not reference_flag_variant_build.stdout.contains("answer.c.o") and not reference_flag_variant_build.stdout.contains("Linking C static library")
            if not reference_flag_variant_frontier_matches:
                print("minimal native parity: CMake compile-flag rebuild frontier was unexpected")
                _ = remove_workspace(workspace)
                return false
            if not run_checked_process(tools.ctest, ctest_variant_arguments, repository_text, "ctest-minimal-native-flag-variant", environment):
                _ = remove_workspace(workspace)
                return false

            candidate_flag_variant_arguments: darray[sview] = [build_script_text, elisa_build_text, "flag-variant"]
            candidate_flag_variant_matches: mutable bool = false
            catch run_process(tools.launcher, candidate_flag_variant_arguments, repository_text, "elisascript-compile-flag-variant-minimal-native", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok flag_variant_run:
                    candidate_flag_variant_matches <- flag_variant_run.outcome == DifferentialRunOutcome.Completed and flag_variant_run.exit_status == 0 and flag_variant_run.stdout == "build_cache=rebuilt\nrebuilt=compile-main\nrebuilt=minimal-native\n" and flag_variant_run.stderr == ""
                error failure:
                    candidate_flag_variant_matches <- false
            if not candidate_flag_variant_matches:
                print("minimal native parity: Elisascript compile-flag rebuild frontier was unexpected")
                _ = remove_workspace(workspace)
                return false

            restore_flag_configure_arguments: darray[sview] = ["-S", fixture_text, "-B", cmake_build_text, "-DMINIMAL_BUILD_CONFIG_INPUT=" + variant_template_text, "-DMINIMAL_MAIN_VARIANT=0"]
            if not run_checked_process(tools.cmake, restore_flag_configure_arguments, repository_text, "cmake-restore-minimal-native-compile-flag", environment):
                _ = remove_workspace(workspace)
                return false
            reference_restored_flag_build: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_process(tools.cmake, ["--build", cmake_build_text, "--parallel", "1"], repository_text, "cmake-restore-compile-flag-minimal-native", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok value:
                    reference_restored_flag_build <- value
                error failure:
                    print("minimal native parity: CMake compile-flag recovery could not complete")
                    _ = remove_workspace(workspace)
                    return false
            reference_restored_flag_frontier_matches: bool = process_succeeded(reference_restored_flag_build) and reference_restored_flag_build.stdout.contains("main.c.o") and reference_restored_flag_build.stdout.contains("Linking C executable") and not reference_restored_flag_build.stdout.contains("answer.c.o") and not reference_restored_flag_build.stdout.contains("Linking C static library")
            if not reference_restored_flag_frontier_matches:
                print("minimal native parity: CMake compile-flag recovery frontier was unexpected")
                _ = remove_workspace(workspace)
                return false

            candidate_flag_recovery_matches: mutable bool = false
            catch run_process(tools.launcher, candidate_variant_arguments, repository_text, "elisascript-restore-minimal-native-compile-flag", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok flag_recovery_run:
                    candidate_flag_recovery_matches <- flag_recovery_run.outcome == DifferentialRunOutcome.Completed and flag_recovery_run.exit_status == 0 and flag_recovery_run.stdout == "build_cache=rebuilt\nrebuilt=compile-main\nrebuilt=minimal-native\n" and flag_recovery_run.stderr == ""
                error failure:
                    candidate_flag_recovery_matches <- false
            if not candidate_flag_recovery_matches:
                print("minimal native parity: Elisascript compile-flag recovery frontier was unexpected")
                _ = remove_workspace(workspace)
                return false

            main_source_variant: Path = fixture_directory.joinpath("src").joinpath("main_variant.c")
            main_source_variant_text: sview = f"{main_source_variant}"
            main_source_default: Path = fixture_directory.joinpath("src").joinpath("main.c")
            main_source_default_text: sview = f"{main_source_default}"
            source_variant_configure_arguments: darray[sview] = ["-S", fixture_text, "-B", cmake_build_text, "-DMINIMAL_BUILD_CONFIG_INPUT=" + variant_template_text, "-DMINIMAL_MAIN_SOURCE=" + main_source_variant_text, "-DMINIMAL_MAIN_VARIANT=0"]
            if not run_checked_process(tools.cmake, source_variant_configure_arguments, repository_text, "cmake-configure-minimal-native-source-variant", environment):
                _ = remove_workspace(workspace)
                return false
            reference_source_variant_build: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_process(tools.cmake, ["--build", cmake_build_text, "--parallel", "1"], repository_text, "cmake-source-variant-minimal-native", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok value:
                    reference_source_variant_build <- value
                error failure:
                    print("minimal native parity: CMake source-variant rebuild could not complete")
                    _ = remove_workspace(workspace)
                    return false
            reference_source_variant_frontier_matches: bool = process_succeeded(reference_source_variant_build) and reference_source_variant_build.stdout.contains("main_variant.c.o") and reference_source_variant_build.stdout.contains("Linking C executable") and not reference_source_variant_build.stdout.contains("answer.c.o") and not reference_source_variant_build.stdout.contains("Linking C static library")
            if not reference_source_variant_frontier_matches:
                print("minimal native parity: CMake source-variant rebuild frontier was unexpected")
                _ = remove_workspace(workspace)
                return false
            if not run_checked_process(tools.ctest, ctest_variant_arguments, repository_text, "ctest-minimal-native-source-variant", environment):
                _ = remove_workspace(workspace)
                return false

            candidate_source_variant_arguments: darray[sview] = [build_script_text, elisa_build_text, "source-variant"]
            candidate_source_variant_matches: mutable bool = false
            catch run_process(tools.launcher, candidate_source_variant_arguments, repository_text, "elisascript-source-variant-minimal-native", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok source_variant_run:
                    candidate_source_variant_matches <- source_variant_run.outcome == DifferentialRunOutcome.Completed and source_variant_run.exit_status == 0 and source_variant_run.stdout == "build_cache=rebuilt\nrebuilt=compile-main\nrebuilt=minimal-native\n" and source_variant_run.stderr == ""
                error failure:
                    candidate_source_variant_matches <- false
            if not candidate_source_variant_matches:
                print("minimal native parity: Elisascript source-variant rebuild frontier was unexpected")
                _ = remove_workspace(workspace)
                return false

            restore_source_configure_arguments: darray[sview] = ["-S", fixture_text, "-B", cmake_build_text, "-DMINIMAL_BUILD_CONFIG_INPUT=" + variant_template_text, "-DMINIMAL_MAIN_SOURCE=" + main_source_default_text, "-DMINIMAL_MAIN_VARIANT=0"]
            if not run_checked_process(tools.cmake, restore_source_configure_arguments, repository_text, "cmake-restore-minimal-native-main-source", environment):
                _ = remove_workspace(workspace)
                return false
            reference_restored_source_build: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_process(tools.cmake, ["--build", cmake_build_text, "--parallel", "1"], repository_text, "cmake-restore-main-source-minimal-native", environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok value:
                    reference_restored_source_build <- value
                error failure:
                    print("minimal native parity: CMake source recovery could not complete")
                    _ = remove_workspace(workspace)
                    return false
