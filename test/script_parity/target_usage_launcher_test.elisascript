# Compare CMake and ElisaScript public/private/interface target usage.
# Run only through scripts/run_bounded_test.sh after explicit reauthorization.
include "../../src/testing/differential.elisa"

using EsDifferential
using EsJson
using EsJsonLex
using EsJsonParse


module EsTargetUsageParity:
    private:
        const module Limits:
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            C_COMPILER: sview = "/usr/bin/cc"
            CONTROLLED_SYSTEM_PATH: sview = "/usr/bin:/bin:/usr/sbin:/sbin"
            TIMEOUT_STEPS: u64 = 60000
            MAX_PROCESS_OUTPUT_BYTES: u64 = 262144
            MAX_BINARY_OUTPUT_BYTES: u64 = 4096
            MAX_TOOL_BYTES: usize = 67108864


        struct Tools:
            cmake: sview
            ctest: sview
            launcher: sview
            cmake_directory: sview


        def json_text_equals(document: JsonDocument&, node_index: usize, expected: sview) -> bool:
            return false if node_index >= document.nodes.count
            node: JsonNode = document.nodes[node_index]
            return false if node.kind != JsonNodeKind.Text or node.scalar_bytes != sview_len(expected)
            for offset in 0..<node.scalar_bytes |document, node, expected|:
                return false if document.scalar_data[node.scalar_start + offset] != sview_at(expected, offset)
            return true


        def json_object_text_member(document: JsonDocument&, object_index: usize, key: sview) -> sview error[JsonContractError]:
            return "" if object_index >= document.nodes.count or document.nodes[object_index].kind != JsonNodeKind.Object
            member_index: usize = try json_object_member_index(document, object_index, key)
            return "" if member_index == JSON_INDEX_NONE
            value_index: usize = document.members[member_index].value_index
            return "" if value_index >= document.nodes.count
            value: JsonNode = document.nodes[value_index]
            return "" if value.kind != JsonNodeKind.Text
            return sview(document.scalar_data.items + value.scalar_start, 0, value.scalar_bytes.i64())


        def json_array_matches_texts(document: JsonDocument&, array_index: usize, expected: darray[sview]) -> bool:
            return false if array_index >= document.nodes.count or document.nodes[array_index].kind != JsonNodeKind.Array
            array: JsonNode = document.nodes[array_index]
            return false if array.child_count != expected.count
            for ordinal in 0..<array.child_count |document, array, expected|:
                child_index: usize = document.children[array.child_start + ordinal].value_index
                return false if not json_text_equals(document, child_index, expected[ordinal])
            return true


        def compilation_database_entry(document: JsonDocument&, root_index: usize, source_file: sview) -> usize error[JsonContractError]:
            return JSON_INDEX_NONE if root_index >= document.nodes.count or document.nodes[root_index].kind != JsonNodeKind.Array
            root: JsonNode = document.nodes[root_index]
            entry_index: mutable usize = JSON_INDEX_NONE
            for ordinal in 0..<root.child_count |document, root, entry_index|:
                candidate_index: usize = document.children[root.child_start + ordinal].value_index
                return JSON_INDEX_NONE if candidate_index >= document.nodes.count or document.nodes[candidate_index].kind != JsonNodeKind.Object
                candidate_file: sview = try json_object_text_member(document, candidate_index, "file")
                if candidate_file == source_file:
                    return JSON_INDEX_NONE if entry_index != JSON_INDEX_NONE
                    entry_index <- candidate_index
            return entry_index


        def compilation_database_entry_matches(document: JsonDocument&, entry_index: usize, working_directory: sview, source_file: sview, output_file: sview, expected_arguments: darray[sview]) -> bool error[JsonContractError]:
            return false if entry_index >= document.nodes.count or document.nodes[entry_index].kind != JsonNodeKind.Object
            return false if document.nodes[entry_index].member_count != 4
            directory: sview = try json_object_text_member(document, entry_index, "directory")
            file_name: sview = try json_object_text_member(document, entry_index, "file")
            output: sview = try json_object_text_member(document, entry_index, "output")
            return false if directory != working_directory or file_name != source_file or output != output_file
            arguments_member: usize = try json_object_member_index(document, entry_index, "arguments")
            return false if arguments_member == JSON_INDEX_NONE
            arguments_index: usize = document.members[arguments_member].value_index
            return json_array_matches_texts(document, arguments_index, expected_arguments)


        def candidate_compile_database_matches(encoded: sview, working_directory: sview, fixture_directory: sview, helper_object: sview, core_object: sview, app_object: sview) -> bool error[JsonLexError, JsonParseError, JsonContractError] can[Memory.Allocate, Abort.Panic]:
            lexed: JsonLexedSource = try lex_json(encoded, DataDecodeLimits{}, JsonPolicy{duplicate_keys: JsonDuplicateKeyPolicy.Reject})
            document: JsonDocument = try parse_json_document(lexed)
            return false if document.state != JsonDocumentState.Sealed or document.roots.count != 1
            root_index: usize = document.roots[0]
            return false if root_index >= document.nodes.count or document.nodes[root_index].kind != JsonNodeKind.Array or document.nodes[root_index].child_count != 3

            helper_source: sview = fixture_directory + "/src/helper.c"
            core_source: sview = fixture_directory + "/src/core.c"
            app_source: sview = fixture_directory + "/src/main.c"
            helper_entry: usize = try compilation_database_entry(document, root_index, helper_source)
            core_entry: usize = try compilation_database_entry(document, root_index, core_source)
            app_entry: usize = try compilation_database_entry(document, root_index, app_source)
            return false if helper_entry == JSON_INDEX_NONE or core_entry == JSON_INDEX_NONE or app_entry == JSON_INDEX_NONE

            api_include: sview = "-I" + fixture_directory + "/include/api"
            core_include: sview = "-I" + fixture_directory + "/include/core"
            internal_include: sview = "-I" + fixture_directory + "/include/internal"
            helper_include: sview = "-I" + fixture_directory + "/include/helper"
            helper_arguments: darray[sview] = ["/usr/bin/cc", "-std=c11", "-pedantic", "-Wall", "-Wextra", "-Werror", helper_include, "-DHELPER_PRIVATE=1", "-DHELPER_PRIVATE_OPTION=1", "-c", helper_source, "-o", helper_object]
            core_arguments: darray[sview] = ["/usr/bin/cc", "-std=c11", "-pedantic", "-Wall", "-Wextra", "-Werror", internal_include, core_include, "-DCORE_PRIVATE=1", "-DCORE_ABI=5", "-DCORE_PRIVATE_OPTION=1", "-DCORE_PUBLIC_OPTION=1", api_include, "-DAPI_LEVEL=3", "-DAPI_OPTION=1", "-c", core_source, "-o", core_object]
            app_arguments: darray[sview] = ["/usr/bin/cc", "-std=c11", "-pedantic", "-Wall", "-Wextra", "-Werror", core_include, "-DCORE_ABI=5", "-DCORE_PUBLIC_OPTION=1", api_include, "-DAPI_LEVEL=3", "-DAPI_OPTION=1", "-c", app_source, "-o", app_object]

            helper_matches: bool = try compilation_database_entry_matches(document, helper_entry, working_directory, helper_source, helper_object, helper_arguments)
            core_matches: bool = try compilation_database_entry_matches(document, core_entry, working_directory, core_source, core_object, core_arguments)
            app_matches: bool = try compilation_database_entry_matches(document, app_entry, working_directory, app_source, app_object, app_arguments)
            return helper_matches and core_matches and app_matches


        def path_is_within(root: sview, candidate: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if root == candidate
            prefix: sview = if root == "/": "/" else: root + "/"
            return candidate.startswith(prefix)


        def canonical_external_file(raw_path: sview, repository_root: sview) -> sview can[Blocking.IO, Memory.Allocate, Abort.Panic, File.Read, Directory.Read]:
            input: Path = path(raw_path)
            return "" if not path_is_absolute(input)
            resolved: Path = try path_real(input) else err:
                return ""
            return "" if not is_file(resolved)
            resolved_size: usize = try file_size(resolved) else err:
                return ""
            resolved_text: sview = f"{resolved}"
            return "" if resolved_size == 0 or resolved_size > Limits::MAX_TOOL_BYTES or path_is_within(repository_root, resolved_text)
            return resolved_text


        def tools_from_environment(repository_root: sview) -> Tools can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Environment.Read, File.Read, Directory.Read]:
            cmake_argument: sview = try getenv("ELISASCRIPT_TARGET_USAGE_CMAKE", "") else err:
                ""
            launcher_argument: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
                ""
            cmake: sview = canonical_external_file(cmake_argument, repository_root)
            launcher: sview = canonical_external_file(launcher_argument, repository_root)
            pinned_launcher: sview = canonical_external_file(Limits::PINNED_COMPILER, repository_root)
            return Tools{cmake: "", ctest: "", launcher: "", cmake_directory: ""} if cmake == "" or launcher == "" or launcher != pinned_launcher or cmake == launcher
            cmake_directory: sview = f"{path(cmake).parent()}"
            ctest_path: Path = path(cmake_directory).joinpath("ctest")
            ctest: sview = canonical_external_file(f"{ctest_path}", repository_root)
            return Tools{cmake: "", ctest: "", launcher: "", cmake_directory: ""} if ctest == ""
            return Tools{cmake: cmake, ctest: ctest, launcher: launcher, cmake_directory: cmake_directory}


        def controlled_environment(cmake_directory: sview) -> darray[DifferentialEnvironmentEntry] can[Memory.Allocate, Abort.Panic]:
            return [
                DifferentialEnvironmentEntry{name: "PATH", value: cmake_directory + ":" + Limits::CONTROLLED_SYSTEM_PATH},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "LANG", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Limits::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Limits::PINNED_COMPILER}
            ]


        def run_process(target: sview, arguments: darray[sview], working_directory: sview, name: sview, environment: darray[DifferentialEnvironmentEntry], output_limit: u64) -> DifferentialRun error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: name,
                target: target,
                arguments: arguments,
                working_directory: working_directory,
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                stdin: "",
                timeout_steps: Limits::TIMEOUT_STEPS,
                max_output_bytes: output_limit
            }
            return try run_differential_process(runner)


        def process_succeeded(run: DifferentialRun) -> bool:
            return run.outcome == DifferentialRunOutcome.Completed and run.exit_status == 0


        def run_checked_process(target: sview, arguments: darray[sview], working_directory: sview, name: sview, environment: darray[DifferentialEnvironmentEntry]) -> bool can[Memory.Allocate, Abort.Panic, Console.Write, Unsafe.PointerCast]:
            catch run_process(target, arguments, working_directory, name, environment, Limits::MAX_PROCESS_OUTPUT_BYTES):
                ok run:
                    return true if process_succeeded(run)
                    print("target usage parity: " + name + " exited unsuccessfully")
                    if run.stderr != "":
                        print(run.stderr)
                    if run.stdout != "":
                        print(run.stdout)
                    return false
                error failure:
                    print("target usage parity: " + name + " exceeded its process bounds")
                    return false


        def run_binary(target: sview, working_directory: sview, name: sview) -> DifferentialRun error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            environment: darray[DifferentialEnvironmentEntry] = controlled_environment("/usr/bin")
            return try run_process(target, [], working_directory, name, environment, Limits::MAX_BINARY_OUTPUT_BYTES)


        def remove_workspace(root: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write]:
            return try remove_tree(root) else false


    public:
        def pinned_compiler_path() -> sview:
            return Limits::PINNED_COMPILER


        def build_and_compare(repository_root: Path) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Environment.Read, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            repository_text: sview = f"{repository_root}"
            tools: Tools = tools_from_environment(repository_text)
            return false if tools.cmake == "" or tools.ctest == "" or tools.launcher == ""

            fixture: Path = repository_root.joinpath("test").joinpath("fixtures").joinpath("script_parity").joinpath("target_usage")
            fixture_directory: Path = try path_real(fixture) else err:
                return false
            build_script: Path = fixture_directory.joinpath("build.elisascript")
            return false if not is_file(build_script)

            temporary_path: Path = try temp_directory("elisascript-target-usage-parity") else err:
                return false
            workspace: Path = try path_real(temporary_path) else err:
                _ = remove_workspace(temporary_path)
                return false
            workspace_text: sview = f"{workspace}"
            if workspace_text == "/" or path_is_within(repository_text, workspace_text):
                if workspace_text != "/":
                    _ = remove_workspace(workspace)
                return false

            cmake_build: Path = workspace.joinpath("cmake-build")
            elisa_build: Path = workspace.joinpath("elisa-build")
            cmake_build_text: sview = f"{cmake_build}"
            elisa_build_text: sview = f"{elisa_build}"
            fixture_text: sview = f"{fixture_directory}"
            build_script_text: sview = f"{build_script}"
            workspace_ready: bool = try create_directory(cmake_build) else false
            workspace_ready <- (try create_directory(elisa_build) else false) and workspace_ready
            if not workspace_ready:
                print("target usage parity: unable to create isolated build directories")
                _ = remove_workspace(workspace)
                return false

            environment: darray[DifferentialEnvironmentEntry] = controlled_environment(tools.cmake_directory)
            configure_arguments: darray[sview] = ["-S", fixture_text, "-B", cmake_build_text, "-G", "Unix Makefiles", "-DCMAKE_C_COMPILER=" + Limits::C_COMPILER, "-DBUILD_TESTING=ON", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"]
            configured: bool = run_checked_process(tools.cmake, configure_arguments, repository_text, "cmake-configure-target-usage", environment)
            if not configured:
                _ = remove_workspace(workspace)
                return false
            build_arguments: darray[sview] = ["--build", cmake_build_text, "--parallel", "1"]
            reference_built: bool = run_checked_process(tools.cmake, build_arguments, repository_text, "cmake-build-target-usage", environment)
            if not reference_built:
                _ = remove_workspace(workspace)
                return false
            ctest_arguments: darray[sview] = ["--test-dir", cmake_build_text, "--output-on-failure"]
            reference_tested: bool = run_checked_process(tools.ctest, ctest_arguments, repository_text, "ctest-target-usage", environment)
            if not reference_tested:
                _ = remove_workspace(workspace)
                return false

            candidate_arguments: darray[sview] = [build_script_text, elisa_build_text]
            candidate_built: bool = run_checked_process(tools.launcher, candidate_arguments, repository_text, "elisascript-build-target-usage", environment)
            if not candidate_built:
                _ = remove_workspace(workspace)
                return false

            reference_database_path: Path = cmake_build.joinpath("compile_commands.json")
            candidate_database_path: Path = elisa_build.joinpath("compile_commands.json")
            candidate_database_stage_path: Path = elisa_build.joinpath(".compile_commands.json.stage")
            candidate_database_lock_path: Path = elisa_build.joinpath(".compile_commands.json.lock")
            reference_database_size: usize = try file_size(reference_database_path) else 0u64
            candidate_database_size: usize = try file_size(candidate_database_path) else 0u64
            if is_symlink(reference_database_path) or is_symlink(candidate_database_path) or not is_file(reference_database_path) or not is_file(candidate_database_path) or reference_database_size == 0 or candidate_database_size == 0 or reference_database_size > 67108864 or candidate_database_size > 67108864:
                print("target usage parity: one or both routes omitted a bounded regular compilation database")
                _ = remove_workspace(workspace)
                return false
            if path_exists(candidate_database_stage_path) or is_symlink(candidate_database_stage_path):
                print("target usage parity: candidate left a compilation database stage behind")
                _ = remove_workspace(workspace)
                return false
            candidate_database_lock_size: usize = try file_size(candidate_database_lock_path) else 1u64
            if is_symlink(candidate_database_lock_path) or not is_file(candidate_database_lock_path) or candidate_database_lock_size != 0:
                print("target usage parity: candidate publication lock is missing or invalid")
                _ = remove_workspace(workspace)
                return false
            reference_database: sview = try read_text(reference_database_path) else err:
                _ = remove_workspace(workspace)
                return false
            candidate_database: sview = try read_text(candidate_database_path) else err:
                _ = remove_workspace(workspace)
                return false
            helper_translation_unit: sview = fixture_text + "/src/helper.c"
            core_translation_unit: sview = fixture_text + "/src/core.c"
            app_translation_unit: sview = fixture_text + "/src/main.c"
            candidate_database_matches: bool = try candidate_compile_database_matches(
                candidate_database,
                elisa_build_text,
                fixture_text,
                elisa_build_text + "/helper.o",
                elisa_build_text + "/core.o",
                elisa_build_text + "/app.o"
            ) else false
            reference_database_matches: bool = reference_database.starts_with("[") and reference_database.ends_with("]\n")
            reference_database_matches <- reference_database.contains(helper_translation_unit) and reference_database_matches
            reference_database_matches <- reference_database.contains(core_translation_unit) and reference_database_matches
            reference_database_matches <- reference_database.contains(app_translation_unit) and reference_database_matches
            if not reference_database_matches or not candidate_database_matches:
                print("target usage parity: compilation database shape, argv, or target usage mismatch")
                _ = remove_workspace(workspace)
                return false

            cmake_binary_path: Path = cmake_build.joinpath("usage-app")
            elisa_binary_path: Path = elisa_build.joinpath("usage-app")
            cmake_binary: sview = canonical_external_file(f"{cmake_binary_path}", repository_text)
            elisa_binary: sview = canonical_external_file(f"{elisa_binary_path}", repository_text)
            if cmake_binary == "" or elisa_binary == "" or cmake_binary == elisa_binary:
                print("target usage parity: one or both routes omitted the executable")
                _ = remove_workspace(workspace)
                return false

            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_binary(cmake_binary, cmake_build_text, "cmake-target-usage"):
                ok value:
                    reference_run <- value
                error failure:
                    _ = remove_workspace(workspace)
                    return false
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_binary(elisa_binary, elisa_build_text, "elisascript-target-usage"):
                ok value:
                    candidate_run <- value
                error failure:
                    _ = remove_workspace(workspace)
                    return false

            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            matches: bool = process_succeeded(reference_run) and process_succeeded(candidate_run) and comparison.equal
            matches <- reference_run.stdout == "usage=32\n" and reference_run.stderr == "" and matches
            matches <- candidate_run.stdout == "usage=32\n" and candidate_run.stderr == "" and matches
            if not matches:
                print("target usage parity: exit status/stdout/stderr mismatch")
            cleanup_ok: bool = remove_workspace(workspace)
            return matches and cleanup_ok


@test
def cmake_and_elisascript_target_usage_propagation_match() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        cmake: sview = try getenv("ELISASCRIPT_TARGET_USAGE_CMAKE", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsTargetUsageParity::pinned_compiler_path()
        assert elisacore_bin == EsTargetUsageParity::pinned_compiler_path()
        assert cmake != ""
        assert launcher != ""

        script_directory: Path = try path_real(Script::source_path().parent()) else err:
            assert false
            return
        repository_root: Path = script_directory.parent().parent()
        assert EsTargetUsageParity::build_and_compare(repository_root)
