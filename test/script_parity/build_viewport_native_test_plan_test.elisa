include "../../ports/elisa-engine/scripts/build_viewport_native_test_plan.elisa"

using EsEngineViewportNativeTestBuildPlan


@test
def plans_the_native_viewport_build_as_ordered_literal_argv() -> void can[Memory.Allocate, Abort.Panic]:
    plan: mutable Plan = Plan{}
    catch EsEngineViewportNativeTestBuildPlan::plan("/projects/elisa-engine", "viewport smoke", "local/compiler path", "/runtime/runtime.o"):
        ok value:
            plan <- value
        error failure:
            _ = failure
            assert false

    assert plan.build_directory == "/projects/elisa-engine/build"
    assert plan.executable_path == "/projects/elisa-engine/build/viewport smoke-test"
    assert plan.commands.count == 4
    assert plan.commands[0].kind == CommandKind.CompileMetalBridge
    assert plan.commands[0].program == "clang"
    assert plan.commands[0].arguments.count == 9
    assert plan.commands[0].arguments[7] == "/projects/elisa-engine/build/viewport_metal.o"
    assert plan.commands[0].arguments[8] == "/projects/elisa-engine/native/viewport_metal.m"
    assert plan.commands[1].kind == CommandKind.CompileCppFallbacks
    assert plan.commands[2].kind == CommandKind.CompileElisaTest
    assert plan.commands[2].program == "local/compiler path"
    assert plan.commands[2].arguments[4] == "/projects/elisa-engine/build/viewport smoke.elisa"
    assert plan.commands[3].kind == CommandKind.LinkNativeTest
    assert plan.commands[3].program == "clang"
    assert plan.commands[3].arguments[5] == "/runtime/runtime.o"
    assert plan.commands[3].arguments[6] == "-framework"
    assert plan.commands[3].arguments[11] == "Foundation"


@test
def defaults_the_stage_one_compiler_and_preserves_filesystem_root_paths() -> void can[Memory.Allocate, Abort.Panic]:
    plan: mutable Plan = Plan{}
    catch EsEngineViewportNativeTestBuildPlan::plan("/", "smoke", "", "/runtime.o"):
        ok value:
            plan <- value
        error failure:
            _ = failure
            assert false
    assert plan.build_directory == "/build"
    assert plan.commands[2].program == "elisac-stage1"
    assert plan.commands[2].arguments[4] == "/test/smoke.elisa"
    assert plan.commands[3].arguments[1] == "/build/smoke-test"


@test
def rejects_a_missing_name_or_runtime_object() -> void can[Memory.Allocate, Abort.Panic]:
    missing_name: mutable bool = false
    catch EsEngineViewportNativeTestBuildPlan::plan("/engine", "", "", "/runtime.o"):
        ok plan:
            _ = plan
        error failure:
            missing_name <- failure == PlanError.MissingTestName
    assert missing_name

    missing_runtime: mutable bool = false
    catch EsEngineViewportNativeTestBuildPlan::plan("/engine", "smoke", "", ""):
        ok plan:
            _ = plan
        error failure:
            missing_runtime <- failure == PlanError.MissingRuntimeObject
    assert missing_runtime


@test
def execution_state_stops_on_each_failed_command_and_preserves_status() -> void can[Memory.Allocate, Abort.Panic]:
    first: mutable ExecutionState = initial_execution(4)
    first <- try execution_after_prepare(first, true) else first
    first <- try execution_after_command(first, 23) else first
    assert first.phase == ExecutionPhase.Done
    assert first.next_command == 0
    assert first.exit_status == 23

    middle: mutable ExecutionState = initial_execution(4)
    middle <- try execution_after_prepare(middle, true) else middle
    middle <- try execution_after_command(middle, 0) else middle
    middle <- try execution_after_command(middle, 37) else middle
    assert middle.phase == ExecutionPhase.Done
    assert middle.next_command == 1
    assert middle.exit_status == 37

    elisa_compile: mutable ExecutionState = initial_execution(4)
    elisa_compile <- try execution_after_prepare(elisa_compile, true) else elisa_compile
    elisa_compile <- try execution_after_command(elisa_compile, 0) else elisa_compile
    elisa_compile <- try execution_after_command(elisa_compile, 0) else elisa_compile
    elisa_compile <- try execution_after_command(elisa_compile, 39) else elisa_compile
    assert elisa_compile.phase == ExecutionPhase.Done
    assert elisa_compile.next_command == 2
    assert elisa_compile.exit_status == 39

    link: mutable ExecutionState = initial_execution(4)
    link <- try execution_after_prepare(link, true) else link
    link <- try execution_after_command(link, 0) else link
    link <- try execution_after_command(link, 0) else link
    link <- try execution_after_command(link, 0) else link
    link <- try execution_after_command(link, 41) else link
    assert link.phase == ExecutionPhase.Done
    assert link.next_command == 3
    assert link.exit_status == 41


@test
def preparation_failure_returns_without_running_commands() -> void can[Abort.Panic]:
    state: mutable ExecutionState = initial_execution(4)
    state <- try execution_after_prepare(state, false) else state
    assert state.phase == ExecutionPhase.Done
    assert state.next_command == 0
    assert state.exit_status == 1


@test
def successful_execution_reports_only_after_every_command() -> void can[Memory.Allocate, Abort.Panic]:
    state: mutable ExecutionState = initial_execution(2)
    state <- try execution_after_prepare(state, true) else state
    assert state.phase == ExecutionPhase.Execute and state.next_command == 0
    state <- try execution_after_command(state, 0) else state
    assert state.phase == ExecutionPhase.Execute and state.next_command == 1
    state <- try execution_after_command(state, 0) else state
    assert state.phase == ExecutionPhase.Report and state.next_command == 2
    state <- try execution_after_report(state) else state
    assert state.phase == ExecutionPhase.Done and state.exit_status == 0


@test
def completed_execution_rejects_an_extra_command_receipt() -> void can[Memory.Allocate, Abort.Panic]:
    state: mutable ExecutionState = initial_execution(1)
    state <- try execution_after_prepare(state, true) else state
    state <- try execution_after_command(state, 0) else state
    rejected: mutable bool = false
    catch execution_after_command(state, 0):
        ok unexpected:
            _ = unexpected
        error failure:
            rejected <- failure == PlanError.InvalidExecutionState
    assert rejected
