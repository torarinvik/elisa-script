# Pure fixture checks only; do not launch either Bash or Elisascript.
include "elisa_lsp_compiler_root_cases.elisa"

module EsLspCompilerRootCasesFixture:
    public:
        @test
        def compiler_root_cases_pin_literals_and_required_topologies() -> void:
            can Memory.Allocate, Abort.Panic:
                cases: darray[EsLspCompilerRootCases::Case] = EsLspCompilerRootCases::ordinary("/fixture root")
                assert cases.count == EsLspCompilerRootCases::Fixture::CASES
                for item in cases:
                    assert item.label != "" and item.expected_status == 0 and item.expected_stderr == ""
                    assert item.expected_stdout.endswith("\n")
                assert cases[0].topology == EsLspCompilerRootCases::Topology.MissingCompilerSibling
                assert not cases[0].override_present and cases[0].override_value == ""
                assert cases[0].expected_stdout == "/fixture root/Elisa-LSP/../Elisa-compiler\n"
                assert cases[1].override_present and cases[1].override_value == ""
                assert cases[1].expected_stdout == cases[0].expected_stdout
                assert cases[2].override_value == "missing ; $HOME/*.elisa"
                assert cases[2].expected_stdout == "missing ; $HOME/*.elisa\n"
                assert cases[3].override_value == "/fixture root/missing compiler"
                assert cases[3].expected_stdout == "/fixture root/missing compiler\n"
                assert cases[4].topology == EsLspCompilerRootCases::Topology.ExistingOverrideFile
                assert cases[4].expected_stdout == "/fixture root/not-directory\n"
                assert cases[5].topology == EsLspCompilerRootCases::Topology.ExistingOverrideDirectory
                assert cases[5].expected_stdout == "/fixture root/compiler checkout\n"
                assert cases[6].topology == EsLspCompilerRootCases::Topology.OverrideDirectorySymlink
                assert cases[6].override_value == "/fixture root/link"
                assert cases[6].expected_stdout == cases[5].expected_stdout
                assert cases[7].topology == EsLspCompilerRootCases::Topology.ExistingCompilerSibling
                assert not cases[7].override_present
                assert cases[7].expected_stdout == "/fixture root/Elisa-compiler\n"
