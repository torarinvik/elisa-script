include "../../ports/elisa-engine/scripts/cxx_sanitize_plan.elisa"

using EsEngineCxxSanitizePlan


@test
def forwards_all_caller_arguments_as_literal_argv_after_sanitizer_flags() -> void can[Memory.Allocate, Abort.Panic]:
    caller_arguments: darray[sview] = ["-std=c++17", "-I", "/work/tree with spaces/include", "source file.cpp", "-o", "/tmp/probe binary"]
    plan: mutable Plan = Plan{program: "", arguments: []}
    catch command("address,undefined", caller_arguments):
        ok value:
            plan <- value
        error failure:
            _ = failure
            assert false

    assert plan.program == "c++"
    assert plan.arguments.count == 9
    assert plan.arguments[0] == "-fsanitize=address,undefined"
    assert plan.arguments[1] == "-fno-sanitize-recover=all"
    assert plan.arguments[2] == "-g"
    assert plan.arguments[3] == "-std=c++17"
    assert plan.arguments[4] == "-I"
    assert plan.arguments[5] == "/work/tree with spaces/include"
    assert plan.arguments[6] == "source file.cpp"
    assert plan.arguments[7] == "-o"
    assert plan.arguments[8] == "/tmp/probe binary"


@test
def selects_undefined_only_and_formats_unknown_flavor_diagnostic() -> void can[Memory.Allocate, Abort.Panic]:
    plan: mutable Plan = Plan{program: "", arguments: []}
    catch command("undefined", []):
        ok value:
            plan <- value
        error failure:
            _ = failure
            assert false
    assert plan.arguments.count == 3
    assert plan.arguments[0] == "-fsanitize=undefined"
    assert usage_error("thread") == "unknown ELISA_SANITIZER 'thread'; use address,undefined, undefined\n"


@test
def rejects_unknown_sanitizer_flavors() -> void can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch command("address", []):
        ok plan:
            _ = plan
        error failure:
            rejected <- failure == PlanError.UnknownSanitizerFlavor
    assert rejected
