# Process-level parity for the A03 diagnostic snapshot audit. Run from the
# repository root through the bounded wrapper after explicit reauthorization.
# This pins the public launcher bytes but does not attest to their build source.
# Reference and candidate receive the same minimal PATH/locale environment;
# ambient shell startup hooks and other inherited configuration are excluded.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsDiagnosticSnapshotLauncherParity:
    private:
        const module Commands:
            REFERENCE_SHELL: sview = "/bin/bash"
            REFERENCE_SCRIPT: sview = "scripts/check_diagnostic_snapshot.sh"
            CANDIDATE_SCRIPT: sview = "scripts/check_diagnostic_snapshot.elisascript"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            # Includes Homebrew rg plus the system text-processing utilities.
            CONTROLLED_PATH: sview = "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            MAX_LAUNCHER_BYTES: usize = 67108864
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_OUTPUT_BYTES: u64 = 1048576
            TIMEOUT_STEPS: u64 = 10000


        struct ExpectedCase:
            source_path: sview
            exit_status: i64
            stdout: sview
            stderr: sview
            extra_arguments: darray[sview] = []
            working_directory: sview = ""
            check_golden: bool = true


        struct TemporaryDirectory:
            path: Path
            created: bool = false


        def make_temporary_directory(prefix: sview) -> TemporaryDirectory can[Memory.Allocate, Abort.Panic, File.Write]:
            created_path: Path = try temp_directory(prefix) else err:
                return TemporaryDirectory{path: path("."), created: false}
            return TemporaryDirectory{path: created_path, created: true}


        def write_fixture_bytes(target: Path, contents: darray[u8]) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            written: usize = try write_bytes(target, contents) else 0u64
            return written == contents.count


        def remove_fixture_path(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            return try remove_path(target) else false


        def remove_fixture_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try remove_directory(target) else false


        def append_text_bytes(target: mutable darray[u8]&, value: sview) -> void can[Memory.Allocate, Abort.Panic]:
            for byte in value |target|:
                target.push(byte)


        def append_crlf_text_bytes(target: mutable darray[u8]&, value: sview) -> void can[Memory.Allocate, Abort.Panic]:
            for byte in value |target|:
                target.push(13u8) if byte == 10u8
                target.push(byte)


        def append_exact_padding(target: mutable darray[u8]&, size: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if target.count > size
            while target.count < size |target, size|:
                target.push(35u8)
            return true


        def lowercase_sha256_hex_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def launcher_has_expected_sha256(launcher: sview, expected_hex: sview) -> bool can[Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            launcher_path: Path = path(launcher)
            return false if not is_file(launcher_path)
            launcher_size: usize = try file_size(launcher_path) else err:
                return false
            return false if launcher_size == 0 or launcher_size > Commands::MAX_LAUNCHER_BYTES
            hash_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-diagnostic-snapshot-sha256",
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", launcher],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(hash_runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false

            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            expected_line: sview = expected_hex + "  " + launcher + "\n"
            return false if hash_run.stdout != expected_line
            for index in 0..<64 |hash_run, expected_hex|:
                return false if not lowercase_sha256_hex_byte(sview_at(expected_hex, index))
            return true


        def launcher_case_matches(launcher: sview, test_case: ExpectedCase) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference_script_path: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate_script_path: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            source_path: mutable sview = test_case.source_path
            if test_case.source_path != "":
                canonical_source_path: Path = try path_real(path(test_case.source_path)) else err:
                    return false
                source_path <- f"{canonical_source_path}"
            reference_arguments: mutable darray[sview] = [f"{reference_script_path}"]
            candidate_arguments: mutable darray[sview] = [f"{candidate_script_path}"]
            if source_path != "":
                reference_arguments.push(source_path)
                candidate_arguments.push(source_path)
            case_label: mutable sview = source_path
            if case_label == "":
                case_label <- "default path"
            for argument in test_case.extra_arguments |reference_arguments, candidate_arguments|:
                reference_arguments.push(argument)
                candidate_arguments.push(argument)
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "shell-diagnostic-snapshot-reference",
                target: Commands::REFERENCE_SHELL,
                arguments: reference_arguments,
                working_directory: test_case.working_directory,
                environment: [
                    DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                    DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"}
                ],
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    eprint("diagnostic snapshot reference process failed")
                    return false

            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-diagnostic-snapshot",
                target: launcher,
                arguments: candidate_arguments,
                working_directory: test_case.working_directory,
                environment: [
                    DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                    DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"}
                ],
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    eprint("diagnostic snapshot candidate process failed")
                    return false

            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            if reference_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed or not comparison.equal:
                eprint("diagnostic snapshot parity mismatch: " + case_label)
                return false
            if test_case.check_golden:
                if reference_run.exit_status != test_case.exit_status or reference_run.stdout != test_case.stdout or reference_run.stderr != test_case.stderr:
                    eprint("diagnostic snapshot golden mismatch: " + case_label)
                    return false
                if candidate_run.exit_status != test_case.exit_status or candidate_run.stdout != test_case.stdout or candidate_run.stderr != test_case.stderr:
                    eprint("Elisascript diagnostic snapshot golden mismatch: " + case_label)
                    return false
            return true


        def generated_boundary_cases_match(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary: TemporaryDirectory = make_temporary_directory("elisascript-diagnostic-snapshot-limits")
            return false if not temporary.created
            root_path: Path = try path_real(temporary.path) else err:
                _ = remove_fixture_directory(temporary.path)
                return false
            generated_path: Path = root_path.joinpath("runner.elisa")
            generated_text: sview = f"{generated_path}"
            source_path: Path = path("test/fixtures/script_parity/diagnostic_snapshot/positive/runner.elisa")
            positive_source: sview = try read_text(source_path) else err:
                _ = remove_fixture_directory(root_path)
                return false
            all_ok: mutable bool = true

            exact_size: mutable darray[u8] = []
            append_text_bytes(exact_size, positive_source)
            all_ok <- append_exact_padding(exact_size, 262144u64) and all_ok
            all_ok <- write_fixture_bytes(generated_path, exact_size) and all_ok
            exact_case: ExpectedCase = ExpectedCase{source_path: generated_text, exit_status: 0, stdout: "diagnostic snapshot audit: 2 fields covered (execution intentionally excluded)\n", stderr: ""}
            all_ok <- launcher_case_matches(launcher, exact_case) and all_ok

            oversized: mutable darray[u8] = []
            append_text_bytes(oversized, positive_source)
            all_ok <- append_exact_padding(oversized, 262145u64) and all_ok
            all_ok <- write_fixture_bytes(generated_path, oversized) and all_ok
            oversized_case: ExpectedCase = ExpectedCase{source_path: generated_text, exit_status: 1, stdout: "", stderr: "diagnostic snapshot audit: runner source exceeds audit limit\n"}
            all_ok <- launcher_case_matches(launcher, oversized_case) and all_ok

            crlf_source: mutable darray[u8] = []
            append_crlf_text_bytes(crlf_source, positive_source)
            all_ok <- write_fixture_bytes(generated_path, crlf_source) and all_ok
            crlf_case: ExpectedCase = ExpectedCase{source_path: generated_text, exit_status: 0, stdout: "diagnostic snapshot audit: 2 fields covered (execution intentionally excluded)\n", stderr: ""}
            all_ok <- launcher_case_matches(launcher, crlf_case) and all_ok

            bare_cr_source: mutable darray[u8] = []
            append_text_bytes(bare_cr_source, positive_source)
            bare_cr_source.push(13u8)
            all_ok <- write_fixture_bytes(generated_path, bare_cr_source) and all_ok
            bare_cr_case: ExpectedCase = ExpectedCase{source_path: generated_text, exit_status: 1, stdout: "", stderr: "diagnostic snapshot audit: bare carriage return is unsupported\n"}
            all_ok <- launcher_case_matches(launcher, bare_cr_case) and all_ok

            fields_source: mutable darray[u8] = []
            append_text_bytes(fields_source, "module EsIr:\n    public:\n        struct ElisascriptProgramDiagnostic:\n")
            for index in 0..<257 |fields_source|:
                append_text_bytes(fields_source, f"            field_{index}: sview\n")
            all_ok <- write_fixture_bytes(generated_path, fields_source) and all_ok
            fields_case: ExpectedCase = ExpectedCase{source_path: generated_text, exit_status: 1, stdout: "", stderr: "diagnostic snapshot audit: diagnostic field count exceeds audit limit\n"}
            all_ok <- launcher_case_matches(launcher, fields_case) and all_ok

            long_field_source: mutable darray[u8] = []
            append_text_bytes(long_field_source, "module EsIr:\n    public:\n        struct ElisascriptProgramDiagnostic:\n            ")
            for _ in 0..<129 |long_field_source|:
                long_field_source.push(97u8)
            append_text_bytes(long_field_source, ": sview\n")
            all_ok <- write_fixture_bytes(generated_path, long_field_source) and all_ok
            long_field_case: ExpectedCase = ExpectedCase{source_path: generated_text, exit_status: 1, stdout: "", stderr: "diagnostic snapshot audit: diagnostic field name exceeds audit limit\n"}
            all_ok <- launcher_case_matches(launcher, long_field_case) and all_ok

            all_ok <- write_fixture_bytes(generated_path, exact_size) and all_ok
            extra_argument_case: ExpectedCase = ExpectedCase{source_path: generated_text, exit_status: 2, stdout: "", stderr: "usage: diagnostic snapshot audit [runner-source]\n", extra_arguments: ["extra"]}
            all_ok <- launcher_case_matches(launcher, extra_argument_case) and all_ok

            _ = remove_fixture_path(generated_path)
            cleanup_ok: bool = remove_fixture_directory(root_path)
            return all_ok and cleanup_ok


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def all_launcher_cases_match(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            expected_stdout: sview = "diagnostic snapshot audit: 2 fields covered (execution intentionally excluded)\n"
            cases: darray[ExpectedCase] = [
                ExpectedCase{source_path: "", exit_status: 0, stdout: "", stderr: "", working_directory: "/", check_golden: false},
                ExpectedCase{source_path: "", exit_status: 0, stdout: "", stderr: "", extra_arguments: [""], working_directory: "/", check_golden: false},
                ExpectedCase{source_path: "test/fixtures/script_parity/diagnostic_snapshot/positive/runner.elisa", exit_status: 0, stdout: expected_stdout, stderr: ""},
                ExpectedCase{source_path: "test/fixtures/script_parity/diagnostic_snapshot/compact_fields/runner.elisa", exit_status: 0, stdout: expected_stdout, stderr: ""},
                ExpectedCase{source_path: "test/fixtures/script_parity/diagnostic_snapshot/missing_fingerprint/runner.elisa", exit_status: 1, stdout: "", stderr: "diagnostic snapshot audit: fingerprint omits entrypoint_error\n"},
                ExpectedCase{source_path: "test/fixtures/script_parity/diagnostic_snapshot/missing_fingerprint_source/runner.elisa", exit_status: 1, stdout: "", stderr: "diagnostic snapshot audit: fingerprint omits source\n"},
                ExpectedCase{source_path: "test/fixtures/script_parity/diagnostic_snapshot/missing_equality/runner.elisa", exit_status: 1, stdout: "", stderr: "diagnostic snapshot audit: structural equality omits entrypoint_error\n"},
                ExpectedCase{source_path: "test/fixtures/script_parity/diagnostic_snapshot/missing_equality_source/runner.elisa", exit_status: 1, stdout: "", stderr: "diagnostic snapshot audit: structural equality omits source\n"},
                ExpectedCase{source_path: "test/fixtures/script_parity/diagnostic_snapshot/missing_operations/runner.elisa", exit_status: 1, stdout: "", stderr: "diagnostic snapshot audit: missing snapshot operations\n"}
            ]
            for test_case in cases:
                return false if not launcher_case_matches(launcher, test_case)
            return generated_boundary_cases_match(launcher)


@test
def diagnostic_snapshot_public_launcher_matches_shell_and_golden_output() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        assert reauthorized == "1"
        assert compiler == EsDiagnosticSnapshotLauncherParity::pinned_compiler_path()
        assert launcher != ""
        assert launcher.startswith("/")
        assert EsDiagnosticSnapshotLauncherParity::launcher_has_expected_sha256(launcher, launcher_hash)
        println("public_launcher_path=" + launcher)
        println("public_launcher_sha256=" + launcher_hash)
        assert EsDiagnosticSnapshotLauncherParity::all_launcher_cases_match(launcher)
        assert EsDiagnosticSnapshotLauncherParity::launcher_has_expected_sha256(launcher, launcher_hash)
