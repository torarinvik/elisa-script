# Process-level parity for the A03 diagnostic snapshot audit. Run from the
# repository root through the bounded wrapper after explicit reauthorization.
# This pins the public launcher bytes but does not attest to their build source.
# Reference and candidate receive the same minimal PATH/locale environment;
# ambient shell startup hooks and other inherited configuration are excluded.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsDiagnosticSnapshotLauncherParity:
    private:
        const module Commands:
            REFERENCE_SHELL: sview = "/bin/bash"
            REFERENCE_SCRIPT: sview = "scripts/check_diagnostic_snapshot.sh"
            CANDIDATE_SCRIPT: sview = "scripts/check_diagnostic_snapshot.elisascript"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            # Includes Homebrew rg plus the system text-processing utilities.
            CONTROLLED_PATH: sview = "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            MAX_LAUNCHER_BYTES: usize = 67108864
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_OUTPUT_BYTES: u64 = 1048576
            TIMEOUT_STEPS: u64 = 10000


        struct ExpectedCase:
            source_path: sview
            exit_status: i64
            stdout: sview
            stderr: sview


        def lowercase_sha256_hex_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def launcher_has_expected_sha256(launcher: sview, expected_hex: sview) -> bool can[Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            launcher_path: Path = path(launcher)
            return false if not is_file(launcher_path)
            launcher_size: usize = try file_size(launcher_path) else err:
                return false
            return false if launcher_size == 0 or launcher_size > Commands::MAX_LAUNCHER_BYTES
            hash_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-diagnostic-snapshot-sha256",
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", launcher],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(hash_runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false

            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            expected_line: sview = expected_hex + "  " + launcher + "\n"
            return false if hash_run.stdout != expected_line
            for index in 0..<64 |hash_run, expected_hex|:
                return false if not lowercase_sha256_hex_byte(sview_at(expected_hex, index))
            return true


        def launcher_case_matches(launcher: sview, test_case: ExpectedCase) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference_script_path: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate_script_path: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            source_path: Path = try path_real(path(test_case.source_path)) else err:
                return false
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "shell-diagnostic-snapshot-reference",
                target: Commands::REFERENCE_SHELL,
                arguments: [f"{reference_script_path}", f"{source_path}"],
                environment: [
                    DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                    DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"}
                ],
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    eprint("diagnostic snapshot reference process failed")
                    return false

            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-diagnostic-snapshot",
                target: launcher,
                arguments: [f"{candidate_script_path}", f"{source_path}"],
                environment: [
                    DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                    DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"}
                ],
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    eprint("diagnostic snapshot candidate process failed")
                    return false

            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            if reference_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed or not comparison.equal:
                eprint("diagnostic snapshot parity mismatch: " + test_case.source_path)
                return false
            if reference_run.exit_status != test_case.exit_status or reference_run.stdout != test_case.stdout or reference_run.stderr != test_case.stderr:
                eprint("diagnostic snapshot golden mismatch: " + test_case.source_path)
                return false
            if candidate_run.exit_status != test_case.exit_status or candidate_run.stdout != test_case.stdout or candidate_run.stderr != test_case.stderr:
                eprint("Elisascript diagnostic snapshot golden mismatch: " + test_case.source_path)
                return false
            return true


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def all_launcher_cases_match(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            expected_stdout: sview = "diagnostic snapshot audit: 2 fields covered (execution intentionally excluded)\n"
            cases: darray[ExpectedCase] = [
                ExpectedCase{source_path: "test/fixtures/script_parity/diagnostic_snapshot/positive/runner.elisa", exit_status: 0, stdout: expected_stdout, stderr: ""},
                ExpectedCase{source_path: "test/fixtures/script_parity/diagnostic_snapshot/compact_fields/runner.elisa", exit_status: 0, stdout: expected_stdout, stderr: ""},
                ExpectedCase{source_path: "test/fixtures/script_parity/diagnostic_snapshot/missing_fingerprint/runner.elisa", exit_status: 1, stdout: "", stderr: "diagnostic snapshot audit: fingerprint omits entrypoint_error\n"},
                ExpectedCase{source_path: "test/fixtures/script_parity/diagnostic_snapshot/missing_fingerprint_source/runner.elisa", exit_status: 1, stdout: "", stderr: "diagnostic snapshot audit: fingerprint omits source\n"},
                ExpectedCase{source_path: "test/fixtures/script_parity/diagnostic_snapshot/missing_equality/runner.elisa", exit_status: 1, stdout: "", stderr: "diagnostic snapshot audit: structural equality omits entrypoint_error\n"},
                ExpectedCase{source_path: "test/fixtures/script_parity/diagnostic_snapshot/missing_equality_source/runner.elisa", exit_status: 1, stdout: "", stderr: "diagnostic snapshot audit: structural equality omits source\n"},
                ExpectedCase{source_path: "test/fixtures/script_parity/diagnostic_snapshot/missing_operations/runner.elisa", exit_status: 1, stdout: "", stderr: "diagnostic snapshot audit: missing snapshot operations\n"}
            ]
            for test_case in cases:
                return false if not launcher_case_matches(launcher, test_case)
            return true


@test
def diagnostic_snapshot_public_launcher_matches_shell_and_golden_output() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, Directory.Read, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        assert reauthorized == "1"
        assert compiler == EsDiagnosticSnapshotLauncherParity::pinned_compiler_path()
        assert launcher != ""
        assert launcher.startswith("/")
        assert EsDiagnosticSnapshotLauncherParity::launcher_has_expected_sha256(launcher, launcher_hash)
        println("public_launcher_path=" + launcher)
        println("public_launcher_sha256=" + launcher_hash)
        assert EsDiagnosticSnapshotLauncherParity::all_launcher_cases_match(launcher)
        assert EsDiagnosticSnapshotLauncherParity::launcher_has_expected_sha256(launcher, launcher_hash)
