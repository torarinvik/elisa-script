# Source-only fixtures. No Python generator, compiler or file mutation runs.
include "../../ports/Elisa-LSP/scripts/diagnostic_codes_model.elisa"
include "../../ports/Elisa-LSP/scripts/diagnostic_codes_cli_model.elisa"
include "../../src/runtime/bounded_text_posix.elisa"

module EsDiagnosticCodesFixture:
    public:
        @test
        def cli_options_keep_last_value_and_check_switch() -> void:
            can Memory.Allocate, Abort.Panic:
                options: EsDiagnosticCodesCliArgs::Options = try EsDiagnosticCodesCliArgs::parse(["--output", "old.elisa", "--compiler-root", "/compiler", "--output", "src/diagnostic_codes.elisa", "--check"]) else err:
                    assert false
                    return
                assert options.compiler_root == "/compiler"
                assert options.output == "src/diagnostic_codes.elisa" and options.check
                defaults: EsDiagnosticCodesCliArgs::Options = try EsDiagnosticCodesCliArgs::parse([]) else err:
                    assert false
                    return
                assert defaults.compiler_root == "" and defaults.output == "src/diagnostic_codes.elisa" and not defaults.check


        @test
        def cli_options_reject_unknown_and_missing_values() -> void:
            can Memory.Allocate, Abort.Panic:
                rejected_unknown: mutable bool = false
                catch EsDiagnosticCodesCliArgs::parse(["--mystery"]):
                    ok _:
                        assert false
                    error failure:
                        rejected_unknown <- failure == EsDiagnosticCodesCliArgs::ParseError.InvalidArguments
                assert rejected_unknown
                rejected_value: mutable bool = false
                catch EsDiagnosticCodesCliArgs::parse(["--output"]):
                    ok _:
                        assert false
                    error failure:
                        rejected_value <- failure == EsDiagnosticCodesCliArgs::ParseError.InvalidArguments
                assert rejected_value


        @test
        def cli_options_accept_argparse_equals_and_terminator_forms() -> void:
            can Memory.Allocate, Abort.Panic:
                options: EsDiagnosticCodesCliArgs::Options = try EsDiagnosticCodesCliArgs::parse(["--output=result.elisa", "--compiler-root=/compiler", "--check", "--"]) else err:
                    assert false
                    return
                assert options.compiler_root_set and options.compiler_root == "/compiler"
                assert options.output == "result.elisa" and options.check
                explicit_empty_root: EsDiagnosticCodesCliArgs::Options = try EsDiagnosticCodesCliArgs::parse(["--compiler-root", ""]) else err:
                    assert false
                    return
                assert explicit_empty_root.compiler_root_set and explicit_empty_root.compiler_root == ""
                terminated: EsDiagnosticCodesCliArgs::Options = try EsDiagnosticCodesCliArgs::parse(["--"]) else err:
                    assert false
                    return
                assert not terminated.check and terminated.output == "src/diagnostic_codes.elisa"
                rejected_option_value: mutable bool = false
                catch EsDiagnosticCodesCliArgs::parse(["--output", "--check"]):
                    ok _:
                        assert false
                    error failure:
                        rejected_option_value <- failure == EsDiagnosticCodesCliArgs::ParseError.InvalidArguments
                assert rejected_option_value
                rejected_switch_value: mutable bool = false
                catch EsDiagnosticCodesCliArgs::parse(["--check=true"]):
                    ok _:
                        assert false
                    error failure:
                        rejected_switch_value <- failure == EsDiagnosticCodesCliArgs::ParseError.InvalidArguments
                assert rejected_switch_value


        @test
        def cli_options_accept_unambiguous_argparse_abbreviations() -> void:
            can Memory.Allocate, Abort.Panic:
                options: EsDiagnosticCodesCliArgs::Options = try EsDiagnosticCodesCliArgs::parse(["--comp=/compiler", "--out", "result.elisa", "--che"]) else err:
                    assert false
                    return
                assert options.compiler_root_set and options.compiler_root == "/compiler"
                assert options.output == "result.elisa" and options.check

                ambiguous: mutable bool = false
                catch EsDiagnosticCodesCliArgs::parse(["--c"]):
                    ok _:
                        assert false
                    error failure:
                        ambiguous <- failure == EsDiagnosticCodesCliArgs::ParseError.InvalidArguments
                assert ambiguous

                unknown_suffix: mutable bool = false
                catch EsDiagnosticCodesCliArgs::parse(["--output-file", "result.elisa"]):
                    ok _:
                        assert false
                    error failure:
                        unknown_suffix <- failure == EsDiagnosticCodesCliArgs::ParseError.InvalidArguments
                assert unknown_suffix


        @test
        def extracts_only_exactly_indented_unique_members() -> void:
            can Memory.Allocate, Abort.Panic:
                source: sview = "        const enum DiagnosticKind of u16:\n            Alpha\n             NotAMember\n            # Comment\n            Beta_2  \n        extend Semantic:\n            Ignored\n"
                names: darray[sview] = try EsDiagnosticCodes::variants(source) else err:
                    assert false
                    return
                assert names.count == 2 and names[0] == "Alpha" and names[1] == "Beta_2"
                rendered: sview = try EsDiagnosticCodes::render(names) else err:
                    assert false
                    return
                assert rendered.index("Semantic::DiagnosticKind.Alpha: \"ELISA-Alpha\"") >= 0
                assert rendered.index("Semantic::DiagnosticKind.Beta_2: \"ELISA-Beta_2\"") >= 0
                assert rendered.endswith("        _: \"ELISA-Unknown\"\n")


        @test
        def rejects_duplicate_variant_names() -> void:
            can Memory.Allocate, Abort.Panic:
                duplicate: sview = "        const enum DiagnosticKind of u16:\n            Same\n            Same\n"
                rejected: mutable bool = false
                catch EsDiagnosticCodes::variants(duplicate):
                    ok _:
                        assert false
                    error failure:
                        rejected <- failure == EsDiagnosticCodes::DiagnosticCodeError.DuplicateVariant
                assert rejected


        @test
        def real_compiler_enum_projects_to_checked_in_lsp_adapter() -> void:
            can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                source: sview = try EsBoundedText::read_utf8(path("../Elisa-compiler/src/semantic/semantic_types_diagnostic_kind.elisa"), 131072usize) else err:
                    assert false
                    return
                expected: sview = try EsBoundedText::read_utf8(path("../Elisa-LSP/src/diagnostic_codes.elisa"), 65536usize) else err:
                    assert false
                    return
                actual: sview = try EsDiagnosticCodes::project(source) else err:
                    assert false
                    return
                assert actual == expected
