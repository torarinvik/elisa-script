# Source-only fixtures. No Python generator, compiler or file mutation runs.
include "../../ports/Elisa-LSP/scripts/diagnostic_codes_model.elisa"
include "../../src/runtime/bounded_text_posix.elisa"

module EsDiagnosticCodesFixture:
    public:
        @test
        def extracts_only_exactly_indented_unique_members() -> void:
            can Memory.Allocate, Abort.Panic:
                source: sview = "        const enum DiagnosticKind of u16:\n            Alpha\n             NotAMember\n            # Comment\n            Beta_2  \n        extend Semantic:\n            Ignored\n"
                names: darray[sview] = try EsDiagnosticCodes::variants(source) else err:
                    assert false
                    return
                assert names.count == 2 and names[0] == "Alpha" and names[1] == "Beta_2"
                rendered: sview = try EsDiagnosticCodes::render(names) else err:
                    assert false
                    return
                assert rendered.index("Semantic::DiagnosticKind.Alpha: \"ELISA-Alpha\"") >= 0
                assert rendered.index("Semantic::DiagnosticKind.Beta_2: \"ELISA-Beta_2\"") >= 0
                assert rendered.endswith("        _: \"ELISA-Unknown\"\n")


        @test
        def rejects_duplicate_variant_names() -> void:
            can Memory.Allocate, Abort.Panic:
                duplicate: sview = "        const enum DiagnosticKind of u16:\n            Same\n            Same\n"
                rejected: mutable bool = false
                catch EsDiagnosticCodes::variants(duplicate):
                    ok _:
                        assert false
                    error failure:
                        rejected <- failure == EsDiagnosticCodes::DiagnosticCodeError.DuplicateVariant
                assert rejected


        @test
        def real_compiler_enum_projects_to_checked_in_lsp_adapter() -> void:
            can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                source: sview = try EsBoundedText::read_utf8(path("../Elisa-compiler/src/semantic/semantic_types_diagnostic_kind.elisa"), 131072usize) else err:
                    assert false
                    return
                expected: sview = try EsBoundedText::read_utf8(path("../Elisa-LSP/src/diagnostic_codes.elisa"), 65536usize) else err:
                    assert false
                    return
                actual: sview = try EsDiagnosticCodes::project(source) else err:
                    assert false
                    return
                assert actual == expected
