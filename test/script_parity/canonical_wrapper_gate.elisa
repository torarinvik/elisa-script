# Pure admission only. Flags/hashes/header bytes do not authorize execution or
# prove build provenance, native ABI, dependency closure or external containment.
module EsCanonicalWrapperGate:
    public:
        const module Pins:
            COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"


        struct Identity:
            path: sview
            hash: sview


        struct Gate:
            reauthorized: bool = false
            rss_guard: bool = false
            launcher_qualified: bool = false
            probe_qualified: bool = false
            local_compiler: sview
            core_compiler: sview
            launcher: Identity
            probe: Identity
            compiler_hash: sview


        error GateError:
            Disabled
            WrongCompiler
            MissingIdentity
            Alias


        def valid_hash(value: sview) -> bool:
            return false if len(value) != 64
            for byte in value:
                return false if not ((byte >= 48u8 and byte <= 57u8) or (byte >= 97u8 and byte <= 102u8))
            return true


        def absolute_identity_path(value: sview) -> bool:
            return false if not value.startswith("/") or value == "/" or len(value) >= 4096
            for byte in value:
                return false if byte == 0u8 or byte == 10u8 or byte == 13u8
            return true


        def validate(gate: Gate) -> void error[GateError]:
            raise GateError.Disabled if not gate.reauthorized or not gate.rss_guard or not gate.launcher_qualified or not gate.probe_qualified
            raise GateError.WrongCompiler if gate.local_compiler != Pins::COMPILER or gate.core_compiler != Pins::COMPILER
            raise GateError.MissingIdentity if not absolute_identity_path(gate.launcher.path) or not absolute_identity_path(gate.probe.path)
            raise GateError.MissingIdentity if not valid_hash(gate.launcher.hash) or not valid_hash(gate.probe.hash) or not valid_hash(gate.compiler_hash)
            raise GateError.Alias if gate.launcher.path == gate.probe.path or gate.launcher.path == Pins::COMPILER or gate.probe.path == Pins::COMPILER
            raise GateError.Alias if gate.launcher.hash == gate.probe.hash or gate.launcher.hash == gate.compiler_hash or gate.probe.hash == gate.compiler_hash


        # Only container magic recognition, not an executable-validity proof.
        def native_container_header(bytes: darray[u8]&) -> bool:
            return false if bytes.count != 4
            elf: bool = bytes[0] == 127u8 and bytes[1] == 69u8 and bytes[2] == 76u8 and bytes[3] == 70u8
            macho_little: bool = bytes[0] == 207u8 and bytes[1] == 250u8 and bytes[2] == 237u8 and bytes[3] == 254u8
            macho_big: bool = bytes[0] == 254u8 and bytes[1] == 237u8 and bytes[2] == 250u8 and bytes[3] == 207u8
            fat_big: bool = bytes[0] == 202u8 and bytes[1] == 254u8 and bytes[2] == 186u8 and (bytes[3] == 190u8 or bytes[3] == 191u8)
            fat_little: bool = (bytes[0] == 190u8 or bytes[0] == 191u8) and bytes[1] == 186u8 and bytes[2] == 254u8 and bytes[3] == 202u8
            return elf or macho_little or macho_big or fat_big or fat_little
