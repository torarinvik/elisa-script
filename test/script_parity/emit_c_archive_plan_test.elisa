# Pure planned-argv fixtures; no Python, archiver, filesystem or compiler runs.
include "../../ports/Elisa-compiler/scripts/emit_c_archive_plan.elisa"

module EsCArchivePlanFixture:
    public:
        @test
        def ordinary_c_archive_command_keeps_object_order() -> void:
            can Memory.Allocate, Abort.Panic:
                plan: EsCArchivePlan::Plan = try EsCArchivePlan::parse_ordinary(["--output", "build/lib.a", "build/unit.o", "build/runtime.o"], "", "/usr/bin/ar") else err:
                    assert false
                    return
                assert plan.output == "build/lib.a" and plan.archiver == "/usr/bin/ar"
                assert plan.objects.count == 2 and plan.objects[0] == "build/unit.o" and plan.objects[1] == "build/runtime.o"
                arguments: darray[sview] = try EsCArchivePlan::archive_arguments(plan, "build/elisa-c-archive-ABC123/lib.a") else err:
                    assert false
                    return
                assert arguments.count == 4 and arguments[0] == "-rcs" and arguments[1] == "build/elisa-c-archive-ABC123/lib.a"
                assert arguments[2] == "build/unit.o" and arguments[3] == "build/runtime.o"


        @test
        def explicit_archiver_wins_over_environment_and_path() -> void:
            can Memory.Allocate, Abort.Panic:
                plan: EsCArchivePlan::Plan = try EsCArchivePlan::parse_ordinary(["unit.o", "--ar", "/chosen/ar", "--output", "lib.a"], "/env/ar", "/path/ar") else err:
                    assert false
                    return
                assert plan.archiver == "/chosen/ar" and plan.objects.count == 1
                inherited: EsCArchivePlan::Plan = try EsCArchivePlan::parse_ordinary(["--output", "lib.a", "unit.o"], "/env/ar", "/path/ar") else err:
                    assert false
                    return
                assert inherited.archiver == "/env/ar"


        @test
        def end_of_options_allows_dash_prefixed_object() -> void:
            can Memory.Allocate, Abort.Panic:
                plan: EsCArchivePlan::Plan = try EsCArchivePlan::parse_ordinary(["--output", "lib.a", "--", "-unit.o"], "", "/path/ar") else err:
                    assert false
                    return
                assert plan.objects.count == 1 and plan.objects[0] == "-unit.o"
