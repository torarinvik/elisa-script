include "../../ports/elisa-engine/scripts/dependency_manifest_json_model.elisa"

using EsEngineDependencyManifestJson


def dependency_manifest_test_parse(source: sview) -> DecodedManifest can[Memory.Allocate, Abort.Panic]:
    result: mutable DecodedManifest = zeroed
    catch manifest_from_json(source):
        ok decoded:
            result <- decoded
        error failure:
            _ = failure
            assert false
    return result


def dependency_manifest_test_schema_rejected(source: sview, expected: ManifestJsonError) -> bool can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch manifest_from_json(source):
        ok decoded:
            _ = decoded
        error failure:
            rejected <- failure == expected
    return rejected


@test
def projects_dependency_entries_hashes_and_nested_cache_policy() -> void can[Memory.Allocate, Abort.Panic]:
    source: sview = "{\"schema\":1,\"driver\":\"scripts/wicked_probe.elisascript\",\"build\":{\"forbidden_link_names\":[\"SDL2\",\"sdl2\"],\"required_flags\":[\"-DSDL3=1\"],\"wicked_cache\":{\"path\":\"build-elisa-sdl3/CMakeCache.txt\",\"values\":{\"WICKED_USE_SDL3\":\"OFF\",\"WICKED_USE_SDL3\":\"ON\",\"BUILD_SDL3\":\"ON\"}}},\"libraries\":[{\"name\":\"WickedEngine\",\"kind\":\"git\",\"path_environment\":\"WICKED_ROOT\",\"path_default\":\"../amazing-labyrinth-wickedengine\",\"revision\":\"abc123\",\"artifacts\":[\"build/libWickedEngine.a\"]},{\"name\":\"cgltf\",\"kind\":\"file\",\"path_default\":\"dependencies/cgltf\",\"artifacts\":[{\"path\":\"cgltf.h\",\"sha256\":\"0123456789abcdef\"}],\"include_environment\":\"CG_INCLUDE\",\"include_default\":\"/opt/include\",\"include_artifacts\":[\"cgltf.h\"]}]}"
    decoded: DecodedManifest = dependency_manifest_test_parse(source)
    assert decoded.manifest.driver == "scripts/wicked_probe.elisascript"
    assert decoded.manifest.build.forbidden_link_names == ["SDL2", "sdl2"]
    assert decoded.manifest.build.required_flags == ["-DSDL3=1"]
    assert decoded.manifest.build.wicked_cache_path == "build-elisa-sdl3/CMakeCache.txt"
    assert decoded.manifest.build.wicked_cache_values.count == 2
    assert decoded.manifest.build.wicked_cache_values[0].key == "WICKED_USE_SDL3"
    assert decoded.manifest.build.wicked_cache_values[1].value == "ON"

    assert decoded.manifest.libraries.count == 2
    engine: Library = decoded.manifest.libraries[0]
    assert engine.name == "WickedEngine"
    assert engine.kind == "git"
    assert engine.path_environment == "WICKED_ROOT"
    assert engine.path_default == "../amazing-labyrinth-wickedengine"
    assert engine.revision_kind == RevisionKind.Text and engine.revision == "abc123"
    assert engine.artifacts[0].path == "build/libWickedEngine.a"
    assert not engine.artifacts[0].has_sha256

    cgltf: Library = decoded.manifest.libraries[1]
    assert cgltf.artifacts[0].path == "cgltf.h"
    assert cgltf.artifacts[0].has_sha256 and cgltf.artifacts[0].sha256 == "0123456789abcdef"
    assert cgltf.has_include_default and cgltf.include_default == "/opt/include"
    assert cgltf.include_environment == "CG_INCLUDE"
    assert cgltf.include_artifacts == ["cgltf.h"]


@test
def matches_python_schema_equality_and_keep_last_duplicate_keys() -> void can[Memory.Allocate, Abort.Panic]:
    documents: darray[sview] = [
        "{\"schema\":true,\"driver\":\"d\",\"build\":{\"forbidden_link_names\":[],\"required_flags\":[],\"wicked_cache\":{\"path\":\"c\",\"values\":{}}},\"libraries\":[]}",
        "{\"schema\":1.0,\"driver\":\"d\",\"build\":{\"forbidden_link_names\":[],\"required_flags\":[],\"wicked_cache\":{\"path\":\"c\",\"values\":{}}},\"libraries\":[]}",
        "{\"schema\":10e-1,\"driver\":\"d\",\"build\":{\"forbidden_link_names\":[],\"required_flags\":[],\"wicked_cache\":{\"path\":\"c\",\"values\":{}}},\"libraries\":[{\"name\":\"x\",\"path_default\":\"first\",\"path_default\":\"last\"}]}"
    ]
    first: DecodedManifest = dependency_manifest_test_parse(documents[0])
    second: DecodedManifest = dependency_manifest_test_parse(documents[1])
    third: DecodedManifest = dependency_manifest_test_parse(documents[2])
    assert first.manifest.driver == "d"
    assert second.manifest.driver == "d"
    assert third.manifest.libraries[0].path_default == "last"


@test
def rejects_unsupported_schema_and_malformed_json() -> void can[Memory.Allocate, Abort.Panic]:
    unsupported: sview = "{\"schema\":2,\"driver\":\"d\",\"build\":{\"forbidden_link_names\":[],\"required_flags\":[],\"wicked_cache\":{\"path\":\"c\",\"values\":{}}},\"libraries\":[]}"
    malformed: sview = "{\"schema\":1,"
    assert dependency_manifest_test_schema_rejected(unsupported, ManifestJsonError.UnsupportedSchema)
    assert dependency_manifest_test_schema_rejected(malformed, ManifestJsonError.InvalidJson)
