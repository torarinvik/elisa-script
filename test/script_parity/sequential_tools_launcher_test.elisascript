# Gated A07 shell-vs-Elisascript public-launcher parity.
# Run only through the bounded validation wrapper after explicit authorization.
include "../../src/testing/differential.elisa"
include "../../src/runtime/bounded_text_posix.elisa"

using EsDifferential
using EsBoundedText
using EsProcess


module EsSequentialToolsLauncherParity:
    private:
        const module Commands:
            SHELL: sview = "/bin/sh"
            REFERENCE: sview = "test/fixtures/script_parity/sequential_tools/reference.sh"
            CANDIDATE: sview = "test/fixtures/script_parity/sequential_tools/candidate.elisascript"
            EXPECTED: sview = "test/fixtures/script_parity/sequential_tools/expected.txt"
            BUILD_EXECUTOR: sview = "src/runtime/build_executor_model.elisa"
            BUILD_MODEL: sview = "src/runtime/build_model.elisa"
            PROCESS_MODEL: sview = "src/runtime/process_model.elisa"
            PROCESS_POSIX: sview = "src/runtime/process_posix.elisa"
            BOUNDED_READER: sview = "src/runtime/bounded_text_posix.elisa"
            HASH_TOOL: sview = "/usr/bin/shasum"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            CONTROLLED_PATH: sview = "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            MAX_HASHED_FILE_BYTES: usize = 67108864
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_RUN_OUTPUT_BYTES: u64 = 4096
            MAX_GOLDEN_BYTES: usize = 4096
            TIMEOUT_STEPS: u64 = 10000


        const module SourceHashes:
            REFERENCE: sview = "3a88c565050986441b8a08319777112f9bb62025d055386ec1f4e5747b6be88b"
            CANDIDATE: sview = "15ff536e9571bb824840c2e22e7cf5a15d6c222895283d2ef06a1ac44adf3ca5"
            EXPECTED: sview = "5f3b7438fefc37c59486548614bf8ca7b2e24421a04d16690de3b92c5325116b"
            BUILD_EXECUTOR: sview = "a440e69adf86dfa367682596c931b261eaf4d157410d9437953dc4f775ba4abc"
            BUILD_MODEL: sview = "7c03655698d241cfb779a1a8dd3ba8b66170ca1511ca97f1dd5fae06580b5d6d"
            PROCESS_MODEL: sview = "c3d3ef603c82d29b01a3c854ddcf752d248ba9b1c9a503b92b18a41443a20d10"
            PROCESS_POSIX: sview = "5a5501f9c17ab0908b9b85514e278362e1e43424f1e9029f3d771fee1c10be50"
            BOUNDED_READER: sview = "f648d319aca3610e245452d681c21556cc58a774982ea8d0bbda2cca4f1823be"


        def lowercase_sha256_hex_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def file_has_sha256(path_text: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            source_path: Path = path(path_text)
            return false if not is_file(source_path)
            source_size: usize = try file_size(source_path) else err:
                return false
            return false if source_size == 0 or source_size > Commands::MAX_HASHED_FILE_BYTES
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "sequential-tools-source-sha256",
                target: Commands::HASH_TOOL,
                arguments: ["-a", "256", path_text],
                environment_mode: ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false
            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            return false if hash_run.stdout != expected_hex + "  " + path_text + "\n"
            for index in 0..<64 |hash_run, expected_hex|:
                return false if not lowercase_sha256_hex_byte(sview_at(expected_hex, index))
            return true


        def source_set_is_pinned() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return file_has_sha256(Commands::REFERENCE, SourceHashes::REFERENCE) and file_has_sha256(Commands::CANDIDATE, SourceHashes::CANDIDATE) and file_has_sha256(Commands::EXPECTED, SourceHashes::EXPECTED) and file_has_sha256(Commands::BUILD_EXECUTOR, SourceHashes::BUILD_EXECUTOR) and file_has_sha256(Commands::BUILD_MODEL, SourceHashes::BUILD_MODEL) and file_has_sha256(Commands::PROCESS_MODEL, SourceHashes::PROCESS_MODEL) and file_has_sha256(Commands::PROCESS_POSIX, SourceHashes::PROCESS_POSIX) and file_has_sha256(Commands::BOUNDED_READER, SourceHashes::BOUNDED_READER)


        def parity_matches(launcher: sview, golden: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference_path: Path = try path_real(path(Commands::REFERENCE)) else err:
                return false
            candidate_path: Path = try path_real(path(Commands::CANDIDATE)) else err:
                return false
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "posix-shell-sequential-tools-reference",
                target: Commands::SHELL,
                arguments: [f"{reference_path}"],
                working_directory: "/tmp",
                environment: environment,
                environment_mode: ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_RUN_OUTPUT_BYTES
            }
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-sequential-tools-candidate",
                target: launcher,
                arguments: [f"{candidate_path}"],
                working_directory: "/tmp",
                environment: environment,
                environment_mode: ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_RUN_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    print("A07 shell reference process failed")
                    return false
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    print("A07 Elisascript candidate process failed")
                    return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return false if reference_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed or not comparison.equal
            return false if reference_run.exit_status != 0 or reference_run.stdout != golden or reference_run.stderr != ""
            return false if candidate_run.exit_status != 0 or candidate_run.stdout != golden or candidate_run.stderr != ""
            return true


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def public_launcher_parity(launcher: sview, launcher_hash: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            return false if not file_has_sha256(launcher, launcher_hash)
            return false if not source_set_is_pinned()
            golden: sview = try EsBoundedText::read_utf8(path(Commands::EXPECTED), Commands::MAX_GOLDEN_BYTES) else err:
                return false
            return false if not parity_matches(launcher, golden)
            return source_set_is_pinned() and file_has_sha256(launcher, launcher_hash)


@test
def sequential_tools_public_launcher_matches_shell_and_golden() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, Directory.Read, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsSequentialToolsLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsSequentialToolsLauncherParity::pinned_compiler_path()
        assert launcher != "" and launcher.startswith("/")
        assert EsSequentialToolsLauncherParity::public_launcher_parity(launcher, launcher_hash)
