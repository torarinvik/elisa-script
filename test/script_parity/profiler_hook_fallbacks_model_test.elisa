# Shape and independent file-golden checks; Bash/launcher parity is still unrun.
include "../../ports/Elisa-compiler/scripts/profiler_hook_fallbacks_model.elisa"
include "../../src/runtime/bounded_text_posix.elisa"

module EsProfilerHookFallbacksFixture:
    public:
        @test
        def only_first_argument_selects_host_callbacks() -> void:
            can Memory.Allocate, Abort.Panic:
                assert not EsProfilerHookFallbacks::host_callbacks_requested([])
                assert EsProfilerHookFallbacks::host_callbacks_requested(["--host-callbacks"])
                assert not EsProfilerHookFallbacks::host_callbacks_requested(["ignored", "--host-callbacks"])
                assert EsProfilerHookFallbacks::host_callbacks_requested(["--host-callbacks", "ignored"])


        @test
        def default_source_ends_after_profile_event() -> void:
            can Memory.Allocate, Abort.Panic:
                generated: sview = EsProfilerHookFallbacks::source(false)
                assert generated.startswith("#include <stddef.h>\n#include <stdint.h>\n")
                assert generated.endswith("  (void)kind; (void)address; (void)size; (void)old_address; (void)old_size; (void)arena; (void)region;\n}\n")
                assert generated.index("elisa_native_callback_ptr") < 0


        @test
        def host_callbacks_append_to_exact_default_prefix() -> void:
            can Memory.Allocate, Abort.Panic:
                ordinary: sview = EsProfilerHookFallbacks::source(false)
                extended: sview = EsProfilerHookFallbacks::source(true)
                assert extended.startswith(ordinary)
                assert extended.startswith(ordinary + "ELISA_WEAK void *elisa_native_callback_ptr(uint8_t *name)")
                assert extended.endswith("ELISA_WEAK void *va_end(void *argument) { (void)argument; }\n")


        @test
        def generated_bytes_match_independent_file_goldens() -> void:
            can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                base: sview = try EsBoundedText::read_utf8(path("test/fixtures/script_parity/profiler_hook_fallbacks/base.c"), 4096usize) else err:
                    assert false
                    return
                callbacks: sview = try EsBoundedText::read_utf8(path("test/fixtures/script_parity/profiler_hook_fallbacks/host_callbacks.c"), 4096usize) else err:
                    assert false
                    return
                assert EsProfilerHookFallbacks::source(false) == base
                assert EsProfilerHookFallbacks::source(true) == base + callbacks
