# Pure oracle-surface fixtures; this file has no process runner or execution gate.
include "skia_environment_cases.elisa"


@test
def skia_environment_cases_keep_absence_distinct_from_empty() -> void:
    can Memory.Allocate, Abort.Panic:
        cases: darray[EsSkiaEnvironmentCases::Case] = EsSkiaEnvironmentCases::ordinary()
        assert cases.count == 10
        assert cases[0].name == "absent" and cases[0].environment.count == 0
        assert cases[0].stdout == "None\n"
        assert cases[1].name == "empty" and cases[1].environment.count == 1
        assert cases[1].environment[0].value == "" and cases[1].stdout == "\n"
        assert cases[2].environment[0].value == "None" and cases[2].stdout == "None\n"
        assert cases[4].stdout == "a\r\nb\n\n"
        assert cases[5].stdout == "\xc3\xa9 \xe2\x98\x83\n"
        assert cases[9].arguments.count == 3 and cases[9].arguments[1] == ""
        assert cases[9].stdout == "first\n"


@test
def skia_environment_cases_have_unique_names_and_no_inherited_secrets() -> void:
    can Memory.Allocate, Abort.Panic:
        cases: darray[EsSkiaEnvironmentCases::Case] = EsSkiaEnvironmentCases::ordinary()
        for index in 0..<cases.count:
            assert cases[index].arguments.count > 0
            for earlier in 0..<index:
                assert cases[earlier].name != cases[index].name
            for entry in cases[index].environment:
                assert entry.name == "ELISASCRIPT_PARITY_ENV_VALUE" or entry.name == "ELISASCRIPT_PARITY_ENV_OTHER"
