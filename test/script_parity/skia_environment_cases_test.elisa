# Pure oracle-surface fixtures; this file has no process runner or execution gate.
include "skia_environment_cases.elisa"


@test
def skia_environment_cases_keep_absence_distinct_from_empty() -> void:
    can Memory.Allocate, Abort.Panic:
        cases: darray[EsSkiaEnvironmentCases::Case] = EsSkiaEnvironmentCases::ordinary()
        assert cases.count == 14
        assert cases[0].name == "absent" and cases[0].environment.count == 0
        assert cases[0].stdout == "None\n"
        assert cases[1].name == "empty" and cases[1].environment.count == 1
        assert cases[1].environment[0].value == "" and cases[1].stdout == "\n"
        assert cases[2].environment[0].value == "None" and cases[2].stdout == "None\n"
        assert cases[4].stdout == "a\r\nb\n\n"
        assert cases[5].stdout == "\xc3\xa9 \xe2\x98\x83\n"
        assert cases[9].arguments.count == 3 and cases[9].arguments[1] == ""
        assert cases[9].stdout == "first\n"


@test
def skia_environment_cases_have_unique_names_and_no_inherited_secrets() -> void:
    can Memory.Allocate, Abort.Panic:
        cases: darray[EsSkiaEnvironmentCases::Case] = EsSkiaEnvironmentCases::ordinary()
        for index in 0..<cases.count:
            assert cases[index].arguments.count > 0
            for earlier in 0..<index:
                assert cases[earlier].name != cases[index].name
            for entry in cases[index].environment:
                assert entry.name == "ELISASCRIPT_PARITY_ENV_VALUE" or entry.name == "ELISASCRIPT_PARITY_ENV_OTHER" or entry.name == "ELISASCRIPT_PARITY_ENV_\xc3\xa9" or entry.name == "ELISASCRIPT PARITY-$HOME;*" or entry.name == "9ELISASCRIPT_PARITY_ENV"


@test
def skia_environment_cases_keep_non_shell_identifier_keys_literal() -> void:
    can Memory.Allocate, Abort.Panic:
        cases: darray[EsSkiaEnvironmentCases::Case] = EsSkiaEnvironmentCases::ordinary()
        assert cases[10].name == "utf8-key"
        assert cases[10].arguments[0] == "ELISASCRIPT_PARITY_ENV_\xc3\xa9"
        assert cases[10].stdout == "unicode key\n"
        assert cases[11].arguments[0] == "ELISASCRIPT PARITY-$HOME;*"
        assert cases[11].stdout == "literal key\n"
        assert cases[12].arguments[0] == "9ELISASCRIPT_PARITY_ENV"
        assert cases[12].stdout == "not a shell identifier\n"
        for index in 10..<13:
            assert cases[index].arguments.count == 1 and cases[index].environment.count == 1
            assert cases[index].environment[0].name == cases[index].arguments[0]


@test
def skia_environment_long_value_oracle_has_exact_pattern_and_one_added_lf() -> void:
    can Memory.Allocate, Abort.Panic:
        cases: darray[EsSkiaEnvironmentCases::Case] = EsSkiaEnvironmentCases::ordinary()
        selected: EsSkiaEnvironmentCases::Case = cases[13]
        assert selected.name == "long-patterned-value"
        assert selected.environment.count == 1 and selected.arguments.count == 1
        assert selected.environment[0].name == selected.arguments[0]
        value: sview = selected.environment[0].value
        assert len(value) == 32768 and len(selected.stdout) == 32769
        assert value[0] == 65u8 and value[32767] == 72u8
        for index in 0..<32768:
            assert value[index] == (65 + index % 26).u8()
            assert selected.stdout[index] == value[index]
        assert selected.stdout[32768] == 10u8
