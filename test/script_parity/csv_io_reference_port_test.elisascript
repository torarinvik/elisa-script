# Source-level golden for the colocated translation of the Python CSV oracle.
# Run through scripts/run_bounded_test.sh; the process matrix remains separate.
include "../../vendor/elisa-compiler/elisacore_std/elisacore_runtime_prelude.elisa"
include "../../vendor/elisa-compiler/elisacore_std/elisacore_runtime_strings.elisa"
include "../../vendor/elisa-compiler/elisacore_std/runtime.elisa"
include "../fixtures/script_parity/csv_io/reference.elisascript"

@test
def csv_io_reference_port_matches_python_golden() -> void:
    can Memory.Allocate, Abort.Panic:
        actual: EsCsvIoReferencePort::BatchOutput = EsCsvIoReferencePort::batch_output()
        expected: sview = "label,note\nplain,ascii\nquoted,\"comma, quote \"\"and\"\"\"\nmultiline,\"line 1\nline 2\"\nempty,\nunicode,blåbær\nmalformed=error\n"
        assert actual.status == 0i64
        assert bytes_view(actual.bytes) == expected
