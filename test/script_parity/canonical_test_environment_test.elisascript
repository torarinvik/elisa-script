# Pure directory-environment fixtures for the canonical test wrappers.
include "../../ports/neural-computer-agentV2/scripts/canonical_test.elisascript"


@test
def canonical_wrapper_oldpwd_preserves_a_valid_logical_pwd() -> void:
    can Memory.Allocate, Abort.Panic:
        physical: Path = path("/workspace/project")
        assert EsCanonicalTest::oldpwd_after_cd(physical, "/workspace/alias", true) == "/workspace/alias"


@test
def canonical_wrapper_oldpwd_falls_back_when_inherited_pwd_is_invalid() -> void:
    can Memory.Allocate, Abort.Panic:
        physical: Path = path("/workspace/project")
        assert EsCanonicalTest::oldpwd_after_cd(physical, "", false) == "/workspace/project"
        assert EsCanonicalTest::oldpwd_after_cd(physical, "relative/path", false) == "/workspace/project"
        assert EsCanonicalTest::oldpwd_after_cd(physical, "/stale/project", false) == "/workspace/project"
