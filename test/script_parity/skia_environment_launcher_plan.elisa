# Pure authorization/argv model. No candidate implementation or host access.
module EsSkiaEnvironmentLauncherPlan:
    public:
        const module Pins:
            COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            SOURCE: sview = "4e3c6a4f0382cd64c9652bc5896d418395c4aa93ac401d15690d847679f80bb8"
            MODEL: sview = "e98c8629784b647c991c109bda877b429e83e346e58f28ecfd01df336c8b1110"
            BUDGET: sview = "5f175084413ab1e223dc6861386f0e8aa6cac0cc1630a3044ce2221576139396"


        struct Identity:
            path: sview
            hash: sview


        struct Gate:
            reauthorized: bool = false
            rss_guard: bool = false
            launcher_qualified: bool = false
            local_compiler: sview = ""
            core_compiler: sview = ""
            launcher: Identity
            python: Identity
            compiler_hash: sview
            source_hash: sview
            model_hash: sview
            budget_hash: sview


        struct Authorization:
            launcher: Identity
            python: Identity
            compiler_hash: sview


        error GateError:
            Disabled
            WrongCompiler
            InvalidIdentity
            WrongSources


        def valid_hash(value: sview) -> bool:
            return false if len(value) != 64
            for byte in value:
                return false if not ((byte >= 48u8 and byte <= 57u8) or (byte >= 97u8 and byte <= 102u8))
            return true


        def absolute_identity_path(value: sview) -> bool:
            return false if not value.startswith("/") or value == "/" or len(value) >= 4096
            for byte in value:
                return false if byte == 0u8 or byte == 10u8 or byte == 13u8
            return true


        # Shared by the interpreted-launcher and prebuilt-native gates. These
        # role checks are not execution authorization or artifact provenance.
        def validate_roles(candidate: Identity, python: Identity, compiler_hash: sview) -> void error[GateError]:
            raise GateError.InvalidIdentity if not absolute_identity_path(candidate.path) or not absolute_identity_path(python.path)
            raise GateError.InvalidIdentity if not valid_hash(candidate.hash) or not valid_hash(python.hash) or not valid_hash(compiler_hash)
            raise GateError.InvalidIdentity if candidate.path == python.path or candidate.path == Pins::COMPILER or python.path == Pins::COMPILER
            raise GateError.InvalidIdentity if candidate.hash == python.hash or candidate.hash == compiler_hash or python.hash == compiler_hash


        def authorize(gate: Gate) -> Authorization error[GateError]:
            raise GateError.Disabled if not gate.reauthorized or not gate.rss_guard or not gate.launcher_qualified
            raise GateError.WrongCompiler if gate.local_compiler != Pins::COMPILER or gate.core_compiler != Pins::COMPILER
            try validate_roles(gate.launcher, gate.python, gate.compiler_hash)
            raise GateError.WrongSources if gate.source_hash != Pins::SOURCE or gate.model_hash != Pins::MODEL or gate.budget_hash != Pins::BUDGET
            return Authorization{launcher: gate.launcher, python: gate.python, compiler_hash: gate.compiler_hash}


        def candidate_arguments(source: sview, arguments: darray[sview]) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            result: mutable darray[sview] = [source]
            result.extend(arguments)
            return result


        # Reject text wrappers. This is only a container-header check, not proof
        # of a trusted executable, dependency closure or absence of auto-builds.
        def native_container_header(bytes: darray[u8]&) -> bool:
            return false if bytes.count < 4
            elf: bool = bytes[0] == 127u8 and bytes[1] == 69u8 and bytes[2] == 76u8 and bytes[3] == 70u8
            macho_little: bool = bytes[0] == 207u8 and bytes[1] == 250u8 and bytes[2] == 237u8 and bytes[3] == 254u8
            macho_big: bool = bytes[0] == 254u8 and bytes[1] == 237u8 and bytes[2] == 250u8 and bytes[3] == 207u8
            fat_big: bool = bytes[0] == 202u8 and bytes[1] == 254u8 and bytes[2] == 186u8 and (bytes[3] == 190u8 or bytes[3] == 191u8)
            fat_little: bool = (bytes[0] == 190u8 or bytes[0] == 191u8) and bytes[1] == 186u8 and bytes[2] == 254u8 and bytes[3] == 202u8
            return elf or macho_little or macho_big or fat_big or fat_little
