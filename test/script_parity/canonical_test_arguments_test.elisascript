# Pure argv fixtures. Do not launch Python, pytest, or a shell here.
include "../../ports/neural-computer-agentV2/scripts/canonical_test.elisascript"
include "canonical_test_cases.elisa"


module EsCanonicalTestArgumentsFixture:
    public:
        def assert_argv(actual: darray[sview], expected: darray[sview]) -> void:
            assert actual.count == expected.count
            for index in 0..<expected.count:
                assert actual[index] == expected[index]


@test
def canonical_test_default_and_empty_mode_are_fast() -> void:
    can Memory.Allocate, Abort.Panic:
        empty: darray[sview] = try EsCanonicalTest::canonical_arguments([]) else err:
            assert false
            return
        explicit_empty: darray[sview] = try EsCanonicalTest::canonical_arguments(["", "tail"]) else err:
            assert false
            return
        EsCanonicalTestArgumentsFixture::assert_argv(empty, ["-m", "pytest", "-q", "-m", "not campaign"])
        EsCanonicalTestArgumentsFixture::assert_argv(explicit_empty, ["-m", "pytest", "-q", "-m", "not campaign", "tail"])


@test
def canonical_test_modes_preserve_literal_argument_boundaries() -> void:
    can Memory.Allocate, Abort.Panic:
        fast: darray[sview] = try EsCanonicalTest::canonical_arguments(["fast", "", "a b", "*.py", "$HOME", "--", "campaign"]) else err:
            assert false
            return
        campaign: darray[sview] = try EsCanonicalTest::canonical_arguments(["campaign", "-k", "one or two"]) else err:
            assert false
            return
        all_tests: darray[sview] = try EsCanonicalTest::canonical_arguments(["all", "--maxfail=1"]) else err:
            assert false
            return
        EsCanonicalTestArgumentsFixture::assert_argv(fast, ["-m", "pytest", "-q", "-m", "not campaign", "", "a b", "*.py", "$HOME", "--", "campaign"])
        EsCanonicalTestArgumentsFixture::assert_argv(campaign, ["-m", "pytest", "-q", "-m", "campaign", "-k", "one or two"])
        EsCanonicalTestArgumentsFixture::assert_argv(all_tests, ["-m", "pytest", "-q", "--maxfail=1"])


@test
def canonical_test_invalid_mode_is_a_typed_error() -> void:
    can Memory.Allocate, Abort.Panic:
        for mode in ["FAST", "unknown", "--help", "--", " fast "]:
            rejected: mutable bool = false
            catch EsCanonicalTest::canonical_arguments([mode]):
                ok _:
                    assert false
                error failure:
                    rejected <- failure == EsCanonicalTest::UsageError.InvalidMode
            assert rejected


@test
def canonical_test_usage_message_preserves_raw_invocation_spelling() -> void:
    can Memory.Allocate, Abort.Panic:
        assert EsCanonicalTest::usage_message("scripts/test_canonical.sh") == "usage: scripts/test_canonical.sh [fast|campaign|all]\n"
        assert EsCanonicalTest::usage_message("./linked scripts/test_canonical.sh") == "usage: ./linked scripts/test_canonical.sh [fast|campaign|all]\n"


@test
def canonical_test_exec_replacement_maps_shell_paths_and_lines() -> void:
    can Memory.Allocate, Abort.Panic:
        assert EsCanonicalTest::reference_shell_invocation("scripts/test_canonical.elisascript", false) == "scripts/test_canonical.sh"
        assert EsCanonicalTest::reference_shell_invocation("scripts/test_campaign.elisascript", true) == "scripts/test_canonical.sh"
        assert EsCanonicalTest::reference_shell_invocation("test_campaign.elisascript", true) == "./test_canonical.sh"
        assert EsCanonicalTest::process_exec_status(2i64) == 127i64
        assert EsCanonicalTest::process_exec_status(20i64) == 127i64
        assert EsCanonicalTest::process_exec_status(13i64) == 126i64
        assert EsCanonicalTest::process_exec_status(8i64) == 126i64
        assert EsCanonicalTest::shell_exec_line([], false) == 14i64
        assert EsCanonicalTest::shell_exec_line([""], false) == 14i64
        assert EsCanonicalTest::shell_exec_line(["campaign"], false) == 17i64
        assert EsCanonicalTest::shell_exec_line(["all"], false) == 20i64
        assert EsCanonicalTest::shell_exec_line(["all"], true) == 17i64


@test
def canonical_exec_failure_fixture_is_independent_for_both_wrappers() -> void:
    can Memory.Allocate, Abort.Panic:
        cases: darray[EsCanonicalTestCases::ExecFailureCase] = EsCanonicalTestCases::exec_failures()
        assert cases.count == EsCanonicalTestCases::Fixture::EXEC_FAILURES
        assert cases[0].reference == "test_canonical.sh" and cases[0].candidate == "test_canonical.elisascript"
        assert not cases[0].campaign_only and cases[0].line == 14i64 and cases[0].status == 127i64
        assert cases[1].reference == "test_campaign.sh" and cases[1].candidate == "test_campaign.elisascript"
        assert cases[1].campaign_only and cases[1].line == 17i64 and cases[1].status == 127i64


@test
def canonical_invalid_mode_launcher_vectors_pin_raw_usage_and_missing_python() -> void:
    can Memory.Allocate, Abort.Panic:
        cases: darray[EsCanonicalTestCases::UsageCase] = EsCanonicalTestCases::invalid_mode_usage()
        assert cases.count == EsCanonicalTestCases::Fixture::USAGE_CASES
        for selected in cases:
            assert selected.invalid_mode == EsCanonicalTestCases::Fixture::INVALID_MODE
            assert selected.python_bin == EsCanonicalTestCases::Fixture::MISSING_PYTHON
            assert selected.status == 2
            assert selected.expected_reference_stderr == EsCanonicalTest::usage_message(selected.reference_invocation)
            assert selected.expected_candidate_stderr == EsCanonicalTest::usage_message(selected.candidate_invocation)


@test
def canonical_campaign_wrapper_does_not_consume_a_caller_mode() -> void:
    can Memory.Allocate, Abort.Panic:
        argv: darray[sview] = EsCanonicalTest::campaign_arguments(["all", "", "a b", "-m", "custom"])
        EsCanonicalTestArgumentsFixture::assert_argv(argv, ["-m", "pytest", "-q", "-m", "campaign", "all", "", "a b", "-m", "custom"])
        EsCanonicalTestArgumentsFixture::assert_argv(EsCanonicalTest::campaign_arguments([]), ["-m", "pytest", "-q", "-m", "campaign"])


@test
def canonical_argument_builders_match_independent_family_cases() -> void:
    can Memory.Allocate, Abort.Panic:
        cases: darray[EsCanonicalLintCases::Case] = EsCanonicalTestCases::ordinary()
        assert cases.count == EsCanonicalTestCases::Fixture::CASES
        for selected in cases:
            actual: mutable darray[sview] = []
            if selected.reference == "test_canonical.sh":
                actual <- try EsCanonicalTest::canonical_arguments(selected.arguments) else err:
                    assert false
                    return
            else:
                assert selected.reference == "test_campaign.sh"
                actual <- EsCanonicalTest::campaign_arguments(selected.arguments)
            EsCanonicalTestArgumentsFixture::assert_argv(actual, selected.expected_argv)
