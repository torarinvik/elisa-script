# Gated public-launcher comparison for the JSON model source-audit port.
# Run only through the bounded validation wrapper after explicit authorization.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsJsonModelLauncherParity:
    private:
        const module Commands:
            REFERENCE_SHELL: sview = "/bin/bash"
            REFERENCE_SCRIPT: sview = "scripts/check_json_model.sh"
            CANDIDATE_SCRIPT: sview = "scripts/check_json_model.elisascript"
            EMPTY_ROOT_MARKER: sview = "test/fixtures/script_parity/json_model_empty_root/README.md"
            BOUNDED_READER: sview = "src/runtime/bounded_text_posix.elisa"
            ENCODING_SOURCE: sview = "src/runtime/encoding.elisa"
            FILE_SOURCE: sview = "src/runtime/file_posix.elisa"
            DIRECTORY_SOURCE: sview = "src/runtime/directory_posix.elisa"
            STDIO_SOURCE: sview = "src/runtime/stdio_posix.elisa"
            SHELL_TOOL: sview = "/bin/bash"
            WC_TOOL: sview = "/usr/bin/wc"
            DIRNAME_TOOL: sview = "/usr/bin/dirname"
            RG_TOOL: sview = "/opt/homebrew/bin/rg"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            CONTROLLED_PATH: sview = "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            REFERENCE_SHA256: sview = "b4b0f51d912f69d127350eddc0115b25ba83f75d055f2c0e6ece120445903ef1"
            CANDIDATE_SHA256: sview = "2b29af739d1bfea637a1899feef9d14769bf12fb70b141a0d24333681e3aa7c9"
            EMPTY_ROOT_MARKER_SHA256: sview = "a4e5112c7efd90099b753e0ad824687847874bb079a1fcbe68ea841054c3a60e"
            BOUNDED_READER_SHA256: sview = "f648d319aca3610e245452d681c21556cc58a774982ea8d0bbda2cca4f1823be"
            ENCODING_SOURCE_SHA256: sview = "67815c728730d891c2e5fc0cc53a33d672d0f40003cfd468de903c4fbfcd9a53"
            FILE_SOURCE_SHA256: sview = "14e1e3a9f0d95ee3e45509bd7d76c1ba2694992d5530f82edf8533d9cf149643"
            DIRECTORY_SOURCE_SHA256: sview = "065d21370e93a1487a5ccc0adcfff5dcc04aa78e98361de181eeb08dbc0d402d"
            STDIO_SOURCE_SHA256: sview = "c02cac5eec931a2f2aa9131616482df4e17333948961c4b6d0d215b0ab0e766c"
            SHELL_TOOL_SHA256: sview = "d59c6f2312e551e9c46497329d435b6ec74fbc46e9155b84170f377127ed004e"
            WC_TOOL_SHA256: sview = "adcd3578fe789c4411723dd601adef2a83d2d475c58f3a8f4820a3f17be4cb8d"
            DIRNAME_TOOL_SHA256: sview = "e40020bf0d44992e1441ef735e5ae7a82662732435ebd13b10692b5c6257e1fa"
            RG_TOOL_SHA256: sview = "1c57905960cd69dbb5b05492560957f4a57cdd4d39137e20de23981c6e1f4423"
            SHA256_TOOL_SHA256: sview = "0812595f981a26f813d98dc380af14d4af427626c9339eda29eb849ae13de1e3"
            MAX_HASHED_FILE_BYTES: usize = 67108864
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_OUTPUT_BYTES: u64 = 1048576
            TIMEOUT_STEPS: u64 = 10000


        def lowercase_sha256_hex_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def file_has_sha256(path_text: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            source_path: Path = path(path_text)
            return false if not is_file(source_path)
            source_size: usize = try file_size(source_path) else err:
                return false
            return false if source_size == 0 or source_size > Commands::MAX_HASHED_FILE_BYTES
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "json-audit-source-sha256",
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", path_text],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false
            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            return false if hash_run.stdout != expected_hex + "  " + path_text + "\n"
            for index in 0..<64 |hash_run, expected_hex|:
                return false if not lowercase_sha256_hex_byte(sview_at(expected_hex, index))
            return true


        def source_set_is_pinned() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if not file_has_sha256(Commands::SHA256_TOOL, Commands::SHA256_TOOL_SHA256)
            return false if not file_has_sha256(Commands::REFERENCE_SCRIPT, Commands::REFERENCE_SHA256)
            return false if not file_has_sha256(Commands::CANDIDATE_SCRIPT, Commands::CANDIDATE_SHA256)
            return false if not file_has_sha256(Commands::EMPTY_ROOT_MARKER, Commands::EMPTY_ROOT_MARKER_SHA256)
            return false if not file_has_sha256(Commands::BOUNDED_READER, Commands::BOUNDED_READER_SHA256)
            return false if not file_has_sha256(Commands::ENCODING_SOURCE, Commands::ENCODING_SOURCE_SHA256)
            return false if not file_has_sha256(Commands::FILE_SOURCE, Commands::FILE_SOURCE_SHA256)
            return false if not file_has_sha256(Commands::DIRECTORY_SOURCE, Commands::DIRECTORY_SOURCE_SHA256)
            return false if not file_has_sha256(Commands::STDIO_SOURCE, Commands::STDIO_SOURCE_SHA256)
            return false if not file_has_sha256(Commands::SHELL_TOOL, Commands::SHELL_TOOL_SHA256)
            return false if not file_has_sha256(Commands::WC_TOOL, Commands::WC_TOOL_SHA256)
            return false if not file_has_sha256(Commands::DIRNAME_TOOL, Commands::DIRNAME_TOOL_SHA256)
            return file_has_sha256(Commands::RG_TOOL, Commands::RG_TOOL_SHA256)


        def clean_repository_run_matches(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference_path: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate_path: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "shell-json-model-audit-reference",
                target: Commands::REFERENCE_SHELL,
                arguments: [f"{reference_path}"],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-json-model-audit",
                target: launcher,
                arguments: [f"{candidate_path}"],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    print("JSON model shell reference process failed")
                    return false
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    print("JSON model Elisascript process failed")
                    return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return false if reference_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed or not comparison.equal
            return false if reference_run.exit_status != 0 or reference_run.stdout != "json model audit: namespaced owned scalar/key arenas, lifecycle contracts, and Python value parity fixture are present\n" or reference_run.stderr != ""
            return false if candidate_run.exit_status != reference_run.exit_status or candidate_run.stdout != reference_run.stdout or candidate_run.stderr != reference_run.stderr
            return true


        def missing_first_source_run_matches(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference_path: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate_path: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            fixture_root: Path = try path_real(path(Commands::EMPTY_ROOT_MARKER).parent()) else err:
                return false
            fixture_root_text: sview = f"{fixture_root}"
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "shell-json-model-audit-missing-source-reference",
                target: Commands::REFERENCE_SHELL,
                arguments: [f"{reference_path}", fixture_root_text],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-json-model-audit-missing-source",
                target: launcher,
                arguments: [f"{candidate_path}", fixture_root_text],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    print("JSON model missing-source shell reference process failed")
                    return false
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    print("JSON model missing-source Elisascript process failed")
                    return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            expected_error: sview = "json model audit: missing " + fixture_root_text + "/src/runtime/json_model.elisa\n"
            return false if reference_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed or not comparison.equal
            return false if reference_run.exit_status != 1 or reference_run.stdout != "" or reference_run.stderr != expected_error
            return false if candidate_run.exit_status != reference_run.exit_status or candidate_run.stdout != reference_run.stdout or candidate_run.stderr != reference_run.stderr
            return true


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def public_launcher_parity(launcher: sview, launcher_hash: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            return false if not file_has_sha256(launcher, launcher_hash)
            return false if not source_set_is_pinned()
            return false if not clean_repository_run_matches(launcher)
            return false if not missing_first_source_run_matches(launcher)
            return source_set_is_pinned() and file_has_sha256(launcher, launcher_hash)


@test
def json_model_public_launcher_matches_pinned_shell_reference() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, Directory.Read, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsJsonModelLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsJsonModelLauncherParity::pinned_compiler_path()
        assert launcher != "" and launcher.startswith("/")
        assert EsJsonModelLauncherParity::public_launcher_parity(launcher, launcher_hash)
