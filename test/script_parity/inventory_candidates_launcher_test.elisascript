# Process parity for the native A04 inventory port. This test creates and
# removes only its own temporary fixture tree; it never executes discovered
# candidates. Run only through the bounded wrapper after explicit reauthorization.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsInventoryCandidatesLauncherParity:
    private:
        const module Commands:
            REFERENCE_SHELL: sview = "/bin/bash"
            REFERENCE_SCRIPT: sview = "scripts/inventory_candidates.sh"
            CANDIDATE_SCRIPT: sview = "scripts/inventory_candidates.elisascript"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            CONTROLLED_PATH: sview = "/usr/bin:/bin:/usr/sbin:/sbin"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            MAX_LAUNCHER_BYTES: usize = 67108864
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_OUTPUT_BYTES: u64 = 1048576
            TIMEOUT_STEPS: u64 = 10000


        const module Output:
            HEADER: sview = "path\tkind\towner\tentrypoint\tdisposition\trisk\tnotes"
            NOTES: sview = "read-only candidate; classify before porting or deletion"


        struct TemporaryDirectory:
            path: Path
            created: bool = false


        struct FixtureFile:
            relative_path: sview
            contents: sview


        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def make_temporary_directory(prefix: sview) -> TemporaryDirectory can[Memory.Allocate, Abort.Panic, File.Write]:
            created_path: Path = try temp_directory(prefix) else err:
                return TemporaryDirectory{path: path("."), created: false}
            return TemporaryDirectory{path: created_path, created: true}


        def create_fixture_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try create_directory(target) else false


        def write_fixture_text(target: Path, contents: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            written: usize = try write_text(target, contents) else 0u64
            return written == len(contents)


        def create_fixture_symlink(target: Path, link: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            return try symlink(target, link) else false


        def remove_fixture_path(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            return try remove_path(target) else false


        def remove_fixture_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try remove_directory(target) else false


        def lowercase_sha256_hex_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def launcher_has_expected_sha256(launcher: sview, expected_hex: sview) -> bool can[Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            launcher_path: Path = path(launcher)
            return false if not is_file(launcher_path)
            launcher_size: usize = try file_size(launcher_path) else err:
                return false
            return false if launcher_size == 0 or launcher_size > Commands::MAX_LAUNCHER_BYTES
            hash_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-inventory-candidates-sha256",
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", launcher],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(hash_runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false

            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            return false if hash_run.stdout != expected_hex + "  " + launcher + "\n"
            for index in 0..<64 |hash_run, expected_hex|:
                return false if not lowercase_sha256_hex_byte(sview_at(expected_hex, index))
            return true


        def inventory_process_pair_matches(launcher: sview, logical_arguments: darray[sview], expected_status: i64, expected_stdout: sview, expected_stderr: sview, working_directory: sview = "", reference_script_override: sview = "", candidate_script_override: sview = "", environment_pwd: sview = "") -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference_script_argument: mutable sview = reference_script_override
            candidate_script_argument: mutable sview = candidate_script_override
            if reference_script_argument == "":
                reference_script_path: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                    return false
                reference_script_argument <- f"{reference_script_path}"
            if candidate_script_argument == "":
                candidate_script_path: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                    return false
                candidate_script_argument <- f"{candidate_script_path}"
            reference_script_is_absolute: bool = reference_script_argument.startswith("/")
            candidate_script_is_absolute: bool = candidate_script_argument.startswith("/")
            return false if reference_script_is_absolute != candidate_script_is_absolute
            return false if not reference_script_is_absolute and working_directory == ""

            reference_arguments: mutable darray[sview] = [reference_script_argument]
            candidate_arguments: mutable darray[sview] = [candidate_script_argument]
            for argument in logical_arguments |reference_arguments, candidate_arguments|:
                reference_arguments.push(argument)
                candidate_arguments.push(argument)

            controlled_environment: mutable darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            if working_directory != "":
                child_pwd: sview = working_directory
                child_pwd <- environment_pwd if environment_pwd != ""
                controlled_environment.push(DifferentialEnvironmentEntry{name: "PWD", value: child_pwd})
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "shell-inventory-candidates-reference",
                target: Commands::REFERENCE_SHELL,
                arguments: reference_arguments,
                working_directory: working_directory,
                environment: controlled_environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    eprint("inventory candidate reference process failed")
                    return false

            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-inventory-candidates",
                target: launcher,
                arguments: candidate_arguments,
                working_directory: working_directory,
                environment: controlled_environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    eprint("inventory candidate Elisascript process failed")
                    return false

            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            if reference_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed or not comparison.equal:
                eprint("inventory candidate process parity mismatch")
                return false
            if reference_run.exit_status != expected_status or reference_run.stdout != expected_stdout or reference_run.stderr != expected_stderr:
                eprint("inventory candidate reference golden mismatch")
                return false
            if candidate_run.exit_status != expected_status or candidate_run.stdout != expected_stdout or candidate_run.stderr != expected_stderr:
                eprint("Elisascript inventory candidate golden mismatch")
                return false
            return true


        def expected_positive_manifest(root: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            rows: mutable darray[sview] = [
                f"{root}/.hidden.sh\tshell\tunassigned\tunknown\tclassify\tunknown\t{Output::NOTES}",
                f"{root}/Makefile\tmakefile\tunassigned\tunknown\tclassify\tunknown\t{Output::NOTES}",
                f"{root}/build/Buildfile.bash\tshell\tunassigned\tunknown\tclassify-generated\tbuild\t{Output::NOTES}",
                f"{root}/danger.sh\tshell\tunassigned\tunknown\tclassify\tunknown\t{Output::NOTES}",
                f"{root}/deploy/publish.py\tpython\tunassigned\tunknown\tclassify\trelease\t{Output::NOTES}",
                f"{root}/dist/generated.py\tpython\tunassigned\tunknown\tclassify-generated\tunknown\t{Output::NOTES}",
                f"{root}/fixture-assets/check.fish\tshell\tunassigned\tunknown\tclassify\ttest\t{Output::NOTES}",
                f"{root}/ignored.py\tpython\tunassigned\tunknown\tclassify\tunknown\t{Output::NOTES}",
                f"{root}/install/post.sh\tshell\tunassigned\tunknown\tclassify\trelease\t{Output::NOTES}",
                f"{root}/link-target.py\tpython\tunassigned\tunknown\tclassify\tunknown\t{Output::NOTES}",
                f"{root}/nested/makefile\tmakefile\tunassigned\tunknown\tclassify\tunknown\t{Output::NOTES}",
                f"{root}/real/linked.py\tpython\tunassigned\tunknown\tclassify\tunknown\t{Output::NOTES}",
                f"{root}/release/prep.pl\tperl\tunassigned\tunknown\tclassify\trelease\t{Output::NOTES}",
                f"{root}/space dir/tool.zsh\tshell\tunassigned\tunknown\tclassify\tunknown\t{Output::NOTES}",
                f"{root}/test/case.awk\tawk\tunassigned\tunknown\tclassify\ttest\t{Output::NOTES}",
                f"{root}/unicode/café.pm\tperl\tunassigned\tunknown\tclassify\tunknown\t{Output::NOTES}"
            ]
            rows <- sorted(rows)
            return Output::HEADER + "\n" + join(rows, "\n") + "\n"


        def run_inventory_candidate_cases(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary: TemporaryDirectory = make_temporary_directory("elisascript-inventory-candidates")
            return false if not temporary.created
            outside_temporary: TemporaryDirectory = make_temporary_directory("elisascript-inventory-candidates-outside")
            if not outside_temporary.created:
                _ = remove_fixture_directory(temporary.path)
                return false
            root_path: Path = temporary.path
            root: sview = f"{root_path}"
            root_resolved: Path = try path_real(root_path) else err:
                root_path
            outside_root_resolved: Path = try path_real(outside_temporary.path) else err:
                outside_temporary.path

            directories_to_remove: mutable darray[Path] = []
            files_to_remove: mutable darray[Path] = []
            setup_ok: mutable bool = true
            subdirectory_names: darray[sview] = [".git", ".venv", "__pycache__", "build", "deploy", "dist", "fixture-assets", "install", "nested", "node_modules", "real", "release", "space dir", "test", "third_party", "unicode"]
            for name in subdirectory_names |root_path, directories_to_remove, setup_ok|:
                directory: Path = root_path.joinpath(name)
                if create_fixture_directory(directory):
                    directories_to_remove.push(directory)
                else:
                    setup_ok <- false

            vendor_directory: Path = root_path.joinpath("vendor")
            default_root_scripts: Path = vendor_directory.joinpath("scripts")
            physical_scripts_root: Path = vendor_directory.joinpath("physical")
            physical_scripts_deep: Path = physical_scripts_root.joinpath("deep")
            physical_scripts: Path = physical_scripts_root.joinpath("scripts")
            vendor_created: bool = create_fixture_directory(vendor_directory)
            setup_ok <- false if not vendor_created
            if vendor_created:
                if create_fixture_directory(default_root_scripts):
                    directories_to_remove.push(default_root_scripts)
                else:
                    setup_ok <- false
                if create_fixture_directory(physical_scripts_root):
                    if create_fixture_directory(physical_scripts_deep):
                        directories_to_remove.push(physical_scripts_deep)
                    else:
                        setup_ok <- false
                    if create_fixture_directory(physical_scripts):
                        directories_to_remove.push(physical_scripts)
                    else:
                        setup_ok <- false
                    directories_to_remove.push(physical_scripts_root)
                else:
                    setup_ok <- false
                directories_to_remove.push(vendor_directory)

            reference_script_target: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                setup_ok <- false
                root_path
            candidate_script_target: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                setup_ok <- false
                root_path
            walker_source_target: Path = try path_real(path("scripts/inventory_walk.elisascript")) else err:
                setup_ok <- false
                root_path
            physical_reference_script: Path = physical_scripts.joinpath("inventory_candidates.sh")
            physical_candidate_script: Path = physical_scripts.joinpath("inventory_candidates.elisascript")
            logical_reference_script: Path = default_root_scripts.joinpath("inventory_candidates.sh")
            logical_candidate_script: Path = default_root_scripts.joinpath("inventory_candidates.elisascript")
            physical_reference_script_alias_target: Path = root_resolved.joinpath("vendor/physical/scripts/inventory_candidates.sh")
            physical_candidate_script_alias_target: Path = root_resolved.joinpath("vendor/physical/scripts/inventory_candidates.elisascript")
            physical_walker_script_alias_target: Path = root_resolved.joinpath("vendor/physical/scripts/inventory_walk.elisascript")
            logical_walker_script: Path = default_root_scripts.joinpath("inventory_walk.elisascript")
            physical_scripts_deep_alias_target: Path = root_resolved.joinpath("vendor/physical/deep")
            alias_directory: Path = vendor_directory.joinpath("alias")
            scan_root_alias: Path = vendor_directory.joinpath("scan-root-alias")
            files_to_remove.push(physical_reference_script)
            files_to_remove.push(physical_candidate_script)
            files_to_remove.push(logical_reference_script)
            files_to_remove.push(logical_candidate_script)
            files_to_remove.push(physical_walker_script_alias_target)
            files_to_remove.push(logical_walker_script)
            files_to_remove.push(alias_directory)
            files_to_remove.push(scan_root_alias)
            if not reference_script_target.is_absolute() or not create_fixture_symlink(reference_script_target, physical_reference_script):
                setup_ok <- false
            if not candidate_script_target.is_absolute() or not create_fixture_symlink(candidate_script_target, physical_candidate_script):
                setup_ok <- false
            if not walker_source_target.is_absolute() or not create_fixture_symlink(walker_source_target, physical_walker_script_alias_target):
                setup_ok <- false
            if not create_fixture_symlink(walker_source_target, logical_walker_script):
                setup_ok <- false
            if not create_fixture_symlink(physical_reference_script_alias_target, logical_reference_script):
                setup_ok <- false
            if not create_fixture_symlink(physical_candidate_script_alias_target, logical_candidate_script):
                setup_ok <- false
            if not create_fixture_symlink(physical_scripts_deep_alias_target, alias_directory):
                setup_ok <- false
            if not create_fixture_symlink(root_path.joinpath("fixture-assets"), scan_root_alias):
                setup_ok <- false

            marker_path: sview = root + "/executed.marker"
            files: darray[FixtureFile] = [
                FixtureFile{relative_path: ".gitignore", contents: "ignored.py\ndist/\n"},
                FixtureFile{relative_path: ".hidden.sh", contents: "data only\n"},
                FixtureFile{relative_path: "Makefile", contents: "data only\n"},
                FixtureFile{relative_path: "build/Buildfile.bash", contents: "data only\n"},
                FixtureFile{relative_path: "danger.sh", contents: "#!/bin/sh\n: > \"" + marker_path + "\"\n"},
                FixtureFile{relative_path: "deploy/publish.py", contents: "data only\n"},
                FixtureFile{relative_path: "dist/generated.py", contents: "data only\n"},
                FixtureFile{relative_path: "fixture-assets/check.fish", contents: "data only\n"},
                FixtureFile{relative_path: "ignored.py", contents: "data only\n"},
                FixtureFile{relative_path: "install/post.sh", contents: "data only\n"},
                FixtureFile{relative_path: "link-target.py", contents: "data only\n"},
                FixtureFile{relative_path: "nested/makefile", contents: "data only\n"},
                FixtureFile{relative_path: "real/linked.py", contents: "data only\n"},
                FixtureFile{relative_path: "release/prep.pl", contents: "data only\n"},
                FixtureFile{relative_path: "space dir/tool.zsh", contents: "data only\n"},
                FixtureFile{relative_path: "test/case.awk", contents: "data only\n"},
                FixtureFile{relative_path: "unicode/café.pm", contents: "data only\n"},
                FixtureFile{relative_path: "vendor/external.py", contents: "data only\n"},
                FixtureFile{relative_path: ".git/internal.sh", contents: "data only\n"},
                FixtureFile{relative_path: ".venv/site.py", contents: "data only\n"},
                FixtureFile{relative_path: "__pycache__/cached.py", contents: "data only\n"},
                FixtureFile{relative_path: "node_modules/pkg.js", contents: "data only\n"},
                FixtureFile{relative_path: "third_party/external.pl", contents: "data only\n"},
                FixtureFile{relative_path: "readme.txt", contents: "not a script candidate\n"}
            ]
            for fixture in files |root_path, files_to_remove, setup_ok|:
                target: Path = root_path.joinpath(fixture.relative_path)
                files_to_remove.push(target)
                if not write_fixture_text(target, fixture.contents):
                    setup_ok <- false

            alias_path: Path = root_path.joinpath("alias.py")
            link_target: Path = root_path.joinpath("link-target.py")
            files_to_remove.push(alias_path)
            if not create_fixture_symlink(link_target, alias_path):
                setup_ok <- false
            directory_alias: Path = root_path.joinpath("linked-directory")
            real_directory: Path = root_path.joinpath("real")
            files_to_remove.push(directory_alias)
            if not create_fixture_symlink(real_directory, directory_alias):
                setup_ok <- false
            external_candidate: Path = outside_temporary.path.joinpath("outside.py")
            if not write_fixture_text(external_candidate, "outside-root candidate data only\n"):
                setup_ok <- false
            external_directory_alias: Path = root_path.joinpath("outside-link")
            files_to_remove.push(external_directory_alias)
            if not create_fixture_symlink(outside_root_resolved, external_directory_alias):
                setup_ok <- false

            setup_ok <- false if not root_resolved.is_absolute()
            setup_ok <- false if not outside_root_resolved.is_absolute()
            if setup_ok:
                resolved_root: sview = f"{root_resolved}"
                positive_arguments: darray[sview] = [resolved_root]
                positive_stdout: sview = expected_positive_manifest(resolved_root)
                setup_ok <- inventory_process_pair_matches(launcher, positive_arguments, 0i64, positive_stdout, "")
                setup_ok <- setup_ok and not is_file(path(marker_path))

                # Explicit roots follow Bash's logical `cd -L` handling of
                # symlink/.. before the final physical canonicalization.
                logical_root_arguments: darray[sview] = [resolved_root + "/vendor/scan-root-alias/.."]
                setup_ok <- setup_ok and inventory_process_pair_matches(launcher, logical_root_arguments, 0i64, Output::HEADER + "\n", "")

                # No root argument: both programs must derive root from the
                # alias's logical vendor/scripts location, independently of
                # process cwd and physical symlink traversal.
                default_root_arguments: darray[sview] = []
                reference_script_alias_argument: sview = resolved_root + "/vendor/alias/../scripts/inventory_candidates.sh"
                candidate_script_alias_argument: sview = resolved_root + "/vendor/alias/../scripts/inventory_candidates.elisascript"
                setup_ok <- setup_ok and inventory_process_pair_matches(launcher, default_root_arguments, 0i64, positive_stdout, "", f"{outside_root_resolved}", reference_script_alias_argument, candidate_script_alias_argument)
                setup_ok <- setup_ok and not is_file(path(marker_path))

                # Relative launch from the physical cwd with its valid logical
                # PWD symlink must retain Bash-style logical dirname semantics.
                relative_default_root_arguments: darray[sview] = []
                relative_reference_script: sview = "../scripts/inventory_candidates.sh"
                relative_candidate_script: sview = "../scripts/inventory_candidates.elisascript"
                physical_start_directory: sview = resolved_root + "/vendor/physical/deep"
                logical_start_directory: sview = resolved_root + "/vendor/alias"
                setup_ok <- setup_ok and inventory_process_pair_matches(launcher, relative_default_root_arguments, 0i64, positive_stdout, "", physical_start_directory, relative_reference_script, relative_candidate_script, logical_start_directory)
                setup_ok <- setup_ok and not is_file(path(marker_path))

                # Relative explicit roots also honor a valid logical PWD;
                # from this symlink spelling, ../.. selects the fixture root.
                relative_logical_root_arguments: darray[sview] = ["../.."]
                setup_ok <- setup_ok and inventory_process_pair_matches(launcher, relative_logical_root_arguments, 0i64, positive_stdout, "", physical_start_directory, "", "", logical_start_directory)

                # A stale PWD is ignored for explicit relative roots too;
                # physical ../.. selects the excluded vendor directory.
                invalid_pwd_expected_stdout: sview = Output::HEADER + "\n"
                mismatched_pwd_directory: sview = f"{outside_root_resolved}"
                stale_pwd_root_arguments: darray[sview] = ["../.."]
                setup_ok <- setup_ok and inventory_process_pair_matches(launcher, stale_pwd_root_arguments, 0i64, invalid_pwd_expected_stdout, "", physical_start_directory, "", "", mismatched_pwd_directory)

                # A mismatched inherited PWD must not override the actual
                # physical cwd when both programs resolve the relative launch.
                invalid_pwd_default_root_arguments: darray[sview] = []
                setup_ok <- setup_ok and inventory_process_pair_matches(launcher, invalid_pwd_default_root_arguments, 0i64, invalid_pwd_expected_stdout, "", physical_start_directory, relative_reference_script, relative_candidate_script, mismatched_pwd_directory)
                setup_ok <- setup_ok and not is_file(path(marker_path))

                missing_root: sview = resolved_root + "/does-not-exist"
                missing_arguments: darray[sview] = [missing_root]
                missing_stderr: sview = "inventory_candidates: scan root does not exist: " + missing_root + "\n"
                setup_ok <- setup_ok and inventory_process_pair_matches(launcher, missing_arguments, 2i64, "", missing_stderr)

                bad_arity_arguments: darray[sview] = [resolved_root, "unexpected"]
                setup_ok <- setup_ok and inventory_process_pair_matches(launcher, bad_arity_arguments, 2i64, "", "usage: inventory_candidates.sh [CODING_PROJECTS_ROOT]\n")

                unsafe_root: sview = resolved_root + "/missing\troot"
                unsafe_root_arguments: darray[sview] = [unsafe_root]
                unsafe_root_stderr: sview = "inventory_candidates: unsupported scan root contains a TSV delimiter or line break\n"
                setup_ok <- setup_ok and inventory_process_pair_matches(launcher, unsafe_root_arguments, 2i64, "", unsafe_root_stderr)

                unsafe_path: Path = root_path.joinpath("bad\tname.py")
                files_to_remove.push(unsafe_path)
                if write_fixture_text(unsafe_path, "data only\n"):
                    unsafe_arguments: darray[sview] = [resolved_root]
                    unsafe_stderr: sview = "inventory_candidates: unsupported path contains a TSV delimiter or line break\n"
                    setup_ok <- setup_ok and inventory_process_pair_matches(launcher, unsafe_arguments, 3i64, "", unsafe_stderr)
                    setup_ok <- remove_fixture_path(unsafe_path) and setup_ok
                else:
                    setup_ok <- false

                newline_path: Path = root_path.joinpath("bad\nname.py")
                files_to_remove.push(newline_path)
                if write_fixture_text(newline_path, "data only\n"):
                    unsafe_arguments: darray[sview] = [resolved_root]
                    unsafe_stderr: sview = "inventory_candidates: unsupported path contains a TSV delimiter or line break\n"
                    setup_ok <- setup_ok and inventory_process_pair_matches(launcher, unsafe_arguments, 3i64, "", unsafe_stderr)
                    setup_ok <- remove_fixture_path(newline_path) and setup_ok
                else:
                    setup_ok <- false

                carriage_path: Path = root_path.joinpath("bad\rname.py")
                files_to_remove.push(carriage_path)
                if write_fixture_text(carriage_path, "data only\n"):
                    unsafe_arguments: darray[sview] = [resolved_root]
                    unsafe_stderr: sview = "inventory_candidates: unsupported path contains a TSV delimiter or line break\n"
                    setup_ok <- setup_ok and inventory_process_pair_matches(launcher, unsafe_arguments, 3i64, "", unsafe_stderr)
                    setup_ok <- remove_fixture_path(carriage_path) and setup_ok
                else:
                    setup_ok <- false

                deep_directories: mutable darray[Path] = []
                deep_directory_path: mutable Path = root_path.joinpath("deep")
                deep_setup_ok: mutable bool = true
                for _ in 0..<64 |deep_directory_path, deep_directories, deep_setup_ok|:
                    if create_fixture_directory(deep_directory_path):
                        deep_directories.push(deep_directory_path)
                    else:
                        deep_setup_ok <- false
                    deep_directory_path <- deep_directory_path.joinpath("child")
                if deep_setup_ok:
                    deep_arguments: darray[sview] = [resolved_root]
                    depth_allowed_stdout: sview = expected_positive_manifest(resolved_root)
                    setup_ok <- inventory_process_pair_matches(launcher, deep_arguments, 0i64, depth_allowed_stdout, "") and setup_ok
                    if create_fixture_directory(deep_directory_path):
                        deep_directories.push(deep_directory_path)
                    else:
                        deep_setup_ok <- false
                    depth_stderr: sview = "inventory_candidates: directory depth exceeds limit (64) for " + resolved_root + "\n"
                    if deep_setup_ok:
                        setup_ok <- inventory_process_pair_matches(launcher, deep_arguments, 3i64, "", depth_stderr) and setup_ok
                if not deep_setup_ok:
                    setup_ok <- false
                deep_cleanup_ok: mutable bool = true
                deep_index: mutable usize = deep_directories.count
                while deep_index > 0 |deep_directories, deep_cleanup_ok, deep_index|:
                    deep_index <- deep_index - 1
                    deep_cleanup_ok <- remove_fixture_directory(deep_directories[deep_index]) and deep_cleanup_ok
                setup_ok <- setup_ok and deep_cleanup_ok

            cleanup_ok: mutable bool = true
            if is_file(path(marker_path)):
                cleanup_ok <- remove_fixture_path(path(marker_path)) and cleanup_ok
            for file_path in files_to_remove |cleanup_ok|:
                if is_file(file_path) or is_symlink(file_path):
                    cleanup_ok <- remove_fixture_path(file_path) and cleanup_ok
            for directory_path in directories_to_remove |cleanup_ok|:
                cleanup_ok <- remove_fixture_directory(directory_path) and cleanup_ok
            root_removed: bool = remove_fixture_directory(root_path)
            if is_file(external_candidate):
                cleanup_ok <- remove_fixture_path(external_candidate) and cleanup_ok
            outside_root_removed: bool = remove_fixture_directory(outside_temporary.path)
            return setup_ok and cleanup_ok and root_removed and outside_root_removed


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


@test
def inventory_candidates_public_launcher_matches_shell_and_contract() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsInventoryCandidatesLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsInventoryCandidatesLauncherParity::pinned_compiler_path()
        assert launcher != ""
        assert launcher.startswith("/")
        assert EsInventoryCandidatesLauncherParity::launcher_has_expected_sha256(launcher, launcher_hash)
        println("public_launcher_path=" + launcher)
        println("public_launcher_sha256=" + launcher_hash)
        assert EsInventoryCandidatesLauncherParity::run_inventory_candidate_cases(launcher)
        assert EsInventoryCandidatesLauncherParity::launcher_has_expected_sha256(launcher, launcher_hash)
