# Dormant, explicitly gated parity matrix for the Elisa Engine checker.
# Run only through run_bounded_test.sh after user reauthorization; never launch
# it against the live Engine tree.
include "../../src/testing/differential.elisa"
include "../../src/runtime/bounded_text_posix.elisa"
include "../../src/testing/checksum_record_model.elisa"
include "skia_environment_launcher_plan.elisa"

using EsDifferential


module EsEngineSourceLengthLauncherParity:
    private:
        const module Tools:
            PYTHON: sview = "/usr/bin/python3"
            PYTHON_SHA256: sview = "34129c71a01a74f7f3b2443521519b2e5447553fa187f5fcafaaf8c42cc192e2"
            SHA256: sview = "/usr/bin/shasum"
            COMPILER: sview = EsSkiaEnvironmentLauncherPlan::Pins::COMPILER
            PATH_VALUE: sview = "/usr/bin:/bin:/usr/sbin:/sbin"
            REFERENCE_SHA256: sview = "a7286ec774f4fa1265e2e755f23a3ea5722d4eec17b29d022b566535d286a878"
            SUCCESS: sview = "Source-length policy passed (600-line maximum).\n"
            PLAN_VIOLATION: sview = "Elisa_Engine_Architecture_and_Plan.md: 601 lines (maximum 600)\n"
            TIMEOUT_STEPS: u64 = 10000
            OUTPUT_BYTES: u64 = 65536
            PIN_BYTES: usize = 67108864
            COPY_BYTES: usize = 524288
            TOTAL_COPY_BYTES: usize = 2097152


        const module Paths:
            REFERENCE: sview = "elisa-engine/scripts/check_source_length.py"
            CANDIDATE: sview = "elisa-script/scripts/check_elisa_engine_source_length.elisascript"
            CANDIDATE_LAUNCH: sview = "elisa-script/alternate/scripts/check_elisa_engine_source_length.elisascript"


        struct SourceCopy:
            source: sview
            destination: sview
            sha256: sview


        struct FixtureRoot:
            path: Path
            created: bool = false
            ready: bool = false
            files: darray[Path] = []
            directories: darray[Path] = []


        struct Authorization:
            launcher: sview
            launcher_sha256: sview
            compiler_sha256: sview


        error GateError:
            Disabled
            MissingGuard
            WrongCompiler
            MissingIdentity


        def environment_value(name: sview) -> sview can[Environment.Read]:
            return try getenv(name, "") else ""


        def valid_sha256(value: sview) -> bool:
            return EsSkiaEnvironmentLauncherPlan::valid_hash(value)


        def authorization() -> Authorization error[GateError] can[Environment.Read]:
            raise GateError.Disabled if environment_value("ELISASCRIPT_VALIDATION_REAUTHORIZED") != "1" or environment_value("ELISASCRIPT_ELISA_ENGINE_SOURCE_LENGTH_LAUNCHER_QUALIFIED") != "1"
            raise GateError.MissingGuard if environment_value("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD") != "active"
            raise GateError.WrongCompiler if environment_value("ELISA_LOCAL_COMPILER") != Tools::COMPILER or environment_value("ELISACORE_BIN") != Tools::COMPILER
            launcher: sview = environment_value("ELISASCRIPT_PUBLIC_LAUNCHER")
            launcher_hash: sview = environment_value("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256")
            compiler_hash: sview = environment_value("ELISASCRIPT_LOCAL_COMPILER_SHA256")
            try EsSkiaEnvironmentLauncherPlan::validate_roles(
                EsSkiaEnvironmentLauncherPlan::Identity{path: launcher, hash: launcher_hash},
                EsSkiaEnvironmentLauncherPlan::Identity{path: Tools::PYTHON, hash: Tools::PYTHON_SHA256},
                compiler_hash) else err:
                raise GateError.MissingIdentity
            return Authorization{launcher: launcher, launcher_sha256: launcher_hash, compiler_sha256: compiler_hash}


        def sources() -> darray[SourceCopy] can[Memory.Allocate, Abort.Panic]:
            return [
                SourceCopy{source: "test/fixtures/script_parity/elisa_engine_source_length/reference.py", destination: Paths::REFERENCE, sha256: Tools::REFERENCE_SHA256},
                SourceCopy{source: "scripts/check_elisa_engine_source_length.elisascript", destination: Paths::CANDIDATE, sha256: "f87a1fc0243e1f1701a73480f7599f258838d59d56275b6cd4f713e4daa71905"},
                SourceCopy{source: "src/runtime/engine_source_length_model.elisa", destination: "elisa-script/src/runtime/engine_source_length_model.elisa", sha256: "a68737f908acc4c72025175793bc2d1a9a6b4c58171a22a79ebcf39d5b651ecb"},
                SourceCopy{source: "src/runtime/source_length_stream_posix.elisa", destination: "elisa-script/src/runtime/source_length_stream_posix.elisa", sha256: "9118a31530b0ab95fa6f94ee6e57e70646995b292c2892258447f4beae6954c3"},
                SourceCopy{source: "src/runtime/source_length_model.elisa", destination: "elisa-script/src/runtime/source_length_model.elisa", sha256: "4a4b986e05ac7e5acd33101e5bfa2107b628efc3aeb2174a2ca2542f575500aa"},
                SourceCopy{source: "src/runtime/bounded_text_posix.elisa", destination: "elisa-script/src/runtime/bounded_text_posix.elisa", sha256: "a0c8d8144e4ebd9f90402489696b153bed6e7b292722ba2ca11eda551c27cda0"},
                SourceCopy{source: "src/runtime/encoding.elisa", destination: "elisa-script/src/runtime/encoding.elisa", sha256: "67815c728730d891c2e5fc0cc53a33d672d0f40003cfd468de903c4fbfcd9a53"},
                SourceCopy{source: "src/runtime/file_posix.elisa", destination: "elisa-script/src/runtime/file_posix.elisa", sha256: "14e1e3a9f0d95ee3e45509bd7d76c1ba2694992d5530f82edf8533d9cf149643"},
                # Pin the committed bridge, not another agent's dirty edits.
                SourceCopy{source: "src/runtime/directory_posix.elisa", destination: "elisa-script/src/runtime/directory_posix.elisa", sha256: "226121fabdb841e3f03e8d8e46848087677db8057571b9a544ef828093a97f92"},
                SourceCopy{source: "src/runtime/stdio_posix.elisa", destination: "elisa-script/src/runtime/stdio_posix.elisa", sha256: "c02cac5eec931a2f2aa9131616482df4e17333948961c4b6d0d215b0ab0e766c"}
            ]


        def has_sha256(target: sview, expected: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if not valid_sha256(expected) or target == "" or target == "-" or len(target) > EsChecksumRecord::Limits::FILENAME_BYTES
            for byte in target:
                return false if byte == 0u8
            return false if not is_file(path(target)) or is_symlink(path(target))
            size: usize = try file_size(path(target)) else err:
                return false
            return false if size == 0 or size > Tools::PIN_BYTES
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "engine-source-length-identity",
                target: Tools::SHA256,
                arguments: ["-a", "256", "-t", "--", target],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Tools::TIMEOUT_STEPS,
                max_output_bytes: Tools::OUTPUT_BYTES
            }
            observed: DifferentialRun = try run_differential_process(runner) else err:
                return false
            return false if observed.outcome != DifferentialRunOutcome.Completed or observed.exit_status != 0 or observed.stderr != ""
            return try EsChecksumRecord::sha256_text_record_matches(observed.stdout, expected, target) else false


        def native_artifact(target: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if not EsSkiaEnvironmentLauncherPlan::absolute_identity_path(target)
            file: Path = path(target)
            return false if not is_file(file) or is_symlink(file) or not is_executable(file)
            size: usize = try file_size(file) else 0usize
            return false if size < 4 or size > Tools::PIN_BYTES
            name: mutable darray[u8] = []
            for byte in target |name|:
                name.push(byte)
            name.push(0u8)
            mode: darray[u8] = [114u8, 98u8, 0u8]
            stream: mutable heap void&? = fopen(&name[0], &mode[0])
            return false if stream == null
            opened: mutable heap void& = stream
            header: mutable darray[u8] = [0u8, 0u8, 0u8, 0u8]
            amount: usize = fread((&header[0]).cast[mutable void&], 1, 4, opened)
            closed: int = fclose(opened)
            return amount == 4 and closed == 0 and EsSkiaEnvironmentLauncherPlan::native_container_header(header) and not is_symlink(file)


        def pinned_inputs(auth: Authorization) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            # Header recognition is only a preliminary text-wrapper rejection.
            return false if not native_artifact(Tools::COMPILER) or not native_artifact(Tools::PYTHON) or not native_artifact(auth.launcher)
            script_directory: Path = try path_real(path_parent(Script::source_path())) else err:
                return false
            repository_root: Path = script_directory.parent().parent()
            original_reference: Path = repository_root.parent().joinpath("elisa-engine/scripts/check_source_length.py")
            return false if not has_sha256(f"{original_reference}", Tools::REFERENCE_SHA256)
            # The process executor is another input to the parity result; a
            # concurrent edit must invalidate this launcher before child runs.
            return false if not has_sha256("src/testing/differential.elisa", "22b3b93ac3bafb9103f96a8e48d18769698e2e223da34eb10fe7d7572f9652ac")
            return false if not has_sha256(Tools::SHA256, "0812595f981a26f813d98dc380af14d4af427626c9339eda29eb849ae13de1e3")
            return false if not has_sha256("test/script_parity/skia_environment_launcher_plan.elisa", "9941a2c973a8492f20a36785bf6c44085bb7d3718218eaf8d12536feb645164e")
            return false if not has_sha256("src/testing/checksum_record_model.elisa", "1b3cec1235d42076e50b15491d3d6b906f3841ea966937779dc665f1e8a59488")
            return false if not has_sha256(Tools::PYTHON, Tools::PYTHON_SHA256) or not has_sha256(Tools::COMPILER, auth.compiler_sha256) or not has_sha256(auth.launcher, auth.launcher_sha256)
            for source in sources():
                return false if not has_sha256(source.source, source.sha256)
            return true


        def write_new(root: mutable FixtureRoot&, relative: sview, contents: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read]:
            return false if not parents_intact(root, root.directories.count)
            target: Path = root.path.joinpath(relative)
            return false if path_exists(target) or is_symlink(target)
            root.files.push(target)
            written: usize = try write_text(target, contents) else err:
                return false
            return written == len(contents)


        def rewrite(root: FixtureRoot, relative: sview, contents: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read]:
            return false if not parents_intact(root, root.directories.count)
            target: Path = root.path.joinpath(relative)
            return false if is_symlink(target) or not is_file(target)
            written: usize = try write_text(target, contents) else err:
                return false
            return written == len(contents)


        def retire_last_file(root: mutable FixtureRoot&, relative: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read]:
            return false if root.files.count == 0 or not parents_intact(root, root.directories.count)
            target: Path = root.path.joinpath(relative)
            recorded: Path = root.files[root.files.count - 1]
            return false if f"{recorded}" != f"{target}"
            return false if not is_symlink(target) and not is_file(target)
            removed: bool = try remove_path(target) else false
            return false if not removed
            _ = root.files.pop()
            return true


        def make_directory(root: mutable FixtureRoot&, relative: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write]:
            return false if not parents_intact(root, root.directories.count)
            target: Path = root.path.joinpath(relative)
            return false if path_exists(target) or is_symlink(target)
            created: bool = try create_directory(target) else false
            return false if not created
            root.directories.push(target)
            return true


        def make_symlink(root: mutable FixtureRoot&, relative: sview, target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read]:
            return false if not parents_intact(root, root.directories.count)
            link: Path = root.path.joinpath(relative)
            return false if path_exists(link) or is_symlink(link)
            created: bool = try symlink(target, link) else false
            return false if not created
            root.files.push(link)
            return true


        def parents_intact(root: FixtureRoot, remaining: usize) -> bool can[Memory.Allocate, Abort.Panic, File.Read, Directory.Read]:
            return false if remaining > root.directories.count or is_symlink(root.path) or not is_directory(root.path)
            for index in 0..<remaining:
                directory: Path = root.directories[index]
                return false if is_symlink(directory) or not is_directory(directory)
            return true


        def cleanup(root: FixtureRoot) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write]:
            return true if not root.created
            cleaned: mutable bool = true
            for index in 0..<root.files.count |root, cleaned|:
                return false if not parents_intact(root, root.directories.count)
                target: Path = root.files[root.files.count - index - 1]
                if path_exists(target) or is_symlink(target):
                    removed: bool = try remove_path(target) else false
                    cleaned <- removed and cleaned
            for index in 0..<root.directories.count |root, cleaned|:
                return false if not parents_intact(root, root.directories.count - index)
                removed: bool = try remove_directory(root.directories[root.directories.count - index - 1]) else false
                cleaned <- removed and cleaned
            return false if not parents_intact(root, 0)
            removed_root: bool = try remove_directory(root.path) else false
            return removed_root and cleaned


        def copy_sources(root: mutable FixtureRoot&) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Unsafe.PointerCast]:
            copied_bytes: mutable usize = 0
            for source in sources() |root, copied_bytes|:
                contents: sview = try EsBoundedText::read_utf8(path(source.source), Tools::COPY_BYTES) else err:
                    return false
                return false if contents == "" or len(contents) > Tools::TOTAL_COPY_BYTES - copied_bytes
                return false if not write_new(root, source.destination, contents)
                copied_bytes <- copied_bytes + len(contents)
                return false if not has_sha256(f"{root.path.joinpath(source.destination)}", source.sha256)
            return true


        def create_root() -> FixtureRoot can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            allocated: Path = try temp_directory("elisascript Elisa Engine source-length parity ") else err:
                return FixtureRoot{path: path("."), created: false}
            canonical: Path = try path_real(allocated) else err:
                return FixtureRoot{path: allocated, created: true}
            root: mutable FixtureRoot = FixtureRoot{path: canonical, created: true}
            directories: darray[sview] = [
                "elisa-engine", "elisa-engine/scripts",
                "elisa-script", "elisa-script/scripts", "elisa-script/src",
                "elisa-script/src/runtime", "elisa-script/alternate",
                "elisa-script/alternate/scripts", "elisa-script/alternate/src"
            ]
            for relative in directories:
                if not make_directory(root, relative):
                    return root
            if not copy_sources(root):
                return root
            if not make_symlink(root, "elisa-script/alternate/src/runtime", root.path.joinpath("elisa-script/src/runtime")):
                return root
            if not make_symlink(root, Paths::CANDIDATE_LAUNCH, root.path.joinpath(Paths::CANDIDATE)):
                return root
            root.ready <- true
            return root


        def expected_observation(run: DifferentialRun, status: i64, stdout: sview, stderr: sview) -> bool:
            return run.outcome == DifferentialRunOutcome.Completed and run.error_text == "" and run.exit_status == status and run.stdout == stdout and run.stderr == stderr


        def case_matches(auth: Authorization, root: FixtureRoot, status: i64, stdout: sview, stderr: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast]:
            return false if not root.ready or not parents_intact(root, root.directories.count)
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Tools::PATH_VALUE},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"}
            ]
            reference: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "elisa-engine-source-length-python-reference",
                target: Tools::PYTHON,
                arguments: ["-I", "-B", f"{root.path.joinpath(Paths::REFERENCE)}", "ignored argument"],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Tools::TIMEOUT_STEPS,
                max_output_bytes: Tools::OUTPUT_BYTES
            }
            candidate: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisa-engine-source-length-candidate",
                target: auth.launcher,
                arguments: [f"{root.path.joinpath(Paths::CANDIDATE_LAUNCH)}", "ignored argument"],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Tools::TIMEOUT_STEPS,
                max_output_bytes: Tools::OUTPUT_BYTES
            }
            reference_run: DifferentialRun = try run_differential_process(reference) else err:
                return false
            return false if not expected_observation(reference_run, status, stdout, stderr) or not parents_intact(root, root.directories.count)
            candidate_run: DifferentialRun = try run_differential_process(candidate) else err:
                return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return comparison.equal and expected_observation(candidate_run, status, stdout, stderr) and parents_intact(root, root.directories.count)


        def repeated(value: sview, count: usize) -> sview can[Memory.Allocate, Abort.Panic]:
            result: mutable sview = ""
            for _ in 0..<count |value, result|:
                result <- result + value
            return result


        def matrix(auth: Authorization, root: mutable FixtureRoot&) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Write]:
            if not case_matches(auth, root, 0i64, Tools::SUCCESS, ""):
                return false

            # pathlib skips a configured root that exists as a regular file.
            if not write_new(root, "elisa-engine/src", repeated("\n", 601)):
                return false
            if not case_matches(auth, root, 0i64, Tools::SUCCESS, ""):
                return false
            if not retire_last_file(root, "elisa-engine/src"):
                return false

            plan: sview = "elisa-engine/Elisa_Engine_Architecture_and_Plan.md"
            if not write_new(root, plan, repeated("\r\n", 600)) or not case_matches(auth, root, 0i64, Tools::SUCCESS, ""):
                return false
            if not rewrite(root, plan, repeated("\r\n", 600) + "tail") or not case_matches(auth, root, 1i64, "", Tools::PLAN_VIOLATION):
                return false
            if not rewrite(root, plan, repeated("\n", 601)) or not case_matches(auth, root, 1i64, "", Tools::PLAN_VIOLATION):
                return false

            directories: darray[sview] = [
                "elisa-engine/src", "elisa-engine/src/.hidden", "elisa-engine/src/a", "elisa-engine/src/a-",
                "elisa-engine/test", "elisa-engine/proof", "elisa-engine/examples", "elisa-engine/scripts",
                "elisa-engine/native", "elisa-engine/backends", "elisa-engine/docs"
            ]
            for relative in directories:
                if not make_directory(root, relative):
                    return false

            oversized: sview = repeated("\n", 601)
            files: darray[sview] = [
                "elisa-engine/src/a.elisa",
                "elisa-engine/src/a/z.py",
                "elisa-engine/src/a-/z.py",
                "elisa-engine/src/.hidden/child.gd",
                "elisa-engine/src/.md",
                "elisa-engine/src/ignored.MD",
                "elisa-engine/src/ignored.txt",
                "elisa-engine/test/test.h",
                "elisa-engine/proof/p.py",
                "elisa-engine/examples/e.inc",
                "elisa-engine/scripts/s.elisascript",
                "elisa-engine/native/n.cpp",
                "elisa-engine/backends/b.gd",
                "elisa-engine/docs/d.md"
            ]
            for relative in files:
                if not write_new(root, relative, oversized):
                    return false
            if not make_symlink(root, "elisa-engine/src/matching-symlink.elisa", root.path.joinpath("elisa-engine/src/a.elisa")):
                return false
            if not make_symlink(root, "elisa-engine/src/loop", root.path.joinpath("elisa-engine/src")):
                return false

            expected: sview = "Elisa_Engine_Architecture_and_Plan.md: 601 lines (maximum 600)\nsrc/.hidden/child.gd: 601 lines (maximum 600)\nsrc/a/z.py: 601 lines (maximum 600)\nsrc/a-/z.py: 601 lines (maximum 600)\nsrc/a.elisa: 601 lines (maximum 600)\nsrc/matching-symlink.elisa: 601 lines (maximum 600)\ntest/test.h: 601 lines (maximum 600)\nproof/p.py: 601 lines (maximum 600)\nexamples/e.inc: 601 lines (maximum 600)\nscripts/s.elisascript: 601 lines (maximum 600)\nnative/n.cpp: 601 lines (maximum 600)\nbackends/b.gd: 601 lines (maximum 600)\ndocs/d.md: 601 lines (maximum 600)\n"
            return case_matches(auth, root, 1i64, "", expected)


    public:
        @test
        def engine_source_length_observation_admission_is_exact() -> void:
            can Memory.Allocate, Abort.Panic:
                accepted: DifferentialRun = DifferentialRun{observations: [], exit_status: 0i64, stdout: Tools::SUCCESS}
                assert expected_observation(accepted, 0i64, Tools::SUCCESS, "")
                assert not expected_observation(accepted, 0i64, "", "")
                assert not expected_observation(DifferentialRun{observations: [], exit_status: 0i64, stdout: Tools::SUCCESS, stderr: "extra"}, 0i64, Tools::SUCCESS, "")
                assert not expected_observation(DifferentialRun{observations: [], outcome: DifferentialRunOutcome.Timeout, stdout: Tools::SUCCESS}, 0i64, Tools::SUCCESS, "")


        def public_launcher_parity() -> bool can[Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Write, Console.Format]:
            auth: Authorization = try authorization() else err:
                _ = write_stderr("engine source-length parity: validation gate is not qualified\n")
                return false
            return false if not pinned_inputs(auth)
            root: mutable FixtureRoot = create_root()
            return false if not root.created
            matched: bool = root.ready and matrix(auth, root)
            cleaned: bool = cleanup(root)
            if not cleaned:
                _ = write_stderr(f"engine source-length parity: cleanup failed at {root.path}\n")
                return false
            if not matched:
                _ = write_stderr("engine source-length parity: setup or expected observation failed\n")
                return false
            return pinned_inputs(auth)


@test
def elisa_engine_source_length_public_launcher_matches_pinned_python() -> void:
    can Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Write, Console.Format:
        assert EsEngineSourceLengthLauncherParity::public_launcher_parity()
