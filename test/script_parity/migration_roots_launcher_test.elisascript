# Process-level parity for the real AWK-backed migration-roots audit.
# Deliberately gated: do not run without explicit validation reauthorization.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsMigrationRootsLauncherParity:
    private:
        const module Commands:
            REFERENCE_SCRIPT: sview = "scripts/check_migration_roots.sh"
            CANDIDATE_SCRIPT: sview = "scripts/check_migration_roots.elisascript"
            MANIFEST: sview = "docs/migration-project-roots.tsv"
            CODING_PROJECTS_ROOT: sview = "../.."
            SHELL: sview = "/bin/bash"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            REFERENCE_SHA256: sview = "49f69a7039b962368a85ef4407ffa21caefa17bfc77fe1fdba4e612104e69c7a"
            CANDIDATE_SHA256: sview = "660bac941a705faeb3a94949926df33e701b2fbab02cc235a8c13e40c8187033"
            BOUNDED_TEXT_SHA256: sview = "f648d319aca3610e245452d681c21556cc58a774982ea8d0bbda2cca4f1823be"
            MANIFEST_SHA256: sview = "4bd038be6ae77fd09a9c695a70bee64de9b6c7878c4e778377819f3c445113c1"
            HASH_OUTPUT_BYTES: u64 = 8192
            PROCESS_OUTPUT_BYTES: u64 = 65536
            TIMEOUT_STEPS: u64 = 10000


        struct TemporaryDirectory:
            path: Path
            created: bool = false


        def make_temporary_directory() -> TemporaryDirectory can[Memory.Allocate, Abort.Panic, File.Write]:
            created_path: Path = try temp_directory("migration-roots-parity") else err:
                return TemporaryDirectory{path: path("."), created: false}
            return TemporaryDirectory{path: created_path, created: true}


        def write_fixture_bytes(target: Path, contents: darray[u8]) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            written: usize = try write_bytes(target, contents) else 0u64
            return written == contents.count


        def remove_fixture_path(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            return try remove_path(target) else false


        def remove_fixture_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try remove_directory(target) else false


        def append_exact_padding(target: mutable darray[u8]&, size: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if target.count > size
            while target.count < size |target, size|:
                target.push(35u8)
            return true


        def append_manifest_text(target: mutable darray[u8]&, text: sview) -> void can[Memory.Allocate, Abort.Panic]:
            for byte in text |target|:
                target.push(byte)


        def append_exact_blank_lines(target: mutable darray[u8]&, size: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if target.count > size
            while target.count < size |target, size|:
                target.push(10u8)
            return true


        def append_repeated_ascii(target: mutable darray[u8]&, byte: u8, count: usize) -> void can[Memory.Allocate, Abort.Panic]:
            for _ in 0..<count |target|:
                target.push(byte)


        def file_has_expected_sha256(file_path: sview, expected_hex: sview, process_name: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            input_path: Path = path(file_path)
            return false if not is_file(input_path)
            input_size: usize = try file_size(input_path) else err:
                return false
            return false if input_size == 0 or input_size > 67108864

            hash_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: process_name,
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", file_path],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(hash_runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false

            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            return hash_run.stdout == expected_hex + "  " + file_path + "\n"


        def launcher_digest_matches_internal(launcher: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return file_has_expected_sha256(launcher, expected_hex, "migration-roots-launcher-sha256")


        def pinned_sources_match_internal() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            bounded_text: Path = try path_real(path("src/runtime/bounded_text_posix.elisa")) else err:
                return false
            manifest: Path = try path_real(path(Commands::MANIFEST)) else err:
                return false
            return false if not file_has_expected_sha256(f"{reference}", Commands::REFERENCE_SHA256, "migration-roots-reference-sha256")
            return false if not file_has_expected_sha256(f"{candidate}", Commands::CANDIDATE_SHA256, "migration-roots-candidate-sha256")
            return false if not file_has_expected_sha256(f"{bounded_text}", Commands::BOUNDED_TEXT_SHA256, "migration-roots-bounded-text-sha256")
            return file_has_expected_sha256(f"{manifest}", Commands::MANIFEST_SHA256, "migration-roots-manifest-sha256")


        def process_parity_case(launcher: sview, coding_root_text: sview, manifest_text: sview, expected_status: i64, expected_stdout: sview, expected_stderr: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            reference_text: sview = f"{reference}"
            candidate_text: sview = f"{candidate}"
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "awk-migration-roots-reference",
                target: Commands::SHELL,
                arguments: [reference_text, coding_root_text, manifest_text],
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::PROCESS_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    print("migration-roots AWK reference process failed")
                    return false

            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "elisascript-migration-roots-candidate",
                target: launcher,
                arguments: [candidate_text, coding_root_text, manifest_text],
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::PROCESS_OUTPUT_BYTES
            }
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    print("migration-roots Elisascript candidate process failed")
                    return false

            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return comparison.equal and reference_run.exit_status == expected_status and candidate_run.exit_status == expected_status and reference_run.stdout == expected_stdout and candidate_run.stdout == expected_stdout and reference_run.stderr == expected_stderr and candidate_run.stderr == expected_stderr


        def positive_process_parity(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            manifest: Path = try path_real(path(Commands::MANIFEST)) else err:
                return false
            coding_projects_root: Path = try path_real(path(Commands::CODING_PROJECTS_ROOT)) else err:
                return false
            manifest_text: sview = f"{manifest}"
            coding_root_text: sview = f"{coding_projects_root}"
            expected_output: sview = "migration roots audit: manifest shape, ownership, and declared directories are valid\n"
            return process_parity_case(launcher, coding_root_text, manifest_text, 0i64, expected_output, "")


        def negative_process_parity(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            coding_projects_root: Path = try path_real(path(Commands::CODING_PROJECTS_ROOT)) else err:
                return false
            repository_root: Path = try path_real(path(".")) else err:
                return false
            missing_root: Path = repository_root.joinpath(".elisascript-missing-migration-root-fixture")
            missing_manifest: Path = repository_root.joinpath(".elisascript-missing-migration-manifest-fixture")
            malformed_manifest: Path = try path_real(path("docs/migration-review-current.tsv")) else err:
                return false
            return false if is_directory(missing_root) or is_file(missing_manifest)
            missing_root_text: sview = f"{missing_root}"
            root_text: sview = f"{coding_projects_root}"
            missing_manifest_text: sview = f"{missing_manifest}"
            malformed_manifest_text: sview = f"{malformed_manifest}"
            return false if not process_parity_case(launcher, missing_root_text, missing_manifest_text, 2i64, "", "migration roots audit: coding-projects root does not exist: " + missing_root_text + "\n")
            return false if not process_parity_case(launcher, root_text, missing_manifest_text, 2i64, "", "migration roots audit: manifest does not exist: " + missing_manifest_text + "\n")
            return false if not process_parity_case(launcher, root_text, malformed_manifest_text, 1i64, "", "migration roots audit: malformed, duplicated, unsafe, or unowned reviewed row\n")

            temporary: TemporaryDirectory = make_temporary_directory()
            return false if not temporary.created
            oversized_manifest: Path = temporary.path.joinpath("oversized.tsv")
            source_manifest: sview = try read_text(path(Commands::MANIFEST)) else err:
                _ = remove_fixture_directory(temporary.path)
                return false
            exact_bytes: mutable darray[u8] = []
            append_manifest_text(exact_bytes, source_manifest)
            exact_size_ok: bool = append_exact_blank_lines(exact_bytes, 1048576u64)
            exact_write_ok: bool = exact_size_ok and write_fixture_bytes(oversized_manifest, exact_bytes)
            exact_manifest: Path = try path_real(oversized_manifest) else err:
                _ = remove_fixture_path(oversized_manifest)
                _ = remove_fixture_directory(temporary.path)
                return false
            exact_manifest_text: sview = f"{exact_manifest}"
            exact_output: sview = "migration roots audit: manifest shape, ownership, and declared directories are valid\n"
            exact_parity_ok: bool = exact_write_ok and process_parity_case(launcher, root_text, exact_manifest_text, 0i64, exact_output, "")

            oversized_bytes: mutable darray[u8] = []
            size_ok: bool = append_exact_padding(oversized_bytes, 1048577u64)
            write_ok: bool = size_ok and write_fixture_bytes(oversized_manifest, oversized_bytes)
            oversized_manifest_text: sview = f"{exact_manifest}"
            oversized_parity_ok: bool = write_ok and process_parity_case(launcher, root_text, oversized_manifest_text, 1i64, "", "migration roots audit: manifest exceeds audit limit\n")

            too_many_rows: mutable darray[u8] = []
            append_manifest_text(too_many_rows, "# name\trelative_path\towner\treview_status\n")
            for row_index in 0..<4097 |too_many_rows|:
                append_manifest_text(too_many_rows, "migration-root-" + f"{row_index}" + "\troot-" + f"{row_index}" + "\towner\tpending\n")
            rows_write_ok: bool = write_fixture_bytes(oversized_manifest, too_many_rows)
            rows_parity_ok: bool = rows_write_ok and process_parity_case(launcher, root_text, oversized_manifest_text, 1i64, "", "migration roots audit: malformed, duplicated, unsafe, or unowned reviewed row\n")

            oversized_field: mutable darray[u8] = []
            append_manifest_text(oversized_field, "# name\trelative_path\towner\treview_status\nx\t.\t")
            append_repeated_ascii(oversized_field, 111u8, 65537u64)
            append_manifest_text(oversized_field, "\tpending\n")
            field_write_ok: bool = write_fixture_bytes(oversized_manifest, oversized_field)
            field_parity_ok: bool = field_write_ok and process_parity_case(launcher, root_text, oversized_manifest_text, 1i64, "", "migration roots audit: malformed, duplicated, unsafe, or unowned reviewed row\n")

            oversized_path_field: mutable darray[u8] = []
            append_manifest_text(oversized_path_field, "# name\trelative_path\towner\treview_status\nx\t")
            append_repeated_ascii(oversized_path_field, 97u8, 4096u64)
            append_manifest_text(oversized_path_field, "\towner\tpending\n")
            path_write_ok: bool = write_fixture_bytes(oversized_manifest, oversized_path_field)
            path_parity_ok: bool = path_write_ok and process_parity_case(launcher, root_text, oversized_manifest_text, 1i64, "", "migration roots audit: malformed, duplicated, unsafe, or unowned reviewed row\n")
            _ = remove_fixture_path(oversized_manifest)
            cleanup_ok: bool = remove_fixture_directory(temporary.path)
            return exact_parity_ok and oversized_parity_ok and rows_parity_ok and field_parity_ok and path_parity_ok and cleanup_ok


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def pinned_sources_match() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast]:
            return pinned_sources_match_internal()


        def launcher_hash_matches(launcher: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return launcher_digest_matches_internal(launcher, expected_hex)


        def run_positive_case(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            return positive_process_parity(launcher)


        def run_negative_cases(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            return negative_process_parity(launcher)


@test
def migration_roots_public_launcher_matches_awk_reference() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsMigrationRootsLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsMigrationRootsLauncherParity::pinned_compiler_path()
        assert launcher != "" and launcher.startswith("/")
        assert EsMigrationRootsLauncherParity::pinned_sources_match()
        assert EsMigrationRootsLauncherParity::launcher_hash_matches(launcher, launcher_hash)
        print("public_launcher_path=" + launcher)
        print("public_launcher_sha256=" + launcher_hash)
        assert EsMigrationRootsLauncherParity::run_negative_cases(launcher)
        assert EsMigrationRootsLauncherParity::run_positive_case(launcher)
        assert EsMigrationRootsLauncherParity::pinned_sources_match()
        assert EsMigrationRootsLauncherParity::launcher_hash_matches(launcher, launcher_hash)
