include "../../ports/elisa-engine/scripts/test_crash_report_plan.elisa"

using EsEngineCrashReportTestPlan


@test
def plans_exact_compile_and_crash_probe_argv_with_spaced_paths() -> void can[Memory.Allocate, Abort.Panic]:
    plan: Plan = EsEngineCrashReportTestPlan::plan(
        "/projects/elisa engine", "/tmp/crash report-test", "/toolchain/clang++ path"
    )
    assert plan.temporary_directory == "/tmp/crash report-test"
    assert plan.executable_path == "/tmp/crash report-test/crash-report-test"
    assert plan.reports_directory == "/tmp/crash report-test/reports"
    assert plan.compile_command.program == "/toolchain/clang++ path"
    assert plan.compile_command.arguments.count == 9
    assert plan.compile_command.arguments[0] == "-std=c++17"
    assert plan.compile_command.arguments[1] == "-O0"
    assert plan.compile_command.arguments[2] == "-g"
    assert plan.compile_command.arguments[3] == "-rdynamic"
    assert plan.compile_command.arguments[4] == "-I"
    assert plan.compile_command.arguments[5] == "/projects/elisa engine/native"
    assert plan.compile_command.arguments[6] == "/projects/elisa engine/test/crash_report_test.cpp"
    assert plan.compile_command.arguments[7] == "-o"
    assert plan.compile_command.arguments[8] == plan.executable_path
    assert plan.test_command.program == plan.executable_path
    assert plan.test_command.arguments.count == 2
    assert plan.test_command.arguments[0] == plan.reports_directory
    assert plan.test_command.arguments[1] == "--probe-arg"


@test
def preparation_and_compile_failures_clean_up_without_running_the_probe() -> void can[Memory.Allocate, Abort.Panic]:
    preparation_failure: mutable ExecutionState = initial_execution()
    preparation_failure <- try execution_after_prepare(preparation_failure, false) else preparation_failure
    assert preparation_failure.phase == ExecutionPhase.Cleanup
    assert preparation_failure.exit_status == 1
    preparation_failure <- try execution_after_cleanup(preparation_failure, true) else preparation_failure
    assert preparation_failure.phase == ExecutionPhase.Done

    compile_failure: mutable ExecutionState = initial_execution()
    compile_failure <- try execution_after_prepare(compile_failure, true) else compile_failure
    compile_failure <- try execution_after_compile(compile_failure, 23) else compile_failure
    assert compile_failure.phase == ExecutionPhase.Cleanup
    assert compile_failure.exit_status == 23
    compile_failure <- try execution_after_cleanup(compile_failure, true) else compile_failure
    assert compile_failure.phase == ExecutionPhase.Done
    assert compile_failure.exit_status == 23

    launch_failure: mutable ExecutionState = initial_execution()
    launch_failure <- try execution_after_prepare(launch_failure, true) else launch_failure
    launch_failure <- try execution_after_compile(launch_failure, 0) else launch_failure
    launch_failure <- try execution_after_run(launch_failure, 127, false) else launch_failure
    assert launch_failure.phase == ExecutionPhase.Cleanup
    launch_failure <- try execution_after_cleanup(launch_failure, true) else launch_failure
    assert launch_failure.phase == ExecutionPhase.Done and launch_failure.exit_status == 127


@test
def a_failed_probe_shows_reports_before_cleanup_and_preserves_status() -> void can[Memory.Allocate, Abort.Panic]:
    state: mutable ExecutionState = initial_execution()
    state <- try execution_after_prepare(state, true) else state
    state <- try execution_after_compile(state, 0) else state
    state <- try execution_after_run(state, 37, true) else state
    assert state.phase == ExecutionPhase.ShowReports
    state <- try execution_after_reports(state, true) else state
    assert state.phase == ExecutionPhase.Cleanup
    state <- try execution_after_cleanup(state, true) else state
    assert state.phase == ExecutionPhase.Done
    assert state.exit_status == 37


@test
def report_read_failure_and_cleanup_failure_are_nonzero():
    can Memory.Allocate, Abort.Panic:
        reports_failure: mutable ExecutionState = initial_execution()
        reports_failure <- try execution_after_prepare(reports_failure, true) else reports_failure
        reports_failure <- try execution_after_compile(reports_failure, 0) else reports_failure
        reports_failure <- try execution_after_run(reports_failure, 37, true) else reports_failure
        reports_failure <- try execution_after_reports(reports_failure, false) else reports_failure
        assert reports_failure.exit_status == 1
        reports_failure <- try execution_after_cleanup(reports_failure, true) else reports_failure
        assert reports_failure.phase == ExecutionPhase.Done and reports_failure.exit_status == 1

        cleanup_after_child_failure: mutable ExecutionState = initial_execution()
        cleanup_after_child_failure <- try execution_after_prepare(cleanup_after_child_failure, true) else cleanup_after_child_failure
        cleanup_after_child_failure <- try execution_after_compile(cleanup_after_child_failure, 0) else cleanup_after_child_failure
        cleanup_after_child_failure <- try execution_after_run(cleanup_after_child_failure, 37, true) else cleanup_after_child_failure
        cleanup_after_child_failure <- try execution_after_reports(cleanup_after_child_failure, true) else cleanup_after_child_failure
        cleanup_after_child_failure <- try execution_after_cleanup(cleanup_after_child_failure, false) else cleanup_after_child_failure
        assert cleanup_after_child_failure.phase == ExecutionPhase.Done and cleanup_after_child_failure.exit_status == 1

        cleanup_failure: mutable ExecutionState = initial_execution()
        cleanup_failure <- try execution_after_prepare(cleanup_failure, true) else cleanup_failure
        cleanup_failure <- try execution_after_compile(cleanup_failure, 0) else cleanup_failure
        cleanup_failure <- try execution_after_run(cleanup_failure, 0, true) else cleanup_failure
        cleanup_failure <- try execution_after_cleanup(cleanup_failure, false) else cleanup_failure
        assert cleanup_failure.phase == ExecutionPhase.Done and cleanup_failure.exit_status == 1


@test
def success_message_is_after_successful_cleanup():
    can Memory.Allocate, Abort.Panic:
        state: mutable ExecutionState = initial_execution()
        state <- try execution_after_prepare(state, true) else state
        state <- try execution_after_compile(state, 0) else state
        state <- try execution_after_run(state, 0, true) else state
        assert state.phase == ExecutionPhase.Cleanup
        state <- try execution_after_cleanup(state, true) else state
        assert state.phase == ExecutionPhase.ReportSuccess
        state <- try execution_after_success_report(state) else state
        assert state.phase == ExecutionPhase.Done and state.exit_status == 0
