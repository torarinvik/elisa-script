include "../../ports/elisa-engine/scripts/test_mikktspace_plan.elisa"

using EsEngineMikktspaceTestPlan


@test
def plans_both_sanitized_compiler_commands_and_inherited_environment_overlay() -> void can[Memory.Allocate, Abort.Panic]:
    plan: Plan = EsEngineMikktspaceTestPlan::plan(
        "/projects/elisa engine", "/tmp/mikktspace test", "/toolchain/cc path", "/toolchain/c++ path"
    )
    assert plan.temporary_directory == "/tmp/mikktspace test"
    assert plan.executable_path == "/tmp/mikktspace test/mikktspace-test"
    assert plan.compile_c_command.program == "/toolchain/cc path"
    assert plan.compile_c_command.arguments.count == 11
    assert plan.compile_c_command.arguments[0] == "-std=c99"
    assert plan.compile_c_command.arguments[3] == "-fsanitize=address,undefined"
    assert plan.compile_c_command.arguments[5] == "-I"
    assert plan.compile_c_command.arguments[6] == "/projects/elisa engine/dependencies/mikktspace"
    assert plan.compile_c_command.arguments[7] == "-c"
    assert plan.compile_c_command.arguments[8] == "/projects/elisa engine/dependencies/mikktspace/mikktspace.c"
    assert plan.compile_c_command.arguments[10] == "/tmp/mikktspace test/mikktspace.o"

    assert plan.compile_cpp_command.program == "/toolchain/c++ path"
    assert plan.compile_cpp_command.arguments.count == 13
    assert plan.compile_cpp_command.arguments[0] == "-std=c++17"
    assert plan.compile_cpp_command.arguments[6] == "/projects/elisa engine/dependencies/mikktspace"
    assert plan.compile_cpp_command.arguments[8] == "/projects/elisa engine/native"
    assert plan.compile_cpp_command.arguments[9] == "/projects/elisa engine/native/mikktspace_geometry_test.cpp"
    assert plan.compile_cpp_command.arguments[10] == "/tmp/mikktspace test/mikktspace.o"
    assert plan.compile_cpp_command.arguments[12] == plan.executable_path

    assert plan.test_command.program == "env"
    assert plan.test_command.arguments == [
        "ASAN_OPTIONS=halt_on_error=1",
        "UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1",
        plan.executable_path
    ]


@test
def compiler_and_test_statuses_flow_through_cleanup_before_success_reporting() -> void can[Memory.Allocate, Abort.Panic]:
    c_failure: mutable ExecutionState = initial_execution()
    c_failure <- try execution_after_compile_c(c_failure, 23) else c_failure
    assert c_failure.phase == ExecutionPhase.Cleanup and c_failure.exit_status == 23
    c_failure <- try execution_after_cleanup(c_failure, true) else c_failure
    assert c_failure.phase == ExecutionPhase.Done and c_failure.exit_status == 23

    cpp_failure: mutable ExecutionState = initial_execution()
    cpp_failure <- try execution_after_compile_c(cpp_failure, 0) else cpp_failure
    assert cpp_failure.phase == ExecutionPhase.CompileCpp
    cpp_failure <- try execution_after_compile_cpp(cpp_failure, 31) else cpp_failure
    assert cpp_failure.phase == ExecutionPhase.Cleanup and cpp_failure.exit_status == 31
    cpp_failure <- try execution_after_cleanup(cpp_failure, true) else cpp_failure
    assert cpp_failure.phase == ExecutionPhase.Done and cpp_failure.exit_status == 31

    test_failure: mutable ExecutionState = initial_execution()
    test_failure <- try execution_after_compile_c(test_failure, 0) else test_failure
    test_failure <- try execution_after_compile_cpp(test_failure, 0) else test_failure
    test_failure <- try execution_after_run(test_failure, 37) else test_failure
    assert test_failure.phase == ExecutionPhase.Cleanup
    test_failure <- try execution_after_cleanup(test_failure, true) else test_failure
    assert test_failure.phase == ExecutionPhase.Done and test_failure.exit_status == 37

    success: mutable ExecutionState = initial_execution()
    success <- try execution_after_compile_c(success, 0) else success
    success <- try execution_after_compile_cpp(success, 0) else success
    success <- try execution_after_run(success, 0) else success
    success <- try execution_after_cleanup(success, true) else success
    assert success.phase == ExecutionPhase.Report
    success <- try execution_after_report(success) else success
    assert success.phase == ExecutionPhase.Done and success.exit_status == 0


@test
def cleanup_failure_overrides_an_otherwise_successful_run() -> void can[Memory.Allocate, Abort.Panic]:
    state: mutable ExecutionState = initial_execution()
    state <- try execution_after_compile_c(state, 0) else state
    state <- try execution_after_compile_cpp(state, 0) else state
    state <- try execution_after_run(state, 0) else state
    state <- try execution_after_cleanup(state, false) else state
    assert state.phase == ExecutionPhase.Done and state.exit_status == 1
