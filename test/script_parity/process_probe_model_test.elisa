include "process_probe_model.elisa"

using EsProcessProbe


module EsProcessProbeFixture:
    public:
        def assert_bytes(actual: darray[u8], expected: darray[u8]) -> void:
            assert actual.count == expected.count
            for index in 0..<expected.count:
                assert actual[index] == expected[index]


@test
def process_probe_frame_has_independent_literal_golden() -> void:
    can Memory.Allocate, Abort.Panic:
        observation: Observation = Observation{
            arguments: [[], [97u8, 32u8, 98u8]], cwd: [47u8],
            ruff_bin: EnvironmentValue{present: true, bytes: []},
            marker: EnvironmentValue{present: true, bytes: [120u8]},
            stdin: [0u8, 255u8, 10u8]
        }
        packet: darray[u8] = try expected_stdout(observation) else err:
            assert false
            return
        EsProcessProbeFixture::assert_bytes(packet, [
            69u8, 83u8, 80u8, 82u8, 79u8, 66u8, 69u8, 49u8,
            0u8, 0u8, 0u8, 2u8,
            0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 3u8, 97u8, 32u8, 98u8,
            0u8, 0u8, 0u8, 1u8, 47u8,
            0u8,
            1u8, 0u8, 0u8, 0u8, 0u8,
            1u8, 0u8, 0u8, 0u8, 1u8, 120u8,
            0u8, 0u8, 0u8, 3u8, 0u8, 255u8, 10u8,
            0u8, 255u8
        ])
        EsProcessProbeFixture::assert_bytes(expected_stderr(), [112u8, 114u8, 111u8, 98u8, 101u8, 45u8, 115u8, 116u8, 100u8, 101u8, 114u8, 114u8, 0u8, 255u8])


@test
def process_probe_rejects_impossible_environment_and_nul_argv() -> void:
    can Memory.Allocate, Abort.Panic:
        invalid_environment: Observation = Observation{cwd: [47u8], marker: EnvironmentValue{bytes: [120u8]}}
        rejected_environment: mutable bool = false
        catch expected_stdout(invalid_environment):
            ok _:
                assert false
            error failure:
                rejected_environment <- failure == FrameError.AbsentEnvironmentPayload
        assert rejected_environment
        invalid_argv: Observation = Observation{cwd: [47u8], arguments: [[0u8]]}
        rejected_argv: mutable bool = false
        catch expected_stdout(invalid_argv):
            ok _:
                assert false
            error failure:
                rejected_argv <- failure == FrameError.EmbeddedNul
        assert rejected_argv


@test
def process_probe_argument_limit_and_u32_endianness() -> void:
    can Memory.Allocate, Abort.Panic:
        arguments: mutable darray[darray[u8]] = []
        for _ in 0..<256 |arguments|:
            arguments.push([])
        accepted: Observation = Observation{cwd: [47u8], arguments: arguments}
        packet: darray[u8] = try expected_stdout(accepted) else err:
            assert false
            return
        assert packet[8] == 0u8 and packet[9] == 0u8 and packet[10] == 1u8 and packet[11] == 0u8
        arguments.push([])
        rejected: mutable bool = false
        catch expected_stdout(Observation{cwd: [47u8], arguments: arguments}):
            ok _:
                assert false
            error failure:
                rejected <- failure == FrameError.ArgumentLimit
        assert rejected


@test
def process_probe_exact_aggregate_text_budget_is_admitted() -> void:
    can Memory.Allocate, Abort.Panic:
        text: mutable darray[u8] = []
        for _ in 0..<65535 |text|:
            text.push(120u8)
        accepted: Observation = Observation{cwd: [47u8], arguments: [text]}
        packet: darray[u8] = try expected_stdout(accepted) else err:
            assert false
            return
        assert packet[12] == 0u8 and packet[13] == 0u8 and packet[14] == 255u8 and packet[15] == 255u8
        text.push(120u8)
        rejected: mutable bool = false
        catch expected_stdout(Observation{cwd: [47u8], arguments: [text]}):
            ok _:
                assert false
            error failure:
                rejected <- failure == FrameError.TextLimit
        assert rejected


@test
def process_probe_stdin_limit_preserves_binary_and_full_width_length() -> void:
    can Memory.Allocate, Abort.Panic:
        input: mutable darray[u8] = []
        for _ in 0..<65536 |input|:
            input.push(0u8)
        packet: darray[u8] = try expected_stdout(Observation{cwd: [47u8], stdin: input}) else err:
            assert false
            return
        assert packet.count == 65562
        assert packet[20] == 0u8 and packet[21] == 1u8 and packet[22] == 0u8 and packet[23] == 0u8
        assert packet[24] == 0u8 and packet[packet.count - 2] == 0u8 and packet[packet.count - 1] == 255u8
        input.push(255u8)
        rejected: mutable bool = false
        catch expected_stdout(Observation{cwd: [47u8], stdin: input}):
            ok _:
                assert false
            error failure:
                rejected <- failure == FrameError.StdinLimit
        assert rejected
