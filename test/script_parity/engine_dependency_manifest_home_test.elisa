include "../../ports/elisa-engine/scripts/dependency_manifest_home_model.elisa"

using EsEngineDependencyManifestHome


@test
def dependency_manifest_home_selection_uses_environment_presence() -> void:
    can Memory.Allocate, Abort.Panic:
        unset_home: HomeOverride = HomeOverride{present: false, value_bytes: 0}
        empty_home: HomeOverride = HomeOverride{present: true, value_bytes: 0}
        configured_home: HomeOverride = HomeOverride{present: true, value_bytes: 5}
        assert source(unset_home) == HomeSource.AccountDatabase
        assert source(empty_home) == HomeSource.Environment
        assert source(configured_home) == HomeSource.Environment
