include "../../ports/elisa-engine/scripts/dependency_manifest_home_model.elisa"

using EsEngineDependencyManifestHome


def text_bytes(value: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    output: mutable darray[u8] = []
    for byte in value |output|:
        output.push(byte)
    return output


def expanded_home_matches(home: sview, suffix: sview, expected: sview) -> bool can[Memory.Allocate, Abort.Panic]:
    expanded: mutable sview = ""
    catch append_suffix(text_bytes(home), suffix):
        ok value:
            expanded <- value
        error _:
            return false
    return expanded == expected


@test
def dependency_manifest_home_selection_uses_environment_presence() -> void:
    can Memory.Allocate, Abort.Panic:
        unset_home: HomeOverride = HomeOverride{present: false, value_bytes: 0}
        empty_home: HomeOverride = HomeOverride{present: true, value_bytes: 0}
        configured_home: HomeOverride = HomeOverride{present: true, value_bytes: 5}
        assert source(unset_home) == HomeSource.AccountDatabase
        assert source(empty_home) == HomeSource.Environment
        assert source(configured_home) == HomeSource.Environment


@test
def dependency_manifest_home_suffix_matches_posix_expanduser_joining() -> void:
    can Memory.Allocate, Abort.Panic:
        assert expanded_home_matches("/Users/example///", "/project", "/Users/example/project")
        assert expanded_home_matches("/Users/example/", "", "/Users/example")
        assert expanded_home_matches("", "", "/")
        assert expanded_home_matches("", "/project", "/project")
        assert expanded_home_matches("/", "/project", "/project")
        assert expanded_home_matches("relative/", "/child", "relative/child")

        rejected: mutable bool = false
        catch append_suffix(text_bytes("~other"), "/project"):
            ok _:
                assert false
            error failure:
                rejected <- failure == HomePathError.Unresolved
        assert rejected
