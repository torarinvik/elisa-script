# Gated process parity for Python's csv reader/writer and the C05 Elisascript
# schema/parser/encoder path. Run only through scripts/run_bounded_test.sh.
include "../../src/testing/differential.elisa"
include "../../src/runtime/bounded_text_posix.elisa"

using EsDifferential
using EsBoundedText


module EsCsvIoLauncherParity:
    private:
        const module Commands:
            PYTHON: sview = "/opt/homebrew/bin/python3"
            REFERENCE_SCRIPT: sview = "test/fixtures/script_parity/csv_io/reference.py"
            CANDIDATE_SCRIPT: sview = "test/fixtures/script_parity/csv_io/candidate.elisascript"
            EXPECTED_OUTPUT: sview = "test/fixtures/script_parity/csv_io/expected.txt"
            CONTRACT: sview = "test/fixtures/script_parity/csv_io/CONTRACT.md"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            CONTROLLED_PATH: sview = "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            PYTHON_SHA256: sview = "87d4df53fd91304be5bac391fb204643c36b7df2023c04a0953bcbc7d4fdf634"
            MAX_HASHED_FILE_BYTES: usize = 67108864
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_OUTPUT_BYTES: u64 = 4096
            MAX_GOLDEN_BYTES: usize = 16384
            TIMEOUT_STEPS: u64 = 10000


        const module SourceHashes:
            REFERENCE: sview = "42721e5d3f8040e9a70abdd3c1f8c4516ba5b6c17711b551c8cf095fd0282c86"
            CANDIDATE: sview = "916f7d34cb9a36e772396842740fb7749c01460b986471c11dc15818ec5b59f6"
            EXPECTED: sview = "dfdf9bbf55cfff4f8de75cb51328fa50672c8c8c14feb6c197f36310bbe15fdd"
            CONTRACT: sview = "62f366c8f584967496aaaab2c03d1b84b6ee0314beef6b38e108cc9b5aaade1a"
            ENCODING: sview = "67815c728730d891c2e5fc0cc53a33d672d0f40003cfd468de903c4fbfcd9a53"
            DATA_MODEL: sview = "a2aa9cb5a80ea904f681c1f5e1eb7bf59a0afcf3ee381cd64e8461172dc9eca1"
            JSON_MODEL: sview = "cf6d6c74e0b19c9f5e2e622500e4dd5b6fbeb1b4824355418f0938c06a463947"
            SCHEMA_MODEL: sview = "f23211e692fae835f1b804a42fe42e3b70aad8bc4665e9ac39383d114bd9f780"
            RECORD_NUMERIC: sview = "786fcd7b758cd7e15c470f9c1b63a08b755ba90e604022b9f36d7e1159273d60"
            SCHEMA_NUMERIC: sview = "ceee91c9ad2c5f51be28df0d84f59ac6b3138e9f24ed0e047c4106fab8913b2e"
            CSV_MODEL: sview = "7b87c42bd8d0d1d04d93c377b1c1a74f4b2fe9018b0c2c3106e322d44e9a72f4"
            CSV_MATERIALIZER: sview = "d3741cbfc7706ab7f4b23d4ea9b6014538a24f083bed9572e331c1ac5fbc3ae9"
            CSV_PARSER: sview = "28ec65816dbd81b1e946b68283f5fc33a520f75356338b670f18087ddb6c5708"
            CSV_ENCODER: sview = "6aef3d998aa8c37bb5a60001783eca988621d2936cceedf9802b714cc3293c57"
            SCHEMA_CSV: sview = "806fd22fbac863f45c8e9c6a4f44bf83fa455fc2ff79dea2e1c33d2157a233c2"


        def lowercase_sha256_hex_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def paths_have_sha256(paths: darray[sview], expected_hashes: darray[sview]) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if paths.count == 0 or paths.count != expected_hashes.count or paths.count > 24
            arguments: mutable darray[sview] = ["-a", "256"]
            expected_output: mutable sview = ""
            for index in 0..<paths.count |paths, expected_hashes, arguments, expected_output|:
                path_text: sview = paths[index]
                expected_hex: sview = expected_hashes[index]
                return false if len(expected_hex) != 64
                source_path: Path = path(path_text)
                return false if not is_file(source_path)
                source_size: usize = try file_size(source_path) else err:
                    return false
                return false if source_size == 0 or source_size > Commands::MAX_HASHED_FILE_BYTES
                arguments.push(path_text)
                expected_output <- expected_output + expected_hex + "  " + path_text + "\n"
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "csv-io-parity-source-sha256",
                target: Commands::SHA256_TOOL,
                arguments: arguments,
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false
            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            return hash_run.stdout == expected_output


        def source_set_is_pinned() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            paths: darray[sview] = [Commands::PYTHON, Commands::REFERENCE_SCRIPT, Commands::CANDIDATE_SCRIPT, Commands::EXPECTED_OUTPUT, Commands::CONTRACT, "src/runtime/encoding.elisa", "src/runtime/data_model.elisa", "src/runtime/json_model.elisa", "src/runtime/schema_model.elisa", "src/runtime/record_numeric_model.elisa", "src/runtime/schema_integer_conversion.elisa", "src/runtime/csv_model.elisa", "src/runtime/csv_materializer_model.elisa", "src/runtime/csv_parser_model.elisa", "src/runtime/csv_encode_model.elisa", "src/runtime/schema_csv_materializer.elisa"]
            hashes: darray[sview] = [Commands::PYTHON_SHA256, SourceHashes::REFERENCE, SourceHashes::CANDIDATE, SourceHashes::EXPECTED, SourceHashes::CONTRACT, SourceHashes::ENCODING, SourceHashes::DATA_MODEL, SourceHashes::JSON_MODEL, SourceHashes::SCHEMA_MODEL, SourceHashes::RECORD_NUMERIC, SourceHashes::SCHEMA_NUMERIC, SourceHashes::CSV_MODEL, SourceHashes::CSV_MATERIALIZER, SourceHashes::CSV_PARSER, SourceHashes::CSV_ENCODER, SourceHashes::SCHEMA_CSV]
            return paths_have_sha256(paths, hashes)


        def parity_case_matches(launcher: sview, golden: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference_path: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate_path: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "PYTHONIOENCODING", value: "utf-8"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "python-csv-reader-writer-reference",
                target: Commands::PYTHON,
                arguments: [f"{reference_path}"],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "elisascript-csv-reader-writer-candidate",
                target: launcher,
                arguments: [f"{candidate_path}"],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    print("CSV Python reference process failed")
                    return false
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    print("CSV Elisascript candidate process failed")
                    return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return false if reference_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed or not comparison.equal
            return false if reference_run.exit_status != 0 or candidate_run.exit_status != 0
            return false if reference_run.stdout != golden or candidate_run.stdout != golden
            return reference_run.stderr == "" and candidate_run.stderr == ""


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def public_launcher_parity(launcher: sview, launcher_hash: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            return false if not paths_have_sha256([launcher], [launcher_hash])
            return false if not source_set_is_pinned()
            golden: sview = try EsBoundedText::read_utf8(path(Commands::EXPECTED_OUTPUT), Commands::MAX_GOLDEN_BYTES) else err:
                return false
            return false if not parity_case_matches(launcher, golden)
            return source_set_is_pinned() and paths_have_sha256([launcher], [launcher_hash])


@test
def csv_reader_writer_public_launcher_matches_python_reference_and_golden() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, Directory.Read, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsCsvIoLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsCsvIoLauncherParity::pinned_compiler_path()
        assert launcher != "" and launcher.startswith("/")
        assert EsCsvIoLauncherParity::public_launcher_parity(launcher, launcher_hash)
