# Gated process parity for Python's csv reader/writer, its colocated
# ElisaScript port, and the C05 schema/parser/encoder candidate. Run only
# through scripts/run_bounded_test.sh.
include "../../src/testing/differential.elisa"
include "../../src/runtime/bounded_text_posix.elisa"

using EsDifferential
using EsBoundedText


module EsCsvIoLauncherParity:
    private:
        const module Commands:
            PYTHON: sview = "/opt/homebrew/bin/python3"
            REFERENCE_SCRIPT: sview = "test/fixtures/script_parity/csv_io/reference.py"
            REFERENCE_PORT_SCRIPT: sview = "test/fixtures/script_parity/csv_io/reference.elisascript"
            CANDIDATE_SCRIPT: sview = "test/fixtures/script_parity/csv_io/candidate.elisascript"
            EXPECTED_OUTPUT: sview = "test/fixtures/script_parity/csv_io/expected.txt"
            CONTRACT: sview = "test/fixtures/script_parity/csv_io/CONTRACT.md"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            CONTROLLED_PATH: sview = "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            PYTHON_SHA256: sview = "15c72833c1ffc09bc4e05d1e1866784d126721ad548d9c4d8f943641262535cb"
            MAX_HASHED_FILE_BYTES: usize = 67108864
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_OUTPUT_BYTES: u64 = 4096
            MAX_GOLDEN_BYTES: usize = 16384
            TIMEOUT_STEPS: u64 = 10000


        const module SourceHashes:
            REFERENCE: sview = "42721e5d3f8040e9a70abdd3c1f8c4516ba5b6c17711b551c8cf095fd0282c86"
            REFERENCE_PORT: sview = "4599cc4e6df9b10ca7e26202e304c31a7ccc8175aebfb7face0af4a774fb70ad"
            CANDIDATE: sview = "5b604b757c2e2699594fa2ad9ef03a6c3bdb5067253a3844d4ed335011c4f086"
            EXPECTED: sview = "dfdf9bbf55cfff4f8de75cb51328fa50672c8c8c14feb6c197f36310bbe15fdd"
            CONTRACT: sview = "2224b963ffd23db0d414ee3c2743ecc53ae8f9ce09d89b16f0699d76bdd18ce8"
            ENCODING: sview = "67815c728730d891c2e5fc0cc53a33d672d0f40003cfd468de903c4fbfcd9a53"
            DATA_MODEL: sview = "a2aa9cb5a80ea904f681c1f5e1eb7bf59a0afcf3ee381cd64e8461172dc9eca1"
            JSON_MODEL: sview = "cf6d6c74e0b19c9f5e2e622500e4dd5b6fbeb1b4824355418f0938c06a463947"
            SCHEMA_MODEL: sview = "f23211e692fae835f1b804a42fe42e3b70aad8bc4665e9ac39383d114bd9f780"
            RECORD_NUMERIC: sview = "786fcd7b758cd7e15c470f9c1b63a08b755ba90e604022b9f36d7e1159273d60"
            SCHEMA_NUMERIC: sview = "85aa1285de0f8e1e9c4ac81abc7a3e324ca29ad843023867e101d5794e3d6301"
            CSV_MODEL: sview = "7b87c42bd8d0d1d04d93c377b1c1a74f4b2fe9018b0c2c3106e322d44e9a72f4"
            CSV_MATERIALIZER: sview = "ddc7de68ffbcf18797786f5ebb99016700602dda15df19e1096bf19832e520a4"
            CSV_PARSER: sview = "a585b3cae3666573644929bd5cb1b50ef603bd29fd26d1dd8fb9d0ab31f86f9e"
            CSV_ENCODER: sview = "e92ddaa02a69f0c52fddced6c43fbae2847f5bee3b7c62f952a6c0b06d555266"
            SCHEMA_CSV: sview = "806fd22fbac863f45c8e9c6a4f44bf83fa455fc2ff79dea2e1c33d2157a233c2"
            CORE_RUNTIME_PRELUDE: sview = "9f4f0d5693b7980fdc31f1cf3728463f59fb6f147eb43f4ccbd659c153291696"
            CORE_TEST: sview = "33a2b5afaa001e8aa0e227c38510bb09c639f7d68c4a3f9095f1e55ff0b1c6d6"
            CORE_STORES: sview = "e0e9fc6a64057a8ae568f642d248c6cef4b2a38c967b63531156e527c62f81e9"
            CORE_STORES_CORE: sview = "468fdc503a004a3a83bed2e13317ec52bc956d7c8c4e7343261dce0f943ae600"
            CORE_STORES_TYPES: sview = "e6d2d76f0a656b6b5bf0f8162885fd97ede34d6c900e5d680a242fefb0b33549"
            CORE_STORES_PACKED_ENCODING: sview = "33a45e7d6331f3e4a41dbf4ccc2c093c0de6a97efe08bec58b3a4a18c77350ea"
            CORE_STORES_PACKED_DENSE: sview = "f3f27f531b9531ffb5d19493bfb658fadf550e7bc2af7bc9c7b2349e85aaae55"
            CORE_STORES_ROWS: sview = "be2b00499778b690ea12770bcf18178a722ab26b5506c760c05de9196408ef84"
            CORE_STORES_PACKED_SPARSE: sview = "4f301ab393f48314db1b8c844c2fe1c947c2f76a90d6f69d991f360e311bd339"
            CORE_STORES_PACKED_AOS: sview = "7f4601591c2a83f490cac6078b259f50abec2f41f2abd55421af07780fd1e5d7"
            CORE_RUNTIME_STRINGS: sview = "edc880ce62848db8bbb185edd212dd43ad30d386eebf482891f0bff911290335"
            CORE_RUNTIME: sview = "91fd412f216e720df22d04664644c9085f164dc8058169ef146d29fb6c2858f0"


        def lowercase_sha256_hex_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def paths_have_sha256(paths: darray[sview], expected_hashes: darray[sview]) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if paths.count == 0 or paths.count != expected_hashes.count or paths.count > 32
            arguments: mutable darray[sview] = ["-a", "256"]
            expected_output: mutable sview = ""
            for index in 0..<paths.count |paths, expected_hashes, arguments, expected_output|:
                path_text: sview = paths[index]
                expected_hex: sview = expected_hashes[index]
                return false if len(expected_hex) != 64
                source_path: Path = path(path_text)
                return false if not is_file(source_path)
                source_size: usize = try file_size(source_path) else err:
                    return false
                return false if source_size == 0 or source_size > Commands::MAX_HASHED_FILE_BYTES
                arguments.push(path_text)
                expected_output <- expected_output + expected_hex + "  " + path_text + "\n"
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "csv-io-parity-source-sha256",
                target: Commands::SHA256_TOOL,
                arguments: arguments,
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false
            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            return hash_run.stdout == expected_output


        def source_set_is_pinned() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            paths: darray[sview] = [Commands::PYTHON, Commands::REFERENCE_SCRIPT, Commands::REFERENCE_PORT_SCRIPT, Commands::CANDIDATE_SCRIPT, Commands::EXPECTED_OUTPUT, Commands::CONTRACT, "src/runtime/encoding.elisa", "src/runtime/data_model.elisa", "src/runtime/json_model.elisa", "src/runtime/schema_model.elisa", "src/runtime/record_numeric_model.elisa", "src/runtime/schema_integer_conversion.elisa", "src/runtime/csv_model.elisa", "src/runtime/csv_materializer_model.elisa", "src/runtime/csv_parser_model.elisa", "src/runtime/csv_encode_model.elisa", "src/runtime/schema_csv_materializer.elisa", "vendor/elisa-compiler/elisacore_std/elisacore_runtime_prelude.elisa", "vendor/elisa-compiler/elisacore_std/test.elisa", "vendor/elisa-compiler/elisacore_std/stores.elisa", "vendor/elisa-compiler/elisacore_std/stores_core.elisa", "vendor/elisa-compiler/elisacore_std/stores_types.elisa", "vendor/elisa-compiler/elisacore_std/stores_packed_encoding.elisa", "vendor/elisa-compiler/elisacore_std/stores_packed_dense.elisa", "vendor/elisa-compiler/elisacore_std/stores_rows.elisa", "vendor/elisa-compiler/elisacore_std/stores_packed_sparse.elisa", "vendor/elisa-compiler/elisacore_std/stores_packed_aos.elisa", "vendor/elisa-compiler/elisacore_std/elisacore_runtime_strings.elisa", "vendor/elisa-compiler/elisacore_std/runtime.elisa"]
            hashes: darray[sview] = [Commands::PYTHON_SHA256, SourceHashes::REFERENCE, SourceHashes::REFERENCE_PORT, SourceHashes::CANDIDATE, SourceHashes::EXPECTED, SourceHashes::CONTRACT, SourceHashes::ENCODING, SourceHashes::DATA_MODEL, SourceHashes::JSON_MODEL, SourceHashes::SCHEMA_MODEL, SourceHashes::RECORD_NUMERIC, SourceHashes::SCHEMA_NUMERIC, SourceHashes::CSV_MODEL, SourceHashes::CSV_MATERIALIZER, SourceHashes::CSV_PARSER, SourceHashes::CSV_ENCODER, SourceHashes::SCHEMA_CSV, SourceHashes::CORE_RUNTIME_PRELUDE, SourceHashes::CORE_TEST, SourceHashes::CORE_STORES, SourceHashes::CORE_STORES_CORE, SourceHashes::CORE_STORES_TYPES, SourceHashes::CORE_STORES_PACKED_ENCODING, SourceHashes::CORE_STORES_PACKED_DENSE, SourceHashes::CORE_STORES_ROWS, SourceHashes::CORE_STORES_PACKED_SPARSE, SourceHashes::CORE_STORES_PACKED_AOS, SourceHashes::CORE_RUNTIME_STRINGS, SourceHashes::CORE_RUNTIME]
            return paths_have_sha256(paths, hashes)


        def parity_case_matches(launcher: sview, golden: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference_path: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            reference_port_path: Path = try path_real(path(Commands::REFERENCE_PORT_SCRIPT)) else err:
                return false
            candidate_path: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "PYTHONIOENCODING", value: "utf-8"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "python-csv-reader-writer-reference",
                target: Commands::PYTHON,
                arguments: [f"{reference_path}"],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_extra_argv_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "python-csv-reference-ignores-extra-argv",
                target: Commands::PYTHON,
                arguments: [f"{reference_path}", "--ignored", ""],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_port_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "elisascript-csv-reader-writer-reference-port",
                target: launcher,
                arguments: [f"{reference_port_path}"],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_port_extra_argv_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "elisascript-csv-reference-port-ignores-extra-argv",
                target: launcher,
                arguments: [f"{reference_port_path}", "--ignored", ""],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "elisascript-csv-reader-writer-candidate",
                target: launcher,
                arguments: [f"{candidate_path}"],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            reference_extra_argv_run: mutable DifferentialRun = DifferentialRun{observations: []}
            reference_port_run: mutable DifferentialRun = DifferentialRun{observations: []}
            reference_port_extra_argv_run: mutable DifferentialRun = DifferentialRun{observations: []}
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    print("CSV Python reference process failed")
                    return false
            catch run_differential_process(reference_extra_argv_runner):
                ok value:
                    reference_extra_argv_run <- value
                error failure:
                    print("CSV Python reference extra-argv process failed")
                    return false
            catch run_differential_process(reference_port_runner):
                ok value:
                    reference_port_run <- value
                error failure:
                    print("CSV ElisaScript reference port process failed")
                    return false
            catch run_differential_process(reference_port_extra_argv_runner):
                ok value:
                    reference_port_extra_argv_run <- value
                error failure:
                    print("CSV ElisaScript reference port extra-argv process failed")
                    return false
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    print("CSV Elisascript candidate process failed")
                    return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            port_comparison: DifferentialComparison = compare_differential_runs(reference_run, reference_port_run)
            extra_argv_comparison: DifferentialComparison = compare_differential_runs(reference_extra_argv_run, reference_port_extra_argv_run)
            return false if reference_run.outcome != DifferentialRunOutcome.Completed or reference_port_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed or reference_extra_argv_run.outcome != DifferentialRunOutcome.Completed or reference_port_extra_argv_run.outcome != DifferentialRunOutcome.Completed or not comparison.equal or not port_comparison.equal or not extra_argv_comparison.equal
            return false if reference_run.exit_status != 0 or candidate_run.exit_status != 0
            return false if reference_port_run.exit_status != 0
            return false if reference_extra_argv_run.exit_status != 0 or reference_port_extra_argv_run.exit_status != 0
            return false if reference_run.stdout != golden or reference_port_run.stdout != golden or candidate_run.stdout != golden or reference_extra_argv_run.stdout != golden or reference_port_extra_argv_run.stdout != golden
            return reference_run.stderr == "" and reference_port_run.stderr == "" and candidate_run.stderr == "" and reference_extra_argv_run.stderr == "" and reference_port_extra_argv_run.stderr == ""


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def public_launcher_parity(launcher: sview, launcher_hash: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            return false if not paths_have_sha256([launcher], [launcher_hash])
            return false if not source_set_is_pinned()
            golden: sview = try EsBoundedText::read_utf8_path_text(f"{path(Commands::EXPECTED_OUTPUT)}", Commands::MAX_GOLDEN_BYTES) else err:
                return false
            return false if not parity_case_matches(launcher, golden)
            return source_set_is_pinned() and paths_have_sha256([launcher], [launcher_hash])


@test
def csv_reader_writer_public_launcher_matches_python_reference_port_candidate_and_golden() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, Directory.Read, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsCsvIoLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsCsvIoLauncherParity::pinned_compiler_path()
        assert launcher != "" and launcher.startswith("/")
        assert EsCsvIoLauncherParity::public_launcher_parity(launcher, launcher_hash)
