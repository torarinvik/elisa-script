# Gated public-launcher parity matrix for the differential filesystem source audit.
# Run only through scripts/run_bounded_test.sh after explicit reauthorization.
# This fixture compares the shell reference with the Elisascript candidate in
# private temporary roots; it never mutates the checkout's audited source files.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsDifferentialFilesystemAuditLauncherParity:
    private:
        const module Commands:
            REFERENCE_SHELL: sview = "/bin/bash"
            REFERENCE_SCRIPT: sview = "scripts/check_differential_filesystem.sh"
            CANDIDATE_SCRIPT: sview = "scripts/check_differential_filesystem.elisascript"
            BOUNDED_READER: sview = "src/runtime/bounded_text_posix.elisa"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            RG_TOOL: sview = "/opt/homebrew/bin/rg"
            TRUNCATE_TOOL: sview = "/usr/bin/truncate"
            CONTROLLED_PATH: sview = "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            REFERENCE_SHA256: sview = "e9853e41140b2454ddf8bb6d9dcb500bc738822f1c6c0c65e004f0c50d39870a"
            CANDIDATE_SHA256: sview = "ad5ea18c9684c617f5a92ac164a4036d3d325530ca5b0a7f980f73356ca1603d"
            BOUNDED_READER_SHA256: sview = "f648d319aca3610e245452d681c21556cc58a774982ea8d0bbda2cca4f1823be"
            RG_TOOL_SHA256: sview = "1c57905960cd69dbb5b05492560957f4a57cdd4d39137e20de23981c6e1f4423"
            TRUNCATE_TOOL_SHA256: sview = "04d727297ee22fb6f42bfb6eaeebe5b19d6444d0e5ac2b3419a05c3f1118bf9b"
            MAX_HASHED_FILE_BYTES: usize = 67108864
            MAX_FIXTURE_SOURCE_BYTES: usize = 1048576
            MAX_FIXTURE_TOTAL_BYTES: usize = 4194304
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_OUTPUT_BYTES: u64 = 1048576
            TIMEOUT_STEPS: u64 = 10000
        struct TemporaryRoot:
            path: Path
            created: bool = false
            files: darray[Path] = []
            directories: darray[Path] = []


        struct RootInput:
            relative_path: sview


        def lowercase_sha256_hex_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def file_has_sha256(path_text: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            source_path: Path = path(path_text)
            return false if not is_file(source_path)
            source_size: usize = try file_size(source_path) else err:
                return false
            return false if source_size == 0 or source_size > Commands::MAX_HASHED_FILE_BYTES
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "differential-filesystem-audit-source-sha256",
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", path_text],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false
            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            return false if hash_run.stdout != expected_hex + "  " + path_text + "\n"
            for index in 0..<64 |hash_run, expected_hex|:
                return false if not lowercase_sha256_hex_byte(sview_at(expected_hex, index))
            return true


        def source_set_is_pinned() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return file_has_sha256(Commands::REFERENCE_SCRIPT, Commands::REFERENCE_SHA256) and file_has_sha256(Commands::CANDIDATE_SCRIPT, Commands::CANDIDATE_SHA256) and file_has_sha256(Commands::BOUNDED_READER, Commands::BOUNDED_READER_SHA256) and file_has_sha256(Commands::RG_TOOL, Commands::RG_TOOL_SHA256) and file_has_sha256(Commands::TRUNCATE_TOOL, Commands::TRUNCATE_TOOL_SHA256)


        def launcher_case_matches(launcher: sview, reference_path: Path, candidate_path: Path, expected_status: i64, expected_stdout: sview, expected_stderr: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "shell-differential-filesystem-audit-reference",
                target: Commands::REFERENCE_SHELL,
                arguments: [f"{reference_path}"],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-differential-filesystem-audit",
                target: launcher,
                arguments: [f"{candidate_path}"],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    print("differential filesystem shell reference process failed")
                    return false
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    print("differential filesystem Elisascript process failed")
                    return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return false if reference_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed or not comparison.equal
            return false if reference_run.exit_status != expected_status or reference_run.stdout != expected_stdout or reference_run.stderr != expected_stderr
            return false if candidate_run.exit_status != expected_status or candidate_run.stdout != expected_stdout or candidate_run.stderr != expected_stderr
            return true


        def write_fixture_text(target: Path, contents: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            written: usize = try write_text(target, contents) else 0u64
            return written == len(contents)


        def create_sparse_file(target_path: Path, size_text: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "create-sparse-differential-filesystem-audit-input",
                target: Commands::TRUNCATE_TOOL,
                arguments: ["-s", size_text, f"{target_path}"],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            process_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(runner):
                ok value:
                    process_run <- value
                error failure:
                    return false
            return process_run.outcome == DifferentialRunOutcome.Completed and process_run.exit_status == 0 and process_run.stdout == "" and process_run.stderr == ""


        def remove_fixture_path(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            return try remove_path(target) else false


        def remove_fixture_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try remove_directory(target) else false


        def remove_temporary_root(temporary: TemporaryRoot) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return true if not temporary.created
            cleanup_ok: mutable bool = true
            for index in 0..<temporary.files.count |temporary, cleanup_ok|:
                cleanup_ok <- remove_fixture_path(temporary.files[temporary.files.count - index - 1]) and cleanup_ok
            for index in 0..<temporary.directories.count |temporary, cleanup_ok|:
                cleanup_ok <- remove_fixture_directory(temporary.directories[temporary.directories.count - index - 1]) and cleanup_ok
            return remove_fixture_directory(temporary.path) and cleanup_ok


        def write_tracked_text(temporary: mutable TemporaryRoot&, relative_path: sview, contents: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            target: Path = path_join(temporary.path, relative_path)
            temporary.files.push(target)
            return write_fixture_text(target, contents)


        def create_fixture_root() -> TemporaryRoot can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary_path: Path = try temp_directory("elisascript-differential-filesystem-audit-parity") else err:
                return TemporaryRoot{path: path("."), created: false}
            root: Path = try path_real(temporary_path) else err:
                _ = remove_fixture_directory(temporary_path)
                return TemporaryRoot{path: path("."), created: false}
            temporary: mutable TemporaryRoot = TemporaryRoot{path: root, created: true}
            directory_paths: darray[Path] = [
                root.joinpath("scripts"),
                root.joinpath("src"),
                root.joinpath("src").joinpath("runtime"),
                root.joinpath("src").joinpath("testing"),
                root.joinpath("src").joinpath("ir"),
                root.joinpath("test"),
                root.joinpath("test").joinpath("differential"),
                root.joinpath("docs")
            ]
            for directory in directory_paths |temporary|:
                created: bool = try create_directory(directory) else false
                if not created:
                    _ = remove_temporary_root(temporary)
                    return TemporaryRoot{path: path("."), created: false}
                temporary.directories.push(directory)

            inputs: darray[RootInput] = [
                RootInput{relative_path: "scripts/check_differential_filesystem.sh"},
                RootInput{relative_path: "scripts/check_differential_filesystem.elisascript"},
                RootInput{relative_path: "src/runtime/bounded_text_posix.elisa"},
                RootInput{relative_path: "src/runtime/encoding.elisa"},
                RootInput{relative_path: "src/runtime/file_posix.elisa"},
                RootInput{relative_path: "src/runtime/directory_posix.elisa"},
                RootInput{relative_path: "src/runtime/stdio_posix.elisa"}
            ]
            total_bytes: mutable usize = 0
            for input in inputs |inputs, total_bytes|:
                source_path: Path = path(input.relative_path)
                source_size: usize = try file_size(source_path) else err:
                    _ = remove_temporary_root(temporary)
                    return TemporaryRoot{path: path("."), created: false}
                if not is_file(source_path) or source_size > Commands::MAX_FIXTURE_SOURCE_BYTES or source_size > Commands::MAX_FIXTURE_TOTAL_BYTES - total_bytes:
                    _ = remove_temporary_root(temporary)
                    return TemporaryRoot{path: path("."), created: false}
                total_bytes <- total_bytes + source_size

            for input in inputs |inputs, temporary|:
                source_path: Path = path(input.relative_path)
                source_size: usize = try file_size(source_path) else err:
                    _ = remove_temporary_root(temporary)
                    return TemporaryRoot{path: path("."), created: false}
                contents: sview = try EsBoundedText::read_utf8(source_path, source_size) else err:
                    _ = remove_temporary_root(temporary)
                    return TemporaryRoot{path: path("."), created: false}
                current_size: usize = try file_size(source_path) else err:
                    _ = remove_temporary_root(temporary)
                    return TemporaryRoot{path: path("."), created: false}
                if current_size != source_size or len(contents) != source_size:
                    _ = remove_temporary_root(temporary)
                    return TemporaryRoot{path: path("."), created: false}
                destination: Path = path_join(root, input.relative_path)
                temporary.files.push(destination)
                if not write_fixture_text(destination, contents):
                    _ = remove_temporary_root(temporary)
                    return TemporaryRoot{path: path("."), created: false}

            copied_reference_path: Path = root.joinpath("scripts").joinpath("check_differential_filesystem.sh")
            copied_candidate_path: Path = root.joinpath("scripts").joinpath("check_differential_filesystem.elisascript")
            copied_reader_path: Path = root.joinpath("src").joinpath("runtime").joinpath("bounded_text_posix.elisa")
            copied_reference: sview = f"{copied_reference_path}"
            copied_candidate: sview = f"{copied_candidate_path}"
            copied_reader: sview = f"{copied_reader_path}"
            if not file_has_sha256(copied_reference, Commands::REFERENCE_SHA256) or not file_has_sha256(copied_candidate, Commands::CANDIDATE_SHA256) or not file_has_sha256(copied_reader, Commands::BOUNDED_READER_SHA256):
                _ = remove_temporary_root(temporary)
                return TemporaryRoot{path: path("."), created: false}
            return temporary


        def checked_in_success_matches(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference_path: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate_path: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            return launcher_case_matches(launcher, reference_path, candidate_path, 0, "differential filesystem audit: bounded exact payload snapshots, valid tree ancestors, fingerprints, and first-difference comparison are present\n", "")


        def generated_failure_cases_match(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary: TemporaryRoot = try create_fixture_root()
            return false if not temporary.created
            reference_path: Path = temporary.path.joinpath("scripts").joinpath("check_differential_filesystem.sh")
            candidate_path: Path = temporary.path.joinpath("scripts").joinpath("check_differential_filesystem.elisascript")
            model_path: Path = temporary.path.joinpath("src").joinpath("testing").joinpath("filesystem_snapshot_model.elisa")
            consumer_path: Path = temporary.path.joinpath("src").joinpath("testing").joinpath("differential.elisa")
            ir_path: Path = temporary.path.joinpath("src").joinpath("ir").joinpath("ir.elisa")
            fixture_path: Path = temporary.path.joinpath("test").joinpath("differential").joinpath("elisascript_differential_test.elisa")
            docs_path: Path = temporary.path.joinpath("docs").joinpath("differential-testing.md")
            expected_missing_model: sview = "differential filesystem audit: missing " + f"{model_path}" + "\n"
            matched: mutable bool = launcher_case_matches(launcher, reference_path, candidate_path, 1, "", expected_missing_model)
            if matched:
                matched <- write_tracked_text(temporary, "src/testing/filesystem_snapshot_model.elisa", "module EsDifferentialFilesystem:\n") and launcher_case_matches(launcher, reference_path, candidate_path, 1, "", "differential filesystem audit: missing " + f"{consumer_path}" + "\n")
            if matched:
                matched <- write_tracked_text(temporary, "src/testing/differential.elisa", "include \"./filesystem_snapshot_model.elisa\"\n") and launcher_case_matches(launcher, reference_path, candidate_path, 1, "", "differential filesystem audit: missing " + f"{ir_path}" + "\n")
            if matched:
                matched <- write_tracked_text(temporary, "src/ir/ir.elisa", "include \"../runtime/hash_model.elisa\"\n") and launcher_case_matches(launcher, reference_path, candidate_path, 1, "", "differential filesystem audit: missing " + f"{fixture_path}" + "\n")
            if matched:
                matched <- write_tracked_text(temporary, "test/differential/elisascript_differential_test.elisa", "using EsDifferentialFilesystem\n") and launcher_case_matches(launcher, reference_path, candidate_path, 1, "", "differential filesystem audit: missing " + f"{docs_path}" + "\n")
            if matched:
                matched <- write_tracked_text(temporary, "docs/differential-testing.md", "EsDifferentialFilesystem::DifferentialFilesystemSnapshot\n") and launcher_case_matches(launcher, reference_path, candidate_path, 1, "", "")
            if matched:
                over_limit_created: bool = create_sparse_file(model_path, "16777217")
                expected_limit: sview = "differential filesystem audit: source exceeds audit limit: " + f"{model_path}" + "\n"
                matched <- over_limit_created and launcher_case_matches(launcher, reference_path, candidate_path, 2, "", expected_limit)
            if matched:
                aggregate_created: bool = create_sparse_file(model_path, "16777216") and create_sparse_file(consumer_path, "16777216")
                expected_aggregate: sview = "differential filesystem audit: source exceeds audit limit: " + f"{ir_path}" + "\n"
                matched <- aggregate_created and launcher_case_matches(launcher, reference_path, candidate_path, 2, "", expected_aggregate)
            cleanup_ok: bool = remove_temporary_root(temporary)
            return matched and cleanup_ok


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def public_launcher_parity(launcher: sview, launcher_hash: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            return false if not file_has_sha256(launcher, launcher_hash)
            return false if not source_set_is_pinned()
            return false if not checked_in_success_matches(launcher)
            return false if not generated_failure_cases_match(launcher)
            return source_set_is_pinned() and file_has_sha256(launcher, launcher_hash)


@test
def differential_filesystem_audit_public_launcher_matches_pinned_shell_reference() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsDifferentialFilesystemAuditLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsDifferentialFilesystemAuditLauncherParity::pinned_compiler_path()
        assert launcher != "" and launcher.startswith("/")
        assert EsDifferentialFilesystemAuditLauncherParity::public_launcher_parity(launcher, launcher_hash)
