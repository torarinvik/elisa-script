# Process-level parity for the A01 builtin-surface audit. Run from the
# repository root through the bounded wrapper after explicit reauthorization.
# The harness reads only checked-in source fixtures and bounded generated text;
# it never runs code from those fixture trees. The launcher digest is supplied
# by the caller and does not attest to source/build provenance.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsBuiltinSurfaceLauncherParity:
    private:
        const module Commands:
            REFERENCE_SHELL: sview = "/bin/bash"
            REFERENCE_SCRIPT: sview = "scripts/check_builtin_surface.sh"
            CANDIDATE_SCRIPT: sview = "scripts/check_builtin_surface.elisascript"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            CONTROLLED_PATH: sview = "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            MAX_LAUNCHER_BYTES: usize = 67108864
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_OUTPUT_BYTES: u64 = 1048576
            TIMEOUT_STEPS: u64 = 10000


        struct ExpectedCase:
            arguments: darray[sview]
            exit_status: i64
            stdout: sview
            stderr: sview
            working_directory: sview = ""
            check_golden: bool = true


        struct TemporaryDirectory:
            path: Path
            created: bool = false


        def make_temporary_directory(prefix: sview) -> TemporaryDirectory can[Memory.Allocate, Abort.Panic, File.Write]:
            created_path: Path = try temp_directory(prefix) else err:
                return TemporaryDirectory{path: path("."), created: false}
            return TemporaryDirectory{path: created_path, created: true}


        def create_fixture_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try create_directory(target) else false


        def write_fixture_text(target: Path, contents: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            written: usize = try write_text(target, contents) else 0u64
            return written == len(contents)


        def write_fixture_bytes(target: Path, contents: darray[u8]) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            written: usize = try write_bytes(target, contents) else 0u64
            return written == contents.count


        def remove_fixture_path(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            return try remove_path(target) else false


        def remove_fixture_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try remove_directory(target) else false


        def lowercase_sha256_hex_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def launcher_has_expected_sha256(launcher: sview, expected_hex: sview) -> bool can[Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            launcher_path: Path = path(launcher)
            return false if not is_file(launcher_path)
            launcher_size: usize = try file_size(launcher_path) else err:
                return false
            return false if launcher_size == 0 or launcher_size > Commands::MAX_LAUNCHER_BYTES

            hash_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-builtin-surface-sha256",
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", launcher],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(hash_runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false

            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            return false if hash_run.stdout != expected_hex + "  " + launcher + "\n"
            for index in 0..<64 |hash_run, expected_hex|:
                return false if not lowercase_sha256_hex_byte(sview_at(expected_hex, index))
            return true


        def launcher_case_matches(launcher: sview, test_case: ExpectedCase) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference_script_path: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate_script_path: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false

            reference_arguments: mutable darray[sview] = [f"{reference_script_path}"]
            candidate_arguments: mutable darray[sview] = [f"{candidate_script_path}"]
            for argument in test_case.arguments |reference_arguments, candidate_arguments|:
                reference_arguments.push(argument)
                candidate_arguments.push(argument)

            controlled_environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "shell-builtin-surface-reference",
                target: Commands::REFERENCE_SHELL,
                arguments: reference_arguments,
                working_directory: test_case.working_directory,
                environment: controlled_environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    print("builtin surface reference process failed")
                    return false

            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-builtin-surface",
                target: launcher,
                arguments: candidate_arguments,
                working_directory: test_case.working_directory,
                environment: controlled_environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    print("builtin surface Elisascript process failed")
                    return false

            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            if reference_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed or not comparison.equal:
                print("builtin surface process parity mismatch")
                return false
            if test_case.check_golden:
                if reference_run.exit_status != test_case.exit_status or reference_run.stdout != test_case.stdout or reference_run.stderr != test_case.stderr:
                    print("builtin surface shell reference golden mismatch")
                    return false
                if candidate_run.exit_status != test_case.exit_status or candidate_run.stdout != test_case.stdout or candidate_run.stderr != test_case.stderr:
                    print("builtin surface Elisascript golden mismatch")
                    return false
            return true


        def generated_resource_cases_match(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary: TemporaryDirectory = make_temporary_directory("elisascript builtin;surface [limits] ")
            return false if not temporary.created

            root_path: Path = try path_real(temporary.path) else err:
                temporary.path
            root_text: sview = f"{root_path}"
            vendor_path: Path = root_path.joinpath("vendor")
            compiler_path: Path = vendor_path.joinpath("elisa-compiler")
            source_path: Path = compiler_path.joinpath("src")
            semantic_directory: Path = source_path.joinpath("semantic")
            directories: darray[Path] = [vendor_path, compiler_path, source_path, semantic_directory]
            created_directories: mutable darray[Path] = []
            files_to_remove: mutable darray[Path] = []
            setup_ok: mutable bool = true
            missing_semantic_path: sview = root_text + "/vendor/elisa-compiler/src/semantic/symbols.elisa"
            missing_source_case: ExpectedCase = ExpectedCase{
                arguments: [root_text],
                exit_status: 2i64,
                stdout: "",
                stderr: "builtin surface: missing source file: " + missing_semantic_path + "\n"
            }
            setup_ok <- launcher_case_matches(launcher, missing_source_case)

            for directory in directories |created_directories, setup_ok|:
                if create_fixture_directory(directory):
                    created_directories.push(directory)
                else:
                    setup_ok <- false

            semantic_file: Path = semantic_directory.joinpath("symbols.elisa")
            registry_file: Path = semantic_directory.joinpath("builtin_registry.elisa")
            lowerer_directory: Path = root_path.joinpath("src").joinpath("ir")
            lowerer_parent: Path = root_path.joinpath("src")
            lowerer_file: Path = lowerer_directory.joinpath("lower_ast.elisa")
            for directory in [lowerer_parent, lowerer_directory] |created_directories, setup_ok|:
                if create_fixture_directory(directory):
                    created_directories.push(directory)
                else:
                    setup_ok <- false

            files_to_remove.push(registry_file)
            if not write_fixture_text(registry_file, "def typed_builtin_names() -> darray[sview]:\n    return []\n        def typed_builtin_spec(name: sview) -> BuiltinSpec:\n            return unknown_builtin_spec()\n"):
                setup_ok <- false
            files_to_remove.push(lowerer_file)
            if not write_fixture_text(lowerer_file, ""):
                setup_ok <- false
            files_to_remove.push(semantic_file)

            oversized_source: mutable darray[u8] = []
            for _ in 0..<1048577 |oversized_source|:
                oversized_source.push(120u8)
            if not write_fixture_bytes(semantic_file, oversized_source):
                setup_ok <- false

            if setup_ok:
                oversized_path: Path = try path_real(semantic_file) else err:
                    semantic_file
                oversized_case: ExpectedCase = ExpectedCase{
                    arguments: [root_text],
                    exit_status: 2i64,
                    stdout: "",
                    stderr: "builtin surface: source file exceeds audit limit: " + f"{oversized_path}" + "\n"
                }
                setup_ok <- launcher_case_matches(launcher, oversized_case)

                setup_ok <- remove_fixture_path(semantic_file) and setup_ok
                excessive_names: mutable darray[u8] = []
                for byte in "names: darray[sview] = [" |excessive_names|:
                    excessive_names.push(byte)
                for _ in 0..<65537 |excessive_names|:
                    excessive_names.push(34u8)
                    excessive_names.push(120u8)
                    excessive_names.push(34u8)
                    excessive_names.push(44u8)
                excessive_names.push(93u8)
                excessive_names.push(10u8)
                if not write_fixture_bytes(semantic_file, excessive_names):
                    setup_ok <- false
                else:
                    name_limit_case: ExpectedCase = ExpectedCase{
                        arguments: [root_text],
                        exit_status: 2i64,
                        stdout: "",
                        stderr: "builtin surface: identifier match count exceeds audit limit\n"
                    }
                    setup_ok <- launcher_case_matches(launcher, name_limit_case) and setup_ok

            cleanup_ok: mutable bool = true
            for file_path in files_to_remove |cleanup_ok|:
                if is_file(file_path) or is_symlink(file_path):
                    cleanup_ok <- remove_fixture_path(file_path) and cleanup_ok
            directory_index: mutable usize = created_directories.count
            while directory_index > 0 |created_directories, cleanup_ok, directory_index|:
                directory_index <- directory_index - 1
                cleanup_ok <- remove_fixture_directory(created_directories[directory_index]) and cleanup_ok
            root_removed: bool = remove_fixture_directory(root_path)
            return setup_ok and cleanup_ok and root_removed


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def all_launcher_cases_match(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            positive_root: Path = try path_real(path("test/fixtures/script_parity/builtin_surface/positive")) else err:
                return false
            missing_registry_root: Path = try path_real(path("test/fixtures/script_parity/builtin_surface/missing_registry_row")) else err:
                return false
            mismatched_root: Path = try path_real(path("test/fixtures/script_parity/builtin_surface/mismatched_consumer")) else err:
                return false

            positive_argument: sview = f"{positive_root}/"
            missing_registry_argument: sview = f"{missing_registry_root}"
            mismatched_argument: sview = f"{mismatched_root}"
            cases: darray[ExpectedCase] = [
                ExpectedCase{
                    arguments: ["/"],
                    exit_status: 0i64,
                    stdout: "",
                    stderr: "",
                    check_golden: false
                },
                ExpectedCase{
                    arguments: [],
                    exit_status: 0i64,
                    stdout: "",
                    stderr: "",
                    working_directory: "/",
                    check_golden: false
                },
                ExpectedCase{
                    arguments: [positive_argument],
                    exit_status: 0i64,
                    stdout: "semantic_seed_count\t8\nlowerer_global_count\t1\nbuiltin surface audit: semantic seeds cover all direct global spellings; registry identity handles global lowering\n",
                    stderr: ""
                },
                ExpectedCase{
                    arguments: [missing_registry_argument],
                    exit_status: 1i64,
                    stdout: "semantic_seed_count\t1\nlowerer_global_count\t1\n",
                    stderr: "missing_registry_row\tlegacy_call\n"
                },
                ExpectedCase{
                    arguments: [mismatched_argument],
                    exit_status: 1i64,
                    stdout: "semantic_seed_count\t2\nlowerer_global_count\t1\n",
                    stderr: "missing_registry_row\tunregistered_call\nmissing_semantic_seed\tunregistered_call\n"
                },
                ExpectedCase{
                    arguments: [""],
                    exit_status: 2i64,
                    stdout: "",
                    stderr: "usage: builtin surface audit [source-root]\n"
                },
                ExpectedCase{
                    arguments: [positive_argument, "unexpected"],
                    exit_status: 2i64,
                    stdout: "",
                    stderr: "usage: builtin surface audit [source-root]\n"
                }
            ]
            for test_case in cases:
                return false if not launcher_case_matches(launcher, test_case)
            return generated_resource_cases_match(launcher)


@test
def builtin_surface_public_launcher_matches_shell_and_golden_output() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsBuiltinSurfaceLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsBuiltinSurfaceLauncherParity::pinned_compiler_path()
        assert launcher != ""
        assert launcher.startswith("/")
        assert EsBuiltinSurfaceLauncherParity::launcher_has_expected_sha256(launcher, launcher_hash)
        print("public_launcher_path=" + launcher)
        print("public_launcher_sha256=" + launcher_hash)
        assert EsBuiltinSurfaceLauncherParity::all_launcher_cases_match(launcher)
        assert EsBuiltinSurfaceLauncherParity::launcher_has_expected_sha256(launcher, launcher_hash)
