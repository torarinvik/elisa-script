# Unit fixtures for the inventory checker's AWK root-manifest contract.
include "../../scripts/check_migration_inventory.elisascript"

using EsMigrationInventoryAudit


@test
def migration_inventory_manifest_records_match_awk_validation() -> void:
    can Memory.Allocate, Abort.Panic:
        valid: sview = "# name\trelative_path\towner\treview_status\nitem\tgroup/item\tunassigned\treviewed\nother\tother\tteam\tblocked\n"
        crlf_records: sview = "# name\trelative_path\towner\treview_status\r\nitem\titem\towner\tpending\r\n"
        bad_count: sview = "# name\trelative_path\towner\treview_status\nitem\tpath\towner\tpending\textra\n"
        empty_field: sview = "# name\trelative_path\towner\treview_status\nitem\tpath\t\tpending\n"
        absolute_path: sview = "# name\trelative_path\towner\treview_status\nitem\t/absolute\towner\tpending\n"
        parent_component: sview = "# name\trelative_path\towner\treview_status\nitem\tgroup/../item\towner\tpending\n"
        dot_prefix: sview = "# name\trelative_path\towner\treview_status\nitem\t./item\towner\tpending\n"
        invalid_status: sview = "# name\trelative_path\towner\treview_status\nitem\tpath\towner\tunknown\n"
        duplicate_name: sview = "# name\trelative_path\towner\treview_status\nitem\tfirst\towner\tpending\nitem\tsecond\towner\tblocked\n"
        duplicate_path: sview = "# name\trelative_path\towner\treview_status\nfirst\tshared\towner\tpending\nsecond\tshared\towner\tblocked\n"
        no_data: sview = "# name\trelative_path\towner\treview_status\n"
        assert EsMigrationInventoryAudit::validate_root_manifest_records(valid)
        assert not EsMigrationInventoryAudit::validate_root_manifest_records(crlf_records)
        assert not EsMigrationInventoryAudit::validate_root_manifest_records(bad_count)
        assert not EsMigrationInventoryAudit::validate_root_manifest_records(empty_field)
        assert not EsMigrationInventoryAudit::validate_root_manifest_records(absolute_path)
        assert not EsMigrationInventoryAudit::validate_root_manifest_records(parent_component)
        assert not EsMigrationInventoryAudit::validate_root_manifest_records(dot_prefix)
        assert not EsMigrationInventoryAudit::validate_root_manifest_records(invalid_status)
        assert not EsMigrationInventoryAudit::validate_root_manifest_records(duplicate_name)
        assert not EsMigrationInventoryAudit::validate_root_manifest_records(duplicate_path)
        assert not EsMigrationInventoryAudit::validate_root_manifest_records(no_data)
        assert EsMigrationInventoryAudit::validate_root_manifest_header("irrelevant\n# name relative_path owner review_status\n")
        assert not EsMigrationInventoryAudit::validate_root_manifest_header("name relative_path owner review_status\n")
        assert not EsMigrationInventoryAudit::validate_root_manifest_header("# name\trelative_path\towner\treview_status\r\n")
