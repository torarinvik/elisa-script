# Pure fixtures: no environment access, launch, hashing or temporary allocation.
include "skia_environment_launcher_plan.elisa"

using EsSkiaEnvironmentLauncherPlan


module EsSkiaEnvironmentGateFixture:
    public:
        def qualified() -> Gate:
            return Gate{reauthorized: true, rss_guard: true, launcher_qualified: true, local_compiler: Pins::COMPILER, core_compiler: Pins::COMPILER,
                launcher: Identity{path: "/fixture/public launcher", hash: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
                python: Identity{path: "/fixture/python", hash: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},
                compiler_hash: "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", source_hash: Pins::SOURCE, model_hash: Pins::MODEL, budget_hash: Pins::BUDGET}


        def rejected(gate: Gate) -> bool:
            catch authorize(gate):
                ok _:
                    return false
                error failure:
                    return true


        def rejected_roles(candidate: Identity, python: Identity, compiler_hash: sview) -> bool:
            catch validate_roles(candidate, python, compiler_hash):
                ok _:
                    return false
                error failure:
                    return failure == GateError.InvalidIdentity


@test
def skia_environment_gate_requires_every_authorization_marker() -> void:
    valid: Gate = EsSkiaEnvironmentGateFixture::qualified()
    admitted: Authorization = try authorize(valid) else err:
        assert false
        return
    assert admitted.launcher.path == "/fixture/public launcher"
    missing: mutable Gate = valid
    missing.reauthorized <- false
    assert EsSkiaEnvironmentGateFixture::rejected(missing)
    missing <- valid
    missing.rss_guard <- false
    assert EsSkiaEnvironmentGateFixture::rejected(missing)
    missing <- valid
    missing.launcher_qualified <- false
    assert EsSkiaEnvironmentGateFixture::rejected(missing)


@test
def skia_environment_gate_rejects_compiler_alias_and_source_drift() -> void:
    valid: Gate = EsSkiaEnvironmentGateFixture::qualified()
    wrong: mutable Gate = valid
    wrong.launcher.hash <- valid.compiler_hash
    assert EsSkiaEnvironmentGateFixture::rejected(wrong)
    wrong <- valid
    wrong.python.path <- Pins::COMPILER
    assert EsSkiaEnvironmentGateFixture::rejected(wrong)
    wrong <- valid
    wrong.local_compiler <- "/installed/compiler"
    assert EsSkiaEnvironmentGateFixture::rejected(wrong)
    wrong <- valid
    wrong.core_compiler <- "/installed/compiler"
    assert EsSkiaEnvironmentGateFixture::rejected(wrong)
    wrong <- valid
    wrong.launcher.path <- valid.python.path
    assert EsSkiaEnvironmentGateFixture::rejected(wrong)
    wrong <- valid
    wrong.python.hash <- valid.launcher.hash
    assert EsSkiaEnvironmentGateFixture::rejected(wrong)
    wrong <- valid
    wrong.budget_hash <- valid.compiler_hash
    assert EsSkiaEnvironmentGateFixture::rejected(wrong)
    wrong <- valid
    wrong.source_hash <- valid.compiler_hash
    assert EsSkiaEnvironmentGateFixture::rejected(wrong)
    wrong <- valid
    wrong.model_hash <- valid.compiler_hash
    assert EsSkiaEnvironmentGateFixture::rejected(wrong)
    wrong <- valid
    wrong.launcher.hash <- "not a hash"
    assert EsSkiaEnvironmentGateFixture::rejected(wrong)
    wrong <- valid
    wrong.launcher.path <- "/fixture\0/launcher"
    assert EsSkiaEnvironmentGateFixture::rejected(wrong)
    assert not absolute_identity_path("relative launcher")
    assert not absolute_identity_path("/fixture\nlauncher")
    assert not valid_hash("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")


@test
def skia_environment_launcher_keeps_source_and_literal_arguments_separate() -> void:
    can Memory.Allocate, Abort.Panic:
        arguments: darray[sview] = candidate_arguments("/fixture with spaces/scripts/query.elisascript", ["", "a=b", " $HOME * ; ", "\xc3\xa9"])
        assert arguments.count == 5
        assert arguments[0] == "/fixture with spaces/scripts/query.elisascript"
        assert arguments[1] == "" and arguments[2] == "a=b"
        assert arguments[3] == " $HOME * ; " and arguments[4] == "\xc3\xa9"
        empty: darray[sview] = candidate_arguments("/fixture/query.elisascript", [])
        assert empty.count == 1


@test
def skia_environment_gate_preserves_literal_backslash_identity_paths() -> void:
    gate: mutable Gate = EsSkiaEnvironmentGateFixture::qualified()
    gate.launcher.path <- "/fixture $HOME; '*.py' \\launcher"
    gate.python.path <- "/fixture \\python"
    admitted: Authorization = try authorize(gate) else err:
        assert false
        return
    assert admitted.launcher.path == "/fixture $HOME; '*.py' \\launcher"
    assert admitted.python.path == "/fixture \\python"
    # Path admission never permits newline/CR identity labels or NUL bytes.
    assert not absolute_identity_path("/fixture\nlauncher")
    assert not absolute_identity_path("/fixture\rlauncher")
    assert not absolute_identity_path("/fixture\0launcher")


@test
def skia_environment_native_container_check_rejects_script_wrappers() -> void:
    can Memory.Allocate, Abort.Panic:
        shell: darray[u8] = [35u8,33u8,47u8,98u8]
        short: darray[u8] = [207u8,250u8,237u8]
        macho: darray[u8] = [207u8,250u8,237u8,254u8]
        elf: darray[u8] = [127u8,69u8,76u8,70u8]
        assert not native_container_header(shell) and not native_container_header(short)
        assert native_container_header(macho) and native_container_header(elf)


@test
def skia_environment_shared_native_roles_reject_digest_and_path_aliases() -> void:
    can Memory.Allocate, Abort.Panic:
        gate: Gate = EsSkiaEnvironmentGateFixture::qualified()
        try validate_roles(gate.launcher, gate.python, gate.compiler_hash) else err:
            assert false
            return
        for digest in [gate.launcher.hash, gate.compiler_hash]:
            python: Identity = Identity{path: gate.python.path, hash: digest}
            assert EsSkiaEnvironmentGateFixture::rejected_roles(gate.launcher, python, gate.compiler_hash)
        candidate: mutable Identity = Identity{path: gate.launcher.path, hash: gate.compiler_hash}
        assert EsSkiaEnvironmentGateFixture::rejected_roles(candidate, gate.python, gate.compiler_hash)
        for target in ["/", "relative", "/fixture\0candidate", "/fixture\ncandidate", "/fixture\rcandidate", gate.python.path, Pins::COMPILER] |candidate|:
            candidate <- Identity{path: target, hash: gate.launcher.hash}
            assert EsSkiaEnvironmentGateFixture::rejected_roles(candidate, gate.python, gate.compiler_hash)
        oversized: mutable darray[u8] = []
        oversized.reserve(4096)
        oversized.push(47u8)
        for _ in 0..<4095 |oversized|:
            oversized.push(120u8)
        candidate <- Identity{path: bytes_view(oversized), hash: gate.launcher.hash}
        assert EsSkiaEnvironmentGateFixture::rejected_roles(candidate, gate.python, gate.compiler_hash)
        # Literal metacharacters/backslashes stay literal identity bytes.
        candidate <- Identity{path: "/fixture $HOME; '*.py' \\native", hash: gate.launcher.hash}
        try validate_roles(candidate, gate.python, gate.compiler_hash) else err:
            assert false
