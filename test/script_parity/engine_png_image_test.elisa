include "../../ports/elisa-engine/scripts/png_image.elisa"

using EsEnginePngImage


@test
def writes_minimal_two_row_rgba_png_with_valid_chunk_checksums() -> void can[Memory.Allocate, Abort.Panic]:
    pixels: darray[u8] = [1, 2, 3, 4, 5, 6, 7, 8]
    encoded: mutable darray[u8] = []
    catch encode_png(1, 2, pixels):
        ok value:
            encoded <- value
        error failure:
            _ = failure
            assert false

    assert encoded.count == 78
    assert encoded[0] == 137 and encoded[1] == 80 and encoded[2] == 78 and encoded[3] == 71
    assert encoded[4] == 13 and encoded[5] == 10 and encoded[6] == 26 and encoded[7] == 10
    assert encoded[8] == 0 and encoded[9] == 0 and encoded[10] == 0 and encoded[11] == 13
    assert encoded[12] == 73 and encoded[13] == 72 and encoded[14] == 68 and encoded[15] == 82
    assert encoded[16] == 0 and encoded[17] == 0 and encoded[18] == 0 and encoded[19] == 1
    assert encoded[20] == 0 and encoded[21] == 0 and encoded[22] == 0 and encoded[23] == 2
    assert encoded[24] == 8 and encoded[25] == 6 and encoded[26] == 0 and encoded[27] == 0 and encoded[28] == 0
    assert encoded[29] == 0x99 and encoded[30] == 0x81 and encoded[31] == 0xb6 and encoded[32] == 0x27
    assert encoded[33] == 0 and encoded[34] == 0 and encoded[35] == 0 and encoded[36] == 21
    assert encoded[37] == 73 and encoded[38] == 68 and encoded[39] == 65 and encoded[40] == 84
    assert encoded[41] == 0x78 and encoded[42] == 0x01
    assert encoded[43] == 1 and encoded[44] == 10 and encoded[45] == 0
    assert encoded[46] == 245 and encoded[47] == 255
    assert encoded[48] == 0 and encoded[49] == 1 and encoded[50] == 2 and encoded[51] == 3 and encoded[52] == 4
    assert encoded[53] == 0 and encoded[54] == 5 and encoded[55] == 6 and encoded[56] == 7 and encoded[57] == 8
    assert encoded[58] == 0 and encoded[59] == 140 and encoded[60] == 0 and encoded[61] == 37
    assert encoded[62] == 0x79 and encoded[63] == 0x7d and encoded[64] == 0x6b and encoded[65] == 0xf1
    assert encoded[66] == 0 and encoded[67] == 0 and encoded[68] == 0 and encoded[69] == 0
    assert encoded[70] == 73 and encoded[71] == 69 and encoded[72] == 78 and encoded[73] == 68
    assert encoded[74] == 0xae and encoded[75] == 0x42 and encoded[76] == 0x60 and encoded[77] == 0x82


@test
def crc32_matches_the_standard_check_vector() -> void can[Memory.Allocate, Abort.Panic]:
    check: darray[u8] = [49, 50, 51, 52, 53, 54, 55, 56, 57]
    assert crc32(check) == 0xcbf43926


@test
def splits_filtered_data_at_the_stored_deflate_block_limit() -> void can[Memory.Allocate, Abort.Panic]:
    pixels: mutable darray[u8] = []
    for _ in 0..<65536 |pixels|:
        pixels.push(0)
    encoded: mutable darray[u8] = []
    catch encode_png(16384, 1, pixels):
        ok value:
            encoded <- value
        error failure:
            _ = failure
            assert false
    assert encoded.count == 65610
    assert encoded[43] == 0
    assert encoded[44] == 255 and encoded[45] == 255
    assert encoded[46] == 0 and encoded[47] == 0
    assert encoded[65583] == 1
    assert encoded[65584] == 2 and encoded[65585] == 0
    assert encoded[65586] == 253 and encoded[65587] == 255
    assert encoded[65588] == 0 and encoded[65589] == 0


def png_encode_error_matches(width: i64, height: i64, pixels: darray[u8]&, expected: PngEncodeError) -> bool can[Memory.Allocate, Abort.Panic]:
    observed: mutable bool = false
    catch encode_png(width, height, pixels):
        ok encoded:
            _ = encoded
        error failure:
            observed <- failure == expected
    return observed


@test
def rejects_empty_dimensions_extra_or_missing_pixels_and_unbounded_images() -> void can[Memory.Allocate, Abort.Panic]:
    pixels: darray[u8] = []
    assert png_encode_error_matches(0, 1, pixels, PngEncodeError.InvalidDimensions)
    assert png_encode_error_matches(1, 0, pixels, PngEncodeError.InvalidDimensions)
    assert png_encode_error_matches(-1, 1, pixels, PngEncodeError.InvalidDimensions)
    assert png_encode_error_matches(1, -1, pixels, PngEncodeError.InvalidDimensions)
    assert png_encode_error_matches(16385, 1, pixels, PngEncodeError.DimensionLimitExceeded)
    assert png_encode_error_matches(4096, 4096, pixels, PngEncodeError.ImageTooLarge)

    short_pixels: darray[u8] = [1, 2, 3]
    assert png_encode_error_matches(1, 1, short_pixels, PngEncodeError.PixelLengthMismatch)
    long_pixels: darray[u8] = [1, 2, 3, 4, 5]
    assert png_encode_error_matches(1, 1, long_pixels, PngEncodeError.PixelLengthMismatch)
