# Tiny source-only fixtures. No chmod, exec, shell or differential runner.
include "canonical_lint_exec_failure_cases.elisa"

using EsCanonicalLintExecFailureCases


@test
def lint_exec_failure_cases_pin_all_seven_independent_failure_targets() -> void:
    can Memory.Allocate, Abort.Panic:
        cases: darray[Case] = required()
        names: darray[sview] = ["missing-relative", "missing-absolute", "missing-path", "denied-relative", "denied-absolute", "denied-path", "directory-absolute"]
        targets: darray[Target] = [Target.Missing, Target.Missing, Target.Missing, Target.Denied, Target.Denied, Target.Denied, Target.Directory]
        addresses: darray[Address] = [Address.Relative, Address.Absolute, Address.PathName, Address.Relative, Address.Absolute, Address.PathName, Address.Absolute]
        statuses: darray[i64] = [127i64, 127i64, 127i64, 126i64, 126i64, 126i64, 126i64]
        assert cases.count == 7
        assert names.count == cases.count and targets.count == cases.count
        assert addresses.count == cases.count and statuses.count == cases.count
        for index in 0..<cases.count:
            assert cases[index].name == names[index]
            assert cases[index].target == targets[index]
            assert cases[index].address == addresses[index]
            assert cases[index].status == statuses[index]


@test
def lint_exec_failure_case_paths_are_literal_and_project_relative() -> void:
    can Memory.Allocate, Abort.Panic:
        cases: darray[Case] = required()
        root: sview = "/fixture root with spaces"
        expected: darray[sview] = [
            "tools/elisascript lint missing probe",
            "/fixture root with spaces/tools/elisascript lint missing probe",
            "elisascript lint missing probe",
            "tools/elisascript lint denied probe",
            "/fixture root with spaces/tools/elisascript lint denied probe",
            "elisascript lint denied probe",
            "/fixture root with spaces/scripts"
        ]
        assert cases.count == expected.count
        for index in 0..<cases.count:
            assert executable_text(cases[index], root) == expected[index]
        assert Fixture::DENIED_MODE == 384u64
        assert (Fixture::DENIED_MODE & 73u64) == 0u64
