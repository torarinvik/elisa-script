# Dormant prebuilt-native qualification. Never compile a candidate in this test.
# The public entry gates even identity/hash-tool launches on explicit opt-in.
include "../../src/testing/differential.elisa"
include "../../src/testing/checksum_record_model.elisa"
include "skia_environment_cases.elisa"
include "skia_environment_launcher_plan.elisa"

using EsDifferential


module EsSkiaEnvironmentNativeParity:
    private:
        const module Tools:
            COMPILER: sview = EsSkiaEnvironmentLauncherPlan::Pins::COMPILER
            HASH: sview = "/usr/bin/shasum"
            TIMEOUT_STEPS: u64 = 10000
            OUTPUT_BYTES: u64 = 65536
            ARTIFACT_BYTES: usize = 67108864
            MODE: u64 = 493
            ORDINARY_CASES: usize = 17


        struct Identity:
            path: sview
            hash: sview


        struct Authorization:
            candidate: Identity
            python: Identity
            compiler_hash: sview


        struct Root:
            path: Path
            created: bool = false
            ready: bool = false
            files: darray[Path] = []
            directory_mode: u64 = 0
            reference_mode: u64 = 0
            candidate_mode: u64 = 0


        error GateError:
            Disabled
            WrongCompiler
            InvalidIdentity


        def env(name: sview) -> sview can[Environment.Read]:
            return try getenv(name, "") else ""


        def valid_hash(hash: sview) -> bool:
            return EsSkiaEnvironmentLauncherPlan::valid_hash(hash)


        def authorization() -> Authorization error[GateError] can[Environment.Read]:
            raise GateError.Disabled if env("ELISASCRIPT_VALIDATION_REAUTHORIZED") != "1" or env("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD") != "active" or env("ELISASCRIPT_SKIA_ENV_NATIVE_QUALIFIED") != "1"
            raise GateError.WrongCompiler if env("ELISA_LOCAL_COMPILER") != Tools::COMPILER or env("ELISACORE_BIN") != Tools::COMPILER
            candidate: Identity = Identity{path: env("ELISASCRIPT_SKIA_ENV_NATIVE_BIN"), hash: env("ELISASCRIPT_SKIA_ENV_NATIVE_SHA256")}
            python: Identity = Identity{path: env("ELISASCRIPT_PARITY_PYTHON_BIN"), hash: env("ELISASCRIPT_PARITY_PYTHON_SHA256")}
            compiler_hash: sview = env("ELISASCRIPT_LOCAL_COMPILER_SHA256")
            try EsSkiaEnvironmentLauncherPlan::validate_roles(
                EsSkiaEnvironmentLauncherPlan::Identity{path: candidate.path, hash: candidate.hash},
                EsSkiaEnvironmentLauncherPlan::Identity{path: python.path, hash: python.hash}, compiler_hash) else err:
                raise GateError.InvalidIdentity
            # Pairing hashes are an explicit qualification assertion, not a
            # proof that an arbitrary executable was built from these sources.
            raise GateError.InvalidIdentity if env("ELISASCRIPT_SKIA_ENV_SOURCE_SHA256") != "3ba61d4472d355f8a38dfce99033b0df4ca5db73d328f085d33ee7698978a1e7" or env("ELISASCRIPT_SKIA_ENV_MODEL_SHA256") != "e98c8629784b647c991c109bda877b429e83e346e58f28ecfd01df336c8b1110" or env("ELISASCRIPT_SKIA_ENV_ADAPTER_SHA256") != "70a846eb66a731be80abfa02372f20aab30749b593b391d4f8817502c0eca78f"
            return Authorization{candidate: candidate, python: python, compiler_hash: compiler_hash}


        def pins(auth: Authorization) -> darray[Identity] can[Memory.Allocate, Abort.Panic]:
            return [
                auth.candidate, auth.python,
                Identity{path: Tools::COMPILER, hash: auth.compiler_hash},
                Identity{path: Tools::HASH, hash: "0812595f981a26f813d98dc380af14d4af427626c9339eda29eb849ae13de1e3"},
                Identity{path: "src/testing/checksum_record_model.elisa", hash: "1b3cec1235d42076e50b15491d3d6b906f3841ea966937779dc665f1e8a59488"},
                Identity{path: "src/testing/process_poll_budget_model.elisa", hash: "589d2f2fa733610987a91aa0f998374914e1e63f4569a34a994e0d00446c8589"},
                Identity{path: "src/runtime/process_spawn_wait_model.elisa", hash: "66ffe889caa534f1a3a2f163dd6f648ecb7a52cbeab4d3d871951ca3fa1d7d95"},
                Identity{path: "src/runtime/process_pid_model.elisa", hash: "6b1434253ae622a624b7c43d9adc0806bf09e6125196f26bb489e792ca5cd78c"},
                Identity{path: "src/runtime/stdin_read_budget_model.elisa", hash: "0dcd6ff08b4d81eb913ff04efd5fb08059ef47cea0e723cb27af893dfb51aced"},
                Identity{path: "test/script_parity/skia_environment_launcher_plan.elisa", hash: "f48a705b1410537085a99bcc32c2ca6ab5dd837d45d5c38c6e83fd1691e7af44"},
                Identity{path: "scripts/get_skia_environment.elisascript", hash: "3ba61d4472d355f8a38dfce99033b0df4ca5db73d328f085d33ee7698978a1e7"},
                Identity{path: "src/runtime/environment_lookup_model.elisa", hash: "e98c8629784b647c991c109bda877b429e83e346e58f28ecfd01df336c8b1110"},
                Identity{path: "src/runtime/environment_lookup_posix.elisa", hash: "70a846eb66a731be80abfa02372f20aab30749b593b391d4f8817502c0eca78f"},
                Identity{path: "test/script_parity/skia_environment_cases.elisa", hash: "c1276a963962d7aba7eb65c39fa4f7fb28309a0ab0b46635aa1b6add29e42c85"},
                Identity{path: "test/fixtures/script_parity/skia_environment/reference.py", hash: "6233a520babc11883827118a90a532e9de6efab6294ddd038da7bd92c48e7de0"},
                Identity{path: "test/fixtures/script_parity/skia_environment/LICENSE", hash: "5f787c1dee3c56547f09ccc2906ab5f5293c4d8dd6c8654e573216c38e908dbd"}
            ]


        def has_hash(identity: Identity) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if not valid_hash(identity.hash) or len(identity.path) == 0 or len(identity.path) > EsChecksumRecord::Limits::FILENAME_BYTES or identity.path == "-"
            for byte in identity.path:
                return false if byte == 0u8
            return false if not is_file(path(identity.path)) or is_symlink(path(identity.path))
            size: usize = try file_size(path(identity.path)) else 0usize
            return false if size == 0 or size > Tools::ARTIFACT_BYTES
            runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "skia-env-identity", target: Tools::HASH, arguments: ["-a", "256", "-t", "--", identity.path], environment_mode: EsProcess::ProcessEnvironmentMode.Clear, timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES}
            run: DifferentialRun = try run_differential_process(runner) else err:
                return false
            return false if run.outcome != DifferentialRunOutcome.Completed or run.exit_status != 0 or run.stderr != ""
            return try EsChecksumRecord::sha256_text_record_matches(run.stdout, identity.hash, identity.path) else false


        def native_artifact(identity: Identity) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if not EsSkiaEnvironmentLauncherPlan::absolute_identity_path(identity.path)
            target: Path = path(identity.path)
            return false if not is_file(target) or is_symlink(target) or not is_executable(target)
            size: usize = try file_size(target) else 0usize
            return false if size < 4 or size > Tools::ARTIFACT_BYTES
            name: mutable darray[u8] = []
            for byte in identity.path |name|:
                name.push(byte)
            name.push(0u8)
            mode: darray[u8] = [114u8,98u8,0u8]
            stream: mutable heap void&? = fopen(&name[0], &mode[0])
            return false if stream == null
            opened: mutable heap void& = stream
            header: mutable darray[u8] = [0u8,0u8,0u8,0u8]
            amount: usize = fread((&header[0]).cast[mutable void&], 1, 4, opened)
            closed: int = fclose(opened)
            return amount == 4 and closed == 0 and EsSkiaEnvironmentLauncherPlan::native_container_header(header) and not is_symlink(target)


        def pinned(auth: Authorization) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            # No hash-tool child until all three supplied roles reject text
            # wrappers and have bounded, nonsymlink native-container preflights.
            return false if not native_artifact(auth.candidate) or not native_artifact(auth.python)
            return false if not native_artifact(Identity{path: Tools::COMPILER, hash: auth.compiler_hash})
            for identity in pins(auth):
                return false if not has_hash(identity)
            return true


        def cleanup(root: Root) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write]:
            return true if not root.created
            cleaned: mutable bool = true
            for index in 0..<root.files.count |root, cleaned|:
                # Observational fence only: concurrent replacement still
                # requires a descriptor-relative native cleanup adapter.
                return false if is_symlink(root.path) or not is_directory(root.path)
                target: Path = root.files[root.files.count - index - 1]
                if path_exists(target) or is_symlink(target):
                    removed: bool = try remove_path(target) else false
                    cleaned <- removed and cleaned
            return false if is_symlink(root.path) or not is_directory(root.path)
            removed: bool = try remove_directory(root.path) else false
            return removed and cleaned


        def create_root(auth: Authorization) -> Root can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Format]:
            allocated: Path = try temp_directory("elisascript skia env parity ") else err:
                return Root{path: path(".")}
            canonical: Path = try path_real(allocated) else err:
                return Root{path: allocated, created: true}
            root: mutable Root = Root{path: canonical, created: true}
            reference: Path = root.path.joinpath("reference.py")
            root.files.push(reference)
            copied: bool = try copy_path(path("test/fixtures/script_parity/skia_environment/reference.py"), reference) else false
            return root if not copied
            candidate: Path = root.path.joinpath("candidate env query")
            root.files.push(candidate)
            copied_candidate: bool = try copy_path(path(auth.candidate.path), candidate) else false
            return root if not copied_candidate
            changed: bool = try chmod(candidate, Tools::MODE) else false
            return root if not changed
            root.directory_mode <- try file_mode(root.path) else err:
                return root
            root.reference_mode <- try file_mode(reference) else err:
                return root
            root.candidate_mode <- try file_mode(candidate) else err:
                return root
            root.ready <- true
            return root


        def fixture_files_unchanged(root: Root, auth: Authorization) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Format]:
            return false if not root.ready or is_symlink(root.path) or not is_directory(root.path)
            entries: darray[sview] = try list_directory(root.path) else err:
                return false
            return false if entries.count != 2
            for entry in entries:
                return false if entry != "reference.py" and entry != "candidate env query"
            reference: Path = root.path.joinpath("reference.py")
            candidate: Path = root.path.joinpath("candidate env query")
            directory_mode: u64 = try file_mode(root.path) else 0u64
            reference_mode: u64 = try file_mode(reference) else 0u64
            candidate_mode: u64 = try file_mode(candidate) else 0u64
            return false if directory_mode != root.directory_mode or reference_mode != root.reference_mode or candidate_mode != root.candidate_mode
            return has_hash(Identity{path: f"{reference}", hash: "6233a520babc11883827118a90a532e9de6efab6294ddd038da7bd92c48e7de0"}) and has_hash(Identity{path: f"{candidate}", hash: auth.candidate.hash})


        def exact(run: DifferentialRun, expected: sview) -> bool:
            return run.outcome == DifferentialRunOutcome.Completed and run.exit_status == 0 and run.stdout == expected and run.stderr == ""


        def case_matches(root: Root, auth: Authorization, selected: EsSkiaEnvironmentCases::Case) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Format]:
            environment: mutable darray[DifferentialEnvironmentEntry] = [DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"}, DifferentialEnvironmentEntry{name: "ELISASCRIPT_PARITY_ENV_UNRELATED", value: "inherited fixture only"}]
            for entry in selected.environment:
                environment.push(DifferentialEnvironmentEntry{name: entry.name, value: entry.value})
            reference_path: Path = root.path.joinpath("reference.py")
            candidate_path: Path = root.path.joinpath("candidate env query")
            reference_argv: mutable darray[sview] = ["-I", "-S", "-B", "-X", "utf8", f"{reference_path}"]
            for argument in selected.arguments:
                reference_argv.push(argument)
            reference: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "skia-env-reference", target: auth.python.path, arguments: reference_argv, working_directory: f"{root.path}", environment: environment, environment_mode: EsProcess::ProcessEnvironmentMode.Replace, stdin_binary: true, stdin_bytes: [0u8,255u8,10u8], timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES}
            candidate: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "skia-env-native-candidate", target: f"{candidate_path}", arguments: selected.arguments, working_directory: f"{root.path}", environment: environment, environment_mode: EsProcess::ProcessEnvironmentMode.Replace, stdin_binary: true, stdin_bytes: [0u8,255u8,10u8], timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES}
            reference_run: DifferentialRun = try run_differential_process(reference) else err:
                return false
            # Validate the independent oracle before even starting a candidate.
            return false if not exact(reference_run, selected.stdout) or not fixture_files_unchanged(root, auth)
            candidate_run: DifferentialRun = try run_differential_process(candidate) else err:
                return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return exact(candidate_run, selected.stdout) and comparison.equal and fixture_files_unchanged(root, auth)


        def matrix(root: Root, auth: Authorization) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Format]:
            selected_cases: darray[EsSkiaEnvironmentCases::Case] = EsSkiaEnvironmentCases::ordinary()
            return false if selected_cases.count != Tools::ORDINARY_CASES
            for selected in selected_cases:
                if not case_matches(root, auth, selected):
                    return false
            return true

    public:
        def native_parity() -> bool can[Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Write, Console.Format]:
            auth: Authorization = try authorization() else err:
                _ = write_stderr("skia environment parity: qualification gate is disabled or incomplete\n")
                return false
            return false if not pinned(auth)
            root: Root = create_root(auth)
            return false if not root.created
            matched: bool = root.ready and fixture_files_unchanged(root, auth) and matrix(root, auth)
            inputs_unchanged: bool = pinned(auth)
            cleaned: bool = cleanup(root)
            final_inputs_unchanged: bool = pinned(auth)
            if not cleaned:
                _ = write_stderr(f"skia environment parity: cleanup failed at {root.path}\n")
                return false
            return matched and inputs_unchanged and final_inputs_unchanged


@test
def skia_environment_native_candidate_matches_independent_cases() -> void:
    can Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Write, Console.Format:
        assert EsSkiaEnvironmentNativeParity::native_parity()
