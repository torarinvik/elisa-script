# Unit coverage for the shared bounded inventory walker. This test constructs
# only private temporary trees; it never reads or executes discovered files.
include "../../scripts/inventory_walk.elisascript"

using EsInventoryWalk
using EsRuntime


module EsInventoryWalkTests:
    private:
        def create_test_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try create_directory(target) else false


        def write_test_file(target: Path, contents: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            written: usize = try write_text(target, contents) else 0u64
            return written == len(contents)


        def create_test_symlink(target: Path, link: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            return try symlink(target, link) else false


        def remove_test_tree(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write]:
            return try remove_tree(target) else false


        def run_policy_cases() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            root_temporary: Path = try temp_directory("elisascript-inventory-walk") else err:
                return false
            outside_temporary: Path = try temp_directory("elisascript-inventory-walk-outside") else err:
                _ = remove_test_tree(root_temporary)
                return false
            root: Path = try path_real(root_temporary) else err:
                _ = remove_test_tree(root_temporary)
                _ = remove_test_tree(outside_temporary)
                return false
            outside: Path = try path_real(outside_temporary) else err:
                _ = remove_test_tree(root)
                _ = remove_test_tree(outside_temporary)
                return false

            nested: Path = root.joinpath("nested")
            vendor: Path = root.joinpath("vendor")
            outside_file: Path = outside.joinpath("outside.py")
            setup_ok: mutable bool = create_test_directory(nested)
            setup_ok <- create_test_directory(vendor) and setup_ok
            setup_ok <- write_test_file(root.joinpath("app.py"), "data only\n") and setup_ok
            setup_ok <- write_test_file(root.joinpath("notes.txt"), "data only\n") and setup_ok
            setup_ok <- write_test_file(nested.joinpath("tool.sh"), "data only\n") and setup_ok
            setup_ok <- write_test_file(vendor.joinpath("excluded.py"), "data only\n") and setup_ok
            setup_ok <- write_test_file(outside_file, "outside data only\n") and setup_ok
            setup_ok <- create_test_symlink(outside, root.joinpath("outside-link")) and setup_ok

            root_text: sview = f"{root}"
            base_policy: DirectoryWalkPolicy = DirectoryWalkPolicy{
                suffixes: [".py"]
            }
            base_result: DirectoryWalkResult = walk(root_text, base_policy)
            ok: mutable bool = setup_ok and base_result.failure == DirectoryWalkFailure.None
            ok <- base_result.regular_file_count == 3 and ok
            ok <- base_result.directory_count == 1 and ok
            ok <- base_result.selected_files.count == 1 and ok
            if base_result.selected_files.count == 1:
                ok <- base_result.selected_files[0].path == root_text + "/app.py" and ok

            file_limit_policy: DirectoryWalkPolicy = DirectoryWalkPolicy{
                max_regular_files: 2,
                suffixes: [".py"]
            }
            file_limit_result: DirectoryWalkResult = walk(root_text, file_limit_policy)
            ok <- file_limit_result.failure == DirectoryWalkFailure.RegularFileLimitExceeded and ok
            ok <- file_limit_result.regular_file_count == 3 and ok

            directory_limit_policy: DirectoryWalkPolicy = DirectoryWalkPolicy{
                max_directories: 0,
                suffixes: [".py"]
            }
            directory_limit_result: DirectoryWalkResult = walk(root_text, directory_limit_policy)
            ok <- directory_limit_result.failure == DirectoryWalkFailure.DirectoryLimitExceeded and ok

            depth_limit_policy: DirectoryWalkPolicy = DirectoryWalkPolicy{
                max_depth: 0,
                suffixes: [".py"]
            }
            depth_limit_result: DirectoryWalkResult = walk(root_text, depth_limit_policy)
            ok <- depth_limit_result.failure == DirectoryWalkFailure.DepthExceeded and ok

            entry_limit_policy: DirectoryWalkPolicy = DirectoryWalkPolicy{
                max_directory_entries: 5,
                suffixes: [".py"]
            }
            entry_limit_result: DirectoryWalkResult = walk(root_text, entry_limit_policy)
            ok <- entry_limit_result.failure == DirectoryWalkFailure.EntryLimitExceeded and ok

            path_limit_policy: DirectoryWalkPolicy = DirectoryWalkPolicy{
                max_path_bytes: 1,
                suffixes: [".py"]
            }
            path_limit_result: DirectoryWalkResult = walk(root_text, path_limit_policy)
            ok <- path_limit_result.failure == DirectoryWalkFailure.PathBytesExceeded and ok

            selected_path_limit_policy: DirectoryWalkPolicy = DirectoryWalkPolicy{
                max_selected_path_bytes: 1,
                suffixes: [".py"]
            }
            selected_path_limit_result: DirectoryWalkResult = walk(root_text, selected_path_limit_policy)
            ok <- selected_path_limit_result.failure == DirectoryWalkFailure.SelectedPathBytesExceeded and ok

            invalid_mode_policy: DirectoryWalkPolicy = DirectoryWalkPolicy{
                select_mode_bits: true,
                required_mode_bits: 0
            }
            invalid_mode_result: DirectoryWalkResult = walk(root_text, invalid_mode_policy)
            ok <- invalid_mode_result.failure == DirectoryWalkFailure.InvalidPolicy and ok

            file_type_mode_policy: DirectoryWalkPolicy = DirectoryWalkPolicy{
                select_mode_bits: true,
                required_mode_bits: 32768u16
            }
            file_type_mode_result: DirectoryWalkResult = walk(root_text, file_type_mode_policy)
            ok <- file_type_mode_result.failure == DirectoryWalkFailure.InvalidPolicy and ok

            inactive_mode_policy: DirectoryWalkPolicy = DirectoryWalkPolicy{
                required_mode_bits: 1u16
            }
            inactive_mode_result: DirectoryWalkResult = walk(root_text, inactive_mode_policy)
            ok <- inactive_mode_result.failure == DirectoryWalkFailure.InvalidPolicy and ok

            root_removed: bool = remove_test_tree(root)
            outside_removed: bool = remove_test_tree(outside)
            return ok and root_removed and outside_removed


@test
def shared_inventory_walker_enforces_policy_limits_and_selection() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast:
        assert EsInventoryWalkTests::run_policy_cases()
