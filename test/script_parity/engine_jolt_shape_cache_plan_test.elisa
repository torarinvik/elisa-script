include "../../ports/elisa-engine/scripts/test_jolt_shape_cache_plan.elisa"

using EsEngineJoltShapeCacheTestPlan


@test
def plans_the_python_runner_as_exact_argv_without_shell_splitting() -> void can[Memory.Allocate, Abort.Panic]:
    plan: Plan = EsEngineJoltShapeCacheTestPlan::plan(
        "/projects/elisa engine", "/tmp/jolt cache-test", "/toolchain/clang++ path", "/brew path/include"
    )
    assert plan.temporary_directory == "/tmp/jolt cache-test"
    assert plan.executable_path == "/tmp/jolt cache-test/jolt-shape-cache-test"
    assert plan.compile_command.program == "/toolchain/clang++ path"
    assert plan.compile_command.arguments.count == 9
    assert plan.compile_command.arguments[0] == "-std=c++17"
    assert plan.compile_command.arguments[1] == "-O0"
    assert plan.compile_command.arguments[2] == "-I"
    assert plan.compile_command.arguments[3] == "/projects/elisa engine/native"
    assert plan.compile_command.arguments[4] == "-I"
    assert plan.compile_command.arguments[5] == "/brew path/include"
    assert plan.compile_command.arguments[6] == "/projects/elisa engine/test/jolt_shape_cache_test.cpp"
    assert plan.compile_command.arguments[7] == "-o"
    assert plan.compile_command.arguments[8] == "/tmp/jolt cache-test/jolt-shape-cache-test"


@test
def preserves_an_explicitly_empty_compiler_and_empty_include_as_current_directory() -> void can[Memory.Allocate, Abort.Panic]:
    plan: Plan = EsEngineJoltShapeCacheTestPlan::plan("/engine", "/tmp/test", "", ".")
    assert plan.compile_command.program == ""
    assert plan.compile_command.arguments[5] == "."


@test
def execution_machine_relays_compile_and_test_status_and_always_reaches_cleanup() -> void can[Memory.Allocate, Abort.Panic]:
    compile_failure: mutable ExecutionState = initial_execution()
    compile_failure <- try execution_after_compile(compile_failure, 23) else compile_failure
    assert compile_failure.phase == ExecutionPhase.Cleanup
    assert compile_failure.exit_status == 23
    compile_failure <- try execution_after_cleanup(compile_failure, true) else compile_failure
    assert compile_failure.phase == ExecutionPhase.Done
    assert compile_failure.exit_status == 23

    test_failure: mutable ExecutionState = initial_execution()
    test_failure <- try execution_after_compile(test_failure, 0) else test_failure
    assert test_failure.phase == ExecutionPhase.Run
    test_failure <- try execution_after_run(test_failure, 37) else test_failure
    assert test_failure.phase == ExecutionPhase.Cleanup
    test_failure <- try execution_after_cleanup(test_failure, true) else test_failure
    assert test_failure.phase == ExecutionPhase.Done
    assert test_failure.exit_status == 37


@test
def success_cleans_before_reporting_and_returns_zero() -> void can[Memory.Allocate, Abort.Panic]:
    state: mutable ExecutionState = initial_execution()
    state <- try execution_after_compile(state, 0) else state
    state <- try execution_after_run(state, 0) else state
    assert state.phase == ExecutionPhase.Cleanup
    state <- try execution_after_cleanup(state, true) else state
    assert state.phase == ExecutionPhase.Report
    state <- try execution_after_report(state) else state
    assert state.phase == ExecutionPhase.Done
    assert state.exit_status == 0

    cleanup_failure: mutable ExecutionState = initial_execution()
    cleanup_failure <- try execution_after_compile(cleanup_failure, 0) else cleanup_failure
    cleanup_failure <- try execution_after_run(cleanup_failure, 0) else cleanup_failure
    cleanup_failure <- try execution_after_cleanup(cleanup_failure, false) else cleanup_failure
    assert cleanup_failure.phase == ExecutionPhase.Done
    assert cleanup_failure.exit_status == 1


@test
def rejects_receipts_for_the_wrong_phase() -> void can[Memory.Allocate, Abort.Panic]:
    state: ExecutionState = initial_execution()
    rejected: mutable bool = false
    catch execution_after_run(state, 0):
        ok unexpected:
            _ = unexpected
        error failure:
            rejected <- failure == PlanError.InvalidExecutionState
    assert rejected
