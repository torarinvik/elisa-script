# Unit tests for the AWK-style eight-field manifest record contract.
include "../../scripts/check_migration_review.elisascript"

using EsMigrationReviewAudit


module EsMigrationReviewRecordsTests:
    private:
        const module Limits:
            EXPECTED_ROWS: usize = 21


        def fixture_contents(duplicate_last_path: bool = false, invalid_disposition: bool = false, missing_row: bool = false, wrong_field_count: bool = false, header: sview = "path\tkind\towner\treview_status\tentrypoint\tdisposition\trisk\tnotes", line_ending: sview = "\n") -> sview can[Memory.Allocate, Abort.Panic]:
            rows: mutable darray[sview] = [header]
            row_count: mutable usize = Limits::EXPECTED_ROWS
            row_count <- Limits::EXPECTED_ROWS - 1 if missing_row
            for index in 0..<row_count |rows, duplicate_last_path, invalid_disposition|:
                path_text: mutable sview = "/repo/scripts/candidate_" + format_int(index.i64()) + ".sh"
                path_text <- "/repo/scripts/candidate_0.sh" if duplicate_last_path and index + 1 == row_count
                disposition: sview = "invalid" if invalid_disposition and index == 0 else "port"
                row_text: mutable sview = path_text + "\tshell\towner\treviewed\tdirect executable\t" + disposition + "\ttest\tacceptance notes"
                row_text <- row_text + "\textra" if wrong_field_count and index == 0
                rows.push(row_text)
            return join(rows, line_ending) + line_ending


        def manifest_records_valid(contents: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            accepted: mutable bool = false
            catch EsMigrationReviewAudit::validate_review_records(contents):
                ok value:
                    accepted <- value
                error failure:
                    return false
            return accepted


@test
def migration_review_records_match_awk_shape_and_uniqueness_rules() -> void:
    can Memory.Allocate, Abort.Panic:
        valid_records: sview = EsMigrationReviewRecordsTests::fixture_contents()
        duplicate_path: sview = EsMigrationReviewRecordsTests::fixture_contents(true)
        invalid_disposition: sview = EsMigrationReviewRecordsTests::fixture_contents(false, true)
        missing_row: sview = EsMigrationReviewRecordsTests::fixture_contents(false, false, true)
        wrong_field_count: sview = EsMigrationReviewRecordsTests::fixture_contents(false, false, false, true)
        whitespace_header: sview = EsMigrationReviewRecordsTests::fixture_contents(false, false, false, false, "path kind owner review_status entrypoint disposition risk notes")
        crlf_records: sview = EsMigrationReviewRecordsTests::fixture_contents(false, false, false, false, "path\tkind\towner\treview_status\tentrypoint\tdisposition\trisk\tnotes", "\r\n")
        bare_cr_records: sview = EsMigrationReviewRecordsTests::fixture_contents(false, false, false, false, "path\tkind\towner\treview_status\tentrypoint\tdisposition\trisk\tnotes", "\r")
        assert EsMigrationReviewRecordsTests::manifest_records_valid(valid_records)
        assert not EsMigrationReviewRecordsTests::manifest_records_valid(duplicate_path)
        assert not EsMigrationReviewRecordsTests::manifest_records_valid(invalid_disposition)
        assert not EsMigrationReviewRecordsTests::manifest_records_valid(missing_row)
        assert not EsMigrationReviewRecordsTests::manifest_records_valid(wrong_field_count)
        assert not EsMigrationReviewRecordsTests::manifest_records_valid(whitespace_header)
        assert not EsMigrationReviewRecordsTests::manifest_records_valid(crlf_records)
        assert not EsMigrationReviewRecordsTests::manifest_records_valid(bare_cr_records)
