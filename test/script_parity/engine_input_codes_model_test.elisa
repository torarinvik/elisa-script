include "../../ports/elisa-engine/scripts/input_codes_model.elisa"

using EsEngineInputCodes


const module Fixtures:
    ELISA: sview = "        KEY_A: i64 = 2001\n        KEY_SLASH: i64 = 2083\n        GAMEPAD_BUTTON_SOUTH: i64 = 1001\n        enum KeyboardKeyCode:\n            A\n            Slash\n        def keyboard_key_code(key: KeyboardKeyCode) -> i64:\n            match key:\n                KeyboardKeyCode.A: PortableInputCodes::KEY_A\n                KeyboardKeyCode.Slash: PortableInputCodes::KEY_SLASH\n"
    NATIVE: sview = "    KEY_A = 2001,\n    KEY_SLASH = 2083,\n    GAMEPAD_BUTTON_SOUTH = 1001,\nconstexpr int32_t keyboard_key_code(SDL_Keycode key) {\n    case SDLK_A: return KEY_A;\n    case SDLK_SLASH: return KEY_SLASH;\n    default: return 0;\n}\n"


@test
def matching_tables_enum_arms_and_native_switch_have_no_problems() -> void can[Memory.Allocate, Abort.Panic]:
    assert table_problems(Fixtures::ELISA, Fixtures::NATIVE).count == 0
    assert self_test_problems(Fixtures::ELISA, Fixtures::NATIVE).count == 0


@test
def reports_mismatched_values_and_missing_native_switch_cases_in_sorted_order() -> void can[Memory.Allocate, Abort.Panic]:
    changed_elisa: sview = replace(Fixtures::ELISA, "KEY_A: i64 = 2001", "KEY_A: i64 = 9")
    changed_native: sview = replace(Fixtures::NATIVE, "    case SDLK_SLASH: return KEY_SLASH;\n", "")
    problems: darray[sview] = table_problems(changed_elisa, changed_native)
    assert problems.count == 2
    assert problems[0] == "KEY_A: Elisa 9 vs native 2001"
    assert problems[1] == "native keyboard switch does not return every KEY_ exactly once"


@test
def canonicalizes_python_integer_values_and_detects_duplicate_elisa_codes() -> void can[Memory.Allocate, Abort.Panic]:
    padded_elisa: sview = replace(Fixtures::ELISA, "KEY_A: i64 = 2001", "KEY_A: i64 = 0002001")
    assert table_problems(padded_elisa, Fixtures::NATIVE).count == 0
    duplicate_elisa: sview = replace(Fixtures::ELISA, "KEY_SLASH: i64 = 2083", "KEY_SLASH: i64 = 2001")
    problems: darray[sview] = table_problems(duplicate_elisa, Fixtures::NATIVE)
    assert problems.count == 2
    assert problems[0] == "KEY_SLASH: Elisa 2001 vs native 2083"
    assert problems[1] == "duplicate Elisa code values"


@test
def reports_absent_tables_enum_drift_and_duplicate_keyboard_mappings() -> void can[Memory.Allocate, Abort.Panic]:
    assert table_problems("", "")[0] == "no input codes found"
    changed_enum: sview = replace(Fixtures::ELISA, "                KeyboardKeyCode.Slash: PortableInputCodes::KEY_SLASH\n", "")
    problems: darray[sview] = table_problems(changed_enum, Fixtures::NATIVE)
    assert problems.count == 1
    assert problems[0] == "KeyboardKeyCode members and keyboard_key_code arms differ"
    duplicated_mapping: sview = Fixtures::ELISA + "                KeyboardKeyCode.A: PortableInputCodes::KEY_A\n"
    problems <- table_problems(duplicated_mapping, Fixtures::NATIVE)
    assert problems.count == 1
    assert problems[0] == "KeyboardKeyCode members and keyboard_key_code arms differ"
