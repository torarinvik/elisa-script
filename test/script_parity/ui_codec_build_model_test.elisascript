# Pure recipe/status fixtures. No compiler or codec test runs here.
include "../../src/runtime/ui_codec_build_model.elisa"

using EsUiCodecBuild


@test
def ui_codec_build_recipe_preserves_exact_flags_and_path_arguments() -> void:
    can Memory.Allocate, Abort.Panic:
        planned: Recipe = try recipe("/project with spaces", "/temporary with spaces") else err:
            assert false
            return
        expected: darray[sview] = ["-std=c11", "-O2", "-Wall", "-Wextra", "-Werror", "-fsanitize=address,undefined", "-fno-omit-frame-pointer", "-I/project with spaces/src/platform/common", "/project with spaces/test/utf8_utf16_codec_test.c", "-o", "/temporary with spaces/utf8_utf16_codec_test"]
        assert planned.compiler == "clang"
        assert planned.arguments.count == 11 and planned.arguments.count == expected.count
        for index in 0..<expected.count:
            assert planned.arguments[index] == expected[index]
        assert planned.executable == expected[10]
        assert Defaults::TIMEOUT_MICROS == 0


@test
def ui_codec_compiler_override_is_one_literal_executable() -> void:
    can Memory.Allocate, Abort.Panic:
        planned: Recipe = try recipe("/project $HOME ; *", "/temporary", "tools/clang with spaces -not-an-argument") else err:
            assert false
            return
        assert planned.compiler == "tools/clang with spaces -not-an-argument"
        assert planned.arguments[7] == "-I/project $HOME ; */src/platform/common"
        empty: Recipe = try recipe("/project", "/temporary", "") else err:
            assert false
            return
        assert empty.compiler == "clang"


@test
def ui_codec_compile_failure_skips_test_and_cleanup_preserves_status() -> void:
    can Memory.Allocate, Abort.Panic:
        assert after_compile(0) == Phase.Run
        for status in [1i64, 2i64, 23i64, 126i64, 127i64, 255i64]:
            assert after_compile(status) == Phase.Cleanup
            assert final_status(status, true) == status
            assert final_status(status, false) == status
        assert final_status(0, false) == 0


@test
def ui_codec_build_recipe_rejects_invalid_path_and_nul_inputs() -> void:
    can Memory.Allocate, Abort.Panic:
        rejected: mutable bool = false
        catch recipe("relative", "/temporary"):
            ok _:
                assert false
            error failure:
                rejected <- failure == RecipeError.InvalidRoot
        assert rejected
        invalid_temp: mutable bool = false
        catch recipe("/project", "/"):
            ok _:
                assert false
            error failure:
                invalid_temp <- failure == RecipeError.InvalidTemporaryRoot
        assert invalid_temp
        invalid_compiler: mutable bool = false
        catch recipe("/project", "/temporary", "clang\0suffix"):
            ok _:
                assert false
            error failure:
                invalid_compiler <- failure == RecipeError.InvalidCompiler
        assert invalid_compiler
