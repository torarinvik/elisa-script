# Independent ordinary reference observations for a future isolated matrix.
# No candidate, model, host adapter, Bash runner or authorization is imported.
module EsLspCompilerRootCases:
    public:
        const module Fixture:
            CASES: usize = 8


        const enum Topology of u8:
            MissingCompilerSibling
            ExistingCompilerSibling
            ExistingOverrideDirectory
            ExistingOverrideFile
            OverrideDirectorySymlink


        struct Case:
            label: sview
            topology: Topology
            override_present: bool
            override_value: sview
            expected_stdout: sview
            expected_status: i64 = 0
            expected_stderr: sview = ""


        # The caller supplies a canonical private fixture root. Every path
        # below is a literal fixture layout, not candidate-derived output.
        def ordinary(root: sview) -> darray[Case] can[Memory.Allocate, Abort.Panic]:
            return [
                Case{label: "unset-missing-default", topology: Topology.MissingCompilerSibling, override_present: false, override_value: "", expected_stdout: root + "/Elisa-LSP/../Elisa-compiler\n"},
                Case{label: "empty-missing-default", topology: Topology.MissingCompilerSibling, override_present: true, override_value: "", expected_stdout: root + "/Elisa-LSP/../Elisa-compiler\n"},
                Case{label: "relative-missing-literal", topology: Topology.MissingCompilerSibling, override_present: true, override_value: "missing ; $HOME/*.elisa", expected_stdout: "missing ; $HOME/*.elisa\n"},
                Case{label: "absolute-missing-literal", topology: Topology.MissingCompilerSibling, override_present: true, override_value: root + "/missing compiler", expected_stdout: root + "/missing compiler\n"},
                Case{label: "existing-regular-file", topology: Topology.ExistingOverrideFile, override_present: true, override_value: root + "/not-directory", expected_stdout: root + "/not-directory\n"},
                Case{label: "existing-directory", topology: Topology.ExistingOverrideDirectory, override_present: true, override_value: root + "/compiler checkout", expected_stdout: root + "/compiler checkout\n"},
                Case{label: "directory-symlink", topology: Topology.OverrideDirectorySymlink, override_present: true, override_value: root + "/link", expected_stdout: root + "/compiler checkout\n"},
                Case{label: "unset-existing-default", topology: Topology.ExistingCompilerSibling, override_present: false, override_value: "", expected_stdout: root + "/Elisa-compiler\n"}
            ]
