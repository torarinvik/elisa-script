# Independent ordinary-case oracle for the smallest wrapper.
# No port, launcher, process runner, native bridge or authorization is imported.
# A case's status is a normally returned probe exit, NOT an exec-failure oracle.
module EsCanonicalLintCases:
    public:
        const enum Selection of u8:
            Unset
            Empty
            Relative
            Absolute
            PathName


        struct Case:
            reference: sview
            candidate: sview
            variable: sview
            selection: Selection
            arguments: darray[sview]
            expected_argv: darray[sview]
            status: i64


        def ordinary() -> darray[Case] can[Memory.Allocate, Abort.Panic]:
            return [
                Case{reference: "lint_canonical.sh", candidate: "lint_canonical.elisascript", variable: "RUFF_BIN", selection: Selection.Unset, arguments: ["ignored", ""], expected_argv: ["check", "src", "tests", "experiments/brainworkshop_canonical"], status: 0},
                Case{reference: "lint_canonical.sh", candidate: "lint_canonical.elisascript", variable: "RUFF_BIN", selection: Selection.Empty, arguments: [], expected_argv: ["check", "src", "tests", "experiments/brainworkshop_canonical"], status: 23},
                Case{reference: "lint_canonical.sh", candidate: "lint_canonical.elisascript", variable: "RUFF_BIN", selection: Selection.Relative, arguments: [], expected_argv: ["check", "src", "tests", "experiments/brainworkshop_canonical"], status: 1},
                Case{reference: "lint_canonical.sh", candidate: "lint_canonical.elisascript", variable: "RUFF_BIN", selection: Selection.Absolute, arguments: [], expected_argv: ["check", "src", "tests", "experiments/brainworkshop_canonical"], status: 2},
                Case{reference: "lint_canonical.sh", candidate: "lint_canonical.elisascript", variable: "RUFF_BIN", selection: Selection.PathName, arguments: ["", "a b", "*.py", "$HOME", "; exit 99", "--"], expected_argv: ["check", "src", "tests", "experiments/brainworkshop_canonical"], status: 23},
                Case{reference: "lint_canonical.sh", candidate: "lint_canonical.elisascript", variable: "RUFF_BIN", selection: Selection.Relative, arguments: ["--help"], expected_argv: ["check", "src", "tests", "experiments/brainworkshop_canonical"], status: 126},
                Case{reference: "lint_canonical.sh", candidate: "lint_canonical.elisascript", variable: "RUFF_BIN", selection: Selection.Absolute, arguments: ["--version"], expected_argv: ["check", "src", "tests", "experiments/brainworkshop_canonical"], status: 127},
                Case{reference: "lint_canonical.sh", candidate: "lint_canonical.elisascript", variable: "RUFF_BIN", selection: Selection.Empty, arguments: ["ignored", ""], expected_argv: ["check", "src", "tests", "experiments/brainworkshop_canonical"], status: 255}
            ]
