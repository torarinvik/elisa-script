# Gated public-launcher parity smoke for check_csv_model.sh and its port.
# Run only through scripts/run_bounded_test.sh after explicit reauthorization.
# This compares the checked-in success path; no validation is run at author time.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsCsvAuditLauncherParity:
    private:
        const module Commands:
            REFERENCE_SHELL: sview = "/bin/bash"
            REFERENCE_SCRIPT: sview = "scripts/check_csv_model.sh"
            CANDIDATE_SCRIPT: sview = "scripts/check_csv_model.elisascript"
            BOUNDED_READER: sview = "src/runtime/bounded_text_posix.elisa"
            ENCODING: sview = "src/runtime/encoding.elisa"
            FILE_RUNTIME: sview = "src/runtime/file_posix.elisa"
            DIRECTORY_RUNTIME: sview = "src/runtime/directory_posix.elisa"
            STDIO_RUNTIME: sview = "src/runtime/stdio_posix.elisa"
            MODEL: sview = "src/runtime/csv_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            RUNTIME_FIXTURE: sview = "test/runtime/csv_empty_input_test.elisa"
            DOCS: sview = "docs/ir.md"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            RG_TOOL: sview = "/opt/homebrew/bin/rg"
            CONTROLLED_PATH: sview = "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            REFERENCE_SHA256: sview = "72ca2f8aba541e27a9d82509f8b1b7e3be3cf1fc7469a5e4edaf8241f637b902"
            CANDIDATE_SHA256: sview = "24d7416e390408615bf936317c6ae08120bd32c353aeb2e4b8017cd67ebf0232"
            READER_SHA256: sview = "f648d319aca3610e245452d681c21556cc58a774982ea8d0bbda2cca4f1823be"
            ENCODING_SHA256: sview = "67815c728730d891c2e5fc0cc53a33d672d0f40003cfd468de903c4fbfcd9a53"
            FILE_RUNTIME_SHA256: sview = "14e1e3a9f0d95ee3e45509bd7d76c1ba2694992d5530f82edf8533d9cf149643"
            DIRECTORY_RUNTIME_SHA256: sview = "065d21370e93a1487a5ccc0adcfff5dcc04aa78e98361de181eeb08dbc0d402d"
            STDIO_RUNTIME_SHA256: sview = "c02cac5eec931a2f2aa9131616482df4e17333948961c4b6d0d215b0ab0e766c"
            MODEL_SHA256: sview = "7b87c42bd8d0d1d04d93c377b1c1a74f4b2fe9018b0c2c3106e322d44e9a72f4"
            IR_SHA256: sview = "fc37a80ac754a9b6460f8159ad3338491935bd6681317d84576fa1f5b825dbc8"
            FIXTURE_SHA256: sview = "3e2a6804da72573665ea28a13e9cf90f90df41f072df05ec0ac9c1a6c2d50583"
            RUNTIME_FIXTURE_SHA256: sview = "4528800f27b32305d3764856fc32cedce14d9210b6472dd61fc9d2bfe2708733"
            DOCS_SHA256: sview = "7a01ee9a0c010feaea11f4927d9658202c2ca7eb6652c8a1b03480155044f831"
            SHA256_TOOL_SHA256: sview = "0812595f981a26f813d98dc380af14d4af427626c9339eda29eb849ae13de1e3"
            RG_TOOL_SHA256: sview = "1c57905960cd69dbb5d05492560957f4a57cdd4d39137e20de23981c6e1f4423"
            MAX_HASHED_FILE_BYTES: usize = 67108864
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_OUTPUT_BYTES: u64 = 262144
            TIMEOUT_STEPS: u64 = 10000


        def paths_have_sha256(paths: darray[sview], expected_hashes: darray[sview]) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if paths.count == 0 or paths.count != expected_hashes.count or paths.count > 20
            arguments: mutable darray[sview] = ["-a", "256"]
            expected_output: mutable sview = ""
            for index in 0..<paths.count |paths, expected_hashes, arguments, expected_output|:
                path_text: sview = paths[index]
                expected_hex: sview = expected_hashes[index]
                return false if len(expected_hex) != 64
                source_path: Path = path(path_text)
                return false if not is_file(source_path)
                source_size: usize = try file_size(source_path) else err:
                    return false
                return false if source_size == 0 or source_size > Commands::MAX_HASHED_FILE_BYTES
                arguments.push(path_text)
                expected_output <- expected_output + expected_hex + "  " + path_text + "\n"
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "csv-audit-source-set-sha256",
                target: Commands::SHA256_TOOL,
                arguments: arguments,
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false
            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            return hash_run.stdout == expected_output


        def file_has_sha256(path_text: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return paths_have_sha256([path_text], [expected_hex])


        def source_set_is_pinned() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            paths: darray[sview] = [Commands::REFERENCE_SCRIPT, Commands::CANDIDATE_SCRIPT, Commands::BOUNDED_READER, Commands::ENCODING, Commands::FILE_RUNTIME, Commands::DIRECTORY_RUNTIME, Commands::STDIO_RUNTIME, Commands::MODEL, Commands::IR, Commands::FIXTURE, Commands::RUNTIME_FIXTURE, Commands::DOCS, Commands::SHA256_TOOL, Commands::RG_TOOL]
            hashes: darray[sview] = [Commands::REFERENCE_SHA256, Commands::CANDIDATE_SHA256, Commands::READER_SHA256, Commands::ENCODING_SHA256, Commands::FILE_RUNTIME_SHA256, Commands::DIRECTORY_RUNTIME_SHA256, Commands::STDIO_RUNTIME_SHA256, Commands::MODEL_SHA256, Commands::IR_SHA256, Commands::FIXTURE_SHA256, Commands::RUNTIME_FIXTURE_SHA256, Commands::DOCS_SHA256, Commands::SHA256_TOOL_SHA256, Commands::RG_TOOL_SHA256]
            return paths_have_sha256(paths, hashes)


        def checked_in_launchers_match(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference_path: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate_path: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "shell-csv-model-audit-reference",
                target: Commands::REFERENCE_SHELL,
                arguments: [f"{reference_path}"],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-csv-model-audit",
                target: launcher,
                arguments: [f"{candidate_path}"],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    print("CSV model audit shell reference process failed")
                    return false
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    print("CSV model audit Elisascript process failed")
                    return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return false if reference_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed or not comparison.equal
            return false if reference_run.exit_status != 0 or reference_run.stdout != "csv model audit: quote-aware bounded stream transitions and explicit line endings are present\n" or reference_run.stderr != ""
            return false if candidate_run.exit_status != 0 or candidate_run.stdout != reference_run.stdout or candidate_run.stderr != reference_run.stderr
            return true


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def public_launcher_parity(launcher: sview, launcher_hash: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            return false if not file_has_sha256(launcher, launcher_hash)
            return false if not source_set_is_pinned()
            return false if not checked_in_launchers_match(launcher)
            return source_set_is_pinned() and file_has_sha256(launcher, launcher_hash)


@test
def csv_model_audit_public_launcher_matches_pinned_shell_reference() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, Directory.Read, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsCsvAuditLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsCsvAuditLauncherParity::pinned_compiler_path()
        assert launcher != "" and launcher.startswith("/")
        assert EsCsvAuditLauncherParity::public_launcher_parity(launcher, launcher_hash)
