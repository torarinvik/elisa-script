# Independently authored expected-frame builder for the native process probe.
# This encodes observations supplied by a fixture; it never runs a process.
module EsProcessProbe:
    public:
        const module Limits:
            ARGUMENTS: usize = 256
            TEXT_BYTES: usize = 65536
            STDIN_BYTES: usize = 65536
            CWD_BYTES: usize = 4095


        struct EnvironmentValue:
            present: bool = false
            bytes: darray[u8] = []


        struct Observation:
            arguments: darray[darray[u8]] = []
            cwd: darray[u8]
            python_bin: EnvironmentValue = EnvironmentValue{}
            ruff_bin: EnvironmentValue = EnvironmentValue{}
            marker: EnvironmentValue = EnvironmentValue{}
            pwd: EnvironmentValue = EnvironmentValue{}
            oldpwd: EnvironmentValue = EnvironmentValue{}
            stdin: darray[u8] = []


        error FrameError:
            ArgumentLimit
            TextLimit
            StdinLimit
            InvalidCwd
            EmbeddedNul
            AbsentEnvironmentPayload


        def text_bytes(value: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            bytes: mutable darray[u8] = []
            for byte in value:
                bytes.push(byte)
            return bytes


        def expected_stdout(value: Observation) -> darray[u8] error[FrameError] can[Memory.Allocate, Abort.Panic]:
            raise FrameError.ArgumentLimit if value.arguments.count > Limits::ARGUMENTS
            raise FrameError.InvalidCwd if value.cwd.count == 0 or value.cwd.count > Limits::CWD_BYTES or value.cwd[0] != 47u8
            raise FrameError.StdinLimit if value.stdin.count > Limits::STDIN_BYTES
            budget: mutable usize = Limits::TEXT_BYTES
            for argument in value.arguments |budget|:
                try admit_text(argument, budget)
            try admit_text(value.cwd, budget)
            try admit_environment(value.python_bin, budget)
            try admit_environment(value.ruff_bin, budget)
            try admit_environment(value.marker, budget)
            try admit_environment(value.pwd, budget)
            try admit_environment(value.oldpwd, budget)

            output: mutable darray[u8] = [69u8, 83u8, 80u8, 82u8, 79u8, 66u8, 69u8, 50u8]
            append_u32(output, value.arguments.count)
            for argument in value.arguments:
                append_field(output, argument)
            append_field(output, value.cwd)
            append_environment(output, value.python_bin)
            append_environment(output, value.ruff_bin)
            append_environment(output, value.marker)
            append_environment(output, value.pwd)
            append_environment(output, value.oldpwd)
            append_field(output, value.stdin)
            output.push(0u8)
            output.push(255u8)
            return output


        def expected_stderr() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [112u8, 114u8, 111u8, 98u8, 101u8, 45u8, 115u8, 116u8, 100u8, 101u8, 114u8, 114u8, 0u8, 255u8]

    private:
        def admit_text(bytes: darray[u8], budget: mutable usize&) -> void error[FrameError]:
            raise FrameError.TextLimit if bytes.count > budget
            for byte in bytes:
                raise FrameError.EmbeddedNul if byte == 0u8
            budget <- budget - bytes.count


        def admit_environment(value: EnvironmentValue, budget: mutable usize&) -> void error[FrameError]:
            if not value.present:
                raise FrameError.AbsentEnvironmentPayload if value.bytes.count != 0
                return
            try admit_text(value.bytes, budget)


        # All callers have already admitted counts <= 65,536 (argv <= 256).
        def append_u32(output: mutable darray[u8]&, value: usize) -> void can[Memory.Allocate, Abort.Panic]:
            output.push(((value >> 24) & 255).u8())
            output.push(((value >> 16) & 255).u8())
            output.push(((value >> 8) & 255).u8())
            output.push((value & 255).u8())


        def append_field(output: mutable darray[u8]&, bytes: darray[u8]) -> void can[Memory.Allocate, Abort.Panic]:
            append_u32(output, bytes.count)
            for byte in bytes:
                output.push(byte)


        def append_environment(output: mutable darray[u8]&, value: EnvironmentValue) -> void can[Memory.Allocate, Abort.Panic]:
            output.push(1u8 if value.present else 0u8)
            append_field(output, value.bytes) if value.present
