# Process-level parity for the bounded record-aggregate audit port.
# Run only through the bounded validation wrapper after explicit reauthorization.
# Generated roots contain copies of bounded source inputs, never executable fixtures.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsRecordAggregateLauncherParity:
    private:
        const module Commands:
            REFERENCE_SHELL: sview = "/bin/bash"
            REFERENCE_SCRIPT: sview = "scripts/check_record_aggregate.sh"
            CANDIDATE_SCRIPT: sview = "scripts/check_record_aggregate.elisascript"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            CONTROLLED_PATH: sview = "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            MAX_LAUNCHER_BYTES: usize = 67108864
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_OUTPUT_BYTES: u64 = 1048576
            TIMEOUT_STEPS: u64 = 10000


        const module Limits:
            SOURCE_BYTES: usize = 16777216
            TOTAL_SOURCE_BYTES: usize = 4194304
            CANDIDATE_BYTES: usize = 1048576
            REFERENCE_BYTES: usize = 65536


        const module Inputs:
            MODEL: sview = "src/runtime/record_aggregate_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        struct ExpectedCase:
            repository_root: sview
            exit_status: i64
            stdout: sview
            stderr: sview
            working_directory: sview = ""
            use_default_root: bool = false
            extra_arguments: darray[sview] = []


        struct InputSource:
            relative_path: sview
            contents: sview


        struct SemanticNeedle:
            relative_path: sview
            needle: sview


        struct GeneratedRoot:
            path: Path
            sources: darray[InputSource]
            created: bool = false


        struct TemporaryDirectory:
            path: Path
            created: bool = false


        def make_temporary_directory(prefix: sview) -> TemporaryDirectory can[Memory.Allocate, Abort.Panic, File.Write]:
            created_path: Path = try temp_directory(prefix) else err:
                return TemporaryDirectory{path: path("."), created: false}
            return TemporaryDirectory{path: created_path, created: true}


        def write_fixture_text(target: Path, contents: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            written: usize = try write_text(target, contents) else 0u64
            return written == len(contents)


        def write_fixture_bytes(target: Path, contents: darray[u8]) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            written: usize = try write_bytes(target, contents) else 0u64
            return written == contents.count


        def remove_fixture_path(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            return try remove_path(target) else false


        def remove_fixture_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try remove_directory(target) else false


        def append_text_bytes(target: mutable darray[u8]&, value: sview) -> void can[Memory.Allocate, Abort.Panic]:
            for byte in value |target|:
                target.push(byte)


        def source_contents(sources: darray[InputSource], relative_path: sview) -> sview:
            for source in sources:
                return source.contents if source.relative_path == relative_path
            return ""


        def all_input_paths() -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            return [Inputs::MODEL, Inputs::IR, Inputs::FIXTURE, Inputs::DOCS, Inputs::LEDGER]


        def create_fixture_root() -> GeneratedRoot can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write]:
            temporary: TemporaryDirectory = make_temporary_directory("elisascript-record-aggregate-parity")
            return GeneratedRoot{path: path("."), sources: [], created: false} if not temporary.created
            root: Path = try path_real(temporary.path) else err:
                _ = remove_fixture_directory(temporary.path)
                return GeneratedRoot{path: path("."), sources: [], created: false}

            source_sizes: mutable darray[usize] = []
            total_source_bytes: mutable usize = 0
            for relative in all_input_paths() |temporary, source_sizes, total_source_bytes|:
                source_path: Path = path(relative)
                if not is_file(source_path):
                    _ = remove_fixture_directory(temporary.path)
                    return GeneratedRoot{path: path("."), sources: [], created: false}
                source_size: usize = try file_size(source_path) else err:
                    _ = remove_fixture_directory(temporary.path)
                    return GeneratedRoot{path: path("."), sources: [], created: false}
                if source_size > Limits::SOURCE_BYTES or source_size > Limits::TOTAL_SOURCE_BYTES - total_source_bytes:
                    _ = remove_fixture_directory(temporary.path)
                    return GeneratedRoot{path: path("."), sources: [], created: false}
                total_source_bytes <- total_source_bytes + source_size
                source_sizes.push(source_size)

            directories: darray[Path] = [
                root.joinpath("src"),
                root.joinpath("src").joinpath("runtime"),
                root.joinpath("src").joinpath("ir"),
                root.joinpath("test"),
                root.joinpath("test").joinpath("ir"),
                root.joinpath("docs"),
                root.joinpath("docs").joinpath("capabilities"),
                root.joinpath("scripts")
            ]
            for directory in directories:
                directory_created: bool = try create_directory(directory) else false
                if not directory_created:
                    _ = remove_fixture_directory(root.joinpath("scripts"))
                    _ = remove_fixture_directory(root.joinpath("docs").joinpath("capabilities"))
                    _ = remove_fixture_directory(root.joinpath("docs"))
                    _ = remove_fixture_directory(root.joinpath("test").joinpath("ir"))
                    _ = remove_fixture_directory(root.joinpath("test"))
                    _ = remove_fixture_directory(root.joinpath("src").joinpath("ir"))
                    _ = remove_fixture_directory(root.joinpath("src").joinpath("runtime"))
                    _ = remove_fixture_directory(root.joinpath("src"))
                    _ = remove_fixture_directory(root)
                    return GeneratedRoot{path: path("."), sources: [], created: false}

            sources: mutable darray[InputSource] = []
            source_index: mutable usize = 0
            for relative in all_input_paths() |root, sources, source_index|:
                original: sview = try read_text(path(relative)) else err:
                    _ = remove_generated_root(root)
                    return GeneratedRoot{path: path("."), sources: [], created: false}
                source_size_after_read: usize = try file_size(path(relative)) else err:
                    _ = remove_generated_root(root)
                    return GeneratedRoot{path: path("."), sources: [], created: false}
                if source_size_after_read != source_sizes[source_index]:
                    _ = remove_generated_root(root)
                    return GeneratedRoot{path: path("."), sources: [], created: false}
                target: Path = path_join(root, relative)
                if not write_fixture_text(target, original):
                    _ = remove_generated_root(root)
                    return GeneratedRoot{path: path("."), sources: [], created: false}
                sources.push(InputSource{relative_path: relative, contents: original})
                source_index <- source_index + 1

            candidate_path: Path = path(Commands::CANDIDATE_SCRIPT)
            if not is_file(candidate_path):
                _ = remove_generated_root(root)
                return GeneratedRoot{path: path("."), sources: [], created: false}
            candidate_size: usize = try file_size(candidate_path) else err:
                _ = remove_generated_root(root)
                return GeneratedRoot{path: path("."), sources: [], created: false}
            if candidate_size > Limits::CANDIDATE_BYTES:
                _ = remove_generated_root(root)
                return GeneratedRoot{path: path("."), sources: [], created: false}
            candidate: sview = try read_text(candidate_path) else err:
                _ = remove_generated_root(root)
                return GeneratedRoot{path: path("."), sources: [], created: false}
            candidate_size_after_read: usize = try file_size(candidate_path) else err:
                _ = remove_generated_root(root)
                return GeneratedRoot{path: path("."), sources: [], created: false}
            if candidate_size_after_read != candidate_size:
                _ = remove_generated_root(root)
                return GeneratedRoot{path: path("."), sources: [], created: false}
            if not write_fixture_text(path_join(root, Commands::CANDIDATE_SCRIPT), candidate):
                _ = remove_generated_root(root)
                return GeneratedRoot{path: path("."), sources: [], created: false}
            reference_path: Path = path(Commands::REFERENCE_SCRIPT)
            if not is_file(reference_path):
                _ = remove_generated_root(root)
                return GeneratedRoot{path: path("."), sources: [], created: false}
            reference_size: usize = try file_size(reference_path) else err:
                _ = remove_generated_root(root)
                return GeneratedRoot{path: path("."), sources: [], created: false}
            if reference_size == 0 or reference_size > Limits::REFERENCE_BYTES:
                _ = remove_generated_root(root)
                return GeneratedRoot{path: path("."), sources: [], created: false}
            reference: sview = try read_text(reference_path) else err:
                _ = remove_generated_root(root)
                return GeneratedRoot{path: path("."), sources: [], created: false}
            reference_size_after_read: usize = try file_size(reference_path) else err:
                _ = remove_generated_root(root)
                return GeneratedRoot{path: path("."), sources: [], created: false}
            if reference_size_after_read != reference_size:
                _ = remove_generated_root(root)
                return GeneratedRoot{path: path("."), sources: [], created: false}
            if not write_fixture_text(path_join(root, Commands::REFERENCE_SCRIPT), reference):
                _ = remove_generated_root(root)
                return GeneratedRoot{path: path("."), sources: [], created: false}
            return GeneratedRoot{path: root, sources: sources, created: true}


        def remove_generated_root(root: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            all_removed: mutable bool = true
            for relative in all_input_paths() |root, all_removed|:
                all_removed <- remove_fixture_path(path_join(root, relative)) and all_removed
            all_removed <- remove_fixture_path(path_join(root, Commands::CANDIDATE_SCRIPT)) and all_removed
            all_removed <- remove_fixture_path(path_join(root, Commands::REFERENCE_SCRIPT)) and all_removed
            all_removed <- remove_fixture_directory(root.joinpath("scripts")) and all_removed
            all_removed <- remove_fixture_directory(root.joinpath("docs").joinpath("capabilities")) and all_removed
            all_removed <- remove_fixture_directory(root.joinpath("docs")) and all_removed
            all_removed <- remove_fixture_directory(root.joinpath("test").joinpath("ir")) and all_removed
            all_removed <- remove_fixture_directory(root.joinpath("test")) and all_removed
            all_removed <- remove_fixture_directory(root.joinpath("src").joinpath("ir")) and all_removed
            all_removed <- remove_fixture_directory(root.joinpath("src").joinpath("runtime")) and all_removed
            all_removed <- remove_fixture_directory(root.joinpath("src")) and all_removed
            all_removed <- remove_fixture_directory(root) and all_removed
            return all_removed


        def lowercase_sha256_hex_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def launcher_has_expected_sha256(launcher: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            launcher_path: Path = path(launcher)
            return false if not is_file(launcher_path)
            launcher_size: usize = try file_size(launcher_path) else err:
                return false
            return false if launcher_size == 0 or launcher_size > Commands::MAX_LAUNCHER_BYTES

            hash_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-record-aggregate-sha256",
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", launcher],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(hash_runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false

            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            return false if hash_run.stdout != expected_hex + "  " + launcher + "\n"
            for index in 0..<64 |hash_run, expected_hex|:
                return false if not lowercase_sha256_hex_byte(sview_at(expected_hex, index))
            return true


        def launcher_case_matches(launcher: sview, test_case: ExpectedCase) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference_script: mutable Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate_script: mutable Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            if not test_case.use_default_root:
                reference_script_in_root: Path = path_join(path(test_case.repository_root), Commands::REFERENCE_SCRIPT)
                if is_file(reference_script_in_root):
                    reference_script <- try path_real(reference_script_in_root) else err:
                        return false
                candidate_script_in_root: Path = path_join(path(test_case.repository_root), Commands::CANDIDATE_SCRIPT)
                if is_file(candidate_script_in_root):
                    candidate_script <- try path_real(candidate_script_in_root) else err:
                        return false
            reference_arguments: mutable darray[sview] = [f"{reference_script}"]
            candidate_arguments: mutable darray[sview] = [f"{candidate_script}"]
            if not test_case.use_default_root:
                reference_arguments.push(test_case.repository_root)
                candidate_arguments.push(test_case.repository_root)
            for argument in test_case.extra_arguments |reference_arguments, candidate_arguments|:
                reference_arguments.push(argument)
                candidate_arguments.push(argument)

            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "shell-record-aggregate-reference",
                target: Commands::REFERENCE_SHELL,
                arguments: reference_arguments,
                working_directory: test_case.working_directory,
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    eprint("record aggregate shell reference process failed")
                    return false

            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-record-aggregate",
                target: launcher,
                arguments: candidate_arguments,
                working_directory: test_case.working_directory,
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    eprint("record aggregate Elisascript process failed")
                    return false

            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            if reference_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed or not comparison.equal:
                eprint("record aggregate process parity mismatch")
                return false
            if reference_run.exit_status != test_case.exit_status or reference_run.stdout != test_case.stdout or reference_run.stderr != test_case.stderr:
                eprint("record aggregate shell reference golden mismatch")
                return false
            if candidate_run.exit_status != test_case.exit_status or candidate_run.stdout != test_case.stdout or candidate_run.stderr != test_case.stderr:
                eprint("record aggregate Elisascript golden mismatch")
                return false
            return true


        def source_semantic_needles() -> darray[SemanticNeedle] can[Memory.Allocate, Abort.Panic]:
            return [
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "module EsRecordAggregate:"},
                SemanticNeedle{relative_path: Inputs::IR, needle: "include \"../runtime/record_aggregate_model.elisa\""},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "const enum RecordAggregateState of u8"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "const enum RecordAggregateEvent of u8"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "struct RecordAggregatePolicy:"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "struct RecordAggregateGroup:"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "struct RecordAggregateSession:"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "error RecordAggregateError:"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "def validate_record_aggregate("},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "def record_aggregate_group_count("},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "def record_aggregate_group_sum("},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "def advance_record_aggregate("},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "RECORD_AGGREGATE_MAX_GROUPS"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "RECORD_AGGREGATE_MAX_EVENTS"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "RECORD_AGGREGATE_MAX_KEY_BYTES"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "RECORD_AGGREGATE_MAX_SUM"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "record_aggregate_key_valid"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "sview_len(key) <= policy.max_key_bytes"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "RecordAggregateError.GroupLimitExceeded"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "RecordAggregateError.EventLimitExceeded"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "RecordAggregateError.KeyBytesLimitExceeded"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "RecordAggregateError.AccountingInvalid"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "session.state == RecordAggregateState.Planned and"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "accounted_events"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "previous_first_ordinal"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "group.first_ordinal <= previous_first_ordinal"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "RecordAggregateError.GroupIndexInvalid"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "RecordAggregateEvent.Add"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "RecordAggregateEvent.AddValue"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "SumLimitExceeded"},
                SemanticNeedle{relative_path: Inputs::MODEL, needle: "RecordAggregateEvent.Seal"},
                SemanticNeedle{relative_path: Inputs::FIXTURE, needle: "using EsRecordAggregate"},
                SemanticNeedle{relative_path: Inputs::FIXTURE, needle: "typed_record_aggregate_contract_is_bounded_and_insertion_ordered"},
                SemanticNeedle{relative_path: Inputs::FIXTURE, needle: "RecordAggregateEvent.Add"},
                SemanticNeedle{relative_path: Inputs::FIXTURE, needle: "record_aggregate_group_count"},
                SemanticNeedle{relative_path: Inputs::FIXTURE, needle: "max_key_bytes: 5"},
                SemanticNeedle{relative_path: Inputs::FIXTURE, needle: "\"12345\""},
                SemanticNeedle{relative_path: Inputs::FIXTURE, needle: "forged_aggregate_order"},
                SemanticNeedle{relative_path: Inputs::FIXTURE, needle: "RecordAggregateError.GroupIndexInvalid"},
                SemanticNeedle{relative_path: Inputs::DOCS, needle: "EsRecordAggregate::RecordAggregateSession"},
                SemanticNeedle{relative_path: Inputs::LEDGER, needle: "ES-SCRIPT-027"}
            ]


        def generated_inputs_match(launcher: sview, source_root: GeneratedRoot) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            root_text: sview = f"{source_root.path}"
            for relative in all_input_paths() |root_text|:
                target: Path = path_join(source_root.path, relative)
                removed: bool = remove_fixture_path(target)
                expected_path: sview = root_text + "/" + relative
                expected: ExpectedCase = ExpectedCase{
                    repository_root: root_text,
                    exit_status: 1,
                    stdout: "",
                    stderr: "record aggregate audit: missing " + expected_path + "\n"
                }
                matched: bool = launcher_case_matches(launcher, expected)
                restored: bool = write_fixture_text(target, source_contents(source_root.sources, relative))
                return false if not removed or not matched or not restored

            return true


        def aggregate_boundary_matches(launcher: sview, source_root: GeneratedRoot) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            root_text: sview = f"{source_root.path}"
            total_bytes: mutable usize = 0
            for relative in all_input_paths() |source_root, total_bytes|:
                source_size: usize = try file_size(path_join(source_root.path, relative)) else err:
                    return false
                total_bytes <- total_bytes + source_size
            return false if total_bytes > Limits::TOTAL_SOURCE_BYTES

            original_docs: sview = source_contents(source_root.sources, Inputs::DOCS)
            padded_docs: mutable darray[u8] = []
            append_text_bytes(padded_docs, original_docs)
            padding_bytes: usize = Limits::TOTAL_SOURCE_BYTES - total_bytes
            for _ in 0..<(padding_bytes / 2) |padded_docs|:
                padded_docs.push(195u8)
                padded_docs.push(169u8)
            if padding_bytes % 2 == 1:
                padded_docs.push(32u8)
            docs_path: Path = path_join(source_root.path, Inputs::DOCS)
            if not write_fixture_bytes(docs_path, padded_docs):
                return false

            success: ExpectedCase = ExpectedCase{
                repository_root: root_text,
                exit_status: 0,
                stdout: "record aggregate audit: bounded insertion-ordered groups and sealed lookup are present\n",
                stderr: ""
            }
            exact_ok: bool = launcher_case_matches(launcher, success)
            padded_docs.push(32u8)
            over_limit_written: bool = write_fixture_bytes(docs_path, padded_docs)
            over_limit: ExpectedCase = ExpectedCase{
                repository_root: root_text,
                exit_status: 2,
                stdout: "",
                stderr: "record aggregate audit: source exceeds audit limit: " + root_text + "/docs/ir.md\n"
            }
            ledger_path: Path = path_join(source_root.path, Inputs::LEDGER)
            ledger_removed: bool = remove_fixture_path(ledger_path)
            missing_precedes_overflow: ExpectedCase = ExpectedCase{
                repository_root: root_text,
                exit_status: 1,
                stdout: "",
                stderr: "record aggregate audit: missing " + root_text + "/docs/capabilities/ledger.md\n"
            }
            precedence_ok: bool = over_limit_written and ledger_removed and launcher_case_matches(launcher, missing_precedes_overflow)
            ledger_restored: bool = write_fixture_text(ledger_path, source_contents(source_root.sources, Inputs::LEDGER))
            over_limit_ok: bool = ledger_restored and launcher_case_matches(launcher, over_limit)
            original_docs_permissions: mutable u64 = 0u64
            docs_mode_known: mutable bool = false
            catch file_mode(docs_path):
                ok mode:
                    # stat mode includes file-type bits; chmod gets only the
                    # permission and special bits.
                    original_docs_permissions <- mode & 4095u64
                    docs_mode_known <- true
                error _:
                    original_docs_permissions <- 0u64
            docs_mode_changed: bool = docs_mode_known and (try chmod(docs_path, 0u64) else false)
            unreadable_observed: bool = docs_mode_changed and not is_readable(docs_path)
            unreadable_precedes_overflow: bool = if unreadable_observed:
                unreadable_case: ExpectedCase = ExpectedCase{
                    repository_root: root_text,
                    exit_status: 1,
                    stdout: "",
                    stderr: "record aggregate audit: missing " + root_text + "/docs/ir.md\n"
                }
                launcher_case_matches(launcher, unreadable_case)
            else:
                true
            restore_mode_ok: bool = not docs_mode_changed or (try chmod(docs_path, original_docs_permissions) else false)
            restored_docs_mode: u64 = try file_mode(docs_path) else 0u64
            docs_mode_restored: bool = restore_mode_ok and (not docs_mode_changed or (restored_docs_mode & 4095u64) == original_docs_permissions)
            restored: bool = write_fixture_text(docs_path, original_docs)
            return exact_ok and precedence_ok and over_limit_ok and unreadable_precedes_overflow and docs_mode_restored and restored


        def semantic_mutations_match(launcher: sview, source_root: GeneratedRoot) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            root_text: sview = f"{source_root.path}"
            mutations: darray[SemanticNeedle] = source_semantic_needles()
            for mutation in mutations |root_text, source_root|:
                original: sview = source_contents(source_root.sources, mutation.relative_path)
                return false if original.index(mutation.needle) < 0
                mutated: sview = original.replace(mutation.needle, "REMOVED_AUDIT_PATTERN")
                return false if mutated.index(mutation.needle) >= 0
                target: Path = path_join(source_root.path, mutation.relative_path)
                if not write_fixture_text(target, mutated):
                    return false
                expected: ExpectedCase = ExpectedCase{repository_root: root_text, exit_status: 1, stdout: "", stderr: ""}
                matched: bool = launcher_case_matches(launcher, expected)
                restored: bool = write_fixture_text(target, original)
                return false if not matched or not restored
            return true


        def script_relative_default_matches(launcher: sview, repository_root: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            expected: ExpectedCase = ExpectedCase{
                repository_root: repository_root,
                exit_status: 0,
                stdout: "record aggregate audit: bounded insertion-ordered groups and sealed lookup are present\n",
                stderr: "",
                working_directory: "/",
                use_default_root: true
            }
            return launcher_case_matches(launcher, expected)


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def all_launcher_cases_match(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            canonical_root: Path = try path_real(path(".")) else err:
                return false
            root_text: sview = f"{canonical_root}"
            success: ExpectedCase = ExpectedCase{
                repository_root: root_text,
                exit_status: 0,
                stdout: "record aggregate audit: bounded insertion-ordered groups and sealed lookup are present\n",
                stderr: ""
            }
            return false if not launcher_case_matches(launcher, success)
            return false if not script_relative_default_matches(launcher, root_text)

            usage: ExpectedCase = ExpectedCase{
                repository_root: root_text,
                exit_status: 2,
                stdout: "",
                stderr: "usage: record aggregate audit [repository-root]\n",
                extra_arguments: ["extra"]
            }
            return false if not launcher_case_matches(launcher, usage)

            missing_parent: TemporaryDirectory = make_temporary_directory("elisascript-record-aggregate-missing")
            return false if not missing_parent.created
            missing_root: Path = missing_parent.path.joinpath("absent")
            missing_root_case: ExpectedCase = ExpectedCase{
                repository_root: f"{missing_root}",
                exit_status: 1,
                stdout: "",
                stderr: "record aggregate audit: missing repository root\n"
            }
            missing_root_ok: bool = launcher_case_matches(launcher, missing_root_case)

            file_root: Path = missing_parent.path.joinpath("not-a-directory")
            file_root_created: bool = write_fixture_text(file_root, "not a directory\n")
            file_root_case: ExpectedCase = ExpectedCase{
                repository_root: f"{file_root}",
                exit_status: 1,
                stdout: "",
                stderr: "record aggregate audit: missing repository root\n"
            }
            file_root_ok: bool = file_root_created and launcher_case_matches(launcher, file_root_case)
            file_root_removed: bool = remove_fixture_path(file_root)
            missing_parent_removed: bool = remove_fixture_directory(missing_parent.path)
            return false if not missing_root_ok or not file_root_ok or not file_root_removed or not missing_parent_removed

            generated: GeneratedRoot = create_fixture_root()
            return false if not generated.created
            all_ok: mutable bool = generated_inputs_match(launcher, generated)
            all_ok <- aggregate_boundary_matches(launcher, generated) and all_ok
            all_ok <- semantic_mutations_match(launcher, generated) and all_ok
            cleanup_ok: bool = remove_generated_root(generated.path)
            return all_ok and cleanup_ok


@test
def record_aggregate_public_launcher_matches_shell_and_golden_output() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        assert reauthorized == "1"
        assert compiler == EsRecordAggregateLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsRecordAggregateLauncherParity::pinned_compiler_path()
        assert launcher != ""
        assert launcher.startswith("/")
        assert EsRecordAggregateLauncherParity::launcher_has_expected_sha256(launcher, launcher_hash)
        println("public_launcher_path=" + launcher)
        println("public_launcher_sha256=" + launcher_hash)
        assert EsRecordAggregateLauncherParity::all_launcher_cases_match(launcher)
        assert EsRecordAggregateLauncherParity::launcher_has_expected_sha256(launcher, launcher_hash)
