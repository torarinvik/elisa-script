# Process-level parity for ChordBrain's CMake packaging metadata smoke test.
# Run only through the bounded validation wrapper after explicit reauthorization.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsChordBrainPackagingLauncherParity:
    private:
        const module Commands:
            CMAKE: sview = "CMAKE_COMMAND"
            REFERENCE_SCRIPT: sview = "../ChordBrain/tests/packaging_metadata_smoke.cmake"
            CANDIDATE_SCRIPT: sview = "scripts/check_chordbrain_packaging.elisascript"
            FIXTURE_ROOT: sview = "test/fixtures/script_parity/chordbrain_packaging"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            REFERENCE_SHA256: sview = "b6af36f5d3b283e5bb1f1bd8924dcc14e6387ce2505e995031f8b5fbf4220e5c"
            CANDIDATE_SHA256: sview = "840da332c7623760e83f366786b80ce83b2a5560c4c3c2c9d3c841d671714a20"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_OUTPUT_BYTES: u64 = 65536
            TIMEOUT_STEPS: u64 = 10000


        def lowercase_sha256_hex_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def file_has_expected_sha256(file_path: sview, expected_hex: sview, process_name: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            hashed_path: Path = path(file_path)
            return false if not is_file(hashed_path)
            file_size_bytes: usize = try file_size(hashed_path) else err:
                return false
            return false if file_size_bytes == 0 or file_size_bytes > 67108864

            hash_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: process_name,
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", file_path],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(hash_runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false

            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            return false if hash_run.stdout != expected_hex + "  " + file_path + "\n"
            for index in 0..<64 |hash_run, expected_hex|:
                return false if not lowercase_sha256_hex_byte(sview_at(expected_hex, index))
            return true


        def launcher_has_expected_sha256(launcher: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return file_has_expected_sha256(launcher, expected_hex, "chordbrain-packaging-launcher-sha256")


        def fixture_name_is_safe(fixture_name: sview) -> bool:
            return false if len(fixture_name) > 64
            for index in 0..<len(fixture_name) |fixture_name|:
                byte: u8 = sview_at(fixture_name, index)
                if not (byte >= 48u8 and byte <= 57u8 or byte >= 65u8 and byte <= 90u8 or byte >= 97u8 and byte <= 122u8 or byte == 45u8 or byte == 95u8):
                    return false
            return true


        def fixture_matches(launcher: sview, cmake: sview, fixture_name: sview, expected_exit_status: i64, expected_stdout: sview, expected_stderr_fragment: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            return false if not fixture_name_is_safe(fixture_name)
            reference_script: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate_script: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            fixture_path: mutable Path = path(Commands::FIXTURE_ROOT)
            fixture_path <- fixture_path.joinpath(fixture_name) if fixture_name != ""
            fixture_root: Path = try path_real(fixture_path) else err:
                return false
            source_root: Path = fixture_root.joinpath("source")
            binary_root: Path = fixture_root.joinpath("build")
            source_text: sview = f"{source_root}"
            binary_text: sview = f"{binary_root}"

            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "cmake-chordbrain-packaging-reference",
                target: cmake,
                arguments: [
                    "-DCHORDBRAIN_SOURCE_DIR:PATH=" + source_text,
                    "-DCHORDBRAIN_BINARY_DIR:PATH=" + binary_text,
                    "-P",
                    f"{reference_script}"
                ],
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    print("ChordBrain CMake packaging reference process failed: " + fixture_name)
                    return false

            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "elisascript-chordbrain-packaging-candidate",
                target: launcher,
                arguments: [f"{candidate_script}", source_text, binary_text],
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    print("ChordBrain Elisascript packaging process failed: " + fixture_name)
                    return false

            if reference_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed:
                print("ChordBrain packaging process did not complete: " + fixture_name)
                return false
            if reference_run.exit_status != expected_exit_status or candidate_run.exit_status != expected_exit_status:
                print("ChordBrain packaging exit-status parity mismatch: " + fixture_name)
                return false
            if expected_exit_status == 0:
                comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
                if not comparison.equal or reference_run.stdout != expected_stdout or reference_run.stderr != "" or candidate_run.stderr != "":
                    print("ChordBrain packaging success-output parity mismatch: " + fixture_name)
                    return false
                return true

            if reference_run.stdout != "" or candidate_run.stdout != "":
                print("ChordBrain packaging failure wrote unexpected stdout: " + fixture_name)
                return false
            if expected_stderr_fragment == "" or reference_run.stderr.index(expected_stderr_fragment) < 0 or candidate_run.stderr.index(expected_stderr_fragment) < 0:
                print("ChordBrain packaging failure-diagnostic parity mismatch: " + fixture_name)
                return false
            return true


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def cmake_environment_name() -> sview:
            return Commands::CMAKE


        def reference_script_hash_matches() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference_script: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            return file_has_expected_sha256(f"{reference_script}", Commands::REFERENCE_SHA256, "chordbrain-packaging-reference-sha256")


        def candidate_script_hash_matches() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast]:
            candidate_script: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            return file_has_expected_sha256(f"{candidate_script}", Commands::CANDIDATE_SHA256, "chordbrain-packaging-candidate-sha256")


        def launcher_hash_matches(launcher: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return launcher_has_expected_sha256(launcher, expected_hex)


        def run_fixture(launcher: sview, cmake: sview, fixture_name: sview, expected_exit_status: i64, expected_stdout: sview, expected_stderr_fragment: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            return fixture_matches(launcher, cmake, fixture_name, expected_exit_status, expected_stdout, expected_stderr_fragment)


@test
def chordbrain_packaging_fixture_matrix_matches_cmake_and_elisascript() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, Directory.Read, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        cmake: sview = try getenv(EsChordBrainPackagingLauncherParity::cmake_environment_name(), "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsChordBrainPackagingLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsChordBrainPackagingLauncherParity::pinned_compiler_path()
        assert launcher != "" and launcher.startswith("/")
        assert cmake != "" and cmake.startswith("/")
        assert EsChordBrainPackagingLauncherParity::launcher_hash_matches(launcher, launcher_hash)
        assert EsChordBrainPackagingLauncherParity::reference_script_hash_matches()
        assert EsChordBrainPackagingLauncherParity::candidate_script_hash_matches()
        print("public_launcher_path=" + launcher)
        print("public_launcher_sha256=" + launcher_hash)
        assert EsChordBrainPackagingLauncherParity::run_fixture(launcher, cmake, "", 0, "-- ChordBrain APP/AU packaging metadata and resources are valid\n", "")
        assert EsChordBrainPackagingLauncherParity::run_fixture(launcher, cmake, "bad_source_app_type", 1, "", "Standalone APP plist must declare CFBundlePackageType APPL")
        assert EsChordBrainPackagingLauncherParity::run_fixture(launcher, cmake, "bad_source_app_nib", 1, "", "Standalone APP plist must reference the compiled SWELL main-menu nib")
        assert EsChordBrainPackagingLauncherParity::run_fixture(launcher, cmake, "bad_source_au_type", 1, "", "Instrument AU plist must advertise the aumu component type")
        assert EsChordBrainPackagingLauncherParity::run_fixture(launcher, cmake, "missing_app_nib", 1, "", "Missing built packaging artifact:")
        assert EsChordBrainPackagingLauncherParity::run_fixture(launcher, cmake, "missing_source_app_plist", 1, "", "Missing source packaging resource:")
        assert EsChordBrainPackagingLauncherParity::run_fixture(launcher, cmake, "missing_source_au_plist", 1, "", "Missing source packaging resource:")
        assert EsChordBrainPackagingLauncherParity::run_fixture(launcher, cmake, "missing_source_root", 1, "", "Missing source packaging resource:")
        assert EsChordBrainPackagingLauncherParity::run_fixture(launcher, cmake, "missing_binary_root", 1, "", "Missing built packaging artifact:")
        assert EsChordBrainPackagingLauncherParity::run_fixture(launcher, cmake, "missing_built_app_plist", 1, "", "Missing built packaging artifact:")
        assert EsChordBrainPackagingLauncherParity::run_fixture(launcher, cmake, "missing_built_font", 1, "", "Missing built packaging artifact:")
        assert EsChordBrainPackagingLauncherParity::run_fixture(launcher, cmake, "missing_built_au_plist", 1, "", "Missing built packaging artifact:")
        assert EsChordBrainPackagingLauncherParity::run_fixture(launcher, cmake, "bad_built_app_type", 1, "", "Built APP plist must declare CFBundlePackageType APPL")
        assert EsChordBrainPackagingLauncherParity::run_fixture(launcher, cmake, "bad_built_au_type", 1, "", "Built AU plist must advertise the aumu component type")
        assert EsChordBrainPackagingLauncherParity::reference_script_hash_matches()
        assert EsChordBrainPackagingLauncherParity::candidate_script_hash_matches()
        assert EsChordBrainPackagingLauncherParity::launcher_hash_matches(launcher, launcher_hash)
