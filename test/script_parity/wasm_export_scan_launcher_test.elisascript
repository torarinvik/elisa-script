# Process-level acceptance slice. Each source is resolved to its absolute
# spelling before all three processes run, matching wasm_build.py's caller contract.
# Run only through the bounded validation
# wrapper after explicit reauthorization; it also verifies the pinned local
# compiler environment and requires an absolute launcher path plus a recorded
# launcher SHA-256. The hash binds the path's bytes to a digest but does not
# prove that the digest was produced by the intended build.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsWasmExportScanLauncherParity:
    private:
        const module Commands:
            PYTHON: sview = "/Users/torarinvikbjarko/.local/share/uv/python/cpython-3.14.7-macos-aarch64-none/bin/python3.14"
            REFERENCE_ADAPTER: sview = "scripts/wasm_export_scan_reference.py"
            REFERENCE_PORT_SCRIPT: sview = "scripts/wasm_export_scan_reference.elisascript"
            CANDIDATE_SCRIPT: sview = "scripts/wasm_export_scan.elisascript"
            BUILD_PAYLOAD_OPTION: sview = "--build-payload"
            BUILD_COMPONENT_PAYLOAD_OPTION: sview = "--build-component-payload"
            COMPONENT_OPTION: sview = "--component"
            FLATTEN_PAYLOAD_OPTION: sview = "--flatten-payload"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            MAX_LAUNCHER_BYTES: usize = 67108864
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_OUTPUT_BYTES: u64 = 16777217
            # The candidate reserves one byte for the final LF under this cap.
            MAX_CALLER_PAYLOAD_OUTPUT_BYTES: u64 = 67108864
            TIMEOUT_STEPS: u64 = 10000


        const module SourceHashes:
            PYTHON: sview = "16a1bac7c40871327d591833239cafc6cd060b4d199d3aa4b3048b8d69644bce"
            REFERENCE_ADAPTER: sview = "2f1df38c6177d5824315bd5da1cc569ea88aef551248f002a013e9f7aa79494c"
            REFERENCE_PORT_SCRIPT: sview = "70e1f269dea3635a4500872628b991d8af657a5e3a4450f8ff882c14b85fd633"
            CANDIDATE_SCRIPT: sview = "985b9328aa64819f1fa829f52c6784e00a78238f46cf6ab79eae584cbb02a169"


        def lowercase_sha256_hex_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def file_has_expected_sha256(path_text: sview, expected_hex: sview) -> bool can[Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            target_path: Path = path(path_text)
            return false if is_symlink(target_path) or not is_file(target_path)
            target_size: usize = try file_size(target_path) else err:
                return false
            return false if target_size == 0 or target_size > Commands::MAX_LAUNCHER_BYTES
            hash_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "wasm-export-scan-source-sha256",
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", path_text],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(hash_runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false

            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            expected_line: sview = expected_hex + "  " + path_text + "\n"
            return false if hash_run.stdout != expected_line
            for index in 0..<64 |hash_run, expected_hex|:
                return false if not lowercase_sha256_hex_byte(sview_at(expected_hex, index))
            return true


        def source_set_is_pinned() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return file_has_expected_sha256(Commands::PYTHON, SourceHashes::PYTHON) and file_has_expected_sha256(Commands::REFERENCE_ADAPTER, SourceHashes::REFERENCE_ADAPTER) and file_has_expected_sha256(Commands::REFERENCE_PORT_SCRIPT, SourceHashes::REFERENCE_PORT_SCRIPT) and file_has_expected_sha256(Commands::CANDIDATE_SCRIPT, SourceHashes::CANDIDATE_SCRIPT)


        def launcher_pair_matches(launcher: sview, source_path: sview, component: bool = false) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            resolved_path: Path = try path_real(path(source_path)) else err:
                return false
            resolved_source: sview = f"{resolved_path}"
            reference_arguments: mutable darray[sview] = [resolved_source]
            reference_arguments <- [Commands::COMPONENT_OPTION, resolved_source] if component
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.PythonAdapter,
                name: "pinned-python-wasm-export-scan",
                target: Commands::PYTHON,
                entry: Commands::REFERENCE_ADAPTER,
                arguments: reference_arguments,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    return false

            reference_port_arguments: mutable darray[sview] = [Commands::REFERENCE_PORT_SCRIPT, resolved_source]
            reference_port_arguments <- [Commands::REFERENCE_PORT_SCRIPT, Commands::COMPONENT_OPTION, resolved_source] if component
            reference_port_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-wasm-export-scan-reference-port",
                target: launcher,
                arguments: reference_port_arguments,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_port_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_port_runner):
                ok value:
                    reference_port_run <- value
                error failure:
                    return false

            candidate_arguments: mutable darray[sview] = [Commands::CANDIDATE_SCRIPT, resolved_source]
            candidate_arguments <- [Commands::CANDIDATE_SCRIPT, Commands::COMPONENT_OPTION, resolved_source] if component
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-wasm-export-scan",
                target: launcher,
                arguments: candidate_arguments,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    return false

            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            port_comparison: DifferentialComparison = compare_differential_runs(reference_run, reference_port_run)
            return reference_run.outcome == DifferentialRunOutcome.Completed and reference_port_run.outcome == DifferentialRunOutcome.Completed and candidate_run.outcome == DifferentialRunOutcome.Completed and comparison.equal and port_comparison.equal


        def launcher_payload_pair_matches(launcher: sview, source_path: sview, component: bool = false) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            resolved_path: Path = try path_real(path(source_path)) else err:
                return false
            resolved_source: sview = f"{resolved_path}"
            payload_option: sview = Commands::BUILD_PAYLOAD_OPTION
            payload_option <- Commands::BUILD_COMPONENT_PAYLOAD_OPTION if component
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.PythonAdapter,
                name: "pinned-python-wasm-build-payload",
                target: Commands::PYTHON,
                entry: Commands::REFERENCE_ADAPTER,
                arguments: [payload_option, resolved_source],
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_CALLER_PAYLOAD_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    return false

            reference_port_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-wasm-build-payload-reference-port",
                target: launcher,
                arguments: [Commands::REFERENCE_PORT_SCRIPT, payload_option, resolved_source],
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_CALLER_PAYLOAD_OUTPUT_BYTES
            }
            reference_port_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_port_runner):
                ok value:
                    reference_port_run <- value
                error failure:
                    return false

            candidate_payload_option: sview = Commands::BUILD_PAYLOAD_OPTION
            candidate_payload_option <- Commands::BUILD_COMPONENT_PAYLOAD_OPTION if component
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-wasm-build-payload",
                target: launcher,
                arguments: [Commands::CANDIDATE_SCRIPT, candidate_payload_option, resolved_source],
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_CALLER_PAYLOAD_OUTPUT_BYTES
            }
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    return false

            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            port_comparison: DifferentialComparison = compare_differential_runs(reference_run, reference_port_run)
            return reference_run.outcome == DifferentialRunOutcome.Completed and reference_port_run.outcome == DifferentialRunOutcome.Completed and candidate_run.outcome == DifferentialRunOutcome.Completed and comparison.equal and port_comparison.equal


        def launcher_flatten_payload_pair_matches(launcher: sview, source_path: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            resolved_path: Path = try path_real(path(source_path)) else err:
                return false
            resolved_source: sview = f"{resolved_path}"
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.PythonAdapter,
                name: "pinned-python-wasm-flatten-payload",
                target: Commands::PYTHON,
                entry: Commands::REFERENCE_ADAPTER,
                arguments: [Commands::FLATTEN_PAYLOAD_OPTION, resolved_source],
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_CALLER_PAYLOAD_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    return false

            reference_port_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-wasm-flatten-payload-reference-port",
                target: launcher,
                arguments: [Commands::REFERENCE_PORT_SCRIPT, Commands::FLATTEN_PAYLOAD_OPTION, resolved_source],
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_CALLER_PAYLOAD_OUTPUT_BYTES
            }
            reference_port_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_port_runner):
                ok value:
                    reference_port_run <- value
                error failure:
                    return false

            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-wasm-flatten-payload",
                target: launcher,
                arguments: [Commands::CANDIDATE_SCRIPT, Commands::FLATTEN_PAYLOAD_OPTION, resolved_source],
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_CALLER_PAYLOAD_OUTPUT_BYTES
            }
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    return false

            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            port_comparison: DifferentialComparison = compare_differential_runs(reference_run, reference_port_run)
            return reference_run.outcome == DifferentialRunOutcome.Completed and reference_port_run.outcome == DifferentialRunOutcome.Completed and candidate_run.outcome == DifferentialRunOutcome.Completed and comparison.equal and port_comparison.equal


        def launcher_wrong_arity_matches(launcher: sview, script_arguments: darray[sview]) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Unsafe.PointerCast]:
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-wasm-export-scan-candidate-usage",
                target: launcher,
                arguments: script_arguments,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    return false

            port_arguments: mutable darray[sview] = [Commands::REFERENCE_PORT_SCRIPT]
            for index in 1..<script_arguments.count |port_arguments, script_arguments|:
                port_arguments.push(script_arguments[index])
            port_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-wasm-export-scan-reference-port-usage",
                target: launcher,
                arguments: port_arguments,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            port_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(port_runner):
                ok value:
                    port_run <- value
                error failure:
                    return false

            expected_usage: sview = "usage: wasm export scan <source> | --component <source> | --build-payload <source> | --build-component-payload <source> | --flatten-payload <source>\n"
            return candidate_run.outcome == DifferentialRunOutcome.Completed and candidate_run.exit_status == 2 and candidate_run.stdout == "" and candidate_run.stderr == expected_usage and port_run.outcome == DifferentialRunOutcome.Completed and port_run.exit_status == 2 and port_run.stdout == "" and port_run.stderr == expected_usage


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def all_public_launcher_cases_match(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            return false if not source_set_is_pinned()
            cases: darray[sview] = [
                "test/fixtures/script_parity/wasm_export_scan/annotations.input",
                "test/fixtures/script_parity/wasm_export_scan/basic.input",
                "test/fixtures/script_parity/wasm_export_scan/duplicate_export.input",
                "test/fixtures/script_parity/wasm_export_scan/nested_signature_suffix.input",
                "test/fixtures/script_parity/wasm_export_scan/no_exports.input",
                "test/fixtures/script_parity/wasm_export_scan/nullable_type.input",
                "test/fixtures/script_parity/wasm_export_scan/target_regex.input",
                "test/fixtures/script_parity/wasm_export_scan/unicode_line_separator.input",
                "test/fixtures/script_parity/wasm_export_scan/unicode_repr.input",
                "test/fixtures/script_parity/wasm_export_scan/unsupported_type.input",
                "test/fixtures/script_parity/wasm_export_scan/include_diamond/main.input",
                "test/fixtures/script_parity/wasm_export_scan/include_mixed_quotes/main.input",
                "test/fixtures/script_parity/wasm_export_scan/include_missing/main.input",
                "test/fixtures/script_parity/wasm_export_scan/include_nested/main.input",
                "test/fixtures/script_parity/wasm_export_scan/include_cycle/main.input"
            ]
            no_source_operand: darray[sview] = [Commands::CANDIDATE_SCRIPT]
            extra_source_operand: darray[sview] = [Commands::CANDIDATE_SCRIPT, "unused", "extra"]
            missing_payload_source: darray[sview] = [Commands::CANDIDATE_SCRIPT, Commands::BUILD_PAYLOAD_OPTION]
            extra_payload_operand: darray[sview] = [Commands::CANDIDATE_SCRIPT, Commands::BUILD_PAYLOAD_OPTION, "unused", "extra"]
            missing_component_payload_source: darray[sview] = [Commands::CANDIDATE_SCRIPT, Commands::BUILD_COMPONENT_PAYLOAD_OPTION]
            extra_component_payload_operand: darray[sview] = [Commands::CANDIDATE_SCRIPT, Commands::BUILD_COMPONENT_PAYLOAD_OPTION, "unused", "extra"]
            missing_flatten_source: darray[sview] = [Commands::CANDIDATE_SCRIPT, Commands::FLATTEN_PAYLOAD_OPTION]
            extra_flatten_operand: darray[sview] = [Commands::CANDIDATE_SCRIPT, Commands::FLATTEN_PAYLOAD_OPTION, "unused", "extra"]
            missing_component_source: darray[sview] = [Commands::CANDIDATE_SCRIPT, Commands::COMPONENT_OPTION]
            extra_component_operand: darray[sview] = [Commands::CANDIDATE_SCRIPT, Commands::COMPONENT_OPTION, "unused", "extra"]
            return false if not launcher_wrong_arity_matches(launcher, no_source_operand)
            return false if not launcher_wrong_arity_matches(launcher, extra_source_operand)
            return false if not launcher_wrong_arity_matches(launcher, missing_payload_source)
            return false if not launcher_wrong_arity_matches(launcher, extra_payload_operand)
            return false if not launcher_wrong_arity_matches(launcher, missing_component_payload_source)
            return false if not launcher_wrong_arity_matches(launcher, extra_component_payload_operand)
            return false if not launcher_wrong_arity_matches(launcher, missing_flatten_source)
            return false if not launcher_wrong_arity_matches(launcher, extra_flatten_operand)
            return false if not launcher_wrong_arity_matches(launcher, missing_component_source)
            return false if not launcher_wrong_arity_matches(launcher, extra_component_operand)
            return false if not launcher_pair_matches(launcher, "test/fixtures/script_parity/wasm_export_scan/component_enum.input", true)
            for source_path in cases:
                return false if not launcher_pair_matches(launcher, source_path)
            payload_cases: darray[sview] = [
                "test/fixtures/script_parity/wasm_export_scan/annotations.input",
                "test/fixtures/script_parity/wasm_export_scan/basic.input",
                "test/fixtures/script_parity/wasm_export_scan/include_diamond/main.input",
                "test/fixtures/script_parity/wasm_export_scan/include_nested/main.input",
                "test/fixtures/script_parity/wasm_export_scan/include_missing/main.input",
                "test/fixtures/script_parity/wasm_export_scan/unicode_line_separator.input"
            ]
            for source_path in payload_cases:
                return false if not launcher_payload_pair_matches(launcher, source_path)
            return false if not launcher_payload_pair_matches(launcher, "test/fixtures/script_parity/wasm_export_scan/component_enum.input", true)
            flatten_payload_cases: darray[sview] = [
                "test/fixtures/script_parity/wasm_export_scan/no_exports.input",
                "test/fixtures/script_parity/wasm_export_scan/include_nested/main.input",
                "test/fixtures/script_parity/wasm_export_scan/include_diamond/main.input",
                "test/fixtures/script_parity/wasm_export_scan/include_missing/main.input"
            ]
            for source_path in flatten_payload_cases:
                return false if not launcher_flatten_payload_pair_matches(launcher, source_path)
            return source_set_is_pinned()


@test
def wasm_export_scan_public_launcher_matches_pinned_python_and_elisascript_processes() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, Directory.Read, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsWasmExportScanLauncherParity::pinned_compiler_path()
        assert launcher != ""
        assert launcher.startswith("/")
        assert EsWasmExportScanLauncherParity::file_has_expected_sha256(launcher, launcher_hash)
        assert EsWasmExportScanLauncherParity::source_set_is_pinned()
        print("public_launcher_path=" + launcher)
        print("public_launcher_sha256=" + launcher_hash)
        assert EsWasmExportScanLauncherParity::all_public_launcher_cases_match(launcher)
        assert EsWasmExportScanLauncherParity::file_has_expected_sha256(launcher, launcher_hash)
        assert EsWasmExportScanLauncherParity::source_set_is_pinned()
