# Process-level acceptance slice. Run only through the bounded validation
# wrapper after explicit reauthorization; it also verifies the pinned local
# compiler environment and requires an absolute launcher path. The caller must
# supply the intended locally built public launcher; this source does not
# independently verify the launcher's build identity.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsWasmExportScanLauncherParity:
    private:
        const module Commands:
            PYTHON: sview = "python3"
            REFERENCE_ADAPTER: sview = "scripts/wasm_export_scan_reference.py"
            CANDIDATE_SCRIPT: sview = "scripts/wasm_export_scan.elisascript"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            MAX_OUTPUT_BYTES: u64 = 16777217
            TIMEOUT_STEPS: u64 = 10000


        def launcher_pair_matches(launcher: sview, source_path: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Unsafe.PointerCast]:
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.PythonAdapter,
                name: "pinned-python-wasm-export-scan",
                target: Commands::PYTHON,
                entry: Commands::REFERENCE_ADAPTER,
                arguments: [source_path],
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    return false

            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-wasm-export-scan",
                target: launcher,
                arguments: [Commands::CANDIDATE_SCRIPT, source_path],
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_OUTPUT_BYTES
            }
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    return false

            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return comparison.equal


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def all_public_launcher_cases_match(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Unsafe.PointerCast]:
            cases: darray[sview] = [
                "test/fixtures/script_parity/wasm_export_scan/basic.input",
                "test/fixtures/script_parity/wasm_export_scan/duplicate_export.input",
                "test/fixtures/script_parity/wasm_export_scan/nested_signature_suffix.input",
                "test/fixtures/script_parity/wasm_export_scan/no_exports.input",
                "test/fixtures/script_parity/wasm_export_scan/nullable_type.input",
                "test/fixtures/script_parity/wasm_export_scan/target_regex.input",
                "test/fixtures/script_parity/wasm_export_scan/unsupported_type.input",
                "test/fixtures/script_parity/wasm_export_scan/include_diamond/main.input",
                "test/fixtures/script_parity/wasm_export_scan/include_mixed_quotes/main.input",
                "test/fixtures/script_parity/wasm_export_scan/include_missing/main.input",
                "test/fixtures/script_parity/wasm_export_scan/include_nested/main.input",
                "test/fixtures/script_parity/wasm_export_scan/include_cycle/main.input"
            ]
            for source_path in cases:
                return false if not launcher_pair_matches(launcher, source_path)
            return true


@test
def wasm_export_scan_public_launcher_matches_pinned_python_process_output() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        assert reauthorized == "1"
        assert compiler == EsWasmExportScanLauncherParity::pinned_compiler_path()
        assert launcher != ""
        assert launcher.startswith("/")
        assert EsWasmExportScanLauncherParity::all_public_launcher_cases_match(launcher)
