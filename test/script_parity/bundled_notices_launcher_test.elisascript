# Gated differential check for the bundled-notices Python/Elisascript CLIs.
# Run only through scripts/run_bounded_test.sh after explicit reauthorization.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsBundledNoticesLauncherParity:
    private:
        const module Commands:
            PYTHON: sview = "/opt/homebrew/Cellar/python@3.14/3.14.7/Frameworks/Python.framework/Versions/3.14/bin/python3.14"
            REFERENCE: sview = "../elisa-engine/scripts/check_bundled_notices.py"
            CANDIDATE: sview = "ports/elisa-engine/scripts/check_bundled_notices.elisascript"
            SHASUM: sview = "/usr/bin/shasum"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            CONTROLLED_PATH: sview = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            HASH_TIMEOUT_STEPS: u64 = 5000
            HASH_OUTPUT_BYTES: u64 = 8192
            PROCESS_TIMEOUT_STEPS: u64 = 30000
            PROCESS_OUTPUT_BYTES: u64 = 1048576
            MAX_SOURCE_BYTES: usize = 67108864
            MAX_TOTAL_SOURCE_BYTES: usize = 67108864
            SOURCE_SET_OUTPUT_BYTES: u64 = 16384
            REFERENCE_SHA256: sview = "022941e9faf7241ff291d2f29bb3b99fec2975184965cc09261affed06ba78b1"
            CANDIDATE_SHA256: sview = "8141b3da6d44d2ddfa2c4f5dcdf398dd089cefa3be018a3e4674ef0ef64ab84d"
            AUDIT_POSIX_SHA256: sview = "417f0eb1afe76d4d7f4ac92bd0287559d043d70a95318091f9b6f58bbe3dbf0a"
            AUDIT_MODEL_SHA256: sview = "69b98c70cc9dd38c78e707120880cf311de76d9ed0ee4f343a9e84a81a07a70d"
            BUNDLED_JSON_MODEL_SHA256: sview = "1b5cd33d54f5315cefe8ffc90c0da5415fd375d3d16d96750b20b8c353ba6481"
            REPORT_JSON_SHA256: sview = "d4c0aa82e38a0ca31216639a52cdb874abaee1d215af940d01f1639379039216"
            CLI_MODEL_SHA256: sview = "11fb2173544f875f7914bb66b22e941dd23899ed524499282db42f3c86a153ff"
            BOUNDED_BYTES_SHA256: sview = "d5f17c44549af714b059603f122e52ebbe7ee64a1c629633e0e8a21be7f129e9"
            FILE_POSIX_SHA256: sview = "14e1e3a9f0d95ee3e45509bd7d76c1ba2694992d5530f82edf8533d9cf149643"
            DIRECTORY_POSIX_SHA256: sview = "065d21370e93a1487a5ccc0adcfff5dcc04aa78e98361de181eeb08dbc0d402d"
            STDIO_POSIX_SHA256: sview = "c02cac5eec931a2f2aa9131616482df4e17333948961c4b6d0d215b0ab0e766c"
            DATA_MODEL_SHA256: sview = "a2aa9cb5a80ea904f681c1f5e1eb7bf59a0afcf3ee381cd64e8461172dc9eca1"
            JSON_RUNTIME_MODEL_SHA256: sview = "cf6d6c74e0b19c9f5e2e622500e4dd5b6fbeb1b4824355418f0938c06a463947"
            JSON_LEXER_SHA256: sview = "18a598afe996ff9249e46e0330b592b7cb1bfecec6983f8ba37e4ef8247d3667"
            JSON_PARSE_SHA256: sview = "8ab7ff8004ffc945ba28fef703b8cad5c0dcff996f71f5ca41bbdb2c3fbb3438"
            IR_MODEL_SHA256: sview = "1ef45e1d17c0ad0b3d78a933df6b354c2548b7a61c3daa85f8ad375f52024257"
            IR_SERIALIZE_SHA256: sview = "17a483584a5fba02e29539216c190549e72a81ece3d84d24d90d562ec19ccdaf"
            RUNTIME_ROOT_SHA256: sview = "a04f6d896ae3903d1eaefa4a0a87891a402521f04a1f38b5f077a12407a12db6"
            RUNTIME_PRELUDE_SHA256: sview = "2619984a34e225e695eac647f34b98b36f381aec914ec683b5f33f161395ae5f"
            RUNTIME_CONCURRENCY_SHA256: sview = "39ece8ec480b9f26b54bf81dc46c07446a81c8fe39fcc9af514249eaaca4e441"
            RUNTIME_SLICE_SHA256: sview = "c8f0a0b0adaf6c8bb09c9f63b1118ca30296d20922bca5b6559d1f191647b2eb"
            RUNTIME_PARALLEL_SHA256: sview = "1724472bdeef251cead78d80b0f43dc5553c9632a9d174f3b5d1cf6db8ed511f"
            RUNTIME_STRINGS_SHA256: sview = "44e3026254759d38166a554310ca259f4536b02927c10d10fe12196795819538"
            RUNTIME_DEBUG_SHA256: sview = "d88d45462ef0cc4d8226f9d4c1d60a4fa9561607c394b2243378d1cdd14c2ecf"
            RUNTIME_IMPL_SHA256: sview = "6a8f2ada7b6a378611e237f3ae174207ed69629490cd60cac32fce32a2067257"
            RUNTIME_SYSTEM_SHA256: sview = "a615d4669bce0b8d95f01f42fe7dd4992c01998ac22f8271aadf81afefebdbc4"
            RUNTIME_TEST_SHA256: sview = "33a2b5afaa001e8aa0e227c38510bb09c639f7d68c4a3f9095f1e55ff0b1c6d6"
            RUNTIME_STORES_SHA256: sview = "e0e9fc6a64057a8ae568f642d248c6cef4b2a38c967b63531156e527c62f81e9"


        const enum Phase of u8:
            CreateFixture
            CompareMissingNotice
            CreateMatchingNotice
            CompareMatchingNotice
            TamperNotice
            CompareTamperedNotice
            RestoreNotice
            CompleteCatalog
            CompareCompleteCatalog
            AddUnmappedLibrary
            CompareUnmappedLibrary
            Cleanup
            Done


        struct SourcePin:
            path: sview
            digest: sview


        struct FixtureState:
            phase: Phase
            temporary: Path
            app: Path
            frameworks: Path
            notices: Path
            nested_notices: Path
            catalog: Path
            notice: Path
            passed: bool = true


        def lowercase_sha256_hex_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def file_has_sha256(path_text: sview, expected_hex: sview) -> bool can[Process.Run, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Format]:
            return false if sview_len(expected_hex) != 64
            source: Path = path(path_text)
            return false if is_symlink(source) or not is_file(source)
            source_size: usize = try file_size(source) else failure:
                _ = failure
                return false
            return false if source_size == 0 or source_size > Commands::MAX_SOURCE_BYTES
            resolved: Path = try path_real(source) else failure:
                _ = failure
                return false
            resolved_text: sview = f(resolved)
            environment: darray[DifferentialEnvironmentEntry] = []
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "bundled-notices-source-sha256",
                target: Commands::SHASUM,
                arguments: ["-a", "256", resolved_text],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::HASH_TIMEOUT_STEPS,
                max_output_bytes: Commands::HASH_OUTPUT_BYTES
            }
            result: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(runner):
                ok value:
                    result <- value
                error failure:
                    _ = failure
                    return false
            return false if result.outcome != DifferentialRunOutcome.Completed or result.exit_status != 0 or result.stderr != ""
            return false if result.stdout != expected_hex + "  " + resolved_text + "\n"
            for index in 0..<64 |expected_hex|:
                return false if not lowercase_sha256_hex_byte(sview_at(expected_hex, index))
            return true


        def source_set_is_pinned() -> bool can[Process.Run, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Format]:
            pins: darray[SourcePin] = [
                SourcePin{path: Commands::REFERENCE, digest: Commands::REFERENCE_SHA256},
                SourcePin{path: Commands::CANDIDATE, digest: Commands::CANDIDATE_SHA256},
                SourcePin{path: "ports/elisa-engine/scripts/bundled_notices_audit_posix.elisa", digest: Commands::AUDIT_POSIX_SHA256},
                SourcePin{path: "ports/elisa-engine/scripts/bundled_notices_audit_model.elisa", digest: Commands::AUDIT_MODEL_SHA256},
                SourcePin{path: "ports/elisa-engine/scripts/bundled_notices_json_model.elisa", digest: Commands::BUNDLED_JSON_MODEL_SHA256},
                SourcePin{path: "ports/elisa-engine/scripts/bundled_notices_report_json_model.elisa", digest: Commands::REPORT_JSON_SHA256},
                SourcePin{path: "ports/elisa-engine/scripts/bundled_notices_cli_model.elisa", digest: Commands::CLI_MODEL_SHA256},
                SourcePin{path: "src/runtime/bounded_bytes_posix.elisa", digest: Commands::BOUNDED_BYTES_SHA256},
                SourcePin{path: "src/runtime/file_posix.elisa", digest: Commands::FILE_POSIX_SHA256},
                SourcePin{path: "src/runtime/directory_posix.elisa", digest: Commands::DIRECTORY_POSIX_SHA256},
                SourcePin{path: "src/runtime/stdio_posix.elisa", digest: Commands::STDIO_POSIX_SHA256},
                SourcePin{path: "src/runtime/data_model.elisa", digest: Commands::DATA_MODEL_SHA256},
                SourcePin{path: "src/runtime/json_model.elisa", digest: Commands::JSON_RUNTIME_MODEL_SHA256},
                SourcePin{path: "src/runtime/json_lexer_model.elisa", digest: Commands::JSON_LEXER_SHA256},
                SourcePin{path: "src/runtime/json_parse_model.elisa", digest: Commands::JSON_PARSE_SHA256},
                SourcePin{path: "src/ir/ir_model.elisa", digest: Commands::IR_MODEL_SHA256},
                SourcePin{path: "src/ir/serialize.elisa", digest: Commands::IR_SERIALIZE_SHA256},
                SourcePin{path: "vendor/elisa-compiler/elisacore_std/elisacore_runtime.elisa", digest: Commands::RUNTIME_ROOT_SHA256},
                SourcePin{path: "vendor/elisa-compiler/elisacore_std/elisacore_runtime_prelude.elisa", digest: Commands::RUNTIME_PRELUDE_SHA256},
                SourcePin{path: "vendor/elisa-compiler/elisacore_std/elisacore_runtime_concurrency.elisa", digest: Commands::RUNTIME_CONCURRENCY_SHA256},
                SourcePin{path: "vendor/elisa-compiler/elisacore_std/elisacore_runtime_slice.elisa", digest: Commands::RUNTIME_SLICE_SHA256},
                SourcePin{path: "vendor/elisa-compiler/elisacore_std/elisacore_runtime_parallel.elisa", digest: Commands::RUNTIME_PARALLEL_SHA256},
                SourcePin{path: "vendor/elisa-compiler/elisacore_std/elisacore_runtime_strings.elisa", digest: Commands::RUNTIME_STRINGS_SHA256},
                SourcePin{path: "vendor/elisa-compiler/elisacore_std/debug_referee.elisa", digest: Commands::RUNTIME_DEBUG_SHA256},
                SourcePin{path: "vendor/elisa-compiler/elisacore_std/runtime.elisa", digest: Commands::RUNTIME_IMPL_SHA256},
                SourcePin{path: "vendor/elisa-compiler/elisacore_std/elisacore_runtime_system_bridge.elisa", digest: Commands::RUNTIME_SYSTEM_SHA256},
                SourcePin{path: "vendor/elisa-compiler/elisacore_std/test.elisa", digest: Commands::RUNTIME_TEST_SHA256},
                SourcePin{path: "vendor/elisa-compiler/elisacore_std/stores.elisa", digest: Commands::RUNTIME_STORES_SHA256}
            ]
            arguments: mutable darray[sview] = ["-a", "256"]
            expected_output: mutable sview = ""
            total_source_bytes: mutable usize = 0
            for pin in pins |pins, arguments, expected_output, total_source_bytes|:
                return false if sview_len(pin.digest) != 64
                source: Path = path(pin.path)
                return false if is_symlink(source) or not is_file(source)
                source_size: usize = try file_size(source) else failure:
                    _ = failure
                    return false
                return false if source_size == 0 or source_size > Commands::MAX_SOURCE_BYTES
                return false if source_size > Commands::MAX_TOTAL_SOURCE_BYTES - total_source_bytes
                total_source_bytes <- total_source_bytes + source_size
                resolved: Path = try path_real(source) else failure:
                    _ = failure
                    return false
                resolved_text: sview = f(resolved)
                arguments.push(resolved_text)
                expected_output <- expected_output + pin.digest + "  " + resolved_text + "\n"
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "bundled-notices-source-set-sha256",
                target: Commands::SHASUM,
                arguments: arguments,
                working_directory: "/",
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::HASH_TIMEOUT_STEPS,
                max_output_bytes: Commands::SOURCE_SET_OUTPUT_BYTES
            }
            observed: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(runner):
                ok value:
                    observed <- value
                error failure:
                    _ = failure
                    return false
            return observed.outcome == DifferentialRunOutcome.Completed and observed.exit_status == 0 and observed.stderr == "" and observed.stdout == expected_output


        def controlled_environment() -> darray[DifferentialEnvironmentEntry] can[Memory.Allocate, Abort.Panic]:
            return [
                DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "LANG", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]


        def run_process(target: sview, arguments: darray[sview], environment: darray[DifferentialEnvironmentEntry], label: sview) -> DifferentialRun error[DifferentialRunnerError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: label,
                target: target,
                arguments: arguments,
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::PROCESS_TIMEOUT_STEPS,
                max_output_bytes: Commands::PROCESS_OUTPUT_BYTES
            }
            return try run_differential_process(runner)


        def process_pair_matches(launcher: sview, app: Path, catalog: Path, expected_status: i64, label: sview) -> bool can[Process.Run, Blocking.IO, Memory.Allocate, Abort.Panic, Console.Write, Directory.Read, File.Read, Unsafe.PointerCast, Console.Format]:
            reference_path: Path = try path_real(path(Commands::REFERENCE)) else failure:
                _ = failure
                return false
            candidate_path: Path = try path_real(path(Commands::CANDIDATE)) else failure:
                _ = failure
                return false
            environment: darray[DifferentialEnvironmentEntry] = controlled_environment()
            reference_arguments: darray[sview] = [
                f(reference_path), "--app", f(app), "--catalog", f(catalog)
            ]
            candidate_arguments: darray[sview] = [
                f(candidate_path), "--app", f(app), "--catalog", f(catalog)
            ]
            reference: mutable DifferentialRun = DifferentialRun{observations: []}
            candidate: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_process(Commands::PYTHON, reference_arguments, environment, "bundled-notices-python-" + label):
                ok value:
                    reference <- value
                error failure:
                    _ = failure
                    print("bundled notices " + label + ": Python reference exceeded process bounds")
                    return false
            catch run_process(launcher, candidate_arguments, environment, "bundled-notices-elisascript-" + label):
                ok value:
                    candidate <- value
                error failure:
                    _ = failure
                    print("bundled notices " + label + ": Elisascript candidate exceeded process bounds")
                    return false
            comparison: DifferentialComparison = compare_differential_runs(reference, candidate)
            return false if not reference.stdout.startswith("{\n  \"schema\": 1,") or not reference.stdout.ends_with("\n") or reference.stderr != ""
            return reference.outcome == DifferentialRunOutcome.Completed and candidate.outcome == DifferentialRunOutcome.Completed and reference.exit_status == expected_status and candidate.exit_status == expected_status and comparison.equal


        def write_catalog(path_value: Path, notice_digest: sview, complete: bool) -> bool can[File.Write, Memory.Allocate, Abort.Panic]:
            complete_text: sview = "true" if complete else "false"
            contents: sview = "{\"sources\":[{\"name\":\"Example\",\"sha256\":\"" + notice_digest + "\"}],\"complete\":" + complete_text + ",\"bundled_libraries\":{\"libexample.dylib\":{\"notices\":[\"Example\"]}}}"
            written: usize = try write_text(path_value, contents) else failure:
                _ = failure
                return false
            return written == sview_len(contents)


        def write_bytes_exact(path_value: Path, bytes: darray[u8]) -> bool can[File.Write, Memory.Allocate, Abort.Panic]:
            written: usize = try write_bytes(path_value, bytes) else failure:
                _ = failure
                return false
            return written == bytes.count


        def run_cases(launcher: sview) -> bool can[Directory.Read, Directory.Write, File.Read, File.Write, Process.Run, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Unsafe.PointerCast, Console.Format]:
            temporary: Path = try temp_directory("Elisascript bundled notices parity") else failure:
                _ = failure
                print("bundled notices parity: unable to create temporary fixture")
                return false
            app: Path = temporary.joinpath("Fixture.app")
            notice_contents: mutable darray[u8] = [110u8, 111u8, 116u8, 105u8, 99u8, 101u8]
            digest_bytes: darray[u8] = try EsEngineBundledNoticesAudit::digest_hex(notice_contents) else failure:
                _ = failure
                _ = try remove_tree(temporary) else false
                return false
            digest: sview = bytes_view(digest_bytes)
            state: mutable FixtureState = FixtureState{
                phase: Phase::CreateFixture,
                temporary: temporary,
                app: app,
                frameworks: app.joinpath("Contents/Frameworks"),
                notices: app.joinpath("Contents/Resources/Notices"),
                nested_notices: app.joinpath("Contents/Resources/Notices/Nested"),
                catalog: temporary.joinpath("notice-sources.json"),
                notice: app.joinpath("Contents/Resources/Notices/Nested/Example.txt")
            }
            result: mutable bool = false

            machine over state while state.phase != Phase::Done:
                state Dispatch
                start Dispatch

                Dispatch, Phase::CreateFixture:
                    frameworks_created: bool = try create_directories(state.frameworks) else false
                    notices_created: bool = try create_directories(state.notices) else false
                    library_written: bool = write_bytes_exact(state.frameworks.joinpath("libexample.dylib"), [1u8])
                    catalog_written: bool = write_catalog(state.catalog, digest, false)
                    state.passed <- frameworks_created and notices_created and library_written and catalog_written
                    state.phase <- Phase::CompareMissingNotice if state.passed
                    state.phase <- Phase::Cleanup if not state.passed
                    -> Dispatch

                Dispatch, Phase::CompareMissingNotice:
                    state.passed <- process_pair_matches(launcher, state.app, state.catalog, 1i64, "missing")
                    state.phase <- Phase::CreateMatchingNotice if state.passed
                    state.phase <- Phase::Cleanup if not state.passed
                    -> Dispatch

                Dispatch, Phase::CreateMatchingNotice:
                    nested_created: bool = try create_directories(state.nested_notices) else false
                    notice_written: bool = write_bytes_exact(state.notice, notice_contents)
                    state.passed <- nested_created and notice_written
                    state.phase <- Phase::CompareMatchingNotice if state.passed
                    state.phase <- Phase::Cleanup if not state.passed
                    -> Dispatch

                Dispatch, Phase::CompareMatchingNotice:
                    state.passed <- process_pair_matches(launcher, state.app, state.catalog, 1i64, "matching-incomplete-catalog")
                    state.phase <- Phase::TamperNotice if state.passed
                    state.phase <- Phase::Cleanup if not state.passed
                    -> Dispatch

                Dispatch, Phase::TamperNotice:
                    tampered: mutable darray[u8] = [109u8, 111u8, 100u8, 105u8, 102u8, 105u8, 101u8, 100u8]
                    state.passed <- write_bytes_exact(state.notice, tampered)
                    state.phase <- Phase::CompareTamperedNotice if state.passed
                    state.phase <- Phase::Cleanup if not state.passed
                    -> Dispatch

                Dispatch, Phase::CompareTamperedNotice:
                    state.passed <- process_pair_matches(launcher, state.app, state.catalog, 1i64, "tampered")
                    state.phase <- Phase::RestoreNotice if state.passed
                    state.phase <- Phase::Cleanup if not state.passed
                    -> Dispatch

                Dispatch, Phase::RestoreNotice:
                    state.passed <- write_bytes_exact(state.notice, notice_contents)
                    state.phase <- Phase::CompleteCatalog if state.passed
                    state.phase <- Phase::Cleanup if not state.passed
                    -> Dispatch

                Dispatch, Phase::CompleteCatalog:
                    state.passed <- write_catalog(state.catalog, digest, true)
                    state.phase <- Phase::CompareCompleteCatalog if state.passed
                    state.phase <- Phase::Cleanup if not state.passed
                    -> Dispatch

                Dispatch, Phase::CompareCompleteCatalog:
                    state.passed <- process_pair_matches(launcher, state.app, state.catalog, 0i64, "complete")
                    state.phase <- Phase::AddUnmappedLibrary if state.passed
                    state.phase <- Phase::Cleanup if not state.passed
                    -> Dispatch

                Dispatch, Phase::AddUnmappedLibrary:
                    state.passed <- write_bytes_exact(state.frameworks.joinpath("libunknown.dylib"), [2u8])
                    state.phase <- Phase::CompareUnmappedLibrary if state.passed
                    state.phase <- Phase::Cleanup if not state.passed
                    -> Dispatch

                Dispatch, Phase::CompareUnmappedLibrary:
                    state.passed <- process_pair_matches(launcher, state.app, state.catalog, 1i64, "unmapped-library")
                    state.phase <- Phase::Cleanup
                    -> Dispatch

                Dispatch, Phase::Cleanup:
                    removed: bool = try remove_tree(state.temporary) else false
                    result <- state.passed and removed
                    state.phase <- Phase::Done
                    -> Dispatch

                Dispatch, Phase::Done:
                    break

            return result


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def public_launcher_parity(launcher: sview, launcher_hash: sview) -> bool can[Directory.Read, Directory.Write, File.Read, File.Write, Process.Run, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Unsafe.PointerCast, Console.Format]:
            return false if not file_has_sha256(launcher, launcher_hash)
            return false if not source_set_is_pinned()
            return false if not run_cases(launcher)
            return source_set_is_pinned() and file_has_sha256(launcher, launcher_hash)


@test
def bundled_notices_public_launcher_matches_pinned_python_reference() -> void:
    can Directory.Read, Directory.Write, File.Read, File.Write, Process.Run, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else failure:
            _ = failure
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else failure:
            _ = failure
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else failure:
            _ = failure
            ""
        core_compiler: sview = try getenv("ELISACORE_BIN", "") else failure:
            _ = failure
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else failure:
            _ = failure
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else failure:
            _ = failure
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsBundledNoticesLauncherParity::pinned_compiler_path()
        assert core_compiler == EsBundledNoticesLauncherParity::pinned_compiler_path()
        assert launcher != "" and launcher.startswith("/")
        assert EsBundledNoticesLauncherParity::public_launcher_parity(launcher, launcher_hash)
