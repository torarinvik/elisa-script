# Pure admission fixtures. No environment access, process, file read or launcher.
include "canonical_wrapper_gate.elisa"

module EsCanonicalWrapperGateFixture:
    private:
        def qualified() -> EsCanonicalWrapperGate::Gate:
            return EsCanonicalWrapperGate::Gate{
                reauthorized: true, rss_guard: true, launcher_qualified: true, probe_qualified: true,
                local_compiler: EsCanonicalWrapperGate::Pins::COMPILER, core_compiler: EsCanonicalWrapperGate::Pins::COMPILER,
                launcher: EsCanonicalWrapperGate::Identity{path: "/fixture/public launcher", hash: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
                probe: EsCanonicalWrapperGate::Identity{path: "/fixture/process probe", hash: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},
                compiler_hash: "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"}


        def rejected(gate: EsCanonicalWrapperGate::Gate) -> bool:
            catch EsCanonicalWrapperGate::validate(gate):
                ok:
                    return false
                error failure:
                    return true

    public:
        @test
        def canonical_wrapper_gate_requires_each_qualification_declaration() -> void:
            valid: EsCanonicalWrapperGate::Gate = qualified()
            assert not rejected(valid)
            missing: mutable EsCanonicalWrapperGate::Gate = valid
            missing.reauthorized <- false
            assert rejected(missing)
            missing <- valid
            missing.rss_guard <- false
            assert rejected(missing)
            missing <- valid
            missing.launcher_qualified <- false
            assert rejected(missing)
            missing <- valid
            missing.probe_qualified <- false
            assert rejected(missing)


        @test
        def canonical_wrapper_gate_rejects_compiler_and_cross_role_aliases() -> void:
            valid: EsCanonicalWrapperGate::Gate = qualified()
            wrong: mutable EsCanonicalWrapperGate::Gate = valid
            wrong.local_compiler <- "/installed/compiler"
            assert rejected(wrong)
            wrong <- valid
            wrong.core_compiler <- "/main-worktree/compiler"
            assert rejected(wrong)
            wrong <- valid
            wrong.launcher.path <- EsCanonicalWrapperGate::Pins::COMPILER
            assert rejected(wrong)
            wrong <- valid
            wrong.probe.path <- EsCanonicalWrapperGate::Pins::COMPILER
            assert rejected(wrong)
            wrong <- valid
            wrong.launcher.path <- valid.probe.path
            assert rejected(wrong)
            wrong <- valid
            wrong.launcher.hash <- valid.compiler_hash
            assert rejected(wrong)
            wrong <- valid
            wrong.probe.hash <- valid.compiler_hash
            assert rejected(wrong)
            wrong <- valid
            wrong.launcher.hash <- valid.probe.hash
            assert rejected(wrong)


        @test
        def canonical_wrapper_gate_admits_literal_paths_but_rejects_control_identity() -> void:
            assert EsCanonicalWrapperGate::absolute_identity_path("/fixture $HOME; '*.py' \\tool")
            assert not EsCanonicalWrapperGate::absolute_identity_path("relative/tool")
            assert not EsCanonicalWrapperGate::absolute_identity_path("/")
            assert not EsCanonicalWrapperGate::absolute_identity_path("/fixture\0tool")
            assert not EsCanonicalWrapperGate::absolute_identity_path("/fixture\ntool")
            assert not EsCanonicalWrapperGate::absolute_identity_path("/fixture\rtool")
            wrong: mutable EsCanonicalWrapperGate::Gate = qualified()
            wrong.launcher.hash <- "not a hash"
            assert rejected(wrong)


        @test
        def canonical_wrapper_gate_header_rejects_obvious_script_wrappers() -> void:
            can Memory.Allocate, Abort.Panic:
                shell: darray[u8] = [35u8,33u8,47u8,98u8]
                short: darray[u8] = [207u8,250u8,237u8]
                macho: darray[u8] = [207u8,250u8,237u8,254u8]
                elf: darray[u8] = [127u8,69u8,76u8,70u8]
                unknown: darray[u8] = [0u8,0u8,0u8,0u8]
                assert not EsCanonicalWrapperGate::native_container_header(shell)
                assert not EsCanonicalWrapperGate::native_container_header(short)
                assert not EsCanonicalWrapperGate::native_container_header(unknown)
                assert EsCanonicalWrapperGate::native_container_header(macho)
                assert EsCanonicalWrapperGate::native_container_header(elf)
