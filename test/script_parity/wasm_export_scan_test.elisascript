        assert EsWasmExportScanParity::scanner_pair_matches("test/fixtures/script_parity/wasm_export_scan/duplicate_export.input")

@test
def wasm_export_scan_matches_pinned_python_for_abi_errors() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Unsafe.PointerCast:
        assert EsWasmExportScanParity::scanner_pair_matches("test/fixtures/script_parity/wasm_export_scan/nullable_type.input")
        assert EsWasmExportScanParity::scanner_pair_matches("test/fixtures/script_parity/wasm_export_scan/unsupported_type.input")

@test
def wasm_export_scan_matches_pinned_python_for_target_regex_compatibility() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Unsafe.PointerCast:
        assert EsWasmExportScanParity::scanner_pair_matches("test/fixtures/script_parity/wasm_export_scan/target_regex.input", "test/fixtures/script_parity/wasm_export_scan/target_regex.expected.json")
