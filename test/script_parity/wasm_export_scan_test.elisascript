@test
def wasm_export_scan_matches_non_strict_paths_beneath_symlink_prefixes() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Unsafe.PointerCast:
        temporary_root: Path = temp_directory("wasm-export-include")
        actual_directory: Path = temporary_root.joinpath("actual")
        alias_directory: Path = temporary_root.joinpath("alias")
        source_file: Path = temporary_root.joinpath("main.input")
        child_file: Path = actual_directory.joinpath("child.input")
        directory_created: bool = create_directory(actual_directory)
        child_written: usize = write_text(child_file, "export fn child() -> void = child\n")
        linked: bool = symlink(actual_directory, alias_directory)
        source_argument: sview = f"{source_file}"
        existing_pair: mutable bool = false
        absolute_pair: mutable bool = false
        missing_pair: mutable bool = false
        source_written: usize = write_text(source_file, "include \"alias/child.input\"\n")
        if directory_created and child_written > 0u64 and linked and source_written > 0u64:
            existing_pair <- EsWasmExportScanParity::scanner_pair_matches(source_argument)
        absolute_include: sview = "include \"" + f"{child_file}" + "\"\n"
        absolute_written: usize = write_text(source_file, absolute_include)
        if directory_created and child_written > 0u64 and absolute_written > 0u64:
            absolute_pair <- EsWasmExportScanParity::scanner_pair_matches(source_argument)
        missing_written: usize = write_text(source_file, "include \"alias/missing.input\"\n")
        if directory_created and child_written > 0u64 and linked and missing_written > 0u64:
            missing_pair <- EsWasmExportScanParity::scanner_pair_matches(source_argument)
        removed_alias: bool = remove_path(alias_directory)
        removed_source: bool = remove_path(source_file)
        removed_child: bool = remove_path(child_file)
        removed_actual: bool = remove_directory(actual_directory)
        removed_root: bool = remove_directory(temporary_root)
        assert directory_created and child_written > 0u64 and linked and source_written > 0u64 and absolute_written > 0u64 and missing_written > 0u64
        assert existing_pair and absolute_pair and missing_pair
        assert removed_alias and removed_source and removed_child and removed_actual and removed_root
