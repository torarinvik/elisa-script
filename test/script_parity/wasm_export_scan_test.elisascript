include "../../src/testing/differential.elisa"
include "../../scripts/wasm_export_scan.elisascript"

using EsDifferential
using EsWasmExportScan


module EsWasmExportScanParity:
    private:
        const module Commands:
            PYTHON: sview = "python3"
            REFERENCE_ADAPTER: sview = "scripts/wasm_export_scan_reference.py"


        struct TemporaryDirectory:
            path: Path
            created: bool = false


        def make_temporary_directory(prefix: sview) -> TemporaryDirectory can[Memory.Allocate, Abort.Panic, File.Write]:
            created_path: Path = try temp_directory(prefix) else err:
                return TemporaryDirectory{path: path("."), created: false}
            return TemporaryDirectory{path: created_path, created: true}


        def write_fixture_text(target: Path, text: sview) -> usize can[Memory.Allocate, Abort.Panic, File.Write]:
            return try write_text(target, text) else 0u64


        def write_fixture_bytes(target: Path, bytes: darray[u8]) -> usize can[Memory.Allocate, Abort.Panic, File.Write]:
            return try write_bytes(target, bytes) else 0u64


        def create_fixture_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try create_directory(target) else false


        def create_fixture_symlink(target: Path, link: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            return try symlink(target, link) else false


        def remove_fixture_path(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            return try remove_path(target) else false


        def remove_fixture_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try remove_directory(target) else false


        def process_capture_frame(status: i64, stdout: sview, stderr: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return format_int(status) + "\n" + format_int(len(stdout).i64()) + "\n" + stdout + "\n" + format_int(len(stderr).i64()) + "\n" + stderr


        def append_source_text(output: mutable darray[u8]&, value: sview) -> void can[Memory.Allocate, Abort.Panic]:
            for byte in value |output|:
                output.push(byte)


        def append_repeated_source_text(output: mutable darray[u8]&, value: sview, repetitions: usize) -> void can[Memory.Allocate, Abort.Panic]:
            for _ in 0..<repetitions |output, value|:
                append_source_text(output, value)


        def scanner_pair_matches_impl(source_path: sview, expected_json_path: sview) -> bool:
            can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast:
                reference_arguments: mutable darray[sview] = [source_path]
                if expected_json_path != "":
                    reference_arguments.push(expected_json_path)
                reference_runner: DifferentialRunner = DifferentialRunner{
                    kind: DifferentialRunnerKind.PythonAdapter,
                    name: "pinned-python-wasm-export-scan",
                    target: Commands::PYTHON,
                    entry: Commands::REFERENCE_ADAPTER,
                    arguments: reference_arguments,
                    timeout_steps: 10000,
                    max_output_bytes: 16777217
                }
                reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
                catch run_differential_process(reference_runner):
                    ok value:
                        reference_run <- value
                    error failure:
                        return false

                input_path: Path = path(source_path)
                candidate_frame: sview = EsWasmExportScan::differential_path_response(input_path)
                candidate_run: mutable DifferentialRun = DifferentialRun{
                    observations: [],
                    return_value: DifferentialValue{kind: DifferentialValueKind.Text, text: candidate_frame}
                }

                reference_frame: sview = process_capture_frame(reference_run.exit_status, reference_run.stdout, reference_run.stderr)
                reference_run.exit_status <- 0
                reference_run.error_text <- ""
                reference_run.stdout <- ""
                reference_run.stderr <- ""
                reference_run.return_value <- DifferentialValue{kind: DifferentialValueKind.Text, text: reference_frame}
                reference_run.outcome <- DifferentialRunOutcome.Completed

                comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
                return comparison.equal


    public:
        def scanner_pair_matches(source_path: sview, expected_json_path: sview = "") -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            return scanner_pair_matches_impl(source_path, expected_json_path)


        def symlink_include_cases_match() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary: TemporaryDirectory = make_temporary_directory("wasm-export-include")
            return false if not temporary.created
            temporary_root: Path = temporary.path
            actual_directory: Path = temporary_root.joinpath("actual")
            nested_directory: Path = actual_directory.joinpath("deep")
            alias_directory: Path = temporary_root.joinpath("alias")
            source_file: Path = temporary_root.joinpath("main.input")
            child_file: Path = nested_directory.joinpath("child.input")
            parent_child_file: Path = actual_directory.joinpath("child.input")
            directory_created: bool = create_fixture_directory(actual_directory)
            nested_created: bool = create_fixture_directory(nested_directory)
            child_written: usize = write_fixture_text(child_file, "export fn child() -> void = child\n")
            parent_child_written: usize = write_fixture_text(parent_child_file, "export fn child() -> void = child\n")
            linked: bool = create_fixture_symlink(nested_directory, alias_directory)
            source_argument: sview = f"{source_file}"
            existing_pair: mutable bool = false
            absolute_pair: mutable bool = false
            missing_pair: mutable bool = false
            symlink_parent_pair: mutable bool = false
            source_written: usize = write_fixture_text(source_file, "include \"alias/child.input\"\n")
            if directory_created and nested_created and child_written > 0u64 and linked and source_written > 0u64:
                existing_pair <- scanner_pair_matches(source_argument)
            absolute_include: sview = "include \"" + f"{child_file}" + "\"\n"
            absolute_written: usize = write_fixture_text(source_file, absolute_include)
            if directory_created and nested_created and child_written > 0u64 and absolute_written > 0u64:
                absolute_pair <- scanner_pair_matches(source_argument)
            missing_written: usize = write_fixture_text(source_file, "include \"alias/missing.input\"\n")
            if directory_created and nested_created and child_written > 0u64 and linked and missing_written > 0u64:
                missing_pair <- scanner_pair_matches(source_argument)
            symlink_parent_written: usize = write_fixture_text(source_file, "include \"alias/../child.input\"\n")
            if directory_created and nested_created and parent_child_written > 0u64 and linked and symlink_parent_written > 0u64:
                symlink_parent_pair <- scanner_pair_matches(source_argument)
            removed_alias: bool = remove_fixture_path(alias_directory)
            removed_source: bool = remove_fixture_path(source_file)
            removed_child: bool = remove_fixture_path(child_file)
            removed_parent_child: bool = remove_fixture_path(parent_child_file)
            removed_nested: bool = remove_fixture_directory(nested_directory)
            removed_actual: bool = remove_fixture_directory(actual_directory)
            removed_root: bool = remove_fixture_directory(temporary_root)
            return directory_created and nested_created and child_written > 0u64 and parent_child_written > 0u64 and linked and source_written > 0u64 and absolute_written > 0u64 and missing_written > 0u64 and symlink_parent_written > 0u64 and existing_pair and absolute_pair and missing_pair and symlink_parent_pair and removed_alias and removed_source and removed_child and removed_parent_child and removed_nested and removed_actual and removed_root


        def newline_and_utf8_cases_match() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary: TemporaryDirectory = make_temporary_directory("wasm-export-newline")
            return false if not temporary.created
            temporary_root: Path = temporary.path
            source_file: Path = temporary_root.joinpath("main.input")
            child_file: Path = temporary_root.joinpath("child.input")
            child_plain: usize = write_fixture_text(child_file, "export fn cross")
            no_final_newline_pair: mutable bool = false
            newline_pair: mutable bool = false
            invalid_utf8_pair: mutable bool = false

            root_without_final_newline: usize = write_fixture_text(source_file, "include \"child.input\"\n() -> void = cross\n")
            if child_plain > 0u64 and root_without_final_newline > 0u64:
                no_final_newline_pair <- scanner_pair_matches(f"{source_file}")

            child_with_bare_cr: usize = write_fixture_text(child_file, "export fn middle() -> void = middle\r")
            root_with_mixed_endings: usize = write_fixture_text(source_file, "export fn before() -> void = before\r\ninclude \"child.input\"\r\nexport fn after() -> void = after\r")
            if child_with_bare_cr > 0u64 and root_with_mixed_endings > 0u64:
                newline_pair <- scanner_pair_matches(f"{source_file}")

            invalid_source_bytes: usize = write_fixture_bytes(source_file, [255u8])
            if invalid_source_bytes > 0u64:
                invalid_utf8_pair <- scanner_pair_matches(f"{source_file}")

            removed_source: bool = remove_fixture_path(source_file)
            removed_child: bool = remove_fixture_path(child_file)
            removed_root: bool = remove_fixture_directory(temporary_root)
            return child_plain > 0u64 and root_without_final_newline > 0u64 and child_with_bare_cr > 0u64 and root_with_mixed_endings > 0u64 and invalid_source_bytes > 0u64 and no_final_newline_pair and newline_pair and invalid_utf8_pair and removed_source and removed_child and removed_root


        def overlong_source_path_is_rejected_equally() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            path_bytes: mutable darray[u8] = []
            for _ in 0..<4096 |path_bytes|:
                path_bytes.push(97u8)
            return scanner_pair_matches(bytes_view(path_bytes))


        def aggregate_path_component_work_is_rejected_equally() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary: TemporaryDirectory = make_temporary_directory("wasm-export-path-work")
            return false if not temporary.created
            temporary_root: Path = temporary.path
            source_file: Path = temporary_root.joinpath("main.input")
            child_file: Path = temporary_root.joinpath("child.input")

            dotted_components: mutable darray[u8] = []
            for _ in 0..<140 |dotted_components|:
                dotted_components.push(46u8)
                dotted_components.push(47u8)
            include_line: sview = "include \"" + bytes_view(dotted_components) + "child.input\"\n"
            source_bytes: mutable darray[u8] = []
            for _ in 0..<1000 |source_bytes, include_line|:
                for byte in include_line |source_bytes|:
                    source_bytes.push(byte)

            child_written: usize = write_fixture_text(child_file, "export fn child() -> void = child\n")
            source_written: usize = write_fixture_text(source_file, bytes_view(source_bytes))
            source_argument: sview = f"{source_file}"
            pair_matches: mutable bool = false
            expected_failure: mutable bool = false
            if child_written > 0u64 and source_written > 0u64:
                pair_matches <- scanner_pair_matches(source_argument)
                candidate_frame: sview = EsWasmExportScan::differential_path_response(source_file)
                expected_frame: sview = process_capture_frame(1, "", "wasm export scan: WASM path component work exceeds Elisascript scan limit\n")
                expected_failure <- candidate_frame == expected_frame

            removed_source: bool = remove_fixture_path(source_file)
            removed_child: bool = remove_fixture_path(child_file)
            removed_root: bool = remove_fixture_directory(temporary_root)
            return child_written > 0u64 and source_written > 0u64 and pair_matches and expected_failure and removed_source and removed_child and removed_root


        def unsupported_c1_type_repr_matches_python() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary: TemporaryDirectory = make_temporary_directory("wasm-export-c1-repr")
            return false if not temporary.created
            source_file: Path = temporary.path.joinpath("main.input")
            source_bytes: mutable darray[u8] = []
            append_source_text(source_bytes, "export fn c1(value: ")
            source_bytes.push(194u8)
            source_bytes.push(159u8)
            append_source_text(source_bytes, ") -> void = c1\n")

            source_written: usize = write_fixture_bytes(source_file, source_bytes)
            source_argument: sview = f"{source_file}"
            pair_matches: mutable bool = false
            if source_written > 0u64:
                pair_matches <- scanner_pair_matches(source_argument)

            removed_source: bool = remove_fixture_path(source_file)
            removed_root: bool = remove_fixture_directory(temporary.path)
            return source_written > 0u64 and pair_matches and removed_source and removed_root


        def export_name_comparison_work_is_bounded() -> bool can[Memory.Allocate, Abort.Panic]:
            source_bytes: mutable darray[u8] = []
            for index in 0..<1024 |source_bytes, index|:
                append_source_text(source_bytes, "export fn f")
                append_source_text(source_bytes, format_int(index.i64()))
                append_source_text(source_bytes, "()\n")

            expected_frame: sview = process_capture_frame(1, "", "wasm export scan: WASM export-name comparison work exceeds Elisascript scan limit\n")
            source_frame: sview = EsWasmExportScan::differential_source_response(bytes_view(source_bytes))
            return source_frame == expected_frame


        def source_line_descriptor_count_is_bounded() -> bool can[Memory.Allocate, Abort.Panic]:
            source_bytes: mutable darray[u8] = []
            for _ in 0..<131072 |source_bytes|:
                source_bytes.push(10u8)

            expected_limit_frame: sview = process_capture_frame(1, "", "wasm export scan: WASM source has no exported function; add `export fn name(...) -> T = target`\n")
            limit_frame: sview = EsWasmExportScan::differential_source_response(bytes_view(source_bytes))
            source_bytes.push(10u8)

            expected_over_limit_frame: sview = process_capture_frame(1, "", "wasm export scan: WASM source line count exceeds Elisascript scan limit\n")
            over_limit_frame: sview = EsWasmExportScan::differential_source_response(bytes_view(source_bytes))
            return limit_frame == expected_limit_frame and over_limit_frame == expected_over_limit_frame


        def main_seen_order_cases_match_python() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary: TemporaryDirectory = make_temporary_directory("wasm-export-main-order")
            return false if not temporary.created
            source_file: Path = temporary.path.joinpath("main.input")

            explicit_before_written: usize = write_fixture_text(source_file, "export fn main(value: cstr) -> int = main\ndef main(args: cstr) -> int:\n")
            explicit_before_matches: mutable bool = false
            if explicit_before_written > 0u64:
                explicit_before_matches <- scanner_pair_matches(f"{source_file}")

            later_main_bytes: mutable darray[u8] = []
            for index in 0..<512 |later_main_bytes, index|:
                append_source_text(later_main_bytes, "export fn f")
                append_source_text(later_main_bytes, format_int(index.i64()))
                append_source_text(later_main_bytes, "()\n")
            for _ in 0..<512 |later_main_bytes|:
                append_source_text(later_main_bytes, "\n")
            append_source_text(later_main_bytes, "def main(args: cstr) -> int:\nexport fn main(value: cstr) -> int = main\n")

            later_main_written: usize = write_fixture_bytes(source_file, later_main_bytes)
            later_main_matches: mutable bool = false
            if later_main_written > 0u64:
                later_main_matches <- scanner_pair_matches(f"{source_file}")

            repeated_implicit_written: usize = write_fixture_text(source_file, "def main(args: cstr) -> int:\ndef main(other: u8) -> int:\n")
            repeated_implicit_matches: mutable bool = false
            if repeated_implicit_written > 0u64:
                repeated_implicit_matches <- scanner_pair_matches(f"{source_file}")

            removed_source: bool = remove_fixture_path(source_file)
            removed_root: bool = remove_fixture_directory(temporary.path)
            return explicit_before_written > 0u64 and explicit_before_matches and later_main_written > 0u64 and later_main_matches and repeated_implicit_written > 0u64 and repeated_implicit_matches and removed_source and removed_root


        def header_scan_work_cases_reject_pathologically_expensive_suffixes() -> bool can[Memory.Allocate, Abort.Panic]:
            export_header_bytes: mutable darray[u8] = []
            append_source_text(export_header_bytes, "export fn budgeted(")
            for _ in 0..<512 |export_header_bytes|:
                append_source_text(export_header_bytes, "x) -> i32")
            append_source_text(export_header_bytes, " = !")
            export_header_source: sview = bytes_view(export_header_bytes)

            implicit_main_bytes: mutable darray[u8] = []
            append_source_text(implicit_main_bytes, "def main(")
            for _ in 0..<512 |implicit_main_bytes|:
                append_source_text(implicit_main_bytes, "x) -> i32")
            implicit_main_source: sview = bytes_view(implicit_main_bytes)

            expected_frame: sview = process_capture_frame(1, "", "wasm export scan: WASM header scan work exceeds Elisascript scan limit\n")
            export_frame: sview = EsWasmExportScan::differential_source_response(export_header_source)
            implicit_main_frame: sview = EsWasmExportScan::differential_source_response(implicit_main_source)
            return export_frame == expected_frame and implicit_main_frame == expected_frame


        def header_scan_work_aggregates_across_source_headers() -> bool can[Memory.Allocate, Abort.Panic]:
            source_bytes: mutable darray[u8] = []
            append_source_text(source_bytes, "export fn first(")
            append_repeated_source_text(source_bytes, "x", 600000)
            append_source_text(source_bytes, "\ndef main(")
            append_repeated_source_text(source_bytes, "x", 600000)
            append_source_text(source_bytes, "\n")

            expected_frame: sview = process_capture_frame(1, "", "wasm export scan: WASM header scan work exceeds Elisascript scan limit\n")
            source_frame: sview = EsWasmExportScan::differential_source_response(bytes_view(source_bytes))
            return source_frame == expected_frame


@test
def wasm_export_scan_matches_pinned_python_for_ordered_records() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast:
        assert EsWasmExportScanParity::scanner_pair_matches("test/fixtures/script_parity/wasm_export_scan/basic.input", "test/fixtures/script_parity/wasm_export_scan/basic.expected.json")

