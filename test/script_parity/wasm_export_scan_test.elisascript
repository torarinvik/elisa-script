include "../../src/testing/differential.elisa"
include "../../scripts/wasm_export_scan.elisascript"

using EsDifferential
using EsWasmExportScan


module EsWasmExportScanParity:
    private:
        const module Commands:
            PYTHON: sview = "python3"
            REFERENCE_ADAPTER: sview = "scripts/wasm_export_scan_reference.py"


        struct TemporaryDirectory:
            path: Path
            created: bool = false


        def make_temporary_directory(prefix: sview) -> TemporaryDirectory can[Memory.Allocate, Abort.Panic, File.Write]:
            created_path: Path = try temp_directory(prefix) else err:
                return TemporaryDirectory{path: path("."), created: false}
            return TemporaryDirectory{path: created_path, created: true}


        def write_fixture_text(target: Path, text: sview) -> usize can[Memory.Allocate, Abort.Panic, File.Write]:
            return try write_text(target, text) else 0u64


        def write_fixture_bytes(target: Path, bytes: darray[u8]) -> usize can[Memory.Allocate, Abort.Panic, File.Write]:
            return try write_bytes(target, bytes) else 0u64


        def create_fixture_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try create_directory(target) else false


        def create_fixture_symlink(target: Path, link: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            return try symlink(target, link) else false


        def remove_fixture_path(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            return try remove_path(target) else false


        def remove_fixture_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try remove_directory(target) else false


        def process_capture_frame(status: i64, stdout: sview, stderr: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return format_int(status) + "\n" + format_int(len(stdout).i64()) + "\n" + stdout + "\n" + format_int(len(stderr).i64()) + "\n" + stderr


        def append_source_text(output: mutable darray[u8]&, value: sview) -> void can[Memory.Allocate, Abort.Panic]:
            for byte in value |output|:
                output.push(byte)


        def append_utf8_scalar(output: mutable darray[u8]&, codepoint: usize) -> void can[Memory.Allocate, Abort.Panic]:
            if codepoint <= 127:
                output.push(codepoint.u8())
            elif codepoint <= 2047:
                output.push((192 + (codepoint >> 6)).u8())
                output.push((128 + (codepoint & 63)).u8())
            elif codepoint <= 65535:
                output.push((224 + (codepoint >> 12)).u8())
                output.push((128 + ((codepoint >> 6) & 63)).u8())
                output.push((128 + (codepoint & 63)).u8())
            else:
                output.push((240 + (codepoint >> 18)).u8())
                output.push((128 + ((codepoint >> 12) & 63)).u8())
                output.push((128 + ((codepoint >> 6) & 63)).u8())
                output.push((128 + (codepoint & 63)).u8())


        def append_repeated_source_text(output: mutable darray[u8]&, value: sview, repetitions: usize) -> void can[Memory.Allocate, Abort.Panic]:
            for _ in 0..<repetitions |output, value|:
                append_source_text(output, value)


        def scanner_pair_matches_impl(source_path: sview, expected_json_path: sview, component: bool = false) -> bool:
            can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast:
                reference_arguments: mutable darray[sview] = [source_path]
                reference_arguments <- ["--component", source_path] if component
                if expected_json_path != "":
                    reference_arguments.push(expected_json_path)
                reference_runner: DifferentialRunner = DifferentialRunner{
                    kind: DifferentialRunnerKind.PythonAdapter,
                    name: "pinned-python-wasm-export-scan",
                    target: Commands::PYTHON,
                    entry: Commands::REFERENCE_ADAPTER,
                    arguments: reference_arguments,
                    timeout_steps: 10000,
                    max_output_bytes: 16777217
                }
                reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
                catch run_differential_process(reference_runner):
                    ok value:
                        reference_run <- value
                    error failure:
                        return false

                input_path: Path = path(source_path)
                candidate_frame: sview = EsWasmExportScan::differential_path_response(input_path, component)
                candidate_run: mutable DifferentialRun = DifferentialRun{
                    observations: [],
                    return_value: DifferentialValue{kind: DifferentialValueKind.Text, text: candidate_frame}
                }

                reference_frame: sview = process_capture_frame(reference_run.exit_status, reference_run.stdout, reference_run.stderr)
                reference_run.exit_status <- 0
                reference_run.error_text <- ""
                reference_run.stdout <- ""
                reference_run.stderr <- ""
                reference_run.return_value <- DifferentialValue{kind: DifferentialValueKind.Text, text: reference_frame}
                reference_run.outcome <- DifferentialRunOutcome.Completed

                comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
                return comparison.equal


    public:
        def scanner_pair_matches(source_path: sview, expected_json_path: sview = "", component: bool = false) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            return scanner_pair_matches_impl(source_path, expected_json_path, component)


        def python_expected_json_failure(source_path: sview, expected_json_path: sview, expected_stderr: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.PythonAdapter,
                name: "pinned-python-wasm-export-scan-expected-json-bound",
                target: Commands::PYTHON,
                entry: Commands::REFERENCE_ADAPTER,
                arguments: [source_path, expected_json_path],
                timeout_steps: 10000,
                max_output_bytes: 4096
            }
            result: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(runner):
                ok value:
                    result <- value
                error failure:
                    return false
            return result.outcome == DifferentialRunOutcome.Completed and result.exit_status == 2 and result.stdout == "" and result.stderr == expected_stderr


        def python_expected_json_bounds_match() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary: TemporaryDirectory = make_temporary_directory("wasm-export-expected-json-bounds")
            return false if not temporary.created
            oversized_path: Path = temporary.path.joinpath("oversized.json")
            deep_path: Path = temporary.path.joinpath("deep.json")
            symlink_path: Path = temporary.path.joinpath("symlink.json")
            source_path: Path = path("test/fixtures/script_parity/wasm_export_scan/basic.input")
            absolute_source: Path = try path_real(source_path) else err:
                _ = remove_fixture_directory(temporary.path)
                return false

            oversized_bytes: mutable darray[u8] = []
            for _ in 0..<1048577 |oversized_bytes|:
                oversized_bytes.push(120u8)
            oversized_written: usize = write_fixture_bytes(oversized_path, oversized_bytes)

            deep_bytes: mutable darray[u8] = []
            for _ in 0..<129 |deep_bytes|:
                deep_bytes.push(91u8)
            for _ in 0..<129 |deep_bytes|:
                deep_bytes.push(93u8)
            deep_written: usize = write_fixture_bytes(deep_path, deep_bytes)
            symlink_created: bool = create_fixture_symlink(deep_path, symlink_path)

            oversized_path_text: sview = f"{oversized_path}"
            deep_path_text: sview = f"{deep_path}"
            symlink_path_text: sview = f"{symlink_path}"
            oversized_matches: bool = python_expected_json_failure(f"{absolute_source}", oversized_path_text, "wasm export scan: invalid checked-in expected JSON: expected JSON exceeds 1048576 byte limit\n")
            deep_matches: bool = python_expected_json_failure(f"{absolute_source}", deep_path_text, "wasm export scan: invalid checked-in expected JSON: expected JSON nesting exceeds 128 levels\n")
            symlink_matches: bool = python_expected_json_failure(f"{absolute_source}", symlink_path_text, "wasm export scan: invalid checked-in expected JSON: unable to read regular file\n")

            removed_oversized: bool = remove_fixture_path(oversized_path)
            removed_deep: bool = remove_fixture_path(deep_path)
            removed_symlink: bool = remove_fixture_path(symlink_path)
            removed_root: bool = remove_fixture_directory(temporary.path)
            return oversized_written == 1048577usize and deep_written == 258usize and symlink_created and oversized_matches and deep_matches and symlink_matches and removed_oversized and removed_deep and removed_symlink and removed_root


        def flatten_payload_preserves_include_expansion_order() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, File.Read, Directory.Read]:
            source_path: Path = path("test/fixtures/script_parity/wasm_export_scan/include_nested/main.input")
            expected_json: sview = "{\"version\":1,\"flattened_source\":\"export fn before() -> void = before\\nexport fn shared() -> i32 = shared\\nexport fn nested(value: u8) -> u8 = nested\\nexport fn after() -> void = after\\n\"}"
            expected_frame: sview = process_capture_frame(0, expected_json + "\n", "")
            return EsWasmExportScan::differential_flatten_payload_response(source_path) == expected_frame


        def oversized_source_file_is_rejected_by_bounded_reader() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, File.Read, File.Write, Directory.Read, Directory.Write]:
            temporary: TemporaryDirectory = make_temporary_directory("wasm-export-source-limit")
            return false if not temporary.created
            source_path: Path = temporary.path.joinpath("oversized.input")
            source_bytes: mutable darray[u8] = []
            for _ in 0..<8388609 |source_bytes|:
                source_bytes.push(120u8)
            source_written: usize = write_fixture_bytes(source_path, source_bytes)
            candidate_frame: sview = EsWasmExportScan::differential_path_response(source_path)
            expected_frame: sview = process_capture_frame(1, "", "wasm export scan: WASM source exceeds Elisascript scan limit\n")
            removed_source: bool = remove_fixture_path(source_path)
            removed_root: bool = remove_fixture_directory(temporary.path)
            return source_written == 8388609usize and candidate_frame == expected_frame and removed_source and removed_root


        def aggregate_include_graph_bytes_are_bounded() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, File.Read, File.Write, Directory.Read, Directory.Write]:
            temporary: TemporaryDirectory = make_temporary_directory("wasm-export-graph-limit")
            return false if not temporary.created
            root_file: Path = temporary.path.joinpath("main.input")
            child_paths: mutable darray[Path] = []
            root_bytes: mutable darray[u8] = []
            for index in 0..<4 |child_paths, root_bytes, temporary|:
                child_name: sview = "child" + format_int(index.i64()) + ".input"
                child_paths.push(temporary.path.joinpath(child_name))
                append_source_text(root_bytes, "include \"" + child_name + "\"\n")
            for _ in 0..<(8388608 - root_bytes.count) |root_bytes|:
                root_bytes.push(120u8)
            child_bytes: mutable darray[u8] = []
            for _ in 0..<8388608 |child_bytes|:
                child_bytes.push(120u8)

            root_written: usize = write_fixture_bytes(root_file, root_bytes)
            all_children_written: mutable bool = true
            for child_path in child_paths |child_paths, child_bytes, all_children_written|:
                all_children_written <- write_fixture_bytes(child_path, child_bytes) == 8388608usize and all_children_written

            candidate_frame: sview = EsWasmExportScan::differential_path_response(root_file)
            expected_frame: sview = process_capture_frame(1, "", "wasm export scan: WASM include graph exceeds Elisascript scan limit\n")
            removed_children: mutable bool = true
            for child_path in child_paths |child_paths, removed_children|:
                if is_file(child_path):
                    removed_children <- remove_fixture_path(child_path) and removed_children
            removed_root_file: bool = true if not is_file(root_file) else remove_fixture_path(root_file)
            removed_root_directory: bool = remove_fixture_directory(temporary.path)
            return root_written == 8388608usize and all_children_written and candidate_frame == expected_frame and removed_children and removed_root_file and removed_root_directory


        # Candidate-only resource fixture: JSON escaping expands each U+0001
        # byte to six output bytes, so this admitted source graph must exceed
        # the structured-payload byte ceiling without emitting a partial frame.
        def structured_output_overflow_is_bounded() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, File.Read, File.Write, Directory.Read, Directory.Write]:
            temporary: TemporaryDirectory = make_temporary_directory("wasm-export-output-limit")
            return false if not temporary.created
            root_file: Path = temporary.path.joinpath("main.input")
            child_file: Path = temporary.path.joinpath("child.input")

            root_bytes: mutable darray[u8] = []
            append_source_text(root_bytes, "include \"child.input\"\n")
            for _ in 0..<(3145728 - root_bytes.count) |root_bytes|:
                root_bytes.push(1u8)
            child_bytes: mutable darray[u8] = []
            for _ in 0..<8388608 |child_bytes|:
                child_bytes.push(1u8)

            root_written: usize = write_fixture_bytes(root_file, root_bytes)
            child_written: usize = write_fixture_bytes(child_file, child_bytes)
            candidate_frame: sview = EsWasmExportScan::differential_flatten_payload_response(root_file)
            expected_frame: sview = process_capture_frame(1, "", "wasm export scan: structured output exceeds Elisascript scan limit\n")
            removed_child: bool = true if not is_file(child_file) else remove_fixture_path(child_file)
            removed_root_file: bool = true if not is_file(root_file) else remove_fixture_path(root_file)
            removed_root_directory: bool = remove_fixture_directory(temporary.path)
            return root_written == 3145728usize and child_written == 8388608usize and candidate_frame == expected_frame and removed_child and removed_root_file and removed_root_directory


        def symlink_include_cases_match() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary: TemporaryDirectory = make_temporary_directory("wasm-export-include")
            return false if not temporary.created
            temporary_root: Path = temporary.path
            actual_directory: Path = temporary_root.joinpath("actual")
            nested_directory: Path = actual_directory.joinpath("deep")
            alias_directory: Path = temporary_root.joinpath("alias")
            source_file: Path = temporary_root.joinpath("main.input")
            child_file: Path = nested_directory.joinpath("child.input")
            parent_child_file: Path = actual_directory.joinpath("child.input")
            directory_created: bool = create_fixture_directory(actual_directory)
            nested_created: bool = create_fixture_directory(nested_directory)
            child_written: usize = write_fixture_text(child_file, "export fn child() -> void = child\n")
            parent_child_written: usize = write_fixture_text(parent_child_file, "export fn child() -> void = child\n")
            linked: bool = create_fixture_symlink(nested_directory, alias_directory)
            source_argument: sview = f"{source_file}"
            existing_pair: mutable bool = false
            absolute_pair: mutable bool = false
            missing_pair: mutable bool = false
            symlink_parent_pair: mutable bool = false
            source_written: usize = write_fixture_text(source_file, "include \"alias/child.input\"\n")
            if directory_created and nested_created and child_written > 0u64 and linked and source_written > 0u64:
                existing_pair <- scanner_pair_matches(source_argument)
            absolute_include: sview = "include \"" + f"{child_file}" + "\"\n"
            absolute_written: usize = write_fixture_text(source_file, absolute_include)
            if directory_created and nested_created and child_written > 0u64 and absolute_written > 0u64:
                absolute_pair <- scanner_pair_matches(source_argument)
            missing_written: usize = write_fixture_text(source_file, "include \"alias/missing.input\"\n")
            if directory_created and nested_created and child_written > 0u64 and linked and missing_written > 0u64:
                missing_pair <- scanner_pair_matches(source_argument)
            symlink_parent_written: usize = write_fixture_text(source_file, "include \"alias/../child.input\"\n")
            if directory_created and nested_created and parent_child_written > 0u64 and linked and symlink_parent_written > 0u64:
                symlink_parent_pair <- scanner_pair_matches(source_argument)
            removed_alias: bool = remove_fixture_path(alias_directory)
            removed_source: bool = remove_fixture_path(source_file)
            removed_child: bool = remove_fixture_path(child_file)
            removed_parent_child: bool = remove_fixture_path(parent_child_file)
            removed_nested: bool = remove_fixture_directory(nested_directory)
            removed_actual: bool = remove_fixture_directory(actual_directory)
            removed_root: bool = remove_fixture_directory(temporary_root)
            return directory_created and nested_created and child_written > 0u64 and parent_child_written > 0u64 and linked and source_written > 0u64 and absolute_written > 0u64 and missing_written > 0u64 and symlink_parent_written > 0u64 and existing_pair and absolute_pair and missing_pair and symlink_parent_pair and removed_alias and removed_source and removed_child and removed_parent_child and removed_nested and removed_actual and removed_root


        def dangling_symlink_include_cases_match() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary: TemporaryDirectory = make_temporary_directory("wasm-export-dangling-link")
            return false if not temporary.created
            temporary_root: Path = temporary.path
            actual_directory: Path = temporary_root.joinpath("actual")
            actual_subdirectory: Path = actual_directory.joinpath("subdir")
            links_directory: Path = temporary_root.joinpath("links")
            source_file: Path = temporary_root.joinpath("main.input")
            child_file: Path = actual_directory.joinpath("child.input")
            relative_link: Path = links_directory.joinpath("relative-link")
            parent_tail_link: Path = links_directory.joinpath("parent-tail-link")
            nested_link: Path = links_directory.joinpath("nested-link")
            absolute_link: Path = links_directory.joinpath("absolute-link")
            missing_link: Path = links_directory.joinpath("missing-link")
            directory_created: bool = create_fixture_directory(actual_directory)
            subdirectory_created: bool = create_fixture_directory(actual_subdirectory)
            links_created: bool = create_fixture_directory(links_directory)
            child_written: usize = write_fixture_text(child_file, "export fn child() -> void = child\n")
            relative_linked: bool = create_fixture_symlink(path("../missing/../actual"), relative_link)
            parent_tail_linked: bool = create_fixture_symlink(path("../missing/../actual/subdir"), parent_tail_link)
            nested_linked: bool = create_fixture_symlink(path("relative-link"), nested_link)
            absolute_target: sview = f"{temporary_root}/missing/../actual"
            absolute_linked: bool = create_fixture_symlink(path(absolute_target), absolute_link)
            missing_linked: bool = create_fixture_symlink(path("missing/leaf.input"), missing_link)
            relative_pair: mutable bool = false
            parent_tail_pair: mutable bool = false
            nested_pair: mutable bool = false
            absolute_pair: mutable bool = false
            missing_pair: mutable bool = false
            source_written: usize = write_fixture_text(source_file, "include \"links/relative-link/child.input\"\n")
            if directory_created and links_created and child_written > 0u64 and relative_linked and source_written > 0u64:
                relative_pair <- scanner_pair_matches(f"{source_file}")
            source_written <- write_fixture_text(source_file, "include \"links/parent-tail-link/../child.input\"\n")
            if directory_created and subdirectory_created and links_created and child_written > 0u64 and parent_tail_linked and source_written > 0u64:
                parent_tail_pair <- scanner_pair_matches(f"{source_file}")
            source_written <- write_fixture_text(source_file, "include \"links/nested-link/child.input\"\n")
            if directory_created and links_created and child_written > 0u64 and relative_linked and nested_linked and source_written > 0u64:
                nested_pair <- scanner_pair_matches(f"{source_file}")
            source_written <- write_fixture_text(source_file, "include \"links/absolute-link/child.input\"\n")
            if directory_created and links_created and child_written > 0u64 and absolute_linked and source_written > 0u64:
                absolute_pair <- scanner_pair_matches(f"{source_file}")
            source_written <- write_fixture_text(source_file, "include \"links/missing-link\"\n")
            if missing_linked and source_written > 0u64:
                missing_pair <- scanner_pair_matches(f"{source_file}")

            removed_relative: bool = remove_fixture_path(relative_link)
            removed_parent_tail: bool = remove_fixture_path(parent_tail_link)
            removed_nested: bool = remove_fixture_path(nested_link)
            removed_absolute: bool = remove_fixture_path(absolute_link)
            removed_missing: bool = remove_fixture_path(missing_link)
            removed_source: bool = remove_fixture_path(source_file)
            removed_child: bool = remove_fixture_path(child_file)
            removed_subdirectory: bool = remove_fixture_directory(actual_subdirectory)
            removed_actual: bool = remove_fixture_directory(actual_directory)
            removed_links_directory: bool = remove_fixture_directory(links_directory)
            removed_root: bool = remove_fixture_directory(temporary_root)
            return directory_created and subdirectory_created and links_created and child_written > 0u64 and relative_linked and parent_tail_linked and nested_linked and absolute_linked and missing_linked and relative_pair and parent_tail_pair and nested_pair and absolute_pair and missing_pair and removed_relative and removed_parent_tail and removed_nested and removed_absolute and removed_missing and removed_source and removed_child and removed_subdirectory and removed_actual and removed_links_directory and removed_root


        def dangling_symlink_cycle_is_bounded() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, File.Read, File.Write, Directory.Read, Directory.Write]:
            temporary: TemporaryDirectory = make_temporary_directory("wasm-export-link-cycle")
            return false if not temporary.created
            temporary_root: Path = temporary.path
            source_file: Path = temporary_root.joinpath("main.input")
            first_link: Path = temporary_root.joinpath("first-link")
            second_link: Path = temporary_root.joinpath("second-link")
            first_created: bool = create_fixture_symlink(path("second-link"), first_link)
            second_created: bool = create_fixture_symlink(path("first-link"), second_link)
            source_written: usize = write_fixture_text(source_file, "include \"first-link\"\n")
            bounded: mutable bool = false
            if first_created and second_created and source_written > 0u64:
                actual_frame: sview = EsWasmExportScan::differential_path_response(source_file)
                expected_frame: sview = process_capture_frame(1, "", "wasm export scan: WASM symlink resolution exceeds Elisascript scan limit\n")
                bounded <- actual_frame == expected_frame

            removed_first: bool = remove_fixture_path(first_link)
            removed_second: bool = remove_fixture_path(second_link)
            removed_source: bool = remove_fixture_path(source_file)
            removed_root: bool = remove_fixture_directory(temporary_root)
            return first_created and second_created and source_written > 0u64 and bounded and removed_first and removed_second and removed_source and removed_root


        # Candidate-only resource fixture: the pinned Python oracle has no
        # shared weighted-work cap for expanded symlink targets.
        def dangling_symlink_expansion_work_is_bounded() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary: TemporaryDirectory = make_temporary_directory("wasm-export-link-work")
            return false if not temporary.created
            temporary_root: Path = temporary.path
            source_file: Path = temporary_root.joinpath("main.input")
            link_paths: mutable darray[Path] = []
            all_links_created: mutable bool = true
            for index in 0..<60 |temporary_root, all_links_created, link_paths, index|:
                link_name: sview = "link_" + format_int(index.i64())
                link_path: Path = temporary_root.joinpath(link_name)
                target_bytes: mutable darray[u8] = []
                append_repeated_source_text(target_bytes, "./", 400)
                next_target: sview = "missing.input"
                next_target <- "link_" + format_int((index + 1).i64()) if index + 1 < 60
                append_source_text(target_bytes, next_target)
                linked: bool = create_fixture_symlink(path(bytes_view(target_bytes)), link_path)
                if not linked:
                    all_links_created <- false
                    break
                link_paths.push(link_path)

            source_written: usize = write_fixture_text(source_file, "include \"link_0\"\n")
            expected_frame: sview = process_capture_frame(1, "", "wasm export scan: WASM path component work exceeds Elisascript scan limit\n")
            bounded: mutable bool = false
            if all_links_created and source_written > 0u64:
