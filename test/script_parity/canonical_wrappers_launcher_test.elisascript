# Dormant wrapper matrix with ordinary probes and actual exec-failure cases.
# Do not compile tools here. Run only through the bounded wrapper after explicit
# user reauthorization and separate probe/launcher qualification.
include "../../src/testing/differential.elisa"
include "process_probe_model.elisa"
include "canonical_wrapper_scope.elisa"
include "canonical_lint_cases.elisa"
include "canonical_lint_exec_failure_cases.elisa"
include "../../src/testing/observation_preview_model.elisa"
include "../../src/testing/checksum_record_model.elisa"

using EsDifferential


module EsCanonicalWrappersLauncherParity:
    private:
        using EsCanonicalWrapperScope
        using EsCanonicalLintCases

        const module Tools:
            COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            BASH: sview = "/bin/bash"
            BASH_SHA256: sview = "d59c6f2312e551e9c46497329d435b6ec74fbc46e9155b84170f377127ed004e"
            SHA256: sview = "/usr/bin/shasum"
            TIMEOUT_STEPS: u64 = 10000
            OUTPUT_BYTES: u64 = 262144
            PIN_BYTES: usize = 67108864
            SOURCE_BYTES: usize = 524288
            TOTAL_SOURCE_BYTES: usize = 2097152
            PROBE_BYTES: usize = 16777216
            EXECUTABLE_MODE: u64 = 493
            MARKER: sview = "inherited marker with spaces"


        const module Coverage:
            LINT_SOURCES: usize = 2
            FAMILY_SOURCES: usize = 7
            LINT_CASES: usize = 11
            FAMILY_CASES: usize = 17
            LINT_EXEC_FAILURES: usize = 7


        struct SourceCopy:
            source: sview
            destination: sview
            sha256: sview
            executable: bool = false


        struct Authorization:
            launcher: sview
            launcher_hash: sview
            compiler_hash: sview
            probe: sview
            probe_hash: sview


        struct TemporaryRoot:
            path: Path
            created: bool = false
            ready: bool = false
            files: darray[Path] = []
            directories: darray[Path] = []


        error GateError:
            Disabled
            WrongCompiler
            MissingIdentity


        def environment_value(name: sview) -> sview can[Environment.Read]:
            return try getenv(name, "") else ""


        def valid_hash(value: sview) -> bool:
            return false if len(value) != 64
            for byte in value:
                return false if not ((byte >= 48u8 and byte <= 57u8) or (byte >= 97u8 and byte <= 102u8))
            return true


        def authorization() -> Authorization error[GateError] can[Environment.Read]:
            raise GateError.Disabled if environment_value("ELISASCRIPT_VALIDATION_REAUTHORIZED") != "1" or environment_value("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD") != "active"
            raise GateError.WrongCompiler if environment_value("ELISA_LOCAL_COMPILER") != Tools::COMPILER or environment_value("ELISACORE_BIN") != Tools::COMPILER
            launcher: sview = environment_value("ELISASCRIPT_PUBLIC_LAUNCHER")
            launcher_hash: sview = environment_value("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256")
            compiler_hash: sview = environment_value("ELISASCRIPT_LOCAL_COMPILER_SHA256")
            probe: sview = environment_value("ELISASCRIPT_PROCESS_PROBE")
            probe_hash: sview = environment_value("ELISASCRIPT_PROCESS_PROBE_SHA256")
            raise GateError.MissingIdentity if launcher == "" or probe == "" or not launcher.startswith("/") or not probe.startswith("/") or not valid_hash(launcher_hash) or not valid_hash(compiler_hash) or not valid_hash(probe_hash)
            return Authorization{launcher: launcher, launcher_hash: launcher_hash, compiler_hash: compiler_hash, probe: probe, probe_hash: probe_hash}


        def source_set(wave: Wave) -> darray[SourceCopy] can[Memory.Allocate, Abort.Panic]:
            available: darray[SourceCopy] = [
                SourceCopy{source: "test/fixtures/script_parity/canonical_lint/reference.sh", destination: "scripts/lint_canonical.sh", sha256: "fd013f06d3575ed426f1c464fb8b4fb7378fe71deb982cef4a2ae8b4c353fa35", executable: true},
                SourceCopy{source: "test/fixtures/script_parity/canonical_test/test_canonical.sh", destination: "scripts/test_canonical.sh", sha256: "c81db16fcb7662ae88161d167247d8705aa0cdfb090dd4ecfb184ae045b9ef07", executable: true},
                SourceCopy{source: "test/fixtures/script_parity/canonical_test/test_campaign.sh", destination: "scripts/test_campaign.sh", sha256: "7d2178ce4729f88835bf283aa4a265cdc6c1b859daab0a8de41883e8409c83dc", executable: true},
                SourceCopy{source: "ports/neural-computer-agentV2/scripts/lint_canonical.elisascript", destination: "scripts/lint_canonical.elisascript", sha256: "4ce0cdebd704f06c2a9e3033e5ffabc31e05dd2234cccfec4792b0d67a149cb4"},
                SourceCopy{source: "ports/neural-computer-agentV2/scripts/canonical_test.elisascript", destination: "scripts/canonical_test.elisascript", sha256: "cfdf6d6ea50cb53f0ea18a8b255fafc84178755835f6290c40ddfb58245785fb"},
                SourceCopy{source: "ports/neural-computer-agentV2/scripts/test_canonical.elisascript", destination: "scripts/test_canonical.elisascript", sha256: "88ccd7e2785e83514a9d544f3392e6f939122d785121123eef3e0157c76cfe7b"},
                SourceCopy{source: "ports/neural-computer-agentV2/scripts/test_campaign.elisascript", destination: "scripts/test_campaign.elisascript", sha256: "bbfb6919be9e85a6ced947fe93a771eaec680c39b51c7135466ea08b2472e401"}
            ]
            selected: mutable darray[SourceCopy] = []
            for source in available |selected|:
                selected.push(source) if includes_source(wave, source.destination)
            return selected


        def has_hash(target: sview, expected: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if not valid_hash(expected)
            return false if len(target) == 0 or len(target) > EsChecksumRecord::Limits::FILENAME_BYTES
            # Even after --, shasum interprets exactly "-" as standard input.
            return false if target == "-"
            for byte in target:
                return false if byte == 0u8
            return false if not is_file(path(target))
            size: usize = try file_size(path(target)) else err:
                return false
            return false if size == 0 or size > Tools::PIN_BYTES
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess, name: "canonical-wrapper-identity",
                target: Tools::SHA256, arguments: ["-a", "256", "-t", "--", target],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES
            }
            observed: DifferentialRun = try run_differential_process(runner) else err:
                return false
            return false if observed.outcome != DifferentialRunOutcome.Completed or observed.exit_status != 0 or observed.stderr != ""
            return try EsChecksumRecord::sha256_text_record_matches(observed.stdout, expected, target) else false


        def pinned_inputs(auth: Authorization, wave: Wave) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if is_symlink(path(Tools::COMPILER)) or is_symlink(path(auth.probe)) or not is_executable(path(Tools::COMPILER)) or not is_executable(path(auth.probe)) or not is_executable(path(auth.launcher))
            return false if not has_hash(Tools::COMPILER, auth.compiler_hash) or not has_hash(auth.probe, auth.probe_hash) or not has_hash(auth.launcher, auth.launcher_hash) or not has_hash(Tools::BASH, Tools::BASH_SHA256)
            return false if not has_hash("test/fixtures/script_parity/process_probe/probe.c", "fbaf5b83b8ec226a980bfc52e0fca56380acb42b7a80dc6cf773533d550a0e8d") or not has_hash("test/script_parity/process_probe_model.elisa", "d7394a1583feafeba29046a24149a8760ac9219fd0786afe05942192ad46bbec")
            return false if not has_hash("test/script_parity/canonical_lint_cases.elisa", "a8c0221bd25fe0713cad3764dc114e71386931398eafee359af0e43a8c562d8a")
            return false if not has_hash("test/script_parity/canonical_wrapper_scope.elisa", "baf5e20f45a943211d85239c5b7afe491d672b150e929afa19991415e3700437")
            return false if not has_hash("test/script_parity/canonical_lint_exec_failure_cases.elisa", "a3b19ba6bfbcdc8482999509f5b945f0c1f20d2a14ac4755fa481f1285189608")
            return false if not has_hash("src/testing/observation_preview_model.elisa", "7553c78bb167295a9be1528b6f05acb037098800adbe8c05acfaa2e23f0ee1b7")
            return false if not has_hash("src/testing/checksum_record_model.elisa", "1b3cec1235d42076e50b15491d3d6b906f3841ea966937779dc665f1e8a59488")
            sources: darray[SourceCopy] = source_set(wave)
            expected_count: usize = Coverage::LINT_SOURCES if wave == Wave.LintOnly else Coverage::FAMILY_SOURCES
            return false if sources.count != expected_count
            for source in sources:
                return false if not has_hash(source.source, source.sha256)
            return true


        def byte_equal(actual: sview, expected: darray[u8]) -> bool can[Memory.Allocate, Abort.Panic]:
            bytes: darray[u8] = EsProcessProbe::text_bytes(actual)
            return false if bytes.count != expected.count
            for index in 0..<expected.count:
                return false if bytes[index] != expected[index]
            return true


        def normal_observation(run: DifferentialRun, status: i64, stdout: darray[u8]) -> bool can[Memory.Allocate, Abort.Panic]:
            return run.outcome == DifferentialRunOutcome.Completed and run.exit_status == status and byte_equal(run.stdout, stdout) and byte_equal(run.stderr, EsProcessProbe::expected_stderr())


        def direct_probe_golden(auth: Authorization) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess, name: "independent-probe-golden",
                target: auth.probe, arguments: ["", "a b"], working_directory: "/",
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                environment: [DifferentialEnvironmentEntry{name: "RUFF_BIN", value: ""}, DifferentialEnvironmentEntry{name: "ELISASCRIPT_PARITY_PROBE_MARKER", value: "x"}, DifferentialEnvironmentEntry{name: "ELISASCRIPT_PARITY_PROBE_EXIT_STATUS", value: "23"}],
                stdin_binary: true, stdin_bytes: [0u8, 255u8, 10u8],
                timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES
            }
            observed: DifferentialRun = try run_differential_process(runner) else err:
                exec_failure_notice("direct-probe", "golden-run-error-no-receipt")
                return false
            # Literal golden, not output computed by either encoder.
            expected: darray[u8] = [69u8,83u8,80u8,82u8,79u8,66u8,69u8,49u8, 0u8,0u8,0u8,2u8, 0u8,0u8,0u8,0u8, 0u8,0u8,0u8,3u8,97u8,32u8,98u8, 0u8,0u8,0u8,1u8,47u8, 0u8, 1u8,0u8,0u8,0u8,0u8, 1u8,0u8,0u8,0u8,1u8,120u8, 0u8,0u8,0u8,3u8,0u8,255u8,10u8, 0u8,255u8]
            if not normal_observation(observed, 23, expected):
                exec_failure_evidence("direct-probe", "golden-contract", observed, 23)
                expected_stream_evidence("direct-probe", "golden-contract", "expected-stdout", expected)
                expected_stderr: darray[u8] = EsProcessProbe::expected_stderr()
                expected_stream_evidence("direct-probe", "golden-contract", "expected-stderr", expected_stderr)
                return false
            return true


        # Observation fence, not atomic filesystem identity. A descriptor-
        # relative cleanup adapter and external mutation exclusion still need
        # qualification before this can be treated as containment.
        def cleanup_parents_intact(root: TemporaryRoot, remaining: usize) -> bool can[Memory.Allocate, Abort.Panic, File.Read, Directory.Read]:
            return false if remaining > root.directories.count or is_symlink(root.path) or not is_directory(root.path)
            for index in 0..<remaining:
                directory: Path = root.directories[index]
                return false if is_symlink(directory) or not is_directory(directory)
            return true


        def cleanup(root: TemporaryRoot) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write]:
            return true if not root.created
            cleaned: mutable bool = true
            for index in 0..<root.files.count |root, cleaned|:
                return false if not cleanup_parents_intact(root, root.directories.count)
                target: Path = root.files[root.files.count - index - 1]
                # copy_asset registers before copying, so a failed copy may
                # leave no file. Dangling final symlinks still need unlinking.
                if path_exists(target) or is_symlink(target):
                    removed: bool = try remove_path(target) else false
                    cleaned <- removed and cleaned
            for index in 0..<root.directories.count |root, cleaned|:
                # Directories were created parent-first and retire in reverse.
                # Exclude already removed suffix entries from the next fence.
                return false if not cleanup_parents_intact(root, root.directories.count - index)
                removed: bool = try remove_directory(root.directories[root.directories.count - index - 1]) else false
                cleaned <- removed and cleaned
            return false if not cleanup_parents_intact(root, 0)
            removed: bool = try remove_directory(root.path) else false
            return removed and cleaned


        def copy_asset(root: mutable TemporaryRoot&, source: sview, destination: sview, expected: sview, executable: bool) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Unsafe.PointerCast, Console.Format]:
            target: Path = root.path.joinpath(destination)
            root.files.push(target)
            copied: bool = try copy_path(path(source), target) else false
            return false if not copied
            if executable:
                changed: bool = try chmod(target, Tools::EXECUTABLE_MODE) else false
                return false if not changed
            return has_hash(f"{target}", expected)


        def exec_failure_fixture_ready(root: TemporaryRoot) -> bool can[Memory.Allocate, Abort.Panic, File.Read, Directory.Read, Console.Format]:
            return false if not root.ready or is_symlink(root.path) or not is_directory(root.path)
            tools: Path = root.path.joinpath("tools")
            scripts: Path = root.path.joinpath("scripts")
            return false if is_symlink(tools) or not is_directory(tools) or is_symlink(scripts) or not is_directory(scripts)
            denied: Path = tools.joinpath(EsCanonicalLintExecFailureCases::Fixture::DENIED_NAME)
            return false if is_symlink(denied) or not is_file(denied) or is_executable(denied)
            mode: u64 = try file_mode(denied) else err:
                return false
            return false if (mode & EsCanonicalLintExecFailureCases::Fixture::MODE_MASK) != EsCanonicalLintExecFailureCases::Fixture::DENIED_MODE
            # Bash needs dirname from /usr/bin or /bin. Admit no accidental
            # missing/denied-name executable in any searched directory.
            for directory in [f"{tools}", "/usr/bin", "/bin"]:
                missing: Path = path(directory).joinpath(EsCanonicalLintExecFailureCases::Fixture::MISSING_NAME)
                return false if path_exists(missing) or is_symlink(missing)
                if directory != f"{tools}":
                    other: Path = path(directory).joinpath(EsCanonicalLintExecFailureCases::Fixture::DENIED_NAME)
                    return false if path_exists(other) or is_symlink(other)
            return true


        def pinned_copies(auth: Authorization, root: TemporaryRoot, wave: Wave) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Format]:
            for source in source_set(wave):
                return false if not has_hash(f"{root.path.joinpath(source.destination)}", source.sha256)
            for destination in probes(wave):
                return false if not has_hash(f"{root.path.joinpath(destination)}", auth.probe_hash)
            denied: Path = root.path.joinpath("tools").joinpath(EsCanonicalLintExecFailureCases::Fixture::DENIED_NAME)
            return has_hash(f"{denied}", auth.probe_hash) and exec_failure_fixture_ready(root)


        def create_root(auth: Authorization, wave: Wave) -> TemporaryRoot can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Format]:
            allocated: Path = try temp_directory("elisascript canonical wrapper parity ") else err:
                return TemporaryRoot{path: path("."), created: false}
            canonical: Path = try path_real(allocated) else err:
                return TemporaryRoot{path: allocated, created: true}
            root: mutable TemporaryRoot = TemporaryRoot{path: canonical, created: true}
            for relative in directories(wave):
                target: Path = root.path.joinpath(relative)
                created: bool = try create_directory(target) else false
                return root if not created
                root.directories.push(target)
            source_bytes: mutable usize = 0
            for source in source_set(wave) |root, source_bytes|:
                size: usize = try file_size(path(source.source)) else err:
                    return root
                return root if size == 0 or size > Tools::SOURCE_BYTES or size > Tools::TOTAL_SOURCE_BYTES - source_bytes
                return root if not copy_asset(root, source.source, source.destination, source.sha256, source.executable)
                source_bytes <- source_bytes + size
            probe_size: usize = try file_size(path(auth.probe)) else err:
                return root
            return root if probe_size == 0 or probe_size > Tools::PROBE_BYTES
            for destination in probes(wave):
                return root if not copy_asset(root, auth.probe, destination, auth.probe_hash, true)
            # This extra copy is data, never an executable probe alias.
            denied_relative: sview = "tools/" + EsCanonicalLintExecFailureCases::Fixture::DENIED_NAME
            return root if not copy_asset(root, auth.probe, denied_relative, auth.probe_hash, false)
            denied_mode_set: bool = try chmod(root.path.joinpath(denied_relative), EsCanonicalLintExecFailureCases::Fixture::DENIED_MODE) else false
            return root if not denied_mode_set
            root.ready <- true
            return root


        def cases(wave: Wave) -> darray[Case] can[Memory.Allocate, Abort.Panic]:
            # Do not even construct larger-wrapper cases in the default wave.
            selected: mutable darray[Case] = EsCanonicalLintCases::ordinary()
            return selected if wave == Wave.LintOnly
            family: darray[Case] = [
                Case{reference: "test_canonical.sh", candidate: "test_canonical.elisascript", variable: "PYTHON_BIN", selection: Selection.Unset, arguments: [], expected_argv: ["-m", "pytest", "-q", "-m", "not campaign"], status: 0},
                Case{reference: "test_canonical.sh", candidate: "test_canonical.elisascript", variable: "PYTHON_BIN", selection: Selection.Empty, arguments: ["", "-k", "one or two"], expected_argv: ["-m", "pytest", "-q", "-m", "not campaign", "-k", "one or two"], status: 23},
                Case{reference: "test_canonical.sh", candidate: "test_canonical.elisascript", variable: "PYTHON_BIN", selection: Selection.Relative, arguments: ["fast", "", "a b", "*.py", "$HOME", "--"], expected_argv: ["-m", "pytest", "-q", "-m", "not campaign", "", "a b", "*.py", "$HOME", "--"], status: 1},
                Case{reference: "test_canonical.sh", candidate: "test_canonical.elisascript", variable: "PYTHON_BIN", selection: Selection.Absolute, arguments: ["campaign", "-m", "custom"], expected_argv: ["-m", "pytest", "-q", "-m", "campaign", "-m", "custom"], status: 2},
                Case{reference: "test_canonical.sh", candidate: "test_canonical.elisascript", variable: "PYTHON_BIN", selection: Selection.Absolute, arguments: ["all", "--maxfail=1"], expected_argv: ["-m", "pytest", "-q", "--maxfail=1"], status: 23},
                Case{reference: "test_campaign.sh", candidate: "test_campaign.elisascript", variable: "PYTHON_BIN", selection: Selection.Absolute, arguments: ["all", "", "-m", "custom"], expected_argv: ["-m", "pytest", "-q", "-m", "campaign", "all", "", "-m", "custom"], status: 0}
            ]
            for item in family |selected|:
                selected.push(item) if includes_reference(wave, item.reference)
            return selected


        def case_matches(auth: Authorization, root: TemporaryRoot, selected: Case, case_name: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Write, Console.Format]:
            root_text: sview = f"{root.path}"
            configured: sview = when selected.selection:
                Selection.Unset -> ""
                Selection.Empty -> ""
                Selection.Relative -> "tools/probe with spaces"
                Selection.Absolute -> root_text + "/tools/probe with spaces"
                Selection.PathName -> "probe with spaces"
                Selection.LiteralRelative -> "tools/" + EsCanonicalLintCases::Fixture::LITERAL_NAME
                Selection.LiteralAbsolute -> root_text + "/tools/" + EsCanonicalLintCases::Fixture::LITERAL_NAME
                Selection.LiteralPathName -> EsCanonicalLintCases::Fixture::LITERAL_NAME
            environment: mutable darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: root_text + "/tools:/usr/bin:/bin"},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Tools::COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Tools::COMPILER},
                DifferentialEnvironmentEntry{name: "ELISASCRIPT_PARITY_PROBE_MARKER", value: Tools::MARKER},
                DifferentialEnvironmentEntry{name: "ELISASCRIPT_PARITY_PROBE_EXIT_STATUS", value: format_int(selected.status)}
            ]
            environment.push(DifferentialEnvironmentEntry{name: selected.variable, value: configured}) if selected.selection != Selection.Unset
            input: darray[u8] = [0u8, 255u8, 10u8, 120u8]
            observed_environment: EsProcessProbe::EnvironmentValue = EsProcessProbe::EnvironmentValue{present: selected.selection != Selection.Unset, bytes: EsProcessProbe::text_bytes(configured)}
            argv_bytes: mutable darray[darray[u8]] = []
            for argument in selected.expected_argv:
                argv_bytes.push(EsProcessProbe::text_bytes(argument))
            observation: EsProcessProbe::Observation = EsProcessProbe::Observation{
                arguments: argv_bytes, cwd: EsProcessProbe::text_bytes(root_text), stdin: input,
                python_bin: observed_environment if selected.variable == "PYTHON_BIN" else EsProcessProbe::EnvironmentValue{},
                ruff_bin: observed_environment if selected.variable == "RUFF_BIN" else EsProcessProbe::EnvironmentValue{},
                marker: EsProcessProbe::EnvironmentValue{present: true, bytes: EsProcessProbe::text_bytes(Tools::MARKER)}
            }
            expected: darray[u8] = try EsProcessProbe::expected_stdout(observation) else err:
                exec_failure_notice(case_name, "oracle-frame-build-error")
                return false
            reference_argv: mutable darray[sview] = [root_text + "/scripts/" + selected.reference]
            candidate_argv: mutable darray[sview] = [root_text + "/scripts/" + selected.candidate]
            for argument in selected.arguments:
                reference_argv.push(argument)
                candidate_argv.push(argument)
            reference: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess, name: "canonical-wrapper-reference", target: Tools::BASH,
                arguments: reference_argv, working_directory: "/", environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace, stdin_binary: true, stdin_bytes: input,
                timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES
            }
            candidate: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess, name: "canonical-wrapper-candidate", target: auth.launcher,
                arguments: candidate_argv, working_directory: "/", environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace, stdin_binary: true, stdin_bytes: input,
                timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES
            }
            reference_run: DifferentialRun = try run_differential_process(reference) else err:
                exec_failure_notice(case_name, "ordinary-reference-run-error-no-receipt")
                return false
            # A matching pair can still be jointly wrong. Qualify the original
            # against the independent oracle before launching the candidate.
            if not normal_observation(reference_run, selected.status, expected):
                exec_failure_evidence(case_name, "ordinary-reference-contract", reference_run, selected.status)
                expected_stream_evidence(case_name, "ordinary-reference-contract", "expected-stdout", expected)
                expected_stderr: darray[u8] = EsProcessProbe::expected_stderr()
                expected_stream_evidence(case_name, "ordinary-reference-contract", "expected-stderr", expected_stderr)
                return false
            candidate_run: DifferentialRun = try run_differential_process(candidate) else err:
                exec_failure_notice(case_name, "ordinary-candidate-run-error-no-receipt")
                exec_failure_evidence(case_name, "ordinary-reference-before-candidate-error", reference_run, selected.status)
                return false
            if not normal_observation(candidate_run, selected.status, expected):
                exec_failure_evidence(case_name, "ordinary-reference-before-candidate-contract", reference_run, selected.status)
                exec_failure_evidence(case_name, "ordinary-candidate-contract", candidate_run, selected.status)
                return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            if not comparison.equal:
                exec_failure_evidence(case_name, "ordinary-reference-comparison", reference_run, selected.status)
                exec_failure_evidence(case_name, "ordinary-candidate-comparison", candidate_run, selected.status)
            return comparison.equal


        def exec_failure_observation(run: DifferentialRun, status: i64) -> bool:
            return run.outcome == DifferentialRunOutcome.Completed and run.exit_status == status and run.stdout == "" and run.stderr != ""


        def outcome_label(outcome: DifferentialRunOutcome) -> sview:
            return when outcome:
                DifferentialRunOutcome.Completed -> "completed"
                DifferentialRunOutcome.NormalError -> "normal-error"
                DifferentialRunOutcome.SpawnFailure -> "spawn-failure"
                DifferentialRunOutcome.Crash -> "crash"
                DifferentialRunOutcome.Timeout -> "timeout"
                DifferentialRunOutcome.OutputLimit -> "output-limit"
                DifferentialRunOutcome.CompileFailure -> "compile-failure"
                _ -> "unknown"


        def exec_failure_notice(name: sview, phase: sview) -> void can[Console.Write]:
            # Names/phases are pinned fixture literals, not observed stream data.
            _ = write_stderr("canonical wrapper failure: case=" + name + "; phase=" + phase + "\n")


        def exec_failure_stream_evidence(name: sview, phase: sview, stream: sview, prefix: EsObservationPreview::Preview&, tail: EsObservationPreview::Preview&) -> void can[Console.Write, Console.Format]:
            cut: sview = "yes" if prefix.truncated else "no"
            _ = write_stderr(f"canonical wrapper stream: case={name}; phase={phase}; stream={stream}; retained_bytes={prefix.total_bytes}; prefix_hex={bytes_view(prefix.hex)}; tail_hex={bytes_view(tail.hex)}; window_truncated={cut}\n")


        def expected_stream_evidence(name: sview, phase: sview, stream: sview, bytes: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            prefix: EsObservationPreview::Preview = try EsObservationPreview::preview(bytes_view(bytes)) else failure:
                exec_failure_notice(name, "expected-evidence-preview-failed")
                return
            tail: EsObservationPreview::Preview = try EsObservationPreview::tail_preview(bytes_view(bytes)) else failure:
                exec_failure_notice(name, "expected-evidence-preview-failed")
                return
            exec_failure_stream_evidence(name, phase, stream, prefix, tail)


        def exec_failure_evidence(name: sview, phase: sview, run: DifferentialRun&, expected_status: i64) -> void can[Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            stdout: EsObservationPreview::Preview = try EsObservationPreview::preview(run.stdout) else failure:
                exec_failure_notice(name, "evidence-preview-failed")
                return
            stderr: EsObservationPreview::Preview = try EsObservationPreview::preview(run.stderr) else failure:
                exec_failure_notice(name, "evidence-preview-failed")
                return
            error_preview: EsObservationPreview::Preview = try EsObservationPreview::preview(run.error_text) else failure:
                exec_failure_notice(name, "evidence-preview-failed")
                return
            stdout_tail: EsObservationPreview::Preview = try EsObservationPreview::tail_preview(run.stdout) else failure:
                exec_failure_notice(name, "evidence-preview-failed")
                return
            stderr_tail: EsObservationPreview::Preview = try EsObservationPreview::tail_preview(run.stderr) else failure:
                exec_failure_notice(name, "evidence-preview-failed")
                return
            error_tail: EsObservationPreview::Preview = try EsObservationPreview::tail_preview(run.error_text) else failure:
                exec_failure_notice(name, "evidence-preview-failed")
                return
            # Non-completed outcomes do not have a completed exit-status receipt.
            status: sview = f"{run.exit_status}" if run.outcome == DifferentialRunOutcome.Completed else "unavailable"
            _ = write_stderr(f"canonical wrapper failure: case={name}; phase={phase}; outcome={outcome_label(run.outcome)}; expected_status={expected_status}; actual_status={status}\n")
            exec_failure_stream_evidence(name, phase, "stdout", stdout, stdout_tail)
            exec_failure_stream_evidence(name, phase, "stderr", stderr, stderr_tail)
            exec_failure_stream_evidence(name, phase, "error-text", error_preview, error_tail)


        def exec_failure_case_matches(auth: Authorization, root: TemporaryRoot, selected: EsCanonicalLintExecFailureCases::Case) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Write, Console.Format]:
            if not exec_failure_fixture_ready(root):
                exec_failure_notice(selected.name, "fixture-before-reference")
                return false
            root_text: sview = f"{root.path}"
            configured: sview = EsCanonicalLintExecFailureCases::executable_text(selected, root_text)
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: root_text + "/tools:/usr/bin:/bin"},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "RUFF_BIN", value: configured},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Tools::COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Tools::COMPILER}
            ]
            input: darray[u8] = [0u8, 255u8, 10u8]
            reference: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess, name: selected.name + "-reference", target: Tools::BASH,
                arguments: [root_text + "/scripts/lint_canonical.sh"], working_directory: "/",
                environment: environment, environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                stdin_binary: true, stdin_bytes: input,
                timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES
            }
            candidate: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess, name: selected.name + "-candidate", target: auth.launcher,
                arguments: [root_text + "/scripts/lint_canonical.elisascript"], working_directory: "/",
                environment: environment, environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                stdin_binary: true, stdin_bytes: input,
                timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES
            }
            reference_run: DifferentialRun = try run_differential_process(reference) else err:
                exec_failure_notice(selected.name, "reference-run-error-no-receipt")
                return false
            # Independent status/no-stdout/nonempty-diagnostic admission first.
            # Exact error bytes are then compared to the pinned reference;
            # they are not claimed to have a separate literal stderr oracle.
            if not exec_failure_observation(reference_run, selected.status):
                exec_failure_evidence(selected.name, "reference-contract", reference_run, selected.status)
                return false
            if not exec_failure_fixture_ready(root):
                exec_failure_evidence(selected.name, "fixture-after-reference", reference_run, selected.status)
                return false
            candidate_run: DifferentialRun = try run_differential_process(candidate) else err:
                exec_failure_notice(selected.name, "candidate-run-error-no-receipt")
                exec_failure_evidence(selected.name, "reference-before-candidate-error", reference_run, selected.status)
                return false
            if not exec_failure_observation(candidate_run, selected.status):
                exec_failure_evidence(selected.name, "reference-before-candidate-contract", reference_run, selected.status)
                exec_failure_evidence(selected.name, "candidate-contract", candidate_run, selected.status)
                return false
            if not exec_failure_fixture_ready(root):
                exec_failure_evidence(selected.name, "reference-before-fixture-failure", reference_run, selected.status)
                exec_failure_evidence(selected.name, "fixture-after-candidate", candidate_run, selected.status)
                return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            if not comparison.equal:
                exec_failure_evidence(selected.name, "reference-comparison", reference_run, selected.status)
                exec_failure_evidence(selected.name, "candidate-comparison", candidate_run, selected.status)
            return comparison.equal


        def exec_failure_matrix(auth: Authorization, root: TemporaryRoot) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Write, Console.Format]:
            required_cases: darray[EsCanonicalLintExecFailureCases::Case] = EsCanonicalLintExecFailureCases::required()
            return false if required_cases.count != Coverage::LINT_EXEC_FAILURES
            for selected in required_cases:
                return false if not exec_failure_case_matches(auth, root, selected)
            return true


        def matrix(auth: Authorization, root: TemporaryRoot, wave: Wave) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Write, Console.Format]:
            selected_cases: darray[Case] = cases(wave)
            expected_count: usize = Coverage::LINT_CASES if wave == Wave.LintOnly else Coverage::FAMILY_CASES
            return false if selected_cases.count != expected_count
            for index in 0..<selected_cases.count:
                selected: Case = selected_cases[index]
                case_name: sview = f"{selected.reference}:ordinary-{index}"
                return false if not case_matches(auth, root, selected, case_name)
            # Both waves include lint: ordinary exits alone cannot accept it.
            return exec_failure_matrix(auth, root)

    public:
        # The smallest script is the default acceptance wave. Wider coverage
        # requires an explicit selection, never a successful lint case alone.
        def public_launcher_parity(wave: EsCanonicalWrapperScope::Wave = EsCanonicalWrapperScope::Wave.LintOnly) -> bool can[Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Write, Console.Format]:
            auth: Authorization = try authorization() else err:
                _ = write_stderr("canonical wrapper parity: validation gate is not qualified\n")
                return false
            return false if not pinned_inputs(auth, wave) or not direct_probe_golden(auth)
            root: TemporaryRoot = create_root(auth, wave)
            return false if not root.created
            matched: bool = root.ready and pinned_copies(auth, root, wave) and matrix(auth, root, wave) and pinned_copies(auth, root, wave)
            cleaned: bool = cleanup(root)
            if not cleaned:
                _ = write_stderr(f"canonical wrapper parity: cleanup failed at {root.path}\n")
                return false
            if not matched:
                _ = write_stderr("canonical wrapper parity: setup or expected observation failed\n")
                return false
            return pinned_inputs(auth, wave)


@test
def canonical_lint_public_launcher_matches_probe_and_exec_failure_observations() -> void:
    can Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Write, Console.Format:
        assert EsCanonicalWrappersLauncherParity::public_launcher_parity()
