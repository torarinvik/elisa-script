# Process parity for the colocated ElisaScript entrypoint corresponding to the
# Python scanner adapter. The full scanner corpus remains in
# wasm_export_scan_launcher_test.elisascript; this test also invokes the
# reference-port pathname so its include and CLI wiring are exercised.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsWasmExportScanReferencePortTest:
    private:
        const module Commands:
            PYTHON: sview = "/Users/torarinvikbjarko/.local/share/uv/python/cpython-3.14.7-macos-aarch64-none/bin/python3.14"
            REFERENCE_ADAPTER: sview = "scripts/wasm_export_scan_reference.py"
            REFERENCE_PORT_SCRIPT: sview = "scripts/wasm_export_scan_reference.elisascript"
            CANDIDATE_SCRIPT: sview = "scripts/wasm_export_scan.elisascript"
            COMPONENT_OPTION: sview = "--component"
            BUILD_PAYLOAD_OPTION: sview = "--build-payload"
            FLATTEN_PAYLOAD_OPTION: sview = "--flatten-payload"
            TIMEOUT_STEPS: u64 = 10000
            JSON_OUTPUT_BYTES: u64 = 16777217
            CALLER_PAYLOAD_BYTES: u64 = 67108864


        def run_completed(runner: DifferentialRunner, result: mutable DifferentialRun&) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            catch run_differential_process(runner):
                ok value:
                    result <- value
                    return result.outcome == DifferentialRunOutcome.Completed
                error failure:
                    return false


        def mode_matches(launcher: sview, source_path: sview, option: sview = "", component: bool = false, caller_payload: bool = false) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            resolved_path: Path = try path_real(path(source_path)) else err:
                return false
            resolved_source: sview = f"{resolved_path}"
            reference_arguments: darray[sview] = [resolved_source]
            port_arguments: darray[sview] = [Commands::REFERENCE_PORT_SCRIPT, resolved_source]
            candidate_arguments: darray[sview] = [Commands::CANDIDATE_SCRIPT, resolved_source]
            if component:
                reference_arguments <- [Commands::COMPONENT_OPTION, resolved_source]
                port_arguments <- [Commands::REFERENCE_PORT_SCRIPT, Commands::COMPONENT_OPTION, resolved_source]
                candidate_arguments <- [Commands::CANDIDATE_SCRIPT, Commands::COMPONENT_OPTION, resolved_source]
            elif option != "":
                reference_arguments <- [option, resolved_source]
                port_arguments <- [Commands::REFERENCE_PORT_SCRIPT, option, resolved_source]
                candidate_arguments <- [Commands::CANDIDATE_SCRIPT, option, resolved_source]

            output_limit: u64 = Commands::JSON_OUTPUT_BYTES
            output_limit <- Commands::CALLER_PAYLOAD_BYTES if caller_payload
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.PythonAdapter,
                name: "pinned-python-wasm-export-scan-reference-port-check",
                target: Commands::PYTHON,
                entry: Commands::REFERENCE_ADAPTER,
                arguments: reference_arguments,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: output_limit
            }
            port_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "elisascript-wasm-export-scan-reference-port-check",
                target: launcher,
                arguments: port_arguments,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: output_limit
            }
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "elisascript-wasm-export-scan-candidate-check",
                target: launcher,
                arguments: candidate_arguments,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: output_limit
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            port_run: mutable DifferentialRun = DifferentialRun{observations: []}
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            return false if not run_completed(reference_runner, reference_run)
            return false if not run_completed(port_runner, port_run)
            return false if not run_completed(candidate_runner, candidate_run)
            reference_port: DifferentialComparison = compare_differential_runs(reference_run, port_run)
            reference_candidate: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            port_candidate: DifferentialComparison = compare_differential_runs(port_run, candidate_run)
            return reference_port.equal and reference_candidate.equal and port_candidate.equal


    public:
        def launcher_matches(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            return false if not mode_matches(launcher, "test/fixtures/script_parity/wasm_export_scan/basic.input")
            return false if not mode_matches(launcher, "test/fixtures/script_parity/wasm_export_scan/component_enum.input", component: true)
            return false if not mode_matches(launcher, "test/fixtures/script_parity/wasm_export_scan/include_diamond/main.input", option: Commands::BUILD_PAYLOAD_OPTION, caller_payload: true)
            return mode_matches(launcher, "test/fixtures/script_parity/wasm_export_scan/no_exports.input", option: Commands::FLATTEN_PAYLOAD_OPTION, caller_payload: true)


@test
def wasm_export_scan_reference_port_matches_python_adapter_and_candidate() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, Directory.Read, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
        assert launcher != "" and launcher.startswith("/")
        assert EsWasmExportScanReferencePortTest::launcher_matches(launcher)
