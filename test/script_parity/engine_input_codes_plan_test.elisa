include "../../ports/elisa-engine/scripts/input_codes_plan.elisa"

using EsEngineInputCodesPlan


@test
def plans_compiler_and_sdl_test_argv_as_separate_values() -> void can[Memory.Allocate, Abort.Panic]:
    plan: Plan = EsEngineInputCodesPlan::plan(
        "/projects/elisa engine", "/tmp/input codes", "/toolchain/clang++", "/SDL Headers/include"
    )
    assert plan.executable_path == "/tmp/input codes/input-codes"
    assert plan.compile_command.program == "/toolchain/clang++"
    assert plan.compile_command.arguments.count == 8
    assert plan.compile_command.arguments[0] == "-std=c++17"
    assert plan.compile_command.arguments[1] == "-I"
    assert plan.compile_command.arguments[2] == "/SDL Headers/include"
    assert plan.compile_command.arguments[3] == "-I"
    assert plan.compile_command.arguments[4] == "/projects/elisa engine/native"
    assert plan.compile_command.arguments[5] == "/projects/elisa engine/test/application_gamepad_codes.cpp"
    assert plan.compile_command.arguments[6] == "-o"
    assert plan.compile_command.arguments[7] == "/tmp/input codes/input-codes"


@test
def compilation_and_native_statuses_are_preserved_through_cleanup() -> void can[Memory.Allocate, Abort.Panic]:
    compile_failure: mutable ExecutionState = initial_execution()
    compile_failure <- try execution_after_compile(compile_failure, 23) else compile_failure
    assert compile_failure.phase == ExecutionPhase.Cleanup and compile_failure.exit_status == 23
    compile_failure <- try execution_after_cleanup(compile_failure, true) else compile_failure
    assert compile_failure.phase == ExecutionPhase.Done and compile_failure.exit_status == 23

    native_failure: mutable ExecutionState = initial_execution()
    native_failure <- try execution_after_compile(native_failure, 0) else native_failure
    native_failure <- try execution_after_run(native_failure, 37) else native_failure
    assert native_failure.phase == ExecutionPhase.Cleanup and native_failure.exit_status == 37
    native_failure <- try execution_after_cleanup(native_failure, true) else native_failure
    assert native_failure.phase == ExecutionPhase.Done and native_failure.exit_status == 37


@test
def success_is_reported_only_after_cleanup_and_cleanup_failure_is_nonzero() -> void can[Memory.Allocate, Abort.Panic]:
    state: mutable ExecutionState = initial_execution()
    state <- try execution_after_compile(state, 0) else state
    state <- try execution_after_run(state, 0) else state
    assert state.phase == ExecutionPhase.Cleanup
    state <- try execution_after_cleanup(state, true) else state
    assert state.phase == ExecutionPhase.ReportSuccess
    state <- try execution_after_success_report(state) else state
    assert state.phase == ExecutionPhase.Done and state.exit_status == 0

    cleanup_failure: mutable ExecutionState = initial_execution()
    cleanup_failure <- try execution_after_compile(cleanup_failure, 0) else cleanup_failure
    cleanup_failure <- try execution_after_run(cleanup_failure, 0) else cleanup_failure
    cleanup_failure <- try execution_after_cleanup(cleanup_failure, false) else cleanup_failure
    assert cleanup_failure.phase == ExecutionPhase.Done and cleanup_failure.exit_status == 1
