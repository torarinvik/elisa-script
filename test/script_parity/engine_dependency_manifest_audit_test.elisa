include "../../ports/elisa-engine/scripts/dependency_manifest_audit_posix.elisa"

using EsEngineDependencyManifestAuditPosix


def dependency_manifest_fixture_root() -> Path can[File.Read, Memory.Allocate, Abort.Panic]:
    project_root: Path = Script::source_path().parent().parent().parent()
    return project_root.joinpath("test/fixtures/engine_dependency_manifest/root")


@test
def audits_dependency_manifest_fixture_and_incremental_sha256() -> void can[Directory.Read, Environment.Read, File.Read, Blocking.IO, Process.Run, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
    root: Path = dependency_manifest_fixture_root()
    manifest: Path = root.joinpath("native/dependency-manifest.json")
    status: i64 = EsEngineDependencyManifestAuditPosix::run(["--root", f"{root}", "--manifest", f"{manifest}"])
    assert status == 0i64
