# Dormant public-launcher matrix. No compiler invocation or automatic build.
# Qualification and a real outer process-tree RSS/time guard are prerequisites.
include "../../src/testing/differential.elisa"
include "../../src/testing/checksum_record_model.elisa"
include "skia_environment_cases.elisa"
include "skia_environment_launcher_plan.elisa"

using EsDifferential


module EsSkiaEnvironmentLauncherParity:
    using EsSkiaEnvironmentLauncherPlan

    private:
        const module Tools:
            HASH: sview = "/usr/bin/shasum"
            TIMEOUT_STEPS: u64 = 10000
            OUTPUT_BYTES: u64 = 65536
            ARTIFACT_BYTES: usize = 67108864
            SOURCE_BYTES: usize = 65536
            ORDINARY_CASES: usize = 17


        const module Paths:
            REFERENCE: sview = "reference.py"
            CANDIDATE: sview = "scripts/get_skia_environment_interpreted.elisascript"
            MODEL: sview = "src/runtime/environment_lookup_model.elisa"


        struct SourceCopy:
            identity: Identity
            destination: sview


        struct Root:
            path: Path
            created: bool = false
            ready: bool = false
            files: darray[Path] = []
            file_modes: darray[u64] = []
            directories: darray[Path] = []
            directory_modes: darray[u64] = []
            root_mode: u64 = 0


        def env(name: sview) -> sview can[Environment.Read]:
            return try getenv(name, "") else ""


        def authorization() -> Authorization error[GateError] can[Environment.Read]:
            gate: Gate = Gate{
                reauthorized: env("ELISASCRIPT_VALIDATION_REAUTHORIZED") == "1",
                rss_guard: env("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD") == "active",
                launcher_qualified: env("ELISASCRIPT_SKIA_ENV_LAUNCHER_QUALIFIED") == "1",
                local_compiler: env("ELISA_LOCAL_COMPILER"), core_compiler: env("ELISACORE_BIN"),
                launcher: Identity{path: env("ELISASCRIPT_PUBLIC_LAUNCHER"), hash: env("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256")},
                python: Identity{path: env("ELISASCRIPT_PARITY_PYTHON_BIN"), hash: env("ELISASCRIPT_PARITY_PYTHON_SHA256")},
                compiler_hash: env("ELISASCRIPT_LOCAL_COMPILER_SHA256"),
                source_hash: env("ELISASCRIPT_SKIA_ENV_INTERPRETED_SOURCE_SHA256"),
                model_hash: env("ELISASCRIPT_SKIA_ENV_MODEL_SHA256"),
                budget_hash: env("ELISASCRIPT_SKIA_ENV_BUDGET_SHA256")
            }
            return try authorize(gate)


        def sources() -> darray[SourceCopy] can[Memory.Allocate, Abort.Panic]:
            return [
                SourceCopy{identity: Identity{path: "test/fixtures/script_parity/skia_environment/reference.py", hash: "6233a520babc11883827118a90a532e9de6efab6294ddd038da7bd92c48e7de0"}, destination: Paths::REFERENCE},
                SourceCopy{identity: Identity{path: Paths::CANDIDATE, hash: Pins::SOURCE}, destination: Paths::CANDIDATE},
                SourceCopy{identity: Identity{path: Paths::MODEL, hash: Pins::MODEL}, destination: Paths::MODEL}
            ]


        def pins(auth: Authorization) -> darray[Identity] can[Memory.Allocate, Abort.Panic]:
            # Engine/runner slices are pinned to committed sources, not another
            # agent's dirty edits. Full artifact closure needs separate proof.
            return [
                auth.launcher, auth.python, Identity{path: Pins::COMPILER, hash: auth.compiler_hash},
                Identity{path: Tools::HASH, hash: "0812595f981a26f813d98dc380af14d4af427626c9339eda29eb849ae13de1e3"},
                Identity{path: "src/testing/checksum_record_model.elisa", hash: "1b3cec1235d42076e50b15491d3d6b906f3841ea966937779dc665f1e8a59488"},
                Identity{path: "src/testing/process_poll_budget_model.elisa", hash: "589d2f2fa733610987a91aa0f998374914e1e63f4569a34a994e0d00446c8589"},
                Identity{path: "src/runtime/process_spawn_wait_model.elisa", hash: "66ffe889caa534f1a3a2f163dd6f648ecb7a52cbeab4d3d871951ca3fa1d7d95"},
                Identity{path: "src/runtime/process_pid_model.elisa", hash: "6b1434253ae622a624b7c43d9adc0806bf09e6125196f26bb489e792ca5cd78c"},
                Identity{path: "src/runtime/stdin_read_budget_model.elisa", hash: "0dcd6ff08b4d81eb913ff04efd5fb08059ef47cea0e723cb27af893dfb51aced"},
                Identity{path: "src/runtime/environment_read_budget_model.elisa", hash: Pins::BUDGET},
                Identity{path: "src/ir/interpret.elisa", hash: "fa55d49ea9dbd031870afb44ee8c4189749f5dc55f920e49cda01ea726678f49"},
                Identity{path: "src/ir/lower_ast.elisa", hash: "f63491694feaa8aabe42f4f5b72b68c65e152f4de3189d76f12cb72e29b4480c"},
                Identity{path: "src/ir/ir_verify.elisa", hash: "342b5a1abcc42e7fe7eae08a7fd5b9b5f1658d1631aa85132bcb58698571df23"},
                Identity{path: "src/ir/runtime_model.elisa", hash: "7090a91a731525ea3d9a261722b422a305f99ab21c5e42798c18a66aedb58d6a"},
                Identity{path: "src/bytecode/bytecode.elisa", hash: "a88c563c7c04f4209debf3a4d568a77eac850565e645dd0a4c8ed1321eac2dc7"},
                Identity{path: "src/driver/elisascript.elisa", hash: "1d18ba969d66c0ce8c54a736de48c3a9aa0f0562350a4fa995c46a46889b63b6"},
                Identity{path: "vendor/elisa-compiler/src/semantic/builtin_registry.elisa", hash: "04267a35484aa8a21e3720e72129a28b10d44829609925033befd9ec0a326212"},
                Identity{path: "src/testing/differential.elisa", hash: "4bfce0070db8cdd6bb60fcfad74ff9abfcd5efe1bc009749a3c006048653c25d"},
                Identity{path: "src/testing/differential_world_posix.elisa", hash: "226a4f06799fdd17db49f015783e041f562ca7b1f6fee525d3ed76ab79665c53"},
                Identity{path: "test/script_parity/skia_environment_launcher_plan.elisa", hash: "f48a705b1410537085a99bcc32c2ca6ab5dd837d45d5c38c6e83fd1691e7af44"},
                Identity{path: "test/script_parity/skia_environment_cases.elisa", hash: "c1276a963962d7aba7eb65c39fa4f7fb28309a0ab0b46635aa1b6add29e42c85"},
                Identity{path: "test/fixtures/script_parity/skia_environment/LICENSE", hash: "5f787c1dee3c56547f09ccc2906ab5f5293c4d8dd6c8654e573216c38e908dbd"}
            ]


        def has_hash(identity: Identity) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if not valid_hash(identity.hash) or len(identity.path) == 0 or len(identity.path) > EsChecksumRecord::Limits::FILENAME_BYTES or identity.path == "-"
            for byte in identity.path:
                return false if byte == 0u8
            return false if not is_file(path(identity.path)) or is_symlink(path(identity.path))
            size: usize = try file_size(path(identity.path)) else 0usize
            return false if size == 0 or size > Tools::ARTIFACT_BYTES
            runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "skia-env-launcher-identity", target: Tools::HASH, arguments: ["-a", "256", "-t", "--", identity.path], environment_mode: EsProcess::ProcessEnvironmentMode.Clear, timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES}
            run: DifferentialRun = try run_differential_process(runner) else err:
                return false
            return false if run.outcome != DifferentialRunOutcome.Completed or run.exit_status != 0 or run.stderr != ""
            return try EsChecksumRecord::sha256_text_record_matches(run.stdout, identity.hash, identity.path) else false


        def native_artifact(identity: Identity) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            target: Path = path(identity.path)
            return false if not is_file(target) or is_symlink(target) or not is_executable(target)
            size: usize = try file_size(target) else 0usize
            return false if size < 4 or size > Tools::ARTIFACT_BYTES
            name: mutable darray[u8] = []
            for byte in identity.path |name|:
                name.push(byte)
            name.push(0u8)
            mode: darray[u8] = [114u8,98u8,0u8]
            stream: mutable heap void&? = fopen(&name[0], &mode[0])
            return false if stream == null
            opened: mutable heap void& = stream
            header: mutable darray[u8] = [0u8,0u8,0u8,0u8]
            amount: usize = fread((&header[0]).cast[mutable void&], 1, 4, opened)
            closed: int = fclose(opened)
            return amount == 4 and closed == 0 and native_container_header(header) and not is_symlink(target)


        def pinned(auth: Authorization) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if not native_artifact(auth.launcher) or not native_artifact(auth.python)
            compiler: Identity = Identity{path: Pins::COMPILER, hash: auth.compiler_hash}
            return false if not native_artifact(compiler)
            for identity in pins(auth):
                return false if not has_hash(identity)
            for source in sources():
                size: usize = try file_size(path(source.identity.path)) else 0usize
                return false if size == 0 or size > Tools::SOURCE_BYTES or not has_hash(source.identity)
            return true


        def parents_intact(root: Root, remaining: usize) -> bool can[Memory.Allocate, Abort.Panic, File.Read, Directory.Read]:
            return false if is_symlink(root.path) or not is_directory(root.path) or remaining > root.directories.count
            for index in 0..<remaining:
                directory: Path = root.directories[index]
                return false if is_symlink(directory) or not is_directory(directory)
            return true


        def cleanup(root: Root) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write]:
            return true if not root.created
            cleaned: mutable bool = true
            for index in 0..<root.files.count |root, cleaned|:
                # A replaced parent must never redirect recorded-path cleanup
                # through a symlink into a tree outside the private fixture.
                return false if not parents_intact(root, root.directories.count)
                target: Path = root.files[root.files.count - index - 1]
                if path_exists(target) or is_symlink(target):
                    removed: bool = try remove_path(target) else false
                    cleaned <- removed and cleaned
            for index in 0..<root.directories.count |root, cleaned|:
                return false if not parents_intact(root, root.directories.count - index)
                target: Path = root.directories[root.directories.count - index - 1]
                removed: bool = try remove_directory(target) else false
                cleaned <- removed and cleaned
            return false if not parents_intact(root, 0)
            removed: bool = try remove_directory(root.path) else false
            return removed and cleaned


        def create_root() -> Root can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Write, Console.Format]:
            allocated: Path = try temp_directory("skia env public parity ") else err:
                return Root{path: path(".")}
            canonical: Path = try path_real(allocated) else err:
                return Root{path: allocated, created: true}
            root: mutable Root = Root{path: canonical, created: true}
            root.root_mode <- try file_mode(root.path) else err:
                return root
            for relative in ["scripts", "src", "src/runtime"] |root|:
                target: Path = root.path.joinpath(relative)
                created: bool = try create_directory(target) else false
                return root if not created
                root.directories.push(target)
                mode: u64 = try file_mode(target) else err:
                    return root
                root.directory_modes.push(mode)
            for source in sources() |root|:
                target: Path = root.path.joinpath(source.destination)
                root.files.push(target)
                copied: bool = try copy_path(path(source.identity.path), target) else false
                return root if not copied
                mode: u64 = try file_mode(target) else err:
                    return root
                root.file_modes.push(mode)
            root.ready <- true
            return root


        def entries_are(directory: Path, expected: darray[sview]) -> bool can[Memory.Allocate, Abort.Panic, File.Read, Directory.Read]:
            return false if is_symlink(directory) or not is_directory(directory)
            entries: darray[sview] = try list_directory(directory) else err:
                return false
            return false if entries.count != expected.count
            for entry in entries:
                return false if not (any item in expected where item == entry)
            return true


        def fixture_unchanged(root: Root) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Format]:
            return false if not root.ready or root.files.count != 3 or root.file_modes.count != 3 or root.directories.count != 3 or root.directory_modes.count != 3
            root_mode: u64 = try file_mode(root.path) else 0u64
            return false if root_mode != root.root_mode or not entries_are(root.path, [Paths::REFERENCE, "scripts", "src"])
            return false if not entries_are(root.path.joinpath("scripts"), ["get_skia_environment_interpreted.elisascript"])
            return false if not entries_are(root.path.joinpath("src"), ["runtime"])
            return false if not entries_are(root.path.joinpath("src/runtime"), ["environment_lookup_model.elisa"])
            for index in 0..<root.directories.count:
                mode: u64 = try file_mode(root.directories[index]) else 0u64
                return false if mode != root.directory_modes[index]
            selected: darray[SourceCopy] = sources()
            for index in 0..<selected.count:
                mode: u64 = try file_mode(root.files[index]) else 0u64
                identity: Identity = Identity{path: f"{root.files[index]}", hash: selected[index].identity.hash}
                return false if mode != root.file_modes[index] or not has_hash(identity)
            return true


        def exact(run: DifferentialRun, expected: sview) -> bool:
            return run.outcome == DifferentialRunOutcome.Completed and run.exit_status == 0 and run.stdout == expected and run.stderr == ""


        def case_matches(root: Root, auth: Authorization, selected: EsSkiaEnvironmentCases::Case) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Format]:
            environment: mutable darray[DifferentialEnvironmentEntry] = [DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"}, DifferentialEnvironmentEntry{name: "ELISASCRIPT_PARITY_ENV_UNRELATED", value: "inherited fixture only"}]
            for entry in selected.environment |environment|:
                environment.push(DifferentialEnvironmentEntry{name: entry.name, value: entry.value})
            reference_path: Path = root.path.joinpath(Paths::REFERENCE)
            candidate_path: Path = root.path.joinpath(Paths::CANDIDATE)
            reference_argv: mutable darray[sview] = ["-I", "-S", "-B", "-X", "utf8", f"{reference_path}"]
            reference_argv.extend(selected.arguments)
            candidate_argv: darray[sview] = candidate_arguments(f"{candidate_path}", selected.arguments)
            reference: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "skia-env-python-reference", target: auth.python.path, arguments: reference_argv, working_directory: f"{root.path}", environment: environment, environment_mode: EsProcess::ProcessEnvironmentMode.Replace, stdin_binary: true, stdin_bytes: [0u8,255u8,10u8], timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES}
            candidate: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "skia-env-public-candidate", target: auth.launcher.path, arguments: candidate_argv, working_directory: f"{root.path}", environment: environment, environment_mode: EsProcess::ProcessEnvironmentMode.Replace, stdin_binary: true, stdin_bytes: [0u8,255u8,10u8], timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES}
            reference_run: DifferentialRun = try run_differential_process(reference) else err:
                return false
            return false if not exact(reference_run, selected.stdout) or not fixture_unchanged(root)
            candidate_run: DifferentialRun = try run_differential_process(candidate) else err:
                return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return exact(candidate_run, selected.stdout) and comparison.equal and fixture_unchanged(root)


        def matrix(root: Root, auth: Authorization) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Format]:
            selected_cases: darray[EsSkiaEnvironmentCases::Case] = EsSkiaEnvironmentCases::ordinary()
            return false if selected_cases.count != Tools::ORDINARY_CASES
            for selected in selected_cases:
                return false if not case_matches(root, auth, selected)
            return true

    public:
        def public_launcher_parity() -> bool can[Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Write, Console.Format]:
            # No file/hash/probe launch precedes this public-entry gate.
            auth: Authorization = try authorization() else err:
                _ = write_stderr("skia environment launcher parity: qualification gate disabled or incomplete\n")
                return false
            return false if not pinned(auth)
            root: Root = create_root()
            return false if not root.created
            matched: bool = root.ready and fixture_unchanged(root) and matrix(root, auth)
            inputs_unchanged: bool = pinned(auth)
            cleaned: bool = cleanup(root)
            final_inputs_unchanged: bool = pinned(auth)
            if not cleaned:
                _ = write_stderr(f"skia environment launcher parity: cleanup failed at {root.path}\n")
                return false
            return matched and inputs_unchanged and final_inputs_unchanged


@test
def skia_environment_public_launcher_matches_independent_cases() -> void:
    can Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Write, Console.Format:
        assert EsSkiaEnvironmentLauncherParity::public_launcher_parity()
