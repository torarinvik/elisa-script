# Data-only fixture assertions; no candidate or native runner is imported.
include "canonical_test_cases.elisa"

module EsCanonicalTestCasesFixture:
    private:
        def assert_argv(actual: darray[sview], expected: darray[sview]) -> void:
            assert actual.count == expected.count
            for index in 0..<expected.count:
                assert actual[index] == expected[index]

    public:
        @test
        def canonical_family_fixture_pins_selections_statuses_and_wrapper_identity() -> void:
            can Memory.Allocate, Abort.Panic:
                cases: darray[EsCanonicalLintCases::Case] = EsCanonicalTestCases::ordinary()
                assert cases.count == 10 and cases.count == EsCanonicalTestCases::Fixture::CASES
                statuses: darray[i64] = [0i64, 23i64, 1i64, 2i64, 23i64, 0i64, 0i64, 255i64, 126i64, 127i64]
                for index in 0..<cases.count:
                    item: EsCanonicalLintCases::Case = cases[index]
                    assert item.variable == "PYTHON_BIN" and item.status == statuses[index]
                    campaign: bool = index >= 5 and index <= 7
                    assert item.reference == ("test_campaign.sh" if campaign else "test_canonical.sh")
                    assert item.candidate == ("test_campaign.elisascript" if campaign else "test_canonical.elisascript")
                assert cases[6].selection == EsCanonicalLintCases::Selection.Unset
                assert cases[7].selection == EsCanonicalLintCases::Selection.Empty
                assert cases[8].selection == EsCanonicalLintCases::Selection.LiteralRelative
                assert cases[9].selection == EsCanonicalLintCases::Selection.LiteralPathName


        @test
        def canonical_family_added_cases_preserve_literal_argv_without_mode_reinterpretation() -> void:
            can Memory.Allocate, Abort.Panic:
                cases: darray[EsCanonicalLintCases::Case] = EsCanonicalTestCases::ordinary()
                assert_argv(cases[6].arguments, [])
                assert_argv(cases[6].expected_argv, ["-m", "pytest", "-q", "-m", "campaign"])
                assert_argv(cases[7].arguments, ["", "fast", "line\r\nbreak", "\xc3\xa9"])
                assert_argv(cases[7].expected_argv, ["-m", "pytest", "-q", "-m", "campaign", "", "fast", "line\r\nbreak", "\xc3\xa9"])
                assert_argv(cases[8].arguments, ["all", "", "$HOME; '*.py'", "--", "campaign"])
                assert_argv(cases[8].expected_argv, ["-m", "pytest", "-q", "", "$HOME; '*.py'", "--", "campaign"])
                assert_argv(cases[9].arguments, ["campaign", "-m", "not campaign", "line\nbreak", "\xc3\xa9"])
                assert_argv(cases[9].expected_argv, ["-m", "pytest", "-q", "-m", "campaign", "-m", "not campaign", "line\nbreak", "\xc3\xa9"])
