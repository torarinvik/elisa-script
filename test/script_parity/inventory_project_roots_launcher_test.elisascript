# Exact process parity for the Elisascript root-inventory coordinator.
# This fixture launches only the checked-in scanners over a tiny temporary tree.

include "../../src/testing/differential.elisa"

using EsDifferential


module EsInventoryProjectRootsLauncherParity:
    private:
        const module Commands:
            REFERENCE: sview = "scripts/inventory_project_roots.sh"
            CANDIDATE: sview = "scripts/inventory_project_roots.elisascript"
            CANDIDATE_SCANNER: sview = "scripts/inventory_candidates.elisascript"
            SIGNAL_SCANNER: sview = "scripts/inventory_signals.elisascript"
            REFERENCE_CANDIDATE_SCANNER: sview = "scripts/inventory_candidates.sh"
            REFERENCE_SIGNAL_SCANNER: sview = "scripts/inventory_signals.sh"
            WALKER: sview = "scripts/inventory_walk.elisascript"
            BOUNDED_READER: sview = "src/runtime/bounded_text_posix.elisa"
            REFERENCE_SHA256: sview = "813bce3987f547bbd442fa0aee4e677e07696271087e17f8531eb565bae8b350"
            CANDIDATE_SHA256: sview = "944b158031bbd879023dd90f973b5801dc988573cee452745d404e848ca096d4"
            CANDIDATE_SCANNER_SHA256: sview = "bacda3f4dbda8788d72f8e28fcecfe25cd549a607b291c9f9b15f94b79f77d46"
            SIGNAL_SCANNER_SHA256: sview = "c76f226b1aaf0631ff078207260e70f1b6bc7febc8725fd8a6e5aab6f8a185fa"
            REFERENCE_CANDIDATE_SCANNER_SHA256: sview = "1475ac1e49671819f084875eb3a9384f7a4a72b9a57aabddc20bdb4049d5c57d"
            REFERENCE_SIGNAL_SCANNER_SHA256: sview = "2291b4ed3d0c1457c9475755a2ce71fab33f1651af7a488f9e2c9baa5e19d132"
            WALKER_SHA256: sview = "771ff8e873259daeda6dde77d7e97afafe18317f4eb1d87fa555861415238d8c"
            BOUNDED_READER_SHA256: sview = "f648d319aca3610e245452d681c21556cc58a774982ea8d0bbda2cca4f1823be"
            SHELL: sview = "/bin/sh"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            MAX_SOURCE_BYTES: usize = 67108864
            HASH_OUTPUT_BYTES: u64 = 8192
            PROCESS_OUTPUT_BYTES: u64 = 1048576
            TIMEOUT_STEPS: u64 = 30000


        struct TemporaryDirectory:
            path: Path
            created: bool = false


        def make_temporary_directory() -> TemporaryDirectory can[Memory.Allocate, Abort.Panic, File.Write]:
            created_path: Path = try temp_directory("inventory-project-roots-parity") else err:
                return TemporaryDirectory{path: path("."), created: false}
            return TemporaryDirectory{path: created_path, created: true}


        def write_fixture_text(target: Path, contents: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            written: usize = try write_text(target, contents) else 0u64
            return written == len(contents)


        def remove_fixture_path(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            return try remove_path(target) else false


        def remove_fixture_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try remove_directory(target) else false


        def lowercase_sha256_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def file_has_expected_sha256(file_path: sview, expected_hex: sview, name: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            input_path: Path = path(file_path)
            return false if not is_file(input_path)
            size: usize = try file_size(input_path) else err:
                return false
            return false if size == 0 or size > Commands::MAX_SOURCE_BYTES
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: name,
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", file_path],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::HASH_OUTPUT_BYTES
            }
            result: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(runner):
                ok value:
                    result <- value
                error _:
                    return false
            return false if result.outcome != DifferentialRunOutcome.Completed or result.exit_status != 0 or result.stderr != ""
            return false if result.stdout != expected_hex + "  " + file_path + "\n"
            for index in 0..<64 |expected_hex|:
                return false if not lowercase_sha256_byte(sview_at(expected_hex, index))
            return true


        def pinned_sources_match() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return file_has_expected_sha256(Commands::REFERENCE, Commands::REFERENCE_SHA256, "inventory-roots-reference-sha256") and file_has_expected_sha256(Commands::CANDIDATE, Commands::CANDIDATE_SHA256, "inventory-roots-candidate-sha256") and file_has_expected_sha256(Commands::CANDIDATE_SCANNER, Commands::CANDIDATE_SCANNER_SHA256, "inventory-roots-candidate-scanner-sha256") and file_has_expected_sha256(Commands::SIGNAL_SCANNER, Commands::SIGNAL_SCANNER_SHA256, "inventory-roots-signal-scanner-sha256") and file_has_expected_sha256(Commands::REFERENCE_CANDIDATE_SCANNER, Commands::REFERENCE_CANDIDATE_SCANNER_SHA256, "inventory-roots-reference-candidate-sha256") and file_has_expected_sha256(Commands::REFERENCE_SIGNAL_SCANNER, Commands::REFERENCE_SIGNAL_SCANNER_SHA256, "inventory-roots-reference-signal-sha256") and file_has_expected_sha256(Commands::WALKER, Commands::WALKER_SHA256, "inventory-roots-walker-sha256") and file_has_expected_sha256(Commands::BOUNDED_READER, Commands::BOUNDED_READER_SHA256, "inventory-roots-bounded-reader-sha256")


        def process_parity_case(launcher: sview, coding_root: sview, manifest: sview, expected_status: i64, expected_stdout: sview, expected_stderr: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference: Path = try path_real(path(Commands::REFERENCE)) else err:
                return false
            candidate: Path = try path_real(path(Commands::CANDIDATE)) else err:
                return false
            launcher_directory: Path = path(launcher).parent()
            controlled_path: sview = f"{launcher_directory}" + ":/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: controlled_path},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "shell-inventory-project-roots-reference",
                target: Commands::SHELL,
                arguments: [f"{reference}", coding_root, manifest],
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::PROCESS_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error _:
                    return false
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "elisascript-inventory-project-roots-candidate",
                target: launcher,
                arguments: [f"{candidate}", coding_root, manifest],
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::PROCESS_OUTPUT_BYTES
            }
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error _:
                    return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return comparison.equal and reference_run.exit_status == expected_status and candidate_run.exit_status == expected_status and reference_run.stdout == expected_stdout and candidate_run.stdout == expected_stdout and reference_run.stderr == expected_stderr and candidate_run.stderr == expected_stderr


        def fixture_cases_match(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary: TemporaryDirectory = make_temporary_directory()
            return false if not temporary.created
            coding_root: Path = temporary.path.joinpath("coding-projects")
            project_root: Path = coding_root.joinpath("project-a")
            build_directory: Path = project_root.joinpath("build")
            script_file: Path = build_directory.joinpath("tool.sh")
            manifest_file: Path = temporary.path.joinpath("roots.tsv")
            setup_ok: bool = try create_directory(coding_root) else false
            setup_ok <- (try create_directory(project_root) else false) and setup_ok
            setup_ok <- (try create_directory(build_directory) else false) and setup_ok
            setup_ok <- write_fixture_text(script_file, "echo ok\n") and setup_ok
            root_text: sview = f"{coding_root}"
            manifest_text: sview = f"{manifest_file}"
            valid_manifest: sview = "# name\trelative_path\towner\treview_status\nalpha\tproject-a\tteam-a\treviewed\n"
            setup_ok <- write_fixture_text(manifest_file, valid_manifest) and setup_ok
            physical_root: Path = try path_real(coding_root) else err:
                _ = remove_fixture_path(script_file)
                _ = remove_fixture_path(manifest_file)
                _ = remove_fixture_directory(build_directory)
                _ = remove_fixture_directory(project_root)
                _ = remove_fixture_directory(coding_root)
                _ = remove_fixture_directory(temporary.path)
                return false
            physical_file: Path = try path_real(script_file) else err:
                _ = remove_fixture_path(script_file)
                _ = remove_fixture_path(manifest_file)
                _ = remove_fixture_directory(build_directory)
                _ = remove_fixture_directory(project_root)
                _ = remove_fixture_directory(coding_root)
                _ = remove_fixture_directory(temporary.path)
                return false
            valid_output: sview = "root_name\troot_path\tpath\tkind\towner\tentrypoint\tdisposition\trisk\tnotes\n" + "alpha\t" + f"{physical_root}" + "\t" + f"{physical_file}" + "\tshell\tteam-a\tunknown\tclassify-generated\tbuild\tmanifest=reviewed; scanner_owner=unassigned; read-only candidate; classify before porting or deletion\n"
            valid_ok: bool = setup_ok and process_parity_case(launcher, root_text, manifest_text, 0i64, valid_output, "")

            unterminated_manifest: sview = "# name\trelative_path\towner\treview_status\nmissing\tmissing-root\tteam-a\tpending"
            unterminated_written: bool = write_fixture_text(manifest_file, unterminated_manifest)
            unterminated_ok: bool = unterminated_written and process_parity_case(launcher, root_text, manifest_text, 0i64, "root_name\troot_path\tpath\tkind\towner\tentrypoint\tdisposition\trisk\tnotes\n", "")

            substring_path_manifest: sview = "# name\trelative_path\towner\treview_status\nalpha\tproject..a\tteam-a\tpending\n"
            substring_path_written: bool = write_fixture_text(manifest_file, substring_path_manifest)
            substring_path_ok: bool = substring_path_written and process_parity_case(launcher, root_text, manifest_text, 3i64, "root_name\troot_path\tpath\tkind\towner\tentrypoint\tdisposition\trisk\tnotes\n", "inventory_project_roots: unsafe relative path on row 2\n")

            malformed_written: bool = write_fixture_text(manifest_file, "not-a-header\n")
            malformed_ok: bool = malformed_written and process_parity_case(launcher, root_text, manifest_text, 3i64, "", "inventory_project_roots: malformed, duplicated, unsafe, or unowned reviewed manifest row\n")
            _ = remove_fixture_path(script_file)
            _ = remove_fixture_path(manifest_file)
            _ = remove_fixture_directory(build_directory)
            _ = remove_fixture_directory(project_root)
            _ = remove_fixture_directory(coding_root)
            cleanup_ok: bool = remove_fixture_directory(temporary.path)
            return valid_ok and unterminated_ok and substring_path_ok and malformed_ok and cleanup_ok


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def run_cases(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            return fixture_cases_match(launcher)


        def sources_match() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return pinned_sources_match()


        def launcher_matches(launcher: sview, expected_hash: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return file_has_expected_sha256(launcher, expected_hash, "inventory-roots-public-launcher-sha256")


@test
def inventory_project_roots_public_launcher_matches_shell_reference() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsInventoryProjectRootsLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsInventoryProjectRootsLauncherParity::pinned_compiler_path()
        assert launcher != "" and launcher.startswith("/")
        assert EsInventoryProjectRootsLauncherParity::launcher_matches(launcher, launcher_hash)
        assert EsInventoryProjectRootsLauncherParity::sources_match()
        assert EsInventoryProjectRootsLauncherParity::run_cases(launcher)
        assert EsInventoryProjectRootsLauncherParity::sources_match()
