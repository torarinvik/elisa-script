# Independent literal oracle. No candidate renderer or lookup code is imported.
module EsSkiaEnvironmentCases:
    public:
        struct Entry:
            name: sview
            value: sview


        struct Case:
            name: sview
            arguments: darray[sview]
            environment: darray[Entry] = []
            stdout: sview


        def ordinary() -> darray[Case] can[Memory.Allocate, Abort.Panic]:
            return [
                Case{name: "absent", arguments: ["ELISASCRIPT_PARITY_ENV_VALUE"], stdout: "None\n"},
                Case{name: "empty", arguments: ["ELISASCRIPT_PARITY_ENV_VALUE"], environment: [Entry{name: "ELISASCRIPT_PARITY_ENV_VALUE", value: ""}], stdout: "\n"},
                Case{name: "literal-none", arguments: ["ELISASCRIPT_PARITY_ENV_VALUE"], environment: [Entry{name: "ELISASCRIPT_PARITY_ENV_VALUE", value: "None"}], stdout: "None\n"},
                Case{name: "literal-metacharacters", arguments: ["ELISASCRIPT_PARITY_ENV_VALUE"], environment: [Entry{name: "ELISASCRIPT_PARITY_ENV_VALUE", value: "  $HOME * ; \\n  "}], stdout: "  $HOME * ; \\n  \n"},
                Case{name: "line-endings", arguments: ["ELISASCRIPT_PARITY_ENV_VALUE"], environment: [Entry{name: "ELISASCRIPT_PARITY_ENV_VALUE", value: "a\r\nb\n"}], stdout: "a\r\nb\n\n"},
                Case{name: "utf8", arguments: ["ELISASCRIPT_PARITY_ENV_VALUE"], environment: [Entry{name: "ELISASCRIPT_PARITY_ENV_VALUE", value: "\xc3\xa9 \xe2\x98\x83"}], stdout: "\xc3\xa9 \xe2\x98\x83\n"},
                Case{name: "case-sensitive", arguments: ["elisascript_parity_env_value"], environment: [Entry{name: "ELISASCRIPT_PARITY_ENV_VALUE", value: "not selected"}], stdout: "None\n"},
                Case{name: "empty-key", arguments: [""], environment: [Entry{name: "ELISASCRIPT_PARITY_ENV_VALUE", value: "not selected"}], stdout: "None\n"},
                Case{name: "equals-key", arguments: ["ELISASCRIPT_PARITY_ENV_VALUE=tail"], environment: [Entry{name: "ELISASCRIPT_PARITY_ENV_VALUE", value: "not selected"}], stdout: "None\n"},
                Case{name: "extra-arguments", arguments: ["ELISASCRIPT_PARITY_ENV_VALUE", "", "ELISASCRIPT_PARITY_ENV_OTHER"], environment: [Entry{name: "ELISASCRIPT_PARITY_ENV_VALUE", value: "first"}, Entry{name: "ELISASCRIPT_PARITY_ENV_OTHER", value: "second"}], stdout: "first\n"},
                Case{name: "utf8-key", arguments: ["ELISASCRIPT_PARITY_ENV_\xc3\xa9"], environment: [Entry{name: "ELISASCRIPT_PARITY_ENV_\xc3\xa9", value: "unicode key"}], stdout: "unicode key\n"},
                Case{name: "punctuation-key", arguments: ["ELISASCRIPT PARITY-$HOME;*"], environment: [Entry{name: "ELISASCRIPT PARITY-$HOME;*", value: "literal key"}], stdout: "literal key\n"},
                Case{name: "digit-key", arguments: ["9ELISASCRIPT_PARITY_ENV"], environment: [Entry{name: "9ELISASCRIPT_PARITY_ENV", value: "not a shell identifier"}], stdout: "not a shell identifier\n"},
                long_value_case()
            ]

    private:
        const module FixtureLimits:
            # Fits below both the host argument/environment admission budget
            # and the matrix's 64 KiB combined capture budget. Not a test of the
            # candidate's 1 MiB boundary or the host's platform-specific ceiling.
            LONG_VALUE_BYTES: usize = 32768


        def long_value_case() -> Case can[Memory.Allocate, Abort.Panic]:
            value: mutable darray[u8] = []
            for index in 0..<FixtureLimits::LONG_VALUE_BYTES |value|:
                value.push((65 + index % 26).u8())
            # Build the expected packet independently of candidate rendering.
            expected: mutable darray[u8] = []
            for index in 0..<FixtureLimits::LONG_VALUE_BYTES |expected|:
                expected.push((65 + index % 26).u8())
            expected.push(10u8)
            return Case{name: "long-patterned-value", arguments: ["ELISASCRIPT_PARITY_ENV_VALUE"], environment: [Entry{name: "ELISASCRIPT_PARITY_ENV_VALUE", value: bytes_view(value)}], stdout: bytes_view(expected)}
