# Focused generator semantics using a private temporary language directory.
# This test does not launch a compiler, Python, or any external process.
include "../../scripts/generate_chordbrain_localization.elisascript"

using EsChordBrainLocalizationGenerator


module EsChordBrainLocalizationModelTests:
    private:
        def write_language(directory: Path, code: sview, contents: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            destination: Path = directory.joinpath(code + ".lang")
            written: usize = try write_text(destination, contents) else 0u64
            return written == len(contents)


    public:
        def merge_semantics_match_python() -> bool can[Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write]:
            languages: Path = try temp_directory("chordbrain-localization-model") else err:
                return false
            fixture_written: bool = write_language(languages, "en", "\"duplicate\" = \"first\"\n\"english_only\" = \"English\"\n\"shared\" = \"English shared\"\n\"duplicate\" = \"last\"\n\"escaped\" = \"line\\n with \\\"quoted\\\" and \\xE9 and \\\\slash\"\n\"extended_escapes\" = \"\\141-\\u00E9-\\U0001F600-\\q\"\n\"\" = \"ignored \"quoted\" empty key\"\n\"unfinished = not an entry")
            fixture_written <- write_language(languages, "de", "\"german_only\" = \"Deutsch\"\n\"shared\" = \"Deutsch shared\"\n\"overlap\" = \"Deutsch overlap\"") and fixture_written
            fixture_written <- write_language(languages, "es", "\"spanish_only\" = \"Español\"\n\"overlap\" = \"Español overlap\"") and fixture_written
            fixture_written <- write_language(languages, "fr", "") and fixture_written
            fixture_written <- write_language(languages, "it", "") and fixture_written
            fixture_written <- write_language(languages, "pt", "") and fixture_written

            generated: mutable sview = ""
            generated_ok: mutable bool = false
            catch EsChordBrainLocalizationGenerator::generate(languages):
                ok value:
                    generated <- value
                    generated_ok <- true
                error failure:
                    generated_ok <- false

            removed: bool = try remove_tree(languages) else false
            return false if not fixture_written or not generated_ok or not removed

            english_parts: darray[sview] = split(generated, "def chordbrain_translate_de")
            return false if english_parts.count != 2
            english_section: sview = english_parts[0]
            return false if english_section.index("\"first\" return if cstr_equal(key, \"duplicate\")") >= 0
            return false if english_section.index("\"last\" return if cstr_equal(key, \"duplicate\")") < 0
            return false if english_section.index("ignored") >= 0
            return false if english_section.index("\"English\" return if cstr_equal(key, \"english_only\")") < 0
            return false if english_section.index("\"line\\\\n with \\\"quoted\\\" and é and \\\\slash\" return if cstr_equal(key, \"escaped\")") < 0
            return false if english_section.index("\"a-é-😀-\\\\q\" return if cstr_equal(key, \"extended_escapes\")") < 0
            return false if english_section.index("german_only") >= 0 or english_section.index("spanish_only") >= 0
            return false if english_section.index("\"last\" return if cstr_equal(key, \"duplicate\")") > english_section.index("\"English\" return if cstr_equal(key, \"english_only\")")

            german_parts: darray[sview] = split(english_parts[1], "def chordbrain_translate_es")
            return false if german_parts.count != 2
            german_section: sview = german_parts[0]
            return false if german_section.index("\"last\" return if cstr_equal(key, \"duplicate\")") < 0
            return false if german_section.index("\"English\" return if cstr_equal(key, \"english_only\")") < 0
            return false if german_section.index("\"Deutsch shared\" return if cstr_equal(key, \"shared\")") < 0
            return false if german_section.index("\"Deutsch\" return if cstr_equal(key, \"german_only\")") < 0
            german_overlap: darray[sview] = split(german_section, "\"Deutsch overlap\" return if cstr_equal(key, \"overlap\")")
            return false if german_overlap.count != 3
            return false if german_section.index("spanish_only") >= 0

            spanish_parts: darray[sview] = split(german_parts[1], "def chordbrain_translate_fr")
            return false if spanish_parts.count != 2
            spanish_section: sview = spanish_parts[0]
            return false if spanish_section.index("\"English shared\" return if cstr_equal(key, \"shared\")") < 0
            return false if spanish_section.index("\"Español\" return if cstr_equal(key, \"spanish_only\")") < 0
            spanish_overlap: darray[sview] = split(spanish_section, "\"Español overlap\" return if cstr_equal(key, \"overlap\")")
            return false if spanish_overlap.count != 3
            return true


@test
def chordbrain_localization_generator_preserves_python_merge_semantics() -> void:
    can Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write:
        assert EsChordBrainLocalizationModelTests::merge_semantics_match_python()
