# Process parity for the real mixed AWK/rg migration-inventory audit.
# Source-only under the active compiler hold. Run only after explicit
# reauthorization through the approved RSS-supervised bounded test wrapper.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsMigrationInventoryLauncherParity:
    private:
        const module Commands:
            REFERENCE_SCRIPT: sview = "scripts/check_migration_inventory.sh"
            CANDIDATE_SCRIPT: sview = "scripts/check_migration_inventory.elisascript"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            REFERENCE_SHA256: sview = "f1af764518e994e0d894d111e49951b33263aa8ec42cc47c7124b557ab7025d1"
            CANDIDATE_SHA256: sview = "22dfcbbf653f9683817e9ae013bdba2509afefde220544d0963f4fd8a1ec450c"
            MAX_HASHED_BYTES: usize = 8388608
            HASH_OUTPUT_BYTES: u64 = 8192
            PROCESS_OUTPUT_BYTES: u64 = 65536
            TIMEOUT_STEPS: u64 = 10000


        def file_has_expected_sha256(file_path: sview, expected_hex: sview, process_name: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            input_path: Path = path(file_path)
            return false if not is_file(input_path)
            input_size: usize = try file_size(input_path) else err:
                return false
            return false if input_size == 0 or input_size > Commands::MAX_HASHED_BYTES

            hash_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: process_name,
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", file_path],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(hash_runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false
            return hash_run.outcome == DifferentialRunOutcome.Completed and hash_run.exit_status == 0 and hash_run.stderr == "" and hash_run.stdout == expected_hex + "  " + file_path + "\n"


        def pinned_sources_match_internal() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast]:
            input_paths: darray[sview] = [
                "docs/migration-project-roots.tsv",
                "docs/migration-inventory-schema.md",
                "docs/migration-review-current.tsv",
                "scripts/inventory_project_roots.sh",
                "scripts/check_migration_review.sh",
                "scripts/check_migration_roots.sh",
                "scripts/inventory_candidates.sh",
                "scripts/inventory_signals.sh",
                "scripts/inventory_walk.elisascript",
                "test/script_parity/inventory_walk_test.elisascript",
                "scripts/inventory_candidates.elisascript",
                "scripts/inventory_signals.elisascript",
                "test/fixtures/script_parity/inventory_candidates/EXPECTATIONS.md"
            ]
            input_hashes: darray[sview] = [
                "4bd038be6ae77fd09a9c695a70bee64de9b6c7878c4e778377819f3c445113c1",
                "23a7c03f02f20f0559a4d3720c09b4d7b6e7d1a221bfc3973fb591f271bf931b",
                "6012a1fb2f4ce7b415104bd85d5b1ec4a09ddf03f2deb96bff5c9e051c575fa0",
                "813bce3987f547bbd442fa0aee4e677e07696271087e17f8531eb565bae8b350",
                "82ff48ec9f4b861e0cdd2ffe02875e622452231ae600b1fdcd874b7b1b7f55eb",
                "92c037680f730bfe96e9ea16bbbd6764e95c0cab27f6d8ce992391e910c3f492",
                "1475ac1e49671819f084875eb3a9384f7a4a72b9a57aabddc20bdb4049d5c57d",
                "2291b4ed3d0c1457c9475755a2ce71fab33f1651af7a488f9e2c9baa5e19d132",
                "771ff8e873259daeda6dde77d7e97afafe18317f4eb1d87fa555861415238d8c",
                "f7e0da550cc45cd674713274ad9d476a1240c80dd1629b6d972e26841ecdf3d7",
                "216dd2b01401019bcea4707e9e3b25a642d2d2009a7dbd5964a6aac3bdf0a25d",
                "4a5869116ba8503e5b2468f57df0363ea054a86318adb66a5bb388a2090c8748",
                "de5637bee8421716ac32c81682fe85635b26d4b876c7747bce050bd04e61fcdb"
            ]
            source_directory: Path = try path_real(Script::source_path().parent()) else err:
                return false
            repository_root: Path = source_directory.parent().parent()
            reference: Path = try path_real(repository_root.joinpath(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate: Path = try path_real(repository_root.joinpath(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            return false if not file_has_expected_sha256(f"{reference}", Commands::REFERENCE_SHA256, "migration-inventory-reference-sha256")
            return false if not file_has_expected_sha256(f"{candidate}", Commands::CANDIDATE_SHA256, "migration-inventory-candidate-sha256")
            return false if input_paths.count != input_hashes.count
            for index in 0..<input_paths.count |input_paths, input_hashes|:
                input: Path = try path_real(repository_root.joinpath(input_paths[index])) else err:
                    return false
                return false if not file_has_expected_sha256(f"{input}", input_hashes[index], "migration-inventory-input-sha256")
            return true


        def launcher_digest_matches_internal(launcher: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return file_has_expected_sha256(launcher, expected_hex, "migration-inventory-launcher-sha256")


        def process_parity(launcher: sview, extra_argument: sview = "") -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            source_directory: Path = try path_real(Script::source_path().parent()) else err:
                return false
            repository_root: Path = source_directory.parent().parent()
            reference: Path = try path_real(repository_root.joinpath(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate: Path = try path_real(repository_root.joinpath(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_arguments: mutable darray[sview] = [f"{reference}"]
            candidate_arguments: mutable darray[sview] = [f"{candidate}"]
            if extra_argument != "":
                reference_arguments.push(extra_argument)
                candidate_arguments.push(extra_argument)

            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "awk-rg-migration-inventory-reference",
                target: "/bin/bash",
                arguments: reference_arguments,
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::PROCESS_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    print("migration inventory shell reference process failed")
                    return false

            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "elisascript-migration-inventory-candidate",
                target: launcher,
                arguments: candidate_arguments,
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::PROCESS_OUTPUT_BYTES
            }
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    print("migration inventory Elisascript candidate process failed")
                    return false

            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            expected_output: sview = "migration inventory audit: partition manifest and bounded read-only scanners present\n"
            return comparison.equal and reference_run.outcome == DifferentialRunOutcome.Completed and candidate_run.outcome == DifferentialRunOutcome.Completed and reference_run.exit_status == 0 and candidate_run.exit_status == 0 and reference_run.stdout == expected_output and candidate_run.stdout == expected_output and reference_run.stderr == "" and candidate_run.stderr == ""


    public:
        def pinned_sources_match() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast]:
            return pinned_sources_match_internal()


        def launcher_digest_matches(launcher: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return launcher_digest_matches_internal(launcher, expected_hex)


        def run_positive_case(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            return false if not process_parity(launcher)
            return process_parity(launcher, "ignored positional argument")


        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


@test
def migration_inventory_public_launcher_matches_shell_reference() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, Directory.Read, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsMigrationInventoryLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsMigrationInventoryLauncherParity::pinned_compiler_path()
        assert launcher != "" and launcher.startswith("/")
        assert EsMigrationInventoryLauncherParity::pinned_sources_match()
        assert EsMigrationInventoryLauncherParity::launcher_digest_matches(launcher, launcher_hash)
        print("public_launcher_path=" + launcher)
        print("public_launcher_sha256=" + launcher_hash)
        assert EsMigrationInventoryLauncherParity::run_positive_case(launcher)
        assert EsMigrationInventoryLauncherParity::pinned_sources_match()
        assert EsMigrationInventoryLauncherParity::launcher_digest_matches(launcher, launcher_hash)
