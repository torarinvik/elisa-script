# Process-level parity for the real AWK-backed migration-review audit.
# Run only through the bounded validation wrapper after explicit
# reauthorization; this source is intentionally not run during the hold.
include "../../src/testing/differential.elisa"

using EsDifferential


module EsMigrationReviewLauncherParity:
    private:
        const module Commands:
            REFERENCE_SCRIPT: sview = "scripts/check_migration_review.sh"
            CANDIDATE_SCRIPT: sview = "scripts/check_migration_review.elisascript"
            BOUNDED_READER: sview = "src/runtime/bounded_text_posix.elisa"
            MANIFEST: sview = "docs/migration-review-current.tsv"
            SHELL: sview = "/bin/bash"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            REFERENCE_SHA256: sview = "065d34d6bd14e59466878462dd100ade70af4f8a2da9617ec143f2ecbf678e14"
            CANDIDATE_SHA256: sview = "624eb57bc007a6c13c808c909adaea41bd279b05374a61b1fa3d75e053400907"
            BOUNDED_READER_SHA256: sview = "f648d319aca3610e245452d681c21556cc58a774982ea8d0bbda2cca4f1823be"
            MANIFEST_SHA256: sview = "6012a1fb2f4ce7b415104bd85d5b1ec4a09ddf03f2deb96bff5c9e051c575fa0"
            MAX_HASHED_FILE_BYTES: usize = 67108864
            HASH_OUTPUT_BYTES: u64 = 8192
            PROCESS_OUTPUT_BYTES: u64 = 65536
            TIMEOUT_STEPS: u64 = 10000


        struct TemporaryDirectory:
            path: Path
            created: bool = false


        def make_temporary_directory() -> TemporaryDirectory can[Memory.Allocate, Abort.Panic, File.Write]:
            created_path: Path = try temp_directory("migration-review-parity") else err:
                return TemporaryDirectory{path: path("."), created: false}
            return TemporaryDirectory{path: created_path, created: true}


        def write_fixture_bytes(target: Path, contents: darray[u8]) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            written: usize = try write_bytes(target, contents) else 0u64
            return written == contents.count


        def remove_fixture_path(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            return try remove_path(target) else false


        def remove_fixture_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try remove_directory(target) else false


        def append_exact_padding(target: mutable darray[u8]&, size: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if target.count > size
            while target.count < size |target, size|:
                target.push(35u8)
            return true


        def append_text_bytes(target: mutable darray[u8]&, text: sview) -> void can[Memory.Allocate, Abort.Panic]:
            for byte in text |target|:
                target.push(byte)


        def file_has_expected_sha256(file_path: sview, expected_hex: sview, process_name: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            input_path: Path = path(file_path)
            return false if not is_file(input_path)
            input_size: usize = try file_size(input_path) else err:
                return false
            return false if input_size == 0 or input_size > Commands::MAX_HASHED_FILE_BYTES

            hash_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: process_name,
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", file_path],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(hash_runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false

            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            return false if hash_run.stdout != expected_hex + "  " + file_path + "\n"
            return true


        def all_pinned_sources_match() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            bounded_reader: Path = try path_real(path(Commands::BOUNDED_READER)) else err:
                return false
            manifest: Path = try path_real(path(Commands::MANIFEST)) else err:
                return false
            return false if not file_has_expected_sha256(f"{reference}", Commands::REFERENCE_SHA256, "migration-review-reference-sha256")
            return false if not file_has_expected_sha256(f"{candidate}", Commands::CANDIDATE_SHA256, "migration-review-candidate-sha256")
            return false if not file_has_expected_sha256(f"{bounded_reader}", Commands::BOUNDED_READER_SHA256, "migration-review-bounded-reader-sha256")
            return file_has_expected_sha256(f"{manifest}", Commands::MANIFEST_SHA256, "migration-review-manifest-sha256")


        def launcher_hash_matches(launcher: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return file_has_expected_sha256(launcher, expected_hex, "migration-review-launcher-sha256")


        def process_parity(launcher: sview, manifest_path: sview, expected_status: i64, expected_stdout: sview, expected_stderr: sview, extra_operand: bool = false) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            manifest: Path = try path_real(path(manifest_path)) else err:
                path(manifest_path)
            reference_text: sview = f"{reference}"
            candidate_text: sview = f"{candidate}"
            manifest_text: sview = f"{manifest}"
            reference_arguments: mutable darray[sview] = [reference_text, manifest_text]
            candidate_arguments: mutable darray[sview] = [candidate_text, manifest_text]
            if extra_operand:
                reference_arguments.push("unexpected")
                candidate_arguments.push("unexpected")
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "awk-migration-review-reference",
                target: Commands::SHELL,
                arguments: reference_arguments,
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::PROCESS_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    print("migration review AWK reference process failed")
                    return false

            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "elisascript-migration-review-candidate",
                target: launcher,
                arguments: candidate_arguments,
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::PROCESS_OUTPUT_BYTES
            }
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    print("migration review Elisascript process failed")
                    return false

            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return comparison.equal and reference_run.exit_status == expected_status and candidate_run.exit_status == expected_status and reference_run.stdout == expected_stdout and candidate_run.stdout == expected_stdout and reference_run.stderr == expected_stderr and candidate_run.stderr == expected_stderr


        def all_process_cases_match(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            positive_output: sview = "migration review audit: 21 current candidates have reviewed ownership, disposition, and acceptance metadata\n"
            return false if not process_parity(launcher, Commands::MANIFEST, 0, positive_output, "")
            return false if not process_parity(launcher, "", 0, positive_output, "")
            return false if not process_parity(launcher, Commands::MANIFEST, 2, "", "usage: check_migration_review.sh [MANIFEST]\n", true)
            temporary: TemporaryDirectory = make_temporary_directory()
            return false if not temporary.created
            oversized_path: Path = temporary.path.joinpath("oversized.tsv")
            missing_path: Path = temporary.path.joinpath("missing.tsv")
            missing_text: sview = f"{missing_path}"
            missing_output: sview = "migration review audit: missing " + missing_text + "\n"
            missing_parity_ok: bool = process_parity(launcher, missing_text, 1, "", missing_output)

            oversized_bytes: mutable darray[u8] = []
            size_ok: bool = append_exact_padding(oversized_bytes, 1048577u64)
            write_ok: bool = size_ok and write_fixture_bytes(oversized_path, oversized_bytes)
            oversized_text: sview = f"{oversized_path}"
            oversized_output: sview = "migration review audit: manifest exceeds audit limit\n"
            parity_ok: bool = write_ok and process_parity(launcher, oversized_text, 1, "", oversized_output)

            malformed_bytes: mutable darray[u8] = []
            append_text_bytes(malformed_bytes, "not-the-required-header\n")
            malformed_write_ok: bool = write_fixture_bytes(oversized_path, malformed_bytes)
            malformed_output: sview = "migration review audit: invalid manifest header\n"
            malformed_parity_ok: bool = malformed_write_ok and process_parity(launcher, oversized_text, 1, "", malformed_output)

            spaced_header_bytes: mutable darray[u8] = []
            append_text_bytes(spaced_header_bytes, "path kind owner review_status entrypoint disposition risk notes\n")
            spaced_header_write_ok: bool = write_fixture_bytes(oversized_path, spaced_header_bytes)
            spaced_header_parity_ok: bool = spaced_header_write_ok and process_parity(launcher, oversized_text, 1, "", malformed_output)

            late_header_bytes: mutable darray[u8] = []
            append_text_bytes(late_header_bytes, "not-header\npath\tkind\towner\treview_status\tentrypoint\tdisposition\trisk\tnotes\n")
            late_header_write_ok: bool = write_fixture_bytes(oversized_path, late_header_bytes)
            late_header_parity_ok: bool = late_header_write_ok and process_parity(launcher, oversized_text, 1, "", malformed_output)
            _ = remove_fixture_path(oversized_path)
            cleanup_ok: bool = remove_fixture_directory(temporary.path)
            return missing_parity_ok and parity_ok and malformed_parity_ok and spaced_header_parity_ok and late_header_parity_ok and cleanup_ok


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def run_all_cases(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            return all_process_cases_match(launcher)


        def pinned_sources_match() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast]:
            return all_pinned_sources_match()


        def launcher_digest_matches(launcher: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return launcher_hash_matches(launcher, expected_hex)


@test
def migration_review_public_launcher_matches_awk_reference() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsMigrationReviewLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsMigrationReviewLauncherParity::pinned_compiler_path()
        assert launcher != "" and launcher.startswith("/")
        assert EsMigrationReviewLauncherParity::launcher_digest_matches(launcher, launcher_hash)
        assert EsMigrationReviewLauncherParity::pinned_sources_match()
        print("public_launcher_path=" + launcher)
        print("public_launcher_sha256=" + launcher_hash)
        assert EsMigrationReviewLauncherParity::run_all_cases(launcher)
        assert EsMigrationReviewLauncherParity::pinned_sources_match()
        assert EsMigrationReviewLauncherParity::launcher_digest_matches(launcher, launcher_hash)
