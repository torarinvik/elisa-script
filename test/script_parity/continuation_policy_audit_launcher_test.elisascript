# Gated public-launcher parity smoke for the continuation-policy source audit.
# Run only through scripts/run_bounded_test.sh after explicit reauthorization.
# Every audit invocation uses an isolated temporary repository fixture.
include "../../src/testing/differential.elisa"
include "../../src/runtime/bounded_text_posix.elisa"

using EsDifferential
using EsBoundedText


module EsContinuationPolicyAuditLauncherParity:
    private:
        const module Commands:
            REFERENCE_SHELL: sview = "/bin/bash"
            REFERENCE_SCRIPT: sview = "scripts/check_continuation_policy.sh"
            CANDIDATE_SCRIPT: sview = "scripts/check_continuation_policy.elisascript"
            BOUNDED_READER: sview = "src/runtime/bounded_text_posix.elisa"
            ENCODING: sview = "src/runtime/encoding.elisa"
            FILE_RUNTIME: sview = "src/runtime/file_posix.elisa"
            DIRECTORY_RUNTIME: sview = "src/runtime/directory_posix.elisa"
            STDIO_RUNTIME: sview = "src/runtime/stdio_posix.elisa"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            RG_TOOL: sview = "/opt/homebrew/bin/rg"
            CONTROLLED_PATH: sview = "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            REFERENCE_SHA256: sview = "9b7fc526daa6099bac14c497434144c96896ba3d3fe915b8b7e8d2044b103b53"
            CANDIDATE_SHA256: sview = "e8b452786d8c67bb91904e66aa8c485c0e24e840708627c9ec05b7de6da050b9"
            BOUNDED_READER_SHA256: sview = "f648d319aca3610e245452d681c21556cc58a774982ea8d0bbda2cca4f1823be"
            ENCODING_SHA256: sview = "67815c728730d891c2e5fc0cc53a33d672d0f40003cfd468de903c4fbfcd9a53"
            FILE_RUNTIME_SHA256: sview = "14e1e3a9f0d95ee3e45509bd7d76c1ba2694992d5530f82edf8533d9cf149643"
            DIRECTORY_RUNTIME_SHA256: sview = "065d21370e93a1487a5ccc0adcfff5dcc04aa78e98361de181eeb08dbc0d402d"
            STDIO_RUNTIME_SHA256: sview = "c02cac5eec931a2f2aa9131616482df4e17333948961c4b6d0d215b0ab0e766c"
            RG_TOOL_SHA256: sview = "1c57905960cd69dbb5b05492560957f4a57cdd4d39137e20de23981c6e1f4423"
            MAX_PINNED_FILE_BYTES: usize = 16777216
            MAX_COPIED_FILE_BYTES: usize = 1048576
            MAX_COPIED_TOTAL_BYTES: usize = 2097152
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_PROCESS_OUTPUT_BYTES: u64 = 1048576
            TIMEOUT_STEPS: u64 = 10000


        const module Fixture:
            POLICY: sview = "Terminal\nLinear\nAffine\nMultiReplay\nMultiClone\nzero resumes\nduplicate resume\nresume after scope exit\nreentrant\ncleanup\nCancellation\nInvalidContinuation\nUnsafeMultiShot\nstable\nrelease profile\n"
            VERIFIER: sview = "ContinuationPolicy.MultiClone\nContinuationPolicy.MultiReplay\ncapture.type.kind in {TypeKind.Array, TypeKind.Map}\n"
            LOWERER: sview = "def source_handler_operation_conforms\neffect_operation_result_is_known(expected_result) and effect_operation_result_is_known(actual_result)\n"
            TESTS: sview = "multi_shot_rejects_mutable_aggregate_capture\nset_capture: ContinuationCapture\nissue_count(issues, IssueKind.UnsafeMultiShot) == 3\n"
            SUCCESS: sview = "continuation policy audit: decision record, verifier guard, and IR fixture present\n"


        struct TemporaryRoot:
            path: Path
            created: bool = false
            files: darray[Path] = []
            directories: darray[Path] = []


        struct SourceCopy:
            source: sview
            destination: sview


        def file_has_sha256(path_text: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            source_path: Path = path(path_text)
            return false if not is_file(source_path)
            source_size: usize = try file_size(source_path) else err:
                return false
            return false if source_size == 0 or source_size > Commands::MAX_PINNED_FILE_BYTES
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "continuation-policy-audit-source-sha256",
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", path_text],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(runner):
                ok value:
                    hash_run <- value
                error _:
                    return false
            return false if hash_run.outcome != DifferentialRunOutcome.Completed or hash_run.exit_status != 0 or hash_run.stderr != ""
            return hash_run.stdout == expected_hex + "  " + path_text + "\n"


        def source_set_is_pinned() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return file_has_sha256(Commands::REFERENCE_SCRIPT, Commands::REFERENCE_SHA256) and file_has_sha256(Commands::CANDIDATE_SCRIPT, Commands::CANDIDATE_SHA256) and file_has_sha256(Commands::BOUNDED_READER, Commands::BOUNDED_READER_SHA256) and file_has_sha256(Commands::ENCODING, Commands::ENCODING_SHA256) and file_has_sha256(Commands::FILE_RUNTIME, Commands::FILE_RUNTIME_SHA256) and file_has_sha256(Commands::DIRECTORY_RUNTIME, Commands::DIRECTORY_RUNTIME_SHA256) and file_has_sha256(Commands::STDIO_RUNTIME, Commands::STDIO_RUNTIME_SHA256) and file_has_sha256(Commands::RG_TOOL, Commands::RG_TOOL_SHA256)


        def launcher_case_matches(launcher: sview, reference_path: Path, candidate_path: Path, expected_status: i64, expected_stdout: sview, expected_stderr: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "shell-continuation-policy-audit-reference",
                target: Commands::REFERENCE_SHELL,
                arguments: [f"{reference_path}"],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_PROCESS_OUTPUT_BYTES
            }
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-continuation-policy-audit",
                target: launcher,
                arguments: [f"{candidate_path}"],
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_PROCESS_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error _:
                    return false
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error _:
                    return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return false if reference_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed or not comparison.equal
            return false if reference_run.exit_status != expected_status or reference_run.stdout != expected_stdout or reference_run.stderr != expected_stderr
            return false if candidate_run.exit_status != expected_status or candidate_run.stdout != expected_stdout or candidate_run.stderr != expected_stderr
            return true


        def source_text(path_text: sview) -> sview can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            source_path: Path = path(path_text)
            source_size: usize = try file_size(source_path) else err:
                return ""
            return "" if source_size == 0 or source_size > Commands::MAX_COPIED_FILE_BYTES
            return try EsBoundedText::read_utf8(source_path, Commands::MAX_COPIED_FILE_BYTES) else err:
                ""


        def write_fixture_text(temporary: mutable TemporaryRoot&, relative_path: sview, contents: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            target: Path = path_join(temporary.path, relative_path)
            temporary.files.push(target)
            written: usize = try write_text(target, contents) else 0u64
            return written == len(contents)


        def rewrite_fixture_text(temporary: TemporaryRoot, relative_path: sview, contents: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            target: Path = path_join(temporary.path, relative_path)
            written: usize = try write_text(target, contents) else 0u64
            return written == len(contents)


        def copy_fixture_sources(temporary: mutable TemporaryRoot&) -> bool can[Blocking.IO, Memory.Allocate, Abort.Panic, Console.Write, File.Read, File.Write, Unsafe.PointerCast]:
            sources: darray[SourceCopy] = [
                SourceCopy{source: Commands::REFERENCE_SCRIPT, destination: Commands::REFERENCE_SCRIPT},
                SourceCopy{source: Commands::CANDIDATE_SCRIPT, destination: Commands::CANDIDATE_SCRIPT},
                SourceCopy{source: Commands::BOUNDED_READER, destination: Commands::BOUNDED_READER},
                SourceCopy{source: Commands::ENCODING, destination: Commands::ENCODING},
                SourceCopy{source: Commands::FILE_RUNTIME, destination: Commands::FILE_RUNTIME},
                SourceCopy{source: Commands::DIRECTORY_RUNTIME, destination: Commands::DIRECTORY_RUNTIME},
                SourceCopy{source: Commands::STDIO_RUNTIME, destination: Commands::STDIO_RUNTIME}
            ]
            total_bytes: mutable usize = 0
            for source in sources |sources, total_bytes|:
                original_path: Path = path(source.source)
                source_size: usize = try file_size(original_path) else err:
                    return false
                return false if source_size == 0 or source_size > Commands::MAX_COPIED_FILE_BYTES or source_size > Commands::MAX_COPIED_TOTAL_BYTES - total_bytes
                contents: sview = source_text(source.source)
                return false if contents == ""
                return false if not write_fixture_text(temporary, source.destination, contents)
                total_bytes <- total_bytes + source_size
            return true


        def remove_fixture_path(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write]:
            return try remove_path(target) else false


        def remove_fixture_directory(target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return try remove_directory(target) else false


        def remove_temporary_root(temporary: TemporaryRoot) -> bool can[Memory.Allocate, Abort.Panic, File.Write, Directory.Write]:
            return true if not temporary.created
            cleanup_ok: mutable bool = true
            for index in 0..<temporary.files.count |temporary, cleanup_ok|:
                cleanup_ok <- remove_fixture_path(temporary.files[temporary.files.count - index - 1]) and cleanup_ok
            for index in 0..<temporary.directories.count |temporary, cleanup_ok|:
                cleanup_ok <- remove_fixture_directory(temporary.directories[temporary.directories.count - index - 1]) and cleanup_ok
            return remove_fixture_directory(temporary.path) and cleanup_ok


        def create_fixture_root() -> TemporaryRoot can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary_path: Path = try temp_directory("elisascript-continuation-policy-audit-parity") else err:
                return TemporaryRoot{path: path("."), created: false}
            root: Path = try path_real(temporary_path) else err:
                _ = remove_fixture_directory(temporary_path)
                return TemporaryRoot{path: path("."), created: false}
            temporary: mutable TemporaryRoot = TemporaryRoot{path: root, created: true}
            directory_paths: darray[Path] = [
                root.joinpath("scripts"),
                root.joinpath("src"),
                root.joinpath("src").joinpath("runtime"),
                root.joinpath("src").joinpath("ir"),
                root.joinpath("test"),
                root.joinpath("test").joinpath("ir"),
                root.joinpath("docs")
            ]
            for directory in directory_paths |temporary|:
                created: bool = try create_directory(directory) else false
                if not created:
                    _ = remove_temporary_root(temporary)
                    return TemporaryRoot{path: path("."), created: false}
                temporary.directories.push(directory)

            if not copy_fixture_sources(temporary):
                _ = remove_temporary_root(temporary)
                return TemporaryRoot{path: path("."), created: false}
            fixtures: bool = write_fixture_text(temporary, "docs/continuation-policy.md", Fixture::POLICY)
            fixtures <- write_fixture_text(temporary, "src/ir/ir_verify.elisa", Fixture::VERIFIER) and fixtures
            fixtures <- write_fixture_text(temporary, "src/ir/lower_ast.elisa", Fixture::LOWERER) and fixtures
            fixtures <- write_fixture_text(temporary, "test/ir/elisascript_ir_test.elisa", Fixture::TESTS) and fixtures
            if not fixtures:
                _ = remove_temporary_root(temporary)
                return TemporaryRoot{path: path("."), created: false}
            return temporary


        def representative_smoke_matches(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            temporary: mutable TemporaryRoot = create_fixture_root()
            return false if not temporary.created
            reference_path: Path = temporary.path.joinpath(Commands::REFERENCE_SCRIPT)
            candidate_path: Path = temporary.path.joinpath(Commands::CANDIDATE_SCRIPT)
            matched: mutable bool = launcher_case_matches(launcher, reference_path, candidate_path, 0, Fixture::SUCCESS, "")

            missing_policy_term: sview = Fixture::POLICY.replace("release profile\n", "")
            matched <- matched and rewrite_fixture_text(temporary, "docs/continuation-policy.md", missing_policy_term)
            matched <- matched and launcher_case_matches(launcher, reference_path, candidate_path, 1, "", "continuation policy audit: policy omits release profile\n")

            matched <- matched and rewrite_fixture_text(temporary, "docs/continuation-policy.md", Fixture::POLICY)
            missing_verifier_guard: sview = Fixture::VERIFIER.replace("ContinuationPolicy.MultiClone\n", "")
            matched <- matched and rewrite_fixture_text(temporary, "src/ir/ir_verify.elisa", missing_verifier_guard)
            matched <- matched and launcher_case_matches(launcher, reference_path, candidate_path, 1, "", "")

            cleanup_ok: bool = remove_temporary_root(temporary)
            return matched and cleanup_ok


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def public_launcher_parity(launcher: sview, launcher_hash: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            return false if not file_has_sha256(launcher, launcher_hash)
            return false if not source_set_is_pinned()
            return false if not representative_smoke_matches(launcher)
            return source_set_is_pinned() and file_has_sha256(launcher, launcher_hash)


@test
def continuation_policy_audit_public_launcher_matches_pinned_shell_reference() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsContinuationPolicyAuditLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsContinuationPolicyAuditLauncherParity::pinned_compiler_path()
        assert launcher != "" and launcher.startswith("/")
        assert EsContinuationPolicyAuditLauncherParity::public_launcher_parity(launcher, launcher_hash)
