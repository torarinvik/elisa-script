# Unit tests for the AWK-style migration-root manifest shape and safety rules.
include "../../scripts/check_migration_roots.elisascript"

using EsMigrationRootsAudit


module EsMigrationRootsRecordsTests:
    private:
        def valid_manifest() -> sview:
            return "# name\trelative_path\towner\treview_status\nElisa Projects\tElisa Projects\tmaintainers\treviewed\nGo projects\tGo projects\tunassigned\tpending\n"


        def accepted(contents: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            catch EsMigrationRootsAudit::validate_root_records(contents):
                ok value:
                    return value
                error failure:
                    return false


@test
def migration_roots_records_match_awk_shape_and_safety_rules() -> void:
    can Memory.Allocate, Abort.Panic:
        valid: sview = EsMigrationRootsRecordsTests::valid_manifest()
        bad_header: sview = "name\trelative_path\towner\treview_status\nitem\titem\towner\tpending\n"
        crlf_records: sview = "# name\trelative_path\towner\treview_status\r\nitem\titem\towner\tpending\r\n"
        wrong_field_count: sview = "# name\trelative_path\towner\treview_status\nitem\titem\towner\tpending\textra\n"
        duplicate_name: sview = "# name\trelative_path\towner\treview_status\nitem\tone\towner\tpending\nitem\ttwo\towner\tpending\n"
        duplicate_path: sview = "# name\trelative_path\towner\treview_status\none\tshared\towner\tpending\ntwo\tshared\towner\tblocked\n"
        absolute_path: sview = "# name\trelative_path\towner\treview_status\nitem\t/tmp/item\towner\tpending\n"
        parent_path: sview = "# name\trelative_path\towner\treview_status\nitem\tgroup/../item\towner\tpending\n"
        dot_prefix: sview = "# name\trelative_path\towner\treview_status\nitem\t./item\towner\tpending\n"
        invalid_status: sview = "# name\trelative_path\towner\treview_status\nitem\titem\towner\tunknown\n"
        unowned_reviewed: sview = "# name\trelative_path\towner\treview_status\nitem\titem\tunassigned\treviewed\n"
        empty_records: sview = "# name\trelative_path\towner\treview_status\n\n"
        assert EsMigrationRootsRecordsTests::accepted(valid)
        assert not EsMigrationRootsRecordsTests::accepted(bad_header)
        assert not EsMigrationRootsRecordsTests::accepted(crlf_records)
        assert not EsMigrationRootsRecordsTests::accepted(wrong_field_count)
        assert not EsMigrationRootsRecordsTests::accepted(duplicate_name)
        assert not EsMigrationRootsRecordsTests::accepted(duplicate_path)
        assert not EsMigrationRootsRecordsTests::accepted(absolute_path)
        assert not EsMigrationRootsRecordsTests::accepted(parent_path)
        assert not EsMigrationRootsRecordsTests::accepted(dot_prefix)
        assert not EsMigrationRootsRecordsTests::accepted(invalid_status)
        assert not EsMigrationRootsRecordsTests::accepted(unowned_reviewed)
        assert not EsMigrationRootsRecordsTests::accepted(empty_records)
        assert EsMigrationRootsAudit::canonical_path_is_within_root("/projects", "/projects")
        assert EsMigrationRootsAudit::canonical_path_is_within_root("/projects", "/projects/elisa")
        assert not EsMigrationRootsAudit::canonical_path_is_within_root("/projects", "/projects-escape/elisa")
