# Process-level parity for the ChordBrain AI table generator.
# Run only through the bounded validation wrapper after explicit
# reauthorization; this source is intentionally not run during the validation
# suspension.
include "../../src/testing/differential.elisa"
include "../../src/runtime/bounded_text_posix.elisa"

using EsDifferential
using EsBoundedText


module EsChordBrainAiLauncherParity:
    private:
        const module Commands:
            PYTHON: sview = "python3"
            REFERENCE_SCRIPT: sview = "../ChordBrain/tools/generate_chordseqai.py"
            CANDIDATE_SCRIPT: sview = "scripts/generate_chordbrain_ai.elisascript"
            WEIGHTS_FILE: sview = "../ChordBrain/resources/data/chordseqai_weights.bin"
            VOCAB_FILE: sview = "../ChordBrain/resources/data/chordseqai_vocab.json"
            OUTPUT_SNAPSHOT: sview = "../ChordBrain/src/chordbrain_ai_generated.elisa"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            REFERENCE_SHA256: sview = "6e26259acf9dad301cccde6f63f64aeb3c50f29a73e87d9f263ec8ac3c6aa73e"
            CANDIDATE_SHA256: sview = "b5c2ccb554d2bce1c9dd77314c17cd205ae3c38465a845e6e6c66e523a663a34"
            WEIGHTS_SHA256: sview = "47c3bb29c19ab2928c28697d5c2f4afc8d56da43c47f1b698e13fa5bb3e99a71"
            VOCAB_SHA256: sview = "6959b2a608847d3c22b646749323628b198d1c7524ff1078ca6d2c9deb5bfb51"
            OUTPUT_SNAPSHOT_SHA256: sview = "e313944b5cc30409043d50fc964618f8ce81dd551284b72b0cd282dd3af573f7"
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_PROCESS_OUTPUT_BYTES: u64 = 8192
            MAX_HASHED_FILE_BYTES: usize = 16777216
            MAX_WEIGHTS_BYTES: usize = 2097152
            MAX_VOCAB_BYTES: usize = 1048576
            MAX_GENERATED_BYTES: usize = 16777216
            TIMEOUT_STEPS: u64 = 120000


        def lowercase_sha256_hex_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def file_has_expected_sha256(file_path: sview, expected_hex: sview, process_name: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            input_path: Path = path(file_path)
            return false if not is_file(input_path)
            input_size: usize = try file_size(input_path) else err:
                return false
            return false if input_size == 0 or input_size > Commands::MAX_HASHED_FILE_BYTES
            hash_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: process_name,
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", file_path],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(hash_runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false
            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            return false if hash_run.stdout != expected_hex + "  " + file_path + "\n"
            for index in 0..<64 |hash_run, expected_hex|:
                return false if not lowercase_sha256_hex_byte(sview_at(expected_hex, index))
            return true


        def output_file_cleanup(output_path: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write]:
            return true if not is_file(output_path)
            return try remove_path(output_path) else false


        def source_pins_match() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            reference_script: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate_script: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            weights_path: Path = try path_real(path(Commands::WEIGHTS_FILE)) else err:
                return false
            vocab_path: Path = try path_real(path(Commands::VOCAB_FILE)) else err:
                return false
            snapshot_path: Path = try path_real(path(Commands::OUTPUT_SNAPSHOT)) else err:
                return false
            weights_size: usize = try file_size(weights_path) else err:
                return false
            vocab_size: usize = try file_size(vocab_path) else err:
                return false
            return false if weights_size == 0 or weights_size > Commands::MAX_WEIGHTS_BYTES or vocab_size == 0 or vocab_size > Commands::MAX_VOCAB_BYTES
            return false if not file_has_expected_sha256(f"{reference_script}", Commands::REFERENCE_SHA256, "chordbrain-ai-reference-sha256")
            return false if not file_has_expected_sha256(f"{candidate_script}", Commands::CANDIDATE_SHA256, "chordbrain-ai-candidate-sha256")
            return false if not file_has_expected_sha256(f"{weights_path}", Commands::WEIGHTS_SHA256, "chordbrain-ai-weights-sha256")
            return false if not file_has_expected_sha256(f"{vocab_path}", Commands::VOCAB_SHA256, "chordbrain-ai-vocabulary-sha256")
            return file_has_expected_sha256(f"{snapshot_path}", Commands::OUTPUT_SNAPSHOT_SHA256, "chordbrain-ai-output-snapshot-sha256")


        def generated_files_match(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            reference_script: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate_script: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            weights_path: Path = try path_real(path(Commands::WEIGHTS_FILE)) else err:
                return false
            vocab_path: Path = try path_real(path(Commands::VOCAB_FILE)) else err:
                return false
            snapshot_path: Path = try path_real(path(Commands::OUTPUT_SNAPSHOT)) else err:
                return false
            temporary: Path = try temp_directory("chordbrain-ai-parity") else err:
                return false
            reference_output: Path = temporary.joinpath("reference.elisa")
            candidate_output: Path = temporary.joinpath("candidate.elisa")
            weights_text: sview = f"{weights_path}"
            vocab_text: sview = f"{vocab_path}"
            reference_output_text: sview = f"{reference_output}"
            candidate_output_text: sview = f"{candidate_output}"
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.PythonAdapter,
                name: "pinned-python-chordbrain-ai-reference",
                target: Commands::PYTHON,
                entry: f"{reference_script}",
                arguments: ["--weights", weights_text, "--vocab", vocab_text, "--output", reference_output_text],
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_PROCESS_OUTPUT_BYTES
            }
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-chordbrain-ai-candidate",
                target: launcher,
                arguments: [f"{candidate_script}", "--weights=" + weights_text, "--vocab=" + vocab_text, "--output=" + candidate_output_text],
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_PROCESS_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    print("ChordBrain Python AI generator failed to run")
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    print("ChordBrain Elisascript AI generator failed to run")

            output_matches: mutable bool = false
            if reference_run.outcome == DifferentialRunOutcome.Completed and candidate_run.outcome == DifferentialRunOutcome.Completed and reference_run.exit_status == 0 and candidate_run.exit_status == 0 and reference_run.stdout == "" and candidate_run.stdout == "" and reference_run.stderr == "" and candidate_run.stderr == "":
                reference_generated: sview = try EsBoundedText::read_utf8(reference_output, Commands::MAX_GENERATED_BYTES) else err:
                    ""
                candidate_generated: sview = try EsBoundedText::read_utf8(candidate_output, Commands::MAX_GENERATED_BYTES) else err:
                    ""
                snapshot_generated: sview = try EsBoundedText::read_utf8(snapshot_path, Commands::MAX_GENERATED_BYTES) else err:
                    ""
                output_matches <- reference_generated != "" and reference_generated == candidate_generated and reference_generated == snapshot_generated
            else:
                print("ChordBrain AI generator process outcome mismatch")

            reference_removed: bool = output_file_cleanup(reference_output)
            candidate_removed: bool = output_file_cleanup(candidate_output)
            directory_removed: bool = try remove_directory(temporary) else false
            return output_matches and reference_removed and candidate_removed and directory_removed


        def missing_weights_preserve_outputs(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            reference_script: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate_script: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            vocab_path: Path = try path_real(path(Commands::VOCAB_FILE)) else err:
                return false
            temporary: Path = try temp_directory("chordbrain-ai-failure-parity") else err:
                return false
            missing_weights: Path = temporary.joinpath("missing-weights.bin")
            reference_output: Path = temporary.joinpath("reference-sentinel.elisa")
            candidate_output: Path = temporary.joinpath("candidate-sentinel.elisa")
            sentinel: sview = "preserve this generated table\n"
            reference_written: usize = try write_text(reference_output, sentinel) else 0u64
            candidate_written: usize = try write_text(candidate_output, sentinel) else 0u64
            setup_ok: bool = reference_written == len(sentinel) and candidate_written == len(sentinel)
            if not setup_ok:
                _ = output_file_cleanup(reference_output)
                _ = output_file_cleanup(candidate_output)
                _ = try remove_directory(temporary) else false
                return false
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.PythonAdapter,
                name: "pinned-python-chordbrain-ai-missing-weights",
                target: Commands::PYTHON,
                entry: f"{reference_script}",
                arguments: ["--weights", f"{missing_weights}", "--vocab", f"{vocab_path}", "--output", f"{reference_output}"],
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_PROCESS_OUTPUT_BYTES
            }
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-chordbrain-ai-missing-weights",
                target: launcher,
                arguments: [f"{candidate_script}", "--w", f"{missing_weights}", "--v", f"{vocab_path}", "--o", f"{candidate_output}"],
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_PROCESS_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    print("ChordBrain Python AI missing-weights reference failed to run")
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    print("ChordBrain Elisascript AI missing-weights candidate failed to run")
            reference_sentinel: sview = try EsBoundedText::read_utf8(reference_output, 128) else err:
                ""
            candidate_sentinel: sview = try EsBoundedText::read_utf8(candidate_output, 128) else err:
                ""
            outcomes_match: bool = reference_run.outcome == DifferentialRunOutcome.Completed and candidate_run.outcome == DifferentialRunOutcome.Completed and reference_run.exit_status == 1 and candidate_run.exit_status == 1 and reference_run.stdout == "" and candidate_run.stdout == "" and reference_run.stderr.index("FileNotFoundError:") >= 0 and candidate_run.stderr == "ChordSeqAI generator: unable to read input\n"
            preserved: bool = reference_sentinel == sentinel and candidate_sentinel == sentinel
            reference_removed: bool = output_file_cleanup(reference_output)
            candidate_removed: bool = output_file_cleanup(candidate_output)
            directory_removed: bool = try remove_directory(temporary) else false
            return outcomes_match and preserved and reference_removed and candidate_removed and directory_removed


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def launcher_hash_matches(launcher: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return file_has_expected_sha256(launcher, expected_hex, "chordbrain-ai-launcher-sha256")


        def process_parity_matches(launcher: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            return source_pins_match() and generated_files_match(launcher) and missing_weights_preserve_outputs(launcher)


@test
def chordbrain_ai_generator_matches_pinned_python_output() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsChordBrainAiLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsChordBrainAiLauncherParity::pinned_compiler_path()
        assert launcher != "" and launcher.startswith("/")
        assert EsChordBrainAiLauncherParity::launcher_hash_matches(launcher, launcher_hash)
        assert EsChordBrainAiLauncherParity::process_parity_matches(launcher)
