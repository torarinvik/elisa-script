# Pure selection only; selecting a wave never authorizes execution.
include "canonical_lint_cases.elisa"

module EsCanonicalWrapperScope:
    public:
        const enum Wave of u8:
            LintOnly
            CampaignOnly
            CanonicalOnly
            WrapperFamily


        def includes_reference(wave: Wave, reference: sview) -> bool:
            return (wave == Wave.LintOnly or wave == Wave.WrapperFamily) and reference == "lint_canonical.sh"
            return (wave == Wave.CampaignOnly or wave == Wave.WrapperFamily) and reference == "test_campaign.sh"
            return (wave == Wave.CanonicalOnly or wave == Wave.WrapperFamily) and reference == "test_canonical.sh"


        def includes_source(wave: Wave, destination: sview) -> bool:
            return (wave == Wave.LintOnly or wave == Wave.WrapperFamily) and (destination == "scripts/lint_canonical.sh" or destination == "scripts/lint_canonical.elisascript" or destination == "scripts/lint_canonical_invocation.elisa" or destination == "scripts/passwd_home_posix.elisa" or destination == "scripts/process_errors.elisascript" or destination == "scripts/ruff-signal-probe.sh" or destination == "scripts/pwd-environment-probe.sh")
            return (wave == Wave.CampaignOnly or wave == Wave.WrapperFamily) and (destination == "scripts/test_canonical.sh" or destination == "scripts/test_campaign.sh" or destination == "scripts/canonical_test.elisascript" or destination == "scripts/test_campaign.elisascript")
            return (wave == Wave.CanonicalOnly or wave == Wave.WrapperFamily) and (destination == "scripts/test_canonical.sh" or destination == "scripts/canonical_test.elisascript" or destination == "scripts/test_canonical.elisascript")


        def directories(wave: Wave) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            return ["scripts", "tools"] if wave == Wave.LintOnly
            return ["scripts", "tools", ".venv", ".venv/bin"]


        def probes(wave: Wave) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            literal: sview = "tools/" + EsCanonicalLintCases::Fixture::LITERAL_NAME
            return ["tools/ruff", "tools/probe with spaces", literal] if wave == Wave.LintOnly
            return [".venv/bin/python", "tools/probe with spaces", literal] if wave == Wave.CampaignOnly
            return [".venv/bin/python", "tools/probe with spaces", literal] if wave == Wave.CanonicalOnly
            return [".venv/bin/python", "tools/ruff", "tools/probe with spaces", literal]
