# Small pure fixtures: no launcher, differential facade, native bridge or port.
# Checking these literals is not evidence that either script executes correctly.
include "canonical_lint_cases.elisa"


module EsCanonicalLintCasesFixture:
    private:
        def assert_arguments(actual: darray[sview], expected: darray[sview]) -> void:
            assert actual.count == expected.count
            for index in 0..<expected.count:
                assert actual[index] == expected[index]

    public:
        @test
        def smallest_lint_cases_keep_fixed_argv_and_exclude_other_wrappers() -> void:
            can Memory.Allocate, Abort.Panic:
                cases: darray[EsCanonicalLintCases::Case] = EsCanonicalLintCases::ordinary()
                assert cases.count == 11
                for item in cases:
                    assert item.reference == "lint_canonical.sh"
                    assert item.candidate == "lint_canonical.elisascript"
                    assert item.variable == "RUFF_BIN"
                    assert_arguments(item.expected_argv, ["check", "src", "tests", "experiments/brainworkshop_canonical"])


        @test
        def smallest_lint_cases_pin_each_selection_and_normal_exit_status() -> void:
            can Memory.Allocate, Abort.Panic:
                cases: darray[EsCanonicalLintCases::Case] = EsCanonicalLintCases::ordinary()
                selections: darray[EsCanonicalLintCases::Selection] = [
                    EsCanonicalLintCases::Selection.Unset,
                    EsCanonicalLintCases::Selection.Empty,
                    EsCanonicalLintCases::Selection.Relative,
                    EsCanonicalLintCases::Selection.Absolute,
                    EsCanonicalLintCases::Selection.PathName,
                    EsCanonicalLintCases::Selection.Relative,
                    EsCanonicalLintCases::Selection.Absolute,
                    EsCanonicalLintCases::Selection.Empty,
                    EsCanonicalLintCases::Selection.LiteralRelative,
                    EsCanonicalLintCases::Selection.LiteralAbsolute,
                    EsCanonicalLintCases::Selection.LiteralPathName
                ]
                statuses: darray[i64] = [0i64, 23i64, 1i64, 2i64, 23i64, 126i64, 127i64, 255i64, 31i64, 32i64, 33i64]
                assert cases.count == selections.count and cases.count == statuses.count
                for index in 0..<cases.count:
                    assert cases[index].selection == selections[index]
                    assert cases[index].status == statuses[index]
                # In particular, normal 126/127 exits cannot stand in for
                # missing executable, denied exec or invalid-image failures.


        @test
        def smallest_lint_cases_pin_ignored_empty_and_shell_shaped_arguments() -> void:
            can Memory.Allocate, Abort.Panic:
                cases: darray[EsCanonicalLintCases::Case] = EsCanonicalLintCases::ordinary()
                assert cases.count == 11
                assert_arguments(cases[0].arguments, ["ignored", ""])
                assert_arguments(cases[1].arguments, [])
                assert_arguments(cases[2].arguments, [])
                assert_arguments(cases[3].arguments, [])
                assert_arguments(cases[4].arguments, ["", "a b", "*.py", "$HOME", "; exit 99", "--"])
                assert_arguments(cases[5].arguments, ["--help"])
                assert_arguments(cases[6].arguments, ["--version"])
                assert_arguments(cases[7].arguments, ["ignored", ""])
                for index in 8..<11:
                    assert_arguments(cases[index].arguments, [])


        @test
        def smallest_lint_literal_executable_contains_unexpanded_shell_syntax() -> void:
            assert EsCanonicalLintCases::Fixture::LITERAL_NAME == "probe $HOME; '*.py' \"quoted\" \\tail"
