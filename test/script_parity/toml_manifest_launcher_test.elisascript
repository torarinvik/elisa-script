# Bounded Python/Elisascript process pairs for project TOML and source precedence.
# Run only through the validation wrapper after explicit reauthorization.
include "../../src/testing/differential.elisa"
include "../../src/runtime/bounded_text_posix.elisa"

using EsDifferential
using EsBoundedText


module EsTomlManifestLauncherParity:
    private:
        const module Commands:
            PYTHON: sview = "/opt/homebrew/bin/python3"
            REFERENCE_SCRIPT: sview = "test/fixtures/script_parity/toml_manifest/reference.py"
            CANDIDATE_SCRIPT: sview = "test/fixtures/script_parity/toml_manifest/candidate.elisascript"
            EXPECTED_OUTPUT: sview = "test/fixtures/script_parity/toml_manifest/expected.txt"
            PRECEDENCE_OUTPUT: sview = "test/fixtures/script_parity/toml_manifest/precedence_expected.txt"
            CONTRACT: sview = "test/fixtures/script_parity/toml_manifest/CONTRACT.md"
            CARGO_FIXTURE: sview = "test/runtime/config_toml_cargo_fixture.toml"
            PYPROJECT_FIXTURE: sview = "test/runtime/config_toml_pyproject_fixture.toml"
            HUGO_FIXTURE: sview = "test/runtime/config_toml_hugo_fixture.toml"
            CONFIG_MODEL: sview = "src/runtime/config_model.elisa"
            TOML_MODEL: sview = "src/runtime/config_toml_model.elisa"
            TOML_FILE_READER: sview = "src/runtime/config_toml_file_posix.elisa"
            BOUNDED_READER: sview = "src/runtime/bounded_text_posix.elisa"
            ENCODING: sview = "src/runtime/encoding.elisa"
            SHA256_TOOL: sview = "/usr/bin/shasum"
            PINNED_COMPILER: sview = "/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac"
            CONTROLLED_PATH: sview = "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            PYTHON_SHA256: sview = "87d4df53fd91304be5bac391fb204643c36b7df2023c04a0953bcbc7d4fdf634"
            MAX_HASHED_FILE_BYTES: usize = 67108864
            MAX_HASH_OUTPUT_BYTES: u64 = 8192
            MAX_RUN_OUTPUT_BYTES: u64 = 65536
            MAX_GOLDEN_BYTES: usize = 16384
            MAX_PRECEDENCE_GOLDEN_BYTES: usize = 1024
            TIMEOUT_STEPS: u64 = 10000


        const module SourceHashes:
            REFERENCE: sview = "468bbf432fdc037e34030b22bcbb18c987842b552fc1ea04ae38c9ae2ec86be0"
            CANDIDATE: sview = "6a5933e4731be1f2744426cc7034fafbf48d0567223c2600bdd74b534105ba69"
            EXPECTED: sview = "1fc3d4014051a480cf13e9a62c2cb75ddd45063c36732009b28f3a61ab463956"
            PRECEDENCE_EXPECTED: sview = "2ef6ef37d8f47333c0e60d9a90895be85216b7bd2d7147db68bfb3ba5a436c30"
            CONTRACT: sview = "621a6b6aa7a0c50772d5b994fb07f96de535ecc981d62367b8ba23ea23d27f32"
            CARGO_FIXTURE: sview = "8d1afd7e04c88fcda47b4f61237f1c9e1ad8bd1fdc4a8d1a2fe636ad24c35a04"
            PYPROJECT_FIXTURE: sview = "0c15644f0df156f4359d4f5d572edeb8e3d1741da068ecb8916f69cd5f17d90a"
            HUGO_FIXTURE: sview = "b64ecf373dbbadecb85ae9ab8e68de9c76a06caa1f70bf8852209ab3a145cf58"
            CONFIG_MODEL: sview = "758e02908cdffe4ef78ca16b17df443115f29b9ec525f67d0d76a4c7f9ceb779"
            TOML_MODEL: sview = "a492f724c4cba67a2af169d873e158066b19705e89eb4480af6274ebacd8531b"
            TOML_FILE_READER: sview = "b0c8348f45db515004b4a6385f775ffc4dcf3e0ab461ec78abeb8df31f39551d"
            BOUNDED_READER: sview = "f648d319aca3610e245452d681c21556cc58a774982ea8d0bbda2cca4f1823be"
            ENCODING: sview = "67815c728730d891c2e5fc0cc53a33d672d0f40003cfd468de903c4fbfcd9a53"


        def lowercase_sha256_hex_byte(value: u8) -> bool:
            return value >= 48u8 and value <= 57u8 or value >= 97u8 and value <= 102u8


        def file_has_sha256(path_text: sview, expected_hex: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if len(expected_hex) != 64
            source_path: Path = path(path_text)
            return false if not is_file(source_path)
            source_size: usize = try file_size(source_path) else err:
                return false
            return false if source_size == 0 or source_size > Commands::MAX_HASHED_FILE_BYTES
            hash_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "toml-manifest-parity-source-sha256",
                target: Commands::SHA256_TOOL,
                arguments: ["-a", "256", path_text],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_HASH_OUTPUT_BYTES
            }
            hash_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(hash_runner):
                ok value:
                    hash_run <- value
                error failure:
                    return false
            return false if hash_run.outcome != DifferentialRunOutcome.Completed
            return false if hash_run.exit_status != 0 or hash_run.stderr != ""
            return false if hash_run.stdout != expected_hex + "  " + path_text + "\n"
            for index in 0..<64 |hash_run, expected_hex|:
                return false if not lowercase_sha256_hex_byte(sview_at(expected_hex, index))
            return true


        def source_set_is_pinned() -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return file_has_sha256(Commands::PYTHON, Commands::PYTHON_SHA256) and file_has_sha256(Commands::REFERENCE_SCRIPT, SourceHashes::REFERENCE) and file_has_sha256(Commands::CANDIDATE_SCRIPT, SourceHashes::CANDIDATE) and file_has_sha256(Commands::EXPECTED_OUTPUT, SourceHashes::EXPECTED) and file_has_sha256(Commands::PRECEDENCE_OUTPUT, SourceHashes::PRECEDENCE_EXPECTED) and file_has_sha256(Commands::CONTRACT, SourceHashes::CONTRACT) and file_has_sha256(Commands::CARGO_FIXTURE, SourceHashes::CARGO_FIXTURE) and file_has_sha256(Commands::PYPROJECT_FIXTURE, SourceHashes::PYPROJECT_FIXTURE) and file_has_sha256(Commands::HUGO_FIXTURE, SourceHashes::HUGO_FIXTURE) and file_has_sha256(Commands::CONFIG_MODEL, SourceHashes::CONFIG_MODEL) and file_has_sha256(Commands::TOML_MODEL, SourceHashes::TOML_MODEL) and file_has_sha256(Commands::TOML_FILE_READER, SourceHashes::TOML_FILE_READER) and file_has_sha256(Commands::BOUNDED_READER, SourceHashes::BOUNDED_READER) and file_has_sha256(Commands::ENCODING, SourceHashes::ENCODING)


        def parity_case_matches(launcher: sview, golden: sview, mode: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            reference_path: Path = try path_real(path(Commands::REFERENCE_SCRIPT)) else err:
                return false
            candidate_path: Path = try path_real(path(Commands::CANDIDATE_SCRIPT)) else err:
                return false
            cargo_fixture_path: Path = try path_real(path(Commands::CARGO_FIXTURE)) else err:
                return false
            pyproject_fixture_path: Path = try path_real(path(Commands::PYPROJECT_FIXTURE)) else err:
                return false
            hugo_fixture_path: Path = try path_real(path(Commands::HUGO_FIXTURE)) else err:
                return false
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Commands::CONTROLLED_PATH},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"},
                DifferentialEnvironmentEntry{name: "ELISA_LOCAL_COMPILER", value: Commands::PINNED_COMPILER},
                DifferentialEnvironmentEntry{name: "ELISACORE_BIN", value: Commands::PINNED_COMPILER}
            ]
            reference_arguments: mutable darray[sview] = [f"{reference_path}", mode]
            candidate_arguments: mutable darray[sview] = [f"{candidate_path}", mode]
            if mode == "--parity-batch":
                reference_arguments.push(f"{cargo_fixture_path}")
                reference_arguments.push(f"{pyproject_fixture_path}")
                reference_arguments.push(f"{hugo_fixture_path}")
                candidate_arguments.push(f"{cargo_fixture_path}")
                candidate_arguments.push(f"{pyproject_fixture_path}")
                candidate_arguments.push(f"{hugo_fixture_path}")
            reference_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "python-tomllib-observed-toml-reference",
                target: Commands::PYTHON,
                arguments: reference_arguments,
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_RUN_OUTPUT_BYTES
            }
            candidate_runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess,
                name: "public-elisascript-observed-toml-candidate",
                target: launcher,
                arguments: candidate_arguments,
                working_directory: "/",
                environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Commands::TIMEOUT_STEPS,
                max_output_bytes: Commands::MAX_RUN_OUTPUT_BYTES
            }
            reference_run: mutable DifferentialRun = DifferentialRun{observations: []}
            candidate_run: mutable DifferentialRun = DifferentialRun{observations: []}
            catch run_differential_process(reference_runner):
                ok value:
                    reference_run <- value
                error failure:
                    print("Python TOML reference process failed")
                    return false
            catch run_differential_process(candidate_runner):
                ok value:
                    candidate_run <- value
                error failure:
                    print("Elisascript TOML candidate process failed")
                    return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return false if reference_run.outcome != DifferentialRunOutcome.Completed or candidate_run.outcome != DifferentialRunOutcome.Completed or not comparison.equal
            return false if reference_run.exit_status != 0 or reference_run.stdout != golden or reference_run.stderr != ""
            return false if candidate_run.exit_status != 0 or candidate_run.stdout != golden or candidate_run.stderr != ""
            return true


    public:
        def pinned_compiler_path() -> sview:
            return Commands::PINNED_COMPILER


        def public_launcher_parity(launcher: sview, launcher_hash: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Unsafe.PointerCast]:
            return false if not file_has_sha256(launcher, launcher_hash)
            return false if not source_set_is_pinned()
            golden: sview = try EsBoundedText::read_utf8(path(Commands::EXPECTED_OUTPUT), Commands::MAX_GOLDEN_BYTES) else err:
                return false
            precedence_golden: sview = try EsBoundedText::read_utf8(path(Commands::PRECEDENCE_OUTPUT), Commands::MAX_PRECEDENCE_GOLDEN_BYTES) else err:
                return false
            return false if not parity_case_matches(launcher, golden, "--parity-batch")
            return false if not parity_case_matches(launcher, precedence_golden, "--precedence-batch")
            return source_set_is_pinned() and file_has_sha256(launcher, launcher_hash)


@test
def toml_manifest_public_launcher_matches_independent_python_and_goldens() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, Directory.Read, Unsafe.PointerCast:
        reauthorized: sview = try getenv("ELISASCRIPT_VALIDATION_REAUTHORIZED", "") else err:
            ""
        compiler: sview = try getenv("ELISA_LOCAL_COMPILER", "") else err:
            ""
        elisacore_bin: sview = try getenv("ELISACORE_BIN", "") else err:
            ""
        launcher: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER", "") else err:
            ""
        launcher_hash: sview = try getenv("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256", "") else err:
            ""
        rss_guard: sview = try getenv("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD", "") else err:
            ""
        assert reauthorized == "1"
        assert rss_guard == "active"
        assert compiler == EsTomlManifestLauncherParity::pinned_compiler_path()
        assert elisacore_bin == EsTomlManifestLauncherParity::pinned_compiler_path()
        assert launcher != "" and launcher.startswith("/")
        assert EsTomlManifestLauncherParity::public_launcher_parity(launcher, launcher_hash)
