# Pure oracle fixtures only; do not launch/build/materialize any probe.
include "ui_codec_probe_model.elisa"

using EsUiCodecProbe


module EsUiCodecProbeFixture:
    public:
        def assert_bytes(actual: darray[u8], expected: darray[u8]) -> void:
            assert actual.count == expected.count
            for index in 0..<expected.count:
                assert actual[index] == expected[index]


        def compiler(output: sview) -> Observation can[Memory.Allocate, Abort.Panic]:
            return Observation{role: Role.Compiler, root: "/fixture space", cwd: "/fixture space/work", tmpdir: EnvironmentValue{present: true, bytes: "/fixture space/tmp"}, arguments: [
                "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
                "-fsanitize=address,undefined", "-fno-omit-frame-pointer",
                "-I/fixture space/elisa-ui/src/platform/common",
                "/fixture space/elisa-ui/test/utf8_utf16_codec_test.c", "-o", output
            ]}


@test
def ui_codec_run_probe_frame_matches_independent_literal_golden() -> void:
    can Memory.Allocate, Abort.Panic:
        value: Observation = Observation{role: Role.Run, status: 9, root: "/f", cwd: "/f/work", tmpdir: EnvironmentValue{present: true, bytes: "/f/tmp"}, marker: EnvironmentValue{present: true, bytes: "m"}, stdin: [0u8,255u8,10u8]}
        actual: darray[u8] = try expected_stdout(value) else err:
            assert false
            return
        EsUiCodecProbeFixture::assert_bytes(actual, [
            69u8,83u8,85u8,73u8,71u8,65u8,84u8,69u8,49u8,82u8,9u8,
            0u8,0u8,0u8,0u8,
            0u8,0u8,0u8,7u8,47u8,102u8,47u8,119u8,111u8,114u8,107u8,
            0u8,
            1u8,0u8,0u8,0u8,6u8,47u8,102u8,47u8,116u8,109u8,112u8,
            1u8,0u8,0u8,0u8,1u8,109u8,
            0u8,0u8,0u8,3u8,0u8,255u8,10u8,0u8,255u8
        ])
        EsUiCodecProbeFixture::assert_bytes(expected_stderr(Role.Run), [117u8,105u8,45u8,114u8,117u8,110u8,45u8,115u8,116u8,100u8,101u8,114u8,114u8,0u8,255u8])


@test
def ui_codec_compiler_probe_normalizes_only_admitted_random_output_component() -> void:
    can Memory.Allocate, Abort.Panic:
        shell: Observation = EsUiCodecProbeFixture::compiler("/fixture space/tmp/tmp.A01234/utf8_utf16_codec_test")
        script: Observation = EsUiCodecProbeFixture::compiler("/fixture space/tmp/elisascript-ui-codec-A01234/utf8_utf16_codec_test")
        left: darray[u8] = try expected_stdout(shell) else err:
            assert false
            return
        right: darray[u8] = try expected_stdout(script) else err:
            assert false
            return
        EsUiCodecProbeFixture::assert_bytes(left, right)
        assert left[9] == 67u8 and left[10] == 0u8
        assert left[11] == 0u8 and left[12] == 0u8 and left[13] == 0u8 and left[14] == 11u8
        present: mutable Observation = shell
        present.cc <- EnvironmentValue{present: true, bytes: ""}
        changed: darray[u8] = try expected_stdout(present) else err:
            assert false
            return
        assert changed.count == left.count + 4
        # The shell reference exports clang after defaulting an inherited empty
        # CC. The current candidate leaves CC empty: do not normalize this away.
        shell_default: mutable Observation = shell
        shell_default.cc <- EnvironmentValue{present: true, bytes: "clang"}
        shell_packet: darray[u8] = try expected_stdout(shell_default) else err:
            assert false
            return
        assert shell_packet.count == changed.count + 5


@test
def ui_codec_probe_rejects_output_escape_and_extra_components() -> void:
    can Memory.Allocate, Abort.Panic:
        for output in ["/outside/tmp/a/utf8_utf16_codec_test", "/f/tmp/../utf8_utf16_codec_test", "/f/tmp/./utf8_utf16_codec_test", "/f/tmp/a/b/utf8_utf16_codec_test", "/f/tmp//utf8_utf16_codec_test", "/f/tmp/a/not-the-test", "/f/tmp/a\0b/utf8_utf16_codec_test"]:
            assert not output_admitted("/f", output)
        assert output_admitted("/f", "/f/tmp/tmp.1/utf8_utf16_codec_test")
        assert output_admitted("/f", "/f/tmp/elisascript-ui-codec-ABC123/utf8_utf16_codec_test")
        assert not output_admitted("", "/tmp/a/utf8_utf16_codec_test")
        assert not output_admitted("/f\0", "/f\0/tmp/a/utf8_utf16_codec_test")


@test
def ui_codec_probe_rejects_invalid_status_role_input_and_forged_environment() -> void:
    can Memory.Allocate, Abort.Panic:
        for status in [-1i64, 256i64]:
            rejected: mutable bool = false
            catch expected_stdout(Observation{role: Role.Run, status: status, root: "/f", cwd: "/f/work", tmpdir: EnvironmentValue{present: true, bytes: "/f/tmp"}}):
                ok _:
                    assert false
                error failure:
                    rejected <- failure == FrameError.InvalidStatus
            assert rejected
        compiler: mutable Observation = EsUiCodecProbeFixture::compiler("/fixture space/tmp/a/utf8_utf16_codec_test")
        compiler.stdin <- [0u8]
        rejected_input: mutable bool = false
        catch expected_stdout(compiler):
            ok _:
                assert false
            error failure:
                rejected_input <- failure == FrameError.StdinLimit
        assert rejected_input
        forged: Observation = Observation{role: Role.Run, root: "/f", cwd: "/f/work", tmpdir: EnvironmentValue{present: true, bytes: "/f/tmp"}, marker: EnvironmentValue{bytes: "hidden"}}
        rejected_environment: mutable bool = false
        catch expected_stdout(forged):
            ok _:
                assert false
            error failure:
                rejected_environment <- failure == FrameError.AbsentEnvironmentPayload
        assert rejected_environment


@test
def ui_codec_run_probe_admits_exact_binary_input_boundary() -> void:
    can Memory.Allocate, Abort.Panic:
        input: mutable darray[u8] = []
        for _ in 0..<65536 |input|:
            input.push(255u8)
        value: Observation = Observation{role: Role.Run, root: "/f", cwd: "/f/work", tmpdir: EnvironmentValue{present: true, bytes: "/f/tmp"}, stdin: input}
        packet: darray[u8] = try expected_stdout(value) else err:
            assert false
            return
        # No marker payload: stdin's u32 occupies bytes 39..42 (big endian).
        assert packet[39] == 0u8 and packet[40] == 1u8 and packet[41] == 0u8 and packet[42] == 0u8
        input.push(0u8)
        rejected: mutable bool = false
        catch expected_stdout(Observation{role: Role.Run, root: "/f", cwd: "/f/work", tmpdir: EnvironmentValue{present: true, bytes: "/f/tmp"}, stdin: input}):
            ok _:
                assert false
            error failure:
                rejected <- failure == FrameError.StdinLimit
        assert rejected
