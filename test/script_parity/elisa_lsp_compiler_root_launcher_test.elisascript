# Dormant projection matrix for a sourced Bash function. Explicit user
# reauthorization, a qualified prebuilt launcher, and an external RSS/time
# guard are required. This file never builds or launches a compiler itself.
include "../../src/testing/differential.elisa"
include "../../src/runtime/bounded_text_posix.elisa"
include "../../src/testing/checksum_record_model.elisa"
include "skia_environment_launcher_plan.elisa"
include "elisa_lsp_compiler_root_cases.elisa"

using EsDifferential


module EsLspCompilerRootLauncherParity:
    private:
        const module Tools:
            BASH: sview = "/bin/bash"
            BASH_SHA256: sview = "d59c6f2312e551e9c46497329d435b6ec74fbc46e9155b84170f377127ed004e"
            SHA256: sview = "/usr/bin/shasum"
            SHA256_SHA256: sview = "0812595f981a26f813d98dc380af14d4af427626c9339eda29eb849ae13de1e3"
            COMPILER: sview = EsSkiaEnvironmentLauncherPlan::Pins::COMPILER
            PATH_VALUE: sview = "/usr/bin:/bin:/usr/sbin:/sbin"
            TIMEOUT_STEPS: u64 = 10000
            OUTPUT_BYTES: u64 = 16384
            PIN_BYTES: usize = 67108864
            COPY_BYTES: usize = 524288
            TOTAL_COPY_BYTES: usize = 2097152


        const module Paths:
            LSP: sview = "Elisa-LSP"
            LIVE_REFERENCE: sview = "../Elisa-LSP/scripts/compiler_root_env.sh"
            SENTINEL: sview = "outside-lsp-sentinel"
            SENTINEL_BYTES: sview = "outside staged LSP tree; keep unchanged\n"
            REFERENCE: sview = "Elisa-LSP/scripts/reference.sh"
            OBSERVER: sview = "Elisa-LSP/scripts/reference_observe.sh"
            CANDIDATE: sview = "Elisa-LSP/scripts/compiler_root_env.elisascript"
            MODEL: sview = "Elisa-LSP/scripts/compiler_root_env_model.elisa"


        struct SourceCopy:
            source: sview
            destination: sview
            sha256: sview


        struct TemporaryRoot:
            path: Path
            created: bool = false
            ready: bool = false
            files: darray[Path] = []
            directories: darray[Path] = []


        struct Authorization:
            launcher: sview
            launcher_sha256: sview
            compiler_sha256: sview


        error GateError:
            Disabled
            MissingGuard
            WrongCompiler
            InvalidIdentity


        def environment_value(name: sview) -> sview can[Environment.Read]:
            return try getenv(name, "") else ""


        def authorization() -> Authorization error[GateError] can[Environment.Read]:
            raise GateError.Disabled if environment_value("ELISASCRIPT_VALIDATION_REAUTHORIZED") != "1" or environment_value("ELISASCRIPT_LSP_ROOT_LAUNCHER_QUALIFIED") != "1"
            raise GateError.MissingGuard if environment_value("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD") != "active"
            raise GateError.WrongCompiler if environment_value("ELISA_LOCAL_COMPILER") != Tools::COMPILER or environment_value("ELISACORE_BIN") != Tools::COMPILER
            launcher: sview = environment_value("ELISASCRIPT_PUBLIC_LAUNCHER")
            launcher_hash: sview = environment_value("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256")
            compiler_hash: sview = environment_value("ELISASCRIPT_LOCAL_COMPILER_SHA256")
            try EsSkiaEnvironmentLauncherPlan::validate_roles(
                EsSkiaEnvironmentLauncherPlan::Identity{path: launcher, hash: launcher_hash},
                EsSkiaEnvironmentLauncherPlan::Identity{path: Tools::BASH, hash: Tools::BASH_SHA256}, compiler_hash) else err:
                raise GateError.InvalidIdentity
            return Authorization{launcher: launcher, launcher_sha256: launcher_hash, compiler_sha256: compiler_hash}


        def sources() -> darray[SourceCopy] can[Memory.Allocate, Abort.Panic]:
            return [
                SourceCopy{source: "test/fixtures/script_parity/elisa_lsp_compiler_root/reference.sh", destination: Paths::REFERENCE, sha256: "f8035e67548592d33577988dc3315a8c9f2f423fa56daa03906b65457dd3524a"},
                SourceCopy{source: "test/fixtures/script_parity/elisa_lsp_compiler_root/reference_observe.sh", destination: Paths::OBSERVER, sha256: "5e6196860c40c861f1a6ecee2d1ab32a76c4b22c591d829f8ebca62ea5be4674"},
                SourceCopy{source: "ports/Elisa-LSP/scripts/compiler_root_env.elisascript", destination: Paths::CANDIDATE, sha256: "1aa632ce625dd5608de31714567c8bb9ff6d22dc699b16fcd38960eaf8d50e6c"},
                SourceCopy{source: "ports/Elisa-LSP/scripts/compiler_root_env_model.elisa", destination: Paths::MODEL, sha256: "0ff7c281c690ff45c471aee003b7a8a9e17ba782d5e523782acbc1b2d5e719d1"}
            ]


        def has_sha256(target: sview, expected: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if not EsSkiaEnvironmentLauncherPlan::valid_hash(expected) or target == "" or target == "-" or len(target) > EsChecksumRecord::Limits::FILENAME_BYTES
            for byte in target:
                return false if byte == 0u8
            return false if not is_file(path(target)) or is_symlink(path(target))
            size: usize = try file_size(path(target)) else err:
                return false
            return false if size == 0 or size > Tools::PIN_BYTES
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess, name: "lsp-root-identity",
                target: Tools::SHA256, arguments: ["-a", "256", "-t", "--", target],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES
            }
            observed: DifferentialRun = try run_differential_process(runner) else err:
                return false
            return false if observed.outcome != DifferentialRunOutcome.Completed or observed.error_text != "" or observed.exit_status != 0 or observed.stderr != ""
            return try EsChecksumRecord::sha256_text_record_matches(observed.stdout, expected, target) else false


        # Header admission rejects executable text wrappers before a hash-tool
        # child. It is not artifact provenance, no-auto-build proof or an OS cap.
        def native_artifact(target: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if not EsSkiaEnvironmentLauncherPlan::absolute_identity_path(target)
            file: Path = path(target)
            return false if not is_file(file) or is_symlink(file) or not is_executable(file)
            size: usize = try file_size(file) else 0usize
            return false if size < 4 or size > Tools::PIN_BYTES
            name: mutable darray[u8] = []
            for byte in target |name|:
                name.push(byte)
            name.push(0u8)
            mode: darray[u8] = [114u8, 98u8, 0u8]
            stream: mutable heap void&? = fopen(&name[0], &mode[0])
            return false if stream == null
            opened: mutable heap void& = stream
            header: mutable darray[u8] = [0u8, 0u8, 0u8, 0u8]
            amount: usize = fread((&header[0]).cast[mutable void&], 1, 4, opened)
            closed: int = fclose(opened)
            return amount == 4 and closed == 0 and EsSkiaEnvironmentLauncherPlan::native_container_header(header) and not is_symlink(file)


        def pinned_inputs(auth: Authorization) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if not native_artifact(Tools::COMPILER) or not native_artifact(Tools::BASH) or not native_artifact(auth.launcher)
            return false if not has_sha256(Tools::SHA256, Tools::SHA256_SHA256)
            return false if not has_sha256("test/script_parity/skia_environment_launcher_plan.elisa", "9941a2c973a8492f20a36785bf6c44085bb7d3718218eaf8d12536feb645164e")
            return false if not has_sha256("src/testing/checksum_record_model.elisa", "1b3cec1235d42076e50b15491d3d6b906f3841ea966937779dc665f1e8a59488")
            return false if not has_sha256("src/runtime/bounded_text_posix.elisa", "a0c8d8144e4ebd9f90402489696b153bed6e7b292722ba2ca11eda551c27cda0")
            # Pin committed runner source; concurrent dirty bridge edits fail
            # closed until separately reviewed and explicitly requalified.
            return false if not has_sha256("src/testing/differential.elisa", "22b3b93ac3bafb9103f96a8e48d18769698e2e223da34eb10fe7d7572f9652ac")
            return false if not has_sha256("test/script_parity/elisa_lsp_compiler_root_cases.elisa", "7425b22b3be42266400f5610f916b75af223f7dc1e56ed0f7efc12393169f542")
            return false if not has_sha256(Paths::LIVE_REFERENCE, "f8035e67548592d33577988dc3315a8c9f2f423fa56daa03906b65457dd3524a")
            return false if not has_sha256(Tools::BASH, Tools::BASH_SHA256) or not has_sha256(Tools::COMPILER, auth.compiler_sha256) or not has_sha256(auth.launcher, auth.launcher_sha256)
            for source in sources():
                return false if not has_sha256(source.source, source.sha256)
            return true


        def parents_intact(root: TemporaryRoot, remaining: usize) -> bool can[Memory.Allocate, Abort.Panic, File.Read, Directory.Read]:
            return false if remaining > root.directories.count or is_symlink(root.path) or not is_directory(root.path)
            for index in 0..<remaining:
                directory: Path = root.directories[index]
                return false if is_symlink(directory) or not is_directory(directory)
            return true


        def make_directory(root: mutable TemporaryRoot&, relative: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write]:
            return false if not parents_intact(root, root.directories.count)
            target: Path = root.path.joinpath(relative)
            return false if path_exists(target) or is_symlink(target)
            created: bool = try create_directory(target) else false
            return false if not created
            root.directories.push(target)
            return true


        def write_new(root: mutable TemporaryRoot&, relative: sview, contents: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read]:
            return false if not parents_intact(root, root.directories.count)
            target: Path = root.path.joinpath(relative)
            return false if path_exists(target) or is_symlink(target)
            root.files.push(target)
            written: usize = try write_text(target, contents) else err:
                return false
            return written == len(contents)


        def make_symlink(root: mutable TemporaryRoot&, relative: sview, target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read]:
            return false if not parents_intact(root, root.directories.count)
            link: Path = root.path.joinpath(relative)
            return false if path_exists(link) or is_symlink(link)
            created: bool = try symlink(target, link) else false
            return false if not created
            root.files.push(link)
            return true


        def cleanup(root: TemporaryRoot) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write]:
            return true if not root.created
            cleaned: mutable bool = true
            for index in 0..<root.files.count |root, cleaned|:
                return false if not parents_intact(root, root.directories.count)
                target: Path = root.files[root.files.count - index - 1]
                if path_exists(target) or is_symlink(target):
                    removed: bool = try remove_path(target) else false
                    cleaned <- removed and cleaned
            for index in 0..<root.directories.count |root, cleaned|:
                return false if not parents_intact(root, root.directories.count - index)
                removed: bool = try remove_directory(root.directories[root.directories.count - index - 1]) else false
                cleaned <- removed and cleaned
            return false if not parents_intact(root, 0)
            removed_root: bool = try remove_directory(root.path) else false
            return removed_root and cleaned


        def copied_inputs_intact(root: TemporaryRoot) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast]:
            return false if not root.ready or not parents_intact(root, root.directories.count)
            sentinel: Path = root.path.joinpath(Paths::SENTINEL)
            return false if not is_file(sentinel) or is_symlink(sentinel)
            sentinel_contents: sview = try EsBoundedText::read_utf8(sentinel, len(Paths::SENTINEL_BYTES)) else err:
                return false
            return false if sentinel_contents != Paths::SENTINEL_BYTES
            for source in sources():
                return false if not has_sha256(f"{root.path.joinpath(source.destination)}", source.sha256)
            return true


        def copy_sources(root: mutable TemporaryRoot&) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Unsafe.PointerCast]:
            copied_bytes: mutable usize = 0
            for source in sources() |root, copied_bytes|:
                contents: sview = try EsBoundedText::read_utf8(path(source.source), Tools::COPY_BYTES) else err:
                    return false
                return false if contents == "" or len(contents) > Tools::TOTAL_COPY_BYTES - copied_bytes
                return false if not write_new(root, source.destination, contents)
                copied_bytes <- copied_bytes + len(contents)
                return false if not has_sha256(f"{root.path.joinpath(source.destination)}", source.sha256)
            return true


        def create_root() -> TemporaryRoot can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            allocated: Path = try temp_directory("elisascript lsp root parity ") else err:
                return TemporaryRoot{path: path("."), created: false}
            canonical: Path = try path_real(allocated) else err:
                return TemporaryRoot{path: allocated, created: true}
            root: mutable TemporaryRoot = TemporaryRoot{path: canonical, created: true}
            for relative in [Paths::LSP, "Elisa-LSP/scripts"]:
                if not make_directory(root, relative):
                    return root
            if not copy_sources(root):
                return root
            if not write_new(root, Paths::SENTINEL, Paths::SENTINEL_BYTES):
                return root
            root.ready <- true
            return root


        def prepare_topology(root: mutable TemporaryRoot&, selected: EsLspCompilerRootCases::Case) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write]:
            match selected.topology:
                EsLspCompilerRootCases::Topology.MissingCompilerSibling:
                    return true
                EsLspCompilerRootCases::Topology.ExistingOverrideFile:
                    return write_new(root, "not-directory", "ordinary file\n")
                EsLspCompilerRootCases::Topology.ExistingOverrideDirectory:
                    return make_directory(root, "compiler checkout")
                EsLspCompilerRootCases::Topology.OverrideDirectorySymlink:
                    return make_symlink(root, "link", root.path.joinpath("compiler checkout"))
                EsLspCompilerRootCases::Topology.ExistingCompilerSibling:
                    return make_directory(root, "Elisa-compiler")
                _:
                    return false


        def topology_intact(root: TemporaryRoot, selected: EsLspCompilerRootCases::Case) -> bool can[Memory.Allocate, Abort.Panic, File.Read, Directory.Read]:
            return false if not parents_intact(root, root.directories.count)
            if selected.topology == EsLspCompilerRootCases::Topology.MissingCompilerSibling:
                sibling: Path = root.path.joinpath("Elisa-compiler")
                relative_override: Path = root.path.joinpath("missing ; $HOME/*.elisa")
                absolute_override: Path = root.path.joinpath("missing compiler")
                return not path_exists(sibling) and not is_symlink(sibling) and not path_exists(relative_override) and not is_symlink(relative_override) and not path_exists(absolute_override) and not is_symlink(absolute_override)
            if selected.topology == EsLspCompilerRootCases::Topology.ExistingOverrideFile:
                return is_file(root.path.joinpath("not-directory")) and not is_symlink(root.path.joinpath("not-directory"))
            if selected.topology == EsLspCompilerRootCases::Topology.ExistingOverrideDirectory:
                return is_directory(root.path.joinpath("compiler checkout")) and not is_symlink(root.path.joinpath("compiler checkout"))
            if selected.topology == EsLspCompilerRootCases::Topology.OverrideDirectorySymlink:
                link: Path = root.path.joinpath("link")
                target: Path = root.path.joinpath("compiler checkout")
                return false if not is_symlink(link) or is_symlink(target) or not is_directory(target)
                resolved: Path = try path_real(link) else err:
                    return false
                return f"{resolved}" == f"{target}" and is_symlink(link)
            if selected.topology == EsLspCompilerRootCases::Topology.ExistingCompilerSibling:
                return is_directory(root.path.joinpath("Elisa-compiler")) and not is_symlink(root.path.joinpath("Elisa-compiler"))
            return false


        def expected_observation(run: DifferentialRun, selected: EsLspCompilerRootCases::Case) -> bool:
            return run.outcome == DifferentialRunOutcome.Completed and run.error_text == "" and run.exit_status == selected.expected_status and run.stdout == selected.expected_stdout and run.stderr == selected.expected_stderr


        def case_matches(auth: Authorization, root: TemporaryRoot, selected: EsLspCompilerRootCases::Case) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast]:
            return false if not copied_inputs_intact(root) or not topology_intact(root, selected)
            environment: mutable darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Tools::PATH_VALUE},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"}
            ]
            environment.push(DifferentialEnvironmentEntry{name: "ELISA_COMPILER_ROOT", value: selected.override_value}) if selected.override_present
            reference: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess, name: "lsp-root-bash-reference",
                target: Tools::BASH, arguments: [f"{root.path.joinpath(Paths::OBSERVER)}", f"{root.path.joinpath(Paths::LSP)}"],
                working_directory: f"{root.path}", environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES
            }
            candidate: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess, name: "lsp-root-public-candidate",
                target: auth.launcher, arguments: [f"{root.path.joinpath(Paths::CANDIDATE)}"],
                working_directory: f"{root.path}", environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES
            }
            reference_run: DifferentialRun = try run_differential_process(reference) else err:
                return false
            return false if not expected_observation(reference_run, selected) or not copied_inputs_intact(root) or not topology_intact(root, selected)
            candidate_run: DifferentialRun = try run_differential_process(candidate) else err:
                return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return comparison.equal and expected_observation(candidate_run, selected) and copied_inputs_intact(root) and topology_intact(root, selected)


        def matrix(auth: Authorization, root: mutable TemporaryRoot&) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Write]:
            cases: darray[EsLspCompilerRootCases::Case] = EsLspCompilerRootCases::ordinary(f"{root.path}")
            return false if cases.count != EsLspCompilerRootCases::Fixture::CASES
            for selected in cases |root|:
                return false if not prepare_topology(root, selected)
                if not case_matches(auth, root, selected):
                    _ = write_stderr("lsp root parity: failed case " + selected.label + "\n")
                    return false
            return true

    public:
        def public_launcher_parity() -> bool can[Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Write, Console.Format]:
            auth: Authorization = try authorization() else err:
                _ = write_stderr("lsp root parity: validation gate is not qualified\n")
                return false
            if not pinned_inputs(auth):
                _ = write_stderr("lsp root parity: source/tool identity check failed\n")
                return false
            root: mutable TemporaryRoot = create_root()
            return false if not root.created
            matched: bool = root.ready and matrix(auth, root)
            cleaned: bool = cleanup(root)
            if not cleaned:
                _ = write_stderr(f"lsp root parity: cleanup failed at {root.path}\n")
                return false
            if not matched:
                _ = write_stderr("lsp root parity: fixture or exact observation failed\n")
                return false
            return pinned_inputs(auth)


@test
def lsp_compiler_root_public_launcher_matches_pinned_bash_projection() -> void:
    can Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Write, Console.Format:
        assert EsLspCompilerRootLauncherParity::public_launcher_parity()
