include "../../ports/elisa-engine/scripts/save_journal_model.elisa"

using EsEngineSaveJournal
using EsJson


def save_journal_parse_rejects(source: sview, expected: SaveJournalError) -> bool can[Memory.Allocate, Abort.Panic]:
    observed: mutable bool = false
    catch parse_json_object(source):
        ok document:
            _ = document
        error failure:
            observed <- failure == expected
    return observed


@test
def canonical_payload_sorts_keys_keeps_last_duplicate_and_escapes_strings() -> void:
    can Memory.Allocate, Abort.Panic:
        document: JsonDocument = parse_json_object("{\"z\":1,\"a\":\"é\\n\",\"z\":2,\"n\":-0}")
        payload: darray[u8] = canonical_payload(document)
        assert bytes_view(payload) == "{\"a\":\"é\\n\",\"n\":0,\"z\":2}\n"


@test
def save_journal_requires_one_json_object_root() -> void:
    can Memory.Allocate, Abort.Panic:
        assert save_journal_parse_rejects("[1]", SaveJournalError.DocumentMustBeObject)
        assert save_journal_parse_rejects("{", SaveJournalError.InvalidJson)


@test
def sha256_hex_matches_the_standard_abc_vector() -> void:
    can Memory.Allocate, Abort.Panic:
        abc: darray[u8] = [97u8, 98u8, 99u8]
        digest: darray[u8] = sha256_hex(abc)
        assert bytes_view(digest) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
