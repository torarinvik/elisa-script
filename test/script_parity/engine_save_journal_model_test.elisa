include "../../ports/elisa-engine/scripts/save_journal_model.elisa"

using EsEngineSaveJournal
using EsJson


def save_journal_parse_rejects(source: sview, expected: SaveJournalError) -> bool can[Memory.Allocate, Abort.Panic]:
    observed: mutable bool = false
    catch parse_json_object(source):
        ok document:
            _ = document
        error failure:
            observed <- failure == expected
    return observed


@test
def canonical_payload_sorts_keys_keeps_last_duplicate_and_escapes_strings() -> void:
    can Memory.Allocate, Abort.Panic, Console.Format:
        document: JsonDocument = parse_json_object("{\"z\":1,\"a\":\"é\\n\",\"z\":2,\"n\":-0}")
        payload: darray[u8] = canonical_payload(document)
        assert bytes_view(payload) == "{\"a\":\"é\\n\",\"n\":0,\"z\":2}\n"


@test
def canonical_payload_uses_python_float_and_integer_serialization() -> void:
    can Memory.Allocate, Abort.Panic, Console.Format:
        document: JsonDocument = parse_json_object("{\"small\":1e-7,\"negative_zero\":-0.0,\"integral_float\":1.000,\"large_integer\":123456789012345678901234567890,\"large_float\":1e+20}")
        payload: darray[u8] = canonical_payload(document)
        assert bytes_view(payload) == "{\"integral_float\":1.0,\"large_float\":1e+20,\"large_integer\":123456789012345678901234567890,\"negative_zero\":-0.0,\"small\":1e-07}\n"


@test
def journal_metadata_is_canonical_and_recovery_requires_matching_target_digest_and_object() -> void:
    can Memory.Allocate, Abort.Panic, Console.Format:
        document: JsonDocument = parse_json_object("{\"value\":7}")
        candidate: darray[u8] = canonical_payload(document)
        digest: darray[u8] = sha256_hex(candidate)
        journal: darray[u8] = canonical_journal_payload("world.save", "world.save.tmp", bytes_view(digest))
        assert bytes_view(journal) == "{\"sha256\":\"" + bytes_view(digest) + "\",\"target\":\"world.save\",\"temporary\":\"world.save.tmp\"}\n"

        metadata: JournalMetadata = parse_journal_metadata(bytes_view(journal))
        assert metadata.target == "world.save" and metadata.temporary == "world.save.tmp"
        assert metadata.sha256 == bytes_view(digest)
        assert recovery_decision(true, metadata, "world.save", "world.save.tmp", candidate) == RecoveryDecision.PublishTemporary
        assert recovery_decision(false, metadata, "world.save", "world.save.tmp", candidate) == RecoveryDecision.NoJournal
        assert recovery_decision(true, metadata, "other.save", "world.save.tmp", candidate) == RecoveryDecision.DiscardTemporary
        assert recovery_decision(true, metadata, "world.save", "other.tmp", candidate) == RecoveryDecision.DiscardTemporary
        checksum_mismatch: darray[u8] = [123u8, 125u8, 10u8]
        assert recovery_decision(true, metadata, "world.save", "world.save.tmp", checksum_mismatch) == RecoveryDecision.DiscardTemporary

        malformed: darray[u8] = [91u8, 93u8, 10u8]
        malformed_digest: darray[u8] = sha256_hex(malformed)
        malformed_journal: darray[u8] = canonical_journal_payload("world.save", "world.save.tmp", bytes_view(malformed_digest))
        malformed_metadata: JournalMetadata = parse_journal_metadata(bytes_view(malformed_journal))
        assert recovery_decision(true, malformed_metadata, "world.save", "world.save.tmp", malformed) == RecoveryDecision.DiscardTemporary


@test
def save_journal_requires_one_json_object_root() -> void:
    can Memory.Allocate, Abort.Panic:
        assert save_journal_parse_rejects("[1]", SaveJournalError.DocumentMustBeObject)
        assert save_journal_parse_rejects("{", SaveJournalError.InvalidJson)


@test
def sha256_hex_matches_the_standard_abc_vector() -> void:
    can Memory.Allocate, Abort.Panic:
        abc: darray[u8] = [97u8, 98u8, 99u8]
        digest: darray[u8] = sha256_hex(abc)
        assert bytes_view(digest) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
