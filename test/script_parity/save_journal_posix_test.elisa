include "../../ports/elisa-engine/scripts/save_journal_posix.elisa"

using EsEngineSaveJournal
using EsEngineSaveJournalPosix


def save_journal_synced_write_roundtrip() -> bool can[Directory.Write, File.Read, File.Write, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    directory: Path = try temp_directory("elisa-save-journal-write-test-") else failure:
        _ = failure
        return false
    target: Path = directory.joinpath("nested/world.save.tmp")
    payload: darray[u8] = [0u8, 255u8, 10u8, 123u8, 125u8, 10u8]
    written: usize = try EsEngineSaveJournalPosix::write_synced_file(target, payload) else failure:
        _ = failure
        _ = try remove_tree(directory)
        return false
    observed: darray[u8] = try read_bytes(target) else failure:
        _ = failure
        _ = try remove_tree(directory)
        return false
    cleaned: bool = try remove_tree(directory) else false
    return written == payload.count and observed == payload and cleaned


@test
def save_journal_synced_write_creates_parent_and_preserves_exact_binary_payload() -> void can[Directory.Write, File.Read, File.Write, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    assert save_journal_synced_write_roundtrip()


def save_journal_document_commit_roundtrip() -> bool can[Directory.Write, File.Read, File.Write, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
    directory: Path = try temp_directory("elisa-save-journal-commit-test-") else failure:
        _ = failure
        return false
    target: Path = directory.joinpath("nested/world.save")
    document: JsonDocument = try EsEngineSaveJournal::parse_json_object("{\"version\":2,\"records\":[{\"id\":7,\"fields\":[1,2]}]}") else failure:
        _ = failure
        _ = try remove_tree(directory)
        return false
    expected_payload: darray[u8] = try EsEngineSaveJournal::canonical_payload(document) else failure:
        _ = failure
        _ = try remove_tree(directory)
        return false
    expected_digest: darray[u8] = try EsEngineSaveJournal::sha256_hex(expected_payload) else failure:
        _ = failure
        _ = try remove_tree(directory)
        return false
    observed_digest: darray[u8] = try EsEngineSaveJournalPosix::save_document(target, document) else failure:
        _ = failure
        _ = try remove_tree(directory)
        return false
    observed_payload: darray[u8] = try read_bytes(target) else failure:
        _ = failure
        _ = try remove_tree(directory)
        return false
    temporary: Path = target.with_name("world.save.tmp")
    journal: Path = target.with_name("world.save.journal")
    artifacts_removed: bool = not temporary.exists() and not journal.exists()
    cleaned: bool = try remove_tree(directory) else false
    return observed_digest == expected_digest and observed_payload == expected_payload and artifacts_removed and cleaned


@test
def save_journal_save_writes_canonical_payload_and_removes_commit_artifacts() -> void can[Directory.Write, File.Read, File.Write, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
    assert save_journal_document_commit_roundtrip()
