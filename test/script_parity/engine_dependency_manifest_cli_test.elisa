include "../../ports/elisa-engine/scripts/dependency_manifest_cli_model.elisa"

using EsEngineDependencyManifestCli


@test
def parses_root_and_manifest_options_in_separate_and_equals_forms() -> void:
    separate: ParseResult = parse_options(["--root", "/repo", "--manifest", "native/manifest.json"])
    assert separate.failure == Failure.None
    assert separate.options.has_root and separate.options.root == "/repo"
    assert separate.options.has_manifest and separate.options.manifest == "native/manifest.json"

    equals: ParseResult = parse_options(["--root=/work", "--manifest=/tmp/manifest.json"])
    assert equals.failure == Failure.None
    assert equals.options.root == "/work"
    assert equals.options.manifest == "/tmp/manifest.json"


@test
def last_repeated_option_wins_and_help_short_circuits() -> void:
    repeated: ParseResult = parse_options(["--root", "/first", "--root=/last"])
    assert repeated.failure == Failure.None and repeated.options.root == "/last"

    help: ParseResult = parse_options(["--help", "--unknown"])
    assert help.failure == Failure.HelpRequested


@test
def rejects_missing_values_unknown_options_positionals_and_double_dash_tail() -> void:
    assert parse_options(["--root"]).failure == Failure.MissingOptionValue
    assert parse_options(["--root", "--manifest", "manifest.json"]).failure == Failure.MissingOptionValue
    unknown: ParseResult = parse_options(["--other"])
    assert unknown.failure == Failure.UnknownOption and unknown.detail == "--other"
    positional: ParseResult = parse_options(["manifest.json"])
    assert positional.failure == Failure.UnexpectedArgument
    after_end: ParseResult = parse_options(["--", "manifest.json"])
    assert after_end.failure == Failure.UnexpectedArgument
