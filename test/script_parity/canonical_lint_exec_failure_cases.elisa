# Actual exec-failure plans, not normally returned probe statuses.
# Pure metadata only: no runner, port, filesystem or execution gate is imported.
module EsCanonicalLintExecFailureCases:
    public:
        const module Fixture:
            MISSING_NAME: sview = "elisascript lint missing probe"
            DENIED_NAME: sview = "elisascript lint denied probe"
            DENIED_MODE: u64 = 384
            MODE_MASK: u64 = 4095


        const enum Target of u8:
            Missing
            Denied
            Directory


        const enum Address of u8:
            Relative
            Absolute
            PathName


        struct Case:
            name: sview
            target: Target
            address: Address
            status: i64


        def required() -> darray[Case] can[Memory.Allocate, Abort.Panic]:
            return [
                Case{name: "missing-relative", target: Target.Missing, address: Address.Relative, status: 127},
                Case{name: "missing-absolute", target: Target.Missing, address: Address.Absolute, status: 127},
                Case{name: "missing-path", target: Target.Missing, address: Address.PathName, status: 127},
                Case{name: "denied-relative", target: Target.Denied, address: Address.Relative, status: 126},
                Case{name: "denied-absolute", target: Target.Denied, address: Address.Absolute, status: 126},
                Case{name: "denied-path", target: Target.Denied, address: Address.PathName, status: 126},
                Case{name: "directory-absolute", target: Target.Directory, address: Address.Absolute, status: 126}
            ]


        def executable_text(item: Case, root: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            name: sview = when item.target:
                Target.Missing -> Fixture::MISSING_NAME
                Target.Denied -> Fixture::DENIED_NAME
                Target.Directory -> "scripts"
            relative: sview = name if item.target == Target.Directory else "tools/" + name
            return when item.address:
                Address.Relative -> relative
                Address.Absolute -> root + "/" + relative
                Address.PathName -> name
