include "../../ports/elisa-engine/scripts/build_nav_native_test_plan.elisa"

using EsEngineNavNativeTestBuildPlan


@test
def plans_the_navigation_test_build_as_literal_argv() -> void can[Memory.Allocate, Abort.Panic]:
    plan: mutable Plan = Plan{}
    catch EsEngineNavNativeTestBuildPlan::plan(
        "/projects with spaces/elisa-engine", "navigation smoke", "/tools/Elisa Compiler/elisac", "/runtime objects/runtime.o"
    ):
        ok value:
            plan <- value
        error failure:
            _ = failure
            assert false

    assert plan.build_directory == "/projects with spaces/elisa-engine/build"
    assert plan.executable_path == "/projects with spaces/elisa-engine/build/navigation smoke-test"
    assert plan.commands.count == 4
    assert plan.commands[0].kind == CommandKind.CompileNavigationService
    assert plan.commands[0].program == "clang++"
    assert plan.commands[0].arguments.count == 12
    assert plan.commands[0].arguments[6] == "/projects with spaces/elisa-engine/dependencies/recast/Recast/Include"
    assert plan.commands[0].arguments[8] == "/projects with spaces/elisa-engine/dependencies/recast/Detour/Include"
    assert plan.commands[0].arguments[10] == "/projects with spaces/elisa-engine/build/navigation_service_abi.o"
    assert plan.commands[0].arguments[11] == "/projects with spaces/elisa-engine/native/navigation_service_abi.cpp"
    assert plan.commands[1].kind == CommandKind.CompileCppFallbacks
    assert plan.commands[1].arguments[4] == "/projects with spaces/elisa-engine/build/elisa_native_fallbacks.o"
    assert plan.commands[2].kind == CommandKind.CompileElisaTest
    assert plan.commands[2].program == "/tools/Elisa Compiler/elisac"
    assert plan.commands[2].arguments[3] == "/projects with spaces/elisa-engine/build/navigation smoke.o"
    assert plan.commands[2].arguments[4] == "/projects with spaces/elisa-engine/test/navigation smoke.elisa"
    assert plan.commands[3].kind == CommandKind.LinkNativeTest
    assert plan.commands[3].program == "clang++"
    assert plan.commands[3].arguments[1] == "/projects with spaces/elisa-engine/build/navigation smoke-test"
    assert plan.commands[3].arguments[5] == "/runtime objects/runtime.o"
    assert plan.commands[3].arguments[6] == "/projects with spaces/elisa-engine/dependencies/recast/build/Recast/libRecast.a"
    assert plan.commands[3].arguments[7] == "/projects with spaces/elisa-engine/dependencies/recast/build/Detour/libDetour.a"


@test
def defaults_the_stage_one_compiler_and_preserves_root_paths() -> void can[Memory.Allocate, Abort.Panic]:
    plan: mutable Plan = Plan{}
    catch EsEngineNavNativeTestBuildPlan::plan("/", "smoke", "", "/runtime.o"):
        ok value:
            plan <- value
        error failure:
            _ = failure
            assert false
    assert plan.build_directory == "/build"
    assert plan.commands[2].program == "elisac-stage1"
    assert plan.commands[2].arguments[4] == "/test/smoke.elisa"
    assert plan.commands[3].arguments[1] == "/build/smoke-test"


@test
def rejects_missing_test_name_or_runtime_object() -> void can[Memory.Allocate, Abort.Panic]:
    missing_name: mutable bool = false
    catch EsEngineNavNativeTestBuildPlan::plan("/engine", "", "", "/runtime.o"):
        ok value:
            _ = value
        error failure:
            missing_name <- failure == PlanError.MissingTestName
    assert missing_name

    missing_runtime: mutable bool = false
    catch EsEngineNavNativeTestBuildPlan::plan("/engine", "smoke", "", ""):
        ok value:
            _ = value
        error failure:
            missing_runtime <- failure == PlanError.MissingRuntimeObject
    assert missing_runtime


@test
def command_state_machine_stops_at_the_first_failure() -> void can[Memory.Allocate, Abort.Panic]:
    state: mutable ExecutionState = initial_execution(4)
    state <- try execution_after_prepare(state, true) else state
    state <- try execution_after_command(state, 0) else state
    assert state.phase == ExecutionPhase.Execute and state.next_command == 1
    state <- try execution_after_command(state, 37) else state
    assert state.phase == ExecutionPhase.Done
    assert state.next_command == 1
    assert state.exit_status == 37


@test
def report_waits_for_all_four_commands_and_rejects_extra_receipts() -> void can[Memory.Allocate, Abort.Panic]:
    state: mutable ExecutionState = initial_execution(4)
    state <- try execution_after_prepare(state, true) else state
    for _ in 0..<4 |state|:
        assert state.phase == ExecutionPhase.Execute
        state <- try execution_after_command(state, 0) else state
    assert state.phase == ExecutionPhase.Report
    state <- try execution_after_report(state) else state
    assert state.phase == ExecutionPhase.Done and state.exit_status == 0

    rejected: mutable bool = false
    catch execution_after_command(state, 0):
        ok unexpected:
            _ = unexpected
        error failure:
            rejected <- failure == PlanError.InvalidExecutionState
    assert rejected
