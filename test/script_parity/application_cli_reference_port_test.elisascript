# Verify the colocated ElisaScript translation byte-for-byte against the
# independent Python reference's checked-in golden output.
include "../fixtures/script_parity/application_cli/reference_core.elisa"


module EsApplicationCliReferencePortTest:
    private:
        const module Golden:
            EXPECTED_BYTES: usize = 2165
            OUTPUT: sview = "case=attached-and-passthrough\nstatus=0\nstdout-begin\ncommand=build\njobs=8\nverbose=true\npositional=src\npositional=--literal\npositional=\nstdout-end\nstderr-begin\nstderr-end\ncase=separated-short-value\nstatus=0\nstdout-begin\ncommand=build\njobs=9\nverbose=false\nstdout-end\nstderr-begin\nstderr-end\ncase=equals-short-value\nstatus=0\nstdout-begin\ncommand=build\njobs=4\nverbose=false\nstdout-end\nstderr-begin\nstderr-end\ncase=short-option-bundle\nstatus=0\nstdout-begin\ncommand=build\njobs=8\nverbose=true\npositional=target\nstdout-end\nstderr-begin\nstderr-end\ncase=negative-boolean\nstatus=0\nstdout-begin\ncommand=test\nverbose=false\npositional=suite\nstdout-end\nstderr-begin\nstderr-end\ncase=root-help\nstatus=0\nstdout-begin\nUsage: app <COMMAND> [OPTIONS] [ARGS...]\n\nCommands:\n  build\tBuild artifacts\n  test\tRun tests\n\nOptions:\n  -h, --help\tShow this help\nstdout-end\nstderr-begin\nstderr-end\ncase=command-help\nstatus=0\nstdout-begin\nUsage: app build [OPTIONS] [ARGS...]\n\nBuild artifacts\n\nOptions:\n  --jobs, -j <VALUE>\tWorker count\n  --verbose, -v, --no-verbose\tShow verbose output\n  -h, --help\tShow this help\nstdout-end\nstderr-begin\nstderr-end\ncase=empty-value-over-default\nstatus=0\nstdout-begin\ncommand=build\njobs=\nverbose=false\nstdout-end\nstderr-begin\nstderr-end\ncase=build-defaults\nstatus=0\nstdout-begin\ncommand=build\njobs=2\nverbose=false\nstdout-end\nstderr-begin\nstderr-end\ncase=test-defaults\nstatus=0\nstdout-begin\ncommand=test\nverbose=false\nstdout-end\nstderr-begin\nstderr-end\ncase=missing-command\nstatus=2\nstdout-begin\nstdout-end\nstderr-begin\nerror=missing-command\nstderr-end\ncase=unknown-command\nstatus=2\nstdout-begin\nstdout-end\nstderr-begin\nerror=unknown-command\nstderr-end\ncase=unknown-option\nstatus=2\nstdout-begin\nstdout-end\nstderr-begin\nerror=unknown-option\nstderr-end\ncase=missing-value\nstatus=2\nstdout-begin\nstdout-end\nstderr-begin\nerror=missing-value\nstderr-end\ncase=duplicate-option\nstatus=2\nstdout-begin\nstdout-end\nstderr-begin\nerror=duplicate-option\nstderr-end\ncase=duplicate-short-bundle\nstatus=2\nstdout-begin\nstdout-end\nstderr-begin\nerror=duplicate-option\nstderr-end\ncase=unexpected-boolean-value\nstatus=2\nstdout-begin\nstdout-end\nstderr-begin\nerror=unexpected-value\nstderr-end\n"


    public:
        def output_matches(actual: darray[u8]) -> bool:
            return false if actual.count != Golden::EXPECTED_BYTES
            for index in 0..<Golden::EXPECTED_BYTES |actual|:
                return false if actual[index] != Golden::OUTPUT[index]
            return true


@test
def application_cli_reference_port_matches_independent_python_golden() -> void:
    can Memory.Allocate, Abort.Panic:
        actual: darray[u8] = EsApplicationCliReferencePort::batch_output()
        assert EsApplicationCliReferencePortTest::output_matches(actual)
