include "../../ports/elisa-engine/scripts/temp_directory.elisa"

using EsEngineTempDirectory


@test
def candidates_follow_environment_then_platform_then_current_directory_order() -> void can[Memory.Allocate, Abort.Panic]:
    parents: darray[sview] = candidate_parents("/env/tmpdir", "", "/env/tmp", "/work/checkout")
    assert parents.count == 6
    assert parents[0] == "/env/tmpdir"
    assert parents[1] == "/env/tmp"
    assert parents[2] == "/tmp"
    assert parents[3] == "/var/tmp"
    assert parents[4] == "/usr/tmp"
    assert parents[5] == "/work/checkout"


@test
def empty_environment_values_are_skipped_but_duplicate_paths_keep_precedence() -> void can[Memory.Allocate, Abort.Panic]:
    parents: darray[sview] = candidate_parents("", "\0", "/tmp", "/repo")
    assert parents.count == 5
    assert parents[0] == "/tmp"
    assert parents[1] == "/tmp"
    assert parents[2] == "/var/tmp"
    assert parents[3] == "/usr/tmp"
    assert parents[4] == "/repo"


@test
def no_environment_or_current_directory_keeps_all_platform_defaults() -> void can[Memory.Allocate, Abort.Panic]:
    parents: darray[sview] = candidate_parents("\0", "", "\0", "\0")
    assert parents == ["/tmp", "/var/tmp", "/usr/tmp"]
