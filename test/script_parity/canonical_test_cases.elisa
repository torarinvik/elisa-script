# Independent ordinary argv/status expectations for the small test wrappers.
# No candidate, process runner, host bridge or execution authorization import.
include "canonical_lint_cases.elisa"

module EsCanonicalTestCases:
    private:
        using EsCanonicalLintCases

    public:
        const module Fixture:
            CASES: usize = 10
            USAGE_CASES: usize = 2
            INVALID_MODE: sview = "not-a-mode"
            MISSING_PYTHON: sview = "tools/must-not-run-python"


        def ordinary() -> darray[EsCanonicalLintCases::Case] can[Memory.Allocate, Abort.Panic]:
            return [
                Case{reference: "test_canonical.sh", candidate: "test_canonical.elisascript", variable: "PYTHON_BIN", selection: Selection.Unset, arguments: [], expected_argv: ["-m", "pytest", "-q", "-m", "not campaign"], status: 0},
                Case{reference: "test_canonical.sh", candidate: "test_canonical.elisascript", variable: "PYTHON_BIN", selection: Selection.Empty, arguments: ["", "-k", "one or two"], expected_argv: ["-m", "pytest", "-q", "-m", "not campaign", "-k", "one or two"], status: 23},
                Case{reference: "test_canonical.sh", candidate: "test_canonical.elisascript", variable: "PYTHON_BIN", selection: Selection.Relative, arguments: ["fast", "", "a b", "*.py", "$HOME", "--"], expected_argv: ["-m", "pytest", "-q", "-m", "not campaign", "", "a b", "*.py", "$HOME", "--"], status: 1},
                Case{reference: "test_canonical.sh", candidate: "test_canonical.elisascript", variable: "PYTHON_BIN", selection: Selection.Absolute, arguments: ["campaign", "-m", "custom"], expected_argv: ["-m", "pytest", "-q", "-m", "campaign", "-m", "custom"], status: 2},
                Case{reference: "test_canonical.sh", candidate: "test_canonical.elisascript", variable: "PYTHON_BIN", selection: Selection.Absolute, arguments: ["all", "--maxfail=1"], expected_argv: ["-m", "pytest", "-q", "--maxfail=1"], status: 23},
                Case{reference: "test_campaign.sh", candidate: "test_campaign.elisascript", variable: "PYTHON_BIN", selection: Selection.Absolute, arguments: ["all", "", "-m", "custom"], expected_argv: ["-m", "pytest", "-q", "-m", "campaign", "all", "", "-m", "custom"], status: 0},
                Case{reference: "test_campaign.sh", candidate: "test_campaign.elisascript", variable: "PYTHON_BIN", selection: Selection.Unset, arguments: [], expected_argv: ["-m", "pytest", "-q", "-m", "campaign"], status: 0},
                Case{reference: "test_campaign.sh", candidate: "test_campaign.elisascript", variable: "PYTHON_BIN", selection: Selection.Empty, arguments: ["", "fast", "line\r\nbreak", "\xc3\xa9"], expected_argv: ["-m", "pytest", "-q", "-m", "campaign", "", "fast", "line\r\nbreak", "\xc3\xa9"], status: 255},
                Case{reference: "test_canonical.sh", candidate: "test_canonical.elisascript", variable: "PYTHON_BIN", selection: Selection.LiteralRelative, arguments: ["all", "", "$HOME; '*.py'", "--", "campaign"], expected_argv: ["-m", "pytest", "-q", "", "$HOME; '*.py'", "--", "campaign"], status: 126},
                Case{reference: "test_canonical.sh", candidate: "test_canonical.elisascript", variable: "PYTHON_BIN", selection: Selection.LiteralPathName, arguments: ["campaign", "-m", "not campaign", "line\nbreak", "\xc3\xa9"], expected_argv: ["-m", "pytest", "-q", "-m", "campaign", "-m", "not campaign", "line\nbreak", "\xc3\xa9"], status: 127}
            ]


        struct UsageCase:
            reference_invocation: sview
            candidate_invocation: sview
            invalid_mode: sview
            python_bin: sview
            expected_reference_stderr: sview
            expected_candidate_stderr: sview
            status: i64


        def invalid_mode_usage() -> darray[UsageCase] can[Memory.Allocate, Abort.Panic]:
            return [
                UsageCase{
                    reference_invocation: "./scripts/test_canonical.sh",
                    candidate_invocation: "./scripts/test_canonical.elisascript",
                    invalid_mode: Fixture::INVALID_MODE,
                    python_bin: Fixture::MISSING_PYTHON,
                    expected_reference_stderr: "usage: ./scripts/test_canonical.sh [fast|campaign|all]\n",
                    expected_candidate_stderr: "usage: ./scripts/test_canonical.elisascript [fast|campaign|all]\n",
                    status: 2
                },
                UsageCase{
                    reference_invocation: "scripts/test_canonical.sh",
                    candidate_invocation: "scripts/test_canonical.elisascript",
                    invalid_mode: Fixture::INVALID_MODE,
                    python_bin: Fixture::MISSING_PYTHON,
                    expected_reference_stderr: "usage: scripts/test_canonical.sh [fast|campaign|all]\n",
                    expected_candidate_stderr: "usage: scripts/test_canonical.elisascript [fast|campaign|all]\n",
                    status: 2
                }
            ]
