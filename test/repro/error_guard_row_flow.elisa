include "../../src/ir/execution.elisa"
using EsIr
def missing_errors(module: Module&) -> usize can[Memory.Allocate, Abort.Panic]:
    issues: darray[Issue] = verify(module)
    for item in issues |count: usize = 0| -> count:
        count += 1 if item.kind == IssueKind.MissingError

def guard_module(filtered: bool, pop_first: bool, fallback_raises: bool) -> Module can[Memory.Allocate, Abort.Panic]:
    v: Type = Type{kind: TypeKind.Void}
    push: Instruction = Instruction{result: 0, span: SourceSpan{file: "guard.elisascript", line: 1, column: 1, end_line: 1, end_column: 2}, opcode: Opcode.ErrorGuardPush, result_type: v, integer: 2, effect_family: "OtherError" if filtered else "", effect_operation: "Bad" if filtered else ""}
    pop: Instruction = Instruction{result: 0, span: SourceSpan{file: "guard.elisascript", line: 1, column: 1, end_line: 1, end_column: 2}, opcode: Opcode.ErrorGuardPop, result_type: v}
    raised: Instruction = Instruction{result: 0, span: SourceSpan{file: "guard.elisascript", line: 1, column: 1, end_line: 1, end_column: 2}, opcode: Opcode.Raise, result_type: v, effect_family: "UserError", effect_operation: "Bad"}
    instructions: darray[Instruction] = [push, pop, raised] if pop_first else [push, raised, pop]
    fallback: darray[Instruction] = [raised] if fallback_raises else []
    pool: mutable darray[Instruction] = instructions
    for instruction in fallback |pool|:
        pool.push(instruction)
    done: Terminator = Terminator{span: SourceSpan{file: "guard.elisascript", line: 1, column: 1, end_line: 1, end_column: 2}, kind: TerminatorKind.Return}
    fn: Function = Function{name: "guarded", parameters: [], effects: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], return_type: v, instruction_pool: pool, blocks: [Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 3, terminator: done}, Block{id: 2, parameter_start: 0, parameter_count: 0, instruction_start: 3, instruction_count: fallback.count.u32(), terminator: done}], entry: 1}
    Module{name: "guard-row", functions: [fn]}

def cross_block_module(mismatched_join: bool) -> Module can[Memory.Allocate, Abort.Panic]:
    module: mutable Module = guard_module(false, false, false)
    fn: mutable Function = module.functions[0]
    position: SourceSpan = fn.instruction_pool[0].span
    # Physical order is recovery, guarded successor, then entry.
    guarded: Block = Block{id: 3, parameter_start: 0, parameter_count: 0, instruction_start: 1, instruction_count: 2, terminator: Terminator{kind: TerminatorKind.Return, span: position}}
    entry: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: Terminator{kind: TerminatorKind.Jump, target0: 3, target_count: 1, span: position}}
    parameters: mutable darray[Parameter] = []
    parameters.push(Parameter{value: 1, type: Type{kind: TypeKind.Bool}, name: "condition"}) if mismatched_join
    branch: Terminator = Terminator{kind: TerminatorKind.Branch, operand: 1, operand_count: 1, target0: 3, target1: 2, target_count: 2, span: position} if mismatched_join else entry.terminator
    entry_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: branch}
    fn <- Function{name: "crossing", parameters: parameters, effects: [], return_type: fn.return_type, operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: fn.instruction_pool, blocks: [fn.blocks[1], guarded, entry_block], entry: 1}
    module.functions[0] <- fn
    module

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    covered: Module = guard_module(false, false, false)
    return 1 if verify(covered).count != 0
    filtered: Module = guard_module(true, false, false)
    return 2 if missing_errors(filtered) != 1
    popped: Module = guard_module(false, true, false)
    return 3 if missing_errors(popped) != 1
    fallback: Module = guard_module(false, false, true)
    return 4 if missing_errors(fallback) != 1
    crossing: Module = cross_block_module(false)
    crossing_issues: darray[Issue] = verify(crossing)
    return 5 if crossing_issues.count != 0
    mismatch: Module = cross_block_module(true)
    return 6 if not any item in verify(mismatch) where item.kind == IssueKind.UnbalancedHandler
    malformed: mutable Module = guard_module(false, true, false)
    malformed.functions[0].instruction_pool[0] <- malformed.functions[0].instruction_pool[1]
    return 7 if not any item in verify(malformed) where item.kind == IssueKind.InvalidInstruction
    0
