# This fixture checks the typed exec-failure payload independently of process
# replacement. Real execvp failures require a bounded standalone child harness.
include "../../src/runtime/process_errors.elisascript"


module EsProcessReplaceErrorContract:
    private:
        def raise_exec_failure(errno: i64, executable: sview) -> void error[ProcessError]:
            raise ProcessError.ExecFailure(errno, executable)


    public:
        @test
        def exec_failure_retains_errno_and_requested_executable() -> void:
            catch raise_exec_failure(13i64, "ruff with spaces"):
                ok _:
                    assert false
                ProcessError.ExecFailure(errno, executable):
                    assert errno == 13i64
                    assert executable == "ruff with spaces"

        # Successful replacement and returned exec failures are qualified only
        # by an external standalone child-process harness. Calling the opcode
        # from this in-process test runner must never replace its host process.
