include "../../src/testing/geometry_subset_hierarchy_cases.elisa"

using EsGeometrySubsetHierarchyCases


@test
def hierarchy_metadata_cases_preserve_order_and_little_endian_record_offsets() -> void can[Memory.Allocate, Abort.Panic]:
    hierarchy_package: sview = "header=keep\r\nmesh_placement_stride=80\r\nmesh_count=3\r\nmesh_placements_b64=AAECAwQFBgcICQoLDA0ODxAREhMUFRYX\r\ntail=keep\r\n"
    generated: darray[Case] = try EsGeometrySubsetHierarchyCases::cases(hierarchy_package)
    assert generated.count == 4
    assert generated[0].file_name == "hierarchy-mesh-stride.pkg"
    assert generated[0].expected_diagnostic == "mesh placement metadata"
    assert bytes_view(generated[0].package_bytes) == "header=keep\r\nmesh_placement_stride=72\r\nmesh_count=3\r\nmesh_placements_b64=AAECAwQFBgcICQoLDA0ODxAREhMUFRYX\r\ntail=keep\r\n"
    assert generated[1].file_name == "hierarchy-mesh-count.pkg"
    assert generated[1].expected_diagnostic == "leaves a mesh unplaced"
    assert bytes_view(generated[1].package_bytes).contains("mesh_count=4\r\n")
    assert generated[2].file_name == "hierarchy-placement-range.pkg"
    assert generated[2].expected_diagnostic == "index is out of range"
    assert bytes_view(generated[2].package_bytes).contains("mesh_placements_b64=AAECAwQFBgcICQoLAAAAABAREhMUFRYX\ntail=keep\r\n")
    assert generated[3].file_name == "hierarchy-placement-partition.pkg"
    assert generated[3].expected_diagnostic == "do not partition the streams"
    assert bytes_view(generated[3].package_bytes).contains("mesh_placements_b64=AAECAwQFBgcICQoLDA0ODwYAAAUFRYX\ntail=keep\r\n")


@test
def hierarchy_mutations_report_missing_encoding_and_record_bounds() -> void can[Memory.Allocate, Abort.Panic]:
    missing_field: mutable bool = false
    catch EsGeometrySubsetHierarchyCases::cases("mesh_placement_stride=80\n"):
        ok cases:
            _ = cases
        error failure:
            missing_field <- failure == HierarchyCasesError.MissingExpectedField
    assert missing_field

    invalid_encoding: mutable bool = false
    catch EsGeometrySubsetHierarchyCases::cases("mesh_placement_stride=80\nmesh_count=3\nmesh_placements_b64=not-base64\n"):
        ok cases:
            _ = cases
        error failure:
            invalid_encoding <- failure == HierarchyCasesError.InvalidPlacementEncoding
    assert invalid_encoding

    short_record: mutable bool = false
    catch EsGeometrySubsetHierarchyCases::cases("mesh_placement_stride=80\nmesh_count=3\nmesh_placements_b64=AQ==\n"):
        ok cases:
            _ = cases
        error failure:
            short_record <- failure == HierarchyCasesError.PlacementRecordTooShort
    assert short_record
