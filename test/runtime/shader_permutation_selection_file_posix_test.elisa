include "../../src/runtime/encoding.elisa"
include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../src/runtime/json_lexer_model.elisa"
include "../../src/runtime/json_parse_model.elisa"
include "../../src/runtime/bounded_text_posix.elisa"
include "../../src/runtime/shader_permutation_selection_model.elisa"
include "../../src/runtime/shader_permutation_selection_posix.elisa"

using EsShaderPermutationSelection
using EsShaderPermutationSelectionPosix


@test
def shader_selection_file_reads_bounded_utf8_and_keeps_document_owned_names() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        selection: Selection = read_shader_selection_file(path("test/runtime/shader_permutation_selection_fixture.json"))
        assert not selection.select_all
        assert selection.names.count == 2
        assert selection.names[0] == "sub/a.cso" and selection.names[1] == "z.cso"
        available: darray[sview] = ["z.cso", "sub/a.cso"]
        resolution: Resolution = resolve_shader_permutations(selection, available)
        assert resolution.indices.count == 2
        assert resolution.indices[0] == 1 and resolution.indices[1] == 0


@test
def shader_selection_missing_option_does_not_read_a_path() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        selection: Selection = read_optional_shader_selection(false, path("test/runtime/does-not-exist.json"))
        assert selection.select_all and selection.names.count == 0


@test
def shader_selection_path_adapter_matches_python_order_and_last_path_wins() -> void:
    can Memory.Allocate, Abort.Panic:
        root: Path = path("/shader/root")
        binaries: darray[Path] = [
            root.joinpath("z.cso"),
            root.joinpath("sub/a.cso"),
            root.joinpath("z.cso")
        ]
        selected: Selection = parse_selection_json("[\"z.cso\",\"sub/a.cso\"]")
        result: ShaderBinaryPaths = select_shader_binary_paths(root, binaries, selected)
        assert result.paths.count == 2 and result.missing.count == 0
        assert f"{result.paths[0]}" == "/shader/root/sub/a.cso"
        # Python builds {relative_name: path} in input order, so the last
        # duplicate path is the selected value.
        assert f"{result.paths[1]}" == "/shader/root/z.cso"


@test
def shader_selection_path_adapter_preserves_default_and_empty_orders() -> void:
    can Memory.Allocate, Abort.Panic:
        root: Path = path("/shader/root")
        binaries: darray[Path] = [root.joinpath("z.cso"), root.joinpath("a.cso"), path("/outside/unrelated.cso")]
        all_paths: ShaderBinaryPaths = select_shader_binary_paths(root, binaries, all_shader_permutations())
        assert all_paths.paths.count == 3
        assert f"{all_paths.paths[0]}" == "/shader/root/z.cso"
        assert f"{all_paths.paths[1]}" == "/shader/root/a.cso"
        assert f"{all_paths.paths[2]}" == "/outside/unrelated.cso"

        empty: Selection = Selection{select_all: false}
        empty_paths: ShaderBinaryPaths = select_shader_binary_paths(root, binaries, empty)
        assert empty_paths.paths.count == 0 and empty_paths.missing.count == 0

        missing: Selection = Selection{select_all: false, names: ["missing-z.cso", "missing-a.cso"]}
        missing_paths: ShaderBinaryPaths = select_shader_binary_paths(root, binaries, missing)
        assert missing_paths.paths.count == 0 and missing_paths.missing.count == 2
        assert missing_paths.missing[0] == "missing-a.cso" and missing_paths.missing[1] == "missing-z.cso"


@test
def shader_selection_path_adapter_normalizes_arbitrary_name_sets_like_python() -> void:
    can Memory.Allocate, Abort.Panic:
        root: Path = path("/shader/root")
        binaries: darray[Path] = [root.joinpath("a.cso"), root.joinpath("z.cso")]
        arbitrary_set: Selection = Selection{select_all: false, names: ["z.cso", "a.cso", "z.cso"]}
        result: ShaderBinaryPaths = select_shader_binary_paths(root, binaries, arbitrary_set)
        assert result.paths.count == 2 and result.missing.count == 0
        assert f"{result.paths[0]}" == "/shader/root/a.cso"
        assert f"{result.paths[1]}" == "/shader/root/z.cso"


@test
def shader_selection_path_adapter_rejects_binary_paths_outside_root() -> void:
    can Memory.Allocate, Abort.Panic:
        root: Path = path("/shader/root")
        selection: Selection = parse_selection_json("[\"a.cso\"]")
        rejected: mutable bool = false
        catch select_shader_binary_paths(root, [path("/other/a.cso")], selection):
            ok selected:
                _ = selected
            error failure:
                rejected <- failure == BinarySelectionError.BinaryOutsideRoot
        assert rejected


@test
def shader_selection_path_adapter_rejects_sibling_prefix_as_outside_root() -> void:
    can Memory.Allocate, Abort.Panic:
        root: Path = path("/shader/root")
        selection: Selection = parse_selection_json("[\"a.cso\"]")
        rejected: mutable bool = false
        catch select_shader_binary_paths(root, [path("/shader/rooted/a.cso")], selection):
            ok selected:
                _ = selected
            error failure:
                rejected <- failure == BinarySelectionError.BinaryOutsideRoot
        assert rejected


@test
def shader_selection_path_adapter_uses_lexical_component_prefixes() -> void:
    can Memory.Allocate, Abort.Panic:
        root: Path = path("shader/root")
        selection: Selection = parse_selection_json("[\"a.cso\"]")
        binaries: darray[Path] = [path("shader/root/./a.cso")]
        result: ShaderBinaryPaths = select_shader_binary_paths(root, binaries, selection)
        assert result.paths.count == 1
