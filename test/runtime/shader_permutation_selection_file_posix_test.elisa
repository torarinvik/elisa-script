include "../../src/runtime/encoding.elisa"
include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../src/runtime/json_lexer_model.elisa"
include "../../src/runtime/json_parse_model.elisa"
include "../../src/runtime/bounded_text_posix.elisa"
include "../../src/runtime/shader_permutation_selection_model.elisa"
include "../../src/runtime/shader_permutation_selection_posix.elisa"

using EsShaderPermutationSelection
using EsShaderPermutationSelectionPosix


@test
def shader_selection_file_reads_bounded_utf8_and_keeps_document_owned_names() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        selection: Selection = read_shader_selection_file(path("test/runtime/shader_permutation_selection_fixture.json"))
        assert not selection.select_all
        assert selection.names.count == 2
        assert selection.names[0] == "sub/a.cso" and selection.names[1] == "z.cso"
        available: darray[sview] = ["z.cso", "sub/a.cso"]
        resolution: Resolution = resolve_shader_permutations(selection, available)
        assert resolution.indices.count == 2
        assert resolution.indices[0] == 1 and resolution.indices[1] == 0


@test
def shader_selection_missing_option_does_not_read_a_path() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        selection: Selection = read_optional_shader_selection(false, path("test/runtime/does-not-exist.json"))
        assert selection.select_all and selection.names.count == 0
