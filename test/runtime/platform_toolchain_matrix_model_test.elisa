include "../../src/runtime/encoding.elisa"
include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../src/runtime/json_lexer_model.elisa"
include "../../src/runtime/json_parse_model.elisa"
include "../../src/runtime/platform_toolchain_matrix_model.elisa"

using EsPlatformToolchainMatrix


const module PlatformToolchainMatrixInputs:
    VALID: sview = "{\"schema\":\"wasmbrowser.platform-toolchain-matrix/v1\",\"targets\":[{\"target\":\"aarch64-apple-darwin\",\"build\":\"verified\",\"run\":\"verified\",\"device\":\"developer-host-only\",\"physical_device_validation\":\"not_run\",\"legal_distribution\":\"not_evaluated\",\"extra\":[1,true,null]}]}"


def platform_toolchain_matrix_rejects_as(source: sview, expected: PlatformToolchainMatrixError) -> bool can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch validate_platform_toolchain_matrix_source(source):
        ok count:
            _ = count
        error failure:
            rejected <- failure == expected
    return rejected


@test
def platform_toolchain_matrix_accepts_required_strings_and_unknown_fields() -> void can[Memory.Allocate, Abort.Panic]:
    count: usize = validate_platform_toolchain_matrix_source(PlatformToolchainMatrixInputs::VALID)
    assert count == 1


@test
def platform_toolchain_matrix_uses_last_duplicate_schema_and_field_values() -> void can[Memory.Allocate, Abort.Panic]:
    duplicate_schema: sview = replace(PlatformToolchainMatrixInputs::VALID, "\"schema\":\"wasmbrowser.platform-toolchain-matrix/v1\"", "\"schema\":\"old\",\"schema\":\"wasmbrowser.platform-toolchain-matrix/v1\"")
    duplicate_build: sview = replace(PlatformToolchainMatrixInputs::VALID, "\"build\":\"verified\"", "\"build\":false,\"build\":\"verified\"")
    assert validate_platform_toolchain_matrix_source(duplicate_schema) == 1
    assert validate_platform_toolchain_matrix_source(duplicate_build) == 1


@test
def platform_toolchain_matrix_rejects_duplicate_targets_and_missing_fields() -> void can[Memory.Allocate, Abort.Panic]:
    duplicate_target: sview = "{\"schema\":\"wasmbrowser.platform-toolchain-matrix/v1\",\"targets\":[{\"target\":\"same\",\"build\":\"ok\",\"run\":\"ok\",\"device\":\"ok\",\"physical_device_validation\":\"ok\",\"legal_distribution\":\"ok\"},{\"target\":\"same\",\"build\":\"ok\",\"run\":\"ok\",\"device\":\"ok\",\"physical_device_validation\":\"ok\",\"legal_distribution\":\"ok\"}]}"
    missing_field: sview = "{\"schema\":\"wasmbrowser.platform-toolchain-matrix/v1\",\"targets\":[{\"target\":\"one\",\"build\":\"ok\",\"run\":\"ok\",\"device\":\"ok\",\"physical_device_validation\":\"ok\"}]}"
    assert platform_toolchain_matrix_rejects_as(duplicate_target, PlatformToolchainMatrixError.DuplicateTarget)
    assert platform_toolchain_matrix_rejects_as(missing_field, PlatformToolchainMatrixError.MissingRequiredField)


@test
def platform_toolchain_matrix_rejects_bad_schema_target_and_string_types() -> void can[Memory.Allocate, Abort.Panic]:
    bad_schema: sview = replace(PlatformToolchainMatrixInputs::VALID, "wasmbrowser.platform-toolchain-matrix/v1", "other")
    bad_target: sview = replace(PlatformToolchainMatrixInputs::VALID, "aarch64-apple-darwin", "17")
    bad_build: sview = replace(PlatformToolchainMatrixInputs::VALID, "\"build\":\"verified\"", "\"build\":false")
    empty_targets: sview = "{\"schema\":\"wasmbrowser.platform-toolchain-matrix/v1\",\"targets\":[]}"
    assert platform_toolchain_matrix_rejects_as("[", PlatformToolchainMatrixError.InvalidJson)
    assert platform_toolchain_matrix_rejects_as("[]", PlatformToolchainMatrixError.InvalidRoot)
    assert platform_toolchain_matrix_rejects_as(bad_schema, PlatformToolchainMatrixError.SchemaMismatch)
    assert platform_toolchain_matrix_rejects_as(bad_target, PlatformToolchainMatrixError.InvalidTarget)
    assert platform_toolchain_matrix_rejects_as(bad_build, PlatformToolchainMatrixError.InvalidFieldType)
    assert platform_toolchain_matrix_rejects_as(empty_targets, PlatformToolchainMatrixError.InvalidTargets)
