include "../../src/runtime/build_usage_model.elisa"

using EsBuildUsage


@test
def build_usage_public_private_interface_and_static_link_only_propagation() -> void:
    can Memory.Allocate, Abort.Panic:
        interface: BuildUsageTarget = BuildUsageTarget{
            name: "api",
            kind: BuildUsageTargetKind.InterfaceLibrary,
            requirements: [
                BuildUsageRequirement{kind: BuildUsageKind.IncludeDirectory, visibility: BuildUsageVisibility.Interface, value: "include/api"},
                BuildUsageRequirement{kind: BuildUsageKind.CompileDefinition, visibility: BuildUsageVisibility.Interface, value: "API_LEVEL=3"},
                BuildUsageRequirement{kind: BuildUsageKind.LinkLibrary, visibility: BuildUsageVisibility.Interface, value: "m"},
                BuildUsageRequirement{kind: BuildUsageKind.LinkOption, visibility: BuildUsageVisibility.Interface, value: "-Wl,--as-needed"}
            ]
        }
        core: BuildUsageTarget = BuildUsageTarget{
            name: "core",
            kind: BuildUsageTargetKind.StaticLibrary,
            dependencies: [BuildUsageDependency{target_index: 0, visibility: BuildUsageVisibility.Public}],
            requirements: [
                BuildUsageRequirement{kind: BuildUsageKind.CompileDefinition, visibility: BuildUsageVisibility.Private, value: "CORE_INTERNAL=1"},
                BuildUsageRequirement{kind: BuildUsageKind.IncludeDirectory, visibility: BuildUsageVisibility.Private, value: "include/internal"},
                BuildUsageRequirement{kind: BuildUsageKind.CompileOption, visibility: BuildUsageVisibility.Public, value: "-fvisibility=hidden"},
                BuildUsageRequirement{kind: BuildUsageKind.LinkLibrary, visibility: BuildUsageVisibility.Private, value: "z"}
            ]
        }
        app: BuildUsageTarget = BuildUsageTarget{
            name: "app",
            kind: BuildUsageTargetKind.Executable,
            dependencies: [BuildUsageDependency{target_index: 1, visibility: BuildUsageVisibility.Public}]
        }
        resolution: BuildUsageResolution = resolve_build_usage([interface, core, app])
        assert resolution.targets.count == 3

        core_usage: BuildUsageTargetResult = resolution.targets[1]
        assert core_usage.compile.count == 5
        assert core_usage.compile[0].value == "CORE_INTERNAL=1"
        assert core_usage.compile[1].value == "include/internal"
        assert core_usage.compile[2].value == "-fvisibility=hidden"
        assert core_usage.compile[3].value == "include/api"
        assert core_usage.compile[4].value == "API_LEVEL=3"
        assert core_usage.link.count == 3
        assert core_usage.link[0].value == "z" and not core_usage.link[0].link_only
        assert core_usage.link[1].value == "m" and not core_usage.link[1].link_only
        assert core_usage.link[2].value == "-Wl,--as-needed" and not core_usage.link[2].link_only
        assert core_usage.exported_compile.count == 3
        assert core_usage.exported_compile[0].value == "-fvisibility=hidden"
        assert core_usage.exported_compile[1].value == "include/api"
        assert core_usage.exported_compile[2].value == "API_LEVEL=3"
        assert core_usage.exported_link.count == 3
        assert core_usage.exported_link[0].value == "z" and core_usage.exported_link[0].link_only
        assert core_usage.exported_link[1].value == "m" and not core_usage.exported_link[1].link_only
        assert core_usage.exported_link[2].value == "-Wl,--as-needed" and not core_usage.exported_link[2].link_only

        app_usage: BuildUsageTargetResult = resolution.targets[2]
        assert app_usage.compile.count == 3
        assert app_usage.compile[0].value == "-fvisibility=hidden"
        assert app_usage.compile[1].value == "include/api"
        assert app_usage.compile[2].value == "API_LEVEL=3"
        assert app_usage.link.count == 4
        assert app_usage.link[0].kind == BuildUsageKind.LinkLibrary and app_usage.link[0].value == "core" and not app_usage.link[0].link_only
        assert app_usage.link[1].value == "z" and not app_usage.link[1].link_only
        assert app_usage.link[2].value == "m" and not app_usage.link[2].link_only
        assert app_usage.link[3].value == "-Wl,--as-needed" and not app_usage.link[3].link_only
        assert app_usage.compile[0].value != "include/internal"
        assert not app_usage.compile[0].value.startswith("CORE_INTERNAL")


@test
def build_usage_shared_dependency_contributes_its_artifact() -> void:
    can Memory.Allocate, Abort.Panic:
        shared: BuildUsageTarget = BuildUsageTarget{name: "shared", kind: BuildUsageTargetKind.SharedLibrary}
        private_consumer: BuildUsageTarget = BuildUsageTarget{
            name: "private-consumer",
            kind: BuildUsageTargetKind.Executable,
            dependencies: [BuildUsageDependency{target_index: 0, visibility: BuildUsageVisibility.Private}]
        }
        wrapper: BuildUsageTarget = BuildUsageTarget{
            name: "wrapper",
            kind: BuildUsageTargetKind.StaticLibrary,
            dependencies: [BuildUsageDependency{target_index: 0, visibility: BuildUsageVisibility.Public}]
        }
        app: BuildUsageTarget = BuildUsageTarget{
            name: "app",
            kind: BuildUsageTargetKind.Executable,
            dependencies: [BuildUsageDependency{target_index: 2, visibility: BuildUsageVisibility.Private}]
        }
        resolution: BuildUsageResolution = resolve_build_usage([shared, private_consumer, wrapper, app])

        shared_usage: BuildUsageTargetResult = resolution.targets[0]
        private_usage: BuildUsageTargetResult = resolution.targets[1]
        wrapper_usage: BuildUsageTargetResult = resolution.targets[2]
        app_usage: BuildUsageTargetResult = resolution.targets[3]
        assert shared_usage.link.count == 0
        assert shared_usage.exported_link.count == 0
        assert private_usage.link.count == 1
        assert private_usage.link[0].kind == BuildUsageKind.LinkLibrary
        assert private_usage.link[0].value == "shared"
        assert not private_usage.link[0].link_only
        assert private_usage.exported_link.count == 0
        assert wrapper_usage.link.count == 1
        assert wrapper_usage.link[0].value == "shared"
        assert wrapper_usage.exported_link.count == 1
        assert wrapper_usage.exported_link[0].value == "shared"
        assert not wrapper_usage.exported_link[0].link_only
        assert app_usage.link.count == 2
        assert app_usage.link[0].value == "wrapper"
        assert app_usage.link[1].value == "shared"
        assert not app_usage.link[1].link_only
        assert app_usage.exported_link.count == 0


@test
def build_usage_distinguishes_target_artifacts_from_linker_names() -> void:
    can Memory.Allocate, Abort.Panic:
        api: BuildUsageTarget = BuildUsageTarget{
            name: "api",
            kind: BuildUsageTargetKind.InterfaceLibrary,
            requirements: [
                BuildUsageRequirement{kind: BuildUsageKind.LinkLibrary, visibility: BuildUsageVisibility.Interface, value: "m"},
                BuildUsageRequirement{kind: BuildUsageKind.LinkLibrary, visibility: BuildUsageVisibility.Interface, value: "/opt/fixture/lib/libcustom.a", library_form: BuildUsageLibraryForm.Path},
                BuildUsageRequirement{kind: BuildUsageKind.LinkLibrary, visibility: BuildUsageVisibility.Interface, value: "deps/lib/librelative.a", library_form: BuildUsageLibraryForm.Path},
                BuildUsageRequirement{kind: BuildUsageKind.LinkLibrary, visibility: BuildUsageVisibility.Interface, value: "-lcustom", library_form: BuildUsageLibraryForm.LinkerArgument}
            ]
        }
        library_m: BuildUsageTarget = BuildUsageTarget{name: "m", kind: BuildUsageTargetKind.StaticLibrary}
        app: BuildUsageTarget = BuildUsageTarget{
            name: "app",
            kind: BuildUsageTargetKind.Executable,
            dependencies: [
                BuildUsageDependency{target_index: 0, visibility: BuildUsageVisibility.Public},
                BuildUsageDependency{target_index: 1, visibility: BuildUsageVisibility.Private}
            ]
        }
        resolution: BuildUsageResolution = resolve_build_usage([api, library_m, app])
        app_usage: BuildUsageTargetResult = resolution.targets[2]

        assert app_usage.link.count == 5
        assert app_usage.link[0].kind == BuildUsageKind.LinkLibrary and app_usage.link[0].value == "m"
        assert not app_usage.link[0].target_artifact
        assert app_usage.link[1].kind == BuildUsageKind.LinkLibrary and app_usage.link[1].value == "/opt/fixture/lib/libcustom.a"
        assert app_usage.link[1].library_form == BuildUsageLibraryForm.Path
        assert not app_usage.link[1].target_artifact
        assert app_usage.link[2].kind == BuildUsageKind.LinkLibrary and app_usage.link[2].value == "deps/lib/librelative.a"
        assert app_usage.link[2].library_form == BuildUsageLibraryForm.Path
        assert not app_usage.link[2].target_artifact
        assert app_usage.link[3].kind == BuildUsageKind.LinkLibrary and app_usage.link[3].value == "-lcustom"
        assert app_usage.link[3].library_form == BuildUsageLibraryForm.LinkerArgument
        assert not app_usage.link[3].target_artifact
        assert app_usage.link[4].kind == BuildUsageKind.LinkLibrary and app_usage.link[4].value == "m"
        assert app_usage.link[4].target_artifact


@test
def build_usage_rejects_mismatched_library_forms() -> void:
    can Memory.Allocate, Abort.Panic:
        path_as_search_name: mutable bool = false
        catch resolve_build_usage([
            BuildUsageTarget{
                name: "bad-search",
                kind: BuildUsageTargetKind.InterfaceLibrary,
                requirements: [BuildUsageRequirement{kind: BuildUsageKind.LinkLibrary, visibility: BuildUsageVisibility.Interface, value: "./libcustom.a"}]
            }
        ]):
            ok value:
                assert false
            error failure:
                assert failure == BuildUsageError.InvalidLibraryForm
                path_as_search_name <- true
        assert path_as_search_name

        flag_as_compile_option: mutable bool = false
        catch resolve_build_usage([
            BuildUsageTarget{
                name: "bad-option",
                kind: BuildUsageTargetKind.InterfaceLibrary,
                requirements: [BuildUsageRequirement{kind: BuildUsageKind.CompileOption, visibility: BuildUsageVisibility.Interface, value: "-DVALUE=1", library_form: BuildUsageLibraryForm.LinkerArgument}]
            }
        ]):
            ok value:
                assert false
            error failure:
                assert failure == BuildUsageError.InvalidLibraryForm
                flag_as_compile_option <- true
        assert flag_as_compile_option


@test
def build_usage_rejects_noncanonical_dependencies_and_interface_visibility() -> void:
    can Memory.Allocate, Abort.Panic:
        later_dependency: mutable bool = false
        catch resolve_build_usage([
            BuildUsageTarget{
                name: "first",
                kind: BuildUsageTargetKind.Executable,
                dependencies: [BuildUsageDependency{target_index: 1, visibility: BuildUsageVisibility.Public}]
            },
            BuildUsageTarget{name: "later", kind: BuildUsageTargetKind.InterfaceLibrary}
        ]):
            ok value:
                assert false
            error failure:
                assert failure == BuildUsageError.DependencyOrderInvalid
                later_dependency <- true
        assert later_dependency

        executable_dependency: mutable bool = false
        catch resolve_build_usage([
            BuildUsageTarget{name: "producer", kind: BuildUsageTargetKind.Executable},
            BuildUsageTarget{
                name: "consumer",
                kind: BuildUsageTargetKind.Executable,
                dependencies: [BuildUsageDependency{target_index: 0, visibility: BuildUsageVisibility.Private}]
            }
        ]):
            ok value:
                assert false
            error failure:
                assert failure == BuildUsageError.InvalidDependencyTargetKind
                executable_dependency <- true
        assert executable_dependency

        private_interface_requirement: mutable bool = false
        catch resolve_build_usage([
            BuildUsageTarget{
                name: "invalid-interface",
                kind: BuildUsageTargetKind.InterfaceLibrary,
                requirements: [BuildUsageRequirement{kind: BuildUsageKind.IncludeDirectory, visibility: BuildUsageVisibility.Private, value: "include"}]
            }
        ]):
            ok value:
                assert false
            error failure:
                assert failure == BuildUsageError.InterfaceVisibilityRequired
                private_interface_requirement <- true
        assert private_interface_requirement


@test
def build_usage_private_static_dependency_is_local_and_link_only_exported() -> void:
    can Memory.Allocate, Abort.Panic:
        implementation: BuildUsageTarget = BuildUsageTarget{
            name: "implementation",
            kind: BuildUsageTargetKind.InterfaceLibrary,
            requirements: [
                BuildUsageRequirement{kind: BuildUsageKind.CompileDefinition, visibility: BuildUsageVisibility.Interface, value: "IMPL_PRIVATE=1"},
                BuildUsageRequirement{kind: BuildUsageKind.LinkLibrary, visibility: BuildUsageVisibility.Interface, value: "-lprivate_dep", library_form: BuildUsageLibraryForm.LinkerArgument}
            ]
        }
        static_library: BuildUsageTarget = BuildUsageTarget{
            name: "static",
            kind: BuildUsageTargetKind.StaticLibrary,
            dependencies: [BuildUsageDependency{target_index: 0, visibility: BuildUsageVisibility.Private}]
        }
        consumer: BuildUsageTarget = BuildUsageTarget{
            name: "consumer",
            kind: BuildUsageTargetKind.Executable,
            dependencies: [BuildUsageDependency{target_index: 1, visibility: BuildUsageVisibility.Public}]
        }
        resolution: BuildUsageResolution = resolve_build_usage([implementation, static_library, consumer])
        static_usage: BuildUsageTargetResult = resolution.targets[1]
        assert static_usage.compile.count == 1
        assert static_usage.compile[0].value == "IMPL_PRIVATE=1"
        assert static_usage.exported_compile.count == 0
        assert static_usage.link.count == 1 and not static_usage.link[0].link_only
        assert static_usage.link[0].value == "-lprivate_dep"
        assert static_usage.link[0].library_form == BuildUsageLibraryForm.LinkerArgument
        assert static_usage.exported_link.count == 1 and static_usage.exported_link[0].link_only
        assert static_usage.exported_link[0].library_form == BuildUsageLibraryForm.LinkerArgument

        consumer_usage: BuildUsageTargetResult = resolution.targets[2]
        assert consumer_usage.compile.count == 0
        assert consumer_usage.link.count == 2
        assert consumer_usage.link[0].value == "static" and consumer_usage.link[0].target_artifact
        assert not consumer_usage.link[0].link_only
        assert consumer_usage.link[1].value == "-lprivate_dep" and not consumer_usage.link[1].target_artifact
        assert not consumer_usage.link[1].link_only
        assert consumer_usage.link[1].library_form == BuildUsageLibraryForm.LinkerArgument


@test
def build_usage_transitive_target_link_closure_keeps_private_flags_local() -> void:
    can Memory.Allocate, Abort.Panic:
        api: BuildUsageTarget = BuildUsageTarget{
            name: "api",
            kind: BuildUsageTargetKind.InterfaceLibrary,
            requirements: [
                BuildUsageRequirement{kind: BuildUsageKind.IncludeDirectory, visibility: BuildUsageVisibility.Interface, value: "/fixture/include/api"},
                BuildUsageRequirement{kind: BuildUsageKind.CompileDefinition, visibility: BuildUsageVisibility.Interface, value: "API_LEVEL=3"},
                BuildUsageRequirement{kind: BuildUsageKind.CompileOption, visibility: BuildUsageVisibility.Interface, value: "-DAPI_OPTION=1"},
                BuildUsageRequirement{kind: BuildUsageKind.LinkLibrary, visibility: BuildUsageVisibility.Interface, value: "m"},
                BuildUsageRequirement{kind: BuildUsageKind.LinkOption, visibility: BuildUsageVisibility.Interface, value: "-Wl,-dead_strip"}
            ]
        }
        helper: BuildUsageTarget = BuildUsageTarget{
            name: "helper",
            kind: BuildUsageTargetKind.StaticLibrary,
            requirements: [
                BuildUsageRequirement{kind: BuildUsageKind.IncludeDirectory, visibility: BuildUsageVisibility.Private, value: "/fixture/include/helper"},
                BuildUsageRequirement{kind: BuildUsageKind.CompileDefinition, visibility: BuildUsageVisibility.Private, value: "HELPER_PRIVATE=1"},
                BuildUsageRequirement{kind: BuildUsageKind.CompileOption, visibility: BuildUsageVisibility.Private, value: "-DHELPER_PRIVATE_OPTION=1"}
            ]
        }
        core: BuildUsageTarget = BuildUsageTarget{
            name: "core",
            kind: BuildUsageTargetKind.StaticLibrary,
            dependencies: [
                BuildUsageDependency{target_index: 0, visibility: BuildUsageVisibility.Public},
                BuildUsageDependency{target_index: 1, visibility: BuildUsageVisibility.Private}
            ],
            requirements: [
                BuildUsageRequirement{kind: BuildUsageKind.IncludeDirectory, visibility: BuildUsageVisibility.Private, value: "/fixture/include/internal"},
                BuildUsageRequirement{kind: BuildUsageKind.IncludeDirectory, visibility: BuildUsageVisibility.Public, value: "/fixture/include/core"},
                BuildUsageRequirement{kind: BuildUsageKind.CompileDefinition, visibility: BuildUsageVisibility.Private, value: "CORE_PRIVATE=1"},
                BuildUsageRequirement{kind: BuildUsageKind.CompileDefinition, visibility: BuildUsageVisibility.Public, value: "CORE_ABI=5"},
                BuildUsageRequirement{kind: BuildUsageKind.CompileOption, visibility: BuildUsageVisibility.Private, value: "-DCORE_PRIVATE_OPTION=1"},
                BuildUsageRequirement{kind: BuildUsageKind.CompileOption, visibility: BuildUsageVisibility.Public, value: "-DCORE_PUBLIC_OPTION=1"}
            ]
        }
        app: BuildUsageTarget = BuildUsageTarget{
            name: "app",
            kind: BuildUsageTargetKind.Executable,
            dependencies: [BuildUsageDependency{target_index: 2, visibility: BuildUsageVisibility.Private}]
        }
        resolution: BuildUsageResolution = resolve_build_usage([api, helper, core, app])
        app_usage: BuildUsageTargetResult = resolution.targets[3]

        assert any entry in app_usage.compile where entry.value == "/fixture/include/core"
        assert any entry in app_usage.compile where entry.value == "/fixture/include/api"
        assert any entry in app_usage.compile where entry.value == "CORE_ABI=5"
        assert any entry in app_usage.compile where entry.value == "API_LEVEL=3"
        assert any entry in app_usage.compile where entry.value == "-DCORE_PUBLIC_OPTION=1"
        assert any entry in app_usage.compile where entry.value == "-DAPI_OPTION=1"
        assert not any entry in app_usage.compile where entry.value == "/fixture/include/internal"
        assert not any entry in app_usage.compile where entry.value == "/fixture/include/helper"
        assert not any entry in app_usage.compile where entry.value == "CORE_PRIVATE=1"
        assert not any entry in app_usage.compile where entry.value == "HELPER_PRIVATE=1"
        assert not any entry in app_usage.compile where entry.value == "-DCORE_PRIVATE_OPTION=1"
        assert not any entry in app_usage.compile where entry.value == "-DHELPER_PRIVATE_OPTION=1"
        core_usage: BuildUsageTargetResult = resolution.targets[2]
        assert any entry in core_usage.exported_link where entry.value == "helper" and entry.link_only
        assert app_usage.link.count == 4
        assert app_usage.link[0].kind == BuildUsageKind.LinkLibrary and app_usage.link[0].value == "core" and not app_usage.link[0].link_only
        assert app_usage.link[1].kind == BuildUsageKind.LinkLibrary and app_usage.link[1].value == "m" and not app_usage.link[1].link_only
        assert app_usage.link[2].kind == BuildUsageKind.LinkOption and app_usage.link[2].value == "-Wl,-dead_strip" and not app_usage.link[2].link_only
        assert app_usage.link[3].kind == BuildUsageKind.LinkLibrary and app_usage.link[3].value == "helper" and not app_usage.link[3].link_only


@test
def build_usage_interface_dependency_must_use_interface_visibility() -> void:
    can Memory.Allocate, Abort.Panic:
        rejected: mutable bool = false
        catch resolve_build_usage([
            BuildUsageTarget{name: "base", kind: BuildUsageTargetKind.InterfaceLibrary},
            BuildUsageTarget{
                name: "aggregate",
                kind: BuildUsageTargetKind.InterfaceLibrary,
                dependencies: [BuildUsageDependency{target_index: 0, visibility: BuildUsageVisibility.Public}]
            }
        ]):
            ok value:
                assert false
            error failure:
                rejected <- failure == BuildUsageError.InterfaceVisibilityRequired
        assert rejected
