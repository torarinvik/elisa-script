include "../../src/runtime/build_usage_model.elisa"

using EsBuildUsage


@test
def build_usage_public_private_interface_and_static_link_only_propagation() -> void:
    can Memory.Allocate, Abort.Panic:
        interface: BuildUsageTarget = BuildUsageTarget{
            name: "api",
            kind: BuildUsageTargetKind.InterfaceLibrary,
            requirements: [
                BuildUsageRequirement{kind: BuildUsageKind.IncludeDirectory, visibility: BuildUsageVisibility.Interface, value: "include/api"},
                BuildUsageRequirement{kind: BuildUsageKind.CompileDefinition, visibility: BuildUsageVisibility.Interface, value: "API_LEVEL=3"},
                BuildUsageRequirement{kind: BuildUsageKind.LinkLibrary, visibility: BuildUsageVisibility.Interface, value: "m"}
            ]
        }
        core: BuildUsageTarget = BuildUsageTarget{
            name: "core",
            kind: BuildUsageTargetKind.StaticLibrary,
            dependencies: [BuildUsageDependency{target_index: 0, visibility: BuildUsageVisibility.Public}],
            requirements: [
                BuildUsageRequirement{kind: BuildUsageKind.CompileDefinition, visibility: BuildUsageVisibility.Private, value: "CORE_INTERNAL=1"},
                BuildUsageRequirement{kind: BuildUsageKind.CompileOption, visibility: BuildUsageVisibility.Public, value: "-fvisibility=hidden"},
                BuildUsageRequirement{kind: BuildUsageKind.LinkLibrary, visibility: BuildUsageVisibility.Private, value: "z"}
            ]
        }
        app: BuildUsageTarget = BuildUsageTarget{
            name: "app",
            kind: BuildUsageTargetKind.Executable,
            dependencies: [BuildUsageDependency{target_index: 1, visibility: BuildUsageVisibility.Public}]
        }
        resolution: BuildUsageResolution = resolve_build_usage([interface, core, app])
        assert resolution.targets.count == 3

        core_usage: BuildUsageTargetResult = resolution.targets[1]
        assert core_usage.compile.count == 4
        assert core_usage.compile[0].value == "CORE_INTERNAL=1"
        assert core_usage.compile[1].value == "-fvisibility=hidden"
        assert core_usage.compile[2].value == "include/api"
        assert core_usage.compile[3].value == "API_LEVEL=3"
        assert core_usage.link.count == 2
        assert core_usage.link[0].value == "z" and not core_usage.link[0].link_only
        assert core_usage.link[1].value == "m" and not core_usage.link[1].link_only
        assert core_usage.exported_compile.count == 3
        assert core_usage.exported_compile[0].value == "-fvisibility=hidden"
        assert core_usage.exported_compile[1].value == "include/api"
        assert core_usage.exported_compile[2].value == "API_LEVEL=3"
        assert core_usage.exported_link.count == 2
        assert core_usage.exported_link[0].value == "z" and core_usage.exported_link[0].link_only
        assert core_usage.exported_link[1].value == "m" and not core_usage.exported_link[1].link_only

        app_usage: BuildUsageTargetResult = resolution.targets[2]
        assert app_usage.compile.count == 3
        assert app_usage.compile[0].value == "-fvisibility=hidden"
        assert app_usage.compile[1].value == "include/api"
        assert app_usage.compile[2].value == "API_LEVEL=3"
        assert app_usage.link.count == 2
        assert app_usage.link[0].value == "z" and app_usage.link[0].link_only
        assert app_usage.link[1].value == "m" and not app_usage.link[1].link_only
        assert not app_usage.compile[0].value.startswith("CORE_INTERNAL")


@test
def build_usage_rejects_noncanonical_dependencies_and_interface_visibility() -> void:
    can Memory.Allocate, Abort.Panic:
        later_dependency: mutable bool = false
        catch resolve_build_usage([
            BuildUsageTarget{
                name: "first",
                kind: BuildUsageTargetKind.Executable,
                dependencies: [BuildUsageDependency{target_index: 1, visibility: BuildUsageVisibility.Public}]
            },
            BuildUsageTarget{name: "later", kind: BuildUsageTargetKind.InterfaceLibrary}
        ]):
            ok value:
                assert false
            error failure:
                assert failure == BuildUsageError.DependencyOrderInvalid
                later_dependency <- true
        assert later_dependency

        private_interface_requirement: mutable bool = false
        catch resolve_build_usage([
            BuildUsageTarget{
                name: "invalid-interface",
                kind: BuildUsageTargetKind.InterfaceLibrary,
                requirements: [BuildUsageRequirement{kind: BuildUsageKind.IncludeDirectory, visibility: BuildUsageVisibility.Private, value: "include"}]
            }
        ]):
            ok value:
                assert false
            error failure:
                assert failure == BuildUsageError.InterfaceVisibilityRequired
                private_interface_requirement <- true
        assert private_interface_requirement


@test
def build_usage_private_static_dependency_is_local_and_link_only_exported() -> void:
    can Memory.Allocate, Abort.Panic:
        implementation: BuildUsageTarget = BuildUsageTarget{
            name: "implementation",
            kind: BuildUsageTargetKind.InterfaceLibrary,
            requirements: [
                BuildUsageRequirement{kind: BuildUsageKind.CompileDefinition, visibility: BuildUsageVisibility.Interface, value: "IMPL_PRIVATE=1"},
                BuildUsageRequirement{kind: BuildUsageKind.LinkLibrary, visibility: BuildUsageVisibility.Interface, value: "private_dep"}
            ]
        }
        static_library: BuildUsageTarget = BuildUsageTarget{
            name: "static",
            kind: BuildUsageTargetKind.StaticLibrary,
            dependencies: [BuildUsageDependency{target_index: 0, visibility: BuildUsageVisibility.Private}]
        }
        consumer: BuildUsageTarget = BuildUsageTarget{
            name: "consumer",
            kind: BuildUsageTargetKind.Executable,
            dependencies: [BuildUsageDependency{target_index: 1, visibility: BuildUsageVisibility.Public}]
        }
        resolution: BuildUsageResolution = resolve_build_usage([implementation, static_library, consumer])
        static_usage: BuildUsageTargetResult = resolution.targets[1]
        assert static_usage.compile.count == 1
        assert static_usage.compile[0].value == "IMPL_PRIVATE=1"
        assert static_usage.exported_compile.count == 0
        assert static_usage.link.count == 1 and not static_usage.link[0].link_only
        assert static_usage.link[0].value == "private_dep"
        assert static_usage.exported_link.count == 1 and static_usage.exported_link[0].link_only

        consumer_usage: BuildUsageTargetResult = resolution.targets[2]
        assert consumer_usage.compile.count == 0
        assert consumer_usage.link.count == 1 and consumer_usage.link[0].link_only
        assert consumer_usage.link[0].value == "private_dep"


@test
def build_usage_interface_dependency_must_use_interface_visibility() -> void:
    can Memory.Allocate, Abort.Panic:
        rejected: mutable bool = false
        catch resolve_build_usage([
            BuildUsageTarget{name: "base", kind: BuildUsageTargetKind.InterfaceLibrary},
            BuildUsageTarget{
                name: "aggregate",
                kind: BuildUsageTargetKind.InterfaceLibrary,
                dependencies: [BuildUsageDependency{target_index: 0, visibility: BuildUsageVisibility.Public}]
            }
        ]):
            ok value:
                assert false
            error failure:
                rejected <- failure == BuildUsageError.InterfaceVisibilityRequired
        assert rejected
