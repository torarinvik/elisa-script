include "../../src/runtime/base64_model.elisa"

using EsBase64


def base64_rejects(source: sview, expected: Base64Error, max_output_bytes: usize = Limits::MAX_OUTPUT_BYTES) -> bool can[Memory.Allocate, Abort.Panic]:
    observed: mutable bool = false
    catch decode_base64(source, max_output_bytes):
        ok decoded:
            _ = decoded
        error failure:
            observed <- failure == expected
    return observed


def base64_encode_rejects(source: sview, expected: Base64Error, max_output_bytes: usize = Limits::MAX_OUTPUT_BYTES) -> bool can[Memory.Allocate, Abort.Panic]:
    observed: mutable bool = false
    catch encode_base64(source, max_output_bytes):
        ok encoded:
            _ = encoded
        error failure:
            observed <- failure == expected
    return observed


@test
def strict_base64_encodes_with_python_standard_alphabet_padding() -> void can[Memory.Allocate, Abort.Panic]:
    assert bytes_view(encode_base64("")) == ""
    assert bytes_view(encode_base64("f")) == "Zg=="
    assert bytes_view(encode_base64("fo")) == "Zm8="
    assert bytes_view(encode_base64("foo")) == "Zm9v"
    assert bytes_view(encode_base64("\x00\xff")) == "AP8="
    assert base64_encode_rejects("f", Base64Error.OutputTooLarge, 3)


@test
def strict_base64_decodes_empty_unpadded_and_padded_groups() -> void can[Memory.Allocate, Abort.Panic]:
    assert decode_base64("").count == 0
    assert bytes_view(decode_base64("TWFu")) == "Man"
    assert bytes_view(decode_base64("TWE=")) == "Ma"
    assert bytes_view(decode_base64("TQ==")) == "M"
    symbols: darray[u8] = decode_base64("++++")
    assert symbols.count == 3 and symbols[0] == 251u8 and symbols[1] == 239u8 and symbols[2] == 190u8
    special_symbols: darray[u8] = decode_base64("+/8=")
    assert special_symbols.count == 2 and special_symbols[0] == 251u8 and special_symbols[1] == 255u8


@test
def strict_base64_rejects_bad_lengths_alphabet_and_padding() -> void can[Memory.Allocate, Abort.Panic]:
    assert base64_rejects("TQ=", Base64Error.InvalidLength)
    assert base64_rejects("T?==", Base64Error.InvalidCharacter)
    assert base64_rejects("TQ=A", Base64Error.InvalidPadding)
    assert base64_rejects("A===", Base64Error.InvalidPadding)
    assert base64_rejects("T Q=", Base64Error.InvalidCharacter)
    assert base64_rejects("TWFu", Base64Error.OutputTooLarge, 2)
    assert base64_rejects("", Base64Error.InvalidLimit, 0)
