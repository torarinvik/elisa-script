include "../../src/runtime/encoding.elisa"
include "../../src/runtime/process_model.elisa"
include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../src/runtime/json_lexer_model.elisa"
include "../../src/runtime/json_parse_model.elisa"
include "../../src/runtime/config_model.elisa"
include "../../src/runtime/config_json_model.elisa"
include "../../src/runtime/bounded_text_posix.elisa"
include "../../src/runtime/config_json_file_posix.elisa"

using EsData
using EsJson
using EsConfig
using EsConfigJsonFilePosix


@test
def bounded_json_configuration_file_retains_layer_document_storage() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        loaded: ConfigJsonFileLayer = read_config_json_file(path("test/runtime/config_json_file_fixture.json"))
        assert loaded.document.state == JsonDocumentState.Sealed
        assert loaded.layer.source == ConfigSource.File
        assert loaded.layer.entries.count == 3
        assert loaded.layer.entries[0].key == "name" and loaded.layer.entries[0].value == "ElisaScript"
        assert loaded.layer.entries[1].key == "count" and loaded.layer.entries[1].value == "23"
        assert loaded.layer.entries[2].key == "enabled" and loaded.layer.entries[2].value == "true"


@test
def bounded_json_configuration_file_rejects_over_limit_before_reading() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        limits: DataDecodeLimits = DataDecodeLimits{input_bytes: JSON_CONFIG_FILE_MAX_BYTES + 1}
        rejected: mutable bool = false
        catch read_config_json_file(path("test/runtime/not-opened.json"), limits):
            ok loaded:
                assert false
            error failure:
                rejected <- failure == ConfigJsonFileError.InputLimitInvalid
        assert rejected
