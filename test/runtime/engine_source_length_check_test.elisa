include "../../ports/elisa-engine/scripts/check_source_length.elisascript"

using EsEngineSourceLengthCheck


@test
def engine_source_length_audit_applies_line_limit_and_suffix_filter() -> void can[Blocking.IO, Directory.Read, Directory.Write, File.Read, File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console.Format]:
    temporary: Path = try temp_directory("engine-source-length") else failure:
        _ = failure
        assert false
        return
    source_directory: Path = temporary.joinpath("src")
    created: bool = try create_directories(source_directory) else false
    if not created:
        _ = try remove_tree(temporary) else false
        assert false
        return

    hidden_directory: Path = source_directory.joinpath(".hidden")
    hidden_created: bool = try create_directories(hidden_directory) else false
    target_directory: Path = temporary.joinpath("outside-source-roots")
    target_created: bool = try create_directories(target_directory) else false
    if not hidden_created or not target_created:
        _ = try remove_tree(temporary) else false
        assert false
        return

    bounded_contents: mutable sview = ""
    over_limit_contents: mutable sview = ""
    for _ in 0..<600 |bounded_contents, over_limit_contents|:
        bounded_contents <- bounded_contents + "line\r\n"
        over_limit_contents <- over_limit_contents + "line\r\n"
    over_limit_contents <- over_limit_contents + "last"

    bounded: Path = source_directory.joinpath("bounded.elisa")
    over_limit: Path = source_directory.joinpath("over-limit.elisa")
    excluded: Path = source_directory.joinpath("over-limit.txt")
    hidden_over_limit: Path = hidden_directory.joinpath("hidden-over-limit.py")
    linked_target: Path = target_directory.joinpath("linked-target.elisa")
    linked_directory: Path = source_directory.joinpath("linked-directory")
    bounded_written: usize = try write_text(bounded, bounded_contents) else 0usize
    over_limit_written: usize = try write_text(over_limit, over_limit_contents) else 0usize
    excluded_written: usize = try write_text(excluded, over_limit_contents) else 0usize
    hidden_written: usize = try write_text(hidden_over_limit, over_limit_contents) else 0usize
    linked_written: usize = try write_text(linked_target, over_limit_contents) else 0usize
    linked: bool = try symlink(target_directory, linked_directory) else false
    report: AuditReport = try audit(temporary) else failure:
        _ = failure
        _ = try remove_tree(temporary) else false
        assert false
        return
    removed: bool = try remove_tree(temporary) else false

    assert bounded_written == sview_len(bounded_contents)
    assert over_limit_written == sview_len(over_limit_contents)
    assert excluded_written == sview_len(over_limit_contents)
    assert hidden_written == sview_len(over_limit_contents)
    assert linked_written == sview_len(over_limit_contents)
    assert linked
    assert report.violations.count == 2usize
    first_path: sview = f"{report.violations[0].path}"
    second_path: sview = f"{report.violations[1].path}"
    assert first_path == f"{hidden_over_limit}"
    assert second_path == f"{over_limit}"
    assert report.violations[0].line_count == 601usize
    assert report.violations[1].line_count == 601usize
    assert removed
