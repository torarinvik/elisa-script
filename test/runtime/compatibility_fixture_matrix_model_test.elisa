include "../../src/runtime/encoding.elisa"
include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../src/runtime/json_lexer_model.elisa"
include "../../src/runtime/json_parse_model.elisa"
include "../../src/runtime/python_json_projection.elisa"
include "../../src/runtime/compatibility_fixture_matrix_model.elisa"

using EsCompatibilityFixtureMatrix


const module FixtureMatrixInputs:
    VALID: sview = "{\"schema\":\"wasmbrowser.fixture_matrix.v1\",\"coverage_policy\":\"Representative rows only\",\"axes\":{\"language\":[\"elisa\"],\"framework\":[\"custom\"],\"runtime_profile\":[\"graphics@1\"],\"delivery_mode\":[\"wapp\"],\"execution_location\":[\"local\",\"remote-worker\"],\"os\":[\"macos\"],\"cpu_architecture\":[\"aarch64\"],\"graphics_capability\":[\"framebuffer\"]},\"cases\":[{\"id\":\"local-case\",\"language\":\"elisa\",\"framework\":\"custom\",\"runtime_profile\":\"graphics@1\",\"delivery_mode\":\"wapp\",\"execution_location\":\"local\",\"os\":\"macos\",\"cpu_architecture\":\"aarch64\",\"graphics_capability\":\"framebuffer\",\"status\":\"supported\",\"evidence\":[\"test/runtime/compatibility_fixture_matrix_evidence.txt\"]},{\"id\":\"remote-case\",\"language\":\"elisa\",\"framework\":\"custom\",\"runtime_profile\":\"graphics@1\",\"delivery_mode\":\"wapp\",\"execution_location\":\"remote-worker\",\"os\":\"macos\",\"cpu_architecture\":\"aarch64\",\"graphics_capability\":\"framebuffer\",\"status\":\"blocked\",\"missing_prerequisite\":\"remote worker evidence is pending\"}]}"


def fixture_matrix_rejects_as(source: sview, expected: FixtureMatrixError, root: Path) -> bool can[File.Read, Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch validate_fixture_matrix_source(source, root):
        ok count:
            _ = count
        error failure:
            rejected <- failure == expected
    return rejected


@test
def compatibility_fixture_matrix_accepts_required_axes_evidence_and_blockers() -> void can[File.Read, Memory.Allocate, Abort.Panic]:
    count: usize = validate_fixture_matrix_source(FixtureMatrixInputs::VALID, path("."))
    assert count == 2


@test
def compatibility_fixture_matrix_matches_last_duplicate_json_key_behavior() -> void can[File.Read, Memory.Allocate, Abort.Panic]:
    duplicate_schema: sview = replace(FixtureMatrixInputs::VALID, "\"schema\":\"wasmbrowser.fixture_matrix.v1\"", "\"schema\":\"old\",\"schema\":\"wasmbrowser.fixture_matrix.v1\"")
    count: usize = validate_fixture_matrix_source(duplicate_schema, path("."))
    assert count == 2


@test
def compatibility_fixture_matrix_matches_python_truthy_nonfinite_constants() -> void can[File.Read, Memory.Allocate, Abort.Panic]:
    nan_policy: sview = replace(FixtureMatrixInputs::VALID, "\"Representative rows only\"", "NaN")
    infinity_policy: sview = replace(FixtureMatrixInputs::VALID, "\"Representative rows only\"", "Infinity")
    negative_infinity_policy: sview = replace(FixtureMatrixInputs::VALID, "\"Representative rows only\"", "-Infinity")
    string_policy: sview = replace(FixtureMatrixInputs::VALID, "\"Representative rows only\"", "\"NaN\"")
    assert validate_fixture_matrix_source(nan_policy, path(".")) == 2
    assert validate_fixture_matrix_source(infinity_policy, path(".")) == 2
    assert validate_fixture_matrix_source(negative_infinity_policy, path(".")) == 2
    assert validate_fixture_matrix_source(string_policy, path(".")) == 2


@test
def compatibility_fixture_matrix_matches_python_float_underflow_truthiness() -> void can[File.Read, Memory.Allocate, Abort.Panic]:
    underflow_policy: sview = replace(FixtureMatrixInputs::VALID, "\"Representative rows only\"", "1e-9999")
    subnormal_policy: sview = replace(FixtureMatrixInputs::VALID, "\"Representative rows only\"", "5e-324")
    negative_zero_policy: sview = replace(FixtureMatrixInputs::VALID, "\"Representative rows only\"", "-0.0")
    underflow_prerequisite: sview = replace(FixtureMatrixInputs::VALID, "\"remote worker evidence is pending\"", "1e-9999")
    assert fixture_matrix_rejects_as(underflow_policy, FixtureMatrixError.CoveragePolicyMissing, path("."))
    assert validate_fixture_matrix_source(subnormal_policy, path(".")) == 2
    assert fixture_matrix_rejects_as(negative_zero_policy, FixtureMatrixError.CoveragePolicyMissing, path("."))
    assert fixture_matrix_rejects_as(underflow_prerequisite, FixtureMatrixError.PrerequisiteMissing, path("."))


@test
def compatibility_fixture_matrix_rejects_duplicate_ids_missing_evidence_and_bad_axes() -> void can[File.Read, Memory.Allocate, Abort.Panic]:
    root: Path = path(".")
    duplicate_id: sview = replace(FixtureMatrixInputs::VALID, "remote-case", "local-case")
    missing_evidence: sview = replace(FixtureMatrixInputs::VALID, "test/runtime/compatibility_fixture_matrix_evidence.txt", "test/runtime/no-such-fixture-evidence.txt")
    unsupported_axis: sview = replace(FixtureMatrixInputs::VALID, "\"framebuffer\"]", "\"none\"]")
    assert fixture_matrix_rejects_as(duplicate_id, FixtureMatrixError.DuplicateCaseId, root)
    assert fixture_matrix_rejects_as(missing_evidence, FixtureMatrixError.EvidencePathMissing, root)
    assert fixture_matrix_rejects_as(unsupported_axis, FixtureMatrixError.AxisValueUnsupported, root)
    assert fixture_matrix_rejects_as("[", FixtureMatrixError.InvalidJson, root)
