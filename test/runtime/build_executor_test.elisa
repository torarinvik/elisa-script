include "../../src/runtime/build_executor_model.elisa"

using EsBuild
using EsBuildExecutor
using EsProcess


@test
def build_executor_preflights_supported_process_command_subset() -> void:
    can Memory.Allocate, Abort.Panic:
        skipped: BuildExecutionNodeResult = BuildExecutionNodeResult{target_name: "skipped"}
        assert not skipped.started and skipped.failure == BuildExecutionFailureKind.None

        portable: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/cc",
            working_directory: "build",
            environment: ["LC_ALL", "C", "TZ", "UTC"],
            environment_mode: ProcessEnvironmentMode.Inherit,
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 60000000u64,
            capture_output_limit_bytes: 1048576
        }
        assert build_executor_command_supported(portable)

        replaced_environment: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/cc",
            environment_mode: ProcessEnvironmentMode.Replace,
            stdin_mode: ProcessStdioMode.Null,
            timeout_micros: 60000000u64
        }
        assert build_executor_command_supported(replaced_environment)

        cleared_environment: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/cc",
            environment_mode: ProcessEnvironmentMode.Clear,
            stdin_mode: ProcessStdioMode.Null,
            timeout_micros: 60000000u64
        }
        assert build_executor_command_supported(cleared_environment)

        unresolved_environment_tool: ProcessCommand = ProcessCommand{
            executable: "cc",
            environment_mode: ProcessEnvironmentMode.Replace,
            stdin_mode: ProcessStdioMode.Null,
            timeout_micros: 60000000u64
        }
        assert not build_executor_command_supported(unresolved_environment_tool)

        inherited_stdin: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/cc",
            stdin_mode: ProcessStdioMode.Inherit,
            timeout_micros: 60000000u64
        }
        assert not build_executor_command_supported(inherited_stdin)

        uncapped: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/cc",
            stdin_mode: ProcessStdioMode.Null
        }
        assert not build_executor_command_supported(uncapped)


@test
def build_executor_accepts_only_canonical_absolute_output_paths() -> void:
    can Memory.Allocate, Abort.Panic:
        assert build_executor_output_path_valid("/tmp/build/main.o")
        assert build_executor_output_path_valid("/tmp/build/.hidden.o")
        assert not build_executor_output_path_valid("relative.o")
        assert not build_executor_output_path_valid("/")
        assert not build_executor_output_path_valid("/tmp/./main.o")
        assert not build_executor_output_path_valid("/tmp/dir/../main.o")
        assert not build_executor_output_path_valid("/tmp//main.o")
        assert not build_executor_output_path_valid("/tmp/build/")


@test
def build_executor_dispatches_exact_child_environment_modes() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Process.Run:
        replaced: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/printenv",
            arguments: ["ELISASCRIPT_BUILD_EXECUTOR_ENV_PROBE"],
            environment: ["ELISASCRIPT_BUILD_EXECUTOR_ENV_PROBE", "replacement-only"],
            environment_mode: ProcessEnvironmentMode.Replace,
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        replaced_result: ProcessCapture = try execute_build_command(replaced, 1024)
        assert process_exit_status(replaced_result) == 0
        assert process_stdout(replaced_result) == "replacement-only\n" and process_stderr(replaced_result) == ""

        replaced_without_path: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/printenv",
            arguments: ["PATH"],
            environment: ["ELISASCRIPT_BUILD_EXECUTOR_ENV_PROBE", "replacement-only"],
            environment_mode: ProcessEnvironmentMode.Replace,
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        replaced_path_result: ProcessCapture = try execute_build_command(replaced_without_path, 1024)
        assert process_exit_status(replaced_path_result) == 1
        assert process_stdout(replaced_path_result) == "" and process_stderr(replaced_path_result) == ""

        inherited_overlay: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/printenv",
            arguments: ["PATH"],
            environment: ["PATH", "/elisascript-build-inherit-probe"],
            environment_mode: ProcessEnvironmentMode.Inherit,
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        inherited_result: ProcessCapture = try execute_build_command(inherited_overlay, 1024)
        assert process_exit_status(inherited_result) == 0
        assert process_stdout(inherited_result) == "/elisascript-build-inherit-probe\n" and process_stderr(inherited_result) == ""

        cleared: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/printenv",
            arguments: ["PATH"],
            environment_mode: ProcessEnvironmentMode.Clear,
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        cleared_result: ProcessCapture = try execute_build_command(cleared, 1024)
        assert process_exit_status(cleared_result) == 1
        assert process_stdout(cleared_result) == "" and process_stderr(cleared_result) == ""


@test
def build_executor_rejects_late_unsupported_command_before_any_launch() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Process.Run, File.Read, File.Write, Directory.Write:
        temporary: Path = try temp_directory("build-executor-preflight") else err:
            assert false
            return
        marker: Path = temporary.joinpath("must-not-exist")
        marker_text: sview = f"{marker}"
        first: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/touch",
            arguments: [marker_text],
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        unsupported: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/true",
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Inherit,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        graph: mutable BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "marker", command: first, fingerprint: 1},
            BuildNode{name: "unsupported", command: unsupported, dependencies: [0], fingerprint: 2}
        ]}

        rejected: mutable bool = false
        process_started: mutable bool = false
        catch execute_build_graph_serial(graph):
            ok result:
                process_started <- result.nodes[0].started
            error failure:
                rejected <- failure == BuildExecutionError.UnsupportedCommand

        marker_absent: bool = not is_file(marker)
        graph_unchanged: bool = graph.state == BuildGraphState.Planned
        removed_marker: mutable bool = true
        if not marker_absent:
            removed_marker <- try remove_path(marker) else false
        removed_directory: bool = try remove_directory(temporary) else false
        assert rejected and not process_started and marker_absent and graph_unchanged and removed_marker and removed_directory


@test
def build_executor_nonzero_exit_cancels_dependent_launches() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Process.Run, File.Read, File.Write, Directory.Write:
        temporary: Path = try temp_directory("build-executor-failure") else err:
            assert false
            return
        marker: Path = temporary.joinpath("dependent-must-not-run")
        marker_text: sview = f"{marker}"
        prepare_command: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/printf",
            arguments: ["prepared\n"],
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        failing_command: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/false",
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        dependent_command: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/touch",
            arguments: [marker_text],
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        graph: mutable BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "prepare", command: prepare_command, fingerprint: 1},
            BuildNode{name: "fail", command: failing_command, dependencies: [0], fingerprint: 2},
            BuildNode{name: "dependent", command: dependent_command, dependencies: [1], fingerprint: 3}
        ]}

        completed: mutable bool = false
        execution: mutable BuildExecutionResult = BuildExecutionResult{}
        catch execute_build_graph_serial(graph):
            ok result:
                execution <- result
                completed <- true
            error _:
                completed <- false

        marker_absent: bool = not is_file(marker)
        removed_marker: mutable bool = true
        if not marker_absent:
            removed_marker <- try remove_path(marker) else false
        removed_directory: bool = try remove_directory(temporary) else false
        assert completed and execution.graph_state == BuildGraphState.Failed
        assert execution.nodes.count == 3 and execution.log_bytes == len("prepared\n")
        assert execution.nodes[0].started and execution.nodes[0].failure == BuildExecutionFailureKind.None
        assert execution.nodes[0].exit_status == 0 and execution.nodes[0].stdout == "prepared\n"
        assert execution.nodes[1].started and execution.nodes[1].failure == BuildExecutionFailureKind.NonzeroExit
        assert execution.nodes[1].exit_status == 1 and execution.nodes[1].stdout == "" and execution.nodes[1].stderr == ""
        assert not execution.nodes[2].started and execution.nodes[2].failure == BuildExecutionFailureKind.None
        assert graph.nodes[2].state == BuildNodeState.Cancelled and marker_absent
        assert removed_marker and removed_directory


@test
def build_executor_checks_declared_outputs_before_node_success() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Process.Run, File.Read, File.Write, Directory.Write:
        temporary: Path = try temp_directory("build-executor-output") else err:
            assert false
            return
        output: Path = temporary.joinpath("artifact.o")
        output_text: sview = f"{output}"
        declared_outputs: darray[BuildExecutionNodeOutputs] = [BuildExecutionNodeOutputs{target_name: "produce", paths: [output_text]}]

        producing_command: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/touch",
            arguments: [output_text],
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        producing_graph: mutable BuildGraph = BuildGraph{nodes: [BuildNode{name: "produce", command: producing_command, fingerprint: 1}]}
        produced: BuildExecutionResult = try execute_build_graph_serial_with_outputs(producing_graph, declared_outputs)
        assert produced.graph_state == BuildGraphState.Succeeded
        assert produced.nodes.count == 1 and produced.nodes[0].failure == BuildExecutionFailureKind.None
        assert produced.nodes[0].missing_output == "" and is_file(output)
        removed_output: bool = try remove_path(output) else false

        no_output_command: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/true",
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        missing_graph: mutable BuildGraph = BuildGraph{nodes: [BuildNode{name: "produce", command: no_output_command, fingerprint: 1}]}
        missing: BuildExecutionResult = try execute_build_graph_serial_with_outputs(missing_graph, declared_outputs)
        missing_output: bool = not is_file(output)
        removed_directory: bool = try remove_directory(temporary) else false
        assert missing.graph_state == BuildGraphState.Failed
        assert missing.nodes.count == 1 and missing.nodes[0].failure == BuildExecutionFailureKind.OutputMissing
        assert missing.nodes[0].exit_status == 0 and missing.nodes[0].missing_output == output_text
        assert missing_output and missing_graph.nodes[0].state == BuildNodeState.Failed
        assert removed_output and removed_directory


@test
def build_executor_rejects_output_created_by_an_earlier_node() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Process.Run, File.Read, File.Write, Directory.Write:
        temporary: Path = try temp_directory("build-executor-premature-output") else err:
            assert false
            return
        future_output: Path = temporary.joinpath("future-artifact.o")
        must_not_run: Path = temporary.joinpath("later-node-ran")
        future_output_text: sview = f"{future_output}"
        must_not_run_text: sview = f"{must_not_run}"
        early_command: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/touch",
            arguments: [future_output_text],
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        later_command: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/touch",
            arguments: [must_not_run_text],
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        graph: mutable BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "early-side-effect", command: early_command, fingerprint: 1},
            BuildNode{name: "future-producer", command: later_command, dependencies: [0], fingerprint: 2}
        ]}
        output_sets: darray[BuildExecutionNodeOutputs] = [
            BuildExecutionNodeOutputs{target_name: "early-side-effect", paths: []},
            BuildExecutionNodeOutputs{target_name: "future-producer", paths: [future_output_text]}
        ]

        execution: BuildExecutionResult = try execute_build_graph_serial_with_outputs(graph, output_sets)
        future_output_created: bool = is_file(future_output)
        later_node_not_run: bool = not path_exists(must_not_run)
        removed_future_output: bool = try remove_path(future_output) else false
        removed_marker: bool = not path_exists(must_not_run) or (try remove_path(must_not_run) else false)
        removed_directory: bool = try remove_directory(temporary) else false
        assert execution.graph_state == BuildGraphState.Failed
        assert execution.nodes.count == 2
        assert execution.nodes[0].started and execution.nodes[0].failure == BuildExecutionFailureKind.None
        assert not execution.nodes[1].started and graph.nodes[1].state == BuildNodeState.Failed
        assert execution.nodes[1].failure == BuildExecutionFailureKind.PrematureOutput
        assert execution.nodes[1].premature_output == future_output_text
        assert future_output_created and later_node_not_run
        assert removed_future_output and removed_marker and removed_directory


@test
def build_executor_rejects_preexisting_declared_output_before_launch() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Process.Run, File.Read, File.Write, Directory.Write:
        temporary: Path = try temp_directory("build-executor-stale-output") else err:
            assert false
            return
        output: Path = temporary.joinpath("stale-artifact.o")
        marker: Path = temporary.joinpath("process-must-not-run")
        output_text: sview = f"{output}"
        marker_text: sview = f"{marker}"
        wrote_old_output: usize = try write_text(output, "stale") else 0u64
        command: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/touch",
            arguments: [marker_text],
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        graph: mutable BuildGraph = BuildGraph{nodes: [BuildNode{name: "produce", command: command, fingerprint: 1}]}
        output_sets: darray[BuildExecutionNodeOutputs] = [BuildExecutionNodeOutputs{target_name: "produce", paths: [output_text]}]
        stale_output_rejected: mutable bool = false
        process_started: mutable bool = false
        catch execute_build_graph_serial_with_outputs(graph, output_sets):
            ok result:
                process_started <- result.nodes[0].started
            error failure:
                stale_output_rejected <- failure == BuildExecutionError.OutputAlreadyPresent

        marker_absent: bool = not is_file(marker)
        stale_output_contents: sview = try read_text(output) else ""
        stale_bytes_preserved: bool = stale_output_contents == "stale"
        output_removed: bool = try remove_path(output) else false
        marker_removed: bool = not is_file(marker) or (try remove_path(marker) else false)
        directory_removed: bool = try remove_directory(temporary) else false
        assert wrote_old_output == 5u64 and stale_output_rejected and not process_started
        assert graph.state == BuildGraphState.Planned and marker_absent and stale_bytes_preserved
        assert output_removed and marker_removed and directory_removed


@test
def build_executor_rejects_relative_outputs_before_launch() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Process.Run, File.Read, File.Write, Directory.Write:
        temporary: Path = try temp_directory("build-executor-invalid-output") else err:
            assert false
            return
        marker: Path = temporary.joinpath("must-not-run")
        marker_text: sview = f"{marker}"
        command: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/touch",
            arguments: [marker_text],
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        graph: mutable BuildGraph = BuildGraph{nodes: [BuildNode{name: "produce", command: command, fingerprint: 1}]}
        output_sets: darray[BuildExecutionNodeOutputs] = [BuildExecutionNodeOutputs{target_name: "produce", paths: ["relative/artifact.o"]}]
        rejected: mutable bool = false
        process_started: mutable bool = false
        catch execute_build_graph_serial_with_outputs(graph, output_sets):
            ok result:
                process_started <- result.nodes[0].started
            error failure:
                rejected <- failure == BuildExecutionError.OutputPathInvalid

        duplicate_outputs: darray[BuildExecutionNodeOutputs] = [BuildExecutionNodeOutputs{target_name: "produce", paths: [marker_text, marker_text]}]
        duplicate_rejected: mutable bool = false
        catch execute_build_graph_serial_with_outputs(graph, duplicate_outputs):
            ok result:
                process_started <- result.nodes[0].started
            error failure:
                duplicate_rejected <- failure == BuildExecutionError.OutputPathInvalid

        marker_absent: bool = not is_file(marker)
        graph_unchanged: bool = graph.state == BuildGraphState.Planned
        removed_directory: bool = try remove_directory(temporary) else false
        assert rejected and duplicate_rejected and not process_started and marker_absent and graph_unchanged
        assert removed_directory
