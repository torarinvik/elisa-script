include "../../src/runtime/build_executor_model.elisa"

using EsBuild
using EsBuildExecutor
using EsProcess


@test
def build_executor_preflights_supported_process_command_subset() -> void:
    can Memory.Allocate, Abort.Panic:
        skipped: BuildExecutionNodeResult = BuildExecutionNodeResult{target_name: "skipped"}
        assert not skipped.started and skipped.failure == BuildExecutionFailureKind.None

        portable: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/cc",
            working_directory: "build",
            environment: ["LC_ALL", "C", "TZ", "UTC"],
            environment_mode: ProcessEnvironmentMode.Inherit,
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 60000000u64,
            capture_output_limit_bytes: 1048576
        }
        assert build_executor_command_supported(portable)

        replaced_environment: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/cc",
            environment_mode: ProcessEnvironmentMode.Replace,
            stdin_mode: ProcessStdioMode.Null,
            timeout_micros: 60000000u64
        }
        assert not build_executor_command_supported(replaced_environment)

        inherited_stdin: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/cc",
            stdin_mode: ProcessStdioMode.Inherit,
            timeout_micros: 60000000u64
        }
        assert not build_executor_command_supported(inherited_stdin)

        uncapped: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/cc",
            stdin_mode: ProcessStdioMode.Null
        }
        assert not build_executor_command_supported(uncapped)


@test
def build_executor_rejects_late_unsupported_command_before_any_launch() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Process.Run, File.Read, File.Write, Directory.Write:
        temporary: Path = try temp_directory("build-executor-preflight") else err:
            assert false
            return
        marker: Path = temporary.joinpath("must-not-exist")
        marker_text: sview = f"{marker}"
        first: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/touch",
            arguments: [marker_text],
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        unsupported: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/true",
            environment: ["PATH", "/usr/bin"],
            environment_mode: ProcessEnvironmentMode.Replace,
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        graph: mutable BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "marker", command: first, fingerprint: 1},
            BuildNode{name: "unsupported", command: unsupported, dependencies: [0], fingerprint: 2}
        ]}

        rejected: mutable bool = false
        process_started: mutable bool = false
        catch execute_build_graph_serial(graph):
            ok result:
                process_started <- result.nodes[0].started
            error failure:
                rejected <- failure == BuildExecutionError.UnsupportedCommand

        marker_absent: bool = not is_file(marker)
        graph_unchanged: bool = graph.state == BuildGraphState.Planned
        removed_marker: mutable bool = true
        if not marker_absent:
            removed_marker <- try remove_path(marker) else false
        removed_directory: bool = try remove_directory(temporary) else false
        assert rejected and not process_started and marker_absent and graph_unchanged and removed_marker and removed_directory


@test
def build_executor_nonzero_exit_cancels_dependent_launches() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Process.Run, File.Read, File.Write, Directory.Write:
        temporary: Path = try temp_directory("build-executor-failure") else err:
            assert false
            return
        marker: Path = temporary.joinpath("dependent-must-not-run")
        marker_text: sview = f"{marker}"
        failing_command: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/false",
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        dependent_command: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/touch",
            arguments: [marker_text],
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 1024
        }
        graph: mutable BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "fail", command: failing_command, fingerprint: 1},
            BuildNode{name: "dependent", command: dependent_command, dependencies: [0], fingerprint: 2}
        ]}

        completed: mutable bool = false
        execution: mutable BuildExecutionResult = BuildExecutionResult{}
        catch execute_build_graph_serial(graph):
            ok result:
                execution <- result
                completed <- true
            error _:
                completed <- false

        marker_absent: bool = not is_file(marker)
        removed_marker: mutable bool = true
        if not marker_absent:
            removed_marker <- try remove_path(marker) else false
        removed_directory: bool = try remove_directory(temporary) else false
        assert completed and execution.graph_state == BuildGraphState.Failed
        assert execution.nodes.count == 2
        assert execution.nodes[0].started and execution.nodes[0].failure == BuildExecutionFailureKind.NonzeroExit
        assert execution.nodes[0].exit_status == 1
        assert not execution.nodes[1].started and execution.nodes[1].failure == BuildExecutionFailureKind.None
        assert graph.nodes[1].state == BuildNodeState.Cancelled and marker_absent
        assert removed_marker and removed_directory
