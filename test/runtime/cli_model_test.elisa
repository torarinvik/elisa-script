include "../../src/runtime/cli_model.elisa"

using EsCli


@test
def typed_cli_parser_rejects_embedded_nul_in_every_raw_argument() -> void:
    can Memory.Allocate, Abort.Panic:
        invalid_option: mutable bool = false
        catch parse_cli_arguments(["--color\0", "never", "tool.elisascript"]):
            ok invocation:
                assert false
            error failure:
                assert failure == CliContractError.EmbeddedNul
                invalid_option <- true
        assert invalid_option

        invalid_option_value: mutable bool = false
        catch parse_cli_arguments(["--color", "never\0", "tool.elisascript"]):
            ok invocation:
                assert false
            error failure:
                assert failure == CliContractError.EmbeddedNul
                invalid_option_value <- true
        assert invalid_option_value


@test
def typed_cli_test_report_formats_are_mode_and_color_bounded() -> void:
    can Memory.Allocate, Abort.Panic:
        json: CliInvocation = parse_cli_arguments(["--format", "json", "--test", "suite.elisascript"])
        assert json.mode == CliMode.Test
        assert json.report_format == CliReportFormat.Json
        junit: CliInvocation = parse_cli_arguments(["--test", "--format", "junit", "suite.elisascript"])
        assert junit.report_format == CliReportFormat.Junit
        human: CliInvocation = parse_cli_arguments(["--format", "human", "suite.elisascript"])
        assert human.report_format == CliReportFormat.Human

        duplicate_format: mutable bool = false
        catch parse_cli_arguments(["--format", "json", "--format", "junit", "--test", "suite.elisascript"]):
            ok invocation:
                assert false
            error failure:
                assert failure == CliContractError.DuplicateOption
                duplicate_format <- true
        assert duplicate_format

        invalid_format: mutable bool = false
        catch parse_cli_arguments(["--format", "csv", "--test", "suite.elisascript"]):
            ok invocation:
                assert false
            error failure:
                assert failure == CliContractError.InvalidReportFormat
                invalid_format <- true
        assert invalid_format

        missing_format: mutable bool = false
        catch parse_cli_arguments(["--format"]):
            ok invocation:
                assert false
            error failure:
                assert failure == CliContractError.MissingOptionValue
                missing_format <- true
        assert missing_format

        format_unavailable: mutable bool = false
        catch parse_cli_arguments(["--format", "json", "suite.elisascript"]):
            ok invocation:
                assert false
            error failure:
                assert failure == CliContractError.ReportFormatUnavailable
                format_unavailable <- true
        assert format_unavailable

        color_not_applicable: mutable bool = false
        catch parse_cli_arguments(["--color", "always", "--format", "junit", "--test", "suite.elisascript"]):
            ok invocation:
                assert false
            error failure:
                assert failure == CliContractError.ColorNotApplicable
                color_not_applicable <- true
        assert color_not_applicable


@test
def typed_cli_test_selection_is_explicit_bounded_and_unique() -> void:
    can Memory.Allocate, Abort.Panic:
        selected: CliInvocation = parse_cli_arguments(["--test", "--select", "suite/second", "--select", "suite/first", "suite.elisascript"])
        assert selected.mode == CliMode.Test
        assert selected.test_selection.count == 2
        assert selected.test_selection[0] == "suite/second"
        assert selected.test_selection[1] == "suite/first"

        missing_value: mutable bool = false
        catch parse_cli_arguments(["--test", "--select"]):
            ok invocation:
                assert false
            error failure:
                assert failure == CliContractError.MissingOptionValue
                missing_value <- true
        assert missing_value

        duplicate_selection: mutable bool = false
        catch parse_cli_arguments(["--test", "--select", "suite/first", "--select", "suite/first", "suite.elisascript"]):
            ok invocation:
                assert false
            error failure:
                assert failure == CliContractError.DuplicateTestSelection
                duplicate_selection <- true
        assert duplicate_selection

        invalid_selection: mutable bool = false
        catch parse_cli_arguments(["--test", "--select", "", "suite.elisascript"]):
            ok invocation:
                assert false
            error failure:
                assert failure == CliContractError.TestSelectionInvalid
                invalid_selection <- true
        assert invalid_selection

        selection_unavailable: mutable bool = false
        catch parse_cli_arguments(["--select", "suite/first", "suite.elisascript"]):
            ok invocation:
                assert false
            error failure:
                assert failure == CliContractError.TestSelectionUnavailable
                selection_unavailable <- true
        assert selection_unavailable
