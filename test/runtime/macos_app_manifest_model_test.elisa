include "../../src/runtime/encoding.elisa"
include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../src/runtime/json_lexer_model.elisa"
include "../../src/runtime/json_parse_model.elisa"
include "../../src/runtime/macos_app_manifest_model.elisa"

using EsData
using EsJson
using EsJsonLex
using EsJsonParse
using EsMacosAppManifest


def app_manifest_settings(source: sview, project_name: sview) -> MacosAppSettings error[JsonLexError, JsonParseError, JsonContractError, MacosAppManifestError] can[Memory.Allocate, Abort.Panic]:
    keep_last: JsonPolicy = JsonPolicy{duplicate_keys: JsonDuplicateKeyPolicy.KeepLast}
    lexed: JsonLexedSource = lex_json(source, DataDecodeLimits{}, keep_last)
    document: JsonDocument = parse_json_document(lexed)
    return decode_macos_app_settings(document, project_name)


def app_manifest_rejects(source: sview, project_name: sview, expected: MacosAppManifestError) -> bool error[JsonLexError, JsonParseError, JsonContractError] can[Memory.Allocate, Abort.Panic]:
    keep_last: JsonPolicy = JsonPolicy{duplicate_keys: JsonDuplicateKeyPolicy.KeepLast}
    lexed: JsonLexedSource = lex_json(source, DataDecodeLimits{}, keep_last)
    document: JsonDocument = parse_json_document(lexed)
    rejected: mutable bool = false
    catch decode_macos_app_settings(document, project_name):
        ok settings:
            _ = settings
        error failure:
            rejected <- failure == expected
    return rejected


@test
def applies_manifest_and_project_defaults() -> void can[Memory.Allocate, Abort.Panic]:
    settings: MacosAppSettings = app_manifest_settings("{}", "Maze Game")
    assert bytes_view(settings.name) == "Maze Game"
    assert bytes_view(settings.bundle_id) == "org.elisa.maze-game"
    assert bytes_view(settings.output_setting) == "build/Maze Game"
    assert bytes_view(settings.window_title) == "Maze Game"
    assert settings.window_width == 1280 and settings.window_height == 720

    manifest_name: MacosAppSettings = app_manifest_settings("{\"name\":\"Manifest Name\"}", "Project Directory")
    assert bytes_view(manifest_name.name) == "Manifest Name"
    assert bytes_view(manifest_name.window_title) == "Manifest Name"
    assert bytes_view(manifest_name.bundle_id) == "org.elisa.manifest-name"


@test
def applies_explicit_title_bundle_output_and_window_settings() -> void can[Memory.Allocate, Abort.Panic]:
    settings: MacosAppSettings = app_manifest_settings("{\"name\":\"Ignored\",\"output\":\"release/Game\",\"application\":{\"title\":\" ..My 🧩 Game.. \",\"bundle_id\":\"org.example.game\",\"width\":16384,\"height\":1}}", "Project")
    assert bytes_view(settings.name) == "My  Game"
    assert bytes_view(settings.bundle_id) == "org.example.game"
    assert bytes_view(settings.output_setting) == "release/Game"
    assert bytes_view(settings.window_title) == " ..My 🧩 Game.. "
    assert settings.window_width == 16384 and settings.window_height == 1


@test
def duplicate_manifest_keys_follow_python_json_last_value_policy() -> void can[Memory.Allocate, Abort.Panic]:
    settings: MacosAppSettings = app_manifest_settings("{\"name\":\"First\",\"name\":\"Last\",\"application\":{\"title\":\"Earlier\",\"title\":\"Final\"}}", "Project")
    assert bytes_view(settings.name) == "Final"


@test
def rejects_invalid_roots_fields_and_dimensions() -> void can[Memory.Allocate, Abort.Panic]:
    assert app_manifest_rejects("[]", "Project", MacosAppManifestError.InvalidManifestRoot)
    assert app_manifest_rejects("{\"application\":null}", "Project", MacosAppManifestError.InvalidApplication)
    assert app_manifest_rejects("{\"application\":{\"title\":\"\\u00a0\\u3000\"}}", "Project", MacosAppManifestError.InvalidTextField)
    assert app_manifest_rejects("{\"application\":{\"title\":\"...🚀...\"}}", "Project", MacosAppManifestError.InvalidApplicationName)
    assert app_manifest_rejects("{\"output\":\"\"}", "Project", MacosAppManifestError.InvalidOutput)
    assert app_manifest_rejects("{\"output\":\"\",\"application\":{\"bundle_id\":1,\"width\":0}}", "Project", MacosAppManifestError.InvalidOutput)
    assert app_manifest_rejects("{\"output\":\"bad\\u0000path\"}", "Project", MacosAppManifestError.InvalidOutput)
    assert app_manifest_rejects("{\"application\":{\"bundle_id\":1}}", "Project", MacosAppManifestError.InvalidTextField)
    assert app_manifest_rejects("{\"application\":{\"width\":true}}", "Project", MacosAppManifestError.InvalidWindowDimension)
    assert app_manifest_rejects("{\"application\":{\"width\":1.0}}", "Project", MacosAppManifestError.InvalidWindowDimension)
    assert app_manifest_rejects("{\"application\":{\"width\":16385}}", "Project", MacosAppManifestError.InvalidWindowDimension)
    assert app_manifest_rejects("{\"application\":{\"height\":0}}", "Project", MacosAppManifestError.InvalidWindowDimension)


@test
def requires_python_compatible_strict_json_policy() -> void can[Memory.Allocate, Abort.Panic]:
    permissive: JsonPolicy = JsonPolicy{duplicate_keys: JsonDuplicateKeyPolicy.KeepLast, allow_comments: true}
    lexed: JsonLexedSource = lex_json("{}", DataDecodeLimits{}, permissive)
    document: JsonDocument = parse_json_document(lexed)
    rejected: mutable bool = false
    catch decode_macos_app_settings(document, "Project"):
        ok settings:
            _ = settings
        error failure:
            rejected <- failure == MacosAppManifestError.InvalidJsonPolicy
    assert rejected
