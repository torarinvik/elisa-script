include "../../ports/elisa-engine/scripts/elisa_package_image_probe_model.elisa"

using EsElisaPackageImageProbe


def package_image_probe_rejects(data: darray[u8], expected: ImageProbeError) -> bool can[Memory.Allocate, Abort.Panic]:
    observed: mutable bool = false
    catch encoded_image_dimensions(data):
        ok dimensions:
            _ = dimensions
        error failure:
            observed <- failure == expected
    return observed


def package_image_png_fixture(width: u32, height: u32) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    return [
        137u8, 80u8, 78u8, 71u8, 13u8, 10u8, 26u8, 10u8,
        0u8, 0u8, 0u8, 13u8, 73u8, 72u8, 68u8, 82u8,
        (width >> 24).u8(), ((width >> 16) & 255u32).u8(), ((width >> 8) & 255u32).u8(), (width & 255u32).u8(),
        (height >> 24).u8(), ((height >> 16) & 255u32).u8(), ((height >> 8) & 255u32).u8(), (height & 255u32).u8(),
        8u8, 6u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
    ]


def package_image_jpeg_fixture() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    return [255u8, 216u8, 255u8, 192u8, 0u8, 8u8, 8u8, 0u8, 2u8, 0u8, 3u8, 1u8]


def ktx2_test_write_u32(data: mutable darray[u8]&, offset: usize, value: u32) -> void:
    data[offset] <- (value & 255u32).u8()
    data[offset + 1] <- ((value >> 8) & 255u32).u8()
    data[offset + 2] <- ((value >> 16) & 255u32).u8()
    data[offset + 3] <- (value >> 24).u8()


def ktx2_test_write_u64(data: mutable darray[u8]&, offset: usize, value: u64) -> void:
    data[offset] <- value.u8()
    data[offset + 1] <- (value >> 8).u8()
    data[offset + 2] <- (value >> 16).u8()
    data[offset + 3] <- (value >> 24).u8()
    data[offset + 4] <- (value >> 32).u8()
    data[offset + 5] <- (value >> 40).u8()
    data[offset + 6] <- (value >> 48).u8()
    data[offset + 7] <- (value >> 56).u8()


def ktx2_test_read_u32(data: darray[u8]&, offset: usize) -> u32:
    return data[offset].u32() | (data[offset + 1].u32() << 8) | (data[offset + 2].u32() << 16) | (data[offset + 3].u32() << 24)


def ktx2_test_read_u64(data: darray[u8]&, offset: usize) -> u64:
    return data[offset].u64() | (data[offset + 1].u64() << 8) | (data[offset + 2].u64() << 16) | (data[offset + 3].u64() << 24) | (data[offset + 4].u64() << 32) | (data[offset + 5].u64() << 40) | (data[offset + 6].u64() << 48) | (data[offset + 7].u64() << 56)


def package_image_ktx2_fixture(scheme: u32 = 0u32, with_key_values: bool = false, hdr_profile: bool = false, etc1s_profile: bool = false) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    kvd_end: usize = 148 if not with_key_values else 156
    sgd_offset: usize = ((kvd_end + 7) / 8) * 8 if etc1s_profile else 0
    metadata_end: usize = sgd_offset + 4 if etc1s_profile else kvd_end
    level_offset: usize = ((metadata_end + 15) / 16) * 16 if scheme == 0u32 else metadata_end
    level_length: usize = 1 if etc1s_profile else 16
    fixture_length: usize = level_offset + level_length
    data: mutable darray[u8] = []
    for _ in 0..<fixture_length |data|:
        data.push(0u8)
    data[0] <- 171u8
    data[1] <- 75u8
    data[2] <- 84u8
    data[3] <- 88u8
    data[4] <- 32u8
    data[5] <- 50u8
    data[6] <- 48u8
    data[7] <- 187u8
    data[8] <- 13u8
    data[9] <- 10u8
    data[10] <- 26u8
    data[11] <- 10u8
    ktx2_test_write_u32(data, 12, 0u32 if not hdr_profile else 1000066000u32)
    ktx2_test_write_u32(data, 16, 1u32)
    ktx2_test_write_u32(data, 20, 4u32)
    ktx2_test_write_u32(data, 24, 4u32)
    ktx2_test_write_u32(data, 36, 1u32)
    ktx2_test_write_u32(data, 40, 1u32)
    ktx2_test_write_u32(data, 44, scheme)
    ktx2_test_write_u32(data, 48, 104u32)
    ktx2_test_write_u32(data, 52, 44u32)
    if with_key_values:
        ktx2_test_write_u32(data, 56, 148u32)
        ktx2_test_write_u32(data, 60, 8u32)
    if etc1s_profile:
        ktx2_test_write_u64(data, 64, sgd_offset.u64())
        ktx2_test_write_u64(data, 72, 4u64)
    ktx2_test_write_u32(data, 104, 44u32)
    data[112] <- 2u8
    data[114] <- 40u8
    data[116] <- 166u8
    data[116] <- 163u8 if etc1s_profile
    data[116] <- 167u8 if hdr_profile
    data[117] <- 1u8
    data[118] <- 1u8
    data[120] <- 3u8
    data[121] <- 3u8
    data[124] <- 8u8 if etc1s_profile else 16u8
    data[134] <- 63u8 if etc1s_profile else 127u8
    data[135] <- 128u8 if hdr_profile else 0u8
    data[144] <- 255u8
    data[145] <- 255u8
    data[146] <- 255u8
    data[147] <- 255u8
    if hdr_profile:
        ktx2_test_write_u32(data, 144, 0x3f800000u32)
    if etc1s_profile:
        ktx2_test_write_u32(data, 144, 0xffffffffu32)
    if with_key_values:
        data[148] <- 3u8
        data[152] <- 97u8
        data[153] <- 0u8
        data[154] <- 1u8
    ktx2_test_write_u64(data, 80, level_offset.u64())
    ktx2_test_write_u64(data, 88, level_length.u64())
    ktx2_test_write_u64(data, 96, 0u64 if etc1s_profile else 16u64)
    return data


@test
def package_image_probe_reads_png_jpeg_and_ktx2_dimensions() -> void can[Memory.Allocate, Abort.Panic]:
    png: darray[u8] = package_image_png_fixture(4u32, 3u32)
    png_dimensions: Dimensions = try encoded_image_dimensions(png)
    assert png_dimensions.width == 4u32 and png_dimensions.height == 3u32
    png_only_dimensions: Dimensions = try png_jpeg_dimensions(png)
    assert png_only_dimensions.width == 4u32 and png_only_dimensions.height == 3u32

    jpeg: darray[u8] = package_image_jpeg_fixture()
    jpeg_dimensions: Dimensions = try encoded_image_dimensions(jpeg)
    assert jpeg_dimensions.width == 3u32 and jpeg_dimensions.height == 2u32

    jpeg_with_metadata: darray[u8] = [
        255u8, 216u8, 255u8, 224u8, 0u8, 4u8, 0u8, 0u8,
        255u8, 255u8, 192u8, 0u8, 8u8, 8u8, 0u8, 2u8, 0u8, 3u8, 1u8
    ]
    metadata_dimensions: Dimensions = try encoded_image_dimensions(jpeg_with_metadata)
    assert metadata_dimensions.width == 3u32 and metadata_dimensions.height == 2u32

    ktx2: darray[u8] = package_image_ktx2_fixture()
    ktx2_dimensions: Dimensions = try encoded_image_dimensions(ktx2)
    assert ktx2_dimensions.width == 4u32 and ktx2_dimensions.height == 4u32

    ktx2_with_metadata: darray[u8] = package_image_ktx2_fixture(with_key_values: true)
    metadata_ktx2_dimensions: Dimensions = try encoded_image_dimensions(ktx2_with_metadata)
    assert metadata_ktx2_dimensions.width == 4u32 and metadata_ktx2_dimensions.height == 4u32

    ktx2_hdr: darray[u8] = package_image_ktx2_fixture(scheme: 2u32, hdr_profile: true)
    hdr_dimensions: Dimensions = try encoded_image_dimensions(ktx2_hdr)
    assert hdr_dimensions.width == 4u32 and hdr_dimensions.height == 4u32

    ktx2_etc1s: darray[u8] = package_image_ktx2_fixture(scheme: 1u32, etc1s_profile: true)
    etc1s_dimensions: Dimensions = try encoded_image_dimensions(ktx2_etc1s)
    assert etc1s_dimensions.width == 4u32 and etc1s_dimensions.height == 4u32


@test
def ktx2_container_updates_sorted_key_values_and_preserves_payloads() -> void can[Memory.Allocate, Abort.Panic]:
    with_metadata: darray[u8] = package_image_ktx2_fixture(with_key_values: true)
    updated_value: darray[u8] = [17u8]
    replaced_key: darray[u8] = try EsEngineKtx2Container::with_key_value(with_metadata, "a", updated_value)
    assert ktx2_test_read_u32(replaced_key, 60) == 8u32
    assert replaced_key[154] == 17u8
    replaced_dimensions: Dimensions = try encoded_image_dimensions(replaced_key)
    assert replaced_dimensions.width == 4u32 and replaced_dimensions.height == 4u32

    added_key: darray[u8] = try EsEngineKtx2Container::with_key_value(with_metadata, "z", updated_value)
    assert ktx2_test_read_u32(added_key, 60) == 16u32
    assert added_key[152] == 97u8 and added_key[160] == 122u8
    assert ktx2_test_read_u64(added_key, 80) == 176u64
    assert added_key.count == 192
    added_dimensions: Dimensions = try encoded_image_dimensions(added_key)
    assert added_dimensions.width == 4u32 and added_dimensions.height == 4u32

    inserted_before: darray[u8] = try EsEngineKtx2Container::with_key_value(with_metadata, "0", updated_value)
    assert inserted_before[152] == 48u8 and inserted_before[160] == 97u8
    before_dimensions: Dimensions = try encoded_image_dimensions(inserted_before)
    assert before_dimensions.width == 4u32 and before_dimensions.height == 4u32

    etc1s: darray[u8] = package_image_ktx2_fixture(scheme: 1u32, etc1s_profile: true)
    etc1s_with_key: darray[u8] = try EsEngineKtx2Container::with_key_value(etc1s, "a", updated_value)
    assert ktx2_test_read_u64(etc1s_with_key, 64) == 160u64
    assert ktx2_test_read_u64(etc1s_with_key, 80) == 164u64
    etc1s_updated_dimensions: Dimensions = try encoded_image_dimensions(etc1s_with_key)
    assert etc1s_updated_dimensions.width == 4u32 and etc1s_updated_dimensions.height == 4u32


@test
def package_image_probe_rejects_invalid_size_format_and_dimensions() -> void can[Memory.Allocate, Abort.Panic]:
    assert package_image_probe_rejects([], ImageProbeError.ImageSizeRejected)
    assert package_image_probe_rejects([0u8, 1u8, 2u8, 3u8], ImageProbeError.UnsupportedOrMalformedImage)
    zero_sized_png: darray[u8] = package_image_png_fixture(0u32, 3u32)
    oversized_png: darray[u8] = package_image_png_fixture(8193u32, 3u32)
    assert package_image_probe_rejects(zero_sized_png, ImageProbeError.ImageDimensionsOutOfRange)
    assert package_image_probe_rejects(oversized_png, ImageProbeError.ImageDimensionsOutOfRange)

    malformed_jpeg: darray[u8] = [255u8, 216u8, 255u8, 224u8, 0u8, 1u8]
    assert package_image_probe_rejects(malformed_jpeg, ImageProbeError.UnsupportedOrMalformedImage)

    malformed_ktx2: mutable darray[u8] = package_image_ktx2_fixture()
    malformed_ktx2[116] <- 0u8
    assert package_image_probe_rejects(malformed_ktx2, ImageProbeError.UnsupportedOrMalformedImage)

    malformed_key_padding: mutable darray[u8] = package_image_ktx2_fixture(with_key_values: true)
    malformed_key_padding[155] <- 1u8
    assert package_image_probe_rejects(malformed_key_padding, ImageProbeError.UnsupportedOrMalformedImage)
