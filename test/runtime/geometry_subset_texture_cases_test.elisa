include "../../src/testing/geometry_subset_texture_cases.elisa"

using EsGeometrySubsetTextureCases


@test
def geometry_subset_texture_cases_preserve_order_and_loader_edges() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    generated: darray[Case] = cases()
    expected_names: darray[sview] = [
        "texture-count-zero.pkg", "texture-count-mismatch.pkg", "texture-too-many.pkg",
        "texture-stride.pkg", "texture-no-count.pkg", "texture-no-names.pkg",
        "texture-no-stride.pkg", "texture-no-records.pkg", "texture-short.pkg",
        "texture-long.pkg", "texture-without-materials.pkg", "texture-duplicate.pkg",
        "texture-mesh.pkg", "texture-manifest.pkg", "texture-empty-name.pkg",
        "texture-uppercase.pkg", "texture-path.pkg", "texture-nul.pkg",
        "texture-long-name.pkg", "texture-beyond.pkg", "texture-unsampled.pkg",
        "mask-without-base.pkg", "occlusion-without-surface.pkg"
    ]
    assert generated.count == expected_names.count
    for index in 0..<generated.count |generated, expected_names|:
        assert generated[index].file_name == expected_names[index]
        assert generated[index].verdict == Verdict.Reject
        assert generated[index].expected_diagnostic != ""

    assert generated[1].has_texture_count_override
    assert generated[1].texture_count_override == 2u32
    assert generated[2].texture_names.count == 65
    assert generated[2].references[0].values == [1u32, 2u32, 3u32, 4u32]
    assert generated[4].omitted_fields == ["texture_count"]
    assert not generated[10].has_material_records
    assert generated[11].texture_names == ["albedo", "albedo"]
    assert generated[17].texture_names[0] == "albedo\0x"
    assert generated[21].materials[0].alpha_mode == 1u32
    assert generated[22].materials[1].flags == 3u32
