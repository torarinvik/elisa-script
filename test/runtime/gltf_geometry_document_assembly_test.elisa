include "../../ports/elisa-engine/scripts/gltf_material_bindings_model.elisa"

using EsEngineGltfAccessor
using EsEngineGltfGeometryAssembly
using EsEngineGltfMaterialBindings
using EsEngineGltfVertexStreams
using EsJson


@test
def document_assembly_composes_ordered_nodes_with_shared_accessor_cache() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    source: sview = "{\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":1,\"componentType\":5121,\"count\":3,\"type\":\"SCALAR\"}],\"bufferViews\":[{\"byteOffset\":0,\"byteLength\":36},{\"byteOffset\":36,\"byteLength\":3}],\"meshes\":[{\"primitives\":[{\"indices\":1,\"attributes\":{\"POSITION\":0}}]}],\"nodes\":[{\"mesh\":0,\"translation\":[2.0,0.0,0.0]},{\"mesh\":0,\"translation\":[5.0,0.0,0.0]}],\"scenes\":[{\"nodes\":[0,1]}],\"scene\":0}"
    document: JsonDocument = try EsEngineGltfAccessor::parse_document(source) else failure:
        _ = failure
        assert false
        JsonDocument{}

    buffer: mutable darray[u8] = []
    for _ in 0..<36 |buffer|:
        buffer.push(0u8)
    buffer.push(0u8)
    buffer.push(1u8)
    buffer.push(2u8)

    cache: mutable VertexSourceCache = new_vertex_source_cache()
    assembled: mutable bool = false
    catch assemble_document_with_materials(document, buffer, cache):
        ok result:
            assembled <- result.materials.bindings.slot_count == 1 and result.materials.bindings.material_indices_by_mesh[0] == [0u]
            if assembled:
                assembled <- result.materials.records.records.count == 0 and result.materials.textures.materials.count == 0
            if assembled:
                assembled <- result.images.images.count == 0 and result.images.total_bytes == 0
            if assembled:
                assembled <- result.geometry.placements.count == 2 and result.geometry.source_vertex_count == 6 and result.geometry.index_count == 6
            if assembled:
                assembled <- result.geometry.placements[0].geometry.blocks.count == 1 and result.geometry.placements[1].geometry.blocks.count == 1 and result.geometry.placements[0].geometry.primitives.count == 1 and result.geometry.placements[1].geometry.primitives.count == 1
            if assembled:
                assembled <- result.geometry.placements[0].placement.node_index == 0u and result.geometry.placements[1].placement.node_index == 1u
            if assembled:
                assembled <- result.geometry.placements[0].effective_transform.m03 == 2.0 and result.geometry.placements[1].effective_transform.m03 == 5.0
            if assembled:
                assembled <- result.geometry.placements[0].geometry.blocks[0].vertices.positions[2] == 0u8 and result.geometry.placements[0].geometry.blocks[0].vertices.positions[3] == 64u8
            if assembled:
                assembled <- result.geometry.placements[1].geometry.blocks[0].vertices.positions[2] == 160u8 and result.geometry.placements[1].geometry.blocks[0].vertices.positions[3] == 64u8
            if assembled:
                assembled <- result.geometry.placements[0].geometry.primitives[0].material_index == 0u and result.geometry.placements[1].geometry.primitives[0].material_index == 0u
        error failure:
            _ = failure
    assert assembled
    assert cache.entries.count == 1 and cache.source_vertex_count == 3
    assert cache.lookups == 2 and cache.hits == 1 and cache.misses == 1


@test
def document_assembly_rejects_singular_static_placement_in_skinned_scene() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    source: sview = "{\"meshes\":[{\"primitives\":[{}]}],\"nodes\":[{\"mesh\":0,\"skin\":0},{\"mesh\":0,\"scale\":[0.0,1.0,1.0]},{}],\"scenes\":[{\"nodes\":[0,1,2]}],\"scene\":0,\"skins\":[{\"joints\":[2]}]}"
    document: JsonDocument = try EsEngineGltfAccessor::parse_document(source) else failure:
        _ = failure
        assert false
        JsonDocument{}
    buffer: darray[u8] = []
    material_indices_by_mesh: darray[darray[usize]] = [[0u]]
    cache: mutable VertexSourceCache = new_vertex_source_cache()
    rejected: mutable bool = false
    catch assemble_document_placements(document, buffer, material_indices_by_mesh, cache):
        ok result:
            _ = result
        error failure:
            rejected <- failure == GeometryAssemblyError.SingularStaticPlacement
    assert rejected
