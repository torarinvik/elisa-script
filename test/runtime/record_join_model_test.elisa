include "../../src/ir/ir.elisa"

using EsRecordJoin


@test
def record_join_pair_count_groups_unsorted_duplicate_keys() -> void:
    for kind in [RecordJoinKind.Inner, RecordJoinKind.Left, RecordJoinKind.Right, RecordJoinKind.Full] |kind|:
        session: mutable RecordJoinSession = RecordJoinSession{policy: RecordJoinPolicy{kind: kind, max_rows: 8, max_pairs: 8, max_key_bytes: 64, max_value_bytes: 64}}
        _ = advance_record_join(session, RecordJoinEvent.Begin)
        _ = advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Right, "z-right", "r0")
        _ = advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Left, "shared", "l0")
        _ = advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Right, "shared", "r1")
        _ = advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Left, "a-left", "l1")
        _ = advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Left, "shared", "l2")
        _ = advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Right, "shared", "r2")
        _ = advance_record_join(session, RecordJoinEvent.Seal)
        expected_pairs: usize = 4 if kind == RecordJoinKind.Inner else 5 if kind == RecordJoinKind.Left or kind == RecordJoinKind.Right else 6
        can Memory.Allocate, Abort.Panic:
            assert record_join_pair_count(session) == expected_pairs


@test
def record_join_pair_count_rejects_cartesian_pair_overflow() -> void:
    session: mutable RecordJoinSession = RecordJoinSession{policy: RecordJoinPolicy{kind: RecordJoinKind.Inner, max_rows: 8, max_pairs: 3, max_key_bytes: 64, max_value_bytes: 64}}
    _ = advance_record_join(session, RecordJoinEvent.Begin)
    _ = advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Left, "shared", "l0")
    _ = advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Left, "shared", "l1")
    _ = advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Right, "shared", "r0")
    _ = advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Right, "shared", "r1")
    _ = advance_record_join(session, RecordJoinEvent.Seal)
    overflow_rejected: mutable bool = false
    can Memory.Allocate, Abort.Panic:
        catch record_join_pair_count(session):
            ok value:
                assert false
            error failure:
                assert failure == RecordJoinError.PairLimitExceeded
                overflow_rejected <- true
    assert overflow_rejected


@test
def record_join_admits_key_and_value_at_exact_byte_limits() -> void:
    session: mutable RecordJoinSession = RecordJoinSession{policy: RecordJoinPolicy{kind: RecordJoinKind.Inner, max_rows: 2, max_pairs: 1, max_key_bytes: 3, max_value_bytes: 2}}
    _ = advance_record_join(session, RecordJoinEvent.Begin)
    _ = advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Left, "abc", "xy")
    _ = advance_record_join(session, RecordJoinEvent.Seal)
    assert session.key_bytes == 3
    assert session.value_bytes == 2
    can Memory.Allocate, Abort.Panic:
        assert record_join_pair_count(session) == 0


@test
def record_join_rejects_forged_existing_ledger_before_add() -> void:
    session: mutable RecordJoinSession = RecordJoinSession{policy: RecordJoinPolicy{kind: RecordJoinKind.Inner, max_rows: 4, max_pairs: 4, max_key_bytes: 64, max_value_bytes: 64}, state: RecordJoinState.Collecting, rows: [RecordJoinRow{side: RecordJoinSide.Left, ordinal: 7, key: "bad", value: "value"}], left_count: 1, key_bytes: 3, value_bytes: 5}
    rejected: mutable bool = false
    can Memory.Allocate, Abort.Panic:
        catch advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Right, "valid", "new"):
            ok value:
                assert false
            error failure:
                assert failure == RecordJoinError.InvalidOrdinal
                rejected <- true
    assert rejected
    assert session.rows.count == 1
    assert session.right_count == 0
