include "../../src/runtime/stream_posix.elisa"

using EsRuntime


@test
def read_stream_budget_is_decoupled_from_bounded_memory_and_write_limits() -> void:
    assert file_stream_budget_valid(FileStreamMode.ReadBinary, FileStreamLimits::MAX_READ_BYTES)
    assert file_stream_budget_valid(FileStreamMode.ReadBinary, FILE_STREAM_DEFAULT_MAX_BYTES + 1)
    assert file_stream_budget_valid(FileStreamMode.ReadText, FILE_STREAM_DEFAULT_MAX_BYTES)
    assert file_stream_budget_valid(FileStreamMode.WriteBinary, FILE_STREAM_DEFAULT_MAX_BYTES)
    assert not file_stream_budget_valid(FileStreamMode.ReadBinary, FileStreamLimits::MAX_READ_BYTES + 1)
    assert not file_stream_budget_valid(FileStreamMode.WriteBinary, FILE_STREAM_DEFAULT_MAX_BYTES + 1)
    assert not file_stream_budget_valid(FileStreamMode.ReadBinary, 0)
    assert not file_stream_budget_valid(FileStreamMode.WriteText, 0)
