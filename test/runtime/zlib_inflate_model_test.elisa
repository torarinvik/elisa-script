include "../../ports/elisa-engine/scripts/render_quality_model.elisa"

using EsZlibInflate
using EsEngineRenderQuality


def zlib_inflate_test_equal(actual: darray[u8]&, expected: darray[u8]&) -> bool:
    return false if actual.count != expected.count
    for index in 0..<expected.count |actual, expected|:
        return false if actual[index] != expected[index]
    return true


def zlib_inflate_test_rejects(data: darray[u8], expected: InflateError, max_output_bytes: usize = Limits::MAX_OUTPUT_BYTES) -> bool can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch inflate_zlib(data, max_output_bytes):
        ok output:
            _ = output
        error failure:
            rejected <- failure == expected
    return rejected


@test
def zlib_inflate_decodes_stored_deflate_blocks_and_validates_adler32() -> void can[Memory.Allocate, Abort.Panic]:
    stored: darray[u8] = [0x78u8, 0x01u8, 0x01u8, 0x05u8, 0x00u8, 0xfau8, 0xffu8, 0x68u8, 0x65u8, 0x6cu8, 0x6cu8, 0x6fu8, 0x06u8, 0x2cu8, 0x02u8, 0x15u8]
    expected: darray[u8] = [104u8, 101u8, 108u8, 108u8, 111u8]
    assert zlib_inflate_test_equal(inflate_zlib(stored), expected)


@test
def zlib_inflate_decodes_fixed_huffman_blocks() -> void can[Memory.Allocate, Abort.Panic]:
    fixed: darray[u8] = [0x78u8, 0x9cu8, 0xcbu8, 0x48u8, 0xcdu8, 0xc9u8, 0xc9u8, 0x07u8, 0x00u8, 0x06u8, 0x2cu8, 0x02u8, 0x15u8]
    expected: darray[u8] = [104u8, 101u8, 108u8, 108u8, 111u8]
    assert zlib_inflate_test_equal(inflate_zlib(fixed), expected)


@test
def zlib_inflate_decodes_dynamic_huffman_png_idat() -> void can[Memory.Allocate, Abort.Panic]:
    # IDAT zlib bytes from ../elisa-engine/test/fixtures/sky_latlong.png.
    dynamic: darray[u8] = [
        0x78u8, 0xdau8, 0x0du8, 0xc3u8, 0x31u8, 0x11u8, 0xc0u8, 0x40u8,
        0x08u8, 0x00u8, 0x41u8, 0x64u8, 0x50u8, 0x52u8, 0x52u8, 0x52u8,
        0x52u8, 0x52u8, 0x52u8, 0x22u8, 0x21u8, 0x32u8, 0x5eu8, 0x46u8,
        0x64u8, 0x44u8, 0x46u8, 0x9cu8, 0xf1u8, 0xb7u8, 0x33u8, 0x2bu8,
        0x1au8, 0xffu8, 0x1au8, 0x9du8, 0xc1u8, 0x64u8, 0xb1u8, 0x39u8,
        0x14u8, 0xedu8, 0x6fu8, 0x8du8, 0xceu8, 0x60u8, 0xb2u8, 0xd8u8,
        0x1cu8, 0x8au8, 0x3eu8, 0xefu8, 0x1au8, 0x9du8, 0xc1u8, 0x64u8,
        0xb1u8, 0x39u8, 0x14u8, 0x3du8, 0x67u8, 0x8du8, 0xceu8, 0x60u8,
        0xb2u8, 0xd8u8, 0x1cu8, 0x5eu8, 0x62u8, 0xb3u8, 0x44u8, 0x61u8
    ]
    output: darray[u8] = inflate_zlib(dynamic, 132)
    assert output.count == 132
    frame: RenderFrame = reconstruct_png_zlib_scanlines(8, 4, RenderPixelFormat.Rgba8, dynamic)
    assert frame.width == 8 and frame.height == 4 and frame.pixels.count == 128


@test
def zlib_inflate_rejects_bad_headers_checksums_trailing_data_and_limits() -> void can[Memory.Allocate, Abort.Panic]:
    stored: darray[u8] = [0x78u8, 0x01u8, 0x01u8, 0x05u8, 0x00u8, 0xfau8, 0xffu8, 0x68u8, 0x65u8, 0x6cu8, 0x6cu8, 0x6fu8, 0x06u8, 0x2cu8, 0x02u8, 0x14u8]
    trailing: darray[u8] = [0x78u8, 0x01u8, 0x01u8, 0x05u8, 0x00u8, 0xfau8, 0xffu8, 0x68u8, 0x65u8, 0x6cu8, 0x6cu8, 0x6fu8, 0x06u8, 0x2cu8, 0x02u8, 0x15u8, 0x00u8]
    malformed_header: darray[u8] = [0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8]
    assert zlib_inflate_test_rejects(stored, InflateError.ChecksumMismatch)
    assert zlib_inflate_test_rejects(malformed_header, InflateError.InvalidHeader)
    assert zlib_inflate_test_rejects([0x78u8, 0x20u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8], InflateError.PresetDictionaryUnsupported)
    assert zlib_inflate_test_rejects([0x78u8, 0x01u8], InflateError.InputTruncated)
    assert zlib_inflate_test_rejects(trailing, InflateError.TrailingInput)
    assert zlib_inflate_test_rejects([0x78u8, 0x01u8, 0x01u8, 0x05u8, 0x00u8, 0xfau8, 0xffu8, 0x68u8, 0x65u8, 0x6cu8, 0x6cu8, 0x6fu8, 0x06u8, 0x2cu8, 0x02u8, 0x15u8], InflateError.OutputTooLarge, 4)
