include "../../src/testing/geometry_subset_package_cases_model.elisa"

using EsGeometrySubsetPackageCases


@test
def geometry_subset_sidecar_specifications_become_ordered_packages() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    generated: darray[GeneratedCase] = try sidecar_packages()
    expected_names: darray[sview] = [
        "normal-scale.pkg",
        "normal-scale-without-materials.pkg",
        "normal-scale-stride.pkg",
        "normal-scale-no-records.pkg",
        "normal-scale-count.pkg",
        "normal-scale-overflow.pkg",
        "normal-scale-nan.pkg",
        "normal-scale-infinite.pkg",
        "occlusion-strength.pkg",
        "occlusion-strength-without-materials.pkg",
        "occlusion-strength-stride.pkg",
        "occlusion-strength-no-records.pkg",
        "occlusion-strength-count.pkg",
        "occlusion-strength-negative.pkg",
        "occlusion-strength-overflow.pkg",
        "occlusion-strength-nan.pkg",
        "occlusion-strength-infinite.pkg",
        "clearcoat-factors.pkg",
        "clearcoat-factors-without-materials.pkg",
        "clearcoat-factors-stride.pkg",
        "clearcoat-factors-missing-data.pkg",
        "clearcoat-factors-count.pkg",
        "clearcoat-factor-negative.pkg",
        "clearcoat-roughness-overflow.pkg",
        "clearcoat-normal-scale-overflow.pkg",
        "clearcoat-normal-scale-nan.pkg"
    ]
    assert generated.count == expected_names.count
    for index in 0..<generated.count |generated, expected_names|:
        assert generated[index].file_name == expected_names[index]
        assert generated[index].package_bytes.count > 0

    normal: sview = bytes_view(generated[0].package_bytes)
    assert generated[0].verdict == Verdict.Accept
    assert generated[0].expected_diagnostic == ""
    assert normal.contains("material_slots=2\nsubset_count=2\nsubset_stride=12\n")
    assert normal.contains("slot_material_stride=48\nslot_materials_b64=")
    assert normal.contains("slot_normal_scale_stride=4\nslot_normal_scales_b64=")

    without_materials: sview = bytes_view(generated[1].package_bytes)
    assert generated[1].verdict == Verdict.Reject
    assert generated[1].expected_diagnostic == "invalid cooked slot normal scales"
    assert not without_materials.contains("slot_material_stride=")
    assert without_materials.contains("slot_normal_scales_b64=")

    missing_normal_data: sview = bytes_view(generated[3].package_bytes)
    assert missing_normal_data.contains("slot_normal_scale_stride=4\n")
    assert not missing_normal_data.contains("slot_normal_scales_b64=")

    normal_nan: sview = bytes_view(generated[6].package_bytes)
    normal_infinity: sview = bytes_view(generated[7].package_bytes)
    assert normal_nan.contains("slot_normal_scales_b64=AADAfw==\n")
    assert normal_infinity.contains("slot_normal_scales_b64=AACAfw==\n")

    clearcoat: sview = bytes_view(generated[17].package_bytes)
    assert generated[17].verdict == Verdict.Accept
    assert clearcoat.contains("slot_clearcoat_factor_stride=12\nslot_clearcoat_factors_b64=")
    assert generated[20].verdict == Verdict.Reject
    assert not bytes_view(generated[20].package_bytes).contains("slot_clearcoat_factors_b64=")
