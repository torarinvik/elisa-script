include "../../src/testing/geometry_subset_partition_cases.elisa"

using EsGeometrySubsetPartitionCases


@test
def geometry_subset_partition_fixtures_preserve_order_verdicts_and_diagnostics() -> void can[Memory.Allocate, Abort.Panic]:
    generated: darray[Case] = cases()
    expected_names: darray[sview] = [
        "legacy.pkg", "explicit-single.pkg", "unused-slot.pkg", "sixteen.pkg", "skinned.pkg",
        "gap.pkg", "overlap.pkg", "split-triangle.pkg", "empty-subset.pkg", "missing-slot.pkg",
        "short.pkg", "overrun.pkg", "wrapping.pkg", "triple-wrap.pkg", "seventeen.pkg",
        "seventeen-slots.pkg", "zero-slots.pkg", "count-mismatch.pkg", "stride.pkg",
        "no-slots.pkg", "no-records.pkg", "skinned-subsets.pkg", "skinned-single.pkg"
    ]
    assert generated.count == expected_names.count
    for index in 0..<generated.count |generated, expected_names|:
        assert generated[index].file_name == expected_names[index]

    assert generated[0].verdict == Verdict.Accept
    assert not generated[0].input.has_subsets
    assert generated[5].verdict == Verdict.Reject
    assert generated[5].expected_diagnostic == "subsets do not partition the index stream"
    assert generated[9].expected_diagnostic == "subset names a missing material slot"
    assert generated[14].input.subsets.count == 17
    assert generated[14].input.subsets[16].material_slot == 0u32
    assert generated[20].input.omitted_fields == ["subsets_b64"]
    assert generated[21].input.skinned
    for item in generated:
        assert (item.expected_diagnostic != "") == (item.verdict == Verdict.Reject)
