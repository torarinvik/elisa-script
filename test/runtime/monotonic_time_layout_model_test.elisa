# Pure metadata admission. No clock, sleep, process or native declaration.
include "../../src/runtime/monotonic_time_model.elisa"

using EsMonotonicTime


@test
def darwin_clock_layout_admission_checks_timestamp_and_scalar_widths() -> void:
    assert darwin64_clock_layout_supported(8, 8, 16, 4, 4)
    assert not darwin64_clock_layout_supported(4, 8, 16, 4, 4)
    assert not darwin64_clock_layout_supported(8, 4, 16, 4, 4)
    assert not darwin64_clock_layout_supported(8, 8, 8, 4, 4)
    assert not darwin64_clock_layout_supported(8, 8, 24, 4, 4)
    assert not darwin64_clock_layout_supported(8, 8, 16, 8, 4)
    assert not darwin64_clock_layout_supported(8, 8, 16, 4, 8)
    assert not darwin64_clock_layout_supported(0, 0, 0, 0, 0)
