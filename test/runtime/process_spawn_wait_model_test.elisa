# Pure literal statuses, independently formed from the Darwin wait macros.
# No child, debugger, group signal or actual wait occurs.
include "../../src/runtime/process_spawn_wait_model.elisa"

using EsProcessSpawnWait


@test
def spawn_wait_exits_include_reserved_looking_tool_statuses() -> void:
    can Memory.Allocate, Abort.Panic:
        for code in [0i64, 1i64, 125i64, 126i64, 127i64, 255i64]:
            status: i64 = code * 256
            assert classify(status) == Kind.Exited and terminal(status)
            decoded: i64 = try exit_status(status) else failure:
                assert false
                return
            assert decoded == code
            assert exact_reap(41, 41, status)


@test
def spawn_wait_signals_are_terminal_with_optional_core_flag() -> void:
    assert classify(9) == Kind.Signaled and terminal(9)
    killed: i64 = try exit_status(9) else failure:
        assert false
        return
    assert killed == 137
    assert classify(139) == Kind.Signaled and terminal(139)
    core: i64 = try exit_status(139) else failure:
        assert false
        return
    assert core == 139


@test
def spawn_wait_stops_continuations_and_malformed_words_are_not_reaps() -> void:
    can Memory.Allocate, Abort.Panic:
        # SIGSTOP << 8 | 127; Darwin continued is SIGCONT(19) << 8 | 127.
        for status in [4479i64, 4991i64]:
            assert classify(status) == Kind.NonTerminal
            assert not terminal(status) and not exact_reap(41, 41, status)
        for status in [-1i64, 65536i64, 128i64, 32i64, 265i64]:
            assert classify(status) == Kind.Invalid
            assert not terminal(status) and not exact_reap(41, 41, status)
    rejected: mutable bool = false
    catch exit_status(4991):
        ok _:
            assert false
        error failure:
            rejected <- failure == WaitError.NotTerminal
    assert rejected


@test
def spawn_wait_exact_pid_does_not_accept_any_positive_return() -> void:
    assert not exact_reap(42, 41, 0)
    assert not exact_reap(0, 41, 0)
    assert not exact_reap(-1, 41, 0)
    assert not exact_reap(0, 0, 0)
    assert not exact_reap(-1, -1, 0)
