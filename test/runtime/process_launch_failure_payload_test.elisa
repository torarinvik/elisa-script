# Primitive value transport only. No interpreter facade, native ABI or process.
include "../../src/runtime/process_launch_failure_model.elisa"

module EsProcessLaunchFailurePayloadFixture:
    private:
        def assert_invalid(payload: EsProcessLaunchFailure::Payload&) -> void:
            catch EsProcessLaunchFailure::from_payload(payload):
                ok _:
                    assert false
                error failure:
                    assert failure == EsProcessLaunchFailure::ReceiptError.InvalidReceipt

    public:
        @test
        def launch_failure_payload_pins_all_explicit_stage_codes() -> void:
            can Memory.Allocate, Abort.Panic:
                assert EsProcessLaunchFailure::PayloadSchema::VERSION == 1u8
                receipts: darray[EsProcessLaunchFailure::Receipt] = [
                    EsProcessLaunchFailure::Receipt{stage: EsProcessLaunchFailure::Stage.Admission},
                    EsProcessLaunchFailure::Receipt{stage: EsProcessLaunchFailure::Stage.Setup, code: 22},
                    EsProcessLaunchFailure::Receipt{stage: EsProcessLaunchFailure::Stage.AbortedSearch, code: 2, attempts: 1},
                    EsProcessLaunchFailure::Receipt{stage: EsProcessLaunchFailure::Stage.Spawn, code: 8, attempts: 1}
                ]
                for index in 0..<receipts.count:
                    payload: EsProcessLaunchFailure::Payload = try EsProcessLaunchFailure::to_payload(receipts[index]) else failure:
                        assert false
                        return
                    assert payload.stage == index.i64() + 1
                    decoded: EsProcessLaunchFailure::Receipt = try EsProcessLaunchFailure::from_payload(payload) else failure:
                        assert false
                        return
                    assert decoded.stage == receipts[index].stage
                    assert decoded.code == receipts[index].code
                    assert decoded.attempts == receipts[index].attempts and decoded.saw_denied == receipts[index].saw_denied


        @test
        def launch_failure_payload_copies_cause_before_owner_reuse() -> void:
            receipt: mutable EsProcessLaunchFailure::Receipt = EsProcessLaunchFailure::Receipt{stage: EsProcessLaunchFailure::Stage.Spawn, code: 13, attempts: 2, saw_denied: true}
            payload: EsProcessLaunchFailure::Payload = try EsProcessLaunchFailure::to_payload(receipt) else failure:
                assert false
                return
            assert payload.stage == 4 and payload.code == 13 and payload.attempts == 2 and payload.saw_denied
            receipt <- EsProcessLaunchFailure::Receipt{}
            decoded: EsProcessLaunchFailure::Receipt = try EsProcessLaunchFailure::from_payload(payload) else failure:
                assert false
                return
            assert EsProcessLaunchFailure::is_pristine(receipt)
            assert decoded.stage == EsProcessLaunchFailure::Stage.Spawn
            assert decoded.code == 13 and decoded.attempts == 2 and decoded.saw_denied


        @test
        def launch_failure_payload_aborted_search_still_has_no_native_cause() -> void:
            payload: EsProcessLaunchFailure::Payload = EsProcessLaunchFailure::Payload{stage: 3, code: 2, attempts: 1}
            receipt: EsProcessLaunchFailure::Receipt = try EsProcessLaunchFailure::from_payload(payload) else failure:
                assert false
                return
            assert receipt.stage == EsProcessLaunchFailure::Stage.AbortedSearch
            catch EsProcessLaunchFailure::native_cause(receipt):
                ok _:
                    assert false
                error failure:
                    assert failure == EsProcessLaunchFailure::ReceiptError.NoNativeCause


        @test
        def launch_failure_payload_rejects_wide_aliases_before_narrowing() -> void:
            can Memory.Allocate, Abort.Panic:
                payload: mutable EsProcessLaunchFailure::Payload = EsProcessLaunchFailure::Payload{stage: 2}
                for code in [-2147483649i64, 2147483648i64, 4294967298i64]:
                    payload.code <- code
                    assert_invalid(payload)
                payload.code <- 0
                for count in [-1i64, 4097i64, 4294967296i64, 9223372036854775807i64]:
                    payload.attempts <- count
                    assert_invalid(payload)
                payload.attempts <- 0
                for stage in [-1i64, 0i64, 5i64, 257i64, 9223372036854775807i64]:
                    payload.stage <- stage
                    assert_invalid(payload)


        @test
        def launch_failure_payload_empty_and_inconsistent_causes_are_rejected() -> void:
            receipt: EsProcessLaunchFailure::Receipt = EsProcessLaunchFailure::Receipt{}
            catch EsProcessLaunchFailure::to_payload(receipt):
                ok _:
                    assert false
                error failure:
                    assert failure == EsProcessLaunchFailure::ReceiptError.InvalidReceipt
            empty: EsProcessLaunchFailure::Payload = EsProcessLaunchFailure::Payload{}
            denied_without_history: EsProcessLaunchFailure::Payload = EsProcessLaunchFailure::Payload{stage: 4, code: 13, attempts: 1}
            lost_denial: EsProcessLaunchFailure::Payload = EsProcessLaunchFailure::Payload{stage: 4, code: 2, attempts: 1, saw_denied: true}
            assert_invalid(empty)
            assert_invalid(denied_without_history)
            assert_invalid(lost_denial)
            boundary: EsProcessLaunchFailure::Payload = EsProcessLaunchFailure::Payload{stage: 2, code: 2147483647}
            admitted: EsProcessLaunchFailure::Receipt = try EsProcessLaunchFailure::from_payload(boundary) else failure:
                assert false
                return
            assert admitted.code == 2147483647i32
