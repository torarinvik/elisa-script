include "../../ports/elisa-engine/scripts/meshopt_stream_codec_build_model.elisa"

using EsEngineMeshoptCodecBuild


@test
def engine_meshopt_codec_build_recipe_preserves_exact_compiler_argv() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    planned: Recipe = try recipe(path("/engine project"), "/opt/tool chain/c++") else failure:
        _ = failure
        assert false
        return
    expected: darray[sview] = [
        "-std=c++17", "-O2", "-DNDEBUG", "-I", "/engine project/dependencies/meshoptimizer",
        "/engine project/native/meshopt_stream_cooker.cpp",
        "/engine project/native/meshopt_stream_codec.cpp",
        "/engine project/dependencies/meshoptimizer/indexcodec.cpp",
        "/engine project/dependencies/meshoptimizer/vertexcodec.cpp",
        "-o", "/engine project/build/meshopt-stream-cooker"
    ]
    assert planned.compiler == "/opt/tool chain/c++"
    assert planned.source_paths.count == 6
    assert planned.arguments.count == expected.count
    for index in 0..<expected.count |planned, expected|:
        assert planned.arguments[index] == expected[index]
    assert f"{planned.stamp}" == "/engine project/build/meshopt-stream-cooker.sha256"


@test
def engine_meshopt_codec_fingerprint_matches_python_raw_byte_sequence() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    planned: Recipe = try recipe(path("/engine"), "/usr/bin/clang++") else failure:
        _ = failure
        assert false
        return
    source_contents: darray[sview] = [
        "cooker", "codec", "codec-header", "meshopt-header", "index-codec", "vertex-codec"
    ]
    baseline: darray[u8] = try fingerprint(planned, "clang version 18.1.0\n", "/Applications/Xcode.app", source_contents) else failure:
        _ = failure
        assert false
        return
    assert baseline.count == 64
    assert bytes_view(baseline) == "73ead8f0c127ac490c58d97c84efb581d955ddbea9102e5c485301d917f008c6"
    same: darray[u8] = try fingerprint(planned, "clang version 18.1.0\n", "/Applications/Xcode.app", source_contents) else failure:
        _ = failure
        assert false
        return
    new_version: darray[u8] = try fingerprint(planned, "clang version 19.0.0\n", "/Applications/Xcode.app", source_contents) else failure:
        _ = failure
        assert false
        return
    new_developer_dir: darray[u8] = try fingerprint(planned, "clang version 18.1.0\n", "/Applications/Other.app", source_contents) else failure:
        _ = failure
        assert false
        return
    other_compiler: Recipe = try recipe(path("/engine"), "/usr/bin/g++") else failure:
        _ = failure
        assert false
        return
    new_compiler: darray[u8] = try fingerprint(other_compiler, "clang version 18.1.0\n", "/Applications/Xcode.app", source_contents) else failure:
        _ = failure
        assert false
        return
    changed: mutable darray[sview] = source_contents
    changed[5] <- "other-vertex-codec"
    changed_source: darray[u8] = try fingerprint(planned, "clang version 18.1.0\n", "/Applications/Xcode.app", changed) else failure:
        _ = failure
        assert false
        return
    assert same == baseline
    assert new_version != baseline
    assert new_developer_dir != baseline
    assert new_compiler != baseline
    assert changed_source != baseline


@test
def engine_meshopt_codec_recipe_rejects_invalid_inputs() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    invalid_root: mutable bool = false
    catch recipe(path("relative/engine"), "c++"):
        ok planned:
            _ = planned
            assert false
        error failure:
            invalid_root <- failure == RecipeError.InvalidEngineRoot
    assert invalid_root

    invalid_compiler: mutable bool = false
    catch recipe(path("/engine"), "c++\0flag"):
        ok planned:
            _ = planned
            assert false
        error failure:
            invalid_compiler <- failure == RecipeError.InvalidCompiler
    assert invalid_compiler

    incomplete_sources: darray[sview] = ["only-five", "sources", "for", "this", "fixture"]
    invalid_recipe: Recipe = try recipe(path("/engine"), "c++") else failure:
        _ = failure
        assert false
        return
    invalid_fingerprint_input: mutable bool = false
    catch fingerprint(invalid_recipe, "c++ 1.0", "", incomplete_sources):
        ok digest:
            _ = digest
            assert false
        error failure:
            invalid_fingerprint_input <- failure == RecipeError.InvalidFingerprintInput
    assert invalid_fingerprint_input
