# Pure counter-versus-independent-literals assertions. No filesystem/process
# fixture is imported or run; neither source is runtime qualification evidence.
include "../../src/runtime/source_length_model.elisa"
include "../script_parity/source_length_cases.elisa"


@test
def source_length_independent_boundary_cases_match_counter() -> void:
    can Memory.Allocate, Abort.Panic:
        cases: darray[EsSourceLengthCases::Case] = EsSourceLengthCases::ordinary()
        assert cases.count == EsSourceLengthCases::Fixture::CASES
        for selected in cases:
            assert EsSourceLength::universal_line_count(selected.contents) == selected.lines
            assert len(selected.label) > 0 and len(selected.contents) < 8192
            assert selected.status == (1i64 if selected.lines > 600 else 0i64)
            if selected.lines <= 600:
                assert selected.stderr == ""
        assert cases[0].contents == "" and cases[0].lines == 0
        assert cases[1].contents == "\xef\xbb\xbf" and cases[1].lines == 1
        assert len(cases[5].contents) == 603 and cases[5].lines == 600
        assert len(cases[6].contents) == 604 and cases[6].lines == 601
        assert len(cases[8].contents) == 1200 and cases[8].lines == 600
        assert len(cases[9].contents) == 900 and cases[9].lines == 600
        assert len(cases[11].contents) == 6611 and cases[11].lines == 1
        assert cases[4].stderr == EsSourceLengthCases::Fixture::TOO_LONG_601
        assert cases[6].stderr == EsSourceLengthCases::Fixture::TOO_LONG_601
        assert cases[10].stderr == EsSourceLengthCases::Fixture::TOO_LONG_601
        assert cases[12].stderr == EsSourceLengthCases::Fixture::TOO_LONG_602
