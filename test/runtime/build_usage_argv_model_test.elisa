include "../../src/ir/ir.elisa"

using EsBuildUsage
using EsBuildUsageArgv
using EsBuildExecutor
using EsProcess


@test
def build_usage_compile_entries_materialize_as_owned_argv() -> void:
    can Memory.Allocate, Abort.Panic:
        target: BuildUsageTargetResult = BuildUsageTargetResult{
            name: "app",
            compile: [
                BuildUsageEntry{kind: BuildUsageKind.IncludeDirectory, value: "include/api"},
                BuildUsageEntry{kind: BuildUsageKind.CompileDefinition, value: "API_LEVEL=3"},
                BuildUsageEntry{kind: BuildUsageKind.CompileOption, value: "-fPIC"}
            ]
        }
        argv: BuildUsageArgv = build_usage_compile_argv(target, ["-std=c11"], [], BuildUsageArgSyntax{include_prefix: "-I", definition_prefix: "-D", library_prefix: "-l"})
        assert argv.arguments.count == 4
        assert argv.owned_arguments.count == argv.arguments.count
        assert argv.arguments[0] == "-std=c11"
        assert argv.arguments[1] == "-Iinclude/api"
        assert argv.arguments[2] == "-DAPI_LEVEL=3"
        assert argv.arguments[3] == "-fPIC"


@test
def build_usage_link_entries_resolve_artifacts_without_shell_parsing() -> void:
    can Memory.Allocate, Abort.Panic:
        target: BuildUsageTargetResult = BuildUsageTargetResult{
            name: "app",
            link: [
                BuildUsageEntry{kind: BuildUsageKind.LinkLibrary, value: "m", library_form: BuildUsageLibraryForm.SearchName},
                BuildUsageEntry{kind: BuildUsageKind.LinkLibrary, value: "-llegacy", library_form: BuildUsageLibraryForm.LinkerArgument},
                BuildUsageEntry{kind: BuildUsageKind.LinkLibrary, value: "core", target_artifact: true},
                BuildUsageEntry{kind: BuildUsageKind.LinkOption, value: "-pthread"},
                BuildUsageEntry{kind: BuildUsageKind.LinkLibrary, value: "deps/libextra.a", library_form: BuildUsageLibraryForm.Path}
            ]
        }
        argv: BuildUsageArgv = build_usage_link_argv(
            target,
            ["app object.o"],
            [BuildUsageTargetArtifact{target_name: "core", path: "/build/libcore.a"}],
            BuildUsageArgSyntax{include_prefix: "-I", definition_prefix: "-D", library_prefix: "-l"}
        )
        assert argv.arguments.count == 6
        assert argv.owned_arguments.count == argv.arguments.count
        assert argv.arguments[0] == "app object.o"
        assert argv.arguments[1] == "-lm"
        assert argv.arguments[2] == "-llegacy"
        assert argv.arguments[3] == "/build/libcore.a"
        assert argv.arguments[4] == "-pthread"
        assert argv.arguments[5] == "deps/libextra.a"


@test
def build_usage_link_entries_reject_unmapped_target_artifacts() -> void:
    can Memory.Allocate, Abort.Panic:
        target: BuildUsageTargetResult = BuildUsageTargetResult{
            name: "app",
            link: [BuildUsageEntry{kind: BuildUsageKind.LinkLibrary, value: "missing", target_artifact: true}]
        }
        rejected: mutable bool = false
        catch build_usage_link_argv(target, [], [], BuildUsageArgSyntax{include_prefix: "-I", definition_prefix: "-D", library_prefix: "-l"}):
            ok argv:
                _ = argv
            error failure:
                rejected <- failure == BuildUsageArgvError.MissingTargetArtifact
        assert rejected


@test
def build_usage_argv_builds_owned_executor_compatible_process_command() -> void:
    can Memory.Allocate, Abort.Panic:
        target: BuildUsageTargetResult = BuildUsageTargetResult{
            name: "app",
            compile: [BuildUsageEntry{kind: BuildUsageKind.CompileOption, value: "-g"}]
        }
        argv: BuildUsageArgv = build_usage_compile_argv(target, ["-c"], ["source file.c", "-o", "object file.o"], BuildUsageArgSyntax{include_prefix: "-I", definition_prefix: "-D", library_prefix: "-l"})
        prepared: BuildUsageProcessCommand = build_usage_process_command(
            "/usr/bin/cc",
            argv,
            "/tmp",
            ["PATH", "/usr/bin", "LC_ALL", "C"],
            ProcessEnvironmentMode.Replace,
            60000000u64,
            1048576
        )
        assert prepared.command.executable == bytes_view(prepared.owned_executable)
        assert prepared.command.working_directory == bytes_view(prepared.owned_working_directory)
        assert prepared.command.arguments.count == 5
        assert prepared.command.arguments[0] == "-c"
        assert prepared.command.arguments[1] == "-g"
        assert prepared.command.arguments[2] == "source file.c"
        assert prepared.command.arguments[4] == "object file.o"
        assert prepared.command.environment[1] == "/usr/bin"
        assert prepared.command.environment[3] == "C"
        assert prepared.command.stdin_mode == ProcessStdioMode.Null
        assert prepared.command.stdout_mode == ProcessStdioMode.Capture
        assert prepared.command.stderr_mode == ProcessStdioMode.Capture
        assert build_executor_command_supported(prepared.command)


@test
def build_usage_process_command_rejects_ambient_environment() -> void:
    can Memory.Allocate, Abort.Panic:
        argv: BuildUsageArgv = BuildUsageArgv{}
        rejected: mutable bool = false
        catch build_usage_process_command("/usr/bin/cc", argv, "/tmp", [], ProcessEnvironmentMode.Inherit, 60000000u64, 1024):
            ok command:
                _ = command
            error failure:
                rejected <- failure == BuildUsageArgvError.InheritedEnvironmentUnsupported
        assert rejected
