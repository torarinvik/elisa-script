include "../../ports/elisa-engine/scripts/gltf_mikktspace_protocol_model.elisa"

using EsEngineGltfGeometryFlatten
using EsEngineGltfMikkProtocol


def append_mikk_protocol_u32(output: mutable darray[u8]&, value: u32) void can[Memory.Allocate, Abort.Panic]:
    output.push((value & 255u32).u8())
    output.push(((value >> 8) & 255u32).u8())
    output.push(((value >> 16) & 255u32).u8())
    output.push((value >> 24).u8())


def make_mikk_protocol_response() darray[u8] can[Memory.Allocate, Abort.Panic]:
    output: mutable darray[u8] = [69u8, 76u8, 73u8, 83u8, 65u8, 77u8, 82u8, 49u8]
    try append_mikk_protocol_u32(output, 3u32)
    try append_mikk_protocol_u32(output, 3u32)
    for value in [0u32, 0u32, 0u32, 1065353216u32, 0u32, 0u32, 0u32, 1065353216u32, 0u32] |output|:
        try append_mikk_protocol_u32(output, value)
    for value in [0u32, 0u32, 1065353216u32, 0u32, 0u32, 1065353216u32, 0u32, 0u32, 1065353216u32] |output|:
        try append_mikk_protocol_u32(output, value)
    for value in [0u32, 0u32, 1065353216u32, 0u32, 0u32, 1065353216u32] |output|:
        try append_mikk_protocol_u32(output, value)
    for value in [1065353216u32, 0u32, 0u32, 1065353216u32, 1065353216u32, 0u32, 0u32, 1065353216u32, 1065353216u32, 0u32, 0u32, 1065353216u32] |output|:
        try append_mikk_protocol_u32(output, value)
    for value in [0u32, 1u32, 2u32] |output|:
        try append_mikk_protocol_u32(output, value)
    for value in [2u32, 0u32, 1u32] |output|:
        try append_mikk_protocol_u32(output, value)
    return output


def mikk_protocol_rejects(data: darray[u8], input_vertices: usize, input_indices: usize, expected: MikkProtocolError) bool can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch decode_response(data, 4u, 7u, input_vertices, input_indices):
        ok result:
            _ = result
        error failure:
            rejected <- failure == expected
    return rejected


@test
def mikk_response_decodes_into_finalizer_block_shape() -> void can[Memory.Allocate, Abort.Panic]:
    packet: darray[u8] = make_mikk_protocol_response()
    result: MikkBlockResult = decode_response(packet, 4u, 7u, 3u, 3u)
    assert result.placement_index == 4u and result.block_index == 7u
    assert result.positions.count == 36 and result.normals.count == 36 and result.uvs.count == 24 and result.tangents.count == 48
    assert result.indices == [0u32, 1u32, 2u32]
    assert result.source_vertices == [2u32, 0u32, 1u32]
    assert result.positions[26] == 128u8 and result.positions[27] == 63u8 and result.positions[35] == 0u8


@test
def mikk_response_rejects_invalid_bounds_layout_and_remaps() -> void can[Memory.Allocate, Abort.Panic]:
    valid: darray[u8] = make_mikk_protocol_response()
    assert mikk_protocol_rejects(valid, 0u, 3u, MikkProtocolError.InvalidInputBounds)
    assert mikk_protocol_rejects(valid, 3u, 4u, MikkProtocolError.InvalidInputBounds)
    assert mikk_protocol_rejects(valid, 3u, 6u, MikkProtocolError.InvalidIndexCount)

    wrong_magic: mutable darray[u8] = make_mikk_protocol_response()
    wrong_magic[0] <- 0u8
    assert mikk_protocol_rejects(wrong_magic, 3u, 3u, MikkProtocolError.WrongMagic)

    truncated: darray[u8] = [69u8, 76u8, 73u8]
    assert mikk_protocol_rejects(truncated, 3u, 3u, MikkProtocolError.TruncatedHeader)

    malformed_vertex_count: mutable darray[u8] = make_mikk_protocol_response()
    malformed_vertex_count[8] <- 0u8
    malformed_vertex_count[9] <- 0u8
    malformed_vertex_count[10] <- 0u8
    malformed_vertex_count[11] <- 0u8
    assert mikk_protocol_rejects(malformed_vertex_count, 3u, 3u, MikkProtocolError.InvalidVertexCount)

    malformed_index_count: mutable darray[u8] = make_mikk_protocol_response()
    malformed_index_count[12] <- 0u8
    malformed_index_count[13] <- 0u8
    malformed_index_count[14] <- 0u8
    malformed_index_count[15] <- 0u8
    assert mikk_protocol_rejects(malformed_index_count, 3u, 3u, MikkProtocolError.InvalidIndexCount)

    malformed_index: mutable darray[u8] = make_mikk_protocol_response()
    malformed_index[160] <- 3u8
    assert mikk_protocol_rejects(malformed_index, 3u, 3u, MikkProtocolError.InvalidIndex)

    malformed_source: mutable darray[u8] = make_mikk_protocol_response()
    malformed_source[172] <- 3u8
    assert mikk_protocol_rejects(malformed_source, 3u, 3u, MikkProtocolError.InvalidSourceVertex)

    trailing: mutable darray[u8] = make_mikk_protocol_response()
    trailing.push(0u8)
    assert mikk_protocol_rejects(trailing, 3u, 3u, MikkProtocolError.InvalidResponseLayout)
