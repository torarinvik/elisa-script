include "../../src/runtime/data_model.elisa"
include "../../src/runtime/encoding.elisa"
include "../../src/runtime/macos_deployment_target_model.elisa"
include "../../src/runtime/macos_app_info_plist_model.elisa"

using EsData
using EsMacosAppInfoPlist
using EsMacosDeploymentTarget


@test
def emits_ordered_app_metadata_and_xml_escapes_text() -> void can[Memory.Allocate, Abort.Panic]:
    info: MacosAppInfoPlist = MacosAppInfoPlist{
        bundle_name: "Maze & <Game>",
        bundle_id: "org.example.maze&game",
        version: "1.2&3",
        minimum_os: MacosVersion{
            major: DecimalInteger{text: "26"},
            minor: DecimalInteger{text: "0"},
            patch: DecimalInteger{text: "0"}
        },
        has_icon: false
    }
    plist: darray[u8] = try macos_app_info_plist_xml(info)
    expected: sview = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n\t<key>CFBundleDevelopmentRegion</key>\n\t<string>en</string>\n\t<key>CFBundleDisplayName</key>\n\t<string>Maze &amp; &lt;Game&gt;</string>\n\t<key>CFBundleExecutable</key>\n\t<string>Maze &amp; &lt;Game&gt;</string>\n\t<key>CFBundleIdentifier</key>\n\t<string>org.example.maze&amp;game</string>\n\t<key>CFBundleInfoDictionaryVersion</key>\n\t<string>6.0</string>\n\t<key>CFBundleName</key>\n\t<string>Maze &amp; &lt;Game&gt;</string>\n\t<key>CFBundlePackageType</key>\n\t<string>APPL</string>\n\t<key>CFBundleShortVersionString</key>\n\t<string>1.2&amp;3</string>\n\t<key>CFBundleVersion</key>\n\t<string>1.2&amp;3</string>\n\t<key>LSMinimumSystemVersion</key>\n\t<string>26.0</string>\n\t<key>NSHighResolutionCapable</key>\n\t<true/>\n</dict>\n</plist>\n"
    assert bytes_view(plist) == expected


@test
def appends_icon_metadata_after_the_reference_fields() -> void can[Memory.Allocate, Abort.Panic]:
    info: MacosAppInfoPlist = MacosAppInfoPlist{
        bundle_name: "Maze",
        bundle_id: "org.example.maze",
        version: "2.4",
        minimum_os: MacosVersion{
            major: DecimalInteger{text: "14"},
            minor: DecimalInteger{text: "2"},
            patch: DecimalInteger{text: "1"}
        },
        has_icon: true
    }
    plist: darray[u8] = try macos_app_info_plist_xml(info)
    assert bytes_view(plist).endswith("\t<key>NSHighResolutionCapable</key>\n\t<true/>\n\t<key>CFBundleIconFile</key>\n\t<string>AppIcon.icns</string>\n</dict>\n</plist>\n")
    assert bytes_view(plist).contains("<key>LSMinimumSystemVersion</key>\n\t<string>14.2.1</string>")


@test
def rejects_xml_forbidden_control_bytes() -> void can[Memory.Allocate, Abort.Panic]:
    info: MacosAppInfoPlist = MacosAppInfoPlist{
        bundle_name: "Maze",
        bundle_id: "org.example.maze",
        version: "1.0\u0001",
        minimum_os: MacosVersion{
            major: DecimalInteger{text: "14"},
            minor: DecimalInteger{text: "0"},
            patch: DecimalInteger{text: "0"}
        }
    }
    rejected: mutable bool = false
    catch macos_app_info_plist_xml(info):
        ok bytes:
            _ = bytes
        error failure:
            rejected <- failure == MacosAppInfoPlistError.InvalidXmlText
    assert rejected
