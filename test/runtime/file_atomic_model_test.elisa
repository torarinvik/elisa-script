include "../../src/ir/ir.elisa"

using EsFileAtomic
using EsFileAtomicPosix


def atomic_file_plan_is_rejected_with(destination: sview, staging: sview, backup: sview, expected: AtomicFileError) -> bool can Memory.Allocate, Abort.Panic:
    plan: AtomicFilePlan = AtomicFilePlan{
        destination_path: destination,
        staging_path: staging,
        owner_token: 1,
        parent_identity: 1,
        expected_destination: AtomicFileIdentity{observed: true, present: false},
        backup_path: backup
    }
    session: mutable AtomicFileSession = AtomicFileSession{plan: plan}
    rejected: mutable bool = false
    catch validate_atomic_file_session(session):
        ok valid:
            _ = valid
        error failure:
            rejected <- failure == expected
    return rejected


@test
def atomic_file_paths_must_name_file_entries() -> void:
    can Memory.Allocate, Abort.Panic:
        assert atomic_file_plan_is_rejected_with("/", "output.stage", "", AtomicFileError.PathInvalid)
        assert atomic_file_plan_is_rejected_with("output/", "output.stage", "", AtomicFileError.PathInvalid)
        assert atomic_file_plan_is_rejected_with("output", "/", "", AtomicFileError.PathInvalid)
        assert atomic_file_plan_is_rejected_with("output", "output.stage/", "", AtomicFileError.PathInvalid)
        assert atomic_file_plan_is_rejected_with("build//output", "build//stage", "", AtomicFileError.PathInvalid)
        assert atomic_file_plan_is_rejected_with("build/..", "build/stage", "", AtomicFileError.PathInvalid)
        assert atomic_file_plan_is_rejected_with("build/output", "build/.", "", AtomicFileError.PathInvalid)
        assert atomic_file_plan_is_rejected_with("output", "output.stage", "/", AtomicFileError.PathInvalid)
        assert atomic_file_plan_is_rejected_with("output", "output.stage", "backup/", AtomicFileError.PathInvalid)
        assert atomic_file_plan_is_rejected_with("output", "output.stage", "backup/..", AtomicFileError.PathInvalid)


@test
def atomic_file_stage_and_backup_must_be_siblings() -> void:
    can Memory.Allocate, Abort.Panic:
        assert atomic_file_plan_is_rejected_with("build/output", "temp/stage", "", AtomicFileError.ParentPathMismatch)
        assert atomic_file_plan_is_rejected_with("build/output", "build/stage", "backup/output", AtomicFileError.ParentPathMismatch)


@test
def atomic_file_stage_admission_rejects_invalid_preflight_without_transition() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic:
        plan: AtomicFilePlan = AtomicFilePlan{
            destination_path: "output.txt",
            staging_path: "output.txt.stage",
            owner_token: 7,
            parent_identity: 1,
            expected_destination: AtomicFileIdentity{observed: true, present: false}
        }
        session: mutable AtomicFileSession = AtomicFileSession{plan: plan}
        descriptor_rejected: mutable bool = false
        catch begin_atomic_file_stage(session, -1, -1, "output.txt.stage"):
            ok proof:
                _ = proof
                assert false
            error failure:
                descriptor_rejected <- failure == AtomicFilePosixError.StageNotReady
        assert descriptor_rejected
        assert session.state == AtomicFileState.Planned

        creation_rejected: mutable bool = false
        catch create_atomic_file_stage(session, -1, "output.txt.stage"):
            ok stage:
                _ = stage
                assert false
            error failure:
                creation_rejected <- failure == AtomicFilePosixError.StageNotReady
        assert creation_rejected
        assert session.state == AtomicFileState.Planned

        leaf_rejected: mutable bool = false
        catch begin_atomic_file_stage(session, 0, 1, ""):
            ok proof:
                _ = proof
                assert false
            error failure:
                leaf_rejected <- failure == AtomicFilePosixError.InvalidLeafName
        assert leaf_rejected
        assert session.state == AtomicFileState.Planned


@test
def atomic_file_begin_retains_valid_stage_admission() -> void:
    can Memory.Allocate, Abort.Panic:
        plan: AtomicFilePlan = AtomicFilePlan{
            destination_path: "output.txt",
            staging_path: "output.txt.stage",
            owner_token: 7,
            parent_identity: 1,
            expected_destination: AtomicFileIdentity{observed: true, present: false}
        }
        valid_session: mutable AtomicFileSession = AtomicFileSession{plan: plan}
        admission: AtomicFileStageAdmission = AtomicFileStageAdmission{
            parent_device: 10,
            parent_inode: 11,
            parent_descriptor_token: 1,
            stage_device: 10,
            stage_inode: 12,
            stage_descriptor_token: 2,
            owner_token: 7,
            link_count: 1
        }
        assert advance_atomic_file(valid_session, AtomicFileEvent.Begin, stage_admission: admission) == AtomicFileState.Staging
        assert valid_session.stage_admission.stage_inode == 12
        assert validate_atomic_file_session(valid_session)

        invalid_session: mutable AtomicFileSession = AtomicFileSession{plan: plan}
        invalid_admission: AtomicFileStageAdmission = AtomicFileStageAdmission{
            parent_device: 10,
            parent_inode: 11,
            parent_descriptor_token: 9,
            stage_device: 10,
            stage_inode: 12,
            stage_descriptor_token: 2,
            owner_token: 7,
            link_count: 1
        }
        rejected: mutable bool = false
        catch advance_atomic_file(invalid_session, AtomicFileEvent.Begin, stage_admission: invalid_admission):
            ok state:
                _ = state
                assert false
            error failure:
                rejected <- failure == AtomicFileError.InvalidEventPayload
        assert rejected
        assert invalid_session.state == AtomicFileState.Planned


@test
def atomic_file_events_reject_irrelevant_payloads_without_mutation() -> void:
    can Memory.Allocate, Abort.Panic:
        plan: AtomicFilePlan = AtomicFilePlan{
            destination_path: "output.txt",
            staging_path: "output.txt.stage",
            owner_token: 1,
            parent_identity: 1,
            expected_destination: AtomicFileIdentity{observed: true, present: false}
        }
        session: mutable AtomicFileSession = AtomicFileSession{plan: plan}
        begin_bytes_rejected: mutable bool = false
        catch advance_atomic_file(session, AtomicFileEvent.Begin, appended_bytes: 1):
            ok state:
                _ = state
                assert false
            error failure:
                begin_bytes_rejected <- failure == AtomicFileError.InvalidEventPayload
        assert begin_bytes_rejected
        assert session.state == AtomicFileState.Planned

        begin_comparison_rejected: mutable bool = false
        catch advance_atomic_file(session, AtomicFileEvent.Begin, exact_contents_equal: true):
            ok state:
                _ = state
                assert false
            error failure:
                begin_comparison_rejected <- failure == AtomicFileError.InvalidEventPayload
        assert begin_comparison_rejected
        assert session.state == AtomicFileState.Planned

        _ = advance_atomic_file(session, AtomicFileEvent.Begin)
        irrelevant_identity: AtomicFileIdentity = AtomicFileIdentity{size: 1}
        append_identity_rejected: mutable bool = false
        catch advance_atomic_file(session, AtomicFileEvent.Append, identity: irrelevant_identity, appended_bytes: 1):
            ok state:
                _ = state
                assert false
            error failure:
                append_identity_rejected <- failure == AtomicFileError.InvalidEventPayload
        assert append_identity_rejected
        assert session.state == AtomicFileState.Staging
        assert session.append_count == 0

        append_comparison_rejected: mutable bool = false
        catch advance_atomic_file(session, AtomicFileEvent.Append, exact_contents_equal: true, appended_bytes: 1):
            ok state:
                _ = state
                assert false
            error failure:
                append_comparison_rejected <- failure == AtomicFileError.InvalidEventPayload
        assert append_comparison_rejected
        assert session.state == AtomicFileState.Staging
        assert session.append_count == 0
        assert advance_atomic_file(session, AtomicFileEvent.Append, appended_bytes: 1) == AtomicFileState.Staging


@test
def atomic_file_commit_ack_requires_directory_sync_receipt() -> void:
    can Memory.Allocate, Abort.Panic:
        digest: HashDigest = HashDigest{algorithm: HashAlgorithm.Sha256, word_count: 4, word0: 31, word1: 32, word2: 33, word3: 34}
        plan: AtomicFilePlan = AtomicFilePlan{
            destination_path: "output.txt",
            staging_path: "output.txt.stage",
            owner_token: 2,
            parent_identity: 1,
            expected_destination: AtomicFileIdentity{observed: true, present: false}
        }
        session: mutable AtomicFileSession = AtomicFileSession{plan: plan}
        published: AtomicFileIdentity = AtomicFileIdentity{observed: true, present: true, size: 0, volume_id: 1, object_id: 2, digest: digest}
        _ = advance_atomic_file(session, AtomicFileEvent.Begin)
        _ = advance_atomic_file(session, AtomicFileEvent.StageReady, identity: published)
        _ = advance_atomic_file(session, AtomicFileEvent.Compare, identity: plan.expected_destination)
        assert advance_atomic_file(session, AtomicFileEvent.Commit) == AtomicFileState.Committing

        premature_ack_rejected: mutable bool = false
        catch advance_atomic_file(session, AtomicFileEvent.CommitAck, identity: published):
            ok state:
                _ = state
                assert false
            error failure:
                premature_ack_rejected <- failure == AtomicFileError.DirectorySyncNotReady
        assert premature_ack_rejected
        assert session.state == AtomicFileState.Committing
        assert not session.commit_acknowledged

        assert advance_atomic_file(session, AtomicFileEvent.DirectorySync) == AtomicFileState.Committing
        assert advance_atomic_file(session, AtomicFileEvent.CommitAck, identity: published) == AtomicFileState.Committed
        assert validate_atomic_file_session(session)


@test
def atomic_file_restore_requires_a_known_current_destination() -> void:
    can Memory.Allocate, Abort.Panic:
        digest: HashDigest = HashDigest{algorithm: HashAlgorithm.Sha256, word_count: 4, word0: 41, word1: 42, word2: 43, word3: 44}
        original_destination: AtomicFileIdentity = AtomicFileIdentity{observed: true, present: false}
        staged: AtomicFileIdentity = AtomicFileIdentity{observed: true, present: true, size: 3, volume_id: 1, object_id: 2, digest: digest}
        unrelated: AtomicFileIdentity = AtomicFileIdentity{observed: true, present: true, size: 3, volume_id: 1, object_id: 99, digest: digest}
        plan: AtomicFilePlan = AtomicFilePlan{
            destination_path: "output.txt",
            staging_path: "output.txt.stage",
            owner_token: 3,
            parent_identity: 1,
            expected_destination: original_destination
        }
        session: mutable AtomicFileSession = AtomicFileSession{plan: plan}
        _ = advance_atomic_file(session, AtomicFileEvent.Begin)
        _ = advance_atomic_file(session, AtomicFileEvent.Append, appended_bytes: 3)
        _ = advance_atomic_file(session, AtomicFileEvent.StageReady, identity: staged)
        _ = advance_atomic_file(session, AtomicFileEvent.Compare, identity: original_destination)
        _ = advance_atomic_file(session, AtomicFileEvent.Commit)
        _ = advance_atomic_file(session, AtomicFileEvent.DirectorySync)
        _ = advance_atomic_file(session, AtomicFileEvent.CommitAck, identity: staged)

        unrelated_destination_rejected: mutable bool = false
        catch advance_atomic_file(session, AtomicFileEvent.BeginRestore, identity: unrelated):
            ok state:
                _ = state
                assert false
            error failure:
                unrelated_destination_rejected <- failure == AtomicFileError.RestoreNotProven
        assert unrelated_destination_rejected
        assert session.state == AtomicFileState.Committed
        assert not session.restore_source_identity.observed

        assert advance_atomic_file(session, AtomicFileEvent.BeginRestore, identity: staged) == AtomicFileState.Restoring
        assert session.restore_source_identity.observed
        assert session.restore_source_identity.object_id == staged.object_id
        assert advance_atomic_file(session, AtomicFileEvent.RestoreAck, identity: original_destination) == AtomicFileState.RolledBack
        assert validate_atomic_file_session(session)


@test
def atomic_file_posix_observation_rejects_invalid_parent() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic:
        arena: mutable Arena = Arena{begin: null, end: null, end_index: 0, strategy: 0}
        rejected: mutable bool = false
        catch observe_atomic_file_at(arena, -1, "output.txt", 1024):
            ok observation:
                _ = observation
            error failure:
                rejected <- failure == AtomicFilePosixError.InvalidDirectoryDescriptor
        assert rejected


@test
def atomic_file_cleanup_ack_is_pending_only_and_idempotence_is_rejected() -> void:
    can Memory.Allocate, Abort.Panic:
        digest: HashDigest = HashDigest{algorithm: HashAlgorithm.Sha256, word_count: 4, word0: 51, word1: 52, word2: 53, word3: 54}
        staged: AtomicFileIdentity = AtomicFileIdentity{observed: true, present: true, size: 1, volume_id: 7, object_id: 9, digest: digest}
        plan: AtomicFilePlan = AtomicFilePlan{
            destination_path: "output.txt",
            staging_path: "output.txt.stage",
            owner_token: 5,
            parent_identity: 3,
            expected_destination: AtomicFileIdentity{observed: true, present: false}
        }
        unstarted: mutable AtomicFileSession = AtomicFileSession{plan: plan}
        premature_ack_rejected: mutable bool = false
        catch advance_atomic_file(unstarted, AtomicFileEvent.CleanupAck):
            ok state:
                _ = state
                assert false
            error failure:
                premature_ack_rejected <- failure == AtomicFileError.CleanupNotReady
        assert premature_ack_rejected
        assert unstarted.state == AtomicFileState.Planned
        assert not unstarted.staging_cleanup_acknowledged

        failed: mutable AtomicFileSession = AtomicFileSession{plan: plan}
        _ = advance_atomic_file(failed, AtomicFileEvent.Begin)
        _ = advance_atomic_file(failed, AtomicFileEvent.Append, appended_bytes: 1)
        _ = advance_atomic_file(failed, AtomicFileEvent.StageReady, identity: staged)
        assert advance_atomic_file(failed, AtomicFileEvent.Fail) == AtomicFileState.FailedPendingCleanup
        assert advance_atomic_file(failed, AtomicFileEvent.CleanupAck) == AtomicFileState.Failed
        assert failed.staging_cleanup_acknowledged
        assert validate_atomic_file_session(failed)

        duplicate_ack_rejected: mutable bool = false
        catch advance_atomic_file(failed, AtomicFileEvent.CleanupAck):
            ok state:
                _ = state
                assert false
            error failure:
                duplicate_ack_rejected <- failure == AtomicFileError.CleanupNotReady
        assert duplicate_ack_rejected
        assert failed.state == AtomicFileState.Failed
        assert validate_atomic_file_session(failed)

        partial: mutable AtomicFileSession = AtomicFileSession{plan: plan}
        _ = advance_atomic_file(partial, AtomicFileEvent.Begin)
        _ = advance_atomic_file(partial, AtomicFileEvent.Append, appended_bytes: 1)
        assert advance_atomic_file(partial, AtomicFileEvent.Fail) == AtomicFileState.FailedPendingCleanup
        assert not partial.staged_identity.observed
        assert advance_atomic_file(partial, AtomicFileEvent.CleanupAck) == AtomicFileState.Failed
        assert validate_atomic_file_session(partial)
