include "../../src/ir/ir.elisa"

using EsFileAtomic


def atomic_file_plan_path_is_rejected(destination: sview, staging: sview, backup: sview) -> bool can Memory.Allocate, Abort.Panic:
    plan: AtomicFilePlan = AtomicFilePlan{
        destination_path: destination,
        staging_path: staging,
        owner_token: 1,
        parent_identity: 1,
        expected_destination: AtomicFileIdentity{observed: true, present: false},
        backup_path: backup
    }
    session: mutable AtomicFileSession = AtomicFileSession{plan: plan}
    rejected: mutable bool = false
    catch validate_atomic_file_session(session):
        ok valid:
            _ = valid
        error failure:
            rejected <- failure == AtomicFileError.PathInvalid
    return rejected


@test
def atomic_file_paths_must_name_file_entries() -> void:
    can Memory.Allocate, Abort.Panic:
        assert atomic_file_plan_path_is_rejected("/", "output.stage", "")
        assert atomic_file_plan_path_is_rejected("output/", "output.stage", "")
        assert atomic_file_plan_path_is_rejected("output", "/", "")
        assert atomic_file_plan_path_is_rejected("output", "output.stage/", "")
        assert atomic_file_plan_path_is_rejected("output", "output.stage", "/")
        assert atomic_file_plan_path_is_rejected("output", "output.stage", "backup/")


@test
def atomic_file_events_reject_irrelevant_payloads_without_mutation() -> void:
    can Memory.Allocate, Abort.Panic:
        plan: AtomicFilePlan = AtomicFilePlan{
            destination_path: "output.txt",
            staging_path: "output.txt.stage",
            owner_token: 1,
            parent_identity: 1,
            expected_destination: AtomicFileIdentity{observed: true, present: false}
        }
        session: mutable AtomicFileSession = AtomicFileSession{plan: plan}
        begin_bytes_rejected: mutable bool = false
        catch advance_atomic_file(session, AtomicFileEvent.Begin, appended_bytes: 1):
            ok state:
                _ = state
                assert false
            error failure:
                begin_bytes_rejected <- failure == AtomicFileError.InvalidEventPayload
        assert begin_bytes_rejected
        assert session.state == AtomicFileState.Planned

        begin_comparison_rejected: mutable bool = false
        catch advance_atomic_file(session, AtomicFileEvent.Begin, exact_contents_equal: true):
            ok state:
                _ = state
                assert false
            error failure:
                begin_comparison_rejected <- failure == AtomicFileError.InvalidEventPayload
        assert begin_comparison_rejected
        assert session.state == AtomicFileState.Planned

        _ = advance_atomic_file(session, AtomicFileEvent.Begin)
        irrelevant_identity: AtomicFileIdentity = AtomicFileIdentity{size: 1}
        append_identity_rejected: mutable bool = false
        catch advance_atomic_file(session, AtomicFileEvent.Append, identity: irrelevant_identity, appended_bytes: 1):
            ok state:
                _ = state
                assert false
            error failure:
                append_identity_rejected <- failure == AtomicFileError.InvalidEventPayload
        assert append_identity_rejected
        assert session.state == AtomicFileState.Staging
        assert session.append_count == 0

        append_comparison_rejected: mutable bool = false
        catch advance_atomic_file(session, AtomicFileEvent.Append, exact_contents_equal: true, appended_bytes: 1):
            ok state:
                _ = state
                assert false
            error failure:
                append_comparison_rejected <- failure == AtomicFileError.InvalidEventPayload
        assert append_comparison_rejected
        assert session.state == AtomicFileState.Staging
        assert session.append_count == 0
        assert advance_atomic_file(session, AtomicFileEvent.Append, appended_bytes: 1) == AtomicFileState.Staging


@test
def atomic_file_commit_ack_requires_directory_sync_receipt() -> void:
    can Memory.Allocate, Abort.Panic:
        digest: HashDigest = HashDigest{algorithm: HashAlgorithm.Sha256, word_count: 4, word0: 31, word1: 32, word2: 33, word3: 34}
        plan: AtomicFilePlan = AtomicFilePlan{
            destination_path: "output.txt",
            staging_path: "output.txt.stage",
            owner_token: 2,
            parent_identity: 1,
            expected_destination: AtomicFileIdentity{observed: true, present: false}
        }
        session: mutable AtomicFileSession = AtomicFileSession{plan: plan}
        published: AtomicFileIdentity = AtomicFileIdentity{observed: true, present: true, size: 0, volume_id: 1, object_id: 2, digest: digest}
        _ = advance_atomic_file(session, AtomicFileEvent.Begin)
        _ = advance_atomic_file(session, AtomicFileEvent.StageReady, identity: published)
        _ = advance_atomic_file(session, AtomicFileEvent.Compare, identity: plan.expected_destination)
        assert advance_atomic_file(session, AtomicFileEvent.Commit) == AtomicFileState.Committing

        premature_ack_rejected: mutable bool = false
        catch advance_atomic_file(session, AtomicFileEvent.CommitAck, identity: published):
            ok state:
                _ = state
                assert false
            error failure:
                premature_ack_rejected <- failure == AtomicFileError.DirectorySyncNotReady
        assert premature_ack_rejected
        assert session.state == AtomicFileState.Committing
        assert not session.commit_acknowledged

        assert advance_atomic_file(session, AtomicFileEvent.DirectorySync) == AtomicFileState.Committing
        assert advance_atomic_file(session, AtomicFileEvent.CommitAck, identity: published) == AtomicFileState.Committed
        assert validate_atomic_file_session(session)
