include "../../src/testing/lua_frontend_corpus_model.elisa"

using EsLuaFrontendCorpus


@test
def lua_frontend_corpus_index_sorts_paths_and_validates_family_modes() -> void:
    can Memory.Allocate, Abort.Panic:
        files: darray[LuaFrontendCorpusFileInput] = [
            LuaFrontendCorpusFileInput{
                path: "/tmp/corpus/labels_gotos/accept_label.lua",
                source: "-- elisacore-label-fp: 46817461298825\n-- elisacore-analysis-fp: 113\nreturn true\n",
                regular_file: true
            },
            LuaFrontendCorpusFileInput{
                path: "/tmp/corpus/control_flow/reject_break.lua",
                source: "return false\n",
                regular_file: true
            },
            LuaFrontendCorpusFileInput{
                path: "/tmp/corpus/control_flow/accept_loop.lua",
                source: "-- elisacore-analysis-fp: 3_741\r\nreturn true\r\n",
                regular_file: true
            }
        ]
        indexed: LuaFrontendCorpusIndex = try index_lua_frontend_corpus("/tmp/corpus", files)
        assert indexed.cases.count == 3
        assert indexed.cases[0].name == "accept_loop.lua"
        assert indexed.cases[0].family == "control_flow"
        assert indexed.cases[0].expected_accept
        assert indexed.cases[0].expected_fingerprints.count == 1
        assert indexed.cases[0].expected_fingerprints[0].mode == LuaFrontendFingerprintMode.Analysis
        assert not indexed.cases[0].expected_fingerprints[0].value.negative
        assert indexed.cases[0].expected_fingerprints[0].value.digits.count == 4
        assert indexed.cases[0].expected_fingerprints[0].value.digits[0] == 3u8
        assert indexed.cases[0].expected_fingerprints[0].value.digits[1] == 7u8
        assert indexed.cases[0].expected_fingerprints[0].value.digits[2] == 4u8
        assert indexed.cases[0].expected_fingerprints[0].value.digits[3] == 1u8
        assert indexed.cases[1].name == "reject_break.lua" and not indexed.cases[1].expected_accept
        assert indexed.cases[2].family == "labels_gotos"
        assert indexed.cases[2].expected_fingerprints.count == 2
        assert indexed.total_source_bytes == sview_len(files[0].source) + sview_len(files[1].source) + sview_len(files[2].source)


@test
def lua_frontend_corpus_index_matches_component_path_order_not_flat_string_order() -> void:
    can Memory.Allocate, Abort.Panic:
        files: darray[LuaFrontendCorpusFileInput] = [
            LuaFrontendCorpusFileInput{path: "/tmp/corpus/a-/accept_dash.lua", source: "return true\n", regular_file: true},
            LuaFrontendCorpusFileInput{path: "/tmp/corpus/a/accept_child.lua", source: "return true\n", regular_file: true}
        ]
        indexed: LuaFrontendCorpusIndex = try index_lua_frontend_corpus("/tmp/corpus", files)
        assert indexed.cases[0].family == "a"
        assert indexed.cases[1].family == "a-"


@test
def lua_frontend_corpus_annotations_preserve_python_leading_comment_and_overwrite_rules() -> void:
    can Memory.Allocate, Abort.Panic:
        files: darray[LuaFrontendCorpusFileInput] = [
            LuaFrontendCorpusFileInput{
                path: "/tmp/corpus/globals/accept_globals.lua",
                source: "\t-- elisacore-env-fp: 1\r-- elisacore-env-fp: +7_9\n-- elisacore-closure-fp: 37\r\n-- elisacore-analysis-fp: 42\nlocal value = 1\n-- elisacore-invalid-fp: 3\n",
                regular_file: true
            }
        ]
        indexed: LuaFrontendCorpusIndex = try index_lua_frontend_corpus("/tmp/corpus", files)
        fingerprints: darray[LuaFrontendFingerprint] = indexed.cases[0].expected_fingerprints
        assert fingerprints.count == 3
        assert fingerprints[0].mode == LuaFrontendFingerprintMode.Environment and fingerprints[0].value.digits == [7u8, 9u8]
        assert fingerprints[1].mode == LuaFrontendFingerprintMode.Closure and fingerprints[1].value.digits == [3u8, 7u8]
        assert fingerprints[2].mode == LuaFrontendFingerprintMode.Analysis and fingerprints[2].value.digits == [4u8, 2u8]


@test
def lua_frontend_corpus_index_rejects_missing_malformed_and_untrusted_inputs() -> void:
    can Memory.Allocate, Abort.Panic:
        missing_mode: mutable bool = false
        catch index_lua_frontend_corpus("/tmp/corpus", [LuaFrontendCorpusFileInput{
            path: "/tmp/corpus/globals/accept_globals.lua",
            source: "-- elisacore-env-fp: 1\nreturn true\n",
            regular_file: true
        }]):
            ok indexed:
                _ = indexed
                assert false
            error failure:
                missing_mode <- failure == LuaFrontendCorpusError.MissingRequiredFingerprint

        malformed_integer: mutable bool = false
        catch index_lua_frontend_corpus("/tmp/corpus", [LuaFrontendCorpusFileInput{
            path: "/tmp/corpus/control_flow/accept_bad.lua",
            source: "-- elisacore-analysis-fp: 12x\nreturn true\n",
            regular_file: true
        }]):
            ok indexed:
                _ = indexed
                assert false
            error failure:
                malformed_integer <- failure == LuaFrontendCorpusError.InvalidFingerprintInteger

        invalid_name: mutable bool = false
        catch index_lua_frontend_corpus("/tmp/corpus", [LuaFrontendCorpusFileInput{
            path: "/tmp/corpus/control_flow/other.lua",
            source: "return true\n",
            regular_file: true
        }]):
            ok indexed:
                _ = indexed
                assert false
            error failure:
                invalid_name <- failure == LuaFrontendCorpusError.InvalidCaseName

        symlink: mutable bool = false
        catch index_lua_frontend_corpus("/tmp/corpus", [LuaFrontendCorpusFileInput{
            path: "/tmp/corpus/control_flow/accept_link.lua",
            source: "-- elisacore-analysis-fp: 1\nreturn true\n",
            regular_file: true,
            symbolic_link: true
        }]):
            ok indexed:
                _ = indexed
                assert false
            error failure:
                symlink <- failure == LuaFrontendCorpusError.PathTypeInvalid

        large_integer: LuaFrontendCorpusIndex = try index_lua_frontend_corpus("/tmp/corpus", [LuaFrontendCorpusFileInput{
            path: "/tmp/corpus/control_flow/accept_wide_integer.lua",
            source: "-- elisacore-analysis-fp: -000922337203685477580812345678901234567890\nreturn true\n",
            regular_file: true
        }])
        large_digits: darray[u8] = large_integer.cases[0].expected_fingerprints[0].value.digits
        assert large_integer.cases[0].expected_fingerprints[0].value.negative
        assert large_digits.count == 39 and large_digits[0] == 9u8 and large_digits[38] == 0u8

        outside_root: mutable bool = false
        catch index_lua_frontend_corpus("/tmp/corpus", [LuaFrontendCorpusFileInput{
            path: "/tmp/other/control_flow/reject_escape.lua",
            source: "return false\n",
            regular_file: true
        }]):
            ok indexed:
                _ = indexed
                assert false
            error failure:
                outside_root <- failure == LuaFrontendCorpusError.PathOutsideRoot

        duplicate_path: mutable bool = false
        duplicate: LuaFrontendCorpusFileInput = LuaFrontendCorpusFileInput{
            path: "/tmp/corpus/misc/accept_duplicate.lua",
            source: "return true\n",
            regular_file: true
        }
        catch index_lua_frontend_corpus("/tmp/corpus", [duplicate, duplicate]):
            ok indexed:
                _ = indexed
                assert false
            error failure:
                duplicate_path <- failure == LuaFrontendCorpusError.DuplicatePath

        assert missing_mode and malformed_integer and invalid_name and symlink
        assert outside_root and duplicate_path
