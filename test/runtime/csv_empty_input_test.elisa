include "../../src/ir/ir.elisa"

using EsCsv
using EsCsvRecordFramer
using EsCsvRecordFilePosix
using EsCsvMaterialize
using EsCsvParser
using EsCsvEncode
using EsSchema
using EsSchemaCsv


@test
def csv_empty_input_and_blank_records_match_python_shape() -> void:
    empty_stream: mutable CsvStream = CsvStream{policy: CsvPolicy{}}
    assert advance_csv_stream(empty_stream, CsvStreamEvent.Begin) == CsvStreamState.Unquoted
    assert advance_csv_stream(empty_stream, CsvStreamEvent.End) == CsvStreamState.Complete
    assert empty_stream.input_bytes == 0 and empty_stream.records == 0 and empty_stream.fields_total == 0
    assert validate_csv_stream(empty_stream)

    blank_record_stream: mutable CsvStream = CsvStream{policy: CsvPolicy{}}
    _ = advance_csv_stream(blank_record_stream, CsvStreamEvent.Begin)
    _ = advance_csv_stream(blank_record_stream, CsvStreamEvent.Byte, 10)
    assert advance_csv_stream(blank_record_stream, CsvStreamEvent.End) == CsvStreamState.Complete
    assert blank_record_stream.records == 1 and blank_record_stream.fields_total == 0

    quoted_empty_stream: mutable CsvStream = CsvStream{policy: CsvPolicy{}}
    _ = advance_csv_stream(quoted_empty_stream, CsvStreamEvent.Begin)
    _ = advance_csv_stream(quoted_empty_stream, CsvStreamEvent.Byte, 34)
    _ = advance_csv_stream(quoted_empty_stream, CsvStreamEvent.Byte, 34)
    assert advance_csv_stream(quoted_empty_stream, CsvStreamEvent.End) == CsvStreamState.Complete
    assert quoted_empty_stream.records == 1 and quoted_empty_stream.fields_total == 1

    mixed_stream: mutable CsvStream = CsvStream{policy: CsvPolicy{}}
    _ = advance_csv_stream(mixed_stream, CsvStreamEvent.Begin)
    _ = advance_csv_stream(mixed_stream, CsvStreamEvent.Byte, 97)
    _ = advance_csv_stream(mixed_stream, CsvStreamEvent.Byte, 10)
    _ = advance_csv_stream(mixed_stream, CsvStreamEvent.Byte, 10)
    _ = advance_csv_stream(mixed_stream, CsvStreamEvent.Byte, 34)
    _ = advance_csv_stream(mixed_stream, CsvStreamEvent.Byte, 34)
    _ = advance_csv_stream(mixed_stream, CsvStreamEvent.Byte, 10)
    assert advance_csv_stream(mixed_stream, CsvStreamEvent.End) == CsvStreamState.Complete
    assert mixed_stream.records == 3 and mixed_stream.fields_total == 2

    empty_materializer: mutable CsvMaterializer = CsvMaterializer{source: "", policy: CsvPolicy{}}
    assert advance_csv_materializer(empty_materializer, CsvMaterializerEvent.Begin) == CsvMaterializerState.Building
    assert advance_csv_materializer(empty_materializer, CsvMaterializerEvent.End) == CsvMaterializerState.Complete
    assert empty_materializer.fields.count == 0 and empty_materializer.records.count == 0
    assert validate_csv_materializer(empty_materializer)

    blank_record_materializer: mutable CsvMaterializer = CsvMaterializer{source: "\n", policy: CsvPolicy{}}
    _ = advance_csv_materializer(blank_record_materializer, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(blank_record_materializer, CsvMaterializerEvent.Record, first_field: 0, field_count: 0)
    assert advance_csv_materializer(blank_record_materializer, CsvMaterializerEvent.End) == CsvMaterializerState.Complete
    assert blank_record_materializer.fields.count == 0 and blank_record_materializer.records.count == 1
    assert blank_record_materializer.records[0].first_field == 0 and blank_record_materializer.records[0].field_count == 0

    quoted_empty_materializer: mutable CsvMaterializer = CsvMaterializer{source: "\"\"", policy: CsvPolicy{}}
    _ = advance_csv_materializer(quoted_empty_materializer, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(quoted_empty_materializer, CsvMaterializerEvent.Field, 0, 2, true)
    _ = advance_csv_materializer(quoted_empty_materializer, CsvMaterializerEvent.Record, first_field: 0, field_count: 1)
    assert advance_csv_materializer(quoted_empty_materializer, CsvMaterializerEvent.End) == CsvMaterializerState.Complete
    assert quoted_empty_materializer.fields.count == 1 and quoted_empty_materializer.records.count == 1

    mixed_materializer: mutable CsvMaterializer = CsvMaterializer{source: "a\n\n\"\"\n", policy: CsvPolicy{}}
    _ = advance_csv_materializer(mixed_materializer, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(mixed_materializer, CsvMaterializerEvent.Field, 0, 1)
    _ = advance_csv_materializer(mixed_materializer, CsvMaterializerEvent.Record, first_field: 0, field_count: 1)
    _ = advance_csv_materializer(mixed_materializer, CsvMaterializerEvent.Record, first_field: 1, field_count: 0)
    _ = advance_csv_materializer(mixed_materializer, CsvMaterializerEvent.Field, 3, 5, true)
    _ = advance_csv_materializer(mixed_materializer, CsvMaterializerEvent.Record, first_field: 1, field_count: 1)
    assert advance_csv_materializer(mixed_materializer, CsvMaterializerEvent.End) == CsvMaterializerState.Complete
    assert mixed_materializer.fields.count == 2 and mixed_materializer.records.count == 3
    assert mixed_materializer.records[1].field_count == 0 and mixed_materializer.records[2].first_field == 1
    optional_schema: SchemaDescriptor = SchemaDescriptor{name: "optional_cell", source: SchemaSource.Csv, fields: [SchemaField{name: "value", kind: SchemaValueKind.Text, required: false}]}
    mixed_batch: SchemaCsvRecordBatch = materialize_csv_schema_batch(optional_schema, mixed_materializer, 0, 3)
    assert mixed_batch.records.count == 3 and mixed_batch.value_count == 3 and mixed_batch.payload_bytes == 1
    assert mixed_batch.records[1].row_ordinal == 1 and mixed_batch.records[1].values[0].kind == SchemaCsvValueKind.Missing
    assert mixed_batch.records[2].row_ordinal == 2 and mixed_batch.records[2].values[0].kind == SchemaCsvValueKind.Text
    assert mixed_batch.records[2].values[0].bytes.count == 0

    header_empty_materializer: mutable CsvMaterializer = CsvMaterializer{source: "", policy: CsvPolicy{header: true}}
    _ = advance_csv_materializer(header_empty_materializer, CsvMaterializerEvent.Begin)
    assert advance_csv_materializer(header_empty_materializer, CsvMaterializerEvent.End) == CsvMaterializerState.Complete
    schema: SchemaDescriptor = SchemaDescriptor{name: "empty_header", source: SchemaSource.Csv, fields: [SchemaField{name: "value", kind: SchemaValueKind.Text}]}
    empty_batch: SchemaCsvRecordBatch = materialize_csv_schema_batch(schema, header_empty_materializer, 0, 0)
    assert empty_batch.first_row == 0 and empty_batch.records.count == 0 and empty_batch.value_count == 0
    invalid_row: mutable bool = false
    catch materialize_csv_schema_record(schema, header_empty_materializer, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaCsvMaterializeError.RowIndexInvalid
            invalid_row <- true
    assert invalid_row


@test
def csv_source_parser_materializes_quoted_fields_blank_rows_and_crlf() -> void:
    source: sview = "plain,\"with,\ncomma\"\n\n\"\",\"escaped \"\"quote\"\"\"\n"
    parsed: CsvMaterializer = parse_csv_materializer(source)
    assert parsed.state == CsvMaterializerState.Complete
    assert parsed.records.count == 3 and parsed.fields.count == 4
    assert parsed.records[0].first_field == 0 and parsed.records[0].field_count == 2
    assert parsed.records[1].first_field == 2 and parsed.records[1].field_count == 0
    assert parsed.records[2].first_field == 2 and parsed.records[2].field_count == 2
    assert csv_materialized_field(parsed, 0) == "plain"
    assert csv_materialized_field(parsed, 1) == "\"with,\ncomma\""
    assert csv_materialized_field(parsed, 2) == "\"\""
    assert csv_materialized_field(parsed, 3) == "\"escaped \"\"quote\"\"\""
    schema: SchemaDescriptor = SchemaDescriptor{name: "parsed_fields", source: SchemaSource.Csv, fields: [
        SchemaField{name: "first", kind: SchemaValueKind.Text},
        SchemaField{name: "second", kind: SchemaValueKind.Text}
    ]}
    first_record: SchemaCsvRecord = materialize_csv_schema_record(schema, parsed, 0)
    assert first_record.values[0].bytes.count == 5 and first_record.values[1].bytes.count == 11
    assert first_record.values[1].bytes[5] == 10
    last_record: SchemaCsvRecord = materialize_csv_schema_record(schema, parsed, 2)
    assert last_record.values[0].bytes.count == 0 and last_record.values[1].bytes.count == 15
    assert last_record.values[1].bytes[8] == 34 and last_record.values[1].bytes[13] == 101 and last_record.values[1].bytes[14] == 34

    empty: CsvMaterializer = parse_csv_materializer("")
    assert empty.state == CsvMaterializerState.Complete and empty.records.count == 0 and empty.fields.count == 0
    blank: CsvMaterializer = parse_csv_materializer("\n")
    assert blank.records.count == 1 and blank.records[0].field_count == 0 and blank.fields.count == 0

    crlf_policy: CsvPolicy = CsvPolicy{line_ending: CsvLineEndingMode.CrLf}
    crlf: CsvMaterializer = parse_csv_materializer("left,right\r\nlast,row", crlf_policy)
    assert crlf.records.count == 2 and crlf.fields.count == 4
    assert csv_materialized_field(crlf, 0) == "left" and csv_materialized_field(crlf, 1) == "right"
    assert csv_materialized_field(crlf, 2) == "last" and csv_materialized_field(crlf, 3) == "row"

    malformed_rejected: mutable bool = false
    catch parse_csv_materializer("a\"b\n"):
        ok parsed_malformed:
            _ = parsed_malformed
            assert false
        error failure:
            assert failure == CsvContractError.UnexpectedQuote
            malformed_rejected <- true
    assert malformed_rejected


@test
def csv_record_encoder_preserves_cells_under_explicit_dialects() -> void:
    policy: CsvPolicy = CsvPolicy{trim_unquoted: true}
    fields: darray[sview] = ["", "with,\ncomma", "say \"hi\"", " tail "]
    encoded: darray[u8] = encode_csv_record(fields, policy)
    assert bytes_view(encoded) == ",\"with,\ncomma\",\"say \"\"hi\"\"\",\" tail \"\n"

    parsed: CsvMaterializer = parse_csv_materializer(bytes_view(encoded), policy)
    assert parsed.records.count == 1 and parsed.fields.count == 4
    schema: SchemaDescriptor = SchemaDescriptor{name: "encoded_cells", source: SchemaSource.Csv, fields: [
        SchemaField{name: "empty", kind: SchemaValueKind.Text},
        SchemaField{name: "newline", kind: SchemaValueKind.Text},
        SchemaField{name: "quote", kind: SchemaValueKind.Text},
        SchemaField{name: "spaces", kind: SchemaValueKind.Text}
    ]}
    decoded: SchemaCsvRecord = materialize_csv_schema_record(schema, parsed, 0)
    assert decoded.values[0].bytes.count == 0
    assert bytes_view(decoded.values[1].bytes) == "with,\ncomma"
    assert bytes_view(decoded.values[2].bytes) == "say \"hi\""
    assert bytes_view(decoded.values[3].bytes) == " tail "

    one_empty_field: darray[u8] = encode_csv_record([""])
    assert bytes_view(one_empty_field) == "\"\"\n"
    parsed_one_empty: CsvMaterializer = parse_csv_materializer(bytes_view(one_empty_field))
    assert parsed_one_empty.records.count == 1 and parsed_one_empty.fields.count == 1

    zero_fields: darray[u8] = encode_csv_record([])
    assert bytes_view(zero_fields) == "\n"
    parsed_zero_fields: CsvMaterializer = parse_csv_materializer(bytes_view(zero_fields))
    assert parsed_zero_fields.records.count == 1 and parsed_zero_fields.records[0].field_count == 0

    custom_escape: CsvPolicy = CsvPolicy{escape: 92}
    custom_fields: darray[sview] = ["backslash\\cell", "say \"hi\""]
    custom_encoded: darray[u8] = encode_csv_record(custom_fields, custom_escape)
    assert bytes_view(custom_encoded) == "backslash\\cell,\"say \\\"hi\\\"\"\n"
    custom_parsed: CsvMaterializer = parse_csv_materializer(bytes_view(custom_encoded), custom_escape)
    custom_schema: SchemaDescriptor = SchemaDescriptor{name: "custom_escape", source: SchemaSource.Csv, fields: [
        SchemaField{name: "backslash", kind: SchemaValueKind.Text},
        SchemaField{name: "quote", kind: SchemaValueKind.Text}
    ]}
    custom_decoded: SchemaCsvRecord = materialize_csv_schema_record(custom_schema, custom_parsed, 0)
    assert bytes_view(custom_decoded.values[0].bytes) == "backslash\\cell"
    assert bytes_view(custom_decoded.values[1].bytes) == "say \"hi\""

    crlf_policy: CsvPolicy = CsvPolicy{line_ending: CsvLineEndingMode.CrLf}
    crlf_encoded: darray[u8] = encode_csv_record(["left", "right"], crlf_policy)
    assert bytes_view(crlf_encoded) == "left,right\r\n"
    exact_limit: darray[u8] = encode_csv_record(["x"], CsvPolicy{}, 2)
    assert bytes_view(exact_limit) == "x\n"
    over_limit_rejected: mutable bool = false
    catch encode_csv_record(["x"], CsvPolicy{}, 1):
        ok unexpected:
            _ = unexpected
            assert false
        error failure:
            assert failure == CsvEncodeError.OutputLimitExceeded
            over_limit_rejected <- true
    assert over_limit_rejected


@test
def csv_record_framer_preserves_quoted_content_and_split_crlf() -> void:
    policy: CsvPolicy = CsvPolicy{line_ending: CsvLineEndingMode.CrLf}
    framer: mutable CsvRecordFramer = begin_csv_record_framer(policy)
    first_chunk: darray[darray[u8]] = feed_csv_record_framer(framer, "left,\"two\n")
    assert first_chunk.count == 0 and framer.current_record.count != 0
    second_chunk: darray[darray[u8]] = feed_csv_record_framer(framer, "lines\",right\r")
    assert second_chunk.count == 0 and framer.stream.state == CsvStreamState.PendingRecordTerminator
    third_chunk: darray[darray[u8]] = feed_csv_record_framer(framer, "\nlast,row")
    assert third_chunk.count == 1 and bytes_view(third_chunk[0]) == "left,\"two\nlines\",right\r\n"
    first_materialized: CsvMaterializer = parse_csv_materializer(bytes_view(third_chunk[0]), policy)
    assert first_materialized.records.count == 1 and first_materialized.fields.count == 3
    assert csv_materialized_field(first_materialized, 1) == "\"two\nlines\""
    final_chunk: darray[darray[u8]] = finish_csv_record_framer(framer)
    assert final_chunk.count == 1 and bytes_view(final_chunk[0]) == "last,row"
    final_materialized: CsvMaterializer = parse_csv_materializer(bytes_view(final_chunk[0]), policy)
    assert final_materialized.records.count == 1 and final_materialized.fields.count == 2
    assert validate_csv_record_framer(framer) and framer.state == CsvRecordFramerState.Complete

    empty_framer: mutable CsvRecordFramer = begin_csv_record_framer()
    empty_result: darray[darray[u8]] = finish_csv_record_framer(empty_framer)
    assert empty_result.count == 0 and empty_framer.stream.records == 0
    blank_framer: mutable CsvRecordFramer = begin_csv_record_framer()
    blank_result: darray[darray[u8]] = feed_csv_record_framer(blank_framer, "\n")
    assert blank_result.count == 1 and bytes_view(blank_result[0]) == "\n"
    blank_materialized: CsvMaterializer = parse_csv_materializer(bytes_view(blank_result[0]))
    assert blank_materialized.records.count == 1 and blank_materialized.records[0].field_count == 0
    small_limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 16}
    small_framer: CsvRecordFramer = begin_csv_record_framer(limits: small_limits)
    assert small_framer.max_record_bytes == 16

    bounded_framer: mutable CsvRecordFramer = begin_csv_record_framer(limits: small_limits, max_record_bytes: 2)
    record_limit_rejected: mutable bool = false
    catch feed_csv_record_framer(bounded_framer, "abc"):
        ok unexpected:
            _ = unexpected
            assert false
        error failure:
            assert failure == CsvRecordFramerError.RecordByteLimitExceeded
            record_limit_rejected <- true
    assert record_limit_rejected and bounded_framer.stream.input_bytes == 2

    malformed_framer: mutable CsvRecordFramer = begin_csv_record_framer()
    malformed_rejected: mutable bool = false
    catch feed_csv_record_framer(malformed_framer, "a\"b\n"):
        ok unexpected:
            _ = unexpected
            assert false
        error failure:
            assert failure == CsvContractError.UnexpectedQuote
            malformed_rejected <- true
    assert malformed_rejected and malformed_framer.state == CsvRecordFramerState.Failed


@test
def csv_record_file_reader_streams_rows_and_rejects_over_limit_input() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write:
        path_text: static u8& = "/tmp/elisascript-csv-record-file-reader-test.csv"
        file_path: Path = path(path_text)
        _ = remove_file(path_text)
        empty_source: darray[u8] = []
        empty_written: usize = try write_bytes(file_path, empty_source) else err:
            1u64
        assert empty_written == 0
        empty_reader: mutable CsvRecordFileReader = try begin_csv_record_file_reader(path_text) else err:
            assert false
            return
        empty_result: CsvRecordFileRead = try next_csv_record_file(empty_reader) else err:
            assert false
            CsvRecordFileRead{}
        assert not empty_result.has_record and empty_result.bytes.count == 0
        assert close_csv_record_file_reader(empty_reader)

        source: mutable darray[u8] = []
        for _ in 0..<CSV_RECORD_FILE_CHUNK_BYTES - 1 |source|:
            source.push(97u8)
        source.push(13u8)
        source.push(10u8)
        for byte in "last,row" |source|:
            source.push(byte)
        written: usize = try write_bytes(file_path, source) else err:
            0u64
        assert written == source.count

        policy: CsvPolicy = CsvPolicy{line_ending: CsvLineEndingMode.CrLf}
        reader: mutable CsvRecordFileReader = try begin_csv_record_file_reader(path_text, policy) else err:
            assert false
            return
        first: mutable CsvRecordFileRead = CsvRecordFileRead{}
        second: mutable CsvRecordFileRead = CsvRecordFileRead{}
        exhausted: mutable CsvRecordFileRead = CsvRecordFileRead{}
        catch next_csv_record_file(reader):
            ok value:
                first <- value
            error failure:
                assert false
        catch next_csv_record_file(reader):
            ok value:
                second <- value
            error failure:
                assert false
        catch next_csv_record_file(reader):
            ok value:
                exhausted <- value
            error failure:
                assert false
        assert first.has_record and first.bytes.count == CSV_RECORD_FILE_CHUNK_BYTES + 1
        assert second.has_record and bytes_view(second.bytes) == "last,row" and not exhausted.has_record
        first_materialized: CsvMaterializer = parse_csv_materializer(bytes_view(first.bytes), policy)
        assert first_materialized.records.count == 1 and len(csv_materialized_field(first_materialized, 0)) == CSV_RECORD_FILE_CHUNK_BYTES - 1
        assert close_csv_record_file_reader(reader)

        exact_source: darray[u8] = [120u8, 44u8, 121u8]
        exact_written: usize = try write_bytes(file_path, exact_source) else err:
            0u64
        assert exact_written == exact_source.count
        exact_limits: DataDecodeLimits = DataDecodeLimits{input_bytes: exact_source.count}
        exact_reader: mutable CsvRecordFileReader = try begin_csv_record_file_reader(path_text, CsvPolicy{}, exact_limits) else err:
            assert false
            return
        exact_row: CsvRecordFileRead = try next_csv_record_file(exact_reader) else err:
            assert false
            CsvRecordFileRead{}
        assert exact_row.has_record and bytes_view(exact_row.bytes) == "x,y"
        assert close_csv_record_file_reader(exact_reader)

        oversized_source: darray[u8] = [97u8, 44u8, 98u8, 44u8, 99u8]
        oversized_written: usize = try write_bytes(file_path, oversized_source) else err:
            0u64
        assert oversized_written == oversized_source.count
        small_limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 4}
        bounded_reader: mutable CsvRecordFileReader = try begin_csv_record_file_reader(path_text, CsvPolicy{}, small_limits) else err:
            assert false
            return
        limit_rejected: mutable bool = false
        catch next_csv_record_file(bounded_reader):
            ok unexpected:
                _ = unexpected
                assert false
            error failure:
                limit_rejected <- failure == CsvRecordFileError.InputLimitExceeded
        assert limit_rejected and bounded_reader.state == CsvRecordFileReaderState.Failed
        assert close_csv_record_file_reader(bounded_reader)
        assert remove_file(path_text)
