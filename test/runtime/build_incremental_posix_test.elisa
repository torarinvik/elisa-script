include "../../src/ir/ir.elisa"

using EsBuildIncrementalPosix
using EsIr


@test
def incremental_observer_rejects_invalid_recipe_paths_before_io() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        scratch: mutable Arena = zeroed
        invalid_recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, inputs: ["../outside"], outputs: ["build/output"]}
        ]
        rejected: mutable bool = false
        catch observe_build_incremental_recipes_at(scratch, -1, invalid_recipes):
            ok observations:
                rejected <- false
            error failure:
                rejected <- failure == BuildIncrementalError.InvalidPath
        assert rejected


@test
def incremental_file_fingerprint_uses_canonical_sha256_word() -> void:
    can Memory.Allocate, Abort.Panic:
        abc: mutable darray[u8] = [97u8, 98u8, 99u8]
        digest: darray[u8] = canonical_bytes_sha256(abc)
        assert canonical_bytes_sha256_word(abc, 0) == 0xeacf018fbf1678bau64
        assert canonical_bytes_sha256_word(abc, 0) == canonical_digest_word(digest, 0)


@test
def incremental_file_open_rejects_invalid_capability_and_paths() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        descriptor_rejected: mutable bool = false
        catch open_build_incremental_file_at(-1, "src/main.c"):
            ok opened:
                descriptor_rejected <- false
            error failure:
                descriptor_rejected <- failure == OpenError.InvalidDirectoryDescriptor
        assert descriptor_rejected

        path_rejected: mutable bool = false
        catch open_build_incremental_file_at(-1, "../outside"):
            ok opened:
                path_rejected <- false
            error failure:
                path_rejected <- failure == OpenError.InvalidPath
        assert path_rejected
