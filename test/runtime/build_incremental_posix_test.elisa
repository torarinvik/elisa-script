include "../../src/ir/ir.elisa"

using EsBuild
using EsBuildIncremental
using EsBuildIncrementalPosix
using EsIr


@test
def incremental_observer_rejects_invalid_recipe_paths_before_io() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        scratch: mutable Arena = zeroed
        invalid_recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, recipe_signature: BuildRecipeSignature{word0: 1}, inputs: ["../outside"], outputs: ["build/output"]}
        ]
        rejected: mutable bool = false
        catch observe_build_incremental_recipes_at(scratch, -1, invalid_recipes):
            ok observations:
                rejected <- false
            error failure:
                rejected <- failure == BuildIncrementalError.InvalidPath
        assert rejected


@test
def incremental_file_fingerprint_uses_complete_canonical_sha256() -> void:
    can Memory.Allocate, Abort.Panic:
        abc: mutable darray[u8] = [97u8, 98u8, 99u8]
        digest: darray[u8] = canonical_bytes_sha256(abc)
        assert canonical_bytes_sha256_word(abc, 0) == 0xeacf018fbf1678bau64
        assert canonical_bytes_sha256_word(abc, 1) == 0x2322ae5dde404141u64
        assert canonical_bytes_sha256_word(abc, 2) == 0x9c7a1796a36103b0u64
        assert canonical_bytes_sha256_word(abc, 3) == 0xad1500f261ff10b4u64
        assert canonical_bytes_sha256_word(abc, 0) == canonical_digest_word(digest, 0)
        assert canonical_bytes_sha256_word(abc, 1) == canonical_digest_word(digest, 1)
        assert canonical_bytes_sha256_word(abc, 2) == canonical_digest_word(digest, 2)
        assert canonical_bytes_sha256_word(abc, 3) == canonical_digest_word(digest, 3)
        mode_644_changed: bool = canonical_file_identity_sha256_word(abc, 0o644u16, 0) != canonical_file_identity_sha256_word(abc, 0o755u16, 0)
            or canonical_file_identity_sha256_word(abc, 0o644u16, 1) != canonical_file_identity_sha256_word(abc, 0o755u16, 1)
            or canonical_file_identity_sha256_word(abc, 0o644u16, 2) != canonical_file_identity_sha256_word(abc, 0o755u16, 2)
            or canonical_file_identity_sha256_word(abc, 0o644u16, 3) != canonical_file_identity_sha256_word(abc, 0o755u16, 3)
        assert mode_644_changed
        assert canonical_file_identity_sha256_word(abc, 4096u16, 0) == 0


@test
def incremental_file_open_rejects_invalid_capability_and_paths() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        descriptor_rejected: mutable bool = false
        catch open_build_incremental_file_at(-1, "src/main.c"):
            ok opened:
                descriptor_rejected <- false
            error failure:
                descriptor_rejected <- failure == OpenError.InvalidDirectoryDescriptor
        assert descriptor_rejected

        path_rejected: mutable bool = false
        catch open_build_incremental_file_at(-1, "../outside"):
            ok opened:
                path_rejected <- false
            error failure:
                path_rejected <- failure == OpenError.InvalidPath
        assert path_rejected

        toolchain_rejected: mutable bool = false
        scratch: mutable Arena = zeroed
        catch observe_build_recipe_toolchain_identity_at(scratch, -1, "usr/bin/compiler"):
            ok identity:
                toolchain_rejected <- false
            error failure:
                toolchain_rejected <- failure == OpenError.InvalidDirectoryDescriptor
        assert toolchain_rejected
