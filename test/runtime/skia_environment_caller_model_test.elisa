include "../../src/runtime/skia_environment_caller_model.elisa"

using EsSkiaEnvironmentCaller


@test
def skia_environment_caller_decodes_then_strips_python_whitespace() -> void:
    assert captured_stdout_value("") == ""
    assert captured_stdout_value("None\n") == "None"
    assert captured_stdout_value("\n") == ""
    assert captured_stdout_value("  value\xc2\xa0\xe2\x80\x83\n") == "  value"
    assert captured_stdout_value("first\nsecond\n") == "first\nsecond"


@test
def skia_environment_caller_rejects_invalid_utf8_before_trimming() -> void:
    invalid: mutable bool = false
    catch captured_stdout_value("value\xff\n"):
        ok _:
            assert false
        error failure:
            invalid <- failure == EsPythonText::PythonTextError.InvalidUtf8
    assert invalid
