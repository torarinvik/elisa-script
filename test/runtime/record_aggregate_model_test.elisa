include "../../src/runtime/record_aggregate_model.elisa"

using EsRecordAggregate


@test
def record_aggregate_hash_index_preserves_order_and_rejects_damage() -> void:
    can Memory.Allocate, Abort.Panic:
        policy: RecordAggregatePolicy = RecordAggregatePolicy{max_groups: 4, max_events: 8, max_key_bytes: 64, max_sum: 64}
        session: mutable RecordAggregateSession = RecordAggregateSession{policy: policy}
        assert advance_record_aggregate(session, RecordAggregateEvent.Begin) == RecordAggregateState.Collecting
        assert advance_record_aggregate(session, RecordAggregateEvent.Add, "alpha") == RecordAggregateState.Collecting
        assert advance_record_aggregate(session, RecordAggregateEvent.Add, "beta") == RecordAggregateState.Collecting
        assert advance_record_aggregate(session, RecordAggregateEvent.Add, "alpha") == RecordAggregateState.Collecting
        assert session.index_slots.count == Limits::INDEX_MINIMUM
        assert session.groups[0].key == "alpha"
        assert session.groups[1].key == "beta"
        assert advance_record_aggregate(session, RecordAggregateEvent.Seal) == RecordAggregateState.Sealed
        assert record_aggregate_group_count(session, "alpha") == 2
        assert record_aggregate_group_count(session, "beta") == 1

        signed_aggregate: mutable RecordAggregateSession = RecordAggregateSession{policy: policy}
        assert advance_record_aggregate(signed_aggregate, RecordAggregateEvent.Begin) == RecordAggregateState.Collecting
        assert advance_record_aggregate(signed_aggregate, RecordAggregateEvent.AddValue, "alpha", -5) == RecordAggregateState.Collecting
        assert advance_record_aggregate(signed_aggregate, RecordAggregateEvent.AddValue, "alpha", 3) == RecordAggregateState.Collecting
        assert advance_record_aggregate(signed_aggregate, RecordAggregateEvent.Seal) == RecordAggregateState.Sealed
        assert record_aggregate_group_sum(signed_aggregate, "alpha") == -2

        negative_overflow: mutable RecordAggregateSession = RecordAggregateSession{policy: RecordAggregatePolicy{max_groups: 1, max_events: 2, max_key_bytes: 8, max_sum: 5}}
        assert advance_record_aggregate(negative_overflow, RecordAggregateEvent.Begin) == RecordAggregateState.Collecting
        assert advance_record_aggregate(negative_overflow, RecordAggregateEvent.AddValue, "x", -5) == RecordAggregateState.Collecting
        negative_sum_rejected: mutable bool = false
        catch advance_record_aggregate(negative_overflow, RecordAggregateEvent.AddValue, "x", -1):
            ok value:
                assert false
            error failure:
                negative_sum_rejected <- failure == RecordAggregateError.SumLimitExceeded
        assert negative_sum_rejected

        # These ASCII keys share the initial FNV bucket modulo eight; the
        # fifth insertion also forces the index to grow and rehash.
        index_growth: mutable RecordAggregateSession = RecordAggregateSession{policy: RecordAggregatePolicy{max_groups: 5, max_events: 8, max_key_bytes: 64, max_sum: 64}}
        assert advance_record_aggregate(index_growth, RecordAggregateEvent.Begin) == RecordAggregateState.Collecting
        assert advance_record_aggregate(index_growth, RecordAggregateEvent.Add, "a") == RecordAggregateState.Collecting
        assert advance_record_aggregate(index_growth, RecordAggregateEvent.Add, "i") == RecordAggregateState.Collecting
        assert advance_record_aggregate(index_growth, RecordAggregateEvent.Add, "q") == RecordAggregateState.Collecting
        assert advance_record_aggregate(index_growth, RecordAggregateEvent.Add, "b") == RecordAggregateState.Collecting
        assert advance_record_aggregate(index_growth, RecordAggregateEvent.Add, "j") == RecordAggregateState.Collecting
        assert index_growth.index_slots.count == 16
        assert index_growth.groups[0].key == "a" and index_growth.groups[1].key == "i"
        assert advance_record_aggregate(index_growth, RecordAggregateEvent.Seal) == RecordAggregateState.Sealed
        assert record_aggregate_group_count(index_growth, "a") == 1
        assert record_aggregate_group_count(index_growth, "i") == 1
        assert record_aggregate_group_count(index_growth, "q") == 1
        assert record_aggregate_group_count(index_growth, "b") == 1
        assert record_aggregate_group_count(index_growth, "j") == 1

        damaged: mutable RecordAggregateSession = session
        for index in 0..<damaged.index_slots.count |damaged|:
            damaged.index_slots[index] <- 0
        rejected_damage: mutable bool = false
        catch validate_record_aggregate(damaged):
            ok value:
                assert false
            error failure:
                rejected_damage <- failure == RecordAggregateError.AccountingInvalid
        assert rejected_damage
