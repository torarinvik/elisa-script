# Pure admission only: no pointers, native table construction or process runs.
include "../../src/runtime/process_launch_vectors_model.elisa"
include "../../src/runtime/environment_snapshot_model.elisa"

module EsLaunchVectorsFixture:
    public:
        def storage() -> EsProcessLaunchStorage::Prepared error[EsEnvironmentSnapshot::SnapshotError, EsEnvironment::EnvironmentContractError, EsProcessEnvironmentPlan::PlanError, EsProcessLaunchStorage::StorageError] can[Memory.Allocate, Abort.Panic]:
            entries: darray[darray[u8]] = [[67u8,67u8,61u8,0u8], [80u8,65u8,84u8,72u8,61u8,47u8,98u8,105u8,110u8,0u8]]
            ambient: EsEnvironment::EnvironmentSnapshot = try EsEnvironmentSnapshot::from_entries(entries)
            return try EsProcessLaunchStorage::prepare(ambient, [EsEnvironment::EnvironmentEntry{name: "CC", value: "clang"}], "tool", ["", "a b"])


        def rejected(storage: EsProcessLaunchStorage::Prepared) -> bool:
            catch EsProcessLaunchVectors::admit(storage, 8):
                ok _:
                    return false
                error failure:
                    return true


@test
def native_launch_vector_admission_counts_all_three_null_sentinels() -> void:
    can Memory.Allocate, Abort.Panic:
        storage: EsProcessLaunchStorage::Prepared = try EsLaunchVectorsFixture::storage() else err:
            assert false
            return
        receipt: EsProcessLaunchVectors::Receipt = try EsProcessLaunchVectors::admit(storage, 8, 111) else err:
            assert false
            return
        assert storage.storage_bytes == 39
        assert receipt.argv_slots == 4 and receipt.environment_slots == 3 and receipt.candidate_slots == 2
        assert receipt.table_bytes == 72 and receipt.total_bytes == 111
        narrow: EsProcessLaunchVectors::Receipt = try EsProcessLaunchVectors::admit(storage, 4, 75) else err:
            assert false
            return
        assert narrow.table_bytes == 36 and narrow.total_bytes == 75
        rejected: mutable bool = false
        catch EsProcessLaunchVectors::admit(storage, 8, 110):
            ok _:
                assert false
            error failure:
                rejected <- failure == EsProcessLaunchVectors::VectorError.StorageLimit
        assert rejected


@test
def native_launch_vector_admission_rejects_forged_receipts_before_tables() -> void:
    can Memory.Allocate, Abort.Panic:
        original: EsProcessLaunchStorage::Prepared = try EsLaunchVectorsFixture::storage() else err:
            assert false
            return
        forged: mutable EsProcessLaunchStorage::Prepared = original
        forged.storage_bytes <- 1
        assert EsLaunchVectorsFixture::rejected(forged)
        forged <- original
        forged.argument_bytes <- 1
        assert EsLaunchVectorsFixture::rejected(forged)
        forged <- original
        forged.environment.environment_bytes <- 1
        assert EsLaunchVectorsFixture::rejected(forged)
        forged <- original
        forged.environment.search_bytes <- 1
        assert EsLaunchVectorsFixture::rejected(forged)


@test
def native_launch_vector_admission_rejects_invalid_terminated_buffer_shapes() -> void:
    can Memory.Allocate, Abort.Panic:
        invalid_arguments: darray[darray[darray[u8]]] = [[], [[0u8]], [[116u8,0u8,120u8,0u8]], [[116u8,120u8]]]
        for invalid in invalid_arguments:
            storage: mutable EsProcessLaunchStorage::Prepared = try EsLaunchVectorsFixture::storage() else err:
                assert false
                return
            storage.arguments <- invalid
            assert EsLaunchVectorsFixture::rejected(storage)
        storage: mutable EsProcessLaunchStorage::Prepared = try EsLaunchVectorsFixture::storage() else err:
            assert false
            return
        storage.environment.executable_candidates <- []
        assert EsLaunchVectorsFixture::rejected(storage)


@test
def native_launch_vector_admission_rejects_duplicate_or_malformed_environment() -> void:
    can Memory.Allocate, Abort.Panic:
        invalid_environments: darray[darray[darray[u8]]] = [[[65u8,0u8]], [[61u8,120u8,0u8]], [[65u8,61u8,0u8], [65u8,61u8,120u8,0u8]]]
        for environment in invalid_environments:
            storage: mutable EsProcessLaunchStorage::Prepared = try EsLaunchVectorsFixture::storage() else err:
                assert false
                return
            storage.environment.environment <- environment
            assert EsLaunchVectorsFixture::rejected(storage)


@test
def native_launch_vector_admission_rejects_unsupported_pointer_sizes() -> void:
    can Memory.Allocate, Abort.Panic:
        storage: EsProcessLaunchStorage::Prepared = try EsLaunchVectorsFixture::storage() else err:
            assert false
            return
        for width in [0usize, 1usize, 16usize]:
            rejected: mutable bool = false
            catch EsProcessLaunchVectors::admit(storage, width):
                ok _:
                    assert false
                error failure:
                    rejected <- failure == EsProcessLaunchVectors::VectorError.UnsupportedPointerSize
            assert rejected
