include "../../src/testing/geometry_subset_normal_scale_cases.elisa"

using EsGeometrySubsetNormalScaleCases


@test
def normal_scale_cases_preserve_order_and_typed_package_parameters() -> void can[Memory.Allocate, Abort.Panic]:
    generated: darray[Case] = cases()
    assert generated.count == 8
    for index in 1..<generated.count |generated|:
        assert generated[index].verdict == Verdict.Reject

    accepted: Case = generated[0]
    assert accepted.verdict == Verdict.Accept
    assert accepted.file_name == "normal-scale.pkg"
    assert accepted.triangle_count == 2u32
    assert accepted.material_slots == 2u32
    assert accepted.subsets.count == 2
    assert accepted.subsets[0].first_index == 0u32 and accepted.subsets[0].index_count == 3u32 and accepted.subsets[0].material_slot == 0u32
    assert accepted.subsets[1].first_index == 3u32 and accepted.subsets[1].index_count == 3u32 and accepted.subsets[1].material_slot == 1u32
    assert accepted.has_material_records and accepted.material_record_count == 2u32
    assert accepted.normal_scale_stride == "4" and accepted.has_normal_scale_data_field
    assert accepted.normal_scales.count == 2
    assert accepted.normal_scales[0].kind == NumberKind.Finite and accepted.normal_scales[0].finite_value == 0.75
    assert accepted.normal_scales[1].kind == NumberKind.Finite and accepted.normal_scales[1].finite_value == -0.75
    assert accepted.expected_diagnostic == ""

    without_materials: Case = generated[1]
    assert without_materials.file_name == "normal-scale-without-materials.pkg"
    assert not without_materials.has_material_records and without_materials.material_record_count == 0u32
    assert without_materials.expected_diagnostic == "invalid cooked slot normal scales"

    stride: Case = generated[2]
    assert stride.file_name == "normal-scale-stride.pkg"
    assert stride.material_record_count == 1u32 and stride.normal_scale_stride == "8"
    assert stride.expected_diagnostic == "invalid cooked slot normal scales"

    missing_data: Case = generated[3]
    assert missing_data.file_name == "normal-scale-no-records.pkg"
    assert not missing_data.has_normal_scale_data_field
    assert missing_data.expected_diagnostic == "invalid cooked slot normal scales"

    count: Case = generated[4]
    assert count.file_name == "normal-scale-count.pkg"
    assert count.material_slots == 1u32 and count.normal_scales.count == 2
    assert count.expected_diagnostic == "invalid cooked slot normal scales"

    overflow: Case = generated[5]
    assert overflow.file_name == "normal-scale-overflow.pkg"
    assert overflow.normal_scales[0].kind == NumberKind.Finite and overflow.normal_scales[0].finite_value == 65505.0
    assert overflow.expected_diagnostic == "cooked slot normal scale is out of range"

    nan: Case = generated[6]
    assert nan.file_name == "normal-scale-nan.pkg"
    assert nan.normal_scales[0].kind == NumberKind.NaN
    assert nan.expected_diagnostic == "cooked slot normal scale is out of range"

    infinite: Case = generated[7]
    assert infinite.file_name == "normal-scale-infinite.pkg"
    assert infinite.normal_scales[0].kind == NumberKind.PositiveInfinity
    assert infinite.expected_diagnostic == "cooked slot normal scale is out of range"
