include "../../src/runtime/bash_exec_lookup_model.elisa"

using EsBashExecLookup


@test
def slash_containing_command_bypasses_path_search() -> void:
    plan: PathSearchPlan = try plan_path_search("./tools/ruff", "bin::local/bin")
    assert plan.mode == SearchMode.DirectName
    assert plan.directories.count == 0


@test
def empty_path_uses_the_command_spelling_directly() -> void:
    plan: PathSearchPlan = try plan_path_search("ruff", "")
    assert plan.mode == SearchMode.DirectName
    assert plan.directories.count == 0


@test
def path_plan_keeps_order_maps_interior_empty_entries_and_omits_trailing_empty() -> void:
    path_value: sview = "first::~/tools:last:"
    plan: PathSearchPlan = try plan_path_search("ruff", path_value)
    assert plan.mode == SearchMode.PathDirectories
    assert plan.directories.count == 4
    assert path_directory_spelling(plan, 0) == "first"
    assert plan.directories[1].kind == PathDirectoryKind.CurrentDirectory
    assert path_directory_spelling(plan, 1) == "."
    assert path_directory_spelling(plan, 2) == "~/tools"
    assert plan.directories[2].tilde_expansion_candidate
    assert path_directory_spelling(plan, 3) == "last"


@test
def path_plan_maps_leading_and_repeated_empty_components_to_current_directory() -> void:
    plan: PathSearchPlan = try plan_path_search("ruff", "::bin::tail::")
    assert plan.mode == SearchMode.PathDirectories
    assert plan.directories.count == 6
    assert plan.directories[0].kind == PathDirectoryKind.CurrentDirectory
    assert plan.directories[1].kind == PathDirectoryKind.CurrentDirectory
    assert path_directory_spelling(plan, 0) == "."
    assert path_directory_spelling(plan, 1) == "."
    assert path_directory_spelling(plan, 2) == "bin"
    assert plan.directories[3].kind == PathDirectoryKind.CurrentDirectory
    assert path_directory_spelling(plan, 3) == "."
    assert path_directory_spelling(plan, 4) == "tail"
    assert plan.directories[5].kind == PathDirectoryKind.CurrentDirectory
    assert path_directory_spelling(plan, 5) == "."


@test
def current_home_tilde_expansion_preserves_separator_bytes() -> void:
    home_bytes: mutable darray[u8] = []
    for byte in "/Users/elisa" |home_bytes|:
        home_bytes.push(byte)
    home: mutable PathTildeContext = PathTildeContext{home_present: true, home_directory: home_bytes}
    assert bytes_view(try resolve_path_directory("~", home)) == "/Users/elisa"
    assert bytes_view(try resolve_path_directory("~/bin", home)) == "/Users/elisa/bin"
    assert bytes_view(try resolve_path_directory("~//bin", home)) == "/Users/elisa//bin"


@test
def home_pwd_and_oldpwd_tilde_prefixes_expand_from_explicit_snapshots() -> void:
    empty_home: mutable PathTildeContext = PathTildeContext{home_present: true}
    assert bytes_view(try resolve_path_directory("~/tools", empty_home)) == "/tools"

    account_home_bytes: mutable darray[u8] = []
    for byte in "/users/account" |account_home_bytes|:
        account_home_bytes.push(byte)
    account_home: mutable PathTildeContext = PathTildeContext{
        account_home_present: true,
        account_home_directory: account_home_bytes
    }
    assert bytes_view(try resolve_path_directory("~", account_home)) == "/users/account"
    assert bytes_view(try resolve_path_directory("~/tools", account_home)) == "/users/account/tools"

    empty_home_with_fallback: mutable PathTildeContext = PathTildeContext{
        home_present: true,
        account_home_present: true,
        account_home_directory: account_home_bytes
    }
    assert bytes_view(try resolve_path_directory("~", empty_home_with_fallback)) == ""
    assert bytes_view(try resolve_path_directory("~/tools", empty_home_with_fallback)) == "/tools"

    pwd_bytes: mutable darray[u8] = []
    for byte in "/work/current" |pwd_bytes|:
        pwd_bytes.push(byte)
    oldpwd_bytes: mutable darray[u8] = []
    for byte in "/work/previous" |oldpwd_bytes|:
        oldpwd_bytes.push(byte)
    shell_directories: mutable PathTildeContext = PathTildeContext{
        pwd_present: true,
        pwd_directory: pwd_bytes,
        oldpwd_present: true,
        oldpwd_directory: oldpwd_bytes
    }
    assert bytes_view(try resolve_path_directory("~+", shell_directories)) == "/work/current"
    assert bytes_view(try resolve_path_directory("~+/tools", shell_directories)) == "/work/current/tools"
    assert bytes_view(try resolve_path_directory("~+//tools", shell_directories)) == "/work/current//tools"
    assert bytes_view(try resolve_path_directory("~-", shell_directories)) == "/work/previous"
    assert bytes_view(try resolve_path_directory("~-/tools", shell_directories)) == "/work/previous/tools"

    missing_home: mutable PathTildeContext = PathTildeContext{}
    missing_home_rejected: mutable bool = false
    catch resolve_path_directory("~", missing_home):
        ok directory:
            _ = directory
        error failure:
            missing_home_rejected <- failure == LookupError.TildeSnapshotUnavailable

    named_user_rejected: mutable bool = false
    catch resolve_path_directory("~someone/tools", empty_home):
        ok directory:
            _ = directory
        error failure:
            named_user_rejected <- failure == LookupError.TildeExpansionUnsupported

    missing_pwd_rejected: mutable bool = false
    catch resolve_path_directory("~+/tools", empty_home):
        ok directory:
            _ = directory
        error failure:
            missing_pwd_rejected <- failure == LookupError.TildeExpansionUnsupported

    missing_oldpwd_rejected: mutable bool = false
    catch resolve_path_directory("~-/tools", empty_home):
        ok directory:
            _ = directory
        error failure:
            missing_oldpwd_rejected <- failure == LookupError.TildeExpansionUnsupported

    directory_stack_rejected: mutable bool = false
    catch resolve_path_directory("~+1/tools", shell_directories):
        ok directory:
            _ = directory
        error failure:
            directory_stack_rejected <- failure == LookupError.TildeSnapshotUnavailable

    old_directory_stack_rejected: mutable bool = false
    catch resolve_path_directory("~-1/tools", shell_directories):
        ok directory:
            _ = directory
        error failure:
            old_directory_stack_rejected <- failure == LookupError.TildeSnapshotUnavailable

    assert missing_home_rejected and named_user_rejected and missing_pwd_rejected and missing_oldpwd_rejected and directory_stack_rejected and old_directory_stack_rejected


@test
def indexed_directory_stack_tilde_prefixes_follow_dirs_order_and_shell_pwd() -> void:
    pwd_bytes: mutable darray[u8] = []
    for byte in "/logical/current" |pwd_bytes|:
        pwd_bytes.push(byte)
    stack_left: mutable darray[u8] = []
    for byte in "/stack/left" |stack_left|:
        stack_left.push(byte)
    stack_right: mutable darray[u8] = []
    for byte in "/stack/right" |stack_right|:
        stack_right.push(byte)
    tilde: mutable PathTildeContext = PathTildeContext{
        pwd_present: true,
        pwd_directory: pwd_bytes,
        directory_stack_present: true,
        directory_stack: [stack_left, stack_right]
    }

    assert bytes_view(try resolve_path_directory("~0/bin", tilde)) == "/logical/current/bin"
    assert bytes_view(try resolve_path_directory("~+0/bin", tilde)) == "/logical/current/bin"
    assert bytes_view(try resolve_path_directory("~1/bin", tilde)) == "/stack/left/bin"
    assert bytes_view(try resolve_path_directory("~+2/bin", tilde)) == "/stack/right/bin"
    assert bytes_view(try resolve_path_directory("~-0/bin", tilde)) == "/stack/right/bin"
    assert bytes_view(try resolve_path_directory("~-1/bin", tilde)) == "/stack/left/bin"
    assert bytes_view(try resolve_path_directory("~-2/bin", tilde)) == "/logical/current/bin"
    assert bytes_view(try resolve_path_directory("~+0001/bin", tilde)) == "/stack/left/bin"

    missing_entry_rejected: mutable bool = false
    catch resolve_path_directory("~+3/bin", tilde):
        ok directory:
            _ = directory
        error failure:
            missing_entry_rejected <- failure == LookupError.TildeExpansionUnsupported

    long_out_of_range_entry_rejected: mutable bool = false
    catch resolve_path_directory("~999999999999999999999999999999999999999999/bin", tilde):
        ok directory:
            _ = directory
        error failure:
            long_out_of_range_entry_rejected <- failure == LookupError.TildeExpansionUnsupported

    assert missing_entry_rejected and long_out_of_range_entry_rejected


@test
def named_user_tilde_prefix_uses_explicit_passwd_lookup_outcomes() -> void:
    alice_name: mutable darray[u8] = []
    for byte in "alice" |alice_name|:
        alice_name.push(byte)
    alice_home: mutable darray[u8] = []
    for byte in "/users/alice" |alice_home|:
        alice_home.push(byte)
    missing_name: mutable darray[u8] = []
    for byte in "missing" |missing_name|:
        missing_name.push(byte)
    unavailable_name: mutable darray[u8] = []
    for byte in "lookup-unavailable" |unavailable_name|:
        unavailable_name.push(byte)
    numeric_name: mutable darray[u8] = []
    for byte in "99" |numeric_name|:
        numeric_name.push(byte)
    numeric_home: mutable darray[u8] = []
    for byte in "/users/numeric" |numeric_home|:
        numeric_home.push(byte)

    left_entry: mutable darray[u8] = []
    for byte in "/stack/left" |left_entry|:
        left_entry.push(byte)
    right_entry: mutable darray[u8] = []
    for byte in "/stack/right" |right_entry|:
        right_entry.push(byte)
    tilde: mutable PathTildeContext = PathTildeContext{
        directory_stack_present: true,
        directory_stack: [left_entry, right_entry],
        named_user_homes: [
            NamedUserHomeLookup{username: alice_name, state: NamedUserHomeState.HomeFound, home_directory: alice_home},
            NamedUserHomeLookup{username: missing_name, state: NamedUserHomeState.UserNotFound},
            NamedUserHomeLookup{username: unavailable_name, state: NamedUserHomeState.LookupUnavailable},
            NamedUserHomeLookup{username: numeric_name, state: NamedUserHomeState.HomeFound, home_directory: numeric_home}
        ]
    }

    assert bytes_view(try resolve_path_directory("~alice/bin", tilde)) == "/users/alice/bin"
    assert bytes_view(try resolve_path_directory("~alice//bin", tilde)) == "/users/alice//bin"
    assert bytes_view(try resolve_path_directory("~missing/bin", tilde)) == "~missing/bin"
    assert bytes_view(try resolve_path_directory("~99/bin", tilde)) == "/users/numeric/bin"

    lookup_unavailable_preserved: bool = bytes_view(try resolve_path_directory("~lookup-unavailable/bin", tilde)) == "~lookup-unavailable/bin"

    missing_lookup_reported: mutable bool = false
    catch resolve_path_directory("~unqueried/bin", tilde):
        ok directory:
            _ = directory
        error failure:
            missing_lookup_reported <- failure == LookupError.TildeExpansionUnsupported

    assert lookup_unavailable_preserved and missing_lookup_reported


@test
def path_directory_reader_rejects_forged_out_of_bounds_spans() -> void:
    rejected: mutable bool = false
    forged: PathSearchPlan = PathSearchPlan{mode: SearchMode.PathDirectories, path_bytes: [98u8, 105u8, 110u8], directories: [PathDirectory{kind: PathDirectoryKind.NamedDirectory, start: 2, length: 4}]}
    catch path_directory_spelling(forged, 0):
        ok directory:
            _ = directory
        error failure:
            rejected <- failure == LookupError.InvalidSearchPlan
    assert rejected


@test
def path_plan_validator_rejects_forged_in_bounds_spans() -> void:
    rejected: mutable bool = false
    forged: PathSearchPlan = PathSearchPlan{mode: SearchMode.PathDirectories, path_bytes: [98u8, 105u8, 110u8], directories: [PathDirectory{kind: PathDirectoryKind.NamedDirectory, start: 2, length: 1}]}
    catch validate_path_search_plan(forged, "ruff"):
        ok result:
            _ = result
        error failure:
            rejected <- failure == LookupError.InvalidSearchPlan
    assert rejected


@test
def candidate_join_matches_bash_separator_and_empty_directory_rules() -> void:
    assert bytes_view(try join_search_candidate("bin", "ruff")) == "bin/ruff"
    assert bytes_view(try join_search_candidate("bin/", "ruff")) == "bin/ruff"
    assert bytes_view(try join_search_candidate("bin//", "ruff")) == "bin//ruff"
    assert bytes_view(try join_search_candidate("/", "ruff")) == "/ruff"
    assert bytes_view(try join_search_candidate("", "ruff")) == "./ruff"


@test
def candidate_join_rejects_names_that_must_bypass_path_search() -> void:
    rejected: mutable bool = false
    catch join_search_candidate("bin", "./ruff"):
        ok candidate:
            _ = candidate
        error failure:
            rejected <- failure == LookupError.DirectNameMustBypassPath
    assert rejected


@test
def owner_execute_bit_takes_precedence_over_other_execute_bit() -> void:
    credentials: CredentialSnapshot = CredentialSnapshot{effective_user: 10u32, effective_group: 20u32, supplementary_groups: []}
    assert not mode_allows_execution(0o001u16, 10u32, 30u32, credentials)
    assert mode_allows_execution(0o100u16, 10u32, 30u32, credentials)


@test
def primary_and_supplementary_group_execute_bits_are_honored() -> void:
    primary: CredentialSnapshot = CredentialSnapshot{effective_user: 10u32, real_group: 19u32, effective_group: 20u32, supplementary_groups: []}
    supplementary: CredentialSnapshot = CredentialSnapshot{effective_user: 10u32, effective_group: 20u32, supplementary_groups: [30u32, 40u32]}
    assert mode_allows_execution(0o010u16, 11u32, 20u32, primary)
    assert mode_allows_execution(0o010u16, 11u32, 19u32, primary)
    assert mode_allows_execution(0o010u16, 11u32, 30u32, supplementary)
    assert not mode_allows_execution(0o010u16, 11u32, 31u32, supplementary)


@test
def other_execute_bit_is_used_only_for_nonmembers() -> void:
    credentials: CredentialSnapshot = CredentialSnapshot{effective_user: 10u32, effective_group: 20u32, supplementary_groups: []}
    assert mode_allows_execution(0o001u16, 11u32, 30u32, credentials)
    assert not mode_allows_execution(0o010u16, 11u32, 30u32, credentials)


@test
def root_requires_at_least_one_execute_bit() -> void:
    root: CredentialSnapshot = CredentialSnapshot{effective_user: 0u32, effective_group: 0u32, supplementary_groups: []}
    assert mode_allows_execution(0o010u16, 10u32, 20u32, root)
    assert not mode_allows_execution(0o640u16, 10u32, 20u32, root)


@test
def executable_entries_take_precedence_over_earlier_denied_files() -> void:
    candidates: darray[PathCandidate] = [
        PathCandidate{exists: true, executable: false},
        PathCandidate{exists: true, executable: false, directory: true},
        PathCandidate{exists: false},
        PathCandidate{exists: true, executable: true}
    ]
    selected: Selection = try select_path_candidate(candidates)
    assert selected.kind == SelectionKind.Executable
    assert selected.index == 3


@test
def first_existing_non_directory_is_fallback_only_when_no_executable_exists() -> void:
    candidates: darray[PathCandidate] = [
        PathCandidate{exists: true, executable: false},
        PathCandidate{exists: true, executable: false},
        PathCandidate{exists: true, executable: false, directory: true}
    ]
    selected: Selection = try select_path_candidate(candidates)
    assert selected.kind == SelectionKind.NonExecutableFallback
    assert selected.index == 0


@test
def missing_entries_and_directories_do_not_become_fallbacks() -> void:
    selected: Selection = try select_path_candidate([
        PathCandidate{exists: false},
        PathCandidate{exists: true, executable: true, directory: true},
        PathCandidate{exists: true, executable: false, directory: true}
    ])
    assert selected.kind == SelectionKind.NotFound


@test
def first_directory_fallback_shadows_a_later_non_executable_path_entry() -> void:
    selected: Selection = try select_path_candidate([
        PathCandidate{exists: true, executable: false, directory: true},
        PathCandidate{exists: true, executable: false}
    ])
    assert selected.kind == SelectionKind.NotFound


@test
def rejects_filesystem_observations_that_cannot_describe_bash_file_status() -> void:
    missing_candidate_rejected: mutable bool = false
    catch select_path_candidate([PathCandidate{exists: false, executable: true}]):
        ok selection:
            _ = selection
        error failure:
            missing_candidate_rejected <- failure == LookupError.InvalidCandidateState
    directory_exec_rejected: mutable bool = false
    catch select_path_candidate([PathCandidate{exists: true, executable: true, directory: true}]):
        ok selection:
            _ = selection
        error failure:
            directory_exec_rejected <- failure == LookupError.InvalidCandidateState
    assert missing_candidate_rejected
    assert directory_exec_rejected
