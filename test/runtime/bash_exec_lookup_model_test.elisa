include "../../src/runtime/bash_exec_lookup_model.elisa"

using EsBashExecLookup


@test
def slash_containing_command_bypasses_path_search() -> void:
    plan: PathSearchPlan = try plan_path_search("./tools/ruff", "bin::local/bin")
    assert plan.mode == SearchMode.DirectName
    assert plan.directories.count == 0


@test
def empty_path_uses_the_command_spelling_directly() -> void:
    plan: PathSearchPlan = try plan_path_search("ruff", "")
    assert plan.mode == SearchMode.DirectName
    assert plan.directories.count == 0


@test
def path_plan_keeps_order_maps_interior_empty_entries_and_omits_trailing_empty() -> void:
    path_value: sview = "first::~/tools:last:"
    plan: PathSearchPlan = try plan_path_search("ruff", path_value)
    assert plan.mode == SearchMode.PathDirectories
    assert plan.directories.count == 4
    assert path_directory_spelling(plan, 0) == "first"
    assert plan.directories[1].kind == PathDirectoryKind.CurrentDirectory
    assert path_directory_spelling(plan, 1) == "."
    assert path_directory_spelling(plan, 2) == "~/tools"
    assert plan.directories[2].tilde_expansion_candidate
    assert path_directory_spelling(plan, 3) == "last"


@test
def path_directory_reader_rejects_forged_out_of_bounds_spans() -> void:
    rejected: mutable bool = false
    forged: PathSearchPlan = PathSearchPlan{mode: SearchMode.PathDirectories, path_bytes: [98u8, 105u8, 110u8], directories: [PathDirectory{kind: PathDirectoryKind.NamedDirectory, start: 2, length: 4}]}
    catch path_directory_spelling(forged, 0):
        ok directory:
            _ = directory
        error failure:
            rejected <- failure == LookupError.InvalidSearchPlan
    assert rejected


@test
def path_plan_validator_rejects_forged_in_bounds_spans() -> void:
    rejected: mutable bool = false
    forged: PathSearchPlan = PathSearchPlan{mode: SearchMode.PathDirectories, path_bytes: [98u8, 105u8, 110u8], directories: [PathDirectory{kind: PathDirectoryKind.NamedDirectory, start: 2, length: 1}]}
    catch validate_path_search_plan(forged, "ruff"):
        ok result:
            _ = result
        error failure:
            rejected <- failure == LookupError.InvalidSearchPlan
    assert rejected


@test
def candidate_join_matches_bash_separator_and_empty_directory_rules() -> void:
    assert bytes_view(try join_search_candidate("bin", "ruff")) == "bin/ruff"
    assert bytes_view(try join_search_candidate("bin/", "ruff")) == "bin/ruff"
    assert bytes_view(try join_search_candidate("bin//", "ruff")) == "bin//ruff"
    assert bytes_view(try join_search_candidate("/", "ruff")) == "/ruff"
    assert bytes_view(try join_search_candidate("", "ruff")) == "./ruff"


@test
def candidate_join_rejects_names_that_must_bypass_path_search() -> void:
    rejected: mutable bool = false
    catch join_search_candidate("bin", "./ruff"):
        ok candidate:
            _ = candidate
        error failure:
            rejected <- failure == LookupError.DirectNameMustBypassPath
    assert rejected


@test
def owner_execute_bit_takes_precedence_over_other_execute_bit() -> void:
    credentials: CredentialSnapshot = CredentialSnapshot{effective_user: 10u32, effective_group: 20u32, supplementary_groups: []}
    assert not mode_allows_execution(0o001u16, 10u32, 30u32, credentials)
    assert mode_allows_execution(0o100u16, 10u32, 30u32, credentials)


@test
def primary_and_supplementary_group_execute_bits_are_honored() -> void:
    primary: CredentialSnapshot = CredentialSnapshot{effective_user: 10u32, real_group: 19u32, effective_group: 20u32, supplementary_groups: []}
    supplementary: CredentialSnapshot = CredentialSnapshot{effective_user: 10u32, effective_group: 20u32, supplementary_groups: [30u32, 40u32]}
    assert mode_allows_execution(0o010u16, 11u32, 20u32, primary)
    assert mode_allows_execution(0o010u16, 11u32, 19u32, primary)
    assert mode_allows_execution(0o010u16, 11u32, 30u32, supplementary)
    assert not mode_allows_execution(0o010u16, 11u32, 31u32, supplementary)


@test
def other_execute_bit_is_used_only_for_nonmembers() -> void:
    credentials: CredentialSnapshot = CredentialSnapshot{effective_user: 10u32, effective_group: 20u32, supplementary_groups: []}
    assert mode_allows_execution(0o001u16, 11u32, 30u32, credentials)
    assert not mode_allows_execution(0o010u16, 11u32, 30u32, credentials)


@test
def root_requires_at_least_one_execute_bit() -> void:
    root: CredentialSnapshot = CredentialSnapshot{effective_user: 0u32, effective_group: 0u32, supplementary_groups: []}
    assert mode_allows_execution(0o010u16, 10u32, 20u32, root)
    assert not mode_allows_execution(0o640u16, 10u32, 20u32, root)


@test
def executable_entries_take_precedence_over_earlier_denied_files() -> void:
    candidates: darray[PathCandidate] = [
        PathCandidate{exists: true, executable: false},
        PathCandidate{exists: true, executable: false, directory: true},
        PathCandidate{exists: false},
        PathCandidate{exists: true, executable: true}
    ]
    selected: Selection = try select_path_candidate(candidates)
    assert selected.kind == SelectionKind.Executable
    assert selected.index == 3


@test
def first_existing_non_directory_is_fallback_only_when_no_executable_exists() -> void:
    candidates: darray[PathCandidate] = [
        PathCandidate{exists: true, executable: false},
        PathCandidate{exists: true, executable: false},
        PathCandidate{exists: true, executable: false, directory: true}
    ]
    selected: Selection = try select_path_candidate(candidates)
    assert selected.kind == SelectionKind.NonExecutableFallback
    assert selected.index == 0


@test
def missing_entries_and_directories_do_not_become_fallbacks() -> void:
    selected: Selection = try select_path_candidate([
        PathCandidate{exists: false},
        PathCandidate{exists: true, executable: true, directory: true},
        PathCandidate{exists: true, executable: false, directory: true}
    ])
    assert selected.kind == SelectionKind.NotFound


@test
def first_directory_fallback_shadows_a_later_non_executable_path_entry() -> void:
    selected: Selection = try select_path_candidate([
        PathCandidate{exists: true, executable: false, directory: true},
        PathCandidate{exists: true, executable: false}
    ])
    assert selected.kind == SelectionKind.NotFound


@test
def rejects_filesystem_observations_that_cannot_describe_bash_file_status() -> void:
    missing_candidate_rejected: mutable bool = false
    catch select_path_candidate([PathCandidate{exists: false, executable: true}]):
        ok selection:
            _ = selection
        error failure:
            missing_candidate_rejected <- failure == LookupError.InvalidCandidateState
    directory_exec_rejected: mutable bool = false
    catch select_path_candidate([PathCandidate{exists: true, executable: true, directory: true}]):
        ok selection:
            _ = selection
        error failure:
            directory_exec_rejected <- failure == LookupError.InvalidCandidateState
    assert missing_candidate_rejected
    assert directory_exec_rejected
