include "../../src/runtime/bash_exec_lookup_model.elisa"

using EsBashExecLookup


@test
def owner_execute_bit_takes_precedence_over_other_execute_bit() -> void:
    credentials: CredentialSnapshot = CredentialSnapshot{effective_user: 10u32, effective_group: 20u32, supplementary_groups: []}
    assert not mode_allows_execution(0o001u16, 10u32, 30u32, credentials)
    assert mode_allows_execution(0o100u16, 10u32, 30u32, credentials)


@test
def primary_and_supplementary_group_execute_bits_are_honored() -> void:
    primary: CredentialSnapshot = CredentialSnapshot{effective_user: 10u32, effective_group: 20u32, supplementary_groups: []}
    supplementary: CredentialSnapshot = CredentialSnapshot{effective_user: 10u32, effective_group: 20u32, supplementary_groups: [30u32, 40u32]}
    assert mode_allows_execution(0o010u16, 11u32, 20u32, primary)
    assert mode_allows_execution(0o010u16, 11u32, 30u32, supplementary)
    assert not mode_allows_execution(0o010u16, 11u32, 31u32, supplementary)


@test
def other_execute_bit_is_used_only_for_nonmembers() -> void:
    credentials: CredentialSnapshot = CredentialSnapshot{effective_user: 10u32, effective_group: 20u32, supplementary_groups: []}
    assert mode_allows_execution(0o001u16, 11u32, 30u32, credentials)
    assert not mode_allows_execution(0o010u16, 11u32, 30u32, credentials)


@test
def root_requires_at_least_one_execute_bit() -> void:
    root: CredentialSnapshot = CredentialSnapshot{effective_user: 0u32, effective_group: 0u32, supplementary_groups: []}
    assert mode_allows_execution(0o010u16, 10u32, 20u32, root)
    assert not mode_allows_execution(0o640u16, 10u32, 20u32, root)


@test
def executable_entries_take_precedence_over_earlier_denied_files() -> void:
    candidates: darray[PathCandidate] = [
        PathCandidate{exists: true, executable: false},
        PathCandidate{exists: true, executable: true, directory: true},
        PathCandidate{exists: false},
        PathCandidate{exists: true, executable: true}
    ]
    selected: Selection = try select_path_candidate(candidates)
    assert selected.kind == SelectionKind.Executable
    assert selected.index == 3


@test
def first_existing_non_directory_is_fallback_only_when_no_executable_exists() -> void:
    candidates: darray[PathCandidate] = [
        PathCandidate{exists: true, executable: false},
        PathCandidate{exists: true, executable: false},
        PathCandidate{exists: true, executable: false, directory: true}
    ]
    selected: Selection = try select_path_candidate(candidates)
    assert selected.kind == SelectionKind.NonExecutableFallback
    assert selected.index == 0


@test
def missing_entries_and_directories_do_not_become_fallbacks() -> void:
    selected: Selection = try select_path_candidate([
        PathCandidate{exists: false},
        PathCandidate{exists: true, executable: true, directory: true},
        PathCandidate{exists: true, executable: false, directory: true}
    ])
    assert selected.kind == SelectionKind.NotFound


@test
def first_directory_fallback_shadows_a_later_non_executable_path_entry() -> void:
    selected: Selection = try select_path_candidate([
        PathCandidate{exists: true, executable: true, directory: true},
        PathCandidate{exists: true, executable: false}
    ])
    assert selected.kind == SelectionKind.NotFound


@test
def rejects_filesystem_observations_that_cannot_describe_a_path() -> void:
    rejected: mutable bool = false
    catch select_path_candidate([PathCandidate{exists: false, executable: true}]):
        ok selection:
            _ = selection
        error failure:
            rejected <- failure == LookupError.InvalidCandidateState
    assert rejected
