include "../../src/testing/geometry_subset_morph_cases.elisa"

using EsGeometrySubsetMorphCases


@test
def morph_metadata_replace_cases_keep_order_and_change_only_first_match() -> void can[Memory.Allocate, Abort.Panic]:
    morph_package: sview = "morph_target_position_stride=12\nmorph_target_position_stride=12\nmorph_targets=1\n"
    generated: darray[Case] = try EsGeometrySubsetMorphCases::cases(morph_package)
    assert generated.count == 2
    assert generated[0].file_name == "morph-stride.pkg"
    assert generated[0].expected_diagnostic == "morph metadata"
    assert bytes_view(generated[0].package_bytes) == "morph_target_position_stride=16\nmorph_target_position_stride=12\nmorph_targets=1\n"
    assert generated[1].file_name == "morph-empty.pkg"
    assert bytes_view(generated[1].package_bytes) == "morph_target_position_stride=12\nmorph_target_position_stride=12\nmorph_targets=0\n"


@test
def missing_morph_search_terms_preserve_the_complete_source() -> void can[Memory.Allocate, Abort.Panic]:
    morph_package: sview = "header=unchanged\r\nopaque=bytes\r\n"
    generated: darray[Case] = try EsGeometrySubsetMorphCases::cases(morph_package)
    assert bytes_view(generated[0].package_bytes) == morph_package
    assert bytes_view(generated[1].package_bytes) == morph_package
