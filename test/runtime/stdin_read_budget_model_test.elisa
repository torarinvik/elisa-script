# Pure budget fixtures, not native stdin or public-launcher execution.
include "../../src/runtime/stdin_read_budget_model.elisa"

using EsStdinReadBudget


@test
def stdin_budget_admits_eof_probe_without_extra_payload() -> void:
    assert read_capacity(0u64, 0u64, 4096usize) == 1usize
    assert payload_fits(0u64, 0u64, 0usize)
    assert not payload_fits(0u64, 0u64, 1usize)
    assert read_capacity(4096u64, 4096u64, 4096usize) == 1usize
    assert payload_fits(4096u64, 4096u64, 0usize)
    assert not payload_fits(4096u64, 4096u64, 1usize)
    assert read_capacity(1u64, 0u64, 4096usize) == 0usize
    assert not payload_fits(1u64, 0u64, 0usize)


@test
def stdin_budget_caps_chunks_and_keeps_line_reads_single_byte() -> void:
    assert read_capacity(0u64, 8192u64, 4096usize) == 4096usize
    assert read_capacity(4090u64, 4096u64, 4096usize) == 6usize
    assert payload_fits(4090u64, 4096u64, 6usize)
    assert not payload_fits(4090u64, 4096u64, 7usize)
    assert read_capacity(3u64, 4u64, 1usize) == 1usize
    assert payload_fits(3u64, 4u64, 1usize)
    assert read_capacity(4u64, 4u64, 1usize) == 1usize
    assert not payload_fits(4u64, 4u64, 1usize)
    assert read_capacity(0u64, 4u64, 0usize) == 0usize


@test
def stdin_budget_subtraction_handles_u64_boundary() -> void:
    consumed: u64 = 18446744073709551614u64
    limit: u64 = 18446744073709551615u64
    assert read_capacity(consumed, limit, 4096usize) == 1usize
    assert payload_fits(consumed, limit, 1usize)
    assert not payload_fits(consumed, limit, 2usize)
    assert read_capacity(limit, limit, 4096usize) == 1usize
    assert not payload_fits(limit, limit, 1usize)
    assert read_capacity(limit, consumed, 4096usize) == 0usize
    assert not payload_fits(limit, consumed, 0usize)
