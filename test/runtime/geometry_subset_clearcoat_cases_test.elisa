include "../../src/testing/geometry_subset_clearcoat_cases.elisa"

using EsGeometrySubsetClearcoatCases


@test
def clearcoat_cases_preserve_order_and_component_specific_bounds() -> void can[Memory.Allocate, Abort.Panic]:
    generated: darray[Case] = cases()
    assert generated.count == 9
    for index in 1..<generated.count |generated|:
        assert generated[index].verdict == Verdict.Reject

    accepted: Case = generated[0]
    assert accepted.verdict == Verdict.Accept
    assert accepted.file_name == "clearcoat-factors.pkg"
    assert accepted.triangle_count == 2u32 and accepted.material_slots == 1u32
    assert accepted.subsets.count == 1
    assert accepted.subsets[0].first_index == 0u32 and accepted.subsets[0].index_count == 6u32 and accepted.subsets[0].material_slot == 0u32
    assert accepted.has_material_records and accepted.material_record_count == 1u32
    assert accepted.clearcoat_factor_stride == "12" and accepted.has_clearcoat_factor_data_field
    assert accepted.clearcoat_factors.count == 1
    assert accepted.clearcoat_factors[0].factor.finite_value == 0.8
    assert accepted.clearcoat_factors[0].roughness.finite_value == 0.35
    assert accepted.clearcoat_factors[0].normal_scale.finite_value == 0.6
    assert accepted.expected_diagnostic == ""

    without_materials: Case = generated[1]
    assert without_materials.file_name == "clearcoat-factors-without-materials.pkg"
    assert not without_materials.has_material_records and without_materials.material_record_count == 0u32
    assert without_materials.expected_diagnostic == "invalid cooked slot clearcoat factors"

    stride: Case = generated[2]
    assert stride.file_name == "clearcoat-factors-stride.pkg"
    assert stride.clearcoat_factor_stride == "4"
    assert stride.expected_diagnostic == "invalid cooked slot clearcoat factors"

    missing_data: Case = generated[3]
    assert missing_data.file_name == "clearcoat-factors-missing-data.pkg"
    assert not missing_data.has_clearcoat_factor_data_field
    assert missing_data.expected_diagnostic == "invalid cooked slot clearcoat factors"

    count: Case = generated[4]
    assert count.file_name == "clearcoat-factors-count.pkg"
    assert count.material_slots == 1u32 and count.clearcoat_factors.count == 2
    assert count.expected_diagnostic == "invalid cooked slot clearcoat factors"

    negative: Case = generated[5]
    assert negative.file_name == "clearcoat-factor-negative.pkg"
    assert negative.clearcoat_factors[0].factor.finite_value == -0.01
    assert negative.expected_diagnostic == "cooked slot clearcoat factors are out of range"

    roughness: Case = generated[6]
    assert roughness.file_name == "clearcoat-roughness-overflow.pkg"
    assert roughness.clearcoat_factors[0].roughness.finite_value == 1.01
    assert roughness.expected_diagnostic == "cooked slot clearcoat factors are out of range"

    normal_scale: Case = generated[7]
    assert normal_scale.file_name == "clearcoat-normal-scale-overflow.pkg"
    assert normal_scale.clearcoat_factors[0].normal_scale.finite_value == 65505.0
    assert normal_scale.expected_diagnostic == "cooked slot clearcoat factors are out of range"

    nan: Case = generated[8]
    assert nan.file_name == "clearcoat-normal-scale-nan.pkg"
    assert nan.clearcoat_factors[0].normal_scale.kind == NumberKind.NaN
    assert nan.expected_diagnostic == "cooked slot clearcoat factors are out of range"
