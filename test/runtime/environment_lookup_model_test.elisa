include "../../src/runtime/environment_lookup_model.elisa"

using EsEnvironmentLookup


@test
def environment_lookup_preserves_absent_empty_and_literal_none() -> void:
    can Memory.Allocate, Abort.Panic:
        assert python_print_value(Value{present: false}) == "None\n"
        assert python_print_value(Value{present: true, bytes: ""}) == "\n"
        assert python_print_value(Value{present: true, bytes: "None"}) == "None\n"
        assert python_print_value(Value{present: true, bytes: "a\nb\n"}) == "a\nb\n\n"
        assert python_print_value(Value{present: true, bytes: "  $HOME * ; \\n  "}) == "  $HOME * ; \\n  \n"
        assert python_print_value(Value{present: true, bytes: "\xc3\xa9\xff"}) == "\xc3\xa9\xff\n"


@test
def environment_lookup_classifies_invalid_dictionary_keys() -> void:
    can Memory.Allocate, Abort.Panic:
        for name in ["", "a=b", "a\0b"]:
            impossible: bool = try impossible_key(name) else err:
                assert false
                return
            assert impossible
            rejected: mutable bool = false
            catch validate_name(name):
                ok _:
                    assert false
                error failure:
                    rejected <- failure == LookupError.InvalidName
            assert rejected
        for name in ["PATH", "name with spaces", "\xc3\xa9", "=", "a=b=c"]:
            impossible: bool = try impossible_key(name) else err:
                assert false
                return
            assert impossible == (name == "=" or name == "a=b=c")


@test
def environment_lookup_rejects_forged_absence_and_nul_payloads() -> void:
    can Memory.Allocate, Abort.Panic:
        invalid_absence: mutable bool = false
        catch validate_value(Value{present: false, bytes: "hidden"}):
            ok _:
                assert false
            error failure:
                invalid_absence <- failure == LookupError.InvalidAbsentValue
        assert invalid_absence
        embedded_nul: mutable bool = false
        catch validate_value(Value{present: true, bytes: "a\0b"}):
            ok _:
                assert false
            error failure:
                embedded_nul <- failure == LookupError.EmbeddedNulValue
        assert embedded_nul


@test
def environment_lookup_name_budget_accepts_boundary_and_rejects_overflow() -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = []
        bytes.reserve(Limits::NAME_BYTES + 1)
        for _ in 0..<Limits::NAME_BYTES |bytes|:
            bytes.push(120u8)
        try validate_name(bytes_view(bytes)) else err:
            assert false
            return
        bytes.push(120u8)
        rejected: mutable bool = false
        catch validate_name(bytes_view(bytes)):
            ok _:
                assert false
            error failure:
                rejected <- failure == LookupError.NameLimit
        assert rejected


@test
def environment_lookup_classification_admits_length_before_invalid_bytes() -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = []
        bytes.reserve(Limits::NAME_BYTES + 1)
        for _ in 0..<Limits::NAME_BYTES |bytes|:
            bytes.push(120u8)
        boundary: sview = bytes_view(bytes)
        impossible: mutable bool = try impossible_key(boundary) else err:
            assert false
            return
        assert not impossible
        # Invalid bytes still describe absent dictionary keys at the boundary.
        bytes[Limits::NAME_BYTES - 1] <- 61u8
        impossible <- try impossible_key(bytes_view(bytes)) else err:
            assert false
            return
        assert impossible
        bytes[Limits::NAME_BYTES - 1] <- 120u8
        bytes.push(120u8)
        # Test invalid bytes at both ends: neither may bypass length admission.
        for invalid in [0u8, 61u8] |bytes|:
            for index in [0usize, Limits::NAME_BYTES] |bytes|:
                bytes[0] <- 120u8
                bytes[Limits::NAME_BYTES] <- 120u8
                bytes[index] <- invalid
                classified: mutable bool = false
                catch impossible_key(bytes_view(bytes)):
                    ok _:
                        assert false
                    error failure:
                        classified <- failure == LookupError.NameLimit
                assert classified
                validated: mutable bool = false
                catch validate_name(bytes_view(bytes)):
                    ok _:
                        assert false
                    error failure:
                        validated <- failure == LookupError.NameLimit
                assert validated


@test
def environment_lookup_value_budget_accepts_boundary_and_rejects_overflow() -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: mutable darray[u8] = []
        bytes.reserve(Limits::VALUE_BYTES + 1)
        for _ in 0..<Limits::VALUE_BYTES |bytes|:
            bytes.push(120u8)
        try validate_value(Value{present: true, bytes: bytes_view(bytes)}) else err:
            assert false
            return
        printed: sview = try python_print_value(Value{present: true, bytes: bytes_view(bytes)}) else err:
            assert false
            return
        assert len(printed) == Limits::VALUE_BYTES + 1
        assert printed[0] == 120u8 and printed[Limits::VALUE_BYTES - 1] == 120u8
        assert printed[Limits::VALUE_BYTES] == 10u8
        # An in-budget NUL is a content error, not a size error.
        bytes[Limits::VALUE_BYTES - 1] <- 0u8
        nul_rejected: mutable bool = false
        catch validate_value(Value{present: true, bytes: bytes_view(bytes)}):
            ok _:
                assert false
            error failure:
                nul_rejected <- failure == LookupError.EmbeddedNulValue
        assert nul_rejected
        bytes[Limits::VALUE_BYTES - 1] <- 120u8
        bytes.push(120u8)
        rejected: mutable bool = false
        catch validate_value(Value{present: true, bytes: bytes_view(bytes)}):
            ok _:
                assert false
            error failure:
                rejected <- failure == LookupError.ValueLimit
        assert rejected
        # Both validation and printing reject the envelope before a NUL at
        # either end. No newline-appended output may be returned on overflow.
        for index in [0usize, Limits::VALUE_BYTES] |bytes|:
            bytes[0] <- 120u8
            bytes[Limits::VALUE_BYTES] <- 120u8
            bytes[index] <- 0u8
            oversized: mutable bool = false
            catch validate_value(Value{present: true, bytes: bytes_view(bytes)}):
                ok _:
                    assert false
                error failure:
                    oversized <- failure == LookupError.ValueLimit
            assert oversized
            no_output: mutable bool = false
            catch python_print_value(Value{present: true, bytes: bytes_view(bytes)}):
                ok _:
                    assert false
                error failure:
                    no_output <- failure == LookupError.ValueLimit
            assert no_output
        invalid_absence: mutable bool = false
        catch validate_value(Value{present: false, bytes: bytes_view(bytes)}):
            ok _:
                assert false
            error failure:
                invalid_absence <- failure == LookupError.InvalidAbsentValue
        assert invalid_absence
