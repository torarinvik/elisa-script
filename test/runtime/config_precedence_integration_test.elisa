include "../../src/runtime/encoding.elisa"
include "../../src/runtime/process_model.elisa"
include "../../src/runtime/environment_model.elisa"
include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../src/runtime/json_lexer_model.elisa"
include "../../src/runtime/json_parse_model.elisa"
include "../../src/runtime/config_model.elisa"
include "../../src/runtime/config_environment_model.elisa"
include "../../src/runtime/config_json_model.elisa"
include "../../src/runtime/config_toml_model.elisa"
include "../../src/runtime/config_cli_model.elisa"

using EsData
using EsJson
using EsJsonLex
using EsJsonParse
using EsEnvironment
using EsConfig
using EsConfigEnvironment
using EsConfigJson
using EsConfigToml
using EsConfigCli


@test
def config_precedence_composes_all_four_explicit_sources() -> void:
    can Memory.Allocate, Abort.Panic:
        defaults: ConfigLayer = ConfigLayer{source: ConfigSource.Defaults, entries: [
            ConfigEntry{key: "mode", value: "default-mode"},
            ConfigEntry{key: "empty", value: "default-value"},
            ConfigEntry{key: "stable", value: "default-stable"}
        ]}

        file_document: JsonDocument = parse_json_document(lex_json("{\"mode\":\"file-mode\",\"empty\":\"file-value\"}"))
        file_layer: ConfigLayer = flat_json_config_layer(file_document)

        environment: mutable EnvironmentSnapshot = EnvironmentSnapshot{}
        assert advance_environment_snapshot(environment, EnvironmentEvent.Begin) == EnvironmentState.Building
        assert advance_environment_snapshot(environment, EnvironmentEvent.Set, "mode", "environment-mode") == EnvironmentState.Building
        assert advance_environment_snapshot(environment, EnvironmentEvent.Set, "empty", "") == EnvironmentState.Building
        assert advance_environment_snapshot(environment, EnvironmentEvent.Seal) == EnvironmentState.Sealed
        environment_layer: ConfigLayer = environment_config_layer(environment)

        cli_options: darray[ConfigCliOption] = [
            ConfigCliOption{key: "mode", option: "--mode", takes_value: true},
            ConfigCliOption{key: "empty", option: "--empty", takes_value: true}
        ]
        command_line: ConfigCliResult = parse_config_cli(["--mode=cli-mode", "--empty="], cli_options)

        values: darray[ConfigValue] = resolve_config_layers([
            defaults,
            file_layer,
            environment_layer,
            command_line.layer
        ])
        mode: ConfigLookup = lookup_config_value(values, "mode")
        empty: ConfigLookup = lookup_config_value(values, "empty")
        stable: ConfigLookup = lookup_config_value(values, "stable")
        absent: ConfigLookup = lookup_config_value(values, "absent")
        assert mode.present and mode.value == "cli-mode" and mode.source == ConfigSource.CommandLine
        assert empty.present and empty.value == "" and empty.source == ConfigSource.CommandLine
        assert stable.present and stable.value == "default-stable" and stable.source == ConfigSource.Defaults
        assert not absent.present


@test
def config_precedence_accepts_toml_table_file_values() -> void:
    can Memory.Allocate, Abort.Panic:
        defaults: ConfigLayer = ConfigLayer{source: ConfigSource.Defaults, entries: [
            ConfigEntry{key: "build.mode", value: "debug"},
            ConfigEntry{key: "build.jobs", value: "2"}
        ]}
        toml_file: ConfigTomlLayer = parse_toml_config("[build]\nmode = \"release\"\njobs = 12\n")
        resolved: darray[ConfigValue] = resolve_config_layers([
            defaults,
            toml_file.layer,
            ConfigLayer{source: ConfigSource.Environment, entries: [
                ConfigEntry{key: "build.jobs", value: "8"}
            ]},
            ConfigLayer{source: ConfigSource.CommandLine}
        ])
        mode: ConfigLookup = lookup_config_value(resolved, "build.mode")
        jobs: ConfigLookup = lookup_config_value(resolved, "build.jobs")
        assert mode.present and mode.value == "release" and mode.source == ConfigSource.File
        assert jobs.present and jobs.value == "8" and jobs.source == ConfigSource.Environment
