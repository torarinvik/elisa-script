include "../../src/ir/ir.elisa"

using EsBuildIncremental
using EsBuildRecipeSignature
using EsProcess


@test
def build_recipe_signature_binds_command_target_and_toolchain() -> void:
    can Memory.Allocate, Abort.Panic:
        recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "generate", kind: BuildIncrementalTargetKind.Phony, recipe_fingerprint: 0},
            BuildIncrementalRecipeTarget{
                name: "compile",
                kind: BuildIncrementalTargetKind.GeneratedFile,
                recipe_fingerprint: 0,
                inputs: ["src/main.c", "include/base.h"],
                outputs: ["build/main.o"],
                dependencies: ["generate"]
            }
        ]
        command: ProcessCommand = ProcessCommand{
            executable: "cc",
            arguments: ["-O2", "-c", "src/main.c"],
            working_directory: "build",
            environment: ["LC_ALL", "C"],
            environment_mode: ProcessEnvironmentMode.Replace,
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Null,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000,
            capture_output_limit_bytes: 4096,
            failure_mode: ProcessFailureMode.Check
        }
        toolchain: BuildRecipeToolchainIdentity = BuildRecipeToolchainIdentity{word0: 1, word1: 2, word2: 3, word3: 4}
        original: BuildRecipeSignature = build_recipe_signature(recipes, 1, command, toolchain)

        changed_command: ProcessCommand = ProcessCommand{
            executable: "cc",
            arguments: ["-O3", "-c", "src/main.c"],
            working_directory: "build",
            environment: ["LC_ALL", "C"],
            environment_mode: ProcessEnvironmentMode.Replace,
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Null,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000,
            capture_output_limit_bytes: 4096,
            failure_mode: ProcessFailureMode.Check
        }
        command_changed: BuildRecipeSignature = build_recipe_signature(recipes, 1, changed_command, toolchain)
        assert original.word0 != command_changed.word0 or original.word1 != command_changed.word1 or original.word2 != command_changed.word2 or original.word3 != command_changed.word3

        changed_recipes: darray[BuildIncrementalRecipeTarget] = [
            recipes[0],
            BuildIncrementalRecipeTarget{
                name: "compile",
                kind: BuildIncrementalTargetKind.GeneratedFile,
                recipe_fingerprint: 0,
                inputs: ["src/main.c", "include/base.h"],
                outputs: ["build/main-fast.o"],
                dependencies: ["generate"]
            }
        }
        recipe_changed: BuildRecipeSignature = build_recipe_signature(changed_recipes, 1, command, toolchain)
        assert original.word0 != recipe_changed.word0 or original.word1 != recipe_changed.word1 or original.word2 != recipe_changed.word2 or original.word3 != recipe_changed.word3

        changed_toolchain: BuildRecipeToolchainIdentity = BuildRecipeToolchainIdentity{word0: 1, word1: 2, word2: 3, word3: 5}
        toolchain_changed: BuildRecipeSignature = build_recipe_signature(recipes, 1, command, changed_toolchain)
        assert original.word0 != toolchain_changed.word0 or original.word1 != toolchain_changed.word1 or original.word2 != toolchain_changed.word2 or original.word3 != toolchain_changed.word3
