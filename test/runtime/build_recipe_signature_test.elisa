include "../../src/ir/ir.elisa"

using EsBuild
using EsBuildIncremental
using EsBuildRecipeSignature
using EsProcess


@test
def build_recipe_signature_binds_command_target_and_toolchain() -> void:
    can Memory.Allocate, Abort.Panic:
        recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "generate", kind: BuildIncrementalTargetKind.Phony, recipe_fingerprint: 0},
            BuildIncrementalRecipeTarget{
                name: "compile",
                kind: BuildIncrementalTargetKind.GeneratedFile,
                recipe_fingerprint: 0,
                inputs: ["src/main.c", "include/base.h"],
                outputs: ["build/main.o"],
                dependencies: ["generate"]
            }
        ]
        command: ProcessCommand = ProcessCommand{
            executable: "/toolchain/bin/cc",
            arguments: ["-O2", "-c", "src/main.c"],
            working_directory: "/workspace/build",
            environment: ["LC_ALL", "C"],
            environment_mode: ProcessEnvironmentMode.Replace,
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000,
            capture_output_limit_bytes: 4096,
            failure_mode: ProcessFailureMode.Check
        }
        toolchain: BuildRecipeToolchainIdentity = BuildRecipeToolchainIdentity{word0: 1, word1: 2, word2: 3, word3: 4}
        original: BuildRecipeSignature = build_recipe_signature(recipes, 1, command, toolchain)
        signed_recipe: BuildIncrementalRecipeTarget = sign_build_incremental_recipe(recipes, 1, command, toolchain)
        assert signed_recipe.recipe_signature.word0 == original.word0 and signed_recipe.recipe_signature.word1 == original.word1 and signed_recipe.recipe_signature.word2 == original.word2 and signed_recipe.recipe_signature.word3 == original.word3
        assert signed_recipe.recipe_fingerprint == build_recipe_scheduler_fingerprint(original)

        # Length prefixes must preserve argument boundaries: these vectors
        # flatten to the same text but are not the same process invocation.
        split_arguments: mutable ProcessCommand = command
        split_arguments.arguments <- ["ab", "c"]
        joined_argument: mutable ProcessCommand = command
        joined_argument.arguments <- ["a", "bc"]
        split_signature: BuildRecipeSignature = build_recipe_signature(recipes, 1, split_arguments, toolchain)
        joined_signature: BuildRecipeSignature = build_recipe_signature(recipes, 1, joined_argument, toolchain)
        assert split_signature.word0 != joined_signature.word0 or split_signature.word1 != joined_signature.word1 or split_signature.word2 != joined_signature.word2 or split_signature.word3 != joined_signature.word3

        changed_command: ProcessCommand = ProcessCommand{
            executable: "/toolchain/bin/cc",
            arguments: ["-O3", "-c", "src/main.c"],
            working_directory: "/workspace/build",
            environment: ["LC_ALL", "C"],
            environment_mode: ProcessEnvironmentMode.Replace,
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000,
            capture_output_limit_bytes: 4096,
            failure_mode: ProcessFailureMode.Check
        }
        command_changed: BuildRecipeSignature = build_recipe_signature(recipes, 1, changed_command, toolchain)
        assert original.word0 != command_changed.word0 or original.word1 != command_changed.word1 or original.word2 != command_changed.word2 or original.word3 != command_changed.word3

        changed_recipes: darray[BuildIncrementalRecipeTarget] = [
            recipes[0],
            BuildIncrementalRecipeTarget{
                name: "compile",
                kind: BuildIncrementalTargetKind.GeneratedFile,
                recipe_fingerprint: 0,
                inputs: ["src/main.c", "include/base.h"],
                outputs: ["build/main-fast.o"],
                dependencies: ["generate"]
            }
        }
        recipe_changed: BuildRecipeSignature = build_recipe_signature(changed_recipes, 1, command, toolchain)
        assert original.word0 != recipe_changed.word0 or original.word1 != recipe_changed.word1 or original.word2 != recipe_changed.word2 or original.word3 != recipe_changed.word3

        changed_toolchain: BuildRecipeToolchainIdentity = BuildRecipeToolchainIdentity{word0: 1, word1: 2, word2: 3, word3: 5}
        toolchain_changed: BuildRecipeSignature = build_recipe_signature(recipes, 1, command, changed_toolchain)
        assert original.word0 != toolchain_changed.word0 or original.word1 != toolchain_changed.word1 or original.word2 != toolchain_changed.word2 or original.word3 != toolchain_changed.word3

        inherited_environment: mutable ProcessCommand = command
        inherited_environment.environment_mode <- ProcessEnvironmentMode.Inherit
        rejected_inherited_environment: mutable bool = false
        catch build_recipe_signature(recipes, 1, inherited_environment, toolchain):
            ok signature:
                _ = signature
            error failure:
                rejected_inherited_environment <- failure == BuildRecipeSignatureError.InheritedEnvironmentUncacheable
        assert rejected_inherited_environment

        cleared_environment: mutable ProcessCommand = command
        cleared_environment.environment_mode <- ProcessEnvironmentMode.Clear
        cleared_environment.environment <- []
        clear_environment_signature: BuildRecipeSignature = build_recipe_signature(recipes, 1, cleared_environment, toolchain)
        assert clear_environment_signature.word0 != original.word0 or clear_environment_signature.word1 != original.word1 or clear_environment_signature.word2 != original.word2 or clear_environment_signature.word3 != original.word3

        relative_executable: mutable ProcessCommand = command
        relative_executable.executable <- "cc"
        relative_executable_rejected: mutable bool = false
        catch build_recipe_signature(recipes, 1, relative_executable, toolchain):
            ok signature:
                _ = signature
            error failure:
                relative_executable_rejected <- failure == BuildRecipeSignatureError.AmbientExecutableUncacheable
        assert relative_executable_rejected

        relative_working_directory: mutable ProcessCommand = command
        relative_working_directory.working_directory <- "build"
        relative_working_directory_rejected: mutable bool = false
        catch build_recipe_signature(recipes, 1, relative_working_directory, toolchain):
            ok signature:
                _ = signature
            error failure:
                relative_working_directory_rejected <- failure == BuildRecipeSignatureError.WorkingDirectoryUncacheable
        assert relative_working_directory_rejected

        empty_working_directory: mutable ProcessCommand = command
        empty_working_directory.working_directory <- ""
        empty_working_directory_rejected: mutable bool = false
        catch build_recipe_signature(recipes, 1, empty_working_directory, toolchain):
            ok signature:
                _ = signature
            error failure:
                empty_working_directory_rejected <- failure == BuildRecipeSignatureError.WorkingDirectoryUncacheable
        assert empty_working_directory_rejected

        inherited_stdin: mutable ProcessCommand = command
        inherited_stdin.stdin_mode <- ProcessStdioMode.Inherit
        inherited_stdin_rejected: mutable bool = false
        catch build_recipe_signature(recipes, 1, inherited_stdin, toolchain):
            ok signature:
                _ = signature
            error failure:
                inherited_stdin_rejected <- failure == BuildRecipeSignatureError.StdioPolicyUncacheable
        assert inherited_stdin_rejected

        unbounded_execution: mutable ProcessCommand = command
        unbounded_execution.timeout_micros <- 0
        unbounded_execution_rejected: mutable bool = false
        catch build_recipe_signature(recipes, 1, unbounded_execution, toolchain):
            ok signature:
                _ = signature
            error failure:
                unbounded_execution_rejected <- failure == BuildRecipeSignatureError.UnboundedExecutionUncacheable
        assert unbounded_execution_rejected

        permissive_failure: mutable ProcessCommand = command
        permissive_failure.failure_mode <- ProcessFailureMode.Allow
        permissive_failure_rejected: mutable bool = false
        catch build_recipe_signature(recipes, 1, permissive_failure, toolchain):
            ok signature:
                _ = signature
            error failure:
                permissive_failure_rejected <- failure == BuildRecipeSignatureError.FailurePolicyUncacheable
        assert permissive_failure_rejected

        uncaptured_output: mutable ProcessCommand = command
        uncaptured_output.stderr_mode <- ProcessStdioMode.Null
        uncaptured_output_rejected: mutable bool = false
        catch build_recipe_signature(recipes, 1, uncaptured_output, toolchain):
            ok signature:
                _ = signature
            error failure:
                uncaptured_output_rejected <- failure == BuildRecipeSignatureError.StdioPolicyUncacheable
        assert uncaptured_output_rejected

        file_redirect: mutable ProcessCommand = command
        file_redirect.stderr_mode <- ProcessStdioMode.File
        file_redirect.stderr_path <- "/tmp/build.stderr"
        file_redirect_rejected: mutable bool = false
        catch build_recipe_signature(recipes, 1, file_redirect, toolchain):
            ok signature:
                _ = signature
            error failure:
                file_redirect_rejected <- failure == BuildRecipeSignatureError.StdioPolicyUncacheable
        assert file_redirect_rejected


@test
def build_recipe_signature_rejects_oversized_recipe_vector_before_normalization() -> void:
    can Memory.Allocate, Abort.Panic:
        recipes: mutable darray[BuildIncrementalRecipeTarget] = []
        recipe: BuildIncrementalRecipeTarget = BuildIncrementalRecipeTarget{
            name: "target",
            kind: BuildIncrementalTargetKind.Phony,
            recipe_fingerprint: 0
        }
        recipe_count: usize = EsBuildIncremental::Limits::TARGETS + 1
        for index in 0..<recipe_count |recipes|:
            _ = index
            recipes.push(recipe)

        command: ProcessCommand = ProcessCommand{executable: "tool"}
        toolchain: BuildRecipeToolchainIdentity = BuildRecipeToolchainIdentity{word0: 1}
        rejected: mutable bool = false
        catch build_recipe_signature(recipes, 0, command, toolchain):
            ok signature:
                _ = signature
            error failure:
                rejected <- failure == BuildRecipeSignatureError.InvalidRecipe
        assert rejected

        inputs: mutable darray[sview] = []
        input_count: usize = EsBuildIncremental::Limits::INPUTS + 1
        for index in 0..<input_count |inputs|:
            _ = index
            inputs.push("src/input.c")
        oversized_path_recipe: BuildIncrementalRecipeTarget = BuildIncrementalRecipeTarget{
            name: "target",
            kind: BuildIncrementalTargetKind.Phony,
            recipe_fingerprint: 0,
            inputs: inputs
        }
        nested_recipes: darray[BuildIncrementalRecipeTarget] = [oversized_path_recipe]
        nested_rejected: mutable bool = false
        catch build_recipe_signature(nested_recipes, 0, command, toolchain):
            ok signature:
                _ = signature
            error failure:
                nested_rejected <- failure == BuildRecipeSignatureError.InvalidRecipe
        assert nested_rejected
