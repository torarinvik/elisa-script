# Source-only parent-storage fixtures. No snapshot adapter or launch runs here.
include "../../src/runtime/process_launch_storage.elisa"
include "../../src/runtime/environment_snapshot_model.elisa"

module EsLaunchStorageFixture:
    public:
        def ambient() -> EsEnvironment::EnvironmentSnapshot error[EsEnvironmentSnapshot::SnapshotError, EsEnvironment::EnvironmentContractError] can[Memory.Allocate, Abort.Panic]:
            entries: darray[darray[u8]] = [[67u8,67u8,61u8,0u8], [80u8,65u8,84u8,72u8,61u8,47u8,98u8,105u8,110u8,0u8]]
            return try EsEnvironmentSnapshot::from_entries(entries)


@test
def launch_storage_combines_argv_environment_and_search_receipts() -> void:
    can Memory.Allocate, Abort.Panic:
        ambient: EsEnvironment::EnvironmentSnapshot = try EsLaunchStorageFixture::ambient() else err:
            assert false
            return
        overlay: darray[EsEnvironment::EnvironmentEntry] = [EsEnvironment::EnvironmentEntry{name: "CC", value: "clang"}]
        planned: EsProcessLaunchStorage::Prepared = try EsProcessLaunchStorage::prepare(ambient, overlay, "tool", ["", "a b"], EsProcessEnvironmentPlan::AbsentPath{}, 39) else err:
            assert false
            return
        assert planned.argument_bytes == 10
        assert planned.environment.environment_bytes == 19
        assert planned.environment.search_bytes == 10 and planned.storage_bytes == 39
        assert planned.arguments.count == 3 and planned.arguments[0].count == 5
        assert planned.arguments[0][0] == 116u8 and planned.arguments[0][4] == 0u8
        assert planned.arguments[1].count == 1 and planned.arguments[1][0] == 0u8
        assert planned.arguments[2].count == 4 and planned.arguments[2][1] == 32u8
        assert ambient.entries[0].value == "" and ambient.text_bytes == 14


@test
def launch_storage_rejects_one_byte_under_the_combined_budget() -> void:
    can Memory.Allocate, Abort.Panic:
        ambient: EsEnvironment::EnvironmentSnapshot = try EsLaunchStorageFixture::ambient() else err:
            assert false
            return
        overlay: darray[EsEnvironment::EnvironmentEntry] = [EsEnvironment::EnvironmentEntry{name: "CC", value: "clang"}]
        rejected: mutable bool = false
        catch EsProcessLaunchStorage::prepare(ambient, overlay, "tool", ["", "a b"], EsProcessEnvironmentPlan::AbsentPath{}, 38):
            ok _:
                assert false
            error failure:
                rejected <- failure == EsProcessEnvironmentPlan::PlanError.StorageLimit
        assert rejected and ambient.entries[0].value == "" and ambient.text_bytes == 14


@test
def launch_storage_admits_literal_metacharacters_without_word_splitting() -> void:
    can Memory.Allocate, Abort.Panic:
        ambient: EsEnvironment::EnvironmentSnapshot = try EsLaunchStorageFixture::ambient() else err:
            assert false
            return
        planned: mutable EsProcessLaunchStorage::Prepared = try EsProcessLaunchStorage::prepare(ambient, [], "tools/name with spaces", ["$HOME * ;", "--", ""]) else err:
            assert false
            return
        assert planned.arguments.count == 4 and planned.environment.executable_candidates.count == 1
        assert planned.arguments[1].count == 10 and planned.arguments[1][0] == 36u8
        assert planned.arguments[1][6] == 42u8 and planned.arguments[1][8] == 59u8
        assert planned.arguments[2].count == 3 and planned.arguments[3].count == 1
        # Separate argv[0] and candidate buffers do not alias each other.
        planned.arguments[0][0] <- 88u8
        assert planned.environment.executable_candidates[0][0] == 116u8


@test
def launch_storage_rejects_nul_arguments_and_invalid_or_empty_budgets() -> void:
    can Memory.Allocate, Abort.Panic:
        ambient: EsEnvironment::EnvironmentSnapshot = try EsLaunchStorageFixture::ambient() else err:
            assert false
            return
        rejected_nul: mutable bool = false
        catch EsProcessLaunchStorage::prepare(ambient, [], "tool", ["a\0b"]):
            ok _:
                assert false
            error failure:
                rejected_nul <- failure == EsProcessLaunchStorage::StorageError.InvalidArgument
        assert rejected_nul
        for budget in [0usize, 67108865usize]:
            rejected: mutable bool = false
            catch EsProcessLaunchStorage::prepare(ambient, [], "tool", [], EsProcessEnvironmentPlan::AbsentPath{}, budget):
                ok _:
                    assert false
                error failure:
                    rejected <- failure == (EsProcessLaunchStorage::StorageError.StorageLimit if budget == 0 else EsProcessLaunchStorage::StorageError.InvalidBudget)
            assert rejected
