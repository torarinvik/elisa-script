include "../../src/runtime/macos_app_path_plan_posix.elisa"

using EsMacosAppPathPlanPosix


def macos_app_path_resolves_to(input_path: Path, expected: Path) -> bool can[Blocking.IO, File.Read, Directory.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    matches: mutable bool = false
    catch resolve_macos_app_path_for_overlap(input_path):
        ok resolved:
            matches <- resolved == expected
        error _:
            matches <- false
    return matches


@test
def resolves_existing_symlink_prefixes_and_missing_output_tails() -> void can[Blocking.IO, File.Read, File.Write, Directory.Read, Directory.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    temporary: Path = try temp_directory("macos-app-path-resolution") else err:
        assert false
        return
    project: Path = temporary.joinpath("project")
    real_root: Path = temporary.joinpath("real")
    real_child: Path = real_root.joinpath("child")
    alias: Path = project.joinpath("alias")
    dangling: Path = project.joinpath("dangling")
    dangling_target: Path = temporary.joinpath("not-yet-created")

    made_project: bool = try create_directories(project) else false
    made_target: bool = try create_directories(real_child) else false
    made_alias: bool = made_target and (try symlink(real_child, alias) else false)
    made_dangling: bool = try symlink(dangling_target, dangling) else false

    alias_output: Path = alias.joinpath("Game.app")
    dotdot_output: Path = alias.joinpath("..").joinpath("Game.app")
    alias_resolved: bool = macos_app_path_resolves_to(alias_output, real_child.joinpath("Game.app"))
    dotdot_resolved: bool = macos_app_path_resolves_to(dotdot_output, real_root.joinpath("Game.app"))
    dangling_resolved: bool = macos_app_path_resolves_to(dangling, dangling_target)

    removed_dangling: bool = try remove_path(dangling) else false
    removed_alias: bool = try remove_path(alias) else false
    removed_child: bool = try remove_directory(real_child) else false
    removed_real_root: bool = try remove_directory(real_root) else false
    removed_project: bool = try remove_directory(project) else false
    removed_temporary: bool = try remove_directory(temporary) else false

    assert made_project and made_target and made_alias and made_dangling
    assert alias_resolved and dotdot_resolved and dangling_resolved
    assert removed_dangling and removed_alias and removed_child
    assert removed_real_root and removed_project and removed_temporary
