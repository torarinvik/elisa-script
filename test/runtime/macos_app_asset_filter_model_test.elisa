include "../../src/runtime/macos_app_asset_filter_model.elisa"

using EsMacosAppAssetFilter


@test
def matches_packager_asset_ignore_policies() -> void:
    assert macos_app_asset_name_is_ignored(".git", MacosAppAssetFilterPolicy.ProjectResources)
    assert macos_app_asset_name_is_ignored(".gitattributes", MacosAppAssetFilterPolicy.ProjectResources)
    assert macos_app_asset_name_is_ignored(".gitignore", MacosAppAssetFilterPolicy.ProjectResources)
    assert macos_app_asset_name_is_ignored(".DS_Store", MacosAppAssetFilterPolicy.ProjectResources)
    assert macos_app_asset_name_is_ignored("__pycache__", MacosAppAssetFilterPolicy.ProjectResources)
    assert macos_app_asset_name_is_ignored("Thumbs.db", MacosAppAssetFilterPolicy.ProjectResources)
    assert not macos_app_asset_name_is_ignored("texture.png", MacosAppAssetFilterPolicy.ProjectResources)
    assert not macos_app_asset_name_is_ignored("compiled.wishadermeta", MacosAppAssetFilterPolicy.ProjectResources)

    assert macos_app_asset_name_is_ignored("compiled.wishadermeta", MacosAppAssetFilterPolicy.ShaderResources)
    assert macos_app_asset_name_is_ignored("elisa.metal-generated.json", MacosAppAssetFilterPolicy.ShaderResources)
    assert not macos_app_asset_name_is_ignored("elisa.shader-manifest.json", MacosAppAssetFilterPolicy.ShaderResources)
    assert not macos_app_asset_name_is_ignored("compiled.WISHADERMETA", MacosAppAssetFilterPolicy.ShaderResources)
