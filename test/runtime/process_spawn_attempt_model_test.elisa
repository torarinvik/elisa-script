# Pure API-return admission. No posix_spawn or native attributes are touched.
include "../../src/runtime/process_spawn_attempt_model.elisa"

using EsProcessSpawnAttempt


@test
def darwin_spawn_attempt_adopts_only_zero_return_with_admissible_group_pid() -> void:
    success: Attempt = classify(0, 41)
    assert success.kind == Kind.Spawned and success.pid == 41 and success.code == 0
    assert decide(success) == Decision.AdoptChild
    assert decide(classify(0, 0)) == Decision.StopUncertain
    assert decide(classify(0, 1)) == Decision.StopUncertain
    assert decide(classify(0, -1)) == Decision.StopUncertain
    assert decide(classify(-1, 41)) == Decision.StopUncertain


@test
def darwin_spawn_attempt_ignores_unspecified_pid_output_after_failure() -> void:
    can Memory.Allocate, Abort.Panic:
        for reported in [0i32, 41i32, -1i32]:
            failed: Attempt = classify(2, reported)
            assert failed.kind == Kind.NoChild and failed.pid == 0 and failed.code == 2
            assert decide(failed) == Decision.NextCandidate


@test
def darwin_spawn_attempt_search_uses_return_code_not_errno_or_exit_status() -> void:
    assert decide(classify(2, 0)) == Decision.NextCandidate
    assert decide(classify(20, 0)) == Decision.NextCandidate
    assert decide(classify(13, 0)) == Decision.NextDenied
    assert decide(classify(8, 0)) == Decision.StopNoChild
    assert decide(classify(12, 0)) == Decision.StopNoChild
    # These numbers here are API errors, not child exit statuses. A launched
    # program returning 125/126/127 later remains an ordinary wait outcome.
    assert decide(classify(125, 0)) == Decision.StopNoChild
    assert decide(classify(126, 0)) == Decision.StopNoChild
    assert decide(classify(127, 0)) == Decision.StopNoChild


@test
def darwin_spawn_attempt_rejects_inconsistent_public_receipts() -> void:
    assert decide(Attempt{kind: Kind.Spawned, pid: 0, code: 0}) == Decision.StopUncertain
    assert decide(Attempt{kind: Kind.Spawned, pid: 1, code: 0}) == Decision.StopUncertain
    assert decide(Attempt{kind: Kind.Spawned, pid: 41, code: 2}) == Decision.StopUncertain
    assert decide(Attempt{kind: Kind.NoChild, pid: 41, code: 2}) == Decision.StopUncertain
    assert decide(Attempt{kind: Kind.NoChild, pid: 0, code: 0}) == Decision.StopUncertain
    assert decide(Attempt{kind: Kind.Unknown, pid: 41, code: 0}) == Decision.StopUncertain
