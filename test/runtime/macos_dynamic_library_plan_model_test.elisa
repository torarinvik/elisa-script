include "../../src/runtime/macos_dynamic_library_plan_model.elisa"

using EsMacosDynamicLibraryPlan


@test
def plans_transitive_library_staging_and_install_name_edits_in_reference_order() -> void can[Memory.Allocate, Abort.Panic]:
    main_path: sview = "/Bundle/Contents/Resources/Game.bin"
    frameworks_path: sview = "/Bundle/Contents/Frameworks"
    images: darray[NativeImageObservation] = [
        NativeImageObservation{path: main_path, is_regular_file: true, install_names: ["/opt/lib/libA.dylib", "/System/Library/libSystem.dylib", "@rpath/libExisting.dylib", "/other/libA.dylib"]},
        NativeImageObservation{path: "/opt/lib/libA.dylib", is_regular_file: true, install_names: ["/opt/lib/libB.dylib"]},
        NativeImageObservation{path: "/opt/lib/libB.dylib", is_regular_file: true}
    ]
    plan: mutable Plan = Plan{}
    catch plan_bundle(main_path, frameworks_path, images):
        ok value:
            plan <- value
        error failure:
            _ = failure
            assert false

    assert plan.library_names.count == 2
    assert bytes_view(plan.library_names[0]) == "libA.dylib"
    assert bytes_view(plan.library_names[1]) == "libB.dylib"
    assert plan.actions.count == 18
    assert plan.actions[0].kind == ActionKind.MakeWritable
    assert bytes_view(plan.actions[0].target_path) == main_path
    assert plan.actions[1].kind == ActionKind.CreateFrameworksDirectory
    assert plan.actions[2].kind == ActionKind.CopyFileAndMetadata
    assert bytes_view(plan.actions[2].source_path) == "/opt/lib/libA.dylib"
    assert bytes_view(plan.actions[3].target_path) == "/Bundle/Contents/Frameworks/libA.dylib"
    assert plan.actions[4].kind == ActionKind.SetInstallIdentity
    assert bytes_view(plan.actions[4].new_value) == "@rpath/libA.dylib"
    assert plan.actions[5].kind == ActionKind.ChangeInstallIdentity
    assert bytes_view(plan.actions[5].target_path) == main_path
    assert bytes_view(plan.actions[5].old_value) == "/opt/lib/libA.dylib"
    assert plan.actions[6].kind == ActionKind.ChangeInstallIdentity
    assert bytes_view(plan.actions[6].old_value) == "/other/libA.dylib"
    assert plan.actions[7].kind == ActionKind.CreateFrameworksDirectory
    assert bytes_view(plan.actions[8].source_path) == "/opt/lib/libB.dylib"
    assert plan.actions[11].kind == ActionKind.ChangeInstallIdentity
    assert bytes_view(plan.actions[11].target_path) == "/Bundle/Contents/Frameworks/libA.dylib"
    assert plan.actions[12].kind == ActionKind.AddRuntimePath
    assert bytes_view(plan.actions[12].new_value) == "@loader_path/../Frameworks"
    assert plan.actions[13].kind == ActionKind.AdHocSign
    assert bytes_view(plan.actions[14].new_value) == "@loader_path"
    assert plan.actions[15].kind == ActionKind.AdHocSign
    assert bytes_view(plan.actions[16].new_value) == "@loader_path"
    assert plan.actions[17].kind == ActionKind.AdHocSign


@test
def signs_a_binary_without_adding_an_rpath_when_no_library_is_staged() -> void can[Memory.Allocate, Abort.Panic]:
    main_path: sview = "/Bundle/Game.bin"
    images: darray[NativeImageObservation] = [NativeImageObservation{path: main_path, is_regular_file: true, install_names: ["/usr/lib/libSystem.B.dylib", "@rpath/libAlreadyBundled.dylib"]}]
    plan: mutable Plan = Plan{}
    catch plan_bundle(main_path, "/Bundle/Frameworks", images):
        ok value:
            plan <- value
        error failure:
            _ = failure
            assert false
    assert plan.library_names.count == 0
    assert plan.actions.count == 2
    assert plan.actions[0].kind == ActionKind.MakeWritable
    assert plan.actions[1].kind == ActionKind.AdHocSign


@test
def fails_closed_when_a_non_system_link_name_has_no_regular_file_observation() -> void can[Memory.Allocate, Abort.Panic]:
    main_path: sview = "/Bundle/Game.bin"
    images: darray[NativeImageObservation] = [NativeImageObservation{path: main_path, is_regular_file: true, install_names: ["/opt/missing/libMissing.dylib"]}]
    rejected: mutable bool = false
    catch plan_bundle(main_path, "/Bundle/Frameworks", images):
        ok plan:
            _ = plan
        error failure:
            rejected <- failure == PlanningError.LinkedLibraryMissing
    assert rejected


@test
def processes_staged_libraries_in_lifo_worklist_order() -> void can[Memory.Allocate, Abort.Panic]:
    main_path: sview = "/Bundle/Game.bin"
    frameworks_path: sview = "/Bundle/Frameworks"
    images: darray[NativeImageObservation] = [
        NativeImageObservation{path: main_path, is_regular_file: true, install_names: ["/opt/lib/libFirst.dylib", "/opt/lib/libSecond.dylib"]},
        NativeImageObservation{path: "/opt/lib/libFirst.dylib", is_regular_file: true, install_names: ["/opt/lib/libFromFirst.dylib"]},
        NativeImageObservation{path: "/opt/lib/libSecond.dylib", is_regular_file: true, install_names: ["/opt/lib/libFromSecond.dylib"]},
        NativeImageObservation{path: "/opt/lib/libFromFirst.dylib", is_regular_file: true},
        NativeImageObservation{path: "/opt/lib/libFromSecond.dylib", is_regular_file: true}
    ]
    plan: mutable Plan = Plan{}
    catch plan_bundle(main_path, frameworks_path, images):
        ok value:
            plan <- value
        error failure:
            _ = failure
            assert false

    assert bytes_view(plan.actions[2].source_path) == "/opt/lib/libFirst.dylib"
    assert bytes_view(plan.actions[7].source_path) == "/opt/lib/libSecond.dylib"
    assert bytes_view(plan.actions[12].source_path) == "/opt/lib/libFromSecond.dylib"
    assert bytes_view(plan.actions[17].source_path) == "/opt/lib/libFromFirst.dylib"
