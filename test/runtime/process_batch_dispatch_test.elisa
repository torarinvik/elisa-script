include "../../src/ir/ir.elisa"

using EsProcessBatch


@test
def process_batch_admission_returns_exact_retry_token() -> void:
    can Memory.Allocate, Abort.Panic:
        session: mutable ProcessBatchSession = ProcessBatchSession{
            policy: ProcessBatchPolicy{max_jobs: 2, max_parallel: 1, max_attempts: 2, failure_mode: ProcessBatchFailureMode.Aggregate},
            jobs: [ProcessBatchJob{id: 11}, ProcessBatchJob{id: 22}]
        }
        assert advance_process_batch(session, ProcessBatchEvent.Begin) == ProcessBatchState.Running
        first: ProcessBatchDispatch = admit_next_process_batch_job(session)
        assert first.job_index == 0 and first.job_id == 11 and first.attempt_token == 1
        assert validate_process_batch_dispatch(session, first)
        forged: ProcessBatchDispatch = ProcessBatchDispatch{job_index: first.job_index, job_id: 22, attempt_token: first.attempt_token}
        forged_rejected: mutable bool = false
        catch validate_process_batch_dispatch(session, forged):
            ok value:
                assert false
            error failure:
                forged_rejected <- failure == ProcessBatchError.DispatchMismatch
        assert forged_rejected
        assert advance_process_batch(session, ProcessBatchEvent.Complete, first.job_index, first.attempt_token) == ProcessBatchState.Running

        second: ProcessBatchDispatch = admit_next_process_batch_job(session)
        assert second.job_index == 1 and second.job_id == 22 and second.attempt_token == 1
        assert advance_process_batch(session, ProcessBatchEvent.Fail, second.job_index, second.attempt_token) == ProcessBatchState.Running
        assert advance_process_batch(session, ProcessBatchEvent.ReapAck, second.job_index, second.attempt_token) == ProcessBatchState.Running
        assert advance_process_batch(session, ProcessBatchEvent.Retry, second.job_index) == ProcessBatchState.Running

        retried: ProcessBatchDispatch = admit_next_process_batch_job(session)
        assert retried.job_index == second.job_index and retried.job_id == second.job_id
        assert retried.attempt_token == 2
        assert validate_process_batch_dispatch(session, retried)
        assert advance_process_batch(session, ProcessBatchEvent.Complete, retried.job_index, retried.attempt_token) == ProcessBatchState.Succeeded
        assert validate_process_batch(session)


@test
def process_batch_admits_a_scheduler_selected_job() -> void:
    can Memory.Allocate, Abort.Panic:
        session: mutable ProcessBatchSession = ProcessBatchSession{
            policy: ProcessBatchPolicy{max_jobs: 2, max_parallel: 2, max_attempts: 1, failure_mode: ProcessBatchFailureMode.Aggregate},
            jobs: [ProcessBatchJob{id: 101}, ProcessBatchJob{id: 202}]
        }
        assert advance_process_batch(session, ProcessBatchEvent.Begin) == ProcessBatchState.Running
        selected: ProcessBatchDispatch = admit_process_batch_job(session, 1)
        assert selected.job_index == 1 and selected.job_id == 202 and selected.attempt_token == 1
        assert validate_process_batch_dispatch(session, selected)
        other: ProcessBatchDispatch = admit_process_batch_job(session, 0)
        assert other.job_index == 0 and other.job_id == 101 and other.attempt_token == 1
        assert advance_process_batch(session, ProcessBatchEvent.Complete, other.job_index, other.attempt_token) == ProcessBatchState.Running
        assert advance_process_batch(session, ProcessBatchEvent.Complete, selected.job_index, selected.attempt_token) == ProcessBatchState.Succeeded
        assert validate_process_batch(session)
