include "../../ports/elisa-engine/scripts/elisa_package_archive_model.elisa"

using EsElisaPackageArchive


def package_archive_test_read_u16(data: darray[u8]&, offset: usize) -> u16:
    return data[offset].u16() | (data[offset + 1].u16() << 8)


def package_archive_test_read_u32(data: darray[u8]&, offset: usize) -> u32:
    return data[offset].u32() | (data[offset + 1].u32() << 8) | (data[offset + 2].u32() << 16) | (data[offset + 3].u32() << 24)


def package_archive_test_read_u64(data: darray[u8]&, offset: usize) -> u64:
    return data[offset].u64() | (data[offset + 1].u64() << 8) | (data[offset + 2].u64() << 16) | (data[offset + 3].u64() << 24) | (data[offset + 4].u64() << 32) | (data[offset + 5].u64() << 40) | (data[offset + 6].u64() << 48) | (data[offset + 7].u64() << 56)


def package_archive_rejects_compression_frame(frame: darray[u8], payload: darray[u8] = [1u8, 2u8]) -> bool can[Memory.Allocate, Abort.Panic]:
    sections: darray[SectionCandidate] = [SectionCandidate{name: "image", payload: payload, zstd_candidate: frame, zstd_level: 3}]
    rejected: mutable bool = false
    catch assemble_package_bytes(sections, []):
        ok package:
            _ = package
        error failure:
            rejected <- failure == ArchiveError.CompressionCandidateInvalid
    return rejected


@test
def assembles_sorted_aligned_elpk_with_compression_choice_crc_and_manifest() -> void can[Memory.Allocate, Abort.Panic]:
    sections: mutable darray[SectionCandidate] = []
    repeated_payload: mutable darray[u8] = []
    for _ in 0..<20 |repeated_payload|:
        repeated_payload.push(0u8)
    repeated_payload_crc: u32 = EsEnginePngImage::crc32(repeated_payload)
    sections.push(SectionCandidate{
        name: "z",
        payload: [16u8, 32u8],
        zstd_candidate: [0x28u8, 0xb5u8, 0x2fu8, 0xfdu8, 0x20u8, 2u8, 0x11u8, 0u8, 0u8, 16u8, 32u8],
        zstd_level: 3
    })
    sections.push(SectionCandidate{
        name: "a",
        payload: repeated_payload,
        zstd_candidate: [0x28u8, 0xb5u8, 0x2fu8, 0xfdu8, 0x20u8, 20u8, 0xa3u8, 0u8, 0u8, 0u8],
        zstd_level: 3
    })
    dependencies: darray[sview] = ["b", "a"]
    package: darray[u8] = try assemble_package_bytes(sections, dependencies)

    assert package.count == 258
    assert package[0] == 69u8 and package[1] == 76u8 and package[2] == 80u8 and package[3] == 75u8
    assert package_archive_test_read_u16(package, 4) == 1u16
    assert package_archive_test_read_u16(package, 6) == 3u16
    assert package_archive_test_read_u64(package, 8) == 32u64
    assert package_archive_test_read_u64(package, 16) == 144u64
    for index in 24..<32 |package|:
        assert package[index] == 0u8

    assert package[32] == 97u8
    assert package_archive_test_read_u64(package, 48) == 176u64
    assert package_archive_test_read_u64(package, 56) == 10u64
    assert package_archive_test_read_u64(package, 64) == 20u64
    assert package_archive_test_read_u32(package, 72) == 1u32
    assert package_archive_test_read_u32(package, 76) == repeated_payload_crc
    compressed_frame: darray[u8] = [0x28u8, 0xb5u8, 0x2fu8, 0xfdu8, 0x20u8, 20u8, 0xa3u8, 0u8, 0u8, 0u8]
    for index in 0..<compressed_frame.count |package, compressed_frame|:
        assert package[176 + index] == compressed_frame[index]
    for index in 178..<192 |package|:
        assert package[index] == 0u8

    assert package[80] == 109u8
    assert package_archive_test_read_u64(package, 96) == 192u64
    assert package_archive_test_read_u64(package, 104) == 51u64
    assert package_archive_test_read_u64(package, 112) == 51u64
    assert package_archive_test_read_u32(package, 120) == 0u32
    assert package[192] == 69u8 and package[193] == 76u8 and package[194] == 73u8
    assert package[217] == 100u8 and package[218] == 101u8 and package[219] == 112u8
    assert package[228] == 97u8 and package[229] == 10u8
    assert package[241] == 98u8 and package[242] == 10u8

    assert package[128] == 122u8
    assert package_archive_test_read_u64(package, 144) == 256u64
    assert package_archive_test_read_u64(package, 152) == 2u64
    assert package_archive_test_read_u64(package, 160) == 2u64
    assert package_archive_test_read_u32(package, 168) == 0u32
    assert package[256] == 16u8 and package[257] == 32u8
    for index in 243..<256 |package|:
        assert package[index] == 0u8


@test
def rejects_malformed_or_mismatched_zstd_candidates() -> void can[Memory.Allocate, Abort.Panic]:
    valid_small_frame: darray[u8] = [0x28u8, 0xb5u8, 0x2fu8, 0xfdu8, 0x20u8, 2u8, 0x11u8, 0u8, 0u8, 16u8, 32u8]
    valid_checksum_frame: darray[u8] = [0x28u8, 0xb5u8, 0x2fu8, 0xfdu8, 0x24u8, 2u8, 0x11u8, 0u8, 0u8, 16u8, 32u8, 0u8, 0u8, 0u8, 0u8]
    wrong_magic: darray[u8] = [0u8, 0xb5u8, 0x2fu8, 0xfdu8, 0x20u8, 2u8, 0x11u8, 0u8, 0u8, 16u8, 32u8]
    truncated_header: darray[u8] = [0x28u8, 0xb5u8, 0x2fu8, 0xfdu8]
    reserved_block_type: darray[u8] = [0x28u8, 0xb5u8, 0x2fu8, 0xfdu8, 0x20u8, 2u8, 7u8, 0u8, 0u8]
    truncated_block: darray[u8] = [0x28u8, 0xb5u8, 0x2fu8, 0xfdu8, 0x20u8, 2u8, 0x11u8, 0u8, 0u8, 16u8]
    trailing_data: darray[u8] = [0x28u8, 0xb5u8, 0x2fu8, 0xfdu8, 0x20u8, 2u8, 0x11u8, 0u8, 0u8, 16u8, 32u8, 0u8]
    windowed_payload: mutable darray[u8] = []
    windowed_frame: mutable darray[u8] = [0x28u8, 0xb5u8, 0x2fu8, 0xfdu8, 0x40u8, 0u8, 1u8, 0u8, 9u8, 8u8, 0u8]
    for index in 0..<257usize |windowed_payload, windowed_frame|:
        windowed_payload.push(index.u8())
        windowed_frame.push(index.u8())
    assert not package_archive_rejects_compression_frame(valid_small_frame)
    assert not package_archive_rejects_compression_frame(valid_checksum_frame)
    assert not package_archive_rejects_compression_frame(windowed_frame, windowed_payload)
    assert package_archive_rejects_compression_frame(wrong_magic)
    assert package_archive_rejects_compression_frame(truncated_header)
    assert package_archive_rejects_compression_frame(reserved_block_type)
    assert package_archive_rejects_compression_frame(truncated_block)
    assert package_archive_rejects_compression_frame(trailing_data)
    assert package_archive_rejects_compression_frame(valid_small_frame, [1u8])
