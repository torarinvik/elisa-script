include "../../src/testing/geometry_subset_stage_posix.elisa"

using EsGeometrySubsetStagePosix
using EsGeometrySubsetPackageCases
using EsGeometrySubsetStageModel
using EsGeometrySubsetUv1Cases


def geometry_subset_staging_roundtrip() -> bool can[File.Read, File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
    receipt: Receipt = try EsGeometrySubsetStagePosix::stage_geometry_packages() else failure:
        return false
    generated: darray[GeneratedCase] = try EsGeometrySubsetStageModel::package_cases() else failure:
        cleaned_after_generation_error: bool = try remove_tree(receipt.directory) else false
        _ = cleaned_after_generation_error
        return false
    valid: mutable bool = receipt.case_count == generated.count
    valid <- false if receipt.total_package_bytes == 0

    for index in 0..<generated.count |generated, valid|:
        package_path: Path = receipt.directory.joinpath(generated[index].file_name)
        staged: darray[u8] = try read_bytes(package_path) else failure:
            valid <- false
            break
        valid <- false if staged != generated[index].package_bytes

    expected_manifest: darray[u8] = try EsGeometrySubsetStageModel::manifest_bytes(f"{receipt.directory}", generated) else failure:
        valid <- false
        []
    actual_manifest: darray[u8] = try read_bytes(receipt.manifest_path) else failure:
        valid <- false
        []
    valid <- false if actual_manifest != expected_manifest

    cleaned: bool = try remove_tree(receipt.directory) else false
    return valid and cleaned


def geometry_subset_uv1_staging_roundtrip() -> bool can[File.Read, File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
    inputs: CookedInputs = CookedInputs{
        atlas_package: "header=atlas\nuv1s_meshopt_b64=encoded\nuv1_source=xatlas\nuv1_chart_count=7\n",
        skinned_package: "header=skinned\nuv1_chart_count=11\n",
        invalid_uv1_stream_base64: "range",
        atlas_vertex_count: 18u32,
        skinned_vertex_count: 36u32
    }
    receipt: Receipt = try EsGeometrySubsetStagePosix::stage_geometry_packages_with_uv1(inputs) else failure:
        _ = failure
        return false
    generated: darray[GeneratedCase] = try EsGeometrySubsetStageModel::package_cases_with_uv1(inputs) else failure:
        _ = try remove_tree(receipt.directory)
        return false
    valid: mutable bool = receipt.case_count == generated.count
    valid <- false if receipt.total_package_bytes == 0

    for index in 0..<generated.count |generated, valid|:
        package_path: Path = receipt.directory.joinpath(generated[index].file_name)
        staged: darray[u8] = try read_bytes(package_path) else failure:
            valid <- false
            break
        valid <- false if staged != generated[index].package_bytes

    expected_manifest: darray[u8] = try EsGeometrySubsetStageModel::manifest_bytes(f"{receipt.directory}", generated) else failure:
        valid <- false
        []
    actual_manifest: darray[u8] = try read_bytes(receipt.manifest_path) else failure:
        valid <- false
        []
    valid <- false if actual_manifest != expected_manifest

    cleaned: bool = try remove_tree(receipt.directory) else false
    return valid and cleaned


def geometry_subset_all_cooked_uv1_staging_roundtrip() -> bool can[File.Read, File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
    uv1_inputs: CookedInputs = CookedInputs{
        atlas_package: "uv1s_meshopt_b64=encoded\nuv1_stride=8\nuv1_source=xatlas\nuv1_generator_revision=revision\nuv1_resolution=128\nuv1_padding=4\nuv1_chart_count=7\nmeshopt_codec=meshoptimizer-v1.2\n",
        skinned_package: "skinned-package=complete\nuv1_chart_count=11\n",
        invalid_uv1_stream_base64: "invalid-range-stream",
        atlas_vertex_count: 18u32,
        skinned_vertex_count: 36u32
    }
    receipt: Receipt = try EsGeometrySubsetStagePosix::stage_geometry_packages_with_cooked_variants_and_uv1(
        "meshopt_codec=meshoptimizer-v1.2\npositions_meshopt_b64=position\nindices_meshopt_b64=index\n",
        "raw",
        "morph_0_positions_b64=raw\nmorph_0_positions_meshopt_b64=position\nmorph_0_normals_meshopt_b64=normal\nmorph_target_position_stride=12\nmorph_targets=1\n",
        "skin_indices_meshopt_b64=indices\nskin_weights_meshopt_b64=weights\n",
        "camera_0_projection=0\nlight_0_kind=0\ncamera_0_transform_b64=encoded\n",
        "mesh_placement_stride=80\nmesh_count=3\nmesh_placements_b64=AAECAwQFBgcICQoLDA0ODxAREhMUFRYX\n",
        uv1_inputs) else failure:
        _ = failure
        return false
    generated: darray[GeneratedCase] = try EsGeometrySubsetStageModel::package_cases_with_cooked_variants_and_uv1(
        "meshopt_codec=meshoptimizer-v1.2\npositions_meshopt_b64=position\nindices_meshopt_b64=index\n",
        "raw",
        "morph_0_positions_b64=raw\nmorph_0_positions_meshopt_b64=position\nmorph_0_normals_meshopt_b64=normal\nmorph_target_position_stride=12\nmorph_targets=1\n",
        "skin_indices_meshopt_b64=indices\nskin_weights_meshopt_b64=weights\n",
        "camera_0_projection=0\nlight_0_kind=0\ncamera_0_transform_b64=encoded\n",
        "mesh_placement_stride=80\nmesh_count=3\nmesh_placements_b64=AAECAwQFBgcICQoLDA0ODxAREhMUFRYX\n",
        uv1_inputs) else failure:
        _ = try remove_tree(receipt.directory)
        return false
    valid: mutable bool = receipt.case_count == 129 and generated.count == 129

    for index in 0..<generated.count |generated, valid|:
        package_path: Path = receipt.directory.joinpath(generated[index].file_name)
        staged: darray[u8] = try read_bytes(package_path) else failure:
            valid <- false
            break
        valid <- false if staged != generated[index].package_bytes

    expected_manifest: darray[u8] = try EsGeometrySubsetStageModel::manifest_bytes(f"{receipt.directory}", generated) else failure:
        valid <- false
        []
    actual_manifest: darray[u8] = try read_bytes(receipt.manifest_path) else failure:
        valid <- false
        []
    valid <- false if actual_manifest != expected_manifest
    cleaned: bool = try remove_tree(receipt.directory) else false
    return valid and cleaned


@test
def geometry_subset_staging_writes_exact_package_and_manifest_bytes_then_cleans_owned_tree() -> void can[File.Read, File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
    assert geometry_subset_staging_roundtrip()


@test
def geometry_subset_uv1_staging_writes_exact_package_and_manifest_bytes_then_cleans_owned_tree() -> void can[File.Read, File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
    assert geometry_subset_uv1_staging_roundtrip()


@test
def geometry_subset_cooked_uv1_staging_writes_exact_package_and_manifest_bytes_then_cleans_owned_tree() -> void can[File.Read, File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
    assert geometry_subset_all_cooked_uv1_staging_roundtrip()
