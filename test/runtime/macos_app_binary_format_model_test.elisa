include "../../src/runtime/macos_app_binary_format_model.elisa"

using EsMacosAppBinaryFormat


@test
def recognizes_the_reference_macho_magic_values() -> void:
    assert macos_app_header_is_mach_o([207, 250, 237, 254])
    assert macos_app_header_is_mach_o([206, 250, 237, 254])
    assert macos_app_header_is_mach_o([202, 254, 186, 190])


@test
def rejects_short_long_and_unrecognized_prefixes() -> void:
    assert not macos_app_header_is_mach_o([])
    assert not macos_app_header_is_mach_o([202, 254, 186])
    assert not macos_app_header_is_mach_o([202, 254, 186, 190, 0])
    assert not macos_app_header_is_mach_o([202, 254, 186, 191])
