# Dormant native-layout fixture; this does not invoke clock_gettime or usleep.
# Execution, including this fixture, remains disabled until reauthorized.
include "../../src/runtime/monotonic_time_model.elisa"


@test
def darwin64_timestamp_record_has_literal_timespec_field_order() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        assert EsMonotonicTime::darwin64_clock_layout_supported(size_of(uintptr), size_of(i64), size_of(EsMonotonicTime::MonotonicTimestamp), size_of(i32), size_of(u32))
        return if size_of(EsMonotonicTime::MonotonicTimestamp) != 16
        sample: EsMonotonicTime::MonotonicTimestamp = EsMonotonicTime::MonotonicTimestamp{seconds: 1, nanoseconds: 258}
        bytes: u8& = (&sample).cast[u8&]
        expected: darray[u8] = [1u8,0u8,0u8,0u8,0u8,0u8,0u8,0u8, 2u8,1u8,0u8,0u8,0u8,0u8,0u8,0u8]
        for index in 0..<expected.count:
            assert bytes[index] == expected[index]
