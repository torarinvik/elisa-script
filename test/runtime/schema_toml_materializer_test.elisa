include "../../src/runtime/encoding.elisa"
include "../../src/runtime/config_model.elisa"
include "../../src/runtime/config_toml_model.elisa"
include "../../src/runtime/record_numeric_model.elisa"
include "../../src/runtime/schema_model.elisa"
include "../../src/runtime/schema_integer_conversion.elisa"
include "../../src/runtime/schema_toml_materializer.elisa"

using EsConfig
using EsConfigToml
using EsSchema
using EsSchemaNumeric
using EsSchemaToml


@test
def toml_schema_binds_typed_config_and_text_overrides() -> void:
    can Memory.Allocate, Abort.Panic:
        parsed: ConfigTomlLayer = parse_toml_config("name = \"release\"\nenabled = true\nworkers = 1000\ntimeout = 1_25.5_0e+2\nfeatures = [\"thin-lto\", \"strip\"]\ndependency = { version = \"1.2\", optional = false }\n")
        override_entries: darray[ConfigEntry] = [
            ConfigEntry{key: "workers", value: "0x10"},
            ConfigEntry{key: "enabled", value: "false"},
        ]
        overrides: ConfigLayer = ConfigLayer{source: ConfigSource.Environment, entries: override_entries}
        resolution: mutable ConfigTomlResolution = resolve_toml_config_layers(parsed, [overrides])
        schema: SchemaDescriptor = SchemaDescriptor{name: "build", source: SchemaSource.Toml, fields: [
            SchemaField{name: "name", kind: SchemaValueKind.Text},
            SchemaField{name: "enabled", kind: SchemaValueKind.Bool},
            SchemaField{name: "workers", kind: SchemaValueKind.Number, integer_target: SchemaIntegerTarget.U16},
            SchemaField{name: "timeout", kind: SchemaValueKind.Number, decimal_target: SchemaDecimalTarget.Exact},
            SchemaField{name: "features", kind: SchemaValueKind.Array, type_index: 1},
            SchemaField{name: "dependency", kind: SchemaValueKind.Object, type_index: 4},
        ], types: [
            SchemaTypeNode{kind: SchemaValueKind.Text},
            SchemaTypeNode{kind: SchemaValueKind.Array, array_item_type_index: 0},
            SchemaTypeNode{kind: SchemaValueKind.Text},
            SchemaTypeNode{kind: SchemaValueKind.Bool},
            SchemaTypeNode{kind: SchemaValueKind.Object, object_field_start: 0, object_field_count: 2},
        ], nested_fields: [
            SchemaNestedField{name: "optional", required: false, type_index: 3},
            SchemaNestedField{name: "version", type_index: 2},
        ]}
        record: SchemaTomlRecord = materialize_toml_schema_record(schema, resolution)
        assert record.values.count == 6
        assert record.values[0].kind == SchemaTomlValueKind.Text
        assert record.values[1].kind == SchemaTomlValueKind.Bool and not record.values[1].bool_value
        assert record.values[2].kind == SchemaTomlValueKind.Integer
        assert record.values[2].integer_value.unsigned_value == 16
        assert record.values[3].kind == SchemaTomlValueKind.Decimal
        assert record.values[3].decimal_value.coefficient_digits.count != 0
        assert record.values[4].kind == SchemaTomlValueKind.Array
        assert resolution.values[record.values[4].source_value_index].items.count == 2
        assert record.values[5].kind == SchemaTomlValueKind.Object
        assert resolution.values[record.values[5].source_value_index].fields.count == 2

        dependency_index: mutable usize = resolution.values.count
        for source_index in 0..<resolution.values.count |resolution, dependency_index|:
            if resolution.values[source_index].key == "dependency":
                dependency_index <- source_index
        assert dependency_index < resolution.values.count
        dependency_root: ConfigTomlNode = resolution.values[dependency_index].nodes[0]
        duplicate_node_index: usize = resolution.values[dependency_index].nodes.count
        resolution.values[dependency_index].nodes.push(ConfigTomlNode{kind: ConfigTomlValueKind.Text, text: [49u8, 46u8, 50u8]})
        duplicate_edge: ConfigTomlNodeChild = ConfigTomlNodeChild{owner_index: 0, value_index: duplicate_node_index, ordinal: dependency_root.child_count, key: [118u8, 101u8, 114u8, 115u8, 105u8, 111u8, 110u8]}
        resolution.values[dependency_index].children.push(duplicate_edge)
        dependency_root.child_count <- dependency_root.child_count + 1
        resolution.values[dependency_index].nodes[0] <- dependency_root
        duplicate_rejected: mutable bool = false
        catch materialize_toml_schema_record(schema, resolution):
            ok duplicate_record:
                assert false
            error failure:
                duplicate_rejected <- failure == SchemaTomlMaterializeError.InvalidSource
        assert duplicate_rejected

        wrong_item: ConfigTomlLayer = parse_toml_config("name = \"release\"\nenabled = true\nworkers = 1000\ntimeout = 1.0\nfeatures = [\"valid\", 3]\ndependency = { version = \"1.2\" }\n")
        wrong_item_resolution: ConfigTomlResolution = resolve_toml_config_layers(wrong_item, [])
        wrong_item_rejected: mutable bool = false
        catch materialize_toml_schema_record(schema, wrong_item_resolution):
            ok wrong_record:
                assert false
            error failure:
                wrong_item_rejected <- failure == SchemaTomlMaterializeError.ValueKindMismatch
        assert wrong_item_rejected

        missing_inline: ConfigTomlLayer = parse_toml_config("name = \"release\"\nenabled = true\nworkers = 1000\ntimeout = 1.0\nfeatures = []\ndependency = { optional = true }\n")
        missing_inline_resolution: ConfigTomlResolution = resolve_toml_config_layers(missing_inline, [])
        missing_inline_rejected: mutable bool = false
        catch materialize_toml_schema_record(schema, missing_inline_resolution):
            ok incomplete_record:
                assert false
            error failure:
                missing_inline_rejected <- failure == SchemaContractError.RequiredFieldMissing
        assert missing_inline_rejected


@test
def toml_schema_rejects_unknown_and_missing_required_fields() -> void:
    can Memory.Allocate, Abort.Panic:
        unknown: ConfigTomlLayer = parse_toml_config("name = \"release\"\nextra = true\n")
        unknown_resolution: ConfigTomlResolution = resolve_toml_config_layers(unknown, [])
        schema: SchemaDescriptor = SchemaDescriptor{name: "build", source: SchemaSource.Toml, fields: [SchemaField{name: "name", kind: SchemaValueKind.Text}]}
        unknown_rejected: mutable bool = false
        catch materialize_toml_schema_record(schema, unknown_resolution):
            ok record:
                assert false
            error failure:
                unknown_rejected <- failure == SchemaTomlMaterializeError.UnknownField
        assert unknown_rejected

        missing: ConfigTomlLayer = parse_toml_config("other = \"value\"\n")
        missing_resolution: ConfigTomlResolution = resolve_toml_config_layers(missing, [])
        missing_rejected: mutable bool = false
        catch materialize_toml_schema_record(schema, missing_resolution):
            ok record:
                assert false
            error failure:
                missing_rejected <- failure == SchemaContractError.RequiredFieldMissing
        assert missing_rejected


@test
def toml_schema_recursively_validates_nested_inline_tables_and_arrays() -> void:
    can Memory.Allocate, Abort.Panic:
        schema: SchemaDescriptor = SchemaDescriptor{name: "dependency", source: SchemaSource.Toml, fields: [
            SchemaField{name: "dependency", kind: SchemaValueKind.Object, type_index: 0},
        ], types: [
            SchemaTypeNode{kind: SchemaValueKind.Object, object_field_start: 0, object_field_count: 2},
            SchemaTypeNode{kind: SchemaValueKind.Text},
            SchemaTypeNode{kind: SchemaValueKind.Array, array_item_type_index: 1},
            SchemaTypeNode{kind: SchemaValueKind.Bool},
            SchemaTypeNode{kind: SchemaValueKind.Object, object_field_start: 2, object_field_count: 2},
        ], nested_fields: [
            SchemaNestedField{name: "optional", required: false, type_index: 3},
            SchemaNestedField{name: "source", type_index: 4},
            SchemaNestedField{name: "git", type_index: 1},
            SchemaNestedField{name: "tags", type_index: 2},
        ]}

        parsed: ConfigTomlLayer = parse_toml_config("dependency = { source = { git = \"url\", tags = [\"v1\", \"v2\"] }, optional = true }\n")
        resolution: ConfigTomlResolution = resolve_toml_config_layers(parsed, [])
        record: SchemaTomlRecord = materialize_toml_schema_record(schema, resolution)
        assert record.values.count == 1
        assert record.values[0].kind == SchemaTomlValueKind.Object
        dependency: ConfigTomlResolvedValue = resolution.values[record.values[0].source_value_index]
        dependency_root: ConfigTomlNode = dependency.nodes[0]
        source_index: mutable usize = dependency.nodes.count
        for ordinal in 0..<dependency_root.child_count |dependency, dependency_root, source_index|:
            edge: ConfigTomlNodeChild = dependency.children[dependency_root.child_start + ordinal]
            if bytes_view(edge.key) == "source":
                source_index <- edge.value_index
        assert source_index < dependency.nodes.count
        source_node: ConfigTomlNode = dependency.nodes[source_index]
        tags_index: mutable usize = dependency.nodes.count
        for ordinal in 0..<source_node.child_count |dependency, source_node, tags_index|:
            edge: ConfigTomlNodeChild = dependency.children[source_node.child_start + ordinal]
            if bytes_view(edge.key) == "tags":
                tags_index <- edge.value_index
        assert tags_index < dependency.nodes.count
        assert dependency.nodes[tags_index].kind == ConfigTomlValueKind.Array
        assert dependency.nodes[tags_index].child_count == 2

        wrong_nested_item: ConfigTomlLayer = parse_toml_config("dependency = { source = { git = \"url\", tags = [\"v1\", 2] }, optional = true }\n")
        wrong_nested_resolution: ConfigTomlResolution = resolve_toml_config_layers(wrong_nested_item, [])
        wrong_nested_rejected: mutable bool = false
        catch materialize_toml_schema_record(schema, wrong_nested_resolution):
            ok wrong_record:
                assert false
            error failure:
                wrong_nested_rejected <- failure == SchemaTomlMaterializeError.ValueKindMismatch
        assert wrong_nested_rejected

        missing_nested_required: ConfigTomlLayer = parse_toml_config("dependency = { source = { tags = [\"v1\"] }, optional = true }\n")
        missing_nested_resolution: ConfigTomlResolution = resolve_toml_config_layers(missing_nested_required, [])
        missing_nested_rejected: mutable bool = false
        catch materialize_toml_schema_record(schema, missing_nested_resolution):
            ok incomplete_record:
                assert false
            error failure:
                missing_nested_rejected <- failure == SchemaContractError.RequiredFieldMissing
        assert missing_nested_rejected


@test
def toml_schema_rejects_malformed_numeric_override_separators() -> void:
    can Memory.Allocate, Abort.Panic:
        parsed: ConfigTomlLayer = parse_toml_config("workers = 10\n")
        override_entries: darray[ConfigEntry] = [ConfigEntry{key: "workers", value: "1__0"}]
        overrides: ConfigLayer = ConfigLayer{source: ConfigSource.Environment, entries: override_entries}
        resolution: ConfigTomlResolution = resolve_toml_config_layers(parsed, [overrides])
        schema: SchemaDescriptor = SchemaDescriptor{name: "build", source: SchemaSource.Toml, fields: [
            SchemaField{name: "workers", kind: SchemaValueKind.Number, integer_target: SchemaIntegerTarget.U16},
        ]}
        rejected: mutable bool = false
        catch materialize_toml_schema_record(schema, resolution):
            ok record:
                assert false
            error failure:
                rejected <- failure == SchemaTomlMaterializeError.InvalidNumber
        assert rejected


@test
def toml_schema_binds_one_table_and_ignores_siblings_and_descendants() -> void:
    can Memory.Allocate, Abort.Panic:
        parsed: ConfigTomlLayer = parse_toml_config("[build]\nworkers = 12\n[build.output]\nkind = \"archive\"\n[other]\nnote = \"leave alone\"\n")
        resolution: ConfigTomlResolution = resolve_toml_config_layers(parsed, [])
        schema: SchemaDescriptor = SchemaDescriptor{name: "build", source: SchemaSource.Toml, fields: [
            SchemaField{name: "worker_count", source_name: "workers", kind: SchemaValueKind.Number, integer_target: SchemaIntegerTarget.U16},
        ]}
        record: SchemaTomlRecord = materialize_toml_schema_table(schema, resolution, "build")
        assert record.values.count == 1
        assert record.values[0].field_index == 0
        assert record.values[0].kind == SchemaTomlValueKind.Integer
        assert record.values[0].integer_value.unsigned_value == 12
