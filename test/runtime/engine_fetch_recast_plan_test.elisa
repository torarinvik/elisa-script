include "../../ports/elisa-engine/scripts/fetch_recast_plan.elisa"

using EsEngineFetchRecastPlan


@test
def recast_fetch_plan_pins_tagged_clone_and_revision_commands() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    checkout: Path = path("/fixture/dependencies/recast with spaces")
    clone: Command = clone_command(checkout)
    revision: Command = revision_command(checkout)
    assert clone.program == "git"
    assert clone.arguments == ["clone", "--branch", Dependency::TAG, "--depth", "1", Dependency::REPOSITORY, f"{checkout}"]
    assert revision.program == "git"
    assert revision.arguments == ["-C", f"{checkout}", "rev-parse", "HEAD"]
    assert command_text(revision) == "git -C /fixture/dependencies/recast with spaces rev-parse HEAD"


@test
def recast_fetch_plan_pins_policy_floor_disabled_extras_and_targets() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    checkout: Path = path("/fixture/dependencies/recast")
    build: Path = checkout.joinpath("build")
    configure: Command = configure_command(checkout, build)
    compile: Command = build_command(build)
    assert configure.program == "cmake"
    assert configure.arguments == [
        "-S", f"{checkout}", "-B", f"{build}", "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5", "-DRECASTNAVIGATION_DEMO=OFF",
        "-DRECASTNAVIGATION_TESTS=OFF", "-DRECASTNAVIGATION_EXAMPLES=OFF"
    ]
    assert compile.program == "cmake"
    assert compile.arguments == ["--build", f"{build}", "--target", "Recast", "Detour"]
    assert Dependency::TAG == "v1.6.0"
    assert Dependency::COMMIT == "6dc1667f580357e8a2154c28b7867bea7e8ad3a7"
    assert Dependency::RECAST_LIBRARY == "dependencies/recast/build/Recast/libRecast.a"
    assert Dependency::DETOUR_LIBRARY == "dependencies/recast/build/Detour/libDetour.a"
