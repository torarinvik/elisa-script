include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../ports/elisa-engine/scripts/gltf_material_records_model.elisa"

using EsEngineGltfMaterialFactors
using EsEngineGltfMaterialRecords
using EsJson


def material_records_reject(source: sview) bool can[Memory.Allocate, Abort.Panic]:
    document: JsonDocument = try parse_document(source) else failure:
        _ = failure
        return false
    rejected: mutable bool = false
    catch document_material_records(document):
        ok records:
            _ = records
        error failure:
            _ = failure
            rejected <- true
    return rejected


@test
def gltf_material_records_preserve_defaults_factor_order_alpha_mode_and_flags() -> void can[Memory.Allocate, Abort.Panic]:
    source: sview = "{\"materials\":[{}, {\"pbrMetallicRoughness\":{\"baseColorFactor\":[0,0.25,0.5,1],\"metallicFactor\":0.25,\"roughnessFactor\":0},\"emissiveFactor\":[0,0.5,1],\"alphaMode\":\"MASK\",\"alphaCutoff\":0.75,\"doubleSided\":true,\"occlusionTexture\":{},\"pbrMetallicRoughness\":{\"baseColorFactor\":[0,0.25,0.5,1],\"metallicFactor\":0.25,\"roughnessFactor\":0,\"baseColorTexture\":{}}}]}"
    document: JsonDocument = try parse_document(source) else failure:
        _ = failure
        assert false
        JsonDocument{}
    records: MaterialRecordSet = document_material_records(document)
    assert records.slot_count == 2 and records.records.count == 2
    assert records.records[0].factors == [1.0f32, 1.0f32, 1.0f32, 1.0f32, 1.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.5f32]
    assert records.records[0].alpha_mode == AlphaMode::OPAQUE and records.records[0].flags == 0u32
    assert records.records[1].factors == [0.0f32, 0.25f32, 0.5f32, 1.0f32, 0.25f32, 0.0f32, 0.0f32, 0.5f32, 1.0f32, 0.75f32]
    assert records.records[1].alpha_mode == AlphaMode::MASK and records.records[1].flags == (Flags::DOUBLE_SIDED | Flags::OCCLUSION)
    assert records.records[1].has_base_color_texture
    assert records.records[0].source_material_index != records.records[1].source_material_index


@test
def gltf_material_records_reject_unsupported_or_invalid_core_material_values() -> void can[Memory.Allocate, Abort.Panic]:
    assert material_records_reject("{\"materials\":[{\"pbrMetallicRoughness\":null}]}")
    assert material_records_reject("{\"materials\":[{\"pbrMetallicRoughness\":{\"unknown\":1}}]}")
    assert material_records_reject("{\"materials\":[{\"emissiveFactor\":[0,1]}]}")
    assert material_records_reject("{\"materials\":[{\"alphaMode\":\"BLENDED\"}]}")
    assert material_records_reject("{\"materials\":[{\"doubleSided\":1}]}")
    assert material_records_reject("{\"materials\":[{\"alphaMode\":\"MASK\"}]}")
    assert material_records_reject("{\"materials\":[{\"pbrMetallicRoughness\":{\"metallicFactor\":true}}]}")
