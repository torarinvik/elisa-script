include "../../src/runtime/encoding.elisa"
include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../src/runtime/json_lexer_model.elisa"
include "../../src/runtime/json_parse_model.elisa"
include "../../src/runtime/shader_permutation_selection_model.elisa"

using EsShaderPermutationSelection


def selection_rejects_as(source: sview, expected: SelectionError) -> bool can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch parse_selection_json(source):
        ok selection:
            _ = selection
        error failure:
            rejected <- failure == expected
    return rejected


@test
def shader_selection_sorts_and_resolves_names_deterministically() -> void:
    can Memory.Allocate, Abort.Panic:
        selection: Selection = parse_selection_json("[\"z.cso\",\"sub/a.cso\"]")
        assert not selection.select_all
        assert selection.names.count == 2
        assert selection.names[0] == "sub/a.cso" and selection.names[1] == "z.cso"
        available: darray[sview] = ["unused.cso", "z.cso", "sub/a.cso"]
        resolution: Resolution = resolve_shader_permutations(selection, available)
        assert resolution.indices.count == 2
        assert resolution.indices[0] == 2 and resolution.indices[1] == 1
        assert resolution.missing.count == 0


@test
def shader_selection_preserves_default_order_and_sorts_missing_names() -> void:
    can Memory.Allocate, Abort.Panic:
        available: darray[sview] = ["z.cso", "a.cso"]
        all_selection: Selection = all_shader_permutations()
        all_resolution: Resolution = resolve_shader_permutations(all_selection, available)
        assert all_resolution.indices.count == 2
        assert all_resolution.indices[0] == 0 and all_resolution.indices[1] == 1
        requested: Selection = parse_selection_json("[\"missing-z.cso\",\"missing-a.cso\",\"z.cso\"]")
        resolution: Resolution = resolve_shader_permutations(requested, available)
        assert resolution.indices.count == 1 and resolution.indices[0] == 0
        assert resolution.missing.count == 2
        assert resolution.missing[0] == "missing-a.cso" and resolution.missing[1] == "missing-z.cso"
        assert missing_shader_permutation_message(resolution.missing) == "requested shader permutations were not compiled: missing-a.cso, missing-z.cso"
        assert missing_shader_permutation_message([]) == ""


@test
def shader_selection_rejects_invalid_roots_and_entry_types() -> void:
    can Memory.Allocate, Abort.Panic:
        assert selection_rejects_as("{\"names\":[]}", SelectionError.NonemptyBoundedArrayRequired)
        assert selection_rejects_as("[]", SelectionError.NonemptyBoundedArrayRequired)
        assert selection_rejects_as("[1]", SelectionError.NamesMustBeStrings)
        assert selection_rejects_as("[", SelectionError.JsonArrayRequired)


@test
def shader_selection_rejects_escaping_noncanonical_and_duplicate_paths() -> void:
    can Memory.Allocate, Abort.Panic:
        for source in [
            "[\"../escape.cso\"]",
            "[\"/absolute.cso\"]",
            "[\"a.cso\",\"a.cso\"]",
            "[\"a//b.cso\"]",
            "[\"a/./b.cso\"]",
            "[\"a/../b.cso\"]",
            "[\"a.txt\"]",
            "[\".cso\"]",
            "[\"a.cso/\"]",
            "[\"a\\\\b.cso\"]",
            "[\"a\\u0000b.cso\"]"
        ]:
            assert selection_rejects_as(source, SelectionError.InvalidOrDuplicateName)
