# Pure record fixtures. No channel descriptor, child kernel or syscall runs.
include "../../src/runtime/process_spawn_failure_model.elisa"

using EsProcessSpawnFailure


module EsSpawnFailureFixture:
    public:
        def rejected(frame: Frame, candidates: usize) -> bool:
            catch validate(frame, candidates):
                ok:
                    return false
                error failure:
                    return true


@test
def spawn_failure_record_matches_literal_little_endian_golden() -> void:
    can Memory.Allocate, Abort.Panic:
        expected: darray[u8] = [69u8,83u8,70u8,49u8, 3u8,0u8,0u8,0u8, 8u8,0u8,0u8,0u8, 2u8,0u8,0u8,0u8]
        encoded: darray[u8] = try encode(Frame{phase: Phase::Exec, errno: 8, candidate: 2}, 3) else err:
            assert false
            return
        assert encoded.count == expected.count
        for index in 0..<expected.count:
            assert encoded[index] == expected[index]
        decoded: Frame = try decode(expected, 3) else err:
            assert false
            return
        assert decoded.magic == Protocol::MAGIC and decoded.phase == Phase::Exec
        assert decoded.errno == 8 and decoded.candidate == 2


@test
def spawn_failure_record_keeps_group_and_exhaustion_distinct_from_exec_index() -> void:
    can Memory.Allocate, Abort.Panic:
        for frame in [Frame{phase: Phase::Prepared}, Frame{phase: Phase::Group, errno: 4}, Frame{phase: Phase::Exhausted, errno: 2}, Frame{phase: Phase::Exhausted, errno: 13}]:
            bytes: darray[u8] = try encode(frame, 1) else err:
                assert false
                return
            decoded: Frame = try decode(bytes, 1) else err:
                assert false
                return
            assert decoded.phase == frame.phase and decoded.errno == frame.errno
            assert decoded.candidate == Protocol::NO_CANDIDATE


@test
def spawn_failure_record_rejects_forged_stages_errno_and_candidate_receipts() -> void:
    can Memory.Allocate, Abort.Panic:
        for frame in [Frame{magic: 0, phase: Phase::Prepared}, Frame{phase: 0}, Frame{phase: Phase::Prepared, errno: 2}, Frame{phase: Phase::Prepared, candidate: 0}, Frame{phase: Phase::Group}, Frame{phase: Phase::Group, errno: -1}, Frame{phase: Phase::Group, errno: 4, candidate: 0}, Frame{phase: Phase::Exec, errno: 8, candidate: 1}, Frame{phase: Phase::Exec, errno: 2, candidate: 0}, Frame{phase: Phase::Exhausted, errno: 8}, Frame{phase: Phase::Exhausted, errno: 2, candidate: 0}]:
            assert EsSpawnFailureFixture::rejected(frame, 1)
        assert EsSpawnFailureFixture::rejected(Frame{phase: Phase::Exhausted, errno: 2}, 0)
        assert EsSpawnFailureFixture::rejected(Frame{phase: Phase::Prepared}, Protocol::MAX_CANDIDATES + 1)


@test
def spawn_failure_payload_empty_is_not_success_and_partial_frames_are_invalid() -> void:
    can Memory.Allocate, Abort.Panic:
        assert payload_state(0) == PayloadState.Empty
        assert payload_state(16) == PayloadState.Complete
        for amount in [1usize, 15usize, 17usize, 32usize]:
            assert payload_state(amount) == PayloadState.Invalid
        invalid_payloads: darray[darray[u8]] = [[], [69u8,83u8,70u8,49u8]]
        for bytes in invalid_payloads:
            rejected: mutable bool = false
            catch decode(bytes, 1):
                ok _:
                    assert false
                error failure:
                    rejected <- failure == ProtocolError.Size
            assert rejected


@test
def spawn_failure_decode_rejects_negative_wire_errno_before_narrowing() -> void:
    can Memory.Allocate, Abort.Panic:
        bytes: darray[u8] = [69u8,83u8,70u8,49u8, 2u8,0u8,0u8,0u8, 255u8,255u8,255u8,255u8, 255u8,255u8,255u8,255u8]
        rejected: mutable bool = false
        catch decode(bytes, 1):
            ok _:
                assert false
            error failure:
                rejected <- failure == ProtocolError.Errno
        assert rejected
