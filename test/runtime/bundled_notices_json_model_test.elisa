include "../../ports/elisa-engine/scripts/bundled_notices_json_model.elisa"

using EsEngineBundledNoticesJson
using EsEngineBundledNoticesAudit


def bundled_notices_json_rejects(source: sview, expected: BundledNoticesJsonError) -> bool can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch catalog_from_json(source):
        ok catalog:
            _ = catalog
        error failure:
            rejected <- failure == expected
    return rejected


@test
def bundled_notices_catalog_decoder_projects_python_fields_and_last_duplicate_values() -> void can[Memory.Allocate, Abort.Panic]:
    source: sview = "{\"schema\":99,\"complete\":false,\"complete\":true,\"sources\":[{\"name\":\"cgltf\",\"sha256\":\"whole-file\",\"excerpt\":{\"sha256\":\"excerpt\"}}],\"bundled_libraries\":{\"libalpha.dylib\":{\"notices\":[\"cgltf\"],\"remaining\":\"host supplied\"},\"libbeta.dylib\":{}},\"remaining\":[\"catalog incomplete\"]}"
    catalog: Catalog = try catalog_from_json(source) else failure:
        _ = failure
        assert false
        Catalog{}
    assert catalog.complete
    assert catalog.sources.count == 1
    assert catalog.sources[0].name == "cgltf"
    assert catalog.sources[0].sha256 == "excerpt"
    assert catalog.bundled_libraries.count == 2
    assert catalog.bundled_libraries[0].library_name == "libalpha.dylib"
    assert catalog.bundled_libraries[0].notices == ["cgltf"]
    assert catalog.bundled_libraries[0].has_remaining
    assert catalog.bundled_libraries[0].remaining == "host supplied"
    assert catalog.bundled_libraries[1].library_name == "libbeta.dylib"
    assert not catalog.bundled_libraries[1].has_remaining
    assert catalog.remaining == ["catalog incomplete"]


@test
def bundled_notices_catalog_decoder_defaults_optional_python_fields() -> void can[Memory.Allocate, Abort.Panic]:
    catalog: Catalog = try catalog_from_json("{\"sources\":[]}") else failure:
        _ = failure
        assert false
        Catalog{}
    assert not catalog.complete
    assert catalog.sources.count == 0
    assert catalog.bundled_libraries.count == 0
    assert catalog.remaining.count == 0


@test
def bundled_notices_catalog_decoder_rejects_missing_or_wrongly_typed_fields() -> void can[Memory.Allocate, Abort.Panic]:
    assert bundled_notices_json_rejects("{}", BundledNoticesJsonError.MissingSources)
    assert bundled_notices_json_rejects("{\"sources\":{}}", BundledNoticesJsonError.InvalidSources)
    assert bundled_notices_json_rejects("{\"sources\":[{\"name\":\"x\",\"sha256\":\"00\"}],\"bundled_libraries\":{\"lib.dylib\":{\"notices\":[7]}}}", BundledNoticesJsonError.InvalidNotices)
    assert bundled_notices_json_rejects("{\"sources\":[],\"remaining\":\"not-an-array\"}", BundledNoticesJsonError.InvalidRemaining)
