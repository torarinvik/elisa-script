include "../../src/runtime/macos_app_manifest_model.elisa"
include "../../src/runtime/macos_app_asset_filter_model.elisa"
include "../../src/runtime/macos_app_copy_posix.elisa"
include "../../src/runtime/macos_app_path_plan_model.elisa"
include "../../src/runtime/macos_app_filesystem_posix.elisa"

using EsMacosAppManifest
using EsMacosAppAssetFilter
using EsMacosAppFilesystem


def macos_app_staging_bytes(value: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    bytes: mutable darray[u8] = []
    for byte in value |bytes|:
        bytes.push(byte)
    return bytes


@test
def stages_default_and_explicit_resources_with_filtering_and_link_following() -> void can[Blocking.IO, File.Read, File.Write, Directory.Read, Directory.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
    temporary: Path = try temp_directory("macos-app-resource-stage") else err:
        assert false
        return
    project: Path = temporary.joinpath("project")
    source_directory: Path = project.joinpath("assets").joinpath("nested")
    shader_directory: Path = project.joinpath("shaders").joinpath("metal")
    source_file: Path = source_directory.joinpath("texture.bin")
    source_link: Path = project.joinpath("assets").joinpath("linked-texture.bin")
    source_directory_link: Path = project.joinpath("assets").joinpath("linked-directory")
    ignored_file: Path = project.joinpath("assets").joinpath(".DS_Store")
    notice_source: Path = project.joinpath("NOTICE")
    shader_binary: Path = shader_directory.joinpath("compiled.spv")
    shader_metadata: Path = shader_directory.joinpath("compiled.spv.wishadermeta")
    shader_inventory: Path = project.joinpath("shaders").joinpath("elisa.metal-generated.json")
    resources: Path = temporary.joinpath("stage").joinpath("Resources")
    explicit_resources: Path = temporary.joinpath("explicit-stage").joinpath("Resources")
    staged_file: Path = resources.joinpath("assets").joinpath("nested").joinpath("texture.bin")
    staged_link: Path = resources.joinpath("assets").joinpath("linked-texture.bin")
    staged_directory_link: Path = resources.joinpath("assets").joinpath("linked-directory")
    staged_directory_link_file: Path = staged_directory_link.joinpath("texture.bin")
    staged_ignored: Path = resources.joinpath("assets").joinpath(".DS_Store")
    staged_shader_binary: Path = resources.joinpath("shaders").joinpath("metal").joinpath("compiled.spv")
    staged_shader_metadata: Path = resources.joinpath("shaders").joinpath("metal").joinpath("compiled.spv.wishadermeta")
    staged_shader_inventory: Path = resources.joinpath("shaders").joinpath("elisa.metal-generated.json")
    explicit_file: Path = explicit_resources.joinpath("assets").joinpath("nested").joinpath("texture.bin")
    staged_notice: Path = resources.joinpath("Notices").joinpath("NOTICE")
    default_selection: MacosAppPathSelection = MacosAppPathSelection{}
    explicit_selection: MacosAppPathSelection = MacosAppPathSelection{resource_mode: MacosResourceMode.ExplicitPaths, resource_paths: [macos_app_staging_bytes("assets/nested")]}
    notice_selection: MacosAppPathSelection = MacosAppPathSelection{notice_paths: [macos_app_staging_bytes("NOTICE")]}

    made_source: bool = try create_directories(source_directory) else false
    made_shader_directory: bool = try create_directories(shader_directory) else false
    made_resources: bool = try create_directories(resources) else false
    made_explicit_resources: bool = try create_directories(explicit_resources) else false
    written: usize = try write_text(source_file, "pixel-data") else 0usize
    wrote_ignored: usize = try write_text(ignored_file, "editor litter") else 0usize
    wrote_notice: usize = try write_text(notice_source, "license text") else 0usize
    wrote_shader: usize = try write_text(shader_binary, "compiled shader") else 0usize
    wrote_shader_metadata: usize = try write_text(shader_metadata, "local source path") else 0usize
    wrote_shader_inventory: usize = try write_text(shader_inventory, "generated inventory") else 0usize
    linked: bool = try symlink(source_file, source_link) else false
    linked_directory: bool = try symlink(source_directory, source_directory_link) else false
    staged_all: bool = false
    staged_explicit: bool = false
    shader_staged: bool = false
    notices_staged: bool = false
    notice_conflict: mutable bool = false
    if made_source and made_shader_directory and made_resources and written == 10 and wrote_ignored == 13 and linked and linked_directory:
        staged_all <- try stage_macos_app_resources(project, resources, default_selection) else false
        staged_explicit <- try stage_macos_app_resources(project, explicit_resources, explicit_selection) else false
        shader_staged <- try copy_macos_app_directory(project.joinpath("shaders"), resources.joinpath("shaders"), MacosAppAssetFilterPolicy.ShaderResources) else false
        notices_staged <- try stage_macos_app_notices(project, resources, notice_selection) else false
        if notices_staged:
            catch stage_macos_app_notices(project, resources, notice_selection):
                ok staged_again:
                    _ = staged_again
                error failure:
                    notice_conflict <- failure == MacosAppFilesystemError.NoticeConflict

    staged_file_contents: sview = try read_text(staged_file) else ""
    staged_link_contents: sview = try read_text(staged_link) else ""
    staged_directory_link_contents: sview = try read_text(staged_directory_link_file) else ""
    explicit_file_contents: sview = try read_text(explicit_file) else ""
    notice_contents: sview = try read_text(staged_notice) else ""
    ignored_was_skipped: bool = not path_exists(staged_ignored)
    shader_was_staged: bool = path_exists(staged_shader_binary)
    shader_metadata_was_skipped: bool = not path_exists(staged_shader_metadata)
    shader_inventory_was_skipped: bool = not path_exists(staged_shader_inventory)
    copied_link_is_symlink: bool = try is_symlink(staged_link) else true
    copied_directory_link_is_symlink: bool = try is_symlink(staged_directory_link) else true
    source_directory_mode: i64 = try file_mode(source_directory) else 0i64
    staged_directory_mode: i64 = try file_mode(staged_file.parent()) else 0i64
    removed: bool = try remove_tree(temporary) else false

    assert made_source and made_shader_directory and made_resources and made_explicit_resources
    assert written == 10 and wrote_ignored == 13 and wrote_notice == 12 and wrote_shader > 0 and wrote_shader_metadata > 0 and wrote_shader_inventory > 0 and linked and linked_directory
    assert staged_all and staged_explicit and shader_staged and notices_staged and notice_conflict
    assert staged_file_contents == "pixel-data" and staged_link_contents == "pixel-data"
    assert staged_directory_link_contents == "pixel-data"
    assert explicit_file_contents == "pixel-data" and ignored_was_skipped
    assert notice_contents == "license text"
    assert shader_was_staged and shader_metadata_was_skipped and shader_inventory_was_skipped
    assert not copied_link_is_symlink and not copied_directory_link_is_symlink
    assert source_directory_mode == staged_directory_mode
    assert removed
