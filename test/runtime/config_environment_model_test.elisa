include "../../src/runtime/process_model.elisa"
include "../../src/runtime/environment_model.elisa"
include "../../src/runtime/config_model.elisa"
include "../../src/runtime/config_environment_model.elisa"

using EsEnvironment
using EsConfig
using EsConfigEnvironment


@test
def environment_config_layer_keeps_present_values_and_omits_tombstones() -> void:
    can Memory.Allocate, Abort.Panic:
        snapshot: mutable EnvironmentSnapshot = EnvironmentSnapshot{}
        assert advance_environment_snapshot(snapshot, EnvironmentEvent.Begin) == EnvironmentState.Building
        assert advance_environment_snapshot(snapshot, EnvironmentEvent.Set, "KEEP", "line one\nline two") == EnvironmentState.Building
        assert advance_environment_snapshot(snapshot, EnvironmentEvent.Set, "REMOVE", "old") == EnvironmentState.Building
        assert advance_environment_snapshot(snapshot, EnvironmentEvent.Unset, "REMOVE") == EnvironmentState.Building
        assert advance_environment_snapshot(snapshot, EnvironmentEvent.Seal) == EnvironmentState.Sealed

        layer: ConfigLayer = environment_config_layer(snapshot)
        assert layer.source == ConfigSource.Environment
        assert layer.entries.count == 1
        assert layer.entries[0].key == "KEEP"
        assert layer.entries[0].value == "line one\nline two"


@test
def environment_config_layer_requires_sealed_snapshot() -> void:
    can Memory.Allocate, Abort.Panic:
        not_sealed: mutable bool = false
        snapshot: EnvironmentSnapshot = EnvironmentSnapshot{}
        catch environment_config_layer(snapshot):
            ok layer:
                assert false
            error failure:
                not_sealed <- failure == ConfigEnvironmentError.SnapshotNotSealed
        assert not_sealed


@test
def environment_snapshot_uses_the_environment_entry_limit() -> void:
    can Memory.Allocate, Abort.Panic:
        entries: mutable darray[EnvironmentEntry] = []
        text_bytes: mutable usize = 0
        for _ in 0..<(EsEnvironment::ENVIRONMENT_MAX_ENTRIES + 1) |entries, text_bytes|:
            entries.push(EnvironmentEntry{name: "ELISA_TEST", value: ""})
            text_bytes <- text_bytes + sview_len("ELISA_TEST") + 2
        snapshot: EnvironmentSnapshot = EnvironmentSnapshot{entries: entries, state: EnvironmentState.Sealed, text_bytes: text_bytes}
        rejected: mutable bool = false
        catch validate_environment_snapshot(snapshot):
            ok value:
                assert false
            error failure:
                rejected <- failure == EnvironmentContractError.EntryLimitExceeded
        assert rejected
