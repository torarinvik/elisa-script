include "../../src/runtime/source_length_model.elisa"

using EsSourceLength


@test
def source_length_empty_and_unterminated_lines() -> void:
    assert universal_line_count("") == 0
    assert universal_line_count("hello") == 1
    assert universal_line_count("hello\n") == 1
    assert universal_line_count("hello\nworld") == 2
    assert universal_line_count("\n\n") == 2
    assert universal_line_count("\xef\xbb\xbf") == 1
    assert universal_line_count("\xef\xbb\xbf\n") == 1


@test
def source_length_python_universal_newlines() -> void:
    assert universal_line_count("a\rb\r") == 2
    assert universal_line_count("a\r\nb\r\n") == 2
    assert universal_line_count("\r\n") == 1
    assert universal_line_count("\r") == 1
    assert universal_line_count("\r\r\n") == 2
    assert universal_line_count("\n\r") == 2
    assert universal_line_count("a\r\nb\rc\nd") == 4
    assert universal_line_count("a\r\n\nb") == 3


@test
def source_length_other_unicode_separators_are_content() -> void:
    # NEL, line separator, paragraph separator, VT, FF, and NUL do not
    # terminate a line during Python TextIOWrapper iteration.
    assert universal_line_count("a\xc2\x85b\xe2\x80\xa8c\xe2\x80\xa9d\x0b\x0c\0e") == 1
    assert universal_line_count("a\xc2\x85\r\n\xe2\x80\xa8b") == 2


@test
def source_length_boundary_counts() -> void:
    can Memory.Allocate, Abort.Panic:
        contents: mutable sview = ""
        for _ in 0..<600 |contents|:
            contents <- contents + "\r\n"
        assert universal_line_count(contents) == 600
        assert universal_line_count(contents + "tail") == 601
        assert universal_line_count(contents + "\n") == 601
