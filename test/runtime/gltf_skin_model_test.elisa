include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../ports/elisa-engine/scripts/gltf_accessor_model.elisa"
include "../../ports/elisa-engine/scripts/gltf_skin_model.elisa"

using EsData
using EsJson
using EsEngineGltfAccessor
using EsEngineGltfSkin


@test
def gltf_skin_reader_decodes_u8_and_u16_joints_and_normalized_weights() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    u8_document: JsonDocument = try parse_document("{\"attributes\":{\"JOINTS_0\":0,\"WEIGHTS_0\":1},\"accessors\":[{\"bufferView\":0,\"componentType\":5121,\"count\":1,\"type\":\"VEC4\"},{\"bufferView\":1,\"componentType\":5126,\"count\":1,\"type\":\"VEC4\"}],\"bufferViews\":[{},{\"byteOffset\":4}]}") else failure:
        _ = failure
        assert false
        JsonDocument{}
    u8_buffer: darray[u8] = [2u8, 4u8, 6u8, 8u8, 0u8, 0u8, 128u8, 62u8, 0u8, 0u8, 128u8, 62u8, 0u8, 0u8, 128u8, 62u8, 0u8, 0u8, 128u8, 62u8]
    u8_attributes: usize = gltf_skin_test_attributes(u8_document)
    u8_influences: SkinInfluences = read_influences(u8_document, u8_buffer, u8_attributes, 1i64)
    assert u8_influences.joints == [2u32, 4u32, 6u32, 8u32]
    assert u8_influences.weights == [0.25f32, 0.25f32, 0.25f32, 0.25f32]

    u16_document: JsonDocument = try parse_document("{\"attributes\":{\"JOINTS_0\":0,\"WEIGHTS_0\":1},\"accessors\":[{\"bufferView\":0,\"componentType\":5123,\"count\":1,\"type\":\"VEC4\"},{\"bufferView\":1,\"componentType\":5126,\"count\":1,\"type\":\"VEC4\"}],\"bufferViews\":[{},{\"byteOffset\":8}]}") else failure:
        _ = failure
        assert false
        JsonDocument{}
    u16_buffer: darray[u8] = [1u8, 1u8, 2u8, 2u8, 3u8, 3u8, 4u8, 4u8, 0u8, 0u8, 128u8, 63u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    u16_attributes: usize = gltf_skin_test_attributes(u16_document)
    u16_influences: SkinInfluences = read_influences(u16_document, u16_buffer, u16_attributes, 1i64)
    assert u16_influences.joints == [257u32, 514u32, 771u32, 1028u32]
    assert u16_influences.weights == [1.0f32, 0.0f32, 0.0f32, 0.0f32]


@test
def gltf_skin_reader_rejects_missing_attributes_shapes_counts_and_formats() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    assert gltf_skin_rejects("{\"attributes\":{\"JOINTS_0\":0},\"accessors\":[{\"bufferView\":0,\"componentType\":5121,\"count\":1,\"type\":\"VEC4\"}],\"bufferViews\":[{}]}", [0u8, 0u8, 0u8, 0u8], 1i64, SkinError.MissingSkinAttributes)
    assert gltf_skin_rejects("{\"attributes\":{\"JOINTS_0\":0,\"WEIGHTS_0\":1},\"accessors\":[{\"bufferView\":0,\"componentType\":5121,\"count\":1,\"type\":\"SCALAR\"},{\"bufferView\":1,\"componentType\":5126,\"count\":1,\"type\":\"VEC4\"}],\"bufferViews\":[{},{\"byteOffset\":1}]}", [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 128u8, 63u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8], 1i64, SkinError.JointAccessorMustBeVec4)
    assert gltf_skin_rejects("{\"attributes\":{\"JOINTS_0\":0,\"WEIGHTS_0\":1},\"accessors\":[{\"bufferView\":0,\"componentType\":5121,\"count\":2,\"type\":\"VEC4\"},{\"bufferView\":1,\"componentType\":5126,\"count\":1,\"type\":\"VEC4\"}],\"bufferViews\":[{},{}]}", [], 1i64, SkinError.InfluenceCountMismatch)
    assert gltf_skin_rejects("{\"attributes\":{\"JOINTS_0\":0,\"WEIGHTS_0\":1},\"accessors\":[{\"bufferView\":0,\"componentType\":5121,\"count\":1,\"type\":\"VEC4\",\"normalized\":true},{\"bufferView\":1,\"componentType\":5126,\"count\":1,\"type\":\"VEC4\"}],\"bufferViews\":[{},{}]}", [], 1i64, SkinError.InvalidJointAccessorFormat)


@test
def gltf_skin_reader_rejects_negative_nonfinite_and_unnormalized_weights() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    negative_weights: darray[u8] = [0u8, 0u8, 128u8, 190u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    assert gltf_skin_rejects(gltf_skin_single_vertex_source(), negative_weights, 1i64, SkinError.InvalidInfluenceWeights)

    nonfinite_weights: darray[u8] = [0u8, 0u8, 192u8, 127u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    assert gltf_skin_rejects(gltf_skin_single_vertex_source(), nonfinite_weights, 1i64, SkinError.InvalidInfluenceWeights)

    unnormalized_weights: darray[u8] = [0u8, 0u8, 0u8, 63u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    assert gltf_skin_rejects(gltf_skin_single_vertex_source(), unnormalized_weights, 1i64, SkinError.InvalidInfluenceWeights)


@test
def gltf_skin_reader_defaults_inverse_bind_matrices_to_identity_and_reads_mat4() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    missing_document: JsonDocument = try parse_document("{\"skins\":[{}],\"accessors\":[],\"bufferViews\":[]}") else failure:
        _ = failure
        assert false
        JsonDocument{}
    identities: darray[f32] = read_inverse_bind_matrices(missing_document, [], 0u, 2i64)
    assert identities == [1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32]

    matrix_document: JsonDocument = try parse_document("{\"skins\":[{\"inverseBindMatrices\":0}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":1,\"type\":\"MAT4\"}],\"bufferViews\":[{}]}") else failure:
        _ = failure
        assert false
        JsonDocument{}
    matrix_bytes: darray[u8] = gltf_skin_identity_matrix_bytes()
    matrix: darray[f32] = read_inverse_bind_matrices(matrix_document, matrix_bytes, 0u, 1i64)
    assert matrix.count == 16
    assert matrix[0] == 1.0f32 and matrix[5] == 1.0f32 and matrix[10] == 1.0f32 and matrix[15] == 1.0f32


@test
def gltf_skin_reader_rejects_nonfinite_nonaffine_and_singular_inverse_bind_matrices() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    nonfinite: mutable darray[u8] = gltf_skin_identity_matrix_bytes()
    nonfinite[0] <- 0u8
    nonfinite[1] <- 0u8
    nonfinite[2] <- 192u8
    nonfinite[3] <- 127u8
    assert gltf_skin_inverse_bind_rejects(nonfinite, SkinError.NonFiniteInverseBindMatrix)

    nonaffine: mutable darray[u8] = gltf_skin_identity_matrix_bytes()
    nonaffine[14] <- 128u8
    nonaffine[15] <- 63u8
    assert gltf_skin_inverse_bind_rejects(nonaffine, SkinError.NonAffineInverseBindMatrix)

    singular: mutable darray[u8] = gltf_skin_identity_matrix_bytes()
    for offset in 0..<4 |singular|:
        singular[offset] <- 0u8
    for offset in 20..<24 |singular|:
        singular[offset] <- 0u8
    for offset in 40..<44 |singular|:
        singular[offset] <- 0u8
    assert gltf_skin_inverse_bind_rejects(singular, SkinError.SingularInverseBindMatrix)


def gltf_skin_rejects(source: sview, buffer: darray[u8], vertex_count: i64, expected: SkinError) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    document: JsonDocument = try parse_document(source) else failure:
        _ = failure
        return false
    attributes: usize = gltf_skin_test_attributes(document)
    rejected: mutable bool = false
    catch read_influences(document, buffer, attributes, vertex_count):
        ok influences:
            _ = influences
        error failure:
            rejected <- failure == expected
    return rejected


def gltf_skin_single_vertex_source() -> sview:
    return "{\"attributes\":{\"JOINTS_0\":0,\"WEIGHTS_0\":1},\"accessors\":[{\"bufferView\":0,\"componentType\":5121,\"count\":1,\"type\":\"VEC4\"},{\"bufferView\":1,\"componentType\":5126,\"count\":1,\"type\":\"VEC4\"}],\"bufferViews\":[{},{\"byteOffset\":4}]}"


def gltf_skin_inverse_bind_rejects(buffer: darray[u8], expected: SkinError) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    source: sview = "{\"skins\":[{\"inverseBindMatrices\":0}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":1,\"type\":\"MAT4\"}],\"bufferViews\":[{}]}"
    document: JsonDocument = try parse_document(source) else failure:
        _ = failure
        return false
    rejected: mutable bool = false
    catch read_inverse_bind_matrices(document, buffer, 0u, 1i64):
        ok matrices:
            _ = matrices
        error failure:
            rejected <- failure == expected
    return rejected


def gltf_skin_identity_matrix_bytes() -> darray[u8]:
    elements: darray[u32] = [1065353216u32, 0u32, 0u32, 0u32, 0u32, 1065353216u32, 0u32, 0u32, 0u32, 0u32, 1065353216u32, 0u32, 0u32, 0u32, 0u32, 1065353216u32]
    bytes: mutable darray[u8] = []
    for value in elements |bytes|:
        bytes.push((value & 255u32).u8())
        bytes.push(((value >> 8) & 255u32).u8())
        bytes.push(((value >> 16) & 255u32).u8())
        bytes.push((value >> 24).u8())
    return bytes


def gltf_skin_test_attributes(document: JsonDocument&) -> usize:
    root_index: usize = document.roots[0]
    root: JsonNode = document.nodes[root_index]
    for ordinal in 0..<root.member_count |document, root|:
        member: JsonMember = document.members[root.member_start + ordinal]
        if member.key_bytes == 10:
            matches: mutable bool = true
            for offset in 0..<10 |document, member, matches|:
                matches <- false if document.key_bytes[member.key_start + offset] != sview_at("attributes", offset.i64())
            return member.value_index if matches
    return JSON_INDEX_NONE
