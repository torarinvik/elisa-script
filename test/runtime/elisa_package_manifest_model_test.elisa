include "../../ports/elisa-engine/scripts/elisa_package_manifest_model.elisa"

using EsElisaPackageManifest


def package_manifest_rejects(dependencies: darray[sview], expected: ManifestError) -> bool can[Memory.Allocate, Abort.Panic]:
    observed: mutable bool = false
    catch manifest_bytes(dependencies):
        ok bytes:
            _ = bytes
        error failure:
            observed <- failure == expected
    return observed


@test
def package_manifest_sorts_dependencies_and_emits_the_v1_header() -> void can[Memory.Allocate, Abort.Panic]:
    manifest: darray[u8] = try manifest_bytes(["z", "assets/albedo.png", "a/b"])
    assert bytes_view(manifest) == "ELISA-PACKAGE-MANIFEST-1\ndependency=a/b\ndependency=assets/albedo.png\ndependency=z\n"


@test
def package_manifest_enforces_dependency_count_uniqueness_and_path_safety() -> void can[Memory.Allocate, Abort.Panic]:
    assert package_manifest_rejects(["same", "same"], ManifestError.DependencyCountOrUniquenessRejected)
    assert package_manifest_rejects(["../outside", "../outside"], ManifestError.DependencyCountOrUniquenessRejected)
    assert package_manifest_rejects([
        "d0", "d1", "d2", "d3", "d4", "d5", "d6", "d7", "d8",
        "d9", "d10", "d11", "d12", "d13", "d14", "d15", "d16"
    ], ManifestError.DependencyCountOrUniquenessRejected)
    assert package_manifest_rejects(["assets/../outside"], ManifestError.UnsafeDependencyPath)
    assert package_manifest_rejects(["assets/imagé.png"], ManifestError.NonAsciiDependency)


@test
def package_manifest_preserves_historical_line_break_encoding() -> void can[Memory.Allocate, Abort.Panic]:
    manifest: darray[u8] = try manifest_bytes(["line\nbreak"])
    assert bytes_view(manifest) == "ELISA-PACKAGE-MANIFEST-1\ndependency=line\nbreak\n"


@test
def package_manifest_enforces_the_dependency_line_bound() -> void can[Memory.Allocate, Abort.Panic]:
    long_path_bytes: mutable darray[u8] = []
    for _ in 0..<245 |long_path_bytes|:
        long_path_bytes.push(97u8)
    long_path: sview = bytes_view(long_path_bytes)
    assert package_manifest_rejects([long_path], ManifestError.ManifestLineTooLarge)
