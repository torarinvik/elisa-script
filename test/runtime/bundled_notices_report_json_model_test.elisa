include "../../ports/elisa-engine/scripts/bundled_notices_report_json_model.elisa"

using EsEngineBundledNoticesAudit
using EsEngineBundledNoticesReportJson


@test
def bundled_notice_report_json_matches_python_indent_and_ascii_escaping() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    report: Report = Report{
        catalog_complete: true,
        dylib_notice_files_verified: false,
        libraries: [LibraryReport{library: "libé.dylib", notices: ["Example"], problems: ["line\nbreak"]}]
    }
    encoded: darray[u8] = try encode_report(report) else failure:
        _ = failure
        assert false
        []
    expected: sview = "{\n  \"schema\": 1,\n  \"catalog_complete\": true,\n  \"dylib_notice_files_verified\": false,\n  \"libraries\": [\n    {\n      \"library\": \"lib\\u00e9.dylib\",\n      \"notices\": [\n        \"Example\"\n      ],\n      \"problems\": [\n        \"line\\nbreak\"\n      ]\n    }\n  ],\n  \"remaining\": []\n}\n"
    assert bytes_view(encoded) == expected


@test
def bundled_notice_report_json_keeps_empty_collections_compact() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    encoded: darray[u8] = try encode_report(Report{}) else failure:
        _ = failure
        assert false
        []
    expected: sview = "{\n  \"schema\": 1,\n  \"catalog_complete\": false,\n  \"dylib_notice_files_verified\": false,\n  \"libraries\": [],\n  \"remaining\": []\n}\n"
    assert bytes_view(encoded) == expected
