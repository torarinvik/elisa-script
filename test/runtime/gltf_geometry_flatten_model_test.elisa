include "../../ports/elisa-engine/scripts/gltf_geometry_flatten_model.elisa"

using EsEngineGltfAffine
using EsEngineGltfGeometryAssembly
using EsEngineGltfGeometryFlatten
using EsEngineGltfNodeGraph
using EsEngineGltfPrimitivePlacement
using EsEngineGltfSkin
using EsEngineGltfVertexStreams


def append_flatten_test_f32(output: mutable darray[u8]&, value: f32) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    bits: mutable u32 = 0u32
    _ = memcpy((&bits).cast[mutable void&], (&value).cast[void&], 4)
    output.push((bits & 255u32).u8())
    output.push(((bits >> 8) & 255u32).u8())
    output.push(((bits >> 16) & 255u32).u8())
    output.push((bits >> 24).u8())


def append_flatten_test_vertex(output: mutable darray[u8]&, source: darray[u8]&, vertex: usize, stride: usize) -> void can[Memory.Allocate, Abort.Panic]:
    for offset in 0..<stride |output, source, vertex|:
        output.push(source[vertex * stride + offset])


def seam_split_fixture() -> (GeometryPlacementSet, MikkBlockResult) can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    positions: mutable darray[u8] = []
    for value in [0.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32, 1.0f32, 1.0f32, 0.0f32]:
        try append_flatten_test_f32(positions, value)
    normals: mutable darray[u8] = []
    for _ in 0..<4 |normals|:
        try append_flatten_test_f32(normals, 0.0f32)
        try append_flatten_test_f32(normals, 0.0f32)
        try append_flatten_test_f32(normals, 1.0f32)
    uvs: mutable darray[u8] = []
    for value in [0.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32, 1.0f32, -1.0f32, 1.0f32]:
        try append_flatten_test_f32(uvs, value)

    uv1s: mutable darray[u8] = []
    morph_positions: mutable darray[u8] = []
    joints: mutable darray[u32] = []
    weights: mutable darray[f32] = []
    for vertex in 0..<4 |uv1s, morph_positions, joints, weights|:
        uv1s.push((10u32 + vertex.u32()).u8())
        morph_positions.push((20u32 + vertex.u32()).u8())
        for _ in 0..<7 |uv1s|:
            uv1s.push(0u8)
        for _ in 0..<11 |morph_positions|:
            morph_positions.push(0u8)
        for lane in 0..<4 |vertex, joints, weights|:
            joints.push((vertex * 4 + lane).u32())
            weights.push(1.0f32 if lane == 0 else 0.0f32)

    vertices: VertexStreams = VertexStreams{
        positions: positions,
        has_normals: true,
        normals: normals,
        uvs: uvs,
        has_uv1s: true,
        uv1s: uv1s,
        has_skin: true,
        skin: SkinInfluences{joints: joints, weights: weights},
        morph_targets: [MorphTargetStreams{positions: morph_positions}],
        count: 4u
    }
    block: GeometryBlock = GeometryBlock{
        vertices: vertices,
        triangles: [0u32, 1u32, 2u32, 1u32, 3u32, 2u32],
        source_key: VertexSourceKey{position_accessor: 0i64}
    }
    placement_geometry: PlacementAssembly = PlacementAssembly{
        matrix: Affine3x4{m00: 1.0, m11: 1.0, m22: 1.0},
        vertex_budget: EsEngineGltfGeometryAssembly::Limits::MAX_VERTICES,
        index_budget: EsEngineGltfGeometryAssembly::Limits::MAX_INDICES,
        skin_binding: PlacementSkinBinding{kind: PlacementSkinBindingKind.Palette, palette_count: 4u},
        blocks: [block],
        primitives: [
            PlacedPrimitive{block_index: 0u, indices: [0u32, 1u32, 2u32], material_index: 4u},
            PlacedPrimitive{block_index: 0u, indices: [1u32, 3u32, 2u32], material_index: 4u}
        ],
        source_vertex_count: 4u,
        index_count: 6u,
        has_morph_shape: true,
        morph_target_count: 1u
    }
    geometry: GeometryPlacementSet = GeometryPlacementSet{
        placements: [AssembledMeshPlacement{
            placement: MeshPlacement{mesh_index: 0u, node_index: 0u, has_skin: true},
            effective_transform: Affine3x4{m00: 1.0, m11: 1.0, m22: 1.0},
            geometry: placement_geometry
        }],
        source_vertex_count: 4u,
        index_count: 6u,
        has_skin_streams: true,
        has_morph_shape: true,
        morph_target_count: 1u,
        morph_normals_present: false
    }

    source_vertices: darray[u32] = [0u32, 1u32, 2u32, 1u32, 3u32, 2u32]
    cooked_positions: mutable darray[u8] = []
    cooked_normals: mutable darray[u8] = []
    cooked_uvs: mutable darray[u8] = []
    for source_vertex in source_vertices |source_vertices, positions, normals, uvs, cooked_positions, cooked_normals, cooked_uvs|:
        append_flatten_test_vertex(cooked_positions, positions, source_vertex.usize(), 12u)
        append_flatten_test_vertex(cooked_normals, normals, source_vertex.usize(), 12u)
        append_flatten_test_vertex(cooked_uvs, uvs, source_vertex.usize(), 8u)

    tangents: mutable darray[u8] = []
    for _ in 0..<6 |tangents|:
        try append_flatten_test_f32(tangents, 1.0f32)
        try append_flatten_test_f32(tangents, 0.0f32)
        try append_flatten_test_f32(tangents, 0.0f32)
        try append_flatten_test_f32(tangents, 1.0f32)
    mikk: MikkBlockResult = MikkBlockResult{
        placement_index: 0u,
        block_index: 0u,
        positions: cooked_positions,
        normals: cooked_normals,
        uvs: cooked_uvs,
        tangents: tangents,
        indices: [0u32, 1u32, 2u32, 3u32, 4u32, 5u32],
        source_vertices: source_vertices
    }
    return (geometry, mikk)


@test
def flattening_applies_mikktspace_seams_to_all_dependent_streams() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    fixture: (GeometryPlacementSet, MikkBlockResult) = seam_split_fixture()
    geometry: GeometryPlacementSet = fixture.0
    mikk_results: darray[MikkBlockResult] = [fixture.1]
    flattened: FlattenedGeometry = try flatten_geometry(geometry, mikk_results) else failure:
        _ = failure
        assert false
        FlattenedGeometry{}

    assert flattened.vertex_count == 6u and flattened.index_count == 6u
    assert flattened.positions.count == 72 and flattened.normals.count == 72 and flattened.tangents.count == 96 and flattened.uvs.count == 48
    assert flattened.has_uv1s and flattened.uv1s.count == 48
    assert flattened.has_skin_streams and flattened.skin_indices.count == 24 and flattened.skin_weights.count == 24
    assert flattened.skin_indices[12] == 4u32 and flattened.skin_weights[12] == 1.0f32
    assert flattened.uv1s[24] == 11u8
    assert flattened.morph_targets.count == 1 and flattened.morph_targets[0].positions.count == 72
    assert flattened.morph_targets[0].positions[36] == 21u8 and not flattened.morph_targets[0].has_normals
    assert flattened.indices == [0u32, 1u32, 2u32, 3u32, 4u32, 5u32]
    assert flattened.subsets.count == 1 and flattened.subsets[0].index_start == 0u and flattened.subsets[0].index_count == 6u and flattened.subsets[0].material_slot == 4u
    assert flattened.placements.count == 1 and flattened.placements[0].has_vertex_start and flattened.placements[0].vertex_start == 0u and flattened.placements[0].vertex_count == 6u
    assert flattened.placements[0].has_index_start and flattened.placements[0].index_start == 0u and flattened.placements[0].index_count == 6u
    assert flattened.placements[0].has_subset_start and flattened.placements[0].subset_start == 0u and flattened.placements[0].subset_count == 1u
