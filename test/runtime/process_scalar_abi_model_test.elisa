# Pure scalar fixtures; no libc declaration or process runner is imported.
include "../../src/runtime/process_scalar_abi_model.elisa"
include "../../src/runtime/process_spawn_wait_model.elisa"

using EsProcessScalarAbi


@test
def process_c_int_admission_preserves_signed_boundaries() -> void:
    assert fits(-2147483648i64) and fits(2147483647i64)
    assert fits(-1i64) and fits(0i64) and fits(41i64)
    assert not fits(-2147483649i64) and not fits(2147483648i64)
    assert not fits(-9223372036854775807i64) and not fits(9223372036854775807i64)


@test
def process_native_error_widening_remains_negative() -> void:
    failed: i32 = -1i32
    successful_pid: i32 = 41i32
    assert failed.int() == -1 and failed.int() < 0
    assert successful_pid.int() == 41
    minimum: i32 = -2147483647i32 - 1i32
    maximum: i32 = 2147483647i32
    assert minimum.int() == -2147483648i64 and maximum.int() == 2147483647i64


@test
def process_scalar_rejection_cannot_consume_stale_interrupted_errno() -> void:
    assert Limits::REJECTED == -2
    assert not native_errno_failure(Limits::REJECTED.i64())
    assert EsProcessSpawnWait::uncertain_negative_wait(Limits::REJECTED.i64(), 4)
    assert EsProcessSpawnWait::negative_failure(Limits::REJECTED.i64(), 4) == EsProcessSpawnWait::NegativeFailure.Unknown


@test
def process_scalar_errno_is_admitted_only_for_native_minus_one() -> void:
    assert native_errno_failure(-1)
    assert not native_errno_failure(-2) and not native_errno_failure(-3)
    assert not native_errno_failure(0) and not native_errno_failure(41)
    assert not native_errno_failure(1) and not native_errno_failure(4294967295i64)
    assert not native_errno_failure(-2147483648i64)


@test
def process_exit_status_uses_only_low_eight_bits() -> void:
    assert exit_byte(0) == 0i32 and exit_byte(255) == 255i32
    assert exit_byte(256) == 0i32 and exit_byte(511) == 255i32
    assert exit_byte(-1) == 255i32 and exit_byte(-256) == 0i32
    assert exit_byte(9223372036854775807i64) == 255i32


@test
def native_error_receipts_require_minus_one_and_positive_errno() -> void:
    assert native_error_observation(-1i64, 4i32)
    assert native_error_observation(-1i64, 13i32)
    assert native_error_observation(-1i64, 2147483647i32)
    assert not native_error_observation(-1i64, 0i32)
    assert not native_error_observation(-1i64, -1i32)
    assert not native_error_observation(-1i64, -2147483647i32 - 1i32)
    can Memory.Allocate, Abort.Panic:
        # Includes both C-int and Darwin ssize_t invalid return boundaries.
        for returned in [-9223372036854775807i64 - 1i64, -2147483648i64, -2i64, 0i64, 1i64, 4294967295i64, 9223372036854775807i64]:
            assert not native_error_observation(returned, 4i32)
            assert not native_error_observation(returned, 13i32)


@test
def unsupported_negative_waits_cannot_retry_from_stale_errno() -> void:
    can Memory.Allocate, Abort.Panic:
        for returned in [-2i64, -3i64, -2147483648i64, -9223372036854775807i64 - 1i64]:
            assert not native_errno_failure(returned)
            for code in [0i64, 4i64, 10i64, 13i64, 22i64]:
                assert EsProcessSpawnWait::negative_failure(returned, code) == EsProcessSpawnWait::NegativeFailure.Unknown
                assert EsProcessSpawnWait::uncertain_negative_wait(returned, code)
        assert native_errno_failure(-1i64)
        assert not EsProcessSpawnWait::uncertain_negative_wait(-1i64, 4i64)
