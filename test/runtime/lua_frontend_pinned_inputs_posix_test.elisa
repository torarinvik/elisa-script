include "../../src/ir/ir.elisa"
include "../../src/testing/lua_frontend_pinned_inputs.elisa"
include "../../src/testing/lua_frontend_pinned_inputs_posix.elisa"

using EsBuildIncrementalPosix
using EsLuaFrontendPinnedInputsPosix
using EsRuntime


@test
def lua_frontend_pinned_input_adapter_rejects_invalid_root_before_reading() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        arena: mutable Arena = zeroed
        rejected: mutable bool = false
        catch verify_lua_frontend_pinned_inputs_at(arena, -1, "test/fixtures/script_parity/lua_frontend_differential/REFERENCE_INPUTS.sha256", -1):
            ok verification:
                _ = verification
            error failure:
                rejected <- failure == OpenError.InvalidDirectoryDescriptor
        assert rejected


@test
def lua_frontend_pinned_input_adapter_rejects_escaping_manifest_path_before_io() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        arena: mutable Arena = zeroed
        rejected: mutable bool = false
        catch verify_lua_frontend_pinned_inputs_at(arena, -1, "../REFERENCE_INPUTS.sha256", -1):
            ok verification:
                _ = verification
            error failure:
                rejected <- failure == OpenError.InvalidPath
        assert rejected
