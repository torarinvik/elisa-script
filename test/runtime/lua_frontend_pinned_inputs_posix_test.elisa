include "../../src/ir/ir.elisa"
include "../../src/testing/lua_frontend_pinned_inputs.elisa"
include "../../src/testing/lua_frontend_pinned_inputs_posix.elisa"

using EsLuaFrontendPinnedInputs
using EsLuaFrontendPinnedInputsPosix
using EsRuntime


@test
def lua_frontend_pinned_input_adapter_rejects_invalid_root_before_reading() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        arena: mutable Arena = zeroed
        rejected: mutable bool = false
        invalid_root: LuaFrontendPinRootCapability = LuaFrontendPinRootCapability{path: "/", descriptor: -1}
        catch verify_lua_frontend_pinned_inputs(arena, invalid_root, "test/fixtures/script_parity/lua_frontend_differential/REFERENCE_INPUTS.sha256", invalid_root):
            ok verification:
                _ = verification
            error failure:
                rejected <- failure == LuaFrontendPinReadError.InvalidRootCapability("/")
        assert rejected


@test
def lua_frontend_pinned_input_adapter_rejects_noncanonical_root_before_io() -> void:
    can Blocking.IO:
        rejected: mutable bool = false
        catch open_lua_frontend_pin_root("/tmp/../outside"):
            ok root:
                _ = root
            error failure:
                rejected <- failure == LuaFrontendPinReadError.InvalidAbsoluteRoot
        assert rejected


@test
def lua_frontend_pinned_input_root_pair_closes_first_root_when_second_open_fails() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        arena: mutable Arena = zeroed
        rejected: mutable bool = false
        catch verify_lua_frontend_pinned_inputs_from_roots(arena, "/", "REFERENCE_INPUTS.sha256", "/tmp/../outside"):
            ok verification:
                _ = verification
            error failure:
                rejected <- failure == LuaFrontendPinReadError.InvalidAbsoluteRoot
        assert rejected
