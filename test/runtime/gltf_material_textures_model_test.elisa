include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../ports/elisa-engine/scripts/gltf_material_textures_model.elisa"

using EsEngineGltfMaterialFactors
using EsEngineGltfMaterialTextures
using EsJson


def material_textures_reject(source: sview) bool can[Memory.Allocate, Abort.Panic]:
    document: JsonDocument = try parse_document(source) else failure:
        _ = failure
        return false
    rejected: mutable bool = false
    catch document_material_textures(document):
        ok plan:
            _ = plan
        error failure:
            _ = failure
            rejected <- true
    return rejected


@test
def gltf_material_textures_resolve_fixed_slots_basis_sampler_and_sidecars() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    source: sview = "{\"extensionsUsed\":[\"KHR_materials_clearcoat\",\"KHR_texture_basisu\"],\"materials\":[{\"pbrMetallicRoughness\":{\"baseColorTexture\":{\"index\":0},\"metallicRoughnessTexture\":{\"index\":0}},\"normalTexture\":{\"index\":0,\"scale\":-2},\"emissiveTexture\":{\"index\":0},\"occlusionTexture\":{\"index\":0,\"strength\":0.25},\"extensions\":{\"KHR_materials_clearcoat\":{\"clearcoatFactor\":0.5,\"clearcoatRoughnessFactor\":0.25,\"clearcoatTexture\":{\"index\":0},\"clearcoatRoughnessTexture\":{\"index\":0},\"clearcoatNormalTexture\":{\"index\":0,\"scale\":2}}}}],\"textures\":[{\"source\":0,\"sampler\":0,\"extensions\":{\"KHR_texture_basisu\":{\"source\":0,\"source\":1}}}],\"images\":[{},{}],\"samplers\":[{\"magFilter\":9729,\"minFilter\":9987,\"wrapS\":10497,\"wrapT\":10497}]}"
    document: JsonDocument = try parse_document(source) else failure:
        _ = failure
        assert false
        JsonDocument{}
    plan: MaterialTexturePlan = document_material_textures(document)
    assert plan.materials.count == 1
    assert plan.materials[0].image_indices == [1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u]
    assert plan.materials[0].has_any_texture and plan.materials[0].occlusion_enabled
    assert plan.materials[0].factors.normal_scale == -2.0
    assert plan.materials[0].factors.occlusion_strength == 0.25
    assert plan.materials[0].factors.clearcoat_factor == 0.5
    assert plan.materials[0].factors.clearcoat_roughness == 0.25
    assert plan.materials[0].factors.clearcoat_normal_scale == 2.0
    assert plan.sidecars.normal_scales == [0u8, 0u8, 0u8, 192u8]
    assert plan.sidecars.occlusion_strengths == [0u8, 0u8, 128u8, 62u8]
    assert plan.sidecars.clearcoat_factors == [0u8, 0u8, 0u8, 63u8, 0u8, 0u8, 128u8, 62u8, 0u8, 0u8, 0u8, 64u8]


@test
def gltf_material_textures_accept_empty_objects_and_default_sampler_values() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    document: JsonDocument = try parse_document("{\"materials\":[{\"pbrMetallicRoughness\":{},\"normalTexture\":{\"index\":0}}],\"textures\":[{\"source\":0,\"sampler\":0,\"extensions\":{}}],\"images\":[{}],\"samplers\":[{}]}") else failure:
        _ = failure
        assert false
        JsonDocument{}
    plan: MaterialTexturePlan = document_material_textures(document)
    assert plan.materials.count == 1 and plan.materials[0].image_indices.count == Limits::SLOT_COUNT
    assert plan.materials[0].image_indices[Slot::BASE_COLOR] == JSON_INDEX_NONE
    assert plan.materials[0].image_indices[Slot::NORMAL] == 0u
    assert plan.materials[0].factors.normal_scale == 1.0
    assert plan.sidecars.normal_scales.count == 0 and plan.sidecars.occlusion_strengths.count == 0 and plan.sidecars.clearcoat_factors.count == 0


@test
def gltf_material_textures_reject_bad_references_sampling_and_factors() -> void can[Memory.Allocate, Abort.Panic]:
    assert material_textures_reject("{\"materials\":[{\"pbrMetallicRoughness\":{\"baseColorTexture\":{\"index\":0,\"texCoord\":1}}}],\"textures\":[{\"source\":0}],\"images\":[{}]}")
    assert material_textures_reject("{\"materials\":[{\"normalTexture\":{\"index\":0,\"unknown\":1}}],\"textures\":[{\"source\":0}],\"images\":[{}]}")
    assert material_textures_reject("{\"materials\":[{\"emissiveTexture\":{\"index\":1}}],\"textures\":[{\"source\":0}],\"images\":[{}]}")
    assert material_textures_reject("{\"materials\":[{\"occlusionTexture\":{\"index\":0,\"strength\":1.01}}],\"textures\":[{\"source\":0}],\"images\":[{}]}")
    assert material_textures_reject("{\"materials\":[{\"normalTexture\":{\"index\":0,\"scale\":65505}}],\"textures\":[{\"source\":0}],\"images\":[{}]}")
    assert material_textures_reject("{\"materials\":[{\"baseColorTexture\":{\"index\":0}}],\"textures\":[{\"source\":0,\"sampler\":0}],\"images\":[{}],\"samplers\":[{\"magFilter\":true}]}")
    assert material_textures_reject("{\"materials\":[{\"emissiveTexture\":{\"index\":0}}],\"textures\":[{\"source\":0,\"extensions\":{\"OTHER\":{}}}],\"images\":[{}]}")
    assert material_textures_reject("{\"materials\":[{\"alphaMode\":\"MASK\"}]}")
