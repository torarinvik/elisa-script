# Pure policy fixtures. No child kernel, native symbol or subprocess is called.
include "../../src/runtime/process_exec_search_model.elisa"

using EsProcessExecSearch


def returned_exec_failure_tag(result: i64, errno: i32) -> i64:
    return catch classify_returned_exec(result, errno):
        returned:
            _ = returned
            0i64
        ReturnedExecError.NotFound(_):
            1i64
        ReturnedExecError.AccessDenied(_):
            2i64
        ReturnedExecError.OtherFailure(_):
            3i64
        ReturnedExecError.InvalidErrno(_):
            4i64
        ReturnedExecError.InvalidBridgeReturn(_):
            5i64


def returned_exec_failure_payload(result: i64, errno: i32) -> i64:
    return catch classify_returned_exec(result, errno):
        returned:
            _ = returned
            -1i64
        ReturnedExecError.NotFound(code):
            code.i64()
        ReturnedExecError.AccessDenied(code):
            code.i64()
        ReturnedExecError.OtherFailure(code):
            code.i64()
        ReturnedExecError.InvalidErrno(code):
            code.i64()
        ReturnedExecError.InvalidBridgeReturn(returned):
            returned


@test
def streaming_exec_search_advances_only_for_missing_path_components() -> void:
    assert after_failure(DarwinErrno::ENOENT) == Action.Next
    assert after_failure(DarwinErrno::ENOTDIR) == Action.Next
    assert after_failure(DarwinErrno::EACCES) == Action.NextDenied


@test
def streaming_exec_search_stops_on_format_resource_and_unrecognized_errors() -> void:
    can Memory.Allocate, Abort.Panic:
        assert after_failure(DarwinErrno::ENOEXEC) == Action.Stop
        assert after_failure(DarwinErrno::EINTR) == Action.Stop
        # SDK errno values: EIO=5, E2BIG=7, ENOMEM=12, ETXTBSY=26.
        for failure in [0i32, -1i32, 5i32, 7i32, 12i32, 26i32, 2147483647i32]:
            assert after_failure(failure) == Action.Stop


@test
def streaming_exec_search_remembers_access_denial_when_candidates_exhaust() -> void:
    assert exhausted_status(false) == 127i32
    assert exhausted_status(true) == 126i32
    assert fatal_status() == 126i32


@test
def streaming_exec_search_missing_after_denial_does_not_clear_denial() -> void:
    can Memory.Allocate, Abort.Panic:
        saw_denied: mutable bool = false
        for failure in [DarwinErrno::ENOENT, DarwinErrno::EACCES, DarwinErrno::ENOTDIR, DarwinErrno::ENOENT] |saw_denied|:
            action: Action = after_failure(failure)
            assert action != Action.Stop
            saw_denied <- true if action == Action.NextDenied
        assert exhausted_status(saw_denied) == 126i32


@test
def returned_exec_missing_is_distinct_from_denied_and_other_native_failures() -> void:
    assert returned_exec_status(-1i64, DarwinErrno::ENOENT) == 127i32
    assert returned_exec_status(-1i64, DarwinErrno::ENOTDIR) == 127i32
    assert returned_exec_status(-1i64, DarwinErrno::EACCES) == 126i32
    assert returned_exec_status(-1i64, DarwinErrno::ENOEXEC) == 126i32
    assert returned_exec_status(-1i64, DarwinErrno::EINTR) == 126i32
    assert returned_exec_status(-1i64, 0i32) == 126i32
    assert returned_exec_status(-1i64, 2147483647i32) == 126i32


@test
def returned_exec_unexpected_results_do_not_use_stale_errno() -> void:
    can Memory.Allocate, Abort.Panic:
        for returned in [-2147483648i64, -2i64, 0i64, 1i64, 2147483647i64, 4294967295i64, 9223372036854775807i64]:
            assert returned_exec_status(returned, DarwinErrno::ENOENT) == 126i32
            assert returned_exec_status(returned, DarwinErrno::ENOTDIR) == 126i32


@test
def returned_exec_failure_classification_preserves_native_cause() -> void:
    assert returned_exec_failure_tag(-1i64, DarwinErrno::ENOENT) == 1i64
    assert returned_exec_failure_payload(-1i64, DarwinErrno::ENOENT) == DarwinErrno::ENOENT.i64()
    assert returned_exec_status(-1i64, DarwinErrno::ENOENT) == 127i32

    assert returned_exec_failure_tag(-1i64, DarwinErrno::ENOTDIR) == 1i64
    assert returned_exec_failure_payload(-1i64, DarwinErrno::ENOTDIR) == DarwinErrno::ENOTDIR.i64()
    assert returned_exec_status(-1i64, DarwinErrno::ENOTDIR) == 127i32

    assert returned_exec_failure_tag(-1i64, DarwinErrno::EACCES) == 2i64
    assert returned_exec_failure_payload(-1i64, DarwinErrno::EACCES) == DarwinErrno::EACCES.i64()
    assert returned_exec_status(-1i64, DarwinErrno::EACCES) == 126i32

    assert returned_exec_failure_tag(-1i64, DarwinErrno::ENOEXEC) == 3i64
    assert returned_exec_failure_payload(-1i64, DarwinErrno::ENOEXEC) == DarwinErrno::ENOEXEC.i64()
    assert returned_exec_status(-1i64, DarwinErrno::ENOEXEC) == 126i32


@test
def returned_exec_invalid_observations_never_claim_a_native_cause() -> void:
    assert returned_exec_failure_tag(127i64, DarwinErrno::ENOENT) == 5i64
    assert returned_exec_failure_payload(127i64, DarwinErrno::ENOENT) == 127i64
    assert returned_exec_status(127i64, DarwinErrno::ENOENT) == 126i32

    assert returned_exec_failure_tag(-1i64, 0i32) == 4i64
    assert returned_exec_failure_payload(-1i64, 0i32) == 0i64
    assert returned_exec_status(-1i64, 0i32) == 126i32

    assert returned_exec_failure_tag(-1i64, -1i32) == 4i64
    assert returned_exec_failure_payload(-1i64, -1i32) == -1i64
    assert returned_exec_status(-1i64, -1i32) == 126i32
