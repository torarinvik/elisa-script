include "../../ports/elisa-engine/scripts/fbx_material_cooker_self_test_model.elisa"

using EsBase64
using EsEngineFbxMaterialSelfTest


def append_test_u32_le(output: mutable darray[u8]&, value: u32) -> void can[Memory.Allocate, Abort.Panic]:
    output.push((value & 255u32).u8())
    output.push(((value >> 8) & 255u32).u8())
    output.push(((value >> 16) & 255u32).u8())
    output.push(((value >> 24) & 255u32).u8())


def append_test_f32_le(output: mutable darray[u8]&, value: f32) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    bits: mutable u32 = 0u32
    _ = memcpy((&bits).cast[mutable void&], (&value).cast[void&], 4)
    try append_test_u32_le(output, bits)


def sample_material_bytes() -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    factors: darray[f32] = [0.16f32, 0.32f32, 0.48f32, 0.75f32, 0.0f32, 0.434315f32, 0.3f32, 0.2f32, 0.1f32, 0.5f32, 0.7f32, 0.2f32, 0.1f32, 1.0f32, 0.0f32, 0.65359f32, 0.0f32, 0.0f32, 0.0f32, 0.5f32]
    tags: darray[u32] = [2u32, 0u32, 0u32, 0u32]
    bytes: mutable darray[u8] = []
    for record_index in 0..<2 |factors, tags, bytes|:
        for factor_index in 0..<10 |factors, record_index, bytes|:
            try append_test_f32_le(bytes, factors[record_index * 10 + factor_index])
        for tag_index in 0..<2 |tags, record_index, bytes|:
            try append_test_u32_le(bytes, tags[record_index * 2 + tag_index])
    return bytes


def sample_name_bytes() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    bytes: mutable darray[u8] = []
    try append_test_u32_le(bytes, 5u32)
    for byte in "First" |bytes|:
        bytes.push(byte)
    try append_test_u32_le(bytes, 6u32)
    for byte in "Second" |bytes|:
        bytes.push(byte)
    return bytes


def sample_material_fields(materials: darray[u8], names: darray[u8]) -> darray[CookedField] can[Memory.Allocate, Abort.Panic]:
    return [
        CookedField{name: "slot_material_stride", value: "48"},
        CookedField{name: "slot_materials_b64", value: bytes_view(encode_base64(bytes_view(materials)))},
        CookedField{name: "slot_material_names_b64", value: bytes_view(encode_base64(bytes_view(names)))}
    ]


def material_validation_rejects(fields: darray[CookedField], expected: FbxMaterialSelfTestError) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    observed: mutable bool = false
    catch validate_material_package(fields):
        ok:
            return false
        error failure:
            observed <- failure == expected
    return observed


@test
def material_cooker_helper_accepts_the_ordered_two_record_fixture() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    fields: darray[CookedField] = sample_material_fields(sample_material_bytes(), sample_name_bytes())
    try validate_material_package(fields)


@test
def material_cooker_helper_rejects_factor_changes_and_invalid_base64() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    materials: mutable darray[u8] = sample_material_bytes()
    materials[0] <- 0u8
    materials[1] <- 0u8
    materials[2] <- 0u8
    materials[3] <- 0u8
    changed: darray[CookedField] = sample_material_fields(materials, sample_name_bytes())
    assert material_validation_rejects(changed, FbxMaterialSelfTestError.MaterialPackageMismatch)

    invalid_base64: mutable darray[CookedField] = sample_material_fields(sample_material_bytes(), sample_name_bytes())
    invalid_base64[1] <- CookedField{name: "slot_materials_b64", value: "%%"}
    assert material_validation_rejects(invalid_base64, FbxMaterialSelfTestError.InvalidBase64)


@test
def material_cooker_helper_rejects_stride_and_invalid_utf8_names() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    wrong_stride: mutable darray[CookedField] = sample_material_fields(sample_material_bytes(), sample_name_bytes())
    wrong_stride[0] <- CookedField{name: "slot_material_stride", value: "44"}
    assert material_validation_rejects(wrong_stride, FbxMaterialSelfTestError.MaterialPackageMismatch)

    invalid_names: mutable darray[u8] = []
    try append_test_u32_le(invalid_names, 1u32)
    invalid_names.push(255u8)
    try append_test_u32_le(invalid_names, 1u32)
    invalid_names.push(65u8)
    malformed_names: darray[CookedField] = sample_material_fields(sample_material_bytes(), invalid_names)
    assert material_validation_rejects(malformed_names, FbxMaterialSelfTestError.InvalidNameUtf8)


@test
def material_cooker_helper_checks_integer_tags_and_name_order() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    wrong_tags: mutable darray[u8] = sample_material_bytes()
    wrong_tags[40] <- 0u8
    tag_fields: darray[CookedField] = sample_material_fields(wrong_tags, sample_name_bytes())
    assert material_validation_rejects(tag_fields, FbxMaterialSelfTestError.MaterialPackageMismatch)

    reversed_names: mutable darray[u8] = []
    try append_test_u32_le(reversed_names, 6u32)
    for byte in "Second" |reversed_names|:
        reversed_names.push(byte)
    try append_test_u32_le(reversed_names, 5u32)
    for byte in "First" |reversed_names|:
        reversed_names.push(byte)
    name_fields: darray[CookedField] = sample_material_fields(sample_material_bytes(), reversed_names)
    assert material_validation_rejects(name_fields, FbxMaterialSelfTestError.MaterialPackageMismatch)
