include "../../ports/elisa-engine/scripts/bundled_notices_cli_model.elisa"

using EsEngineBundledNoticesCli


@test
def bundled_notice_cli_accepts_separate_and_joined_options_and_last_value_wins() -> void can[Memory.Allocate, Abort.Panic]:
    parsed: ParseResult = parse_options(["--app", "first.app", "--catalog=first.json", "--output", "report.json", "--app=last.app"])
    assert parsed.failure == CliFailure.None
    assert parsed.options.has_app and parsed.options.app == "last.app"
    assert parsed.options.has_catalog and parsed.options.catalog == "first.json"
    assert parsed.options.has_output and parsed.options.output == "report.json"


@test
def bundled_notice_cli_handles_help_and_reports_missing_or_unknown_arguments() -> void can[Memory.Allocate, Abort.Panic]:
    help: ParseResult = parse_options(["--help"])
    assert help.failure == CliFailure.HelpRequested
    missing: ParseResult = parse_options(["--catalog", "catalog.json"])
    assert missing.failure == CliFailure.MissingApp
    value_missing: ParseResult = parse_options(["--app"])
    assert value_missing.failure == CliFailure.MissingOptionValue
    unknown: ParseResult = parse_options(["--wat"])
    assert unknown.failure == CliFailure.UnknownOption and unknown.detail == "--wat"
    extra: ParseResult = parse_options(["bundle.app"])
    assert extra.failure == CliFailure.UnexpectedArgument and extra.detail == "bundle.app"
