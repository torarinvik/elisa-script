include "../../src/runtime/macos_app_copy_posix.elisa"

using EsMacosAppCopyPosix


@test
def copies_file_data_metadata_and_dereferences_source_links() -> void can[Blocking.IO, File.Read, File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
    temporary: Path = try temp_directory("macos-app-file-copy") else err:
        assert false
        return
    source: Path = temporary.joinpath("source.bin")
    link: Path = temporary.joinpath("source-link.bin")
    copied: Path = temporary.joinpath("copied.bin")
    copied_from_link: Path = temporary.joinpath("copied-from-link.bin")

    written: usize = try write_text(source, "resource bytes") else 0usize
    mode_set: bool = try chmod(source, 384u64) else false
    direct_copy: bool = false
    if written == 14 and mode_set:
        direct_copy <- try copy_macos_app_file(source, copied) else false
    link_created: bool = try symlink(source, link) else false
    linked_copy: bool = false
    if link_created:
        linked_copy <- try copy_macos_app_file(link, copied_from_link) else false

    direct_contents: sview = try read_text(copied) else ""
    linked_contents: sview = try read_text(copied_from_link) else ""
    source_mode: i64 = try file_mode(source) else 0i64
    direct_mode: i64 = try file_mode(copied) else 0i64
    linked_is_symlink: bool = try is_symlink(copied_from_link) else true

    removed_link: bool = try remove_path(link) else false
    removed_source: bool = try remove_path(source) else false
    removed_direct: bool = try remove_path(copied) else false
    removed_linked: bool = try remove_path(copied_from_link) else false
    removed_directory: bool = try remove_directory(temporary) else false
    assert written == 14 and mode_set and direct_copy and link_created and linked_copy
    assert direct_contents == "resource bytes" and linked_contents == "resource bytes"
    assert source_mode == direct_mode and not linked_is_symlink
    assert removed_link and removed_source and removed_direct and removed_linked and removed_directory
