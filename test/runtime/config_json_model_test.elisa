include "../../src/runtime/encoding.elisa"
include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../src/runtime/json_lexer_model.elisa"
include "../../src/runtime/json_parse_model.elisa"
include "../../src/runtime/config_model.elisa"
include "../../src/runtime/config_json_model.elisa"

using EsJsonLex
using EsData
using EsJson
using EsJsonParse
using EsConfig
using EsConfigJson


@test
def flat_json_configuration_preserves_scalar_contracts() -> void:
    can Memory.Allocate, Abort.Panic:
        document: JsonDocument = parse_json_document(lex_json("{\"title\":\"first\\nsecond\",\"count\":12345678901234567890,\"enabled\":true,\"unset\":null}"))
        layer: ConfigLayer = flat_json_config_layer(document)
        assert layer.source == ConfigSource.File
        assert layer.entries.count == 4
        assert layer.entries[0].key == "title" and layer.entries[0].value == "first\nsecond"
        assert layer.entries[1].key == "count" and layer.entries[1].value == "12345678901234567890"
        assert layer.entries[2].key == "enabled" and layer.entries[2].value == "true"
        assert layer.entries[3].key == "unset" and layer.entries[3].value == "null"

        resolved: darray[ConfigValue] = resolve_config_layers([
            layer,
            ConfigLayer{source: ConfigSource.Environment, entries: [
                ConfigEntry{key: "title", value: "environment override"}
            ]}
        ])
        assert resolved.count == 4
        assert resolved[2].key == "title"
        assert resolved[2].value == "environment override"
        assert resolved[2].source == ConfigSource.Environment


@test
def flat_json_configuration_rejects_structures_and_duplicate_tolerant_policy() -> void:
    can Memory.Allocate, Abort.Panic:
        structure_rejected: mutable bool = false
        structured: JsonDocument = parse_json_document(lex_json("{\"nested\":{\"value\":1}}"))
        catch flat_json_config_layer(structured):
            ok layer:
                assert false
            error failure:
                structure_rejected <- failure == ConfigJsonError.StructuredValueUnsupported
        assert structure_rejected

        duplicate_policy_rejected: mutable bool = false
        duplicate_policy: JsonPolicy = JsonPolicy{duplicate_keys: JsonDuplicateKeyPolicy.KeepLast}
        tolerant: JsonDocument = parse_json_document(lex_json("{\"mode\":\"first\",\"mode\":\"last\"}", DataDecodeLimits{}, duplicate_policy))
        catch flat_json_config_layer(tolerant):
            ok layer:
                assert false
            error failure:
                duplicate_policy_rejected <- failure == ConfigJsonError.DuplicatePolicyNotStrict
        assert duplicate_policy_rejected
