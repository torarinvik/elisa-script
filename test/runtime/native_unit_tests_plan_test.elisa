include "../../ports/elisa-engine/scripts/native_unit_tests_plan.elisa"

using EsEngineNativeUnitTestsPlan


@test
def native_unit_test_plan_preserves_python_child_order_and_arguments() -> void can[Memory.Allocate, Abort.Panic]:
    commands: darray[ChildTest] = child_tests()
    assert commands.count == 4
    assert commands[0].script_name == "save_journal.elisascript"
    assert commands[0].arguments == ["--self-test"]
    assert commands[1].script_name == "test_jolt_shape_cache.elisascript"
    assert commands[1].arguments.count == 0
    assert commands[2].script_name == "test_crash_report.elisascript"
    assert commands[2].arguments.count == 0
    assert commands[3].script_name == "test_input_codes.elisascript"
    assert commands[3].arguments.count == 0


@test
def native_unit_test_plan_preserves_cpp_command_and_pkg_config_flag_order() -> void can[Memory.Allocate, Abort.Panic]:
    compiler: darray[sview] = ["ccache", "clang++", "--target=arm64-apple-darwin"]
    include_flags: darray[sview] = ["-I/opt/SDL 3/include", "-DSDL_STATIC"]
    command: Command = gamepad_compile_command("/repo/elisa-engine", "/tmp/native-tests", compiler, include_flags)
    assert command.program == "ccache"
    assert command.arguments == [
        "clang++", "--target=arm64-apple-darwin", "-std=c++17", "-O0",
        "-I/opt/SDL 3/include", "-DSDL_STATIC",
        "/repo/elisa-engine/test/application_gamepad_codes.cpp", "-o",
        "/tmp/native-tests/application-gamepad-codes-test"
    ]


@test
def native_unit_test_plan_rejects_an_empty_cpp_compiler_command() -> void can[Abort.Panic]:
    rejected: mutable bool = false
    catch gamepad_compile_command("/repo/elisa-engine", "/tmp/native-tests", [], []):
        ok _:
            rejected <- false
        error PlanError.EmptyCompilerCommand:
            rejected <- true
    assert rejected
