include "../../src/runtime/bounded_bytes_posix.elisa"

using EsBoundedBytes


@test
def bounded_binary_reader_preserves_arbitrary_bytes_and_enforces_limit() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast:
        temporary: Path = try temp_directory("bounded-binary-reader") else err:
            assert false
            path("/tmp")
        binary_path: Path = temporary.joinpath("payload.bin")
        expected: darray[u8] = [0u8, 10u8, 127u8, 128u8, 255u8]
        written: usize = try write_bytes(binary_path, expected) else err:
            0u64
        assert written == expected.count

        actual: darray[u8] = try read_bounded_bytes(binary_path, expected.count) else err:
            []
        assert actual == expected

        rejected: mutable bool = false
        catch read_bounded_bytes(binary_path, expected.count - 1):
            ok bytes:
                assert false
            error failure:
                rejected <- failure == ReadError.LimitExceeded
        assert rejected

        oversized_budget_rejected: mutable bool = false
        catch read_bounded_bytes(binary_path, 268435457):
            ok bytes:
                assert false
            error failure:
                oversized_budget_rejected <- failure == ReadError.LimitExceeded
        assert oversized_budget_rejected

        removed_file: bool = try remove_path(binary_path) else false
        removed_directory: bool = try remove_directory(temporary) else false
        assert removed_file and removed_directory
