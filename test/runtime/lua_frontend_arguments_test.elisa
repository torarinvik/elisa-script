include "../../src/testing/lua_frontend_arguments.elisa"

using EsLuaFrontendArguments


@test
def lua_frontend_arguments_accept_unambiguous_prefixes_and_attached_values() -> void:
    can Memory.Allocate, Abort.Panic:
        parsed: LuaFrontendArguments = try parse_lua_frontend_arguments([
            "--corpus=/workspace/Lua cases",
            "--opt=-O2",
            "--s",
            "--keep-t",
            "--json=/tmp/report with spaces.json"
        ])
        assert parsed.corpus_root == "/workspace/Lua cases" and parsed.corpus_root_set
        assert parsed.opt_level == "-O2"
        assert parsed.strict and parsed.keep_temp
        assert parsed.json_out == "/tmp/report with spaces.json" and parsed.json_out_set
        assert not parsed.help_requested


@test
def lua_frontend_arguments_preserve_empty_separated_and_attached_values() -> void:
    can Memory.Allocate, Abort.Panic:
        parsed: LuaFrontendArguments = try parse_lua_frontend_arguments(["--corpus-root", "", "--json-out="])
        assert parsed.corpus_root == "" and parsed.corpus_root_set
        assert parsed.json_out == "" and parsed.json_out_set
        assert parsed.opt_level == "-O3"


@test
def lua_frontend_arguments_classify_usage_and_value_failures() -> void:
    can Memory.Allocate, Abort.Panic:
        missing_value: mutable bool = false
        catch parse_lua_frontend_arguments(["--corpus-root"]):
            ok parsed:
                _ = parsed
                assert false
            error failure:
                missing_value <- failure == LuaFrontendArgumentsError.MissingValue

        unknown_option: mutable bool = false
        catch parse_lua_frontend_arguments(["--unknown"]):
            ok parsed:
                _ = parsed
                assert false
            error failure:
                unknown_option <- failure == LuaFrontendArgumentsError.UnknownOption

        invalid_opt_level: mutable bool = false
        catch parse_lua_frontend_arguments(["--opt-level", "-O9"]):
            ok parsed:
                _ = parsed
                assert false
            error failure:
                invalid_opt_level <- failure == LuaFrontendArgumentsError.InvalidOptLevel

        positional: mutable bool = false
        catch parse_lua_frontend_arguments(["--", "unexpected"]):
            ok parsed:
                _ = parsed
                assert false
            error failure:
                positional <- failure == LuaFrontendArgumentsError.UnexpectedPositional

        unexpected_flag_value: mutable bool = false
        catch parse_lua_frontend_arguments(["--strict=true"]):
            ok parsed:
                _ = parsed
                assert false
            error failure:
                unexpected_flag_value <- failure == LuaFrontendArgumentsError.UnexpectedValue

        assert missing_value and unknown_option and invalid_opt_level and positional and unexpected_flag_value


@test
def lua_frontend_arguments_support_help_abbreviations_and_reject_option_like_values() -> void:
    can Memory.Allocate, Abort.Panic:
        help: LuaFrontendArguments = try parse_lua_frontend_arguments(["--corpus-root", "/tmp/corpus", "--he"])
        assert help.help_requested and help.corpus_root_set

        missing_before_flag: mutable bool = false
        catch parse_lua_frontend_arguments(["--json-out", "--strict"]):
            ok parsed:
                _ = parsed
                assert false
            error failure:
                missing_before_flag <- failure == LuaFrontendArgumentsError.MissingValue

        plain_positional: mutable bool = false
        catch parse_lua_frontend_arguments(["corpus"]):
            ok parsed:
                _ = parsed
                assert false
            error failure:
                plain_positional <- failure == LuaFrontendArgumentsError.UnexpectedPositional

        assert missing_before_flag and plain_positional
