include "../../src/runtime/regex_model.elisa"

using EsRegex


@test
def regex_request_global_policy_matches_operation_shape() -> void:
    can Memory.Allocate, Abort.Panic:
        find_all_without_global: mutable bool = false
        catch validate_regex_request(RegexRequest{operation: RegexOperation.FindAll, pattern: "a", input: "aaa"}):
            ok value:
                assert false
            error failure:
                find_all_without_global <- failure == RegexContractError.GlobalPolicyInvalid
        assert find_all_without_global

        split_without_global: mutable bool = false
        catch validate_regex_request(RegexRequest{operation: RegexOperation.Split, pattern: ",", input: "a,b"}):
            ok value:
                assert false
            error failure:
                split_without_global <- failure == RegexContractError.GlobalPolicyInvalid
        assert split_without_global

        search_with_global: mutable bool = false
        catch validate_regex_request(RegexRequest{operation: RegexOperation.Search, pattern: "a", input: "aaa", global: true}):
            ok value:
                assert false
            error failure:
                search_with_global <- failure == RegexContractError.GlobalPolicyInvalid
        assert search_with_global

        assert validate_regex_request(RegexRequest{operation: RegexOperation.FindAll, pattern: "a", input: "aaa", global: true})
        assert validate_regex_request(RegexRequest{operation: RegexOperation.Replace, pattern: "a", input: "aaa", replacement: "b", global: true})
