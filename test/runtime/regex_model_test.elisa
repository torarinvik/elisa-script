include "../../src/runtime/regex_model.elisa"

using EsRegex


@test
def regex_request_global_policy_matches_operation_shape() -> void:
    can Memory.Allocate, Abort.Panic:
        find_all_without_global: mutable bool = false
        catch validate_regex_request(RegexRequest{operation: RegexOperation.FindAll, pattern: "a", input: "aaa"}):
            ok value:
                assert false
            error failure:
                find_all_without_global <- failure == RegexContractError.GlobalPolicyInvalid
        assert find_all_without_global

        split_without_global: mutable bool = false
        catch validate_regex_request(RegexRequest{operation: RegexOperation.Split, pattern: ",", input: "a,b"}):
            ok value:
                assert false
            error failure:
                split_without_global <- failure == RegexContractError.GlobalPolicyInvalid
        assert split_without_global

        search_with_global: mutable bool = false
        catch validate_regex_request(RegexRequest{operation: RegexOperation.Search, pattern: "a", input: "aaa", global: true}):
            ok value:
                assert false
            error failure:
                search_with_global <- failure == RegexContractError.GlobalPolicyInvalid
        assert search_with_global

        assert validate_regex_request(RegexRequest{operation: RegexOperation.FindAll, pattern: "a", input: "aaa", global: true})
        assert validate_regex_request(RegexRequest{operation: RegexOperation.Replace, pattern: "a", input: "aaa", replacement: "b", global: true})


@test
def regex_session_rejects_irrelevant_event_payloads() -> void:
    can Memory.Allocate, Abort.Panic:
        session: mutable RegexSession = RegexSession{request: RegexRequest{operation: RegexOperation.Replace, pattern: "a", input: "a", replacement: "b"}}
        begin_rejected: mutable bool = false
        catch advance_regex_session(session, RegexEvent.Begin, 1u64):
            ok value:
                assert false
            error failure:
                begin_rejected <- failure == RegexContractError.InvalidEventPayload
        assert begin_rejected

        _ = advance_regex_session(session, RegexEvent.Begin)
        replace_rejected: mutable bool = false
        catch advance_regex_session(session, RegexEvent.Replace, work_delta: 0, capture_delta: 1, output_delta: 1):
            ok value:
                assert false
            error failure:
                replace_rejected <- failure == RegexContractError.InvalidEventPayload
        assert replace_rejected


@test
def regex_session_accounts_work_reported_with_a_match() -> void:
    can Memory.Allocate, Abort.Panic:
        session: mutable RegexSession = RegexSession{request: RegexRequest{operation: RegexOperation.Search, pattern: "a", input: "a"}}
        _ = advance_regex_session(session, RegexEvent.Begin)
        _ = advance_regex_session(session, RegexEvent.Match, 1u64)
        assert session.work == 1
