include "../../src/testing/geometry_subset_stage_model.elisa"

using EsGeometrySubsetStageModel
using EsGeometrySubsetPackageCases


@test
def geometry_subset_stage_plan_is_bounded_and_preserves_manifest_order() -> void can[Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
    plan: Plan = try EsGeometrySubsetStageModel::plan("/tmp/geometry")
    assert plan.cases.count == 98
    assert plan.manifest_bytes.count > 0
    assert plan.manifest_bytes.count < 8388608
    assert plan.total_package_bytes > 0
    assert plan.total_package_bytes < 67108864

    manifest: sview = bytes_view(plan.manifest_bytes)
    manifest_lines: mutable usize = 0
    for byte in plan.manifest_bytes |manifest_lines|:
        manifest_lines <- manifest_lines + 1 if byte == 10u8
    assert manifest_lines == 98
    assert manifest.starts_with("accept\t/tmp/geometry/legacy.pkg\t6\t1\t0\t6\t0\n")
    assert manifest.contains("reject\t/tmp/geometry/gap.pkg\tsubsets do not partition the index stream\n")
    assert manifest.contains("\tslot_names\t4669727374\t5365636f6e64\n")
    assert manifest.contains("reject\t/tmp/geometry/clearcoat-factors-missing-data.pkg\t")
    assert manifest.ends_with("reject\t/tmp/geometry/occlusion-without-surface.pkg\tcooked slot material lacks the texture it needs\n")


@test
def geometry_deformation_cases_flow_through_the_typed_staging_plan() -> void can[Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
    morph: sview = "morph_0_positions_b64=raw\nmorph_0_positions_meshopt_b64=position\nmorph_0_normals_meshopt_b64=normal\n"
    skin_metadata: sview = "skin_indices_meshopt_b64=indices\nskin_weights_meshopt_b64=weights\n"
    cases: darray[GeneratedCase] = try EsGeometrySubsetStageModel::package_cases_with_deformation(morph, skin_metadata)
    assert cases.count == 104
    assert cases[98].file_name == "skin-corrupt-indices.pkg"
    assert cases[99].file_name == "skin-corrupt-weights.pkg"
    assert cases[100].file_name == "morph-missing-position.pkg"
    assert cases[103].file_name == "morph-extra-target.pkg"
    assert cases[98].loader_expectation.index_count == 0u32
    assert cases[98].loader_expectation.subsets.count == 0
    manifest_bytes: darray[u8] = try EsGeometrySubsetStageModel::manifest_bytes("/tmp/geometry", cases)
    manifest: sview = bytes_view(manifest_bytes)
    assert manifest.ends_with("reject\t/tmp/geometry/morph-extra-target.pkg\tmorph stream fields\n")


@test
def meshopt_cases_flow_through_the_typed_staging_plan() -> void can[Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
    compressed_package: sview = "meshopt_codec=meshoptimizer-v1.2\npositions_meshopt_b64=position\nindices_meshopt_b64=index\n"
    cases: darray[GeneratedCase] = try EsGeometrySubsetStageModel::package_cases_with_meshopt(compressed_package, "raw")
    assert cases.count == 105
    assert cases[98].file_name == "meshopt-no-declaration.pkg"
    assert cases[99].file_name == "meshopt-unknown-codec.pkg"
    assert cases[104].file_name == "meshopt-unknown-stream.pkg"
    manifest_bytes: darray[u8] = try EsGeometrySubsetStageModel::manifest_bytes("/tmp/geometry", cases)
    manifest: sview = bytes_view(manifest_bytes)
    assert manifest.ends_with("reject\t/tmp/geometry/meshopt-unknown-stream.pkg\tunsupported meshoptimizer cooked geometry stream\n")


