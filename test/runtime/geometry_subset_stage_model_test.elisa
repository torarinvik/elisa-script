@test
def morph_variants_flow_through_the_typed_staging_plan() -> void can[Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
    morph_package: sview = "morph_target_position_stride=12\nmorph_targets=1\n"
    cases: darray[GeneratedCase] = try EsGeometrySubsetStageModel::package_cases_with_morph_variants(morph_package)
    assert cases.count == 100
    assert cases[98].file_name == "morph-stride.pkg"
    assert cases[99].file_name == "morph-empty.pkg"
    manifest_bytes: darray[u8] = try EsGeometrySubsetStageModel::manifest_bytes("/tmp/geometry", cases)
    manifest: sview = bytes_view(manifest_bytes)
    assert manifest.ends_with("reject\t/tmp/geometry/morph-empty.pkg\tmorph metadata\n")


@test
def all_cooker_derived_geometry_variants_compose_into_one_bounded_plan() -> void can[Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
    compressed_package: sview = "meshopt_codec=meshoptimizer-v1.2\npositions_meshopt_b64=position\nindices_meshopt_b64=index\n"
    morph_package: sview = "morph_0_positions_b64=raw\nmorph_0_positions_meshopt_b64=position\nmorph_0_normals_meshopt_b64=normal\nmorph_target_position_stride=12\nmorph_targets=1\n"
    skin_package: sview = "skin_indices_meshopt_b64=indices\nskin_weights_meshopt_b64=weights\n"
    scene_package: sview = "camera_0_projection=0\nlight_0_kind=0\ncamera_0_transform_b64=encoded\n"
    hierarchy_package: sview = "mesh_placement_stride=80\nmesh_count=3\nmesh_placements_b64=AAECAwQFBgcICQoLDA0ODxAREhMUFRYX\n"
    cases: darray[GeneratedCase] = try EsGeometrySubsetStageModel::package_cases_with_cooked_variants(compressed_package, "raw", morph_package, skin_package, scene_package, hierarchy_package)
    assert cases.count == 120
    assert cases[98].file_name == "meshopt-no-declaration.pkg"
    assert cases[105].file_name == "skin-corrupt-indices.pkg"
    assert cases[111].file_name == "scene-camera-projection.pkg"
    assert cases[114].file_name == "hierarchy-mesh-stride.pkg"
    assert cases[118].file_name == "morph-stride.pkg"
    assert cases[119].file_name == "morph-empty.pkg"
    manifest_bytes: darray[u8] = try EsGeometrySubsetStageModel::manifest_bytes("/tmp/geometry", cases)
    manifest: sview = bytes_view(manifest_bytes)
    assert manifest.ends_with("reject\t/tmp/geometry/morph-empty.pkg\tmorph metadata\n")
