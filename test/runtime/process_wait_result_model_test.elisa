# Pure literals only; no differential facade, libc, child or wait is imported.
include "../../src/runtime/process_wait_result_model.elisa"

using EsProcessWaitResult


@test
def process_wait_result_preserves_normal_reserved_looking_exit_codes_and_streams() -> void:
    can Memory.Allocate, Abort.Panic:
        for code in [0i64, 125i64, 126i64, 127i64, 255i64]:
            result: Receipt = try decode(code * 256, "out\x00\xff", "err\r\n") else failure:
                assert false
                return
            assert result.kind == EsProcessSpawnWait::Kind.Exited
            assert result.exit_status == code and result.signal == 0u32
            assert result.stdout == "out\x00\xff" and result.stderr == "err\r\n"


@test
def process_wait_result_preserves_terminal_signal_and_core_status() -> void:
    killed: Receipt = try decode(9, "", "") else failure:
        assert false
        return
    core: Receipt = try decode(139, "", "") else failure:
        assert false
        return
    assert killed.kind == EsProcessSpawnWait::Kind.Signaled
    assert killed.signal == 9u32 and killed.exit_status == 137
    assert core.kind == EsProcessSpawnWait::Kind.Signaled
    assert core.signal == 11u32 and core.exit_status == 139


@test
def process_wait_result_rejects_nonterminal_and_malformed_statuses() -> void:
    can Memory.Allocate, Abort.Panic:
        for status in [4479i64, 4991i64, -1i64, 65536i64, 128i64, 32i64, 265i64, 65535i64]:
            rejected: mutable bool = false
            catch decode(status, "not accepted", "not accepted"):
                ok result:
                    assert false
                error failure:
                    rejected <- failure == DecodeError.InvalidStatus
            assert rejected


@test
def process_wait_result_capture_budget_uses_combined_bytes_without_underflow() -> void:
    assert capture_sizes_fit(0, 0)
    assert capture_sizes_fit(67108864, 0)
    assert capture_sizes_fit(0, 67108864)
    assert capture_sizes_fit(67108863, 1)
    assert not capture_sizes_fit(67108864, 1)
    assert not capture_sizes_fit(67108865, 0)
    assert not capture_sizes_fit(0, 67108865)
