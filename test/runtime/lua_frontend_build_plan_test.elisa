include "../../src/runtime/process_model.elisa"
include "../../src/testing/lua_frontend_build_plan.elisa"

using EsProcess
using EsLuaFrontendBuildPlan


def lua_frontend_build_plan_test_input() -> LuaFrontendBuildPlanInput:
    return LuaFrontendBuildPlanInput{
        go_executable: "/toolchain/bin/go",
        clang_executable: "/toolchain/bin/clang",
        repository_root: "/workspace/Elisa core",
        compiler_root: "/workspace/Elisa compiler",
        temporary_root: "/tmp/lua frontend build",
        opt_level: "-O2",
        timeout_micros: 300000000u64,
        max_rss_bytes: 1073741824,
        capture_output_limit_bytes: 1048576,
        frontend_source: "/workspace/Elisa core/Code/elisacore_lua/src/lua_frontend.elisa",
        candidate_harness_source: "/workspace/Elisa core/Code/benchmarks/lua_frontend_bench.c",
        runtime_shims_source: "/workspace/Elisa core/Code/benchmarks/json_parser_runtime_shims.c",
        reference_harness_source: "/workspace/Elisa core/Code/benchmarks/lua_reference_parse_harness.c",
        ll_directory: "/tmp/lua frontend build/ll",
        reference_directory: "/tmp/lua frontend build/ref",
        header_output: "/tmp/lua frontend build/ll/lua_frontend.h",
        object_output: "/tmp/lua frontend build/ll/lua_frontend.o",
        candidate_output: "/tmp/lua frontend build/ll/lua_frontend_bench",
        reference_output: "/tmp/lua frontend build/ref/lua_reference_parse"
    }


@test
def lua_frontend_build_plan_materializes_exact_argv_and_resource_policy() -> void:
    can Memory.Allocate, Abort.Panic:
        plan: LuaFrontendBuildPlan = try make_lua_frontend_build_plan(lua_frontend_build_plan_test_input())
        assert plan.commands.count == 4
        assert plan.ll_directory == "/tmp/lua frontend build/ll"
        assert plan.reference_directory == "/tmp/lua frontend build/ref"
        assert plan.commands[0].process.executable == "/toolchain/bin/go"
        assert plan.commands[0].process.arguments == ["run", "./src", "-O2", "-emit", "header", "-o", plan.header_output, "/workspace/Elisa core/Code/elisacore_lua/src/lua_frontend.elisa"]
        assert plan.commands[1].process.arguments == ["run", "./src", "-O2", "-emit", "obj", "-o", plan.object_output, "/workspace/Elisa core/Code/elisacore_lua/src/lua_frontend.elisa"]
        assert plan.commands[2].process.executable == "/toolchain/bin/clang"
        assert plan.commands[2].process.arguments == ["-O2", "-pthread", "-Wl,-undefined,dynamic_lookup", "-I", plan.ll_directory, "/workspace/Elisa core/Code/benchmarks/lua_frontend_bench.c", "/workspace/Elisa core/Code/benchmarks/json_parser_runtime_shims.c", plan.object_output, "-o", plan.candidate_output]
        assert plan.commands[3].process.arguments == ["-O2", "-std=c99", "/workspace/Elisa core/Code/benchmarks/lua_reference_parse_harness.c", "-lm", "-ldl", "-o", plan.reference_output]
        assert plan.commands[0].process.working_directory == "/workspace/Elisa compiler"
        assert plan.commands[1].process.working_directory == "/workspace/Elisa compiler"
        assert plan.commands[2].process.working_directory == "/workspace/Elisa compiler"
        assert plan.commands[3].process.working_directory == "/workspace/Elisa core"
        for command in plan.commands:
            assert command.process.timeout_micros == 300000000u64
            assert command.process.capture_output_limit_bytes == 1048576
            assert command.max_rss_bytes == 1073741824
            assert command.process.stdout_mode == ProcessStdioMode.Capture
            assert command.process.stderr_mode == ProcessStdioMode.Capture


@test
def lua_frontend_build_plan_rejects_escaping_outputs_and_unbounded_resources() -> void:
    can Memory.Allocate, Abort.Panic:
        escaped_output: mutable bool = false
        escaped: mutable LuaFrontendBuildPlanInput = lua_frontend_build_plan_test_input()
        escaped.reference_output <- "/tmp/lua frontend build/other/lua_reference_parse"
        catch make_lua_frontend_build_plan(escaped):
            ok plan:
                _ = plan
            error failure:
                escaped_output <- failure == LuaFrontendBuildPlanError.UnexpectedBuildPath

        excessive_rss: mutable bool = false
        unbounded: mutable LuaFrontendBuildPlanInput = lua_frontend_build_plan_test_input()
        unbounded.max_rss_bytes <- Limits::MAX_RSS_BYTES + 1
        catch make_lua_frontend_build_plan(unbounded):
            ok plan:
                _ = plan
            error failure:
                excessive_rss <- failure == LuaFrontendBuildPlanError.InvalidResourceLimit

        assert escaped_output and excessive_rss
