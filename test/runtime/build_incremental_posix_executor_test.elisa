include "../../src/ir/ir.elisa"

using EsBuild
using EsBuildIncrementalPosixExecutor


@test
def toolchain_resolution_must_match_graph_command_before_observation() -> void:
    can Memory.Allocate, Abort.Panic:
        graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "compile", command: ProcessCommand{executable: "cc"}, fingerprint: 1}
        ]}
        wrong_resolution: darray[BuildRecipeToolchainPath] = [
            BuildRecipeToolchainPath{command_executable: "clang", path: "usr/bin/cc"}
        ]
        rejected: mutable bool = false
        catch validate_build_recipe_toolchain_paths(graph, wrong_resolution):
            ok valid:
                rejected <- not valid
            error failure:
                rejected <- failure == ToolchainObservationError.ToolchainCommandMismatch(0)
        assert rejected

        unsafe_resolution: darray[BuildRecipeToolchainPath] = [
            BuildRecipeToolchainPath{command_executable: "cc", path: "../usr/bin/cc"}
        ]
        unsafe_path_rejected: mutable bool = false
        catch validate_build_recipe_toolchain_paths(graph, unsafe_resolution):
            ok valid:
                unsafe_path_rejected <- not valid
            error failure:
                unsafe_path_rejected <- failure == ToolchainObservationError.InvalidToolchainPath(0)
        assert unsafe_path_rejected


@test
def exact_environment_shims_require_explicit_toolchain_paths() -> void:
    can Memory.Allocate, Abort.Panic:
        graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "compile", command: ProcessCommand{executable: "/usr/bin/cc", environment_mode: ProcessEnvironmentMode.Replace}, fingerprint: 1}
        ]}
        missing_shim: darray[BuildRecipeToolchainPath] = [
            BuildRecipeToolchainPath{command_executable: "/usr/bin/cc", path: "usr/bin/cc"}
        ]
        missing_shim_rejected: mutable bool = false
        catch validate_build_recipe_toolchain_paths(graph, missing_shim):
            ok valid:
                missing_shim_rejected <- not valid
            error failure:
                missing_shim_rejected <- failure == ToolchainObservationError.MissingEnvironmentShim(0)
        assert missing_shim_rejected

        pinned_shim: darray[BuildRecipeToolchainPath] = [
            BuildRecipeToolchainPath{command_executable: "/usr/bin/cc", path: "usr/bin/cc", helper_paths: ["usr/bin/env"]}
        ]
        pinned_shim_valid: mutable bool = false
        catch validate_build_recipe_toolchain_paths(graph, pinned_shim):
            ok valid:
                pinned_shim_valid <- valid
            error failure:
                pinned_shim_valid <- false
        assert pinned_shim_valid

        inherited_graph: BuildGraph = BuildGraph{nodes: [BuildNode{name: "compile", command: ProcessCommand{executable: "cc"}, fingerprint: 1}]}
        unexpected_shim: darray[BuildRecipeToolchainPath] = [
            BuildRecipeToolchainPath{command_executable: "cc", path: "usr/bin/cc", helper_paths: ["usr/bin/env"]}
        ]
        unexpected_shim_rejected: mutable bool = false
        catch validate_build_recipe_toolchain_paths(inherited_graph, unexpected_shim):
            ok valid:
                unexpected_shim_rejected <- not valid
            error failure:
                unexpected_shim_rejected <- failure == ToolchainObservationError.UnexpectedEnvironmentShim(0)
        assert unexpected_shim_rejected


@test
def stable_source_validation_rejects_mid_build_changes() -> void:
    can Memory.Allocate, Abort.Panic:
        recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "compile", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 1, inputs: ["src/main.c"], outputs: ["bin/app"]}
        ]
        before: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "bin/app", present: false},
            BuildIncrementalObservation{path: "src/main.c", present: true, fingerprint: 1, fingerprint_word1: 2, fingerprint_word2: 3, fingerprint_word3: 4}
        ]
        after: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "bin/app", present: true, fingerprint: 5, fingerprint_word1: 6, fingerprint_word2: 7, fingerprint_word3: 8},
            BuildIncrementalObservation{path: "src/main.c", present: true, fingerprint: 9, fingerprint_word1: 2, fingerprint_word2: 3, fingerprint_word3: 4}
        ]
        rejected: mutable bool = false
        catch validate_build_incremental_stable_sources(recipes, before, after):
            ok valid:
                rejected <- not valid
            error failure:
                rejected <- failure == BuildIncrementalError.SourceChangedDuringBuild
        assert rejected

        generated_recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "generate", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, outputs: ["build/config.h"]},
            BuildIncrementalRecipeTarget{name: "compile", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 2, inputs: ["build/config.h"], outputs: ["bin/app"], dependencies: ["generate"]}
        ]
        generated_before: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "bin/app", present: false},
            BuildIncrementalObservation{path: "build/config.h", present: false}
        ]
        generated_after: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "bin/app", present: true, fingerprint: 10, fingerprint_word1: 11, fingerprint_word2: 12, fingerprint_word3: 13},
            BuildIncrementalObservation{path: "build/config.h", present: true, fingerprint: 14, fingerprint_word1: 15, fingerprint_word2: 16, fingerprint_word3: 17}
        ]
        generated_change_allowed: mutable bool = false
        catch validate_build_incremental_stable_sources(generated_recipes, generated_before, generated_after):
            ok valid:
                generated_change_allowed <- valid
            error failure:
                generated_change_allowed <- false
        assert generated_change_allowed
