include "../../src/testing/geometry_subset_manifest_model.elisa"

using EsGeometrySubsetManifest


def manifest_rejects(test_case: LoaderCase, expected: ManifestError) -> bool can[Memory.Allocate, Abort.Panic, Console.Format]:
    observed: mutable bool = false
    catch manifest_line("/tmp/geometry", test_case):
        ok line:
            _ = line
        error failure:
            observed <- failure == expected
    return observed


@test
def geometry_subset_manifest_matches_reject_and_minimal_accept_contracts() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    rejected: darray[u8] = try manifest_line("/tmp/geometry", LoaderCase{
        verdict: Verdict.Reject,
        file_name: "bad.pkg",
        expected_diagnostic: "invalid cooked geometry subset records"
    })
    assert bytes_view(rejected) == "reject\t/tmp/geometry/bad.pkg\tinvalid cooked geometry subset records"

    accepted: darray[u8] = try manifest_line("/tmp/geometry", LoaderCase{
        verdict: Verdict.Accept,
        file_name: "good.pkg",
        expectation: Expectation{
            index_count: 6u32,
            material_slots: 1u32,
            subsets: [Subset{first_index: 0u32, index_count: 6u32, material_slot: 0u32}],
            has_normal_scales: true,
            normal_scales: [0.75f32, 0.25f32]
        }
    })
    assert bytes_view(accepted) == "accept\t/tmp/geometry/good.pkg\t6\t1\t0\t6\t0\tnormal_scales\t0.75\t0.25"


@test
def geometry_subset_manifest_pads_material_fields_and_orders_optional_markers() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    accepted: darray[u8] = try manifest_line("/tmp/geometry", LoaderCase{
        verdict: Verdict.Accept,
        file_name: "materials.pkg",
        expectation: Expectation{
            index_count: 3u32,
            material_slots: 1u32,
            subsets: [Subset{first_index: 0u32, index_count: 3u32, material_slot: 0u32}],
            has_materials: true,
            materials: [Material{
                factors: [0.5f32, 0.0f32, 0.0f32, 1.0f32, 0.25f32, 0.75f32, 1.0f32, 0.0f32, 0.0f32, 0.5f32],
                alpha_mode: 0u32,
                flags: 1u32,
                texture_indices: [3u32, 0u32, 1u32, 0u32, 0u32]
            }],
            has_sections: true,
            sections: [TextureSection{name: "image_0", checksum: 9u32}],
            has_clearcoat_factors: true,
            clearcoat_factors: [ClearcoatFactors{factor: 0.5f32, roughness: 0.25f32, normal_scale: 1.0f32}],
            has_slot_names: true,
            slot_names: ["Aé"],
            has_normal_scales: true,
            normal_scales: [0.75f32],
            has_occlusion_strengths: true,
            occlusion_strengths: [0.5f32],
            has_animations: true,
            animation_count: 1u32,
            has_morphs: true,
            morph_count: 2u32,
            has_cameras: true,
            camera_count: 3u32,
            has_lights: true,
            light_count: 4u32,
            has_inverse_binds: true,
            inverse_bind_values: [1.0f32, 0.0f32],
            has_uv1: true,
            uv1: Uv1Expectation{vertex_count: 3u32, source: "generated", resolution: 64u32, padding: 2u32, chart_count: 1u32},
            has_mesh_placements: true,
            mesh_placements: [MeshPlacement{
                mesh: 0u32,
                node: 1u32,
                vertex_start: 0u32,
                vertex_count: 3u32,
                index_start: 0u32,
                index_count: 3u32,
                subset_start: 0u32,
                subset_count: 1u32,
                transform: [1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32]
            }]
        }
    })
    manifest: sview = bytes_view(accepted)
    assert manifest.contains("\tmaterials\t0.5\t0.0\t0.0\t1.0\t0.25\t0.75\t1.0\t0.0\t0.0\t0.5\t0\t1\t3\t0\t1\t0\t0\t0\t0\t0")
    assert manifest.contains("\tsections\timage_0\t9\tclearcoat_factors\t0.5\t0.25\t1.0\tslot_names\t41c3a9\tnormal_scales\t0.75\tocclusion_strengths\t0.5")
    assert manifest.contains("\tanimations\t1\tmorphs\t2\tcameras\t3\tlights\t4\tinverse_binds\t1.0\t0.0\tuv1\t3\tgenerated\t64\t2\t1\tmesh_placements\t1\t0\t1\t0\t3\t0\t3\t0\t1")


@test
def geometry_subset_manifest_rejects_malformed_typed_expectations() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    bad_material: LoaderCase = LoaderCase{
        verdict: Verdict.Accept,
        file_name: "bad-material.pkg",
        expectation: Expectation{
            has_materials: true,
            materials: [Material{factors: [0.5f32], alpha_mode: 0u32, flags: 0u32}]
        }
    }
    bad_transform: LoaderCase = LoaderCase{
        verdict: Verdict.Accept,
        file_name: "bad-transform.pkg",
        expectation: Expectation{
            has_mesh_placements: true,
            mesh_placements: [MeshPlacement{
                mesh: 0u32, node: 0u32, vertex_start: 0u32, vertex_count: 0u32,
                index_start: 0u32, index_count: 0u32, subset_start: 0u32,
                subset_count: 0u32, transform: [1.0f32]
            }]
        }
    }
    assert manifest_rejects(bad_material, ManifestError.InvalidMaterialFactorCount)
    assert manifest_rejects(bad_transform, ManifestError.InvalidPlacementTransformCount)
