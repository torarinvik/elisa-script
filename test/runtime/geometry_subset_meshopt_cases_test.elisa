include "../../src/testing/geometry_subset_meshopt_cases.elisa"

using EsGeometrySubsetMeshoptCases


@test
def meshopt_mutations_preserve_the_python_case_order_and_package_lines() -> void can[Memory.Allocate, Abort.Panic]:
    compressed_package: sview = "format=elisa-cooked-v2\r\nmeshopt_codec=meshoptimizer-v1.2\r\npositions_meshopt_b64=position\r\nindices_meshopt_b64=index\r\ntangents_meshopt_b64=tangent\r\n"
    generated: darray[Case] = try EsGeometrySubsetMeshoptCases::cases(compressed_package, "raw-positions")
    assert generated.count == 7
    assert generated[0].file_name == "meshopt-no-declaration.pkg"
    assert generated[0].expected_diagnostic == "unsupported or inconsistent cooked geometry meshoptimizer codec"
    assert bytes_view(generated[0].package_bytes) == "format=elisa-cooked-v2\npositions_meshopt_b64=position\nindices_meshopt_b64=index\ntangents_meshopt_b64=tangent\n"
    assert generated[1].file_name == "meshopt-unknown-codec.pkg"
    assert bytes_view(generated[1].package_bytes).contains("meshopt_codec=meshoptimizer-v9\n")
    assert generated[2].file_name == "meshopt-duplicate-position.pkg"
    assert bytes_view(generated[2].package_bytes).ends_with("positions_b64=raw-positions\n")
    assert generated[3].file_name == "meshopt-corrupt-position.pkg"
    assert bytes_view(generated[3].package_bytes).contains("positions_meshopt_b64=AA==\n")
    assert generated[4].file_name == "meshopt-corrupt-indices.pkg"
    assert generated[4].expected_diagnostic == "invalid cooked geometry index stream"
    assert bytes_view(generated[4].package_bytes).contains("indices_meshopt_b64=AA==\n")
    assert generated[5].file_name == "meshopt-corrupt-tangent.pkg"
    assert bytes_view(generated[5].package_bytes).contains("tangents_meshopt_b64=AA==\n")
    assert generated[6].file_name == "meshopt-unknown-stream.pkg"
    assert generated[6].expected_diagnostic == "unsupported meshoptimizer cooked geometry stream"
    assert bytes_view(generated[6].package_bytes).ends_with("unknown_meshopt_b64=AA==\n")


@test
def missing_remove_target_preserves_original_package_bytes_and_non_ascii_is_rejected() -> void can[Memory.Allocate, Abort.Panic]:
    original: sview = "header=yes\r\n"
    generated: darray[Case] = try EsGeometrySubsetMeshoptCases::cases(original, "raw")
    assert bytes_view(generated[0].package_bytes) == original

    rejected: mutable bool = false
    catch EsGeometrySubsetMeshoptCases::cases("header=\xff", "raw"):
        ok cases:
            _ = cases
        error failure:
            rejected <- failure == MeshoptCasesError.NonAsciiPackage
    assert rejected


@test
def meshopt_mutations_reject_oversized_package_and_raw_stream_inputs() -> void can[Memory.Allocate, Abort.Panic]:
    oversized: mutable darray[u8] = []
    oversized.reserve(16777217)
    for _ in 0..<16777217 |oversized|:
        oversized.push(97u8)

    rejected_package: mutable bool = false
    catch EsGeometrySubsetMeshoptCases::cases(bytes_view(oversized), "raw"):
        ok generated:
            _ = generated
        error failure:
            rejected_package <- failure == MeshoptCasesError.PackageTooLarge
    assert rejected_package

    rejected_raw_stream: mutable bool = false
    catch EsGeometrySubsetMeshoptCases::cases("header=small", bytes_view(oversized)):
        ok generated:
            _ = generated
        error failure:
            rejected_raw_stream <- failure == MeshoptCasesError.PackageTooLarge
    assert rejected_raw_stream
