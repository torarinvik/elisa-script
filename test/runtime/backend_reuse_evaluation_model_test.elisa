include "../../src/runtime/encoding.elisa"
include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../src/runtime/json_lexer_model.elisa"
include "../../src/runtime/json_parse_model.elisa"
include "../../src/runtime/backend_reuse_evaluation_model.elisa"

using EsBackendReuseEvaluation


const module BackendReuseEvaluationInputs:
    VALID: sview = "{\"schema\":\"wasmbrowser.backend_reuse_evaluation.v1\",\"candidates\":[{\"name\":\"GLFW\",\"revision\":\"0123456789012345678901234567890123456789\",\"source\":\"https://example.test/glfw\",\"license\":\"zlib\",\"missing_or_mismatched\":[\"capability boundary\"],\"build_experiment\":{\"command\":\"build\",\"status\":\"passed\"},\"decision\":\"defer\",\"fixture\":\"not_run\"},{\"name\":\"Webrogue SDK\",\"revision\":\"0123456789012345678901234567890123456789\",\"source\":\"https://example.test/webrogue\",\"license\":\"Apache-2.0\",\"missing_or_mismatched\":[\"ABI\"],\"build_experiment\":{\"command\":\"build\",\"status\":\"failed\"},\"decision\":\"reject-as-dependency; retain-as-reference\",\"fixture\":\"not_run\"},{\"name\":\"wasi-gfx-runtime\",\"revision\":\"0123456789012345678901234567890123456789\",\"source\":\"https://example.test/wasi-gfx\",\"license\":\"Apache-2.0\",\"missing_or_mismatched\":[\"host provider\"],\"build_experiment\":{\"command\":\"build\",\"status\":\"passed\"},\"decision\":\"defer\",\"fixture\":\"not_run\"}],\"selection\":{\"status\":\"none\",\"selected_candidate\":null,\"required_next_evidence\":[\"consumer\"]}}"


def backend_reuse_evaluation_rejects_as(source: sview, expected: BackendReuseEvaluationError) -> bool can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch validate_backend_reuse_evaluation_source(source):
        ok valid:
            rejected <- not valid
        error failure:
            rejected <- failure == expected
    return rejected


@test
def backend_reuse_evaluation_accepts_three_pinned_candidates_and_no_selection() -> void can[Memory.Allocate, Abort.Panic]:
    assert validate_backend_reuse_evaluation_source(BackendReuseEvaluationInputs::VALID)


@test
def backend_reuse_evaluation_preserves_set_coverage_with_duplicate_known_names() -> void can[Memory.Allocate, Abort.Panic]:
    duplicate_known_name: sview = replace(BackendReuseEvaluationInputs::VALID, "],\"selection\":{\"status\"", ",{\"name\":\"GLFW\",\"revision\":\"0123456789012345678901234567890123456789\",\"source\":\"https://example.test/glfw-copy\",\"license\":\"zlib\",\"missing_or_mismatched\":[\"capability boundary\"],\"build_experiment\":{\"command\":\"build\",\"status\":\"passed\"},\"decision\":\"defer\",\"fixture\":\"not_run\"}],\"selection\":{\"status\"")
    assert validate_backend_reuse_evaluation_source(duplicate_known_name)


@test
def backend_reuse_evaluation_matches_last_duplicate_member_lookup() -> void can[Memory.Allocate, Abort.Panic]:
    duplicate_schema: sview = replace(BackendReuseEvaluationInputs::VALID, "\"schema\":\"wasmbrowser.backend_reuse_evaluation.v1\"", "\"schema\":\"old\",\"schema\":\"wasmbrowser.backend_reuse_evaluation.v1\"")
    duplicate_status: sview = replace(BackendReuseEvaluationInputs::VALID, "\"status\":\"passed\"", "\"status\":false,\"status\":\"passed\"")
    assert validate_backend_reuse_evaluation_source(duplicate_schema)
    assert validate_backend_reuse_evaluation_source(duplicate_status)


@test
def backend_reuse_evaluation_rejects_missing_expected_candidate_and_bad_revision() -> void can[Memory.Allocate, Abort.Panic]:
    missing_name: sview = replace(BackendReuseEvaluationInputs::VALID, "wasi-gfx-runtime", "unknown-runtime")
    bad_revision: sview = replace(BackendReuseEvaluationInputs::VALID, "0123456789012345678901234567890123456789", "short")
    assert backend_reuse_evaluation_rejects_as(missing_name, BackendReuseEvaluationError.CandidateNameMismatch)
    assert backend_reuse_evaluation_rejects_as(bad_revision, BackendReuseEvaluationError.InvalidCandidate)


@test
def backend_reuse_evaluation_preserves_truthiness_and_selection_gates() -> void can[Memory.Allocate, Abort.Panic]:
    empty_license: sview = replace(BackendReuseEvaluationInputs::VALID, "\"license\":\"zlib\"", "\"license\":[]")
    passed_fixture: sview = replace(BackendReuseEvaluationInputs::VALID, "\"fixture\":\"not_run\"", "\"fixture\":\"passed\"")
    selected: sview = replace(BackendReuseEvaluationInputs::VALID, "\"selected_candidate\":null", "\"selected_candidate\":\"GLFW\"")
    empty_evidence: sview = replace(BackendReuseEvaluationInputs::VALID, "\"required_next_evidence\":[\"consumer\"]", "\"required_next_evidence\":[]")
    assert backend_reuse_evaluation_rejects_as(empty_license, BackendReuseEvaluationError.InvalidCandidate)
    assert backend_reuse_evaluation_rejects_as(passed_fixture, BackendReuseEvaluationError.InvalidCandidate)
    assert backend_reuse_evaluation_rejects_as(selected, BackendReuseEvaluationError.InvalidSelection)
    assert backend_reuse_evaluation_rejects_as(empty_evidence, BackendReuseEvaluationError.InvalidSelection)
