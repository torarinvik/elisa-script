include "../../src/runtime/checksum_manifest_model.elisa"

using EsChecksumManifest


module EsChecksumManifestFixture:
    private:
        const module Values:
            HASH: sview = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
            UPPER_HASH: sview = "0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF"

    public:
        def hash() -> sview:
            return Values::HASH


        def upper_hash() -> sview:
            return Values::UPPER_HASH


        def assert_issues(contents: sview, expected: darray[usize]) -> void can[Memory.Allocate, Abort.Panic]:
            issues: darray[usize] = try invalid_lines(contents) else err:
                assert false
                return
            assert issues.count == expected.count
            for index in 0..<expected.count:
                assert issues[index] == expected[index]


@test
def checksum_manifest_empty_and_two_field_records() -> void:
    can Memory.Allocate, Abort.Panic:
        hash: sview = EsChecksumManifestFixture::hash()
        EsChecksumManifestFixture::assert_issues("", [])
        EsChecksumManifestFixture::assert_issues(hash + "  file\n", [])
        EsChecksumManifestFixture::assert_issues("\t " + hash + "\t*file \t", [])
        EsChecksumManifestFixture::assert_issues(EsChecksumManifestFixture::upper_hash() + "  -file\n", [])
        EsChecksumManifestFixture::assert_issues(hash + "  \xc3\xa9.pt\n", [])


@test
def checksum_manifest_reports_each_bad_record_once_in_order() -> void:
    can Memory.Allocate, Abort.Panic:
        hash: sview = EsChecksumManifestFixture::hash()
        input: sview = "\n" + hash + "  good\nshort file\n" + hash + "\n" + hash + "  file extra\n \t\n"
        EsChecksumManifestFixture::assert_issues(input, [1usize, 3usize, 4usize, 5usize, 6usize])
        EsChecksumManifestFixture::assert_issues("bad three fields\n", [1usize])
        EsChecksumManifestFixture::assert_issues(hash + "a file\n", [1usize])
        EsChecksumManifestFixture::assert_issues("g" + hash + " file\n", [1usize])
        EsChecksumManifestFixture::assert_issues("g123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef file\n", [1usize])


@test
def checksum_manifest_does_not_use_universal_newlines_or_unicode_whitespace() -> void:
    can Memory.Allocate, Abort.Panic:
        hash: sview = EsChecksumManifestFixture::hash()
        EsChecksumManifestFixture::assert_issues(hash + "  file\r\n", [])
        EsChecksumManifestFixture::assert_issues(hash + "\r file\n", [1usize])
        EsChecksumManifestFixture::assert_issues(hash + " file \r\n", [1usize])
        EsChecksumManifestFixture::assert_issues(hash + "\x0bfile\n", [1usize])
        EsChecksumManifestFixture::assert_issues(hash + "\x0cfile\n", [1usize])
        EsChecksumManifestFixture::assert_issues(hash + "\xc2\xa0file\n", [1usize])
        EsChecksumManifestFixture::assert_issues(hash + " file\r" + hash + " file", [1usize])


@test
def checksum_manifest_trailing_lf_creates_no_phantom_record() -> void:
    can Memory.Allocate, Abort.Panic:
        hash: sview = EsChecksumManifestFixture::hash()
        EsChecksumManifestFixture::assert_issues(hash + " file", [])
        EsChecksumManifestFixture::assert_issues(hash + " file\n", [])
        EsChecksumManifestFixture::assert_issues(hash + " file\n\n", [2usize])
        EsChecksumManifestFixture::assert_issues("\n", [1usize])


@test
def checksum_manifest_issue_limit_fails_closed() -> void:
    can Memory.Allocate, Abort.Panic:
        contents: mutable sview = ""
        for _ in 0..<4096 |contents|:
            contents <- contents + "\n"
        issues: darray[usize] = try invalid_lines(contents) else err:
            assert false
            return
        assert issues.count == 4096
        assert issues[0] == 1 and issues[4095] == 4096
        rejected: mutable bool = false
        catch invalid_lines(contents + "\n"):
            ok _:
                assert false
            error failure:
                rejected <- failure == ValidationError.IssueLimit
        assert rejected
