include "../../src/testing/geometry_subset_deformation_cases.elisa"

using EsGeometrySubsetDeformationCases


@test
def malformed_deformation_cases_preserve_order_and_expected_diagnostics() -> void can[Memory.Allocate, Abort.Panic]:
    morph: sview = "format=elisa-cooked-v3\r\nmorph_0_positions_b64=raw\r\nmorph_0_positions_meshopt_b64=first\r\nmorph_0_normals_meshopt_b64=normal\r\nmorph_0_positions_meshopt_b64=second\r\n"
    skin_metadata: sview = "skin_indices_meshopt_b64=first\r\nskin_indices_meshopt_b64=second\x0bskin_weights_meshopt_b64=old\x0cend=yes\x1cmarker=a\x1dmarker=b\x1emarker=c\n"
    generated: mutable darray[Case] = []
    catch EsGeometrySubsetDeformationCases::cases(morph, skin_metadata):
        ok cases:
            generated <- cases
        error failure:
            _ = failure
            assert false
    assert generated.count == 6
    assert generated[0].verdict == Verdict.Reject and generated[0].file_name == "skin-corrupt-indices.pkg"
    assert bytes_view(generated[0].package_bytes) == "skin_indices_meshopt_b64=AA==\nskin_indices_meshopt_b64=second\nskin_weights_meshopt_b64=old\nend=yes\nmarker=a\nmarker=b\nmarker=c\n"
    assert generated[1].file_name == "skin-corrupt-weights.pkg"
    assert bytes_view(generated[1].package_bytes) == "skin_indices_meshopt_b64=first\nskin_indices_meshopt_b64=second\nskin_weights_meshopt_b64=AA==\nend=yes\nmarker=a\nmarker=b\nmarker=c\n"
    assert generated[2].file_name == "morph-missing-position.pkg"
    assert bytes_view(generated[2].package_bytes) == "format=elisa-cooked-v3\nmorph_0_normals_meshopt_b64=normal\n"
    assert generated[3].file_name == "morph-corrupt-position.pkg"
    assert bytes_view(generated[3].package_bytes) == "format=elisa-cooked-v3\nmorph_0_positions_b64=raw\nmorph_0_positions_meshopt_b64=AA==first\nmorph_0_normals_meshopt_b64=normal\nmorph_0_positions_meshopt_b64=second\n"
    assert generated[3].expected_diagnostic == "morph position stream"
    assert bytes_view(generated[4].package_bytes) == "format=elisa-cooked-v3\nmorph_0_positions_b64=raw\nmorph_0_positions_meshopt_b64=first\nmorph_0_normals_meshopt_b64=AA==normal\nmorph_0_positions_meshopt_b64=second\n"
    assert generated[4].expected_diagnostic == "morph normal stream"
    assert bytes_view(generated[5].package_bytes) == morph + "morph_1_positions_meshopt_b64=AA==\n"
    assert generated[5].expected_diagnostic == "morph stream fields"


@test
def removing_every_position_line_keeps_python_empty_join_newline() -> void can[Memory.Allocate, Abort.Panic]:
    generated: mutable darray[Case] = []
    catch EsGeometrySubsetDeformationCases::cases("morph_0_positions_b64=raw\n", "indices"):
        ok cases:
            generated <- cases
        error failure:
            _ = failure
            assert false
    assert bytes_view(generated[2].package_bytes) == "\n"


@test
def bytes_line_split_preserves_vertical_tab_and_form_feed_data() -> void can[Memory.Allocate, Abort.Panic]:
    morph: sview = "kept\x0bbytes\rkept\x0cbytes\n"
    generated: mutable darray[Case] = []
    catch EsGeometrySubsetDeformationCases::cases(morph, "indices"):
        ok cases:
            generated <- cases
        error failure:
            _ = failure
            assert false
    assert bytes_view(generated[2].package_bytes) == "kept\x0bbytes\nkept\x0cbytes\n"


@test
def absent_skin_fields_are_appended_and_non_ascii_metadata_is_rejected() -> void can[Memory.Allocate, Abort.Panic]:
    generated: mutable darray[Case] = []
    catch EsGeometrySubsetDeformationCases::cases("morph", "header=kept"):
        ok cases:
            generated <- cases
        error failure:
            _ = failure
            assert false
    assert bytes_view(generated[0].package_bytes) == "header=kept\nskin_indices_meshopt_b64=AA==\n"
    assert bytes_view(generated[1].package_bytes) == "header=kept\nskin_weights_meshopt_b64=AA==\n"

    rejected: mutable bool = false
    catch EsGeometrySubsetDeformationCases::cases("morph", "header=\xff"):
        ok cases:
            _ = cases
        error failure:
            rejected <- failure == DeformationCasesError.NonAsciiSkinMetadata
    assert rejected
