include "../../src/runtime/encoding.elisa"
include "../../src/runtime/config_model.elisa"
include "../../src/runtime/config_toml_model.elisa"

using EsConfig
using EsConfigToml


@test
def toml_configuration_parses_bounded_scalar_array_and_inline_table_subset() -> void:
    can Memory.Allocate, Abort.Panic:
        source: sview = "[build]\nmode = \"release\" # comment\nretries = 3\nenabled = true\n123.name = 'literal # value'\n"
        parsed: ConfigTomlLayer = parse_toml_config(source)
        assert parsed.layer.source == ConfigSource.File
        assert parsed.layer.entries.count == 4
        assert parsed.layer.entries[0].key == "build.mode" and parsed.layer.entries[0].value == "release"
        assert parsed.layer.entries[1].key == "build.retries" and parsed.layer.entries[1].value == "3"
        assert parsed.layer.entries[2].key == "build.enabled" and parsed.layer.entries[2].value == "true"
        assert parsed.layer.entries[3].key == "123.name" and parsed.layer.entries[3].value == "literal # value"

        exact_numbers: ConfigTomlLayer = parse_toml_config("decimal = +1_000\nhex = 0xDEAD_BEEF\noctal = 0o755\nbinary = 0b1010_0101\nfloat = 1_25.5_0e+2\nspecial = -inf\n")
        assert exact_numbers.layer.entries.count == 6
        assert exact_numbers.layer.entries[0].value == "+1_000"
        assert exact_numbers.layer.entries[1].value == "0xDEAD_BEEF"
        assert exact_numbers.layer.entries[2].value == "0o755"
        assert exact_numbers.layer.entries[3].value == "0b1010_0101"
        assert exact_numbers.layer.entries[4].value == "1_25.5_0e+2"
        assert exact_numbers.layer.entries[5].value == "-inf"
        hex_index: usize = lookup_toml_config_value(exact_numbers, "hex")
        assert exact_numbers.values[hex_index].kind == ConfigTomlValueKind.Integer

        project_arrays: ConfigTomlLayer = parse_toml_config("dependencies = [\"setuptools>=68\", \"wheel\"]\nmarkers = [\"campaign: long-running\", 'fast']\nretries = [1, 2, 3]\n")
        dependencies_index: usize = lookup_toml_config_value(project_arrays, "dependencies")
        markers_index: usize = lookup_toml_config_value(project_arrays, "markers")
        retries_index: usize = lookup_toml_config_value(project_arrays, "retries")
        assert dependencies_index < project_arrays.values.count
        assert project_arrays.values[dependencies_index].kind == ConfigTomlValueKind.Array
        assert project_arrays.values[dependencies_index].items.count == 2
        assert bytes_view(project_arrays.values[dependencies_index].items[0].text) == "setuptools>=68"
        assert project_arrays.values[dependencies_index].items[0].kind == ConfigTomlValueKind.Text
        assert bytes_view(project_arrays.values[markers_index].items[0].text) == "campaign: long-running"
        assert project_arrays.values[retries_index].items[0].kind == ConfigTomlValueKind.Integer
        assert bytes_view(project_arrays.values[retries_index].items[2].text) == "3"

        override_entries: darray[ConfigEntry] = [ConfigEntry{key: "dependencies", value: "external-override"}]
        overrides: ConfigLayer = ConfigLayer{source: ConfigSource.Environment, entries: override_entries}
        resolution: ConfigTomlResolution = resolve_toml_config_layers(project_arrays, [overrides])
        assert resolution.values.count == 3
        assert resolution.values[0].key == "dependencies"
        assert resolution.values[0].source == ConfigSource.Environment
        assert resolution.values[0].kind == ConfigTomlValueKind.Text
        assert bytes_view(resolution.values[0].text) == "external-override"
        assert resolution.values[0].raw_value == "external-override"
        assert resolution.values[1].key == "markers"
        assert resolution.values[1].source == ConfigSource.File
        assert resolution.values[1].kind == ConfigTomlValueKind.Array
        assert resolution.values[1].items.count == 2
        assert resolution.values[1].raw_value == "[\"campaign: long-running\", 'fast']"

        multiline_array: ConfigTomlLayer = parse_toml_config("dependencies = [\n  \"setuptools>=68\", # build backend\n  \"wheel\",\n]\nafter = true\n")
        multiline_index: usize = lookup_toml_config_value(multiline_array, "dependencies")
        assert multiline_array.values[multiline_index].items.count == 2
        assert bytes_view(multiline_array.values[multiline_index].items[0].text) == "setuptools>=68"
        assert bytes_view(multiline_array.values[multiline_index].items[1].text) == "wheel"
        assert multiline_array.layer.entries[1].key == "after"

        mixed_array: ConfigTomlLayer = parse_toml_config("items = [1, \"two\", true, 2.5]\n")
        items_index: usize = lookup_toml_config_value(mixed_array, "items")
        assert items_index < mixed_array.values.count
        assert mixed_array.values[items_index].items.count == 4
        assert mixed_array.values[items_index].items[0].kind == ConfigTomlValueKind.Integer
        assert mixed_array.values[items_index].items[1].kind == ConfigTomlValueKind.Text
        assert mixed_array.values[items_index].items[2].kind == ConfigTomlValueKind.Boolean
        assert mixed_array.values[items_index].items[3].kind == ConfigTomlValueKind.Float

        inline_dependency: ConfigTomlLayer = parse_toml_config("dependency = { version = \"1.2\", optional = true, features = [\"derive\", \"serde\"] }\nafter = 1\n")
        dependency_index: usize = lookup_toml_config_value(inline_dependency, "dependency")
        assert dependency_index < inline_dependency.values.count
        assert inline_dependency.values[dependency_index].kind == ConfigTomlValueKind.InlineTable
        assert inline_dependency.values[dependency_index].fields.count == 3
        assert bytes_view(inline_dependency.values[dependency_index].fields[0].key) == "version"
        assert bytes_view(inline_dependency.values[dependency_index].fields[0].text) == "1.2"
        assert inline_dependency.values[dependency_index].fields[1].kind == ConfigTomlValueKind.Boolean
        assert inline_dependency.values[dependency_index].fields[2].kind == ConfigTomlValueKind.Array
        assert bytes_view(inline_dependency.values[dependency_index].fields[2].items[1].text) == "serde"
        assert inline_dependency.layer.entries[1].key == "after"

        trailing_junk_rejected: mutable bool = false
        catch parse_toml_config("items = [1] unexpected\n"):
            ok parsed:
                assert false
            error failure:
                trailing_junk_rejected <- failure == ConfigTomlError.UnsupportedValue
        assert trailing_junk_rejected

        duplicate_inline_key_rejected: mutable bool = false
        catch parse_toml_config("dependency = { version = \"1\", version = \"2\" }\n"):
            ok parsed:
                assert false
            error failure:
                duplicate_inline_key_rejected <- failure == ConfigTomlError.DuplicateKey
        assert duplicate_inline_key_rejected

        nested_inline_table_rejected: mutable bool = false
        catch parse_toml_config("dependency = { source = { git = \"url\" } }\n"):
            ok parsed:
                assert false
            error failure:
                nested_inline_table_rejected <- failure == ConfigTomlError.UnsupportedValue
        assert nested_inline_table_rejected

@test
def array_table_rows_preserve_header_order_and_instance_indices() -> void:
    can Memory.Allocate, Abort.Panic:
        source: sview = "[[params.links.user]]\nname = \"User mailing list\"\n[[params.links.user]]\nname = \"Second user link\"\n[[params.links.developer]]\nname = \"GitHub\"\n"
        parsed: ConfigTomlLayer = parse_toml_config(source)
        assert parsed.layer.entries.count == 3
        assert parsed.layer.entries[0].key == "params.links.user.0.name"
        assert parsed.layer.entries[0].value == "User mailing list"
        assert parsed.layer.entries[1].key == "params.links.user.1.name"
        assert parsed.layer.entries[1].value == "Second user link"
        assert parsed.layer.entries[2].key == "params.links.developer.0.name"
        assert parsed.layer.entries[2].value == "GitHub"
        assert parsed.array_tables.count == 3
        assert bytes_view(parsed.array_tables[0].path) == "params.links.user"
        assert parsed.array_tables[0].index == 0
        assert parsed.array_tables[1].index == 1
        assert bytes_view(parsed.array_tables[2].path) == "params.links.developer"
        assert parsed.array_tables[2].index == 0
        resolved_rows: ConfigTomlResolution = resolve_toml_config_layers(parsed, [])
        assert resolved_rows.values.count == 3
        assert resolved_rows.array_tables.count == 3
        assert resolved_rows.array_tables[1].index == 1

        empty_rows: ConfigTomlLayer = parse_toml_config("[[empty]]\n[[empty]]\n")
        assert empty_rows.layer.entries.count == 0
        assert empty_rows.array_tables.count == 2
        assert empty_rows.array_tables[0].index == 0
        assert empty_rows.array_tables[1].index == 1

        nested_table: ConfigTomlLayer = parse_toml_config("[[product]]\nname = \"widget\"\n[product.metadata]\nchannel = \"stable\"\n[[product]]\nname = \"gadget\"\n[product.metadata]\nchannel = \"beta\"\n[other]\nenabled = true\n[product.labels]\nshort = \"g\"\n")
        assert nested_table.layer.entries.count == 6
        assert nested_table.layer.entries[1].key == "product.0.metadata.channel"
        assert nested_table.layer.entries[1].value == "stable"
        assert nested_table.layer.entries[3].key == "product.1.metadata.channel"
        assert nested_table.layer.entries[3].value == "beta"
        assert nested_table.layer.entries[5].key == "product.1.labels.short"
        assert nested_table.layer.entries[5].value == "g"

        nested_array_table_rejected: mutable bool = false
        catch parse_toml_config("[[product]]\nname = \"widget\"\n[[product.variant]]\nname = \"mini\"\n"):
            ok parsed:
                assert false
            error failure:
                nested_array_table_rejected <- failure == ConfigTomlError.UnsupportedValue
        assert nested_array_table_rejected


@test
def toml_configuration_rejects_unsupported_values_and_escapes() -> void:
    can Memory.Allocate, Abort.Panic:
        nested_array_rejected: mutable bool = false
        catch parse_toml_config("items = [[1], 2]\n"):
            ok parsed:
                assert false
            error failure:
                nested_array_rejected <- failure == ConfigTomlError.UnsupportedValue
        assert nested_array_rejected

        quoted_key_rejected: mutable bool = false
        catch parse_toml_config("\"quoted key\" = 1\n"):
            ok parsed:
                assert false
            error failure:
                quoted_key_rejected <- failure == ConfigTomlError.InvalidKey
        assert quoted_key_rejected

        unicode_escape_rejected: mutable bool = false
        catch parse_toml_config("name = \"\\u0041\"\n"):
            ok parsed:
                assert false
            error failure:
                unicode_escape_rejected <- failure == ConfigTomlError.UnsupportedEscape
        assert unicode_escape_rejected


@test
def toml_configuration_rejects_duplicate_and_invalid_keys() -> void:
    can Memory.Allocate, Abort.Panic:
        duplicate_rejected: mutable bool = false
        catch parse_toml_config("[build]\nmode = \"release\"\n[build]\n"):
            ok parsed:
                assert false
            error failure:
                duplicate_rejected <- failure == ConfigTomlError.DuplicateTable
        assert duplicate_rejected

        # Digit-leading bare key segments are part of TOML's bare-key grammar.
        numeric_key: ConfigTomlLayer = parse_toml_config("123 = \"accepted\"\n")
        assert numeric_key.layer.entries.count == 1
        assert numeric_key.layer.entries[0].key == "123"

        invalid_number_rejected: mutable bool = false
        catch parse_toml_config("bad = 01\n"):
            ok parsed:
                assert false
            error failure:
                invalid_number_rejected <- failure == ConfigTomlError.InvalidNumber
        assert invalid_number_rejected
