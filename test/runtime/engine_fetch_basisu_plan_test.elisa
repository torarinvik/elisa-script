include "../../ports/elisa-engine/scripts/fetch_basisu_plan.elisa"

using EsEngineFetchBasisuPlan


@test
def basisu_fetch_plan_pins_clone_and_revision_commands() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    checkout: Path = path("/fixture/dependencies/basisu with spaces")
    clone: Command = clone_command(checkout)
    revision: Command = revision_command(checkout)
    assert clone.program == "git"
    assert clone.arguments == ["clone", "--depth", "1", Dependency::REPOSITORY, f"{checkout}"]
    assert revision.program == "git"
    assert revision.arguments == ["-C", f"{checkout}", "rev-parse", "HEAD"]
    assert command_text(revision) == "git -C /fixture/dependencies/basisu with spaces rev-parse HEAD"


@test
def basisu_fetch_plan_pins_release_cmake_configuration_and_target() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    checkout: Path = path("/fixture/dependencies/basisu")
    build: Path = checkout.joinpath("build")
    configure: Command = configure_command(checkout, build)
    compile: Command = build_command(build)
    assert configure.program == "cmake"
    assert configure.arguments == ["-S", f"{checkout}", "-B", f"{build}", "-DCMAKE_BUILD_TYPE=Release"]
    assert compile.program == "cmake"
    assert compile.arguments == ["--build", f"{build}", "--target", "basisu"]
    assert Dependency::COMMIT == "99f52d63aa6799cbdaecfe977111dc5ec3b31d47"
