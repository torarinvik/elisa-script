include "../../src/testing/geometry_subset_material_cases.elisa"

using EsGeometrySubsetMaterialCases


@test
def geometry_subset_material_fixtures_preserve_order_names_and_validation_edges() -> void can[Memory.Allocate, Abort.Panic]:
    generated: darray[Case] = cases()
    expected_names: darray[sview] = [
        "materials.pkg", "material-names.pkg", "single-material.pkg", "material-bounds.pkg",
        "materials-without-subsets.pkg", "material-names-without-materials.pkg",
        "material-names-truncated.pkg", "material-name-too-long.pkg", "material-name-invalid-utf8.pkg",
        "material-name-nul.pkg", "material-names-trailing.pkg", "skinned-materials.pkg",
        "material-stride.pkg", "material-no-stride.pkg", "material-no-records.pkg",
        "material-short.pkg", "material-long.pkg", "material-above-one.pkg", "material-negative.pkg",
        "material-nan.pkg", "material-infinite.pkg", "material-cutoff.pkg", "material-mask.pkg",
        "material-mode.pkg", "material-flags.pkg", "material-occlusion.pkg"
    ]
    assert generated.count == expected_names.count
    for index in 0..<generated.count |generated, expected_names|:
        assert generated[index].file_name == expected_names[index]
        assert (generated[index].expected_diagnostic != "") == (generated[index].verdict == Verdict.Reject)

    assert generated[1].material_names == ["First", "Second"]
    assert generated[5].has_material_name_payload
    assert generated[5].material_name_payload.count == 0
    assert generated[7].material_name_payload.count == 265
    assert generated[8].material_name_payload[4] == 192u8
    assert generated[9].material_name_payload[4] == 0u8
    assert generated[19].materials[1].factors[4].kind == NumberKind.NaN
    assert generated[20].materials[1].factors[8].kind == NumberKind.PositiveInfinity
    assert generated[24].materials[1].flags == 4u32
