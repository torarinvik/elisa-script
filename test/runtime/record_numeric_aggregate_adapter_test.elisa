include "../../src/runtime/record_numeric_model.elisa"
include "../../src/runtime/record_aggregate_model.elisa"
include "../../src/runtime/record_numeric_aggregate_adapter_model.elisa"

using EsRecordAggregate
using EsRecordNumeric
using EsRecordNumericAggregate


@test
def checked_numeric_fields_feed_insertion_ordered_aggregate() -> void:
    can Memory.Allocate, Abort.Panic:
        policy: RecordAggregatePolicy = RecordAggregatePolicy{max_groups: 3, max_events: 4, max_key_bytes: 32, max_sum: 8}
        aggregate: mutable RecordAggregateSession = RecordAggregateSession{policy: policy}
        assert advance_record_aggregate(aggregate, RecordAggregateEvent.Begin) == RecordAggregateState.Collecting

        negative: mutable RecordNumericSession = RecordNumericSession{policy: RecordNumericPolicy{kind: RecordNumericKind.Integer, max_bytes: 8, max_digits: 8, max_exponent_digits: 2}}
        assert advance_record_numeric(negative, RecordNumericEvent.Begin) == RecordNumericState.Parsing
        for byte in [45u8, 53u8] |negative|:
            _ = advance_record_numeric(negative, RecordNumericEvent.Byte, byte)
        assert advance_record_numeric(negative, RecordNumericEvent.Finish) == RecordNumericState.Complete
        assert record_aggregate_add_numeric(aggregate, "alpha", negative) == RecordAggregateState.Collecting

        positive: mutable RecordNumericSession = RecordNumericSession{policy: RecordNumericPolicy{kind: RecordNumericKind.Integer, max_bytes: 8, max_digits: 8, max_exponent_digits: 2}}
        assert advance_record_numeric(positive, RecordNumericEvent.Begin) == RecordNumericState.Parsing
        assert advance_record_numeric(positive, RecordNumericEvent.Byte, 3u8) == RecordNumericState.Parsing
        assert advance_record_numeric(positive, RecordNumericEvent.Finish) == RecordNumericState.Complete
        assert record_aggregate_add_numeric(aggregate, "alpha", positive) == RecordAggregateState.Collecting

        too_large: mutable RecordNumericSession = RecordNumericSession{policy: RecordNumericPolicy{kind: RecordNumericKind.Integer, max_bytes: 8, max_digits: 8, max_exponent_digits: 2}}
        _ = advance_record_numeric(too_large, RecordNumericEvent.Begin)
        for byte in [57u8, 57u8] |too_large|:
            _ = advance_record_numeric(too_large, RecordNumericEvent.Byte, byte)
        _ = advance_record_numeric(too_large, RecordNumericEvent.Finish)
        sum_limit_rejected: mutable bool = false
        catch record_aggregate_add_numeric(aggregate, "alpha", too_large):
            ok value:
                assert false
            error failure:
                sum_limit_rejected <- failure == RecordAggregateError.SumLimitExceeded
        assert sum_limit_rejected
        assert aggregate.event_count == 2 and aggregate.groups.count == 1
        assert aggregate.groups[0].key == "alpha" and aggregate.groups[0].sum == -2
        assert advance_record_aggregate(aggregate, RecordAggregateEvent.Seal) == RecordAggregateState.Sealed
        assert record_aggregate_group_count(aggregate, "alpha") == 2
        assert record_aggregate_group_sum(aggregate, "alpha") == -2
