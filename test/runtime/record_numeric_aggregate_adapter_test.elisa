include "../../src/runtime/record_model.elisa"
include "../../src/runtime/record_numeric_model.elisa"
include "../../src/runtime/record_aggregate_model.elisa"
include "../../src/runtime/record_numeric_aggregate_adapter_model.elisa"

using EsRecord
using EsRecordAggregate
using EsRecordNumeric
using EsRecordNumericAggregate


@test
def checked_numeric_fields_feed_insertion_ordered_aggregate() -> void:
    can Memory.Allocate, Abort.Panic:
        policy: RecordAggregatePolicy = RecordAggregatePolicy{max_groups: 3, max_events: 4, max_key_bytes: 32, max_sum: 8}
        numeric_policy: RecordNumericPolicy = RecordNumericPolicy{kind: RecordNumericKind.Integer, max_bytes: 8, max_digits: 8, max_exponent_digits: 2, trim_ascii_whitespace: true}
        aggregate: mutable RecordAggregateSession = RecordAggregateSession{policy: policy}
        assert advance_record_aggregate(aggregate, RecordAggregateEvent.Begin) == RecordAggregateState.Collecting

        assert record_aggregate_add_numeric_field(aggregate, "alpha", " \t-5\r\n", numeric_policy) == RecordAggregateState.Collecting
        assert record_aggregate_add_numeric_field(aggregate, "alpha", "3", numeric_policy) == RecordAggregateState.Collecting
        sum_limit_rejected: mutable bool = false
        catch record_aggregate_add_numeric_field(aggregate, "alpha", "99", numeric_policy):
            ok value:
                assert false
            error failure:
                sum_limit_rejected <- failure == RecordAggregateError.SumLimitExceeded
        assert sum_limit_rejected

        malformed_field_rejected: mutable bool = false
        catch record_aggregate_add_numeric_field(aggregate, "alpha", "9x", numeric_policy):
            ok value:
                assert false
            error failure:
                malformed_field_rejected <- failure == RecordNumericError.InvalidCharacter
        assert malformed_field_rejected

        byte_limit_rejected: mutable bool = false
        catch record_aggregate_add_numeric_field(aggregate, "alpha", "        9", numeric_policy):
            ok value:
                assert false
            error failure:
                byte_limit_rejected <- failure == RecordNumericError.TextLimitExceeded
        assert byte_limit_rejected
        assert aggregate.event_count == 2 and aggregate.groups.count == 1
        assert aggregate.groups[0].key == "alpha" and aggregate.groups[0].sum == -2
        assert advance_record_aggregate(aggregate, RecordAggregateEvent.Seal) == RecordAggregateState.Sealed
        assert record_aggregate_group_count(aggregate, "alpha") == 2
        assert record_aggregate_group_sum(aggregate, "alpha") == -2


@test
def materialized_numeric_fields_are_validated_before_aggregation() -> void:
    can Memory.Allocate, Abort.Panic:
        aggregate_policy: RecordAggregatePolicy = RecordAggregatePolicy{max_groups: 2, max_events: 3, max_key_bytes: 16, max_sum: 20}
        numeric_policy: RecordNumericPolicy = RecordNumericPolicy{kind: RecordNumericKind.Integer, max_bytes: 8, max_digits: 8, max_exponent_digits: 2}
        record_policy: mutable RecordStreamPolicy = RecordStreamPolicy{}
        aggregate: mutable RecordAggregateSession = RecordAggregateSession{policy: aggregate_policy}
        assert advance_record_aggregate(aggregate, RecordAggregateEvent.Begin) == RecordAggregateState.Collecting

        record: mutable Record = Record{source: "fixture", raw: "7"}
        field: mutable RecordField = RecordField{index: 0, start_byte: 0, end_byte: 1, value: "7"}
        assert record_aggregate_add_numeric_record_field(aggregate, "alpha", record, field, record_policy, numeric_policy) == RecordAggregateState.Collecting
        assert aggregate.event_count == 1 and aggregate.groups[0].sum == 7

        absent_record: mutable Record = Record{source: "fixture", raw: ""}
        absent_field: mutable RecordField = RecordField{index: 0, start_byte: 0, end_byte: 0, value: "", present: false}
        absent_rejected: mutable bool = false
        catch record_aggregate_add_numeric_record_field(aggregate, "alpha", absent_record, absent_field, record_policy, numeric_policy):
            ok value:
                assert false
            error failure:
                absent_rejected <- failure == RecordContractError.InvalidFieldRange
        assert absent_rejected

        mismatched_record: mutable Record = Record{source: "fixture", raw: "7"}
        mismatched_field: mutable RecordField = RecordField{index: 0, start_byte: 0, end_byte: 1, value: "8"}
        mismatched_rejected: mutable bool = false
        catch record_aggregate_add_numeric_record_field(aggregate, "alpha", mismatched_record, mismatched_field, record_policy, numeric_policy):
            ok value:
                assert false
            error failure:
                mismatched_rejected <- failure == RecordContractError.InvalidFieldRange
        assert mismatched_rejected
        assert aggregate.event_count == 1 and aggregate.groups.count == 1 and aggregate.groups[0].sum == 7


@test
def record_key_and_numeric_fields_aggregate_as_one_validated_event() -> void:
    can Memory.Allocate, Abort.Panic:
        aggregate_policy: RecordAggregatePolicy = RecordAggregatePolicy{max_groups: 2, max_events: 2, max_key_bytes: 16, max_sum: 20}
        numeric_policy: RecordNumericPolicy = RecordNumericPolicy{kind: RecordNumericKind.Integer, max_bytes: 8, max_digits: 8, max_exponent_digits: 2}
        record_policy: mutable RecordStreamPolicy = RecordStreamPolicy{field_mode: RecordFieldMode.Literal, field_separator: ","}
        aggregate: mutable RecordAggregateSession = RecordAggregateSession{policy: aggregate_policy}
        assert advance_record_aggregate(aggregate, RecordAggregateEvent.Begin) == RecordAggregateState.Collecting

        record: mutable Record = Record{source: "fixture", raw: "alpha,7"}
        key_field: mutable RecordField = RecordField{index: 0, start_byte: 0, end_byte: 5, value: "alpha"}
        value_field: mutable RecordField = RecordField{index: 1, start_byte: 6, end_byte: 7, value: "7"}
        assert record_aggregate_add_numeric_record_fields(aggregate, record, key_field, value_field, record_policy, numeric_policy) == RecordAggregateState.Collecting
        assert aggregate.event_count == 1 and aggregate.groups.count == 1
        assert aggregate.groups[0].key == "alpha" and aggregate.groups[0].sum == 7

        absent_value_record: mutable Record = Record{source: "fixture", raw: "alpha,"}
        absent_key_field: mutable RecordField = RecordField{index: 0, start_byte: 0, end_byte: 5, value: "alpha"}
        absent_value_field: mutable RecordField = RecordField{index: 1, start_byte: 6, end_byte: 6, value: "", present: false}
        absent_value_rejected: mutable bool = false
        catch record_aggregate_add_numeric_record_fields(aggregate, absent_value_record, absent_key_field, absent_value_field, record_policy, numeric_policy):
            ok value:
                assert false
            error failure:
                absent_value_rejected <- failure == RecordContractError.InvalidFieldRange
        assert absent_value_rejected
        assert aggregate.event_count == 1 and aggregate.groups[0].sum == 7
