include "../../src/runtime/build_model.elisa"
include "../../src/runtime/build_incremental_model.elisa"
include "../../src/runtime/build_incremental_cache_model.elisa"

using EsBuild
using EsBuildIncremental
using EsBuildIncrementalCache


@test
def incremental_cache_codec_round_trips_a_valid_manifest() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        targets: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 60, recipe_signature: BuildRecipeSignature{word0: 31, word1: 32, word2: 33, word3: 34}, inputs: [BuildIncrementalFile{path: "src/main.c", fingerprint: 11, fingerprint_word1: 12, fingerprint_word2: 13, fingerprint_word3: 14}], outputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22, fingerprint_word1: 23, fingerprint_word2: 24, fingerprint_word3: 25}]},
            BuildIncrementalTarget{name: "link", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 41, recipe_signature: BuildRecipeSignature{word0: 41}, inputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}], outputs: [BuildIncrementalFile{path: "build/app", fingerprint: 42}], dependencies: ["compile"]}
        ]
        encoded: darray[u8] = encode_build_incremental_cache(targets)
        assert encoded[4] == 4u8
        decoded: darray[BuildIncrementalTarget] = decode_build_incremental_cache(encoded)
        assert decoded == targets
        assert encode_build_incremental_cache(decoded) == encoded


@test
def incremental_cache_codec_rejects_checksum_corruption() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        targets: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "check", kind: BuildIncrementalTargetKind.Phony, recipe_fingerprint: 51, recipe_signature: BuildRecipeSignature{word0: 51}}
        ]
        encoded: mutable darray[u8] = encode_build_incremental_cache(targets)
        last: usize = encoded.count - 1
        encoded[last] <- encoded[last] ^ 1u8
        rejected: mutable bool = false
        catch decode_build_incremental_cache(encoded):
            ok value:
                assert false
            error failure:
                rejected <- failure == BuildIncrementalCacheError.ChecksumMismatch
        assert rejected


@test
def incremental_cache_codec_rejects_scalar_recipe_v2_records() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        targets: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}, inputs: [BuildIncrementalFile{path: "src/main.c", fingerprint: 11}], outputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}]}
        ]
        encoded: mutable darray[u8] = encode_build_incremental_cache(targets)
        encoded[4] <- 2u8
        rejected: mutable bool = false
        catch decode_build_incremental_cache(encoded):
            ok value:
                assert false
            error failure:
                rejected <- failure == BuildIncrementalCacheError.UnsupportedVersion
        assert rejected


