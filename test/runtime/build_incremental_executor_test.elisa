include "../../src/runtime/process_model.elisa"
include "../../src/runtime/executable_model.elisa"
include "../../src/runtime/build_model.elisa"
include "../../src/runtime/build_incremental_model.elisa"
include "../../src/runtime/build_executor_model.elisa"

using EsProcess
using EsExecutable
using EsBuild
using EsBuildIncremental
using EsBuildExecutor


@test
def incremental_executor_marks_up_to_date_nodes_as_cache_hits() -> void:
    can Memory.Allocate, Abort.Panic, Process.Run:
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, inputs: [BuildIncrementalFile{path: "src/main.c", fingerprint: 11}], outputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}]},
            BuildIncrementalTarget{name: "link", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 41, inputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}], outputs: [BuildIncrementalFile{path: "build/app", fingerprint: 42}], dependencies: ["compile"]}
        ]
        recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, inputs: ["src/main.c"], outputs: ["build/main.o"]},
            BuildIncrementalRecipeTarget{name: "link", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 41, inputs: ["build/main.o"], outputs: ["build/app"], dependencies: ["compile"]}
        ]
        observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/main.c", present: true, fingerprint: 11},
            BuildIncrementalObservation{path: "build/main.o", present: true, fingerprint: 22},
            BuildIncrementalObservation{path: "build/app", present: true, fingerprint: 42}
        ]
        graph: mutable BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "compile", command: ProcessCommand{executable: "compiler-not-invoked"}, fingerprint: 31},
            BuildNode{name: "link", command: ProcessCommand{executable: "linker-not-invoked"}, dependencies: [0], fingerprint: 41}
        ]}
        result: BuildExecutionResult = execute_build_graph_incremental(graph, previous, recipes, observations)
        assert result.graph_state == BuildGraphState.Succeeded
        assert result.nodes.count == 2
        assert result.nodes[0].cache_hit and not result.nodes[0].started
        assert result.nodes[1].cache_hit and not result.nodes[1].started
        assert result.log_bytes == 0 and graph.log_bytes == 0

        committed: BuildIncrementalCommit = commit_build_incremental_execution(result, graph, previous, recipes, observations)
        assert committed.targets.count == 2 and committed.stale_outputs_after_success.count == 0

        failed_result: mutable BuildExecutionResult = result
        failed_result.graph_state <- BuildGraphState.Failed
        rejected: mutable bool = false
        catch commit_build_incremental_execution(failed_result, graph, previous, recipes, observations):
            ok value:
                assert false
            error failure:
                rejected <- failure == BuildExecutionError.ExecutionNotSuccessful
        assert rejected
