include "../../src/runtime/encoding.elisa"
include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../src/runtime/json_lexer_model.elisa"
include "../../src/runtime/json_parse_model.elisa"
include "../../src/runtime/python_json_projection.elisa"
include "../../src/runtime/bounded_text_posix.elisa"
include "../../src/runtime/framework_fixture_matrix_model.elisa"

using EsFrameworkFixtureMatrix


const module FrameworkFixtureMatrixInputs:
    ROOT: sview = "test/fixtures/framework_matrix_root"
    VALID: sview = "{\"schema\":\"wasmbrowser.framework_fixture_matrix.v1\",\"policy\":\"evidence, not blanket support\",\"qt\":{\"status\":\"blocked\",\"backend\":\"not-selected\",\"required_surfaces\":[{\"id\":\"window-creation\",\"status\":\"blocked\",\"missing_prerequisite\":\"consumer\"},{\"id\":\"rendering\",\"status\":\"blocked\",\"missing_prerequisite\":\"consumer\"},{\"id\":\"text-ime\",\"status\":\"blocked\",\"missing_prerequisite\":\"consumer\"},{\"id\":\"focus\",\"status\":\"blocked\",\"missing_prerequisite\":\"consumer\"},{\"id\":\"files\",\"status\":\"blocked\",\"missing_prerequisite\":\"consumer\"},{\"id\":\"timers\",\"status\":\"blocked\",\"missing_prerequisite\":\"consumer\"},{\"id\":\"accessibility\",\"status\":\"blocked\",\"missing_prerequisite\":\"consumer\"}],\"general_interface_candidates\":[\"surface\"],\"general_interface_audit\":[{\"id\":\"window-surface-lifecycle\",\"status\":\"present\",\"contract\":\"evidence/generic-contract.md\"},{\"id\":\"framebuffer-and-typed-rendering\",\"status\":\"present\",\"contract\":\"evidence/generic-contract.md\"},{\"id\":\"committed-text-and-composition\",\"status\":\"present\",\"contract\":\"evidence/generic-contract.md\"},{\"id\":\"focus-ownership\",\"status\":\"present\",\"contract\":\"evidence/generic-contract.md\"},{\"id\":\"authorized-file-selection\",\"status\":\"present\",\"contract\":\"evidence/generic-contract.md\"},{\"id\":\"bounded-timers\",\"status\":\"implemented-tested\",\"contract\":\"evidence/timers.wit\",\"implementation\":[\"evidence/implementation.elisa\"],\"next_step\":\"pinned consumer cancellation trace\"},{\"id\":\"semantic-accessibility-tree\",\"status\":\"present\",\"contract\":\"evidence/generic-contract.md\"}],\"qt_specific_adaptation\":\"SDK recipe only\"},\"wxwidgets\":{\"status\":\"blocked\",\"backend\":\"not-selected\",\"native_widget_assumptions\":[\"identity\"],\"source_changes_required\":[\"pinned consumer\"],\"missing_prerequisite\":\"consumer and host fixture\"}}"


def framework_fixture_matrix_rejects_as(source: sview, root: Path, expected: FrameworkFixtureMatrixError) -> bool can[Blocking.IO, File.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    rejected: mutable bool = false
    catch validate_framework_fixture_matrix_source(source, root):
        ok valid:
            rejected <- not valid
        error failure:
            rejected <- failure == expected
    return rejected


@test
def framework_fixture_matrix_accepts_all_surfaces_and_timer_evidence() -> void can[Blocking.IO, File.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    root: Path = path(FrameworkFixtureMatrixInputs::ROOT)
    assert validate_framework_fixture_matrix_source(FrameworkFixtureMatrixInputs::VALID, root)


@test
def framework_fixture_matrix_preserves_last_duplicate_and_set_coverage_semantics() -> void can[Blocking.IO, File.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    root: Path = path(FrameworkFixtureMatrixInputs::ROOT)
    duplicate_schema: sview = replace(FrameworkFixtureMatrixInputs::VALID, "\"schema\":\"wasmbrowser.framework_fixture_matrix.v1\"", "\"schema\":\"old\",\"schema\":\"wasmbrowser.framework_fixture_matrix.v1\"")
    duplicate_surface: sview = replace(FrameworkFixtureMatrixInputs::VALID, "],\"general_interface_candidates\"", ",{\"id\":\"window-creation\",\"status\":\"blocked\",\"missing_prerequisite\":\"duplicate\"}],\"general_interface_candidates\"")
    python_truthy_policy: sview = replace(FrameworkFixtureMatrixInputs::VALID, "\"policy\":\"evidence, not blanket support\"", "\"policy\":NaN")
    python_truthy_candidates: sview = replace(FrameworkFixtureMatrixInputs::VALID, "\"general_interface_candidates\":[\"surface\"]", "\"general_interface_candidates\":Infinity")
    python_underflow_policy: sview = replace(FrameworkFixtureMatrixInputs::VALID, "\"policy\":\"evidence, not blanket support\"", "\"policy\":1e-9999")
    python_subnormal_policy: sview = replace(FrameworkFixtureMatrixInputs::VALID, "\"policy\":\"evidence, not blanket support\"", "\"policy\":5e-324")
    assert validate_framework_fixture_matrix_source(duplicate_schema, root)
    assert validate_framework_fixture_matrix_source(duplicate_surface, root)
    assert validate_framework_fixture_matrix_source(python_truthy_policy, root)
    assert validate_framework_fixture_matrix_source(python_truthy_candidates, root)
    assert framework_fixture_matrix_rejects_as(python_underflow_policy, root, FrameworkFixtureMatrixError.PolicyMissing)
    assert validate_framework_fixture_matrix_source(python_subnormal_policy, root)


@test
def framework_fixture_matrix_rejects_missing_coverage_policy_and_evidence() -> void can[Blocking.IO, File.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    root: Path = path(FrameworkFixtureMatrixInputs::ROOT)
    no_policy: sview = replace(FrameworkFixtureMatrixInputs::VALID, "\"policy\":\"evidence, not blanket support\"", "\"policy\":\"\"")
    missing_surface: sview = replace(FrameworkFixtureMatrixInputs::VALID, "\"id\":\"accessibility\"", "\"id\":\"unknown-surface\"")
    missing_contract: sview = replace(FrameworkFixtureMatrixInputs::VALID, "evidence/generic-contract.md", "evidence/missing-contract.md")
    missing_prerequisite: sview = replace(FrameworkFixtureMatrixInputs::VALID, "\"missing_prerequisite\":\"consumer\"", "\"missing_prerequisite\":\"\"")
    assert framework_fixture_matrix_rejects_as(no_policy, root, FrameworkFixtureMatrixError.PolicyMissing)
    assert framework_fixture_matrix_rejects_as(missing_surface, root, FrameworkFixtureMatrixError.SurfaceCoverageMismatch)
    assert framework_fixture_matrix_rejects_as(missing_contract, root, FrameworkFixtureMatrixError.ContractFileMissing)
    assert framework_fixture_matrix_rejects_as(missing_prerequisite, root, FrameworkFixtureMatrixError.MissingPrerequisite)
    assert framework_fixture_matrix_rejects_as("{", root, FrameworkFixtureMatrixError.InvalidJson)


@test
def framework_fixture_matrix_requires_timer_contract_and_implementation_evidence() -> void can[Blocking.IO, File.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    root: Path = path(FrameworkFixtureMatrixInputs::ROOT)
    incomplete_contract: sview = replace(FrameworkFixtureMatrixInputs::VALID, "evidence/timers.wit", "evidence/incomplete-timers.wit")
    missing_implementation: sview = replace(FrameworkFixtureMatrixInputs::VALID, "evidence/implementation.elisa", "evidence/missing.elisa")
    assert framework_fixture_matrix_rejects_as(incomplete_contract, root, FrameworkFixtureMatrixError.TimerRequirementMissing)
    assert framework_fixture_matrix_rejects_as(missing_implementation, root, FrameworkFixtureMatrixError.ImplementationMissing)
