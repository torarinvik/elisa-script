include "../../ports/elisa-engine/scripts/elisa_package_cli_model.elisa"

using EsElisaPackageCli


def package_cli_rejects(values: darray[sview], expected: PackageCliError) -> bool can[Memory.Allocate, Abort.Panic]:
    observed: mutable bool = false
    catch parse_texture_arguments(values):
        ok parsed:
            _ = parsed
        error failure:
            observed <- failure == expected
    return observed


@test
def package_cli_helpers_validate_section_names_and_logical_paths() -> void:
    assert safe_section_name("mesh")
    assert safe_section_name("manifest")
    assert safe_section_name("image_2")
    assert not safe_section_name("")
    assert not safe_section_name("Image")
    assert not safe_section_name("image-name")
    assert not safe_section_name("sixteen_char_name")
    assert not safe_section_name("imagé")

    assert safe_logical_path("assets/albedo.png")
    assert safe_logical_path("name:with-colon")
    assert safe_logical_path("line\nbreak")
    assert not safe_logical_path("")
    assert not safe_logical_path("/absolute")
    assert not safe_logical_path("assets/")
    assert not safe_logical_path("assets//albedo.png")
    assert not safe_logical_path("assets/../outside")
    assert not safe_logical_path("assets\\albedo.png")
    assert not safe_logical_path("assets/albedo\0.png")


@test
def package_cli_texture_arguments_split_once_and_reject_duplicates() -> void can[Memory.Allocate, Abort.Panic]:
    parsed: darray[TextureArgument] = try parse_texture_arguments([
        "albedo=assets/albedo=variant.png", "=assets/unnamed.png"
    ])
    assert parsed.count == 2
    assert parsed[0].section_name == "albedo"
    assert parsed[0].path == "assets/albedo=variant.png"
    assert parsed[1].section_name == ""
    assert parsed[1].path == "assets/unnamed.png"
    unvalidated: darray[TextureArgument] = try parse_texture_arguments(["../unsafe=../outside.png"])
    assert unvalidated[0].path == "../outside.png"
    assert package_cli_rejects(["missing-separator"], PackageCliError.InvalidTextureArgument)
    assert package_cli_rejects(["empty=", "other=path"], PackageCliError.InvalidTextureArgument)
    assert package_cli_rejects(["same=one", "same=two"], PackageCliError.DuplicateTextureSection)
