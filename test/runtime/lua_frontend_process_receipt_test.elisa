include "../../src/runtime/process_model.elisa"
include "../../src/testing/lua_frontend_process_receipt.elisa"

using EsProcess
using EsLuaFrontendProcessReceipt


@test
def lua_frontend_process_receipts_distinguish_build_and_parser_exit_codes() -> void:
    build_success: LuaFrontendProcessReceipt = try make_lua_frontend_process_receipt(
        LuaFrontendChildRole.EmitHeader,
        ProcessResult{kind: ProcessResultKind.Exited, exit_status: 0},
        LuaFrontendCleanupFact.ConfirmedQuiescent,
        LuaFrontendSpawnFact.ExecConfirmed,
        LuaFrontendRssGuardFact.Enforced
    )
    build_failure: LuaFrontendProcessReceipt = try make_lua_frontend_process_receipt(
        LuaFrontendChildRole.LinkCandidate,
        ProcessResult{kind: ProcessResultKind.Exited, exit_status: 1, stderr: "link failed"},
        LuaFrontendCleanupFact.ConfirmedQuiescent,
        LuaFrontendSpawnFact.ExecConfirmed,
        LuaFrontendRssGuardFact.Enforced
    )
    parser_accept: LuaFrontendProcessReceipt = try make_lua_frontend_process_receipt(
        LuaFrontendChildRole.RunCandidate,
        ProcessResult{kind: ProcessResultKind.Exited, exit_status: 0, stdout: "checksum=17\n"},
        LuaFrontendCleanupFact.ConfirmedQuiescent,
        LuaFrontendSpawnFact.ExecConfirmed,
        LuaFrontendRssGuardFact.Enforced
    )
    parser_reject: LuaFrontendProcessReceipt = try make_lua_frontend_process_receipt(
        LuaFrontendChildRole.RunReference,
        ProcessResult{kind: ProcessResultKind.Exited, exit_status: 3},
        LuaFrontendCleanupFact.ConfirmedQuiescent,
        LuaFrontendSpawnFact.ExecConfirmed,
        LuaFrontendRssGuardFact.Enforced
    )
    assert build_success.classification == LuaFrontendReceiptClass.BuildSucceeded
    assert build_failure.classification == LuaFrontendReceiptClass.BuildFailed
    assert parser_accept.classification == LuaFrontendReceiptClass.Accepted
    assert parser_reject.classification == LuaFrontendReceiptClass.Rejected


@test
def lua_frontend_process_receipts_keep_abnormal_or_uncertain_outcomes_infrastructure() -> void:
    timeout: LuaFrontendProcessReceipt = try make_lua_frontend_process_receipt(
        LuaFrontendChildRole.RunCandidate,
        ProcessResult{kind: ProcessResultKind.TimedOut},
        LuaFrontendCleanupFact.ConfirmedQuiescent,
        LuaFrontendSpawnFact.ExecConfirmed,
        LuaFrontendRssGuardFact.Enforced
    )
    signaled: LuaFrontendProcessReceipt = try make_lua_frontend_process_receipt(
        LuaFrontendChildRole.RunReference,
        ProcessResult{kind: ProcessResultKind.Signaled, signal: 9},
        LuaFrontendCleanupFact.ConfirmedQuiescent,
        LuaFrontendSpawnFact.ExecConfirmed,
        LuaFrontendRssGuardFact.Enforced
    )
    output_limited: LuaFrontendProcessReceipt = try make_lua_frontend_process_receipt(
        LuaFrontendChildRole.RunCandidate,
        ProcessResult{kind: ProcessResultKind.OutputLimit},
        LuaFrontendCleanupFact.ConfirmedQuiescent,
        LuaFrontendSpawnFact.ExecConfirmed,
        LuaFrontendRssGuardFact.Enforced
    )
    unknown_descendant: LuaFrontendProcessReceipt = try make_lua_frontend_process_receipt(
        LuaFrontendChildRole.RunReference,
        ProcessResult{kind: ProcessResultKind.Exited, exit_status: 0},
        LuaFrontendCleanupFact.DescendantsUnknown,
        LuaFrontendSpawnFact.ExecConfirmed,
        LuaFrontendRssGuardFact.Enforced
    )
    failed_cleanup: LuaFrontendProcessReceipt = try make_lua_frontend_process_receipt(
        LuaFrontendChildRole.EmitObject,
        ProcessResult{kind: ProcessResultKind.Exited, exit_status: 0},
        LuaFrontendCleanupFact.CleanupFailed,
        LuaFrontendSpawnFact.ExecConfirmed,
        LuaFrontendRssGuardFact.Enforced
    )
    spawn_failure_as_exit_127: LuaFrontendProcessReceipt = try make_lua_frontend_process_receipt(
        LuaFrontendChildRole.RunCandidate,
        ProcessResult{kind: ProcessResultKind.Exited, exit_status: 127},
        LuaFrontendCleanupFact.ConfirmedQuiescent,
        LuaFrontendSpawnFact.ExecFailed,
        LuaFrontendRssGuardFact.Enforced
    )
    missing_rss_guard: LuaFrontendProcessReceipt = try make_lua_frontend_process_receipt(
        LuaFrontendChildRole.RunReference,
        ProcessResult{kind: ProcessResultKind.Exited, exit_status: 0},
        LuaFrontendCleanupFact.ConfirmedQuiescent,
        LuaFrontendSpawnFact.ExecConfirmed,
        LuaFrontendRssGuardFact.NotEnforced
    )
    assert timeout.classification == LuaFrontendReceiptClass.InfrastructureFailure
    assert signaled.classification == LuaFrontendReceiptClass.InfrastructureFailure
    assert output_limited.classification == LuaFrontendReceiptClass.InfrastructureFailure
    assert unknown_descendant.classification == LuaFrontendReceiptClass.InfrastructureFailure
    assert failed_cleanup.classification == LuaFrontendReceiptClass.InfrastructureFailure
    assert spawn_failure_as_exit_127.classification == LuaFrontendReceiptClass.InfrastructureFailure
    assert missing_rss_guard.classification == LuaFrontendReceiptClass.InfrastructureFailure
