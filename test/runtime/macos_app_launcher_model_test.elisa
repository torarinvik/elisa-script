include "../../src/runtime/data_model.elisa"
include "../../src/runtime/macos_app_launcher_model.elisa"

using EsData
using EsMacosAppLauncher


@test
def renders_the_reference_launcher_defaults() -> void can[Memory.Allocate, Abort.Panic]:
    launcher: darray[u8] = try macos_app_launcher_text("Maze Game.bin", "Maze Game", 1280, 720, "")
    expected: sview = "#!/bin/sh\nset -eu\nresources=\"$(CDPATH= cd -- \"$(dirname -- \"$0\")/../Resources\" && pwd)\"\ncd \"$resources\"\n: \"${ELISA_PROJECT_TITLE:='Maze Game'}\"\n: \"${ELISA_PROJECT_WIDTH:=1280}\"\n: \"${ELISA_PROJECT_HEIGHT:=720}\"\nexport ELISA_PROJECT_TITLE ELISA_PROJECT_WIDTH ELISA_PROJECT_HEIGHT\nif [ -d \"$resources/shaders\" ]; then\n    ELISA_ENGINE_SHADER_PATH=\"$resources/shaders\"\n    export ELISA_ENGINE_SHADER_PATH\n    if [ -f \"$resources/shaders/elisa.shader-manifest.json\" ]; then\n        ELISA_ENGINE_SHADER_MANIFEST=\"$resources/shaders/elisa.shader-manifest.json\"\n        export ELISA_ENGINE_SHADER_MANIFEST\n    fi\nfi\nexec \"$resources/Maze Game.bin\" \"$@\"\n"
    assert bytes_view(launcher) == expected


@test
def shell_quotes_titles_and_build_identity_like_shlex() -> void can[Memory.Allocate, Abort.Panic]:
    launcher: darray[u8] = try macos_app_launcher_text("Maze.bin", "A game's $(touch /tmp/pwned)", 800, 600, "build's $(false)")
    expected: sview = "#!/bin/sh\nset -eu\nresources=\"$(CDPATH= cd -- \"$(dirname -- \"$0\")/../Resources\" && pwd)\"\ncd \"$resources\"\n: \"${ELISA_PROJECT_TITLE:='A game'\"'\"'s $(touch /tmp/pwned)'}\"\n: \"${ELISA_PROJECT_WIDTH:=800}\"\n: \"${ELISA_PROJECT_HEIGHT:=600}\"\nexport ELISA_PROJECT_TITLE ELISA_PROJECT_WIDTH ELISA_PROJECT_HEIGHT\nif [ -d \"$resources/shaders\" ]; then\n    ELISA_ENGINE_SHADER_PATH=\"$resources/shaders\"\n    export ELISA_ENGINE_SHADER_PATH\n    if [ -f \"$resources/shaders/elisa.shader-manifest.json\" ]; then\n        ELISA_ENGINE_SHADER_MANIFEST=\"$resources/shaders/elisa.shader-manifest.json\"\n        export ELISA_ENGINE_SHADER_MANIFEST\n    fi\nfi\necho 'build'\"'\"'s $(false)' >&2\nexec \"$resources/Maze.bin\" \"$@\"\n"
    assert bytes_view(launcher) == expected


@test
def rejects_launcher_binary_names_outside_the_safe_bundle_domain() -> void can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch macos_app_launcher_text("../Maze.bin\";touch pwned", "Maze", 1280, 720, ""):
        ok launcher:
            _ = launcher
        error failure:
            rejected <- failure == MacosAppLauncherError.InvalidBinaryName
    assert rejected
