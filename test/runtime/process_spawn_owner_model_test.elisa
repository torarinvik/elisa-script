# Pure owner observations. No PID is created, signaled, waited for or released.
include "../../src/runtime/process_spawn_owner_model.elisa"

using EsProcessSpawnOwner


@test
def spawn_owner_captures_pid_before_later_attribute_cleanup_can_fail() -> void:
    owner: mutable Owner = Owner{resource_id: 11, owner_token: 7, state: State.Reserved}
    decision: EsProcessSpawnAttempt::Decision = observe(owner, EsProcessSpawnAttempt::classify(0, 41))
    assert decision == EsProcessSpawnAttempt::Decision.AdoptChild
    assert owner.state == State.Running and owner.pid == 41 and owner.attempts == 1
    assert not can_attempt(owner) and not can_release_without_wait(owner)
    # A later cleanup's failure must not reinterpret or erase a captured PID.
    exhausted(owner)
    assert owner.state == State.Running and owner.pid == 41
    repeated: EsProcessSpawnAttempt::Decision = observe(owner, EsProcessSpawnAttempt::classify(2, 0))
    assert repeated == EsProcessSpawnAttempt::Decision.StopUncertain
    assert owner.state == State.Running and owner.pid == 41 and owner.attempts == 1


@test
def spawn_owner_denied_then_missing_exhaustion_retains_no_child_outcome() -> void:
    owner: mutable Owner = Owner{resource_id: 11, owner_token: 7, state: State.Reserved}
    first: EsProcessSpawnAttempt::Decision = observe(owner, EsProcessSpawnAttempt::classify(13, 999))
    assert first == EsProcessSpawnAttempt::Decision.NextDenied and owner.saw_denied
    second: EsProcessSpawnAttempt::Decision = observe(owner, EsProcessSpawnAttempt::classify(2, 0))
    assert second == EsProcessSpawnAttempt::Decision.NextCandidate and can_attempt(owner)
    exhausted(owner)
    assert owner.state == State.NoChild and owner.pid == 0 and owner.attempts == 2
    assert owner.code == 13 and can_release_without_wait(owner)
    assert owner.diagnostic_pid == 0


@test
def spawn_owner_fatal_and_unknown_returns_do_not_authorize_unowned_pids() -> void:
    fatal: mutable Owner = Owner{resource_id: 11, owner_token: 7, state: State.Reserved}
    stopped: EsProcessSpawnAttempt::Decision = observe(fatal, EsProcessSpawnAttempt::classify(8, 41))
    assert stopped == EsProcessSpawnAttempt::Decision.StopNoChild
    assert fatal.state == State.NoChild and fatal.pid == 0 and can_release_without_wait(fatal)
    unknown: mutable Owner = Owner{resource_id: 12, owner_token: 7, state: State.Reserved}
    uncertain: EsProcessSpawnAttempt::Decision = observe(unknown, EsProcessSpawnAttempt::classify(-1, 41))
    assert uncertain == EsProcessSpawnAttempt::Decision.StopUncertain
    assert unknown.state == State.Unknown and unknown.pid == 0 and unknown.diagnostic_pid == 41
    assert not can_attempt(unknown) and not can_release_without_wait(unknown)


@test
def spawn_owner_requires_reservation_fields_and_bounded_attempt_count() -> void:
    assert not can_attempt(Owner{})
    assert not can_attempt(Owner{resource_id: 11, owner_token: 0, state: State.Reserved})
    assert not can_attempt(Owner{resource_id: 11, owner_token: 7, state: State.Reserved, attempts: Limits::ATTEMPTS})
    owner: mutable Owner = Owner{resource_id: 11, owner_token: 7, state: State.Reserved}
    decision: EsProcessSpawnAttempt::Decision = observe(owner, EsProcessSpawnAttempt::classify(2, 0))
    assert decision == EsProcessSpawnAttempt::Decision.NextCandidate
    exhausted(owner)
    assert owner.code == 2 and can_release_without_wait(owner)


@test
def spawn_owner_partial_retry_abort_preserves_last_return_not_exhaustion() -> void:
    owner: mutable Owner = Owner{resource_id: 11, owner_token: 7, state: State.Reserved}
    _ = observe(owner, EsProcessSpawnAttempt::classify(13, 999))
    _ = observe(owner, EsProcessSpawnAttempt::classify(20, 999))
    assert stop_retrying_before_next_attempt(owner)
    assert owner.state == State.NoChild and owner.pid == 0 and owner.diagnostic_pid == 0
    assert owner.code == 20 and owner.saw_denied and owner.attempts == 2
    assert can_release_without_wait(owner)
    exhausted(owner)
    assert owner.code == 20
    assert not stop_retrying_before_next_attempt(owner)


@test
def spawn_owner_retry_abort_rejects_unstarted_running_and_uncertain_fields() -> void:
    unstarted: mutable Owner = Owner{resource_id: 11, owner_token: 7, state: State.Reserved}
    assert not stop_retrying_before_next_attempt(unstarted)
    running: mutable Owner = Owner{resource_id: 11, owner_token: 7, state: State.Reserved}
    _ = observe(running, EsProcessSpawnAttempt::classify(0, 41))
    assert not stop_retrying_before_next_attempt(running)
    assert running.state == State.Running and running.pid == 41
    unknown: mutable Owner = Owner{resource_id: 12, owner_token: 7, state: State.Reserved}
    _ = observe(unknown, EsProcessSpawnAttempt::classify(-1, 41))
    assert not stop_retrying_before_next_attempt(unknown)
    assert unknown.state == State.Unknown and unknown.diagnostic_pid == 41
    malformed: mutable Owner = Owner{resource_id: 11, owner_token: 7, state: State.Reserved, attempts: 1, code: 0}
    assert not stop_retrying_before_next_attempt(malformed)
    excessive: mutable Owner = Owner{resource_id: 11, owner_token: 7, state: State.Reserved, attempts: Limits::ATTEMPTS + 1, code: 2}
    assert not stop_retrying_before_next_attempt(excessive)
    diagnostic: mutable Owner = Owner{resource_id: 11, owner_token: 7, state: State.Reserved, attempts: 1, code: 2, diagnostic_pid: 41}
    assert not stop_retrying_before_next_attempt(diagnostic)
