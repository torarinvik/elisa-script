include "../../src/runtime/bounded_text_posix.elisa"

using EsBoundedText


@test
def bounded_text_path_and_string_path_entrypoints_match() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        path_text: sview = "test/runtime/config_toml_file_fixture.toml"
        path_value: Path = path(path_text)
        from_path: sview = try read_utf8_path_text(f"{path_value}", 16384usize) else failure:
            _ = failure
            assert false
            ""
        from_text: sview = try read_utf8_path_text(path_text, 16384usize) else failure:
            _ = failure
            assert false
            ""
        assert from_path == from_text
