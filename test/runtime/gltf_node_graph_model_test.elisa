include "../../ports/elisa-engine/scripts/gltf_node_graph_model.elisa"

using EsEngineGltfAffine
using EsEngineGltfNodeGraph


@test
def gltf_node_graph_preserves_depth_first_root_and_child_order_and_composes_world_transforms() -> void can[Memory.Allocate, Abort.Panic]:
    root: GltfNode = GltfNode{children: [1u, 2u], local_transform: gltf_node_graph_translation(10.0)}
    first_mesh: GltfNode = GltfNode{has_mesh: true, mesh_index: 0u, local_transform: gltf_node_graph_translation(1.0)}
    second_mesh: GltfNode = GltfNode{has_mesh: true, mesh_index: 1u, local_transform: gltf_node_graph_translation(2.0)}
    nodes: darray[GltfNode] = [root, first_mesh, second_mesh]
    placements: darray[MeshPlacement] = try mesh_placement_records(nodes, [0u], 2u)
    assert placements.count == 2
    assert placements[0].mesh_index == 0u and placements[0].node_index == 1u and placements[0].world_transform.m03 == 11.0
    assert placements[1].mesh_index == 1u and placements[1].node_index == 2u and placements[1].world_transform.m03 == 12.0


@test
def gltf_node_graph_rejects_invalid_ownership_roots_cycles_and_missing_meshes() -> void can[Memory.Allocate, Abort.Panic]:
    shared_child: GltfNode = GltfNode{has_mesh: true, mesh_index: 0u}
    first_parent: GltfNode = GltfNode{children: [2u]}
    second_parent: GltfNode = GltfNode{children: [2u]}
    parents: darray[GltfNode] = [first_parent, second_parent, shared_child]
    assert gltf_node_graph_rejects(parents, [0u, 1u], 1u, false, NodeGraphError.NodeHasMultipleParents)

    child_nodes: darray[GltfNode] = [GltfNode{children: [1u]}, GltfNode{}]
    assert gltf_node_graph_rejects(child_nodes, [0u, 1u], 0u, false, NodeGraphError.RootHasParent)
    assert gltf_node_graph_rejects([GltfNode{}], [0u, 0u], 0u, false, NodeGraphError.InvalidRoot)
    assert gltf_node_graph_rejects([GltfNode{children: [1u]}], [0u], 0u, false, NodeGraphError.ChildIndexOutOfRange)

    disconnected_cycle: darray[GltfNode] = [GltfNode{children: [1u]}, GltfNode{children: [0u]}, GltfNode{}]
    assert gltf_node_graph_rejects(disconnected_cycle, [2u], 0u, false, NodeGraphError.NodeUnreachable)
    assert gltf_node_graph_rejects([GltfNode{}], [0u], 1u, false, NodeGraphError.MeshNotPlaced)


@test
def gltf_node_graph_checks_mesh_invertibility_and_bounds_tracking_memory() -> void can[Memory.Allocate, Abort.Panic]:
    singular_node: GltfNode = GltfNode{has_mesh: true, mesh_index: 0u}
    nodes: darray[GltfNode] = [singular_node]
    roots: darray[usize] = [0u]
    assert gltf_node_graph_rejects(nodes, roots, 1u, false, NodeGraphError.NodeTransformNotInvertible)
    allowed: darray[MeshPlacement] = try mesh_placement_records(nodes, roots, 1u, true)
    assert allowed.count == 1 and allowed[0].world_transform.m00 == 0.0
    assert gltf_node_graph_rejects([GltfNode{has_mesh: true, mesh_index: 0u}], [0u], 1000000u, true, NodeGraphError.MeshNotPlaced)


def gltf_node_graph_translation(value: f64) -> Affine3x4:
    return Affine3x4{m00: 1.0, m11: 1.0, m22: 1.0, m03: value}


def gltf_node_graph_rejects(nodes: darray[GltfNode], roots: darray[usize], mesh_count: usize, allow_singular: bool, expected: NodeGraphError) -> bool can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch mesh_placement_records(nodes, roots, mesh_count, allow_singular):
        ok placements:
            _ = placements
        error failure:
            rejected <- failure == expected
    return rejected
