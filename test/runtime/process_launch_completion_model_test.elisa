# Pure dispatch decisions. No native attributes, PID, wait or signal is created.
include "../../src/runtime/process_launch_completion_model.elisa"

using EsProcessLaunchCompletion


@test
def launch_completion_running_children_wait_or_require_fatal_cleanup() -> void:
    child: mutable EsProcessSpawnOwner::Owner = EsProcessSpawnOwner::Owner{resource_id: 11, owner_token: 7, state: EsProcessSpawnOwner::State.Reserved}
    _ = EsProcessSpawnOwner::observe(child, EsProcessSpawnAttempt::classify(0, 41))
    report: mutable Report = Report{coordinator_complete: true, cleanup_attempted: true}
    assert route(child, true, report) == Route.Wait
    assert route(child, false, report) == Route.Panic
    report.cleanup_failed <- true
    assert route(child, true, report) == Route.TerminateThenPanic
    report.cleanup_failed <- false
    report.launch_failed <- true
    assert route(child, true, report) == Route.TerminateThenPanic
    report.launch_failed <- false
    report.setup_failed <- true
    assert route(child, true, report) == Route.TerminateThenPanic
    report.setup_failed <- false
    report.setup_code <- 22
    assert route(child, true, report) == Route.TerminateThenPanic
    assert route(child, true, Report{}) == Route.TerminateThenPanic
    assert child.pid == 41 and child.state == EsProcessSpawnOwner::State.Running


@test
def launch_completion_no_child_is_recoverable_only_after_resolved_cleanup() -> void:
    child: mutable EsProcessSpawnOwner::Owner = EsProcessSpawnOwner::Owner{resource_id: 11, owner_token: 7, state: EsProcessSpawnOwner::State.Reserved}
    _ = EsProcessSpawnOwner::observe(child, EsProcessSpawnAttempt::classify(8, 999))
    report: mutable Report = Report{coordinator_complete: true, cleanup_attempted: true}
    assert route(child, false, report) == Route.ProcessFailure
    assert route(child, true, report) == Route.Panic
    report.setup_failed <- true
    report.setup_code <- 22
    assert route(child, false, report) == Route.ProcessFailure
    report.cleanup_failed <- true
    assert route(child, false, report) == Route.Panic
    assert child.pid == 0 and child.diagnostic_pid == 0


@test
def launch_completion_unknown_or_unresolved_states_never_route_to_wait() -> void:
    unknown: EsProcessSpawnOwner::Owner = EsProcessSpawnOwner::Owner{resource_id: 11, owner_token: 7, state: EsProcessSpawnOwner::State.Unknown, diagnostic_pid: 41}
    reserved: EsProcessSpawnOwner::Owner = EsProcessSpawnOwner::Owner{resource_id: 11, owner_token: 7, state: EsProcessSpawnOwner::State.Reserved}
    reaped: EsProcessSpawnOwner::Owner = EsProcessSpawnOwner::Owner{resource_id: 11, owner_token: 7, state: EsProcessSpawnOwner::State.Reaped, pid: 41}
    report: Report = Report{coordinator_complete: true, cleanup_attempted: true}
    assert route(unknown, true, report) == Route.Panic
    assert route(reserved, true, report) == Route.Panic
    assert route(reaped, false, report) == Route.Panic
    assert unknown.pid == 0 and unknown.diagnostic_pid == 41


@test
def launch_completion_fresh_admission_failure_requires_pristine_records() -> void:
    child: mutable EsProcessSpawnOwner::Owner = EsProcessSpawnOwner::Owner{}
    rejected: Report = Report{launch_failed: true}
    assert route(child, false, rejected) == Route.ProcessFailure
    assert route(child, true, rejected) == Route.Panic
    assert route(child, false, Report{}) == Route.Panic
    assert route(child, false, Report{launch_failed: true, cleanup_failed: true}) == Route.Panic
    child.pid <- 41
    assert route(child, false, rejected) == Route.Panic
