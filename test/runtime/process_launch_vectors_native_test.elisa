# Dormant native-layout/lifetime fixture. Not an interpreted test or an exec.
# Compile/run only after explicit reauthorization and bounded qualification.
include "../../src/runtime/process_launch_vectors_native.elisa"
include "../../src/runtime/environment_snapshot_model.elisa"


@test
def native_launch_tables_keep_empty_arguments_distinct_from_null_sentinels() -> void:
    can Memory.Allocate, Abort.Panic:
        entries: darray[darray[u8]] = []
        ambient: EsEnvironment::EnvironmentSnapshot = try EsEnvironmentSnapshot::from_entries(entries) else err:
            assert false
            return
        storage: EsProcessLaunchStorage::Prepared = try EsProcessLaunchStorage::prepare(ambient, [], "./tool", ["", "a b"]) else err:
            assert false
            return
        tables: EsProcessLaunchVectors::BorrowedTables = try EsProcessLaunchVectors::build_native_tables(storage) else err:
            assert false
            return
        assert tables.argv.count == 4 and tables.environment.count == 1 and tables.candidates.count == 2
        assert tables.receipt.pointer_bytes == size_of(uintptr)
        assert tables.argv[3] == null and tables.environment[0] == null and tables.candidates[1] == null
        borrowed_empty: u8&? = tables.argv[1]
        assert borrowed_empty != null
        return if borrowed_empty == null
        empty: u8& = borrowed_empty
        assert empty[0] == 0u8
        borrowed_argument: u8&? = tables.argv[2]
        assert borrowed_argument != null
        return if borrowed_argument == null
        argument: u8& = borrowed_argument
        assert argument[0] == 97u8 and argument[1] == 32u8 and argument[2] == 98u8 and argument[3] == 0u8
        borrowed_candidate: u8&? = tables.candidates[0]
        assert borrowed_candidate != null
        return if borrowed_candidate == null
        candidate: u8& = borrowed_candidate
        assert candidate[0] == 46u8 and candidate[1] == 47u8 and candidate[6] == 0u8


@test
def native_launch_bindings_reject_a_different_buffer_with_matching_text() -> void:
    can Memory.Allocate, Abort.Panic:
        entries: darray[darray[u8]] = []
        ambient: EsEnvironment::EnvironmentSnapshot = try EsEnvironmentSnapshot::from_entries(entries) else err:
            assert false
            return
        storage: EsProcessLaunchStorage::Prepared = try EsProcessLaunchStorage::prepare(ambient, [], "./tool", []) else err:
            assert false
            return
        tables: mutable EsProcessLaunchVectors::BorrowedTables = try EsProcessLaunchVectors::build_native_tables(storage) else err:
            assert false
            return
        receipt: EsProcessLaunchVectors::Receipt = try EsProcessLaunchVectors::validate_native_bindings(storage, tables) else err:
            assert false
            return
        assert receipt.argv_slots == 2
        # The two byte buffers have equal contents but distinct ownership.
        tables.argv[0] <- tables.candidates[0]
        rejected: mutable bool = false
        catch EsProcessLaunchVectors::validate_native_bindings(storage, tables):
            ok _:
                assert false
            error failure:
                rejected <- failure == EsProcessLaunchVectors::VectorError.InvalidBinding
        assert rejected
