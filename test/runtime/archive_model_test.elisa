include "../../src/runtime/archive_model.elisa"

using EsArchive


@test
def skipped_archive_paths_do_not_conflict_with_accepted_entries() -> void:
    can Memory.Allocate, Abort.Panic:
        first_accepted: mutable ArchiveSession = ArchiveSession{policy: ArchivePolicy{max_entries: 4, max_path_bytes: 64, max_entry_bytes: 16, max_total_bytes: 32}}
        assert advance_archive(first_accepted, ArchiveEvent.Begin) == ArchiveSessionState.Extracting
        assert archive_admit_entry(first_accepted, ArchiveEntry{entry_id: 1, path: "same", kind: ArchiveEntryKind.File, size: 3})
        assert archive_admit_entry(first_accepted, ArchiveEntry{entry_id: 2, path: "same", kind: ArchiveEntryKind.File, size: 7, state: ArchiveEntryState.Skipped})
        assert first_accepted.total_bytes == 3 and first_accepted.skipped_entries == 1
        assert validate_archive_session(first_accepted)
        assert advance_archive(first_accepted, ArchiveEvent.Commit) == ArchiveSessionState.Committed

        first_skipped: mutable ArchiveSession = ArchiveSession{policy: ArchivePolicy{max_entries: 4, max_path_bytes: 64, max_entry_bytes: 16, max_total_bytes: 32}}
        assert advance_archive(first_skipped, ArchiveEvent.Begin) == ArchiveSessionState.Extracting
        assert archive_admit_entry(first_skipped, ArchiveEntry{entry_id: 3, path: "same", kind: ArchiveEntryKind.File, size: 7, state: ArchiveEntryState.Skipped})
        assert archive_admit_entry(first_skipped, ArchiveEntry{entry_id: 4, path: "same", kind: ArchiveEntryKind.File, size: 3})
        assert first_skipped.total_bytes == 3 and first_skipped.skipped_entries == 1
        assert validate_archive_session(first_skipped)
        assert advance_archive(first_skipped, ArchiveEvent.Commit) == ArchiveSessionState.Committed
