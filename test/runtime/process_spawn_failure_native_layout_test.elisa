# Dormant Darwin64 native-layout fixture. No pipe, child or syscall is invoked.
# Native compilation/execution still requires explicit reauthorization.
include "../../src/runtime/process_spawn_failure_model.elisa"

using EsProcessSpawnFailure


@test
def darwin_spawn_failure_frame_has_the_qualified_sixteen_byte_wire_layout() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        assert size_of(uintptr) == 8 and size_of(u32) == 4 and size_of(i32) == 4
        assert size_of(Frame) == Protocol::BYTES
        return if size_of(Frame) != Protocol::BYTES
        frame: Frame = Frame{phase: Phase::Exec, errno: 8, candidate: 2}
        bytes: u8& = (&frame).cast[u8&]
        expected: darray[u8] = [69u8,83u8,70u8,49u8, 3u8,0u8,0u8,0u8, 8u8,0u8,0u8,0u8, 2u8,0u8,0u8,0u8]
        for index in 0..<expected.count:
            assert bytes[index] == expected[index]
