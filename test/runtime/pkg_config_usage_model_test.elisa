include "../../src/ir/ir.elisa"

using EsPkgConfigResult
using EsPkgConfig
using EsPkgConfigUsage
using EsPkgConfigWords
using EsBuildUsage


def pkg_config_usage_test_bytes(value: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    bytes: mutable darray[u8] = []
    for offset in 0..<sview_len(value) |value, bytes|:
        bytes.push(sview_at(value, offset))
    return bytes


@test
def pkg_config_usage_preserves_order_visibility_and_owned_values() -> void:
    can Memory.Allocate, Abort.Panic:
        discovery: PkgConfigDiscovery = PkgConfigDiscovery{
            requirement: PkgConfigRequirement{name: "fixture"},
            outcome: PkgConfigDiscoveryOutcome.Resolved,
            compile_flags: PkgConfigFlagSet{
                stream: PkgConfigFlagStream.Compile,
                flags: [
                    PkgConfigFlag{kind: PkgConfigFlagKind.IncludeDirectory, value: pkg_config_usage_test_bytes("/opt/fixture/include")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.CompileDefinition, value: pkg_config_usage_test_bytes("FEATURE=1")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.CompileOption, value: pkg_config_usage_test_bytes("-fPIC")}
                ]
            },
            link_flags: PkgConfigFlagSet{
                stream: PkgConfigFlagStream.Link,
                flags: [
                    PkgConfigFlag{kind: PkgConfigFlagKind.LibraryDirectory, value: pkg_config_usage_test_bytes("/opt/fixture/lib")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.LibraryName, value: pkg_config_usage_test_bytes("fixture")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("-pthread")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.LibraryPath, value: pkg_config_usage_test_bytes("/opt/fixture/lib/libextra.a")}
                ]
            }
        }
        usage: PkgConfigBuildUsage = pkg_config_build_usage_requirements_unchecked_paths(discovery, BuildUsageVisibility.Interface)
        assert usage.requirements.count == 7
        assert usage.owned_values.count == 7
        assert usage.requirements[0].kind == BuildUsageKind.IncludeDirectory
        assert usage.requirements[0].visibility == BuildUsageVisibility.Interface
        assert usage.requirements[0].value == "/opt/fixture/include"
        assert usage.requirements[1].kind == BuildUsageKind.CompileDefinition
        assert usage.requirements[1].value == "FEATURE=1"
        assert usage.requirements[2].kind == BuildUsageKind.CompileOption
        assert usage.requirements[2].value == "-fPIC"
        assert usage.requirements[3].kind == BuildUsageKind.LinkOption
        assert usage.requirements[3].value == "-L/opt/fixture/lib"
        assert usage.requirements[4].kind == BuildUsageKind.LinkLibrary
        assert usage.requirements[4].library_form == BuildUsageLibraryForm.SearchName
        assert usage.requirements[4].value == "fixture"
        assert usage.requirements[5].kind == BuildUsageKind.LinkOption
        assert usage.requirements[5].value == "-pthread"
        assert usage.requirements[6].kind == BuildUsageKind.LinkLibrary
        assert usage.requirements[6].library_form == BuildUsageLibraryForm.Path
        assert usage.requirements[6].value == "/opt/fixture/lib/libextra.a"

        resolved: BuildUsageResolution = resolve_build_usage([
            BuildUsageTarget{name: "fixture", kind: BuildUsageTargetKind.InterfaceLibrary, requirements: usage.requirements}
        ])
        assert resolved.targets[0].exported_compile.count == 3
        assert resolved.targets[0].exported_link.count == 4
        assert resolved.targets[0].exported_link[0].value == "-L/opt/fixture/lib"
        assert resolved.targets[0].exported_link[1].value == "fixture"
        assert resolved.targets[0].exported_link[2].value == "-pthread"
        assert resolved.targets[0].exported_link[3].value == "/opt/fixture/lib/libextra.a"


@test
def pkg_config_usage_rejects_unresolved_and_malformed_discovery() -> void:
    can Memory.Allocate, Abort.Panic:
        unavailable: PkgConfigDiscovery = PkgConfigDiscovery{
            requirement: PkgConfigRequirement{name: "missing"},
            outcome: PkgConfigDiscoveryOutcome.DependencyUnavailable
        }
        unavailable_rejected: mutable bool = false
        catch pkg_config_build_usage_requirements_unchecked_paths(unavailable, BuildUsageVisibility.Private):
            ok value:
                _ = value
            error failure:
                unavailable_rejected <- failure == PkgConfigUsageError.DiscoveryUnavailable
        assert unavailable_rejected

        malformed: PkgConfigDiscovery = PkgConfigDiscovery{
            requirement: PkgConfigRequirement{name: "forged"},
            outcome: PkgConfigDiscoveryOutcome.Resolved,
            compile_flags: PkgConfigFlagSet{stream: PkgConfigFlagStream.Link},
            link_flags: PkgConfigFlagSet{stream: PkgConfigFlagStream.Link}
        }
        malformed_rejected: mutable bool = false
        catch pkg_config_build_usage_requirements_unchecked_paths(malformed, BuildUsageVisibility.Private):
            ok value:
                _ = value
            error failure:
                malformed_rejected <- failure == PkgConfigUsageError.InvalidFlagShape
        assert malformed_rejected


@test
def pkg_config_execution_usage_resolves_relative_paths_and_checks_kinds() -> void:
    can Memory.Allocate, Abort.Panic, File.Read, Directory.Read:
        discovery: PkgConfigDiscovery = PkgConfigDiscovery{
            requirement: PkgConfigRequirement{name: "path-fixture"},
            working_directory: pkg_config_usage_test_bytes("/tmp"),
            outcome: PkgConfigDiscoveryOutcome.Resolved,
            compile_flags: PkgConfigFlagSet{
                stream: PkgConfigFlagStream.Compile,
                flags: [PkgConfigFlag{kind: PkgConfigFlagKind.IncludeDirectory, value: pkg_config_usage_test_bytes(".")}]
            },
            link_flags: PkgConfigFlagSet{
                stream: PkgConfigFlagStream.Link,
                flags: [
                    PkgConfigFlag{kind: PkgConfigFlagKind.LibraryDirectory, value: pkg_config_usage_test_bytes(".")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.LibraryPath, value: pkg_config_usage_test_bytes("/etc/passwd")}
                ]
            }
        }
        usage: mutable PkgConfigBuildUsage = PkgConfigBuildUsage{}
        admitted: mutable bool = false
        catch pkg_config_build_usage_with_canonical_paths(discovery, BuildUsageVisibility.Private, PkgConfigPathPolicy{allowed_roots: ["/tmp", "/etc"]}):
            ok value:
                usage <- value
                admitted <- true
            error failure:
                _ = failure
        assert admitted
        assert usage.requirements.count == 3
        assert path_is_absolute(path(usage.requirements[0].value))
        assert usage.requirements[1].value.startswith("-L")
        canonical_library_directory: sview = string_view_slice(usage.requirements[1].value, 2, -1)
        assert path_is_absolute(path(canonical_library_directory))
        assert usage.requirements[2].library_form == BuildUsageLibraryForm.Path
        assert path_is_absolute(path(usage.requirements[2].value))

        wrong_kind: mutable bool = false
        wrong_directory_discovery: PkgConfigDiscovery = PkgConfigDiscovery{
            requirement: PkgConfigRequirement{name: "wrong-kind"},
            working_directory: pkg_config_usage_test_bytes("/tmp"),
            outcome: PkgConfigDiscoveryOutcome.Resolved,
            compile_flags: PkgConfigFlagSet{
                stream: PkgConfigFlagStream.Compile,
                flags: [PkgConfigFlag{kind: PkgConfigFlagKind.IncludeDirectory, value: pkg_config_usage_test_bytes("/etc/passwd")}]
            },
            link_flags: PkgConfigFlagSet{stream: PkgConfigFlagStream.Link}
        }
        catch pkg_config_build_usage_with_canonical_paths(wrong_directory_discovery, BuildUsageVisibility.Private, PkgConfigPathPolicy{allowed_roots: ["/etc"]}):
            ok value:
                _ = value
            error failure:
                wrong_kind <- failure == PkgConfigUsageError.WrongPathKind
        assert wrong_kind

        outside_root: mutable bool = false
        outside_root_discovery: PkgConfigDiscovery = PkgConfigDiscovery{
            requirement: PkgConfigRequirement{name: "outside-root"},
            working_directory: pkg_config_usage_test_bytes("/tmp"),
            outcome: PkgConfigDiscoveryOutcome.Resolved,
            compile_flags: PkgConfigFlagSet{
                stream: PkgConfigFlagStream.Compile,
                flags: [PkgConfigFlag{kind: PkgConfigFlagKind.IncludeDirectory, value: pkg_config_usage_test_bytes("/etc")}]
            },
            link_flags: PkgConfigFlagSet{stream: PkgConfigFlagStream.Link}
        }
        catch pkg_config_build_usage_with_canonical_paths(outside_root_discovery, BuildUsageVisibility.Private, PkgConfigPathPolicy{allowed_roots: ["/tmp"]}):
            ok value:
                _ = value
            error failure:
                outside_root <- failure == PkgConfigUsageError.OutsideTrustedRoots
        assert outside_root


@test
def pkg_config_execution_usage_checks_separate_compiler_and_linker_path_operands() -> void:
    can Memory.Allocate, Abort.Panic, File.Read, Directory.Read:
        discovery: PkgConfigDiscovery = PkgConfigDiscovery{
            requirement: PkgConfigRequirement{name: "compiler-path-fixture"},
            working_directory: pkg_config_usage_test_bytes("/tmp"),
            outcome: PkgConfigDiscoveryOutcome.Resolved,
            compile_flags: PkgConfigFlagSet{
                stream: PkgConfigFlagStream.Compile,
                flags: [
                    PkgConfigFlag{kind: PkgConfigFlagKind.CompileOption, value: pkg_config_usage_test_bytes("-isystem")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.CompileOption, value: pkg_config_usage_test_bytes(".")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.CompileOption, value: pkg_config_usage_test_bytes("-F")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.CompileOption, value: pkg_config_usage_test_bytes(".")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.CompileOption, value: pkg_config_usage_test_bytes("-F.")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.CompileOption, value: pkg_config_usage_test_bytes("--sysroot=.")}
                ]
            },
            link_flags: PkgConfigFlagSet{
                stream: PkgConfigFlagStream.Link,
                flags: [
                    PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("-R")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes(".")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("-Wl,-rpath,/tmp")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("-Wl,-rpath-link=/tmp,-z,now")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("-Wl,--rpath=/tmp")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("-F")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes(".")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("-F.")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("-framework")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("Cocoa")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("-Wl,-rpath,$ORIGIN/.")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("-Wl,-rpath,@loader_path/.")}
                ]
            }
        }
        admitted: PkgConfigBuildUsage = pkg_config_build_usage_with_canonical_paths(discovery, BuildUsageVisibility.Private, PkgConfigPathPolicy{allowed_roots: ["/tmp"], loader_path_directory: "/tmp"})
        assert admitted.requirements.count == 18
        assert admitted.requirements[0].value == "-isystem"
        assert admitted.requirements[1].value.startswith("/")
        assert admitted.requirements[2].value == "-F"
        assert admitted.requirements[3].value.startswith("/")
        assert admitted.requirements[4].value.startswith("-F/")
        assert admitted.requirements[5].value.startswith("--sysroot=/")
        assert admitted.requirements[6].value == "-R"
        assert admitted.requirements[7].value.startswith("/")
        assert admitted.requirements[8].value.startswith("-Wl,-rpath,")
        assert admitted.requirements[9].value.startswith("-Wl,-rpath-link=")
        assert admitted.requirements[9].value.endswith(",-z,now")
        assert admitted.requirements[10].value.startswith("-Wl,--rpath=/")
        assert admitted.requirements[11].value == "-F"
        assert admitted.requirements[12].value.startswith("/")
        assert admitted.requirements[13].value.startswith("-F/")
        assert admitted.requirements[14].value == "-framework"
        assert admitted.requirements[15].value == "Cocoa"
        assert admitted.requirements[16].value == "-Wl,-rpath,$ORIGIN/."
        assert admitted.requirements[17].value == "-Wl,-rpath,@loader_path/."

        outside_root_discovery: PkgConfigDiscovery = PkgConfigDiscovery{
            requirement: PkgConfigRequirement{name: "outside-compiler-path-fixture"},
            working_directory: pkg_config_usage_test_bytes("/tmp"),
            outcome: PkgConfigDiscoveryOutcome.Resolved,
            compile_flags: PkgConfigFlagSet{
                stream: PkgConfigFlagStream.Compile,
                flags: [
                    PkgConfigFlag{kind: PkgConfigFlagKind.CompileOption, value: pkg_config_usage_test_bytes("-include")},
                    PkgConfigFlag{kind: PkgConfigFlagKind.CompileOption, value: pkg_config_usage_test_bytes("/etc/passwd")}
                ]
            },
            link_flags: PkgConfigFlagSet{stream: PkgConfigFlagStream.Link}
        }
        rejected: mutable bool = false
        catch pkg_config_build_usage_with_canonical_paths(outside_root_discovery, BuildUsageVisibility.Private, PkgConfigPathPolicy{allowed_roots: ["/tmp"]}):
            ok usage:
                _ = usage
            error failure:
                rejected <- failure == PkgConfigUsageError.OutsideTrustedRoots
        assert rejected

        malformed_rpath_discovery: PkgConfigDiscovery = PkgConfigDiscovery{
            requirement: PkgConfigRequirement{name: "malformed-rpath-fixture"},
            working_directory: pkg_config_usage_test_bytes("/tmp"),
            outcome: PkgConfigDiscoveryOutcome.Resolved,
            compile_flags: PkgConfigFlagSet{stream: PkgConfigFlagStream.Compile},
            link_flags: PkgConfigFlagSet{
                stream: PkgConfigFlagStream.Link,
                flags: [PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("-Wl,-rpath")}]
            }
        }
        malformed_rpath: mutable bool = false
        catch pkg_config_build_usage_with_canonical_paths(malformed_rpath_discovery, BuildUsageVisibility.Private, PkgConfigPathPolicy{allowed_roots: ["/tmp"]}):
            ok usage:
                _ = usage
            error failure:
                malformed_rpath <- failure == PkgConfigUsageError.InvalidFlagShape
        assert malformed_rpath

        outside_rpath_discovery: PkgConfigDiscovery = PkgConfigDiscovery{
            requirement: PkgConfigRequirement{name: "outside-rpath-fixture"},
            working_directory: pkg_config_usage_test_bytes("/tmp"),
            outcome: PkgConfigDiscoveryOutcome.Resolved,
            compile_flags: PkgConfigFlagSet{stream: PkgConfigFlagStream.Compile},
            link_flags: PkgConfigFlagSet{
                stream: PkgConfigFlagStream.Link,
                flags: [PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("-Wl,-rpath,/etc")}]
            }
        }
        outside_rpath: mutable bool = false
        catch pkg_config_build_usage_with_canonical_paths(outside_rpath_discovery, BuildUsageVisibility.Private, PkgConfigPathPolicy{allowed_roots: ["/tmp"]}):
            ok usage:
                _ = usage
            error failure:
                outside_rpath <- failure == PkgConfigUsageError.OutsideTrustedRoots
        assert outside_rpath

        combined_rpath_discovery: PkgConfigDiscovery = PkgConfigDiscovery{
            requirement: PkgConfigRequirement{name: "combined-rpath-fixture"},
            working_directory: pkg_config_usage_test_bytes("/tmp"),
            outcome: PkgConfigDiscoveryOutcome.Resolved,
            compile_flags: PkgConfigFlagSet{stream: PkgConfigFlagStream.Compile},
            link_flags: PkgConfigFlagSet{
                stream: PkgConfigFlagStream.Link,
                flags: [PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("-Wl,-rpath,/tmp,-rpath,/tmp")}]
            }
        }
        combined_rpath_usage: mutable PkgConfigBuildUsage = PkgConfigBuildUsage{}
        combined_rpath_admitted: mutable bool = false
        catch pkg_config_build_usage_with_canonical_paths(combined_rpath_discovery, BuildUsageVisibility.Private, PkgConfigPathPolicy{allowed_roots: ["/tmp"]}):
            ok usage:
                combined_rpath_usage <- usage
                combined_rpath_admitted <- true
            error failure:
                _ = failure
        assert combined_rpath_admitted
        assert combined_rpath_usage.requirements[0].value.startswith("-Wl,-rpath,/")
        assert combined_rpath_usage.requirements[0].value.endswith(",-rpath,/tmp") or combined_rpath_usage.requirements[0].value.endswith(",-rpath,/private/tmp")

        combined_outside_rpath_discovery: PkgConfigDiscovery = PkgConfigDiscovery{
            requirement: PkgConfigRequirement{name: "combined-outside-rpath-fixture"},
            working_directory: pkg_config_usage_test_bytes("/tmp"),
            outcome: PkgConfigDiscoveryOutcome.Resolved,
            compile_flags: PkgConfigFlagSet{stream: PkgConfigFlagStream.Compile},
            link_flags: PkgConfigFlagSet{
                stream: PkgConfigFlagStream.Link,
                flags: [PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("-Wl,-rpath,/tmp,-rpath,/etc")}]
            }
        }
        combined_outside_rpath: mutable bool = false
        catch pkg_config_build_usage_with_canonical_paths(combined_outside_rpath_discovery, BuildUsageVisibility.Private, PkgConfigPathPolicy{allowed_roots: ["/tmp"]}):
            ok usage:
                _ = usage
            error failure:
                combined_outside_rpath <- failure == PkgConfigUsageError.OutsideTrustedRoots
        assert combined_outside_rpath

        outside_loader_path_discovery: PkgConfigDiscovery = PkgConfigDiscovery{
            requirement: PkgConfigRequirement{name: "outside-loader-path-fixture"},
            working_directory: pkg_config_usage_test_bytes("/tmp"),
            outcome: PkgConfigDiscoveryOutcome.Resolved,
            compile_flags: PkgConfigFlagSet{stream: PkgConfigFlagStream.Compile},
            link_flags: PkgConfigFlagSet{
                stream: PkgConfigFlagStream.Link,
                flags: [PkgConfigFlag{kind: PkgConfigFlagKind.LinkOption, value: pkg_config_usage_test_bytes("-Wl,-rpath,$ORIGIN/../etc")}]
            }
        }
        outside_loader_path: mutable bool = false
        catch pkg_config_build_usage_with_canonical_paths(outside_loader_path_discovery, BuildUsageVisibility.Private, PkgConfigPathPolicy{allowed_roots: ["/tmp"], loader_path_directory: "/tmp"}):
            ok usage:
                _ = usage
            error failure:
                outside_loader_path <- failure == PkgConfigUsageError.OutsideTrustedRoots
        assert outside_loader_path

        missing_loader_anchor: mutable bool = false
        catch pkg_config_build_usage_with_canonical_paths(outside_loader_path_discovery, BuildUsageVisibility.Private, PkgConfigPathPolicy{allowed_roots: ["/tmp"]}):
            ok usage:
                _ = usage
            error failure:
                missing_loader_anchor <- failure == PkgConfigUsageError.InvalidPathPolicy
        assert missing_loader_anchor


@test
def pkg_config_usage_preparation_keeps_dependency_absence_as_data() -> void:
    can Memory.Allocate, Abort.Panic, File.Read, Directory.Read:
        discovery: PkgConfigDiscovery = PkgConfigDiscovery{
            requirement: PkgConfigRequirement{name: "missing-fixture"},
            outcome: PkgConfigDiscoveryOutcome.DependencyUnavailable,
            compile_flags: PkgConfigFlagSet{stream: PkgConfigFlagStream.Compile},
            link_flags: PkgConfigFlagSet{stream: PkgConfigFlagStream.Link},
            failed_stage: PkgConfigQueryStage.Exists,
            failure_kind: BuildExecutionFailureKind.NonzeroExit,
            exit_status: 1,
            diagnostic: pkg_config_usage_test_bytes("package not found")
        }
        preparation: PkgConfigBuildPreparation = pkg_config_prepare_build_usage(
            discovery,
            BuildUsageVisibility.Private,
            PkgConfigPathPolicy{}
        )
        assert preparation.discovery.outcome == PkgConfigDiscoveryOutcome.DependencyUnavailable
        assert preparation.usage.requirements.count == 0
        assert bytes_view(preparation.failure_diagnostic).startswith("pkg-config: required dependency was not found: missing-fixture")
