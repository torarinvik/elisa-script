include "../../src/runtime/macos_app_manifest_model.elisa"
include "../../src/runtime/macos_app_path_plan_model.elisa"

using EsMacosAppPathPlan
using EsMacosAppManifest


def macos_app_path_plan_test_bytes(value: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    bytes: mutable darray[u8] = []
    for byte in value |bytes|:
        bytes.push(byte)
    return bytes


def macos_app_output_is_rejected(project: Path, app: Path, inputs: darray[Path]) -> bool can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch macos_app_validate_output_disjoint(project, app, inputs):
        ok accepted:
            _ = accepted
        error _:
            rejected <- true
    return rejected


@test
def app_output_overlap_uses_path_components_not_text_prefixes() -> void can[Memory.Allocate, Abort.Panic]:
    project: Path = path"/workspace/project"
    nested_output: Path = path"/workspace/project/build/MyApp.app"
    same_path: Path = path"/workspace/project"
    common_prefix_sibling: Path = path"/workspace/project-old/MyApp.app"
    separate_tree: Path = path"/another/project"

    assert macos_app_paths_overlap(project, nested_output)
    assert macos_app_paths_overlap(nested_output, project)
    assert macos_app_paths_overlap(project, same_path)
    assert not macos_app_paths_overlap(project, common_prefix_sibling)
    assert not macos_app_paths_overlap(common_prefix_sibling, separate_tree)


@test
def app_output_overlap_fails_closed_for_unresolved_relative_paths() -> void can[Memory.Allocate, Abort.Panic]:
    assert macos_app_paths_overlap(path"build/MyApp.app", path"project")


@test
def package_input_paths_follow_reference_order_and_selection() -> void can[Memory.Allocate, Abort.Panic]:
    project: Path = path"/workspace/project"
    executable: Path = path"/workspace/project/build/game"
    shader_root: Path = path"/prepared/shaders"
    icon: Path = path"/workspace/project/resources/AppIcon.icns"
    selection: MacosAppPathSelection = MacosAppPathSelection{
        resource_mode: MacosResourceMode.ExplicitPaths,
        resource_paths: [macos_app_path_plan_test_bytes("assets/one.bin"), macos_app_path_plan_test_bytes("assets/two.bin")],
        notice_paths: [macos_app_path_plan_test_bytes("LICENSE")]
    }
    inputs: mutable darray[Path] = []
    catch macos_app_required_package_inputs(project, executable, shader_root, false, icon, true, selection):
        ok selected:
            inputs <- selected
        error _:
            assert false

    assert inputs.count == 7
    assert inputs[0] == executable
    assert inputs[1] == shader_root
    assert inputs[2] == path"/workspace/project/build/cooked"
    assert inputs[3] == path"/workspace/project/assets/one.bin"
    assert inputs[4] == path"/workspace/project/assets/two.bin"
    assert inputs[5] == path"/workspace/project/LICENSE"
    assert inputs[6] == icon

    all_assets_inputs: mutable darray[Path] = []
    catch macos_app_required_package_inputs(project, executable, shader_root, true, icon, false, MacosAppPathSelection{}):
        ok selected:
            all_assets_inputs <- selected
        error _:
            assert false
    assert all_assets_inputs.count == 4
    assert all_assets_inputs[1] == path"/workspace/project/shaders"
    assert all_assets_inputs[3] == path"/workspace/project/assets"

    no_resources: MacosAppPathSelection = MacosAppPathSelection{resource_mode: MacosResourceMode.ExplicitPaths}
    no_resource_inputs: mutable darray[Path] = []
    catch macos_app_required_package_inputs(project, executable, shader_root, true, icon, false, no_resources):
        ok selected:
            no_resource_inputs <- selected
        error _:
            assert false
    assert no_resource_inputs.count == 3


@test
def app_output_matches_project_and_required_input_overlap_policy() -> void can[Memory.Allocate, Abort.Panic]:
    project: Path = path"/workspace/project"
    inputs: darray[Path] = [
        path"/workspace/project/build/game",
        path"/workspace/project/shaders",
        path"/workspace/project/build/cooked",
        path"/workspace/project/assets"
    ]
    inside_project: Path = path"/workspace/project/build/Game.app"
    overlaps_build_inputs: Path = path"/workspace/project/build"

    assert not macos_app_output_is_rejected(project, inside_project, inputs)
    assert macos_app_output_is_rejected(project, project, inputs)
    assert macos_app_output_is_rejected(project, path"/workspace", inputs)
    assert macos_app_output_is_rejected(project, overlaps_build_inputs, inputs)
    assert macos_app_output_is_rejected(project, path"/workspace/project/assets/tree", inputs)
