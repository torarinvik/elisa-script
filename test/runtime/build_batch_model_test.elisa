@test
def build_batch_rejects_output_overrun_without_consuming_reservation() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/true",
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 8
        }
        graph: BuildGraph = BuildGraph{nodes: [BuildNode{name: "limited", command: command, fingerprint: 51}]}
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        _ = begin_build_batch(session)
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 1 and launches[0].command.capture_output_limit_bytes == 8

        oversized_rejected: mutable bool = false
        catch report_build_batch_result(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited, stdout: "123456789"}):
            ok value:
                assert false
            error failure:
                oversized_rejected <- failure == BuildBatchError.OutputLimitExceeded
        assert oversized_rejected
        assert session.scheduler.state == BuildSchedulerState.Running
        assert session.processes.active == 1 and session.reserved_output_bytes == 8
        assert not session.results[0].published and session.scheduler.graph.log_bytes == 0

        assert report_build_batch_result(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.OutputLimit, stdout: "12345678"}) == BuildSchedulerState.Failed
        assert session.results[0].process.kind == ProcessResultKind.OutputLimit
        assert session.scheduler.graph.log_bytes == 8
        assert validate_build_batch_session(session)


@test
def parallel_build_launches_receive_only_their_reserved_output_budget() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/true",
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
