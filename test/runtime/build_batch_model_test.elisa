@test
def build_batch_accounts_for_multiple_failures_during_drain() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [
                BuildNode{name: "timeout", command: command, fingerprint: 31},
                BuildNode{name: "host-io", command: command, fingerprint: 32},
                BuildNode{name: "dependent", command: command, dependencies: [0, 1], fingerprint: 33}
            ],
            max_parallel: 2
        }
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        assert begin_build_batch(session) == BuildSchedulerState.Running
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 2
        assert report_build_batch_result(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.TimedOut, stdout: "timeout output"}) == BuildSchedulerState.Failing
        assert session.processes.state == ProcessBatchState.Draining
        assert session.scheduler.graph.nodes[2].state == BuildNodeState.Cancelled

        assert report_build_batch_result(session, launches[1].dispatch, ProcessResult{kind: ProcessResultKind.HostIoFailure, error_text: "capture read failed"}) == BuildSchedulerState.Failed
        assert session.results[0].process.kind == ProcessResultKind.TimedOut
        assert session.results[1].process.kind == ProcessResultKind.HostIoFailure
        assert session.scheduler.graph.failed_nodes == 2
        assert session.scheduler.graph.nodes[0].state == BuildNodeState.Failed
        assert session.scheduler.graph.nodes[1].state == BuildNodeState.Failed
        assert session.scheduler.graph.nodes[2].state == BuildNodeState.Cancelled
        assert session.processes.failed == 2 and session.processes.state == ProcessBatchState.Failed
        assert session.scheduler.graph.log_bytes == len("timeout output") + len("capture read failed")
        assert validate_build_batch_session(session)


@test
def build_batch_cancellation_during_failure_drain_preserves_failure() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [
                BuildNode{name: "failed", command: command, fingerprint: 14},
                BuildNode{name: "active-sibling", command: command, fingerprint: 15}
            ],
            max_parallel: 2
        }
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        _ = begin_build_batch(session)
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 2
        assert report_build_batch_result(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited, exit_status: 1, stderr: "compile error"}) == BuildSchedulerState.Failing

        stop_requests: darray[ProcessBatchDispatch] = cancel_build_batch(session)
        assert stop_requests.count == 1
        assert stop_requests[0].job_index == launches[1].dispatch.job_index
        assert stop_requests[0].job_id == launches[1].dispatch.job_id
        assert stop_requests[0].attempt_token == launches[1].dispatch.attempt_token
        assert session.scheduler.state == BuildSchedulerState.Failing
        assert session.processes.state == ProcessBatchState.Cancelling
        assert acknowledge_build_batch_stop(session, stop_requests) == BuildSchedulerState.Failed
        assert session.processes.state == ProcessBatchState.Failed
        assert session.scheduler.graph.nodes[0].state == BuildNodeState.Failed
        assert session.scheduler.graph.nodes[1].state == BuildNodeState.Cancelled
        assert session.scheduler.graph.failed_nodes == 1
        assert session.results[0].published and session.results[0].process.stderr == "compile error"
        assert session.scheduler.graph.log_bytes == len("compile error")
        assert validate_build_batch_session(session)


