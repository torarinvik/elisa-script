@test
def build_batch_rejects_command_mutation_after_dispatch() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [BuildNode{name: "compile", command: command, fingerprint: 11}],
            max_parallel: 1
        }
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        assert begin_build_batch(session) == BuildSchedulerState.Running
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 1 and session.results[0].command_snapshot_bound

        mutated_node: mutable BuildNode = session.scheduler.graph.nodes[0]
        mutated_command: mutable ProcessCommand = mutated_node.command
        mutated_command.arguments <- ["different-recipe"]
        mutated_node.command <- mutated_command
        session.scheduler.graph.nodes[0] <- mutated_node

        mutation_rejected: mutable bool = false
        catch validate_build_batch_session(session):
            ok valid:
                _ = valid
                assert false
            error failure:
                mutation_rejected <- failure == BuildBatchError.JobMappingInvalid
        assert mutation_rejected


@test
def build_batch_rejects_existing_output_before_dispatch_without_mutation() -> void:
    can Memory.Allocate, Abort.Panic, File.Read:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{nodes: [BuildNode{name: "generate", command: command, fingerprint: 14}]}
        outputs: darray[BuildExecutionNodeOutputs] = [BuildExecutionNodeOutputs{target_name: "generate", paths: ["/dev/null"]}]
        session: mutable BuildBatchSession = build_batch_session_for_graph_with_outputs(graph, outputs)
        assert begin_build_batch(session) == BuildSchedulerState.Running

        unchecked_rejected: mutable bool = false
        catch dispatch_build_batch_ready(session):
            ok launches:
                _ = launches
                assert false
            error failure:
                unchecked_rejected <- failure == BuildBatchError.OutputPreflightRequired
        assert unchecked_rejected

        existing_output_rejected: mutable bool = false
        catch dispatch_build_batch_ready_with_output_preflight(session):
            ok launches:
                _ = launches
                assert false
            error failure:
                existing_output_rejected <- failure == BuildBatchError.OutputAlreadyPresent("/dev/null")
        assert existing_output_rejected
        assert session.scheduler.state == BuildSchedulerState.Running
        assert session.scheduler.active_nodes == 0 and session.scheduler.ready_queue.count == 1
        assert session.processes.active == 0 and session.processes.jobs[0].state == ProcessBatchJobState.Pending
        assert validate_build_batch_session(session)


