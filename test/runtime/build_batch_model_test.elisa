        assert launches[1].command.capture_output_limit_bytes == 0
        assert session.results[0].reserved_output_bytes == EsBuild::Limits::LOG_BYTES
        assert session.results[1].reserved_output_bytes == 0
        assert session.reserved_output_bytes == EsBuild::Limits::LOG_BYTES
        assert validate_build_batch_session(session)

        assert report_build_batch_result(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited}) == BuildSchedulerState.Running
        assert report_build_batch_result(session, launches[1].dispatch, ProcessResult{kind: ProcessResultKind.Exited}) == BuildSchedulerState.Complete
        assert validate_build_batch_session(session)


@test
def build_batch_missing_output_fails_before_dispatching_dependents() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Write:
        temporary: Path = try temp_directory("build-batch-missing-output") else err:
            assert false
            return
        output: Path = temporary.joinpath("generated.h")
        output_text: sview = f"{output}"
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "generate", command: command, fingerprint: 61},
            BuildNode{name: "compile", command: command, dependencies: [0], fingerprint: 62}
        ]}
        output_sets: darray[BuildExecutionNodeOutputs] = [
            BuildExecutionNodeOutputs{target_name: "generate", paths: [output_text]},
            BuildExecutionNodeOutputs{target_name: "compile"}
        ]
        session: mutable BuildBatchSession = build_batch_session_for_graph_with_outputs(graph, output_sets)
        _ = begin_build_batch(session)
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready_with_output_preflight(session)
        assert launches.count == 1 and launches[0].node_index == 0

        state: BuildSchedulerState = report_build_batch_result_with_outputs(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited})
        next_wave: mutable darray[BuildBatchLaunch] = []
        if state == BuildSchedulerState.Running:
            next_wave <- try dispatch_build_batch_ready_with_output_preflight(session)
        output_absent: bool = not is_file(output)
        removed_directory: bool = try remove_directory(temporary) else false
        assert state == BuildSchedulerState.Failed and next_wave.count == 0
        assert session.scheduler.graph.nodes[0].state == BuildNodeState.Failed
        assert session.scheduler.graph.nodes[1].state == BuildNodeState.Cancelled
        assert session.results[0].missing_output == output_text
        assert session.results[0].process.exit_status == 0 and output_absent
        assert removed_directory and validate_build_batch_session(session)


@test
def build_batch_rejects_output_created_before_later_dispatch() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Write:
        temporary: Path = try temp_directory("build-batch-premature-output") else err:
            assert false
            return
        first_output: Path = temporary.joinpath("generated.h")
        later_output: Path = temporary.joinpath("compiled.o")
        first_output_text: sview = f"{first_output}"
        later_output_text: sview = f"{later_output}"
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "generate", command: command, fingerprint: 81},
            BuildNode{name: "compile", command: command, dependencies: [0], fingerprint: 82}
        ]}
        output_sets: darray[BuildExecutionNodeOutputs] = [
            BuildExecutionNodeOutputs{target_name: "generate", paths: [first_output_text]},
            BuildExecutionNodeOutputs{target_name: "compile", paths: [later_output_text]}
        ]
        session: mutable BuildBatchSession = build_batch_session_for_graph_with_outputs(graph, output_sets)
        _ = begin_build_batch(session)
        first_wave: darray[BuildBatchLaunch] = dispatch_build_batch_ready_with_output_preflight(session)
        wrote_first_output: usize = try write_text(first_output, "h") else 0u64
        wrote_later_output: usize = try write_text(later_output, "o") else 0u64
        state: BuildSchedulerState = report_build_batch_result_with_outputs(session, first_wave[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited})

        premature_output_rejected: mutable bool = false
        catch dispatch_build_batch_ready_with_output_preflight(session):
            ok launches:
                _ = launches
                assert false
            error failure:
                premature_output_rejected <- failure == BuildBatchError.OutputAlreadyPresent(later_output_text)

        first_output_removed: bool = try remove_path(first_output) else false
        later_output_removed: bool = try remove_path(later_output) else false
        removed_directory: bool = try remove_directory(temporary) else false
        assert first_wave.count == 1 and first_wave[0].node_index == 0
        assert wrote_first_output == 1u64 and wrote_later_output == 1u64
        assert state == BuildSchedulerState.Running and premature_output_rejected
        assert session.scheduler.ready_queue.count == 1 and session.scheduler.ready_queue[0] == 1
        assert session.scheduler.active_nodes == 0 and session.processes.active == 0
        assert session.processes.jobs[1].state == ProcessBatchJobState.Pending
        assert first_output_removed and later_output_removed and removed_directory
        assert validate_build_batch_session(session)


@test
def build_batch_maps_recipe_outputs_under_absolute_root() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{nodes: [BuildNode{name: "generate", command: command, fingerprint: 71}]}
        recipes: darray[BuildIncrementalRecipeTarget] = [BuildIncrementalRecipeTarget{
            name: "generate",
            kind: BuildIncrementalTargetKind.GeneratedFile,
            recipe_fingerprint: 71,
            outputs: ["generated/config.h"]
        }]
        root: Path = path("/tmp/elisascript-batch-root")
        outputs: darray[BuildExecutionNodeOutputs] = build_batch_output_sets_from_recipes(root, graph, recipes)
        assert outputs.count == 1 and outputs[0].target_name == "generate"
        assert outputs[0].paths == ["/tmp/elisascript-batch-root/generated/config.h"]
        session: BuildBatchSession = build_batch_session_for_recipes(root, graph, recipes)
        assert session.output_sets.count == 1 and session.output_sets[0].paths == outputs[0].paths

        invalid_root_rejected: mutable bool = false
        catch build_batch_output_sets_from_recipes(path("relative/root"), graph, recipes):
            ok value:
                assert false
            error failure:
                invalid_root_rejected <- failure == BuildBatchError.InvalidOutputRoot
        assert invalid_root_rejected

        escaping_recipes: darray[BuildIncrementalRecipeTarget] = [BuildIncrementalRecipeTarget{
            name: "generate",
            kind: BuildIncrementalTargetKind.GeneratedFile,
            recipe_fingerprint: 71,
            outputs: ["../outside/generated.h"]
        }]
        traversal_rejected: mutable bool = false
        catch build_batch_output_sets_from_recipes(root, graph, escaping_recipes):
            ok value:
                assert false
            error failure:
                traversal_rejected <- failure == BuildIncrementalError.InvalidPath
        assert traversal_rejected
