@test
def build_batch_cancellation_waits_for_host_reap_acknowledgement() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "first", command: command, fingerprint: 21},
            BuildNode{name: "second", command: command, fingerprint: 22}
        ], max_parallel: 2}
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        _ = begin_build_batch(session)
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 2
        stop_requests: darray[ProcessBatchDispatch] = cancel_build_batch(session)
        assert stop_requests.count == 2
        assert session.scheduler.state == BuildSchedulerState.Cancelling
        assert session.processes.state == ProcessBatchState.Cancelling
        incomplete_acknowledgement_rejected: mutable bool = false
        no_acknowledgements: darray[ProcessBatchDispatch] = []
        catch acknowledge_build_batch_stop(session, no_acknowledgements):
            ok value:
                assert false
            error failure:
                incomplete_acknowledgement_rejected <- failure == BuildBatchError.StopAcknowledgementMismatch
        assert incomplete_acknowledgement_rejected
        assert session.scheduler.state == BuildSchedulerState.Cancelling
        assert session.processes.active == 2 and session.reserved_output_bytes != 0
        stale_acknowledgement_rejected: mutable bool = false
        stale_acknowledgements: darray[ProcessBatchDispatch] = [
            ProcessBatchDispatch{
                job_index: stop_requests[0].job_index,
                job_id: stop_requests[0].job_id,
                attempt_token: stop_requests[0].attempt_token + 1
            },
            stop_requests[1]
        ]
        catch acknowledge_build_batch_stop(session, stale_acknowledgements):
            ok value:
                assert false
            error failure:
                stale_acknowledgement_rejected <- failure == BuildBatchError.StopAcknowledgementMismatch
        assert stale_acknowledgement_rejected
        assert session.scheduler.state == BuildSchedulerState.Cancelling
        assert session.processes.active == 2 and session.reserved_output_bytes != 0
        assert acknowledge_build_batch_stop(session, stop_requests) == BuildSchedulerState.Cancelled
        assert session.reserved_output_bytes == 0
        assert validate_build_batch_session(session)


