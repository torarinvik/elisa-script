@test
def build_batch_rejects_success_receipt_with_host_error_text_atomically() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [BuildNode{name: "compile", command: command, fingerprint: 12}],
            max_parallel: 1
        }
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        assert begin_build_batch(session) == BuildSchedulerState.Running
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 1

        rejected: mutable bool = false
        catch report_build_batch_result(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited, error_text: "host error on successful exit"}):
            ok state:
                _ = state
                assert false
            error failure:
                rejected <- failure == BuildBatchError.ResultInvalid
        assert rejected
        assert session.scheduler.state == BuildSchedulerState.Running
        assert session.scheduler.active_nodes == 1 and session.processes.active == 1
        assert session.reserved_output_bytes == command.capture_output_limit_bytes
        assert session.results[0].reserved_output_bytes == command.capture_output_limit_bytes
        assert not session.results[0].published
        assert validate_build_batch_session(session)


@test
def incremental_build_batch_skips_verified_cache_hits_before_dispatch() -> void:
    can Memory.Allocate, Abort.Panic, File.Read:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [
                BuildNode{name: "cached-object", command: command, fingerprint: 1},
                BuildNode{name: "dirty-object", command: command, dependencies: [0], fingerprint: 1}
            ],
            max_parallel: 2
        }
        recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "cached-object", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, inputs: ["src/cached.c"], outputs: ["build/cached.o"]},
            BuildIncrementalRecipeTarget{name: "dirty-object", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, inputs: ["src/dirty.c"], outputs: ["build/dirty.o"], dependencies: ["cached-object"]}
        ]
        toolchains: darray[BuildRecipeToolchainIdentity] = [BuildRecipeToolchainIdentity{word0: 11}, BuildRecipeToolchainIdentity{word0: 12}]
        signed: BuildRecipeSignedGraph = sign_build_incremental_graph(graph, recipes, toolchains)
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "cached-object", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: signed.recipes[0].recipe_fingerprint, recipe_signature: signed.recipes[0].recipe_signature, inputs: [BuildIncrementalFile{path: "src/cached.c", fingerprint: 21}], outputs: [BuildIncrementalFile{path: "build/cached.o", fingerprint: 31}]},
            BuildIncrementalTarget{name: "dirty-object", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: signed.recipes[1].recipe_fingerprint, recipe_signature: signed.recipes[1].recipe_signature, inputs: [BuildIncrementalFile{path: "src/dirty.c", fingerprint: 22}], outputs: [BuildIncrementalFile{path: "build/dirty.o", fingerprint: 32}], dependencies: ["cached-object"]}
        ]
        observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/cached.c", present: true, fingerprint: 21},
            BuildIncrementalObservation{path: "build/cached.o", present: true, fingerprint: 31},
            BuildIncrementalObservation{path: "src/dirty.c", present: true, fingerprint: 22},
            BuildIncrementalObservation{path: "build/dirty.o", present: false}
        ]
        root: Path = path("/tmp/elisascript-build-batch")
        session: mutable BuildBatchSession = build_incremental_batch_session_for_recipes(root, signed.graph, previous, signed.recipes, observations)
        assert session.scheduler.cache.count == 1
        assert session.scheduler.cache[0].node_name == "cached-object"
        assert begin_build_batch(session) == BuildSchedulerState.Running
        assert session.scheduler.graph.nodes[0].state == BuildNodeState.Succeeded
        assert session.processes.jobs[0].state == ProcessBatchJobState.Skipped
        assert session.results[0].cache_hit and not session.results[0].dispatched and not session.results[0].published
        assert session.scheduler.active_nodes == 0 and session.scheduler.completed_nodes == 1
        assert session.processes.active == 0 and session.processes.completed == 1
        assert session.scheduler.ready_queue.count == 1 and session.scheduler.ready_queue[0] == 1
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready_with_output_preflight(session)
        assert launches.count == 1 and launches[0].node_index == 1
        assert session.scheduler.active_nodes == 1 and session.processes.active == 1
        assert validate_build_batch_session(session)


@test
def incremental_build_batch_completes_without_launches_when_all_targets_are_cached() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [
                BuildNode{name: "cached-object", command: command, fingerprint: 1},
                BuildNode{name: "cached-link", command: command, dependencies: [0], fingerprint: 2}
            ],
            max_parallel: 2
        }
        recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "cached-object", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, inputs: ["src/cached.c"], outputs: ["build/cached.o"]},
            BuildIncrementalRecipeTarget{name: "cached-link", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 2, inputs: ["src/main.c"], outputs: ["build/app"], dependencies: ["cached-object"]}
        ]
        toolchains: darray[BuildRecipeToolchainIdentity] = [BuildRecipeToolchainIdentity{word0: 11}, BuildRecipeToolchainIdentity{word0: 12}]
        signed: BuildRecipeSignedGraph = sign_build_incremental_graph(graph, recipes, toolchains)
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "cached-object", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: signed.recipes[0].recipe_fingerprint, recipe_signature: signed.recipes[0].recipe_signature, inputs: [BuildIncrementalFile{path: "src/cached.c", fingerprint: 21}], outputs: [BuildIncrementalFile{path: "build/cached.o", fingerprint: 31}]},
            BuildIncrementalTarget{name: "cached-link", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: signed.recipes[1].recipe_fingerprint, recipe_signature: signed.recipes[1].recipe_signature, inputs: [BuildIncrementalFile{path: "src/main.c", fingerprint: 22}], outputs: [BuildIncrementalFile{path: "build/app", fingerprint: 32}], dependencies: ["cached-object"]}
        ]
        observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/cached.c", present: true, fingerprint: 21},
            BuildIncrementalObservation{path: "build/cached.o", present: true, fingerprint: 31},
            BuildIncrementalObservation{path: "src/main.c", present: true, fingerprint: 22},
            BuildIncrementalObservation{path: "build/app", present: true, fingerprint: 32}
        ]
        root: Path = path("/tmp/elisascript-build-batch-cache-only")
        cancelled_session: mutable BuildBatchSession = build_incremental_batch_session_for_recipes(root, signed.graph, previous, signed.recipes, observations)
        assert cancelled_session.scheduler.cache.count == 2 and cancelled_session.scheduler.cache_hits == 0
        stop_requests: darray[ProcessBatchDispatch] = cancel_build_batch(cancelled_session)
        assert stop_requests.count == 0
        assert cancelled_session.scheduler.state == BuildSchedulerState.Cancelled
        assert cancelled_session.processes.state == ProcessBatchState.Cancelled
        assert cancelled_session.processes.jobs[0].state == ProcessBatchJobState.Cancelled
        assert cancelled_session.processes.jobs[1].state == ProcessBatchJobState.Cancelled
        assert cancelled_session.scheduler.cache_hits == 0 and not cancelled_session.results[0].cache_hit
        assert validate_build_batch_session(cancelled_session)

        session: mutable BuildBatchSession = build_incremental_batch_session_for_recipes(root, signed.graph, previous, signed.recipes, observations)
        assert session.scheduler.cache.count == 2
        assert begin_build_batch(session) == BuildSchedulerState.Complete
        assert session.scheduler.graph.nodes[0].state == BuildNodeState.Succeeded
        assert session.scheduler.graph.nodes[1].state == BuildNodeState.Succeeded
        assert session.processes.state == ProcessBatchState.Succeeded
        assert session.processes.jobs[0].state == ProcessBatchJobState.Skipped
        assert session.processes.jobs[1].state == ProcessBatchJobState.Skipped
        assert session.results[0].cache_hit and session.results[1].cache_hit
        assert not session.results[0].dispatched and not session.results[1].dispatched
        assert session.processes.jobs[0].attempts == 0 and session.processes.jobs[1].attempts == 0
        assert session.scheduler.ready_queue.count == 0
        assert validate_build_batch_session(session)

        execution: BuildExecutionResult = build_batch_execution_result(session)
        assert execution.graph_state == BuildGraphState.Succeeded
        assert execution.nodes.count == 2 and execution.log_bytes == 0
        assert execution.nodes[0].cache_hit and execution.nodes[1].cache_hit
        assert not execution.nodes[0].started and not execution.nodes[1].started
        commit: BuildIncrementalCommit = commit_build_incremental_execution(execution, session.scheduler.graph, previous, signed.recipes, observations)
        assert commit.targets.count == 2 and commit.stale_outputs_after_success.count == 0

        valid_cache_hit_count: usize = session.scheduler.cache_hits
        session.scheduler.cache_hits <- 0
        forged_cache_count_rejected: mutable bool = false
        catch validate_build_batch_session(session):
            ok value:
                assert false
            error failure:
                forged_cache_count_rejected <- failure == BuildBatchError.JobMappingInvalid
        assert forged_cache_count_rejected
        session.scheduler.cache_hits <- valid_cache_hit_count
        assert validate_build_batch_session(session)


@test
def incremental_build_batch_invalidates_cached_dependents_of_dirty_inputs() -> void:
    can Memory.Allocate, Abort.Panic, File.Read:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [
                BuildNode{name: "producer", command: command, fingerprint: 1},
                BuildNode{name: "consumer", command: command, dependencies: [0], fingerprint: 1}
            ],
            max_parallel: 2
        }
        recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "producer", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, inputs: ["src/input.c"], outputs: ["build/producer.o"]},
            BuildIncrementalRecipeTarget{name: "consumer", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, inputs: ["src/consumer.c"], outputs: ["build/consumer.o"], dependencies: ["producer"]}
        ]
        toolchains: darray[BuildRecipeToolchainIdentity] = [BuildRecipeToolchainIdentity{word0: 11}, BuildRecipeToolchainIdentity{word0: 12}]
        signed: BuildRecipeSignedGraph = sign_build_incremental_graph(graph, recipes, toolchains)
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "producer", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: signed.recipes[0].recipe_fingerprint, recipe_signature: signed.recipes[0].recipe_signature, inputs: [BuildIncrementalFile{path: "src/input.c", fingerprint: 21}], outputs: [BuildIncrementalFile{path: "build/producer.o", fingerprint: 31}]},
            BuildIncrementalTarget{name: "consumer", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: signed.recipes[1].recipe_fingerprint, recipe_signature: signed.recipes[1].recipe_signature, inputs: [BuildIncrementalFile{path: "src/consumer.c", fingerprint: 22}], outputs: [BuildIncrementalFile{path: "build/consumer.o", fingerprint: 32}], dependencies: ["producer"]}
        ]
        observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/input.c", present: true, fingerprint: 99},
            BuildIncrementalObservation{path: "build/producer.o", present: true, fingerprint: 31},
            BuildIncrementalObservation{path: "src/consumer.c", present: true, fingerprint: 22},
            BuildIncrementalObservation{path: "build/consumer.o", present: true, fingerprint: 32}
        ]
        root: Path = path("/tmp/elisascript-build-batch-dirty-dependency")
        session: mutable BuildBatchSession = build_incremental_batch_session_for_recipes(root, signed.graph, previous, signed.recipes, observations)
        assert session.scheduler.cache.count == 0
        assert begin_build_batch(session) == BuildSchedulerState.Running
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready_with_output_preflight(session)
        assert launches.count == 1 and launches[0].node_index == 0
        assert session.processes.jobs[0].state == ProcessBatchJobState.Running
        assert session.processes.jobs[1].state == ProcessBatchJobState.Pending
        assert validate_build_batch_session(session)

        session.scheduler.cache.push(BuildCacheEntry{node_name: "consumer", fingerprint: 1})
        forged_unused_cache_rejected: mutable bool = false
        catch validate_build_batch_session(session):
            ok value:
                assert false
            error failure:
                forged_unused_cache_rejected <- failure == BuildBatchError.JobMappingInvalid
        assert forged_unused_cache_rejected


@test
def build_batch_failure_cancels_unstarted_nodes_and_drains_siblings() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [
                BuildNode{name: "fail", command: command, fingerprint: 11},
                BuildNode{name: "sibling", command: command, fingerprint: 12},
                BuildNode{name: "dependent", command: command, dependencies: [0], fingerprint: 13}
            ],
            max_parallel: 2
        }
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        _ = begin_build_batch(session)
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 2
        assert report_build_batch_result(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited, exit_status: 1, stderr: "compile error"}) == BuildSchedulerState.Failing
        assert session.processes.state == ProcessBatchState.Draining
        assert session.scheduler.graph.nodes[2].state == BuildNodeState.Cancelled
        assert session.processes.jobs[2].state == ProcessBatchJobState.Cancelled
        assert report_build_batch_result(session, launches[1].dispatch, ProcessResult{kind: ProcessResultKind.Exited}) == BuildSchedulerState.Failed
        assert session.scheduler.graph.failed_nodes == 1
        assert session.scheduler.graph.nodes[1].state == BuildNodeState.Succeeded
        assert validate_build_batch_session(session)
        execution_not_complete_rejected: mutable bool = false
        catch build_batch_execution_result(session):
            ok value:
                assert false
            error failure:
                execution_not_complete_rejected <- failure == BuildBatchError.ExecutionNotComplete
        assert execution_not_complete_rejected


