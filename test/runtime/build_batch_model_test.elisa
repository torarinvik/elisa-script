include "../../src/ir/ir.elisa"

using EsBuild
using EsBuildBatch
using EsBuildExecutor
using EsBuildIncremental
using EsBuildRecipeSignature
using EsBuildScheduler
using EsProcess
using EsProcessBatch


def build_batch_test_command() -> ProcessCommand:
    return ProcessCommand{
        executable: "/usr/bin/true",
        working_directory: "/tmp",
        environment_mode: ProcessEnvironmentMode.Clear,
        stdin_mode: ProcessStdioMode.Null,
        stdout_mode: ProcessStdioMode.Capture,
        stderr_mode: ProcessStdioMode.Capture,
        timeout_micros: 5000000u64,
        capture_output_limit_bytes: 1024
    }


@test
def build_batch_dispatches_ready_nodes_and_refills_capacity() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [
                BuildNode{name: "compile", command: command, fingerprint: 1},
                BuildNode{name: "link", command: command, dependencies: [0], fingerprint: 2},
                BuildNode{name: "generate", command: command, fingerprint: 3}
            ],
            max_parallel: 2
        }
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        assert begin_build_batch(session) == BuildSchedulerState.Running

        first_wave: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert first_wave.count == 2
        assert first_wave[0].node_index == 0 and first_wave[1].node_index == 2
        assert first_wave[0].dispatch.job_id == 1 and first_wave[1].dispatch.job_id == 3
        assert session.scheduler.active_nodes == 2 and session.processes.active == 2
        empty_wave: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert empty_wave.count == 0

        assert report_build_batch_result(session, first_wave[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited, stdout: "object"}) == BuildSchedulerState.Running
        next_wave: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert next_wave.count == 1 and next_wave[0].node_index == 1
        assert report_build_batch_result(session, first_wave[1].dispatch, ProcessResult{kind: ProcessResultKind.Exited}) == BuildSchedulerState.Running
        assert report_build_batch_result(session, next_wave[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited, stderr: "linked"}) == BuildSchedulerState.Complete
        assert session.scheduler.graph.nodes[0].state == BuildNodeState.Succeeded
        assert session.scheduler.graph.nodes[1].state == BuildNodeState.Succeeded
        assert session.scheduler.graph.nodes[2].state == BuildNodeState.Succeeded
        assert session.results[0].process.stdout == "object"
        assert session.results[2].process.stderr == "linked"
        assert session.scheduler.graph.log_bytes == 12
        assert validate_build_batch_session(session)

        execution: BuildExecutionResult = build_batch_execution_result(session)
        assert execution.graph_state == BuildGraphState.Succeeded
        assert execution.nodes.count == 3 and execution.log_bytes == 12
        assert execution.nodes[0].started and not execution.nodes[0].cache_hit
        assert execution.nodes[0].stdout == "object"
        assert execution.nodes[1].started and not execution.nodes[1].cache_hit
        assert execution.nodes[2].started and not execution.nodes[2].cache_hit
        assert execution.nodes[2].stderr == "linked"


@test
def build_batch_rejects_aggregate_plan_vector_over_limit_before_snapshotting() -> void:
    can Memory.Allocate, Abort.Panic:
        arguments: mutable darray[sview] = []
        for _ in 0..<16385 |arguments|:
            arguments.push("x")
        template_command: mutable ProcessCommand = build_batch_test_command()
        template_command.arguments <- arguments
        graph: BuildGraph = BuildGraph{
            nodes: [
                BuildNode{name: "compile_a", command: template_command, fingerprint: 21},
                BuildNode{name: "compile_b", command: template_command, fingerprint: 22},
                BuildNode{name: "compile_c", command: template_command, fingerprint: 23},
                BuildNode{name: "compile_d", command: template_command, fingerprint: 24}
            ],
            max_parallel: 4
        }

        rejected: mutable bool = false
        catch build_batch_session_for_graph(graph):
            ok session:
                _ = session
                assert false
            error failure:
                rejected <- failure == BuildBatchError.PlanLimitExceeded
        assert rejected


@test
def build_batch_counts_dependency_edges_in_aggregate_plan_vector_budget() -> void:
    can Memory.Allocate, Abort.Panic:
        node_count: usize = 363
        command: ProcessCommand = build_batch_test_command()
        nodes: mutable darray[BuildNode] = []
        names: mutable darray[sview] = []
        for index in 0..<node_count |nodes, names|:
            node_name: sview = "node-" + f"{index}"
            dependencies: mutable darray[usize] = []
            for dependency_index in 0..<index |dependencies|:
                dependencies.push(dependency_index)
            nodes.push(BuildNode{name: node_name, command: command, dependencies: dependencies, fingerprint: (index + 1).u64()})
            names.push(node_name)

        ordered_names: darray[sview] = sorted(names)
        name_order: mutable darray[BuildNodeNameIndex] = []
        for ordered_name in ordered_names |ordered_names, nodes, name_order|:
            for node_index in 0..<nodes.count |nodes, name_order|:
                if nodes[node_index].name == ordered_name:
                    name_order.push(BuildNodeNameIndex{name: ordered_name, node_index: node_index})
                    break

        graph: BuildGraph = BuildGraph{nodes: nodes, node_name_order: name_order, max_parallel: 1}
        rejected: mutable bool = false
        catch build_batch_session_for_graph(graph):
            ok session:
                _ = session
                assert false
            error failure:
                rejected <- failure == BuildBatchError.PlanLimitExceeded
        assert rejected


