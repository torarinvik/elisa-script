@test
def build_dependency_resolver_bounds_named_edges_before_resolution() -> void:
    can Memory.Allocate, Abort.Panic:
        node_count: usize = 17
        node_names: mutable darray[sview] = []
        dependency_names: mutable darray[BuildDependencyNames] = []
        for node_index in 0..<node_count |node_names, dependency_names|:
            node_names.push("node-" + f"{node_index}")
            names: mutable darray[sview] = []
            if node_index != 0:
                for _ in 0..<4096 |names|:
                    names.push("node-0")
            dependency_names.push(BuildDependencyNames{names: names})

        rejected: mutable bool = false
        catch resolve_build_dependencies(node_names, dependency_names):
            ok resolution:
                _ = resolution
                assert false
            error failure:
                rejected <- failure == BuildContractError.PlanVectorLimitExceeded
        assert rejected


@test
def build_batch_plan_text_bound_matches_graph_contract() -> void:
    can Memory.Allocate, Abort.Panic:
        argument_bytes: mutable darray[u8] = []
        argument_bytes.reserve(33554432)
        for _ in 0..<33554432 |argument_bytes|:
            argument_bytes.push(120u8)
        large_argument: sview = bytes_view(argument_bytes)
        command: mutable ProcessCommand = build_batch_test_command()
        command.arguments <- [large_argument]
        graph: BuildGraph = BuildGraph{
            nodes: [
                BuildNode{name: "large_a", command: command, fingerprint: 1},
                BuildNode{name: "large_b", command: command, fingerprint: 2}
            ],
            max_parallel: 1
        }

        graph_limit_rejected: mutable bool = false
        catch validate_build_graph(graph):
            ok valid:
                _ = valid
                assert false
            error failure:
                graph_limit_rejected <- failure == BuildContractError.PlanTextLimitExceeded
        assert graph_limit_rejected

        index_command: mutable ProcessCommand = build_batch_test_command()
        index_command.arguments <- [large_argument]
        index_graph: BuildGraph = BuildGraph{
            nodes: [BuildNode{name: "small", command: index_command, fingerprint: 3}],
            node_name_order: [BuildNodeNameIndex{name: large_argument, node_index: 0}],
            max_parallel: 1
        }
        index_text_rejected: mutable bool = false
        catch validate_build_graph(index_graph):
            ok valid:
                _ = valid
                assert false
            error failure:
                index_text_rejected <- failure == BuildContractError.PlanTextLimitExceeded
        assert index_text_rejected

        resolution_graph: mutable BuildGraph = BuildGraph{
            nodes: [BuildNode{name: "attach", command: command, fingerprint: 4}],
            max_parallel: 1
        }
        resolution: BuildDependencyResolution = BuildDependencyResolution{
            dependencies: [[]],
            node_name_order: [BuildNodeNameIndex{name: large_argument, node_index: 0}]
        }
        attach_limit_rejected: mutable bool = false
        catch attach_build_dependency_resolution(resolution_graph, resolution):
            ok attached:
                _ = attached
                assert false
            error failure:
                attach_limit_rejected <- failure == BuildContractError.PlanTextLimitExceeded
        assert attach_limit_rejected
        assert resolution_graph.nodes[0].dependencies.count == 0 and resolution_graph.node_name_order.count == 0

        resolver_names: darray[sview] = ["resolver_a", "resolver_b"]
        resolver_dependencies: darray[BuildDependencyNames] = [
            BuildDependencyNames{names: [large_argument]},
            BuildDependencyNames{names: [large_argument]}
        ]
        resolver_text_rejected: mutable bool = false
        catch resolve_build_dependencies(resolver_names, resolver_dependencies):
            ok resolution:
                _ = resolution
                assert false
            error failure:
                resolver_text_rejected <- failure == BuildContractError.PlanTextLimitExceeded
        assert resolver_text_rejected

        batch_limit_rejected: mutable bool = false
        catch build_batch_session_for_graph(graph):
            ok session:
                _ = session
                assert false
            error failure:
                batch_limit_rejected <- failure == BuildBatchError.PlanLimitExceeded
        assert batch_limit_rejected


@test
def build_batch_rejects_dependency_plan_mutation_before_dispatch() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [
                BuildNode{name: "compile", command: command, fingerprint: 10},
                BuildNode{name: "link", command: command, dependencies: [0], fingerprint: 11}
            ],
            max_parallel: 2
        }
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        mutated_node: mutable BuildNode = session.scheduler.graph.nodes[1]
        mutated_node.dependencies <- []
        session.scheduler.graph.nodes[1] <- mutated_node

        mutation_rejected: mutable bool = false
        catch validate_build_batch_session(session):
            ok valid:
                _ = valid
                assert false
            error failure:
                mutation_rejected <- failure == BuildBatchError.JobMappingInvalid
        assert mutation_rejected


@test
def build_batch_rejects_recipe_signature_mutation_before_dispatch() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [BuildNode{
                name: "compile",
                command: command,
                fingerprint: 12,
                recipe_signature: BuildRecipeSignature{word0: 1, word1: 2, word2: 3, word3: 4}
            }],
            max_parallel: 1
        }
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        mutated_node: mutable BuildNode = session.scheduler.graph.nodes[0]
