include "../../src/ir/ir.elisa"

using EsBuild
using EsBuildBatch
using EsBuildExecutor
using EsBuildIncremental
using EsBuildRecipeSignature
using EsBuildScheduler
using EsProcess
using EsProcessBatch


def build_batch_test_command() -> ProcessCommand:
    return ProcessCommand{
        executable: "/usr/bin/true",
        stdin_mode: ProcessStdioMode.Null,
        stdout_mode: ProcessStdioMode.Capture,
        stderr_mode: ProcessStdioMode.Capture,
        timeout_micros: 5000000u64,
        capture_output_limit_bytes: 1024
    }


@test
def build_batch_dispatches_ready_nodes_and_refills_capacity() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [
                BuildNode{name: "compile", command: command, fingerprint: 1},
                BuildNode{name: "link", command: command, dependencies: [0], fingerprint: 2},
                BuildNode{name: "generate", command: command, fingerprint: 3}
            ],
            max_parallel: 2
        }
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        assert begin_build_batch(session) == BuildSchedulerState.Running

        first_wave: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert first_wave.count == 2
        assert first_wave[0].node_index == 0 and first_wave[1].node_index == 2
        assert first_wave[0].dispatch.job_id == 1 and first_wave[1].dispatch.job_id == 3
        assert session.scheduler.active_nodes == 2 and session.processes.active == 2
        empty_wave: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert empty_wave.count == 0

        assert report_build_batch_result(session, first_wave[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited, stdout: "object"}) == BuildSchedulerState.Running
        next_wave: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert next_wave.count == 1 and next_wave[0].node_index == 1
        assert report_build_batch_result(session, first_wave[1].dispatch, ProcessResult{kind: ProcessResultKind.Exited}) == BuildSchedulerState.Running
        assert report_build_batch_result(session, next_wave[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited, stderr: "linked"}) == BuildSchedulerState.Complete
        assert session.scheduler.graph.nodes[0].state == BuildNodeState.Succeeded
        assert session.scheduler.graph.nodes[1].state == BuildNodeState.Succeeded
        assert session.scheduler.graph.nodes[2].state == BuildNodeState.Succeeded
        assert session.results[0].process.stdout == "object"
        assert session.results[2].process.stderr == "linked"
        assert session.scheduler.graph.log_bytes == 12
        assert validate_build_batch_session(session)


@test
def incremental_build_batch_skips_verified_cache_hits_before_dispatch() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [
                BuildNode{name: "cached-object", command: command, fingerprint: 1},
                BuildNode{name: "dirty-object", command: command, dependencies: [0], fingerprint: 1}
            ],
            max_parallel: 2
        }
        recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "cached-object", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, inputs: ["src/cached.c"], outputs: ["build/cached.o"]},
            BuildIncrementalRecipeTarget{name: "dirty-object", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, inputs: ["src/dirty.c"], outputs: ["build/dirty.o"], dependencies: ["cached-object"]}
        ]
        toolchains: darray[BuildRecipeToolchainIdentity] = [BuildRecipeToolchainIdentity{word0: 11}, BuildRecipeToolchainIdentity{word0: 12}]
        signed: BuildRecipeSignedGraph = sign_build_incremental_graph(graph, recipes, toolchains)
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "cached-object", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: signed.recipes[0].recipe_fingerprint, recipe_signature: signed.recipes[0].recipe_signature, inputs: [BuildIncrementalFile{path: "src/cached.c", fingerprint: 21}], outputs: [BuildIncrementalFile{path: "build/cached.o", fingerprint: 31}]},
            BuildIncrementalTarget{name: "dirty-object", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: signed.recipes[1].recipe_fingerprint, recipe_signature: signed.recipes[1].recipe_signature, inputs: [BuildIncrementalFile{path: "src/dirty.c", fingerprint: 22}], outputs: [BuildIncrementalFile{path: "build/dirty.o", fingerprint: 32}], dependencies: ["cached-object"]}
        ]
        observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/cached.c", present: true, fingerprint: 21},
            BuildIncrementalObservation{path: "build/cached.o", present: true, fingerprint: 31},
            BuildIncrementalObservation{path: "src/dirty.c", present: true, fingerprint: 22},
            BuildIncrementalObservation{path: "build/dirty.o", present: false}
        ]
        root: Path = path("/tmp/elisascript-build-batch")
        session: mutable BuildBatchSession = build_incremental_batch_session_for_recipes(root, signed.graph, previous, signed.recipes, observations)
        assert session.scheduler.cache.count == 1
        assert session.scheduler.cache[0].node_name == "cached-object"
        assert begin_build_batch(session) == BuildSchedulerState.Running
        assert session.scheduler.graph.nodes[0].state == BuildNodeState.Succeeded
        assert session.processes.jobs[0].state == ProcessBatchJobState.Skipped
        assert session.results[0].cache_hit and not session.results[0].dispatched and not session.results[0].published
        assert session.scheduler.active_nodes == 0 and session.scheduler.completed_nodes == 1
        assert session.processes.active == 0 and session.processes.completed == 1
        assert session.scheduler.ready_queue.count == 1 and session.scheduler.ready_queue[0] == 1
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 1 and launches[0].node_index == 1
        assert session.scheduler.active_nodes == 1 and session.processes.active == 1
        assert validate_build_batch_session(session)


@test
def incremental_build_batch_completes_without_launches_when_all_targets_are_cached() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [BuildNode{name: "cached-object", command: command, fingerprint: 1}],
            max_parallel: 1
        }
        recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "cached-object", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, inputs: ["src/cached.c"], outputs: ["build/cached.o"]}
        ]
        toolchains: darray[BuildRecipeToolchainIdentity] = [BuildRecipeToolchainIdentity{word0: 11}]
        signed: BuildRecipeSignedGraph = sign_build_incremental_graph(graph, recipes, toolchains)
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "cached-object", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: signed.recipes[0].recipe_fingerprint, recipe_signature: signed.recipes[0].recipe_signature, inputs: [BuildIncrementalFile{path: "src/cached.c", fingerprint: 21}], outputs: [BuildIncrementalFile{path: "build/cached.o", fingerprint: 31}]}
        ]
        observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/cached.c", present: true, fingerprint: 21},
            BuildIncrementalObservation{path: "build/cached.o", present: true, fingerprint: 31}
        ]
        root: Path = path("/tmp/elisascript-build-batch-cache-only")
        session: mutable BuildBatchSession = build_incremental_batch_session_for_recipes(root, signed.graph, previous, signed.recipes, observations)
        assert session.scheduler.cache.count == 1
        assert begin_build_batch(session) == BuildSchedulerState.Complete
        assert session.scheduler.graph.nodes[0].state == BuildNodeState.Succeeded
        assert session.processes.state == ProcessBatchState.Succeeded
        assert session.processes.jobs[0].state == ProcessBatchJobState.Skipped
        assert session.results[0].cache_hit and not session.results[0].dispatched
        assert session.processes.jobs[0].attempts == 0 and session.scheduler.ready_queue.count == 0

        valid_cache_hit_count: usize = session.scheduler.cache_hits
        session.scheduler.cache_hits <- 0
        forged_cache_count_rejected: mutable bool = false
        catch validate_build_batch_session(session):
            ok value:
                assert false
            error failure:
                forged_cache_count_rejected <- failure == BuildBatchError.JobMappingInvalid
        assert forged_cache_count_rejected
        session.scheduler.cache_hits <- valid_cache_hit_count
        assert validate_build_batch_session(session)


@test
def incremental_build_batch_invalidates_cached_dependents_of_dirty_inputs() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [
                BuildNode{name: "producer", command: command, fingerprint: 1},
                BuildNode{name: "consumer", command: command, dependencies: [0], fingerprint: 1}
            ],
            max_parallel: 2
        }
        recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "producer", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, inputs: ["src/input.c"], outputs: ["build/producer.o"]},
            BuildIncrementalRecipeTarget{name: "consumer", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, inputs: ["src/consumer.c"], outputs: ["build/consumer.o"], dependencies: ["producer"]}
        ]
        toolchains: darray[BuildRecipeToolchainIdentity] = [BuildRecipeToolchainIdentity{word0: 11}, BuildRecipeToolchainIdentity{word0: 12}]
        signed: BuildRecipeSignedGraph = sign_build_incremental_graph(graph, recipes, toolchains)
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "producer", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: signed.recipes[0].recipe_fingerprint, recipe_signature: signed.recipes[0].recipe_signature, inputs: [BuildIncrementalFile{path: "src/input.c", fingerprint: 21}], outputs: [BuildIncrementalFile{path: "build/producer.o", fingerprint: 31}]},
            BuildIncrementalTarget{name: "consumer", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: signed.recipes[1].recipe_fingerprint, recipe_signature: signed.recipes[1].recipe_signature, inputs: [BuildIncrementalFile{path: "src/consumer.c", fingerprint: 22}], outputs: [BuildIncrementalFile{path: "build/consumer.o", fingerprint: 32}], dependencies: ["producer"]}
        ]
        observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/input.c", present: true, fingerprint: 99},
            BuildIncrementalObservation{path: "build/producer.o", present: true, fingerprint: 31},
            BuildIncrementalObservation{path: "src/consumer.c", present: true, fingerprint: 22},
            BuildIncrementalObservation{path: "build/consumer.o", present: true, fingerprint: 32}
        ]
        root: Path = path("/tmp/elisascript-build-batch-dirty-dependency")
        session: mutable BuildBatchSession = build_incremental_batch_session_for_recipes(root, signed.graph, previous, signed.recipes, observations)
        assert session.scheduler.cache.count == 0
        assert begin_build_batch(session) == BuildSchedulerState.Running
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 1 and launches[0].node_index == 0
        assert session.processes.jobs[0].state == ProcessBatchJobState.Running
        assert session.processes.jobs[1].state == ProcessBatchJobState.Pending
        assert validate_build_batch_session(session)

        session.scheduler.cache.push(BuildCacheEntry{node_name: "consumer", fingerprint: 1})
        forged_unused_cache_rejected: mutable bool = false
        catch validate_build_batch_session(session):
            ok value:
                assert false
            error failure:
                forged_unused_cache_rejected <- failure == BuildBatchError.JobMappingInvalid
        assert forged_unused_cache_rejected


@test
def build_batch_failure_cancels_unstarted_nodes_and_drains_siblings() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [
                BuildNode{name: "fail", command: command, fingerprint: 11},
                BuildNode{name: "sibling", command: command, fingerprint: 12},
                BuildNode{name: "dependent", command: command, dependencies: [0], fingerprint: 13}
            ],
            max_parallel: 2
        }
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        _ = begin_build_batch(session)
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 2
        assert report_build_batch_result(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited, exit_status: 1, stderr: "compile error"}) == BuildSchedulerState.Failing
        assert session.processes.state == ProcessBatchState.Draining
        assert session.scheduler.graph.nodes[2].state == BuildNodeState.Cancelled
        assert session.processes.jobs[2].state == ProcessBatchJobState.Cancelled
        assert report_build_batch_result(session, launches[1].dispatch, ProcessResult{kind: ProcessResultKind.Exited}) == BuildSchedulerState.Failed
        assert session.scheduler.graph.failed_nodes == 1
        assert session.scheduler.graph.nodes[1].state == BuildNodeState.Succeeded
        assert validate_build_batch_session(session)


@test
def build_batch_cancellation_during_failure_drain_preserves_failure() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{
            nodes: [
                BuildNode{name: "failed", command: command, fingerprint: 14},
                BuildNode{name: "active-sibling", command: command, fingerprint: 15}
            ],
            max_parallel: 2
        }
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        _ = begin_build_batch(session)
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 2
        assert report_build_batch_result(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited, exit_status: 1, stderr: "compile error"}) == BuildSchedulerState.Failing

        stop_requests: darray[ProcessBatchDispatch] = cancel_build_batch(session)
        assert stop_requests.count == 1
        assert stop_requests[0].job_index == launches[1].dispatch.job_index
        assert stop_requests[0].job_id == launches[1].dispatch.job_id
        assert stop_requests[0].attempt_token == launches[1].dispatch.attempt_token
        assert session.scheduler.state == BuildSchedulerState.Failing
        assert session.processes.state == ProcessBatchState.Cancelling
        assert acknowledge_build_batch_stop(session, stop_requests) == BuildSchedulerState.Failed
        assert session.processes.state == ProcessBatchState.Failed
        assert session.scheduler.graph.nodes[0].state == BuildNodeState.Failed
        assert session.scheduler.graph.nodes[1].state == BuildNodeState.Cancelled
        assert session.scheduler.graph.failed_nodes == 1
        assert session.results[0].published and session.results[0].process.stderr == "compile error"
        assert session.scheduler.graph.log_bytes == len("compile error")
        assert validate_build_batch_session(session)


@test
def build_batch_cancels_before_begin_without_host_reap() -> void:
    can Memory.Allocate, Abort.Panic:
        graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "first", command: build_batch_test_command(), fingerprint: 27},
            BuildNode{name: "second", command: build_batch_test_command(), fingerprint: 28}
        ]}
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        active: darray[ProcessBatchDispatch] = cancel_build_batch(session)
        assert active.count == 0
        assert session.scheduler.state == BuildSchedulerState.Cancelled
        assert session.processes.state == ProcessBatchState.Cancelled
        assert session.scheduler.graph.completed_nodes == 2
        assert session.processes.jobs[0].state == ProcessBatchJobState.Cancelled
        assert session.processes.jobs[1].state == ProcessBatchJobState.Cancelled
        assert session.processes.active == 0
        assert validate_build_batch_session(session)


@test
def build_batch_cancellation_waits_for_host_reap_acknowledgement() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "first", command: command, fingerprint: 21},
            BuildNode{name: "second", command: command, fingerprint: 22}
        ], max_parallel: 2}
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        _ = begin_build_batch(session)
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 2
        stop_requests: darray[ProcessBatchDispatch] = cancel_build_batch(session)
        assert stop_requests.count == 2
        assert session.scheduler.state == BuildSchedulerState.Cancelling
        assert session.processes.state == ProcessBatchState.Cancelling
        incomplete_acknowledgement_rejected: mutable bool = false
        no_acknowledgements: darray[ProcessBatchDispatch] = []
        catch acknowledge_build_batch_stop(session, no_acknowledgements):
            ok value:
                assert false
            error failure:
                incomplete_acknowledgement_rejected <- failure == BuildBatchError.StopAcknowledgementMismatch
        assert incomplete_acknowledgement_rejected
        assert session.scheduler.state == BuildSchedulerState.Cancelling
        assert session.processes.active == 2 and session.reserved_output_bytes != 0
        stale_acknowledgement_rejected: mutable bool = false
        stale_acknowledgements: darray[ProcessBatchDispatch] = [
            ProcessBatchDispatch{
                job_index: stop_requests[0].job_index,
                job_id: stop_requests[0].job_id,
                attempt_token: stop_requests[0].attempt_token + 1
            },
            stop_requests[1]
        ]
        catch acknowledge_build_batch_stop(session, stale_acknowledgements):
            ok value:
                assert false
            error failure:
                stale_acknowledgement_rejected <- failure == BuildBatchError.StopAcknowledgementMismatch
        assert stale_acknowledgement_rejected
        assert session.scheduler.state == BuildSchedulerState.Cancelling
        assert session.processes.active == 2 and session.reserved_output_bytes != 0
        assert acknowledge_build_batch_stop(session, stop_requests) == BuildSchedulerState.Cancelled
        assert session.reserved_output_bytes == 0
        assert validate_build_batch_session(session)


@test
def build_batch_rejects_omitted_ready_queue_entries() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "ready-a", command: command, fingerprint: 31},
            BuildNode{name: "dependent", command: command, dependencies: [0], fingerprint: 32},
            BuildNode{name: "ready-b", command: command, fingerprint: 33}
        ], max_parallel: 2}
        forged: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        _ = begin_build_batch(forged)
        assert forged.scheduler.ready_queue.count == 2
        forged.scheduler.ready_queue <- []
        omitted_ready_rejected: mutable bool = false
        catch validate_build_batch_session(forged):
            ok value:
                assert false
            error failure:
                omitted_ready_rejected <- failure == BuildBatchError.JobMappingInvalid
        assert omitted_ready_rejected


@test
def build_batch_rejects_duplicate_terminal_receipts() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{nodes: [BuildNode{name: "single", command: command, fingerprint: 41}]}
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        _ = begin_build_batch(session)
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 1
        assert report_build_batch_result(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited, stdout: "done"}) == BuildSchedulerState.Complete
        duplicate_rejected: mutable bool = false
        catch report_build_batch_result(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited}):
            ok value:
                assert false
            error failure:
                duplicate_rejected <- failure == ProcessBatchError.DispatchMismatch
        assert duplicate_rejected
        assert session.scheduler.state == BuildSchedulerState.Complete
        assert session.results[0].process.stdout == "done" and session.scheduler.graph.log_bytes == 4
        assert validate_build_batch_session(session)


@test
def build_batch_rejects_malformed_process_result_without_consuming_reservation() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{nodes: [BuildNode{name: "validated", command: command, fingerprint: 49}]}
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        _ = begin_build_batch(session)
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 1

        malformed_rejected: mutable bool = false
        catch report_build_batch_result(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited, signal: 9}):
            ok value:
                assert false
            error failure:
                malformed_rejected <- failure == BuildBatchError.ResultInvalid
        assert malformed_rejected
        assert session.scheduler.state == BuildSchedulerState.Running
        assert session.processes.active == 1 and session.reserved_output_bytes == command.capture_output_limit_bytes
        assert not session.results[0].published and session.scheduler.graph.log_bytes == 0
        assert report_build_batch_result(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited}) == BuildSchedulerState.Complete
        assert validate_build_batch_session(session)


@test
def build_batch_rejects_output_overrun_without_consuming_reservation() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = ProcessCommand{
            executable: "/usr/bin/true",
            stdin_mode: ProcessStdioMode.Null,
            stdout_mode: ProcessStdioMode.Capture,
            stderr_mode: ProcessStdioMode.Capture,
            timeout_micros: 5000000u64,
            capture_output_limit_bytes: 8
        }
        graph: BuildGraph = BuildGraph{nodes: [BuildNode{name: "limited", command: command, fingerprint: 51}]}
        session: mutable BuildBatchSession = build_batch_session_for_graph(graph)
        _ = begin_build_batch(session)
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 1 and launches[0].command.capture_output_limit_bytes == 8

        oversized_rejected: mutable bool = false
        catch report_build_batch_result(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited, stdout: "123456789"}):
            ok value:
                assert false
            error failure:
                oversized_rejected <- failure == BuildBatchError.OutputLimitExceeded
        assert oversized_rejected
        assert session.scheduler.state == BuildSchedulerState.Running
        assert session.processes.active == 1 and session.reserved_output_bytes == 8
        assert not session.results[0].published and session.scheduler.graph.log_bytes == 0

        assert report_build_batch_result(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.OutputLimit, stdout: "12345678"}) == BuildSchedulerState.Failed
        assert session.results[0].process.kind == ProcessResultKind.OutputLimit
        assert session.scheduler.graph.log_bytes == 8
        assert validate_build_batch_session(session)


@test
def build_batch_missing_output_fails_before_dispatching_dependents() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Write:
        temporary: Path = try temp_directory("build-batch-missing-output") else err:
            assert false
            return
        output: Path = temporary.joinpath("generated.h")
        output_text: sview = f"{output}"
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "generate", command: command, fingerprint: 61},
            BuildNode{name: "compile", command: command, dependencies: [0], fingerprint: 62}
        ]}
        output_sets: darray[BuildExecutionNodeOutputs] = [
            BuildExecutionNodeOutputs{target_name: "generate", paths: [output_text]},
            BuildExecutionNodeOutputs{target_name: "compile"}
        ]
        session: mutable BuildBatchSession = build_batch_session_for_graph_with_outputs(graph, output_sets)
        _ = begin_build_batch(session)
        launches: darray[BuildBatchLaunch] = dispatch_build_batch_ready(session)
        assert launches.count == 1 and launches[0].node_index == 0

        state: BuildSchedulerState = report_build_batch_result_with_outputs(session, launches[0].dispatch, ProcessResult{kind: ProcessResultKind.Exited})
        next_wave: mutable darray[BuildBatchLaunch] = []
        if state == BuildSchedulerState.Running:
            next_wave <- try dispatch_build_batch_ready(session)
        output_absent: bool = not is_file(output)
        removed_directory: bool = try remove_directory(temporary) else false
        assert state == BuildSchedulerState.Failed and next_wave.count == 0
        assert session.scheduler.graph.nodes[0].state == BuildNodeState.Failed
        assert session.scheduler.graph.nodes[1].state == BuildNodeState.Cancelled
        assert session.results[0].missing_output == output_text
        assert session.results[0].process.exit_status == 0 and output_absent
        assert removed_directory and validate_build_batch_session(session)


@test
def build_batch_maps_recipe_outputs_under_absolute_root() -> void:
    can Memory.Allocate, Abort.Panic:
        command: ProcessCommand = build_batch_test_command()
        graph: BuildGraph = BuildGraph{nodes: [BuildNode{name: "generate", command: command, fingerprint: 71}]}
        recipes: darray[BuildIncrementalRecipeTarget] = [BuildIncrementalRecipeTarget{
            name: "generate",
            kind: BuildIncrementalTargetKind.GeneratedFile,
            recipe_fingerprint: 71,
            outputs: ["generated/config.h"]
        }]
        root: Path = path("/tmp/elisascript-batch-root")
        outputs: darray[BuildExecutionNodeOutputs] = build_batch_output_sets_from_recipes(root, graph, recipes)
        assert outputs.count == 1 and outputs[0].target_name == "generate"
        assert outputs[0].paths == ["/tmp/elisascript-batch-root/generated/config.h"]
        session: BuildBatchSession = build_batch_session_for_recipes(root, graph, recipes)
        assert session.output_sets.count == 1 and session.output_sets[0].paths == outputs[0].paths

        invalid_root_rejected: mutable bool = false
        catch build_batch_output_sets_from_recipes(path("relative/root"), graph, recipes):
            ok value:
                assert false
            error failure:
                invalid_root_rejected <- failure == BuildBatchError.InvalidOutputRoot
        assert invalid_root_rejected

        escaping_recipes: darray[BuildIncrementalRecipeTarget] = [BuildIncrementalRecipeTarget{
            name: "generate",
            kind: BuildIncrementalTargetKind.GeneratedFile,
            recipe_fingerprint: 71,
            outputs: ["../outside/generated.h"]
        }]
        traversal_rejected: mutable bool = false
        catch build_batch_output_sets_from_recipes(root, graph, escaping_recipes):
            ok value:
                assert false
            error failure:
                traversal_rejected <- failure == BuildIncrementalError.InvalidPath
        assert traversal_rejected
