# Pure shape tests; none of these numbers is used with a native process API.
include "../../src/runtime/process_pid_model.elisa"
include "../../src/runtime/process_spawn_wait_model.elisa"

using EsProcessPid


@test
def process_pid_shapes_admit_only_selected_positive_child_domain() -> void:
    can Memory.Allocate, Abort.Panic:
        for pid in [2i64, 41i64, 2147483647i64]:
            assert child_shape(pid) and signal_shape(pid) and signal_shape(-pid)
            assert EsProcessSpawnWait::exact_reap(pid, pid, 0i64)
            assert not EsProcessSpawnWait::uncertain_positive_wait(0i64, pid, 0i64)
        for pid in [-9223372036854775807i64 - 1i64, -2147483648i64, -2i64, -1i64, 0i64, 1i64, 2147483648i64, 4294967295i64, 9223372036854775807i64]:
            assert not child_shape(pid)
            assert not EsProcessSpawnWait::exact_reap(pid, pid, 0i64)
            assert EsProcessSpawnWait::uncertain_positive_wait(0i64, pid, 0i64)


@test
def process_pid_signal_shapes_reject_broadcast_and_overflow_selectors() -> void:
    can Memory.Allocate, Abort.Panic:
        for selector in [-9223372036854775807i64 - 1i64, -2147483648i64, -1i64, 0i64, 1i64, 2147483648i64, 9223372036854775807i64]:
            assert not signal_shape(selector)
        assert signal_shape(-2147483647i64) and signal_shape(-2i64)
        # A shape match does not prove the admitted value belongs to this run.
        assert not EsProcessSpawnWait::exact_reap(42i64, 41i64, 0i64)
