include "../../src/ir/ir.elisa"

using EsPkgConfig


@test
def pkg_config_query_plan_uses_explicit_argv_and_version_constraint() -> void:
    can Memory.Allocate, Abort.Panic:
        requirement: PkgConfigRequirement = PkgConfigRequirement{
            name: "glib-2.0",
            version_operator: PkgConfigVersionOperator.AtLeast,
            version: "2.78.0"
        }
        plan: PkgConfigQueryPlan = pkg_config_query_plan("/opt/toolchain/bin/pkg-config", "/work/project", requirement)
        assert plan.exists.executable == "/opt/toolchain/bin/pkg-config"
        assert plan.exists.arguments.count == 3
        assert plan.exists.arguments[0] == "--print-errors"
        assert plan.exists.arguments[1] == "--exists"
        assert plan.exists.arguments[2] == "glib-2.0 >= 2.78.0"
        assert plan.version.arguments[0] == "--modversion" and plan.version.arguments[1] == "glib-2.0"
        assert plan.compile_flags.arguments[0] == "--cflags" and plan.compile_flags.arguments[1] == "glib-2.0"
        assert plan.link_flags.arguments[0] == "--libs" and plan.link_flags.arguments[1] == "glib-2.0"
        assert plan.exists.environment_mode == ProcessEnvironmentMode.Clear
        assert plan.exists.stdin_mode == ProcessStdioMode.Null
        assert plan.exists.stdout_mode == ProcessStdioMode.Capture and plan.exists.stderr_mode == ProcessStdioMode.Capture
        assert plan.exists.failure_mode == ProcessFailureMode.Check

        static_requirement: PkgConfigRequirement = PkgConfigRequirement{name: "zlib", static_linking: true}
        static_plan: PkgConfigQueryPlan = pkg_config_query_plan("/usr/bin/pkg-config", "/work/project", static_requirement)
        assert static_plan.link_flags.arguments.count == 3
        assert static_plan.link_flags.arguments[0] == "--static"
        assert static_plan.link_flags.arguments[1] == "--libs"
        assert static_plan.link_flags.arguments[2] == "zlib"


@test
def pkg_config_query_plan_replaces_environment_exactly() -> void:
    can Memory.Allocate, Abort.Panic:
        requirement: PkgConfigRequirement = PkgConfigRequirement{name: "zlib"}
        plan: PkgConfigQueryPlan = pkg_config_query_plan("/usr/bin/pkg-config", "/work/project", requirement, ["PKG_CONFIG_PATH", "/opt/prefix/lib/pkgconfig", "PKG_CONFIG_SYSROOT_DIR", "/opt/sysroot"])
        assert plan.exists.environment_mode == ProcessEnvironmentMode.Replace
        assert plan.exists.environment.count == 4
        assert plan.exists.environment[0] == "PKG_CONFIG_PATH"
        assert plan.exists.environment[1] == "/opt/prefix/lib/pkgconfig"
        assert plan.exists.environment[2] == "PKG_CONFIG_SYSROOT_DIR"
        assert plan.exists.environment[3] == "/opt/sysroot"


@test
def pkg_config_query_plan_rejects_invalid_names_versions_and_paths() -> void:
    can Memory.Allocate, Abort.Panic:
        invalid_name: mutable bool = false
        catch pkg_config_query_plan("/usr/bin/pkg-config", "/work/project", PkgConfigRequirement{name: "-malicious"}):
            ok plan:
                _ = plan
            error failure:
                invalid_name <- failure == PkgConfigError.InvalidPackageName
        assert invalid_name

        invalid_version: mutable bool = false
        catch pkg_config_query_plan("/usr/bin/pkg-config", "/work/project", PkgConfigRequirement{name: "zlib", version_operator: PkgConfigVersionOperator.AtLeast, version: "1.2;touch"}):
            ok plan:
                _ = plan
            error failure:
                invalid_version <- failure == PkgConfigError.InvalidVersion
        assert invalid_version

        relative_tool: mutable bool = false
        catch pkg_config_query_plan("pkg-config", "/work/project", PkgConfigRequirement{name: "zlib"}):
            ok plan:
                _ = plan
            error failure:
                relative_tool <- failure == PkgConfigError.InvalidExecutable
        assert relative_tool
