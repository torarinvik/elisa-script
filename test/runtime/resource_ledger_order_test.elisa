# Pure ledger validation. No OS handle, process launch or wait is acquired.
include "../../src/runtime/resource_model.elisa"

using EsResource


@test
def resource_ledger_empty_single_ordered_and_unordered_ids_remain_valid() -> void:
    can Memory.Allocate, Abort.Panic:
        ledger: mutable ResourceLedger = ResourceLedger{}
        empty_valid: bool = try validate_resource_ledger(ledger) else false
        assert empty_valid
        _ = try resource_ledger_acquire(ledger, 1, ResourceKind.Process, 7) else failure:
            assert false
            return
        single_valid: bool = try validate_resource_ledger(ledger) else false
        assert single_valid
        _ = try resource_ledger_acquire(ledger, 3, ResourceKind.NativeAttribute, 7) else failure:
            assert false
            return
        ordered_valid: bool = try validate_resource_ledger(ledger) else false
        assert ordered_valid
        _ = try resource_ledger_acquire(ledger, 2, ResourceKind.Process, 7) else failure:
            assert false
            return
        unordered_valid: bool = try validate_resource_ledger(ledger) else false
        assert unordered_valid
        assert ledger.resources[0].id == 1 and ledger.resources[1].id == 3 and ledger.resources[2].id == 2


@test
def resource_ledger_nonadjacent_duplicate_ids_are_still_rejected() -> void:
    can Memory.Allocate, Abort.Panic:
        ledger: ResourceLedger = ResourceLedger{resources: [ResourceLease{id: 3, kind: ResourceKind.Process, owner_token: 7}, ResourceLease{id: 1, kind: ResourceKind.Process, owner_token: 7}, ResourceLease{id: 3, kind: ResourceKind.Process, owner_token: 7}], active_entries: 3}
        rejected: mutable bool = false
        catch validate_resource_ledger(ledger):
            ok _:
                assert false
            error failure:
                rejected <- failure == ResourceContractError.DuplicateId
        assert rejected


@test
def resource_ledger_ordered_ids_do_not_skip_state_accounting_validation() -> void:
    can Memory.Allocate, Abort.Panic:
        ledger: mutable ResourceLedger = ResourceLedger{resources: [ResourceLease{id: 1, kind: ResourceKind.Process, owner_token: 7, state: ResourceLeaseState.Released}, ResourceLease{id: 2, kind: ResourceKind.NativeAttribute, owner_token: 7, state: ResourceLeaseState.Failed}], failed_entries: 1}
        ordered_valid: bool = try validate_resource_ledger(ledger) else false
        assert ordered_valid
        ledger.active_entries <- 1
        rejected: mutable bool = false
        catch validate_resource_ledger(ledger):
            ok _:
                assert false
            error failure:
                rejected <- failure == ResourceContractError.AccountingInvalid
        assert rejected
