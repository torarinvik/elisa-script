# Pure recipe boundaries; no filesystem, allocator receipt or child process.
include "../../src/runtime/ui_codec_build_model.elisa"

module EsUiCodecPathBudgetFixture:
    private:
        const module Fixture:
            C_PATH_BYTES: usize = 4096
            PROJECT_BYTES: usize = 4066
            TEMPORARY_BYTES: usize = 4073
            COMPILER_BYTES: usize = 4095


        def text(count: usize, absolute: bool) -> sview can[Memory.Allocate, Abort.Panic]:
            bytes: mutable darray[u8] = []
            bytes.reserve(count)
            for index in 0..<count |bytes|:
                bytes.push(47u8 if absolute and index == 0 else 120u8)
            return bytes_view(bytes)

    public:
        @test
        def ui_codec_recipe_bounds_complete_project_paths_not_only_root_input() -> void:
            can Memory.Allocate, Abort.Panic:
                assert EsUiCodecBuild::Limits::PATH_BYTES == Fixture::C_PATH_BYTES
                root: sview = text(Fixture::PROJECT_BYTES, true)
                planned: EsUiCodecBuild::Recipe = try EsUiCodecBuild::recipe(root, "/temp") else failure:
                    assert false
                    return
                # Literal suffix lengths: source path 29, include path 20.
                assert len(planned.arguments[8]) == 4095
                assert planned.arguments[8] == root + "/test/utf8_utf16_codec_test.c"
                assert len(planned.arguments[7]) == 4088
                assert planned.arguments[7] == "-I" + root + "/src/platform/common"
                rejected: mutable bool = false
                catch EsUiCodecBuild::recipe(root + "x", "/temp"):
                    ok _:
                        assert false
                    error failure:
                        rejected <- failure == EsUiCodecBuild::RecipeError.InvalidRoot
                assert rejected


        @test
        def ui_codec_recipe_bounds_output_executable_with_its_c_terminator() -> void:
            can Memory.Allocate, Abort.Panic:
                for absolute in [false, true]:
                    temporary: sview = text(Fixture::TEMPORARY_BYTES, absolute)
                    planned: EsUiCodecBuild::Recipe = try EsUiCodecBuild::recipe("/project", temporary) else failure:
                        assert false
                        return
                    assert planned.executable == temporary + "/utf8_utf16_codec_test"
                    assert len(planned.executable) == 4095
                    assert planned.arguments[10] == planned.executable
                    rejected: mutable bool = false
                    catch EsUiCodecBuild::recipe("/project", temporary + "x"):
                        ok _:
                            assert false
                        error failure:
                            rejected <- failure == EsUiCodecBuild::RecipeError.InvalidTemporaryRoot
                    assert rejected


        @test
        def ui_codec_compiler_name_boundary_agrees_between_policy_and_recipe() -> void:
            can Memory.Allocate, Abort.Panic:
                compiler: sview = text(Fixture::COMPILER_BYTES, true)
                policy: EsUiCodecBuild::CompilerEnvironment = try EsUiCodecBuild::compiler_environment(compiler, true) else failure:
                    assert false
                    return
                assert not policy.set_cc
                planned: EsUiCodecBuild::Recipe = try EsUiCodecBuild::recipe("/project", "/temp", compiler) else failure:
                    assert false
                    return
                assert planned.compiler == compiler
                rejected_policy: mutable bool = false
                catch EsUiCodecBuild::compiler_environment(compiler + "x", true):
                    ok _:
                        assert false
                    error failure:
                        rejected_policy <- failure == EsUiCodecBuild::RecipeError.InvalidCompiler
                assert rejected_policy
                rejected_recipe: mutable bool = false
                catch EsUiCodecBuild::recipe("/project", "/temp", compiler + "x"):
                    ok _:
                        assert false
                    error failure:
                        rejected_recipe <- failure == EsUiCodecBuild::RecipeError.InvalidCompiler
                assert rejected_recipe
