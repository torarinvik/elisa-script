# Pure template construction only: no temporary allocation or environment read.
include "../../src/runtime/temporary_path_model.elisa"

using EsTemporaryPath


@test
def temporary_path_template_preserves_parent_and_prefix_spellings() -> void:
    can Memory.Allocate, Abort.Panic:
        assert template("/tmp") == "/tmp/elisascript-XXXXXX"
        assert template("/tmp", "ui-codec-") == "/tmp/elisascript-ui-codec-XXXXXX"
        assert template("/parent with spaces/", "name-") == "/parent with spaces//elisascript-name-XXXXXX"
        assert template("relative/root", "literal $*;") == "relative/root/elisascript-literal $*;XXXXXX"
        assert template("/", "") == "//elisascript-XXXXXX"
        assert template("/\xc3\xa9", "\xe2\x98\x83") == "/\xc3\xa9/elisascript-\xe2\x98\x83XXXXXX"


@test
def temporary_path_template_rejects_invalid_parent_and_prefix() -> void:
    can Memory.Allocate, Abort.Panic:
        for parent in ["", "/tmp\0other"]:
            rejected: mutable bool = false
            catch template(parent):
                ok _:
                    assert false
                error failure:
                    rejected <- failure == TemplateError.InvalidParent
            assert rejected
        for prefix in ["name/child", "name\0suffix"]:
            rejected: mutable bool = false
            catch template("/tmp", prefix):
                ok _:
                    assert false
                error failure:
                    rejected <- failure == TemplateError.InvalidPrefix
            assert rejected


@test
def temporary_path_template_checks_total_path_before_construction() -> void:
    can Memory.Allocate, Abort.Panic:
        prefix: mutable sview = ""
        for _ in 0..<4072 |prefix|:
            prefix <- prefix + "x"
        boundary: sview = try template("/tmp", prefix) else err:
            assert false
            return
        assert len(boundary) == 4095
        rejected: mutable bool = false
        catch template("/tmpx", prefix):
            ok _:
                assert false
            error failure:
                rejected <- failure == TemplateError.PathLimit
        assert rejected
        prefix_overflow: mutable bool = false
        catch template("/tmp", prefix + "x"):
            ok _:
                assert false
            error failure:
                prefix_overflow <- failure == TemplateError.PathLimit
        assert prefix_overflow
