include "../../src/runtime/python_text_model.elisa"

using EsPythonText


@test
def split_lines_matches_python_unicode_boundaries_and_crlf() -> void can[Memory.Allocate, Abort.Panic]:
    input: sview = "a\x0bb\x0cc\r\nd\x1ce\x1df\x1eg\xc2\x85h\xe2\x80\xa8i\xe2\x80\xa9"
    lines: mutable darray[sview] = []
    catch EsPythonText::split_lines(input):
        ok value:
            lines <- value
        error failure:
            _ = failure
            assert false
    assert lines.count == 9
    assert lines[0] == "a" and lines[1] == "b" and lines[2] == "c"
    assert lines[3] == "d" and lines[4] == "e" and lines[5] == "f"
    assert lines[6] == "g" and lines[7] == "h" and lines[8] == "i"


@test
def split_lines_does_not_add_a_trailing_empty_record() -> void can[Memory.Allocate, Abort.Panic]:
    empty: mutable darray[sview] = []
    catch EsPythonText::split_lines(""):
        ok value:
            empty <- value
        error failure:
            _ = failure
            assert false
    assert empty.count == 0

    lines: mutable darray[sview] = []
    catch EsPythonText::split_lines("\r\n"):
        ok value:
            lines <- value
        error failure:
            _ = failure
            assert false
    assert lines.count == 1 and lines[0] == ""


@test
def split_lines_rejects_invalid_utf8_like_python_text_output_decoding() -> void can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch EsPythonText::split_lines("A\xff"):
        ok value:
            _ = value
        error failure:
            rejected <- failure == PythonTextError.InvalidUtf8
    assert rejected
