include "../../src/ir/ir.elisa"

using EsBuild
using EsBuildExecutor
using EsBuildUsage
using EsBuildUsageArgv
using EsBuildUsageGraph
using EsProcess


def build_usage_graph_test_command(arguments: darray[sview]) -> BuildUsageProcessCommand error[BuildUsageArgvError, ProcessCommandError] can[Memory.Allocate, Abort.Panic]:
    target: BuildUsageTargetResult = BuildUsageTargetResult{name: "fixture"}
    argv: BuildUsageArgv = try build_usage_compile_argv(target, arguments, [], BuildUsageArgSyntax{include_prefix: "-I", definition_prefix: "-D", library_prefix: "-l"})
    return try build_usage_process_command(
        "/usr/bin/cc",
        argv,
        "/tmp",
        [],
        ProcessEnvironmentMode.Clear,
        60000000u64,
        1048576
    )


@test
def build_usage_actions_become_owned_ordered_output_checked_graph() -> void:
    can Memory.Allocate, Abort.Panic:
        actions: darray[BuildUsageActionSpec] = [
            BuildUsageActionSpec{
                name: "compile",
                command: build_usage_graph_test_command(["-c", "main.c", "-o", "main.o"]),
                fingerprint: 1,
                outputs: ["/tmp/elisascript-main.o"]
            },
            BuildUsageActionSpec{
                name: "link",
                command: build_usage_graph_test_command(["main.o", "-o", "app"]),
                dependencies: [0],
                fingerprint: 2,
                outputs: ["/tmp/elisascript-app"]
            }
        ]
        plan: mutable BuildUsageGraphPlan = build_usage_graph_plan(actions)
        assert plan.graph.nodes.count == 2
        assert plan.command_owners.count == 2
        assert plan.output_sets.count == 2
        expected_metadata_bytes: mutable usize = 0
        for command_owner in plan.command_owners |expected_metadata_bytes|:
            expected_metadata_bytes <- expected_metadata_bytes + command_owner.owned_executable.count + 1 + command_owner.owned_working_directory.count + 1 + command_owner.argv_storage.total_argument_bytes + command_owner.argv_storage.arguments.count
            for environment_entry in command_owner.owned_environment |expected_metadata_bytes|:
                expected_metadata_bytes <- expected_metadata_bytes + environment_entry.count + 1
        for owned_name in plan.owned_node_names |expected_metadata_bytes|:
            expected_metadata_bytes <- expected_metadata_bytes + owned_name.count
        for owned_output_path in plan.owned_output_paths |expected_metadata_bytes|:
            expected_metadata_bytes <- expected_metadata_bytes + owned_output_path.count
        assert plan.metadata_bytes == expected_metadata_bytes
        assert plan.output_sets[0].target_name == plan.graph.nodes[0].name
        assert plan.output_sets[0].paths[0] == "/tmp/elisascript-main.o"
        assert plan.output_sets[1].target_name == plan.graph.nodes[1].name
        assert plan.graph.nodes[1].dependencies[0] == 0
        assert validate_build_usage_graph_plan(plan)


@test
def build_usage_graph_plans_large_graph_with_canonical_name_index() -> void:
    can Memory.Allocate, Abort.Panic:
        actions: mutable darray[BuildUsageActionSpec] = []
        for action_index in 0..<129 |actions|:
            dependencies: darray[usize] = [action_index - 1] if action_index > 0 else []
            actions.push(BuildUsageActionSpec{
                name: f"node-{action_index}",
                command: build_usage_graph_test_command(["node", f"{action_index}"]),
                dependencies: dependencies,
                fingerprint: action_index.u64() + 1u64
            })
        plan: mutable BuildUsageGraphPlan = build_usage_graph_plan(actions)
        assert plan.graph.nodes.count == 129
        assert plan.graph.node_name_order.count == 129
        assert plan.graph.nodes[128].dependencies == [127]
        assert validate_build_usage_graph_plan(plan)


@test
def build_usage_graph_rejects_unordered_dependencies_before_execution() -> void:
    can Memory.Allocate, Abort.Panic:
        actions: darray[BuildUsageActionSpec] = [
            BuildUsageActionSpec{
                name: "first",
                command: build_usage_graph_test_command(["first"]),
                dependencies: [1],
                fingerprint: 1
            },
            BuildUsageActionSpec{
                name: "second",
                command: build_usage_graph_test_command(["second"]),
                fingerprint: 2
            }
        ]
        rejected: mutable bool = false
        catch build_usage_graph_plan(actions):
            ok plan:
                _ = plan
            error failure:
                rejected <- failure == BuildContractError.DependencyOrderInvalid
        assert rejected


@test
def build_usage_graph_rejects_relative_declared_outputs() -> void:
    can Memory.Allocate, Abort.Panic:
        actions: darray[BuildUsageActionSpec] = [
            BuildUsageActionSpec{
                name: "compile",
                command: build_usage_graph_test_command(["-c", "main.c"]),
                fingerprint: 1,
                outputs: ["relative.o"]
            }
        ]
        rejected: mutable bool = false
        catch build_usage_graph_plan(actions):
            ok plan:
                _ = plan
            error failure:
                rejected <- failure == BuildUsageGraphError.InvalidOutputPath
        assert rejected


@test
def build_usage_graph_rejects_noncanonical_declared_outputs() -> void:
    can Memory.Allocate, Abort.Panic:
        for invalid_path in ["/tmp/./artifact.o", "/tmp/obj/../artifact.o", "/tmp//artifact.o", "/tmp/build/", "/"]:
            actions: darray[BuildUsageActionSpec] = [
                BuildUsageActionSpec{
                    name: "compile",
                    command: build_usage_graph_test_command(["-c", "main.c"]),
                    fingerprint: 1,
                    outputs: [invalid_path]
                }
            ]
            rejected: mutable bool = false
            catch build_usage_graph_plan(actions):
                ok plan:
                    _ = plan
                error failure:
                    rejected <- failure == BuildUsageGraphError.InvalidOutputPath
            assert rejected


@test
