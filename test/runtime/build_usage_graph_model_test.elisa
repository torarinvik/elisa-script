@test
def build_usage_graph_rejects_forged_metadata_total() -> void:
    can Memory.Allocate, Abort.Panic:
        actions: darray[BuildUsageActionSpec] = [
            BuildUsageActionSpec{
                name: "compile",
                command: build_usage_graph_test_command(["-c", "main.c", "-o", "main.o"]),
                fingerprint: 1,
                outputs: ["/tmp/elisascript-main.o"]
            }
        ]
        plan: mutable BuildUsageGraphPlan = build_usage_graph_plan(actions)
        plan.metadata_bytes <- plan.metadata_bytes - 1
        rejected: mutable bool = false
        catch validate_build_usage_graph_plan(plan):
            ok valid:
                _ = valid
            error failure:
                rejected <- failure == BuildUsageGraphError.PlanOwnershipInvalid
        assert rejected
