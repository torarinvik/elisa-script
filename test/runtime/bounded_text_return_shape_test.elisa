# Bodies call only the reader's pure return-shape helpers, never libc.
# The full native-reader include still requires compiler/ABI qualification;
# this fixture is authored only and must not resume disabled validation.
include "../../src/runtime/bounded_text_posix.elisa"

extend EsBoundedText:
    public:
        @test
        def bounded_text_descriptor_return_admits_zero_and_c32_maximum() -> void:
            assert descriptor_shape(0) and descriptor_shape(1)
            assert descriptor_shape(41) and descriptor_shape(2147483647i64.int())
            can Memory.Allocate, Abort.Panic:
                for value in [-9223372036854775807i64 - 1i64, -2147483648i64, -2i64, -1i64, 2147483648i64, 4294967295i64, 9223372036854775807i64]:
                    assert not descriptor_shape(value.int())


        @test
        def bounded_text_errno_shape_excludes_stale_failure_and_unsigned_minus_one() -> void:
            assert errno_shape(-1i64)
            can Memory.Allocate, Abort.Panic:
                for value in [-9223372036854775807i64 - 1i64, -2147483648i64, -2i64, 0i64, 1i64, 2147483647i64, 4294967295i64, 9223372036854775807i64]:
                    assert not errno_shape(value)
