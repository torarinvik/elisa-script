include "../../src/runtime/record_numeric_model.elisa"

using EsRecordNumeric


@test
def record_numeric_accepts_trailing_decimal_point_forms() -> void:
    can Memory.Allocate, Abort.Panic:
        policy: RecordNumericPolicy = RecordNumericPolicy{kind: RecordNumericKind.Decimal, max_bytes: 16, max_digits: 8, max_exponent_digits: 4}
        trailing_point: mutable RecordNumericSession = RecordNumericSession{policy: policy}
        assert advance_record_numeric(trailing_point, RecordNumericEvent.Begin) == RecordNumericState.Parsing
        for byte in [49u8, 46u8] |trailing_point|:
            _ = advance_record_numeric(trailing_point, RecordNumericEvent.Byte, byte)
        assert advance_record_numeric(trailing_point, RecordNumericEvent.Finish) == RecordNumericState.Complete
        point_result: RecordNumericResult = record_numeric_result(trailing_point)
        assert point_result.coefficient_digits == 1 and point_result.fraction_digits == 0

        exponent: mutable RecordNumericSession = RecordNumericSession{policy: policy}
        assert advance_record_numeric(exponent, RecordNumericEvent.Begin) == RecordNumericState.Parsing
        for byte in [49u8, 46u8, 101u8, 50u8] |exponent|:
            _ = advance_record_numeric(exponent, RecordNumericEvent.Byte, byte)
        assert advance_record_numeric(exponent, RecordNumericEvent.Finish) == RecordNumericState.Complete
        exponent_result: RecordNumericResult = record_numeric_result(exponent)
        assert exponent_result.coefficient_digits == 1 and exponent_result.fraction_digits == 0
        assert exponent_result.exponent_magnitude == 2 and not exponent_result.exponent_negative

        forged_trailing_point_rejected: mutable bool = false
        catch validate_record_numeric_session(RecordNumericSession{policy: policy, state: RecordNumericState.Parsing, phase: RecordNumericPhase.Fraction, chars: 2, digits: 1, saw_digit: true, saw_dot: true}):
            ok value:
                assert false
            error failure:
                forged_trailing_point_rejected <- failure == RecordNumericError.AccountingInvalid
        assert forged_trailing_point_rejected
