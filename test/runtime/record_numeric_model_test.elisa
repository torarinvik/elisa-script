include "../../src/runtime/record_numeric_model.elisa"

using EsRecordNumeric


@test
def record_numeric_accepts_trailing_decimal_point_forms() -> void:
    can Memory.Allocate, Abort.Panic:
        policy: RecordNumericPolicy = RecordNumericPolicy{kind: RecordNumericKind.Decimal, max_bytes: 16, max_digits: 8, max_exponent_digits: 4}
        trailing_point: mutable RecordNumericSession = RecordNumericSession{policy: policy}
        assert advance_record_numeric(trailing_point, RecordNumericEvent.Begin) == RecordNumericState.Parsing
        for byte in [49u8, 46u8] |trailing_point|:
            _ = advance_record_numeric(trailing_point, RecordNumericEvent.Byte, byte)
        assert advance_record_numeric(trailing_point, RecordNumericEvent.Finish) == RecordNumericState.Complete
        point_result: RecordNumericResult = record_numeric_result(trailing_point)
        assert point_result.coefficient_digits == 1 and point_result.fraction_digits == 0

        exponent: mutable RecordNumericSession = RecordNumericSession{policy: policy}
        assert advance_record_numeric(exponent, RecordNumericEvent.Begin) == RecordNumericState.Parsing
        for byte in [49u8, 46u8, 101u8, 50u8] |exponent|:
            _ = advance_record_numeric(exponent, RecordNumericEvent.Byte, byte)
        assert advance_record_numeric(exponent, RecordNumericEvent.Finish) == RecordNumericState.Complete
        exponent_result: RecordNumericResult = record_numeric_result(exponent)
        assert exponent_result.coefficient_digits == 1 and exponent_result.fraction_digits == 0
        assert exponent_result.exponent_magnitude == 2 and not exponent_result.exponent_negative

        forged_trailing_point_rejected: mutable bool = false
        catch validate_record_numeric_session(RecordNumericSession{policy: policy, state: RecordNumericState.Parsing, phase: RecordNumericPhase.Fraction, chars: 2, digits: 1, saw_digit: true, saw_dot: true}):
            ok value:
                assert false
            error failure:
                forged_trailing_point_rejected <- failure == RecordNumericError.AccountingInvalid
        assert forged_trailing_point_rejected

        forged_exponent_phase_rejected: mutable bool = false
        catch validate_record_numeric_session(RecordNumericSession{policy: policy, state: RecordNumericState.Parsing, phase: RecordNumericPhase.ExponentDigits, chars: 2, digits: 1, saw_digit: true, saw_exponent: true, previous_digit: true}):
            ok value:
                assert false
            error failure:
                forged_exponent_phase_rejected <- failure == RecordNumericError.AccountingInvalid
        assert forged_exponent_phase_rejected


@test
def record_numeric_materializes_checked_integer_results() -> void:
    can Memory.Allocate, Abort.Panic:
        signed_minimum: RecordNumericResult = RecordNumericResult{kind: RecordNumericKind.Integer, negative: true, magnitude: 9223372036854775808u64, coefficient_digits: 19}
        assert record_numeric_result_i64(signed_minimum) == 0i64 - 9223372036854775807i64 - 1i64
        signed_maximum: RecordNumericResult = RecordNumericResult{kind: RecordNumericKind.Integer, magnitude: 9223372036854775807u64, coefficient_digits: 19}
        assert record_numeric_result_i64(signed_maximum) == 9223372036854775807i64
        unsigned_maximum: RecordNumericResult = RecordNumericResult{kind: RecordNumericKind.Unsigned, magnitude: 18446744073709551615u64, coefficient_digits: 20}
        assert record_numeric_result_u64(unsigned_maximum) == 18446744073709551615u64

        signed_overflow_rejected: mutable bool = false
        catch record_numeric_result_i64(RecordNumericResult{kind: RecordNumericKind.Integer, magnitude: 9223372036854775808u64, coefficient_digits: 19}):
            ok value:
                assert false
            error failure:
                signed_overflow_rejected <- failure == RecordNumericError.IntegerOverflow
        assert signed_overflow_rejected

        forged_unsigned_rejected: mutable bool = false
        catch record_numeric_result_u64(RecordNumericResult{kind: RecordNumericKind.Unsigned, negative: true, magnitude: 1u64, coefficient_digits: 1}):
            ok value:
                assert false
            error failure:
                forged_unsigned_rejected <- failure == RecordNumericError.AccountingInvalid
        assert forged_unsigned_rejected
