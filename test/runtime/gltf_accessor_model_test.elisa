include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../ports/elisa-engine/scripts/gltf_accessor_model.elisa"

using EsData
using EsJson
using EsEngineGltfAccessor


def gltf_accessor_rejects(source: sview, buffer: darray[u8], expected: AccessorError) -> bool can[Memory.Allocate, Abort.Panic]:
    document: JsonDocument = try parse_document(source) else failure:
        _ = failure
        return false
    rejected: mutable bool = false
    catch accessor_bytes(document, buffer, 0i64):
        ok bytes:
            _ = bytes
        error failure:
            rejected <- failure == expected
    return rejected


@test
def gltf_accessor_packs_interleaved_elements_and_preserves_contiguous_bytes() -> void can[Memory.Allocate, Abort.Panic]:
    interleaved: JsonDocument = try parse_document("{\"accessors\":[{\"bufferView\":0,\"byteOffset\":4,\"componentType\":5126,\"count\":2,\"type\":\"VEC2\"}],\"bufferViews\":[{\"byteOffset\":0,\"byteStride\":12}]}") else failure:
        _ = failure
        assert false
        JsonDocument{}
    source: darray[u8] = [0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8]
    packed: darray[u8] = accessor_bytes(interleaved, source, 0i64)
    assert packed == [4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8]

    contiguous: JsonDocument = try parse_document("{\"accessors\":[{\"bufferView\":0,\"componentType\":5121,\"count\":3,\"type\":\"SCALAR\"}],\"bufferViews\":[{}]}") else failure:
        _ = failure
        assert false
        JsonDocument{}
    assert accessor_bytes(contiguous, source, 0i64) == [0u8, 1u8, 2u8]


@test
def gltf_accessor_rejects_invalid_indexes_counts_components_and_ranges() -> void can[Memory.Allocate, Abort.Panic]:
    assert gltf_accessor_rejects("{\"accessors\":[{\"bufferView\":3,\"componentType\":5126,\"count\":1,\"type\":\"VEC3\"}],\"bufferViews\":[{}]}", [0u8, 1u8, 2u8], AccessorError.BufferViewIndexOutOfRange)
    assert gltf_accessor_rejects("{\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":-1,\"type\":\"VEC3\"}],\"bufferViews\":[{}]}", [], AccessorError.NegativeAccessorCount)
    assert gltf_accessor_rejects("{\"accessors\":[{\"bufferView\":0,\"componentType\":9999,\"count\":1,\"type\":\"VEC3\"}],\"bufferViews\":[{}]}", [], AccessorError.UnsupportedComponentType)
    assert gltf_accessor_rejects("{\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":2,\"type\":\"VEC3\"}],\"bufferViews\":[{}]}", [0u8, 1u8, 2u8], AccessorError.AccessorRangeExceedsBuffer)


@test
def gltf_float_stream_checks_shape_count_and_finiteness() -> void can[Memory.Allocate, Abort.Panic]:
    document: JsonDocument = try parse_document("{\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":2,\"type\":\"VEC2\"}],\"bufferViews\":[{}]}") else failure:
        _ = failure
        assert false
        JsonDocument{}
    valid_buffer: darray[u8] = [0u8, 0u8, 128u8, 63u8, 0u8, 0u8, 0u8, 64u8]
    values: darray[u8] = float_stream(document, valid_buffer, 0i64, "VEC2", true, 2i64)
    assert values == [0u8, 0u8, 128u8, 63u8, 0u8, 0u8, 0u8, 64u8]
    assert gltf_float_stream_rejects(document, [0u8, 0u8, 128u8, 63u8, 0u8, 0u8, 0u8, 64u8], "VEC3", false, 0i64, AccessorError.FloatStreamTypeMismatch)
    assert gltf_float_stream_rejects(document, valid_buffer, "VEC2", true, 1i64, AccessorError.FloatStreamCountMismatch)
    assert gltf_float_stream_rejects(document, [0u8, 0u8, 128u8, 127u8, 0u8, 0u8, 0u8, 64u8], "VEC2", true, 2i64, AccessorError.NonFiniteFloatStream)


def gltf_float_stream_rejects(document: JsonDocument&, buffer: darray[u8], type_name: sview, has_count: bool, count: i64, expected: AccessorError) -> bool can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch float_stream(document, buffer, 0i64, type_name, has_count, count):
        ok value:
            _ = value
        error failure:
            rejected <- failure == expected
    return rejected
