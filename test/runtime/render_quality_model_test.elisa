include "../../ports/elisa-engine/scripts/render_quality_model.elisa"

using EsEngineRenderQuality


def render_quality_test_uniform_frame(width: usize, height: usize, format: RenderPixelFormat, value: u8) -> RenderFrame can[Memory.Allocate, Abort.Panic]:
    pixels: mutable darray[u8] = []
    channels: usize = 3 if format == RenderPixelFormat.Rgb8 else 4
    for _ in 0..<(width * height) |channels, value, pixels|:
        pixels.push(value)
        pixels.push(value)
        pixels.push(value)
        if format == RenderPixelFormat.Rgba8:
            pixels.push(0u8)
    return RenderFrame{width: width, height: height, format: format, pixels: pixels}


def render_quality_test_split_frame(format: RenderPixelFormat) -> RenderFrame can[Memory.Allocate, Abort.Panic]:
    width: usize = 16
    height: usize = 8
    channels: usize = 3 if format == RenderPixelFormat.Rgb8 else 4
    pixels: mutable darray[u8] = []
    for y in 0..<height |width, channels, pixels|:
        for x in 0..<width |y, channels, pixels|:
            value: u8 = 255u8 if x >= 8 else 0u8
            pixels.push(value)
            pixels.push(value)
            pixels.push(value)
            if format == RenderPixelFormat.Rgba8:
                pixels.push(17u8)
    return RenderFrame{width: width, height: height, format: format, pixels: pixels}


def render_quality_test_occlusion(occluded: u8, strength_zero: u8, format: RenderPixelFormat) -> OcclusionStrengthMetrics can[Memory.Allocate, Abort.Panic]:
    dark: RenderFrame = render_quality_test_uniform_frame(16, 8, format, occluded)
    light: RenderFrame = render_quality_test_uniform_frame(16, 8, format, strength_zero)
    result: mutable OcclusionStrengthMetrics = OcclusionStrengthMetrics{}
    catch occlusion_strength_metrics(dark, light):
        ok metrics:
            result <- metrics
        error failure:
            _ = failure
            assert false
    return result


def render_quality_test_rejects_patch(frame: RenderFrame&, x_permille: usize, y_permille: usize, expected: RenderQualityError) -> bool can[Abort.Panic]:
    rejected: mutable bool = false
    catch patch_luminance(frame, x_permille, y_permille):
        ok luminance:
            _ = luminance
        error failure:
            rejected <- failure == expected
    return rejected


@test
def mirrored_normal_metrics_use_rgb_luminance_and_ignore_rgba_alpha() -> void can[Memory.Allocate, Abort.Panic]:
    rgb: RenderFrame = render_quality_test_split_frame(RenderPixelFormat.Rgb8)
    rgba: RenderFrame = render_quality_test_split_frame(RenderPixelFormat.Rgba8)
    rgb_metrics: mutable MirroredNormalMetrics = MirroredNormalMetrics{}
    rgba_metrics: mutable MirroredNormalMetrics = MirroredNormalMetrics{}
    catch mirrored_normal_metrics(rgb):
        ok metrics:
            rgb_metrics <- metrics
        error failure:
            _ = failure
            assert false
    catch mirrored_normal_metrics(rgba):
        ok metrics:
            rgba_metrics <- metrics
        error failure:
            _ = failure
            assert false
    assert fabs(rgb_metrics.left_luminance - 0.0) < 0.0000001
    assert fabs(rgb_metrics.right_luminance - 0.8) < 0.0000001
    assert fabs(rgb_metrics.contrast - rgba_metrics.contrast) < 0.0000001
    assert rgb_metrics.passes and rgba_metrics.passes


@test
def occlusion_strength_metrics_apply_the_python_threshold_in_both_directions() -> void can[Memory.Allocate, Abort.Panic]:
    sufficient: OcclusionStrengthMetrics = render_quality_test_occlusion(100u8, 105u8, RenderPixelFormat.Rgba8)
    insufficient: OcclusionStrengthMetrics = render_quality_test_occlusion(100u8, 102u8, RenderPixelFormat.Rgb8)
    assert sufficient.passes
    assert fabs(sufficient.darkening - 5.0 / 255.0) < 0.0000001
    assert not insufficient.passes


@test
def occlusion_strength_rejects_incompatible_capture_shapes() -> void can[Memory.Allocate, Abort.Panic]:
    rgb: RenderFrame = render_quality_test_uniform_frame(16, 8, RenderPixelFormat.Rgb8, 100u8)
    different_size: RenderFrame = render_quality_test_uniform_frame(16, 9, RenderPixelFormat.Rgb8, 105u8)
    rejected: mutable bool = false
    catch occlusion_strength_metrics(rgb, different_size):
        ok metrics:
            _ = metrics
        error failure:
            rejected <- failure == RenderQualityError.IncompatibleFrames
    assert rejected


@test
def render_quality_rejects_invalid_pixel_storage_and_coordinates() -> void can[Memory.Allocate, Abort.Panic]:
    malformed: RenderFrame = RenderFrame{width: 16, height: 8, format: RenderPixelFormat.Rgb8, pixels: []}
    assert render_quality_test_rejects_patch(malformed, 350, 500, RenderQualityError.InvalidFrame)
    valid: RenderFrame = render_quality_test_uniform_frame(16, 8, RenderPixelFormat.Rgb8, 100u8)
    assert render_quality_test_rejects_patch(valid, 1001, 500, RenderQualityError.CoordinateOutOfRange)
