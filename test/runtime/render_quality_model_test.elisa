include "../../ports/elisa-engine/scripts/render_quality_model.elisa"
include "../../ports/elisa-engine/scripts/render_quality_cli.elisa"

using EsEngineRenderQuality
using EsEngineRenderQualityCli


def render_quality_test_uniform_frame(width: usize, height: usize, format: RenderPixelFormat, value: u8) -> RenderFrame can[Memory.Allocate, Abort.Panic]:
    pixels: mutable darray[u8] = []
    channels: usize = 3 if format == RenderPixelFormat.Rgb8 else 4
    for _ in 0..<(width * height) |channels, value, pixels|:
        pixels.push(value)
        pixels.push(value)
        pixels.push(value)
        if format == RenderPixelFormat.Rgba8:
            pixels.push(0u8)
    return RenderFrame{width: width, height: height, format: format, pixels: pixels}


def render_quality_test_split_frame(format: RenderPixelFormat) -> RenderFrame can[Memory.Allocate, Abort.Panic]:
    width: usize = 16
    height: usize = 8
    channels: usize = 3 if format == RenderPixelFormat.Rgb8 else 4
    pixels: mutable darray[u8] = []
    for y in 0..<height |width, channels, pixels|:
        for x in 0..<width |y, channels, pixels|:
            value: u8 = 255u8 if x >= 8 else 0u8
            pixels.push(value)
            pixels.push(value)
            pixels.push(value)
            if format == RenderPixelFormat.Rgba8:
                pixels.push(17u8)
    return RenderFrame{width: width, height: height, format: format, pixels: pixels}


def render_quality_test_occlusion(occluded: u8, strength_zero: u8, format: RenderPixelFormat) -> OcclusionStrengthMetrics can[Memory.Allocate, Abort.Panic]:
    dark: RenderFrame = render_quality_test_uniform_frame(16, 8, format, occluded)
    light: RenderFrame = render_quality_test_uniform_frame(16, 8, format, strength_zero)
    result: mutable OcclusionStrengthMetrics = OcclusionStrengthMetrics{}
    catch occlusion_strength_metrics(dark, light):
        ok metrics:
            result <- metrics
        error failure:
            _ = failure
            assert false
    return result


def render_quality_test_rejects_patch(frame: RenderFrame&, x_permille: usize, y_permille: usize, expected: RenderQualityError) -> bool can[Abort.Panic]:
    rejected: mutable bool = false
    catch patch_luminance(frame, x_permille, y_permille):
        ok luminance:
            _ = luminance
        error failure:
            rejected <- failure == expected
    return rejected


def render_quality_test_scanlines_reject(source: darray[u8], expected: PngScanlineError) -> bool can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch reconstruct_png_scanlines(3, 1, RenderPixelFormat.Rgb8, source):
        ok frame:
            _ = frame
        error failure:
            rejected <- failure == expected
    return rejected


def render_quality_test_pixels_equal(frame: RenderFrame&, expected: darray[u8]&) -> bool:
    return false if frame.pixels.count != expected.count
    for index in 0..<expected.count |frame, expected|:
        return false if frame.pixels[index] != expected[index]
    return true


def render_quality_test_append_png_chunk(png: mutable darray[u8]&, first: u8, second: u8, third: u8, fourth: u8, payload: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    length: u32 = payload.count.u32()
    png.push((length >> 24).u8())
    png.push((length >> 16).u8())
    png.push((length >> 8).u8())
    png.push(length.u8())
    png.push(first)
    png.push(second)
    png.push(third)
    png.push(fourth)
    for byte in payload |png|:
        png.push(byte)
    png.push(0u8)
    png.push(0u8)
    png.push(0u8)
    png.push(0u8)


def render_quality_test_minimal_png() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    png: mutable darray[u8] = [137u8, 80u8, 78u8, 71u8, 13u8, 10u8, 26u8, 10u8]
    header: darray[u8] = [0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 8u8, 2u8, 0u8, 0u8, 0u8]
    ancillary: darray[u8] = [97u8, 61u8, 98u8]
    first_image_data: darray[u8] = [120u8, 1u8, 1u8, 4u8, 0u8, 251u8]
    second_image_data: darray[u8] = [255u8, 0u8, 12u8, 34u8, 56u8, 0u8, 164u8, 0u8, 103u8]
    empty: darray[u8] = []
    render_quality_test_append_png_chunk(png, 73u8, 72u8, 68u8, 82u8, header)
    render_quality_test_append_png_chunk(png, 116u8, 69u8, 88u8, 116u8, ancillary)
    render_quality_test_append_png_chunk(png, 73u8, 68u8, 65u8, 84u8, first_image_data)
    render_quality_test_append_png_chunk(png, 73u8, 68u8, 65u8, 84u8, second_image_data)
    render_quality_test_append_png_chunk(png, 73u8, 69u8, 78u8, 68u8, empty)
    return png


def render_quality_test_png_error(data: darray[u8]&, expected: PngReadError) -> bool can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch decode_png(data):
        ok frame:
            _ = frame
        error failure:
            rejected <- failure == expected
    return rejected


@test
def mirrored_normal_metrics_use_rgb_luminance_and_ignore_rgba_alpha() -> void can[Memory.Allocate, Abort.Panic]:
    rgb: RenderFrame = render_quality_test_split_frame(RenderPixelFormat.Rgb8)
    rgba: RenderFrame = render_quality_test_split_frame(RenderPixelFormat.Rgba8)
    rgb_metrics: mutable MirroredNormalMetrics = MirroredNormalMetrics{}
    rgba_metrics: mutable MirroredNormalMetrics = MirroredNormalMetrics{}
    catch mirrored_normal_metrics(rgb):
        ok metrics:
            rgb_metrics <- metrics
        error failure:
            _ = failure
            assert false
    catch mirrored_normal_metrics(rgba):
        ok metrics:
            rgba_metrics <- metrics
        error failure:
            _ = failure
            assert false
    assert fabs(rgb_metrics.left_luminance - 0.0) < 0.0000001
    assert fabs(rgb_metrics.right_luminance - 0.8) < 0.0000001
    assert fabs(rgb_metrics.contrast - rgba_metrics.contrast) < 0.0000001
    assert rgb_metrics.passes and rgba_metrics.passes


@test
def render_quality_cli_formats_python_style_fixed_decimal_output() -> void can[Memory.Allocate, Console.Format, Abort.Panic]:
    assert fixed_four_decimal(0.25) == "0.2500"
    assert fixed_four_decimal(0.8) == "0.8000"
    assert fixed_four_decimal(-0.00001) == "-0.0000"


@test
def occlusion_strength_metrics_apply_the_python_threshold_in_both_directions() -> void can[Memory.Allocate, Abort.Panic]:
    sufficient: OcclusionStrengthMetrics = render_quality_test_occlusion(100u8, 105u8, RenderPixelFormat.Rgba8)
    insufficient: OcclusionStrengthMetrics = render_quality_test_occlusion(100u8, 102u8, RenderPixelFormat.Rgb8)
    assert sufficient.passes
    assert fabs(sufficient.darkening - 5.0 / 255.0) < 0.0000001
    assert not insufficient.passes


@test
def occlusion_strength_rejects_incompatible_capture_shapes() -> void can[Memory.Allocate, Abort.Panic]:
    rgb: RenderFrame = render_quality_test_uniform_frame(16, 8, RenderPixelFormat.Rgb8, 100u8)
    different_size: RenderFrame = render_quality_test_uniform_frame(16, 9, RenderPixelFormat.Rgb8, 105u8)
    rejected: mutable bool = false
    catch occlusion_strength_metrics(rgb, different_size):
        ok metrics:
            _ = metrics
        error failure:
            rejected <- failure == RenderQualityError.IncompatibleFrames
    assert rejected


@test
def render_quality_rejects_invalid_pixel_storage_and_coordinates() -> void can[Memory.Allocate, Abort.Panic]:
    malformed: RenderFrame = RenderFrame{width: 16, height: 8, format: RenderPixelFormat.Rgb8, pixels: []}
    assert render_quality_test_rejects_patch(malformed, 350, 500, RenderQualityError.InvalidFrame)
    valid: RenderFrame = render_quality_test_uniform_frame(16, 8, RenderPixelFormat.Rgb8, 100u8)
    assert render_quality_test_rejects_patch(valid, 1001, 500, RenderQualityError.CoordinateOutOfRange)


@test
def png_scanline_reconstruction_matches_all_five_filters() -> void can[Memory.Allocate, Abort.Panic]:
    filtered: darray[u8] = [
        0u8, 10u8, 20u8, 30u8, 40u8, 50u8, 60u8, 70u8, 80u8, 90u8,
        1u8, 11u8, 22u8, 33u8, 39u8, 48u8, 57u8, 50u8, 50u8, 50u8,
        2u8, 4u8, 5u8, 6u8, 11u8, 12u8, 13u8, 1u8, 2u8, 3u8,
        3u8, 3u8, 7u8, 11u8, 19u8, 23u8, 28u8, 25u8, 25u8, 26u8
    ]
    expected: darray[u8] = [
        10u8, 20u8, 30u8, 40u8, 50u8, 60u8, 70u8, 80u8, 90u8,
        11u8, 22u8, 33u8, 50u8, 70u8, 90u8, 100u8, 120u8, 140u8,
        15u8, 27u8, 39u8, 61u8, 82u8, 103u8, 101u8, 122u8, 143u8,
        10u8, 20u8, 30u8, 54u8, 74u8, 94u8, 102u8, 123u8, 144u8
    ]
    frame: RenderFrame = reconstruct_png_scanlines(3, 4, RenderPixelFormat.Rgb8, filtered)
    assert render_quality_test_pixels_equal(frame, expected)


@test
def png_container_reader_joins_idat_and_skips_ancillary_chunks() -> void can[Memory.Allocate, Abort.Panic]:
    png: darray[u8] = render_quality_test_minimal_png()
    expected: darray[u8] = [12u8, 34u8, 56u8]
    catch decode_png(png):
        ok frame:
            assert frame.width == 1 and frame.height == 1
            assert frame.format == RenderPixelFormat.Rgb8
            assert render_quality_test_pixels_equal(frame, expected)
        error failure:
            _ = failure
            assert false


@test
def png_container_reader_rejects_bad_signatures_and_truncated_chunks() -> void can[Memory.Allocate, Abort.Panic]:
    bad_signature: darray[u8] = [0u8]
    truncated_chunk: darray[u8] = [137u8, 80u8, 78u8, 71u8, 13u8, 10u8, 26u8, 10u8, 0u8, 0u8, 0u8, 1u8]
    assert render_quality_test_png_error(bad_signature, PngReadError.InvalidSignature)
    assert render_quality_test_png_error(truncated_chunk, PngReadError.InvalidChunk)


@test
def png_scanline_paeth_reconstruction_uses_left_up_and_upper_left_predictors() -> void can[Memory.Allocate, Abort.Panic]:
    filtered: darray[u8] = [0u8, 50u8, 0u8, 100u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 4u8, 50u8, 0u8, 156u8, 20u8, 0u8, 0u8, 10u8, 0u8, 0u8]
    expected: darray[u8] = [50u8, 0u8, 100u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 100u8, 0u8, 0u8, 70u8, 0u8, 0u8, 80u8, 0u8, 0u8]
    frame: RenderFrame = reconstruct_png_scanlines(3, 2, RenderPixelFormat.Rgb8, filtered)
    assert render_quality_test_pixels_equal(frame, expected)


@test
def png_scanline_rgba_sub_filter_keeps_alpha_bytes_and_pixel_stride() -> void can[Memory.Allocate, Abort.Panic]:
    filtered: darray[u8] = [1u8, 10u8, 20u8, 30u8, 40u8, 1u8, 2u8, 3u8, 4u8]
    expected: darray[u8] = [10u8, 20u8, 30u8, 40u8, 11u8, 22u8, 33u8, 44u8]
    frame: RenderFrame = reconstruct_png_scanlines(2, 1, RenderPixelFormat.Rgba8, filtered)
    assert render_quality_test_pixels_equal(frame, expected)


@test
def png_scanline_reconstruction_rejects_unknown_filters_and_wrong_lengths() -> void can[Memory.Allocate, Abort.Panic]:
    assert render_quality_test_scanlines_reject([5u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8], PngScanlineError.UnknownFilter)
    assert render_quality_test_scanlines_reject([0u8, 0u8], PngScanlineError.FilteredLengthMismatch)
