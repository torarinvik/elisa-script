include "../../ports/elisa-engine/scripts/gltf_material_bindings_model.elisa"
include "../../ports/elisa-engine/scripts/gltf_accessor_model.elisa"
include "../../src/runtime/json_model.elisa"

using EsEngineGltfAccessor
using EsEngineGltfMaterialBindings
using EsJson


def gltf_material_binding_rejects(source: sview, expected: MaterialBindingError) bool can[Memory.Allocate, Abort.Panic]:
    document: JsonDocument = try parse_document(source) else failure:
        _ = failure
        return false
    rejected: mutable bool = false
    catch document_material_bindings(document):
        ok plan:
            _ = plan
        error failure:
            rejected <- failure == expected
    return rejected


@test
def gltf_material_bindings_preserve_slot_ordinals_and_default_slot() -> void can[Memory.Allocate, Abort.Panic]:
    document: JsonDocument = try parse_document("{\"materials\":[{},{}],\"meshes\":[{\"primitives\":[{\"material\":1},{\"material\":0}]}]}") else failure:
        _ = failure
        assert false
        JsonDocument{}
    plan: MaterialBindingPlan = document_material_bindings(document)
    assert plan.slot_count == 2 and plan.material_indices_by_mesh.count == 1
    assert plan.material_indices_by_mesh[0] == [1u, 0u]

    no_materials: JsonDocument = try parse_document("{\"meshes\":[{\"primitives\":[{}, {\"material\":null}]}]}") else failure:
        _ = failure
        assert false
        JsonDocument{}
    defaults: MaterialBindingPlan = document_material_bindings(no_materials)
    assert defaults.slot_count == 1 and defaults.material_indices_by_mesh[0] == [0u, 0u]

    duplicate_key: JsonDocument = try parse_document("{\"materials\":[{},{}],\"meshes\":[{\"primitives\":[{\"material\":0,\"material\":1}]}]}") else failure:
        _ = failure
        assert false
        JsonDocument{}
    assert document_material_bindings(duplicate_key).material_indices_by_mesh[0] == [1u]


@test
def gltf_material_bindings_reject_missing_and_non_integer_references() -> void can[Memory.Allocate, Abort.Panic]:
    assert gltf_material_binding_rejects("{\"materials\":[{}],\"meshes\":[{\"primitives\":[{}]}]}", MaterialBindingError.MaterialBindingMissing)
    assert gltf_material_binding_rejects("{\"materials\":[{}],\"meshes\":[{\"primitives\":[{\"material\":null}]}]}", MaterialBindingError.MaterialBindingInvalid)
    assert gltf_material_binding_rejects("{\"materials\":[{},{}],\"meshes\":[{\"primitives\":[{\"material\":1.0}]}]}", MaterialBindingError.MaterialBindingInvalid)
    assert gltf_material_binding_rejects("{\"materials\":[{}],\"meshes\":[{\"primitives\":[{\"material\":true}]}]}", MaterialBindingError.MaterialBindingInvalid)
    assert gltf_material_binding_rejects("{\"materials\":[{}],\"meshes\":[{\"primitives\":[{\"material\":1}]}]}", MaterialBindingError.MaterialBindingOutOfRange)
    assert gltf_material_binding_rejects("{\"meshes\":[{\"primitives\":[{\"material\":0}]}]}", MaterialBindingError.UnexpectedMaterialBinding)
    assert gltf_material_binding_rejects("{\"materials\":[null],\"meshes\":[{\"primitives\":[{}]}]}", MaterialBindingError.InvalidMaterial)
    assert gltf_material_binding_rejects("{}", MaterialBindingError.MissingMeshes)
