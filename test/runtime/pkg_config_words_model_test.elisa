include "../../src/ir/ir.elisa"

using EsPkgConfigWords


@test
def pkg_config_words_preserve_quoted_and_escaped_arguments() -> void:
    can Memory.Allocate, Abort.Panic:
        words: PkgConfigWords = pkg_config_parse_words("-I\"/opt/SDK with space/include\" -DNAME=\"A B\" -L/opt/lib -lfirst -lsecond\\ name")
        assert words.values.count == 5
        assert pkg_config_word_matches(words, 0, "-I/opt/SDK with space/include")
        assert pkg_config_word_matches(words, 1, "-DNAME=A B")
        assert pkg_config_word_matches(words, 2, "-L/opt/lib")
        assert pkg_config_word_matches(words, 3, "-lfirst")
        assert pkg_config_word_matches(words, 4, "-lsecond name")


@test
def pkg_config_words_keep_empty_quoted_words_and_inert_metacharacters() -> void:
    can Memory.Allocate, Abort.Panic:
        words: PkgConfigWords = pkg_config_parse_words("'' \"\" '$HOME;$(touch unsafe)'")
        assert words.values.count == 3
        assert pkg_config_word_matches(words, 0, "")
        assert pkg_config_word_matches(words, 1, "")
        assert pkg_config_word_matches(words, 2, "$HOME;$(touch unsafe)")


@test
def pkg_config_words_reject_malformed_and_oversized_output() -> void:
    can Memory.Allocate, Abort.Panic:
        malformed_quote: mutable bool = false
        catch pkg_config_parse_words("-I\"unterminated"):
            ok words:
                _ = words
            error failure:
                malformed_quote <- failure == PkgConfigWordsError.InvalidWordOutput
        assert malformed_quote

        trailing_escape: mutable bool = false
        catch pkg_config_parse_words("-I/path\\"):
            ok words:
                _ = words
            error failure:
                trailing_escape <- failure == PkgConfigWordsError.InvalidWordOutput
        assert trailing_escape

        oversized_bytes: mutable darray[u8] = []
        oversized_count: usize = Limits::OUTPUT_BYTES + 1
        for index in 0..<oversized_count |oversized_bytes|:
            _ = index
            oversized_bytes.push(32u8)
        oversized_output: mutable bool = false
        catch pkg_config_parse_words(bytes_view(oversized_bytes)):
            ok words:
                _ = words
            error failure:
                oversized_output <- failure == PkgConfigWordsError.OutputLimitExceeded
        assert oversized_output


@test
def pkg_config_flags_classify_compile_and_link_arguments_in_order() -> void:
    can Memory.Allocate, Abort.Panic:
        compile_words: PkgConfigWords = pkg_config_parse_words("-I\"/sdk/include dir\" -I \"/sdk/system include\" -D API_LEVEL=3 -fPIC -isystem /sysroot/include")
        compile_flags: PkgConfigFlagSet = pkg_config_classify_flags(compile_words, PkgConfigFlagStream.Compile)
        assert compile_flags.flags.count == 6
        assert compile_flags.flags[0].kind == PkgConfigFlagKind.IncludeDirectory
        assert pkg_config_flag_matches(compile_flags, 0, "/sdk/include dir")
        assert compile_flags.flags[1].kind == PkgConfigFlagKind.IncludeDirectory
        assert pkg_config_flag_matches(compile_flags, 1, "/sdk/system include")
        assert compile_flags.flags[2].kind == PkgConfigFlagKind.CompileDefinition
        assert pkg_config_flag_matches(compile_flags, 2, "API_LEVEL=3")
        assert compile_flags.flags[3].kind == PkgConfigFlagKind.CompileOption
        assert pkg_config_flag_matches(compile_flags, 3, "-fPIC")
        assert compile_flags.flags[4].kind == PkgConfigFlagKind.CompileOption
        assert pkg_config_flag_matches(compile_flags, 4, "-isystem")
        assert pkg_config_flag_matches(compile_flags, 5, "/sysroot/include")

        link_words: PkgConfigWords = pkg_config_parse_words("-L /opt/lib -l alpha -lbeta -Wl,--start-group /opt/lib/libgamma.a -Wl,--end-group")
        link_flags: PkgConfigFlagSet = pkg_config_classify_flags(link_words, PkgConfigFlagStream.Link)
        assert link_flags.flags.count == 6
        assert link_flags.flags[0].kind == PkgConfigFlagKind.LibraryDirectory
        assert pkg_config_flag_matches(link_flags, 0, "/opt/lib")
        assert link_flags.flags[1].kind == PkgConfigFlagKind.LibraryName
        assert pkg_config_flag_matches(link_flags, 1, "alpha")
        assert link_flags.flags[2].kind == PkgConfigFlagKind.LibraryName
        assert pkg_config_flag_matches(link_flags, 2, "beta")
        assert link_flags.flags[3].kind == PkgConfigFlagKind.LinkOption
        assert pkg_config_flag_matches(link_flags, 3, "-Wl,--start-group")
        assert link_flags.flags[4].kind == PkgConfigFlagKind.LibraryPath
        assert pkg_config_flag_matches(link_flags, 4, "/opt/lib/libgamma.a")
        assert pkg_config_flag_matches(link_flags, 5, "-Wl,--end-group")


@test
def pkg_config_flags_reject_missing_option_values() -> void:
    can Memory.Allocate, Abort.Panic:
        parsed: PkgConfigWords = pkg_config_parse_words("-I")
        missing_include: mutable bool = false
        catch pkg_config_classify_flags(parsed, PkgConfigFlagStream.Compile):
            ok flags:
                _ = flags
            error failure:
                missing_include <- failure == PkgConfigWordsError.InvalidFlagShape
        assert missing_include

        invalid_library: mutable bool = false
        invalid_library_words: PkgConfigWords = pkg_config_parse_words("-l../private/libx.a")
        catch pkg_config_classify_flags(invalid_library_words, PkgConfigFlagStream.Link):
            ok flags:
                _ = flags
            error failure:
                invalid_library <- failure == PkgConfigWordsError.InvalidLibraryName
        assert invalid_library
