include "../../src/runtime/record_model.elisa"
include "../../src/runtime/record_numeric_model.elisa"
include "../../src/runtime/record_sort_model.elisa"
include "../../src/runtime/record_sort_field_adapter_model.elisa"

using EsRecord
using EsRecordNumeric
using EsRecordSort
using EsRecordSortFields


@test
def text_integer_and_absent_record_fields_form_declared_sort_keys() -> void:
    can Memory.Allocate, Abort.Panic:
        record_policy: RecordStreamPolicy = RecordStreamPolicy{field_mode: RecordFieldMode.Whitespace}
        policy: RecordSortPolicy = RecordSortPolicy{
            record_policy: record_policy,
            keys: [
                RecordSortKeySpec{field_index: 0, kind: RecordSortKeyKind.Text},
                RecordSortKeySpec{field_index: 1, kind: RecordSortKeyKind.Integer, direction: RecordSortDirection.Descending}
            ]
        }
        numeric_policy: RecordNumericPolicy = RecordNumericPolicy{kind: RecordNumericKind.Integer, max_bytes: 16, max_digits: 16, max_exponent_digits: 2}
        record: mutable Record = Record{source: "fixture", raw: "alpha -12"}
        text_field: mutable RecordField = RecordField{index: 0, start_byte: 0, end_byte: 5, value: "alpha"}
        integer_field: mutable RecordField = RecordField{index: 1, start_byte: 6, end_byte: 9, value: "-12"}
        text_key: RecordSortKey = try record_sort_key_from_field(policy, 0, record, text_field, numeric_policy)
        integer_key: RecordSortKey = try record_sort_key_from_field(policy, 1, record, integer_field, numeric_policy)
        assert text_key.spec_index == 0 and text_key.kind == RecordSortKeyKind.Text and text_key.present and text_key.text == "alpha"
        assert integer_key.spec_index == 1 and integer_key.kind == RecordSortKeyKind.Integer and integer_key.present and integer_key.integer == -12

        empty_record: mutable Record = Record{source: "fixture", raw: "alpha"}
        absent_field: mutable RecordField = RecordField{index: 1, start_byte: 5, end_byte: 5, value: "", present: false}
        absent_key: RecordSortKey = try record_sort_key_from_field(policy, 1, empty_record, absent_field, numeric_policy)
        assert not absent_key.present and absent_key.text == "" and absent_key.integer == 0


@test
def malformed_numeric_sort_field_is_rejected_before_key_publication() -> void:
    can Memory.Allocate, Abort.Panic:
        policy: RecordSortPolicy = RecordSortPolicy{
            record_policy: RecordStreamPolicy{},
            keys: [RecordSortKeySpec{field_index: 0, kind: RecordSortKeyKind.Integer}]
        }
        numeric_policy: RecordNumericPolicy = RecordNumericPolicy{kind: RecordNumericKind.Integer, max_bytes: 16, max_digits: 16, max_exponent_digits: 2}
        record: mutable Record = Record{source: "fixture", raw: "12x"}
        field: mutable RecordField = RecordField{index: 0, start_byte: 0, end_byte: 3, value: "12x"}
        rejected: mutable bool = false
        catch record_sort_key_from_field(policy, 0, record, field, numeric_policy):
            ok value:
                assert false
            error failure:
                rejected <- failure == RecordNumericError.InvalidCharacter
        assert rejected
