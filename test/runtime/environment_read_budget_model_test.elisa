# Pure byte classification: no C pointer, host environment or process access.
include "../../src/runtime/environment_read_budget_model.elisa"

using EsEnvironmentReadBudget


@test
def environment_read_budget_admits_zero_and_exact_maximum() -> void:
    can Memory.Allocate, Abort.Panic:
        zero: usize = try admit_limit(0) else err:
            assert false
            return
        maximum: usize = try admit_limit(Limits::MAX_VALUE_BYTES) else err:
            assert false
            return
        assert zero == 0 and maximum == 67108863
        for value in [-1i64, 67108864i64, 9223372036854775807i64]:
            rejected: mutable bool = false
            catch admit_limit(value):
                ok _:
                    assert false
                error failure:
                    rejected <- failure == BudgetError.InvalidLimit
            assert rejected


@test
def environment_read_budget_never_treats_zero_as_unlimited() -> void:
    assert classify_byte(0u8, 0, 0) == ByteAction.Terminator
    assert classify_byte(120u8, 0, 0) == ByteAction.Exceeded
    assert classify_byte(0u8, 1, 0) == ByteAction.Exceeded


@test
def environment_read_budget_accepts_only_terminator_at_exact_boundary() -> void:
    assert classify_byte(120u8, 0, 3) == ByteAction.Payload
    assert classify_byte(255u8, 2, 3) == ByteAction.Payload
    assert classify_byte(0u8, 2, 3) == ByteAction.Terminator
    assert classify_byte(0u8, 3, 3) == ByteAction.Terminator
    assert classify_byte(120u8, 3, 3) == ByteAction.Exceeded
    assert classify_byte(0u8, 4, 3) == ByteAction.Exceeded
    # The Skia candidate's 1 MiB limit can be checked without large allocation.
    assert classify_byte(120u8, 1048575, 1048576) == ByteAction.Payload
    assert classify_byte(0u8, 1048576, 1048576) == ByteAction.Terminator
    assert classify_byte(120u8, 1048576, 1048576) == ByteAction.Exceeded
