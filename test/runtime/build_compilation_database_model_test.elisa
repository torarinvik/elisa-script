@test
def compilation_database_binds_clang_module_output_sidecars() -> void:
    can Memory.Allocate, Abort.Panic:
        explicit_source: sview = "/work space/src/explicit.cppm"
        default_source: sview = "/work space/src/default.cppm"
        actions: darray[BuildUsageActionSpec] = [
            BuildUsageActionSpec{
                name: "compile-module-with-explicit-bmi",
                command: compilation_database_test_command(["-c", explicit_source, "-o", "build/explicit.o", "-fmodule-output=build/explicit.pcm"]),
                fingerprint: 1u64,
                outputs: ["/work space/build/explicit.o", "/work space/build/explicit.pcm"]
            },
            BuildUsageActionSpec{
                name: "compile-module-with-default-bmi",
                command: compilation_database_test_command(["-c", default_source, "-o", "build/default.o", "-fmodule-output"]),
                fingerprint: 2u64,
                outputs: ["/work space/build/default.o", "/work space/build/default.pcm"]
            }
        ]
        plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(actions)
        encoded: darray[u8] = render_build_compilation_database(plan, [
            BuildCompilationSource{action_index: 0, source_file: explicit_source, output_file: "/work space/build/explicit.o"},
            BuildCompilationSource{action_index: 1, source_file: default_source, output_file: "/work space/build/default.o"}
        ])
        encoded_text: sview = bytes_view(encoded)
        assert encoded_text.contains("-fmodule-output=build/explicit.pcm")
        assert encoded_text.contains("-fmodule-output\"]")

        unowned_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-module-with-unowned-default-bmi",
            command: compilation_database_test_command(["-c", explicit_source, "-o", "/work space/explicit.o", "-fmodule-output"]),
            fingerprint: 3u64,
            outputs: ["/work space/explicit.o"]
        }]
        unowned_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(unowned_actions)
        unowned_rejected: mutable bool = false
        catch render_build_compilation_database(unowned_plan, [BuildCompilationSource{action_index: 0, source_file: explicit_source}]):
            ok unowned_encoded:
                _ = unowned_encoded
            error failure:
                unowned_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert unowned_rejected

        duplicate_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-module-with-duplicate-bmi-options",
            command: compilation_database_test_command(["-c", explicit_source, "-o", "/work space/explicit.o", "-fmodule-output", "-fmodule-output=/work space/explicit.pcm"]),
            fingerprint: 4u64,
            outputs: ["/work space/explicit.o", "/work space/explicit.pcm"]
        }]
        duplicate_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(duplicate_actions)
        duplicate_rejected: mutable bool = false
        catch render_build_compilation_database(duplicate_plan, [BuildCompilationSource{action_index: 0, source_file: explicit_source}]):
            ok duplicate_encoded:
                _ = duplicate_encoded
            error failure:
                duplicate_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert duplicate_rejected

        colliding_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-module-with-bmi-object-collision",
            command: compilation_database_test_command(["-c", explicit_source, "-o", "/work space/explicit.o", "-fmodule-output=/work space/explicit.o"]),
            fingerprint: 5u64,
            outputs: ["/work space/explicit.o"]
        }]
        colliding_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(colliding_actions)
        colliding_rejected: mutable bool = false
        catch render_build_compilation_database(colliding_plan, [BuildCompilationSource{action_index: 0, source_file: explicit_source}]):
            ok colliding_encoded:
