include "../../src/ir/ir.elisa"

using EsBuildUsageArgv
using EsBuildUsageGraph
using EsBuildCompilationDatabase
using EsJson
using EsJsonLex
using EsJsonParse
using EsProcess


def compilation_database_test_command(arguments: darray[sview], environment_mode: ProcessEnvironmentMode = ProcessEnvironmentMode.Inherit) -> BuildUsageProcessCommand error[BuildUsageArgvError, ProcessCommandError] can[Memory.Allocate, Abort.Panic]:
    argv: BuildUsageArgv = try build_usage_raw_argv(arguments)
    return try build_usage_process_command(
        "/usr/bin/clang",
        argv,
        "/work space",
        [],
        environment_mode,
        60000000u64,
        1048576
    )


def compilation_database_test_plan() -> BuildUsageGraphPlan error[BuildUsageGraphError, BuildUsageArgvError, ProcessCommandError, BuildExecutionError, BuildContractError] can[Memory.Allocate, Abort.Panic]:
    actions: darray[BuildUsageActionSpec] = [
        BuildUsageActionSpec{
            name: "compile-main",
            command: compilation_database_test_command(["-Iinclude path", "-DVALUE=\"quoted\"", "-DLINE=first\nsecond", "-c", "/work space/src/main.c", "-o", "/work space/main.o", "-MF", "/work space/main.d"]),
            fingerprint: 1u64,
            outputs: ["/work space/main.o", "/work space/main.d"]
        },
        BuildUsageActionSpec{
            name: "compile-empty-argument",
            command: compilation_database_test_command(["", "-c", "/work space/src/other.c"]),
            fingerprint: 2u64,
            outputs: ["/work space/other.o"]
        }
    ]
    return try build_usage_graph_plan(actions)


@test
def compilation_database_projects_owned_argv_as_stable_json() -> void:
    can Memory.Allocate, Abort.Panic:
        plan: mutable BuildUsageGraphPlan = compilation_database_test_plan()
        sources: darray[BuildCompilationSource] = [
            BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c", output_file: "/work space/main.o"},
            BuildCompilationSource{action_index: 1, source_file: "/work space/src/other.c"}
        ]
        encoded: darray[u8] = render_build_compilation_database(plan, sources)
        expected: sview = "[{\"directory\":\"/work space\",\"file\":\"/work space/src/main.c\",\"arguments\":[\"/usr/bin/clang\",\"-Iinclude path\",\"-DVALUE=\\\"quoted\\\"\",\"-DLINE=first\\nsecond\",\"-c\",\"/work space/src/main.c\",\"-o\",\"/work space/main.o\",\"-MF\",\"/work space/main.d\"],\"output\":\"/work space/main.o\"},{\"directory\":\"/work space\",\"file\":\"/work space/src/other.c\",\"arguments\":[\"/usr/bin/clang\",\"\",\"-c\",\"/work space/src/other.c\"]}]\n"
        assert bytes_view(encoded) == expected
        lexed: JsonLexedSource = lex_json(bytes_view(encoded))
        document: JsonDocument = parse_json_document(lexed)
        assert document.state == JsonDocumentState.Sealed
        assert document.roots.count == 1
        assert document.nodes[document.roots[0]].kind == JsonNodeKind.Array
        root: JsonNode = document.nodes[document.roots[0]]
        assert root.child_count == 2
        first_entry_index: usize = document.children[root.child_start].value_index
        first_entry: JsonNode = document.nodes[first_entry_index]
        assert first_entry.kind == JsonNodeKind.Object
        file_member_index: usize = json_object_member_index(document, first_entry_index, "file")
        assert bytes_view(copy_json_scalar(document, document.members[file_member_index].value_index)) == "/work space/src/main.c"
        argv_member_index: usize = json_object_member_index(document, first_entry_index, "arguments")
        argv_index: usize = document.members[argv_member_index].value_index
        argv_node: JsonNode = document.nodes[argv_index]
        assert argv_node.kind == JsonNodeKind.Array and argv_node.child_count == 10
        first_argument_index: usize = document.children[argv_node.child_start].value_index
        assert bytes_view(copy_json_scalar(document, first_argument_index)) == "/usr/bin/clang"
        output_member_index: usize = json_object_member_index(document, first_entry_index, "output")
        assert bytes_view(copy_json_scalar(document, document.members[output_member_index].value_index)) == "/work space/main.o"

        outputless_metadata: darray[u8] = render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c"}])
        assert bytes_view(outputless_metadata).contains("\"-o\",\"/work space/main.o\"")
        assert not bytes_view(outputless_metadata).contains("\"output\":")

        implicit_output_metadata: darray[u8] = render_build_compilation_database(plan, [BuildCompilationSource{action_index: 1, source_file: "/work space/src/other.c", output_file: "/work space/other.o"}])
        assert bytes_view(implicit_output_metadata).contains("\"output\":\"/work space/other.o\"")
        implicit_output_mismatch_rejected: mutable bool = false
        catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 1, source_file: "/work space/src/other.c", output_file: "/work space/src/other.o"}]):
            ok encoded:
                _ = encoded
            error failure:
                implicit_output_mismatch_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert implicit_output_mismatch_rejected


@test
def compilation_database_escapes_control_and_unicode_bytes_without_shell_joining() -> void:
    can Memory.Allocate, Abort.Panic:
        source_text: sview = "/work space/src/\"café\".c"
        output_text: sview = "/work space/main.o"
        actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-unicode-source",
            command: compilation_database_test_command(["-Iinclude path", "-DVALUE=\"quoted\"", "-DLINE=first\nsecond", "-c", source_text, "-o", output_text]),
            fingerprint: 1u64,
            outputs: [output_text]
        }]
        plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(actions)
        sources: darray[BuildCompilationSource] = [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: output_text}]
        encoded: darray[u8] = render_build_compilation_database(plan, sources)
        encoded_text: sview = bytes_view(encoded)
        assert encoded_text.contains("café")
        assert encoded_text.contains("\\\"café\\\".c")
        assert encoded_text.contains("-Iinclude path")
        assert encoded_text.contains("-DVALUE=\\\"quoted\\\"")
        assert encoded_text.contains("-DLINE=first\\nsecond")


@test
def compilation_database_rejects_duplicate_actions_and_bounds_output() -> void:
    can Memory.Allocate, Abort.Panic:
        plan: mutable BuildUsageGraphPlan = compilation_database_test_plan()
        duplicate_sources: darray[BuildCompilationSource] = [
            BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c"},
            BuildCompilationSource{action_index: 0, source_file: "/work space/src/other.c"}
        ]
        duplicate_rejected: mutable bool = false
        catch render_build_compilation_database(plan, duplicate_sources):
            ok encoded:
                _ = encoded
            error failure:
                duplicate_rejected <- failure == BuildCompilationDatabaseError.DuplicateAction
        assert duplicate_rejected

        unordered_rejected: mutable bool = false
        catch render_build_compilation_database(plan, [
            BuildCompilationSource{action_index: 1, source_file: "/work space/src/other.c"},
            BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c"}
        ]):
            ok encoded:
                _ = encoded
            error failure:
                unordered_rejected <- failure == BuildCompilationDatabaseError.ActionOrderInvalid
        assert unordered_rejected

        tiny_limit_rejected: mutable bool = false
        catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c"}], 16):
            ok encoded:
                _ = encoded
            error failure:
                tiny_limit_rejected <- failure == BuildCompilationDatabaseError.OutputLimitExceeded
        assert tiny_limit_rejected

        undeclared_output_rejected: mutable bool = false
        catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c", output_file: "/work space/other.o"}]):
            ok encoded:
                _ = encoded
            error failure:
                undeclared_output_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert undeclared_output_rejected

        invalid_path_bytes: mutable darray[u8] = [47u8, 119u8, 111u8, 114u8, 107u8, 47u8, 255u8]
        invalid_utf8_rejected: mutable bool = false
        catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: bytes_view(invalid_path_bytes)}]):
            ok encoded:
                _ = encoded
            error failure:
                invalid_utf8_rejected <- failure == BuildCompilationDatabaseError.InvalidUtf8
        assert invalid_utf8_rejected


@test
def compilation_database_requires_source_compile_and_output_to_match_action_argv() -> void:
    can Memory.Allocate, Abort.Panic:
        plan: mutable BuildUsageGraphPlan = compilation_database_test_plan()
        source_mismatch_rejected: mutable bool = false
        catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: "/work space/src/other.c"}]):
            ok encoded:
                _ = encoded
            error failure:
                source_mismatch_rejected <- failure == BuildCompilationDatabaseError.InvalidSourceFile
        assert source_mismatch_rejected

        non_compile_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "source-without-compile-mode",
            command: compilation_database_test_command(["/work space/src/main.c"]),
            fingerprint: 1u64,
            outputs: ["/work space/main.o"]
        }]
        non_compile_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(non_compile_actions)
        non_compile_rejected: mutable bool = false
        catch render_build_compilation_database(non_compile_plan, [BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c"}]):
            ok encoded:
                _ = encoded
            error failure:
                non_compile_rejected <- failure == BuildCompilationDatabaseError.InvalidCompileAction
        assert non_compile_rejected

        depfile_mapped_as_object_rejected: mutable bool = false
        catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c", output_file: "/work space/main.d"}]):
            ok encoded:
                _ = encoded
            error failure:
                depfile_mapped_as_object_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert depfile_mapped_as_object_rejected


@test
def compilation_database_requires_graph_ownership_of_implicit_object_output() -> void:
    can Memory.Allocate, Abort.Panic:
        source_text: sview = "/work space/src/main.c"
        actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-unowned-default-object",
            command: compilation_database_test_command(["-c", source_text]),
            fingerprint: 1u64
        }]
        plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(actions)
        rejected: mutable bool = false
        catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok encoded:
                _ = encoded
            error failure:
                rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert rejected


@test
def compilation_database_models_clang_bitcode_and_rejects_non_object_modes() -> void:
    can Memory.Allocate, Abort.Panic:
        source_text: sview = "/work space/src/module.c"
        bitcode_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-to-implicit-bitcode",
            command: compilation_database_test_command(["-emit-llvm", "-c", source_text]),
            fingerprint: 1u64,
            outputs: ["/work space/module.bc"]
        }]
        bitcode_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(bitcode_actions)
        bitcode_database: darray[u8] = render_build_compilation_database(bitcode_plan, [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: "/work space/module.bc"}])
        assert bytes_view(bitcode_database).contains("\"output\":\"/work space/module.bc\"")

        wrong_bitcode_metadata_rejected: mutable bool = false
        catch render_build_compilation_database(bitcode_plan, [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: "/work space/module.o"}]):
            ok encoded:
                _ = encoded
            error failure:
                wrong_bitcode_metadata_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert wrong_bitcode_metadata_rejected

        syntax_only_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-syntax-only-mode",
            command: compilation_database_test_command(["-c", source_text, "-fsyntax-only"]),
            fingerprint: 2u64,
            outputs: ["/work space/module.o"]
        }]
        syntax_only_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(syntax_only_actions)
        syntax_only_rejected: mutable bool = false
        catch render_build_compilation_database(syntax_only_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok encoded:
                _ = encoded
            error failure:
                syntax_only_rejected <- failure == BuildCompilationDatabaseError.InvalidCompileAction
        assert syntax_only_rejected

        assembly_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-assembly-stage-mode",
            command: compilation_database_test_command(["-c", source_text, "-S"]),
            fingerprint: 3u64,
            outputs: ["/work space/module.o"]
        }]
        assembly_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(assembly_actions)
        assembly_rejected: mutable bool = false
        catch render_build_compilation_database(assembly_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok encoded:
                _ = encoded
            error failure:
                assembly_rejected <- failure == BuildCompilationDatabaseError.InvalidCompileAction
        assert assembly_rejected

        dependency_only_modes: darray[sview] = ["-M", "-MM", "--dependencies", "--user-dependencies"]
        for mode in dependency_only_modes:
            dependency_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
                name: "compile-with-dependency-only-mode",
                command: compilation_database_test_command([mode, "-c", source_text]),
                fingerprint: 4u64,
                outputs: ["/work space/module.o"]
            }]
            dependency_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(dependency_actions)
            dependency_only_rejected: mutable bool = false
            catch render_build_compilation_database(dependency_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
                ok encoded:
                    _ = encoded
                error failure:
                    dependency_only_rejected <- failure == BuildCompilationDatabaseError.InvalidCompileAction
            assert dependency_only_rejected


@test
def compilation_database_requires_owned_explicit_output_for_precompiled_headers() -> void:
    can Memory.Allocate, Abort.Panic:
        source_text: sview = "/work space/include/common.h"
        implicit_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-header-with-implicit-output",
            command: compilation_database_test_command(["-x", "c-header", "-c", source_text]),
            fingerprint: 1u64,
            outputs: ["/work space/common.h.gch"]
        }]
        implicit_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(implicit_actions)
        implicit_header_rejected: mutable bool = false
        catch render_build_compilation_database(implicit_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok encoded:
                _ = encoded
            error failure:
                implicit_header_rejected <- failure == BuildCompilationDatabaseError.InvalidCompileAction
        assert implicit_header_rejected

        explicit_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-header-with-explicit-output",
            command: compilation_database_test_command(["-xc++-header", "-c", source_text, "-o", "/work space/common.pch"]),
            fingerprint: 2u64,
            outputs: ["/work space/common.pch"]
        }]
        explicit_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(explicit_actions)
        explicit_database: darray[u8] = render_build_compilation_database(explicit_plan, [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: "/work space/common.pch"}])
        assert bytes_view(explicit_database).contains("\"output\":\"/work space/common.pch\"")


@test
def compilation_database_rejects_unmodeled_auxiliary_outputs() -> void:
    can Memory.Allocate, Abort.Panic:
        source_text: sview = "/work space/src/main.c"
        auxiliary_modes: darray[sview] = [
            "-save-temps", "-save-temps=cwd", "-save-temps=obj", "--save-temps", "--save-temps=cwd", "--save-temps=obj",
            "-save-stats", "-save-stats=cwd", "-save-stats=obj", "--save-stats", "--save-stats=cwd", "--save-stats=obj",
            "-fproc-stat-report=/work space/main.csv",
            "-ftest-coverage", "--coverage", "-coverage"
        ]
        for mode in auxiliary_modes:
            actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
                name: "compile-with-unmodeled-auxiliary-output",
                command: compilation_database_test_command(["-c", source_text, "-o", "/work space/main.o", mode]),
                fingerprint: 1u64,
                outputs: ["/work space/main.o"]
            }]
            plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(actions)
            auxiliary_output_rejected: mutable bool = false
            catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: "/work space/main.o"}]):
                ok encoded:
                    _ = encoded
                error failure:
                    auxiliary_output_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
            assert auxiliary_output_rejected


@test
def compilation_database_binds_clang_time_trace_outputs() -> void:
    can Memory.Allocate, Abort.Panic:
        source_text: sview = "/work space/src/main.c"
        implicit_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-implicit-time-trace",
            command: compilation_database_test_command(["-c", source_text, "-o", "/work space/main.o", "-ftime-trace"]),
            fingerprint: 1u64,
            outputs: ["/work space/main.o", "/work space/main.json"]
        }]
        implicit_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(implicit_actions)
        implicit_database: darray[u8] = render_build_compilation_database(implicit_plan, [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: "/work space/main.o"}])
        assert bytes_view(implicit_database).contains("\"output\":\"/work space/main.o\"")

        explicit_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-explicit-time-trace",
            command: compilation_database_test_command(["-c", source_text, "-o", "/work space/main.o", "-ftime-trace=/work space/custom-trace.json"]),
            fingerprint: 2u64,
            outputs: ["/work space/main.o", "/work space/custom-trace.json"]
        }]
        explicit_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(explicit_actions)
        explicit_database: darray[u8] = render_build_compilation_database(explicit_plan, [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: "/work space/main.o"}])
        assert bytes_view(explicit_database).contains("-ftime-trace=/work space/custom-trace.json")

        directory_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-time-trace-directory",
            command: compilation_database_test_command(["-c", source_text, "-o", "/work space/main.o", "-ftime-trace=/work space/traces"]),
            fingerprint: 3u64,
            outputs: ["/work space/main.o", "/work space/traces/main.json"]
        }]
        directory_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(directory_actions)
        directory_database: darray[u8] = render_build_compilation_database(directory_plan, [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: "/work space/main.o"}])
        assert bytes_view(directory_database).contains("-ftime-trace=/work space/traces")

        unowned_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-unowned-time-trace",
            command: compilation_database_test_command(["-c", source_text, "-o", "/work space/main.o", "-ftime-trace=/work space/unowned.json"]),
            fingerprint: 3u64,
            outputs: ["/work space/main.o"]
        }]
        unowned_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(unowned_actions)
        unowned_trace_rejected: mutable bool = false
        catch render_build_compilation_database(unowned_plan, [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: "/work space/main.o"}]):
            ok encoded:
                _ = encoded
            error failure:
                unowned_trace_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert unowned_trace_rejected

        duplicate_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-duplicate-time-trace",
            command: compilation_database_test_command(["-c", source_text, "-o", "/work space/main.o", "-ftime-trace", "-ftime-trace=/work space/custom.json"]),
            fingerprint: 5u64,
            outputs: ["/work space/main.o", "/work space/main.json", "/work space/custom.json"]
        }]
        duplicate_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(duplicate_actions)
        duplicate_trace_rejected: mutable bool = false
        catch render_build_compilation_database(duplicate_plan, [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: "/work space/main.o"}]):
            ok encoded:
                _ = encoded
            error failure:
                duplicate_trace_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert duplicate_trace_rejected


@test
def compilation_database_binds_split_dwarf_sidecars() -> void:
    can Memory.Allocate, Abort.Panic:
        source_text: sview = "/work space/src/main.c"
        implicit_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-implicit-split-dwarf",
            command: compilation_database_test_command(["-g", "-gsplit-dwarf", "-c", source_text]),
            fingerprint: 1u64,
            outputs: ["/work space/main.o", "/work space/main.dwo"]
        }]
        implicit_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(implicit_actions)
        implicit_database: darray[u8] = render_build_compilation_database(implicit_plan, [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: "/work space/main.o"}])
        assert bytes_view(implicit_database).contains("\"output\":\"/work space/main.o\"")

        explicit_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-explicit-split-dwarf-output",
            command: compilation_database_test_command(["-g", "-gsplit-dwarf=split", "-c", source_text, "-o", "build/custom.o"]),
            fingerprint: 2u64,
            outputs: ["/work space/build/custom.o", "/work space/build/custom.dwo"]
        }]
        explicit_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(explicit_actions)
        explicit_database: darray[u8] = render_build_compilation_database(explicit_plan, [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: "/work space/build/custom.o"}])
        assert bytes_view(explicit_database).contains("build/custom.o")

        unowned_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-unowned-split-dwarf-output",
            command: compilation_database_test_command(["-g", "-gsplit-dwarf", "-c", source_text, "-o", "/work space/main.o"]),
            fingerprint: 3u64,
            outputs: ["/work space/main.o"]
        }]
        unowned_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(unowned_actions)
        unowned_dwo_rejected: mutable bool = false
        catch render_build_compilation_database(unowned_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok encoded:
                _ = encoded
            error failure:
                unowned_dwo_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert unowned_dwo_rejected

        single_mode_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-single-unit-split-dwarf",
            command: compilation_database_test_command(["-g", "-gsplit-dwarf=single", "-c", source_text]),
            fingerprint: 4u64,
            outputs: ["/work space/main.o"]
        }]
        single_mode_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(single_mode_actions)
        single_mode_database: darray[u8] = render_build_compilation_database(single_mode_plan, [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: "/work space/main.o"}])
        assert bytes_view(single_mode_database).contains("-gsplit-dwarf=single")

        disabled_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-disabled-split-dwarf",
            command: compilation_database_test_command(["-g", "-gsplit-dwarf", "-gno-split-dwarf", "-c", source_text]),
            fingerprint: 5u64,
            outputs: ["/work space/main.o"]
        }]
        disabled_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(disabled_actions)
