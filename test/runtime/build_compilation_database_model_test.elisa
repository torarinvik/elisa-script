include "../../src/ir/ir.elisa"

using EsBuildUsageArgv
using EsBuildUsageGraph
using EsBuildCompilationDatabase
using EsJson
using EsJsonLex
using EsJsonParse
using EsProcess


def compilation_database_test_command(arguments: darray[sview], environment_mode: ProcessEnvironmentMode = ProcessEnvironmentMode.Inherit) -> BuildUsageProcessCommand error[BuildUsageArgvError, ProcessCommandError] can[Memory.Allocate, Abort.Panic]:
    argv: BuildUsageArgv = try build_usage_raw_argv(arguments)
    return try build_usage_process_command(
        "/usr/bin/clang",
        argv,
        "/work space",
        [],
        environment_mode,
        60000000u64,
        1048576
    )


def compilation_database_test_plan() -> BuildUsageGraphPlan error[BuildUsageGraphError, BuildUsageArgvError, ProcessCommandError, BuildExecutionError, BuildContractError] can[Memory.Allocate, Abort.Panic]:
    actions: darray[BuildUsageActionSpec] = [
        BuildUsageActionSpec{
            name: "compile-main",
            command: compilation_database_test_command(["-Iinclude path", "-DVALUE=\"quoted\"", "-DLINE=first\nsecond", "-c", "/work space/src/main.c", "-o", "/work space/main.o", "-MF", "/work space/main.d"]),
            fingerprint: 1u64,
            outputs: ["/work space/main.o", "/work space/main.d"]
        },
        BuildUsageActionSpec{
            name: "compile-empty-argument",
            command: compilation_database_test_command(["", "-c", "/work space/src/other.c"]),
            fingerprint: 2u64
        }
    ]
    return try build_usage_graph_plan(actions)


@test
def compilation_database_projects_owned_argv_as_stable_json() -> void:
    can Memory.Allocate, Abort.Panic:
        plan: mutable BuildUsageGraphPlan = compilation_database_test_plan()
        sources: darray[BuildCompilationSource] = [
            BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c", output_file: "/work space/main.o"},
            BuildCompilationSource{action_index: 1, source_file: "/work space/src/other.c"}
        ]
        encoded: darray[u8] = render_build_compilation_database(plan, sources)
        expected: sview = "[{\"directory\":\"/work space\",\"file\":\"/work space/src/main.c\",\"arguments\":[\"/usr/bin/clang\",\"-Iinclude path\",\"-DVALUE=\\\"quoted\\\"\",\"-DLINE=first\\nsecond\",\"-c\",\"/work space/src/main.c\",\"-o\",\"/work space/main.o\",\"-MF\",\"/work space/main.d\"],\"output\":\"/work space/main.o\"},{\"directory\":\"/work space\",\"file\":\"/work space/src/other.c\",\"arguments\":[\"/usr/bin/clang\",\"\",\"-c\",\"/work space/src/other.c\"]}]\n"
        assert bytes_view(encoded) == expected
        lexed: JsonLexedSource = lex_json(bytes_view(encoded))
        document: JsonDocument = parse_json_document(lexed)
        assert document.state == JsonDocumentState.Sealed
        assert document.roots.count == 1
        assert document.nodes[document.roots[0]].kind == JsonNodeKind.Array
        root: JsonNode = document.nodes[document.roots[0]]
        assert root.child_count == 2
        first_entry_index: usize = document.children[root.child_start].value_index
        first_entry: JsonNode = document.nodes[first_entry_index]
        assert first_entry.kind == JsonNodeKind.Object
        file_member_index: usize = json_object_member_index(document, first_entry_index, "file")
        assert bytes_view(copy_json_scalar(document, document.members[file_member_index].value_index)) == "/work space/src/main.c"
        argv_member_index: usize = json_object_member_index(document, first_entry_index, "arguments")
        argv_index: usize = document.members[argv_member_index].value_index
        argv_node: JsonNode = document.nodes[argv_index]
        assert argv_node.kind == JsonNodeKind.Array and argv_node.child_count == 10
        first_argument_index: usize = document.children[argv_node.child_start].value_index
        assert bytes_view(copy_json_scalar(document, first_argument_index)) == "/usr/bin/clang"
        output_member_index: usize = json_object_member_index(document, first_entry_index, "output")
        assert bytes_view(copy_json_scalar(document, document.members[output_member_index].value_index)) == "/work space/main.o"

        outputless_metadata: darray[u8] = render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c"}])
        assert bytes_view(outputless_metadata).contains("\"-o\",\"/work space/main.o\"")
        assert not bytes_view(outputless_metadata).contains("\"output\":")


@test
def compilation_database_escapes_control_and_unicode_bytes_without_shell_joining() -> void:
    can Memory.Allocate, Abort.Panic:
        source_text: sview = "/work space/src/\"café\".c"
        output_text: sview = "/work space/main.o"
        actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-unicode-source",
            command: compilation_database_test_command(["-Iinclude path", "-DVALUE=\"quoted\"", "-DLINE=first\nsecond", "-c", source_text, "-o", output_text]),
            fingerprint: 1u64,
            outputs: [output_text]
        }]
        plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(actions)
        sources: darray[BuildCompilationSource] = [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: output_text}]
        encoded: darray[u8] = render_build_compilation_database(plan, sources)
        encoded_text: sview = bytes_view(encoded)
        assert encoded_text.contains("café")
        assert encoded_text.contains("\\\"café\\\".c")
        assert encoded_text.contains("-Iinclude path")
        assert encoded_text.contains("-DVALUE=\\\"quoted\\\"")
        assert encoded_text.contains("-DLINE=first\\nsecond")


@test
def compilation_database_rejects_duplicate_actions_and_bounds_output() -> void:
    can Memory.Allocate, Abort.Panic:
        plan: mutable BuildUsageGraphPlan = compilation_database_test_plan()
        duplicate_sources: darray[BuildCompilationSource] = [
            BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c"},
            BuildCompilationSource{action_index: 0, source_file: "/work space/src/other.c"}
        ]
        duplicate_rejected: mutable bool = false
        catch render_build_compilation_database(plan, duplicate_sources):
            ok encoded:
                _ = encoded
            error failure:
                duplicate_rejected <- failure == BuildCompilationDatabaseError.DuplicateAction
        assert duplicate_rejected

        unordered_rejected: mutable bool = false
        catch render_build_compilation_database(plan, [
            BuildCompilationSource{action_index: 1, source_file: "/work space/src/other.c"},
            BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c"}
        ]):
            ok encoded:
                _ = encoded
            error failure:
                unordered_rejected <- failure == BuildCompilationDatabaseError.ActionOrderInvalid
        assert unordered_rejected

        tiny_limit_rejected: mutable bool = false
        catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c"}], 16):
            ok encoded:
                _ = encoded
            error failure:
                tiny_limit_rejected <- failure == BuildCompilationDatabaseError.OutputLimitExceeded
        assert tiny_limit_rejected

        undeclared_output_rejected: mutable bool = false
        catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c", output_file: "/work space/other.o"}]):
            ok encoded:
                _ = encoded
            error failure:
                undeclared_output_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert undeclared_output_rejected

        invalid_path_bytes: mutable darray[u8] = [47u8, 119u8, 111u8, 114u8, 107u8, 47u8, 255u8]
        invalid_utf8_rejected: mutable bool = false
        catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: bytes_view(invalid_path_bytes)}]):
            ok encoded:
                _ = encoded
            error failure:
                invalid_utf8_rejected <- failure == BuildCompilationDatabaseError.InvalidUtf8
        assert invalid_utf8_rejected


@test
def compilation_database_requires_source_compile_and_output_to_match_action_argv() -> void:
    can Memory.Allocate, Abort.Panic:
        plan: mutable BuildUsageGraphPlan = compilation_database_test_plan()
        source_mismatch_rejected: mutable bool = false
        catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: "/work space/src/other.c"}]):
            ok encoded:
                _ = encoded
            error failure:
                source_mismatch_rejected <- failure == BuildCompilationDatabaseError.InvalidSourceFile
        assert source_mismatch_rejected

        non_compile_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "source-without-compile-mode",
            command: compilation_database_test_command(["/work space/src/main.c"]),
            fingerprint: 1u64,
            outputs: ["/work space/main.o"]
        }]
        non_compile_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(non_compile_actions)
        non_compile_rejected: mutable bool = false
        catch render_build_compilation_database(non_compile_plan, [BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c"}]):
            ok encoded:
                _ = encoded
            error failure:
                non_compile_rejected <- failure == BuildCompilationDatabaseError.InvalidCompileAction
        assert non_compile_rejected

        depfile_mapped_as_object_rejected: mutable bool = false
        catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c", output_file: "/work space/main.d"}]):
            ok encoded:
                _ = encoded
            error failure:
                depfile_mapped_as_object_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert depfile_mapped_as_object_rejected


@test
def compilation_database_rejects_dangling_or_ambiguous_optional_output_arguments() -> void:
    can Memory.Allocate, Abort.Panic:
        source_text: sview = "/work space/src/main.c"
        dangling_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-dangling-output-option",
            command: compilation_database_test_command(["-c", source_text, "-o"]),
            fingerprint: 1u64,
            outputs: []
        }]
        dangling_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(dangling_actions)
        dangling_output_rejected: mutable bool = false
        catch render_build_compilation_database(dangling_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok encoded:
                _ = encoded
            error failure:
                dangling_output_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert dangling_output_rejected

        empty_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-empty-output-operand",
            command: compilation_database_test_command(["-c", source_text, "-o", ""]),
            fingerprint: 2u64,
            outputs: []
        }]
        empty_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(empty_actions)
        empty_output_rejected: mutable bool = false
        catch render_build_compilation_database(empty_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok encoded:
                _ = encoded
            error failure:
                empty_output_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert empty_output_rejected

        duplicate_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-ambiguous-output-options",
            command: compilation_database_test_command(["-c", source_text, "-o", "/work space/first.o", "-o", "/work space/second.o"]),
            fingerprint: 3u64,
            outputs: ["/work space/first.o", "/work space/second.o"]
        }]
        duplicate_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(duplicate_actions)
        ambiguous_output_rejected: mutable bool = false
        catch render_build_compilation_database(duplicate_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok encoded:
                _ = encoded
            error failure:
                ambiguous_output_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert ambiguous_output_rejected


@test
def compilation_database_rejects_undeclared_argv_output_without_optional_field() -> void:
    can Memory.Allocate, Abort.Panic:
        source_text: sview = "/work space/src/main.c"
        actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-unowned-output",
            command: compilation_database_test_command(["-c", source_text, "-o", "/work space/unowned.o"]),
            fingerprint: 1u64
        }]
        plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(actions)
        rejected: mutable bool = false
        catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok encoded:
                _ = encoded
            error failure:
                rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert rejected


@test
def compilation_database_binds_joined_and_long_output_options() -> void:
    can Memory.Allocate, Abort.Panic:
        source_text: sview = "/work space/src/main.c"
        joined_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-joined-output",
            command: compilation_database_test_command(["-c", source_text, "-o/work space/main.o"]),
            fingerprint: 1u64,
            outputs: ["/work space/main.o"]
        }]
        joined_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(joined_actions)
        joined_output: darray[u8] = render_build_compilation_database(joined_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}])
        assert bytes_view(joined_output).contains("\"-o/work space/main.o\"")
        joined_with_metadata: darray[u8] = render_build_compilation_database(joined_plan, [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: "/work space/main.o"}])
        assert bytes_view(joined_with_metadata).contains("\"output\":\"/work space/main.o\"")

        long_separate_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-long-separate-output",
            command: compilation_database_test_command(["-c", source_text, "--output", "/work space/main.o"]),
            fingerprint: 2u64,
            outputs: ["/work space/main.o"]
        }]
        long_separate_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(long_separate_actions)
        long_separate_output: darray[u8] = render_build_compilation_database(long_separate_plan, [BuildCompilationSource{action_index: 0, source_file: source_text, output_file: "/work space/main.o"}])
        assert bytes_view(long_separate_output).contains("\"--output\",\"/work space/main.o\"")

        joined_unowned_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-joined-unowned-output",
            command: compilation_database_test_command(["-c", source_text, "-o/work space/unowned.o"]),
            fingerprint: 3u64
        }]
        joined_unowned_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(joined_unowned_actions)
        joined_unowned_rejected: mutable bool = false
        catch render_build_compilation_database(joined_unowned_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok encoded:
                _ = encoded
            error failure:
                joined_unowned_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert joined_unowned_rejected

        long_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-long-unowned-output",
            command: compilation_database_test_command(["-c", source_text, "--output=/work space/unowned.o"]),
            fingerprint: 4u64
        }]
        long_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(long_actions)
        long_output_rejected: mutable bool = false
        catch render_build_compilation_database(long_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok encoded:
                _ = encoded
            error failure:
                long_output_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert long_output_rejected

        duplicate_forms: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-mixed-output-options",
            command: compilation_database_test_command(["-c", source_text, "-o", "/work space/main.o", "--output=/work space/other.o"]),
            fingerprint: 5u64,
            outputs: ["/work space/main.o", "/work space/other.o"]
        }]
        duplicate_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(duplicate_forms)
        duplicate_rejected: mutable bool = false
        catch render_build_compilation_database(duplicate_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok encoded:
                _ = encoded
            error failure:
                duplicate_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert duplicate_rejected


@test
def compilation_database_does_not_misread_object_file_name_as_primary_output() -> void:
    can Memory.Allocate, Abort.Panic:
        source_text: sview = "/work space/src/main.c"
        actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-object-file-name",
            command: compilation_database_test_command(["-object-file-name=/work space/debug-name.o", "-c", source_text]),
            fingerprint: 1u64
        }]
        plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(actions)
        encoded: darray[u8] = render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: source_text}])
        assert bytes_view(encoded).contains("-object-file-name=/work space/debug-name.o")


@test
def compilation_database_rejects_unprojected_process_environment() -> void:
    can Memory.Allocate, Abort.Panic:
        actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-cleared-environment",
            command: compilation_database_test_command(["-c", "/work space/src/main.c"], ProcessEnvironmentMode.Clear),
            fingerprint: 1u64,
            outputs: ["/work space/main.o"]
        }]
        plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(actions)
        rejected: mutable bool = false
        catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c"}]):
            ok encoded:
                _ = encoded
            error failure:
                rejected <- failure == BuildCompilationDatabaseError.UnsupportedEnvironment
        assert rejected
