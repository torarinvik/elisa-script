        }]
        duplicate_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(duplicate_actions)
        duplicate_rejected: mutable bool = false
        catch render_build_compilation_database(duplicate_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok duplicate_encoded:
                _ = duplicate_encoded
            error failure:
                duplicate_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert duplicate_rejected

        dangling_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-dangling-depfile-option",
            command: compilation_database_test_command(["-c", source_text, "-MF"]),
            fingerprint: 13u64
        }]
        dangling_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(dangling_actions)
        dangling_rejected: mutable bool = false
        catch render_build_compilation_database(dangling_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok dangling_encoded:
                _ = dangling_encoded
            error failure:
                dangling_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert dangling_rejected

        stdout_depfile_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-stdout-depfile",
            command: compilation_database_test_command(["-c", source_text, "-o", "/work space/main.o", "-MF", "-"]),
            fingerprint: 14u64,
            outputs: ["/work space/main.o"]
        }]
        stdout_depfile_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(stdout_depfile_actions)
        stdout_depfile: darray[u8] = render_build_compilation_database(stdout_depfile_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}])
        assert bytes_view(stdout_depfile).contains("\"-MF\",\"-\"")


@test
def compilation_database_binds_dependency_file_alias() -> void:
    can Memory.Allocate, Abort.Panic:
        source_text: sview = "/work space/src/main.c"
        actions: darray[BuildUsageActionSpec] = [
            BuildUsageActionSpec{
                name: "compile-with-dependency-file-alias",
                command: compilation_database_test_command(["-MD", "-c", source_text, "-o", "build/main.o", "-dependency-file", "build/main.d"]),
                fingerprint: 1u64,
                outputs: ["/work space/build/main.o", "/work space/build/main.d"]
            },
            BuildUsageActionSpec{
                name: "compile-with-second-dependency-file-alias",
                command: compilation_database_test_command(["-MMD", "-c", "/work space/src/other.c", "-obuild/other.o", "-dependency-file", "build/other.d"]),
                fingerprint: 2u64,
                outputs: ["/work space/build/other.o", "/work space/build/other.d"]
            }
        ]
        plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(actions)
        encoded: darray[u8] = render_build_compilation_database(plan, [
            BuildCompilationSource{action_index: 0, source_file: source_text, output_file: "/work space/build/main.o"},
            BuildCompilationSource{action_index: 1, source_file: "/work space/src/other.c", output_file: "/work space/build/other.o"}
        ])
        encoded_text: sview = bytes_view(encoded)
        assert encoded_text.contains("\"-dependency-file\",\"build/main.d\"")
        assert encoded_text.contains("\"-dependency-file\",\"build/other.d\"")

        unowned_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-unowned-dependency-file-alias",
            command: compilation_database_test_command(["-MD", "-c", source_text, "-o", "/work space/main.o", "-dependency-file", "/work space/unowned.d"]),
            fingerprint: 3u64,
            outputs: ["/work space/main.o"]
        }]
        unowned_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(unowned_actions)
        unowned_rejected: mutable bool = false
        catch render_build_compilation_database(unowned_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok unowned_encoded:
                _ = unowned_encoded
            error failure:
                unowned_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert unowned_rejected

        dangling_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-dangling-dependency-file-alias",
            command: compilation_database_test_command(["-c", source_text, "-dependency-file"]),
            fingerprint: 4u64
        }]
        dangling_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(dangling_actions)
        dangling_rejected: mutable bool = false
        catch render_build_compilation_database(dangling_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok dangling_encoded:
                _ = dangling_encoded
            error failure:
                dangling_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert dangling_rejected

        duplicate_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-mixed-dependency-file-options",
            command: compilation_database_test_command(["-c", source_text, "-MF", "/work space/main.d", "-dependency-file", "/work space/other.d"]),
            fingerprint: 5u64,
            outputs: ["/work space/main.o", "/work space/main.d", "/work space/other.d"]
        }]
        duplicate_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(duplicate_actions)
        duplicate_rejected: mutable bool = false
        catch render_build_compilation_database(duplicate_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok duplicate_encoded:
                _ = duplicate_encoded
            error failure:
                duplicate_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert duplicate_rejected

        malformed_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-joined-dependency-file-alias",
            command: compilation_database_test_command(["-c", source_text, "-dependency-file=/work space/main.d"]),
            fingerprint: 6u64,
            outputs: ["/work space/main.o", "/work space/main.d"]
        }]
        malformed_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(malformed_actions)
        malformed_rejected: mutable bool = false
        catch render_build_compilation_database(malformed_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok malformed_encoded:
                _ = malformed_encoded
            error failure:
                malformed_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert malformed_rejected


@test
def compilation_database_binds_clang_dependency_dot_output() -> void:
    can Memory.Allocate, Abort.Panic:
        source_text: sview = "/work space/src/main.c"
        actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-dependency-dot-output",
            command: compilation_database_test_command(["-c", source_text, "-o", "build/main.o", "-dependency-dot", "build/main.dot"]),
            fingerprint: 1u64,
            outputs: ["/work space/build/main.o", "/work space/build/main.dot"]
        }]
        plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(actions)
        encoded: darray[u8] = render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: source_text}])
        assert bytes_view(encoded).contains("\"-dependency-dot\",\"build/main.dot\"")

        unowned_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-unowned-dependency-dot-output",
            command: compilation_database_test_command(["-c", source_text, "-o", "/work space/main.o", "-dependency-dot", "/work space/unowned.dot"]),
            fingerprint: 2u64,
            outputs: ["/work space/main.o"]
        }]
        unowned_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(unowned_actions)
        unowned_rejected: mutable bool = false
        catch render_build_compilation_database(unowned_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok unowned_encoded:
                _ = unowned_encoded
            error failure:
                unowned_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert unowned_rejected

        dangling_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-dangling-dependency-dot-option",
            command: compilation_database_test_command(["-c", source_text, "-dependency-dot"]),
            fingerprint: 3u64
        }]
        dangling_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(dangling_actions)
        dangling_rejected: mutable bool = false
        catch render_build_compilation_database(dangling_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok dangling_encoded:
                _ = dangling_encoded
            error failure:
                dangling_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert dangling_rejected

        collision_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-dependency-dot-primary-collision",
            command: compilation_database_test_command(["-c", source_text, "-o", "/work space/main.o", "-dependency-dot", "/work space/main.o"]),
            fingerprint: 4u64,
            outputs: ["/work space/main.o"]
        }]
        collision_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(collision_actions)
        collision_rejected: mutable bool = false
        catch render_build_compilation_database(collision_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok collision_encoded:
                _ = collision_encoded
            error failure:
                collision_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert collision_rejected

        duplicate_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-duplicate-dependency-dot-options",
            command: compilation_database_test_command(["-c", source_text, "-dependency-dot", "build/first.dot", "-dependency-dot", "build/second.dot"]),
            fingerprint: 5u64,
            outputs: ["/work space/main.o", "/work space/build/first.dot", "/work space/build/second.dot"]
        }]
        duplicate_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(duplicate_actions)
        duplicate_rejected: mutable bool = false
        catch render_build_compilation_database(duplicate_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok duplicate_encoded:
                _ = duplicate_encoded
            error failure:
                duplicate_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert duplicate_rejected

        malformed_actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-joined-dependency-dot-option",
            command: compilation_database_test_command(["-c", source_text, "-dependency-dot=/work space/main.dot"]),
            fingerprint: 5u64,
            outputs: ["/work space/main.o", "/work space/main.dot"]
        }]
        malformed_plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(malformed_actions)
        malformed_rejected: mutable bool = false
        catch render_build_compilation_database(malformed_plan, [BuildCompilationSource{action_index: 0, source_file: source_text}]):
            ok malformed_encoded:
                _ = malformed_encoded
            error failure:
                malformed_rejected <- failure == BuildCompilationDatabaseError.InvalidOutputPath
        assert malformed_rejected


@test
def compilation_database_does_not_misread_object_file_name_as_primary_output() -> void:
    can Memory.Allocate, Abort.Panic:
        source_text: sview = "/work space/src/main.c"
        actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-object-file-name",
            command: compilation_database_test_command(["-object-file-name=/work space/debug-name.o", "-c", source_text]),
            fingerprint: 1u64,
            outputs: ["/work space/main.o"]
        }]
        plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(actions)
        encoded: darray[u8] = render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: source_text}])
        assert bytes_view(encoded).contains("-object-file-name=/work space/debug-name.o")


@test
def compilation_database_rejects_unprojected_process_environment() -> void:
    can Memory.Allocate, Abort.Panic:
        actions: darray[BuildUsageActionSpec] = [BuildUsageActionSpec{
            name: "compile-with-cleared-environment",
            command: compilation_database_test_command(["-c", "/work space/src/main.c"], ProcessEnvironmentMode.Clear),
            fingerprint: 1u64,
            outputs: ["/work space/main.o"]
        }]
        plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(actions)
        rejected: mutable bool = false
        catch render_build_compilation_database(plan, [BuildCompilationSource{action_index: 0, source_file: "/work space/src/main.c"}]):
            ok encoded:
                _ = encoded
            error failure:
                rejected <- failure == BuildCompilationDatabaseError.UnsupportedEnvironment
        assert rejected
