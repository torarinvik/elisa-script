include "../../ports/elisa-engine/scripts/fetch_gns_plan.elisa"

using EsEngineFetchGnsPlan


@test
def gns_fetch_plan_pins_clone_and_revision_commands() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    checkout: Path = path("/fixture/dependencies/gns with spaces")
    clone: Command = clone_command(checkout)
    revision: Command = revision_command(checkout)
    assert clone.program == "git"
    assert clone.arguments == ["clone", "--depth", "1", Dependency::REPOSITORY, f"{checkout}"]
    assert revision.program == "git"
    assert revision.arguments == ["-C", f"{checkout}", "rev-parse", "HEAD"]
    assert command_text(revision) == "git -C /fixture/dependencies/gns with spaces rev-parse HEAD"


@test
def gns_fetch_plan_pins_static_plain_udp_cmake_configuration_and_target() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    checkout: Path = path("/fixture/dependencies/gns")
    build: Path = checkout.joinpath("build")
    configure: Command = configure_command(checkout, build)
    compile: Command = build_command(build)
    assert configure.program == "cmake"
    assert configure.arguments == [
        "-S", f"{checkout}", "-B", f"{build}", "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_SHARED_LIB=OFF", "-DBUILD_STATIC_LIB=ON", "-DUSE_STEAM_SOCKETS=OFF"
    ]
    assert compile.program == "cmake"
    assert compile.arguments == ["--build", f"{build}", "--target", "GameNetworkingSockets_s"]
    assert Dependency::COMMIT == "a424b7db649438acafb60c99cae6667587c42732"
    assert Dependency::LIBRARY_RELATIVE_PATH == "dependencies/gns/build/src/libGameNetworkingSockets_s.a"
