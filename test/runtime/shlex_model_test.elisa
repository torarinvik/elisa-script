include "../../src/runtime/shlex_model.elisa"

using EsShlex


def assert_words(actual: WordList, expected: darray[sview]) -> void can[Memory.Allocate, Abort.Panic]:
    assert actual.values.count == expected.count
    for index in 0..<expected.count |actual, expected|:
        assert bytes_view(actual.values[index]) == expected[index]


def split_fails(input: sview) -> bool can[Memory.Allocate, Abort.Panic]:
    failed: mutable bool = false
    catch split_words(input):
        ok _:
            failed <- false
        error _:
            failed <- true
    return failed


def assert_split(input: sview, expected: darray[sview]) -> void can[Memory.Allocate, Abort.Panic]:
    catch split_words(input):
        ok words:
            assert_words(words, expected)
        error _:
            assert false


@test
def shlex_words_concatenate_quotes_and_preserve_empty_arguments() -> void can[Memory.Allocate, Abort.Panic]:
    assert_split("alpha pre\"mid dle\"post 'two words' '' \"\"", ["alpha", "premid dlepost", "two words", "", ""])


@test
def shlex_words_follow_posix_double_quote_backslash_rules() -> void can[Memory.Allocate, Abort.Panic]:
    assert_split("tool \"a\\$b\\q\\\"\\\\z\"", ["tool", "a\\$b\\q\"\\z"])


@test
def shlex_words_handle_escaped_whitespace_without_evaluation() -> void can[Memory.Allocate, Abort.Panic]:
    assert_split("a\\ b c\\\nd #literal", ["a b", "c\nd", "#literal"])


@test
def shlex_words_reject_unterminated_quotes_and_escapes() -> void can[Memory.Allocate, Abort.Panic]:
    assert split_fails("'unfinished")
    assert split_fails("\"unfinished")
    assert split_fails("trailing\\")


@test
def shlex_words_use_only_python_whitespace_delimiters() -> void can[Memory.Allocate, Abort.Panic]:
    input: darray[u8] = [97u8, 11u8, 98u8, 12u8, 99u8]
    catch split_words(bytes_view(input)):
        ok words:
            assert words.values.count == 1
            assert words.values[0] == input
        error _:
            assert false


@test
def shlex_words_enforce_the_per_word_storage_limit() -> void can[Memory.Allocate, Abort.Panic]:
    input: mutable darray[u8] = []
    limit: usize = Limits::WORD_BYTES + 1
    for _ in 0..<limit |input|:
        input.push(120u8)
    assert split_fails(bytes_view(input))
