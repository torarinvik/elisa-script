include "../../src/runtime/encoding.elisa"
include "../../src/runtime/file_posix.elisa"
include "../../src/runtime/directory_posix.elisa"
include "../../src/runtime/stdio_posix.elisa"
include "../../src/runtime/bounded_text_posix.elisa"
include "../../src/runtime/config_model.elisa"
include "../../src/runtime/config_toml_model.elisa"
include "../../src/runtime/config_toml_file_posix.elisa"

using EsConfigTomlFilePosix


@test
def bounded_toml_configuration_file_returns_owned_layer() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        loaded: ConfigTomlFileLayer = read_config_toml_file(path("test/runtime/config_toml_file_fixture.toml"))
        assert loaded.parsed.layer.source == EsConfig::ConfigSource.File
        assert loaded.parsed.layer.entries.count == 3
        assert loaded.parsed.layer.entries[0].key == "build.mode"
        assert loaded.parsed.layer.entries[0].value == "release"
        assert loaded.parsed.layer.entries[1].key == "build.retries"
        assert loaded.parsed.layer.entries[1].value == "3"
        dependencies_index: usize = EsConfigToml::lookup_toml_config_value(loaded.parsed, "build.dependencies")
        assert dependencies_index < loaded.parsed.values.count
        assert loaded.parsed.values[dependencies_index].kind == EsConfigToml::ConfigTomlValueKind.Array
        assert loaded.parsed.values[dependencies_index].items.count == 2
        assert bytes_view(loaded.parsed.values[dependencies_index].items[0].text) == "setuptools>=68"


@test
def cargo_workspace_manifest_preserves_nested_typed_values() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        loaded: ConfigTomlFileLayer = read_config_toml_file(path("test/runtime/config_toml_cargo_fixture.toml"))
        for value in loaded.parsed.values |loaded|:
            assert EsConfigToml::validate_toml_value_graph(value.nodes, value.children)

        members_index: usize = EsConfigToml::lookup_toml_config_value(loaded.parsed, "workspace.members")
        assert members_index < loaded.parsed.values.count
        members: ConfigTomlValue = loaded.parsed.values[members_index]
        assert members.kind == EsConfigToml::ConfigTomlValueKind.Array
        assert members.nodes[0].child_count == 16
        assert bytes_view(members.items[0].text) == "crates/wb-manifest"
        assert bytes_view(members.items[15].text) == "crates/wb-cli"

        wasmtime_index: usize = EsConfigToml::lookup_toml_config_value(loaded.parsed, "workspace.dependencies.wasmtime")
        assert wasmtime_index < loaded.parsed.values.count
        wasmtime: ConfigTomlValue = loaded.parsed.values[wasmtime_index]
        assert wasmtime.kind == EsConfigToml::ConfigTomlValueKind.InlineTable
        wasmtime_root: ConfigTomlNode = wasmtime.nodes[0]
        assert wasmtime_root.child_count == 2
        features_index: usize = wasmtime.children.count
        for ordinal in 0..<wasmtime_root.child_count |wasmtime, wasmtime_root, features_index|:
            edge: ConfigTomlNodeChild = wasmtime.children[wasmtime_root.child_start + ordinal]
            if bytes_view(edge.key) == "features":
                features_index <- edge.value_index
        assert features_index < wasmtime.nodes.count
        features: ConfigTomlNode = wasmtime.nodes[features_index]
        assert features.kind == EsConfigToml::ConfigTomlValueKind.Array
        assert features.child_count == 1
        feature_index: usize = wasmtime.children[features.child_start].value_index
        assert bytes_view(wasmtime.nodes[feature_index].text) == "component-model"

        aliased_index: usize = EsConfigToml::lookup_toml_config_value(loaded.parsed, "workspace.dependencies.sha2_11")
        assert aliased_index < loaded.parsed.values.count
        aliased: ConfigTomlValue = loaded.parsed.values[aliased_index]
        assert aliased.kind == EsConfigToml::ConfigTomlValueKind.InlineTable
        assert aliased.nodes[0].child_count == 2


@test
def bounded_toml_configuration_file_rejects_invalid_budget_before_reading() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        rejected: mutable bool = false
        catch read_config_toml_file(path("test/runtime/not-opened.toml"), 0):
            ok loaded:
                assert false
            error failure:
                rejected <- failure == ConfigTomlFileError.InputLimitInvalid
        assert rejected
