include "../../ports/elisa-engine/scripts/fetch_sdl2_plan.elisa"

using EsEngineFetchSdl2Plan


@test
def sdl2_fetch_plan_pins_tagged_clone_and_revision_commands() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    checkout: Path = path("/fixture/dependencies/sdl2 with spaces")
    clone: Command = clone_command(checkout)
    revision: Command = revision_command(checkout)
    assert clone.program == "git"
    assert clone.arguments == ["clone", "--branch", Dependency::TAG, "--depth", "1", Dependency::REPOSITORY, f"{checkout}"]
    assert revision.program == "git"
    assert revision.arguments == ["-C", f"{checkout}", "rev-parse", "HEAD"]
    assert command_text(revision) == "git -C /fixture/dependencies/sdl2 with spaces rev-parse HEAD"


@test
def sdl2_fetch_plan_pins_release_build_options_and_artifacts() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    checkout: Path = path("/fixture/dependencies/sdl2")
    build: Path = checkout.joinpath("build")
    configure: Command = configure_command(checkout, build)
    compile: Command = build_command(build)
    assert configure.program == "cmake"
    assert configure.arguments == [
        "-S", f"{checkout}", "-B", f"{build}", "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5", "-DSDL_SHARED=ON", "-DSDL_STATIC=OFF", "-DSDL_TEST=OFF"
    ]
    assert compile.program == "cmake"
    assert compile.arguments == ["--build", f"{build}", "--target", "SDL2"]
    assert Dependency::REPOSITORY == "https://github.com/libsdl-org/SDL.git"
    assert Dependency::TAG == "release-2.32.10"
    assert Dependency::COMMIT == "5d249570393f7a37e037abf22cd6012a4cc56a71"
    assert Dependency::CHECKOUT_RELATIVE_PATH == "dependencies/sdl2"
    assert Dependency::BUILD_RELATIVE_PATH == "dependencies/sdl2/build"
    assert Dependency::LIBRARY_RELATIVE_PATH == "dependencies/sdl2/build/libSDL2-2.0.0.dylib"
    assert Dependency::LINK_RELATIVE_PATH == "dependencies/sdl2/build/libSDL2.dylib"
    assert Dependency::STAGED_RELATIVE_PATH == "build/libSDL2-2.0.0.dylib"
