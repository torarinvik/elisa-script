include "../../src/testing/geometry_subset_scene_cases.elisa"

using EsGeometrySubsetSceneCases


@test
def scene_metadata_replacements_are_first_match_only_and_ordered() -> void can[Memory.Allocate, Abort.Panic]:
    scene_package: sview = "camera_0_projection=0\ncamera_0_projection=0\nlight_0_kind=0\ncamera_0_transform_b64=encoded\n"
    generated: darray[Case] = try EsGeometrySubsetSceneCases::cases(scene_package)
    assert generated.count == 3
    assert generated[0].file_name == "scene-camera-projection.pkg"
    assert generated[0].expected_diagnostic == "camera metadata"
    assert bytes_view(generated[0].package_bytes) == "camera_0_projection=2\ncamera_0_projection=0\nlight_0_kind=0\ncamera_0_transform_b64=encoded\n"
    assert generated[1].file_name == "scene-light-kind.pkg"
    assert generated[1].expected_diagnostic == "light metadata"
    assert bytes_view(generated[1].package_bytes).contains("light_0_kind=3\n")
    assert generated[2].file_name == "scene-camera-transform.pkg"
    assert bytes_view(generated[2].package_bytes).contains("camera_0_transform=encoded\n")
    assert not bytes_view(generated[2].package_bytes).contains("camera_0_transform_b64=")


@test
def missing_expected_scene_field_has_a_typed_error() -> void can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch EsGeometrySubsetSceneCases::cases("camera_0_projection=0\n"):
        ok cases:
            _ = cases
        error failure:
            rejected <- failure == SceneCasesError.MissingExpectedField
    assert rejected
