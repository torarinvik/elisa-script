include "../../ports/elisa-engine/scripts/viewport_pick_smoke_plan.elisa"

using EsEngineViewportPickSmokePlan


@test
def viewport_pick_smoke_plan_preserves_paths_and_environment_overlay() -> void can[Memory.Allocate, Abort.Panic]:
    plan: Plan = EsEngineViewportPickSmokePlan::plan(
        "/tmp/engine checkout", "python3.14"
    )
    assert plan.interpreter == "python3.14"
    assert plan.working_directory == "/tmp/engine checkout"
    assert plan.arguments.count == 1
    assert plan.arguments[0] == "/tmp/engine checkout/scripts/render_scene_native_smoke.py"
    assert plan.environment.count == 3
    assert plan.environment[Defaults::RENDER_ONLY_KEY] == Defaults::ENABLED
    assert plan.environment[Defaults::PROFILE_COST_ONLY_KEY] == Defaults::ENABLED
    assert plan.environment[Defaults::NATIVE_MAIN_KEY] == "/tmp/engine checkout/test/render_scene_viewport_pick_main.elisa"


@test
def viewport_pick_smoke_outcome_is_fail_closed_and_report_once() -> void can[Abort.Panic]:
    started: ExecutionState = EsEngineViewportPickSmokePlan::initial_execution()
    failed: mutable ExecutionState = ExecutionState{}
    catch EsEngineViewportPickSmokePlan::execution_after_child(started, 23):
        ok state:
            failed <- state
        error failure:
            _ = failure
            assert false
    assert failed.phase == ExecutionPhase.ReportFailure
    assert failed.child_status == 23 and failed.exit_status == 1

    completed: mutable ExecutionState = ExecutionState{}
    catch EsEngineViewportPickSmokePlan::execution_after_report(failed):
        ok state:
            completed <- state
        error failure:
            _ = failure
            assert false
    assert completed.phase == ExecutionPhase.Done and completed.exit_status == 1
    rejected: mutable bool = false
    catch EsEngineViewportPickSmokePlan::execution_after_report(completed):
        ok state:
            _ = state
        error failure:
            rejected <- failure == PlanError.InvalidExecutionState
    assert rejected


@test
def viewport_pick_smoke_output_tail_counts_utf8_codepoints_not_bytes() -> void can[Memory.Allocate, Abort.Panic]:
    unicode_tail: darray[u8] = EsEngineViewportPickSmokePlan::trailing_utf8_codepoints("aæb", 2)
    assert bytes_view(unicode_tail) == "æb"

    long_output: mutable darray[u8] = [97u8, 98u8]
    for _ in 0..<2000 |long_output|:
        long_output.push(99u8)
    tail: darray[u8] = EsEngineViewportPickSmokePlan::trailing_utf8_codepoints(
        bytes_view(long_output), Defaults::OUTPUT_TAIL_CODEPOINTS
    )
    assert tail.count == 2000 and tail[0] == 99u8 and tail[1999] == 99u8
