# Pure policy: never write to the process environment or launch the compiler.
include "../../src/runtime/ui_codec_build_model.elisa"


@test
def ui_codec_compiler_environment_defaults_only_exported_empty_cc() -> void:
    absent: EsUiCodecBuild::CompilerEnvironment = try EsUiCodecBuild::compiler_environment("", false) else err:
        assert false
        return
    empty: EsUiCodecBuild::CompilerEnvironment = try EsUiCodecBuild::compiler_environment("", true) else err:
        assert false
        return
    configured: EsUiCodecBuild::CompilerEnvironment = try EsUiCodecBuild::compiler_environment("compiler with spaces", true) else err:
        assert false
        return
    assert not absent.set_cc and absent.cc_value == ""
    assert empty.set_cc and empty.cc_value == "clang"
    assert not configured.set_cc and configured.cc_value == ""


@test
def ui_codec_compiler_environment_rejects_forged_absence_and_nul() -> void:
    can Memory.Allocate, Abort.Panic:
        for value in ["forged", "a\0b"]:
            rejected: mutable bool = false
            catch EsUiCodecBuild::compiler_environment(value, false):
                ok _:
                    assert false
                error failure:
                    rejected <- failure == EsUiCodecBuild::RecipeError.InvalidCompiler
            assert rejected
