include "../../src/runtime/encoding.elisa"
include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../src/runtime/json_lexer_model.elisa"
include "../../src/runtime/json_parse_model.elisa"
include "../../src/runtime/bounded_text_posix.elisa"
include "../../src/runtime/macos_app_manifest_model.elisa"
include "../../src/runtime/macos_app_manifest_file_posix.elisa"

using EsMacosAppManifest
using EsMacosAppManifestFile


@test
def loads_manifest_settings_or_empty_defaults_from_project() -> void can[Blocking.IO, File.Read, File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    project: Path = try temp_directory("macos-app-manifest-file") else err:
        assert false
        return
    manifest_path: Path = project.joinpath("elisa.project.json")

    absent: DecodedMacosAppManifest = try load_macos_app_manifest(project) else err:
        assert false
        _ = try remove_directory(project) else false
        return
    default_name: sview = project.name()
    wrote_manifest: usize = try write_text(manifest_path, "{\"name\":\"First\",\"name\":\"Last\",\"package\":{\"resources\":[\"assets/texture.bin\"],\"notices\":[\"NOTICE\"]}}") else 0usize
    loaded: mutable DecodedMacosAppManifest = DecodedMacosAppManifest{settings: absent.settings, paths: absent.paths}
    load_succeeded: mutable bool = false
    if wrote_manifest != 0:
        catch load_macos_app_manifest(project):
            ok manifest:
                loaded <- manifest
                load_succeeded <- true
            error _:
                load_succeeded <- false

    removed_manifest: bool = try remove_path(manifest_path) else false
    removed_project: bool = try remove_directory(project) else false
    assert bytes_view(absent.settings.name) == default_name
    assert absent.paths.resource_mode == MacosResourceMode.AllAssets
    assert wrote_manifest != 0 and load_succeeded
    assert bytes_view(loaded.settings.name) == "Last"
    assert loaded.paths.resource_mode == MacosResourceMode.ExplicitPaths
    assert loaded.paths.resource_paths.count == 1 and bytes_view(loaded.paths.resource_paths[0]) == "assets/texture.bin"
    assert loaded.paths.notice_paths.count == 1 and bytes_view(loaded.paths.notice_paths[0]) == "NOTICE"
    assert removed_manifest and removed_project
