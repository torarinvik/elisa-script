include "../../src/runtime/config_model.elisa"
include "../../src/runtime/config_cli_model.elisa"

using EsConfig
using EsConfigCli


@test
def declared_config_cli_options_preserve_empty_and_passthrough_values() -> void:
    can Memory.Allocate, Abort.Panic:
        options: darray[ConfigCliOption] = [
            ConfigCliOption{key: "jobs", option: "--jobs", takes_value: true},
            ConfigCliOption{key: "verbose", option: "--verbose", takes_value: false, negative_option: "--no-verbose"}
        ]
        parsed: ConfigCliResult = parse_config_cli(["--jobs", "", "--verbose", "input.file", "--", "--literal", ""], options)
        assert parsed.layer.source == ConfigSource.CommandLine
        assert parsed.layer.entries.count == 2
        assert parsed.layer.entries[0].key == "jobs" and parsed.layer.entries[0].value == ""
        assert parsed.layer.entries[1].key == "verbose" and parsed.layer.entries[1].value == "true"
        assert parsed.positionals.count == 3
        assert parsed.positionals[0] == "input.file"
        assert parsed.positionals[1] == "--literal"
        assert parsed.positionals[2] == ""

        overridden: ConfigCliResult = parse_config_cli(["--no-verbose", "--jobs=8"], options)
        assert overridden.layer.entries.count == 2
        assert overridden.layer.entries[0].value == "false"
        assert overridden.layer.entries[1].value == "8"


@test
def declared_config_cli_options_reject_unknown_missing_and_duplicate_values() -> void:
    can Memory.Allocate, Abort.Panic:
        options: darray[ConfigCliOption] = [
            ConfigCliOption{key: "jobs", option: "--jobs", takes_value: true}
        ]
        unknown_rejected: mutable bool = false
        catch parse_config_cli(["--unknown"], options):
            ok parsed:
                assert false
            error failure:
                unknown_rejected <- failure == ConfigCliError.UnknownOption
        assert unknown_rejected

        missing_rejected: mutable bool = false
        catch parse_config_cli(["--jobs", "--"], options):
            ok parsed:
                assert false
            error failure:
                missing_rejected <- failure == ConfigCliError.MissingValue
        assert missing_rejected

        duplicate_rejected: mutable bool = false
        catch parse_config_cli(["--jobs=2", "--jobs", "4"], options):
            ok parsed:
                assert false
            error failure:
                duplicate_rejected <- failure == ConfigCliError.DuplicateOption
        assert duplicate_rejected

        nul_rejected: mutable bool = false
        catch parse_config_cli(["positional\0suffix"], options):
            ok parsed:
                assert false
            error failure:
                nul_rejected <- failure == ConfigCliError.EmbeddedNul
        assert nul_rejected


@test
def declared_config_cli_short_options_and_help_are_deterministic() -> void:
    can Memory.Allocate, Abort.Panic:
        options: darray[ConfigCliOption] = [
            ConfigCliOption{key: "jobs", option: "--jobs", short_option: "-j", takes_value: true, description: "Worker count"},
            ConfigCliOption{key: "verbose", option: "--verbose", short_option: "-v", takes_value: false, negative_option: "--no-verbose", description: "Show details"}
        ]
        parsed: ConfigCliResult = parse_config_cli(["-j=4", "-v"], options)
        assert parsed.layer.entries.count == 2
        assert parsed.layer.entries[0].key == "jobs" and parsed.layer.entries[0].value == "4"
        assert parsed.layer.entries[1].key == "verbose" and parsed.layer.entries[1].value == "true"
        attached: ConfigCliResult = parse_config_cli(["-j8"], options)
        assert attached.layer.entries.count == 1 and attached.layer.entries[0].value == "8"
        bundled: ConfigCliResult = parse_config_cli(["-vj8"], options)
        assert bundled.layer.entries.count == 2
        assert bundled.layer.entries[0].key == "verbose" and bundled.layer.entries[0].value == "true"
        assert bundled.layer.entries[1].key == "jobs" and bundled.layer.entries[1].value == "8"
        separated: ConfigCliResult = parse_config_cli(["-j", "9"], options)
        assert separated.layer.entries.count == 1 and separated.layer.entries[0].value == "9"

        duplicate_bundle_rejected: mutable bool = false
        catch parse_config_cli(["-vv"], options):
            ok parsed:
                assert false
            error failure:
                duplicate_bundle_rejected <- failure == ConfigCliError.DuplicateOption
        assert duplicate_bundle_rejected

        requested: ConfigCliResult = parse_config_cli(["--help", "ignored"], options)
        assert requested.help_requested
        literal: ConfigCliResult = parse_config_cli(["--", "--help"], options)
        assert not literal.help_requested and literal.positionals.count == 1 and literal.positionals[0] == "--help"

        command: ConfigCliCommand = ConfigCliCommand{name: "build", description: "Build project artifacts", options: options}
        help: ConfigCliHelp = config_cli_command_help("tool", command)
        rendered: sview = bytes_view(help.bytes)
        assert rendered == "Usage: tool build [OPTIONS] [ARGS...]\n\nBuild project artifacts\n\nOptions:\n  --jobs, -j <VALUE>\tWorker count\n  --verbose, -v, --no-verbose\tShow details\n  -h, --help\tShow this help\n"


@test
def declared_config_cli_subcommands_select_schema_and_render_root_help() -> void:
    can Memory.Allocate, Abort.Panic:
        commands: darray[ConfigCliCommand] = [
            ConfigCliCommand{name: "build", description: "Build artifacts", options: [ConfigCliOption{key: "jobs", option: "--jobs", takes_value: true}]},
            ConfigCliCommand{name: "test", description: "Run tests"}
        ]
        selected: ConfigCliCommandResult = parse_config_cli_command(["build", "--jobs", "8", "target"], commands)
        assert selected.command == "build"
        assert selected.parsed.layer.entries.count == 1 and selected.parsed.layer.entries[0].value == "8"
        assert selected.parsed.positionals.count == 1 and selected.parsed.positionals[0] == "target"

        root_help: ConfigCliCommandResult = parse_config_cli_command(["-h"], commands)
        assert root_help.command == "" and root_help.parsed.help_requested
        help: ConfigCliHelp = config_cli_root_help("tool", commands)
        assert bytes_view(help.bytes) == "Usage: tool <COMMAND> [OPTIONS] [ARGS...]\n\nCommands:\n  build\tBuild artifacts\n  test\tRun tests\n\nOptions:\n  -h, --help\tShow this help\n"

        missing_rejected: mutable bool = false
        catch parse_config_cli_command([], commands):
            ok parsed:
                assert false
            error failure:
                missing_rejected <- failure == ConfigCliError.MissingCommand
        assert missing_rejected

        unknown_rejected: mutable bool = false
        catch parse_config_cli_command(["clean"], commands):
            ok parsed:
                assert false
            error failure:
                unknown_rejected <- failure == ConfigCliError.UnknownCommand
        assert unknown_rejected

        help_after_separator: ConfigCliCommandResult = parse_config_cli_command(["test", "--", "--help"], commands)
        assert not help_after_separator.parsed.help_requested
        assert help_after_separator.parsed.positionals.count == 1 and help_after_separator.parsed.positionals[0] == "--help"
