include "../../ports/elisa-engine/scripts/cooked_meshopt_test_stream_model.elisa"

using EsEngineCookedMeshoptTestStream


def meshopt_response_rejects(response: darray[u8], expected: MeshoptTestStreamError) -> bool can[Memory.Allocate, Abort.Panic]:
    observed: mutable bool = false
    catch parse_vertex_decode_response(bytes_view(response), 2u32, 2u32):
        ok decoded:
            _ = decoded
        error failure:
            observed <- failure == expected
    return observed


def meshopt_valid_response() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    return [69u8, 76u8, 73u8, 83u8, 65u8, 83u8, 67u8, 49u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 4u8, 0u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 9u8, 8u8, 7u8, 6u8]


@test
def cooked_meshopt_raw_vertex_stream_decodes_exact_binary_bytes() -> void can[Memory.Allocate, Abort.Panic]:
    decoded: darray[u8] = decode_raw_vertex_stream("AP8=", 1, 2)
    assert decoded.count == 2
    assert decoded[0] == 0u8 and decoded[1] == 255u8


@test
def cooked_meshopt_decode_packet_uses_native_little_endian_protocol() -> void can[Memory.Allocate, Abort.Panic]:
    packet: darray[u8] = make_vertex_decode_packet([222u8, 173u8], 2u32, 2u32)
    assert packet.count == 38
    assert packet[0] == 69u8 and packet[1] == 76u8 and packet[2] == 73u8 and packet[3] == 83u8
    assert packet[4] == 65u8 and packet[5] == 83u8 and packet[6] == 67u8 and packet[7] == 49u8
    assert packet[8] == 1u8 and packet[12] == 0u8
    assert packet[16] == 1u8 and packet[20] == 2u8 and packet[24] == 2u8
    assert packet[28] == 2u8 and packet[32] == 2u8
    assert packet[36] == 222u8 and packet[37] == 173u8


@test
def cooked_meshopt_response_parser_checks_shape_and_trailing_bytes() -> void can[Memory.Allocate, Abort.Panic]:
    response: darray[u8] = meshopt_valid_response()
    decoded: darray[u8] = parse_vertex_decode_response(bytes_view(response), 2u32, 2u32)
    assert decoded.count == 4
    assert decoded[0] == 9u8 and decoded[1] == 8u8 and decoded[2] == 7u8 and decoded[3] == 6u8

    trailing: mutable darray[u8] = meshopt_valid_response()
    trailing.push(5u8)
    assert meshopt_response_rejects(trailing, MeshoptTestStreamError.InvalidDecodedPacket)

    wrong_stride: mutable darray[u8] = meshopt_valid_response()
    wrong_stride[24] <- 3u8
    assert meshopt_response_rejects(wrong_stride, MeshoptTestStreamError.DecodedPacketShapeMismatch)
