include "../../src/runtime/config_model.elisa"

using EsConfig


@test
def config_layer_duplicate_keys_are_rejected_after_ordering() -> void:
    can Memory.Allocate, Abort.Panic:
        duplicate: mutable bool = false
        catch validate_config_layers([
            ConfigLayer{source: ConfigSource.File, entries: [
                ConfigEntry{key: "zeta", value: "first"},
                ConfigEntry{key: "alpha", value: "unique"},
                ConfigEntry{key: "zeta", value: "duplicate"}
            ]}
        ]):
            ok value:
                assert false
            error failure:
                duplicate <- failure == ConfigError.DuplicateKey
        assert duplicate


@test
def config_lookup_rejects_forged_duplicate_values() -> void:
    can Memory.Allocate, Abort.Panic:
        duplicate: mutable bool = false
        catch lookup_config_value([
            ConfigValue{key: "zeta", value: "first", source: ConfigSource.File},
            ConfigValue{key: "alpha", value: "unique", source: ConfigSource.Defaults},
            ConfigValue{key: "zeta", value: "duplicate", source: ConfigSource.CommandLine}
        ], "alpha"):
            ok value:
                assert false
            error failure:
                duplicate <- failure == ConfigError.DuplicateKey
        assert duplicate


@test
def config_resolution_indexes_overrides_then_sorts_output() -> void:
    can Memory.Allocate, Abort.Panic:
        layers: darray[ConfigLayer] = [
            ConfigLayer{source: ConfigSource.Defaults, entries: [
                ConfigEntry{key: "zeta", value: "default"},
                ConfigEntry{key: "alpha", value: "first"}
            ]},
            ConfigLayer{source: ConfigSource.Environment, entries: [
                ConfigEntry{key: "zeta", value: "environment"}
            ]},
            ConfigLayer{source: ConfigSource.CommandLine, entries: [
                ConfigEntry{key: "zeta", value: "command-line"}
            ]}
        ]
        values: mutable darray[ConfigValue] = []
        catch resolve_config_layers(layers):
            ok resolved:
                values <- resolved
            error failure:
                assert false
        assert values.count == 2
        assert values[0].key == "alpha" and values[1].key == "zeta"
        assert values[1].value == "command-line" and values[1].source == ConfigSource.CommandLine
