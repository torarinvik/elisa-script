include "../../src/runtime/config_model.elisa"

using EsConfig


@test
def config_layer_duplicate_keys_are_rejected_after_ordering() -> void:
    can Memory.Allocate, Abort.Panic:
        duplicate: mutable bool = false
        catch validate_config_layers([
            ConfigLayer{source: ConfigSource.File, entries: [
                ConfigEntry{key: "zeta", value: "first"},
                ConfigEntry{key: "alpha", value: "unique"},
                ConfigEntry{key: "zeta", value: "duplicate"}
            ]}
        ]):
            ok value:
                assert false
            error failure:
                duplicate <- failure == ConfigError.DuplicateKey
        assert duplicate


@test
def config_lookup_rejects_forged_duplicate_values() -> void:
    can Memory.Allocate, Abort.Panic:
        duplicate: mutable bool = false
        catch lookup_config_value([
            ConfigValue{key: "zeta", value: "first", source: ConfigSource.File},
            ConfigValue{key: "alpha", value: "unique", source: ConfigSource.Defaults},
            ConfigValue{key: "zeta", value: "duplicate", source: ConfigSource.CommandLine}
        ], "alpha"):
            ok value:
                assert false
            error failure:
                duplicate <- failure == ConfigError.DuplicateKey
        assert duplicate
