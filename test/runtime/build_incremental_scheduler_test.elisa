include "../../src/runtime/process_model.elisa"
include "../../src/runtime/build_model.elisa"
include "../../src/runtime/build_incremental_model.elisa"
include "../../src/runtime/build_scheduler_model.elisa"

using EsProcess
using EsBuild
using EsBuildIncremental
using EsBuildScheduler


@test
def incremental_plan_filters_scheduler_cache() -> void:
    can Memory.Allocate, Abort.Panic:
        graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "compile", command: ProcessCommand{executable: "cc", arguments: []}, fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}},
            BuildNode{name: "link", command: ProcessCommand{executable: "ld", arguments: []}, dependencies: [0], fingerprint: 41, recipe_signature: BuildRecipeSignature{word0: 41}}
        ]}
        plan: BuildIncrementalPlan = BuildIncrementalPlan{
            decisions: [BuildIncrementalDecision.InputChanged, BuildIncrementalDecision.UpToDate],
            target_names: ["compile", "link"],
            recipe_fingerprints: [31, 41],
            recipe_signatures: [BuildRecipeSignature{word0: 31}, BuildRecipeSignature{word0: 41}],
            rebuild_target_indices: [0]
        }
        scheduler: mutable BuildScheduler = BuildScheduler{
            graph: graph,
            cache: [BuildCacheEntry{node_name: "compile", fingerprint: 31}, BuildCacheEntry{node_name: "link", fingerprint: 41}]
        }
        assert admit_build_incremental_plan(scheduler, plan)
        assert scheduler.cache == [BuildCacheEntry{node_name: "link", fingerprint: 41}]


@test
def incremental_plan_mismatch_preserves_scheduler_cache() -> void:
    can Memory.Allocate, Abort.Panic:
        graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "compile", command: ProcessCommand{executable: "cc", arguments: []}, fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}}
        ]}
        plan: BuildIncrementalPlan = BuildIncrementalPlan{
            decisions: [BuildIncrementalDecision.UpToDate],
            target_names: ["other"],
            recipe_fingerprints: [31],
            recipe_signatures: [BuildRecipeSignature{word0: 31}]
        }
        scheduler: mutable BuildScheduler = BuildScheduler{
            graph: graph,
            cache: [BuildCacheEntry{node_name: "compile", fingerprint: 31}]
        }
        rejected: mutable bool = false
        catch admit_build_incremental_plan(scheduler, plan):
            ok value:
                assert false
            error failure:
                rejected <- failure == BuildSchedulerError.IncrementalPlanMismatch
        assert rejected
        assert scheduler.cache.count == 1 and scheduler.cache[0].node_name == "compile"


@test
def incremental_plan_signature_mismatch_preserves_scheduler_cache() -> void:
    can Memory.Allocate, Abort.Panic:
        graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "compile", command: ProcessCommand{executable: "cc"}, fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 100}}
        ]}
        plan: BuildIncrementalPlan = BuildIncrementalPlan{
            decisions: [BuildIncrementalDecision.UpToDate],
            target_names: ["compile"],
            recipe_fingerprints: [31],
            recipe_signatures: [BuildRecipeSignature{word0: 101}]
        }
        scheduler: mutable BuildScheduler = BuildScheduler{
            graph: graph,
            cache: [BuildCacheEntry{node_name: "compile", fingerprint: 31}]
        }
        rejected: mutable bool = false
        catch admit_build_incremental_plan(scheduler, plan):
            ok value:
                assert false
            error failure:
                rejected <- failure == BuildSchedulerError.IncrementalPlanMismatch
        assert rejected
        assert scheduler.cache == [BuildCacheEntry{node_name: "compile", fingerprint: 31}]


@test
def graph_aligned_incremental_plan_reaches_scheduler() -> void:
    can Memory.Allocate, Abort.Panic:
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}, inputs: [BuildIncrementalFile{path: "src/main.c", fingerprint: 11}], outputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}]},
            BuildIncrementalTarget{name: "link", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 41, recipe_signature: BuildRecipeSignature{word0: 41}, inputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}], outputs: [BuildIncrementalFile{path: "build/app", fingerprint: 42}], dependencies: ["compile"]}
        ]
        recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}, inputs: ["src/main.c"], outputs: ["build/main.o"]},
            BuildIncrementalRecipeTarget{name: "link", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 41, recipe_signature: BuildRecipeSignature{word0: 41}, inputs: ["build/main.o"], outputs: ["build/app"], dependencies: ["compile"]}
        ]
        observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/main.c", present: true, fingerprint: 11},
            BuildIncrementalObservation{path: "build/main.o", present: true, fingerprint: 22},
            BuildIncrementalObservation{path: "build/app", present: true, fingerprint: 42}
        ]
        graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "compile", command: ProcessCommand{executable: "cc"}, fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}},
            BuildNode{name: "link", command: ProcessCommand{executable: "ld"}, dependencies: [0], fingerprint: 41, recipe_signature: BuildRecipeSignature{word0: 41}}
        ]}
        plan: BuildIncrementalPlan = plan_build_incremental_graph_transition(previous, graph, recipes, observations)
        assert plan.decisions == [BuildIncrementalDecision.UpToDate, BuildIncrementalDecision.UpToDate]
        scheduler: mutable BuildScheduler = BuildScheduler{
            graph: graph,
            cache: [BuildCacheEntry{node_name: "compile", fingerprint: 31}, BuildCacheEntry{node_name: "link", fingerprint: 41}]
        }
        assert admit_build_incremental_plan(scheduler, plan)
        assert scheduler.cache.count == 2
