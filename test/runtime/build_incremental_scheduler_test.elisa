include "../../src/ir/ir.elisa"

using EsProcess
using EsBuild
using EsBuildIncremental
using EsBuildRecipeSignature
using EsBuildIncrementalGraph
using EsBuildScheduler


@test
def graph_aligned_incremental_plan_reaches_scheduler() -> void:
    can Memory.Allocate, Abort.Panic:
        base_recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, inputs: ["src/main.c"], outputs: ["build/main.o"]},
            BuildIncrementalRecipeTarget{name: "link", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 1, inputs: ["build/main.o"], outputs: ["build/app"], dependencies: ["compile"]}
        ]
        observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/main.c", present: true, fingerprint: 11},
            BuildIncrementalObservation{path: "build/main.o", present: true, fingerprint: 22},
            BuildIncrementalObservation{path: "build/app", present: true, fingerprint: 42}
        ]
        unsigned_graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "compile", command: ProcessCommand{executable: "cc"}, fingerprint: 1},
            BuildNode{name: "link", command: ProcessCommand{executable: "ld"}, dependencies: [0], fingerprint: 1}
        ]}
        toolchains: darray[BuildRecipeToolchainIdentity] = [BuildRecipeToolchainIdentity{word0: 1}, BuildRecipeToolchainIdentity{word0: 2}]
        signed: BuildRecipeSignedGraph = sign_build_incremental_graph(unsigned_graph, base_recipes, toolchains)
        graph: BuildGraph = signed.graph
        recipes: darray[BuildIncrementalRecipeTarget] = signed.recipes
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: recipes[0].recipe_fingerprint, recipe_signature: recipes[0].recipe_signature, inputs: [BuildIncrementalFile{path: "src/main.c", fingerprint: 11}], outputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}]},
            BuildIncrementalTarget{name: "link", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: recipes[1].recipe_fingerprint, recipe_signature: recipes[1].recipe_signature, inputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}], outputs: [BuildIncrementalFile{path: "build/app", fingerprint: 42}], dependencies: ["compile"]}
        ]
        changed_graph: mutable BuildGraph = graph
        changed_node: mutable BuildNode = changed_graph.nodes[0]
        changed_command: mutable ProcessCommand = changed_node.command
        changed_command.arguments <- ["--different-command"]
        changed_node.command <- changed_command
        changed_graph.nodes[0] <- changed_node
        changed_scheduler: mutable BuildScheduler = BuildScheduler{
            graph: changed_graph,
            cache: [BuildCacheEntry{node_name: "compile", fingerprint: recipes[0].recipe_fingerprint}, BuildCacheEntry{node_name: "link", fingerprint: recipes[1].recipe_fingerprint}]
        }
        signature_mismatch_rejected: mutable bool = false
        catch admit_build_incremental_graph(changed_scheduler, previous, recipes, observations):
            ok value:
                assert false
            error failure:
                signature_mismatch_rejected <- failure == BuildIncrementalError.CurrentRecipeShapeInvalid
        assert signature_mismatch_rejected
        assert changed_scheduler.cache.count == 2
        wrong_fingerprint: mutable u64 = 1
        wrong_fingerprint <- 2 if recipes[0].recipe_fingerprint == 1
        scheduler: mutable BuildScheduler = BuildScheduler{
            graph: graph,
            cache: [BuildCacheEntry{node_name: "compile", fingerprint: wrong_fingerprint}, BuildCacheEntry{node_name: "link", fingerprint: recipes[1].recipe_fingerprint}]
        }
        plan: BuildIncrementalPlan = admit_build_incremental_graph(scheduler, previous, recipes, observations)
        assert plan.decisions == [BuildIncrementalDecision.UpToDate, BuildIncrementalDecision.UpToDate]
        assert scheduler.cache == [BuildCacheEntry{node_name: "link", fingerprint: recipes[1].recipe_fingerprint}]
