include "../../src/ir/ir.elisa"

using EsProcess
using EsBuild
using EsBuildIncremental
using EsBuildRecipeSignature
using EsBuildIncrementalGraph
using EsBuildScheduler


@test
def graph_aligned_incremental_plan_reaches_scheduler() -> void:
    can Memory.Allocate, Abort.Panic:
        base_recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, inputs: ["src/main.c"], outputs: ["build/main.o"]},
            BuildIncrementalRecipeTarget{name: "link", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 1, inputs: ["build/main.o"], outputs: ["build/app"], dependencies: ["compile"]}
        ]
        observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/main.c", present: true, fingerprint: 11},
            BuildIncrementalObservation{path: "build/main.o", present: true, fingerprint: 22},
            BuildIncrementalObservation{path: "build/app", present: true, fingerprint: 42}
        ]
        unsigned_graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "compile", command: ProcessCommand{executable: "cc", environment_mode: ProcessEnvironmentMode.Clear}, fingerprint: 1},
            BuildNode{name: "link", command: ProcessCommand{executable: "ld", environment_mode: ProcessEnvironmentMode.Clear}, dependencies: [0], fingerprint: 1}
        ]}
        toolchains: darray[BuildRecipeToolchainIdentity] = [BuildRecipeToolchainIdentity{word0: 1}, BuildRecipeToolchainIdentity{word0: 2}]
        signed: BuildRecipeSignedGraph = sign_build_incremental_graph(unsigned_graph, base_recipes, toolchains)
        graph: BuildGraph = signed.graph
        recipes: darray[BuildIncrementalRecipeTarget] = signed.recipes
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: recipes[0].recipe_fingerprint, recipe_signature: recipes[0].recipe_signature, inputs: [BuildIncrementalFile{path: "src/main.c", fingerprint: 11}], outputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}]},
            BuildIncrementalTarget{name: "link", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: recipes[1].recipe_fingerprint, recipe_signature: recipes[1].recipe_signature, inputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}], outputs: [BuildIncrementalFile{path: "build/app", fingerprint: 42}], dependencies: ["compile"]}
        ]
        changed_graph: mutable BuildGraph = graph
        changed_node: mutable BuildNode = changed_graph.nodes[0]
        changed_command: mutable ProcessCommand = changed_node.command
        changed_command.arguments <- ["--different-command"]
        changed_node.command <- changed_command
        changed_graph.nodes[0] <- changed_node
        changed_scheduler: mutable BuildScheduler = BuildScheduler{
            graph: changed_graph,
            cache: [BuildCacheEntry{node_name: "compile", fingerprint: recipes[0].recipe_fingerprint}, BuildCacheEntry{node_name: "link", fingerprint: recipes[1].recipe_fingerprint}]
        }
        signature_mismatch_rejected: mutable bool = false
        catch admit_build_incremental_graph(changed_scheduler, previous, recipes, observations):
            ok value:
                assert false
            error failure:
                signature_mismatch_rejected <- failure == BuildIncrementalError.CurrentRecipeShapeInvalid
        assert signature_mismatch_rejected
        assert changed_scheduler.cache.count == 2
        wrong_fingerprint: mutable u64 = 1
        wrong_fingerprint <- 2 if recipes[0].recipe_fingerprint == 1
        scheduler: mutable BuildScheduler = BuildScheduler{
            graph: graph,
            cache: [BuildCacheEntry{node_name: "compile", fingerprint: wrong_fingerprint}, BuildCacheEntry{node_name: "link", fingerprint: recipes[1].recipe_fingerprint}]
        }
        plan: BuildIncrementalPlan = admit_build_incremental_graph(scheduler, previous, recipes, observations)
        assert plan.decisions == [BuildIncrementalDecision.UpToDate, BuildIncrementalDecision.UpToDate]
        assert scheduler.cache == [
            BuildCacheEntry{node_name: "compile", fingerprint: recipes[0].recipe_fingerprint},
            BuildCacheEntry{node_name: "link", fingerprint: recipes[1].recipe_fingerprint}
        ]


@test
def graph_ordered_plan_produces_name_ordered_cache() -> void:
    can Memory.Allocate, Abort.Panic:
        unsigned_graph: BuildGraph = BuildGraph{nodes: [
            BuildNode{name: "z-root", command: ProcessCommand{executable: "cc"}, fingerprint: 1},
            BuildNode{name: "a-leaf", command: ProcessCommand{executable: "ld"}, dependencies: [0], fingerprint: 2}
        ]}
        recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "z-root", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, inputs: ["src/root.c"], outputs: ["build/root.o"]},
            BuildIncrementalRecipeTarget{name: "a-leaf", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 2, inputs: ["build/root.o"], outputs: ["build/leaf.o"], dependencies: ["z-root"]}
        ]
        toolchains: darray[BuildRecipeToolchainIdentity] = [BuildRecipeToolchainIdentity{word0: 11}, BuildRecipeToolchainIdentity{word0: 12}]
        signed: BuildRecipeSignedGraph = sign_build_incremental_graph(unsigned_graph, recipes, toolchains)
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "z-root", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: signed.recipes[0].recipe_fingerprint, recipe_signature: signed.recipes[0].recipe_signature, inputs: [BuildIncrementalFile{path: "src/root.c", fingerprint: 101}], outputs: [BuildIncrementalFile{path: "build/root.o", fingerprint: 201}]},
            BuildIncrementalTarget{name: "a-leaf", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: signed.recipes[1].recipe_fingerprint, recipe_signature: signed.recipes[1].recipe_signature, inputs: [BuildIncrementalFile{path: "build/root.o", fingerprint: 201}], outputs: [BuildIncrementalFile{path: "build/leaf.o", fingerprint: 301}], dependencies: ["z-root"]}
        ]
        observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/root.c", present: true, fingerprint: 101},
            BuildIncrementalObservation{path: "build/root.o", present: true, fingerprint: 201},
            BuildIncrementalObservation{path: "build/leaf.o", present: true, fingerprint: 301}
        ]
        scheduler: mutable BuildScheduler = BuildScheduler{graph: signed.graph}
        plan: BuildIncrementalPlan = admit_build_incremental_graph(scheduler, previous, signed.recipes, observations)
        assert plan.decisions == [BuildIncrementalDecision.UpToDate, BuildIncrementalDecision.UpToDate]
        assert scheduler.cache.count == 2
        assert scheduler.cache[0].node_name == "a-leaf"
        assert scheduler.cache[1].node_name == "z-root"


@test
def build_scheduler_uses_ordered_queue_membership_and_rejects_duplicates() -> void:
    can Memory.Allocate, Abort.Panic:
        compile: BuildNode = BuildNode{name: "compile", command: ProcessCommand{executable: "cc"}, fingerprint: 11}
        link: BuildNode = BuildNode{name: "link", command: ProcessCommand{executable: "ld"}, fingerprint: 12}
        package: BuildNode = BuildNode{name: "package", command: ProcessCommand{executable: "ar"}, fingerprint: 13}
        graph: BuildGraph = BuildGraph{nodes: [compile, link, package], max_parallel: 3}
        scheduler: mutable BuildScheduler = BuildScheduler{graph: graph}

        assert advance_build_scheduler(scheduler, BuildSchedulerEvent.Begin) == BuildSchedulerState.Running
        assert scheduler.ready_queue == [0, 1, 2]
        # Dispatching the final member exercises logarithmic lookup in the
        # ordered queue while retaining deterministic queue reconstruction.
        assert advance_build_scheduler(scheduler, BuildSchedulerEvent.Dispatch, 2) == BuildSchedulerState.Running
        assert scheduler.ready_queue == [0, 1]

        duplicate_graph: BuildGraph = BuildGraph{nodes: [compile, link], max_parallel: 2}
        duplicate_scheduler: mutable BuildScheduler = BuildScheduler{graph: duplicate_graph}
        assert advance_build_scheduler(duplicate_scheduler, BuildSchedulerEvent.Begin) == BuildSchedulerState.Running
        duplicate_scheduler.ready_queue <- [0, 0]
        duplicate_rejected: mutable bool = false
        catch validate_build_scheduler(duplicate_scheduler):
            ok value:
                assert false
            error failure:
                duplicate_rejected <- failure == BuildSchedulerError.DuplicateQueueEntry
        assert duplicate_rejected
