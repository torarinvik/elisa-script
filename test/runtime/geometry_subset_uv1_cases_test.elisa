include "../../src/testing/geometry_subset_uv1_cases.elisa"

using EsGeometrySubsetUv1Cases


@test
def uv1_cases_preserve_acceptance_metadata_and_python_order() -> void can[Memory.Allocate, Abort.Panic]:
    atlas_package: sview = "header=keep\r\nuv1s_meshopt_b64=encoded\r\nuv1_stride=8\r\nuv1_stride=8\r\nuv1_source=xatlas\r\nuv1_generator_revision=revision\r\nuv1_resolution=128\r\nuv1_padding=4\r\nuv1_chart_count=5\r\nuv1_chart_count=7\r\nmeshopt_codec=meshoptimizer-v1.2\r\n"
    inputs: CookedInputs = CookedInputs{
        atlas_package: atlas_package,
        skinned_package: "skinned-package=complete\nuv1_chart_count=11\n",
        invalid_uv1_stream_base64: "invalid-range-stream",
        atlas_vertex_count: 18u32,
        skinned_vertex_count: 36u32
    }
    generated: darray[Case] = try EsGeometrySubsetUv1Cases::cases(inputs)
    assert generated.count == 9

    assert generated[0].verdict == Verdict.Accept and generated[0].file_name == "uv1.pkg"
    assert bytes_view(generated[0].package_bytes) == atlas_package
    assert generated[0].loader_expectation.index_count == 18u32
    assert generated[0].loader_expectation.material_slots == 2u32
    assert generated[0].loader_expectation.subsets.count == 3
    assert generated[0].loader_expectation.subsets[0].first_index == 0u32
    assert generated[0].loader_expectation.subsets[0].material_slot == 1u32
    assert generated[0].loader_expectation.subsets[2].index_count == 6u32
    assert generated[0].loader_expectation.has_materials
    assert generated[0].loader_expectation.materials.count == 2
    assert generated[0].loader_expectation.materials[0].factors[2] == 0.08f32
    assert generated[0].loader_expectation.materials[1].factors[0] == 0.08f32
    assert generated[0].loader_expectation.has_uv1
    assert generated[0].loader_expectation.uv1.vertex_count == 18u32
    assert generated[0].loader_expectation.uv1.source == "xatlas"
    assert generated[0].loader_expectation.uv1.resolution == 128u32
    assert generated[0].loader_expectation.uv1.padding == 4u32
    assert generated[0].loader_expectation.uv1.chart_count == 7u32

    assert generated[1].verdict == Verdict.Accept and generated[1].file_name == "uv1-authored.pkg"
    assert bytes_view(generated[1].package_bytes) == "header=keep\nuv1s_meshopt_b64=encoded\nuv1_stride=8\nuv1_stride=8\nuv1_source=gltf\nmeshopt_codec=meshoptimizer-v1.2\n"
    assert generated[1].loader_expectation.uv1.source == "gltf"
    assert generated[1].loader_expectation.uv1.resolution == 0u32
    assert generated[1].loader_expectation.uv1.padding == 0u32
    assert generated[1].loader_expectation.uv1.chart_count == 0u32

    assert generated[2].verdict == Verdict.Accept and generated[2].file_name == "skinned-uv1.pkg"
    assert bytes_view(generated[2].package_bytes) == "skinned-package=complete\nuv1_chart_count=11\n"
    assert generated[2].loader_expectation.index_count == 36u32
    assert generated[2].loader_expectation.subsets.count == 5
    assert generated[2].loader_expectation.has_animations and generated[2].loader_expectation.animation_count == 1u32
    assert generated[2].loader_expectation.has_morphs and generated[2].loader_expectation.morph_count == 1u32
    assert generated[2].loader_expectation.has_inverse_binds
    assert generated[2].loader_expectation.inverse_bind_values.count == 32
    assert generated[2].loader_expectation.inverse_bind_values[12] == -2.0f32
    assert generated[2].loader_expectation.inverse_bind_values[29] == -1.0f32
    assert generated[2].loader_expectation.uv1.vertex_count == 36u32
    assert generated[2].loader_expectation.uv1.chart_count == 11u32


@test
def uv1_rejection_mutations_keep_python_order_and_normalize_package_lines() -> void can[Memory.Allocate, Abort.Panic]:
    inputs: CookedInputs = CookedInputs{
        atlas_package: "header=keep\r\nuv1s_meshopt_b64=encoded\r\nuv1_stride=8\r\nuv1_stride=8\r\nuv1_source=xatlas\r\nuv1_generator_revision=revision\r\nuv1_resolution=128\r\nuv1_padding=4\r\nuv1_chart_count=7\r\nmeshopt_codec=meshoptimizer-v1.2\r\n",
        skinned_package: "skinned-package=complete\nuv1_chart_count=11\n",
        invalid_uv1_stream_base64: "invalid-range-stream",
        atlas_vertex_count: 18u32,
        skinned_vertex_count: 36u32
    }
    generated: darray[Case] = try EsGeometrySubsetUv1Cases::cases(inputs)
    assert generated[3].file_name == "uv1-no-data.pkg"
    assert generated[3].expected_diagnostic == "incomplete cooked geometry UV1 stream"
    assert bytes_view(generated[3].package_bytes) == "header=keep\nuv1_stride=8\nuv1_stride=8\nuv1_source=xatlas\nuv1_generator_revision=revision\nuv1_resolution=128\nuv1_padding=4\nuv1_chart_count=7\nmeshopt_codec=meshoptimizer-v1.2\n"

    assert generated[4].file_name == "uv1-stride.pkg"
    assert generated[4].expected_diagnostic == "invalid cooked geometry UV1 stream"
    assert bytes_view(generated[4].package_bytes).contains("uv1_stride=16\nuv1_stride=8\n")

    assert generated[5].file_name == "uv1-source.pkg"
    assert generated[5].expected_diagnostic == "unknown cooked geometry UV1 source"
    assert bytes_view(generated[5].package_bytes).contains("uv1_source=future\n")

    assert generated[6].file_name == "uv1-revision.pkg"
    assert generated[6].expected_diagnostic == "invalid cooked geometry UV1 atlas metadata"
    assert bytes_view(generated[6].package_bytes).contains("uv1_generator_revision=unknown\n")

    assert generated[7].file_name == "uv1-atlas-range.pkg"
    assert generated[7].expected_diagnostic == "cooked geometry UV1 atlas coordinates are outside [0, 1]"
    assert bytes_view(generated[7].package_bytes).contains("uv1s_meshopt_b64=invalid-range-stream\n")
    assert not bytes_view(generated[7].package_bytes).contains("uv1s_meshopt_b64=encoded")

    assert generated[8].file_name == "uv1-corrupt-encoded.pkg"
    assert generated[8].expected_diagnostic == "invalid cooked geometry UV1 stream"
    assert bytes_view(generated[8].package_bytes).contains("uv1s_meshopt_b64=AA==\n")


@test
def uv1_mutations_append_missing_fields_and_add_meshopt_declaration() -> void can[Memory.Allocate, Abort.Panic]:
    inputs: CookedInputs = CookedInputs{
        atlas_package: "uv1s_meshopt_b64=encoded\nheader=only\r\nuv1_chart_count=7\n",
        skinned_package: "skinned=complete\nuv1_chart_count=11\n",
        invalid_uv1_stream_base64: "range",
        atlas_vertex_count: 18u32,
        skinned_vertex_count: 36u32
    }
    generated: darray[Case] = try EsGeometrySubsetUv1Cases::cases(inputs)
    assert bytes_view(generated[3].package_bytes) == "header=only\nuv1_chart_count=7\n"
    assert bytes_view(generated[4].package_bytes) == "uv1s_meshopt_b64=encoded\nheader=only\nuv1_chart_count=7\nuv1_stride=16\n"
    assert bytes_view(generated[5].package_bytes) == "uv1s_meshopt_b64=encoded\nheader=only\nuv1_chart_count=7\nuv1_source=future\n"
    assert bytes_view(generated[6].package_bytes) == "uv1s_meshopt_b64=encoded\nheader=only\nuv1_chart_count=7\nuv1_generator_revision=unknown\n"
    assert bytes_view(generated[7].package_bytes) == "header=only\nuv1_chart_count=7\nmeshopt_codec=meshoptimizer-v1.2\nuv1s_meshopt_b64=range\n"
    assert bytes_view(generated[8].package_bytes) == "uv1s_meshopt_b64=AA==\nheader=only\nuv1_chart_count=7\n"


@test
def uv1_mutations_reject_invalid_atlas_encoding_non_ascii_and_oversized_inputs() -> void can[Memory.Allocate, Abort.Panic]:
    non_ascii: CookedInputs = CookedInputs{
        atlas_package: "header=\xff\nuv1s_meshopt_b64=encoded\n",
        skinned_package: "skinned=complete\nuv1_chart_count=11\n",
        invalid_uv1_stream_base64: "stream",
        atlas_vertex_count: 18u32,
        skinned_vertex_count: 36u32
    }
    non_ascii_rejected: mutable bool = false
    catch EsGeometrySubsetUv1Cases::cases(non_ascii):
        ok generated:
            _ = generated
        error failure:
            non_ascii_rejected <- failure == Uv1CasesError.NonAsciiPackage
    assert non_ascii_rejected

    invalid_encoding: CookedInputs = CookedInputs{
        atlas_package: "uv1s_b64=raw\n",
        skinned_package: "skinned=complete\nuv1_chart_count=11\n",
        invalid_uv1_stream_base64: "stream",
        atlas_vertex_count: 18u32,
        skinned_vertex_count: 36u32
    }
    encoding_rejected: mutable bool = false
    catch EsGeometrySubsetUv1Cases::cases(invalid_encoding):
        ok generated:
            _ = generated
        error failure:
            encoding_rejected <- failure == Uv1CasesError.AtlasEncodingMismatch
    assert encoding_rejected

    missing_count: CookedInputs = CookedInputs{
        atlas_package: "uv1s_meshopt_b64=encoded\n",
        skinned_package: "uv1_chart_count=11\n",
        invalid_uv1_stream_base64: "stream",
        atlas_vertex_count: 18u32,
        skinned_vertex_count: 36u32
    }
    count_rejected: mutable bool = false
    catch EsGeometrySubsetUv1Cases::cases(missing_count):
        ok generated:
            _ = generated
        error failure:
            count_rejected <- failure == Uv1CasesError.MissingExpectedField
    assert count_rejected

    invalid_chart_count: CookedInputs = CookedInputs{
        atlas_package: "uv1s_meshopt_b64=encoded\nuv1_chart_count=not-a-number\n",
        skinned_package: "uv1_chart_count=11\n",
        invalid_uv1_stream_base64: "stream",
        atlas_vertex_count: 18u32,
        skinned_vertex_count: 36u32
    }
    chart_value_rejected: mutable bool = false
    catch EsGeometrySubsetUv1Cases::cases(invalid_chart_count):
        ok generated:
            _ = generated
        error failure:
            chart_value_rejected <- failure == Uv1CasesError.InvalidExpectedChartCount
    assert chart_value_rejected

    oversized: mutable darray[u8] = []
    oversized.reserve(16777217)
    for _ in 0..<16777217 |oversized|:
        oversized.push(97u8)
    too_large: CookedInputs = CookedInputs{
        atlas_package: bytes_view(oversized),
        skinned_package: "skinned=complete\n",
        invalid_uv1_stream_base64: "stream",
        atlas_vertex_count: 18u32,
        skinned_vertex_count: 36u32
    }
    too_large_rejected: mutable bool = false
    catch EsGeometrySubsetUv1Cases::cases(too_large):
        ok generated:
            _ = generated
        error failure:
            too_large_rejected <- failure == Uv1CasesError.PackageTooLarge
    assert too_large_rejected
