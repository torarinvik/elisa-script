include "../../src/testing/geometry_subset_uv1_cases.elisa"

using EsGeometrySubsetUv1Cases


@test
def uv1_rejection_mutations_keep_python_order_and_normalize_package_lines() -> void can[Memory.Allocate, Abort.Panic]:
    atlas_package: sview = "header=keep\r\nuv1s_b64=raw\r\nuv1s_meshopt_b64=encoded\r\nuv1_stride=8\r\nuv1_stride=8\r\nuv1_source=xatlas\r\nuv1_generator_revision=revision\r\nmeshopt_codec=meshoptimizer-v1.2\r\n"
    generated: darray[Case] = try EsGeometrySubsetUv1Cases::cases(atlas_package, "invalid-range-stream")
    assert generated.count == 6

    assert generated[0].file_name == "uv1-no-data.pkg"
    assert generated[0].expected_diagnostic == "incomplete cooked geometry UV1 stream"
    assert bytes_view(generated[0].package_bytes) == "header=keep\nuv1_stride=8\nuv1_stride=8\nuv1_source=xatlas\nuv1_generator_revision=revision\nmeshopt_codec=meshoptimizer-v1.2\n"

    assert generated[1].file_name == "uv1-stride.pkg"
    assert generated[1].expected_diagnostic == "invalid cooked geometry UV1 stream"
    assert bytes_view(generated[1].package_bytes).contains("uv1_stride=16\nuv1_stride=8\n")

    assert generated[2].file_name == "uv1-source.pkg"
    assert generated[2].expected_diagnostic == "unknown cooked geometry UV1 source"
    assert bytes_view(generated[2].package_bytes).contains("uv1_source=future\n")

    assert generated[3].file_name == "uv1-revision.pkg"
    assert generated[3].expected_diagnostic == "invalid cooked geometry UV1 atlas metadata"
    assert bytes_view(generated[3].package_bytes).contains("uv1_generator_revision=unknown\n")

    assert generated[4].file_name == "uv1-atlas-range.pkg"
    assert generated[4].expected_diagnostic == "cooked geometry UV1 atlas coordinates are outside [0, 1]"
    assert bytes_view(generated[4].package_bytes).contains("uv1s_meshopt_b64=invalid-range-stream\n")
    assert not bytes_view(generated[4].package_bytes).contains("uv1s_b64=")
    assert not bytes_view(generated[4].package_bytes).contains("uv1s_meshopt_b64=encoded")

    assert generated[5].file_name == "uv1-corrupt-encoded.pkg"
    assert generated[5].expected_diagnostic == "invalid cooked geometry UV1 stream"
    assert bytes_view(generated[5].package_bytes).contains("uv1s_meshopt_b64=AA==\n")


@test
def uv1_mutations_append_missing_fields_and_add_meshopt_declaration() -> void can[Memory.Allocate, Abort.Panic]:
    generated: darray[Case] = try EsGeometrySubsetUv1Cases::cases("header=only\r\n", "range")
    assert bytes_view(generated[0].package_bytes) == "header=only\n"
    assert bytes_view(generated[1].package_bytes) == "header=only\nuv1_stride=16\n"
    assert bytes_view(generated[2].package_bytes) == "header=only\nuv1_source=future\n"
    assert bytes_view(generated[3].package_bytes) == "header=only\nuv1_generator_revision=unknown\n"
    assert bytes_view(generated[4].package_bytes) == "header=only\nmeshopt_codec=meshoptimizer-v1.2\nuv1s_meshopt_b64=range\n"
    assert bytes_view(generated[5].package_bytes) == "header=only\nuv1s_meshopt_b64=AA==\n"


@test
def uv1_mutations_reject_non_ascii_and_oversized_inputs() -> void can[Memory.Allocate, Abort.Panic]:
    non_ascii_rejected: mutable bool = false
    catch EsGeometrySubsetUv1Cases::cases("header=\xff", "stream"):
        ok generated:
            _ = generated
        error failure:
            non_ascii_rejected <- failure == Uv1CasesError.NonAsciiPackage
    assert non_ascii_rejected

    oversized: mutable darray[u8] = []
    oversized.reserve(16777217)
    for _ in 0..<16777217 |oversized|:
        oversized.push(97u8)
    too_large_rejected: mutable bool = false
    catch EsGeometrySubsetUv1Cases::cases(bytes_view(oversized), "stream"):
        ok generated:
            _ = generated
        error failure:
            too_large_rejected <- failure == Uv1CasesError.PackageTooLarge
    assert too_large_rejected
