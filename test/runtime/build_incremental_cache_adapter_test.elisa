include "../../src/ir/ir.elisa"

using EsArtifactCache
using EsBuild
using EsBuildIncremental
using EsBuildIncrementalCache
using EsRuntime


@test
def incremental_cache_descriptor_io_rejects_invalid_directory_handles() -> void:
    can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        arena: mutable Arena = Arena{begin: null, end: null, end_index: 0, strategy: 0}
        read_rejected: mutable bool = false
        catch read_build_incremental_cache_at(arena, -1, "cache.bin"):
            ok bytes:
                read_rejected <- false
            error failure:
                read_rejected <- failure == FileIoError.ReadFailed("cache.bin")
        assert read_rejected

        targets: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1, recipe_signature: BuildRecipeSignature{word0: 1}, inputs: [BuildIncrementalFile{path: "src/main.c", fingerprint: 2}], outputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 3}]}
        ]
        bytes: mutable darray[u8] = encode_build_incremental_cache(targets)
        lock: mutable ArtifactCacheWriterLock = ArtifactCacheWriterLock{}
        write_rejected: mutable bool = false
        catch publish_build_incremental_cache_at_locked(arena, lock, -1, "cache.lock", 7, "cache.tmp", "cache.bin", bytes):
            ok publication:
                write_rejected <- false
            error failure:
                write_rejected <- failure == ArtifactCacheIoError.InvalidDirectoryDescriptor
        assert write_rejected

        unrelated_lock: mutable ArtifactCacheWriterLock = ArtifactCacheWriterLock{state: ArtifactCacheWriterLockState.Held, owner_token: 7, path: "other.lock", descriptor: 99}
        held_publish_rejected: mutable bool = false
        catch publish_build_incremental_cache_at_held(arena, unrelated_lock, -1, "cache.lock", 7, "cache.tmp", "cache.bin", bytes):
            ok publication:
                assert false
            error failure:
                held_publish_rejected <- failure == ArtifactCacheIoError.LockFailed("cache.lock")
        assert held_publish_rejected

        held_read_rejected: mutable bool = false
        catch read_build_incremental_cache_at_held(arena, unrelated_lock, -1, "cache.lock", 7, "cache.bin"):
            ok cached_bytes:
                assert false
            error failure:
                held_read_rejected <- failure == ArtifactCacheIoError.LockFailed("cache.lock")
        assert held_read_rejected
