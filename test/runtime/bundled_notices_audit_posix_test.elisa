include "../../ports/elisa-engine/scripts/bundled_notices_audit_posix.elisa"

using EsEngineBundledNoticesAudit
using EsEngineBundledNoticesAuditPosix
using EsEngineBundledNoticesJson
using EsJson


def bundled_notice_test_audit_bundle(app: Path, catalog_path: Path) -> AuditedBundle can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console.Format]:
    result: mutable AuditedBundle = AuditedBundle{report: Report{}, catalog_owner: DecodedCatalog{catalog: Catalog{}, document: JsonDocument{}}}
    catch audit_bundle(app, catalog_path):
        ok value:
            result <- value
        error failure:
            _ = failure
    return result


@test
def bundled_notice_filesystem_adapter_preserves_nested_python_glob_matching() -> void can[Directory.Read, Directory.Write, File.Read, File.Write, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console.Format]:
    temporary: Path = try temp_directory("elisascript-bundled-notices") else failure:
        _ = failure
        assert false
        return
    app: Path = temporary.joinpath("Sample.app")
    frameworks: Path = app.joinpath("Contents/Frameworks")
    nested_notices: Path = app.joinpath("Contents/Resources/Notices/Nested")
    catalog_path: Path = temporary.joinpath("notice-sources.json")
    dylib_path: Path = frameworks.joinpath("libsample.dylib")
    notice_path: Path = nested_notices.joinpath("License1.txt")

    frameworks_created: bool = try create_directories(frameworks) else false
    notices_created: bool = try create_directories(nested_notices) else false
    dylib_written: usize = try write_bytes(dylib_path, [1u8]) else 0usize
    notice_contents: mutable darray[u8] = [108u8, 105u8, 99u8, 101u8, 110u8, 115u8, 101u8]
    notice_written: usize = try write_bytes(notice_path, notice_contents) else 0usize
    digest: mutable darray[u8] = []
    catch digest_hex(notice_contents):
        ok value:
            digest <- value
        error failure:
            _ = failure
    catalog_text: sview = "{\"complete\":true,\"sources\":[{\"name\":\"License[1]\",\"excerpt\":{\"sha256\":\"" + bytes_view(digest) + "\"}}],\"bundled_libraries\":{\"libsample.dylib\":{\"notices\":[\"License[1]\"]}}}"
    catalog_written: usize = try write_text(catalog_path, catalog_text) else 0usize

    result: mutable AuditedBundle = AuditedBundle{report: Report{}, catalog_owner: DecodedCatalog{catalog: Catalog{}, document: JsonDocument{}}}
    audit_succeeded: mutable bool = false
    if frameworks_created and notices_created and dylib_written == 1 and notice_written == notice_contents.count and catalog_written == catalog_text.count:
        catch audit_bundle(app, catalog_path):
            ok value:
                result <- value
                audit_succeeded <- true
            error failure:
                _ = failure
    removed: bool = try remove_tree(temporary) else false
    report: Report = result.report
    assert audit_succeeded
    assert report.catalog_complete
    assert report.dylib_notice_files_verified
    assert report.libraries.count == 1
    assert report.libraries[0].notices == ["License[1]"]
    assert report.libraries[0].problems.count == 0
    assert removed


@test
def bundled_notice_filesystem_adapter_matches_missing_tampered_and_unmapped_python_cases() -> void can[Directory.Read, Directory.Write, File.Read, File.Write, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console.Format]:
    temporary: Path = try temp_directory("elisascript-bundled-notices-cases") else failure:
        _ = failure
        assert false
        return
    app: Path = temporary.joinpath("Fixture.app")
    frameworks: Path = app.joinpath("Contents/Frameworks")
    notices: Path = app.joinpath("Contents/Resources/Notices")
    catalog_path: Path = temporary.joinpath("notice-sources.json")
    library_path: Path = frameworks.joinpath("libexample.dylib")
    unknown_library_path: Path = frameworks.joinpath("libunknown.dylib")
    notice_path: Path = notices.joinpath("Example.txt")

    frameworks_created: bool = try create_directories(frameworks) else false
    notices_created: bool = try create_directories(notices) else false
    library_written: usize = try write_bytes(library_path, [102u8]) else 0usize
    notice_contents: mutable darray[u8] = [110u8, 111u8, 116u8, 105u8, 99u8, 101u8]
    digest: mutable darray[u8] = []
    catch digest_hex(notice_contents):
        ok value:
            digest <- value
        error failure:
            _ = failure
    catalog_text: sview = "{\"sources\":[{\"name\":\"Example\",\"sha256\":\"" + bytes_view(digest) + "\"}],\"complete\":false,\"bundled_libraries\":{\"libexample.dylib\":{\"notices\":[\"Example\"]}}}"
    catalog_written: usize = try write_text(catalog_path, catalog_text) else 0usize
    setup_ok: bool = frameworks_created and notices_created and library_written == 1 and catalog_written == catalog_text.count
    missing_bundle: mutable AuditedBundle = AuditedBundle{report: Report{}, catalog_owner: DecodedCatalog{catalog: Catalog{}, document: JsonDocument{}}}
    missing_ok: mutable bool = false
    if setup_ok:
        missing_bundle <- bundled_notice_test_audit_bundle(app, catalog_path)
        missing_report: Report = missing_bundle.report
        missing_ok <- missing_bundle.catalog_owner.document.state == JsonDocumentState.Sealed and not missing_report.dylib_notice_files_verified and not missing_report.catalog_complete and missing_report.libraries.count == 1 and missing_report.libraries[0].problems == ["notice Example is missing or ambiguous"]

    matching_bundle: mutable AuditedBundle = AuditedBundle{report: Report{}, catalog_owner: DecodedCatalog{catalog: Catalog{}, document: JsonDocument{}}}
    matching_ok: mutable bool = false
    notice_written: mutable usize = 0
    if setup_ok and missing_ok:
        notice_written <- try write_bytes(notice_path, notice_contents) else 0usize
        if notice_written == notice_contents.count:
            matching_bundle <- bundled_notice_test_audit_bundle(app, catalog_path)
            matching_ok <- matching_bundle.catalog_owner.document.state == JsonDocumentState.Sealed and matching_bundle.report.dylib_notice_files_verified and not matching_bundle.report.catalog_complete and matching_bundle.report.libraries[0].problems.count == 0

    tampered_bundle: mutable AuditedBundle = AuditedBundle{report: Report{}, catalog_owner: DecodedCatalog{catalog: Catalog{}, document: JsonDocument{}}}
    tampered_ok: mutable bool = false
    tampered_written: usize = 0
    if setup_ok and matching_ok:
        tampered_written <- try write_bytes(notice_path, [109u8, 111u8, 100u8, 105u8, 102u8, 105u8, 101u8, 100u8]) else 0usize
        if tampered_written == 8:
            tampered_bundle <- bundled_notice_test_audit_bundle(app, catalog_path)
            tampered_ok <- tampered_bundle.catalog_owner.document.state == JsonDocumentState.Sealed and not tampered_bundle.report.dylib_notice_files_verified and tampered_bundle.report.libraries[0].problems == ["notice Example differs from the catalog"]

    unmapped_bundle: mutable AuditedBundle = AuditedBundle{report: Report{}, catalog_owner: DecodedCatalog{catalog: Catalog{}, document: JsonDocument{}}}
    unmapped_ok: mutable bool = false
    restored: mutable usize = 0
    unknown_written: mutable usize = 0
    if setup_ok and tampered_ok:
        restored <- try write_bytes(notice_path, notice_contents) else 0usize
        if restored == notice_contents.count:
            unknown_written <- try write_bytes(unknown_library_path, [110u8]) else 0usize
            if unknown_written == 1:
                unmapped_bundle <- bundled_notice_test_audit_bundle(app, catalog_path)
                unmapped_report: Report = unmapped_bundle.report
                unmapped_ok <- unmapped_bundle.catalog_owner.document.state == JsonDocumentState.Sealed and not unmapped_report.dylib_notice_files_verified and unmapped_report.libraries.count == 2 and unmapped_report.libraries[1].library == "libunknown.dylib" and unmapped_report.libraries[1].problems == ["library has no notice mapping"]
    removed: bool = try remove_tree(temporary) else false
    assert setup_ok and missing_ok and notice_written == notice_contents.count
    assert matching_ok and tampered_written == 8 and tampered_ok
    assert restored == notice_contents.count and unknown_written == 1 and unmapped_ok and removed
