include "../../ports/elisa-engine/scripts/bundled_notices_audit_posix.elisa"

using EsEngineBundledNoticesAudit
using EsEngineBundledNoticesAuditPosix


@test
def bundled_notice_filesystem_adapter_preserves_nested_python_glob_matching() -> void can[Directory.Read, Directory.Write, File.Read, File.Write, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console.Format]:
    temporary: Path = try temp_directory("elisascript-bundled-notices") else failure:
        _ = failure
        assert false
        return
    app: Path = temporary.joinpath("Sample.app")
    frameworks: Path = app.joinpath("Contents/Frameworks")
    nested_notices: Path = app.joinpath("Contents/Resources/Notices/Nested")
    catalog_path: Path = temporary.joinpath("notice-sources.json")
    dylib_path: Path = frameworks.joinpath("libsample.dylib")
    notice_path: Path = nested_notices.joinpath("License1.txt")

    frameworks_created: bool = try create_directories(frameworks) else false
    notices_created: bool = try create_directories(nested_notices) else false
    dylib_written: usize = try write_bytes(dylib_path, [1u8]) else 0usize
    notice_contents: mutable darray[u8] = [108u8, 105u8, 99u8, 101u8, 110u8, 115u8, 101u8]
    notice_written: usize = try write_bytes(notice_path, notice_contents) else 0usize
    digest: mutable darray[u8] = []
    catch digest_hex(notice_contents):
        ok value:
            digest <- value
        error failure:
            _ = failure
    catalog_text: sview = "{\"complete\":true,\"sources\":[{\"name\":\"License[1]\",\"excerpt\":{\"sha256\":\"" + bytes_view(digest) + "\"}}],\"bundled_libraries\":{\"libsample.dylib\":{\"notices\":[\"License[1]\"]}}}"
    catalog_written: usize = try write_text(catalog_path, catalog_text) else 0usize

    result: mutable AuditedBundle = AuditedBundle{report: Report{}, catalog_owner: DecodedCatalog{catalog: Catalog{}, document: JsonDocument{}}}
    audit_succeeded: mutable bool = false
    if frameworks_created and notices_created and dylib_written == 1 and notice_written == notice_contents.count and catalog_written == catalog_text.count:
        catch audit_bundle(app, catalog_path):
            ok value:
                result <- value
                audit_succeeded <- true
            error failure:
                _ = failure
    removed: bool = try remove_tree(temporary) else false
    report: Report = result.report
    assert audit_succeeded
    assert report.catalog_complete
    assert report.dylib_notice_files_verified
    assert report.libraries.count == 1
    assert report.libraries[0].notices == ["License[1]"]
    assert report.libraries[0].problems.count == 0
    assert removed
