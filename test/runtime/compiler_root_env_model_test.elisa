# Pure selection fixtures; they neither source Bash nor inspect directories.
include "../../src/runtime/compiler_root_env_model.elisa"

module EsCompilerRootEnvFixture:
    public:
        @test
        def compiler_root_defaults_only_for_unset_or_empty_override() -> void:
            can Memory.Allocate, Abort.Panic:
                defaulted: sview = try EsCompilerRootEnv::select("/projects/Elisa-LSP", "") else err:
                    assert false
                    return
                assert defaulted == "/projects/Elisa-LSP/../Elisa-compiler"
                relative: sview = try EsCompilerRootEnv::select("/projects/Elisa-LSP", "../Elisa-compiler") else err:
                    assert false
                    return
                assert relative == "../Elisa-compiler"
                missing: sview = try EsCompilerRootEnv::select("/projects/Elisa-LSP", "/missing $HOME; *.elisa") else err:
                    assert false
                    return
                assert missing == "/missing $HOME; *.elisa"
                with_trailing_separator: sview = try EsCompilerRootEnv::select("/projects/Elisa-LSP/", "") else err:
                    assert false
                    return
                assert with_trailing_separator == "/projects/Elisa-LSP//../Elisa-compiler"


        @test
        def compiler_root_budget_and_nul_are_typed_errors_not_absence() -> void:
            can Memory.Allocate, Abort.Panic:
                bytes: mutable darray[u8] = []
                bytes.reserve(EsCompilerRootEnv::Limits::PATH_BYTES)
                for _ in 0..<(EsCompilerRootEnv::Limits::PATH_BYTES - 1) |bytes|:
                    bytes.push(120u8)
                boundary: sview = try EsCompilerRootEnv::select("/lsp", bytes_view(bytes)) else err:
                    assert false
                    return
                assert len(boundary) == EsCompilerRootEnv::Limits::PATH_BYTES - 1
                bytes.push(120u8)
                too_long: mutable bool = false
                catch EsCompilerRootEnv::select("/lsp", bytes_view(bytes)):
                    ok _:
                        assert false
                    error failure:
                        too_long <- failure == EsCompilerRootEnv::RootError.PathLimit
                assert too_long
                bytes[0] <- 0u8
                oversized_with_nul: mutable bool = false
                catch EsCompilerRootEnv::select("/lsp", bytes_view(bytes)):
                    ok _:
                        assert false
                    error failure:
                        oversized_with_nul <- failure == EsCompilerRootEnv::RootError.PathLimit
                assert oversized_with_nul
                in_budget_nul: mutable bool = false
                catch EsCompilerRootEnv::select("/lsp", "x\0y"):
                    ok _:
                        assert false
                    error failure:
                        in_budget_nul <- failure == EsCompilerRootEnv::RootError.EmbeddedNul
                assert in_budget_nul
                default_root: mutable darray[u8] = []
                default_root.reserve(EsCompilerRootEnv::Limits::PATH_BYTES)
                for index in 0..<4077 |default_root|:
                    default_root.push(47u8 if index == 0 else 120u8)
                max_default: sview = try EsCompilerRootEnv::select(bytes_view(default_root), "") else err:
                    assert false
                    return
                assert len(max_default) == EsCompilerRootEnv::Limits::PATH_BYTES - 1
                default_root.push(120u8)
                default_overflow: mutable bool = false
                catch EsCompilerRootEnv::select(bytes_view(default_root), ""):
                    ok _:
                        assert false
                    error failure:
                        default_overflow <- failure == EsCompilerRootEnv::RootError.PathLimit
                assert default_overflow
