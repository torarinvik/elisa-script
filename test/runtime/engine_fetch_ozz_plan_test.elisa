include "../../ports/elisa-engine/scripts/fetch_ozz_plan.elisa"

using EsEngineFetchOzzPlan


@test
def ozz_fetch_plan_pins_tagged_clone_and_revision_commands() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    checkout: Path = path("/fixture/dependencies/ozz with spaces")
    clone: Command = clone_command(checkout)
    revision: Command = revision_command(checkout)
    assert clone.program == "git"
    assert clone.arguments == ["clone", "--branch", Dependency::TAG, "--depth", "1", Dependency::REPOSITORY, f"{checkout}"]
    assert revision.program == "git"
    assert revision.arguments == ["-C", f"{checkout}", "rev-parse", "HEAD"]
    assert command_text(revision) == "git -C /fixture/dependencies/ozz with spaces rev-parse HEAD"


@test
def ozz_fetch_plan_pins_disabled_tools_samples_howtos_and_tests() -> void can[Memory.Allocate, Abort.Panic, Console.Format]:
    checkout: Path = path("/fixture/dependencies/ozz")
    build: Path = checkout.joinpath("build")
    configure: Command = configure_command(checkout, build)
    compile: Command = build_command(build)
    assert configure.program == "cmake"
    assert configure.arguments == [
        "-S", f"{checkout}", "-B", f"{build}", "-DCMAKE_BUILD_TYPE=Release",
        "-Dozz_build_tools=OFF", "-Dozz_build_samples=OFF", "-Dozz_build_howtos=OFF",
        "-Dozz_build_tests=OFF"
    ]
    assert compile.program == "cmake"
    assert compile.arguments == ["--build", f"{build}", "--target", "ozz_animation", "ozz_animation_offline"]
    assert Dependency::TAG == "0.16.0"
    assert Dependency::COMMIT == "6cbdc790123aa4731d82e255df187b3a8a808256"
    assert Dependency::BUILD_RELATIVE_PATH == "dependencies/ozz/build"
    assert Dependency::BASE_LIBRARY == "src/base/libozz_base_r.a"
    assert Dependency::ANIMATION_LIBRARY == "src/animation/runtime/libozz_animation_r.a"
    assert Dependency::OFFLINE_LIBRARY == "src/animation/offline/libozz_animation_offline_r.a"
