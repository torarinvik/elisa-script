include "../../src/runtime/regex_callback_model.elisa"

using EsRegexCallback


@test
def regex_callback_rejects_match_count_without_span_progress() -> void:
    can Memory.Allocate, Abort.Panic:
        forged: RegexCallbackSession = RegexCallbackSession{
            policy: RegexCallbackPolicy{},
            input_bytes: 3,
            state: RegexCallbackState.Matching,
            matches: 1
        }
        rejected: mutable bool = false
        catch validate_regex_callback(forged):
            ok value:
                assert false
            error failure:
                rejected <- failure == RegexCallbackError.AccountingInvalid
        assert rejected


@test
def regex_callback_rejects_forged_pending_prefix_accounting() -> void:
    can Memory.Allocate, Abort.Panic:
        forged: RegexCallbackSession = RegexCallbackSession{
            policy: RegexCallbackPolicy{},
            input_bytes: 5,
            state: RegexCallbackState.Matching,
            matches: 1,
            pending: true,
            pending_start: 3,
            pending_end: 4
        }
        rejected: mutable bool = false
        catch validate_regex_callback(forged):
            ok value:
                assert false
            error failure:
                rejected <- failure == RegexCallbackError.AccountingInvalid
        assert rejected

        overcounted: RegexCallbackSession = RegexCallbackSession{
            policy: RegexCallbackPolicy{},
            input_bytes: 5,
            state: RegexCallbackState.Matching,
            matches: 1,
            pending: true,
            pending_start: 3,
            pending_end: 4,
            output_bytes: 4
        }
        overcount_rejected: mutable bool = false
        catch validate_regex_callback(overcounted):
            ok value:
                assert false
            error failure:
                overcount_rejected <- failure == RegexCallbackError.AccountingInvalid
        assert overcount_rejected

        valid: mutable RegexCallbackSession = RegexCallbackSession{policy: RegexCallbackPolicy{}, input_bytes: 5}
        _ = advance_regex_callback(valid, RegexCallbackEvent.Begin)
        _ = advance_regex_callback(valid, RegexCallbackEvent.Match, 3, 4)
        assert valid.output_bytes == 3 and validate_regex_callback(valid)
        _ = advance_regex_callback(valid, RegexCallbackEvent.Replace, replacement_bytes: 1)
        assert advance_regex_callback(valid, RegexCallbackEvent.End) == RegexCallbackState.Complete
        assert valid.output_bytes == valid.input_bytes


@test
def regex_callback_rejects_zero_width_marker_ahead_of_cursor() -> void:
    can Memory.Allocate, Abort.Panic:
        forged: RegexCallbackSession = RegexCallbackSession{
            policy: RegexCallbackPolicy{},
            input_bytes: 3,
            state: RegexCallbackState.Matching,
            cursor: 1,
            matches: 1,
            has_last_zero: true,
            last_zero_start: 1
        }
        rejected: mutable bool = false
        catch validate_regex_callback(forged):
            ok value:
                assert false
            error failure:
                rejected <- failure == RegexCallbackError.AccountingInvalid
        assert rejected


@test
def regex_callback_accepts_empty_input_zero_width_match_at_eof() -> void:
    can Memory.Allocate, Abort.Panic:
        session: mutable RegexCallbackSession = RegexCallbackSession{policy: RegexCallbackPolicy{}, input_bytes: 0}
        _ = advance_regex_callback(session, RegexCallbackEvent.Begin)
        _ = advance_regex_callback(session, RegexCallbackEvent.Match, 0, 0)
        _ = advance_regex_callback(session, RegexCallbackEvent.Replace)
        assert validate_regex_callback(session)
        assert advance_regex_callback(session, RegexCallbackEvent.End) == RegexCallbackState.Complete


@test
def regex_callback_abort_clears_unconsumed_zero_width_match() -> void:
    can Memory.Allocate, Abort.Panic:
        failed: mutable RegexCallbackSession = RegexCallbackSession{policy: RegexCallbackPolicy{}, input_bytes: 3}
        _ = advance_regex_callback(failed, RegexCallbackEvent.Begin)
        _ = advance_regex_callback(failed, RegexCallbackEvent.Match, 1, 1)
        assert failed.pending and failed.has_last_zero and failed.output_bytes == 1
        assert advance_regex_callback(failed, RegexCallbackEvent.Fail) == RegexCallbackState.Failed
        assert failed.cursor == 1
        assert not failed.pending and not failed.has_last_zero
        assert failed.pending_start == 0 and failed.pending_end == 0 and failed.last_zero_start == 0
        assert validate_regex_callback(failed)

        cancelled: mutable RegexCallbackSession = RegexCallbackSession{policy: RegexCallbackPolicy{}, input_bytes: 3}
        _ = advance_regex_callback(cancelled, RegexCallbackEvent.Begin)
        _ = advance_regex_callback(cancelled, RegexCallbackEvent.Match, 1, 1)
        assert cancelled.pending and cancelled.has_last_zero and cancelled.output_bytes == 1
        assert advance_regex_callback(cancelled, RegexCallbackEvent.Cancel) == RegexCallbackState.Cancelled
        assert cancelled.cursor == 1
        assert not cancelled.pending and not cancelled.has_last_zero
        assert cancelled.pending_start == 0 and cancelled.pending_end == 0 and cancelled.last_zero_start == 0
        assert validate_regex_callback(cancelled)


@test
def regex_callback_rejects_incomplete_no_match_output_accounting() -> void:
    can Memory.Allocate, Abort.Panic:
        forged: RegexCallbackSession = RegexCallbackSession{
            policy: RegexCallbackPolicy{},
            input_bytes: 5,
            state: RegexCallbackState.Complete,
            cursor: 5,
            output_bytes: 4
        }
        rejected: mutable bool = false
        catch validate_regex_callback(forged):
            ok value:
                assert false
            error failure:
                rejected <- failure == RegexCallbackError.AccountingInvalid
        assert rejected

        no_match: mutable RegexCallbackSession = RegexCallbackSession{policy: RegexCallbackPolicy{}, input_bytes: 5}
        _ = advance_regex_callback(no_match, RegexCallbackEvent.Begin)
        assert advance_regex_callback(no_match, RegexCallbackEvent.End) == RegexCallbackState.Complete
        assert no_match.output_bytes == no_match.input_bytes


@test
def regex_callback_rejects_forged_completed_output_accounting() -> void:
    can Memory.Allocate, Abort.Panic:
        forged: RegexCallbackSession = RegexCallbackSession{
            policy: RegexCallbackPolicy{},
            input_bytes: 5,
            state: RegexCallbackState.Complete,
            cursor: 5,
            matches: 1,
            output_bytes: 3,
            replaced_input_bytes: 2,
            replacement_total_bytes: 1
        }
        rejected: mutable bool = false
        catch validate_regex_callback(forged):
            ok value:
                assert false
            error failure:
                rejected <- failure == RegexCallbackError.AccountingInvalid
        assert rejected

        valid: RegexCallbackSession = RegexCallbackSession{
            policy: RegexCallbackPolicy{},
            input_bytes: 5,
            state: RegexCallbackState.Complete,
            cursor: 5,
            matches: 1,
            output_bytes: 4,
            replaced_input_bytes: 2,
            replacement_total_bytes: 1
        }
        assert validate_regex_callback(valid)


@test
def regex_callback_uses_matcher_supplied_zero_width_advance() -> void:
    can Memory.Allocate, Abort.Panic:
        session: mutable RegexCallbackSession = RegexCallbackSession{policy: RegexCallbackPolicy{}, input_bytes: 6}
        _ = advance_regex_callback(session, RegexCallbackEvent.Begin)
        _ = advance_regex_callback(session, RegexCallbackEvent.Match, 0, 0)
        _ = advance_regex_callback(session, RegexCallbackEvent.Replace, zero_width_advance_bytes: 2)
        assert session.cursor == 2 and session.output_bytes == 2
        _ = advance_regex_callback(session, RegexCallbackEvent.Match, 2, 2)
        _ = advance_regex_callback(session, RegexCallbackEvent.Replace, replacement_bytes: 1, zero_width_advance_bytes: 4)
        assert session.cursor == 6 and session.output_bytes == 7
        assert advance_regex_callback(session, RegexCallbackEvent.End) == RegexCallbackState.Complete
        assert session.output_bytes == 7


@test
def regex_callback_rejects_missing_or_oversized_zero_width_advance() -> void:
    can Memory.Allocate, Abort.Panic:
        missing_progress: mutable RegexCallbackSession = RegexCallbackSession{policy: RegexCallbackPolicy{}, input_bytes: 2}
        _ = advance_regex_callback(missing_progress, RegexCallbackEvent.Begin)
        _ = advance_regex_callback(missing_progress, RegexCallbackEvent.Match, 0, 0)
        missing_rejected: mutable bool = false
        catch advance_regex_callback(missing_progress, RegexCallbackEvent.Replace):
            ok value:
                assert false
            error failure:
                missing_rejected <- failure == RegexCallbackError.NonProgress
        assert missing_rejected and missing_progress.pending

        oversized_progress: mutable RegexCallbackSession = RegexCallbackSession{policy: RegexCallbackPolicy{}, input_bytes: 2}
        _ = advance_regex_callback(oversized_progress, RegexCallbackEvent.Begin)
        _ = advance_regex_callback(oversized_progress, RegexCallbackEvent.Match, 1, 1)
        oversized_rejected: mutable bool = false
        catch advance_regex_callback(oversized_progress, RegexCallbackEvent.Replace, zero_width_advance_bytes: 2):
            ok value:
                assert false
            error failure:
                oversized_rejected <- failure == RegexCallbackError.SpanInvalid
        assert oversized_rejected and oversized_progress.pending

        nonempty_match: mutable RegexCallbackSession = RegexCallbackSession{policy: RegexCallbackPolicy{}, input_bytes: 2}
        _ = advance_regex_callback(nonempty_match, RegexCallbackEvent.Begin)
        _ = advance_regex_callback(nonempty_match, RegexCallbackEvent.Match, 0, 1)
        progress_on_nonempty_rejected: mutable bool = false
        catch advance_regex_callback(nonempty_match, RegexCallbackEvent.Replace, zero_width_advance_bytes: 1):
            ok value:
                assert false
            error failure:
                progress_on_nonempty_rejected <- failure == RegexCallbackError.InvalidEventPayload
        assert progress_on_nonempty_rejected and nonempty_match.pending


@test
def regex_callback_rejects_irrelevant_event_payloads() -> void:
    can Memory.Allocate, Abort.Panic:
        begin_session: mutable RegexCallbackSession = RegexCallbackSession{policy: RegexCallbackPolicy{}, input_bytes: 2}
        begin_rejected: mutable bool = false
        catch advance_regex_callback(begin_session, RegexCallbackEvent.Begin, 1):
            ok value:
                assert false
            error failure:
                begin_rejected <- failure == RegexCallbackError.InvalidEventPayload
        assert begin_rejected

        _ = advance_regex_callback(begin_session, RegexCallbackEvent.Begin)
        _ = advance_regex_callback(begin_session, RegexCallbackEvent.Match, 0, 1)
        replace_rejected: mutable bool = false
        catch advance_regex_callback(begin_session, RegexCallbackEvent.Replace, 1, 1, 1, 1):
            ok value:
                assert false
            error failure:
                replace_rejected <- failure == RegexCallbackError.InvalidEventPayload
        assert replace_rejected


@test
def regex_callback_rejects_terminal_progress_before_first_match() -> void:
    can Memory.Allocate, Abort.Panic:
        forged_failure: RegexCallbackSession = RegexCallbackSession{
            policy: RegexCallbackPolicy{},
            input_bytes: 3,
            state: RegexCallbackState.Failed,
            cursor: 1,
            output_bytes: 1
        }
        failed_progress_rejected: mutable bool = false
        catch validate_regex_callback(forged_failure):
            ok value:
                assert false
            error failure:
                failed_progress_rejected <- failure == RegexCallbackError.AccountingInvalid
        assert failed_progress_rejected

        forged_cancellation: RegexCallbackSession = RegexCallbackSession{
            policy: RegexCallbackPolicy{},
            input_bytes: 3,
            state: RegexCallbackState.Cancelled,
            cursor: 1,
            output_bytes: 1
        }
        cancelled_progress_rejected: mutable bool = false
        catch validate_regex_callback(forged_cancellation):
            ok value:
                assert false
            error failure:
                cancelled_progress_rejected <- failure == RegexCallbackError.AccountingInvalid
        assert cancelled_progress_rejected

        failed_before_match: mutable RegexCallbackSession = RegexCallbackSession{policy: RegexCallbackPolicy{}, input_bytes: 3}
        _ = advance_regex_callback(failed_before_match, RegexCallbackEvent.Begin)
        assert advance_regex_callback(failed_before_match, RegexCallbackEvent.Fail) == RegexCallbackState.Failed
        assert validate_regex_callback(failed_before_match)

        cancelled_before_match: mutable RegexCallbackSession = RegexCallbackSession{policy: RegexCallbackPolicy{}, input_bytes: 3}
        _ = advance_regex_callback(cancelled_before_match, RegexCallbackEvent.Begin)
        assert advance_regex_callback(cancelled_before_match, RegexCallbackEvent.Cancel) == RegexCallbackState.Cancelled
        assert validate_regex_callback(cancelled_before_match)
