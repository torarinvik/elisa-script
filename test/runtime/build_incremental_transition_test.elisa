include "../../src/runtime/build_incremental_model.elisa"

using EsBuild
using EsBuildIncremental


@test
def build_incremental_compares_every_sha256_word() -> void:
    can Memory.Allocate, Abort.Panic:
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}, inputs: [BuildIncrementalFile{path: "src/main.c", fingerprint: 11, fingerprint_word1: 12, fingerprint_word2: 13, fingerprint_word3: 14}], outputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 21, fingerprint_word1: 22, fingerprint_word2: 23, fingerprint_word3: 24}]}
        ]
        current: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}, inputs: ["src/main.c"], outputs: ["build/main.o"]}
        ]
        observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/main.c", present: true, fingerprint: 11, fingerprint_word1: 99, fingerprint_word2: 13, fingerprint_word3: 14},
            BuildIncrementalObservation{path: "build/main.o", present: true, fingerprint: 21, fingerprint_word1: 22, fingerprint_word2: 23, fingerprint_word3: 24}
        ]
        plan: BuildIncrementalPlan = plan_build_incremental_transition(previous, current, observations)
        assert plan.decisions == [BuildIncrementalDecision.InputChanged]


@test
def build_incremental_distinguishes_missing_and_changed_generated_outputs() -> void:
    can Memory.Allocate, Abort.Panic:
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{
                name: "generate-config-header",
                kind: BuildIncrementalTargetKind.GeneratedFile,
                recipe_fingerprint: 31,
                recipe_signature: BuildRecipeSignature{word0: 31},
                inputs: [BuildIncrementalFile{path: "include/generated_build_config.h.in", fingerprint: 11}],
                outputs: [BuildIncrementalFile{path: "build/generated_build_config.h", fingerprint: 22}]
            },
            BuildIncrementalTarget{
                name: "compile-main",
                kind: BuildIncrementalTargetKind.GeneratedFile,
                recipe_fingerprint: 41,
                recipe_signature: BuildRecipeSignature{word0: 41},
                inputs: [BuildIncrementalFile{path: "build/generated_build_config.h", fingerprint: 22}],
                outputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 33}],
                dependencies: ["generate-config-header"]
            }
        ]
        current: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{
                name: "generate-config-header",
                kind: BuildIncrementalTargetKind.GeneratedFile,
                recipe_fingerprint: 31,
                recipe_signature: BuildRecipeSignature{word0: 31},
                inputs: ["include/generated_build_config.h.in"],
                outputs: ["build/generated_build_config.h"]
            },
            BuildIncrementalRecipeTarget{
                name: "compile-main",
                kind: BuildIncrementalTargetKind.GeneratedFile,
                recipe_fingerprint: 41,
                recipe_signature: BuildRecipeSignature{word0: 41},
                inputs: ["build/generated_build_config.h"],
                outputs: ["build/main.o"],
                dependencies: ["generate-config-header"]
            }
        ]
        changed_output_observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "include/generated_build_config.h.in", present: true, fingerprint: 11},
            BuildIncrementalObservation{path: "build/generated_build_config.h", present: true, fingerprint: 23},
            BuildIncrementalObservation{path: "build/main.o", present: true, fingerprint: 33}
        ]
        changed_output: BuildIncrementalPlan = plan_build_incremental_transition(previous, current, changed_output_observations)
        assert changed_output.decisions == [BuildIncrementalDecision.OutputChanged, BuildIncrementalDecision.DependencyDirty]

        missing_output_observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "include/generated_build_config.h.in", present: true, fingerprint: 11},
            BuildIncrementalObservation{path: "build/generated_build_config.h", present: false},
            BuildIncrementalObservation{path: "build/main.o", present: true, fingerprint: 33}
        ]
        missing_output: BuildIncrementalPlan = plan_build_incremental_transition(previous, current, missing_output_observations)
        assert missing_output.decisions == [BuildIncrementalDecision.OutputMissing, BuildIncrementalDecision.DependencyDirty]


@test
def build_incremental_generated_header_changes_rebuild_only_its_w07_dependents() -> void:
    can Memory.Allocate, Abort.Panic:
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "generate-config-header", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}, inputs: [BuildIncrementalFile{path: "include/generated_build_config.h.in", fingerprint: 11}], outputs: [BuildIncrementalFile{path: "build/generated_build_config.h", fingerprint: 22}]},
            BuildIncrementalTarget{name: "compile-answer", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 41, recipe_signature: BuildRecipeSignature{word0: 41}, inputs: [BuildIncrementalFile{path: "src/answer.c", fingerprint: 13}], outputs: [BuildIncrementalFile{path: "build/answer.o", fingerprint: 32}]},
            BuildIncrementalTarget{name: "archive-answer", kind: BuildIncrementalTargetKind.StaticLibrary, recipe_fingerprint: 51, recipe_signature: BuildRecipeSignature{word0: 51}, inputs: [BuildIncrementalFile{path: "build/answer.o", fingerprint: 32}], outputs: [BuildIncrementalFile{path: "build/libminimal-answer.a", fingerprint: 42}], dependencies: ["compile-answer"]},
            BuildIncrementalTarget{name: "compile-main", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 61, recipe_signature: BuildRecipeSignature{word0: 61}, inputs: [BuildIncrementalFile{path: "src/main.c", fingerprint: 17}, BuildIncrementalFile{path: "build/generated_build_config.h", fingerprint: 22}], outputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 52}], dependencies: ["generate-config-header"]},
            BuildIncrementalTarget{name: "minimal-native", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 71, recipe_signature: BuildRecipeSignature{word0: 71}, inputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 52}, BuildIncrementalFile{path: "build/libminimal-answer.a", fingerprint: 42}], outputs: [BuildIncrementalFile{path: "build/minimal-native", fingerprint: 62}], dependencies: ["archive-answer", "compile-main"]},
            BuildIncrementalTarget{name: "run-minimal-native", kind: BuildIncrementalTargetKind.Phony, recipe_fingerprint: 81, recipe_signature: BuildRecipeSignature{word0: 81}, dependencies: ["minimal-native"]}
        ]
        current: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "generate-config-header", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}, inputs: ["include/generated_build_config.h.in"], outputs: ["build/generated_build_config.h"]},
            BuildIncrementalRecipeTarget{name: "compile-answer", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 41, recipe_signature: BuildRecipeSignature{word0: 41}, inputs: ["src/answer.c"], outputs: ["build/answer.o"]},
            BuildIncrementalRecipeTarget{name: "archive-answer", kind: BuildIncrementalTargetKind.StaticLibrary, recipe_fingerprint: 51, recipe_signature: BuildRecipeSignature{word0: 51}, inputs: ["build/answer.o"], outputs: ["build/libminimal-answer.a"], dependencies: ["compile-answer"]},
            BuildIncrementalRecipeTarget{name: "compile-main", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 61, recipe_signature: BuildRecipeSignature{word0: 61}, inputs: ["src/main.c", "build/generated_build_config.h"], outputs: ["build/main.o"], dependencies: ["generate-config-header"]},
            BuildIncrementalRecipeTarget{name: "minimal-native", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 71, recipe_signature: BuildRecipeSignature{word0: 71}, inputs: ["build/main.o", "build/libminimal-answer.a"], outputs: ["build/minimal-native"], dependencies: ["archive-answer", "compile-main"]},
            BuildIncrementalRecipeTarget{name: "run-minimal-native", kind: BuildIncrementalTargetKind.Phony, recipe_fingerprint: 81, recipe_signature: BuildRecipeSignature{word0: 81}, dependencies: ["minimal-native"]}
        ]
        changed_header_observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "include/generated_build_config.h.in", present: true, fingerprint: 11},
            BuildIncrementalObservation{path: "build/generated_build_config.h", present: true, fingerprint: 23},
            BuildIncrementalObservation{path: "src/answer.c", present: true, fingerprint: 13},
            BuildIncrementalObservation{path: "build/answer.o", present: true, fingerprint: 32},
            BuildIncrementalObservation{path: "build/libminimal-answer.a", present: true, fingerprint: 42},
            BuildIncrementalObservation{path: "src/main.c", present: true, fingerprint: 17},
            BuildIncrementalObservation{path: "build/main.o", present: true, fingerprint: 52},
            BuildIncrementalObservation{path: "build/minimal-native", present: true, fingerprint: 62}
        ]
        changed_header: BuildIncrementalPlan = plan_build_incremental_transition(previous, current, changed_header_observations)
        expected_decisions: darray[BuildIncrementalDecision] = [BuildIncrementalDecision.OutputChanged, BuildIncrementalDecision.UpToDate, BuildIncrementalDecision.UpToDate, BuildIncrementalDecision.DependencyDirty, BuildIncrementalDecision.DependencyDirty, BuildIncrementalDecision.DependencyDirty]
        assert changed_header.decisions == expected_decisions
        assert changed_header.rebuild_target_indices == [0, 3, 4, 5]

        missing_header_observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "include/generated_build_config.h.in", present: true, fingerprint: 11},
            BuildIncrementalObservation{path: "build/generated_build_config.h", present: false},
            BuildIncrementalObservation{path: "src/answer.c", present: true, fingerprint: 13},
            BuildIncrementalObservation{path: "build/answer.o", present: true, fingerprint: 32},
            BuildIncrementalObservation{path: "build/libminimal-answer.a", present: true, fingerprint: 42},
            BuildIncrementalObservation{path: "src/main.c", present: true, fingerprint: 17},
            BuildIncrementalObservation{path: "build/main.o", present: true, fingerprint: 52},
            BuildIncrementalObservation{path: "build/minimal-native", present: true, fingerprint: 62}
        ]
        missing_header: BuildIncrementalPlan = plan_build_incremental_transition(previous, current, missing_header_observations)
        expected_missing_decisions: darray[BuildIncrementalDecision] = [BuildIncrementalDecision.OutputMissing, BuildIncrementalDecision.UpToDate, BuildIncrementalDecision.UpToDate, BuildIncrementalDecision.DependencyDirty, BuildIncrementalDecision.DependencyDirty, BuildIncrementalDecision.DependencyDirty]
        assert missing_header.decisions == expected_missing_decisions
        assert missing_header.rebuild_target_indices == [0, 3, 4, 5]


@test
def build_incremental_transition_rebuilds_changed_and_new_targets() -> void:
    can Memory.Allocate, Abort.Panic:
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{
                name: "compile",
                kind: BuildIncrementalTargetKind.GeneratedFile,
                recipe_fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31},
                inputs: [BuildIncrementalFile{path: "src/main.c", fingerprint: 11}],
                outputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}]
            },
            BuildIncrementalTarget{
                name: "link",
                kind: BuildIncrementalTargetKind.Executable,
                recipe_fingerprint: 41, recipe_signature: BuildRecipeSignature{word0: 41},
                inputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}],
                outputs: [BuildIncrementalFile{path: "build/app", fingerprint: 42}],
                dependencies: ["compile"]
            }
        ]
        current: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}, inputs: ["src/main.c"], outputs: ["build/main.o"]},
            BuildIncrementalRecipeTarget{name: "link", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 41, recipe_signature: BuildRecipeSignature{word0: 41}, inputs: ["build/main.o"], outputs: ["build/app"], dependencies: ["compile"]}
        ]
        observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/main.c", present: true, fingerprint: 11},
            BuildIncrementalObservation{path: "build/main.o", present: true, fingerprint: 22},
            BuildIncrementalObservation{path: "build/app", present: true, fingerprint: 42}
        ]
        no_op: BuildIncrementalPlan = plan_build_incremental_transition(previous, current, observations)
        assert no_op.decisions == [BuildIncrementalDecision.UpToDate, BuildIncrementalDecision.UpToDate]
        assert no_op.rebuild_target_indices.count == 0 and no_op.stale_outputs_after_success.count == 0

        changed_current: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 32, recipe_signature: BuildRecipeSignature{word0: 32}, inputs: ["src/main.c"], outputs: ["build/main.o"]},
            current[1]
        ]
        changed: BuildIncrementalPlan = plan_build_incremental_transition(previous, changed_current, observations)
        assert changed.decisions == [BuildIncrementalDecision.RecipeChanged, BuildIncrementalDecision.DependencyDirty]
        assert changed.rebuild_target_indices == [0, 1]

        with_new_target: darray[BuildIncrementalRecipeTarget] = [
            current[0],
            current[1],
            BuildIncrementalRecipeTarget{name: "smoke", kind: BuildIncrementalTargetKind.Phony, recipe_fingerprint: 51, recipe_signature: BuildRecipeSignature{word0: 51}, dependencies: ["link"]}
        ]
        added: BuildIncrementalPlan = plan_build_incremental_transition(previous, with_new_target, observations)
        assert added.decisions == [BuildIncrementalDecision.UpToDate, BuildIncrementalDecision.UpToDate, BuildIncrementalDecision.RecipeChanged]
        assert added.rebuild_target_indices == [2]


@test
def build_incremental_transition_rebuilds_on_signature_change_without_scalar_change() -> void:
    can Memory.Allocate, Abort.Panic:
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}, inputs: [BuildIncrementalFile{path: "src/main.c", fingerprint: 11}], outputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}]}
        ]
        current: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 30, word1: 1}, inputs: ["src/main.c"], outputs: ["build/main.o"]}
        ]
        observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/main.c", present: true, fingerprint: 11},
            BuildIncrementalObservation{path: "build/main.o", present: true, fingerprint: 22}
        ]
        plan: BuildIncrementalPlan = plan_build_incremental_transition(previous, current, observations)
        assert plan.recipe_fingerprints == [31]
        assert plan.decisions == [BuildIncrementalDecision.RecipeChanged]


@test
def build_incremental_observation_paths_are_unique_and_sorted() -> void:
    can Memory.Allocate, Abort.Panic:
        recipes: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}, inputs: ["src/main.c", "include/base.h"], outputs: ["build/main.o"]},
            BuildIncrementalRecipeTarget{name: "link", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 41, recipe_signature: BuildRecipeSignature{word0: 41}, inputs: ["build/main.o", "include/base.h"], outputs: ["build/app"], dependencies: ["compile"]},
            BuildIncrementalRecipeTarget{name: "check", kind: BuildIncrementalTargetKind.Phony, recipe_fingerprint: 51, recipe_signature: BuildRecipeSignature{word0: 51}, dependencies: ["link"]}
        ]
        paths: darray[sview] = build_incremental_observation_paths(recipes)
        assert paths == ["build/app", "build/main.o", "include/base.h", "src/main.c"]
        assert build_incremental_observation_paths([]).count == 0


@test
def build_incremental_manifest_rejects_unsafe_relative_paths() -> void:
    can Memory.Allocate, Abort.Panic:
        invalid_paths: darray[sview] = ["/absolute/input", "\\absolute\\input", "C:/absolute/input", "C:drive-relative", "src\\..\\outside", "../outside", "src/../outside", "src//input", "./input", "src/.", "src/..", "src/"]
        for path in invalid_paths |path|:
            rejected: mutable bool = false
            catch validate_build_incremental_manifest([
                BuildIncrementalTarget{
                    name: "compile",
                    kind: BuildIncrementalTargetKind.GeneratedFile,
                    recipe_fingerprint: 1, recipe_signature: BuildRecipeSignature{word0: 1},
                    inputs: [BuildIncrementalFile{path: path, fingerprint: 2}],
                    outputs: [BuildIncrementalFile{path: "build/output", fingerprint: 3}]
                }
            ]):
                ok value:
                    assert false
                error failure:
                    rejected <- failure == BuildIncrementalError.InvalidPath
            assert rejected


@test
def build_incremental_transition_plans_removed_outputs_only_after_success() -> void:
    can Memory.Allocate, Abort.Panic:
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}, inputs: [BuildIncrementalFile{path: "src/main.c", fingerprint: 11}], outputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}]},
            BuildIncrementalTarget{name: "link", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 41, recipe_signature: BuildRecipeSignature{word0: 41}, inputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}], outputs: [BuildIncrementalFile{path: "build/app", fingerprint: 42}], dependencies: ["compile"]}
        ]
        current: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}, inputs: ["src/main.c"], outputs: ["build/main.o"]}
        ]
        observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/main.c", present: true, fingerprint: 11},
            BuildIncrementalObservation{path: "build/main.o", present: true, fingerprint: 22}
        ]
        plan: BuildIncrementalPlan = plan_build_incremental_transition(previous, current, observations)
        assert plan.decisions == [BuildIncrementalDecision.UpToDate]
        assert plan.rebuild_target_indices.count == 0
        assert plan.stale_outputs_after_success.count == 1
        assert plan.stale_outputs_after_success[0].target_name == "link"
        assert plan.stale_outputs_after_success[0].output.path == "build/app"


@test
def build_incremental_success_commit_is_complete_and_atomic() -> void:
    can Memory.Allocate, Abort.Panic:
        previous: darray[BuildIncrementalTarget] = [
            BuildIncrementalTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 31, recipe_signature: BuildRecipeSignature{word0: 31}, inputs: [BuildIncrementalFile{path: "src/main.c", fingerprint: 11}], outputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}]},
            BuildIncrementalTarget{name: "link", kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 41, recipe_signature: BuildRecipeSignature{word0: 41}, inputs: [BuildIncrementalFile{path: "build/main.o", fingerprint: 22}], outputs: [BuildIncrementalFile{path: "build/app", fingerprint: 42}], dependencies: ["compile"]}
        ]
        current: darray[BuildIncrementalRecipeTarget] = [
            BuildIncrementalRecipeTarget{name: "compile", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 32, recipe_signature: BuildRecipeSignature{word0: 32}, inputs: ["src/main.c"], outputs: ["build/main.o"]}
        ]
        complete_observations: darray[BuildIncrementalObservation] = [
            BuildIncrementalObservation{path: "src/main.c", present: true, fingerprint: 11},
            BuildIncrementalObservation{path: "build/main.o", present: true, fingerprint: 23}
        ]
        committed: BuildIncrementalCommit = commit_build_incremental_success(previous, current, complete_observations)
        assert committed.targets.count == 1
        assert committed.targets[0].recipe_fingerprint == 32
        assert committed.targets[0].inputs[0].fingerprint == 11
        assert committed.targets[0].outputs[0].fingerprint == 23
        assert committed.stale_outputs_after_success.count == 1
        assert committed.stale_outputs_after_success[0].output.path == "build/app"

        commit_rejected: mutable bool = false
        catch commit_build_incremental_success(previous, current, [complete_observations[0]]):
            ok value:
                assert false
            error failure:
                commit_rejected <- failure == BuildIncrementalError.ObservationSetMismatch
        assert commit_rejected

        extra_observations: darray[BuildIncrementalObservation] = [
            complete_observations[0],
            complete_observations[1],
            BuildIncrementalObservation{path: "unrelated.txt", present: true, fingerprint: 99}
        ]
        plan_rejected: mutable bool = false
        catch plan_build_incremental_transition([], current, extra_observations):
            ok value:
                assert false
            error failure:
                plan_rejected <- failure == BuildIncrementalError.ObservationSetMismatch
        assert plan_rejected
