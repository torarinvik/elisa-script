include "../../ports/elisa-engine/scripts/gltf_node_streams_model.elisa"

using EsEngineGltfAffine
using EsEngineGltfNodeStreams


@test
def gltf_node_stream_transforms_points_and_vectors_as_little_endian_float3() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    source: darray[u8] = [0u8, 0u8, 128u8, 63u8, 0u8, 0u8, 0u8, 64u8, 0u8, 0u8, 64u8, 64u8]
    matrix: Affine3x4 = Affine3x4{m00: 2.0, m11: 3.0, m22: 4.0, m03: 10.0, m13: 20.0, m23: 30.0}
    points: darray[u8] = try transform_points(source, matrix)
    assert points == [0u8, 0u8, 64u8, 65u8, 0u8, 0u8, 208u8, 65u8, 0u8, 0u8, 40u8, 66u8]

    vectors: darray[u8] = try transform_vectors(source, matrix)
    assert vectors == [0u8, 0u8, 0u8, 64u8, 0u8, 0u8, 192u8, 64u8, 0u8, 0u8, 64u8, 65u8]

    identity: Affine3x4 = gltf_node_stream_identity()
    malformed: darray[u8] = [7u8]
    assert transform_points(malformed, identity) == malformed
    assert gltf_node_stream_rejects_points(malformed, matrix, NodeStreamError.InvalidFloat3ByteCount)


@test
def gltf_node_stream_transforms_normal_deltas_and_renormalizes_normals() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    x_axis: darray[u8] = [0u8, 0u8, 128u8, 63u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    scaled: Affine3x4 = Affine3x4{m00: 2.0, m11: 3.0, m22: 4.0}
    deltas: darray[u8] = try transform_normal_deltas(x_axis, scaled)
    assert deltas == [0u8, 0u8, 64u8, 65u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    normals: darray[u8] = try transform_normals(x_axis, scaled)
    assert normals == x_axis

    singular: Affine3x4 = Affine3x4{m00: 1.0}
    assert gltf_node_stream_rejects_normals(x_axis, singular, NodeStreamError.ZeroTransformedNormal)


@test
def gltf_node_stream_mirroring_swaps_triangle_winding_and_float32_packing_is_bounded() -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    mirrored: Affine3x4 = Affine3x4{m00: -1.0, m11: 1.0, m22: 1.0}
    indices: darray[u32] = [0u32, 1u32, 2u32, 3u32, 4u32, 5u32]
    assert placed_indices(indices, mirrored) == [0u32, 2u32, 1u32, 3u32, 5u32, 4u32]

    packed: darray[u8] = try packed_float3(Vec3{x: 1.0, y: -2.0, z: 0.5})
    assert packed == [0u8, 0u8, 128u8, 63u8, 0u8, 0u8, 0u8, 192u8, 0u8, 0u8, 0u8, 63u8]
    assert gltf_node_stream_pack_rejects(Vec3{x: 4.0e38}, NodeStreamError.OutsideFloat32Range)
    too_large: darray[u8] = [255u8, 255u8, 127u8, 127u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    assert gltf_node_stream_rejects_points(too_large, Affine3x4{m00: 2.0, m11: 1.0, m22: 1.0}, NodeStreamError.OutsideFloat32Range)


def gltf_node_stream_identity() -> Affine3x4:
    return Affine3x4{m00: 1.0, m11: 1.0, m22: 1.0}


def gltf_node_stream_rejects_points(data: darray[u8], matrix: Affine3x4, expected: NodeStreamError) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    rejected: mutable bool = false
    catch transform_points(data, matrix):
        ok output:
            _ = output
        error failure:
            rejected <- failure == expected
    return rejected


def gltf_node_stream_rejects_normals(data: darray[u8], matrix: Affine3x4, expected: NodeStreamError) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    rejected: mutable bool = false
    catch transform_normals(data, matrix):
        ok output:
            _ = output
        error failure:
            rejected <- failure == expected
    return rejected


def gltf_node_stream_pack_rejects(values: Vec3, expected: NodeStreamError) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    rejected: mutable bool = false
    catch packed_float3(values):
        ok output:
            _ = output
        error failure:
            rejected <- failure == expected
    return rejected
