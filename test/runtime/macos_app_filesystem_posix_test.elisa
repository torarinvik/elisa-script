include "../../src/runtime/macos_app_manifest_model.elisa"
include "../../src/runtime/macos_app_filesystem_posix.elisa"

using EsMacosAppManifest
using EsMacosAppFilesystem


def macos_app_test_bytes(value: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    bytes: mutable darray[u8] = []
    for byte in value |bytes|:
        bytes.push(byte)
    return bytes


def macos_app_notice_is_rejected(project: Path, selection: MacosAppPathSelection) -> bool can[Blocking.IO, File.Read, Directory.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    rejected: mutable bool = false
    catch validate_macos_app_notice_files(project, selection):
        ok valid:
            _ = valid
        error failure:
            rejected <- failure == MacosAppFilesystemError.NoticeRejected
    return rejected


def macos_app_resource_is_rejected(project: Path, selection: MacosAppPathSelection) -> bool can[Blocking.IO, File.Read, Directory.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    rejected: mutable bool = false
    catch validate_macos_app_resource_inputs(project, selection):
        ok valid:
            _ = valid
        error failure:
            rejected <- failure == MacosAppFilesystemError.ResourceRejected
    return rejected


@test
def notice_validation_requires_an_in_project_nonempty_file() -> void can[Blocking.IO, File.Read, File.Write, Directory.Read, Directory.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    temporary: Path = try temp_directory("macos-app-notice-validation") else err:
        assert false
        return
    nonempty_path: Path = temporary.joinpath("NOTICE")
    empty_path: Path = temporary.joinpath("EMPTY-NOTICE")
    missing_path: Path = temporary.joinpath("MISSING-NOTICE")
    nonempty_selection: MacosAppPathSelection = MacosAppPathSelection{notice_paths: [macos_app_test_bytes("NOTICE")]}
    empty_selection: MacosAppPathSelection = MacosAppPathSelection{notice_paths: [macos_app_test_bytes("EMPTY-NOTICE")]}
    missing_selection: MacosAppPathSelection = MacosAppPathSelection{notice_paths: [macos_app_test_bytes("MISSING-NOTICE")]}

    wrote_nonempty: bool = (try write_text(nonempty_path, "license terms") else 0usize) == 13
    accepted_nonempty: bool = false
    if wrote_nonempty:
        catch validate_macos_app_notice_files(temporary, nonempty_selection):
            ok accepted:
                accepted_nonempty <- accepted
            error _:
                accepted_nonempty <- false

    _ = try write_text(empty_path, "") else 1usize
    empty_rejected: bool = macos_app_notice_is_rejected(temporary, empty_selection)
    missing_rejected: bool = macos_app_notice_is_rejected(temporary, missing_selection)
    removed_nonempty: bool = try remove_path(nonempty_path) else false
    removed_empty: bool = try remove_path(empty_path) else false
    removed_directory: bool = try remove_directory(temporary) else false
    assert wrote_nonempty and accepted_nonempty and empty_rejected and missing_rejected
    assert removed_nonempty and removed_empty and removed_directory


@test
def explicit_resources_require_a_non_symlink_file_or_directory() -> void can[Blocking.IO, File.Read, File.Write, Directory.Read, Directory.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    temporary: Path = try temp_directory("macos-app-resource-validation") else err:
        assert false
        return
    file_path: Path = temporary.joinpath("asset.bin")
    directory_path: Path = temporary.joinpath("assets")
    symlink_path_value: Path = temporary.joinpath("linked-asset")
    all_assets_selection: MacosAppPathSelection = MacosAppPathSelection{}
    file_selection: MacosAppPathSelection = MacosAppPathSelection{resource_mode: MacosResourceMode.ExplicitPaths, resource_paths: [macos_app_test_bytes("asset.bin")]}
    directory_selection: MacosAppPathSelection = MacosAppPathSelection{resource_mode: MacosResourceMode.ExplicitPaths, resource_paths: [macos_app_test_bytes("assets")]}
    missing_selection: MacosAppPathSelection = MacosAppPathSelection{resource_mode: MacosResourceMode.ExplicitPaths, resource_paths: [macos_app_test_bytes("missing")]}
    symlink_selection: MacosAppPathSelection = MacosAppPathSelection{resource_mode: MacosResourceMode.ExplicitPaths, resource_paths: [macos_app_test_bytes("linked-asset")]}

    wrote_file: bool = (try write_text(file_path, "asset") else 0usize) == 5
    missing_default_assets_rejected: bool = macos_app_resource_is_rejected(temporary, all_assets_selection)
    made_directory: bool = try create_directories(directory_path) else false
    made_symlink: bool = try symlink(file_path, symlink_path_value) else false
    file_accepted: mutable bool = false
    directory_accepted: mutable bool = false
    if wrote_file:
        catch validate_macos_app_resource_inputs(temporary, file_selection):
            ok accepted:
                file_accepted <- accepted
            error _:
                file_accepted <- false
    if made_directory:
        catch validate_macos_app_resource_inputs(temporary, all_assets_selection):
            ok accepted:
                directory_accepted <- accepted
            error _:
                directory_accepted <- false
        catch validate_macos_app_resource_inputs(temporary, directory_selection):
            ok accepted:
                directory_accepted <- directory_accepted and accepted
            error _:
                directory_accepted <- false

    missing_rejected: bool = macos_app_resource_is_rejected(temporary, missing_selection)
    symlink_rejected: bool = macos_app_resource_is_rejected(temporary, symlink_selection)
    removed_symlink: bool = try remove_path(symlink_path_value) else false
    removed_file: bool = try remove_path(file_path) else false
    removed_directory: bool = try remove_directory(directory_path) else false
    removed_temporary: bool = try remove_directory(temporary) else false
    assert wrote_file and made_directory and made_symlink
    assert missing_default_assets_rejected and file_accepted and directory_accepted
    assert missing_rejected and symlink_rejected
    assert removed_symlink and removed_file and removed_directory and removed_temporary
