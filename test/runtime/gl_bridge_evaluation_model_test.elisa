include "../../src/runtime/encoding.elisa"
include "../../src/runtime/data_model.elisa"
include "../../src/runtime/json_model.elisa"
include "../../src/runtime/json_lexer_model.elisa"
include "../../src/runtime/json_parse_model.elisa"
include "../../src/runtime/python_json_projection.elisa"
include "../../src/runtime/gl_bridge_evaluation_model.elisa"

using EsGlBridgeEvaluation


const module GlBridgeEvaluationInputs:
    VALID: sview = "{\"schema\":\"wasmbrowser.gl_bridge_evaluation.v1\",\"status\":\"unselected\",\"current_consumer\":{\"name\":\"none\",\"guest_gl_requirement\":\"none\"},\"required_contract\":{\"guest_function_abi\":\"ABI\",\"handle_model\":\"handles\",\"buffer_validation\":\"bounds\",\"context_lifetime\":\"lifecycle\",\"thread_affinity\":\"owner\",\"synchronization\":\"fences\",\"error_semantics\":\"errors\",\"quotas\":\"limits\",\"host_availability\":\"targets\"},\"required_fixture\":{\"status\":\"blocked_missing_pinned_consumer\",\"cases\":[\"context\"],\"platforms\":[\"desktop GL\",\"GLES/EGL\"]}}"
    CONTRACT: sview = "## Guest ABI and dispatch\n## Handles and buffers\n## Lifetime and thread affinity\n## Errors\n## Quotas\n## Host backend availability\n## Required guest-path fixture\nno GL bridge selected\n"


def gl_bridge_evaluation_rejects_as(source: sview, contract: sview, expected: GlBridgeEvaluationError) -> bool can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch validate_gl_bridge_evaluation_sources(source, contract):
        ok valid:
            rejected <- not valid
        error failure:
            rejected <- failure == expected
    return rejected


@test
def gl_bridge_evaluation_accepts_unselected_contract_and_fixture_prerequisite() -> void can[Memory.Allocate, Abort.Panic]:
    truthy_nonfinite_cases: sview = replace(GlBridgeEvaluationInputs::VALID, "\"cases\":[\"context\"]", "\"cases\":NaN")
    ignored_nonfinite_values: sview = replace(GlBridgeEvaluationInputs::VALID, "{\"schema\"", "{\"ignored\":[NaN,Infinity,-Infinity],\"schema\"")
    assert validate_gl_bridge_evaluation_sources(GlBridgeEvaluationInputs::VALID, GlBridgeEvaluationInputs::CONTRACT)
    assert validate_gl_bridge_evaluation_sources(truthy_nonfinite_cases, GlBridgeEvaluationInputs::CONTRACT)
    assert validate_gl_bridge_evaluation_sources(ignored_nonfinite_values, GlBridgeEvaluationInputs::CONTRACT)


@test
def gl_bridge_evaluation_matches_last_duplicate_members_and_python_mapping_iteration() -> void can[Memory.Allocate, Abort.Panic]:
    duplicate_status: sview = replace(GlBridgeEvaluationInputs::VALID, "\"status\":\"unselected\"", "\"status\":\"selected\",\"status\":\"unselected\"")
    platform_mapping: sview = replace(GlBridgeEvaluationInputs::VALID, "\"platforms\":[\"desktop GL\",\"GLES/EGL\"]", "\"platforms\":{\"desktop GL\":false,\"GLES/EGL\":true}")
    assert validate_gl_bridge_evaluation_sources(duplicate_status, GlBridgeEvaluationInputs::CONTRACT)
    assert validate_gl_bridge_evaluation_sources(platform_mapping, GlBridgeEvaluationInputs::CONTRACT)


@test
def gl_bridge_evaluation_rejects_missing_keys_falsey_cases_and_contract_gaps() -> void can[Memory.Allocate, Abort.Panic]:
    missing_platform: sview = replace(GlBridgeEvaluationInputs::VALID, "\"GLES/EGL\"", "\"GLES\"")
    falsey_cases: sview = replace(GlBridgeEvaluationInputs::VALID, "\"cases\":[\"context\"]", "\"cases\":[]")
    extra_contract_key: sview = replace(GlBridgeEvaluationInputs::VALID, "\"host_availability\":\"targets\"", "\"host_availability\":\"targets\",\"extra\":\"value\"")
    missing_heading: sview = replace(GlBridgeEvaluationInputs::CONTRACT, "## Quotas\n", "")
    assert gl_bridge_evaluation_rejects_as(missing_platform, GlBridgeEvaluationInputs::CONTRACT, GlBridgeEvaluationError.FixtureMismatch)
    assert gl_bridge_evaluation_rejects_as(falsey_cases, GlBridgeEvaluationInputs::CONTRACT, GlBridgeEvaluationError.FixtureMismatch)
    assert gl_bridge_evaluation_rejects_as(extra_contract_key, GlBridgeEvaluationInputs::CONTRACT, GlBridgeEvaluationError.ContractMismatch)
    assert gl_bridge_evaluation_rejects_as(GlBridgeEvaluationInputs::VALID, missing_heading, GlBridgeEvaluationError.ContractDocumentMismatch)
    assert gl_bridge_evaluation_rejects_as("[", GlBridgeEvaluationInputs::CONTRACT, GlBridgeEvaluationError.InvalidJson)
