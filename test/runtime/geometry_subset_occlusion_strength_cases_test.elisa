include "../../src/testing/geometry_subset_occlusion_strength_cases.elisa"

using EsGeometrySubsetOcclusionStrengthCases


@test
def occlusion_strength_cases_preserve_order_and_typed_package_parameters() -> void can[Memory.Allocate, Abort.Panic]:
    generated: darray[Case] = cases()
    assert generated.count == 9
    for index in 1..<generated.count |generated|:
        assert generated[index].verdict == Verdict.Reject

    accepted: Case = generated[0]
    assert accepted.verdict == Verdict.Accept
    assert accepted.file_name == "occlusion-strength.pkg"
    assert accepted.triangle_count == 2u32
    assert accepted.material_slots == 2u32
    assert accepted.subsets.count == 2
    assert accepted.subsets[0].first_index == 0u32 and accepted.subsets[0].index_count == 3u32 and accepted.subsets[0].material_slot == 0u32
    assert accepted.subsets[1].first_index == 3u32 and accepted.subsets[1].index_count == 3u32 and accepted.subsets[1].material_slot == 1u32
    assert accepted.has_material_records and accepted.material_record_count == 2u32
    assert accepted.occlusion_strength_stride == "4" and accepted.has_occlusion_strength_data_field
    assert accepted.occlusion_strengths.count == 2
    assert accepted.occlusion_strengths[0].kind == NumberKind.Finite and accepted.occlusion_strengths[0].finite_value == 0.25
    assert accepted.occlusion_strengths[1].kind == NumberKind.Finite and accepted.occlusion_strengths[1].finite_value == 0.75
    assert accepted.expected_diagnostic == ""

    without_materials: Case = generated[1]
    assert without_materials.file_name == "occlusion-strength-without-materials.pkg"
    assert not without_materials.has_material_records and without_materials.material_record_count == 0u32
    assert without_materials.expected_diagnostic == "invalid cooked slot occlusion strengths"

    stride: Case = generated[2]
    assert stride.file_name == "occlusion-strength-stride.pkg"
    assert stride.material_record_count == 1u32 and stride.occlusion_strength_stride == "8"
    assert stride.expected_diagnostic == "invalid cooked slot occlusion strengths"

    missing_data: Case = generated[3]
    assert missing_data.file_name == "occlusion-strength-no-records.pkg"
    assert not missing_data.has_occlusion_strength_data_field
    assert missing_data.expected_diagnostic == "invalid cooked slot occlusion strengths"

    count: Case = generated[4]
    assert count.file_name == "occlusion-strength-count.pkg"
    assert count.material_slots == 1u32 and count.occlusion_strengths.count == 2
    assert count.expected_diagnostic == "invalid cooked slot occlusion strengths"

    negative: Case = generated[5]
    assert negative.file_name == "occlusion-strength-negative.pkg"
    assert negative.occlusion_strengths[0].kind == NumberKind.Finite and negative.occlusion_strengths[0].finite_value == -0.01
    assert negative.expected_diagnostic == "cooked slot occlusion strength is out of range"

    overflow: Case = generated[6]
    assert overflow.file_name == "occlusion-strength-overflow.pkg"
    assert overflow.occlusion_strengths[0].kind == NumberKind.Finite and overflow.occlusion_strengths[0].finite_value == 1.01
    assert overflow.expected_diagnostic == "cooked slot occlusion strength is out of range"

    nan: Case = generated[7]
    assert nan.file_name == "occlusion-strength-nan.pkg"
    assert nan.occlusion_strengths[0].kind == NumberKind.NaN
    assert nan.expected_diagnostic == "cooked slot occlusion strength is out of range"

    infinite: Case = generated[8]
    assert infinite.file_name == "occlusion-strength-infinite.pkg"
    assert infinite.occlusion_strengths[0].kind == NumberKind.PositiveInfinity
    assert infinite.expected_diagnostic == "cooked slot occlusion strength is out of range"
