include "../../src/runtime/macos_dynamic_libraries_model.elisa"

using EsMacosDynamicLibraries


@test
def extracts_link_names_in_otool_order_without_the_image_identity() -> void can[Memory.Allocate, Abort.Panic]:
    output: sview = "Game.bin:\n\t@rpath/Game.bin (compatibility version 1.0.0, current version 1.0.0)\n\t/usr/lib/libSystem.B.dylib (compatibility version 1.0.0, current version 1351.0.0)\n\t/opt/homebrew/lib/libfirst.dylib (compatibility version 2.0.0, current version 2.1.0)\n\t@rpath/libsecond.dylib (compatibility version 1.0.0, current version 1.0.0)\n\t/opt/homebrew/lib/libfirst.dylib (current version 2.1.0)\n"
    names: mutable darray[sview] = []
    catch parse_linked_libraries(output, "Game.bin"):
        ok value:
            names <- value
        error failure:
            _ = failure
            assert false
    assert names.count == 4
    assert names[0] == "/usr/lib/libSystem.B.dylib"
    assert names[1] == "/opt/homebrew/lib/libfirst.dylib"
    assert names[2] == "@rpath/libsecond.dylib"
    assert names[3] == "/opt/homebrew/lib/libfirst.dylib"


@test
def extracts_distinct_rpath_values_from_load_commands() -> void can[Memory.Allocate, Abort.Panic]:
    output: sview = "Load command 0\n          cmd LC_RPATH\n      cmdsize 40\n         path @loader_path/../Frameworks (offset 12)\nLoad command 1\n          cmd LC_RPATH\n      cmdsize 40\n         path @loader_path/../Frameworks (offset 12)\nLoad command 2\n          cmd LC_RPATH\n      cmdsize 40\n         path /opt/homebrew/lib (offset 12)\n"
    paths: mutable darray[sview] = []
    catch parse_existing_rpaths(output):
        ok value:
            paths <- value
        error failure:
            _ = failure
            assert false
    assert paths.count == 2
    assert paths[0] == "@loader_path/../Frameworks"
    assert paths[1] == "/opt/homebrew/lib"


@test
def skips_truncated_rpath_command_like_the_python_helper() -> void can[Memory.Allocate, Abort.Panic]:
    paths: mutable darray[sview] = []
    catch parse_existing_rpaths("Load command 0\n cmd LC_RPATH\n"):
        ok value:
            paths <- value
        error failure:
            _ = failure
            assert false
    assert paths.count == 0


@test
def rejects_an_rpath_payload_without_a_space_delimited_value() -> void can[Memory.Allocate, Abort.Panic]:
    rejected: mutable bool = false
    catch parse_existing_rpaths("Load command 0\n cmd LC_RPATH\n cmdsize 40\n path\n"):
        ok paths:
            _ = paths
        error failure:
            rejected <- failure == MacosDynamicLibraryMetadataError.MissingRpathValue
    assert rejected
