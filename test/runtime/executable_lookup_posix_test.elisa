include "../../src/runtime/executable_lookup_posix.elisa"

using EsExecutableLookupPosix


@test
def executable_lookup_respects_posix_path_order_and_explicit_paths() -> void can[Blocking.IO, Directory.Read, Directory.Write, File.Read, File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console.Format]:
    temporary: Path = try temp_directory("executable-lookup") else failure:
        _ = failure
        assert false
        return
    first_directory: Path = temporary.joinpath("first")
    second_directory: Path = temporary.joinpath("second")
    first_created: bool = try create_directories(first_directory) else false
    second_created: bool = try create_directories(second_directory) else false
    if not first_created or not second_created:
        _ = try remove_tree(temporary) else false
        assert false
        return

    first_tool: Path = first_directory.joinpath("fixture-tool")
    second_tool: Path = second_directory.joinpath("fixture-tool")
    first_written: usize = try write_text(first_tool, "#!/bin/sh\nexit 0\n") else 0usize
    second_written: usize = try write_text(second_tool, "#!/bin/sh\nexit 0\n") else 0usize
    first_mode: bool = try chmod(first_tool, 493u64) else false
    second_mode: bool = try chmod(second_tool, 493u64) else false
    ordered: sview = which_in_path("fixture-tool", f"{first_directory}:{second_directory}")
    explicit: sview = which_in_path(f"{second_tool}", "/nonexistent")
    missing_name: sview = "elisascript-lookup-absent-8f4c29c1"
    missing: sview = which_in_path(missing_name, f"{first_directory}")
    empty_path: sview = which_in_path(missing_name, "")
    removed: bool = try remove_tree(temporary) else false

    assert first_written == 17usize and second_written == 17usize
    assert first_mode and second_mode
    assert ordered == f"{first_tool}"
    assert explicit == f"{second_tool}"
    assert missing == "" and empty_path == ""
    assert removed
