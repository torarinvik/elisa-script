include "../../src/runtime/encoding.elisa"
include "../../src/runtime/python_json_projection.elisa"

using EsPythonJsonProjection


const module PythonJsonProjectionInputs:
    TOKENS: sview = "{\"values\":[NaN,Infinity,-Infinity],\"quoted\":\"NaN Infinity -Infinity\",\"escaped\":\"quote: \\\"NaN\\\"\"}"
    TOKENS_NORMALIZED: sview = "{\"values\":[1,1,1],\"quoted\":\"NaN Infinity -Infinity\",\"escaped\":\"quote: \\\"NaN\\\"\"}"
    MALFORMED: sview = "[NaNx,+Infinity,Infinityx,-Infinity0]"


@test
def python_json_projection_normalizes_only_bounded_tokens_outside_strings() -> void can[Memory.Allocate, Abort.Panic]:
    normalized: darray[u8] = normalize_truthy_nonfinite_json_constants(PythonJsonProjectionInputs::TOKENS)
    assert bytes_view(normalized) == PythonJsonProjectionInputs::TOKENS_NORMALIZED
    assert bytes_view(normalize_truthy_nonfinite_json_constants(PythonJsonProjectionInputs::MALFORMED)) == PythonJsonProjectionInputs::MALFORMED
