# Opt-in filesystem-adapter coverage. These tests inspect paths only; they
# never launch the selected executable.
include "../../src/runtime/bash_exec_lookup_model.elisa"
include "../../src/runtime/bash_exec_lookup_posix.elisa"

using EsBashExecLookup


@test
def process_tilde_environment_value_copies_selected_exported_snapshot() -> void can[Environment.Read, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    expected_home: EsEnvironmentLookup::Value = try EsEnvironmentLookup::lookup("HOME")
    expected_pwd: EsEnvironmentLookup::Value = try EsEnvironmentLookup::lookup("PWD")
    expected_oldpwd: EsEnvironmentLookup::Value = try EsEnvironmentLookup::lookup("OLDPWD")
    home: EsBashExecLookupPosix::TildeEnvironmentSnapshot = try EsBashExecLookupPosix::process_tilde_environment_value(EsBashExecLookupPosix::TildeEnvironmentVariable::Home)
    pwd: EsBashExecLookupPosix::TildeEnvironmentSnapshot = try EsBashExecLookupPosix::process_tilde_environment_value(EsBashExecLookupPosix::TildeEnvironmentVariable::WorkingDirectory)
    oldpwd: EsBashExecLookupPosix::TildeEnvironmentSnapshot = try EsBashExecLookupPosix::process_tilde_environment_value(EsBashExecLookupPosix::TildeEnvironmentVariable::PreviousWorkingDirectory)

    assert home.present == expected_home.present and bytes_view(home.bytes) == expected_home.bytes
    assert pwd.present == expected_pwd.present and bytes_view(pwd.bytes) == expected_pwd.bytes
    assert oldpwd.present == expected_oldpwd.present and bytes_view(oldpwd.bytes) == expected_oldpwd.bytes


@test
def missing_account_home_record_preserves_the_tilde_spelling() -> void:
    missing: EsBashExecLookupPosix::AccountHomeSnapshot = EsBashExecLookupPosix::AccountHomeSnapshot{lookup_complete: true}
    tilde: mutable PathTildeContext = PathTildeContext{
        account_home_lookup_complete: missing.lookup_complete,
        account_home_present: missing.home_found,
        account_home_directory: missing.bytes
    }
    unresolved: mutable bool = false
    catch resolve_path_directory("~/tool", tilde):
        ok directory:
            unresolved <- bytes_view(directory) == "~/tool"
        error failure:
            unresolved <- false

    assert missing.lookup_complete and not missing.home_found and unresolved


@test
def reached_path_tilde_resolution_reads_only_the_selected_process_value() -> void can[Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    home_context: mutable PathTildeContext = PathTildeContext{}
    home_resolution_matches: mutable bool = false
    catch EsBashExecLookupPosix::resolve_reached_path_directory_from_process_environment("~/tools", home_context):
        ok resolved:
            if home_context.home_present:
                home_resolution_matches <- not home_context.account_home_present and bytes_view(resolved) == bytes_view(home_context.home_directory) + "/tools"
            else:
                if home_context.account_home_present:
                    home_resolution_matches <- bytes_view(resolved) == bytes_view(home_context.account_home_directory) + "/tools"
                else:
                    home_resolution_matches <- home_context.account_home_lookup_complete and bytes_view(resolved) == "~/tools"
        error failure:
            home_resolution_matches <- false

    pwd_context: mutable PathTildeContext = PathTildeContext{}
    pwd_resolution_matches: mutable bool = false
    catch EsBashExecLookupPosix::resolve_reached_path_directory_from_process_environment("~+0/tools", pwd_context):
        ok resolved:
            pwd_resolution_matches <- pwd_context.pwd_present and bytes_view(resolved) == bytes_view(pwd_context.pwd_directory) + "/tools"
        error failure:
            pwd_resolution_matches <- not pwd_context.pwd_present and failure == LookupError.TildeSnapshotUnavailable

    oldpwd_context: mutable PathTildeContext = PathTildeContext{}
    oldpwd_resolution_matches: mutable bool = false
    catch EsBashExecLookupPosix::resolve_reached_path_directory_from_process_environment("~-/tools", oldpwd_context):
        ok resolved:
            if oldpwd_context.oldpwd_present:
                oldpwd_resolution_matches <- oldpwd_context.named_user_homes.count == 0 and bytes_view(resolved) == bytes_view(oldpwd_context.oldpwd_directory) + "/tools"
            else:
                if oldpwd_context.named_user_homes.count == 1:
                    lookup: NamedUserHomeLookup = oldpwd_context.named_user_homes[0]
                    if lookup.state == NamedUserHomeState.HomeFound:
                        oldpwd_resolution_matches <- bytes_view(resolved) == bytes_view(lookup.home_directory) + "/tools"
                    else if lookup.state == NamedUserHomeState.UserNotFound:
                        oldpwd_resolution_matches <- bytes_view(resolved) == "~-/tools"
        error failure:
            if not oldpwd_context.oldpwd_present and oldpwd_context.named_user_homes.count == 1:
                oldpwd_resolution_matches <- oldpwd_context.named_user_homes[0].state == NamedUserHomeState.LookupUnavailable and failure == LookupError.TildeSnapshotUnavailable

    assert home_resolution_matches and pwd_resolution_matches and oldpwd_resolution_matches


@test
def reached_named_user_tilde_uses_reentrant_passwd_lookup() -> void can[Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    tilde: mutable PathTildeContext = PathTildeContext{}
    resolved: darray[u8] = try EsBashExecLookupPosix::resolve_reached_path_directory_from_process_environment("~root/tools", tilde)

    assert tilde.named_user_homes.count == 1
    assert bytes_view(tilde.named_user_homes[0].username) == "root"
    assert tilde.named_user_homes[0].state == NamedUserHomeState.HomeFound
    assert bytes_view(resolved) == bytes_view(tilde.named_user_homes[0].home_directory) + "/tools"


@test
def process_environment_path_observer_stops_before_unreached_tilde() -> void can[Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    credentials: CredentialSnapshot = try EsBashExecLookupPosix::current_credentials()
    plan: PathSearchPlan = try plan_path_search("bash", "/bin:~should-not-be-read")
    tilde: mutable PathTildeContext = PathTildeContext{}
    observed: SearchObservation = try EsBashExecLookupPosix::observe_search_plan_with_process_environment(plan, "bash", credentials, tilde)

    assert observed.mode == SearchMode.PathDirectories
    assert observed.selection.kind == SelectionKind.Executable
    assert observed.candidates.count == 1
    assert bytes_view(observed.candidates[0].path) == "/bin/bash"
    assert not tilde.home_present and tilde.named_user_homes.count == 0


@test
def posix_search_observes_ordered_candidates_without_executing_them() -> void can[Blocking.IO, File.Read, File.Write, Directory.Read, Directory.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console.Format]:
    temporary: Path = try temp_directory("bash-exec-lookup") else err:
        assert false
        return
    absent_candidate: Path = temporary.joinpath("bash")
    absent_before: bool = not path_exists(absent_candidate) and not is_symlink(absent_candidate)

    credentials: mutable CredentialSnapshot = CredentialSnapshot{}
    credentials_captured: mutable bool = false
    catch EsBashExecLookupPosix::current_credentials():
        ok snapshot:
            credentials <- snapshot
            credentials_captured <- true
        error _:
            credentials_captured <- false

    plan: mutable PathSearchPlan = PathSearchPlan{}
    plan_built: mutable bool = false
    tilde: mutable PathTildeContext = PathTildeContext{}
    search_path: sview = f"{temporary}" + ":/bin:/usr/bin:~elisascript_lookup_missing_user/tools"
    catch plan_path_search("bash", search_path):
        ok value:
            plan <- value
            plan_built <- true
        error _:
            plan_built <- false

    observation_matches: mutable bool = false
    if credentials_captured and plan_built:
        catch EsBashExecLookupPosix::observe_search_plan(plan, "bash", credentials, tilde):
            ok observed:
                observation_matches <- observed.mode == SearchMode.PathDirectories and observed.path_selection_available and observed.candidates.count == 2
                if observation_matches:
                    observation_matches <- not observed.candidates[0].observation.exists
                    observation_matches <- observed.candidates[1].observation.exists and observed.candidates[1].observation.executable and observation_matches
                    observation_matches <- bytes_view(observed.candidates[0].path) == f"{temporary}/bash" and observation_matches
                    observation_matches <- bytes_view(observed.candidates[1].path) == "/bin/bash" and observation_matches
                    observation_matches <- observed.selection.kind == SelectionKind.Executable and observed.selection.index == 1 and observation_matches
            error _:
                observation_matches <- false

    absent_after: bool = not path_exists(absent_candidate) and not is_symlink(absent_candidate)
    removed_temporary: bool = try remove_directory(temporary) else false
    assert absent_before and absent_after and removed_temporary
    assert credentials_captured and plan_built and observation_matches


@test
def posix_search_rejects_a_reached_tilde_component() -> void can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    credentials: mutable CredentialSnapshot = CredentialSnapshot{}
    credentials_captured: mutable bool = false
    catch EsBashExecLookupPosix::current_credentials():
        ok snapshot:
            credentials <- snapshot
            credentials_captured <- true
        error _:
            credentials_captured <- false

    plan: mutable PathSearchPlan = PathSearchPlan{}
    plan_built: mutable bool = false
    tilde: mutable PathTildeContext = PathTildeContext{}
    catch plan_path_search("bash", "~elisascript_lookup_missing_user/tools"):
        ok value:
            plan <- value
            plan_built <- true
        error _:
            plan_built <- false

    tilde_rejected: mutable bool = false
    if credentials_captured and plan_built:
        catch EsBashExecLookupPosix::observe_search_plan(plan, "bash", credentials, tilde):
            ok observed:
                _ = observed
            error failure:
                tilde_rejected <- failure == LookupError.TildeExpansionUnsupported
    assert credentials_captured and plan_built and tilde_rejected


@test
def empty_path_returns_a_slashless_name_without_observing_it() -> void can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    credentials: CredentialSnapshot = CredentialSnapshot{}
    command: sview = "elisascript_lookup_missing_name"
    plan: PathSearchPlan = try plan_path_search(command, "")
    tilde: mutable PathTildeContext = PathTildeContext{}
    observed: SearchObservation = try EsBashExecLookupPosix::observe_search_plan(plan, command, credentials, tilde)
    assert observed.mode == SearchMode.DirectName
    assert not observed.path_selection_available
    assert observed.unsearched_name_returned
    assert bytes_view(observed.unsearched_name) == command
    assert observed.candidates.count == 0


@test
def direct_empty_path_name_remains_owned_for_the_invocation() -> void can[Memory.Allocate, Abort.Panic]:
    name: mutable darray[u8] = []
    for byte in "ruff" |name|:
        name.push(byte)
    observed: EsBashExecLookupPosix::SearchObservation = EsBashExecLookupPosix::SearchObservation{
        mode: SearchMode.DirectName,
        unsearched_name_returned: true,
        unsearched_name: name
    }
    resolved: mutable EsBashExecLookupPosix::InvocationPath = try EsBashExecLookupPosix::invocation_path_from_observation(observed)
    assert resolved.available and bytes_view(resolved.bytes) == "ruff"
    resolved.bytes[0] <- 120u8
    assert bytes_view(observed.unsearched_name) == "ruff"


@test
def selected_bash_path_is_owned_and_matches_checked_candidate_policy() -> void can[Memory.Allocate, Abort.Panic]:
    earlier_file: mutable darray[u8] = []
    for byte in "tools/not-executable" |earlier_file|:
        earlier_file.push(byte)
    selected_file: mutable darray[u8] = []
    for byte in "bin/ruff" |selected_file|:
        selected_file.push(byte)
    observed: EsBashExecLookupPosix::SearchObservation = EsBashExecLookupPosix::SearchObservation{
        mode: SearchMode.PathDirectories,
        path_selection_available: true,
        candidates: [
            EsBashExecLookupPosix::ObservedPathCandidate{path: earlier_file, observation: PathCandidate{exists: true}},
            EsBashExecLookupPosix::ObservedPathCandidate{path: selected_file, observation: PathCandidate{exists: true, executable: true}}
        ],
        selection: Selection{kind: SelectionKind.Executable, index: 1}
    }
    resolved: mutable EsBashExecLookupPosix::InvocationPath = try EsBashExecLookupPosix::invocation_path_from_observation(observed)

    assert resolved.available and bytes_view(resolved.bytes) == "bin/ruff"
    resolved.bytes[0] <- 120u8
    assert bytes_view(observed.candidates[1].path) == "bin/ruff"


@test
def non_executable_bash_fallback_path_is_preserved_without_research() -> void can[Memory.Allocate, Abort.Panic]:
    fallback: mutable darray[u8] = []
    for byte in "tools/ruff" |fallback|:
        fallback.push(byte)
    observed: EsBashExecLookupPosix::SearchObservation = EsBashExecLookupPosix::SearchObservation{
        mode: SearchMode.PathDirectories,
        path_selection_available: true,
        candidates: [EsBashExecLookupPosix::ObservedPathCandidate{path: fallback, observation: PathCandidate{exists: true}}],
        selection: Selection{kind: SelectionKind.NonExecutableFallback, index: 0}
    }
    resolved: EsBashExecLookupPosix::InvocationPath = try EsBashExecLookupPosix::invocation_path_from_observation(observed)
    assert resolved.available and bytes_view(resolved.bytes) == "tools/ruff"


@test
def missing_bash_candidate_does_not_fabricate_an_invocation_path() -> void can[Memory.Allocate, Abort.Panic]:
    observed: EsBashExecLookupPosix::SearchObservation = EsBashExecLookupPosix::SearchObservation{
        mode: SearchMode.PathDirectories,
        path_selection_available: true
    }
    resolved: EsBashExecLookupPosix::InvocationPath = try EsBashExecLookupPosix::invocation_path_from_observation(observed)
    assert not resolved.available and resolved.bytes.count == 0


@test
def invalid_bash_selection_index_cannot_become_an_invocation_path() -> void can[Memory.Allocate, Abort.Panic]:
    candidate: mutable darray[u8] = []
    for byte in "bin/ruff" |candidate|:
        candidate.push(byte)
    observed: EsBashExecLookupPosix::SearchObservation = EsBashExecLookupPosix::SearchObservation{
        mode: SearchMode.PathDirectories,
        path_selection_available: true,
        candidates: [EsBashExecLookupPosix::ObservedPathCandidate{path: candidate, observation: PathCandidate{exists: true, executable: true}}],
        selection: Selection{kind: SelectionKind.Executable, index: 7}
    }
    rejected: mutable bool = false
    catch EsBashExecLookupPosix::invocation_path_from_observation(observed):
        ok value:
            _ = value
        error failure:
            rejected <- failure == EsBashExecLookupPosix::ObservationError.InvalidInvocationPathObservation
    assert rejected


@test
def home_tilde_component_expands_before_candidate_join() -> void can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    credentials: CredentialSnapshot = CredentialSnapshot{}
    tilde: mutable PathTildeContext = PathTildeContext{
        home_present: true,
        home_directory: [47u8, 101u8, 108u8, 105u8, 115u8, 97u8, 115u8, 99u8, 114u8, 105u8, 112u8, 116u8, 95u8, 104u8, 111u8, 109u8, 101u8, 95u8, 102u8, 105u8, 120u8, 116u8, 117u8, 114u8, 101u8]
    }
    plan: PathSearchPlan = try plan_path_search("bash", "~/bin")
    observed: SearchObservation = try EsBashExecLookupPosix::observe_search_plan(plan, "bash", credentials, tilde)
    assert observed.mode == SearchMode.PathDirectories and observed.candidates.count == 1
    assert bytes_view(observed.candidates[0].path) == "/elisascript_home_fixture/bin/bash"


@test
def pwd_and_oldpwd_tilde_components_expand_before_candidate_join() -> void can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    credentials: CredentialSnapshot = CredentialSnapshot{}
    pwd_bytes: mutable darray[u8] = []
    for byte in "/elisascript_pwd_snapshot_fixture" |pwd_bytes|:
        pwd_bytes.push(byte)
    oldpwd_bytes: mutable darray[u8] = []
    for byte in "/elisascript_oldpwd_snapshot_fixture" |oldpwd_bytes|:
        oldpwd_bytes.push(byte)
    tilde: mutable PathTildeContext = PathTildeContext{
        pwd_present: true,
        pwd_directory: pwd_bytes,
        oldpwd_present: true,
        oldpwd_directory: oldpwd_bytes
    }

    current_plan: PathSearchPlan = try plan_path_search("bash", "~+/bin")
    current_observation: SearchObservation = try EsBashExecLookupPosix::observe_search_plan(current_plan, "bash", credentials, tilde)
    assert current_observation.mode == SearchMode.PathDirectories and current_observation.candidates.count == 1
    assert bytes_view(current_observation.candidates[0].path) == "/elisascript_pwd_snapshot_fixture/bin/bash"

    previous_plan: PathSearchPlan = try plan_path_search("bash", "~-/bin")
    previous_observation: SearchObservation = try EsBashExecLookupPosix::observe_search_plan(previous_plan, "bash", credentials, tilde)
    assert previous_observation.mode == SearchMode.PathDirectories and previous_observation.candidates.count == 1
    assert bytes_view(previous_observation.candidates[0].path) == "/elisascript_oldpwd_snapshot_fixture/bin/bash"


@test
def indexed_directory_stack_tilde_components_expand_before_candidate_join() -> void can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    credentials: CredentialSnapshot = CredentialSnapshot{}
    pwd_bytes: mutable darray[u8] = []
    for byte in "/elisascript_logical_pwd_fixture" |pwd_bytes|:
        pwd_bytes.push(byte)
    left_entry: mutable darray[u8] = []
    for byte in "/elisascript_stack_left_fixture" |left_entry|:
        left_entry.push(byte)
    right_entry: mutable darray[u8] = []
    for byte in "/elisascript_stack_right_fixture" |right_entry|:
        right_entry.push(byte)
    tilde: mutable PathTildeContext = PathTildeContext{
        pwd_present: true,
        pwd_directory: pwd_bytes,
        directory_stack_present: true,
        directory_stack: [left_entry, right_entry]
    }

    left_plan: PathSearchPlan = try plan_path_search("bash", "~+1/bin")
    left_observation: SearchObservation = try EsBashExecLookupPosix::observe_search_plan(left_plan, "bash", credentials, tilde)
    assert left_observation.mode == SearchMode.PathDirectories and left_observation.candidates.count == 1
    assert bytes_view(left_observation.candidates[0].path) == "/elisascript_stack_left_fixture/bin/bash"

    right_plan: PathSearchPlan = try plan_path_search("bash", "~-0/bin")
    right_observation: SearchObservation = try EsBashExecLookupPosix::observe_search_plan(right_plan, "bash", credentials, tilde)
    assert right_observation.mode == SearchMode.PathDirectories and right_observation.candidates.count == 1
    assert bytes_view(right_observation.candidates[0].path) == "/elisascript_stack_right_fixture/bin/bash"


@test
def named_user_tilde_component_expands_before_candidate_join() -> void can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    credentials: CredentialSnapshot = CredentialSnapshot{}
    username: mutable darray[u8] = []
    for byte in "elisascript_lookup_user_fixture" |username|:
        username.push(byte)
    home: mutable darray[u8] = []
    for byte in "/elisascript_named_user_fixture" |home|:
        home.push(byte)
    tilde: mutable PathTildeContext = PathTildeContext{
        named_user_homes: [NamedUserHomeLookup{
            username: username,
            state: NamedUserHomeState.HomeFound,
            home_directory: home
        }]
    }

    plan: PathSearchPlan = try plan_path_search("bash", "~elisascript_lookup_user_fixture/bin")
    observed: SearchObservation = try EsBashExecLookupPosix::observe_search_plan(plan, "bash", credentials, tilde)
    assert observed.mode == SearchMode.PathDirectories and observed.candidates.count == 1
    assert bytes_view(observed.candidates[0].path) == "/elisascript_named_user_fixture/bin/bash"
