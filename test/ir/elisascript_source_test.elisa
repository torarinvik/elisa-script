    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> bool:\n    values: mutable darray[i64] = [1i64, 2i64]\n    values.clear()\n    return values.count == 0u64\n"
        module: Module = try lower_elisascript_source("array-clear.elisascript", source, "array-clear-loader") else empty_module()

        assert module.name == "array-clear-loader"
        assert module.functions.count == 1
        assert verify(module).count == 0


@test
def source_loader_accepts_terminating_error_recovery() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def parse_or(value: sview) -> i64:\n    number: i64 = try parse_int(value) else return 0i64\n    return number + 1i64\n"
        module: Module = try lower_elisascript_source("error-control.elisascript", source, "error-control-loader") else empty_module()

        assert module.name == "error-control-loader"
        assert module.functions.count == 1
        assert verify(module).count == 0


@test
def source_loader_rejects_non_elisascript_suffixes_before_parsing() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        assert elisascript_source_filename_valid("main.elisascript")
        assert elisascript_source_filename_valid("scripts/main.elisascript")
        assert not elisascript_source_filename_valid("main.elisa")
        assert not elisascript_source_filename_valid("main.elisascript.bak")
        assert not elisascript_source_filename_valid("elisascript")

        source: static u8& = "def main() -> i64:\n    return 7\n"
        rejected: Module = try lower_elisascript_source("main.elisa", source, "wrong-extension") else empty_module()
        assert rejected.name == "fallback"


