@test
def source_loader_rejects_non_elisascript_suffixes_before_parsing() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        assert elisascript_source_filename_valid("main.elisascript")
        assert elisascript_source_filename_valid("scripts/main.elisascript")
        assert not elisascript_source_filename_valid("main.elisa")
        assert not elisascript_source_filename_valid("main.elisascript.bak")
        assert not elisascript_source_filename_valid("elisascript")

        source: static u8& = "def main() -> i64:\n    return 7\n"
        rejected: Module = try lower_elisascript_source("main.elisa", source, "wrong-extension") else empty_module()
        assert rejected.name == "fallback"


@test
def source_loader_reports_parser_failures_through_error_channel() -> void:
