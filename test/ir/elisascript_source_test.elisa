include "../../src/ir/ir.elisa"

using EsIr


def empty_module() -> Module:
    return Module{name: "fallback", functions: []}


@test
def source_loader_accepts_elisascript_and_verifies_ir() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> i64:\n    return 7\n"
        module: Module = try lower_elisascript_source("main.elisascript", source, "source-loader") else empty_module()

        assert module.name == "source-loader"
        assert module.functions.count == 1
        assert module.functions[0].name == "main"
        assert verify(module).count == 0


@test
def source_loader_accepts_typed_filesystem_builtins() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> bool:\n    source: Path = path(\"source\")\n    target: Path = path(\"target\")\n    copied: bool = copy_path(source, target)\n    moved: bool = move_path(target, source)\n    return copied and moved\n"
        module: Module = try lower_elisascript_source("filesystem.elisascript", source, "filesystem-loader") else empty_module()

        assert module.name == "filesystem-loader"
        assert module.functions.count == 1
        assert verify(module).count == 0


@test
def source_loader_accepts_typed_integer_conversion_builtins() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def parse(value: sview) -> i64:\n    return parse_int(value)\n\ndef format(value: i64) -> sview:\n    return format_int(value)\n"
        module: Module = try lower_elisascript_source("numeric.elisascript", source, "numeric-loader") else empty_module()

        assert module.name == "numeric-loader"
        assert module.functions.count == 2
        assert verify(module).count == 0


