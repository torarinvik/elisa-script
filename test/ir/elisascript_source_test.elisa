        source: static u8& = "def main(limit: i64) -> i64:\n    total: mutable i64 = 0i64\n    for value in range(limit):\n        total += value\n    for value in range(2i64, limit):\n        total += value\n    for value in range(5i64, 0i64, -2i64):\n        total += value\n    return total\n"
        module: Module = try lower_elisascript_source("range.elisascript", source, "range-loader") else empty_module()

