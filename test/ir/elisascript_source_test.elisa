@test
def source_loader_accepts_python_path_aliases() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def parent(path_value: Path) -> Path:\n    return dirname(path_value)\n\ndef name(path_value: Path) -> sview:\n    return basename(path_value)\n\ndef suffix_value(path_value: Path) -> sview:\n    return suffix(path_value)\n\ndef stem_value(path_value: Path) -> sview:\n    return stem(path_value)\n\ndef directory_value(path_value: Path) -> bool:\n    return is_dir(path_value)\n\ndef parent_property(path_value: Path) -> Path:\n    return path_value.parent\n\ndef name_property(path_value: Path) -> sview:\n    return path_value.name\n\ndef suffix_property(path_value: Path) -> sview:\n    return path_value.suffix\n\ndef stem_property(path_value: Path) -> sview:\n    return path_value.stem\n\ndef join_method(base: Path, leaf: sview) -> Path:\n    return base.joinpath(leaf)\n\ndef exists_method(path_value: Path) -> bool:\n    return path_value.exists()\n\ndef directory_method(path_value: Path) -> bool:\n    return path_value.is_dir()\n\ndef file_predicate(path_value: Path) -> bool:\n    return is_file(path_value)\n\ndef file_method(path_value: Path) -> bool:\n    return path_value.is_file()\n"
        module: Module = try lower_elisascript_source("path-aliases.elisascript", source, "path-aliases-loader") else empty_module()

        assert module.name == "path-aliases-loader"
        assert module.functions.count == 14
        assert verify(module).count == 0


