@test
def source_loader_accepts_shell_filesystem_aliases() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def cwd() -> Path:\n    return pwd()\n\ndef mutate(path_value: Path, destination: Path) -> bool:\n    made: bool = mkdir(path_value)\n    changed: bool = cd(path_value)\n    restored: bool = cd(pwd())\n    removed_directory: bool = rmdir(path_value)\n    removed_file: bool = rm(path_value)\n    copied: bool = cp(path_value, destination)\n    moved: bool = mv(path_value, destination)\n    return made and changed and restored and removed_directory and removed_file and copied and moved\n"
        module: Module = try lower_elisascript_source("filesystem-aliases.elisascript", source, "filesystem-aliases-loader") else empty_module()

        assert module.name == "filesystem-aliases-loader"
        assert module.functions.count == 2
        assert verify(module).count == 0


