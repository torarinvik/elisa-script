@test
def source_loader_accepts_dynamic_python_range_steps() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(step: i64) -> i64:\n    total: mutable i64 = 0i64\n    for value in range(0i64, 10i64, step):\n        total += value\n    return total\n"
        module: Module = try lower_elisascript_source("dynamic-range.elisascript", source, "dynamic-range-loader") else empty_module()

        assert module.name == "dynamic-range-loader"
        assert module.functions.count == 1
        assert any error_name in module.functions[0].errors where error_name == "RangeStepZero"
        assert verify(module).count == 0


