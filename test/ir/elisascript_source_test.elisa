@test
def source_loader_accepts_all_lowered_text_and_line_helpers() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def split_fields(value: sview) -> darray[sview]:\n    return split_regex(value, regex\"[,;]\")\n\ndef find_fields(value: sview) -> darray[sview]:\n    return find_regex(value, regex\"[0-9]+\")\n\ndef format(value: bool) -> sview:\n    return format_bool(value)\n\ndef read(path_value: Path) -> darray[sview]:\n    return read_lines(path_value)\n\ndef write(path_value: Path, lines: darray[sview]) -> usize:\n    return write_lines(path_value, lines)\n"
        module: Module = try lower_elisascript_source("text-helpers.elisascript", source, "text-helper-loader") else empty_module()

        assert module.name == "text-helper-loader"
        assert module.functions.count == 5
        assert verify(module).count == 0


@test
def source_loader_accepts_indexed_array_and_text_iteration() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def array(values: darray[i64]) -> i64:\n    total: mutable i64 = 0\n    for index, value in values:\n        if index == 0usize:\n            total += value\n    return total\n\ndef text(value: sview) -> char:\n    for index, character in value:\n        if index == 0usize:\n            return character\n    return 'x'\n"
        module: Module = try lower_elisascript_source("indexed.elisascript", source, "indexed-loader") else empty_module()

        assert module.name == "indexed-loader"
        assert module.functions.count == 2
        assert verify(module).count == 0


