        assert rejected.functions.count == 0


@test
def source_loader_bytes_rejects_embedded_nul_without_truncating() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        fragment: sview = "def main() -> i64:\n    return 1\n"
        bytes: mutable dstr = ctx_fstr_alloc(sview_len(fragment) * 2)
        ctx_fstr_append(bytes, fragment.data, sview_len(fragment))
        ctx_fstr_append(bytes, "\0", 1)
        ctx_fstr_append(bytes, fragment.data, sview_len(fragment) - 1)
        rejected: Module = try lower_elisascript_source_bytes("embedded.elisascript", bytes_view(bytes).data, bytes.count, "embedded-nul") else empty_module()

        assert rejected.name == "fallback"
        assert rejected.functions.count == 0
