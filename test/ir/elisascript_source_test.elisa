        source: static u8& = "def values() -> darray[i64]:\n    mapping: dict[sview, i64] = {\"first\": 1i64, \"second\": 2i64}\n    return mapping.values()\n"
        module: Module = try lower_elisascript_source("dict-values.elisascript", source, "dict-values-loader") else empty_module()

        assert module.name == "dict-values-loader"
        assert module.functions.count == 1
        assert verify(module).count == 0


