include "../../src/ir/ir.elisa"

using EsIr

def empty_module() -> Module:
    return Module{name: "fallback", functions: []}


@test
def source_loader_accepts_elisascript_and_verifies_ir() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> i64:\n    return 7\n"
        module: Module = try lower_elisascript_source("main.elisascript", source, "source-loader") else empty_module()

        assert module.name == "source-loader"
        assert module.functions.count == 1
        assert module.functions[0].name == "main"
        assert verify(module).count == 0


