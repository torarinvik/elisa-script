@test
def source_loader_reports_lowering_failures_through_error_channel() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def broken() -> void:\n    region scratch(1024):\n        pass\n"
