def source_loader_accepts_typed_filesystem_builtins() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> bool:\n    source: Path = path(\"source\")\n    target: Path = path(\"target\")\n    copied: bool = copy_path(source, target)\n    moved: bool = move_path(target, source)\n    return copied and moved\n"
        module: Module = try lower_elisascript_source("filesystem.elisascript", source, "filesystem-loader") else empty_module()

        assert module.name == "filesystem-loader"
        assert module.functions.count == 1
        assert verify(module).count == 0


