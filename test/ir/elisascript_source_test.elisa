include "../../src/ir/ir.elisa"

using EsIr


def empty_module() -> Module:
    return Module{name: "fallback", functions: []}


@test
def source_loader_accepts_elisascript_and_verifies_ir() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> i64:\n    return 7\n"
        module: Module = try lower_elisascript_source("main.elisascript", source, "source-loader") else empty_module()

        assert module.name == "source-loader"
        assert module.functions.count == 1
        assert module.functions[0].name == "main"
        assert verify(module).count == 0


@test
def source_loader_rejects_non_elisascript_suffixes_before_parsing() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        assert elisascript_source_filename_valid("main.elisascript")
        assert elisascript_source_filename_valid("scripts/main.elisascript")
        assert not elisascript_source_filename_valid("main.elisa")
        assert not elisascript_source_filename_valid("main.elisascript.bak")
        assert not elisascript_source_filename_valid("elisascript")

        source: static u8& = "def main() -> i64:\n    return 7\n"
        rejected: Module = try lower_elisascript_source("main.elisa", source, "wrong-extension") else empty_module()
        assert rejected.name == "fallback"


@test
def source_loader_reports_parser_failures_through_error_channel() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def broken(: i64:\n    return 1\n"
        rejected: Module = try lower_elisascript_source("broken.elisascript", source, "parse-failure") else empty_module()

        assert rejected.name == "fallback"
        assert rejected.functions.count == 0


@test
def source_loader_reports_semantic_failures_through_error_channel() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def broken() -> i64:\n    return true\n"
        rejected: Module = try lower_elisascript_source("broken.elisascript", source, "semantic-failure") else empty_module()

        assert rejected.name == "fallback"
        assert rejected.functions.count == 0


@test
def source_loader_reports_lowering_failures_through_error_channel() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def broken() -> void:\n    region scratch(1024):\n        pass\n"
        rejected: Module = try lower_elisascript_source("broken.elisascript", source, "lower-failure") else empty_module()

        assert rejected.name == "fallback"
        assert rejected.functions.count == 0
