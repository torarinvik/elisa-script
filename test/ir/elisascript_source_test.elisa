@test
def source_loader_accepts_elisa_enumerate_sugar() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> i64:\n    values: darray[i64] = [1i64, 2i64]\n    total: mutable i64 = 0\n    for index, value in values.enumerate():\n        if index == 1usize:\n            total += value\n    return total\n\ndef items() -> i64:\n    values: dict[sview, i64] = {\"one\": 1i64}\n    total: mutable i64 = 0\n    for key, value in values.items():\n        total += value\n    return total\n\ndef global_form() -> i64:\n    values: darray[i64] = [1i64, 2i64]\n    total: mutable i64 = 0\n    for index, value in enumerate(values):\n        if index == 1usize:\n            total += value\n    return total\n"
        module: Module = try lower_elisascript_source("enumerate.elisascript", source, "enumerate-loader") else empty_module()

        assert module.name == "enumerate-loader"
        assert module.functions.count == 3
        assert verify(module).count == 0


