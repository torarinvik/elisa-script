@test
def lowers_signal_to_traced_effect_operation() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def tick(value: i64) -> void can[Progress.Tick]:\n    signal Progress.Tick(value + 1, true)\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "effects")
        instruction: Instruction = lowered.module.functions[0].instruction_pool[lowered.module.functions[0].instruction_pool.count - 1]

        assert lowered.issues.count == 0
        assert instruction.opcode == Opcode.Perform
        assert instruction.effect_family == "Progress"
        assert instruction.effect_operation == "Tick"
        assert instruction.operand_count == 2
        assert instruction.trace.id != 0
        assert verify(lowered.module).count == 0

        mismatch_source: static u8& = "def accept(flag: bool) -> void:\n    pass\n\ndef run() -> void:\n    with handler progress:\n        signal Progress.Tick(1)\n"
        mismatch_file: Ast::File = parse_for_ir(mismatch_source)
        mismatch_clause: HandlerClause = HandlerClause{effect_family: "Progress", effect_operation: "Tick", function: "accept"}
        progress: Handler = Handler{name: "progress", handles: ["Progress"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear, clauses: [mismatch_clause]}
        mismatch_handlers: darray[Handler] = [progress]
        mismatch: LowerResult = lower_file_with_handlers(mismatch_file, "bad-effect-payload", mismatch_handlers)
        assert mismatch.issues.count == 0
        assert any issue in verify(mismatch.module) where issue.kind == IssueKind.HandlerContract


