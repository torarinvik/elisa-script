@test
def lowers_python_pop_as_typed_array_value_and_rebinding() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def build() -> i64:\n    values: mutable darray[i64] = [10, 20, 30]\n    removed: i64 = values.pop()\n    return removed * 100 + values[1]\n\ndef indexed() -> i64:\n    values: mutable darray[i64] = [10, 20, 30]\n    removed: i64 = values.pop(1)\n    return removed * 100 + values[1]\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "array-pop")

        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.PopArrayValue) == 1
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.PopArray) == 1
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.PopArrayValue) == 1
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.PopArray) == 1
        assert opcode_has_operand_count(lowered.module.functions[1].instruction_pool, Opcode.PopArrayValue, 2u16)
        assert opcode_has_operand_count(lowered.module.functions[1].instruction_pool, Opcode.PopArray, 2u16)
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def immutable() -> i64:\n    values: darray[i64] = [1]\n    return values.pop()\n\ndef wrong_args() -> i64:\n    values: mutable darray[i64] = [1]\n    return values.pop(0, 1)\n\ndef wrong_index() -> i64:\n    values: mutable darray[i64] = [1]\n    return values.pop(\"bad\")\n\ndef wrong_receiver() -> i64:\n    text: sview = \"hello\"\n    return text.pop()\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-array-pop")
        assert invalid.issues.count >= 3
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.ImmutableBinding
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


