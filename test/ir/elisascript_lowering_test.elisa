        lowered: LowerResult = lower_file(file, "array-equality")

        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.Equal) == 1
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.NotEqual) == 1
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def mixed() -> bool:\n    return [1] == [true]\n"
