@test
def lowers_elisa_enumerate_sugar_to_indexed_iteration() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def array() -> i64:\n    values: darray[i64] = [4i64, 5i64]\n    total: mutable i64 = 0\n    for index, value in values.enumerate():\n        if index == 1usize:\n            total += value\n    return total\n\ndef text() -> char:\n    for index, value in \"ab\".enumerate():\n        if index == 1usize:\n            return value\n    return 'x'\n\ndef global_form() -> i64:\n    values: darray[i64] = [4i64, 5i64]\n    total: mutable i64 = 0\n    for index, value in enumerate(values):\n        if index == 1usize:\n            total += value\n    return total\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "enumerate-iteration")

        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.Length) == 1
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.Index) == 1
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.Length) == 1
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.Index) == 1
        assert opcode_count(lowered.module.functions[2].instruction_pool, Opcode.Length) == 1
        assert opcode_count(lowered.module.functions[2].instruction_pool, Opcode.Index) == 1
        assert verify(lowered.module).count == 0

        shadow_source: static u8& = "def enumerate(values: darray[i64]) -> darray[i64]:\n    return values\n\ndef call_shadow() -> i64:\n    values: darray[i64] = [4i64, 5i64]\n    total: mutable i64 = 0\n    for value in enumerate(values):\n        total += value\n    return total\n"
        shadow_file: Ast::File = parse_for_ir(shadow_source)
        shadowed: LowerResult = lower_file(shadow_file, "shadowed-enumerate")
        assert shadowed.issues.count == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Call) == 1
        assert verify(shadowed.module).count == 0


