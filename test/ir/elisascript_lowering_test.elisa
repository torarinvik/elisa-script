        assert opcode_count(lowered.module.functions[2].instruction_pool, Opcode.GetEnvironment) == 1
        assert opcode_count(lowered.module.functions[3].instruction_pool, Opcode.SetEnvironment) == 1
        assert opcode_count(lowered.module.functions[4].instruction_pool, Opcode.UnsetEnvironment) == 1
        assert any effect in lowered.module.functions[0].effects where effect == "Environment.Read"
        assert any effect in lowered.module.functions[3].effects where effect == "Environment.Write"
        assert any error_name in lowered.module.functions[0].errors where error_name == "EnvironmentError"
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def wrong() -> sview:\n    return getenv(1)\n"
