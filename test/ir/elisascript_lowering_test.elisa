        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.TextReplace) == 1
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.TrimText) == 1
        assert opcode_count(lowered.module.functions[2].instruction_pool, Opcode.Split) == 1
        assert verify(lowered.module).count == 0


