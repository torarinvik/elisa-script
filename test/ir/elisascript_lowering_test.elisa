@test
def lowers_python_range_calls_to_counter_state_machines() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def stop(limit: i64) -> i64:\n    total: mutable i64 = 0i64\n    for value in range(limit):\n        total += value\n    return total\n\ndef bounds(limit: i64) -> i64:\n    total: mutable i64 = 0i64\n    for value in range(2i64, limit):\n        total += value\n    return total\n\ndef stepped() -> i64:\n    total: mutable i64 = 0i64\n    for value in range(0i64, 10i64, 2i64):\n        total += value\n    return total\n\ndef descending() -> i64:\n    total: mutable i64 = 0i64\n    for value in range(5i64, 0i64, -2i64):\n        total += value\n    return total\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "python-range")

        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.Length) == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.Index) == 0
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.Length) == 0
        assert opcode_count(lowered.module.functions[2].instruction_pool, Opcode.Length) == 0
        assert opcode_count(lowered.module.functions[3].instruction_pool, Opcode.Length) == 0
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def no_args() -> void:\n    for value in range():\n        observe(value)\n\ndef bad_step() -> void:\n    for value in range(0i64, 10i64, 0i64):\n        observe(value)\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-python-range")
        assert invalid.issues.count >= 2
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.UnknownCallee or issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_dynamic_python_ranges_to_sign_aware_conditions() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def loop(step: i64) -> i64:\n    total: mutable i64 = 0i64\n    for value in range(0i64, 10i64, step):\n        total += value\n    return total\n\ndef projected(step: i64) -> darray[i64]:\n    return [value for value in range(0i64, 10i64, step)]\n\ndef folded(step: i64) -> i64:\n    return sum(range(0i64, 10i64, step))\n"
