@test
def lowers_python_dictionary_update_as_owned_rebinding() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def update(mapping: mutable dict[sview, i64], other: dict[sview, i64]) -> i64:\n    mapping.update(other)\n    return mapping[\"first\"] + mapping[\"new\"]\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "dictionary-update")

        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.Concat) == 1
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def immutable(mapping: dict[sview, i64], other: dict[sview, i64]) -> void:\n    mapping.update(other)\n\ndef wrong_receiver(values: mutable darray[i64], other: darray[i64]) -> void:\n    values.update(other)\n\ndef wrong_type(mapping: mutable dict[sview, i64], values: dict[i64, i64]) -> void:\n    mapping.update(values)\n\ndef wrong_args(mapping: mutable dict[sview, i64], other: dict[sview, i64]) -> void:\n    mapping.update(other, other)\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-dictionary-update")
        assert invalid.issues.count >= 4
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.ImmutableBinding
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


