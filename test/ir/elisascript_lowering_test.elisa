@test
def lowers_console_print_aliases_to_explicit_stream_opcodes() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def stdout_aliases() -> usize:\n    first: usize = println(\"line\")\n    second: usize = print(\"value\")\n    third: usize = echo(\"shell\")\n    return first + second + third\n\ndef stderr_alias() -> usize:\n    return eprint(\"error\")\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "print-aliases")
        stdout_fn: Function = lowered.module.functions[0]
        stderr_fn: Function = lowered.module.functions[1]
        assert lowered.issues.count == 0
        assert opcode_count(stdout_fn.instruction_pool, Opcode.WriteStdout) == 3
        assert opcode_count(stderr_fn.instruction_pool, Opcode.WriteStderr) == 1
        assert verify(lowered.module).count == 0


@test
def lowers_known_direct_calls() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> i64:\n    return inc(41)\n\ndef inc(x: i64) -> i64:\n    return x + 1\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "calls")

        assert lowered.issues.count == 0
        assert lowered.module.functions.count == 2
        assert lowered.module.functions[0].instruction_pool[1].opcode == Opcode.Call
        assert lowered.module.functions[0].instruction_pool[1].symbol == "inc"
        assert verify(lowered.module).count == 0


@test
def lowers_named_and_default_arguments_in_signature_order() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def combine(a: i64, b: i64 = 2, c: i64 = a + b) -> i64:\n    return a * 100 + b * 10 + c\n\ndef calls() -> i64:\n    return combine(c: 10, a: 1) + combine(3) + combine(4, c: 9)\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "call-arguments")

        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.Call) == 3
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def target(a: i64, b: i64 = 2) -> i64:\n    return a + b\n\ndef duplicate() -> i64:\n    return target(1, a: 2)\n\ndef unknown() -> i64:\n    return target(nope: 1)\n\ndef missing() -> i64:\n    return target()\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-call-arguments")
        assert invalid.issues.count == 4
        for issue in invalid.issues:
            assert issue.kind == LowerIssueKind.TypeMismatch


