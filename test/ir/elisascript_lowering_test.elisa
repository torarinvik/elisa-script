        assert any effect in lowered.module.functions[0].effects where effect == "File.Read"
        assert any effect in lowered.module.functions[1].effects where effect == "File.Write"
        assert any error_name in lowered.module.functions[2].errors where error_name == "FileIoError"
        assert verify(lowered.module).count == 0

