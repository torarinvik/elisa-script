@test
def lowers_exact_typed_array_and_text_concatenation() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        valid_source: static u8& = "def text(left: sview, right: sview) -> sview:\n    return left + right\n\ndef arrays(left: darray[i64], right: darray[i64]) -> darray[i64]:\n    return left + right\n"
        valid_file: Ast::File = parse_for_ir(valid_source)
        valid: LowerResult = lower_file(valid_file, "concatenation")

        assert valid.issues.count == 0
        assert opcode_count(valid.module.functions[0].instruction_pool, Opcode.Concat) == 1
        assert opcode_count(valid.module.functions[1].instruction_pool, Opcode.Concat) == 1
        assert opcode_count(valid.module.functions[0].instruction_pool, Opcode.Add) == 0
        assert verify(valid.module).count == 0

        invalid_source: static u8& = "def mismatch() -> darray[i64]:\n    return [1] + [\"wrong\"]\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-concatenation")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_array_push_and_extend_as_control_flow_visible_ssa_rebinding() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        valid_source: static u8& = "def build(include_more: bool) -> darray[i64]:\n    values: mutable darray[i64] = []\n    values.push(1)\n    if include_more:\n        values.extend([2, 3])\n    return values\n\ndef looped(limit: i64) -> darray[i64]:\n    values: mutable darray[i64] = []\n    for value in 0..<limit:\n        values.push(value)\n    return values\n"
        valid_file: Ast::File = parse_for_ir(valid_source)
        valid: LowerResult = lower_file(valid_file, "array-growth")

        assert valid.issues.count == 0
        assert opcode_count(valid.module.functions[0].instruction_pool, Opcode.Concat) == 2
        assert opcode_count(valid.module.functions[1].instruction_pool, Opcode.Concat) == 1
        assert valid.module.functions[0].block_parameter_pool.count >= 1
        assert valid.module.functions[1].block_parameter_pool.count >= 2
        assert verify(valid.module).count == 0

        invalid_source: static u8& = "def wrong_value() -> void:\n    values: mutable darray[i64] = []\n    values.push(\"wrong\")\n\ndef wrong_array() -> void:\n    values: mutable darray[i64] = []\n    values.extend([\"wrong\"])\n\ndef wrong_receiver() -> void:\n    text: sview = \"hello\"\n    text.push('!')\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-array-growth")
        assert invalid.issues.count >= 3
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_typed_membership_and_rejects_mismatched_needles() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        valid_source: static u8& = "def contains(value: i64, character: char, text: sview) -> bool:\n    observe(value in [1, 2, 3])\n    return character not in text\n"
        valid_file: Ast::File = parse_for_ir(valid_source)
        valid: LowerResult = lower_file(valid_file, "membership")

        assert valid.issues.count == 0
        assert opcode_count(valid.module.functions[0].instruction_pool, Opcode.Contains) == 2
        assert opcode_count(valid.module.functions[0].instruction_pool, Opcode.Not) == 1
        assert verify(valid.module).count == 0

        invalid_source: static u8& = "def invalid() -> bool:\n    return 1 in \"abc\"\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-membership")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_numeric_range_membership_to_ordered_cfg() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        valid_source: static u8& = "def exclusive(value: i64, limit: i64) -> bool:\n    observe(value in 0..<limit)\n    observe(value in -2..=2)\n    observe(value in 5..>0)\n    return value not in 1..<4\n"
        valid_file: Ast::File = parse_for_ir(valid_source)
        valid: LowerResult = lower_file(valid_file, "range-membership")
        fn: Function = valid.module.functions[0]

        assert valid.issues.count == 0
        assert opcode_count(fn.instruction_pool, Opcode.Contains) == 0
        assert opcode_count(fn.instruction_pool, Opcode.GreaterEqual) == 3
        assert opcode_count(fn.instruction_pool, Opcode.Less) == 2
        assert opcode_count(fn.instruction_pool, Opcode.LessEqual) == 2
        assert opcode_count(fn.instruction_pool, Opcode.Greater) == 1
        assert opcode_count(fn.instruction_pool, Opcode.Not) == 1
        assert verify(valid.module).count == 0

        strided_source: static u8& = "def strided(value: i64) -> bool:\n    return value in 0..<10..2\n"
        strided_file: Ast::File = parse_for_ir(strided_source)
        strided: LowerResult = lower_file(strided_file, "strided-range-membership")
        strided_fn: Function = strided.module.functions[0]
        assert strided.issues.count == 0
        assert opcode_count(strided_fn.instruction_pool, Opcode.Subtract) == 1
        assert opcode_count(strided_fn.instruction_pool, Opcode.Remainder) == 1
        assert opcode_count(strided_fn.instruction_pool, Opcode.Equal) == 1
        assert verify(strided.module).count == 0

        invalid_stride_source: static u8& = "def zero(value: i64) -> bool:\n    return value in 0..<10..0\n\ndef dynamic(value: i64, stride: i64) -> bool:\n    return value in 0..<10..stride\n"
        invalid_stride_file: Ast::File = parse_for_ir(invalid_stride_source)
        invalid_stride: LowerResult = lower_file(invalid_stride_file, "invalid-strided-range-membership")
        assert invalid_stride.issues.count >= 2
        assert any issue in invalid_stride.issues where issue.kind == LowerIssueKind.TypeMismatch

        mismatch_source: static u8& = "def mismatch(value: sview) -> bool:\n    return value in 0..<10\n"
        mismatch_file: Ast::File = parse_for_ir(mismatch_source)
        mismatch: LowerResult = lower_file(mismatch_file, "mismatched-range-membership")
        assert any issue in mismatch.issues where issue.kind == LowerIssueKind.TypeMismatch


