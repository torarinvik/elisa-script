include "../../src/ir/ir.elisa"

using Ast
using EsIr


def parse_for_ir(source: u8&) -> Ast::File:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        tokens: darray[Lexer::Token] = frontend_tokenize("test.elisascript", source)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        assert file.errors.count == 0
        return file


def opcode_count(instructions: darray[Instruction]&, opcode: Opcode) -> usize:
    count: mutable usize = 0
    for instruction in instructions |count, opcode|:
        count <- count + 1 if instruction.opcode == opcode
    return count


@test
def lowers_typed_arithmetic_bindings_and_return() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def add_twice(x: i64, y: i64) -> i64:\n    sum: i64 = x + y\n    return sum * 2\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "arithmetic")

        assert lowered.issues.count == 0
        assert lowered.module.functions.count == 1
        assert lowered.module.functions[0].parameters.count == 2
        assert lowered.module.functions[0].blocks[0].instruction_count == 3
        assert lowered.module.functions[0].blocks[0].terminator.operand_count == 1
        assert verify(lowered.module).count == 0


@test
def lowers_explicit_integer_suffixes_to_exact_ir_types() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def byte_sum() -> u8:\n    return 1u8 + 2u8\n\ndef count_is_three(values: darray[sview]) -> bool:\n    return values.count == 3u64\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "integer-suffixes")
        assert lowered.issues.count == 0
        assert lowered.module.functions[0].instruction_pool[0].result_type.bits == 8
        assert not lowered.module.functions[0].instruction_pool[0].result_type.signed
        assert verify(lowered.module).count == 0

        mismatch_source: static u8& = "def mismatch() -> u8:\n    return 1u8 + 2u16\n"
        mismatch_file: Ast::File = parse_for_ir(mismatch_source)
        mismatch: LowerResult = lower_file(mismatch_file, "mixed-integer-suffixes")
        assert any issue in mismatch.issues where issue.kind == LowerIssueKind.TypeMismatch

        boundary_source: static u8& = "def signed_min() -> i8:\n    return -128i8\n\ndef unsigned_max() -> u8:\n    return 255u8\n"
        boundary_file: Ast::File = parse_for_ir(boundary_source)
        boundaries: LowerResult = lower_file(boundary_file, "integer-boundaries")
        assert boundaries.issues.count == 0
        assert verify(boundaries.module).count == 0

        overflow_source: static u8& = "def signed_high() -> i8:\n    return 128i8\n\ndef unsigned_high() -> u8:\n    return 256u8\n\ndef unsigned_negative() -> u8:\n    return -1u8\n\ndef signed_low() -> i8:\n    return -129i8\n"
        overflow_file: Ast::File = parse_for_ir(overflow_source)
        overflowed: LowerResult = lower_file(overflow_file, "integer-overflow")
        assert overflowed.issues.count == 4
        for issue in overflowed.issues:
            assert issue.kind == LowerIssueKind.TypeMismatch

        unsigned_negation_source: static u8& = "def negate(value: u8) -> u8:\n    return -value\n"
        unsigned_negation_file: Ast::File = parse_for_ir(unsigned_negation_source)
        unsigned_negation: LowerResult = lower_file(unsigned_negation_file, "unsigned-negation")
        assert any issue in unsigned_negation.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_compiler_known_typed_literals_as_nominal_constants() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def keep(value: Path) -> Path:\n    return value\n\ndef literals() -> bool:\n    path_value: Path = path\"src/main.elisa\"\n    glob_value: Glob = glob\"src/**/*.elisa\"\n    regex_value: Regex = regex\"[a-z]+\"\n    executable: Executable = exe\"elisac\"\n    endpoint: Url = url\"https://example.com\"\n    return keep(path_value) == path\"src/main.elisa\" and glob_value == glob\"src/**/*.elisa\" and regex_value == regex\"[a-z]+\" and executable == exe\"elisac\" and endpoint == url\"https://example.com\"\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "typed-literals")

        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.Constant) >= 10
        assert verify(lowered.module).count == 0

        shadow_source: static u8& = "def path(value: sview) -> i64:\n    return 9\n\ndef shadowed() -> i64:\n    return path\"src\"\n"
        shadow_file: Ast::File = parse_for_ir(shadow_source)
        shadowed: LowerResult = lower_file(shadow_file, "shadowed-typed-literal")
        assert shadowed.issues.count == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Call) == 1
        assert verify(shadowed.module).count == 0

        invalid_source: static u8& = "def dynamic(value: sview) -> Path:\n    return path(value)\n\ndef arity() -> Regex:\n    return regex(\"a\", \"b\")\n\ndef mismatch() -> bool:\n    return path\"same\" == regex\"same\"\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-typed-literals")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.UnsupportedExpression
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_typed_regex_search() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def find(value: sview) -> bool:\n    return matches(value, regex\"^elisa.*script$\")\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "regex-search")
        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.RegexSearch) == 1
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def wrong(value: sview) -> bool:\n    return matches(regex\"x\", value)\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-regex-search")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch

        shadow_source: static u8& = "def matches(value: sview, pattern: Regex) -> i64:\n    return 4\n\ndef call_shadow() -> i64:\n    return matches(\"x\", regex\"x\")\n"
        shadow_file: Ast::File = parse_for_ir(shadow_source)
        shadowed: LowerResult = lower_file(shadow_file, "shadowed-matches")
        assert shadowed.issues.count == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.RegexSearch) == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Call) == 1


@test
def lowers_typed_text_split_and_preserves_source_shadowing() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def fields(value: sview) -> darray[sview]:\n    return split(value, \",\")\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "text-split")
        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.Split) == 1
        assert verify(lowered.module).count == 0

        shadow_source: static u8& = "def split(value: sview, separator: sview) -> i64:\n    return 7\n\ndef call_shadow() -> i64:\n    return split(\"a,b\", \",\")\n"
        shadow_file: Ast::File = parse_for_ir(shadow_source)
        shadowed: LowerResult = lower_file(shadow_file, "shadowed-split")
        assert shadowed.issues.count == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Split) == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Call) == 1

        invalid_source: static u8& = "def wrong() -> darray[sview]:\n    return split(1, \",\")\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-text-split")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_typed_text_join_and_preserves_source_shadowing() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def render(values: darray[sview]) -> sview:\n    return join(values, \",\")\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "text-join")
        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.Join) == 1
        assert verify(lowered.module).count == 0

        shadow_source: static u8& = "def join(values: darray[sview], separator: sview) -> i64:\n    return 8\n\ndef call_shadow() -> i64:\n    return join([\"a\"], \",\")\n"
        shadow_file: Ast::File = parse_for_ir(shadow_source)
        shadowed: LowerResult = lower_file(shadow_file, "shadowed-join")
        assert shadowed.issues.count == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Join) == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Call) == 1

        invalid_source: static u8& = "def wrong() -> sview:\n    return join([1, 2], \",\")\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-text-join")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_known_direct_calls() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> i64:\n    return inc(41)\n\ndef inc(x: i64) -> i64:\n    return x + 1\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "calls")

        assert lowered.issues.count == 0
        assert lowered.module.functions.count == 2
        assert lowered.module.functions[0].instruction_pool[1].opcode == Opcode.Call
        assert lowered.module.functions[0].instruction_pool[1].symbol == "inc"
        assert verify(lowered.module).count == 0


@test
def lowers_named_and_default_arguments_in_signature_order() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def combine(a: i64, b: i64 = 2, c: i64 = a + b) -> i64:\n    return a * 100 + b * 10 + c\n\ndef calls() -> i64:\n    return combine(c: 10, a: 1) + combine(3) + combine(4, c: 9)\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "call-arguments")

        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.Call) == 3
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def target(a: i64, b: i64 = 2) -> i64:\n    return a + b\n\ndef duplicate() -> i64:\n    return target(1, a: 2)\n\ndef unknown() -> i64:\n    return target(nope: 1)\n\ndef missing() -> i64:\n    return target()\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-call-arguments")
        assert invalid.issues.count == 4
        for issue in invalid.issues:
            assert issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_pass_as_a_control_flow_no_op() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def idle(select: bool) -> i64:\n    pass\n    if select:\n        pass\n    while false:\n        pass\n    return 7\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "pass")

        assert lowered.issues.count == 0
        assert lowered.module.functions[0].instruction_pool.count == 2
        assert verify(lowered.module).count == 0


@test
def lowers_mutable_array_iteration_through_owned_element_updates() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def mutate() -> darray[i64]:\n    values: mutable darray[i64] = [1, 2, 3]\n    for mutable value in values:\n        value += 1\n    return values\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "mutable-for")

        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.SetIndex) == 1
        assert lowered.module.functions[0].block_parameter_pool.count >= 3
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def immutable_owner() -> void:\n    values: darray[i64] = [1]\n    for mutable value in values:\n        value <- 2\n\ndef temporary_owner() -> void:\n    for mutable value in [1, 2]:\n        value <- 3\n\ndef text_owner() -> void:\n    text: mutable sview = \"ab\"\n    for mutable character in text:\n        character <- 'c'\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-mutable-for")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.ImmutableBinding
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.UnsupportedStatement
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def direct_calls_propagate_effect_and_error_contracts() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def caller() -> void:\n    risky()\n\ndef risky() -> void error[RunError] can[Process.Run]:\n    signal Process.Run\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "call-contracts")
        caller: Function = lowered.module.functions[0]

        assert lowered.issues.count == 0
        assert caller.effects.count == 1
        assert caller.effects[0] == "Process.Run"
        assert caller.errors.count == 1
        assert caller.errors[0] == "RunError"
        assert verify(lowered.module).count == 0


@test
def source_type_mismatches_are_structured_lowering_issues() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def identity(value: i64) -> i64:\n    return value\n\ndef bad_operator() -> i64:\n    return 1 + true\n\ndef bad_bitwise() -> f64:\n    return 1.0 & 2.0\n\ndef bad_compound() -> bool:\n    value: mutable bool = true\n    value += false\n    return value\n\ndef bad_if() -> void:\n    if 1:\n        observe(1)\n\ndef bad_return() -> i64:\n    return true\n\ndef bad_call() -> i64:\n    return identity(true)\n\ndef bad_assignment() -> i64:\n    value: mutable i64 = 1\n    value <- false\n    return value\n\ndef bad_binding() -> i64:\n    value: i64 = true\n    return 0\n\ndef bad_conditional() -> i64:\n    return 1 if true else false\n\ndef bad_short_circuit() -> bool:\n    return true and 1\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "type-errors")

        assert lowered.issues.count == 10
        for issue in lowered.issues:
            assert issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_if_with_fallthrough_merge() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def choose(x: bool) -> i64:\n    if x:\n        return 1\n    return 2\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "unsupported")

        assert lowered.issues.count == 0
        assert lowered.module.functions[0].blocks.count == 4
        assert lowered.module.functions[0].blocks[0].terminator.kind == TerminatorKind.Branch
        assert lowered.module.functions[0].blocks[1].terminator.kind == TerminatorKind.Return
        assert lowered.module.functions[0].blocks[2].terminator.kind == TerminatorKind.Jump
        assert lowered.module.functions[0].blocks[3].terminator.kind == TerminatorKind.Return
        assert verify(lowered.module).count == 0


@test
def lowers_while_with_header_backedge_and_exit() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def wait_or_return(ready: bool) -> i64:\n    while ready:\n        return 1\n    return 0\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "loop")

        assert lowered.issues.count == 0
        assert lowered.module.functions[0].blocks.count == 4
        assert lowered.module.functions[0].blocks[0].terminator.kind == TerminatorKind.Jump
        assert lowered.module.functions[0].blocks[1].terminator.kind == TerminatorKind.Branch
        assert verify(lowered.module).count == 0


@test
def lowers_array_for_loop_to_typed_cfg() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def sum() -> i64:\n    total: mutable i64 = 0\n    for value in [1, 2, 3]:\n        total += value\n    return total\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "for-loop")
        fn: Function = lowered.module.functions[0]

        assert lowered.issues.count == 0
        assert fn.blocks.count == 5
        assert opcode_count(fn.instruction_pool, Opcode.Length) == 1
        assert opcode_count(fn.instruction_pool, Opcode.Index) == 1
        assert verify(lowered.module).count == 0


@test
def lowers_text_index_count_and_iteration_to_verified_collection_ir() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def inspect(value: sview) -> char:\n    observe(value.count)\n    for character in value:\n        observe(character)\n    return value[0]\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "text-collections")

        assert lowered.issues.count == 0
        fn: Function = lowered.module.functions[0]
        assert opcode_count(fn.instruction_pool, Opcode.Length) == 2
        assert opcode_count(fn.instruction_pool, Opcode.Index) == 2
        assert verify(lowered.module).count == 0


@test
def lowers_typed_open_and_closed_collection_slices() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def text_parts(value: sview) -> usize:\n    observe(value[1:3])\n    observe(value[:2])\n    observe(value[2:])\n    return value[:].count\n\ndef array_part(values: darray[i64]) -> darray[i64]:\n    return values[1:2]\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "slices")

        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.Slice) == 4
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.Length) == 3
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.Slice) == 1
        assert verify(lowered.module).count == 0


@test
def lowers_exact_typed_array_and_text_concatenation() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        valid_source: static u8& = "def text(left: sview, right: sview) -> sview:\n    return left + right\n\ndef arrays(left: darray[i64], right: darray[i64]) -> darray[i64]:\n    return left + right\n"
        valid_file: Ast::File = parse_for_ir(valid_source)
        valid: LowerResult = lower_file(valid_file, "concatenation")

        assert valid.issues.count == 0
        assert opcode_count(valid.module.functions[0].instruction_pool, Opcode.Concat) == 1
        assert opcode_count(valid.module.functions[1].instruction_pool, Opcode.Concat) == 1
        assert opcode_count(valid.module.functions[0].instruction_pool, Opcode.Add) == 0
        assert verify(valid.module).count == 0

        invalid_source: static u8& = "def mismatch() -> darray[i64]:\n    return [1] + [\"wrong\"]\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-concatenation")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_array_push_and_extend_as_control_flow_visible_ssa_rebinding() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        valid_source: static u8& = "def build(include_more: bool) -> darray[i64]:\n    values: mutable darray[i64] = []\n    values.push(1)\n    if include_more:\n        values.extend([2, 3])\n    return values\n\ndef looped(limit: i64) -> darray[i64]:\n    values: mutable darray[i64] = []\n    for value in 0..<limit:\n        values.push(value)\n    return values\n"
        valid_file: Ast::File = parse_for_ir(valid_source)
        valid: LowerResult = lower_file(valid_file, "array-growth")

        assert valid.issues.count == 0
        assert opcode_count(valid.module.functions[0].instruction_pool, Opcode.Concat) == 2
        assert opcode_count(valid.module.functions[1].instruction_pool, Opcode.Concat) == 1
        assert valid.module.functions[0].block_parameter_pool.count >= 1
        assert valid.module.functions[1].block_parameter_pool.count >= 2
        assert verify(valid.module).count == 0

        invalid_source: static u8& = "def wrong_value() -> void:\n    values: mutable darray[i64] = []\n    values.push(\"wrong\")\n\ndef wrong_array() -> void:\n    values: mutable darray[i64] = []\n    values.extend([\"wrong\"])\n\ndef wrong_receiver() -> void:\n    text: sview = \"hello\"\n    text.push('!')\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-array-growth")
        assert invalid.issues.count >= 3
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_typed_membership_and_rejects_mismatched_needles() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        valid_source: static u8& = "def contains(value: i64, character: char, text: sview) -> bool:\n    observe(value in [1, 2, 3])\n    return character not in text\n"
        valid_file: Ast::File = parse_for_ir(valid_source)
        valid: LowerResult = lower_file(valid_file, "membership")

        assert valid.issues.count == 0
        assert opcode_count(valid.module.functions[0].instruction_pool, Opcode.Contains) == 2
        assert opcode_count(valid.module.functions[0].instruction_pool, Opcode.Not) == 1
        assert verify(valid.module).count == 0

        invalid_source: static u8& = "def invalid() -> bool:\n    return 1 in \"abc\"\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-membership")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_numeric_range_membership_to_ordered_cfg() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        valid_source: static u8& = "def exclusive(value: i64, limit: i64) -> bool:\n    observe(value in 0..<limit)\n    observe(value in -2..=2)\n    observe(value in 5..>0)\n    return value not in 1..<4\n"
        valid_file: Ast::File = parse_for_ir(valid_source)
        valid: LowerResult = lower_file(valid_file, "range-membership")
        fn: Function = valid.module.functions[0]

        assert valid.issues.count == 0
        assert opcode_count(fn.instruction_pool, Opcode.Contains) == 0
        assert opcode_count(fn.instruction_pool, Opcode.GreaterEqual) == 3
        assert opcode_count(fn.instruction_pool, Opcode.Less) == 2
        assert opcode_count(fn.instruction_pool, Opcode.LessEqual) == 2
        assert opcode_count(fn.instruction_pool, Opcode.Greater) == 1
        assert opcode_count(fn.instruction_pool, Opcode.Not) == 1
        assert verify(valid.module).count == 0

        strided_source: static u8& = "def strided(value: i64) -> bool:\n    return value in 0..<10..2\n"
        strided_file: Ast::File = parse_for_ir(strided_source)
        strided: LowerResult = lower_file(strided_file, "strided-range-membership")
        strided_fn: Function = strided.module.functions[0]
        assert strided.issues.count == 0
        assert opcode_count(strided_fn.instruction_pool, Opcode.Subtract) == 1
        assert opcode_count(strided_fn.instruction_pool, Opcode.Remainder) == 1
        assert opcode_count(strided_fn.instruction_pool, Opcode.Equal) == 1
        assert verify(strided.module).count == 0

        invalid_stride_source: static u8& = "def zero(value: i64) -> bool:\n    return value in 0..<10..0\n\ndef dynamic(value: i64, stride: i64) -> bool:\n    return value in 0..<10..stride\n"
        invalid_stride_file: Ast::File = parse_for_ir(invalid_stride_source)
        invalid_stride: LowerResult = lower_file(invalid_stride_file, "invalid-strided-range-membership")
        assert invalid_stride.issues.count >= 2
        assert any issue in invalid_stride.issues where issue.kind == LowerIssueKind.TypeMismatch

        mismatch_source: static u8& = "def mismatch(value: sview) -> bool:\n    return value in 0..<10\n"
        mismatch_file: Ast::File = parse_for_ir(mismatch_source)
        mismatch: LowerResult = lower_file(mismatch_file, "mismatched-range-membership")
        assert any issue in mismatch.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def range_for_requires_a_positive_constant_stride() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
