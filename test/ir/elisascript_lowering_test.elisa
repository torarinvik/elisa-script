@test
def lowers_typed_sleep_units_and_aliases() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def pause(seconds: f64, milliseconds: u64) -> void:\n    sleep(seconds)\n    sleep_seconds(seconds)\n    sleep_milliseconds(milliseconds)\n    sleep_ms(milliseconds)\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "sleep")
        fn: Function = lowered.module.functions[0]
        seconds_count: mutable usize = 0
        milliseconds_count: mutable usize = 0
        for instruction in fn.instruction_pool |seconds_count, milliseconds_count|:
            if instruction.opcode == Opcode.Sleep:
                seconds_count <- seconds_count + 1 if instruction.integer == 0
                milliseconds_count <- milliseconds_count + 1 if instruction.integer == 1
        assert lowered.issues.count == 0
        assert seconds_count == 2
        assert milliseconds_count == 2
        assert any effect in fn.effects where effect == "Time.Sleep"
        assert any error_name in fn.errors where error_name == "TimeError"
        assert verify(lowered.module).count == 0


@test
def rejects_fractional_millisecond_duration() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def pause() -> void:\n    sleep_milliseconds(1.5)\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "invalid-sleep-milliseconds")
        assert any issue in lowered.issues where issue.kind == LowerIssueKind.TypeMismatch
