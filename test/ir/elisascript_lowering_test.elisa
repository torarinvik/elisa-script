@test
def immutable_bindings_reject_every_ssa_rebinding_surface() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        invalid_source: static u8& = "def assign() -> i64:\n    value: i64 = 1\n    value <- 2\n    return value\n\ndef compound() -> i64:\n    value: i64 = 1\n    value += 2\n    return value\n\ndef push() -> usize:\n    values: darray[i64] = []\n    values.push(1)\n    return values.count\n\ndef extend() -> usize:\n    values: darray[i64] = []\n    values.extend([1])\n    return values.count\n\ndef parameter(value: i64) -> i64:\n    value <- 2\n    return value\n\ndef loop_binder() -> void:\n    for value in [1]:\n        value <- 2\n\ndef match_binder(value: i64) -> void:\n    match value:\n        item:\n            item <- 2\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "immutable-rebinding")

        immutable_count: mutable usize = 0
        for issue in invalid.issues |immutable_count|:
            immutable_count <- immutable_count + 1 if issue.kind == LowerIssueKind.ImmutableBinding
        assert immutable_count == 7

        valid_source: static u8& = "def parameter(value: mutable i64) -> i64:\n    value <- value + 1\n    return value\n"
        valid_file: Ast::File = parse_for_ir(valid_source)
        valid: LowerResult = lower_file(valid_file, "mutable-parameter")
        assert valid.issues.count == 0
        assert verify(valid.module).count == 0


@test
def lowers_indexed_array_update_as_owned_ssa_rebinding() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        valid_source: static u8& = "def branch(change: bool) -> darray[i64]:\n    values: mutable darray[i64] = [1, 2, 3]\n    if change:\n        values[1] += 7\n    return values\n\ndef looped() -> darray[i64]:\n    values: mutable darray[i64] = [4, 5, 6]\n    for index in 0..<3:\n        values[index] += index\n    return values\n"
        valid_file: Ast::File = parse_for_ir(valid_source)
        valid: LowerResult = lower_file(valid_file, "indexed-update")

        assert valid.issues.count == 0
        assert opcode_count(valid.module.functions[0].instruction_pool, Opcode.SetIndex) == 1
        assert opcode_count(valid.module.functions[1].instruction_pool, Opcode.SetIndex) == 1
        assert opcode_count(valid.module.functions[0].instruction_pool, Opcode.Index) == 1
        assert opcode_count(valid.module.functions[1].instruction_pool, Opcode.Index) == 1
        assert opcode_count(valid.module.functions[0].instruction_pool, Opcode.Add) == 1
        assert opcode_count(valid.module.functions[1].instruction_pool, Opcode.Add) >= 1
        assert valid.module.functions[0].block_parameter_pool.count >= 1
        assert valid.module.functions[1].block_parameter_pool.count >= 2
        assert verify(valid.module).count == 0

        invalid_source: static u8& = "def immutable() -> void:\n    values: darray[i64] = [1]\n    values[0] <- 2\n\ndef receiver() -> void:\n    value: mutable i64 = 1\n    value[0] <- 2\n\ndef index_type() -> void:\n    values: mutable darray[i64] = [1]\n    values[true] <- 2\n\ndef element_type() -> void:\n    values: mutable darray[i64] = [1]\n    values[0] <- \"wrong\"\n\ndef arithmetic_type() -> void:\n    values: mutable darray[bool] = [true]\n    values[0] += false\n\ndef bitwise_type() -> void:\n    values: mutable darray[f64] = [1.0]\n    values[0] &= 2.0\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-indexed-update")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.ImmutableBinding
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


