@test
def lowers_len_builtin_to_typed_length_and_preserves_shadowing() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def lengths(values: darray[i64], mapping: dict[sview, i64], text: sview) -> usize:\n    return len(values) + len(mapping) + len(text)\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "len-builtin")

        assert lowered.issues.count == 0
        fn: Function = lowered.module.functions[0]
        assert opcode_count(fn.instruction_pool, Opcode.Length) == 3
        assert opcode_count(fn.instruction_pool, Opcode.Call) == 0
        assert fn.return_type.kind == TypeKind.Int
        assert fn.return_type.bits == 64
        assert not fn.return_type.signed
        assert verify(lowered.module).count == 0

        shadow_source: static u8& = "def len(values: darray[i64]) -> usize:\n    return 99u64\n\ndef use_shadow(values: darray[i64]) -> usize:\n    return len(values)\n"
        shadow_file: Ast::File = parse_for_ir(shadow_source)
        shadowed: LowerResult = lower_file(shadow_file, "shadowed-len")
        assert shadowed.issues.count == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Length) == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Call) == 1
        assert verify(shadowed.module).count == 0


