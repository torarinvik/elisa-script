@test
def lowers_line_oriented_file_helpers_to_existing_text_ir() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def load(path_value: Path) -> darray[sview]:\n    return read_lines(path_value)\n\ndef save(path_value: Path, lines: darray[sview]) -> usize:\n    return write_lines(path_value, lines)\n\ndef append(path_value: Path, lines: darray[sview]) -> usize:\n    return append_lines(path_value, lines)\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "line-files")
        load_fn: Function = lowered.module.functions[0]
        save_fn: Function = lowered.module.functions[1]
        append_fn: Function = lowered.module.functions[2]
        assert lowered.issues.count == 0
        assert opcode_count(load_fn.instruction_pool, Opcode.ReadText) == 1
        assert opcode_count(load_fn.instruction_pool, Opcode.Split) == 1
        assert opcode_count(save_fn.instruction_pool, Opcode.Join) == 1
        assert opcode_count(save_fn.instruction_pool, Opcode.WriteText) == 1
        assert opcode_count(append_fn.instruction_pool, Opcode.Join) == 1
        assert opcode_count(append_fn.instruction_pool, Opcode.AppendText) == 1
        assert any effect in load_fn.effects where effect == "File.Read"
        assert any error_name in load_fn.errors where error_name == "FileIoError"
        assert any effect in save_fn.effects where effect == "File.Write"
        assert any error_name in save_fn.errors where error_name == "FileIoError"
        assert any effect in append_fn.effects where effect == "File.Write"
        assert any error_name in append_fn.errors where error_name == "FileIoError"
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def wrong(value: sview) -> darray[sview]:\n    return read_lines(value)\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-read-lines")
