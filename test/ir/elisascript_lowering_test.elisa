@test
def lowers_exact_typed_array_structural_equality() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def same(left: darray[i64], right: darray[i64]) -> bool:\n    return left == right\n\ndef differs(left: darray[sview], right: darray[sview]) -> bool:\n    return left != right\n"
