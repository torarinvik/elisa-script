def lowers_python_input_to_prompt_and_line_read_state() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def plain() -> sview:\n    return input()\n\ndef prompted() -> sview:\n    return input(\"name: \")\n\ndef direct_line() -> sview:\n    return read_stdin_line()\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "input")
        assert lowered.issues.count == 0
        plain: Function = lowered.module.functions[0]
        prompted: Function = lowered.module.functions[1]
        direct_line: Function = lowered.module.functions[2]
        assert opcode_count(plain.instruction_pool, Opcode.ReadStdinLine) == 1
        assert opcode_count(prompted.instruction_pool, Opcode.WriteStdout) == 1
        assert opcode_count(prompted.instruction_pool, Opcode.ReadStdinLine) == 1
        assert opcode_count(direct_line.instruction_pool, Opcode.ReadStdinLine) == 1
        assert any effect in plain.effects where effect == "Console.Read"
        assert any effect in prompted.effects where effect == "Console.Read"
        assert any effect in prompted.effects where effect == "Console.Write"
        assert any error_name in prompted.errors where error_name == "ConsoleError"
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def bad(value: i64) -> sview:\n    return input(value)\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-input")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_python_print_to_typed_stdout_state() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> usize:\n    return print(\"value\", 7i64, false)\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "print")
        fn: Function = lowered.module.functions[0]
        assert lowered.issues.count == 0
        assert opcode_count(fn.instruction_pool, Opcode.FormatInt) == 1
        assert opcode_count(fn.instruction_pool, Opcode.FormatBool) == 1
        assert opcode_count(fn.instruction_pool, Opcode.Concat) == 6
        assert opcode_count(fn.instruction_pool, Opcode.WriteStdout) == 1
        assert any effect in fn.effects where effect == "Console.Write"
        assert any error_name in fn.errors where error_name == "ConsoleError"
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def bad() -> usize:\n    return print(file: \"value\")\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-print")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


