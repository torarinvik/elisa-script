@test
def lowers_pure_typed_path_composition_and_decomposition() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def combine(base: Path, leaf: sview) -> Path:\n    return path_join(base, leaf)\n\ndef parent(path_value: Path) -> Path:\n    return path_parent(path_value)\n\ndef parent_alias(path_value: Path) -> Path:\n    return dirname(path_value)\n\ndef name(path_value: Path) -> sview:\n    return path_name(path_value)\n\ndef name_alias(path_value: Path) -> sview:\n    return basename(path_value)\n\ndef extension(path_value: Path) -> sview:\n    return path_extension(path_value)\n\ndef suffix_alias(path_value: Path) -> sview:\n    return suffix(path_value)\n\ndef stem_value(path_value: Path) -> sview:\n    return path_stem(path_value)\n\ndef stem_alias(path_value: Path) -> sview:\n    return stem(path_value)\n\ndef directory_alias(path_value: Path) -> bool:\n    return is_dir(path_value)\n\ndef parent_property(path_value: Path) -> Path:\n    return path_value.parent\n\ndef name_property(path_value: Path) -> sview:\n    return path_value.name\n\ndef suffix_property(path_value: Path) -> sview:\n    return path_value.suffix\n\ndef stem_property(path_value: Path) -> sview:\n    return path_value.stem\n\ndef join_method(base: Path, leaf: sview) -> Path:\n    return base.joinpath(leaf)\n\ndef exists_method(path_value: Path) -> bool:\n    return path_value.exists()\n\ndef directory_method(path_value: Path) -> bool:\n    return path_value.is_dir()\n\ndef file_predicate(path_value: Path) -> bool:\n    return is_file(path_value)\n\ndef file_method(path_value: Path) -> bool:\n    return path_value.is_file()\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "path-shape")
        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.PathJoin) == 1
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.PathParent) == 1
        assert opcode_count(lowered.module.functions[2].instruction_pool, Opcode.PathParent) == 1
        assert opcode_count(lowered.module.functions[3].instruction_pool, Opcode.PathName) == 1
        assert opcode_count(lowered.module.functions[4].instruction_pool, Opcode.PathName) == 1
        assert opcode_count(lowered.module.functions[5].instruction_pool, Opcode.PathExtension) == 1
        assert opcode_count(lowered.module.functions[6].instruction_pool, Opcode.PathExtension) == 1
        assert opcode_count(lowered.module.functions[7].instruction_pool, Opcode.PathStem) == 1
        assert opcode_count(lowered.module.functions[8].instruction_pool, Opcode.PathStem) == 1
        assert opcode_count(lowered.module.functions[9].instruction_pool, Opcode.IsDirectory) == 1
        assert opcode_count(lowered.module.functions[10].instruction_pool, Opcode.PathParent) == 1
        assert opcode_count(lowered.module.functions[11].instruction_pool, Opcode.PathName) == 1
        assert opcode_count(lowered.module.functions[12].instruction_pool, Opcode.PathExtension) == 1
        assert opcode_count(lowered.module.functions[13].instruction_pool, Opcode.PathStem) == 1
        assert opcode_count(lowered.module.functions[14].instruction_pool, Opcode.PathJoin) == 1
        assert opcode_count(lowered.module.functions[15].instruction_pool, Opcode.PathExists) == 1
        assert opcode_count(lowered.module.functions[16].instruction_pool, Opcode.IsDirectory) == 1
        assert any effect in lowered.module.functions[15].effects where effect == "File.Read"
        assert any effect in lowered.module.functions[16].effects where effect == "Directory.Read"
        assert any error_name in lowered.module.functions[16].errors where error_name == "DirectoryError"
        assert opcode_count(lowered.module.functions[17].instruction_pool, Opcode.IsFile) == 1
        assert opcode_count(lowered.module.functions[18].instruction_pool, Opcode.IsFile) == 1
        assert any effect in lowered.module.functions[17].effects where effect == "File.Read"
        assert any effect in lowered.module.functions[18].effects where effect == "File.Read"
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def wrong(value: sview) -> Path:\n    return path_parent(value)\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-path-shape")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


