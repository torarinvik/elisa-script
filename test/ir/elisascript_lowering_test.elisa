@test
def lowers_shell_filesystem_aliases_to_typed_operations() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def cwd() -> Path:\n    return pwd()\n\ndef dirs(path_value: Path) -> bool:\n    first: bool = mkdir(path_value)\n    changed: bool = cd(path_value)\n    restored: bool = cd(pwd())\n    removed: bool = rmdir(path_value)\n    return first and changed and restored and removed\n\ndef files(source: Path, destination: Path) -> bool:\n    removed: bool = rm(source)\n    copied: bool = cp(source, destination)\n    moved: bool = mv(source, destination)\n    return removed and copied and moved\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "filesystem-aliases")
        assert lowered.issues.count == 0
        cwd: Function = lowered.module.functions[0]
        dirs: Function = lowered.module.functions[1]
        files: Function = lowered.module.functions[2]
        assert opcode_count(cwd.instruction_pool, Opcode.CurrentDirectory) == 1
        assert opcode_count(dirs.instruction_pool, Opcode.CreateDirectory) == 1
        assert opcode_count(dirs.instruction_pool, Opcode.ChangeDirectory) == 2
        assert opcode_count(dirs.instruction_pool, Opcode.RemoveDirectory) == 1
        assert opcode_count(files.instruction_pool, Opcode.RemovePath) == 1
        assert opcode_count(files.instruction_pool, Opcode.CopyPath) == 1
        assert opcode_count(files.instruction_pool, Opcode.MovePath) == 1
        assert verify(lowered.module).count == 0

        shadow_source: static u8& = "def pwd() -> Path:\n    return path\"shadow\"\n\ndef call_shadow() -> Path:\n    return pwd()\n"
        shadow_file: Ast::File = parse_for_ir(shadow_source)
        shadowed: LowerResult = lower_file(shadow_file, "shadowed-pwd")
        assert shadowed.issues.count == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.CurrentDirectory) == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Call) == 1


