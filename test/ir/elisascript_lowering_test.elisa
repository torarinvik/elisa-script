@test
def continue_preserves_handler_surrounding_loop() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def run(again: bool) -> void:\n    with handler outer:\n        while again:\n            with handler inner:\n                continue\n        return\n"
        file: Ast::File = parse_for_ir(source)
        outer: Handler = Handler{name: "outer", handles: ["Process"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear}
        inner: Handler = Handler{name: "inner", handles: ["File"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear}
        handlers: darray[Handler] = [outer, inner]
        lowered: LowerResult = lower_file_with_handlers(file, "continue-unwind", handlers)
        fn: Function = lowered.module.functions[0]

        assert lowered.issues.count == 0
        assert opcode_count(fn.instruction_pool, Opcode.HandlerPush) == 2
        assert opcode_count(fn.instruction_pool, Opcode.HandlerPop) == 2
        assert verify(lowered.module).count == 0
