@test
def lowers_typed_open_and_closed_collection_slices() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def text_parts(value: sview) -> usize:\n    observe(value[1:3])\n    observe(value[:2])\n    observe(value[2:])\n    return value[:].count\n\ndef array_part(values: darray[i64]) -> darray[i64]:\n    return values[1:2]\n"
