@test
def lowers_mutable_array_iteration_through_owned_element_updates() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def mutate() -> darray[i64]:\n    values: mutable darray[i64] = [1, 2, 3]\n    for mutable value in values:\n        value += 1\n    return values\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "mutable-for")

        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.SetIndex) == 1
        assert lowered.module.functions[0].block_parameter_pool.count >= 3
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def immutable_owner() -> void:\n    values: darray[i64] = [1]\n    for mutable value in values:\n        value <- 2\n\ndef temporary_owner() -> void:\n    for mutable value in [1, 2]:\n        value <- 3\n\ndef text_owner() -> void:\n    text: mutable sview = \"ab\"\n    for mutable character in text:\n        character <- 'c'\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-mutable-for")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.ImmutableBinding
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.UnsupportedStatement
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def direct_calls_propagate_effect_and_error_contracts() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def caller() -> void:\n    risky()\n\ndef risky() -> void error[RunError] can[Process.Run]:\n    signal Process.Run\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "call-contracts")
        caller: Function = lowered.module.functions[0]

        assert lowered.issues.count == 0
        assert caller.effects.count == 1
        assert caller.effects[0] == "Process.Run"
        assert caller.errors.count == 1
        assert caller.errors[0] == "RunError"
        assert verify(lowered.module).count == 0


@test
def direct_calls_preserve_multiple_declared_error_families() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def caller() -> void:\n    risky()\n\ndef risky() -> void error[FileIoError, ProcessError]:\n    pass\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "multiple-error-contracts")
        caller: Function = lowered.module.functions[0]
        risky: Function = lowered.module.functions[1]

        assert lowered.issues.count == 0
        assert risky.errors.count == 2
        assert risky.errors[0] == "FileIoError"
        assert risky.errors[1] == "ProcessError"
        assert caller.errors.count == 2
        assert caller.errors[0] == "FileIoError"
        assert caller.errors[1] == "ProcessError"
        assert verify(lowered.module).count == 0


@test
def source_type_mismatches_are_structured_lowering_issues() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def identity(value: i64) -> i64:\n    return value\n\ndef bad_operator() -> i64:\n    return 1 + true\n\ndef bad_bitwise() -> f64:\n    return 1.0 & 2.0\n\ndef bad_compound() -> bool:\n    value: mutable bool = true\n    value += false\n    return value\n\ndef bad_if() -> void:\n    if 1:\n        observe(1)\n\ndef bad_return() -> i64:\n    return true\n\ndef bad_call() -> i64:\n    return identity(true)\n\ndef bad_assignment() -> i64:\n    value: mutable i64 = 1\n    value <- false\n    return value\n\ndef bad_binding() -> i64:\n    value: i64 = true\n    return 0\n\ndef bad_conditional() -> i64:\n    return 1 if true else false\n\ndef bad_short_circuit() -> bool:\n    return true and 1\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "type-errors")

        assert lowered.issues.count == 10
        for issue in lowered.issues:
            assert issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_if_with_fallthrough_merge() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def choose(x: bool) -> i64:\n    if x:\n        return 1\n    return 2\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "unsupported")

        assert lowered.issues.count == 0
        assert lowered.module.functions[0].blocks.count == 4
        assert lowered.module.functions[0].blocks[0].terminator.kind == TerminatorKind.Branch
        assert lowered.module.functions[0].blocks[1].terminator.kind == TerminatorKind.Return
        assert lowered.module.functions[0].blocks[2].terminator.kind == TerminatorKind.Jump
        assert lowered.module.functions[0].blocks[3].terminator.kind == TerminatorKind.Return
        assert verify(lowered.module).count == 0


