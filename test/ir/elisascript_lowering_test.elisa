        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.Length) == 0
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.RangeCondition) == 1
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.Length) == 0
        assert opcode_count(lowered.module.functions[2].instruction_pool, Opcode.RangeCondition) == 1
        assert any error_name in lowered.module.functions[0].errors where error_name == "RangeStepZero"
        assert any error_name in lowered.module.functions[1].errors where error_name == "RangeStepZero"
        assert any error_name in lowered.module.functions[2].errors where error_name == "RangeStepZero"
        assert verify(lowered.module).count == 0


