@test
def lowers_python_text_method_aliases() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def methods(value: sview) -> bool:\n    return value.startswith(\"a\") and value.endswith(\"z\")\n\ndef rewrite(value: sview) -> sview:\n    return value.replace(\"x\", \"y\").strip()\n\ndef fields(value: sview) -> darray[sview]:\n    return value.split(\",\")\n"
