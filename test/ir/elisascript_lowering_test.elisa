        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "bad-range")

        assert lowered.issues.count == 1
        assert lowered.issues[0].kind == LowerIssueKind.TypeMismatch


@test
def scalar_match_rejects_structural_patterns_not_yet_representable_in_ir() -> void:
