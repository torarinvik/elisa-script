include "../../src/ir/ir.elisa"

using Ast
using EsIr


def parse_for_ir(source: u8&) -> Ast::File:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        tokens: darray[Lexer::Token] = frontend_tokenize("test.elisascript", source)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        assert file.errors.count == 0
        return file


def opcode_count(instructions: darray[Instruction]&, opcode: Opcode) -> usize:
    count: mutable usize = 0
    for instruction in instructions |count, opcode|:
        count <- count + 1 if instruction.opcode == opcode
    return count


def opcode_has_operand_count(instructions: darray[Instruction]&, opcode: Opcode, count: u16) -> bool:
    return any instruction in instructions where instruction.opcode == opcode and instruction.operand_count == count


@test
def lowers_typed_runtime_assertion() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def check(value: bool) -> void:\n    assert(value)\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "assertion")

        assert lowered.issues.count == 0
        assert lowered.module.functions.count == 1
        function: Function = lowered.module.functions[0]
        assert opcode_count(function.instruction_pool, Opcode.Assert) == 1
        assert function.instruction_pool[0].result == 0
        assert function.instruction_pool[0].result_type.kind == TypeKind.Void
        assert any error_name in function.errors where error_name == "AssertionError"
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def wrong() -> void:\n    assert(1i64)\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "invalid-assertion")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch

        void_recovery_source: static u8& = "def no_op(value: bool) -> void:\n    try assert(value) else void\n\ndef terminating(value: bool) -> void:\n    try assert(value) else return\n"
        void_recovery_file: Ast::File = parse_for_ir(void_recovery_source)
        void_recovery: LowerResult = lower_file(void_recovery_file, "void-assertion-recovery")
        assert void_recovery.issues.count == 0
        assert void_recovery.module.functions.count == 2
        assert opcode_count(void_recovery.module.functions[0].instruction_pool, Opcode.ErrorGuardPush) == 1
        assert opcode_count(void_recovery.module.functions[0].instruction_pool, Opcode.ErrorGuardPop) == 1
        assert opcode_count(void_recovery.module.functions[1].instruction_pool, Opcode.ErrorGuardPush) == 1
        assert opcode_count(void_recovery.module.functions[1].instruction_pool, Opcode.ErrorGuardPop) == 1
        assert verify(void_recovery.module).count == 0


@test
def lowers_typed_arithmetic_bindings_and_return() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def add_twice(x: i64, y: i64) -> i64:\n    sum: i64 = x + y\n    return sum * 2\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "arithmetic")

        assert lowered.issues.count == 0
        assert lowered.module.functions.count == 1
        assert lowered.module.functions[0].parameters.count == 2
        assert lowered.module.functions[0].parameters[0].type.descriptor_id != 0
        assert lowered.module.functions[0].parameters[1].type.descriptor_id == lowered.module.functions[0].parameters[0].type.descriptor_id
        assert type_table_valid(lowered.module.type_table)
        assert lowered.module.functions[0].blocks[0].instruction_count == 3
        assert lowered.module.functions[0].blocks[0].terminator.operand_count == 1
        assert verify(lowered.module).count == 0


@test
def lowers_explicit_integer_suffixes_to_exact_ir_types() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def byte_sum() -> u8:\n    return 1u8 + 2u8\n\ndef count_is_three(values: darray[sview]) -> bool:\n    return values.count == 3u64\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "integer-suffixes")
        assert lowered.issues.count == 0
        assert lowered.module.functions[0].instruction_pool[0].result_type.bits == 8
        assert not lowered.module.functions[0].instruction_pool[0].result_type.signed
        assert verify(lowered.module).count == 0

        mismatch_source: static u8& = "def mismatch() -> u8:\n    return 1u8 + 2u16\n"
        mismatch_file: Ast::File = parse_for_ir(mismatch_source)
        mismatch: LowerResult = lower_file(mismatch_file, "mixed-integer-suffixes")
        assert any issue in mismatch.issues where issue.kind == LowerIssueKind.TypeMismatch

        boundary_source: static u8& = "def signed_min() -> i8:\n    return -128i8\n\ndef unsigned_max() -> u8:\n    return 255u8\n"
        boundary_file: Ast::File = parse_for_ir(boundary_source)
        boundaries: LowerResult = lower_file(boundary_file, "integer-boundaries")
        assert boundaries.issues.count == 0
        assert verify(boundaries.module).count == 0

        overflow_source: static u8& = "def signed_high() -> i8:\n    return 128i8\n\ndef unsigned_high() -> u8:\n    return 256u8\n\ndef unsigned_negative() -> u8:\n    return -1u8\n\ndef signed_low() -> i8:\n    return -129i8\n"
        overflow_file: Ast::File = parse_for_ir(overflow_source)
        overflowed: LowerResult = lower_file(overflow_file, "integer-overflow")
        assert overflowed.issues.count == 4
        for issue in overflowed.issues:
            assert issue.kind == LowerIssueKind.TypeMismatch

        unsigned_negation_source: static u8& = "def negate(value: u8) -> u8:\n    return -value\n"
        unsigned_negation_file: Ast::File = parse_for_ir(unsigned_negation_source)
        unsigned_negation: LowerResult = lower_file(unsigned_negation_file, "unsigned-negation")
        assert any issue in unsigned_negation.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_typed_abs_through_state_machine() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def integer(value: i64) -> i64:\n    return abs(value)\n\ndef decimal(value: f64) -> f64:\n    return abs(value)\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "abs")

        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.Less) == 1
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.Negate) == 1
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.Less) == 1
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.Negate) == 1
        assert lowered.module.functions[0].blocks.count == 4
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def unsigned(value: u64) -> u64:\n    return abs(value)\n\ndef text(value: sview) -> sview:\n    return abs(value)\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-abs")
        assert invalid.issues.count == 2

        shadow_source: static u8& = "def abs(value: i64) -> i64:\n    return value + 1\n\ndef call_shadow(value: i64) -> i64:\n    return abs(value)\n"
        shadow_file: Ast::File = parse_for_ir(shadow_source)
        shadowed: LowerResult = lower_file(shadow_file, "shadowed-abs")
        assert shadowed.issues.count == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Call) == 1
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Less) == 0


@test
def lowers_compiler_known_typed_literals_as_nominal_constants() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def keep(value: Path) -> Path:\n    return value\n\ndef literals() -> bool:\n    path_value: Path = path\"src/main.elisa\"\n    glob_value: Glob = glob\"src/**/*.elisa\"\n    regex_value: Regex = regex\"[a-z]+\"\n    executable: Executable = exe\"elisac\"\n    endpoint: Url = url\"https://example.com\"\n    return keep(path_value) == path\"src/main.elisa\" and glob_value == glob\"src/**/*.elisa\" and regex_value == regex\"[a-z]+\" and executable == exe\"elisac\" and endpoint == url\"https://example.com\"\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "typed-literals")

        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.Constant) >= 10
        assert verify(lowered.module).count == 0

        shadow_source: static u8& = "def path(value: sview) -> i64:\n    return 9\n\ndef shadowed() -> i64:\n    return path\"src\"\n"
        shadow_file: Ast::File = parse_for_ir(shadow_source)
        shadowed: LowerResult = lower_file(shadow_file, "shadowed-typed-literal")
        assert shadowed.issues.count == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Call) == 1
        assert verify(shadowed.module).count == 0

        dynamic_source: static u8& = "def dynamic_path(value: sview) -> Path:\n    return path(value)\n\ndef dynamic_glob(value: sview) -> Glob:\n    return glob(value)\n\ndef dynamic_regex(value: sview) -> Regex:\n    return regex(value)\n\ndef dynamic_url(value: sview) -> Url:\n    return url(value)\n"
        dynamic_file: Ast::File = parse_for_ir(dynamic_source)
        dynamic: LowerResult = lower_file(dynamic_file, "dynamic-typed-literals")
        assert dynamic.issues.count == 0
        assert opcode_count(dynamic.module.functions[0].instruction_pool, Opcode.MakePath) == 1
        assert opcode_count(dynamic.module.functions[1].instruction_pool, Opcode.MakeGlob) == 1
        assert opcode_count(dynamic.module.functions[2].instruction_pool, Opcode.MakeRegex) == 1
        assert opcode_count(dynamic.module.functions[3].instruction_pool, Opcode.MakeUrl) == 1
        assert verify(dynamic.module).count == 0

        invalid_source: static u8& = "def arity() -> Regex:\n    return regex(\"a\", \"b\")\n\ndef mismatch() -> bool:\n    return path\"same\" == regex\"same\"\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-typed-literals")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_typed_integer_conversion() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def parse(value: sview) -> i64:\n    return parse_int(value)\n\ndef format(value: i64) -> sview:\n    return format_int(value)\n\ndef parse_decimal(value: sview) -> f64:\n    return parse_float(value)\n\ndef format_decimal(value: f64) -> sview:\n    return format_float(value)\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "integer-conversion")
        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.ParseInt) == 1
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.FormatInt) == 1
        assert opcode_count(lowered.module.functions[2].instruction_pool, Opcode.ParseFloat) == 1
        assert opcode_count(lowered.module.functions[3].instruction_pool, Opcode.FormatFloat) == 1
        assert any error_name in lowered.module.functions[0].errors where error_name == "ParseError"
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def wrong(value: i64) -> sview:\n    return format_int(value, value)\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-integer-conversion")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_python_str_facade() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def integer(value: i64) -> sview:\n    return str(value)\n\ndef decimal(value: f64) -> sview:\n    return str(value)\n\ndef boolean(value: bool) -> sview:\n    return str(value)\n\ndef text(value: sview) -> sview:\n    return str(value)\n\ndef path_value(value: Path) -> sview:\n    return str(value)\n\ndef glob_value(value: Glob) -> sview:\n    return str(value)\n\ndef regex_value(value: Regex) -> sview:\n    return str(value)\n\ndef executable_value(value: Executable) -> sview:\n    return str(value)\n\ndef url_value(value: Url) -> sview:\n    return str(value)\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "python-str")
        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.FormatInt) == 1
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.FormatFloat) == 1
        assert opcode_count(lowered.module.functions[2].instruction_pool, Opcode.FormatBool) == 1
        assert opcode_count(lowered.module.functions[3].instruction_pool, Opcode.FormatInt) == 0
        assert opcode_count(lowered.module.functions[3].instruction_pool, Opcode.FormatFloat) == 0
        assert opcode_count(lowered.module.functions[3].instruction_pool, Opcode.FormatBool) == 0
        assert opcode_count(lowered.module.functions[4].instruction_pool, Opcode.FormatNominal) == 1
        assert opcode_count(lowered.module.functions[5].instruction_pool, Opcode.FormatNominal) == 1
        assert opcode_count(lowered.module.functions[6].instruction_pool, Opcode.FormatNominal) == 1
        assert opcode_count(lowered.module.functions[7].instruction_pool, Opcode.FormatNominal) == 1
        assert opcode_count(lowered.module.functions[8].instruction_pool, Opcode.FormatNominal) == 1
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def wrong(value: darray[i64]) -> sview:\n    return str(value)\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-python-str")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_python_scalar_constructors() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def int_text(value: sview) -> i64:\n    return int(value)\n\ndef int_identity(value: i64) -> i64:\n    return int(value)\n\ndef float_text(value: sview) -> f64:\n    return float(value)\n\ndef float_identity(value: f64) -> f64:\n    return float(value)\n\ndef bool_identity(value: bool) -> bool:\n    return bool(value)\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "python-scalar-constructors")
        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.ParseInt) == 1
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.ParseInt) == 0
        assert opcode_count(lowered.module.functions[2].instruction_pool, Opcode.ParseFloat) == 1
        assert opcode_count(lowered.module.functions[3].instruction_pool, Opcode.ParseFloat) == 0
        assert opcode_count(lowered.module.functions[4].instruction_pool, Opcode.Call) == 0
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def bad_int(value: f64) -> i64:\n    return int(value)\n\ndef bad_bool(value: sview) -> bool:\n    return bool(value)\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-python-scalar-constructors")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_typed_regex_search() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def find(value: sview) -> bool:\n    return matches(value, regex\"^elisa.*script$\")\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "regex-search")
        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.RegexSearch) == 1
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def wrong(value: sview) -> bool:\n    return matches(regex\"x\", value)\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-regex-search")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch

        shadow_source: static u8& = "def matches(value: sview, pattern: Regex) -> i64:\n    return 4\n\ndef call_shadow() -> i64:\n    return matches(\"x\", regex\"x\")\n"
        shadow_file: Ast::File = parse_for_ir(shadow_source)
        shadowed: LowerResult = lower_file(shadow_file, "shadowed-matches")
        assert shadowed.issues.count == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.RegexSearch) == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Call) == 1


@test
def lowers_typed_text_boundary_predicates() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def prefix(value: sview) -> bool:\n    return starts_with(value, \"elisa\")\n\ndef suffix(value: sview) -> bool:\n    return ends_with(value, \"script\")\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "text-boundaries")
        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.StartsWith) == 1
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.EndsWith) == 1
        assert verify(lowered.module).count == 0

        shadow_source: static u8& = "def starts_with(value: sview, prefix: sview) -> i64:\n    return 7\n\ndef call_shadow() -> i64:\n    return starts_with(\"elisa\", \"eli\")\n"
        shadow_file: Ast::File = parse_for_ir(shadow_source)
        shadowed: LowerResult = lower_file(shadow_file, "shadowed-text-boundary")
        assert shadowed.issues.count == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.StartsWith) == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Call) == 1

        invalid_source: static u8& = "def wrong(value: i64) -> bool:\n    return starts_with(value, \"x\")\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-text-boundary")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


@test
def lowers_typed_literal_text_replacement() -> void:
