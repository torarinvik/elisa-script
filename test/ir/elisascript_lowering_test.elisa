        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.TextReplace) == 0
        assert opcode_count(shadowed.module.functions[1].instruction_pool, Opcode.Call) == 1

        invalid_source: static u8& = "def wrong(value: i64) -> sview:\n    return replace(value, \"old\", \"new\")\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-text-replace")
