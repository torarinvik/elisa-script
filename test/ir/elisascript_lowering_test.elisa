@test
def lowers_typed_dictionary_literals_and_index_updates() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def lookup() -> i64:\n    values: dict[sview, i64] = {\"one\": 1, \"two\": 2}\n    return values[\"two\"]\n\ndef empty() -> usize:\n    values: dict[sview, i64] = {}\n    return values.count\n\ndef update() -> i64:\n    values: mutable dict[sview, i64] = {\"one\": 1}\n    values[\"one\"] <- 2\n    values[\"two\"] <- 3\n    return values[\"one\"] + values[\"two\"]\n\ndef iterate() -> i64:\n    values: dict[sview, i64] = {\"one\": 1, \"two\": 2}\n    total: mutable i64 = 0\n    for key in values:\n        total += values[key]\n    return total\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "dictionary")
        assert lowered.issues.count == 0
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.MakeMap) == 1
        assert opcode_count(lowered.module.functions[0].instruction_pool, Opcode.Index) == 1
        assert opcode_count(lowered.module.functions[1].instruction_pool, Opcode.MakeMap) == 1
        assert lowered.module.functions[1].instruction_pool[0].result_type.kind == TypeKind.Map
        assert opcode_count(lowered.module.functions[2].instruction_pool, Opcode.SetIndex) == 2
        assert opcode_count(lowered.module.functions[3].instruction_pool, Opcode.MapKeys) == 1
        assert verify(lowered.module).count == 0

        invalid_source: static u8& = "def wrong() -> i64:\n    values: dict[sview, i64] = {\"one\": 1}\n    return values[1]\n"
        invalid_file: Ast::File = parse_for_ir(invalid_source)
        invalid: LowerResult = lower_file(invalid_file, "bad-dictionary")
        assert any issue in invalid.issues where issue.kind == LowerIssueKind.TypeMismatch


