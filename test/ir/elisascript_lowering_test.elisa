@test
def lowers_f_strings_to_typed_concat_chain() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def greeting(name: sview) -> sview:\n    return f\"hello {name}!\"\n"
        file: Ast::File = parse_for_ir(source)
        lowered: LowerResult = lower_file(file, "f-string")
        fn: Function = lowered.module.functions[0]
        assert lowered.issues.count == 0
        assert opcode_count(fn.instruction_pool, Opcode.Concat) == 2
        assert fn.instruction_pool[fn.instruction_pool.count - 1].result_type.kind == TypeKind.Text
        assert verify(lowered.module).count == 0

        boolean_source: static u8& = "def boolean_text(value: bool) -> sview:\n    return f\"value={value}\"\n"
        boolean_file: Ast::File = parse_for_ir(boolean_source)
        boolean_lowered: LowerResult = lower_file(boolean_file, "boolean-f-string")
        assert boolean_lowered.issues.count == 0
        assert opcode_count(boolean_lowered.module.functions[0].instruction_pool, Opcode.FormatBool) == 1
        assert verify(boolean_lowered.module).count == 0

        nominal_source: static u8& = "def path_value() -> Path:\n    return path\"src/main.elisa\"\n\ndef render() -> sview:\n    return f\"{path_value()}\"\n"
        nominal_file: Ast::File = parse_for_ir(nominal_source)
        nominal_lowered: LowerResult = lower_file(nominal_file, "nominal-f-string")
        assert nominal_lowered.issues.count == 0
        assert opcode_count(nominal_lowered.module.functions[1].instruction_pool, Opcode.FormatNominal) == 1
        assert verify(nominal_lowered.module).count == 0


