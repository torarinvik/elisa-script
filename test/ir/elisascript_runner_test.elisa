@test
def file_runner_normalizes_absolute_script_invocation_path() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        filename: static u8& = "/tmp/./elisascript-source-path.elisascript"
        canonical_filename: static u8& = "/tmp/elisascript-source-path.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    source_path: Path = Script::source_path()\n    expected: Path = path\"/tmp/elisascript-source-path.elisascript\"\n    return 0i64 if source_path == expected else 1i64\n"
        _ = remove_file(canonical_filename.cast[cstr])
        written: i64 = try write_entire_file(filename.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

        arguments: darray[sview] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_elisascript_program_file(filename, arguments, observations, storage) else failed_execution()
        _ = remove_file(canonical_filename.cast[cstr])

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 0


@test
def diagnostic_program_runner_preserves_source_failure_phase() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        missing: static u8& = "/tmp/elisascript-diagnostic-missing.elisascript"
        arguments: darray[sview] = []
        diagnostic: mutable ElisascriptProgramDiagnostic = ElisascriptProgramDiagnostic{}
        execute_elisascript_program_file_diagnostic(missing, arguments, diagnostic)

        assert diagnostic.failed
        assert diagnostic.phase == "source"
        assert diagnostic.detail == "unable to load, parse, type-check, lower, or verify program"
        assert diagnostic.source_error_known
        assert diagnostic.source_error == ElisascriptSourceError.FileIo


@test
def diagnostic_check_accepts_modules_without_main_and_never_executes() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-check-without-main.elisascript"
        source: static u8& = "def helper() -> i64:\n    return 7\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

        diagnostic: mutable ElisascriptProgramDiagnostic = ElisascriptProgramDiagnostic{}
        check_elisascript_program_file_diagnostic(path, diagnostic)

        assert not diagnostic.failed
        assert not diagnostic.entrypoint_error_known
        assert diagnostic.execution.value.kind == RuntimeValueKind.Void
        assert diagnostic.execution.steps == 0
        _ = remove_file(path.cast[cstr])


@test
def strict_engine_diagnostic_rejects_interpreter_fallback() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-strict-engine-global.elisascript"
        source: static u8& = "global counter: i64 = 7\ndef main(arguments: darray[sview]) -> i64:\n    return counter\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

        arguments: darray[sview] = []
        compatible: mutable ElisascriptProgramDiagnostic = ElisascriptProgramDiagnostic{}
        execute_elisascript_program_file_diagnostic(path, arguments, compatible)
        assert not compatible.failed
        assert compatible.execution.engine == ExecutionEngine.BytecodeInterpreterFallback
        assert compatible.execution.value.kind == RuntimeValueKind.Int
        assert compatible.execution.value.integer == 7

        strict: mutable ElisascriptProgramDiagnostic = ElisascriptProgramDiagnostic{}
        execute_elisascript_program_file_direct_only_diagnostic(path, arguments, strict)
        assert strict.failed
        assert strict.phase == "runtime"
        assert strict.runtime_error_known
        assert strict.runtime_error == InterpretError.UnsupportedInstruction

        _ = remove_file(path.cast[cstr])
        direct_source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    return 11\n"
        direct_written: i64 = try write_entire_file(path.cast[cstr], sview(direct_source, 0, -1)) else -1
        assert direct_written > 0
        execute_elisascript_program_file_direct_only_diagnostic(path, arguments, strict)
        assert not strict.failed
        assert strict.execution.engine == ExecutionEngine.DirectBytecode
        assert strict.execution.value.kind == RuntimeValueKind.Int
        assert strict.execution.value.integer == 11
        _ = remove_file(path.cast[cstr])


