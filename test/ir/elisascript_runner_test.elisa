include "../../src/ir/ir.elisa"

using EsIr


def failed_execution() -> Execution:
    return Execution{value: runtime_void(), steps: 0}


@test
def source_runner_uses_verified_bytecode_pipeline() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(value: i64) -> i64:\n    observe(value)\n    return value + 2\n"
        arguments: darray[RuntimeValue] = [runtime_int(40)]
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_elisascript_source("runner.elisascript", source, "runner-source", "main", arguments, observations, storage) else failed_execution()

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 42
        assert execution.steps > 0
        assert observations.count == 1
        assert observations[0].value.kind == RuntimeValueKind.Int
        assert observations[0].value.integer == 40


@test
def file_runner_preserves_source_and_runtime_error_families() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-runner-test.elisascript"
        source: static u8& = "def main() -> i64:\n    return 23\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written == 33

        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_elisascript_file(path, "runner-file", "main", arguments, observations, storage) else failed_execution()
        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 23

        missing: static u8& = "/tmp/elisascript-runner-missing.elisascript"
        rejected: Execution = try execute_elisascript_file(missing, "runner-missing", "main", arguments, observations, storage) else failed_execution()
        assert rejected.value.kind == RuntimeValueKind.Void
        _ = remove_file(path.cast[cstr])
