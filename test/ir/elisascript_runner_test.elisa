@test
def diagnostic_program_runner_resets_reused_snapshot() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        missing: static u8& = "/tmp/elisascript-diagnostic-reset-missing.elisascript"
        arguments: darray[sview] = []
        diagnostic: mutable ElisascriptProgramDiagnostic = ElisascriptProgramDiagnostic{failed: true, phase: "stale", detail: "stale", execution: Execution{value: runtime_int(99), steps: 77}, source_error_known: true, source_error: ElisascriptSourceError.ParseFailed, source_diagnostic_payload_truncated: true, entrypoint_error_known: true, bytecode_issue_known: true, runtime_error_known: true}
        execute_elisascript_program_file_diagnostic(missing, arguments, diagnostic)

        assert diagnostic.failed
        assert diagnostic.phase == "source"
        assert diagnostic.execution.value.kind == RuntimeValueKind.Void
        assert diagnostic.execution.steps == 0
        assert diagnostic.source_error == ElisascriptSourceError.FileIo
        assert not diagnostic.source_diagnostic_payload_truncated
        assert not diagnostic.entrypoint_error_known
        assert not diagnostic.bytecode_issue_known
        assert not diagnostic.runtime_error_known


@test
def diagnostic_program_runner_retains_bounded_source_excerpt() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-diagnostic-excerpt.elisascript"
        source: static u8& = "def main() -> i64:\n    return\n"
        _ = remove_file(path.cast[cstr])
