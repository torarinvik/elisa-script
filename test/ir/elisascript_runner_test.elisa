include "../../src/ir/ir.elisa"

using EsIr


def failed_execution() -> Execution:
    return Execution{value: runtime_void(), steps: 0}


def parse_cli_ok[@r](arguments: darray[sview]&, request: mutable ElisascriptCliRequest& @r) -> bool can[Memory.Allocate, Abort.Panic]:
    try parse_elisascript_cli(arguments, request) else return false
    return true


@test
def cli_parser_preserves_typed_arguments() -> void:
    can Memory.Allocate, Abort.Panic:
        raw: darray[sview] = ["program.elisascript", "alpha beta", ""]
        request: mutable ElisascriptCliRequest = ElisascriptCliRequest{source: "", arguments: []}
        assert parse_cli_ok(raw, request)
        assert request.source == "program.elisascript"
        assert request.arguments.count == 2
        assert request.arguments[0] == "alpha beta"
        assert request.arguments[1] == ""


@test
def cli_parser_rejects_embedded_nul_in_typed_arguments() -> void:
    can Memory.Allocate, Abort.Panic:
        raw: darray[sview] = ["program.elisascript", "safe\0suffix"]
        request: mutable ElisascriptCliRequest = ElisascriptCliRequest{source: "", arguments: []}
        assert not parse_cli_ok(raw, request)


@test
def cli_parser_rejects_missing_or_wrong_source() -> void:
    can Memory.Allocate, Abort.Panic:
        missing: darray[sview] = []
        missing_request: mutable ElisascriptCliRequest = ElisascriptCliRequest{source: "", arguments: []}
        assert not parse_cli_ok(missing, missing_request)

        wrong: darray[sview] = ["program.elisa"]
        wrong_request: mutable ElisascriptCliRequest = ElisascriptCliRequest{source: "", arguments: []}
        assert not parse_cli_ok(wrong, wrong_request)


@test
def standard_program_entry_packs_typed_arguments() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    observe(arguments)\n    if arguments.count == 2u64:\n        return 7\n    return 0\n"
        arguments: darray[sview] = ["alpha", "beta"]
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_elisascript_program_source("program.elisascript", source, "program-source", arguments, observations, storage) else failed_execution()

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 7
        assert observations.count == 1
        assert observations[0].value.kind == RuntimeValueKind.Array
        assert observations[0].value.array_start == 0
        assert observations[0].value.array_count == 2
        assert storage[0].text == "alpha"
        assert storage[1].text == "beta"


@test
def standard_program_entry_rejects_nonconforming_main() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> i64:\n    return 1\n"
        arguments: darray[sview] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        rejected: Execution = try execute_elisascript_program_source("invalid-program.elisascript", source, "invalid-program", arguments, observations, storage) else failed_execution()

        assert rejected.value.kind == RuntimeValueKind.Void
        assert observations.count == 0
        assert storage.count == 0


@test
def standard_program_file_entry_uses_main_argv_abi() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-standard-program.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    if arguments.count == 3u64:\n        return 3\n    return 0\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

        arguments: darray[sview] = ["one", "two", "three"]
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_elisascript_program_file(path, arguments, observations, storage) else failed_execution()

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 3
        _ = remove_file(path.cast[cstr])


@test
def diagnostic_program_runner_preserves_source_failure_phase() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        missing: static u8& = "/tmp/elisascript-diagnostic-missing.elisascript"
        arguments: darray[sview] = []
        diagnostic: mutable ElisascriptProgramDiagnostic = ElisascriptProgramDiagnostic{}
        execute_elisascript_program_file_diagnostic(missing, arguments, diagnostic)

        assert diagnostic.failed
        assert diagnostic.phase == "source"
        assert diagnostic.detail == "unable to load, parse, type-check, lower, or verify program"
        assert diagnostic.source_error_known
        assert diagnostic.source_error == ElisascriptSourceError.FileIo


@test
def diagnostic_program_runner_retains_bounded_source_excerpt() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-diagnostic-excerpt.elisascript"
        source: static u8& = "def main() -> i64:\n    return\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

        arguments: darray[sview] = []
        diagnostic: mutable ElisascriptProgramDiagnostic = ElisascriptProgramDiagnostic{}
        execute_elisascript_program_file_diagnostic(path, arguments, diagnostic)

        assert diagnostic.failed
        assert diagnostic.phase == "source"
        assert diagnostic.source_parse_diagnostic_known
        assert diagnostic.source_diagnostic_line == 2
        assert diagnostic.source_diagnostic_payload_excerpt.count > 0
        assert bytes_view(diagnostic.source_diagnostic_payload_excerpt).contains("return")
        assert not diagnostic.source_diagnostic_payload_truncated
        _ = remove_file(path.cast[cstr])


@test
def diagnostic_snapshot_fingerprint_includes_phase_and_span() -> void:
    can Memory.Allocate, Abort.Panic:
        source_failure: mutable ElisascriptProgramDiagnostic = ElisascriptProgramDiagnostic{failed: true, phase: "source", detail: "ParseFailed", source_error_known: true, source_error: ElisascriptSourceError.ParseFailed, source_parse_diagnostic_known: true, source_diagnostic_line: 2, source_diagnostic_column: 5, source_diagnostic_end_line: 2, source_diagnostic_end_column: 11}
        span_failure: mutable ElisascriptProgramDiagnostic = ElisascriptProgramDiagnostic{failed: true, phase: "source", detail: "ParseFailed", source_error_known: true, source_error: ElisascriptSourceError.ParseFailed, source_parse_diagnostic_known: true, source_diagnostic_line: 2, source_diagnostic_column: 6, source_diagnostic_end_line: 2, source_diagnostic_end_column: 11}
        phase_failure: mutable ElisascriptProgramDiagnostic = ElisascriptProgramDiagnostic{failed: true, phase: "bytecode", detail: "ParseFailed", source_error_known: true, source_error: ElisascriptSourceError.ParseFailed, source_parse_diagnostic_known: true, source_diagnostic_line: 2, source_diagnostic_column: 5, source_diagnostic_end_line: 2, source_diagnostic_end_column: 11}

        source_fingerprint: u64 = elisascript_program_diagnostic_snapshot_fingerprint(source_failure)
        assert elisascript_program_diagnostic_snapshot_equal(source_failure, source_failure)
        assert source_fingerprint != elisascript_program_diagnostic_snapshot_fingerprint(span_failure)
        assert source_fingerprint != elisascript_program_diagnostic_snapshot_fingerprint(phase_failure)
        assert not elisascript_program_diagnostic_snapshot_equal(source_failure, span_failure)
        assert not elisascript_program_diagnostic_snapshot_equal(source_failure, phase_failure)


@test
def source_runner_uses_verified_bytecode_pipeline() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(value: i64) -> i64:\n    observe(value)\n    return value + 2\n"
        arguments: darray[RuntimeValue] = [runtime_int(40)]
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_elisascript_source("runner.elisascript", source, "runner-source", "main", arguments, observations, storage) else failed_execution()

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 42
        assert execution.steps > 0
        assert observations.count == 1
        assert observations[0].value.kind == RuntimeValueKind.Int
        assert observations[0].value.integer == 40


@test
def standard_program_observes_computed_text_values() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    value: sview = \"  x  \"\n    observe(value.lstrip() + \"|\")\n    return 1i64\n"
        arguments: darray[sview] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_elisascript_program_source("computed-text.elisascript", source, "computed-text", arguments, observations, storage) else failed_execution()

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 1
        assert observations.count == 1
        assert observations[0].value.kind == RuntimeValueKind.Text
        assert observations[0].value.text == "x  |"


@test
def source_runner_installs_configured_dynamic_handler() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def record(value: i64) -> void:\n    observe(value)\n\ndef emit() -> void can[Progress.Tick]:\n    signal Progress.Tick(41)\n\ndef main() -> i64:\n    with handler recorder:\n        emit()\n    return 7\n"
        clause: HandlerClause = HandlerClause{effect_family: "Progress", effect_operation: "Tick", function: "record"}
        recorder: Handler = Handler{name: "recorder", handles: ["Progress"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear, clauses: [clause]}
        handlers: darray[Handler] = [recorder]
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_elisascript_source_with_handlers("handler.elisascript", source, "handler-runner", "main", arguments, observations, storage, handlers) else failed_execution()

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 7
        assert observations.count == 1
        assert observations[0].value.kind == RuntimeValueKind.Int
        assert observations[0].value.integer == 41


@test
def source_runner_derives_dynamic_handler_from_callback_decorator() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "@handler(\"recorder\", \"Progress.Tick\")\ndef record(value: i64) -> void:\n    observe(value)\n\ndef emit() -> void can[Progress.Tick]:\n    signal Progress.Tick(41)\n\ndef main() -> i64:\n    with handler recorder:\n        emit()\n    return 7\n"
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_elisascript_source("decorated-handler.elisascript", source, "decorated-handler", "main", arguments, observations, storage) else failed_execution()

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 7
        assert observations.count == 1
        assert observations[0].value.kind == RuntimeValueKind.Int
        assert observations[0].value.integer == 41


@test
def source_runner_derives_typed_resuming_handler_from_callback_decorator() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "@handler(\"echo\", \"Echo.Value\")\ndef echo_clause(payload: i64) -> i64:\n    return resume(\"echo\", payload)\n\ndef main() -> i64:\n    with handler echo:\n        return perform(\"Echo.Value\", 41i64)\n"
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_elisascript_source("decorated-value-handler.elisascript", source, "decorated-value-handler", "main", arguments, observations, storage) else failed_execution()

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 41


@test
def source_runner_executes_value_perform_and_resume_callback() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def echo_clause(payload: i64) -> i64:\n    return resume(\"echo\", payload)\n\ndef main() -> i64:\n    with handler echo:\n        return perform(\"Echo.Value\", 41i64)\n"
        clause: HandlerClause = HandlerClause{effect_family: "Echo", effect_operation: "Value", function: "echo_clause"}
        echo_handler: Handler = Handler{name: "echo", handles: ["Echo"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear, clauses: [clause]}
        handlers: darray[Handler] = [echo_handler]
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_elisascript_source_with_handlers("value-perform.elisascript", source, "value-perform", "main", arguments, observations, storage, handlers) else failed_execution()

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 41


@test
def source_runner_bytes_rejects_embedded_nul_before_execution() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        fragment: sview = "def main() -> i64:\n    return 23\n"
        bytes: mutable dstr = ctx_fstr_alloc(sview_len(fragment) * 2)
        ctx_fstr_append(bytes, fragment.data, sview_len(fragment))
        ctx_fstr_append(bytes, "\0", 1)
        ctx_fstr_append(bytes, fragment.data, sview_len(fragment) - 1)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        rejected: Execution = try execute_elisascript_source_bytes("bytes.elisascript", bytes_view(bytes).data, bytes.count, "bytes-runner", "main", arguments, observations, storage) else failed_execution()

        assert rejected.value.kind == RuntimeValueKind.Void
        assert observations.count == 0
        assert storage.count == 0


@test
def file_runner_preserves_source_and_runtime_error_families() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-runner-test.elisascript"
        source: static u8& = "def main() -> i64:\n    return 23\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written == 33

        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_elisascript_file(path, "runner-file", "main", arguments, observations, storage) else failed_execution()
        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 23

        missing: static u8& = "/tmp/elisascript-runner-missing.elisascript"
        rejected: Execution = try execute_elisascript_file(missing, "runner-missing", "main", arguments, observations, storage) else failed_execution()
        assert rejected.value.kind == RuntimeValueKind.Void
        _ = remove_file(path.cast[cstr])
