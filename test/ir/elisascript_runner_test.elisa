@test
def source_runner_installs_configured_dynamic_handler() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def record(value: i64) -> void:\n    observe(value)\n\ndef emit() -> void can[Progress.Tick]:\n    signal Progress.Tick(41)\n\ndef main() -> i64:\n    with handler recorder:\n        emit()\n    return 7\n"
        clause: HandlerClause = HandlerClause{effect_family: "Progress", effect_operation: "Tick", function: "record"}
        recorder: Handler = Handler{name: "recorder", handles: ["Progress"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear, clauses: [clause]}
        handlers: darray[Handler] = [recorder]
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_elisascript_source_with_handlers("handler.elisascript", source, "handler-runner", "main", arguments, observations, storage, handlers) else failed_execution()

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 7
        assert observations.count == 1
        assert observations[0].value.kind == RuntimeValueKind.Int
        assert observations[0].value.integer == 41


