include "../../src/ir/ir.elisa"

using EsIr
using EsBytecode
using EsScriptTest


def failed_execution() -> Execution:
    return Execution{value: runtime_void(), steps: 0}


def parse_cli_ok[@r](arguments: darray[sview]&, request: mutable ElisascriptCliRequest& @r) -> bool can[Memory.Allocate, Abort.Panic]:
    try parse_elisascript_cli(arguments, request) else return false
    return true


@test
def cli_parser_preserves_typed_arguments() -> void:
    can Memory.Allocate, Abort.Panic:
        raw: darray[sview] = ["program.elisascript", "alpha beta", ""]
        request: mutable ElisascriptCliRequest = ElisascriptCliRequest{source: "", arguments: []}
        assert parse_cli_ok(raw, request)
        assert request.source == "program.elisascript"
        assert request.arguments.count == 2
        assert request.arguments[0] == "alpha beta"
        assert request.arguments[1] == ""


@test
def cli_parser_resets_reused_request_state() -> void:
    can Memory.Allocate, Abort.Panic:
        request: mutable ElisascriptCliRequest = ElisascriptCliRequest{source: "stale.elisascript", arguments: ["stale"], mode: CliMode.Check, color: CliColorMode.Never, strict_engine: true, option_end_seen: true}
        fresh: darray[sview] = ["fresh.elisascript"]
        assert parse_cli_ok(fresh, request)
        assert request.source == "fresh.elisascript"
        assert request.arguments.count == 0
        assert request.mode == CliMode.Run
        assert request.color == CliColorMode.Auto
        assert not request.strict_engine
        assert not request.option_end_seen
        malformed: darray[sview] = ["not-elisa"]
        assert not parse_cli_ok(malformed, request)
        assert request.source == ""
        assert request.arguments.count == 0
        assert request.mode == CliMode.Run
        assert request.color == CliColorMode.Auto
        assert not request.strict_engine
        assert not request.option_end_seen


@test
def cli_parser_rejects_embedded_nul_in_typed_arguments() -> void:
    can Memory.Allocate, Abort.Panic:
        raw: darray[sview] = ["program.elisascript", "safe\0suffix"]
        request: mutable ElisascriptCliRequest = ElisascriptCliRequest{source: "", arguments: []}
        assert not parse_cli_ok(raw, request)


@test
def cli_parser_rejects_missing_or_wrong_source() -> void:
    can Memory.Allocate, Abort.Panic:
        missing: darray[sview] = []
        missing_request: mutable ElisascriptCliRequest = ElisascriptCliRequest{source: "", arguments: []}
        assert not parse_cli_ok(missing, missing_request)

        wrong: darray[sview] = ["program.elisa"]
        wrong_request: mutable ElisascriptCliRequest = ElisascriptCliRequest{source: "", arguments: []}
        assert not parse_cli_ok(wrong, wrong_request)


@test
def standard_program_entry_packs_typed_arguments() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    observe(arguments)\n    if arguments.count == 2u64:\n        return 7\n    return 0\n"
        arguments: darray[sview] = ["alpha", "beta"]
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_elisascript_program_source("program.elisascript", source, "program-source", arguments, observations, storage) else failed_execution()

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 7
        assert observations.count == 1
        assert observations[0].value.kind == RuntimeValueKind.Array
        assert observations[0].value.array_start == 0
        assert observations[0].value.array_count == 2
        assert storage[0].text == "alpha"
        assert storage[1].text == "beta"


@test
def runner_discovers_file_tests_without_requiring_main() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-test-discovery.elisascript"
        source: static u8& = "@test\ndef smoke() -> void:\n    return\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

        session: mutable ScriptTestSession = ScriptTestSession{}
        module: Module = try discover_elisascript_file_tests(path, "test-discovery", session) else Module{name: "fallback", functions: []}
        assert module.name == "test-discovery"
        assert module.functions.count == 1
        assert session.state == ScriptTestState.Planned
        assert session.cases.count == 1
        assert session.cases[0].ordinal == 0
        assert session.cases[0].name == "smoke"
        assert session.cases[0].line == 2
        assert validate_script_test_session(session)
        _ = remove_file(path.cast[cstr])


@test
def runner_executes_one_void_test_with_fresh_case_storage() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "@test\ndef smoke() -> void:\n    return\n\ndef main() -> i64:\n    return 0\n"
        module: Module = try lower_elisascript_source("test-execution.elisascript", source, "test-execution") else Module{name: "fallback", functions: []}
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        spec: ScriptTestSpec = ScriptTestSpec{ordinal: 0, name: "smoke", line: 2}
        observations: mutable darray[Observation] = [Observation{trace: 1, value: runtime_int(9)}]
        storage: mutable darray[RuntimeValue] = [runtime_int(7)]
        execution: Execution = try execute_elisascript_test(lowered.module, spec, observations, storage) else failed_execution()

        assert execution.value.kind == RuntimeValueKind.Void
        assert observations.count == 0
        assert storage.count == 0

        invalid: ScriptTestSpec = ScriptTestSpec{ordinal: 0, name: "main", line: 5}
        rejected: mutable bool = false
        catch execute_elisascript_test(lowered.module, invalid, observations, storage):
            ok execution:
                assert false
            error failure:
                assert failure == ScriptTestError.FunctionSignatureInvalid
                rejected <- true
        assert rejected


@test
def standard_program_entry_rejects_nonconforming_main() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> i64:\n    return 1\n"
