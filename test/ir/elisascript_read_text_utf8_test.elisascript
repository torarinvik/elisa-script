include "../../src/ir/execution.elisa"

using Ast
using EsIr


def lower_read_text_utf8_test_program(source: u8&) -> Module:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        tokens: darray[Lexer::Token] = frontend_tokenize("read_text_utf8.elisascript", source)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        assert file.errors.count == 0
        lowered: LowerResult = lower_file(file, "read_text_utf8")
        assert lowered.issues.count == 0
        assert verify(lowered.module).count == 0
        return lowered.module


def interpret_read_text_utf8_test_program(module: Module&, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&) -> Execution:
    can Memory.Allocate, Abort.Panic:
        storage: mutable darray[RuntimeValue] = []
        return try interpret(module, entry, arguments, observations, storage) else Execution{value: RuntimeValue{kind: RuntimeValueKind.Void}, steps: 0}


@test
def interpreter_read_text_rejects_malformed_utf8_and_accepts_valid_utf8() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO:
        malformed_path: static u8& = "/tmp/elisascript-read-text-invalid-utf8-test.bin"
        valid_path: static u8& = "/tmp/elisascript-read-text-valid-utf8-test.bin"
        source: static u8& = "def malformed() -> bool:\n    written: usize = try write_bytes(path\"/tmp/elisascript-read-text-invalid-utf8-test.bin\", [240u8, 128u8, 128u8, 128u8]) else return false\n    rejected: mutable bool = false\n    contents: sview = try read_text(path\"/tmp/elisascript-read-text-invalid-utf8-test.bin\") else:\n        rejected <- true\n        \"\"\n    removed: bool = remove_path(path\"/tmp/elisascript-read-text-invalid-utf8-test.bin\")\n    return written == 4u64 and rejected and contents == \"\" and removed\n\ndef valid() -> bool:\n    written: usize = try write_bytes(path\"/tmp/elisascript-read-text-valid-utf8-test.bin\", [226u8, 130u8, 172u8]) else return false\n    contents: sview = try read_text(path\"/tmp/elisascript-read-text-valid-utf8-test.bin\") else return false\n    removed: bool = remove_path(path\"/tmp/elisascript-read-text-valid-utf8-test.bin\")\n    return written == 3u64 and contents == \"€\" and removed\n"
        _ = remove_file(malformed_path)
        _ = remove_file(valid_path)
        module: Module = lower_read_text_utf8_test_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        malformed: Execution = interpret_read_text_utf8_test_program(module, "malformed", arguments, observations)
        valid: Execution = interpret_read_text_utf8_test_program(module, "valid", arguments, observations)
        assert malformed.value.kind == RuntimeValueKind.Bool and malformed.value.boolean
        assert valid.value.kind == RuntimeValueKind.Bool and valid.value.boolean
