        compiled: mutable Execution = try execute_bytecode(lowered.module, "build", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Int
        assert compiled.value.kind == RuntimeValueKind.Int
        assert compiled.value.integer == reference.value.integer
        assert compiled.value.integer == 3020
        reference <- try interpret(module, "indexed", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "indexed", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert compiled.value.integer == reference.value.integer
        assert compiled.value.integer == 2030
        reference <- try interpret(module, "negative", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "negative", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert compiled.value.integer == reference.value.integer
        assert compiled.value.integer == 20


