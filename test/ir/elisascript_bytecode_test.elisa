@test
def bytecode_mutable_dictionary_remove_matches_reference() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def mutate() -> bool:\n    values: mutable dict[i64, i64] = {1i64: 10i64, 2i64: 20i64}\n    values.remove(1i64)\n    return values.count == 1u64 and not (1i64 in values) and 2i64 in values\n\ndef missing() -> bool:\n    values: mutable dict[i64, i64] = {1i64: 10i64}\n    values.remove(9i64)\n    return values.count == 1u64 and 1i64 in values\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "mutate", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "mutate", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.value.boolean
        missing_reference_observations: mutable darray[Observation] = []
        missing_bytecode_observations: mutable darray[Observation] = []
        missing_reference_storage: mutable darray[RuntimeValue] = []
        missing_bytecode_storage: mutable darray[RuntimeValue] = []
        missing_reference: Execution = try interpret(module, "missing", arguments, missing_reference_observations, missing_reference_storage) else failed_execution()
        missing_compiled: Execution = try execute_bytecode(lowered.module, "missing", arguments, missing_bytecode_observations, missing_bytecode_storage) else failed_execution()
        assert missing_reference.value.kind == RuntimeValueKind.Bool
        assert missing_compiled.value.kind == RuntimeValueKind.Bool
        assert missing_compiled.value.boolean == missing_reference.value.boolean
        assert missing_compiled.value.boolean
        assert missing_reference_storage.count == 2
        assert missing_bytecode_storage.count == 2


@test
def bytecode_merges_set_mutations_through_branch_state() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def mutate(flag: bool) -> usize:\n    values: mutable set[i64] = {1i64}\n    if flag:\n        values.add(2i64)\n    else:\n        values.remove(1i64)\n    return values.count\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        true_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: true}]
        false_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: false}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "mutate", true_arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "mutate", true_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Int
        assert compiled.value.kind == RuntimeValueKind.Int
        assert compiled.value.integer == reference.value.integer
        assert compiled.value.integer == 2

        false_reference: Execution = try interpret(module, "mutate", false_arguments, reference_observations, reference_storage) else failed_execution()
        false_compiled: Execution = try execute_bytecode(lowered.module, "mutate", false_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert false_compiled.value.integer == false_reference.value.integer
        assert false_compiled.value.integer == 0


