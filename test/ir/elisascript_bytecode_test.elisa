        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert reference.value.boolean
        assert compiled.value.boolean == reference.value.boolean
        assert bytecode_observations.count == reference_observations.count
        for index in 0..<reference_observations.count |reference_observations, bytecode_observations, reference_storage, bytecode_storage|:
            assert bytecode_observations[index].value.kind == RuntimeValueKind.Array
            assert bytecode_observations[index].value.array_count == reference_observations[index].value.array_count
            for offset in 0..<reference_observations[index].value.array_count.usize() |reference_observations, bytecode_observations, reference_storage, bytecode_storage, index|:
                reference_value: RuntimeValue = reference_storage[reference_observations[index].value.array_start.usize() + offset]
                bytecode_value: RuntimeValue = bytecode_storage[bytecode_observations[index].value.array_start.usize() + offset]
                assert bytecode_value.text == reference_value.text
        assert compiled.steps == reference.steps


