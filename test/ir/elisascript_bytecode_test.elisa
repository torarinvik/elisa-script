@test
def bytecode_direct_python_dictionary_pop_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> i64:\n    mapping: mutable dict[sview, i64] = {\"first\": 1i64, \"second\": 2i64}\n    removed: i64 = mapping.pop(\"first\")\n    observe(mapping)\n    return removed\n\ndef fallback() -> i64:\n    mapping: mutable dict[sview, i64] = {\"first\": 1i64}\n    return mapping.pop(\"missing\", 42i64)\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 1
        assert compiled.value.integer == reference.value.integer
        assert reference_observations.count == 1
        assert bytecode_observations.count == reference_observations.count
        assert bytecode_observations[0].value.map_count == 1u32
        assert bytecode_storage[bytecode_observations[0].value.map_start.usize()].text == reference_storage[reference_observations[0].value.map_start.usize()].text
        assert compiled.steps == reference.steps
        reference_storage_before_fallback: usize = reference_storage.count
        bytecode_storage_before_fallback: usize = bytecode_storage.count
        fallback_reference: Execution = try interpret(module, "fallback", arguments, reference_observations, reference_storage) else failed_execution()
        fallback_compiled: Execution = try execute_bytecode(lowered.module, "fallback", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert fallback_reference.value.integer == 42
        assert fallback_compiled.value.integer == fallback_reference.value.integer
        assert reference_storage.count == reference_storage_before_fallback + 2
        assert bytecode_storage.count == bytecode_storage_before_fallback + 2


