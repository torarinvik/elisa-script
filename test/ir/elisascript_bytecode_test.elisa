include "../../src/ir/ir.elisa"

using Ast
using EsIr
using EsBytecode


def lower_program(source: u8&) -> Module:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        tokens: darray[Lexer::Token] = frontend_tokenize("bytecode.elisascript", source)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        assert file.errors.count == 0
        lowered: LowerResult = lower_file(file, "bytecode")
        assert lowered.issues.count == 0
        assert verify(lowered.module).count == 0
        return lowered.module


def failed_execution() -> Execution:
    return Execution{value: RuntimeValue{kind: RuntimeValueKind.Void}, steps: 0}


@test
def bytecode_lowering_preserves_verified_cfg_and_assigns_offsets() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(value: i64) -> i64:\n    if value > 0:\n        return value + 1\n    return value - 1\n"
        module: Module = lower_program(source)
        bytecode: BytecodeLowerResult = lower_bytecode(module)

        assert bytecode.issues.count == 0
        assert bytecode.module.name == "bytecode"
        assert bytecode.module.functions.count == 1
        function: BytecodeFunction = bytecode.module.functions[0]
        assert function.name == "main"
        assert function.parameters.count == 1
        assert function.instructions.count == module.functions[0].instruction_pool.count
        assert function.dispatch_classes.count == function.instructions.count
        assert function.blocks.count == module.functions[0].blocks.count
        assert bytecode_block_offset(function, function.entry) == 0
        assert bytecode_block_offset(function, 9999) == function.instructions.count
        assert bytecode_opcode_class(Opcode.Constant) == BytecodeDispatchClass.Literal
        assert bytecode_opcode_class(Opcode.Add) == BytecodeDispatchClass.Binary
        assert bytecode_opcode_class(Opcode.CaptureProcessResult) == BytecodeDispatchClass.Process
        assert bytecode_opcode_class(Opcode.Perform) == BytecodeDispatchClass.Effect


@test
def bytecode_lowering_refuses_unverified_modules() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        position: SourceSpan = SourceSpan{file: "bytecode", line: 1, column: 1, end_line: 1, end_column: 1}
        malformed_return: Terminator = Terminator{kind: TerminatorKind.Return, operand: 1, operand_count: 1, target_count: 0, span: position}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: malformed_return}
        fn: Function = Function{name: "bad", parameters: [], return_type: Type{kind: TypeKind.Int, bits: 64, signed: true}, effects: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [block], entry: 1, errors: []}
        module: Module = Module{name: "bad", functions: [fn], handlers: []}
        lowered: BytecodeLowerResult = lower_bytecode(module)

        assert lowered.issues.count > 0
        assert lowered.module.functions.count == 0


@test
def bytecode_preflight_rejects_stale_dispatch_tables() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> i64:\n    return 7\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        tampered: mutable BytecodeModule = lowered.module
        tampered.functions[0].dispatch_classes[0] <- BytecodeDispatchClass.Invalid
        assert not bytecode_dispatch_table_valid(tampered)


@test
def bytecode_control_machine_walks_branch_and_return_edges() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(value: i64) -> i64:\n    if value > 10:\n        return value * 2\n    return value + 3\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        function: BytecodeFunction = lowered.module.functions[0]
        cursor: mutable BytecodeControlCursor = BytecodeControlCursor{state: BytecodeControlState.Instruction, block_index: 0, instruction_index: 0, action: BytecodeControlAction.Invalid, target: 0, edge_start: 0, edge_count: 0}
        action: mutable BytecodeControlAction = bytecode_next_control(function, cursor, true)
        while action == BytecodeControlAction.ExecuteInstruction:
            cursor.state <- BytecodeControlState.Instruction
            action <- bytecode_next_control(function, cursor, true)
        assert action == BytecodeControlAction.Jump
        true_target: u32 = cursor.target

        target_index: mutable usize = function.blocks.count
        for index in 0..<function.blocks.count |function, index, target_index|:
            target_index <- index if function.blocks[index].id == true_target
        assert target_index < function.blocks.count
        cursor.block_index <- target_index
        cursor.instruction_index <- 0
        cursor.state <- BytecodeControlState.Instruction
        action <- bytecode_next_control(function, cursor, true)
        while action == BytecodeControlAction.ExecuteInstruction:
            cursor.state <- BytecodeControlState.Instruction
            action <- bytecode_next_control(function, cursor, true)
        assert action == BytecodeControlAction.Return


@test
def bytecode_binary_selection_machine_covers_numeric_and_mismatch_paths() -> void:
    integer_sum: RuntimeValue = bytecode_direct_binary(Opcode.Add, runtime_int(2), runtime_int(3))
    float_order: RuntimeValue = bytecode_direct_binary(Opcode.Greater, runtime_float(4.5), runtime_float(2.0))
    equal_text: RuntimeValue = bytecode_direct_binary(Opcode.Equal, runtime_text("same"), runtime_text("same"))
    mismatched: RuntimeValue = bytecode_direct_binary(Opcode.Add, runtime_int(2), runtime_float(3.0))
    invalid_divide: RuntimeValue = bytecode_direct_binary(Opcode.Divide, runtime_int(9), runtime_int(0))

    assert integer_sum.kind == RuntimeValueKind.Int
    assert integer_sum.integer == 5
    assert float_order.kind == RuntimeValueKind.Bool
    assert float_order.boolean
    assert equal_text.kind == RuntimeValueKind.Bool
    assert equal_text.boolean
    assert mismatched.kind == RuntimeValueKind.Void
    assert invalid_divide.kind == RuntimeValueKind.Void


@test
def bytecode_bootstrap_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(value: i64) -> i64:\n    if value > 10:\n        answer: i64 = value * 2\n        observe(answer)\n        return answer\n    answer: i64 = value + 3\n    observe(answer)\n    return answer\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        reference_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 20}]
        bytecode_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 20}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", reference_arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", bytecode_arguments, bytecode_observations, bytecode_storage) else failed_execution()

        assert reference.value.kind == RuntimeValueKind.Int
        assert compiled.value.kind == RuntimeValueKind.Int
        assert compiled.value.integer == reference.value.integer
        assert compiled.steps == reference.steps
        assert bytecode_observations.count == reference_observations.count
        assert bytecode_observations[0].trace == reference_observations[0].trace
        assert bytecode_observations[0].value.integer == reference_observations[0].value.integer


@test
def bytecode_direct_array_path_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> darray[i64]:\n    values: mutable darray[i64] = [1, 2, 3]\n    values[1] <- 7\n    observe(values.count)\n    observe(7 in values)\n    observe(values[1:3])\n    return values + [4]\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()

        assert reference.value.kind == RuntimeValueKind.Array
        assert compiled.value.kind == RuntimeValueKind.Array
        assert compiled.value.array_count == reference.value.array_count
        for offset in 0..<reference.value.array_count.usize() |reference, compiled, reference_storage, bytecode_storage|:
            assert reference_storage[reference.value.array_start.usize() + offset].integer == bytecode_storage[compiled.value.array_start.usize() + offset].integer
        assert bytecode_observations.count == reference_observations.count
        assert bytecode_observations[0].value.integer == reference_observations[0].value.integer
        assert bytecode_observations[1].value.boolean == reference_observations[1].value.boolean
        assert bytecode_observations[2].value.kind == RuntimeValueKind.Array
        assert bytecode_observations[2].value.array_count == reference_observations[2].value.array_count
        for offset in 0..<reference_observations[2].value.array_count.usize() |reference_observations, bytecode_observations, reference_storage, bytecode_storage|:
            assert reference_storage[reference_observations[2].value.array_start.usize() + offset].integer == bytecode_storage[bytecode_observations[2].value.array_start.usize() + offset].integer


@test
def bytecode_direct_path_rejects_malformed_external_array_ranges() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def read(values: darray[i64]) -> i64:\n    return values[0]\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = [runtime_array(1, 1)]
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []

        assert not runtime_array_range_valid(storage, arguments[0])
        rejected: Execution = try execute_bytecode(lowered.module, "read", arguments, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert rejected.value.kind == RuntimeValueKind.Void


@test
def bytecode_direct_process_capture_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> sview:\n    return capture_process_stdout(exe\"/usr/bin/printf\", [\"%s\", \"bytecode-process\"])\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Text
        assert compiled.value.kind == RuntimeValueKind.Text
        assert compiled.value.text == reference.value.text
        assert compiled.value.text == "bytecode-process"
        assert compiled.steps == reference.steps


@test
def bytecode_direct_process_family_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> bool:\n    status: i64 = run_process(exe\"/usr/bin/true\", [])\n    output: sview = capture_process_stdout(exe\"/usr/bin/printf\", [\"%s\", \"direct\"])\n    echoed: sview = capture_process_stdout_with_stdin(exe\"/bin/cat\", [], \"stdin\")\n    captured: ProcessCapture = capture_process_result(exe\"/usr/bin/printf\", [\"%s\", \"result\"], \"\")\n    exit_status: i64 = process_exit_status(captured)\n    captured_output: sview = process_stdout(captured)\n    captured_error: sview = process_stderr(captured)\n    observe(status)\n    observe(output)\n    observe(echoed)\n    observe(exit_status)\n    observe(captured_output)\n    observe(captured_error)\n    return status == 0i64 and output == \"direct\" and echoed == \"stdin\" and exit_status == 0i64 and captured_output == \"result\" and captured_error == \"\"\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps
        assert bytecode_observations.count == reference_observations.count
        for index in 0..<reference_observations.count |reference_observations, bytecode_observations|:
            assert bytecode_observations[index].value.kind == reference_observations[index].value.kind
            if reference_observations[index].value.kind == RuntimeValueKind.Int:
                assert bytecode_observations[index].value.integer == reference_observations[index].value.integer
            if reference_observations[index].value.kind == RuntimeValueKind.Text:
                assert bytecode_observations[index].value.text == reference_observations[index].value.text


@test
def bytecode_direct_text_fields_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(value: sview) -> sview:\n    fields: darray[sview] = split(value, \"::\")\n    observe(join(fields, \"|\"))\n    return fields[1] + \"!\"\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "left::right::tail"}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Text
        assert compiled.value.kind == RuntimeValueKind.Text
        assert compiled.value.text == reference.value.text
        assert compiled.value.text == "right!"
        assert bytecode_observations.count == reference_observations.count
        assert bytecode_observations[0].value.kind == RuntimeValueKind.Text
        assert bytecode_observations[0].value.text == reference_observations[0].value.text
        assert bytecode_observations[0].value.text == "left|right|tail"


@test
def bytecode_direct_regex_path_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(value: sview) -> sview:\n    accepted: bool = matches(value, regex\"^item:[0-9]+$\")\n    observe(accepted)\n    return replace_regex(value, regex\"[0-9]+\", \"#\")\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "item:42"}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Text
        assert compiled.value.kind == RuntimeValueKind.Text
        assert compiled.value.text == reference.value.text
        assert compiled.value.text == "item:#"
        assert bytecode_observations.count == reference_observations.count
        assert bytecode_observations[0].value.boolean == reference_observations[0].value.boolean
        assert bytecode_observations[0].value.boolean


