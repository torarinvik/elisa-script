@test
def bytecode_is_empty_matches_reference() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def checks() -> bool:\n    values: darray[i64] = []\n    mapping: dict[sview, i64] = {\"ok\": 7i64}\n    text: sview = \"\"\n    return is_empty(values) and not mapping.is_empty() and text.isempty()\n\ndef nonempty_checks() -> bool:\n    values: darray[i64] = [1i64]\n    text: sview = \"x\"\n    return is_nonempty(values) and values.nonempty() and nonempty(text)\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "checks", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "checks", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert reference.value.boolean == compiled.value.boolean
        assert compiled.steps == reference.steps
        reference <- try interpret(module, "nonempty_checks", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "nonempty_checks", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.boolean == compiled.value.boolean


@test
def bytecode_typed_abs_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def integer(value: i64) -> i64:\n    return abs(value)\n\ndef decimal(value: f64) -> f64:\n    return abs(value)\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        integer_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: -41}]
        decimal_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Float, decimal: -3.5}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "integer", integer_arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "integer", integer_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Int
        assert compiled.value.kind == RuntimeValueKind.Int
        assert reference.value.integer == 41
        assert compiled.value.integer == reference.value.integer
        assert compiled.steps == reference.steps

        reference_float: Execution = try interpret(module, "decimal", decimal_arguments, reference_observations, reference_storage) else failed_execution()
        compiled_float: Execution = try execute_bytecode(lowered.module, "decimal", decimal_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference_float.value.kind == RuntimeValueKind.Float
        assert compiled_float.value.kind == RuntimeValueKind.Float
        assert reference_float.value.decimal == 3.5
        assert compiled_float.value.decimal == reference_float.value.decimal
        assert compiled_float.steps == reference_float.steps


