def bytecode_direct_process_capture_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> sview:\n    return capture_process_stdout(exe\"/usr/bin/printf\", [\"%s\", \"bytecode-process\"])\n"
        module: Module = lower_program(source)
