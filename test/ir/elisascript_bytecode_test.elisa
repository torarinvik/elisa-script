def bytecode_direct_integer_conversion_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def parse(value: sview) -> i64:\n    return parse_int(value)\n\ndef format(value: i64) -> sview:\n    return format_int(value)\n\ndef parse_decimal(value: sview) -> f64:\n    return parse_float(value)\n\ndef format_decimal(value: f64) -> sview:\n    return format_float(value)\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        text_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "-123"}]
        integer_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 456}]
        decimal_text_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "1.25e2"}]
        decimal_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Float, decimal: -3.5}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        parsed: Execution = try interpret(module, "parse", text_arguments, reference_observations, reference_storage) else failed_execution()
        compiled_parse: Execution = try execute_bytecode(lowered.module, "parse", text_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        formatted: Execution = try interpret(module, "format", integer_arguments, reference_observations, reference_storage) else failed_execution()
        compiled_format: Execution = try execute_bytecode(lowered.module, "format", integer_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        parsed_decimal: Execution = try interpret(module, "parse_decimal", decimal_text_arguments, reference_observations, reference_storage) else failed_execution()
        compiled_parse_decimal: Execution = try execute_bytecode(lowered.module, "parse_decimal", decimal_text_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        formatted_decimal: Execution = try interpret(module, "format_decimal", decimal_arguments, reference_observations, reference_storage) else failed_execution()
        compiled_format_decimal: Execution = try execute_bytecode(lowered.module, "format_decimal", decimal_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert parsed.value.integer == -123
        assert compiled_parse.value.integer == parsed.value.integer
        assert formatted.value.text == "456"
        assert compiled_format.value.text == formatted.value.text
        assert parsed_decimal.value.decimal == 125.0
        assert compiled_parse_decimal.value.decimal == parsed_decimal.value.decimal
        assert formatted_decimal.value.text == "-3.5"
        assert compiled_format_decimal.value.text == formatted_decimal.value.text
        assert compiled_parse.steps == parsed.steps
        assert compiled_format.steps == formatted.steps


@test
def bytecode_direct_python_str_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> sview:\n    return str(-42i64) + \":\" + str(1.5f64) + \":\" + str(true) + \":\" + str(\"ok\")\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Text
        assert compiled.value.kind == RuntimeValueKind.Text
        assert reference.value.text == "-42:1.5:true:ok"
        assert compiled.value.text == reference.value.text
        assert compiled.steps == reference.steps


@test
def bytecode_direct_python_scalar_constructors_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def int_text() -> i64:\n    return int(\"-42\")\n\ndef int_identity(value: i64) -> i64:\n    return int(value)\n\ndef float_text() -> f64:\n    return float(\"1.5e2\")\n\ndef float_identity(value: f64) -> f64:\n    return float(value)\n\ndef bool_identity(value: bool) -> bool:\n    return bool(value)\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        no_arguments: darray[RuntimeValue] = []
        integer_arguments: darray[RuntimeValue] = [runtime_int(7)]
        float_arguments: darray[RuntimeValue] = [runtime_float(2.5)]
        bool_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: true}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference_int_text: Execution = try interpret(module, "int_text", no_arguments, reference_observations, reference_storage) else failed_execution()
        compiled_int_text: Execution = try execute_bytecode(lowered.module, "int_text", no_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        reference_int_identity: Execution = try interpret(module, "int_identity", integer_arguments, reference_observations, reference_storage) else failed_execution()
        compiled_int_identity: Execution = try execute_bytecode(lowered.module, "int_identity", integer_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        reference_float_text: Execution = try interpret(module, "float_text", no_arguments, reference_observations, reference_storage) else failed_execution()
        compiled_float_text: Execution = try execute_bytecode(lowered.module, "float_text", no_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        reference_float_identity: Execution = try interpret(module, "float_identity", float_arguments, reference_observations, reference_storage) else failed_execution()
        compiled_float_identity: Execution = try execute_bytecode(lowered.module, "float_identity", float_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        reference_bool_identity: Execution = try interpret(module, "bool_identity", bool_arguments, reference_observations, reference_storage) else failed_execution()
        compiled_bool_identity: Execution = try execute_bytecode(lowered.module, "bool_identity", bool_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference_int_text.value.integer == -42
        assert compiled_int_text.value.integer == reference_int_text.value.integer
        assert reference_int_identity.value.integer == 7
        assert compiled_int_identity.value.integer == reference_int_identity.value.integer
        assert reference_float_text.value.decimal == 150.0
        assert compiled_float_text.value.decimal == reference_float_text.value.decimal
        assert reference_float_identity.value.decimal == 2.5
        assert compiled_float_identity.value.decimal == reference_float_identity.value.decimal
        assert reference_bool_identity.value.boolean
        assert compiled_bool_identity.value.boolean == reference_bool_identity.value.boolean


@test
def bytecode_nested_arrays_use_packed_recursive_storage() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> i64:\n    values: darray[darray[i64]] = [[1, 2], [3, 4]]\n    return values[1][0]\n\ndef deep() -> i64:\n    values: darray[darray[darray[i64]]] = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]\n    return values[1][0][1]\n\ndef four() -> i64:\n    values: darray[darray[darray[darray[i64]]]] = [[[[1, 2]], [[3, 4]]], [[[5, 6]], [[7, 8]]]]\n    return values[1][1][0][1]\n\ndef equal() -> bool:\n    return [[1, 2], [3, 4]] == [[1, 2], [3, 4]]\n\ndef contains() -> bool:\n    return [1, 2] in [[1, 2], [3, 4]]\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        empty_arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", empty_arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", empty_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 3
        assert compiled.value.integer == reference.value.integer
        deep_reference: Execution = try interpret(module, "deep", empty_arguments, reference_observations, reference_storage) else failed_execution()
        deep_compiled: Execution = try execute_bytecode(lowered.module, "deep", empty_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert deep_reference.value.integer == 6
        assert deep_compiled.value.integer == deep_reference.value.integer
        four_reference: Execution = try interpret(module, "four", empty_arguments, reference_observations, reference_storage) else failed_execution()
        four_compiled: Execution = try execute_bytecode(lowered.module, "four", empty_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert four_reference.value.integer == 8
        assert four_compiled.value.integer == four_reference.value.integer
        equality_reference: Execution = try interpret(module, "equal", empty_arguments, reference_observations, reference_storage) else failed_execution()
        equality_compiled: Execution = try execute_bytecode(lowered.module, "equal", empty_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert equality_reference.value.boolean
        assert equality_compiled.value.boolean == equality_reference.value.boolean
        contains_reference: Execution = try interpret(module, "contains", empty_arguments, reference_observations, reference_storage) else failed_execution()
        contains_compiled: Execution = try execute_bytecode(lowered.module, "contains", empty_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert contains_reference.value.boolean
        assert contains_compiled.value.boolean == contains_reference.value.boolean


@test
def bytecode_array_valued_maps_use_recursive_packed_equality() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def lookup() -> i64:\n    values: dict[sview, darray[i64]] = {\"one\": [10, 20]}\n    return values[\"one\"][1]\n\ndef nested_lookup() -> i64:\n    values: dict[sview, darray[darray[i64]]] = {\"one\": [[10, 20], [30, 40]]}\n    return values[\"one\"][1][1]\n\ndef equal() -> bool:\n    left: dict[sview, darray[i64]] = {\"one\": [1, 2]}\n    right: dict[sview, darray[i64]] = {\"one\": [1, 2]}\n    return left == right\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "lookup", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "lookup", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 20
        assert compiled.value.integer == reference.value.integer
        nested_reference: Execution = try interpret(module, "nested_lookup", arguments, reference_observations, reference_storage) else failed_execution()
        nested_compiled: Execution = try execute_bytecode(lowered.module, "nested_lookup", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert nested_reference.value.integer == 40
        assert nested_compiled.value.integer == nested_reference.value.integer
        equality_reference: Execution = try interpret(module, "equal", arguments, reference_observations, reference_storage) else failed_execution()
        equality_compiled: Execution = try execute_bytecode(lowered.module, "equal", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert equality_reference.value.boolean
        assert equality_compiled.value.boolean == equality_reference.value.boolean


