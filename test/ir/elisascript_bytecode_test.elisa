include "../../src/ir/ir.elisa"

using Ast
using EsIr
using EsBytecode
using EsArtifactCache


def lower_program(source: u8&) -> Module:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        tokens: darray[Lexer::Token] = frontend_tokenize("bytecode.elisascript", source)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        assert file.errors.count == 0
        lowered: LowerResult = lower_file(file, "bytecode")
        assert lowered.issues.count == 0
        assert verify(lowered.module).count == 0
        return lowered.module


def failed_execution() -> Execution:
    return Execution{value: RuntimeValue{kind: RuntimeValueKind.Void}, steps: 0}


@test
def bytecode_compatibility_entrypoints_reject_step_budget_above_shared_ceiling() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        module: Module = lower_program("def main() -> bool:\n    return true\n")
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        rejected_direct: mutable bool = false
        catch execute_bytecode_direct_only(lowered.module, "main", arguments, observations, storage, ES_RUNTIME_DEFAULT_MAX_STEPS + 1):
            ok execution:
                assert false
            error failure:
                assert failure == InterpretError.OutputLimit
                rejected_direct <- true
        rejected_compatibility: mutable bool = false
        catch execute_bytecode(lowered.module, "main", arguments, observations, storage, ES_RUNTIME_DEFAULT_MAX_STEPS + 1):
            ok execution:
                assert false
            error failure:
                assert failure == InterpretError.OutputLimit
                rejected_compatibility <- true
        assert rejected_direct and rejected_compatibility


@test
def bytecode_strict_direct_entrypoint_rejects_unaccounted_resource_dimensions() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        module: Module = lower_program("def main() -> bool:\n    return true\n")
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        # Output/regex limits route through the reference engine.  This fixture
        # deliberately narrows an otherwise unaccounted host-wide dimension so
        # strict direct execution must fail closed through the shared
        # predicate rather than silently ignoring the request.
        policy: RuntimeResourcePolicy = RuntimeResourcePolicy{memory_bytes: 1}
        rejected: mutable bool = false
        catch execute_bytecode_direct_only_with_resource_policy(lowered.module, "main", arguments, observations, storage, policy):
            ok execution:
                assert false
            error failure:
                assert failure == InterpretError.UnsupportedInstruction
                rejected <- true
        assert rejected


@test
def regex_pattern_limit_is_identical_in_reference_and_direct_execution() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def search(p: sview) -> bool:\n    return matches(\"\", regex(p))\n\ndef replace(p: sview) -> bool:\n    return replace_regex(\"\", regex(p), \"\") == \"\"\n\ndef find(p: sview) -> bool:\n    return find_regex(\"\", regex(p)).count == 0u64\n\ndef split(p: sview) -> bool:\n    return split_regex(\"\", regex(p)).count == 1u64\n\ndef capture(p: sview) -> bool:\n    return capture_regex(\"\", regex(p)).count == 0u64\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        # Back every advertised byte with real storage. The empty haystack
        # makes the accepted boundary case fail its first literal atom.
        pattern_bytes: mutable darray[u8] = []
        for index in 0..<65537 |pattern_bytes|:
            pattern_bytes.push(120)
        entries: darray[sview] = ["search", "replace", "find", "split", "capture"]
        for entry in entries |module, lowered, pattern_bytes|:
            reference_observations: mutable darray[Observation] = []
            direct_observations: mutable darray[Observation] = []
            reference_storage: mutable darray[RuntimeValue] = []
            direct_storage: mutable darray[RuntimeValue] = []
            boundary: darray[RuntimeValue] = [runtime_text(sview(pattern_bytes.items, 0, 65536))]
            reference: Execution = try interpret(module, entry, boundary, reference_observations, reference_storage) else failed_execution()
            direct: Execution = try execute_bytecode_direct_only(lowered.module, entry, boundary, direct_observations, direct_storage) else failed_execution()
            assert reference.value.kind == RuntimeValueKind.Bool
            assert direct.value.kind == RuntimeValueKind.Bool
            assert direct.engine == ExecutionEngine.DirectBytecode
            assert reference.value.boolean == direct.value.boolean
            assert reference.value.boolean == (entry != "search")
            oversized: darray[RuntimeValue] = [runtime_text(sview(pattern_bytes.items, 0, 65537))]
            reference_rejected: mutable bool = false
            direct_rejected: mutable bool = false
            catch interpret(module, entry, oversized, reference_observations, reference_storage):
                ok execution:
                    assert false
                error failure:
                    assert failure == InterpretError.OutputLimit
                    reference_rejected <- true
            catch execute_bytecode_direct_only(lowered.module, entry, oversized, direct_observations, direct_storage):
                ok execution:
                    assert false
                error failure:
                    assert failure == InterpretError.OutputLimit
                    direct_rejected <- true
            assert reference_rejected and direct_rejected


@test
def regex_matcher_stack_bounds_are_shared_across_engines() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def full(pattern: sview, value: sview) -> bool:\n    return regex(pattern).fullmatch(value)\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        repeated: mutable darray[u8] = []
        for index in 0..<8193 |repeated|:
            repeated.push(97)
        fixed_arguments: darray[RuntimeValue] = [runtime_text("a{8193}"), runtime_text(sview(repeated.items, 0, 8193))]
        fixed_reference_observations: mutable darray[Observation] = []
        fixed_direct_observations: mutable darray[Observation] = []
        fixed_reference_storage: mutable darray[RuntimeValue] = []
        fixed_direct_storage: mutable darray[RuntimeValue] = []
        fixed_reference: Execution = try interpret(module, "full", fixed_arguments, fixed_reference_observations, fixed_reference_storage) else failed_execution()
        fixed_direct: Execution = try execute_bytecode_direct_only(lowered.module, "full", fixed_arguments, fixed_direct_observations, fixed_direct_storage) else failed_execution()
        assert fixed_reference.value.kind == RuntimeValueKind.Bool
        assert fixed_reference.value.boolean
        assert fixed_direct.value.kind == RuntimeValueKind.Bool
        assert fixed_direct.value.boolean
        repeat_arguments: darray[RuntimeValue] = [runtime_text("(a){8193}"), runtime_text(sview(repeated.items, 0, 8193))]
        reference_observations: mutable darray[Observation] = []
        direct_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        direct_storage: mutable darray[RuntimeValue] = []
        reference_rejected: mutable bool = false
        direct_rejected: mutable bool = false
        catch interpret(module, "full", repeat_arguments, reference_observations, reference_storage):
            ok execution:
                assert false
            error failure:
                assert failure == InterpretError.OutputLimit
                reference_rejected <- true
        catch execute_bytecode_direct_only(lowered.module, "full", repeat_arguments, direct_observations, direct_storage):
            ok execution:
                assert false
            error failure:
                assert failure == InterpretError.OutputLimit
                direct_rejected <- true
        assert reference_rejected and direct_rejected
        nested: mutable darray[u8] = []
        for index in 0..<1025 |nested|:
            nested.push(40)
        nested.push(97)
        for index in 0..<1025 |nested|:
            nested.push(41)
        nested_arguments: darray[RuntimeValue] = [runtime_text(sview(nested.items, 0, 2051)), runtime_text("a")]
        reference_rejected <- false
        direct_rejected <- false
        catch interpret(module, "full", nested_arguments, reference_observations, reference_storage):
            ok execution:
                assert false
            error failure:
                assert failure == InterpretError.OutputLimit
                reference_rejected <- true
        catch execute_bytecode_direct_only(lowered.module, "full", nested_arguments, direct_observations, direct_storage):
            ok execution:
                assert false
            error failure:
                assert failure == InterpretError.OutputLimit
                direct_rejected <- true
        assert reference_rejected and direct_rejected


@test
def recursive_call_depth_limit_is_shared_across_engines() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def descend(depth: i64) -> bool:\n    if depth == 0i64:\n        return true\n    return descend(depth - 1i64)\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = [runtime_int(4097)]
        reference_observations: mutable darray[Observation] = []
        direct_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        direct_storage: mutable darray[RuntimeValue] = []
        reference_rejected: mutable bool = false
        direct_rejected: mutable bool = false
        catch interpret(module, "descend", arguments, reference_observations, reference_storage):
            ok execution:
                assert false
            error failure:
                assert failure == InterpretError.OutputLimit
                reference_rejected <- true
        catch execute_bytecode_direct_only(lowered.module, "descend", arguments, direct_observations, direct_storage):
            ok execution:
                assert false
            error failure:
                assert failure == InterpretError.OutputLimit
                direct_rejected <- true
        assert reference_rejected and direct_rejected


def has_bytecode_opcode(instructions: darray[Instruction]&, opcode: Opcode) -> bool:
    return any instruction in instructions where instruction.opcode == opcode


@test
def bytecode_assertion_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def succeeds() -> bool:\n    assert(true)\n    return true\n\ndef fails() -> bool:\n    assert(false)\n    return true\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_opcode_class(Opcode.Assert) == BytecodeDispatchClass.Assertion
        assert has_bytecode_opcode(module.functions[0].instruction_pool, Opcode.Assert)
        assert bytecode_direct_supported(lowered.module)
        capability: BytecodeCapabilityReport = bytecode_capability_report(lowered.module)
        assert capability.direct_supported
        assert capability.engine == ExecutionEngine.DirectBytecode
        assert capability.function_count == 2u64
        assert capability.global_count == 0u64
        assert capability.instruction_count > 0u64
        artifact: BytecodeArtifact = make_bytecode_artifact(module, lowered.module, "bytecode-test")
        assert artifact.backend == "bytecode"
        assert artifact.source_revision == "bytecode-test"
        assert artifact.module_fingerprint == module_fingerprint(module)
        assert artifact.module_digest_0 == canonical_module_digest_word(module, 0)
        assert artifact.module_digest_1 == canonical_module_digest_word(module, 1)
        assert artifact.module_digest_2 == canonical_module_digest_word(module, 2)
        assert artifact.module_digest_3 == canonical_module_digest_word(module, 3)
        assert artifact.capability.direct_supported
        assert bytecode_artifact_matches_module(artifact, module, lowered.module)
        legacy_bytecode_artifact: mutable BytecodeArtifact = artifact
        legacy_bytecode_artifact.format_version <- 1
        legacy_bytecode_artifact.module_digest_0 <- 0
        legacy_bytecode_artifact.module_digest_1 <- 0
        legacy_bytecode_artifact.module_digest_2 <- 0
        legacy_bytecode_artifact.module_digest_3 <- 0
        migrated_bytecode_artifact: BytecodeArtifact = migrate_bytecode_artifact(legacy_bytecode_artifact, module, lowered.module)
        assert migrated_bytecode_artifact.format_version == 2
        assert bytecode_artifact_metadata_valid(migrated_bytecode_artifact)
        assert bytecode_artifact_matches_module(migrated_bytecode_artifact, module, lowered.module)
        stale_legacy_bytecode_artifact: mutable BytecodeArtifact = legacy_bytecode_artifact
        stale_legacy_bytecode_artifact.module_fingerprint <- stale_legacy_bytecode_artifact.module_fingerprint + 1
        assert migrate_bytecode_artifact(stale_legacy_bytecode_artifact, module, lowered.module).module_fingerprint == 0
        artifact_bytes: darray[u8] = canonical_bytecode_artifact_bytes(artifact)
        artifact_bytes_again: darray[u8] = canonical_bytecode_artifact_bytes(artifact)
        assert artifact_bytes.count > 0
        assert artifact_bytes.count == artifact_bytes_again.count
        for index in 0..<artifact_bytes.count |artifact_bytes, artifact_bytes_again|:
            assert artifact_bytes[index] == artifact_bytes_again[index]
        assert bytecode_artifact_bytes_valid(artifact_bytes)
        bytecode_cache_decision: ArtifactCacheDecision = classify_bytecode_artifact_cache(artifact_bytes)
        assert bytecode_cache_decision.kind == ArtifactCacheKind.BytecodeMetadata
        assert bytecode_cache_decision.admission == ArtifactCacheAdmission.Current
        assert bytecode_cache_decision.fingerprint == artifact.module_fingerprint
        staged_bytecode_cache: ArtifactCachePublication = artifact_cache_stage(bytecode_cache_decision, artifact_bytes.count)
        assert staged_bytecode_cache.state == ArtifactCacheLifecycle.Staged
        assert artifact_cache_commit(staged_bytecode_cache).state == ArtifactCacheLifecycle.Committed
        oversized_bytecode_cache: ArtifactCachePublication = artifact_cache_stage(bytecode_cache_decision, 65537)
        assert oversized_bytecode_cache.state == ArtifactCacheLifecycle.Rejected
        decoded: BytecodeArtifactDecode = decode_bytecode_artifact(artifact_bytes)
        assert decoded.valid
        assert decoded.artifact.backend == artifact.backend
        assert decoded.artifact.source_revision == artifact.source_revision
        assert decoded.artifact.module_fingerprint == artifact.module_fingerprint
        assert decoded.artifact.module_digest_0 == artifact.module_digest_0
        assert decoded.artifact.module_digest_1 == artifact.module_digest_1
        assert decoded.artifact.module_digest_2 == artifact.module_digest_2
        assert decoded.artifact.module_digest_3 == artifact.module_digest_3
        assert decoded.artifact.capability.engine == artifact.capability.engine
        assert decoded.artifact.capability.direct_supported == artifact.capability.direct_supported
        assert decoded.artifact.capability.function_count == artifact.capability.function_count
        assert decoded.artifact.capability.instruction_count == artifact.capability.instruction_count
        assert decoded.artifact.capability.global_count == artifact.capability.global_count
        malformed_magic: mutable darray[u8] = artifact_bytes
        malformed_magic[0] <- 0
        assert not bytecode_artifact_bytes_valid(malformed_magic)
        assert not decode_bytecode_artifact(malformed_magic).valid
        assert not bytecode_artifact_requires_migration(malformed_magic)
        legacy_version: mutable darray[u8] = artifact_bytes
        legacy_version[4] <- 1
        assert not bytecode_artifact_bytes_valid(legacy_version)
        assert not decode_bytecode_artifact(legacy_version).valid
        assert bytecode_artifact_requires_migration(legacy_version)
        assert classify_bytecode_artifact_cache(legacy_version).admission == ArtifactCacheAdmission.NeedsMigration
        assert not bytecode_artifact_requires_migration(artifact_bytes)
        malformed_backend: mutable darray[u8] = artifact_bytes
        malformed_backend[13] <- 66
        assert not bytecode_artifact_bytes_valid(malformed_backend)
        malformed_revision: mutable darray[u8] = artifact_bytes
        malformed_revision[29] <- 0
        assert not bytecode_artifact_bytes_valid(malformed_revision)
        malformed_trailing: mutable darray[u8] = artifact_bytes
        malformed_trailing.push(0)
        assert not bytecode_artifact_bytes_valid(malformed_trailing)
        malformed_truncated: mutable darray[u8] = artifact_bytes
        _ = malformed_truncated.pop()
        assert not bytecode_artifact_bytes_valid(malformed_truncated)
        malformed_count: mutable darray[u8] = artifact_bytes
        count_offset: usize = malformed_count.count - 24
        for index in count_offset..<(count_offset + 8) |malformed_count|:
            malformed_count[index] <- 255
        assert not bytecode_artifact_bytes_valid(malformed_count)
        malformed_digest: mutable darray[u8] = artifact_bytes
        digest_offset: usize = 5 + 8 + 8 + 8 + 13 + 8
        for index in digest_offset..<(digest_offset + 32) |malformed_digest|:
            malformed_digest[index] <- 0
        assert not bytecode_artifact_bytes_valid(malformed_digest)
        malformed_metadata: mutable BytecodeArtifact = artifact
        malformed_metadata.capability.engine <- ExecutionEngine.BytecodeInterpreterFallback
        assert not bytecode_artifact_metadata_valid(malformed_metadata)
        assert not bytecode_artifact_matches_module(malformed_metadata, module, lowered.module)
        assert canonical_bytecode_artifact_bytes(malformed_metadata).count == 0
        assert bytecode_artifact_fingerprint(malformed_metadata) == 0u64
        malformed_metadata.source_revision <- "bad\0revision"
        assert not bytecode_artifact_metadata_valid(malformed_metadata)
        assert canonical_bytecode_artifact_bytes(malformed_metadata).count == 0
        malformed_metadata.source_revision <- artifact.source_revision
        malformed_metadata.module_fingerprint <- 0
        assert not bytecode_artifact_metadata_valid(malformed_metadata)
        assert canonical_bytecode_artifact_bytes(malformed_metadata).count == 0
        malformed_metadata.capability.engine <- artifact.capability.engine
        malformed_metadata.module_digest_0 <- 0
        malformed_metadata.module_digest_1 <- 0
        malformed_metadata.module_digest_2 <- 0
        malformed_metadata.module_digest_3 <- 0
        assert not bytecode_artifact_metadata_valid(malformed_metadata)
        assert not bytecode_artifact_matches_module(malformed_metadata, module, lowered.module)
        assert canonical_bytecode_artifact_bytes(malformed_metadata).count == 0
        partial_metadata: mutable BytecodeArtifact = artifact
        partial_metadata.module_digest_0 <- 0
        assert not bytecode_artifact_metadata_valid(partial_metadata)
        assert not bytecode_artifact_matches_module(partial_metadata, module, lowered.module)
        assert canonical_bytecode_artifact_bytes(partial_metadata).count == 0
        oversized_envelope: mutable darray[u8] = artifact_bytes
        for index in artifact_bytes.count..<65537 |oversized_envelope|:
            oversized_envelope.push(0)
        assert not bytecode_artifact_bytes_valid(oversized_envelope)
        stale_artifact: mutable BytecodeArtifact = artifact
        stale_artifact.source_revision <- "other-revision"
        assert bytecode_artifact_fingerprint(artifact) != bytecode_artifact_fingerprint(stale_artifact)

        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference_success: Execution = try interpret(module, "succeeds", arguments, reference_observations, reference_storage) else failed_execution()
        bytecode_success: Execution = try execute_bytecode(lowered.module, "succeeds", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference_success.value.kind == RuntimeValueKind.Bool
        assert bytecode_success.value.kind == RuntimeValueKind.Bool
        assert reference_success.engine == ExecutionEngine.ReferenceInterpreter
        assert bytecode_success.engine == ExecutionEngine.DirectBytecode
        assert reference_success.value.boolean == bytecode_success.value.boolean

        reference_failure: Execution = try interpret(module, "fails", arguments, reference_observations, reference_storage) else failed_execution()
        bytecode_failure: Execution = try execute_bytecode(lowered.module, "fails", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference_failure.value.kind == RuntimeValueKind.Void
        assert bytecode_failure.value.kind == RuntimeValueKind.Void


@test
def bytecode_raises_and_recovers_declared_error_variants() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "error UserError:\n    Bad\n\ndef fail() -> void error[UserError]:\n    raise UserError.Bad\n\ndef recovered() -> bool:\n    try fail() else void\n    return true\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_opcode_class(Opcode.Raise) == BytecodeDispatchClass.Raise
        assert has_bytecode_opcode(module.functions[0].instruction_pool, Opcode.Raise)
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "recovered", arguments, reference_observations, reference_storage) else failed_execution()
        bytecode: Execution = try execute_bytecode(lowered.module, "recovered", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert bytecode.value.kind == RuntimeValueKind.Bool
        assert reference.value.boolean and bytecode.value.boolean


@test
def bytecode_keeps_panic_outside_error_recovery() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def fail() -> bool:\n    panic(\"boom\")\n    return true\n\ndef guarded() -> bool:\n    try panic(\"boom\") else void\n    return true\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_opcode_class(Opcode.Panic) == BytecodeDispatchClass.Panic
        assert has_bytecode_opcode(module.functions[0].instruction_pool, Opcode.Panic)
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        failed: Execution = try execute_bytecode(lowered.module, "fail", arguments, observations, storage) else failed_execution()
        guarded: Execution = try execute_bytecode(lowered.module, "guarded", arguments, observations, storage) else failed_execution()
        assert failed.value.kind == RuntimeValueKind.Void
        assert guarded.value.kind == RuntimeValueKind.Void


@test
def bytecode_globals_use_verified_interpreter_fallback() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "global counter: i64 = 7\ndef bump() -> i64:\n    counter += 1i64\n    return counter\n\ndef sequence() -> i64:\n    first: i64 = bump()\n    return bump()\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert lowered.module.globals.count == 1
        assert bytecode_opcode_class(Opcode.LoadGlobal) == BytecodeDispatchClass.Frame
        assert bytecode_opcode_class(Opcode.StoreGlobal) == BytecodeDispatchClass.Frame
        assert not bytecode_direct_supported(lowered.module)
        capability: BytecodeCapabilityReport = bytecode_capability_report(lowered.module)
        assert not capability.direct_supported
        assert capability.engine == ExecutionEngine.BytecodeInterpreterFallback
        assert capability.global_count == 1u64
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_bytecode(lowered.module, "sequence", arguments, observations, storage) else failed_execution()
        assert execution.engine == ExecutionEngine.BytecodeInterpreterFallback
        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 9


@test
def bytecode_literal_collection_globals_use_interpreter_fallback() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "global values: darray[i64] = [1i64, 2i64]\ndef total() -> i64:\n    return values[1]\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert lowered.module.globals[0].aggregate_values.count == 2
        assert not bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_bytecode(lowered.module, "total", arguments, observations, storage) else failed_execution()
        assert execution.engine == ExecutionEngine.BytecodeInterpreterFallback
        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 2


@test
def bytecode_direct_only_rejects_interpreter_fallback() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "global counter: i64 = 7\ndef sequence() -> i64:\n    return counter\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert not bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_bytecode_direct_only(lowered.module, "sequence", arguments, observations, storage) else failed_execution()
        # The strict path reports unsupported direct execution rather than
        # returning the valid integer that execute_bytecode obtains by fallback.
        assert execution.value.kind == RuntimeValueKind.Void


@test
def bytecode_updates_literal_collection_globals() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "global values: darray[i64] = [1i64, 2i64]\ndef bump() -> i64:\n    values[0] += 1i64\n    return values[0]\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        execution: Execution = try execute_bytecode(lowered.module, "bump", arguments, observations, storage) else failed_execution()
        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 2


@test
def bytecode_recovers_void_assertions_through_error_guards() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def no_op(value: bool) -> bool:\n    try assert(value) else void\n    return true\n\ndef terminating(value: bool) -> i64:\n    try assert(value) else return 7i64\n    return 1i64\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: true}]
        false_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: false}]
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []

        success_no_op: Execution = try execute_bytecode(lowered.module, "no_op", arguments, observations, storage) else failed_execution()
        recovered_no_op: Execution = try execute_bytecode(lowered.module, "no_op", false_arguments, observations, storage) else failed_execution()
        success_terminating: Execution = try execute_bytecode(lowered.module, "terminating", arguments, observations, storage) else failed_execution()
        recovered_terminating: Execution = try execute_bytecode(lowered.module, "terminating", false_arguments, observations, storage) else failed_execution()
        assert success_no_op.value.kind == RuntimeValueKind.Bool
        assert success_no_op.value.boolean
        assert recovered_no_op.value.kind == RuntimeValueKind.Bool
        assert recovered_no_op.value.boolean
        assert success_terminating.value.integer == 1
        assert recovered_terminating.value.integer == 7


@test
def bytecode_lowering_preserves_verified_cfg_and_assigns_offsets() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(value: i64) -> i64:\n    if value > 0:\n        return value + 1\n    return value - 1\n"
        module: Module = lower_program(source)
        bytecode: BytecodeLowerResult = lower_bytecode(module)

        assert bytecode.issues.count == 0
        assert bytecode.module.name == "bytecode"
        assert bytecode.module.functions.count == 1
        assert bytecode.module.type_table.rows.count == module.type_table.rows.count
        function: BytecodeFunction = bytecode.module.functions[0]
        assert function.name == "main"
        assert function.parameters.count == 1
        assert function.instructions.count == module.functions[0].instruction_pool.count
        assert function.dispatch_classes.count == function.instructions.count
        assert function.blocks.count == module.functions[0].blocks.count
        assert bytecode_block_offset(function, function.entry) == 0
        assert bytecode_block_offset(function, 9999) == function.instructions.count
        assert bytecode_opcode_class(Opcode.Constant) == BytecodeDispatchClass.Literal
        assert bytecode_opcode_class(Opcode.Add) == BytecodeDispatchClass.Binary
        assert bytecode_opcode_class(Opcode.RangeCondition) == BytecodeDispatchClass.Binary
        assert bytecode_opcode_class(Opcode.CaptureProcessResult) == BytecodeDispatchClass.Process
        assert bytecode_opcode_class(Opcode.CaptureProcessResultInDirectory) == BytecodeDispatchClass.Process
        assert bytecode_opcode_class(Opcode.CaptureProcessResultWithEnvironment) == BytecodeDispatchClass.Process
        assert bytecode_opcode_class(Opcode.CaptureProcessResultInDirectoryWithEnvironment) == BytecodeDispatchClass.Process
        assert bytecode_opcode_class(Opcode.CaptureProcessStderrWithStdin) == BytecodeDispatchClass.Process
        assert bytecode_opcode_class(Opcode.RegexFind) == BytecodeDispatchClass.Regex
        assert bytecode_opcode_class(Opcode.PathReal) == BytecodeDispatchClass.Filesystem
        assert bytecode_opcode_class(Opcode.StartsWith) == BytecodeDispatchClass.Text
        assert bytecode_opcode_class(Opcode.EndsWith) == BytecodeDispatchClass.Text
        assert bytecode_opcode_class(Opcode.TrimText) == BytecodeDispatchClass.Text
        assert bytecode_opcode_class(Opcode.Perform) == BytecodeDispatchClass.Effect


@test
def bytecode_lowering_refuses_unverified_modules() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        position: SourceSpan = SourceSpan{file: "bytecode", line: 1, column: 1, end_line: 1, end_column: 1}
        malformed_return: Terminator = Terminator{kind: TerminatorKind.Return, operand: 1, operand_count: 1, target_count: 0, span: position}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: malformed_return}
        fn: Function = Function{name: "bad", parameters: [], return_type: Type{kind: TypeKind.Int, bits: 64, signed: true}, effects: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [block], entry: 1, errors: []}
        module: Module = Module{name: "bad", functions: [fn], handlers: []}
        lowered: BytecodeLowerResult = lower_bytecode(module)

        assert lowered.issues.count > 0
        assert lowered.module.functions.count == 0


@test
def bytecode_preflight_rejects_stale_dispatch_tables() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
