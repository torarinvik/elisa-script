@test
def bytecode_python_range_loops_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(limit: i64) -> i64:\n    total: mutable i64 = 0i64\n    for value in range(limit):\n        total += value\n    for value in range(2i64, limit):\n        total += value\n    for value in range(0i64, 10i64, 2i64):\n        total += value\n    for value in range(5i64, 0i64, -2i64):\n        total += value\n    return total\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

