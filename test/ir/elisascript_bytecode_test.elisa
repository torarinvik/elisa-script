@test
def bytecode_quantifier_comprehensions_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def any_hit() -> bool:\n    return any value in [1i64, 4i64] where value % 2i64 == 0i64\n\ndef all_miss() -> bool:\n    return all value in [1i64, -2i64] where value > 0i64\n\ndef forall_positive() -> bool:\n    return forall value in [1i64, 2i64]: value > 0i64\n\ndef forall_where() -> bool:\n    return forall value in [1i64, 2i64] where value > 0i64\n\ndef exists_where() -> bool:\n    return exists value in [1i64, 4i64] where value % 2i64 == 0i64\n\ndef selected() -> darray[i64]:\n    return each value in [1i64, 2i64, 3i64] where value > 1i64\n\ndef positive_count() -> usize:\n    return count value in [1i64, -2i64, 3i64] where value > 0i64\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: mutable Execution = try interpret(module, "any_hit", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: mutable Execution = try execute_bytecode(lowered.module, "any_hit", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps
        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "forall_where", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "forall_where", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.boolean
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.steps == reference.steps
        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "exists_where", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "exists_where", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.boolean
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.steps == reference.steps
        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "positive_count", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "positive_count", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Int
        assert compiled.value.kind == RuntimeValueKind.Int
        assert reference.value.integer == 2
        assert compiled.value.integer == reference.value.integer
        assert compiled.steps == reference.steps
        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "selected", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "selected", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Array
        assert compiled.value.kind == RuntimeValueKind.Array
        assert reference.value.array_count == 2
        assert compiled.value.array_count == reference.value.array_count
        for offset in 0..<reference.value.array_count.usize() |reference, compiled, reference_storage, bytecode_storage|:
            assert reference_storage[reference.value.array_start.usize() + offset].integer == bytecode_storage[compiled.value.array_start.usize() + offset].integer
        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "all_miss", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "all_miss", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert not reference.value.boolean
        assert not compiled.value.boolean
        assert compiled.steps == reference.steps
        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "forall_positive", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "forall_positive", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps


@test
def bytecode_sum_and_product_queries_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def total() -> i64:\n    return sum value in [1i64, 2i64, 3i64]\n\ndef positive_product() -> i64:\n    return product value in [-1i64, 2i64, 3i64] where value > 0i64\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: mutable Execution = try interpret(module, "total", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: mutable Execution = try execute_bytecode(lowered.module, "total", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Int
        assert compiled.value.kind == RuntimeValueKind.Int
        assert reference.value.integer == 6
        assert compiled.value.integer == reference.value.integer
        assert compiled.steps == reference.steps
        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "positive_product", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "positive_product", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 6
        assert compiled.value.integer == reference.value.integer
        assert compiled.steps == reference.steps


@test
def bytecode_range_queries_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def count_values() -> usize:\n    return count value in 0i64..<5i64 where value > 1i64\n\ndef sum_values() -> i64:\n    return sum value in 1i64..<5i64\n\ndef product_values() -> i64:\n    return product value in 1i64..<5i64..2i64\n\ndef has_value() -> bool:\n    return any value in 5i64..>0i64 where value == 2i64\n\ndef inclusive_values() -> darray[i64]:\n    return [value for value in 1i64..=3i64]\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []

        reference: mutable Execution = try interpret(module, "count_values", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: mutable Execution = try execute_bytecode(lowered.module, "count_values", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 3
        assert compiled.value.integer == reference.value.integer
        assert compiled.steps == reference.steps

        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "sum_values", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "sum_values", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 10
        assert compiled.value.integer == reference.value.integer
        assert compiled.steps == reference.steps

        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "product_values", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "product_values", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 3
        assert compiled.value.integer == reference.value.integer
        assert compiled.steps == reference.steps

        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "has_value", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "has_value", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.boolean
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.steps == reference.steps

        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "inclusive_values", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "inclusive_values", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.array_count == 3
        assert compiled.value.array_count == reference.value.array_count
        for offset in 0..<reference.value.array_count.usize() |reference, compiled, reference_storage, bytecode_storage|:
            assert reference_storage[reference.value.array_start.usize() + offset].integer == bytecode_storage[compiled.value.array_start.usize() + offset].integer


@test
def bytecode_python_range_folds_and_quantifiers_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def folded() -> i64:\n    return sum(range(4i64)) + product(range(1i64, 5i64))\n\ndef counted() -> usize:\n    return count value in range(0i64, 6i64) where value % 2i64 == 0i64\n\ndef any_match() -> bool:\n    return any value in range(4i64) where value > 2i64\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: mutable Execution = try interpret(module, "folded", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: mutable Execution = try execute_bytecode(lowered.module, "folded", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 30
        assert compiled.value.integer == reference.value.integer
        reference <- try interpret(module, "counted", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "counted", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 3
        assert compiled.value.integer == reference.value.integer
        reference <- try interpret(module, "any_match", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "any_match", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.boolean
        assert compiled.value.boolean == reference.value.boolean


@test
def bytecode_dictionary_path_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> i64:\n    values: mutable dict[sview, i64] = {\"one\": 1}\n    values[\"two\"] <- 2\n    observe(values.count)\n    observe(\"one\" in values)\n    return values[\"one\"] + values[\"two\"]\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert compiled.value.integer == reference.value.integer
        assert compiled.value.integer == 3
        assert bytecode_observations.count == reference_observations.count
        assert bytecode_observations[0].value.integer == reference_observations[0].value.integer
        assert bytecode_observations[1].value.boolean == reference_observations[1].value.boolean


