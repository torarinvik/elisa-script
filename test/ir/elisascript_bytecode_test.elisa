        source: static u8& = "def main(value: sview) -> sview:\n    fields: darray[sview] = split(value, \"::\")\n    observe(join(fields, \"|\"))\n    return fields[1] + \"!\"\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "left::right::tail"}]
