@test
def bytecode_python_sum_product_any_all_match_reference() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def totals() -> i64:\n    values: darray[i64] = [2i64, 3i64, 4i64]\n    return sum(values) * 10 + product(values)\n\ndef started() -> i64:\n    values: darray[i64] = [2i64, 3i64, 4i64]\n    return sum(values, 10i64)\n\ndef product_started() -> i64:\n    values: darray[i64] = [2i64, 3i64, 4i64]\n    return product(values, start: 10i64)\n\ndef predicates() -> bool:\n    values: darray[bool] = [false, true]\n    return any(values) and not all(values)\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: mutable Execution = try interpret(module, "totals", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: mutable Execution = try execute_bytecode(lowered.module, "totals", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Int
        assert compiled.value.kind == RuntimeValueKind.Int
        assert reference.value.integer == 114
        assert compiled.value.integer == reference.value.integer
        assert compiled.steps == reference.steps
        reference <- try interpret(module, "started", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "started", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Int
        assert compiled.value.kind == RuntimeValueKind.Int
        assert reference.value.integer == 19
        assert compiled.value.integer == reference.value.integer
        assert compiled.steps == reference.steps
        reference <- try interpret(module, "product_started", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "product_started", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Int
        assert compiled.value.kind == RuntimeValueKind.Int
        assert reference.value.integer == 240
        assert compiled.value.integer == reference.value.integer
        assert compiled.steps == reference.steps
        reference <- try interpret(module, "predicates", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "predicates", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert reference.value.boolean
        assert compiled.value.boolean == reference.value.boolean


@test
def bytecode_dictionary_comprehension_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> dict[i64, i64]:\n    return {value % 2i64: value for value in [1i64, 2i64, 3i64, 4i64]}\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()

        assert reference.value.kind == RuntimeValueKind.Map
        assert compiled.value.kind == RuntimeValueKind.Map
        assert compiled.value.map_count == reference.value.map_count
        for offset in 0..<reference.value.map_count.usize() |reference, compiled, reference_storage, bytecode_storage|:
            reference_pair: usize = reference.value.map_start.usize() + offset * 2
            bytecode_pair: usize = compiled.value.map_start.usize() + offset * 2
            assert reference_storage[reference_pair].integer == bytecode_storage[bytecode_pair].integer
            assert reference_storage[reference_pair + 1].integer == bytecode_storage[bytecode_pair + 1].integer


