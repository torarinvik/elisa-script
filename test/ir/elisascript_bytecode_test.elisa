@test
def bytecode_direct_process_capture_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> sview:\n    return capture_process_stdout(exe\"/usr/bin/printf\", [\"%s\", \"bytecode-process\"])\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Text
        assert compiled.value.kind == RuntimeValueKind.Text
        assert compiled.value.text == reference.value.text
        assert compiled.value.text == "bytecode-process"
        assert compiled.steps == reference.steps


@test
def bytecode_direct_process_family_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> bool:\n    status: i64 = run_process(exe\"/usr/bin/true\", [])\n    output: sview = capture_process_stdout(exe\"/usr/bin/printf\", [\"%s\", \"direct\"])\n    echoed: sview = capture_process_stdout_with_stdin(exe\"/bin/cat\", [], \"stdin\")\n    captured: ProcessCapture = capture_process_result(exe\"/usr/bin/printf\", [\"%s\", \"result\"], \"\")\n    exit_status: i64 = process_exit_status(captured)\n    captured_output: sview = process_stdout(captured)\n    captured_error: sview = process_stderr(captured)\n    observe(status)\n    observe(output)\n    observe(echoed)\n    observe(exit_status)\n    observe(captured_output)\n    observe(captured_error)\n    return status == 0i64 and output == \"direct\" and echoed == \"stdin\" and exit_status == 0i64 and captured_output == \"result\" and captured_error == \"\" and captured == captured\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps
        assert bytecode_observations.count == reference_observations.count
        for index in 0..<reference_observations.count |reference_observations, bytecode_observations|:
            assert bytecode_observations[index].value.kind == reference_observations[index].value.kind
            if reference_observations[index].value.kind == RuntimeValueKind.Int:
                assert bytecode_observations[index].value.integer == reference_observations[index].value.integer
            if reference_observations[index].value.kind == RuntimeValueKind.Text:
                assert bytecode_observations[index].value.text == reference_observations[index].value.text


@test
def bytecode_direct_process_result_in_directory_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> bool:\n    original: Path = current_directory()\n    created: bool = create_directory(path\"/tmp/elisascript-bytecode-process-cwd-test\")\n    written: usize = write_text(path\"/tmp/elisascript-bytecode-process-cwd-test/marker.txt\", \"x\")\n    captured: ProcessCapture = capture_process_result_in_directory(exe\"/bin/ls\", [\"-1\"], \"\", path\"/tmp/elisascript-bytecode-process-cwd-test\")\n    output: sview = process_stdout(captured)\n    removed_file: bool = remove_path(path\"/tmp/elisascript-bytecode-process-cwd-test/marker.txt\")\n    removed_directory: bool = remove_directory(path\"/tmp/elisascript-bytecode-process-cwd-test\")\n    if not created:\n        return false\n    if written != 1u64:\n        return false\n    if process_exit_status(captured) != 0i64:\n        return false\n    if output.count != 11u64:\n        return false\n    if process_stderr(captured) != \"\":\n        return false\n    if not removed_file:\n        return false\n    if not removed_directory:\n        return false\n    if current_directory() != original:\n        return false\n    return true\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps


@test
def bytecode_direct_process_result_with_environment_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> bool:\n    parent_set: bool = set_environment(\"ELISASCRIPT_BYTECODE_CHILD_ENV\", \"parent\")\n    captured: ProcessCapture = capture_process_result_with_environment(exe\"/usr/bin/printenv\", [\"ELISASCRIPT_BYTECODE_CHILD_ENV\"], \"\", {\"ELISASCRIPT_BYTECODE_CHILD_ENV\": \"child-only\"})\n    output: sview = process_stdout(captured)\n    parent_value: sview = get_environment(\"ELISASCRIPT_BYTECODE_CHILD_ENV\")\n    parent_unset: bool = unset_environment(\"ELISASCRIPT_BYTECODE_CHILD_ENV\")\n    if not parent_set:\n        return false\n    if process_exit_status(captured) != 0i64:\n        return false\n    if output.count != 11u64:\n        return false\n    if output[0] != 'c':\n        return false\n    if parent_value.count != 6u64:\n        return false\n    if parent_value[0] != 'p':\n        return false\n    if not parent_unset:\n        return false\n    return true\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps


@test
def bytecode_direct_process_result_in_directory_with_environment_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> bool:\n    original: Path = current_directory()\n    created: bool = create_directory(path\"/tmp/elisascript-bytecode-process-cwd-env-test\")\n    captured: ProcessCapture = capture_process_result_in_directory_with_environment(exe\"/usr/bin/printenv\", [\"ELISASCRIPT_BYTECODE_CWD_ENV\"], \"\", path\"/tmp/elisascript-bytecode-process-cwd-env-test\", {\"ELISASCRIPT_BYTECODE_CWD_ENV\": \"child-only\"})\n    output: sview = process_stdout(captured)\n    removed_directory: bool = remove_directory(path\"/tmp/elisascript-bytecode-process-cwd-env-test\")\n    parent_ok: bool = current_directory() == original\n    if not created:\n        return false\n    if process_exit_status(captured) != 0i64:\n        return false\n    if output.count != 11u64:\n        return false\n    if output[0] != 'c':\n        return false\n    if process_stderr(captured) != \"\":\n        return false\n    if not removed_directory:\n        return false\n    if not parent_ok:\n        return false\n    return true\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps


@test
def bytecode_direct_text_fields_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(value: sview) -> sview:\n    fields: darray[sview] = split(value, \"::\")\n    observe(join(fields, \"|\"))\n    return fields[1] + \"!\"\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "left::right::tail"}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Text
        assert compiled.value.kind == RuntimeValueKind.Text
        assert compiled.value.text == reference.value.text
        assert compiled.value.text == "right!"
        assert bytecode_observations.count == reference_observations.count
        assert bytecode_observations[0].value.kind == RuntimeValueKind.Text
        assert bytecode_observations[0].value.text == reference_observations[0].value.text
        assert bytecode_observations[0].value.text == "left|right|tail"


