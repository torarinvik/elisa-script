@test
def bytecode_supports_line_input_in_direct_path() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> sview:\n    return input(\"value: \")\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert has_bytecode_opcode(lowered.module.functions[0].instructions, Opcode.ReadStdinLine)
        assert bytecode_opcode_class(Opcode.ReadStdinLine) == BytecodeDispatchClass.Stdio
        # Line reads consume exactly one byte at a time, so the direct bytecode
        # engine can preserve the reference machine's stream position without a
        # separate buffering layer.
        assert bytecode_direct_supported(lowered.module)
        ir_module: Module = bytecode_to_ir(lowered.module)
        assert verify(ir_module).count == 0


