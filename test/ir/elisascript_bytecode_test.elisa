@test
def bytecode_python_append_array_alias_matches_reference() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def build() -> darray[i64]:\n    values: mutable darray[i64] = []\n    values.append(1)\n    values.append(2)\n    return values\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: mutable Execution = try interpret(module, "build", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: mutable Execution = try execute_bytecode(lowered.module, "build", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Array
        assert compiled.value.kind == RuntimeValueKind.Array
        assert reference.value.array_count == 2
        assert compiled.value.array_count == reference.value.array_count
        assert bytecode_storage[compiled.value.array_start.usize()].integer == 1
        assert bytecode_storage[compiled.value.array_start.usize() + 1].integer == 2


@test
def bytecode_python_pop_value_and_rebinding_matches_reference() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def build() -> i64:\n    values: mutable darray[i64] = [10, 20, 30]\n    removed: i64 = values.pop()\n    return removed * 100 + values[1]\n\ndef indexed() -> i64:\n    values: mutable darray[i64] = [10, 20, 30]\n    removed: i64 = values.pop(1)\n    return removed * 100 + values[1]\n\ndef negative() -> i64:\n    values: mutable darray[i64] = [10, 20, 30]\n    return values.pop(-2)\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
