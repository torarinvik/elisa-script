@test
def bytecode_direct_python_text_whitespace_split_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(value: sview) -> darray[sview]:\n    return value.split()\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "  alpha\tbeta\n gamma  "}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Array
        assert compiled.value.kind == RuntimeValueKind.Array
        assert reference.value.array_count == 3u32
        assert compiled.value.array_count == reference.value.array_count
        assert reference_storage[reference.value.array_start.usize()].text == "alpha"
        assert reference_storage[reference.value.array_start.usize() + 1].text == "beta"
        assert reference_storage[reference.value.array_start.usize() + 2].text == "gamma"
        assert bytecode_storage[compiled.value.array_start.usize()].text == "alpha"
        assert bytecode_storage[compiled.value.array_start.usize() + 1].text == "beta"
        assert bytecode_storage[compiled.value.array_start.usize() + 2].text == "gamma"
        assert compiled.steps == reference.steps


