        assert bytecode_name.value.text == reference_name.value.text
        assert bytecode_extension.value.text == reference_extension.value.text
        assert bytecode_stem.value.text == reference_stem.value.text
        assert bytecode_parent_alias.value.text == reference_parent_alias.value.text
        assert bytecode_name_alias.value.text == reference_name_alias.value.text
        assert bytecode_suffix_alias.value.text == reference_suffix_alias.value.text
        assert bytecode_stem_alias.value.text == reference_stem_alias.value.text
