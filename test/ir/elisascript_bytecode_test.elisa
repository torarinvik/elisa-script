@test
def bytecode_dictionary_comprehension_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> dict[i64, i64]:\n    return {value % 2i64: value for value in [1i64, 2i64, 3i64, 4i64]}\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()

        assert reference.value.kind == RuntimeValueKind.Map
        assert compiled.value.kind == RuntimeValueKind.Map
        assert compiled.value.map_count == reference.value.map_count
        for offset in 0..<reference.value.map_count.usize() |reference, compiled, reference_storage, bytecode_storage|:
            reference_pair: usize = reference.value.map_start.usize() + offset * 2
            bytecode_pair: usize = compiled.value.map_start.usize() + offset * 2
            assert reference_storage[reference_pair].integer == bytecode_storage[bytecode_pair].integer
            assert reference_storage[reference_pair + 1].integer == bytecode_storage[bytecode_pair + 1].integer


