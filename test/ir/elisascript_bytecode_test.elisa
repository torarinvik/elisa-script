@test
def bytecode_python_sorted_reverse_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def literal() -> darray[i64]:\n    return sorted([1i64, 3i64, 2i64], reverse: true)\n\ndef dynamic(descending: bool) -> darray[i64]:\n    values: darray[i64] = [1i64, 3i64, 2i64]\n    return sorted(values, reverse: descending)\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: mutable Execution = try interpret(module, "literal", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: mutable Execution = try execute_bytecode(lowered.module, "literal", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.array_count == 3
        assert compiled.value.array_count == reference.value.array_count
        for offset in 0..<reference.value.array_count.usize() |reference, compiled, reference_storage, bytecode_storage|:
            assert reference_storage[reference.value.array_start.usize() + offset].integer == bytecode_storage[compiled.value.array_start.usize() + offset].integer

        values: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: false}]
        reference <- try interpret(module, "dynamic", values, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "dynamic", values, bytecode_observations, bytecode_storage) else failed_execution()
        for offset in 0..<reference.value.array_count.usize() |reference, compiled, reference_storage, bytecode_storage|:
            assert reference_storage[reference.value.array_start.usize() + offset].integer == bytecode_storage[compiled.value.array_start.usize() + offset].integer


@test
def bytecode_range_array_comprehension_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def ascending() -> darray[i64]:\n    return [value * 2i64 for value in 1i64..<5i64]\n\ndef stepped() -> darray[i64]:\n    return [value for value in 0i64..<10i64..2i64]\n\ndef descending() -> darray[i64]:\n    return [value for value in 5i64..>0i64]\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: mutable Execution = try interpret(module, "ascending", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: mutable Execution = try execute_bytecode(lowered.module, "ascending", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Array
        assert compiled.value.kind == RuntimeValueKind.Array
        assert compiled.value.array_count == reference.value.array_count
        for offset in 0..<reference.value.array_count.usize() |reference, compiled, reference_storage, bytecode_storage|:
            assert reference_storage[reference.value.array_start.usize() + offset].integer == bytecode_storage[compiled.value.array_start.usize() + offset].integer

        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "stepped", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "stepped", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.array_count == 5
        assert compiled.value.array_count == reference.value.array_count
        for offset in 0..<reference.value.array_count.usize() |reference, compiled, reference_storage, bytecode_storage|:
            assert reference_storage[reference.value.array_start.usize() + offset].integer == bytecode_storage[compiled.value.array_start.usize() + offset].integer

        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "descending", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "descending", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.array_count == 5
        assert compiled.value.array_count == reference.value.array_count
        for offset in 0..<reference.value.array_count.usize() |reference, compiled, reference_storage, bytecode_storage|:
            assert reference_storage[reference.value.array_start.usize() + offset].integer == bytecode_storage[compiled.value.array_start.usize() + offset].integer


@test
def bytecode_python_range_loops_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(limit: i64) -> i64:\n    total: mutable i64 = 0i64\n    for value in range(limit):\n        total += value\n    for value in range(2i64, limit):\n        total += value\n    for value in range(0i64, 10i64, 2i64):\n        total += value\n    for value in range(5i64, 0i64, -2i64):\n        total += value\n    return total\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        arguments: darray[RuntimeValue] = [runtime_int(4)]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()

        assert reference.value.kind == RuntimeValueKind.Int
        assert compiled.value.kind == RuntimeValueKind.Int
        assert reference.value.integer == 40
        assert compiled.value.integer == reference.value.integer
        assert compiled.steps == reference.steps


@test
def bytecode_dynamic_python_range_steps_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def loop(step: i64) -> i64:\n    total: mutable i64 = 0i64\n    for value in range(0i64, 10i64, step):\n        total += value\n    return total\n\ndef descending(step: i64) -> i64:\n    total: mutable i64 = 0i64\n    for value in range(10i64, 0i64, step):\n        total += value\n    return total\n\ndef projected(step: i64) -> darray[i64]:\n    return [value for value in range(0i64, 10i64, step)]\n\ndef folded(step: i64) -> i64:\n    return sum(range(0i64, 10i64, step))\n\ndef mapped(step: i64) -> dict[i64, i64]:\n    return {value: value * 2i64 for value in range(0i64, 10i64, step)}\n\ndef all_match(step: i64) -> bool:\n    return all value in range(0i64, 10i64, step) where value < 10i64\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        positive: darray[RuntimeValue] = [runtime_int(3)]
        negative: darray[RuntimeValue] = [runtime_int(-3)]
        zero: darray[RuntimeValue] = [runtime_int(0)]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []

        reference: mutable Execution = try interpret(module, "loop", positive, reference_observations, reference_storage) else failed_execution()
        compiled: mutable Execution = try execute_bytecode(lowered.module, "loop", positive, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 18
        assert compiled.value.integer == reference.value.integer

        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "mapped", positive, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "mapped", positive, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.map_count == 4
        assert compiled.value.map_count == reference.value.map_count

        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "all_match", positive, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "all_match", positive, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.boolean
        assert compiled.value.boolean == reference.value.boolean

        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "descending", negative, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "descending", negative, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 22
        assert compiled.value.integer == reference.value.integer

        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "projected", positive, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "projected", positive, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.array_count == 4
        assert compiled.value.array_count == reference.value.array_count
        for offset in 0..<reference.value.array_count.usize() |reference, compiled, reference_storage, bytecode_storage|:
            assert reference_storage[reference.value.array_start.usize() + offset].integer == bytecode_storage[compiled.value.array_start.usize() + offset].integer

        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "folded", positive, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "folded", positive, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 18
        assert compiled.value.integer == reference.value.integer

        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "loop", zero, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "loop", zero, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Void
        assert compiled.value.kind == RuntimeValueKind.Void


@test
def bytecode_dynamic_numeric_range_membership_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def ascending(value: i64, stride: i64) -> bool error[RangeStepZero]:\n    return value in 0..<10..stride\n\ndef negative(value: i64, stride: i64) -> bool error[RangeStepZero]:\n    return value in 10..<0..stride\n\ndef descending(value: i64, stride: i64) -> bool error[RangeStepZero]:\n    return value in 9..>0..stride\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        inside: darray[RuntimeValue] = [runtime_int(4), runtime_int(2)]
        misaligned: darray[RuntimeValue] = [runtime_int(5), runtime_int(2)]
        negative_inside: darray[RuntimeValue] = [runtime_int(4), runtime_int(-2)]
        descending_inside: darray[RuntimeValue] = [runtime_int(5), runtime_int(4)]
        zero: darray[RuntimeValue] = [runtime_int(0), runtime_int(0)]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []

        reference: mutable Execution = try interpret(module, "ascending", inside, reference_observations, reference_storage) else failed_execution()
        compiled: mutable Execution = try execute_bytecode(lowered.module, "ascending", inside, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.boolean
        assert compiled.value.boolean == reference.value.boolean

        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "ascending", misaligned, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "ascending", misaligned, bytecode_observations, bytecode_storage) else failed_execution()
        assert not reference.value.boolean
        assert compiled.value.boolean == reference.value.boolean

        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "negative", negative_inside, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "negative", negative_inside, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.boolean
        assert compiled.value.boolean == reference.value.boolean

        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "descending", descending_inside, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "descending", descending_inside, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.boolean
        assert compiled.value.boolean == reference.value.boolean

        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "ascending", zero, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "ascending", zero, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Void
        assert compiled.value.kind == RuntimeValueKind.Void


@test
def bytecode_array_comprehension_with_key_value_binders_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> darray[i64]:\n    values: dict[i64, i64] = {1i64: 2i64, 3i64: 4i64}\n    return [value * 2i64 for key, value in values]\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()

        assert reference.value.kind == RuntimeValueKind.Array
        assert compiled.value.kind == RuntimeValueKind.Array
        assert reference.value.array_count == 2
        assert compiled.value.array_count == reference.value.array_count
        for offset in 0..<reference.value.array_count.usize() |reference, compiled, reference_storage, bytecode_storage|:
            assert reference_storage[reference.value.array_start.usize() + offset].integer == bytecode_storage[compiled.value.array_start.usize() + offset].integer
        assert reference_storage[reference.value.array_start.usize()].integer == 4
        assert reference_storage[reference.value.array_start.usize() + 1].integer == 8


