@test
def bytecode_direct_copy_and_move_paths_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO:
        source_path: static u8& = "/tmp/elisascript-bytecode-copy-source.txt"
        copied_path: static u8& = "/tmp/elisascript-bytecode-copy-destination.txt"
        moved_path: static u8& = "/tmp/elisascript-bytecode-copy-moved.txt"
        _ = remove_file(source_path)
        _ = remove_file(copied_path)
        _ = remove_file(moved_path)
        source: static u8& = "def main() -> bool:\n    source: Path = path\"/tmp/elisascript-bytecode-copy-source.txt\"\n    copied_path: Path = path\"/tmp/elisascript-bytecode-copy-destination.txt\"\n    moved_path: Path = path\"/tmp/elisascript-bytecode-copy-moved.txt\"\n    written: usize = write_text(source, \"bytecode-copy\")\n    copied: bool = copy_path(source, copied_path)\n    moved: bool = move_path(copied_path, moved_path)\n    contents: sview = read_text(moved_path)\n    removed_source: bool = remove_path(source)\n    removed_moved: bool = remove_path(moved_path)\n    observe(written)\n    observe(copied)\n    observe(moved)\n    observe(contents)\n    return written == 13u64 and copied and moved and contents == \"bytecode-copy\" and removed_source and removed_moved\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        _ = remove_file(source_path)
        _ = remove_file(copied_path)
        _ = remove_file(moved_path)
        assert reference.value.boolean
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps
        assert bytecode_observations.count == reference_observations.count
        assert bytecode_observations[0].value.integer == reference_observations[0].value.integer
        assert bytecode_observations[1].value.boolean == reference_observations[1].value.boolean
        assert bytecode_observations[2].value.boolean == reference_observations[2].value.boolean
        assert bytecode_observations[3].value.text == reference_observations[3].value.text


@test
def bytecode_direct_environment_path_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> bool:\n    cleared: bool = unset_environment(\"ELISASCRIPT_BYTECODE_ENV\")\n    updated: bool = set_environment(\"ELISASCRIPT_BYTECODE_ENV\", \"packed\")\n    current: sview = get_environment(\"ELISASCRIPT_BYTECODE_ENV\")\n    removed: bool = unset_environment(\"ELISASCRIPT_BYTECODE_ENV\")\n    observe(cleared)\n    observe(updated)\n    observe(current)\n    observe(removed)\n    return cleared and updated and current == \"packed\" and removed\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps
        assert bytecode_observations.count == reference_observations.count
        for index in 0..<reference_observations.count |reference_observations, bytecode_observations|:
            assert bytecode_observations[index].value.kind == reference_observations[index].value.kind
            if reference_observations[index].value.kind == RuntimeValueKind.Bool:
                assert bytecode_observations[index].value.boolean == reference_observations[index].value.boolean
            if reference_observations[index].value.kind == RuntimeValueKind.Text:
                assert bytecode_observations[index].value.text == reference_observations[index].value.text


