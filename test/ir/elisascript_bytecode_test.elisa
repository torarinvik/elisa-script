        assert compiled.steps == reference.steps


@test
def bytecode_indexed_array_and_text_iteration_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def array() -> i64:\n    values: darray[i64] = [4i64, 5i64, 6i64]\n    total: mutable i64 = 0\n    for index, value in values:\n        if index == 0usize:\n            total += value\n        if index == 1usize:\n            total += value * 2i64\n        if index == 2usize:\n            total += value * 3i64\n    return total\n\ndef text() -> char:\n    for index, value in \"abc\":\n        if index == 1usize:\n            return value\n    return 'x'\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
