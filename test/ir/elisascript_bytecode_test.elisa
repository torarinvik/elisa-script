@test
def bytecode_direct_call_path_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def increment(value: i64) -> i64:\n    answer: i64 = value + 1\n    observe(answer)\n    return answer\n\ndef main(value: i64) -> i64:\n    answer: i64 = increment(value)\n    observe(answer)\n    return answer\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 41}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Int
        assert compiled.value.kind == RuntimeValueKind.Int
        assert compiled.value.integer == reference.value.integer
        assert compiled.value.integer == 42
        assert compiled.steps == reference.steps
        assert bytecode_observations.count == reference_observations.count
        assert bytecode_observations[0].value.integer == reference_observations[0].value.integer
        assert bytecode_observations[1].value.integer == reference_observations[1].value.integer


@test
def bytecode_direct_filesystem_path_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO:
        temporary_path: static u8& = "/tmp/elisascript-bytecode-filesystem-test.txt"
        _ = remove_file(temporary_path)
        source: static u8& = "def main() -> bool:\n    existed: bool = path_exists(path\"/dev/null\")\n    written: usize = write_text(path\"/tmp/elisascript-bytecode-filesystem-test.txt\", \"bytecode-fs\")\n    contents: sview = read_text(path\"/tmp/elisascript-bytecode-filesystem-test.txt\")\n    removed: bool = remove_path(path\"/tmp/elisascript-bytecode-filesystem-test.txt\")\n    observe(existed)\n    observe(written)\n    observe(contents)\n    observe(removed)\n    return existed and written == 11u64 and contents == \"bytecode-fs\" and removed and not path_exists(path\"/tmp/elisascript-bytecode-filesystem-test.txt\")\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        _ = remove_file(temporary_path)
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps
        assert bytecode_observations.count == reference_observations.count
        assert bytecode_observations[0].value.boolean == reference_observations[0].value.boolean
        assert bytecode_observations[1].value.integer == reference_observations[1].value.integer
        assert bytecode_observations[2].value.text == reference_observations[2].value.text
        assert bytecode_observations[3].value.boolean == reference_observations[3].value.boolean


