@test
def bytecode_direct_read_lines_preserves_trailing_empty_field() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO:
        temporary_path: static u8& = "/tmp/elisascript-trailing-line-bytecode-test.txt"
        _ = remove_file(temporary_path)
        source: static u8& = "def save() -> usize:\n    return write_text(path\"/tmp/elisascript-trailing-line-bytecode-test.txt\", \"alpha\\n\")\n\ndef load() -> darray[sview]:\n    return read_lines(path\"/tmp/elisascript-trailing-line-bytecode-test.txt\")\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        direct_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        direct_storage: mutable darray[RuntimeValue] = []
        reference_written: Execution = try interpret(module, "save", arguments, reference_observations, reference_storage) else failed_execution()
        direct_written: Execution = try execute_bytecode_direct_only(lowered.module, "save", arguments, direct_observations, direct_storage) else failed_execution()
        reference_loaded: Execution = try interpret(module, "load", arguments, reference_observations, reference_storage) else failed_execution()
        direct_loaded: Execution = try execute_bytecode_direct_only(lowered.module, "load", arguments, direct_observations, direct_storage) else failed_execution()
        _ = remove_file(temporary_path)
        assert reference_written.value.kind == RuntimeValueKind.Int
        assert direct_written.value.kind == RuntimeValueKind.Int
        assert reference_written.value.integer == 6
        assert direct_written.value.integer == reference_written.value.integer
        assert reference_loaded.value.kind == RuntimeValueKind.Array
        assert direct_loaded.value.kind == RuntimeValueKind.Array
        assert reference_loaded.value.array_count == 2
        assert direct_loaded.value.array_count == reference_loaded.value.array_count
        assert reference_storage[reference_loaded.value.array_start.usize()].text == "alpha"
        assert reference_storage[reference_loaded.value.array_start.usize() + 1].text == ""
        assert direct_storage[direct_loaded.value.array_start.usize()].text == "alpha"
        assert direct_storage[direct_loaded.value.array_start.usize() + 1].text == ""


@test
def bytecode_direct_rejects_empty_and_embedded_nul_line_paths() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO:
        source: static u8& = "def empty_path() -> usize error[FileIoError] can[File.Write]:\n    return write_lines(path(\"\"), [\"x\"])\n\ndef embedded_path() -> usize error[FileIoError] can[File.Write]:\n    return append_lines(path(\"bad\\0suffix\"), [\"x\"])\n\ndef recovered_empty() -> bool:\n    value: usize = try empty_path() else 0usize\n    return value == 0usize\n\ndef recovered_embedded() -> bool:\n    value: usize = try embedded_path() else 0usize\n    return value == 0usize\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        direct_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        direct_storage: mutable darray[RuntimeValue] = []
        reference_empty: Execution = try interpret(module, "recovered_empty", arguments, reference_observations, reference_storage) else failed_execution()
        direct_empty: Execution = try execute_bytecode_direct_only(lowered.module, "recovered_empty", arguments, direct_observations, direct_storage) else failed_execution()
        reference_embedded: Execution = try interpret(module, "recovered_embedded", arguments, reference_observations, reference_storage) else failed_execution()
        direct_embedded: Execution = try execute_bytecode_direct_only(lowered.module, "recovered_embedded", arguments, direct_observations, direct_storage) else failed_execution()
        assert reference_empty.value.kind == RuntimeValueKind.Bool
        assert direct_empty.value.kind == RuntimeValueKind.Bool
        assert reference_empty.value.boolean and direct_empty.value.boolean
        assert reference_embedded.value.kind == RuntimeValueKind.Bool
        assert direct_embedded.value.kind == RuntimeValueKind.Bool
        assert reference_embedded.value.boolean and direct_embedded.value.boolean


@test
def bytecode_direct_path_shape_operations_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def combine(base: Path, leaf: sview) -> Path:\n    return path_join(base, leaf)\n\ndef parent(path_value: Path) -> Path:\n    return path_parent(path_value)\n\ndef parent_alias(path_value: Path) -> Path:\n    return dirname(path_value)\n\ndef name(path_value: Path) -> sview:\n    return path_name(path_value)\n\ndef name_alias(path_value: Path) -> sview:\n    return basename(path_value)\n\ndef extension(path_value: Path) -> sview:\n    return path_extension(path_value)\n\ndef suffix_alias(path_value: Path) -> sview:\n    return suffix(path_value)\n\ndef stem_value(path_value: Path) -> sview:\n    return path_stem(path_value)\n\ndef stem_alias(path_value: Path) -> sview:\n    return stem(path_value)\n\ndef directory_alias(path_value: Path) -> bool:\n    return is_dir(path_value)\n\ndef parent_property(path_value: Path) -> Path:\n    return path_value.parent\n\ndef name_property(path_value: Path) -> sview:\n    return path_value.name\n\ndef suffix_property(path_value: Path) -> sview:\n    return path_value.suffix\n\ndef stem_property(path_value: Path) -> sview:\n    return path_value.stem\n\ndef join_method(base: Path, leaf: sview) -> Path:\n    return base.joinpath(leaf)\n\ndef exists_method(path_value: Path) -> bool:\n    return path_value.exists()\n\ndef directory_method(path_value: Path) -> bool:\n    return path_value.is_dir()\n\ndef file_predicate(path_value: Path) -> bool:\n    return is_file(path_value)\n\ndef file_method(path_value: Path) -> bool:\n    return path_value.is_file()\n"
