@test
def bytecode_direct_python_path_file_methods_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> bool:\n    original: Path = path\"/tmp/elisascript-python-path-method-bytecode-source.txt\"\n    renamed: Path = path\"/tmp/elisascript-python-path-method-bytecode-renamed.txt\"\n    binary_path: Path = path\"/tmp/elisascript-python-path-method-bytecode-bytes.bin\"\n    written: usize = original.write_text(\"payload\")\n    text: sview = original.read_text()\n    byte_written: usize = binary_path.write_bytes([65u8, 0u8, 66u8])\n    bytes: darray[u8] = binary_path.read_bytes()\n    removed_binary: bool = binary_path.unlink()\n    renamed_ok: bool = original.rename(renamed)\n    renamed_text: sview = renamed.read_text()\n    removed_renamed: bool = renamed.unlink()\n    return written == 7u64 and text == \"payload\" and byte_written == 3u64 and bytes.count == 3u64 and bytes[0] == 65u8 and bytes[1] == 0u8 and bytes[2] == 66u8 and removed_binary and renamed_ok and renamed_text == \"payload\" and removed_renamed\n"
