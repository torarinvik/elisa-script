        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        direct_only: Execution = try execute_bytecode_direct_only(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Text
        assert compiled.value.kind == RuntimeValueKind.Text
        assert direct_only.value.kind == RuntimeValueKind.Text
        assert compiled.engine == ExecutionEngine.DirectBytecode
        assert direct_only.engine == ExecutionEngine.DirectBytecode
        assert compiled.value.text == reference.value.text
        assert direct_only.value.text == reference.value.text
        assert compiled.value.text == "bytecode-process"
        assert compiled.steps == reference.steps


@test
def bytecode_direct_nested_process_output_is_accounted_once() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def child() -> sview:\n    return capture_process_stdout(exe\"/usr/bin/printf\", [\"%s\", \"nested-child\"])\n\ndef parent() -> sview:\n    return child()\n\ndef child_fails() -> sview:\n    first: sview = capture_process_stdout(exe\"/usr/bin/printf\", [\"%s\", \"nested-child\"])\n    assert(false)\n    return first\n\ndef recovering() -> bool:\n    try child_fails() else void\n    return true\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        direct_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        direct_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "parent", arguments, reference_observations, reference_storage) else failed_execution()
        direct: Execution = try execute_bytecode_direct_only(lowered.module, "parent", arguments, direct_observations, direct_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Text
        assert direct.value.kind == RuntimeValueKind.Text
        assert reference.value.text == "nested-child"
        assert direct.value.text == reference.value.text
        # The child capture contributes exactly once to the parent's ledger;
        # the call instruction itself has no synthetic output.
        assert direct.usage.output_bytes == reference.usage.output_bytes
        assert direct.usage.output_bytes == 12

        recovered_reference_observations: mutable darray[Observation] = []
        recovered_direct_observations: mutable darray[Observation] = []
        recovered_reference_storage: mutable darray[RuntimeValue] = []
        recovered_direct_storage: mutable darray[RuntimeValue] = []
        recovered_reference: Execution = try interpret(module, "recovering", arguments, recovered_reference_observations, recovered_reference_storage) else failed_execution()
        recovered_direct: Execution = try execute_bytecode_direct_only(lowered.module, "recovering", arguments, recovered_direct_observations, recovered_direct_storage) else failed_execution()
        assert recovered_reference.value.kind == RuntimeValueKind.Bool
        assert recovered_direct.value.kind == RuntimeValueKind.Bool
        assert recovered_reference.value.boolean and recovered_direct.value.boolean
        # A child that emits output before a recoverable assertion still
        # contributes those bytes after the parent resumes from the guard.
        assert recovered_direct.usage.output_bytes == recovered_reference.usage.output_bytes
        assert recovered_direct.usage.output_bytes == 12


@test
def bytecode_direct_process_family_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> bool:\n    status: i64 = run_process(exe\"/usr/bin/true\", [])\n    output: sview = capture_process_stdout(exe\"/usr/bin/printf\", [\"%s\", \"direct\"])\n    echoed: sview = capture_process_stdout_with_stdin(exe\"/bin/cat\", [], \"stdin\")\n    diagnostic: sview = capture_process_stderr_with_stdin(exe\"/bin/sh\", [\"-c\", \"cat >&2\"], \"stderr\")\n    captured: ProcessCapture = capture_process_result(exe\"/usr/bin/printf\", [\"%s\", \"result\"], \"\")\n    exit_status: i64 = process_exit_status(captured)\n    captured_output: sview = process_stdout(captured)\n    captured_error: sview = process_stderr(captured)\n    observe(status)\n    observe(output)\n    observe(echoed)\n    observe(diagnostic)\n    observe(exit_status)\n    observe(captured_output)\n    observe(captured_error)\n    return status == 0i64 and output == \"direct\" and echoed == \"stdin\" and diagnostic == \"stderr\" and exit_status == 0i64 and captured_output == \"result\" and captured_error == \"\" and captured == captured\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps
        assert bytecode_observations.count == reference_observations.count
        for index in 0..<reference_observations.count |reference_observations, bytecode_observations|:
            assert bytecode_observations[index].value.kind == reference_observations[index].value.kind
            if reference_observations[index].value.kind == RuntimeValueKind.Int:
                assert bytecode_observations[index].value.integer == reference_observations[index].value.integer
            if reference_observations[index].value.kind == RuntimeValueKind.Text:
                assert bytecode_observations[index].value.text == reference_observations[index].value.text


