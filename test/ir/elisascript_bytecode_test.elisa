@test
def bytecode_map_equality_uses_bijective_pair_matching() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def equal(left: dict[sview, i64], right: dict[sview, i64]) -> bool:\n    return left == right\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = [runtime_map(0, 3), runtime_map(6, 3)]
        storage: mutable darray[RuntimeValue] = [runtime_text("one"), runtime_int(1), runtime_text("one"), runtime_int(1), runtime_text("two"), runtime_int(2), runtime_text("one"), runtime_int(1), runtime_text("two"), runtime_int(2), runtime_text("three"), runtime_int(3)]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = storage
        bytecode_storage: mutable darray[RuntimeValue] = storage
        reference: Execution = try interpret(module, "equal", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "equal", arguments, bytecode_observations, bytecode_storage) else failed_execution()

        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert not reference.value.boolean
        assert not compiled.value.boolean


@test
def bytecode_direct_path_rejects_malformed_external_map_ranges() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def read(values: dict[sview, i64]) -> i64:\n    return values[\"one\"]\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = [runtime_map(1, 1)]
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = [runtime_text("one"), runtime_int(1)]

        assert not runtime_map_range_valid(storage, arguments[0])
        rejected: Execution = try execute_bytecode(lowered.module, "read", arguments, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert rejected.value.kind == RuntimeValueKind.Void


