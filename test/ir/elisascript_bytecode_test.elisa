@test
def bytecode_typed_set_literals_comprehensions_and_iteration_match_reference() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def literal() -> bool:\n    values: set[i64] = {1i64, 2i64}\n    return 2i64 in values and values.count == 2u64\n\ndef comprehension() -> bool:\n    values: set[i64] = {value for value in [1i64, 1i64, 2i64]}\n    return values.count == 2u64 and 1i64 in values and 2i64 in values\n\ndef iterate() -> i64:\n    values: set[i64] = {1i64, 2i64}\n    total: mutable i64 = 0\n    for value in values:\n        total += value\n    return total\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        literal_reference: Execution = try interpret(module, "literal", arguments, reference_observations, reference_storage) else failed_execution()
        literal_compiled: Execution = try execute_bytecode(lowered.module, "literal", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert literal_compiled.value.kind == literal_reference.value.kind
        assert literal_compiled.value.boolean == literal_reference.value.boolean
        assert literal_compiled.value.boolean

        comprehension_reference: Execution = try interpret(module, "comprehension", arguments, reference_observations, reference_storage) else failed_execution()
        comprehension_compiled: Execution = try execute_bytecode(lowered.module, "comprehension", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert comprehension_compiled.value.kind == comprehension_reference.value.kind
        assert comprehension_compiled.value.boolean == comprehension_reference.value.boolean
        assert comprehension_compiled.value.boolean

        iterate_reference: Execution = try interpret(module, "iterate", arguments, reference_observations, reference_storage) else failed_execution()
        iterate_compiled: Execution = try execute_bytecode(lowered.module, "iterate", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert iterate_compiled.value.kind == iterate_reference.value.kind
        assert iterate_compiled.value.integer == iterate_reference.value.integer
        assert iterate_compiled.value.integer == 3


@test
def bytecode_mutable_set_add_updates_match_reference() -> void:
