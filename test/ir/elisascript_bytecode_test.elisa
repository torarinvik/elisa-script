@test
def bytecode_environment_default_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> bool:\n    cleared: bool = unset_environment(\"ELISASCRIPT_BYTECODE_TEST_OR\")\n    missing: sview = get_environment_or(\"ELISASCRIPT_BYTECODE_TEST_OR\", \"fallback\")\n    set_ok: bool = set_environment(\"ELISASCRIPT_BYTECODE_TEST_OR\", \"present\")\n    present: sview = get_environment_or(\"ELISASCRIPT_BYTECODE_TEST_OR\", \"fallback\")\n    unset_ok: bool = unset_environment(\"ELISASCRIPT_BYTECODE_TEST_OR\")\n    return missing == \"fallback\" and set_ok and present == \"present\" and unset_ok\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert reference.value.boolean
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.steps == reference.steps


@test
def bytecode_checked_indexing_matches_reference_interpreter_and_keeps_fallback_lazy() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def fallback() -> i64:\n    observe(88)\n    return 99i64\n\ndef array_safe(index: i64) -> i64:\n    values: darray[i64] = [10i64, 20i64]\n    return get values[index] else fallback()\n\ndef text_safe(index: i64) -> char:\n    value: sview = \"cat\"\n    return get value[index] else '?'\n\ndef array_update() -> i64:\n    values: mutable darray[i64] = [10i64, 20i64]\n    values[-1] <- 40i64\n    return values[-1]\n\ndef map_safe(key: sview) -> i64:\n    values: dict[sview, i64] = {\"one\": 1i64}\n    return get values[key] else 99i64\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        index: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 1}]
        negative_index: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: -1}]
        missing_index: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 9}]
        key: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "one"}]
        missing_key: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "two"}]
        no_arguments: darray[RuntimeValue] = []

        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: mutable Execution = try interpret(module, "array_safe", index, reference_observations, reference_storage) else failed_execution()
        compiled: mutable Execution = try execute_bytecode(lowered.module, "array_safe", index, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 20
        assert compiled.value.integer == reference.value.integer
        assert reference_observations.count == 0
        assert bytecode_observations.count == reference_observations.count

        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "array_safe", negative_index, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "array_safe", negative_index, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 20
        assert compiled.value.integer == reference.value.integer
        assert reference_observations.count == 0
        assert bytecode_observations.count == 0

        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "array_safe", missing_index, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "array_safe", missing_index, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 99
        assert compiled.value.integer == reference.value.integer
        assert reference_observations.count == 1
        assert bytecode_observations.count == reference_observations.count
        assert bytecode_observations[0].value.integer == reference_observations[0].value.integer

        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "text_safe", index, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "text_safe", index, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.text == "a"
        assert compiled.value.text == reference.value.text

        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "text_safe", negative_index, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "text_safe", negative_index, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.text == "t"
        assert compiled.value.text == reference.value.text

        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "array_update", no_arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "array_update", no_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 40
        assert compiled.value.integer == reference.value.integer

        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "map_safe", key, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "map_safe", key, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 1
        assert compiled.value.integer == reference.value.integer

        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "map_safe", missing_key, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "map_safe", missing_key, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 99
        assert compiled.value.integer == reference.value.integer


@test
def bytecode_error_recovery_preserves_verified_cfg_and_reference_behavior() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def fallback() -> i64:\n    observe(66)\n    return 8i64\n\ndef parse_or(value: sview) -> i64:\n    return try parse_int(value) else fallback()\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_opcode_class(Opcode.ErrorGuardPush) == BytecodeDispatchClass.ErrorGuard
        assert bytecode_opcode_class(Opcode.ErrorGuardPop) == BytecodeDispatchClass.ErrorGuard
        assert bytecode_direct_supported(lowered.module)

        input: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "bad"}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "parse_or", input, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "parse_or", input, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 8
        assert compiled.value.integer == reference.value.integer
        assert bytecode_observations.count == reference_observations.count
        assert bytecode_observations[0].value.integer == reference_observations[0].value.integer


@test
def bytecode_terminating_error_recovery_matches_reference_behavior() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def parse_or(value: sview) -> i64:\n    number: i64 = try parse_int(value) else return 0i64\n    return number + 1i64\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        input: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "bad"}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "parse_or", input, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "parse_or", input, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 0
        assert compiled.value.integer == reference.value.integer
