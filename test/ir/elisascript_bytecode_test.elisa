@test
def bytecode_python_range_array_comprehensions_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def ascending(limit: i64) -> darray[i64]:\n    return [value * 2i64 for value in range(limit)]\n\ndef descending() -> darray[i64]:\n    return [value for value in range(5i64, 0i64, -2i64)]\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)

        limit: darray[RuntimeValue] = [runtime_int(4)]
        no_arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: mutable Execution = try interpret(module, "ascending", limit, reference_observations, reference_storage) else failed_execution()
        compiled: mutable Execution = try execute_bytecode(lowered.module, "ascending", limit, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.array_count == 4
        assert compiled.value.array_count == reference.value.array_count
        assert reference_storage[reference.value.array_start.usize()].integer == 0
        assert bytecode_storage[compiled.value.array_start.usize()].integer == 0
        assert reference_storage[reference.value.array_start.usize() + 3].integer == 6
        assert bytecode_storage[compiled.value.array_start.usize() + 3].integer == 6

        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "descending", no_arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "descending", no_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.array_count == 3
        assert compiled.value.array_count == reference.value.array_count
        assert reference_storage[reference.value.array_start.usize()].integer == 5
        assert bytecode_storage[compiled.value.array_start.usize()].integer == 5
        assert reference_storage[reference.value.array_start.usize() + 2].integer == 1
        assert bytecode_storage[compiled.value.array_start.usize() + 2].integer == 1


