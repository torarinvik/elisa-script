@test
def bytecode_python_dictionary_setdefault_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def present() -> i64:\n    mapping: mutable dict[sview, i64] = {\"key\": 7i64}\n    selected: i64 = mapping.setdefault(\"key\", 42i64)\n    observe(mapping)\n    return selected\n\ndef missing() -> i64:\n    mapping: mutable dict[sview, i64] = {\"first\": 1i64}\n    selected: i64 = mapping.setdefault(\"new\", 42i64)\n    observe(mapping)\n    return selected\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: mutable Execution = try interpret(module, "present", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: mutable Execution = try execute_bytecode(lowered.module, "present", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 7
        assert compiled.value.integer == 7
        assert bytecode_observations.count == 1
        assert bytecode_observations[0].value.map_count == 1u32
        reference_observations <- []
        bytecode_observations <- []
        reference_storage <- []
        bytecode_storage <- []
        reference <- try interpret(module, "missing", arguments, reference_observations, reference_storage) else failed_execution()
        compiled <- try execute_bytecode(lowered.module, "missing", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert compiled.value.integer == reference.value.integer
        assert compiled.value.integer == 42
        assert bytecode_observations.count == 1
        assert bytecode_observations[0].value.map_count == 2u32
        assert bytecode_storage[bytecode_observations[0].value.map_start.usize() + 2].text == "new"
        assert bytecode_storage[bytecode_observations[0].value.map_start.usize() + 3].integer == 42


