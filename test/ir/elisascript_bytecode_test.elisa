@test
def bytecode_direct_integer_failure_checks_match_reference_errors() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def divide_zero() -> i64:\n    return 1 / 0\n\ndef remainder_zero() -> i64:\n    return 1 % 0\n\ndef invalid_shift() -> i64:\n    return 1 << 64\n\ndef invalid_u8_shift() -> u8:\n    return 1u8 << 8u8\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        empty_arguments: darray[RuntimeValue] = []
        divide_observations: mutable darray[Observation] = []
        divide_storage: mutable darray[RuntimeValue] = []
        divide: Execution = try execute_bytecode(lowered.module, "divide_zero", empty_arguments, divide_observations, divide_storage) else failed_execution()
        remainder_observations: mutable darray[Observation] = []
        remainder_storage: mutable darray[RuntimeValue] = []
        remainder: Execution = try execute_bytecode(lowered.module, "remainder_zero", empty_arguments, remainder_observations, remainder_storage) else failed_execution()
        shift_observations: mutable darray[Observation] = []
        shift_storage: mutable darray[RuntimeValue] = []
        shifted: Execution = try execute_bytecode(lowered.module, "invalid_shift", empty_arguments, shift_observations, shift_storage) else failed_execution()
        assert divide.value.kind == RuntimeValueKind.Void
        assert remainder.value.kind == RuntimeValueKind.Void
        assert shifted.value.kind == RuntimeValueKind.Void
        u8_shift_observations: mutable darray[Observation] = []
        u8_shift_storage: mutable darray[RuntimeValue] = []
        invalid_u8_shift: mutable bool = false
        catch execute_bytecode_direct_only(lowered.module, "invalid_u8_shift", empty_arguments, u8_shift_observations, u8_shift_storage):
            ok execution:
                assert false
            error failure:
                assert failure == InterpretError.InvalidShift
                invalid_u8_shift <- true
        assert invalid_u8_shift


@test
def bytecode_direct_integer_conversion_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def parse(value: sview) -> i64:\n    return parse_int(value)\n\ndef format(value: i64) -> sview:\n    return format_int(value)\n\ndef parse_decimal(value: sview) -> f64:\n    return parse_float(value)\n\ndef format_decimal(value: f64) -> sview:\n    return format_float(value)\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        text_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "-123"}]
        separated_text_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "12_345"}]
        integer_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 456}]
        decimal_text_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "1.25e2"}]
        decimal_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Float, decimal: -3.5}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        parsed: Execution = try interpret(module, "parse", text_arguments, reference_observations, reference_storage) else failed_execution()
        compiled_parse: Execution = try execute_bytecode(lowered.module, "parse", text_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        parsed_separated: Execution = try interpret(module, "parse", separated_text_arguments, reference_observations, reference_storage) else failed_execution()
        compiled_parse_separated: Execution = try execute_bytecode(lowered.module, "parse", separated_text_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        formatted: Execution = try interpret(module, "format", integer_arguments, reference_observations, reference_storage) else failed_execution()
        compiled_format: Execution = try execute_bytecode(lowered.module, "format", integer_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        parsed_decimal: Execution = try interpret(module, "parse_decimal", decimal_text_arguments, reference_observations, reference_storage) else failed_execution()
        compiled_parse_decimal: Execution = try execute_bytecode(lowered.module, "parse_decimal", decimal_text_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        formatted_decimal: Execution = try interpret(module, "format_decimal", decimal_arguments, reference_observations, reference_storage) else failed_execution()
        compiled_format_decimal: Execution = try execute_bytecode(lowered.module, "format_decimal", decimal_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert parsed.value.integer == -123
        assert compiled_parse.value.integer == parsed.value.integer
        assert parsed_separated.value.integer == 12345
        assert compiled_parse_separated.value.integer == parsed_separated.value.integer
        assert formatted.value.text == "456"
        assert compiled_format.value.text == formatted.value.text
        assert parsed_decimal.value.decimal == 125.0
        assert compiled_parse_decimal.value.decimal == parsed_decimal.value.decimal
        assert formatted_decimal.value.text == "-3.5"
        assert compiled_format_decimal.value.text == formatted_decimal.value.text
        assert compiled_parse.steps == parsed.steps
        assert compiled_format.steps == formatted.steps


