@test
def bytecode_direct_path_shape_operations_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def combine(base: Path, leaf: sview) -> Path:\n    return path_join(base, leaf)\n\ndef parent(path_value: Path) -> Path:\n    return path_parent(path_value)\n\ndef name(path_value: Path) -> sview:\n    return path_name(path_value)\n\ndef extension(path_value: Path) -> sview:\n    return path_extension(path_value)\n\ndef stem(path_value: Path) -> sview:\n    return path_stem(path_value)\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        combine_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "src/elisa"}, RuntimeValue{kind: RuntimeValueKind.Text, text: "main.elisa"}]
        path_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "src/elisa/main.elisa"}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference_combine: Execution = try interpret(module, "combine", combine_arguments, reference_observations, reference_storage) else failed_execution()
        bytecode_combine: Execution = try execute_bytecode(lowered.module, "combine", combine_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        reference_parent: Execution = try interpret(module, "parent", path_arguments, reference_observations, reference_storage) else failed_execution()
        bytecode_parent: Execution = try execute_bytecode(lowered.module, "parent", path_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        reference_name: Execution = try interpret(module, "name", path_arguments, reference_observations, reference_storage) else failed_execution()
        bytecode_name: Execution = try execute_bytecode(lowered.module, "name", path_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        reference_extension: Execution = try interpret(module, "extension", path_arguments, reference_observations, reference_storage) else failed_execution()
        bytecode_extension: Execution = try execute_bytecode(lowered.module, "extension", path_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        reference_stem: Execution = try interpret(module, "stem", path_arguments, reference_observations, reference_storage) else failed_execution()
        bytecode_stem: Execution = try execute_bytecode(lowered.module, "stem", path_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference_combine.value.text == "src/elisa/main.elisa"
        assert bytecode_combine.value.text == reference_combine.value.text
        assert bytecode_parent.value.text == reference_parent.value.text
        assert bytecode_name.value.text == reference_name.value.text
        assert bytecode_extension.value.text == reference_extension.value.text
        assert bytecode_stem.value.text == reference_stem.value.text
        assert reference_extension.value.text == ".elisa"
        assert reference_stem.value.text == "main"


