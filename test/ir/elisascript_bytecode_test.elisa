@test
def bytecode_direct_dynamic_typed_constructors_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(path_text: sview, glob_text: sview, pattern_text: sview, url_text: sview) -> bool:\n    path_value: Path = path(path_text)\n    glob_value: Glob = glob(glob_text)\n    pattern: Regex = regex(pattern_text)\n    endpoint: Url = url(url_text)\n    return path_value == path\"/dev/null\" and glob_value == glob\"src/*.elisa\" and matches(\"item:42\", pattern) and endpoint == url\"https://example.com\"\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "/dev/null"}, RuntimeValue{kind: RuntimeValueKind.Text, text: "src/*.elisa"}, RuntimeValue{kind: RuntimeValueKind.Text, text: "^item:[0-9]+$"}, RuntimeValue{kind: RuntimeValueKind.Text, text: "https://example.com"}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps


@test
def bytecode_direct_float_path_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main(value: f64) -> f64:\n    first: f64 = -(value * 2.0) + 1.5\n    second: f64 = first / 2.0\n    return second\n\ndef arrays() -> bool:\n    left: darray[f64] = [1.5, 2.0]\n    right: darray[f64] = [1.5, 2.0]\n    return left == right\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Float, decimal: 3.0}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Float
        assert compiled.value.kind == RuntimeValueKind.Float
        assert compiled.value.decimal == reference.value.decimal
        assert compiled.value.decimal == -2.25
        assert compiled.steps == reference.steps
        array_reference_observations: mutable darray[Observation] = []
        array_bytecode_observations: mutable darray[Observation] = []
        array_reference_storage: mutable darray[RuntimeValue] = []
        array_bytecode_storage: mutable darray[RuntimeValue] = []
        empty_arguments: darray[RuntimeValue] = []
        array_reference: Execution = try interpret(module, "arrays", empty_arguments, array_reference_observations, array_reference_storage) else failed_execution()
        array_compiled: Execution = try execute_bytecode(lowered.module, "arrays", empty_arguments, array_bytecode_observations, array_bytecode_storage) else failed_execution()
        assert array_reference.value.boolean
        assert array_compiled.value.boolean == array_reference.value.boolean


@test
def bytecode_nested_arrays_use_packed_recursive_storage() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> i64:\n    values: darray[darray[i64]] = [[1, 2], [3, 4]]\n    return values[1][0]\n\ndef equal() -> bool:\n    return [[1, 2], [3, 4]] == [[1, 2], [3, 4]]\n\ndef contains() -> bool:\n    return [1, 2] in [[1, 2], [3, 4]]\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        empty_arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", empty_arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", empty_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.integer == 3
        assert compiled.value.integer == reference.value.integer
        equality_reference: Execution = try interpret(module, "equal", empty_arguments, reference_observations, reference_storage) else failed_execution()
        equality_compiled: Execution = try execute_bytecode(lowered.module, "equal", empty_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert equality_reference.value.boolean
        assert equality_compiled.value.boolean == equality_reference.value.boolean
        contains_reference: Execution = try interpret(module, "contains", empty_arguments, reference_observations, reference_storage) else failed_execution()
        contains_compiled: Execution = try execute_bytecode(lowered.module, "contains", empty_arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert contains_reference.value.boolean
        assert contains_compiled.value.boolean == contains_reference.value.boolean


@test
def bytecode_direct_call_path_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def increment(value: i64) -> i64:\n    answer: i64 = value + 1\n    observe(answer)\n    return answer\n\ndef main(value: i64) -> i64:\n    answer: i64 = increment(value)\n    observe(answer)\n    return answer\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 41}]
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Int
        assert compiled.value.kind == RuntimeValueKind.Int
        assert compiled.value.integer == reference.value.integer
        assert compiled.value.integer == 42
        assert compiled.steps == reference.steps
        assert bytecode_observations.count == reference_observations.count
        assert bytecode_observations[0].value.integer == reference_observations[0].value.integer
        assert bytecode_observations[1].value.integer == reference_observations[1].value.integer


@test
def bytecode_direct_filesystem_path_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO:
        temporary_path: static u8& = "/tmp/elisascript-bytecode-filesystem-test.txt"
        _ = remove_file(temporary_path)
        source: static u8& = "def main() -> bool:\n    existed: bool = path_exists(path\"/dev/null\")\n    written: usize = write_text(path\"/tmp/elisascript-bytecode-filesystem-test.txt\", \"bytecode-fs\")\n    contents: sview = read_text(path\"/tmp/elisascript-bytecode-filesystem-test.txt\")\n    removed: bool = remove_path(path\"/tmp/elisascript-bytecode-filesystem-test.txt\")\n    observe(existed)\n    observe(written)\n    observe(contents)\n    observe(removed)\n    return existed and written == 11u64 and contents == \"bytecode-fs\" and removed and not path_exists(path\"/tmp/elisascript-bytecode-filesystem-test.txt\")\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        _ = remove_file(temporary_path)
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps
        assert bytecode_observations.count == reference_observations.count
        assert bytecode_observations[0].value.boolean == reference_observations[0].value.boolean
        assert bytecode_observations[1].value.integer == reference_observations[1].value.integer
        assert bytecode_observations[2].value.text == reference_observations[2].value.text
        assert bytecode_observations[3].value.boolean == reference_observations[3].value.boolean


@test
def bytecode_direct_copy_and_move_paths_match_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO:
        source_path: static u8& = "/tmp/elisascript-bytecode-copy-source.txt"
        copied_path: static u8& = "/tmp/elisascript-bytecode-copy-destination.txt"
        moved_path: static u8& = "/tmp/elisascript-bytecode-copy-moved.txt"
        _ = remove_file(source_path)
        _ = remove_file(copied_path)
        _ = remove_file(moved_path)
        source: static u8& = "def main() -> bool:\n    source: Path = path\"/tmp/elisascript-bytecode-copy-source.txt\"\n    copied_path: Path = path\"/tmp/elisascript-bytecode-copy-destination.txt\"\n    moved_path: Path = path\"/tmp/elisascript-bytecode-copy-moved.txt\"\n    written: usize = write_text(source, \"bytecode-copy\")\n    copied: bool = copy_path(source, copied_path)\n    moved: bool = move_path(copied_path, moved_path)\n    contents: sview = read_text(moved_path)\n    removed_source: bool = remove_path(source)\n    removed_moved: bool = remove_path(moved_path)\n    observe(written)\n    observe(copied)\n    observe(moved)\n    observe(contents)\n    return written == 13u64 and copied and moved and contents == \"bytecode-copy\" and removed_source and removed_moved\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        _ = remove_file(source_path)
        _ = remove_file(copied_path)
        _ = remove_file(moved_path)
        assert reference.value.boolean
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps
        assert bytecode_observations.count == reference_observations.count
        assert bytecode_observations[0].value.integer == reference_observations[0].value.integer
        assert bytecode_observations[1].value.boolean == reference_observations[1].value.boolean
        assert bytecode_observations[2].value.boolean == reference_observations[2].value.boolean
        assert bytecode_observations[3].value.text == reference_observations[3].value.text


@test
def bytecode_direct_environment_path_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> bool:\n    cleared: bool = unset_environment(\"ELISASCRIPT_BYTECODE_ENV\")\n    updated: bool = set_environment(\"ELISASCRIPT_BYTECODE_ENV\", \"packed\")\n    current: sview = get_environment(\"ELISASCRIPT_BYTECODE_ENV\")\n    removed: bool = unset_environment(\"ELISASCRIPT_BYTECODE_ENV\")\n    observe(cleared)\n    observe(updated)\n    observe(current)\n    observe(removed)\n    return cleared and updated and current == \"packed\" and removed\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps
        assert bytecode_observations.count == reference_observations.count
        for index in 0..<reference_observations.count |reference_observations, bytecode_observations|:
            assert bytecode_observations[index].value.kind == reference_observations[index].value.kind
            if reference_observations[index].value.kind == RuntimeValueKind.Bool:
                assert bytecode_observations[index].value.boolean == reference_observations[index].value.boolean
            if reference_observations[index].value.kind == RuntimeValueKind.Text:
                assert bytecode_observations[index].value.text == reference_observations[index].value.text


@test
def bytecode_direct_directory_path_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO:
        directory_path: static u8& = "/tmp/elisascript-bytecode-directory-test"
        file_path: static u8& = "/tmp/elisascript-bytecode-directory-test/entry.txt"
        _ = remove_file(file_path)
        source: static u8& = "def main() -> bool:\n    original: Path = current_directory()\n    created: bool = create_directory(path\"/tmp/elisascript-bytecode-directory-test\")\n    written: usize = write_text(path\"/tmp/elisascript-bytecode-directory-test/entry.txt\", \"x\")\n    entries: darray[sview] = list_directory(path\"/tmp/elisascript-bytecode-directory-test\")\n    expanded: darray[sview] = expand_glob(glob\"/tmp/elisascript-bytecode-directory-test/*.txt\")\n    folder: bool = is_directory(path\"/tmp/elisascript-bytecode-directory-test\")\n    changed: bool = change_directory(path\"/tmp/elisascript-bytecode-directory-test\")\n    inside: Path = current_directory()\n    restored: bool = change_directory(original)\n    removed_file: bool = remove_path(path\"/tmp/elisascript-bytecode-directory-test/entry.txt\")\n    removed_directory: bool = remove_directory(path\"/tmp/elisascript-bytecode-directory-test\")\n    observe(entries)\n    observe(expanded)\n    return created and written == 1u64 and entries == [\"entry.txt\"] and expanded == [\"/tmp/elisascript-bytecode-directory-test/entry.txt\"] and folder and changed and inside != original and restored and removed_file and removed_directory\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        _ = remove_file(file_path)
        assert reference.value.kind == RuntimeValueKind.Bool
        assert compiled.value.kind == RuntimeValueKind.Bool
        assert compiled.value.boolean == reference.value.boolean
        assert compiled.value.boolean
        assert compiled.steps == reference.steps
        assert bytecode_observations.count == reference_observations.count
        for index in 0..<reference_observations.count |reference_observations, bytecode_observations, reference_storage, bytecode_storage|:
            assert bytecode_observations[index].value.kind == RuntimeValueKind.Array
            assert bytecode_observations[index].value.array_count == reference_observations[index].value.array_count
            for offset in 0..<reference_observations[index].value.array_count.usize() |reference_observations, bytecode_observations, reference_storage, bytecode_storage, index|:
                reference_value: RuntimeValue = reference_storage[reference_observations[index].value.array_start.usize() + offset]
                bytecode_value: RuntimeValue = bytecode_storage[bytecode_observations[index].value.array_start.usize() + offset]
                assert bytecode_value.text == reference_value.text


@test
def bytecode_direct_stdio_path_matches_reference_interpreter() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def main() -> usize:\n    stdout_count: usize = write_stdout(\"\")\n    stderr_count: usize = write_stderr(\"\")\n    return stdout_count + stderr_count\n"
        module: Module = lower_program(source)
        lowered: BytecodeLowerResult = lower_bytecode(module)
        assert lowered.issues.count == 0
        assert bytecode_direct_supported(lowered.module)
        arguments: darray[RuntimeValue] = []
        reference_observations: mutable darray[Observation] = []
        bytecode_observations: mutable darray[Observation] = []
        reference_storage: mutable darray[RuntimeValue] = []
        bytecode_storage: mutable darray[RuntimeValue] = []
        reference: Execution = try interpret(module, "main", arguments, reference_observations, reference_storage) else failed_execution()
        compiled: Execution = try execute_bytecode(lowered.module, "main", arguments, bytecode_observations, bytecode_storage) else failed_execution()
        assert reference.value.kind == RuntimeValueKind.Int
        assert compiled.value.kind == RuntimeValueKind.Int
        assert compiled.value.integer == reference.value.integer
        assert compiled.value.integer == 0
        assert compiled.steps == reference.steps
