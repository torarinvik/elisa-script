        invalid: Function = Function{name: "bad_map_copy", parameters: [mapping], return_type: void_type(), effects: [], errors: [], operand_pool: [1], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [malformed], blocks: [block], entry: 1}
