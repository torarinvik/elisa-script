@test
def verifier_checks_dynamic_handler_effect_and_error_contracts() -> void:
    can Memory.Allocate, Abort.Panic:
        sandbox: Handler = Handler{name: "sandbox", handles: ["File"], introduces_effects: ["Trace"], errors: ["SandboxError"], continuation: ContinuationPolicy.Linear}
        push: Instruction = Instruction{opcode: Opcode.HandlerPush, result: 0, result_type: void_type(), symbol: "sandbox", span: span()}
        perform: Instruction = Instruction{opcode: Opcode.Perform, result: 0, result_type: void_type(), effect_family: "File", effect_operation: "Read", trace: TraceSite{id: 2001, label: "read"}, span: span()}
        pop: Instruction = Instruction{opcode: Opcode.HandlerPop, result: 0, result_type: void_type(), symbol: "sandbox", span: span()}
        term: Terminator = Terminator{kind: TerminatorKind.Return, span: span()}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 3, terminator: term}
        fn: Function = Function{name: "missing_handler_contract", parameters: [], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [push, perform, pop], blocks: [block], entry: 1}
        module: Module = Module{name: "handlers", functions: [fn], handlers: [sandbox]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.HandlerContract) == 2
        assert issue_count(issues, IssueKind.MissingEffect) == 0


@test
def verifier_does_not_treat_handler_family_as_operation_wildcard() -> void:
    can Memory.Allocate, Abort.Panic:
        position: SourceSpan = SourceSpan{file: "handler-operation-coverage", line: 1, column: 1, end_line: 1, end_column: 1}
        callback_return: Terminator = Terminator{kind: TerminatorKind.Return, span: position}
        callback_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: callback_return}
        callback: Function = Function{name: "read_callback", parameters: [], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [callback_block], entry: 1}
        push: Instruction = Instruction{opcode: Opcode.HandlerPush, result: 0, result_type: void_type(), symbol: "echo", span: position}
        perform: Instruction = Instruction{opcode: Opcode.Perform, result: 0, result_type: void_type(), effect_family: "Echo", effect_operation: "Write", trace: TraceSite{id: 2201, label: "operation-coverage"}, span: position}
        pop: Instruction = Instruction{opcode: Opcode.HandlerPop, result: 0, result_type: void_type(), symbol: "echo", span: position}
        run_return: Terminator = Terminator{kind: TerminatorKind.Return, span: position}
        run_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 3, terminator: run_return}
        run: Function = Function{name: "run", parameters: [], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [push, perform, pop], blocks: [run_block], entry: 1}
        clause: HandlerClause = HandlerClause{effect_family: "Echo", effect_operation: "Read", function: "read_callback"}
        handler: Handler = Handler{name: "echo", handles: ["Echo"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear, clauses: [clause]}
        module: Module = Module{name: "handler-operation-coverage", functions: [callback, run], handlers: [handler]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.HandlerContract) == 0
        assert issue_count(issues, IssueKind.MissingEffect) == 1


@test
def verifier_propagates_handler_callback_effects_and_errors() -> void:
    can Memory.Allocate, Abort.Panic:
        integer: Type = Type{kind: TypeKind.Int, bits: 64, signed: true}
        position: SourceSpan = SourceSpan{file: "handler-callback-contract", line: 1, column: 1, end_line: 1, end_column: 1}
        callback_return: Terminator = Terminator{kind: TerminatorKind.Return, operand: 1, operand_count: 1, span: position}
        callback_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: callback_return}
        callback: Function = Function{name: "callback", parameters: [Parameter{value: 1, type: integer, name: "payload"}], return_type: integer, effects: ["Console.Write"], errors: ["CallbackError"], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [callback_block], entry: 1}
        perform: Instruction = Instruction{opcode: Opcode.Perform, result: 2, result_type: integer, operand_start: 0, operand_count: 1, effect_family: "Echo", effect_operation: "Value", trace: TraceSite{id: 2101, label: "callback-contract"}, span: position}
        run_return: Terminator = Terminator{kind: TerminatorKind.Return, operand: 2, operand_count: 1, span: position}
        run_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: run_return}
        run: Function = Function{name: "run", parameters: [Parameter{value: 1, type: integer, name: "input"}], return_type: integer, effects: [], errors: [], operand_pool: [1], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [perform], blocks: [run_block], entry: 1}
        clause: HandlerClause = HandlerClause{effect_family: "Echo", effect_operation: "Value", function: "callback"}
        handler: Handler = Handler{name: "echo", handles: ["Echo"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear, clauses: [clause]}
        module: Module = Module{name: "handler-callback-contract", functions: [callback, run], handlers: [handler]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.MissingEffect) == 1
        assert issue_count(issues, IssueKind.MissingError) == 1


