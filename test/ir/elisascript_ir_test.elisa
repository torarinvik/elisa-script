        position: SourceSpan = SourceSpan{file: "handler-callback-contract", line: 1, column: 1, end_line: 1, end_column: 1}
        callback_return: Terminator = Terminator{kind: TerminatorKind.Return, operand: 1, operand_count: 1, span: position}
        callback_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: callback_return}
        callback: Function = Function{name: "callback", parameters: [Parameter{value: 1, type: integer, name: "payload"}], return_type: integer, effects: ["Console.Write"], errors: ["CallbackError"], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [callback_block], entry: 1}
        perform: Instruction = Instruction{opcode: Opcode.Perform, result: 2, result_type: integer, operand_start: 0, operand_count: 1, effect_family: "Echo", effect_operation: "Value", trace: TraceSite{id: 2101, label: "callback-contract"}, span: position}
        run_return: Terminator = Terminator{kind: TerminatorKind.Return, operand: 2, operand_count: 1, span: position}
        run_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: run_return}
        run: Function = Function{name: "run", parameters: [Parameter{value: 1, type: integer, name: "input"}], return_type: integer, effects: [], errors: [], operand_pool: [1], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [perform], blocks: [run_block], entry: 1}
        clause: HandlerClause = HandlerClause{effect_family: "Echo", effect_operation: "Value", function: "callback"}
        handler: Handler = Handler{name: "echo", handles: ["Echo"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear, clauses: [clause]}
        module: Module = Module{name: "handler-callback-contract", functions: [callback, run], handlers: [handler]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.MissingEffect) == 1
        assert issue_count(issues, IssueKind.MissingError) == 1


@test
def multi_clone_rejects_noncloneable_capture() -> void:
    can Memory.Allocate, Abort.Panic:
        borrowed: ContinuationCapture = ContinuationCapture{name: "socket", type: Type{kind: TypeKind.Named, name: "Socket"}, class: CaptureClass.Affine}
        search: Handler = Handler{name: "search", handles: ["Choice"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.MultiClone, captures: [borrowed]}
        module: Module = Module{name: "handlers", functions: [], handlers: [search]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.UnsafeMultiShot) == 1


@test
def multi_replay_rejects_nonreplayable_capture() -> void:
    can Memory.Allocate, Abort.Panic:
        borrowed: ContinuationCapture = ContinuationCapture{name: "socket", type: Type{kind: TypeKind.Named, name: "Socket"}, class: CaptureClass.Borrowed}
        replay: Handler = Handler{name: "replay", handles: ["Choice"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.MultiReplay, captures: [borrowed]}
        module: Module = Module{name: "handlers", functions: [], handlers: [replay]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.UnsafeMultiShot) == 1


@test
def multi_shot_rejects_mutable_aggregate_capture() -> void:
    can Memory.Allocate, Abort.Panic:
        array_capture: ContinuationCapture = ContinuationCapture{name: "values", type: int_array_type(), class: CaptureClass.Unrestricted}
        map_capture: ContinuationCapture = ContinuationCapture{name: "counts", type: text_int_map_type(), class: CaptureClass.Unrestricted}
        set_capture: ContinuationCapture = ContinuationCapture{name: "seen", type: int_set_type(), class: CaptureClass.Unrestricted}
        clone: Handler = Handler{name: "clone", handles: ["Choice"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.MultiClone, captures: [array_capture]}
        replay: Handler = Handler{name: "replay", handles: ["Choice"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.MultiReplay, captures: [map_capture]}
        clone_set: Handler = Handler{name: "clone_set", handles: ["Choice"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.MultiClone, captures: [set_capture]}
        module: Module = Module{name: "handlers", functions: [], handlers: [clone, replay, clone_set]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.UnsafeMultiShot) == 3


@test
def multi_shot_rejects_nested_aggregate_in_malformed_type_descriptor() -> void:
    can Memory.Allocate, Abort.Panic:
        # A malformed nominal row carries an Array child even though its legacy
        # inline root kind is non-aggregate. The multi-shot guard must inspect
        # the interned graph and fail closed before the TypeTable issue is
        # consumed by a backend.
        wrapper: Type = Type{kind: TypeKind.Named, name: "Wrapper", descriptor_id: 1}
        nested_table: TypeTable = TypeTable{rows: [TypeDescriptor{kind: TypeKind.Named, name: "Wrapper", child_start: 0, child_count: 1}, TypeDescriptor{kind: TypeKind.Array, child_start: 1, child_count: 1}], children: [2, 2]}
        capture: ContinuationCapture = ContinuationCapture{name: "wrapped", type: wrapper, class: CaptureClass.Unrestricted}
        handler: Handler = Handler{name: "clone", handles: ["Choice"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.MultiClone, captures: [capture]}
        module: Module = Module{name: "handlers", functions: [], handlers: [handler], type_table: nested_table}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.UnsafeMultiShot) == 1
        assert issue_count(issues, IssueKind.InvalidTypeTable) >= 1


@test
def verifier_rejects_malformed_continuation_capture_metadata() -> void:
    can Memory.Allocate, Abort.Panic:
        malformed: Handler = Handler{name: "capture", handles: ["Choice"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.MultiClone, captures: [ContinuationCapture{name: "", type: int_type(), class: CaptureClass.Unrestricted}, ContinuationCapture{name: "duplicate", type: void_type(), class: CaptureClass.Unrestricted}, ContinuationCapture{name: "duplicate", type: int_type(), class: CaptureClass.Unrestricted}]}
        module: Module = Module{name: "handlers", functions: [], handlers: [malformed]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.HandlerContract) == 3


