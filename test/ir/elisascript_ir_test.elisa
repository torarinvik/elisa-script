@test
def verifier_accepts_and_rejects_typed_map_copy_contract() -> void:
    can Memory.Allocate, Abort.Panic:
        mapping: Parameter = Parameter{value: 1, type: text_int_map_type(), name: "mapping"}
        copy: Instruction = Instruction{opcode: Opcode.CopyMap, result: 2, result_type: text_int_map_type(), operand_start: 0, operand_count: 1, span: span()}
        term: Terminator = Terminator{kind: TerminatorKind.Return, span: span()}
