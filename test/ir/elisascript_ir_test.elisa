@test
def verifier_rejects_noncanonical_bool_char_and_scalar_child_shapes() -> void:
    can Memory.Allocate, Abort.Panic:
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: Terminator{kind: TerminatorKind.Return, span: span()}}
        invalid_bool: Type = Type{kind: TypeKind.Bool, bits: 2}
        invalid_char: Type = Type{kind: TypeKind.Char, bits: 8, signed: true}
        named_bool: Type = Type{kind: TypeKind.Bool, name: "Bool", bits: 1}
        bool_parameter: Parameter = Parameter{value: 1, type: invalid_bool, name: "bad-bool"}
        char_parameter: Parameter = Parameter{value: 2, type: invalid_char, name: "bad-char"}
        named_bool_parameter: Parameter = Parameter{value: 3, type: named_bool, name: "named-bool"}
        scalar_function: Function = Function{name: "bad-scalar-metadata", parameters: [bool_parameter, char_parameter, named_bool_parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [block], entry: 1}
        scalar_module: Module = Module{name: "bad-scalar-metadata", functions: [scalar_function]}
        assert issue_count(verify(scalar_module), IssueKind.InvalidTypeTable) >= 3

        invalid_nested_bool: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Bool, element_bits: 2}
        nested_parameter: Parameter = Parameter{value: 1, type: invalid_nested_bool, name: "bad-nested-bool"}
        nested_function: Function = Function{name: "bad-nested-bool", parameters: [nested_parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [block], entry: 1}
        assert issue_count(verify(Module{name: "bad-nested-bool", functions: [nested_function]}), IssueKind.InvalidTypeTable) > 0

        scalar_table: TypeTable = TypeTable{rows: [TypeDescriptor{kind: TypeKind.Int, bits: 64, signed: true}], children: []}
        scalar_with_child: Type = Type{kind: TypeKind.Int, bits: 64, signed: true, element_kind: TypeKind.Array, descriptor_id: 1}
        child_parameter: Parameter = Parameter{value: 1, type: scalar_with_child, name: "bad-child-shape"}
        child_function: Function = Function{name: "bad-child-shape", parameters: [child_parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [block], entry: 1}
        child_module: Module = Module{name: "bad-child-shape", functions: [child_function], type_table: scalar_table}
        assert not inline_type_shape_valid(scalar_with_child)
        assert not type_table_matches_inline(scalar_with_child, 1, scalar_table)
        assert issue_count(verify(child_module), IssueKind.InvalidTypeTable) > 0
        scalar_with_ghost_metadata: Type = Type{kind: TypeKind.Int, bits: 64, signed: true, element_name: "hidden"}
        assert not inline_type_shape_valid(scalar_with_ghost_metadata)

        invalid_bool_table: TypeTable = TypeTable{rows: [TypeDescriptor{kind: TypeKind.Bool, bits: 2}], children: []}
        named_bool_table: TypeTable = TypeTable{rows: [TypeDescriptor{kind: TypeKind.Bool, name: "Bool", bits: 1}], children: []}
        invalid_char_table: TypeTable = TypeTable{rows: [TypeDescriptor{kind: TypeKind.Char, bits: 8, signed: true}], children: []}
        assert not type_table_valid(invalid_bool_table)
        assert not type_table_valid(named_bool_table)
        assert not type_table_valid(invalid_char_table)


