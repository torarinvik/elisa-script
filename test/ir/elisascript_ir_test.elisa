include "../../src/ir/ir.elisa"

using EsIr


def span() -> SourceSpan:
    return SourceSpan{file: "test.elisascript", line: 1, column: 1, end_line: 1, end_column: 2}


def int_type() -> Type:
    return Type{kind: TypeKind.Int, bits: 64, signed: true}


def void_type() -> Type:
    return Type{kind: TypeKind.Void}


def bool_type() -> Type:
    return Type{kind: TypeKind.Bool, bits: 1}


def issue_count(issues: darray[Issue]&, kind: IssueKind) -> usize:
    count: mutable usize = 0
    for found in issues |count|:
        count <- count + 1 if found.kind == kind
    return count


@test
def verified_ir_exposes_effects_and_stable_observations() -> void:
    can Memory.Allocate, Abort.Panic:
        input: Parameter = Parameter{value: 1, type: int_type(), name: "input"}
        perform: Instruction = Instruction{opcode: Opcode.Perform, result: 2, result_type: int_type(), operand_start: 0, operand_count: 1, effect_family: "Process", effect_operation: "Run", trace: TraceSite{id: 1001, label: "reference-run"}, span: span()}
        observe: Instruction = Instruction{opcode: Opcode.Observe, result: 0, result_type: void_type(), operand_start: 1, operand_count: 1, trace: TraceSite{id: 1002, label: "exit-status"}, span: span()}
        term: Terminator = Terminator{kind: TerminatorKind.Return, span: span()}
        block: Block = Block{id: 10, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 2, terminator: term}
        fn: Function = Function{name: "compare", parameters: [input], return_type: void_type(), effects: ["Process"], operand_pool: [1, 2], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [perform, observe], blocks: [block], entry: 10}
        module: Module = Module{name: "test", functions: [fn]}

        assert verify(module).count == 0


@test
def verifier_rejects_untracked_or_undeclared_effects() -> void:
    can Memory.Allocate, Abort.Panic:
        perform: Instruction = Instruction{opcode: Opcode.Perform, result: 1, result_type: int_type(), effect_family: "Clock", effect_operation: "Now", span: span()}
        term: Terminator = Terminator{kind: TerminatorKind.Return, span: span()}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: term}
        fn: Function = Function{name: "bad", parameters: [], return_type: void_type(), effects: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [perform], blocks: [block], entry: 1}
        module: Module = Module{name: "test", functions: [fn]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.MissingEffect) == 1
        assert issue_count(issues, IssueKind.MissingTraceSite) == 1


@test
def verifier_rejects_invalid_ssa_and_control_flow() -> void:
    can Memory.Allocate, Abort.Panic:
        copy: Instruction = Instruction{opcode: Opcode.Copy, result: 1, result_type: int_type(), operand_start: 0, operand_count: 1, span: span()}
        term: Terminator = Terminator{kind: TerminatorKind.Jump, target0: 42, target_count: 1, span: span()}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: term}
        fn: Function = Function{name: "bad_flow", parameters: [], return_type: void_type(), effects: [], operand_pool: [99], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [copy], blocks: [block], entry: 1}
        module: Module = Module{name: "test", functions: [fn]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.UndefinedValue) == 1
        assert issue_count(issues, IssueKind.UnknownTarget) == 1


@test
def verifier_rejects_instruction_operand_arity_before_execution() -> void:
    can Memory.Allocate, Abort.Panic:
        malformed: Instruction = Instruction{opcode: Opcode.Add, result: 1, result_type: int_type(), operand_start: 0, operand_count: 1, span: span()}
        term: Terminator = Terminator{kind: TerminatorKind.Return, operand: 1, operand_count: 1, span: span()}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: term}
        fn: Function = Function{name: "bad_arity", parameters: [], return_type: int_type(), effects: [], operand_pool: [1], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [malformed], blocks: [block], entry: 1}
        module: Module = Module{name: "test", functions: [fn]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.InvalidInstruction) == 1


@test
def verifier_rejects_ill_typed_core_operations() -> void:
    can Memory.Allocate, Abort.Panic:
        integer: Parameter = Parameter{value: 1, type: int_type(), name: "integer"}
        boolean: Parameter = Parameter{value: 2, type: bool_type(), name: "boolean"}
        bad_add: Instruction = Instruction{opcode: Opcode.Add, result: 3, result_type: int_type(), operand_start: 0, operand_count: 2, span: span()}
        bad_not: Instruction = Instruction{opcode: Opcode.Not, result: 4, result_type: bool_type(), operand_start: 2, operand_count: 1, span: span()}
        bad_copy: Instruction = Instruction{opcode: Opcode.Copy, result: 5, result_type: bool_type(), operand_start: 3, operand_count: 1, span: span()}
        bad_bitwise: Instruction = Instruction{opcode: Opcode.BitAnd, result: 6, result_type: bool_type(), operand_start: 4, operand_count: 2, span: span()}
        bad_bit_not: Instruction = Instruction{opcode: Opcode.BitNot, result: 7, result_type: bool_type(), operand_start: 6, operand_count: 1, span: span()}
        bad_concat: Instruction = Instruction{opcode: Opcode.Concat, result: 8, result_type: int_type(), operand_start: 7, operand_count: 2, span: span()}
        term: Terminator = Terminator{kind: TerminatorKind.Return, span: span()}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 6, terminator: term}
        fn: Function = Function{name: "bad_types", parameters: [integer, boolean], return_type: void_type(), effects: [], operand_pool: [1, 2, 1, 1, 2, 2, 2, 1, 2], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [bad_add, bad_not, bad_copy, bad_bitwise, bad_bit_not, bad_concat], blocks: [block], entry: 1}
        module: Module = Module{name: "test", functions: [fn]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.InvalidInstruction) == 6


@test
def verifier_checks_direct_call_signatures() -> void:
    can Memory.Allocate, Abort.Panic:
        callee_parameter: Parameter = Parameter{value: 1, type: int_type(), name: "value"}
        callee_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: Terminator{kind: TerminatorKind.Return, operand: 1, operand_count: 1, span: span()}}
        callee: Function = Function{name: "identity", parameters: [callee_parameter], return_type: int_type(), effects: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [callee_block], entry: 1}

        boolean: Parameter = Parameter{value: 1, type: bool_type(), name: "boolean"}
        mismatched: Instruction = Instruction{opcode: Opcode.Call, result: 2, result_type: bool_type(), operand_start: 0, operand_count: 1, symbol: "identity", span: span()}
        unknown: Instruction = Instruction{opcode: Opcode.Call, result: 3, result_type: bool_type(), operand_start: 1, operand_count: 0, symbol: "missing", span: span()}
        caller_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 2, terminator: Terminator{kind: TerminatorKind.Return, span: span()}}
        caller: Function = Function{name: "caller", parameters: [boolean], return_type: void_type(), effects: [], operand_pool: [1], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [mismatched, unknown], blocks: [caller_block], entry: 1}
        module: Module = Module{name: "calls", functions: [callee, caller]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.InvalidInstruction) == 3


@test
def verifier_checks_direct_call_effect_and_error_contracts() -> void:
    can Memory.Allocate, Abort.Panic:
        return_void: Terminator = Terminator{kind: TerminatorKind.Return, span: span()}
        empty_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: return_void}
        callee: Function = Function{name: "risky", parameters: [], return_type: void_type(), effects: ["Process.Run"], errors: ["RunError"], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [empty_block], entry: 1}

        call: Instruction = Instruction{opcode: Opcode.Call, result: 0, result_type: void_type(), operand_count: 0, symbol: "risky", span: span()}
        caller_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: return_void}
        missing_contract: Function = Function{name: "missing", parameters: [], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [call], blocks: [caller_block], entry: 1}
        covered_contract: Function = Function{name: "covered", parameters: [], return_type: void_type(), effects: ["Process"], errors: ["RunError"], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [call], blocks: [caller_block], entry: 1}
        module: Module = Module{name: "contracts", functions: [callee, missing_contract, covered_contract]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.MissingEffect) == 1
        assert issue_count(issues, IssueKind.MissingError) == 1


@test
def verifier_rejects_value_from_sibling_branch() -> void:
    can Memory.Allocate, Abort.Panic:
        condition: Parameter = Parameter{value: 1, type: Type{kind: TypeKind.Bool, bits: 1}, name: "condition"}
        branch: Terminator = Terminator{kind: TerminatorKind.Branch, operand: 1, operand_count: 1, target0: 2, target1: 3, target_count: 2, span: span()}
        definition: Instruction = Instruction{opcode: Opcode.Constant, result: 2, result_type: int_type(), integer: 7, span: span()}
        then_term: Terminator = Terminator{kind: TerminatorKind.Return, operand: 2, operand_count: 1, span: span()}
        else_term: Terminator = Terminator{kind: TerminatorKind.Return, operand: 2, operand_count: 1, span: span()}
        entry: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: branch}
        then_block: Block = Block{id: 2, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: then_term}
        else_block: Block = Block{id: 3, parameter_start: 0, parameter_count: 0, instruction_start: 1, instruction_count: 0, terminator: else_term}
        fn: Function = Function{name: "bad_dominance", parameters: [condition], return_type: int_type(), effects: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [definition], blocks: [entry, then_block, else_block], entry: 1}
        module: Module = Module{name: "test", functions: [fn]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.NonDominatingValue) == 1


@test
def verifier_checks_typed_block_arguments() -> void:
    can Memory.Allocate, Abort.Panic:
        source: Parameter = Parameter{value: 1, type: int_type(), name: "source"}
        merged: Parameter = Parameter{value: 2, type: Type{kind: TypeKind.Bool, bits: 1}, name: "merged"}
        jump: Terminator = Terminator{kind: TerminatorKind.Jump, target0: 2, target_count: 1, edge0_arg_start: 0, edge0_arg_count: 1, span: span()}
        result: Terminator = Terminator{kind: TerminatorKind.Return, span: span()}
        entry: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: jump}
        merge: Block = Block{id: 2, parameter_start: 0, parameter_count: 1, instruction_start: 0, instruction_count: 0, terminator: result}
        fn: Function = Function{name: "bad_edge_type", parameters: [source], return_type: void_type(), effects: [], operand_pool: [], edge_arg_pool: [1], block_parameter_pool: [merged], instruction_pool: [], blocks: [entry, merge], entry: 1}
        module: Module = Module{name: "test", functions: [fn]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.EdgeArgumentType) == 1


@test
def verifier_checks_branch_and_return_value_types() -> void:
    can Memory.Allocate, Abort.Panic:
        integer_condition: Parameter = Parameter{value: 1, type: int_type(), name: "condition"}
        branch: Terminator = Terminator{kind: TerminatorKind.Branch, operand: 1, operand_count: 1, target0: 2, target1: 3, target_count: 2, span: span()}
        entry: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: branch}
        true_exit: Block = Block{id: 2, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: Terminator{kind: TerminatorKind.Return, span: span()}}
        false_exit: Block = Block{id: 3, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: Terminator{kind: TerminatorKind.Return, span: span()}}
        bad_branch: Function = Function{name: "bad_branch", parameters: [integer_condition], return_type: void_type(), effects: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [entry, true_exit, false_exit], entry: 1}

        boolean_value: Parameter = Parameter{value: 1, type: Type{kind: TypeKind.Bool, bits: 1}, name: "value"}
        bad_return_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: Terminator{kind: TerminatorKind.Return, operand: 1, operand_count: 1, span: span()}}
        bad_return: Function = Function{name: "bad_return", parameters: [boolean_value], return_type: int_type(), effects: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [bad_return_block], entry: 1}
        module: Module = Module{name: "terminators", functions: [bad_branch, bad_return]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.InvalidTerminator) == 2


@test
def terminal_handler_cannot_resume() -> void:
    can Memory.Allocate, Abort.Panic:
        terminal: Handler = Handler{name: "terminal", handles: ["Process"], introduces_effects: [], errors: ["HandlerError"], continuation: ContinuationPolicy.Terminal}
        resume: Instruction = Instruction{opcode: Opcode.Resume, result: 1, result_type: int_type(), symbol: "terminal", span: span()}
        term: Terminator = Terminator{kind: TerminatorKind.Return, span: span()}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: term}
        fn: Function = Function{name: "invalid_resume", parameters: [], return_type: void_type(), effects: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [resume], blocks: [block], entry: 1, errors: ["HandlerError"]}
        module: Module = Module{name: "handlers", functions: [fn], handlers: [terminal]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.InvalidResume) == 1


@test
def verifier_checks_dynamic_handler_effect_and_error_contracts() -> void:
    can Memory.Allocate, Abort.Panic:
        sandbox: Handler = Handler{name: "sandbox", handles: ["File"], introduces_effects: ["Trace"], errors: ["SandboxError"], continuation: ContinuationPolicy.Linear}
        push: Instruction = Instruction{opcode: Opcode.HandlerPush, result: 0, result_type: void_type(), symbol: "sandbox", span: span()}
        perform: Instruction = Instruction{opcode: Opcode.Perform, result: 0, result_type: void_type(), effect_family: "File", effect_operation: "Read", trace: TraceSite{id: 2001, label: "read"}, span: span()}
        pop: Instruction = Instruction{opcode: Opcode.HandlerPop, result: 0, result_type: void_type(), symbol: "sandbox", span: span()}
        term: Terminator = Terminator{kind: TerminatorKind.Return, span: span()}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 3, terminator: term}
        fn: Function = Function{name: "missing_handler_contract", parameters: [], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [push, perform, pop], blocks: [block], entry: 1}
        module: Module = Module{name: "handlers", functions: [fn], handlers: [sandbox]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.HandlerContract) == 2
        assert issue_count(issues, IssueKind.MissingEffect) == 0


@test
def multi_clone_rejects_noncloneable_capture() -> void:
    can Memory.Allocate, Abort.Panic:
        borrowed: ContinuationCapture = ContinuationCapture{name: "socket", type: Type{kind: TypeKind.Named, name: "Socket"}, class: CaptureClass.Affine}
        search: Handler = Handler{name: "search", handles: ["Choice"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.MultiClone, captures: [borrowed]}
        module: Module = Module{name: "handlers", functions: [], handlers: [search]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.UnsafeMultiShot) == 1


@test
def multi_replay_requires_replay_safe_introduced_effects() -> void:
    can Memory.Allocate, Abort.Panic:
        explore: Handler = Handler{name: "explore", handles: ["Choice"], introduces_effects: ["Network"], errors: [], continuation: ContinuationPolicy.MultiReplay, replay_safe_effects: []}
        module: Module = Module{name: "handlers", functions: [], handlers: [explore]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.UnsafeMultiShot) == 1


@test
def multi_replay_accepts_recorded_effects() -> void:
    can Memory.Allocate, Abort.Panic:
        explore: Handler = Handler{name: "explore", handles: ["Choice"], introduces_effects: ["Random"], errors: [], continuation: ContinuationPolicy.MultiReplay, replay_safe_effects: ["Random"]}
        module: Module = Module{name: "handlers", functions: [], handlers: [explore]}

        assert verify(module).count == 0
