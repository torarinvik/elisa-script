    assert advance_record_lifecycle(session, RecordLifecycleEvent.RecordBegin) == RecordLifecycleState.Running
    assert advance_record_lifecycle(session, RecordLifecycleEvent.RecordEnd) == RecordLifecycleState.Running
    assert advance_record_lifecycle(session, RecordLifecycleEvent.FileEnd) == RecordLifecycleState.Running
    assert advance_record_lifecycle(session, RecordLifecycleEvent.End) == RecordLifecycleState.Completed
