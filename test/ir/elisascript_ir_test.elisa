    assert reversed_key_range_rejected

    forged_empty: mutable bool = false
    catch validate_json_document(JsonDocument{limits: limits, state: JsonDocumentState.Empty, token_count: 1}):
        ok value:
            assert false
        error failure:
            assert failure == JsonContractError.InvalidDocumentState
            forged_empty <- true
    assert forged_empty
    forged_depth: mutable bool = false
    catch validate_json_document(JsonDocument{limits: limits, state: JsonDocumentState.Building, token_count: 1, source_bytes: 4, nodes: [JsonNode{kind: JsonNodeKind.Null, range: JsonRange{start: 0, end: 4}, depth: 1}]}):
        ok value:
            assert false
        error failure:
            assert failure == JsonContractError.NodeAccountingInvalid
            forged_depth <- true
    assert forged_depth
    forged_scalar_range: mutable bool = false
    catch validate_json_document(JsonDocument{limits: limits, state: JsonDocumentState.Building, token_count: 1, source_bytes: 1, nodes: [JsonNode{kind: JsonNodeKind.Text, range: JsonRange{start: 0, end: 1}, scalar_bytes: 2}]}):
        ok value:
            assert false
        error failure:
            assert failure == JsonContractError.InvalidScalarBytes
            forged_scalar_range <- true
    assert forged_scalar_range


@test
def typed_json_document_owns_scalar_values_without_coercing_numbers() -> void:
    limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 64, tokens: 16, depth: 4, records: 8, fields: 8, field_bytes: 16}
    document: mutable JsonDocument = JsonDocument{limits: limits}
    _ = advance_json_document(document, JsonDocumentEvent.Begin)
    _ = advance_json_document(document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Text, range: JsonRange{start: 1, end: 3}, depth: 1, scalar_value: ""}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 27)
    _ = advance_json_document(document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Bool, range: JsonRange{start: 4, end: 8}, depth: 1, bool_value: true})
    _ = advance_json_document(document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Bool, range: JsonRange{start: 9, end: 14}, depth: 1, bool_value: false})
    _ = advance_json_document(document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Number, range: JsonRange{start: 15, end: 17}, depth: 1, scalar_value: "-3"})
    _ = advance_json_document(document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Text, range: JsonRange{start: 18, end: 26}, depth: 1, scalar_value: "\0"})
    _ = advance_json_document(document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Array, range: JsonRange{start: 0, end: 27}})
    _ = advance_json_document(document, JsonDocumentEvent.AppendArrayChild, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 0, JsonArrayChild{owner_index: 5, value_index: 0, ordinal: 0})
    _ = advance_json_document(document, JsonDocumentEvent.AppendArrayChild, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 0, JsonArrayChild{owner_index: 5, value_index: 1, ordinal: 1})
    _ = advance_json_document(document, JsonDocumentEvent.AppendArrayChild, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 0, JsonArrayChild{owner_index: 5, value_index: 2, ordinal: 2})
    _ = advance_json_document(document, JsonDocumentEvent.AppendArrayChild, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 0, JsonArrayChild{owner_index: 5, value_index: 3, ordinal: 3})
    _ = advance_json_document(document, JsonDocumentEvent.AppendArrayChild, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 0, JsonArrayChild{owner_index: 5, value_index: 4, ordinal: 4})
    _ = advance_json_document(document, JsonDocumentEvent.AppendRoot, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, 5)
    _ = advance_json_document(document, JsonDocumentEvent.Seal)
    assert validate_json_document(document)
    encoded_values: darray[u8] = encode_json_root(document, 0)
    assert encoded_values.count == 27
    assert encoded_values[0] == 91 and encoded_values[1] == 34 and encoded_values[2] == 34
    assert encoded_values[3] == 44 and encoded_values[4] == 116 and encoded_values[5] == 114
    assert encoded_values[6] == 117 and encoded_values[7] == 101 and encoded_values[8] == 44
    assert encoded_values[9] == 102 and encoded_values[10] == 97 and encoded_values[11] == 108
    assert encoded_values[12] == 115 and encoded_values[13] == 101 and encoded_values[14] == 44
    assert encoded_values[15] == 45 and encoded_values[16] == 51 and encoded_values[17] == 44
    assert encoded_values[18] == 34 and encoded_values[19] == 92 and encoded_values[20] == 117
    assert encoded_values[21] == 48 and encoded_values[22] == 48 and encoded_values[23] == 48 and encoded_values[24] == 48
    assert encoded_values[25] == 34 and encoded_values[26] == 93
    assert document.nodes[0].scalar_start == 0
    assert document.nodes[0].scalar_bytes == 0
    assert document.nodes[1].bool_value
    assert not document.nodes[2].bool_value
    assert document.nodes[3].scalar_bytes == 2
    assert document.scalar_data[0] == 45
    assert document.scalar_data[1] == 51
    number_copy: darray[u8] = copy_json_scalar(document, 3)
    assert number_copy.count == 2
    assert number_copy[0] == 45
    assert number_copy[1] == 51
    assert document.nodes[4].scalar_start == 2
    assert document.scalar_data[2] == 0

    invalid_number: mutable JsonDocument = JsonDocument{limits: limits}
    _ = advance_json_document(invalid_number, JsonDocumentEvent.Begin)
    number_rejected: mutable bool = false
    catch advance_json_document(invalid_number, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Number, range: JsonRange{start: 0, end: 2}, scalar_value: "01"}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 2):
        ok value:
            assert false
        error failure:
            assert failure == JsonContractError.InvalidScalarPayload
            number_rejected <- true
    assert number_rejected
    assert invalid_number.nodes.count == 0
    assert invalid_number.scalar_data.count == 0
    assert invalid_number.source_bytes == 0

    small_field_limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 64, tokens: 16, depth: 4, records: 8, fields: 8, field_bytes: 3}
    oversized_text: mutable JsonDocument = JsonDocument{limits: small_field_limits}
    _ = advance_json_document(oversized_text, JsonDocumentEvent.Begin)
    scalar_limit_rejected: mutable bool = false
    catch advance_json_document(oversized_text, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Text, range: JsonRange{start: 0, end: 6}, scalar_value: "four"}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 6):
        ok value:
            assert false
        error failure:
            assert failure == JsonContractError.InvalidScalarBytes
            scalar_limit_rejected <- true
    assert scalar_limit_rejected
    assert oversized_text.nodes.count == 0
    assert oversized_text.scalar_data.count == 0
    assert oversized_text.source_bytes == 0

    first_key: JsonMemberInput = JsonMemberInput{owner_index: 2, key: "name", key_range: JsonRange{start: 1, end: 7}, value_index: 0, ordinal: 0}
    second_key: JsonMemberInput = JsonMemberInput{owner_index: 2, key: "name", key_range: JsonRange{start: 12, end: 18}, value_index: 1, ordinal: 1}
    scalar_keep_first: mutable JsonDocument = JsonDocument{limits: limits, policy: JsonPolicy{duplicate_keys: JsonDuplicateKeyPolicy.KeepFirst}}
    _ = advance_json_document(scalar_keep_first, JsonDocumentEvent.Begin)
    _ = advance_json_document(scalar_keep_first, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Text, range: JsonRange{start: 8, end: 11}, depth: 1, scalar_value: "a"}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 23)
    _ = advance_json_document(scalar_keep_first, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Text, range: JsonRange{start: 19, end: 22}, depth: 1, scalar_value: "b"})
    _ = advance_json_document(scalar_keep_first, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Object, range: JsonRange{start: 0, end: 23}})
    _ = advance_json_document(scalar_keep_first, JsonDocumentEvent.AppendMember, JsonNodeInput{kind: JsonNodeKind.Null}, first_key)
    _ = advance_json_document(scalar_keep_first, JsonDocumentEvent.AppendMember, JsonNodeInput{kind: JsonNodeKind.Null}, second_key)
    _ = advance_json_document(scalar_keep_first, JsonDocumentEvent.AppendRoot, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, 2)
    _ = advance_json_document(scalar_keep_first, JsonDocumentEvent.Seal)
    assert validate_json_document(scalar_keep_first)
    assert scalar_keep_first.members[0].value_index == 0
    assert scalar_keep_first.nodes[0].owner_kind == JsonNodeOwnerKind.ObjectMember
    assert scalar_keep_first.nodes[1].owner_kind == JsonNodeOwnerKind.Detached
    assert scalar_keep_first.scalar_data.count == 2
    first_copy: darray[u8] = copy_json_scalar(scalar_keep_first, 0)
    assert first_copy[0] == 97

    scalar_keep_last: mutable JsonDocument = JsonDocument{limits: limits, policy: JsonPolicy{duplicate_keys: JsonDuplicateKeyPolicy.KeepLast}}
    _ = advance_json_document(scalar_keep_last, JsonDocumentEvent.Begin)
    _ = advance_json_document(scalar_keep_last, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Text, range: JsonRange{start: 8, end: 11}, depth: 1, scalar_value: "a"}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 23)
    _ = advance_json_document(scalar_keep_last, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Text, range: JsonRange{start: 19, end: 22}, depth: 1, scalar_value: "b"})
    _ = advance_json_document(scalar_keep_last, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Object, range: JsonRange{start: 0, end: 23}})
    _ = advance_json_document(scalar_keep_last, JsonDocumentEvent.AppendMember, JsonNodeInput{kind: JsonNodeKind.Null}, first_key)
    _ = advance_json_document(scalar_keep_last, JsonDocumentEvent.AppendMember, JsonNodeInput{kind: JsonNodeKind.Null}, second_key)
    _ = advance_json_document(scalar_keep_last, JsonDocumentEvent.AppendRoot, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, 2)
    _ = advance_json_document(scalar_keep_last, JsonDocumentEvent.Seal)
    assert validate_json_document(scalar_keep_last)
    assert scalar_keep_last.members[0].value_index == 1
    assert scalar_keep_last.nodes[0].owner_kind == JsonNodeOwnerKind.Detached
    assert scalar_keep_last.nodes[1].owner_kind == JsonNodeOwnerKind.ObjectMember
    assert scalar_keep_last.scalar_data.count == 2
    last_copy: darray[u8] = copy_json_scalar(scalar_keep_last, 1)
    assert last_copy[0] == 98


@test
def typed_json_lexer_preserves_byte_spans_and_decodes_strings() -> void:
    limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 128, tokens: 32, depth: 8, records: 8, fields: 8, field_bytes: 32}
    source: sview = "[{\"a\\u0022\":\"x\\n\\uD83D\\uDE00\",\"n\":1.20e+03}]"
    lexed: JsonLexedSource = lex_json(source, limits)
    assert validate_json_lexed_source(lexed)
    assert lexed.state == JsonLexState.Sealed
    assert lexed.source_bytes == 44
    assert lexed.max_depth == 2
    assert lexed.tokens.count == 11
    assert lexed.tokens[2].kind == JsonLexemeKind.String
    assert lexed.tokens[2].range.start == 2 and lexed.tokens[2].range.end == 11
    assert lexed.tokens[4].range.start == 12 and lexed.tokens[4].range.end == 29
    assert lexed.tokens[8].kind == JsonLexemeKind.Number
    assert lexed.tokens[8].range.start == 34 and lexed.tokens[8].range.end == 42

    decoded_key: darray[u8] = copy_json_lexed_string(lexed, 2)
    assert decoded_key.count == 2 and decoded_key[0] == 97 and decoded_key[1] == 34
    decoded_value: darray[u8] = copy_json_lexed_string(lexed, 4)
    assert decoded_value.count == 6
    assert decoded_value[0] == 120 and decoded_value[1] == 10
    assert decoded_value[2] == 240 and decoded_value[3] == 159 and decoded_value[4] == 152 and decoded_value[5] == 128
    number_lexeme: darray[u8] = copy_json_lexed_source_span(lexed, lexed.tokens[8].range)
    assert number_lexeme.count == 8
    assert number_lexeme[0] == 49 and number_lexeme[1] == 46 and number_lexeme[2] == 50 and number_lexeme[3] == 48
    assert number_lexeme[4] == 101 and number_lexeme[5] == 43 and number_lexeme[6] == 48 and number_lexeme[7] == 51

    comments: JsonLexedSource = lex_json("/* header */ null // tail", limits, JsonPolicy{allow_comments: true})
    assert comments.tokens.count == 1 and comments.tokens[0].kind == JsonLexemeKind.Null
    assert comments.tokens[0].range.start == 13 and comments.tokens[0].range.end == 17

    bad_escape_rejected: mutable bool = false
    catch lex_json("\"\\q\"", limits):
        ok value:
            assert false
        error failure:
            bad_escape_rejected <- true
    assert bad_escape_rejected
    bad_surrogate_rejected: mutable bool = false
    catch lex_json("\"\\uD800\"", limits):
        ok value:
            assert false
        error failure:
            bad_surrogate_rejected <- true
    assert bad_surrogate_rejected
    bad_number_rejected: mutable bool = false
    catch lex_json("[01]", limits):
        ok value:
            assert false
        error failure:
            bad_number_rejected <- true
    assert bad_number_rejected
    mismatched_delimiter_rejected: mutable bool = false
    catch lex_json("[}", limits):
        ok value:
            assert false
        error failure:
            mismatched_delimiter_rejected <- true
    assert mismatched_delimiter_rejected

    shallow_limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 128, tokens: 32, depth: 1, records: 8, fields: 8, field_bytes: 32}
    depth_rejected: mutable bool = false
    catch lex_json("[[]]", shallow_limits):
        ok value:
            assert false
        error failure:
            depth_rejected <- true
    assert depth_rejected
    tiny_token_limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 128, tokens: 1, depth: 8, records: 8, fields: 8, field_bytes: 32}
    token_limit_rejected: mutable bool = false
    catch lex_json("[]", tiny_token_limits):
        ok value:
            assert false
        error failure:
            token_limit_rejected <- true
    assert token_limit_rejected
    tiny_input_limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 3, tokens: 32, depth: 8, records: 8, fields: 8, field_bytes: 32}
    input_limit_rejected: mutable bool = false
    catch lex_json("null", tiny_input_limits):
        ok value:
            assert false
        error failure:
            input_limit_rejected <- true
    assert input_limit_rejected

    forged_tail: mutable JsonLexedSource = lex_json("null", limits)
    forged_tail.source_data.push(120u8)
    forged_tail.source_bytes <- forged_tail.source_bytes + 1
    forged_tail_rejected: mutable bool = false
    catch validate_json_lexed_source(forged_tail):
        ok value:
            assert not value
        error failure:
            forged_tail_rejected <- true
    assert forged_tail_rejected

    forged_string: mutable JsonLexedSource = lex_json("\"a\"", limits)
    forged_string.source_data[1] <- 92u8
    forged_string_rejected: mutable bool = false
    catch validate_json_lexed_source(forged_string):
        ok value:
            assert not value
        error failure:
            forged_string_rejected <- true
    assert forged_string_rejected


@test
def typed_json_parser_materializes_postorder_and_enforces_grammar() -> void:
    limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 128, tokens: 32, depth: 8, records: 8, fields: 8, field_bytes: 32}
    lexed: JsonLexedSource = lex_json("{\"x\":[-3,true]}", limits)
    document: JsonDocument = parse_json_document(lexed)
    assert document.state == JsonDocumentState.Sealed
    assert document.source_bytes == 15
    assert document.token_count == 4
    assert document.max_depth == 2
    assert document.nodes.count == 4 and document.roots.count == 1 and document.roots[0] == 3
    assert document.nodes[0].kind == JsonNodeKind.Number
    assert document.nodes[0].range.start == 6 and document.nodes[0].range.end == 8 and document.nodes[0].depth == 2
    assert document.nodes[1].kind == JsonNodeKind.Bool and document.nodes[1].bool_value
    assert document.nodes[1].range.start == 9 and document.nodes[1].range.end == 13 and document.nodes[1].depth == 2
    assert document.nodes[2].kind == JsonNodeKind.Array
    assert document.nodes[2].range.start == 5 and document.nodes[2].range.end == 14 and document.nodes[2].depth == 1
    assert document.nodes[2].child_count == 2 and document.children[0].value_index == 0 and document.children[1].value_index == 1
    assert document.nodes[3].kind == JsonNodeKind.Object
    assert document.nodes[3].range.start == 0 and document.nodes[3].range.end == 15 and document.nodes[3].depth == 0
    assert document.nodes[3].member_count == 1 and document.members[0].value_index == 2
    assert document.members[0].key_range.start == 1 and document.members[0].key_range.end == 4
    assert document.key_bytes.count == 1 and document.key_bytes[0] == 120
    assert document.scalar_data.count == 2 and document.scalar_data[0] == 45 and document.scalar_data[1] == 51
    assert validate_json_document(document)

    sorted_keys: JsonDocument = parse_json_document(lex_json("{\"z\":0,\"a\":1,\"m\":2}", limits))
    assert sorted_keys.nodes[3].member_count == 3
    assert sorted_keys.member_key_order.count == 3
    assert sorted_keys.member_key_order[0] == 1 and sorted_keys.member_key_order[1] == 2 and sorted_keys.member_key_order[2] == 0
    assert sorted_keys.members[0].member_key_order_rank == 2
    assert sorted_keys.members[1].member_key_order_rank == 0
    assert sorted_keys.members[2].member_key_order_rank == 1
    assert validate_json_document(sorted_keys)

    trailing_policy: JsonPolicy = JsonPolicy{trailing_commas: JsonTrailingCommaPolicy.Allow}
    trailing_allowed: JsonDocument = parse_json_document(lex_json("[1,]", limits, trailing_policy))
    assert trailing_allowed.nodes[1].kind == JsonNodeKind.Array and trailing_allowed.nodes[1].child_count == 1

    duplicate_policy: JsonPolicy = JsonPolicy{duplicate_keys: JsonDuplicateKeyPolicy.KeepLast}
    duplicate_last: JsonDocument = parse_json_document(lex_json("{\"x\":1,\"x\":2}", limits, duplicate_policy))
    assert duplicate_last.nodes[2].member_count == 1
    assert duplicate_last.members[0].value_index == 1
    assert duplicate_last.member_key_order.count == 1 and duplicate_last.member_key_order[0] == 0
    assert duplicate_last.scalar_data.count == 2 and duplicate_last.scalar_data[1] == 50

    first_policy: JsonPolicy = JsonPolicy{duplicate_keys: JsonDuplicateKeyPolicy.KeepFirst}
    duplicate_first: JsonDocument = parse_json_document(lex_json("{\"x\":1,\"x\":2}", limits, first_policy))
    assert duplicate_first.nodes[2].member_count == 1
    assert duplicate_first.members[0].value_index == 0
    assert duplicate_first.member_key_order.count == 1 and duplicate_first.member_key_order[0] == 0
    assert duplicate_first.nodes[0].owner_kind == JsonNodeOwnerKind.ObjectMember
    assert duplicate_first.nodes[1].owner_kind == JsonNodeOwnerKind.Detached

    duplicate_rejected: mutable bool = false
    catch parse_json_document(lex_json("{\"x\":1,\"x\":2}", limits)):
        ok value:
            assert false
        error failure:
            assert failure == JsonContractError.DuplicateObjectKey
            duplicate_rejected <- true
    assert duplicate_rejected

    comments_policy: JsonPolicy = JsonPolicy{allow_comments: true}
    comments: JsonDocument = parse_json_document(lex_json("/* before */ true // after", limits, comments_policy))
    assert comments.nodes.count == 1 and comments.roots.count == 1 and comments.nodes[0].bool_value

    trailing_comma_rejected: mutable bool = false
    catch parse_json_document(lex_json("[1,]", limits)):
        ok value:
            assert false
        error failure:
            assert failure == JsonParseError.TrailingComma(3)
            trailing_comma_rejected <- true
    assert trailing_comma_rejected
    missing_colon_rejected: mutable bool = false
    catch parse_json_document(lex_json("{\"x\" 1}", limits)):
        ok value:
            assert false
        error failure:
            assert failure == JsonParseError.ExpectedColon(5)
            missing_colon_rejected <- true
    assert missing_colon_rejected
    multiple_roots_rejected: mutable bool = false
    catch parse_json_document(lex_json("true false", limits)):
        ok value:
            assert false
        error failure:
            assert failure == JsonParseError.MultipleRoots(5)
            multiple_roots_rejected <- true
    assert multiple_roots_rejected
    non_string_key_rejected: mutable bool = false
    catch parse_json_document(lex_json("{1:2}", limits)):
        ok value:
            assert false
        error failure:
            assert failure == JsonParseError.NonStringObjectKey(1)
            non_string_key_rejected <- true
    assert non_string_key_rejected
    missing_value_rejected: mutable bool = false
    catch parse_json_document(lex_json("{\"x\":}", limits)):
        ok value:
            assert false
        error failure:
            assert failure == JsonParseError.ExpectedValue(5)
            missing_value_rejected <- true
    assert missing_value_rejected
    missing_separator_rejected: mutable bool = false
    catch parse_json_document(lex_json("[1 2]", limits)):
        ok value:
            assert false
        error failure:
            assert failure == JsonParseError.ExpectedCommaOrEnd(3)
            missing_separator_rejected <- true
    assert missing_separator_rejected
    empty_input_rejected: mutable bool = false
    catch parse_json_document(lex_json("   ", limits)):
        ok value:
            assert false
        error failure:
            assert failure == JsonParseError.EmptyInput
            empty_input_rejected <- true
    assert empty_input_rejected


@test
def typed_json_encoder_is_bounded_and_preserves_values() -> void:
    limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 64, tokens: 16, depth: 4, records: 8, fields: 8, field_bytes: 16}
    document: mutable JsonDocument = JsonDocument{limits: limits}
    _ = advance_json_document(document, JsonDocumentEvent.Begin)
    _ = advance_json_document(document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Number, range: JsonRange{start: 1, end: 3}, depth: 1, scalar_value: "-3"}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 20)
    _ = advance_json_document(document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Text, range: JsonRange{start: 4, end: 19}, depth: 1, scalar_value: "a\"\\\n\0"})
    _ = advance_json_document(document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Array, range: JsonRange{start: 0, end: 20}})
    _ = advance_json_document(document, JsonDocumentEvent.AppendArrayChild, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 0, JsonArrayChild{owner_index: 2, value_index: 0, ordinal: 0})
    _ = advance_json_document(document, JsonDocumentEvent.AppendArrayChild, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 0, JsonArrayChild{owner_index: 2, value_index: 1, ordinal: 1})
    _ = advance_json_document(document, JsonDocumentEvent.AppendRoot, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, 2)
    _ = advance_json_document(document, JsonDocumentEvent.Seal)
    assert validate_json_document(document)

    encoded: darray[u8] = encode_json_root(document, 0)
    assert encoded.count == 20
    assert encoded[0] == 91
    assert encoded[1] == 45
    assert encoded[2] == 51
    assert encoded[3] == 44
    assert encoded[4] == 34
    assert encoded[5] == 97
    assert encoded[6] == 92
    assert encoded[7] == 34
    assert encoded[8] == 92
    assert encoded[9] == 92
    assert encoded[10] == 92
    assert encoded[11] == 110
    assert encoded[12] == 92
    assert encoded[13] == 117
    assert encoded[14] == 48 and encoded[15] == 48 and encoded[16] == 48 and encoded[17] == 48
    assert encoded[18] == 34
    assert encoded[19] == 93

    object_document: mutable JsonDocument = JsonDocument{limits: limits}
    _ = advance_json_document(object_document, JsonDocumentEvent.Begin)
    _ = advance_json_document(object_document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Bool, range: JsonRange{start: 7, end: 12}, depth: 1, bool_value: false}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 13)
    _ = advance_json_document(object_document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Object, range: JsonRange{start: 0, end: 13}})
    _ = advance_json_document(object_document, JsonDocumentEvent.AppendMember, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: 1, key: "a\"", key_range: JsonRange{start: 1, end: 6}, value_index: 0, ordinal: 0})
    _ = advance_json_document(object_document, JsonDocumentEvent.AppendRoot, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, 1)
    _ = advance_json_document(object_document, JsonDocumentEvent.Seal)
    assert validate_json_document(object_document)
    encoded_object: darray[u8] = encode_json_root(object_document, 0)
    assert encoded_object.count == 13
    assert encoded_object[0] == 123
    assert encoded_object[1] == 34 and encoded_object[2] == 97 and encoded_object[3] == 92
    assert encoded_object[4] == 34 and encoded_object[5] == 34 and encoded_object[6] == 58
    assert encoded_object[7] == 102 and encoded_object[8] == 97 and encoded_object[9] == 108
    assert encoded_object[10] == 115 and encoded_object[11] == 101 and encoded_object[12] == 125

    nested_document: mutable JsonDocument = JsonDocument{limits: limits}
    _ = advance_json_document(nested_document, JsonDocumentEvent.Begin)
    _ = advance_json_document(nested_document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Number, range: JsonRange{start: 2, end: 4}, depth: 2, scalar_value: "-3"}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 6)
    _ = advance_json_document(nested_document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Array, range: JsonRange{start: 1, end: 5}, depth: 1})
    _ = advance_json_document(nested_document, JsonDocumentEvent.AppendArrayChild, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 0, JsonArrayChild{owner_index: 1, value_index: 0, ordinal: 0})
    _ = advance_json_document(nested_document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Array, range: JsonRange{start: 0, end: 6}})
    _ = advance_json_document(nested_document, JsonDocumentEvent.AppendArrayChild, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 0, JsonArrayChild{owner_index: 2, value_index: 1, ordinal: 0})
    _ = advance_json_document(nested_document, JsonDocumentEvent.AppendRoot, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, 2)
    _ = advance_json_document(nested_document, JsonDocumentEvent.Seal)
    assert validate_json_document(nested_document)
    encoded_nested: darray[u8] = encode_json_root(nested_document, 0)
    assert encoded_nested.count == 6
    assert encoded_nested[0] == 91 and encoded_nested[1] == 91
    assert encoded_nested[2] == 45 and encoded_nested[3] == 51
    assert encoded_nested[4] == 93 and encoded_nested[5] == 93

    empty_document: mutable JsonDocument = JsonDocument{limits: limits}
    _ = advance_json_document(empty_document, JsonDocumentEvent.Begin)
    _ = advance_json_document(empty_document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Array, range: JsonRange{start: 0, end: 2}}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 2)
    _ = advance_json_document(empty_document, JsonDocumentEvent.AppendRoot, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, 0)
    _ = advance_json_document(empty_document, JsonDocumentEvent.Seal)
    assert validate_json_document(empty_document)
    encoded_empty: darray[u8] = encode_json_root(empty_document, 0)
    assert encoded_empty.count == 2 and encoded_empty[0] == 91 and encoded_empty[1] == 93

    null_document: mutable JsonDocument = JsonDocument{limits: limits}
    _ = advance_json_document(null_document, JsonDocumentEvent.Begin)
    _ = advance_json_document(null_document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Null, range: JsonRange{start: 0, end: 4}}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 4)
    _ = advance_json_document(null_document, JsonDocumentEvent.AppendRoot, JsonNodeInput{kind: JsonNodeKind.Null}, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, 0)
    _ = advance_json_document(null_document, JsonDocumentEvent.Seal)
    assert validate_json_document(null_document)
    encoded_null: darray[u8] = encode_json_root(null_document, 0)
    assert encoded_null.count == 4
    assert encoded_null[0] == 110 and encoded_null[1] == 117 and encoded_null[2] == 108 and encoded_null[3] == 108

    output_limit_rejected: mutable bool = false
    catch encode_json_root(document, 0, 19):
        ok value:
            assert false
        error failure:
            assert failure == JsonEncodeError.OutputLimitExceeded
            output_limit_rejected <- true
    assert output_limit_rejected
    root_index_rejected: mutable bool = false
    catch encode_json_root(document, 1):
        ok value:
            assert false
        error failure:
            assert failure == JsonEncodeError.RootIndexInvalid
            root_index_rejected <- true
    assert root_index_rejected
    output_limit_invalid: mutable bool = false
    catch encode_json_root(document, 0, 0):
        ok value:
            assert false
        error failure:
            assert failure == JsonEncodeError.InvalidLimit
            output_limit_invalid <- true
    assert output_limit_invalid
    assert validate_json_document(document)


@test
def typed_schema_binding_contract_checks_json_kinds_and_required_fields() -> void:
    schema: SchemaDescriptor = SchemaDescriptor{name: "config", source: SchemaSource.Json, fields: [SchemaField{name: "name", kind: SchemaValueKind.Text}]}
    node: JsonNode = JsonNode{kind: JsonNodeKind.Text, range: JsonRange{start: 0, end: 4}, scalar_start: 0, scalar_bytes: 4}
    session: mutable SchemaDecodeSession = SchemaDecodeSession{schema: schema, input_nodes: [node]}
    assert advance_schema_session(session, SchemaDecodeEvent.Begin) == SchemaDecodeState.Binding
    assert advance_schema_session(session, SchemaDecodeEvent.Bind, SchemaBinding{field_index: 0, node_index: 0}) == SchemaDecodeState.Binding
    assert advance_schema_session(session, SchemaDecodeEvent.Complete) == SchemaDecodeState.Complete
    assert validate_schema_session(session)
    wrong: mutable SchemaDecodeSession = SchemaDecodeSession{schema: schema, input_nodes: [JsonNode{kind: JsonNodeKind.Number}]}
    _ = advance_schema_session(wrong, SchemaDecodeEvent.Begin)
    kind_rejected: mutable bool = false
    catch advance_schema_session(wrong, SchemaDecodeEvent.Bind, SchemaBinding{field_index: 0, node_index: 0}):
        ok value:
            assert false
        error failure:
            assert failure == SchemaContractError.ValueKindMismatch
            kind_rejected <- true
    assert kind_rejected
    forged_ready: mutable bool = false
    catch validate_schema_session(SchemaDecodeSession{schema: schema, state: SchemaDecodeState.Ready, input_nodes: [node], bindings: [SchemaBinding{field_index: 0, node_index: 0}], bound_fields: 1}):
        ok value:
            assert false
        error failure:
            assert failure == SchemaContractError.InvalidState
            forged_ready <- true
    assert forged_ready
    forged_complete: mutable bool = false
    catch validate_schema_session(SchemaDecodeSession{schema: schema, state: SchemaDecodeState.Complete, input_nodes: [node]}):
        ok value:
            assert false
        error failure:
            assert failure == SchemaContractError.RequiredFieldMissing
            forged_complete <- true
    assert forged_complete


@test
def typed_json_schema_materializer_owns_scalars_and_preserves_schema_order() -> void:
    limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 256, tokens: 64, depth: 8, records: 8, fields: 16, field_bytes: 64}
    source: sview = "{\"user\":\"Ada\",\"active\":true,\"n\":-0,\"exp\":1e+09,\"nil\":null}"
    document: JsonDocument = parse_json_document(lex_json(source, limits))
    root_index: usize = document.roots[0]
    assert json_object_member_index(document, root_index, "user") == 0
    assert json_object_member_index(document, root_index, "absent") == JSON_INDEX_NONE
    matches: darray[usize] = json_object_member_indices(document, root_index, ["nil", "active", "absent"])
    assert matches.count == 3 and matches[0] == 4 and matches[1] == 1 and matches[2] == JSON_INDEX_NONE
    empty_object: JsonDocument = parse_json_document(lex_json("{}", limits))
    assert json_object_member_index(empty_object, empty_object.roots[0], "missing") == JSON_INDEX_NONE
    empty_matches: darray[usize] = json_object_member_indices(empty_object, empty_object.roots[0], ["missing"])
    assert empty_matches.count == 1 and empty_matches[0] == JSON_INDEX_NONE

    schema: SchemaDescriptor = SchemaDescriptor{name: "profile", source: SchemaSource.Json, fields: [
        SchemaField{name: "person", kind: SchemaValueKind.Text, source_name: "user"},
        SchemaField{name: "enabled", kind: SchemaValueKind.Bool, source_name: "active"},
        SchemaField{name: "negative_zero", kind: SchemaValueKind.Number, source_name: "n"},
        SchemaField{name: "exponent", kind: SchemaValueKind.Number, source_name: "exp"},
        SchemaField{name: "note", kind: SchemaValueKind.Text, required: false},
        SchemaField{name: "nothing", kind: SchemaValueKind.Null, source_name: "nil"}
    ]}
    record: SchemaJsonRecord = materialize_json_schema_record(schema, document, 0)
    assert record.root_ordinal == 0
    assert record.values.count == 6 and record.payload_bytes == 10
    assert record.values[0].field_index == 0 and record.values[0].kind == SchemaJsonValueKind.Text
    assert record.values[0].bytes.count == 3 and record.values[0].bytes[0] == 65 and record.values[0].bytes[1] == 100 and record.values[0].bytes[2] == 97
    assert record.values[1].field_index == 1 and record.values[1].kind == SchemaJsonValueKind.Bool and record.values[1].bool_value
    assert record.values[2].kind == SchemaJsonValueKind.Number and record.values[2].bytes.count == 2 and record.values[2].bytes[0] == 45 and record.values[2].bytes[1] == 48
    assert record.values[3].kind == SchemaJsonValueKind.Number and record.values[3].bytes.count == 5
    assert record.values[3].bytes[0] == 49 and record.values[3].bytes[1] == 101 and record.values[3].bytes[2] == 43 and record.values[3].bytes[3] == 48 and record.values[3].bytes[4] == 57
    assert record.values[4].field_index == 4 and record.values[4].kind == SchemaJsonValueKind.Missing
    assert record.values[5].field_index == 5 and record.values[5].kind == SchemaJsonValueKind.Null

    alias_collision: mutable bool = false
    catch validate_schema_descriptor(SchemaDescriptor{name: "collision", source: SchemaSource.Json, fields: [SchemaField{name: "id", kind: SchemaValueKind.Text, source_name: "legacy_id"}, SchemaField{name: "legacy_id", kind: SchemaValueKind.Text}]}):
        ok value:
            assert false
        error failure:
            assert failure == SchemaContractError.DuplicateSourceName
            alias_collision <- true
    assert alias_collision

    missing_required: mutable bool = false
    catch materialize_json_schema_record(SchemaDescriptor{name: "missing", source: SchemaSource.Json, fields: [SchemaField{name: "required", kind: SchemaValueKind.Text}]}, document, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaContractError.RequiredFieldMissing
            missing_required <- true
    assert missing_required

    kind_mismatch: mutable bool = false
    catch materialize_json_schema_record(SchemaDescriptor{name: "wrong_kind", source: SchemaSource.Json, fields: [SchemaField{name: "user", kind: SchemaValueKind.Bool}]}, document, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaContractError.ValueKindMismatch
            kind_mismatch <- true
    assert kind_mismatch

    unknown_document: JsonDocument = parse_json_document(lex_json("{\"user\":\"Ada\",\"extra\":1}", limits))
    unknown_field: mutable bool = false
    catch materialize_json_schema_record(SchemaDescriptor{name: "unknown", source: SchemaSource.Json, fields: [SchemaField{name: "user", kind: SchemaValueKind.Text}]}, unknown_document, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaJsonMaterializeError.UnknownField
            unknown_field <- true
    assert unknown_field
    allow_unknown: SchemaJsonRecord = materialize_json_schema_record(SchemaDescriptor{name: "unknown_ok", source: SchemaSource.Json, fields: [SchemaField{name: "user", kind: SchemaValueKind.Text}], allow_unknown: true}, unknown_document, 0)
    assert allow_unknown.values.count == 1

    array_document: JsonDocument = parse_json_document(lex_json("{\"items\":[1]}", limits))
    array_record: SchemaJsonRecord = materialize_json_schema_record(SchemaDescriptor{name: "nested", source: SchemaSource.Json, fields: [SchemaField{name: "items", kind: SchemaValueKind.Array}]}, array_document, 0)
    assert array_record.values[0].kind == SchemaJsonValueKind.Array and array_record.values[0].container_root_index == 0
    assert array_record.nested_values.nodes.count == 2 and array_record.nested_values.children.count == 1
    assert array_record.nested_values.nodes[1].kind == JsonNodeKind.Number
    assert array_record.nested_values.scalar_bytes.count == 1 and array_record.nested_values.scalar_bytes[0] == 49
    assert validate_schema_json_record(array_record)

    any_rejected: mutable bool = false
    catch materialize_json_schema_record(SchemaDescriptor{name: "dynamic", source: SchemaSource.Json, fields: [SchemaField{name: "user", kind: SchemaValueKind.Any}]}, document, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaJsonMaterializeError.UnsupportedValueKind
            any_rejected <- true
    assert any_rejected

    wrong_root: JsonDocument = parse_json_document(lex_json("[1]", limits))
    root_rejected: mutable bool = false
    catch materialize_json_schema_record(schema, wrong_root, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaJsonMaterializeError.RootNotObject
            root_rejected <- true
    assert root_rejected

    root_index_rejected: mutable bool = false
    catch materialize_json_schema_record(schema, document, 1):
        ok value:
            assert false
        error failure:
            assert failure == SchemaJsonMaterializeError.RootIndexInvalid
            root_index_rejected <- true
    assert root_index_rejected
    document.scalar_data[0] <- 90
    assert record.values[0].bytes[0] == 65


@test
def typed_json_schema_materializer_owns_nested_values_iteratively_and_preserves_order() -> void:
    limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 512, tokens: 128, depth: 16, records: 8, fields: 32, field_bytes: 128}
    source: sview = "{\"arr\":[{\"z\":true,\"a\":[1.00,null]},[]],\"obj\":{\"b\":false,\"a\":\"x\\u0000y\"},\"empty\":[]}"
    document: mutable JsonDocument = parse_json_document(lex_json(source, limits))
    schema: SchemaDescriptor = SchemaDescriptor{name: "nested_config", source: SchemaSource.Json, fields: [
        SchemaField{name: "arr", kind: SchemaValueKind.Array},
        SchemaField{name: "obj", kind: SchemaValueKind.Object},
        SchemaField{name: "empty", kind: SchemaValueKind.Array}
    ]}
    record: SchemaJsonRecord = materialize_json_schema_record(schema, document, 0)
    graph: SchemaJsonOwnedValueGraph = record.nested_values
    assert record.payload_bytes == 11 and validate_schema_json_record(record)
    assert record.values[0].container_root_index == 0 and record.values[1].container_root_index == 1 and record.values[2].container_root_index == 2
    assert graph.nodes.count == 11 and graph.children.count == 4 and graph.members.count == 4
    assert graph.nodes[0].kind == JsonNodeKind.Array and graph.nodes[0].child_count == 2
    assert graph.children[0].value_index == 3 and graph.children[1].value_index == 4
    assert graph.nodes[1].kind == JsonNodeKind.Object and graph.nodes[1].member_count == 2
    assert graph.nodes[2].kind == JsonNodeKind.Array and graph.nodes[2].child_count == 0 and graph.nodes[2].child_start == SCHEMA_JSON_INDEX_NONE
    assert graph.nodes[3].kind == JsonNodeKind.Object and graph.nodes[3].member_count == 2
    assert graph.members[0].key_start == 0 and graph.members[0].key_bytes == 1 and graph.key_bytes[0] == 98
    assert graph.members[1].key_start == 1 and graph.key_bytes[1] == 97
    assert graph.members[2].key_start == 2 and graph.key_bytes[2] == 122
    assert graph.members[3].key_start == 3 and graph.key_bytes[3] == 97
    assert graph.nodes[6].kind == JsonNodeKind.Text and graph.nodes[6].scalar_bytes == 3
    assert graph.scalar_bytes[0] == 120 and graph.scalar_bytes[1] == 0 and graph.scalar_bytes[2] == 121
    assert graph.nodes[8].kind == JsonNodeKind.Array and graph.nodes[8].child_count == 2
    assert graph.children[2].value_index == 9 and graph.children[3].value_index == 10
    assert graph.nodes[9].kind == JsonNodeKind.Number and graph.nodes[9].scalar_bytes == 4
    assert graph.scalar_bytes[3] == 49 and graph.scalar_bytes[4] == 46 and graph.scalar_bytes[5] == 48 and graph.scalar_bytes[6] == 48
    document.scalar_data[0] <- 57
    document.key_bytes[0] <- 120
    assert graph.scalar_bytes[3] == 49 and graph.key_bytes[2] == 122

    forged: mutable SchemaJsonRecord = record
    forged.nested_values.children[0].value_index <- 0
    forged_rejected: mutable bool = false
    catch validate_schema_json_record(forged):
        ok value:
            assert not value
        error failure:
            assert failure == SchemaJsonMaterializeError.InvalidRecord
            forged_rejected <- true
    assert forged_rejected

    any_document: JsonDocument = parse_json_document(lex_json("{\"dynamic\":[1]}", limits))
    any_rejected: mutable bool = false
    catch materialize_json_schema_record(SchemaDescriptor{name: "dynamic", source: SchemaSource.Json, fields: [SchemaField{name: "dynamic", kind: SchemaValueKind.Any}]}, any_document, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaJsonMaterializeError.UnsupportedValueKind
            any_rejected <- true
    assert any_rejected


@test
def typed_json_schema_materializer_checks_recursive_nested_types_and_exact_numbers() -> void:
    limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 512, tokens: 128, depth: 16, records: 8, fields: 32, field_bytes: 128}
    document: JsonDocument = parse_json_document(lex_json("{\"tree\":{\"label\":\"root\",\"count\":2,\"weight\":-0.00,\"children\":[{\"label\":\"leaf\",\"count\":3,\"children\":[]}]}}", limits))
    schema: SchemaDescriptor = SchemaDescriptor{name: "recursive_tree", source: SchemaSource.Json, fields: [
        SchemaField{name: "tree", kind: SchemaValueKind.Object, type_index: 0}
    ], types: [
        SchemaTypeNode{kind: SchemaValueKind.Object, object_field_start: 0, object_field_count: 4},
        SchemaTypeNode{kind: SchemaValueKind.Array, array_item_type_index: 0},
        SchemaTypeNode{kind: SchemaValueKind.Text},
        SchemaTypeNode{kind: SchemaValueKind.Number, integer_target: SchemaIntegerTarget.I16},
        SchemaTypeNode{kind: SchemaValueKind.Number, decimal_target: SchemaDecimalTarget.Exact}
    ], nested_fields: [
        SchemaNestedField{name: "children", required: false, type_index: 1},
        SchemaNestedField{name: "count", type_index: 3},
        SchemaNestedField{name: "name", source_name: "label", type_index: 2},
        SchemaNestedField{name: "weight", required: false, type_index: 4}
    ]}

    record: SchemaJsonRecord = materialize_json_schema_record(schema, document, 0)
    graph: SchemaJsonOwnedValueGraph = record.nested_values
    assert validate_schema_json_record_against(schema, record)
    assert record.values[0].type_index == 0 and graph.nodes[0].schema_type_index == 0
    assert graph.nodes[4].kind == JsonNodeKind.Array and graph.nodes[4].schema_type_index == 1
    assert graph.nodes[5].kind == JsonNodeKind.Object and graph.nodes[5].schema_type_index == 0
    assert graph.nodes[2].number_representation == SchemaJsonNumberRepresentation.Integer
    assert graph.nodes[2].integer_value.target == SchemaIntegerTarget.I16 and graph.nodes[2].integer_value.signed_value == 2
    assert graph.nodes[3].number_representation == SchemaJsonNumberRepresentation.Decimal
    assert graph.nodes[3].decimal_value.negative and graph.nodes[3].decimal_value.scale == 2
    assert graph.nodes[3].decimal_value.coefficient_digits.count == 3
    assert graph.members[0].schema_field_index == 2 and graph.members[1].schema_field_index == 1
    assert graph.members[2].schema_field_index == 3 and graph.members[3].schema_field_index == 0
    assert graph.members[4].schema_field_index == 2 and graph.members[5].schema_field_index == 1
    assert graph.members[6].schema_field_index == 0

    generic_validation_rejected: mutable bool = false
    catch validate_schema_json_record(record):
        ok value:
            assert not value
        error failure:
            assert failure == SchemaJsonMaterializeError.InvalidRecord
            generic_validation_rejected <- true
    assert generic_validation_rejected

    forged: mutable SchemaJsonRecord = record
    forged.nested_values.nodes[5].schema_type_index <- 2
    forged_rejected: mutable bool = false
    catch validate_schema_json_record_against(schema, forged):
        ok value:
            assert not value
        error failure:
            assert failure == SchemaJsonMaterializeError.InvalidRecord
            forged_rejected <- true
    assert forged_rejected

    missing_required: JsonDocument = parse_json_document(lex_json("{\"tree\":{\"count\":2}}", limits))
    missing_rejected: mutable bool = false
    catch materialize_json_schema_record(schema, missing_required, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaContractError.RequiredFieldMissing
            missing_rejected <- true
    assert missing_rejected

    wrong_kind: JsonDocument = parse_json_document(lex_json("{\"tree\":{\"label\":\"root\",\"count\":\"2\"}}", limits))
    wrong_kind_rejected: mutable bool = false
    catch materialize_json_schema_record(schema, wrong_kind, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaContractError.ValueKindMismatch
            wrong_kind_rejected <- true
    assert wrong_kind_rejected

    unknown_field: JsonDocument = parse_json_document(lex_json("{\"tree\":{\"label\":\"root\",\"count\":2,\"other\":true}}", limits))
    unknown_rejected: mutable bool = false
    catch materialize_json_schema_record(schema, unknown_field, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaJsonMaterializeError.UnknownField
            unknown_rejected <- true
    assert unknown_rejected

    open_schema: mutable SchemaDescriptor = schema
    open_schema.types[0].allow_unknown <- true
    unknown_subtree: JsonDocument = parse_json_document(lex_json("{\"tree\":{\"label\":\"root\",\"count\":2,\"other\":[{\"x\":1}]}}", limits))
    unknown_record: SchemaJsonRecord = materialize_json_schema_record(open_schema, unknown_subtree, 0)
    assert validate_schema_json_record_against(open_schema, unknown_record)
    assert unknown_record.nested_values.members[2].schema_field_index == SCHEMA_TYPE_INDEX_NONE
    assert unknown_record.nested_values.nodes[3].schema_type_index == SCHEMA_TYPE_INDEX_NONE
    assert unknown_record.nested_values.nodes[4].schema_type_index == SCHEMA_TYPE_INDEX_NONE
    assert unknown_record.nested_values.members[3].schema_field_index == SCHEMA_TYPE_INDEX_NONE
    assert unknown_record.nested_values.nodes[5].schema_type_index == SCHEMA_TYPE_INDEX_NONE

    known_optional_document: JsonDocument = parse_json_document(lex_json("{\"tree\":{\"label\":\"root\",\"count\":2,\"children\":[],\"other\":[]}}", limits))
    known_optional_record: SchemaJsonRecord = materialize_json_schema_record(open_schema, known_optional_document, 0)
    forged_unknown: mutable SchemaJsonRecord = known_optional_record
    forged_unknown.nested_values.members[2].schema_field_index <- SCHEMA_TYPE_INDEX_NONE
    forged_unknown.nested_values.nodes[3].schema_type_index <- SCHEMA_TYPE_INDEX_NONE
    forged_unknown_rejected: mutable bool = false
    catch validate_schema_json_record_against(open_schema, forged_unknown):
        ok value:
            assert not value
        error failure:
            assert failure == SchemaJsonMaterializeError.InvalidRecord
            forged_unknown_rejected <- true
    assert forged_unknown_rejected

    duplicate_unknown_document: JsonDocument = parse_json_document(lex_json("{\"tree\":{\"label\":\"root\",\"count\":2,\"other\":[],\"extra\":[]}}", limits))
    duplicate_unknown_record: SchemaJsonRecord = materialize_json_schema_record(open_schema, duplicate_unknown_document, 0)
    forged_duplicate_unknown: mutable SchemaJsonRecord = duplicate_unknown_record
    forged_duplicate_unknown.nested_values.key_bytes[15] <- 111
    forged_duplicate_unknown.nested_values.key_bytes[16] <- 116
    forged_duplicate_unknown.nested_values.key_bytes[17] <- 104
    forged_duplicate_unknown.nested_values.key_bytes[18] <- 101
    forged_duplicate_unknown.nested_values.key_bytes[19] <- 114
    forged_duplicate_rejected: mutable bool = false
    catch validate_schema_json_record_against(open_schema, forged_duplicate_unknown):
        ok value:
            assert not value
        error failure:
            assert failure == SchemaJsonMaterializeError.InvalidRecord
            forged_duplicate_rejected <- true
    assert forged_duplicate_rejected

    invalid_order: mutable bool = false
    bad_order: SchemaDescriptor = SchemaDescriptor{name: "bad_order", source: SchemaSource.Json, fields: [SchemaField{name: "tree", kind: SchemaValueKind.Object, type_index: 0}], types: [
        SchemaTypeNode{kind: SchemaValueKind.Object, object_field_start: 0, object_field_count: 2},
        SchemaTypeNode{kind: SchemaValueKind.Text}
    ], nested_fields: [SchemaNestedField{name: "z", type_index: 1}, SchemaNestedField{name: "a", type_index: 1}]}
    catch validate_schema_descriptor(bad_order):
        ok value:
            assert false
        error failure:
            assert failure == SchemaContractError.InvalidNestedFieldOrder
            invalid_order <- true
    assert invalid_order

    unreachable: mutable bool = false
    bad_graph: SchemaDescriptor = SchemaDescriptor{name: "unreachable", source: SchemaSource.Json, fields: [SchemaField{name: "tree", kind: SchemaValueKind.Object, type_index: 0}], types: [
        SchemaTypeNode{kind: SchemaValueKind.Object},
        SchemaTypeNode{kind: SchemaValueKind.Text}
    ]}
    catch validate_schema_descriptor(bad_graph):
        ok value:
            assert false
        error failure:
            assert failure == SchemaContractError.InvalidTypeReference
            unreachable <- true
    assert unreachable


@test
def typed_schema_json_integer_targets_convert_exactly_without_float_rounding() -> void:
    limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 256, tokens: 64, depth: 8, records: 8, fields: 16, field_bytes: 64}
    document: JsonDocument = parse_json_document(lex_json("{\"small\":127,\"negative\":-128,\"wide\":18446744073709551615,\"minimum\":-9223372036854775808}", limits))
    schema: SchemaDescriptor = SchemaDescriptor{name: "integer_config", source: SchemaSource.Json, fields: [
        SchemaField{name: "small", kind: SchemaValueKind.Number, integer_target: SchemaIntegerTarget.I8},
        SchemaField{name: "negative", kind: SchemaValueKind.Number, integer_target: SchemaIntegerTarget.I8},
        SchemaField{name: "wide", kind: SchemaValueKind.Number, integer_target: SchemaIntegerTarget.U64},
        SchemaField{name: "minimum", kind: SchemaValueKind.Number, integer_target: SchemaIntegerTarget.I64}
    ]}
    record: SchemaJsonRecord = materialize_json_schema_record(schema, document, 0)
    assert record.values.count == 4 and record.payload_bytes == 0
    assert record.values[0].kind == SchemaJsonValueKind.Integer and record.values[0].integer_value.target == SchemaIntegerTarget.I8 and record.values[0].integer_value.signed_value == 127
    assert record.values[1].kind == SchemaJsonValueKind.Integer and record.values[1].integer_value.signed_value == -128
    assert record.values[2].kind == SchemaJsonValueKind.Integer and record.values[2].integer_value.target == SchemaIntegerTarget.U64 and record.values[2].integer_value.unsigned_value == 18446744073709551615u64
    assert record.values[3].kind == SchemaJsonValueKind.Integer and record.values[3].integer_value.signed_value == (-9223372036854775807i64 - 1)

    forged_integer: mutable SchemaJsonRecord = record
    forged_integer.values[0].integer_value.signed_value <- 128
    forged_integer_rejected: mutable bool = false
    catch validate_schema_json_record(forged_integer):
        ok value:
            assert not value
        error failure:
            assert failure == SchemaJsonMaterializeError.InvalidRecord
            forged_integer_rejected <- true
    assert forged_integer_rejected

    too_large: JsonDocument = parse_json_document(lex_json("{\"n\":128}", limits))
    range_rejected: mutable bool = false
    catch materialize_json_schema_record(SchemaDescriptor{name: "too_large", source: SchemaSource.Json, fields: [SchemaField{name: "n", kind: SchemaValueKind.Number, integer_target: SchemaIntegerTarget.I8}]}, too_large, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaIntegerError.TargetOutOfRange
            range_rejected <- true
    assert range_rejected

    u64_overflow: JsonDocument = parse_json_document(lex_json("{\"n\":18446744073709551616}", limits))
    u64_range_rejected: mutable bool = false
    catch materialize_json_schema_record(SchemaDescriptor{name: "u64_too_large", source: SchemaSource.Json, fields: [SchemaField{name: "n", kind: SchemaValueKind.Number, integer_target: SchemaIntegerTarget.U64}]}, u64_overflow, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaIntegerError.TargetOutOfRange
            u64_range_rejected <- true
    assert u64_range_rejected

    decimal: JsonDocument = parse_json_document(lex_json("{\"n\":1.0}", limits))
    decimal_rejected: mutable bool = false
    catch materialize_json_schema_record(SchemaDescriptor{name: "not_integral", source: SchemaSource.Json, fields: [SchemaField{name: "n", kind: SchemaValueKind.Number, integer_target: SchemaIntegerTarget.I32}]}, decimal, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaIntegerError.MalformedInteger
            decimal_rejected <- true
    assert decimal_rejected

    invalid_target: mutable bool = false
    catch validate_schema_descriptor(SchemaDescriptor{name: "wrong_target", source: SchemaSource.Json, fields: [SchemaField{name: "text", kind: SchemaValueKind.Text, integer_target: SchemaIntegerTarget.I8}]}):
        ok value:
            assert false
        error failure:
            assert failure == SchemaContractError.InvalidIntegerTarget
            invalid_target <- true
    assert invalid_target


@test
def typed_schema_json_decimal_target_preserves_exact_scale_and_negative_zero() -> void:
    limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 256, tokens: 64, depth: 8, records: 8, fields: 16, field_bytes: 64}
    document: JsonDocument = parse_json_document(lex_json("{\"negative_zero\":-0.00,\"tenths\":1.0,\"hundredths\":1.00,\"scaled\":1e2,\"fraction\":1.2500e-2,\"leading_fraction\":0.0010,\"cancelled_scale\":1.00e2}", limits))
    schema: SchemaDescriptor = SchemaDescriptor{name: "exact_decimal", source: SchemaSource.Json, fields: [
        SchemaField{name: "negative_zero", kind: SchemaValueKind.Number, decimal_target: SchemaDecimalTarget.Exact},
        SchemaField{name: "tenths", kind: SchemaValueKind.Number, decimal_target: SchemaDecimalTarget.Exact},
        SchemaField{name: "hundredths", kind: SchemaValueKind.Number, decimal_target: SchemaDecimalTarget.Exact},
        SchemaField{name: "scaled", kind: SchemaValueKind.Number, decimal_target: SchemaDecimalTarget.Exact},
        SchemaField{name: "fraction", kind: SchemaValueKind.Number, decimal_target: SchemaDecimalTarget.Exact},
        SchemaField{name: "leading_fraction", kind: SchemaValueKind.Number, decimal_target: SchemaDecimalTarget.Exact},
        SchemaField{name: "cancelled_scale", kind: SchemaValueKind.Number, decimal_target: SchemaDecimalTarget.Exact}
    ]}
    record: SchemaJsonRecord = materialize_json_schema_record(schema, document, 0)
    assert record.values.count == 7 and record.payload_bytes == 22
    assert record.values[0].kind == SchemaJsonValueKind.Decimal and record.values[0].decimal_value.negative
    assert record.values[0].decimal_value.scale == 2 and record.values[0].decimal_value.coefficient_digits.count == 3
    assert record.values[0].decimal_value.coefficient_digits[0] == 48 and record.values[0].decimal_value.coefficient_digits[1] == 48 and record.values[0].decimal_value.coefficient_digits[2] == 48
    assert record.values[1].decimal_value.coefficient_digits.count == 2 and record.values[1].decimal_value.coefficient_digits[0] == 49 and record.values[1].decimal_value.coefficient_digits[1] == 48 and record.values[1].decimal_value.scale == 1
    assert record.values[2].decimal_value.coefficient_digits.count == 3 and record.values[2].decimal_value.coefficient_digits[0] == 49 and record.values[2].decimal_value.coefficient_digits[2] == 48 and record.values[2].decimal_value.scale == 2
    assert record.values[3].decimal_value.coefficient_digits.count == 1 and record.values[3].decimal_value.coefficient_digits[0] == 49 and record.values[3].decimal_value.scale == -2
    assert record.values[4].decimal_value.coefficient_digits.count == 5 and record.values[4].decimal_value.coefficient_digits[0] == 49 and record.values[4].decimal_value.coefficient_digits[4] == 48 and record.values[4].decimal_value.scale == 6
    assert record.values[5].decimal_value.coefficient_digits.count == 5 and record.values[5].decimal_value.coefficient_digits[0] == 48 and record.values[5].decimal_value.coefficient_digits[2] == 48 and record.values[5].decimal_value.coefficient_digits[3] == 49 and record.values[5].decimal_value.scale == 4
    assert record.values[6].decimal_value.coefficient_digits.count == 3 and record.values[6].decimal_value.scale == 0
    assert validate_schema_json_record(record)

    forged: mutable SchemaJsonRecord = record
    forged.values[1].decimal_value.coefficient_digits[0] <- 46
    forged_rejected: mutable bool = false
    catch validate_schema_json_record(forged):
        ok value:
            assert not value
        error failure:
            assert failure == SchemaJsonMaterializeError.InvalidRecord
            forged_rejected <- true
    assert forged_rejected

    invalid_target: mutable bool = false
    catch validate_schema_descriptor(SchemaDescriptor{name: "wrong_decimal_target", source: SchemaSource.Json, fields: [SchemaField{name: "text", kind: SchemaValueKind.Text, decimal_target: SchemaDecimalTarget.Exact}]}):
        ok value:
            assert false
        error failure:
            assert failure == SchemaContractError.InvalidDecimalTarget
            invalid_target <- true
    assert invalid_target

    conflicting_targets: mutable bool = false
    catch validate_schema_descriptor(SchemaDescriptor{name: "conflicting_targets", source: SchemaSource.Json, fields: [SchemaField{name: "n", kind: SchemaValueKind.Number, integer_target: SchemaIntegerTarget.I32, decimal_target: SchemaDecimalTarget.Exact}]}):
        ok value:
            assert false
        error failure:
            assert failure == SchemaContractError.ConflictingNumericTargets
            conflicting_targets <- true
    assert conflicting_targets

    bounded_exponent: JsonDocument = parse_json_document(lex_json("{\"n\":1e10000}", limits))
    exponent_rejected: mutable bool = false
    catch materialize_json_schema_record(SchemaDescriptor{name: "bounded_exponent", source: SchemaSource.Json, fields: [SchemaField{name: "n", kind: SchemaValueKind.Number, decimal_target: SchemaDecimalTarget.Exact}]}, bounded_exponent, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaDecimalError.InputLimitExceeded
            exponent_rejected <- true
    assert exponent_rejected


@test
def exact_schema_decimal_comparison_uses_numeric_value_not_representation() -> void:
    one_point_zero: darray[u8] = [49, 46, 48]
    one_hundredth_scale: darray[u8] = [49, 46, 48, 48]
    leading_zero_one: darray[u8] = [48, 48, 49, 46, 48, 48]
    negative_zero: darray[u8] = [45, 48]
    positive_zero: darray[u8] = [48]
    negative_zero_fraction: darray[u8] = [45, 48, 46, 48, 48]
    exponent_zero: darray[u8] = [48, 48, 48, 101, 57, 57, 57, 57]
    leading_fraction: darray[u8] = [48, 48, 48, 46, 48, 48, 49]
    one_hundredth: darray[u8] = [48, 46, 48, 49]
    two: darray[u8] = [50]
    one_point_nine_nine: darray[u8] = [49, 46, 57, 57]
    negative_two: darray[u8] = [45, 50]
    negative_one_point_nine_nine: darray[u8] = [45, 49, 46, 57, 57]
    large_positive: darray[u8] = [49, 101, 57, 57, 57, 57]
    equivalent_large_positive: darray[u8] = [49, 48, 101, 57, 57, 57, 56]
    next_lower_order: darray[u8] = [57, 101, 57, 57, 57, 56]
    large_negative: darray[u8] = [45, 49, 101, 57, 57, 57, 57]

    one_point_zero_value: SchemaDecimalValue = parse_schema_decimal(one_point_zero, 0, one_point_zero.count)
    one_hundredth_scale_value: SchemaDecimalValue = parse_schema_decimal(one_hundredth_scale, 0, one_hundredth_scale.count)
    leading_zero_one_value: SchemaDecimalValue = parse_schema_decimal(leading_zero_one, 0, leading_zero_one.count)
    negative_zero_value: SchemaDecimalValue = parse_schema_decimal(negative_zero, 0, negative_zero.count)
    positive_zero_value: SchemaDecimalValue = parse_schema_decimal(positive_zero, 0, positive_zero.count)
    negative_zero_fraction_value: SchemaDecimalValue = parse_schema_decimal(negative_zero_fraction, 0, negative_zero_fraction.count)
    exponent_zero_value: SchemaDecimalValue = parse_schema_decimal(exponent_zero, 0, exponent_zero.count)
    leading_fraction_value: SchemaDecimalValue = parse_schema_decimal(leading_fraction, 0, leading_fraction.count)
    one_hundredth_value: SchemaDecimalValue = parse_schema_decimal(one_hundredth, 0, one_hundredth.count)
    two_value: SchemaDecimalValue = parse_schema_decimal(two, 0, two.count)
    one_point_nine_nine_value: SchemaDecimalValue = parse_schema_decimal(one_point_nine_nine, 0, one_point_nine_nine.count)
    negative_two_value: SchemaDecimalValue = parse_schema_decimal(negative_two, 0, negative_two.count)
    negative_one_point_nine_nine_value: SchemaDecimalValue = parse_schema_decimal(negative_one_point_nine_nine, 0, negative_one_point_nine_nine.count)
    large_positive_value: SchemaDecimalValue = parse_schema_decimal(large_positive, 0, large_positive.count)
    equivalent_large_positive_value: SchemaDecimalValue = parse_schema_decimal(equivalent_large_positive, 0, equivalent_large_positive.count)
    next_lower_order_value: SchemaDecimalValue = parse_schema_decimal(next_lower_order, 0, next_lower_order.count)
    large_negative_value: SchemaDecimalValue = parse_schema_decimal(large_negative, 0, large_negative.count)

    assert one_point_zero_value.scale == 1 and one_hundredth_scale_value.scale == 2
    assert compare_schema_decimal(one_point_zero_value, one_hundredth_scale_value) == SchemaDecimalOrdering.Equal
    assert compare_schema_decimal(one_point_zero_value, leading_zero_one_value) == SchemaDecimalOrdering.Equal
    assert compare_schema_decimal(large_positive_value, equivalent_large_positive_value) == SchemaDecimalOrdering.Equal
    assert compare_schema_decimal(negative_zero_value, positive_zero_value) == SchemaDecimalOrdering.Equal
    assert compare_schema_decimal(exponent_zero_value, negative_zero_fraction_value) == SchemaDecimalOrdering.Equal
    assert compare_schema_decimal(leading_fraction_value, one_hundredth_value) == SchemaDecimalOrdering.Less
    assert compare_schema_decimal(exponent_zero_value, large_positive_value) == SchemaDecimalOrdering.Less
    assert compare_schema_decimal(negative_zero_value, large_negative_value) == SchemaDecimalOrdering.Greater
    assert compare_schema_decimal(two_value, one_point_nine_nine_value) == SchemaDecimalOrdering.Greater
    assert compare_schema_decimal(negative_two_value, negative_one_point_nine_nine_value) == SchemaDecimalOrdering.Less
    assert large_positive_value.scale == SCHEMA_DECIMAL_MIN_SCALE
    assert compare_schema_decimal(large_positive_value, next_lower_order_value) == SchemaDecimalOrdering.Greater

    invalid: mutable bool = false
    catch compare_schema_decimal(SchemaDecimalValue{coefficient_digits: [49], scale: SCHEMA_DECIMAL_MAX_SCALE + 1}, positive_zero_value):
        ok value:
            _ = value
            assert false
        error failure:
            assert failure == SchemaDecimalError.NumericStateInvalid
            invalid <- true
    assert invalid


@test
def exact_schema_decimal_rounding_and_fixed_formatting_obey_explicit_policies() -> void:
    two_point_five: darray[u8] = [50, 46, 53]
    three_point_five: darray[u8] = [51, 46, 53]
    negative_two_point_five: darray[u8] = [45, 50, 46, 53]
    negative_three_point_five: darray[u8] = [45, 51, 46, 53]
    negative_one_point_one: darray[u8] = [45, 49, 46, 49]
    positive_one_point_one: darray[u8] = [49, 46, 49]
    tiny_positive: darray[u8] = [48, 46, 48, 48, 49]
    tiny_negative: darray[u8] = [45, 48, 46, 48, 48, 49]
    zero_point_zero_zero_five: darray[u8] = [48, 46, 48, 48, 53]
    zero_point_zero_one_five: darray[u8] = [48, 46, 48, 49, 53]
    one_point_two_five_zero_zero: darray[u8] = [49, 46, 50, 53, 48, 48]
    one_point_two_five_zero_one: darray[u8] = [49, 46, 50, 53, 48, 49]
    one_point_two: darray[u8] = [49, 46, 50]
    negative_zero: darray[u8] = [45, 48, 46, 48, 48]
    positive_exponent: darray[u8] = [49, 101, 51]
    negative_exponent: darray[u8] = [49, 101, 45, 51]

    two_point_five_value: SchemaDecimalValue = parse_schema_decimal(two_point_five, 0, two_point_five.count)
    three_point_five_value: SchemaDecimalValue = parse_schema_decimal(three_point_five, 0, three_point_five.count)
    negative_two_point_five_value: SchemaDecimalValue = parse_schema_decimal(negative_two_point_five, 0, negative_two_point_five.count)
    negative_three_point_five_value: SchemaDecimalValue = parse_schema_decimal(negative_three_point_five, 0, negative_three_point_five.count)
    negative_one_point_one_value: SchemaDecimalValue = parse_schema_decimal(negative_one_point_one, 0, negative_one_point_one.count)
    positive_one_point_one_value: SchemaDecimalValue = parse_schema_decimal(positive_one_point_one, 0, positive_one_point_one.count)
    tiny_positive_value: SchemaDecimalValue = parse_schema_decimal(tiny_positive, 0, tiny_positive.count)
    tiny_negative_value: SchemaDecimalValue = parse_schema_decimal(tiny_negative, 0, tiny_negative.count)
    zero_point_zero_zero_five_value: SchemaDecimalValue = parse_schema_decimal(zero_point_zero_zero_five, 0, zero_point_zero_zero_five.count)
    zero_point_zero_one_five_value: SchemaDecimalValue = parse_schema_decimal(zero_point_zero_one_five, 0, zero_point_zero_one_five.count)
    one_point_two_five_zero_zero_value: SchemaDecimalValue = parse_schema_decimal(one_point_two_five_zero_zero, 0, one_point_two_five_zero_zero.count)
    one_point_two_five_zero_one_value: SchemaDecimalValue = parse_schema_decimal(one_point_two_five_zero_one, 0, one_point_two_five_zero_one.count)
    one_point_two_value: SchemaDecimalValue = parse_schema_decimal(one_point_two, 0, one_point_two.count)
    negative_zero_value: SchemaDecimalValue = parse_schema_decimal(negative_zero, 0, negative_zero.count)
    positive_exponent_value: SchemaDecimalValue = parse_schema_decimal(positive_exponent, 0, positive_exponent.count)
    negative_exponent_value: SchemaDecimalValue = parse_schema_decimal(negative_exponent, 0, negative_exponent.count)

    even_down: SchemaDecimalValue = round_schema_decimal(two_point_five_value, 0, SchemaDecimalRounding.HalfToEven)
    even_up: SchemaDecimalValue = round_schema_decimal(three_point_five_value, 0, SchemaDecimalRounding.HalfToEven)
    half_away: SchemaDecimalValue = round_schema_decimal(negative_two_point_five_value, 0, SchemaDecimalRounding.HalfAwayFromZero)
    toward_zero: SchemaDecimalValue = round_schema_decimal(negative_two_point_five_value, 0, SchemaDecimalRounding.TowardZero)
    negative_even_down: SchemaDecimalValue = round_schema_decimal(negative_two_point_five_value, 0, SchemaDecimalRounding.HalfToEven)
    negative_even_up: SchemaDecimalValue = round_schema_decimal(negative_three_point_five_value, 0, SchemaDecimalRounding.HalfToEven)
    floor_negative: SchemaDecimalValue = round_schema_decimal(negative_one_point_one_value, 0, SchemaDecimalRounding.Floor)
    ceiling_negative: SchemaDecimalValue = round_schema_decimal(negative_one_point_one_value, 0, SchemaDecimalRounding.Ceiling)
    ceiling_positive: SchemaDecimalValue = round_schema_decimal(positive_one_point_one_value, 0, SchemaDecimalRounding.Ceiling)
    away_tiny: SchemaDecimalValue = round_schema_decimal(tiny_positive_value, 2, SchemaDecimalRounding.AwayFromZero)
    floor_tiny_negative: SchemaDecimalValue = round_schema_decimal(tiny_negative_value, 2, SchemaDecimalRounding.Floor)
    ceiling_tiny_negative: SchemaDecimalValue = round_schema_decimal(tiny_negative_value, 2, SchemaDecimalRounding.Ceiling)
    even_tie_down: SchemaDecimalValue = round_schema_decimal(zero_point_zero_zero_five_value, 2, SchemaDecimalRounding.HalfToEven)
    even_tie_up: SchemaDecimalValue = round_schema_decimal(zero_point_zero_one_five_value, 2, SchemaDecimalRounding.HalfToEven)
    exact_midpoint: SchemaDecimalValue = round_schema_decimal(one_point_two_five_zero_zero_value, 1, SchemaDecimalRounding.HalfToEven)
    above_midpoint: SchemaDecimalValue = round_schema_decimal(one_point_two_five_zero_one_value, 1, SchemaDecimalRounding.HalfToEven)
    away_tie: SchemaDecimalValue = round_schema_decimal(zero_point_zero_zero_five_value, 2, SchemaDecimalRounding.HalfAwayFromZero)
    padded: SchemaDecimalValue = round_schema_decimal(one_point_two_value, 3, SchemaDecimalRounding.TowardZero)

    even_down_text: darray[u8] = format_schema_decimal(even_down, 16)
    even_up_text: darray[u8] = format_schema_decimal(even_up, 16)
    half_away_text: darray[u8] = format_schema_decimal(half_away, 16)
    toward_zero_text: darray[u8] = format_schema_decimal(toward_zero, 16)
    floor_negative_text: darray[u8] = format_schema_decimal(floor_negative, 16)
    ceiling_negative_text: darray[u8] = format_schema_decimal(ceiling_negative, 16)
    ceiling_positive_text: darray[u8] = format_schema_decimal(ceiling_positive, 16)
    away_tiny_text: darray[u8] = format_schema_decimal(away_tiny, 16)
    floor_tiny_negative_text: darray[u8] = format_schema_decimal(floor_tiny_negative, 16)
    ceiling_tiny_negative_text: darray[u8] = format_schema_decimal(ceiling_tiny_negative, 16)
    even_tie_down_text: darray[u8] = format_schema_decimal(even_tie_down, 16)
    even_tie_up_text: darray[u8] = format_schema_decimal(even_tie_up, 16)
    away_tie_text: darray[u8] = format_schema_decimal(away_tie, 16)
    padded_text: darray[u8] = format_schema_decimal(padded, 16)
    negative_zero_text: darray[u8] = format_schema_decimal(negative_zero_value, 16)
    positive_exponent_text: darray[u8] = format_schema_decimal(positive_exponent_value, 16)
    negative_exponent_text: darray[u8] = format_schema_decimal(negative_exponent_value, 16)
    leading_zero_text: darray[u8] = format_schema_decimal(leading_zero_one_value, 16)
    exact_midpoint_text: darray[u8] = format_schema_decimal(exact_midpoint, 16)
    above_midpoint_text: darray[u8] = format_schema_decimal(above_midpoint, 16)
    negative_even_down_text: darray[u8] = format_schema_decimal(negative_even_down, 16)
    negative_even_up_text: darray[u8] = format_schema_decimal(negative_even_up, 16)
    exact_output_limit_text: darray[u8] = format_schema_decimal(negative_zero_value, 5)

    assert bytes_view(even_down_text) == "2" and bytes_view(even_up_text) == "4"
    assert bytes_view(half_away_text) == "-3" and bytes_view(toward_zero_text) == "-2"
    assert bytes_view(negative_even_down_text) == "-2" and bytes_view(negative_even_up_text) == "-4"
    assert bytes_view(floor_negative_text) == "-2" and bytes_view(ceiling_negative_text) == "-1"
    assert bytes_view(ceiling_positive_text) == "2" and bytes_view(away_tiny_text) == "0.01"
    assert bytes_view(floor_tiny_negative_text) == "-0.01" and bytes_view(ceiling_tiny_negative_text) == "-0.00"
    assert bytes_view(even_tie_down_text) == "0.00" and bytes_view(even_tie_up_text) == "0.02"
    assert bytes_view(exact_midpoint_text) == "1.2" and bytes_view(above_midpoint_text) == "1.3"
    assert bytes_view(away_tie_text) == "0.01" and bytes_view(padded_text) == "1.200"
    assert bytes_view(negative_zero_text) == "-0.00"
    assert bytes_view(leading_zero_text) == "001.00" and bytes_view(exact_output_limit_text) == "-0.00"
    assert bytes_view(positive_exponent_text) == "1000" and bytes_view(negative_exponent_text) == "0.001"

    output_limit_rejected: mutable bool = false
    catch format_schema_decimal(negative_zero_value, 4):
        ok value:
            _ = value
            assert false
        error failure:
            assert failure == SchemaDecimalError.OutputLimitExceeded
            output_limit_rejected <- true
    assert output_limit_rejected

    expansion_limit_rejected: mutable bool = false
    catch round_schema_decimal(one_point_two_value, SCHEMA_DECIMAL_MAX_SCALE, SchemaDecimalRounding.TowardZero):
        ok value:
            _ = value
            assert false
        error failure:
            assert failure == SchemaDecimalError.InputLimitExceeded
            expansion_limit_rejected <- true
    assert expansion_limit_rejected

    carry_digits: mutable darray[u8] = []
    carry_index: mutable usize = 0
    while carry_index < SCHEMA_DECIMAL_MAX_DIGITS - 1 |carry_index, carry_digits|:
        carry_digits.push(57)
        carry_index <- carry_index + 1
    carry_digits.push(53)
    carry_value: SchemaDecimalValue = SchemaDecimalValue{coefficient_digits: carry_digits, scale: 1}
    carry_result: SchemaDecimalValue = round_schema_decimal(carry_value, 0, SchemaDecimalRounding.HalfAwayFromZero)
    assert carry_result.coefficient_digits.count == SCHEMA_DECIMAL_MAX_DIGITS and carry_result.coefficient_digits[0] == 49
    carry_check: mutable usize = 1
    while carry_check < carry_result.coefficient_digits.count |carry_check, carry_result|:
        assert carry_result.coefficient_digits[carry_check] == 48
        carry_check <- carry_check + 1

    maximum_width: SchemaDecimalValue = SchemaDecimalValue{negative: true, coefficient_digits: [49], scale: SCHEMA_DECIMAL_MAX_SCALE}
    maximum_width_text: darray[u8] = format_schema_decimal(maximum_width, SCHEMA_DECIMAL_MAX_FORMAT_BYTES)
    assert maximum_width_text.count == SCHEMA_DECIMAL_MAX_FORMAT_BYTES
    assert maximum_width_text[0] == 45 and maximum_width_text[1] == 48 and maximum_width_text[2] == 46 and maximum_width_text[maximum_width_text.count - 1] == 49

    exact_width_rejected: mutable bool = false
    catch format_schema_decimal(maximum_width, SCHEMA_DECIMAL_MAX_FORMAT_BYTES - 1):
        ok value:
            _ = value
            assert false
        error failure:
            assert failure == SchemaDecimalError.OutputLimitExceeded
            exact_width_rejected <- true
    assert exact_width_rejected

    scale_limit_rejected: mutable bool = false
    catch round_schema_decimal(one_point_two_value, SCHEMA_DECIMAL_MAX_SCALE + 1, SchemaDecimalRounding.TowardZero):
        ok value:
            _ = value
            assert false
        error failure:
            assert failure == SchemaDecimalError.ScaleOutOfRange
            scale_limit_rejected <- true
    assert scale_limit_rejected


@test
def typed_csv_schema_integer_targets_decode_signed_and_unsigned_fields() -> void:
    source: sview = "\"-128\",+127,255\n"
    materializer: mutable CsvMaterializer = CsvMaterializer{source: source}
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 0, 6, true)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 7, 11, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 12, 15, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Record, 0, 0, false, 0, 3)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.End)
    schema: SchemaDescriptor = SchemaDescriptor{name: "numeric_row", source: SchemaSource.Csv, fields: [
        SchemaField{name: "minimum", kind: SchemaValueKind.Text, integer_target: SchemaIntegerTarget.I8},
        SchemaField{name: "positive", kind: SchemaValueKind.Text, integer_target: SchemaIntegerTarget.I8},
        SchemaField{name: "unsigned", kind: SchemaValueKind.Text, integer_target: SchemaIntegerTarget.U8}
    ]}
    record: SchemaCsvRecord = materialize_csv_schema_record(schema, materializer, 0)
    assert record.values.count == 3 and record.payload_bytes == 0
    assert record.values[0].kind == SchemaCsvValueKind.Integer and record.values[0].integer_value.signed_value == -128
    assert record.values[1].kind == SchemaCsvValueKind.Integer and record.values[1].integer_value.signed_value == 127
    assert record.values[2].kind == SchemaCsvValueKind.Integer and record.values[2].integer_value.unsigned_value == 255

    batch_materializer: mutable CsvMaterializer = CsvMaterializer{source: "1\n2\n"}
    _ = advance_csv_materializer(batch_materializer, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(batch_materializer, CsvMaterializerEvent.Field, 0, 1, false)
    _ = advance_csv_materializer(batch_materializer, CsvMaterializerEvent.Field, 2, 3, false)
    _ = advance_csv_materializer(batch_materializer, CsvMaterializerEvent.Record, 0, 0, false, 0, 1)
    _ = advance_csv_materializer(batch_materializer, CsvMaterializerEvent.Record, 0, 0, false, 1, 1)
    _ = advance_csv_materializer(batch_materializer, CsvMaterializerEvent.End)
    batch_schema: SchemaDescriptor = SchemaDescriptor{name: "numeric_batch", source: SchemaSource.Csv, fields: [
        SchemaField{name: "n", kind: SchemaValueKind.Text, integer_target: SchemaIntegerTarget.I8}
    ]}
    batch: SchemaCsvRecordBatch = materialize_csv_schema_batch(batch_schema, batch_materializer, 0, 2)
    assert batch.records.count == 2 and batch.value_count == 2 and batch.payload_bytes == 0
    assert batch.records[0].values[0].integer_value.signed_value == 1 and batch.records[1].values[0].integer_value.signed_value == 2

    malformed: mutable CsvMaterializer = CsvMaterializer{source: "1_0\n"}
    _ = advance_csv_materializer(malformed, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(malformed, CsvMaterializerEvent.Field, 0, 3, false)
    _ = advance_csv_materializer(malformed, CsvMaterializerEvent.Record, 0, 0, false, 0, 1)
    _ = advance_csv_materializer(malformed, CsvMaterializerEvent.End)
    malformed_rejected: mutable bool = false
    catch materialize_csv_schema_record(SchemaDescriptor{name: "underscored", source: SchemaSource.Csv, fields: [SchemaField{name: "n", kind: SchemaValueKind.Text, integer_target: SchemaIntegerTarget.I32}]}, malformed, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaIntegerError.MalformedInteger
            malformed_rejected <- true
    assert malformed_rejected

    empty: mutable CsvMaterializer = CsvMaterializer{source: "\n"}
    _ = advance_csv_materializer(empty, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(empty, CsvMaterializerEvent.Field, 0, 0, false)
    _ = advance_csv_materializer(empty, CsvMaterializerEvent.Record, 0, 0, false, 0, 1)
    _ = advance_csv_materializer(empty, CsvMaterializerEvent.End)
    empty_rejected: mutable bool = false
    catch materialize_csv_schema_record(SchemaDescriptor{name: "empty_integer", source: SchemaSource.Csv, fields: [SchemaField{name: "n", kind: SchemaValueKind.Text, integer_target: SchemaIntegerTarget.I32}]}, empty, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaIntegerError.MalformedInteger
            empty_rejected <- true
    assert empty_rejected


@test
def typed_csv_schema_decimal_target_preserves_exact_scale_and_batch_payload() -> void:
    source: sview = "+1.00\n-0e3\n"
    materializer: mutable CsvMaterializer = CsvMaterializer{source: source}
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 0, 5, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 6, 10, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Record, 0, 0, false, 0, 1)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Record, 0, 0, false, 1, 1)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.End)
    schema: SchemaDescriptor = SchemaDescriptor{name: "exact_decimal_rows", source: SchemaSource.Csv, fields: [SchemaField{name: "amount", kind: SchemaValueKind.Text, decimal_target: SchemaDecimalTarget.Exact}]}
    batch: SchemaCsvRecordBatch = materialize_csv_schema_batch(schema, materializer, 0, 2)
    assert batch.records.count == 2 and batch.value_count == 2 and batch.payload_bytes == 4
    assert batch.records[0].values[0].kind == SchemaCsvValueKind.Decimal and not batch.records[0].values[0].decimal_value.negative
    assert batch.records[0].values[0].decimal_value.coefficient_digits.count == 3 and batch.records[0].values[0].decimal_value.scale == 2
    assert batch.records[1].values[0].kind == SchemaCsvValueKind.Decimal and batch.records[1].values[0].decimal_value.negative
    assert batch.records[1].values[0].decimal_value.coefficient_digits.count == 1 and batch.records[1].values[0].decimal_value.scale == -3

    malformed: mutable CsvMaterializer = CsvMaterializer{source: "1e\n"}
    _ = advance_csv_materializer(malformed, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(malformed, CsvMaterializerEvent.Field, 0, 2, false)
    _ = advance_csv_materializer(malformed, CsvMaterializerEvent.Record, 0, 0, false, 0, 1)
    _ = advance_csv_materializer(malformed, CsvMaterializerEvent.End)
    malformed_rejected: mutable bool = false
    catch materialize_csv_schema_record(SchemaDescriptor{name: "malformed_decimal", source: SchemaSource.Csv, fields: [SchemaField{name: "n", kind: SchemaValueKind.Text, decimal_target: SchemaDecimalTarget.Exact}]}, malformed, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaDecimalError.MalformedDecimal
            malformed_rejected <- true
    assert malformed_rejected


@test
def typed_csv_stream_contract_preserves_quotes_and_bounded_rows() -> void:
    limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 32, tokens: 32, depth: 4, records: 4, fields: 8, field_bytes: 16}
    policy: CsvPolicy = CsvPolicy{separator: 44, quote: 34, escape: 34, record_separator: 10}
    stream: mutable CsvStream = CsvStream{policy: policy, limits: limits}
    assert advance_csv_stream(stream, CsvStreamEvent.Begin) == CsvStreamState.Unquoted
    assert advance_csv_stream(stream, CsvStreamEvent.Byte, 97) == CsvStreamState.Unquoted
    assert advance_csv_stream(stream, CsvStreamEvent.Byte, 44) == CsvStreamState.Unquoted
    assert advance_csv_stream(stream, CsvStreamEvent.Byte, 34) == CsvStreamState.Quoted
    assert advance_csv_stream(stream, CsvStreamEvent.Byte, 98) == CsvStreamState.Quoted
    assert advance_csv_stream(stream, CsvStreamEvent.Byte, 34) == CsvStreamState.AfterQuote
    assert advance_csv_stream(stream, CsvStreamEvent.Byte, 34) == CsvStreamState.Quoted
    assert advance_csv_stream(stream, CsvStreamEvent.Byte, 99) == CsvStreamState.Quoted
    assert advance_csv_stream(stream, CsvStreamEvent.Byte, 34) == CsvStreamState.AfterQuote
    assert advance_csv_stream(stream, CsvStreamEvent.Byte, 10) == CsvStreamState.Unquoted
    assert advance_csv_stream(stream, CsvStreamEvent.End) == CsvStreamState.Complete
    assert stream.records == 1
    assert stream.fields_total == 2
    forged_csv: mutable bool = false
    catch validate_csv_stream(CsvStream{policy: policy, limits: limits, state: CsvStreamState.Ready, input_bytes: 1}):
        ok value:
            assert false
        error failure:
            assert failure == CsvContractError.AccountingInvalid
            forged_csv <- true
    assert forged_csv
    invalid: mutable CsvStream = CsvStream{policy: policy, limits: limits}
    _ = advance_csv_stream(invalid, CsvStreamEvent.Begin)
    _ = advance_csv_stream(invalid, CsvStreamEvent.Byte, 34)
    truncated: mutable bool = false
    catch advance_csv_stream(invalid, CsvStreamEvent.End):
        ok value:
            assert false
        error failure:
            assert failure == CsvContractError.UnexpectedEnd
            truncated <- true
    assert truncated
    forged_complete: mutable bool = false
    catch validate_csv_stream(CsvStream{policy: policy, limits: limits, state: CsvStreamState.Complete, input_bytes: 1}):
        ok value:
            assert false
        error failure:
            assert failure == CsvContractError.AccountingInvalid
            forged_complete <- true
    assert forged_complete
    byte_rejected: mutable CsvStream = CsvStream{policy: policy, limits: limits}
    _ = advance_csv_stream(byte_rejected, CsvStreamEvent.Begin)
    _ = advance_csv_stream(byte_rejected, CsvStreamEvent.Byte, 97)
    unexpected_quote: mutable bool = false
    catch advance_csv_stream(byte_rejected, CsvStreamEvent.Byte, 34):
        ok value:
            assert false
        error failure:
            assert failure == CsvContractError.UnexpectedQuote
            unexpected_quote <- true
    assert unexpected_quote
    assert byte_rejected.input_bytes == 1
    assert byte_rejected.field_bytes == 1


@test
def typed_csv_stream_handles_explicit_line_ending_modes() -> void:
    limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 32, tokens: 32, depth: 4, records: 4, fields: 8, field_bytes: 16}
    crlf_policy: CsvPolicy = CsvPolicy{line_ending: CsvLineEndingMode.CrLf}
    assert validate_csv_policy(crlf_policy)
    assert csv_policy_record_terminator_width(crlf_policy) == 2
    assert csv_policy_record_terminator_contains(crlf_policy, 13)
    assert csv_policy_record_terminator_contains(crlf_policy, 10)
    custom_byte_policy: CsvPolicy = CsvPolicy{record_separator: 59}
    assert validate_csv_policy(custom_byte_policy)
    assert csv_policy_record_terminator_width(custom_byte_policy) == 1
    assert csv_policy_record_terminator_byte(custom_byte_policy, 0) == 59
    invalid_crlf_separator: mutable bool = false
    catch validate_csv_policy(CsvPolicy{separator: 13, line_ending: CsvLineEndingMode.CrLf}):
        ok value:
            assert false
        error failure:
            assert failure == DataContractError.InvalidCsvPolicy
            invalid_crlf_separator <- true
    assert invalid_crlf_separator

    crlf_stream: mutable CsvStream = CsvStream{policy: crlf_policy, limits: limits}
    _ = advance_csv_stream(crlf_stream, CsvStreamEvent.Begin)
    _ = advance_csv_stream(crlf_stream, CsvStreamEvent.Byte, 97)
    assert advance_csv_stream(crlf_stream, CsvStreamEvent.Byte, 13) == CsvStreamState.PendingRecordTerminator
    assert crlf_stream.input_bytes == 2 and crlf_stream.records == 0 and crlf_stream.field_bytes == 1
    assert advance_csv_stream(crlf_stream, CsvStreamEvent.Byte, 10) == CsvStreamState.Unquoted
    assert crlf_stream.input_bytes == 3 and crlf_stream.records == 1 and crlf_stream.fields_total == 1
    assert advance_csv_stream(crlf_stream, CsvStreamEvent.End) == CsvStreamState.Complete

    malformed_crlf: mutable CsvStream = CsvStream{policy: crlf_policy, limits: limits}
    _ = advance_csv_stream(malformed_crlf, CsvStreamEvent.Begin)
    _ = advance_csv_stream(malformed_crlf, CsvStreamEvent.Byte, 97)
    _ = advance_csv_stream(malformed_crlf, CsvStreamEvent.Byte, 13)
    invalid_suffix: mutable bool = false
    catch advance_csv_stream(malformed_crlf, CsvStreamEvent.Byte, 120):
        ok value:
            assert false
        error failure:
            assert failure == CsvContractError.InvalidRecordTerminator
            invalid_suffix <- true
    assert invalid_suffix
    assert malformed_crlf.state == CsvStreamState.PendingRecordTerminator
    assert malformed_crlf.input_bytes == 2 and malformed_crlf.field_bytes == 1 and malformed_crlf.records == 0
    incomplete_crlf: mutable bool = false
    catch advance_csv_stream(malformed_crlf, CsvStreamEvent.End):
        ok value:
            assert false
        error failure:
            assert failure == CsvContractError.UnexpectedEnd
            incomplete_crlf <- true
    assert incomplete_crlf

    lone_lf: mutable CsvStream = CsvStream{policy: crlf_policy, limits: limits}
    _ = advance_csv_stream(lone_lf, CsvStreamEvent.Begin)
    lone_lf_rejected: mutable bool = false
    catch advance_csv_stream(lone_lf, CsvStreamEvent.Byte, 10):
        ok value:
            assert false
        error failure:
            assert failure == CsvContractError.InvalidRecordTerminator
            lone_lf_rejected <- true
    assert lone_lf_rejected and lone_lf.input_bytes == 0

    lf_policy: CsvPolicy = CsvPolicy{line_ending: CsvLineEndingMode.Lf}
    assert validate_csv_policy(lf_policy)
    assert csv_policy_record_terminator_width(lf_policy) == 1
    assert csv_policy_record_terminator_byte(lf_policy, 0) == 10
    lf_stream: mutable CsvStream = CsvStream{policy: lf_policy, limits: limits}
    _ = advance_csv_stream(lf_stream, CsvStreamEvent.Begin)
    _ = advance_csv_stream(lf_stream, CsvStreamEvent.Byte, 108)
    assert advance_csv_stream(lf_stream, CsvStreamEvent.Byte, 10) == CsvStreamState.Unquoted
    assert advance_csv_stream(lf_stream, CsvStreamEvent.End) == CsvStreamState.Complete
    assert lf_stream.records == 1

    cr_policy: CsvPolicy = CsvPolicy{line_ending: CsvLineEndingMode.Cr}
    assert validate_csv_policy(cr_policy)
    assert csv_policy_record_terminator_width(cr_policy) == 1
    cr_stream: mutable CsvStream = CsvStream{policy: cr_policy, limits: limits}
    _ = advance_csv_stream(cr_stream, CsvStreamEvent.Begin)
    _ = advance_csv_stream(cr_stream, CsvStreamEvent.Byte, 97)
    assert advance_csv_stream(cr_stream, CsvStreamEvent.Byte, 13) == CsvStreamState.Unquoted
    assert cr_stream.records == 1
    _ = advance_csv_stream(cr_stream, CsvStreamEvent.Byte, 98)
    assert advance_csv_stream(cr_stream, CsvStreamEvent.End) == CsvStreamState.Complete
    assert cr_stream.records == 2


@test
def typed_csv_materializer_contract_preserves_bounded_field_spans() -> void:
    source: sview = "a,\"b\"\n"
    materializer: mutable CsvMaterializer = CsvMaterializer{source: source}
    assert validate_csv_materializer(materializer)
    assert advance_csv_materializer(materializer, CsvMaterializerEvent.Begin) == CsvMaterializerState.Building
    assert advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 0, 1, false) == CsvMaterializerState.Building
    assert advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 2, 5, true) == CsvMaterializerState.Building
    assert advance_csv_materializer(materializer, CsvMaterializerEvent.Record, 0, 0, false, 0, 2) == CsvMaterializerState.Building
    assert advance_csv_materializer(materializer, CsvMaterializerEvent.End) == CsvMaterializerState.Complete
    assert csv_materialized_field(materializer, 0) == "a"
    assert csv_materialized_field(materializer, 1) == "\"b\""
    forged_ready_materializer: mutable bool = false
    catch validate_csv_materializer(CsvMaterializer{source: "a", fields: [CsvFieldSpan{start: 0, end: 1}], next_field: 1, source_bytes: 1}):
        ok value:
            assert false
        error failure:
            assert failure == CsvMaterializerError.SourceAccountingInvalid
            forged_ready_materializer <- true
    assert forged_ready_materializer
    forged_cursor: mutable bool = false
    catch validate_csv_materializer(CsvMaterializer{source: "a", state: CsvMaterializerState.Building, fields: [CsvFieldSpan{start: 0, end: 1}], next_field: 0, source_bytes: 1}):
        ok value:
            assert false
        error failure:
            assert failure == CsvMaterializerError.RecordOrderInvalid
            forged_cursor <- true
    assert forged_cursor
    invalid_range: mutable bool = false
    catch csv_materialized_field(materializer, 2):
        ok value:
            assert false
        error failure:
            assert failure == CsvMaterializerError.FieldIndexInvalid
            invalid_range <- true
    assert invalid_range
    failed_lookup: mutable CsvMaterializer = CsvMaterializer{source: "a"}
    _ = advance_csv_materializer(failed_lookup, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(failed_lookup, CsvMaterializerEvent.Field, 0, 1, false)
    _ = advance_csv_materializer(failed_lookup, CsvMaterializerEvent.Fail)
    terminal_lookup: mutable bool = false
    catch csv_materialized_field(failed_lookup, 0):
        ok value:
            assert false
        error failure:
            assert failure == CsvMaterializerError.InvalidState
            terminal_lookup <- true
    assert terminal_lookup
    no_record: mutable CsvMaterializer = CsvMaterializer{source: ""}
    _ = advance_csv_materializer(no_record, CsvMaterializerEvent.Begin)
    empty_complete_rejected: mutable bool = false
    catch advance_csv_materializer(no_record, CsvMaterializerEvent.End):
        ok value:
            assert false
        error failure:
            assert failure == CsvMaterializerError.EndNotReady
            empty_complete_rejected <- true
    assert empty_complete_rejected
    trailing_source: mutable CsvMaterializer = CsvMaterializer{source: "a\nX"}
    _ = advance_csv_materializer(trailing_source, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(trailing_source, CsvMaterializerEvent.Field, 0, 1, false)
    _ = advance_csv_materializer(trailing_source, CsvMaterializerEvent.Record, 0, 0, false, 0, 1)
    trailing_bytes_rejected: mutable bool = false
    catch advance_csv_materializer(trailing_source, CsvMaterializerEvent.End):
        ok value:
            assert false
        error failure:
            assert failure == CsvMaterializerError.RecordLayoutInvalid
            trailing_bytes_rejected <- true
    assert trailing_bytes_rejected and trailing_source.state == CsvMaterializerState.Building


@test
def typed_csv_materializer_validates_crlf_boundaries_and_quoted_newlines() -> void:
    source: sview = "a,\"b\r\nc\"\r\nx,y\r\n"
    policy: CsvPolicy = CsvPolicy{line_ending: CsvLineEndingMode.CrLf}
    materializer: mutable CsvMaterializer = CsvMaterializer{source: source, policy: policy}
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 0, 1, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 2, 8, true)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 10, 11, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 12, 13, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Record, 0, 0, false, 0, 2)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Record, 0, 0, false, 2, 2)
    assert advance_csv_materializer(materializer, CsvMaterializerEvent.End) == CsvMaterializerState.Complete
    assert csv_materialized_field(materializer, 1) == "\"b\r\nc\""

    wrong_ending: mutable CsvMaterializer = CsvMaterializer{source: "a\n", policy: policy}
    _ = advance_csv_materializer(wrong_ending, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(wrong_ending, CsvMaterializerEvent.Field, 0, 1, false)
    _ = advance_csv_materializer(wrong_ending, CsvMaterializerEvent.Record, 0, 0, false, 0, 1)
    wrong_ending_rejected: mutable bool = false
    catch advance_csv_materializer(wrong_ending, CsvMaterializerEvent.End):
        ok value:
            assert false
        error failure:
            assert failure == CsvMaterializerError.RecordLayoutInvalid
            wrong_ending_rejected <- true
    assert wrong_ending_rejected and wrong_ending.state == CsvMaterializerState.Building


@test
def typed_csv_schema_materializer_binds_header_aliases_and_optional_fields() -> void:
    source: sview = "legacy_name,ignored\nAda,x\nBob,y\n"
    materializer: mutable CsvMaterializer = CsvMaterializer{source: source, policy: CsvPolicy{header: true}}
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 0, 11, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 12, 19, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 20, 23, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 24, 25, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 26, 29, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 30, 31, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Record, 0, 0, false, 0, 2)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Record, 0, 0, false, 2, 2)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Record, 0, 0, false, 4, 2)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.End)
    schema: SchemaDescriptor = SchemaDescriptor{name: "person", source: SchemaSource.Csv, allow_unknown: true, fields: [
        SchemaField{name: "name", source_name: "legacy_name", kind: SchemaValueKind.Text},
        SchemaField{name: "note", kind: SchemaValueKind.Text, required: false}
    ]}
    record: SchemaCsvRecord = materialize_csv_schema_record(schema, materializer, 0)
    assert record.row_ordinal == 0 and record.values.count == 2 and record.payload_bytes == 3
    assert record.values[0].field_index == 0 and record.values[0].kind == SchemaCsvValueKind.Text
    assert record.values[0].bytes.count == 3 and record.values[0].bytes[0] == 65 and record.values[0].bytes[1] == 100 and record.values[0].bytes[2] == 97
    assert record.values[1].field_index == 1 and record.values[1].kind == SchemaCsvValueKind.Missing
    batch: SchemaCsvRecordBatch = materialize_csv_schema_batch(schema, materializer, 0, 2)
    assert batch.first_row == 0 and batch.records.count == 2 and batch.value_count == 4 and batch.payload_bytes == 6
    assert batch.records[0].row_ordinal == 0 and batch.records[0].values[0].bytes.count == 3
    assert batch.records[1].row_ordinal == 1 and batch.records[1].values[0].bytes.count == 3 and batch.records[1].values[0].bytes[0] == 66

    unknown_header: mutable bool = false
    strict_schema: SchemaDescriptor = SchemaDescriptor{name: "strict_person", source: SchemaSource.Csv, fields: [SchemaField{name: "name", source_name: "legacy_name", kind: SchemaValueKind.Text}]}
    catch materialize_csv_schema_record(strict_schema, materializer, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaCsvMaterializeError.UnknownColumn
            unknown_header <- true
    assert unknown_header


@test
def typed_csv_schema_batch_projects_exact_ranges_with_shared_mapping() -> void:
    materializer: mutable CsvMaterializer = CsvMaterializer{source: "a,b\nc,d\n"}
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 0, 1, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 2, 3, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 4, 5, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 6, 7, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Record, 0, 0, false, 0, 2)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Record, 0, 0, false, 2, 2)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.End)
    schema: SchemaDescriptor = SchemaDescriptor{name: "pair", source: SchemaSource.Csv, fields: [
        SchemaField{name: "left", kind: SchemaValueKind.Text},
        SchemaField{name: "right", kind: SchemaValueKind.Text}
    ]}
    batch: SchemaCsvRecordBatch = materialize_csv_schema_batch(schema, materializer, 0, 2)
    assert batch.first_row == 0 and batch.records.count == 2 and batch.value_count == 4 and batch.payload_bytes == 4
    assert batch.records[0].row_ordinal == 0 and batch.records[0].values[0].bytes[0] == 97 and batch.records[0].values[1].bytes[0] == 98
    assert batch.records[1].row_ordinal == 1 and batch.records[1].values[0].bytes[0] == 99 and batch.records[1].values[1].bytes[0] == 100

    empty_batch: SchemaCsvRecordBatch = materialize_csv_schema_batch(schema, materializer, 2, 0)
    assert empty_batch.first_row == 2 and empty_batch.records.count == 0 and empty_batch.value_count == 0 and empty_batch.payload_bytes == 0
    range_rejected: mutable bool = false
    catch materialize_csv_schema_batch(schema, materializer, 3, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaCsvMaterializeError.RowIndexInvalid
            range_rejected <- true
    assert range_rejected
    row_limit_rejected: mutable bool = false
    catch materialize_csv_schema_batch(schema, materializer, 0, SCHEMA_CSV_MAX_BATCH_ROWS + 1):
        ok value:
            assert false
        error failure:
            assert failure == SchemaCsvMaterializeError.BatchRowLimitExceeded
            row_limit_rejected <- true
    assert row_limit_rejected

    incomplete: mutable CsvMaterializer = CsvMaterializer{source: "a,b\nc\n"}
    _ = advance_csv_materializer(incomplete, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(incomplete, CsvMaterializerEvent.Field, 0, 1, false)
    _ = advance_csv_materializer(incomplete, CsvMaterializerEvent.Field, 2, 3, false)
    _ = advance_csv_materializer(incomplete, CsvMaterializerEvent.Field, 4, 5, false)
    _ = advance_csv_materializer(incomplete, CsvMaterializerEvent.Record, 0, 0, false, 0, 2)
    _ = advance_csv_materializer(incomplete, CsvMaterializerEvent.Record, 0, 0, false, 2, 1)
    _ = advance_csv_materializer(incomplete, CsvMaterializerEvent.End)
    partial_batch_rejected: mutable bool = false
    catch materialize_csv_schema_batch(schema, incomplete, 0, 2):
        ok value:
            assert false
        error failure:
            assert failure == SchemaContractError.RequiredFieldMissing
            partial_batch_rejected <- true
    assert partial_batch_rejected


@test
def typed_csv_schema_materializer_distinguishes_empty_from_missing_and_maps_positions() -> void:
    materializer: mutable CsvMaterializer = CsvMaterializer{source: "a,,c\nx,,z\n"}
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 0, 1, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 2, 2, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 3, 4, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 5, 6, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 7, 7, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Field, 8, 9, false)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Record, 0, 0, false, 0, 3)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.Record, 0, 0, false, 3, 3)
    _ = advance_csv_materializer(materializer, CsvMaterializerEvent.End)
    schema: SchemaDescriptor = SchemaDescriptor{name: "columns", source: SchemaSource.Csv, allow_unknown: true, fields: [
        SchemaField{name: "empty", kind: SchemaValueKind.Text, source_index: 1},
        SchemaField{name: "missing", kind: SchemaValueKind.Text, source_index: 4, required: false},
        SchemaField{name: "last", kind: SchemaValueKind.Text, source_index: 2}
    ]}
    record: SchemaCsvRecord = materialize_csv_schema_record(schema, materializer, 0)
    assert record.values.count == 3 and record.values[0].kind == SchemaCsvValueKind.Text
    assert record.values[0].bytes.count == 0 and record.values[1].kind == SchemaCsvValueKind.Missing
    assert record.values[2].kind == SchemaCsvValueKind.Text and record.values[2].bytes.count == 1 and record.values[2].bytes[0] == 99
    batch: SchemaCsvRecordBatch = materialize_csv_schema_batch(schema, materializer, 0, 2)
    assert batch.records.count == 2 and batch.value_count == 6 and batch.payload_bytes == 2
    assert batch.records[0].values[0].bytes.count == 0 and batch.records[0].values[1].kind == SchemaCsvValueKind.Missing and batch.records[0].values[2].bytes[0] == 99
    assert batch.records[1].row_ordinal == 1 and batch.records[1].values[1].kind == SchemaCsvValueKind.Missing and batch.records[1].values[2].bytes[0] == 122

    required_missing: mutable bool = false
    required_schema: SchemaDescriptor = SchemaDescriptor{name: "missing_required", source: SchemaSource.Csv, allow_unknown: true, fields: [SchemaField{name: "absent", kind: SchemaValueKind.Text, source_index: 4}]}
    catch materialize_csv_schema_record(required_schema, materializer, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaContractError.RequiredFieldMissing
            required_missing <- true
    assert required_missing

    strict_sparse_schema: SchemaDescriptor = SchemaDescriptor{name: "strict_sparse", source: SchemaSource.Csv, fields: [
        SchemaField{name: "middle", kind: SchemaValueKind.Text, source_index: 1},
        SchemaField{name: "right", kind: SchemaValueKind.Text, source_index: 2}
    ]}
    strict_batch_unknown: mutable bool = false
    catch materialize_csv_schema_batch(strict_sparse_schema, materializer, 0, 2):
        ok value:
            assert false
        error failure:
            assert failure == SchemaCsvMaterializeError.UnknownColumn
            strict_batch_unknown <- true
    assert strict_batch_unknown

    duplicate_index: mutable bool = false
    duplicate_schema: SchemaDescriptor = SchemaDescriptor{name: "duplicate_positions", source: SchemaSource.Csv, fields: [
        SchemaField{name: "left", kind: SchemaValueKind.Text, source_index: 1},
        SchemaField{name: "right", kind: SchemaValueKind.Text, source_index: 1}
    ]}
    catch materialize_csv_schema_record(duplicate_schema, materializer, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaCsvMaterializeError.DuplicateSourceIndex
            duplicate_index <- true
    assert duplicate_index

    non_text_rejected: mutable bool = false
    non_text_schema: SchemaDescriptor = SchemaDescriptor{name: "numeric_text_pending", source: SchemaSource.Csv, fields: [SchemaField{name: "number", kind: SchemaValueKind.Number}]}
    catch materialize_csv_schema_record(non_text_schema, materializer, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaCsvMaterializeError.UnsupportedValueKind
            non_text_rejected <- true
    assert non_text_rejected


@test
def typed_csv_schema_materializer_unescapes_quotes_and_rejects_duplicate_header_names() -> void:
    quoted: mutable CsvMaterializer = CsvMaterializer{source: "\"A\"\"B\"\n"}
    _ = advance_csv_materializer(quoted, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(quoted, CsvMaterializerEvent.Field, 0, 6, true)
    _ = advance_csv_materializer(quoted, CsvMaterializerEvent.Record, 0, 0, false, 0, 1)
    _ = advance_csv_materializer(quoted, CsvMaterializerEvent.End)
    text_schema: SchemaDescriptor = SchemaDescriptor{name: "quoted", source: SchemaSource.Csv, fields: [SchemaField{name: "value", kind: SchemaValueKind.Text}]}
    decoded: SchemaCsvRecord = materialize_csv_schema_record(text_schema, quoted, 0)
    assert decoded.values[0].bytes.count == 3 and decoded.values[0].bytes[0] == 65 and decoded.values[0].bytes[1] == 34 and decoded.values[0].bytes[2] == 66

    duplicate: mutable CsvMaterializer = CsvMaterializer{source: "name,name\nx,x\n", policy: CsvPolicy{header: true}}
    _ = advance_csv_materializer(duplicate, CsvMaterializerEvent.Begin)
    _ = advance_csv_materializer(duplicate, CsvMaterializerEvent.Field, 0, 4, false)
    _ = advance_csv_materializer(duplicate, CsvMaterializerEvent.Field, 5, 9, false)
    _ = advance_csv_materializer(duplicate, CsvMaterializerEvent.Field, 10, 11, false)
    _ = advance_csv_materializer(duplicate, CsvMaterializerEvent.Field, 12, 13, false)
    _ = advance_csv_materializer(duplicate, CsvMaterializerEvent.Record, 0, 0, false, 0, 2)
    _ = advance_csv_materializer(duplicate, CsvMaterializerEvent.Record, 0, 0, false, 2, 2)
    _ = advance_csv_materializer(duplicate, CsvMaterializerEvent.End)
    duplicate_header: mutable bool = false
    catch materialize_csv_schema_record(text_schema, duplicate, 0):
        ok value:
            assert false
        error failure:
            assert failure == SchemaCsvMaterializeError.DuplicateHeader
            duplicate_header <- true
    assert duplicate_header


@test
def typed_install_plan_publishes_and_rolls_back_integrity_bound_artifacts() -> void:
    source: InstallArtifact = InstallArtifact{target: InstallTarget.Source, source_path: "tool.elisascript", destination_path: "bin/tool.elisascript", byte_count: 128, fingerprint: 1, digest_0: 1, digest_1: 2, digest_2: 3, digest_3: 4}
    empty_plan_rejected: mutable bool = false
    catch validate_install_plan(InstallPlan{package_name: "tool", package_version: PackageVersion{major: 1, minor: 0, patch: 0}}):
        ok value:
            assert false
        error failure:
            assert failure == InstallContractError.EmptyPlan
            empty_plan_rejected <- true
    assert empty_plan_rejected
    plan: mutable InstallPlan = InstallPlan{package_name: "tool", package_version: PackageVersion{major: 1, minor: 0, patch: 0}, artifacts: [source], offline_only: true}
    assert validate_install_plan(plan)
    assert advance_install_plan(plan, InstallEvent.Stage) == InstallState.Staged
    assert advance_install_plan(plan, InstallEvent.Verify) == InstallState.Verified
    assert advance_install_plan(plan, InstallEvent.Publish) == InstallState.Published
    published_failure: mutable bool = false
    catch advance_install_plan(plan, InstallEvent.Fail):
        ok value:
            assert false
        error failure:
            assert failure == InstallContractError.InvalidState
            published_failure <- true
    assert published_failure
    assert advance_install_plan(plan, InstallEvent.Rollback) == InstallState.Failed
    repeated_failure: mutable bool = false
    catch advance_install_plan(plan, InstallEvent.Fail):
        ok value:
            assert false
        error failure:
            assert failure == InstallContractError.InvalidState
            repeated_failure <- true
    assert repeated_failure
    invalid_version: mutable bool = false
    catch validate_install_plan(InstallPlan{package_name: "tool", package_version: PackageVersion{major: 1, minor: 0, patch: 0, pre_release: "bad\0"}, artifacts: [source]}):
        ok value:
            assert false
        error failure:
            assert failure == InstallContractError.PackageVersionInvalid
            invalid_version <- true
    assert invalid_version
    duplicate: mutable InstallPlan = InstallPlan{package_name: "tool", package_version: PackageVersion{major: 1, minor: 0, patch: 0}, artifacts: [source, source]}
    duplicate_rejected: mutable bool = false
    catch validate_install_plan(duplicate):
        ok value:
            assert false
        error failure:
            assert failure == InstallContractError.DuplicateDestination
            duplicate_rejected <- true
    assert duplicate_rejected
    large_a: InstallArtifact = InstallArtifact{target: InstallTarget.Bytecode, source_path: "bytecode-a", destination_path: "bin/a.esb", byte_count: 268435456, fingerprint: 1, digest_0: 1, digest_1: 1, digest_2: 1, digest_3: 1}
    large_b: InstallArtifact = InstallArtifact{target: InstallTarget.Bytecode, source_path: "bytecode-b", destination_path: "bin/b.esb", byte_count: 268435456, fingerprint: 2, digest_0: 2, digest_1: 2, digest_2: 2, digest_3: 2}
    large_c: InstallArtifact = InstallArtifact{target: InstallTarget.Bytecode, source_path: "bytecode-c", destination_path: "bin/c.esb", byte_count: 268435456, fingerprint: 3, digest_0: 3, digest_1: 3, digest_2: 3, digest_3: 3}
    large_d: InstallArtifact = InstallArtifact{target: InstallTarget.Bytecode, source_path: "bytecode-d", destination_path: "bin/d.esb", byte_count: 268435456, fingerprint: 4, digest_0: 4, digest_1: 4, digest_2: 4, digest_3: 4}
    large_e: InstallArtifact = InstallArtifact{target: InstallTarget.Bytecode, source_path: "bytecode-e", destination_path: "bin/e.esb", byte_count: 268435456, fingerprint: 5, digest_0: 5, digest_1: 5, digest_2: 5, digest_3: 5}
    aggregate_rejected: mutable bool = false
    catch validate_install_plan(InstallPlan{package_name: "tool", package_version: PackageVersion{major: 1, minor: 0, patch: 0}, artifacts: [large_a, large_b, large_c, large_d, large_e]}):
        ok value:
            assert false
        error failure:
            assert failure == InstallContractError.ArtifactBytesExceeded
            aggregate_rejected <- true
    assert aggregate_rejected


@test
def typed_source_map_contract_orders_locations_and_supports_lookup() -> void:
    map: mutable SourceMap = SourceMap{}
    assert advance_source_map(map, SourceMapEvent.Begin) == SourceMapState.Building
    assert advance_source_map(map, SourceMapEvent.AddFile, file: "src/main.elisascript") == SourceMapState.Building
    assert advance_source_map(map, SourceMapEvent.AddFile, file: "src/lib.elisascript") == SourceMapState.Building
    first: SourceMapEntry = SourceMapEntry{generated: SourceLocation{file_index: 0, line: 1, column: 1}, original: SourceLocation{file_index: 0, line: 4, column: 2}, symbol: "main"}
    second: SourceMapEntry = SourceMapEntry{generated: SourceLocation{file_index: 0, line: 2, column: 1}, original: SourceLocation{file_index: 1, line: 1, column: 1}, symbol: "helper"}
    assert advance_source_map(map, SourceMapEvent.Append, first) == SourceMapState.Building
    assert advance_source_map(map, SourceMapEvent.Append, second) == SourceMapState.Building
    assert source_map_lookup(map, first.generated) == 0
    assert source_map_lookup(map, second.generated) == 1
    assert advance_source_map(map, SourceMapEvent.Seal) == SourceMapState.Sealed
    duplicate: SourceMapEntry = SourceMapEntry{generated: first.generated, original: second.original}
    duplicate_rejected: mutable bool = false
    catch advance_source_map(map, SourceMapEvent.Append, duplicate):
        ok value:
            assert false
        error failure:
            assert failure == SourceMapContractError.AppendNotReady
            duplicate_rejected <- true
    assert duplicate_rejected
    invalid_lookup: mutable SourceMap = map
    assert advance_source_map(invalid_lookup, SourceMapEvent.Invalidate) == SourceMapState.Invalid
    invalid_lookup_rejected: mutable bool = false
    catch source_map_lookup(invalid_lookup, first.generated):
        ok value:
            assert false
        error failure:
            assert failure == SourceMapContractError.InvalidState
            invalid_lookup_rejected <- true
    assert invalid_lookup_rejected
    sealed_add_file_rejected: mutable bool = false
    catch advance_source_map(map, SourceMapEvent.AddFile, file: "src/main.elisascript"):
        ok value:
            assert false
        error failure:
            assert failure == SourceMapContractError.AppendNotReady
            sealed_add_file_rejected <- true
    assert sealed_add_file_rejected


@test
def typed_output_document_contract_is_stable_and_bounded() -> void:
    options: OutputOptions = OutputOptions{format: OutputFormat.Json, color: OutputColorMode.Never, max_bytes: 512}
    document: mutable OutputDocument = OutputDocument{options: options}
    assert advance_output_document(document, OutputDocumentEvent.Begin) == OutputDocumentState.Building
    passing: OutputRecord = OutputRecord{name: "case/pass", status: OutputStatus.Pass, message: "ok"}
    failing: OutputRecord = OutputRecord{name: "case/fail", status: OutputStatus.Fail, message: "mismatch"}
    assert advance_output_document(document, OutputDocumentEvent.Append, passing) == OutputDocumentState.Building
    assert advance_output_document(document, OutputDocumentEvent.Append, failing) == OutputDocumentState.Building
    assert document.failed_records == 1
    assert advance_output_document(document, OutputDocumentEvent.Seal) == OutputDocumentState.Sealed
    malformed_accounting: OutputDocument = OutputDocument{options: options, records: [failing], text_bytes: 17, failed_records: 0}
    accounting_rejected: mutable bool = false
    catch validate_output_document(malformed_accounting):
        ok value:
            assert false
        error failure:
            assert failure == OutputContractError.FailedRecordAccountingInvalid
            accounting_rejected <- true
    assert accounting_rejected
    text_accounting_rejected: mutable bool = false
    catch validate_output_document(OutputDocument{options: options, records: [passing], text_bytes: 0, failed_records: 0}):
        ok value:
            assert false
        error failure:
            assert failure == OutputContractError.TextAccountingInvalid
            text_accounting_rejected <- true
    assert text_accounting_rejected
    oversized: OutputOptions = OutputOptions{max_bytes: 0}
    invalid_rejected: mutable bool = false
    catch validate_output_options(oversized):
        ok value:
            assert false
        error failure:
            assert failure == OutputContractError.OutputLimitInvalid
            invalid_rejected <- true
    assert invalid_rejected


@test
def typed_output_renderer_contract_is_ordered_escaped_and_cancelable() -> void:
    options: OutputOptions = OutputOptions{format: OutputFormat.Json, color: OutputColorMode.Never, max_bytes: 1024}
    document: mutable OutputDocument = OutputDocument{options: options}
    assert advance_output_document(document, OutputDocumentEvent.Begin) == OutputDocumentState.Building
    record: OutputRecord = OutputRecord{name: "case/quote", status: OutputStatus.Fail, message: "bad \"value\"", stdout: "out", stderr: "err"}
    assert advance_output_document(document, OutputDocumentEvent.Append, record) == OutputDocumentState.Building
    assert advance_output_document(document, OutputDocumentEvent.Seal) == OutputDocumentState.Sealed
    render: mutable OutputRender = OutputRender{document: document}
    assert validate_output_render(render)
    assert advance_output_render(render, OutputRenderEvent.Begin) == OutputRenderState.Rendering
    assert advance_output_render(render, OutputRenderEvent.Emit, 0) == OutputRenderState.Rendering
    assert advance_output_render(render, OutputRenderEvent.Finish) == OutputRenderState.Complete
    assert render.emitted_bytes > sview_len(record.name) + sview_len(record.message)
    fresh: mutable OutputDocument = OutputDocument{options: options}
    assert advance_output_document(fresh, OutputDocumentEvent.Begin) == OutputDocumentState.Building
    assert advance_output_document(fresh, OutputDocumentEvent.Seal) == OutputDocumentState.Sealed
    cancelling: mutable OutputRender = OutputRender{document: fresh}
    assert advance_output_render(cancelling, OutputRenderEvent.Begin) == OutputRenderState.Rendering
    assert advance_output_render(cancelling, OutputRenderEvent.Cancel) == OutputRenderState.Cancelling
    assert advance_output_render(cancelling, OutputRenderEvent.CancelAck) == OutputRenderState.Cancelled
    tight_options: OutputOptions = OutputOptions{format: OutputFormat.Json, color: OutputColorMode.Never, max_bytes: 64}
    tight_document: mutable OutputDocument = OutputDocument{options: tight_options}
    assert advance_output_document(tight_document, OutputDocumentEvent.Begin) == OutputDocumentState.Building
    assert advance_output_document(tight_document, OutputDocumentEvent.Append, OutputRecord{name: "abcdefghij", status: OutputStatus.Pass, message: "12345678901234567890", stdout: "stdouttext", stderr: "stderrtext"}) == OutputDocumentState.Building
    assert advance_output_document(tight_document, OutputDocumentEvent.Seal) == OutputDocumentState.Sealed
    tight_render: mutable OutputRender = OutputRender{document: tight_document}
    assert advance_output_render(tight_render, OutputRenderEvent.Begin) == OutputRenderState.Rendering
    render_budget_rejected: mutable bool = false
    catch advance_output_render(tight_render, OutputRenderEvent.Emit, 0):
        ok value:
            assert false
        error failure:
            assert failure == OutputRenderError.RenderLimitExceeded
            render_budget_rejected <- true
    assert render_budget_rejected
    open_document: mutable OutputDocument = OutputDocument{options: options}
    assert advance_output_document(open_document, OutputDocumentEvent.Begin) == OutputDocumentState.Building
    open_render_rejected: mutable bool = false
    catch validate_output_render(OutputRender{document: open_document}):
        ok value:
            assert false
        error failure:
            assert failure == OutputRenderError.DocumentNotSealed
            open_render_rejected <- true
    assert open_render_rejected
    malformed_render: OutputRender = OutputRender{document: document, state: OutputRenderState.Rendering, chunks: 0}
    render_accounting_rejected: mutable bool = false
    catch validate_output_render(malformed_render):
        ok value:
            assert false
        error failure:
            assert failure == OutputRenderError.AccountingInvalid
            render_accounting_rejected <- true
    assert render_accounting_rejected


@test
def typed_build_graph_contract_is_ordered_bounded_and_cancelable() -> void:
    first_command: ProcessCommand = ProcessCommand{executable: "tool-a", arguments: []}
    second_command: ProcessCommand = ProcessCommand{executable: "tool-b", arguments: []}
    first: BuildNode = BuildNode{name: "compile", command: first_command, fingerprint: 1}
    second: BuildNode = BuildNode{name: "test", command: second_command, dependencies: ["compile"], fingerprint: 2}
    forged_succeeded: mutable bool = false
    catch validate_build_graph(BuildGraph{nodes: [first], state: BuildGraphState.Succeeded, max_parallel: 1}):
        ok value:
            assert false
        error failure:
            assert failure == BuildContractError.NodeAccountingInvalid
            forged_succeeded <- true
    assert forged_succeeded
    graph: mutable BuildGraph = BuildGraph{nodes: [first, second], max_parallel: 1}
    assert validate_build_graph(graph)
    assert advance_build_graph(graph, BuildGraphEvent.Start) == BuildGraphState.Running
    dependency_not_ready: mutable bool = false
    catch advance_build_graph(graph, BuildGraphEvent.NodeStart, 1):
        ok value:
            assert false
        error failure:
            assert failure == BuildContractError.DependencyNotReady
            dependency_not_ready <- true
    assert dependency_not_ready
    assert advance_build_graph(graph, BuildGraphEvent.NodeStart, 0) == BuildGraphState.Running
    assert advance_build_graph(graph, BuildGraphEvent.NodeSuccess, 0) == BuildGraphState.Running
    assert advance_build_graph(graph, BuildGraphEvent.NodeStart, 1) == BuildGraphState.Running
    assert advance_build_graph(graph, BuildGraphEvent.NodeFailure, 1) == BuildGraphState.Failed
    failed_pending: mutable BuildGraph = BuildGraph{nodes: [first, second], max_parallel: 1}
    assert advance_build_graph(failed_pending, BuildGraphEvent.Start) == BuildGraphState.Running
    assert advance_build_graph(failed_pending, BuildGraphEvent.NodeStart, 0) == BuildGraphState.Running
    assert advance_build_graph(failed_pending, BuildGraphEvent.NodeFailure, 0) == BuildGraphState.Failed
    assert failed_pending.completed_nodes == 2
    assert failed_pending.nodes[1].state == BuildNodeState.Cancelled
    assert validate_build_graph(failed_pending)
    parallel_failure: mutable BuildGraph = BuildGraph{nodes: [BuildNode{name: "parallel-a", command: first_command, fingerprint: 5}, BuildNode{name: "parallel-b", command: second_command, fingerprint: 6}], max_parallel: 2}
    assert advance_build_graph(parallel_failure, BuildGraphEvent.Start) == BuildGraphState.Running
    assert advance_build_graph(parallel_failure, BuildGraphEvent.NodeStart, 0) == BuildGraphState.Running
    assert advance_build_graph(parallel_failure, BuildGraphEvent.NodeStart, 1) == BuildGraphState.Running
    parallel_failure_rejected: mutable bool = false
    catch advance_build_graph(parallel_failure, BuildGraphEvent.NodeFailure, 0):
        ok value:
            assert false
        error failure:
            assert failure == BuildContractError.FailureNotReady
            parallel_failure_rejected <- true
    assert parallel_failure_rejected
    active_graph: mutable BuildGraph = BuildGraph{nodes: [first], max_parallel: 1}
    assert advance_build_graph(active_graph, BuildGraphEvent.Start) == BuildGraphState.Running
    assert advance_build_graph(active_graph, BuildGraphEvent.NodeStart, 0) == BuildGraphState.Running
    assert advance_build_graph(active_graph, BuildGraphEvent.Cancel) == BuildGraphState.Cancelling
    assert advance_build_graph(active_graph, BuildGraphEvent.CancelAck) == BuildGraphState.Cancelled
    assert active_graph.active_nodes == 0
    assert active_graph.completed_nodes == 1
    assert validate_build_graph(active_graph)
    cyclic: mutable BuildGraph = BuildGraph{nodes: [BuildNode{name: "a", command: first_command, dependencies: ["b"], fingerprint: 3}, BuildNode{name: "b", command: second_command, fingerprint: 4}]}
    cycle_rejected: mutable bool = false
    catch validate_build_graph(cyclic):
        ok value:
            assert false
        error failure:
            assert failure == BuildContractError.DependencyOrderInvalid
            cycle_rejected <- true
    assert cycle_rejected
    planned_cancel: mutable BuildGraph = BuildGraph{nodes: [first, second], max_parallel: 1}
    assert advance_build_graph(planned_cancel, BuildGraphEvent.Cancel) == BuildGraphState.Cancelled
    assert planned_cancel.completed_nodes == 2
    assert planned_cancel.nodes[0].state == BuildNodeState.Cancelled
    assert planned_cancel.nodes[1].state == BuildNodeState.Cancelled
    assert validate_build_graph(planned_cancel)
    forged_cancelled_failure: mutable bool = false
    catch validate_build_graph(BuildGraph{nodes: [BuildNode{name: "failed", command: first_command, state: BuildNodeState.Failed, fingerprint: 9}], state: BuildGraphState.Cancelled, completed_nodes: 1, failed_nodes: 1}):
        ok value:
            assert false
        error failure:
            assert failure == BuildContractError.NodeAccountingInvalid
            forged_cancelled_failure <- true
    assert forged_cancelled_failure


@test
def typed_build_scheduler_contract_is_deterministic_cache_aware_and_cancelable() -> void:
    first_command: ProcessCommand = ProcessCommand{executable: "tool-a", arguments: []}
    second_command: ProcessCommand = ProcessCommand{executable: "tool-b", arguments: []}
    first: BuildNode = BuildNode{name: "compile", command: first_command, fingerprint: 11}
    second: BuildNode = BuildNode{name: "link", command: second_command, dependencies: ["compile"], fingerprint: 22}
    graph: BuildGraph = BuildGraph{nodes: [first, second], max_parallel: 1}
    cached: BuildCacheEntry = BuildCacheEntry{node_name: "compile", fingerprint: 11}
    scheduler: mutable BuildScheduler = BuildScheduler{graph: graph, cache: [cached]}
    assert validate_build_scheduler(scheduler)
    assert advance_build_scheduler(scheduler, BuildSchedulerEvent.Begin) == BuildSchedulerState.Running
    assert scheduler.ready_queue.count == 1
    assert advance_build_scheduler(scheduler, BuildSchedulerEvent.CacheHit, 0) == BuildSchedulerState.Running
    assert scheduler.completed_nodes == 1
    assert scheduler.cache_hits == 1
    assert scheduler.ready_queue.count == 1
    assert advance_build_scheduler(scheduler, BuildSchedulerEvent.Dispatch, 1) == BuildSchedulerState.Running
    assert scheduler.active_nodes == 1
    assert advance_build_scheduler(scheduler, BuildSchedulerEvent.NodeComplete, 1) == BuildSchedulerState.Running
    assert scheduler.active_nodes == 0
    assert advance_build_scheduler(scheduler, BuildSchedulerEvent.Complete) == BuildSchedulerState.Complete
    completed_cancel_rejected: mutable bool = false
    catch advance_build_scheduler(scheduler, BuildSchedulerEvent.Cancel):
        ok value:
            assert false
        error failure:
            assert failure == BuildSchedulerError.CancelNotReady
            completed_cancel_rejected <- true
    assert completed_cancel_rejected
    forged_scheduler: mutable BuildScheduler = BuildScheduler{graph: scheduler.graph, state: BuildSchedulerState.Complete, completed_nodes: scheduler.completed_nodes - 1}
    forged_scheduler_rejected: mutable bool = false
    catch validate_build_scheduler(forged_scheduler):
        ok value:
            assert false
        error failure:
            assert failure == BuildSchedulerError.NodeAccountingInvalid
            forged_scheduler_rejected <- true
    assert forged_scheduler_rejected
    blocked: mutable bool = false
    catch advance_build_scheduler(scheduler, BuildSchedulerEvent.Refresh):
        ok value:
            assert false
        error failure:
            assert failure == BuildSchedulerError.InvalidState
            blocked <- true
    assert blocked
    unknown_cache: mutable BuildScheduler = BuildScheduler{graph: graph, cache: [BuildCacheEntry{node_name: "missing", fingerprint: 99}]}
    unknown_cache_rejected: mutable bool = false
    catch validate_build_scheduler(unknown_cache):
        ok value:
            assert false
        error failure:
            assert failure == BuildSchedulerError.CacheEntryInvalid
            unknown_cache_rejected <- true
    assert unknown_cache_rejected
    blocked_queue: mutable BuildScheduler = BuildScheduler{graph: graph, ready_queue: [1]}
    blocked_queue_rejected: mutable bool = false
    catch validate_build_scheduler(blocked_queue):
        ok value:
            assert false
        error failure:
            assert failure == BuildSchedulerError.DependencyNotReady
            blocked_queue_rejected <- true
    assert blocked_queue_rejected
    forged_ready_queue: mutable bool = false
    catch validate_build_scheduler(BuildScheduler{graph: BuildGraph{nodes: [first], max_parallel: 1}, ready_queue: [0]}):
        ok value:
            assert false
        error failure:
            assert failure == BuildSchedulerError.NodeAccountingInvalid
            forged_ready_queue <- true
    assert forged_ready_queue
    cache_without_queue: mutable BuildScheduler = BuildScheduler{graph: graph, cache: [cached]}
    assert advance_build_scheduler(cache_without_queue, BuildSchedulerEvent.Begin) == BuildSchedulerState.Running
    cache_without_queue.ready_queue <- []
    cache_without_queue_rejected: mutable bool = false
    catch advance_build_scheduler(cache_without_queue, BuildSchedulerEvent.CacheHit, 0):
        ok value:
            assert false
        error failure:
            assert failure == BuildSchedulerError.NodeNotReady
            cache_without_queue_rejected <- true
    assert cache_without_queue_rejected
    failed_scheduler: mutable BuildScheduler = BuildScheduler{graph: BuildGraph{nodes: [BuildNode{name: "fail-a", command: first_command, fingerprint: 31}, BuildNode{name: "fail-b", command: second_command, fingerprint: 32}], max_parallel: 1}}
    assert advance_build_scheduler(failed_scheduler, BuildSchedulerEvent.Begin) == BuildSchedulerState.Running
    assert advance_build_scheduler(failed_scheduler, BuildSchedulerEvent.Dispatch, 0) == BuildSchedulerState.Running
    assert advance_build_scheduler(failed_scheduler, BuildSchedulerEvent.NodeFail, 0) == BuildSchedulerState.Failed
    assert failed_scheduler.completed_nodes == 2
    assert failed_scheduler.active_nodes == 0
    assert failed_scheduler.ready_queue.count == 0
    assert failed_scheduler.graph.nodes[1].state == BuildNodeState.Cancelled
    assert validate_build_scheduler(failed_scheduler)
    parallel_scheduler: mutable BuildScheduler = BuildScheduler{graph: BuildGraph{nodes: [BuildNode{name: "run-a", command: first_command, fingerprint: 41}, BuildNode{name: "run-b", command: second_command, fingerprint: 42}], max_parallel: 2}}
    assert advance_build_scheduler(parallel_scheduler, BuildSchedulerEvent.Begin) == BuildSchedulerState.Running
    assert advance_build_scheduler(parallel_scheduler, BuildSchedulerEvent.Dispatch, 0) == BuildSchedulerState.Running
    assert advance_build_scheduler(parallel_scheduler, BuildSchedulerEvent.Dispatch, 1) == BuildSchedulerState.Running
    parallel_scheduler_rejected: mutable bool = false
    catch advance_build_scheduler(parallel_scheduler, BuildSchedulerEvent.NodeFail, 0):
        ok value:
            assert false
        error failure:
            assert failure == BuildSchedulerError.FailureNotReady
            parallel_scheduler_rejected <- true
    assert parallel_scheduler_rejected
    active_cancel: mutable BuildScheduler = BuildScheduler{graph: BuildGraph{nodes: [first], max_parallel: 1}}
    assert advance_build_scheduler(active_cancel, BuildSchedulerEvent.Begin) == BuildSchedulerState.Running
    assert advance_build_scheduler(active_cancel, BuildSchedulerEvent.Dispatch, 0) == BuildSchedulerState.Running
    assert advance_build_scheduler(active_cancel, BuildSchedulerEvent.Cancel) == BuildSchedulerState.Cancelling
    assert advance_build_scheduler(active_cancel, BuildSchedulerEvent.CancelAck) == BuildSchedulerState.Cancelled
    assert active_cancel.active_nodes == 0
    assert active_cancel.completed_nodes == 1
    assert validate_build_scheduler(active_cancel)
    fresh_graph: BuildGraph = BuildGraph{nodes: [first, second], max_parallel: 1}
    cancelling: mutable BuildScheduler = BuildScheduler{graph: fresh_graph}
    assert advance_build_scheduler(cancelling, BuildSchedulerEvent.Begin) == BuildSchedulerState.Running
    assert advance_build_scheduler(cancelling, BuildSchedulerEvent.Cancel) == BuildSchedulerState.Cancelling
    assert advance_build_scheduler(cancelling, BuildSchedulerEvent.CancelAck) == BuildSchedulerState.Cancelled
    assert cancelling.completed_nodes == 2
    assert cancelling.ready_queue.count == 0
    assert validate_build_scheduler(cancelling)


@test
def typed_resource_ledger_contract_prevents_double_close_and_owner_confusion() -> void:
    ledger: mutable ResourceLedger = ResourceLedger{max_entries: 4}
    assert resource_ledger_acquire(ledger, 11, ResourceKind.File, 7)
    assert advance_resource_lease(ledger, 11, 7, ResourceEvent.BeginClose) == ResourceLeaseState.Closing
    assert advance_resource_lease(ledger, 11, 7, ResourceEvent.CompleteClose) == ResourceLeaseState.Released
    wrong_owner: mutable bool = false
    catch advance_resource_lease(ledger, 11, 8, ResourceEvent.BeginClose):
        ok value:
            assert false
        error failure:
            assert failure == ResourceContractError.OwnerMismatch
            wrong_owner <- true
    assert wrong_owner
    assert resource_ledger_acquire(ledger, 12, ResourceKind.Process, 9)
    assert advance_resource_lease(ledger, 12, 9, ResourceEvent.Abandon) == ResourceLeaseState.Failed
    double_close: mutable bool = false
    catch advance_resource_lease(ledger, 12, 9, ResourceEvent.CompleteClose):
        ok value:
            assert false
        error failure:
            assert failure == ResourceContractError.InvalidTransition
            double_close <- true
    assert double_close


@test
def typed_value_ownership_contract_bounds_borrows_moves_and_reclamation() -> void:
    ledger: mutable ValueOwnershipLedger = ValueOwnershipLedger{policy: ValueOwnershipPolicy{max_values: 4, max_borrows: 4, max_bytes: 32}}
    assert value_ownership_acquire(ledger, ValueLease{value_id: 11, arena_id: 1, owner_token: 7, generation: 1, kind: ValueOwnershipKind.Linear, bytes: 8})
    assert value_ownership_acquire(ledger, ValueLease{value_id: 12, arena_id: 1, owner_token: 7, generation: 1, kind: ValueOwnershipKind.Copyable, bytes: 4})
    borrow: BorrowLease = BorrowLease{borrow_id: 101, value_id: 0, borrower_token: 9, source_generation: 0, expires_at: 10}
    assert advance_value_ownership(ledger, ValueOwnershipEvent.BeginBorrow, 12, 7, borrow) == ValueOwnershipState.Borrowed
    move_blocked: mutable bool = false
    catch advance_value_ownership(ledger, ValueOwnershipEvent.Move, 12, 7, BorrowLease{}, 8):
        ok value:
            assert false
        error failure:
            assert failure == ValueOwnershipError.MoveNotReady
            move_blocked <- true
    assert move_blocked
    assert advance_value_ownership(ledger, ValueOwnershipEvent.EndBorrow, 0, 9, BorrowLease{borrow_id: 101, value_id: 0, borrower_token: 0, source_generation: 0, expires_at: 0}) == ValueOwnershipState.Owned
    assert advance_value_ownership(ledger, ValueOwnershipEvent.Move, 12, 7, BorrowLease{}, 8) == ValueOwnershipState.Owned
    assert ledger.values[1].owner_token == 8
    assert advance_value_ownership(ledger, ValueOwnershipEvent.Drop, 11, 7) == ValueOwnershipState.Dropped
    assert ledger.active_values == 1
    assert ledger.retained_bytes == 4
    forged_borrow: mutable ValueOwnershipLedger = ValueOwnershipLedger{policy: ValueOwnershipPolicy{max_values: 2, max_borrows: 2, max_bytes: 8}}
    assert value_ownership_acquire(forged_borrow, ValueLease{value_id: 21, arena_id: 1, owner_token: 7, generation: 1, kind: ValueOwnershipKind.Copyable, bytes: 2})
    forged_borrow.borrows.push(BorrowLease{borrow_id: 201, value_id: 21, borrower_token: 9, source_generation: 1, expires_at: 10})
    forged_borrow.active_borrows <- 1
    borrow_state_rejected: mutable bool = false
    catch validate_value_ownership(forged_borrow):
        ok value:
            assert false
        error failure:
            assert failure == ValueOwnershipError.BorrowConflict
            borrow_state_rejected <- true
    assert borrow_state_rejected
    forged_value: mutable ValueOwnershipLedger = ValueOwnershipLedger{policy: ValueOwnershipPolicy{max_values: 2, max_borrows: 2, max_bytes: 8}}
    assert value_ownership_acquire(forged_value, ValueLease{value_id: 22, arena_id: 1, owner_token: 7, generation: 1, kind: ValueOwnershipKind.Copyable, bytes: 2})
    forged_value.values[0].state <- ValueOwnershipState.Borrowed
    missing_borrow_rejected: mutable bool = false
    catch validate_value_ownership(forged_value):
        ok value:
            assert false
        error failure:
            assert failure == ValueOwnershipError.BorrowConflict
            missing_borrow_rejected <- true
    assert missing_borrow_rejected
    dropped_payload_rejected: mutable bool = false
    catch validate_value_ownership(ValueOwnershipLedger{policy: ValueOwnershipPolicy{max_values: 2, max_borrows: 2, max_bytes: 8}, values: [ValueLease{value_id: 23, arena_id: 1, owner_token: 7, bytes: 2, state: ValueOwnershipState.Dropped}], retained_bytes: 2}):
        ok value:
            assert false
        error failure:
            assert failure == ValueOwnershipError.AccountingInvalid
            dropped_payload_rejected <- true
    assert dropped_payload_rejected
    forged_admission: mutable ValueOwnershipLedger = ValueOwnershipLedger{policy: ValueOwnershipPolicy{max_values: 2, max_borrows: 2, max_bytes: 8}}
    forged_admission_rejected: mutable bool = false
    catch value_ownership_acquire(forged_admission, ValueLease{value_id: 24, arena_id: 1, owner_token: 7, generation: 1, kind: ValueOwnershipKind.Copyable, bytes: 2, state: ValueOwnershipState.Borrowed}):
        ok value:
            assert false
        error failure:
            assert failure == ValueOwnershipError.InvalidState
            forged_admission_rejected <- true
    assert forged_admission_rejected
    ended_lease: mutable ValueOwnershipLedger = ValueOwnershipLedger{policy: ValueOwnershipPolicy{max_values: 2, max_borrows: 2, max_bytes: 8}}
    assert value_ownership_acquire(ended_lease, ValueLease{value_id: 25, arena_id: 1, owner_token: 7, generation: 1, kind: ValueOwnershipKind.Copyable, bytes: 2})
    ended_borrow_rejected: mutable bool = false
    catch advance_value_ownership(ended_lease, ValueOwnershipEvent.BeginBorrow, 25, 7, BorrowLease{borrow_id: 202, borrower_token: 9, expires_at: 10, state: BorrowLeaseState.Ended}):
        ok value:
            assert false
        error failure:
            assert failure == ValueOwnershipError.InvalidState
            ended_borrow_rejected <- true
    assert ended_borrow_rejected


@test
def typed_error_provenance_contract_preserves_origin_and_cause() -> void:
    ledger: mutable ErrorProvenanceLedger = ErrorProvenanceLedger{policy: ErrorProvenancePolicy{max_envelopes: 4, max_text_bytes: 128, max_cause_depth: 4, preserve_cause: true}}
    host_error: ErrorProvenance = ErrorProvenance{origin: ErrorOrigin.Host, phase: ErrorPhase.HostBoundary, code: 7, message: "spawn failed"}
    assert error_provenance_capture(ledger, 1, host_error)
    script_error: ErrorProvenance = ErrorProvenance{origin: ErrorOrigin.Script, phase: ErrorPhase.Runtime, code: 8, message: "script raised", cause_id: 1}
    assert error_provenance_capture(ledger, 2, script_error)
    assert advance_error_provenance(ledger, ErrorProvenanceEvent.Forward, 2) == ErrorEnvelopeState.Forwarded
    assert advance_error_provenance(ledger, ErrorProvenanceEvent.Handle, 2) == ErrorEnvelopeState.Handled
    assert advance_error_provenance(ledger, ErrorProvenanceEvent.Cancel, 1) == ErrorEnvelopeState.Cancelled
    invalid_cause: mutable bool = false
    catch error_provenance_capture(ledger, 3, ErrorProvenance{origin: ErrorOrigin.Script, phase: ErrorPhase.Runtime, code: 9, message: "future", cause_id: 4}):
        ok value:
            assert false
        error failure:
            assert failure == ErrorProvenanceError.InvalidCause
            invalid_cause <- true
    assert invalid_cause
    forged_forward_history: mutable bool = false
    catch validate_error_provenance(ErrorProvenanceLedger{policy: ErrorProvenancePolicy{max_envelopes: 4, max_text_bytes: 128, max_cause_depth: 4, preserve_cause: true}, envelopes: [ErrorEnvelope{envelope_id: 1, provenance: host_error, state: ErrorEnvelopeState.Captured, forward_count: 1}], retained_bytes: sview_len(host_error.message)}):
        ok value:
            assert false
        error failure:
            assert failure == ErrorProvenanceError.InvalidState
            forged_forward_history <- true
    assert forged_forward_history


@test
def typed_cancellation_contract_polls_and_denies_blocking_work() -> void:
    ledger: mutable CancellationLedger = CancellationLedger{policy: CancellationPolicy{max_tokens: 4, max_children: 2, max_polls_per_token: 8, max_reason_bytes: 64}}
    assert cancellation_register(ledger, 1, 0, 7, "shutdown")
    assert cancellation_register(ledger, 2, 1, 7, "child shutdown")
    assert advance_cancellation(ledger, 1, 7, CancellationEvent.Request) == CancellationTokenState.Requested
    assert poll_cancellation(ledger, 1, 7, CancellationPoint.VmSafePoint) == CancellationTokenState.Propagating
    assert advance_cancellation(ledger, 2, 7, CancellationEvent.Request) == CancellationTokenState.Requested
    assert advance_cancellation(ledger, 2, 7, CancellationEvent.Propagate) == CancellationTokenState.Propagating
    denied: mutable bool = false
    catch poll_cancellation(ledger, 2, 7, CancellationPoint.HostBeforeBlock):
        ok value:
            assert false
        error failure:
            assert failure == CancellationError.HostBlockDenied
            denied <- true
    assert denied
    assert ledger.tokens[1].state == CancellationTokenState.Propagating
    assert ledger.tokens[1].poll_count == 1
    assert ledger.tokens[1].last_point == CancellationPoint.VmSafePoint
    assert poll_cancellation(ledger, 2, 7, CancellationPoint.Cleanup) == CancellationTokenState.Propagating
    assert advance_cancellation(ledger, 2, 7, CancellationEvent.Acknowledge) == CancellationTokenState.Acknowledged
    assert advance_cancellation(ledger, 2, 7, CancellationEvent.Complete) == CancellationTokenState.Completed
    bad_parent: mutable bool = false
    catch cancellation_register(ledger, 3, 99, 7, "orphan"):
        ok value:
            assert false
        error failure:
            assert failure == CancellationError.ParentMissing
            bad_parent <- true
    assert bad_parent
    child_first: mutable CancellationLedger = CancellationLedger{policy: CancellationPolicy{max_tokens: 4, max_children: 2, max_polls_per_token: 8, max_reason_bytes: 64}}
    assert cancellation_register(child_first, 10, 0, 7, "parent")
    assert cancellation_register(child_first, 11, 10, 7, "child")
    assert advance_cancellation(child_first, 11, 7, CancellationEvent.Request) == CancellationTokenState.Requested
    child_first_rejected: mutable bool = false
    catch poll_cancellation(child_first, 11, 7, CancellationPoint.VmSafePoint):
        ok value:
            assert false
        error failure:
            assert failure == CancellationError.InvalidTransition
            child_first_rejected <- true
    assert child_first_rejected
    terminal_parent: mutable CancellationLedger = CancellationLedger{policy: CancellationPolicy{max_tokens: 4, max_children: 2, max_polls_per_token: 8, max_reason_bytes: 64}}
    assert cancellation_register(terminal_parent, 20, 0, 7, "terminal parent")
    assert advance_cancellation(terminal_parent, 20, 7, CancellationEvent.Request) == CancellationTokenState.Requested
    assert advance_cancellation(terminal_parent, 20, 7, CancellationEvent.Fail) == CancellationTokenState.Failed
    terminal_parent_rejected: mutable bool = false
    catch cancellation_register(terminal_parent, 21, 20, 7, "stranded child"):
        ok value:
            assert false
        error failure:
            assert failure == CancellationError.InvalidTransition
            terminal_parent_rejected <- true
    assert terminal_parent_rejected
    forged_ack: mutable bool = false
    catch validate_cancellation_ledger(CancellationLedger{policy: CancellationPolicy{max_tokens: 4, max_children: 2, max_polls_per_token: 8, max_reason_bytes: 64}, tokens: [CancellationToken{id: 4, owner_token: 7, state: CancellationTokenState.Acknowledged}], acknowledged_tokens: 1}):
        ok value:
            assert false
        error failure:
            assert failure == CancellationError.InvalidTransition
            forged_ack <- true
    assert forged_ack


@test
def typed_telemetry_contract_bounds_metrics_spans_and_sampling() -> void:
    ledger: mutable TelemetryLedger = TelemetryLedger{policy: TelemetryPolicy{mode: TelemetryMode.Events, max_metrics: 2, max_events: 4, max_name_bytes: 64, max_payload_bytes: 16, max_spans: 2, sample_every: 2}}
    assert advance_telemetry(ledger, TelemetryEvent.BeginRun) == TelemetryState.Running
    assert telemetry_record_metric(ledger, 1, "steps", 3)
    assert telemetry_append_event(ledger, 11, 0, TelemetryEventKind.SpanBegin, "run", 1, 0) == TelemetryRecordOutcome.Sampled
    assert ledger.active_spans == 1
    assert telemetry_append_event(ledger, 12, 11, TelemetryEventKind.Error, "failure", 2, 4) == TelemetryRecordOutcome.Recorded
    assert telemetry_append_event(ledger, 11, 0, TelemetryEventKind.SpanEnd, "run", 3, 0) == TelemetryRecordOutcome.Sampled
    assert ledger.active_spans == 0
    assert advance_telemetry(ledger, TelemetryEvent.EndRun) == TelemetryState.Sealed
    post_seal: mutable bool = false
    catch telemetry_record_metric(ledger, 1, "steps", 1):
        ok value:
            assert false
        error failure:
            assert failure == TelemetryError.InvalidState
            post_seal <- true
    assert post_seal
    failed_telemetry: mutable TelemetryLedger = TelemetryLedger{policy: TelemetryPolicy{mode: TelemetryMode.CountersOnly}}
    assert advance_telemetry(failed_telemetry, TelemetryEvent.BeginRun) == TelemetryState.Running
    assert advance_telemetry(failed_telemetry, TelemetryEvent.Fail) == TelemetryState.Failed
    repeated_failure: mutable bool = false
    catch advance_telemetry(failed_telemetry, TelemetryEvent.Fail):
        ok value:
            assert false
        error failure:
            assert failure == TelemetryError.InvalidTransition
            repeated_failure <- true
    assert repeated_failure
    disabled: mutable TelemetryLedger = TelemetryLedger{policy: TelemetryPolicy{mode: TelemetryMode.Disabled}}
    disabled_error: mutable bool = false
    catch telemetry_record_metric(disabled, 1, "steps", 1):
        ok value:
            assert false
        error failure:
            assert failure == TelemetryError.TelemetryDisabled
            disabled_error <- true
    assert disabled_error
    forged: mutable TelemetryLedger = TelemetryLedger{policy: TelemetryPolicy{mode: TelemetryMode.Events, max_events: 4, max_name_bytes: 64, max_payload_bytes: 16, max_spans: 2}, state: TelemetryState.Ready, next_sequence: 2}
    forged_error: mutable bool = false
    catch validate_telemetry_ledger(forged):
        ok value:
            assert false
        error failure:
            assert failure == TelemetryError.AccountingInvalid
            forged_error <- true
    assert forged_error
    forged_sequence_gap: mutable bool = false
    catch validate_telemetry_ledger(TelemetryLedger{policy: TelemetryPolicy{mode: TelemetryMode.Events, max_events: 4, max_name_bytes: 64, max_payload_bytes: 16, max_spans: 2}, state: TelemetryState.Running, events: [TelemetryTraceEvent{sequence: 1, trace_id: 31, kind: TelemetryEventKind.Error, name: "first"}, TelemetryTraceEvent{sequence: 3, trace_id: 32, kind: TelemetryEventKind.Error, name: "third"}], next_sequence: 3}):
        ok value:
            assert false
        error failure:
            assert failure == TelemetryError.SequenceExhausted
            forged_sequence_gap <- true
    assert forged_sequence_gap
    invalid_payload_policy: mutable bool = false
    catch validate_telemetry_ledger(TelemetryLedger{policy: TelemetryPolicy{mode: TelemetryMode.Events, max_payload_bytes: 0}}):
        ok value:
            assert false
        error failure:
            assert failure == TelemetryError.InvalidPolicy
            invalid_payload_policy <- true
    assert invalid_payload_policy
    telemetry_event_ceiling_is_atomic: mutable TelemetryLedger = TelemetryLedger{policy: TelemetryPolicy{mode: TelemetryMode.Events, max_events: 2, max_name_bytes: 64, max_payload_bytes: 16, max_spans: 2, sample_every: 2}}
    assert advance_telemetry(telemetry_event_ceiling_is_atomic, TelemetryEvent.BeginRun) == TelemetryState.Running
    assert telemetry_append_event(telemetry_event_ceiling_is_atomic, 21, 0, TelemetryEventKind.Error, "first", 1, 0) == TelemetryRecordOutcome.Sampled
    assert telemetry_append_event(telemetry_event_ceiling_is_atomic, 22, 0, TelemetryEventKind.Error, "second", 2, 0) == TelemetryRecordOutcome.Recorded
    ceiling_rejected: mutable bool = false
    catch telemetry_append_event(telemetry_event_ceiling_is_atomic, 23, 0, TelemetryEventKind.Error, "third", 3, 0):
        ok value:
            assert false
        error failure:
            assert failure == TelemetryError.EventLimitExceeded
            ceiling_rejected <- true
    assert ceiling_rejected
    assert telemetry_event_ceiling_is_atomic.events.count == 1
    assert telemetry_event_ceiling_is_atomic.sampled_events == 1
    assert telemetry_event_ceiling_is_atomic.next_sequence == 3


@test
def typed_structured_task_contract_shields_cleanup_before_join() -> void:
    scope: mutable StructuredTaskScope = StructuredTaskScope{policy: StructuredTaskPolicy{max_children: 4, max_cleanup_depth: 2, fail_fast: true}}
    assert advance_structured_task(scope, StructuredTaskEvent.Begin) == StructuredScopeState.Running
    assert structured_task_spawn(scope, 1, 7)
    assert structured_task_spawn(scope, 2, 7)
    assert advance_structured_task(scope, StructuredTaskEvent.ChildStart, 1, 7) == StructuredScopeState.Running
    assert advance_structured_task(scope, StructuredTaskEvent.ChildStart, 2, 7) == StructuredScopeState.Running
    assert advance_structured_task(scope, StructuredTaskEvent.ChildFail, 1, 7, 9) == StructuredScopeState.Cancelling
    assert advance_structured_task(scope, StructuredTaskEvent.RequestChildCancel, 2, 7) == StructuredScopeState.Cancelling
    assert advance_structured_task(scope, StructuredTaskEvent.EnterCleanup, 2, 7) == StructuredScopeState.Cancelling
    shielded: mutable bool = false
    catch advance_structured_task(scope, StructuredTaskEvent.ChildCancelAck, 2, 7):
        ok value:
            assert false
        error failure:
            assert failure == StructuredTaskError.CancellationShielded
            shielded <- true
    assert shielded
    assert advance_structured_task(scope, StructuredTaskEvent.LeaveCleanup, 2, 7) == StructuredScopeState.Cancelling
    assert advance_structured_task(scope, StructuredTaskEvent.ChildCancelAck, 2, 7) == StructuredScopeState.Cancelling
    assert advance_structured_task(scope, StructuredTaskEvent.Join) == StructuredScopeState.Failed
    joining_start_rejected: mutable bool = false
    catch advance_structured_task(StructuredTaskScope{policy: StructuredTaskPolicy{max_children: 2, max_cleanup_depth: 1}, state: StructuredScopeState.Joining}, StructuredTaskEvent.ChildStart, 8, 7):
        ok value:
            assert false
        error failure:
            assert failure == StructuredTaskError.InvalidTransition
            joining_start_rejected <- true
    assert joining_start_rejected
    joining_cancel_rejected: mutable bool = false
    catch advance_structured_task(StructuredTaskScope{policy: StructuredTaskPolicy{max_children: 2, max_cleanup_depth: 1}, state: StructuredScopeState.Joining}, StructuredTaskEvent.RequestCancel):
        ok value:
            assert false
        error failure:
            assert failure == StructuredTaskError.InvalidTransition
            joining_cancel_rejected <- true
    assert joining_cancel_rejected
    cancel_scope: mutable StructuredTaskScope = StructuredTaskScope{policy: StructuredTaskPolicy{max_children: 2, max_cleanup_depth: 1, fail_fast: false}}
    assert advance_structured_task(cancel_scope, StructuredTaskEvent.Begin) == StructuredScopeState.Running
    assert structured_task_spawn(cancel_scope, 3, 8)
    assert advance_structured_task(cancel_scope, StructuredTaskEvent.ChildStart, 3, 8) == StructuredScopeState.Running
    assert advance_structured_task(cancel_scope, StructuredTaskEvent.RequestCancel) == StructuredScopeState.Cancelling
    assert advance_structured_task(cancel_scope, StructuredTaskEvent.RequestChildCancel, 3, 8) == StructuredScopeState.Cancelling
    assert advance_structured_task(cancel_scope, StructuredTaskEvent.ChildCancelAck, 3, 8) == StructuredScopeState.Cancelling
    assert advance_structured_task(cancel_scope, StructuredTaskEvent.Join) == StructuredScopeState.Cancelled
    pending_scope: mutable StructuredTaskScope = StructuredTaskScope{policy: StructuredTaskPolicy{max_children: 2, max_cleanup_depth: 1, fail_fast: false}}
    assert advance_structured_task(pending_scope, StructuredTaskEvent.Begin) == StructuredScopeState.Running
    assert structured_task_spawn(pending_scope, 4, 8)
    pending_join: mutable bool = false
    catch advance_structured_task(pending_scope, StructuredTaskEvent.Join):
        ok value:
            assert false
        error failure:
            assert failure == StructuredTaskError.JoinNotReady
            pending_join <- true
    assert pending_join
    fail_pending_scope: mutable StructuredTaskScope = StructuredTaskScope{policy: StructuredTaskPolicy{max_children: 2, max_cleanup_depth: 1, fail_fast: false}}
    assert advance_structured_task(fail_pending_scope, StructuredTaskEvent.Begin) == StructuredScopeState.Running
    assert structured_task_spawn(fail_pending_scope, 5, 8)
    fail_pending_rejected: mutable bool = false
    catch advance_structured_task(fail_pending_scope, StructuredTaskEvent.Fail):
        ok value:
            assert false
        error failure:
            assert failure == StructuredTaskError.JoinNotReady
            fail_pending_rejected <- true
    assert fail_pending_rejected
    assert validate_structured_task_scope(fail_pending_scope)
    forged_scope: mutable StructuredTaskScope = StructuredTaskScope{policy: StructuredTaskPolicy{max_children: 2, max_cleanup_depth: 2}, children: [StructuredChild{child_id: 7, owner_token: 3}]}
    forged_scope_error: mutable bool = false
    catch validate_structured_task_scope(forged_scope):
        ok value:
            assert false
        error failure:
            assert failure == StructuredTaskError.AccountingInvalid
            forged_scope_error <- true
    assert forged_scope_error
    forged_depth: mutable StructuredTaskScope = StructuredTaskScope{policy: StructuredTaskPolicy{max_children: 2, max_cleanup_depth: 2}, state: StructuredScopeState.Running, children: [StructuredChild{child_id: 8, owner_token: 3, state: StructuredChildState.Succeeded, cleanup_depth: 1}], completed_children: 1}
    forged_depth_error: mutable bool = false
    catch validate_structured_task_scope(forged_depth):
        ok value:
            assert false
        error failure:
            assert failure == StructuredTaskError.CleanupDepthInvalid
            forged_depth_error <- true
    assert forged_depth_error
    forged_terminal: mutable bool = false
    catch validate_structured_task_scope(StructuredTaskScope{policy: StructuredTaskPolicy{max_children: 2, max_cleanup_depth: 2}, state: StructuredScopeState.Succeeded, children: [StructuredChild{child_id: 9, owner_token: 3}]}):
        ok value:
            assert false
        error failure:
            assert failure == StructuredTaskError.AccountingInvalid
            forged_terminal <- true
    assert forged_terminal
    forged_failed_active: mutable bool = false
    catch validate_structured_task_scope(StructuredTaskScope{policy: StructuredTaskPolicy{max_children: 2, max_cleanup_depth: 2}, state: StructuredScopeState.Failed, children: [StructuredChild{child_id: 10, owner_token: 3, state: StructuredChildState.Running}], active_children: 1}):
        ok value:
            assert false
        error failure:
            assert failure == StructuredTaskError.AccountingInvalid
            forged_failed_active <- true
    assert forged_failed_active
    forged_failed_planned: mutable bool = false
    catch validate_structured_task_scope(StructuredTaskScope{policy: StructuredTaskPolicy{max_children: 2, max_cleanup_depth: 2}, state: StructuredScopeState.Failed, children: [StructuredChild{child_id: 11, owner_token: 3, state: StructuredChildState.Planned}]}):
        ok value:
            assert false
        error failure:
            assert failure == StructuredTaskError.AccountingInvalid
            forged_failed_planned <- true
    assert forged_failed_planned


@test
def typed_exit_status_contract_maps_user_failures_and_signals() -> void:
    assert exit_status_code(ExitStatus{outcome: ExitOutcome.Success}) == EXIT_CODE_SUCCESS
    assert exit_status_code(ExitStatus{outcome: ExitOutcome.User, user_code: 17}) == 17
    assert exit_status_code(ExitStatus{outcome: ExitOutcome.SourceError, detail_code: 12}) == EXIT_CODE_SOURCE
    assert exit_status_code(ExitStatus{outcome: ExitOutcome.Signal, signal: 9}) == 137
    negative_user: mutable bool = false
    catch exit_status_code(ExitStatus{outcome: ExitOutcome.User, user_code: -1}):
        ok value:
            assert false
        error failure:
            assert failure == ExitStatusError.InvalidUserCode
            negative_user <- true
    assert negative_user
    invalid_signal: mutable bool = false
    catch exit_status_code(ExitStatus{outcome: ExitOutcome.Signal, signal: 65}):
        ok value:
            assert false
        error failure:
            assert failure == ExitStatusError.InvalidSignal
            invalid_signal <- true
    assert invalid_signal
    invalid_detail: mutable bool = false
    catch exit_status_code(ExitStatus{outcome: ExitOutcome.Success, detail_code: 1}):
        ok value:
            assert false
        error failure:
            assert failure == ExitStatusError.InvalidDetail
            invalid_detail <- true
    assert invalid_detail


@test
def typed_deadline_contract_is_monotonic_and_fireable_in_virtual_time() -> void:
    clock: mutable DeadlineClock = DeadlineClock{policy: DeadlinePolicy{mode: DeadlineClockMode.Virtual, max_waits: 2, max_advance: 10}}
    assert deadline_arm(clock, 1, 7, 5)
    assert deadline_advance(clock, 3) == 3
    not_due: mutable bool = false
    catch deadline_fire(clock, 1, 7):
        ok value:
            assert false
        error failure:
            assert failure == DeadlineError.NoDueWait
            not_due <- true
    assert not_due
    assert deadline_advance(clock, 2) == 5
    assert deadline_fire(clock, 1, 7) == DeadlineWaitState.Ready
    assert deadline_arm(clock, 2, 7, 12)
    assert deadline_cancel(clock, 2, 7) == DeadlineWaitState.Cancelled
    assert advance_deadline_event(clock, DeadlineEvent.Seal)
    too_large: mutable bool = false
    unsealed: mutable DeadlineClock = DeadlineClock{policy: DeadlinePolicy{mode: DeadlineClockMode.HostMonotonic, max_waits: 1, max_advance: 4}}
    catch deadline_advance(unsealed, 5):
        ok value:
            assert false
        error failure:
            assert failure == DeadlineError.AdvanceLimitExceeded
            too_large <- true
    assert too_large
    order_clock: mutable DeadlineClock = DeadlineClock{policy: DeadlinePolicy{mode: DeadlineClockMode.Virtual, max_waits: 2, max_advance: 10}}
    assert deadline_arm(order_clock, 9, 7, 8)
    assert deadline_arm(order_clock, 10, 7, 6)
    assert deadline_advance(order_clock, 8) == 8
    out_of_order: mutable bool = false
    catch deadline_fire(order_clock, 9, 7):
        ok value:
            assert false
        error failure:
            assert failure == DeadlineError.FireOrderInvalid
            out_of_order <- true
    assert out_of_order
    assert deadline_fire(order_clock, 10, 7) == DeadlineWaitState.Ready
    assert deadline_fire(order_clock, 9, 7) == DeadlineWaitState.Ready
    forged_ready: mutable bool = false
    catch validate_deadline_clock(DeadlineClock{policy: DeadlinePolicy{mode: DeadlineClockMode.Virtual, max_waits: 1, max_advance: 4}, now: 3, waits: [DeadlineWait{wait_id: 11, owner_token: 7, deadline: 4, state: DeadlineWaitState.Ready}], ready_waits: 1}):
        ok value:
            assert false
        error failure:
            assert failure == DeadlineError.InvalidTransition
            forged_ready <- true
    assert forged_ready


@test
def typed_debugger_contract_controls_breakpoints_frames_and_replay() -> void:
    session: mutable DebuggerSession = DebuggerSession{policy: DebuggerPolicy{max_breakpoints: 2, max_frames: 4, max_branches: 2, max_name_bytes: 64}, branches: [DebuggerBranch{branch_id: 1, choice_count: 2}]}
    assert debugger_set_breakpoint(session, DebuggerBreakpoint{breakpoint_id: 10, file: "main.elisascript", line: 4, column: 1})
    assert advance_debugger(session, DebuggerEvent.Attach) == DebuggerState.Paused
    assert advance_debugger(session, DebuggerEvent.SelectBranch, 1) == DebuggerState.Paused
    assert advance_debugger(session, DebuggerEvent.Continue) == DebuggerState.Running
    assert debugger_push_frame(session, DebuggerFrame{frame_id: 20, function: "main", file: "main.elisascript", line: 4, column: 1, handler_depth: 1, continuation_depth: 1})
    assert advance_debugger(session, DebuggerEvent.Pause) == DebuggerState.Paused
    assert advance_debugger(session, DebuggerEvent.Step) == DebuggerState.Stepping
    assert advance_debugger(session, DebuggerEvent.PopFrame) == DebuggerState.Stepping
    assert advance_debugger(session, DebuggerEvent.Pause) == DebuggerState.Paused
    assert advance_debugger(session, DebuggerEvent.Terminate) == DebuggerState.Terminated
    post_terminate: mutable bool = false
    catch advance_debugger(session, DebuggerEvent.Step):
        ok value:
            assert false
        error failure:
            assert failure == DebuggerError.InvalidTransition
            post_terminate <- true
    assert post_terminate
    detached_failure: mutable bool = false
    catch advance_debugger(DebuggerSession{policy: DebuggerPolicy{max_breakpoints: 1, max_frames: 2, max_branches: 1, max_name_bytes: 32}}, DebuggerEvent.Fail):
        ok value:
            assert false
        error failure:
            assert failure == DebuggerError.InvalidTransition
            detached_failure <- true
    assert detached_failure
    failed_session: mutable DebuggerSession = DebuggerSession{policy: DebuggerPolicy{max_breakpoints: 1, max_frames: 2, max_branches: 1, max_name_bytes: 32}}
    assert advance_debugger(failed_session, DebuggerEvent.Attach) == DebuggerState.Paused
    assert advance_debugger(failed_session, DebuggerEvent.Fail) == DebuggerState.Failed
    failed_termination: mutable bool = false
    catch advance_debugger(failed_session, DebuggerEvent.Terminate):
        ok value:
            assert false
        error failure:
            assert failure == DebuggerError.InvalidTransition
            failed_termination <- true
    assert failed_termination
    detached_frame: mutable DebuggerSession = DebuggerSession{policy: DebuggerPolicy{max_breakpoints: 1, max_frames: 2, max_branches: 1, max_name_bytes: 32}, frames: [DebuggerFrame{frame_id: 1, function: "main", file: "main.elisascript", line: 1, column: 1}]}
    detached_frame_error: mutable bool = false
    catch validate_debugger_session(detached_frame):
        ok value:
            assert false
        error failure:
            assert failure == DebuggerError.InvalidState
            detached_frame_error <- true
    assert detached_frame_error
    invalid_branch: mutable DebuggerSession = DebuggerSession{policy: DebuggerPolicy{max_breakpoints: 1, max_frames: 2, max_branches: 1, max_name_bytes: 32}, branches: [DebuggerBranch{branch_id: 2}]}
    invalid_branch_error: mutable bool = false
    catch validate_debugger_session(invalid_branch):
        ok value:
            assert false
        error failure:
            assert failure == DebuggerError.InvalidBranch
            invalid_branch_error <- true
    assert invalid_branch_error
    branch_cycle: mutable bool = false
    catch validate_debugger_session(DebuggerSession{policy: DebuggerPolicy{max_breakpoints: 1, max_frames: 2, max_branches: 2, max_name_bytes: 32}, branches: [DebuggerBranch{branch_id: 3, parent_id: 4, choice_count: 1}, DebuggerBranch{branch_id: 4, parent_id: 3, choice_count: 1}]}):
        ok value:
            assert false
        error failure:
            assert failure == DebuggerError.BranchCycle
            branch_cycle <- true
    assert branch_cycle


@test
def typed_archive_contract_rejects_traversal_and_links_before_commit() -> void:
    session: mutable ArchiveSession = ArchiveSession{policy: ArchivePolicy{kind: ArchiveKind.Zip, max_entries: 4, max_path_bytes: 64, max_entry_bytes: 32, max_total_bytes: 64, links: ArchiveLinkPolicy.Reject, overwrite: ArchiveOverwritePolicy.Fail}}
    assert advance_archive(session, ArchiveEvent.Begin) == ArchiveSessionState.Extracting
    assert archive_admit_entry(session, ArchiveEntry{entry_id: 1, path: "bin/tool", kind: ArchiveEntryKind.File, size: 8})
    assert archive_admit_entry(session, ArchiveEntry{entry_id: 2, path: "bin", kind: ArchiveEntryKind.Directory})
    assert advance_archive(session, ArchiveEvent.Commit) == ArchiveSessionState.Committed
    traversal: mutable ArchiveSession = ArchiveSession{policy: ArchivePolicy{max_entries: 2, max_path_bytes: 64, max_entry_bytes: 16, max_total_bytes: 32}}
    assert advance_archive(traversal, ArchiveEvent.Begin) == ArchiveSessionState.Extracting
    traversal_rejected: mutable bool = false
    catch archive_admit_entry(traversal, ArchiveEntry{entry_id: 3, path: "../escape", kind: ArchiveEntryKind.File, size: 1}):
        ok value:
            assert false
        error failure:
            assert failure == ArchiveError.TraversalPath
            traversal_rejected <- true
    assert traversal_rejected
    links: mutable ArchiveSession = ArchiveSession{policy: ArchivePolicy{max_entries: 2, max_path_bytes: 64, max_entry_bytes: 16, max_total_bytes: 32, links: ArchiveLinkPolicy.Reject}}
    assert advance_archive(links, ArchiveEvent.Begin) == ArchiveSessionState.Extracting
    link_rejected: mutable bool = false
    catch archive_admit_entry(links, ArchiveEntry{entry_id: 4, path: "link", kind: ArchiveEntryKind.Symlink, target: "target"}):
        ok value:
            assert false
        error failure:
            assert failure == ArchiveError.LinkRejected
            link_rejected <- true
    assert link_rejected
    target_on_file: mutable ArchiveSession = ArchiveSession{policy: ArchivePolicy{max_entries: 2, max_path_bytes: 64, max_entry_bytes: 16, max_total_bytes: 32}}
    assert advance_archive(target_on_file, ArchiveEvent.Begin) == ArchiveSessionState.Extracting
    target_rejected: mutable bool = false
    catch archive_admit_entry(target_on_file, ArchiveEntry{entry_id: 5, path: "regular", kind: ArchiveEntryKind.File, target: "unexpected"}):
        ok value:
            assert false
        error failure:
            assert failure == ArchiveError.TargetInvalid
            target_rejected <- true
    assert target_rejected
    planned_failure: mutable bool = false
    catch advance_archive(ArchiveSession{policy: ArchivePolicy{max_entries: 1, max_path_bytes: 64, max_entry_bytes: 16, max_total_bytes: 32}}, ArchiveEvent.Fail):
        ok value:
            assert false
        error failure:
            assert failure == ArchiveError.InvalidTransition
            planned_failure <- true
    assert planned_failure
    failed_archive: mutable ArchiveSession = ArchiveSession{policy: ArchivePolicy{max_entries: 1, max_path_bytes: 64, max_entry_bytes: 16, max_total_bytes: 32}}
    assert advance_archive(failed_archive, ArchiveEvent.Begin) == ArchiveSessionState.Extracting
    assert advance_archive(failed_archive, ArchiveEvent.Fail) == ArchiveSessionState.Failed
    repeated_failure: mutable bool = false
    catch advance_archive(failed_archive, ArchiveEvent.Fail):
        ok value:
            assert false
        error failure:
            assert failure == ArchiveError.InvalidTransition
            repeated_failure <- true
    assert repeated_failure
    forged: mutable ArchiveSession = ArchiveSession{policy: ArchivePolicy{max_entries: 2, max_path_bytes: 64, max_entry_bytes: 16, max_total_bytes: 32}, entries: [ArchiveEntry{entry_id: 9, path: "preloaded", kind: ArchiveEntryKind.File, size: 1}], total_bytes: 1}
    forged_error: mutable bool = false
    catch validate_archive_session(forged):
        ok value:
            assert false
        error failure:
            assert failure == ArchiveError.AccountingInvalid
            forged_error <- true
    assert forged_error
    aggregate_overflow: mutable bool = false
    catch validate_archive_session(ArchiveSession{policy: ArchivePolicy{max_entries: 4, max_path_bytes: 64, max_entry_bytes: 16, max_total_bytes: 32}, state: ArchiveSessionState.Extracting, entries: [ArchiveEntry{entry_id: 10, path: "a", kind: ArchiveEntryKind.File, size: 16}, ArchiveEntry{entry_id: 11, path: "b", kind: ArchiveEntryKind.File, size: 16}, ArchiveEntry{entry_id: 12, path: "c", kind: ArchiveEntryKind.File, size: 16}], total_bytes: 32}):
        ok value:
            assert false
        error failure:
            assert failure == ArchiveError.TotalLimitBytesExceeded
            aggregate_overflow <- true
    assert aggregate_overflow


@test
def typed_hash_contract_bounds_chunks_and_publishes_one_digest() -> void:
    context: mutable HashContext = HashContext{policy: HashPolicy{algorithm: HashAlgorithm.Sha256, max_input_bytes: 16, max_chunk_bytes: 8, max_chunks: 4}}
    assert advance_hash(context, HashEvent.Begin) == HashState.Active
    assert advance_hash(context, HashEvent.Update, 8) == HashState.Active
    assert advance_hash(context, HashEvent.Update, 8) == HashState.Active
    digest: HashDigest = HashDigest{algorithm: HashAlgorithm.Sha256, word_count: 4, word0: 1, word1: 2, word2: 3, word3: 4}
    assert advance_hash(context, HashEvent.Finalize, digest: digest) == HashState.Finalized
    post_finalize: mutable bool = false
    catch advance_hash(context, HashEvent.Update, 1):
        ok value:
            assert false
        error failure:
            assert failure == HashError.InvalidTransition
            post_finalize <- true
    assert post_finalize
    wrong_digest: mutable HashContext = HashContext{policy: HashPolicy{algorithm: HashAlgorithm.Sha512, max_input_bytes: 8, max_chunk_bytes: 8, max_chunks: 2}}
    _ = advance_hash(wrong_digest, HashEvent.Begin)
    mismatch: mutable bool = false
    catch advance_hash(wrong_digest, HashEvent.Finalize, digest: digest):
        ok value:
            assert false
        error failure:
            assert failure == HashError.DigestAlgorithmMismatch
            mismatch <- true
    assert mismatch
    forged: mutable HashContext = HashContext{policy: HashPolicy{algorithm: HashAlgorithm.Sha256, max_input_bytes: 8, max_chunk_bytes: 8, max_chunks: 2}, bytes_seen: 1}
    forged_error: mutable bool = false
    catch validate_hash_context(forged):
        ok value:
            assert false
        error failure:
            assert failure == HashError.AccountingInvalid
            forged_error <- true
    assert forged_error
    active_forged: mutable bool = false
    catch validate_hash_context(HashContext{policy: HashPolicy{algorithm: HashAlgorithm.Sha256, max_input_bytes: 8, max_chunk_bytes: 8, max_chunks: 2}, state: HashState.Active, chunks_seen: 1}):
        ok value:
            assert false
        error failure:
            assert failure == HashError.AccountingInvalid
            active_forged <- true
    assert active_forged
    forged_digest: mutable bool = false
    catch validate_hash_context(HashContext{policy: HashPolicy{algorithm: HashAlgorithm.Sha256, max_input_bytes: 8, max_chunk_bytes: 8, max_chunks: 2}, digest: HashDigest{algorithm: HashAlgorithm.Sha256, word_count: 0, word0: 7}}):
        ok value:
            assert false
        error failure:
            assert failure == HashError.DigestAlreadyPublished
            forged_digest <- true
    assert forged_digest
    malformed_digest: mutable HashContext = HashContext{policy: HashPolicy{algorithm: HashAlgorithm.Fnv1a64, max_input_bytes: 8, max_chunk_bytes: 8, max_chunks: 2}, state: HashState.Finalized, digest: HashDigest{algorithm: HashAlgorithm.Fnv1a64, word_count: 1, word0: 1, word1: 1}}
    malformed_error: mutable bool = false
    catch validate_hash_context(malformed_digest):
        ok value:
            assert false
        error failure:
            assert failure == HashError.DigestShapeInvalid
            malformed_error <- true
    assert malformed_error


@test
def typed_binary_contract_checks_endianness_and_trailing_bytes() -> void:
    cursor: mutable BinaryCursor = BinaryCursor{source: "ABCD", policy: BinaryPolicy{max_input_bytes: 4, max_reads: 4}}
    assert binary_read_u16(cursor, BinaryByteOrder.Little) == 16961
    assert binary_read_u16(cursor, BinaryByteOrder.Big) == 17220
    assert advance_binary(cursor, BinaryEvent.Finish) == BinaryCursorState.Exhausted
    post_finish: mutable bool = false
    catch binary_read_u8(cursor):
        ok value:
            assert false
        error failure:
            assert failure == BinaryError.InvalidState
            post_finish <- true
    assert post_finish
    truncated: mutable BinaryCursor = BinaryCursor{source: "A", policy: BinaryPolicy{max_input_bytes: 4, max_reads: 2}}
    truncated_error: mutable bool = false
    catch binary_read_u16(truncated, BinaryByteOrder.Little):
        ok value:
            assert false
        error failure:
            assert failure == BinaryError.Truncated
            truncated_error <- true
    assert truncated_error
    wide: mutable BinaryCursor = BinaryCursor{source: "ABCDEFGH", policy: BinaryPolicy{max_input_bytes: 8, max_reads: 1}}
    assert binary_read_u64(wide, BinaryByteOrder.Little) == 0x4847464544434241u64
    assert advance_binary(wide, BinaryEvent.Finish) == BinaryCursorState.Exhausted
    forged: mutable BinaryCursor = BinaryCursor{source: "AB", policy: BinaryPolicy{max_input_bytes: 2, max_reads: 2}, state: BinaryCursorState.Exhausted, offset: 1, reads: 1}
    forged_error: mutable bool = false
    catch validate_binary_cursor(forged):
        ok value:
            assert false
        error failure:
            assert failure == BinaryError.TrailingBytes
            forged_error <- true
    assert forged_error
    forged_consumption: mutable bool = false
    catch validate_binary_cursor(BinaryCursor{source: "AB", policy: BinaryPolicy{max_input_bytes: 2, max_reads: 2}, offset: 1}):
        ok value:
            assert false
        error failure:
            assert failure == BinaryError.AccountingInvalid
            forged_consumption <- true
    assert forged_consumption
    forged_reads: mutable bool = false
    catch validate_binary_cursor(BinaryCursor{source: "AB", policy: BinaryPolicy{max_input_bytes: 2, max_reads: 2}, offset: 1, reads: 2}):
        ok value:
            assert false
        error failure:
            assert failure == BinaryError.AccountingInvalid
            forged_reads <- true
    assert forged_reads


@test
def typed_host_handle_contract_tracks_raw_identity_transfer_and_cleanup() -> void:
    table: mutable HostHandleTable = HostHandleTable{max_entries: 4}
    assert host_handle_acquire(table, 11, 101, ResourceKind.File, 7)
    assert advance_host_handle(table, 11, 7, HostHandleEvent.Transfer, 8) == HostHandleState.Owned
    wrong_owner: mutable bool = false
    catch advance_host_handle(table, 11, 7, HostHandleEvent.BeginClose):
        ok value:
            assert false
        error failure:
            assert failure == HostHandleError.OwnerMismatch
            wrong_owner <- true
    assert wrong_owner
    assert advance_host_handle(table, 11, 8, HostHandleEvent.BeginClose) == HostHandleState.Closing
    assert advance_host_handle(table, 11, 8, HostHandleEvent.CompleteClose) == HostHandleState.Released
    failed: mutable HostHandleTable = HostHandleTable{max_entries: 4}
    assert host_handle_acquire(failed, 12, 102, ResourceKind.Process, 9)
    assert advance_host_handle(failed, 12, 9, HostHandleEvent.Abandon) == HostHandleState.Failed
    duplicate_raw: mutable bool = false
    catch host_handle_acquire(failed, 13, 102, ResourceKind.File, 10):
        ok value:
            assert false
        error failure:
            assert failure == HostHandleError.DuplicateRawHandle
            duplicate_raw <- true
    assert duplicate_raw


@test
def typed_record_stream_contract_is_bounded_and_explicit() -> void:
    policy: RecordStreamPolicy = RecordStreamPolicy{}
    assert validate_record_stream_policy(policy)
    regex_policy: RecordStreamPolicy = RecordStreamPolicy{separator_mode: RecordSeparatorMode.Regex, separator: "\\n+", field_mode: RecordFieldMode.Regex, field_separator: "[,;]", schema_name: ""}
    assert validate_record_stream_policy(regex_policy)
    fixed_policy: RecordStreamPolicy = RecordStreamPolicy{field_mode: RecordFieldMode.FixedWidth, fixed_widths: [2, 4, 8]}
    assert validate_record_stream_policy(fixed_policy)
    schema_policy: RecordStreamPolicy = RecordStreamPolicy{field_mode: RecordFieldMode.Schema, schema_name: "log-v1"}
    assert validate_record_stream_policy(schema_policy)
    invalid_separator: RecordStreamPolicy = RecordStreamPolicy{separator_mode: RecordSeparatorMode.Literal}
    separator_rejected: mutable bool = false
    catch validate_record_stream_policy(invalid_separator):
        ok value:
            assert not value
        error failure:
            assert failure == RecordContractError.InvalidSeparator
            separator_rejected <- true
    assert separator_rejected
    invalid_fixed: RecordStreamPolicy = RecordStreamPolicy{field_mode: RecordFieldMode.FixedWidth, fixed_widths: [0]}
    fixed_rejected: mutable bool = false
    catch validate_record_stream_policy(invalid_fixed):
        ok value:
            assert not value
        error failure:
            assert failure == RecordContractError.FixedWidthMalformed
            fixed_rejected <- true
    assert fixed_rejected
    oversized_fixed: RecordStreamPolicy = RecordStreamPolicy{field_mode: RecordFieldMode.FixedWidth, fixed_widths: [67108864]}
    oversized_fixed_rejected: mutable bool = false
    catch validate_record_stream_policy(oversized_fixed):
        ok value:
            assert false
        error failure:
            assert failure == RecordContractError.FixedWidthOverflow
            oversized_fixed_rejected <- true
    assert oversized_fixed_rejected
    fixed_schema_conflict: RecordStreamPolicy = RecordStreamPolicy{field_mode: RecordFieldMode.FixedWidth, fixed_widths: [2], schema_name: "unexpected"}
    fixed_schema_rejected: mutable bool = false
    catch validate_record_stream_policy(fixed_schema_conflict):
        ok value:
            assert false
        error failure:
            assert failure == RecordContractError.InvalidFieldSeparator
            fixed_schema_rejected <- true
    assert fixed_schema_rejected
    record: Record = Record{source: "stdin", filename: "input.log", record_number: 1, file_record_number: 1, byte_offset: 0, raw: "alpha beta"}
    assert validate_record(record, policy)
    consumed_separator: Record = Record{source: "stdin", filename: "input.log", record_number: 1, file_record_number: 1, byte_offset: 0, raw: "alpha beta", separator: "\n"}
    preserved_policy: RecordStreamPolicy = RecordStreamPolicy{preserve_separator: true}
    assert validate_record(consumed_separator, preserved_policy)
    unpreserved_separator_rejected: mutable bool = false
    catch validate_record(consumed_separator, policy):
        ok value:
            assert false
        error failure:
            assert failure == RecordContractError.InvalidSeparator
            unpreserved_separator_rejected <- true
    assert unpreserved_separator_rejected
    field: RecordField = RecordField{index: 0, start_byte: 0, end_byte: 5, value: "alpha"}
    assert validate_record_field(field, record, policy)
    invalid_field: RecordField = RecordField{index: 0, start_byte: 0, end_byte: 6, value: "alpha"}
    field_rejected: mutable bool = false
    catch validate_record_field(invalid_field, record, policy):
        ok value:
            assert not value
        error failure:
            assert failure == RecordContractError.InvalidFieldRange
            field_rejected <- true
    assert field_rejected
    invalid_field_record: mutable bool = false
    catch validate_record_field(field, Record{source: "", raw: "alpha"}, policy):
        ok value:
            assert false
        error failure:
            assert failure == RecordContractError.MissingSource
            invalid_field_record <- true
    assert invalid_field_record
    invalid_record_policy: mutable bool = false
    catch validate_record(record, RecordStreamPolicy{max_record_bytes: 0}):
        ok value:
            assert false
        error failure:
            assert failure == RecordContractError.InvalidRecordLimit
            invalid_record_policy <- true
    assert invalid_record_policy


@test
def typed_record_field_edit_contract_reconstructs_deterministically() -> void:
    policy: RecordFieldEditPolicy = RecordFieldEditPolicy{max_fields: 4, max_edits: 4, output_separator: "|", allow_append: true}
    session: mutable RecordFieldEditSession = RecordFieldEditSession{policy: policy, fields: ["alpha", "beta"]}
    assert validate_record_field_edit_session(session)
    assert advance_record_field_edit(session, RecordFieldEditEvent.Begin) == RecordFieldEditState.Editing
    assert advance_record_field_edit(session, RecordFieldEditEvent.Set, RecordFieldEdit{index: 1, value: "gamma"}) == RecordFieldEditState.Editing
    assert advance_record_field_edit(session, RecordFieldEditEvent.Set, RecordFieldEdit{index: 2, value: "delta"}) == RecordFieldEditState.Editing
    assert advance_record_field_edit(session, RecordFieldEditEvent.Set, RecordFieldEdit{index: 0, value: "ignored", present: false}) == RecordFieldEditState.Editing
    assert advance_record_field_edit(session, RecordFieldEditEvent.Reconstruct) == RecordFieldEditState.Ready
    assert record_field_edit_reconstruct_length(session) == 12
    assert session.output_bytes == 12
    assert record_field_reconstruct(session) == "|gamma|delta"
    forged_output: mutable bool = false
    catch validate_record_field_edit_session(RecordFieldEditSession{policy: policy, state: RecordFieldEditState.Ready, fields: ["alpha"], output_bytes: 0}):
        ok value:
            assert false
        error failure:
            assert failure == RecordFieldEditError.AccountingInvalid
            forged_output <- true
    assert forged_output
    forged_plan: mutable bool = false
    catch validate_record_field_edit_session(RecordFieldEditSession{policy: policy, fields: ["alpha"], edits: [RecordFieldEdit{index: 0, value: "forged"}]}):
        ok value:
            assert false
        error failure:
            assert failure == RecordFieldEditError.AccountingInvalid
            forged_plan <- true
    assert forged_plan
    post_ready: mutable bool = false
    catch advance_record_field_edit(session, RecordFieldEditEvent.Set, RecordFieldEdit{index: 0, value: "late"}):
        ok value:
            assert false
        error failure:
            assert failure == RecordFieldEditError.InvalidState
            post_ready <- true
    assert post_ready
    invalid_append: mutable RecordFieldEditSession = RecordFieldEditSession{policy: RecordFieldEditPolicy{max_fields: 2, allow_append: false}, fields: ["only"]}
    _ = advance_record_field_edit(invalid_append, RecordFieldEditEvent.Begin)
    append_rejected: mutable bool = false
    catch advance_record_field_edit(invalid_append, RecordFieldEditEvent.Set, RecordFieldEdit{index: 1, value: "second"}):
        ok value:
            assert false
        error failure:
            assert failure == RecordFieldEditError.InvalidFieldIndex
            append_rejected <- true
    assert append_rejected


@test
def typed_record_numeric_contract_checks_signed_unsigned_and_decimal_lexemes() -> void:
    integer_policy: RecordNumericPolicy = RecordNumericPolicy{kind: RecordNumericKind.Integer, max_bytes: 64, max_digits: 32, max_exponent_digits: 4}
    integer: mutable RecordNumericSession = RecordNumericSession{policy: integer_policy}
    assert advance_record_numeric(integer, RecordNumericEvent.Begin) == RecordNumericState.Parsing
    _ = advance_record_numeric(integer, RecordNumericEvent.Byte, 45)
    _ = advance_record_numeric(integer, RecordNumericEvent.Byte, 49)
    _ = advance_record_numeric(integer, RecordNumericEvent.Byte, 50)
    _ = advance_record_numeric(integer, RecordNumericEvent.Byte, 95)
    _ = advance_record_numeric(integer, RecordNumericEvent.Byte, 51)
    _ = advance_record_numeric(integer, RecordNumericEvent.Byte, 52)
    _ = advance_record_numeric(integer, RecordNumericEvent.Byte, 53)
    assert advance_record_numeric(integer, RecordNumericEvent.Finish) == RecordNumericState.Complete
    integer_result: RecordNumericResult = record_numeric_result(integer)
    assert integer_result.negative and integer_result.magnitude == 12345 and integer_result.coefficient_digits == 5
    decimal_policy: RecordNumericPolicy = RecordNumericPolicy{kind: RecordNumericKind.Decimal, max_bytes: 64, max_digits: 32, max_exponent_digits: 4}
    decimal: mutable RecordNumericSession = RecordNumericSession{policy: decimal_policy}
    _ = advance_record_numeric(decimal, RecordNumericEvent.Begin)
    for byte in [49u8, 46u8, 50u8, 53u8, 69u8, 45u8, 50u8] |decimal|:
        _ = advance_record_numeric(decimal, RecordNumericEvent.Byte, byte)
    assert advance_record_numeric(decimal, RecordNumericEvent.Finish) == RecordNumericState.Complete
    decimal_result: RecordNumericResult = record_numeric_result(decimal)
    assert decimal_result.kind == RecordNumericKind.Decimal and decimal_result.fraction_digits == 2 and decimal_result.exponent_negative and decimal_result.exponent_magnitude == 2
    wide_exponent: mutable RecordNumericSession = RecordNumericSession{policy: RecordNumericPolicy{kind: RecordNumericKind.Decimal, max_bytes: 64, max_digits: 32, max_exponent_digits: 20}}
    _ = advance_record_numeric(wide_exponent, RecordNumericEvent.Begin)
    _ = advance_record_numeric(wide_exponent, RecordNumericEvent.Byte, 49u8)
    _ = advance_record_numeric(wide_exponent, RecordNumericEvent.Byte, 101u8)
    for _ in 0..<19 |wide_exponent|:
        _ = advance_record_numeric(wide_exponent, RecordNumericEvent.Byte, 57u8)
    assert advance_record_numeric(wide_exponent, RecordNumericEvent.Finish) == RecordNumericState.Complete
    wide_exponent_result: RecordNumericResult = record_numeric_result(wide_exponent)
    assert wide_exponent_result.exponent_magnitude == 9999999999999999999
    underscore_decimal: mutable RecordNumericSession = RecordNumericSession{policy: decimal_policy}
    _ = advance_record_numeric(underscore_decimal, RecordNumericEvent.Begin)
    _ = advance_record_numeric(underscore_decimal, RecordNumericEvent.Byte, 49u8)
    _ = advance_record_numeric(underscore_decimal, RecordNumericEvent.Byte, 95u8)
    underscore_decimal_rejected: mutable bool = false
    catch advance_record_numeric(underscore_decimal, RecordNumericEvent.Byte, 46u8):
        ok value:
            assert false
        error failure:
            assert failure == RecordNumericError.UnderscorePlacement
            underscore_decimal_rejected <- true
    assert underscore_decimal_rejected
    assert underscore_decimal.chars == 2
    unsigned: mutable RecordNumericSession = RecordNumericSession{policy: RecordNumericPolicy{kind: RecordNumericKind.Unsigned, max_bytes: 64, max_digits: 32, max_exponent_digits: 4}}
    _ = advance_record_numeric(unsigned, RecordNumericEvent.Begin)
    unsigned_rejected: mutable bool = false
    catch advance_record_numeric(unsigned, RecordNumericEvent.Byte, 45):
        ok value:
            assert false
        error failure:
            assert failure == RecordNumericError.SignNotAllowed
            unsigned_rejected <- true
    assert unsigned_rejected
    trailing: mutable RecordNumericSession = RecordNumericSession{policy: integer_policy}
    _ = advance_record_numeric(trailing, RecordNumericEvent.Begin)
    _ = advance_record_numeric(trailing, RecordNumericEvent.Byte, 49)
    _ = advance_record_numeric(trailing, RecordNumericEvent.Byte, 95)
    trailing_rejected: mutable bool = false
    catch advance_record_numeric(trailing, RecordNumericEvent.Finish):
        ok value:
            assert false
        error failure:
            assert failure == RecordNumericError.TrailingSeparator
            trailing_rejected <- true
    assert trailing_rejected
    overflow: mutable RecordNumericSession = RecordNumericSession{policy: integer_policy}
    _ = advance_record_numeric(overflow, RecordNumericEvent.Begin)
    for byte in [57u8, 50u8, 50u8, 51u8, 51u8, 55u8, 50u8, 48u8, 51u8, 54u8, 56u8, 53u8, 52u8, 55u8, 55u8, 53u8, 56u8, 48u8] |overflow|:
        _ = advance_record_numeric(overflow, RecordNumericEvent.Byte, byte)
    overflow_rejected: mutable bool = false
    catch advance_record_numeric(overflow, RecordNumericEvent.Byte, 56u8):
        ok value:
            assert false
        error failure:
            assert failure == RecordNumericError.IntegerOverflow
            overflow_rejected <- true
    assert overflow_rejected
    assert overflow.chars == 18
    _ = advance_record_numeric(overflow, RecordNumericEvent.Cancel)
    forged: mutable bool = false
    catch validate_record_numeric_session(RecordNumericSession{policy: integer_policy, chars: 1, digits: 2}):
        ok value:
            assert false
        error failure:
            assert failure == RecordNumericError.AccountingInvalid
            forged <- true
    assert forged
    forged_phase: mutable bool = false
    catch validate_record_numeric_session(RecordNumericSession{policy: decimal_policy, state: RecordNumericState.Parsing, phase: RecordNumericPhase.Digits, chars: 1, digits: 1, magnitude: 0, previous_digit: true, saw_digit: true, saw_exponent: true}):
        ok value:
            assert false
        error failure:
            assert failure == RecordNumericError.AccountingInvalid
            forged_phase <- true
    assert forged_phase


@test
def typed_record_materializer_contract_is_ordered_and_bounded() -> void:
    policy: RecordStreamPolicy = RecordStreamPolicy{field_mode: RecordFieldMode.Whitespace, max_fields: 4}
    materializer: mutable RecordMaterializer = RecordMaterializer{policy: policy}
    assert validate_record_materializer(materializer)
    assert advance_record_materializer(materializer, RecordMaterializerEvent.BeginRecord, Record{source: "stdin", raw: "alpha beta"}) == RecordMaterializerState.Collecting
    first: RecordField = RecordField{index: 0, start_byte: 0, end_byte: 5, value: "alpha"}
    second: RecordField = RecordField{index: 1, start_byte: 6, end_byte: 10, value: "beta"}
    assert advance_record_materializer(materializer, RecordMaterializerEvent.Field, Record{source: ""}, first) == RecordMaterializerState.Collecting
    assert advance_record_materializer(materializer, RecordMaterializerEvent.Field, Record{source: ""}, second) == RecordMaterializerState.Collecting
    assert advance_record_materializer(materializer, RecordMaterializerEvent.EndRecord) == RecordMaterializerState.Collecting
    assert advance_record_materializer(materializer, RecordMaterializerEvent.Seal) == RecordMaterializerState.Sealed
    assert materializer.records.count == 1
    assert materializer.fields.count == 2
    wrong_order: mutable RecordMaterializer = RecordMaterializer{policy: policy}
    _ = advance_record_materializer(wrong_order, RecordMaterializerEvent.BeginRecord, Record{source: "stdin", raw: "alpha"})
    wrong_index: mutable bool = false
    catch advance_record_materializer(wrong_order, RecordMaterializerEvent.Field, Record{source: ""}, RecordField{index: 1, start_byte: 0, end_byte: 5, value: "alpha"}):
        ok value:
            assert false
        error failure:
            assert failure == RecordMaterializerError.FieldOrderInvalid
            wrong_index <- true
    assert wrong_index
    assert advance_record_materializer(wrong_order, RecordMaterializerEvent.Cancel) == RecordMaterializerState.Cancelled
    assert validate_record_materializer(wrong_order)
    aborted_fields: mutable RecordMaterializer = RecordMaterializer{policy: policy}
    _ = advance_record_materializer(aborted_fields, RecordMaterializerEvent.BeginRecord, Record{source: "stdin", raw: "alpha"})
    _ = advance_record_materializer(aborted_fields, RecordMaterializerEvent.Field, Record{source: ""}, first)
    assert advance_record_materializer(aborted_fields, RecordMaterializerEvent.Cancel) == RecordMaterializerState.Cancelled
    assert aborted_fields.fields.count == 0 and aborted_fields.text_bytes == 0
    assert validate_record_materializer(aborted_fields)
    forged_planned: mutable bool = false
    catch validate_record_materializer(RecordMaterializer{policy: policy, fields: [first], text_bytes: 5}):
        ok value:
            assert false
        error failure:
            assert failure == RecordMaterializerError.AccountingInvalid
            forged_planned <- true
    assert forged_planned
    forged_sealed: mutable bool = false
    catch validate_record_materializer(RecordMaterializer{policy: policy, state: RecordMaterializerState.Sealed}):
        ok value:
            assert false
        error failure:
            assert failure == RecordMaterializerError.InvalidState
            forged_sealed <- true
    assert forged_sealed
    forged_idle: mutable bool = false
    catch validate_record_materializer(RecordMaterializer{policy: policy, current_record: Record{source: "ghost"}}):
        ok value:
            assert false
        error failure:
            assert failure == RecordMaterializerError.InvalidState
            forged_idle <- true
    assert forged_idle
    forged_cursor: mutable bool = false
    catch validate_record_materializer(RecordMaterializer{policy: policy, state: RecordMaterializerState.Sealed, records: [MaterializedRecord{record: Record{source: "stdin", raw: "alpha"}, field_start: 0, field_count: 1}], fields: [first], current_field_start: 1, text_bytes: 10}):
        ok value:
            assert false
        error failure:
            assert failure == RecordMaterializerError.InvalidState
            forged_cursor <- true
    assert forged_cursor


@test
def typed_record_sort_contract_is_bounded_stable_and_typed() -> void:
    policy: RecordSortPolicy = RecordSortPolicy{record_policy: RecordStreamPolicy{}, keys: [RecordSortKeySpec{field_index: 0, kind: RecordSortKeyKind.Text, direction: RecordSortDirection.Ascending}, RecordSortKeySpec{field_index: 1, kind: RecordSortKeyKind.Integer, direction: RecordSortDirection.Descending}], stable: true}
    session: mutable RecordSortSession = RecordSortSession{policy: policy}
    assert validate_record_sort_session(session)
    assert advance_record_sort(session, RecordSortEvent.Begin) == RecordSortState.Collecting
    first: RecordSortEntry = RecordSortEntry{record: Record{source: "stdin", raw: "alpha"}, keys: [RecordSortKey{spec_index: 0, kind: RecordSortKeyKind.Text, text: "alpha"}, RecordSortKey{spec_index: 1, kind: RecordSortKeyKind.Integer, integer: 2}], ordinal: 0}
    second: RecordSortEntry = RecordSortEntry{record: Record{source: "stdin", raw: "beta"}, keys: [RecordSortKey{spec_index: 0, kind: RecordSortKeyKind.Text, text: "beta"}, RecordSortKey{spec_index: 1, kind: RecordSortKeyKind.Integer, integer: 1}], ordinal: 1}
    assert advance_record_sort(session, RecordSortEvent.Record, first) == RecordSortState.Collecting
    assert advance_record_sort(session, RecordSortEvent.Record, second) == RecordSortState.Collecting
    assert compare_record_sort_entries(first, second, policy) == RecordSortOrder.Before
    assert advance_record_sort(session, RecordSortEvent.Seal) == RecordSortState.Sealed
    unique_policy: RecordSortPolicy = RecordSortPolicy{record_policy: RecordStreamPolicy{}, keys: [RecordSortKeySpec{field_index: 0}], unique: true}
    unique_rejected: mutable bool = false
    catch validate_record_sort_session(RecordSortSession{policy: unique_policy, state: RecordSortState.Collecting, entries: [RecordSortEntry{record: Record{source: "stdin", raw: "alpha"}, keys: [RecordSortKey{spec_index: 0, kind: RecordSortKeyKind.Text, text: "alpha"}], ordinal: 0}, RecordSortEntry{record: Record{source: "stdin", raw: "alpha"}, keys: [RecordSortKey{spec_index: 0, kind: RecordSortKeyKind.Text, text: "alpha"}], ordinal: 1}], text_bytes: 10}):
        ok value:
            assert false
        error failure:
            assert failure == RecordSortError.UniqueViolation
            unique_rejected <- true
    assert unique_rejected
    missing_payload: mutable bool = false
    catch validate_record_sort_session(RecordSortSession{policy: policy, state: RecordSortState.Collecting, entries: [RecordSortEntry{record: Record{source: "stdin", raw: "alpha"}, keys: [RecordSortKey{spec_index: 0, kind: RecordSortKeyKind.Text, present: false, text: "forged"}, RecordSortKey{spec_index: 1, kind: RecordSortKeyKind.Integer}], ordinal: 0}], text_bytes: 5}):
        ok value:
            assert false
        error failure:
            assert failure == RecordSortError.RecordInvalid
            missing_payload <- true
    assert missing_payload
    integer_payload: mutable bool = false
    catch validate_record_sort_session(RecordSortSession{policy: policy, state: RecordSortState.Collecting, entries: [RecordSortEntry{record: Record{source: "stdin", raw: "alpha"}, keys: [RecordSortKey{spec_index: 0, kind: RecordSortKeyKind.Text, text: "alpha"}, RecordSortKey{spec_index: 1, kind: RecordSortKeyKind.Integer, text: "forged", integer: 2}], ordinal: 0}], text_bytes: 10}):
        ok value:
            assert false
        error failure:
            assert failure == RecordSortError.RecordInvalid
            integer_payload <- true
    assert integer_payload
    forged_planned_sort: mutable bool = false
    catch validate_record_sort_session(RecordSortSession{policy: policy, entries: [first], text_bytes: 11}):
        ok value:
            assert false
        error failure:
            assert failure == RecordSortError.InvalidState
            forged_planned_sort <- true
    assert forged_planned_sort
    duplicate_key: mutable bool = false
    invalid_policy: RecordSortPolicy = RecordSortPolicy{record_policy: RecordStreamPolicy{}, keys: [RecordSortKeySpec{field_index: 0}, RecordSortKeySpec{field_index: 0}]}
    invalid_session: mutable RecordSortSession = RecordSortSession{policy: invalid_policy}
    catch validate_record_sort_session(invalid_session):
        ok value:
            assert false
        error failure:
            assert failure == RecordSortError.PolicyInvalid
            duplicate_key <- true
    assert duplicate_key


@test
def typed_record_spill_contract_seals_runs_before_ordered_merge() -> void:
    policy: RecordSpillPolicy = RecordSpillPolicy{max_runs: 4, max_records_per_run: 4, max_total_records: 8, max_run_bytes: 64, max_total_bytes: 128, staging_directory: "/tmp/elisa-spill", destination: "/tmp/output.log"}
    session: mutable RecordSpillSession = RecordSpillSession{policy: policy}
    assert validate_record_spill(session)
    assert advance_record_spill(session, RecordSpillEvent.Begin) == RecordSpillState.Spilling
    assert advance_record_spill(session, RecordSpillEvent.StartRun, "/tmp/elisa-spill/run-0") == RecordSpillState.Spilling
    assert advance_record_spill(session, RecordSpillEvent.Append, records: 2, bytes: 10) == RecordSpillState.Spilling
    assert advance_record_spill(session, RecordSpillEvent.SealRun) == RecordSpillState.Ready
    assert advance_record_spill(session, RecordSpillEvent.StartRun, "/tmp/elisa-spill/run-1") == RecordSpillState.Spilling
    assert advance_record_spill(session, RecordSpillEvent.Append, records: 1, bytes: 6) == RecordSpillState.Spilling
    assert advance_record_spill(session, RecordSpillEvent.SealRun) == RecordSpillState.Ready
    assert advance_record_spill(session, RecordSpillEvent.BeginMerge) == RecordSpillState.Merging
    assert advance_record_spill(session, RecordSpillEvent.MergeRun, run_index: 0) == RecordSpillState.Merging
    assert advance_record_spill(session, RecordSpillEvent.MergeRun, run_index: 1) == RecordSpillState.Merging
    assert advance_record_spill(session, RecordSpillEvent.Commit) == RecordSpillState.Sealed
    bad_order: mutable RecordSpillSession = RecordSpillSession{policy: policy}
    _ = advance_record_spill(bad_order, RecordSpillEvent.Begin)
    _ = advance_record_spill(bad_order, RecordSpillEvent.StartRun, "/tmp/elisa-spill/run-a")
    _ = advance_record_spill(bad_order, RecordSpillEvent.SealRun)
    _ = advance_record_spill(bad_order, RecordSpillEvent.BeginMerge)
    order_rejected: mutable bool = false
    catch advance_record_spill(bad_order, RecordSpillEvent.MergeRun, run_index: 1):
        ok value:
            assert false
        error failure:
            assert failure == RecordSpillError.MergeOrderInvalid
            order_rejected <- true
    assert order_rejected
    forged_state: mutable bool = false
    catch validate_record_spill(RecordSpillSession{policy: policy, state: RecordSpillState.Planned, runs: [RecordSpillRun{ordinal: 0, path: "/tmp/elisa-spill/forged", sealed: true}], merged_runs: 1}):
        ok value:
            assert false
        error failure:
            assert failure == RecordSpillError.AccountingInvalid
            forged_state <- true
    assert forged_state
    forged_sealed: mutable bool = false
    catch validate_record_spill(RecordSpillSession{policy: policy, state: RecordSpillState.Sealed, runs: [RecordSpillRun{ordinal: 0, path: "/tmp/elisa-spill/sealed", sealed: true}], merged_runs: 0}):
        ok value:
            assert false
        error failure:
            assert failure == RecordSpillError.AccountingInvalid
            forged_sealed <- true
    assert forged_sealed
    forged_spilling_merge: mutable bool = false
    catch advance_record_spill(RecordSpillSession{policy: policy, state: RecordSpillState.Spilling, runs: [RecordSpillRun{ordinal: 0, path: "/tmp/elisa-spill/spilling", sealed: true}]}, RecordSpillEvent.BeginMerge):
        ok value:
            assert false
        error failure:
            assert failure == RecordSpillError.InvalidState
            forged_spilling_merge <- true
    assert forged_spilling_merge


@test
def typed_record_rewrite_contract_is_transactional_and_recoverable() -> void:
    plan: RecordRewritePlan = RecordRewritePlan{source_path: "input.log", destination_path: "input.log", staging_path: "input.log.elisa.tmp", backup_path: "input.log.bak", max_output_bytes: 1024}
    session: mutable RecordRewriteSession = RecordRewriteSession{plan: plan}
    assert validate_record_rewrite_session(session)
    assert advance_record_rewrite(session, RecordRewriteEvent.Begin) == RecordRewriteState.Staging
    assert advance_record_rewrite(session, RecordRewriteEvent.Append, 7) == RecordRewriteState.Staging
    assert advance_record_rewrite(session, RecordRewriteEvent.Sync) == RecordRewriteState.Ready
    assert advance_record_rewrite(session, RecordRewriteEvent.DirectorySync) == RecordRewriteState.Ready
    assert advance_record_rewrite(session, RecordRewriteEvent.Commit) == RecordRewriteState.Committing
    assert advance_record_rewrite(session, RecordRewriteEvent.CommitAck) == RecordRewriteState.Committed
    forged_phase: mutable bool = false
    catch validate_record_rewrite_session(RecordRewriteSession{plan: plan, state: RecordRewriteState.Staging, staged_synced: true}):
        ok value:
            assert false
        error failure:
            assert failure == RecordRewriteError.InvalidState
            forged_phase <- true
    assert forged_phase
    forged_commit_sync: mutable bool = false
    catch validate_record_rewrite_session(RecordRewriteSession{plan: plan, state: RecordRewriteState.Committing, staged_synced: true}):
        ok value:
            assert false
        error failure:
            assert failure == RecordRewriteError.InvalidState
            forged_commit_sync <- true
    assert forged_commit_sync
    forged_impossible_ack: mutable bool = false
    catch validate_record_rewrite_session(RecordRewriteSession{plan: plan, state: RecordRewriteState.Committing, staged_synced: true, directory_synced: true, rollback_acknowledged: true}):
        ok value:
            assert false
        error failure:
            assert failure == RecordRewriteError.InvalidState
            forged_impossible_ack <- true
    assert forged_impossible_ack
    forged_committed_sync: mutable bool = false
    catch validate_record_rewrite_session(RecordRewriteSession{plan: plan, state: RecordRewriteState.Committed, commit_acknowledged: true, directory_synced: true}):
        ok value:
            assert false
        error failure:
            assert failure == RecordRewriteError.InvalidState
            forged_committed_sync <- true
    assert forged_committed_sync
    assert advance_record_rewrite(session, RecordRewriteEvent.BeginRollback) == RecordRewriteState.RollingBack
    assert advance_record_rewrite(session, RecordRewriteEvent.RollbackAck) == RecordRewriteState.RolledBack
    collision: mutable bool = false
    invalid: mutable RecordRewriteSession = RecordRewriteSession{plan: RecordRewritePlan{source_path: "input.log", destination_path: "input.log", staging_path: "input.log"}}
    catch validate_record_rewrite_session(invalid):
        ok value:
            assert false
        error failure:
            assert failure == RecordRewriteError.PathCollision
            collision <- true
    assert collision


@test
def typed_record_lifecycle_contract_orders_file_and_record_hooks() -> void:
    policy: RecordLifecyclePolicy = RecordLifecyclePolicy{max_files: 2, max_records: 4, allow_empty_files: false}
    session: mutable RecordLifecycleSession = RecordLifecycleSession{policy: policy}
    assert validate_record_lifecycle(session)
    assert advance_record_lifecycle(session, RecordLifecycleEvent.Begin) == RecordLifecycleState.Running
    assert advance_record_lifecycle(session, RecordLifecycleEvent.FileBegin, "input.log") == RecordLifecycleState.Running
    assert advance_record_lifecycle(session, RecordLifecycleEvent.RecordBegin) == RecordLifecycleState.Running
    assert advance_record_lifecycle(session, RecordLifecycleEvent.RecordEnd) == RecordLifecycleState.Running
    assert advance_record_lifecycle(session, RecordLifecycleEvent.FileEnd) == RecordLifecycleState.Running
    assert session.file_record_count == 0
    assert advance_record_lifecycle(session, RecordLifecycleEvent.End) == RecordLifecycleState.Completed
    forged_file: mutable bool = false
    catch validate_record_lifecycle(RecordLifecycleSession{policy: policy, state: RecordLifecycleState.Running, file_open: true, current_file: ""}):
        ok value:
            assert false
        error failure:
            assert failure == RecordLifecycleError.InvalidState
            forged_file <- true
    assert forged_file
    forged_file_count: mutable bool = false
    catch validate_record_lifecycle(RecordLifecycleSession{policy: policy, state: RecordLifecycleState.Running, file_open: true, current_file: "input.log"}):
        ok value:
            assert false
        error failure:
            assert failure == RecordLifecycleError.InvalidState
            forged_file_count <- true
    assert forged_file_count
    invalid: mutable RecordLifecycleSession = RecordLifecycleSession{policy: policy}
    _ = advance_record_lifecycle(invalid, RecordLifecycleEvent.Begin)
    missing_file: mutable bool = false
    catch advance_record_lifecycle(invalid, RecordLifecycleEvent.RecordBegin):
        ok value:
            assert false
        error failure:
            assert failure == RecordLifecycleError.FileNotOpen
            missing_file <- true
    assert missing_file
    forged_record_count: mutable bool = false
    catch validate_record_lifecycle(RecordLifecycleSession{policy: policy, state: RecordLifecycleState.Running, record_count: 1}):
        ok value:
            assert false
        error failure:
            assert failure == RecordLifecycleError.InvalidState
            forged_record_count <- true
    assert forged_record_count
    forged_closed_file_count: mutable bool = false
    catch validate_record_lifecycle(RecordLifecycleSession{policy: policy, state: RecordLifecycleState.Completed, file_count: 1, record_count: 1, file_record_count: 1}):
        ok value:
            assert false
        error failure:
            assert failure == RecordLifecycleError.InvalidState
            forged_closed_file_count <- true
    assert forged_closed_file_count
    forged_planned_counters: mutable bool = false
    catch validate_record_lifecycle(RecordLifecycleSession{policy: policy, state: RecordLifecycleState.Planned, file_count: 1}):
        ok value:
            assert false
        error failure:
            assert failure == RecordLifecycleError.InvalidState
            forged_planned_counters <- true
    assert forged_planned_counters
    overflow_end: mutable bool = false
    catch advance_record_lifecycle(RecordLifecycleSession{policy: policy, state: RecordLifecycleState.Running, file_open: true, record_open: true, file_count: 1, record_count: 4, current_file: "input.log"}, RecordLifecycleEvent.RecordEnd):
        ok value:
            assert false
        error failure:
            assert failure == RecordLifecycleError.RecordLimitExceeded
            overflow_end <- true
    assert overflow_end


@test
def typed_record_aggregate_contract_is_bounded_and_insertion_ordered() -> void:
    policy: RecordAggregatePolicy = RecordAggregatePolicy{max_groups: 4, max_events: 8, max_key_bytes: 64, max_sum: 64}
    session: mutable RecordAggregateSession = RecordAggregateSession{policy: policy}
    assert validate_record_aggregate(session)
    assert advance_record_aggregate(session, RecordAggregateEvent.Begin) == RecordAggregateState.Collecting
    assert advance_record_aggregate(session, RecordAggregateEvent.Add, "alpha") == RecordAggregateState.Collecting
    assert advance_record_aggregate(session, RecordAggregateEvent.Add, "beta") == RecordAggregateState.Collecting
    assert advance_record_aggregate(session, RecordAggregateEvent.Add, "alpha") == RecordAggregateState.Collecting
    assert advance_record_aggregate(session, RecordAggregateEvent.Seal) == RecordAggregateState.Sealed
    assert session.groups[0].key == "alpha"
    assert session.groups[1].key == "beta"
    assert record_aggregate_group_count(session, "alpha") == 2
    assert record_aggregate_group_count(session, "beta") == 1
    sum_session: mutable RecordAggregateSession = RecordAggregateSession{policy: policy}
    assert advance_record_aggregate(sum_session, RecordAggregateEvent.Begin) == RecordAggregateState.Collecting
    assert advance_record_aggregate(sum_session, RecordAggregateEvent.AddValue, "alpha", 5) == RecordAggregateState.Collecting
    assert advance_record_aggregate(sum_session, RecordAggregateEvent.AddValue, "alpha", 7) == RecordAggregateState.Collecting
    assert advance_record_aggregate(sum_session, RecordAggregateEvent.Seal) == RecordAggregateState.Sealed
    assert record_aggregate_group_sum(sum_session, "alpha") == 12
    forged_events: mutable bool = false
    catch validate_record_aggregate(RecordAggregateSession{policy: policy, state: RecordAggregateState.Collecting, groups: [RecordAggregateGroup{key: "alpha", count: 1, first_ordinal: 0}], event_count: 2, key_bytes: 5}):
        ok value:
            assert false
        error failure:
            assert failure == RecordAggregateError.EventLimitExceeded
            forged_events <- true
    assert forged_events
    forged_planned_aggregate: mutable bool = false
    catch validate_record_aggregate(RecordAggregateSession{policy: policy, groups: [RecordAggregateGroup{key: "alpha", count: 1, first_ordinal: 0}], event_count: 1, key_bytes: 5}):
        ok value:
            assert false
        error failure:
            assert failure == RecordAggregateError.AccountingInvalid
            forged_planned_aggregate <- true
    assert forged_planned_aggregate
    forged_aggregate_order: mutable bool = false
    catch validate_record_aggregate(RecordAggregateSession{policy: policy, state: RecordAggregateState.Collecting, groups: [RecordAggregateGroup{key: "beta", count: 1, first_ordinal: 1}, RecordAggregateGroup{key: "alpha", count: 1, first_ordinal: 0}], event_count: 2, key_bytes: 9}):
        ok value:
            assert false
        error failure:
            assert failure == RecordAggregateError.OrdinalInvalid
            forged_aggregate_order <- true
    assert forged_aggregate_order
    overflow: mutable RecordAggregateSession = RecordAggregateSession{policy: RecordAggregatePolicy{max_groups: 2, max_events: 4, max_key_bytes: 32, max_sum: 5}}
    assert advance_record_aggregate(overflow, RecordAggregateEvent.Begin) == RecordAggregateState.Collecting
    assert advance_record_aggregate(overflow, RecordAggregateEvent.AddValue, "key", 5) == RecordAggregateState.Collecting
    sum_rejected: mutable bool = false
    catch advance_record_aggregate(overflow, RecordAggregateEvent.AddValue, "key", 1):
        ok value:
            assert false
        error failure:
            assert failure == RecordAggregateError.SumLimitExceeded
            sum_rejected <- true
    assert sum_rejected
    missing: mutable bool = false
    catch record_aggregate_group_count(session, "missing"):
        ok value:
            assert false
        error failure:
            assert failure == RecordAggregateError.GroupIndexInvalid
            missing <- true
    assert missing


@test
def typed_record_window_contract_evicts_oldest_with_bounded_sum() -> void:
    policy: RecordWindowPolicy = RecordWindowPolicy{width: 2, max_events: 4, max_sum: 10}
    session: mutable RecordWindowSession = RecordWindowSession{policy: policy}
    assert validate_record_window(session)
    assert advance_record_window(session, RecordWindowEvent.Begin) == RecordWindowState.Collecting
    assert advance_record_window(session, RecordWindowEvent.Push, 3) == RecordWindowState.Collecting
    assert advance_record_window(session, RecordWindowEvent.Push, 4) == RecordWindowState.Collecting
    assert record_window_count(session) == 2
    assert record_window_sum(session) == 7
    assert advance_record_window(session, RecordWindowEvent.Push, 5) == RecordWindowState.Collecting
    assert record_window_count(session) == 2
    assert record_window_sum(session) == 9
    failed_push: mutable bool = false
    catch advance_record_window(session, RecordWindowEvent.Push, 8):
        ok value:
            assert false
        error failure:
            assert failure == RecordWindowError.SumLimitExceeded
            failed_push <- true
    assert failed_push
    assert session.active_start == 1
    assert session.values.count == 3
    assert record_window_count(session) == 2
    assert record_window_sum(session) == 9
    assert advance_record_window(session, RecordWindowEvent.Seal) == RecordWindowState.Sealed
    post_seal: mutable bool = false
    catch advance_record_window(session, RecordWindowEvent.Push, 1):
        ok value:
            assert false
        error failure:
            assert failure == RecordWindowError.InvalidState
            post_seal <- true
    assert post_seal
    overflow: mutable RecordWindowSession = RecordWindowSession{policy: RecordWindowPolicy{width: 2, max_events: 3, max_sum: 5}}
    _ = advance_record_window(overflow, RecordWindowEvent.Begin)
    _ = advance_record_window(overflow, RecordWindowEvent.Push, 5)
    sum_rejected: mutable bool = false
    catch advance_record_window(overflow, RecordWindowEvent.Push, 1):
        ok value:
            assert false
        error failure:
            assert failure == RecordWindowError.SumLimitExceeded
            sum_rejected <- true
    assert sum_rejected
    forged_planned: mutable bool = false
    catch validate_record_window(RecordWindowSession{policy: policy, values: [3], active_start: 0, sum: 3}):
        ok value:
            assert false
        error failure:
            assert failure == RecordWindowError.AccountingInvalid
            forged_planned <- true
    assert forged_planned
    forged_history: mutable bool = false
    catch validate_record_window(RecordWindowSession{policy: policy, state: RecordWindowState.Collecting, values: [99, 3], active_start: 1, sum: 3}):
        ok value:
            assert false
        error failure:
            assert failure == RecordWindowError.SumLimitExceeded
            forged_history <- true
    assert forged_history
    forged_empty_window: mutable bool = false
    catch validate_record_window(RecordWindowSession{policy: policy, state: RecordWindowState.Collecting, values: [3], active_start: 1, sum: 0}):
        ok value:
            assert false
        error failure:
            assert failure == RecordWindowError.AccountingInvalid
            forged_empty_window <- true
    assert forged_empty_window


@test
def typed_record_join_contract_counts_duplicate_and_outer_pairs() -> void:
    policy: RecordJoinPolicy = RecordJoinPolicy{kind: RecordJoinKind.Full, max_rows: 8, max_pairs: 8, max_key_bytes: 32, max_value_bytes: 32}
    session: mutable RecordJoinSession = RecordJoinSession{policy: policy}
    assert validate_record_join(session)
    assert advance_record_join(session, RecordJoinEvent.Begin) == RecordJoinState.Collecting
    assert advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Left, "shared", "left-1") == RecordJoinState.Collecting
    assert advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Left, "shared", "left-2") == RecordJoinState.Collecting
    assert advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Right, "shared", "right-1") == RecordJoinState.Collecting
    assert advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Right, "only-right", "right-2") == RecordJoinState.Collecting
    assert advance_record_join(session, RecordJoinEvent.Seal) == RecordJoinState.Sealed
    assert record_join_pair_count(session) == 4
    missing: mutable bool = false
    catch advance_record_join(session, RecordJoinEvent.Add, RecordJoinSide.Left, "late", "value"):
        ok value:
            assert false
        error failure:
            assert failure == RecordJoinError.InvalidState
            missing <- true
    assert missing
    empty_key: mutable RecordJoinSession = RecordJoinSession{policy: policy}
    _ = advance_record_join(empty_key, RecordJoinEvent.Begin)
    key_rejected: mutable bool = false
    catch advance_record_join(empty_key, RecordJoinEvent.Add, RecordJoinSide.Left, "", "value"):
        ok value:
            assert false
        error failure:
            assert failure == RecordJoinError.EmptyKey
            key_rejected <- true
    assert key_rejected
    forged_planned_join: mutable bool = false
    catch validate_record_join(RecordJoinSession{policy: policy, rows: [RecordJoinRow{side: RecordJoinSide.Left, ordinal: 0, key: "preloaded", value: "value"}], left_count: 1, key_bytes: 8, value_bytes: 5}):
        ok value:
            assert false
        error failure:
            assert failure == RecordJoinError.AccountingInvalid
            forged_planned_join <- true
    assert forged_planned_join
    forged_count_bound: mutable bool = false
    catch validate_record_join(RecordJoinSession{policy: policy, left_count: 1}):
        ok value:
            assert false
        error failure:
            assert failure == RecordJoinError.AccountingInvalid
            forged_count_bound <- true
    assert forged_count_bound


@test
def typed_record_control_contract_makes_next_and_exit_explicit() -> void:
    session: mutable RecordControlSession = RecordControlSession{policy: RecordControlPolicy{max_files: 2, max_records: 4}}
    assert validate_record_control(session)
    assert advance_record_control(session, RecordControlEvent.Begin) == RecordControlState.Running
    assert advance_record_control(session, RecordControlEvent.FileBegin) == RecordControlState.Running
    assert advance_record_control(session, RecordControlEvent.RecordBegin) == RecordControlState.Running
    assert advance_record_control(session, RecordControlEvent.NextRecord) == RecordControlState.RecordSkipped
    assert advance_record_control(session, RecordControlEvent.RecordBegin) == RecordControlState.Running
    assert advance_record_control(session, RecordControlEvent.NextRecord) == RecordControlState.RecordSkipped
    assert advance_record_control(session, RecordControlEvent.NextFile) == RecordControlState.FileSkipped
    assert advance_record_control(session, RecordControlEvent.FileBegin) == RecordControlState.Running
    assert advance_record_control(session, RecordControlEvent.Exit) == RecordControlState.Exited
    invalid: mutable RecordControlSession = RecordControlSession{policy: RecordControlPolicy{max_files: 2, max_records: 4}}
    _ = advance_record_control(invalid, RecordControlEvent.Begin)
    missing_file: mutable bool = false
    catch advance_record_control(invalid, RecordControlEvent.RecordBegin):
        ok value:
            assert false
        error failure:
            assert failure == RecordControlError.FileNotOpen
            missing_file <- true
    assert missing_file
    forged_skip: mutable bool = false
    catch validate_record_control(RecordControlSession{policy: RecordControlPolicy{max_files: 2, max_records: 4}, state: RecordControlState.RecordSkipped}):
        ok value:
            assert false
        error failure:
            assert failure == RecordControlError.InvalidState
            forged_skip <- true
    assert forged_skip
    forged_file_count: mutable bool = false
    catch validate_record_control(RecordControlSession{policy: RecordControlPolicy{max_files: 2, max_records: 4}, state: RecordControlState.Running, file_open: true}):
        ok value:
            assert false
        error failure:
            assert failure == RecordControlError.InvalidState
            forged_file_count <- true
    assert forged_file_count
    forged_planned: mutable bool = false
    catch validate_record_control(RecordControlSession{policy: RecordControlPolicy{max_files: 2, max_records: 4}, file_count: 1}):
        ok value:
            assert false
        error failure:
            assert failure == RecordControlError.InvalidState
            forged_planned <- true
    assert forged_planned
    limited: mutable RecordControlSession = RecordControlSession{policy: RecordControlPolicy{max_files: 2, max_records: 1}}
    _ = advance_record_control(limited, RecordControlEvent.Begin)
    _ = advance_record_control(limited, RecordControlEvent.FileBegin)
    _ = advance_record_control(limited, RecordControlEvent.RecordBegin)
    assert advance_record_control(limited, RecordControlEvent.NextRecord) == RecordControlState.RecordSkipped
    assert advance_record_control(limited, RecordControlEvent.FileEnd) == RecordControlState.Running
    _ = advance_record_control(limited, RecordControlEvent.FileBegin)
    _ = advance_record_control(limited, RecordControlEvent.RecordBegin)
    limited_next: mutable bool = false
    catch advance_record_control(limited, RecordControlEvent.NextRecord):
        ok value:
            assert false
        error failure:
            assert failure == RecordControlError.RecordLimitExceeded
            limited_next <- true
    assert limited_next
    nextfile_counts_record: mutable RecordControlSession = RecordControlSession{policy: RecordControlPolicy{max_files: 2, max_records: 1}}
    _ = advance_record_control(nextfile_counts_record, RecordControlEvent.Begin)
    _ = advance_record_control(nextfile_counts_record, RecordControlEvent.FileBegin)
    _ = advance_record_control(nextfile_counts_record, RecordControlEvent.RecordBegin)
    assert advance_record_control(nextfile_counts_record, RecordControlEvent.NextFile) == RecordControlState.FileSkipped
    assert nextfile_counts_record.record_count == 1
    assert advance_record_control(nextfile_counts_record, RecordControlEvent.FileBegin) == RecordControlState.Running
    nextfile_limit: mutable bool = false
    catch advance_record_control(nextfile_counts_record, RecordControlEvent.RecordBegin):
        ok value:
            assert false
        error failure:
            assert failure == RecordControlError.RecordLimitExceeded
            nextfile_limit <- true
    assert nextfile_limit
    overflow_end: mutable RecordControlSession = RecordControlSession{policy: RecordControlPolicy{max_files: 2, max_records: 1}, state: RecordControlState.Running, file_open: true, record_open: true, file_count: 1, record_count: 1}
    overflow_end_rejected: mutable bool = false
    catch advance_record_control(overflow_end, RecordControlEvent.RecordEnd):
        ok value:
            assert false
        error failure:
            assert failure == RecordControlError.RecordLimitExceeded
            overflow_end_rejected <- true
    assert overflow_end_rejected


@test
def typed_record_pattern_contract_selects_inclusive_ranges() -> void:
    clauses: darray[RecordPatternClause] = [RecordPatternClause{start: RecordPatternPredicate{kind: RecordPatternPredicateKind.RecordNumberEquals, number: 2}, end: RecordPatternPredicate{kind: RecordPatternPredicateKind.RecordNumberEquals, number: 3}, has_end: true}]
    policy: RecordPatternPolicy = RecordPatternPolicy{max_clauses: 2, max_records: 4, max_text_bytes: 32}
    session: mutable RecordPatternSession = RecordPatternSession{policy: policy, clauses: clauses}
    assert validate_record_pattern_session(session)
    assert advance_record_pattern(session, RecordPatternEvent.Begin) == RecordPatternState.Running
    first: RecordPatternObservation = RecordPatternObservation{record: Record{source: "fixture", record_number: 1, file_record_number: 1, raw: "before"}, start_matches: [false], end_matches: [false]}
    second: RecordPatternObservation = RecordPatternObservation{record: Record{source: "fixture", record_number: 2, file_record_number: 2, raw: "start"}, start_matches: [false], end_matches: [false]}
    third: RecordPatternObservation = RecordPatternObservation{record: Record{source: "fixture", record_number: 3, file_record_number: 3, raw: "end"}, start_matches: [false], end_matches: [false]}
    assert advance_record_pattern(session, RecordPatternEvent.Record, first) == RecordPatternState.Running
    assert advance_record_pattern(session, RecordPatternEvent.Record, second) == RecordPatternState.Running
    assert advance_record_pattern(session, RecordPatternEvent.Record, third) == RecordPatternState.Running
    assert record_pattern_selected(session, 2)
    assert record_pattern_selected(session, 3)
    assert advance_record_pattern(session, RecordPatternEvent.End) == RecordPatternState.Completed
    multi_clauses: darray[RecordPatternClause] = [RecordPatternClause{start: RecordPatternPredicate{kind: RecordPatternPredicateKind.RecordNumberEquals, number: 4}, action: RecordPatternAction.Select}, RecordPatternClause{start: RecordPatternPredicate{kind: RecordPatternPredicateKind.RecordNumberEquals, number: 9}, action: RecordPatternAction.Select}]
    multi_session: mutable RecordPatternSession = RecordPatternSession{policy: policy, clauses: multi_clauses}
    _ = advance_record_pattern(multi_session, RecordPatternEvent.Begin)
    multi_observation: RecordPatternObservation = RecordPatternObservation{record: Record{source: "fixture", record_number: 4, file_record_number: 4, raw: "multi"}, start_matches: [true, false], end_matches: [false, false]}
    _ = advance_record_pattern(multi_session, RecordPatternEvent.Record, multi_observation)
    assert record_pattern_selected(multi_session, 4)
    malformed: mutable RecordPatternSession = RecordPatternSession{policy: policy, clauses: clauses}
    _ = advance_record_pattern(malformed, RecordPatternEvent.Begin)
    missing_observation: mutable bool = false
    catch advance_record_pattern(malformed, RecordPatternEvent.Record, RecordPatternObservation{record: second.record, start_matches: [], end_matches: []}):
        ok value:
            assert false
        error failure:
            assert failure == RecordPatternError.ObservationShapeInvalid
            missing_observation <- true
    assert missing_observation
    forged_completed: mutable bool = false
    catch validate_record_pattern_session(RecordPatternSession{policy: policy, clauses: clauses, state: RecordPatternState.Completed, clause_states: [RecordPatternClauseState.Active], processed_records: 1, decisions: []}):
        ok value:
            assert false
        error failure:
            assert failure == RecordPatternError.EndNotReady
            forged_completed <- true
    assert forged_completed
    forged_accounting: mutable bool = false
    catch validate_record_pattern_session(RecordPatternSession{policy: policy, clauses: clauses, state: RecordPatternState.Running, clause_states: [RecordPatternClauseState.Inactive], processed_records: 1, decisions: []}):
        ok value:
            assert false
        error failure:
            assert failure == RecordPatternError.AccountingInvalid
            forged_accounting <- true
    assert forged_accounting


@test
def typed_regex_session_contract_bounds_work_captures_and_replacements() -> void:
    search_request: RegexRequest = RegexRequest{operation: RegexOperation.Search, pattern: "a+", input: "aaa"}
    search: mutable RegexSession = RegexSession{request: search_request}
    assert validate_regex_session(search)
    assert validate_regex_request(RegexRequest{operation: RegexOperation.Search, pattern: "a", input: "", policy: RegexPolicy{max_pattern_bytes: 1}})
    assert validate_regex_request(RegexRequest{operation: RegexOperation.Replace, pattern: "a", input: "", replacement: "b", policy: RegexPolicy{max_replacement_bytes: 1}})
    assert advance_regex_session(search, RegexEvent.Begin) == RegexState.Running
    assert advance_regex_session(search, RegexEvent.Work, 8) == RegexState.Running
    assert advance_regex_session(search, RegexEvent.Match, 1) == RegexState.Running
    assert advance_regex_session(search, RegexEvent.End) == RegexState.Complete
    replacement_request: RegexRequest = RegexRequest{operation: RegexOperation.Replace, pattern: "a", input: "aaa", replacement: "b", global: true}
    replacement: mutable RegexSession = RegexSession{request: replacement_request}
    assert advance_regex_session(replacement, RegexEvent.Begin) == RegexState.Running
    assert advance_regex_session(replacement, RegexEvent.Work, 3) == RegexState.Running
    assert advance_regex_session(replacement, RegexEvent.Replace, 0, 0, 3) == RegexState.Running
    assert advance_regex_session(replacement, RegexEvent.End) == RegexState.Complete
    replace_match_rejected: mutable bool = false
    replacement_match: mutable RegexSession = RegexSession{request: replacement_request}
    _ = advance_regex_session(replacement_match, RegexEvent.Begin)
    catch advance_regex_session(replacement_match, RegexEvent.Match):
        ok value:
            assert false
        error issue:
            assert issue == RegexContractError.InvalidOperation
            replace_match_rejected <- true
    assert replace_match_rejected
    single_replacement: mutable RegexSession = RegexSession{request: RegexRequest{operation: RegexOperation.Replace, pattern: "a", input: "aaa", replacement: "b"}}
    _ = advance_regex_session(single_replacement, RegexEvent.Begin)
    _ = advance_regex_session(single_replacement, RegexEvent.Replace, output_delta: 1)
    single_replacement_rejected: mutable bool = false
    catch advance_regex_session(single_replacement, RegexEvent.Replace, output_delta: 1):
        ok value:
            assert false
        error issue:
            assert issue == RegexContractError.MatchLimitExceeded
            single_replacement_rejected <- true
    assert single_replacement_rejected
    cancellation: mutable RegexSession = RegexSession{request: search_request}
    assert advance_regex_session(cancellation, RegexEvent.Begin) == RegexState.Running
    assert advance_regex_session(cancellation, RegexEvent.Cancel) == RegexState.Cancelling
    assert advance_regex_session(cancellation, RegexEvent.CancelAck) == RegexState.Cancelled
    forged_ready: mutable bool = false
    catch validate_regex_session(RegexSession{request: search_request, work: 1}):
        ok value:
            assert false
        error issue:
            assert issue == RegexContractError.CaptureAccountingInvalid
            forged_ready <- true
    assert forged_ready
    match_limited: mutable bool = false
    limited_request: RegexRequest = RegexRequest{operation: RegexOperation.Search, pattern: "a", input: "aaa", policy: RegexPolicy{max_matches: 1}}
    limited: mutable RegexSession = RegexSession{request: limited_request}
    _ = advance_regex_session(limited, RegexEvent.Begin)
    _ = advance_regex_session(limited, RegexEvent.Match)
    catch advance_regex_session(limited, RegexEvent.Match):
        ok value:
            assert false
        error issue:
            assert issue == RegexContractError.MatchLimitExceeded
            match_limited <- true
    assert match_limited


@test
def typed_regex_callback_contract_accounts_spans_and_zero_width_progress() -> void:
    policy: RegexCallbackPolicy = RegexCallbackPolicy{max_matches: 4, max_captures: 4, max_output_bytes: 16, global: true}
    zero_capture_policy: mutable bool = false
    catch validate_regex_callback(RegexCallbackSession{policy: RegexCallbackPolicy{max_matches: 1, max_captures: 0, max_output_bytes: 8}, input_bytes: 0}):
        ok value:
            assert false
        error failure:
            assert failure == RegexCallbackError.InvalidPolicy
            zero_capture_policy <- true
    assert zero_capture_policy
    session: mutable RegexCallbackSession = RegexCallbackSession{policy: policy, input_bytes: 5}
    assert validate_regex_callback(session)
    assert advance_regex_callback(session, RegexCallbackEvent.Begin) == RegexCallbackState.Matching
    assert advance_regex_callback(session, RegexCallbackEvent.Match, 0, 1, 1) == RegexCallbackState.Matching
    assert advance_regex_callback(session, RegexCallbackEvent.Replace, replacement_bytes: 1) == RegexCallbackState.Matching
    assert advance_regex_callback(session, RegexCallbackEvent.Match, 2, 3) == RegexCallbackState.Matching
    assert advance_regex_callback(session, RegexCallbackEvent.Replace, replacement_bytes: 1) == RegexCallbackState.Matching
    assert advance_regex_callback(session, RegexCallbackEvent.End) == RegexCallbackState.Complete
    assert session.output_bytes == 5
    zero: mutable RegexCallbackSession = RegexCallbackSession{policy: policy, input_bytes: 2}
    _ = advance_regex_callback(zero, RegexCallbackEvent.Begin)
    _ = advance_regex_callback(zero, RegexCallbackEvent.Match, 0, 0)
    _ = advance_regex_callback(zero, RegexCallbackEvent.Replace)
    _ = advance_regex_callback(zero, RegexCallbackEvent.Match, 1, 1)
    _ = advance_regex_callback(zero, RegexCallbackEvent.Replace)
    assert zero.output_bytes == 2
    stalled_session: mutable RegexCallbackSession = RegexCallbackSession{policy: policy, input_bytes: 1}
    _ = advance_regex_callback(stalled_session, RegexCallbackEvent.Begin)
    _ = advance_regex_callback(stalled_session, RegexCallbackEvent.Match, 1, 1)
    _ = advance_regex_callback(stalled_session, RegexCallbackEvent.Replace)
    stalled: mutable bool = false
    catch advance_regex_callback(stalled_session, RegexCallbackEvent.Match, 1, 1):
        ok value:
            assert false
        error failure:
            assert failure == RegexCallbackError.NonProgress
            stalled <- true
    assert stalled
    single: mutable RegexCallbackSession = RegexCallbackSession{policy: RegexCallbackPolicy{max_matches: 2, max_captures: 2, max_output_bytes: 8, global: false}, input_bytes: 2}
    _ = advance_regex_callback(single, RegexCallbackEvent.Begin)
    _ = advance_regex_callback(single, RegexCallbackEvent.Match, 0, 1)
    _ = advance_regex_callback(single, RegexCallbackEvent.Replace, replacement_bytes: 1)
    single_rejected: mutable bool = false
    catch advance_regex_callback(single, RegexCallbackEvent.Match, 1, 2):
        ok value:
            assert false
        error failure:
            assert failure == RegexCallbackError.MatchLimitExceeded
            single_rejected <- true
    assert single_rejected
    oversized_input: mutable RegexCallbackSession = RegexCallbackSession{policy: policy, input_bytes: 67108865}
    oversized_rejected: mutable bool = false
    catch validate_regex_callback(oversized_input):
        ok value:
            assert false
        error failure:
            assert failure == RegexCallbackError.InputLimitExceeded
            oversized_rejected <- true
    assert oversized_rejected
    forged_planned: mutable bool = false
    catch validate_regex_callback(RegexCallbackSession{policy: policy, input_bytes: 2, cursor: 1}):
        ok value:
            assert false
        error failure:
            assert failure == RegexCallbackError.AccountingInvalid
            forged_planned <- true
    assert forged_planned
    forged_pending: mutable bool = false
    catch validate_regex_callback(RegexCallbackSession{policy: policy, input_bytes: 2, state: RegexCallbackState.Complete, pending: true, pending_end: 1}):
        ok value:
            assert false
        error failure:
            assert failure == RegexCallbackError.InvalidState
            forged_pending <- true
    assert forged_pending
    forged_zero_marker: mutable bool = false
    catch validate_regex_callback(RegexCallbackSession{policy: policy, input_bytes: 2, state: RegexCallbackState.Matching, last_zero_start: 1}):
        ok value:
            assert false
        error failure:
            assert failure == RegexCallbackError.AccountingInvalid
            forged_zero_marker <- true
    assert forged_zero_marker
    forged_zero_offset: mutable bool = false
    catch validate_regex_callback(RegexCallbackSession{policy: policy, input_bytes: 2, state: RegexCallbackState.Matching, has_last_zero: true, last_zero_start: 3}):
        ok value:
            assert false
        error failure:
            assert failure == RegexCallbackError.AccountingInvalid
            forged_zero_offset <- true
    assert forged_zero_offset
    forged_complete_cursor: mutable bool = false
    catch validate_regex_callback(RegexCallbackSession{policy: policy, input_bytes: 2, state: RegexCallbackState.Complete}):
        ok value:
            assert false
        error failure:
            assert failure == RegexCallbackError.AccountingInvalid
            forged_complete_cursor <- true
    assert forged_complete_cursor


@test
def typed_network_contract_is_explicit_and_bounded() -> void:
    request: NetworkRequest = NetworkRequest{url: "https://example.test/api", method: NetworkMethod.Post, headers: ["Content-Type", "application/json", "X-Mode", "test"], body: [123, 125], timeout_micros: 1000000, max_response_bytes: 4096}
    assert validate_network_request(request)
    idempotent_retry: NetworkRetryPolicy = NetworkRetryPolicy{mode: NetworkRetryMode.IdempotentOnly, max_attempts: 3, initial_backoff_micros: 1000, max_backoff_micros: 4000}
    idempotent_request: NetworkRequest = NetworkRequest{url: "https://example.test/read", retry: idempotent_retry, timeout_micros: 1000000}
    assert validate_network_request(idempotent_request)
    assert network_retry_backoff_micros(idempotent_retry, NetworkMethod.Get, 1) == 0
    assert network_retry_backoff_micros(idempotent_retry, NetworkMethod.Get, 2) == 1000
    assert network_retry_backoff_micros(idempotent_retry, NetworkMethod.Get, 3) == 2000
    saturated_retry: NetworkRetryPolicy = NetworkRetryPolicy{mode: NetworkRetryMode.IdempotentOnly, max_attempts: 4, initial_backoff_micros: 1000, max_backoff_micros: 1500}
    assert network_retry_backoff_micros(saturated_retry, NetworkMethod.Get, 3) == 1500
    assert network_retry_backoff_micros(saturated_retry, NetworkMethod.Get, 4) == 1500
    invalid_backoff_attempt: mutable bool = false
    catch network_retry_backoff_micros(idempotent_retry, NetworkMethod.Get, 0):
        ok value:
            assert false
        error issue:
            assert issue == NetworkContractError.InvalidRetryAttempts
            invalid_backoff_attempt <- true
    assert invalid_backoff_attempt
    unsafe_retry: NetworkRetryPolicy = NetworkRetryPolicy{mode: NetworkRetryMode.IdempotentOnly, max_attempts: 3, initial_backoff_micros: 1000, max_backoff_micros: 4000}
    unsafe_request: NetworkRequest = NetworkRequest{url: "https://example.test/mutate", method: NetworkMethod.Post, retry: unsafe_retry, timeout_micros: 1000000}
    unsafe_retry_rejected: mutable bool = false
    catch validate_network_request(unsafe_request):
        ok value:
            assert not value
        error issue:
            assert issue == NetworkContractError.NonIdempotentRetry
            unsafe_retry_rejected <- true
    assert unsafe_retry_rejected
    custom_tls: NetworkTlsPolicy = NetworkTlsPolicy{trust_mode: NetworkTlsTrustMode.CustomBundle, ca_bundle_path: "/etc/example-ca.pem", server_name: "example.test"}
    assert validate_network_tls_policy(custom_tls)
    invalid_tls: NetworkTlsPolicy = NetworkTlsPolicy{trust_mode: NetworkTlsTrustMode.CustomBundle}
    invalid_tls_rejected: mutable bool = false
    catch validate_network_tls_policy(invalid_tls):
        ok value:
            assert not value
        error issue:
            assert issue == NetworkContractError.InvalidTlsBundle
            invalid_tls_rejected <- true
    assert invalid_tls_rejected
    invalid_identity: NetworkTlsPolicy = NetworkTlsPolicy{client_certificate_path: "/tmp/client.pem"}
    identity_rejected: mutable bool = false
    catch validate_network_tls_policy(invalid_identity):
        ok value:
            assert not value
        error issue:
            assert issue == NetworkContractError.InvalidTlsClientIdentity
            identity_rejected <- true
    assert identity_rejected
    stream: mutable NetworkStream = NetworkStream{direction: NetworkStreamDirection.Request, max_buffer_bytes: 8}
    assert advance_network_stream(stream, NetworkStreamEvent.Open) == NetworkStreamState.Open
    first_chunk: NetworkChunk = NetworkChunk{sequence: 0, bytes: [1, 2, 3]}
    assert enqueue_network_chunk(stream, first_chunk)
    assert advance_network_stream(stream, NetworkStreamEvent.Pause) == NetworkStreamState.Paused
    assert consume_network_stream(stream, 1) == 1
    assert advance_network_stream(stream, NetworkStreamEvent.Resume) == NetworkStreamState.Open
    final_chunk: NetworkChunk = NetworkChunk{sequence: 1, bytes: [4], final_chunk: true}
    assert enqueue_network_chunk(stream, final_chunk)
    assert consume_network_stream(stream, 3) == 3
    assert advance_network_stream(stream, NetworkStreamEvent.Finish) == NetworkStreamState.Finished
    bad_stream: mutable NetworkStream = NetworkStream{direction: NetworkStreamDirection.Response, max_buffer_bytes: 8}
    assert advance_network_stream(bad_stream, NetworkStreamEvent.Open) == NetworkStreamState.Open
    bad_chunk: NetworkChunk = NetworkChunk{sequence: 1, bytes: [9]}
    sequence_rejected: mutable bool = false
    catch enqueue_network_chunk(bad_stream, bad_chunk):
        ok value:
            assert not value
        error issue:
            assert issue == NetworkContractError.ChunkSequenceMismatch
            sequence_rejected <- true
    assert sequence_rejected
    unfinished_stream: mutable NetworkStream = NetworkStream{direction: NetworkStreamDirection.Response, max_buffer_bytes: 8}
    assert advance_network_stream(unfinished_stream, NetworkStreamEvent.Open) == NetworkStreamState.Open
    unfinished_chunk: NetworkChunk = NetworkChunk{sequence: 0, bytes: [7]}
    assert enqueue_network_chunk(unfinished_stream, unfinished_chunk)
    incomplete_rejected: mutable bool = false
    catch advance_network_stream(unfinished_stream, NetworkStreamEvent.Finish):
        ok value:
            assert false
        error issue:
            assert issue == NetworkContractError.StreamNotComplete
            incomplete_rejected <- true
    assert incomplete_rejected
    undrained_stream: mutable NetworkStream = NetworkStream{direction: NetworkStreamDirection.Response, max_buffer_bytes: 8}
    assert advance_network_stream(undrained_stream, NetworkStreamEvent.Open) == NetworkStreamState.Open
    undrained_chunk: NetworkChunk = NetworkChunk{sequence: 0, bytes: [8], final_chunk: true}
    assert enqueue_network_chunk(undrained_stream, undrained_chunk)
    undrained_rejected: mutable bool = false
    catch advance_network_stream(undrained_stream, NetworkStreamEvent.Finish):
        ok value:
            assert false
        error issue:
            assert issue == NetworkContractError.StreamNotDrained
            undrained_rejected <- true
    assert undrained_rejected
    cancelled_stream: mutable NetworkStream = NetworkStream{direction: NetworkStreamDirection.Response, max_buffer_bytes: 8}
    assert advance_network_stream(cancelled_stream, NetworkStreamEvent.Open) == NetworkStreamState.Open
    assert enqueue_network_chunk(cancelled_stream, NetworkChunk{sequence: 0, bytes: [5, 6]})
    assert advance_network_stream(cancelled_stream, NetworkStreamEvent.Cancel) == NetworkStreamState.Cancelling
    assert cancelled_stream.buffered_bytes == 0
    assert advance_network_stream(cancelled_stream, NetworkStreamEvent.CancelAck) == NetworkStreamState.Cancelled
    assert validate_network_stream(cancelled_stream)
    forged_cancelled_stream: mutable bool = false
    catch validate_network_stream(NetworkStream{direction: NetworkStreamDirection.Response, max_buffer_bytes: 8, state: NetworkStreamState.Cancelled, buffered_bytes: 1}):
        ok value:
            assert false
        error issue:
            assert issue == NetworkContractError.StreamAccountingInvalid
            forged_cancelled_stream <- true
    assert forged_cancelled_stream
    forged_finished: mutable NetworkStream = NetworkStream{direction: NetworkStreamDirection.Response, state: NetworkStreamState.Finished, final_seen: true}
    forged_finished_rejected: mutable bool = false
    catch validate_network_stream(forged_finished):
        ok value:
            assert false
        error issue:
            assert issue == NetworkContractError.StreamAccountingInvalid
            forged_finished_rejected <- true
    assert forged_finished_rejected
    job: mutable NetworkRequestJob = NetworkRequestJob{max_attempts: 2}
    assert advance_network_request(job, NetworkRequestEvent.Begin) == NetworkRequestState.Resolving
    assert advance_network_request(job, NetworkRequestEvent.DnsReady) == NetworkRequestState.Connecting
    assert advance_network_request(job, NetworkRequestEvent.ConnectReady) == NetworkRequestState.Securing
    assert advance_network_request(job, NetworkRequestEvent.TlsReady) == NetworkRequestState.Sending
    assert advance_network_request(job, NetworkRequestEvent.Cancel) == NetworkRequestState.Cancelling
    assert advance_network_request(job, NetworkRequestEvent.CancelAck) == NetworkRequestState.Cancelled
    retry_job: mutable NetworkRequestJob = NetworkRequestJob{max_attempts: 2}
    assert advance_network_request(retry_job, NetworkRequestEvent.Begin) == NetworkRequestState.Resolving
    assert advance_network_request(retry_job, NetworkRequestEvent.Fail) == NetworkRequestState.Failed
    assert advance_network_request(retry_job, NetworkRequestEvent.Retry) == NetworkRequestState.Planned
    assert advance_network_request(retry_job, NetworkRequestEvent.Begin) == NetworkRequestState.Resolving
    assert advance_network_request(retry_job, NetworkRequestEvent.Fail) == NetworkRequestState.Failed
    retry_exhausted: mutable bool = false
    catch advance_network_request(retry_job, NetworkRequestEvent.Retry):
        ok value:
            assert false
        error issue:
            assert issue == NetworkContractError.RetryLimitExceeded
            retry_exhausted <- true
    assert retry_exhausted
    forged_retry_budget: mutable bool = false
    catch advance_network_request(NetworkRequestJob{state: NetworkRequestState.Planned, attempts: 2, max_attempts: 2}, NetworkRequestEvent.Begin):
        ok value:
            assert false
        error issue:
            assert issue == NetworkContractError.RetryLimitExceeded
            forged_retry_budget <- true
    assert forged_retry_budget
    forged_active_attempt: mutable bool = false
    catch advance_network_request(NetworkRequestJob{state: NetworkRequestState.Receiving, max_attempts: 2}, NetworkRequestEvent.ReceiveComplete):
        ok value:
            assert false
        error issue:
            assert issue == NetworkContractError.InvalidRequestState
            forged_active_attempt <- true
    assert forged_active_attempt
    response: NetworkResponse = NetworkResponse{outcome: NetworkOutcome.Success, status: 200, headers: ["Content-Type", "application/json"], body: [123, 125]}
    assert validate_network_response(response)
    forged_success_status: mutable bool = false
    catch validate_network_response(NetworkResponse{outcome: NetworkOutcome.Success, status: 500}):
        ok value:
            assert false
        error issue:
            assert issue == NetworkContractError.InvalidStatus
            forged_success_status <- true
    assert forged_success_status
    forged_failure_status: mutable bool = false
    catch validate_network_response(NetworkResponse{outcome: NetworkOutcome.StatusFailure, status: 200}):
        ok value:
            assert false
        error issue:
            assert issue == NetworkContractError.InvalidStatus
            forged_failure_status <- true
    assert forged_failure_status
    failure: NetworkResponse = NetworkResponse{outcome: NetworkOutcome.Timeout, status: 0, error_text: "deadline"}
    assert validate_network_response(failure)
    tls_failure: NetworkResponse = NetworkResponse{outcome: NetworkOutcome.TlsFailure, status: 0, error_text: "certificate"}
    assert validate_network_response(tls_failure)
    invalid_headers: NetworkRequest = NetworkRequest{url: "https://example.test", headers: ["X-Test", "one", "X-Test", "two"], timeout_micros: 1}
    duplicate_rejected: mutable bool = false
    catch validate_network_request(invalid_headers):
        ok value:
            assert not value
        error issue:
            assert issue == NetworkContractError.DuplicateHeaderName
            duplicate_rejected <- true
    assert duplicate_rejected
    invalid_timeout: NetworkRequest = NetworkRequest{url: "https://example.test"}
    timeout_rejected: mutable bool = false
    catch validate_network_request(invalid_timeout):
        ok value:
            assert not value
        error issue:
            assert issue == NetworkContractError.InvalidTimeout
            timeout_rejected <- true
    assert timeout_rejected
    invalid_failure_status: NetworkResponse = NetworkResponse{outcome: NetworkOutcome.TransportFailure, status: 500}
    status_rejected: mutable bool = false
    catch validate_network_response(invalid_failure_status):
        ok value:
            assert not value
        error issue:
            assert issue == NetworkContractError.InvalidStatus
            status_rejected <- true
    assert status_rejected


@test
def typed_network_session_contract_accounts_send_receive_and_cancel() -> void:
    request: NetworkRequest = NetworkRequest{url: "https://example.test/read", timeout_micros: 1000000, max_response_bytes: 128}
    session: mutable NetworkSession = NetworkSession{request: request}
    assert validate_network_session(session)
    assert advance_network_session(session, NetworkSessionEvent.Begin) == NetworkSessionState.Resolving
    assert advance_network_session(session, NetworkSessionEvent.DnsReady) == NetworkSessionState.Connecting
    assert advance_network_session(session, NetworkSessionEvent.ConnectReady) == NetworkSessionState.Securing
    assert advance_network_session(session, NetworkSessionEvent.TlsReady) == NetworkSessionState.Sending
    assert advance_network_session(session, NetworkSessionEvent.SendComplete) == NetworkSessionState.Receiving
    assert advance_network_session(session, NetworkSessionEvent.ReceiveChunk, 8) == NetworkSessionState.Receiving
    assert advance_network_session(session, NetworkSessionEvent.ReceiveComplete, 0, NetworkOutcome.Success, 200) == NetworkSessionState.Completed
    redirect_request: NetworkRequest = NetworkRequest{url: "https://example.test/read", timeout_micros: 1000000, max_response_bytes: 128, follow_redirects: true}
    redirect: mutable NetworkSession = NetworkSession{request: redirect_request}
    assert advance_network_session(redirect, NetworkSessionEvent.Begin) == NetworkSessionState.Resolving
    assert advance_network_session(redirect, NetworkSessionEvent.DnsReady) == NetworkSessionState.Connecting
    assert advance_network_session(redirect, NetworkSessionEvent.ConnectReady) == NetworkSessionState.Securing
    assert advance_network_session(redirect, NetworkSessionEvent.TlsReady) == NetworkSessionState.Sending
    assert advance_network_session(redirect, NetworkSessionEvent.SendComplete) == NetworkSessionState.Receiving
    assert advance_network_session(redirect, NetworkSessionEvent.Redirect, 0, NetworkOutcome.Success, 302) == NetworkSessionState.Resolving
    assert redirect.redirects == 1 and redirect.sent_bytes == 0 and redirect.received_bytes == 0
    assert advance_network_session(redirect, NetworkSessionEvent.DnsReady) == NetworkSessionState.Connecting
    assert advance_network_session(redirect, NetworkSessionEvent.ConnectReady) == NetworkSessionState.Securing
    assert advance_network_session(redirect, NetworkSessionEvent.TlsReady) == NetworkSessionState.Sending
    assert advance_network_session(redirect, NetworkSessionEvent.SendComplete) == NetworkSessionState.Receiving
    assert advance_network_session(redirect, NetworkSessionEvent.ReceiveComplete, 0, NetworkOutcome.Success, 200) == NetworkSessionState.Completed
    invalid_redirect_status: mutable NetworkSession = NetworkSession{request: redirect_request, state: NetworkSessionState.Receiving, attempts: 1}
    invalid_redirect: mutable bool = false
    catch advance_network_session(invalid_redirect_status, NetworkSessionEvent.Redirect, 0, NetworkOutcome.Success, 200):
        ok value:
            assert false
        error failure:
            assert failure == NetworkSessionError.InvalidRedirectStatus
            invalid_redirect <- true
    assert invalid_redirect
    exhausted_redirect: mutable NetworkSession = NetworkSession{request: redirect_request, state: NetworkSessionState.Receiving, attempts: 1, redirects: Limits::REDIRECTS}
    redirect_exhausted: mutable bool = false
    catch advance_network_session(exhausted_redirect, NetworkSessionEvent.Redirect, 0, NetworkOutcome.Success, 302):
        ok value:
            assert false
        error failure:
            assert failure == NetworkSessionError.RedirectLimitExceeded
            redirect_exhausted <- true
    assert redirect_exhausted
    redirects_disabled: mutable bool = false
    catch advance_network_session(NetworkSession{request: request, state: NetworkSessionState.Receiving, attempts: 1}, NetworkSessionEvent.Redirect, 0, NetworkOutcome.Success, 302):
        ok value:
            assert false
        error failure:
            assert failure == NetworkSessionError.RedirectNotAllowed
            redirects_disabled <- true
    assert redirects_disabled
    cancellation: mutable NetworkSession = NetworkSession{request: request}
    assert advance_network_session(cancellation, NetworkSessionEvent.Begin) == NetworkSessionState.Resolving
    assert advance_network_session(cancellation, NetworkSessionEvent.Cancel) == NetworkSessionState.Cancelling
    assert advance_network_session(cancellation, NetworkSessionEvent.CancelAck) == NetworkSessionState.Cancelled
    failed_cancel: mutable NetworkSession = NetworkSession{request: request}
    assert advance_network_session(failed_cancel, NetworkSessionEvent.Begin) == NetworkSessionState.Resolving
    failed_cancel_rejected: mutable bool = false
    catch advance_network_session(failed_cancel, NetworkSessionEvent.Fail, 0, NetworkOutcome.Cancelled):
        ok value:
            assert false
        error failure:
            assert failure == NetworkSessionError.InvalidOutcome
            failed_cancel_rejected <- true
    assert failed_cancel_rejected
    forged_completed: mutable NetworkSession = NetworkSession{request: request, state: NetworkSessionState.Completed, outcome: NetworkOutcome.Success}
    forged_completed_error: mutable bool = false
    catch validate_network_session(forged_completed):
        ok value:
            assert false
        error failure:
            assert failure == NetworkSessionError.AccountingInvalid
            forged_completed_error <- true
    assert forged_completed_error
    forged_unsent: mutable bool = false
    catch validate_network_session(NetworkSession{request: NetworkRequest{url: "https://example.test/write", body: [1], timeout_micros: 1000000}, state: NetworkSessionState.Completed, outcome: NetworkOutcome.Success, status: 200}):
        ok value:
            assert false
        error failure:
            assert failure == NetworkSessionError.AccountingInvalid
            forged_unsent <- true
    assert forged_unsent
    forged_completed_outcome: mutable bool = false
    catch validate_network_session(NetworkSession{request: request, state: NetworkSessionState.Completed, outcome: NetworkOutcome.Success, status: 500}):
        ok value:
            assert false
        error issue:
            assert issue == NetworkSessionError.AccountingInvalid
            forged_completed_outcome <- true
    assert forged_completed_outcome
    forged_cancelled: mutable NetworkSession = NetworkSession{request: request, state: NetworkSessionState.Cancelled, outcome: NetworkOutcome.Success}
    forged_cancelled_error: mutable bool = false
    catch validate_network_session(forged_cancelled):
        ok value:
            assert false
        error failure:
            assert failure == NetworkSessionError.AccountingInvalid
            forged_cancelled_error <- true
    assert forged_cancelled_error
    forged_cancelled_without_attempt: mutable bool = false
    catch validate_network_session(NetworkSession{request: request, state: NetworkSessionState.Cancelled, outcome: NetworkOutcome.Cancelled}):
        ok value:
            assert false
        error failure:
            assert failure == NetworkSessionError.AccountingInvalid
            forged_cancelled_without_attempt <- true
    assert forged_cancelled_without_attempt
    failed_status: mutable NetworkSession = NetworkSession{request: request}
    assert advance_network_session(failed_status, NetworkSessionEvent.Begin) == NetworkSessionState.Resolving
    assert advance_network_session(failed_status, NetworkSessionEvent.Fail, 0, NetworkOutcome.StatusFailure, 500) == NetworkSessionState.Failed
    assert failed_status.status == 500
    forged_failed_status: mutable bool = false
    catch validate_network_session(NetworkSession{request: request, state: NetworkSessionState.Failed, outcome: NetworkOutcome.StatusFailure}):
        ok value:
            assert false
        error failure:
            assert failure == NetworkSessionError.AccountingInvalid
            forged_failed_status <- true
    assert forged_failed_status
    forged_active_status: mutable bool = false
    catch validate_network_session(NetworkSession{request: request, state: NetworkSessionState.Receiving, status: 200}):
        ok value:
            assert false
        error failure:
            assert failure == NetworkSessionError.AccountingInvalid
            forged_active_status <- true
    assert forged_active_status


@test
def typed_file_stream_contract_is_bounded_and_stateful() -> void:
    assert FILE_STREAM_DEFAULT_MAX_BYTES == ES_RUNTIME_DEFAULT_MAX_MEMORY_BYTES
    cleanup: mutable FileStreamCleanupGuard = file_stream_cleanup_begin()
    assert cleanup.state == FileStreamCleanupState.Armed
    assert file_stream_cleanup_transition(cleanup.state, FileStreamCleanupEvent.Commit) == FileStreamCleanupState.Closed
    assert file_stream_cleanup_transition(cleanup.state, FileStreamCleanupEvent.Abort) == FileStreamCleanupState.Aborted
    assert file_stream_cleanup_transition(FileStreamCleanupState.Closed, FileStreamCleanupEvent.Commit) == FileStreamCleanupState.Closed
    assert file_stream_cleanup_transition(FileStreamCleanupState.Closed, FileStreamCleanupEvent.Abort) == FileStreamCleanupState.Closed
    assert file_stream_cleanup_transition(FileStreamCleanupState.Aborted, FileStreamCleanupEvent.Commit) == FileStreamCleanupState.Aborted
    assert file_stream_cleanup_transition(FileStreamCleanupState.Aborted, FileStreamCleanupEvent.Abort) == FileStreamCleanupState.Aborted
    closed: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.ReadBinary, state: FileStreamState.Closed, byte_budget: 1}
    assert closed.state == FileStreamState.Closed
    assert closed.bytes_read == 0
    assert closed.bytes_written == 0
    assert closed.byte_budget == 1


@test
def typed_file_stream_write_contract_retries_short_progress() -> void:
    assert file_stream_write_transition(0, 8, 3, 8) == FileStreamWriteState.Progress
    assert file_stream_write_transition(3, 8, 5, 5) == FileStreamWriteState.Done
    assert file_stream_write_transition(0, 8, 0, 8) == FileStreamWriteState.Error
    assert file_stream_write_transition(0, 8, 9, 8) == FileStreamWriteState.Error
    assert file_stream_write_transition(9, 8, 0, 8) == FileStreamWriteState.Error
    assert file_stream_write_transition(0, 8, 4, 3) == FileStreamWriteState.Limit


@test
def typed_file_stream_newline_modes_are_explicit() -> void:
    assert FileStreamLineMode.Lf != FileStreamLineMode.Universal
    assert FileStreamLineMode.Universal != FileStreamLineMode.Retain
    assert FileStreamLineMode.Lf != FileStreamLineMode.Retain
    stream: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.ReadText, state: FileStreamState.Closed, byte_budget: 1}
    assert not stream.pending_valid
    assert stream.pending_byte == 0u8


@test
def typed_file_stream_pending_lookahead_is_shared_by_readers() -> void:
    stream: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.ReadBinary, state: FileStreamState.Closed, byte_budget: 2, pending_byte: 65u8, pending_valid: true}
    assert stream.pending_valid
    assert stream.pending_byte == 65u8


@test
def typed_file_stream_seek_origins_are_explicit() -> void:
    assert FileStreamSeekOrigin.Begin != FileStreamSeekOrigin.Current
    assert FileStreamSeekOrigin.Current != FileStreamSeekOrigin.End
    assert FileStreamSeekOrigin.Begin != FileStreamSeekOrigin.End


@test
def typed_file_stream_sync_is_write_only_and_flushes_first() -> void:
    writable: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.WriteBinary, state: FileStreamState.Closed, byte_budget: 1}
    readable: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.ReadBinary, state: FileStreamState.Closed, byte_budget: 1}
    assert writable.mode == FileStreamMode.WriteBinary
    assert readable.mode == FileStreamMode.ReadBinary


@test
def typed_file_stream_staged_publication_contract_is_explicit() -> void:
    assert FileStreamMode.WriteBinary != FileStreamMode.ReadBinary
    assert FileStreamState.Open != FileStreamState.Closed


@test
def typed_source_encoding_contract_is_strict() -> void:
    three: mutable EsEncoding::Utf8Cursor = EsEncoding::Utf8Cursor{}
    assert EsEncoding::utf8_feed(224u8, three)
    assert three.remaining == 2u8
    assert three.lower == 160u8
    assert not EsEncoding::utf8_feed(159u8, three)
    four: mutable EsEncoding::Utf8Cursor = EsEncoding::Utf8Cursor{}
    assert EsEncoding::utf8_feed(240u8, four)
    assert four.remaining == 3u8
    assert four.lower == 144u8
    assert EsEncoding::utf8_feed(144u8, four)
    assert EsEncoding::utf8_feed(128u8, four)
    assert EsEncoding::utf8_feed(128u8, four)
    assert EsEncoding::utf8_complete(four)
    surrogate: mutable EsEncoding::Utf8Cursor = EsEncoding::Utf8Cursor{}
    assert EsEncoding::utf8_feed(237u8, surrogate)
    assert not EsEncoding::utf8_feed(160u8, surrogate)
    out_of_range: mutable EsEncoding::Utf8Cursor = EsEncoding::Utf8Cursor{}
    assert EsEncoding::utf8_feed(244u8, out_of_range)
    assert not EsEncoding::utf8_feed(144u8, out_of_range)


@test
def typed_file_stream_encoding_policy_is_explicit() -> void:
    assert FileStreamEncoding.Auto != FileStreamEncoding.Bytes
    assert FileStreamEncoding.Bytes != FileStreamEncoding.Utf8
    assert FileStreamEncoding.Auto != FileStreamEncoding.Utf8
    stream: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.ReadText, state: FileStreamState.Closed, byte_budget: 1, encoding: FileStreamEncoding.Utf8}
    assert stream.encoding == FileStreamEncoding.Utf8
    assert stream.utf8_remaining == 0u8


@test
def typed_file_stream_utf8_boundary_state_is_explicit() -> void:
    split_three: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.ReadText, state: FileStreamState.Closed, byte_budget: 3, encoding: FileStreamEncoding.Utf8, utf8_remaining: 2u8, utf8_lower: 160u8, utf8_upper: 191u8}
    assert split_three.utf8_remaining == 2u8
    assert split_three.utf8_lower == 160u8
    assert split_three.utf8_upper == 191u8
    split_four: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.WriteText, state: FileStreamState.Closed, byte_budget: 4, encoding: FileStreamEncoding.Utf8, utf8_remaining: 3u8, utf8_lower: 144u8, utf8_upper: 191u8}
    assert split_four.utf8_remaining == 3u8
    assert split_four.utf8_lower == 144u8
    assert split_four.utf8_upper == 191u8


@test
def typed_file_stream_close_rejects_open_without_handle() -> void:
    can Blocking.IO, Memory.Release:
        malformed: mutable FileStream = FileStream{handle: null, path: "malformed", mode: FileStreamMode.ReadBinary, state: FileStreamState.Open, byte_budget: 1}
        rejected: mutable bool = false
        catch file_stream_close(malformed):
            ok:
                assert false
            error failure:
                rejected <- true
        assert rejected


@test
def artifact_cache_file_io_contract_is_typed_and_fail_closed() -> void:
    invalid: ArtifactCacheLoad = ArtifactCacheLoad{bytes: [], decision: ArtifactCacheDecision{kind: ArtifactCacheKind.IrMetadata, admission: ArtifactCacheAdmission.Invalid}}
    assert invalid.bytes.count == 0
    assert invalid.decision.admission == ArtifactCacheAdmission.Invalid
    assert artifact_cache_lifecycle_transition(ArtifactCacheLifecycle.Empty, ArtifactCacheEvent.Stage) == ArtifactCacheLifecycle.Staged
    assert artifact_cache_lifecycle_transition(ArtifactCacheLifecycle.Staged, ArtifactCacheEvent.Commit) == ArtifactCacheLifecycle.Committed
    assert artifact_cache_lifecycle_transition(ArtifactCacheLifecycle.Staged, ArtifactCacheEvent.Abort) == ArtifactCacheLifecycle.Rejected
    assert artifact_cache_recovery_action(ArtifactCacheLifecycle.Committed, false, true, true) == ArtifactCacheRecoveryAction.KeepPublished
    assert artifact_cache_recovery_action(ArtifactCacheLifecycle.Committed, true, false, false) == ArtifactCacheRecoveryAction.RebuildPublished
    assert artifact_cache_recovery_action(ArtifactCacheLifecycle.Staged, true, false, false) == ArtifactCacheRecoveryAction.RemoveStaging
    assert artifact_cache_recovery_action(ArtifactCacheLifecycle.Staged, false, true, true) == ArtifactCacheRecoveryAction.RebuildPublished
    assert artifact_cache_recovery_action(ArtifactCacheLifecycle.Staged, false, false, false) == ArtifactCacheRecoveryAction.Noop
    assert artifact_cache_recovery_action(ArtifactCacheLifecycle.Empty, true, true, true) == ArtifactCacheRecoveryAction.RemoveStaging
    assert artifact_cache_recovery_action(ArtifactCacheLifecycle.Rejected, false, true, true) == ArtifactCacheRecoveryAction.Noop
    lease: mutable ArtifactCacheWriterLease = ArtifactCacheWriterLease{}
    assert artifact_cache_writer_acquire(lease, 41)
    assert not artifact_cache_writer_acquire(lease, 42)
    assert not artifact_cache_writer_publish(lease, 42)
    assert artifact_cache_writer_publish(lease, 41)
    assert not artifact_cache_writer_abort(lease, 41)
    aborted: mutable ArtifactCacheWriterLease = ArtifactCacheWriterLease{}
    assert artifact_cache_writer_acquire(aborted, 7)
    assert artifact_cache_writer_abort(aborted, 7)
    assert aborted.state == ArtifactCacheWriterState.Aborted
    assert not artifact_cache_writer_acquire(aborted, 0)
    assert artifact_cache_writer_acquire(aborted, 8)
    assert not artifact_cache_writer_publish(aborted, 7)
    assert artifact_cache_writer_publish(aborted, 8)
    lock: ArtifactCacheWriterLock = ArtifactCacheWriterLock{}
    assert lock.state == ArtifactCacheWriterLockState.Available
    assert lock.owner_token == 0
    assert lock.path == ""
    assert artifact_cache_writer_lock_transition(ArtifactCacheWriterLockState.Available, ArtifactCacheWriterLockEvent.Acquire) == ArtifactCacheWriterLockState.Held
    assert artifact_cache_writer_lock_transition(ArtifactCacheWriterLockState.Held, ArtifactCacheWriterLockEvent.Acquire) == ArtifactCacheWriterLockState.Held
    assert artifact_cache_writer_lock_transition(ArtifactCacheWriterLockState.Held, ArtifactCacheWriterLockEvent.Release) == ArtifactCacheWriterLockState.Released
    assert artifact_cache_writer_lock_transition(ArtifactCacheWriterLockState.Released, ArtifactCacheWriterLockEvent.Acquire) == ArtifactCacheWriterLockState.Held
    assert artifact_cache_writer_lock_transition(ArtifactCacheWriterLockState.Available, ArtifactCacheWriterLockEvent.Release) == ArtifactCacheWriterLockState.Available
    assert artifact_cache_writer_lock_transition(ArtifactCacheWriterLockState.Released, ArtifactCacheWriterLockEvent.Release) == ArtifactCacheWriterLockState.Released


@test
def backend_resource_limits_share_the_runtime_call_depth_contract() -> void:
    assert ES_RUNTIME_DEFAULT_MAX_EXECUTION_CALL_DEPTH == 4096
    assert ES_RUNTIME_DEFAULT_MAX_VALUE_EQUAL_DEPTH == 128
    assert ES_RUNTIME_DEFAULT_MAX_ERROR_GUARD_DEPTH == 4096
    # Public regex adapters and policy-aware interpretation must use the same
    # ceiling; otherwise direct bytecode can accept more matcher work than the
    # shared runtime contract permits.
    assert ES_RUNTIME_DEFAULT_MAX_REGEX_WORK == 67108864


@test
def runtime_resource_policy_tracks_zero_and_boundary_budgets() -> void:
    policy: RuntimeResourcePolicy = RuntimeResourcePolicy{steps: 3, memory_bytes: 1024, output_bytes: 2048, retained_traces: 4}
    assert runtime_resource_policy_valid(policy)
    assert runtime_resource_policy_has_unaccounted_dimensions(policy)
    supported: RuntimeResourcePolicy = RuntimeResourcePolicy{steps: 3, output_bytes: 2048, regex_work: 1024, retained_traces: 4}
    assert not runtime_resource_policy_has_unaccounted_dimensions(supported)
    process_limited: RuntimeResourcePolicy = RuntimeResourcePolicy{processes: 0}
    assert not runtime_resource_policy_has_unaccounted_dimensions(process_limited)
    # Short-lived interpreter host handles are leased, but a narrowed
    # per-run handle policy remains rejected until standalone FileStream can
    # share the same usage ledger for its full public lifetime.
    handle_limited: RuntimeResourcePolicy = RuntimeResourcePolicy{open_handles: 0}
    assert runtime_resource_policy_has_unaccounted_dimensions(handle_limited)
    usage: RuntimeResourceUsage = RuntimeResourceUsage{steps: 3, memory_bytes: 1024, output_bytes: 2048, retained_traces: 4}
    assert runtime_resource_usage_within_policy(usage, policy)
    usage.steps <- 4
    assert not runtime_resource_usage_within_policy(usage, policy)

    zero: RuntimeResourcePolicy = RuntimeResourcePolicy{steps: 0, memory_bytes: 0, output_bytes: 0, retained_traces: 0}
    empty: RuntimeResourceUsage = RuntimeResourceUsage{}
    assert runtime_resource_usage_within_policy(empty, zero)
    empty.memory_bytes <- 1
    assert not runtime_resource_usage_within_policy(empty, zero)
    unattached_usage: RuntimeResourceUsage = RuntimeResourceUsage{elapsed_micros: 1}
    assert not runtime_resource_usage_within_policy(unattached_usage, zero)

    narrowed: RuntimeResourcePolicy = runtime_resource_policy_with_step_limit(policy, 1)
    assert narrowed.steps == 1
    assert narrowed.memory_bytes == policy.memory_bytes

    partial_usage: RuntimeResourceUsage = RuntimeResourceUsage{steps: 1, memory_bytes: 256, output_bytes: 512, retained_traces: 1}
    remaining: RuntimeResourcePolicy = runtime_resource_remaining_policy(partial_usage, policy)
    assert remaining.steps == 2
    assert remaining.memory_bytes == 768
    assert remaining.output_bytes == 1536
    assert remaining.retained_traces == 3
    exhausted: RuntimeResourceUsage = RuntimeResourceUsage{steps: 4, memory_bytes: 2048, output_bytes: 4096, retained_traces: 8}
    exhausted_remaining: RuntimeResourcePolicy = runtime_resource_remaining_policy(exhausted, policy)
    assert exhausted_remaining.steps == 0
    assert exhausted_remaining.memory_bytes == 0
    assert exhausted_remaining.output_bytes == 0
    assert exhausted_remaining.retained_traces == 0
    elapsed_remaining: RuntimeResourcePolicy = runtime_resource_remaining_policy(RuntimeResourceUsage{elapsed_micros: 9}, RuntimeResourcePolicy{elapsed_micros: 0})
    assert elapsed_remaining.elapsed_micros == 0

    handles_over: RuntimeResourcePolicy = policy
    steps_over: RuntimeResourcePolicy = policy
    steps_over.steps <- ES_RUNTIME_DEFAULT_MAX_STEPS + 1
    assert not runtime_resource_policy_valid(steps_over)
    handles_over.open_handles <- ES_RUNTIME_DEFAULT_MAX_OPEN_HANDLES + 1
    assert not runtime_resource_policy_valid(handles_over)
    processes_over: RuntimeResourcePolicy = policy
    processes_over.processes <- ES_RUNTIME_DEFAULT_MAX_PROCESSES + 1
    assert not runtime_resource_policy_valid(processes_over)
    tasks_over: RuntimeResourcePolicy = policy
    tasks_over.concurrent_tasks <- ES_RUNTIME_DEFAULT_MAX_CONCURRENT_TASKS + 1
    assert not runtime_resource_policy_valid(tasks_over)

    counters: mutable RuntimeResourceUsage = RuntimeResourceUsage{}
    assert runtime_resource_acquire(counters, policy, RuntimeResourceCounter.OpenHandle)
    assert runtime_resource_acquire(counters, policy, RuntimeResourceCounter.Process)
    assert runtime_resource_acquire(counters, policy, RuntimeResourceCounter.ConcurrentTask)
    assert counters.open_handles == 1
    assert counters.processes == 1
    assert counters.concurrent_tasks == 1
    assert runtime_resource_release(counters, RuntimeResourceCounter.OpenHandle)
    assert runtime_resource_release(counters, RuntimeResourceCounter.Process)
    assert runtime_resource_release(counters, RuntimeResourceCounter.ConcurrentTask)
    assert not runtime_resource_release(counters, RuntimeResourceCounter.OpenHandle)

    bounded: mutable RuntimeResourceUsage = RuntimeResourceUsage{}
    assert runtime_resource_add_steps(bounded, policy, 3)
    assert not runtime_resource_add_steps(bounded, policy, 1)
    elapsed_policy: RuntimeResourcePolicy = RuntimeResourcePolicy{elapsed_micros: 8}
    elapsed: mutable RuntimeResourceUsage = RuntimeResourceUsage{}
    assert runtime_resource_add_elapsed(elapsed, elapsed_policy, 8)
    assert elapsed.elapsed_micros == 8
    assert not runtime_resource_add_elapsed(elapsed, elapsed_policy, 1)
    unattached: mutable RuntimeResourceUsage = RuntimeResourceUsage{}
    assert runtime_resource_add_elapsed(unattached, RuntimeResourcePolicy{}, 999)
    assert unattached.elapsed_micros == 0
    assert runtime_resource_add_memory(bounded, policy, policy.memory_bytes)
    assert not runtime_resource_add_memory(bounded, policy, 1)
    assert runtime_resource_add_output(bounded, policy, policy.output_bytes)
    assert not runtime_resource_add_output(bounded, policy, 1)
    assert runtime_resource_add_regex_work(bounded, policy, policy.regex_work)
    assert not runtime_resource_add_regex_work(bounded, policy, 1)
    assert runtime_resource_add_retained_traces(bounded, policy, policy.retained_traces)
    assert not runtime_resource_add_retained_traces(bounded, policy, 1)
    tiny_policy: RuntimeResourcePolicy = RuntimeResourcePolicy{open_handles: 1, processes: 1, concurrent_tasks: 1}
    tiny_usage: mutable RuntimeResourceUsage = RuntimeResourceUsage{}
    assert runtime_resource_acquire(tiny_usage, tiny_policy, RuntimeResourceCounter.OpenHandle)
    assert runtime_resource_acquire(tiny_usage, tiny_policy, RuntimeResourceCounter.Process)
    assert runtime_resource_acquire(tiny_usage, tiny_policy, RuntimeResourceCounter.ConcurrentTask)
    assert not runtime_resource_acquire(tiny_usage, tiny_policy, RuntimeResourceCounter.OpenHandle)
    assert not runtime_resource_acquire(tiny_usage, tiny_policy, RuntimeResourceCounter.Process)
    assert not runtime_resource_acquire(tiny_usage, tiny_policy, RuntimeResourceCounter.ConcurrentTask)
    assert runtime_resource_release(tiny_usage, RuntimeResourceCounter.OpenHandle)
    assert runtime_resource_release(tiny_usage, RuntimeResourceCounter.Process)
    assert runtime_resource_release(tiny_usage, RuntimeResourceCounter.ConcurrentTask)
    assert not runtime_resource_release(tiny_usage, RuntimeResourceCounter.OpenHandle)
    assert not runtime_resource_release(tiny_usage, RuntimeResourceCounter.Process)
    assert not runtime_resource_release(tiny_usage, RuntimeResourceCounter.ConcurrentTask)

    zero_resource_policy: RuntimeResourcePolicy = RuntimeResourcePolicy{open_handles: 0, processes: 0, concurrent_tasks: 0}
    zero_resource_usage: mutable RuntimeResourceUsage = RuntimeResourceUsage{}
    assert not runtime_resource_acquire(zero_resource_usage, zero_resource_policy, RuntimeResourceCounter.OpenHandle)
    assert not runtime_resource_acquire(zero_resource_usage, zero_resource_policy, RuntimeResourceCounter.Process)
    assert not runtime_resource_acquire(zero_resource_usage, zero_resource_policy, RuntimeResourceCounter.ConcurrentTask)


@test
def serialized_slice_bounds_use_subtraction_before_end_addition() -> void:
    end: mutable usize = 0
    assert runtime_bounded_slice_end(4, 3, 8, end)
    assert end == 7
    assert not runtime_bounded_slice_end(9, 0, 8, end)
    assert not runtime_bounded_slice_end(7, 2, 8, end)


@test
def canonical_sha256_matches_known_vectors() -> void:
    empty: darray[u8] = []
    empty_digest: darray[u8] = canonical_bytes_sha256(empty)
    assert empty_digest.count == 32
    assert empty_digest[0] == 0xe3
    assert empty_digest[1] == 0xb0
    assert empty_digest[30] == 0xb8
    assert empty_digest[31] == 0x55

    abc: darray[u8] = [97, 98, 99]
    abc_digest: darray[u8] = canonical_bytes_sha256(abc)
    assert abc_digest.count == 32
    assert abc_digest[0] == 0xbau8
    assert abc_digest[1] == 0x78u8
    assert abc_digest[30] == 0x15u8
    assert abc_digest[31] == 0xadu8


@test
def interned_type_table_deduplicates_recursive_shapes() -> void:
    can Memory.Allocate, Abort.Panic:
        nested: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Array, element_element_kind: TypeKind.Int, element_element_bits: 64, element_element_signed: true}
        parameter: Parameter = Parameter{value: 1, type: nested, name: "values"}
        fn: Function = Function{name: "typed", parameters: [parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [], entry: 0}
        module: mutable Module = Module{name: "types", functions: [fn]}
        intern_module_types(module)
        assert module.type_table.rows.count == 4
        assert module.functions[0].parameters[0].type.descriptor_id != 0
        assert type_table_matches_inline(module.functions[0].parameters[0].type, module.functions[0].parameters[0].type.descriptor_id, module.type_table)

        table: mutable TypeTable = TypeTable{rows: [], children: []}
        root_id: u32 = intern_structural_type(nested, table)
        child_id: u32 = table.children[1]
        grandchild_id: u32 = table.children[0]
        assert type_table_child(root_id, 0, table) == child_id
        assert type_table_child(child_id, 0, table) == grandchild_id
        assert root_id != 0
        assert child_id != 0
        assert grandchild_id != 0
        assert table.rows[(grandchild_id - 1).usize()].kind == TypeKind.Int
        assert table.rows.count == 3

        duplicate: mutable TypeTable = TypeTable{rows: [], children: []}
        no_children: darray[u32] = []
        first_id: u32 = intern_type_descriptor(TypeKind.Int, "", 64, true, no_children, duplicate)
        second_id: u32 = intern_type_descriptor(TypeKind.Int, "", 64, true, no_children, duplicate)
        assert first_id == second_id
        assert duplicate.rows.count == 1

        invalid_table: mutable TypeTable = TypeTable{rows: [], children: []}
        invalid_scalar_children: darray[u32] = [0]
        invalid_array_arity: darray[u32] = []
        invalid_forward_child: darray[u32] = [99]
        assert intern_type_descriptor(TypeKind.Int, "", 64, true, invalid_scalar_children, invalid_table) == 0
        assert intern_type_descriptor(TypeKind.Array, "", 0, false, invalid_array_arity, invalid_table) == 0
        assert intern_type_descriptor(TypeKind.Array, "", 0, false, invalid_forward_child, invalid_table) == 0
        assert invalid_table.rows.count == 0

        untyped_module: Module = Module{name: "types", functions: [fn]}
        typed_module: mutable Module = Module{name: "types", functions: [fn]}
        intern_module_types(typed_module)
        assert canonical_module_hash(typed_module) != canonical_module_hash(untyped_module)


def issue_count(issues: darray[Issue]&, kind: IssueKind) -> usize:
    count: mutable usize = 0
    for found in issues |count|:
        count <- count + 1 if found.kind == kind
    return count


@test
def verifier_checks_assertion_shape_and_error_contract() -> void:
    can Memory.Allocate, Abort.Panic:
        position: SourceSpan = span()
        condition: Instruction = Instruction{opcode: Opcode.Constant, result: 1, result_type: bool_type(), boolean: true, span: position}
        assertion: Instruction = Instruction{opcode: Opcode.Assert, result: 0, result_type: void_type(), operand_start: 0, operand_count: 1, span: position}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 2, terminator: Terminator{kind: TerminatorKind.Return, operand: 0, operand_count: 0, span: position}}
        valid_fn: Function = Function{name: "check", parameters: [], return_type: void_type(), effects: [], errors: ["AssertionError"], operand_pool: [1], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [condition, assertion], blocks: [block], entry: 1}
        valid_module: Module = Module{name: "assertion", functions: [valid_fn]}
        assert verify(valid_module).count == 0

        malformed: mutable Function = valid_fn
        malformed.errors <- []
        malformed.instruction_pool[1].result_type <- int_type()
        malformed_module: Module = Module{name: "malformed-assertion", functions: [malformed]}
        malformed_issues: darray[Issue] = verify(malformed_module)
        assert issue_count(malformed_issues, IssueKind.InvalidInstruction) > 0
        assert issue_count(malformed_issues, IssueKind.MissingError) > 0


@test
def verifier_requires_raise_family_not_variant_tag_in_error_row() -> void:
    can Memory.Allocate, Abort.Panic:
        raised: Instruction = Instruction{opcode: Opcode.Raise, result: 0, result_type: void_type(), effect_family: "UserError", effect_operation: "Bad", span: span()}
        term: Terminator = Terminator{kind: TerminatorKind.Return, span: span()}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: term}
        fn: Function = Function{name: "raise-row", parameters: [], return_type: void_type(), effects: [], errors: ["UserError"], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [raised], blocks: [block], entry: 1}
        valid_module: Module = Module{name: "raise-row", functions: [fn]}
        assert issue_count(verify(valid_module), IssueKind.MissingError) == 0

        malformed: mutable Function = fn
        malformed.errors <- ["Bad"]
        malformed_module: Module = Module{name: "raise-wrong-row", functions: [malformed]}
        assert issue_count(verify(malformed_module), IssueKind.MissingError) == 1


@test
def verifier_rejects_integer_formatting_wider_than_runtime_payload() -> void:
    can Memory.Allocate, Abort.Panic:
        position: SourceSpan = span()
        wide_type: Type = Type{kind: TypeKind.Int, bits: 128, signed: true}
        text_type: Type = Type{kind: TypeKind.Text}
        constant: Instruction = Instruction{opcode: Opcode.Constant, result: 1, result_type: wide_type, integer: 7, span: position}
        formatting: Instruction = Instruction{opcode: Opcode.FormatInt, result: 2, result_type: text_type, operand_start: 0, operand_count: 1, span: position}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 2, terminator: Terminator{kind: TerminatorKind.Return, operand: 2, operand_count: 1, span: position}}
        fn: Function = Function{name: "wide-format", parameters: [], return_type: text_type, effects: [], errors: [], operand_pool: [1], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [constant, formatting], blocks: [block], entry: 1}
        module: Module = Module{name: "wide-format", functions: [fn]}
        issues: darray[Issue] = verify(module)
