        then_block: Block = Block{id: 2, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: then_term}
        else_block: Block = Block{id: 3, parameter_start: 0, parameter_count: 0, instruction_start: 1, instruction_count: 0, terminator: else_term}
