            assert false
        error failure:
            assert failure == RecordControlError.FileNotOpen
            missing_file <- true
    assert missing_file


@test
def typed_regex_session_contract_bounds_work_captures_and_replacements() -> void:
    search_request: RegexRequest = RegexRequest{operation: RegexOperation.Search, pattern: "a+", input: "aaa"}
    search: mutable RegexSession = RegexSession{request: search_request}
    assert validate_regex_session(search)
    assert advance_regex_session(search, RegexEvent.Begin) == RegexState.Running
    assert advance_regex_session(search, RegexEvent.Work, 8) == RegexState.Running
    assert advance_regex_session(search, RegexEvent.Match, 1) == RegexState.Running
    assert advance_regex_session(search, RegexEvent.End) == RegexState.Complete
    replacement_request: RegexRequest = RegexRequest{operation: RegexOperation.Replace, pattern: "a", input: "aaa", replacement: "b", global: true}
    replacement: mutable RegexSession = RegexSession{request: replacement_request}
    assert advance_regex_session(replacement, RegexEvent.Begin) == RegexState.Running
    assert advance_regex_session(replacement, RegexEvent.Work, 3) == RegexState.Running
    assert advance_regex_session(replacement, RegexEvent.Replace, 0, 0, 3) == RegexState.Running
    assert advance_regex_session(replacement, RegexEvent.End) == RegexState.Complete
    cancellation: mutable RegexSession = RegexSession{request: search_request}
    assert advance_regex_session(cancellation, RegexEvent.Begin) == RegexState.Running
    assert advance_regex_session(cancellation, RegexEvent.Cancel) == RegexState.Cancelling
    assert advance_regex_session(cancellation, RegexEvent.CancelAck) == RegexState.Cancelled


@test
def typed_network_contract_is_explicit_and_bounded() -> void:
    request: NetworkRequest = NetworkRequest{url: "https://example.test/api", method: NetworkMethod.Post, headers: ["Content-Type", "application/json", "X-Mode", "test"], body: [123, 125], timeout_micros: 1000000, max_response_bytes: 4096}
    assert validate_network_request(request)
    idempotent_retry: NetworkRetryPolicy = NetworkRetryPolicy{mode: NetworkRetryMode.IdempotentOnly, max_attempts: 3, initial_backoff_micros: 1000, max_backoff_micros: 4000}
    idempotent_request: NetworkRequest = NetworkRequest{url: "https://example.test/read", retry: idempotent_retry, timeout_micros: 1000000}
    assert validate_network_request(idempotent_request)
    unsafe_retry: NetworkRetryPolicy = NetworkRetryPolicy{mode: NetworkRetryMode.IdempotentOnly, max_attempts: 3, initial_backoff_micros: 1000, max_backoff_micros: 4000}
    unsafe_request: NetworkRequest = NetworkRequest{url: "https://example.test/mutate", method: NetworkMethod.Post, retry: unsafe_retry, timeout_micros: 1000000}
    unsafe_retry_rejected: mutable bool = false
    catch validate_network_request(unsafe_request):
        ok value:
            assert not value
        error issue:
            assert issue == NetworkContractError.NonIdempotentRetry
            unsafe_retry_rejected <- true
    assert unsafe_retry_rejected
    custom_tls: NetworkTlsPolicy = NetworkTlsPolicy{trust_mode: NetworkTlsTrustMode.CustomBundle, ca_bundle_path: "/etc/example-ca.pem", server_name: "example.test"}
    assert validate_network_tls_policy(custom_tls)
    invalid_tls: NetworkTlsPolicy = NetworkTlsPolicy{trust_mode: NetworkTlsTrustMode.CustomBundle}
    invalid_tls_rejected: mutable bool = false
    catch validate_network_tls_policy(invalid_tls):
        ok value:
            assert not value
        error issue:
            assert issue == NetworkContractError.InvalidTlsBundle
            invalid_tls_rejected <- true
    assert invalid_tls_rejected
    invalid_identity: NetworkTlsPolicy = NetworkTlsPolicy{client_certificate_path: "/tmp/client.pem"}
    identity_rejected: mutable bool = false
    catch validate_network_tls_policy(invalid_identity):
        ok value:
            assert not value
        error issue:
            assert issue == NetworkContractError.InvalidTlsClientIdentity
            identity_rejected <- true
    assert identity_rejected
    stream: mutable NetworkStream = NetworkStream{direction: NetworkStreamDirection.Request, max_buffer_bytes: 8}
    assert advance_network_stream(stream, NetworkStreamEvent.Open) == NetworkStreamState.Open
    first_chunk: NetworkChunk = NetworkChunk{sequence: 0, bytes: [1, 2, 3]}
    assert enqueue_network_chunk(stream, first_chunk)
    assert advance_network_stream(stream, NetworkStreamEvent.Pause) == NetworkStreamState.Paused
    assert consume_network_stream(stream, 1) == 1
    assert advance_network_stream(stream, NetworkStreamEvent.Resume) == NetworkStreamState.Open
    final_chunk: NetworkChunk = NetworkChunk{sequence: 1, bytes: [4], final_chunk: true}
    assert enqueue_network_chunk(stream, final_chunk)
    assert consume_network_stream(stream, 3) == 3
    assert advance_network_stream(stream, NetworkStreamEvent.Finish) == NetworkStreamState.Finished
    bad_stream: mutable NetworkStream = NetworkStream{direction: NetworkStreamDirection.Response, max_buffer_bytes: 8}
    assert advance_network_stream(bad_stream, NetworkStreamEvent.Open) == NetworkStreamState.Open
    bad_chunk: NetworkChunk = NetworkChunk{sequence: 1, bytes: [9]}
    sequence_rejected: mutable bool = false
    catch enqueue_network_chunk(bad_stream, bad_chunk):
        ok value:
            assert not value
        error issue:
            assert issue == NetworkContractError.ChunkSequenceMismatch
            sequence_rejected <- true
    assert sequence_rejected
    unfinished_stream: mutable NetworkStream = NetworkStream{direction: NetworkStreamDirection.Response, max_buffer_bytes: 8}
    assert advance_network_stream(unfinished_stream, NetworkStreamEvent.Open) == NetworkStreamState.Open
    unfinished_chunk: NetworkChunk = NetworkChunk{sequence: 0, bytes: [7]}
    assert enqueue_network_chunk(unfinished_stream, unfinished_chunk)
    incomplete_rejected: mutable bool = false
    catch advance_network_stream(unfinished_stream, NetworkStreamEvent.Finish):
        ok value:
            assert false
        error issue:
            assert issue == NetworkContractError.StreamNotComplete
            incomplete_rejected <- true
    assert incomplete_rejected
    undrained_stream: mutable NetworkStream = NetworkStream{direction: NetworkStreamDirection.Response, max_buffer_bytes: 8}
    assert advance_network_stream(undrained_stream, NetworkStreamEvent.Open) == NetworkStreamState.Open
    undrained_chunk: NetworkChunk = NetworkChunk{sequence: 0, bytes: [8], final_chunk: true}
    assert enqueue_network_chunk(undrained_stream, undrained_chunk)
    undrained_rejected: mutable bool = false
    catch advance_network_stream(undrained_stream, NetworkStreamEvent.Finish):
        ok value:
            assert false
        error issue:
            assert issue == NetworkContractError.StreamNotDrained
            undrained_rejected <- true
    assert undrained_rejected
    job: mutable NetworkRequestJob = NetworkRequestJob{max_attempts: 2}
    assert advance_network_request(job, NetworkRequestEvent.Begin) == NetworkRequestState.Resolving
    assert advance_network_request(job, NetworkRequestEvent.DnsReady) == NetworkRequestState.Connecting
    assert advance_network_request(job, NetworkRequestEvent.ConnectReady) == NetworkRequestState.Securing
    assert advance_network_request(job, NetworkRequestEvent.TlsReady) == NetworkRequestState.Sending
    assert advance_network_request(job, NetworkRequestEvent.Cancel) == NetworkRequestState.Cancelling
    assert advance_network_request(job, NetworkRequestEvent.CancelAck) == NetworkRequestState.Cancelled
    retry_job: mutable NetworkRequestJob = NetworkRequestJob{max_attempts: 2}
    assert advance_network_request(retry_job, NetworkRequestEvent.Begin) == NetworkRequestState.Resolving
    assert advance_network_request(retry_job, NetworkRequestEvent.Fail) == NetworkRequestState.Failed
    assert advance_network_request(retry_job, NetworkRequestEvent.Retry) == NetworkRequestState.Planned
    assert advance_network_request(retry_job, NetworkRequestEvent.Begin) == NetworkRequestState.Resolving
    assert advance_network_request(retry_job, NetworkRequestEvent.Fail) == NetworkRequestState.Failed
    retry_exhausted: mutable bool = false
    catch advance_network_request(retry_job, NetworkRequestEvent.Retry):
        ok value:
            assert false
        error issue:
            assert issue == NetworkContractError.RetryLimitExceeded
            retry_exhausted <- true
    assert retry_exhausted
    response: NetworkResponse = NetworkResponse{outcome: NetworkOutcome.Success, status: 200, headers: ["Content-Type", "application/json"], body: [123, 125]}
    assert validate_network_response(response)
    failure: NetworkResponse = NetworkResponse{outcome: NetworkOutcome.Timeout, status: 0, error_text: "deadline"}
    assert validate_network_response(failure)
    tls_failure: NetworkResponse = NetworkResponse{outcome: NetworkOutcome.TlsFailure, status: 0, error_text: "certificate"}
    assert validate_network_response(tls_failure)
    invalid_headers: NetworkRequest = NetworkRequest{url: "https://example.test", headers: ["X-Test", "one", "X-Test", "two"], timeout_micros: 1}
    duplicate_rejected: mutable bool = false
    catch validate_network_request(invalid_headers):
        ok value:
            assert not value
        error issue:
            assert issue == NetworkContractError.DuplicateHeaderName
            duplicate_rejected <- true
    assert duplicate_rejected
    invalid_timeout: NetworkRequest = NetworkRequest{url: "https://example.test"}
    timeout_rejected: mutable bool = false
    catch validate_network_request(invalid_timeout):
        ok value:
            assert not value
        error issue:
            assert issue == NetworkContractError.InvalidTimeout
            timeout_rejected <- true
    assert timeout_rejected
    invalid_failure_status: NetworkResponse = NetworkResponse{outcome: NetworkOutcome.TransportFailure, status: 500}
    status_rejected: mutable bool = false
    catch validate_network_response(invalid_failure_status):
        ok value:
            assert not value
        error issue:
            assert issue == NetworkContractError.InvalidStatus
            status_rejected <- true
    assert status_rejected


@test
def typed_network_session_contract_accounts_send_receive_and_cancel() -> void:
    request: NetworkRequest = NetworkRequest{url: "https://example.test/read", timeout_micros: 1000000, max_response_bytes: 128}
    session: mutable NetworkSession = NetworkSession{request: request}
    assert validate_network_session(session)
    assert advance_network_session(session, NetworkSessionEvent.Begin) == NetworkSessionState.Resolving
    assert advance_network_session(session, NetworkSessionEvent.DnsReady) == NetworkSessionState.Connecting
    assert advance_network_session(session, NetworkSessionEvent.ConnectReady) == NetworkSessionState.Securing
    assert advance_network_session(session, NetworkSessionEvent.TlsReady) == NetworkSessionState.Sending
    assert advance_network_session(session, NetworkSessionEvent.SendComplete) == NetworkSessionState.Receiving
    assert advance_network_session(session, NetworkSessionEvent.ReceiveChunk, 8) == NetworkSessionState.Receiving
    assert advance_network_session(session, NetworkSessionEvent.ReceiveComplete, 0, NetworkOutcome.Success, 200) == NetworkSessionState.Completed
    cancellation: mutable NetworkSession = NetworkSession{request: request}
    assert advance_network_session(cancellation, NetworkSessionEvent.Begin) == NetworkSessionState.Resolving
    assert advance_network_session(cancellation, NetworkSessionEvent.Cancel) == NetworkSessionState.Cancelling
    assert advance_network_session(cancellation, NetworkSessionEvent.CancelAck) == NetworkSessionState.Cancelled


@test
def typed_file_stream_contract_is_bounded_and_stateful() -> void:
    assert FILE_STREAM_DEFAULT_MAX_BYTES == ES_RUNTIME_DEFAULT_MAX_MEMORY_BYTES
    cleanup: mutable FileStreamCleanupGuard = file_stream_cleanup_begin()
    assert cleanup.state == FileStreamCleanupState.Armed
    assert file_stream_cleanup_transition(cleanup.state, FileStreamCleanupEvent.Commit) == FileStreamCleanupState.Closed
    assert file_stream_cleanup_transition(cleanup.state, FileStreamCleanupEvent.Abort) == FileStreamCleanupState.Aborted
    assert file_stream_cleanup_transition(FileStreamCleanupState.Closed, FileStreamCleanupEvent.Commit) == FileStreamCleanupState.Closed
    assert file_stream_cleanup_transition(FileStreamCleanupState.Closed, FileStreamCleanupEvent.Abort) == FileStreamCleanupState.Closed
    assert file_stream_cleanup_transition(FileStreamCleanupState.Aborted, FileStreamCleanupEvent.Commit) == FileStreamCleanupState.Aborted
    assert file_stream_cleanup_transition(FileStreamCleanupState.Aborted, FileStreamCleanupEvent.Abort) == FileStreamCleanupState.Aborted
    closed: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.ReadBinary, state: FileStreamState.Closed, byte_budget: 1}
    assert closed.state == FileStreamState.Closed
    assert closed.bytes_read == 0
    assert closed.bytes_written == 0
    assert closed.byte_budget == 1


@test
def typed_file_stream_write_contract_retries_short_progress() -> void:
    assert file_stream_write_transition(0, 8, 3, 8) == FileStreamWriteState.Progress
    assert file_stream_write_transition(3, 8, 5, 5) == FileStreamWriteState.Done
    assert file_stream_write_transition(0, 8, 0, 8) == FileStreamWriteState.Error
    assert file_stream_write_transition(0, 8, 9, 8) == FileStreamWriteState.Error
    assert file_stream_write_transition(9, 8, 0, 8) == FileStreamWriteState.Error
    assert file_stream_write_transition(0, 8, 4, 3) == FileStreamWriteState.Limit


@test
def typed_file_stream_newline_modes_are_explicit() -> void:
    assert FileStreamLineMode.Lf != FileStreamLineMode.Universal
    assert FileStreamLineMode.Universal != FileStreamLineMode.Retain
    assert FileStreamLineMode.Lf != FileStreamLineMode.Retain
    stream: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.ReadText, state: FileStreamState.Closed, byte_budget: 1}
    assert not stream.pending_valid
    assert stream.pending_byte == 0u8


@test
def typed_file_stream_pending_lookahead_is_shared_by_readers() -> void:
    stream: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.ReadBinary, state: FileStreamState.Closed, byte_budget: 2, pending_byte: 65u8, pending_valid: true}
    assert stream.pending_valid
    assert stream.pending_byte == 65u8


@test
def typed_file_stream_seek_origins_are_explicit() -> void:
    assert FileStreamSeekOrigin.Begin != FileStreamSeekOrigin.Current
    assert FileStreamSeekOrigin.Current != FileStreamSeekOrigin.End
    assert FileStreamSeekOrigin.Begin != FileStreamSeekOrigin.End


@test
def typed_file_stream_sync_is_write_only_and_flushes_first() -> void:
    writable: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.WriteBinary, state: FileStreamState.Closed, byte_budget: 1}
    readable: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.ReadBinary, state: FileStreamState.Closed, byte_budget: 1}
    assert writable.mode == FileStreamMode.WriteBinary
    assert readable.mode == FileStreamMode.ReadBinary


@test
def typed_file_stream_staged_publication_contract_is_explicit() -> void:
    assert FileStreamMode.WriteBinary != FileStreamMode.ReadBinary
    assert FileStreamState.Open != FileStreamState.Closed


@test
def typed_source_encoding_contract_is_strict() -> void:
    three: mutable EsEncoding::Utf8Cursor = EsEncoding::Utf8Cursor{}
    assert EsEncoding::utf8_feed(224u8, three)
    assert three.remaining == 2u8
    assert three.lower == 160u8
    assert not EsEncoding::utf8_feed(159u8, three)
    four: mutable EsEncoding::Utf8Cursor = EsEncoding::Utf8Cursor{}
    assert EsEncoding::utf8_feed(240u8, four)
    assert four.remaining == 3u8
    assert four.lower == 144u8
    assert EsEncoding::utf8_feed(144u8, four)
    assert EsEncoding::utf8_feed(128u8, four)
    assert EsEncoding::utf8_feed(128u8, four)
    assert EsEncoding::utf8_complete(four)
    surrogate: mutable EsEncoding::Utf8Cursor = EsEncoding::Utf8Cursor{}
    assert EsEncoding::utf8_feed(237u8, surrogate)
    assert not EsEncoding::utf8_feed(160u8, surrogate)
    out_of_range: mutable EsEncoding::Utf8Cursor = EsEncoding::Utf8Cursor{}
    assert EsEncoding::utf8_feed(244u8, out_of_range)
    assert not EsEncoding::utf8_feed(144u8, out_of_range)


@test
def typed_file_stream_encoding_policy_is_explicit() -> void:
    assert FileStreamEncoding.Auto != FileStreamEncoding.Bytes
    assert FileStreamEncoding.Bytes != FileStreamEncoding.Utf8
    assert FileStreamEncoding.Auto != FileStreamEncoding.Utf8
    stream: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.ReadText, state: FileStreamState.Closed, byte_budget: 1, encoding: FileStreamEncoding.Utf8}
    assert stream.encoding == FileStreamEncoding.Utf8
    assert stream.utf8_remaining == 0u8


@test
def typed_file_stream_utf8_boundary_state_is_explicit() -> void:
    split_three: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.ReadText, state: FileStreamState.Closed, byte_budget: 3, encoding: FileStreamEncoding.Utf8, utf8_remaining: 2u8, utf8_lower: 160u8, utf8_upper: 191u8}
    assert split_three.utf8_remaining == 2u8
    assert split_three.utf8_lower == 160u8
    assert split_three.utf8_upper == 191u8
    split_four: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.WriteText, state: FileStreamState.Closed, byte_budget: 4, encoding: FileStreamEncoding.Utf8, utf8_remaining: 3u8, utf8_lower: 144u8, utf8_upper: 191u8}
    assert split_four.utf8_remaining == 3u8
    assert split_four.utf8_lower == 144u8
    assert split_four.utf8_upper == 191u8


@test
def typed_file_stream_close_rejects_open_without_handle() -> void:
    can Blocking.IO, Memory.Release:
        malformed: mutable FileStream = FileStream{handle: null, path: "malformed", mode: FileStreamMode.ReadBinary, state: FileStreamState.Open, byte_budget: 1}
        rejected: mutable bool = false
        catch file_stream_close(malformed):
            ok:
                assert false
            error failure:
                rejected <- true
        assert rejected


@test
def artifact_cache_file_io_contract_is_typed_and_fail_closed() -> void:
    invalid: ArtifactCacheLoad = ArtifactCacheLoad{bytes: [], decision: ArtifactCacheDecision{kind: ArtifactCacheKind.IrMetadata, admission: ArtifactCacheAdmission.Invalid}}
    assert invalid.bytes.count == 0
    assert invalid.decision.admission == ArtifactCacheAdmission.Invalid
    assert artifact_cache_lifecycle_transition(ArtifactCacheLifecycle.Empty, ArtifactCacheEvent.Stage) == ArtifactCacheLifecycle.Staged
    assert artifact_cache_lifecycle_transition(ArtifactCacheLifecycle.Staged, ArtifactCacheEvent.Commit) == ArtifactCacheLifecycle.Committed
    assert artifact_cache_lifecycle_transition(ArtifactCacheLifecycle.Staged, ArtifactCacheEvent.Abort) == ArtifactCacheLifecycle.Rejected
    assert artifact_cache_recovery_action(ArtifactCacheLifecycle.Committed, false, true, true) == ArtifactCacheRecoveryAction.KeepPublished
    assert artifact_cache_recovery_action(ArtifactCacheLifecycle.Committed, true, false, false) == ArtifactCacheRecoveryAction.RebuildPublished
    assert artifact_cache_recovery_action(ArtifactCacheLifecycle.Staged, true, false, false) == ArtifactCacheRecoveryAction.RemoveStaging
    assert artifact_cache_recovery_action(ArtifactCacheLifecycle.Staged, false, true, true) == ArtifactCacheRecoveryAction.RebuildPublished
    assert artifact_cache_recovery_action(ArtifactCacheLifecycle.Staged, false, false, false) == ArtifactCacheRecoveryAction.Noop
    assert artifact_cache_recovery_action(ArtifactCacheLifecycle.Empty, true, true, true) == ArtifactCacheRecoveryAction.RemoveStaging
    assert artifact_cache_recovery_action(ArtifactCacheLifecycle.Rejected, false, true, true) == ArtifactCacheRecoveryAction.Noop
    lease: mutable ArtifactCacheWriterLease = ArtifactCacheWriterLease{}
    assert artifact_cache_writer_acquire(lease, 41)
    assert not artifact_cache_writer_acquire(lease, 42)
    assert not artifact_cache_writer_publish(lease, 42)
    assert artifact_cache_writer_publish(lease, 41)
    assert not artifact_cache_writer_abort(lease, 41)
    aborted: mutable ArtifactCacheWriterLease = ArtifactCacheWriterLease{}
    assert artifact_cache_writer_acquire(aborted, 7)
    assert artifact_cache_writer_abort(aborted, 7)
    assert aborted.state == ArtifactCacheWriterState.Aborted
    assert not artifact_cache_writer_acquire(aborted, 0)
    assert artifact_cache_writer_acquire(aborted, 8)
    assert not artifact_cache_writer_publish(aborted, 7)
    assert artifact_cache_writer_publish(aborted, 8)
    lock: ArtifactCacheWriterLock = ArtifactCacheWriterLock{}
    assert lock.state == ArtifactCacheWriterLockState.Available
    assert lock.owner_token == 0
    assert lock.path == ""
    assert artifact_cache_writer_lock_transition(ArtifactCacheWriterLockState.Available, ArtifactCacheWriterLockEvent.Acquire) == ArtifactCacheWriterLockState.Held
    assert artifact_cache_writer_lock_transition(ArtifactCacheWriterLockState.Held, ArtifactCacheWriterLockEvent.Acquire) == ArtifactCacheWriterLockState.Held
    assert artifact_cache_writer_lock_transition(ArtifactCacheWriterLockState.Held, ArtifactCacheWriterLockEvent.Release) == ArtifactCacheWriterLockState.Released
    assert artifact_cache_writer_lock_transition(ArtifactCacheWriterLockState.Released, ArtifactCacheWriterLockEvent.Acquire) == ArtifactCacheWriterLockState.Held
    assert artifact_cache_writer_lock_transition(ArtifactCacheWriterLockState.Available, ArtifactCacheWriterLockEvent.Release) == ArtifactCacheWriterLockState.Available
    assert artifact_cache_writer_lock_transition(ArtifactCacheWriterLockState.Released, ArtifactCacheWriterLockEvent.Release) == ArtifactCacheWriterLockState.Released


@test
def backend_resource_limits_share_the_runtime_call_depth_contract() -> void:
    assert ES_RUNTIME_DEFAULT_MAX_EXECUTION_CALL_DEPTH == 4096
    assert ES_RUNTIME_DEFAULT_MAX_VALUE_EQUAL_DEPTH == 128
    assert ES_RUNTIME_DEFAULT_MAX_ERROR_GUARD_DEPTH == 4096
    # Public regex adapters and policy-aware interpretation must use the same
    # ceiling; otherwise direct bytecode can accept more matcher work than the
    # shared runtime contract permits.
    assert ES_RUNTIME_DEFAULT_MAX_REGEX_WORK == 67108864


@test
def runtime_resource_policy_tracks_zero_and_boundary_budgets() -> void:
    policy: RuntimeResourcePolicy = RuntimeResourcePolicy{steps: 3, memory_bytes: 1024, output_bytes: 2048, retained_traces: 4}
    assert runtime_resource_policy_valid(policy)
    assert runtime_resource_policy_has_unaccounted_dimensions(policy)
    supported: RuntimeResourcePolicy = RuntimeResourcePolicy{steps: 3, output_bytes: 2048, regex_work: 1024, retained_traces: 4}
    assert not runtime_resource_policy_has_unaccounted_dimensions(supported)
    usage: RuntimeResourceUsage = RuntimeResourceUsage{steps: 3, memory_bytes: 1024, output_bytes: 2048, retained_traces: 4}
    assert runtime_resource_usage_within_policy(usage, policy)
    usage.steps <- 4
    assert not runtime_resource_usage_within_policy(usage, policy)

    zero: RuntimeResourcePolicy = RuntimeResourcePolicy{steps: 0, memory_bytes: 0, output_bytes: 0, retained_traces: 0}
    empty: RuntimeResourceUsage = RuntimeResourceUsage{}
    assert runtime_resource_usage_within_policy(empty, zero)
    empty.memory_bytes <- 1
    assert not runtime_resource_usage_within_policy(empty, zero)
    unattached_usage: RuntimeResourceUsage = RuntimeResourceUsage{elapsed_micros: 1}
    assert not runtime_resource_usage_within_policy(unattached_usage, zero)

    narrowed: RuntimeResourcePolicy = runtime_resource_policy_with_step_limit(policy, 1)
    assert narrowed.steps == 1
    assert narrowed.memory_bytes == policy.memory_bytes

    partial_usage: RuntimeResourceUsage = RuntimeResourceUsage{steps: 1, memory_bytes: 256, output_bytes: 512, retained_traces: 1}
    remaining: RuntimeResourcePolicy = runtime_resource_remaining_policy(partial_usage, policy)
    assert remaining.steps == 2
    assert remaining.memory_bytes == 768
    assert remaining.output_bytes == 1536
    assert remaining.retained_traces == 3
    exhausted: RuntimeResourceUsage = RuntimeResourceUsage{steps: 4, memory_bytes: 2048, output_bytes: 4096, retained_traces: 8}
    exhausted_remaining: RuntimeResourcePolicy = runtime_resource_remaining_policy(exhausted, policy)
    assert exhausted_remaining.steps == 0
    assert exhausted_remaining.memory_bytes == 0
    assert exhausted_remaining.output_bytes == 0
    assert exhausted_remaining.retained_traces == 0
    elapsed_remaining: RuntimeResourcePolicy = runtime_resource_remaining_policy(RuntimeResourceUsage{elapsed_micros: 9}, RuntimeResourcePolicy{elapsed_micros: 0})
    assert elapsed_remaining.elapsed_micros == 0

    handles_over: RuntimeResourcePolicy = policy
    steps_over: RuntimeResourcePolicy = policy
    steps_over.steps <- ES_RUNTIME_DEFAULT_MAX_STEPS + 1
    assert not runtime_resource_policy_valid(steps_over)
    handles_over.open_handles <- ES_RUNTIME_DEFAULT_MAX_OPEN_HANDLES + 1
    assert not runtime_resource_policy_valid(handles_over)
    processes_over: RuntimeResourcePolicy = policy
    processes_over.processes <- ES_RUNTIME_DEFAULT_MAX_PROCESSES + 1
    assert not runtime_resource_policy_valid(processes_over)
    tasks_over: RuntimeResourcePolicy = policy
    tasks_over.concurrent_tasks <- ES_RUNTIME_DEFAULT_MAX_CONCURRENT_TASKS + 1
    assert not runtime_resource_policy_valid(tasks_over)

    counters: mutable RuntimeResourceUsage = RuntimeResourceUsage{}
    assert runtime_resource_acquire(counters, policy, RuntimeResourceCounter.OpenHandle)
    assert runtime_resource_acquire(counters, policy, RuntimeResourceCounter.Process)
    assert runtime_resource_acquire(counters, policy, RuntimeResourceCounter.ConcurrentTask)
    assert counters.open_handles == 1
    assert counters.processes == 1
    assert counters.concurrent_tasks == 1
    assert runtime_resource_release(counters, RuntimeResourceCounter.OpenHandle)
    assert runtime_resource_release(counters, RuntimeResourceCounter.Process)
    assert runtime_resource_release(counters, RuntimeResourceCounter.ConcurrentTask)
    assert not runtime_resource_release(counters, RuntimeResourceCounter.OpenHandle)

    bounded: mutable RuntimeResourceUsage = RuntimeResourceUsage{}
    assert runtime_resource_add_steps(bounded, policy, 3)
    assert not runtime_resource_add_steps(bounded, policy, 1)
    elapsed_policy: RuntimeResourcePolicy = RuntimeResourcePolicy{elapsed_micros: 8}
    elapsed: mutable RuntimeResourceUsage = RuntimeResourceUsage{}
    assert runtime_resource_add_elapsed(elapsed, elapsed_policy, 8)
    assert elapsed.elapsed_micros == 8
    assert not runtime_resource_add_elapsed(elapsed, elapsed_policy, 1)
    unattached: mutable RuntimeResourceUsage = RuntimeResourceUsage{}
    assert runtime_resource_add_elapsed(unattached, RuntimeResourcePolicy{}, 999)
    assert unattached.elapsed_micros == 0
    assert runtime_resource_add_memory(bounded, policy, policy.memory_bytes)
    assert not runtime_resource_add_memory(bounded, policy, 1)
    assert runtime_resource_add_output(bounded, policy, policy.output_bytes)
    assert not runtime_resource_add_output(bounded, policy, 1)
    assert runtime_resource_add_regex_work(bounded, policy, policy.regex_work)
    assert not runtime_resource_add_regex_work(bounded, policy, 1)
    assert runtime_resource_add_retained_traces(bounded, policy, policy.retained_traces)
    assert not runtime_resource_add_retained_traces(bounded, policy, 1)
    tiny_policy: RuntimeResourcePolicy = RuntimeResourcePolicy{open_handles: 1, processes: 1, concurrent_tasks: 1}
    tiny_usage: mutable RuntimeResourceUsage = RuntimeResourceUsage{}
    assert runtime_resource_acquire(tiny_usage, tiny_policy, RuntimeResourceCounter.OpenHandle)
    assert runtime_resource_acquire(tiny_usage, tiny_policy, RuntimeResourceCounter.Process)
    assert runtime_resource_acquire(tiny_usage, tiny_policy, RuntimeResourceCounter.ConcurrentTask)
    assert not runtime_resource_acquire(tiny_usage, tiny_policy, RuntimeResourceCounter.OpenHandle)
    assert not runtime_resource_acquire(tiny_usage, tiny_policy, RuntimeResourceCounter.Process)
    assert not runtime_resource_acquire(tiny_usage, tiny_policy, RuntimeResourceCounter.ConcurrentTask)
    assert runtime_resource_release(tiny_usage, RuntimeResourceCounter.OpenHandle)
    assert runtime_resource_release(tiny_usage, RuntimeResourceCounter.Process)
    assert runtime_resource_release(tiny_usage, RuntimeResourceCounter.ConcurrentTask)
    assert not runtime_resource_release(tiny_usage, RuntimeResourceCounter.OpenHandle)
    assert not runtime_resource_release(tiny_usage, RuntimeResourceCounter.Process)
    assert not runtime_resource_release(tiny_usage, RuntimeResourceCounter.ConcurrentTask)

    zero_resource_policy: RuntimeResourcePolicy = RuntimeResourcePolicy{open_handles: 0, processes: 0, concurrent_tasks: 0}
    zero_resource_usage: mutable RuntimeResourceUsage = RuntimeResourceUsage{}
    assert not runtime_resource_acquire(zero_resource_usage, zero_resource_policy, RuntimeResourceCounter.OpenHandle)
    assert not runtime_resource_acquire(zero_resource_usage, zero_resource_policy, RuntimeResourceCounter.Process)
    assert not runtime_resource_acquire(zero_resource_usage, zero_resource_policy, RuntimeResourceCounter.ConcurrentTask)


@test
def serialized_slice_bounds_use_subtraction_before_end_addition() -> void:
    end: mutable usize = 0
    assert runtime_bounded_slice_end(4, 3, 8, end)
    assert end == 7
    assert not runtime_bounded_slice_end(9, 0, 8, end)
    assert not runtime_bounded_slice_end(7, 2, 8, end)


@test
def canonical_sha256_matches_known_vectors() -> void:
    empty: darray[u8] = []
    empty_digest: darray[u8] = canonical_bytes_sha256(empty)
    assert empty_digest.count == 32
    assert empty_digest[0] == 0xe3
    assert empty_digest[1] == 0xb0
    assert empty_digest[30] == 0xb8
    assert empty_digest[31] == 0x55

    abc: darray[u8] = [97, 98, 99]
    abc_digest: darray[u8] = canonical_bytes_sha256(abc)
    assert abc_digest.count == 32
    assert abc_digest[0] == 0xbau8
    assert abc_digest[1] == 0x78u8
    assert abc_digest[30] == 0x15u8
    assert abc_digest[31] == 0xadu8


@test
def interned_type_table_deduplicates_recursive_shapes() -> void:
    can Memory.Allocate, Abort.Panic:
        nested: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Array, element_element_kind: TypeKind.Int, element_element_bits: 64, element_element_signed: true}
        parameter: Parameter = Parameter{value: 1, type: nested, name: "values"}
        fn: Function = Function{name: "typed", parameters: [parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [], entry: 0}
        module: mutable Module = Module{name: "types", functions: [fn]}
        intern_module_types(module)
        assert module.type_table.rows.count == 4
        assert module.functions[0].parameters[0].type.descriptor_id != 0
        assert type_table_matches_inline(module.functions[0].parameters[0].type, module.functions[0].parameters[0].type.descriptor_id, module.type_table)

        table: mutable TypeTable = TypeTable{rows: [], children: []}
        root_id: u32 = intern_structural_type(nested, table)
        child_id: u32 = table.children[1]
        grandchild_id: u32 = table.children[0]
        assert type_table_child(root_id, 0, table) == child_id
        assert type_table_child(child_id, 0, table) == grandchild_id
        assert root_id != 0
        assert child_id != 0
        assert grandchild_id != 0
        assert table.rows[(grandchild_id - 1).usize()].kind == TypeKind.Int
        assert table.rows.count == 3

        duplicate: mutable TypeTable = TypeTable{rows: [], children: []}
        no_children: darray[u32] = []
        first_id: u32 = intern_type_descriptor(TypeKind.Int, "", 64, true, no_children, duplicate)
        second_id: u32 = intern_type_descriptor(TypeKind.Int, "", 64, true, no_children, duplicate)
        assert first_id == second_id
        assert duplicate.rows.count == 1

        untyped_module: Module = Module{name: "types", functions: [fn]}
        typed_module: mutable Module = Module{name: "types", functions: [fn]}
        intern_module_types(typed_module)
        assert canonical_module_hash(typed_module) != canonical_module_hash(untyped_module)


def issue_count(issues: darray[Issue]&, kind: IssueKind) -> usize:
    count: mutable usize = 0
    for found in issues |count|:
        count <- count + 1 if found.kind == kind
    return count


@test
def verifier_checks_assertion_shape_and_error_contract() -> void:
    can Memory.Allocate, Abort.Panic:
        position: SourceSpan = span()
        condition: Instruction = Instruction{opcode: Opcode.Constant, result: 1, result_type: bool_type(), boolean: true, span: position}
        assertion: Instruction = Instruction{opcode: Opcode.Assert, result: 0, result_type: void_type(), operand_start: 0, operand_count: 1, span: position}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 2, terminator: Terminator{kind: TerminatorKind.Return, operand: 0, operand_count: 0, span: position}}
        valid_fn: Function = Function{name: "check", parameters: [], return_type: void_type(), effects: [], errors: ["AssertionError"], operand_pool: [1], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [condition, assertion], blocks: [block], entry: 1}
        valid_module: Module = Module{name: "assertion", functions: [valid_fn]}
        assert verify(valid_module).count == 0

        malformed: mutable Function = valid_fn
        malformed.errors <- []
        malformed.instruction_pool[1].result_type <- int_type()
        malformed_module: Module = Module{name: "malformed-assertion", functions: [malformed]}
        malformed_issues: darray[Issue] = verify(malformed_module)
        assert issue_count(malformed_issues, IssueKind.InvalidInstruction) > 0
        assert issue_count(malformed_issues, IssueKind.MissingError) > 0


@test
def verifier_requires_raise_family_not_variant_tag_in_error_row() -> void:
    can Memory.Allocate, Abort.Panic:
        raised: Instruction = Instruction{opcode: Opcode.Raise, result: 0, result_type: void_type(), effect_family: "UserError", effect_operation: "Bad", span: span()}
        term: Terminator = Terminator{kind: TerminatorKind.Return, span: span()}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: term}
        fn: Function = Function{name: "raise-row", parameters: [], return_type: void_type(), effects: [], errors: ["UserError"], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [raised], blocks: [block], entry: 1}
        valid_module: Module = Module{name: "raise-row", functions: [fn]}
        assert issue_count(verify(valid_module), IssueKind.MissingError) == 0

        malformed: mutable Function = fn
        malformed.errors <- ["Bad"]
        malformed_module: Module = Module{name: "raise-wrong-row", functions: [malformed]}
        assert issue_count(verify(malformed_module), IssueKind.MissingError) == 1


@test
def verifier_rejects_integer_formatting_wider_than_runtime_payload() -> void:
    can Memory.Allocate, Abort.Panic:
        position: SourceSpan = span()
        wide_type: Type = Type{kind: TypeKind.Int, bits: 128, signed: true}
        text_type: Type = Type{kind: TypeKind.Text}
        constant: Instruction = Instruction{opcode: Opcode.Constant, result: 1, result_type: wide_type, integer: 7, span: position}
        formatting: Instruction = Instruction{opcode: Opcode.FormatInt, result: 2, result_type: text_type, operand_start: 0, operand_count: 1, span: position}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 2, terminator: Terminator{kind: TerminatorKind.Return, operand: 2, operand_count: 1, span: position}}
        fn: Function = Function{name: "wide-format", parameters: [], return_type: text_type, effects: [], errors: [], operand_pool: [1], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [constant, formatting], blocks: [block], entry: 1}
        module: Module = Module{name: "wide-format", functions: [fn]}
        issues: darray[Issue] = verify(module)
        assert issue_count(issues, IssueKind.InvalidInstruction) > 0


@test
def verifier_accepts_f32_and_f64_float_formatting() -> void:
    can Memory.Allocate, Abort.Panic:
        position: SourceSpan = span()
        f32_type: Type = Type{kind: TypeKind.Float, bits: 32, signed: true}
        text_type: Type = Type{kind: TypeKind.Text}
        constant: Instruction = Instruction{opcode: Opcode.Constant, result: 1, result_type: f32_type, decimal: "1.5", span: position}
        formatting: Instruction = Instruction{opcode: Opcode.FormatFloat, result: 2, result_type: text_type, operand_start: 0, operand_count: 1, span: position}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 2, terminator: Terminator{kind: TerminatorKind.Return, operand: 2, operand_count: 1, span: position}}
        fn: Function = Function{name: "f32-format", parameters: [], return_type: text_type, effects: [], errors: [], operand_pool: [1], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [constant, formatting], blocks: [block], entry: 1}
        module: Module = Module{name: "f32-format", functions: [fn]}
        assert verify(module).count == 0


@test
def verifier_rejects_unknown_regex_search_mode() -> void:
    can Memory.Allocate, Abort.Panic:
        position: SourceSpan = span()
        text_type: Type = Type{kind: TypeKind.Text}
        regex_type: Type = Type{kind: TypeKind.Named, name: "Regex"}
        bool_result: Type = bool_type()
        text_constant: Instruction = Instruction{opcode: Opcode.Constant, result: 1, result_type: text_type, text: "haystack", span: position}
        regex_constant: Instruction = Instruction{opcode: Opcode.Constant, result: 2, result_type: regex_type, text: "pattern", span: position}
        malformed: Instruction = Instruction{opcode: Opcode.RegexSearch, result: 3, result_type: bool_result, integer: 7, operand_start: 0, operand_count: 2, span: position}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 3, terminator: Terminator{kind: TerminatorKind.Return, operand: 3, operand_count: 1, span: position}}
        fn: Function = Function{name: "bad-regex-mode", parameters: [], return_type: bool_result, effects: [], errors: [], operand_pool: [1, 2], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [text_constant, regex_constant, malformed], blocks: [block], entry: 1}
        module: Module = Module{name: "bad-regex-mode", functions: [fn]}
        assert issue_count(verify(module), IssueKind.InvalidInstruction) > 0


@test
def verifier_rejects_unknown_regex_capture_mode() -> void:
    can Memory.Allocate, Abort.Panic:
        position: SourceSpan = span()
        text_type: Type = Type{kind: TypeKind.Text}
        regex_type: Type = Type{kind: TypeKind.Named, name: "Regex"}
        captures_type: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Text}
        text_constant: Instruction = Instruction{opcode: Opcode.Constant, result: 1, result_type: text_type, text: "haystack", span: position}
        regex_constant: Instruction = Instruction{opcode: Opcode.Constant, result: 2, result_type: regex_type, text: "pattern", span: position}
        malformed: Instruction = Instruction{opcode: Opcode.RegexCapture, result: 3, result_type: captures_type, integer: 7, operand_start: 0, operand_count: 2, span: position}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 3, terminator: Terminator{kind: TerminatorKind.Return, operand: 3, operand_count: 1, span: position}}
        fn: Function = Function{name: "bad-regex-capture-mode", parameters: [], return_type: captures_type, effects: [], errors: [], operand_pool: [1, 2], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [text_constant, regex_constant, malformed], blocks: [block], entry: 1}
        module: Module = Module{name: "bad-regex-capture-mode", functions: [fn]}
        assert issue_count(verify(module), IssueKind.InvalidInstruction) > 0


@test
def interned_type_table_validates_four_level_array_shapes() -> void:
    can Memory.Allocate, Abort.Panic:
        deep: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Array, element_element_kind: TypeKind.Array, element_element_element_kind: TypeKind.Array, element_element_element_element_kind: TypeKind.Int, element_element_element_element_bits: 64, element_element_element_element_signed: true}
        parameter: Parameter = Parameter{value: 1, type: deep, name: "values"}
        fn: Function = Function{name: "deep", parameters: [parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [], entry: 0}
        module: mutable Module = Module{name: "deep-types", functions: [fn]}
        intern_module_types(module)
        assert module.type_table.rows.count == 6
        assert module.functions[0].parameters[0].type.descriptor_id != 0
        assert type_table_matches_inline(module.functions[0].parameters[0].type, module.functions[0].parameters[0].type.descriptor_id, module.type_table)
        assert type_table_valid(module.type_table)


