            over_limit <- true
    assert over_limit


@test
def typed_json_document_contract_is_bounded_and_sealed_explicitly() -> void:
    limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 64, tokens: 16, depth: 4, records: 8, fields: 8, field_bytes: 32}
    document: mutable JsonDocument = JsonDocument{limits: limits, policy: JsonPolicy{duplicate_keys: JsonDuplicateKeyPolicy.Reject}}
    assert advance_json_document(document, JsonDocumentEvent.Begin) == JsonDocumentState.Building
    scalar: JsonNode = JsonNode{kind: JsonNodeKind.Text, range: JsonRange{start: 0, end: 4}, scalar_bytes: 4}
    assert advance_json_document(document, JsonDocumentEvent.AppendNode, scalar, JsonMember{key: ""}, JSON_INDEX_NONE, 4) == JsonDocumentState.Building
    assert advance_json_document(document, JsonDocumentEvent.AppendRoot, JsonNode{kind: JsonNodeKind.Null}, JsonMember{key: ""}, 0) == JsonDocumentState.Building
    assert advance_json_document(document, JsonDocumentEvent.Seal) == JsonDocumentState.Sealed
    assert validate_json_document(document)
    duplicate: mutable JsonDocument = JsonDocument{limits: limits}
    _ = advance_json_document(duplicate, JsonDocumentEvent.Begin)
    _ = advance_json_document(duplicate, JsonDocumentEvent.AppendNode, JsonNode{kind: JsonNodeKind.Null, range: JsonRange{start: 0, end: 1}}, JsonMember{key: ""}, JSON_INDEX_NONE, 4)
    first: JsonMember = JsonMember{key: "name", key_range: JsonRange{start: 0, end: 4}, value_index: 0}
    assert advance_json_document(duplicate, JsonDocumentEvent.AppendMember, JsonNode{kind: JsonNodeKind.Null}, first) == JsonDocumentState.Building
    duplicate_rejected: mutable bool = false
    catch advance_json_document(duplicate, JsonDocumentEvent.AppendMember, JsonNode{kind: JsonNodeKind.Null}, first):
        ok value:
            assert false
        error failure:
            assert failure == JsonContractError.DuplicateObjectKey
            duplicate_rejected <- true
    assert duplicate_rejected
    malformed: JsonDocument = JsonDocument{limits: limits, state: JsonDocumentState.Building, token_count: 1, nodes: [JsonNode{kind: JsonNodeKind.Array, child_start: 1, child_count: 1}], roots: [0]}
    child_range_rejected: mutable bool = false
    catch validate_json_document(malformed):
        ok value:
            assert false
        error failure:
            assert failure == JsonContractError.InvalidChildRange
            child_range_rejected <- true
    assert child_range_rejected


@test
