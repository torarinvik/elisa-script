@test
def verifier_rejects_malformed_float_payloads() -> void:
    can Memory.Allocate, Abort.Panic:
        position: SourceSpan = span()
        float_type: Type = Type{kind: TypeKind.Float, bits: 64, signed: true}
        malformed_constant: Instruction = Instruction{opcode: Opcode.Constant, result: 1, result_type: float_type, decimal: "1__5", span: position}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: Terminator{kind: TerminatorKind.Return, operand: 1, operand_count: 1, span: position}}
        fn: Function = Function{name: "bad-float-constant", parameters: [], return_type: float_type, effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [malformed_constant], blocks: [block], entry: 1}
        constant_module: Module = Module{name: "bad-float-constant", functions: [fn]}
        constant_issues: darray[Issue] = verify(constant_module)
        assert issue_count(constant_issues, IssueKind.InvalidInstruction) == 1

        array_type: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Float, element_bits: 64, element_signed: true}
        scalar: Global = Global{name: "scalar", type: float_type, decimal: "1__5", initialized: true}
        aggregate_literal: GlobalLiteral = GlobalLiteral{kind: TypeKind.Float, decimal: "1__5"}
        aggregate: Global = Global{name: "aggregate", type: array_type, initialized: true, aggregate_values: [aggregate_literal]}
        global_module: Module = Module{name: "bad-float-globals", functions: [], globals: [scalar, aggregate]}
        global_issues: darray[Issue] = verify(global_module)
        assert issue_count(global_issues, IssueKind.InvalidInstruction) == 2


