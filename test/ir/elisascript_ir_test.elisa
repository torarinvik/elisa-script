@test
def canonical_module_hash_is_stable_and_structural() -> void:
    can Memory.Allocate, Abort.Panic:
        constant: Instruction = Instruction{opcode: Opcode.Constant, result: 1, result_type: int_type(), integer: 7, span: span()}
        term: Terminator = Terminator{kind: TerminatorKind.Return, operand: 1, operand_count: 1, span: span()}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: term}
        fn: Function = Function{name: "main", parameters: [], return_type: int_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [constant], blocks: [block], entry: 1}
        handler: Handler = Handler{name: "capture", handles: ["Process.Run"], introduces_effects: ["Console.Write"], errors: ["ProcessError"], continuation: ContinuationPolicy.MultiClone, clauses: [HandlerClause{effect_family: "Process", effect_operation: "Run", function: "handle_run"}], captures: [ContinuationCapture{name: "state", type: int_type(), class: CaptureClass.Unrestricted}], replay_safe_effects: ["Console.Write"]}
        module: Module = Module{name: "hash", functions: [fn], handlers: [handler]}

        first: u64 = canonical_module_hash(module)
        second: u64 = canonical_module_hash(module)
        assert first == second
        assert first == module_fingerprint(module)
        encoded: darray[u8] = canonical_module_bytes(module)
        encoded_again: darray[u8] = canonical_module_bytes(module)
        assert encoded.count == encoded_again.count
        assert first == hash_sview(bytes_view(encoded))
        for index in 0..<encoded.count |encoded, encoded_again|:
            assert encoded[index] == encoded_again[index]

        artifact: ModuleArtifact = make_module_artifact(module, "interpreter", "working-tree")
        assert artifact.format_version == 2
        assert artifact.fingerprint == first
        assert artifact.digest_0 == canonical_module_digest_word(module, 0)
        assert artifact.digest_1 == canonical_module_digest_word(module, 1)
        assert artifact.digest_2 == canonical_module_digest_word(module, 2)
        assert artifact.digest_3 == canonical_module_digest_word(module, 3)
        assert artifact_metadata_valid(artifact)
        assert artifact_fingerprint_matches_module(artifact, module)
        legacy_artifact: mutable ModuleArtifact = artifact
        legacy_artifact.format_version <- 1
        legacy_artifact.digest_0 <- 0
        legacy_artifact.digest_1 <- 0
        legacy_artifact.digest_2 <- 0
        legacy_artifact.digest_3 <- 0
        migrated_artifact: ModuleArtifact = migrate_module_artifact(legacy_artifact, module)
        assert migrated_artifact.format_version == 2
        assert artifact_metadata_valid(migrated_artifact)
        assert artifact_fingerprint_matches_module(migrated_artifact, module)
        stale_legacy_artifact: mutable ModuleArtifact = legacy_artifact
        stale_legacy_artifact.fingerprint <- stale_legacy_artifact.fingerprint + 1
        assert migrate_module_artifact(stale_legacy_artifact, module).fingerprint == 0
        artifact_bytes: darray[u8] = canonical_module_artifact_bytes(artifact)
        assert artifact_bytes.count > 0
        assert module_artifact_bytes_valid(artifact_bytes)
        cache_decision: ArtifactCacheDecision = classify_module_artifact_cache(artifact_bytes)
        assert cache_decision.kind == ArtifactCacheKind.IrMetadata
        assert cache_decision.admission == ArtifactCacheAdmission.Current


        assert cache_decision.fingerprint == artifact.fingerprint
        staged_cache: ArtifactCachePublication = artifact_cache_stage(cache_decision, artifact_bytes.count)
        assert staged_cache.state == ArtifactCacheLifecycle.Staged
        committed_cache: ArtifactCachePublication = artifact_cache_commit(staged_cache)
        assert committed_cache.state == ArtifactCacheLifecycle.Committed
        assert artifact_cache_restart(committed_cache).state == ArtifactCacheLifecycle.Committed
        assert artifact_cache_restart(staged_cache).state == ArtifactCacheLifecycle.Rejected
        assert artifact_cache_restart(ArtifactCachePublication{state: ArtifactCacheLifecycle.Empty}).state == ArtifactCacheLifecycle.Empty
        assert artifact_cache_restart(ArtifactCachePublication{state: ArtifactCacheLifecycle.Rejected}).state == ArtifactCacheLifecycle.Rejected
        assert artifact_cache_abort(staged_cache).state == ArtifactCacheLifecycle.Rejected
        decoded_artifact: ModuleArtifactDecode = decode_module_artifact(artifact_bytes)
        assert decoded_artifact.valid
        assert decoded_artifact.artifact.backend == artifact.backend
        assert decoded_artifact.artifact.source_revision == artifact.source_revision
        assert decoded_artifact.artifact.fingerprint == artifact.fingerprint
        assert decoded_artifact.artifact.digest_0 == artifact.digest_0
        assert decoded_artifact.artifact.digest_1 == artifact.digest_1
        assert decoded_artifact.artifact.digest_2 == artifact.digest_2
        assert decoded_artifact.artifact.digest_3 == artifact.digest_3

        legacy_artifact_bytes: mutable darray[u8] = artifact_bytes
        legacy_artifact_bytes[4] <- 1
        assert not module_artifact_bytes_valid(legacy_artifact_bytes)
        assert not decode_module_artifact(legacy_artifact_bytes).valid
        assert module_artifact_requires_migration(legacy_artifact_bytes)
        assert classify_module_artifact_cache(legacy_artifact_bytes).admission == ArtifactCacheAdmission.NeedsMigration
        unknown_artifact_version: mutable darray[u8] = artifact_bytes
        unknown_artifact_version[4] <- 3
        assert not module_artifact_bytes_valid(unknown_artifact_version)
        assert not decode_module_artifact(unknown_artifact_version).valid
        assert not module_artifact_requires_migration(unknown_artifact_version)
        assert classify_module_artifact_cache(unknown_artifact_version).admission == ArtifactCacheAdmission.Invalid
        assert not module_artifact_requires_migration(artifact_bytes)
        assert classify_module_artifact_cache([]).admission == ArtifactCacheAdmission.Invalid

        malformed_artifact_length: mutable darray[u8] = artifact_bytes
        for index in 5..<13 |malformed_artifact_length|:
            malformed_artifact_length[index] <- 255
        assert not module_artifact_bytes_valid(malformed_artifact_length)
        assert not module_artifact_requires_migration(malformed_artifact_length)

        malformed_artifact_digest: mutable darray[u8] = artifact_bytes
        for index in 52..<84 |malformed_artifact_digest|:
            malformed_artifact_digest[index] <- 0
        assert not module_artifact_bytes_valid(malformed_artifact_digest)

        malformed_metadata: mutable ModuleArtifact = artifact
        malformed_metadata.backend <- ""
        assert not artifact_metadata_valid(malformed_metadata)
        assert not artifact_fingerprint_matches_module(malformed_metadata, module)
        malformed_metadata.backend <- "bad\0backend"
        assert not artifact_metadata_valid(malformed_metadata)
        malformed_metadata.backend <- artifact.backend
        malformed_metadata.fingerprint <- 0
        assert not artifact_metadata_valid(malformed_metadata)

        malformed_artifact_text: mutable darray[u8] = artifact_bytes
        malformed_artifact_text[13] <- 0
        assert not module_artifact_bytes_valid(malformed_artifact_text)

        malformed_artifact_trailing: mutable darray[u8] = artifact_bytes
        malformed_artifact_trailing.push(0)
        assert not module_artifact_bytes_valid(malformed_artifact_trailing)
        assert not decode_module_artifact(malformed_artifact_trailing).valid

        malformed_digest: mutable ModuleArtifact = artifact
        malformed_digest.digest_0 <- 0
        malformed_digest.digest_1 <- 0
        malformed_digest.digest_2 <- 0
        malformed_digest.digest_3 <- 0
        assert not artifact_metadata_valid(malformed_digest)
        assert not artifact_fingerprint_matches_module(malformed_digest, module)
        partial_digest: mutable ModuleArtifact = artifact
        partial_digest.digest_0 <- 0
        assert not artifact_metadata_valid(partial_digest)
        assert not artifact_fingerprint_matches_module(partial_digest, module)

        changed_constant: Instruction = Instruction{opcode: Opcode.Constant, result: 1, result_type: int_type(), integer: 8, span: span()}
        changed_fn: Function = Function{name: "main", parameters: [], return_type: int_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [changed_constant], blocks: [block], entry: 1}
        changed_module: Module = Module{name: "hash", functions: [changed_fn], handlers: [handler]}
        assert first != canonical_module_hash(changed_module)
        assert not artifact_fingerprint_matches_module(artifact, changed_module)

        changed_identity: Instruction = Instruction{opcode: Opcode.Constant, result: 1, result_type: int_type(), operation_id: 1u64, resumption_id: 2u64, integer: 7, span: span()}
        identity_fn: Function = Function{name: "main", parameters: [], return_type: int_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [changed_identity], blocks: [block], entry: 1}
        identity_module: Module = Module{name: "hash", functions: [identity_fn], handlers: [handler]}
        assert first != canonical_module_hash(identity_module)


@test
def canonical_module_rejects_oversized_borrowed_text_before_emission() -> void:
    can Memory.Allocate, Abort.Panic:
        oversized_name: sview = sview("", 0, 67108865)
        oversized: Module = Module{name: oversized_name, functions: []}
        assert canonical_module_bytes(oversized).count == 0
        assert canonical_module_hash(oversized) == 0


@test
def canonical_type_encoding_includes_the_third_aggregate_layer() -> void:
    can Memory.Allocate, Abort.Panic:
        nested: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Array, element_element_kind: TypeKind.Array, element_element_element_kind: TypeKind.Int, element_element_element_bits: 64, element_element_element_signed: true}
        changed: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Array, element_element_kind: TypeKind.Array, element_element_element_kind: TypeKind.Int, element_element_element_bits: 32, element_element_element_signed: true}
        first_parameter: Parameter = Parameter{value: 1, type: nested, name: "value"}
        second_parameter: Parameter = Parameter{value: 1, type: changed, name: "value"}
        first: Function = Function{name: "typed", parameters: [first_parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [], entry: 0}
        second: Function = Function{name: "typed", parameters: [second_parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [], entry: 0}
        first_module: Module = Module{name: "nested", functions: [first]}
        second_module: Module = Module{name: "nested", functions: [second]}
        assert canonical_module_hash(first_module) != canonical_module_hash(second_module)


