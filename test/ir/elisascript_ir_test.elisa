@test
def verifier_does_not_treat_handler_family_as_operation_wildcard() -> void:
    can Memory.Allocate, Abort.Panic:
        position: SourceSpan = SourceSpan{file: "handler-operation-coverage", line: 1, column: 1, end_line: 1, end_column: 1}
        callback_return: Terminator = Terminator{kind: TerminatorKind.Return, span: position}
        callback_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: callback_return}
        callback: Function = Function{name: "read_callback", parameters: [], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [callback_block], entry: 1}
        push: Instruction = Instruction{opcode: Opcode.HandlerPush, result: 0, result_type: void_type(), symbol: "echo", span: position}
        perform: Instruction = Instruction{opcode: Opcode.Perform, result: 0, result_type: void_type(), effect_family: "Echo", effect_operation: "Write", trace: TraceSite{id: 2201, label: "operation-coverage"}, span: position}
        pop: Instruction = Instruction{opcode: Opcode.HandlerPop, result: 0, result_type: void_type(), symbol: "echo", span: position}
        run_return: Terminator = Terminator{kind: TerminatorKind.Return, span: position}
        run_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 3, terminator: run_return}
        run: Function = Function{name: "run", parameters: [], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [push, perform, pop], blocks: [run_block], entry: 1}
        clause: HandlerClause = HandlerClause{effect_family: "Echo", effect_operation: "Read", function: "read_callback"}
        handler: Handler = Handler{name: "echo", handles: ["Echo"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear, clauses: [clause]}
        module: Module = Module{name: "handler-operation-coverage", functions: [callback, run], handlers: [handler]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.HandlerContract) == 0
        assert issue_count(issues, IssueKind.MissingEffect) == 1


