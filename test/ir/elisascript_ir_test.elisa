def span() -> SourceSpan:
    return SourceSpan{file: "test.elisascript", line: 1, column: 1, end_line: 1, end_column: 2}


def int_type() -> Type:
    return Type{kind: TypeKind.Int, bits: 64, signed: true}


def usize_type() -> Type:
    return Type{kind: TypeKind.Int, bits: 64, signed: false}


def void_type() -> Type:
    return Type{kind: TypeKind.Void}


def bool_type() -> Type:
    return Type{kind: TypeKind.Bool, bits: 1}


def int_array_type() -> Type:
    return Type{kind: TypeKind.Array, element_kind: TypeKind.Int, element_bits: 64, element_signed: true}


def text_int_map_type() -> Type:
    return Type{kind: TypeKind.Map, element_kind: TypeKind.Text, element_element_kind: TypeKind.Int, element_element_bits: 64, element_element_signed: true}


def int_set_type() -> Type:
    return Type{kind: TypeKind.Map, name: "__elisascript_set", element_kind: TypeKind.Int, element_bits: 64, element_signed: true, element_element_kind: TypeKind.Bool, element_element_bits: 1}


def path_type() -> Type:
    return Type{kind: TypeKind.Named, name: "Path"}


@test
def typed_process_command_contract_is_shell_free_and_bounded() -> void:
    command: ProcessCommand = ProcessCommand{executable: "printf", arguments: ["%s", "hello"], environment: ["LANG", "C"]}
    assert validate_process_command(command)
    duplicate: ProcessCommand = ProcessCommand{executable: "tool", environment: ["LANG", "C", "LANG", "en_US"]}
    duplicate_rejected: mutable bool = false
    catch validate_process_command(duplicate):
        ok value:
            assert not value
        error failure:
            assert failure == ProcessCommandError.DuplicateEnvironmentName
            duplicate_rejected <- true
    assert duplicate_rejected
    clear_with_entries: ProcessCommand = ProcessCommand{executable: "tool", environment: ["MODE", "test"], environment_mode: ProcessEnvironmentMode.Clear}
    clear_entries_rejected: mutable bool = false
    catch validate_process_command(clear_with_entries):
        ok value:
            assert false
        error failure:
            assert failure == ProcessCommandError.EnvironmentClearHasEntries
            clear_entries_rejected <- true
    assert clear_entries_rejected
    launch_limit: mutable bool = false
    exhausted_pending: mutable ProcessBatchSession = ProcessBatchSession{policy: ProcessBatchPolicy{max_jobs: 1, max_parallel: 1, max_attempts: 1, failure_mode: ProcessBatchFailureMode.FailFast}, state: ProcessBatchState.Running, jobs: [ProcessBatchJob{id: 8, attempts: 1}]}
    catch advance_process_batch(exhausted_pending, ProcessBatchEvent.Launch):
        ok value:
            assert false
        error failure:
            assert failure == ProcessBatchError.AttemptLimitExceeded
            launch_limit <- true
    assert launch_limit
    forged_empty: mutable bool = false
    catch validate_source_map(SourceMap{files: ["src/forged.elisascript"]}):
        ok value:
            assert false
        error failure:
            assert failure == SourceMapContractError.InvalidState
            forged_empty <- true
    assert forged_empty
    malformed: ProcessCommand = ProcessCommand{executable: "tool", environment: ["ODD"]}
    malformed_rejected: mutable bool = false
    catch validate_process_command(malformed):
        ok value:
            assert not value
        error failure:
            assert failure == ProcessCommandError.EnvironmentVectorMalformed
            malformed_rejected <- true
    assert malformed_rejected
    nulled: ProcessCommand = ProcessCommand{executable: "tool", arguments: ["bad\0value"]}
    nul_rejected: mutable bool = false
    catch validate_process_command(nulled):
        ok value:
            assert not value
        error failure:
            assert failure == ProcessCommandError.EmbeddedNul
            nul_rejected <- true
    assert nul_rejected
    file_missing_path: ProcessCommand = ProcessCommand{executable: "tool", stdout_mode: ProcessStdioMode.File}
    file_path_rejected: mutable bool = false
    catch validate_process_command(file_missing_path):
        ok value:
            assert not value
        error failure:
            assert failure == ProcessCommandError.InvalidStdioPath
            file_path_rejected <- true
    assert file_path_rejected
    inherit_with_path: ProcessCommand = ProcessCommand{executable: "tool", stdin_path: "input.txt"}
    inherit_path_rejected: mutable bool = false
    catch validate_process_command(inherit_with_path):
        ok value:
            assert not value
        error failure:
            assert failure == ProcessCommandError.InvalidStdioPath
            inherit_path_rejected <- true
    assert inherit_path_rejected
    nulled_path: ProcessCommand = ProcessCommand{executable: "tool", stdout_mode: ProcessStdioMode.File, stdout_path: "out\0put"}
    nul_path_rejected: mutable bool = false
    catch validate_process_command(nulled_path):
        ok value:
            assert not value
        error failure:
            assert failure == ProcessCommandError.StdioPathEmbeddedNul
            nul_path_rejected <- true
    assert nul_path_rejected
    redirected: ProcessCommand = ProcessCommand{executable: "tool", stdin_mode: ProcessStdioMode.File, stdin_path: "input.txt", stdout_mode: ProcessStdioMode.File, stdout_path: "output.txt", stderr_mode: ProcessStdioMode.File, stderr_path: "errors.txt"}
    assert validate_process_command(redirected)
    exited: ProcessResult = ProcessResult{kind: ProcessResultKind.Exited, exit_status: 7, stdout: "out", stderr: "err"}
    assert validate_process_result(exited)
    signaled: ProcessResult = ProcessResult{kind: ProcessResultKind.Signaled, signal: 9, error_text: "killed"}
    assert validate_process_result(signaled)
    bad_signal: ProcessResult = ProcessResult{kind: ProcessResultKind.Signaled}
    bad_signal_rejected: mutable bool = false
    catch validate_process_result(bad_signal):
        ok value:
            assert not value
        error failure:
            assert failure == ProcessResultError.InvalidSignal
            bad_signal_rejected <- true
    assert bad_signal_rejected
    bad_exit_signal: ProcessResult = ProcessResult{kind: ProcessResultKind.Exited, signal: 9}
    bad_exit_signal_rejected: mutable bool = false
    catch validate_process_result(bad_exit_signal):
        ok value:
            assert not value
        error failure:
            assert failure == ProcessResultError.InvalidSignal
            bad_exit_signal_rejected <- true
    assert bad_exit_signal_rejected
    oversized_signal: ProcessResult = ProcessResult{kind: ProcessResultKind.Signaled, signal: 65}
    oversized_signal_rejected: mutable bool = false
    catch validate_process_result(oversized_signal):
        ok value:
            assert false
        error failure:
            assert failure == ProcessResultError.InvalidSignal
            oversized_signal_rejected <- true
    assert oversized_signal_rejected
    nul_result: ProcessResult = ProcessResult{kind: ProcessResultKind.OutputLimit, stderr: "bad\0stderr"}
    nul_result_rejected: mutable bool = false
    catch validate_process_result(nul_result):
        ok value:
            assert not value
        error failure:
            assert failure == ProcessResultError.EmbeddedNul
            nul_result_rejected <- true
    assert nul_result_rejected
    negative_exit: mutable bool = false
    catch validate_process_result(ProcessResult{kind: ProcessResultKind.Exited, exit_status: -1}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessResultError.InvalidOutcome
            negative_exit <- true
    assert negative_exit
    job: mutable ProcessJob = ProcessJob{max_attempts: 2}
    assert advance_process_job(job, ProcessJobEvent.Start) == ProcessJobState.Running
    assert job.attempts == 1
    assert advance_process_job(job, ProcessJobEvent.Timeout) == ProcessJobState.TimedOut
    assert advance_process_job(job, ProcessJobEvent.Retry) == ProcessJobState.Created
    assert advance_process_job(job, ProcessJobEvent.Start) == ProcessJobState.Running
    assert advance_process_job(job, ProcessJobEvent.Fail) == ProcessJobState.Failed
    assert advance_process_job(job, ProcessJobEvent.Retry) == ProcessJobState.Created
    forged_job_attempt: mutable bool = false
    catch advance_process_job(ProcessJob{state: ProcessJobState.Running, max_attempts: 2}, ProcessJobEvent.Complete):
        ok value:
            assert false
        error failure:
            assert failure == ProcessJobError.InvalidState
            forged_job_attempt <- true
    assert forged_job_attempt
    forged_job_budget: mutable bool = false
    catch advance_process_job(ProcessJob{attempts: 2, max_attempts: 2}, ProcessJobEvent.Start):
        ok value:
            assert false
        error failure:
            assert failure == ProcessJobError.RetryLimitExceeded
            forged_job_budget <- true
    assert forged_job_budget
    exhausted_job: mutable ProcessJob = ProcessJob{max_attempts: 1}
    assert advance_process_job(exhausted_job, ProcessJobEvent.Start) == ProcessJobState.Running
    assert advance_process_job(exhausted_job, ProcessJobEvent.Fail) == ProcessJobState.Failed
    retry_rejected: mutable bool = false
    catch advance_process_job(exhausted_job, ProcessJobEvent.Retry):
        ok value:
            assert not value
        error failure:
            assert failure == ProcessJobError.RetryLimitExceeded
            retry_rejected <- true
    assert retry_rejected
    cancellation: mutable ProcessJob = ProcessJob{max_attempts: 1}
    assert advance_process_job(cancellation, ProcessJobEvent.Start) == ProcessJobState.Running
    assert advance_process_job(cancellation, ProcessJobEvent.Cancel) == ProcessJobState.Cancelling
    assert advance_process_job(cancellation, ProcessJobEvent.CancelAck) == ProcessJobState.Cancelled
    forged_cancelled_attempt: mutable bool = false
    catch advance_process_job(ProcessJob{state: ProcessJobState.Cancelled, max_attempts: 2}, ProcessJobEvent.CancelAck):
        ok value:
            assert false
        error failure:
            assert failure == ProcessJobError.InvalidState
            forged_cancelled_attempt <- true
    assert forged_cancelled_attempt


@test
def typed_process_output_contract_makes_redirection_and_tee_explicit() -> void:
    route: ProcessOutputRoute = ProcessOutputRoute{destinations: [ProcessOutputDestination{kind: ProcessOutputDestinationKind.Capture}, ProcessOutputDestination{kind: ProcessOutputDestinationKind.AppendFile, path: "build.log"}], tee: true}
    policy: ProcessOutputPolicy = ProcessOutputPolicy{max_destinations: 3, max_chunks: 4, max_bytes: 16, max_path_bytes: 32}
    session: mutable ProcessOutputSession = ProcessOutputSession{route: route, policy: policy}
    assert validate_process_output_session(session)
    assert advance_process_output(session, ProcessOutputEvent.Begin) == ProcessOutputState.Open
    assert advance_process_output(session, ProcessOutputEvent.Chunk, ProcessOutputChunk{sequence: 0, bytes: 3}) == ProcessOutputState.Streaming
    assert advance_process_output(session, ProcessOutputEvent.Chunk, ProcessOutputChunk{sequence: 1, bytes: 2, final_chunk: true}) == ProcessOutputState.Closed
    forged_output: mutable bool = false
    catch validate_process_output_session(ProcessOutputSession{route: route, policy: policy, state: ProcessOutputState.Streaming, next_sequence: 1, chunk_count: 0, final_seen: true}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessOutputError.AccountingInvalid
            forged_output <- true
    assert forged_output
    duplicate: mutable ProcessOutputSession = ProcessOutputSession{route: ProcessOutputRoute{destinations: [ProcessOutputDestination{kind: ProcessOutputDestinationKind.TruncateFile, path: "same"}, ProcessOutputDestination{kind: ProcessOutputDestinationKind.TruncateFile, path: "same"}], tee: true}, policy: policy}
    duplicate_rejected: mutable bool = false
    catch validate_process_output_session(duplicate):
        ok value:
            assert false
        error failure:
            assert failure == ProcessOutputError.DuplicateDestination
            duplicate_rejected <- true
    assert duplicate_rejected


@test
def typed_process_termination_contract_bounds_escalation_and_reaping() -> void:
    members: darray[ProcessTerminationMember] = [ProcessTerminationMember{pid: 101, start_token: 1}, ProcessTerminationMember{pid: 102, start_token: 2}]
    policy: ProcessTerminationPolicy = ProcessTerminationPolicy{max_members: 4, max_polls: 4, max_force_attempts: 2}
    session: mutable ProcessTerminationSession = ProcessTerminationSession{policy: policy, owner_token: 7, group_id: 77, root_pid: 101, members: members}
    assert validate_process_termination(session)
    assert advance_process_termination(session, ProcessTerminationEvent.Begin) == ProcessTerminationState.Running
    assert advance_process_termination(session, ProcessTerminationEvent.RequestGraceful) == ProcessTerminationState.GracefulRequested
    assert advance_process_termination(session, ProcessTerminationEvent.GracefulAck) == ProcessTerminationState.GracefulWaiting
    assert advance_process_termination(session, ProcessTerminationEvent.Poll) == ProcessTerminationState.GracefulWaiting
    assert advance_process_termination(session, ProcessTerminationEvent.ReportReaped, 1) == ProcessTerminationState.Reaping
    assert advance_process_termination(session, ProcessTerminationEvent.RequestForce) == ProcessTerminationState.ForceRequested
    assert advance_process_termination(session, ProcessTerminationEvent.ForceAck) == ProcessTerminationState.Reaping
    assert advance_process_termination(session, ProcessTerminationEvent.Poll) == ProcessTerminationState.Reaping
    assert advance_process_termination(session, ProcessTerminationEvent.ReportReaped, 2) == ProcessTerminationState.Reaped
    premature_reaped: mutable bool = false
    catch validate_process_termination(ProcessTerminationSession{policy: policy, owner_token: 10, group_id: 100, root_pid: 101, members: members, state: ProcessTerminationState.Reaped, reaped_members: 1}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessTerminationError.ReapCountInvalid
            premature_reaped <- true
    assert premature_reaped
    cancelled_members: darray[ProcessTerminationMember] = [ProcessTerminationMember{pid: 201, start_token: 3}]
    cancelled: mutable ProcessTerminationSession = ProcessTerminationSession{policy: policy, owner_token: 8, group_id: 88, root_pid: 201, members: cancelled_members}
    _ = advance_process_termination(cancelled, ProcessTerminationEvent.Begin)
    assert advance_process_termination(cancelled, ProcessTerminationEvent.Cancel) == ProcessTerminationState.GracefulRequested
    assert advance_process_termination(cancelled, ProcessTerminationEvent.GracefulAck) == ProcessTerminationState.GracefulWaiting
    assert advance_process_termination(cancelled, ProcessTerminationEvent.ReportReaped, 1) == ProcessTerminationState.Reaped
    duplicate_members: darray[ProcessTerminationMember] = [ProcessTerminationMember{pid: 301, start_token: 4}, ProcessTerminationMember{pid: 301, start_token: 5}]
    duplicate: mutable bool = false
    catch validate_process_termination(ProcessTerminationSession{policy: policy, owner_token: 9, group_id: 99, root_pid: 301, members: duplicate_members}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessTerminationError.DuplicateMember
            duplicate <- true
    assert duplicate
    forged_initial: mutable ProcessTerminationSession = ProcessTerminationSession{policy: policy, owner_token: 9, group_id: 99, root_pid: 101, members: members, reaped_members: 1, polls: 1}
    forged_initial_error: mutable bool = false
    catch validate_process_termination(forged_initial):
        ok value:
            assert false
        error failure:
            assert failure == ProcessTerminationError.AccountingInvalid
            forged_initial_error <- true
    assert forged_initial_error


@test
def typed_process_batch_contract_bounds_parallel_retry_and_cancel() -> void:
    jobs: mutable darray[ProcessBatchJob] = []
    jobs.push(ProcessBatchJob{id: 11})
    jobs.push(ProcessBatchJob{id: 22})
    jobs.push(ProcessBatchJob{id: 33})
    policy: ProcessBatchPolicy = ProcessBatchPolicy{max_jobs: 4, max_parallel: 2, max_attempts: 2, failure_mode: ProcessBatchFailureMode.Aggregate}
    batch: mutable ProcessBatchSession = ProcessBatchSession{policy: policy, jobs: jobs}
    assert validate_process_batch(batch)
    assert advance_process_batch(batch, ProcessBatchEvent.Begin) == ProcessBatchState.Running
    assert advance_process_batch(batch, ProcessBatchEvent.Launch) == ProcessBatchState.Running
    assert advance_process_batch(batch, ProcessBatchEvent.Launch) == ProcessBatchState.Running
    assert advance_process_batch(batch, ProcessBatchEvent.Complete, 0) == ProcessBatchState.Running
    assert advance_process_batch(batch, ProcessBatchEvent.Fail, 1) == ProcessBatchState.Running
    assert advance_process_batch(batch, ProcessBatchEvent.Retry, 1) == ProcessBatchState.Running
    assert advance_process_batch(batch, ProcessBatchEvent.Launch) == ProcessBatchState.Running
    assert advance_process_batch(batch, ProcessBatchEvent.Complete, 1) == ProcessBatchState.Running
    assert advance_process_batch(batch, ProcessBatchEvent.Launch) == ProcessBatchState.Running
    assert advance_process_batch(batch, ProcessBatchEvent.Fail, 2) == ProcessBatchState.Running
    assert advance_process_batch(batch, ProcessBatchEvent.Retry, 2) == ProcessBatchState.Running
    assert advance_process_batch(batch, ProcessBatchEvent.Launch) == ProcessBatchState.Running
    assert advance_process_batch(batch, ProcessBatchEvent.Fail, 2) == ProcessBatchState.Failed
    fail_fast_policy: ProcessBatchPolicy = ProcessBatchPolicy{max_jobs: 4, max_parallel: 2, max_attempts: 1, failure_mode: ProcessBatchFailureMode.FailFast}
    fail_fast_jobs: darray[ProcessBatchJob] = [ProcessBatchJob{id: 70}, ProcessBatchJob{id: 71}]
    fail_fast: mutable ProcessBatchSession = ProcessBatchSession{policy: fail_fast_policy, jobs: fail_fast_jobs}
    assert advance_process_batch(fail_fast, ProcessBatchEvent.Begin) == ProcessBatchState.Running
    assert advance_process_batch(fail_fast, ProcessBatchEvent.Launch) == ProcessBatchState.Running
    assert advance_process_batch(fail_fast, ProcessBatchEvent.Launch) == ProcessBatchState.Running
    assert advance_process_batch(fail_fast, ProcessBatchEvent.Fail, 0) == ProcessBatchState.Draining
    assert fail_fast.jobs[1].state == ProcessBatchJobState.Running
    assert advance_process_batch(fail_fast, ProcessBatchEvent.Complete, 1) == ProcessBatchState.Failed
    assert validate_process_batch(fail_fast)
    fail_fast_all_fail: mutable ProcessBatchSession = ProcessBatchSession{policy: fail_fast_policy, jobs: [ProcessBatchJob{id: 72}, ProcessBatchJob{id: 73}]}
    assert advance_process_batch(fail_fast_all_fail, ProcessBatchEvent.Begin) == ProcessBatchState.Running
    assert advance_process_batch(fail_fast_all_fail, ProcessBatchEvent.Launch) == ProcessBatchState.Running
    assert advance_process_batch(fail_fast_all_fail, ProcessBatchEvent.Launch) == ProcessBatchState.Running
    assert advance_process_batch(fail_fast_all_fail, ProcessBatchEvent.Fail, 0) == ProcessBatchState.Draining
    assert advance_process_batch(fail_fast_all_fail, ProcessBatchEvent.Fail, 1) == ProcessBatchState.Failed
    assert validate_process_batch(fail_fast_all_fail)
    duplicate: mutable darray[ProcessBatchJob] = []
    duplicate.push(ProcessBatchJob{id: 7})
    duplicate.push(ProcessBatchJob{id: 7})
    duplicate_rejected: mutable bool = false
    catch validate_process_batch(ProcessBatchSession{policy: policy, jobs: duplicate}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessBatchError.DuplicateJobId
            duplicate_rejected <- true
    assert duplicate_rejected
    cancellation_jobs: mutable darray[ProcessBatchJob] = []
    cancellation_jobs.push(ProcessBatchJob{id: 99})
    cancellation: mutable ProcessBatchSession = ProcessBatchSession{policy: policy, jobs: cancellation_jobs}
    assert advance_process_batch(cancellation, ProcessBatchEvent.Begin) == ProcessBatchState.Running
    assert advance_process_batch(cancellation, ProcessBatchEvent.Launch) == ProcessBatchState.Running
    assert advance_process_batch(cancellation, ProcessBatchEvent.Cancel) == ProcessBatchState.Cancelling
    assert advance_process_batch(cancellation, ProcessBatchEvent.CancelAck) == ProcessBatchState.Cancelled
    forged_cancelled: mutable ProcessBatchSession = ProcessBatchSession{policy: policy, state: ProcessBatchState.Cancelled, jobs: [ProcessBatchJob{id: 44}]}
    forged_cancelled_error: mutable bool = false
    catch validate_process_batch(forged_cancelled):
        ok value:
            assert false
        error failure:
            assert failure == ProcessBatchError.AccountingInvalid
            forged_cancelled_error <- true
    assert forged_cancelled_error
    completed_job: ProcessBatchJob = ProcessBatchJob{id: 45, state: ProcessBatchJobState.Succeeded, attempts: 1}
    forged_completed_cancelled: mutable bool = false
    catch validate_process_batch(ProcessBatchSession{policy: policy, state: ProcessBatchState.Cancelled, jobs: [completed_job], completed: 1}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessBatchError.AccountingInvalid
            forged_completed_cancelled <- true
    assert forged_completed_cancelled
    forged_failed: mutable bool = false
    catch validate_process_batch(ProcessBatchSession{policy: policy, state: ProcessBatchState.Failed, jobs: [ProcessBatchJob{id: 46}], completed: 0}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessBatchError.AccountingInvalid
            forged_failed <- true
    assert forged_failed
    forged_failed_with_pending: mutable bool = false
    failed_job: ProcessBatchJob = ProcessBatchJob{id: 47, state: ProcessBatchJobState.Failed, attempts: 1}
    pending_after_failure: ProcessBatchJob = ProcessBatchJob{id: 48}
    catch validate_process_batch(ProcessBatchSession{policy: policy, state: ProcessBatchState.Failed, jobs: [failed_job, pending_after_failure], failed: 1}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessBatchError.AccountingInvalid
            forged_failed_with_pending <- true
    assert forged_failed_with_pending
    forged_succeeded: mutable ProcessBatchSession = ProcessBatchSession{policy: policy, state: ProcessBatchState.Succeeded, jobs: [ProcessBatchJob{id: 55}], completed: 0}
    forged_succeeded_error: mutable bool = false
    catch validate_process_batch(forged_succeeded):
        ok value:
            assert false
        error failure:
            assert failure == ProcessBatchError.AccountingInvalid
            forged_succeeded_error <- true
    assert forged_succeeded_error
    forged_retryable_attempt: mutable bool = false
    catch validate_process_batch(ProcessBatchSession{policy: policy, state: ProcessBatchState.Running, jobs: [ProcessBatchJob{id: 66, state: ProcessBatchJobState.Retryable}]}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessBatchError.AccountingInvalid
            forged_retryable_attempt <- true
    assert forged_retryable_attempt


@test
def typed_file_metadata_contract_is_bounded_and_symlink_explicit() -> void:
    policy: FileMetadataPolicy = FileMetadataPolicy{max_entries: 4, max_path_bytes: 64, max_target_bytes: 64, max_total_bytes: 256, allow_missing: true, preserve_symlink: true}
    snapshot: mutable FileMetadataSnapshot = FileMetadataSnapshot{policy: policy}
    assert validate_file_metadata_snapshot(snapshot)
    assert advance_file_metadata(snapshot, FileMetadataEvent.Begin) == FileMetadataState.Reading
    regular: FileMetadataEntry = FileMetadataEntry{ordinal: 0, path: "input.txt", kind: FileMetadataKind.Regular, mode: 420, size: 12, inode: 10, device: 1, link_count: 1, modify_seconds: 5}
    link: FileMetadataEntry = FileMetadataEntry{ordinal: 1, path: "latest", kind: FileMetadataKind.Symlink, mode: 511, inode: 11, device: 1, link_count: 1, target: "input.txt"}
    missing: FileMetadataEntry = FileMetadataEntry{ordinal: 2, path: "gone", kind: FileMetadataKind.Missing, link_count: 0}
    assert advance_file_metadata(snapshot, FileMetadataEvent.Entry, regular) == FileMetadataState.Reading
    assert advance_file_metadata(snapshot, FileMetadataEvent.Entry, link) == FileMetadataState.Reading
    assert advance_file_metadata(snapshot, FileMetadataEvent.Entry, missing) == FileMetadataState.Reading
    duplicate_entry: FileMetadataEntry = FileMetadataEntry{ordinal: 3, path: "latest", kind: FileMetadataKind.Symlink, inode: 12, device: 1, target: "input.txt"}
    duplicate: mutable bool = false
    catch advance_file_metadata(snapshot, FileMetadataEvent.Entry, duplicate_entry):
        ok value:
            assert false
        error failure:
            assert failure == FileMetadataError.DuplicatePath
            duplicate <- true
    assert duplicate
    assert advance_file_metadata(snapshot, FileMetadataEvent.Seal) == FileMetadataState.Sealed
    assert file_metadata_lookup(snapshot, "latest") == 1
    late_entry: FileMetadataEntry = FileMetadataEntry{ordinal: 3, path: "late", kind: FileMetadataKind.Regular, inode: 12, device: 1}
    late: mutable bool = false
    catch advance_file_metadata(snapshot, FileMetadataEvent.Entry, late_entry):
        ok value:
            assert false
        error failure:
            assert failure == FileMetadataError.InvalidState
            late <- true
    assert late
    invalid_link: mutable FileMetadataSnapshot = FileMetadataSnapshot{policy: policy}
    _ = advance_file_metadata(invalid_link, FileMetadataEvent.Begin)
    bad_target: mutable bool = false
    catch advance_file_metadata(invalid_link, FileMetadataEvent.Entry, FileMetadataEntry{ordinal: 0, path: "link", kind: FileMetadataKind.Symlink, inode: 1, device: 1}):
        ok value:
            assert false
        error failure:
            assert failure == FileMetadataError.SymlinkTargetInvalid
            bad_target <- true
    assert bad_target
    forged_metadata: mutable FileMetadataSnapshot = FileMetadataSnapshot{policy: policy, entries: [FileMetadataEntry{ordinal: 0, path: "forged", kind: FileMetadataKind.Regular, inode: 2, device: 1}], total_bytes: 6}
    forged_metadata_error: mutable bool = false
    catch validate_file_metadata_snapshot(forged_metadata):
        ok value:
            assert false
        error failure:
            assert failure == FileMetadataError.AccountingInvalid
            forged_metadata_error <- true
    assert forged_metadata_error
    forged_missing: mutable bool = false
    catch validate_file_metadata_snapshot(FileMetadataSnapshot{policy: policy, state: FileMetadataState.Reading, entries: [FileMetadataEntry{ordinal: 0, path: "gone", kind: FileMetadataKind.Missing}], total_bytes: 4}):
        ok value:
            assert false
        error failure:
            assert failure == FileMetadataError.InvalidIdentity
            forged_missing <- true
    assert forged_missing
    forged_missing_metadata: mutable bool = false
    catch validate_file_metadata_snapshot(FileMetadataSnapshot{policy: policy, state: FileMetadataState.Reading, entries: [FileMetadataEntry{ordinal: 0, path: "gone", kind: FileMetadataKind.Missing, mode: 420, modify_seconds: 5}], total_bytes: 4}):
        ok value:
            assert false
        error failure:
            assert failure == FileMetadataError.InvalidIdentity
            forged_missing_metadata <- true
    assert forged_missing_metadata


@test
def typed_file_lock_contract_distinguishes_shared_exclusive_and_waits() -> void:
    policy: FileLockPolicy = FileLockPolicy{max_leases: 8, max_path_bytes: 64, max_attempts: 4}
    table: mutable FileLockTable = FileLockTable{policy: policy}
    shared_one: mutable FileLockSession = FileLockSession{request: FileLockRequest{path: "state.db", owner_token: 1, mode: FileLockMode.Shared}}
    shared_two: mutable FileLockSession = FileLockSession{request: FileLockRequest{path: "state.db", owner_token: 2, mode: FileLockMode.Shared}}
    assert validate_file_lock_session(table, shared_one)
    assert advance_file_lock(table, shared_one, FileLockEvent.Begin) == FileLockState.Waiting
    assert advance_file_lock(table, shared_one, FileLockEvent.Acquire) == FileLockState.Held
    assert advance_file_lock(table, shared_two, FileLockEvent.Begin) == FileLockState.Waiting
    assert advance_file_lock(table, shared_two, FileLockEvent.Acquire) == FileLockState.Held
    assert validate_file_lock_table(table)
    reentrant: mutable FileLockSession = FileLockSession{request: FileLockRequest{path: "state.db", owner_token: 1, mode: FileLockMode.Shared}}
    _ = advance_file_lock(table, reentrant, FileLockEvent.Begin)
    reentrant_rejected: mutable bool = false
    catch advance_file_lock(table, reentrant, FileLockEvent.Acquire):
        ok value:
            assert false
        error failure:
            assert failure == FileLockError.Conflict
            reentrant_rejected <- true
    assert reentrant_rejected
    assert advance_file_lock(table, reentrant, FileLockEvent.Cancel) == FileLockState.Cancelling
    assert advance_file_lock(table, reentrant, FileLockEvent.CancelAck) == FileLockState.Cancelled
    exclusive: mutable FileLockSession = FileLockSession{request: FileLockRequest{path: "state.db", owner_token: 3, mode: FileLockMode.Exclusive}}
    _ = advance_file_lock(table, exclusive, FileLockEvent.Begin)
    conflict: mutable bool = false
    catch advance_file_lock(table, exclusive, FileLockEvent.Acquire):
        ok value:
            assert false
        error failure:
            assert failure == FileLockError.Conflict
            conflict <- true
    assert conflict
    assert advance_file_lock(table, shared_one, FileLockEvent.Release) == FileLockState.Releasing
    assert advance_file_lock(table, shared_one, FileLockEvent.ReleaseAck) == FileLockState.Released
    assert advance_file_lock(table, shared_two, FileLockEvent.Release) == FileLockState.Releasing
    assert advance_file_lock(table, shared_two, FileLockEvent.ReleaseAck) == FileLockState.Released
    assert advance_file_lock(table, exclusive, FileLockEvent.Acquire) == FileLockState.Held
    bounded: mutable FileLockSession = FileLockSession{request: FileLockRequest{path: "state.db", owner_token: 4, mode: FileLockMode.Shared, wait_mode: FileLockWaitMode.Bounded, max_attempts: 2}}
    assert advance_file_lock(table, bounded, FileLockEvent.Begin) == FileLockState.Waiting
    retry_without_attempt: mutable bool = false
    catch advance_file_lock(table, bounded, FileLockEvent.Retry):
        ok value:
            assert false
        error failure:
            assert failure == FileLockError.RetryNotAllowed
            retry_without_attempt <- true
    assert retry_without_attempt
    would_block: mutable bool = false
    catch advance_file_lock(table, bounded, FileLockEvent.Acquire):
        ok value:
            assert false
        error failure:
            assert failure == FileLockError.WouldBlock
            would_block <- true
    assert would_block
    assert advance_file_lock(table, bounded, FileLockEvent.Retry) == FileLockState.Waiting
    repeated_retry: mutable bool = false
    catch advance_file_lock(table, bounded, FileLockEvent.Retry):
        ok value:
            assert false
        error failure:
            assert failure == FileLockError.RetryNotAllowed
            repeated_retry <- true
    assert repeated_retry
    assert advance_file_lock(table, bounded, FileLockEvent.Acquire) == FileLockState.TimedOut
    timeout_without_attempt: mutable FileLockSession = FileLockSession{request: FileLockRequest{path: "state.db", owner_token: 12, mode: FileLockMode.Shared, wait_mode: FileLockWaitMode.Bounded, max_attempts: 2}}
    assert advance_file_lock(table, timeout_without_attempt, FileLockEvent.Begin) == FileLockState.Waiting
    timeout_without_attempt_rejected: mutable bool = false
    catch advance_file_lock(table, timeout_without_attempt, FileLockEvent.Timeout):
        ok value:
            assert false
        error failure:
            assert failure == FileLockError.AccountingInvalid
            timeout_without_attempt_rejected <- true
    assert timeout_without_attempt_rejected
    assert advance_file_lock(table, exclusive, FileLockEvent.Release) == FileLockState.Releasing
    assert advance_file_lock(table, exclusive, FileLockEvent.ReleaseAck) == FileLockState.Released
    failed: mutable FileLockSession = FileLockSession{request: FileLockRequest{path: "state.db", owner_token: 6, mode: FileLockMode.Exclusive}}
    _ = advance_file_lock(table, failed, FileLockEvent.Begin)
    assert advance_file_lock(table, failed, FileLockEvent.Acquire) == FileLockState.Held
    assert advance_file_lock(table, failed, FileLockEvent.Fail) == FileLockState.Failed
    assert table.active_leases == 0
    assert validate_file_lock_table(table)
    cancelled: mutable FileLockSession = FileLockSession{request: FileLockRequest{path: "state.db", owner_token: 5, mode: FileLockMode.Exclusive, wait_mode: FileLockWaitMode.Bounded, max_attempts: 2}}
    _ = advance_file_lock(table, cancelled, FileLockEvent.Begin)
    assert advance_file_lock(table, cancelled, FileLockEvent.Cancel) == FileLockState.Cancelling
    assert advance_file_lock(table, cancelled, FileLockEvent.CancelAck) == FileLockState.Cancelled
    forged_identity: mutable bool = false
    catch validate_file_lock_table(FileLockTable{policy: policy, leases: [FileLockLease{lease_id: 1, path: "state.db", owner_token: 9, mode: FileLockMode.Shared}], active_leases: 1, next_lease_id: 1}):
        ok value:
            assert false
        error failure:
            assert failure == FileLockError.InvalidLeaseId
            forged_identity <- true
    assert forged_identity
    forged_held_attempt: mutable bool = false
    catch validate_file_lock_session(FileLockTable{policy: policy, leases: [FileLockLease{lease_id: 1, path: "state.db", owner_token: 9, mode: FileLockMode.Shared}], active_leases: 1, next_lease_id: 2}, FileLockSession{request: FileLockRequest{path: "state.db", owner_token: 9, mode: FileLockMode.Shared}, state: FileLockState.Held, lease_id: 1}):
        ok value:
            assert false
        error failure:
            assert failure == FileLockError.AccountingInvalid
            forged_held_attempt <- true
    assert forged_held_attempt
    exhausted_table: mutable FileLockTable = FileLockTable{policy: policy, next_lease_id: 18446744073709551615u64}
    exhausted_session: mutable FileLockSession = FileLockSession{request: FileLockRequest{path: "state.db", owner_token: 10, mode: FileLockMode.Exclusive}}
    assert advance_file_lock(exhausted_table, exhausted_session, FileLockEvent.Begin) == FileLockState.Waiting
    exhausted_rejected: mutable bool = false
    catch advance_file_lock(exhausted_table, exhausted_session, FileLockEvent.Acquire):
        ok value:
            assert false
        error failure:
            assert failure == FileLockError.InvalidLeaseId
            exhausted_rejected <- true
    assert exhausted_rejected
    assert exhausted_session.lease_id == 0
    assert exhausted_table.leases.count == 0
    assert exhausted_table.next_lease_id == 18446744073709551615u64


@test
def typed_directory_tree_contract_bounds_depth_and_cycles() -> void:
    policy: DirectoryTreePolicy = DirectoryTreePolicy{max_depth: 2, max_entries: 8, max_bytes: 64, max_identities: 8, symlink_policy: DirectoryTreeSymlinkPolicy.DoNotFollow, failure_mode: DirectoryTreeFailureMode.Collect}
    session: mutable DirectoryTreeSession = DirectoryTreeSession{policy: policy}
    assert validate_directory_tree(session)
    assert advance_directory_tree(session, DirectoryTreeEvent.Begin) == DirectoryTreeState.Walking
    root: DirectoryTreeEntry = DirectoryTreeEntry{path: "/tmp/tree", identity: 1, depth: 0, kind: DirectoryTreeEntryKind.Directory}
    child: DirectoryTreeEntry = DirectoryTreeEntry{path: "/tmp/tree/file", identity: 2, depth: 1, kind: DirectoryTreeEntryKind.Regular, bytes: 4}
    assert advance_directory_tree(session, DirectoryTreeEvent.Visit, root) == DirectoryTreeState.Walking
    assert advance_directory_tree(session, DirectoryTreeEvent.Descend) == DirectoryTreeState.Walking
    assert advance_directory_tree(session, DirectoryTreeEvent.Visit, child) == DirectoryTreeState.Walking
    assert advance_directory_tree(session, DirectoryTreeEvent.Leave) == DirectoryTreeState.Walking
    assert advance_directory_tree(session, DirectoryTreeEvent.Complete) == DirectoryTreeState.Complete
    repeated_descend: mutable DirectoryTreeSession = DirectoryTreeSession{policy: policy}
    _ = advance_directory_tree(repeated_descend, DirectoryTreeEvent.Begin)
    nested_root: DirectoryTreeEntry = DirectoryTreeEntry{path: "/tmp/tree/nested", identity: 10, depth: 0, kind: DirectoryTreeEntryKind.Directory}
    nested_child: DirectoryTreeEntry = DirectoryTreeEntry{path: "/tmp/tree/nested/child", identity: 11, depth: 1, kind: DirectoryTreeEntryKind.Directory}
    _ = advance_directory_tree(repeated_descend, DirectoryTreeEvent.Visit, nested_root)
    _ = advance_directory_tree(repeated_descend, DirectoryTreeEvent.Descend)
    _ = advance_directory_tree(repeated_descend, DirectoryTreeEvent.Visit, nested_child)
    _ = advance_directory_tree(repeated_descend, DirectoryTreeEvent.Descend)
    _ = advance_directory_tree(repeated_descend, DirectoryTreeEvent.Leave)
    repeated_descend_rejected: mutable bool = false
    catch advance_directory_tree(repeated_descend, DirectoryTreeEvent.Descend):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryTreeError.ParentDepthMismatch
            repeated_descend_rejected <- true
    assert repeated_descend_rejected
    follow_symlink: mutable DirectoryTreeSession = DirectoryTreeSession{policy: DirectoryTreePolicy{max_depth: 2, max_entries: 4, max_bytes: 64, max_identities: 4, symlink_policy: DirectoryTreeSymlinkPolicy.FollowDirectories, failure_mode: DirectoryTreeFailureMode.FailFast}}
    _ = advance_directory_tree(follow_symlink, DirectoryTreeEvent.Begin)
    link_directory: DirectoryTreeEntry = DirectoryTreeEntry{path: "/tmp/tree/link", identity: 3, depth: 0, kind: DirectoryTreeEntryKind.Symlink}
    assert advance_directory_tree(follow_symlink, DirectoryTreeEvent.Visit, link_directory) == DirectoryTreeState.Walking
    assert advance_directory_tree(follow_symlink, DirectoryTreeEvent.Descend) == DirectoryTreeState.Walking
    assert advance_directory_tree(follow_symlink, DirectoryTreeEvent.Leave) == DirectoryTreeState.Walking
    fail_fast_walk: mutable DirectoryTreeSession = DirectoryTreeSession{policy: DirectoryTreePolicy{max_depth: 2, max_entries: 4, max_bytes: 64, max_identities: 4, failure_mode: DirectoryTreeFailureMode.FailFast}}
    _ = advance_directory_tree(fail_fast_walk, DirectoryTreeEvent.Begin)
    _ = advance_directory_tree(fail_fast_walk, DirectoryTreeEvent.Visit, root)
    _ = advance_directory_tree(fail_fast_walk, DirectoryTreeEvent.Descend)
    assert advance_directory_tree(fail_fast_walk, DirectoryTreeEvent.Fail) == DirectoryTreeState.Walking
    fail_fast_visit_rejected: mutable bool = false
    catch advance_directory_tree(fail_fast_walk, DirectoryTreeEvent.Visit, child):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryTreeError.WalkNotOpen
            fail_fast_visit_rejected <- true
    assert fail_fast_visit_rejected
    assert advance_directory_tree(fail_fast_walk, DirectoryTreeEvent.Leave) == DirectoryTreeState.Failed
    assert validate_directory_tree(fail_fast_walk)
    forged_accounting: mutable bool = false
    catch validate_directory_tree(DirectoryTreeSession{policy: policy, entries: [child], total_bytes: 99}):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryTreeError.AccountingInvalid
            forged_accounting <- true
    assert forged_accounting
    failure_limit: mutable bool = false
    limited_failure: mutable DirectoryTreeSession = DirectoryTreeSession{policy: DirectoryTreePolicy{max_depth: 2, max_entries: 1, max_bytes: 64, max_identities: 1, failure_mode: DirectoryTreeFailureMode.Collect}, state: DirectoryTreeState.Walking, failures: 1}
    catch advance_directory_tree(limited_failure, DirectoryTreeEvent.Fail):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryTreeError.FailureLimitExceeded
            failure_limit <- true
    assert failure_limit
    forged_cancelled: mutable bool = false
    catch validate_directory_tree(DirectoryTreeSession{policy: policy, state: DirectoryTreeState.Cancelled, active_depth: 1}):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryTreeError.ParentDepthMismatch
            forged_cancelled <- true
    assert forged_cancelled
    cycle: mutable DirectoryTreeSession = DirectoryTreeSession{policy: policy}
    _ = advance_directory_tree(cycle, DirectoryTreeEvent.Begin)
    _ = advance_directory_tree(cycle, DirectoryTreeEvent.Visit, root)
    cycle_rejected: mutable bool = false
    catch advance_directory_tree(cycle, DirectoryTreeEvent.Visit, root):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryTreeError.CycleDetected
            cycle_rejected <- true
    assert cycle_rejected
    symlink: mutable DirectoryTreeSession = DirectoryTreeSession{policy: policy}
    _ = advance_directory_tree(symlink, DirectoryTreeEvent.Begin)
    link: DirectoryTreeEntry = DirectoryTreeEntry{path: "/tmp/tree/link", identity: 3, depth: 0, kind: DirectoryTreeEntryKind.Symlink}
    _ = advance_directory_tree(symlink, DirectoryTreeEvent.Visit, link)
    denied: mutable bool = false
    catch advance_directory_tree(symlink, DirectoryTreeEvent.Descend):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryTreeError.NotDirectory
            denied <- true
    assert denied
    forged_planned: mutable DirectoryTreeSession = DirectoryTreeSession{policy: policy, entries: [root], identities: [1]}
    forged_planned_error: mutable bool = false
    catch validate_directory_tree(forged_planned):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryTreeError.AccountingInvalid
            forged_planned_error <- true
    assert forged_planned_error
    forged_tree_complete: mutable DirectoryTreeSession = DirectoryTreeSession{policy: policy, state: DirectoryTreeState.Complete, active_depth: 1}
    forged_tree_complete_error: mutable bool = false
    catch validate_directory_tree(forged_tree_complete):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryTreeError.ParentDepthMismatch
            forged_tree_complete_error <- true
    assert forged_tree_complete_error
    depth_mismatch: mutable DirectoryTreeSession = DirectoryTreeSession{policy: policy}
    _ = advance_directory_tree(depth_mismatch, DirectoryTreeEvent.Begin)
    _ = advance_directory_tree(depth_mismatch, DirectoryTreeEvent.Visit, root)
    _ = advance_directory_tree(depth_mismatch, DirectoryTreeEvent.Descend)
    lower_depth_rejected: mutable bool = false
    catch advance_directory_tree(depth_mismatch, DirectoryTreeEvent.Visit, DirectoryTreeEntry{path: "/tmp/tree/alias", identity: 4, depth: 0, kind: DirectoryTreeEntryKind.Regular}):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryTreeError.ParentDepthMismatch
            lower_depth_rejected <- true
    assert lower_depth_rejected


@test
def typed_directory_mutation_contract_tracks_copy_remove_and_partial_failure() -> void:
    copy_policy: DirectoryMutationPolicy = DirectoryMutationPolicy{max_entries: 8, max_depth: 4, max_identities: 8, max_path_bytes: 64, max_bytes: 64, max_failures: 4, symlink_policy: DirectoryMutationSymlinkPolicy.Preserve, failure_mode: DirectoryMutationFailureMode.FailFast}
    collision_entries: darray[DirectoryMutationEntry] = [DirectoryMutationEntry{ordinal: 0, source: "/tmp/source/a", destination: "/tmp/destination/out", identity: 10, depth: 0, kind: DirectoryMutationEntryKind.Regular, state: DirectoryMutationEntryState.Applied}, DirectoryMutationEntry{ordinal: 1, source: "/tmp/source/b", destination: "/tmp/destination/out", identity: 11, depth: 0, kind: DirectoryMutationEntryKind.Regular, state: DirectoryMutationEntryState.Applied}]
    collision: mutable DirectoryMutationSession = DirectoryMutationSession{operation: DirectoryMutationOperation.Copy, source_path: "/tmp/source", destination_path: "/tmp/destination", policy: copy_policy, state: DirectoryMutationState.Executing, entries: collision_entries, identities: [10, 11], applied_entries: 2}
    collision_error: mutable bool = false
    catch validate_directory_mutation(collision):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryMutationError.DestinationCollision
            collision_error <- true
    assert collision_error
    forged_complete: mutable DirectoryMutationSession = DirectoryMutationSession{operation: DirectoryMutationOperation.Copy, source_path: "/tmp/source", destination_path: "/tmp/destination", policy: copy_policy, state: DirectoryMutationState.Completed, active_depth: 1}
    forged_complete_error: mutable bool = false
    catch validate_directory_mutation(forged_complete):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryMutationError.ActiveScope
            forged_complete_error <- true
    assert forged_complete_error
    copy: mutable DirectoryMutationSession = DirectoryMutationSession{operation: DirectoryMutationOperation.Copy, source_path: "/tmp/source", destination_path: "/tmp/destination", policy: copy_policy}
    assert validate_directory_mutation(copy)
    nested_destination: mutable bool = false
    catch validate_directory_mutation(DirectoryMutationSession{operation: DirectoryMutationOperation.Copy, source_path: "/tmp/source", destination_path: "/tmp/source/sub", policy: copy_policy}):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryMutationError.DestinationCollision
            nested_destination <- true
    assert nested_destination
    assert advance_directory_mutation(copy, DirectoryMutationEvent.Begin) == DirectoryMutationState.Executing
    root: DirectoryMutationEntry = DirectoryMutationEntry{ordinal: 0, source: "/tmp/source", destination: "/tmp/destination", identity: 1, depth: 0, kind: DirectoryMutationEntryKind.Directory}
    child: DirectoryMutationEntry = DirectoryMutationEntry{ordinal: 1, source: "/tmp/source/item", destination: "/tmp/destination/item", identity: 2, depth: 1, kind: DirectoryMutationEntryKind.Regular, bytes: 4}
    link: DirectoryMutationEntry = DirectoryMutationEntry{ordinal: 2, source: "/tmp/source/link", destination: "/tmp/destination/link", identity: 3, depth: 0, kind: DirectoryMutationEntryKind.Symlink}
    assert advance_directory_mutation(copy, DirectoryMutationEvent.Plan, root) == DirectoryMutationState.Executing
    assert advance_directory_mutation(copy, DirectoryMutationEvent.Apply) == DirectoryMutationState.Executing
    assert advance_directory_mutation(copy, DirectoryMutationEvent.Enter) == DirectoryMutationState.Executing
    repeated_enter_rejected: mutable bool = false
    catch advance_directory_mutation(copy, DirectoryMutationEvent.Enter):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryMutationError.EntryNotApplied
            repeated_enter_rejected <- true
    assert repeated_enter_rejected
    assert advance_directory_mutation(copy, DirectoryMutationEvent.Plan, child) == DirectoryMutationState.Executing
    assert advance_directory_mutation(copy, DirectoryMutationEvent.Apply) == DirectoryMutationState.Executing
    regular_enter_rejected: mutable bool = false
    catch advance_directory_mutation(copy, DirectoryMutationEvent.Enter):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryMutationError.NotDirectory
            regular_enter_rejected <- true
    assert regular_enter_rejected
    stale_regular_enter_rejected: mutable bool = false
    catch advance_directory_mutation(copy, DirectoryMutationEvent.Enter):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryMutationError.EntryNotApplied
            stale_regular_enter_rejected <- true
    assert stale_regular_enter_rejected
    assert advance_directory_mutation(copy, DirectoryMutationEvent.Leave) == DirectoryMutationState.Executing
    assert advance_directory_mutation(copy, DirectoryMutationEvent.Plan, link) == DirectoryMutationState.Executing
    assert advance_directory_mutation(copy, DirectoryMutationEvent.Apply) == DirectoryMutationState.Executing
    assert advance_directory_mutation(copy, DirectoryMutationEvent.Complete) == DirectoryMutationState.Completed
    assert copy.applied_entries == 3
    forged_identity: mutable bool = false
    catch validate_directory_mutation(DirectoryMutationSession{operation: DirectoryMutationOperation.Copy, source_path: "/tmp/source", destination_path: "/tmp/destination", policy: copy_policy, entries: [root], identities: [99]}):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryMutationError.AccountingInvalid
            forged_identity <- true
    assert forged_identity
    cycle: mutable DirectoryMutationSession = DirectoryMutationSession{operation: DirectoryMutationOperation.Copy, source_path: "/tmp/source", destination_path: "/tmp/destination", policy: copy_policy}
    _ = advance_directory_mutation(cycle, DirectoryMutationEvent.Begin)
    _ = advance_directory_mutation(cycle, DirectoryMutationEvent.Plan, root)
    _ = advance_directory_mutation(cycle, DirectoryMutationEvent.Apply)
    _ = advance_directory_mutation(cycle, DirectoryMutationEvent.Enter)
    duplicate: mutable bool = false
    catch advance_directory_mutation(cycle, DirectoryMutationEvent.Plan, DirectoryMutationEntry{ordinal: 1, source: "/tmp/source/alias", destination: "/tmp/destination/alias", identity: 1, depth: 1, kind: DirectoryMutationEntryKind.Directory}):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryMutationError.DuplicateIdentity
            duplicate <- true
    assert duplicate
    fail_fast_mutation: mutable DirectoryMutationSession = DirectoryMutationSession{operation: DirectoryMutationOperation.Copy, source_path: "/tmp/source", destination_path: "/tmp/destination", policy: copy_policy}
    _ = advance_directory_mutation(fail_fast_mutation, DirectoryMutationEvent.Begin)
    _ = advance_directory_mutation(fail_fast_mutation, DirectoryMutationEvent.Plan, root)
    _ = advance_directory_mutation(fail_fast_mutation, DirectoryMutationEvent.Apply)
    _ = advance_directory_mutation(fail_fast_mutation, DirectoryMutationEvent.Enter)
    assert advance_directory_mutation(fail_fast_mutation, DirectoryMutationEvent.Failure) == DirectoryMutationState.Executing
    fail_fast_plan_rejected: mutable bool = false
    catch advance_directory_mutation(fail_fast_mutation, DirectoryMutationEvent.Plan, child):
        ok value:
            assert false
        error failure:
            assert failure == DirectoryMutationError.InvalidTransition
            fail_fast_plan_rejected <- true
    assert fail_fast_plan_rejected
    assert advance_directory_mutation(fail_fast_mutation, DirectoryMutationEvent.Leave) == DirectoryMutationState.Failed
    assert validate_directory_mutation(fail_fast_mutation)
    remove_policy: DirectoryMutationPolicy = DirectoryMutationPolicy{max_entries: 8, max_depth: 4, max_identities: 8, max_path_bytes: 64, max_bytes: 64, max_failures: 4, symlink_policy: DirectoryMutationSymlinkPolicy.Skip, failure_mode: DirectoryMutationFailureMode.Collect}
    remove: mutable DirectoryMutationSession = DirectoryMutationSession{operation: DirectoryMutationOperation.Remove, source_path: "/tmp/remove", policy: remove_policy}
    assert advance_directory_mutation(remove, DirectoryMutationEvent.Begin) == DirectoryMutationState.Executing
    failed_entry: DirectoryMutationEntry = DirectoryMutationEntry{ordinal: 0, source: "/tmp/remove/missing", identity: 4, depth: 0, kind: DirectoryMutationEntryKind.Regular, bytes: 2}
    assert advance_directory_mutation(remove, DirectoryMutationEvent.Plan, failed_entry) == DirectoryMutationState.Executing
    assert advance_directory_mutation(remove, DirectoryMutationEvent.Failure) == DirectoryMutationState.Executing
    assert remove.failure_count == 1
    assert advance_directory_mutation(remove, DirectoryMutationEvent.Complete) == DirectoryMutationState.Completed
    cancelled: mutable DirectoryMutationSession = DirectoryMutationSession{operation: DirectoryMutationOperation.Remove, source_path: "/tmp/cancel", policy: remove_policy}
    _ = advance_directory_mutation(cancelled, DirectoryMutationEvent.Begin)
    assert advance_directory_mutation(cancelled, DirectoryMutationEvent.Cancel) == DirectoryMutationState.Cancelled


@test
def typed_working_directory_contract_serializes_changes_and_restore() -> void:
    policy: WorkingDirectoryPolicy = WorkingDirectoryPolicy{max_contexts: 4, max_path_bytes: 64, max_changes: 4}
    table: mutable WorkingDirectoryTable = WorkingDirectoryTable{policy: policy}
    first: mutable WorkingDirectorySession = WorkingDirectorySession{request: WorkingDirectoryRequest{initial_path: "/tmp/base", owner_token: 1, max_changes: 2}}
    assert advance_working_directory(table, first, WorkingDirectoryEvent.Begin) == WorkingDirectoryState.Held
    concurrent: mutable WorkingDirectorySession = WorkingDirectorySession{request: WorkingDirectoryRequest{initial_path: "/tmp/other", owner_token: 2}}
    concurrent_rejected: mutable bool = false
    catch advance_working_directory(table, concurrent, WorkingDirectoryEvent.Begin):
        ok value:
            assert false
        error failure:
            assert failure == WorkingDirectoryError.ConcurrentOwner
            concurrent_rejected <- true
    assert concurrent_rejected
    assert advance_working_directory(table, first, WorkingDirectoryEvent.Change, "/tmp/work") == WorkingDirectoryState.Changing
    assert advance_working_directory(table, first, WorkingDirectoryEvent.ChangeAck) == WorkingDirectoryState.Held
    assert first.changes == 1
    assert advance_working_directory(table, first, WorkingDirectoryEvent.Restore) == WorkingDirectoryState.Restoring
    assert advance_working_directory(table, first, WorkingDirectoryEvent.RestoreAck) == WorkingDirectoryState.Restored
    assert validate_working_directory_table(table)
    cancelled: mutable WorkingDirectorySession = WorkingDirectorySession{request: WorkingDirectoryRequest{initial_path: "/tmp/base", owner_token: 3}}
    assert advance_working_directory(table, cancelled, WorkingDirectoryEvent.Begin) == WorkingDirectoryState.Held
    assert advance_working_directory(table, cancelled, WorkingDirectoryEvent.Cancel) == WorkingDirectoryState.Cancelling
    assert advance_working_directory(table, cancelled, WorkingDirectoryEvent.CancelAck) == WorkingDirectoryState.Cancelled
    failed: mutable WorkingDirectorySession = WorkingDirectorySession{request: WorkingDirectoryRequest{initial_path: "/tmp/base", owner_token: 4}}
    _ = advance_working_directory(table, failed, WorkingDirectoryEvent.Begin)
    _ = advance_working_directory(table, failed, WorkingDirectoryEvent.Change, "/tmp/unrecoverable")
    assert advance_working_directory(table, failed, WorkingDirectoryEvent.Fail) == WorkingDirectoryState.Failed
    assert table.active_contexts == 0
    assert validate_working_directory_table(table)
    forged_identity: mutable bool = false
    catch validate_working_directory_table(WorkingDirectoryTable{policy: policy, leases: [WorkingDirectoryLease{lease_id: 1, owner_token: 8, initial_path: "/tmp/base", current_path: "/tmp/base"}], active_contexts: 1, next_lease_id: 1}):
        ok value:
            assert false
        error failure:
            assert failure == WorkingDirectoryError.InvalidLeaseId
            forged_identity <- true
    assert forged_identity
    forged_pending_path: mutable bool = false
    catch validate_working_directory_table(WorkingDirectoryTable{policy: policy, leases: [WorkingDirectoryLease{lease_id: 1, owner_token: 8, initial_path: "/tmp/base", current_path: "/tmp/base", state: WorkingDirectoryLeaseState.Changing}], active_contexts: 1, next_lease_id: 2}):
        ok value:
            assert false
        error failure:
            assert failure == WorkingDirectoryError.InvalidTransition
            forged_pending_path <- true
    assert forged_pending_path
    exhausted_table: mutable WorkingDirectoryTable = WorkingDirectoryTable{policy: policy, next_lease_id: 18446744073709551615u64}
    exhausted_session: mutable WorkingDirectorySession = WorkingDirectorySession{request: WorkingDirectoryRequest{initial_path: "/tmp/base", owner_token: 9}}
    exhausted_rejected: mutable bool = false
    catch advance_working_directory(exhausted_table, exhausted_session, WorkingDirectoryEvent.Begin):
        ok value:
            assert false
        error failure:
            assert failure == WorkingDirectoryError.InvalidLeaseId
            exhausted_rejected <- true
    assert exhausted_rejected
    assert exhausted_session.lease_id == 0
    assert exhausted_table.leases.count == 0
    assert exhausted_table.next_lease_id == 18446744073709551615u64


@test
def typed_environment_snapshot_contract_is_bounded_and_tombstone_stable() -> void:
    snapshot: mutable EnvironmentSnapshot = EnvironmentSnapshot{}
    assert validate_environment_snapshot(snapshot)
    assert advance_environment_snapshot(snapshot, EnvironmentEvent.Begin) == EnvironmentState.Building
    assert advance_environment_snapshot(snapshot, EnvironmentEvent.Set, "PATH", "/bin") == EnvironmentState.Building
    assert advance_environment_snapshot(snapshot, EnvironmentEvent.Set, "LANG", "C") == EnvironmentState.Building
    assert advance_environment_snapshot(snapshot, EnvironmentEvent.Unset, "PATH") == EnvironmentState.Building
    assert advance_environment_snapshot(snapshot, EnvironmentEvent.Seal) == EnvironmentState.Sealed
    assert environment_lookup(snapshot, "LANG") == 1
    missing: mutable bool = false
    catch environment_lookup(snapshot, "PATH"):
        ok value:
            assert false
        error failure:
            assert failure == EnvironmentContractError.NameMissing
            missing <- true
    assert missing
    failed: mutable EnvironmentSnapshot = EnvironmentSnapshot{}
    assert advance_environment_snapshot(failed, EnvironmentEvent.Begin) == EnvironmentState.Building
    assert advance_environment_snapshot(failed, EnvironmentEvent.Fail) == EnvironmentState.Failed
    assert advance_environment_snapshot(failed, EnvironmentEvent.Reset) == EnvironmentState.Ready
    forged: mutable EnvironmentSnapshot = EnvironmentSnapshot{entries: [EnvironmentEntry{name: "FORGED", value: "1"}], text_bytes: 8}
    forged_error: mutable bool = false
    catch validate_environment_snapshot(forged):
        ok value:
            assert false
        error failure:
            assert failure == EnvironmentContractError.AccountingInvalid
            forged_error <- true
    assert forged_error
    invalid_unset: mutable EnvironmentSnapshot = EnvironmentSnapshot{}
    assert advance_environment_snapshot(invalid_unset, EnvironmentEvent.Begin) == EnvironmentState.Building
    invalid_unset_error: mutable bool = false
    catch advance_environment_snapshot(invalid_unset, EnvironmentEvent.Unset, "BAD=NAME"):
        ok value:
            assert false
        error failure:
            assert failure == EnvironmentContractError.NameInvalid
            invalid_unset_error <- true
    assert invalid_unset_error


@test
def typed_process_pipeline_contract_is_ordered_and_cancellable() -> void:
    first_stage: ProcessCommand = ProcessCommand{executable: "producer", stdout_mode: ProcessStdioMode.Capture}
    second_stage: ProcessCommand = ProcessCommand{executable: "consumer", stdin_mode: ProcessStdioMode.Capture, stdout_mode: ProcessStdioMode.Capture}
    stages: mutable darray[ProcessCommand] = []
    stages.push(first_stage)
    stages.push(second_stage)
    pipeline: mutable ProcessPipeline = ProcessPipeline{stages: stages, failure_mode: ProcessPipelineFailureMode.Aggregate, buffer_limit_bytes: 4096}
    assert validate_process_pipeline(pipeline)
    assert advance_process_pipeline(pipeline, ProcessPipelineEvent.Start) == ProcessPipelineState.Running
    assert advance_process_pipeline(pipeline, ProcessPipelineEvent.StageExit, 0) == ProcessPipelineState.Running
    assert advance_process_pipeline(pipeline, ProcessPipelineEvent.StageExit, 1) == ProcessPipelineState.Succeeded
    failing_stages: mutable darray[ProcessCommand] = []
    failing_stages.push(first_stage)
    failing_stages.push(second_stage)
    failing_pipeline: mutable ProcessPipeline = ProcessPipeline{stages: failing_stages, failure_mode: ProcessPipelineFailureMode.FailFast}
    assert advance_process_pipeline(failing_pipeline, ProcessPipelineEvent.Start) == ProcessPipelineState.Running
    assert advance_process_pipeline(failing_pipeline, ProcessPipelineEvent.StageFailure, 0) == ProcessPipelineState.Cancelling
    assert advance_process_pipeline(failing_pipeline, ProcessPipelineEvent.StageCancel, 1) == ProcessPipelineState.Failed
    cancellation_pipeline: mutable ProcessPipeline = ProcessPipeline{stages: stages}
    assert advance_process_pipeline(cancellation_pipeline, ProcessPipelineEvent.Start) == ProcessPipelineState.Running
    assert advance_process_pipeline(cancellation_pipeline, ProcessPipelineEvent.Cancel) == ProcessPipelineState.Cancelling
    assert advance_process_pipeline(cancellation_pipeline, ProcessPipelineEvent.StageCancel, 0) == ProcessPipelineState.Cancelling
    assert advance_process_pipeline(cancellation_pipeline, ProcessPipelineEvent.StageCancel, 1) == ProcessPipelineState.Cancelling
    assert advance_process_pipeline(cancellation_pipeline, ProcessPipelineEvent.CancelAck) == ProcessPipelineState.Cancelled
    planned_cancel: mutable ProcessPipeline = ProcessPipeline{stages: stages}
    assert advance_process_pipeline(planned_cancel, ProcessPipelineEvent.Cancel) == ProcessPipelineState.Cancelled
    invalid_stages: mutable darray[ProcessCommand] = []
    invalid_stages.push(ProcessCommand{executable: ""})
    invalid_pipeline: ProcessPipeline = ProcessPipeline{stages: invalid_stages}
    invalid_pipeline_rejected: mutable bool = false
    catch validate_process_pipeline(invalid_pipeline):
        ok value:
            assert not value
        error failure:
            assert failure == ProcessPipelineError.InvalidStageCommand
            invalid_pipeline_rejected <- true
    assert invalid_pipeline_rejected
    forged_pipeline_rejected: mutable bool = false
    catch validate_process_pipeline(ProcessPipeline{stages: stages, state: ProcessPipelineState.Succeeded}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessPipelineError.PipelineAccountingInvalid
            forged_pipeline_rejected <- true
    assert forged_pipeline_rejected
    forged_cancelling: mutable bool = false
    catch validate_process_pipeline(ProcessPipeline{stages: stages, state: ProcessPipelineState.Cancelling, completed_stages: 2}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessPipelineError.PipelineAccountingInvalid
            forged_cancelling <- true
    assert forged_cancelling
    forged_cancelled: mutable bool = false
    catch validate_process_pipeline(ProcessPipeline{stages: stages, state: ProcessPipelineState.Cancelled, completed_stages: 2}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessPipelineError.PipelineAccountingInvalid
            forged_cancelled <- true
    assert forged_cancelled


@test
def typed_process_session_contract_bounds_streams_polls_and_outcomes() -> void:
    command: ProcessCommand = ProcessCommand{executable: "echo"}
    session: mutable ProcessSession = ProcessSession{command: command, max_output_bytes: 128, max_polls: 4}
    assert validate_process_session(session)
    assert advance_process_session(session, ProcessSessionEvent.Spawn, 0, ProcessResultKind.Exited, 11, 12, 13) == ProcessSessionState.Running
    assert advance_process_session(session, ProcessSessionEvent.Stdout, 8) == ProcessSessionState.Collecting
    assert advance_process_session(session, ProcessSessionEvent.Stderr, 4) == ProcessSessionState.Collecting
    assert advance_process_session(session, ProcessSessionEvent.Poll) == ProcessSessionState.Collecting
    assert advance_process_session(session, ProcessSessionEvent.Exit, 0, ProcessResultKind.Exited, 0, 0, 0, 17) == ProcessSessionState.Exited
    assert session.exit_status == 17
    forged_active_outcome: mutable bool = false
    catch validate_process_session(ProcessSession{command: command, state: ProcessSessionState.Running, child_resource_id: 41, result_kind: ProcessResultKind.Exited}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessSessionError.InvalidOutcome
            forged_active_outcome <- true
    assert forged_active_outcome
    forged_timeout_status: mutable bool = false
    catch validate_process_session(ProcessSession{command: command, state: ProcessSessionState.TimedOut, result_kind: ProcessResultKind.TimedOut, child_resource_id: 1, exit_status: 17}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessSessionError.InvalidOutcome
            forged_timeout_status <- true
    assert forged_timeout_status
    mismatched_terminal: ProcessSession = ProcessSession{command: command, state: ProcessSessionState.Exited, child_resource_id: 41, stdout_resource_id: 42, stderr_resource_id: 43, result_kind: ProcessResultKind.HostIoFailure}
    mismatched_terminal_rejected: mutable bool = false
    catch validate_process_session(mismatched_terminal):
        ok value:
            assert false
        error failure:
            assert failure == ProcessSessionError.InvalidOutcome
            mismatched_terminal_rejected <- true
    assert mismatched_terminal_rejected
    negative_session_exit: mutable bool = false
    catch validate_process_session(ProcessSession{command: command, state: ProcessSessionState.Exited, child_resource_id: 41, stdout_resource_id: 42, stderr_resource_id: 43, result_kind: ProcessResultKind.Exited, exit_status: -1}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessSessionError.InvalidOutcome
            negative_session_exit <- true
    assert negative_session_exit
    forged_created: mutable ProcessSession = ProcessSession{command: command, child_resource_id: 41, stdout_bytes: 1, output_bytes: 1}
    forged_created_error: mutable bool = false
    catch validate_process_session(forged_created):
        ok value:
            assert false
        error failure:
            assert failure == ProcessSessionError.AccountingInvalid
            forged_created_error <- true
    assert forged_created_error
    forged_created_outcome: mutable bool = false
    catch validate_process_session(ProcessSession{command: command, result_kind: ProcessResultKind.Exited}):
        ok value:
            assert false
        error failure:
            assert failure == ProcessSessionError.InvalidOutcome
            forged_created_outcome <- true
    assert forged_created_outcome
    oversized: mutable ProcessSession = ProcessSession{command: command, max_output_bytes: 4}
    assert advance_process_session(oversized, ProcessSessionEvent.Spawn, 0, ProcessResultKind.Exited, 21, 22, 23) == ProcessSessionState.Running
    output_rejected: mutable bool = false
    catch advance_process_session(oversized, ProcessSessionEvent.Stdout, 5):
        ok value:
            assert false
        error failure:
            assert failure == ProcessSessionError.OutputLimitExceeded
            output_rejected <- true
    assert output_rejected
    spawn_failure: mutable ProcessSession = ProcessSession{command: command}
    assert advance_process_session(spawn_failure, ProcessSessionEvent.Spawn, 0, ProcessResultKind.Exited, 51, 52, 53) == ProcessSessionState.Running
    spawn_failure_rejected: mutable bool = false
    catch advance_process_session(spawn_failure, ProcessSessionEvent.Fail, 0, ProcessResultKind.SpawnFailure):
        ok value:
            assert false
        error failure:
            assert failure == ProcessSessionError.InvalidOutcome
            spawn_failure_rejected <- true
    assert spawn_failure_rejected
    cancellation: mutable ProcessSession = ProcessSession{command: command}
    assert advance_process_session(cancellation, ProcessSessionEvent.Spawn, 0, ProcessResultKind.Exited, 31, 32, 33) == ProcessSessionState.Running
    assert advance_process_session(cancellation, ProcessSessionEvent.Cancel) == ProcessSessionState.Cancelling
    assert advance_process_session(cancellation, ProcessSessionEvent.CancelAck) == ProcessSessionState.Cancelled


@test
def typed_task_scope_and_channel_contract_is_bounded() -> void:
    scope: mutable TaskScope = TaskScope{max_children: 2, failure_mode: TaskFailureMode.Aggregate}
    assert validate_task_scope(scope)
    assert advance_task_scope(scope, TaskScopeEvent.Start) == TaskScopeState.Running
    assert advance_task_scope(scope, TaskScopeEvent.Spawn) == TaskScopeState.Running
    assert advance_task_scope(scope, TaskScopeEvent.Spawn) == TaskScopeState.Running
    assert advance_task_scope(scope, TaskScopeEvent.ChildComplete) == TaskScopeState.Running
    assert advance_task_scope(scope, TaskScopeEvent.ChildFail) == TaskScopeState.Running
    assert advance_task_scope(scope, TaskScopeEvent.Close) == TaskScopeState.Failed
    reuse_limit: mutable TaskScope = TaskScope{max_children: 1}
    assert advance_task_scope(reuse_limit, TaskScopeEvent.Start) == TaskScopeState.Running
    assert advance_task_scope(reuse_limit, TaskScopeEvent.Spawn) == TaskScopeState.Running
    assert advance_task_scope(reuse_limit, TaskScopeEvent.ChildComplete) == TaskScopeState.Running
    reuse_rejected: mutable bool = false
    catch advance_task_scope(reuse_limit, TaskScopeEvent.Spawn):
        ok value:
            assert false
        error failure:
            assert failure == TaskContractError.ChildLimitExceeded
            reuse_rejected <- true
    assert reuse_rejected
    forged_total: mutable bool = false
    catch validate_task_scope(TaskScope{state: TaskScopeState.Running, max_children: 1, active_children: 1, completed_children: 1}):
        ok value:
            assert false
        error failure:
            assert failure == TaskContractError.ChildAccountingInvalid
            forged_total <- true
    assert forged_total
    aggregate_close: mutable TaskScope = TaskScope{max_children: 2, failure_mode: TaskFailureMode.Aggregate}
    assert advance_task_scope(aggregate_close, TaskScopeEvent.Start) == TaskScopeState.Running
    assert advance_task_scope(aggregate_close, TaskScopeEvent.Spawn) == TaskScopeState.Running
    assert advance_task_scope(aggregate_close, TaskScopeEvent.Spawn) == TaskScopeState.Running
    assert advance_task_scope(aggregate_close, TaskScopeEvent.ChildFail) == TaskScopeState.Running
    assert advance_task_scope(aggregate_close, TaskScopeEvent.Close) == TaskScopeState.Closing
    assert advance_task_scope(aggregate_close, TaskScopeEvent.ChildComplete) == TaskScopeState.Failed
    fail_fast_scope: mutable TaskScope = TaskScope{max_children: 2, failure_mode: TaskFailureMode.FailFast}
    assert advance_task_scope(fail_fast_scope, TaskScopeEvent.Start) == TaskScopeState.Running
    assert advance_task_scope(fail_fast_scope, TaskScopeEvent.Spawn) == TaskScopeState.Running
    assert advance_task_scope(fail_fast_scope, TaskScopeEvent.Spawn) == TaskScopeState.Running
    assert advance_task_scope(fail_fast_scope, TaskScopeEvent.ChildFail) == TaskScopeState.Closing
    assert advance_task_scope(fail_fast_scope, TaskScopeEvent.ChildComplete) == TaskScopeState.Failed
    assert validate_task_scope(fail_fast_scope)
    invalid_scope: mutable bool = false
    catch validate_task_scope(TaskScope{state: TaskScopeState.Succeeded, max_children: 1, active_children: 1}):
        ok value:
            assert false
        error failure:
            assert failure == TaskContractError.ChildAccountingInvalid
            invalid_scope <- true
    assert invalid_scope
    invalid_closing: mutable bool = false
    catch validate_task_scope(TaskScope{state: TaskScopeState.Closing, max_children: 1}):
        ok value:
            assert false
        error failure:
            assert failure == TaskContractError.ChildAccountingInvalid
            invalid_closing <- true
    assert invalid_closing
    invalid_failed: mutable bool = false
    catch validate_task_scope(TaskScope{state: TaskScopeState.Failed, max_children: 1}):
        ok value:
            assert false
        error failure:
            assert failure == TaskContractError.ChildAccountingInvalid
            invalid_failed <- true
    assert invalid_failed
    cancellation_scope: mutable TaskScope = TaskScope{max_children: 1}
    assert advance_task_scope(cancellation_scope, TaskScopeEvent.Start) == TaskScopeState.Running
    assert advance_task_scope(cancellation_scope, TaskScopeEvent.Cancel) == TaskScopeState.Cancelling
    assert advance_task_scope(cancellation_scope, TaskScopeEvent.CancelAck) == TaskScopeState.Cancelled
    draining_cancellation: mutable TaskScope = TaskScope{max_children: 1}
    assert advance_task_scope(draining_cancellation, TaskScopeEvent.Start) == TaskScopeState.Running
    assert advance_task_scope(draining_cancellation, TaskScopeEvent.Spawn) == TaskScopeState.Running
    assert advance_task_scope(draining_cancellation, TaskScopeEvent.Cancel) == TaskScopeState.Cancelling
    assert advance_task_scope(draining_cancellation, TaskScopeEvent.ChildComplete) == TaskScopeState.Cancelling
    assert advance_task_scope(draining_cancellation, TaskScopeEvent.CancelAck) == TaskScopeState.Cancelled
    channel: mutable TaskChannel = TaskChannel{capacity_messages: 2, capacity_bytes: 8}
    assert validate_task_channel(channel)
    assert task_channel_send(channel, 3)
    assert task_channel_send(channel, 2)
    full_rejected: mutable bool = false
    catch task_channel_send(channel, 4):
        ok value:
            assert not value
        error failure:
            assert failure == TaskContractError.ChannelBufferExceeded
            full_rejected <- true
    assert full_rejected
    partial_last_message: mutable TaskChannel = TaskChannel{capacity_messages: 2, capacity_bytes: 8}
    assert task_channel_send(partial_last_message, 4)
    partial_last_rejected: mutable bool = false
    catch task_channel_receive(partial_last_message, 3):
        ok value:
            assert false
        error failure:
            assert failure == TaskContractError.ChannelBufferExceeded
            partial_last_rejected <- true
    assert partial_last_rejected
    assert task_channel_receive(channel, 3) == 3
    assert advance_task_channel(channel, TaskChannelEvent.Close) == TaskChannelState.Closing
    assert task_channel_receive(channel, 2) == 2
    assert channel.state == TaskChannelState.Closed
    forged_channel: mutable bool = false
    catch validate_task_channel(TaskChannel{state: TaskChannelState.Closed, capacity_messages: 2, capacity_bytes: 8, buffered_messages: 1, buffered_bytes: 1}):
        ok value:
            assert false
        error failure:
            assert failure == TaskContractError.ChannelBufferExceeded
            forged_channel <- true
    assert forged_channel
    forged_empty_messages: mutable bool = false
    catch validate_task_channel(TaskChannel{capacity_messages: 2, capacity_bytes: 8, buffered_bytes: 1}):
        ok value:
            assert false
        error failure:
            assert failure == TaskContractError.ChannelBufferExceeded
            forged_empty_messages <- true
    assert forged_empty_messages
    forged_closing: mutable bool = false
    catch validate_task_channel(TaskChannel{state: TaskChannelState.Closing, capacity_messages: 2, capacity_bytes: 8}):
        ok value:
            assert false
        error failure:
            assert failure == TaskContractError.ChannelBufferExceeded
            forged_closing <- true
    assert forged_closing
    cancellation_channel: mutable TaskChannel = TaskChannel{capacity_messages: 2, capacity_bytes: 8}
    assert task_channel_send(cancellation_channel, 2)
    assert advance_task_channel(cancellation_channel, TaskChannelEvent.Cancel) == TaskChannelState.Cancelling
    cancellation_buffer_rejected: mutable bool = false
    catch advance_task_channel(cancellation_channel, TaskChannelEvent.CancelAck):
        ok value:
            assert false
        error failure:
            assert failure == TaskContractError.ChannelBufferExceeded
            cancellation_buffer_rejected <- true
    assert cancellation_buffer_rejected
    assert task_channel_receive(cancellation_channel, 2) == 2
    assert advance_task_channel(cancellation_channel, TaskChannelEvent.CancelAck) == TaskChannelState.Cancelled
    forged_cancelled: mutable bool = false
    catch validate_task_channel(TaskChannel{state: TaskChannelState.Cancelled, capacity_messages: 2, capacity_bytes: 8, buffered_messages: 1, buffered_bytes: 1}):
        ok value:
            assert false
        error failure:
            assert failure == TaskContractError.ChannelBufferExceeded
            forged_cancelled <- true
    assert forged_cancelled


@test
def typed_task_transfer_contract_preserves_move_and_borrow_ownership() -> void:
    items: darray[TaskTransferItem] = [
        TaskTransferItem{resource: TaskTransferResource{resource_id: 11, owner_task: 1, generation: 2, kind: TaskTransferValueKind.Copyable, bytes: 2}, mode: TaskTransferMode.Copy},
        TaskTransferItem{resource: TaskTransferResource{resource_id: 12, owner_task: 1, generation: 3, kind: TaskTransferValueKind.Linear, bytes: 3}, mode: TaskTransferMode.Move},
        TaskTransferItem{resource: TaskTransferResource{resource_id: 13, owner_task: 1, generation: 4, kind: TaskTransferValueKind.HandlerContext, bytes: 4}, mode: TaskTransferMode.Borrow, borrow_duration: 5}
    ]
    request: TaskTransferRequest = TaskTransferRequest{source_task: 1, target_task: 2, policy: TaskTransferPolicy{max_items: 4, max_bytes: 16, max_borrow_ticks: 8}, items: items}
    session: mutable TaskTransferSession = TaskTransferSession{request: request}
    assert validate_task_transfer(session)
    assert advance_task_transfer(session, TaskTransferEvent.Begin) == TaskTransferState.Validating
    assert advance_task_transfer(session, TaskTransferEvent.Admit, 0) == TaskTransferState.Validating
    assert advance_task_transfer(session, TaskTransferEvent.Admit, 1) == TaskTransferState.Validating
    assert advance_task_transfer(session, TaskTransferEvent.Admit, 2) == TaskTransferState.Validating
    assert advance_task_transfer(session, TaskTransferEvent.Commit) == TaskTransferState.Committed
    assert task_transfer_owner(session, 0) == 1
    assert task_transfer_owner(session, 1) == 2
    assert task_transfer_owner(session, 2) == 1
    invalid: mutable TaskTransferSession = TaskTransferSession{request: TaskTransferRequest{source_task: 1, target_task: 2, policy: TaskTransferPolicy{max_items: 2, max_bytes: 8}, items: [TaskTransferItem{resource: TaskTransferResource{resource_id: 14, owner_task: 1, kind: TaskTransferValueKind.Linear, bytes: 1}, mode: TaskTransferMode.Borrow, borrow_duration: 1}]}}
    invalid_borrow: mutable bool = false
    catch validate_task_transfer(invalid):
        ok value:
            assert false
        error failure:
            assert failure == TaskTransferError.InvalidMode
            invalid_borrow <- true
    assert invalid_borrow
    forged_accounting: TaskTransferSession = TaskTransferSession{request: request, state: TaskTransferState.Validating, item_states: [TaskTransferItemState.Admitted, TaskTransferItemState.Pending, TaskTransferItemState.Pending], admitted_items: 0, admitted_bytes: 0}
    forged_accounting_rejected: mutable bool = false
    catch validate_task_transfer(forged_accounting):
        ok value:
            assert false
        error failure:
            assert failure == TaskTransferError.ItemStateInvalid
            forged_accounting_rejected <- true
    assert forged_accounting_rejected
    forged_commit: mutable TaskTransferSession = TaskTransferSession{request: request, state: TaskTransferState.Committed}
    forged_commit_rejected: mutable bool = false
    catch validate_task_transfer(forged_commit):
        ok value:
            assert false
        error failure:
            assert failure == TaskTransferError.ItemStateInvalid
            forged_commit_rejected <- true
    assert forged_commit_rejected
    forged_committing: mutable bool = false
    catch validate_task_transfer(TaskTransferSession{request: request, state: TaskTransferState.Committing, item_states: [TaskTransferItemState.Admitted, TaskTransferItemState.Admitted, TaskTransferItemState.Admitted], admitted_items: 3, admitted_bytes: 9}):
        ok value:
            assert false
        error failure:
            assert failure == TaskTransferError.ItemStateInvalid
            forged_committing <- true
    assert forged_committing


@test
def typed_executable_discovery_contract_distinguishes_path_and_executable() -> void:
    request: ExecutableDiscoveryRequest = ExecutableDiscoveryRequest{name: "tool", path_entries: ["bin", "/usr/bin"], policy: ExecutableDiscoveryPolicy{max_path_entries: 4, max_candidates: 4}}
    session: mutable ExecutableDiscoverySession = ExecutableDiscoverySession{request: request}
    assert validate_executable_discovery(session)
    assert advance_executable_discovery(session, ExecutableDiscoveryEvent.Begin) == ExecutableDiscoveryState.Searching
    assert advance_executable_discovery(session, ExecutableDiscoveryEvent.Candidate, ExecutableCandidate{path: "bin/tool", path_index: 0, regular_file: false, executable: false}) == ExecutableDiscoveryState.Searching
    assert advance_executable_discovery(session, ExecutableDiscoveryEvent.Candidate, ExecutableCandidate{path: "/usr/bin/tool", path_index: 1, regular_file: true, executable: true}) == ExecutableDiscoveryState.Found
    assert executable_discovery_result(session).path == "/usr/bin/tool"
    missing: mutable ExecutableDiscoverySession = ExecutableDiscoverySession{request: request}
    _ = advance_executable_discovery(missing, ExecutableDiscoveryEvent.Begin)
    not_ready: mutable bool = false
    catch advance_executable_discovery(missing, ExecutableDiscoveryEvent.Missing):
        ok value:
            assert false
        error failure:
            assert failure == ExecutableDiscoveryError.MissingNotReady
            not_ready <- true
    assert not_ready
    forged_found: mutable ExecutableDiscoverySession = ExecutableDiscoverySession{request: request, state: ExecutableDiscoveryState.Found, examined_candidates: 1, selected: Executable{path: "bin/tool", path_index: 1}}
    forged_found_error: mutable bool = false
    catch validate_executable_discovery(forged_found):
        ok value:
            assert false
        error failure:
            assert failure == ExecutableDiscoveryError.CandidateInvalid
            forged_found_error <- true
    assert forged_found_error
    empty_path: mutable ExecutableDiscoverySession = ExecutableDiscoverySession{request: ExecutableDiscoveryRequest{name: "tool", policy: ExecutableDiscoveryPolicy{max_path_entries: 1, max_candidates: 1}}, state: ExecutableDiscoveryState.Searching}
    empty_candidate_error: mutable bool = false
    catch advance_executable_discovery(empty_path, ExecutableDiscoveryEvent.Candidate, ExecutableCandidate{path: "tool", path_index: 0}):
        ok value:
            assert false
        error failure:
            assert failure == ExecutableDiscoveryError.CandidateOrderInvalid
            empty_candidate_error <- true
    assert empty_candidate_error


@test
def typed_module_graph_contract_is_private_by_default_and_cycle_safe() -> void:
    imports: mutable darray[ModuleImport] = []
    imports.push(ModuleImport{module_name: "shared.types", alias: "types", visibility: ModuleVisibility.Public})
    descriptor: mutable ModuleDescriptor = ModuleDescriptor{module_name: "app.main", source_path: "src/app/main.elisascript", imports: imports, public_symbols: ["main", "run"], private_symbols: ["parse"]}
    assert validate_module_descriptor(descriptor)
    assert advance_module_resolution(descriptor, ModuleResolutionEvent.Begin) == ModuleResolutionState.Resolving
    assert advance_module_resolution(descriptor, ModuleResolutionEvent.ImportResolved, 0) == ModuleResolutionState.Resolving
    assert advance_module_resolution(descriptor, ModuleResolutionEvent.Complete) == ModuleResolutionState.Resolved
    incomplete_resolved: mutable bool = false
    catch validate_module_descriptor(ModuleDescriptor{module_name: "app.incomplete", source_path: "src/app/incomplete.elisascript", imports: [ModuleImport{module_name: "dep.types"}], state: ModuleResolutionState.Resolved}):
        ok value:
            assert false
        error failure:
            assert failure == ModuleContractError.ResolutionNotReady
            incomplete_resolved <- true
    assert incomplete_resolved
    stack: mutable ModuleResolutionStack = ModuleResolutionStack{}
    assert module_resolution_stack_push(stack, "app.main")
    assert module_resolution_stack_push(stack, "shared.types")
    cycle_rejected: mutable bool = false
    catch module_resolution_stack_push(stack, "app.main"):
        ok value:
            assert not value
        error failure:
            assert failure == ModuleContractError.ResolutionCycle
            cycle_rejected <- true
    assert cycle_rejected
    assert module_resolution_stack_pop(stack) == "shared.types"
    assert module_resolution_stack_pop(stack) == "app.main"
    collision: ModuleDescriptor = ModuleDescriptor{module_name: "bad", source_path: "bad.elisascript", public_symbols: ["same"], private_symbols: ["same"]}
    collision_rejected: mutable bool = false
    catch validate_module_descriptor(collision):
        ok value:
            assert not value
        error failure:
            assert failure == ModuleContractError.PublicPrivateCollision
            collision_rejected <- true
    assert collision_rejected
    shared: ModuleDescriptor = ModuleDescriptor{module_name: "shared.types", source_path: "src/shared/types.elisascript", public_symbols: ["Type"]}
    graph: ModuleGraph = ModuleGraph{modules: [shared, descriptor]}
    assert validate_module_graph(graph)
    cycle_a: ModuleDescriptor = ModuleDescriptor{module_name: "cycle.a", source_path: "src/cycle/a.elisascript", imports: [ModuleImport{module_name: "cycle.b"}]}
    cycle_b: ModuleDescriptor = ModuleDescriptor{module_name: "cycle.b", source_path: "src/cycle/b.elisascript", imports: [ModuleImport{module_name: "cycle.a"}]}
    graph_cycle_rejected: mutable bool = false
    catch validate_module_graph(ModuleGraph{modules: [cycle_a, cycle_b]}):
        ok value:
            assert false
        error failure:
            assert failure == ModuleContractError.ResolutionCycle
            graph_cycle_rejected <- true
    assert graph_cycle_rejected
    missing_target: mutable bool = false
    catch validate_module_graph(ModuleGraph{modules: [ModuleDescriptor{module_name: "app.only", source_path: "src/app/only.elisascript", imports: [ModuleImport{module_name: "missing"}]}]}):
        ok value:
            assert false
        error failure:
            assert failure == ModuleContractError.ModuleNotFound
            missing_target <- true
    assert missing_target


@test
def typed_cli_contract_separates_launcher_options_from_script_arguments() -> void:
    arguments: darray[sview] = ["--check", "--color", "never", "--strict-engine", "tool.elisascript", "--", "--input", "value"]
    invocation: CliInvocation = parse_cli_arguments(arguments)
    assert invocation.mode == CliMode.Check
    assert invocation.color == CliColorMode.Never
    assert invocation.strict_engine
    assert invocation.source_path == "tool.elisascript"
    assert invocation.option_end_seen
    assert invocation.script_arguments.count == 2
    assert invocation.script_arguments[0] == "--input"
    boundary_source: CliInvocation = parse_cli_arguments(["--", "boundary.elisascript", "--input"])
    assert boundary_source.option_end_seen
    assert boundary_source.source_path == "boundary.elisascript"
    assert boundary_source.script_arguments.count == 1
    assert boundary_source.script_arguments[0] == "--input"
    duplicate_mode: darray[sview] = ["--run", "--test", "tool.elisascript"]
    duplicate_rejected: mutable bool = false
    catch parse_cli_arguments(duplicate_mode):
        ok value:
            assert false
        error failure:
            assert failure == CliContractError.DuplicateMode
            duplicate_rejected <- true
    assert duplicate_rejected
    unknown: darray[sview] = ["--unknown", "tool.elisascript"]
    unknown_rejected: mutable bool = false
    catch parse_cli_arguments(unknown):
        ok value:
            assert false
        error failure:
            assert failure == CliContractError.UnknownOption
            unknown_rejected <- true
    assert unknown_rejected
    help: darray[sview] = ["--help"]
    help_invocation: CliInvocation = parse_cli_arguments(help)
    assert help_invocation.mode == CliMode.Help
    help_extra: mutable bool = false
    catch parse_cli_arguments(["--help", "tool.elisascript"]):
        ok value:
            assert false
        error failure:
            assert failure == CliContractError.UnexpectedArgument
            help_extra <- true
    assert help_extra
    duplicate_color: mutable bool = false
    catch parse_cli_arguments(["--color", "auto", "--color", "never", "tool.elisascript"]):
        ok value:
            assert false
        error failure:
            assert failure == CliContractError.DuplicateOption
            duplicate_color <- true
    assert duplicate_color


@test
def typed_cli_workflow_contract_maps_modes_to_ordered_steps() -> void:
    check_arguments: darray[sview] = ["--check", "sample.elisascript"]
    check_invocation: CliInvocation = parse_cli_arguments(check_arguments)
    check_workflow: mutable CliWorkflow = plan_cli_workflow(check_invocation)
    assert validate_cli_workflow(check_workflow)
    assert advance_cli_workflow(check_workflow, CliWorkflowEvent.Begin) == CliWorkflowState.Running
    assert advance_cli_workflow(check_workflow, CliWorkflowEvent.StepComplete, CliWorkflowStep.LoadSource) == CliWorkflowState.Running
    assert advance_cli_workflow(check_workflow, CliWorkflowEvent.StepComplete, CliWorkflowStep.Lower) == CliWorkflowState.Running
    assert advance_cli_workflow(check_workflow, CliWorkflowEvent.StepComplete, CliWorkflowStep.Verify) == CliWorkflowState.Running
    assert advance_cli_workflow(check_workflow, CliWorkflowEvent.StepComplete, CliWorkflowStep.Render) == CliWorkflowState.Complete
    fmt_arguments: darray[sview] = ["--fmt", "sample.elisascript"]
    fmt_workflow: CliWorkflow = plan_cli_workflow(parse_cli_arguments(fmt_arguments))
    assert fmt_workflow.steps.count == 3
    assert fmt_workflow.steps[1] == CliWorkflowStep.Format
    cancellation_arguments: darray[sview] = ["--doc", "sample.elisascript"]
    cancellation: mutable CliWorkflow = plan_cli_workflow(parse_cli_arguments(cancellation_arguments))
    assert advance_cli_workflow(cancellation, CliWorkflowEvent.Begin) == CliWorkflowState.Running
    assert advance_cli_workflow(cancellation, CliWorkflowEvent.Cancel) == CliWorkflowState.Cancelling
    assert advance_cli_workflow(cancellation, CliWorkflowEvent.CancelAck) == CliWorkflowState.Cancelled
    assert validate_cli_workflow(cancellation)
    failed_workflow: mutable CliWorkflow = plan_cli_workflow(parse_cli_arguments(check_arguments))
    assert advance_cli_workflow(failed_workflow, CliWorkflowEvent.Begin) == CliWorkflowState.Running
    assert advance_cli_workflow(failed_workflow, CliWorkflowEvent.StepComplete, CliWorkflowStep.LoadSource) == CliWorkflowState.Running
    assert advance_cli_workflow(failed_workflow, CliWorkflowEvent.Fail) == CliWorkflowState.Failed
    assert validate_cli_workflow(failed_workflow)
    forged_complete: mutable bool = false
    catch validate_cli_workflow(CliWorkflow{invocation: check_invocation, steps: [CliWorkflowStep.LoadSource, CliWorkflowStep.Lower, CliWorkflowStep.Verify, CliWorkflowStep.Render], state: CliWorkflowState.Complete, next_step: 0}):
        ok value:
            assert false
        error failure:
            assert failure == CliWorkflowError.StepOrderInvalid
            forged_complete <- true
    assert forged_complete
    forged_cancelled_cursor: mutable bool = false
    catch validate_cli_workflow(CliWorkflow{invocation: check_invocation, steps: [CliWorkflowStep.LoadSource, CliWorkflowStep.Lower, CliWorkflowStep.Verify, CliWorkflowStep.Render], state: CliWorkflowState.Cancelled, next_step: 4}):
        ok value:
            assert false
        error failure:
            assert failure == CliWorkflowError.StepOrderInvalid
            forged_cancelled_cursor <- true
    assert forged_cancelled_cursor
    forged_cancelling_cursor: mutable bool = false
    catch validate_cli_workflow(CliWorkflow{invocation: check_invocation, steps: [CliWorkflowStep.LoadSource, CliWorkflowStep.Lower, CliWorkflowStep.Verify, CliWorkflowStep.Render], state: CliWorkflowState.Cancelling, next_step: 4}):
        ok value:
            assert false
        error failure:
            assert failure == CliWorkflowError.StepOrderInvalid
            forged_cancelling_cursor <- true
    assert forged_cancelling_cursor


@test
def typed_package_manifest_and_lock_contract_is_reproducible_and_offline_safe() -> void:
    assert package_version_is_valid(PackageVersion{major: 1, minor: 0, patch: 0, pre_release: "beta"})
    assert not package_version_is_valid(PackageVersion{major: 1, minor: 0, patch: 0, pre_release: "bad\0"})
    dependency_constraint: PackageConstraint = PackageConstraint{raw: "^1.2", has_min: true, min_version: PackageVersion{major: 1, minor: 2, patch: 0}}
    manifest: PackageManifest = PackageManifest{name: "app", version: PackageVersion{major: 1, minor: 0, patch: 0}, root_path: "workspace/app", dependencies: [PackageDependency{name: "lib", constraint: dependency_constraint}]}
    lock: mutable PackageLock = PackageLock{root_name: "app", root_version: PackageVersion{major: 1, minor: 0, patch: 0}, entries: [PackageLockEntry{order: 0, name: "lib", version: PackageVersion{major: 1, minor: 4, patch: 2}, locator: "registry/lib", integrity_0: 1, integrity_1: 2, integrity_2: 3, integrity_3: 4}]}
    assert validate_package_resolution(manifest, lock)
    offline_manifest: mutable PackageManifest = manifest
    offline_manifest.offline_only <- true
    offline_mismatch: mutable bool = false
    catch validate_package_resolution(offline_manifest, lock):
        ok value:
            assert false
        error failure:
            assert failure == PackageContractError.OfflinePolicyMismatch
            offline_mismatch <- true
    assert offline_mismatch
    assert advance_package_resolution(lock, PackageResolutionEvent.Lock) == PackageResolutionState.Locked
    assert advance_package_resolution(lock, PackageResolutionEvent.Verify) == PackageResolutionState.Verified
    missing: mutable PackageManifest = manifest
    missing.dependencies <- [PackageDependency{name: "missing", constraint: dependency_constraint}]
    missing_rejected: mutable bool = false
    catch validate_package_resolution(missing, lock):
        ok value:
            assert false
        error failure:
            assert failure == PackageContractError.MissingLockedDependency
            missing_rejected <- true
    assert missing_rejected
    bad_order: mutable PackageLock = lock
    bad_order.entries[0].order <- 1
    order_rejected: mutable bool = false
    catch validate_package_lock(bad_order):
        ok value:
            assert false
        error failure:
            assert failure == PackageContractError.LockOrderInvalid
            order_rejected <- true
    assert order_rejected
    empty_interval: mutable PackageManifest = manifest
    empty_interval.dependencies <- [PackageDependency{name: "lib", constraint: PackageConstraint{raw: "1.2", has_min: true, min_version: PackageVersion{major: 1, minor: 2, patch: 0}, include_min: false, has_max: true, max_version: PackageVersion{major: 1, minor: 2, patch: 0}, include_max: true}}]
    interval_rejected: mutable bool = false
    catch validate_package_manifest(empty_interval):
        ok value:
            assert false
        error failure:
            assert failure == PackageContractError.ConstraintInvalid
            interval_rejected <- true
    assert interval_rejected


@test
def typed_package_registry_contract_is_ordered_verified_and_constraint_aware() -> void:
    prerelease: PackageCandidate = PackageCandidate{name: "lib", version: PackageVersion{major: 1, minor: 0, patch: 0, pre_release: "alpha"}, locator: "registry/lib-1.0-alpha", integrity_0: 13, integrity_1: 14, integrity_2: 15, integrity_3: 16}
    stable: PackageCandidate = PackageCandidate{name: "lib", version: PackageVersion{major: 1, minor: 0, patch: 0}, locator: "registry/lib-1.0", integrity_0: 17, integrity_1: 18, integrity_2: 19, integrity_3: 20}
    release_order: mutable PackageRegistry = PackageRegistry{}
    assert advance_package_registry(release_order, PackageRegistryEvent.Begin) == PackageRegistryState.Loading
    assert advance_package_registry(release_order, PackageRegistryEvent.Add, prerelease) == PackageRegistryState.Loading
    assert advance_package_registry(release_order, PackageRegistryEvent.Add, stable) == PackageRegistryState.Loading
    assert advance_package_registry(release_order, PackageRegistryEvent.Seal) == PackageRegistryState.Ready
    reverse_release_order: mutable PackageRegistry = PackageRegistry{}
    assert advance_package_registry(reverse_release_order, PackageRegistryEvent.Begin) == PackageRegistryState.Loading
    assert advance_package_registry(reverse_release_order, PackageRegistryEvent.Add, stable) == PackageRegistryState.Loading
    reverse_order_rejected: mutable bool = false
    catch advance_package_registry(reverse_release_order, PackageRegistryEvent.Add, prerelease):
        ok value:
            assert false
        error failure:
            assert failure == PackageRegistryError.OrderInvalid
            reverse_order_rejected <- true
    assert reverse_order_rejected
    numeric_prerelease_low: PackageCandidate = PackageCandidate{name: "num", version: PackageVersion{major: 1, minor: 0, patch: 0, pre_release: "2"}, locator: "registry/num-2", integrity_0: 21, integrity_1: 22, integrity_2: 23, integrity_3: 24}
    numeric_prerelease_high: PackageCandidate = PackageCandidate{name: "num", version: PackageVersion{major: 1, minor: 0, patch: 0, pre_release: "10"}, locator: "registry/num-10", integrity_0: 25, integrity_1: 26, integrity_2: 27, integrity_3: 28}
    numeric_order: mutable PackageRegistry = PackageRegistry{}
    assert advance_package_registry(numeric_order, PackageRegistryEvent.Begin) == PackageRegistryState.Loading
    assert advance_package_registry(numeric_order, PackageRegistryEvent.Add, numeric_prerelease_low) == PackageRegistryState.Loading
    assert advance_package_registry(numeric_order, PackageRegistryEvent.Add, numeric_prerelease_high) == PackageRegistryState.Loading
    numeric_reverse: mutable PackageRegistry = PackageRegistry{}
    assert advance_package_registry(numeric_reverse, PackageRegistryEvent.Begin) == PackageRegistryState.Loading
    assert advance_package_registry(numeric_reverse, PackageRegistryEvent.Add, numeric_prerelease_high) == PackageRegistryState.Loading
    numeric_reverse_rejected: mutable bool = false
    catch advance_package_registry(numeric_reverse, PackageRegistryEvent.Add, numeric_prerelease_low):
        ok value:
            assert false
        error failure:
            assert failure == PackageRegistryError.OrderInvalid
            numeric_reverse_rejected <- true
    assert numeric_reverse_rejected

    first: PackageCandidate = PackageCandidate{name: "lib", version: PackageVersion{major: 1, minor: 0, patch: 0}, locator: "registry/lib-1.0", integrity_0: 1, integrity_1: 2, integrity_2: 3, integrity_3: 4}
    second: PackageCandidate = PackageCandidate{name: "lib", version: PackageVersion{major: 1, minor: 4, patch: 2}, locator: "registry/lib-1.4", integrity_0: 5, integrity_1: 6, integrity_2: 7, integrity_3: 8}
    third: PackageCandidate = PackageCandidate{name: "tool", version: PackageVersion{major: 2, minor: 0, patch: 0}, locator: "registry/tool-2", integrity_0: 9, integrity_1: 10, integrity_2: 11, integrity_3: 12}
    registry: mutable PackageRegistry = PackageRegistry{}
    assert advance_package_registry(registry, PackageRegistryEvent.Begin) == PackageRegistryState.Loading
    assert advance_package_registry(registry, PackageRegistryEvent.Add, first) == PackageRegistryState.Loading
    assert advance_package_registry(registry, PackageRegistryEvent.Add, second) == PackageRegistryState.Loading
    assert advance_package_registry(registry, PackageRegistryEvent.Add, third) == PackageRegistryState.Loading
    assert advance_package_registry(registry, PackageRegistryEvent.Seal) == PackageRegistryState.Ready
    constraint: PackageConstraint = PackageConstraint{raw: "^1.2", has_min: true, min_version: PackageVersion{major: 1, minor: 2, patch: 0}}
    assert package_registry_find(registry, "lib", constraint) == 1
    bad_order: mutable PackageRegistry = PackageRegistry{}
    assert advance_package_registry(bad_order, PackageRegistryEvent.Begin) == PackageRegistryState.Loading
    assert advance_package_registry(bad_order, PackageRegistryEvent.Add, second) == PackageRegistryState.Loading
    order_rejected: mutable bool = false
    catch advance_package_registry(bad_order, PackageRegistryEvent.Add, first):
        ok value:
            assert false
        error failure:
            assert failure == PackageRegistryError.OrderInvalid
            order_rejected <- true
    assert order_rejected
    cancelled: mutable PackageRegistry = PackageRegistry{}
    assert advance_package_registry(cancelled, PackageRegistryEvent.Begin) == PackageRegistryState.Loading
    assert advance_package_registry(cancelled, PackageRegistryEvent.Cancel) == PackageRegistryState.Cancelled
    terminal_failure: mutable bool = false
    catch advance_package_registry(cancelled, PackageRegistryEvent.Fail):
        ok value:
            assert false
        error failure:
            assert failure == PackageRegistryError.InvalidState
            terminal_failure <- true
    assert terminal_failure
    forged_empty: mutable bool = false
    catch validate_package_registry(PackageRegistry{state: PackageRegistryState.Empty, entries: [first]}):
        ok value:
            assert false
        error failure:
            assert failure == PackageRegistryError.InvalidState
            forged_empty <- true
    assert forged_empty


@test
def typed_package_cache_contract_requires_exact_identity_and_explicit_invalidation() -> void:
    entry: PackageCacheEntry = PackageCacheEntry{name: "lib", version: PackageVersion{major: 1, minor: 4, patch: 2}, locator: "registry/lib-1.4", byte_count: 128, fingerprint: 99, integrity_0: 1, integrity_1: 2, integrity_2: 3, integrity_3: 4}
    cache: mutable PackageCache = PackageCache{}
    assert advance_package_cache(cache, PackageCacheEvent.Begin) == PackageCacheState.Updating
    assert advance_package_cache(cache, PackageCacheEvent.Store, entry) == PackageCacheState.Updating
    assert advance_package_cache(cache, PackageCacheEvent.Seal) == PackageCacheState.Ready
    assert package_cache_lookup(cache, "lib", entry.version, entry.locator, 99) == 0
    stale: mutable bool = false
    catch package_cache_lookup(cache, "lib", entry.version, entry.locator, 100):
        ok value:
            assert false
        error failure:
            assert failure == PackageCacheError.CacheMiss
            stale <- true
    assert stale
    assert advance_package_cache(cache, PackageCacheEvent.Invalidate, entry, 0) == PackageCacheState.Updating
    assert advance_package_cache(cache, PackageCacheEvent.Seal) == PackageCacheState.Ready
    invalidated: mutable bool = false
    catch package_cache_lookup(cache, "lib", entry.version, entry.locator, 99):
        ok value:
            assert false
        error failure:
            assert failure == PackageCacheError.CacheMiss
            invalidated <- true
    assert invalidated
    alternate: PackageCacheEntry = PackageCacheEntry{name: "lib", version: entry.version, locator: "workspace/lib-1.4", byte_count: 64, fingerprint: 99, integrity_0: 5, integrity_1: 6, integrity_2: 7, integrity_3: 8}
    alternate_cache: mutable PackageCache = PackageCache{}
    assert advance_package_cache(alternate_cache, PackageCacheEvent.Begin) == PackageCacheState.Updating
    assert advance_package_cache(alternate_cache, PackageCacheEvent.Store, entry) == PackageCacheState.Updating
    assert advance_package_cache(alternate_cache, PackageCacheEvent.Store, alternate) == PackageCacheState.Updating
    assert advance_package_cache(alternate_cache, PackageCacheEvent.Seal) == PackageCacheState.Ready
    assert package_cache_lookup(alternate_cache, "lib", entry.version, entry.locator, 99) == 0
    assert package_cache_lookup(alternate_cache, "lib", alternate.version, alternate.locator, 99) == 1
    wrong_locator: mutable bool = false
    catch package_cache_lookup(alternate_cache, "lib", entry.version, "registry/missing", 99):
        ok value:
            assert false
        error failure:
            assert failure == PackageCacheError.CacheMiss
            wrong_locator <- true
    assert wrong_locator
    terminal_failure: mutable bool = false
    catch advance_package_cache(cache, PackageCacheEvent.Fail):
        ok value:
            assert false
        error failure:
            assert failure == PackageCacheError.InvalidState
            terminal_failure <- true
    assert terminal_failure
    forged_empty: mutable bool = false
    catch validate_package_cache(PackageCache{state: PackageCacheState.Empty, entries: [entry], bytes: 128}):
        ok value:
            assert false
        error failure:
            assert failure == PackageCacheError.InvalidState
            forged_empty <- true
    assert forged_empty


@test
def typed_data_decoder_contract_bounds_json_and_csv_streams() -> void:
    limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 1024, tokens: 128, depth: 8, records: 16, fields: 32, field_bytes: 256}
    decoder: mutable DataDecoder = DataDecoder{format: DataFormat.JsonLines, limits: limits}
    assert advance_data_decoder(decoder, DataDecoderEvent.Begin) == DataDecoderState.Decoding
    assert advance_data_decoder(decoder, DataDecoderEvent.Token, 12, 2, 1, 10) == DataDecoderState.Decoding
    assert advance_data_decoder(decoder, DataDecoderEvent.Record, 3, 2, 0, 1) == DataDecoderState.Decoding
    assert decoder.input_bytes == 15
    assert decoder.offset == 15
    assert decoder.fields == 4
    assert decoder.field_bytes == 11
    assert advance_data_decoder(decoder, DataDecoderEvent.End) == DataDecoderState.Complete
    csv: CsvPolicy = CsvPolicy{separator: 44, quote: 34, escape: 92, record_separator: 10}
    assert csv.line_ending == CsvLineEndingMode.ConfiguredByte
    assert validate_csv_policy(csv)
    invalid_csv: CsvPolicy = CsvPolicy{separator: 10, quote: 34, escape: 34, record_separator: 10}
    csv_rejected: mutable bool = false
    catch validate_csv_policy(invalid_csv):
        ok value:
            assert false
        error failure:
            assert failure == DataContractError.InvalidCsvPolicy
            csv_rejected <- true
    assert csv_rejected
    explicit_line_ending: CsvPolicy = CsvPolicy{line_ending: CsvLineEndingMode.Lf, record_separator: 0}
    assert validate_csv_policy(explicit_line_ending)
    zero_configured_separator: mutable bool = false
    catch validate_csv_policy(CsvPolicy{record_separator: 0}):
        ok value:
            assert false
        error failure:
            assert failure == DataContractError.InvalidCsvPolicy
            zero_configured_separator <- true
    assert zero_configured_separator
    ambiguous_csv: mutable bool = false
    catch validate_csv_policy(CsvPolicy{separator: 34, quote: 34, escape: 34, record_separator: 10}):
        ok value:
            assert false
        error failure:
            assert failure == DataContractError.InvalidCsvPolicy
            ambiguous_csv <- true
    assert ambiguous_csv
    limited_limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 32, tokens: 32, depth: 4, records: 1, fields: 8, field_bytes: 16}
    limited: mutable CsvStream = CsvStream{policy: csv, limits: limited_limits, state: CsvStreamState.Unquoted, records: 1, fields_total: 1}
    record_limit: mutable bool = false
    catch advance_csv_stream(limited, CsvStreamEvent.Byte, 10):
        ok value:
            assert false
        error failure:
            assert failure == CsvContractError.RecordLimitExceeded
            record_limit <- true
    assert record_limit
    assert limited.fields_total == 1
    overflow: mutable DataDecoder = DataDecoder{format: DataFormat.Json, limits: limits}
    _ = advance_data_decoder(overflow, DataDecoderEvent.Begin)
    over_limit: mutable bool = false
    catch advance_data_decoder(overflow, DataDecoderEvent.Token, 1025, 0, 1):
        ok value:
            assert false
        error failure:
            assert failure == DataContractError.InputLimitExceeded
            over_limit <- true
    assert over_limit
    malformed_offset: DataDecoder = DataDecoder{format: DataFormat.Json, limits: limits, input_bytes: 1, offset: 2}
    offset_rejected: mutable bool = false
    catch validate_data_decoder(malformed_offset):
        ok value:
            assert false
        error failure:
            assert failure == DataContractError.OffsetAccountingInvalid
            offset_rejected <- true
    assert offset_rejected
    forged_ready: mutable bool = false
    catch validate_data_decoder(DataDecoder{format: DataFormat.Json, limits: limits, state: DataDecoderState.Ready, input_bytes: 1, offset: 1}):
        ok value:
            assert false
        error failure:
            assert failure == DataContractError.InvalidDecoderState
            forged_ready <- true
    assert forged_ready
    forged_complete: mutable bool = false
    catch validate_data_decoder(DataDecoder{format: DataFormat.Json, limits: limits, state: DataDecoderState.Complete, depth: 1}):
        ok value:
            assert false
        error failure:
            assert failure == DataContractError.InvalidDecoderState
            forged_complete <- true
    assert forged_complete
    field_bytes_rejected: mutable bool = false
    catch validate_data_decoder(DataDecoder{format: DataFormat.Csv, limits: DataDecodeLimits{field_bytes: 2}, input_bytes: 3, offset: 3, field_bytes: 3}):
        ok value:
            assert false
        error failure:
            assert failure == DataContractError.FieldBytesLimitExceeded
            field_bytes_rejected <- true
    assert field_bytes_rejected
    record_depth_rejected: mutable bool = false
    record_depth: mutable DataDecoder = DataDecoder{format: DataFormat.JsonLines, limits: limits, state: DataDecoderState.Decoding}
    catch advance_data_decoder(record_depth, DataDecoderEvent.Record, 0, 0, 9):
        ok value:
            assert false
        error failure:
            assert failure == DataContractError.DepthLimitExceeded
            record_depth_rejected <- true
    assert record_depth_rejected
    assert record_depth.records == 0
    record_overflow: mutable DataDecoder = DataDecoder{format: DataFormat.JsonLines, limits: DataDecodeLimits{input_bytes: 4, records: 4, fields: 3, field_bytes: 4}, state: DataDecoderState.Decoding, input_bytes: 4, offset: 4, fields: 3, field_bytes: 4}
    record_overflow_rejected: mutable bool = false
    catch advance_data_decoder(record_overflow, DataDecoderEvent.Record, 1, 1, 0, 0):
        ok value:
            assert false
        error failure:
            assert failure == DataContractError.InputLimitExceeded
            record_overflow_rejected <- true
    assert record_overflow_rejected
    assert record_overflow.records == 0


@test
def typed_json_stream_contract_frames_records_and_depth() -> void:
    policy: JsonStreamPolicy = JsonStreamPolicy{max_input_bytes: 32, max_record_bytes: 8, max_records: 4, max_depth: 4}
    stream: mutable JsonStreamSession = JsonStreamSession{policy: policy}
    assert validate_json_stream(stream)
    assert advance_json_stream(stream, JsonStreamEvent.Begin) == JsonStreamState.Reading
    assert advance_json_stream(stream, JsonStreamEvent.Byte, 123u8) == JsonStreamState.Reading
    assert advance_json_stream(stream, JsonStreamEvent.Byte, 125u8) == JsonStreamState.Reading
    assert advance_json_stream(stream, JsonStreamEvent.Byte, 10u8) == JsonStreamState.Reading
    assert stream.records == 1
    assert advance_json_stream(stream, JsonStreamEvent.Byte, 91u8) == JsonStreamState.Reading
    assert advance_json_stream(stream, JsonStreamEvent.Byte, 93u8) == JsonStreamState.Reading
    assert advance_json_stream(stream, JsonStreamEvent.End) == JsonStreamState.Complete
    assert stream.records == 2
    unterminated: mutable JsonStreamSession = JsonStreamSession{policy: policy}
    _ = advance_json_stream(unterminated, JsonStreamEvent.Begin)
    _ = advance_json_stream(unterminated, JsonStreamEvent.Byte, 123u8)
    incomplete: mutable bool = false
    catch advance_json_stream(unterminated, JsonStreamEvent.End):
        ok value:
            assert false
        error failure:
            assert failure == JsonStreamError.UnterminatedValue
            incomplete <- true
    assert incomplete
    mismatched: mutable JsonStreamSession = JsonStreamSession{policy: policy}
    _ = advance_json_stream(mismatched, JsonStreamEvent.Begin)
    _ = advance_json_stream(mismatched, JsonStreamEvent.Byte, 123u8)
    mismatched_rejected: mutable bool = false
    catch advance_json_stream(mismatched, JsonStreamEvent.Byte, 93u8):
        ok value:
            assert false
        error failure:
            assert failure == JsonStreamError.MismatchedDelimiter
            mismatched_rejected <- true
    assert mismatched_rejected
    oversized: mutable JsonStreamSession = JsonStreamSession{policy: JsonStreamPolicy{max_input_bytes: 8, max_record_bytes: 2, max_records: 2, max_depth: 2}}
    _ = advance_json_stream(oversized, JsonStreamEvent.Begin)
    _ = advance_json_stream(oversized, JsonStreamEvent.Byte, 123u8)
    _ = advance_json_stream(oversized, JsonStreamEvent.Byte, 125u8)
    _ = advance_json_stream(oversized, JsonStreamEvent.Byte, 65u8)
    record_limit: mutable bool = false
    catch advance_json_stream(oversized, JsonStreamEvent.Byte, 10u8):
        ok value:
            assert false
        error failure:
            assert failure == JsonStreamError.RecordBytesLimitExceeded
            record_limit <- true
    assert record_limit
    assert oversized.input_bytes == 2
    assert oversized.record_bytes == 2
    exact_boundary: mutable JsonStreamSession = JsonStreamSession{policy: JsonStreamPolicy{max_input_bytes: 8, max_record_bytes: 2, max_records: 2, max_depth: 2}}
    _ = advance_json_stream(exact_boundary, JsonStreamEvent.Begin)
    _ = advance_json_stream(exact_boundary, JsonStreamEvent.Byte, 65u8)
    _ = advance_json_stream(exact_boundary, JsonStreamEvent.Byte, 66u8)
    assert advance_json_stream(exact_boundary, JsonStreamEvent.Byte, 10u8) == JsonStreamState.Reading
    assert exact_boundary.records == 1
    assert advance_json_stream(exact_boundary, JsonStreamEvent.End) == JsonStreamState.Complete
    physical_line_stream: mutable JsonStreamSession = JsonStreamSession{policy: JsonStreamPolicy{max_input_bytes: 8, max_record_bytes: 4, max_records: 2, max_depth: 2, record_boundary: JsonLineBoundaryMode.PhysicalLines}}
    _ = advance_json_stream(physical_line_stream, JsonStreamEvent.Begin)
    _ = advance_json_stream(physical_line_stream, JsonStreamEvent.Byte, 123u8)
    physical_container_newline_rejected: mutable bool = false
    catch advance_json_stream(physical_line_stream, JsonStreamEvent.Byte, 10u8):
        ok value:
            assert false
        error failure:
            assert failure == JsonStreamError.UnterminatedValue
            physical_container_newline_rejected <- true
    assert physical_container_newline_rejected
    assert physical_line_stream.input_bytes == 1 and physical_line_stream.record_bytes == 1 and physical_line_stream.records == 0
    physical_string_stream: mutable JsonStreamSession = JsonStreamSession{policy: JsonStreamPolicy{max_input_bytes: 8, max_record_bytes: 4, max_records: 2, max_depth: 2, record_boundary: JsonLineBoundaryMode.PhysicalLines}}
    _ = advance_json_stream(physical_string_stream, JsonStreamEvent.Begin)
    _ = advance_json_stream(physical_string_stream, JsonStreamEvent.Byte, 34u8)
    _ = advance_json_stream(physical_string_stream, JsonStreamEvent.Byte, 97u8)
    physical_string_newline_rejected: mutable bool = false
    catch advance_json_stream(physical_string_stream, JsonStreamEvent.Byte, 10u8):
        ok value:
            assert false
        error failure:
            assert failure == JsonStreamError.UnterminatedString
            physical_string_newline_rejected <- true
    assert physical_string_newline_rejected
    assert physical_string_stream.input_bytes == 2 and physical_string_stream.record_bytes == 2 and physical_string_stream.records == 0
    forged_complete: mutable bool = false
    catch validate_json_stream(JsonStreamSession{policy: policy, state: JsonStreamState.Complete, input_bytes: 1, container_stack: [123u8], depth: 1}):
        ok value:
            assert false
        error failure:
            assert failure == JsonStreamError.InvalidState
            forged_complete <- true
    assert forged_complete
    forged_record_count: mutable bool = false
    catch validate_json_stream(JsonStreamSession{policy: policy, state: JsonStreamState.Complete, records: 1}):
        ok value:
            assert false
        error failure:
            assert failure == JsonStreamError.AccountingInvalid
            forged_record_count <- true
    assert forged_record_count
    empty_policy: JsonStreamPolicy = JsonStreamPolicy{max_input_bytes: 8, max_record_bytes: 4, max_records: 2, max_depth: 2, allow_empty_records: true}
    empty_records: mutable JsonStreamSession = JsonStreamSession{policy: empty_policy}
    _ = advance_json_stream(empty_records, JsonStreamEvent.Begin)
    assert advance_json_stream(empty_records, JsonStreamEvent.RecordEnd) == JsonStreamState.Reading
    assert validate_json_stream(empty_records)
    assert advance_json_stream(empty_records, JsonStreamEvent.End) == JsonStreamState.Complete


@test
def typed_json_lines_reader_returns_bounded_documents_one_record_at_a_time() -> void:
    limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 64, tokens: 32, depth: 8, records: 8, fields: 16, field_bytes: 32}
    reader: mutable JsonLinesReader = begin_json_lines_reader("null\r\ntrue\n[1]", limits)
    first: JsonLinesReadResult = next_json_lines_document(reader)
    assert first.has_document and first.record_number == 1 and first.source_offset == 0
    assert first.document.nodes[first.document.roots[0]].kind == JsonNodeKind.Null
    second: JsonLinesReadResult = next_json_lines_document(reader)
    assert second.has_document and second.record_number == 2 and second.source_offset == 6
    assert second.document.nodes[second.document.roots[0]].kind == JsonNodeKind.Bool
    assert second.document.nodes[second.document.roots[0]].bool_value
    third: JsonLinesReadResult = next_json_lines_document(reader)
    assert third.has_document and third.record_number == 3 and third.source_offset == 11
    assert third.document.nodes[third.document.roots[0]].kind == JsonNodeKind.Array
    assert third.document.nodes[third.document.roots[0]].child_count == 1
    finished: JsonLinesReadResult = next_json_lines_document(reader)
    assert not finished.has_document
    assert reader.stream.state == JsonStreamState.Complete
    assert reader.decoder.records == 3 and reader.decoder.tokens == 5
    assert reader.decoder.input_bytes == 14 and reader.decoder.fields == 0
    assert validate_json_lines_reader(reader)

    chunk_reader: mutable JsonLinesChunkReader = begin_json_lines_chunk_reader(limits)
    first_chunk: JsonLinesFeedResult = feed_json_lines_chunk(chunk_reader, "nu")
    assert first_chunk.outcome == JsonLinesFeedOutcome.NeedInput and first_chunk.consumed_bytes == 2
    assert chunk_reader.record_buffer.count == 2 and validate_json_lines_chunk_reader(chunk_reader)
    empty_chunk: JsonLinesFeedResult = feed_json_lines_chunk(chunk_reader, "")
    assert empty_chunk.outcome == JsonLinesFeedOutcome.NeedInput and empty_chunk.consumed_bytes == 0
    second_chunk: JsonLinesFeedResult = feed_json_lines_chunk(chunk_reader, "ll\ntrue")
    assert second_chunk.outcome == JsonLinesFeedOutcome.Document and second_chunk.consumed_bytes == 3
    assert second_chunk.record_number == 1 and second_chunk.source_offset == 0
    assert second_chunk.document.nodes[second_chunk.document.roots[0]].kind == JsonNodeKind.Null
    assert validate_json_lines_chunk_reader(chunk_reader)
    final_suffix: sview = string_view_slice("ll\ntrue", 3, 7)
    final_record: JsonLinesFeedResult = feed_json_lines_chunk(chunk_reader, final_suffix, true)
    assert final_record.outcome == JsonLinesFeedOutcome.Document and final_record.consumed_bytes == 4
    assert final_record.record_number == 2 and final_record.source_offset == 5
    assert final_record.document.nodes[final_record.document.roots[0]].kind == JsonNodeKind.Bool
    assert final_record.document.nodes[final_record.document.roots[0]].bool_value
    chunk_end: JsonLinesFeedResult = feed_json_lines_chunk(chunk_reader, "", true)
    assert chunk_end.outcome == JsonLinesFeedOutcome.Complete
    assert chunk_reader.decoder.records == 2 and chunk_reader.decoder.tokens == 2
    assert chunk_reader.decoder.input_bytes == 9 and validate_json_lines_chunk_reader(chunk_reader)

    final_delimiter_reader: mutable JsonLinesChunkReader = begin_json_lines_chunk_reader(limits)
    final_delimiter_first: JsonLinesFeedResult = feed_json_lines_chunk(final_delimiter_reader, "null\ntrue\n", true)
    assert final_delimiter_first.outcome == JsonLinesFeedOutcome.Document and final_delimiter_first.consumed_bytes == 5
    assert final_delimiter_reader.final_input_pending and final_delimiter_reader.final_bytes_remaining == 5
    assert validate_json_lines_chunk_reader(final_delimiter_reader)
    final_delimiter_wrong_suffix_rejected: mutable bool = false
    catch feed_json_lines_chunk(final_delimiter_reader, "nope", true):
        ok value:
            assert false
        error failure:
            assert failure == JsonLinesParseError.InvalidState
            final_delimiter_wrong_suffix_rejected <- true
    assert final_delimiter_wrong_suffix_rejected
    assert final_delimiter_reader.final_input_pending and validate_json_lines_chunk_reader(final_delimiter_reader)
    final_delimiter_suffix: JsonLinesFeedResult = feed_json_lines_chunk(final_delimiter_reader, "true\n", true)
    assert final_delimiter_suffix.outcome == JsonLinesFeedOutcome.Document and final_delimiter_suffix.consumed_bytes == 5
    assert final_delimiter_suffix.record_number == 2
    assert final_delimiter_reader.stream.state == JsonStreamState.Complete
    assert not final_delimiter_reader.final_input_pending and final_delimiter_reader.final_bytes_remaining == 0
    assert validate_json_lines_chunk_reader(final_delimiter_reader)

    empty_policy: JsonStreamPolicy = JsonStreamPolicy{max_input_bytes: 64, max_record_bytes: 32, max_records: 8, max_depth: 8, allow_empty_records: true}
    empty_chunk_reader: mutable JsonLinesChunkReader = begin_json_lines_chunk_reader(limits, JsonPolicy{}, empty_policy)
    split_crlf: JsonLinesFeedResult = feed_json_lines_chunk(empty_chunk_reader, "\r")
    assert split_crlf.outcome == JsonLinesFeedOutcome.NeedInput and split_crlf.consumed_bytes == 1
    assert validate_json_lines_chunk_reader(empty_chunk_reader)
    empty_chunk_result: JsonLinesFeedResult = feed_json_lines_chunk(empty_chunk_reader, "\nnull\n")
    assert empty_chunk_result.outcome == JsonLinesFeedOutcome.Document
    assert empty_chunk_result.record_number == 2 and empty_chunk_result.source_offset == 2 and empty_chunk_result.consumed_bytes == 6
    empty_chunk_end: JsonLinesFeedResult = feed_json_lines_chunk(empty_chunk_reader, "", true)
    assert empty_chunk_end.outcome == JsonLinesFeedOutcome.Complete and validate_json_lines_chunk_reader(empty_chunk_reader)

    chunk_token_limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 64, tokens: 1, depth: 8, records: 8, fields: 8, field_bytes: 16}
    chunk_limited_reader: mutable JsonLinesChunkReader = begin_json_lines_chunk_reader(chunk_token_limits)
    chunk_first: JsonLinesFeedResult = feed_json_lines_chunk(chunk_limited_reader, "null\n")
    assert chunk_first.outcome == JsonLinesFeedOutcome.Document and chunk_first.record_number == 1
    chunk_token_limit_rejected: mutable bool = false
    catch feed_json_lines_chunk(chunk_limited_reader, "true", true):
        ok value:
            assert false
        error failure:
            assert failure == JsonLinesParseError.TokenLimitExceeded
            chunk_token_limit_rejected <- true
    assert chunk_token_limit_rejected
    assert chunk_limited_reader.failure_record_number == 2 and chunk_limited_reader.failure_record_start == 5
    assert validate_json_lines_chunk_reader(chunk_limited_reader)

    empty_reader: mutable JsonLinesReader = begin_json_lines_reader("\r\nnull\n", limits, JsonPolicy{}, empty_policy)
    after_empty: JsonLinesReadResult = next_json_lines_document(empty_reader)
    assert after_empty.has_document and after_empty.record_number == 2 and after_empty.source_offset == 2
    assert validate_json_lines_reader(empty_reader)

    whitespace_eof_reader: mutable JsonLinesReader = begin_json_lines_reader("\t\r", limits, JsonPolicy{}, empty_policy)
    whitespace_eof: JsonLinesReadResult = next_json_lines_document(whitespace_eof_reader)
    assert not whitespace_eof.has_document
    assert whitespace_eof_reader.stream.state == JsonStreamState.Complete
    assert whitespace_eof_reader.decoder.records == 1 and whitespace_eof_reader.decoder.input_bytes == 2
    assert validate_json_lines_reader(whitespace_eof_reader)

    tight_limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 64, tokens: 2, depth: 8, records: 8, fields: 8, field_bytes: 16}
    limited_reader: mutable JsonLinesReader = begin_json_lines_reader("null\ntrue\nfalse", tight_limits)
    _ = next_json_lines_document(limited_reader)
    _ = next_json_lines_document(limited_reader)
    token_limit_rejected: mutable bool = false
    catch next_json_lines_document(limited_reader):
        ok value:
            assert false
        error failure:
            assert failure == JsonLinesParseError.TokenLimitExceeded
            token_limit_rejected <- true
    assert token_limit_rejected
    assert limited_reader.stream.state == JsonStreamState.Failed
    assert limited_reader.failure_record_number == 3 and limited_reader.failure_record_start == 10
    assert validate_json_lines_reader(limited_reader)
    reader_stays_failed: mutable bool = false
    catch next_json_lines_document(limited_reader):
        ok value:
            assert false
        error failure:
            assert failure == JsonLinesParseError.InvalidState
            reader_stays_failed <- true
    assert reader_stays_failed

    assert JSON_LINES_PARSE_FORMAT_VERSION == 2
    balanced_multiline_reader: mutable JsonLinesReader = begin_json_lines_reader("{\n\"x\": 1\n}", limits)
    balanced_multiline: JsonLinesReadResult = next_json_lines_document(balanced_multiline_reader)
    assert balanced_multiline.has_document and balanced_multiline.document.nodes[balanced_multiline.document.roots[0]].kind == JsonNodeKind.Object
    assert balanced_multiline_reader.stream.state == JsonStreamState.Complete and validate_json_lines_reader(balanced_multiline_reader)

    physical_framing: JsonStreamPolicy = JsonStreamPolicy{max_input_bytes: 64, max_record_bytes: 32, max_records: 8, max_depth: 8, record_boundary: JsonLineBoundaryMode.PhysicalLines}
    physical_reader: mutable JsonLinesReader = begin_json_lines_reader("{\"x\": 1}\r\nnull", limits, JsonPolicy{}, physical_framing)
    physical_object: JsonLinesReadResult = next_json_lines_document(physical_reader)
    assert physical_object.has_document and physical_object.record_number == 1 and physical_object.document.nodes[physical_object.document.roots[0]].kind == JsonNodeKind.Object
    physical_final_record: JsonLinesReadResult = next_json_lines_document(physical_reader)
    assert physical_final_record.has_document and physical_final_record.record_number == 2 and physical_final_record.source_offset == 10
    physical_end: JsonLinesReadResult = next_json_lines_document(physical_reader)
    assert not physical_end.has_document and physical_reader.stream.state == JsonStreamState.Complete
    assert validate_json_lines_reader(physical_reader)

    physical_multiline_reader: mutable JsonLinesReader = begin_json_lines_reader("{\n\"x\": 1\n}", limits, JsonPolicy{}, physical_framing)
    physical_multiline_rejected: mutable bool = false
    catch next_json_lines_document(physical_multiline_reader):
        ok value:
            assert false
        error failure:
            assert failure == JsonStreamError.UnterminatedValue
            physical_multiline_rejected <- true
    assert physical_multiline_rejected
    assert physical_multiline_reader.stream.state == JsonStreamState.Failed and physical_multiline_reader.stream.input_bytes == 1
    assert physical_multiline_reader.failure_record_start == 0 and validate_json_lines_reader(physical_multiline_reader)

    physical_string_reader: mutable JsonLinesReader = begin_json_lines_reader("\"before\nrest\"", limits, JsonPolicy{}, physical_framing)
    physical_string_rejected: mutable bool = false
    catch next_json_lines_document(physical_string_reader):
        ok value:
            assert false
        error failure:
            assert failure == JsonStreamError.UnterminatedString
            physical_string_rejected <- true
    assert physical_string_rejected and physical_string_reader.stream.state == JsonStreamState.Failed
    assert physical_string_reader.stream.input_bytes == 7 and validate_json_lines_reader(physical_string_reader)

    physical_chunk_reader: mutable JsonLinesChunkReader = begin_json_lines_chunk_reader(limits, JsonPolicy{}, physical_framing)
    physical_chunk_prefix: JsonLinesFeedResult = feed_json_lines_chunk(physical_chunk_reader, "{")
    assert physical_chunk_prefix.outcome == JsonLinesFeedOutcome.NeedInput
    physical_chunk_newline_rejected: mutable bool = false
    catch feed_json_lines_chunk(physical_chunk_reader, "\n\"x\": 1}"):
        ok value:
            assert false
        error failure:
            assert failure == JsonStreamError.UnterminatedValue
            physical_chunk_newline_rejected <- true
    assert physical_chunk_newline_rejected
    assert physical_chunk_reader.stream.state == JsonStreamState.Failed and physical_chunk_reader.stream.input_bytes == 1
    assert validate_json_lines_chunk_reader(physical_chunk_reader)

    physical_chunk_string_reader: mutable JsonLinesChunkReader = begin_json_lines_chunk_reader(limits, JsonPolicy{}, physical_framing)
    physical_chunk_string_prefix: JsonLinesFeedResult = feed_json_lines_chunk(physical_chunk_string_reader, "\"before")
    assert physical_chunk_string_prefix.outcome == JsonLinesFeedOutcome.NeedInput
    physical_chunk_string_rejected: mutable bool = false
    catch feed_json_lines_chunk(physical_chunk_string_reader, "\nrest\""):
        ok value:
            assert false
        error failure:
            assert failure == JsonStreamError.UnterminatedString
            physical_chunk_string_rejected <- true
    assert physical_chunk_string_rejected and physical_chunk_string_reader.stream.state == JsonStreamState.Failed
    assert physical_chunk_string_reader.stream.input_bytes == 7 and validate_json_lines_chunk_reader(physical_chunk_string_reader)

    physical_empty_policy: JsonStreamPolicy = JsonStreamPolicy{max_input_bytes: 64, max_record_bytes: 32, max_records: 8, max_depth: 8, allow_empty_records: true, record_boundary: JsonLineBoundaryMode.PhysicalLines}
    physical_empty_reader: mutable JsonLinesReader = begin_json_lines_reader("\nnull\n", limits, JsonPolicy{}, physical_empty_policy)
    physical_after_empty: JsonLinesReadResult = next_json_lines_document(physical_empty_reader)
    assert physical_after_empty.has_document and physical_after_empty.record_number == 2 and physical_after_empty.source_offset == 1
    assert validate_json_lines_reader(physical_empty_reader)


@test
def typed_json_lines_file_adapter_uses_bounded_owned_chunks() -> void:
    assert JSON_LINES_FILE_READER_FORMAT_VERSION == 1
    assert JSON_LINES_FILE_CHUNK_BYTES == 16384
    assert JSON_LINES_FILE_MAX_INPUT_BYTES + 1 == FILE_STREAM_DEFAULT_MAX_BYTES
    assert JsonLinesFileReaderState.Reading != JsonLinesFileReaderState.Complete
    assert JsonLinesFileReaderState.Failed != JsonLinesFileReaderState.Closed


@test
def typed_json_lines_file_adapter_reads_documents_and_closes() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic:
        path: static u8& = "/tmp/elisascript-jsonl-file-reader-documents.jsonl"
        _ = remove_file(path)
        written: mutable i64 = 0
        catch write_entire_file(path, "null\ntrue\nfalse"):
            ok count:
                written <- count
            error failure:
                assert false
        assert written == 15
        limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 64, tokens: 16, depth: 8, records: 8, fields: 8, field_bytes: 32}
        catch begin_json_lines_file_reader(path, limits):
            ok opened:
                reader: mutable JsonLinesFileReader = opened
                first: mutable JsonLinesReadResult = JsonLinesReadResult{}
                catch next_json_lines_file_document(reader):
                    ok result:
                        first <- result
                    error failure:
                        assert false
                assert first.has_document and first.record_number == 1
                assert first.document.nodes[first.document.roots[0]].kind == JsonNodeKind.Null
                assert reader.source_bytes_read == 15 and reader.buffer_bytes == 15 and reader.buffer_offset == 5
                second: mutable JsonLinesReadResult = JsonLinesReadResult{}
                catch next_json_lines_file_document(reader):
                    ok result:
                        second <- result
                    error failure:
                        assert false
                assert second.has_document and second.record_number == 2
                assert second.document.nodes[second.document.roots[0]].kind == JsonNodeKind.Bool
                assert second.document.nodes[second.document.roots[0]].bool_value
                third: mutable JsonLinesReadResult = JsonLinesReadResult{}
                catch next_json_lines_file_document(reader):
                    ok result:
                        third <- result
                    error failure:
                        assert false
                assert third.has_document and third.record_number == 3
                assert third.document.nodes[third.document.roots[0]].kind == JsonNodeKind.Bool
                assert not third.document.nodes[third.document.roots[0]].bool_value
                assert reader.state == JsonLinesFileReaderState.Complete
                closed: mutable bool = false
                catch close_json_lines_file_reader(reader):
                    ok result:
                        closed <- result
                    error failure:
                        assert false
                assert closed and reader.state == JsonLinesFileReaderState.Closed
                closed_again: mutable bool = false
                catch close_json_lines_file_reader(reader):
                    ok result:
                        closed_again <- result
                    error failure:
                        assert false
                assert closed_again
            error failure:
                assert false
        assert remove_file(path)


@test
def typed_json_lines_file_adapter_probes_exact_limit_and_rejects_overflow() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic:
        path: static u8& = "/tmp/elisascript-jsonl-file-reader-limit.jsonl"
        _ = remove_file(path)
        written: mutable i64 = 0
        catch write_entire_file(path, "null\n"):
            ok count:
                written <- count
            error failure:
                assert false
        assert written == 5
        limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 5, tokens: 8, depth: 4, records: 4, fields: 4, field_bytes: 8}
        catch begin_json_lines_file_reader(path, limits):
            ok opened:
                exact_reader: mutable JsonLinesFileReader = opened
                exact_record: mutable JsonLinesReadResult = JsonLinesReadResult{}
                catch next_json_lines_file_document(exact_reader):
                    ok result:
                        exact_record <- result
                    error failure:
                        assert false
                assert exact_record.has_document and exact_record.record_number == 1
                exact_end: mutable JsonLinesReadResult = JsonLinesReadResult{}
                catch next_json_lines_file_document(exact_reader):
                    ok result:
                        exact_end <- result
                    error failure:
                        assert false
                assert not exact_end.has_document and exact_reader.state == JsonLinesFileReaderState.Complete
                assert exact_reader.source_bytes_read == 5 and exact_reader.file.bytes_read == 5
                assert close_json_lines_file_reader(exact_reader)
            error failure:
                assert false

        written <- 0
        catch write_entire_file(path, "null\nx"):
            ok count:
                written <- count
            error failure:
                assert false
        assert written == 6
        catch begin_json_lines_file_reader(path, limits):
            ok opened:
                overflow_reader: mutable JsonLinesFileReader = opened
                overflow_record: mutable JsonLinesReadResult = JsonLinesReadResult{}
                catch next_json_lines_file_document(overflow_reader):
                    ok result:
                        overflow_record <- result
                    error failure:
                        assert false
                assert overflow_record.has_document and overflow_record.record_number == 1
                overflow_rejected: mutable bool = false
                catch next_json_lines_file_document(overflow_reader):
                    ok result:
                        assert false
                    error failure:
                        assert failure == JsonStreamError.InputLimitExceeded
                        overflow_rejected <- true
                assert overflow_rejected
                assert overflow_reader.state == JsonLinesFileReaderState.Failed
                assert overflow_reader.source_bytes_read == 6 and overflow_reader.file.bytes_read == 6
                assert validate_json_lines_file_reader(overflow_reader)
                assert close_json_lines_file_reader(overflow_reader)
                assert overflow_reader.state == JsonLinesFileReaderState.Closed
            error failure:
                assert false
        assert remove_file(path)


@test
def typed_json_document_contract_is_bounded_and_sealed_explicitly() -> void:
    limits: DataDecodeLimits = DataDecodeLimits{input_bytes: 64, tokens: 16, depth: 4, records: 8, fields: 8, field_bytes: 32}
    document: mutable JsonDocument = JsonDocument{limits: limits, policy: JsonPolicy{duplicate_keys: JsonDuplicateKeyPolicy.Reject}}
    assert advance_json_document(document, JsonDocumentEvent.Begin) == JsonDocumentState.Building
    scalar: JsonNodeInput = JsonNodeInput{kind: JsonNodeKind.Text, range: JsonRange{start: 8, end: 14}, depth: 1, scalar_value: "tool"}
    assert advance_json_document(document, JsonDocumentEvent.AppendNode, scalar, JsonMemberInput{owner_index: JSON_INDEX_NONE, key: ""}, JSON_INDEX_NONE, 15) == JsonDocumentState.Building
    assert document.nodes[0].scalar_start == 0
    assert document.scalar_data.count == 4
    assert document.scalar_data[0] == 116
    assert advance_json_document(document, JsonDocumentEvent.AppendNode, JsonNodeInput{kind: JsonNodeKind.Object, range: JsonRange{start: 0, end: 15}}) == JsonDocumentState.Building
