@test
def canonical_type_encoding_includes_the_fifth_aggregate_layer() -> void:
    can Memory.Allocate, Abort.Panic:
        nested: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Array, element_element_kind: TypeKind.Array, element_element_element_kind: TypeKind.Array, element_element_element_element_kind: TypeKind.Array, element_element_element_element_element_kind: TypeKind.Int, element_element_element_element_element_bits: 64, element_element_element_element_element_signed: true}
        changed: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Array, element_element_kind: TypeKind.Array, element_element_element_kind: TypeKind.Array, element_element_element_element_kind: TypeKind.Array, element_element_element_element_element_kind: TypeKind.Int, element_element_element_element_element_bits: 32, element_element_element_element_element_signed: true}
        first_parameter: Parameter = Parameter{value: 1, type: nested, name: "value"}
        second_parameter: Parameter = Parameter{value: 1, type: changed, name: "value"}
        first: Function = Function{name: "typed", parameters: [first_parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [], entry: 0}
        second: Function = Function{name: "typed", parameters: [second_parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [], entry: 0}
        first_module: Module = Module{name: "deepest-nested", functions: [first]}
        second_module: Module = Module{name: "deepest-nested", functions: [second]}
        assert canonical_module_hash(first_module) != canonical_module_hash(second_module)


@test
def canonical_type_encoding_includes_the_sixth_aggregate_layer() -> void:
    can Memory.Allocate, Abort.Panic:
        nested: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Array, element_element_kind: TypeKind.Array, element_element_element_kind: TypeKind.Array, element_element_element_element_kind: TypeKind.Array, element_element_element_element_element_kind: TypeKind.Array, element_element_element_element_element_element_kind: TypeKind.Int, element_element_element_element_element_element_bits: 64, element_element_element_element_element_element_signed: true}
        changed: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Array, element_element_kind: TypeKind.Array, element_element_element_kind: TypeKind.Array, element_element_element_element_kind: TypeKind.Array, element_element_element_element_element_kind: TypeKind.Array, element_element_element_element_element_element_kind: TypeKind.Int, element_element_element_element_element_element_bits: 32, element_element_element_element_element_element_signed: true}
        first_parameter: Parameter = Parameter{value: 1, type: nested, name: "value"}
        second_parameter: Parameter = Parameter{value: 1, type: changed, name: "value"}
        first: Function = Function{name: "typed", parameters: [first_parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [], entry: 0}
        second: Function = Function{name: "typed", parameters: [second_parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [], entry: 0}
        first_module: Module = Module{name: "deepest-nested-six", functions: [first]}
        second_module: Module = Module{name: "deepest-nested-six", functions: [second]}
        assert canonical_module_hash(first_module) != canonical_module_hash(second_module)


