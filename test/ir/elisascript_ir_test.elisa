@test
def verifier_rejects_void_parameter_and_container_types() -> void:
    can Memory.Allocate, Abort.Panic:
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: Terminator{kind: TerminatorKind.Return, span: span()}}
        void_parameter: Parameter = Parameter{value: 1, type: void_type(), name: "void"}
        void_function: Function = Function{name: "void-parameter", parameters: [void_parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [block], entry: 1}
        void_module: Module = Module{name: "void-parameter", functions: [void_function]}
        assert issue_count(verify(void_module), IssueKind.InvalidTypeTable) > 0

        block_void_parameter: Parameter = Parameter{value: 1, type: void_type(), name: "void"}
        block_with_void_parameter: Block = Block{id: 1, parameter_start: 0, parameter_count: 1, instruction_start: 0, instruction_count: 0, terminator: Terminator{kind: TerminatorKind.Return, span: span()}}
        block_void_function: Function = Function{name: "void-block-parameter", parameters: [], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [block_void_parameter], instruction_pool: [], blocks: [block_with_void_parameter], entry: 1}
        block_void_module: Module = Module{name: "void-block-parameter", functions: [block_void_function]}
        assert issue_count(verify(block_void_module), IssueKind.InvalidTypeTable) > 0

        array_of_void: Type = Type{kind: TypeKind.Array}
        aggregate_parameter: Parameter = Parameter{value: 1, type: array_of_void, name: "aggregate"}
        aggregate_function: Function = Function{name: "array-of-void", parameters: [aggregate_parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [block], entry: 1}
        aggregate_module: Module = Module{name: "array-of-void", functions: [aggregate_function]}
        assert issue_count(verify(aggregate_module), IssueKind.InvalidTypeTable) > 0

        void_element_table: TypeTable = TypeTable{rows: [TypeDescriptor{kind: TypeKind.Void}, TypeDescriptor{kind: TypeKind.Array, child_start: 0, child_count: 1}], children: [1]}
        void_map_table: TypeTable = TypeTable{rows: [TypeDescriptor{kind: TypeKind.Void}, TypeDescriptor{kind: TypeKind.Map, child_start: 0, child_count: 2}], children: [1, 1]}
        assert not type_table_valid(void_element_table)
        assert not type_table_valid(void_map_table)
        assert issue_count(verify(Module{name: "void-container-descriptors", functions: [], type_table: void_element_table}), IssueKind.InvalidTypeTable) > 0


