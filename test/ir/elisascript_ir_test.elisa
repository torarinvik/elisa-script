@test
def verified_ir_exposes_effects_and_stable_observations() -> void:
    can Memory.Allocate, Abort.Panic:
        input: Parameter = Parameter{value: 1, type: int_type(), name: "input"}
        perform: Instruction = Instruction{opcode: Opcode.Perform, result: 2, result_type: int_type(), operand_start: 0, operand_count: 1, effect_family: "Process", effect_operation: "Run", trace: TraceSite{id: 1001, label: "reference-run"}, span: span()}
        observe: Instruction = Instruction{opcode: Opcode.Observe, result: 0, result_type: void_type(), operand_start: 1, operand_count: 1, trace: TraceSite{id: 1002, label: "exit-status"}, span: span()}
        term: Terminator = Terminator{kind: TerminatorKind.Return, span: span()}
        block: Block = Block{id: 10, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 2, terminator: term}
        fn: Function = Function{name: "compare", parameters: [input], return_type: void_type(), effects: ["Process"], operand_pool: [1, 2], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [perform, observe], blocks: [block], entry: 10}
        module: Module = Module{name: "test", functions: [fn]}

        assert verify(module).count == 0


@test
def verifier_rejects_untracked_or_undeclared_effects() -> void:
    can Memory.Allocate, Abort.Panic:
        perform: Instruction = Instruction{opcode: Opcode.Perform, result: 1, result_type: int_type(), effect_family: "Clock", effect_operation: "Now", span: span()}
        term: Terminator = Terminator{kind: TerminatorKind.Return, span: span()}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 1, terminator: term}
        fn: Function = Function{name: "bad", parameters: [], return_type: void_type(), effects: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [perform], blocks: [block], entry: 1}
        module: Module = Module{name: "test", functions: [fn]}
        issues: darray[Issue] = verify(module)

        assert issue_count(issues, IssueKind.MissingEffect) == 1
        assert issue_count(issues, IssueKind.MissingTraceSite) == 1


@test
def verifier_rejects_malformed_interned_type_tables() -> void:
    can Memory.Allocate, Abort.Panic:
        malformed: TypeTable = TypeTable{rows: [TypeDescriptor{kind: TypeKind.Array, child_start: 0, child_count: 1}], children: [99]}
        module: Module = Module{name: "bad-types", functions: [], type_table: malformed}
        issues: darray[Issue] = verify(module)
        assert issue_count(issues, IssueKind.InvalidTypeTable) == 1

        wrapping: TypeTable = TypeTable{rows: [TypeDescriptor{kind: TypeKind.Array, child_start: 4294967295, child_count: 1}], children: []}
        wrapping_module: Module = Module{name: "wrapping-types", functions: [], type_table: wrapping}
        assert not type_table_valid(wrapping_module.type_table)
        assert type_table_child(1, 0, wrapping) == 0
        assert not type_table_matches_inline(Type{kind: TypeKind.Array}, 1, wrapping)

        orphaned: TypeTable = TypeTable{rows: [], children: [1]}
        assert not type_table_valid(orphaned)

        scalar_children: TypeTable = TypeTable{rows: [TypeDescriptor{kind: TypeKind.Int, bits: 64, signed: true, child_start: 0, child_count: 1}], children: [1]}
        assert not type_table_valid(scalar_children)

        array_with_two_children: TypeTable = TypeTable{rows: [TypeDescriptor{kind: TypeKind.Array, child_start: 0, child_count: 2}, TypeDescriptor{kind: TypeKind.Int, bits: 64, signed: true}], children: [2, 2]}
        assert not type_table_valid(array_with_two_children)

        map_with_one_child: TypeTable = TypeTable{rows: [TypeDescriptor{kind: TypeKind.Map, child_start: 0, child_count: 1}, TypeDescriptor{kind: TypeKind.Int, bits: 64, signed: true}], children: [2]}
        assert not type_table_valid(map_with_one_child)

        mismatched: Type = Type{kind: TypeKind.Bool, bits: 1, descriptor_id: 1}
        parameter: Parameter = Parameter{value: 1, type: mismatched, name: "flag"}
        fn: Function = Function{name: "typed", parameters: [parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [], entry: 0}
        valid_rows: TypeTable = TypeTable{rows: [TypeDescriptor{kind: TypeKind.Int, bits: 64, signed: true}], children: []}
        mismatched_module: Module = Module{name: "mismatch", functions: [fn], type_table: valid_rows}
        mismatched_issues: darray[Issue] = verify(mismatched_module)
        assert issue_count(mismatched_issues, IssueKind.InvalidTypeTable) >= 1

        cyclic_type: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Int, descriptor_id: 1}
        cyclic_parameter: Parameter = Parameter{value: 1, type: cyclic_type, name: "cycle"}
        cyclic_function: Function = Function{name: "cyclic", parameters: [cyclic_parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [], entry: 0}
        cyclic_table: TypeTable = TypeTable{rows: [TypeDescriptor{kind: TypeKind.Array, child_start: 0, child_count: 1}], children: [1]}
        cyclic_module: Module = Module{name: "cyclic", functions: [cyclic_function], type_table: cyclic_table}
        assert not type_table_valid(cyclic_module.type_table)
        cyclic_issues: darray[Issue] = verify(cyclic_module)
        assert issue_count(cyclic_issues, IssueKind.InvalidTypeTable) >= 1


@test
def verifier_rejects_invalid_inline_and_interned_float_widths() -> void:
    can Memory.Allocate, Abort.Panic:
        invalid_float: Type = Type{kind: TypeKind.Float, bits: 16, signed: true}
        parameter: Parameter = Parameter{value: 1, type: invalid_float, name: "invalid"}
        block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 0, terminator: Terminator{kind: TerminatorKind.Return, span: span()}}
        fn: Function = Function{name: "bad-float-width", parameters: [parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [block], entry: 1}
        inline_module: Module = Module{name: "bad-float-width", functions: [fn]}
        assert issue_count(verify(inline_module), IssueKind.InvalidTypeTable) > 0

        nested: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Float, element_bits: 16, element_signed: true}
        nested_parameter: Parameter = Parameter{value: 1, type: nested, name: "nested"}
        nested_fn: Function = Function{name: "bad-nested-float-width", parameters: [nested_parameter], return_type: void_type(), effects: [], errors: [], operand_pool: [], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [], blocks: [block], entry: 1}
        nested_module: Module = Module{name: "bad-nested-float-width", functions: [nested_fn]}
        assert issue_count(verify(nested_module), IssueKind.InvalidTypeTable) > 0

        malformed_table: TypeTable = TypeTable{rows: [TypeDescriptor{kind: TypeKind.Float, bits: 16}], children: []}
        table_module: Module = Module{name: "bad-float-table", functions: [], type_table: malformed_table}
        assert not type_table_valid(malformed_table)
        assert not type_table_matches_inline(invalid_float, 1, malformed_table)
        assert issue_count(verify(table_module), IssueKind.InvalidTypeTable) > 0


