# Dormant small native-namespace compile fixture; no IR facade/interpreter loop.
# Body observes default storage/control metadata only. No C function is called.
include "../../src/ir/process_spawn_budget_darwin.elisa"

extend EsIr:
    public:
        @test
        def prepared_spawn_host_owners_are_private_with_public_data_projection() -> void:
            launch: BudgetedLaunch = BudgetedLaunch{}
            assert launch.phase == LaunchPhase.Fresh
            assert launch.child.state == EsProcessSpawnOwner::State.Fresh
            assert launch.child.pid == 0 and not launch.budget.held
            assert launch.attributes.resource_id == 0 and launch.attributes.handle == null
            assert ProcessSpawnFlags::SETPGROUP == 2i16
            before: EsProcessLaunchCompletion::Report = completion_report(launch, false)
            assert not before.coordinator_complete and not before.launch_failed
            assert not before.setup_failed and before.setup_code == 0
            assert not before.cleanup_attempted and not before.cleanup_failed
            assert EsProcessLaunchCompletion::route(launch.child, launch.budget.held, before) == EsProcessLaunchCompletion::Route.Panic
            rejected: EsProcessLaunchCompletion::Report = completion_report(launch, true)
            assert rejected.launch_failed and not rejected.cleanup_attempted
            assert EsProcessLaunchCompletion::route(launch.child, launch.budget.held, rejected) == EsProcessLaunchCompletion::Route.ProcessFailure
