@test
def interpreter_dispatches_to_nearest_dynamic_linear_handler_clause() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def outer_clause() -> void:\n    observe(1)\n\ndef inner_clause() -> void:\n    observe(2)\n\ndef emit_tick() -> void can[Progress.Tick]:\n    signal Progress.Tick\n\ndef run() -> i64:\n    with handler outer:\n        emit_tick()\n        signal Progress.Tick\n        with handler inner:\n            emit_tick()\n        signal Progress.Tick\n    return 7\n\ndef masked() -> i64:\n    with handler outer:\n        with handler mask:\n            signal Progress.Tick\n    return 9\n"
        outer_clause: HandlerClause = HandlerClause{effect_family: "Progress", effect_operation: "Tick", function: "outer_clause"}
        inner_clause: HandlerClause = HandlerClause{effect_family: "Progress", effect_operation: "Tick", function: "inner_clause"}
        outer: Handler = Handler{name: "outer", handles: ["Progress"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear, clauses: [outer_clause]}
        inner: Handler = Handler{name: "inner", handles: ["Progress"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear, clauses: [inner_clause]}
        mask: Handler = Handler{name: "mask", handles: ["Progress"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear}
        handlers: darray[Handler] = [outer, inner, mask]
        module: Module = lower_program_with_handlers(source, handlers)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        execution: Execution = interpret_for_test(module, "run", arguments, observations)

        assert execution.value.integer == 7
        assert observations.count == 4
        assert observations[0].value.integer == 1
        assert observations[1].value.integer == 1
        assert observations[2].value.integer == 2
        assert observations[3].value.integer == 1
        assert interpret_for_test(module, "masked", arguments, observations).value.kind == RuntimeValueKind.Void


@test
def interpreter_rejects_malformed_external_array_ranges() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def read(values: darray[i64]) -> i64:\n    return values[0]\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = [runtime_array(1, 1)]
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []

        assert not runtime_array_range_valid(storage, arguments[0])
        rejected: Execution = try interpret(module, "read", arguments, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert rejected.value.kind == RuntimeValueKind.Void


@test
def interpreter_copies_and_moves_files_without_shell_roundtrips() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def lifecycle() -> bool:\n    source: Path = path\"/tmp/elisascript-file-copy-source.txt\"\n    copied_path: Path = path\"/tmp/elisascript-file-copy-destination.txt\"\n    moved_path: Path = path\"/tmp/elisascript-file-copy-moved.txt\"\n    write_text(source, \"alpha\\x00omega\")\n    copied: bool = copy_path(source, copied_path)\n    copied_contents: sview = read_text(copied_path)\n    moved: bool = move_path(copied_path, moved_path)\n    moved_contents: sview = read_text(moved_path)\n    source_exists: bool = path_exists(source)\n    destination_gone: bool = not path_exists(copied_path)\n    cleanup_source: bool = remove_path(source)\n    cleanup_moved: bool = remove_path(moved_path)\n    return copied and moved and source_exists and destination_gone and copied_contents == \"alpha\\x00omega\" and moved_contents == \"alpha\\x00omega\" and cleanup_source and cleanup_moved\n\ndef missing() -> bool:\n    return copy_path(path\"/tmp/elisascript-file-copy-missing.txt\", path\"/tmp/elisascript-file-copy-destination.txt\")\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "lifecycle", arguments, observations).value.boolean
        assert interpret_for_test(module, "missing", arguments, observations).value.kind == RuntimeValueKind.Void


@test
def interpreter_executes_typed_path_shape_operations() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def combine(base: Path, leaf: sview) -> Path:\n    return path_join(base, leaf)\n\ndef parent(path_value: Path) -> Path:\n    return path_parent(path_value)\n\ndef name(path_value: Path) -> sview:\n    return path_name(path_value)\n\ndef extension(path_value: Path) -> sview:\n    return path_extension(path_value)\n\ndef stem(path_value: Path) -> sview:\n    return path_stem(path_value)\n"
        module: Module = lower_program(source)
        base: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "src/elisa"}]
        leaf: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "main.elisa"}]
        path: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "src/elisa/main.elisa"}]
        absolute_leaf: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "/tmp/main.elisa"}]
        combine_arguments: darray[RuntimeValue] = [base[0], leaf[0]]
        absolute_arguments: darray[RuntimeValue] = [base[0], absolute_leaf[0]]
        observations: mutable darray[Observation] = []
        combined: Execution = interpret_for_test(module, "combine", combine_arguments, observations)
        absolute: Execution = interpret_for_test(module, "combine", absolute_arguments, observations)
        assert combined.value.text == "src/elisa/main.elisa"
        assert absolute.value.text == "/tmp/main.elisa"
        assert interpret_for_test(module, "parent", path, observations).value.text == "src/elisa"
        assert interpret_for_test(module, "name", path, observations).value.text == "main.elisa"
        assert interpret_for_test(module, "extension", path, observations).value.text == ".elisa"
        assert interpret_for_test(module, "stem", path, observations).value.text == "main"


