@test
def interpreter_round_trips_typed_binary_file_bytes() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO:
        temporary_path: static u8& = "/tmp/elisascript-binary-file-runtime-test.bin"
        _ = remove_file(temporary_path)
        source: static u8& = "def lifecycle() -> bool:\n    first: usize = write_bytes(path\"/tmp/elisascript-binary-file-runtime-test.bin\", [65u8, 0u8, 66u8])\n    second: usize = append_binary(path\"/tmp/elisascript-binary-file-runtime-test.bin\", [67u8])\n    bytes: darray[u8] = read_bytes(path\"/tmp/elisascript-binary-file-runtime-test.bin\")\n    first_value: u8 = bytes[0]\n    nul_value: u8 = bytes[1]\n    last_value: u8 = bytes[3]\n    removed: bool = remove_path(path\"/tmp/elisascript-binary-file-runtime-test.bin\")\n    return first == 3u64 and second == 1u64 and bytes.count == 4u64 and first_value == 65u8 and nul_value == 0u8 and last_value == 67u8 and removed\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        lifecycle: Execution = interpret_for_test(module, "lifecycle", arguments, observations)
        _ = remove_file(temporary_path)
        assert lifecycle.value.kind == RuntimeValueKind.Bool
        assert lifecycle.value.boolean


