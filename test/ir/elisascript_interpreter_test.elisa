@test
def interpreter_executes_python_dictionary_pop_with_default() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def present() -> i64:\n    mapping: mutable dict[sview, i64] = {\"first\": 1i64, \"second\": 2i64}\n    removed: i64 = mapping.pop(\"first\")\n    observe(mapping)\n    return removed\n\ndef fallback() -> i64:\n    mapping: mutable dict[sview, i64] = {\"first\": 1i64}\n    removed: i64 = mapping.pop(\"missing\", 42i64)\n    observe(mapping)\n    return removed\n\ndef missing() -> i64:\n    mapping: mutable dict[sview, i64] = {\"first\": 1i64}\n    return mapping.pop(\"missing\")\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        present: Execution = try interpret(module, "present", arguments, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert present.value.integer == 1
        assert observations.count == 1
        assert observations[0].value.kind == RuntimeValueKind.Map
        assert observations[0].value.map_count == 1u32
        assert storage[observations[0].value.map_start.usize()].text == "second"
        observations <- []
        storage <- []
        fallback: Execution = try interpret(module, "fallback", arguments, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert fallback.value.integer == 42
        assert observations.count == 1
        assert observations[0].value.map_count == 1u32
        assert storage[observations[0].value.map_start.usize()].text == "first"
        assert interpret_for_test(module, "missing", arguments, observations).value.kind == RuntimeValueKind.Void


