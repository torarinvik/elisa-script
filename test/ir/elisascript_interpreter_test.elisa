@test
def interpreter_writes_and_reads_text_through_elisa_file_io() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO:
        temporary_path: static u8& = "/tmp/elisascript-write-text-runtime-test.txt"
        _ = remove_file(temporary_path)
        source: static u8& = "def save() -> usize:\n    return write_text(path\"/tmp/elisascript-write-text-runtime-test.txt\", \"alpha beta\")\n\ndef load() -> sview:\n    return read_text(path\"/tmp/elisascript-write-text-runtime-test.txt\")\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        written: Execution = interpret_for_test(module, "save", arguments, observations)
        loaded: Execution = interpret_for_test(module, "load", arguments, observations)
        removed: bool = remove_file(temporary_path)
        assert written.value.integer == 10
        assert loaded.value.text == "alpha beta"
        assert removed


