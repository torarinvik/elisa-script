@test
def interpreter_touches_files_without_truncating_contents() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        temporary_path: static u8& = "/tmp/elisascript-touch-path-runtime-test.txt"
        source: static u8& = "def lifecycle() -> bool:\n    written: usize = write_text(path\"/tmp/elisascript-touch-path-runtime-test.txt\", \"keep\")\n    touched: bool = touch(path\"/tmp/elisascript-touch-path-runtime-test.txt\")\n    contents: sview = read_text(path\"/tmp/elisascript-touch-path-runtime-test.txt\")\n    regular: bool = is_file(path\"/tmp/elisascript-touch-path-runtime-test.txt\")\n    removed: bool = remove_path(path\"/tmp/elisascript-touch-path-runtime-test.txt\")\n    return written == 4u64 and touched and contents == \"keep\" and regular and removed\n\ndef creates_missing() -> bool:\n    touched: bool = touch(path\"/tmp/elisascript-touch-path-runtime-test.txt\")\n    existed: bool = path_exists(path\"/tmp/elisascript-touch-path-runtime-test.txt\")\n    removed: bool = remove_path(path\"/tmp/elisascript-touch-path-runtime-test.txt\")\n    return touched and existed and removed\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        _ = remove_file(temporary_path)
        lifecycle: Execution = interpret_for_test(module, "lifecycle", arguments, observations)
        creates_missing: Execution = interpret_for_test(module, "creates_missing", arguments, observations)
        _ = remove_file(temporary_path)
        assert lifecycle.value.boolean
        assert creates_missing.value.boolean


