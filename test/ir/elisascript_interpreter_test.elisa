        helper_return: Terminator = Terminator{kind: TerminatorKind.Return, operand: 3, operand_count: 1, span: position}
        helper_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 4, terminator: helper_return}
        helper: Function = Function{name: "helper", parameters: [helper_input], return_type: integer, effects: [], operand_pool: [1, 2, 1], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [helper_push, helper_perform, helper_add, helper_pop], blocks: [helper_block], entry: 1}

        caller_input: Parameter = Parameter{value: 1, type: integer, name: "input"}
        call: Instruction = Instruction{opcode: Opcode.Call, result: 2, result_type: integer, operand_start: 0, operand_count: 1, symbol: "helper", span: position}
        caller_add: Instruction = Instruction{opcode: Opcode.Add, result: 3, result_type: integer, operand_start: 1, operand_count: 2, span: position}
        caller_return: Terminator = Terminator{kind: TerminatorKind.Return, operand: 3, operand_count: 1, span: position}
        caller_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 2, terminator: caller_return}
        caller: Function = Function{name: "run", parameters: [caller_input], return_type: integer, effects: [], operand_pool: [1, 2, 1], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [call, caller_add], blocks: [caller_block], entry: 1}

        clause: HandlerClause = HandlerClause{effect_family: "Choice", effect_operation: "Value", function: "choose_clause"}
        handler: Handler = Handler{name: "choices", handles: ["Choice"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.MultiClone, clauses: [clause]}
        module: Module = Module{name: "multi-replay-call-stack", functions: [callback, helper, caller], handlers: [handler]}
        replay_handler: Handler = Handler{name: "choices", handles: ["Choice"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.MultiReplay, clauses: [clause]}
        replay_module: Module = Module{name: "multi-replay-call-stack", functions: [callback, helper, caller], handlers: [replay_handler]}
        arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 41}]
        observations: mutable darray[Observation] = []

        assert verify(module).count == 0
        assert interpret_for_test(module, "run", arguments, observations).value.integer == 205
        assert verify(replay_module).count == 0
        assert interpret_for_test(replay_module, "run", arguments, observations).value.integer == 205


