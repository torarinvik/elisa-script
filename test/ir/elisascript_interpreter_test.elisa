@test
def interpreter_expands_perl_regex_capture_references() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def positional() -> sview:\n    return replace_regex(\"id=42\", regex\"([a-z]+)=([0-9]+)\", \"\\1:\\2\")\n\ndef named() -> sview:\n    return replace_regex(\"id=42\", regex\"(?<key>[a-z]+)=([0-9]+)\", \"\\g<key>:\\g<2>:\\g<0>\")\n\ndef unknown() -> sview:\n    return replace_regex(\"id=42\", regex\"([a-z]+)=([0-9]+)\", \"\\9\")\n"
