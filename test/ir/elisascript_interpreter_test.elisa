        assert storage[stepped.value.array_start.usize() + 4].integer == 8

        descending: Execution = try interpret(module, "descending", arguments, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert descending.value.array_count == 5
        assert storage[descending.value.array_start.usize()].integer == 5
        assert storage[descending.value.array_start.usize() + 4].integer == 1


