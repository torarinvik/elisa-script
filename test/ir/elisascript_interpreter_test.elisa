@test
def interpreter_expands_native_globs_with_recursive_deterministic_traversal() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def prepare() -> bool:\n    base: bool = create_directory(path\"/tmp/elisascript-glob-runtime-test\")\n    nested: bool = create_directory(path\"/tmp/elisascript-glob-runtime-test/nested\")\n    deeper: bool = create_directory(path\"/tmp/elisascript-glob-runtime-test/nested/deeper\")\n    root_source: usize = write_text(path\"/tmp/elisascript-glob-runtime-test/root.elisa\", \"root\")\n    root_text: usize = write_text(path\"/tmp/elisascript-glob-runtime-test/root.txt\", \"text\")\n    hidden: usize = write_text(path\"/tmp/elisascript-glob-runtime-test/.secret.elisa\", \"hidden\")\n    one: usize = write_text(path\"/tmp/elisascript-glob-runtime-test/nested/one.elisa\", \"one\")\n    two: usize = write_text(path\"/tmp/elisascript-glob-runtime-test/nested/two.txt\", \"two\")\n    three: usize = write_text(path\"/tmp/elisascript-glob-runtime-test/nested/deeper/three.elisa\", \"three\")\n    return base and nested and deeper and root_source == 4u64 and root_text == 4u64 and hidden == 6u64 and one == 3u64 and two == 3u64 and three == 5u64\n\ndef star() -> bool:\n    return expand_glob(glob\"/tmp/elisascript-glob-runtime-test/*.elisa\") == [\"/tmp/elisascript-glob-runtime-test/root.elisa\"]\n\ndef question() -> bool:\n    return expand_glob(glob\"/tmp/elisascript-glob-runtime-test/nested/???.txt\") == [\"/tmp/elisascript-glob-runtime-test/nested/two.txt\"]\n\ndef class_match() -> bool:\n    return expand_glob(glob\"/tmp/elisascript-glob-runtime-test/nested/[ot]ne.elisa\") == [\"/tmp/elisascript-glob-runtime-test/nested/one.elisa\"]\n\ndef recursive() -> bool:\n    return expand_glob(glob\"/tmp/elisascript-glob-runtime-test/**/*.elisa\") == [\"/tmp/elisascript-glob-runtime-test/nested/deeper/three.elisa\", \"/tmp/elisascript-glob-runtime-test/nested/one.elisa\", \"/tmp/elisascript-glob-runtime-test/root.elisa\"]\n\ndef missing() -> bool:\n    return expand_glob(glob\"/tmp/elisascript-glob-runtime-test/nope/*.elisa\").count == 0u64\n\ndef cleanup() -> bool:\n    a: bool = remove_path(path\"/tmp/elisascript-glob-runtime-test/root.elisa\")\n    b: bool = remove_path(path\"/tmp/elisascript-glob-runtime-test/root.txt\")\n    c: bool = remove_path(path\"/tmp/elisascript-glob-runtime-test/.secret.elisa\")\n    d: bool = remove_path(path\"/tmp/elisascript-glob-runtime-test/nested/one.elisa\")\n    e: bool = remove_path(path\"/tmp/elisascript-glob-runtime-test/nested/two.txt\")\n    f: bool = remove_path(path\"/tmp/elisascript-glob-runtime-test/nested/deeper/three.elisa\")\n    g: bool = remove_directory(path\"/tmp/elisascript-glob-runtime-test/nested/deeper\")\n    h: bool = remove_directory(path\"/tmp/elisascript-glob-runtime-test/nested\")\n    i: bool = remove_directory(path\"/tmp/elisascript-glob-runtime-test\")\n    return a and b and c and d and e and f and g and h and i\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "prepare", arguments, observations).value.boolean
        assert interpret_for_test(module, "star", arguments, observations).value.boolean
        assert interpret_for_test(module, "question", arguments, observations).value.boolean
        assert interpret_for_test(module, "class_match", arguments, observations).value.boolean
        assert interpret_for_test(module, "recursive", arguments, observations).value.boolean
        assert interpret_for_test(module, "missing", arguments, observations).value.boolean
        assert interpret_for_test(module, "cleanup", arguments, observations).value.boolean


@test
def interpreter_executes_python_path_glob_and_rglob_methods() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO:
        source: static u8& = "def prepare() -> bool:\n    if is_directory(path\"/tmp/elisascript-path-glob-runtime-test\"):\n        remove_tree(path\"/tmp/elisascript-path-glob-runtime-test\")\n    base: bool = create_directory(path\"/tmp/elisascript-path-glob-runtime-test\")\n    nested: bool = create_directory(path\"/tmp/elisascript-path-glob-runtime-test/nested\")\n    root: usize = write_text(path\"/tmp/elisascript-path-glob-runtime-test/root.elisa\", \"r\")\n    child: usize = write_text(path\"/tmp/elisascript-path-glob-runtime-test/nested/child.elisa\", \"c\")\n    return base and nested and root == 1u64 and child == 1u64\n\ndef direct() -> darray[sview]:\n    return path\"/tmp/elisascript-path-glob-runtime-test\".glob(\"*.elisa\")\n\ndef recursive() -> darray[sview]:\n    return path\"/tmp/elisascript-path-glob-runtime-test\".rglob(\"*.elisa\")\n\ndef cleanup() -> bool:\n    a: bool = remove_path(path\"/tmp/elisascript-path-glob-runtime-test/root.elisa\")\n    b: bool = remove_path(path\"/tmp/elisascript-path-glob-runtime-test/nested/child.elisa\")\n    c: bool = remove_directory(path\"/tmp/elisascript-path-glob-runtime-test/nested\")\n    d: bool = remove_directory(path\"/tmp/elisascript-path-glob-runtime-test\")\n    return a and b and c and d\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "prepare", arguments, observations).value.boolean
        direct: Execution = interpret_for_test(module, "direct", arguments, observations)
        recursive: Execution = interpret_for_test(module, "recursive", arguments, observations)
        cleanup: Execution = interpret_for_test(module, "cleanup", arguments, observations)
        assert direct.value.kind == RuntimeValueKind.Array
        assert recursive.value.kind == RuntimeValueKind.Array
        assert direct.value.array_count == 1
        assert recursive.value.array_count == 2
        assert cleanup.value.boolean


