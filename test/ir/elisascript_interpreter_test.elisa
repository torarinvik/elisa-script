        callback_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 4, terminator: callback_return}
        callback: Function = Function{name: "choose_clause", parameters: [callback_parameter], return_type: integer, effects: [], operand_pool: [1, 3, 2, 4], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [seed, first_resume, second_resume, combine], blocks: [callback_block], entry: 1}

        input: Parameter = Parameter{value: 1, type: integer, name: "input"}
        push: Instruction = Instruction{opcode: Opcode.HandlerPush, result: 0, result_type: Type{kind: TypeKind.Void}, symbol: "choices", span: position}
        perform: Instruction = Instruction{opcode: Opcode.Perform, result: 2, result_type: integer, operand_start: 0, operand_count: 1, effect_family: "Choice", effect_operation: "Value", trace: TraceSite{id: 994, label: "multi-replay-frame"}, span: position}
        add_after_perform: Instruction = Instruction{opcode: Opcode.Add, result: 3, result_type: integer, operand_start: 1, operand_count: 2, span: position}
        pop: Instruction = Instruction{opcode: Opcode.HandlerPop, result: 0, result_type: Type{kind: TypeKind.Void}, symbol: "choices", span: position}
        run_return: Terminator = Terminator{kind: TerminatorKind.Return, operand: 3, operand_count: 1, span: position}
        run_block: Block = Block{id: 1, parameter_start: 0, parameter_count: 0, instruction_start: 0, instruction_count: 4, terminator: run_return}
        run: Function = Function{name: "run", parameters: [input], return_type: integer, effects: [], operand_pool: [1, 2, 1], edge_arg_pool: [], block_parameter_pool: [], instruction_pool: [push, perform, add_after_perform, pop], blocks: [run_block], entry: 1}

        clause: HandlerClause = HandlerClause{effect_family: "Choice", effect_operation: "Value", function: "choose_clause"}
        handler: Handler = Handler{name: "choices", handles: ["Choice"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.MultiClone, clauses: [clause]}
        module: Module = Module{name: "multi-replay-frame", functions: [callback, run], handlers: [handler]}
        replay_handler: Handler = Handler{name: "choices", handles: ["Choice"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.MultiReplay, clauses: [clause]}
        replay_module: Module = Module{name: "multi-replay-frame", functions: [callback, run], handlers: [replay_handler]}
        arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 41}]
        observations: mutable darray[Observation] = []

        assert verify(module).count == 0
        assert interpret_for_test(module, "run", arguments, observations).value.integer == 165
        assert verify(replay_module).count == 0
        assert interpret_for_test(replay_module, "run", arguments, observations).value.integer == 165


