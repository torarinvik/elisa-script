def typed_range_for_loops_execute_direction_inclusivity_and_stride() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def exclusive(limit: i64) -> i64:\n    total: mutable i64 = 0\n    for value in 0..<limit:\n        total += value\n    return total\n\ndef inclusive() -> i64:\n    total: mutable i64 = 0\n    for value in 0..=4:\n        total += value\n    return total\n\ndef descending() -> i64:\n    total: mutable i64 = 0\n    for value in 5..>0:\n        total += value\n    return total\n\ndef strided() -> i64:\n    total: mutable i64 = 0\n    for value in 0..<10..2:\n        total += value\n    return total\n\ndef python_stop(limit: i64) -> i64:\n    total: mutable i64 = 0\n    for value in range(limit):\n        total += value\n    return total\n\ndef python_bounds(limit: i64) -> i64:\n    total: mutable i64 = 0\n    for value in range(2i64, limit):\n        total += value\n    return total\n\ndef python_step() -> i64:\n    total: mutable i64 = 0\n    for value in range(0i64, 10i64, 2i64):\n        total += value\n    return total\n\ndef python_descending() -> i64:\n    total: mutable i64 = 0\n    for value in range(5i64, 0i64, -2i64):\n        total += value\n    return total\n\ndef controlled() -> i64:\n    total: mutable i64 = 0\n    for value in 0..<6:\n        if value == 2:\n            continue\n        if value == 5:\n            break\n        total += value\n    return total\n"
        module: Module = lower_program(source)
        limit: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 4}]
        no_arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "exclusive", limit, observations).value.integer == 6
        assert interpret_for_test(module, "inclusive", no_arguments, observations).value.integer == 10
        assert interpret_for_test(module, "descending", no_arguments, observations).value.integer == 15
        assert interpret_for_test(module, "strided", no_arguments, observations).value.integer == 20
        assert interpret_for_test(module, "python_stop", limit, observations).value.integer == 6
        assert interpret_for_test(module, "python_bounds", limit, observations).value.integer == 5
        assert interpret_for_test(module, "python_step", no_arguments, observations).value.integer == 20
        assert interpret_for_test(module, "python_descending", no_arguments, observations).value.integer == 9
        assert interpret_for_test(module, "controlled", no_arguments, observations).value.integer == 8


@test
def interpreter_executes_lazy_checked_indexing_for_arrays_text_and_maps() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def fallback() -> i64:\n    observe(77)\n    return 99i64\n\ndef array_safe(index: i64) -> i64:\n    values: darray[i64] = [10i64, 20i64]\n    return get values[index] else fallback()\n\ndef text_safe(index: i64) -> char:\n    value: sview = \"cat\"\n    return get value[index] else '?'\n\ndef map_safe(key: sview) -> i64:\n    values: dict[sview, i64] = {\"one\": 1i64}\n    return get values[key] else 99i64\n"
        module: Module = lower_program(source)
        no_arguments: darray[RuntimeValue] = []
        valid_index: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 1}]
        missing_index: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 8}]
        negative_index: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: -1}]
        text_index: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 1}]
        missing_text_index: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 7}]
        map_key: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "one"}]
        missing_key: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "two"}]
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "array_safe", valid_index, observations).value.integer == 20
        assert observations.count == 0
        assert interpret_for_test(module, "array_safe", missing_index, observations).value.integer == 99
        assert observations.count == 1
        assert observations[0].value.integer == 77
        observations <- []
        assert interpret_for_test(module, "array_safe", negative_index, observations).value.integer == 20
        assert observations.count == 0
        observations <- []
        assert interpret_for_test(module, "text_safe", text_index, observations).value.text == "a"
        assert interpret_for_test(module, "text_safe", missing_text_index, observations).value.text == "?"
        assert interpret_for_test(module, "map_safe", map_key, observations).value.integer == 1
        assert interpret_for_test(module, "map_safe", missing_key, observations).value.integer == 99


@test
def interpreter_recovers_fallible_calls_through_error_guard_state_machine() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def fallback() -> i64:\n    observe(55)\n    return 7i64\n\ndef parse_or(value: sview) -> i64:\n    return try parse_int(value) else fallback()\n"
        module: Module = lower_program(source)
        valid: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "41"}]
        invalid: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "not-a-number"}]
        observations: mutable darray[Observation] = []

        successful: Execution = interpret_for_test(module, "parse_or", valid, observations)
        assert successful.value.kind == RuntimeValueKind.Int
        assert successful.value.integer == 41
        assert observations.count == 0

        recovered: Execution = interpret_for_test(module, "parse_or", invalid, observations)
        assert recovered.value.kind == RuntimeValueKind.Int
        assert recovered.value.integer == 7
        assert observations.count == 1
        assert observations[0].value.integer == 55


@test
def interpreter_propagates_fallible_calls_through_terminating_recovery() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def parse_or(value: sview) -> i64:\n    number: i64 = try parse_int(value) else return 0i64\n    return number + 1i64\n"
        module: Module = lower_program(source)
        valid: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "41"}]
        invalid: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "not-a-number"}]
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "parse_or", valid, observations).value.integer == 42
        assert interpret_for_test(module, "parse_or", invalid, observations).value.integer == 0


@test
def interpreter_propagates_checked_index_failures_through_terminating_recovery() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def first_or(values: darray[i64]) -> i64:\n    first: i64 = get values[3i64] else return 0i64\n    return first\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = [runtime_array(0, 0)]
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "first_or", arguments, observations).value.integer == 0


@test
def interpreter_unwinds_inner_handlers_before_error_recovery_fallback() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def outer_clause(value: i64) -> void:\n    observe(1)\n\ndef inner_clause(value: i64) -> void:\n    observe(2)\n\ndef fallback() -> i64 can[Progress.Tick]:\n    signal Progress.Tick(9i64)\n    return 7i64\n\ndef parse_inner(value: sview) -> i64 error[ParseError]:\n    with handler inner:\n        return parse_int(value)\n\ndef parse_or(value: sview) -> i64:\n    with handler outer:\n        return try parse_inner(value) else fallback()\n"
        outer_clause: HandlerClause = HandlerClause{effect_family: "Progress", effect_operation: "Tick", function: "outer_clause"}
        inner_clause: HandlerClause = HandlerClause{effect_family: "Progress", effect_operation: "Tick", function: "inner_clause"}
        outer: Handler = Handler{name: "outer", handles: ["Progress"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear, clauses: [outer_clause]}
        inner: Handler = Handler{name: "inner", handles: ["Progress"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear, clauses: [inner_clause]}
        handlers: darray[Handler] = [outer, inner]
        module: Module = lower_program_with_handlers(source, handlers)
        invalid: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "bad"}]
        observations: mutable darray[Observation] = []
        execution: Execution = interpret_for_test(module, "parse_or", invalid, observations)

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 7
        assert observations.count == 1
        assert observations[0].value.integer == 1


@test
def scalar_match_executes_as_ordered_typed_control_flow() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def classify(value: i64) -> i64:\n    result: mutable i64 = 0\n    match value:\n        0:\n            result <- 10\n        1:\n            result <- 20\n        _:\n            result <- 30\n    return result\n\ndef pinned(target: i64, value: i64) -> i64:\n    match value:\n        ^target:\n            return 1\n        _:\n            return 0\n\ndef captured(value: i64) -> i64:\n    match value:\n        item:\n            return item + 1\n\ndef text_kind(value: sview) -> i64:\n    match value:\n        \"ok\":\n            return 1\n        _:\n            return 0\n\ndef bool_kind(value: bool) -> i64:\n    match value:\n        true:\n            return 1\n        false:\n            return 0\n\ndef guarded(value: i64) -> i64:\n    result: mutable i64 = 0\n    match value:\n        item if item > 5:\n            result <- item\n        _:\n            result <- -1\n    return result\n\ndef guard_falls_to_next(value: i64) -> i64:\n    match value:\n        7 if false:\n            return 1\n        7:\n            return 2\n        _:\n            return 3\n\ndef range_kind(value: i64) -> i64:\n    match value:\n        -5..<-1:\n            return 1\n        1..=3:\n            return 2\n        _:\n            return 0\n\ndef guarded_range(value: i64) -> i64:\n    match value:\n        1..=10 if value % 2 == 0:\n            return 1\n        _:\n            return 0\n\ndef float_range(value: f64) -> i64:\n    match value:\n        1.5..<2.5:\n            return 1\n        _:\n            return 0\n"
        module: Module = lower_program(source)
        observations: mutable darray[Observation] = []
        zero: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 0}]
        one: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 1}]
        other: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 7}]
        pin_yes: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 4}, RuntimeValue{kind: RuntimeValueKind.Int, integer: 4}]
        pin_no: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 4}, RuntimeValue{kind: RuntimeValueKind.Int, integer: 5}]
        text_ok: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "ok"}]
        truth: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: true}]
        negative_three: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: -3}]
        negative_one: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: -1}]
        three: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 3}]
        eight: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 8}]
        float_inside: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Float, decimal: 2.0}]
        float_high: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Float, decimal: 2.5}]

        assert interpret_for_test(module, "classify", zero, observations).value.integer == 10
        assert interpret_for_test(module, "classify", one, observations).value.integer == 20
        assert interpret_for_test(module, "classify", other, observations).value.integer == 30
        assert interpret_for_test(module, "pinned", pin_yes, observations).value.integer == 1
        assert interpret_for_test(module, "pinned", pin_no, observations).value.integer == 0
        assert interpret_for_test(module, "captured", other, observations).value.integer == 8
        assert interpret_for_test(module, "text_kind", text_ok, observations).value.integer == 1
        assert interpret_for_test(module, "bool_kind", truth, observations).value.integer == 1
        assert interpret_for_test(module, "guarded", other, observations).value.integer == 7
        assert interpret_for_test(module, "guarded", one, observations).value.integer == -1
        assert interpret_for_test(module, "guard_falls_to_next", other, observations).value.integer == 2
        assert interpret_for_test(module, "range_kind", negative_three, observations).value.integer == 1
        assert interpret_for_test(module, "range_kind", negative_one, observations).value.integer == 0
        assert interpret_for_test(module, "range_kind", three, observations).value.integer == 2
        assert interpret_for_test(module, "guarded_range", eight, observations).value.integer == 1
        assert interpret_for_test(module, "range_kind", other, observations).value.integer == 0
        assert interpret_for_test(module, "float_range", float_inside, observations).value.integer == 1
        assert interpret_for_test(module, "float_range", float_high, observations).value.integer == 0


@test
def interpreter_executes_typed_sleep_seconds_and_milliseconds() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def failing_sleep() -> i64 error[TimeError] can[Time.Sleep]:\n    sleep(-1i64)\n    return 0i64\n\ndef recovered_sleep() -> i64:\n    return try failing_sleep() else 7i64\n\ndef main() -> i64:\n    sleep(0.0)\n    sleep_seconds(0i64)\n    sleep_milliseconds(0u64)\n    sleep_ms(0u64)\n    return 42i64\n"
        module: Module = lower_program(source)
        observations: mutable darray[Observation] = []
        arguments: darray[RuntimeValue] = []
        execution: Execution = interpret_for_test(module, "main", arguments, observations)
        recovered: Execution = interpret_for_test(module, "recovered_sleep", arguments, observations)

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 42
        assert recovered.value.kind == RuntimeValueKind.Int
        assert recovered.value.integer == 7


@test
def interpreter_executes_secure_temporary_file_and_directory_creation() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def lifecycle() -> bool:\n    temporary: Path = temp_file(\"interpreter\")\n    directory: Path = mkdtemp(\"interpreter\")\n    file_present: bool = path_exists(temporary)\n    directory_present: bool = is_directory(directory)\n    written: usize = write_text(temporary, \"payload\")\n    contents: sview = read_text(temporary)\n    removed_file: bool = remove_path(temporary)\n    removed_directory: bool = remove_directory(directory)\n    return file_present and directory_present and written == 7u64 and contents == \"payload\" and removed_file and removed_directory\n\ndef invalid() -> Path error[FileIoError] can[File.Write]:\n    return temp_file(\"bad/name\")\n\ndef recovered() -> bool:\n    value: Path = try invalid() else path\"fallback\"\n    return value == path\"fallback\"\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        lifecycle: Execution = interpret_for_test(module, "lifecycle", arguments, observations)
        recovered: Execution = interpret_for_test(module, "recovered", arguments, observations)
        assert lifecycle.value.kind == RuntimeValueKind.Bool
        assert lifecycle.value.boolean
        assert recovered.value.kind == RuntimeValueKind.Bool
        assert recovered.value.boolean
