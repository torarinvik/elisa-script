@test
def interpreter_executes_named_and_default_call_arguments() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def combine(a: i64, b: i64 = 2, c: i64 = a + b) -> i64:\n    return a * 100 + b * 10 + c\n\ndef mark(value: i64) -> i64:\n    observe(value)\n    return value\n\ndef pair(a: i64, b: i64) -> i64:\n    return a * 10 + b\n\ndef named() -> i64:\n    return combine(c: 10, a: 1)\n\ndef defaults() -> i64:\n    return combine(3)\n\ndef mixed() -> i64:\n    return combine(4, c: 9)\n\ndef ordered() -> i64:\n    return pair(b: mark(2), a: mark(1))\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "named", arguments, observations).value.integer == 130
        assert interpret_for_test(module, "defaults", arguments, observations).value.integer == 325
        assert interpret_for_test(module, "mixed", arguments, observations).value.integer == 429
        assert interpret_for_test(module, "ordered", arguments, observations).value.integer == 12
        assert observations.count == 2
        assert observations[0].value.integer == 2
        assert observations[1].value.integer == 1


@test
def interpreter_executes_structural_array_equality() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def empty() -> bool:\n    left: darray[i64] = []\n    right: darray[i64] = []\n    return left == right\n\ndef equal_values() -> bool:\n    return [1, 2, 3] == [1, 2, 3]\n\ndef different_value() -> bool:\n    return [1, 2, 3] != [1, 4, 3]\n\ndef different_length() -> bool:\n    return [1, 2] != [1, 2, 3]\n\ndef sliced() -> bool:\n    values: darray[i64] = [0, 1, 2, 3]\n    return values[1:3] == [1, 2]\n\ndef concatenated() -> bool:\n    return [1] + [2, 3] == [1, 2, 3]\n\ndef aliases() -> bool:\n    original: darray[i64] = [1, 2]\n    updated: mutable darray[i64] = original\n    updated[0] <- 9\n    return original != updated\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "empty", arguments, observations).value.boolean
        assert interpret_for_test(module, "equal_values", arguments, observations).value.boolean
        assert interpret_for_test(module, "different_value", arguments, observations).value.boolean
        assert interpret_for_test(module, "different_length", arguments, observations).value.boolean
        assert interpret_for_test(module, "sliced", arguments, observations).value.boolean
        assert interpret_for_test(module, "concatenated", arguments, observations).value.boolean
        assert interpret_for_test(module, "aliases", arguments, observations).value.boolean


