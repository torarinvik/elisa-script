@test
def interpreter_executes_python_pop_value_and_rebinds_array() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def build() -> i64:\n    values: mutable darray[i64] = [10, 20, 30]\n    removed: i64 = values.pop()\n    observe(values)\n    return removed * 100 + values[1]\n\ndef indexed() -> i64:\n    values: mutable darray[i64] = [10, 20, 30]\n    removed: i64 = values.pop(1)\n    observe(values)\n    return removed * 100 + values[1]\n\ndef negative() -> i64:\n    values: mutable darray[i64] = [10, 20, 30]\n    removed: i64 = values.pop(-2)\n    return removed\n\ndef out_of_range(index: i64) -> i64:\n    values: mutable darray[i64] = [10, 20, 30]\n    return values.pop(index)\n\ndef empty() -> i64:\n    values: mutable darray[i64] = []\n    return values.pop()\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        execution: Execution = interpret_for_test(module, "build", arguments, observations)
        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 3020
        assert observations.count == 1
        assert observations[0].value.kind == RuntimeValueKind.Array
        assert observations[0].value.array_count == 2

        observations <- []
        indexed_execution: Execution = interpret_for_test(module, "indexed", arguments, observations)
        assert indexed_execution.value.integer == 2030
        assert observations.count == 1
        assert observations[0].value.array_count == 2
        assert interpret_for_test(module, "negative", arguments, observations).value.integer == 20
