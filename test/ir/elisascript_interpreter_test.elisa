@test
def interpreter_executes_typed_text_boundary_predicates() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def prefix() -> bool:\n    return starts_with(\"elisascript\", \"elisa\") and not starts_with(\"elisa\", \"script\")\n\ndef suffix() -> bool:\n    return ends_with(\"elisascript\", \"script\") and not ends_with(\"elisa\", \"script\")\n\ndef empty() -> bool:\n    return starts_with(\"value\", \"\") and ends_with(\"value\", \"\")\n\ndef mismatch() -> bool:\n    return starts_with(\"value\", \"val\")\n"
        module: Module = lower_program(source)
