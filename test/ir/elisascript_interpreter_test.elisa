@test
def interpreter_executes_dynamic_python_range_steps_and_reports_zero() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def loop(step: i64) -> i64 error[RangeStepZero]:\n    total: mutable i64 = 0i64\n    for value in range(0i64, 10i64, step):\n        total += value\n    return total\n\ndef descending(step: i64) -> i64:\n    total: mutable i64 = 0i64\n    for value in range(10i64, 0i64, step):\n        total += value\n    return total\n\ndef projected(step: i64) -> darray[i64]:\n    return [value for value in range(0i64, 10i64, step)]\n\ndef folded(step: i64) -> i64:\n    return sum(range(0i64, 10i64, step))\n\ndef counted(step: i64) -> usize:\n    return count value in range(0i64, 10i64, step) where value % 2i64 == 0i64\n\ndef recovered(step: i64) -> i64:\n    return try loop(step) else 99i64\n\ndef mapped(step: i64) -> dict[i64, i64]:\n    return {value: value * 2i64 for value in range(0i64, 10i64, step)}\n\ndef all_match(step: i64) -> bool:\n    return all value in range(0i64, 10i64, step) where value < 10i64\n"
        module: Module = lower_program(source)
        positive: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 3}]
        negative: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: -3}]
        zero: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 0}]
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "loop", positive, observations).value.integer == 18
        assert interpret_for_test(module, "loop", negative, observations).value.integer == 0
        assert interpret_for_test(module, "descending", negative, observations).value.integer == 22
        projected: Execution = interpret_for_test(module, "projected", positive, observations)
        assert projected.value.kind == RuntimeValueKind.Array
        assert projected.value.array_count == 4
        assert observations.count == 0
        assert interpret_for_test(module, "folded", positive, observations).value.integer == 18
        assert interpret_for_test(module, "counted", positive, observations).value.integer == 2
        assert interpret_for_test(module, "loop", zero, observations).value.kind == RuntimeValueKind.Void
        assert interpret_for_test(module, "recovered", zero, observations).value.integer == 99
        assert interpret_for_test(module, "mapped", positive, observations).value.map_count == 4
        assert interpret_for_test(module, "all_match", positive, observations).value.boolean


