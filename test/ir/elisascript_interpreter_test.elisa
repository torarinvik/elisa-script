@test
def source_signal_payload_reaches_typed_dynamic_clause() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def record(value: i64) -> void:\n    observe(value)\n\ndef emit(value: i64) -> void can[Progress.Tick]:\n    signal Progress.Tick(value + 1)\n\ndef run() -> i64:\n    with handler recorder:\n        emit(41)\n    return 7\n"
        clause: HandlerClause = HandlerClause{effect_family: "Progress", effect_operation: "Tick", function: "record"}
        recorder: Handler = Handler{name: "recorder", handles: ["Progress"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear, clauses: [clause]}
        handlers: darray[Handler] = [recorder]
        module: Module = lower_program_with_handlers(source, handlers)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "run", arguments, observations).value.integer == 7
        assert observations.count == 1
        assert observations[0].value.integer == 42


