        assert interpret_for_test(module, "repeated", arguments, observations).value.boolean
        assert interpret_for_test(module, "suffix_backtracks", arguments, observations).value.boolean
        assert not interpret_for_test(module, "nested_miss", arguments, observations).value.boolean
        assert interpret_for_test(module, "replacement", arguments, observations).value.text == "animal animal"


@test
def interpreter_expands_unambiguous_regex_capture_groups() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def fields() -> sview:\n    return replace_regex(\"id=42; id=7\", regex\"([a-z]+)=([0-9]+)\", \"$1:$2\")\n\ndef alternative() -> sview:\n    return replace_regex(\"cat dog\", regex\"(cat|dog)\", \"<$1>\")\n\ndef named() -> sview:\n    return replace_regex(\"elisa\", regex\"(?<word>[a-z]+)\", \"<$1>\")\n\ndef ambiguous() -> sview:\n    return replace_regex(\"abb\", regex\"^(a|ab)b$\", \"[$1]\")\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "fields", arguments, observations).value.text == "id:42; id:7"
        assert interpret_for_test(module, "alternative", arguments, observations).value.text == "<cat> <dog>"
        assert interpret_for_test(module, "named", arguments, observations).value.text == "<elisa>"
        # The matcher can prove the full match but not which branch supplied
        # the capture; the replacement therefore preserves `$1` literally.
        assert interpret_for_test(module, "ambiguous", arguments, observations).value.text == "[$1]"


@test
def interpreter_replaces_regex_matches_left_to_right() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def numbers() -> sview:\n    return replace_regex(\"id=42; id=7\", regex\"[0-9]+\", \"<n>\")\n\ndef alternatives() -> sview:\n    return replace_regex(\"cat dog\", regex\"cat|dog\", \"animal\")\n\ndef anchors() -> sview:\n    return replace_regex(\"abc\", regex\"^\", \">\") + replace_regex(\"abc\", regex\"$\", \"!\")\n\ndef delete() -> sview:\n    return replace_regex(\"banana\", regex\"na\", \"\")\n\ndef whole_match_interpolation() -> sview:\n    return replace_regex(\"cat dog\", regex\"cat|dog\", \"<$0>\")\n\ndef awk_whole_match_interpolation() -> sview:\n    return replace_regex(\"cat dog\", regex\"cat|dog\", \"<&>\")\n\ndef escaped_replacement_tokens() -> sview:\n    return replace_regex(\"cat\", regex\"cat\", \"\\& $$\")\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "numbers", arguments, observations).value.text == "id=<n>; id=<n>"
        assert interpret_for_test(module, "alternatives", arguments, observations).value.text == "animal animal"
        assert interpret_for_test(module, "anchors", arguments, observations).value.text == ">abcabc!"
        assert interpret_for_test(module, "delete", arguments, observations).value.text == "ba"
        assert interpret_for_test(module, "whole_match_interpolation", arguments, observations).value.text == "<cat> <dog>"
        assert interpret_for_test(module, "awk_whole_match_interpolation", arguments, observations).value.text == "<cat> <dog>"
        assert interpret_for_test(module, "escaped_replacement_tokens", arguments, observations).value.text == "& $"


