include "../../src/ir/ir.elisa"

using Ast
using EsIr


def lower_program(source: u8&) -> Module:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        tokens: darray[Lexer::Token] = frontend_tokenize("interpreter.elisascript", source)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        assert file.errors.count == 0
        lowered: LowerResult = lower_file(file, "interpreter")
        assert lowered.issues.count == 0
        assert verify(lowered.module).count == 0
        return lowered.module


def lower_program_with_handlers(source: u8&, handlers: darray[Handler]&) -> Module:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        tokens: darray[Lexer::Token] = frontend_tokenize("interpreter.elisascript", source)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        assert file.errors.count == 0
        lowered: LowerResult = lower_file_with_handlers(file, "interpreter", handlers)
        assert lowered.issues.count == 0
        assert verify(lowered.module).count == 0
        return lowered.module


def interpret_for_test(module: Module&, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&) -> Execution:
    can Memory.Allocate, Abort.Panic:
        storage: mutable darray[RuntimeValue] = []
        return try interpret(module, entry, arguments, observations, storage) else Execution{value: RuntimeValue{kind: RuntimeValueKind.Void}, steps: 0}


@test
def interpreter_executes_direct_calls_arithmetic_and_observations() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def inc(value: i64) -> i64:\n    return value + 1\n\ndef main() -> i64:\n    answer: i64 = inc(41)\n    observe(answer)\n    return answer\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        execution: Execution = interpret_for_test(module, "main", arguments, observations)

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 42
        assert observations.count == 1
        assert observations[0].value.integer == 42
        assert observations[0].trace != 0


@test
def interpreter_executes_exact_suffixed_integer_types() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def byte_sum() -> u8:\n    return 1u8 + 2u8\n\ndef signed_min() -> i8:\n    return -128i8\n\ndef unsigned_max() -> u8:\n    return 255u8\n\ndef count_is_three() -> bool:\n    return split(\"a,b,c\", \",\").count == 3u64\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "byte_sum", arguments, observations).value.integer == 3
        assert interpret_for_test(module, "signed_min", arguments, observations).value.integer == -128
        assert interpret_for_test(module, "unsigned_max", arguments, observations).value.integer == 255
        assert interpret_for_test(module, "count_is_three", arguments, observations).value.boolean


@test
def interpreter_reports_checked_narrow_integer_overflow() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def add_overflow() -> u8:\n    return 255u8 + 1u8\n\ndef subtract_overflow() -> u8:\n    return 0u8 - 1u8\n\ndef multiply_overflow() -> i8:\n    return 20i8 * 10i8\n\ndef shift_overflow() -> u8:\n    return 128u8 << 1u8\n\ndef negate(value: i8) -> i8:\n    return -value\n\ndef negate_i64(value: i64) -> i64:\n    return -value\n\ndef add_boundary() -> u8:\n    return 254u8 + 1u8\n\ndef complement() -> u8:\n    return ~1u8\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        signed_min: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: -128}]
        signed_i64_min: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: -9223372036854775807 - 1}]
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "add_overflow", arguments, observations).value.kind == RuntimeValueKind.Void
        assert interpret_for_test(module, "subtract_overflow", arguments, observations).value.kind == RuntimeValueKind.Void
        assert interpret_for_test(module, "multiply_overflow", arguments, observations).value.kind == RuntimeValueKind.Void
        assert interpret_for_test(module, "shift_overflow", arguments, observations).value.kind == RuntimeValueKind.Void
        assert interpret_for_test(module, "negate", signed_min, observations).value.kind == RuntimeValueKind.Void
        assert interpret_for_test(module, "negate_i64", signed_i64_min, observations).value.kind == RuntimeValueKind.Void
        assert interpret_for_test(module, "add_boundary", arguments, observations).value.integer == 255
        assert interpret_for_test(module, "complement", arguments, observations).value.integer == 254


@test
def interpreter_executes_nominal_typed_literal_values() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def keep(value: Path) -> Path:\n    return value\n\ndef path_value() -> bool:\n    return keep(path\"src/main.elisa\") == path\"src/main.elisa\"\n\ndef glob_value() -> bool:\n    return glob\"src/*.elisa\" != glob\"test/*.elisa\"\n\ndef regex_value() -> bool:\n    return regex\"[a-z]+\" == regex\"[a-z]+\"\n\ndef executable() -> bool:\n    return exe\"elisac\" == exe\"elisac\"\n\ndef endpoint() -> bool:\n    return url\"https://example.com\" == url\"https://example.com\"\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "path_value", arguments, observations).value.boolean
        assert interpret_for_test(module, "glob_value", arguments, observations).value.boolean
        assert interpret_for_test(module, "regex_value", arguments, observations).value.boolean
        assert interpret_for_test(module, "executable", arguments, observations).value.boolean
        assert interpret_for_test(module, "endpoint", arguments, observations).value.boolean


@test
def interpreter_executes_dynamic_typed_constructors() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def dynamic_path(value: sview) -> bool:\n    return path(value) == path\"/dev/null\"\n\ndef dynamic_glob(value: sview) -> bool:\n    return glob(value) == glob\"src/*.elisa\"\n\ndef dynamic_regex(value: sview) -> bool:\n    return matches(\"item:42\", regex(value))\n\ndef dynamic_url(value: sview) -> bool:\n    return url(value) == url\"https://example.com\"\n\ndef invalid_executable(value: sview) -> Executable error[ProcessError]:\n    return executable(value)\n"
        module: Module = lower_program(source)
        path_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "/dev/null"}]
        glob_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "src/*.elisa"}]
        regex_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "^item:[0-9]+$"}]
        url_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "https://example.com"}]
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "dynamic_path", path_arguments, observations).value.boolean
        assert interpret_for_test(module, "dynamic_glob", glob_arguments, observations).value.boolean
        assert interpret_for_test(module, "dynamic_regex", regex_arguments, observations).value.boolean
        assert interpret_for_test(module, "dynamic_url", url_arguments, observations).value.boolean
        invalid_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: ""}]
        assert interpret_for_test(module, "invalid_executable", invalid_arguments, observations).value.kind == RuntimeValueKind.Void


@test
def interpreter_executes_typed_regex_search_machine() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def literal() -> bool:\n    return matches(\"prefix elisascript suffix\", regex\"elisascript\")\n\ndef anchors() -> bool:\n    return matches(\"elisascript\", regex\"^elisa.*script$\")\n\ndef plus() -> bool:\n    return matches(\"xxabbbcxx\", regex\"ab+c\")\n\ndef optional() -> bool:\n    return matches(\"color\", regex\"colou?r\")\n\ndef escaped() -> bool:\n    return matches(\"a.b\", regex\"a\\.b\")\n\ndef miss() -> bool:\n    return matches(\"elisa\", regex\"^script$\")\n\ndef cannot_skip_atom() -> bool:\n    return matches(\"ac\", regex\"abc\")\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "literal", arguments, observations).value.boolean
        assert interpret_for_test(module, "anchors", arguments, observations).value.boolean
        assert interpret_for_test(module, "plus", arguments, observations).value.boolean
        assert interpret_for_test(module, "optional", arguments, observations).value.boolean
        assert interpret_for_test(module, "escaped", arguments, observations).value.boolean
        assert not interpret_for_test(module, "miss", arguments, observations).value.boolean
        assert not interpret_for_test(module, "cannot_skip_atom", arguments, observations).value.boolean


@test
def regex_machine_executes_ascii_classes_ranges_and_shorthands() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def ranges() -> bool:\n    return matches(\"Elisa_42\", regex\"^[A-Za-z_][A-Za-z0-9_]*$\")\n\ndef negated() -> bool:\n    return matches(\"script.elisa\", regex\"^[^.]+[.]elisa$\")\n\ndef digit_space_word() -> bool:\n    return matches(\"42 elisa_script\", regex\"^\\d+\\s\\w+$\")\n\ndef class_shorthand() -> bool:\n    return matches(\"a7z\", regex\"^[a-z][\\d][a-z]$\")\n\ndef rejects_digit() -> bool:\n    return matches(\"abc4\", regex\"^[^0-9]+$\")\n\ndef rejects_symbol() -> bool:\n    return matches(\"abc-xyz\", regex\"^\\w+$\")\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "ranges", arguments, observations).value.boolean
        assert interpret_for_test(module, "negated", arguments, observations).value.boolean
        assert interpret_for_test(module, "digit_space_word", arguments, observations).value.boolean
        assert interpret_for_test(module, "class_shorthand", arguments, observations).value.boolean
        assert not interpret_for_test(module, "rejects_digit", arguments, observations).value.boolean
        assert not interpret_for_test(module, "rejects_symbol", arguments, observations).value.boolean


@test
def regex_machine_executes_top_level_alternation_with_branch_local_anchors() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def either() -> bool:\n    return matches(\"xxdogxx\", regex\"cat|dog\")\n\ndef backtracks() -> bool:\n    return matches(\"abbbc\", regex\"ab+d|ab+c\")\n\ndef branch_anchors() -> bool:\n    return matches(\"xxdog\", regex\"^cat|dog$\")\n\ndef escaped_pipe() -> bool:\n    return matches(\"a|b\", regex\"^a\\|b$\")\n\ndef class_pipe() -> bool:\n    return matches(\"|\", regex\"^[|]$\")\n\ndef miss() -> bool:\n    return matches(\"bird\", regex\"^cat$|^dog$\")\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "either", arguments, observations).value.boolean
        assert interpret_for_test(module, "backtracks", arguments, observations).value.boolean
        assert interpret_for_test(module, "branch_anchors", arguments, observations).value.boolean
        assert interpret_for_test(module, "escaped_pipe", arguments, observations).value.boolean
        assert interpret_for_test(module, "class_pipe", arguments, observations).value.boolean
        assert not interpret_for_test(module, "miss", arguments, observations).value.boolean


@test
def regex_machine_executes_nested_groups_and_group_quantifiers() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def grouped() -> bool:\n    return matches(\"dog\", regex\"(cat|dog)\")\n\ndef nested() -> bool:\n    return matches(\"abbc\", regex\"a(b+|c)\")\n\ndef repeated() -> bool:\n    return matches(\"ababab\", regex\"(ab)+\")\n\ndef suffix_backtracks() -> bool:\n    return matches(\"abb\", regex\"^(a|ab)b$\")\n\ndef nested_miss() -> bool:\n    return matches(\"abx\", regex\"^a(b+|c)$\")\n\ndef replacement() -> sview:\n    return replace_regex(\"cat dog\", regex\"(cat|dog)\", \"animal\")\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "grouped", arguments, observations).value.boolean
        assert interpret_for_test(module, "nested", arguments, observations).value.boolean
        assert interpret_for_test(module, "repeated", arguments, observations).value.boolean
        assert interpret_for_test(module, "suffix_backtracks", arguments, observations).value.boolean
        assert not interpret_for_test(module, "nested_miss", arguments, observations).value.boolean
        assert interpret_for_test(module, "replacement", arguments, observations).value.text == "animal animal"


@test
def interpreter_replaces_regex_matches_left_to_right() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def numbers() -> sview:\n    return replace_regex(\"id=42; id=7\", regex\"[0-9]+\", \"<n>\")\n\ndef alternatives() -> sview:\n    return replace_regex(\"cat dog\", regex\"cat|dog\", \"animal\")\n\ndef anchors() -> sview:\n    return replace_regex(\"abc\", regex\"^\", \">\") + replace_regex(\"abc\", regex\"$\", \"!\")\n\ndef delete() -> sview:\n    return replace_regex(\"banana\", regex\"na\", \"\")\n\ndef whole_match_interpolation() -> sview:\n    return replace_regex(\"cat dog\", regex\"cat|dog\", \"<$0>\")\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "numbers", arguments, observations).value.text == "id=<n>; id=<n>"
        assert interpret_for_test(module, "alternatives", arguments, observations).value.text == "animal animal"
        assert interpret_for_test(module, "anchors", arguments, observations).value.text == ">abcabc!"
        assert interpret_for_test(module, "delete", arguments, observations).value.text == "ba"
        assert interpret_for_test(module, "whole_match_interpolation", arguments, observations).value.text == "<cat> <dog>"


@test
def interpreter_splits_text_with_typed_regex_separators() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def fields() -> bool:\n    return split_regex(\"alpha,1;beta,2\", regex\"[,;]\") == [\"alpha\", \"1\", \"beta\", \"2\"]\n\ndef empty_fields() -> bool:\n    return split_regex(\",a,,\", regex\",\") == [\"\", \"a\", \"\", \"\"]\n\ndef grouped() -> bool:\n    return split_regex(\"left<->middle<->right\", regex\"<->\") == [\"left\", \"middle\", \"right\"]\n\ndef zero_width() -> bool:\n    return split_regex(\"abc\", regex\"^\") == [\"\", \"abc\"]\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "fields", arguments, observations).value.boolean
        assert interpret_for_test(module, "empty_fields", arguments, observations).value.boolean
        assert interpret_for_test(module, "grouped", arguments, observations).value.boolean
        assert interpret_for_test(module, "zero_width", arguments, observations).value.boolean


@test
def interpreter_finds_non_overlapping_regex_matches() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def numbers() -> bool:\n    return find_regex(\"id=42; id=7\", regex\"[0-9]+\") == [\"42\", \"7\"]\n\ndef alternatives() -> bool:\n    return find_regex(\"cat dog cat\", regex\"cat|dog\") == [\"cat\", \"dog\", \"cat\"]\n\ndef zero_width() -> bool:\n    return find_regex(\"abc\", regex\"^\") == [\"\"]\n\ndef missing() -> bool:\n    return find_regex(\"abc\", regex\"z+\").count == 0u64\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "numbers", arguments, observations).value.boolean
        assert interpret_for_test(module, "alternatives", arguments, observations).value.boolean
        assert interpret_for_test(module, "zero_width", arguments, observations).value.boolean
        assert interpret_for_test(module, "missing", arguments, observations).value.boolean


@test
def interpreter_splits_text_into_typed_fields() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def ordinary() -> bool:\n    fields: darray[sview] = split(\"alpha,beta,gamma\", \",\")\n    return fields == [\"alpha\", \"beta\", \"gamma\"]\n\ndef empty_fields() -> bool:\n    fields: darray[sview] = split(\",a,,\", \",\")\n    return fields == [\"\", \"a\", \"\", \"\"]\n\ndef multi_byte() -> bool:\n    fields: darray[sview] = split(\"one--two--three\", \"--\")\n    return fields == [\"one\", \"two\", \"three\"]\n\ndef bytes() -> bool:\n    fields: darray[sview] = split(\"abc\", \"\")\n    return fields == [\"a\", \"b\", \"c\"]\n\ndef empty_input() -> bool:\n    fields: darray[sview] = split(\"\", \",\")\n    return fields == [\"\"]\n\ndef empty_bytes() -> darray[sview]:\n    return split(\"\", \"\")\n\ndef iterate() -> sview:\n    result: mutable sview = \"\"\n    for field in split(\"a:b:c\", \":\"):\n        result <- result + field\n    return result\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "ordinary", arguments, observations).value.boolean
        assert interpret_for_test(module, "empty_fields", arguments, observations).value.boolean
        assert interpret_for_test(module, "multi_byte", arguments, observations).value.boolean
        assert interpret_for_test(module, "bytes", arguments, observations).value.boolean
        assert interpret_for_test(module, "empty_input", arguments, observations).value.boolean
        assert interpret_for_test(module, "empty_bytes", arguments, observations).value.array_count == 0
        assert interpret_for_test(module, "iterate", arguments, observations).value.text == "abc"


@test
def interpreter_joins_typed_text_fields() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def ordinary() -> sview:\n    return join([\"alpha\", \"beta\", \"gamma\"], \",\")\n\ndef empty() -> sview:\n    values: darray[sview] = []\n    return join(values, \",\")\n\ndef singleton() -> sview:\n    return join([\"only\"], \"--\")\n\ndef empty_separator() -> sview:\n    return join([\"a\", \"b\", \"c\"], \"\")\n\ndef preserves_empty() -> sview:\n    return join([\"\", \"a\", \"\"], \":\")\n\ndef round_trip() -> sview:\n    return join(split(\"one::two::three\", \"::\"), \"::\")\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "ordinary", arguments, observations).value.text == "alpha,beta,gamma"
        assert interpret_for_test(module, "empty", arguments, observations).value.text == ""
        assert interpret_for_test(module, "singleton", arguments, observations).value.text == "only"
        assert interpret_for_test(module, "empty_separator", arguments, observations).value.text == "abc"
        assert interpret_for_test(module, "preserves_empty", arguments, observations).value.text == ":a:"
        assert interpret_for_test(module, "round_trip", arguments, observations).value.text == "one::two::three"


@test
def interpreter_executes_typed_dictionary_lookup_membership_equality_and_updates() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def lookup() -> i64:\n    values: dict[sview, i64] = {\"one\": 1, \"two\": 2}\n    return values[\"one\"] + values[\"two\"]\n\ndef membership() -> bool:\n    values: dict[sview, i64] = {\"one\": 1, \"two\": 2}\n    return \"one\" in values and not (\"missing\" in values) and values.count == 2u64\n\ndef equal() -> bool:\n    left: dict[sview, i64] = {\"one\": 1, \"two\": 2}\n    right: dict[sview, i64] = {\"two\": 2, \"one\": 1}\n    return left == right\n\ndef update() -> i64:\n    values: mutable dict[sview, i64] = {\"one\": 1}\n    values[\"one\"] <- 4\n    values[\"two\"] <- 5\n    return values[\"one\"] + values[\"two\"]\n\ndef iterate() -> i64:\n    values: dict[sview, i64] = {\"one\": 1, \"two\": 2}\n    total: mutable i64 = 0\n    for key in values:\n        total += values[key]\n    return total\n\ndef missing() -> i64:\n    values: dict[sview, i64] = {\"one\": 1}\n    return values[\"missing\"]\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "lookup", arguments, observations).value.integer == 3
        assert interpret_for_test(module, "membership", arguments, observations).value.boolean
        assert interpret_for_test(module, "equal", arguments, observations).value.boolean
        assert interpret_for_test(module, "update", arguments, observations).value.integer == 9
        assert interpret_for_test(module, "iterate", arguments, observations).value.integer == 3
        assert interpret_for_test(module, "missing", arguments, observations).value.kind == RuntimeValueKind.Void


