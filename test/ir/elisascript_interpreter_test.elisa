include "../../src/ir/ir.elisa"

using Ast
using EsIr


def lower_program(source: u8&) -> Module:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        tokens: darray[Lexer::Token] = frontend_tokenize("interpreter.elisascript", source)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        assert file.errors.count == 0
        lowered: LowerResult = lower_file(file, "interpreter")
        assert lowered.issues.count == 0
        assert verify(lowered.module).count == 0
        return lowered.module


def interpret_for_test(module: Module&, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&) -> Execution:
    can Memory.Allocate, Abort.Panic:
        storage: mutable darray[RuntimeValue] = []
        return try interpret(module, entry, arguments, observations, storage) else Execution{value: RuntimeValue{kind: RuntimeValueKind.Void}, steps: 0}


@test
def interpreter_executes_direct_calls_arithmetic_and_observations() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def inc(value: i64) -> i64:\n    return value + 1\n\ndef main() -> i64:\n    answer: i64 = inc(41)\n    observe(answer)\n    return answer\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        execution: Execution = interpret_for_test(module, "main", arguments, observations)

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 42
        assert observations.count == 1
        assert observations[0].value.integer == 42
        assert observations[0].trace != 0


@test
def interpreter_selects_typed_control_flow_branch() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def choose(condition: bool) -> i64:\n    if condition:\n        return 7\n    return 9\n"
        module: Module = lower_program(source)
        true_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: true}]
        false_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: false}]
        observations: mutable darray[Observation] = []
        selected: Execution = interpret_for_test(module, "choose", true_arguments, observations)
        alternative: Execution = interpret_for_test(module, "choose", false_arguments, observations)

        assert selected.value.integer == 7
        assert alternative.value.integer == 9


@test
def interpreter_executes_pass_in_structured_states() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def pass_through(limit: i64) -> i64:\n    total: mutable i64 = 0\n    pass\n    for value in 0..<limit:\n        if value % 2 == 0:\n            pass\n        total += value\n    return total\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 5}]
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "pass_through", arguments, observations).value.integer == 10


@test
def mutable_array_iteration_preserves_updates_across_loop_edges() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def normal() -> i64:\n    values: mutable darray[i64] = [1, 2, 3]\n    for mutable value in values:\n        value *= 2\n    return values[0] + values[1] + values[2]\n\ndef continued() -> i64:\n    values: mutable darray[i64] = [1, 2, 3]\n    for mutable value in values:\n        value += 10\n        if value == 12:\n            continue\n        value += 1\n    return values[0] + values[1] + values[2]\n\ndef broken() -> i64:\n    values: mutable darray[i64] = [1, 2, 3]\n    for mutable value in values:\n        value += 10\n        if value == 12:\n            break\n    return values[0] + values[1] + values[2]\n\ndef branched(change: bool) -> i64:\n    values: mutable darray[i64] = [1, 2]\n    for mutable value in values:\n        if change:\n            value += 5\n    return values[0] + values[1]\n\ndef matched() -> i64:\n    values: mutable darray[i64] = [1, 2]\n    for mutable value in values:\n        match value:\n            1:\n                value += 10\n            _:\n                pass\n    return values[0] + values[1]\n\ndef nested_while() -> i64:\n    values: mutable darray[i64] = [1, 2]\n    for mutable value in values:\n        running: mutable bool = true\n        while running:\n            value += 1\n            running <- false\n    return values[0] + values[1]\n\ndef nested() -> i64:\n    values: mutable darray[i64] = [0, 0]\n    for mutable outer in values:\n        outer += 1\n        for mutable inner in values:\n            inner += 1\n    return values[0] + values[1]\n"
        module: Module = lower_program(source)
        no_arguments: darray[RuntimeValue] = []
        unchanged: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: false}]
        changed: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: true}]
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "normal", no_arguments, observations).value.integer == 12
        assert interpret_for_test(module, "continued", no_arguments, observations).value.integer == 38
        assert interpret_for_test(module, "broken", no_arguments, observations).value.integer == 26
        assert interpret_for_test(module, "branched", unchanged, observations).value.integer == 3
        assert interpret_for_test(module, "branched", changed, observations).value.integer == 13
        assert interpret_for_test(module, "matched", no_arguments, observations).value.integer == 13
        assert interpret_for_test(module, "nested_while", no_arguments, observations).value.integer == 5
        assert interpret_for_test(module, "nested", no_arguments, observations).value.integer == 6


@test
def interpreter_executes_loop_carried_ssa_values() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def once(running: mutable bool) -> i64:\n    count: mutable i64 = 0\n    while running:\n        count <- count + 1\n        running <- false\n    return count\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: true}]
        observations: mutable darray[Observation] = []
        execution: Execution = interpret_for_test(module, "once", arguments, observations)

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 1


@test
def interpreter_executes_complete_core_scalar_operator_family() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def remainder() -> i64:\n    return -17 % 5\n\ndef float_value() -> f64:\n    return -(1.5e1 / 2.0)\n\ndef not_value() -> bool:\n    return not false\n\ndef greater_equal() -> bool:\n    return 4 >= 4\n\ndef unequal() -> bool:\n    return \"a\" != \"b\"\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        remainder: Execution = interpret_for_test(module, "remainder", arguments, observations)
        float_value: Execution = interpret_for_test(module, "float_value", arguments, observations)
        not_value: Execution = interpret_for_test(module, "not_value", arguments, observations)
        greater_equal: Execution = interpret_for_test(module, "greater_equal", arguments, observations)
        unequal: Execution = interpret_for_test(module, "unequal", arguments, observations)

        assert remainder.value.kind == RuntimeValueKind.Int
        assert remainder.value.integer == -2
        assert float_value.value.kind == RuntimeValueKind.Float
        assert float_value.value.decimal == -7.5
        assert not_value.value.boolean
        assert greater_equal.value.boolean
        assert unequal.value.boolean


@test
def interpreter_executes_integer_bitwise_and_shift_family() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def bit_and() -> i64:\n    return 13 & 11\n\ndef bit_or() -> i64:\n    return 13 | 2\n\ndef bit_xor() -> i64:\n    return 13 ^ 10\n\ndef shift_left() -> i64:\n    return 3 << 4\n\ndef shift_right() -> i64:\n    return -64 >> 3\n\ndef invalid_shift() -> i64:\n    return 1 << 64\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "bit_and", arguments, observations).value.integer == 9
        assert interpret_for_test(module, "bit_or", arguments, observations).value.integer == 15
        assert interpret_for_test(module, "bit_xor", arguments, observations).value.integer == 7
        assert interpret_for_test(module, "shift_left", arguments, observations).value.integer == 48
        assert interpret_for_test(module, "shift_right", arguments, observations).value.integer == -8
        assert interpret_for_test(module, "invalid_shift", arguments, observations).value.kind == RuntimeValueKind.Void


@test
def complement_and_compound_mutation_execute_through_ssa() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def complement() -> i64:\n    return ~13\n\ndef compounds() -> i64:\n    value: mutable i64 = 3\n    value <<= 2\n    value |= 2\n    value ^= 3\n    value &= 7\n    value += 4\n    value -= 1\n    value *= 3\n    value /= 4\n    value %= 4\n    return value\n\ndef branch(change: bool) -> i64:\n    value: mutable i64 = 1\n    if change:\n        value += 4\n    return value\n\ndef loop(run: bool) -> i64:\n    value: mutable i64 = 0\n    while run:\n        value += 3\n        break\n    return value\n"
        module: Module = lower_program(source)
        no_arguments: darray[RuntimeValue] = []
        true_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: true}]
        false_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: false}]
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "complement", no_arguments, observations).value.integer == -14
        assert interpret_for_test(module, "compounds", no_arguments, observations).value.integer == 2
        assert interpret_for_test(module, "branch", true_arguments, observations).value.integer == 5
        assert interpret_for_test(module, "branch", false_arguments, observations).value.integer == 1
        assert interpret_for_test(module, "loop", true_arguments, observations).value.integer == 3
        assert interpret_for_test(module, "loop", false_arguments, observations).value.integer == 0


@test
def logical_and_or_short_circuit_observable_calls() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def mark(value: bool) -> bool:\n    observe(value)\n    return value\n\ndef skip_and() -> bool:\n    return false and mark(true)\n\ndef skip_or() -> bool:\n    return true or mark(false)\n\ndef run_and() -> bool:\n    return true and mark(true)\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        skipped_and_observations: mutable darray[Observation] = []
        skipped_or_observations: mutable darray[Observation] = []
        evaluated_observations: mutable darray[Observation] = []
        skipped_and: Execution = interpret_for_test(module, "skip_and", arguments, skipped_and_observations)
        skipped_or: Execution = interpret_for_test(module, "skip_or", arguments, skipped_or_observations)
        evaluated: Execution = interpret_for_test(module, "run_and", arguments, evaluated_observations)

        assert not skipped_and.value.boolean
        assert skipped_or.value.boolean
        assert evaluated.value.boolean
        assert skipped_and_observations.count == 0
        assert skipped_or_observations.count == 0
        assert evaluated_observations.count == 1


@test
def conditional_expression_executes_only_selected_value_path() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def mark(value: i64) -> i64:\n    observe(value)\n    return value\n\ndef choose(flag: bool) -> i64:\n    return mark(7) if flag else mark(9)\n"
        module: Module = lower_program(source)
        true_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: true}]
        false_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: false}]
        selected_observations: mutable darray[Observation] = []
        alternative_observations: mutable darray[Observation] = []
        selected: Execution = interpret_for_test(module, "choose", true_arguments, selected_observations)
        alternative: Execution = interpret_for_test(module, "choose", false_arguments, alternative_observations)

        assert selected.value.integer == 7
        assert alternative.value.integer == 9
        assert selected_observations.count == 1
        assert alternative_observations.count == 1
        assert selected_observations[0].value.integer == 7
        assert alternative_observations[0].value.integer == 9


@test
def elisa_value_blocks_lower_scoped_statements_and_tail_values() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def choose(flag: bool) -> i64:\n    return if flag:\n        local: i64 = 40\n        observe(local)\n        local + 2\n    else:\n        local: i64 = 6\n        observe(local)\n        local * 2\n"
        module: Module = lower_program(source)
        true_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: true}]
        false_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: false}]
        selected_observations: mutable darray[Observation] = []
        alternative_observations: mutable darray[Observation] = []
        selected: Execution = interpret_for_test(module, "choose", true_arguments, selected_observations)
        alternative: Execution = interpret_for_test(module, "choose", false_arguments, alternative_observations)

        assert selected.value.integer == 42
        assert alternative.value.integer == 12
        assert selected_observations.count == 1
        assert alternative_observations.count == 1
        assert selected_observations[0].value.integer == 40
        assert alternative_observations[0].value.integer == 6


@test
def immutable_typed_arrays_support_indexing_and_count() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def select() -> i64:\n    observe([10, 20, 30].count)\n    return [10, 20, 30][1]\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        execution: Execution = interpret_for_test(module, "select", arguments, observations)

        assert execution.value.kind == RuntimeValueKind.Int
        assert execution.value.integer == 20
        assert observations.count == 1
        assert observations[0].value.kind == RuntimeValueKind.Int
        assert observations[0].value.integer == 3


@test
def typed_text_supports_byte_indexing_count_and_character_iteration() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def text_count(value: sview) -> usize:\n    return value.count\n\ndef second(value: sview) -> char:\n    return value[1]\n\ndef count_a(value: sview) -> i64:\n    total: mutable i64 = 0\n    for character in value:\n        if character == 'a':\n            total += 1\n    return total\n\ndef controlled(value: sview) -> i64:\n    total: mutable i64 = 0\n    for character in value:\n        if character == 'b':\n            continue\n        if character == 'd':\n            break\n        total += 1\n    return total\n"
        module: Module = lower_program(source)
        banana: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "banana"}]
        sequence: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "abcdz"}]
        empty: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: ""}]
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "text_count", banana, observations).value.integer == 6
        second: Execution = interpret_for_test(module, "second", banana, observations)
        assert second.value.kind == RuntimeValueKind.Text
        assert second.value.text == "a"
        assert interpret_for_test(module, "count_a", banana, observations).value.integer == 3
        assert interpret_for_test(module, "controlled", sequence, observations).value.integer == 2
        assert interpret_for_test(module, "text_count", empty, observations).value.integer == 0
        assert interpret_for_test(module, "count_a", empty, observations).value.integer == 0


@test
def typed_array_and_text_concatenation_owns_composed_values() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def text(left: sview, right: sview) -> sview:\n    return left + \"-\" + right\n\ndef text_empty(value: sview) -> sview:\n    return \"\" + value + \"\"\n\ndef empty_text() -> sview:\n    return \"\" + \"\"\n\ndef fourth() -> i64:\n    empty: darray[i64] = []\n    values: darray[i64] = [1, 2] + empty + [3, 4]\n    return values[3]\n\ndef empty_array_count() -> usize:\n    empty: darray[i64] = []\n    return (empty + empty).count\n\ndef total() -> i64:\n    values: darray[i64] = [1, 2] + [3, 4]\n    sum: mutable i64 = 0\n    for value in values:\n        sum += value\n    return sum\n"
        module: Module = lower_program(source)
        words: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "alpha"}, RuntimeValue{kind: RuntimeValueKind.Text, text: "beta"}]
        word: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "stable"}]
        no_arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "text", words, observations).value.text == "alpha-beta"
        assert interpret_for_test(module, "text_empty", word, observations).value.text == "stable"
        assert interpret_for_test(module, "empty_text", no_arguments, observations).value.text == ""
        assert interpret_for_test(module, "fourth", no_arguments, observations).value.integer == 4
        assert interpret_for_test(module, "empty_array_count", no_arguments, observations).value.integer == 0
        assert interpret_for_test(module, "total", no_arguments, observations).value.integer == 10


@test
def array_push_and_extend_execute_through_branch_and_loop_ssa_states() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def selected_count(include_more: bool) -> usize:\n    values: mutable darray[i64] = []\n    values.push(1)\n    if include_more:\n        values.extend([2, 3])\n    return values.count\n\ndef accumulated(limit: i64) -> i64:\n    values: mutable darray[i64] = []\n    for value in 0..<limit:\n        values.push(value)\n    total: mutable i64 = 0\n    for value in values:\n        total += value\n    return total\n"
        module: Module = lower_program(source)
        selected_short: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: false}]
        selected_long: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: true}]
        zero: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 0}]
        five: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 5}]
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "selected_count", selected_short, observations).value.integer == 1
        assert interpret_for_test(module, "selected_count", selected_long, observations).value.integer == 3
        assert interpret_for_test(module, "accumulated", zero, observations).value.integer == 0
        assert interpret_for_test(module, "accumulated", five, observations).value.integer == 10


@test
def indexed_array_update_executes_owned_copy_and_bounds_semantics() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def selected(change: bool) -> i64:\n    values: mutable darray[i64] = [1, 2, 3]\n    if change:\n        values[1] <- 9\n    return values[1]\n\ndef looped() -> i64:\n    values: mutable darray[i64] = [4, 5, 6]\n    for index in 0..<3:\n        values[index] += index\n    return values[0] + values[1] + values[2]\n\ndef compounds() -> i64:\n    values: mutable darray[i64] = [3]\n    values[0] <<= 2\n    values[0] |= 2\n    values[0] ^= 3\n    values[0] &= 7\n    values[0] += 4\n    values[0] -= 1\n    values[0] *= 3\n    values[0] /= 4\n    values[0] %= 4\n    return values[0]\n\ndef isolated() -> i64:\n    original: darray[i64] = [1, 2]\n    updated: mutable darray[i64] = original\n    updated[0] <- 9\n    return original[0] * 10 + updated[0]\n\ndef invalid(index: i64) -> i64:\n    values: mutable darray[i64] = [1, 2]\n    values[index] += 9\n    return values[0]\n"
        module: Module = lower_program(source)
        unchanged: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: false}]
        changed: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: true}]
        no_arguments: darray[RuntimeValue] = []
        negative: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: -1}]
        high: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 2}]
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "selected", unchanged, observations).value.integer == 2
        assert interpret_for_test(module, "selected", changed, observations).value.integer == 9
        assert interpret_for_test(module, "looped", no_arguments, observations).value.integer == 18
        assert interpret_for_test(module, "compounds", no_arguments, observations).value.integer == 2
        assert interpret_for_test(module, "isolated", no_arguments, observations).value.integer == 19
        assert interpret_for_test(module, "invalid", negative, observations).value.kind == RuntimeValueKind.Void
        assert interpret_for_test(module, "invalid", high, observations).value.kind == RuntimeValueKind.Void


@test
def typed_array_and_text_slices_support_closed_and_open_bounds() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def middle_text(value: sview) -> sview:\n    return value[1:4]\n\ndef prefix(value: sview) -> sview:\n    return value[:2]\n\ndef suffix(value: sview) -> sview:\n    return value[2:]\n\ndef whole(value: sview) -> sview:\n    return value[:]\n\ndef empty_count(value: sview) -> usize:\n    return value[1:1].count\n\ndef middle_array_sum() -> i64:\n    values: darray[i64] = [1, 2, 3, 4]\n    middle: darray[i64] = values[1:3]\n    total: mutable i64 = 0\n    for value in middle:\n        total += value\n    return total\n\ndef invalid_slice(value: sview) -> sview:\n    return value[4:2]\n"
        module: Module = lower_program(source)
        text: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "abcdef"}]
        no_arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "middle_text", text, observations).value.text == "bcd"
        assert interpret_for_test(module, "prefix", text, observations).value.text == "ab"
        assert interpret_for_test(module, "suffix", text, observations).value.text == "cdef"
        assert interpret_for_test(module, "whole", text, observations).value.text == "abcdef"
        assert interpret_for_test(module, "empty_count", text, observations).value.integer == 0
        assert interpret_for_test(module, "middle_array_sum", no_arguments, observations).value.integer == 5
        assert interpret_for_test(module, "invalid_slice", text, observations).value.kind == RuntimeValueKind.Void


@test
def typed_membership_searches_arrays_and_text_and_composes_with_short_circuiting() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def array_has(value: i64) -> bool:\n    return value in [1, 2, 3]\n\ndef array_lacks(value: i64) -> bool:\n    return value not in [1, 2, 3]\n\ndef character_in(character: char, text: sview) -> bool:\n    return character in text\n\ndef substring_in(part: sview, text: sview) -> bool:\n    return part in text\n\ndef empty_in(text: sview) -> bool:\n    return \"\" in text\n\ndef mark() -> bool:\n    observe(99)\n    return true\n\ndef guarded(value: i64) -> bool:\n    return (value in [1, 2, 3]) and mark()\n"
        module: Module = lower_program(source)
        two: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 2}]
        nine: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 9}]
        char_and_text: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "n"}, RuntimeValue{kind: RuntimeValueKind.Text, text: "banana"}]
        substring_and_text: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "ana"}, RuntimeValue{kind: RuntimeValueKind.Text, text: "banana"}]
        absent_and_text: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "xyz"}, RuntimeValue{kind: RuntimeValueKind.Text, text: "banana"}]
        text: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "banana"}]
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "array_has", two, observations).value.boolean
        assert not interpret_for_test(module, "array_has", nine, observations).value.boolean
        assert interpret_for_test(module, "array_lacks", nine, observations).value.boolean
        assert interpret_for_test(module, "character_in", char_and_text, observations).value.boolean
        assert interpret_for_test(module, "substring_in", substring_and_text, observations).value.boolean
        assert not interpret_for_test(module, "substring_in", absent_and_text, observations).value.boolean
        assert interpret_for_test(module, "empty_in", text, observations).value.boolean
        assert not interpret_for_test(module, "guarded", nine, observations).value.boolean
        assert observations.count == 0
        assert interpret_for_test(module, "guarded", two, observations).value.boolean
        assert observations.count == 1


@test
def numeric_range_membership_executes_ordered_bound_and_alignment_states() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def exclusive(value: i64, limit: i64) -> bool:\n    return value in 0..<limit\n\ndef inclusive(value: i64) -> bool:\n    return value in -2..=2\n\ndef descending(value: i64) -> bool:\n    return value in 5..>0\n\ndef outside(value: i64) -> bool:\n    return value not in 1..<4\n\ndef decimal(value: f64) -> bool:\n    return value in 1.5..<2.5\n\ndef strided(value: i64) -> bool:\n    return value in 0..<10..2\n\ndef strided_inclusive(value: i64) -> bool:\n    return value in 1..=9..4\n\ndef strided_descending(value: i64) -> bool:\n    return value in 9..>0..4\n\ndef strided_outside(value: i64) -> bool:\n    return value not in 0..<10..2\n"
        module: Module = lower_program(source)
        exclusive_inside: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 3}, RuntimeValue{kind: RuntimeValueKind.Int, integer: 4}]
        exclusive_high: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 4}, RuntimeValue{kind: RuntimeValueKind.Int, integer: 4}]
        exclusive_low: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: -1}, RuntimeValue{kind: RuntimeValueKind.Int, integer: 4}]
        negative_two: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: -2}]
        two: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 2}]
        three: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 3}]
        five: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 5}]
        one: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 1}]
        zero: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 0}]
        six: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 6}]
        ten: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 10}]
        four: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 4}]
        decimal_inside: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Float, decimal: 2.0}]
        decimal_high: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Float, decimal: 2.5}]
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "exclusive", exclusive_inside, observations).value.boolean
        assert not interpret_for_test(module, "exclusive", exclusive_high, observations).value.boolean
        assert not interpret_for_test(module, "exclusive", exclusive_low, observations).value.boolean
        assert interpret_for_test(module, "inclusive", negative_two, observations).value.boolean
        assert interpret_for_test(module, "inclusive", two, observations).value.boolean
        assert not interpret_for_test(module, "inclusive", three, observations).value.boolean
        assert interpret_for_test(module, "descending", five, observations).value.boolean
        assert interpret_for_test(module, "descending", one, observations).value.boolean
        assert not interpret_for_test(module, "descending", zero, observations).value.boolean
        assert not interpret_for_test(module, "descending", six, observations).value.boolean
        assert interpret_for_test(module, "outside", four, observations).value.boolean
        assert not interpret_for_test(module, "outside", two, observations).value.boolean
        assert interpret_for_test(module, "decimal", decimal_inside, observations).value.boolean
        assert not interpret_for_test(module, "decimal", decimal_high, observations).value.boolean
        assert interpret_for_test(module, "strided", four, observations).value.boolean
        assert not interpret_for_test(module, "strided", three, observations).value.boolean
        assert interpret_for_test(module, "strided", zero, observations).value.boolean
        assert interpret_for_test(module, "strided", six, observations).value.boolean
        assert not interpret_for_test(module, "strided", ten, observations).value.boolean
        assert interpret_for_test(module, "strided_inclusive", one, observations).value.boolean
        assert interpret_for_test(module, "strided_inclusive", five, observations).value.boolean
        assert not interpret_for_test(module, "strided_inclusive", two, observations).value.boolean
        assert interpret_for_test(module, "strided_descending", five, observations).value.boolean
        assert interpret_for_test(module, "strided_descending", one, observations).value.boolean
        assert not interpret_for_test(module, "strided_descending", three, observations).value.boolean
        assert interpret_for_test(module, "strided_outside", three, observations).value.boolean
        assert not interpret_for_test(module, "strided_outside", four, observations).value.boolean


@test
def array_signatures_and_contextual_empty_literals_execute() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def build() -> darray[i64]:\n    return []\n\ndef count_built() -> usize:\n    return build().count\n\ndef count_argument(values: darray[i64]) -> usize:\n    return values.count\n\ndef empty_argument() -> usize:\n    return count_argument([])\n\ndef populated_argument() -> usize:\n    return count_argument([4, 5])\n\ndef reassigned() -> usize:\n    values: mutable darray[i64] = [1]\n    values <- []\n    return values.count\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "count_built", arguments, observations).value.integer == 0
        assert interpret_for_test(module, "empty_argument", arguments, observations).value.integer == 0
        assert interpret_for_test(module, "populated_argument", arguments, observations).value.integer == 2
        assert interpret_for_test(module, "reassigned", arguments, observations).value.integer == 0


@test
def typed_array_for_loops_execute_with_break_continue_and_mutation() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def sum_all() -> i64:\n    total: mutable i64 = 0\n    for value in [1, 2, 3, 4]:\n        total += value\n    return total\n\ndef skip_two() -> i64:\n    total: mutable i64 = 0\n    for value in [1, 2, 3, 4]:\n        if value == 2:\n            continue\n        total += value\n    return total\n\ndef stop_at_three() -> i64:\n    total: mutable i64 = 0\n    for value in [1, 2, 3, 4]:\n        if value == 3:\n            break\n        total += value\n    return total\n\ndef empty_sum() -> i64:\n    total: mutable i64 = 0\n    values: darray[i64] = []\n    for value in values:\n        total += value\n    return total\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "sum_all", arguments, observations).value.integer == 10
        assert interpret_for_test(module, "skip_two", arguments, observations).value.integer == 8
        assert interpret_for_test(module, "stop_at_three", arguments, observations).value.integer == 3
        assert interpret_for_test(module, "empty_sum", arguments, observations).value.integer == 0


@test
def typed_range_for_loops_execute_direction_inclusivity_and_stride() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def exclusive(limit: i64) -> i64:\n    total: mutable i64 = 0\n    for value in 0..<limit:\n        total += value\n    return total\n\ndef inclusive() -> i64:\n    total: mutable i64 = 0\n    for value in 0..=4:\n        total += value\n    return total\n\ndef descending() -> i64:\n    total: mutable i64 = 0\n    for value in 5..>0:\n        total += value\n    return total\n\ndef strided() -> i64:\n    total: mutable i64 = 0\n    for value in 0..<10..2:\n        total += value\n    return total\n\ndef controlled() -> i64:\n    total: mutable i64 = 0\n    for value in 0..<6:\n        if value == 2:\n            continue\n        if value == 5:\n            break\n        total += value\n    return total\n"
        module: Module = lower_program(source)
        limit: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 4}]
        no_arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "exclusive", limit, observations).value.integer == 6
        assert interpret_for_test(module, "inclusive", no_arguments, observations).value.integer == 10
        assert interpret_for_test(module, "descending", no_arguments, observations).value.integer == 15
        assert interpret_for_test(module, "strided", no_arguments, observations).value.integer == 20
        assert interpret_for_test(module, "controlled", no_arguments, observations).value.integer == 8


@test
def scalar_match_executes_as_ordered_typed_control_flow() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def classify(value: i64) -> i64:\n    result: mutable i64 = 0\n    match value:\n        0:\n            result <- 10\n        1:\n            result <- 20\n        _:\n            result <- 30\n    return result\n\ndef pinned(target: i64, value: i64) -> i64:\n    match value:\n        ^target:\n            return 1\n        _:\n            return 0\n\ndef captured(value: i64) -> i64:\n    match value:\n        item:\n            return item + 1\n\ndef text_kind(value: sview) -> i64:\n    match value:\n        \"ok\":\n            return 1\n        _:\n            return 0\n\ndef bool_kind(value: bool) -> i64:\n    match value:\n        true:\n            return 1\n        false:\n            return 0\n\ndef guarded(value: i64) -> i64:\n    result: mutable i64 = 0\n    match value:\n        item if item > 5:\n            result <- item\n        _:\n            result <- -1\n    return result\n\ndef guard_falls_to_next(value: i64) -> i64:\n    match value:\n        7 if false:\n            return 1\n        7:\n            return 2\n        _:\n            return 3\n\ndef range_kind(value: i64) -> i64:\n    match value:\n        -5..<-1:\n            return 1\n        1..=3:\n            return 2\n        _:\n            return 0\n\ndef guarded_range(value: i64) -> i64:\n    match value:\n        1..=10 if value % 2 == 0:\n            return 1\n        _:\n            return 0\n\ndef float_range(value: f64) -> i64:\n    match value:\n        1.5..<2.5:\n            return 1\n        _:\n            return 0\n"
        module: Module = lower_program(source)
        observations: mutable darray[Observation] = []
        zero: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 0}]
        one: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 1}]
        other: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 7}]
        pin_yes: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 4}, RuntimeValue{kind: RuntimeValueKind.Int, integer: 4}]
        pin_no: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 4}, RuntimeValue{kind: RuntimeValueKind.Int, integer: 5}]
        text_ok: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "ok"}]
        truth: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: true}]
        negative_three: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: -3}]
        negative_one: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: -1}]
        three: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 3}]
        eight: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 8}]
        float_inside: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Float, decimal: 2.0}]
        float_high: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Float, decimal: 2.5}]

        assert interpret_for_test(module, "classify", zero, observations).value.integer == 10
        assert interpret_for_test(module, "classify", one, observations).value.integer == 20
        assert interpret_for_test(module, "classify", other, observations).value.integer == 30
        assert interpret_for_test(module, "pinned", pin_yes, observations).value.integer == 1
        assert interpret_for_test(module, "pinned", pin_no, observations).value.integer == 0
        assert interpret_for_test(module, "captured", other, observations).value.integer == 8
        assert interpret_for_test(module, "text_kind", text_ok, observations).value.integer == 1
        assert interpret_for_test(module, "bool_kind", truth, observations).value.integer == 1
        assert interpret_for_test(module, "guarded", other, observations).value.integer == 7
        assert interpret_for_test(module, "guarded", one, observations).value.integer == -1
        assert interpret_for_test(module, "guard_falls_to_next", other, observations).value.integer == 2
        assert interpret_for_test(module, "range_kind", negative_three, observations).value.integer == 1
        assert interpret_for_test(module, "range_kind", negative_one, observations).value.integer == 0
        assert interpret_for_test(module, "range_kind", three, observations).value.integer == 2
        assert interpret_for_test(module, "guarded_range", eight, observations).value.integer == 1
        assert interpret_for_test(module, "range_kind", other, observations).value.integer == 0
        assert interpret_for_test(module, "float_range", float_inside, observations).value.integer == 1
        assert interpret_for_test(module, "float_range", float_high, observations).value.integer == 0
