@test
def interpreter_executes_python_array_sort_method() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def integers() -> darray[i64]:\n    values: mutable darray[i64] = [3i64, 1i64, 2i64, 1i64]\n    values.sort()\n    return values\n\ndef texts() -> darray[sview]:\n    values: mutable darray[sview] = [\"b\", \"aa\", \"a\"]\n    values.sort()\n    return values\n\ndef empty() -> darray[i64]:\n    values: mutable darray[i64] = []\n    values.sort()\n    return values\n\ndef in_loop() -> darray[i64]:\n    values: mutable darray[i64] = [3i64, 1i64, 2i64]\n    running: mutable bool = true\n    while running:\n        values.sort()\n        running <- false\n    return values\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        integers: Execution = try interpret(module, "integers", arguments, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert integers.value.array_count == 4u32
        assert storage[integers.value.array_start.usize()].integer == 1
        assert storage[integers.value.array_start.usize() + 1].integer == 1
        assert storage[integers.value.array_start.usize() + 2].integer == 2
        assert storage[integers.value.array_start.usize() + 3].integer == 3
        storage <- []
        texts: Execution = try interpret(module, "texts", arguments, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert storage[texts.value.array_start.usize()].text == "a"
        assert storage[texts.value.array_start.usize() + 1].text == "aa"
        assert storage[texts.value.array_start.usize() + 2].text == "b"
        assert interpret_for_test(module, "empty", arguments, observations).value.array_count == 0u32
        looped: Execution = try interpret(module, "in_loop", arguments, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert looped.value.array_count == 3u32
        assert storage[looped.value.array_start.usize()].integer == 1
        assert storage[looped.value.array_start.usize() + 1].integer == 2
        assert storage[looped.value.array_start.usize() + 2].integer == 3


@test
def interpreter_executes_python_sorted_without_mutating_input() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def preserve() -> i64:\n    values: mutable darray[i64] = [3i64, 1i64, 2i64]\n    ordered: darray[i64] = sorted(values)\n    return values[0] * 100 + ordered[0]\n\ndef texts() -> darray[sview]:\n    values: darray[sview] = [\"b\", \"aa\", \"a\"]\n    return sorted(values)\n\ndef sort_reverse() -> i64:\n    values: mutable darray[i64] = [1i64, 3i64, 2i64]\n    values.sort(reverse: true)\n    return values[0] * 100 + values[1] * 10 + values[2]\n\ndef sort_dynamic(reverse: bool) -> i64:\n    values: mutable darray[i64] = [1i64, 3i64, 2i64]\n    values.sort(reverse: reverse)\n    return values[0] * 100 + values[1] * 10 + values[2]\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "preserve", arguments, observations).value.integer == 301
        storage: mutable darray[RuntimeValue] = []
        result: Execution = try interpret(module, "texts", arguments, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert result.value.kind == RuntimeValueKind.Array
        assert result.value.array_count == 3u32
        assert storage[result.value.array_start.usize()].text == "a"
        assert storage[result.value.array_start.usize() + 1].text == "aa"
        assert storage[result.value.array_start.usize() + 2].text == "b"
        assert interpret_for_test(module, "sort_reverse", arguments, observations).value.integer == 321
        descending_flag: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: true}]
        ascending_flag: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: false}]
        assert interpret_for_test(module, "sort_dynamic", descending_flag, observations).value.integer == 321
        assert interpret_for_test(module, "sort_dynamic", ascending_flag, observations).value.integer == 123


