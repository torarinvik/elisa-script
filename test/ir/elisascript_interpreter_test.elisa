@test
def interpreter_executes_python_sum_product_any_all_folds() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def totals() -> i64:\n    values: darray[i64] = [2i64, 3i64, 4i64]\n    return sum(values) * 10 + product(values)\n\ndef started() -> i64:\n    values: darray[i64] = [2i64, 3i64, 4i64]\n    return sum(values, 10i64)\n\ndef product_started() -> i64:\n    values: darray[i64] = [2i64, 3i64, 4i64]\n    return product(values, start: 10i64)\n\ndef empty_sum() -> i64:\n    values: darray[i64] = []\n    return sum(values)\n\ndef empty_product() -> i64:\n    values: darray[i64] = []\n    return product(values)\n\ndef any_some() -> bool:\n    values: darray[bool] = [false, true, false]\n    return any(values)\n\ndef all_some() -> bool:\n    values: darray[bool] = [true, true]\n    return all(values)\n\ndef any_empty() -> bool:\n    values: darray[bool] = []\n    return any(values)\n\ndef all_empty() -> bool:\n    values: darray[bool] = []\n    return all(values)\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "totals", arguments, observations).value.integer == 114
        assert interpret_for_test(module, "started", arguments, observations).value.integer == 19
        assert interpret_for_test(module, "product_started", arguments, observations).value.integer == 240
        assert interpret_for_test(module, "empty_sum", arguments, observations).value.integer == 0
        assert interpret_for_test(module, "empty_product", arguments, observations).value.integer == 1
        assert interpret_for_test(module, "any_some", arguments, observations).value.boolean
        assert interpret_for_test(module, "all_some", arguments, observations).value.boolean
        assert not interpret_for_test(module, "any_empty", arguments, observations).value.boolean
        assert interpret_for_test(module, "all_empty", arguments, observations).value.boolean


