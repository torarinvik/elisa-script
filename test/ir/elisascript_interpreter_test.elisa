@test
def interpreter_splits_text_into_typed_fields() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def ordinary() -> bool:\n    fields: darray[sview] = split(\"alpha,beta,gamma\", \",\")\n    return fields == [\"alpha\", \"beta\", \"gamma\"]\n\ndef empty_fields() -> bool:\n    fields: darray[sview] = split(\",a,,\", \",\")\n    return fields == [\"\", \"a\", \"\", \"\"]\n\ndef multi_byte() -> bool:\n    fields: darray[sview] = split(\"one--two--three\", \"--\")\n    return fields == [\"one\", \"two\", \"three\"]\n\ndef bytes() -> bool:\n    fields: darray[sview] = split(\"abc\", \"\")\n    return fields == [\"a\", \"b\", \"c\"]\n\ndef empty_input() -> bool:\n    fields: darray[sview] = split(\"\", \",\")\n    return fields == [\"\"]\n\ndef empty_bytes() -> darray[sview]:\n    return split(\"\", \"\")\n\ndef iterate() -> sview:\n    result: mutable sview = \"\"\n    for field in split(\"a:b:c\", \":\"):\n        result <- result + field\n    return result\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "ordinary", arguments, observations).value.boolean
        assert interpret_for_test(module, "empty_fields", arguments, observations).value.boolean
        assert interpret_for_test(module, "multi_byte", arguments, observations).value.boolean
        assert interpret_for_test(module, "bytes", arguments, observations).value.boolean
        assert interpret_for_test(module, "empty_input", arguments, observations).value.boolean
        assert interpret_for_test(module, "empty_bytes", arguments, observations).value.array_count == 0
        assert interpret_for_test(module, "iterate", arguments, observations).value.text == "abc"


@test
def interpreter_joins_typed_text_fields() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def ordinary() -> sview:\n    return join([\"alpha\", \"beta\", \"gamma\"], \",\")\n\ndef empty() -> sview:\n    values: darray[sview] = []\n    return join(values, \",\")\n\ndef singleton() -> sview:\n    return join([\"only\"], \"--\")\n\ndef empty_separator() -> sview:\n    return join([\"a\", \"b\", \"c\"], \"\")\n\ndef preserves_empty() -> sview:\n    return join([\"\", \"a\", \"\"], \":\")\n\ndef round_trip() -> sview:\n    return join(split(\"one::two::three\", \"::\"), \"::\")\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "ordinary", arguments, observations).value.text == "alpha,beta,gamma"
        assert interpret_for_test(module, "empty", arguments, observations).value.text == ""
        assert interpret_for_test(module, "singleton", arguments, observations).value.text == "only"
        assert interpret_for_test(module, "empty_separator", arguments, observations).value.text == "abc"
        assert interpret_for_test(module, "preserves_empty", arguments, observations).value.text == ":a:"
        assert interpret_for_test(module, "round_trip", arguments, observations).value.text == "one::two::three"


@test
def interpreter_joins_typed_text_fields_through_python_method() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def ordinary() -> sview:\n    return \",\".join([\"alpha\", \"beta\", \"gamma\"])\n\ndef empty() -> sview:\n    values: darray[sview] = []\n    return \":\".join(values)\n\ndef preserves_empty() -> sview:\n    return \":\".join([\"\", \"a\", \"\"])\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "ordinary", arguments, observations).value.text == "alpha,beta,gamma"
        assert interpret_for_test(module, "empty", arguments, observations).value.text == ""
        assert interpret_for_test(module, "preserves_empty", arguments, observations).value.text == ":a:"


@test
def interpreter_executes_typed_dictionary_lookup_membership_equality_and_updates() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def lookup() -> i64:\n    values: dict[sview, i64] = {\"one\": 1, \"two\": 2}\n    return values[\"one\"] + values[\"two\"]\n\ndef membership() -> bool:\n    values: dict[sview, i64] = {\"one\": 1, \"two\": 2}\n    return \"one\" in values and not (\"missing\" in values) and values.count == 2u64\n\ndef equal() -> bool:\n    left: dict[sview, i64] = {\"one\": 1, \"two\": 2}\n    right: dict[sview, i64] = {\"two\": 2, \"one\": 1}\n    return left == right\n\ndef update() -> i64:\n    values: mutable dict[sview, i64] = {\"one\": 1}\n    values[\"one\"] <- 4\n    values[\"two\"] <- 5\n    return values[\"one\"] + values[\"two\"]\n\ndef iterate() -> i64:\n    values: dict[sview, i64] = {\"one\": 1, \"two\": 2}\n    total: mutable i64 = 0\n    for key in values:\n        total += values[key]\n    return total\n\ndef missing() -> i64:\n    values: dict[sview, i64] = {\"one\": 1}\n    return values[\"missing\"]\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "lookup", arguments, observations).value.integer == 3
        assert interpret_for_test(module, "membership", arguments, observations).value.boolean
        assert interpret_for_test(module, "equal", arguments, observations).value.boolean
        assert interpret_for_test(module, "update", arguments, observations).value.integer == 9
        assert interpret_for_test(module, "iterate", arguments, observations).value.integer == 3
        assert interpret_for_test(module, "missing", arguments, observations).value.kind == RuntimeValueKind.Void


@test
def interpreter_executes_python_negative_indexing_and_updates() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def read() -> bool:\n    values: darray[i64] = [10i64, 20i64, 30i64]\n    text: sview = \"abc\"\n    return values[-1] == 30i64 and text[-2] == 'b'\n\ndef checked(index: i64) -> i64:\n    values: darray[i64] = [10i64, 20i64, 30i64]\n    return get values[index] else 99i64\n\ndef update() -> i64:\n    values: mutable darray[i64] = [10i64, 20i64, 30i64]\n    values[-1] <- 40i64\n    return values[-1]\n\ndef missing() -> i64:\n    values: darray[i64] = [10i64, 20i64, 30i64]\n    return values[-4]\n"
        module: Module = lower_program(source)
        arguments: mutable darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "read", arguments, observations).value.boolean
        arguments <- [runtime_int(-1)]
        assert interpret_for_test(module, "checked", arguments, observations).value.integer == 30
        arguments <- [runtime_int(-4)]
        assert interpret_for_test(module, "checked", arguments, observations).value.integer == 99
        arguments <- []
        assert interpret_for_test(module, "update", arguments, observations).value.integer == 40
        assert interpret_for_test(module, "missing", arguments, observations).value.kind == RuntimeValueKind.Void


@test
def interpreter_iterates_dictionary_entries_with_two_read_only_bindings() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def iterate() -> i64:\n    values: dict[sview, i64] = {\"one\": 1, \"two\": 2}\n    total: mutable i64 = 0\n    for key, value in values:\n        total += value\n    return total\n\ndef items() -> i64:\n    values: dict[sview, i64] = {\"one\": 1, \"two\": 2}\n    total: mutable i64 = 0\n    for key, value in values.items():\n        total += value\n    return total\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "iterate", arguments, observations).value.integer == 3
        assert interpret_for_test(module, "items", arguments, observations).value.integer == 3


