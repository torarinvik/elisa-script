        assert decimal32.value.kind == RuntimeValueKind.Text
        assert decimal32.value.text == "1.5"
        assert boolean.value.kind == RuntimeValueKind.Text
        assert boolean.value.text == "true"
        assert text.value.kind == RuntimeValueKind.Text
        assert text.value.text == "ok"
        assert character.value.kind == RuntimeValueKind.Text
