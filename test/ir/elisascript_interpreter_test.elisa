@test
def interpreter_merges_set_mutations_through_branch_state() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def mutate(flag: bool) -> usize:\n    values: mutable set[i64] = {1i64}\n    if flag:\n        values.add(2i64)\n    else:\n        values.remove(1i64)\n    return values.count\n"
        module: Module = lower_program(source)
        true_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: true}]
        false_arguments: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Bool, boolean: false}]
        observations: mutable darray[Observation] = []
