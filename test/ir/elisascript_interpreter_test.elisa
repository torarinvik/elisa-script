@test
def interpreter_resolves_typed_real_paths_and_recovers_file_errors() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO:
        source: static u8& = "def direct() -> bool:\n    resolved: Path = path_real(path\"/tmp\")\n    return path_is_absolute(resolved) and resolved == path_real(path\"/tmp/./\")\n\ndef alias() -> bool:\n    return realpath(path\"/tmp\") == resolve_path(path\"/tmp\")\n\ndef method() -> bool:\n    return path\"/tmp/./\".resolve() == realpath(path\"/tmp\")\n\ndef missing() -> Path error[FileIoError] can[File.Read]:\n    return realpath(path\"/tmp/elisascript-realpath-missing.invalid\")\n\ndef recovered() -> bool:\n    value: Path = try missing() else path\"fallback\"\n    return value == path\"fallback\"\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        direct: Execution = interpret_for_test(module, "direct", arguments, observations)
        alias: Execution = interpret_for_test(module, "alias", arguments, observations)
        method: Execution = interpret_for_test(module, "method", arguments, observations)
        missing: Execution = interpret_for_test(module, "missing", arguments, observations)
        recovered: Execution = interpret_for_test(module, "recovered", arguments, observations)
        assert direct.value.kind == RuntimeValueKind.Bool
        assert direct.value.boolean
        assert alias.value.kind == RuntimeValueKind.Bool
        assert alias.value.boolean
        assert method.value.kind == RuntimeValueKind.Bool
        assert method.value.boolean
        assert missing.value.kind == RuntimeValueKind.Void
        assert recovered.value.kind == RuntimeValueKind.Bool
        assert recovered.value.boolean


