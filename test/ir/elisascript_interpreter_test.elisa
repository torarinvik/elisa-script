@test
def interpreter_creates_and_inspects_typed_symlinks() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO:
        target_path: static u8& = "/tmp/elisascript-symlink-target.txt"
        link_path: static u8& = "/tmp/elisascript-symlink-link.txt"
        method_target_path: static u8& = "/tmp/elisascript-symlink-method-target.txt"
        method_link_path: static u8& = "/tmp/elisascript-symlink-method-link.txt"
        _ = remove_file(target_path)
        _ = remove_file(link_path)
        _ = remove_file(method_target_path)
        _ = remove_file(method_link_path)
        source: static u8& = "def lifecycle() -> bool:\n    first: usize = write_text(path\"/tmp/elisascript-symlink-target.txt\", \"target\")\n    made: bool = symlink(path\"/tmp/elisascript-symlink-target.txt\", path\"/tmp/elisascript-symlink-link.txt\")\n    first_link: bool = is_symlink(path\"/tmp/elisascript-symlink-link.txt\")\n    first_target: Path = readlink(path\"/tmp/elisascript-symlink-link.txt\")\n    second: usize = write_text(path\"/tmp/elisascript-symlink-method-target.txt\", \"method\")\n    method_made: bool = path\"/tmp/elisascript-symlink-method-link.txt\".symlink_to(path\"/tmp/elisascript-symlink-method-target.txt\")\n    second_link: bool = path\"/tmp/elisascript-symlink-method-link.txt\".is_symlink()\n    second_target: Path = path\"/tmp/elisascript-symlink-method-link.txt\".readlink()\n    removed_link: bool = remove_path(path\"/tmp/elisascript-symlink-link.txt\")\n    removed_target: bool = remove_path(path\"/tmp/elisascript-symlink-target.txt\")\n    removed_method_link: bool = remove_path(path\"/tmp/elisascript-symlink-method-link.txt\")\n    removed_method_target: bool = remove_path(path\"/tmp/elisascript-symlink-method-target.txt\")\n    return first == 6u64 and made and first_link and first_target == path\"/tmp/elisascript-symlink-target.txt\" and second == 6u64 and method_made and second_link and second_target == path\"/tmp/elisascript-symlink-method-target.txt\" and removed_link and removed_target and removed_method_link and removed_method_target\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        lifecycle: Execution = interpret_for_test(module, "lifecycle", arguments, observations)
        _ = remove_file(target_path)
        _ = remove_file(link_path)
        _ = remove_file(method_target_path)
        _ = remove_file(method_link_path)
        assert lifecycle.value.boolean


@test
def interpreter_copies_and_removes_nested_typed_trees_without_following_links() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO:
        source_root: static u8& = "/tmp/elisascript-tree-source"
        destination_root: static u8& = "/tmp/elisascript-tree-destination"
        _ = remove_file("/tmp/elisascript-tree-source/nested/link.txt")
        _ = remove_file("/tmp/elisascript-tree-source/nested/data.txt")
        _ = remove_file("/tmp/elisascript-tree-source/nested")
        _ = remove_file(source_root)
        _ = remove_file("/tmp/elisascript-tree-destination/nested/link.txt")
        _ = remove_file("/tmp/elisascript-tree-destination/nested/data.txt")
        _ = remove_file("/tmp/elisascript-tree-destination/nested")
        _ = remove_file(destination_root)
        source: static u8& = "def lifecycle() -> bool:\n    made: bool = create_directory(path\"/tmp/elisascript-tree-source\")\n    nested: bool = create_directory(path\"/tmp/elisascript-tree-source/nested\")\n    written: usize = write_text(path\"/tmp/elisascript-tree-source/nested/data.txt\", \"tree\")\n    linked: bool = symlink(path\"data.txt\", path\"/tmp/elisascript-tree-source/nested/link.txt\")\n    copied: bool = copy_tree(path\"/tmp/elisascript-tree-source\", path\"/tmp/elisascript-tree-destination\")\n    copied_file: sview = read_text(path\"/tmp/elisascript-tree-destination/nested/data.txt\")\n    copied_link: bool = is_symlink(path\"/tmp/elisascript-tree-destination/nested/link.txt\")\n    removed: bool = remove_tree(path\"/tmp/elisascript-tree-source\")\n    removed_copy: bool = remove_tree(path\"/tmp/elisascript-tree-destination\")\n    return made and nested and written == 4u64 and linked and copied and copied_file == \"tree\" and copied_link and removed and removed_copy\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        lifecycle: Execution = interpret_for_test(module, "lifecycle", arguments, observations)
        assert lifecycle.value.boolean


