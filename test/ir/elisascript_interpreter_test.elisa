@test
def interpreter_executes_complete_core_scalar_operator_family() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def remainder() -> i64:\n    return -17 % 5\n\ndef float_value() -> f64:\n    return -(1.5e1 / 2.0)\n\ndef not_value() -> bool:\n    return not false\n\ndef greater_equal() -> bool:\n    return 4 >= 4\n\ndef unequal() -> bool:\n    return \"a\" != \"b\"\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        remainder: Execution = interpret_for_test(module, "remainder", arguments, observations)
        float_value: Execution = interpret_for_test(module, "float_value", arguments, observations)
        not_value: Execution = interpret_for_test(module, "not_value", arguments, observations)
        greater_equal: Execution = interpret_for_test(module, "greater_equal", arguments, observations)
        unequal: Execution = interpret_for_test(module, "unequal", arguments, observations)

        assert remainder.value.kind == RuntimeValueKind.Int
        assert remainder.value.integer == -2
        assert float_value.value.kind == RuntimeValueKind.Float
        assert float_value.value.decimal == -7.5
        assert not_value.value.boolean
        assert greater_equal.value.boolean
        assert unequal.value.boolean


@test
def interpreter_executes_typed_integer_conversion() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def parse(value: sview) -> i64:\n    return parse_int(value)\n\ndef format(value: i64) -> sview:\n    return format_int(value)\n\ndef parse_decimal(value: sview) -> f64:\n    return parse_float(value)\n\ndef format_decimal(value: f64) -> sview:\n    return format_float(value)\n\ndef invalid(value: sview) -> i64:\n    return parse_int(value)\n\ndef invalid_decimal(value: sview) -> f64:\n    return parse_float(value)\n"
        module: Module = lower_program(source)
        positive: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "12345"}]
        negative: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "-9223372036854775808"}]
        malformed: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "12x"}]
        integer: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: -42}]
        decimal_text: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "-1.25e2"}]
        decimal: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Float, decimal: 3.5}]
        observations: mutable darray[Observation] = []
        assert interpret_for_test(module, "parse", positive, observations).value.integer == 12345
        assert interpret_for_test(module, "parse", negative, observations).value.integer == -9223372036854775807 - 1
        assert interpret_for_test(module, "invalid", malformed, observations).value.kind == RuntimeValueKind.Void
        assert interpret_for_test(module, "invalid_decimal", malformed, observations).value.kind == RuntimeValueKind.Void
        assert interpret_for_test(module, "parse_decimal", decimal_text, observations).value.decimal == -125.0
        formatted: Execution = interpret_for_test(module, "format", integer, observations)
        assert formatted.value.kind == RuntimeValueKind.Text
        assert formatted.value.text == "-42"
        decimal_formatted: Execution = interpret_for_test(module, "format_decimal", decimal, observations)
        assert decimal_formatted.value.kind == RuntimeValueKind.Text
        assert decimal_formatted.value.text == "3.5"


