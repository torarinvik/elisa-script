@test
def interpreter_executes_complete_core_scalar_operator_family() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def remainder() -> i64:\n    return -17 % 5\n\ndef float_value() -> f64:\n    return -(1.5e1 / 2.0)\n\ndef not_value() -> bool:\n    return not false\n\ndef greater_equal() -> bool:\n    return 4 >= 4\n\ndef unequal() -> bool:\n    return \"a\" != \"b\"\n\ndef text_less() -> bool:\n    return \"alpha\" < \"beta\"\n\ndef text_greater_equal() -> bool:\n    return \"beta\" >= \"beta\"\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        remainder: Execution = interpret_for_test(module, "remainder", arguments, observations)
