@test
def interpreter_executes_any_all_quantifiers() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def has_even() -> bool:\n    return any value in [1i64, 3i64] where value % 2i64 == 0i64\n\ndef all_positive() -> bool:\n    return all value in [1i64, 2i64] where value > 0i64\n\ndef all_empty() -> bool:\n    values: darray[i64] = []\n    return all value in values where value > 0i64\n\ndef forall_positive() -> bool:\n    return forall value in [1i64, 2i64]: value > 0i64\n\ndef exists_even() -> bool:\n    return exists value in [1i64, 4i64]: value % 2i64 == 0i64\n\ndef forall_where() -> bool:\n    return forall value in [1i64, 2i64] where value > 0i64\n\ndef exists_where() -> bool:\n    return exists value in [1i64, 4i64] where value % 2i64 == 0i64\n\ndef selected() -> darray[i64]:\n    return each value in [1i64, 2i64, 3i64] where value > 1i64\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        assert not interpret_for_test(module, "has_even", arguments, observations).value.boolean
        assert interpret_for_test(module, "all_positive", arguments, observations).value.boolean
        assert interpret_for_test(module, "all_empty", arguments, observations).value.boolean
        assert interpret_for_test(module, "forall_positive", arguments, observations).value.boolean
        assert interpret_for_test(module, "exists_even", arguments, observations).value.boolean
        assert interpret_for_test(module, "forall_where", arguments, observations).value.boolean
        assert interpret_for_test(module, "exists_where", arguments, observations).value.boolean
        selected: Execution = interpret_for_test(module, "selected", arguments, observations)
        assert selected.value.kind == RuntimeValueKind.Array
        assert selected.value.array_count == 2


