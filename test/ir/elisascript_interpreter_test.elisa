        assert not runtime_array_range_valid(storage, arguments[0])
        rejected: Execution = try interpret(module, "read", arguments, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert rejected.value.kind == RuntimeValueKind.Void


@test
def interpreter_copies_and_moves_files_without_shell_roundtrips() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def lifecycle() -> bool:\n    source: Path = path\"/tmp/elisascript-file-copy-source.txt\"\n    copied_path: Path = path\"/tmp/elisascript-file-copy-destination.txt\"\n    moved_path: Path = path\"/tmp/elisascript-file-copy-moved.txt\"\n    write_text(source, \"alpha\\x00omega\")\n    copied: bool = copy_path(source, copied_path)\n    copied_contents: sview = read_text(copied_path)\n    moved: bool = move_path(copied_path, moved_path)\n    moved_contents: sview = read_text(moved_path)\n    source_exists: bool = path_exists(source)\n    destination_gone: bool = not path_exists(copied_path)\n    cleanup_source: bool = remove_path(source)\n    cleanup_moved: bool = remove_path(moved_path)\n    return copied and moved and source_exists and destination_gone and copied_contents == \"alpha\\x00omega\" and moved_contents == \"alpha\\x00omega\" and cleanup_source and cleanup_moved\n\ndef missing() -> bool:\n    return copy_path(path\"/tmp/elisascript-file-copy-missing.txt\", path\"/tmp/elisascript-file-copy-destination.txt\")\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []

        assert interpret_for_test(module, "lifecycle", arguments, observations).value.boolean
        assert interpret_for_test(module, "missing", arguments, observations).value.kind == RuntimeValueKind.Void


@test
def interpreter_executes_typed_path_shape_operations() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def combine(base: Path, leaf: sview) -> Path:\n    return path_join(base, leaf)\n\ndef parent(path_value: Path) -> Path:\n    return path_parent(path_value)\n\ndef parent_alias(path_value: Path) -> Path:\n    return dirname(path_value)\n\ndef name(path_value: Path) -> sview:\n    return path_name(path_value)\n\ndef name_alias(path_value: Path) -> sview:\n    return basename(path_value)\n\ndef extension(path_value: Path) -> sview:\n    return path_extension(path_value)\n\ndef suffix_alias(path_value: Path) -> sview:\n    return suffix(path_value)\n\ndef stem_value(path_value: Path) -> sview:\n    return path_stem(path_value)\n\ndef stem_alias(path_value: Path) -> sview:\n    return stem(path_value)\n\ndef directory_alias(path_value: Path) -> bool:\n    return is_dir(path_value)\n\ndef parent_property(path_value: Path) -> Path:\n    return path_value.parent\n\ndef name_property(path_value: Path) -> sview:\n    return path_value.name\n\ndef suffix_property(path_value: Path) -> sview:\n    return path_value.suffix\n\ndef stem_property(path_value: Path) -> sview:\n    return path_value.stem\n\ndef join_method(base: Path, leaf: sview) -> Path:\n    return base.joinpath(leaf)\n\ndef exists_method(path_value: Path) -> bool:\n    return path_value.exists()\n\ndef directory_method(path_value: Path) -> bool:\n    return path_value.is_dir()\n\ndef file_predicate(path_value: Path) -> bool:\n    return is_file(path_value)\n\ndef file_method(path_value: Path) -> bool:\n    return path_value.is_file()\n"
        module: Module = lower_program(source)
        base: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "src/elisa"}]
        leaf: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "main.elisa"}]
        path: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "src/elisa/main.elisa"}]
        existing_path: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "docs/ir.md"}]
        directory_path: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "docs"}]
        missing_path: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "docs/definitely-not-an-elisascript-file.invalid"}]
        absolute_leaf: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Text, text: "/tmp/main.elisa"}]
        combine_arguments: darray[RuntimeValue] = [base[0], leaf[0]]
        absolute_arguments: darray[RuntimeValue] = [base[0], absolute_leaf[0]]
        observations: mutable darray[Observation] = []
        combined: Execution = interpret_for_test(module, "combine", combine_arguments, observations)
        absolute: Execution = interpret_for_test(module, "combine", absolute_arguments, observations)
        assert combined.value.text == "src/elisa/main.elisa"
        assert absolute.value.text == "/tmp/main.elisa"
        assert interpret_for_test(module, "parent", path, observations).value.text == "src/elisa"
        assert interpret_for_test(module, "parent_alias", path, observations).value.text == "src/elisa"
        assert interpret_for_test(module, "name", path, observations).value.text == "main.elisa"
        assert interpret_for_test(module, "name_alias", path, observations).value.text == "main.elisa"
        assert interpret_for_test(module, "extension", path, observations).value.text == ".elisa"
        assert interpret_for_test(module, "suffix_alias", path, observations).value.text == ".elisa"
        assert interpret_for_test(module, "stem_value", path, observations).value.text == "main"
        assert interpret_for_test(module, "stem_alias", path, observations).value.text == "main"
        assert not interpret_for_test(module, "directory_alias", path, observations).value.boolean
        assert interpret_for_test(module, "parent_property", path, observations).value.text == "src/elisa"
        assert interpret_for_test(module, "name_property", path, observations).value.text == "main.elisa"
        assert interpret_for_test(module, "suffix_property", path, observations).value.text == ".elisa"
        assert interpret_for_test(module, "stem_property", path, observations).value.text == "main"
        assert interpret_for_test(module, "join_method", combine_arguments, observations).value.text == "src/elisa/main.elisa"
        assert interpret_for_test(module, "exists_method", existing_path, observations).value.boolean
        assert not interpret_for_test(module, "directory_method", existing_path, observations).value.boolean
        assert interpret_for_test(module, "file_predicate", existing_path, observations).value.boolean
        assert interpret_for_test(module, "file_method", existing_path, observations).value.boolean
        assert not interpret_for_test(module, "file_predicate", directory_path, observations).value.boolean
        assert not interpret_for_test(module, "file_predicate", missing_path, observations).value.boolean


