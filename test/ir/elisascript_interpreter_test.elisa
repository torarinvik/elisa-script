@test
def interpreter_executes_array_and_text_comprehensions() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def doubled() -> darray[i64]:\n    return [value * 2i64 for value in [1i64, 2i64, 3i64]]\n\ndef evens() -> darray[i64]:\n    return [value for value in [1i64, 2i64, 3i64, 4i64] if value % 2i64 == 0i64]\n\ndef chars() -> darray[char]:\n    return [character for character in \"ab\"]\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []

        doubled: Execution = try interpret(module, "doubled", arguments, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert doubled.value.kind == RuntimeValueKind.Array
        assert doubled.value.array_count == 3
        assert storage[doubled.value.array_start.usize()].integer == 2
        assert storage[doubled.value.array_start.usize() + 1].integer == 4
        assert storage[doubled.value.array_start.usize() + 2].integer == 6

        evens: Execution = try interpret(module, "evens", arguments, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert evens.value.kind == RuntimeValueKind.Array
        assert evens.value.array_count == 2
        assert storage[evens.value.array_start.usize()].integer == 2
        assert storage[evens.value.array_start.usize() + 1].integer == 4

        chars: Execution = try interpret(module, "chars", arguments, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert chars.value.kind == RuntimeValueKind.Array
        assert chars.value.array_count == 2
        assert storage[chars.value.array_start.usize()].text == "a"
        assert storage[chars.value.array_start.usize() + 1].text == "b"


@test
def interpreter_executes_zip_array_comprehension_to_shortest_source() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def zipped() -> darray[i64]:\n    left: darray[i64] = [1i64, 2i64, 3i64]\n    right: darray[i64] = [10i64, 20i64]\n    return [left_value + right_value for left_value, right_value in zip(left, right)]\n"
        module: Module = lower_program(source)
        arguments: darray[RuntimeValue] = []
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        result: Execution = try interpret(module, "zipped", arguments, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert result.value.kind == RuntimeValueKind.Array
        assert result.value.array_count == 2
        assert storage[result.value.array_start.usize()].integer == 11
        assert storage[result.value.array_start.usize() + 1].integer == 22


@test
def interpreter_executes_enumerate_array_comprehension_with_start() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def projected(start: usize) -> darray[i64]:\n    values: darray[i64] = [4i64, 5i64]\n    return [value for index, value in enumerate(values, start: start) if index >= start]\n"
        module: Module = lower_program(source)
        start: darray[RuntimeValue] = [RuntimeValue{kind: RuntimeValueKind.Int, integer: 7}]
        observations: mutable darray[Observation] = []
        storage: mutable darray[RuntimeValue] = []
        result: Execution = try interpret(module, "projected", start, observations, storage) else Execution{value: runtime_void(), steps: 0}
        assert result.value.kind == RuntimeValueKind.Array
        assert result.value.array_count == 2
        assert storage[result.value.array_start.usize()].integer == 4
        assert storage[result.value.array_start.usize() + 1].integer == 5


