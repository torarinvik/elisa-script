include "../../src/ir/ir.elisa"

using Ast
using EsIr


@test
def lowers_and_verifies_assertion_smoke() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        source: static u8& = "def check(value: bool) -> void:\n    assert(value)\n"
        tokens: darray[Lexer::Token] = frontend_tokenize("assertion.elisascript", source)
        file: Ast::File = frontend_parser_parse_file(source, tokens)
        assert file.errors.count == 0
        lowered: LowerResult = lower_file(file, "assertion-smoke")
        assert lowered.issues.count == 0
        assert lowered.module.functions[0].instruction_pool[0].opcode == Opcode.Assert
        assert lowered.module.functions[0].instruction_pool[0].result_type.kind == TypeKind.Void
        assert verify(lowered.module).count == 0
