include "../../src/ir/ir.elisa"

using EsIr


def empty_module() -> Module:
    return Module{name: "fallback", functions: []}


@test
def source_file_loader_reads_owned_elisascript_bytes() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-source-file-test.elisascript"
        source: static u8& = "def main() -> i64:\n    return 23\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written == 33

        module: Module = try lower_elisascript_file(path, "file-source") else empty_module()
        assert module.name == "file-source"
        assert module.functions.count == 1
        assert module.functions[0].name == "main"
        assert verify(module).count == 0
        _ = remove_file(path.cast[cstr])


@test
def source_file_loader_reports_missing_file_and_wrong_extension() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        missing: static u8& = "/tmp/elisascript-source-file-missing.elisascript"
        source: static u8& = "def main() -> i64:\n    return 1\n"
        rejected: Module = try lower_elisascript_file(missing, "missing") else empty_module()
        assert rejected.name == "fallback"

        wrong: static u8& = "/tmp/elisascript-source-file-test.elisa"
        rejected_suffix: Module = try lower_elisascript_file(wrong, "wrong") else empty_module()
        assert rejected_suffix.name == "fallback"


@test
def source_file_loader_rejects_embedded_nul_before_parsing() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-source-file-nul.elisascript"
        fragment: sview = "def main() -> i64:\n    return 1\n"
        bytes: mutable dstr = ctx_fstr_alloc(sview_len(fragment) * 2 + 1)
        ctx_fstr_append(bytes, fragment.data, sview_len(fragment))
        ctx_fstr_append(bytes, "\0", 1)
        ctx_fstr_append(bytes, fragment.data, sview_len(fragment))
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], bytes_view(bytes)) else -1
        assert written == (sview_len(fragment) * 2 + 1).i64()

        rejected: Module = try lower_elisascript_file(path, "embedded-nul") else empty_module()
        assert rejected.name == "fallback"
        _ = remove_file(path.cast[cstr])
