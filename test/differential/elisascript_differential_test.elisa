@test
def differential_elisascript_program_runner_accepts_python_fold_builtins() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-folds.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    values: darray[i64] = [2i64, 3i64, 4i64]\n    flags: darray[bool] = [false, true]\n    observe(sum(values, 10i64))\n    observe(product(values))\n    observe(any(flags))\n    observe(all(flags))\n    range_total: mutable i64 = 0i64\n    for value in range(4i64):\n        range_total += value\n    for value in range(5i64, 0i64, -2i64):\n        range_total += value\n    observe(range_total)\n    return sum(values, 10i64) * 10 + product(values) + range_total\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "folds-candidate", target: sview(path, 0, -1), arguments: [], timeout_steps: 10000}
        captured: mutable DifferentialRun = DifferentialRun{observations: []}
        assert run_elisascript_program_succeeds(runner, captured)
        assert captured.exit_status == 229
        assert captured.return_value.kind == DifferentialValueKind.Int
        assert captured.return_value.integer == 229
        assert captured.observations.count == 5
        assert captured.observations[0].value.kind == DifferentialValueKind.Int
        assert captured.observations[0].value.integer == 19
        assert captured.observations[1].value.kind == DifferentialValueKind.Int
        assert captured.observations[1].value.integer == 24
        assert captured.observations[2].value.kind == DifferentialValueKind.Bool
        assert captured.observations[2].value.boolean
        assert captured.observations[3].value.kind == DifferentialValueKind.Bool
        assert not captured.observations[3].value.boolean
        assert captured.observations[4].value.kind == DifferentialValueKind.Int
        assert captured.observations[4].value.integer == 15

        _ = remove_file(path.cast[cstr])


