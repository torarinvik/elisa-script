@test
def differential_value_pool_artifact_roundtrip_preserves_typed_storage() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        reference: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/reference", arguments: [], timeout_steps: 10}
        candidate: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: "candidate.elisascript", arguments: [], timeout_steps: 10}
        case: DifferentialCase = DifferentialCase{name: "value-pool-report", reference: reference, candidate: candidate}
        manifest: DifferentialArtifactManifest = make_differential_artifact_manifest(case, 780u64)
        values: mutable darray[DifferentialValue] = []
        root: DifferentialValue = array_value(values, [int_value(7), float_value(1.25), text_value("payload")])
        mapping: DifferentialValue = map_value(values, [text_value("key"), int_value(9)])
        observations: darray[DifferentialObservation] = [DifferentialObservation{trace: 41u64, value: mapping}]
        run: DifferentialRun = DifferentialRun{exit_status: 124, observations: observations, values: values, return_value: root, outcome: DifferentialRunOutcome.Timeout}
        artifact: DifferentialValuePoolArtifact = make_differential_value_pool_artifact(manifest, DifferentialArtifactSide.Reference, run)
        assert artifact.manifest_fingerprint == differential_artifact_manifest_fingerprint(manifest)
        assert artifact.side == DifferentialArtifactSide.Reference
        assert artifact.outcome == DifferentialRunOutcome.Timeout
        assert artifact.exit_status == 124
        assert artifact.root_value.kind == DifferentialValueKind.Array
        assert artifact.values.count == 5
        encoded: darray[u8] = canonical_differential_value_pool_artifact_bytes(artifact)
        assert encoded.count > 0
        decoded: DifferentialValuePoolArtifactDecode = decode_differential_value_pool_artifact(encoded)
        assert decoded.valid
        assert decoded.artifact.format_version == 1
        assert decoded.artifact.values.count == 5
        assert decoded.artifact.root_value.kind == DifferentialValueKind.Array
        assert decoded.artifact.values[1].decimal == 1.25
        assert decoded.artifact.values[3].kind == DifferentialValueKind.Map
        assert decoded.artifact.observations[0].trace == 41u64
        assert differential_value_pool_artifact_bytes_valid(encoded)
        first_fingerprint: u64 = differential_value_pool_artifact_fingerprint(artifact)
        changed: mutable DifferentialValuePoolArtifact = artifact
        changed.values[2].text <- "changed"
        assert first_fingerprint != differential_value_pool_artifact_fingerprint(changed)
        malformed: mutable darray[u8] = encoded
        malformed[39] <- 255
        assert not differential_value_pool_artifact_bytes_valid(malformed)
        trailing: mutable darray[u8] = encoded
        trailing.push(0)
        assert not differential_value_pool_artifact_bytes_valid(trailing)
        truncated: mutable darray[u8] = encoded
        _ = truncated.pop()
        assert not differential_value_pool_artifact_bytes_valid(truncated)


@test
def differential_artifact_index_rejects_partial_complete_publication() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        reference: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/reference", arguments: [], timeout_steps: 10}
        candidate: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: "candidate.elisascript", arguments: [], timeout_steps: 10}
        case: DifferentialCase = DifferentialCase{name: "artifact-index", reference: reference, candidate: candidate}
        manifest: DifferentialArtifactManifest = make_differential_artifact_manifest(case, 781u64)
        prepared: DifferentialArtifactIndex = make_differential_artifact_index(manifest, DifferentialArtifactPublicationState.Prepared)
        prepared_bytes: darray[u8] = canonical_differential_artifact_index_bytes(prepared)
        assert prepared_bytes.count > 0
        prepared_decoded: DifferentialArtifactIndexDecode = decode_differential_artifact_index(prepared_bytes)
        assert prepared_decoded.valid
        assert prepared_decoded.index.publication == DifferentialArtifactPublicationState.Prepared
        complete: DifferentialArtifactIndex = make_differential_artifact_index(manifest, DifferentialArtifactPublicationState.Complete, 1u64, 2u64, 3u64, 4u64, 5u64, 6u64)
        encoded: darray[u8] = canonical_differential_artifact_index_bytes(complete)
        assert encoded.count == prepared_bytes.count
        decoded: DifferentialArtifactIndexDecode = decode_differential_artifact_index(encoded)
        assert decoded.valid
        assert decoded.index.publication == DifferentialArtifactPublicationState.Complete
        assert decoded.index.candidate_value_pool_fingerprint == 6u64
        assert differential_artifact_index_bytes_valid(encoded)
        first_fingerprint: u64 = differential_artifact_index_fingerprint(complete)
        changed: mutable DifferentialArtifactIndex = complete
        changed.candidate_process_fingerprint <- 33u64
        assert first_fingerprint != differential_artifact_index_fingerprint(changed)
        partial: mutable darray[u8] = prepared_bytes
        partial[13] <- DifferentialArtifactPublicationState.Complete.u8()
        assert not differential_artifact_index_bytes_valid(partial)
        trailing: mutable darray[u8] = encoded
        trailing.push(0)
        assert not differential_artifact_index_bytes_valid(trailing)
        truncated: mutable darray[u8] = encoded
        _ = truncated.pop()
        assert not differential_artifact_index_bytes_valid(truncated)


@test
def differential_artifact_replay_admission_rejects_incomplete_mixed_and_stale_bundles() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        reference: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/reference", arguments: [], timeout_steps: 10}
        candidate: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: "candidate.elisascript", arguments: [], timeout_steps: 10}
        case: DifferentialCase = DifferentialCase{name: "artifact-replay", reference: reference, candidate: candidate}
        manifest: DifferentialArtifactManifest = make_differential_artifact_manifest(case, 782u64)
        comparison: DifferentialComparison = DifferentialComparison{equal: true, kind: DifferentialDifferenceKind.Equal}
        comparison_artifact: DifferentialComparisonArtifact = make_differential_comparison_artifact(manifest, comparison)
        reference_run: DifferentialRun = DifferentialRun{observations: []}
        candidate_run: DifferentialRun = DifferentialRun{observations: []}
        reference_process: DifferentialProcessStreamArtifact = make_differential_process_stream_artifact(manifest, DifferentialArtifactSide.Reference, reference_run)
        candidate_process: DifferentialProcessStreamArtifact = make_differential_process_stream_artifact(manifest, DifferentialArtifactSide.Candidate, candidate_run)
        reproduction: DifferentialReproductionArtifact = make_differential_reproduction_artifact(manifest, "es", "artifact_replay")
        reference_values: DifferentialValuePoolArtifact = make_differential_value_pool_artifact(manifest, DifferentialArtifactSide.Reference, reference_run)
        candidate_values: DifferentialValuePoolArtifact = make_differential_value_pool_artifact(manifest, DifferentialArtifactSide.Candidate, candidate_run)
        complete: DifferentialArtifactIndex = make_differential_artifact_index(manifest, DifferentialArtifactPublicationState.Complete, differential_comparison_artifact_fingerprint(comparison_artifact), differential_process_stream_artifact_fingerprint(reference_process), differential_process_stream_artifact_fingerprint(candidate_process), differential_reproduction_artifact_fingerprint(reproduction), differential_value_pool_artifact_fingerprint(reference_values), differential_value_pool_artifact_fingerprint(candidate_values))
        admitted: DifferentialArtifactReplayCheck = validate_differential_artifact_bundle(manifest, complete, comparison_artifact, reference_process, candidate_process, reproduction, reference_values, candidate_values)
        assert admitted.valid
        assert admitted.issue == DifferentialArtifactReplayIssue.None

        prepared: DifferentialArtifactIndex = make_differential_artifact_index(manifest, DifferentialArtifactPublicationState.Prepared)
        incomplete: DifferentialArtifactReplayCheck = validate_differential_artifact_bundle(manifest, prepared, comparison_artifact, reference_process, candidate_process, reproduction, reference_values, candidate_values)
        assert not incomplete.valid
        assert incomplete.issue == DifferentialArtifactReplayIssue.Incomplete

        stale: mutable DifferentialArtifactIndex = complete
        stale.candidate_process_fingerprint <- 99u64
        stale_check: DifferentialArtifactReplayCheck = validate_differential_artifact_bundle(manifest, stale, comparison_artifact, reference_process, candidate_process, reproduction, reference_values, candidate_values)
        assert not stale_check.valid
        assert stale_check.issue == DifferentialArtifactReplayIssue.FingerprintMismatch

        mixed: mutable DifferentialProcessStreamArtifact = candidate_process
        mixed.side <- DifferentialArtifactSide.Reference
        mixed_check: DifferentialArtifactReplayCheck = validate_differential_artifact_bundle(manifest, complete, comparison_artifact, reference_process, mixed, reproduction, reference_values, candidate_values)
        assert not mixed_check.valid
        assert mixed_check.issue == DifferentialArtifactReplayIssue.SideMismatch


@test
def differential_artifact_directory_protocol_rejects_unsafe_names_and_partial_publish() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        reference: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/reference", arguments: [], timeout_steps: 10}
        candidate: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: "candidate.elisascript", arguments: [], timeout_steps: 10}
        case: DifferentialCase = DifferentialCase{name: "artifact-directory", reference: reference, candidate: candidate}
        manifest: DifferentialArtifactManifest = make_differential_artifact_manifest(case, 783u64)
        prepared_index: DifferentialArtifactIndex = make_differential_artifact_index(manifest, DifferentialArtifactPublicationState.Prepared)
        staging: DifferentialArtifactDirectoryPlan = make_differential_artifact_directory_plan(manifest, "/tmp/elisascript-artifacts", ".artifact-staging-1", "artifact-1")
        staging_check: DifferentialArtifactDirectoryCheck = validate_differential_artifact_directory(staging, prepared_index)
        assert staging_check.valid
        assert staging_check.issue == DifferentialArtifactDirectoryIssue.None

        complete_index: DifferentialArtifactIndex = make_differential_artifact_index(manifest, DifferentialArtifactPublicationState.Complete, 1u64, 2u64, 3u64, 4u64, 5u64, 6u64)
        ready: DifferentialArtifactDirectoryPlan = make_differential_artifact_directory_plan(manifest, "/tmp/elisascript-artifacts", ".artifact-staging-1", "artifact-1", DifferentialArtifactDirectoryState.Ready)
        ready_check: DifferentialArtifactDirectoryCheck = validate_differential_artifact_directory(ready, complete_index)
        assert ready_check.valid

        transitioning: mutable DifferentialArtifactDirectoryPlan = staging
        ready_transition: DifferentialArtifactDirectoryCheck = advance_differential_artifact_directory(transitioning, complete_index, DifferentialArtifactDirectoryState.Ready)
        assert ready_transition.valid
        assert transitioning.state == DifferentialArtifactDirectoryState.Ready
        published_transition: DifferentialArtifactDirectoryCheck = advance_differential_artifact_directory(transitioning, complete_index, DifferentialArtifactDirectoryState.Published)
        assert published_transition.valid
        assert transitioning.state == DifferentialArtifactDirectoryState.Published

        skipped: mutable DifferentialArtifactDirectoryPlan = staging
        skipped_transition: DifferentialArtifactDirectoryCheck = advance_differential_artifact_directory(skipped, complete_index, DifferentialArtifactDirectoryState.Published)
        assert not skipped_transition.valid
        assert skipped_transition.issue == DifferentialArtifactDirectoryIssue.InvalidTransition

        published: DifferentialArtifactDirectoryPlan = make_differential_artifact_directory_plan(manifest, "/tmp/elisascript-artifacts", ".artifact-staging-1", "artifact-1", DifferentialArtifactDirectoryState.Published)
        published_check: DifferentialArtifactDirectoryCheck = validate_differential_artifact_directory(published, complete_index)
        assert published_check.valid

        partial_publish: DifferentialArtifactDirectoryCheck = validate_differential_artifact_directory(ready, prepared_index)
        assert not partial_publish.valid
        assert partial_publish.issue == DifferentialArtifactDirectoryIssue.InvalidPublicationState

        unsafe: mutable DifferentialArtifactDirectoryPlan = staging
        unsafe.staging_name <- "../escape"
        unsafe_check: DifferentialArtifactDirectoryCheck = validate_differential_artifact_directory(unsafe, prepared_index)
        assert not unsafe_check.valid
        assert unsafe_check.issue == DifferentialArtifactDirectoryIssue.InvalidPlan

        collision: mutable DifferentialArtifactDirectoryPlan = staging
        collision.final_name <- collision.staging_name
        collision_check: DifferentialArtifactDirectoryCheck = validate_differential_artifact_directory(collision, prepared_index)
        assert not collision_check.valid
        assert collision_check.issue == DifferentialArtifactDirectoryIssue.InvalidPlan


@test
def differential_process_capture_adapter_materializes_one_snapshot() -> void:
    capture: EsIr::RuntimeValue = EsIr::RuntimeValue{kind: EsIr::RuntimeValueKind.ProcessCapture, process_exit_status: 7, process_stdout: "out", process_stderr: "err"}
    observations: darray[DifferentialObservation] = [DifferentialObservation{trace: 11, value: int_value(42)}]
    run: DifferentialRun = differential_run_from_process_capture(capture, observations)

    assert run.exit_status == 7
    assert run.return_value.kind == DifferentialValueKind.Int
    assert run.return_value.integer == 7
    assert not run.engine_known
    assert run.stdout == "out"
    assert run.stderr == "err"
    assert run.error_text == ""
    assert run.observations.count == 1
    assert run.observations[0].trace == 11
    assert run.observations[0].value.integer == 42


@test
def differential_engine_requirement_rejects_bytecode_fallback() -> void:
    reference: DifferentialRun = DifferentialRun{observations: [], engine_known: true, engine: EsIr::ExecutionEngine.ReferenceInterpreter}
    candidate: DifferentialRun = DifferentialRun{observations: [], engine_known: true, engine: EsIr::ExecutionEngine.BytecodeInterpreterFallback}
    comparison: DifferentialComparison = compare_differential_runs_with_engine_requirement(reference, candidate, DifferentialEngineRequirement.RequireDirectBytecodeCandidate)

    assert not comparison.equal
    assert comparison.kind == DifferentialDifferenceKind.Engine
    assert comparison.reference_engine == EsIr::ExecutionEngine.ReferenceInterpreter
    assert comparison.candidate_engine == EsIr::ExecutionEngine.BytecodeInterpreterFallback


@test
def differential_engine_requirement_allows_direct_candidate_against_external_reference() -> void:
    reference: DifferentialRun = DifferentialRun{observations: [], engine_known: false}
    candidate: DifferentialRun = DifferentialRun{observations: [], engine_known: true, engine: EsIr::ExecutionEngine.DirectBytecode, capability_known: true, capability: EsIr::ExecutionCapability{direct_supported: true, function_count: 1u64, instruction_count: 1u64, global_count: 0u64}}
    comparison: DifferentialComparison = compare_differential_runs_with_engine_requirement(reference, candidate, DifferentialEngineRequirement.RequireDirectBytecodeCandidate)

    assert comparison.equal
    assert comparison.kind == DifferentialDifferenceKind.Equal


@test
def differential_engine_requirement_rejects_contradictory_capability_metadata() -> void:
    reference: DifferentialRun = DifferentialRun{observations: [], engine_known: true, engine: EsIr::ExecutionEngine.ReferenceInterpreter}
    candidate: DifferentialRun = DifferentialRun{observations: [], engine_known: true, engine: EsIr::ExecutionEngine.DirectBytecode, capability_known: true, capability: EsIr::ExecutionCapability{direct_supported: false, function_count: 1u64, instruction_count: 1u64, global_count: 0u64}}
    comparison: DifferentialComparison = compare_differential_runs_with_engine_requirement(reference, candidate, DifferentialEngineRequirement.RequireKnown)

    assert not comparison.equal
    assert comparison.kind == DifferentialDifferenceKind.Engine


