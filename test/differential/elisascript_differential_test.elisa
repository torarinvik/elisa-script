include "../../src/testing/differential.elisa"

using EsDifferential


def int_value(value: i64) -> DifferentialValue:
    return DifferentialValue{kind: DifferentialValueKind.Int, integer: value}


def text_value(value: sview) -> DifferentialValue:
    return DifferentialValue{kind: DifferentialValueKind.Text, text: value}


def float_value(value: f64) -> DifferentialValue:
    return DifferentialValue{kind: DifferentialValueKind.Float, decimal: value}


def array_value(storage: mutable darray[DifferentialValue]&, values: darray[DifferentialValue]) -> DifferentialValue can[Memory.Allocate, Abort.Panic]:
    catch differential_array_value(storage, values):
        ok value:
            return value
        error failure:
            return DifferentialValue{kind: DifferentialValueKind.Void}


def map_value(storage: mutable darray[DifferentialValue]&, values: darray[DifferentialValue]) -> DifferentialValue can[Memory.Allocate, Abort.Panic]:
    catch differential_map_value(storage, values):
        ok value:
            return value
        error failure:
            return DifferentialValue{kind: DifferentialValueKind.Void}


def run_elisascript_succeeds(runner: DifferentialRunner&, result: mutable DifferentialRun&) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        catch run_differential_elisascript(runner, result):
            ok:
                return true
            error e:
                return false


def run_elisascript_program_succeeds(runner: DifferentialRunner&, result: mutable DifferentialRun&) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        catch run_differential_elisascript_program(runner, result):
            ok:
                return true
            error e:
                return false


def append_runtime_observations_succeeds(storage: darray[EsIr::RuntimeValue]&, observations: darray[EsIr::Observation], values: mutable darray[DifferentialValue]&, converted: mutable darray[DifferentialObservation]&) -> bool:
    can Memory.Allocate, Abort.Panic:
        catch append_differential_observations_from_runtime(storage, observations, values, converted):
            ok:
                return true
            error e:
                return false


def execute_process_succeeds(invocation: DifferentialProcessInvocation) -> bool:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        region process_check(65536):
            catch execute_differential_process(invocation):
                ok:
                    return true
                error e:
                    return false


@test
def differential_case_validation_binds_runners_world_and_manifest() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        reference: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/reference", arguments: [], timeout_steps: 10}
        candidate: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: "candidate.elisascript", arguments: [], timeout_steps: 10}
        world: DifferentialWorld = DifferentialWorld{working_directory: "/tmp/differential-case", files: [DifferentialWorldFile{path: "input.txt", contents: "input", mode: 420}], environment: [DifferentialEnvironmentEntry{name: "MODE", value: "test"}], argv: ["alpha beta"], stdin: "stdin", locale: "C", timezone: "UTC", seed: 7u64}
        case: DifferentialCase = DifferentialCase{name: "case-world", reference: reference, candidate: candidate, world: world, seed: 9u64, artifact_policy: DifferentialArtifactPolicy.Always}
        check: DifferentialCaseCheck = validate_differential_case(case)
        assert check.valid
        assert check.issue == DifferentialCaseIssueKind.None
        manifest: DifferentialArtifactManifest = make_differential_artifact_manifest(case, 123u64)
        assert manifest.case_name == "case-world"
        assert manifest.world_seed == 7u64
        assert manifest.world_fingerprint != 0
        assert manifest.case_seed == 9u64
        assert manifest.module_fingerprint == 123u64
        manifest_bytes: darray[u8] = canonical_differential_artifact_manifest_bytes(manifest)
        assert manifest_bytes.count > 0
        decoded_manifest: DifferentialArtifactManifestDecode = decode_differential_artifact_manifest(manifest_bytes)
        assert decoded_manifest.valid
        assert decoded_manifest.manifest.format_version == 2
        assert decoded_manifest.manifest.case_name == "case-world"
        assert decoded_manifest.manifest.world_fingerprint == manifest.world_fingerprint
        assert differential_artifact_manifest_bytes_valid(manifest_bytes)
        first_fingerprint: u64 = differential_artifact_manifest_fingerprint(manifest)
        changed_manifest: mutable DifferentialArtifactManifest = manifest
        changed_manifest.case_seed <- 10u64
        assert first_fingerprint != differential_artifact_manifest_fingerprint(changed_manifest)
        changed_case: mutable DifferentialCase = case
        changed_case.world.stdin <- "changed-stdin"
        changed_world_manifest: DifferentialArtifactManifest = make_differential_artifact_manifest(changed_case, 123u64)
        assert changed_world_manifest.world_fingerprint != manifest.world_fingerprint
        assert differential_artifact_manifest_fingerprint(changed_world_manifest) != first_fingerprint
        truncated: mutable darray[u8] = manifest_bytes
        _ = truncated.pop()
        assert not differential_artifact_manifest_bytes_valid(truncated)


@test
def differential_case_validation_rejects_duplicate_world_paths() -> void:
    reference: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/reference", arguments: [], timeout_steps: 10}
    candidate: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: "candidate.elisascript", arguments: [], timeout_steps: 10}
    world: DifferentialWorld = DifferentialWorld{files: [DifferentialWorldFile{path: "same", contents: "one"}, DifferentialWorldFile{path: "same", contents: "two"}]}
    case: DifferentialCase = DifferentialCase{name: "duplicate-world", reference: reference, candidate: candidate, world: world}
    check: DifferentialCaseCheck = validate_differential_case(case)
    assert not check.valid
    assert check.issue == DifferentialCaseIssueKind.DuplicateWorldPath


@test
def differential_case_validation_rejects_world_path_escape() -> void:
    reference: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/reference", arguments: [], timeout_steps: 10}
    candidate: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: "candidate.elisascript", arguments: [], timeout_steps: 10}
    traversal: DifferentialCase = DifferentialCase{name: "traversal-world", reference: reference, candidate: candidate, world: DifferentialWorld{files: [DifferentialWorldFile{path: "../escape", contents: "blocked"}]}}
    absolute: DifferentialCase = DifferentialCase{name: "absolute-world", reference: reference, candidate: candidate, world: DifferentialWorld{files: [DifferentialWorldFile{path: "/outside", contents: "blocked"}]}}
    traversal_check: DifferentialCaseCheck = validate_differential_case(traversal)
    absolute_check: DifferentialCaseCheck = validate_differential_case(absolute)
    assert not traversal_check.valid
    assert traversal_check.issue == DifferentialCaseIssueKind.InvalidWorldPath
    assert not absolute_check.valid
    assert absolute_check.issue == DifferentialCaseIssueKind.InvalidWorldPath


@test
def differential_case_validation_rejects_invalid_tolerance() -> void:
    reference: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/reference", arguments: [], timeout_steps: 10}
    candidate: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: "candidate.elisascript", arguments: [], timeout_steps: 10}
    case: DifferentialCase = DifferentialCase{name: "invalid-tolerance", reference: reference, candidate: candidate, tolerance: DifferentialFloatTolerance{absolute: -0.001}}
    check: DifferentialCaseCheck = validate_differential_case(case)
    assert not check.valid
    assert check.issue == DifferentialCaseIssueKind.InvalidTolerance


@test
def differential_world_snapshot_detects_order_contamination() -> void:
    can Memory.Allocate, Abort.Panic:
        world: DifferentialWorld = DifferentialWorld{files: [DifferentialWorldFile{path: "input.txt", contents: "stable"}], environment: [DifferentialEnvironmentEntry{name: "MODE", value: "test"}], argv: ["case"], stdin: "payload", locale: "C", timezone: "UTC", seed: 17u64}
        snapshot: DifferentialWorldSnapshot = make_differential_world_snapshot(world)
        restored: DifferentialWorldSnapshotCheck = validate_differential_world_snapshot(world, snapshot)
        assert restored.valid
        assert restored.issue == DifferentialWorldSnapshotIssue.None

        changed: mutable DifferentialWorld = world
        changed.stdin <- "candidate-mutated-world"
        contaminated: DifferentialWorldSnapshotCheck = validate_differential_world_snapshot(changed, snapshot)
        assert not contaminated.valid
        assert contaminated.issue == DifferentialWorldSnapshotIssue.FingerprintMismatch

        malformed: mutable DifferentialWorldSnapshot = snapshot
        malformed.world_fingerprint <- 0
        malformed_check: DifferentialWorldSnapshotCheck = validate_differential_world_snapshot(world, malformed)
        assert not malformed_check.valid
        assert malformed_check.issue == DifferentialWorldSnapshotIssue.InvalidSnapshot


@test
def differential_case_shrinker_is_bounded_deterministic_and_validity_preserving() -> void:
    can Memory.Allocate, Abort.Panic:
        reference: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/reference", arguments: [], timeout_steps: 10}
        candidate: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: "candidate.elisascript", arguments: [], timeout_steps: 10}
        world: DifferentialWorld = DifferentialWorld{files: [DifferentialWorldFile{path: "one.txt", contents: "one"}, DifferentialWorldFile{path: "two.txt", contents: "two"}], environment: [DifferentialEnvironmentEntry{name: "A", value: "1"}, DifferentialEnvironmentEntry{name: "B", value: "2"}], argv: ["first", "second"], stdin: "input"}
        case: DifferentialCase = DifferentialCase{name: "shrink-case", reference: reference, candidate: candidate, world: world}
        result: DifferentialShrinkResult = shrink_differential_case(case, 32)
        assert result.valid
        assert result.candidates.count == 7
        assert result.candidates[0].kind == DifferentialShrinkKind.RemoveWorldFile
        assert result.candidates[2].kind == DifferentialShrinkKind.RemoveWorldArgument
        assert result.candidates[4].kind == DifferentialShrinkKind.RemoveWorldEnvironment
        assert result.candidates[6].kind == DifferentialShrinkKind.ClearWorldStdin
        assert case.world.files.count == 2
        assert case.world.environment.count == 2
        assert case.world.argv.count == 2
        assert case.world.stdin == "input"

        limited: DifferentialShrinkResult = shrink_differential_case(case, 2)
        assert limited.valid
        assert limited.candidates.count == 2

        invalid: DifferentialCase = DifferentialCase{name: "", reference: reference, candidate: candidate}
        rejected: DifferentialShrinkResult = shrink_differential_case(invalid)
        assert not rejected.valid
        assert rejected.candidates.count == 0


@test
def differential_oracle_contract_keeps_external_sources_independent() -> void:
    can Memory.Allocate, Abort.Panic:
        python_runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.PythonAdapter, name: "python-reference", target: "python3", entry: "oracle.py", arguments: [], timeout_steps: 10}
        python: DifferentialOracle = make_differential_oracle(DifferentialOracleLanguage.Python, "python-reference", python_runner, "3.12")
        python_check: DifferentialOracleCheck = validate_differential_oracle(python)
        assert python_check.valid
        assert python_check.issue == DifferentialOracleIssue.None

        shell_runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "shell-reference", target: "/bin/sh", arguments: ["oracle.sh"], timeout_steps: 10}
        shell: DifferentialOracle = make_differential_oracle(DifferentialOracleLanguage.Shell, "shell-reference", shell_runner)
        assert validate_differential_oracle(shell).valid

        candidate_runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: "candidate.elisascript", arguments: [], timeout_steps: 10}
        candidate_oracle: DifferentialOracle = DifferentialOracle{name: "candidate", language: DifferentialOracleLanguage.Native, runner: candidate_runner}
        rejected: DifferentialOracleCheck = validate_differential_oracle(candidate_oracle)
        assert not rejected.valid
        assert rejected.issue == DifferentialOracleIssue.NotIndependent

        unknown: mutable DifferentialOracle = python
        unknown.version <- "bad\0version"
        unknown_check: DifferentialOracleCheck = validate_differential_oracle(unknown)
        assert not unknown_check.valid
        assert unknown_check.issue == DifferentialOracleIssue.InvalidVersion


@test
def differential_comparison_artifact_roundtrip_preserves_first_mismatch() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        reference: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/reference", arguments: [], timeout_steps: 10}
        candidate: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: "candidate.elisascript", arguments: [], timeout_steps: 10}
        case: DifferentialCase = DifferentialCase{name: "comparison-report", reference: reference, candidate: candidate}
        manifest: DifferentialArtifactManifest = make_differential_artifact_manifest(case, 777u64)
        comparison: DifferentialComparison = DifferentialComparison{equal: false, kind: DifferentialDifferenceKind.Stdout, index: 2, reason: "stdout differs", reference_text: "reference", candidate_text: "candidate", reference_engine: EsIr::ExecutionEngine.ReferenceInterpreter, candidate_engine: EsIr::ExecutionEngine.DirectBytecode}
        artifact: DifferentialComparisonArtifact = make_differential_comparison_artifact(manifest, comparison)
        assert artifact.manifest_fingerprint == differential_artifact_manifest_fingerprint(manifest)
        assert artifact.kind == DifferentialDifferenceKind.Stdout
        assert artifact.index == 2
        encoded: darray[u8] = canonical_differential_comparison_artifact_bytes(artifact)
        assert encoded.count > 0
        decoded: DifferentialComparisonArtifactDecode = decode_differential_comparison_artifact(encoded)
        assert decoded.valid
        assert decoded.artifact.format_version == 2
        assert decoded.artifact.manifest_fingerprint == artifact.manifest_fingerprint
        assert decoded.artifact.reason == "stdout differs"
        assert decoded.artifact.reference_text == "reference"
        assert decoded.artifact.candidate_text == "candidate"
        assert differential_comparison_artifact_bytes_valid(encoded)
        first_fingerprint: u64 = differential_comparison_artifact_fingerprint(artifact)
        changed: mutable DifferentialComparisonArtifact = artifact
        changed.candidate_text <- "changed"
        assert first_fingerprint != differential_comparison_artifact_fingerprint(changed)
        truncated: mutable darray[u8] = encoded
        _ = truncated.pop()
        assert not differential_comparison_artifact_bytes_valid(truncated)


@test
def differential_process_stream_artifact_roundtrip_preserves_complete_channels() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        reference: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/reference", arguments: [], timeout_steps: 10}
        candidate: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: "candidate.elisascript", arguments: [], timeout_steps: 10}
        case: DifferentialCase = DifferentialCase{name: "process-stream-report", reference: reference, candidate: candidate}
        manifest: DifferentialArtifactManifest = make_differential_artifact_manifest(case, 778u64)
        run: DifferentialRun = DifferentialRun{exit_status: -9, error_text: "spawn failed", stdout: "out\0bytes", stderr: "err", observations: [], outcome: DifferentialRunOutcome.SpawnFailure}
        artifact: DifferentialProcessStreamArtifact = make_differential_process_stream_artifact(manifest, DifferentialArtifactSide.Candidate, run)
        assert artifact.manifest_fingerprint == differential_artifact_manifest_fingerprint(manifest)
        assert artifact.side == DifferentialArtifactSide.Candidate
        assert artifact.outcome == DifferentialRunOutcome.SpawnFailure
        assert artifact.exit_status == -9
        encoded: darray[u8] = canonical_differential_process_stream_artifact_bytes(artifact)
        assert encoded.count > 0
        decoded: DifferentialProcessStreamArtifactDecode = decode_differential_process_stream_artifact(encoded)
        assert decoded.valid
        assert decoded.artifact.format_version == 1
        assert decoded.artifact.side == DifferentialArtifactSide.Candidate
        assert decoded.artifact.outcome == DifferentialRunOutcome.SpawnFailure
        assert decoded.artifact.exit_status == -9
        assert decoded.artifact.error_text == "spawn failed"
        assert decoded.artifact.stdout == "out\0bytes"
        assert decoded.artifact.stderr == "err"
        assert differential_process_stream_artifact_bytes_valid(encoded)
        first_fingerprint: u64 = differential_process_stream_artifact_fingerprint(artifact)
        changed: mutable DifferentialProcessStreamArtifact = artifact
        changed.stderr <- "changed"
        assert first_fingerprint != differential_process_stream_artifact_fingerprint(changed)
        malformed_side: mutable darray[u8] = encoded
        malformed_side[13] <- 2
        assert not differential_process_stream_artifact_bytes_valid(malformed_side)
        trailing: mutable darray[u8] = encoded
        trailing.push(0)
        assert not differential_process_stream_artifact_bytes_valid(trailing)
        truncated: mutable darray[u8] = encoded
        _ = truncated.pop()
        assert not differential_process_stream_artifact_bytes_valid(truncated)


