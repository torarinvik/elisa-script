@test
def differential_runtime_adapter_copies_arrays_and_process_snapshots() -> void:
    can Memory.Allocate, Abort.Panic:
        storage: darray[EsIr::RuntimeValue] = [EsIr::runtime_int(7), EsIr::runtime_text("same"), EsIr::runtime_array(0, 2), EsIr::runtime_text("one"), EsIr::runtime_int(1), EsIr::runtime_text("two"), EsIr::runtime_int(2)]
        observations: darray[EsIr::Observation] = [
            EsIr::Observation{trace: 11, value: EsIr::runtime_array(0, 3)},
            EsIr::Observation{trace: 12, value: EsIr::runtime_process_capture(4, "out", "err")},
            EsIr::Observation{trace: 13, value: EsIr::runtime_map(3, 2)}
        ]
        values: mutable darray[DifferentialValue] = []
        converted: mutable darray[DifferentialObservation] = []
        succeeded: bool = append_runtime_observations_succeeds(storage, observations, values, converted)

        assert succeeded
        assert converted.count == 3
        assert converted[0].value.kind == DifferentialValueKind.Array
        assert converted[0].value.array_count == 3
        assert values[converted[0].value.array_start.usize() + 2].array_count == 2
        assert values[values[converted[0].value.array_start.usize() + 2].array_start.usize() + 1].text == "same"
        assert converted[1].value.kind == DifferentialValueKind.ProcessCapture
        assert converted[1].value.process_exit_status == 4
        assert converted[1].value.process_stdout == "out"
        assert converted[1].value.process_stderr == "err"
        assert converted[2].value.kind == DifferentialValueKind.Map
        assert converted[2].value.map_count == 2
        assert values[converted[2].value.map_start.usize()].text == "one"
        assert values[converted[2].value.map_start.usize() + 3].integer == 2


@test
def differential_runtime_adapter_rejects_out_of_bounds_array_snapshots() -> void:
    can Memory.Allocate, Abort.Panic:
        storage: darray[EsIr::RuntimeValue] = [EsIr::runtime_int(7)]
        observations: darray[EsIr::Observation] = [EsIr::Observation{trace: 13, value: EsIr::runtime_array(1, 2)}, EsIr::Observation{trace: 14, value: EsIr::runtime_map(1, 1)}]
        values: mutable darray[DifferentialValue] = []
        converted: mutable darray[DifferentialObservation] = []
        succeeded: bool = append_runtime_observations_succeeds(storage, observations, values, converted)

        assert not succeeded


@test
def differential_runtime_adapter_rejects_wrapping_array_snapshots() -> void:
    can Memory.Allocate, Abort.Panic:
        storage: darray[EsIr::RuntimeValue] = [EsIr::runtime_int(7)]
        observations: darray[EsIr::Observation] = [EsIr::Observation{trace: 15, value: EsIr::RuntimeValue{kind: EsIr::RuntimeValueKind.Array, array_start: 4294967295, array_count: 1}}]
        values: mutable darray[DifferentialValue] = []
        converted: mutable darray[DifferentialObservation] = []
        succeeded: bool = append_runtime_observations_succeeds(storage, observations, values, converted)

        assert not succeeded


@test
def differential_runtime_adapter_rejects_malformed_map_snapshots() -> void:
    can Memory.Allocate, Abort.Panic:
        storage: darray[EsIr::RuntimeValue] = [EsIr::runtime_int(7)]
        out_of_bounds: darray[EsIr::Observation] = [EsIr::Observation{trace: 19, value: EsIr::runtime_map(0, 1)}]
        values: mutable darray[DifferentialValue] = []
        converted: mutable darray[DifferentialObservation] = []
        assert not append_runtime_observations_succeeds(storage, out_of_bounds, values, converted)
        wrapping: darray[EsIr::Observation] = [EsIr::Observation{trace: 20, value: EsIr::RuntimeValue{kind: EsIr::RuntimeValueKind.Map, map_start: 4294967295, map_count: 1}}]
        values <- []
        converted <- []
        assert not append_runtime_observations_succeeds(storage, wrapping, values, converted)


