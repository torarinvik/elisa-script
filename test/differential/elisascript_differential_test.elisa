@test
def differential_elisascript_program_runner_accepts_python_append_alias() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-append.elisascript"
