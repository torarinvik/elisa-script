        assert captured.return_value.kind == DifferentialValueKind.Int
        assert captured.return_value.integer == 4
        assert captured.observations.count == 8
        assert captured.observations[0].value.integer == 0
        assert captured.observations[1].value.text == "one"
        assert captured.observations[2].value.integer == 1
        assert captured.observations[3].value.text == "two"
        assert captured.observations[4].value.integer == 0
        assert captured.observations[5].value.text == "one"
        assert captured.observations[6].value.integer == 1
        assert captured.observations[7].value.text == "two"
        _ = remove_file(path.cast[cstr])


