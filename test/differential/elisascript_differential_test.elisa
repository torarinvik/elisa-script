    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-text-isascii.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    observe(\"Elisa42\".isascii() and \"\".isascii())\n    return 1i64\n"
