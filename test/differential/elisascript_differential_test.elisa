include "../../src/testing/differential.elisa"

using EsDifferential


def int_value(value: i64) -> DifferentialValue:
    return DifferentialValue{kind: DifferentialValueKind.Int, integer: value}


def text_value(value: sview) -> DifferentialValue:
    return DifferentialValue{kind: DifferentialValueKind.Text, text: value}


def float_value(value: f64) -> DifferentialValue:
    return DifferentialValue{kind: DifferentialValueKind.Float, decimal: value}


def array_value(storage: mutable darray[DifferentialValue]&, values: darray[DifferentialValue]) -> DifferentialValue can[Memory.Allocate, Abort.Panic]:
    return differential_array_value(storage, values)


def map_value(storage: mutable darray[DifferentialValue]&, values: darray[DifferentialValue]) -> DifferentialValue can[Memory.Allocate, Abort.Panic]:
    return differential_map_value(storage, values)


def run_elisascript_succeeds(runner: DifferentialRunner&, result: mutable DifferentialRun&) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        catch run_differential_elisascript(runner, result):
            ok:
                return true
            error e:
                return false


def run_elisascript_program_succeeds(runner: DifferentialRunner&, result: mutable DifferentialRun&) -> bool:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        catch run_differential_elisascript_program(runner, result):
            ok:
                return true
            error e:
                return false


def append_runtime_observations_succeeds(storage: darray[EsIr::RuntimeValue]&, observations: darray[EsIr::Observation], values: mutable darray[DifferentialValue]&, converted: mutable darray[DifferentialObservation]&) -> bool:
    can Memory.Allocate, Abort.Panic:
        catch append_differential_observations_from_runtime(storage, observations, values, converted):
            ok:
                return true
            error e:
                return false


def execute_process_succeeds(invocation: DifferentialProcessInvocation) -> bool:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        region process_check(65536):
            catch execute_differential_process(invocation):
                ok:
                    return true
                error e:
                    return false


@test
def differential_process_capture_adapter_materializes_one_snapshot() -> void:
    capture: EsIr::RuntimeValue = EsIr::RuntimeValue{kind: EsIr::RuntimeValueKind.ProcessCapture, process_exit_status: 7, process_stdout: "out", process_stderr: "err"}
    observations: darray[DifferentialObservation] = [DifferentialObservation{trace: 11, value: int_value(42)}]
    run: DifferentialRun = differential_run_from_process_capture(capture, observations)

    assert run.exit_status == 7
    assert run.return_value.kind == DifferentialValueKind.Int
    assert run.return_value.integer == 7
    assert run.stdout == "out"
    assert run.stderr == "err"
    assert run.error_text == ""
    assert run.observations.count == 1
    assert run.observations[0].trace == 11
    assert run.observations[0].value.integer == 42


@test
def differential_process_capture_adapter_rejects_non_capture_values() -> void:
    capture: EsIr::RuntimeValue = EsIr::RuntimeValue{kind: EsIr::RuntimeValueKind.Int, integer: 7}
    run: DifferentialRun = differential_run_from_process_capture(capture, [])

    assert run.error_text == "expected ProcessCapture runtime value"
    assert run.observations.count == 0


@test
def differential_runner_validation_accepts_native_process_contract() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/tool", arguments: ["alpha beta", "*.elisascript"], stdin: "input", timeout_steps: 100}
    check: DifferentialRunnerCheck = validate_differential_runner(runner)

    assert check.valid
    assert check.issue == DifferentialRunnerIssueKind.None


@test
def differential_runner_validation_accepts_elisascript_file_contract() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptFile, name: "candidate", target: "candidate.elisascript", entry: "main", arguments: ["input"], timeout_steps: 1000}
    check: DifferentialRunnerCheck = validate_differential_runner(runner)

    assert check.valid
    assert check.issue == DifferentialRunnerIssueKind.None


@test
def differential_runner_validation_accepts_standard_elisascript_program_contract() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: "candidate.elisascript", arguments: ["input"], timeout_steps: 1000}
    check: DifferentialRunnerCheck = validate_differential_runner(runner)

    assert check.valid
    assert check.issue == DifferentialRunnerIssueKind.None


@test
def differential_runner_validation_requires_adapter_entry() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.PythonAdapter, name: "candidate", target: "adapter.py", arguments: [], timeout_steps: 10}
    check: DifferentialRunnerCheck = validate_differential_runner(runner)

    assert not check.valid
    assert check.issue == DifferentialRunnerIssueKind.MissingEntry


@test
def differential_runner_validation_reports_nul_argument_before_timeout() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "candidate", target: "tool", arguments: ["safe", "bad\0arg"], timeout_steps: 0}
    check: DifferentialRunnerCheck = validate_differential_runner(runner)

    assert not check.valid
    assert check.issue == DifferentialRunnerIssueKind.EmbeddedNul
    assert check.argument_index == 1


@test
def differential_runner_validation_rejects_nul_working_directory() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "candidate", target: "tool", arguments: [], working_directory: "bad\0directory", timeout_steps: 10}
    check: DifferentialRunnerCheck = validate_differential_runner(runner)

    assert not check.valid
    assert check.issue == DifferentialRunnerIssueKind.EmbeddedNul
    assert check.reason == "runner working directory contains NUL"


@test
def differential_process_preparation_preserves_native_argv_and_policy() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/tool", arguments: ["alpha beta", "*.elisascript"], working_directory: "/tmp/case", stdin: "input", protocol: "lines", timeout_steps: 100}
    fallback: DifferentialProcessInvocation = DifferentialProcessInvocation{executable: "", arguments: []}
    invocation: DifferentialProcessInvocation = try prepare_differential_process(runner) else fallback

    assert invocation.executable == "/usr/bin/tool"
    assert invocation.entry == ""
    assert invocation.arguments.count == 2
    assert invocation.arguments[0] == "alpha beta"
    assert invocation.arguments[1] == "*.elisascript"
    assert invocation.working_directory == "/tmp/case"
    assert invocation.stdin == "input"
    assert invocation.protocol == "lines"
    assert invocation.timeout_steps == 100


@test
def differential_process_preparation_prefixes_python_entry_without_shell_joining() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.PythonAdapter, name: "candidate", target: "python3", entry: "adapter.py", arguments: ["alpha beta", "*.elisascript"], timeout_steps: 10}
    fallback: DifferentialProcessInvocation = DifferentialProcessInvocation{executable: "", arguments: []}
    invocation: DifferentialProcessInvocation = try prepare_differential_process(runner) else fallback

    assert invocation.executable == "python3"
    assert invocation.entry == "adapter.py"
    assert invocation.arguments.count == 2
    assert invocation.arguments[0] == "alpha beta"
    assert invocation.arguments[1] == "*.elisascript"


@test
def differential_process_preparation_rejects_in_process_kind() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.InProcessFunction, name: "candidate", target: "function", arguments: [], timeout_steps: 10}
    fallback: DifferentialProcessInvocation = DifferentialProcessInvocation{executable: "", arguments: []}
    invocation: DifferentialProcessInvocation = try prepare_differential_process(runner) else fallback

    assert invocation.executable == ""
    assert invocation.arguments.count == 0


@test
def differential_process_execution_captures_native_stdout_and_stderr() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        invocation: DifferentialProcessInvocation = DifferentialProcessInvocation{executable: "/bin/sh", arguments: ["-c", "printf out; printf err >&2"], timeout_steps: 10000}
        captured: DifferentialRun = try execute_differential_process(invocation) else DifferentialRun{error_text: "process failed", observations: []}

        assert captured.error_text == ""
        assert captured.exit_status == 0
        assert captured.stdout == "out"
        assert captured.stderr == "err"


@test
def differential_process_execution_feeds_stdin_without_shell_joining() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        invocation: DifferentialProcessInvocation = DifferentialProcessInvocation{executable: "/bin/cat", arguments: [], stdin: "line one\nline two\n", timeout_steps: 10000}
        captured: DifferentialRun = try execute_differential_process(invocation) else DifferentialRun{error_text: "process failed", observations: []}

        assert captured.error_text == ""
        assert captured.exit_status == 0
        assert captured.stdout == "line one\nline two\n"
        assert captured.stderr == ""


@test
def differential_process_execution_keeps_nonzero_exit_status_as_data() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        invocation: DifferentialProcessInvocation = DifferentialProcessInvocation{executable: "/usr/bin/false", arguments: [], timeout_steps: 10000}
        captured: DifferentialRun = try execute_differential_process(invocation) else DifferentialRun{error_text: "process failed", observations: []}

        assert captured.error_text == ""
        assert captured.exit_status == 1
        assert captured.stdout == ""
        assert captured.stderr == ""


@test
def differential_process_execution_rejects_invalid_invocation_through_error_channel() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        invalid: DifferentialProcessInvocation = DifferentialProcessInvocation{executable: "", arguments: [], timeout_steps: 10}
        assert not execute_process_succeeds(invalid)


@test
def differential_process_execution_reports_bounded_timeout() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        invocation: DifferentialProcessInvocation = DifferentialProcessInvocation{executable: "/bin/sleep", arguments: ["1"], timeout_steps: 1}
        assert not execute_process_succeeds(invocation)


@test
def differential_runner_executes_validated_native_process_end_to_end() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "printf", target: "/usr/bin/printf", arguments: ["%s", "runner"], timeout_steps: 10000}
        captured: DifferentialRun = try run_differential_process(runner) else DifferentialRun{error_text: "runner failed", observations: []}

        assert captured.error_text == ""
        assert captured.exit_status == 0
        assert captured.stdout == "runner"
        assert captured.stderr == ""


@test
def differential_elisascript_runner_captures_typed_return_and_observations() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-candidate.elisascript"
        source: static u8& = "def main(value: sview) -> i64:\n    observe(value)\n    return 42\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written == 64

        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptFile, name: "candidate", target: sview(path, 0, -1), entry: "main", arguments: ["input"], timeout_steps: 10000}
        captured: mutable DifferentialRun = DifferentialRun{observations: []}
        assert run_elisascript_succeeds(runner, captured)

        assert captured.error_text == ""
        assert captured.exit_status == 0
        assert captured.return_value.kind == DifferentialValueKind.Int
        assert captured.return_value.integer == 42
        assert captured.observations.count == 1
        assert captured.observations[0].value.kind == DifferentialValueKind.Text
        assert captured.observations[0].value.text == "input"
        _ = remove_file(path.cast[cstr])


@test
def differential_elisascript_program_runner_maps_return_to_exit_status() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-program.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    observe(arguments)\n    if arguments.count == 1u64 and arguments[0] == \"input\":\n        return 7\n    return 1\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: sview(path, 0, -1), arguments: ["input"], timeout_steps: 10000}
        captured: mutable DifferentialRun = DifferentialRun{observations: []}
        assert run_elisascript_program_succeeds(runner, captured)

        assert captured.error_text == ""
        assert captured.exit_status == 7
        assert captured.return_value.kind == DifferentialValueKind.Int
        assert captured.return_value.integer == 7
        assert captured.observations.count == 1
        assert captured.observations[0].value.kind == DifferentialValueKind.Array
        _ = remove_file(path.cast[cstr])


@test
def differential_comparison_accepts_identical_runs() -> void:
    reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(42)}], stdout: "ok", stderr: "", error_text: ""}
    candidate: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(42)}], stdout: "ok", stderr: "", error_text: ""}
    comparison: DifferentialComparison = compare_differential_runs(reference, candidate)

    assert comparison.equal
    assert comparison.kind == DifferentialDifferenceKind.Equal


@test
def differential_comparison_reports_return_value_difference() -> void:
    reference: DifferentialRun = DifferentialRun{return_value: int_value(1), observations: []}
    candidate: DifferentialRun = DifferentialRun{return_value: int_value(2), observations: []}
    comparison: DifferentialComparison = compare_differential_runs(reference, candidate)

    assert not comparison.equal
    assert comparison.kind == DifferentialDifferenceKind.ReturnValue
    assert comparison.reference_value.integer == 1
    assert comparison.candidate_value.integer == 2


@test
def differential_comparison_reports_first_structured_difference() -> void:
    reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(42)}, DifferentialObservation{trace: 8, value: text_value("reference")}], stdout: "ok", stderr: "", error_text: ""}
    candidate: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(42)}, DifferentialObservation{trace: 8, value: text_value("candidate")}], stdout: "ok", stderr: "", error_text: ""}
    comparison: DifferentialComparison = compare_differential_runs(reference, candidate)

    assert not comparison.equal
    assert comparison.kind == DifferentialDifferenceKind.ObservationValue
    assert comparison.index == 1
    assert comparison.reference_value.text == "reference"
    assert comparison.candidate_value.text == "candidate"


@test
def differential_comparison_compares_float_observations_exactly() -> void:
    reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 9, value: float_value(1.25)}]}
    same: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 9, value: float_value(1.25)}]}
    different: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 9, value: float_value(1.5)}]}
    equal_comparison: DifferentialComparison = compare_differential_runs(reference, same)
    different_comparison: DifferentialComparison = compare_differential_runs(reference, different)

    assert equal_comparison.equal
    assert not different_comparison.equal
    assert different_comparison.kind == DifferentialDifferenceKind.ObservationValue
    assert different_comparison.reference_value.decimal == 1.25
    assert different_comparison.candidate_value.decimal == 1.5


@test
def differential_comparison_compares_nested_array_observations_recursively() -> void:
    can Memory.Allocate, Abort.Panic:
        reference_values: mutable darray[DifferentialValue] = []
        same_values: mutable darray[DifferentialValue] = []
        different_values: mutable darray[DifferentialValue] = []
        reference_inner: DifferentialValue = array_value(reference_values, [text_value("same"), float_value(2.5)])
        same_inner: DifferentialValue = array_value(same_values, [text_value("same"), float_value(2.5)])
        different_inner: DifferentialValue = array_value(different_values, [text_value("changed"), float_value(2.5)])
        reference_value: DifferentialValue = array_value(reference_values, [int_value(7), reference_inner])
        same_value: DifferentialValue = array_value(same_values, [int_value(7), same_inner])
        different_value: DifferentialValue = array_value(different_values, [int_value(7), different_inner])
        reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 10, value: reference_value}], values: reference_values}
        same: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 10, value: same_value}], values: same_values}
        different: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 10, value: different_value}], values: different_values}
        equal_comparison: DifferentialComparison = compare_differential_runs(reference, same)
        different_comparison: DifferentialComparison = compare_differential_runs(reference, different)

        assert equal_comparison.equal
        assert not different_comparison.equal
        assert different_comparison.kind == DifferentialDifferenceKind.ObservationValue
        assert reference.values[different_comparison.reference_value.array_start.usize() + 1].array_start == 0
        assert reference.values[reference.values[different_comparison.reference_value.array_start.usize() + 1].array_start.usize()].text == "same"
        assert different.values[different.values[different_comparison.candidate_value.array_start.usize() + 1].array_start.usize()].text == "changed"


@test
def differential_comparison_compares_map_observations_order_insensitively() -> void:
    can Memory.Allocate, Abort.Panic:
        reference_values: mutable darray[DifferentialValue] = []
        same_values: mutable darray[DifferentialValue] = []
        different_values: mutable darray[DifferentialValue] = []
        reference_map: DifferentialValue = map_value(reference_values, [text_value("one"), int_value(1), text_value("two"), int_value(2)])
        same_map: DifferentialValue = map_value(same_values, [text_value("two"), int_value(2), text_value("one"), int_value(1)])
        different_map: DifferentialValue = map_value(different_values, [text_value("two"), int_value(3), text_value("one"), int_value(1)])
        reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 14, value: reference_map}], values: reference_values}
        same: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 14, value: same_map}], values: same_values}
        different: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 14, value: different_map}], values: different_values}
        equal_comparison: DifferentialComparison = compare_differential_runs(reference, same)
        different_comparison: DifferentialComparison = compare_differential_runs(reference, different)

        assert equal_comparison.equal
        assert not different_comparison.equal
        assert different_comparison.kind == DifferentialDifferenceKind.ObservationValue


@test
def differential_map_comparison_matches_each_candidate_pair_once() -> void:
    can Memory.Allocate, Abort.Panic:
        reference_values: mutable darray[DifferentialValue] = []
        candidate_values: mutable darray[DifferentialValue] = []
        reference_map: DifferentialValue = map_value(reference_values, [int_value(1), text_value("same"), int_value(1), text_value("same"), int_value(2), text_value("other")])
        candidate_map: DifferentialValue = map_value(candidate_values, [int_value(1), text_value("same"), int_value(2), text_value("other"), int_value(3), text_value("unexpected")])
        reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 12, value: reference_map}], values: reference_values}
        candidate: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 12, value: candidate_map}], values: candidate_values}
        comparison: DifferentialComparison = compare_differential_runs(reference, candidate)

        assert not comparison.equal
        assert comparison.kind == DifferentialDifferenceKind.ObservationValue


@test
def differential_runtime_adapter_copies_arrays_and_process_snapshots() -> void:
    can Memory.Allocate, Abort.Panic:
        storage: darray[EsIr::RuntimeValue] = [EsIr::runtime_int(7), EsIr::runtime_text("same"), EsIr::runtime_array(0, 2), EsIr::runtime_text("one"), EsIr::runtime_int(1), EsIr::runtime_text("two"), EsIr::runtime_int(2)]
        observations: darray[EsIr::Observation] = [
            EsIr::Observation{trace: 11, value: EsIr::runtime_array(0, 3)},
            EsIr::Observation{trace: 12, value: EsIr::runtime_process_capture(4, "out", "err")},
            EsIr::Observation{trace: 13, value: EsIr::runtime_map(3, 2)}
        ]
        values: mutable darray[DifferentialValue] = []
        converted: mutable darray[DifferentialObservation] = []
        succeeded: bool = append_runtime_observations_succeeds(storage, observations, values, converted)

        assert succeeded
        assert converted.count == 3
        assert converted[0].value.kind == DifferentialValueKind.Array
        assert converted[0].value.array_count == 3
        assert values[converted[0].value.array_start.usize() + 2].array_count == 2
        assert values[values[converted[0].value.array_start.usize() + 2].array_start.usize() + 1].text == "same"
        assert converted[1].value.kind == DifferentialValueKind.ProcessCapture
        assert converted[1].value.process_exit_status == 4
        assert converted[1].value.process_stdout == "out"
        assert converted[1].value.process_stderr == "err"
        assert converted[2].value.kind == DifferentialValueKind.Map
        assert converted[2].value.map_count == 2
        assert values[converted[2].value.map_start.usize()].text == "one"
        assert values[converted[2].value.map_start.usize() + 3].integer == 2


@test
def differential_runtime_adapter_rejects_out_of_bounds_array_snapshots() -> void:
    can Memory.Allocate, Abort.Panic:
        storage: darray[EsIr::RuntimeValue] = [EsIr::runtime_int(7)]
        observations: darray[EsIr::Observation] = [EsIr::Observation{trace: 13, value: EsIr::runtime_array(1, 2)}, EsIr::Observation{trace: 14, value: EsIr::runtime_map(1, 1)}]
        values: mutable darray[DifferentialValue] = []
        converted: mutable darray[DifferentialObservation] = []
        succeeded: bool = append_runtime_observations_succeeds(storage, observations, values, converted)

        assert not succeeded


@test
def differential_comparison_prioritizes_process_output_before_observations() -> void:
    reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(42)}], stdout: "reference", stderr: "", error_text: ""}
    candidate: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(99)}], stdout: "candidate", stderr: "", error_text: ""}
    comparison: DifferentialComparison = compare_differential_runs(reference, candidate)

    assert comparison.kind == DifferentialDifferenceKind.Stdout
    assert comparison.reference_text == "reference"
    assert comparison.candidate_text == "candidate"
