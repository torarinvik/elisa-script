@test
def differential_comparison_accepts_identical_runs() -> void:
    reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(42)}], stdout: "ok", stderr: "", error_text: ""}
    candidate: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(42)}], stdout: "ok", stderr: "", error_text: ""}
    comparison: DifferentialComparison = compare_differential_runs(reference, candidate)

    assert comparison.equal
    assert comparison.kind == DifferentialDifferenceKind.Equal


@test
def differential_comparison_distinguishes_crash_from_normal_exit() -> void:
    reference: DifferentialRun = DifferentialRun{exit_status: 1, observations: [], outcome: DifferentialRunOutcome.Completed}
    candidate: DifferentialRun = DifferentialRun{exit_status: 1, observations: [], outcome: DifferentialRunOutcome.Crash}
    comparison: DifferentialComparison = compare_differential_runs(reference, candidate)

    assert not comparison.equal
    assert comparison.kind == DifferentialDifferenceKind.Outcome
    assert comparison.reference_outcome == DifferentialRunOutcome.Completed
    assert comparison.candidate_outcome == DifferentialRunOutcome.Crash

    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/reference", arguments: [], timeout_steps: 10}
    candidate_runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: "candidate.elisascript", arguments: [], timeout_steps: 10}
    case: DifferentialCase = DifferentialCase{name: "crash-report", reference: runner, candidate: candidate_runner}
    manifest: DifferentialArtifactManifest = make_differential_artifact_manifest(case)
    artifact: DifferentialComparisonArtifact = make_differential_comparison_artifact(manifest, comparison)
    encoded: darray[u8] = canonical_differential_comparison_artifact_bytes(artifact)
    decoded: DifferentialComparisonArtifactDecode = decode_differential_comparison_artifact(encoded)
    assert decoded.valid
    assert decoded.artifact.kind == DifferentialDifferenceKind.Outcome
    assert decoded.artifact.candidate_outcome == DifferentialRunOutcome.Crash


@test
def differential_comparison_reports_return_value_difference() -> void:
    reference: DifferentialRun = DifferentialRun{return_value: int_value(1), observations: []}
    candidate: DifferentialRun = DifferentialRun{return_value: int_value(2), observations: []}
    comparison: DifferentialComparison = compare_differential_runs(reference, candidate)

    assert not comparison.equal
    assert comparison.kind == DifferentialDifferenceKind.ReturnValue
    assert comparison.reference_value.integer == 1
    assert comparison.candidate_value.integer == 2


@test
def differential_comparison_reports_first_structured_difference() -> void:
    reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(42)}, DifferentialObservation{trace: 8, value: text_value("reference")}], stdout: "ok", stderr: "", error_text: ""}
    candidate: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(42)}, DifferentialObservation{trace: 8, value: text_value("candidate")}], stdout: "ok", stderr: "", error_text: ""}
    comparison: DifferentialComparison = compare_differential_runs(reference, candidate)

    assert not comparison.equal
        assert comparison.kind == DifferentialDifferenceKind.ObservationValue
    assert comparison.index == 1
    assert comparison.reference_value.text == "reference"
    assert comparison.candidate_value.text == "candidate"


@test
def differential_comparison_compares_float_observations_exactly() -> void:
    reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 9, value: float_value(1.25)}]}
    same: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 9, value: float_value(1.25)}]}
    different: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 9, value: float_value(1.5)}]}
    equal_comparison: DifferentialComparison = compare_differential_runs(reference, same)
    different_comparison: DifferentialComparison = compare_differential_runs(reference, different)

    assert equal_comparison.equal
    assert not different_comparison.equal
    assert different_comparison.kind == DifferentialDifferenceKind.ObservationValue
    assert different_comparison.reference_value.decimal == 1.25
    assert different_comparison.candidate_value.decimal == 1.5


@test
def differential_comparison_accepts_explicit_float_tolerance() -> void:
    reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 9, value: float_value(100.0)}]}
    near: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 9, value: float_value(100.0005)}]}
    far: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 9, value: float_value(100.2)}]}
    exact: DifferentialComparison = compare_differential_runs(reference, near)
    tolerant: DifferentialComparison = compare_differential_runs(reference, near, DifferentialFloatTolerance{absolute: 0.0001, relative: 0.00001})
    rejected: DifferentialComparison = compare_differential_runs(reference, near, DifferentialFloatTolerance{absolute: -0.1})
    rejected_exact: DifferentialComparison = compare_differential_runs(reference, reference, DifferentialFloatTolerance{absolute: -0.1})
    too_far: DifferentialComparison = compare_differential_runs(reference, far, DifferentialFloatTolerance{absolute: 0.0001, relative: 0.00001})

    assert not exact.equal
    assert tolerant.equal
    assert not rejected.equal
    assert not rejected_exact.equal
    assert not too_far.equal


@test
def differential_comparison_requires_explicit_text_normalization() -> void:
    reference: DifferentialRun = DifferentialRun{stdout: "ok\n"}
    candidate: DifferentialRun = DifferentialRun{stdout: "ok"}
    exact: DifferentialComparison = compare_differential_runs(reference, candidate)
    normalized: DifferentialComparison = compare_differential_runs_with_policy(reference, candidate, DifferentialComparatorPolicy{text: DifferentialTextComparison.TrimFinalNewline})

    assert not exact.equal
    assert normalized.equal


@test
def differential_comparison_supports_explicit_ordered_maps() -> void:
    reference_values: mutable darray[DifferentialValue] = []
    candidate_values: mutable darray[DifferentialValue] = []
    reference_map: DifferentialValue = map_value(reference_values, [text_value("a"), int_value(1), text_value("b"), int_value(2)])
    candidate_map: DifferentialValue = map_value(candidate_values, [text_value("b"), int_value(2), text_value("a"), int_value(1)])
    reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 12, value: reference_map}], values: reference_values}
    candidate: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 12, value: candidate_map}], values: candidate_values}
    unordered: DifferentialComparison = compare_differential_runs_with_policy(reference, candidate, DifferentialComparatorPolicy{maps: DifferentialMapComparison.Unordered})
    ordered: DifferentialComparison = compare_differential_runs_with_policy(reference, candidate, DifferentialComparatorPolicy{maps: DifferentialMapComparison.Ordered})

    assert unordered.equal
    assert not ordered.equal


@test
def differential_comparison_compares_nested_array_observations_recursively() -> void:
    can Memory.Allocate, Abort.Panic:
        reference_values: mutable darray[DifferentialValue] = []
        same_values: mutable darray[DifferentialValue] = []
        different_values: mutable darray[DifferentialValue] = []
        reference_inner: DifferentialValue = array_value(reference_values, [text_value("same"), float_value(2.5)])
        same_inner: DifferentialValue = array_value(same_values, [text_value("same"), float_value(2.5)])
        different_inner: DifferentialValue = array_value(different_values, [text_value("changed"), float_value(2.5)])
        reference_value: DifferentialValue = array_value(reference_values, [int_value(7), reference_inner])
        same_value: DifferentialValue = array_value(same_values, [int_value(7), same_inner])
        different_value: DifferentialValue = array_value(different_values, [int_value(7), different_inner])
        reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 10, value: reference_value}], values: reference_values}
        same: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 10, value: same_value}], values: same_values}
        different: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 10, value: different_value}], values: different_values}
        equal_comparison: DifferentialComparison = compare_differential_runs(reference, same)
        different_comparison: DifferentialComparison = compare_differential_runs(reference, different)

        assert equal_comparison.equal
        assert not different_comparison.equal
        assert different_comparison.kind == DifferentialDifferenceKind.ObservationValue
        assert reference.values[different_comparison.reference_value.array_start.usize() + 1].array_start == 0
        assert reference.values[reference.values[different_comparison.reference_value.array_start.usize() + 1].array_start.usize()].text == "same"
        assert different.values[different.values[different_comparison.candidate_value.array_start.usize() + 1].array_start.usize()].text == "changed"


@test
def differential_comparison_compares_map_observations_order_insensitively() -> void:
