@test
def differential_elisascript_program_runner_accepts_python_dictionary_get() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-dictionary-get.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    values: dict[sview, i64] = {\"present\": 7}\n    observe(values.get(\"missing\", 5))\n    return values.get(\"present\", 99) + values.get(\"missing\", 5)\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "candidate", target: sview(path, 0, -1), arguments: [], timeout_steps: 10000}
        captured: mutable DifferentialRun = DifferentialRun{observations: []}
        assert run_elisascript_program_succeeds(runner, captured)
        assert captured.exit_status == 12
        assert captured.observations.count == 1
        assert captured.observations[0].value.kind == DifferentialValueKind.Int
        assert captured.observations[0].value.integer == 5

        _ = remove_file(path.cast[cstr])


@test
def differential_elisascript_program_runner_captures_len_observation() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-len.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    values: darray[sview] = [\"one\", \"two\"]\n    observe(len(values))\n    return 2i64\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

