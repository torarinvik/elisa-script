@test
def differential_elisascript_runner_captures_typed_return_and_observations() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-candidate.elisascript"
        source: static u8& = "def main(value: sview) -> i64:\n    observe(value)\n    return 42\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written == 64

        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptFile, name: "candidate", target: sview(path, 0, -1), entry: "main", arguments: ["input"], timeout_steps: 10000}
        captured: mutable DifferentialRun = DifferentialRun{observations: []}
        assert run_elisascript_succeeds(runner, captured)

        assert captured.error_text == ""
        assert captured.exit_status == 0
        assert captured.return_value.kind == DifferentialValueKind.Int
        assert captured.return_value.integer == 42
        assert captured.engine_known
        assert captured.engine == EsIr::ExecutionEngine.DirectBytecode
        assert captured.capability_known
        assert captured.capability.direct_supported
        assert captured.capability.function_count == 1u64
        assert captured.capability.global_count == 0u64
        assert captured.observations.count == 1
        assert captured.observations[0].value.kind == DifferentialValueKind.Text
        assert captured.observations[0].value.text == "input"
        _ = remove_file(path.cast[cstr])


@test
def differential_elisascript_runner_installs_configured_dynamic_handlers() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-handler-candidate.elisascript"
        source: static u8& = "def record(value: i64) -> void:\n    observe(value)\n\ndef emit() -> void can[Progress.Tick]:\n    signal Progress.Tick(41)\n\ndef main() -> i64:\n    with handler recorder:\n        emit()\n    return 7\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

        clause: HandlerClause = HandlerClause{effect_family: "Progress", effect_operation: "Tick", function: "record"}
        recorder: Handler = Handler{name: "recorder", handles: ["Progress"], introduces_effects: [], errors: [], continuation: ContinuationPolicy.Linear, clauses: [clause]}
        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptFile, name: "candidate", target: sview(path, 0, -1), entry: "main", arguments: [], handlers: [recorder], timeout_steps: 10000}
        captured: mutable DifferentialRun = DifferentialRun{observations: []}
        assert run_elisascript_succeeds(runner, captured)

        assert captured.return_value.kind == DifferentialValueKind.Int
        assert captured.return_value.integer == 7
        assert captured.engine_known
        assert captured.engine == EsIr::ExecutionEngine.BytecodeInterpreterFallback
        assert captured.capability_known
        assert not captured.capability.direct_supported
        assert captured.capability.global_count == 0u64
        assert captured.observations.count == 1
        assert captured.observations[0].value.kind == DifferentialValueKind.Int
        assert captured.observations[0].value.integer == 41
        _ = remove_file(path.cast[cstr])


