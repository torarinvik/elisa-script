@test
def differential_elisascript_program_runner_accepts_python_path_file_methods() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-path-file-methods.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    original: Path = path\"/tmp/elisascript-differential-path-method-source.txt\"\n    renamed: Path = path\"/tmp/elisascript-differential-path-method-renamed.txt\"\n    binary_path: Path = path\"/tmp/elisascript-differential-path-method-bytes.bin\"\n    written: usize = original.write_text(\"payload\")\n    text: sview = original.read_text()\n    byte_written: usize = binary_path.write_bytes([65u8, 0u8, 66u8])\n    bytes: darray[u8] = binary_path.read_bytes()\n    removed_binary: bool = binary_path.unlink()\n    renamed_ok: bool = original.rename(renamed)\n    renamed_text: sview = renamed.read_text()\n    removed_renamed: bool = renamed.unlink()\n    observe(bytes)\n    return 1i64 if written == 7u64 and text == \"payload\" and byte_written == 3u64 and bytes.count == 3u64 and bytes[0] == 65u8 and bytes[1] == 0u8 and bytes[2] == 66u8 and removed_binary and renamed_ok and renamed_text == \"payload\" and removed_renamed else 0i64\n"
        _ = remove_file(path.cast[cstr])

        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "path-file-methods-candidate", target: sview(path, 0, -1), arguments: [], timeout_steps: 10000}
        captured: mutable DifferentialRun = DifferentialRun{observations: []}
        assert run_elisascript_program_succeeds(runner, captured)
        assert captured.exit_status == 1
        assert captured.return_value.kind == DifferentialValueKind.Int
        assert captured.return_value.integer == 1
        assert captured.observations.count == 1
        assert captured.observations[0].value.kind == DifferentialValueKind.Array
        assert captured.observations[0].value.array_count == 3

        _ = remove_file(path.cast[cstr])


