        assert captured.exit_status == 2
        assert captured.observations.count == 2
        assert captured.observations[0].value.kind == DifferentialValueKind.Array
        assert captured.observations[0].value.array_count == 2
        assert captured.values[captured.observations[0].value.array_start.usize()].text == "left"
        assert captured.values[captured.observations[0].value.array_start.usize() + 1].text == "right"
