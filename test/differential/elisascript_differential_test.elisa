        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    values: darray[sview] = [\"one\", \"two\"]\n    for index, value in values.enumerate():\n        observe(index)\n        observe(value)\n    for index, value in enumerate(values):\n        observe(index)\n        observe(value)\n    return 4i64\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
