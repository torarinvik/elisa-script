def differential_elisascript_program_runner_accepts_python_pop_alias() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-pop.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    values: mutable darray[sview] = [\"left\", \"middle\", \"right\"]\n    removed: sview = values.pop(1)\n    observe(values)\n    observe(removed)\n    return 2i64\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

