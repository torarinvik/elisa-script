include "../../src/testing/differential.elisa"

using EsDifferential


def int_value(value: i64) -> DifferentialValue:
    return DifferentialValue{kind: DifferentialValueKind.Int, integer: value}


def text_value(value: sview) -> DifferentialValue:
    return DifferentialValue{kind: DifferentialValueKind.Text, text: value}


@test
def differential_process_capture_adapter_materializes_one_snapshot() -> void:
    capture: EsIr::RuntimeValue = EsIr::RuntimeValue{kind: EsIr::RuntimeValueKind.ProcessCapture, process_exit_status: 7, process_stdout: "out", process_stderr: "err"}
    observations: darray[DifferentialObservation] = [DifferentialObservation{trace: 11, value: int_value(42)}]
    run: DifferentialRun = differential_run_from_process_capture(capture, observations)

    assert run.exit_status == 7
    assert run.stdout == "out"
    assert run.stderr == "err"
    assert run.error_text == ""
    assert run.observations.count == 1
    assert run.observations[0].trace == 11
    assert run.observations[0].value.integer == 42


@test
def differential_process_capture_adapter_rejects_non_capture_values() -> void:
    capture: EsIr::RuntimeValue = EsIr::RuntimeValue{kind: EsIr::RuntimeValueKind.Int, integer: 7}
    run: DifferentialRun = differential_run_from_process_capture(capture, [])

    assert run.error_text == "expected ProcessCapture runtime value"
    assert run.observations.count == 0


@test
def differential_runner_validation_accepts_native_process_contract() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/tool", arguments: ["alpha beta", "*.elisascript"], stdin: "input", timeout_steps: 100}
    check: DifferentialRunnerCheck = validate_differential_runner(runner)

    assert check.valid
    assert check.issue == DifferentialRunnerIssueKind.None


@test
def differential_runner_validation_requires_adapter_entry() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.PythonAdapter, name: "candidate", target: "adapter.py", arguments: [], timeout_steps: 10}
    check: DifferentialRunnerCheck = validate_differential_runner(runner)

    assert not check.valid
    assert check.issue == DifferentialRunnerIssueKind.MissingEntry


@test
def differential_runner_validation_reports_nul_argument_before_timeout() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "candidate", target: "tool", arguments: ["safe", "bad\0arg"], timeout_steps: 0}
    check: DifferentialRunnerCheck = validate_differential_runner(runner)

    assert not check.valid
    assert check.issue == DifferentialRunnerIssueKind.EmbeddedNul
    assert check.argument_index == 1


@test
def differential_runner_validation_rejects_nul_working_directory() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "candidate", target: "tool", arguments: [], working_directory: "bad\0directory", timeout_steps: 10}
    check: DifferentialRunnerCheck = validate_differential_runner(runner)

    assert not check.valid
    assert check.issue == DifferentialRunnerIssueKind.EmbeddedNul
    assert check.reason == "runner working directory contains NUL"


@test
def differential_process_preparation_preserves_native_argv_and_policy() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.NativeProcess, name: "reference", target: "/usr/bin/tool", arguments: ["alpha beta", "*.elisascript"], working_directory: "/tmp/case", stdin: "input", protocol: "lines", timeout_steps: 100}
    fallback: DifferentialProcessInvocation = DifferentialProcessInvocation{executable: "", arguments: []}
    invocation: DifferentialProcessInvocation = try prepare_differential_process(runner) else fallback

    assert invocation.executable == "/usr/bin/tool"
    assert invocation.entry == ""
    assert invocation.arguments.count == 2
    assert invocation.arguments[0] == "alpha beta"
    assert invocation.arguments[1] == "*.elisascript"
    assert invocation.working_directory == "/tmp/case"
    assert invocation.stdin == "input"
    assert invocation.protocol == "lines"
    assert invocation.timeout_steps == 100


@test
def differential_process_preparation_prefixes_python_entry_without_shell_joining() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.PythonAdapter, name: "candidate", target: "python3", entry: "adapter.py", arguments: ["alpha beta", "*.elisascript"], timeout_steps: 10}
    fallback: DifferentialProcessInvocation = DifferentialProcessInvocation{executable: "", arguments: []}
    invocation: DifferentialProcessInvocation = try prepare_differential_process(runner) else fallback

    assert invocation.executable == "python3"
    assert invocation.entry == "adapter.py"
    assert invocation.arguments.count == 2
    assert invocation.arguments[0] == "alpha beta"
    assert invocation.arguments[1] == "*.elisascript"


@test
def differential_process_preparation_rejects_in_process_kind() -> void:
    runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.InProcessFunction, name: "candidate", target: "function", arguments: [], timeout_steps: 10}
    fallback: DifferentialProcessInvocation = DifferentialProcessInvocation{executable: "", arguments: []}
    invocation: DifferentialProcessInvocation = try prepare_differential_process(runner) else fallback

    assert invocation.executable == ""
    assert invocation.arguments.count == 0


@test
def differential_comparison_accepts_identical_runs() -> void:
    reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(42)}], stdout: "ok", stderr: "", error_text: ""}
    candidate: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(42)}], stdout: "ok", stderr: "", error_text: ""}
    comparison: DifferentialComparison = compare_differential_runs(reference, candidate)

    assert comparison.equal
    assert comparison.kind == DifferentialDifferenceKind.Equal


@test
def differential_comparison_reports_first_structured_difference() -> void:
    reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(42)}, DifferentialObservation{trace: 8, value: text_value("reference")}], stdout: "ok", stderr: "", error_text: ""}
    candidate: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(42)}, DifferentialObservation{trace: 8, value: text_value("candidate")}], stdout: "ok", stderr: "", error_text: ""}
    comparison: DifferentialComparison = compare_differential_runs(reference, candidate)

    assert not comparison.equal
    assert comparison.kind == DifferentialDifferenceKind.ObservationValue
    assert comparison.index == 1
    assert comparison.reference_value.text == "reference"
    assert comparison.candidate_value.text == "candidate"


@test
def differential_comparison_prioritizes_process_output_before_observations() -> void:
    reference: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(42)}], stdout: "reference", stderr: "", error_text: ""}
    candidate: DifferentialRun = DifferentialRun{observations: [DifferentialObservation{trace: 7, value: int_value(99)}], stdout: "candidate", stderr: "", error_text: ""}
    comparison: DifferentialComparison = compare_differential_runs(reference, candidate)

    assert comparison.kind == DifferentialDifferenceKind.Stdout
    assert comparison.reference_text == "reference"
    assert comparison.candidate_text == "candidate"
