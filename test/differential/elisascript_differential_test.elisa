@test
def differential_elisascript_program_runner_captures_relative_paths() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-relative-path.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    observe(path_relative(path\"a/b/c.txt\", path\"a/d\"))\n    observe(relpath(path\"/tmp/work/out.txt\", path\"/tmp/work/in\"))\n    observe(path\"foo/bar\".relative_to(path\"foo\"))\n    return 3i64\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0
        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "relative-path-candidate", target: sview(path, 0, -1), arguments: [], timeout_steps: 10000}
        captured: mutable DifferentialRun = DifferentialRun{observations: []}
        assert run_elisascript_program_succeeds(runner, captured)
        assert captured.exit_status == 3
        assert captured.return_value.kind == DifferentialValueKind.Int
        assert captured.return_value.integer == 3
        assert captured.observations.count == 3
        assert captured.observations[0].value.kind == DifferentialValueKind.Text
        assert captured.observations[0].value.text == "../b/c.txt"
        assert captured.observations[1].value.text == "../out.txt"
        assert captured.observations[2].value.text == "bar"
        _ = remove_file(path.cast[cstr])


@test
def differential_elisascript_program_runner_captures_real_paths() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-real-path.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    observe(path_real(path\"/tmp\"))\n    observe(realpath(path\"/tmp\"))\n    observe(path\"/tmp/./\".resolve())\n    return 3i64\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0
        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "real-path-candidate", target: sview(path, 0, -1), arguments: [], timeout_steps: 10000}
        captured: mutable DifferentialRun = DifferentialRun{observations: []}
        assert run_elisascript_program_succeeds(runner, captured)
        assert captured.exit_status == 3
        assert captured.return_value.kind == DifferentialValueKind.Int
        assert captured.return_value.integer == 3
        assert captured.observations.count == 3
        assert captured.observations[0].value.kind == DifferentialValueKind.Text
        assert captured.observations[0].value.text == captured.observations[1].value.text
        assert captured.observations[1].value.text == captured.observations[2].value.text
        assert captured.observations[0].value.text != ""
        assert captured.observations[0].value.text[0] == 47
        _ = remove_file(path.cast[cstr])


@test
def differential_elisascript_program_runner_captures_sleeping_candidate() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-sleep.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    sleep(0.0)\n    sleep_milliseconds(0u64)\n    observe(17i64)\n    return 3i64\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0
        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "sleep-candidate", target: sview(path, 0, -1), arguments: [], timeout_steps: 10000}
        captured: mutable DifferentialRun = DifferentialRun{observations: []}
        assert run_elisascript_program_succeeds(runner, captured)
        assert captured.exit_status == 3
        assert captured.observations.count == 1
        assert captured.observations[0].value.kind == DifferentialValueKind.Int
        assert captured.observations[0].value.integer == 17
        _ = remove_file(path.cast[cstr])


@test
def differential_elisascript_program_runner_captures_temporary_paths() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-temporary-path.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    temporary: Path = temp_file(\"differential\")\n    directory: Path = temp_dir(\"differential\")\n    file_present: bool = path_exists(temporary)\n    directory_present: bool = is_directory(directory)\n    removed_file: bool = remove_path(temporary)\n    removed_directory: bool = remove_directory(directory)\n    observe(file_present)\n    observe(directory_present)\n    observe(removed_file and removed_directory)\n    return 3i64\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0
        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "temporary-path-candidate", target: sview(path, 0, -1), arguments: [], timeout_steps: 10000}
        captured: mutable DifferentialRun = DifferentialRun{observations: []}
        assert run_elisascript_program_succeeds(runner, captured)
        assert captured.exit_status == 3
        assert captured.observations.count == 3
        assert captured.observations[0].value.kind == DifferentialValueKind.Bool
        assert captured.observations[0].value.boolean
        assert captured.observations[1].value.boolean
        assert captured.observations[2].value.boolean
        _ = remove_file(path.cast[cstr])
