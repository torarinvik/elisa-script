@test
def differential_elisascript_program_runner_captures_indexed_iteration() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-indexed.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    values: darray[sview] = [\"one\", \"two\"]\n    for index, value in values.enumerate():\n        observe(index)\n        observe(value)\n    for index, value in enumerate(values):\n        observe(index)\n        observe(value)\n    return 4i64\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "indexed-candidate", target: sview(path, 0, -1), arguments: [], timeout_steps: 10000}
        captured: mutable DifferentialRun = DifferentialRun{observations: []}
        assert run_elisascript_program_succeeds(runner, captured)

        assert captured.exit_status == 4
        assert captured.return_value.kind == DifferentialValueKind.Int
        assert captured.return_value.integer == 4
        assert captured.observations.count == 8
        assert captured.observations[0].value.integer == 0
        assert captured.observations[1].value.text == "one"
        assert captured.observations[2].value.integer == 1
        assert captured.observations[3].value.text == "two"
        assert captured.observations[4].value.integer == 0
        assert captured.observations[5].value.text == "one"
        assert captured.observations[6].value.integer == 1
        assert captured.observations[7].value.text == "two"
        _ = remove_file(path.cast[cstr])


