def differential_elisascript_program_runner_accepts_python_text_predicates() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-text-predicates.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    observe(\"Elisa42\".isalnum())\n    return 1i64\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "text-predicates-candidate", target: sview(path, 0, -1), arguments: [], timeout_steps: 10000}
        captured: mutable DifferentialRun = DifferentialRun{observations: []}
        assert run_elisascript_program_succeeds(runner, captured)

        assert captured.exit_status == 1
        assert captured.observations.count == 1
        assert captured.observations[0].value.kind == DifferentialValueKind.Bool
        assert captured.observations[0].value.boolean
        _ = remove_file(path.cast[cstr])


@test
def differential_elisascript_program_runner_accepts_python_text_boundary_removal() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-text-remove-boundary.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    observe(\"pre-value-post\".removeprefix(\"pre-\").removesuffix(\"-post\"))\n    return 1i64\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "text-remove-boundary-candidate", target: sview(path, 0, -1), arguments: [], timeout_steps: 10000}
        captured: mutable DifferentialRun = DifferentialRun{observations: []}
        assert run_elisascript_program_succeeds(runner, captured)
        assert captured.exit_status == 1
        assert captured.observations.count == 1
        assert captured.observations[0].value.kind == DifferentialValueKind.Text
        assert captured.observations[0].value.text == "value"
        _ = remove_file(path.cast[cstr])


@test
def differential_elisascript_program_runner_accepts_python_text_left_and_right_trim_methods() -> void:
    can Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast:
        path: static u8& = "/tmp/elisascript-differential-text-trim-sides.elisascript"
        source: static u8& = "def main(arguments: darray[sview]) -> i64:\n    value: sview = \"  value  \"\n    observe(value.lstrip())\n    observe(value.rstrip())\n    return 1i64\n"
        _ = remove_file(path.cast[cstr])
        written: i64 = try write_entire_file(path.cast[cstr], sview(source, 0, -1)) else -1
        assert written > 0

        runner: DifferentialRunner = DifferentialRunner{kind: DifferentialRunnerKind.ElisascriptProgram, name: "text-trim-sides-candidate", target: sview(path, 0, -1), arguments: [], timeout_steps: 10000}
        captured: mutable DifferentialRun = DifferentialRun{observations: []}
        assert run_elisascript_program_succeeds(runner, captured)
        assert captured.exit_status == 1
        assert captured.observations.count == 2
        assert captured.observations[0].value.kind == DifferentialValueKind.Text
        assert captured.observations[0].value.text == "value  "
        assert captured.observations[1].value.kind == DifferentialValueKind.Text
        assert captured.observations[1].value.text == "  value"
        _ = remove_file(path.cast[cstr])


@test
