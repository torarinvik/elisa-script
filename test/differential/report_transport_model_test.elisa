# Focused transport checks without the interpreter or process adapter graph.
include "../../src/runtime/encoding.elisa"
include "../../src/testing/stability_model.elisa"
include "../../src/testing/report_model.elisa"
include "../../src/testing/report_render_model.elisa"
include "../../src/testing/report_transport_model.elisa"

using EsDifferentialReportTransport


@test
def report_transport_short_write_preserves_pending_bytes() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        transport: mutable DifferentialReportTransport = DifferentialReportTransport{bytes: [65u8, 66u8, 67u8, 68u8, 69u8], max_bytes: 8, chunk_bytes: 4}
        _ = try advance_differential_report_transport(transport, DifferentialReportTransportEvent.Begin)
        chunk: mutable sview = ""
        assert peek_differential_report_chunk(transport, chunk) == 4
        assert chunk == "ABCD"
        rejected: mutable bool = false
        catch advance_differential_report_transport(transport, DifferentialReportTransportEvent.Emit, 3):
            ok value:
                assert false
            error failure:
                assert failure == DifferentialReportTransportError.ShortWrite
                rejected <- true
        assert rejected
        assert transport.offset == 0
        assert transport.chunks == 0
        assert peek_differential_report_chunk(transport, chunk) == 4
        assert chunk == "ABCD"
        _ = try advance_differential_report_transport(transport, DifferentialReportTransportEvent.Emit, 4)
        assert peek_differential_report_chunk(transport, chunk) == 1
        assert chunk == "E"
        assert advance_differential_report_transport(transport, DifferentialReportTransportEvent.Emit, 1) == DifferentialReportTransportState.Complete
        assert transport.offset == 5
        assert transport.chunks == 2


@test
def report_transport_cancel_after_acknowledged_chunk_cannot_complete() -> void:
    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        transport: mutable DifferentialReportTransport = DifferentialReportTransport{bytes: [65u8, 66u8, 67u8, 68u8, 69u8], max_bytes: 8, chunk_bytes: 4}
        _ = try advance_differential_report_transport(transport, DifferentialReportTransportEvent.Begin)
        _ = try advance_differential_report_transport(transport, DifferentialReportTransportEvent.Emit, 4)
        _ = try advance_differential_report_transport(transport, DifferentialReportTransportEvent.Cancel)
        _ = try advance_differential_report_transport(transport, DifferentialReportTransportEvent.CancelAck)
        rejected: mutable bool = false
        catch advance_differential_report_transport(transport, DifferentialReportTransportEvent.Emit, 1):
            ok value:
                assert false
            error failure:
                assert failure == DifferentialReportTransportError.InvalidState
                rejected <- true
        assert rejected
        assert transport.state == DifferentialReportTransportState.Cancelled
        assert transport.offset == 4
        assert transport.chunks == 1
