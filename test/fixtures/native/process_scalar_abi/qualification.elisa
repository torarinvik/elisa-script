# Dormant explicitly linked fixture, not part of ordinary *_test discovery.
# Requires probe.c's qualified object; no compiler or native test is run here.
include "../../../../src/runtime/process_launch_vectors_native.elisa"
include "../../../../src/runtime/environment_snapshot_model.elisa"

module EsProcessScalarAbiQualification:
    private:
        const module Golden:
            BEFORE: u32 = 0xa1b2c3d4
            AFTER: u32 = 0x55667788
            OPTION: i32 = 0x13579bdf


        struct Guard:
            before: mutable u32 = Golden::BEFORE
            status: mutable i32 = 0x11223344
            after: mutable u32 = Golden::AFTER


        # Conservative effect row for calls into the separately linked object.
        # The C source itself has no I/O, process, signal or allocation operation.
        @link_name(elisascript_fixture_scalar_result)
        extern scalar_result(request: i32, status: mutable i32&, option: i32) -> i32 can[Blocking.IO]

        @link_name(elisascript_fixture_scalar_c_control)
        extern scalar_c_control() -> i32 can[Blocking.IO]

        @link_name(elisascript_fixture_pointer_tables)
        extern pointer_tables(argv: void&, environment: void&, candidates: void&, tool: void&, empty: void&, entry: void&, candidate: void&) -> i32 can[Blocking.IO]

        @link_name(elisascript_fixture_pointer_c_control)
        extern pointer_c_control() -> i32 can[Blocking.IO]

    public:
        @test
        def native_scalar_c_known_answers_are_admitted_first() -> void:
            can Blocking.IO:
                assert scalar_c_control() == 0i32


        @test
        def native_scalar_status_slot_preserves_guards_and_signed_results() -> void:
            can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                assert scalar_c_control() == 0i32
                assert size_of(i32) == 4 and size_of(int) == 8 and size_of(uintptr) == 8
                assert size_of(Guard) == 12
                return if size_of(Guard) != 12
                slot: mutable Guard = Guard{}
                # Independently specified Darwin64 little-endian initial layout.
                bytes: u8& = (&slot).cast[u8&]
                expected: darray[u8] = [212u8,195u8,178u8,161u8, 68u8,51u8,34u8,17u8, 136u8,119u8,102u8,85u8]
                for index in 0..<expected.count:
                    assert bytes[index] == expected[index]
                failed: i32 = scalar_result(0i32, slot.status, Golden::OPTION)
                assert failed == -1i32 and failed.int() == -1
                assert slot.status == 32512i32
                assert slot.before == Golden::BEFORE and slot.after == Golden::AFTER
                minimum: i32 = scalar_result(1i32, slot.status, Golden::OPTION)
                assert minimum.int() == -2147483648i64
                assert slot.status == 0x12345678i32
                assert slot.before == Golden::BEFORE and slot.after == Golden::AFTER
                maximum: i32 = scalar_result(2i32, slot.status, Golden::OPTION)
                assert maximum.int() == 2147483647i64
                assert slot.status == -123456789i32
                assert slot.before == Golden::BEFORE and slot.after == Golden::AFTER
                rejected: i32 = scalar_result(9i32, slot.status, Golden::OPTION)
                assert rejected == -7777i32 and slot.status == -123456789i32
                wrong_option: i32 = scalar_result(0i32, slot.status, 0i32)
                assert wrong_option == -7777i32 and slot.status == -123456789i32
                assert slot.before == Golden::BEFORE and slot.after == Golden::AFTER


        @test
        def native_builder_tables_have_the_independent_c_view() -> void:
            can Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                assert scalar_c_control() == 0i32 and pointer_c_control() == 0i32
                width: usize = try EsProcessLaunchVectors::native_pointer_bytes() else failure:
                    assert false
                    return
                assert width == 8 and size_of(void&) == 8
                return if width != 8 or size_of(void&) != 8
                ambient: EsEnvironment::EnvironmentSnapshot = try EsEnvironmentSnapshot::from_entries([[88u8,61u8,0u8]]) else failure:
                    assert false
                    return
                storage: EsProcessLaunchStorage::Prepared = try EsProcessLaunchStorage::prepare(ambient, [], "./tool", [""]) else failure:
                    assert false
                    return
                tables: mutable EsProcessLaunchVectors::BorrowedTables = try EsProcessLaunchVectors::build_native_tables(storage) else failure:
                    assert false
                    return
                receipt: EsProcessLaunchVectors::Receipt = try EsProcessLaunchVectors::validate_native_bindings(storage, tables) else failure:
                    assert false
                    return
                assert receipt.argv_slots == 3 and receipt.environment_slots == 2 and receipt.candidate_slots == 2
                return if tables.argv.count != 3 or tables.environment.count != 2 or tables.candidates.count != 2
                # All buffers and tables remain retained and unchanged during
                # each C call; the oracle never writes to any of them.
                argv: void& = (&tables.argv[0]).cast[void&]
                environment: void& = (&tables.environment[0]).cast[void&]
                candidates: void& = (&tables.candidates[0]).cast[void&]
                tool: void& = (&storage.arguments[0][0]).cast[void&]
                empty: void& = (&storage.arguments[1][0]).cast[void&]
                entry: void& = (&storage.environment.environment[0][0]).cast[void&]
                candidate: void& = (&storage.environment.executable_candidates[0][0]).cast[void&]
                assert pointer_tables(argv, environment, candidates, tool, empty, entry, candidate) == 0i32
                # Deliberately invalidate only a table entry between calls to
                # prove the oracle distinguishes an empty argument from NULL.
                tables.argv[1] <- null
                assert pointer_tables(argv, environment, candidates, tool, empty, entry, candidate) == 2i32
                tables.argv[1] <- &storage.arguments[1][0]
                assert pointer_tables(argv, environment, candidates, tool, empty, entry, candidate) == 0i32
