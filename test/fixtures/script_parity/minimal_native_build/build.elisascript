# E01/E02/E06 candidate: build a static library and executable with a generated header.
# The caller supplies an absolute build directory outside this fixture; its
# parent must exist. The recipe never deletes source-tree paths.

include "../../../../src/runtime/build_executor_model.elisa"

using EsBuild
using EsBuildExecutor
using EsProcess


module EsMinimalNativeBuild:
    private:
        const module Toolchain:
            C_COMPILER: sview = "/usr/bin/cc"
            ARCHIVER: sview = "/usr/bin/ar"
            LIBRARY_FILENAME: sview = "libminimal-answer.a"
            TARGET_NAME: sview = "minimal-native"
            TIMEOUT_MICROS: u64 = 60000000u64
            OUTPUT_LIMIT_BYTES: usize = 1048576


        def path_is_within(root: sview, candidate: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if root == candidate
            prefix: sview = if root == "/": "/" else: root + "/"
            return candidate.startswith(prefix)


        def report_failed_build_nodes(execution: BuildExecutionResult) -> void can[Console.Write]:
            reported_failure: mutable bool = false
            for node in execution.nodes |execution, reported_failure|:
                if node.failure != BuildExecutionFailureKind.None:
                    reported_failure <- true
                    _ = write_stderr("minimal native build: target " + node.target_name + " failed\n")
                    if node.failure == BuildExecutionFailureKind.Invocation:
                        _ = write_stderr("  process invocation failed\n")
                    elif node.failure == BuildExecutionFailureKind.NonzeroExit:
                        _ = write_stderr("  exit status: " + f"{node.exit_status}" + "\n")
                    elif node.failure == BuildExecutionFailureKind.OutputMissing:
                        _ = write_stderr("  declared output missing: " + node.missing_output + "\n")
                    if node.stderr != "":
                        _ = write_stderr("  stderr:\n")
                        _ = write_stderr(node.stderr)
                        _ = write_stderr("\n") if not node.stderr.endswith("\n")
                    if node.stdout != "":
                        _ = write_stderr("  stdout:\n")
                        _ = write_stderr(node.stdout)
                        _ = write_stderr("\n") if not node.stdout.endswith("\n")
            if not reported_failure:
                _ = write_stderr("minimal native build: build graph failed without a failed node\n")


    public:
        def build(build_directory_argument: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Directory.Write, Process.Run, Unsafe.PointerCast]:
            build_argument: Path = path(build_directory_argument)
            if not path_is_absolute(build_argument):
                print("minimal native build: build directory must be absolute")
                return 2i64
            script_path: Path = Script::source_path()
            project_directory: Path = try path_real(path_absolute(script_path.parent())) else err:
                print("minimal native build: missing project directory")
                return 1i64
            repository_directory: Path = project_directory.parent().parent().parent().parent()
            project_directory_text: sview = f"{project_directory}"
            repository_directory_text: sview = f"{repository_directory}"

            # Check before mkdir: refusing a source-tree build path must not
            # leave behind the directory that the check is intended to reject.
            if is_symlink(build_argument):
                print("minimal native build: refusing a symlink build directory")
                return 2i64
            if is_directory(build_argument):
                existing_build_directory: Path = try path_real(path_absolute(build_argument)) else err:
                    print("minimal native build: unable to resolve build directory")
                    return 2i64
                existing_build_directory_text: sview = f"{existing_build_directory}"
                if existing_build_directory_text == "/" or path_is_within(repository_directory_text, existing_build_directory_text):
                    print("minimal native build: refusing a build directory inside the source repository")
                    return 2i64
            else:
                parent: Path = build_argument.parent()
                if not is_directory(parent):
                    print("minimal native build: build directory parent must exist")
                    return 2i64
                canonical_parent: Path = try path_real(path_absolute(parent)) else err:
                    print("minimal native build: unable to resolve build directory parent")
                    return 2i64
                canonical_parent_text: sview = f"{canonical_parent}"
                if path_is_within(repository_directory_text, canonical_parent_text):
                    print("minimal native build: refusing a build directory inside the source repository")
                    return 2i64
                created: bool = try create_directory(build_argument) else false
                if not created and not is_directory(build_argument):
                    print("minimal native build: unable to create build directory")
                    return 2i64

            if is_symlink(build_argument):
                print("minimal native build: refusing a symlink build directory")
                return 2i64
            build_directory: Path = try path_real(path_absolute(build_argument)) else err:
                print("minimal native build: unable to resolve build directory")
                return 2i64
            build_directory_text: sview = f"{build_directory}"
            if build_directory_text == "/" or path_is_within(repository_directory_text, build_directory_text):
                print("minimal native build: refusing a build directory inside the source repository")
                return 2i64

            main_source: Path = project_directory.joinpath("src").joinpath("main.c")
            answer_source: Path = project_directory.joinpath("src").joinpath("answer.c")
            generated_header_input: Path = project_directory.joinpath("include").joinpath("generated_build_config.h.in")
            generated_header_output: Path = build_directory.joinpath("generated_build_config.h")
            answer_object: Path = build_directory.joinpath("answer.o")
            main_object: Path = build_directory.joinpath("main.o")
            static_library: Path = build_directory.joinpath(Toolchain::LIBRARY_FILENAME)
            include_directory: Path = project_directory.joinpath("include")
            output_path: Path = build_directory.joinpath(Toolchain::TARGET_NAME)
            if is_symlink(output_path):
                print("minimal native build: refusing a symlink at the target output path")
                return 2i64
            main_source_text: sview = f"{main_source}"
            answer_source_text: sview = f"{answer_source}"
            generated_header_input_text: sview = f"{generated_header_input}"
            generated_header_output_text: sview = f"{generated_header_output}"
            answer_object_text: sview = f"{answer_object}"
            main_object_text: sview = f"{main_object}"
            static_library_text: sview = f"{static_library}"
            include_directory_text: sview = f"{include_directory}"
            output_path_text: sview = f"{output_path}"

            generate_header_command: ProcessCommand = ProcessCommand{
                executable: "/bin/cp",
                arguments: [generated_header_input_text, generated_header_output_text],
                working_directory: project_directory_text,
                stdin_mode: ProcessStdioMode.Null,
                stdout_mode: ProcessStdioMode.Capture,
                stderr_mode: ProcessStdioMode.Capture,
                timeout_micros: Toolchain::TIMEOUT_MICROS,
                capture_output_limit_bytes: Toolchain::OUTPUT_LIMIT_BYTES
            }
            compile_answer_command: ProcessCommand = ProcessCommand{
                executable: Toolchain::C_COMPILER,
                arguments: ["-std=c11", "-pedantic", "-Wall", "-Wextra", "-Werror", "-I", include_directory_text, "-c", answer_source_text, "-o", answer_object_text],
                working_directory: project_directory_text,
                stdin_mode: ProcessStdioMode.Null,
                stdout_mode: ProcessStdioMode.Capture,
                stderr_mode: ProcessStdioMode.Capture,
                timeout_micros: Toolchain::TIMEOUT_MICROS,
                capture_output_limit_bytes: Toolchain::OUTPUT_LIMIT_BYTES
            }
            archive_command: ProcessCommand = ProcessCommand{
                executable: Toolchain::ARCHIVER,
                arguments: ["rcs", static_library_text, answer_object_text],
                working_directory: project_directory_text,
                stdin_mode: ProcessStdioMode.Null,
                stdout_mode: ProcessStdioMode.Capture,
                stderr_mode: ProcessStdioMode.Capture,
                timeout_micros: Toolchain::TIMEOUT_MICROS,
                capture_output_limit_bytes: Toolchain::OUTPUT_LIMIT_BYTES
            }
            compile_main_command: ProcessCommand = ProcessCommand{
                executable: Toolchain::C_COMPILER,
                arguments: ["-std=c11", "-pedantic", "-Wall", "-Wextra", "-Werror", "-I", include_directory_text, "-I", build_directory_text, "-c", main_source_text, "-o", main_object_text],
                working_directory: project_directory_text,
                stdin_mode: ProcessStdioMode.Null,
                stdout_mode: ProcessStdioMode.Capture,
                stderr_mode: ProcessStdioMode.Capture,
                timeout_micros: Toolchain::TIMEOUT_MICROS,
                capture_output_limit_bytes: Toolchain::OUTPUT_LIMIT_BYTES
            }
            link_command: ProcessCommand = ProcessCommand{
                executable: Toolchain::C_COMPILER,
                arguments: [main_object_text, static_library_text, "-o", output_path_text],
                working_directory: project_directory_text,
                stdin_mode: ProcessStdioMode.Null,
                stdout_mode: ProcessStdioMode.Capture,
                stderr_mode: ProcessStdioMode.Capture,
                timeout_micros: Toolchain::TIMEOUT_MICROS,
                capture_output_limit_bytes: Toolchain::OUTPUT_LIMIT_BYTES
            }
            run_command: ProcessCommand = ProcessCommand{
                executable: output_path_text,
                working_directory: project_directory_text,
                stdin_mode: ProcessStdioMode.Null,
                stdout_mode: ProcessStdioMode.Capture,
                stderr_mode: ProcessStdioMode.Capture,
                timeout_micros: Toolchain::TIMEOUT_MICROS,
                capture_output_limit_bytes: Toolchain::OUTPUT_LIMIT_BYTES
            }
            graph: mutable BuildGraph = BuildGraph{
                nodes: [
                    BuildNode{name: "generate-config-header", command: generate_header_command, dependencies: [], fingerprint: 1u64},
                    BuildNode{name: "compile-answer", command: compile_answer_command, dependencies: [], fingerprint: 2u64},
                    BuildNode{name: "archive-answer", command: archive_command, dependencies: [1], fingerprint: 3u64},
                    BuildNode{name: "compile-main", command: compile_main_command, dependencies: [0], fingerprint: 4u64},
                    BuildNode{name: Toolchain::TARGET_NAME, command: link_command, dependencies: [2, 3], fingerprint: 5u64},
                    BuildNode{name: "run-minimal-native", command: run_command, dependencies: [4], fingerprint: 6u64}
                ],
                max_parallel: 1
            }
            expected_outputs: darray[BuildExecutionNodeOutputs] = [
                BuildExecutionNodeOutputs{target_name: "generate-config-header", paths: [generated_header_output_text]},
                BuildExecutionNodeOutputs{target_name: "compile-answer", paths: [answer_object_text]},
                BuildExecutionNodeOutputs{target_name: "archive-answer", paths: [static_library_text]},
                BuildExecutionNodeOutputs{target_name: "compile-main", paths: [main_object_text]},
                BuildExecutionNodeOutputs{target_name: Toolchain::TARGET_NAME, paths: [output_path_text]},
                BuildExecutionNodeOutputs{target_name: "run-minimal-native", paths: []}
            ]
            execution: mutable BuildExecutionResult = BuildExecutionResult{}
            catch execute_build_graph_serial_with_outputs(graph, expected_outputs):
                ok value:
                    execution <- value
                error failure:
                    _ = write_stderr("minimal native build: build graph execution failed before completion\n")
                    return 1i64
            if execution.graph_state != BuildGraphState.Succeeded or execution.nodes.count != 6:
                report_failed_build_nodes(execution)
                return 1i64
            return 1i64 if not execution.nodes[0].started or execution.nodes[0].exit_status != 0 or execution.nodes[0].failure != BuildExecutionFailureKind.None
            return 1i64 if not execution.nodes[1].started or execution.nodes[1].exit_status != 0 or execution.nodes[1].failure != BuildExecutionFailureKind.None
            return 1i64 if not execution.nodes[2].started or execution.nodes[2].exit_status != 0 or execution.nodes[2].failure != BuildExecutionFailureKind.None
            return 1i64 if not execution.nodes[3].started or execution.nodes[3].exit_status != 0 or execution.nodes[3].failure != BuildExecutionFailureKind.None
            return 1i64 if not execution.nodes[4].started or execution.nodes[4].exit_status != 0 or execution.nodes[4].failure != BuildExecutionFailureKind.None
            return 1i64 if not execution.nodes[5].started or execution.nodes[5].exit_status != 0 or execution.nodes[5].failure != BuildExecutionFailureKind.None
            if execution.nodes[5].stdout != "answer=42\n":
                print("minimal native build: executable output differed from answer=42")
                return 1i64
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Directory.Write, Process.Run, Unsafe.PointerCast]:
    if arguments.count != 1:
        print("usage: build.elisascript ABSOLUTE_BUILD_DIRECTORY")
        return 2i64
    return EsMinimalNativeBuild::build(arguments[0])
