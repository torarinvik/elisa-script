# E01/E02/E06/E07 candidate: incrementally build a library and executable with a generated header.
# The caller supplies an absolute build directory outside this fixture; its
# parent must exist. The recipe never deletes source-tree paths.

include "../../../../src/ir/ir.elisa"

using EsBuild
using EsBuildExecutor
using EsBuildIncremental
using EsBuildIncrementalPosixExecutor
using EsBuildRecipeSignature
using EsArtifactCache
using EsRuntime
using EsProcess


module EsMinimalNativeBuild:
    private:
        const module Toolchain:
            C_COMPILER: sview = "/usr/bin/cc"
            ARCHIVER: sview = "/usr/bin/ar"
            COPY: sview = "/usr/bin/cp"
            PARTIAL_FAIL: sview = "/usr/bin/awk"
            NO_WRITE: sview = "/usr/bin/true"
            LIBRARY_FILENAME: sview = "libminimal-answer.a"
            TARGET_NAME: sview = "minimal-native"
            TIMEOUT_MICROS: u64 = 60000000u64
            OUTPUT_LIMIT_BYTES: usize = 1048576
            CACHE_LOCK: cstr = "elisascript-build.lock"
            CACHE_NAME: cstr = "elisascript-build.cache"
            CACHE_STAGING: cstr = "elisascript-build.stage"
            OBSOLETE_HEADER_FILENAME: sview = "obsolete-config.h"


        def path_is_within(root: sview, candidate: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if root == candidate
            prefix: sview = if root == "/": "/" else: root + "/"
            return candidate.startswith(prefix)


        def filesystem_root_relative(path_text: sview) -> sview:
            return "" if not path_text.startswith("/") or len(path_text) <= 1
            return sview(path_text, 1i64, len(path_text).i64())


        def cstring_bytes(value: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            bytes: mutable darray[u8] = []
            for byte in value |bytes|:
                bytes.push(byte)
            bytes.push(0u8)
            return bytes


        def open_directory_capability(path_text: sview) -> int can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            bytes: darray[u8] = cstring_bytes(path_text)
            return elisascript_posix_open((&bytes[0]).cast[cstr], DarwinOpenFlags::RDONLY | DarwinOpenFlags::DIRECTORY | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC, 0u32)


        def every_build_node_was_cached(execution: BuildExecutionResult) -> bool:
            return false if execution.nodes.count == 0
            for node in execution.nodes:
                return false if not node.cache_hit or node.started
            return true


        def report_failed_build_nodes(execution: BuildExecutionResult) -> void can[Console.Write]:
            reported_failure: mutable bool = false
            for node in execution.nodes |execution, reported_failure|:
                if node.failure != BuildExecutionFailureKind.None:
                    reported_failure <- true
                    _ = write_stderr("minimal native build: target " + node.target_name + " failed\n")
                    if node.failure == BuildExecutionFailureKind.Invocation:
                        _ = write_stderr("  process invocation failed\n")
                    elif node.failure == BuildExecutionFailureKind.NonzeroExit:
                        _ = write_stderr("  exit status: " + f"{node.exit_status}" + "\n")
                    elif node.failure == BuildExecutionFailureKind.OutputMissing:
                        _ = write_stderr("  declared output missing: " + node.missing_output + "\n")
                    if node.stderr != "":
                        _ = write_stderr("  stderr:\n")
                        _ = write_stderr(node.stderr)
                        _ = write_stderr("\n") if not node.stderr.endswith("\n")
                    if node.stdout != "":
                        _ = write_stderr("  stdout:\n")
                        _ = write_stderr(node.stdout)
                        _ = write_stderr("\n") if not node.stdout.endswith("\n")
            if not reported_failure:
                _ = write_stderr("minimal native build: build graph failed without a failed node\n")


    public:
        def build(build_directory_argument: sview, use_header_variant: bool, partial_main_failure: bool, no_write_main: bool, byte_identical_main: bool, include_obsolete_target: bool) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Directory.Write, Process.Run, Unsafe.PointerCast]:
            build_argument: Path = path(build_directory_argument)
            if not path_is_absolute(build_argument):
                print("minimal native build: build directory must be absolute")
                return 2i64
            script_path: Path = Script::source_path()
            project_directory: Path = try path_real(path_absolute(script_path.parent())) else err:
                print("minimal native build: missing project directory")
                return 1i64
            repository_directory: Path = project_directory.parent().parent().parent().parent()
            project_directory_text: sview = f"{project_directory}"
            repository_directory_text: sview = f"{repository_directory}"

            # Check before mkdir: refusing a source-tree build path must not
            # leave behind the directory that the check is intended to reject.
            if is_symlink(build_argument):
                print("minimal native build: refusing a symlink build directory")
                return 2i64
            if is_directory(build_argument):
                existing_build_directory: Path = try path_real(path_absolute(build_argument)) else err:
                    print("minimal native build: unable to resolve build directory")
                    return 2i64
                existing_build_directory_text: sview = f"{existing_build_directory}"
                if existing_build_directory_text == "/" or path_is_within(repository_directory_text, existing_build_directory_text):
                    print("minimal native build: refusing a build directory inside the source repository")
                    return 2i64
            else:
                parent: Path = build_argument.parent()
                if not is_directory(parent):
                    print("minimal native build: build directory parent must exist")
                    return 2i64
                canonical_parent: Path = try path_real(path_absolute(parent)) else err:
                    print("minimal native build: unable to resolve build directory parent")
                    return 2i64
                canonical_parent_text: sview = f"{canonical_parent}"
                if path_is_within(repository_directory_text, canonical_parent_text):
                    print("minimal native build: refusing a build directory inside the source repository")
                    return 2i64
                created: bool = try create_directory(build_argument) else false
                if not created and not is_directory(build_argument):
                    print("minimal native build: unable to create build directory")
                    return 2i64

            if is_symlink(build_argument):
                print("minimal native build: refusing a symlink build directory")
                return 2i64
            build_directory: Path = try path_real(path_absolute(build_argument)) else err:
                print("minimal native build: unable to resolve build directory")
                return 2i64
            build_directory_text: sview = f"{build_directory}"
            if build_directory_text == "/" or path_is_within(repository_directory_text, build_directory_text):
                print("minimal native build: refusing a build directory inside the source repository")
                return 2i64

            main_source: Path = project_directory.joinpath("src").joinpath("main.c")
            answer_source: Path = project_directory.joinpath("src").joinpath("answer.c")
            answer_header: Path = project_directory.joinpath("include").joinpath("answer.h")
            generated_header_template: sview = "generated_build_config_variant.h.in" if use_header_variant else "generated_build_config.h.in"
            generated_header_input: Path = project_directory.joinpath("include").joinpath(generated_header_template)
            generated_header_output: Path = build_directory.joinpath("generated_build_config.h")
            obsolete_header_output: Path = build_directory.joinpath(Toolchain::OBSOLETE_HEADER_FILENAME)
            answer_object: Path = build_directory.joinpath("answer.o")
            main_object: Path = build_directory.joinpath("main.o")
            main_object_seed: Path = build_directory.joinpath("main.o.byte-identical-seed")
            static_library: Path = build_directory.joinpath(Toolchain::LIBRARY_FILENAME)
            include_directory: Path = project_directory.joinpath("include")
            output_path: Path = build_directory.joinpath(Toolchain::TARGET_NAME)
            if is_symlink(output_path):
                print("minimal native build: refusing a symlink at the target output path")
                return 2i64
            main_source_text: sview = f"{main_source}"
            answer_source_text: sview = f"{answer_source}"
            answer_header_text: sview = f"{answer_header}"
            generated_header_input_text: sview = f"{generated_header_input}"
            generated_header_output_text: sview = f"{generated_header_output}"
            obsolete_header_output_text: sview = f"{obsolete_header_output}"
            answer_object_text: sview = f"{answer_object}"
            main_object_text: sview = f"{main_object}"
            main_object_seed_text: sview = f"{main_object_seed}"
            static_library_text: sview = f"{static_library}"
            include_directory_text: sview = f"{include_directory}"
            output_path_text: sview = f"{output_path}"
            main_source_relative: sview = filesystem_root_relative(main_source_text)
            answer_source_relative: sview = filesystem_root_relative(answer_source_text)
            answer_header_relative: sview = filesystem_root_relative(answer_header_text)
            generated_header_input_relative: sview = filesystem_root_relative(generated_header_input_text)
            generated_header_output_relative: sview = filesystem_root_relative(generated_header_output_text)
            obsolete_header_output_relative: sview = filesystem_root_relative(obsolete_header_output_text)
            answer_object_relative: sview = filesystem_root_relative(answer_object_text)
            main_object_relative: sview = filesystem_root_relative(main_object_text)
            main_object_seed_relative: sview = filesystem_root_relative(main_object_seed_text)
            static_library_relative: sview = filesystem_root_relative(static_library_text)
            output_path_relative: sview = filesystem_root_relative(output_path_text)

            generator_executable: sview = Toolchain::COPY
            generator_arguments: darray[sview] = [generated_header_input_text, generated_header_output_text]
            main_compiler_executable: mutable sview = Toolchain::C_COMPILER
            main_compiler_arguments: mutable darray[sview] = ["-std=c11", "-pedantic", "-Wall", "-Wextra", "-Werror", "-I", include_directory_text, "-I", build_directory_text, "-c", main_source_text, "-o", main_object_text]
            if no_write_main:
                main_compiler_executable <- Toolchain::NO_WRITE
                main_compiler_arguments <- []
            elif partial_main_failure:
                main_compiler_executable <- Toolchain::PARTIAL_FAIL
                main_compiler_arguments <- ["-v", "output=" + main_object_text, "BEGIN { print \"partial-object-created\"; print \"partial\" > output; close(output); exit 1 }"]
            elif byte_identical_main:
                main_compiler_executable <- Toolchain::COPY
                main_compiler_arguments <- [main_object_seed_text, main_object_text]
            generate_header_command: ProcessCommand = ProcessCommand{
                executable: generator_executable,
                arguments: generator_arguments,
                working_directory: project_directory_text,
                stdin_mode: ProcessStdioMode.Null,
                stdout_mode: ProcessStdioMode.Capture,
                stderr_mode: ProcessStdioMode.Capture,
                timeout_micros: Toolchain::TIMEOUT_MICROS,
                capture_output_limit_bytes: Toolchain::OUTPUT_LIMIT_BYTES
            }
            compile_answer_command: ProcessCommand = ProcessCommand{
                executable: Toolchain::C_COMPILER,
                arguments: ["-std=c11", "-pedantic", "-Wall", "-Wextra", "-Werror", "-I", include_directory_text, "-c", answer_source_text, "-o", answer_object_text],
                working_directory: project_directory_text,
                stdin_mode: ProcessStdioMode.Null,
                stdout_mode: ProcessStdioMode.Capture,
                stderr_mode: ProcessStdioMode.Capture,
                timeout_micros: Toolchain::TIMEOUT_MICROS,
                capture_output_limit_bytes: Toolchain::OUTPUT_LIMIT_BYTES
            }
            archive_command: ProcessCommand = ProcessCommand{
                executable: Toolchain::ARCHIVER,
                arguments: ["rcs", static_library_text, answer_object_text],
                working_directory: project_directory_text,
                stdin_mode: ProcessStdioMode.Null,
                stdout_mode: ProcessStdioMode.Capture,
                stderr_mode: ProcessStdioMode.Capture,
                timeout_micros: Toolchain::TIMEOUT_MICROS,
                capture_output_limit_bytes: Toolchain::OUTPUT_LIMIT_BYTES
            }
            compile_main_command: ProcessCommand = ProcessCommand{
                executable: main_compiler_executable,
                arguments: main_compiler_arguments,
                working_directory: project_directory_text,
                stdin_mode: ProcessStdioMode.Null,
                stdout_mode: ProcessStdioMode.Capture,
                stderr_mode: ProcessStdioMode.Capture,
                timeout_micros: Toolchain::TIMEOUT_MICROS,
                capture_output_limit_bytes: Toolchain::OUTPUT_LIMIT_BYTES
            }
            link_command: ProcessCommand = ProcessCommand{
                executable: Toolchain::C_COMPILER,
                arguments: [main_object_text, static_library_text, "-o", output_path_text],
                working_directory: project_directory_text,
                stdin_mode: ProcessStdioMode.Null,
                stdout_mode: ProcessStdioMode.Capture,
                stderr_mode: ProcessStdioMode.Capture,
                timeout_micros: Toolchain::TIMEOUT_MICROS,
                capture_output_limit_bytes: Toolchain::OUTPUT_LIMIT_BYTES
            }
            copy_obsolete_header_command: ProcessCommand = ProcessCommand{
                executable: Toolchain::COPY,
                arguments: [generated_header_output_text, obsolete_header_output_text],
                working_directory: project_directory_text,
                stdin_mode: ProcessStdioMode.Null,
                stdout_mode: ProcessStdioMode.Capture,
                stderr_mode: ProcessStdioMode.Capture,
                timeout_micros: Toolchain::TIMEOUT_MICROS,
                capture_output_limit_bytes: Toolchain::OUTPUT_LIMIT_BYTES
            }
            graph: mutable BuildGraph = BuildGraph{
                nodes: [
                    BuildNode{name: "generate-config-header", command: generate_header_command, dependencies: [], fingerprint: 1u64},
                    BuildNode{name: "compile-answer", command: compile_answer_command, dependencies: [], fingerprint: 2u64},
                    BuildNode{name: "archive-answer", command: archive_command, dependencies: [1], fingerprint: 3u64},
                    BuildNode{name: "compile-main", command: compile_main_command, dependencies: [0], fingerprint: 4u64},
                    BuildNode{name: Toolchain::TARGET_NAME, command: link_command, dependencies: [2, 3], fingerprint: 5u64}
                ],
                max_parallel: 1
            }
            main_recipe_inputs: mutable darray[sview] = [main_source_relative, answer_header_relative, generated_header_output_relative]
            if byte_identical_main:
                main_recipe_inputs.push(main_object_seed_relative)
            recipes: mutable darray[BuildIncrementalRecipeTarget] = [
                BuildIncrementalRecipeTarget{name: "generate-config-header", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 1u64, inputs: [generated_header_input_relative], outputs: [generated_header_output_relative]},
                BuildIncrementalRecipeTarget{name: "compile-answer", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 2u64, inputs: [answer_source_relative, answer_header_relative], outputs: [answer_object_relative]},
                BuildIncrementalRecipeTarget{name: "archive-answer", kind: BuildIncrementalTargetKind.StaticLibrary, recipe_fingerprint: 3u64, inputs: [answer_object_relative], outputs: [static_library_relative], dependencies: ["compile-answer"]},
                BuildIncrementalRecipeTarget{name: "compile-main", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 4u64, inputs: main_recipe_inputs, outputs: [main_object_relative], dependencies: ["generate-config-header"]},
                BuildIncrementalRecipeTarget{name: Toolchain::TARGET_NAME, kind: BuildIncrementalTargetKind.Executable, recipe_fingerprint: 5u64, inputs: [main_object_relative, static_library_relative], outputs: [output_path_relative], dependencies: ["archive-answer", "compile-main"]}
            ]
            toolchain_resolutions: mutable darray[BuildRecipeToolchainPath] = [
                BuildRecipeToolchainPath{command_executable: generator_executable, path: filesystem_root_relative(generator_executable)},
                BuildRecipeToolchainPath{command_executable: Toolchain::C_COMPILER, path: filesystem_root_relative(Toolchain::C_COMPILER)},
                BuildRecipeToolchainPath{command_executable: Toolchain::ARCHIVER, path: filesystem_root_relative(Toolchain::ARCHIVER)},
                BuildRecipeToolchainPath{command_executable: main_compiler_executable, path: filesystem_root_relative(main_compiler_executable)},
                BuildRecipeToolchainPath{command_executable: Toolchain::C_COMPILER, path: filesystem_root_relative(Toolchain::C_COMPILER)}
            ]
            if include_obsolete_target:
                graph.nodes.push(BuildNode{name: "obsolete-config-copy", command: copy_obsolete_header_command, dependencies: [0], fingerprint: 6u64})
                recipes.push(BuildIncrementalRecipeTarget{name: "obsolete-config-copy", kind: BuildIncrementalTargetKind.GeneratedFile, recipe_fingerprint: 6u64, inputs: [generated_header_output_relative], outputs: [obsolete_header_output_relative], dependencies: ["generate-config-header"]})
                toolchain_resolutions.push(BuildRecipeToolchainPath{command_executable: Toolchain::COPY, path: filesystem_root_relative(Toolchain::COPY)})
            root_fd: int = open_directory_capability("/")
            if root_fd < 0:
                print("minimal native build: unable to open filesystem-root capability")
                return 1i64
            cache_directory_fd: int = open_directory_capability(build_directory_text)
            if cache_directory_fd < 0:
                _ = elisascript_posix_close(root_fd)
                print("minimal native build: unable to open build-directory capability")
                return 1i64
            arena: mutable Arena = zeroed
            lock: mutable ArtifactCacheWriterLock = ArtifactCacheWriterLock{}
            cached_run: mutable BuildIncrementalPosixCacheRun = BuildIncrementalPosixCacheRun{execution: BuildIncrementalPosixExecution{result: BuildExecutionResult{}, recipes: [], pre_execution_observations: []}, commit: BuildIncrementalCommit{}}
            catch execute_build_graph_incremental_cached_at(arena, lock, 1u64, cache_directory_fd, Toolchain::CACHE_LOCK, Toolchain::CACHE_NAME, Toolchain::CACHE_STAGING, root_fd, graph, recipes, toolchain_resolutions):
                ok value:
                    cached_run <- value
                error failure:
                    _ = elisascript_posix_close(cache_directory_fd)
                    _ = elisascript_posix_close(root_fd)
                    _ = write_stderr("minimal native build: build graph execution failed before completion\n")
                    return 1i64
            cache_close_status: int = elisascript_posix_close(cache_directory_fd)
            root_close_status: int = elisascript_posix_close(root_fd)
            if cache_close_status != 0 or root_close_status != 0:
                print("minimal native build: unable to close build capabilities")
                return 1i64
            execution: BuildExecutionResult = cached_run.execution.result
            expected_node_count: usize = 6 if include_obsolete_target else 5
            if execution.graph_state != BuildGraphState.Succeeded or execution.nodes.count != expected_node_count:
                report_failed_build_nodes(execution)
                return 1i64
            for node in execution.nodes:
                return 1i64 if node.exit_status != 0 or node.failure != BuildExecutionFailureKind.None
            if every_build_node_was_cached(execution):
                print("build_cache=up_to_date")
            else:
                print("build_cache=rebuilt")
                for node in execution.nodes:
                    if node.started:
                        print("rebuilt=" + node.target_name)
            program_result: ProcessCapture = try capture_process_result_in_directory(executable(output_path_text), [], "", build_directory, Toolchain::TIMEOUT_MICROS.i64(), Toolchain::OUTPUT_LIMIT_BYTES.i64()) else err:
                print("minimal native build: unable to run built executable")
                return 1i64
            if program_result.status != 0 or program_result.stdout != "answer=42\n" or program_result.stderr != "":
                print("minimal native build: executable status/stdout/stderr mismatch")
                return 1i64
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, Directory.Read, Directory.Write, Process.Run, Unsafe.PointerCast]:
    if arguments.count < 1 or arguments.count > 2:
        print("usage: build.elisascript ABSOLUTE_BUILD_DIRECTORY [variant|partial-fail-compile|no-write-compile|byte-identical-variant|add-obsolete-variant]")
        return 2i64
    if arguments.count == 2 and arguments[1] != "variant" and arguments[1] != "partial-fail-compile" and arguments[1] != "no-write-compile" and arguments[1] != "byte-identical-variant" and arguments[1] != "add-obsolete-variant":
        print("usage: build.elisascript ABSOLUTE_BUILD_DIRECTORY [variant|partial-fail-compile|no-write-compile|byte-identical-variant|add-obsolete-variant]")
        return 2i64
    use_header_variant: bool = arguments.count == 2 and (arguments[1] == "variant" or arguments[1] == "byte-identical-variant" or arguments[1] == "add-obsolete-variant")
    partial_main_failure: bool = arguments.count == 2 and arguments[1] == "partial-fail-compile"
    no_write_main: bool = arguments.count == 2 and arguments[1] == "no-write-compile"
    byte_identical_main: bool = arguments.count == 2 and arguments[1] == "byte-identical-variant"
    include_obsolete_target: bool = arguments.count == 2 and arguments[1] == "add-obsolete-variant"
    return EsMinimalNativeBuild::build(arguments[0], use_header_variant, partial_main_failure, no_write_main, byte_identical_main, include_obsolete_target)
