# ElisaScript translation of reference.py's bounded CSV/TSV oracle slice.

include "../../../../src/runtime/encoding.elisa"
include "../../../../src/runtime/data_model.elisa"
include "../../../../src/runtime/json_model.elisa"
include "../../../../src/runtime/schema_model.elisa"
include "../../../../src/runtime/record_numeric_model.elisa"
include "../../../../src/runtime/schema_integer_conversion.elisa"
include "../../../../src/runtime/csv_model.elisa"
include "../../../../src/runtime/csv_materializer_model.elisa"
include "../../../../src/runtime/csv_parser_model.elisa"
include "../../../../src/runtime/csv_encode_model.elisa"
include "../../../../src/runtime/schema_csv_materializer.elisa"

using EsCsv
using EsCsvEncode
using EsCsvMaterialize
using EsCsvParser
using EsData
using EsEncoding
using EsJson
using EsRecordNumeric
using EsSchema
using EsSchemaNumeric
using EsSchemaCsv


module EsCsvIoReferencePort:
    using EsCsv
    using EsCsvEncode
    using EsCsvMaterialize
    using EsCsvParser
    using EsData
    using EsSchema
    using EsSchemaNumeric
    using EsSchemaCsv

    private:
        const module Inputs:
            CORPUS: sview = "label,note\nplain,ascii\nquoted,\"comma, quote \"\"and\"\"\"\nmultiline,\"line 1\nline 2\"\nempty,\"\"\nunicode,blåbær\n"
            MALFORMED: sview = "\"unterminated,value\n"


        error CsvPortError:
            InvalidMaterializedRow
            InvalidInput


        def csv_port_bytes_view(bytes: darray[u8]) -> sview:
            return bytes_view(bytes)


        def csv_port_append_bytes(output: mutable darray[u8]&, bytes: darray[u8]) can[Memory.Allocate, Abort.Panic]:
            for byte in bytes |output|:
                output.push(byte)


        def csv_port_schema() -> EsSchema::SchemaDescriptor:
            return EsSchema::SchemaDescriptor{
                name: "csv_io_reference_port",
                source: EsSchema::SchemaSource.Csv,
                fields: [
                    EsSchema::SchemaField{name: "label", kind: EsSchema::SchemaValueKind.Text},
                    EsSchema::SchemaField{name: "note", kind: EsSchema::SchemaValueKind.Text}
                ]
            }


        def csv_port_round_trip() -> darray[u8] error[EsData::DataContractError, EsCsv::CsvContractError, EsCsvMaterialize::CsvMaterializerError, EsSchema::SchemaContractError, EsSchemaNumeric::SchemaIntegerError, EsSchemaNumeric::SchemaDecimalError, EsSchemaCsv::SchemaCsvMaterializeError, EsCsvEncode::CsvEncodeError, CsvPortError] can[Memory.Allocate, Abort.Panic]:
            policy: EsData::CsvPolicy = EsData::CsvPolicy{line_ending: EsData::CsvLineEndingMode.Lf, header: true}
            materializer: EsCsvMaterialize::CsvMaterializer = try EsCsvParser::parse_csv_materializer(Inputs::CORPUS, policy)
            raise CsvPortError.InvalidInput if materializer.records.count == 0
            schema: EsSchema::SchemaDescriptor = csv_port_schema()
            batch: EsSchemaCsv::SchemaCsvRecordBatch = try EsSchemaCsv::materialize_csv_schema_batch(schema, materializer, 0, materializer.records.count - 1)

            output: mutable darray[u8] = []
            encoded_header: darray[u8] = try EsCsvEncode::encode_csv_record(["label", "note"], policy)
            csv_port_append_bytes(output, encoded_header)
            for record in batch.records |output|:
                fields: mutable darray[sview] = []
                for value in record.values |fields|:
                    raise CsvPortError.InvalidMaterializedRow if value.kind != EsSchemaCsv::SchemaCsvValueKind.Text
                    fields.push(csv_port_bytes_view(value.bytes))
                encoded_record: darray[u8] = try EsCsvEncode::encode_csv_record(fields, policy)
                csv_port_append_bytes(output, encoded_record)
            return output


        def csv_port_malformed_rejected(policy: EsData::CsvPolicy) -> bool:
            return catch EsCsvParser::parse_csv_materializer(Inputs::MALFORMED, policy):
                ok _:
                    false
                error failure:
                    failure == EsCsv::CsvContractError.UnexpectedEnd


    public:
        struct BatchOutput:
            status: i64
            bytes: darray[u8]


        # The Python reference ignores argv; keep that observable behavior.
        def batch_output() -> BatchOutput can[Memory.Allocate, Abort.Panic]:
            policy: EsData::CsvPolicy = EsData::CsvPolicy{line_ending: EsData::CsvLineEndingMode.Lf, header: true}
            marker: sview = "malformed=error" if csv_port_malformed_rejected(policy) else "malformed=accepted"
            output: BatchOutput = catch csv_port_round_trip():
                ok round_trip:
                    bytes: mutable darray[u8] = []
                    csv_port_append_bytes(bytes, round_trip)
                    for byte in marker |bytes|:
                        bytes.push(byte)
                    bytes.push(10u8)
                    BatchOutput{status: 0i64, bytes: bytes}
                error _:
                    BatchOutput{status: 1i64, bytes: []}
            return output


        def run(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            _ = arguments
            result: BatchOutput = batch_output()
            if result.status != 0i64:
                print("csv=error")
                return result.status
            printr(csv_port_bytes_view(result.bytes))
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    return EsCsvIoReferencePort::run(arguments)
