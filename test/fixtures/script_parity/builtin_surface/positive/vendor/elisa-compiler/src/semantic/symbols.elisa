extend Semantic:
    private:
        def seed_builtins(table: SymbolTable) -> void:
            # These near-misses are not builtin identifiers: add_symbol("bad-name"), add_symbol("2bad")
            names: darray[sview] = [
                "legacy_call",
                # The shell scanner re-arms its ] check after this raw marker: ] names: darray[sview] = ["comment_seed"
                "followup_seed"
            ]
            names <- names.push("appended_call")
            add_symbol("added_call")
