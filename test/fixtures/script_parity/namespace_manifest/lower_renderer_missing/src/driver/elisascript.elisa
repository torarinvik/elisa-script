module EsDriver:
    def bytecode_issue_detail(issue):
        if issue.kind == IssueKind.Missing:
            return "missing"
        return "unknown"
    def runtime_error_detail():
        return "runtime error"
    def lower_issue_detail(issue):
        return "no source issue details"
    def entrypoint_error_detail():
        return "entrypoint error"
