module EsDriver:
    def bytecode_issue_detail(issue):
        if issue.kind == IssueKind.Missing:
            return "missing"
        return "unknown"
    def runtime_error_detail():
        return "runtime error"
    def lower_issue_detail(issue):
        if issue.kind == LowerIssueKind.Missing:
            return "missing"
        return "unknown"
    def entrypoint_error_detail():
        return "entrypoint error"
    def parse_error_detail(error):
        if error.kind == ParseErrorKind.ExpectedToken:
            return "expected token"
        return "parse error"
    def report_program_failure():
        return "failure"
