# C02 Perl-shaped string-replacement parity candidate.

def main(arguments: darray[sview]) -> i64 can[Console.Write, Memory.Allocate, Abort.Panic]:
    if arguments.count != 0:
        _ = write_stderr("usage: candidate\n")
        return 2i64

    fields: sview = regex_sub(regex"([a-z]+)=([0-9]+)", "$1:$2", "id=42; id=7")
    named: sview = regex_sub(regex"(?<word>[a-z]+)", "<${word}>", "elisa")
    alternatives: sview = replace_regex("cat dog", regex"cat|dog", "<$&>")
    anchored_start: sview = replace_regex("abc", regex"^", ">")
    anchors: sview = replace_regex(anchored_start, regex"$", "!")
    deletion_pattern: Regex = regex"na"
    deleted: sview = deletion_pattern.sub("", "banana")
    eof: sview = replace_regex("abc", regex"$", "!")

    print(fields)
    print(named)
    print(alternatives)
    print(anchors)
    print(deleted)
    print(eof)
    return 0i64
