# Unicode outside audited identifiers is accepted: café, 日本語, 🧪
module EsIr:
    public:
        struct ElisascriptProgramDiagnostic:
            source: sview # source bytes are not field-name bytes
            execution: sview
            entrypoint_error: sview

        def elisascript_program_diagnostic_snapshot_fingerprint(diagnostic: ElisascriptProgramDiagnostic&) -> usize:
            # Keep non-ASCII text out of the identifier being audited: résumé.
            return len(diagnostic.source) + len(diagnostic.entrypoint_error)

        def elisascript_program_diagnostic_snapshot_equal(left: ElisascriptProgramDiagnostic&, right: ElisascriptProgramDiagnostic&) -> bool:
            return left.source == right.source and left.entrypoint_error == right.entrypoint_error
