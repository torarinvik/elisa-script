# Python-oriented port of wasmbrowser-proof/scripts/check_source_length.py.
# Resolve the same parent directory as the Python reference.
include "../../../../src/runtime/source_length_stream_posix.elisa"

module EsProofSourceLength:
    private:
        const module Limits:
            MAX_LINES: usize = 600


        struct Oversized:
            relative_path: sview
            lines: usize


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr("source length audit: " + message + "\n")


        def append_text(output: mutable darray[u8]&, text: sview) can[Memory.Allocate, Abort.Panic]:
            for byte in text |output|:
                output.push(byte)


        # POSIX filenames cannot contain NUL. Replacing the separator by NUL
        # makes byte sorting compare each component before its descendants.
        # For example, a/z.elisa sorts before a.elisa, as pathlib requires.
        def path_order_key(value: sview) -> sview:
            return replace(value, "/", "\0")

    public:
        # Inputs are POSIX filesystem paths (no embedded NUL), not arbitrary
        # text. Keep this policy callable by independent ordering fixtures.
        def ordered_source_paths(paths: darray[sview]) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            keys: mutable darray[sview] = []
            for value in paths:
                keys.push(path_order_key(value))
            result: mutable darray[sview] = []
            for key in sorted(keys):
                result.push(replace(key, "\0", "/"))
            return result


        # Return exact streams separately so the parity harness can compare the
        # port without redirecting the test process's own stdout/stderr.
        def observe_root(project_root: Path, stdout: mutable darray[u8]&, stderr: mutable darray[u8]&) -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Format]:
            stdout <- []
            stderr <- []
            source_root: Path = project_root.joinpath("src")
            exists: bool = try is_directory(source_root) else err:
                append_text(stderr, "source length audit: unable to inspect source root\n")
                return 2i64
            # Python's rglob over a missing/non-directory root yields no files.
            return 0i64 if not exists

            directories: mutable darray[Path] = [source_root]
            source_paths: mutable darray[sview] = []
            while directories.count > 0:
                current: Path = directories.pop()
                children: darray[sview] = try current.iterdir() else err:
                    append_text(stderr, f"source length audit: unable to enumerate directory: {current}\n")
                    return 2i64
                for child in children:
                    child_path: Path = path(child)
                    # Include hidden names, file symlinks, and matching
                    # directories. A matching directory must fail when read,
                    # not silently disappear from the rglob result.
                    if child_path.name().endswith(".elisa"):
                        source_paths.push(child)
                    continue if is_symlink(child_path)
                    child_is_directory: bool = try is_directory(child_path) else err:
                        append_text(stderr, f"source length audit: unable to inspect entry: {child_path}\n")
                        return 2i64
                    if child_is_directory:
                        directories.push(child_path)

            oversized: mutable darray[Oversized] = []
            for source_path in ordered_source_paths(source_paths):
                input_path: Path = path(source_path)
                scan: EsSourceLengthFile::ScanResult = try EsSourceLengthFile::read_utf8_line_count(input_path) else err:
                    append_text(stderr, f"source length audit: unable to read UTF-8 source: {input_path}\n")
                    return 2i64
                lines: usize = scan.lines
                if lines > Limits::MAX_LINES:
                    relative: Path = input_path.relative_to(project_root)
                    oversized.push(Oversized{relative_path: f"{relative}", lines: lines})

            # Like Python, emit no size diagnostics until all reads succeed.
            for source in oversized:
                append_text(stderr, f"source file exceeds {Limits::MAX_LINES} lines: {source.relative_path} ({source.lines})\n")
            return 1i64 if oversized.count > 0 else 0i64


        def run_root(project_root: Path) -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
            stdout: mutable darray[u8] = []
            stderr: mutable darray[u8] = []
            status: i64 = observe_root(project_root, stdout, stderr)
            if stdout.count != 0:
                _ = write_stdout(bytes_view(stdout))
            if stderr.count != 0:
                _ = write_stderr(bytes_view(stderr))
            return status


        def run_default() -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
            script_file: Path = try path_real(path(Script::source_path())) else err:
                diagnostic("unable to resolve script path")
                return 2i64
            script_directory: Path = script_file.parent()
            project_root: Path = script_directory.parent()
            return run_root(project_root)


def main(arguments: darray[sview]) -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
    _ = arguments
    return EsProofSourceLength::run_default()
