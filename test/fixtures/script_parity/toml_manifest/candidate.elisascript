# Elisascript candidate for the A06/C07 observed-project TOML parity slice.

include "../../../../src/runtime/encoding.elisa"
include "../../../../src/runtime/bounded_text_posix.elisa"
include "../../../../src/runtime/config_model.elisa"
include "../../../../src/runtime/config_toml_model.elisa"
include "../../../../src/runtime/config_toml_file_posix.elisa"

using EsConfigToml
using EsConfigTomlFilePosix
using EsConfig
using EsBoundedText


module EsTomlManifestCandidate:
    private:
        def append_text(output: mutable darray[u8]&, text: sview) can[Memory.Allocate, Abort.Panic]:
            for byte in text |output|:
                output.push(byte)


        def append_bytes(output: mutable darray[u8]&, bytes: darray[u8]) can[Memory.Allocate, Abort.Panic]:
            for byte in bytes |output|:
                output.push(byte)


        def inline_field_index(value: ConfigTomlValue&, key: sview) -> usize:
            for index in 0..<value.fields.count |value|:
                return index if bytes_view(value.fields[index].key) == key
            return value.fields.count


        def append_field(output: mutable darray[u8]&, prefix: sview, value: ConfigTomlValue&, key: sview) can[Memory.Allocate, Abort.Panic]:
            field_index: usize = inline_field_index(value, key)
            if field_index < value.fields.count:
                append_text(output, prefix + key + "=")
                append_bytes(output, value.fields[field_index].text)
                append_text(output, "\n")


        def append_scalar(output: mutable darray[u8]&, parsed: ConfigTomlLayer&, key: sview, output_key: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            value_index: usize = lookup_toml_config_value(parsed, key)
            return false if value_index >= parsed.values.count
            value: ConfigTomlValue = parsed.values[value_index]
            return false if value.kind == ConfigTomlValueKind.Array or value.kind == ConfigTomlValueKind.InlineTable
            append_text(output, output_key + "=")
            append_bytes(output, value.text)
            append_text(output, "\n")
            return true


        def append_array(output: mutable darray[u8]&, parsed: ConfigTomlLayer&, key: sview, output_key: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            value_index: usize = lookup_toml_config_value(parsed, key)
            return false if value_index >= parsed.values.count
            value: ConfigTomlValue = parsed.values[value_index]
            return false if value.kind != ConfigTomlValueKind.Array
            for item in value.items |output|:
                return false if item.kind != ConfigTomlValueKind.Text
                append_text(output, output_key + "=")
                append_bytes(output, item.text)
                append_text(output, "\n")
            return true


        def render_cargo(path_text: sview) -> darray[u8] error[ReadError, ConfigTomlError, ConfigError, ConfigTomlFileError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            loaded: ConfigTomlFileLayer = try read_config_toml_file(path(path_text))
            parsed: ConfigTomlLayer = loaded.parsed
            resolver_index: usize = lookup_toml_config_value(parsed, "workspace.resolver")
            version_index: usize = lookup_toml_config_value(parsed, "workspace.package.version")
            edition_index: usize = lookup_toml_config_value(parsed, "workspace.package.edition")
            members_index: usize = lookup_toml_config_value(parsed, "workspace.members")
            wasmtime_index: usize = lookup_toml_config_value(parsed, "workspace.dependencies.wasmtime")
            sha2_alias_index: usize = lookup_toml_config_value(parsed, "workspace.dependencies.sha2_11")
            return [] if resolver_index >= parsed.values.count or version_index >= parsed.values.count or edition_index >= parsed.values.count
            return [] if members_index >= parsed.values.count or wasmtime_index >= parsed.values.count or sha2_alias_index >= parsed.values.count
            return [] if parsed.values[members_index].kind != ConfigTomlValueKind.Array
            return [] if parsed.values[wasmtime_index].kind != ConfigTomlValueKind.InlineTable
            return [] if parsed.values[sha2_alias_index].kind != ConfigTomlValueKind.InlineTable

            output: mutable darray[u8] = []
            append_text(output, "workspace.resolver=")
            append_bytes(output, parsed.values[resolver_index].text)
            append_text(output, "\nworkspace.package.version=")
            append_bytes(output, parsed.values[version_index].text)
            append_text(output, "\nworkspace.package.edition=")
            append_bytes(output, parsed.values[edition_index].text)
            append_text(output, "\n")

            members: ConfigTomlValue = parsed.values[members_index]
            for member in members.items |output|:
                return [] if member.kind != ConfigTomlValueKind.Text
                append_text(output, "workspace.member=")
                append_bytes(output, member.text)
                append_text(output, "\n")

            wasmtime: ConfigTomlValue = parsed.values[wasmtime_index]
            wasmtime_version_index: usize = inline_field_index(wasmtime, "version")
            wasmtime_features_index: usize = inline_field_index(wasmtime, "features")
            return [] if wasmtime_version_index >= wasmtime.fields.count or wasmtime_features_index >= wasmtime.fields.count
            return [] if wasmtime.fields[wasmtime_features_index].kind != ConfigTomlValueKind.Array
            append_field(output, "workspace.dependencies.wasmtime.", wasmtime, "version")
            for feature in wasmtime.fields[wasmtime_features_index].items |output|:
                return [] if feature.kind != ConfigTomlValueKind.Text
                append_text(output, "workspace.dependencies.wasmtime.feature=")
                append_bytes(output, feature.text)
                append_text(output, "\n")

            sha2_alias: ConfigTomlValue = parsed.values[sha2_alias_index]
            return [] if inline_field_index(sha2_alias, "package") >= sha2_alias.fields.count
            return [] if inline_field_index(sha2_alias, "version") >= sha2_alias.fields.count
            append_field(output, "workspace.dependencies.sha2_11.", sha2_alias, "package")
            append_field(output, "workspace.dependencies.sha2_11.", sha2_alias, "version")
            return output


        def render_pyproject(path_text: sview) -> darray[u8] error[ReadError, ConfigTomlError, ConfigError, ConfigTomlFileError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            loaded: ConfigTomlFileLayer = try read_config_toml_file(path(path_text))
            parsed: ConfigTomlLayer = loaded.parsed
            output: mutable darray[u8] = []
            return [] if not append_scalar(output, parsed, "project.name", "pyproject.project.name")
            return [] if not append_scalar(output, parsed, "project.version", "pyproject.project.version")
            return [] if not append_scalar(output, parsed, "project.requires-python", "pyproject.project.requires-python")
            return [] if not append_scalar(output, parsed, "build-system.build-backend", "pyproject.build-system.build-backend")
            return [] if not append_array(output, parsed, "build-system.requires", "pyproject.build-system.requires")
            return [] if not append_scalar(output, parsed, "tool.ruff.target-version", "pyproject.tool.ruff.target-version")
            return [] if not append_array(output, parsed, "tool.ruff.extend-exclude", "pyproject.tool.ruff.extend-exclude")
            return [] if not append_array(output, parsed, "tool.setuptools.packages.find.where", "pyproject.tool.setuptools.packages.find.where")
            return [] if not append_array(output, parsed, "tool.pytest.ini_options.pythonpath", "pyproject.tool.pytest.pythonpath")
            return [] if not append_array(output, parsed, "tool.pytest.ini_options.testpaths", "pyproject.tool.pytest.testpaths")
            return [] if not append_array(output, parsed, "tool.pytest.ini_options.python_files", "pyproject.tool.pytest.python_files")
            return [] if not append_scalar(output, parsed, "tool.pytest.ini_options.addopts", "pyproject.tool.pytest.addopts")
            return [] if not append_array(output, parsed, "tool.pytest.ini_options.markers", "pyproject.tool.pytest.marker")
            return output


        def render_hugo(path_text: sview) -> darray[u8] error[ReadError, ConfigTomlError, ConfigError, ConfigTomlFileError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            loaded: ConfigTomlFileLayer = try read_config_toml_file(path(path_text))
            parsed: ConfigTomlLayer = loaded.parsed
            output: mutable darray[u8] = []
            return [] if not append_scalar(output, parsed, "baseURL", "hugo.baseURL")
            return [] if not append_scalar(output, parsed, "title", "hugo.title")
            return [] if not append_scalar(output, parsed, "enableRobotsTXT", "hugo.enableRobotsTXT")
            return [] if not append_array(output, parsed, "theme", "hugo.theme")
            return [] if not append_array(output, parsed, "disableKinds", "hugo.disableKinds")
            return [] if not append_scalar(output, parsed, "permalinks.blog", "hugo.permalinks.blog")
            return [] if not append_scalar(output, parsed, "imaging.quality", "hugo.imaging.quality")
            return [] if not append_scalar(output, parsed, "services.googleAnalytics.id", "hugo.services.googleAnalytics.id")
            return [] if not append_scalar(output, parsed, "languages.en.languageName", "hugo.languages.en.languageName")
            return [] if not append_scalar(output, parsed, "markup.goldmark.renderer.unsafe", "hugo.markup.goldmark.renderer.unsafe")
            return [] if not append_scalar(output, parsed, "params.ui.feedback.yes", "hugo.params.ui.feedback.yes")
            return [] if not append_scalar(output, parsed, "params.links.user.0.name", "hugo.params.links.user.0.name")
            return [] if not append_scalar(output, parsed, "params.links.user.0.url", "hugo.params.links.user.0.url")
            return [] if not append_scalar(output, parsed, "params.links.developer.0.name", "hugo.params.links.developer.0.name")
            return [] if not append_scalar(output, parsed, "params.mermaid.enable", "hugo.params.mermaid.enable")
            return output


    public:
        def run(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Console.Write, Unsafe.PointerCast]:
            if arguments.count != 4 or arguments[0] != "--parity-batch":
                _ = write_stderr("usage: candidate --parity-batch <cargo.toml> <pyproject.toml> <hugo.toml>\n")
                return 2i64
            cargo_output: darray[u8] = catch render_cargo(arguments[1]):
                ok output:
                    output
                error failure:
                    _ = write_stderr("Elisascript TOML file read or parse failed\n")
                    return 1i64
            return 1i64 if cargo_output.count == 0
            pyproject_output: darray[u8] = catch render_pyproject(arguments[2]):
                ok output:
                    output
                error failure:
                    _ = write_stderr("Elisascript TOML file read or parse failed\n")
                    return 1i64
            return 1i64 if pyproject_output.count == 0
            hugo_output: darray[u8] = catch render_hugo(arguments[3]):
                ok output:
                    output
                error failure:
                    _ = write_stderr("Elisascript TOML file read or parse failed\n")
                    return 1i64
            return 1i64 if hugo_output.count == 0
            rendered: mutable darray[u8] = []
            append_bytes(rendered, cargo_output)
            append_bytes(rendered, pyproject_output)
            append_bytes(rendered, hugo_output)
            _ = write_stdout(bytes_view(rendered))
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Console.Write, Unsafe.PointerCast]:
    return EsTomlManifestCandidate::run(arguments)
