# Python-oriented port of elisa-engine/scripts/check_source_length.py.
include "../../../../src/runtime/engine_source_length_model.elisa"
include "../../../../src/runtime/source_length_stream_posix.elisa"

using EsEngineSourceLengthModel


module EsEngineSourceLength:
    private:
        const module Policy:
            MAX_SOURCE_LINES: usize = 600


        const module SourceRoots:
            PLAN: sview = "Elisa_Engine_Architecture_and_Plan.md"
            SRC: sview = "src"
            TEST: sview = "test"
            PROOF: sview = "proof"
            EXAMPLES: sview = "examples"
            SCRIPTS: sview = "scripts"
            NATIVE: sview = "native"
            BACKENDS: sview = "backends"
            DOCS: sview = "docs"


        error DiscoveryError:
            UnableToDiscover


        struct Violation:
            relative_path: sview
            line_count: usize


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr("source length audit: " + message + "\n")


        def append_text(output: mutable darray[u8]&, text: sview) can[Memory.Allocate, Abort.Panic]:
            for byte in text |output|:
                output.push(byte)


        def collect_root_files(root: Path) -> darray[sview] error[DiscoveryError] can[Directory.Read, File.Read, Memory.Allocate, Abort.Panic]:
            directories: mutable darray[Path] = [root]
            paths: mutable darray[sview] = []
            while directories.count > 0:
                current: Path = directories.pop()
                children: darray[sview] = try current.iterdir() else err:
                    raise DiscoveryError.UnableToDiscover
                for child in children:
                    child_path: Path = path(child)
                    child_is_file: bool = try is_file(child_path) else err:
                        raise DiscoveryError.UnableToDiscover
                    if child_is_file:
                        if source_name_matches(child_path.name()):
                            paths.push(child)
                        continue
                    continue if is_symlink(child_path)
                    child_is_directory: bool = try is_directory(child_path) else err:
                        raise DiscoveryError.UnableToDiscover
                    if child_is_directory:
                        directories.push(child_path)
            return ordered_source_paths(paths)


        def collect_source_files(project_root: Path) -> darray[sview] error[DiscoveryError] can[Directory.Read, File.Read, Memory.Allocate, Abort.Panic]:
            result: mutable darray[sview] = []
            plan: Path = project_root.joinpath(SourceRoots::PLAN)
            plan_is_file: bool = try is_file(plan) else false
            if plan_is_file:
                result.push(f"{plan}")

            roots: darray[sview] = [
                SourceRoots::SRC,
                SourceRoots::TEST,
                SourceRoots::PROOF,
                SourceRoots::EXAMPLES,
                SourceRoots::SCRIPTS,
                SourceRoots::NATIVE,
                SourceRoots::BACKENDS,
                SourceRoots::DOCS
            ]
            for root_name in roots |result|:
                root: Path = project_root.joinpath(root_name)
                root_is_directory: bool = try is_directory(root) else false
                continue if not root_is_directory
                files: darray[sview] = try collect_root_files(root) else err:
                    raise DiscoveryError.UnableToDiscover
                for file in files |result|:
                    result.push(file)
            return result


    public:
        # Return exact output streams so the parity harness can exercise the
        # translation without redirecting the test process's own descriptors.
        def observe_root(project_root: Path, stdout: mutable darray[u8]&, stderr: mutable darray[u8]&) -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Format]:
            stdout <- []
            stderr <- []
            files: darray[sview] = try collect_source_files(project_root) else err:
                append_text(stderr, "source length audit: unable to discover source files\n")
                return 2i64

            violations: mutable darray[Violation] = []
            for source_path in files |violations|:
                input_path: Path = path(source_path)
                relative_path: Path = try input_path.relative_to(project_root) else err:
                    append_text(stderr, "source length audit: unable to form a project-relative path\n")
                    return 2i64
                scan: EsSourceLengthFile::ScanResult = try EsSourceLengthFile::read_utf8_line_count(input_path) else err:
                    append_text(stderr, "source length audit: unable to read UTF-8 source\n")
                    return 2i64
                if scan.lines > Policy::MAX_SOURCE_LINES:
                    violations.push(Violation{relative_path: f"{relative_path}", line_count: scan.lines})

            if violations.count > 0:
                for violation in violations:
                    append_text(stderr, f"{violation.relative_path}: {violation.line_count} lines (maximum {Policy::MAX_SOURCE_LINES})\n")
                return 1i64
            append_text(stdout, f"Source-length policy passed ({Policy::MAX_SOURCE_LINES}-line maximum).\n")
            return 0i64


        def run_root(project_root: Path) -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
            stdout: mutable darray[u8] = []
            stderr: mutable darray[u8] = []
            status: i64 = observe_root(project_root, stdout, stderr)
            if stdout.count != 0:
                _ = write_stdout(bytes_view(stdout))
            if stderr.count != 0:
                _ = write_stderr(bytes_view(stderr))
            return status


        def run_default() -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
            script_file: Path = try path_real(path(Script::source_path())) else err:
                diagnostic("unable to resolve script path")
                return 2i64
            script_directory: Path = script_file.parent()
            project_root: Path = script_directory.parent()
            return run_root(project_root)


def main(arguments: darray[sview]) -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
    _ = arguments
    return EsEngineSourceLength::run_default()
