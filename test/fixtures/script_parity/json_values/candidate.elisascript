# Bounded C06 JSON value and JSON Lines file-stream parity candidate.

include "../../../../src/runtime/encoding.elisa"
include "../../../../src/runtime/runtime.elisa"
include "../../../../src/runtime/stream_posix.elisa"
include "../../../../src/runtime/data_model.elisa"
include "../../../../src/runtime/json_model.elisa"
include "../../../../src/runtime/json_lexer_model.elisa"
include "../../../../src/runtime/json_parse_model.elisa"
include "../../../../src/runtime/json_stream_model.elisa"
include "../../../../src/runtime/jsonl_parse_model.elisa"
include "../../../../src/runtime/jsonl_file_posix.elisa"
include "../../../../src/runtime/json_encode_model.elisa"

using EsData
using EsJson
using EsJsonEncode
using EsJsonLex
using EsJsonLinesFilePosix
using EsJsonLinesParse
using EsJsonParse
using EsJsonStream


module EsJsonValuesParityCandidate:
    private:
        const module Inputs:
            SOURCE: sview = "{\"big\":1234567890123456789012345678901234567890,\"nullable\":null,\"nested\":{\"label\":\"blåbær\",\"items\":[true,null,4]},\"duplicate\":\"first\",\"duplicate\":\"last\"}"
            JSON_LINES_SOURCE: sview = "{\"id\":1,\"name\":\"blå\"}\n{\"id\":2,\"ok\":true}\n{\"id\":3,\"payload\":null}"
            JSON_LINES_PATH: cstr = "test/fixtures/script_parity/json_values/records.jsonl"


        error JsonParityError:
            InvalidRoot
            MissingMember
            WrongKind


        def json_values_bytes_view(bytes: darray[u8]) -> sview:
            return "" if bytes.count == 0
            data: u8& = (&bytes[0]).cast[u8&]
            return sview(data, 0, bytes.count.i64())


        def json_values_append_text(output: mutable darray[u8]&, text: sview) can[Memory.Allocate, Abort.Panic]:
            for byte in text |output|:
                output.push(byte)


        def json_values_append_bytes(output: mutable darray[u8]&, bytes: darray[u8]) can[Memory.Allocate, Abort.Panic]:
            for byte in bytes |output|:
                output.push(byte)


        def json_values_member(document: JsonDocument&, object_index: usize, key: sview) -> usize error[JsonContractError, JsonParityError]:
            member_index: usize = try json_object_member_index(document, object_index, key)
            raise JsonParityError.MissingMember if member_index == JSON_INDEX_NONE
            return document.members[member_index].value_index


        def json_values_scalar(document: JsonDocument&, node_index: usize, expected_kind: JsonNodeKind) -> darray[u8] error[JsonContractError, JsonParityError] can[Memory.Allocate, Abort.Panic]:
            raise JsonParityError.WrongKind if node_index >= document.nodes.count or document.nodes[node_index].kind != expected_kind
            return try copy_json_scalar(document, node_index)


        const enum JsonLinesRenderPhase of u8:
            ReadRecord
            Done


        def json_values_read_jsonl(reader: mutable JsonLinesReader&, output: mutable darray[u8]&) -> void error[JsonLinesParseError, JsonStreamError, DataContractError, JsonLexError, JsonParseError, JsonContractError, JsonEncodeError] can[Memory.Allocate, Abort.Panic]:
            phase: mutable JsonLinesRenderPhase = JsonLinesRenderPhase.ReadRecord
            record_count: mutable usize = 0
            machine over phase while phase != JsonLinesRenderPhase.Done:
                state ReadNext
                start ReadNext

                ReadNext, JsonLinesRenderPhase.ReadRecord:
                    result: JsonLinesReadResult = try next_json_lines_document(reader)
                    if result.has_document:
                        if record_count != 0:
                            json_values_append_text(output, "|")
                        encoded: darray[u8] = try encode_json_root(result.document, 0)
                        json_values_append_bytes(output, encoded)
                        record_count <- record_count + 1
                        -> ReadNext
                    phase <- JsonLinesRenderPhase.Done
                    continue

                ReadNext, JsonLinesRenderPhase.Done:
                    break


        def json_values_append_jsonl_memory(output: mutable darray[u8]&) -> void error[JsonLinesParseError, JsonStreamError, DataContractError, JsonLexError, JsonParseError, JsonContractError, JsonEncodeError] can[Memory.Allocate, Abort.Panic]:
            reader: mutable JsonLinesReader = try begin_json_lines_reader(Inputs::JSON_LINES_SOURCE)
            try json_values_read_jsonl(reader, output)


        def json_values_read_jsonl_file(reader: mutable JsonLinesFileReader&, output: mutable darray[u8]&) -> void error[FileStreamError, JsonLinesFileError, DataContractError, JsonStreamError, JsonLinesParseError, JsonLexError, JsonParseError, JsonContractError, JsonEncodeError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            phase: mutable JsonLinesRenderPhase = JsonLinesRenderPhase.ReadRecord
            record_count: mutable usize = 0
            machine over phase while phase != JsonLinesRenderPhase.Done:
                state ReadNext
                start ReadNext

                ReadNext, JsonLinesRenderPhase.ReadRecord:
                    result: JsonLinesReadResult = try next_json_lines_file_document(reader)
                    if result.has_document:
                        if record_count != 0:
                            json_values_append_text(output, "|")
                        encoded: darray[u8] = try encode_json_root(result.document, 0)
                        json_values_append_bytes(output, encoded)
                        record_count <- record_count + 1
                        -> ReadNext
                    phase <- JsonLinesRenderPhase.Done
                    continue

                ReadNext, JsonLinesRenderPhase.Done:
                    break


        def json_values_append_jsonl_file(output: mutable darray[u8]&) -> void error[FileStreamError, JsonLinesFileError, DataContractError, JsonStreamError, JsonLinesParseError, JsonLexError, JsonParseError, JsonContractError, JsonEncodeError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic]:
            reader: mutable JsonLinesFileReader = try begin_json_lines_file_reader(Inputs::JSON_LINES_PATH)
            catch json_values_read_jsonl_file(reader, output):
                ok completed:
                    _ = completed
                error failure:
                    catch close_json_lines_file_reader(reader):
                        ok closed:
                            _ = closed
                        error close_failure:
                            _ = close_failure
                    raise failure
            _ = try close_json_lines_file_reader(reader)


        def json_values_render() -> darray[u8] error[FileStreamError, JsonLinesFileError, DataContractError, JsonStreamError, JsonLinesParseError, JsonLexError, JsonParseError, JsonContractError, JsonEncodeError, JsonParityError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic]:
            policy: JsonPolicy = JsonPolicy{duplicate_keys: JsonDuplicateKeyPolicy.KeepLast}
            lexed: JsonLexedSource = try lex_json(Inputs::SOURCE, DataDecodeLimits{}, policy)
            document: JsonDocument = try parse_json_document(lexed)
            raise JsonParityError.InvalidRoot if document.state != JsonDocumentState.Sealed or document.roots.count != 1
            root_index: usize = document.roots[0]
            raise JsonParityError.InvalidRoot if document.nodes[root_index].kind != JsonNodeKind.Object

            output: mutable darray[u8] = []
            big_index: usize = try json_values_member(document, root_index, "big")
            big: darray[u8] = try json_values_scalar(document, big_index, JsonNodeKind.Number)
            json_values_append_text(output, "big=")
            json_values_append_bytes(output, big)
            json_values_append_text(output, "\n")

            absent_index: usize = try json_object_member_index(document, root_index, "absent")
            json_values_append_text(output, "missing=present\n") if absent_index != JSON_INDEX_NONE
            json_values_append_text(output, "missing=missing\n") if absent_index == JSON_INDEX_NONE

            nullable_index: usize = try json_values_member(document, root_index, "nullable")
            raise JsonParityError.WrongKind if document.nodes[nullable_index].kind != JsonNodeKind.Null
            json_values_append_text(output, "nullable=null\n")

            nested_index: usize = try json_values_member(document, root_index, "nested")
            raise JsonParityError.WrongKind if document.nodes[nested_index].kind != JsonNodeKind.Object
            label_index: usize = try json_values_member(document, nested_index, "label")
            label: darray[u8] = try json_values_scalar(document, label_index, JsonNodeKind.Text)
            json_values_append_text(output, "label=")
            json_values_append_bytes(output, label)
            json_values_append_text(output, "\n")

            items_index: usize = try json_values_member(document, nested_index, "items")
            items: JsonNode = document.nodes[items_index]
            raise JsonParityError.WrongKind if items.kind != JsonNodeKind.Array or items.child_count != 3
            json_values_append_text(output, "items.count=3\n")

            first_index: usize = document.children[items.child_start].value_index
            first: JsonNode = document.nodes[first_index]
            raise JsonParityError.WrongKind if first.kind != JsonNodeKind.Bool
            json_values_append_text(output, "item.0=true\n") if first.bool_value
            json_values_append_text(output, "item.0=false\n") if not first.bool_value

            second_index: usize = document.children[items.child_start + 1].value_index
            raise JsonParityError.WrongKind if document.nodes[second_index].kind != JsonNodeKind.Null
            json_values_append_text(output, "item.1=null\n")

            third_index: usize = document.children[items.child_start + 2].value_index
            third: darray[u8] = try json_values_scalar(document, third_index, JsonNodeKind.Number)
            json_values_append_text(output, "item.2=")
            json_values_append_bytes(output, third)
            json_values_append_text(output, "\n")

            duplicate_index: usize = try json_values_member(document, root_index, "duplicate")
            duplicate: darray[u8] = try json_values_scalar(document, duplicate_index, JsonNodeKind.Text)
            json_values_append_text(output, "duplicate=")
            json_values_append_bytes(output, duplicate)
            json_values_append_text(output, "\n")

            encoded: darray[u8] = try encode_json_root(document, 0)
            json_values_append_text(output, "json=")
            json_values_append_bytes(output, encoded)
            json_values_append_text(output, "\n")

            json_values_append_text(output, "jsonl=")
            try json_values_append_jsonl_memory(output)
            json_values_append_text(output, "\n")

            json_values_append_text(output, "jsonl_file=")
            try json_values_append_jsonl_file(output)
            json_values_append_text(output, "\n")
            return output


    public:
        def run(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format]:
            if arguments.count != 0:
                print("usage: json_values_candidate")
                return 2i64
            output: darray[u8] = try json_values_render() else err:
                print("json value projection failed")
                return 1i64
            printr(json_values_bytes_view(output))
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format]:
    return EsJsonValuesParityCandidate::run(arguments)
