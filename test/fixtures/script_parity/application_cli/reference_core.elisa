# Independent ElisaScript translation of reference.py's bounded A05 CLI contract.

include "../../../../src/runtime/runtime.elisa"
include "../../../../src/runtime/directory_posix.elisa"
include "../../../../src/runtime/file_posix.elisa"
include "../../../../src/runtime/text_view_compat.elisa"

using EsRuntime
using EsTextViewCompat

module EsApplicationCliReferencePort:
    private:
        const module OptionField:
            WIDTH: usize = 6
            LONG: usize = 0
            SHORT: usize = 1
            KEY: usize = 2
            TAKES_VALUE: usize = 3
            NEGATIVE: usize = 4
            DESCRIPTION: usize = 5


        const enum ValueSource of u8:
            ArgumentRange
            BooleanTrue
            BooleanFalse


        struct StoredValue:
            key_index: usize
            source: ValueSource
            argument_index: usize
            value_start: usize
            value_end: usize


        def command_options(command: sview) -> darray[sview]:
            if command == "build":
                return [
                    "--jobs", "-j", "jobs", "value", "", "Worker count",
                    "--verbose", "-v", "verbose", "flag", "--no-verbose", "Show verbose output"
                ]
            return ["--verbose", "-v", "verbose", "flag", "--no-verbose", "Show verbose output"]


        def option_field(options: darray[sview], index: usize, field: usize) -> sview:
            return options[index * OptionField::WIDTH + field]


        def fixture_names() -> darray[sview]:
            return [
                "attached-and-passthrough", "separated-short-value", "equals-short-value", "short-option-bundle",
                "negative-boolean", "root-help", "command-help", "empty-value-over-default", "build-defaults",
                "test-defaults", "missing-command", "unknown-command", "unknown-option", "missing-value",
                "duplicate-option", "duplicate-short-bundle", "unexpected-boolean-value"
            ]


        def fixture_arguments(index: usize) -> darray[sview]:
            return ["build", "-j8", "-v", "src", "--", "--literal", ""] if index == 0
            return ["build", "-j", "9"] if index == 1
            return ["build", "-j=4"] if index == 2
            return ["build", "-vj8", "target"] if index == 3
            return ["test", "--no-verbose", "suite"] if index == 4
            return ["--help"] if index == 5
            return ["build", "--help"] if index == 6
            return ["build", "--jobs="] if index == 7
            return ["build"] if index == 8
            return ["test"] if index == 9
            return [] if index == 10
            return ["clean"] if index == 11
            return ["build", "--wat"] if index == 12
            return ["build", "--jobs", "--"] if index == 13
            return ["build", "--jobs=4", "-j8"] if index == 14
            return ["build", "-vv"] if index == 15
            return ["test", "--verbose=true"]


        def append_text(output: mutable darray[u8]&, text: sview) can[Memory.Allocate, Abort.Panic]:
            for byte in text |output|:
                output.push(byte)


        def append_bytes(output: mutable darray[u8]&, bytes: darray[u8]) can[Memory.Allocate, Abort.Panic]:
            for byte in bytes |output|:
                output.push(byte)


        def write_bytes(descriptor: int, bytes: darray[u8]) -> bool can[Blocking.IO, Unsafe.PointerCast]:
            offset: mutable usize = 0
            retries: mutable usize = 0
            while offset < bytes.count:
                remaining: usize = bytes.count - offset
                buffer: mutable u8& = (&bytes[offset]).cast[mutable u8&]
                amount: isize = elisascript_posix_write(descriptor, buffer.cast[mutable void&], remaining)
                if amount == -1:
                    native_error: mutable i32& = elisascript_posix_errno()
                    if native_error[0] == EsRuntime::DarwinErrno::EINTR and retries < 8:
                        retries <- retries + 1
                        continue
                    return false
                if amount <= 0 or amount.usize() > remaining:
                    return false
                offset <- offset + amount.usize()
                retries <- 0
            return true


        def option_index(options: darray[sview], name: sview) -> i64:
            option_count: usize = options.count / OptionField::WIDTH
            for index in 0..<option_count |options, name|:
                if name == option_field(options, index, OptionField::LONG) or name == option_field(options, index, OptionField::SHORT):
                    return index.i64()
                negative_name: sview = option_field(options, index, OptionField::NEGATIVE)
                if negative_name != "" and name == negative_name:
                    return -(index.i64() + 2)
            return -1i64


        def short_option_index(options: darray[sview], name: u8) -> usize:
            option_count: usize = options.count / OptionField::WIDTH
            for index in 0..<option_count |options, name|:
                short_name: sview = option_field(options, index, OptionField::SHORT)
                return index if short_name != "" and EsTextViewCompat::byte_at(short_name, 1) == name
            return option_count


        def has_value(values: mutable darray[StoredValue]&, key_index: usize) -> bool:
            for value in values |key_index|:
                return true if value.key_index == key_index
            return false


        def add_value(values: mutable darray[StoredValue]&, key_index: usize, source: ValueSource, argument_index: usize, value_start: usize, value_end: usize) can[Memory.Allocate, Abort.Panic]:
            values.push(StoredValue{key_index: key_index, source: source, argument_index: argument_index, value_start: value_start, value_end: value_end})


        def parse_command(command: sview, arguments: darray[sview], first_argument: usize, values: mutable darray[StoredValue]&, positionals: mutable darray[usize]&) -> sview can[Memory.Allocate, Abort.Panic]:
            options: darray[sview] = command_options(command)
            options_enabled: mutable bool = true
            index: mutable usize = first_argument
            while index < arguments.count |options, values, positionals, options_enabled, index|:
                argument: sview = arguments[index]
                argument_length: usize = EsTextViewCompat::length(argument, 65536)
                if options_enabled and (argument == "--help" or argument == "-h"):
                    return "help"
                if options_enabled and argument == "--":
                    options_enabled <- false
                    index <- index + 1
                    continue
                if options_enabled and argument_length > 2 and EsTextViewCompat::byte_at(argument, 0) == 45u8 and EsTextViewCompat::byte_at(argument, 1) != 45u8:
                    short_offset: mutable usize = 1
                    while short_offset < argument_length |options, values, index, argument, short_offset, argument_length|:
                        matched_short: usize = short_option_index(options, EsTextViewCompat::byte_at(argument, short_offset))
                        if matched_short == options.count / OptionField::WIDTH:
                            return "unknown-option"
                        takes_value: bool = option_field(options, matched_short, OptionField::TAKES_VALUE) == "value"
                        if takes_value:
                            value_start: mutable usize = short_offset + 1
                            if value_start < argument_length and EsTextViewCompat::byte_at(argument, value_start) == 61u8:
                                value_start <- value_start + 1
                            value_argument_index: mutable usize = index
                            value_end: mutable usize = argument_length
                            if value_start >= argument_length:
                                if index + 1 >= arguments.count or arguments[index + 1] == "--":
                                    return "missing-value"
                                index <- index + 1
                                value_argument_index <- index
                                value_start <- 0
                                value_end <- EsTextViewCompat::length(arguments[index], 65536)
                            if has_value(values, matched_short):
                                return "duplicate-option"
                            add_value(values, matched_short, ValueSource.ArgumentRange, value_argument_index, value_start, value_end)
                            short_offset <- argument_length
                        else:
                            if short_offset + 1 < argument_length and EsTextViewCompat::byte_at(argument, short_offset + 1) == 61u8:
                                return "unexpected-value"
                            if has_value(values, matched_short):
                                return "duplicate-option"
                            add_value(values, matched_short, ValueSource.BooleanTrue, 0, 0, 0)
                            short_offset <- short_offset + 1
                    index <- index + 1
                    continue
                if options_enabled and argument_length > 1 and EsTextViewCompat::byte_at(argument, 0) == 45u8:
                    option_end: mutable usize = argument_length
                    for offset in 0..<argument_length |argument, option_end|:
                        if EsTextViewCompat::byte_at(argument, offset) == 61u8:
                            option_end <- offset
                            break
                    inline_separator: bool = option_end < argument_length
                    option_name: sview = argument[0:option_end]
                    matched: i64 = option_index(options, option_name)
                    if matched == -1i64:
                        return "unknown-option"
                    negative: bool = matched < -1i64
                    matched_index: usize = (-matched - 2).usize() if negative else matched.usize()
                    takes_value: bool = option_field(options, matched_index, OptionField::TAKES_VALUE) == "value"
                    inline_value: bool = inline_separator or option_end < argument_length
                    if takes_value:
                        if negative:
                            return "invalid-schema"
                        value_argument_index: mutable usize = index
                        value_start: mutable usize = argument_length
                        value_end: mutable usize = argument_length
                        if inline_value:
                            value_start <- option_end + 1 if inline_separator else option_end
                        else:
                            if index + 1 >= arguments.count or arguments[index + 1] == "--":
                                return "missing-value"
                            index <- index + 1
                            value_argument_index <- index
                            value_start <- 0
                            value_end <- EsTextViewCompat::length(arguments[index], 65536)
                        if has_value(values, matched_index):
                            return "duplicate-option"
                        add_value(values, matched_index, ValueSource.ArgumentRange, value_argument_index, value_start, value_end)
                    else:
                        if inline_value:
                            return "unexpected-value"
                        if has_value(values, matched_index):
                            return "duplicate-option"
                        boolean_source: ValueSource = ValueSource.BooleanFalse if negative else ValueSource.BooleanTrue
                        add_value(values, matched_index, boolean_source, 0, 0, 0)
                    index <- index + 1
                    continue
                positionals.push(index)
                index <- index + 1
            return "ok"


        def parse(arguments: darray[sview], command: mutable sview&, values: mutable darray[StoredValue]&, positionals: mutable darray[usize]&) -> sview can[Memory.Allocate, Abort.Panic]:
            command <- ""
            if arguments.count == 0:
                return "missing-command"
            if arguments[0] == "-h" or arguments[0] == "--help":
                return "root-help"
            selected_command: sview = arguments[0]
            command <- selected_command
            if selected_command != "build" and selected_command != "test":
                command <- ""
                return "unknown-command"
            return parse_command(selected_command, arguments, 1, values, positionals)


        def append_root_help(output: mutable darray[u8]&) can[Memory.Allocate, Abort.Panic]:
            append_text(output, "Usage: app <COMMAND> [OPTIONS] [ARGS...]\n\nCommands:\n  build\tBuild artifacts\n  test\tRun tests\n\nOptions:\n  -h, --help\tShow this help\n")


        def append_command_help(output: mutable darray[u8]&, command: sview) can[Memory.Allocate, Abort.Panic]:
            options: darray[sview] = command_options(command)
            append_text(output, "Usage: app ")
            append_text(output, command)
            append_text(output, " [OPTIONS] [ARGS...]\n\n")
            append_text(output, "Build artifacts\n\nOptions:\n") if command == "build"
            append_text(output, "Run tests\n\nOptions:\n") if command == "test"
            for index in 0..<options.count / OptionField::WIDTH |options, output|:
                append_text(output, "  ")
                append_text(output, option_field(options, index, OptionField::LONG))
                short_name: sview = option_field(options, index, OptionField::SHORT)
                if short_name != "":
                    append_text(output, ", ")
                    append_text(output, short_name)
                if option_field(options, index, OptionField::TAKES_VALUE) == "value":
                    append_text(output, " <VALUE>")
                negative_name: sview = option_field(options, index, OptionField::NEGATIVE)
                if negative_name != "":
                    append_text(output, ", ")
                    append_text(output, negative_name)
                append_text(output, "\t")
                append_text(output, option_field(options, index, OptionField::DESCRIPTION))
                append_text(output, "\n")
            append_text(output, "  -h, --help\tShow this help\n")


        def value_or(arguments: darray[sview], command: sview, values: darray[StoredValue], key: sview, default_value: sview) -> sview:
            options: darray[sview] = command_options(command)
            for value in values |arguments, options, key|:
                continue if option_field(options, value.key_index, OptionField::KEY) != key
                return "true" if value.source == ValueSource.BooleanTrue
                return "false" if value.source == ValueSource.BooleanFalse
                argument: sview = arguments[value.argument_index]
                return argument[value.value_start:value.value_end]
            return default_value


        def evaluate(arguments: darray[sview], stdout: mutable darray[u8]&, stderr: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            command: mutable sview = ""
            values: mutable darray[StoredValue] = []
            positionals: mutable darray[usize] = []
            state: sview = parse(arguments, command, values, positionals)
            if state == "root-help":
                append_root_help(stdout)
                return 0i64
            if state == "help":
                append_command_help(stdout, command)
                return 0i64
            if state != "ok":
                append_text(stderr, "error=")
                append_text(stderr, state)
                append_text(stderr, "\n")
                return 2i64
            append_text(stdout, "command=")
            append_text(stdout, command)
            append_text(stdout, "\n")
            if command == "build":
                append_text(stdout, "jobs=")
                append_text(stdout, value_or(arguments, command, values, "jobs", "2"))
                append_text(stdout, "\n")
            append_text(stdout, "verbose=")
            append_text(stdout, value_or(arguments, command, values, "verbose", "false"))
            append_text(stdout, "\n")
            for positional in positionals:
                append_text(stdout, "positional=")
                append_text(stdout, arguments[positional])
                append_text(stdout, "\n")
            return 0i64


        def append_case(output: mutable darray[u8]&, name: sview, arguments: darray[sview]) -> void can[Memory.Allocate, Abort.Panic]:
            stdout: mutable darray[u8] = []
            stderr: mutable darray[u8] = []
            status: i64 = evaluate(arguments, stdout, stderr)
            status_text: sview = "0" if status == 0i64 else "2"
            append_text(output, "case=")
            append_text(output, name)
            append_text(output, "\nstatus=")
            append_text(output, status_text)
            append_text(output, "\nstdout-begin\n")
            append_bytes(output, stdout)
            append_text(output, "stdout-end\nstderr-begin\n")
            append_bytes(output, stderr)
            append_text(output, "stderr-end\n")


        def render_batch() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            output: mutable darray[u8] = []
            names: darray[sview] = fixture_names()
            for index in 0..<names.count |output, names|:
                append_case(output, names[index], fixture_arguments(index))
            return output


    public:
        def batch_output() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return render_batch()


        def run(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            if arguments.count == 1 and arguments[0] == "--parity-batch":
                batch: darray[u8] = render_batch()
                return 1i64 if not write_bytes(1, batch)
                return 0i64
            stdout: mutable darray[u8] = []
            stderr: mutable darray[u8] = []
            status: i64 = evaluate(arguments, stdout, stderr)
            if stdout.count != 0:
                return 1i64 if not write_bytes(1, stdout)
            if stderr.count != 0:
                return 1i64 if not write_bytes(2, stderr)
            return status
