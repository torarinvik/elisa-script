# Independent ElisaScript translation of reference.py's bounded A05 CLI contract.

const OPTION_FIELD_WIDTH: usize = 6
const OPTION_LONG: usize = 0
const OPTION_SHORT: usize = 1
const OPTION_KEY: usize = 2
const OPTION_TAKES_VALUE: usize = 3
const OPTION_NEGATIVE: usize = 4
const OPTION_DESCRIPTION: usize = 5


def command_options(command: sview) -> darray[sview]:
    if command == "build":
        return [
            "--jobs", "-j", "jobs", "value", "", "Worker count",
            "--verbose", "-v", "verbose", "flag", "--no-verbose", "Show verbose output"
        ]
    return ["--verbose", "-v", "verbose", "flag", "--no-verbose", "Show verbose output"]


def option_field(options: darray[sview], index: usize, field: usize) -> sview:
    return options[index * OPTION_FIELD_WIDTH + field]


def fixture_names() -> darray[sview]:
    return [
        "attached-and-passthrough",
        "separated-short-value",
        "equals-short-value",
        "short-option-bundle",
        "negative-boolean",
        "root-help",
        "command-help",
        "empty-value-over-default",
        "build-defaults",
        "test-defaults",
        "missing-command",
        "unknown-command",
        "unknown-option",
        "missing-value",
        "duplicate-option",
        "duplicate-short-bundle",
        "unexpected-boolean-value"
    ]


def fixture_arguments(index: usize) -> darray[sview]:
    return ["build", "-j8", "-v", "src", "--", "--literal", ""] if index == 0
    return ["build", "-j", "9"] if index == 1
    return ["build", "-j=4"] if index == 2
    return ["build", "-vj8", "target"] if index == 3
    return ["test", "--no-verbose", "suite"] if index == 4
    return ["--help"] if index == 5
    return ["build", "--help"] if index == 6
    return ["build", "--jobs="] if index == 7
    return ["build"] if index == 8
    return ["test"] if index == 9
    return [] if index == 10
    return ["clean"] if index == 11
    return ["build", "--wat"] if index == 12
    return ["build", "--jobs", "--"] if index == 13
    return ["build", "--jobs=4", "-j8"] if index == 14
    return ["build", "-vv"] if index == 15
    return ["test", "--verbose=true"]


def append_text(output: mutable darray[u8]&, text: sview) can[Memory.Allocate, Abort.Panic]:
    for byte in text |output|:
        output.push(byte)


def append_bytes(output: mutable darray[u8]&, bytes: darray[u8]) can[Memory.Allocate, Abort.Panic]:
    for byte in bytes |output|:
        output.push(byte)


def byte_view(bytes: darray[u8]) -> sview:
    return bytes_view(bytes)


def option_index(options: darray[sview], name: sview) -> i64:
    option_count: usize = options.count / OPTION_FIELD_WIDTH
    for index in 0..<option_count |options, name|:
        if name == option_field(options, index, OPTION_LONG) or name == option_field(options, index, OPTION_SHORT):
            return index.i64()
        negative_name: sview = option_field(options, index, OPTION_NEGATIVE)
        if negative_name != "" and name == negative_name:
            return -(index.i64() + 2)
    return -1i64


def short_option_index(options: darray[sview], name: u8) -> usize:
    option_count: usize = options.count / OPTION_FIELD_WIDTH
    for index in 0..<option_count |options, name|:
        short_name: sview = option_field(options, index, OPTION_SHORT)
        return index if short_name != "" and sview_at(short_name, 1) == name
    return option_count


def has_value(values: darray[sview], key: sview) -> bool:
    for index in 0..<values.count / 2 |values, key|:
        return true if values[index * 2] == key
    return false


def add_value(values: mutable darray[sview]&, key: sview, value: sview) can[Memory.Allocate, Abort.Panic]:
    values.push(key)
    values.push(value)


def parse_command(command: sview, arguments: darray[sview], values: mutable darray[sview]&, positionals: mutable darray[sview]&) -> sview can[Memory.Allocate, Abort.Panic]:
    options: darray[sview] = command_options(command)
    options_enabled: mutable bool = true
    index: mutable usize = 0
    while index < arguments.count |options, values, positionals, options_enabled, index|:
        argument: sview = arguments[index]
        argument_length: usize = len(argument)
        if options_enabled and (argument == "--help" or argument == "-h"):
            return "help"
        if options_enabled and argument == "--":
            options_enabled <- false
            index <- index + 1
            continue
        if options_enabled and argument_length > 2 and sview_at(argument, 0) == 45u8 and sview_at(argument, 1) != 45u8:
            short_offset: mutable usize = 1
            while short_offset < argument_length |options, values, index, argument, short_offset, argument_length|:
                matched_short: usize = short_option_index(options, sview_at(argument, short_offset))
                if matched_short == options.count / OPTION_FIELD_WIDTH:
                    return "unknown-option"
                option_key: sview = option_field(options, matched_short, OPTION_KEY)
                takes_value: bool = option_field(options, matched_short, OPTION_TAKES_VALUE) == "value"
                if takes_value:
                    value_start: mutable usize = short_offset + 1
                    if value_start < argument_length and sview_at(argument, value_start) == 61u8:
                        value_start <- value_start + 1
                    value: mutable sview = ""
                    if value_start < argument_length:
                        value <- argument[value_start:argument_length]
                    else:
                        if index + 1 >= arguments.count or arguments[index + 1] == "--":
                            return "missing-value"
                        index <- index + 1
                        value <- arguments[index]
                    if has_value(values, option_key):
                        return "duplicate-option"
                    add_value(values, option_key, value)
                    short_offset <- argument_length
                else:
                    if short_offset + 1 < argument_length and sview_at(argument, short_offset + 1) == 61u8:
                        return "unexpected-value"
                    if has_value(values, option_key):
                        return "duplicate-option"
                    add_value(values, option_key, "true")
                    short_offset <- short_offset + 1
            index <- index + 1
            continue
        if options_enabled and argument_length > 1 and sview_at(argument, 0) == 45u8:
            separator: i64 = argument.index("=")
            inline_separator: bool = separator >= 0
            option_end: usize = argument_length if not inline_separator else separator.usize()
            option_name: sview = argument[0:option_end]
            matched: i64 = option_index(options, option_name)
            if matched == -1i64:
                return "unknown-option"
            negative: bool = matched < -1i64
            matched_index: usize = (-matched - 2).usize() if negative else matched.usize()
            option_key: sview = option_field(options, matched_index, OPTION_KEY)
            takes_value: bool = option_field(options, matched_index, OPTION_TAKES_VALUE) == "value"
            inline_value: bool = inline_separator or option_end < argument_length
            if takes_value:
                if negative:
                    return "invalid-schema"
                value: mutable sview = ""
                if inline_value:
                    value_start: usize = option_end + 1 if inline_separator else option_end
                    value <- argument[value_start:argument_length]
                else:
                    if index + 1 >= arguments.count or arguments[index + 1] == "--":
                        return "missing-value"
                    index <- index + 1
                    value <- arguments[index]
                if has_value(values, option_key):
                    return "duplicate-option"
                add_value(values, option_key, value)
            else:
                if inline_value:
                    return "unexpected-value"
                if has_value(values, option_key):
                    return "duplicate-option"
                boolean_value: sview = "false" if negative else "true"
                add_value(values, option_key, boolean_value)
            index <- index + 1
            continue
        positionals.push(argument)
        index <- index + 1
    return "ok"


def parse(arguments: darray[sview], command: mutable sview&, values: mutable darray[sview]&, positionals: mutable darray[sview]&) -> sview can[Memory.Allocate, Abort.Panic]:
    command <- ""
    if arguments.count == 0:
        return "missing-command"
    if arguments[0] == "-h" or arguments[0] == "--help":
        return "root-help"
    command <- arguments[0]
    if command != "build" and command != "test":
        command <- ""
        return "unknown-command"
    remaining: mutable darray[sview] = []
    for index in 1..<arguments.count |arguments, remaining|:
        remaining.push(arguments[index])
    return parse_command(command, remaining, values, positionals)


def append_root_help(output: mutable darray[u8]&) can[Memory.Allocate, Abort.Panic]:
    append_text(output, "Usage: app <COMMAND> [OPTIONS] [ARGS...]\n\nCommands:\n  build\tBuild artifacts\n  test\tRun tests\n\nOptions:\n  -h, --help\tShow this help\n")


def append_command_help(output: mutable darray[u8]&, command: sview) can[Memory.Allocate, Abort.Panic]:
    options: darray[sview] = command_options(command)
    append_text(output, "Usage: app ")
    append_text(output, command)
    append_text(output, " [OPTIONS] [ARGS...]\n\n")
    append_text(output, "Build artifacts\n\nOptions:\n") if command == "build"
    append_text(output, "Run tests\n\nOptions:\n") if command == "test"
    for index in 0..<options.count / OPTION_FIELD_WIDTH |options, output|:
        append_text(output, "  ")
        append_text(output, option_field(options, index, OPTION_LONG))
        short_name: sview = option_field(options, index, OPTION_SHORT)
        if short_name != "":
            append_text(output, ", ")
            append_text(output, short_name)
        if option_field(options, index, OPTION_TAKES_VALUE) == "value":
            append_text(output, " <VALUE>")
        negative_name: sview = option_field(options, index, OPTION_NEGATIVE)
        if negative_name != "":
            append_text(output, ", ")
            append_text(output, negative_name)
        append_text(output, "\t")
        append_text(output, option_field(options, index, OPTION_DESCRIPTION))
        append_text(output, "\n")
    append_text(output, "  -h, --help\tShow this help\n")


def value_or(values: darray[sview], key: sview, default_value: sview) -> sview:
    for index in 0..<values.count / 2 |values, key|:
        return values[index * 2 + 1] if values[index * 2] == key
    return default_value


def evaluate(arguments: darray[sview], stdout: mutable darray[u8]&, stderr: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    command: mutable sview = ""
    values: mutable darray[sview] = []
    positionals: mutable darray[sview] = []
    state: sview = parse(arguments, command, values, positionals)
    if state == "root-help":
        append_root_help(stdout)
        return 0i64
    if state == "help":
        append_command_help(stdout, command)
        return 0i64
    if state != "ok":
        append_text(stderr, "error=")
        append_text(stderr, state)
        append_text(stderr, "\n")
        return 2i64
    append_text(stdout, "command=")
    append_text(stdout, command)
    append_text(stdout, "\n")
    if command == "build":
        append_text(stdout, "jobs=")
        append_text(stdout, value_or(values, "jobs", "2"))
        append_text(stdout, "\n")
    append_text(stdout, "verbose=")
    append_text(stdout, value_or(values, "verbose", "false"))
    append_text(stdout, "\n")
    for positional in positionals:
        append_text(stdout, "positional=")
        append_text(stdout, positional)
        append_text(stdout, "\n")
    return 0i64


def append_case(output: mutable darray[u8]&, name: sview, arguments: darray[sview]) -> void can[Memory.Allocate, Abort.Panic]:
    stdout: mutable darray[u8] = []
    stderr: mutable darray[u8] = []
    status: i64 = evaluate(arguments, stdout, stderr)
    status_text: sview = "0" if status == 0i64 else "2"
    append_text(output, "case=")
    append_text(output, name)
    append_text(output, "\nstatus=")
    append_text(output, status_text)
    append_text(output, "\nstdout-begin\n")
    append_bytes(output, stdout)
    append_text(output, "stdout-end\nstderr-begin\n")
    append_bytes(output, stderr)
    append_text(output, "stderr-end\n")


def render_batch() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    output: mutable darray[u8] = []
    names: darray[sview] = fixture_names()
    for index in 0..<names.count |output, names|:
        append_case(output, names[index], fixture_arguments(index))
    return output


def batch_output() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    return render_batch()


def run(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write]:
    if arguments.count == 1 and arguments[0] == "--parity-batch":
        batch: darray[u8] = render_batch()
        _ = write_stdout(byte_view(batch))
        return 0i64
    stdout: mutable darray[u8] = []
    stderr: mutable darray[u8] = []
    status: i64 = evaluate(arguments, stdout, stderr)
    if stdout.count != 0:
        _ = write_stdout(byte_view(stdout))
    if stderr.count != 0:
        _ = write_stderr(byte_view(stderr))
    return status


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write]:
    return run(arguments)
