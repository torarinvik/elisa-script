using EsBuild
using EsBuildExecutor
using EsBuildUsage
using EsBuildUsageArgv
using EsBuildUsageGraph
using EsBuildCompilationDatabase
using EsFileAtomic
using EsFileAtomicPosix
using EsFileLock
using EsFileLockPosix
using EsProcess
using EsRuntime


module EsTargetUsageBuild:
    private:
        const module Toolchain:
            C_COMPILER: sview = "/usr/bin/cc"
            ARCHIVER: sview = "/usr/bin/ar"
            TARGET: sview = "usage-app"
            HELPER_LIBRARY: sview = "libusage_helper.a"
            CORE_LIBRARY: sview = "libusage_core.a"
            COMPILATION_DATABASE: sview = "compile_commands.json"
            COMPILATION_DATABASE_LEAF: cstr = "compile_commands.json"
            COMPILATION_DATABASE_STAGE: sview = ".compile_commands.json.stage"
            COMPILATION_DATABASE_STAGE_LEAF: cstr = ".compile_commands.json.stage"
            COMPILATION_DATABASE_LOCK_LEAF: cstr = ".compile_commands.json.lock"
            COMPILATION_DATABASE_OWNER: u64 = 1u64
            COMPILATION_DATABASE_LIMIT: usize = 67108864
            TIMEOUT_MICROS: u64 = 60000000u64
            OUTPUT_LIMIT_BYTES: usize = 262144


        const enum AtomicPublicationPhase of u8:
            Publish
            Done


        def path_is_within(root: sview, candidate: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if root == candidate
            prefix: sview = if root == "/": "/" else: root + "/"
            return candidate.startswith(prefix)


        const module CommandPolicy:
            INCLUDE_PREFIX: sview = "-I"
            DEFINITION_PREFIX: sview = "-D"
            LIBRARY_PREFIX: sview = "-l"


        def prepare_command(executable: sview, arguments: BuildUsageArgv, working_directory_text: sview) -> BuildUsageProcessCommand error[BuildUsageArgvError, ProcessCommandError] can[Memory.Allocate, Abort.Panic]:
            return try build_usage_process_command(
                executable,
                arguments,
                working_directory_text,
                ["PATH", "/usr/bin:/bin", "LC_ALL", "C"],
                ProcessEnvironmentMode.Replace,
                Toolchain::TIMEOUT_MICROS,
                Toolchain::OUTPUT_LIMIT_BYTES
            )


        def prepare_compiler_command(executable: sview, arguments: BuildUsageArgv, working_directory_text: sview) -> BuildUsageProcessCommand error[BuildUsageArgvError, ProcessCommandError] can[Memory.Allocate, Abort.Panic]:
            return try build_usage_process_command(
                executable,
                arguments,
                working_directory_text,
                [],
                ProcessEnvironmentMode.Inherit,
                Toolchain::TIMEOUT_MICROS,
                Toolchain::OUTPUT_LIMIT_BYTES
            )


        def compiler_command(source_text: sview, object_text: sview, working_directory_text: sview, usage: BuildUsageTargetResult) -> BuildUsageProcessCommand error[BuildUsageArgvError, ProcessCommandError] can[Memory.Allocate, Abort.Panic]:
            argv: BuildUsageArgv = try build_usage_compile_argv(
                usage,
                ["-std=c11", "-pedantic", "-Wall", "-Wextra", "-Werror"],
                ["-c", source_text, "-o", object_text],
                BuildUsageArgSyntax{include_prefix: CommandPolicy::INCLUDE_PREFIX, definition_prefix: CommandPolicy::DEFINITION_PREFIX, library_prefix: CommandPolicy::LIBRARY_PREFIX}
            )
            return try prepare_compiler_command(Toolchain::C_COMPILER, argv, working_directory_text)


        def archive_command(library_text: sview, object_text: sview, working_directory_text: sview) -> BuildUsageProcessCommand error[BuildUsageArgvError, ProcessCommandError] can[Memory.Allocate, Abort.Panic]:
            argv: BuildUsageArgv = try build_usage_raw_argv(["rcs", library_text, object_text])
            return try prepare_command(Toolchain::ARCHIVER, argv, working_directory_text)


        def link_command(source_object_text: sview, output_text: sview, working_directory_text: sview, core_library_text: sview, helper_library_text: sview, usage: BuildUsageTargetResult) -> BuildUsageProcessCommand error[BuildUsageArgvError, ProcessCommandError] can[Memory.Allocate, Abort.Panic]:
            artifacts: darray[BuildUsageTargetArtifact] = [
                BuildUsageTargetArtifact{target_name: "core", path: core_library_text},
                BuildUsageTargetArtifact{target_name: "helper", path: helper_library_text}
            ]
            argv: BuildUsageArgv = try build_usage_link_argv(
                usage,
                ["-std=c11", "-pedantic", "-Wall", "-Wextra", "-Werror", source_object_text, "-o", output_text],
                artifacts,
                BuildUsageArgSyntax{include_prefix: CommandPolicy::INCLUDE_PREFIX, definition_prefix: CommandPolicy::DEFINITION_PREFIX, library_prefix: CommandPolicy::LIBRARY_PREFIX}
            )
            return try prepare_command(Toolchain::C_COMPILER, argv, working_directory_text)


        def run_command(executable_text: sview, working_directory_text: sview) -> BuildUsageProcessCommand error[BuildUsageArgvError, ProcessCommandError] can[Memory.Allocate, Abort.Panic]:
            argv: BuildUsageArgv = try build_usage_raw_argv([])
            return try prepare_command(executable_text, argv, working_directory_text)


        def open_directory_capability(path_text: sview) -> int can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if path_text == ""
            bytes: darray[u8] = []
            for byte in path_text |bytes|:
                bytes.push(byte)
            bytes.push(0u8)
            return elisascript_posix_open((&bytes[0]).cast[cstr], DarwinOpenFlags::RDONLY | DarwinOpenFlags::DIRECTORY | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC, 0u32)


        def cleanup_compilation_database_atomic_stage(a: mutable Arena&, session: mutable AtomicFileSession&, parent_fd: int, stage_handle: mutable AtomicFilePosixStageHandle&, lease: FileLockPosixLease&) -> bool can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            if session.state == AtomicFileState.Planned or session.state == AtomicFileState.Failed or session.state == AtomicFileState.Cancelled or session.state == AtomicFileState.Unchanged:
                return true

            if session.state == AtomicFileState.Staging or session.state == AtomicFileState.Ready:
                catch advance_atomic_file(session, AtomicFileEvent.Fail):
                    ok state:
                        _ = state
                    error failure:
                        return false

            if session.state == AtomicFileState.PublishedUncertain or session.state == AtomicFileState.Committed or session.state == AtomicFileState.Restoring or session.state == AtomicFileState.RolledBack or session.state == AtomicFileState.RolledBackPendingCleanup:
                return false

            if session.staged_identity.observed:
                catch cleanup_atomic_file_stage(a, session, parent_fd, Toolchain::COMPILATION_DATABASE_STAGE_LEAF, stage_handle.proof, lease, Toolchain::COMPILATION_DATABASE_LOCK_LEAF):
                    ok state:
                        return state == AtomicFileState.Failed or state == AtomicFileState.Cancelled or state == AtomicFileState.Unchanged
                    error failure:
                        return false

            catch cleanup_unsealed_atomic_file_stage(session, parent_fd, stage_handle, Toolchain::COMPILATION_DATABASE_STAGE_LEAF, lease, Toolchain::COMPILATION_DATABASE_LOCK_LEAF):
                ok state:
                    return state == AtomicFileState.Failed or state == AtomicFileState.Cancelled
                error failure:
                    return false


        def publish_compilation_database(build_directory: Path, contents: darray[u8]) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Unsafe.PointerCast]:
            directory_text: sview = f"{build_directory}"
            parent_fd: int = open_directory_capability(directory_text)
            if parent_fd < 0:
                print("target usage build: unable to open build directory capability")
                return false

            lease: mutable FileLockPosixLease = FileLockPosixLease{}
            lock_acquired: mutable bool = false
            catch acquire_file_lock_at(lease, parent_fd, Toolchain::COMPILATION_DATABASE_LOCK_LEAF, Toolchain::COMPILATION_DATABASE_OWNER, FileLockMode.Exclusive):
                ok acquired:
                    lock_acquired <- acquired
                error failure:
                    _ = failure

            if not lock_acquired:
                _ = elisascript_posix_close(parent_fd)
                print("target usage build: unable to acquire compilation database publication lease")
                return false

            arena: mutable Arena = zeroed
            destination_before: mutable AtomicFilePosixObservation = AtomicFilePosixObservation{parent_device: 0, parent_inode: 0, parent_descriptor_token: 0, destination: AtomicFileIdentity{}, link_count: 0, private_mode: false}
            destination_observed: mutable bool = false
            catch observe_atomic_file_at(arena, parent_fd, Toolchain::COMPILATION_DATABASE_LEAF, Toolchain::COMPILATION_DATABASE_LIMIT):
                ok observed:
                    destination_before <- observed
                    destination_observed <- true
                error failure:
                    _ = failure

            if not destination_observed or destination_before.destination.present or contents.count == 0 or contents.count > Toolchain::COMPILATION_DATABASE_LIMIT:
                released: bool = try release_file_lock_at(lease, parent_fd, Toolchain::COMPILATION_DATABASE_LOCK_LEAF, Toolchain::COMPILATION_DATABASE_OWNER, FileLockMode.Exclusive) else false
                _ = elisascript_posix_close(parent_fd)
                arena_free(arena)
                print("target usage build: refusing invalid or pre-existing compilation database destination") if destination_observed
                print("target usage build: unable to inspect compilation database destination") if not destination_observed
                _ = released
                return false

            plan: AtomicFilePlan = AtomicFilePlan{
                destination_path: Toolchain::COMPILATION_DATABASE,
                staging_path: Toolchain::COMPILATION_DATABASE_STAGE,
                owner_token: Toolchain::COMPILATION_DATABASE_OWNER,
                parent_identity: parent_fd.u64() + 1u64,
                expected_destination: destination_before.destination,
                max_content_bytes: Toolchain::COMPILATION_DATABASE_LIMIT
            }
            session: mutable AtomicFileSession = AtomicFileSession{plan: plan}
            stage_handle: mutable AtomicFilePosixStageHandle = AtomicFilePosixStageHandle{
                descriptor: -1,
                proof: AtomicFilePosixStageProof{parent_device: 0, parent_inode: 0, parent_descriptor_token: 0, stage_device: 0, stage_inode: 0, stage_descriptor_token: 0, owner_token: 0, link_count: 0}
            }
            stage_created: mutable bool = false
            publication_ok: mutable bool = false
            publication_uncertain: mutable bool = false

            catch create_atomic_file_stage(session, parent_fd, Toolchain::COMPILATION_DATABASE_STAGE_LEAF, lease, Toolchain::COMPILATION_DATABASE_LOCK_LEAF):
                ok created:
                    stage_handle <- created
                    stage_created <- true
                error failure:
                    _ = failure

            if stage_created:
                appended: mutable bool = false
                catch append_atomic_file_stage(session, parent_fd, stage_handle, Toolchain::COMPILATION_DATABASE_STAGE_LEAF, contents, lease, Toolchain::COMPILATION_DATABASE_LOCK_LEAF):
                    ok byte_count:
                        appended <- byte_count == contents.count
                    error failure:
                        _ = failure

                if appended:
                    sealed: mutable bool = false
                    catch seal_atomic_file_stage(arena, session, parent_fd, stage_handle, Toolchain::COMPILATION_DATABASE_STAGE_LEAF, lease, Toolchain::COMPILATION_DATABASE_LOCK_LEAF):
                        ok identity:
                            sealed <- identity.present and identity.size == contents.count
                        error failure:
                            _ = failure

                    if sealed:
                        compared: mutable bool = false
                        catch compare_atomic_file_stage(arena, session, parent_fd, Toolchain::COMPILATION_DATABASE_STAGE_LEAF, Toolchain::COMPILATION_DATABASE_LEAF, contents, lease, Toolchain::COMPILATION_DATABASE_LOCK_LEAF):
                            ok identity:
                                compared <- identity.observed
                            error failure:
                                _ = failure

                        if compared and session.state == AtomicFileState.UnchangedPendingCleanup:
                            catch cleanup_atomic_file_stage(arena, session, parent_fd, Toolchain::COMPILATION_DATABASE_STAGE_LEAF, stage_handle.proof, lease, Toolchain::COMPILATION_DATABASE_LOCK_LEAF):
                                ok state:
                                    publication_ok <- state == AtomicFileState.Unchanged
                                error failure:
                                    _ = failure
                        elif compared and session.state == AtomicFileState.Ready:
                            attempts: mutable usize = 0
                            phase: mutable AtomicPublicationPhase = AtomicPublicationPhase.Publish
                            machine over phase while phase != AtomicPublicationPhase.Done:
                                state Publish
                                start Publish

                                Publish, AtomicPublicationPhase.Publish if attempts >= 2 or publication_ok or publication_uncertain:
                                    phase <- AtomicPublicationPhase.Done
                                    -> Publish

                                Publish, AtomicPublicationPhase.Publish if session.state == AtomicFileState.Committed:
                                    publication_ok <- true
                                    phase <- AtomicPublicationPhase.Done
                                    -> Publish

                                Publish, AtomicPublicationPhase.Publish:
                                    attempts <- attempts + 1
                                    catch commit_atomic_file_stage(arena, session, parent_fd, Toolchain::COMPILATION_DATABASE_STAGE_LEAF, Toolchain::COMPILATION_DATABASE_LEAF, lease, Toolchain::COMPILATION_DATABASE_LOCK_LEAF):
                                        ok identity:
                                            _ = identity
                                        error failure:
                                            _ = failure

                                    if session.state == AtomicFileState.Committed:
                                        publication_ok <- true
                                        phase <- AtomicPublicationPhase.Done
                                    elif session.state == AtomicFileState.PublishedUncertain:
                                        catch reconcile_atomic_file_publication(arena, session, parent_fd, Toolchain::COMPILATION_DATABASE_STAGE_LEAF, Toolchain::COMPILATION_DATABASE_LEAF, lease, Toolchain::COMPILATION_DATABASE_LOCK_LEAF):
                                            ok state:
                                                _ = state
                                            error failure:
                                                _ = failure
                                                publication_uncertain <- true
                                        if session.state == AtomicFileState.Committed:
                                            publication_ok <- true
                                            phase <- AtomicPublicationPhase.Done
                                        elif session.state == AtomicFileState.Ready and attempts < 2:
                                            -> Publish
                                        elif session.state == AtomicFileState.Ready:
                                            phase <- AtomicPublicationPhase.Done
                                        else:
                                            publication_uncertain <- true
                                            phase <- AtomicPublicationPhase.Done
                                    elif session.state == AtomicFileState.Ready and attempts < 2:
                                        -> Publish
                                    elif session.state == AtomicFileState.Ready:
                                        phase <- AtomicPublicationPhase.Done
                                    else:
                                        publication_uncertain <- true
                                        phase <- AtomicPublicationPhase.Done
                                    -> Publish

                                Publish, AtomicPublicationPhase.Done:
                                    break

            if not publication_ok and not publication_uncertain:
                if not cleanup_compilation_database_atomic_stage(arena, session, parent_fd, stage_handle, lease):
                    print("target usage build: unable to safely clean compilation database stage")

            lock_released: mutable bool = false
            catch release_file_lock_at(lease, parent_fd, Toolchain::COMPILATION_DATABASE_LOCK_LEAF, Toolchain::COMPILATION_DATABASE_OWNER, FileLockMode.Exclusive):
                ok status:
                    lock_released <- status
                error failure:
                    _ = failure
            directory_closed: bool = elisascript_posix_close(parent_fd) == 0
            arena_free(arena)

            if publication_uncertain:
                print("target usage build: compilation database publication outcome remains uncertain; preserving stage")
                return false
            if not lock_released or not directory_closed:
                print("target usage build: unable to confirm compilation database publication resources were released")
                return false
            if not publication_ok:
                print("target usage build: unable to publish compilation database")
                return false
            return true


    public:
        def build(build_directory_argument: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, File.Write, Directory.Read, Process.Run, Unsafe.PointerCast]:
            build_argument: Path = path(build_directory_argument)
            if not path_is_absolute(build_argument) or is_symlink(build_argument) or not is_directory(build_argument):
                print("target usage build: require an existing absolute, non-symlink build directory")
                return 2i64

            project_directory: Path = try path_real(path_absolute(Script::source_path().parent())) else err:
                print("target usage build: missing project directory")
                return 1i64
            repository_directory: Path = project_directory.parent().parent().parent().parent()
            repository_text: sview = f"{repository_directory}"
            build_directory: Path = try path_real(path_absolute(build_argument)) else err:
                print("target usage build: unable to resolve build directory")
                return 2i64
            build_directory_text: sview = f"{build_directory}"
            if build_directory_text == "/" or path_is_within(repository_text, build_directory_text):
                print("target usage build: refusing a build directory inside the source repository")
                return 2i64
            entries: darray[sview] = try list_directory(build_directory) else err:
                print("target usage build: unable to inspect build directory")
                return 2i64
            if entries.count != 0:
                print("target usage build: require a fresh empty build directory")
                return 2i64

            api_include: Path = project_directory.joinpath("include").joinpath("api")
            core_include: Path = project_directory.joinpath("include").joinpath("core")
            internal_include: Path = project_directory.joinpath("include").joinpath("internal")
            helper_include: Path = project_directory.joinpath("include").joinpath("helper")
            api_include_text: sview = f"{api_include}"
            core_include_text: sview = f"{core_include}"
            internal_include_text: sview = f"{internal_include}"
            helper_include_text: sview = f"{helper_include}"

            api: BuildUsageTarget = BuildUsageTarget{
                name: "api",
                kind: BuildUsageTargetKind.InterfaceLibrary,
                requirements: [
                    BuildUsageRequirement{kind: BuildUsageKind.IncludeDirectory, visibility: BuildUsageVisibility.Interface, value: api_include_text},
                    BuildUsageRequirement{kind: BuildUsageKind.CompileDefinition, visibility: BuildUsageVisibility.Interface, value: "API_LEVEL=3"},
                    BuildUsageRequirement{kind: BuildUsageKind.CompileOption, visibility: BuildUsageVisibility.Interface, value: "-DAPI_OPTION=1"},
                    BuildUsageRequirement{kind: BuildUsageKind.LinkLibrary, visibility: BuildUsageVisibility.Interface, value: "m"},
                    BuildUsageRequirement{kind: BuildUsageKind.LinkOption, visibility: BuildUsageVisibility.Interface, value: "-Wl,-dead_strip"}
                ]
            }
            helper: BuildUsageTarget = BuildUsageTarget{
                name: "helper",
                kind: BuildUsageTargetKind.StaticLibrary,
                requirements: [
                    BuildUsageRequirement{kind: BuildUsageKind.IncludeDirectory, visibility: BuildUsageVisibility.Private, value: helper_include_text},
                    BuildUsageRequirement{kind: BuildUsageKind.CompileDefinition, visibility: BuildUsageVisibility.Private, value: "HELPER_PRIVATE=1"},
                    BuildUsageRequirement{kind: BuildUsageKind.CompileOption, visibility: BuildUsageVisibility.Private, value: "-DHELPER_PRIVATE_OPTION=1"}
                ]
            }
            core: BuildUsageTarget = BuildUsageTarget{
                name: "core",
                kind: BuildUsageTargetKind.StaticLibrary,
                dependencies: [
                    BuildUsageDependency{target_index: 0, visibility: BuildUsageVisibility.Public},
                    BuildUsageDependency{target_index: 1, visibility: BuildUsageVisibility.Private}
                ],
                requirements: [
                    BuildUsageRequirement{kind: BuildUsageKind.IncludeDirectory, visibility: BuildUsageVisibility.Private, value: internal_include_text},
                    BuildUsageRequirement{kind: BuildUsageKind.IncludeDirectory, visibility: BuildUsageVisibility.Public, value: core_include_text},
                    BuildUsageRequirement{kind: BuildUsageKind.CompileDefinition, visibility: BuildUsageVisibility.Private, value: "CORE_PRIVATE=1"},
                    BuildUsageRequirement{kind: BuildUsageKind.CompileDefinition, visibility: BuildUsageVisibility.Public, value: "CORE_ABI=5"},
                    BuildUsageRequirement{kind: BuildUsageKind.CompileOption, visibility: BuildUsageVisibility.Private, value: "-DCORE_PRIVATE_OPTION=1"},
                    BuildUsageRequirement{kind: BuildUsageKind.CompileOption, visibility: BuildUsageVisibility.Public, value: "-DCORE_PUBLIC_OPTION=1"}
                ]
            }
            app: BuildUsageTarget = BuildUsageTarget{
                name: "app",
                kind: BuildUsageTargetKind.Executable,
                dependencies: [BuildUsageDependency{target_index: 2, visibility: BuildUsageVisibility.Private}],
                requirements: []
            }
            resolution: BuildUsageResolution = try resolve_build_usage([api, helper, core, app]) else err:
                print("target usage build: invalid public/private dependency graph")
                return 1i64
            if resolution.targets.count != 4:
                print("target usage build: target propagation produced an invalid result count")
                return 1i64

            helper_source: Path = project_directory.joinpath("src").joinpath("helper.c")
            core_source: Path = project_directory.joinpath("src").joinpath("core.c")
            app_source: Path = project_directory.joinpath("src").joinpath("main.c")
            helper_object: Path = build_directory.joinpath("helper.o")
            core_object: Path = build_directory.joinpath("core.o")
            app_object: Path = build_directory.joinpath("app.o")
            helper_library: Path = build_directory.joinpath(Toolchain::HELPER_LIBRARY)
            core_library: Path = build_directory.joinpath(Toolchain::CORE_LIBRARY)
            executable: Path = build_directory.joinpath(Toolchain::TARGET)
            helper_object_text: sview = f"{helper_object}"
            core_object_text: sview = f"{core_object}"
            app_object_text: sview = f"{app_object}"
            helper_library_text: sview = f"{helper_library}"
            core_library_text: sview = f"{core_library}"
            executable_text: sview = f"{executable}"
            helper_source_text: sview = f"{helper_source}"
            core_source_text: sview = f"{core_source}"
            app_source_text: sview = f"{app_source}"

            helper_compile: BuildUsageProcessCommand = try compiler_command(helper_source_text, helper_object_text, build_directory_text, resolution.targets[1]) else err:
                print("target usage build: unable to construct helper compile command")
                return 1i64
            helper_archive: BuildUsageProcessCommand = try archive_command(helper_library_text, helper_object_text, build_directory_text) else err:
                print("target usage build: unable to construct helper archive command")
                return 1i64
            core_compile: BuildUsageProcessCommand = try compiler_command(core_source_text, core_object_text, build_directory_text, resolution.targets[2]) else err:
                print("target usage build: unable to construct core compile command")
                return 1i64
            core_archive: BuildUsageProcessCommand = try archive_command(core_library_text, core_object_text, build_directory_text) else err:
                print("target usage build: unable to construct core archive command")
                return 1i64
            app_compile: BuildUsageProcessCommand = try compiler_command(app_source_text, app_object_text, build_directory_text, resolution.targets[3]) else err:
                print("target usage build: unable to construct app compile command")
                return 1i64
            app_link: BuildUsageProcessCommand = try link_command(app_object_text, executable_text, build_directory_text, core_library_text, helper_library_text, resolution.targets[3]) else err:
                print("target usage build: unable to construct app link command")
                return 1i64
            run_app: BuildUsageProcessCommand = try run_command(executable_text, build_directory_text) else err:
                print("target usage build: unable to construct run command")
                return 1i64
            actions: darray[BuildUsageActionSpec] = [
                BuildUsageActionSpec{name: "compile-helper", command: helper_compile, fingerprint: 1u64, outputs: [helper_object_text]},
                BuildUsageActionSpec{name: "archive-helper", command: helper_archive, dependencies: [0], fingerprint: 2u64, outputs: [helper_library_text]},
                BuildUsageActionSpec{name: "compile-core", command: core_compile, dependencies: [1], fingerprint: 3u64, outputs: [core_object_text]},
                BuildUsageActionSpec{name: "archive-core", command: core_archive, dependencies: [2], fingerprint: 4u64, outputs: [core_library_text]},
                BuildUsageActionSpec{name: "compile-app", command: app_compile, dependencies: [3], fingerprint: 5u64, outputs: [app_object_text]},
                BuildUsageActionSpec{name: "link-app", command: app_link, dependencies: [1, 3, 4], fingerprint: 6u64, outputs: [executable_text]},
                BuildUsageActionSpec{name: "run-app", command: run_app, dependencies: [5], fingerprint: 7u64}
            ]
            plan: mutable BuildUsageGraphPlan = try build_usage_graph_plan(actions) else err:
                print("target usage build: invalid executor-ready graph plan")
                return 1i64
            compilation_sources: darray[BuildCompilationSource] = [
                BuildCompilationSource{action_index: 0, source_file: helper_source_text, output_file: helper_object_text},
                BuildCompilationSource{action_index: 2, source_file: core_source_text, output_file: core_object_text},
                BuildCompilationSource{action_index: 4, source_file: app_source_text, output_file: app_object_text}
            ]
            compilation_database: darray[u8] = try render_build_compilation_database(plan, compilation_sources) else err:
                print("target usage build: unable to render compilation database")
                return 1i64
            if not publish_compilation_database(build_directory, compilation_database):
                return 1i64
            execution: mutable BuildExecutionResult = BuildExecutionResult{}
            catch execute_build_usage_graph(plan):
                ok value:
                    execution <- value
                error failure:
                    print("target usage build: build graph execution failed")
                    return 1i64
            if execution.graph_state != BuildGraphState.Succeeded or execution.nodes.count != 7:
                return 1i64
            for node_index in 0..<7 |execution|:
                return 1i64 if not execution.nodes[node_index].started or execution.nodes[node_index].exit_status != 0 or execution.nodes[node_index].failure != BuildExecutionFailureKind.None
            if execution.nodes[6].stdout != "usage=32\n" or execution.nodes[6].stderr != "":
                print("target usage build: propagated compile/link behavior mismatch")
                return 1i64
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, File.Read, File.Write, Directory.Read, Process.Run, Unsafe.PointerCast]:
    if arguments.count != 1:
        print("usage: build.elisascript ABSOLUTE_EMPTY_BUILD_DIRECTORY")
        return 2i64
    return EsTargetUsageBuild::build(arguments[0])
