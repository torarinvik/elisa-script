# Dormant, opt-in real-Machine publication fixture. Never auto-run this file.
# This includes the full IR facade and needs separate compiler/RSS qualification.
# Bodies model admission metadata only; no spawn, wait, signal or engine run.
include "../../../src/ir/ir.elisa"
include "../../../src/ir/process_launch_error_adapter.elisa"

extend EsIr:
    private:
        def launch_error_fixture_machine(failure: InterpretFailure) -> Machine can[Memory.Allocate, Abort.Panic]:
            return Machine{steps: 0, step_limit: 10, failure: failure, continuations: [], resume_requested: false, resume_value: runtime_void()}


        def launch_error_fixture_session() -> PreparedSpawnSession can[Memory.Allocate, Abort.Panic]:
            session: mutable PreparedSpawnSession = PreparedSpawnSession{owner_token: 7}
            session.launch.failure <- EsProcessLaunchFailure::Receipt{stage: EsProcessLaunchFailure::Stage.Admission}
            return session


        def launch_error_fixture_storage() -> EsProcessLaunchStorage::Prepared can[Memory.Allocate, Abort.Panic]:
            return EsProcessLaunchStorage::Prepared{
                arguments: [[116u8,111u8,111u8,108u8,0u8]], argument_bytes: 5, storage_bytes: 10,
                environment: EsProcessEnvironmentPlan::Prepared{executable_candidates: [[116u8,111u8,111u8,108u8,0u8]], search_bytes: 5}
            }

    public:
        @test
        def launch_error_publication_matches_named_guard_and_survives_reuse() -> void:
            can Memory.Allocate, Abort.Panic:
                machine: mutable Machine = launch_error_fixture_machine(InterpretFailure.Process)
                machine.failure_payloads.push(runtime_int(-99))
                session: mutable PreparedSpawnSession = launch_error_fixture_session()
                prepared: mutable EsProcessLaunchStorage::Prepared = launch_error_fixture_storage()
                storage: mutable darray[RuntimeValue] = [runtime_int(77)]
                publish_session_launch_failure(machine, storage, session, prepared)
                assert machine.failure == InterpretFailure.Raised and machine.failure_payloads.count == 12
                assert machine.failure_family == "ProcessError" and machine.failure_operation == "LaunchFailure"
                assert machine.failure_payloads[0].integer == 1 and machine.failure_payloads[1].integer == 0
                guard: ErrorGuard = ErrorGuard{target: 12, handler_depth: 0, effect_family: "ProcessError", effect_operation: "LaunchFailure", operation_id: effect_operation_identity("ProcessError", "LaunchFailure")}
                assert error_guard_matches(machine, guard)
                assert not error_guard_matches(machine, ErrorGuard{target: 12, handler_depth: 0, effect_family: "ProcessError", effect_operation: "Other"})
                guards: mutable darray[ErrorGuard] = [guard]
                handlers: mutable darray[sview] = []
                target: mutable u32 = 0
                assert recover_error_guard(machine, guards, handlers, target)
                assert target == 12 and machine.failure == InterpretFailure.None and machine.failure_family == ""
                bytes_type: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Int, element_bits: 8, element_signed: false}
                requested: RuntimeValue = evaluate_error_payload(machine, 4, bytes_type)
                assert machine.failure == InterpretFailure.None and requested.kind == RuntimeValueKind.Array
                assert requested.array_start == 1 and requested.array_count == 4
                prepared.arguments[0][0] <- 88u8
                _ = try prepare_session_launch(session) else failure:
                    assert false
                    return
                assert EsProcessLaunchFailure::is_pristine(session.launch.failure)
                assert storage.count == 5 and storage[0].integer == 77 and storage[1].integer == 116
                assert machine.failure_payloads[0].integer == 1


        @test
        def launch_error_publication_rejects_reentry_without_replacing_original_frame() -> void:
            can Memory.Allocate, Abort.Panic:
                machine: mutable Machine = launch_error_fixture_machine(InterpretFailure.Process)
                session: PreparedSpawnSession = launch_error_fixture_session()
                prepared: EsProcessLaunchStorage::Prepared = launch_error_fixture_storage()
                storage: mutable darray[RuntimeValue] = []
                publish_session_launch_failure(machine, storage, session, prepared)
                assert machine.failure == InterpretFailure.Raised and storage.count == 4
                publish_session_launch_failure(machine, storage, session, prepared)
                assert machine.failure == InterpretFailure.Panic and storage.count == 4
                assert machine.failure_payloads.count == 12 and machine.failure_payloads[0].integer == 1
                assert machine.failure_family == "ProcessError" and machine.failure_operation == "LaunchFailure"


        @test
        def launch_error_publication_never_turns_ordinary_exit_or_quarantine_into_variant() -> void:
            can Memory.Allocate, Abort.Panic:
                machine: mutable Machine = launch_error_fixture_machine(InterpretFailure.None)
                session: mutable PreparedSpawnSession = launch_error_fixture_session()
                prepared: EsProcessLaunchStorage::Prepared = launch_error_fixture_storage()
                storage: mutable darray[RuntimeValue] = []
                publish_session_launch_failure(machine, storage, session, prepared)
                assert machine.failure == InterpretFailure.Panic and machine.failure_payloads.count == 0 and storage.count == 0
                machine <- launch_error_fixture_machine(InterpretFailure.Process)
                session.state <- SpawnSessionState.Quarantined
                publish_session_launch_failure(machine, storage, session, prepared)
                assert machine.failure == InterpretFailure.Panic and machine.failure_payloads.count == 0 and storage.count == 0
