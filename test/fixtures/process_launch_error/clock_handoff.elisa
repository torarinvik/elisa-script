# Dormant full-facade fixture: separate compiler/RSS qualification is required.
# Test bodies call only the pure handoff and elapsed-time model. No host clock,
# process launch, wait, signal, compiler or engine run is requested here.
include "../../../src/ir/ir.elisa"
include "../../../src/ir/process_spawn_wait_adapter.elisa"

extend EsIr:
    public:
        @test
        def prepared_waiter_preserves_expired_finite_origin() -> void:
            origin: EsMonotonicTime::MonotonicTimestamp = EsMonotonicTime::MonotonicTimestamp{seconds: 8, nanoseconds: 999999000}
            after_setup: EsMonotonicTime::MonotonicTimestamp = EsMonotonicTime::MonotonicTimestamp{seconds: 9, nanoseconds: 10000}
            waiter: ProcessWaiter = prepared_process_waiter(42, 10u64, false, origin, true)
            assert waiter.pid == 42 and waiter.group_ready and waiter.clock_started
            assert waiter.started_at.seconds == 8 and waiter.started_at.nanoseconds == 999999000
            assert waiter.timeout_micros == 10u64
            elapsed: u64 = try EsMonotonicTime::monotonic_elapsed_microseconds(waiter.started_at, after_setup) else failure:
                assert false
                return
            assert elapsed == 11u64 and elapsed >= waiter.timeout_micros
            assert not waiter.reaped and not waiter.failed and not waiter.ownership_uncertain


        @test
        def prepared_waiter_preserves_disabled_clock_sentinel() -> void:
            origin: EsMonotonicTime::MonotonicTimestamp = EsMonotonicTime::MonotonicTimestamp{seconds: 0, nanoseconds: 0}
            waiter: ProcessWaiter = prepared_process_waiter(42, 0u64, false, origin, true)
            assert waiter.timeout_micros == 0u64 and waiter.clock_started
            assert waiter.started_at.seconds == 0 and waiter.started_at.nanoseconds == 0
            assert waiter.polls == 0 and not waiter.timed_out


        @test
        def prepared_waiter_does_not_erase_cleanup_or_missing_clock_state() -> void:
            origin: EsMonotonicTime::MonotonicTimestamp = EsMonotonicTime::MonotonicTimestamp{seconds: 7, nanoseconds: 9000}
            waiter: ProcessWaiter = prepared_process_waiter(42, 10u64, true, origin, false)
            assert waiter.failed and not waiter.clock_started
            assert waiter.started_at.seconds == 7 and waiter.started_at.nanoseconds == 9000
            assert waiter.timeout_micros == 10u64 and not waiter.reaped
