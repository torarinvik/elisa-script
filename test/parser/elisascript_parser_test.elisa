        match body[0]:
            Stmt.Return(value, _):
                match value:
                    Expr.Binary(Expr.IntLit(left), TokenKind.EqEq, Expr.IntLitTyped(right, suffix), _):
                        assert left == 10
                        assert right == 10
                        assert suffix == "u64"
                    _:
                        assert false
            _:
                assert false


@test
def prefixed_integer_ranges_remain_structured_patterns() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "def classify(value: i64) -> void:\n    match value:\n        0o10..=0b10000:\n            pass\n        _:\n            pass\n"
        file: Ast::File = parse_script(source)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_body(file)
        match body[0]:
            Stmt.Match(_, arms, _):
                match arms[0].pattern:
                    Pattern.Range(lo, hi, inclusive):
                        assert lo == "0o10"
                        assert hi == "0b10000"
                        assert inclusive
                    _:
                        assert false
            _:
                assert false
