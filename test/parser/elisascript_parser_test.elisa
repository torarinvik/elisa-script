include "../../vendor/elisa-compiler/src/parser/parser.elisa"

using Ast


def parse_script(source: u8&) -> Ast::File:
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize("test.elisascript", source)
        return frontend_parser_parse_file(source, tokens)


def first_body(file: Ast::File&) -> darray[Ast::Stmt]:
    can Memory.Allocate, Abort.Panic:
        for declaration in file.top_decls:
            match declaration:
                Decl.Func(_, _, _, body, _, _, _):
                    return body
                _:
                    pass
        return []


@test
def adjacent_typed_literal_desugars_to_call() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "def script() -> void:\n    value = path\"src/main.elisa\"\n"
        file: Ast::File = parse_script(source)

        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_body(file)
        assert body.count == 1

        match body[0]:
            Stmt.Assign(Expr.Ident(name, _), TokenKind.Assign, value, _):
                assert name == "value"
                match value:
                    Expr.Call(callee, arguments, argument_names, _):
                        assert arguments.count == 1
                        assert argument_names.count == 1
                        assert argument_names[0] == ""
                        match callee:
                            Expr.Ident(prefix, _):
                                assert prefix == "path"
                            _:
                                assert false
                        match arguments[0]:
                            Expr.StringLit(payload):
                                assert payload == "src/main.elisa"
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false

@test
def typed_literal_prefix_is_generic() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "def script() -> void:\n    pattern = regex\"(?<name>[a-z]+)\"\n"
        file: Ast::File = parse_script(source)

        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_body(file)
        match body[0]:
            Stmt.Assign(_, TokenKind.Assign, Expr.Call(Expr.Ident(prefix, _), arguments, _, _), _):
                assert prefix == "regex"
                assert arguments.count == 1
                match arguments[0]:
                    Expr.StringLit(payload):
                        assert payload == "(?<name>[a-z]+)"
                    _:
                        assert false
            _:
                assert false


@test
def adjacent_triple_typed_literal_desugars_to_call() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "def main() -> Regex:\n    return regex\"\"\"(?<word>[a-z]+)\n\"\"\"\n"
        file: Ast::File = parse_script(source)

        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_body(file)
        match body[0]:
            Stmt.Return(value, _):
                match value:
                    Expr.Call(Expr.Ident(prefix, _), arguments, _, _):
                        assert prefix == "regex"
                        assert arguments.count == 1
                        match arguments[0]:
                            Expr.StringLit(payload):
                                assert payload == "(?<word>[a-z]+)\n"
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false


@test
def adjacent_triple_typed_literal_keeps_escaped_quote_run_in_payload() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "def main() -> Regex:\n    return regex\"\"\"quote \\\"\"\" still\"\"\"\n"
        file: Ast::File = parse_script(source)

        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_body(file)
        match body[0]:
            Stmt.Return(value, _):
                match value:
                    Expr.Call(Expr.Ident(prefix, _), arguments, _, _):
                        assert prefix == "regex"
                        assert arguments.count == 1
                        match arguments[0]:
                            Expr.StringLit(payload):
                                assert payload == "quote \\\"\"\" still"
                            _:
                                assert false
                    _:
                        assert false
            _:
                assert false

@test
def signal_payload_preserves_elisa_argument_expressions() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "def emit(value: i64) -> void can[Progress.Tick]:\n    signal Progress.Tick(value + 1, true)\n"
        file: Ast::File = parse_script(source)

        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_body(file)
        match body[0]:
            Stmt.Block(kind, clause, binding, payload, _):
                assert kind == "signal"
                assert clause.count == 1
                assert clause[0] == "Progress.Tick"
                assert payload.count == 2
                match payload[0]:
                    Stmt.Expr(Expr.Binary(Expr.Ident(name, _), TokenKind.Plus, Expr.IntLit(1), _), _):
                        assert name == "value"
                    _:
                        assert false
                match payload[1]:
                    Stmt.Expr(Expr.BoolLit(true), _):
                        pass
                    _:
                        assert false
            _:
                assert false

        named_source: static u8& = "def emit(value: i64) -> void can[Progress.Tick]:\n    signal Progress.Tick(value: value)\n"
        named_file: Ast::File = parse_script(named_source)
        assert named_file.errors.count > 0


@test
def integer_suffixes_are_attached_to_each_literal() -> void:
    can Memory.Allocate, Abort.Panic:
        source: static u8& = "def widths() -> bool:\n    return 1u8 == 2u16\n"
        file: Ast::File = parse_script(source)
        assert file.errors.count == 0
        body: darray[Ast::Stmt] = first_body(file)
        match body[0]:
            Stmt.Return(value, _):
                match value:
                    Expr.Binary(Expr.IntLitTyped(left, left_suffix), TokenKind.EqEq, Expr.IntLitTyped(right, right_suffix), _):
                        assert left == 1
                        assert left_suffix == "u8"
                        assert right == 2
                        assert right_suffix == "u16"
                    _:
                        assert false
            _:
                assert false
