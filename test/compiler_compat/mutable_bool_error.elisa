# Regression: read the Boolean pointee explicitly in the conditional raise.
# Expected: builds and exits zero after updating selected through the reference.
error ChoiceError:
    Duplicate

def choose(selected: mutable bool&) -> bool error[ChoiceError]:
    raise ChoiceError.Duplicate if selected[0]
    selected <- true
    return true

def main() -> i32:
    selected: mutable bool = false
    value: bool = try choose(&selected) else false
    return 0 if value and selected else 1
