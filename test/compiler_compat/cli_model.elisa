include "../../vendor/elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../../src/runtime/cli_model.elisa"

using EsCli

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    args: darray[sview] = ["--color", "never", "--check", "a.elisascript", "alpha beta"]
    result: EsCli::CliInvocation = try parse_cli_arguments(args) else return 1
    return 2 if result.mode != EsCli::CliMode.Check or result.color != EsCli::CliColorMode.Never
    return 3 if result.source_path != "a.elisascript" or result.script_arguments.count != 1
    return 4 if result.script_arguments[0] != "alpha beta"
    bad: darray[sview] = ["--color", "invalid", "a.elisascript"]
    rejected: bool = catch parse_cli_arguments(bad):
        value: false
        error failure: true
    return 0 if rejected else 5
