# Regression: stage1 0d92a608 declines probe's call to a module-private extern.
# Expected: builds and exits zero on a POSIX host.
module ExternProbe:
    private:
        @link_name(access)
        extern access_impl(path: cstr, mode: int) -> int can[Blocking.IO]
    public:
        def probe(path: cstr) -> int can[Blocking.IO]:
            return access_impl(path, 0)

def main() -> i32 can[Blocking.IO]:
    return ExternProbe::probe("/tmp")
