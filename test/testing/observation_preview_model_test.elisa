# Small pure fixtures; no compiler/native probe, process or console write.
include "../../src/testing/observation_preview_model.elisa"

module EsObservationPreviewFixture:
    public:
        @test
        def observation_preview_preserves_binary_as_lowercase_terminal_safe_hex() -> void:
            can Memory.Allocate, Abort.Panic:
                input: darray[u8] = [0u8,255u8,27u8,10u8,13u8,36u8,92u8]
                full: EsObservationPreview::Preview = try EsObservationPreview::preview(bytes_view(input)) else failure:
                    assert false
                    return
                assert full.total_bytes == 7 and full.shown_bytes == 7 and not full.truncated
                assert bytes_view(full.hex) == "00ff1b0a0d245c"
                prefix: EsObservationPreview::Preview = try EsObservationPreview::preview(bytes_view(input), 3) else failure:
                    assert false
                    return
                assert prefix.total_bytes == 7 and prefix.shown_bytes == 3 and prefix.truncated
                assert bytes_view(prefix.hex) == "00ff1b"
                tail: EsObservationPreview::Preview = try EsObservationPreview::tail_preview(bytes_view(input), 3) else failure:
                    assert false
                    return
                assert tail.total_bytes == 7 and tail.shown_bytes == 3 and tail.truncated
                assert bytes_view(tail.hex) == "0d245c"
                assert input[0] == 0u8 and input[1] == 255u8 and input[6] == 92u8


        @test
        def observation_preview_handles_empty_and_zero_byte_budgets() -> void:
            can Memory.Allocate, Abort.Panic:
                empty: EsObservationPreview::Preview = try EsObservationPreview::preview("", 0) else failure:
                    assert false
                    return
                zero: EsObservationPreview::Preview = try EsObservationPreview::preview("abc", 0) else failure:
                    assert false
                    return
                assert empty.total_bytes == 0 and empty.shown_bytes == 0 and empty.hex.count == 0 and not empty.truncated
                assert zero.total_bytes == 3 and zero.shown_bytes == 0 and zero.hex.count == 0 and zero.truncated
                zero_tail: EsObservationPreview::Preview = try EsObservationPreview::tail_preview("abc", 0) else failure:
                    assert false
                    return
                assert zero_tail.total_bytes == 3 and zero_tail.shown_bytes == 0 and zero_tail.hex.count == 0 and zero_tail.truncated
                for invalid in [65usize, 65536usize]:
                    catch EsObservationPreview::preview("abc", invalid):
                        ok _:
                            assert false
                        error failure:
                            assert failure == EsObservationPreview::PreviewError.InvalidBudget
                    catch EsObservationPreview::tail_preview("abc", invalid):
                        ok _:
                            assert false
                        error failure:
                            assert failure == EsObservationPreview::PreviewError.InvalidBudget


        @test
        def observation_preview_caps_output_at_the_sixty_four_byte_boundary() -> void:
            can Memory.Allocate, Abort.Panic:
                for count in [63usize,64usize,65usize]:
                    input: mutable darray[u8] = []
                    for index in 0..<count |input|:
                        input.push(index.u8())
                    result: EsObservationPreview::Preview = try EsObservationPreview::preview(bytes_view(input)) else failure:
                        assert false
                        return
                    expected: usize = count if count < 64 else 64
                    assert result.total_bytes == count and result.shown_bytes == expected
                    assert result.truncated == (count > 64) and result.hex.count == expected * 2
                    assert result.hex[0] == 48u8 and result.hex[1] == 48u8
                    assert input.count == count and input[count - 1] == (count - 1).u8()
                    tail: EsObservationPreview::Preview = try EsObservationPreview::tail_preview(bytes_view(input)) else failure:
                        assert false
                        return
                    assert tail.total_bytes == count and tail.shown_bytes == expected and tail.hex.count == expected * 2
                    assert tail.truncated == (count > 64)
                    if count == 65:
                        assert tail.hex[0] == 48u8 and tail.hex[1] == 49u8
                        assert tail.hex[126] == 52u8 and tail.hex[127] == 48u8
