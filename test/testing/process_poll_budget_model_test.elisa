# Pure work-budget fixtures; no wait, clock, signal, child or runner imported.
include "../../src/testing/process_poll_budget_model.elisa"

module EsProcessPollBudgetFixture:
    public:
        @test
        def process_poll_budget_charges_each_attempt_before_wait() -> void:
            consumed: mutable u64 = 0u64
            # Model zero/EINTR/zero/EINTR: the result never changes charging.
            for index in 0..<4 |consumed|:
                consumed <- try EsProcessPollBudget::take_poll(consumed, 4u64) else failure:
                    assert false
                    return
                assert consumed == (index + 1).u64()
            exhausted: mutable bool = false
            catch EsProcessPollBudget::take_poll(consumed, 4u64):
                ok count:
                    assert false
                error failure:
                    exhausted <- failure == EsProcessPollBudget::PollBudgetError.Exhausted
            assert exhausted and consumed == 4u64


        @test
        def process_poll_budget_admits_one_attempt_and_rejects_zero_limit() -> void:
            count: u64 = try EsProcessPollBudget::take_poll(0u64, 1u64) else failure:
                assert false
                return
            assert count == 1u64
            invalid: mutable bool = false
            catch EsProcessPollBudget::take_poll(0u64, 0u64):
                ok result:
                    assert false
                error failure:
                    invalid <- failure == EsProcessPollBudget::PollBudgetError.InvalidLimit
            assert invalid


        @test
        def process_poll_budget_rejects_consumed_and_overconsumed_without_wrapping() -> void:
            final: u64 = try EsProcessPollBudget::take_poll(18446744073709551614u64, 18446744073709551615u64) else failure:
                assert false
                return
            assert final == 18446744073709551615u64
            exhausted: mutable bool = false
            catch EsProcessPollBudget::take_poll(final, 18446744073709551615u64):
                ok result:
                    assert false
                error failure:
                    exhausted <- failure == EsProcessPollBudget::PollBudgetError.Exhausted
            assert exhausted
            exhausted <- false
            catch EsProcessPollBudget::take_poll(5u64, 4u64):
                ok result:
                    assert false
                error failure:
                    exhausted <- failure == EsProcessPollBudget::PollBudgetError.Exhausted
            assert exhausted
