# Mirrored interpreted port of infra/bots/recipe_modules/vars/resources/get_env_var.py.
include "./environment_lookup_model.elisa"

module EsSkiaGetEnvironment:
    private:
        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr("get environment: " + message + "\n")


    public:
        def run(arguments: darray[sview]) -> i64 can[Environment.Read, Memory.Allocate, Abort.Panic, Console.Write]:
            if arguments.count == 0:
                diagnostic("expected an environment variable name")
                return 1i64
            name: sview = arguments[0]
            value: mutable EsSkiaEnvironmentLookup::Value = EsSkiaEnvironmentLookup::Value{present: false}
            impossible: bool = try EsSkiaEnvironmentLookup::impossible_key(name) else err:
                diagnostic("unable to read environment within bounds")
                return 2i64
            # This classifier applies the same length and key rules as validate_name.
            if not impossible:
                present: bool = try has_environment(name) else err:
                    diagnostic("unable to read environment within bounds")
                    return 2i64
                if present:
                    bytes: sview = try get_environment_bounded(name, EsSkiaEnvironmentLookup::Limits::VALUE_BYTES.i64()) else err:
                        diagnostic("unable to read environment within bounds")
                        return 2i64
                    value <- EsSkiaEnvironmentLookup::Value{present: true, bytes: bytes}
            output: sview = try EsSkiaEnvironmentLookup::python_print_value(value) else err:
                diagnostic("invalid environment lookup value")
                return 2i64
            written: usize = try write_stdout(output) else err:
                diagnostic("unable to write stdout")
                return 1i64
            if written != len(output):
                diagnostic("short stdout write")
                return 1i64
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Environment.Read, Memory.Allocate, Abort.Panic, Console.Write]:
    return EsSkiaGetEnvironment::run(arguments)
