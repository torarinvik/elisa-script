# Shared orchestration for the canonical/campaign test companions. Pytest is
# an explicit host tool; neither original shell wrapper is invoked.
error ProcessError:
    ExecFailure(i64, sview)


module EsCanonicalTest:
    private:
        const module Defaults:
            PYTHON: sview = ".venv/bin/python"

        const module ExecFailure:
            ENOENT: i64 = 2
            ENOTDIR: i64 = 20


        const enum RunPhase of u8:
            CaptureDirectoryEnvironment
            EnterRoot
            PublishDirectoryEnvironment
            SelectTool
            DecodeMode
            Launch


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr("canonical test: " + message + "\n")


        def shell_dirname(invocation_path: sview) -> sview:
            length: usize = sview_len(invocation_path)
            return "." if length == 0
            finish: mutable usize = length
            while finish > 0 and sview_at(invocation_path, finish - 1) == 47:
                finish <- finish - 1
            return "/" if finish == 0
            path_without_trailing_slashes: sview = string_view_prefix(invocation_path, finish.i64())
            slash: i64 = sview_find_last_byte(path_without_trailing_slashes, 47)
            return "." if slash < 0
            parent_end: mutable usize = slash.usize()
            while parent_end > 0 and sview_at(path_without_trailing_slashes, parent_end - 1) == 47:
                parent_end <- parent_end - 1
            return "/" if parent_end == 0
            return string_view_prefix(path_without_trailing_slashes, parent_end.i64())


        def command_substitution_directory(directory: sview) -> sview:
            finish: mutable usize = sview_len(directory)
            while finish > 0 and sview_at(directory, finish - 1) == 10:
                finish <- finish - 1
            return string_view_prefix(directory, finish.i64())


        def direct_reference_path(invocation_path: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            suffix_length: usize = 12
            invocation_length: usize = sview_len(invocation_path)
            return invocation_path if invocation_length < suffix_length
            suffix_start: usize = invocation_length - suffix_length
            return invocation_path if string_view_suffix(invocation_path, suffix_start.i64()) != ".elisascript"
            return string_view_prefix(invocation_path, suffix_start.i64()) + ".sh"


        def exec_line(arguments: darray[sview], campaign_only: bool) -> i64:
            return 17i64 if campaign_only or (arguments.count > 0 and arguments[0] == "campaign")
            return 20i64 if arguments.count > 0 and arguments[0] == "all"
            return 14i64


        def report_exec_failure(errno: i64, requested: sview, invocation_path: sview, arguments: darray[sview], campaign_only: bool) -> i64 can[Directory.Read, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            status: i64 = process_exec_status(errno)
            reference_path: sview = reference_shell_invocation(invocation_path, campaign_only)
            prefix: sview = reference_path + ": line " + format_int(exec_line(arguments, campaign_only)) + ": exec: " + requested + ": "
            requested_directory: bool = try is_directory(path(requested)) else false
            message: mutable sview = prefix + "cannot execute: Permission denied\n"
            message <- prefix + "not found\n" if status == 127
            message <- prefix + "cannot execute: Is a directory\n" if status == 126 and requested_directory
            _ = try write_stderr(message) else err:
                return status
            return status


    public:
        def reference_shell_invocation(invocation_path: sview, campaign_only: bool) -> sview can[Memory.Allocate, Abort.Panic]:
            return command_substitution_directory(shell_dirname(invocation_path)) + "/test_canonical.sh" if campaign_only
            return direct_reference_path(invocation_path)


        def process_exec_status(errno: i64) -> i64:
            return 127i64 if errno == ExecFailure::ENOENT or errno == ExecFailure::ENOTDIR
            return 126i64


        def shell_exec_line(arguments: darray[sview], campaign_only: bool) -> i64:
            return exec_line(arguments, campaign_only)


        def oldpwd_after_cd(physical_directory: Path, inherited_pwd: sview, inherited_pwd_is_current: bool) -> sview can[Memory.Allocate, Abort.Panic]:
            return inherited_pwd if inherited_pwd != "" and inherited_pwd_is_current
            return f"{physical_directory}"


        def logical_project_root(invocation_path: sview, previous_logical_directory: sview) -> Path can[Memory.Allocate, Abort.Panic]:
            script_directory: sview = command_substitution_directory(shell_dirname(invocation_path))
            root_operand: Path = path_join(path(script_directory), "..")
            return path_normalize(root_operand) if path_is_absolute(root_operand)
            return path_normalize(path_join(path(previous_logical_directory), root_operand))


        const enum TestMode of u8:
            Fast
            Campaign
            All


        error UsageError:
            InvalidMode


        def usage_message(invocation_spelling: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return "usage: " + invocation_spelling + " [fast|campaign|all]\n"


        def mode_from_text(value: sview) -> TestMode error[UsageError]:
            return TestMode.Fast if value == "" or value == "fast"
            return TestMode.Campaign if value == "campaign"
            return TestMode.All if value == "all"
            raise UsageError.InvalidMode


        def pytest_arguments(mode: TestMode, extra: darray[sview]) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            prefix: darray[sview] = when mode:
                TestMode.Fast -> ["-m", "pytest", "-q", "-m", "not campaign"]
                TestMode.Campaign -> ["-m", "pytest", "-q", "-m", "campaign"]
                TestMode.All -> ["-m", "pytest", "-q"]
            argv: mutable darray[sview] = []
            for value in prefix:
                argv.push(value)
            for value in extra:
                argv.push(value)
            return argv


        def canonical_arguments(arguments: darray[sview]) -> darray[sview] error[UsageError] can[Memory.Allocate, Abort.Panic]:
            requested: sview = arguments[0] if arguments.count > 0 else "fast"
            mode: TestMode = try mode_from_text(requested)
            extra: mutable darray[sview] = []
            start: usize = 1 if arguments.count > 0 else 0
            for index in start..<arguments.count:
                extra.push(arguments[index])
            return pytest_arguments(mode, extra)


        def campaign_arguments(arguments: darray[sview]) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            # test_campaign.sh prepends campaign. Its caller's first argument
            # is a pytest argument, not another mode to parse or consume.
            return pytest_arguments(TestMode.Campaign, arguments)


        def run_root(invocation_path: Path, arguments: darray[sview], campaign_only: bool = false) -> i64 can[Directory.Read, Directory.Write, Environment.Read, Environment.Write, File.Read, Process.Replace, Console.Write, Console.Format, Memory.Allocate, Abort.Panic]:
            phase: mutable RunPhase = RunPhase.CaptureDirectoryEnvironment
            initial_directory: mutable Path = path("")
            project_root: mutable Path = path("")
            inherited_pwd: mutable sview = ""
            old_pwd: mutable sview = ""
            configured: mutable sview = ""
            argv: mutable darray[sview] = []
            # Preserve Bash's failure order: cwd, environment selection, mode,
            # then executable construction/launch. Invalid mode never launches.
            machine over phase:
                state Dispatch
                start Dispatch

                Dispatch, RunPhase.CaptureDirectoryEnvironment:
                    initial_directory <- try current_directory() else err:
                        diagnostic("unable to inspect current directory")
                        return 1i64
                    inherited_pwd <- try getenv("PWD", "") else err:
                        diagnostic("unable to read PWD")
                        return 1i64
                    inherited_pwd_is_current: bool = false
                    inherited_path: Path = path(inherited_pwd)
                    if inherited_pwd != "" and path_is_absolute(inherited_path):
                        inherited_pwd_is_current <- try path_real(inherited_path) == initial_directory else false
                    old_pwd <- oldpwd_after_cd(initial_directory, inherited_pwd, inherited_pwd_is_current)
                    project_root <- logical_project_root(f"{invocation_path}", old_pwd)
                    phase <- RunPhase.EnterRoot
                    -> Dispatch

                Dispatch, RunPhase.EnterRoot:
                    changed: bool = try change_directory(project_root) else err:
                        diagnostic("unable to enter project root")
                        return 1i64
                    if not changed:
                        diagnostic("unable to enter project root")
                        return 1i64
                    phase <- RunPhase.PublishDirectoryEnvironment
                    -> Dispatch

                Dispatch, RunPhase.PublishDirectoryEnvironment:
                    old_pwd_updated: bool = try setenv("OLDPWD", old_pwd) else err:
                        diagnostic("unable to update OLDPWD")
                        return 1i64
                    if not old_pwd_updated:
                        diagnostic("unable to update OLDPWD")
                        return 1i64
                    new_pwd_updated: bool = try setenv("PWD", f"{project_root}") else err:
                        diagnostic("unable to update PWD")
                        return 1i64
                    if not new_pwd_updated:
                        diagnostic("unable to update PWD")
                        return 1i64
                    phase <- RunPhase.SelectTool
                    -> Dispatch

                Dispatch, RunPhase.SelectTool:
                    configured <- try getenv("PYTHON_BIN", "") else err:
                        diagnostic("unable to read PYTHON_BIN")
                        return 1i64
                    phase <- RunPhase.DecodeMode
                    -> Dispatch

                Dispatch, RunPhase.DecodeMode:
                    if campaign_only:
                        argv <- campaign_arguments(arguments)
                    else:
                        argv <- try canonical_arguments(arguments) else err:
                            _ = write_stderr(usage_message(f"{invocation_path}"))
                            return 2i64
                    phase <- RunPhase.Launch
                    -> Dispatch

                Dispatch, RunPhase.Launch:
                    python: Executable = try executable(Defaults::PYTHON if configured == "" else configured) else err:
                        diagnostic("invalid Python executable")
                        return 1i64
                    catch replace_process(python, argv):
                        ok _:
                            return 0i64
                        ProcessError.ExecFailure(errno, requested):
                            return report_exec_failure(errno, requested, f"{invocation_path}", arguments, campaign_only)
                    return 0i64
            return 1i64


        def run_default(arguments: darray[sview], campaign_only: bool = false) -> i64 can[Directory.Read, Directory.Write, Environment.Read, Environment.Write, File.Read, Process.Replace, Console.Write, Console.Format, Memory.Allocate, Abort.Panic]:
            invocation_path: Path = Script::invocation_path()
            return run_root(invocation_path, arguments, campaign_only)
