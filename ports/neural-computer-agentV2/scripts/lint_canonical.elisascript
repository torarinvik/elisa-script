# Companion for neural-computer-agentV2/scripts/lint_canonical.sh.
# Deploy beside the original wrapper; retain it until launcher parity passes.
include "lint_canonical_invocation.elisa"
include "process_errors.elisascript"

module EsCanonicalLint:
    private:
        const module ExecFailure:
            ENOENT: i64 = 2
            ENOTDIR: i64 = 20


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr("canonical lint: " + message + "\n")


        def reference_shell_path(invocation_path: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            suffix_length: usize = 12
            invocation_length: usize = sview_len(invocation_path)
            return invocation_path if invocation_length < suffix_length
            suffix_start: usize = invocation_length - suffix_length
            return invocation_path if string_view_suffix(invocation_path, suffix_start.i64()) != ".elisascript"
            return string_view_prefix(invocation_path, suffix_start.i64()) + ".sh"


        # Bash reports command lookup failures as 127 and other exec failures
        # as 126. The diagnostic intentionally uses the reference wrapper's
        # spelling so the differential fixture compares the same bytes.
        def exec_failure_status(errno: i64, requested: sview) -> i64 can[Directory.Read, Memory.Allocate, Abort.Panic, Console.Write]:
            status: i64 = 127 if errno == ExecFailure::ENOENT or errno == ExecFailure::ENOTDIR else 126
            invocation: sview = reference_shell_path(Script::invocation_path())
            prefix: sview = invocation + ": line 6: exec: " + requested + ": "
            requested_directory: bool = try is_directory(path(requested)) else false
            message: mutable sview = prefix + "cannot execute: Permission denied\n"
            message <- prefix + "not found\n" if status == 127
            message <- prefix + "cannot execute: Is a directory\n" if status == 126 and requested_directory
            message <- prefix + "cannot execute: Permission denied\n" if status == 126 and not requested_directory
            _ = try write_stderr(message) else err:
                return status
            return status


        struct SelectedProjectRoot:
            path: Path
            print_cdpath_directory: bool = false
            posix_cdpath_fallback_failure: bool = false


        struct ZeroDirectoryStackIndex:
            recognized: bool = false
            suffix_start: usize = 0


        def zero_directory_stack_index(entry: sview, digits_start: usize) -> ZeroDirectoryStackIndex:
            length: usize = sview_len(entry)
            return ZeroDirectoryStackIndex{} if digits_start >= length
            index: mutable usize = digits_start
            while index < length and sview_at(entry, index) != 47u8 |entry, index|:
                byte: u8 = sview_at(entry, index)
                return ZeroDirectoryStackIndex{} if byte < 48u8 or byte > 57u8 or byte != 48u8
                index <- index + 1
            return ZeroDirectoryStackIndex{recognized: true, suffix_start: index}


        # Support current-user, PWD/OLDPWD, and current stack-slot tilde forms.
        # Named users and nonzero stack indexes require external shell state.
        def expand_cdpath_entry(entry: sview) -> Path can[Directory.Read, Environment.Read, Memory.Allocate, Abort.Panic, Console.Format]:
            length: usize = sview_len(entry)
            return path(entry) if length == 0 or sview_at(entry, 0) != 126
            prefix_kind: mutable u8 = 126u8
            suffix_start: mutable usize = 1
            if length > 1:
                prefix_byte: u8 = sview_at(entry, 1)
                if prefix_byte == 43u8 or prefix_byte == 45u8:
                    if length > 2 and sview_at(entry, 2) != 47:
                        stack_index: ZeroDirectoryStackIndex = zero_directory_stack_index(entry, 2)
                        return path(entry) if not stack_index.recognized
                        prefix_kind <- 48u8
                        suffix_start <- stack_index.suffix_start
                    else:
                        prefix_kind <- prefix_byte
                        suffix_start <- 2
                else:
                    if prefix_byte >= 48u8 and prefix_byte <= 57u8:
                        plain_stack_index: ZeroDirectoryStackIndex = zero_directory_stack_index(entry, 1)
                        return path(entry) if not plain_stack_index.recognized
                        prefix_kind <- 48u8
                        suffix_start <- plain_stack_index.suffix_start
                    else:
                        return path(entry) if prefix_byte != 47u8
            base_directory: mutable sview = ""
            if prefix_kind == 126u8:
                base_directory <- try getenv("HOME", "\0") else "\0"
                return path(entry) if base_directory == "\0"
            elif prefix_kind == 43u8 or prefix_kind == 48u8:
                base_directory <- try getenv("PWD", "") else ""
                if base_directory == "":
                    current: Path = try current_directory() else err:
                        return path(entry)
                    base_directory <- f"{current}"
            else:
                # OLDPWD may be explicitly empty; only an unset variable leaves
                # the failed tilde prefix unchanged in Bash.
                base_directory <- try getenv("OLDPWD", "\0") else "\0"
                return path(entry) if base_directory == "\0"
            expanded: sview = base_directory + string_view_suffix(entry, suffix_start.i64())
            return path(expanded)


        def select_project_root(project_root: Path) -> SelectedProjectRoot can[Environment.Read, Directory.Read, File.Read, Memory.Allocate, Abort.Panic, Console.Format]:
            project_root_text: sview = f"{project_root}"
            return SelectedProjectRoot{path: project_root} if not EsCanonicalLintInvocation::cdpath_search_allowed(project_root_text)
            configured_cdpath: sview = try getenv("CDPATH", "") else err:
                ""
            entries: darray[sview] = split(configured_cdpath, ":")
            for entry in entries:
                expanded_entry: Path = expand_cdpath_entry(entry)
                candidate: Path = project_root if entry == "" else path_join(expanded_entry, project_root_text)
                candidate_is_directory: bool = try is_directory(candidate) else err:
                    false
                if candidate_is_directory:
                    # Bash decides whether to print before tilde expansion.
                    return SelectedProjectRoot{path: candidate, print_cdpath_directory: entry != ""}
            posixly_correct: sview = try getenv("POSIXLY_CORRECT", "\0") else "\0"
            return SelectedProjectRoot{
                path: project_root,
                posix_cdpath_fallback_failure: configured_cdpath != "" and posixly_correct != "\0"
            }


    public:
        def run_root(project_root: Path, print_cdpath_directory: bool) -> i64 can[Directory.Read, Directory.Write, Environment.Read, Environment.Write, File.Read, Process.Replace, Memory.Allocate, Console.Write, Console.Format]:
            old_directory: Path = try current_directory() else err:
                diagnostic("unable to inspect current directory")
                return 1i64
            configured_old_pwd: sview = try getenv("PWD", "") else err:
                diagnostic("unable to read PWD")
                return 1i64
            old_logical_directory: mutable Path = old_directory
            configured_old_directory: Path = path(configured_old_pwd)
            if path_is_absolute(configured_old_directory):
                configured_old_pwd_matches: bool = try path_real(configured_old_directory) == old_directory else false
                if configured_old_pwd_matches:
                    old_logical_directory <- configured_old_directory
            changed: bool = try change_directory(project_root) else err:
                diagnostic("unable to enter project root")
                return 1i64
            if not changed:
                diagnostic("unable to enter project root")
                return 1i64

            new_directory: Path = try current_directory() else err:
                diagnostic("unable to inspect project root")
                return 1i64
            logical_project_root: mutable Path = path_normalize(project_root)
            if not path_is_absolute(project_root):
                project_root_text: sview = f"{project_root}"
                logical_project_root <- path_normalize(path_join(old_logical_directory, project_root_text))
            logical_project_matches: bool = try path_real(logical_project_root) == new_directory else false
            if not logical_project_matches:
                logical_project_root <- new_directory
            old_directory_text: sview = f"{old_logical_directory}"
            new_directory_text: sview = f"{logical_project_root}"
            if print_cdpath_directory:
                _ = try write_stdout(new_directory_text + "\n") else err:
                    diagnostic("unable to print selected CDPATH directory")
                    return 1i64
            old_pwd_updated: bool = try set_environment("OLDPWD", old_directory_text) else err:
                diagnostic("unable to update OLDPWD")
                return 1i64
            if not old_pwd_updated:
                diagnostic("unable to update OLDPWD")
                return 1i64
            pwd_updated: bool = try set_environment("PWD", new_directory_text) else err:
                diagnostic("unable to update PWD")
                return 1i64
            if not pwd_updated:
                diagnostic("unable to update PWD")
                return 1i64

            configured: sview = try getenv("RUFF_BIN", "") else err:
                diagnostic("unable to read RUFF_BIN")
                return 1i64
            ruff: Executable = try executable(EsCanonicalLintInvocation::executable(configured)) else err:
                diagnostic("invalid Ruff executable")
                return 1i64
            # The shell reference uses `exec`, so replace this interpreter in
            # place rather than spawning a child and translating its status.
            arguments: darray[sview] = [EsCanonicalLintInvocation::Arguments::CHECK, EsCanonicalLintInvocation::Arguments::SOURCE, EsCanonicalLintInvocation::Arguments::TESTS, EsCanonicalLintInvocation::Arguments::CANONICAL_EXPERIMENTS]
            catch replace_process(ruff, arguments):
                ok _:
                    return 0i64
                ProcessError.ExecFailure(errno, requested):
                    return exec_failure_status(errno, requested)
            return 0i64


        def run_default() -> i64 can[Directory.Read, Directory.Write, Environment.Read, Environment.Write, File.Read, Process.Replace, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            script_directory: sview = EsCanonicalLintInvocation::script_directory(Script::invocation_path())
            project_root: Path = path_join(path(script_directory), "..")
            selection: SelectedProjectRoot = select_project_root(project_root)
            if selection.posix_cdpath_fallback_failure:
                diagnostic("unable to enter project root")
                return 1i64
            return run_root(selection.path, selection.print_cdpath_directory)


def main(arguments: darray[sview]) -> i64 can[Directory.Read, Directory.Write, Environment.Read, Environment.Write, File.Read, Process.Replace, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    # The shell reference ignores extra wrapper arguments.
    _ = arguments
    return EsCanonicalLint::run_default()
