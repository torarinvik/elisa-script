# Companion for neural-computer-agentV2/scripts/lint_canonical.sh.
# Deploy beside the original wrapper; retain it until launcher parity passes.
include "lint_canonical_invocation.elisa"

module EsCanonicalLint:
    private:
        const module Defaults:
            # Bash exec has no deadline. Zero disables the process-run timeout.
            TIMEOUT_MICROS: i64 = 0


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr("canonical lint: " + message + "\n")


        struct SelectedProjectRoot:
            path: Path
            print_cdpath_directory: bool = false


        # Support the common HOME forms while keeping named-user and directory-stack prefixes explicit gaps.
        def expand_cdpath_entry(entry: sview) -> Path can[Environment.Read, Memory.Allocate, Abort.Panic]:
            length: usize = sview_len(entry)
            return path(entry) if length == 0 or sview_at(entry, 0) != 126
            return path(entry) if length > 1 and sview_at(entry, 1) != 47
            home: sview = try getenv("HOME", "") else err:
                ""
            return path(home) if length == 1
            return path(home + string_view_suffix(entry, 1))


        def select_project_root(project_root: Path) -> SelectedProjectRoot can[Environment.Read, Directory.Read, File.Read, Memory.Allocate, Abort.Panic, Console.Format]:
            project_root_text: sview = f"{project_root}"
            return SelectedProjectRoot{path: project_root} if not EsCanonicalLintInvocation::cdpath_search_allowed(project_root_text)
            configured_cdpath: sview = try getenv("CDPATH", "") else err:
                ""
            entries: darray[sview] = split(configured_cdpath, ":")
            for entry in entries:
                candidate: Path = project_root if entry == "" else path_join(expand_cdpath_entry(entry), project_root_text)
                candidate_is_directory: bool = try is_directory(candidate) else err:
                    false
                if candidate_is_directory:
                    return SelectedProjectRoot{path: candidate, print_cdpath_directory: entry != ""}
            return SelectedProjectRoot{path: project_root}


    public:
        def run_root(project_root: Path, print_cdpath_directory: bool) -> i64 can[Directory.Read, Directory.Write, Environment.Read, Environment.Write, File.Read, Process.Run, Memory.Allocate, Console.Write, Console.Format]:
            old_directory: Path = try current_directory() else err:
                diagnostic("unable to inspect current directory")
                return 1i64
            configured_old_pwd: sview = try getenv("PWD", "") else err:
                diagnostic("unable to read PWD")
                return 1i64
            old_logical_directory: mutable Path = old_directory
            configured_old_directory: Path = path(configured_old_pwd)
            if path_is_absolute(configured_old_directory):
                configured_old_pwd_matches: bool = try path_real(configured_old_directory) == old_directory else false
                if configured_old_pwd_matches:
                    old_logical_directory <- configured_old_directory
            changed: bool = try change_directory(project_root) else err:
                diagnostic("unable to enter project root")
                return 1i64
            if not changed:
                diagnostic("unable to enter project root")
                return 1i64

            new_directory: Path = try current_directory() else err:
                diagnostic("unable to inspect project root")
                return 1i64
            logical_project_root: mutable Path = path_normalize(project_root)
            if not path_is_absolute(project_root):
                project_root_text: sview = f"{project_root}"
                logical_project_root <- path_normalize(path_join(old_logical_directory, project_root_text))
            logical_project_matches: bool = try path_real(logical_project_root) == new_directory else false
            if not logical_project_matches:
                logical_project_root <- new_directory
            old_directory_text: sview = f"{old_logical_directory}"
            new_directory_text: sview = f"{logical_project_root}"
            if print_cdpath_directory:
                _ = try write_stdout(new_directory_text + "\n") else err:
                    diagnostic("unable to print selected CDPATH directory")
                    return 1i64
            old_pwd_updated: bool = try set_environment("OLDPWD", old_directory_text) else err:
                diagnostic("unable to update OLDPWD")
                return 1i64
            if not old_pwd_updated:
                diagnostic("unable to update OLDPWD")
                return 1i64
            pwd_updated: bool = try set_environment("PWD", new_directory_text) else err:
                diagnostic("unable to update PWD")
                return 1i64
            if not pwd_updated:
                diagnostic("unable to update PWD")
                return 1i64

            configured: sview = try getenv("RUFF_BIN", "") else err:
                diagnostic("unable to read RUFF_BIN")
                return 1i64
            ruff: Executable = try executable(EsCanonicalLintInvocation::executable(configured)) else err:
                diagnostic("invalid Ruff executable")
                return 1i64
            # Do not use run_process_in_directory: its capture lowering discards
            # child stdout/stderr. This runner inherits all three streams.
            arguments: darray[sview] = [EsCanonicalLintInvocation::Arguments::CHECK, EsCanonicalLintInvocation::Arguments::SOURCE, EsCanonicalLintInvocation::Arguments::TESTS, EsCanonicalLintInvocation::Arguments::CANONICAL_EXPERIMENTS]
            return try run_process(ruff, arguments, Defaults::TIMEOUT_MICROS) else err:
                diagnostic("unable to run Ruff")
                return 1i64


        def run_default() -> i64 can[Directory.Read, Directory.Write, Environment.Read, Environment.Write, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            script_directory: sview = EsCanonicalLintInvocation::script_directory(Script::invocation_path())
            project_root: Path = path_join(path(script_directory), "..")
            selection: SelectedProjectRoot = select_project_root(project_root)
            return run_root(selection.path, selection.print_cdpath_directory)


def main(arguments: darray[sview]) -> i64 can[Directory.Read, Directory.Write, Environment.Read, Environment.Write, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    # The shell reference ignores extra wrapper arguments.
    _ = arguments
    return EsCanonicalLint::run_default()
