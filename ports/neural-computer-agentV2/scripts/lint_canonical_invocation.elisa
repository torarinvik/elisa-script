# Exact command selection for the canonical lint wrapper.
module EsCanonicalLintInvocation:
    private:
        const module Defaults:
            EXECUTABLE: sview = "ruff"


        # The reference wrapper applies the host `dirname` utility to its raw
        # `$0` spelling. Do not substitute Fs::parent here: that models
        # std::filesystem and intentionally retains trailing/repeated-slash
        # behavior that differs from the shell wrapper.
        def shell_dirname(invocation_path: sview) -> sview:
            length: usize = sview_len(invocation_path)
            return "." if length == 0
            finish: mutable usize = length
            while finish > 0 and sview_at(invocation_path, finish - 1) == 47:
                finish <- finish - 1
            return "/" if finish == 0

            path_without_trailing_slashes: sview = string_view_prefix(invocation_path, finish.i64())
            slash: i64 = sview_find_last_byte(path_without_trailing_slashes, 47)
            return "." if slash < 0
            parent_end: mutable usize = slash.usize()
            while parent_end > 0 and sview_at(path_without_trailing_slashes, parent_end - 1) == 47:
                parent_end <- parent_end - 1
            return "/" if parent_end == 0
            return string_view_prefix(path_without_trailing_slashes, parent_end.i64())


        # The wrapper embeds dirname in `$(...)`; command substitution removes
        # every trailing LF from the utility's output (including LFs that were
        # part of the directory name itself).
        def command_substitution_directory(directory: sview) -> sview:
            finish: mutable usize = sview_len(directory)
            while finish > 0 and sview_at(directory, finish - 1) == 10:
                finish <- finish - 1
            return string_view_prefix(directory, finish.i64())

    public:
        const module Arguments:
            CHECK: sview = "check"
            SOURCE: sview = "src"
            TESTS: sview = "tests"
            CANONICAL_EXPERIMENTS: sview = "experiments/brainworkshop_canonical"


        def script_directory(invocation_path: sview) -> sview:
            return command_substitution_directory(shell_dirname(invocation_path))


        # Bash's cd skips CDPATH when the operand is absolute or begins with
        # ./ or ../. Preserve this check on the raw operand, before path
        # normalization can erase those prefixes.
        def cdpath_search_allowed(operand: sview) -> bool:
            length: usize = sview_len(operand)
            return true if length == 0
            return false if sview_at(operand, 0) == 47
            return false if length > 1 and sview_at(operand, 0) == 46 and sview_at(operand, 1) == 47
            return false if length > 2 and sview_at(operand, 0) == 46 and sview_at(operand, 1) == 46 and sview_at(operand, 2) == 47
            return true


        def executable(configured: sview) -> sview:
            return Defaults::EXECUTABLE if configured == ""
            return configured
