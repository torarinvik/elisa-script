# Pure argument selection for the diagnostic-code generator CLI.
module EsDiagnosticCodesCliArgs:
    private:
        const module Syntax:
            CHECK: sview = "--check"
            COMPILER_ROOT: sview = "--compiler-root"
            OUTPUT: sview = "--output"

    public:
        const module Defaults:
            OUTPUT: sview = "src/diagnostic_codes.elisa"


        struct Options:
            compiler_root: sview = ""
            output: sview = Defaults::OUTPUT
            check: bool = false


        error ParseError:
            InvalidArguments


        def parse(arguments: darray[sview]) -> Options error[ParseError] can[Memory.Allocate, Abort.Panic]:
            options: mutable Options = Options{}
            cursor: mutable usize = 0
            while cursor < arguments.count |options, cursor|:
                option: sview = arguments[cursor]
                if option == Syntax::CHECK:
                    options.check <- true
                    cursor <- cursor + 1
                    continue
                if option == Syntax::COMPILER_ROOT or option == Syntax::OUTPUT:
                    raise ParseError.InvalidArguments if cursor + 1 >= arguments.count or arguments[cursor + 1] == ""
                    if option == Syntax::COMPILER_ROOT:
                        options.compiler_root <- arguments[cursor + 1]
                    else:
                        options.output <- arguments[cursor + 1]
                    cursor <- cursor + 2
                    continue
                raise ParseError.InvalidArguments
            return options
