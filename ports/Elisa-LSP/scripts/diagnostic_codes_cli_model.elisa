# Pure argument selection for the diagnostic-code generator CLI.
module EsDiagnosticCodesCliArgs:
    private:
        const module Syntax:
            CHECK: sview = "--check"
            COMPILER_ROOT: sview = "--compiler-root"
            OUTPUT: sview = "--output"


        const enum OptionKind of u8:
            Unknown
            Ambiguous
            Check
            CompilerRoot
            Output


        def option_kind(option_name: sview) -> OptionKind:
            return OptionKind.Check if option_name == Syntax::CHECK
            return OptionKind.CompilerRoot if option_name == Syntax::COMPILER_ROOT
            return OptionKind.Output if option_name == Syntax::OUTPUT
            return OptionKind.Unknown if not option_name.startswith("--")

            matched: mutable OptionKind = OptionKind.Unknown
            ambiguous: mutable bool = false
            if Syntax::CHECK.startswith(option_name):
                matched <- OptionKind.Check
            if Syntax::COMPILER_ROOT.startswith(option_name):
                ambiguous <- true if matched != OptionKind.Unknown
                matched <- OptionKind.CompilerRoot if matched == OptionKind.Unknown
            if Syntax::OUTPUT.startswith(option_name):
                ambiguous <- true if matched != OptionKind.Unknown
                matched <- OptionKind.Output if matched == OptionKind.Unknown
            return OptionKind.Ambiguous if ambiguous
            return matched

    public:
        const module Defaults:
            OUTPUT: sview = "src/diagnostic_codes.elisa"


        struct Options:
            compiler_root: sview = ""
            compiler_root_set: bool = false
            output: sview = Defaults::OUTPUT
            check: bool = false


        error ParseError:
            InvalidArguments


        def parse(arguments: darray[sview]) -> Options error[ParseError] can[Memory.Allocate, Abort.Panic]:
            options: mutable Options = Options{}
            cursor: mutable usize = 0
            while cursor < arguments.count |options, cursor|:
                option: sview = arguments[cursor]
                if option == "--":
                    cursor <- cursor + 1
                    raise ParseError.InvalidArguments if cursor < arguments.count
                    continue
                equals: i64 = option.index("=")
                option_name: sview = option if equals < 0 else option[0:equals]
                attached: bool = equals >= 0
                kind: OptionKind = option_kind(option_name)
                if kind == OptionKind.Check:
                    raise ParseError.InvalidArguments if attached
                    options.check <- true
                    cursor <- cursor + 1
                    continue
                if kind == OptionKind.CompilerRoot or kind == OptionKind.Output:
                    value: mutable sview = ""
                    if attached:
                        value <- option[equals + 1:len(option)]
                    else:
                        raise ParseError.InvalidArguments if cursor + 1 >= arguments.count
                        value <- arguments[cursor + 1]
                        raise ParseError.InvalidArguments if value.startswith("-")
                        cursor <- cursor + 1
                    if kind == OptionKind.CompilerRoot:
                        options.compiler_root <- value
                        options.compiler_root_set <- true
                    else:
                        options.output <- value
                    cursor <- cursor + 1
                    continue
                raise ParseError.InvalidArguments
            return options
