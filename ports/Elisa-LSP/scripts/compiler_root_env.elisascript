# Typed companion for Elisa-LSP/scripts/compiler_root_env.sh.
# Use resolve() directly in Elisascript callers; a subprocess cannot export
# variables back into the invoking shell. The original remains untouched.
include "compiler_root_env_model.elisa"

module EsLspCompilerRoot:
    public:
        error ResolveError:
            CannotCanonicalize

    private:
        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr("compiler root: " + message + "\n")


        def resolve_selected(selected: sview) -> sview error[ResolveError] can[File.Read, Directory.Read, Memory.Allocate, Abort.Panic, Console.Format]:
            # Bash's [[ -d ]] leaves a missing/non-directory spelling intact.
            directory: bool = try is_directory(path(selected)) else false
            return selected if not directory
            canonical: Path = try path_real(path(selected)) else err:
                raise ResolveError.CannotCanonicalize
            return f"{canonical}"

    public:
        def resolve(default_lsp_root: sview, configured: sview) -> sview error[EsCompilerRootEnv::RootError, ResolveError] can[File.Read, Directory.Read, Memory.Allocate, Abort.Panic, Console.Format]:
            selected: sview = try EsCompilerRootEnv::select(default_lsp_root, configured)
            return try resolve_selected(selected)


        def run(default_lsp_root: sview) -> i64 can[Environment.Read, File.Read, Directory.Read, Memory.Allocate, Abort.Panic, Console.Format, Console.Write]:
            configured: sview = try getenv("ELISA_COMPILER_ROOT", "") else err:
                diagnostic("unable to read ELISA_COMPILER_ROOT")
                return 1i64
            selected: sview = try EsCompilerRootEnv::select(default_lsp_root, configured) else err:
                diagnostic("compiler root exceeds the path budget or contains NUL")
                return 2i64
            resolved: sview = try resolve_selected(selected) else err:
                _ = write_stderr("error: cannot resolve Elisa compiler root: " + selected + "\n")
                return 1i64
            output: sview = resolved + "\n"
            written: usize = try write_stdout(output) else err:
                diagnostic("unable to write normalized compiler root")
                return 1i64
            return 0i64 if written == len(output)
            diagnostic("short stdout write")
            return 1i64


        def run_default() -> i64 can[Environment.Read, File.Read, Directory.Read, Memory.Allocate, Abort.Panic, Console.Format, Console.Write]:
            script_directory: Path = try path_real(path_parent(Script::source_path())) else err:
                diagnostic("unable to resolve script directory")
                return 1i64
            return run(f"{script_directory.parent()}")


def main(arguments: darray[sview]) -> i64 can[Environment.Read, File.Read, Directory.Read, Memory.Allocate, Abort.Panic, Console.Format, Console.Write]:
    _ = arguments
    return EsLspCompilerRoot::run_default()
