# Elisascript companion to Elisa-LSP/scripts/generate_diagnostic_codes.py.
# The original and its callers remain unchanged until public-launcher parity.
include "diagnostic_codes_model.elisa"
include "../../../src/runtime/bounded_text_posix.elisa"

module EsDiagnosticCodesCli:
    private:
        const module Paths:
            ENUM: sview = "src/semantic/semantic_types_diagnostic_kind.elisa"
            OUTPUT: sview = "src/diagnostic_codes.elisa"


        const module Limits:
            SOURCE_BYTES: usize = 131072
            OUTPUT_BYTES: usize = 262144


        struct Options:
            compiler_root: sview = ""
            output: sview = Paths::OUTPUT
            check: bool = false


        error CliError:
            InvalidArguments
            RootUnavailable


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr("diagnostic codes: " + message + "\n")


        def parse(arguments: darray[sview]) -> Options error[CliError]:
            options: mutable Options = Options{}
            cursor: mutable usize = 0
            while cursor < arguments.count |options, cursor|:
                option: sview = arguments[cursor]
                if option == "--check":
                    options.check <- true
                    cursor <- cursor + 1
                    continue
                if option == "--compiler-root" or option == "--output":
                    raise CliError.InvalidArguments if cursor + 1 >= arguments.count or arguments[cursor + 1] == ""
                    if option == "--compiler-root":
                        options.compiler_root <- arguments[cursor + 1]
                    else:
                        options.output <- arguments[cursor + 1]
                    cursor <- cursor + 2
                    continue
                raise CliError.InvalidArguments
            return options


        # From the port checkout: .../elisa-script/ports/Elisa-LSP/scripts.
        # From a deployed checkout: .../Elisa-LSP/scripts. Both resolve the
        # sibling Elisa-compiler without relying on the caller's cwd.
        def default_compiler_root() -> Path error[CliError] can[File.Read, Directory.Read, Memory.Allocate, Abort.Panic]:
            script_directory: Path = try path_real(path_parent(Script::source_path())) else err:
                raise CliError.RootUnavailable
            checkout_parent: mutable Path = script_directory.parent().parent()
            checkout_parent <- checkout_parent.parent().parent() if checkout_parent.name() == "ports"
            return checkout_parent.joinpath("Elisa-compiler")

    public:
        def run(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, File.Read, File.Write, Directory.Read, Directory.Write, Console.Write, Console.Format]:
            options: Options = try parse(arguments) else err:
                diagnostic("expected [--compiler-root PATH] [--output PATH] [--check]")
                return 2i64
            compiler_root: mutable Path = path(options.compiler_root)
            if options.compiler_root == "":
                compiler_root <- try default_compiler_root() else err:
                    diagnostic("unable to locate sibling compiler checkout")
                    return 2i64
            canonical_root: Path = try path_real(compiler_root) else err:
                diagnostic("unable to resolve compiler root")
                return 2i64
            enum_path: Path = canonical_root.joinpath(Paths::ENUM)
            source: sview = try EsBoundedText::read_utf8(enum_path, Limits::SOURCE_BYTES) else err:
                diagnostic("cannot read bounded UTF-8 DiagnosticKind enum")
                return 2i64
            names: darray[sview] = try EsDiagnosticCodes::variants(source) else err:
                diagnostic("DiagnosticKind enum is missing, duplicate, or over budget")
                return 2i64
            rendered: sview = try EsDiagnosticCodes::render(names) else err:
                diagnostic("generated adapter exceeds the output budget")
                return 2i64
            output: Path = path(options.output)
            if options.check:
                current: sview = try EsBoundedText::read_utf8(output, Limits::OUTPUT_BYTES) else err:
                    diagnostic("cannot read bounded UTF-8 generated adapter")
                    return 2i64
                if current != rendered:
                    diagnostic(f"{options.output} is stale for {enum_path} ({names.count} variants); regenerate it")
                    return 1i64
                print(f"diagnostic code adapter is current ({names.count} variants): {options.output}")
                return 0i64
            created: bool = try create_directories(output.parent()) else err:
                diagnostic("cannot create generated adapter parent")
                return 2i64
            _ = created
            written: usize = try write_text(output, rendered) else err:
                diagnostic("cannot write generated adapter")
                return 2i64
            if written != len(rendered):
                diagnostic("short generated adapter write")
                return 2i64
            print(f"generated {options.output} from {enum_path} ({names.count} variants)")
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, File.Read, File.Write, Directory.Read, Directory.Write, Console.Write, Console.Format]:
    return EsDiagnosticCodesCli::run(arguments)
