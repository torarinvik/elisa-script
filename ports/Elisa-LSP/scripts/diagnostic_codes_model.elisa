# Pure source projection for Elisa-LSP/scripts/generate_diagnostic_codes.py.
# The host supplies bounded UTF-8 source bytes; no file is written here.
module EsDiagnosticCodes:
    private:
        const module Syntax:
            ENUM_START: sview = "        const enum DiagnosticKind of u16:"
            MEMBER_INDENT: sview = "            "
            NEXT_CONST_ENUM: sview = "        const enum "
            NEXT_ENUM: sview = "        enum "
            NEXT_EXTEND: sview = "        extend "


        const module Header:
            GENERATED: sview = "# GENERATED FILE. Do not edit by hand.\n"
            SOURCE: sview = "# Source: src/semantic/semantic_types_diagnostic_kind.elisa in the pinned compiler.\n"
            REGENERATE: sview = "# Regenerate with: python3 scripts/generate_diagnostic_codes.py\n"
            STABLE: sview = "# Stable identifiers are ELISA-<DiagnosticKind>; wording/severity remain frontend-owned.\n"
            FUNCTION: sview = "def diagnostic_code(kind: Semantic::DiagnosticKind) -> sview:\n"
            MATCH: sview = "    return match kind:\n"
            UNKNOWN: sview = "        _: \"ELISA-Unknown\"\n"


        const module Limits:
            SOURCE_BYTES: usize = 131072
            VARIANTS: usize = 2048
            OUTPUT_BYTES: usize = 262144


        def first_name_byte(byte: u8) -> bool:
            return byte == 95u8 or byte >= 65u8 and byte <= 90u8 or byte >= 97u8 and byte <= 122u8


        def remaining_name_byte(byte: u8) -> bool:
            return first_name_byte(byte) or byte >= 48u8 and byte <= 57u8


        def valid_name(value: sview) -> bool:
            return false if value == ""
            return false if not first_name_byte(sview_at(value, 0))
            for index in 1..<len(value) |value|:
                return false if not remaining_name_byte(sview_at(value, index))
            return true


        def append(output: mutable darray[u8]&, value: sview) -> void can[Memory.Allocate, Abort.Panic]:
            for byte in value |output|:
                output.push(byte)

    public:
        error DiagnosticCodeError:
            SourceLimit
            DeclarationMissing
            NoVariants
            DuplicateVariant
            VariantLimit
            OutputLimit


        def variants(source: sview) -> darray[sview] error[DiagnosticCodeError] can[Memory.Allocate, Abort.Panic]:
            raise DiagnosticCodeError.SourceLimit if len(source) > Limits::SOURCE_BYTES
            found: mutable bool = false
            names: mutable darray[sview] = []
            for line in source.split("\n") |found, names|:
                if not found:
                    if line.startswith(Syntax::ENUM_START):
                        trailing: sview = sview(line, len(Syntax::ENUM_START).i64(), (len(line) - len(Syntax::ENUM_START)).i64())
                        found <- trailing.strip() == ""
                    continue
                break if line.startswith(Syntax::NEXT_CONST_ENUM) or line.startswith(Syntax::NEXT_ENUM) or line.startswith(Syntax::NEXT_EXTEND)
                continue if not line.startswith(Syntax::MEMBER_INDENT)
                raw_candidate: sview = sview(line, len(Syntax::MEMBER_INDENT).i64(), (len(line) - len(Syntax::MEMBER_INDENT)).i64())
                continue if raw_candidate == "" or not first_name_byte(sview_at(raw_candidate, 0))
                candidate: sview = raw_candidate.strip()
                continue if not valid_name(candidate)
                raise DiagnosticCodeError.VariantLimit if names.count >= Limits::VARIANTS
                for previous in names:
                    raise DiagnosticCodeError.DuplicateVariant if previous == candidate
                names.push(candidate)
            raise DiagnosticCodeError.DeclarationMissing if not found
            raise DiagnosticCodeError.NoVariants if names.count == 0
            return names


        def render(names: darray[sview]) -> sview error[DiagnosticCodeError] can[Memory.Allocate, Abort.Panic]:
            raise DiagnosticCodeError.NoVariants if names.count == 0
            raise DiagnosticCodeError.VariantLimit if names.count > Limits::VARIANTS
            output: mutable darray[u8] = []
            append(output, Header::GENERATED)
            append(output, Header::SOURCE)
            append(output, Header::REGENERATE)
            append(output, Header::STABLE)
            append(output, Header::FUNCTION)
            append(output, Header::MATCH)
            for name in names |output|:
                raise DiagnosticCodeError.OutputLimit if not valid_name(name) or output.count >= Limits::OUTPUT_BYTES
                append(output, "        Semantic::DiagnosticKind." + name + ": \"ELISA-" + name + "\"\n")
                raise DiagnosticCodeError.OutputLimit if output.count > Limits::OUTPUT_BYTES
            append(output, Header::UNKNOWN)
            raise DiagnosticCodeError.OutputLimit if output.count > Limits::OUTPUT_BYTES
            return bytes_view(output)


        def project(source: sview) -> sview error[DiagnosticCodeError] can[Memory.Allocate, Abort.Panic]:
            names: darray[sview] = try variants(source)
            return try render(names)
