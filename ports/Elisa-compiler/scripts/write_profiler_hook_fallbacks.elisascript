# Stdout companion to Elisa-compiler/scripts/write_profiler_hook_fallbacks.sh.
# The first argument alone selects the Bash helper's optional callback block.
include "profiler_hook_fallbacks_model.elisa"

module EsProfilerHookFallbacksCli:
    private:
        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr("profiler hook fallbacks: " + message + "\n")

    public:
        def run(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write]:
            host_callbacks: bool = arguments.count > 0 and arguments[0] == "--host-callbacks"
            generated: sview = EsProfilerHookFallbacks::source(host_callbacks)
            written: usize = try write_stdout(generated) else err:
                diagnostic("stdout write failed")
                return 1i64
            return 0i64 if written == len(generated)
            diagnostic("short stdout write")
            return 1i64


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write]:
    return EsProfilerHookFallbacksCli::run(arguments)
