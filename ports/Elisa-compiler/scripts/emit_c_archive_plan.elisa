# Pure ordinary CLI plan for Elisa-compiler/scripts/emit_c_archive.py.
# Filesystem admission, same-parent staging, archiver execution and publication
# are intentionally separate host steps, not silently represented as complete.
module EsCArchivePlan:
    private:
        const module Syntax:
            OUTPUT: sview = "--output"
            ARCHIVER: sview = "--ar"
            END_OPTIONS: sview = "--"
            ARCHIVE_FLAGS: sview = "-rcs"
            STAGING_PREFIX: sview = "elisa-c-archive-"


        const module Limits:
            PATH_BYTES: usize = 4096
            OBJECTS: usize = 4096


        const enum PendingOption of u8:
            None
            Output
            Archiver

    public:
        struct Plan:
            output: sview
            archiver: sview
            objects: darray[sview]


        error PlanError:
            MissingOptionValue
            MissingOutput
            MissingArchiver
            MissingObjects
            TooManyObjects
            InvalidPath
            UnknownOption
            WrongStagingParent


        def safe_path(value: sview) -> bool:
            return false if value == "" or len(value) >= Limits::PATH_BYTES
            for byte in value:
                return false if byte == 0u8
            return true


        # `resolved_path_archiver` is an injected observation of shutil.which("ar").
        # It is used only when neither --ar nor nonempty AR supplied a value.
        def parse_ordinary(arguments: darray[sview], environment_archiver: sview, resolved_path_archiver: sview) -> Plan error[PlanError] can[Memory.Allocate, Abort.Panic]:
            output: mutable sview = ""
            explicit_archiver: mutable sview = ""
            archiver_seen: mutable bool = false
            objects: mutable darray[sview] = []
            pending: mutable PendingOption = PendingOption.None
            options_open: mutable bool = true
            for argument in arguments |output, explicit_archiver, archiver_seen, objects, pending, options_open|:
                if pending == PendingOption.Output:
                    raise PlanError.MissingOptionValue if argument.startswith("--")
                    output <- argument
                    pending <- PendingOption.None
                    continue
                if pending == PendingOption.Archiver:
                    raise PlanError.MissingOptionValue if argument.startswith("--")
                    explicit_archiver <- argument
                    archiver_seen <- true
                    pending <- PendingOption.None
                    continue
                if options_open and argument == Syntax::END_OPTIONS:
                    options_open <- false
                    continue
                if options_open and argument == Syntax::OUTPUT:
                    pending <- PendingOption.Output
                    continue
                if options_open and argument == Syntax::ARCHIVER:
                    pending <- PendingOption.Archiver
                    continue
                raise PlanError.UnknownOption if options_open and argument.startswith("-") and argument != "-"
                raise PlanError.TooManyObjects if objects.count >= Limits::OBJECTS
                raise PlanError.InvalidPath if not safe_path(argument)
                objects.push(argument)
            raise PlanError.MissingOptionValue if pending != PendingOption.None
            raise PlanError.MissingOutput if output == ""
            raise PlanError.InvalidPath if not safe_path(output)
            raise PlanError.MissingObjects if objects.count == 0
            selected_archiver: mutable sview = resolved_path_archiver
            selected_archiver <- environment_archiver if environment_archiver != ""
            selected_archiver <- explicit_archiver if archiver_seen
            raise PlanError.MissingArchiver if selected_archiver == ""
            raise PlanError.InvalidPath if not safe_path(selected_archiver)
            return Plan{output: output, archiver: selected_archiver, objects: objects}


        # Python invokes `ar -rcs <temporary sibling>/<output basename> <objects...>`.
        # The host must own the created staging directory, verify the output
        # parent identity and pass the directory, never an arbitrary archive.
        def archive_arguments(plan: Plan, temporary_directory: sview) -> darray[sview] error[PlanError] can[Memory.Allocate, Abort.Panic, Console.Format]:
            raise PlanError.InvalidPath if not safe_path(temporary_directory) or not safe_path(plan.output) or not safe_path(plan.archiver)
            raise PlanError.MissingObjects if plan.objects.count == 0
            raise PlanError.TooManyObjects if plan.objects.count > Limits::OBJECTS
            output_path: Path = path(plan.output)
            staging_path: Path = path(temporary_directory)
            output_leaf: sview = output_path.name()
            raise PlanError.InvalidPath if output_leaf == "" or output_leaf == "." or output_leaf == ".."
            staging_leaf: sview = staging_path.name()
            raise PlanError.WrongStagingParent if not staging_leaf.startswith(Syntax::STAGING_PREFIX) or len(staging_leaf) <= len(Syntax::STAGING_PREFIX)
            raise PlanError.WrongStagingParent if f"{staging_path.parent()}" != f"{output_path.parent()}"
            temporary_archive: sview = f"{staging_path.joinpath(output_leaf)}"
            raise PlanError.InvalidPath if not safe_path(temporary_archive)
            arguments: mutable darray[sview] = [Syntax::ARCHIVE_FLAGS, temporary_archive]
            for object in plan.objects |arguments|:
                raise PlanError.InvalidPath if not safe_path(object)
                arguments.push(object)
            return arguments
