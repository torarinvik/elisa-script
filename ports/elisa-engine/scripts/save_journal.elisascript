#!/usr/bin/env elisascript
# Runnable Elisascript companion for elisa-engine/scripts/save_journal.py.
include "./save_journal_posix.elisa"

using EsEngineSaveJournal
using EsEngineSaveJournalPosix


module EsEngineSaveJournalScript:
    private:
        def load_matches(target: Path, expected_payload: darray[u8]) -> bool can[File.Read, File.Write, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            document: JsonDocument = try EsEngineSaveJournalPosix::load_document(target) else failure:
                _ = failure
                return false
            observed_payload: darray[u8] = try EsEngineSaveJournal::canonical_payload(document) else failure:
                _ = failure
                return false
            return observed_payload == expected_payload


        def load_rejects_as(target: Path, expected: SaveJournalError) -> bool can[File.Read, File.Write, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            rejected: mutable bool = false
            catch EsEngineSaveJournalPosix::load_document(target):
                ok document:
                    _ = document
                error failure:
                    rejected <- failure == expected
            return rejected


        def self_test_in_directory(directory: Path) -> bool can[Directory.Write, File.Read, File.Write, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            target: Path = directory.joinpath("world.save")
            temporary: Path = target.with_name("world.save.tmp")
            journal: Path = target.with_name("world.save.journal")
            first: JsonDocument = try EsEngineSaveJournal::parse_json_object("{\"version\":2,\"records\":[{\"id\":7,\"fields\":[1,2]}]}") else failure:
                _ = failure
                return false
            second: JsonDocument = try EsEngineSaveJournal::parse_json_object("{\"version\":2,\"records\":[{\"id\":7,\"fields\":[9,4]}]}") else failure:
                _ = failure
                return false
            first_payload: darray[u8] = try EsEngineSaveJournal::canonical_payload(first) else failure:
                _ = failure
                return false
            second_payload: darray[u8] = try EsEngineSaveJournal::canonical_payload(second) else failure:
                _ = failure
                return false
            first_digest: darray[u8] = try EsEngineSaveJournal::sha256_hex(first_payload) else failure:
                _ = failure
                return false
            second_digest: darray[u8] = try EsEngineSaveJournal::sha256_hex(second_payload) else failure:
                _ = failure
                return false

            saved_digest: darray[u8] = try EsEngineSaveJournalPosix::save_document(target, first) else failure:
                _ = failure
                return false
            return false if saved_digest != first_digest or not load_matches(target, first_payload)

            second_journal: darray[u8] = try EsEngineSaveJournal::canonical_journal_payload(target.name(), temporary.name(), bytes_view(second_digest)) else failure:
                _ = failure
                return false
            _ = try EsEngineSaveJournalPosix::write_synced_file(temporary, second_payload) else failure:
                _ = failure
                return false
            _ = try EsEngineSaveJournalPosix::write_synced_file(journal, second_journal) else failure:
                _ = failure
                return false
            recovered: bool = try EsEngineSaveJournalPosix::recover_document(target) else failure:
                _ = failure
                return false
            return false if not recovered or not load_matches(target, second_payload)

            corrupt_payload: darray[u8] = [99u8, 111u8, 114u8, 114u8, 117u8, 112u8, 116u8]
            _ = try EsEngineSaveJournalPosix::write_synced_file(temporary, corrupt_payload) else failure:
                _ = failure
                return false
            corrupt_journal: darray[u8] = try EsEngineSaveJournal::canonical_journal_payload(target.name(), temporary.name(), bytes_view(second_digest)) else failure:
                _ = failure
                return false
            _ = try EsEngineSaveJournalPosix::write_synced_file(journal, corrupt_journal) else failure:
                _ = failure
                return false
            corrupt_recovered: bool = try EsEngineSaveJournalPosix::recover_document(target) else failure:
                _ = failure
                return false
            return false if corrupt_recovered or temporary.exists() or journal.exists() or not load_matches(target, second_payload)

            return false if first_payload.count < 12
            truncated: mutable darray[u8] = []
            for index in 0..<12 |first_payload, truncated|:
                truncated.push(first_payload[index])
            _ = try EsEngineSaveJournalPosix::write_synced_file(target, truncated) else failure:
                _ = failure
                return false
            return false if not load_rejects_as(target, SaveJournalError.InvalidJson)

            _ = try EsEngineSaveJournalPosix::write_synced_file(target, [255u8]) else failure:
                _ = failure
                return false
            return false if not load_rejects_as(target, SaveJournalError.InvalidJson)

            _ = try EsEngineSaveJournalPosix::write_synced_file(target, [91u8, 93u8, 10u8]) else failure:
                _ = failure
                return false
            return false if not load_rejects_as(target, SaveJournalError.DocumentMustBeObject)

            final_digest: darray[u8] = try EsEngineSaveJournalPosix::save_document(target, second) else failure:
                _ = failure
                return false
            return final_digest == second_digest and load_matches(target, second_payload)


    public:
        def run(arguments: darray[sview]) -> i64 can[Directory.Write, File.Read, File.Write, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            return 0i64 if arguments.count == 1 and (arguments[0] == "-h" or arguments[0] == "--help") and save_journal_print_help()
            if arguments.count != 1 or arguments[0] != "--self-test":
                _ = write_stderr("usage: save_journal.elisascript [-h] [--self-test]\nsave_journal.elisascript: error: --self-test is required\n")
                return 2i64
            directory: Path = try temp_directory("elisa-save-") else failure:
                _ = failure
                print("save journal: unable to create self-test directory")
                return 1i64
            checks_passed: bool = self_test_in_directory(directory)
            cleaned: bool = try remove_tree(directory) else false
            if not checks_passed or not cleaned:
                print("save journal: self-test failed")
                return 1i64
            print("save journal: commit, recovery, corrupt-journal fallback, and decode diagnostics passed")
            return 0i64


        def save_journal_print_help() -> bool can[Console.Write]:
            print("usage: save_journal.elisascript [-h] [--self-test]")
            print("")
            print("Crash-safe journaled persistence for the Elisa save document.")
            print("")
            print("options:")
            print("  -h, --help  show this help message and exit")
            print("  --self-test")
            print("              run commit, recovery, and decode checks")
            return true


def main(arguments: darray[sview]) -> i64 can[Directory.Write, File.Read, File.Write, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
    return EsEngineSaveJournalScript::run(arguments)
