# Ordered child-script plan from elisa-engine/scripts/native_unit_tests.py.
module EsEngineNativeUnitTestsPlan:
    public:
        struct ChildTest:
            script_name: sview
            arguments: darray[sview] = []


        def child_tests() -> darray[ChildTest] can[Memory.Allocate, Abort.Panic]:
            return [
                ChildTest{script_name: "save_journal.elisascript", arguments: ["--self-test"]},
                ChildTest{script_name: "test_jolt_shape_cache.elisascript"},
                ChildTest{script_name: "test_crash_report.elisascript"},
                ChildTest{script_name: "test_input_codes.elisascript"}
            ]
