# Ordered child-script plan from elisa-engine/scripts/native_unit_tests.py.
module EsEngineNativeUnitTestsPlan:
    public:
        const module Defaults:
            CXX_STANDARD: sview = "-std=c++17"
            OPTIMIZATION: sview = "-O0"
            GAMEPAD_TEST: sview = "test/application_gamepad_codes.cpp"
            GAMEPAD_EXECUTABLE: sview = "application-gamepad-codes-test"


        struct ChildTest:
            script_name: sview
            arguments: darray[sview] = []


        struct Command:
            program: sview
            arguments: darray[sview]


        error PlanError:
            EmptyCompilerCommand


        def child_tests() -> darray[ChildTest] can[Memory.Allocate, Abort.Panic]:
            return [
                ChildTest{script_name: "save_journal.elisascript", arguments: ["--self-test"]},
                ChildTest{script_name: "test_jolt_shape_cache.elisascript"},
                ChildTest{script_name: "test_crash_report.elisascript"},
                ChildTest{script_name: "test_input_codes.elisascript"}
            ]


        def gamepad_compile_command(engine_root: sview, temporary_directory: sview, compiler_words: darray[sview], include_flags: darray[sview]) -> Command error[PlanError] can[Memory.Allocate, Abort.Panic]:
            raise PlanError.EmptyCompilerCommand if compiler_words.count == 0
            program: sview = compiler_words[0]
            arguments: mutable darray[sview] = []
            for index in 1..<compiler_words.count |compiler_words, arguments|:
                arguments.push(compiler_words[index])
            arguments.push(Defaults::CXX_STANDARD)
            arguments.push(Defaults::OPTIMIZATION)
            for flag in include_flags |arguments|:
                arguments.push(flag)
            arguments.push(project_path(engine_root, Defaults::GAMEPAD_TEST))
            arguments.push("-o")
            arguments.push(project_path(temporary_directory, Defaults::GAMEPAD_EXECUTABLE))
            return Command{program: program, arguments: arguments}


    private:
        def project_path(root: sview, relative: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return relative if root == ""
            return "/" + relative if root == "/"
            return root + "/" + relative
