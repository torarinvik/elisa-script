# Python tempfile.gettempdir-compatible candidate order plus exclusive creation.
module EsEngineTempDirectory:
    public:
        error TempDirectoryError:
            NoUsableCandidate


        def candidate_parents(tmpdir: sview, temp: sview, tmp: sview, current_directory: sview) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            parents: mutable darray[sview] = []
            append_candidate(tmpdir, parents)
            append_candidate(temp, parents)
            append_candidate(tmp, parents)
            parents.push(Defaults::TMP)
            parents.push(Defaults::VAR_TMP)
            parents.push(Defaults::USR_TMP)
            append_candidate(current_directory, parents)
            return parents


        def create(prefix: sview) -> Path error[TempDirectoryError] can[Environment.Read, Directory.Read, File.Write, Memory.Allocate, Abort.Panic]:
            tmpdir: sview = try getenv("TMPDIR", "\0") else "\0"
            temp: sview = try getenv("TEMP", "\0") else "\0"
            tmp: sview = try getenv("TMP", "\0") else "\0"
            current_directory: mutable sview = "\0"
            catch path(".").absolute():
                ok value:
                    current_directory <- f"{value}"
                error failure:
                    _ = failure
            parents: darray[sview] = candidate_parents(tmpdir, temp, tmp, current_directory)
            for parent_text in parents:
                catch temp_directory_in(path(parent_text), prefix):
                    ok value:
                        return value
                    error failure:
                        _ = failure
            raise TempDirectoryError.NoUsableCandidate


    private:
        const module Defaults:
            TMP: sview = "/tmp"
            VAR_TMP: sview = "/var/tmp"
            USR_TMP: sview = "/usr/tmp"


        def append_candidate(candidate: sview, parents: mutable darray[sview]&) -> void can[Memory.Allocate, Abort.Panic]:
            parents.push(candidate) if candidate != "" and candidate != "\0"
