# Placement-local source-block sharing and primitive-index aggregation for
# cook_gltf_geometry.normalized_geometry.
include "gltf_primitive_placement_model.elisa"
include "gltf_node_graph_model.elisa"

using EsEngineGltfAffine
using EsEngineGltfNodeGraph
using EsEngineGltfNodeStreams
using EsEngineGltfPrimitivePlacement
using EsEngineGltfVertexStreams
using EsJson


module EsEngineGltfGeometryAssembly:
    public:
        const module Limits:
            MAX_PRIMITIVES: usize = 16
            MAX_PLACEMENTS: usize = EsEngineGltfNodeGraph::Limits::MAX_NODES
            MAX_VERTICES: usize = EsEngineGltfVertexStreams::Limits::MAX_VERTICES
            MAX_INDICES: usize = EsEngineGltfNodeStreams::Limits::MAX_INDICES
            MAX_MORPH_TARGETS: usize = EsEngineGltfVertexStreams::Limits::MAX_MORPH_TARGETS


        struct PlacedPrimitive:
            block_index: usize
            indices: darray[u32] = []
            material_index: usize = 0


        # Produced from the document's normalized skin plan: ordinary palette
        # entries carry source influences, Static synthesizes a rigid bind for
        # unskinned placements when another placement activates skin output.
        const enum PlacementSkinBindingKind of u8:
            Unskinned
            Palette
            Static


        struct PlacementSkinBinding:
            kind: PlacementSkinBindingKind = PlacementSkinBindingKind.Unskinned
            palette_offset: usize = 0
            palette_count: usize = 0


        # One instance per mesh placement. The caller passes the remaining
        # model-wide budgets so sequential placements share Python's global
        # vertex and index limits rather than resetting them per mesh.
        struct PlacementAssembly:
            matrix: Affine3x4
            vertex_budget: usize
            index_budget: usize
            skin_binding: PlacementSkinBinding = PlacementSkinBinding{}
            blocks: darray[GeometryBlock] = []
            primitives: darray[PlacedPrimitive] = []
            source_vertex_count: usize = 0
            index_count: usize = 0
            has_morph_shape: bool = false
            morph_target_count: usize = 0
            morph_normals_present: bool = false


        struct GeometryPlacementInput:
            placement: MeshPlacement
            material_indices: darray[usize] = []
            skin_binding: PlacementSkinBinding = PlacementSkinBinding{}


        struct AssembledMeshPlacement:
            placement: MeshPlacement
            effective_transform: Affine3x4
            geometry: PlacementAssembly


        struct GeometryPlacementSet:
            placements: darray[AssembledMeshPlacement] = []
            source_vertex_count: usize = 0
            index_count: usize = 0
            has_skin_streams: bool = false
            has_morph_shape: bool = false
            morph_target_count: usize = 0
            morph_normals_present: bool = false


        error GeometryAssemblyError:
            InvalidBudget
            PrimitiveCountOutOfRange
            PlacementCountOutOfRange
            EmptyPlacementList
            InvalidPrimitive
            InvalidSourceKey
            InvalidCacheReference
            MaterialBindingCountMismatch
            SourceIdentityCountMismatch
            SharedPositionAttributesDiffer
            SkinBindingMismatch
            SkinAttributeMismatch
            InvalidSkinPalette
            SkinJointOutOfPalette
            MorphTargetCountMismatch
            InconsistentMorphNormalStreams
            VertexBudgetExceeded
            IndexBudgetExceeded
            PlacementTransformFailed
            IndexPlacementFailed


        def new_placement_assembly(matrix: Affine3x4, vertex_budget: usize, index_budget: usize, skin_binding: PlacementSkinBinding = PlacementSkinBinding{}) PlacementAssembly error[GeometryAssemblyError]:
            raise GeometryAssemblyError.InvalidBudget if vertex_budget > Limits::MAX_VERTICES or index_budget > Limits::MAX_INDICES
            try geometry_assembly_validate_skin_binding(skin_binding)
            return PlacementAssembly{
                matrix: matrix,
                vertex_budget: vertex_budget,
                index_budget: index_budget,
                skin_binding: skin_binding
            }


        # Decode and assemble one mesh instance from its source JSON. Material
        # indices must already be validated against the document's material
        # table; the shared cache must belong to this document and buffer.
        def assemble_mesh_placement(document: JsonDocument&, buffer: darray[u8]&, placement: MeshPlacement, material_indices: darray[usize]&, cache: mutable VertexSourceCache&, vertex_budget: usize, index_budget: usize, skin_binding: PlacementSkinBinding = PlacementSkinBinding{}) PlacementAssembly error[GeometryAssemblyError, VertexStreamError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            try geometry_assembly_validate_placement_skin_binding(placement, skin_binding)
            effective_transform: Affine3x4 = geometry_assembly_effective_transform(placement)
            primitive_count: usize = try read_mesh_primitive_count(document, placement.mesh_index)
            raise GeometryAssemblyError.PrimitiveCountOutOfRange if primitive_count == 0 or primitive_count > Limits::MAX_PRIMITIVES
            raise GeometryAssemblyError.MaterialBindingCountMismatch if material_indices.count != primitive_count

            assembly: mutable PlacementAssembly = try new_placement_assembly(effective_transform, vertex_budget, index_budget, skin_binding)
            for ordinal in 0..<primitive_count |document, buffer, placement, material_indices, cache, assembly|:
                primitive: CachedTrianglePrimitive = try read_triangle_primitive_cached(document, buffer, placement.mesh_index, ordinal, cache)
                try append_cached_placement_primitive(assembly, cache, primitive, material_indices[ordinal])
            return assembly


        # Compose placements in node-graph order while sharing one decoded
        # source cache and the Python cooker's model-wide vertex/index budgets.
        # The node decoder carries skin presence into each placement so the
        # authored node transform cannot accidentally be baked for a skinned
        # mesh by a caller-provided boolean override.
        def assemble_geometry_placements(document: JsonDocument&, buffer: darray[u8]&, inputs: darray[GeometryPlacementInput]&, cache: mutable VertexSourceCache&) GeometryPlacementSet error[GeometryAssemblyError, VertexStreamError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise GeometryAssemblyError.EmptyPlacementList if inputs.count == 0
            raise GeometryAssemblyError.PlacementCountOutOfRange if inputs.count > Limits::MAX_PLACEMENTS

            remaining_vertices: mutable usize = Limits::MAX_VERTICES
            remaining_indices: mutable usize = Limits::MAX_INDICES
            result: mutable GeometryPlacementSet = GeometryPlacementSet{}
            for ordinal in 0..<inputs.count |document, buffer, inputs, cache, remaining_vertices, remaining_indices, result|:
                input: GeometryPlacementInput = inputs[ordinal]
                has_skin_streams: bool = input.skin_binding.kind != PlacementSkinBindingKind.Unskinned
                if ordinal == 0:
                    result.has_skin_streams <- has_skin_streams
                else:
                    raise GeometryAssemblyError.SkinBindingMismatch if result.has_skin_streams != has_skin_streams
                geometry: PlacementAssembly = try assemble_mesh_placement(
                    document,
                    buffer,
                    input.placement,
                    input.material_indices,
                    cache,
                    remaining_vertices,
                    remaining_indices,
                    input.skin_binding
                )
                raise GeometryAssemblyError.VertexBudgetExceeded if geometry.source_vertex_count > remaining_vertices
                raise GeometryAssemblyError.IndexBudgetExceeded if geometry.index_count > remaining_indices
                if result.has_morph_shape:
                    raise GeometryAssemblyError.MorphTargetCountMismatch if result.morph_target_count != geometry.morph_target_count
                    raise GeometryAssemblyError.InconsistentMorphNormalStreams if result.morph_normals_present != geometry.morph_normals_present
                else:
                    result.has_morph_shape <- true
                    result.morph_target_count <- geometry.morph_target_count
                    result.morph_normals_present <- geometry.morph_normals_present
                remaining_vertices <- remaining_vertices - geometry.source_vertex_count
                remaining_indices <- remaining_indices - geometry.index_count
                result.source_vertex_count <- result.source_vertex_count + geometry.source_vertex_count
                result.index_count <- result.index_count + geometry.index_count
                result.placements.push(AssembledMeshPlacement{
                    placement: input.placement,
                    effective_transform: geometry.matrix,
                    geometry: geometry
                })
            return result


        # Append one decoded primitive in source order. The first primitive
        # for a key creates/transforms its block; later primitives sharing
        # that key append only their placed indices. This keeps one vertex
        # block per key and preserves one draw record per material binding.
        # All primitives supplied to an instance must belong to the same
        # mesh placement and source document. Material binding validation is
        # performed by the document-level caller before this boundary.
        def append_placement_primitive(assembly: mutable PlacementAssembly&, primitive: TrianglePrimitive, material_index: usize) void error[GeometryAssemblyError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            try geometry_assembly_validate_skin_binding(assembly.skin_binding)
            raise GeometryAssemblyError.InvalidBudget if assembly.vertex_budget > Limits::MAX_VERTICES or assembly.index_budget > Limits::MAX_INDICES
            raise GeometryAssemblyError.InvalidBudget if assembly.source_vertex_count > assembly.vertex_budget or assembly.index_count > assembly.index_budget
            raise GeometryAssemblyError.PrimitiveCountOutOfRange if assembly.primitives.count >= Limits::MAX_PRIMITIVES
            try geometry_assembly_validate_primitive(primitive)

            has_morph_normals: bool = geometry_assembly_morph_normals_present(primitive.vertices.morph_targets)
            if assembly.has_morph_shape:
                raise GeometryAssemblyError.MorphTargetCountMismatch if assembly.morph_target_count != primitive.vertices.morph_targets.count
                raise GeometryAssemblyError.InconsistentMorphNormalStreams if assembly.morph_normals_present != has_morph_normals

            raise GeometryAssemblyError.IndexBudgetExceeded if assembly.index_count > assembly.index_budget
            raise GeometryAssemblyError.IndexBudgetExceeded if primitive.triangles.count > assembly.index_budget - assembly.index_count

            block_index: mutable usize = assembly.blocks.count
            for ordinal in 0..<assembly.blocks.count |assembly, primitive, block_index|:
                prior: GeometryBlock = assembly.blocks[ordinal]
                if prior.source_key.position_accessor == primitive.source_key.position_accessor:
                    raise GeometryAssemblyError.SharedPositionAttributesDiffer if not vertex_source_keys_equal(prior.source_key, primitive.source_key)
                    raise GeometryAssemblyError.SourceIdentityCountMismatch if prior.vertices.count != primitive.vertices.count
                    block_index <- ordinal

            indices: mutable darray[u32] = []
            if block_index == assembly.blocks.count:
                raise GeometryAssemblyError.VertexBudgetExceeded if assembly.source_vertex_count > assembly.vertex_budget
                raise GeometryAssemblyError.VertexBudgetExceeded if primitive.vertices.count > assembly.vertex_budget - assembly.source_vertex_count
                placed: TrianglePrimitive = try transform_triangle_primitive(primitive, assembly.matrix) else failure:
                    _ = failure
                    raise GeometryAssemblyError.PlacementTransformFailed
                placed_vertices: VertexStreams = try geometry_assembly_bind_skin_streams(placed.vertices, assembly.skin_binding)
                indices <- placed.triangles
                assembly.blocks.push(GeometryBlock{
                    vertices: placed_vertices,
                    triangles: [],
                    source_key: primitive.source_key
                })
                block_index <- assembly.blocks.count - 1
                assembly.source_vertex_count <- assembly.source_vertex_count + primitive.vertices.count
            else:
                try geometry_assembly_validate_skin_vertex_binding(primitive.vertices, assembly.skin_binding)
                indices <- try placed_indices(primitive.triangles, assembly.matrix) else failure:
                    _ = failure
                    raise GeometryAssemblyError.IndexPlacementFailed

            for index in indices |assembly, block_index|:
                assembly.blocks[block_index].triangles.push(index)
            assembly.primitives.push(PlacedPrimitive{
                block_index: block_index,
                indices: indices,
                material_index: material_index
            })
            assembly.index_count <- assembly.index_count + primitive.triangles.count
            if not assembly.has_morph_shape:
                assembly.has_morph_shape <- true
                assembly.morph_target_count <- primitive.vertices.morph_targets.count
                assembly.morph_normals_present <- has_morph_normals


        # Cache-backed path used by document cookers. A repeated source key
        # reads only the cached vertex metadata and this primitive's indices;
        # it does not copy cached vertex streams just to append a draw.
        def append_cached_placement_primitive(assembly: mutable PlacementAssembly&, cache: VertexSourceCache&, primitive: CachedTrianglePrimitive, material_index: usize) void error[GeometryAssemblyError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            try geometry_assembly_validate_skin_binding(assembly.skin_binding)
            raise GeometryAssemblyError.InvalidCacheReference if primitive.cache_entry_index >= cache.entries.count
            entry_index: usize = primitive.cache_entry_index
            raise GeometryAssemblyError.InvalidSourceKey if not vertex_source_keys_equal(cache.entries[entry_index].key, primitive.source_key)
            source_count: usize = cache.entries[entry_index].vertices.count
            raise GeometryAssemblyError.SourceIdentityCountMismatch if source_count != primitive.vertex_count
            raise GeometryAssemblyError.InvalidSourceKey if not geometry_assembly_valid_source_key(primitive.source_key)

            block_index: mutable usize = assembly.blocks.count
            for ordinal in 0..<assembly.blocks.count |assembly, primitive, block_index|:
                prior: GeometryBlock = assembly.blocks[ordinal]
                if prior.source_key.position_accessor == primitive.source_key.position_accessor:
                    raise GeometryAssemblyError.SharedPositionAttributesDiffer if not vertex_source_keys_equal(prior.source_key, primitive.source_key)
                    raise GeometryAssemblyError.SourceIdentityCountMismatch if prior.vertices.count != source_count
                    block_index <- ordinal

            if block_index == assembly.blocks.count:
                source_primitive: TrianglePrimitive = TrianglePrimitive{
                    vertices: cache.entries[entry_index].vertices,
                    triangles: primitive.triangles,
                    source_key: primitive.source_key
                }
                try append_placement_primitive(assembly, source_primitive, material_index)
                return

            raise GeometryAssemblyError.InvalidBudget if assembly.vertex_budget > Limits::MAX_VERTICES or assembly.index_budget > Limits::MAX_INDICES
            raise GeometryAssemblyError.InvalidBudget if assembly.source_vertex_count > assembly.vertex_budget or assembly.index_count > assembly.index_budget
            raise GeometryAssemblyError.PrimitiveCountOutOfRange if assembly.primitives.count >= Limits::MAX_PRIMITIVES
            raise GeometryAssemblyError.InvalidPrimitive if primitive.triangles.count < 3 or primitive.triangles.count % 3 != 0 or primitive.triangles.count > Limits::MAX_INDICES
            raise GeometryAssemblyError.IndexBudgetExceeded if primitive.triangles.count > assembly.index_budget - assembly.index_count

            morph_count: usize = cache.entries[entry_index].vertices.morph_targets.count
            raise GeometryAssemblyError.InvalidPrimitive if morph_count > Limits::MAX_MORPH_TARGETS
            raise GeometryAssemblyError.InvalidSourceKey if primitive.source_key.morph_targets.count != morph_count
            morph_normals_present: mutable bool = false
            if morph_count > 0:
                morph_normals_present <- cache.entries[entry_index].vertices.morph_targets[0].has_normals
            raise GeometryAssemblyError.MorphTargetCountMismatch if assembly.has_morph_shape and assembly.morph_target_count != morph_count
            raise GeometryAssemblyError.InconsistentMorphNormalStreams if assembly.has_morph_shape and assembly.morph_normals_present != morph_normals_present
            for ordinal in 0..<morph_count |cache, entry_index, primitive, source_count, morph_normals_present|:
                target: MorphTargetStreams = cache.entries[entry_index].vertices.morph_targets[ordinal]
                target_key: MorphSourceKey = primitive.source_key.morph_targets[ordinal]
                raise GeometryAssemblyError.InconsistentMorphNormalStreams if target.has_normals != morph_normals_present
                raise GeometryAssemblyError.InvalidPrimitive if target.positions.count != source_count * 12
                raise GeometryAssemblyError.InvalidPrimitive if target.has_normals and target.normals.count != source_count * 12
                raise GeometryAssemblyError.InvalidPrimitive if not target.has_normals and target.normals.count != 0
                raise GeometryAssemblyError.InvalidSourceKey if (target_key.normal_accessor >= 0) != target.has_normals

            for index in primitive.triangles |primitive, source_count|:
                raise GeometryAssemblyError.InvalidPrimitive if index.usize() >= source_count
            indices: darray[u32] = try placed_indices(primitive.triangles, assembly.matrix) else failure:
                _ = failure
                raise GeometryAssemblyError.IndexPlacementFailed
            for index in indices |assembly, block_index|:
                assembly.blocks[block_index].triangles.push(index)
            assembly.primitives.push(PlacedPrimitive{
                block_index: block_index,
                indices: indices,
                material_index: material_index
            })
            assembly.index_count <- assembly.index_count + primitive.triangles.count
            if not assembly.has_morph_shape:
                assembly.has_morph_shape <- true
                assembly.morph_target_count <- morph_count
                assembly.morph_normals_present <- morph_normals_present


    private:
        def geometry_assembly_validate_primitive(primitive: TrianglePrimitive) void error[GeometryAssemblyError]:
            vertices: VertexStreams = primitive.vertices
            count: usize = vertices.count
            raise GeometryAssemblyError.InvalidPrimitive if count == 0 or count > Limits::MAX_VERTICES
            raise GeometryAssemblyError.InvalidPrimitive if vertices.positions.count != count * 12
            raise GeometryAssemblyError.InvalidPrimitive if vertices.uvs.count != count * 8
            raise GeometryAssemblyError.InvalidPrimitive if vertices.has_normals and vertices.normals.count != count * 12
            raise GeometryAssemblyError.InvalidPrimitive if not vertices.has_normals and vertices.normals.count != 0
            raise GeometryAssemblyError.InvalidPrimitive if vertices.has_tangents and vertices.tangents.count != count * 16
            raise GeometryAssemblyError.InvalidPrimitive if not vertices.has_tangents and vertices.tangents.count != 0
            raise GeometryAssemblyError.InvalidPrimitive if vertices.has_uv1s and vertices.uv1s.count != count * 8
            raise GeometryAssemblyError.InvalidPrimitive if not vertices.has_uv1s and vertices.uv1s.count != 0
            raise GeometryAssemblyError.InvalidPrimitive if vertices.has_tangents and not vertices.has_normals
            raise GeometryAssemblyError.InvalidPrimitive if vertices.has_skin and (vertices.skin.joints.count != count * 4 or vertices.skin.weights.count != count * 4)
            raise GeometryAssemblyError.InvalidPrimitive if not vertices.has_skin and (vertices.skin.joints.count != 0 or vertices.skin.weights.count != 0)
            raise GeometryAssemblyError.InvalidPrimitive if vertices.morph_targets.count > Limits::MAX_MORPH_TARGETS
            raise GeometryAssemblyError.InvalidPrimitive if primitive.triangles.count < 3 or primitive.triangles.count % 3 != 0 or primitive.triangles.count > Limits::MAX_INDICES
            raise GeometryAssemblyError.InvalidSourceKey if not geometry_assembly_valid_source_key(primitive.source_key)
            raise GeometryAssemblyError.InvalidSourceKey if (primitive.source_key.normal_accessor >= 0) != vertices.has_normals
            raise GeometryAssemblyError.InvalidSourceKey if (primitive.source_key.tangent_accessor >= 0) != vertices.has_tangents
            raise GeometryAssemblyError.InvalidSourceKey if (primitive.source_key.uv1_accessor >= 0) != vertices.has_uv1s
            raise GeometryAssemblyError.InvalidSourceKey if (primitive.source_key.joints0_accessor >= 0) != vertices.has_skin
            raise GeometryAssemblyError.InvalidSourceKey if (primitive.source_key.weights0_accessor >= 0) != vertices.has_skin
            raise GeometryAssemblyError.InvalidSourceKey if primitive.source_key.morph_targets.count != vertices.morph_targets.count
            has_morph_normals: mutable bool = false
            if vertices.morph_targets.count > 0:
                has_morph_normals <- vertices.morph_targets[0].has_normals
            for ordinal in 0..<vertices.morph_targets.count |vertices, primitive|:
                target: MorphTargetStreams = vertices.morph_targets[ordinal]
                target_key: MorphSourceKey = primitive.source_key.morph_targets[ordinal]
                raise GeometryAssemblyError.InconsistentMorphNormalStreams if target.has_normals != has_morph_normals
                raise GeometryAssemblyError.InvalidPrimitive if target.positions.count != count * 12
                raise GeometryAssemblyError.InvalidPrimitive if target.has_normals and target.normals.count != count * 12
                raise GeometryAssemblyError.InvalidPrimitive if not target.has_normals and target.normals.count != 0
                raise GeometryAssemblyError.InvalidSourceKey if (target_key.normal_accessor >= 0) != target.has_normals
            for index in primitive.triangles |primitive, count|:
                raise GeometryAssemblyError.InvalidPrimitive if index.usize() >= count


        def geometry_assembly_effective_transform(placement: MeshPlacement) Affine3x4:
            return Affine3x4{m00: 1.0, m11: 1.0, m22: 1.0} if placement.has_skin
            return placement.world_transform


        def geometry_assembly_validate_skin_binding(binding: PlacementSkinBinding) void error[GeometryAssemblyError]:
            if binding.kind == PlacementSkinBindingKind.Unskinned:
                raise GeometryAssemblyError.InvalidSkinPalette if binding.palette_offset != 0 or binding.palette_count != 0
                return
            raise GeometryAssemblyError.InvalidSkinPalette if binding.palette_count == 0
            raise GeometryAssemblyError.InvalidSkinPalette if binding.palette_offset > EsEngineGltfSkin::Limits::MAX_JOINTS
            raise GeometryAssemblyError.InvalidSkinPalette if binding.palette_count > EsEngineGltfSkin::Limits::MAX_JOINTS - binding.palette_offset
            raise GeometryAssemblyError.InvalidSkinPalette if binding.kind == PlacementSkinBindingKind.Static and binding.palette_count != 1


        def geometry_assembly_validate_placement_skin_binding(placement: MeshPlacement, binding: PlacementSkinBinding) void error[GeometryAssemblyError]:
            try geometry_assembly_validate_skin_binding(binding)
            raise GeometryAssemblyError.SkinBindingMismatch if placement.has_skin and binding.kind != PlacementSkinBindingKind.Palette
            raise GeometryAssemblyError.SkinBindingMismatch if not placement.has_skin and binding.kind == PlacementSkinBindingKind.Palette


        def geometry_assembly_bind_skin_streams(vertices: VertexStreams, binding: PlacementSkinBinding) VertexStreams error[GeometryAssemblyError] can[Memory.Allocate, Abort.Panic]:
            try geometry_assembly_validate_skin_vertex_binding(vertices, binding)
            if binding.kind == PlacementSkinBindingKind.Unskinned:
                return vertices

            joints: mutable darray[u32] = []
            weights: mutable darray[f32] = []
            if binding.kind == PlacementSkinBindingKind.Static:
                for _ in 0..<vertices.count |joints, binding|:
                    for lane in 0..<EsEngineGltfSkin::Limits::WEIGHTS_PER_VERTEX |joints, binding|:
                        joints.push(binding.palette_offset.u32())
                        weight: f32 = 0.0f32
                        if lane == 0:
                            weight <- 1.0f32
                        weights.push(weight)
            else:
                for joint in vertices.skin.joints |joints, binding|:
                    joints.push((binding.palette_offset + joint.usize()).u32())
                weights <- vertices.skin.weights

            return VertexStreams{
                positions: vertices.positions,
                has_normals: vertices.has_normals,
                normals: vertices.normals,
                has_tangents: vertices.has_tangents,
                tangents: vertices.tangents,
                uvs: vertices.uvs,
                has_uv1s: vertices.has_uv1s,
                uv1s: vertices.uv1s,
                has_skin: true,
                skin: EsEngineGltfSkin::SkinInfluences{joints: joints, weights: weights},
                morph_targets: vertices.morph_targets,
                count: vertices.count,
                triangles: vertices.triangles
            }


        def geometry_assembly_validate_skin_vertex_binding(vertices: VertexStreams, binding: PlacementSkinBinding) void error[GeometryAssemblyError] can[Abort.Panic]:
            try geometry_assembly_validate_skin_binding(binding)
            if binding.kind == PlacementSkinBindingKind.Unskinned or binding.kind == PlacementSkinBindingKind.Static:
                raise GeometryAssemblyError.SkinAttributeMismatch if vertices.has_skin
                return
            raise GeometryAssemblyError.SkinAttributeMismatch if not vertices.has_skin
            raise GeometryAssemblyError.SkinAttributeMismatch if vertices.skin.joints.count != vertices.count * EsEngineGltfSkin::Limits::WEIGHTS_PER_VERTEX
            raise GeometryAssemblyError.SkinAttributeMismatch if vertices.skin.weights.count != vertices.count * EsEngineGltfSkin::Limits::WEIGHTS_PER_VERTEX
            for joint in vertices.skin.joints |binding|:
                raise GeometryAssemblyError.SkinJointOutOfPalette if joint.usize() >= binding.palette_count


        def geometry_assembly_valid_source_key(key: VertexSourceKey) bool:
            return false if key.position_accessor < 0
            return false if key.normal_accessor < -1 or key.tangent_accessor < -1
            return false if key.uv0_accessor < -1 or key.uv1_accessor < -1
            return false if key.joints0_accessor < -1 or key.weights0_accessor < -1
            for target in key.morph_targets:
                return false if target.position_accessor < 0 or target.normal_accessor < -1
            return true


        def geometry_assembly_morph_normals_present(targets: darray[MorphTargetStreams]) bool:
            return false if targets.count == 0 or not targets[0].has_normals
            return true
