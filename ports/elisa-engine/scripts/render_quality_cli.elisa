# Stable decimal rendering shared by the engine render-quality command ports.
module EsEngineRenderQualityCli:
    public:
        def fixed_four_decimal(value: f64) -> sview can[Memory.Allocate, Console.Format, Abort.Panic]:
            buffer: mutable u8[32] = zeroed
            length: int = snprintf((&buffer[0]), buffer.count, "%.4f", value)
            panic("render quality float formatting failed") if length < 0 or length.usize() >= buffer.count
            output: mutable dstr = ctx_fstr_alloc(length.usize())
            ctx_fstr_append(output, (&buffer[0]), length.usize())
            return bytes_view(output)
