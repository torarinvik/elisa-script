# Stable decimal rendering shared by the engine render-quality command ports.
module EsEngineRenderQualityCli:
    public:
        def fixed_four_decimal(value: f64) -> sview can[Memory.Allocate, Console.Format, Abort.Panic]:
            # Keep C's four-place rounding, but discard its locale-specific
            # radix bytes and replace them with '.', without mutating process
            # or thread locale state.
            buffer: mutable u8[32] = zeroed
            length: int = snprintf((&buffer[0]), buffer.count, "%.4f", value)
            panic("render quality float formatting failed") if length < 0 or length.usize() >= buffer.count
            negative: bool = buffer[0] == 45u8
            integer_offset: usize = 1 if negative else 0
            formatted_length: usize = length.usize()
            panic("render quality float formatting failed") if formatted_length < integer_offset + 6
            fraction_offset: usize = formatted_length - 4
            separator_offset: usize = integer_offset + 1
            integer_digit: u8 = buffer[integer_offset]
            panic("render quality metric is outside the formatter range") if integer_digit != 48u8 and integer_digit != 49u8
            panic("render quality decimal separator is missing") if fraction_offset <= separator_offset
            for index in separator_offset..<fraction_offset |buffer|:
                panic("render quality metric is outside the formatter range") if buffer[index] >= 48u8 and buffer[index] <= 57u8
            for index in fraction_offset..<formatted_length |buffer|:
                panic("render quality float formatting failed") if buffer[index] < 48u8 or buffer[index] > 57u8

            output_length: usize = 6 if not negative else 7
            output: mutable dstr = ctx_fstr_alloc(output_length)
            if negative:
                ctx_fstr_append(output, (&buffer[0]), 1)
            ctx_fstr_append(output, (&buffer[integer_offset]), 1)
            ctx_fstr_append(output, ".", 1)
            ctx_fstr_append(output, (&buffer[fraction_offset]), 4)
            return bytes_view(output)
