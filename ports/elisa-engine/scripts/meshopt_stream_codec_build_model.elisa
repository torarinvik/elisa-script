# Typed, shell-free recipe for cook_gltf_meshopt_streams._build_cooker().
include "../../../src/runtime/sha256_stream_model.elisa"

using EsSha256Stream


module EsEngineMeshoptCodecBuild:
    public:
        const module Policy:
            DEFAULT_COMPILER: sview = "c++"
            OUTPUT_RELATIVE_PATH: sview = "build/meshopt-stream-cooker"
            STAMP_RELATIVE_PATH: sview = "build/meshopt-stream-cooker.sha256"
            MAX_PATH_BYTES: usize = 4096
            MAX_COMPILER_VERSION_BYTES: usize = 1048576
            MAX_DEVELOPER_DIR_BYTES: usize = 4096


        struct Recipe:
            compiler: sview
            engine_root: Path
            meshopt_root: Path
            source_paths: darray[Path]
            output: Path
            stamp: Path
            arguments: darray[sview]


        error RecipeError:
            InvalidEngineRoot
            InvalidCompiler
            InvalidFingerprintInput
            FingerprintFailed


        def recipe(engine_root: Path, compiler: sview) -> Recipe error[RecipeError] can[Memory.Allocate, Abort.Panic, Console.Format]:
            root_text: sview = f"{engine_root}"
            raise RecipeError.InvalidEngineRoot if root_text == "" or sview_at(root_text, 0) != 47u8 or len(root_text) >= Policy::MAX_PATH_BYTES or sview_contains_byte(root_text, 0u8)
            raise RecipeError.InvalidCompiler if compiler == "" or len(compiler) >= Policy::MAX_PATH_BYTES or sview_contains_byte(compiler, 0u8)

            meshopt_root: Path = engine_root.joinpath("dependencies/meshoptimizer")
            source_paths: darray[Path] = [
                engine_root.joinpath(SourcePaths::COOKER),
                engine_root.joinpath(SourcePaths::CODEC),
                engine_root.joinpath(SourcePaths::CODEC_HEADER),
                engine_root.joinpath(SourcePaths::MESHOPT_HEADER),
                engine_root.joinpath(SourcePaths::INDEX_CODEC),
                engine_root.joinpath(SourcePaths::VERTEX_CODEC)
            ]
            output: Path = engine_root.joinpath(Policy::OUTPUT_RELATIVE_PATH)
            stamp: Path = engine_root.joinpath(Policy::STAMP_RELATIVE_PATH)
            raise RecipeError.InvalidEngineRoot if len(f"{meshopt_root}") >= Policy::MAX_PATH_BYTES or len(f"{output}") >= Policy::MAX_PATH_BYTES or len(f"{stamp}") >= Policy::MAX_PATH_BYTES
            for source in source_paths:
                raise RecipeError.InvalidEngineRoot if len(f"{source}") >= Policy::MAX_PATH_BYTES
            arguments: darray[sview] = [
                "-std=c++17", "-O2", "-DNDEBUG", "-I", f"{meshopt_root}",
                f"{source_paths[0]}", f"{source_paths[1]}", f"{source_paths[4]}", f"{source_paths[5]}",
                "-o", f"{output}"
            ]
            return Recipe{
                compiler: compiler,
                engine_root: engine_root,
                meshopt_root: meshopt_root,
                source_paths: source_paths,
                output: output,
                stamp: stamp,
                arguments: arguments
            }


        def fingerprint_begin(build_recipe: Recipe, compiler_version: sview, developer_dir: sview) -> EsSha256Stream::Context error[RecipeError, Sha256StreamError] can[Memory.Allocate, Abort.Panic]:
            raise RecipeError.InvalidFingerprintInput if len(compiler_version) > Policy::MAX_COMPILER_VERSION_BYTES or len(developer_dir) > Policy::MAX_DEVELOPER_DIR_BYTES

            context: mutable EsSha256Stream::Context = EsSha256Stream::init()
            try EsSha256Stream::update_view(context, build_recipe.compiler)
            try EsSha256Stream::update_view(context, compiler_version)
            try EsSha256Stream::update_view(context, developer_dir)
            return context


        def fingerprint_finish(context: mutable EsSha256Stream::Context&) -> darray[u8] error[RecipeError, Sha256StreamError] can[Memory.Allocate, Abort.Panic]:
            digest: darray[u8] = try EsSha256Stream::finish_hex(context) else failure:
                _ = failure
                raise RecipeError.FingerprintFailed
            return digest


        def fingerprint(build_recipe: Recipe, compiler_version: sview, developer_dir: sview, source_contents: darray[sview]) -> darray[u8] error[RecipeError, Sha256StreamError] can[Memory.Allocate, Abort.Panic]:
            raise RecipeError.InvalidFingerprintInput if source_contents.count != SourcePaths::COUNT
            context: mutable EsSha256Stream::Context = try fingerprint_begin(build_recipe, compiler_version, developer_dir)
            for source in source_contents |context|:
                try EsSha256Stream::update_view(context, source)
            return try fingerprint_finish(context)


    private:
        const module SourcePaths:
            COUNT: usize = 6
            COOKER: sview = "native/meshopt_stream_cooker.cpp"
            CODEC: sview = "native/meshopt_stream_codec.cpp"
            CODEC_HEADER: sview = "native/meshopt_stream_codec.h"
            MESHOPT_HEADER: sview = "dependencies/meshoptimizer/meshoptimizer.h"
            INDEX_CODEC: sview = "dependencies/meshoptimizer/indexcodec.cpp"
            VERTEX_CODEC: sview = "dependencies/meshoptimizer/vertexcodec.cpp"
