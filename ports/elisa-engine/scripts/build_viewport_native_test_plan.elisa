# Typed argv plan for ../elisa-engine/scripts/build_viewport_native_test.sh.
# The caller owns root/environment admission and performs commands in order.
module EsEngineViewportNativeTestBuildPlan:
    public:
        const module Defaults:
            COMPILER: sview = "elisac-stage1"


        const enum CommandKind of u8:
            CompileMetalBridge
            CompileCppFallbacks
            CompileElisaTest
            LinkNativeTest


        const enum ExecutionPhase of u8:
            Prepare
            Execute
            Report
            Done


        struct Command:
            kind: CommandKind
            program: sview
            arguments: darray[sview]


        struct Plan:
            build_directory: sview
            executable_path: sview
            commands: darray[Command]


        struct ExecutionState:
            phase: ExecutionPhase = ExecutionPhase.Prepare
            command_count: usize = 0
            next_command: usize = 0
            exit_status: i64 = 0


        error PlanError:
            MissingTestName
            MissingRuntimeObject
            InvalidExecutionState


        # `root` is the already-resolved Elisa Engine project root. The test
        # name remains a single argv-derived value; its contents are never
        # shell-split or interpolated into a command.
        def plan(root: sview, name: sview, compiler: sview, runtime_object: sview) -> Plan error[PlanError] can[Memory.Allocate, Abort.Panic]:
            raise PlanError.MissingTestName if name == ""
            raise PlanError.MissingRuntimeObject if runtime_object == ""
            selected_compiler: sview = Defaults::COMPILER if compiler == "" else compiler
            build_directory: sview = viewport_build_path(root, "")
            metal_object: sview = viewport_build_path(root, "viewport_metal.o")
            fallback_object: sview = viewport_build_path(root, "elisa_native_fallbacks.o")
            test_object: sview = viewport_build_path(root, name + ".o")
            test_source: sview = viewport_project_path(root, "test/" + name + ".elisa")
            executable_path: sview = viewport_build_path(root, name + "-test")
            return Plan{
                build_directory: build_directory,
                executable_path: executable_path,
                commands: [
                    Command{kind: CommandKind.CompileMetalBridge, program: "clang", arguments: [
                        "-c", "-fobjc-arc", "-O2", "-Wall", "-Wextra", "-Werror",
                        "-o", metal_object, viewport_project_path(root, "native/viewport_metal.m")
                    ]},
                    Command{kind: CommandKind.CompileCppFallbacks, program: "clang++", arguments: [
                        "-c", "-std=c++17", "-O2", "-o", fallback_object,
                        viewport_project_path(root, "native/elisa_native_fallbacks.cpp")
                    ]},
                    Command{kind: CommandKind.CompileElisaTest, program: selected_compiler, arguments: [
                        "-emit", "obj", "-o", test_object, test_source
                    ]},
                    Command{kind: CommandKind.LinkNativeTest, program: "clang", arguments: [
                        "-o", executable_path, test_object, metal_object, fallback_object,
                        runtime_object, "-framework", "Metal", "-framework", "IOSurface",
                        "-framework", "Foundation"
                    ]}
                ]
            }


        def initial_execution(command_count: usize) -> ExecutionState:
            return ExecutionState{phase: ExecutionPhase.Prepare, command_count: command_count}


        def execution_after_prepare(state: ExecutionState, succeeded: bool) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Prepare
            return ExecutionState{phase: ExecutionPhase.Done, command_count: state.command_count, exit_status: 1} if not succeeded
            return ExecutionState{phase: ExecutionPhase.Report, command_count: state.command_count} if state.command_count == 0
            return ExecutionState{phase: ExecutionPhase.Execute, command_count: state.command_count}


        def execution_after_command(state: ExecutionState, status: i64) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Execute or state.next_command >= state.command_count
            return ExecutionState{phase: ExecutionPhase.Done, command_count: state.command_count, next_command: state.next_command, exit_status: status} if status != 0
            completed: usize = state.next_command + 1
            next_phase: ExecutionPhase = ExecutionPhase.Report if completed == state.command_count else ExecutionPhase.Execute
            return ExecutionState{phase: next_phase, command_count: state.command_count, next_command: completed}


        def execution_after_report(state: ExecutionState) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Report
            return ExecutionState{phase: ExecutionPhase.Done, command_count: state.command_count, next_command: state.next_command, exit_status: state.exit_status}


    private:
        def viewport_project_path(root: sview, relative: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return "/" + relative if root == "/"
            return root + "/" + relative


        def viewport_build_path(root: sview, leaf: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return "/build" + ("/" + leaf if leaf != "" else "") if root == "/"
            return root + "/build" + ("/" + leaf if leaf != "" else "")
