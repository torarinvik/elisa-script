#!/usr/bin/env elisascript
# Bounded Elisascript counterpart of elisa-engine/scripts/fetch_basisu.py.
include "./fetch_basisu_plan.elisa"
include "../../../src/runtime/process_model.elisa"

using EsProcess


module EsEngineFetchBasisu:
    private:
        const module Limits:
            PROCESS_TIMEOUT_MICROS: i64 = 120000000i64
            PROCESS_OUTPUT_BYTES: i64 = EsProcess::PROCESS_COMMAND_MAX_CAPTURE_OUTPUT_BYTES.i64()


        const enum FetchPhase of u8:
            ResolveRoot
            CheckCheckout
            Clone
            VerifyRevision
            CheckBinary
            Configure
            Build
            ValidateBinary
            ReportReady
            Done


        struct CommandCapture:
            started: bool = false
            status: i64 = 127i64
            stdout: sview = ""
            stderr: sview = ""


        struct FetchState:
            phase: FetchPhase
            checkout: Path
            build_directory: Path
            binary: Path
            command: EsEngineFetchBasisuPlan::Command
            capture: CommandCapture
            exit_status: i64


        def capture_command(command: EsEngineFetchBasisuPlan::Command) -> CommandCapture can[Process.Run, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format]:
            capture: ProcessCapture = try subprocess.capture_result(
                executable(command.program), command.arguments, "", Limits::PROCESS_TIMEOUT_MICROS, Limits::PROCESS_OUTPUT_BYTES
            ) else failure:
                _ = failure
                return CommandCapture{}
            return CommandCapture{
                started: true,
                status: capture.process_exit_status,
                stdout: capture.process_stdout,
                stderr: capture.process_stderr
            }


        def report_command_failure(command: EsEngineFetchBasisuPlan::Command, capture: CommandCapture) -> void can[Console.Write, Memory.Allocate, Abort.Panic, Console.Format]:
            if not capture.started:
                _ = write_stderr("command failed (" + EsEngineFetchBasisuPlan::command_text(command) + "): unable to start command or capture bounded output\n")
                return
            detail: sview = capture.stderr.strip()
            detail <- capture.stdout.strip() if detail == ""
            _ = write_stderr("command failed (" + EsEngineFetchBasisuPlan::command_text(command) + "): " + detail + "\n")


    public:
        def run(arguments: darray[sview]) -> i64 can[Directory.Read, Directory.Write, File.Read, Process.Run, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
            # The Python fetcher ignores argv; preserve that entry-point behavior.
            _ = arguments
            state: mutable FetchState = FetchState{
                phase: FetchPhase.ResolveRoot,
                checkout: path("."),
                build_directory: path("."),
                binary: path("."),
                command: EsEngineFetchBasisuPlan::Command{program: "", arguments: []},
                capture: CommandCapture{},
                exit_status: 1i64
            }

            machine over state while state.phase != FetchPhase.Done:
                state Dispatch
                start Dispatch

                Dispatch, FetchPhase.ResolveRoot:
                    source: Path = try path_real(Script::source_path()) else failure:
                        _ = failure
                        _ = write_stderr("unable to resolve Basis Universal fetcher source path\n")
                        state.phase <- FetchPhase.Done
                        -> Dispatch
                    engine_candidate: Path = source.parent().parent().parent().parent().parent().joinpath("elisa-engine")
                    engine_root: Path = try path_real(engine_candidate) else failure:
                        _ = failure
                        _ = write_stderr("unable to resolve elisa-engine project root\n")
                        state.phase <- FetchPhase.Done
                        -> Dispatch
                    state.checkout <- engine_root.joinpath("dependencies").joinpath("basisu")
                    state.build_directory <- state.checkout.joinpath("build")
                    state.binary <- state.checkout.joinpath("bin").joinpath("basisu")
                    state.phase <- FetchPhase.CheckCheckout
                    -> Dispatch

                Dispatch, FetchPhase.CheckCheckout:
                    metadata: Path = state.checkout.joinpath(".git")
                    checkout_exists: bool = try is_directory(metadata) else false
                    if checkout_exists:
                        state.phase <- FetchPhase.VerifyRevision
                    else:
                        dependencies: Path = state.checkout.parent()
                        created: bool = try create_directories(dependencies) else false
                        if not created:
                            _ = write_stderr("unable to create Basis Universal dependency directory: " + f"{dependencies}" + "\n")
                            state.phase <- FetchPhase.Done
                        else:
                            state.command <- EsEngineFetchBasisuPlan::clone_command(state.checkout)
                            state.phase <- FetchPhase.Clone
                    -> Dispatch

                Dispatch, FetchPhase.Clone:
                    state.capture <- capture_command(state.command)
                    if not state.capture.started or state.capture.status != 0i64:
                        report_command_failure(state.command, state.capture)
                        state.phase <- FetchPhase.Done
                    else:
                        state.phase <- FetchPhase.VerifyRevision
                    -> Dispatch

                Dispatch, FetchPhase.VerifyRevision:
                    state.command <- EsEngineFetchBasisuPlan::revision_command(state.checkout)
                    state.capture <- capture_command(state.command)
                    if not state.capture.started or state.capture.status != 0i64:
                        report_command_failure(state.command, state.capture)
                        state.phase <- FetchPhase.Done
                    else:
                        head: sview = state.capture.stdout.strip()
                        if head != EsEngineFetchBasisuPlan::Dependency::COMMIT:
                            _ = write_stderr(
                                "basis_universal checkout is " + head + ", expected " + EsEngineFetchBasisuPlan::Dependency::COMMIT + "; remove " + f"{state.checkout}" + " and re-run to reset\n"
                            )
                            state.phase <- FetchPhase.Done
                        else:
                            state.phase <- FetchPhase.CheckBinary
                    -> Dispatch

                Dispatch, FetchPhase.CheckBinary:
                    binary_exists: bool = try is_file(state.binary) else false
                    state.phase <- FetchPhase.ReportReady if binary_exists
                    state.phase <- FetchPhase.Configure if not binary_exists
                    -> Dispatch

                Dispatch, FetchPhase.Configure:
                    state.command <- EsEngineFetchBasisuPlan::configure_command(state.checkout, state.build_directory)
                    state.capture <- capture_command(state.command)
                    if not state.capture.started or state.capture.status != 0i64:
                        report_command_failure(state.command, state.capture)
                        state.phase <- FetchPhase.Done
                    else:
                        state.phase <- FetchPhase.Build
                    -> Dispatch

                Dispatch, FetchPhase.Build:
                    state.command <- EsEngineFetchBasisuPlan::build_command(state.build_directory)
                    state.capture <- capture_command(state.command)
                    if not state.capture.started or state.capture.status != 0i64:
                        report_command_failure(state.command, state.capture)
                        state.phase <- FetchPhase.Done
                    else:
                        state.phase <- FetchPhase.ValidateBinary
                    -> Dispatch

                Dispatch, FetchPhase.ValidateBinary:
                    binary_exists: bool = try is_file(state.binary) else false
                    if not binary_exists:
                        _ = write_stderr("basisu build did not produce " + f"{state.binary}" + "\n")
                        state.phase <- FetchPhase.Done
                    else:
                        state.phase <- FetchPhase.ReportReady
                    -> Dispatch

                Dispatch, FetchPhase.ReportReady:
                    short_commit: sview = string_view_slice(EsEngineFetchBasisuPlan::Dependency::COMMIT, 0i64, 12i64)
                    print("basis_universal " + short_commit + " ready:")
                    print("  " + EsEngineFetchBasisuPlan::Dependency::BINARY_RELATIVE_PATH)
                    state.exit_status <- 0i64
                    state.phase <- FetchPhase.Done
                    -> Dispatch

                Dispatch, FetchPhase.Done:
                    break

            return state.exit_status


def main(arguments: darray[sview]) -> i64 can[Directory.Read, Directory.Write, File.Read, Process.Run, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
    return EsEngineFetchBasisu::run(arguments)
