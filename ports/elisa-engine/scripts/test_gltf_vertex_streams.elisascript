#!/usr/bin/env elisascript
# Focused source fixture for typed glTF primitive decoding and placement.
include "./gltf_geometry_assembly_model.elisa"

using EsJson
using EsEngineGltfAffine
using EsEngineGltfAccessor
using EsEngineGltfGeneratedNormals
using EsEngineGltfGeometryAssembly
using EsEngineGltfPrimitivePlacement
using EsEngineGltfVertexStreams


module EsEngineGltfVertexStreamsTest:
    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
            source: sview = "{\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":1,\"componentType\":5121,\"count\":3,\"type\":\"SCALAR\"}],\"bufferViews\":[{\"byteOffset\":0,\"byteLength\":36},{\"byteOffset\":36,\"byteLength\":3}],\"meshes\":[{\"primitives\":[{\"mode\":4.0,\"indices\":1,\"attributes\":{\"POSITION\":0}}]}]}"
            document: JsonDocument = try EsEngineGltfAccessor::parse_document(source) else failure:
                _ = failure
                print("glTF vertex streams: valid fixture did not parse")
                return 1i64
            buffer: mutable darray[u8] = []
            for _ in 0..<36 |buffer|:
                buffer.push(0u8)
            buffer.push(0u8)
            buffer.push(1u8)
            buffer.push(2u8)
            valid_streams: mutable bool = false
            catch read_mesh_primitive_vertex_streams(document, buffer, 0u, 0u):
                ok streams:
                    valid_streams <- streams.count == 3 and streams.positions.count == 36 and not streams.has_normals and not streams.has_tangents and streams.uvs.count == 24 and not streams.has_uv1s and streams.morph_targets.count == 0 and streams.triangles.count == 0
                    for byte in streams.uvs:
                        valid_streams <- false if byte != 0u8
                error failure:
                    _ = failure
            if not valid_streams:
                print("glTF vertex streams: valid primitive did not produce expected packed defaults")
                return 1i64

            triangle_read: mutable bool = false
            catch read_triangle_primitive(document, buffer, 0u, 0u):
                ok primitive:
                    triangle_read <- primitive.vertices.count == 3 and primitive.triangles.count == 3 and primitive.source_key.position_accessor == 0i64 and primitive.source_key.normal_accessor == -1i64 and primitive.source_key.morph_targets.count == 0
                    if triangle_read:
                        triangle_read <- primitive.triangles[0] == 0u32 and primitive.triangles[1] == 1u32 and primitive.triangles[2] == 2u32
                    if triangle_read:
                        triangle_read <- vertex_source_keys_equal(primitive.source_key, primitive.source_key)
                    different_source_key: VertexSourceKey = VertexSourceKey{position_accessor: 0i64, uv0_accessor: 1i64}
                    triangle_read <- false if vertex_source_keys_equal(primitive.source_key, different_source_key)
                error failure:
                    _ = failure
            if not triangle_read:
                print("glTF vertex streams: triangle primitive did not decode its index stream")
                return 1i64

            decoded_primitive: mutable TrianglePrimitive = TrianglePrimitive{vertices: VertexStreams{}, triangles: []}
            decoded: mutable bool = false
            catch read_triangle_primitive(document, buffer, 0u, 0u):
                ok primitive:
                    decoded_primitive <- primitive
                    decoded <- true
                error failure:
                    _ = failure
            if not decoded:
                print("glTF vertex streams: placement fixture primitive did not decode")
                return 1i64

            shared_primitives: darray[TrianglePrimitive] = [decoded_primitive, decoded_primitive]
            shared_assembly: mutable PlacementAssembly = PlacementAssembly{
                matrix: Affine3x4{m00: 1.0, m11: 1.0, m22: 1.0, m03: 2.0, m13: 3.0, m23: 4.0},
                vertex_budget: EsEngineGltfGeometryAssembly::Limits::MAX_VERTICES,
                index_budget: EsEngineGltfGeometryAssembly::Limits::MAX_INDICES
            }
            aggregate_correct: mutable bool = false
            catch append_placement_primitive(shared_assembly, shared_primitives[0], 2u):
                ok _:
                    catch append_placement_primitive(shared_assembly, shared_primitives[1], 4u):
                        ok _:
                            aggregate_correct <- shared_assembly.blocks.count == 1 and shared_assembly.primitives.count == 2 and shared_assembly.source_vertex_count == 3 and shared_assembly.index_count == 6 and shared_assembly.blocks[0].triangles.count == 6
                        error failure:
                            _ = failure
                error failure:
                    _ = failure
            if aggregate_correct:
                aggregate_correct <- shared_assembly.primitives[0].block_index == 0u and shared_assembly.primitives[1].block_index == 0u and shared_assembly.primitives[0].material_index == 2u and shared_assembly.primitives[1].material_index == 4u
            if not aggregate_correct:
                print("glTF vertex streams: repeated accessor sources did not share one transformed geometry block")
                return 1i64

            conflicting_primitive: TrianglePrimitive = TrianglePrimitive{
                vertices: decoded_primitive.vertices,
                triangles: decoded_primitive.triangles,
                source_key: VertexSourceKey{position_accessor: 0i64, uv0_accessor: 1i64}
            }
            conflict_assembly: mutable PlacementAssembly = PlacementAssembly{
                matrix: Affine3x4{m00: 1.0, m11: 1.0, m22: 1.0},
                vertex_budget: EsEngineGltfGeometryAssembly::Limits::MAX_VERTICES,
                index_budget: EsEngineGltfGeometryAssembly::Limits::MAX_INDICES
            }
            rejected_shared_position_mismatch: mutable bool = false
            catch append_placement_primitive(conflict_assembly, decoded_primitive, 0u):
                ok _:
                    catch append_placement_primitive(conflict_assembly, conflicting_primitive, 0u):
                        ok _:
                            _ = _
                        error failure:
                            rejected_shared_position_mismatch <- failure == GeometryAssemblyError.SharedPositionAttributesDiffer
                error failure:
                    _ = failure
            if not rejected_shared_position_mismatch:
                print("glTF vertex streams: same POSITION with different attribute accessors was not rejected")
                return 1i64

            translation: Affine3x4 = Affine3x4{m00: 1.0, m11: 1.0, m22: 1.0, m03: 2.0, m13: 3.0, m23: 4.0}
            expected_vertex_bytes: darray[u8] = [0u8, 0u8, 0u8, 64u8, 0u8, 0u8, 64u8, 64u8, 0u8, 0u8, 128u8, 64u8]
            expected_position_bytes: mutable darray[u8] = []
            for _ in 0..<3 |expected_vertex_bytes, expected_position_bytes|:
                for byte in expected_vertex_bytes |expected_position_bytes|:
                    expected_position_bytes.push(byte)
            placement_correct: mutable bool = false
            catch transform_triangle_primitive(decoded_primitive, translation):
                ok placed:
                    placement_correct <- placed.vertices.positions.count == expected_position_bytes.count and placed.vertices.uvs.count == decoded_primitive.vertices.uvs.count and placed.triangles.count == decoded_primitive.triangles.count and vertex_source_keys_equal(placed.source_key, decoded_primitive.source_key)
                    if placement_correct:
                        for offset in 0..<expected_position_bytes.count |placed, expected_position_bytes|:
                            placement_correct <- false if placed.vertices.positions[offset] != expected_position_bytes[offset]
                    for offset in 0..<placed.vertices.uvs.count |placed|:
                        placement_correct <- false if placed.vertices.uvs[offset] != 0u8
                    if placement_correct:
                        for ordinal in 0..<placed.triangles.count |placed|:
                            placement_correct <- false if placed.triangles[ordinal] != decoded_primitive.triangles[ordinal]
                error failure:
                    _ = failure
            if not placement_correct:
                print("glTF vertex streams: affine placement did not preserve expected transformed/default streams")
                return 1i64

            mirror: Affine3x4 = Affine3x4{m00: -1.0, m11: 1.0, m22: 1.0}
            mirrored_winding: mutable bool = false
            catch transform_triangle_primitive(decoded_primitive, mirror):
                ok placed:
                    mirrored_winding <- placed.triangles.count == 3
                    if mirrored_winding:
                        mirrored_winding <- placed.triangles[0] == 0u32 and placed.triangles[1] == 2u32 and placed.triangles[2] == 1u32
                error failure:
                    _ = failure
            if not mirrored_winding:
                print("glTF vertex streams: mirrored placement did not reverse triangle winding")
                return 1i64

            normal_positions: darray[u8] = [
                0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                0u8, 0u8, 128u8, 63u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 128u8, 63u8, 0u8, 0u8, 0u8, 0u8
            ]
            normal_indices: darray[u32] = [0u32, 1u32, 2u32]
            expected_normal_vertex: darray[u8] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 128u8, 63u8]
            expected_normals: mutable darray[u8] = []
            for _ in 0..<3 |expected_normal_vertex, expected_normals|:
                for byte in expected_normal_vertex |expected_normals|:
                    expected_normals.push(byte)
            generated_normals_correct: mutable bool = false
            catch generate_vertex_normals(normal_positions, 3u, normal_indices):
                ok generated:
                    generated_normals_correct <- generated.count == expected_normals.count
                    if generated_normals_correct:
                        for offset in 0..<expected_normals.count |generated, expected_normals|:
                            generated_normals_correct <- false if generated[offset] != expected_normals[offset]
                error failure:
                    _ = failure
            if not generated_normals_correct:
                print("glTF vertex streams: area-weighted generated normals differ from the triangle reference")
                return 1i64

            normal_block: GeometryBlock = GeometryBlock{
                vertices: VertexStreams{positions: normal_positions, count: 3u},
                triangles: normal_indices
            }
            block_normals_correct: mutable bool = false
            catch generate_block_normals(normal_block):
                ok block:
                    block_normals_correct <- block.vertices.has_normals and block.vertices.normals.count == expected_normals.count
                    if block_normals_correct:
                        for offset in 0..<expected_normals.count |block, expected_normals|:
                            block_normals_correct <- false if block.vertices.normals[offset] != expected_normals[offset]
                error failure:
                    _ = failure
            if not block_normals_correct:
                print("glTF vertex streams: placement block did not receive generated normals")
                return 1i64

            degenerate_positions: mutable darray[u8] = []
            for _ in 0..<36 |degenerate_positions|:
                degenerate_positions.push(0u8)
            rejected_degenerate_vertex: mutable bool = false
            catch generate_vertex_normals(degenerate_positions, 3u, normal_indices):
                ok generated:
                    _ = generated
                error failure:
                    rejected_degenerate_vertex <- failure == GeneratedNormalsError.DegenerateVertex
            if not rejected_degenerate_vertex:
                print("glTF vertex streams: degenerate generated-normal input was not rejected")
                return 1i64

            out_of_range_buffer: mutable darray[u8] = []
            for _ in 0..<36 |out_of_range_buffer|:
                out_of_range_buffer.push(0u8)
            out_of_range_buffer.push(0u8)
            out_of_range_buffer.push(3u8)
            out_of_range_buffer.push(0u8)
            rejected_index: mutable bool = false
            catch read_triangle_primitive(document, out_of_range_buffer, 0u, 0u):
                ok primitive:
                    _ = primitive
                error failure:
                    rejected_index <- failure == VertexStreamError.IndexOutOfRange
            if not rejected_index:
                print("glTF vertex streams: out-of-range triangle index was not rejected")
                return 1i64

            missing_indices_source: sview = "{\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":1,\"type\":\"VEC3\"}],\"bufferViews\":[{\"byteOffset\":0,\"byteLength\":12}],\"meshes\":[{\"primitives\":[{\"attributes\":{\"POSITION\":0}}]}]}"
            missing_indices_document: JsonDocument = try EsEngineGltfAccessor::parse_document(missing_indices_source) else failure:
                _ = failure
                print("glTF vertex streams: missing-indices fixture did not parse")
                return 1i64
            rejected_missing_indices: mutable bool = false
            catch read_triangle_primitive(missing_indices_document, buffer, 0u, 0u):
                ok primitive:
                    _ = primitive
                error failure:
                    rejected_missing_indices <- failure == VertexStreamError.MissingIndices
            if not rejected_missing_indices:
                print("glTF vertex streams: missing indices did not report MissingIndices")
                return 1i64

            missing_position_source: sview = "{\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":1,\"type\":\"VEC3\"}],\"bufferViews\":[{\"byteOffset\":0,\"byteLength\":12}],\"meshes\":[{\"primitives\":[{\"attributes\":{}}]}]}"
            missing_document: JsonDocument = try EsEngineGltfAccessor::parse_document(missing_position_source) else failure:
                _ = failure
                print("glTF vertex streams: missing-position fixture did not parse")
                return 1i64
            rejected_missing_position: mutable bool = false
            catch read_mesh_primitive_vertex_streams(missing_document, buffer, 0u, 0u):
                ok streams:
                    _ = streams
                error failure:
                    rejected_missing_position <- failure == VertexStreamError.MissingPositions
            if not rejected_missing_position:
                print("glTF vertex streams: missing POSITION did not report MissingPositions")
                return 1i64
            print("glTF vertex stream source fixtures passed.")
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
    _ = arguments
    return EsEngineGltfVertexStreamsTest::run()
