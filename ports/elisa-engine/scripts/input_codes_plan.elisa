# Typed compiler argv and fail-fast transitions for ../elisa-engine/scripts/test_input_codes.py.
module EsEngineInputCodesPlan:
    public:
        const module Defaults:
            COMPILER: sview = "clang++"
            TEMP_PREFIX: sview = "elisa-input-codes-"
            EXECUTABLE_NAME: sview = "input-codes"
            CXX_STANDARD: sview = "-std=c++17"
            INCLUDE_FLAG: sview = "-I"
            OUTPUT_FLAG: sview = "-o"
            NATIVE_INCLUDE: sview = "native"
            GAMEPAD_TEST: sview = "test/application_gamepad_codes.cpp"


        const enum ExecutionPhase of u8:
            Compile
            Run
            Cleanup
            ReportSuccess
            Done


        struct Command:
            program: sview
            arguments: darray[sview]


        struct Plan:
            executable_path: sview
            compile_command: Command


        struct ExecutionState:
            phase: ExecutionPhase = ExecutionPhase.Compile
            exit_status: i64 = 0
            report_success_after_cleanup: bool = false


        error PlanError:
            InvalidExecutionState


        def plan(root: sview, temporary_directory: sview, compiler: sview, sdl_include: sview) -> Plan can[Memory.Allocate, Abort.Panic]:
            executable_path: sview = project_path(temporary_directory, Defaults::EXECUTABLE_NAME)
            return Plan{
                executable_path: executable_path,
                compile_command: Command{
                    program: compiler,
                    arguments: [
                        Defaults::CXX_STANDARD, Defaults::INCLUDE_FLAG, sdl_include,
                        Defaults::INCLUDE_FLAG, project_path(root, Defaults::NATIVE_INCLUDE),
                        project_path(root, Defaults::GAMEPAD_TEST),
                        Defaults::OUTPUT_FLAG, executable_path
                    ]
                }
            }


        def initial_execution() -> ExecutionState:
            return ExecutionState{phase: ExecutionPhase.Compile}


        def execution_after_compile(state: ExecutionState, status: i64) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Compile
            return ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: status} if status != 0
            return ExecutionState{phase: ExecutionPhase.Run}


        def execution_after_run(state: ExecutionState, status: i64) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Run
            return ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: status} if status != 0
            return ExecutionState{phase: ExecutionPhase.Cleanup, report_success_after_cleanup: true}


        def execution_after_cleanup(state: ExecutionState, succeeded: bool) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Cleanup
            return ExecutionState{phase: ExecutionPhase.Done, exit_status: 1} if not succeeded
            return ExecutionState{phase: ExecutionPhase.ReportSuccess} if state.report_success_after_cleanup
            return ExecutionState{phase: ExecutionPhase.Done, exit_status: state.exit_status}


        def execution_after_success_report(state: ExecutionState) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.ReportSuccess
            return ExecutionState{phase: ExecutionPhase.Done, exit_status: state.exit_status}


    private:
        def project_path(root: sview, relative: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return relative if root == ""
            return "/" + relative if root == "/"
            return root + "/" + relative
