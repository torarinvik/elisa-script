#!/usr/bin/env elisascript
# Typed port of elisa-engine/scripts/compare_postprocess_references.py.
include "./postprocess_reference_model.elisa"
include "./png_image.elisa"
include "./render_quality_cli.elisa"

using EsEngineRenderQuality
using EsEnginePostprocessReferences
using EsEnginePngImage
using EsEngineRenderQualityCli


module EsEnginePostprocessReferenceCli:
    private:
        error ImageLoadError:
            ReadFailed(sview)
            DecodeFailed(sview)


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def load_image(image_path: Path) -> RenderFrame error[ImageLoadError] can[File.Read, Memory.Allocate, Abort.Panic, Console.Format]:
            bytes: darray[u8] = try read_bytes(f"{image_path}") else failure:
                _ = failure
                raise ImageLoadError.ReadFailed(f"{image_path}")
            frame: RenderFrame = try EsEngineRenderQuality::decode_png(bytes) else failure:
                _ = failure
                raise ImageLoadError.DecodeFailed(f"{image_path}")
            return frame


        def write_reference(frame: RenderFrame&, destination: Path) -> bool can[Directory.Write, File.Write, Memory.Allocate, Abort.Panic, Console.Format]:
            rgba_frame: mutable RenderFrame = RenderFrame{width: 0, height: 0, format: RenderPixelFormat.Rgb8, pixels: []}
            catch EsEnginePostprocessReferences::reference_rgba_frame(frame):
                ok converted:
                    rgba_frame <- converted
                error failure:
                    _ = failure
                    return false

            encoded: mutable darray[u8] = []
            catch EsEnginePngImage::encode_png(
                rgba_frame.width.i64(), rgba_frame.height.i64(), rgba_frame.pixels
            ):
                ok png:
                    encoded <- png
                error failure:
                    _ = failure
                    return false

            parent: Path = destination.parent()
            created: bool = try create_directories(parent) else failure:
                _ = failure
                false
            if not created:
                return false
            temporary: Path = destination.with_name(destination.name() + ".tmp")
            written: usize = try write_bytes(f"{temporary}", encoded) else failure:
                _ = failure
                0usize
            if written != encoded.count:
                return false
            published: bool = try move_path(f"{temporary}", f"{destination}") else failure:
                _ = failure
                false
            return published


    public:
        def run(arguments: darray[sview]) -> i64 can[Directory.Read, Directory.Write, File.Read, File.Write, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            source: Path = try path_real(Script::source_path()) else failure:
                _ = failure
                diagnostic("unable to resolve post-process comparator source path")
                return 2i64
            project_root_path: Path = source.parent().parent().parent().parent().parent().joinpath("elisa-engine")
            project_root: Path = try path_real(project_root_path) else failure:
                _ = failure
                diagnostic("unable to resolve elisa-engine project root")
                return 2i64

            options: mutable CliOptions = CliOptions{capture_directory: "", reference_directory: ""}
            catch EsEnginePostprocessReferences::parse_arguments(arguments, f"{project_root}"):
                ok parsed:
                    options <- parsed
                error failure:
                    match failure:
                        CliError.MissingOptionValue(option):
                            diagnostic("argument " + option + ": expected one argument")
                        CliError.UnknownOption(option):
                            diagnostic("unrecognized argument: " + option)
                        CliError.UnexpectedArgument(argument):
                            diagnostic("unrecognized argument: " + argument)
                    diagnostic("usage: compare_postprocess_references.elisascript [--capture-dir DIR] [--reference-dir DIR] [--update]")
                    return 2i64

            if options.help:
                _ = write_stdout("usage: compare_postprocess_references.elisascript [--capture-dir DIR] [--reference-dir DIR] [--update]\n")
                return 0i64

            captures: darray[CaptureSpec] = EsEnginePostprocessReferences::capture_specs()
            index: mutable usize = 0
            machine over index while index < captures.count:
                state CompareCapture
                start CompareCapture

                CompareCapture:
                    spec: CaptureSpec = captures[index]
                    capture_path: Path = path(options.capture_directory).joinpath(spec.filename)
                    capture_exists: bool = try is_file(capture_path) else false
                    if not capture_exists:
                        diagnostic("post-process reference comparison failed: post-process capture is missing: " + f"{capture_path}")
                        return 2i64
                    capture: mutable RenderFrame = RenderFrame{width: 0, height: 0, format: RenderPixelFormat.Rgb8, pixels: []}
                    catch EsEnginePostprocessReferenceCli::load_image(capture_path):
                        ok loaded:
                            capture <- loaded
                        error failure:
                            match failure:
                                ImageLoadError.ReadFailed(image_path):
                                    diagnostic("post-process reference comparison failed: unable to read image: " + image_path)
                                ImageLoadError.DecodeFailed(image_path):
                                    diagnostic("post-process reference comparison failed: invalid PNG image: " + image_path)
                            return 2i64

                    if options.update:
                        reference_path: Path = path(options.reference_directory).joinpath(spec.name + ".png")
                        updated: bool = EsEnginePostprocessReferenceCli::write_reference(
                            capture, reference_path
                        )
                        if not updated:
                            diagnostic("post-process reference comparison failed: unable to update reference for " + spec.name)
                            return 2i64
                        _ = write_stdout("Updated " + f"{reference_path}" + "\n")
                    else:
                        reference_path: Path = path(options.reference_directory).joinpath(spec.name + ".png")
                        reference_exists: bool = try is_file(reference_path) else false
                        if not reference_exists:
                            diagnostic("post-process reference comparison failed: post-process reference is missing: " + f"{reference_path}")
                            return 2i64
                        reference: mutable RenderFrame = RenderFrame{width: 0, height: 0, format: RenderPixelFormat.Rgb8, pixels: []}
                        catch EsEnginePostprocessReferenceCli::load_image(reference_path):
                            ok loaded:
                                reference <- loaded
                            error failure:
                                match failure:
                                    ImageLoadError.ReadFailed(image_path):
                                        diagnostic("post-process reference comparison failed: unable to read image: " + image_path)
                                    ImageLoadError.DecodeFailed(image_path):
                                        diagnostic("post-process reference comparison failed: invalid PNG image: " + image_path)
                                return 2i64
                        if reference.width != EsEnginePostprocessReferences::Policy::REFERENCE_WIDTH or reference.height != EsEnginePostprocessReferences::Policy::REFERENCE_HEIGHT:
                            diagnostic("post-process reference comparison failed: " + f"{reference_path}" + " must be 160x100")
                            return 2i64
                        reduced_capture: RenderFrame = try EsEnginePostprocessReferences::resample_nearest(
                            capture, EsEnginePostprocessReferences::Policy::REFERENCE_WIDTH, EsEnginePostprocessReferences::Policy::REFERENCE_HEIGHT
                        ) else failure:
                            _ = failure
                            diagnostic("post-process reference comparison failed: invalid capture frame")
                            return 2i64
                        filtered_capture: RenderFrame = try EsEnginePostprocessReferences::filter_temporal_edges(reduced_capture) else failure:
                            _ = failure
                            diagnostic("post-process reference comparison failed: unable to filter capture")
                            return 2i64
                        filtered_reference: RenderFrame = try EsEnginePostprocessReferences::filter_temporal_edges(reference) else failure:
                            _ = failure
                            diagnostic("post-process reference comparison failed: unable to filter reference")
                            return 2i64
                        metrics: ImageMetrics = try EsEnginePostprocessReferences::compare_frames(
                            filtered_capture, filtered_reference
                        ) else failure:
                            _ = failure
                            diagnostic("post-process reference comparison failed: frames have incompatible sizes")
                            return 2i64
                        outcome: sview = "PASS" if metrics.passes else "FAIL"
                        _ = write_stdout(f"{outcome} postprocess-{spec.name}: peak={EsEngineRenderQualityCli::fixed_four_decimal(metrics.peak)} mean={EsEngineRenderQualityCli::fixed_four_decimal(metrics.mean)}\n")
                        if not metrics.passes:
                            return 1i64

                    index <- index + 1
                    -> CompareCapture
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Directory.Read, Directory.Write, File.Read, File.Write, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    return EsEnginePostprocessReferenceCli::run(arguments)
