# Pure libc++ ABI-tag extraction and comparison used by the Wicked archive gate.
module EsEngineWickedArchiveAbi:
    public:
        def abi_versions(symbol_dump: sview) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            annotations: darray[sview] = Patterns::ABI_ANNOTATION.findall(symbol_dump)
            versions: mutable darray[sview] = []
            for annotation in annotations |versions|:
                versions.push(annotation[8:len(annotation) - 1])
            return unique_sorted(versions)


        def compiler_abi_mismatch(archive_versions: darray[sview], compiler_versions: darray[sview]) -> sview can[Memory.Allocate, Abort.Panic]:
            archives: darray[sview] = unique_sorted(archive_versions)
            compiler: darray[sview] = unique_sorted(compiler_versions)
            return "" if archives == compiler
            return "C++ compiler libc++ ABI tags (" + join_versions(compiler) + ") do not match linked archive tags (" + join_versions(archives) + "); select a matching compiler or rebuild all C++ archives."


    private:
        const module Patterns:
            ABI_ANNOTATION: Regex = regex"\[abi:nq[a-z][0-9]+\]"


        def unique_sorted(values: darray[sview]) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            ordered: darray[sview] = sorted(values)
            unique: mutable darray[sview] = []
            for value in ordered |unique|:
                if unique.count == 0 or unique[unique.count - 1] != value:
                    unique.push(value)
            return unique


        def join_versions(values: darray[sview]) -> sview can[Memory.Allocate, Abort.Panic]:
            joined: mutable sview = ""
            for value in values |joined|:
                joined <- joined + ", " if joined != ""
                joined <- joined + value
            return "none" if joined == ""
            return joined
