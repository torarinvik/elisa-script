# Typed ports of cook_gltf_skin's accessor-level skin helpers. Accessor byte
# layout stays in EsEngineGltfAccessor; this module owns skin schema, data,
# and rest-pose transform decomposition.
include "../../../src/runtime/data_model.elisa"
include "../../../src/runtime/json_model.elisa"
include "../../../src/runtime/json_lexer_model.elisa"
include "../../../src/runtime/json_parse_model.elisa"
include "../../../vendor/elisa-compiler/elisacore_std/elisacore_math.elisa"
include "gltf_affine_model.elisa"
include "gltf_accessor_model.elisa"

using EsData
using EsJson
using EsJsonLex
using EsJsonParse
using EsEngineGltfAffine
using EsEngineGltfAccessor


module EsEngineGltfSkin:
    public:
        const module Limits:
            MAX_VERTICES: usize = 2000000
            MAX_JOINTS: usize = 256
            WEIGHTS_PER_VERTEX: usize = 4
            WEIGHT_SUM_TOLERANCE: f64 = 0.005
            AFFINE_TOLERANCE: f64 = 0.000001
            MINIMUM_SCALE: f64 = 0.000000000001
            ORTHOGONALITY_TOLERANCE: f64 = 0.00001
            MAXIMUM_F64: f64 = 1.7976931348623157e308


        error SkinError:
            InvalidDocument
            InvalidAttributes
            MissingSkinAttributes
            InvalidAccessorIndex
            JointAccessorMustBeVec4
            WeightAccessorMustBeVec4
            InfluenceCountMismatch
            InvalidJointAccessorFormat
            InvalidWeightAccessorFormat
            InvalidJointAccessorData
            InvalidWeightAccessorData
            InvalidInfluenceWeights
            InvalidInverseBindAccessor
            InverseBindAccessorMustBeMat4
            InvalidInverseBindAccessorData
            NonFiniteInverseBindMatrix
            NonAffineInverseBindMatrix
            SingularInverseBindMatrix
            RestMatrixHasZeroScale
            RestMatrixContainsShear
            InvalidRestMatrixRotation
            InfluenceLimitExceeded


        # glTF stores four float32 weights. Keeping their native width is
        # byte-faithful; each value is also exactly representable as f64.
        struct SkinInfluences:
            joints: darray[u32] = []
            weights: darray[f32] = []


        def read_influences(document: JsonDocument&, buffer: darray[u8]&, attributes_index: usize, vertex_count: i64) -> SkinInfluences error[SkinError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise SkinError.InvalidDocument if document.state != JsonDocumentState.Sealed or document.roots.count != 1
            raise SkinError.InvalidDocument if document.policy.duplicate_keys != JsonDuplicateKeyPolicy.KeepLast
            raise SkinError.InvalidDocument if document.roots[0] >= document.nodes.count or document.nodes[document.roots[0]].kind != JsonNodeKind.Object
            raise SkinError.InvalidAttributes if attributes_index >= document.nodes.count or document.nodes[attributes_index].kind != JsonNodeKind.Object
            raise SkinError.InfluenceLimitExceeded if vertex_count < 0 or vertex_count.usize() > Limits::MAX_VERTICES

            joint_reference_index: usize = try skin_member_index(document, attributes_index, "JOINTS_0")
            weight_reference_index: usize = try skin_member_index(document, attributes_index, "WEIGHTS_0")
            raise SkinError.MissingSkinAttributes if joint_reference_index == JSON_INDEX_NONE or weight_reference_index == JSON_INDEX_NONE
            joint_reference: i64 = try skin_integer_value(document, joint_reference_index) else failure:
                _ = failure
                raise SkinError.InvalidAccessorIndex
            weight_reference: i64 = try skin_integer_value(document, weight_reference_index) else failure:
                _ = failure
                raise SkinError.InvalidAccessorIndex

            joint_accessor_index: usize = try skin_accessor_index(document, joint_reference)
            weight_accessor_index: usize = try skin_accessor_index(document, weight_reference)
            joint_is_vec4: bool = try skin_text_field_is(document, joint_accessor_index, "type", "VEC4")
            weight_is_vec4: bool = try skin_text_field_is(document, weight_accessor_index, "type", "VEC4")
            raise SkinError.JointAccessorMustBeVec4 if not joint_is_vec4
            raise SkinError.WeightAccessorMustBeVec4 if not weight_is_vec4

            joint_count: i64 = try skin_integer_field(document, joint_accessor_index, "count") else failure:
                _ = failure
                raise SkinError.InfluenceCountMismatch
            weight_count: i64 = try skin_integer_field(document, weight_accessor_index, "count") else failure:
                _ = failure
                raise SkinError.InfluenceCountMismatch
            raise SkinError.InfluenceCountMismatch if joint_count != vertex_count or weight_count != vertex_count

            joint_component: i64 = try skin_integer_field(document, joint_accessor_index, "componentType") else failure:
                _ = failure
                raise SkinError.InvalidJointAccessorFormat
            weight_component: i64 = try skin_integer_field(document, weight_accessor_index, "componentType") else failure:
                _ = failure
                raise SkinError.InvalidWeightAccessorFormat
            joint_normalized: bool = try skin_optional_boolean_field(document, joint_accessor_index, "normalized", false)
            raise SkinError.InvalidJointAccessorFormat if (joint_component != 5121i64 and joint_component != 5123i64) or joint_normalized
            raise SkinError.InvalidWeightAccessorFormat if weight_component != 5126i64

            joint_data: darray[u8] = try accessor_bytes(document, buffer, joint_reference) else failure:
                _ = failure
                raise SkinError.InvalidJointAccessorData
            weight_data: darray[u8] = try accessor_bytes(document, buffer, weight_reference) else failure:
                _ = failure
                raise SkinError.InvalidWeightAccessorData

            count: usize = vertex_count.usize()
            joint_stride: usize = 4 if joint_component == 5121i64 else 8
            raise SkinError.InvalidDocument if count > Limits::MAX_VERTICES
            raise SkinError.InvalidDocument if joint_data.count != count * joint_stride or weight_data.count != count * 16

            influences: mutable SkinInfluences = SkinInfluences{}
            for vertex in 0..<count |joint_data, weight_data, joint_stride, influences|:
                joint_offset: usize = vertex * joint_stride
                weight_offset: usize = vertex * 16
                for lane in 0..<Limits::WEIGHTS_PER_VERTEX |joint_data, joint_offset, joint_stride, influences|:
                    byte_offset: usize = joint_offset + lane if joint_stride == 4 else joint_offset + lane * 2
                    joint: u32 = joint_data[byte_offset].u32()
                    if joint_stride == 8:
                        joint <- joint | (joint_data[byte_offset + 1].u32() << 8)
                    influences.joints.push(joint)

                weight_sum: mutable f64 = 0.0
                for lane in 0..<Limits::WEIGHTS_PER_VERTEX |weight_data, weight_offset, weight_sum, influences|:
                    offset: usize = weight_offset + lane * 4
                    bits: u32 = skin_read_u32(weight_data, offset)
                    raise SkinError.InvalidInfluenceWeights if (bits & 2139095040u32) == 2139095040u32
                    value: f32 = skin_read_f32(weight_data, offset)
                    raise SkinError.InvalidInfluenceWeights if value < 0.0f32
                    weight_sum <- weight_sum + value.f64()
                    influences.weights.push(value)
                deviation: f64 = weight_sum - 1.0
                raise SkinError.InvalidInfluenceWeights if deviation < -Limits::WEIGHT_SUM_TOLERANCE or deviation > Limits::WEIGHT_SUM_TOLERANCE
            return influences


        # Port of cook_gltf_skin._read_inverse_bind. The optional accessor
        # defaults to one explicit identity matrix per joint.
        def read_inverse_bind_matrices(document: JsonDocument&, buffer: darray[u8]&, skin_index: usize, joint_count: i64) -> darray[f32] error[SkinError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise SkinError.InvalidDocument if document.state != JsonDocumentState.Sealed or document.roots.count != 1
            raise SkinError.InvalidDocument if document.policy.duplicate_keys != JsonDuplicateKeyPolicy.KeepLast
            raise SkinError.InfluenceLimitExceeded if joint_count < 0 or joint_count.usize() > Limits::MAX_JOINTS
            root_index: usize = document.roots[0]
            raise SkinError.InvalidDocument if root_index >= document.nodes.count or document.nodes[root_index].kind != JsonNodeKind.Object
            skins_index: usize = try skin_member_index(document, root_index, "skins")
            raise SkinError.InvalidDocument if skins_index == JSON_INDEX_NONE or skins_index >= document.nodes.count
            skins: JsonNode = document.nodes[skins_index]
            raise SkinError.InvalidDocument if skins.kind != JsonNodeKind.Array
            skin_object_index: usize = try skin_array_item(document, skins_index, skin_index)
            raise SkinError.InvalidDocument if document.nodes[skin_object_index].kind != JsonNodeKind.Object

            reference_index: usize = try skin_member_index(document, skin_object_index, "inverseBindMatrices")
            output: mutable darray[f32] = []
            if reference_index == JSON_INDEX_NONE or document.nodes[reference_index].kind == JsonNodeKind.Null:
                for joint in 0..<joint_count.usize() |output|:
                    skin_append_identity_matrix(output)
                return output
            reference: i64 = try skin_integer_value(document, reference_index) else failure:
                _ = failure
                raise SkinError.InvalidInverseBindAccessor

            accessor_index: usize = try skin_accessor_index(document, reference)
            accessor_is_mat4: bool = try skin_text_field_is(document, accessor_index, "type", "MAT4")
            raise SkinError.InverseBindAccessorMustBeMat4 if not accessor_is_mat4
            accessor_count: i64 = try skin_integer_field(document, accessor_index, "count") else failure:
                _ = failure
                raise SkinError.InvalidInverseBindAccessor
            component_type: i64 = try skin_integer_field(document, accessor_index, "componentType") else failure:
                _ = failure
                raise SkinError.InvalidInverseBindAccessor
            raise SkinError.InvalidInverseBindAccessor if component_type != 5126i64 or accessor_count < joint_count

            packed: darray[u8] = try accessor_bytes(document, buffer, reference) else failure:
                _ = failure
                raise SkinError.InvalidInverseBindAccessorData
            count: usize = joint_count.usize()
            raise SkinError.InvalidInverseBindAccessorData if count > (packed.count / 64)
            for joint in 0..<count |packed, output|:
                offset: usize = joint * 64
                matrix: mutable darray[f64] = []
                for element in 0..<16 |packed, offset, matrix, output|:
                    element_offset: usize = offset + element * 4
                    bits: u32 = skin_read_u32(packed, element_offset)
                    raise SkinError.NonFiniteInverseBindMatrix if (bits & 2139095040u32) == 2139095040u32
                    value: f32 = skin_read_f32(packed, element_offset)
                    matrix.push(value.f64())
                    output.push(value)

                raise SkinError.NonAffineInverseBindMatrix if matrix[3] < -Limits::AFFINE_TOLERANCE or matrix[3] > Limits::AFFINE_TOLERANCE
                raise SkinError.NonAffineInverseBindMatrix if matrix[7] < -Limits::AFFINE_TOLERANCE or matrix[7] > Limits::AFFINE_TOLERANCE
                raise SkinError.NonAffineInverseBindMatrix if matrix[11] < -Limits::AFFINE_TOLERANCE or matrix[11] > Limits::AFFINE_TOLERANCE
                final_row_deviation: f64 = matrix[15] - 1.0
                raise SkinError.NonAffineInverseBindMatrix if final_row_deviation < -Limits::AFFINE_TOLERANCE or final_row_deviation > Limits::AFFINE_TOLERANCE
                determinant: f64 = skin_determinant3x3(matrix)
                raise SkinError.SingularInverseBindMatrix if determinant == 0.0
            return output


        # Port of cook_gltf_skin._rest_matrix_transform. Input is the row-major
        # affine 3x4 result of the node helper, not the original glTF MAT4.
        def rest_matrix_transform(matrix: Affine3x4) -> darray[f64] error[SkinError] can[Memory.Allocate, Abort.Panic]:
            scale_x: mutable f64 = sqrt(matrix.m00 * matrix.m00 + matrix.m10 * matrix.m10 + matrix.m20 * matrix.m20)
            scale_y: f64 = sqrt(matrix.m01 * matrix.m01 + matrix.m11 * matrix.m11 + matrix.m21 * matrix.m21)
            scale_z: f64 = sqrt(matrix.m02 * matrix.m02 + matrix.m12 * matrix.m12 + matrix.m22 * matrix.m22)
            raise SkinError.RestMatrixHasZeroScale if not skin_finite_f64(scale_x) or scale_x <= Limits::MINIMUM_SCALE
            raise SkinError.RestMatrixHasZeroScale if not skin_finite_f64(scale_y) or scale_y <= Limits::MINIMUM_SCALE
            raise SkinError.RestMatrixHasZeroScale if not skin_finite_f64(scale_z) or scale_z <= Limits::MINIMUM_SCALE
            determinant: f64 = determinant_affine(matrix)
            scale_x <- -scale_x if determinant < 0.0

            rotation: darray[f64] = [
                matrix.m00 / scale_x, matrix.m01 / scale_y, matrix.m02 / scale_z,
                matrix.m10 / scale_x, matrix.m11 / scale_y, matrix.m12 / scale_z,
                matrix.m20 / scale_x, matrix.m21 / scale_y, matrix.m22 / scale_z
            ]
            orthogonal_xy: f64 = rotation[0] * rotation[1] + rotation[3] * rotation[4] + rotation[6] * rotation[7]
            orthogonal_xz: f64 = rotation[0] * rotation[2] + rotation[3] * rotation[5] + rotation[6] * rotation[8]
            orthogonal_yz: f64 = rotation[1] * rotation[2] + rotation[4] * rotation[5] + rotation[7] * rotation[8]
            raise SkinError.RestMatrixContainsShear if fabs(orthogonal_xy) > Limits::ORTHOGONALITY_TOLERANCE
            raise SkinError.RestMatrixContainsShear if fabs(orthogonal_xz) > Limits::ORTHOGONALITY_TOLERANCE
            raise SkinError.RestMatrixContainsShear if fabs(orthogonal_yz) > Limits::ORTHOGONALITY_TOLERANCE

            trace: f64 = rotation[0] + rotation[4] + rotation[8]
            factor: mutable f64 = 0.0
            quaternion_x: mutable f64 = 0.0
            quaternion_y: mutable f64 = 0.0
            quaternion_z: mutable f64 = 0.0
            quaternion_w: mutable f64 = 0.0
            if trace > 0.0:
                factor <- sqrt(trace + 1.0) * 2.0
                raise SkinError.InvalidRestMatrixRotation if not skin_finite_f64(factor) or factor <= 0.0
                quaternion_x <- (rotation[7] - rotation[5]) / factor
                quaternion_y <- (rotation[2] - rotation[6]) / factor
                quaternion_z <- (rotation[3] - rotation[1]) / factor
                quaternion_w <- factor * 0.25
            elif rotation[0] > rotation[4] and rotation[0] > rotation[8]:
                factor <- sqrt(1.0 + rotation[0] - rotation[4] - rotation[8]) * 2.0
                raise SkinError.InvalidRestMatrixRotation if not skin_finite_f64(factor) or factor <= 0.0
                quaternion_x <- factor * 0.25
                quaternion_y <- (rotation[1] + rotation[3]) / factor
                quaternion_z <- (rotation[2] + rotation[6]) / factor
                quaternion_w <- (rotation[7] - rotation[5]) / factor
            elif rotation[4] > rotation[8]:
                factor <- sqrt(1.0 + rotation[4] - rotation[0] - rotation[8]) * 2.0
                raise SkinError.InvalidRestMatrixRotation if not skin_finite_f64(factor) or factor <= 0.0
                quaternion_x <- (rotation[1] + rotation[3]) / factor
                quaternion_y <- factor * 0.25
                quaternion_z <- (rotation[5] + rotation[7]) / factor
                quaternion_w <- (rotation[2] - rotation[6]) / factor
            else:
                factor <- sqrt(1.0 + rotation[8] - rotation[0] - rotation[4]) * 2.0
                raise SkinError.InvalidRestMatrixRotation if not skin_finite_f64(factor) or factor <= 0.0
                quaternion_x <- (rotation[2] + rotation[6]) / factor
                quaternion_y <- (rotation[5] + rotation[7]) / factor
                quaternion_z <- factor * 0.25
                quaternion_w <- (rotation[3] - rotation[1]) / factor

            quaternion_length: f64 = sqrt(quaternion_x * quaternion_x + quaternion_y * quaternion_y + quaternion_z * quaternion_z + quaternion_w * quaternion_w)
            raise SkinError.InvalidRestMatrixRotation if not skin_finite_f64(quaternion_length) or quaternion_length <= Limits::MINIMUM_SCALE
            transform: mutable darray[f64] = []
            transform.push(matrix.m03)
            transform.push(matrix.m13)
            transform.push(matrix.m23)
            transform.push(quaternion_x / quaternion_length)
            transform.push(quaternion_y / quaternion_length)
            transform.push(quaternion_z / quaternion_length)
            transform.push(quaternion_w / quaternion_length)
            transform.push(scale_x)
            transform.push(scale_y)
            transform.push(scale_z)
            return transform
    private:
        def skin_accessor_index(document: JsonDocument&, reference: i64) -> usize error[SkinError]:
            raise SkinError.InvalidAccessorIndex if reference < 0
            raise SkinError.InvalidDocument if document.roots.count != 1
            root_index: usize = document.roots[0]
            accessors_index: usize = try skin_member_index(document, root_index, "accessors")
            raise SkinError.InvalidAccessorIndex if accessors_index == JSON_INDEX_NONE
            raise SkinError.InvalidDocument if accessors_index >= document.nodes.count
            accessors: JsonNode = document.nodes[accessors_index]
            raise SkinError.InvalidDocument if accessors.kind != JsonNodeKind.Array
            raise SkinError.InvalidAccessorIndex if reference.usize() >= accessors.child_count
            accessor_index: usize = try skin_array_item(document, accessors_index, reference.usize())
            raise SkinError.InvalidAccessorIndex if document.nodes[accessor_index].kind != JsonNodeKind.Object
            return accessor_index


        def skin_member_index(document: JsonDocument&, object_index: usize, key: sview) usize error[SkinError]:
            raise SkinError.InvalidDocument if object_index >= document.nodes.count
            owner: JsonNode = document.nodes[object_index]
            raise SkinError.InvalidDocument if owner.kind != JsonNodeKind.Object
            raise SkinError.InvalidDocument if owner.member_start > document.members.count or owner.member_count > document.members.count - owner.member_start
            selected: mutable usize = JSON_INDEX_NONE
            for ordinal in 0..<owner.member_count |document, owner, selected|:
                member: JsonMember = document.members[owner.member_start + ordinal]
                raise SkinError.InvalidDocument if member.value_index >= document.nodes.count
                matches: bool = try skin_key_is(document, member, key)
                selected <- member.value_index if matches
            return selected


        def skin_array_item(document: JsonDocument&, array_index: usize, ordinal: usize) -> usize error[SkinError]:
            raise SkinError.InvalidDocument if array_index >= document.nodes.count
            array: JsonNode = document.nodes[array_index]
            raise SkinError.InvalidDocument if array.kind != JsonNodeKind.Array or ordinal >= array.child_count
            raise SkinError.InvalidDocument if array.child_start > document.children.count or array.child_count > document.children.count - array.child_start
            child: JsonArrayChild = document.children[array.child_start + ordinal]
            raise SkinError.InvalidDocument if child.owner_index != array_index or child.ordinal != ordinal or child.value_index >= document.nodes.count
            return child.value_index


        def skin_integer_field(document: JsonDocument&, object_index: usize, key: sview) i64 error[SkinError] can[Memory.Allocate, Abort.Panic]:
            field_index: usize = try skin_member_index(document, object_index, key)
            raise SkinError.InvalidDocument if field_index == JSON_INDEX_NONE
            return try skin_integer_value(document, field_index)


        def skin_integer_value(document: JsonDocument&, node_index: usize) i64 error[SkinError] can[Memory.Allocate, Abort.Panic]:
            raise SkinError.InvalidDocument if node_index >= document.nodes.count
            node: JsonNode = document.nodes[node_index]
            raise SkinError.InvalidDocument if node.kind != JsonNodeKind.Number
            raise SkinError.InvalidDocument if node.scalar_start > document.scalar_data.count or node.scalar_bytes > document.scalar_data.count - node.scalar_start
            source: sview = string_view_slice(bytes_view(document.scalar_data), node.scalar_start.i64(), (node.scalar_start + node.scalar_bytes).i64())
            parsed: mutable i64 = 0i64
            catch parse_int(source):
                ok value:
                    parsed <- value
                error failure:
                    _ = failure
                    raise SkinError.InvalidDocument
            return parsed


        def skin_optional_boolean_field(document: JsonDocument&, object_index: usize, key: sview, fallback: bool) bool error[SkinError]:
            field_index: usize = try skin_member_index(document, object_index, key)
            return fallback if field_index == JSON_INDEX_NONE
            raise SkinError.InvalidDocument if field_index >= document.nodes.count or document.nodes[field_index].kind != JsonNodeKind.Bool
            return document.nodes[field_index].bool_value


        def skin_text_field_is(document: JsonDocument&, object_index: usize, key: sview, expected: sview) bool error[SkinError]:
            field_index: usize = try skin_member_index(document, object_index, key)
            return false if field_index == JSON_INDEX_NONE or field_index >= document.nodes.count
            node: JsonNode = document.nodes[field_index]
            return false if node.kind != JsonNodeKind.Text
            raise SkinError.InvalidDocument if node.scalar_start > document.scalar_data.count or node.scalar_bytes > document.scalar_data.count - node.scalar_start
            return false if node.scalar_bytes != len(expected)
            for offset in 0..<node.scalar_bytes |document, node, expected|:
                return false if document.scalar_data[node.scalar_start + offset] != sview_at(expected, offset.i64())
            return true


        def skin_key_is(document: JsonDocument&, member: JsonMember, expected: sview) bool error[SkinError]:
            raise SkinError.InvalidDocument if member.key_start > document.key_bytes.count or member.key_bytes > document.key_bytes.count - member.key_start
            return false if member.key_bytes != len(expected)
            for offset in 0..<member.key_bytes |document, member, expected|:
                return false if document.key_bytes[member.key_start + offset] != sview_at(expected, offset.i64())
            return true


        def skin_read_u32(bytes: darray[u8]&, offset: usize) u32:
            return bytes[offset].u32() | (bytes[offset + 1].u32() << 8) | (bytes[offset + 2].u32() << 16) | (bytes[offset + 3].u32() << 24)


        def skin_read_f32(bytes: darray[u8]&, offset: usize) f32 can[Unsafe.PointerCast]:
            bits: u32 = skin_read_u32(bytes, offset)
            value: mutable f32 = 0.0f32
            _ = memcpy((&value).cast[mutable void&], (&bits).cast[void&], 4)
            return value


        def skin_append_identity_matrix(output: mutable darray[f32]&) -> void can[Memory.Allocate, Abort.Panic]:
            output.push(1.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(1.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(1.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(1.0f32)


        def skin_determinant3x3(matrix: darray[f64]) -> f64:
            a: f64 = matrix[0]
            b: f64 = matrix[4]
            c: f64 = matrix[8]
            d: f64 = matrix[1]
            e: f64 = matrix[5]
            f: f64 = matrix[9]
            g: f64 = matrix[2]
            h: f64 = matrix[6]
            i: f64 = matrix[10]
            return a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)


        def skin_finite_f64(value: f64) -> bool:
            return value <= Limits::MAXIMUM_F64 and value >= -Limits::MAXIMUM_F64
