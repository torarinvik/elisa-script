# Typed ports of cook_gltf_skin's accessor-level skin helpers. Accessor byte
# layout stays in EsEngineGltfAccessor; this module owns skin schema, data,
# and rest-pose transform decomposition.
include "../../../src/runtime/data_model.elisa"
include "../../../src/runtime/json_model.elisa"
include "../../../src/runtime/json_lexer_model.elisa"
include "../../../src/runtime/json_parse_model.elisa"
include "../../../vendor/elisa-compiler/elisacore_std/elisacore_math.elisa"
include "gltf_affine_model.elisa"
include "gltf_accessor_model.elisa"
include "gltf_node_graph_model.elisa"
include "gltf_node_model.elisa"

using EsData
using EsJson
using EsJsonLex
using EsJsonParse
using EsEngineGltfAffine
using EsEngineGltfAccessor
using EsEngineGltfNodeGraph
using EsEngineGltfNodes


module EsEngineGltfSkin:
    public:
        const module Limits:
            MAX_VERTICES: usize = 2000000
            MAX_JOINTS: usize = 256
            WEIGHTS_PER_VERTEX: usize = 4
            WEIGHT_SUM_TOLERANCE: f64 = 0.005
            AFFINE_TOLERANCE: f64 = 0.000001
            MINIMUM_SCALE: f64 = 0.000000000001
            ORTHOGONALITY_TOLERANCE: f64 = 0.00001
            MAXIMUM_F64: f64 = 1.7976931348623157e308
            MAX_NODES: usize = EsEngineGltfNodeGraph::Limits::MAX_NODES


        # Geometry palette layout derived from a validated scene-level skin
        # normalization. Static bindings create one shared rigid bind slot.
        const enum PlacementSkinBindingKind of u8:
            Unskinned
            Palette
            Static


        struct PlacementSkinBinding:
            kind: PlacementSkinBindingKind = PlacementSkinBindingKind.Unskinned
            palette_offset: usize = 0
            palette_count: usize = 0


        struct PlacementSkinPalettePlan:
            has_skin_streams: bool = false
            palette_count: usize = 0
            # Indexed by source node index so traversal order cannot alter
            # the palette offsets assigned by the Python cooker.
            bindings: darray[PlacementSkinBinding] = []


        struct SkinSourceGraph:
            nodes: darray[GltfNode] = []
            roots: darray[usize] = []
            parent_indices: darray[i64] = []
            world_transforms: darray[Affine3x4] = []


        struct SkinRigMembership:
            mesh_root: usize = 0
            mesh_space_ancestors: darray[bool] = []
            animated_nodes: darray[bool] = []
            rig_nodes: darray[usize] = []


        struct SkinRigParentPlan:
            # Source entries point to another source node, a virtual basis ID,
            # or -1 for a root; -2 marks source nodes outside the rig.
            source_parent_indices: darray[i64] = []
            basis_boundary_indices: darray[i64] = []
            basis_transforms: darray[Affine3x4] = []


    private:
        struct SkinTraversalFrame:
            node_index: usize
            parent_world: Affine3x4


        def skin_affine_is_identity(matrix: Affine3x4) bool:
            return matrix.m00 == 1.0 and matrix.m01 == 0.0 and matrix.m02 == 0.0 and matrix.m03 == 0.0 and matrix.m10 == 0.0 and matrix.m11 == 1.0 and matrix.m12 == 0.0 and matrix.m13 == 0.0 and matrix.m20 == 0.0 and matrix.m21 == 0.0 and matrix.m22 == 1.0 and matrix.m23 == 0.0


        def skin_affine_near_identity(matrix: Affine3x4, tolerance: f64) bool:
            return abs(matrix.m00 - 1.0) <= tolerance and abs(matrix.m01) <= tolerance and abs(matrix.m02) <= tolerance and abs(matrix.m03) <= tolerance and abs(matrix.m10) <= tolerance and abs(matrix.m11 - 1.0) <= tolerance and abs(matrix.m12) <= tolerance and abs(matrix.m13) <= tolerance and abs(matrix.m20) <= tolerance and abs(matrix.m21) <= tolerance and abs(matrix.m22 - 1.0) <= tolerance and abs(matrix.m23) <= tolerance


    public:
        error SkinError:
            InvalidDocument
            InvalidAttributes
            MissingSkinAttributes
            InvalidAccessorIndex
            JointAccessorMustBeVec4
            WeightAccessorMustBeVec4
            InfluenceCountMismatch
            InvalidJointAccessorFormat
            InvalidWeightAccessorFormat
            InvalidJointAccessorData
            InvalidWeightAccessorData
            InvalidInfluenceWeights
            InvalidInverseBindAccessor
            InverseBindAccessorMustBeMat4
            InvalidInverseBindAccessorData
            NonFiniteInverseBindMatrix
            NonAffineInverseBindMatrix
            SingularInverseBindMatrix
            InvalidSkinTable
            InvalidSkinPlacement
            SkinNotReferenced
            PaletteLimitExceeded
            RigNodeLimitExceeded
            InvalidNodeGraph
            InvalidMeshSpaceRoot
            RestMatrixHasZeroScale
            RestMatrixContainsShear
            InvalidRestMatrixRotation
            InfluenceLimitExceeded


        # glTF stores four float32 weights. Keeping their native width is
        # byte-faithful; each value is also exactly representable as f64.
        struct SkinInfluences:
            joints: darray[u32] = []
            weights: darray[f32] = []


        # Port the palette-offset decisions from cook_gltf_skin.normalize.
        # Rig construction remains a separate step; inputs to this planner
        # must have valid skin definitions and node graphs.
        def placement_skin_palette_plan(document: JsonDocument&) PlacementSkinPalettePlan error[SkinError] can[Memory.Allocate, Abort.Panic]:
            raise SkinError.InvalidDocument if document.state != JsonDocumentState.Sealed or document.roots.count != 1
            raise SkinError.InvalidDocument if document.policy.duplicate_keys != JsonDuplicateKeyPolicy.KeepLast
            root_index: usize = document.roots[0]
            raise SkinError.InvalidDocument if root_index >= document.nodes.count or document.nodes[root_index].kind != JsonNodeKind.Object

            nodes_index: usize = try skin_member_index(document, root_index, "nodes")
            raise SkinError.InvalidSkinPlacement if nodes_index == JSON_INDEX_NONE or nodes_index >= document.nodes.count or document.nodes[nodes_index].kind != JsonNodeKind.Array
            nodes: JsonNode = document.nodes[nodes_index]
            raise SkinError.InvalidSkinPlacement if nodes.child_count == 0 or nodes.child_count > Limits::MAX_NODES

            skins_index: usize = try skin_member_index(document, root_index, "skins")
            skin_count: mutable usize = 0
            if skins_index != JSON_INDEX_NONE and document.nodes[skins_index].kind != JsonNodeKind.Null:
                raise SkinError.InvalidSkinTable if document.nodes[skins_index].kind != JsonNodeKind.Array
                skin_count <- document.nodes[skins_index].child_count
            raise SkinError.InvalidSkinTable if skin_count > Limits::MAX_JOINTS

            skin_joint_counts: mutable darray[usize] = []
            for skin_index in 0..<skin_count |document, skins_index, skin_joint_counts, nodes|:
                skin_node_index: usize = try skin_array_item(document, skins_index, skin_index)
                raise SkinError.InvalidSkinTable if document.nodes[skin_node_index].kind != JsonNodeKind.Object
                joints_index: usize = try skin_member_index(document, skin_node_index, "joints")
                raise SkinError.InvalidSkinTable if joints_index == JSON_INDEX_NONE or document.nodes[joints_index].kind != JsonNodeKind.Array
                joints: JsonNode = document.nodes[joints_index]
                raise SkinError.InfluenceLimitExceeded if joints.child_count == 0 or joints.child_count > Limits::MAX_JOINTS
                unique_joints: mutable darray[bool] = []
                for _ in 0..<nodes.child_count |unique_joints|:
                    unique_joints.push(false)
                for joint_ordinal in 0..<joints.child_count |document, joints_index, joints, unique_joints, nodes|:
                    joint_node: usize = try skin_array_item(document, joints_index, joint_ordinal)
                    joint_index: i64 = try skin_integer_value(document, joint_node)
                    raise SkinError.InvalidSkinTable if joint_index < 0 or joint_index.usize() >= nodes.child_count
                    raise SkinError.InvalidSkinTable if unique_joints[joint_index.usize()]
                    unique_joints[joint_index.usize()] <- true
                skin_joint_counts.push(joints.child_count)

            bindings: mutable darray[PlacementSkinBinding] = []
            node_has_mesh: mutable darray[bool] = []
            node_skin_indices: mutable darray[i64] = []
            skin_used: mutable darray[bool] = []
            for _ in 0..<nodes.child_count |bindings, node_has_mesh, node_skin_indices|:
                bindings.push(PlacementSkinBinding{})
                node_has_mesh.push(false)
                node_skin_indices.push(-1i64)
            for _ in 0..<skin_count |skin_used|:
                skin_used.push(false)

            skinned_placement_count: mutable usize = 0
            static_placement_count: mutable usize = 0
            for node_ordinal in 0..<nodes.child_count |document, nodes_index, nodes, bindings, node_has_mesh, node_skin_indices, skin_used, skinned_placement_count, static_placement_count|:
                node_index: usize = try skin_array_item(document, nodes_index, node_ordinal)
                raise SkinError.InvalidSkinPlacement if document.nodes[node_index].kind != JsonNodeKind.Object
                mesh_field: usize = try skin_member_index(document, node_index, "mesh")
                skin_field: usize = try skin_member_index(document, node_index, "skin")
                raise SkinError.InvalidSkinPlacement if skin_field != JSON_INDEX_NONE and mesh_field == JSON_INDEX_NONE
                if mesh_field != JSON_INDEX_NONE:
                    node_has_mesh[node_ordinal] <- true
                    if skin_field == JSON_INDEX_NONE:
                        static_placement_count <- static_placement_count + 1
                    else:
                        skin_index: i64 = try skin_integer_value(document, skin_field)
                        raise SkinError.InvalidSkinPlacement if skin_index < 0 or skin_index.usize() >= skin_count
                        node_skin_indices[node_ordinal] <- skin_index
                        skin_used[skin_index.usize()] <- true
                        skinned_placement_count <- skinned_placement_count + 1

            if skin_count == 0:
                return PlacementSkinPalettePlan{bindings: bindings}
            raise SkinError.InvalidSkinPlacement if skinned_placement_count == 0
            for skin_index in 0..<skin_count |skin_used|:
                raise SkinError.SkinNotReferenced if not skin_used[skin_index]

            palette_total: mutable usize = 0
            if skin_count == 1 and static_placement_count == 0:
                palette_total <- skin_joint_counts[0]
                for node_index in 0..<nodes.child_count |node_skin_indices, bindings, skin_joint_counts|:
                    if node_skin_indices[node_index] == 0i64:
                        bindings[node_index] <- PlacementSkinBinding{
                            kind: PlacementSkinBindingKind.Palette,
                            palette_offset: 0,
                            palette_count: skin_joint_counts[0]
                        }
            else:
                for node_index in 0..<nodes.child_count |node_skin_indices, bindings, skin_joint_counts, palette_total|:
                    skin_index: i64 = node_skin_indices[node_index]
                    if skin_index >= 0:
                        joint_count: usize = skin_joint_counts[skin_index.usize()]
                        raise SkinError.PaletteLimitExceeded if joint_count > Limits::MAX_JOINTS - palette_total
                        bindings[node_index] <- PlacementSkinBinding{
                            kind: PlacementSkinBindingKind.Palette,
                            palette_offset: palette_total,
                            palette_count: joint_count
                        }
                        palette_total <- palette_total + joint_count
                if static_placement_count > 0:
                    raise SkinError.PaletteLimitExceeded if palette_total >= Limits::MAX_JOINTS
                    for node_index in 0..<nodes.child_count |node_has_mesh, node_skin_indices, bindings, palette_total|:
                        if node_has_mesh[node_index] and node_skin_indices[node_index] < 0:
                            bindings[node_index] <- PlacementSkinBinding{
                                kind: PlacementSkinBindingKind.Static,
                                palette_offset: palette_total,
                                palette_count: 1
                            }
                    palette_total <- palette_total + 1
            return PlacementSkinPalettePlan{
                has_skin_streams: true,
                palette_count: palette_total,
                bindings: bindings
            }


        # Decode one validated scene graph for rig consumers and retain
        # source-node parents/world transforms by stable node index.
        def read_skin_source_graph(document: JsonDocument&, mesh_count: usize) SkinSourceGraph error[SkinError] can[Memory.Allocate, Abort.Panic]:
            scene: EsEngineGltfNodes::DecodedNodeScene = try EsEngineGltfNodes::decode_node_scene(document, mesh_count) else failure:
                _ = failure
                raise SkinError.InvalidDocument
            _ = try EsEngineGltfNodeGraph::mesh_placement_records(scene.nodes, scene.roots, mesh_count, true) else failure:
                _ = failure
                raise SkinError.InvalidNodeGraph

            parents: mutable darray[i64] = []
            worlds: mutable darray[Affine3x4] = []
            for _ in 0..<scene.nodes.count |parents, worlds|:
                parents.push(-1i64)
                worlds.push(Affine3x4{})
            for parent_index in 0..<scene.nodes.count |scene, parents|:
                node: GltfNode = scene.nodes[parent_index]
                for child_index in node.children |scene, parents, parent_index|:
                    raise SkinError.InvalidNodeGraph if child_index >= scene.nodes.count
                    raise SkinError.InvalidNodeGraph if child_index == parent_index or parents[child_index] >= 0
                    parents[child_index] <- parent_index.i64()

            identity: Affine3x4 = Affine3x4{m00: 1.0, m11: 1.0, m22: 1.0}
            pending: mutable darray[SkinTraversalFrame] = []
            for ordinal in 0..<scene.roots.count |scene, pending, identity|:
                root_index: usize = scene.roots[scene.roots.count - ordinal - 1]
                pending.push(SkinTraversalFrame{node_index: root_index, parent_world: identity})
            while pending.count > 0 |scene, pending, worlds|:
                frame: SkinTraversalFrame = pending.pop()
                node: GltfNode = scene.nodes[frame.node_index]
                world: Affine3x4 = multiply_affine(frame.parent_world, node.local_transform)
                raise SkinError.InvalidNodeGraph if not affine_is_finite(world)
                worlds[frame.node_index] <- world
                for ordinal in 0..<node.children.count |scene, pending, world|:
                    child_index: usize = node.children[node.children.count - ordinal - 1]
                    pending.push(SkinTraversalFrame{node_index: child_index, parent_world: world})
            return SkinSourceGraph{
                nodes: scene.nodes,
                roots: scene.roots,
                parent_indices: parents,
                world_transforms: worlds
            }


        # Select joints plus transformed or animated ancestors below the
        # first mesh-space root, matching the Python single-skin normalizer.
        def skin_rig_membership(document: JsonDocument&, graph: SkinSourceGraph&, skin_index: usize) -> SkinRigMembership error[SkinError] can[Memory.Allocate, Abort.Panic]:
            raise SkinError.InvalidDocument if document.state != JsonDocumentState.Sealed or document.roots.count != 1
            raise SkinError.InvalidDocument if document.policy.duplicate_keys != JsonDuplicateKeyPolicy.KeepLast
            raise SkinError.InvalidNodeGraph if graph.nodes.count == 0 or graph.nodes.count > Limits::MAX_NODES or graph.parent_indices.count != graph.nodes.count or graph.world_transforms.count != graph.nodes.count
            for node_index in 0..<graph.parent_indices.count |graph|:
                parent_index: i64 = graph.parent_indices[node_index]
                raise SkinError.InvalidNodeGraph if parent_index < -1i64 or parent_index >= graph.nodes.count.i64()
            root_index: usize = document.roots[0]
            raise SkinError.InvalidDocument if root_index >= document.nodes.count or document.nodes[root_index].kind != JsonNodeKind.Object
            nodes_index: usize = try skin_member_index(document, root_index, "nodes")
            raise SkinError.InvalidSkinPlacement if nodes_index == JSON_INDEX_NONE or nodes_index >= document.nodes.count or document.nodes[nodes_index].kind != JsonNodeKind.Array
            source_nodes: JsonNode = document.nodes[nodes_index]
            raise SkinError.InvalidNodeGraph if source_nodes.child_count != graph.nodes.count
            skins_index: usize = try skin_member_index(document, root_index, "skins")
            raise SkinError.InvalidSkinTable if skins_index == JSON_INDEX_NONE or skins_index >= document.nodes.count or document.nodes[skins_index].kind != JsonNodeKind.Array
            skins: JsonNode = document.nodes[skins_index]
            raise SkinError.InvalidSkinTable if skin_index >= skins.child_count
            skin_node: usize = try skin_array_item(document, skins_index, skin_index)
            raise SkinError.InvalidSkinTable if document.nodes[skin_node].kind != JsonNodeKind.Object
            joints_index: usize = try skin_member_index(document, skin_node, "joints")
            raise SkinError.InvalidSkinTable if joints_index == JSON_INDEX_NONE or document.nodes[joints_index].kind != JsonNodeKind.Array
            joints: JsonNode = document.nodes[joints_index]
            raise SkinError.InfluenceLimitExceeded if joints.child_count == 0 or joints.child_count > Limits::MAX_JOINTS

            joint_nodes: mutable darray[bool] = []
            mesh_space_ancestors: mutable darray[bool] = []
            animated_nodes: mutable darray[bool] = []
            rig_members: mutable darray[bool] = []
            for _ in 0..<graph.nodes.count |joint_nodes, mesh_space_ancestors, animated_nodes, rig_members|:
                joint_nodes.push(false)
                mesh_space_ancestors.push(false)
                animated_nodes.push(false)
                rig_members.push(false)
            for joint_ordinal in 0..<joints.child_count |document, joints_index, joints, joint_nodes, rig_members|:
                joint_node: usize = try skin_array_item(document, joints_index, joint_ordinal)
                joint_index: i64 = try skin_integer_value(document, joint_node)
                raise SkinError.InvalidSkinTable if joint_index < 0 or joint_index.usize() >= graph.nodes.count
                raise SkinError.InvalidSkinTable if joint_nodes[joint_index.usize()]
                joint_nodes[joint_index.usize()] <- true
                rig_members[joint_index.usize()] <- true

            mesh_root: mutable usize = JSON_INDEX_NONE
            for node_ordinal in 0..<source_nodes.child_count |document, nodes_index, source_nodes, mesh_root|:
                node_index: usize = try skin_array_item(document, nodes_index, node_ordinal)
                raise SkinError.InvalidSkinPlacement if document.nodes[node_index].kind != JsonNodeKind.Object
                mesh_field: usize = try skin_member_index(document, node_index, "mesh")
                node_skin_field: usize = try skin_member_index(document, node_index, "skin")
                raise SkinError.InvalidSkinPlacement if node_skin_field != JSON_INDEX_NONE and mesh_field == JSON_INDEX_NONE
                if node_skin_field != JSON_INDEX_NONE and mesh_field != JSON_INDEX_NONE:
                    node_skin: i64 = try skin_integer_value(document, node_skin_field)
                    if node_skin >= 0 and node_skin.usize() == skin_index and mesh_root == JSON_INDEX_NONE:
                        mesh_root <- node_ordinal
            raise SkinError.SkinNotReferenced if mesh_root == JSON_INDEX_NONE

            ancestor: mutable i64 = mesh_root.i64()
            ancestor_steps: mutable usize = 0
            while ancestor >= 0 |graph, mesh_space_ancestors, ancestor, ancestor_steps|:
                raise SkinError.InvalidNodeGraph if ancestor.usize() >= graph.nodes.count or ancestor_steps >= graph.nodes.count
                mesh_space_ancestors[ancestor.usize()] <- true
                ancestor_steps <- ancestor_steps + 1
                ancestor <- graph.parent_indices[ancestor.usize()]
            raise SkinError.InvalidNodeGraph if ancestor < -1i64

            animations_index: usize = try skin_member_index(document, root_index, "animations")
            if animations_index != JSON_INDEX_NONE and animations_index < document.nodes.count and document.nodes[animations_index].kind == JsonNodeKind.Array:
                animations: JsonNode = document.nodes[animations_index]
                for animation_ordinal in 0..<animations.child_count |document, animations_index, animations, animated_nodes|:
                    animation_index: usize = try skin_array_item(document, animations_index, animation_ordinal)
                    if document.nodes[animation_index].kind == JsonNodeKind.Object:
                        channels_index: usize = try skin_member_index(document, animation_index, "channels")
                        if channels_index != JSON_INDEX_NONE and channels_index < document.nodes.count and document.nodes[channels_index].kind == JsonNodeKind.Array:
                            channels: JsonNode = document.nodes[channels_index]
                            for channel_ordinal in 0..<channels.child_count |document, channels_index, channels, animated_nodes|:
                                channel_index: usize = try skin_array_item(document, channels_index, channel_ordinal)
                                if document.nodes[channel_index].kind == JsonNodeKind.Object:
                                    target_index: usize = try skin_member_index(document, channel_index, "target")
                                    if target_index != JSON_INDEX_NONE and target_index < document.nodes.count and document.nodes[target_index].kind == JsonNodeKind.Object:
                                        target_node_index: usize = try skin_member_index(document, target_index, "node")
                                        if target_node_index != JSON_INDEX_NONE and target_node_index < document.nodes.count and document.nodes[target_node_index].kind == JsonNodeKind.Number:
                                            catch skin_integer_value(document, target_node_index):
                                                ok animated_node_index:
                                                    if animated_node_index >= 0 and animated_node_index.usize() < animated_nodes.count:
                                                        animated_nodes[animated_node_index.usize()] <- true
                                                error failure:
                                                    _ = failure

            for node_index in 0..<graph.nodes.count |graph, joint_nodes, mesh_space_ancestors, animated_nodes, rig_members, ancestor, ancestor_steps|:
                if joint_nodes[node_index]:
                    ancestor <- graph.parent_indices[node_index]
                    ancestor_steps <- 0
                    while ancestor >= 0 |graph, joint_nodes, mesh_space_ancestors, animated_nodes, rig_members, ancestor, ancestor_steps|:
                        raise SkinError.InvalidNodeGraph if ancestor.usize() >= graph.nodes.count or ancestor_steps >= graph.nodes.count
                        ancestor_index: usize = ancestor.usize()
                        if not joint_nodes[ancestor_index] and not mesh_space_ancestors[ancestor_index]:
                            if not skin_affine_is_identity(graph.nodes[ancestor_index].local_transform) or animated_nodes[ancestor_index]:
                                rig_members[ancestor_index] <- true
                        ancestor_steps <- ancestor_steps + 1
                        ancestor <- graph.parent_indices[ancestor_index]
                    raise SkinError.InvalidNodeGraph if ancestor < -1i64

            rig_nodes: mutable darray[usize] = []
            for node_index in 0..<rig_members.count |rig_members, rig_nodes|:
                if rig_members[node_index]:
                    rig_nodes.push(node_index)
            return SkinRigMembership{
                mesh_root: mesh_root,
                mesh_space_ancestors: mesh_space_ancestors,
                animated_nodes: animated_nodes,
                rig_nodes: rig_nodes
            }


        # Resolve nearest rig parents and synthesize one mesh-relative basis
        # per distinct non-identity boundary, before topological ordering.
        def skin_rig_parent_plan(graph: SkinSourceGraph&, membership: SkinRigMembership&) -> SkinRigParentPlan error[SkinError] can[Memory.Allocate, Abort.Panic]:
            node_count: usize = graph.nodes.count
            raise SkinError.InvalidNodeGraph if node_count == 0 or node_count > Limits::MAX_NODES or graph.parent_indices.count != node_count or graph.world_transforms.count != node_count
            raise SkinError.InvalidNodeGraph if membership.mesh_root >= node_count or membership.mesh_space_ancestors.count != node_count or membership.animated_nodes.count != node_count
            raise SkinError.InvalidNodeGraph if not membership.mesh_space_ancestors[membership.mesh_root]
            raise SkinError.InvalidNodeGraph if membership.rig_nodes.count == 0 or membership.rig_nodes.count > node_count

            rig_members: mutable darray[bool] = []
            source_parents: mutable darray[i64] = []
            for _ in 0..<node_count |rig_members, source_parents|:
                rig_members.push(false)
                source_parents.push(-2i64)
            for node_index in membership.rig_nodes |rig_members|:
                raise SkinError.InvalidNodeGraph if node_index >= node_count or rig_members[node_index]
                rig_members[node_index] <- true

            for node_index in 0..<node_count |graph|:
                parent_index: i64 = graph.parent_indices[node_index]
                raise SkinError.InvalidNodeGraph if parent_index < -1i64 or parent_index >= node_count.i64()

            identity: Affine3x4 = Affine3x4{m00: 1.0, m11: 1.0, m22: 1.0}
            mesh_inverse: mutable Affine3x4 = Affine3x4{}
            mesh_inverse_ready: mutable bool = false
            basis_boundaries: mutable darray[i64] = []
            basis_transforms: mutable darray[Affine3x4] = []
            for node_index in membership.rig_nodes |graph, membership, rig_members, source_parents, identity, mesh_inverse, mesh_inverse_ready, basis_boundaries, basis_transforms|:
                ancestor: mutable i64 = graph.parent_indices[node_index]
                ancestor_steps: mutable usize = 0
                parent_found: mutable bool = false
                while ancestor >= 0 and not parent_found |graph, rig_members, source_parents, ancestor, ancestor_steps, parent_found|:
                    raise SkinError.InvalidNodeGraph if ancestor.usize() >= node_count or ancestor_steps >= node_count
                    ancestor_index: usize = ancestor.usize()
                    if rig_members[ancestor_index]:
                        source_parents[node_index] <- ancestor
                        parent_found <- true
                    else:
                        ancestor <- graph.parent_indices[ancestor_index]
                    ancestor_steps <- ancestor_steps + 1
                raise SkinError.InvalidNodeGraph if ancestor < -1i64 and not parent_found

                if not parent_found:
                    boundary: mutable i64 = graph.parent_indices[node_index]
                    boundary_steps: mutable usize = 0
                    boundary_found: mutable bool = false
                    while boundary >= 0 and not boundary_found |graph, membership, boundary, boundary_steps, boundary_found|:
                        raise SkinError.InvalidNodeGraph if boundary.usize() >= node_count or boundary_steps >= node_count
                        boundary_index: usize = boundary.usize()
                        if membership.mesh_space_ancestors[boundary_index]:
                            boundary_found <- true
                        else:
                            boundary <- graph.parent_indices[boundary_index]
                        boundary_steps <- boundary_steps + 1
                    raise SkinError.InvalidNodeGraph if boundary < -1i64
                    if boundary == membership.mesh_root.i64():
                        source_parents[node_index] <- -1i64
                    else:
                        if not mesh_inverse_ready:
                            mesh_inverse <- try inverse_affine(graph.world_transforms[membership.mesh_root]) else failure:
                                _ = failure
                                raise SkinError.InvalidMeshSpaceRoot
                            mesh_inverse_ready <- true
                        boundary_world: Affine3x4 = identity if boundary < 0i64 else graph.world_transforms[boundary.usize()]
                        basis: Affine3x4 = multiply_affine(mesh_inverse, boundary_world)
                        raise SkinError.InvalidNodeGraph if not affine_is_finite(basis)
                        if skin_affine_near_identity(basis, Limits::AFFINE_TOLERANCE):
                            source_parents[node_index] <- -1i64
                        else:
                            basis_index: mutable usize = JSON_INDEX_NONE
                            for candidate_index in 0..<basis_boundaries.count |basis_boundaries, basis_index, boundary|:
                                basis_index <- candidate_index if basis_boundaries[candidate_index] == boundary
                            if basis_index == JSON_INDEX_NONE:
                                raise SkinError.RigNodeLimitExceeded if membership.rig_nodes.count + basis_boundaries.count >= Limits::MAX_NODES
                                basis_boundaries.push(boundary)
                                basis_transforms.push(basis)
                                basis_index <- basis_boundaries.count - 1
                            source_parents[node_index] <- node_count.i64() + basis_index.i64()

            return SkinRigParentPlan{
                source_parent_indices: source_parents,
                basis_boundary_indices: basis_boundaries,
                basis_transforms: basis_transforms
            }


        def read_influences(document: JsonDocument&, buffer: darray[u8]&, attributes_index: usize, vertex_count: i64) -> SkinInfluences error[SkinError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise SkinError.InvalidDocument if document.state != JsonDocumentState.Sealed or document.roots.count != 1
            raise SkinError.InvalidDocument if document.policy.duplicate_keys != JsonDuplicateKeyPolicy.KeepLast
            raise SkinError.InvalidDocument if document.roots[0] >= document.nodes.count or document.nodes[document.roots[0]].kind != JsonNodeKind.Object
            raise SkinError.InvalidAttributes if attributes_index >= document.nodes.count or document.nodes[attributes_index].kind != JsonNodeKind.Object
            raise SkinError.InfluenceLimitExceeded if vertex_count < 0 or vertex_count.usize() > Limits::MAX_VERTICES

            joint_reference_index: usize = try skin_member_index(document, attributes_index, "JOINTS_0")
            weight_reference_index: usize = try skin_member_index(document, attributes_index, "WEIGHTS_0")
            raise SkinError.MissingSkinAttributes if joint_reference_index == JSON_INDEX_NONE or weight_reference_index == JSON_INDEX_NONE
            joint_reference: i64 = try skin_integer_value(document, joint_reference_index) else failure:
                _ = failure
                raise SkinError.InvalidAccessorIndex
            weight_reference: i64 = try skin_integer_value(document, weight_reference_index) else failure:
                _ = failure
                raise SkinError.InvalidAccessorIndex

            joint_accessor_index: usize = try skin_accessor_index(document, joint_reference)
            weight_accessor_index: usize = try skin_accessor_index(document, weight_reference)
            joint_is_vec4: bool = try skin_text_field_is(document, joint_accessor_index, "type", "VEC4")
            weight_is_vec4: bool = try skin_text_field_is(document, weight_accessor_index, "type", "VEC4")
            raise SkinError.JointAccessorMustBeVec4 if not joint_is_vec4
            raise SkinError.WeightAccessorMustBeVec4 if not weight_is_vec4

            joint_count: i64 = try skin_integer_field(document, joint_accessor_index, "count") else failure:
                _ = failure
                raise SkinError.InfluenceCountMismatch
            weight_count: i64 = try skin_integer_field(document, weight_accessor_index, "count") else failure:
                _ = failure
                raise SkinError.InfluenceCountMismatch
            raise SkinError.InfluenceCountMismatch if joint_count != vertex_count or weight_count != vertex_count

            joint_component: i64 = try skin_integer_field(document, joint_accessor_index, "componentType") else failure:
                _ = failure
                raise SkinError.InvalidJointAccessorFormat
            weight_component: i64 = try skin_integer_field(document, weight_accessor_index, "componentType") else failure:
                _ = failure
                raise SkinError.InvalidWeightAccessorFormat
            joint_normalized: bool = try skin_optional_boolean_field(document, joint_accessor_index, "normalized", false)
            raise SkinError.InvalidJointAccessorFormat if (joint_component != 5121i64 and joint_component != 5123i64) or joint_normalized
            raise SkinError.InvalidWeightAccessorFormat if weight_component != 5126i64

            joint_data: darray[u8] = try accessor_bytes(document, buffer, joint_reference) else failure:
                _ = failure
                raise SkinError.InvalidJointAccessorData
            weight_data: darray[u8] = try accessor_bytes(document, buffer, weight_reference) else failure:
                _ = failure
                raise SkinError.InvalidWeightAccessorData

            count: usize = vertex_count.usize()
            joint_stride: usize = 4 if joint_component == 5121i64 else 8
            raise SkinError.InvalidDocument if count > Limits::MAX_VERTICES
            raise SkinError.InvalidDocument if joint_data.count != count * joint_stride or weight_data.count != count * 16

            influences: mutable SkinInfluences = SkinInfluences{}
            for vertex in 0..<count |joint_data, weight_data, joint_stride, influences|:
                joint_offset: usize = vertex * joint_stride
                weight_offset: usize = vertex * 16
                for lane in 0..<Limits::WEIGHTS_PER_VERTEX |joint_data, joint_offset, joint_stride, influences|:
                    byte_offset: usize = joint_offset + lane if joint_stride == 4 else joint_offset + lane * 2
                    joint: u32 = joint_data[byte_offset].u32()
                    if joint_stride == 8:
                        joint <- joint | (joint_data[byte_offset + 1].u32() << 8)
                    influences.joints.push(joint)

                weight_sum: mutable f64 = 0.0
                for lane in 0..<Limits::WEIGHTS_PER_VERTEX |weight_data, weight_offset, weight_sum, influences|:
                    offset: usize = weight_offset + lane * 4
                    bits: u32 = skin_read_u32(weight_data, offset)
                    raise SkinError.InvalidInfluenceWeights if (bits & 2139095040u32) == 2139095040u32
                    value: f32 = skin_read_f32(weight_data, offset)
                    raise SkinError.InvalidInfluenceWeights if value < 0.0f32
                    weight_sum <- weight_sum + value.f64()
                    influences.weights.push(value)
                deviation: f64 = weight_sum - 1.0
                raise SkinError.InvalidInfluenceWeights if deviation < -Limits::WEIGHT_SUM_TOLERANCE or deviation > Limits::WEIGHT_SUM_TOLERANCE
            return influences


        # Port of cook_gltf_skin._read_inverse_bind. The optional accessor
        # defaults to one explicit identity matrix per joint.
        def read_inverse_bind_matrices(document: JsonDocument&, buffer: darray[u8]&, skin_index: usize, joint_count: i64) -> darray[f32] error[SkinError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise SkinError.InvalidDocument if document.state != JsonDocumentState.Sealed or document.roots.count != 1
            raise SkinError.InvalidDocument if document.policy.duplicate_keys != JsonDuplicateKeyPolicy.KeepLast
            raise SkinError.InfluenceLimitExceeded if joint_count < 0 or joint_count.usize() > Limits::MAX_JOINTS
            root_index: usize = document.roots[0]
            raise SkinError.InvalidDocument if root_index >= document.nodes.count or document.nodes[root_index].kind != JsonNodeKind.Object
            skins_index: usize = try skin_member_index(document, root_index, "skins")
            raise SkinError.InvalidDocument if skins_index == JSON_INDEX_NONE or skins_index >= document.nodes.count
            skins: JsonNode = document.nodes[skins_index]
            raise SkinError.InvalidDocument if skins.kind != JsonNodeKind.Array
            skin_object_index: usize = try skin_array_item(document, skins_index, skin_index)
            raise SkinError.InvalidDocument if document.nodes[skin_object_index].kind != JsonNodeKind.Object

            reference_index: usize = try skin_member_index(document, skin_object_index, "inverseBindMatrices")
            output: mutable darray[f32] = []
            if reference_index == JSON_INDEX_NONE or document.nodes[reference_index].kind == JsonNodeKind.Null:
                for joint in 0..<joint_count.usize() |output|:
                    skin_append_identity_matrix(output)
                return output
            reference: i64 = try skin_integer_value(document, reference_index) else failure:
                _ = failure
                raise SkinError.InvalidInverseBindAccessor

            accessor_index: usize = try skin_accessor_index(document, reference)
            accessor_is_mat4: bool = try skin_text_field_is(document, accessor_index, "type", "MAT4")
            raise SkinError.InverseBindAccessorMustBeMat4 if not accessor_is_mat4
            accessor_count: i64 = try skin_integer_field(document, accessor_index, "count") else failure:
                _ = failure
                raise SkinError.InvalidInverseBindAccessor
            component_type: i64 = try skin_integer_field(document, accessor_index, "componentType") else failure:
                _ = failure
                raise SkinError.InvalidInverseBindAccessor
            raise SkinError.InvalidInverseBindAccessor if component_type != 5126i64 or accessor_count < joint_count

            packed: darray[u8] = try accessor_bytes(document, buffer, reference) else failure:
                _ = failure
                raise SkinError.InvalidInverseBindAccessorData
            count: usize = joint_count.usize()
            raise SkinError.InvalidInverseBindAccessorData if count > (packed.count / 64)
            for joint in 0..<count |packed, output|:
                offset: usize = joint * 64
                matrix: mutable darray[f64] = []
                for element in 0..<16 |packed, offset, matrix, output|:
                    element_offset: usize = offset + element * 4
                    bits: u32 = skin_read_u32(packed, element_offset)
                    raise SkinError.NonFiniteInverseBindMatrix if (bits & 2139095040u32) == 2139095040u32
                    value: f32 = skin_read_f32(packed, element_offset)
                    matrix.push(value.f64())
                    output.push(value)

                raise SkinError.NonAffineInverseBindMatrix if matrix[3] < -Limits::AFFINE_TOLERANCE or matrix[3] > Limits::AFFINE_TOLERANCE
                raise SkinError.NonAffineInverseBindMatrix if matrix[7] < -Limits::AFFINE_TOLERANCE or matrix[7] > Limits::AFFINE_TOLERANCE
                raise SkinError.NonAffineInverseBindMatrix if matrix[11] < -Limits::AFFINE_TOLERANCE or matrix[11] > Limits::AFFINE_TOLERANCE
                final_row_deviation: f64 = matrix[15] - 1.0
                raise SkinError.NonAffineInverseBindMatrix if final_row_deviation < -Limits::AFFINE_TOLERANCE or final_row_deviation > Limits::AFFINE_TOLERANCE
                determinant: f64 = skin_determinant3x3(matrix)
                raise SkinError.SingularInverseBindMatrix if determinant == 0.0
            return output


        # Port of cook_gltf_skin._rest_matrix_transform. Input is the row-major
        # affine 3x4 result of the node helper, not the original glTF MAT4.
        def rest_matrix_transform(matrix: Affine3x4) -> darray[f64] error[SkinError] can[Memory.Allocate, Abort.Panic]:
            scale_x: mutable f64 = sqrt(matrix.m00 * matrix.m00 + matrix.m10 * matrix.m10 + matrix.m20 * matrix.m20)
            scale_y: f64 = sqrt(matrix.m01 * matrix.m01 + matrix.m11 * matrix.m11 + matrix.m21 * matrix.m21)
            scale_z: f64 = sqrt(matrix.m02 * matrix.m02 + matrix.m12 * matrix.m12 + matrix.m22 * matrix.m22)
            raise SkinError.RestMatrixHasZeroScale if not skin_finite_f64(scale_x) or scale_x <= Limits::MINIMUM_SCALE
            raise SkinError.RestMatrixHasZeroScale if not skin_finite_f64(scale_y) or scale_y <= Limits::MINIMUM_SCALE
            raise SkinError.RestMatrixHasZeroScale if not skin_finite_f64(scale_z) or scale_z <= Limits::MINIMUM_SCALE
            determinant: f64 = determinant_affine(matrix)
            scale_x <- -scale_x if determinant < 0.0

            rotation: darray[f64] = [
                matrix.m00 / scale_x, matrix.m01 / scale_y, matrix.m02 / scale_z,
                matrix.m10 / scale_x, matrix.m11 / scale_y, matrix.m12 / scale_z,
                matrix.m20 / scale_x, matrix.m21 / scale_y, matrix.m22 / scale_z
            ]
            orthogonal_xy: f64 = rotation[0] * rotation[1] + rotation[3] * rotation[4] + rotation[6] * rotation[7]
            orthogonal_xz: f64 = rotation[0] * rotation[2] + rotation[3] * rotation[5] + rotation[6] * rotation[8]
            orthogonal_yz: f64 = rotation[1] * rotation[2] + rotation[4] * rotation[5] + rotation[7] * rotation[8]
            raise SkinError.RestMatrixContainsShear if fabs(orthogonal_xy) > Limits::ORTHOGONALITY_TOLERANCE
            raise SkinError.RestMatrixContainsShear if fabs(orthogonal_xz) > Limits::ORTHOGONALITY_TOLERANCE
            raise SkinError.RestMatrixContainsShear if fabs(orthogonal_yz) > Limits::ORTHOGONALITY_TOLERANCE

            trace: f64 = rotation[0] + rotation[4] + rotation[8]
            factor: mutable f64 = 0.0
            quaternion_x: mutable f64 = 0.0
            quaternion_y: mutable f64 = 0.0
            quaternion_z: mutable f64 = 0.0
            quaternion_w: mutable f64 = 0.0
            if trace > 0.0:
                factor <- sqrt(trace + 1.0) * 2.0
                raise SkinError.InvalidRestMatrixRotation if not skin_finite_f64(factor) or factor <= 0.0
                quaternion_x <- (rotation[7] - rotation[5]) / factor
                quaternion_y <- (rotation[2] - rotation[6]) / factor
                quaternion_z <- (rotation[3] - rotation[1]) / factor
                quaternion_w <- factor * 0.25
            elif rotation[0] > rotation[4] and rotation[0] > rotation[8]:
                factor <- sqrt(1.0 + rotation[0] - rotation[4] - rotation[8]) * 2.0
                raise SkinError.InvalidRestMatrixRotation if not skin_finite_f64(factor) or factor <= 0.0
                quaternion_x <- factor * 0.25
                quaternion_y <- (rotation[1] + rotation[3]) / factor
                quaternion_z <- (rotation[2] + rotation[6]) / factor
                quaternion_w <- (rotation[7] - rotation[5]) / factor
            elif rotation[4] > rotation[8]:
                factor <- sqrt(1.0 + rotation[4] - rotation[0] - rotation[8]) * 2.0
                raise SkinError.InvalidRestMatrixRotation if not skin_finite_f64(factor) or factor <= 0.0
                quaternion_x <- (rotation[1] + rotation[3]) / factor
                quaternion_y <- factor * 0.25
                quaternion_z <- (rotation[5] + rotation[7]) / factor
                quaternion_w <- (rotation[2] - rotation[6]) / factor
            else:
                factor <- sqrt(1.0 + rotation[8] - rotation[0] - rotation[4]) * 2.0
                raise SkinError.InvalidRestMatrixRotation if not skin_finite_f64(factor) or factor <= 0.0
                quaternion_x <- (rotation[2] + rotation[6]) / factor
                quaternion_y <- (rotation[5] + rotation[7]) / factor
                quaternion_z <- factor * 0.25
                quaternion_w <- (rotation[3] - rotation[1]) / factor

            quaternion_length: f64 = sqrt(quaternion_x * quaternion_x + quaternion_y * quaternion_y + quaternion_z * quaternion_z + quaternion_w * quaternion_w)
            raise SkinError.InvalidRestMatrixRotation if not skin_finite_f64(quaternion_length) or quaternion_length <= Limits::MINIMUM_SCALE
            transform: mutable darray[f64] = []
            transform.push(matrix.m03)
            transform.push(matrix.m13)
            transform.push(matrix.m23)
            transform.push(quaternion_x / quaternion_length)
            transform.push(quaternion_y / quaternion_length)
            transform.push(quaternion_z / quaternion_length)
            transform.push(quaternion_w / quaternion_length)
            transform.push(scale_x)
            transform.push(scale_y)
            transform.push(scale_z)
            return transform
    private:
        def skin_accessor_index(document: JsonDocument&, reference: i64) -> usize error[SkinError]:
            raise SkinError.InvalidAccessorIndex if reference < 0
            raise SkinError.InvalidDocument if document.roots.count != 1
            root_index: usize = document.roots[0]
            accessors_index: usize = try skin_member_index(document, root_index, "accessors")
            raise SkinError.InvalidAccessorIndex if accessors_index == JSON_INDEX_NONE
            raise SkinError.InvalidDocument if accessors_index >= document.nodes.count
            accessors: JsonNode = document.nodes[accessors_index]
            raise SkinError.InvalidDocument if accessors.kind != JsonNodeKind.Array
            raise SkinError.InvalidAccessorIndex if reference.usize() >= accessors.child_count
            accessor_index: usize = try skin_array_item(document, accessors_index, reference.usize())
            raise SkinError.InvalidAccessorIndex if document.nodes[accessor_index].kind != JsonNodeKind.Object
            return accessor_index


        def skin_member_index(document: JsonDocument&, object_index: usize, key: sview) usize error[SkinError]:
            raise SkinError.InvalidDocument if object_index >= document.nodes.count
            owner: JsonNode = document.nodes[object_index]
            raise SkinError.InvalidDocument if owner.kind != JsonNodeKind.Object
            if owner.member_count == 0:
                raise SkinError.InvalidDocument if owner.member_start != JSON_INDEX_NONE or owner.member_key_order_start != JSON_INDEX_NONE
                return JSON_INDEX_NONE
            raise SkinError.InvalidDocument if owner.member_start > document.members.count or owner.member_count > document.members.count - owner.member_start
            selected: mutable usize = JSON_INDEX_NONE
            for ordinal in 0..<owner.member_count |document, owner, selected|:
                member: JsonMember = document.members[owner.member_start + ordinal]
                raise SkinError.InvalidDocument if member.value_index >= document.nodes.count
                matches: bool = try skin_key_is(document, member, key)
                selected <- member.value_index if matches
            return selected


        def skin_array_item(document: JsonDocument&, array_index: usize, ordinal: usize) -> usize error[SkinError]:
            raise SkinError.InvalidDocument if array_index >= document.nodes.count
            array: JsonNode = document.nodes[array_index]
            raise SkinError.InvalidDocument if array.kind != JsonNodeKind.Array or ordinal >= array.child_count
            raise SkinError.InvalidDocument if array.child_start > document.children.count or array.child_count > document.children.count - array.child_start
            child: JsonArrayChild = document.children[array.child_start + ordinal]
            raise SkinError.InvalidDocument if child.owner_index != array_index or child.ordinal != ordinal or child.value_index >= document.nodes.count
            return child.value_index


        def skin_integer_field(document: JsonDocument&, object_index: usize, key: sview) i64 error[SkinError] can[Memory.Allocate, Abort.Panic]:
            field_index: usize = try skin_member_index(document, object_index, key)
            raise SkinError.InvalidDocument if field_index == JSON_INDEX_NONE
            return try skin_integer_value(document, field_index)


        def skin_integer_value(document: JsonDocument&, node_index: usize) i64 error[SkinError] can[Memory.Allocate, Abort.Panic]:
            raise SkinError.InvalidDocument if node_index >= document.nodes.count
            node: JsonNode = document.nodes[node_index]
            raise SkinError.InvalidDocument if node.kind != JsonNodeKind.Number
            raise SkinError.InvalidDocument if node.scalar_start > document.scalar_data.count or node.scalar_bytes > document.scalar_data.count - node.scalar_start
            source: sview = string_view_slice(bytes_view(document.scalar_data), node.scalar_start.i64(), (node.scalar_start + node.scalar_bytes).i64())
            parsed: mutable i64 = 0i64
            catch parse_int(source):
                ok value:
                    parsed <- value
                error failure:
                    _ = failure
                    raise SkinError.InvalidDocument
            return parsed


        def skin_optional_boolean_field(document: JsonDocument&, object_index: usize, key: sview, fallback: bool) bool error[SkinError]:
            field_index: usize = try skin_member_index(document, object_index, key)
            return fallback if field_index == JSON_INDEX_NONE
            raise SkinError.InvalidDocument if field_index >= document.nodes.count or document.nodes[field_index].kind != JsonNodeKind.Bool
            return document.nodes[field_index].bool_value


        def skin_text_field_is(document: JsonDocument&, object_index: usize, key: sview, expected: sview) bool error[SkinError]:
            field_index: usize = try skin_member_index(document, object_index, key)
            return false if field_index == JSON_INDEX_NONE or field_index >= document.nodes.count
            node: JsonNode = document.nodes[field_index]
            return false if node.kind != JsonNodeKind.Text
            raise SkinError.InvalidDocument if node.scalar_start > document.scalar_data.count or node.scalar_bytes > document.scalar_data.count - node.scalar_start
            return false if node.scalar_bytes != len(expected)
            for offset in 0..<node.scalar_bytes |document, node, expected|:
                return false if document.scalar_data[node.scalar_start + offset] != sview_at(expected, offset.i64())
            return true


        def skin_key_is(document: JsonDocument&, member: JsonMember, expected: sview) bool error[SkinError]:
            raise SkinError.InvalidDocument if member.key_start > document.key_bytes.count or member.key_bytes > document.key_bytes.count - member.key_start
            return false if member.key_bytes != len(expected)
            for offset in 0..<member.key_bytes |document, member, expected|:
                return false if document.key_bytes[member.key_start + offset] != sview_at(expected, offset.i64())
            return true


        def skin_read_u32(bytes: darray[u8]&, offset: usize) u32:
            return bytes[offset].u32() | (bytes[offset + 1].u32() << 8) | (bytes[offset + 2].u32() << 16) | (bytes[offset + 3].u32() << 24)


        def skin_read_f32(bytes: darray[u8]&, offset: usize) f32 can[Unsafe.PointerCast]:
            bits: u32 = skin_read_u32(bytes, offset)
            value: mutable f32 = 0.0f32
            _ = memcpy((&value).cast[mutable void&], (&bits).cast[void&], 4)
            return value


        def skin_append_identity_matrix(output: mutable darray[f32]&) -> void can[Memory.Allocate, Abort.Panic]:
            output.push(1.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(1.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(1.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(0.0f32)
            output.push(1.0f32)


        def skin_determinant3x3(matrix: darray[f64]) -> f64:
            a: f64 = matrix[0]
            b: f64 = matrix[4]
            c: f64 = matrix[8]
            d: f64 = matrix[1]
            e: f64 = matrix[5]
            f: f64 = matrix[9]
            g: f64 = matrix[2]
            h: f64 = matrix[6]
            i: f64 = matrix[10]
            return a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)


        def skin_finite_f64(value: f64) -> bool:
            return value <= Limits::MAXIMUM_F64 and value >= -Limits::MAXIMUM_F64
