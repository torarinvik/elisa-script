#!/usr/bin/env elisascript
# Elisascript companion for elisa-engine/scripts/test_macos_deployment_target.py.
include "../../../src/runtime/macos_deployment_target_model.elisa"

using EsMacosDeploymentTarget


module EsEngineMacosDeploymentTargetTest:
    private:
        const module Fixtures:
            LOAD_COMMANDS: sview = "Load command 1\n cmd LC_BUILD_VERSION\n platform 1\n minos 27.0\n sdk 27.0\nLoad command 2\n cmd LC_VERSION_MIN_MACOSX\n version 13.2.1\n sdk 14.0\n"
            NO_TARGET: sview = ""
            FOREIGN_TARGET: sview = "Load command 0\n cmd LC_BUILD_VERSION\n platform 2\n minos 26.0\n"
            MALFORMED_TARGET: sview = "Load command 0\n cmd LC_BUILD_VERSION\n platform 1\n minos broken\n"


        def matches_error(output: sview, expected: MacosDeploymentTargetError) -> bool can[Memory.Allocate, Abort.Panic]:
            observed: mutable bool = false
            catch deployment_targets(output):
                ok targets:
                    _ = targets
                error failure:
                    observed <- failure == expected
            return observed


    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            targets: darray[MacosVersion] = try deployment_targets(Fixtures::LOAD_COMMANDS) else err:
                print("macOS deployment target parser rejected valid load commands")
                return 1i64
            assert targets.count == 2
            assert format_version(targets[0]) == "27.0"
            assert format_version(targets[1]) == "13.2.1"

            assert version_before(targets[1], targets[0])

            assert matches_error(Fixtures::NO_TARGET, MacosDeploymentTargetError.NoDeploymentTarget)
            assert matches_error(Fixtures::FOREIGN_TARGET, MacosDeploymentTargetError.NonMacosTarget)
            assert matches_error(Fixtures::MALFORMED_TARGET, MacosDeploymentTargetError.MalformedTarget)
            print("macOS deployment target tests passed.")
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsEngineMacosDeploymentTargetTest::run()
