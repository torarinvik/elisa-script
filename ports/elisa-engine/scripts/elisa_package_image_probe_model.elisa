# Typed PNG/JPEG/KTX2 dimension probe from elisa-engine/scripts/elisa_package.py.
# KTX2 structural validation is provided by ktx2_dimensions_model.elisa.
include "ktx2_dimensions_model.elisa"

using EsEngineKtx2Container

module EsElisaPackageImageProbe:
    public:
        struct Dimensions:
            width: u32
            height: u32


        error ImageProbeError:
            ImageSizeRejected
            UnsupportedOrMalformedImage
            ImageDimensionsOutOfRange


        def png_jpeg_dimensions(data: darray[u8]&) -> Dimensions error[ImageProbeError] can[Memory.Allocate, Abort.Panic]:
            return package_image_dimensions(data, false)


        def encoded_image_dimensions(data: darray[u8]&) -> Dimensions error[ImageProbeError] can[Memory.Allocate, Abort.Panic]:
            return package_image_dimensions(data, true)


    private:
        def package_image_dimensions(data: darray[u8]&, allow_ktx2: bool) -> Dimensions error[ImageProbeError] can[Memory.Allocate, Abort.Panic]:
            raise ImageProbeError.ImageSizeRejected if data.count == 0 or data.count > Limits::MAX_SECTION_BYTES
            probe: DimensionProbe = png_dimension_probe(data)
            if probe.state != ProbeState.Found and jpeg_signature_matches(data):
                probe <- jpeg_dimension_probe(data)
            if probe.state != ProbeState.Found and allow_ktx2:
                ktx2: EsEngineKtx2Container::Probe = EsEngineKtx2Container::dimensions(data)
                if ktx2.valid:
                    probe <- DimensionProbe{state: ProbeState.Found, dimensions: Dimensions{width: ktx2.dimensions.width, height: ktx2.dimensions.height}}
            raise ImageProbeError.UnsupportedOrMalformedImage if probe.state != ProbeState.Found
            dimensions: Dimensions = probe.dimensions
            raise ImageProbeError.ImageDimensionsOutOfRange if dimensions.width == 0u32 or dimensions.height == 0u32
            raise ImageProbeError.ImageDimensionsOutOfRange if dimensions.width > Limits::MAX_IMAGE_DIMENSION or dimensions.height > Limits::MAX_IMAGE_DIMENSION
            return dimensions


        const enum ProbeState of u8:
            Scanning
            Found
            Rejected


        struct DimensionProbe:
            state: ProbeState = ProbeState.Rejected
            dimensions: Dimensions = Dimensions{width: 0u32, height: 0u32}


        struct JpegProbe:
            state: ProbeState = ProbeState.Scanning
            offset: usize = 2
            dimensions: Dimensions = Dimensions{width: 0u32, height: 0u32}


        const module Limits:
            MAX_SECTION_BYTES: usize = 67108864
            MAX_IMAGE_DIMENSION: u32 = 8192u32


        def png_dimension_probe(data: darray[u8]&) -> DimensionProbe:
            return DimensionProbe{} if data.count < 33
            return DimensionProbe{} if data[0] != 137u8 or data[1] != 80u8 or data[2] != 78u8 or data[3] != 71u8
            return DimensionProbe{} if data[4] != 13u8 or data[5] != 10u8 or data[6] != 26u8 or data[7] != 10u8
            return DimensionProbe{} if data[8] != 0u8 or data[9] != 0u8 or data[10] != 0u8 or data[11] != 13u8
            return DimensionProbe{} if data[12] != 73u8 or data[13] != 72u8 or data[14] != 68u8 or data[15] != 82u8
            return DimensionProbe{
                state: ProbeState.Found,
                dimensions: Dimensions{
                    width: png_read_be32(data, 16),
                    height: png_read_be32(data, 20)
                }
            }


        def jpeg_signature_matches(data: darray[u8]&) -> bool:
            return false if data.count < 4
            return data[0] == 255u8 and data[1] == 216u8


        def jpeg_dimension_probe(data: darray[u8]&) -> DimensionProbe:
            probe: mutable JpegProbe = JpegProbe{}
            while probe.state == ProbeState.Scanning and probe.offset + 4 <= data.count |data, probe|:
                if data[probe.offset] != 255u8:
                    probe.state <- ProbeState.Rejected
                else:
                    marker: u8 = data[probe.offset + 1]
                    if marker == 255u8:
                        probe.offset <- probe.offset + 1
                    else if jpeg_stops_before_dimensions(marker):
                        probe.state <- ProbeState.Rejected
                    else if jpeg_standalone_marker(marker):
                        probe.offset <- probe.offset + 2
                    else:
                        segment_length: usize = jpeg_read_be16(data, probe.offset + 2)
                        remaining: usize = data.count - probe.offset - 2
                        if segment_length < 2 or segment_length > remaining:
                            probe.state <- ProbeState.Rejected
                        else if jpeg_frame_marker_has_dimensions(marker):
                            if segment_length < 8:
                                probe.state <- ProbeState.Rejected
                            else:
                                probe.dimensions <- Dimensions{
                                    height: jpeg_read_be16(data, probe.offset + 5).u32(),
                                    width: jpeg_read_be16(data, probe.offset + 7).u32()
                                }
                                probe.state <- ProbeState.Found
                        else:
                            probe.offset <- probe.offset + 2 + segment_length
            return DimensionProbe{state: probe.state, dimensions: probe.dimensions}


        def jpeg_stops_before_dimensions(marker: u8) -> bool:
            return marker == 216u8 or marker == 217u8 or marker == 218u8


        def jpeg_standalone_marker(marker: u8) -> bool:
            return marker == 1u8 or marker >= 208u8 and marker <= 215u8


        def jpeg_frame_marker_has_dimensions(marker: u8) -> bool:
            return marker >= 192u8 and marker <= 207u8 and marker != 196u8 and marker != 200u8 and marker != 204u8


        def jpeg_read_be16(data: darray[u8]&, start: usize) -> usize:
            return (data[start].usize() << 8) | data[start + 1].usize()


        def png_read_be32(data: darray[u8]&, start: usize) -> u32:
            return (data[start].u32() << 24) | (data[start + 1].u32() << 16) | (data[start + 2].u32() << 8) | data[start + 3].u32()
