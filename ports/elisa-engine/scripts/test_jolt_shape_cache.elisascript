#!/usr/bin/env elisascript
# Elisascript companion for elisa-engine/scripts/test_jolt_shape_cache.py.
# Compiler and test processes run only when this script is explicitly invoked.
include "./test_jolt_shape_cache_plan.elisa"

using EsEngineJoltShapeCacheTestPlan


module EsEngineJoltShapeCacheTest:
    private:
        struct CommandResult:
            status: i64
            started: bool


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def temporary_parent() -> Path can[Environment.Read, Memory.Allocate, Abort.Panic]:
            configured: sview = try getenv("TMPDIR", "\0") else "\0"
            if configured != "\0" and configured != "":
                return path(configured)
            configured <- try getenv("TEMP", "\0") else "\0"
            if configured != "\0" and configured != "":
                return path(configured)
            configured <- try getenv("TMP", "\0") else "\0"
            return path(configured) if configured != "\0" and configured != ""
            return path("/tmp")


        def brew_include_directory() -> sview can[Environment.Read, Memory.Allocate, Abort.Panic]:
            configured_include: sview = try getenv("WICKED_BREW_INCLUDE_DIR", "\0") else "\0"
            if configured_include != "\0":
                return "." if configured_include == ""
                normalized_include: Path = path(configured_include)
                return f"{normalized_include}"
            homebrew_prefix: sview = try getenv("HOMEBREW_PREFIX", "/opt/homebrew") else "/opt/homebrew"
            include_path: Path = path(homebrew_prefix).joinpath("include")
            return f"{include_path}"


        def execute(program: sview, arguments: darray[sview]) -> CommandResult can[Process.Run, Memory.Allocate, Console.Write]:
            status: i64 = try run_process(executable(program), arguments) else err:
                diagnostic("unable to start command: " + program)
                return CommandResult{status: 127, started: false}
            CommandResult{status: status, started: true}


    public:
        def run() -> i64 can[Directory.Read, Environment.Read, File.Write, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            engine_root: Path = try path_real(Script::source_path().parent().parent().parent().parent().parent().joinpath("elisa-engine")) else err:
                diagnostic("unable to resolve elisa-engine project root")
                return 1i64
            compiler: sview = try getenv("CXX", Defaults::COMPILER) else Defaults::COMPILER
            brew_include: sview = brew_include_directory()
            parent: Path = temporary_parent()
            temporary: Path = try temp_directory_in(parent, Defaults::TEMP_PREFIX) else err:
                diagnostic("unable to create temporary Jolt shape-cache test directory")
                return 1i64
            plan: Plan = EsEngineJoltShapeCacheTestPlan::plan(f"{engine_root}", f"{temporary}", compiler, brew_include)

            execution: mutable ExecutionState = initial_execution()
            machine over execution while execution.phase != ExecutionPhase.Done:
                state Dispatch
                start Dispatch

                Dispatch, ExecutionPhase.Compile:
                    child: CommandResult = execute(plan.compile_command.program, plan.compile_command.arguments)
                    if child.started and child.status != 0:
                        diagnostic("Jolt shape-cache regression did not compile.")
                    execution <- try execution_after_compile(execution, child.status) else err:
                        diagnostic("invalid Jolt shape-cache test execution state")
                        ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: 1}
                    -> Dispatch

                Dispatch, ExecutionPhase.Run:
                    child: CommandResult = execute(plan.executable_path, [])
                    if child.started and child.status != 0:
                        diagnostic("Jolt shape-cache regression failed with status " + f"{child.status}" + ".")
                    execution <- try execution_after_run(execution, child.status) else err:
                        diagnostic("invalid Jolt shape-cache test execution state")
                        ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: 1}
                    -> Dispatch

                Dispatch, ExecutionPhase.Report:
                    _ = write_stdout("Versioned Jolt shape-cache envelope tests passed.\n")
                    execution <- try execution_after_report(execution) else err:
                        diagnostic("invalid Jolt shape-cache test execution state")
                        ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: 1}
                    -> Dispatch

                Dispatch, ExecutionPhase.Cleanup:
                    cleaned: bool = try remove_tree(temporary) else false
                    if not cleaned:
                        diagnostic("unable to clean up temporary Jolt shape-cache test directory")
                    execution <- try execution_after_cleanup(execution, cleaned) else err:
                        diagnostic("invalid Jolt shape-cache test execution state")
                        ExecutionState{phase: ExecutionPhase.Done, exit_status: 1}
                    -> Dispatch

                Dispatch, ExecutionPhase.Done:
                    break
            return execution.exit_status


def main(arguments: darray[sview]) -> i64 can[Directory.Read, Environment.Read, File.Write, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsEngineJoltShapeCacheTest::run()
