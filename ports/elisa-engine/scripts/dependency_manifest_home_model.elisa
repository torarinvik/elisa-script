# Pure choice of HOME source for POSIX pathlib-style tilde expansion.
module EsEngineDependencyManifestHome:
    public:
        struct HomeOverride:
            present: bool
            value_bytes: usize


        const enum HomeSource of u8:
            AccountDatabase
            Environment


        error HomePathError:
            Unresolved


        def source(override: HomeOverride) -> HomeSource:
            # Presence, not non-emptiness, selects HOME. An explicitly empty
            # value therefore remains distinct from an absent variable.
            _ = override.value_bytes
            return HomeSource.Environment if override.present
            return HomeSource.AccountDatabase


        def append_suffix(home: darray[u8], suffix: sview) -> sview error[HomePathError] can[Memory.Allocate, Abort.Panic]:
            normalized: mutable darray[u8] = []
            for byte in home |normalized|:
                normalized.push(byte)
            while normalized.count > 0 and normalized[normalized.count - 1] == 47u8 |normalized|:
                normalized.truncate(normalized.count - 1)
            if normalized.count == 0:
                return "/" if suffix == ""
                return suffix
            raise HomePathError.Unresolved if normalized[0] == 126u8
            return bytes_view(normalized) + suffix
