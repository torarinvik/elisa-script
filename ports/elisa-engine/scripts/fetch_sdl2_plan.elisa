# Pinned legacy SDL2 checkout and CMake argv for elisa-engine/scripts/fetch_sdl2.py.
module EsEngineFetchSdl2Plan:
    public:
        const module Dependency:
            REPOSITORY: sview = "https://github.com/libsdl-org/SDL.git"
            TAG: sview = "release-2.32.10"
            COMMIT: sview = "5d249570393f7a37e037abf22cd6012a4cc56a71"
            CHECKOUT_RELATIVE_PATH: sview = "dependencies/sdl2"
            BUILD_RELATIVE_PATH: sview = "dependencies/sdl2/build"
            LIBRARY_RELATIVE_PATH: sview = "dependencies/sdl2/build/libSDL2-2.0.0.dylib"
            LINK_RELATIVE_PATH: sview = "dependencies/sdl2/build/libSDL2.dylib"
            STAGED_RELATIVE_PATH: sview = "build/libSDL2-2.0.0.dylib"


        struct Command:
            program: sview
            arguments: darray[sview]


        def clone_command(directory: Path) -> Command can[Memory.Allocate, Abort.Panic, Console.Format]:
            return Command{
                program: "git",
                arguments: ["clone", "--branch", Dependency::TAG, "--depth", "1", Dependency::REPOSITORY, f"{directory}"]
            }


        def revision_command(directory: Path) -> Command can[Memory.Allocate, Abort.Panic, Console.Format]:
            return Command{program: "git", arguments: ["-C", f"{directory}", "rev-parse", "HEAD"]}


        def configure_command(source: Path, build: Path) -> Command can[Memory.Allocate, Abort.Panic, Console.Format]:
            return Command{
                program: "cmake",
                arguments: [
                    "-S", f"{source}", "-B", f"{build}", "-DCMAKE_BUILD_TYPE=Release",
                    "-DCMAKE_POLICY_VERSION_MINIMUM=3.5", "-DSDL_SHARED=ON", "-DSDL_STATIC=OFF",
                    "-DSDL_TEST=OFF"
                ]
            }


        def build_command(build: Path) -> Command can[Memory.Allocate, Abort.Panic, Console.Format]:
            return Command{program: "cmake", arguments: ["--build", f"{build}", "--target", "SDL2"]}


        def command_text(command: Command) -> sview can[Memory.Allocate, Abort.Panic]:
            result: mutable sview = command.program
            for argument in command.arguments |result|:
                result <- result + " " + argument
            return result
