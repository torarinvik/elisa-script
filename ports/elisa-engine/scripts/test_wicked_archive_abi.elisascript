#!/usr/bin/env elisascript
# Elisascript companion for elisa-engine/scripts/test_wicked_archive_abi.py.
include "./wicked_archive_abi_model.elisa"

using EsEngineWickedArchiveAbi


module EsEngineWickedArchiveAbiTest:
    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            single: darray[sview] = abi_versions("std::__1::basic_string [abi:nqn230101]")
            assert single == ["230101"]

            mixed: darray[sview] = abi_versions("std::vector [abi:nqn220106]\nstd::string [abi:nqn230101]")
            assert mixed == ["220106", "230101"]
            assert abi_versions("[abi:v160006] unrelated").count == 0

            assert compiler_abi_mismatch(["220106"], ["220106"]) == ""
            mismatch: sview = compiler_abi_mismatch(["220106"], ["230101"])
            assert mismatch.find("220106") >= 0 and mismatch.find("230101") >= 0
            print("Wicked archive ABI tests passed.")
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsEngineWickedArchiveAbiTest::run()
