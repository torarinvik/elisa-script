# Typed command construction for elisa-engine/scripts/cxx_sanitize.py.
module EsEngineCxxSanitizePlan:
    public:
        const module Defaults:
            COMPILER: sview = "c++"
            DEFAULT_FLAVOR: sview = "address,undefined"
            ADDRESS_UNDEFINED_FLAG: sview = "-fsanitize=address,undefined"
            UNDEFINED_FLAG: sview = "-fsanitize=undefined"
            RECOVER_FLAG: sview = "-fno-sanitize-recover=all"
            DEBUG_FLAG: sview = "-g"


        struct Plan:
            program: sview
            arguments: darray[sview]


        error PlanError:
            UnknownSanitizerFlavor


        def command(flavor: sview, caller_arguments: darray[sview]) -> Plan error[PlanError] can[Memory.Allocate, Abort.Panic]:
            sanitizer_flag: mutable sview = Defaults::ADDRESS_UNDEFINED_FLAG if flavor == "address,undefined"
            sanitizer_flag <- Defaults::UNDEFINED_FLAG if flavor == "undefined"
            raise PlanError.UnknownSanitizerFlavor if flavor != "address,undefined" and flavor != "undefined"
            arguments: mutable darray[sview] = [sanitizer_flag, Defaults::RECOVER_FLAG, Defaults::DEBUG_FLAG]
            for argument in caller_arguments |arguments|:
                arguments.push(argument)
            return Plan{program: Defaults::COMPILER, arguments: arguments}


        def usage_error(flavor: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return "unknown ELISA_SANITIZER '" + flavor + "'; use address,undefined, undefined\n"
