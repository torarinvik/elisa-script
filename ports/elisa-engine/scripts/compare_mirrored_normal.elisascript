#!/usr/bin/env elisascript
# Elisa implementation of elisa-engine/scripts/compare_mirrored_normal.py.
include "./render_quality_model.elisa"
include "./render_quality_cli.elisa"

using EsEngineRenderQuality
using EsEngineRenderQualityCli


module EsEngineCompareMirroredNormal:
    private:
        const module Messages:
            USAGE: sview = "usage: compare_mirrored_normal.py <capture.png>\n"
            READ_FAILURE: sview = "compare_mirrored_normal: unable to read capture PNG\n"
            DECODE_FAILURE: sview = "compare_mirrored_normal: unable to decode capture PNG\n"
            METRICS_FAILURE: sview = "compare_mirrored_normal: capture is too small for quality sampling\n"


    public:
        def run(arguments: darray[sview]) -> i64 can[File.Read, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format]:
            if arguments.count != 1:
                _ = write_stderr(Messages::USAGE)
                return 2i64

            bytes: darray[u8] = try read_bytes(path(arguments[0])) else failure:
                _ = failure
                _ = write_stderr(Messages::READ_FAILURE)
                return 1i64
            frame: RenderFrame = try decode_png(bytes) else failure:
                _ = failure
                _ = write_stderr(Messages::DECODE_FAILURE)
                return 1i64
            metrics: MirroredNormalMetrics = try mirrored_normal_metrics(frame) else failure:
                _ = failure
                _ = write_stderr(Messages::METRICS_FAILURE)
                return 1i64

            print("mirrored normal map: left=" + fixed_four_decimal(metrics.left_luminance) + " right=" + fixed_four_decimal(metrics.right_luminance) + " contrast=" + fixed_four_decimal(metrics.contrast))
            return 0i64 if metrics.passes else 1i64


def main(arguments: darray[sview]) -> i64 can[File.Read, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format]:
    return EsEngineCompareMirroredNormal::run(arguments)
