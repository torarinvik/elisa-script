#!/usr/bin/env elisascript
# Elisascript companion for elisa-engine/scripts/test_mikktspace.py.
include "./test_mikktspace_plan.elisa"
include "./temp_directory.elisa"

using EsEngineMikktspaceTestPlan


module EsEngineMikktspaceTest:
    private:
        struct CommandResult:
            status: i64


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def execute(command: Command) -> CommandResult can[Process.Run, Memory.Allocate, Console.Write]:
            status: i64 = try run_process(executable(command.program), command.arguments) else failure:
                _ = failure
                diagnostic("unable to start command: " + command.program)
                return CommandResult{status: 127i64}
            return CommandResult{status: status}


    public:
        def run() -> i64 can[Directory.Read, Environment.Read, File.Read, File.Write, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            engine_root: Path = try path_real(Script::source_path().parent().parent().parent().parent().parent().joinpath("elisa-engine")) else failure:
                _ = failure
                diagnostic("unable to resolve elisa-engine project root")
                return 1i64

            dependency: Path = engine_root.joinpath("dependencies/mikktspace")
            source: Path = dependency.joinpath("mikktspace.c")
            header: Path = dependency.joinpath("mikktspace.h")
            source_exists: bool = try is_file(source) else false
            header_exists: bool = try is_file(header) else false
            if not source_exists or not header_exists:
                diagnostic("missing pinned MikkTSpace; run scripts/fetch_dependencies.py")
                return 1i64

            c_compiler: sview = try getenv("CC", Defaults::C_COMPILER) else Defaults::C_COMPILER
            cxx_compiler: sview = try getenv("CXX", Defaults::CXX_COMPILER) else Defaults::CXX_COMPILER
            temporary: Path = try EsEngineTempDirectory::create(Defaults::TEMP_PREFIX) else failure:
                _ = failure
                diagnostic("unable to create temporary MikkTSpace test directory")
                return 1i64
            plan: Plan = EsEngineMikktspaceTestPlan::plan(f"{engine_root}", f"{temporary}", c_compiler, cxx_compiler)

            execution: mutable ExecutionState = initial_execution()
            machine over execution while execution.phase != ExecutionPhase.Done:
                state Dispatch
                start Dispatch

                Dispatch, ExecutionPhase.CompileC:
                    child: CommandResult = execute(plan.compile_c_command)
                    execution <- try execution_after_compile_c(execution, child.status) else invalid:
                        _ = invalid
                        ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: 1}
                    -> Dispatch

                Dispatch, ExecutionPhase.CompileCpp:
                    child: CommandResult = execute(plan.compile_cpp_command)
                    execution <- try execution_after_compile_cpp(execution, child.status) else invalid:
                        _ = invalid
                        ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: 1}
                    -> Dispatch

                Dispatch, ExecutionPhase.Run:
                    child: CommandResult = execute(plan.test_command)
                    execution <- try execution_after_run(execution, child.status) else invalid:
                        _ = invalid
                        ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: 1}
                    -> Dispatch

                Dispatch, ExecutionPhase.Cleanup:
                    cleaned: bool = try remove_tree(temporary) else false
                    if not cleaned:
                        diagnostic("unable to clean up temporary MikkTSpace test directory")
                    execution <- try execution_after_cleanup(execution, cleaned) else invalid:
                        _ = invalid
                        ExecutionState{phase: ExecutionPhase.Done, exit_status: 1}
                    -> Dispatch

                Dispatch, ExecutionPhase.Done:
                    break
            return execution.exit_status


def main(arguments: darray[sview]) -> i64 can[Directory.Read, Environment.Read, File.Read, File.Write, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsEngineMikktspaceTest::run()
