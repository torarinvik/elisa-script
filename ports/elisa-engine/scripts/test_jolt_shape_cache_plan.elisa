# Typed argv and fail-fast state transitions for ../elisa-engine/scripts/test_jolt_shape_cache.py.
module EsEngineJoltShapeCacheTestPlan:
    public:
        const module Defaults:
            COMPILER: sview = "clang++"
            TEMP_PREFIX: sview = "elisa-jolt-cache-test-"
            EXECUTABLE_NAME: sview = "jolt-shape-cache-test"
            CXX_STANDARD: sview = "-std=c++17"
            OPTIMIZATION: sview = "-O0"
            INCLUDE_FLAG: sview = "-I"
            OUTPUT_FLAG: sview = "-o"
            NATIVE_INCLUDE: sview = "native"
            TEST_SOURCE: sview = "test/jolt_shape_cache_test.cpp"


        const enum ExecutionPhase of u8:
            Compile
            Run
            Report
            Cleanup
            Done


        struct Command:
            program: sview
            arguments: darray[sview]


        struct Plan:
            temporary_directory: sview
            executable_path: sview
            compile_command: Command


        struct ExecutionState:
            phase: ExecutionPhase = ExecutionPhase.Compile
            exit_status: i64 = 0


        error PlanError:
            InvalidExecutionState


        def plan(root: sview, temporary_directory: sview, compiler: sview, brew_include: sview) -> Plan can[Memory.Allocate, Abort.Panic]:
            executable_path: sview = project_path(temporary_directory, Defaults::EXECUTABLE_NAME)
            native_include: sview = project_path(root, Defaults::NATIVE_INCLUDE)
            test_source: sview = project_path(root, Defaults::TEST_SOURCE)
            return Plan{
                temporary_directory: temporary_directory,
                executable_path: executable_path,
                compile_command: Command{
                    program: compiler,
                    arguments: [
                        Defaults::CXX_STANDARD, Defaults::OPTIMIZATION,
                        Defaults::INCLUDE_FLAG, native_include,
                        Defaults::INCLUDE_FLAG, brew_include,
                        test_source, Defaults::OUTPUT_FLAG, executable_path
                    ]
                }
            }


        def initial_execution() -> ExecutionState:
            return ExecutionState{phase: ExecutionPhase.Compile}


        def execution_after_compile(state: ExecutionState, status: i64) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Compile
            return ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: status} if status != 0
            return ExecutionState{phase: ExecutionPhase.Run}


        def execution_after_run(state: ExecutionState, status: i64) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Run
            return ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: status}


        def execution_after_report(state: ExecutionState) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Report
            return ExecutionState{phase: ExecutionPhase.Done, exit_status: state.exit_status}


        def execution_after_cleanup(state: ExecutionState, succeeded: bool) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Cleanup
            return ExecutionState{phase: ExecutionPhase.Done, exit_status: 1} if not succeeded and state.exit_status == 0
            return ExecutionState{phase: ExecutionPhase.Report} if succeeded and state.exit_status == 0
            return ExecutionState{phase: ExecutionPhase.Done, exit_status: state.exit_status}


    private:
        def project_path(root: sview, relative: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return relative if root == ""
            return "/" + relative if root == "/"
            return root + "/" + relative
