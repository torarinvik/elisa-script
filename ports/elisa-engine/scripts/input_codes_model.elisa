# Typed table audit for ../elisa-engine/scripts/test_input_codes.py.
module EsEngineInputCodes:
    public:
        struct CodeEntry:
            name: sview
            value: sview


        struct CodeLookup:
            found: bool = false
            value: sview = ""


        def table_problems(elisa_text: sview, native_text: sview) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            problems: mutable darray[sview] = []
            elisa_entries: darray[CodeEntry] = code_entries(elisa_text, false)
            native_entries: darray[CodeEntry] = code_entries(native_text, true)
            if elisa_entries.count == 0 or native_entries.count == 0:
                problems.push("no input codes found")

            names: mutable darray[sview] = []
            for entry in elisa_entries |names|:
                names.push(entry.name)
            for entry in native_entries |names|:
                names.push(entry.name)
            ordered_names: darray[sview] = unique_sorted(names)
            for name in ordered_names |elisa_entries, native_entries, problems|:
                elisa: CodeLookup = find_code(elisa_entries, name)
                native: CodeLookup = find_code(native_entries, name)
                if not elisa.found or not native.found or elisa.value != native.value:
                    elisa_value: sview = elisa.value if elisa.found else "None"
                    native_value: sview = native.value if native.found else "None"
                    problems.push(name + ": Elisa " + elisa_value + " vs native " + native_value)

            if duplicate_code_values(elisa_entries):
                problems.push("duplicate Elisa code values")

            members: darray[sview] = keyboard_enum_members(elisa_text)
            mapped: darray[sview] = keyboard_key_mappings(elisa_text)
            if sorted(members) != sorted(mapped) or has_duplicates(mapped):
                problems.push("KeyboardKeyCode members and keyboard_key_code arms differ")

            returned: darray[sview] = native_keyboard_returns(native_text)
            keys: mutable darray[sview] = []
            for entry in native_entries |keys|:
                keys.push(entry.name) if entry.name.startswith("KEY_")
            if sorted(returned) != unique_sorted(keys):
                problems.push("native keyboard switch does not return every KEY_ exactly once")
            return problems


        def self_test_problems(elisa_text: sview, native_text: sview) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            problems: mutable darray[sview] = []
            changed_elisa: sview = replace(elisa_text, "KEY_SLASH: i64 = ", "KEY_SLASH: i64 = 9")
            if table_problems(changed_elisa, native_text).count == 0:
                problems.push("a changed Elisa code was not reported")
            changed_native: sview = replace(native_text, "    case SDLK_SLASH: return KEY_SLASH;\n", "")
            if table_problems(elisa_text, changed_native).count == 0:
                problems.push("a missing native switch arm was not reported")
            return problems


    private:
        const module Patterns:
            ELISA_KEY: Regex = regex"^\s+(KEY_[A-Z0-9_]+): i64 = ([0-9]+)$"
            ELISA_GAMEPAD: Regex = regex"^\s+(GAMEPAD_[A-Z0-9_]+): i64 = ([0-9]+)$"
            NATIVE_KEY: Regex = regex"^\s+(KEY_[A-Z0-9_]+) = ([0-9]+),$"
            NATIVE_GAMEPAD: Regex = regex"^\s+(GAMEPAD_[A-Z0-9_]+) = ([0-9]+),$"
            KEYBOARD_MEMBER: Regex = regex"^ {12}([A-Za-z0-9_]+)$"
            KEYBOARD_MAPPING: Regex = regex"KeyboardKeyCode\.([A-Za-z0-9_]+): PortableInputCodes::KEY_"
            KEYBOARD_RETURN: Regex = regex"return KEY_[A-Z0-9_]+;"
            KEYBOARD_ENUM_HEADER: sview = "enum KeyboardKeyCode:"
            KEYBOARD_FUNCTION_HEADER: sview = "constexpr int32_t keyboard_key_code"
            DEFAULT_LABEL: sview = "default:"
            RETURN_PREFIX: sview = "return "


        def canonical_decimal(value: sview) -> sview:
            start: mutable usize = 0
            while start + 1 < len(value) and sview_at(value, start) == 48u8 |value, start|:
                start <- start + 1
            return value[start:len(value)]


        def store_code(entries: mutable darray[CodeEntry]&, name: sview, value: sview) can[Memory.Allocate, Abort.Panic]:
            cursor: mutable usize = 0
            while cursor < entries.count |entries, cursor|:
                if entries[cursor].name == name:
                    entries[cursor] <- CodeEntry{name: name, value: canonical_decimal(value)}
                    return
                cursor <- cursor + 1
            entries.push(CodeEntry{name: name, value: canonical_decimal(value)})


        def code_entries(source: sview, native: bool) -> darray[CodeEntry] can[Memory.Allocate, Abort.Panic]:
            entries: mutable darray[CodeEntry] = []
            for line in source.split_lines() |entries|:
                key_capture: darray[sview] = Patterns::ELISA_KEY.capture(line) if not native else Patterns::NATIVE_KEY.capture(line)
                gamepad_capture: darray[sview] = Patterns::ELISA_GAMEPAD.capture(line) if not native else Patterns::NATIVE_GAMEPAD.capture(line)
                if key_capture.count == 3:
                    store_code(entries, key_capture[1], key_capture[2])
                if gamepad_capture.count == 3:
                    store_code(entries, gamepad_capture[1], gamepad_capture[2])
            return entries


        def find_code(entries: darray[CodeEntry], name: sview) -> CodeLookup:
            for entry in entries:
                if entry.name == name:
                    return CodeLookup{found: true, value: entry.value}
            return CodeLookup{}


        def unique_sorted(values: darray[sview]) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            ordered: darray[sview] = sorted(values)
            unique: mutable darray[sview] = []
            for value in ordered |unique|:
                if unique.count == 0 or unique[unique.count - 1] != value:
                    unique.push(value)
            return unique


        def duplicate_code_values(entries: darray[CodeEntry]) -> bool:
            for left in 0..<entries.count |entries|:
                for right in 0..<left |entries|:
                    return true if entries[left].value == entries[right].value
            return false


        def has_duplicates(values: darray[sview]) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if values.count < 2
            ordered: darray[sview] = sorted(values)
            for index in 1..<ordered.count |ordered|:
                return true if ordered[index] == ordered[index - 1]
            return false


        def keyboard_enum_members(source: sview) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            lines: darray[sview] = source.split_lines()
            members: mutable darray[sview] = []
            header_index: mutable usize = lines.count
            for index in 0..<lines.count |lines, header_index|:
                if header_index == lines.count and lines[index].find(Patterns::KEYBOARD_ENUM_HEADER) >= 0:
                    header_index <- index
            return members if header_index == lines.count
            cursor: mutable usize = header_index + 1
            machine over cursor while cursor < lines.count:
                state MemberLine
                start MemberLine

                MemberLine:
                    capture: darray[sview] = Patterns::KEYBOARD_MEMBER.capture(lines[cursor])
                    if capture.count != 2:
                        break
                    members.push(capture[1])
                    cursor <- cursor + 1
                    -> MemberLine
            return members


        def keyboard_key_mappings(source: sview) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            mappings: mutable darray[sview] = []
            for line in source.split_lines() |mappings|:
                capture: darray[sview] = Patterns::KEYBOARD_MAPPING.capture(line)
                if capture.count == 2:
                    mappings.push(capture[1])
            return mappings


        def native_keyboard_returns(source: sview) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            marker: darray[sview] = source.partition(Patterns::KEYBOARD_FUNCTION_HEADER)
            switch_body: sview = source if marker[1] == "" else marker[2]
            default: darray[sview] = switch_body.partition(Patterns::DEFAULT_LABEL)
            switch_body <- default[0]
            matched_returns: darray[sview] = Patterns::KEYBOARD_RETURN.findall(switch_body)
            returned: mutable darray[sview] = []
            for matched in matched_returns |returned|:
                pieces: darray[sview] = matched.partition(Patterns::RETURN_PREFIX)
                key_with_semicolon: sview = pieces[2]
                if pieces[1] != "" and len(key_with_semicolon) > 1:
                    returned.push(key_with_semicolon[0:len(key_with_semicolon) - 1])
            return returned
