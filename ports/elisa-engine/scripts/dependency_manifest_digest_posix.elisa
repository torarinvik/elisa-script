# Low-memory POSIX file hashing for the dependency-manifest checker.
include "../../../src/runtime/sha256_stream_model.elisa"
include "../../../src/runtime/stream_posix.elisa"

using EsSha256Stream
using EsRuntime


module EsEngineDependencyManifestDigestPosix:
    public:
        error DigestError:
            InvalidPath
            OpenFailed
            ReadFailed
            HashFailed
            CloseFailed
            InputLimitExceeded


        # Feed one bounded source file into an existing digest context. The
        # caller controls ordering and any prefix bytes, matching Python's
        # hashlib.update sequence without loading each file into memory.
        def update_file(context: mutable EsSha256Stream::Context&, input_path: Path, input_limit: usize) -> void error[DigestError, FileStreamError, Sha256StreamError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            path_text: sview = f"{input_path}"
            raise DigestError.InvalidPath if path_text == "" or len(path_text) >= Limits::PATH_BYTES or sview_contains_byte(path_text, 0u8)
            raise DigestError.InputLimitExceeded if input_limit >= EsSha256Stream::Policy::MAX_INPUT_BYTES

            path_bytes: mutable darray[u8] = []
            for byte in path_text |path_bytes|:
                path_bytes.push(byte)
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr] can Unsafe.PointerCast

            stream: mutable FileStream = try file_stream_open(
                path_pointer,
                FileStreamMode.ReadBinary,
                input_limit + 1,
                FileStreamEncoding.Bytes
            ) else failure:
                _ = failure
                raise DigestError.OpenFailed

            buffer: mutable darray[u8] = []
            buffer.reserve(Limits::READ_CHUNK_BYTES)
            for _ in 0..<Limits::READ_CHUNK_BYTES |buffer|:
                buffer.push(0u8)
            bytes_read: mutable usize = 0
            phase: mutable HashPhase = HashPhase.Read
            machine over phase while phase != HashPhase.Done:
                state UpdateFile
                start UpdateFile

                UpdateFile, HashPhase.Read:
                    remaining_budget: usize = stream.byte_budget - stream.bytes_read
                    if remaining_budget == 0:
                        _ = file_stream_close(stream)
                        raise DigestError.InputLimitExceeded
                    buffer_pointer: mutable u8& = (&buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
                    capacity: usize = buffer.count if buffer.count < remaining_budget else remaining_budget
                    read: FileStreamRead = try file_stream_read_chunk(stream, buffer_pointer, capacity) else failure:
                        _ = file_stream_close(stream)
                        raise DigestError.InputLimitExceeded if failure == FileStreamError.LimitExceeded(path_pointer)
                        raise DigestError.ReadFailed
                    if read.count > input_limit - bytes_read:
                        _ = file_stream_close(stream)
                        raise DigestError.InputLimitExceeded
                    try update_buffer(context, buffer, read.count) else failure:
                        _ = failure
                        _ = file_stream_close(stream)
                        raise DigestError.HashFailed
                    bytes_read <- bytes_read + read.count
                    if read.eof:
                        phase <- HashPhase.Close
                    continue

                UpdateFile, HashPhase.Close:
                    closed: bool = try file_stream_close(stream) else failure:
                        _ = failure
                        raise DigestError.CloseFailed
                    raise DigestError.CloseFailed if not closed
                    phase <- HashPhase.Done
                    -> UpdateFile

                UpdateFile, HashPhase.Done:
                    break


        def digest_file(input_path: Path) -> darray[u8] error[DigestError, FileStreamError, Sha256StreamError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            path_text: sview = f"{input_path}"
            raise DigestError.InvalidPath if path_text == "" or len(path_text) >= Limits::PATH_BYTES or sview_contains_byte(path_text, 0u8)

            path_bytes: mutable darray[u8] = []
            for byte in path_text |path_bytes|:
                path_bytes.push(byte)
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr] can Unsafe.PointerCast

            stream: mutable FileStream = try file_stream_open(
                path_pointer,
                FileStreamMode.ReadBinary,
                Limits::READ_BUDGET_BYTES,
                FileStreamEncoding.Bytes
            ) else failure:
                _ = failure
                raise DigestError.OpenFailed

            buffer: mutable darray[u8] = []
            buffer.reserve(Limits::READ_CHUNK_BYTES)
            for _ in 0..<Limits::READ_CHUNK_BYTES |buffer|:
                buffer.push(0u8)
            digest: mutable EsSha256Stream::Context = EsSha256Stream::init()
            phase: mutable HashPhase = HashPhase.Read
            output: mutable darray[u8] = []
            machine over phase while phase != HashPhase.Done:
                state HashFile
                start HashFile

                HashFile, HashPhase.Read:
                    buffer_pointer: mutable u8& = (&buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
                    remaining_budget: usize = stream.byte_budget - stream.bytes_read
                    raise DigestError.InputLimitExceeded if remaining_budget == 0
                    capacity: usize = buffer.count if buffer.count < remaining_budget else remaining_budget
                    read: FileStreamRead = try file_stream_read_chunk(stream, buffer_pointer, capacity) else failure:
                        _ = failure
                        _ = file_stream_close(stream)
                        raise DigestError.InputLimitExceeded if failure == FileStreamError.LimitExceeded(path_pointer)
                        raise DigestError.ReadFailed
                    if digest.total_bytes + read.count.u64() > Limits::MAX_FILE_BYTES.u64():
                        _ = file_stream_close(stream)
                        raise DigestError.InputLimitExceeded
                    try update_buffer(digest, buffer, read.count) else failure:
                        _ = failure
                        _ = file_stream_close(stream)
                        raise DigestError.HashFailed
                    if read.eof:
                        output <- try finish_hex(digest) else failure:
                            _ = failure
                            _ = file_stream_close(stream)
                            raise DigestError.HashFailed
                        phase <- HashPhase.Close
                    continue

                HashFile, HashPhase.Close:
                    closed: bool = try file_stream_close(stream) else failure:
                        _ = failure
                        raise DigestError.CloseFailed
                    raise DigestError.CloseFailed if not closed
                    phase <- HashPhase.Done
                    -> HashFile

                HashFile, HashPhase.Done:
                    break

            return output


    private:
        const module Limits:
            PATH_BYTES: usize = 4096
            READ_CHUNK_BYTES: usize = 65536
            # The SHA-256 standard's 64-bit bit-length field admits fewer than
            # 2^61 input bytes. One extra stream byte distinguishes an exact
            # maximum-length file from an over-limit file without hashing it.
            MAX_FILE_BYTES: usize = EsSha256Stream::Policy::MAX_INPUT_BYTES
            READ_BUDGET_BYTES: usize = MAX_FILE_BYTES + 1


        const enum HashPhase of u8:
            Read
            Close
            Done
