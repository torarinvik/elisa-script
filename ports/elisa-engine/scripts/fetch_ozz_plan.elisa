# Pinned ozz-animation checkout and CMake argv for fetch_ozz.py.
module EsEngineFetchOzzPlan:
    public:
        const module Dependency:
            REPOSITORY: sview = "https://github.com/guillaumeblanc/ozz-animation.git"
            TAG: sview = "0.16.0"
            COMMIT: sview = "6cbdc790123aa4731d82e255df187b3a8a808256"
            BUILD_RELATIVE_PATH: sview = "dependencies/ozz/build"
            BASE_LIBRARY: sview = "src/base/libozz_base_r.a"
            ANIMATION_LIBRARY: sview = "src/animation/runtime/libozz_animation_r.a"
            OFFLINE_LIBRARY: sview = "src/animation/offline/libozz_animation_offline_r.a"


        struct Command:
            program: sview
            arguments: darray[sview]


        def clone_command(directory: Path) -> Command can[Memory.Allocate, Abort.Panic, Console.Format]:
            return Command{
                program: "git",
                arguments: ["clone", "--branch", Dependency::TAG, "--depth", "1", Dependency::REPOSITORY, f"{directory}"]
            }


        def revision_command(directory: Path) -> Command can[Memory.Allocate, Abort.Panic, Console.Format]:
            return Command{program: "git", arguments: ["-C", f"{directory}", "rev-parse", "HEAD"]}


        def configure_command(source: Path, build: Path) -> Command can[Memory.Allocate, Abort.Panic, Console.Format]:
            return Command{
                program: "cmake",
                arguments: [
                    "-S", f"{source}", "-B", f"{build}", "-DCMAKE_BUILD_TYPE=Release",
                    "-Dozz_build_tools=OFF", "-Dozz_build_samples=OFF", "-Dozz_build_howtos=OFF",
                    "-Dozz_build_tests=OFF"
                ]
            }


        def build_command(build: Path) -> Command can[Memory.Allocate, Abort.Panic, Console.Format]:
            return Command{program: "cmake", arguments: ["--build", f"{build}", "--target", "ozz_animation", "ozz_animation_offline"]}


        def command_text(command: Command) -> sview can[Memory.Allocate, Abort.Panic]:
            result: mutable sview = command.program
            for argument in command.arguments |result|:
                result <- result + " " + argument
            return result
