#!/usr/bin/env elisascript
# Elisascript companion for elisa-engine/scripts/cxx_sanitize.py.
# Normal compiler argv, environment, cwd, streams, and exit status are relayed.
# Unlike Python os.execvp, this waits for a child rather than replacing itself.
include "./cxx_sanitize_plan.elisa"

using EsEngineCxxSanitizePlan


def main(arguments: darray[sview]) -> i64 can[Environment.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write]:
    flavor: sview = get_environment_or("ELISA_SANITIZER", Defaults::DEFAULT_FLAVOR)
    plan: Plan = try EsEngineCxxSanitizePlan::command(flavor, arguments) else err:
        _ = write_stderr(EsEngineCxxSanitizePlan::usage_error(flavor))
        return 2i64
    status: i64 = try run_process(executable(plan.program), plan.arguments) else err:
        _ = write_stderr("unable to execute C++ compiler: " + plan.program + "\n")
        return 127i64
    return status
