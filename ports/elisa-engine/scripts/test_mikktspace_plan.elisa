# Typed compiler argv and fail-fast phases for test_mikktspace.py.
module EsEngineMikktspaceTestPlan:
    public:
        const module Defaults:
            C_COMPILER: sview = "cc"
            CXX_COMPILER: sview = "c++"
            ENV_PROGRAM: sview = "env"
            TEMP_PREFIX: sview = "elisa-mikktspace-test-"
            OBJECT_NAME: sview = "mikktspace.o"
            EXECUTABLE_NAME: sview = "mikktspace-test"
            C_STANDARD: sview = "-std=c99"
            CXX_STANDARD: sview = "-std=c++17"
            OPTIMIZATION: sview = "-O1"
            DEBUG: sview = "-g"
            SANITIZERS: sview = "-fsanitize=address,undefined"
            NO_SANITIZER_RECOVERY: sview = "-fno-sanitize-recover=all"
            INCLUDE_FLAG: sview = "-I"
            COMPILE_ONLY_FLAG: sview = "-c"
            OUTPUT_FLAG: sview = "-o"
            DEPENDENCY_DIRECTORY: sview = "dependencies/mikktspace"
            NATIVE_DIRECTORY: sview = "native"
            C_SOURCE: sview = "dependencies/mikktspace/mikktspace.c"
            CXX_TEST_SOURCE: sview = "native/mikktspace_geometry_test.cpp"
            ASAN_OPTIONS: sview = "ASAN_OPTIONS=halt_on_error=1"
            UBSAN_OPTIONS: sview = "UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1"


        const enum ExecutionPhase of u8:
            CompileC
            CompileCpp
            Run
            Cleanup
            Report
            Done


        struct Command:
            program: sview
            arguments: darray[sview]


        struct Plan:
            temporary_directory: sview
            executable_path: sview
            compile_c_command: Command
            compile_cpp_command: Command
            test_command: Command


        struct ExecutionState:
            phase: ExecutionPhase = ExecutionPhase.CompileC
            exit_status: i64 = 0


        error PlanError:
            InvalidExecutionState


        def plan(root: sview, temporary_directory: sview, c_compiler: sview, cxx_compiler: sview) -> Plan can[Memory.Allocate, Abort.Panic]:
            dependency_directory: sview = project_path(root, Defaults::DEPENDENCY_DIRECTORY)
            object_path: sview = project_path(temporary_directory, Defaults::OBJECT_NAME)
            executable_path: sview = project_path(temporary_directory, Defaults::EXECUTABLE_NAME)
            c_source: sview = project_path(root, Defaults::C_SOURCE)
            cxx_source: sview = project_path(root, Defaults::CXX_TEST_SOURCE)
            native_directory: sview = project_path(root, Defaults::NATIVE_DIRECTORY)
            return Plan{
                temporary_directory: temporary_directory,
                executable_path: executable_path,
                compile_c_command: Command{
                    program: c_compiler,
                    arguments: [
                        Defaults::C_STANDARD, Defaults::OPTIMIZATION, Defaults::DEBUG,
                        Defaults::SANITIZERS, Defaults::NO_SANITIZER_RECOVERY,
                        Defaults::INCLUDE_FLAG, dependency_directory,
                        Defaults::COMPILE_ONLY_FLAG, c_source,
                        Defaults::OUTPUT_FLAG, object_path
                    ]
                },
                compile_cpp_command: Command{
                    program: cxx_compiler,
                    arguments: [
                        Defaults::CXX_STANDARD, Defaults::OPTIMIZATION, Defaults::DEBUG,
                        Defaults::SANITIZERS, Defaults::NO_SANITIZER_RECOVERY,
                        Defaults::INCLUDE_FLAG, dependency_directory,
                        Defaults::INCLUDE_FLAG, native_directory,
                        cxx_source, object_path,
                        Defaults::OUTPUT_FLAG, executable_path
                    ]
                },
                # `env` overlays these two variables while inheriting the rest
                # of the caller's environment, as the Python wrapper does.
                test_command: Command{
                    program: Defaults::ENV_PROGRAM,
                    arguments: [Defaults::ASAN_OPTIONS, Defaults::UBSAN_OPTIONS, executable_path]
                }
            }


        def initial_execution() -> ExecutionState:
            return ExecutionState{phase: ExecutionPhase.CompileC}


        def execution_after_compile_c(state: ExecutionState, status: i64) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.CompileC
            return ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: status} if status != 0
            return ExecutionState{phase: ExecutionPhase.CompileCpp}


        def execution_after_compile_cpp(state: ExecutionState, status: i64) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.CompileCpp
            return ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: status} if status != 0
            return ExecutionState{phase: ExecutionPhase.Run}


        def execution_after_run(state: ExecutionState, status: i64) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Run
            return ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: status}


        def execution_after_cleanup(state: ExecutionState, succeeded: bool) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Cleanup
            return ExecutionState{phase: ExecutionPhase.Done, exit_status: 1} if not succeeded
            return ExecutionState{phase: ExecutionPhase.Report} if state.exit_status == 0
            return ExecutionState{phase: ExecutionPhase.Done, exit_status: state.exit_status}


        def execution_after_report(state: ExecutionState) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Report
            return ExecutionState{phase: ExecutionPhase.Done, exit_status: state.exit_status}


    private:
        def project_path(root: sview, relative: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return relative if root == ""
            return "/" + relative if root == "/"
            return root + "/" + relative
