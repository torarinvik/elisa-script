# Typed port of elisa-engine/scripts/geometry_subset_package_builder.py.
#
# The input is an explicit package description rather than Python's loosely
# typed keyword arguments. Optional records are controlled by presence flags,
# preserving the distinction between an absent stream and an empty stream.
include "../../../src/runtime/base64_model.elisa"
include "../../../src/runtime/python_text_model.elisa"

using EsBase64
using EsPythonText


module EsEngineGeometrySubsetPackageBuilder:
    public:
        struct Subset:
            first_index: u32
            index_count: u32
            material_slot: u32


        struct MaterialRecord:
            factors: darray[f32]
            tag0: u32 = 0u32
            tag1: u32 = 0u32


        struct ClearcoatRecord:
            factor: f32
            roughness: f32
            normal_scale: f32


        struct TextureReference:
            values: darray[u32]


        struct TextureTable:
            names: darray[sview] = []
            references: darray[TextureReference] = []
            has_count_override: bool = false
            count_override: u32 = 0u32
            stride: sview = "20"


        struct StripPackageInput:
            triangle_count: u32
            has_subsets: bool = false
            subsets: darray[Subset] = []
            has_material_slots: bool = false
            material_slots: u32 = 0u32
            has_subset_count_override: bool = false
            subset_count_override: u32 = 0u32
            subset_stride: sview = "12"
            omitted_fields: darray[sview] = []
            skinned: bool = false
            has_materials: bool = false
            materials: darray[MaterialRecord] = []
            material_stride: sview = "48"
            has_normal_scales: bool = false
            normal_scales: darray[f32] = []
            normal_scale_stride: sview = "4"
            has_occlusion_strengths: bool = false
            occlusion_strengths: darray[f32] = []
            occlusion_strength_stride: sview = "4"
            has_clearcoat_factors: bool = false
            clearcoat_factors: darray[ClearcoatRecord] = []
            clearcoat_factor_stride: sview = "12"
            has_material_names: bool = false
            material_names: darray[sview] = []
            has_material_name_payload: bool = false
            material_name_payload: darray[u8] = []
            has_textures: bool = false
            textures: TextureTable = TextureTable{}


        error StripPackageError:
            TooManyTriangles
            TooManyRecords
            InvalidMaterialFactorCount
            InvalidTextureReferenceCount
            NonAsciiTextureName
            NonAsciiPackageText
            InvalidTextEncoding
            PackageTooLarge
            Base64Failure


        def strip_package(input: StripPackageInput) -> darray[u8] error[StripPackageError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise StripPackageError.TooManyTriangles if input.triangle_count > Limits::MAX_TRIANGLES
            raise StripPackageError.TooManyRecords if input.subsets.count > Limits::MAX_RECORDS or input.materials.count > Limits::MAX_RECORDS
            raise StripPackageError.TooManyRecords if input.normal_scales.count > Limits::MAX_RECORDS or input.occlusion_strengths.count > Limits::MAX_RECORDS
            raise StripPackageError.TooManyRecords if input.clearcoat_factors.count > Limits::MAX_RECORDS
            raise StripPackageError.TooManyRecords if input.textures.names.count > Limits::MAX_RECORDS or input.textures.references.count > Limits::MAX_RECORDS

            output: mutable darray[u8] = []
            vertices: u32 = input.triangle_count * 3u32
            try package_append_ascii(output, "format=")
            try package_append_ascii(output, "elisa-cooked-v3" if input.skinned else "elisa-cooked-v2")
            try package_append_ascii(output, "\nsource=test/strip.gltf\nsource_sha256=")
            for _ in 0..<64 |output|:
                try package_append_byte(output, 48u8)
            try package_append_ascii(output, "\ntriangles=")
            try package_append_u32_decimal(output, input.triangle_count)
            try package_append_ascii(output, "\npositions=")
            try package_append_u32_decimal(output, vertices)
            try package_append_ascii(output, "\nindices=")
            try package_append_u32_decimal(output, vertices)
            try package_append_ascii(output, "\nposition_stride=12\nnormal_stride=12\nuv_stride=8\nindex_stride=4\n")

            if input.has_subsets:
                subset_bytes: mutable darray[u8] = []
                for subset in input.subsets |subset_bytes|:
                    try package_append_u32_le(subset_bytes, subset.first_index)
                    try package_append_u32_le(subset_bytes, subset.index_count)
                    try package_append_u32_le(subset_bytes, subset.material_slot)
                if not package_is_omitted(input.omitted_fields, "material_slots"):
                    try package_append_ascii(output, "material_slots=")
                    if input.has_material_slots:
                        try package_append_u32_decimal(output, input.material_slots)
                    else:
                        try package_append_ascii(output, "None")
                    try package_append_byte(output, 10u8)
                if not package_is_omitted(input.omitted_fields, "subset_count"):
                    try package_append_ascii(output, "subset_count=")
                    try package_append_u32_decimal(output, input.subset_count_override if input.has_subset_count_override else input.subsets.count.u32())
                    try package_append_byte(output, 10u8)
                if not package_is_omitted(input.omitted_fields, "subset_stride"):
                    try package_append_ascii(output, "subset_stride=")
                    try package_append_ascii(output, input.subset_stride)
                    try package_append_byte(output, 10u8)
                if not package_is_omitted(input.omitted_fields, "subsets_b64"):
                    try package_append_base64_field(output, "subsets_b64", subset_bytes)

            if input.has_materials:
                material_bytes: mutable darray[u8] = []
                for record in input.materials |material_bytes|:
                    raise StripPackageError.InvalidMaterialFactorCount if record.factors.count != 10
                    for factor in record.factors |material_bytes|:
                        try package_append_f32_le(material_bytes, factor)
                    try package_append_u32_le(material_bytes, record.tag0)
                    try package_append_u32_le(material_bytes, record.tag1)
                if not package_is_omitted(input.omitted_fields, "slot_material_stride"):
                    try package_append_ascii(output, "slot_material_stride=")
                    try package_append_ascii(output, input.material_stride)
                    try package_append_byte(output, 10u8)
                if not package_is_omitted(input.omitted_fields, "slot_materials_b64"):
                    try package_append_base64_field(output, "slot_materials_b64", material_bytes)

            if input.has_normal_scales:
                normal_scale_bytes: mutable darray[u8] = []
                for value in input.normal_scales |normal_scale_bytes|:
                    try package_append_f32_le(normal_scale_bytes, value)
                if not package_is_omitted(input.omitted_fields, "slot_normal_scale_stride"):
                    try package_append_ascii(output, "slot_normal_scale_stride=")
                    try package_append_ascii(output, input.normal_scale_stride)
                    try package_append_byte(output, 10u8)
                if not package_is_omitted(input.omitted_fields, "slot_normal_scales_b64"):
                    try package_append_base64_field(output, "slot_normal_scales_b64", normal_scale_bytes)

            if input.has_occlusion_strengths:
                occlusion_bytes: mutable darray[u8] = []
                for value in input.occlusion_strengths |occlusion_bytes|:
                    try package_append_f32_le(occlusion_bytes, value)
                if not package_is_omitted(input.omitted_fields, "slot_occlusion_strength_stride"):
                    try package_append_ascii(output, "slot_occlusion_strength_stride=")
                    try package_append_ascii(output, input.occlusion_strength_stride)
                    try package_append_byte(output, 10u8)
                if not package_is_omitted(input.omitted_fields, "slot_occlusion_strengths_b64"):
                    try package_append_base64_field(output, "slot_occlusion_strengths_b64", occlusion_bytes)

            if input.has_clearcoat_factors:
                clearcoat_bytes: mutable darray[u8] = []
                for record in input.clearcoat_factors |clearcoat_bytes|:
                    try package_append_f32_le(clearcoat_bytes, record.factor)
                    try package_append_f32_le(clearcoat_bytes, record.roughness)
                    try package_append_f32_le(clearcoat_bytes, record.normal_scale)
                if not package_is_omitted(input.omitted_fields, "slot_clearcoat_factor_stride"):
                    try package_append_ascii(output, "slot_clearcoat_factor_stride=")
                    try package_append_ascii(output, input.clearcoat_factor_stride)
                    try package_append_byte(output, 10u8)
                if not package_is_omitted(input.omitted_fields, "slot_clearcoat_factors_b64"):
                    try package_append_base64_field(output, "slot_clearcoat_factors_b64", clearcoat_bytes)

            if input.has_material_names or input.has_material_name_payload:
                names_bytes: darray[u8] = input.material_name_payload
                if not input.has_material_name_payload:
                    generated_names: mutable darray[u8] = []
                    for name in input.material_names |generated_names|:
                        try package_validate_utf8(name)
                        try package_append_u32_le(generated_names, sview_len(name).u32())
                        for byte in name |generated_names|:
                            try package_append_byte(generated_names, byte)
                    names_bytes <- generated_names
                if not package_is_omitted(input.omitted_fields, "slot_material_names_b64"):
                    try package_append_base64_field(output, "slot_material_names_b64", names_bytes)

            if input.has_textures:
                references_per_slot: usize = 8 if input.textures.stride == "32" else 5
                texture_name_bytes: mutable darray[u8] = []
                for name in input.textures.names |texture_name_bytes|:
                    for byte in name:
                        raise StripPackageError.NonAsciiTextureName if byte > 127u8
                    try package_append_u32_le(texture_name_bytes, sview_len(name).u32())
                    try package_append_ascii(texture_name_bytes, name)
                texture_reference_bytes: mutable darray[u8] = []
                for reference in input.textures.references |texture_reference_bytes, references_per_slot|:
                    raise StripPackageError.InvalidTextureReferenceCount if reference.values.count > references_per_slot
                    for value in reference.values |texture_reference_bytes|:
                        try package_append_u32_le(texture_reference_bytes, value)
                    for _ in reference.values.count..<references_per_slot |texture_reference_bytes|:
                        try package_append_u32_le(texture_reference_bytes, 0u32)
                if not package_is_omitted(input.omitted_fields, "texture_count"):
                    try package_append_ascii(output, "texture_count=")
                    try package_append_u32_decimal(output, input.textures.count_override if input.textures.has_count_override else input.textures.names.count.u32())
                    try package_append_byte(output, 10u8)
                if not package_is_omitted(input.omitted_fields, "texture_names_b64"):
                    try package_append_base64_field(output, "texture_names_b64", texture_name_bytes)
                if not package_is_omitted(input.omitted_fields, "slot_texture_stride"):
                    try package_append_ascii(output, "slot_texture_stride=")
                    try package_append_ascii(output, input.textures.stride)
                    try package_append_byte(output, 10u8)
                if not package_is_omitted(input.omitted_fields, "slot_textures_b64"):
                    try package_append_base64_field(output, "slot_textures_b64", texture_reference_bytes)

            positions: mutable darray[u8] = []
            normals: mutable darray[u8] = []
            uvs: mutable darray[u8] = []
            indices: mutable darray[u8] = []
            for triangle in 0..<input.triangle_count |positions, triangle|:
                try package_append_f32_le(positions, triangle.f32())
                try package_append_f32_le(positions, 0.0f32)
                try package_append_f32_le(positions, 0.0f32)
                try package_append_f32_le(positions, (triangle + 1u32).f32())
                try package_append_f32_le(positions, 0.0f32)
                try package_append_f32_le(positions, 0.0f32)
                try package_append_f32_le(positions, triangle.f32())
                try package_append_f32_le(positions, 1.0f32)
                try package_append_f32_le(positions, 0.0f32)
            for _ in 0..<vertices |normals, uvs, indices|:
                try package_append_f32_le(normals, 0.0f32)
                try package_append_f32_le(normals, 0.0f32)
                try package_append_f32_le(normals, 1.0f32)
                try package_append_f32_le(uvs, 0.0f32)
                try package_append_f32_le(uvs, 0.0f32)
            for index in 0..<vertices |indices, index|:
                try package_append_u32_le(indices, index)
            try package_append_base64_field(output, "positions_b64", positions)
            try package_append_base64_field(output, "normals_b64", normals)
            try package_append_base64_field(output, "uvs_b64", uvs)
            try package_append_base64_field(output, "indices_b64", indices)

            if input.skinned:
                skin_indices: mutable darray[u8] = []
                skin_weights: mutable darray[u8] = []
                skin_name: darray[u8] = [114u8, 111u8, 111u8, 116u8]
                skin_names: mutable darray[u8] = []
                parents: mutable darray[u8] = []
                rest: mutable darray[u8] = []
                joint_names: mutable darray[u8] = []
                cluster_joints: mutable darray[u8] = []
                for _ in 0..<vertices |skin_indices, skin_weights|:
                    for _ in 0..<4 |skin_indices|:
                        try package_append_u32_le(skin_indices, 0u32)
                    try package_append_f32_le(skin_weights, 1.0f32)
                    try package_append_f32_le(skin_weights, 0.0f32)
                    try package_append_f32_le(skin_weights, 0.0f32)
                    try package_append_f32_le(skin_weights, 0.0f32)
                try package_append_name_record(skin_names, skin_name)
                try package_append_u32_le(parents, 0xffffffffu32)
                for value in [0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 1.0f32, 1.0f32, 1.0f32] |rest|:
                    try package_append_f32_le(rest, value)
                try package_append_name_record(joint_names, skin_name)
                try package_append_u32_le(cluster_joints, 0u32)
                try package_append_ascii(output, "skin_bones=1\nskin_indices_stride=16\nskin_weights_stride=16\n")
                try package_append_base64_field(output, "skin_indices_b64", skin_indices)
                try package_append_base64_field(output, "skin_weights_b64", skin_weights)
                try package_append_base64_field(output, "skin_names_b64", skin_names)
                try package_append_ascii(output, "skin_joints=1\nskin_joint_parent_stride=4\nskin_joint_rest_stride=40\n")
                try package_append_base64_field(output, "skin_joint_parents_b64", parents)
                try package_append_base64_field(output, "skin_joint_rest_b64", rest)
                try package_append_base64_field(output, "skin_joint_names_b64", joint_names)
                try package_append_ascii(output, "skin_cluster_joints_stride=4\n")
                try package_append_base64_field(output, "skin_cluster_joints_b64", cluster_joints)
                try package_append_ascii(output, "animation_clips=0\n")
            return output


    private:
        const module Limits:
            MAX_TRIANGLES: u32 = 349525u32
            MAX_RECORDS: usize = 1048576
            MAX_PACKAGE_BYTES: usize = 134217728


        def package_is_omitted(omitted_fields: darray[sview], key: sview) -> bool:
            for field in omitted_fields |key|:
                return true if field == key
            return false


        def package_validate_utf8(value: sview) -> void error[StripPackageError]:
            catch decode_utf8(value):
                ok decoded:
                    _ = decoded
                    return
                error failure:
                    _ = failure
                    raise StripPackageError.InvalidTextEncoding


        def package_append_byte(output: mutable darray[u8]&, value: u8) -> void error[StripPackageError] can[Memory.Allocate, Abort.Panic]:
            raise StripPackageError.PackageTooLarge if output.count >= Limits::MAX_PACKAGE_BYTES
            output.push(value)


        def package_append_ascii(output: mutable darray[u8]&, value: sview) -> void error[StripPackageError] can[Memory.Allocate, Abort.Panic]:
            for byte in value |output|:
                raise StripPackageError.NonAsciiPackageText if byte > 127u8
                try package_append_byte(output, byte)


        def package_append_u32_decimal(output: mutable darray[u8]&, value: u32) -> void error[StripPackageError] can[Memory.Allocate, Abort.Panic]:
            digits: mutable darray[u8] = []
            remaining: mutable u32 = value
            if remaining == 0u32:
                try package_append_byte(output, 48u8)
                return
            while remaining > 0u32:
                digits.push((remaining % 10u32).u8() + 48u8)
                remaining <- remaining / 10u32
            for index in 0..<digits.count |digits, output|:
                try package_append_byte(output, digits[digits.count - index - 1])


        def package_append_u32_le(output: mutable darray[u8]&, value: u32) -> void error[StripPackageError] can[Memory.Allocate, Abort.Panic]:
            try package_append_byte(output, (value & 255u32).u8())
            try package_append_byte(output, ((value >> 8) & 255u32).u8())
            try package_append_byte(output, ((value >> 16) & 255u32).u8())
            try package_append_byte(output, (value >> 24).u8())


        def package_append_f32_le(output: mutable darray[u8]&, value: f32) -> void error[StripPackageError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            bits: mutable u32 = 0u32
            _ = memcpy((&bits).cast[mutable void&], (&value).cast[void&], 4)
            try package_append_u32_le(output, bits)


        def package_append_base64_field(output: mutable darray[u8]&, key: sview, source: darray[u8]) -> void error[StripPackageError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            encoded: mutable darray[u8] = []
            catch encode_base64(bytes_view(source), Limits::MAX_PACKAGE_BYTES):
                ok bytes:
                    encoded <- bytes
                error failure:
                    _ = failure
                    raise StripPackageError.Base64Failure
            try package_append_ascii(output, key)
            try package_append_byte(output, 61u8)
            for byte in encoded |output|:
                try package_append_byte(output, byte)
            try package_append_byte(output, 10u8)


        def package_append_name_record(output: mutable darray[u8]&, name: darray[u8]) -> void error[StripPackageError] can[Memory.Allocate, Abort.Panic]:
            try package_append_u32_le(output, name.count.u32())
            for byte in name |output|:
                try package_append_byte(output, byte)
