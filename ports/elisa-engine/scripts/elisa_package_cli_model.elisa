# Typed pure helpers from elisa-engine/scripts/elisa_package.py.
# Filesystem publication and ELPK compression/serialization remain adapter work.

module EsElisaPackageCli:
    public:
        struct TextureArgument:
            section_name: sview
            path: sview


        error PackageCliError:
            InvalidTextureArgument
            DuplicateTextureSection


        def safe_section_name(name: sview) -> bool:
            length: usize = sview_len(name)
            return false if length == 0 or length > Limits::SECTION_NAME_BYTES
            for byte in name:
                lowercase: bool = byte >= 97u8 and byte <= 122u8
                digit: bool = byte >= 48u8 and byte <= 57u8
                return false if not lowercase and not digit and byte != 95u8
            return true


        def safe_logical_path(path: sview) -> bool:
            length: usize = sview_len(path)
            return false if length == 0
            return false if sview_at(path, 0) == 47u8
            for byte in path:
                return false if byte == 92u8 or byte == 0u8
            return package_logical_segments_safe(path)


        def parse_texture_arguments(values: darray[sview]) -> darray[TextureArgument] error[PackageCliError] can[Memory.Allocate, Abort.Panic]:
            parsed: mutable darray[TextureArgument] = []
            for value in values |parsed|:
                separator: mutable usize = sview_len(value)
                for index in 0..<sview_len(value) |separator|:
                    if sview_at(value, index) == 61u8:
                        separator <- index
                        break
                raise PackageCliError.InvalidTextureArgument if separator == sview_len(value) or separator + 1 == sview_len(value)
                name: sview = value[0:separator]
                path: sview = value[separator + 1:sview_len(value)]
                for earlier in parsed:
                    raise PackageCliError.DuplicateTextureSection if earlier.section_name == name
                parsed.push(TextureArgument{section_name: name, path: path})
            return parsed


    private:
        const module Limits:
            SECTION_NAME_BYTES: usize = 15


        def package_logical_segments_safe(path: sview) -> bool:
            segment_start: mutable usize = 0
            length: usize = sview_len(path)
            for index in 0..<length |segment_start|:
                if sview_at(path, index) == 47u8:
                    return false if package_logical_segment_invalid(path, segment_start, index)
                    segment_start <- index + 1
            return not package_logical_segment_invalid(path, segment_start, length)


        def package_logical_segment_invalid(path: sview, start: usize, finish: usize) -> bool:
            return true if start == finish
            segment: sview = path[start:finish]
            return segment == "." or segment == ".."
