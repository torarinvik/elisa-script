# Bounded command-line option model for check_bundled_notices.py.
module EsEngineBundledNoticesCli:
    public:
        const module Limits:
            ARGUMENTS: usize = 65536
            TEXT_BYTES: usize = 16777216


        const enum CliFailure of u8:
            None
            HelpRequested
            ArgumentLimitExceeded
            MissingOptionValue
            MissingApp
            UnknownOption
            UnexpectedArgument


        struct Options:
            has_app: bool = false
            app: sview = ""
            has_catalog: bool = false
            catalog: sview = ""
            has_output: bool = false
            output: sview = ""


        struct ParseResult:
            options: Options = Options{}
            failure: CliFailure = CliFailure.None
            detail: sview = ""


        def parse_options(arguments: darray[sview]) -> ParseResult can[Memory.Allocate, Abort.Panic]:
            result: mutable ParseResult = ParseResult{}
            if arguments.count > Limits::ARGUMENTS:
                result.failure <- CliFailure.ArgumentLimitExceeded
                return result
            total_bytes: mutable usize = 0
            for argument in arguments |total_bytes|:
                if sview_len(argument) > Limits::TEXT_BYTES - total_bytes:
                    result.failure <- CliFailure.ArgumentLimitExceeded
                    return result
                total_bytes <- total_bytes + sview_len(argument)

            index: mutable usize = 0
            phase: mutable ParsePhase = ParsePhase.Read
            machine over phase while phase != ParsePhase.Done:
                state ParseArguments
                start ParseArguments

                ParseArguments, ParsePhase.Read:
                    if index >= arguments.count:
                        phase <- ParsePhase.Done
                        -> ParseArguments
                    token: sview = arguments[index]
                    if token == "--help" or token == "-h":
                        result.failure <- CliFailure.HelpRequested
                        phase <- ParsePhase.Done
                    elif token == "--":
                        index <- index + 1
                        if index < arguments.count:
                            result.failure <- CliFailure.UnexpectedArgument
                            result.detail <- arguments[index]
                        phase <- ParsePhase.Done
                    elif token == "--app":
                        index <- index + 1
                        phase <- ParsePhase.AppValue
                    elif token == "--catalog":
                        index <- index + 1
                        phase <- ParsePhase.CatalogValue
                    elif token == "--output":
                        index <- index + 1
                        phase <- ParsePhase.OutputValue
                    elif cli_starts_with(token, "--app="):
                        result.options.app <- cli_option_value(token, "--app=")
                        result.options.has_app <- true
                        index <- index + 1
                    elif cli_starts_with(token, "--catalog="):
                        result.options.catalog <- cli_option_value(token, "--catalog=")
                        result.options.has_catalog <- true
                        index <- index + 1
                    elif cli_starts_with(token, "--output="):
                        result.options.output <- cli_option_value(token, "--output=")
                        result.options.has_output <- true
                        index <- index + 1
                    elif cli_starts_with(token, "-"):
                        result.failure <- CliFailure.UnknownOption
                        result.detail <- token
                        phase <- ParsePhase.Done
                    else:
                        result.failure <- CliFailure.UnexpectedArgument
                        result.detail <- token
                        phase <- ParsePhase.Done
                    -> ParseArguments

                ParseArguments, ParsePhase.AppValue:
                    if cli_missing_value(arguments, index):
                        result.failure <- CliFailure.MissingOptionValue
                        result.detail <- "--app"
                        phase <- ParsePhase.Done
                    else:
                        result.options.app <- arguments[index]
                        result.options.has_app <- true
                        index <- index + 1
                        phase <- ParsePhase.Read
                    -> ParseArguments

                ParseArguments, ParsePhase.CatalogValue:
                    if cli_missing_value(arguments, index):
                        result.failure <- CliFailure.MissingOptionValue
                        result.detail <- "--catalog"
                        phase <- ParsePhase.Done
                    else:
                        result.options.catalog <- arguments[index]
                        result.options.has_catalog <- true
                        index <- index + 1
                        phase <- ParsePhase.Read
                    -> ParseArguments

                ParseArguments, ParsePhase.OutputValue:
                    if cli_missing_value(arguments, index):
                        result.failure <- CliFailure.MissingOptionValue
                        result.detail <- "--output"
                        phase <- ParsePhase.Done
                    else:
                        result.options.output <- arguments[index]
                        result.options.has_output <- true
                        index <- index + 1
                        phase <- ParsePhase.Read
                    -> ParseArguments

                ParseArguments, ParsePhase.Done:
                    break
            if result.failure == CliFailure.None and not result.options.has_app:
                result.failure <- CliFailure.MissingApp
            return result


    private:
        const enum ParsePhase of u8:
            Read
            AppValue
            CatalogValue
            OutputValue
            Done


        def cli_starts_with(value: sview, prefix: sview) -> bool:
            return false if sview_len(value) < sview_len(prefix)
            for index in 0..<sview_len(prefix) |value, prefix|:
                return false if sview_at(value, index) != sview_at(prefix, index)
            return true


        def cli_option_value(argument: sview, prefix: sview) -> sview:
            return string_view_slice(argument, sview_len(prefix).i64(), sview_len(argument).i64())


        def cli_missing_value(arguments: darray[sview], index: usize) -> bool:
            return true if index >= arguments.count
            value: sview = arguments[index]
            return sview_len(value) >= 2 and sview_at(value, 0) == 45u8 and sview_at(value, 1) == 45u8
