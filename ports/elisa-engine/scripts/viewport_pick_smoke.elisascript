#!/usr/bin/env elisascript
# Elisascript companion for elisa-engine/scripts/viewport_pick_smoke.py.
# The child render-scene smoke harness remains Python and is an explicit
# migration dependency; this wrapper keeps its cwd, env overlay, status, and
# bounded diagnostic-tail behavior typed.
include "./viewport_pick_smoke_plan.elisa"

using EsEngineViewportPickSmokePlan


module EsEngineViewportPickSmoke:
    private:
        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


    public:
        def run() -> i64 can[Directory.Read, Process.Run, Memory.Allocate, Environment.Read, Abort.Panic, Console.Write, Console.Format]:
            source: Path = try path_real(Script::source_path()) else failure:
                _ = failure
                diagnostic("unable to resolve viewport pick smoke source path")
                return 1i64
            project_root: Path = source.parent().parent().parent().parent().parent().joinpath("elisa-engine")
            resolved_root: Path = try path_real(project_root) else failure:
                _ = failure
                diagnostic("unable to resolve elisa-engine project root")
                return 1i64
            interpreter: sview = EsEngineViewportPickSmokePlan::Defaults::INTERPRETER
            plan: Plan = EsEngineViewportPickSmokePlan::plan(f"{resolved_root}", interpreter)
            command: ProcessCapture = try capture_process_result_in_directory_with_environment(
                executable(plan.interpreter), plan.arguments, "", path(plan.working_directory), plan.environment
            ) else failure:
                _ = failure
                diagnostic("unable to capture viewport pick smoke harness process")
                return 1i64

            execution: mutable ExecutionState = try EsEngineViewportPickSmokePlan::execution_after_child(
                EsEngineViewportPickSmokePlan::initial_execution(), process_exit_status(command)
            ) else invalid:
                _ = invalid
                diagnostic("invalid viewport pick smoke execution state")
                return 1i64
            machine over execution while execution.phase != ExecutionPhase.Done:
                state Dispatch
                start Dispatch

                Dispatch, ExecutionPhase.ReportFailure:
                    stdout_tail: darray[u8] = EsEngineViewportPickSmokePlan::trailing_utf8_codepoints(
                        process_stdout(command), Defaults::OUTPUT_TAIL_CODEPOINTS
                    )
                    stderr_tail: darray[u8] = EsEngineViewportPickSmokePlan::trailing_utf8_codepoints(
                        process_stderr(command), Defaults::OUTPUT_TAIL_CODEPOINTS
                    )
                    _ = write_stderr(bytes_view(stdout_tail))
                    _ = write_stderr(bytes_view(stderr_tail))
                    _ = write_stderr(f"viewport pick smoke failed: exit {execution.child_status}\n")
                    execution <- try EsEngineViewportPickSmokePlan::execution_after_report(execution) else invalid:
                        _ = invalid
                        ExecutionState{phase: ExecutionPhase.Done, child_status: execution.child_status, exit_status: 1}
                    -> Dispatch

                Dispatch, ExecutionPhase.ReportSuccess:
                    _ = write_stdout("viewport pick smoke passed\n")
                    execution <- try EsEngineViewportPickSmokePlan::execution_after_report(execution) else invalid:
                        _ = invalid
                        ExecutionState{phase: ExecutionPhase.Done, child_status: execution.child_status, exit_status: 1}
                    -> Dispatch

                Dispatch, ExecutionPhase.AwaitChild:
                    execution <- ExecutionState{phase: ExecutionPhase.Done, exit_status: 1}
                    -> Dispatch

                Dispatch, ExecutionPhase.Done:
                    break
            return execution.exit_status


def main(arguments: darray[sview]) -> i64 can[Directory.Read, Process.Run, Memory.Allocate, Environment.Read, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsEngineViewportPickSmoke::run()
