# String representation for dependency-manifest diagnostics.
# Mirrors CPython repr's quote choice and ASCII escaping; non-ASCII UTF-8 bytes
# are preserved, so CPython's Unicode isprintable table remains a qualification
# boundary for nonprintable non-ASCII characters.
module EsEngineDependencyManifestRepr:
    private:
        def lowercase_hex_digit(value: u8) -> u8:
            return 48u8 + value if value < 10u8
            return 87u8 + value


        def append_hex_escape(output: mutable darray[u8]&, value: u8) can[Memory.Allocate, Abort.Panic]:
            output.push(92u8)
            output.push(120u8)
            output.push(lowercase_hex_digit(value >> 4))
            output.push(lowercase_hex_digit(value & 15u8))


    public:
        def string_repr(value: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            has_single_quote: bool = sview_contains_byte(value, 39u8)
            has_double_quote: bool = sview_contains_byte(value, 34u8)
            delimiter: u8 = 34u8 if has_single_quote and not has_double_quote else 39u8
            output: mutable darray[u8] = [delimiter]
            for byte in value |output|:
                if byte == 92u8 or byte == delimiter:
                    output.push(92u8)
                    output.push(byte)
                elif byte == 9u8:
                    output.push(92u8)
                    output.push(116u8)
                elif byte == 10u8:
                    output.push(92u8)
                    output.push(110u8)
                elif byte == 13u8:
                    output.push(92u8)
                    output.push(114u8)
                elif byte < 32u8 or byte == 127u8:
                    append_hex_escape(output, byte)
                else:
                    output.push(byte)
            output.push(delimiter)
            return bytes_view(output)
