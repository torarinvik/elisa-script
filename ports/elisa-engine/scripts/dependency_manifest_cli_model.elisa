# Small typed CLI model for check_dependency_manifest.py.
module EsEngineDependencyManifestCli:
    public:
        const enum Failure of u8:
            None
            HelpRequested
            MissingOptionValue
            UnknownOption
            UnexpectedArgument
            ArgumentLimitExceeded


        struct Options:
            has_root: bool = false
            root: sview = ""
            has_manifest: bool = false
            manifest: sview = ""


        struct ParseResult:
            failure: Failure = Failure.None
            detail: sview = ""
            options: Options = Options{}


        def parse_options(arguments: darray[sview]) -> ParseResult:
            return ParseResult{failure: Failure.ArgumentLimitExceeded} if arguments.count > Limits::ARGUMENTS
            options: mutable Options = Options{}
            index: mutable usize = 0
            phase: mutable ParsePhase = ParsePhase.Next
            machine over phase while phase != ParsePhase.Done:
                state Parse
                start Parse

                Parse, ParsePhase.Next:
                    break if index == arguments.count
                    argument: sview = arguments[index]
                    option: OptionToken = split_option(argument)
                    if argument == "-h" or (not option.has_value and long_option_prefix(option.name, "--help")):
                        return ParseResult{failure: Failure.HelpRequested}
                    elif argument == "--":
                        index <- index + 1
                        phase <- ParsePhase.EndOptions
                        -> Parse
                    elif long_option_prefix(option.name, "--root"):
                        if option.has_value:
                            options.root <- option.value
                            options.has_root <- true
                            index <- index + 1
                            -> Parse
                        return ParseResult{failure: Failure.MissingOptionValue, detail: option.name} if index + 1 >= arguments.count or arguments[index + 1].startswith("-")
                        options.root <- arguments[index + 1]
                        options.has_root <- true
                        index <- index + 2
                        -> Parse
                    elif long_option_prefix(option.name, "--manifest"):
                        if option.has_value:
                            options.manifest <- option.value
                            options.has_manifest <- true
                            index <- index + 1
                            -> Parse
                        return ParseResult{failure: Failure.MissingOptionValue, detail: option.name} if index + 1 >= arguments.count or arguments[index + 1].startswith("-")
                        options.manifest <- arguments[index + 1]
                        options.has_manifest <- true
                        index <- index + 2
                        -> Parse
                    elif argument.startswith("-"):
                        return ParseResult{failure: Failure.UnknownOption, detail: argument}
                    else:
                        return ParseResult{failure: Failure.UnexpectedArgument, detail: argument}

                Parse, ParsePhase.EndOptions:
                    return ParseResult{failure: Failure.UnexpectedArgument, detail: arguments[index]} if index < arguments.count
                    phase <- ParsePhase.Done
                    -> Parse

                Parse, ParsePhase.Done:
                    break

            return ParseResult{options: options}


    private:
        struct OptionToken:
            name: sview
            value: sview = ""
            has_value: bool = false


        const module Limits:
            ARGUMENTS: usize = 64


        def split_option(argument: sview) -> OptionToken:
            for index in 0..<len(argument) |argument|:
                if sview_at(argument, index) == 61u8:
                    return OptionToken{name: argument[0:index], value: argument[index + 1:len(argument)], has_value: true}
            return OptionToken{name: argument}


        def long_option_prefix(candidate: sview, supported: sview) -> bool:
            return false if len(candidate) < 3 or len(candidate) > len(supported)
            return candidate == supported[0:len(candidate)]


        const enum ParsePhase of u8:
            Next
            EndOptions
            Done
