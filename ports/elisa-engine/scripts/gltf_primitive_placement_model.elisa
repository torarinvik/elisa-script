# Apply one placement's effective world transform to a decoded triangle
# primitive. The caller supplies identity for placements whose authored node
# transform must be ignored (notably skinned instances).
include "gltf_affine_model.elisa"
include "gltf_node_streams_model.elisa"
include "gltf_tangent_frames_model.elisa"
include "gltf_vertex_streams_model.elisa"

using EsEngineGltfAffine
using EsEngineGltfNodeStreams
using EsEngineGltfTangentFrames
using EsEngineGltfVertexStreams


module EsEngineGltfPrimitivePlacement:
    public:
        error PrimitivePlacementError:
            PositionTransformFailed
            NormalTransformFailed
            TangentTransformFailed
            MorphTransformFailed
            IndexTransformFailed


        # This handles authored streams only. Missing normals and tangents
        # remain explicit so the geometry cooker can generate them from the
        # complete placement's topology and UV seams later.
        def transform_triangle_primitive(primitive: TrianglePrimitive, matrix: Affine3x4) TrianglePrimitive error[PrimitivePlacementError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            positions: darray[u8] = try transform_points(primitive.vertices.positions, matrix) else failure:
                _ = failure
                raise PrimitivePlacementError.PositionTransformFailed

            normals: darray[u8] = []
            if primitive.vertices.has_normals:
                normals <- try transform_normals(primitive.vertices.normals, matrix) else failure:
                    _ = failure
                    raise PrimitivePlacementError.NormalTransformFailed

            tangents: darray[u8] = []
            if primitive.vertices.has_tangents:
                matrix_values: darray[f64] = affine_to_values(matrix)
                tangents <- try transform_authored_tangent_bytes(primitive.vertices.tangents, normals, matrix_values) else failure:
                    _ = failure
                    raise PrimitivePlacementError.TangentTransformFailed

            morph_targets: mutable darray[MorphTargetStreams] = []
            for target in primitive.vertices.morph_targets |matrix, morph_targets|:
                morph_positions: darray[u8] = try transform_vectors(target.positions, matrix) else failure:
                    _ = failure
                    raise PrimitivePlacementError.MorphTransformFailed
                morph_normals: darray[u8] = []
                if target.has_normals:
                    morph_normals <- try transform_normal_deltas(target.normals, matrix) else failure:
                        _ = failure
                        raise PrimitivePlacementError.MorphTransformFailed
                morph_targets.push(MorphTargetStreams{
                    positions: morph_positions,
                    has_normals: target.has_normals,
                    normals: morph_normals
                })

            triangles: darray[u32] = try placed_indices(primitive.triangles, matrix) else failure:
                _ = failure
                raise PrimitivePlacementError.IndexTransformFailed
            vertices: VertexStreams = VertexStreams{
                positions: positions,
                has_normals: primitive.vertices.has_normals,
                normals: normals,
                has_tangents: primitive.vertices.has_tangents,
                tangents: tangents,
                uvs: primitive.vertices.uvs,
                has_uv1s: primitive.vertices.has_uv1s,
                uv1s: primitive.vertices.uv1s,
                has_skin: primitive.vertices.has_skin,
                skin: primitive.vertices.skin,
                morph_targets: morph_targets,
                count: primitive.vertices.count,
                triangles: []
            }
            return TrianglePrimitive{vertices: vertices, triangles: triangles}
