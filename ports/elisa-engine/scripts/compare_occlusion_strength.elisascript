#!/usr/bin/env elisascript
# Elisa implementation of elisa-engine/scripts/compare_occlusion_strength.py.
include "./render_quality_model.elisa"
include "./render_quality_cli.elisa"

using EsEngineRenderQuality
using EsEngineRenderQualityCli


module EsEngineCompareOcclusionStrength:
    private:
        const module Messages:
            USAGE: sview = "usage: compare_occlusion_strength.py <occluded.png> <strength-zero.png>\n"
            READ_FAILURE: sview = "compare_occlusion_strength: unable to read capture PNG\n"
            DECODE_FAILURE: sview = "compare_occlusion_strength: unable to decode capture PNG\n"
            INCOMPATIBLE: sview = "AO reference captures have different dimensions or formats\n"
            METRICS_FAILURE: sview = "compare_occlusion_strength: capture is too small for quality sampling\n"
            BELOW_THRESHOLD: sview = "AO strength darkening is below 0.010\n"


    public:
        def run(arguments: darray[sview]) -> i64 can[File.Read, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format]:
            if arguments.count != 2:
                _ = write_stderr(Messages::USAGE)
                return 2i64

            occluded_bytes: darray[u8] = try read_bytes(path(arguments[0])) else failure:
                _ = failure
                _ = write_stderr(Messages::READ_FAILURE)
                return 1i64
            zero_strength_bytes: darray[u8] = try read_bytes(path(arguments[1])) else failure:
                _ = failure
                _ = write_stderr(Messages::READ_FAILURE)
                return 1i64
            occluded: RenderFrame = try decode_png(occluded_bytes) else failure:
                _ = failure
                _ = write_stderr(Messages::DECODE_FAILURE)
                return 1i64
            zero_strength: RenderFrame = try decode_png(zero_strength_bytes) else failure:
                _ = failure
                _ = write_stderr(Messages::DECODE_FAILURE)
                return 1i64

            if occluded.width != zero_strength.width or occluded.height != zero_strength.height or occluded.format != zero_strength.format:
                _ = write_stderr(Messages::INCOMPATIBLE)
                return 1i64

            metrics: OcclusionStrengthMetrics = try occlusion_strength_metrics(occluded, zero_strength) else failure:
                _ = failure
                _ = write_stderr(Messages::METRICS_FAILURE)
                return 1i64
            print("occlusion strength: strength=0.65 luminance=" + fixed_four_decimal(metrics.occluded_luminance) + ", strength=0 luminance=" + fixed_four_decimal(metrics.strength_zero_luminance) + ", darkening=" + fixed_four_decimal(metrics.darkening))
            if not metrics.passes:
                _ = write_stderr(Messages::BELOW_THRESHOLD)
                return 1i64
            return 0i64


def main(arguments: darray[sview]) -> i64 can[File.Read, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format]:
    return EsEngineCompareOcclusionStrength::run(arguments)
