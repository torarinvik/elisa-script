#!/usr/bin/env elisascript
# ElisaScript counterpart for elisa-engine-mocap/scripts/test_shader_permutation_selection.py.
include "../../../src/runtime/encoding.elisa"
include "../../../src/runtime/data_model.elisa"
include "../../../src/runtime/json_model.elisa"
include "../../../src/runtime/json_lexer_model.elisa"
include "../../../src/runtime/json_parse_model.elisa"
include "../../../src/runtime/bounded_text_posix.elisa"
include "../../../src/runtime/shader_permutation_selection_model.elisa"
include "../../../src/runtime/shader_permutation_selection_posix.elisa"

using EsShaderPermutationSelection
using EsShaderPermutationSelectionPosix


module EsEngineShaderPermutationSelectionTest:
    private:
        struct InvalidSelection:
            source: sview
            expected: SelectionError


        def selection_file_rejected(file_path: Path, source: sview, expected: SelectionError) -> bool can[Blocking.IO, File.Read, File.Write, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            payload: mutable darray[u8] = []
            for byte in source |payload|:
                payload.push(byte)
            written: usize = try write_bytes(file_path, payload) else 0usize
            return false if written != payload.count

            rejected: mutable bool = false
            catch read_shader_selection_file(file_path):
                ok selection:
                    _ = selection
                error failure:
                    rejected <- failure == expected
            return rejected


        def remove_temporary_selection(file_path: Path, directory: Path) -> bool can[Blocking.IO, File.Write, Directory.Read, Directory.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            file_removed: bool = try remove_path(file_path) else false
            directory_removed: bool = try remove_directory(directory) else false
            return file_removed and directory_removed


    public:
        def run() -> i64 can[Blocking.IO, File.Read, File.Write, Directory.Read, Directory.Write, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
            temporary: Path = try temp_directory("shader-selection-test") else err:
                print("unable to create shader-selection test directory")
                return 1i64
            file_path: Path = temporary.joinpath("selection.json")
            invalid_selections: darray[InvalidSelection] = [
                InvalidSelection{source: "[]", expected: SelectionError.NonemptyBoundedArrayRequired},
                InvalidSelection{source: "{}", expected: SelectionError.NonemptyBoundedArrayRequired},
                InvalidSelection{source: "[1]", expected: SelectionError.NamesMustBeStrings},
                InvalidSelection{source: "[\"../escape.cso\"]", expected: SelectionError.InvalidOrDuplicateName},
                InvalidSelection{source: "[\"/absolute.cso\"]", expected: SelectionError.InvalidOrDuplicateName},
                InvalidSelection{source: "[\"a.cso\",\"a.cso\"]", expected: SelectionError.InvalidOrDuplicateName},
                InvalidSelection{source: "[\"a//b.cso\"]", expected: SelectionError.InvalidOrDuplicateName},
                InvalidSelection{source: "[\"a.txt\"]", expected: SelectionError.InvalidOrDuplicateName},
                InvalidSelection{source: "[\"a\\\\b.cso\"]", expected: SelectionError.InvalidOrDuplicateName}
            ]
            failed: mutable bool = false
            for case in invalid_selections:
                if not selection_file_rejected(file_path, case.source, case.expected):
                    print("shader permutation selection did not reject expected error for " + case.source)
                    failed <- true
                    break
            cleaned: bool = remove_temporary_selection(file_path, temporary)
            if not cleaned:
                print("unable to clean shader-selection test directory")
                return 1i64
            if failed:
                return 1i64
            print("shader permutation selection rejection tests passed.")
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsEngineShaderPermutationSelectionTest::run()
