# Fixed-shape row-major affine matrices shared by glTF node and skin ports.
include "../../../vendor/elisa-compiler/elisacore_std/elisacore_math.elisa"

module EsEngineGltfAffine:
    public:
        const module Limits:
            MAXIMUM_F64: f64 = 1.7976931348623157e308
            ROTATION_TOLERANCE: f64 = 0.001


        struct Vec3:
            x: f64 = 0.0
            y: f64 = 0.0
            z: f64 = 0.0


        struct Quaternion:
            x: f64 = 0.0
            y: f64 = 0.0
            z: f64 = 0.0
            w: f64 = 1.0


        struct Affine3x4:
            m00: f64 = 0.0
            m01: f64 = 0.0
            m02: f64 = 0.0
            m03: f64 = 0.0
            m10: f64 = 0.0
            m11: f64 = 0.0
            m12: f64 = 0.0
            m13: f64 = 0.0
            m20: f64 = 0.0
            m21: f64 = 0.0
            m22: f64 = 0.0
            m23: f64 = 0.0


        error AffineError:
            InvalidValueCount
            NonFiniteValue
            RotationNotUnit
            MatrixNotAffine
            NotInvertible


        # Dynamic input is accepted only at the decoding boundary. Once
        # converted, multiplication/inversion operate on a statically shaped
        # record and cannot receive fewer or extra than twelve components.
        def affine_from_values(values: darray[f64]) -> Affine3x4 error[AffineError]:
            raise AffineError.InvalidValueCount if values.count != 12
            return Affine3x4{
                m00: values[0], m01: values[1], m02: values[2], m03: values[3],
                m10: values[4], m11: values[5], m12: values[6], m13: values[7],
                m20: values[8], m21: values[9], m22: values[10], m23: values[11]
            }


        # Dynamic component lists are accepted only at decode boundaries. The
        # returned records encode their dimensions in the Elisa type system.
        def vec3_from_values(values: darray[f64]) -> Vec3 error[AffineError]:
            raise AffineError.InvalidValueCount if values.count != 3
            for index in 0..<values.count |values|:
                raise AffineError.NonFiniteValue if not affine_finite(values[index])
            return Vec3{x: values[0], y: values[1], z: values[2]}


        def quaternion_from_values(values: darray[f64]) -> Quaternion error[AffineError]:
            raise AffineError.InvalidValueCount if values.count != 4
            for index in 0..<values.count |values|:
                raise AffineError.NonFiniteValue if not affine_finite(values[index])
            return Quaternion{x: values[0], y: values[1], z: values[2], w: values[3]}


        # glTF matrices are column-major 4x4 values. Validate the homogeneous
        # bottom row before reducing to our row-major affine 3x4 layout.
        def affine_from_column_major(values: darray[f64]) -> Affine3x4 error[AffineError]:
            raise AffineError.InvalidValueCount if values.count != 16
            for index in 0..<values.count |values|:
                raise AffineError.NonFiniteValue if not affine_finite(values[index])
            raise AffineError.MatrixNotAffine if values[3] != 0.0 or values[7] != 0.0 or values[11] != 0.0 or values[15] != 1.0
            return Affine3x4{
                m00: values[0], m01: values[4], m02: values[8], m03: values[12],
                m10: values[1], m11: values[5], m12: values[9], m13: values[13],
                m20: values[2], m21: values[6], m22: values[10], m23: values[14]
            }


        # Mirrors cook_gltf_nodes.local_matrix's TRS path, including tolerant
        # acceptance of rounded unit quaternions followed by normalization.
        def affine_from_trs(translation: Vec3, rotation: Quaternion, scale: Vec3) -> Affine3x4 error[AffineError]:
            raise AffineError.NonFiniteValue if not affine_finite(translation.x) or not affine_finite(translation.y) or not affine_finite(translation.z)
            raise AffineError.NonFiniteValue if not affine_finite(rotation.x) or not affine_finite(rotation.y) or not affine_finite(rotation.z) or not affine_finite(rotation.w)
            raise AffineError.NonFiniteValue if not affine_finite(scale.x) or not affine_finite(scale.y) or not affine_finite(scale.z)
            rotation_length: f64 = sqrt(rotation.x * rotation.x + rotation.y * rotation.y + rotation.z * rotation.z + rotation.w * rotation.w)
            raise AffineError.RotationNotUnit if not affine_finite(rotation_length) or fabs(rotation_length - 1.0) > Limits::ROTATION_TOLERANCE
            x: f64 = rotation.x / rotation_length
            y: f64 = rotation.y / rotation_length
            z: f64 = rotation.z / rotation_length
            w: f64 = rotation.w / rotation_length
            return Affine3x4{
                m00: (1.0 - 2.0 * (y * y + z * z)) * scale.x,
                m01: 2.0 * (x * y - z * w) * scale.y,
                m02: 2.0 * (x * z + y * w) * scale.z,
                m03: translation.x,
                m10: 2.0 * (x * y + z * w) * scale.x,
                m11: (1.0 - 2.0 * (x * x + z * z)) * scale.y,
                m12: 2.0 * (y * z - x * w) * scale.z,
                m13: translation.y,
                m20: 2.0 * (x * z - y * w) * scale.x,
                m21: 2.0 * (y * z + x * w) * scale.y,
                m22: (1.0 - 2.0 * (x * x + y * y)) * scale.z,
                m23: translation.z
            }


        def affine_to_values(matrix: Affine3x4) -> darray[f64] can[Memory.Allocate, Abort.Panic]:
            return [
                matrix.m00, matrix.m01, matrix.m02, matrix.m03,
                matrix.m10, matrix.m11, matrix.m12, matrix.m13,
                matrix.m20, matrix.m21, matrix.m22, matrix.m23
            ]


        # `a` is applied after `b`, matching cook_gltf_nodes.multiply.
        def multiply_affine(a: Affine3x4, b: Affine3x4) -> Affine3x4:
            return Affine3x4{
                m00: a.m00 * b.m00 + a.m01 * b.m10 + a.m02 * b.m20,
                m01: a.m00 * b.m01 + a.m01 * b.m11 + a.m02 * b.m21,
                m02: a.m00 * b.m02 + a.m01 * b.m12 + a.m02 * b.m22,
                m03: a.m00 * b.m03 + a.m01 * b.m13 + a.m02 * b.m23 + a.m03,
                m10: a.m10 * b.m00 + a.m11 * b.m10 + a.m12 * b.m20,
                m11: a.m10 * b.m01 + a.m11 * b.m11 + a.m12 * b.m21,
                m12: a.m10 * b.m02 + a.m11 * b.m12 + a.m12 * b.m22,
                m13: a.m10 * b.m03 + a.m11 * b.m13 + a.m12 * b.m23 + a.m13,
                m20: a.m20 * b.m00 + a.m21 * b.m10 + a.m22 * b.m20,
                m21: a.m20 * b.m01 + a.m21 * b.m11 + a.m22 * b.m21,
                m22: a.m20 * b.m02 + a.m21 * b.m12 + a.m22 * b.m22,
                m23: a.m20 * b.m03 + a.m21 * b.m13 + a.m22 * b.m23 + a.m23
            }


        # Keep the reference's cofactor and accumulation order for
        # near-singular behavior and floating-point differential fidelity.
        def determinant_affine(matrix: Affine3x4) -> f64:
            cofactor_0: f64 = matrix.m11 * matrix.m22 - matrix.m12 * matrix.m21
            cofactor_1: f64 = matrix.m12 * matrix.m20 - matrix.m10 * matrix.m22
            cofactor_2: f64 = matrix.m10 * matrix.m21 - matrix.m11 * matrix.m20
            return matrix.m00 * cofactor_0 + matrix.m01 * cofactor_1 + matrix.m02 * cofactor_2


        def affine_is_finite(matrix: Affine3x4) -> bool:
            return affine_finite(matrix.m00) and affine_finite(matrix.m01) and affine_finite(matrix.m02) and affine_finite(matrix.m03) and affine_finite(matrix.m10) and affine_finite(matrix.m11) and affine_finite(matrix.m12) and affine_finite(matrix.m13) and affine_finite(matrix.m20) and affine_finite(matrix.m21) and affine_finite(matrix.m22) and affine_finite(matrix.m23)


        def inverse_affine(matrix: Affine3x4) -> Affine3x4 error[AffineError]:
            determinant: f64 = determinant_affine(matrix)
            raise AffineError.NotInvertible if not affine_finite(determinant) or determinant == 0.0

            inverse_00: f64 = (matrix.m11 * matrix.m22 - matrix.m12 * matrix.m21) / determinant
            inverse_01: f64 = (matrix.m02 * matrix.m21 - matrix.m01 * matrix.m22) / determinant
            inverse_02: f64 = (matrix.m01 * matrix.m12 - matrix.m02 * matrix.m11) / determinant
            inverse_10: f64 = (matrix.m12 * matrix.m20 - matrix.m10 * matrix.m22) / determinant
            inverse_11: f64 = (matrix.m00 * matrix.m22 - matrix.m02 * matrix.m20) / determinant
            inverse_12: f64 = (matrix.m02 * matrix.m10 - matrix.m00 * matrix.m12) / determinant
            inverse_20: f64 = (matrix.m10 * matrix.m21 - matrix.m11 * matrix.m20) / determinant
            inverse_21: f64 = (matrix.m01 * matrix.m20 - matrix.m00 * matrix.m21) / determinant
            inverse_22: f64 = (matrix.m00 * matrix.m11 - matrix.m01 * matrix.m10) / determinant
            return Affine3x4{
                m00: inverse_00,
                m01: inverse_01,
                m02: inverse_02,
                m03: -(inverse_00 * matrix.m03 + inverse_01 * matrix.m13 + inverse_02 * matrix.m23),
                m10: inverse_10,
                m11: inverse_11,
                m12: inverse_12,
                m13: -(inverse_10 * matrix.m03 + inverse_11 * matrix.m13 + inverse_12 * matrix.m23),
                m20: inverse_20,
                m21: inverse_21,
                m22: inverse_22,
                m23: -(inverse_20 * matrix.m03 + inverse_21 * matrix.m13 + inverse_22 * matrix.m23)
            }


    private:
        def affine_finite(value: f64) -> bool:
            return value <= Limits::MAXIMUM_F64 and value >= -Limits::MAXIMUM_F64
