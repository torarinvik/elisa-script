# Typed argv and fail-fast transitions for ../elisa-engine/scripts/test_crash_report.py.
module EsEngineCrashReportTestPlan:
    public:
        const module Defaults:
            COMPILER: sview = "clang++"
            TEMP_PREFIX: sview = "elisa-crash-report-test-"
            EXECUTABLE_NAME: sview = "crash-report-test"
            REPORTS_DIRECTORY: sview = "reports"
            CXX_STANDARD: sview = "-std=c++17"
            OPTIMIZATION: sview = "-O0"
            DEBUG: sview = "-g"
            EXPORT_SYMBOLS: sview = "-rdynamic"
            INCLUDE_FLAG: sview = "-I"
            OUTPUT_FLAG: sview = "-o"
            NATIVE_INCLUDE: sview = "native"
            TEST_SOURCE: sview = "test/crash_report_test.cpp"
            PROBE_ARGUMENT: sview = "--probe-arg"
            REPORT_PATTERN: sview = "crash-*.txt"
            MAX_REPORT_BYTES: usize = 65536


        const enum ExecutionPhase of u8:
            Prepare
            Compile
            Run
            ShowReports
            Cleanup
            ReportSuccess
            Done


        struct Command:
            program: sview
            arguments: darray[sview]


        struct Plan:
            temporary_directory: sview
            executable_path: sview
            reports_directory: sview
            compile_command: Command
            test_command: Command


        struct ExecutionState:
            phase: ExecutionPhase = ExecutionPhase.Prepare
            exit_status: i64 = 0
            report_success_after_cleanup: bool = false


        error PlanError:
            InvalidExecutionState


        def plan(root: sview, temporary_directory: sview, compiler: sview) -> Plan can[Memory.Allocate, Abort.Panic]:
            executable_path: sview = project_path(temporary_directory, Defaults::EXECUTABLE_NAME)
            reports_directory: sview = project_path(temporary_directory, Defaults::REPORTS_DIRECTORY)
            return Plan{
                temporary_directory: temporary_directory,
                executable_path: executable_path,
                reports_directory: reports_directory,
                compile_command: Command{
                    program: compiler,
                    arguments: [
                        Defaults::CXX_STANDARD, Defaults::OPTIMIZATION, Defaults::DEBUG,
                        Defaults::EXPORT_SYMBOLS, Defaults::INCLUDE_FLAG,
                        project_path(root, Defaults::NATIVE_INCLUDE),
                        project_path(root, Defaults::TEST_SOURCE),
                        Defaults::OUTPUT_FLAG, executable_path
                    ]
                },
                test_command: Command{
                    program: executable_path,
                    arguments: [reports_directory, Defaults::PROBE_ARGUMENT]
                }
            }


        def initial_execution() -> ExecutionState:
            return ExecutionState{phase: ExecutionPhase.Prepare}


        def execution_after_prepare(state: ExecutionState, succeeded: bool) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Prepare
            return ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: 1} if not succeeded
            return ExecutionState{phase: ExecutionPhase.Compile}


        def execution_after_compile(state: ExecutionState, status: i64) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Compile
            return ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: status} if status != 0
            return ExecutionState{phase: ExecutionPhase.Run}


        def execution_after_run(state: ExecutionState, status: i64, started: bool) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Run
            return ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: status} if not started
            return ExecutionState{phase: ExecutionPhase.ShowReports, exit_status: status} if status != 0
            return ExecutionState{phase: ExecutionPhase.Cleanup, report_success_after_cleanup: true}


        def execution_after_reports(state: ExecutionState, succeeded: bool) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.ShowReports
            return ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: 1} if not succeeded
            return ExecutionState{phase: ExecutionPhase.Cleanup, exit_status: state.exit_status}


        def execution_after_cleanup(state: ExecutionState, succeeded: bool) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.Cleanup
            return ExecutionState{phase: ExecutionPhase.Done, exit_status: 1} if not succeeded
            return ExecutionState{phase: ExecutionPhase.ReportSuccess} if succeeded and state.report_success_after_cleanup
            return ExecutionState{phase: ExecutionPhase.Done, exit_status: state.exit_status}


        def execution_after_success_report(state: ExecutionState) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.ReportSuccess
            return ExecutionState{phase: ExecutionPhase.Done, exit_status: state.exit_status}


    private:
        def project_path(root: sview, relative: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return relative if root == ""
            return "/" + relative if root == "/"
            return root + "/" + relative
