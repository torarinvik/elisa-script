#!/usr/bin/env elisascript
# Elisascript companion for elisa-engine/scripts/build_nav_native_test.sh.
# The Bash original remains the reference until process parity is qualified.
include "./build_nav_native_test_plan.elisa"

using EsEngineNavNativeTestBuildPlan


module EsEngineNavNativeTestBuild:
    private:
        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def execute(command: Command) -> i64 can[Process.Run, Memory.Allocate, Console.Write]:
            status: i64 = try run_process(executable(command.program), command.arguments) else err:
                diagnostic("unable to start build command: " + command.program)
                return 127i64
            return status


    public:
        def run(arguments: darray[sview]) -> i64 can[Directory.Read, Directory.Write, Environment.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            if arguments.count == 0 or arguments[0] == "":
                diagnostic("test name required")
                return 1i64

            engine_root: Path = try path_real(Script::source_path().parent().parent().parent().parent().parent().joinpath("elisa-engine")) else err:
                diagnostic("unable to resolve elisa-engine project root")
                return 1i64
            if not is_directory(engine_root):
                diagnostic("elisa-engine project root is not a directory")
                return 1i64

            configured_compiler: sview = get_environment_or("ELISA_COMPILER_BIN", "")
            compiler: sview = Defaults::COMPILER if configured_compiler == "" else configured_compiler
            configured_runtime: sview = get_environment_or("ELISA_RUNTIME_OBJECT", "")
            runtime_object: sview = configured_runtime
            if runtime_object == "":
                home: sview = get_environment_or("HOME", "")
                if home == "":
                    diagnostic("HOME is required when ELISA_RUNTIME_OBJECT is unset")
                    return 1i64
                runtime_object <- home + "/.elisac/stage1/build/runtime/elisacore_runtime.o"

            plan: Plan = try EsEngineNavNativeTestBuildPlan::plan(
                f"{engine_root}", arguments[0], compiler, runtime_object
            ) else err:
                diagnostic("invalid native navigation test build request")
                return 1i64

            execution: mutable ExecutionState = initial_execution(plan.commands.count)
            machine over execution while execution.phase != ExecutionPhase.Done:
                state Dispatch
                start Dispatch

                Dispatch, ExecutionPhase.Prepare:
                    created: bool = try create_directories(path(plan.build_directory)) else err:
                        diagnostic("unable to create build directory")
                        execution <- ExecutionState{phase: ExecutionPhase.Done, command_count: execution.command_count, exit_status: 1}
                        -> Dispatch
                    execution <- try execution_after_prepare(execution, created) else err:
                        diagnostic("invalid build execution state")
                        ExecutionState{phase: ExecutionPhase.Done, command_count: execution.command_count, exit_status: 1}
                    if execution.phase == ExecutionPhase.Done:
                        diagnostic("unable to create build directory")
                    -> Dispatch

                Dispatch, ExecutionPhase.Execute:
                    command: Command = plan.commands[execution.next_command]
                    command_status: i64 = execute(command)
                    execution <- try execution_after_command(execution, command_status) else err:
                        diagnostic("invalid build execution state")
                        ExecutionState{phase: ExecutionPhase.Done, command_count: execution.command_count, next_command: execution.next_command, exit_status: 1}
                    -> Dispatch

                Dispatch, ExecutionPhase.Report:
                    execution <- try execution_after_report(execution) else err:
                        diagnostic("invalid build execution state")
                        ExecutionState{phase: ExecutionPhase.Done, command_count: execution.command_count, next_command: execution.next_command, exit_status: 1}
                    if execution.exit_status == 0:
                        _ = write_stdout("built " + plan.executable_path + "\n")
                    -> Dispatch

                Dispatch, ExecutionPhase.Done:
                    break
            return execution.exit_status


def main(arguments: darray[sview]) -> i64 can[Directory.Read, Directory.Write, Environment.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    return EsEngineNavNativeTestBuild::run(arguments)
