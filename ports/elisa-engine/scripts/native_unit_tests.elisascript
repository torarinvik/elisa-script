#!/usr/bin/env elisascript
# Ordered Elisascript counterpart of elisa-engine/scripts/native_unit_tests.py.
include "./native_unit_tests_plan.elisa"

using EsEngineNativeUnitTestsPlan


module EsEngineNativeUnitTests:
    private:
        struct ChildResult:
            status: i64
            started: bool


        const enum RunPhase of u8:
            Next
            Done


        def diagnostic(message: sview) -> void can[Console.Write, Memory.Allocate, Abort.Panic]:
            _ = write_stderr(message + "\n")


        def selected_compiler() -> sview can[Environment.Read, Memory.Allocate, Abort.Panic]:
            configured: sview = try getenv("ELISA_LOCAL_COMPILER", "") else ""
            if configured != "":
                return configured
            configured <- try getenv("ELISACORE_BIN", "") else ""
            return "elisascript" if configured == ""
            return configured


        def execute_child(compiler: sview, scripts_directory: Path, child: ChildTest) -> ChildResult can[Process.Run, Memory.Allocate, Abort.Panic, Console.Format]:
            source: Path = scripts_directory.joinpath(child.script_name)
            arguments: mutable darray[sview] = [f"{source}"]
            for argument in child.arguments |arguments|:
                arguments.push(argument)
            status: i64 = try run_process(executable(compiler), arguments) else failure:
                _ = failure
                return ChildResult{status: 127i64, started: false}
            return ChildResult{status: status, started: true}


    public:
        def run() -> i64 can[Directory.Read, Environment.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
            source: Path = try path_real(Script::source_path()) else failure:
                _ = failure
                diagnostic("unable to resolve native unit-test script path")
                return 1i64
            compiler: sview = selected_compiler()
            children: darray[ChildTest] = child_tests()
            index: mutable usize = 0
            phase: mutable RunPhase = RunPhase.Next
            machine over phase while phase != RunPhase.Done:
                state RunChildren
                start RunChildren

                RunChildren, RunPhase.Next:
                    if index >= children.count:
                        phase <- RunPhase.Done
                        -> RunChildren
                    child: ChildTest = children[index]
                    result: ChildResult = execute_child(compiler, source.parent(), child)
                    if not result.started:
                        diagnostic("unable to start Elisascript child: " + child.script_name)
                        return 127i64
                    if result.status != 0:
                        return result.status
                    index <- index + 1
                    -> RunChildren

                RunChildren, RunPhase.Done:
                    break
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Directory.Read, Environment.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
    _ = arguments
    return EsEngineNativeUnitTests::run()
