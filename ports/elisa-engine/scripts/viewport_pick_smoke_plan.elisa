# Typed command and outcome model for elisa-engine/scripts/viewport_pick_smoke.py.
module EsEngineViewportPickSmokePlan:
    public:
        const module Defaults:
            INTERPRETER: sview = "python3"
            SMOKE_SCRIPT: sview = "scripts/render_scene_native_smoke.py"
            NATIVE_MAIN: sview = "test/render_scene_viewport_pick_main.elisa"
            RENDER_ONLY_KEY: sview = "ELISA_RENDER_SCENE_RENDER_ONLY"
            PROFILE_COST_ONLY_KEY: sview = "ELISA_RENDER_SCENE_PROFILE_COST_ONLY"
            NATIVE_MAIN_KEY: sview = "ELISA_RENDER_SCENE_NATIVE_MAIN"
            ENABLED: sview = "1"
            OUTPUT_TAIL_CODEPOINTS: usize = 2000


        const enum ExecutionPhase of u8:
            AwaitChild
            ReportSuccess
            ReportFailure
            Done


        struct Plan:
            interpreter: sview
            working_directory: sview
            arguments: darray[sview]
            environment: dict[sview, sview]


        struct ExecutionState:
            phase: ExecutionPhase = ExecutionPhase.AwaitChild
            child_status: i64 = 0
            exit_status: i64 = 0


        error PlanError:
            InvalidExecutionState


        def plan(project_root: sview, interpreter: sview) -> Plan can[Memory.Allocate, Abort.Panic]:
            return Plan{
                interpreter: interpreter,
                working_directory: project_root,
                arguments: [project_path(project_root, Defaults::SMOKE_SCRIPT)],
                environment: {
                    Defaults::RENDER_ONLY_KEY: Defaults::ENABLED,
                    Defaults::PROFILE_COST_ONLY_KEY: Defaults::ENABLED,
                    Defaults::NATIVE_MAIN_KEY: project_path(project_root, Defaults::NATIVE_MAIN)
                }
            }


        def initial_execution() -> ExecutionState:
            return ExecutionState{phase: ExecutionPhase.AwaitChild}


        def execution_after_child(state: ExecutionState, status: i64) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.AwaitChild
            return ExecutionState{phase: ExecutionPhase.ReportFailure, child_status: status, exit_status: 1} if status != 0
            return ExecutionState{phase: ExecutionPhase.ReportSuccess, child_status: 0, exit_status: 0}


        def execution_after_report(state: ExecutionState) -> ExecutionState error[PlanError]:
            raise PlanError.InvalidExecutionState if state.phase != ExecutionPhase.ReportSuccess and state.phase != ExecutionPhase.ReportFailure
            return ExecutionState{phase: ExecutionPhase.Done, child_status: state.child_status, exit_status: state.exit_status}


        # Python's text-mode subprocess result is sliced by Unicode codepoint.
        # This helper keeps the corresponding UTF-8 suffix without splitting a
        # valid multibyte character; subprocess decoding errors remain a host
        # adapter parity item.
        def trailing_utf8_codepoints(value: sview, maximum: usize) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            byte_count: usize = sview_len(value)
            start: mutable usize = byte_count
            remaining: mutable usize = maximum
            while start > 0 and remaining > 0 |value, start, remaining|:
                start <- start - 1
                byte: u8 = sview_at(value, start)
                remaining <- remaining - 1 if (byte & 192u8) != 128u8
            result: mutable darray[u8] = []
            for index in start..<byte_count |value, result|:
                result.push(sview_at(value, index))
            return result


    private:
        def project_path(root: sview, relative: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return "/" + relative if root == "/"
            return root + "/" + relative
