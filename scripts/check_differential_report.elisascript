# Bounded Elisascript port of check_differential_report.sh.
# Fixture assertions are scoped to their registered test blocks.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDifferentialReportAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/testing/report_model.elisa"
            RENDERER: sview = "src/testing/report_render_model.elisa"
            TRANSPORT: sview = "src/testing/report_transport_model.elisa"
            TRANSPORT_POSIX: sview = "src/testing/report_transport_posix.elisa"
            ADAPTER: sview = "src/testing/report_adapter_model.elisa"
            CONSUMER: sview = "src/testing/differential.elisa"
            FIXTURE: sview = "test/differential/elisascript_differential_test.elisa"
            DOCS: sview = "docs/differential-testing.md"


        const module Patterns:
            CONTRACT_TEST: sview = "def differential_report_contract_is_machine_readable_and_fail_closed() -> void:"
            JSON_TEST: sview = "def differential_report_json_renderer_is_deterministic_escaped_and_bounded() -> void:"
            HUMAN_JUNIT_TEST: sview = "def differential_report_human_and_junit_renderers_preserve_outcomes() -> void:"
            TRANSPORT_TEST: sview = "def differential_report_transport_requires_full_ordered_writes() -> void:"
            POSIX_TEST: sview = "def differential_report_posix_transport_rejects_invalid_descriptor_before_write() -> void:"
            ADAPTER_TEST: sview = "def differential_report_adapter_preserves_comparison_identity_and_category() -> void:"
            TEST_MARKER: sview = "@test"
            AGGREGATE_CHECK: sview = "differential_report_text_total_add_fits(total_text_bytes, message)"
            NUL_SCAN: sview = "EmbeddedNul if sview_contains_byte(message, 0)"
            STABILITY_INCLUDE: sview = "include \"./stability_model.elisa\""
            REPORT_INCLUDE: sview = "include \"./report_model.elisa\""


        const module Messages:
            MISSING_ROOT: sview = "differential report audit: missing repository root"
            UNRESOLVED_ROOT: sview = "differential report audit: unable to resolve repository root"
            MISSING_INPUT: sview = "differential report audit: missing file: "
            READ_FAILED: sview = "differential report audit: unable to read source: "
            ADAPTER_MISSING: sview = "differential report audit: adapter contract is missing"
            POSIX_TRANSPORT_MISSING: sview = "differential report audit: POSIX transport contract is missing"
            RENDERER_MISSING: sview = "differential report audit: renderer contract is missing"
            TRANSPORT_MISSING: sview = "differential report audit: transport contract is missing"
            MODEL_MISSING: sview = "differential report audit: report-model contract is missing"
            ORDER_MISSING: sview = "differential report audit: required source declarations are out of order"
            CONSUMER_MISSING: sview = "differential report audit: report modules are not included in the consumer"
            TEST_MISSING: sview = "differential report audit: registered report contract test is missing"
            CONTRACT_BODY_MISSING: sview = "differential report audit: contract case is absent from its test body: "
            JSON_TEST_MISSING: sview = "differential report audit: JSON renderer regression is not registered"
            HUMAN_JUNIT_TEST_MISSING: sview = "differential report audit: Human/JUnit renderer regression is not registered"
            TRANSPORT_TEST_MISSING: sview = "differential report audit: transport regression is not registered"
            POSIX_TEST_MISSING: sview = "differential report audit: POSIX transport regression is not registered"
            ADAPTER_TEST_MISSING: sview = "differential report audit: comparison adapter regression is not registered"
            FIXTURE_MISSING: sview = "differential report audit: regression fixture is missing: "
            DOCS_MISSING: sview = "differential report audit: documentation contract is missing: "
            SUCCESS: sview = "differential report audit: typed reports bind repeat claims and render bounded Human/JSON/JUnit output"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def require_patterns(input: Path, patterns: darray[sview], message: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for pattern in patterns:
                found: bool = try EsSourceFunctionScope::contains_file_line(input, pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{input}")
                    return ExitStatus::IO_FAILURE
                if not found:
                    diagnostic(message + f": {pattern}")
                    return ExitStatus::FAILURE
            return 0i64


        def require_ordered_lines(input: Path, first: sview, second: sview, message: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            ordered: bool = try EsSourceFunctionScope::appears_before_in_file(input, first, second) else err:
                diagnostic(Messages::READ_FAILED + f"{input}")
                return ExitStatus::IO_FAILURE
            if not ordered:
                diagnostic(message)
                return ExitStatus::FAILURE
            return 0i64


        def require_registered_test(input: Path, declaration: sview, message: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            registered: bool = try EsSourceFunctionScope::contains_file_adjacent_lines(input, Patterns::TEST_MARKER, declaration) else err:
                diagnostic(Messages::READ_FAILED + f"{input}")
                return ExitStatus::IO_FAILURE
            if not registered:
                diagnostic(message)
                return ExitStatus::FAILURE
            return 0i64


        def require_test_body_patterns(input: Path, declaration: sview, patterns: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for pattern in patterns:
                found: bool = try EsSourceFunctionScope::contains_file_block_line(input, declaration, Patterns::TEST_MARKER, pattern, false) else err:
                    diagnostic(Messages::READ_FAILED + f"{input}")
                    return ExitStatus::IO_FAILURE
                if not found:
                    diagnostic(Messages::CONTRACT_BODY_MISSING + f"{pattern}")
                    return ExitStatus::FAILURE
            return 0i64


        def execute_all(inputs: darray[Path]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = require_patterns(inputs[4], [
                "module EsDifferentialReportAdapter:", "DifferentialReportAdapterError",
                "report_adapter_difference_kind_valid", "report_adapter_run_outcome_valid",
                "report_adapter_run_outcome_incomplete", "report_adapter_comparison_kind",
                "report_adapter_category", "report_adapter_project_comparison",
                "def make_differential_report(", "def make_differential_case_replay_report(",
                "def record_differential_case_replay_stability_observation(",
                "def make_differential_case_stability_report(", "ReplayEvidenceMismatch",
                "StabilityEvidenceMismatch", "DifferentialReportStatus.Passed",
                "DifferentialReportCategory.ValueMismatch", "DifferentialReportCategory.ObservationMismatch",
                "DifferentialReportCategory.Timeout", "DifferentialReportStatus.Inconclusive",
                "DifferentialRunOutcome.OutputLimit", "validate_differential_report(report)"
            ], Messages::ADAPTER_MISSING)
            return status if status != 0i64

            status <- require_patterns(inputs[3], [
                "module EsDifferentialReportTransportPosix:", "MAX_EINTR_RETRIES: usize = 8",
                "MAX_WRITE_CALLS: usize = 1048576", "write_differential_report_transport_fd(",
                "elisascript_posix_write", "DarwinErrno::EINTR", "WriteCallLimitExceeded",
                "DifferentialReportTransportEvent.Fail"
            ], Messages::POSIX_TRANSPORT_MISSING)
            return status if status != 0i64

            status <- require_patterns(inputs[1], [
                "module EsDifferentialReportRender:", "const module Limits:",
                "MAX_BYTES: usize = 33554432", "def render_differential_report_json(",
                "def render_differential_report_human(", "def render_differential_report_junit(",
                "def render_differential_report(", "validate_differential_report(report)",
                "report.format != DifferentialReportFormat.Json", "report.format != DifferentialReportFormat.Human",
                "report.format != DifferentialReportFormat.Junit", "report_render_xml_fields_valid(report)",
                "XmlCharacterInvalid", "report_render_junit_failure_count", "report_render_junit_error_count",
                "report_render_junit_skipped_count", "DifferentialReportStatus.Inconclusive",
                "DifferentialReportCategory.Flaky", "report_render_append_xml_escaped", "OutputLimitExceeded",
                "report_render_append_json_string", "report_render_append_stability", "baseline_reference_fingerprint",
                "comparison_fingerprint", "report.messages.count"
            ], Messages::RENDERER_MISSING)
            return status if status != 0i64

            status <- require_patterns(inputs[2], [
                "module EsDifferentialReportTransport:", "MAX_CHUNK_BYTES: usize = 1048576",
                "DifferentialReportTransportState", "DifferentialReportTransportEvent",
                "begin_differential_report_transport(", "validate_differential_report_transport(",
                "peek_differential_report_chunk(", "advance_differential_report_transport(",
                "ShortWrite", "CancelAck"
            ], Messages::TRANSPORT_MISSING)
            return status if status != 0i64

            status <- require_patterns(inputs[0], [
                "module EsDifferentialReport:", "using EsDifferentialStability", "Limits::TEXT_BYTES",
                "Limits::TOTAL_TEXT_BYTES", "Limits::MESSAGES", "Limits::REPEATS",
                "const enum DifferentialReportFormat of u8:", "const enum DifferentialReportStatus of u8:",
                "const enum DifferentialReportCategory of u8:", "struct DifferentialReport:",
                "stability_evidence: DifferentialStabilitySession", "error DifferentialReportError:",
                "def validate_differential_report("
            ], Messages::MODEL_MISSING)
            return status if status != 0i64

            status <- require_patterns(inputs[0], [
                "differential_report_format_valid", "differential_report_status_valid",
                "differential_report_category_valid", "StatusCategoryMismatch", "ComparisonStatusMismatch",
                "report.status == DifferentialReportStatus.Passed and report.comparison_kind != DifferentialReportDifferenceKind.Equal",
                "report.status == DifferentialReportStatus.Failed and (report.comparison_kind == DifferentialReportDifferenceKind.Equal or report.comparison_kind == DifferentialReportDifferenceKind.Unavailable)",
                "report.status == DifferentialReportStatus.Skipped and (report.comparison_kind != DifferentialReportDifferenceKind.Unavailable or report.has_stability_evidence or report.repeat_count != 1)",
                "report.status == DifferentialReportStatus.Inconclusive and report.comparison_kind == DifferentialReportDifferenceKind.Equal and (report.category != DifferentialReportCategory.Flaky or not report.has_stability_evidence)",
                "NondeterministicPass", "NondeterministicClaimInvalid", "FlakyEvidenceInvalid",
                "StabilityEvidenceInvalid", "DetailOmissionInvalid",
                "((report.reference_detail_omitted or report.candidate_detail_omitted) and report.artifact_path == \"\")",
                "report.repeat_count < 2", "validate_differential_stability(report.stability_evidence)",
                "report.repeat_count != report.stability_evidence.observations.count",
                "report.stability_evidence.state != DifferentialStabilityState.Planned",
                "DifferentialStabilityClassification.Nondeterministic", "MessageLimitExceeded",
                "AggregateTextLimitExceeded", "EmbeddedNul", "InvalidUtf8",
                "differential_report_text_length_valid", "differential_report_text_total_add_fits",
                "differential_report_text_utf8_valid", "not differential_report_text_utf8_valid(report.artifact_path)",
                "not differential_report_text_utf8_valid(report.reference_detail)",
                "not differential_report_text_utf8_valid(report.candidate_detail)", "RepeatCountInvalid"
            ], Messages::MODEL_MISSING)
            return status if status != 0i64

            status <- require_ordered_lines(inputs[0], Patterns::AGGREGATE_CHECK, Patterns::NUL_SCAN, Messages::ORDER_MISSING)
            return status if status != 0i64

            status <- require_patterns(inputs[5], [
                "include \"./report_model.elisa\"", "include \"./report_render_model.elisa\"",
                "include \"./report_transport_model.elisa\"", "include \"./report_transport_posix.elisa\"",
                "include \"./report_adapter_model.elisa\""
            ], Messages::CONSUMER_MISSING)
            return status if status != 0i64
            status <- require_ordered_lines(inputs[5], Patterns::STABILITY_INCLUDE, Patterns::REPORT_INCLUDE, Messages::ORDER_MISSING)
            return status if status != 0i64

            status <- require_registered_test(inputs[6], Patterns::CONTRACT_TEST, Messages::TEST_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[6], ["using EsDifferentialReport"], Messages::FIXTURE_MISSING)
            return status if status != 0i64
            status <- require_test_body_patterns(inputs[6], Patterns::CONTRACT_TEST, [
                "DifferentialReportFormat.Json", "DifferentialReportFormat.Junit",
                "DifferentialReportError.StatusCategoryMismatch", "DifferentialReportError.ComparisonStatusMismatch",
                "comparison_kind: DifferentialReportDifferenceKind.ExitStatus",
                "comparison_kind: DifferentialReportDifferenceKind.Equal", "forged_failure_unavailable",
                "skipped_with_comparison", "inconclusive_equal", "DifferentialReportError.NondeterministicPass",
                "DifferentialReportError.FlakyEvidenceInvalid", "DifferentialReportError.NondeterministicClaimInvalid",
                "has_stability_evidence: true", "aggregate_text_messages",
                "DifferentialReportError.AggregateTextLimitExceeded", "embedded_nul_message",
                "DifferentialReportError.EmbeddedNul", "invalid_utf8_text", "DifferentialReportError.InvalidUtf8",
                "invalid_utf8_artifact_path", "invalid_utf8_artifact_path_rejected", "orphan_omitted_detail_rejected",
                "repeated_pass", "mismatched_evidence_count", "flaky_stability", "hidden_stability_evidence",
                "flaky_without_repeats", "stable_flaky_label", "nondeterministic_failure"
            ])
            return status if status != 0i64

            status <- require_registered_test(inputs[6], Patterns::JSON_TEST, Messages::JSON_TEST_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[6], [
                "DifferentialReportRenderError.OutputLimitExceeded", "sview_eq(rendered, expected)",
                "9007199254740993u64", "differential_test_sview_contains(evidence_text"
            ], Messages::FIXTURE_MISSING)
            return status if status != 0i64

            status <- require_registered_test(inputs[6], Patterns::HUMAN_JUNIT_TEST, Messages::HUMAN_JUNIT_TEST_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[6], [
                "<failure type=\"value_mismatch\" message=\"diff &amp; &lt;\"/>",
                "DifferentialReportRenderError.XmlCharacterInvalid", "render_differential_report(human_report)",
                "inconclusive_evidence"
            ], Messages::FIXTURE_MISSING)
            return status if status != 0i64

            status <- require_registered_test(inputs[6], Patterns::TRANSPORT_TEST, Messages::TRANSPORT_TEST_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[6], [
                "DifferentialReportTransportError.ShortWrite", "peek_differential_report_chunk(",
                "transport.offset == transport.bytes.count"
            ], Messages::FIXTURE_MISSING)
            return status if status != 0i64

            status <- require_registered_test(inputs[6], Patterns::POSIX_TEST, Messages::POSIX_TEST_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[6], ["DifferentialReportTransportPosixError.InvalidDescriptor"], Messages::FIXTURE_MISSING)
            return status if status != 0i64

            status <- require_registered_test(inputs[6], Patterns::ADAPTER_TEST, Messages::ADAPTER_TEST_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[6], [
                "make_differential_report(case, reference_run, candidate_run",
                "make_differential_case_replay_report(case, session",
                "record_differential_case_replay_stability_observation(stable_repeats, case, session)",
                "make_differential_case_stability_report(case, varying_repeats, session",
                "DifferentialReportCategory.Flaky", "DifferentialReportStatus.Inconclusive"
            ], Messages::FIXTURE_MISSING)
            return status if status != 0i64

            status <- require_patterns(inputs[4], [
                "reference_detail: comparison.reference_text", "candidate_detail: comparison.candidate_text",
                "sview_len(projected_comparison.reference_text) >= EsDifferentialReport::Limits::TEXT_BYTES",
                "sview_len(projected_comparison.candidate_text) >= EsDifferentialReport::Limits::TEXT_BYTES"
            ], Messages::ADAPTER_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[1], [
                "\"reference_detail\"", "\"candidate_detail\"", "report.comparison_kind", "report.comparison_index"
            ], Messages::RENDERER_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[0], ["reference_detail_omitted", "candidate_detail_omitted"], Messages::MODEL_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[6], [
                "DifferentialReportStatus.Inconclusive", "DifferentialReportCategory.ValueMismatch",
                "both_timed_out.status == DifferentialReportStatus.Inconclusive",
                "one_sided_timeout.status == DifferentialReportStatus.Failed",
                "both_compile_failed.status == DifferentialReportStatus.Inconclusive"
            ], Messages::FIXTURE_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[7], [
                "EsDifferentialReport::DifferentialReport", "merely setting a repeat count is insufficient",
                "render_differential_report", "Human, JSON, or JUnit"
            ], Messages::DOCS_MISSING)
            return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL), root.joinpath(Inputs::RENDERER),
                root.joinpath(Inputs::TRANSPORT), root.joinpath(Inputs::TRANSPORT_POSIX),
                root.joinpath(Inputs::ADAPTER), root.joinpath(Inputs::CONSUMER),
                root.joinpath(Inputs::FIXTURE), root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::IO_FAILURE
            status: i64 = execute_all(inputs)
            return status if status != 0i64
            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDifferentialReportAudit::run_default()
