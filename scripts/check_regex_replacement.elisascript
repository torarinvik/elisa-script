# Bounded Elisascript source-audit port of check_regex_replacement.sh.
# Reference Perl, candidate, golden, and launcher are inspected, never run here.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsRegexReplacementAudit:
    private:
        const module Inputs:
            SOURCE: sview = "src/ir/interpret.elisa"
            BYTECODE: sview = "src/bytecode/bytecode.elisa"
            FIXTURE: sview = "test/ir/elisascript_interpreter_test.elisa"
            BYTECODE_FIXTURE: sview = "test/ir/elisascript_bytecode_test.elisa"
            DOCS: sview = "docs/ir.md"
            PARITY_ROOT: sview = "test/fixtures/script_parity/regex_replacement"
            REFERENCE: sview = "test/fixtures/script_parity/regex_replacement/reference.pl"
            CANDIDATE: sview = "test/fixtures/script_parity/regex_replacement/candidate.elisascript"
            GOLDEN: sview = "test/fixtures/script_parity/regex_replacement/expected.txt"
            CONTRACT: sview = "test/fixtures/script_parity/regex_replacement/CONTRACT.md"
            LAUNCHER: sview = "test/script_parity/regex_replacement_launcher_test.elisascript"


        const module Patterns:
            ORDERED_START: sview = "if start > end:"
            ORDERED_END: sview = "if end > sview_len(value):"
            ORDERED_OUTPUT: sview = "if output.count > INTERPRET_MAX_TEXT_REPLACEMENT_BYTES:"
            BYTECODE_START: sview = "return false if start > end"
            BYTECODE_END: sview = "return false if end > sview_len(value)"
            BYTECODE_OUTPUT: sview = "return false if output.count > Limits::TEXT_OUTPUT_BYTES"
            BYTECODE_SPLIT_START: sview = "false return if start > text_length"
            BYTECODE_SPLIT_SEPARATOR: sview = "false return if separator_length > text_length - start"
            QUOTE_REPLACEMENT: sview = "def regex_quote_replacement("
            REPLACEMENT_BUDGET: sview = "regex_replacement_within_budget"
            BACKSLASH_BYTE: sview = "byte == 92"
            DOLLAR_BYTE: sview = "byte == 36"
            AMPERSAND_BYTE: sview = "byte == 38"
            REPLACE_TEXT: sview = "def regex_replace_text("
            ESCAPED_BACKSLASH: sview = "sview_at(replacement, index + 1) == 92"
            INTERPRETER_LITERAL_FIXTURE: sview = "interpreter_quotes_literal_regex_replacement_text"
            REGEX_CLOSE_BRACKET_FIXTURE: sview = "regex_machine_accepts_a_leading_close_bracket_in_character_classes"
            BYTECODE_CLOSE_BRACKET_FIXTURE: sview = "bytecode_direct_regex_leading_close_bracket_matches_reference_interpreter"
            CURSOR_CLOSE_BRACKET: sview = "cursor <- cursor + 1 if cursor < sview_len(pattern) and sview_at(pattern, cursor) == 93"
            DOCS_QUOTE_REPLACEMENT: sview = "regex_quote_replacement"
            LAUNCHER_PARITY: sview = "regex_replacement_public_launcher_matches_perl_reference_and_golden"
            LAUNCHER_REAUTHORIZED: sview = "ELISASCRIPT_VALIDATION_REAUTHORIZED"
            LAUNCHER_RSS_GUARD: sview = "ELISASCRIPT_BOUNDED_TEST_RSS_GUARD"
            LAUNCHER_ENV_REPLACE: sview = "ProcessEnvironmentMode.Replace"
            CANDIDATE_SUB: sview = "regex_sub(regex\"([a-z]+)=([0-9]+)\", \"$1:$2\", \"id=42; id=7\")"
            CANDIDATE_ANCHORED_START: sview = "anchored_start: sview = replace_regex(\"abc\", regex\"^\", \">\")"
            CANDIDATE_ANCHORED_END: sview = "anchors: sview = replace_regex(anchored_start, regex\"$\", \"!\")"
            REFERENCE_FIELDS: sview = "my $fields = \"id=42; id=7\";"
            REFERENCE_ANCHORED_START: sview = "$anchors =~ s/^/>/g;"
            REFERENCE_ANCHORED_END: sview = "$anchors =~ s/$/!/g;"
            REFERENCE_UNCHANGED: sview = "$unchanged =~ s/[0-9]+/x/g;"
            CANDIDATE_UNCHANGED: sview = "unchanged: sview = replace_regex(\"nothing\", regex\"[0-9]+\", \"x\")"
            REFERENCE_EMPTY_ANCHOR: sview = "$empty =~ s/^/x/g;"
            CANDIDATE_EMPTY_ANCHOR: sview = "empty_anchor: sview = replace_regex(\"\", regex\"^\", \"x\")"
            GOLDEN_ANCHORED: sview = ">abc!"
            GOLDEN_UNCHANGED: sview = "nothing"
            GOLDEN_EXACT_X: Regex = regex"^x$"
            GOLDEN_FIELDS: sview = "id:42; id:7"
            CONTRACT_CALLBACK: sview = "callback replacement exactly once per match"


        const module Messages:
            MISSING_ROOT: sview = "regex replacement audit: missing repository root"
            UNRESOLVED_ROOT: sview = "regex replacement audit: unable to resolve repository root"
            MISSING_INPUT: sview = "regex replacement audit: missing "
            READ_FAILED: sview = "regex replacement audit: unable to read source: "
            ORDERED_GUARD: sview = "regex replacement audit: missing ordered guard "
            BOUNDARY: sview = "regex replacement audit: missing "
            SUCCESS: sview = "regex audit: replacement quoting, bounded output, leading class-bracket support, and gated Perl parity source are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def run_checks(checks: darray[SearchCheck], missing_prefix: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        if not found:
                            if missing_prefix != "":
                                diagnostic(missing_prefix + check.pattern)
                            return ExitStatus::FAILURE
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


        def exact_x_line(golden: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_regex_line(golden, Patterns::GOLDEN_EXACT_X):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{golden}")
                    return ExitStatus::IO_FAILURE


        def ordered_guards(source: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: source, pattern: Patterns::ORDERED_START},
                SearchCheck{input: source, pattern: Patterns::ORDERED_END},
                SearchCheck{input: source, pattern: Patterns::ORDERED_OUTPUT}
            ]


        def bytecode_guards(bytecode: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: bytecode, pattern: Patterns::BYTECODE_START},
                SearchCheck{input: bytecode, pattern: Patterns::BYTECODE_END},
                SearchCheck{input: bytecode, pattern: Patterns::BYTECODE_OUTPUT},
                SearchCheck{input: bytecode, pattern: Patterns::BYTECODE_SPLIT_START},
                SearchCheck{input: bytecode, pattern: Patterns::BYTECODE_SPLIT_SEPARATOR}
            ]


        def replacement_boundaries(source: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: source, pattern: Patterns::QUOTE_REPLACEMENT},
                SearchCheck{input: source, pattern: Patterns::REPLACEMENT_BUDGET},
                SearchCheck{input: source, pattern: Patterns::BACKSLASH_BYTE},
                SearchCheck{input: source, pattern: Patterns::DOLLAR_BYTE},
                SearchCheck{input: source, pattern: Patterns::AMPERSAND_BYTE},
                SearchCheck{input: source, pattern: Patterns::REPLACE_TEXT},
                SearchCheck{input: source, pattern: Patterns::ESCAPED_BACKSLASH}
            ]


        def parity_source_checks(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[2], pattern: Patterns::INTERPRETER_LITERAL_FIXTURE},
                SearchCheck{input: inputs[2], pattern: Patterns::REGEX_CLOSE_BRACKET_FIXTURE},
                SearchCheck{input: inputs[3], pattern: Patterns::BYTECODE_CLOSE_BRACKET_FIXTURE},
                SearchCheck{input: inputs[0], pattern: Patterns::CURSOR_CLOSE_BRACKET},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_QUOTE_REPLACEMENT},
                SearchCheck{input: inputs[10], pattern: Patterns::LAUNCHER_PARITY},
                SearchCheck{input: inputs[10], pattern: Patterns::LAUNCHER_REAUTHORIZED},
                SearchCheck{input: inputs[10], pattern: Patterns::LAUNCHER_RSS_GUARD},
                SearchCheck{input: inputs[10], pattern: Patterns::LAUNCHER_ENV_REPLACE},
                SearchCheck{input: inputs[7], pattern: Patterns::CANDIDATE_SUB},
                SearchCheck{input: inputs[7], pattern: Patterns::CANDIDATE_ANCHORED_START},
                SearchCheck{input: inputs[7], pattern: Patterns::CANDIDATE_ANCHORED_END},
                SearchCheck{input: inputs[6], pattern: Patterns::REFERENCE_FIELDS},
                SearchCheck{input: inputs[6], pattern: Patterns::REFERENCE_ANCHORED_START},
                SearchCheck{input: inputs[6], pattern: Patterns::REFERENCE_ANCHORED_END},
                SearchCheck{input: inputs[6], pattern: Patterns::REFERENCE_UNCHANGED},
                SearchCheck{input: inputs[7], pattern: Patterns::CANDIDATE_UNCHANGED},
                SearchCheck{input: inputs[6], pattern: Patterns::REFERENCE_EMPTY_ANCHOR},
                SearchCheck{input: inputs[7], pattern: Patterns::CANDIDATE_EMPTY_ANCHOR},
                SearchCheck{input: inputs[8], pattern: Patterns::GOLDEN_ANCHORED},
                SearchCheck{input: inputs[8], pattern: Patterns::GOLDEN_UNCHANGED}
            ]


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::SOURCE),
                root.joinpath(Inputs::BYTECODE),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::BYTECODE_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::PARITY_ROOT),
                root.joinpath(Inputs::REFERENCE),
                root.joinpath(Inputs::CANDIDATE),
                root.joinpath(Inputs::GOLDEN),
                root.joinpath(Inputs::CONTRACT),
                root.joinpath(Inputs::LAUNCHER)
            ]
            preflight: darray[Path] = [
                inputs[0], inputs[1], inputs[2], inputs[3], inputs[4],
                inputs[6], inputs[7], inputs[8], inputs[9], inputs[10]
            ]
            for input_path in preflight:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: mutable i64 = run_checks(ordered_guards(inputs[0]), Messages::ORDERED_GUARD)
            return status if status != 0i64
            status = run_checks(bytecode_guards(inputs[1]), "")
            return status if status != 0i64
            status = run_checks(replacement_boundaries(inputs[0]), Messages::BOUNDARY)
            return status if status != 0i64
            status = run_checks(parity_source_checks(inputs), "")
            return status if status != 0i64

            status = exact_x_line(inputs[8])
            return status if status != 0i64
            golden_fields_check: darray[SearchCheck] = [SearchCheck{input: inputs[8], pattern: Patterns::GOLDEN_FIELDS}]
            status = run_checks(golden_fields_check, "")
            return status if status != 0i64
            contract_check: darray[SearchCheck] = [SearchCheck{input: inputs[9], pattern: Patterns::CONTRACT_CALLBACK}]
            status = run_checks(contract_check, "")
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsRegexReplacementAudit::run_default()
