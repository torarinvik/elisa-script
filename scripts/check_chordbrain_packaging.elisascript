# Bounded Elisascript port of ChordBrain's packaging_metadata_smoke.cmake.
# Arguments are the same source and binary roots supplied by CMake's test.

include "../src/runtime/bounded_text_posix.elisa"

using EsBoundedText

module EsChordBrainPackagingSmoke:
    private:
        const module Limits:
            PLIST_BYTES: usize = 1048576


        const module Messages:
            USAGE: sview = "usage: check_chordbrain_packaging SOURCE_ROOT BINARY_ROOT"
            MISSING_SOURCE: sview = "Missing source packaging resource: "
            MISSING_ARTIFACT: sview = "Missing built packaging artifact: "
            SOURCE_APPL: sview = "Standalone APP plist must declare CFBundlePackageType APPL"
            SOURCE_NIB: sview = "Standalone APP plist must reference the compiled SWELL main-menu nib"
            SOURCE_AU: sview = "Instrument AU plist must advertise the aumu component type"
            BUILT_APPL: sview = "Built APP plist must declare CFBundlePackageType APPL"
            BUILT_AU: sview = "Built AU plist must advertise the aumu component type"


        const module Patterns:
            APPL: Regex = regex"<key>CFBundlePackageType</key>[ \t\r\n]+<string>APPL</string>"
            APP_NIB: Regex = regex"<key>NSMainNibFile</key>[ \t\r\n]+<string>IPlugMidiEffect-macOS-MainMenu</string>"
            AU_TYPE: Regex = regex"<key>type</key>[ \t\r\n]+<string>aumu</string>"


        error PackagingReadError:
            ReadFailed
            TooLarge


        def read_plist(input_path: Path) -> sview error[PackagingReadError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            catch EsBoundedText::read_utf8(input_path, Limits::PLIST_BYTES):
                ok contents:
                    return contents
                error failure:
                    if failure == EsBoundedText::ReadError.LimitExceeded:
                        raise PackagingReadError.TooLarge
                    raise PackagingReadError.ReadFailed


        def write_diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def exists_or_report(resource_path: Path, diagnostic_prefix: sview) -> bool can[Console.Write, File.Read]:
            if path_exists(resource_path):
                return true
            write_diagnostic(f"{diagnostic_prefix}{resource_path}")
            return false


    public:
        def run(source_root: Path, binary_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Console.Write, File.Read, Unsafe.PointerCast]:
            app_source_plist: Path = source_root.joinpath("resources").joinpath("ChordBrain-macOS-Info.plist")
            au_source_plist: Path = source_root.joinpath("resources").joinpath("ChordBrain-AU-Info.plist")
            app_bundle: Path = binary_root.joinpath("out").joinpath("ChordBrain.app")
            au_bundle: Path = binary_root.joinpath("out").joinpath("ChordBrain.component")

            if not exists_or_report(app_source_plist, Messages::MISSING_SOURCE):
                return 1i64
            if not exists_or_report(au_source_plist, Messages::MISSING_SOURCE):
                return 1i64

            catch read_plist(app_source_plist):
                ok app_plist:
                    if not Patterns::APPL.search(app_plist):
                        write_diagnostic(Messages::SOURCE_APPL)
                        return 1i64
                    if not Patterns::APP_NIB.search(app_plist):
                        write_diagnostic(Messages::SOURCE_NIB)
                        return 1i64
                error failure:
                    if failure == PackagingReadError.TooLarge:
                        write_diagnostic(f"Packaging plist exceeds {Limits::PLIST_BYTES} bytes: {app_source_plist}")
                    else:
                        write_diagnostic(f"Unable to read packaging plist: {app_source_plist}")
                    return 1i64

            catch read_plist(au_source_plist):
                ok au_plist:
                    if not Patterns::AU_TYPE.search(au_plist):
                        write_diagnostic(Messages::SOURCE_AU)
                        return 1i64
                error failure:
                    if failure == PackagingReadError.TooLarge:
                        write_diagnostic(f"Packaging plist exceeds {Limits::PLIST_BYTES} bytes: {au_source_plist}")
                    else:
                        write_diagnostic(f"Unable to read packaging plist: {au_source_plist}")
                    return 1i64

            artifacts: darray[Path] = [
                app_bundle.joinpath("Contents").joinpath("Info.plist"),
                app_bundle.joinpath("Contents").joinpath("Resources").joinpath("IPlugMidiEffect-macOS-MainMenu.nib"),
                app_bundle.joinpath("Contents").joinpath("Resources").joinpath("Roboto-Regular.ttf"),
                au_bundle.joinpath("Contents").joinpath("Info.plist")
            ]
            for artifact in artifacts |artifacts|:
                if not exists_or_report(artifact, Messages::MISSING_ARTIFACT):
                    return 1i64

            built_app_plist_path: Path = app_bundle.joinpath("Contents").joinpath("Info.plist")
            catch read_plist(built_app_plist_path):
                ok built_app_plist:
                    if not Patterns::APPL.search(built_app_plist):
                        write_diagnostic(Messages::BUILT_APPL)
                        return 1i64
                error failure:
                    if failure == PackagingReadError.TooLarge:
                        write_diagnostic(f"Packaging plist exceeds {Limits::PLIST_BYTES} bytes: {built_app_plist_path}")
                    else:
                        write_diagnostic(f"Unable to read packaging plist: {built_app_plist_path}")
                    return 1i64

            built_au_plist_path: Path = au_bundle.joinpath("Contents").joinpath("Info.plist")
            catch read_plist(built_au_plist_path):
                ok built_au_plist:
                    if not Patterns::AU_TYPE.search(built_au_plist):
                        write_diagnostic(Messages::BUILT_AU)
                        return 1i64
                error failure:
                    if failure == PackagingReadError.TooLarge:
                        write_diagnostic(f"Packaging plist exceeds {Limits::PLIST_BYTES} bytes: {built_au_plist_path}")
                    else:
                        write_diagnostic(f"Unable to read packaging plist: {built_au_plist_path}")
                    return 1i64

            print("-- ChordBrain APP/AU packaging metadata and resources are valid")
            return 0i64


        def run_cli(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Console.Write, Directory.Read, File.Read, Unsafe.PointerCast]:
            if arguments.count != 2:
                write_diagnostic(Messages::USAGE)
                return 2i64

            # CMake uses the caller's path spellings directly: an absent root
            # is diagnosed at the first resource under that root, not as an
            # argument/canonicalization error. Keep relative paths and symlink
            # spellings intact for both access and diagnostics.
            source_root: Path = path(arguments[0])
            binary_root: Path = path(arguments[1])
            return run(source_root, binary_root)

def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Console.Write, Directory.Read, File.Read, Unsafe.PointerCast]:
    return EsChordBrainPackagingSmoke::run_cli(arguments)
