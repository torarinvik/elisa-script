# Native port of the source/manifest audit in check_migration_inventory.sh.
# It reads only a fixed, bounded set of project metadata and source files.
# bash -n remains an explicit host syntax-checker dependency for legacy scripts.

module EsMigrationInventoryAudit:
    public:
        error MigrationInventoryError:
            InputLimitExceeded
            RecordInvalid
            ReadFailed


    private:
        const module Limits:
            FILE_BYTES: usize = 2097152
            MANIFEST_ROWS: usize = 4096
            FIELD_BYTES: usize = 65536
            PATH_BYTES: usize = 4096


        const module Messages:
            MISSING: sview = "migration inventory audit: missing "
            COORDINATOR_NOT_EXECUTABLE: sview = "migration inventory audit: coordinator is not executable"
            ROOTS_AUDIT_NOT_EXECUTABLE: sview = "migration inventory audit: root-manifest audit is not executable"
            HEADER_INVALID: sview = "migration inventory audit: root manifest header is invalid"
            MANIFEST_INVALID: sview = "migration inventory audit: manifest rows are malformed, unsafe, duplicated, or use an unknown review state"
            SCHEMA_MISSING_SCANNER: sview = "migration inventory audit: schema omits one of the read-only scanners"
            EXCLUSION_INVALID: sview = "migration inventory audit: candidate and signal scanners do not exclude "
            MAKEFILE_CLASSIFICATION_MISSING: sview = "migration inventory audit: candidate scanner misses root-level Makefiles"
            WALKER_INCLUDE_MISSING: sview = "migration inventory audit: Elisascript inventory does not include the shared native walker: "
            FIND_BACKED_WALK_MISSING: sview = "migration inventory audit: Elisascript inventory reintroduces a find-backed path capture: "
            WALKER_INVARIANT_MISSING: sview = "migration inventory audit: shared walker is missing invariant "
            WALKER_TEST_MISSING: sview = "migration inventory audit: shared walker tests omit policy case "
            SELECTOR_CONFIG_MISSING: sview = "migration inventory audit: scanners do not configure the shared walker's typed selectors"
            CANDIDATE_INVARIANT_MISSING: sview = "migration inventory audit: candidate is missing sorted adjacent-dedup invariant "
            FIXTURE_CONTRACT_MISSING: sview = "migration inventory audit: candidate fixture does not pin sort -u uniqueness semantics"
            ROOT_OWNERSHIP_MISSING: sview = "migration inventory audit: root ownership audit is not documented"
            CONTAINMENT_MISSING: sview = "migration inventory audit: containment audit lacks canonical root checks: "
            COORDINATOR_PREFLIGHT_MISSING: sview = "migration inventory audit: coordinator lacks fail-closed manifest preflight"


        const module Syntax:
            ROOT_HEADER: Regex = regex"^# name[[:space:]]+relative_path[[:space:]]+owner[[:space:]]+review_status$"
            SCHEMA_CANDIDATE: Regex = regex"inventory_candidates[.]sh"
            SCHEMA_SIGNALS: Regex = regex"inventory_signals[.]sh"
            SCHEMA_COORDINATOR: Regex = regex"inventory_project_roots[.]sh"
            ROOT_OWNERSHIP: Regex = regex"check_migration_roots[.]sh"
            REVIEWED_OWNER_CHECK: Regex = regex"reviewed.*unassigned"


        struct RootRecord:
            name: sview
            relative_path: sview
            owner: sview
            review_status: sview


        def read_bounded_text(input_path: Path) -> sview error[MigrationInventoryError] can[Memory.Allocate, Abort.Panic, File.Read]:
            initial_size: usize = try file_size(input_path) else err:
                raise MigrationInventoryError.ReadFailed
            raise MigrationInventoryError.InputLimitExceeded if initial_size > Limits::FILE_BYTES
            current_size: usize = try file_size(input_path) else err:
                raise MigrationInventoryError.ReadFailed
            raise MigrationInventoryError.InputLimitExceeded if current_size > initial_size or current_size > Limits::FILE_BYTES
            contents: sview = try read_text(input_path) else err:
                raise MigrationInventoryError.ReadFailed
            raise MigrationInventoryError.InputLimitExceeded if len(contents) > initial_size or len(contents) > Limits::FILE_BYTES
            return contents


        def root_relative_path_valid(value: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if value == "" or len(value) > Limits::PATH_BYTES
            return false if value.startswith("/") or value.startswith("./")
            components: darray[sview] = split(value, "/")
            for component in components:
                return false if component == ".."
            return true


        def root_records_valid(contents: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            lines: darray[sview] = split(contents, "\n")
            return false if lines.count < 2
            rows: mutable darray[RootRecord] = []
            for index in 1..<lines.count |contents, lines, rows|:
                line: sview = lines[index]
                terminal_split_field: bool = index + 1 == lines.count and contents.endswith("\n") and line == ""
                if line != "" and not terminal_split_field:
                    return false if rows.count >= Limits::MANIFEST_ROWS
                    tabs: mutable usize = 0
                    for byte in line:
                        tabs <- tabs + 1 if byte == 9u8
                        return false if tabs > 3
                    return false if tabs != 3
                    fields: darray[sview] = split(line, "\t")
                    return false if fields.count != 4
                    for field in fields:
                        return false if field == "" or len(field) > Limits::FIELD_BYTES
                    return false if not root_relative_path_valid(fields[1])
                    return false if fields[3] != "pending" and fields[3] != "reviewed" and fields[3] != "blocked"
                    rows.push(RootRecord{name: fields[0], relative_path: fields[1], owner: fields[2], review_status: fields[3]})
            return false if rows.count == 0

            names: mutable darray[sview] = []
            paths: mutable darray[sview] = []
            for row in rows:
                names.push(row.name)
                paths.push(row.relative_path)
            ordered_names: darray[sview] = sorted(names)
            ordered_paths: darray[sview] = sorted(paths)
            for index in 1..<ordered_names.count |ordered_names|:
                return false if ordered_names[index - 1] == ordered_names[index]
            for index in 1..<ordered_paths.count |ordered_paths|:
                return false if ordered_paths[index - 1] == ordered_paths[index]
            return true


        def root_header_valid(contents: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            for line in split(contents, "\n"):
                return true if Syntax::ROOT_HEADER.match(line)
            return false


        def has_all_fixed(contents: sview, required: darray[sview]) -> bool can[Memory.Allocate, Abort.Panic]:
            for needle in required:
                return false if contents.index(needle) < 0
            return true


        def contains_any(contents: sview, candidates: darray[sview]) -> bool can[Memory.Allocate, Abort.Panic]:
            for needle in candidates:
                return true if contents.index(needle) >= 0
            return false


    public:
        def validate_root_manifest_records(contents: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            return root_records_valid(contents)


        def validate_root_manifest_header(contents: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            return root_header_valid(contents)


        def run() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Process.Run, Unsafe.PointerCast]:
            script_path: Path = Script::source_path()
            script_directory: Path = try path_real(script_path.parent()) else err:
                eprint("migration inventory audit: unable to resolve script directory")
                return 1i64
            repository_root: Path = script_directory.parent()
            scripts_directory: Path = repository_root.joinpath("scripts")
            docs_directory: Path = repository_root.joinpath("docs")
            test_directory: Path = repository_root.joinpath("test")

            roots_file: Path = docs_directory.joinpath("migration-project-roots.tsv")
            schema_file: Path = docs_directory.joinpath("migration-inventory-schema.md")
            coordinator: Path = scripts_directory.joinpath("inventory_project_roots.sh")
            review_file: Path = docs_directory.joinpath("migration-review-current.tsv")
            review_audit: Path = scripts_directory.joinpath("check_migration_review.sh")
            roots_audit: Path = scripts_directory.joinpath("check_migration_roots.sh")
            candidate_shell: Path = scripts_directory.joinpath("inventory_candidates.sh")
            signals_shell: Path = scripts_directory.joinpath("inventory_signals.sh")
            walker_file: Path = scripts_directory.joinpath("inventory_walk.elisascript")
            walker_test: Path = test_directory.joinpath("script_parity").joinpath("inventory_walk_test.elisascript")
            candidate_file: Path = scripts_directory.joinpath("inventory_candidates.elisascript")
            signals_file: Path = scripts_directory.joinpath("inventory_signals.elisascript")
            candidate_fixture: Path = test_directory.joinpath("fixtures").joinpath("script_parity").joinpath("inventory_candidates").joinpath("EXPECTATIONS.md")
            required_files: darray[Path] = [roots_file, schema_file, review_file, review_audit, roots_audit, coordinator, walker_file, walker_test, candidate_file, candidate_fixture, candidate_shell, signals_shell, signals_file]
            for required_file in required_files:
                if not is_file(required_file):
                    eprint(f"{Messages::MISSING}{required_file}")
                    return 1i64

            if not is_executable(coordinator):
                eprint(Messages::COORDINATOR_NOT_EXECUTABLE)
                return 1i64
            if not is_executable(roots_audit):
                eprint(Messages::ROOTS_AUDIT_NOT_EXECUTABLE)
                return 1i64

            roots_text: sview = try read_bounded_text(roots_file) else err:
                eprint(Messages::HEADER_INVALID)
                return 1i64
            if not root_header_valid(roots_text):
                eprint(Messages::HEADER_INVALID)
                return 1i64
            if not root_records_valid(roots_text):
                eprint(Messages::MANIFEST_INVALID)
                return 1i64

            required_root_names: darray[sview] = ["C++ projects", "Elisa Projects", "FSharpProjects", "Go projects", "Haskell Projects", "Java Projects", "Lean Projects", "Ocaml Projects", "Python Projects", "Rust Projects", "Swift Projects"]
            for root_name in required_root_names:
                if roots_text.index(root_name + "\t") < 0:
                    eprint("migration inventory audit: missing declared root " + root_name)
                    return 1i64

            schema_text: sview = try read_bounded_text(schema_file) else err:
                eprint(Messages::SCHEMA_MISSING_SCANNER)
                return 1i64
            if not Syntax::SCHEMA_CANDIDATE.search(schema_text) or not Syntax::SCHEMA_SIGNALS.search(schema_text) or not Syntax::SCHEMA_COORDINATOR.search(schema_text):
                eprint(Messages::SCHEMA_MISSING_SCANNER)
                return 1i64

            candidate_shell_text: sview = try read_bounded_text(candidate_shell) else err:
                eprint(Messages::EXCLUSION_INVALID + "(unreadable)")
                return 1i64
            signals_shell_text: sview = try read_bounded_text(signals_shell) else err:
                eprint(Messages::EXCLUSION_INVALID + "(unreadable)")
                return 1i64
            walker_text: sview = try read_bounded_text(walker_file) else err:
                eprint(Messages::WALKER_INVARIANT_MISSING + "(unreadable)")
                return 1i64
            excluded_trees: darray[sview] = [".git", "node_modules", ".venv", "__pycache__", "vendor", "third_party"]
            for excluded_tree in excluded_trees:
                candidate_exclusion: sview = "-name '" + excluded_tree + "'"
                signal_exclusion: sview = "-path '*/" + excluded_tree + "'"
                elisa_exclusion: sview = "name == \"" + excluded_tree + "\""
                if candidate_shell_text.index(candidate_exclusion) < 0 or signals_shell_text.index(signal_exclusion) < 0 or walker_text.index(elisa_exclusion) < 0:
                    eprint(Messages::EXCLUSION_INVALID + excluded_tree)
                    return 1i64

            if candidate_shell_text.index("Makefile|makefile|*/Makefile|*/makefile") < 0:
                eprint(Messages::MAKEFILE_CLASSIFICATION_MISSING)
                return 1i64

            candidate_elisa_text: sview = try read_bounded_text(candidate_file) else err:
                eprint(Messages::WALKER_INCLUDE_MISSING + f"{candidate_file}")
                return 1i64
            signals_elisa_text: sview = try read_bounded_text(signals_file) else err:
                eprint(Messages::WALKER_INCLUDE_MISSING + f"{signals_file}")
                return 1i64
            source_paths: darray[sview] = [f"{candidate_file}", f"{signals_file}"]
            source_texts: darray[sview] = [candidate_elisa_text, signals_elisa_text]
            for index in 0..<source_texts.count |source_paths, source_texts|:
                source_text: sview = source_texts[index]
                if source_text.index("include \"./inventory_walk.elisascript\"") < 0:
                    eprint(f"{Messages::WALKER_INCLUDE_MISSING}{source_paths[index]}")
                    return 1i64
                forbidden_find: darray[sview] = ["exe\"find\"", "find_base_arguments", "find -print0"]
                if contains_any(source_text, forbidden_find):
                    eprint(f"{Messages::FIND_BACKED_WALK_MISSING}{source_paths[index]}")
                    return 1i64

            walker_invariants: darray[sview] = ["openat", "fstatat", "DarwinStatMode::SYMLINK", "DIRECTORY_ENTRIES", "DIRECTORY_DEPTH", "PATH_BYTES", "elisascript_posix_closedir", "Phase.Unwind"]
            for invariant in walker_invariants:
                if walker_text.index(invariant) < 0:
                    eprint(f"{Messages::WALKER_INVARIANT_MISSING}{invariant}")
                    return 1i64

            walker_test_text: sview = try read_bounded_text(walker_test) else err:
                eprint(Messages::WALKER_TEST_MISSING + "(unreadable)")
                return 1i64
            walker_cases: darray[sview] = ["RegularFileLimitExceeded", "DirectoryLimitExceeded", "EntryLimitExceeded", "DepthExceeded", "PathBytesExceeded", "SelectedPathBytesExceeded", "InvalidPolicy"]
            for test_case in walker_cases:
                if walker_test_text.index("DirectoryWalkFailure::" + test_case) < 0:
                    eprint(f"{Messages::WALKER_TEST_MISSING}{test_case}")
                    return 1i64

            if signals_elisa_text.index("required_mode_bits") < 0 or candidate_elisa_text.index("suffixes: [") < 0:
                eprint(Messages::SELECTOR_CONFIG_MISSING)
                return 1i64

            candidate_invariants: darray[sview] = ["def sorted_unique_paths", "ordered: darray[sview] = sorted(values)", "unique: mutable darray[sview] = []", "unique[unique.count - 1] != value", "ordered_paths <- sorted_unique_paths(candidate_paths)"]
            for invariant in candidate_invariants:
                if candidate_elisa_text.index(invariant) < 0:
                    eprint(f"{Messages::CANDIDATE_INVARIANT_MISSING}{invariant}")
                    return 1i64

            fixture_text: sview = try read_bounded_text(candidate_fixture) else err:
                eprint(Messages::FIXTURE_CONTRACT_MISSING)
                return 1i64
            if fixture_text.index("bounded adjacent-dedup") < 0 or fixture_text.index("sort -u") < 0:
                eprint(Messages::FIXTURE_CONTRACT_MISSING)
                return 1i64

            bash_status: i64 = try run_process(exe"/bin/bash", ["-n", f"{coordinator}", f"{candidate_shell}", f"{signals_shell}", f"{review_audit}", f"{roots_audit}"]) else err:
                eprint("migration inventory audit: bash syntax check failed to start")
                return 1i64
            if bash_status != 0:
                return bash_status

            review_audit_text: sview = try read_bounded_text(roots_audit) else err:
                eprint(Messages::ROOT_OWNERSHIP_MISSING)
                return 1i64
            if not Syntax::ROOT_OWNERSHIP.search(review_audit_text) or not Syntax::ROOT_OWNERSHIP.search(schema_text):
                eprint(Messages::ROOT_OWNERSHIP_MISSING)
                return 1i64

            containment_files: darray[sview] = [coordinator, roots_audit]
            coordinator_text: sview = try read_bounded_text(coordinator) else err:
                eprint(f"{Messages::CONTAINMENT_MISSING}{coordinator}")
                return 1i64
            containment_texts: darray[sview] = [coordinator_text, review_audit_text]
            for index in 0..<containment_files.count |containment_files, containment_texts|:
                required_containment: darray[sview] = ["pwd -P", "canonical_root_path", "escapes coding-projects tree"]
                if not has_all_fixed(containment_texts[index], required_containment):
                    eprint(f"{Messages::CONTAINMENT_MISSING}{containment_files[index]}")
                    return 1i64

            if coordinator_text.index("NR == 1") < 0 or coordinator_text.index("names[$1]++") < 0 or coordinator_text.index("paths[$2]++") < 0 or not Syntax::REVIEWED_OWNER_CHECK.search(coordinator_text):
                eprint(Messages::COORDINATOR_PREFLIGHT_MISSING)
                return 1i64

            println("migration inventory audit: partition manifest and bounded read-only scanners present")
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, File.Read, Directory.Read, Process.Run, Unsafe.PointerCast]:
    if arguments.count != 0:
        eprint("usage: check_migration_inventory")
        return 2i64
    return EsMigrationInventoryAudit::run()
