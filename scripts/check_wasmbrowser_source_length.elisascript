# Bounded port of wasmbrowser-proof/scripts/check_source_length.py.
# The neighboring project remains untouched; source path selects the default.
include "../src/runtime/source_length_stream_posix.elisa"

module EsProofSourceLength:
    private:
        const module Limits:
            MAX_LINES: usize = 600
            FILE_BYTES: usize = 16777216
            TOTAL_FILE_BYTES: usize = 67108864
            FILES: usize = 8192
            DIRECTORIES: usize = 4096
            DEPTH: usize = 64
            ENTRIES_PER_DIRECTORY: usize = 16384
            TOTAL_ENTRIES: usize = 65536
            PATH_BYTES: usize = 4096
            TOTAL_PATH_BYTES: usize = 16777216


        struct Directory:
            path: Path
            depth: usize


        struct Oversized:
            relative_path: sview
            lines: usize


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr("source length audit: " + message + "\n")


        # POSIX filenames cannot contain NUL. Replacing the separator by NUL
        # makes byte sorting compare each component before its descendants.
        # For example, a/z.elisa sorts before a.elisa, as pathlib requires.
        def path_order_key(value: sview) -> sview:
            return replace(value, "/", "\0")

    public:
        # Inputs are POSIX filesystem paths (no embedded NUL), not arbitrary
        # text. Keep this policy callable by independent ordering fixtures.
        def ordered_source_paths(paths: darray[sview]) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            keys: mutable darray[sview] = []
            for value in paths:
                keys.push(path_order_key(value))
            result: mutable darray[sview] = []
            for key in sorted(keys):
                result.push(replace(key, "\0", "/"))
            return result


        def run_root(project_root: Path) -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
            source_root: Path = project_root.joinpath("src")
            exists: bool = try is_directory(source_root) else err:
                diagnostic("unable to inspect source root")
                return 2i64
            # Python's rglob over a missing/non-directory root yields no files.
            return 0i64 if not exists

            directories: mutable darray[Directory] = [Directory{path: source_root, depth: 0}]
            source_paths: mutable darray[sview] = []
            visited_entries: mutable usize = 0
            path_bytes: mutable usize = 0
            directory_index: mutable usize = 0
            while directory_index < directories.count:
                current: Directory = directories[directory_index]
                children: darray[sview] = try current.path.iterdir() else err:
                    diagnostic(f"unable to enumerate directory: {current.path}")
                    return 2i64
                if children.count > Limits::ENTRIES_PER_DIRECTORY or children.count > Limits::TOTAL_ENTRIES - visited_entries:
                    diagnostic("directory entry limit exceeded")
                    return 2i64
                visited_entries <- visited_entries + children.count
                for child in children:
                    if len(child) >= Limits::PATH_BYTES or len(child) > Limits::TOTAL_PATH_BYTES - path_bytes:
                        diagnostic("path byte limit exceeded")
                        return 2i64
                    path_bytes <- path_bytes + len(child)
                    child_path: Path = path(child)
                    # Include hidden names, file symlinks, and matching
                    # directories. A matching directory must fail when read,
                    # not silently disappear from the rglob result.
                    if child_path.name().endswith(".elisa"):
                        if source_paths.count >= Limits::FILES:
                            diagnostic("source file count limit exceeded")
                            return 2i64
                        source_paths.push(child)
                    continue if is_symlink(child_path)
                    child_is_directory: bool = try is_directory(child_path) else err:
                        diagnostic(f"unable to inspect entry: {child_path}")
                        return 2i64
                    if child_is_directory:
                        if directories.count >= Limits::DIRECTORIES or current.depth >= Limits::DEPTH:
                            diagnostic("directory count or depth limit exceeded")
                            return 2i64
                        directories.push(Directory{path: child_path, depth: current.depth + 1})
                directory_index <- directory_index + 1

            oversized: mutable darray[Oversized] = []
            total_file_bytes: mutable usize = 0
            for source_path in ordered_source_paths(source_paths):
                input_path: Path = path(source_path)
                remaining: usize = Limits::TOTAL_FILE_BYTES - total_file_bytes
                read_limit: usize = Limits::FILE_BYTES if remaining > Limits::FILE_BYTES else remaining
                scan: EsSourceLengthFile::ScanResult = try EsSourceLengthFile::read_utf8_line_count(input_path, read_limit) else err:
                    diagnostic(f"unable to read bounded UTF-8 source: {input_path}")
                    return 2i64
                total_file_bytes <- total_file_bytes + scan.bytes_read
                lines: usize = scan.lines
                if lines > Limits::MAX_LINES:
                    relative: Path = input_path.relative_to(project_root)
                    oversized.push(Oversized{relative_path: f"{relative}", lines: lines})

            # Like Python, emit no size diagnostics until all reads succeed.
            for source in oversized:
                _ = write_stderr(f"source file exceeds {Limits::MAX_LINES} lines: {source.relative_path} ({source.lines})\n")
            return 1i64 if oversized.count > 0 else 0i64


        def run_default() -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
            script_directory: Path = try path_real(path_parent(Script::source_path())) else err:
                diagnostic("unable to resolve script directory")
                return 2i64
            project_root: Path = script_directory.parent().parent().joinpath("wasmbrowser-proof")
            return run_root(project_root)


def main(arguments: darray[sview]) -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
    _ = arguments
    return EsProofSourceLength::run_default()
