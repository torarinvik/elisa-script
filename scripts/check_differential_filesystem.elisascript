# Bounded Elisascript port of check_differential_filesystem.sh.
# This candidate reads audited source as bounded UTF-8 and never starts rg.
# The shell reference remains the parity oracle until its gated launcher matrix
# is explicitly authorized and run.

include "../src/runtime/bounded_text_posix.elisa"

using EsBoundedText


module EsDifferentialFilesystemAudit:
    private:
        const module Limits:
            SOURCE_BYTES: usize = 16777216
            TOTAL_SOURCE_BYTES: usize = 33554432


        const module Inputs:
            MODEL: sview = "src/testing/filesystem_snapshot_model.elisa"
            CONSUMER: sview = "src/testing/differential.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/differential/elisascript_differential_test.elisa"
            DOCS: sview = "docs/differential-testing.md"


        error AuditReadError:
            Missing
            LimitExceeded


        def display_path(root: sview, relative: sview) -> sview:
            return "/" + relative if root == "/"
            return root + "/" + relative


        def write_diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def contains_all(source: sview, required: darray[sview]) -> bool:
            for needle in required:
                return false if source.index(needle) < 0
            return true


        def read_source(input_path: Path, source_size: usize) -> sview error[AuditReadError] can[Memory.Allocate, Abort.Panic, Blocking.IO, File.Read, Unsafe.PointerCast]:
            current_size: usize = try file_size(input_path) else err:
                raise AuditReadError.Missing
            raise AuditReadError.LimitExceeded if current_size > source_size or current_size > Limits::SOURCE_BYTES
            source: sview = try EsBoundedText::read_utf8(input_path, source_size) else failure:
                if failure == EsBoundedText::ReadError.LimitExceeded:
                    raise AuditReadError.LimitExceeded
                raise AuditReadError.Missing
            raise AuditReadError.LimitExceeded if len(source) > source_size or len(source) > Limits::SOURCE_BYTES
            return source


    public:
        def run(repository_root: Path) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Blocking.IO, Directory.Read, File.Read, Unsafe.PointerCast]:
            if not is_directory(repository_root):
                write_diagnostic("differential filesystem audit: missing repository root")
                return 1i64
            root_absolute: Path = try path_real(path_absolute(repository_root)) else err:
                write_diagnostic("differential filesystem audit: missing repository root")
                return 1i64
            root_text: sview = f"{root_absolute}"
            relative_paths: darray[sview] = [Inputs::MODEL, Inputs::CONSUMER, Inputs::IR, Inputs::FIXTURE, Inputs::DOCS]
            source_sizes: mutable darray[usize] = []
            sources: mutable darray[sview] = []
            total_bytes: mutable usize = 0

            for relative in relative_paths |relative_paths, root_absolute, root_text|:
                input_path: Path = path_join(root_absolute, relative)
                if not is_file(input_path) or not is_readable(input_path):
                    write_diagnostic(f"differential filesystem audit: missing {display_path(root_text, relative)}")
                    return 1i64

            for relative in relative_paths |relative_paths, root_absolute, root_text, source_sizes, total_bytes|:
                input_display: sview = display_path(root_text, relative)
                input_path: Path = path_join(root_absolute, relative)
                source_size: usize = try file_size(input_path) else err:
                    write_diagnostic(f"differential filesystem audit: missing {input_display}")
                    return 1i64
                if source_size > Limits::SOURCE_BYTES or source_size > Limits::TOTAL_SOURCE_BYTES - total_bytes:
                    write_diagnostic(f"differential filesystem audit: source exceeds audit limit: {input_display}")
                    return 2i64
                total_bytes <- total_bytes + source_size
                source_sizes.push(source_size)

            for relative in relative_paths |relative_paths, root_absolute, root_text, source_sizes, sources|:
                input_display: sview = display_path(root_text, relative)
                input_path: Path = path_join(root_absolute, relative)
                source_index: usize = sources.count
                catch read_source(input_path, source_sizes[source_index]):
                    ok source:
                        sources.push(source)
                    error failure:
                        if failure == AuditReadError.LimitExceeded:
                            write_diagnostic(f"differential filesystem audit: source exceeds audit limit: {input_display}")
                            return 2i64
                        write_diagnostic(f"differential filesystem audit: missing {input_display}")
                        return 1i64

            model: sview = sources[0]
            consumer: sview = sources[1]
            ir: sview = sources[2]
            fixture: sview = sources[3]
            docs: sview = sources[4]

            declarations: darray[sview] = [
                "module EsDifferentialFilesystem:",
                "Limits::ENTRIES",
                "Limits::PATH_STORAGE_BYTES",
                "Limits::TOTAL_BYTES",
                "const enum DifferentialFilesystemEntryKind of u8:",
                "const enum DifferentialFilesystemState of u8:",
                "const enum DifferentialFilesystemEvent of u8:",
                "struct DifferentialFilesystemEntry:",
                "struct DifferentialFilesystemEntryRecord:",
                "struct DifferentialFilesystemSnapshot:",
                "const enum DifferentialFilesystemDifferenceKind of u8:",
                "struct DifferentialFilesystemDifference:",
                "error DifferentialFilesystemError:",
                "def validate_differential_filesystem_snapshot(",
                "def collect_unordered_differential_filesystem_entry(",
                "def seal_unordered_differential_filesystem_snapshot(",
                "def advance_differential_filesystem_snapshot(",
                "def differential_filesystem_snapshot_fingerprint(",
                "def differential_filesystem_hash_mix(",
                "def differential_filesystem_entry_mode_valid(",
                "def compare_differential_filesystem_snapshots(",
                "def copy_differential_filesystem_entry_path(",
                "def copy_differential_filesystem_entry_content("
            ]
            if not contains_all(model, declarations):
                return 1i64

            boundaries: darray[sview] = [
                "differential_filesystem_path_safe",
                "differential_filesystem_path_span_safe",
                "differential_filesystem_entries_path_data_contiguous",
                "differential_filesystem_entries_content_data_contiguous",
                "differential_filesystem_entries_ancestors_valid",
                "differential_filesystem_compact_sorted_data",
                "differential_filesystem_sort_entries",
                "PathStorageLimitExceeded",
                "SnapshotAccountingInvalid",
                "AncestorNotDirectory",
                "InvalidMode",
                "mode > 511u32",
                "mode & 73u32",
                "differential_filesystem_entry_mode_valid(entry.kind, entry.mode, entry.executable)",
                "InvalidMode if not differential_filesystem_entry_mode_valid(entry.kind, entry.mode, entry.executable)",
                "EntryOrderInvalid",
                "ByteLimitExceeded",
                "SnapshotNotSealed",
                "MissingReference",
                "MissingCandidate",
                "DifferentialFilesystemDifferenceKind.Content",
                "DifferentialFilesystemDifferenceKind.Executable",
                "has_reference_entry",
                "has_candidate_entry",
                "path_data: darray[u8]",
                "content_data: darray[u8]",
                "content_start: usize",
                "content_bytes: usize",
                "filesystem entry bytes differ"
            ]
            if not contains_all(model, boundaries):
                return 1i64
            if model.index("EsHash::hash_wrapping_add_u64(EsHash::hash_wrapping_multiply_u64(hash, DIFFERENTIAL_FILESYSTEM_HASH_PRIME), value)") < 0:
                return 1i64
            if model.index("differential_filesystem_hash_mix(result, snapshot.total_bytes.u64())") < 0:
                return 1i64
            if model.index("result <- result * DIFFERENTIAL_FILESYSTEM_HASH_PRIME") >= 0:
                return 1i64
            if ir.index("include \"../runtime/hash_model.elisa\"") < 0:
                return 1i64
            if consumer.index("include \"./filesystem_snapshot_model.elisa\"") < 0:
                return 1i64

            fixture_patterns: darray[sview] = [
                "using EsDifferentialFilesystem",
                "differential_filesystem_snapshot_contract_orders_entries_and_reports_first_difference",
                "DifferentialFilesystemEntryKind.Directory",
                "DifferentialFilesystemError.EntryOrderInvalid",
                "DifferentialFilesystemDifferenceKind.Equal",
                "DifferentialFilesystemDifferenceKind.Content",
                "assert differential_filesystem_snapshot_fingerprint(reference) == differential_filesystem_snapshot_fingerprint(candidate)",
                "copy_differential_filesystem_entry_path",
                "copy_differential_filesystem_entry_content",
                "differential_filesystem_compares_binary_files_and_raw_symlink_targets",
                "posix_backslash_path",
                "path_data.count",
                "content_data.count",
                "differential_filesystem_unordered_batch_is_bounded_sorted_and_sealed",
                "differential_filesystem_rejects_non_directory_ancestors",
                "differential_filesystem_requires_canonical_permission_metadata",
                "forged_path_copy_rejected",
                "forged_content_copy_rejected",
                "DifferentialFilesystemError.InvalidMode",
                "DifferentialFilesystemError.AncestorNotDirectory",
                "DifferentialFilesystemError.PathStorageLimitExceeded",
                "DifferentialFilesystemState.Cancelled"
            ]
            if not contains_all(fixture, fixture_patterns):
                return 1i64
            docs_patterns: darray[sview] = [
                "EsDifferentialFilesystem::DifferentialFilesystemSnapshot",
                "Exact-payload snapshot contract",
                "ordinary permission bits (`0000` through `0777`)",
                "executable marker must match those bits",
                "backslash is an"
            ]
            if not contains_all(docs, docs_patterns):
                return 1i64

            print("differential filesystem audit: bounded exact payload snapshots, valid tree ancestors, fingerprints, and first-difference comparison are present")
            return 0i64


        def run_default() -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Blocking.IO, Directory.Read, File.Read, Unsafe.PointerCast]:
            script_path: Path = Script::source_path()
            script_directory: Path = try path_real(path_absolute(script_path.parent())) else err:
                write_diagnostic("differential filesystem audit: missing repository root")
                return 1i64
            return run(script_directory.parent())


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Blocking.IO, Directory.Read, File.Read, Unsafe.PointerCast]:
    return EsDifferentialFilesystemAudit::run_default()
