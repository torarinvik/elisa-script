# Bounded Elisascript port of check_map_set_index_bounds.sh.
# Capacity and mutation-order assertions stream each backend function body.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsMapSetIndexBoundsAudit:
    private:
        const module Inputs:
            INTERPRETER: sview = "src/ir/interpret.elisa"
            BYTECODE: sview = "src/bytecode/bytecode.elisa"
            INTERPRETER_FIXTURE: sview = "test/ir/elisascript_interpreter_test.elisa"
            BYTECODE_FIXTURE: sview = "test/ir/elisascript_bytecode_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            INTERPRETER_FUNCTION: sview = "def evaluate_set_index"
            BYTECODE_FUNCTION: sview = "def bytecode_direct_set_index"
            INTERPRETER_DECLARATION: sview = "        def evaluate_set_index("
            BYTECODE_DECLARATION: sview = "        def bytecode_direct_set_index("
            MAP_CEILING: sview = "collection.map_count == 4294967295u32"
            GROWING_SPAN: sview = "runtime_storage_pairs_u32_valid(storage, collection.map_count.usize() + 1)"
            EXISTING_SPAN: sview = "runtime_storage_pairs_u32_valid(storage, collection.map_count.usize())"
            SEARCH_START: sview = "found: mutable bool = false"
            ALLOCATE_START: sview = "start: u32 = storage.count.u32()"
            DOCS: sview = "Indexed map updates search"
            LEDGER: sview = "`SetIndex` map updates also preflight"


        const module Messages:
            MISSING_ROOT: sview = "map set-index bounds audit: missing repository root"
            UNRESOLVED_ROOT: sview = "map set-index bounds audit: unable to resolve repository root"
            MISSING_INPUT: sview = "map set-index bounds audit: missing "
            MISSING_MARKERS: sview = "map set-index bounds audit: missing preflight markers in "
            WRONG_ORDER: sview = "map set-index bounds audit: allocation precedes preflight in "
            READ_FAILED: sview = "map set-index bounds audit: unable to read source: "
            SUCCESS: sview = "map set-index bounds audit: reference and direct backends preflight map capacity before copying"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


        def has_line_prefix(path: Path, prefix: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, prefix, "", "", true):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


        def has_ordered_line(path: Path, first: sview, second: sview, third: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, first, second, third):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


        def assert_preflight_before_allocate(path: Path, definition: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            body: EsSourceFunctionScope::FunctionBody = try EsSourceFunctionScope::read_function_body(path, definition) else err:
                diagnostic(Messages::READ_FAILED + f"{path}")
                return ExitStatus::IO_FAILURE
            ceiling_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::MAP_CEILING)
            span_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::GROWING_SPAN)
            existing_span_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::EXISTING_SPAN)
            search_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::SEARCH_START)
            allocate_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::ALLOCATE_START)
            if ceiling_line == 0 or span_line == 0 or existing_span_line == 0 or search_line == 0 or allocate_line == 0:
                diagnostic(Messages::MISSING_MARKERS + f"{path}")
                return ExitStatus::FAILURE
            if search_line >= ceiling_line or search_line >= span_line or existing_span_line >= allocate_line or ceiling_line >= allocate_line or span_line >= allocate_line:
                diagnostic(Messages::WRONG_ORDER + f"{path}")
                return ExitStatus::FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::BYTECODE),
                root.joinpath(Inputs::INTERPRETER_FIXTURE),
                root.joinpath(Inputs::BYTECODE_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: mutable i64 = has_line_prefix(inputs[0], Patterns::INTERPRETER_DECLARATION)
            return status if status != 0i64
            status <- has_line_prefix(inputs[1], Patterns::BYTECODE_DECLARATION)
            return status if status != 0i64
            status <- assert_preflight_before_allocate(inputs[0], Patterns::INTERPRETER_FUNCTION)
            return status if status != 0i64
            status <- assert_preflight_before_allocate(inputs[1], Patterns::BYTECODE_FUNCTION)
            return status if status != 0i64

            status <- has_ordered_line(inputs[2], "values", "two", "<-")
            return status if status != 0i64
            status <- has_ordered_line(inputs[3], "values", "two", "<-")
            return status if status != 0i64

            checks: darray[SearchCheck] = [
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS},
                SearchCheck{input: inputs[5], pattern: Patterns::LEDGER}
            ]
            for check in checks:
                status <- has_line(check.input, check.pattern)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsMapSetIndexBoundsAudit::run_default()
