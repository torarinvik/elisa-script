# Bounded Elisascript port of check_exit_status.sh.
# Source checks use the shared scanner without launching rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsExitStatusAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/exit_status_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "^module EsExitStatus:"
            MODEL_IMPORT: sview = "include \"\\.\\./runtime/exit_status_model\\.elisa\""
            OUTCOME_ENUM: sview = "const enum ExitOutcome of u8"
            STATUS_STRUCT: sview = "struct ExitStatus:"
            STATUS_ERROR: sview = "error ExitStatusError:"
            VALIDATE_STATUS: sview = "def validate_exit_status\\("
            STATUS_CODE: sview = "def exit_status_code\\("
            CODE_MAX: sview = "EXIT_CODE_MAX_USER"
            SIGNAL_BASE: sview = "EXIT_STATUS_SIGNAL_BASE"
            SIGNAL_MAX: sview = "EXIT_STATUS_MAX_SIGNAL"
            SOURCE_ERROR: sview = "ExitOutcome.SourceError"
            CHECK_FAILURE: sview = "ExitOutcome.CheckFailure"
            CANCELLED: sview = "ExitOutcome.Cancelled"
            INVALID_USER_CODE: sview = "ExitStatusError.InvalidUserCode"
            INVALID_SIGNAL: sview = "ExitStatusError.InvalidSignal"
            INVALID_DETAIL: sview = "ExitStatusError.InvalidDetail"
            DETAIL_CODE: sview = "status.detail_code != 0"
            FIXTURE_IMPORT: sview = "using EsExitStatus"
            FIXTURE_CONTRACT: sview = "typed_exit_status_contract_maps_user_failures_and_signals"
            FIXTURE_SOURCE_ERROR: sview = "ExitOutcome.SourceError"
            FIXTURE_SIGNAL: sview = "ExitOutcome.Signal"
            FIXTURE_INVALID_USER_CODE: sview = "ExitStatusError.InvalidUserCode"
            FIXTURE_INVALID_DETAIL: sview = "ExitStatusError.InvalidDetail"
            DOCS_STATUS_TYPE: sview = "EsExitStatus::ExitStatus"
            LEDGER_CONTRACT: sview = "ES-SCRIPT-047"


        const module Messages:
            MISSING_ROOT: sview = "exit status audit: missing repository root"
            UNRESOLVED_ROOT: sview = "exit status audit: unable to resolve repository root"
            MISSING_INPUT: sview = "exit status audit: missing "
            READ_FAILED: sview = "exit status audit: unable to read source: "
            SUCCESS: sview = "exit status audit: bounded user, reserved failure, cancellation, and signal mappings are present"


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(model: Path, ir: Path, fixture: Path, docs: Path, ledger: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: model, pattern: Patterns::MODULE},
                SearchCheck{input: ir, pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: model, pattern: Patterns::OUTCOME_ENUM},
                SearchCheck{input: model, pattern: Patterns::STATUS_STRUCT},
                SearchCheck{input: model, pattern: Patterns::STATUS_ERROR},
                SearchCheck{input: model, pattern: Patterns::VALIDATE_STATUS},
                SearchCheck{input: model, pattern: Patterns::STATUS_CODE},
                SearchCheck{input: model, pattern: Patterns::CODE_MAX},
                SearchCheck{input: model, pattern: Patterns::SIGNAL_BASE},
                SearchCheck{input: model, pattern: Patterns::SIGNAL_MAX},
                SearchCheck{input: model, pattern: Patterns::SOURCE_ERROR},
                SearchCheck{input: model, pattern: Patterns::CHECK_FAILURE},
                SearchCheck{input: model, pattern: Patterns::CANCELLED},
                SearchCheck{input: model, pattern: Patterns::INVALID_USER_CODE},
                SearchCheck{input: model, pattern: Patterns::INVALID_SIGNAL},
                SearchCheck{input: model, pattern: Patterns::INVALID_DETAIL},
                SearchCheck{input: model, pattern: Patterns::DETAIL_CODE},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_SOURCE_ERROR},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_SIGNAL},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_INVALID_USER_CODE},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_INVALID_DETAIL},
                SearchCheck{input: docs, pattern: Patterns::DOCS_STATUS_TYPE},
                SearchCheck{input: ledger, pattern: Patterns::LEDGER_CONTRACT}
            ]


        def has_match(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(check.pattern)
            catch EsSourceFunctionScope::contains_file_regex_line(check.input, pattern):
                ok found:
                    return 1i64 if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return 2i64


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                status: i64 = has_match(check)
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return 1i64
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return 1i64

            status: i64 = execute(searches(inputs[0], inputs[1], inputs[2], inputs[3], inputs[4]))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsExitStatusAudit::run_default()
