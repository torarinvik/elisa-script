# Bounded Elisascript port of check_handle_model.sh.
# Ordered fixed-string checks stream source without spawning rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsHandleModelAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/handle_model.elisa"
            RESOURCE_MODEL: sview = "src/runtime/resource_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Messages:
            MISSING_ROOT: sview = "handle audit: missing repository root"
            UNRESOLVED_ROOT: sview = "handle audit: unable to resolve repository root"
            MISSING_INPUT: sview = "handle audit: missing "
            READ_FAILED: sview = "handle audit: unable to read source: "
            SUCCESS: sview = "handle audit: bounded raw identities, owner-token transfer, duplicate rejection, close/failure accounting, and abandonment are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::RESOURCE_MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            declarations: darray[sview] = [
                "module EsHandle:",
                "HANDLE_MAX_ENTRIES",
                "const enum HostHandleState of u8:",
                "const enum HostHandleEvent of u8:",
                "struct HostHandle:",
                "struct HostHandleTable:",
                "error HostHandleError:",
                "def validate_host_handle_table(",
                "def host_handle_acquire(",
                "def advance_host_handle("
            ]
            status: mutable i64 = 0i64
            for declaration in declarations:
                status <- has_line(inputs[0], declaration)
                return status if status != 0i64

            boundaries: darray[sview] = [
                "DuplicateResource",
                "DuplicateRawHandle",
                "OwnerMismatch",
                "TransferInvalid",
                "InvalidTransition",
                "AccountingInvalid",
                "HostHandleState.Closing",
                "HostHandleState.Failed"
            ]
            for boundary in boundaries:
                status <- has_line(inputs[0], boundary)
                return status if status != 0i64

            status <- has_line(inputs[2], "include \"../runtime/handle_model.elisa\"")
            return status if status != 0i64
            status <- has_line(inputs[3], "using EsHandle")
            return status if status != 0i64

            fixture_patterns: darray[sview] = [
                "typed_host_handle_contract_tracks_raw_identity_transfer_and_cleanup",
                "HostHandleEvent.Transfer",
                "HostHandleEvent.CompleteClose",
                "HostHandleEvent.Abandon",
                "HostHandleError.DuplicateRawHandle"
            ]
            for pattern in fixture_patterns:
                status <- has_line(inputs[3], pattern)
                return status if status != 0i64

            status <- has_line(inputs[4], "EsHandle supplies the host-handle table")
            return status if status != 0i64
            status <- has_line(inputs[5], "ES-SCRIPT-006 | EsHandle")
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsHandleModelAudit::run_default()
