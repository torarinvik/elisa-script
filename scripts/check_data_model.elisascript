# Bounded Elisascript port of check_data_model.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDataModelAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/data_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"


        const module Patterns:
            MODULE: sview = "module EsData:"
            MAX_INPUT_BYTES: sview = "DATA_MAX_INPUT_BYTES"
            MAX_DEPTH: sview = "DATA_MAX_DEPTH"
            FORMAT: sview = "const enum DataFormat of u8:"
            DECODER_STATE: sview = "const enum DataDecoderState of u8:"
            DECODER_EVENT: sview = "const enum DataDecoderEvent of u8:"
            CSV_LINE_ENDING: sview = "const enum CsvLineEndingMode of u8:"
            DECODE_LIMITS: sview = "struct DataDecodeLimits:"
            JSON_POLICY: sview = "struct JsonPolicy:"
            CSV_POLICY: sview = "struct CsvPolicy:"
            DECODER: sview = "struct DataDecoder:"
            ERROR: sview = "error DataContractError:"
            VALIDATE_DECODER: sview = "def validate_data_decoder("
            ADVANCE_DECODER: sview = "def advance_data_decoder("
            VALIDATE_JSON: sview = "def validate_json_policy("
            VALIDATE_CSV: sview = "def validate_csv_policy("
            INPUT_LIMIT: sview = "InputLimitExceeded"
            TOKEN_LIMIT: sview = "TokenLimitExceeded"
            DEPTH_LIMIT: sview = "DepthLimitExceeded"
            RECORD_LIMIT: sview = "RecordLimitExceeded"
            FIELD_LIMIT: sview = "FieldLimitExceeded"
            FIELD_BYTES_LIMIT: sview = "FieldBytesLimitExceeded"
            INPUT_ADD: sview = "data_limit_add(decoder.input_bytes, bytes_delta"
            FIELD_ADD: sview = "data_limit_add(decoder.fields, fields_delta"
            FIELD_BYTES_DELTA: sview = "field_bytes_delta > bytes_delta"
            DEPTH_CHECK: sview = "raise DataContractError.DepthLimitExceeded if depth > decoder.limits.depth"
            OFFSET_ACCOUNTING: sview = "OffsetAccountingInvalid"
            READY: sview = "decoder.state == DataDecoderState.Ready"
            COMPLETE: sview = "decoder.state == DataDecoderState.Complete"
            DECODER_FIELD_BYTES: sview = "decoder.field_bytes"
            INVALID_CSV_POLICY: sview = "InvalidCsvPolicy"
            CONFIGURED_BYTE_SEPARATOR: sview = "policy.line_ending == CsvLineEndingMode.ConfiguredByte and policy.record_separator == 0"
            RECORD_TERMINATOR_WIDTH: sview = "data_csv_record_terminator_width"
            RECORD_TERMINATOR_CONTAINS: sview = "data_csv_record_terminator_contains"
            UNEXPECTED_END: sview = "UnexpectedEnd"
            CANCELLED: sview = "Cancelled"
            MODEL_IMPORT: sview = "include \"../runtime/data_model.elisa\""
            FIXTURE_DECODER: sview = "typed_data_decoder_contract_bounds_json_and_csv_streams"
            FIXTURE_CSV: sview = "typed_csv_stream_handles_explicit_line_ending_modes"
            FIXTURE_CONFIGURED_BYTE: sview = "CsvLineEndingMode.ConfiguredByte"
            FIXTURE_LF: sview = "CsvLineEndingMode.Lf"
            FIXTURE_CRLF: sview = "CsvLineEndingMode.CrLf"
            FIXTURE_JSON_LINES: sview = "DataFormat.JsonLines"
            FIXTURE_BEGIN: sview = "DataDecoderEvent.Begin"
            FIXTURE_INVALID_CSV_POLICY: sview = "DataContractError.InvalidCsvPolicy"
            FIXTURE_INPUT_LIMIT: sview = "DataContractError.InputLimitExceeded"
            FORGED_READY: sview = "forged_ready"
            FORGED_COMPLETE: sview = "forged_complete"
            RECORD_DEPTH_REJECTED: sview = "record_depth_rejected"
            RECORD_OVERFLOW_REJECTED: sview = "record_overflow_rejected"
            OFFSET_15: sview = "decoder.offset == 15"
            FIELDS_4: sview = "decoder.fields == 4"
            DOCS_BOUNDARY: sview = "`EsData` is the format-neutral boundary"
            DOCS_LEGACY_TERMINATOR: sview = "legacy configurable single-byte terminator"


        const module Messages:
            MISSING_ROOT: sview = "data model audit: missing repository root"
            UNRESOLVED_ROOT: sview = "data model audit: unable to resolve repository root"
            MISSING_INPUT: sview = "data model audit: missing "
            READ_FAILED: sview = "data model audit: unable to read source: "
            SUCCESS: sview = "data model audit: bounded policies, explicit CSV line endings, and decoder state transitions are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_INPUT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_DEPTH},
                SearchCheck{input: inputs[0], pattern: Patterns::FORMAT},
                SearchCheck{input: inputs[0], pattern: Patterns::DECODER_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::DECODER_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::CSV_LINE_ENDING},
                SearchCheck{input: inputs[0], pattern: Patterns::DECODE_LIMITS},
                SearchCheck{input: inputs[0], pattern: Patterns::JSON_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::CSV_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::DECODER},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_DECODER},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE_DECODER},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_JSON},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_CSV},
                SearchCheck{input: inputs[0], pattern: Patterns::INPUT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::TOKEN_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::DEPTH_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::FIELD_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::FIELD_BYTES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::INPUT_ADD},
                SearchCheck{input: inputs[0], pattern: Patterns::FIELD_ADD},
                SearchCheck{input: inputs[0], pattern: Patterns::FIELD_BYTES_DELTA},
                SearchCheck{input: inputs[0], pattern: Patterns::DEPTH_CHECK},
                SearchCheck{input: inputs[0], pattern: Patterns::OFFSET_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::READY},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETE},
                SearchCheck{input: inputs[0], pattern: Patterns::DECODER_FIELD_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_CSV_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::CONFIGURED_BYTE_SEPARATOR},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_TERMINATOR_WIDTH},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_TERMINATOR_CONTAINS},
                SearchCheck{input: inputs[0], pattern: Patterns::UNEXPECTED_END},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLED},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_DECODER},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CSV},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONFIGURED_BYTE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_LF},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CRLF},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_JSON_LINES},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_BEGIN},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_CSV_POLICY},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INPUT_LIMIT},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_READY},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_COMPLETE},
                SearchCheck{input: inputs[2], pattern: Patterns::RECORD_DEPTH_REJECTED},
                SearchCheck{input: inputs[2], pattern: Patterns::RECORD_OVERFLOW_REJECTED},
                SearchCheck{input: inputs[2], pattern: Patterns::OFFSET_15},
                SearchCheck{input: inputs[2], pattern: Patterns::FIELDS_4},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_BOUNDARY},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_LEGACY_TERMINATOR}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDataModelAudit::run_default()
