# Bounded Elisascript port of check_package_model.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsPackageModelAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/package_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"


        const module Patterns:
            MODULE: sview = "module EsPackage:"
            FORMAT_VERSION: sview = "PACKAGE_FORMAT_VERSION"
            LOCK_ENTRY_LIMIT: sview = "PACKAGE_MAX_LOCK_ENTRIES"
            DEPENDENCY_KIND: sview = "const enum PackageDependencyKind of u8:"
            SOURCE_KIND: sview = "const enum PackageSourceKind of u8:"
            RESOLUTION_STATE: sview = "const enum PackageResolutionState of u8:"
            MANIFEST: sview = "struct PackageManifest:"
            LOCK_ENTRY: sview = "struct PackageLockEntry:"
            LOCK: sview = "struct PackageLock:"
            ERROR: sview = "error PackageContractError:"
            VERSION_VALID: sview = "def package_version_is_valid("
            VERSION_PRECEDES: sview = "def package_version_precedes("
            VALIDATE_MANIFEST: sview = "def validate_package_manifest("
            VALIDATE_LOCK: sview = "def validate_package_lock("
            VALIDATE_RESOLUTION: sview = "def validate_package_resolution("
            ADVANCE_RESOLUTION: sview = "def advance_package_resolution("
            OFFLINE_ONLY: sview = "offline_only"
            INTEGRITY_MISSING: sview = "IntegrityMissing"
            LOCK_ORDER_INVALID: sview = "LockOrderInvalid"
            MISSING_LOCKED_DEPENDENCY: sview = "MissingLockedDependency"
            CONSTRAINT_UNSATISFIED: sview = "ConstraintUnsatisfied"
            OFFLINE_POLICY_MISMATCH: sview = "OfflinePolicyMismatch"
            SAME_VERSION_BOUNDS: sview = "package_version_equal(constraint.max_version, constraint.min_version)"
            PRE_RELEASE_ORDER: sview = "package_pre_release_before"
            RESOLUTION_NOT_READY: sview = "ResolutionNotReady"
            CONSTRAINT_SATISFIED: sview = "package_constraint_satisfied"
            MODEL_IMPORT: sview = "include \"../runtime/package_model.elisa\""
            FIXTURE_CONTRACT: sview = "typed_package_manifest_and_lock_contract_is_reproducible_and_offline_safe"
            FIXTURE_LOCK: sview = "PackageResolutionEvent.Lock"
            FIXTURE_VERIFY: sview = "PackageResolutionEvent.Verify"
            FIXTURE_MISSING_DEPENDENCY: sview = "PackageContractError.MissingLockedDependency"
            FIXTURE_LOCK_ORDER: sview = "PackageContractError.LockOrderInvalid"
            FIXTURE_DUPLICATE: sview = "PackageContractError.DuplicateDependency"
            DOCS_CONTRACT: sview = "`EsPackage` supplies that package-facing contract"


        const module Messages:
            MISSING_ROOT: sview = "package model audit: missing repository root"
            UNRESOLVED_ROOT: sview = "package model audit: unable to resolve repository root"
            MISSING_INPUT: sview = "package model audit: missing "
            READ_FAILED: sview = "package model audit: unable to read source: "
            SUCCESS: sview = "package model audit: typed manifests, ordered lockfiles, integrity identities, offline policy, and resolution checks are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::FORMAT_VERSION},
                SearchCheck{input: inputs[0], pattern: Patterns::LOCK_ENTRY_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::DEPENDENCY_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::SOURCE_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::RESOLUTION_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::MANIFEST},
                SearchCheck{input: inputs[0], pattern: Patterns::LOCK_ENTRY},
                SearchCheck{input: inputs[0], pattern: Patterns::LOCK},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VERSION_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::VERSION_PRECEDES},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_MANIFEST},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_LOCK},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_RESOLUTION},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE_RESOLUTION},
                SearchCheck{input: inputs[0], pattern: Patterns::OFFLINE_ONLY},
                SearchCheck{input: inputs[0], pattern: Patterns::INTEGRITY_MISSING},
                SearchCheck{input: inputs[0], pattern: Patterns::LOCK_ORDER_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::MISSING_LOCKED_DEPENDENCY},
                SearchCheck{input: inputs[0], pattern: Patterns::CONSTRAINT_UNSATISFIED},
                SearchCheck{input: inputs[0], pattern: Patterns::OFFLINE_POLICY_MISMATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::SAME_VERSION_BOUNDS},
                SearchCheck{input: inputs[0], pattern: Patterns::PRE_RELEASE_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::RESOLUTION_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::CONSTRAINT_SATISFIED},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_LOCK},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_VERIFY},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_MISSING_DEPENDENCY},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_LOCK_ORDER},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_DUPLICATE},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_CONTRACT}
            ]


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            for check in searches(inputs):
                status: i64 = has_line(check.input, check.pattern)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsPackageModelAudit::run_default()
