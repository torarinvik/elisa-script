# Bounded Elisascript port of check_network_pagination.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsNetworkPaginationAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/network_pagination_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "module EsNetworkPagination:"
            LIMITS: sview = "const module Limits:"
            LINK_VALUES: sview = "LINK_VALUES"
            PARAMETERS: sview = "PARAMETERS"
            PAGES: sview = "PAGES"
            URL_ARENA_BYTES: sview = "URL_ARENA_BYTES"
            RESULT: sview = "struct NetworkPaginationResult:"
            DISPATCH: sview = "struct NetworkPaginationDispatch:"
            SESSION: sview = "struct NetworkPaginationSession:"
            ERROR: sview = "error NetworkPaginationError:"
            SCAN_STATE: sview = "const enum LinkFieldScanState of u8:"
            NEXT_PAGE: sview = "def network_pagination_next_page("
            START_SESSION: sview = "def start_network_pagination("
            DISPATCH_PAGE: sview = "def dispatch_network_pagination_page("
            COMPLETE_PAGE: sview = "def complete_network_pagination_page("
            ADVANCE_SESSION: sview = "def advance_network_pagination_session("
            LINK_VALUE_LIMIT: sview = "LinkValueLimitExceeded"
            PARAMETER_LIMIT: sview = "ParameterLimitExceeded"
            DUPLICATE_RELATION: sview = "DuplicateRelationParameter"
            MULTIPLE_NEXT: sview = "MultipleNextLinks"
            HTTPS_DOWNGRADE: sview = "HttpsDowngrade"
            PAGE_LIMIT: sview = "PageLimitExceeded"
            CYCLE: sview = "CycleDetected"
            STALE_TOKEN: sview = "StalePageToken"
            CANCEL_ACK: sview = "CancelAck"
            QUOTED_ESCAPE: sview = "LinkFieldScanState.QuotedEscape"
            SAME_ORIGIN: sview = "network_url_same_origin"
            EFFECTIVE_HEADERS: sview = "network_request_effective_headers"
            CREDENTIALS_STRIPPING: sview = "credentials_stripping_active"
            MODEL_IMPORT: sview = "include \"../runtime/network_pagination_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsNetworkPagination"
            FIXTURE_NEXT_REQUEST: sview = "typed_network_link_pagination_projects_next_page_request"
            FIXTURE_SESSION: sview = "typed_network_pagination_session_caps_pages_and_detects_cycles"
            FIXTURE_CANCELLATION: sview = "typed_network_pagination_session_cancellation_is_acknowledged"
            FIXTURE_STALE_RECEIPT: sview = "stale_receipt_rejected"
            FIXTURE_COMPLETE_REDIRECT: sview = "complete_network_pagination_page(redirected, redirect_response"
            FIXTURE_REDIRECT_STRIPPING: sview = "redirected_result.credentials_stripping_active"
            FIXTURE_STALE_ACK: sview = "stale_ack_rejected"
            FIXTURE_PARTS: sview = "part, one"
            FIXTURE_CROSS_PAGE_STRIPPING: sview = "cross_page.credentials_stripping_active"
            FIXTURE_LATER_PAGE_STRIPPING: sview = "later_page.credentials_stripping_active"
            FIXTURE_MULTIPLE_NEXT: sview = "NetworkPaginationError.MultipleNextLinks"
            FIXTURE_DOWNGRADE: sview = "NetworkPaginationError.HttpsDowngrade"
            DOCS_OVERVIEW: sview = "EsNetworkPagination` converts validated 2xx GET responses"
            LEDGER_ITEM: sview = "ES-SCRIPT-056 | EsNetworkPagination"


        const module Messages:
            MISSING_ROOT: sview = "network pagination audit: missing repository root"
            UNRESOLVED_ROOT: sview = "network pagination audit: unable to resolve repository root"
            MISSING_INPUT: sview = "network pagination audit: missing "
            READ_FAILED: sview = "network pagination audit: unable to read source: "
            SUCCESS: sview = "network pagination audit: bounded Link parsing, page/cycle/session limits, origin redaction, and downgrade refusal are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMITS},
                SearchCheck{input: inputs[0], pattern: Patterns::LINK_VALUES},
                SearchCheck{input: inputs[0], pattern: Patterns::PARAMETERS},
                SearchCheck{input: inputs[0], pattern: Patterns::PAGES},
                SearchCheck{input: inputs[0], pattern: Patterns::URL_ARENA_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::RESULT},
                SearchCheck{input: inputs[0], pattern: Patterns::DISPATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::SCAN_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::NEXT_PAGE},
                SearchCheck{input: inputs[0], pattern: Patterns::START_SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::DISPATCH_PAGE},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETE_PAGE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE_SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::LINK_VALUE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::PARAMETER_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_RELATION},
                SearchCheck{input: inputs[0], pattern: Patterns::MULTIPLE_NEXT},
                SearchCheck{input: inputs[0], pattern: Patterns::HTTPS_DOWNGRADE},
                SearchCheck{input: inputs[0], pattern: Patterns::PAGE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::CYCLE},
                SearchCheck{input: inputs[0], pattern: Patterns::STALE_TOKEN},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_ACK},
                SearchCheck{input: inputs[0], pattern: Patterns::QUOTED_ESCAPE},
                SearchCheck{input: inputs[0], pattern: Patterns::SAME_ORIGIN},
                SearchCheck{input: inputs[0], pattern: Patterns::EFFECTIVE_HEADERS},
                SearchCheck{input: inputs[0], pattern: Patterns::CREDENTIALS_STRIPPING},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_NEXT_REQUEST},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_SESSION},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CANCELLATION},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STALE_RECEIPT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_COMPLETE_REDIRECT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_REDIRECT_STRIPPING},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STALE_ACK},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_PARTS},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CROSS_PAGE_STRIPPING},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_LATER_PAGE_STRIPPING},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_MULTIPLE_NEXT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_DOWNGRADE},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_OVERVIEW},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsNetworkPaginationAudit::run_default()
