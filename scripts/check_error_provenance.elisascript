# Bounded Elisascript port of check_error_provenance.sh.
# Regex source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsErrorProvenanceAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/error_provenance_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsErrorProvenance:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/error_provenance_model\.elisa\""
            ORIGIN: Regex = regex"const enum ErrorOrigin of u8"
            PHASE: Regex = regex"const enum ErrorPhase of u8"
            ENVELOPE_STATE: Regex = regex"const enum ErrorEnvelopeState of u8"
            PROVENANCE: Regex = regex"struct ErrorProvenance:"
            ENVELOPE: Regex = regex"struct ErrorEnvelope:"
            LEDGER: Regex = regex"struct ErrorProvenanceLedger:"
            ERROR: Regex = regex"error ErrorProvenanceError:"
            VALIDATE: Regex = regex"def validate_error_provenance\("
            CAPTURE: Regex = regex"def error_provenance_capture\("
            ADVANCE: Regex = regex"def advance_error_provenance\("
            ENVELOPE_LIMIT: Regex = regex"Limits::ENVELOPES"
            TEXT_LIMIT: Regex = regex"Limits::TEXT_BYTES"
            CAUSE_DEPTH: Regex = regex"Limits::CAUSE_DEPTH"
            INVALID_COMPILER_OUTPUT: Regex = regex"ErrorOrigin.InvalidCompilerOutput"
            LIMIT_EXCEEDED: Regex = regex"ErrorOrigin.LimitExceeded"
            FORWARD: Regex = regex"ErrorProvenanceEvent.Forward"
            INVALID_CAUSE: Regex = regex"ErrorProvenanceError.InvalidCause"
            EMBEDDED_NUL: Regex = regex"ErrorProvenanceError.EmbeddedNul"
            CAPTURED_FORWARDS: Regex = regex"ErrorEnvelopeState.Captured and envelope.forward_count != 0"
            FORWARDED_COUNT: Regex = regex"ErrorEnvelopeState.Forwarded and envelope.forward_count == 0"
            CAUSE_DEPTH_ERROR: Regex = regex"ErrorProvenanceError.CauseDepthExceeded"
            CANCEL_NOT_READY: Regex = regex"ErrorProvenanceError.CancelNotReady"
            FIXTURE_IMPORT: Regex = regex"using EsErrorProvenance"
            FIXTURE_CONTRACT: Regex = regex"typed_error_provenance_contract_preserves_origin_and_cause"
            FIXTURE_HOST: Regex = regex"ErrorOrigin.Host"
            FIXTURE_SCRIPT: Regex = regex"ErrorOrigin.Script"
            FIXTURE_HANDLE: Regex = regex"ErrorProvenanceEvent.Handle"
            FIXTURE_INVALID_CAUSE: Regex = regex"ErrorProvenanceError.InvalidCause"
            FIXTURE_NUL: Regex = regex"nul_message_rejected"
            FIXTURE_FORGED_HISTORY: Regex = regex"forged_forward_history"
            DOCS_LEDGER: Regex = regex"EsErrorProvenance::ErrorProvenanceLedger"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-043"


        const module Messages:
            MISSING_ROOT: sview = "error provenance audit: missing repository root"
            UNRESOLVED_ROOT: sview = "error provenance audit: unable to resolve repository root"
            MISSING_INPUT: sview = "error provenance audit: missing "
            READ_FAILED: sview = "error provenance audit: unable to read source: "
            SUCCESS: sview = "error provenance audit: bounded origin, phase, cause, and terminal transitions are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::ORIGIN},
                SearchCheck{input: inputs[0], pattern: Patterns::PHASE},
                SearchCheck{input: inputs[0], pattern: Patterns::ENVELOPE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::PROVENANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::ENVELOPE},
                SearchCheck{input: inputs[0], pattern: Patterns::LEDGER},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::CAPTURE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::ENVELOPE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::CAUSE_DEPTH},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_COMPILER_OUTPUT},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::FORWARD},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_CAUSE},
                SearchCheck{input: inputs[0], pattern: Patterns::EMBEDDED_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::CAPTURED_FORWARDS},
                SearchCheck{input: inputs[0], pattern: Patterns::FORWARDED_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::CAUSE_DEPTH_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_NOT_READY},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_HOST},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_SCRIPT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_HANDLE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_CAUSE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_NUL},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_FORGED_HISTORY},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_LEDGER},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def has_match(path: Path, pattern: Regex) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_regex_line(path, pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            for check in searches(inputs):
                status: i64 = has_match(check.input, check.pattern)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsErrorProvenanceAudit::run_default()
