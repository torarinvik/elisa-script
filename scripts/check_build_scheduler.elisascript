# Bounded Elisascript port of check_build_scheduler.sh.
# Function-scope complexity assertions use the shared bounded extractor.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsBuildSchedulerAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/build_scheduler_model.elisa"
            BUILD_MODEL: sview = "src/runtime/build_model.elisa"
            INCREMENTAL_GRAPH_MODEL: sview = "src/runtime/build_incremental_graph_model.elisa"
            BATCH_MODEL: sview = "src/runtime/build_batch_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            INCREMENTAL_FIXTURE: sview = "test/runtime/build_incremental_scheduler_test.elisa"
            BATCH_FIXTURE: sview = "test/runtime/build_batch_model_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "module EsBuildScheduler:"
            LIMITS: sview = "const module Limits:"
            CACHE_ENTRIES: sview = "Limits::CACHE_ENTRIES"
            BUILD_NODES: sview = "EsBuild::Limits::NODES"
            SCHEDULER_STATE: sview = "const enum BuildSchedulerState of u8:"
            FAILING_STATE: sview = "BuildSchedulerState.Failing"
            SCHEDULER_EVENT: sview = "const enum BuildSchedulerEvent of u8:"
            CACHE_ENTRY: sview = "struct BuildCacheEntry:"
            SCHEDULER: sview = "struct BuildScheduler:"
            ERROR: sview = "error BuildSchedulerError:"
            VALIDATE: sview = "def validate_build_scheduler("
            ADMIT_INCREMENTAL_GRAPH: sview = "def admit_build_incremental_graph("
            SORT_CACHE: sview = "def scheduler_sort_cache_entries("
            CACHE_ENTRY_MATCHES: sview = "def build_scheduler_cache_entry_matches("
            INCREMENTAL_PLAN_INVALID: sview = "IncrementalPlanInvalid"
            INCREMENTAL_PLAN_MISMATCH: sview = "IncrementalPlanMismatch"
            ADVANCE: sview = "def advance_build_scheduler("
            REBUILD_READY: sview = "def scheduler_rebuild_ready("
            ADMIT_INCREMENTAL_PLAN: sview = "def admit_build_incremental_plan("
            INCREMENTAL_USING: sview = "using EsBuildIncremental"
            INCREMENTAL_GRAPH_USING: sview = "using EsBuildIncrementalGraph"
            PLAN_DECISION_COUNT: sview = "plan.decisions.count != scheduler.graph.nodes.count"
            TARGET_NAME_MATCH: sview = "plan.target_names[index] != scheduler.graph.nodes[index].name"
            RECIPE_FINGERPRINT_MATCH: sview = "plan.recipe_fingerprints[index] != scheduler.graph.nodes[index].fingerprint"
            SORT_ADMITTED_CACHE: sview = "scheduler.cache <- try scheduler_sort_cache_entries(admitted_cache)"
            ADMITTED_CACHE_ENTRY: sview = "admitted_cache.push(BuildCacheEntry{node_name: scheduler.graph.nodes[index].name, fingerprint: plan.recipe_fingerprints[index]})"
            UP_TO_DATE_DECISION: sview = "plan.decisions[index] == BuildIncrementalDecision.UpToDate"
            PLAN_INCREMENTAL_TRANSITION: sview = "plan_build_incremental_graph_transition(previous_targets, scheduler.graph, current_recipes, observations)"
            BATCH_ADMIT_INCREMENTAL: sview = "admit_build_incremental_graph(session.scheduler, previous_targets, recipes, observations)"
            VALIDATE_BATCH_CACHE_MATCH: sview = "build_scheduler_cache_entry_matches(session.scheduler, index)"
            LINEAR_BATCH_CACHE_SCAN: sview = "for entry in session.scheduler.cache"
            BEGIN_BATCH_CACHE_MATCH: sview = "build_scheduler_cache_entry_matches(session.scheduler, node_index)"
            LINEAR_BEGIN_CACHE_SCAN: sview = "for entry in session.scheduler.cache"
            QUEUE_BINARY_SEARCH_LOOP: sview = "while low < high"
            QUEUE_BINARY_SEARCH_MIDDLE: sview = "middle: usize = low + (high - low) / 2"
            QUEUE_LINEAR_MEMBERSHIP: sview = "for queued in scheduler.ready_queue"
            CACHE_BINARY_SEARCH_LOOP: sview = "while low < high"
            CACHE_BINARY_SEARCH_MIDDLE: sview = "middle: usize = low + (high - low) / 2"
            CACHE_SORT_LOOP: sview = "while width < order.count"
            CACHE_SORT_WIDTH_GROWTH: sview = "width <- order.count if width > order.count / 2 else width * 2"
            DUPLICATE_CACHE_ORDER: sview = "raise BuildSchedulerError.DuplicateCacheEntry if name_order == SchedulerNameOrder.Equal"
            INVALID_CACHE_ORDER: sview = "raise BuildSchedulerError.CacheOrderInvalid if name_order == SchedulerNameOrder.After"
            NESTED_CACHE_DUPLICATE_SCAN: sview = "for earlier in 0..<index |scheduler, entry|"
            REBUILD_PLANNED_STATE: sview = "if node.state == BuildNodeState.Planned:"
            REBUILD_QUEUE_LOOKUP: sview = "scheduler_queue_contains"
            DUPLICATE_QUEUE_ORDER: sview = "raise BuildSchedulerError.DuplicateQueueEntry if previous == queued"
            INVALID_QUEUE_ORDER: sview = "raise BuildSchedulerError.QueueOrderInvalid if previous > queued"
            NESTED_QUEUE_DUPLICATE_SCAN: sview = "for earlier in 0..<index |scheduler, queued|"
            QUEUE_CONTAINS: sview = "scheduler_queue_contains"
            DEPENDENCY_READY: sview = "scheduler_dependency_ready"
            CACHE_MATCHES: sview = "scheduler_cache_matches"
            CACHE_MISS: sview = "CacheMiss"
            CACHE_ENTRY_INVALID: sview = "CacheEntryInvalid"
            CACHE_ORDER_INVALID: sview = "CacheOrderInvalid"
            DEPENDENCY_NOT_READY: sview = "DependencyNotReady"
            ACTIVE_LIMIT: sview = "ActiveLimitExceeded"
            GRAPH_FAILING: sview = "BuildGraphState.Failing"
            SCHEDULER_FAILING: sview = "BuildSchedulerState.Failing"
            FAILURE_IN_PROGRESS: sview = "failure_in_progress"
            ACK_FAILURE: sview = "ack_failure"
            NODE_ACCOUNTING_INVALID: sview = "NodeAccountingInvalid"
            COMPLETED_NODE_BOUND: sview = "scheduler.completed_nodes > scheduler.graph.nodes.count"
            CACHE_HIT_BOUND: sview = "scheduler.cache_hits > scheduler.completed_nodes"
            ACTIVE_NODES: sview = "scheduler.graph.active_nodes"
            COMPLETED_NODE_COUNT: sview = "scheduler.graph.completed_nodes != scheduler.graph.nodes.count"
            RUNNING_NODE_STATE: sview = "scheduler.graph.nodes[index].state == BuildNodeState.Running"
            DECREMENT_ACTIVE: sview = "scheduler.active_nodes <- scheduler.active_nodes - 1"
            READY_QUEUE_NONEMPTY: sview = "scheduler.ready_queue.count != 0"
            READY_STATE_QUEUE_NONEMPTY: sview = "scheduler.state == BuildSchedulerState.Ready and scheduler.ready_queue.count != 0"
            QUEUE_ORDER_INVALID: sview = "QueueOrderInvalid"
            QUEUE_ORDER_DESCENDING: sview = "scheduler.ready_queue[index - 1] > queued"
            COMPLETE_STATE: sview = "scheduler.state == BuildSchedulerState.Complete"
            FAILED_STATE: sview = "scheduler.state == BuildSchedulerState.Failed"
            COMPLETE_NOT_READY: sview = "CompleteNotReady"
            CANCEL_NOT_READY: sview = "CancelNotReady"
            READY_STATE: sview = "scheduler.state == BuildSchedulerState.Ready"
            SET_CANCELLED_STATE: sview = "scheduler.state <- BuildSchedulerState.Cancelled"
            GRAPH_SUCCEEDED: sview = "scheduler.graph.state == BuildGraphState.Succeeded"
            INCREMENTAL_PLAN_REACHES_SCHEDULER: sview = "graph_aligned_incremental_plan_reaches_scheduler"
            INCREMENTAL_ADMIT_CALL: sview = "admit_build_incremental_graph(scheduler, previous, recipes, observations)"
            SIGNATURE_MISMATCH_REJECTED: sview = "signature_mismatch_rejected"
            CURRENT_RECIPE_INVALID: sview = "BuildIncrementalError.CurrentRecipeShapeInvalid"
            IR_IMPORT: sview = "include \"../runtime/build_scheduler_model.elisa\""
            FIXTURE_USING: sview = "using EsBuildScheduler"
            BATCH_SKIP_CACHE: sview = "incremental_build_batch_skips_verified_cache_hits_before_dispatch"
            BATCH_ALL_CACHED: sview = "incremental_build_batch_completes_without_launches_when_all_targets_are_cached"
            BATCH_CACHE_COUNT_ONE: sview = "session.scheduler.cache.count == 1"
            BATCH_CACHE_COUNT_TWO: sview = "session.scheduler.cache.count == 2"
            SCHEDULER_CONTRACT: sview = "typed_build_scheduler_contract_is_deterministic_cache_aware_and_cancelable"
            TWO_CACHE_SCHEDULER: sview = "two_cache_scheduler"
            UNSORTED_CACHE: sview = "unsorted_cache_rejected"
            DUPLICATE_CACHE: sview = "duplicate_cache_rejected"
            CACHE_HIT_EVENT: sview = "BuildSchedulerEvent.CacheHit"
            DISPATCH_EVENT: sview = "BuildSchedulerEvent.Dispatch"
            NODE_COMPLETE_EVENT: sview = "BuildSchedulerEvent.NodeComplete"
            NODE_FAIL_EVENT: sview = "BuildSchedulerEvent.NodeFail"
            FIXTURE_FAILING_STATE: sview = "BuildSchedulerState.Failing"
            CANCEL_ACK_EVENT: sview = "BuildSchedulerEvent.CancelAck"
            ACTIVE_CANCEL: sview = "active_cancel"
            DISPATCH_AFTER_FAILURE: sview = "dispatch_after_failure"
            CACHE_AFTER_FAILURE: sview = "cache_after_failure"
            COMPLETED_DURING_DRAIN: sview = "completed_during_drain"
            FORGED_CANCELLING_FAILURE: sview = "forged_cancelling_failure"
            PLANNED_CANCEL_SCHEDULER: sview = "planned_cancel_scheduler"
            FAILED_DURING_DRAIN: sview = "failed_during_drain"
            FORGED_QUEUE_ORDER: sview = "forged_queue_order"
            FIXTURE_COMPLETE_STATE: sview = "BuildSchedulerState.Complete"
            COMPLETED_CANCEL_REJECTED: sview = "completed_cancel_rejected"
            GRAPH_ORDERED_CACHE: sview = "graph_ordered_plan_produces_name_ordered_cache"
            FIRST_CACHE_NAME: sview = "scheduler.cache[0].node_name == \"a-leaf\""
            SECOND_CACHE_NAME: sview = "scheduler.cache[1].node_name == \"z-root\""
            ORDERED_QUEUE_MEMBERSHIP: sview = "build_scheduler_uses_ordered_queue_membership_and_rejects_duplicates"
            DISPATCH_TWO: sview = "advance_build_scheduler(scheduler, BuildSchedulerEvent.Dispatch, 2)"
            DUPLICATE_QUEUE_FORGED: sview = "duplicate_scheduler.ready_queue <- [0, 0]"
            DUPLICATE_QUEUE_ERROR: sview = "BuildSchedulerError.DuplicateQueueEntry"
            DOCS_SCHEDULER: sview = "EsBuildScheduler adds the execution-facing queue contract"
            DOCS_CACHE_UNKNOWN: sview = "cache entries for unknown graph nodes"
            LEDGER_SCHEDULER: sview = "ES-SCRIPT-002 | EsBuildScheduler"


        const module Messages:
            MISSING_ROOT: sview = "build scheduler audit: missing repository root"
            UNRESOLVED_ROOT: sview = "build scheduler audit: unable to resolve repository root"
            MISSING_INPUT: sview = "build scheduler audit: missing "
            READ_FAILED: sview = "build scheduler audit: unable to read source: "
            PUBLIC_PLAN_ADMISSION: sview = "build scheduler audit: hand-constructed plans remain publicly admissible"
            REGRESSION: sview = "build scheduler audit: scheduler complexity invariant regressed"
            BATCH_VALIDATION_SCAN: sview = "build scheduler audit: batch cache receipt validation regressed to a linear scan"
            BATCH_BEGIN_SCAN: sview = "build scheduler audit: cache-hit application regressed to a nested scan"
            QUEUE_MEMBERSHIP_SCAN: sview = "build scheduler audit: ready-queue membership regressed to a linear scan"
            READINESS_REBUILD_SCAN: sview = "build scheduler audit: readiness rebuild scans its growing queue"
            QUEUE_VALIDATION_SCAN: sview = "build scheduler audit: duplicate cache/ready-queue validation regressed to nested scans"
            SUCCESS: sview = "build scheduler audit: deterministic queue, fail-draining, cache admission, bounded dispatch, and cancellation are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


        def require_function_body(path: Path, declaration: sview, required: darray[sview], forbidden: darray[sview], forbidden_message: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            body: EsSourceFunctionScope::FunctionBody = try EsSourceFunctionScope::read_function_body(path, declaration) else err:
                diagnostic(Messages::READ_FAILED + f"{path}")
                return ExitStatus::IO_FAILURE
            return ExitStatus::FAILURE if not body.found
            for pattern in required:
                return ExitStatus::FAILURE if body.text.index(pattern) < 0
            for pattern in forbidden:
                if body.text.index(pattern) >= 0:
                    diagnostic(forbidden_message)
                    return ExitStatus::FAILURE
            return 0i64


        def declarations(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMITS},
                SearchCheck{input: inputs[0], pattern: Patterns::CACHE_ENTRIES},
                SearchCheck{input: inputs[0], pattern: Patterns::BUILD_NODES},
                SearchCheck{input: inputs[0], pattern: Patterns::SCHEDULER_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILING_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::SCHEDULER_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::CACHE_ENTRY},
                SearchCheck{input: inputs[0], pattern: Patterns::SCHEDULER},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADMIT_INCREMENTAL_GRAPH},
                SearchCheck{input: inputs[0], pattern: Patterns::SORT_CACHE},
                SearchCheck{input: inputs[0], pattern: Patterns::CACHE_ENTRY_MATCHES},
                SearchCheck{input: inputs[0], pattern: Patterns::INCREMENTAL_PLAN_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::INCREMENTAL_PLAN_MISMATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::REBUILD_READY}
            ]


        def integrations(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::INCREMENTAL_USING},
                SearchCheck{input: inputs[0], pattern: Patterns::INCREMENTAL_GRAPH_USING},
                SearchCheck{input: inputs[0], pattern: Patterns::PLAN_DECISION_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::TARGET_NAME_MATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::RECIPE_FINGERPRINT_MATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::SORT_ADMITTED_CACHE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADMITTED_CACHE_ENTRY},
                SearchCheck{input: inputs[0], pattern: Patterns::UP_TO_DATE_DECISION}
            ]


        def boundaries(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::QUEUE_CONTAINS},
                SearchCheck{input: inputs[0], pattern: Patterns::DEPENDENCY_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::CACHE_MATCHES},
                SearchCheck{input: inputs[0], pattern: Patterns::REBUILD_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::CACHE_MISS},
                SearchCheck{input: inputs[0], pattern: Patterns::CACHE_ENTRY_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::CACHE_ORDER_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::DEPENDENCY_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::ACTIVE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::GRAPH_FAILING},
                SearchCheck{input: inputs[0], pattern: Patterns::SCHEDULER_FAILING},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILURE_IN_PROGRESS},
                SearchCheck{input: inputs[0], pattern: Patterns::ACK_FAILURE},
                SearchCheck{input: inputs[0], pattern: Patterns::NODE_ACCOUNTING_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETED_NODE_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::CACHE_HIT_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::ACTIVE_NODES},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETED_NODE_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::RUNNING_NODE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::DECREMENT_ACTIVE},
                SearchCheck{input: inputs[0], pattern: Patterns::READY_QUEUE_NONEMPTY},
                SearchCheck{input: inputs[0], pattern: Patterns::READY_STATE_QUEUE_NONEMPTY},
                SearchCheck{input: inputs[0], pattern: Patterns::QUEUE_ORDER_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::QUEUE_ORDER_DESCENDING},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETE_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::READY_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::SET_CANCELLED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::GRAPH_SUCCEEDED}
            ]


        def scheduler_fixtures(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[6], pattern: Patterns::INCREMENTAL_PLAN_REACHES_SCHEDULER},
                SearchCheck{input: inputs[6], pattern: Patterns::INCREMENTAL_ADMIT_CALL},
                SearchCheck{input: inputs[6], pattern: Patterns::SIGNATURE_MISMATCH_REJECTED},
                SearchCheck{input: inputs[6], pattern: Patterns::CURRENT_RECIPE_INVALID},
                SearchCheck{input: inputs[2], pattern: Patterns::IR_IMPORT},
                SearchCheck{input: inputs[5], pattern: Patterns::FIXTURE_USING},
                SearchCheck{input: inputs[7], pattern: Patterns::BATCH_SKIP_CACHE},
                SearchCheck{input: inputs[7], pattern: Patterns::BATCH_ALL_CACHED},
                SearchCheck{input: inputs[7], pattern: Patterns::BATCH_CACHE_COUNT_ONE},
                SearchCheck{input: inputs[7], pattern: Patterns::BATCH_CACHE_COUNT_TWO},
                SearchCheck{input: inputs[5], pattern: Patterns::SCHEDULER_CONTRACT},
                SearchCheck{input: inputs[5], pattern: Patterns::TWO_CACHE_SCHEDULER},
                SearchCheck{input: inputs[5], pattern: Patterns::UNSORTED_CACHE},
                SearchCheck{input: inputs[5], pattern: Patterns::DUPLICATE_CACHE},
                SearchCheck{input: inputs[5], pattern: Patterns::CACHE_HIT_EVENT},
                SearchCheck{input: inputs[5], pattern: Patterns::DISPATCH_EVENT},
                SearchCheck{input: inputs[5], pattern: Patterns::NODE_COMPLETE_EVENT},
                SearchCheck{input: inputs[5], pattern: Patterns::NODE_FAIL_EVENT},
                SearchCheck{input: inputs[5], pattern: Patterns::FIXTURE_FAILING_STATE},
                SearchCheck{input: inputs[5], pattern: Patterns::CANCEL_ACK_EVENT},
                SearchCheck{input: inputs[5], pattern: Patterns::ACTIVE_CANCEL},
                SearchCheck{input: inputs[5], pattern: Patterns::DISPATCH_AFTER_FAILURE},
                SearchCheck{input: inputs[5], pattern: Patterns::CACHE_AFTER_FAILURE},
                SearchCheck{input: inputs[5], pattern: Patterns::COMPLETED_DURING_DRAIN},
                SearchCheck{input: inputs[5], pattern: Patterns::FORGED_CANCELLING_FAILURE},
                SearchCheck{input: inputs[5], pattern: Patterns::PLANNED_CANCEL_SCHEDULER},
                SearchCheck{input: inputs[5], pattern: Patterns::FAILED_DURING_DRAIN},
                SearchCheck{input: inputs[5], pattern: Patterns::FORGED_QUEUE_ORDER},
                SearchCheck{input: inputs[5], pattern: Patterns::FIXTURE_COMPLETE_STATE},
                SearchCheck{input: inputs[5], pattern: Patterns::COMPLETED_CANCEL_REJECTED},
                SearchCheck{input: inputs[6], pattern: Patterns::GRAPH_ORDERED_CACHE},
                SearchCheck{input: inputs[6], pattern: Patterns::FIRST_CACHE_NAME},
                SearchCheck{input: inputs[6], pattern: Patterns::SECOND_CACHE_NAME},
                SearchCheck{input: inputs[6], pattern: Patterns::ORDERED_QUEUE_MEMBERSHIP},
                SearchCheck{input: inputs[6], pattern: Patterns::DISPATCH_TWO},
                SearchCheck{input: inputs[6], pattern: Patterns::DUPLICATE_QUEUE_FORGED},
                SearchCheck{input: inputs[6], pattern: Patterns::DUPLICATE_QUEUE_ERROR},
                SearchCheck{input: inputs[8], pattern: Patterns::DOCS_SCHEDULER},
                SearchCheck{input: inputs[8], pattern: Patterns::DOCS_CACHE_UNKNOWN},
                SearchCheck{input: inputs[9], pattern: Patterns::LEDGER_SCHEDULER}
            ]


        def body_checks(inputs: darray[Path]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = require_function_body(
                inputs[3],
                "def validate_build_batch_session(",
                [Patterns::VALIDATE_BATCH_CACHE_MATCH],
                [Patterns::LINEAR_BATCH_CACHE_SCAN],
                Messages::BATCH_VALIDATION_SCAN
            )
            return status if status != 0i64

            status <- require_function_body(
                inputs[3],
                "def begin_build_batch(",
                [Patterns::BEGIN_BATCH_CACHE_MATCH],
                [Patterns::LINEAR_BEGIN_CACHE_SCAN],
                Messages::BATCH_BEGIN_SCAN
            )
            return status if status != 0i64

            status <- require_function_body(
                inputs[0],
                "def scheduler_queue_contains(",
                [Patterns::QUEUE_BINARY_SEARCH_LOOP, Patterns::QUEUE_BINARY_SEARCH_MIDDLE],
                [Patterns::QUEUE_LINEAR_MEMBERSHIP],
                Messages::QUEUE_MEMBERSHIP_SCAN
            )
            return status if status != 0i64

            status <- require_function_body(
                inputs[0],
                "def scheduler_cache_matches(",
                [Patterns::CACHE_BINARY_SEARCH_LOOP, Patterns::CACHE_BINARY_SEARCH_MIDDLE],
                [],
                ""
            )
            return status if status != 0i64

            status <- require_function_body(
                inputs[0],
                "def scheduler_sort_cache_entries(",
                [Patterns::CACHE_SORT_LOOP, Patterns::CACHE_SORT_WIDTH_GROWTH],
                [],
                ""
            )
            return status if status != 0i64

            status <- require_function_body(
                inputs[0],
                "def scheduler_refresh_ready(",
                [Patterns::REBUILD_PLANNED_STATE],
                [Patterns::REBUILD_QUEUE_LOOKUP],
                Messages::READINESS_REBUILD_SCAN
            )
            return status if status != 0i64

            status <- require_function_body(
                inputs[0],
                "def validate_build_scheduler(",
                [
                    Patterns::DUPLICATE_CACHE_ORDER,
                    Patterns::INVALID_CACHE_ORDER,
                    Patterns::DUPLICATE_QUEUE_ORDER,
                    Patterns::INVALID_QUEUE_ORDER
                ],
                [Patterns::NESTED_CACHE_DUPLICATE_SCAN, Patterns::NESTED_QUEUE_DUPLICATE_SCAN],
                Messages::QUEUE_VALIDATION_SCAN
            )
            return status if status != 0i64
            return 0i64


        def execute_all(inputs: darray[Path]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = execute(declarations(inputs))
            return status if status != 0i64

            plan_admission: bool = try EsSourceFunctionScope::contains_file_line(inputs[0], Patterns::ADMIT_INCREMENTAL_PLAN) else err:
                diagnostic(Messages::READ_FAILED + f"{inputs[0]}")
                return ExitStatus::IO_FAILURE
            if plan_admission:
                diagnostic(Messages::PUBLIC_PLAN_ADMISSION)
                return ExitStatus::FAILURE

            status <- execute(integrations(inputs))
            return status if status != 0i64

            status <- execute([
                SearchCheck{input: inputs[0], pattern: Patterns::PLAN_INCREMENTAL_TRANSITION},
                SearchCheck{input: inputs[3], pattern: Patterns::BATCH_ADMIT_INCREMENTAL}
            ])
            return status if status != 0i64

            status <- body_checks(inputs)
            return status if status != 0i64

            status <- execute(boundaries(inputs))
            return status if status != 0i64

            status <- execute(scheduler_fixtures(inputs))
            return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::BUILD_MODEL),
                root.joinpath(Inputs::INCREMENTAL_GRAPH_MODEL),
                root.joinpath(Inputs::BATCH_MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::INCREMENTAL_FIXTURE),
                root.joinpath(Inputs::BATCH_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            required_inputs: darray[Path] = [
                inputs[0], inputs[1], inputs[2], inputs[3], inputs[4],
                inputs[5], inputs[6], inputs[7], inputs[8], inputs[9]
            ]
            for input_path in required_inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute_all(inputs)
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsBuildSchedulerAudit::run_default()
