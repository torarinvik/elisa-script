# Bounded Elisascript port of check_build_batch.sh.
# Fixed source contracts use the shared scanner; host-launch APIs remain forbidden.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsBuildBatchAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/build_batch_model.elisa"
            EXECUTOR: sview = "src/runtime/build_executor_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/runtime/build_batch_model_test.elisa"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "module EsBuildBatch:"
            IR_IMPORT: sview = "include \"../runtime/build_batch_model.elisa\""
            LAUNCH: sview = "struct BuildBatchLaunch:"
            NODE_RESULT: sview = "struct BuildBatchNodeResult:"
            NODE_PLAN: sview = "struct BuildBatchNodePlan:"
            SESSION: sview = "struct BuildBatchSession:"
            ERROR: sview = "error BuildBatchError:"
            SESSION_FOR_GRAPH: sview = "def build_batch_session_for_graph("
            SESSION_FOR_GRAPH_OUTPUTS: sview = "def build_batch_session_for_graph_with_outputs("
            PLAN_VECTOR_ENTRIES_FIT: sview = "def build_batch_plan_vector_entries_fit("
            OUTPUT_SETS_FROM_RECIPES: sview = "def build_batch_output_sets_from_recipes("
            SESSION_FOR_RECIPES: sview = "def build_batch_session_for_recipes("
            INCREMENTAL_SESSION_FOR_RECIPES: sview = "def build_incremental_batch_session_for_recipes("
            VALIDATE_SESSION: sview = "def validate_build_batch_session("
            BEGIN: sview = "def begin_build_batch("
            EXECUTION_RESULT: sview = "def build_batch_execution_result("
            DISPATCH_READY: sview = "def dispatch_build_batch_ready("
            DISPATCH_READY_PREFLIGHT: sview = "def dispatch_build_batch_ready_with_output_preflight("
            REPORT_RESULT: sview = "def report_build_batch_result("
            REPORT_RESULT_OUTPUTS: sview = "def report_build_batch_result_with_outputs("
            PROCESS_RESULT_VALID: sview = "def build_batch_process_result_valid("
            CANCEL: sview = "def cancel_build_batch("
            STOP_ACK_MATCH: sview = "def build_batch_stop_acknowledgements_match("
            ACK_STOP: sview = "def acknowledge_build_batch_stop("
            SCHEDULER_DISPATCH: sview = "BuildSchedulerEvent.Dispatch"
            ADMIT_PROCESS_JOB: sview = "admit_process_batch_job(session.processes, node_index)"
            VALIDATE_PROCESS_DISPATCH: sview = "validate_process_batch_dispatch(session.processes, dispatch)"
            PROCESS_FAIL: sview = "ProcessBatchEvent.Fail"
            PROCESS_REAP_ACK: sview = "ProcessBatchEvent.ReapAck"
            SCHEDULER_NODE_FAIL: sview = "BuildSchedulerEvent.NodeFail"
            RESERVED_OUTPUT_BYTES: sview = "session.reserved_output_bytes"
            LOG_BYTES_LIMIT: sview = "EsBuild::Limits::LOG_BYTES"
            SCHEDULER_FAILING: sview = "BuildSchedulerState.Failing"
            EXPECTED_READY_COUNT: sview = "expected_ready != session.scheduler.ready_queue.count"
            PROCESS_DRAINING: sview = "ProcessBatchState.Draining"
            PROCESS_CANCEL_ACK: sview = "ProcessBatchEvent.CancelAck"
            SCHEDULER_CANCEL_ACK: sview = "BuildSchedulerEvent.CancelAck"
            COMMAND_SNAPSHOT_BOUND: sview = "command_snapshot_bound != result.dispatched"
            OUTPUTS_SNAPSHOT_BOUND: sview = "outputs_snapshot_bound != result.dispatched"
            COMMANDS_EQUAL: sview = "build_batch_process_commands_equal(result.dispatched_command_snapshot, node.command)"
            OUTPUTS_EQUAL: sview = "build_batch_execution_outputs_equal(result.dispatched_outputs_snapshot, expected_outputs)"
            PLAN_NODE_COUNT: sview = "session.plan_nodes.count != graph.nodes.count"
            PLAN_VECTOR_FIT_CALL: sview = "build_batch_plan_vector_entries_fit(graph, output_sets)"
            PLAN_VECTOR_ENTRIES_LIMIT: sview = "PLAN_VECTOR_ENTRIES: usize = 65536"
            DEPENDENCY_VECTORS_EQUAL: sview = "build_batch_index_vectors_equal(node.dependencies, plan.dependencies)"
            NODE_NAME_ORDERS_EQUAL: sview = "build_batch_node_name_orders_equal(session.plan_name_order, graph.node_name_order)"
            RECIPE_SIGNATURES_EQUAL: sview = "build_batch_recipe_signatures_equal(node.recipe_signature, plan.recipe_signature)"
            OUTPUT_SET_EQUAL: sview = "session.output_sets[index], session.declared_output_sets[index]"
            COMMAND_SNAPSHOT: sview = "dispatched_command_snapshot <- node.command"
            PROCESS_SUCCEEDED_WITH_ERROR: sview = "build_batch_process_succeeded(process_result) and process_result.error_text != \"\""
            PROCESS_JOB_SKIPPED: sview = "ProcessBatchJobState.Skipped"
            SKIP_AT: sview = "ProcessBatchEvent.SkipAt"
            ADMIT_INCREMENTAL_GRAPH: sview = "admit_build_incremental_graph(session.scheduler, previous_targets, recipes, observations)"
            CACHE_HIT_STATE_MATCH: sview = "result.cache_hit != (job.state == ProcessBatchJobState.Skipped)"
            CACHE_HITS_MATCH: sview = "cache_hit_results != session.scheduler.cache_hits"
            CACHE_COUNT_MATCH: sview = "session.scheduler.cache.count != session.scheduler.cache_hits"
            CACHE_HIT_EVENT: sview = "BuildSchedulerEvent.CacheHit"
            OUTPUT_SETS_VALID: sview = "build_executor_output_sets_valid(graph, output_sets)"
            OUTPUT_PREFLIGHT_DISPATCH: sview = "dispatch_build_batch_ready_with_output_preflight"
            PREFLIGHT_REQUIRED: sview = "BuildBatchError.OutputPreflightRequired"
            OUTPUT_ALREADY_PRESENT: sview = "BuildBatchError.OutputAlreadyPresent(output_path)"
            READY_PREFLIGHT: sview = "build_batch_ready_output_preflight(session)"
            OUTPUT_EXISTS_OR_SYMLINK: sview = "path_exists(output) or is_symlink(output)"
            OUTPUT_FILE_OR_SYMLINK: sview = "not is_file(output) or is_symlink(output)"
            FIRST_MISSING_OUTPUT: sview = "build_batch_first_missing_output(session.output_sets[dispatch.job_index])"
            OUTPUT_MISSING: sview = "BuildBatchError.OutputMissing"
            OUTPUT_SET_COUNT: sview = "session.output_sets.count != 0"
            EXISTING_OUTPUT_TEST: sview = "build_batch_rejects_existing_output_before_dispatch_without_mutation"
            OUTPUT_PATHS_LIMIT: sview = "Limits::OUTPUT_PATHS"
            OUTPUT_PATH_BYTES_LIMIT: sview = "Limits::OUTPUT_PATH_BYTES"
            OUTPUT_PATH_TEXT_BYTES_LIMIT: sview = "Limits::OUTPUT_PATH_TEXT_BYTES"
            OUTPUT_INDEX_SLOTS_LIMIT: sview = "Limits::OUTPUT_INDEX_SLOTS"
            OUTPUT_PATH_HASH: sview = "def build_executor_output_path_hash("
            SLOT_RESERVE: sview = "slots.reserve(slot_count)"
            STOP_ACK_MISMATCH: sview = "BuildBatchError.StopAcknowledgementMismatch"
            FORBIDDEN_HOST_LAUNCH: sview = "Process\\.Run|elisascript_posix_fork|capture_process_result"
            DISPATCH_READY_TEST: sview = "build_batch_dispatches_ready_nodes_and_refills_capacity"
            PLAN_VECTOR_OVER_LIMIT_TEST: sview = "build_batch_rejects_aggregate_plan_vector_over_limit_before_snapshotting"
            PLAN_LIMIT_ERROR: sview = "BuildBatchError.PlanLimitExceeded"
            EXECUTION_STARTED: sview = "execution.nodes[0].started and not execution.nodes[0].cache_hit"
            LINKED_STDERR: sview = "execution.nodes[2].stderr == \"linked\""
            FAILURE_CANCELS_UNSTARTED: sview = "build_batch_failure_cancels_unstarted_nodes_and_drains_siblings"
            EXECUTION_NOT_COMPLETE: sview = "execution_not_complete_rejected <- failure == BuildBatchError.ExecutionNotComplete"
            TIMEOUT_DRAINS_SIBLINGS: sview = "build_batch_timeout_preserves_partial_diagnostics_and_drains_siblings"
            MULTIPLE_FAILURES_DRAIN: sview = "build_batch_accounts_for_multiple_failures_during_drain"
            TIMED_OUT_RESULT: sview = "ProcessResultKind.TimedOut"
            HOST_IO_FAILURE_RESULT: sview = "ProcessResultKind.HostIoFailure"
            TWO_FAILED_PROCESSES: sview = "session.processes.failed == 2 and session.processes.state == ProcessBatchState.Failed"
            PARTIAL_LOG_LENGTH: sview = "session.scheduler.graph.log_bytes == len(\"partial\")"
            CANCEL_BEFORE_BEGIN: sview = "build_batch_cancels_before_begin_without_host_reap"
            WAIT_FOR_REAP_ACK: sview = "build_batch_cancellation_waits_for_host_reap_acknowledgement"
            OMITTED_READY_QUEUE: sview = "build_batch_rejects_omitted_ready_queue_entries"
            DUPLICATE_TERMINAL_RECEIPTS: sview = "build_batch_rejects_duplicate_terminal_receipts"
            MALFORMED_RESULT_RESERVATION: sview = "build_batch_rejects_malformed_process_result_without_consuming_reservation"
            OUTPUT_OVERRUN_RESERVATION: sview = "build_batch_rejects_output_overrun_without_consuming_reservation"
            COMMAND_MUTATION: sview = "build_batch_rejects_command_mutation_after_dispatch"
            DEPENDENCY_MUTATION: sview = "build_batch_rejects_dependency_plan_mutation_before_dispatch"
            EMPTY_MUTATED_DEPENDENCIES: sview = "mutated_node.dependencies <- []"
            SIGNATURE_MUTATION: sview = "build_batch_rejects_recipe_signature_mutation_before_dispatch"
            MUTATED_SIGNATURE: sview = "mutated_signature.word2 <- 99"
            DECLARED_OUTPUT_MUTATION_BEFORE: sview = "build_batch_rejects_declared_output_mutation_before_dispatch"
            FORGED_OUTPUT_SET: sview = "session.output_sets[0].paths <- [\"/tmp/elisascript-forged.o\"]"
            JOB_MAPPING_INVALID: sview = "mutation_rejected <- failure == BuildBatchError.JobMappingInvalid"
            DECLARED_OUTPUT_MUTATION_AFTER: sview = "build_batch_rejects_declared_output_mutation_after_dispatch"
            SUCCESS_WITH_HOST_ERROR: sview = "build_batch_rejects_success_receipt_with_host_error_text_atomically"
            RESULT_INVALID: sview = "rejected <- failure == BuildBatchError.ResultInvalid"
            RESERVED_OUTPUT_BUDGETS: sview = "parallel_build_launches_receive_only_their_reserved_output_budget"
            ZERO_CAPTURE_LIMIT: sview = "launches[1].command.capture_output_limit_bytes == 0"
            ZERO_RESERVED_BYTES: sview = "session.results[1].reserved_output_bytes == 0"
            MISSING_OUTPUT_BEFORE_DEPENDENT: sview = "build_batch_missing_output_fails_before_dispatching_dependents"
            OUTPUT_CREATED_EARLIER: sview = "build_batch_rejects_output_created_before_later_dispatch"
            MAP_RECIPE_OUTPUTS: sview = "build_batch_maps_recipe_outputs_under_absolute_root"
            SKIP_VERIFIED_CACHE_HITS: sview = "incremental_build_batch_skips_verified_cache_hits_before_dispatch"
            ALL_CACHED_NO_LAUNCH: sview = "incremental_build_batch_completes_without_launches_when_all_targets_are_cached"
            EXECUTION_RESULT_CALL: sview = "build_batch_execution_result(session)"
            COMMIT_INCREMENTAL_EXECUTION: sview = "commit_build_incremental_execution(execution, session.scheduler.graph, previous, signed.recipes, observations)"
            ALL_RESULTS_CACHED: sview = "execution.nodes[0].cache_hit and execution.nodes[1].cache_hit"
            CANCELLED_CACHE_ZERO: sview = "cancelled_session.scheduler.cache.count == 2 and cancelled_session.scheduler.cache_hits == 0"
            CANCELLED_JOB_ZERO: sview = "cancelled_session.processes.jobs[0].state == ProcessBatchJobState.Cancelled"
            CANCELLED_JOB_ONE: sview = "cancelled_session.processes.jobs[1].state == ProcessBatchJobState.Cancelled"
            CANCELLED_NO_CACHE_HIT: sview = "cancelled_session.scheduler.cache_hits == 0 and not cancelled_session.results[0].cache_hit"
            TWO_CACHE_HITS: sview = "session.results[0].cache_hit and session.results[1].cache_hit"
            INVALIDATE_DIRTY_DEPENDENTS: sview = "incremental_build_batch_invalidates_cached_dependents_of_dirty_inputs"
            FORGED_CACHE_COUNT: sview = "forged_cache_count_rejected"
            FORGED_UNUSED_CACHE: sview = "forged_unused_cache_rejected"
            SKIPPED_PROCESS_JOB: sview = "session.processes.jobs[0].state == ProcessBatchJobState.Skipped"
            SUCCEEDED_BATCH: sview = "ProcessBatchState.Succeeded"
            NO_ATTEMPT_NO_READY: sview = "session.processes.jobs[0].attempts == 0 and session.scheduler.ready_queue.count == 0"
            EMPTY_SCHEDULER_CACHE: sview = "session.scheduler.cache.count == 0"
            FIRST_LAUNCH_NODE: sview = "launches.count == 1 and launches[0].node_index == 0"
            SECOND_JOB_PENDING: sview = "session.processes.jobs[1].state == ProcessBatchJobState.Pending"
            CACHED_DEPENDENCY: sview = "dependencies: [\"cached-object\"]"
            READY_QUEUE_SECOND: sview = "session.scheduler.ready_queue.count == 1 and session.scheduler.ready_queue[0] == 1"
            SECOND_LAUNCH_NODE: sview = "launches.count == 1 and launches[0].node_index == 1"
            INVALID_TRAVERSAL_PATH: sview = "traversal_rejected <- failure == BuildIncrementalError.InvalidPath"
            FIRST_WAVE_ORDER: sview = "first_wave[0].node_index == 0 and first_wave[1].node_index == 2"
            PROCESS_DRAINING_STATE: sview = "ProcessBatchState.Draining"
            INCOMPLETE_ACK: sview = "incomplete_acknowledgement_rejected"
            STALE_ACK: sview = "stale_acknowledgement_rejected"
            ACK_STOP_CALL: sview = "acknowledge_build_batch_stop(session, stop_requests)"
            LEDGER_SCHEDULER: sview = "ES-SCRIPT-002 | EsBuildScheduler"
            LEDGER_BATCH: sview = "EsBuildBatch pairs"


        const module Messages:
            MISSING_ROOT: sview = "build batch audit: missing repository root"
            UNRESOLVED_ROOT: sview = "build batch audit: unable to resolve repository root"
            MISSING_INPUT: sview = "build batch audit: missing "
            READ_FAILED: sview = "build batch audit: unable to read source: "
            HOST_LAUNCH_FORBIDDEN: sview = "build batch audit: host-neutral coordinator must not claim to launch children"
            SUCCESS: sview = "build batch audit: output verification, ready dispatch, receipt correlation, bounded logs, failure drain, and cancellation are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


        def reject_host_launch_api(model_path: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(Patterns::FORBIDDEN_HOST_LAUNCH)
            found: bool = try EsSourceFunctionScope::contains_file_regex_line(model_path, pattern) else err:
                diagnostic(Messages::READ_FAILED + f"{model_path}")
                return ExitStatus::IO_FAILURE
            if found:
                diagnostic(Messages::HOST_LAUNCH_FORBIDDEN)
                return ExitStatus::FAILURE
            return 0i64


        def declarations(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[2], pattern: Patterns::IR_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::LAUNCH},
                SearchCheck{input: inputs[0], pattern: Patterns::NODE_RESULT},
                SearchCheck{input: inputs[0], pattern: Patterns::NODE_PLAN},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION_FOR_GRAPH},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION_FOR_GRAPH_OUTPUTS},
                SearchCheck{input: inputs[0], pattern: Patterns::PLAN_VECTOR_ENTRIES_FIT},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_SETS_FROM_RECIPES},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION_FOR_RECIPES},
                SearchCheck{input: inputs[0], pattern: Patterns::INCREMENTAL_SESSION_FOR_RECIPES},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::BEGIN},
                SearchCheck{input: inputs[0], pattern: Patterns::EXECUTION_RESULT},
                SearchCheck{input: inputs[0], pattern: Patterns::DISPATCH_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::DISPATCH_READY_PREFLIGHT},
                SearchCheck{input: inputs[0], pattern: Patterns::REPORT_RESULT},
                SearchCheck{input: inputs[0], pattern: Patterns::REPORT_RESULT_OUTPUTS},
                SearchCheck{input: inputs[0], pattern: Patterns::PROCESS_RESULT_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL},
                SearchCheck{input: inputs[0], pattern: Patterns::STOP_ACK_MATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::ACK_STOP}
            ]


        def invariants(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::SCHEDULER_DISPATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::ADMIT_PROCESS_JOB},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_PROCESS_DISPATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::PROCESS_FAIL},
                SearchCheck{input: inputs[0], pattern: Patterns::PROCESS_REAP_ACK},
                SearchCheck{input: inputs[0], pattern: Patterns::SCHEDULER_NODE_FAIL},
                SearchCheck{input: inputs[0], pattern: Patterns::RESERVED_OUTPUT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::LOG_BYTES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::SCHEDULER_FAILING},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPECTED_READY_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::PROCESS_DRAINING},
                SearchCheck{input: inputs[0], pattern: Patterns::PROCESS_CANCEL_ACK},
                SearchCheck{input: inputs[0], pattern: Patterns::SCHEDULER_CANCEL_ACK},
                SearchCheck{input: inputs[0], pattern: Patterns::COMMAND_SNAPSHOT_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUTS_SNAPSHOT_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::COMMANDS_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUTS_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::PLAN_NODE_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::PLAN_VECTOR_FIT_CALL},
                SearchCheck{input: inputs[0], pattern: Patterns::PLAN_VECTOR_ENTRIES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::DEPENDENCY_VECTORS_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::NODE_NAME_ORDERS_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::RECIPE_SIGNATURES_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_SET_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::COMMAND_SNAPSHOT},
                SearchCheck{input: inputs[0], pattern: Patterns::PROCESS_SUCCEEDED_WITH_ERROR}
            ]


        def incremental_invariants(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::PROCESS_JOB_SKIPPED},
                SearchCheck{input: inputs[0], pattern: Patterns::SKIP_AT},
                SearchCheck{input: inputs[0], pattern: Patterns::ADMIT_INCREMENTAL_GRAPH},
                SearchCheck{input: inputs[0], pattern: Patterns::CACHE_HIT_STATE_MATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::CACHE_HITS_MATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::CACHE_COUNT_MATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::CACHE_HIT_EVENT}
            ]


        def output_invariants(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_SETS_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_PREFLIGHT_DISPATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::PREFLIGHT_REQUIRED},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_ALREADY_PRESENT},
                SearchCheck{input: inputs[0], pattern: Patterns::READY_PREFLIGHT},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_EXISTS_OR_SYMLINK},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_FILE_OR_SYMLINK},
                SearchCheck{input: inputs[0], pattern: Patterns::FIRST_MISSING_OUTPUT},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_MISSING},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_SET_COUNT}
            ]


        def executor_output_bounds(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[1], pattern: Patterns::OUTPUT_PATHS_LIMIT},
                SearchCheck{input: inputs[1], pattern: Patterns::OUTPUT_PATH_BYTES_LIMIT},
                SearchCheck{input: inputs[1], pattern: Patterns::OUTPUT_PATH_TEXT_BYTES_LIMIT},
                SearchCheck{input: inputs[1], pattern: Patterns::OUTPUT_INDEX_SLOTS_LIMIT},
                SearchCheck{input: inputs[1], pattern: Patterns::OUTPUT_PATH_HASH},
                SearchCheck{input: inputs[1], pattern: Patterns::SLOT_RESERVE}
            ]


        def fixture_cases(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[3], pattern: Patterns::DISPATCH_READY_TEST},
                SearchCheck{input: inputs[3], pattern: Patterns::PLAN_VECTOR_OVER_LIMIT_TEST},
                SearchCheck{input: inputs[3], pattern: Patterns::PLAN_LIMIT_ERROR},
                SearchCheck{input: inputs[3], pattern: Patterns::EXECUTION_STARTED},
                SearchCheck{input: inputs[3], pattern: Patterns::LINKED_STDERR},
                SearchCheck{input: inputs[3], pattern: Patterns::FAILURE_CANCELS_UNSTARTED},
                SearchCheck{input: inputs[3], pattern: Patterns::EXECUTION_NOT_COMPLETE},
                SearchCheck{input: inputs[3], pattern: Patterns::TIMEOUT_DRAINS_SIBLINGS},
                SearchCheck{input: inputs[3], pattern: Patterns::MULTIPLE_FAILURES_DRAIN},
                SearchCheck{input: inputs[3], pattern: Patterns::TIMED_OUT_RESULT},
                SearchCheck{input: inputs[3], pattern: Patterns::HOST_IO_FAILURE_RESULT},
                SearchCheck{input: inputs[3], pattern: Patterns::TWO_FAILED_PROCESSES},
                SearchCheck{input: inputs[3], pattern: Patterns::PARTIAL_LOG_LENGTH},
                SearchCheck{input: inputs[3], pattern: Patterns::CANCEL_BEFORE_BEGIN},
                SearchCheck{input: inputs[3], pattern: Patterns::WAIT_FOR_REAP_ACK},
                SearchCheck{input: inputs[3], pattern: Patterns::OMITTED_READY_QUEUE},
                SearchCheck{input: inputs[3], pattern: Patterns::DUPLICATE_TERMINAL_RECEIPTS},
                SearchCheck{input: inputs[3], pattern: Patterns::MALFORMED_RESULT_RESERVATION},
                SearchCheck{input: inputs[3], pattern: Patterns::OUTPUT_OVERRUN_RESERVATION},
                SearchCheck{input: inputs[3], pattern: Patterns::COMMAND_MUTATION},
                SearchCheck{input: inputs[3], pattern: Patterns::DEPENDENCY_MUTATION},
                SearchCheck{input: inputs[3], pattern: Patterns::EMPTY_MUTATED_DEPENDENCIES},
                SearchCheck{input: inputs[3], pattern: Patterns::SIGNATURE_MUTATION},
                SearchCheck{input: inputs[3], pattern: Patterns::MUTATED_SIGNATURE},
                SearchCheck{input: inputs[3], pattern: Patterns::DECLARED_OUTPUT_MUTATION_BEFORE},
                SearchCheck{input: inputs[3], pattern: Patterns::FORGED_OUTPUT_SET},
                SearchCheck{input: inputs[3], pattern: Patterns::JOB_MAPPING_INVALID},
                SearchCheck{input: inputs[3], pattern: Patterns::DECLARED_OUTPUT_MUTATION_AFTER},
                SearchCheck{input: inputs[3], pattern: Patterns::FORGED_OUTPUT_SET},
                SearchCheck{input: inputs[3], pattern: Patterns::SUCCESS_WITH_HOST_ERROR},
                SearchCheck{input: inputs[3], pattern: Patterns::RESULT_INVALID},
                SearchCheck{input: inputs[3], pattern: Patterns::RESERVED_OUTPUT_BUDGETS},
                SearchCheck{input: inputs[3], pattern: Patterns::ZERO_CAPTURE_LIMIT},
                SearchCheck{input: inputs[3], pattern: Patterns::ZERO_RESERVED_BYTES},
                SearchCheck{input: inputs[3], pattern: Patterns::MISSING_OUTPUT_BEFORE_DEPENDENT},
                SearchCheck{input: inputs[3], pattern: Patterns::OUTPUT_CREATED_EARLIER},
                SearchCheck{input: inputs[3], pattern: Patterns::MAP_RECIPE_OUTPUTS},
                SearchCheck{input: inputs[3], pattern: Patterns::SKIP_VERIFIED_CACHE_HITS},
                SearchCheck{input: inputs[3], pattern: Patterns::ALL_CACHED_NO_LAUNCH},
                SearchCheck{input: inputs[3], pattern: Patterns::EXECUTION_RESULT_CALL},
                SearchCheck{input: inputs[3], pattern: Patterns::COMMIT_INCREMENTAL_EXECUTION},
                SearchCheck{input: inputs[3], pattern: Patterns::ALL_RESULTS_CACHED},
                SearchCheck{input: inputs[3], pattern: Patterns::CANCELLED_CACHE_ZERO},
                SearchCheck{input: inputs[3], pattern: Patterns::CANCELLED_JOB_ZERO},
                SearchCheck{input: inputs[3], pattern: Patterns::CANCELLED_JOB_ONE},
                SearchCheck{input: inputs[3], pattern: Patterns::CANCELLED_NO_CACHE_HIT},
                SearchCheck{input: inputs[3], pattern: Patterns::TWO_CACHE_HITS},
                SearchCheck{input: inputs[3], pattern: Patterns::INVALIDATE_DIRTY_DEPENDENTS},
                SearchCheck{input: inputs[3], pattern: Patterns::FORGED_CACHE_COUNT},
                SearchCheck{input: inputs[3], pattern: Patterns::FORGED_UNUSED_CACHE},
                SearchCheck{input: inputs[3], pattern: Patterns::SKIPPED_PROCESS_JOB},
                SearchCheck{input: inputs[3], pattern: Patterns::SUCCEEDED_BATCH},
                SearchCheck{input: inputs[3], pattern: Patterns::NO_ATTEMPT_NO_READY},
                SearchCheck{input: inputs[3], pattern: Patterns::EMPTY_SCHEDULER_CACHE},
                SearchCheck{input: inputs[3], pattern: Patterns::FIRST_LAUNCH_NODE},
                SearchCheck{input: inputs[3], pattern: Patterns::SECOND_JOB_PENDING},
                SearchCheck{input: inputs[3], pattern: Patterns::CACHED_DEPENDENCY},
                SearchCheck{input: inputs[3], pattern: Patterns::READY_QUEUE_SECOND},
                SearchCheck{input: inputs[3], pattern: Patterns::SECOND_LAUNCH_NODE},
                SearchCheck{input: inputs[3], pattern: Patterns::INVALID_TRAVERSAL_PATH},
                SearchCheck{input: inputs[3], pattern: Patterns::FIRST_WAVE_ORDER},
                SearchCheck{input: inputs[3], pattern: Patterns::PROCESS_DRAINING_STATE},
                SearchCheck{input: inputs[3], pattern: Patterns::INCOMPLETE_ACK},
                SearchCheck{input: inputs[3], pattern: Patterns::STALE_ACK},
                SearchCheck{input: inputs[3], pattern: Patterns::ACK_STOP_CALL}
            ]


        def execute_all(inputs: darray[Path]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = execute(declarations(inputs))
            return status if status != 0i64

            status <- execute(invariants(inputs))
            return status if status != 0i64

            status <- execute(incremental_invariants(inputs))
            return status if status != 0i64

            status <- execute(output_invariants(inputs))
            return status if status != 0i64

            status <- execute([
                SearchCheck{input: inputs[3], pattern: Patterns::EXISTING_OUTPUT_TEST}
            ])
            return status if status != 0i64

            status <- execute(executor_output_bounds(inputs))
            return status if status != 0i64

            status <- execute([
                SearchCheck{input: inputs[0], pattern: Patterns::STOP_ACK_MISMATCH}
            ])
            return status if status != 0i64

            status <- reject_host_launch_api(inputs[0])
            return status if status != 0i64

            status <- execute(fixture_cases(inputs))
            return status if status != 0i64

            status <- execute([
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_SCHEDULER},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_BATCH}
            ])
            return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::EXECUTOR),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute_all(inputs)
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsBuildBatchAudit::run_default()
