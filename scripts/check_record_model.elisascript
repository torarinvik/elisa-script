# Bounded Elisascript port of check_record_model.sh.
# Regex and fixed-string checks retain their distinct ripgrep semantics.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsRecordModelAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/record_model.elisa"
            FIELD_SCANNER: sview = "src/runtime/record_field_scan_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            SCANNER_FIXTURE: sview = "test/runtime/record_field_scan_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODEL_MODULE: sview = "^module EsRecord:"
            SCANNER_MODULE: sview = "^module EsRecordFieldScan:"
            MODEL_IMPORT: sview = "include \"\\.\\./runtime/record_model\\.elisa\""
            SCANNER_IMPORT: sview = "include \"\\.\\./runtime/record_field_scan_model\\.elisa\""
            SEPARATOR_MODE: sview = "const enum RecordSeparatorMode of u8"
            FIELD_MODE: sview = "const enum RecordFieldMode of u8"
            STREAM_POLICY: sview = "struct RecordStreamPolicy:"
            RECORD: sview = "struct Record:"
            RECORD_FIELD: sview = "struct RecordField:"
            CONTRACT_ERROR: sview = "error RecordContractError:"
            VALIDATE_STREAM_POLICY: sview = "def validate_record_stream_policy\\("
            VALIDATE_RECORD: sview = "def validate_record\\("
            VALIDATE_RECORD_FIELD: sview = "def validate_record_field\\("
            FIELD_SEPARATOR_SPAN: sview = "struct RecordFieldSeparatorSpan:"
            SPLIT_FIELDS: sview = "def split_record_fields\\("
            SELECT_FIELD: sview = "def select_record_field\\("
            FIELD_SELECTION: sview = "struct RecordFieldSelection:"
            FIELD_INDEX_INVALID: sview = "RecordFieldScanError.FieldIndexInvalid"
            ASCII_WHITESPACE: sview = "record_field_scan_ascii_whitespace"
            SEPARATOR_AT: sview = "record_field_scan_separator_at"
            MODE_WHOLE: sview = "RecordFieldMode.Whole"
            MODE_WHITESPACE: sview = "RecordFieldMode.Whitespace"
            MODE_LITERAL: sview = "RecordFieldMode.Literal"
            MODE_FIXED_WIDTH: sview = "RecordFieldMode.FixedWidth"
            FIELD_LIMIT_EXCEEDED: sview = "RecordFieldScanError.FieldLimitExceeded"
            FIXED_WIDTH_REMAINDER: sview = "RecordFieldScanError.FixedWidthRemainder"
            SPLIT_REGEX_SPANS: sview = "def split_record_fields_from_regex_spans\\("
            INVALID_SEPARATOR_SPAN: sview = "RecordFieldScanError.InvalidSeparatorSpan"
            NON_PROGRESSING_SEPARATOR: sview = "RecordFieldScanError.NonProgressingSeparator"
            UNSUPPORTED_MODE: sview = "RecordFieldScanError.UnsupportedMode"
            TEXT_BYTES: sview = "Limits::TEXT_BYTES"
            FIELDS: sview = "Limits::FIELDS"
            TEXT_LENGTH_VALID: sview = "record_text_length_valid"
            CONTAINS_BYTE: sview = "sview_contains_byte"
            WIDTHS_FIT: sview = "record_fixed_widths_fit"
            POLICY_WIDTHS_FIT: sview = "record_fixed_widths_fit\\(policy.fixed_widths, policy.max_fields, policy.max_record_bytes\\)"
            VALIDATE_POLICY_CALL: sview = "try validate_record_stream_policy\\(policy\\)"
            VALIDATE_RECORD_CALL: sview = "try validate_record\\(record, policy\\)"
            ELSE: sview = "else:"
            FIXED_WIDTH_OVERFLOW: sview = "RecordContractError.FixedWidthOverflow"
            INVALID_FIELD_RANGE: sview = "RecordContractError.InvalidFieldRange"
            SCHEMA_MISSING: sview = "RecordContractError.SchemaMissing"
            RECORD_NUMBER_ZERO: sview = "record_number == 0"
            ABSENT_VALUE_NONEMPTY: sview = "not field.present and field.value != \"\""
            FIELD_VALUE_NOT_RAW: sview = "field.value != record.raw"
            SCANNER_MATERIALIZES_FIELDS: sview = "record_scanner_materializes_whitespace_literal_and_whole_fields"
            FIXED_WIDTH_ABSENT_COLUMNS: sview = "fixed_width_record_scanner_marks_absent_columns_and_rejects_remainders"
            REGEX_SPANS_EMPTY_FIELDS: sview = "regex_separator_spans_preserve_empty_fields_and_zero_width_progress"
            UNICODE_FIELD_START: sview = "unicode_fields[1].start_byte == 3"
            LITERAL_FIELD_COUNT: sview = "literal_fields.count == 4"
            SELECT_LITERAL_FIELD: sview = "select_record_field(literal_record, literal_fields, literal_policy, 0)"
            MISSING_SELECTION: sview = "not missing_selection.present"
            BOUNDED_SELECTION_REJECTED: sview = "bounded_selection_rejected"
            LITERAL_EMPTY_COUNT: sview = "literal_empty_fields.count == 0"
            ADVANCE_MATERIALIZER: sview = "advance_record_materializer"
            VALIDATE_MATERIALIZER: sview = "validate_record_materializer"
            EMPTY_REGEX_FIELD_COUNT: sview = "empty_regex_fields.count == 1"
            FIXTURE_NON_PROGRESSING: sview = "NonProgressingSeparator"
            INVALID_SPAN: sview = "invalid_span"
            ABSENT_THIRD_FIELD: sview = "not fields[2].present"
            FIXTURE_FIELD_LIMIT: sview = "RecordFieldScanError.FieldLimitExceeded"
            FIXTURE_UNSUPPORTED_MODE: sview = "RecordFieldScanError.UnsupportedMode"
            RECORD_CONTRACT_FIXTURE: sview = "typed_record_stream_contract_is_bounded_and_explicit"
            REGEX_SEPARATOR: sview = "RecordSeparatorMode.Regex"
            FIXTURE_FIXED_WIDTH: sview = "RecordFieldMode.FixedWidth"
            SCHEMA_MODE: sview = "RecordFieldMode.Schema"
            INVALID_SEPARATOR: sview = "RecordContractError.InvalidSeparator"
            FIXTURE_FIXED_WIDTH_MALFORMED: sview = "RecordContractError.FixedWidthMalformed"
            FIXED_RECORD_LIMIT: sview = "fixed_record_limit"
            FIXTURE_VALIDATE_FIELD: sview = "validate_record_field"
            INVALID_RECORD_POLICY: sview = "invalid_record_policy"
            DOCS_STREAM_POLICY: sview = "EsRecord::RecordStreamPolicy"
            DOCS_SPLIT_FIELDS: sview = "EsRecordFieldScan::split_record_fields"
            DOCS_SELECT_FIELD: sview = "select_record_field"
            DOCS_CONTRACT_ERROR: sview = "error\\[RecordContractError\\]"
            LEDGER_STREAM_POLICY: sview = "EsRecord::RecordStreamPolicy"
            LEDGER_FIELD_SCAN: sview = "EsRecordFieldScan"
            LEDGER_FIELD_SELECTION: sview = "field-selection"


        const module Messages:
            MISSING_ROOT: sview = "record model audit: missing repository root"
            UNRESOLVED_ROOT: sview = "record model audit: unable to resolve repository root"
            MISSING_INPUT: sview = "record model audit: missing "
            READ_FAILED: sview = "record model audit: unable to read source: "
            SUCCESS: sview = "record model audit: bounded separator, field, metadata, and range contracts are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        const enum SearchMode of u8:
            Regex
            Literal


        struct SearchCheck:
            input: Path
            pattern: sview
            mode: SearchMode = SearchMode.Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def regex_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(check.pattern)
            catch EsSourceFunctionScope::contains_file_regex_line(check.input, pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return ExitStatus::IO_FAILURE


        def literal_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return ExitStatus::IO_FAILURE


        def search_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            match check.mode:
                SearchMode.Regex:
                    return regex_status(check)
                SearchMode.Literal:
                    return literal_status(check)
                _:
                    return ExitStatus.FAILURE


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODEL_MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::SCANNER_MODULE},
                SearchCheck{input: inputs[2], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::SCANNER_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::SEPARATOR_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::FIELD_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_FIELD},
                SearchCheck{input: inputs[0], pattern: Patterns::CONTRACT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_STREAM_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_RECORD},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_RECORD_FIELD},
                SearchCheck{input: inputs[1], pattern: Patterns::FIELD_SEPARATOR_SPAN},
                SearchCheck{input: inputs[1], pattern: Patterns::SPLIT_FIELDS},
                SearchCheck{input: inputs[1], pattern: Patterns::SELECT_FIELD},
                SearchCheck{input: inputs[1], pattern: Patterns::FIELD_SELECTION},
                SearchCheck{input: inputs[1], pattern: Patterns::FIELD_INDEX_INVALID},
                SearchCheck{input: inputs[1], pattern: Patterns::ASCII_WHITESPACE},
                SearchCheck{input: inputs[1], pattern: Patterns::SEPARATOR_AT},
                SearchCheck{input: inputs[1], pattern: Patterns::MODE_WHOLE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODE_WHITESPACE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODE_LITERAL},
                SearchCheck{input: inputs[1], pattern: Patterns::MODE_FIXED_WIDTH},
                SearchCheck{input: inputs[1], pattern: Patterns::FIELD_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[1], pattern: Patterns::FIXED_WIDTH_REMAINDER},
                SearchCheck{input: inputs[1], pattern: Patterns::SPLIT_REGEX_SPANS},
                SearchCheck{input: inputs[1], pattern: Patterns::INVALID_SEPARATOR_SPAN},
                SearchCheck{input: inputs[1], pattern: Patterns::NON_PROGRESSING_SEPARATOR},
                SearchCheck{input: inputs[1], pattern: Patterns::UNSUPPORTED_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::FIELDS},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_LENGTH_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::CONTAINS_BYTE},
                SearchCheck{input: inputs[0], pattern: Patterns::WIDTHS_FIT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY_WIDTHS_FIT},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_POLICY_CALL},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_RECORD_CALL},
                SearchCheck{input: inputs[0], pattern: Patterns::ELSE},
                SearchCheck{input: inputs[0], pattern: Patterns::FIXED_WIDTH_OVERFLOW},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_FIELD_RANGE},
                SearchCheck{input: inputs[0], pattern: Patterns::SCHEMA_MISSING},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_NUMBER_ZERO},
                SearchCheck{input: inputs[0], pattern: Patterns::ABSENT_VALUE_NONEMPTY},
                SearchCheck{input: inputs[0], pattern: Patterns::FIELD_VALUE_NOT_RAW},
                SearchCheck{input: inputs[4], pattern: Patterns::SCANNER_MATERIALIZES_FIELDS, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXED_WIDTH_ABSENT_COLUMNS, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::REGEX_SPANS_EMPTY_FIELDS, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::UNICODE_FIELD_START, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::LITERAL_FIELD_COUNT, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::SELECT_LITERAL_FIELD, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::MISSING_SELECTION, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::BOUNDED_SELECTION_REJECTED, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::LITERAL_EMPTY_COUNT, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::ADVANCE_MATERIALIZER, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::VALIDATE_MATERIALIZER, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::EMPTY_REGEX_FIELD_COUNT, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_NON_PROGRESSING, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::INVALID_SPAN, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::ABSENT_THIRD_FIELD, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_FIELD_LIMIT, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_UNSUPPORTED_MODE, mode: SearchMode.Literal},
                SearchCheck{input: inputs[3], pattern: Patterns::RECORD_CONTRACT_FIXTURE},
                SearchCheck{input: inputs[3], pattern: Patterns::REGEX_SEPARATOR},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_FIXED_WIDTH},
                SearchCheck{input: inputs[3], pattern: Patterns::SCHEMA_MODE},
                SearchCheck{input: inputs[3], pattern: Patterns::INVALID_SEPARATOR},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_FIXED_WIDTH_MALFORMED},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXED_RECORD_LIMIT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_VALIDATE_FIELD},
                SearchCheck{input: inputs[3], pattern: Patterns::INVALID_RECORD_POLICY},
                SearchCheck{input: inputs[5], pattern: Patterns::DOCS_STREAM_POLICY},
                SearchCheck{input: inputs[5], pattern: Patterns::DOCS_SPLIT_FIELDS},
                SearchCheck{input: inputs[5], pattern: Patterns::DOCS_SELECT_FIELD},
                SearchCheck{input: inputs[5], pattern: Patterns::DOCS_CONTRACT_ERROR},
                SearchCheck{input: inputs[6], pattern: Patterns::LEDGER_STREAM_POLICY},
                SearchCheck{input: inputs[6], pattern: Patterns::LEDGER_FIELD_SCAN},
                SearchCheck{input: inputs[6], pattern: Patterns::LEDGER_FIELD_SELECTION}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                status: i64 = search_status(check)
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::FIELD_SCANNER),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::SCANNER_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsRecordModelAudit::run_default()
