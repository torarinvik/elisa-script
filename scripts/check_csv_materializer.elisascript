# Bounded Elisascript port of check_csv_materializer.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsCsvMaterializerAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/csv_materializer_model.elisa"
            CSV_MODEL: sview = "src/runtime/csv_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            RUNTIME_FIXTURE: sview = "test/runtime/csv_empty_input_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "module EsCsvMaterialize:"
            MAX_FIELDS: sview = "CSV_MATERIALIZER_MAX_FIELDS"
            MAX_RECORDS: sview = "CSV_MATERIALIZER_MAX_RECORDS"
            STATE: sview = "const enum CsvMaterializerState of u8:"
            EVENT: sview = "const enum CsvMaterializerEvent of u8:"
            FIELD_SPAN: sview = "struct CsvFieldSpan:"
            RECORD_SPAN: sview = "struct CsvRecordSpan:"
            MATERIALIZER: sview = "struct CsvMaterializer:"
            ERROR: sview = "error CsvMaterializerError:"
            VALIDATE: sview = "def validate_csv_materializer("
            MATERIALIZED_FIELD: sview = "def csv_materialized_field("
            ADVANCE: sview = "def advance_csv_materializer("
            FIELD_RANGE_VALID: sview = "materializer_field_range_valid"
            RAW_FIELD_VALID: sview = "materializer_raw_field_valid"
            RECORD_TERMINATOR: sview = "materializer_record_terminator_at"
            COMPLETE_SOURCE: sview = "materializer_complete_source_covered"
            FIELD_LAYOUT_INVALID: sview = "FieldLayoutInvalid"
            RECORD_LAYOUT_INVALID: sview = "RecordLayoutInvalid"
            CSV_POLICY_VALID: sview = "try validate_csv_policy(materializer.policy)"
            SOURCE_LIMIT: sview = "sview_len(source) <= DATA_MAX_INPUT_BYTES"
            FIELD_SPAN_LIMIT: sview = "span.end - span.start <= DATA_MAX_FIELD_BYTES"
            FIELD_CURSOR: sview = "record_field_cursor"
            FIELD_LIMIT: sview = "FieldLimitExceeded"
            RECORD_LIMIT: sview = "RecordLimitExceeded"
            FIELD_RANGE_ERROR: sview = "FieldRangeInvalid"
            FIELD_ORDER_ERROR: sview = "FieldOrderInvalid"
            RECORD_ORDER_ERROR: sview = "RecordOrderInvalid"
            ACCOUNTED_RECORD_FIELDS: sview = "accounted_record_fields"
            NEXT_FIELD_COUNT: sview = "materializer.next_field != materializer.fields.count"
            FIRST_FIELD_BOUND: sview = "first_field > materializer.fields.count"
            RECORD_FIRST_FIELD_BOUND: sview = "record.first_field > materializer.fields.count"
            RECORD_FIELD_COUNT_BOUND: sview = "record.field_count > materializer.fields.count - record.first_field"
            EMPTY_RECORD_FIELDS: sview = "if record.field_count == 0:"
            TERMINATOR_AT_CURSOR: sview = "materializer_record_terminator_at(materializer, source_cursor)"
            READY_STATE: sview = "materializer.state == CsvMaterializerState.Ready and"
            BUILDING_STATE: sview = "CsvMaterializerState.Building and materializer.state != CsvMaterializerState.Complete"
            SOURCE_ACCOUNTING: sview = "SourceAccountingInvalid"
            END_NOT_READY: sview = "EndNotReady"
            IR_IMPORT: sview = "include \"../runtime/csv_materializer_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsCsvMaterialize"
            FIXTURE_CONTRACT: sview = "typed_csv_materializer_contract_preserves_bounded_field_spans"
            CRLF_CONTRACT: sview = "typed_csv_materializer_validates_crlf_boundaries_and_quoted_newlines"
            CRLF_MODE: sview = "CsvLineEndingMode.CrLf"
            TRAILING_BYTES: sview = "trailing_bytes_rejected"
            FIELD_EVENT: sview = "CsvMaterializerEvent.Field"
            RECORD_EVENT: sview = "CsvMaterializerEvent.Record"
            FIXTURE_MATERIALIZED_FIELD: sview = "csv_materialized_field"
            FIXTURE_FIELD_INDEX: sview = "CsvMaterializerError.FieldIndexInvalid"
            EMPTY_INPUT_CONTRACT: sview = "csv_empty_input_and_blank_records_match_python_shape"
            EMPTY_RECORDS: sview = "empty_materializer.records.count == 0"
            BLANK_RECORDS: sview = "blank_record_materializer.records.count == 1"
            BLANK_FIELD_COUNT: sview = "blank_record_materializer.records[0].field_count == 0"
            QUOTED_EMPTY_RECORDS: sview = "quoted_empty_materializer.records.count == 1"
            MIXED_COUNTS: sview = "mixed_materializer.fields.count == 2 and mixed_materializer.records.count == 3"
            DOCS_MATERIALIZER: sview = "`EsCsvMaterialize` gives CSV/TSV adapters a policy-bound borrowed-span"
            DOCS_LIMIT: sview = "exact configured"
            LEDGER_MATERIALIZER: sview = "ES-SCRIPT-009 | EsCsvMaterialize"


        const module Messages:
            MISSING_ROOT: sview = "csv materializer audit: missing repository root"
            UNRESOLVED_ROOT: sview = "csv materializer audit: unable to resolve repository root"
            MISSING_INPUT: sview = "csv materializer audit: missing "
            READ_FAILED: sview = "csv materializer audit: unable to read source: "
            SUCCESS: sview = "csv materializer audit: bounded spans, contiguous records, exact line endings, quote markers, shared ceilings, and validated slices are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_FIELDS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_RECORDS},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::FIELD_SPAN},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_SPAN},
                SearchCheck{input: inputs[0], pattern: Patterns::MATERIALIZER},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::MATERIALIZED_FIELD},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::FIELD_RANGE_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::RAW_FIELD_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_TERMINATOR},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETE_SOURCE},
                SearchCheck{input: inputs[0], pattern: Patterns::FIELD_LAYOUT_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_LAYOUT_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::CSV_POLICY_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::SOURCE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::FIELD_SPAN_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::FIELD_CURSOR},
                SearchCheck{input: inputs[0], pattern: Patterns::FIELD_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::FIELD_RANGE_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::FIELD_ORDER_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_ORDER_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTED_RECORD_FIELDS},
                SearchCheck{input: inputs[0], pattern: Patterns::NEXT_FIELD_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::FIRST_FIELD_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_FIRST_FIELD_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_FIELD_COUNT_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::EMPTY_RECORD_FIELDS},
                SearchCheck{input: inputs[0], pattern: Patterns::TERMINATOR_AT_CURSOR},
                SearchCheck{input: inputs[0], pattern: Patterns::READY_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::BUILDING_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::SOURCE_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::END_NOT_READY},
                SearchCheck{input: inputs[2], pattern: Patterns::IR_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[3], pattern: Patterns::CRLF_CONTRACT},
                SearchCheck{input: inputs[3], pattern: Patterns::CRLF_MODE},
                SearchCheck{input: inputs[3], pattern: Patterns::TRAILING_BYTES},
                SearchCheck{input: inputs[3], pattern: Patterns::FIELD_EVENT},
                SearchCheck{input: inputs[3], pattern: Patterns::RECORD_EVENT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_MATERIALIZED_FIELD},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_FIELD_INDEX},
                SearchCheck{input: inputs[4], pattern: Patterns::EMPTY_INPUT_CONTRACT},
                SearchCheck{input: inputs[4], pattern: Patterns::EMPTY_RECORDS},
                SearchCheck{input: inputs[4], pattern: Patterns::BLANK_RECORDS},
                SearchCheck{input: inputs[4], pattern: Patterns::BLANK_FIELD_COUNT},
                SearchCheck{input: inputs[4], pattern: Patterns::QUOTED_EMPTY_RECORDS},
                SearchCheck{input: inputs[4], pattern: Patterns::MIXED_COUNTS},
                SearchCheck{input: inputs[5], pattern: Patterns::DOCS_MATERIALIZER},
                SearchCheck{input: inputs[5], pattern: Patterns::DOCS_LIMIT},
                SearchCheck{input: inputs[6], pattern: Patterns::LEDGER_MATERIALIZER}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::CSV_MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::RUNTIME_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsCsvMaterializerAudit::run_default()
