# Bounded Elisascript port of check_network_model.sh.
# Fixed contract phrases are scanned one physical line at a time.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsNetworkModelAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/network_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "module EsNetwork:"
            METHOD: sview = "const enum NetworkMethod of u8:"
            OUTCOME: sview = "const enum NetworkOutcome of u8:"
            RETRY_MODE: sview = "const enum NetworkRetryMode of u8:"
            RETRY_POLICY: sview = "struct NetworkRetryPolicy:"
            TLS_VERSION: sview = "const enum NetworkTlsVersion of u8:"
            TLS_TRUST_MODE: sview = "const enum NetworkTlsTrustMode of u8:"
            TLS_POLICY: sview = "struct NetworkTlsPolicy:"
            STREAM_DIRECTION: sview = "const enum NetworkStreamDirection of u8:"
            STREAM_STATE: sview = "const enum NetworkStreamState of u8:"
            STREAM_EVENT: sview = "const enum NetworkStreamEvent of u8:"
            CHUNK: sview = "struct NetworkChunk:"
            STREAM: sview = "struct NetworkStream:"
            REQUEST_STATE: sview = "const enum NetworkRequestState of u8:"
            REQUEST_EVENT: sview = "const enum NetworkRequestEvent of u8:"
            REQUEST_JOB: sview = "struct NetworkRequestJob:"
            REQUEST: sview = "struct NetworkRequest:"
            RESPONSE: sview = "struct NetworkResponse:"
            CONTRACT_ERROR: sview = "error NetworkContractError:"
            VALIDATE_TLS_POLICY: sview = "def validate_network_tls_policy("
            VALIDATE_STREAM: sview = "def validate_network_stream("
            ADVANCE_STREAM: sview = "def advance_network_stream("
            ENQUEUE_CHUNK: sview = "def enqueue_network_chunk("
            CONSUME_STREAM: sview = "def consume_network_stream("
            VALIDATE_RETRY_POLICY: sview = "def validate_network_retry_policy("
            RETRY_BACKOFF: sview = "def network_retry_backoff_micros("
            ADVANCE_REQUEST: sview = "def advance_network_request("
            VALIDATE_REQUEST: sview = "def validate_network_request("
            VALIDATE_RESPONSE: sview = "def validate_network_response("
            LIMITS: sview = "const module Limits:"
            URL_BYTES: sview = "Limits::URL_BYTES"
            HEADER_BYTES: sview = "Limits::HEADER_BYTES"
            HEADER_COMPARISON_WORK: sview = "Limits::HEADER_COMPARISON_WORK"
            BODY_BYTES: sview = "Limits::BODY_BYTES"
            RETRY_ATTEMPTS: sview = "Limits::RETRY_ATTEMPTS"
            BACKOFF_MICROS: sview = "Limits::BACKOFF_MICROS"
            TLS_PATH_BYTES: sview = "Limits::TLS_PATH_BYTES"
            CHUNK_BYTES: sview = "Limits::CHUNK_BYTES"
            BUFFER_BYTES: sview = "Limits::BUFFER_BYTES"
            STREAM_CHUNKS: sview = "Limits::STREAM_CHUNKS"
            HEADERS_VALID: sview = "network_headers_valid"
            SENSITIVE_HEADER_NAMES_VALID: sview = "network_sensitive_header_names_valid"
            HEADER_NAME_BYTE_VALID: sview = "network_header_name_byte_valid"
            HEADER_VALUE_VALID: sview = "network_header_value_valid"
            HEADER_NAME_BYTE_EQUAL: sview = "network_header_name_byte_equal"
            HEADER_NAMES_EQUAL: sview = "network_header_names_equal"
            HEADER_COMPARISON_MATCHES: sview = "network_header_comparison_matches"
            EFFECTIVE_BODY_LIMIT: sview = "EffectiveBodyLimitExceeded"
            EFFECTIVE_HEADERS: sview = "network_request_effective_headers"
            HOST_COMPARISON: sview = "network_header_comparison_matches(name, \"host\", comparison_work)"
            CONTENT_LENGTH: sview = "Content-Length"
            TRANSFER_ENCODING: sview = "Transfer-Encoding"
            TRAILER: sview = "Trailer"
            LEFT_FOLDED: sview = "left_folded"
            COMPARISON_LIMIT_ERROR: sview = "HeaderComparisonLimitExceeded"
            COMPARISON_WORK: sview = "comparison_work"
            METHOD_IDEMPOTENT: sview = "network_method_is_idempotent"
            RETRY_BACKOFF_CALL: sview = "network_retry_backoff_micros"
            TLS_PATH_VALID: sview = "network_tls_path_valid"
            DUPLICATE_HEADER: sview = "DuplicateHeaderName"
            HEADER_VALUE_INVALID: sview = "HeaderValueInvalid"
            INVALID_CONTROL_BYTE: sview = "byte < 32u8 and byte != 9u8"
            INVALID_TIMEOUT: sview = "InvalidTimeout"
            INVALID_RESPONSE_LIMIT: sview = "InvalidResponseLimit"
            INVALID_RETRY_ATTEMPTS: sview = "InvalidRetryAttempts"
            INVALID_RETRY_BACKOFF: sview = "InvalidRetryBackoff"
            NON_IDEMPOTENT_RETRY: sview = "NonIdempotentRetry"
            INVALID_TLS_BUNDLE: sview = "InvalidTlsBundle"
            INVALID_TLS_CLIENT_IDENTITY: sview = "InvalidTlsClientIdentity"
            TLS_PATH_NUL: sview = "TlsPathEmbeddedNul"
            CHUNK_SEQUENCE_MISMATCH: sview = "ChunkSequenceMismatch"
            STREAM_BUFFER_EXCEEDED: sview = "StreamBufferExceeded"
            STREAM_NOT_COMPLETE: sview = "StreamNotComplete"
            STREAM_NOT_DRAINED: sview = "StreamNotDrained"
            STREAM_ACCOUNTING_INVALID: sview = "StreamAccountingInvalid"
            CANCELLING_OR_CANCELLED: sview = "stream.state == NetworkStreamState.Cancelling or stream.state == NetworkStreamState.Cancelled"
            REQUEST_ACTIVE: sview = "network_request_state_is_active"
            REQUEST_REQUIRES_ATTEMPT: sview = "network_request_state_requires_attempt"
            ATTEMPTS_ABOVE_MAX: sview = "job.attempts > job.max_attempts"
            PLANNED_ATTEMPT_BOUND: sview = "job.state == NetworkRequestState.Planned and job.attempts >= job.max_attempts"
            CANCEL_ACK: sview = "NetworkRequestEvent.CancelAck"
            RETRY_EVENT: sview = "NetworkRequestEvent.Retry"
            SUCCESS_OUTCOME: sview = "response.outcome == NetworkOutcome.Success"
            STATUS_FAILURE_OUTCOME: sview = "response.outcome == NetworkOutcome.StatusFailure"
            STATUS_RANGE: sview = "response.status < 200 or response.status > 399"
            STATUS_ZERO: sview = "response.status != 0"
            FIXTURE_CONTRACT: sview = "typed_network_contract_is_explicit_and_bounded"
            FIXTURE_POST: sview = "NetworkMethod.Post"
            TLS_FAILURE_OUTCOME: sview = "NetworkOutcome.TlsFailure"
            IDEMPOTENT_ONLY: sview = "NetworkRetryMode.IdempotentOnly"
            FIXTURE_NON_IDEMPOTENT_RETRY: sview = "NetworkContractError.NonIdempotentRetry"
            CUSTOM_BUNDLE: sview = "NetworkTlsTrustMode.CustomBundle"
            FIXTURE_INVALID_TLS_BUNDLE: sview = "NetworkContractError.InvalidTlsBundle"
            FIXTURE_INVALID_CLIENT_IDENTITY: sview = "NetworkContractError.InvalidTlsClientIdentity"
            PAUSE_EVENT: sview = "NetworkStreamEvent.Pause"
            FINISH_EVENT: sview = "NetworkStreamEvent.Finish"
            FIXTURE_CHUNK_SEQUENCE: sview = "NetworkContractError.ChunkSequenceMismatch"
            FIXTURE_STREAM_NOT_DRAINED: sview = "NetworkContractError.StreamNotDrained"
            FIXTURE_STREAM_ACCOUNTING: sview = "NetworkContractError.StreamAccountingInvalid"
            FORGED_CANCELLING_STREAM: sview = "forged_cancelling_stream"
            FIXTURE_CANCELLING_STATE: sview = "NetworkRequestState.Cancelling"
            FIXTURE_CANCELLED_STATE: sview = "NetworkRequestState.Cancelled"
            FIXTURE_DUPLICATE_HEADER: sview = "NetworkContractError.DuplicateHeaderName"
            DUPLICATE_COMPARISON_BOUNDED: sview = "request_header_duplicate_comparison_work_is_bounded"
            FIXTURE_COMPARISON_LIMIT: sview = "NetworkContractError.HeaderComparisonLimitExceeded"
            REPEATED_RESPONSE_FIELDS: sview = "repeated_response_fields"
            SESSION_TWO: sview = "session=two"
            PAGINATION_LINK: sview = "</page/3>; rel=next"
            FIXTURE_INVALID_TIMEOUT: sview = "NetworkContractError.InvalidTimeout"
            INVALID_STATUS: sview = "NetworkContractError.InvalidStatus"
            FORGED_CANCELLED_STREAM: sview = "forged_cancelled_stream"
            CASE_INSENSITIVE_HEADERS: sview = "case_insensitive_headers"
            CASE_INSENSITIVE_DUPLICATE: sview = "case_insensitive_duplicate_rejected"
            INVALID_HEADER_NAME: sview = "invalid_header_name"
            INVALID_HEADER_VALUE: sview = "invalid_header_value"
            FORGED_SUCCESS_STATUS: sview = "forged_success_status"
            FORGED_FAILURE_STATUS: sview = "forged_failure_status"
            FORGED_COMPLETED_OUTCOME: sview = "forged_completed_outcome"
            DOCS_REQUEST: sview = "EsNetwork::NetworkRequest"
            DOCS_CONTRACT_ERROR: sview = "error[NetworkContractError]"
            LEDGER_REQUEST: sview = "EsNetwork::NetworkRequest"


        const module Messages:
            MISSING_ROOT: sview = "network model audit: missing repository root"
            UNRESOLVED_ROOT: sview = "network model audit: unable to resolve repository root"
            MISSING_INPUT: sview = "network model audit: missing "
            READ_FAILED: sview = "network model audit: unable to read source: "
            SUCCESS: sview = "network model audit: bounded request/response, retry, streaming, cancellation, and lifecycle contracts are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::METHOD},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTCOME},
                SearchCheck{input: inputs[0], pattern: Patterns::RETRY_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::RETRY_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::TLS_VERSION},
                SearchCheck{input: inputs[0], pattern: Patterns::TLS_TRUST_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::TLS_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_DIRECTION},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::CHUNK},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST_JOB},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST},
                SearchCheck{input: inputs[0], pattern: Patterns::RESPONSE},
                SearchCheck{input: inputs[0], pattern: Patterns::CONTRACT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_TLS_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_STREAM},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE_STREAM},
                SearchCheck{input: inputs[0], pattern: Patterns::ENQUEUE_CHUNK},
                SearchCheck{input: inputs[0], pattern: Patterns::CONSUME_STREAM},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_RETRY_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::RETRY_BACKOFF},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE_REQUEST},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_REQUEST},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_RESPONSE},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMITS},
                SearchCheck{input: inputs[0], pattern: Patterns::URL_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::HEADER_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::HEADER_COMPARISON_WORK},
                SearchCheck{input: inputs[0], pattern: Patterns::BODY_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::RETRY_ATTEMPTS},
                SearchCheck{input: inputs[0], pattern: Patterns::BACKOFF_MICROS},
                SearchCheck{input: inputs[0], pattern: Patterns::TLS_PATH_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::CHUNK_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::BUFFER_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_CHUNKS},
                SearchCheck{input: inputs[0], pattern: Patterns::HEADERS_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::SENSITIVE_HEADER_NAMES_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::HEADER_NAME_BYTE_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::HEADER_VALUE_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::HEADER_NAME_BYTE_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::HEADER_NAMES_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::HEADER_COMPARISON_MATCHES},
                SearchCheck{input: inputs[0], pattern: Patterns::EFFECTIVE_BODY_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::EFFECTIVE_HEADERS},
                SearchCheck{input: inputs[0], pattern: Patterns::HOST_COMPARISON},
                SearchCheck{input: inputs[0], pattern: Patterns::CONTENT_LENGTH},
                SearchCheck{input: inputs[0], pattern: Patterns::TRANSFER_ENCODING},
                SearchCheck{input: inputs[0], pattern: Patterns::TRAILER},
                SearchCheck{input: inputs[0], pattern: Patterns::LEFT_FOLDED},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPARISON_LIMIT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPARISON_WORK},
                SearchCheck{input: inputs[0], pattern: Patterns::METHOD_IDEMPOTENT},
                SearchCheck{input: inputs[0], pattern: Patterns::RETRY_BACKOFF_CALL},
                SearchCheck{input: inputs[0], pattern: Patterns::TLS_PATH_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_HEADER},
                SearchCheck{input: inputs[0], pattern: Patterns::HEADER_VALUE_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_CONTROL_BYTE},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_TIMEOUT},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_RESPONSE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_RETRY_ATTEMPTS},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_RETRY_BACKOFF},
                SearchCheck{input: inputs[0], pattern: Patterns::NON_IDEMPOTENT_RETRY},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_TLS_BUNDLE},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_TLS_CLIENT_IDENTITY},
                SearchCheck{input: inputs[0], pattern: Patterns::TLS_PATH_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::CHUNK_SEQUENCE_MISMATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_BUFFER_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_NOT_COMPLETE},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_NOT_DRAINED},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_ACCOUNTING_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLING_OR_CANCELLED},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST_ACTIVE},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST_REQUIRES_ATTEMPT},
                SearchCheck{input: inputs[0], pattern: Patterns::ATTEMPTS_ABOVE_MAX},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_ATTEMPT_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_ACK},
                SearchCheck{input: inputs[0], pattern: Patterns::RETRY_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::SUCCESS_OUTCOME},
                SearchCheck{input: inputs[0], pattern: Patterns::STATUS_FAILURE_OUTCOME},
                SearchCheck{input: inputs[0], pattern: Patterns::STATUS_RANGE},
                SearchCheck{input: inputs[0], pattern: Patterns::STATUS_ZERO},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_POST},
                SearchCheck{input: inputs[2], pattern: Patterns::TLS_FAILURE_OUTCOME},
                SearchCheck{input: inputs[2], pattern: Patterns::IDEMPOTENT_ONLY},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_NON_IDEMPOTENT_RETRY},
                SearchCheck{input: inputs[2], pattern: Patterns::CUSTOM_BUNDLE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_TLS_BUNDLE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_CLIENT_IDENTITY},
                SearchCheck{input: inputs[2], pattern: Patterns::PAUSE_EVENT},
                SearchCheck{input: inputs[2], pattern: Patterns::FINISH_EVENT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CHUNK_SEQUENCE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STREAM_NOT_DRAINED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STREAM_ACCOUNTING},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_CANCELLING_STREAM},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CANCELLING_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CANCELLED_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_DUPLICATE_HEADER},
                SearchCheck{input: inputs[2], pattern: Patterns::DUPLICATE_COMPARISON_BOUNDED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_COMPARISON_LIMIT},
                SearchCheck{input: inputs[2], pattern: Patterns::REPEATED_RESPONSE_FIELDS},
                SearchCheck{input: inputs[2], pattern: Patterns::SESSION_TWO},
                SearchCheck{input: inputs[2], pattern: Patterns::PAGINATION_LINK},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_TIMEOUT},
                SearchCheck{input: inputs[2], pattern: Patterns::INVALID_STATUS},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_CANCELLED_STREAM},
                SearchCheck{input: inputs[2], pattern: Patterns::CASE_INSENSITIVE_HEADERS},
                SearchCheck{input: inputs[2], pattern: Patterns::CASE_INSENSITIVE_DUPLICATE},
                SearchCheck{input: inputs[2], pattern: Patterns::INVALID_HEADER_NAME},
                SearchCheck{input: inputs[2], pattern: Patterns::INVALID_HEADER_VALUE},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_SUCCESS_STATUS},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_FAILURE_STATUS},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_COMPLETED_OUTCOME},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_REQUEST},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_CONTRACT_ERROR},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_REQUEST}
            ]


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsNetworkModelAudit::run_default()
