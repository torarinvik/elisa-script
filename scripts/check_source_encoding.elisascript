# Streaming Elisascript port of check_source_encoding.sh.
# Keep the shell oracle until its public-launcher parity contract is qualified.

include "./shell_invocation_path.elisascript"

module EsSourceEncodingAudit:
    private:
        const module Inputs:
            SOURCE: sview = "src/ir/source.elisa"
            ENCODING: sview = "src/runtime/encoding.elisa"
            STREAM: sview = "src/runtime/stream_posix.elisa"
            DRIVER: sview = "src/driver/elisascript.elisa"
            TESTS: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            PARSER_DOCS: sview = "docs/parser.md"


        const module Patterns:
            ENCODING_MODULE: sview = "^module EsEncoding:$"
            UTF8_CURSOR: sview = "^        struct Utf8Cursor:$"
            UTF8_FEED: sview = "def utf8_feed\\("
            UTF8_VALIDATE: sview = "def utf8_validate\\("
            UTF8_COMPLETE: sview = "def utf8_complete\\("
            SOURCE_IMPORT: sview = "^using EsEncoding$"
            SOURCE_ERROR: sview = "^    InvalidUtf8$"
            SOURCE_VALIDATION: sview = "EsEncoding::utf8_validate\\(source, source_length"
            SOURCE_COMPLETION: sview = "EsEncoding::utf8_complete\\(source_cursor\\)"
            DRIVER_ERROR_NAME: sview = "return \"InvalidUtf8\" if failure == ElisascriptSourceError\\.InvalidUtf8"
            STREAM_CURSOR: sview = "EsEncoding::Utf8Cursor"
            STREAM_FEED: sview = "EsEncoding::utf8_feed"
            STREAM_VALIDATION: sview = "EsEncoding::utf8_validate"
            STRICT_ENCODING_TEST: sview = "typed_source_encoding_contract_is_strict"
            FOUR_BYTE_COMPLETION_TEST: sview = "EsEncoding::utf8_complete\\(four\\)"
            SURROGATE_TEST: sview = "utf8_feed\\(237u8, surrogate\\)"
            OUT_OF_RANGE_TEST: sview = "utf8_feed\\(244u8, out_of_range\\)"
            DOCS_ERROR: sview = "InvalidUtf8"
            PARSER_DOCS_ERROR: sview = "InvalidUtf8"


        const module Messages:
            MISSING_ROOT: sview = "source encoding audit: missing repository root"
            UNRESOLVED_ROOT: sview = "source encoding audit: unable to resolve repository root"
            MISSING_INPUT: sview = "source encoding audit: missing file: "
            RG_UNAVAILABLE: sview = "source encoding audit: unable to run rg"
            RG_FAILED_TO_RUN: sview = "source encoding audit: rg failed to run"


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[1], pattern: Patterns::ENCODING_MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::UTF8_CURSOR},
                SearchCheck{input: inputs[1], pattern: Patterns::UTF8_FEED},
                SearchCheck{input: inputs[1], pattern: Patterns::UTF8_VALIDATE},
                SearchCheck{input: inputs[1], pattern: Patterns::UTF8_COMPLETE},
                SearchCheck{input: inputs[0], pattern: Patterns::SOURCE_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::SOURCE_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::SOURCE_VALIDATION},
                SearchCheck{input: inputs[0], pattern: Patterns::SOURCE_COMPLETION},
                SearchCheck{input: inputs[3], pattern: Patterns::DRIVER_ERROR_NAME},
                SearchCheck{input: inputs[2], pattern: Patterns::STREAM_CURSOR},
                SearchCheck{input: inputs[2], pattern: Patterns::STREAM_FEED},
                SearchCheck{input: inputs[2], pattern: Patterns::STREAM_VALIDATION},
                SearchCheck{input: inputs[4], pattern: Patterns::STRICT_ENCODING_TEST},
                SearchCheck{input: inputs[4], pattern: Patterns::FOUR_BYTE_COMPLETION_TEST},
                SearchCheck{input: inputs[4], pattern: Patterns::SURROGATE_TEST},
                SearchCheck{input: inputs[4], pattern: Patterns::OUT_OF_RANGE_TEST},
                SearchCheck{input: inputs[5], pattern: Patterns::DOCS_ERROR},
                SearchCheck{input: inputs[6], pattern: Patterns::PARSER_DOCS_ERROR}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Environment.Read, File.Read, Directory.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            rg: Executable = try executable("rg") else err:
                diagnostic(Messages::RG_UNAVAILABLE)
                return 127i64
            for check in checks:
                arguments: darray[sview] = ["-q", check.pattern, f"{check.input}"]
                status: i64 = try run_process(rg, arguments, 0i64) else err:
                    diagnostic(Messages::RG_FAILED_TO_RUN)
                    return 127i64
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return 1i64
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::SOURCE),
                root.joinpath(Inputs::ENCODING),
                root.joinpath(Inputs::STREAM),
                root.joinpath(Inputs::DRIVER),
                root.joinpath(Inputs::TESTS),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::PARSER_DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return 2i64

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print("source encoding audit: one strict UTF-8 cursor serves source and stream boundaries")
            return 0i64


        def run_default() -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsSourceEncodingAudit::run_default()
