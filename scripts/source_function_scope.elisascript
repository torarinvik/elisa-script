# Bounded streaming scanner for line, full-text, and function-scope audits.
# Function extraction mirrors awk's indentation-delimited scope. Limits are
# explicit: 64 MiB source bytes, 1 MiB per line, and 16 MiB per function body.

include "../src/runtime/encoding.elisa"
include "../src/runtime/file_posix.elisa"
include "../src/runtime/directory_posix.elisa"
include "../src/runtime/stdio_posix.elisa"
include "../src/runtime/stream_posix.elisa"

using EsEncoding
using EsRuntime


module EsSourceFunctionScope:
    private:
        const module Limits:
            SOURCE_BYTES: usize = EsRuntime::FILE_STREAM_DEFAULT_MAX_BYTES
            LINE_BYTES: usize = 1048576
            FUNCTION_BODY_BYTES: usize = 16777216
            PATH_BYTES: usize = 4095


        const enum ScanPhase of u8:
            FindFunction
            CollectFunction
            Done


        const enum SearchPhase of u8:
            Scan
            Done


        const enum LineSearchPhase of u8:
            Scan
            Done


        def append_line(body: mutable darray[u8]&, line: darray[u8]) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if body.count >= Limits::FUNCTION_BODY_BYTES
            remaining_bytes: usize = Limits::FUNCTION_BODY_BYTES - body.count
            return false if line.count >= remaining_bytes
            for byte in line |body|:
                body.push(byte)
            body.push(10u8)
            return true


        def literal_occurrence_count(source: sview, needle: sview) -> usize:
            needle_length: usize = sview_len(needle)
            return 0 if needle_length == 0 or needle_length > sview_len(source)
            cursor: mutable usize = 0
            matches: mutable usize = 0
            source_length: usize = sview_len(source)
            while cursor <= source_length - needle_length:
                suffix: sview = string_view_suffix(source, cursor.i64())
                relative: i64 = suffix.index(needle)
                break if relative < 0
                matches <- matches + 1
                cursor <- cursor + relative.usize() + needle_length
            return matches


        def starts_function_declaration(line: sview) -> bool:
            declaration_prefix: sview = "        def "
            return false if sview_len(line) < sview_len(declaration_prefix)
            return string_view_prefix(line, sview_len(declaration_prefix).i64()) == declaration_prefix


    public:
        const enum Error of u8:
            InvalidPath
            OpenFailed
            ReadFailed
            FunctionTooLarge
            CloseFailed


        struct FunctionBody:
            found: bool
            text: sview


        def read_function_body(input_path: Path, declaration: sview) -> FunctionBody error[Error] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            path_text: sview = f"{input_path}"
            path_length: usize = sview_len(path_text)
            raise Error.InvalidPath if path_length == 0 or path_length > Limits::PATH_BYTES or declaration == "" or sview_contains_byte(path_text, 0u8)
            path_bytes: mutable darray[u8] = []
            for byte in path_text |path_bytes|:
                path_bytes.push(byte)
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr]

            stream: mutable FileStream = try file_stream_open(path_pointer, FileStreamMode.ReadBinary, Limits::SOURCE_BYTES, FileStreamEncoding.Bytes) else err:
                raise Error.OpenFailed
            phase: mutable ScanPhase = ScanPhase.FindFunction
            line: mutable darray[u8] = []
            body: mutable darray[u8] = []
            found: mutable bool = false
            machine over phase while phase != ScanPhase.Done:
                state Scan
                start Scan

                Scan, ScanPhase.FindFunction:
                    record: FileStreamRead = try file_stream_read_line(stream, line, Limits::LINE_BYTES) else err:
                        _ = try file_stream_close(stream) else false
                        raise Error.ReadFailed
                    if record.eof and record.count == 0:
                        phase <- ScanPhase.Done
                        -> Scan
                    line_text: sview = bytes_view(line)
                    if line_text.index(declaration) >= 0:
                        found <- true
                        phase <- ScanPhase.CollectFunction
                        if not append_line(body, line):
                            _ = try file_stream_close(stream) else false
                            raise Error.FunctionTooLarge
                    -> Scan

                Scan, ScanPhase.CollectFunction:
                    record: FileStreamRead = try file_stream_read_line(stream, line, Limits::LINE_BYTES) else err:
                        _ = try file_stream_close(stream) else false
                        raise Error.ReadFailed
                    if record.eof and record.count == 0:
                        phase <- ScanPhase.Done
                        -> Scan
                    line_text: sview = bytes_view(line)
                    if starts_function_declaration(line_text) and line_text.index(declaration) < 0:
                        if not append_line(body, line):
                            _ = try file_stream_close(stream) else false
                            raise Error.FunctionTooLarge
                        phase <- ScanPhase.Done
                        -> Scan
                    if not append_line(body, line):
                        _ = try file_stream_close(stream) else false
                        raise Error.FunctionTooLarge
                    -> Scan

                Scan, ScanPhase.Done:
                    break

            closed: bool = try file_stream_close(stream) else err:
                false
            raise Error.CloseFailed if not closed
            return FunctionBody{found: found, text: bytes_view(body)}


        # Search one physical source line at a time. Optional second and third
        # literals must occur in order after the first, matching the source
        # audits' `first.*second.*third` expressions without whole-file reads.
        def contains_file_line(input_path: Path, first: sview, second: sview = "", third: sview = "", line_prefix: bool = false) -> bool error[Error] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            path_text: sview = f"{input_path}"
            path_length: usize = sview_len(path_text)
            raise Error.InvalidPath if path_length == 0 or path_length > Limits::PATH_BYTES or first == "" or sview_contains_byte(path_text, 0u8) or sview_contains_byte(first, 0u8) or sview_contains_byte(second, 0u8) or sview_contains_byte(third, 0u8)
            path_bytes: mutable darray[u8] = []
            for byte in path_text |path_bytes|:
                path_bytes.push(byte)
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr]

            stream: mutable FileStream = try file_stream_open(path_pointer, FileStreamMode.ReadBinary, Limits::SOURCE_BYTES, FileStreamEncoding.Bytes) else err:
                raise Error.OpenFailed
            line: mutable darray[u8] = []
            found: mutable bool = false
            phase: mutable SearchPhase = SearchPhase.Scan
            machine over phase while phase != SearchPhase.Done:
                state Search
                start Search

                Search, SearchPhase.Scan:
                    record: FileStreamRead = try file_stream_read_line(stream, line, Limits::LINE_BYTES) else err:
                        _ = try file_stream_close(stream) else false
                        raise Error.ReadFailed
                    if record.eof and record.count == 0:
                        phase <- SearchPhase.Done
                        -> Search
                    line_text: sview = bytes_view(line)
                    first_match: mutable i64 = -1
                    if line_prefix:
                        first_match <- 0 if line_text.startswith(first)
                    else:
                        first_match <- line_text.index(first)
                    if first_match >= 0:
                        first_end: i64 = first_match + sview_len(first).i64()
                        second_match: mutable i64 = 0
                        if second != "":
                            second_match <- string_view_suffix(line_text, first_end).index(second)
                        if second_match >= 0:
                            second_end: mutable i64 = first_end
                            if second != "":
                                second_end <- first_end + second_match + sview_len(second).i64()
                            if third == "" or string_view_suffix(line_text, second_end).index(third) >= 0:
                                found <- true
                                phase <- SearchPhase.Done
                                -> Search
                    -> Search

                Search, SearchPhase.Done:
                    break

            closed: bool = try file_stream_close(stream) else err:
                false
            raise Error.CloseFailed if not closed
            return found


        # Count either matching source lines (`rg -F -c`) or non-overlapping
        # literal occurrences (`rg -F -o`) without materializing the file.
        def count_file_literal(input_path: Path, needle: sview, count_occurrences: bool = false) -> usize error[Error] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            path_text: sview = f"{input_path}"
            path_length: usize = sview_len(path_text)
            raise Error.InvalidPath if path_length == 0 or path_length > Limits::PATH_BYTES or needle == "" or sview_contains_byte(path_text, 0u8) or sview_contains_byte(needle, 0u8)
            path_bytes: mutable darray[u8] = []
            for byte in path_text |path_bytes|:
                path_bytes.push(byte)
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr]

            stream: mutable FileStream = try file_stream_open(path_pointer, FileStreamMode.ReadBinary, Limits::SOURCE_BYTES, FileStreamEncoding.Bytes) else err:
                raise Error.OpenFailed
            line: mutable darray[u8] = []
            matches: mutable usize = 0
            phase: mutable SearchPhase = SearchPhase.Scan
            machine over phase while phase != SearchPhase.Done:
                state Search
                start Search

                Search, SearchPhase.Scan:
                    record: FileStreamRead = try file_stream_read_line(stream, line, Limits::LINE_BYTES) else err:
                        _ = try file_stream_close(stream) else false
                        raise Error.ReadFailed
                    if record.eof and record.count == 0:
                        phase <- SearchPhase.Done
                        -> Search
                    occurrence_count: usize = literal_occurrence_count(bytes_view(line), needle)
                    if count_occurrences:
                        matches <- matches + occurrence_count
                    elif occurrence_count > 0:
                        matches <- matches + 1
                    -> Search

                Search, SearchPhase.Done:
                    break

            closed: bool = try file_stream_close(stream) else err:
                false
            raise Error.CloseFailed if not closed
            return matches


        # Search within a marker-delimited block, stopping before the next
        # indentation boundary. The required line prefix is literal; file and
        # line limits remain the same as other scans.
        def contains_file_block_line(input_path: Path, start_marker: sview, end_prefix: sview, needle: sview) -> bool error[Error] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            path_text: sview = f"{input_path}"
            path_length: usize = sview_len(path_text)
            raise Error.InvalidPath if path_length == 0 or path_length > Limits::PATH_BYTES or start_marker == "" or needle == "" or sview_contains_byte(path_text, 0u8) or sview_contains_byte(start_marker, 0u8) or sview_contains_byte(end_prefix, 0u8) or sview_contains_byte(needle, 0u8)
            path_bytes: mutable darray[u8] = []
            for byte in path_text |path_bytes|:
                path_bytes.push(byte)
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr]

            stream: mutable FileStream = try file_stream_open(path_pointer, FileStreamMode.ReadBinary, Limits::SOURCE_BYTES, FileStreamEncoding.Bytes) else err:
                raise Error.OpenFailed
            line: mutable darray[u8] = []
            found: mutable bool = false
            inside_block: mutable bool = false
            phase: mutable SearchPhase = SearchPhase.Scan
            machine over phase while phase != SearchPhase.Done:
                state Search
                start Search

                Search, SearchPhase.Scan:
                    record: FileStreamRead = try file_stream_read_line(stream, line, Limits::LINE_BYTES) else err:
                        _ = try file_stream_close(stream) else false
                        raise Error.ReadFailed
                    if record.eof and record.count == 0:
                        phase <- SearchPhase.Done
                        -> Search
                    line_text: sview = bytes_view(line)
                    if inside_block:
                        if end_prefix != "" and line_text.startswith(end_prefix):
                            phase <- SearchPhase.Done
                        elif line_text.startswith(needle):
                            found <- true
                            phase <- SearchPhase.Done
                    elif line_text.index(start_marker) >= 0:
                        inside_block <- true
                    -> Search

                Search, SearchPhase.Done:
                    break

            closed: bool = try file_stream_close(stream) else err:
                false
            raise Error.CloseFailed if not closed
            return found


        # Apply an Elisa Regex to each physical source line. This preserves
        # rg's line-oriented match boundary while keeping reads bounded.
        def contains_file_regex_line(input_path: Path, pattern: Regex) -> bool error[Error] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            path_text: sview = f"{input_path}"
            path_length: usize = sview_len(path_text)
            raise Error.InvalidPath if path_length == 0 or path_length > Limits::PATH_BYTES or sview_contains_byte(path_text, 0u8)
            path_bytes: mutable darray[u8] = []
            for byte in path_text |path_bytes|:
                path_bytes.push(byte)
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr]

            stream: mutable FileStream = try file_stream_open(path_pointer, FileStreamMode.ReadBinary, Limits::SOURCE_BYTES, FileStreamEncoding.Bytes) else err:
                raise Error.OpenFailed
            line: mutable darray[u8] = []
            found: mutable bool = false
            phase: mutable SearchPhase = SearchPhase.Scan
            machine over phase while phase != SearchPhase.Done:
                state Search
                start Search

                Search, SearchPhase.Scan:
                    record: FileStreamRead = try file_stream_read_line(stream, line, Limits::LINE_BYTES) else err:
                        _ = try file_stream_close(stream) else false
                        raise Error.ReadFailed
                    if record.eof and record.count == 0:
                        phase <- SearchPhase.Done
                        -> Search
                    if pattern.search(bytes_view(line)):
                        found <- true
                        phase <- SearchPhase.Done
                        -> Search
                    -> Search

                Search, SearchPhase.Done:
                    break

            closed: bool = try file_stream_close(stream) else err:
                false
            raise Error.CloseFailed if not closed
            return found


        # Search a bounded complete source buffer when a regex intentionally
        # spans line boundaries (the source bytes and LF delimiters are kept).
        def contains_file_regex_text(input_path: Path, pattern: Regex) -> bool error[Error] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            path_text: sview = f"{input_path}"
            path_length: usize = sview_len(path_text)
            raise Error.InvalidPath if path_length == 0 or path_length > Limits::PATH_BYTES or sview_contains_byte(path_text, 0u8)
            path_bytes: mutable darray[u8] = []
            for byte in path_text |path_bytes|:
                path_bytes.push(byte)
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr]

            stream: mutable FileStream = try file_stream_open(path_pointer, FileStreamMode.ReadBinary, Limits::SOURCE_BYTES, FileStreamEncoding.Bytes) else err:
                raise Error.OpenFailed
            line: mutable darray[u8] = []
            source: mutable darray[u8] = []
            phase: mutable SearchPhase = SearchPhase.Scan
            machine over phase while phase != SearchPhase.Done:
                state Search
                start Search

                Search, SearchPhase.Scan:
                    record: FileStreamRead = try file_stream_read_line(stream, line, Limits::LINE_BYTES) else err:
                        _ = try file_stream_close(stream) else false
                        raise Error.ReadFailed
                    if record.eof and record.count == 0:
                        phase <- SearchPhase.Done
                        -> Search
                    for byte in line |source|:
                        source.push(byte)
                    source.push(10u8) if not record.eof
                    phase <- SearchPhase.Done if record.eof
                    -> Search

                Search, SearchPhase.Done:
                    break

            closed: bool = try file_stream_close(stream) else err:
                false
            raise Error.CloseFailed if not closed
            return pattern.search(bytes_view(source))


        # Count nonoverlapping literal matches across a bounded byte stream.
        # Since a literal cannot span the line delimiter for the current audit
        # callers, summing per-line `rg -F -o` equivalents preserves its count.
        def occurrences_in_file(input_path: Path, needle: sview) -> usize error[Error] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            path_text: sview = f"{input_path}"
            path_length: usize = sview_len(path_text)
            raise Error.InvalidPath if path_length == 0 or path_length > Limits::PATH_BYTES or needle == "" or sview_contains_byte(path_text, 0u8) or sview_contains_byte(needle, 0u8)
            path_bytes: mutable darray[u8] = []
            for byte in path_text |path_bytes|:
                path_bytes.push(byte)
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr]

            stream: mutable FileStream = try file_stream_open(path_pointer, FileStreamMode.ReadBinary, Limits::SOURCE_BYTES, FileStreamEncoding.Bytes) else err:
                raise Error.OpenFailed
            line: mutable darray[u8] = []
            matches: mutable usize = 0
            phase: mutable SearchPhase = SearchPhase.Scan
            machine over phase while phase != SearchPhase.Done:
                state Search
                start Search

                Search, SearchPhase.Scan:
                    record: FileStreamRead = try file_stream_read_line(stream, line, Limits::LINE_BYTES) else err:
                        _ = try file_stream_close(stream) else false
                        raise Error.ReadFailed
                    if record.eof and record.count == 0:
                        phase <- SearchPhase.Done
                        -> Search
                    matches <- matches + literal_occurrence_count(bytes_view(line), needle)
                    -> Search

                Search, SearchPhase.Done:
                    break

            closed: bool = try file_stream_close(stream) else err:
                false
            raise Error.CloseFailed if not closed
            return matches


        # Count physical lines containing a literal at least once, matching
        # rg -F -c rather than counting repeated occurrences on one line.
        def matching_file_line_count(input_path: Path, needle: sview) -> usize error[Error] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            path_text: sview = f"{input_path}"
            path_length: usize = sview_len(path_text)
            raise Error.InvalidPath if path_length == 0 or path_length > Limits::PATH_BYTES or needle == "" or sview_contains_byte(path_text, 0u8) or sview_contains_byte(needle, 0u8)
            path_bytes: mutable darray[u8] = []
            for byte in path_text |path_bytes|:
                path_bytes.push(byte)
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr]

            stream: mutable FileStream = try file_stream_open(path_pointer, FileStreamMode.ReadBinary, Limits::SOURCE_BYTES, FileStreamEncoding.Bytes) else err:
                raise Error.OpenFailed
            line: mutable darray[u8] = []
            matches: mutable usize = 0
            phase: mutable SearchPhase = SearchPhase.Scan
            machine over phase while phase != SearchPhase.Done:
                state Search
                start Search

                Search, SearchPhase.Scan:
                    record: FileStreamRead = try file_stream_read_line(stream, line, Limits::LINE_BYTES) else err:
                        _ = try file_stream_close(stream) else false
                        raise Error.ReadFailed
                    if record.eof and record.count == 0:
                        phase <- SearchPhase.Done
                        -> Search
                    matches <- matches + 1 if bytes_view(line).index(needle) >= 0
                    -> Search

                Search, SearchPhase.Done:
                    break

            closed: bool = try file_stream_close(stream) else err:
                false
            raise Error.CloseFailed if not closed
            return matches


        def contains(source: sview, needle: sview) -> bool:
            return source.index(needle) >= 0


        def first_line_number(source: sview, needle: sview) -> usize:
            return 0 if needle == ""
            source_length: usize = sview_len(source)
            line_start: mutable usize = 0
            line_number: mutable usize = 0
            matched_line: mutable usize = 0
            phase: mutable LineSearchPhase = LineSearchPhase.Scan
            machine over phase while phase != LineSearchPhase.Done:
                state Scan
                start Scan

                Scan, LineSearchPhase.Scan if line_start >= source_length:
                    phase <- LineSearchPhase.Done
                    -> Scan

                Scan, LineSearchPhase.Scan:
                    line_end: mutable usize = line_start
                    while line_end < source_length and sview_at(source, line_end) != 10u8:
                        line_end <- line_end + 1
                    line_length: usize = line_end - line_start
                    line: sview = string_view_prefix(string_view_suffix(source, line_start.i64()), line_length.i64())
                    line_number <- line_number + 1
                    if line.index(needle) >= 0:
                        matched_line <- line_number
                        phase <- LineSearchPhase.Done
                        -> Scan
                    line_start <- line_end + 1
                    -> Scan

                Scan, LineSearchPhase.Done:
                    break
            return matched_line


        def last_line_number(source: sview, needle: sview) -> usize:
            return 0 if needle == ""
            source_length: usize = sview_len(source)
            line_start: mutable usize = 0
            line_number: mutable usize = 0
            matched_line: mutable usize = 0
            phase: mutable LineSearchPhase = LineSearchPhase.Scan
            machine over phase while phase != LineSearchPhase.Done:
                state Scan
                start Scan

                Scan, LineSearchPhase.Scan if line_start >= source_length:
                    phase <- LineSearchPhase.Done
                    -> Scan

                Scan, LineSearchPhase.Scan:
                    line_end: mutable usize = line_start
                    while line_end < source_length and sview_at(source, line_end) != 10u8:
                        line_end <- line_end + 1
                    line_length: usize = line_end - line_start
                    line: sview = string_view_prefix(string_view_suffix(source, line_start.i64()), line_length.i64())
                    line_number <- line_number + 1
                    matched_line <- line_number if line.index(needle) >= 0
                    line_start <- line_end + 1
                    -> Scan

                Scan, LineSearchPhase.Done:
                    break
            return matched_line


        def matching_line_count(source: sview, needle: sview) -> usize:
            return 0 if needle == ""
            line_start: mutable usize = 0
            matches: mutable usize = 0
            source_length: usize = sview_len(source)
            while line_start < source_length:
                line_end: mutable usize = line_start
                while line_end < source_length and sview_at(source, line_end) != 10u8:
                    line_end <- line_end + 1
                line_length: usize = line_end - line_start
                line: sview = string_view_prefix(string_view_suffix(source, line_start.i64()), line_length.i64())
                matches <- matches + 1 if line.index(needle) >= 0
                line_start <- line_end + 1
            return matches
