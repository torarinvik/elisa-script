# Bounded Elisascript port of check_test_runner.sh.
# Fixed-string audits preserve cross-file hash searches and forbidden-pattern checks.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsTestRunnerAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/test_runner_model.elisa"
            HASH_MODEL: sview = "src/runtime/hash_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            EXECUTION: sview = "src/ir/execution.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "module EsTestRunner:"
            LIMITS: sview = "const module Limits:"
            RETRY_POLICY: sview = "const enum TestRetryPolicy of u8"
            RUNNER_STATE: sview = "const enum TestRunnerState of u8"
            CASE_STATE: sview = "const enum TestCaseState of u8"
            OUTCOME: sview = "const enum TestOutcome of u8"
            RUNNER_EVENT: sview = "const enum TestRunnerEvent of u8"
            SPEC: sview = "struct TestSpec:"
            RESULT: sview = "struct TestResult:"
            CASE: sview = "struct TestCase:"
            RUNNER: sview = "struct TestRunner:"
            RUNNER_ERROR: sview = "error TestRunnerError:"
            VALIDATE_RUNNER: sview = "def validate_test_runner("
            ADVANCE_RUNNER: sview = "def advance_test_runner("
            TESTS_LIMIT: sview = "Limits::TESTS"
            NAME_BYTES_LIMIT: sview = "Limits::NAME_BYTES"
            SELECTION_REASON_LIMIT: sview = "Limits::SELECTION_REASON_BYTES"
            SELECTION_REASON_BUDGET: sview = "test_runner_selection_reason_budget_valid"
            SELECTION_OUTPUT_BYTES: sview = "test_runner_selection_output_bytes"
            COMPLETION_OUTPUT_BYTES: sview = "test_runner_completion_output_bytes"
            BULK_TRANSITION_OUTPUT_BYTES: sview = "test_runner_bulk_transition_output_bytes"
            SELECTION_REASON_EXCEEDED: sview = "TestRunnerError.SelectionReasonLimitExceeded"
            OUTPUT_LIMIT_EXCEEDED: sview = "TestRunnerError.OutputLimitExceeded"
            MESSAGE_BYTES_LIMIT: sview = "Limits::MESSAGE_BYTES"
            ATTEMPTS_LIMIT: sview = "Limits::ATTEMPTS"
            PARALLEL_LIMIT: sview = "Limits::PARALLEL"
            OUTPUT_BYTES_LIMIT: sview = "Limits::OUTPUT_BYTES"
            REFRESH_ACCOUNTING: sview = "test_runner_refresh_accounting"
            ACCOUNTING_MATCHES: sview = "test_runner_accounting_matches"
            ALL_TERMINAL: sview = "test_runner_all_terminal"
            OUTCOME_RETRYABLE: sview = "test_outcome_retryable"
            RESULT_UNPUBLISHED_VALID: sview = "test_result_unpublished_valid"
            DUPLICATE_TEST_ID: sview = "TestRunnerError.DuplicateTestId"
            DUPLICATE_TEST_NAME: sview = "TestRunnerError.DuplicateTestName"
            STALE_ATTEMPT: sview = "TestRunnerError.StaleAttempt"
            ATTEMPT_LIMIT_EXCEEDED: sview = "TestRunnerError.AttemptLimitExceeded"
            PARALLEL_LIMIT_EXCEEDED: sview = "TestRunnerError.ParallelLimitExceeded"
            COMPLETION_NOT_READY: sview = "TestRunnerError.CompletionNotReady"
            REPORT_NOT_READY: sview = "TestRunnerError.ReportNotReady"
            CANCEL_NOT_READY: sview = "TestRunnerError.CancelNotReady"
            DOCUMENT_BEGIN: sview = "OutputDocumentEvent.Begin"
            DOCUMENT_APPEND: sview = "OutputDocumentEvent.Append"
            DOCUMENT_SEAL: sview = "OutputDocumentEvent.Seal"
            ATTEMPT_TOKEN: sview = "attempt_token"
            SPAWN_FAILURE: sview = "ProcessResultKind.SpawnFailure"
            STOPPED_AFTER_FAILURE: sview = "runner stopped after test failure"
            PROCESS_ERROR_TEXT: sview = "process.error_text"
            EFFECTIVE_MESSAGE: sview = "effective_message"
            FLAKY_RETRY: sview = "TestOutcome.Flaky and attempts < 2"
            FLAKY_STATUS: sview = "OutputStatus.Flaky if case.state == TestCaseState.Flaky"
            FAILURE_LATCHED: sview = "failure_latched"
            CANCELLATION_REQUESTED: sview = "cancellation_requested"
            HASH_WRAPPING_MULTIPLY: sview = "def hash_wrapping_multiply_u64(left: u64, right: u64) -> u64:"
            HASH_LOW_PRODUCT: sview = "def hash_multiply_low64(left: u64, right: u64) -> u64:"
            HASH_LOW_PRODUCT_STATEMENT: sview = "low_product: u64 = left_low * right_low"
            HASH_MIX_A: sview = "EsHash::hash_wrapping_multiply_u64(mixed ^ (mixed >> 30), TestIndex::MIX_A)"
            HASH_MIX_B: sview = "EsHash::hash_wrapping_multiply_u64(mixed ^ (mixed >> 27), TestIndex::MIX_B)"
            HASH_FNV_PRIME: sview = "EsHash::hash_wrapping_multiply_u64(hash ^ byte.u64(), TestIndex::FNV_PRIME)"
            UNCHECKED_MIX_A: sview = "mixed <- (mixed ^ (mixed >> 30)) * TestIndex::MIX_A"
            UNCHECKED_MIX_B: sview = "mixed <- (mixed ^ (mixed >> 27)) * TestIndex::MIX_B"
            UNCHECKED_FNV: sview = "hash <- (hash ^ byte.u64()) * TestIndex::FNV_PRIME"
            HASH_IMPORT: sview = "include \"../runtime/hash_model.elisa\""
            RUNNER_IMPORT: sview = "include \"../runtime/test_runner_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsTestRunner"
            RUNNER_CONTRACT: sview = "typed_test_runner_contract_discovers_retries_and_seals_reports"
            SELECTION_OUTPUT_FAILURE_ATOMIC: sview = "typed_test_runner_selection_output_limit_failure_is_atomic"
            COMPLETION_OUTPUT_LIMIT_ATOMIC: sview = "typed_test_runner_completion_output_limit_does_not_consume_attempt"
            FAIL_FAST_PREFLIGHT: sview = "typed_test_runner_fail_fast_output_preflight_includes_queued_cancellations"
            FAIL_CANCEL_LIMITS_ATOMIC: sview = "typed_test_runner_fail_and_cancel_output_limits_are_atomic"
            FAIL_PREFLIGHT_RETRYABLE: sview = "typed_test_runner_fail_preflight_preserves_retryable_attempt_on_limit_error"
            ACTIVE_CANCEL_PREFLIGHT: sview = "typed_test_runner_active_cancel_preflight_preserves_retryable_attempt"
            FIXTURE_OUTPUT_LIMIT: sview = "TestRunnerError.OutputLimitExceeded"
            DISCOVER_EVENT: sview = "TestRunnerEvent.Discover"
            SELECTION_DONE_EVENT: sview = "TestRunnerEvent.SelectionDone"
            LAUNCH_EVENT: sview = "TestRunnerEvent.Launch"
            COMPLETE_EVENT: sview = "TestRunnerEvent.Complete"
            RETRY_EVENT: sview = "TestRunnerEvent.Retry"
            FAIL_EVENT: sview = "TestRunnerEvent.Fail"
            BEGIN_REPORT_EVENT: sview = "TestRunnerEvent.BeginReport"
            SEAL_REPORT_EVENT: sview = "TestRunnerEvent.SealReport"
            FIXTURE_STALE_ATTEMPT: sview = "TestRunnerError.StaleAttempt"
            RETRYABLE_STATE: sview = "TestCaseState.Retryable"
            FLAKY_STATE: sview = "TestCaseState.Flaky"
            LATCHES_FAILURES: sview = "typed_test_runner_contract_latches_exhausted_failures_and_unexpected_cancellation"
            FAILED_STATE: sview = "TestRunnerState.Failed"
            ERROR_OUTCOME: sview = "TestOutcome.Error"
            SEALED_DOCUMENT: sview = "OutputDocumentState.Sealed"
            FORGED_HIDDEN_FAILURE: sview = "forged_hidden_failure"
            FORGED_REPORTING_FAILURE: sview = "forged_reporting_failure"
            DOCS_RUNNER: sview = "`EsTestRunner` builds the test/CI layer"
            LEDGER_TEST: sview = "ES-TEST-001"


        const module Messages:
            MISSING_ROOT: sview = "test runner audit: missing repository root"
            UNRESOLVED_ROOT: sview = "test runner audit: unable to resolve repository root"
            MISSING_INPUT: sview = "test runner audit: missing "
            READ_FAILED: sview = "test runner audit: unable to read source: "
            HASH_MULTIPLY_REGRESSION: sview = "test runner audit: hash path regressed to checked-overflow multiplication"
            SUCCESS: sview = "test runner audit: bounded discovery, selection, retries, cancellation, and sealed reports are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches_before_hash(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMITS},
                SearchCheck{input: inputs[0], pattern: Patterns::RETRY_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::RUNNER_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::CASE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTCOME},
                SearchCheck{input: inputs[0], pattern: Patterns::RUNNER_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::SPEC},
                SearchCheck{input: inputs[0], pattern: Patterns::RESULT},
                SearchCheck{input: inputs[0], pattern: Patterns::CASE},
                SearchCheck{input: inputs[0], pattern: Patterns::RUNNER},
                SearchCheck{input: inputs[0], pattern: Patterns::RUNNER_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_RUNNER},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE_RUNNER},
                SearchCheck{input: inputs[0], pattern: Patterns::TESTS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_BYTES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::SELECTION_REASON_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::SELECTION_REASON_BUDGET},
                SearchCheck{input: inputs[0], pattern: Patterns::SELECTION_OUTPUT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETION_OUTPUT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::BULK_TRANSITION_OUTPUT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::SELECTION_REASON_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::MESSAGE_BYTES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::ATTEMPTS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::PARALLEL_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_BYTES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::REFRESH_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTING_MATCHES},
                SearchCheck{input: inputs[0], pattern: Patterns::ALL_TERMINAL},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTCOME_RETRYABLE},
                SearchCheck{input: inputs[0], pattern: Patterns::RESULT_UNPUBLISHED_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_TEST_ID},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_TEST_NAME},
                SearchCheck{input: inputs[0], pattern: Patterns::STALE_ATTEMPT},
                SearchCheck{input: inputs[0], pattern: Patterns::ATTEMPT_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::PARALLEL_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETION_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::REPORT_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::DOCUMENT_BEGIN},
                SearchCheck{input: inputs[0], pattern: Patterns::DOCUMENT_APPEND},
                SearchCheck{input: inputs[0], pattern: Patterns::DOCUMENT_SEAL},
                SearchCheck{input: inputs[0], pattern: Patterns::ATTEMPT_TOKEN},
                SearchCheck{input: inputs[0], pattern: Patterns::SPAWN_FAILURE},
                SearchCheck{input: inputs[0], pattern: Patterns::STOPPED_AFTER_FAILURE},
                SearchCheck{input: inputs[0], pattern: Patterns::PROCESS_ERROR_TEXT},
                SearchCheck{input: inputs[0], pattern: Patterns::EFFECTIVE_MESSAGE},
                SearchCheck{input: inputs[0], pattern: Patterns::FLAKY_RETRY},
                SearchCheck{input: inputs[0], pattern: Patterns::FLAKY_STATUS},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILURE_LATCHED},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLATION_REQUESTED}
            ]


        def hash_invariants(inputs: darray[Path]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            patterns: darray[sview] = [
                Patterns::HASH_WRAPPING_MULTIPLY,
                Patterns::HASH_LOW_PRODUCT,
                Patterns::HASH_LOW_PRODUCT_STATEMENT,
                Patterns::HASH_MIX_A,
                Patterns::HASH_MIX_B,
                Patterns::HASH_FNV_PRIME
            ]
            for pattern in patterns:
                hash_model_found: bool = try EsSourceFunctionScope::contains_file_line(inputs[1], pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{inputs[1]}")
                    return ExitStatus::IO_FAILURE
                if not hash_model_found:
                    runner_model_found: bool = try EsSourceFunctionScope::contains_file_line(inputs[0], pattern) else err:
                        diagnostic(Messages::READ_FAILED + f"{inputs[0]}")
                        return ExitStatus::IO_FAILURE
                    return ExitStatus::FAILURE if not runner_model_found
            return 0i64


        def reject_unchecked_hash_multiplication(model_path: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            patterns: darray[sview] = [
                Patterns::UNCHECKED_MIX_A,
                Patterns::UNCHECKED_MIX_B,
                Patterns::UNCHECKED_FNV
            ]
            for pattern in patterns:
                found: bool = try EsSourceFunctionScope::contains_file_line(model_path, pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{model_path}")
                    return ExitStatus::IO_FAILURE
                if found:
                    diagnostic(Messages::HASH_MULTIPLY_REGRESSION)
                    return ExitStatus::FAILURE
            return 0i64


        def searches_after_hash(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[2], pattern: Patterns::HASH_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::HASH_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::RUNNER_IMPORT},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[4], pattern: Patterns::RUNNER_CONTRACT},
                SearchCheck{input: inputs[4], pattern: Patterns::SELECTION_OUTPUT_FAILURE_ATOMIC},
                SearchCheck{input: inputs[4], pattern: Patterns::COMPLETION_OUTPUT_LIMIT_ATOMIC},
                SearchCheck{input: inputs[4], pattern: Patterns::FAIL_FAST_PREFLIGHT},
                SearchCheck{input: inputs[4], pattern: Patterns::FAIL_CANCEL_LIMITS_ATOMIC},
                SearchCheck{input: inputs[4], pattern: Patterns::FAIL_PREFLIGHT_RETRYABLE},
                SearchCheck{input: inputs[4], pattern: Patterns::ACTIVE_CANCEL_PREFLIGHT},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_OUTPUT_LIMIT},
                SearchCheck{input: inputs[4], pattern: Patterns::DISCOVER_EVENT},
                SearchCheck{input: inputs[4], pattern: Patterns::SELECTION_DONE_EVENT},
                SearchCheck{input: inputs[4], pattern: Patterns::LAUNCH_EVENT},
                SearchCheck{input: inputs[4], pattern: Patterns::COMPLETE_EVENT},
                SearchCheck{input: inputs[4], pattern: Patterns::RETRY_EVENT},
                SearchCheck{input: inputs[4], pattern: Patterns::FAIL_EVENT},
                SearchCheck{input: inputs[4], pattern: Patterns::BEGIN_REPORT_EVENT},
                SearchCheck{input: inputs[4], pattern: Patterns::SEAL_REPORT_EVENT},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_STALE_ATTEMPT},
                SearchCheck{input: inputs[4], pattern: Patterns::RETRYABLE_STATE},
                SearchCheck{input: inputs[4], pattern: Patterns::FLAKY_STATE},
                SearchCheck{input: inputs[4], pattern: Patterns::LATCHES_FAILURES},
                SearchCheck{input: inputs[4], pattern: Patterns::FAILED_STATE},
                SearchCheck{input: inputs[4], pattern: Patterns::ERROR_OUTCOME},
                SearchCheck{input: inputs[4], pattern: Patterns::SEALED_DOCUMENT},
                SearchCheck{input: inputs[4], pattern: Patterns::FORGED_HIDDEN_FAILURE},
                SearchCheck{input: inputs[4], pattern: Patterns::FORGED_REPORTING_FAILURE},
                SearchCheck{input: inputs[5], pattern: Patterns::DOCS_RUNNER},
                SearchCheck{input: inputs[6], pattern: Patterns::LEDGER_TEST}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                found: bool = try EsSourceFunctionScope::contains_file_line(check.input, check.pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return ExitStatus::IO_FAILURE
                return ExitStatus::FAILURE if not found
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::HASH_MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::EXECUTION),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: mutable i64 = execute(searches_before_hash(inputs))
            return status if status != 0i64

            status <- hash_invariants(inputs)
            return status if status != 0i64

            status <- reject_unchecked_hash_multiplication(inputs[0])
            return status if status != 0i64

            status <- execute(searches_after_hash(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsTestRunnerAudit::run_default()
