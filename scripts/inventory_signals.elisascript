# Read-only signal inventory. Paths are discovered as data and are never
# opened, parsed, imported, or executed. `rg`, `find`, and `sort` remain explicit
# host-tool dependencies; all orchestration uses typed, shell-free argv calls.

module EsInventorySignals:
    private:
        const module Limits:
            REGULAR_FILES: usize = 200000
            # Post-capture acceptance ceilings, not pre-allocation RSS guards.
            # Leave room for NUL separators below ProcessCapture's 64 MiB limit.
            TOTAL_PATH_BYTES: usize = 62914560
            OUTPUT_BYTES: usize = 67108864
            MAX_FILE_BYTES: sview = "8M"


        const module Output:
            HEADER: sview = "path\tsignal\tdetail"
            EXECUTABLE_SIGNAL: sview = "executable-file"
            EXECUTABLE_DETAIL: sview = "permission bit; inspect file type and shebang before classifying"
            SHEBANG_SIGNAL: sview = "legacy-shebang"
            SHEBANG_DETAIL: sview = "interpreter shebang; review runtime, argv, cwd, environment, and exit behavior"
            INLINE_SIGNAL: sview = "inline-legacy-invocation"
            INLINE_DETAIL: sview = "content references python/perl/awk command syntax; inspect callers and embedded program text"


        const module Patterns:
            SHEBANG: sview = "^[[:space:]]*#![[:space:]]*(/[^[:space:]]*/)?(env[[:space:]]+)?(python3?|pypy3?|perl|awk|gawk|mawk|sh|bash|zsh|fish)([[:space:]]|$)"
            INLINE: sview = "(^|[^[:alnum:]_])(python3?|pypy3?)[[:space:]]+-c([[:space:]]|$)|(^|[^[:alnum:]_])perl[[:space:]]+-e([[:space:]]|$)|(^|[^[:alnum:]_])(g?awk|mawk)([[:space:]]|$)"


        struct CountResult:
            count: usize = 0
            failure: sview = ""


        def path_is_tsv_safe(value: sview) -> bool:
            return value.index("\t") < 0 and value.index("\r") < 0 and value.index("\n") < 0


        def excluded_directory_name(name: sview) -> bool:
            return name == ".git" or name == "node_modules" or name == ".venv" or name == "__pycache__" or name == "vendor" or name == "third_party"


        def executable_at_path_entry(directory: sview, name: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Read]:
            candidate: Path = path(name) if directory == "" else path_join(path(directory), name)
            return is_file(candidate) and is_executable(candidate)


        def executable_found_on_path(name: sview) -> bool can[Memory.Allocate, Abort.Panic, Environment.Read, File.Read]:
            path_text: sview = try getenv("PATH", "/usr/bin:/bin") else err:
                "/usr/bin:/bin"
            path_entries: darray[sview] = split(path_text, ":")
            return any directory in path_entries where executable_at_path_entry(directory, name)


        def first_missing_required_tool() -> sview can[Memory.Allocate, Abort.Panic, Environment.Read, File.Read]:
            required_tools: darray[sview] = ["find", "rg", "sort"]
            for name in required_tools:
                if not executable_found_on_path(name):
                    return name
            return ""


        # Match Bash `cd -L` before shared physical-root resolution: normalize
        # `..` before resolving symlink components, and only trust inherited
        # PWD for relative roots when it names the actual cwd.
        def logical_root_operand(requested_root: sview) -> sview can[Memory.Allocate, Abort.Panic, Environment.Read, File.Read]:
            requested_path: Path = path(requested_root)
            if path_is_absolute(requested_path):
                normalized_absolute: Path = path_normalize(requested_path)
                return f"{normalized_absolute}"

            physical_cwd: Path = try current_directory() else err:
                return ""
            logical_cwd: mutable sview = f"{physical_cwd}"
            inherited_pwd: sview = try getenv("PWD", "") else err:
                ""
            if inherited_pwd.startswith("/"):
                resolved_pwd: Path = try path_real(path(inherited_pwd)) else err:
                    physical_cwd
                logical_cwd <- inherited_pwd if resolved_pwd == physical_cwd

            joined_root: Path = path_join(path(logical_cwd), requested_root)
            normalized_root: Path = path_normalize(joined_root)
            return f"{normalized_root}"


        def append_row(rows: mutable darray[sview]&, output_bytes: mutable usize&, row: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            row_bytes: usize = len(row) + 1
            return false if output_bytes > Limits::OUTPUT_BYTES or row_bytes > Limits::OUTPUT_BYTES - output_bytes
            rows.push(row)
            output_bytes <- output_bytes + row_bytes
            return true


        def signal_row(path_text: sview, signal: sview, detail: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return path_text + "\t" + signal + "\t" + detail


        def validate_count_output(output: sview, root: sview) -> CountResult can[Memory.Allocate, Abort.Panic]:
            count: mutable usize = 0
            total_path_bytes: mutable usize = 0
            record_start: mutable usize = 0
            for cursor in 0..<len(output) |count, total_path_bytes, record_start|:
                if sview_at(output, cursor) == 0u8:
                    path_text: sview = output[record_start:cursor]
                    if path_text == "":
                        return CountResult{failure: "inventory_signals: malformed NUL-delimited file list under " + root}
                    if not path_is_tsv_safe(path_text):
                        return CountResult{failure: "inventory_signals: path contains a TSV delimiter or line break under " + root}
                    path_bytes: usize = cursor - record_start
                    if total_path_bytes > Limits::TOTAL_PATH_BYTES or path_bytes > Limits::TOTAL_PATH_BYTES - total_path_bytes:
                        return CountResult{failure: "inventory_signals: aggregate path bytes exceed limit (62914560) under " + root}
                    total_path_bytes <- total_path_bytes + path_bytes
                    count <- count + 1
                    record_start <- cursor + 1
            if record_start != len(output):
                return CountResult{failure: "inventory_signals: malformed NUL-delimited file list under " + root}
            return CountResult{count: count}


        def append_nul_rows(output: sview, root: sview, signal: sview, detail: sview, rows: mutable darray[sview]&, output_bytes: mutable usize&) -> sview can[Memory.Allocate, Abort.Panic]:
            record_start: mutable usize = 0
            for cursor in 0..<len(output) |record_start, rows, output_bytes|:
                if sview_at(output, cursor) == 0u8:
                    path_text: sview = output[record_start:cursor]
                    if path_text == "":
                        return "inventory_signals: malformed NUL-delimited file list under " + root
                    if not path_is_tsv_safe(path_text):
                        return "inventory_signals: path contains a TSV delimiter or line break under " + root
                    row: sview = signal_row(path_text, signal, detail)
                    return "inventory_signals: manifest output exceeds limit (67108864)" if not append_row(rows, output_bytes, row)
                    record_start <- cursor + 1
            return "inventory_signals: malformed NUL-delimited file list under " + root if record_start != len(output)
            return ""


        def find_base_arguments(root: sview) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            arguments: mutable darray[sview] = [
                "-P", root,
                "(",
                "-path", "*/.git",
                "-o", "-path", "*/node_modules",
                "-o", "-path", "*/.venv",
                "-o", "-path", "*/__pycache__",
                "-o", "-path", "*/vendor",
                "-o", "-path", "*/third_party",
                ")", "-prune", "-o", "-type", "f"
            ]
            return arguments


        def count_regular_files(root: sview) -> CountResult can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Process.Run]:
            arguments: mutable darray[sview] = find_base_arguments(root)
            arguments.push("-print0")
            capture: ProcessCapture = try capture_process_result_with_environment(exe"find", arguments, "", {"LC_ALL": "C"}) else err:
                return CountResult{failure: "inventory_signals: unable to count regular files under " + root}
            if capture.status != 0:
                return CountResult{failure: "inventory_signals: unable to count regular files under " + root}
            return validate_count_output(capture.stdout, root)


        def append_executable_rows(root: sview, rows: mutable darray[sview]&, output_bytes: mutable usize&) -> sview can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Process.Run]:
            arguments: mutable darray[sview] = find_base_arguments(root)
            arguments.push("-perm")
            arguments.push("-111")
            arguments.push("-print0")
            capture: ProcessCapture = try capture_process_result_with_environment(exe"find", arguments, "", {"LC_ALL": "C"}) else err:
                return "inventory_signals: executable-file traversal failed for " + root
            if capture.status != 0:
                return "inventory_signals: executable-file traversal failed for " + root
            return append_nul_rows(capture.stdout, root, Output::EXECUTABLE_SIGNAL, Output::EXECUTABLE_DETAIL, rows, output_bytes)


        def ripgrep_arguments(root: sview, pattern: sview) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            return [
                "-l", "--hidden", "--no-messages", "--null",
                "--max-filesize", Limits::MAX_FILE_BYTES,
                "--glob", "!.git/**",
                "--glob", "!**/node_modules/**",
                "--glob", "!**/.venv/**",
                "--glob", "!**/__pycache__/**",
                "--glob", "!**/vendor/**",
                "--glob", "!**/third_party/**",
                pattern,
                root
            ]


        def append_ripgrep_rows(root: sview, pattern: sview, signal: sview, detail: sview, failure_message: sview, rows: mutable darray[sview]&, output_bytes: mutable usize&) -> sview can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Process.Run]:
            arguments: darray[sview] = ripgrep_arguments(root, pattern)
            capture: ProcessCapture = try capture_process_result_with_environment(exe"rg", arguments, "", {"LC_ALL": "C"}) else err:
                return failure_message + root
            if capture.status != 0 and capture.status != 1:
                return failure_message + root
            if capture.status == 0:
                return append_nul_rows(capture.stdout, root, signal, detail, rows, output_bytes)
            return ""


    public:
        def run(root: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, File.Read, Directory.Read, Process.Run]:
            if not path_is_tsv_safe(root):
                eprint("inventory_signals: scan root contains a TSV delimiter or line break")
                return 2i64
            if not is_directory(path(root)):
                eprint("inventory_signals: scan root does not exist: " + root)
                return 2i64

            logical_root: sview = logical_root_operand(root)
            if logical_root == "":
                eprint("inventory_signals: unable to resolve scan root")
                return 3i64
            resolved_root_path: Path = try path_real(path(logical_root)) else err:
                eprint("inventory_signals: unable to resolve scan root")
                return 3i64
            scan_root: sview = f"{resolved_root_path}"
            if not path_is_tsv_safe(scan_root):
                eprint("inventory_signals: scan root contains a TSV delimiter or line break")
                return 2i64

            # Match find's pruning rule even when the excluded directory is
            # itself the requested root; rg's root-relative globs alone do not
            # reliably express that boundary.
            if excluded_directory_name(path(scan_root).name()):
                println(Output::HEADER)
                return 0i64

            missing_tool: sview = first_missing_required_tool()
            if missing_tool != "":
                eprint("inventory_signals: required tool not found: " + missing_tool)
                return 127i64

            count: CountResult = count_regular_files(scan_root)
            if count.failure != "":
                eprint(count.failure)
                return 3i64
            if count.count > Limits::REGULAR_FILES:
                eprint("inventory_signals: root contains " + f"{count.count}" + " regular files; split the root (limit 200000)")
                return 3i64

            rows: mutable darray[sview] = []
            output_bytes: mutable usize = len(Output::HEADER) + 1
            failure: sview = append_executable_rows(scan_root, rows, output_bytes)
            if failure != "":
                eprint(failure)
                return 3i64
            failure <- append_ripgrep_rows(scan_root, Patterns::SHEBANG, Output::SHEBANG_SIGNAL, Output::SHEBANG_DETAIL, "inventory_signals: shebang search failed for ", rows, output_bytes)
            if failure != "":
                eprint(failure)
                return 3i64
            failure <- append_ripgrep_rows(scan_root, Patterns::INLINE, Output::INLINE_SIGNAL, Output::INLINE_DETAIL, "inventory_signals: inline-invocation search failed for ", rows, output_bytes)
            if failure != "":
                eprint(failure)
                return 3i64

            sort_input: sview = join(rows, "\n")
            if rows.count > 0:
                sort_input <- sort_input + "\n"
            # Match the shell oracle's independently written header and
            # externally visible sort streams/status, including sort failures.
            println(Output::HEADER)
            sorted_capture: ProcessCapture = try capture_process_result_with_environment(exe"sort", ["-u"], sort_input, {"LC_ALL": "C"}) else err:
                eprint("inventory_signals: unable to sort signal rows")
                return 3i64
            _ = write_stdout(sorted_capture.stdout)
            _ = write_stderr(sorted_capture.stderr)
            return sorted_capture.status


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Console.Write, Environment.Read, Directory.Read, File.Read, Process.Run]:
    if arguments.count > 1:
        eprint("usage: inventory_signals.sh [CODING_PROJECTS_ROOT]")
        return 2i64

    root: mutable sview = ""
    if arguments.count == 1 and arguments[0] != "":
        root <- arguments[0]
    else:
        script_path: Path = Script::source_path()
        # The shell reference uses logical `cd` before physical root
        # resolution: normalize `..` before resolving symlink components.
        script_directory: Path = try path_absolute(path_parent(script_path)) else err:
            eprint("inventory_signals: unable to resolve script directory")
            return 3i64
        default_root: Path = path_normalize(path_join(script_directory, "../.."))
        root <- f"{default_root}"
    return EsInventorySignals::run(root)
