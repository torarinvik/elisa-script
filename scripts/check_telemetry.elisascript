# Bounded Elisascript port of check_telemetry.sh.
# Regex source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsTelemetryAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/telemetry_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsTelemetry:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/telemetry_model\.elisa\""
            MODE: Regex = regex"const enum TelemetryMode of u8"
            STATE: Regex = regex"const enum TelemetryState of u8"
            EVENT_KIND: Regex = regex"const enum TelemetryEventKind of u8"
            EVENT: Regex = regex"const enum TelemetryEvent of u8"
            POLICY: Regex = regex"struct TelemetryPolicy:"
            METRIC: Regex = regex"struct TelemetryMetric:"
            TRACE_EVENT: Regex = regex"struct TelemetryTraceEvent:"
            LEDGER: Regex = regex"struct TelemetryLedger:"
            ERROR: Regex = regex"error TelemetryError:"
            VALIDATE: Regex = regex"def validate_telemetry_ledger\("
            ADVANCE: Regex = regex"def advance_telemetry\("
            RECORD_METRIC: Regex = regex"def telemetry_record_metric\("
            APPEND_EVENT: Regex = regex"def telemetry_append_event\("
            METRICS_LIMIT: Regex = regex"Limits::METRICS"
            EVENTS_LIMIT: Regex = regex"Limits::EVENTS"
            NAME_BYTES_LIMIT: Regex = regex"Limits::NAME_BYTES"
            PAYLOAD_BYTES_LIMIT: Regex = regex"Limits::PAYLOAD_BYTES"
            SPANS_LIMIT: Regex = regex"Limits::SPANS"
            DISABLED_MODE: Regex = regex"TelemetryMode.Disabled"
            SAMPLED_OUTCOME: Regex = regex"TelemetryRecordOutcome.Sampled"
            EVENT_LIMIT_ERROR: Regex = regex"TelemetryError.EventLimitExceeded"
            NONZERO_PAYLOAD_POLICY: Regex = regex"policy.max_payload_bytes != 0"
            EVENT_ACCOUNTING: Regex = regex"ledger.events.count \+ ledger.sampled_events >= ledger.policy.max_events"
            SPAN_ACCOUNTING_ERROR: Regex = regex"TelemetryError.SpanAccountingInvalid"
            SEQUENCE_BOUND: Regex = regex"event.sequence > \(ledger.events.count \+ ledger.sampled_events\).u64\(\)"
            ACCOUNTING_ERROR: Regex = regex"TelemetryError.AccountingInvalid"
            TELEMETRY_DISABLED_ERROR: Regex = regex"TelemetryError.TelemetryDisabled"
            FIXTURE_IMPORT: Regex = regex"using EsTelemetry"
            FIXTURE_CONTRACT: Regex = regex"typed_telemetry_contract_bounds_metrics_spans_and_sampling"
            FIXTURE_EVENTS_MODE: Regex = regex"TelemetryMode.Events"
            FIXTURE_SAMPLED: Regex = regex"TelemetryRecordOutcome.Sampled"
            FIXTURE_DISABLED: Regex = regex"TelemetryError.TelemetryDisabled"
            FIXTURE_FAILED_STATE: Regex = regex"TelemetryState.Failed"
            FIXTURE_ACCOUNTING: Regex = regex"TelemetryError.AccountingInvalid"
            FIXTURE_ATOMIC_CEILING: Regex = regex"telemetry_event_ceiling_is_atomic"
            FIXTURE_INVALID_POLICY: Regex = regex"invalid_payload_policy"
            FIXTURE_EVENT_LIMIT: Regex = regex"TelemetryError.EventLimitExceeded"
            DOCS_LEDGER: Regex = regex"EsTelemetry::TelemetryLedger"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-045"


        const module Messages:
            MISSING_ROOT: sview = "telemetry audit: missing repository root"
            UNRESOLVED_ROOT: sview = "telemetry audit: unable to resolve repository root"
            MISSING_INPUT: sview = "telemetry audit: missing "
            READ_FAILED: sview = "telemetry audit: unable to read source: "
            SUCCESS: sview = "telemetry audit: opt-out metrics, sampled events, and bounded span accounting are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::METRIC},
                SearchCheck{input: inputs[0], pattern: Patterns::TRACE_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::LEDGER},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_METRIC},
                SearchCheck{input: inputs[0], pattern: Patterns::APPEND_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::METRICS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENTS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_BYTES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::PAYLOAD_BYTES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::SPANS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::DISABLED_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::SAMPLED_OUTCOME},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT_LIMIT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::NONZERO_PAYLOAD_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::SPAN_ACCOUNTING_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::SEQUENCE_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTING_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::TELEMETRY_DISABLED_ERROR},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_EVENTS_MODE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_SAMPLED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_DISABLED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_FAILED_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ACCOUNTING},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ATOMIC_CEILING},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_POLICY},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_EVENT_LIMIT},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_LEDGER},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsTelemetryAudit::run_default()
