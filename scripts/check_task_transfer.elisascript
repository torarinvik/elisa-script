# Bounded Elisascript port of check_task_transfer.sh.
# Regex source checks stream through the shared scanner without rg/awk.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsTaskTransferAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/task_transfer_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsTaskTransfer:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/task_transfer_model\.elisa\""
            TRANSFER_STATE: Regex = regex"const enum TaskTransferState of u8"
            VALUE_KIND: Regex = regex"const enum TaskTransferValueKind of u8"
            MODE: Regex = regex"const enum TaskTransferMode of u8"
            RESOURCE: Regex = regex"struct TaskTransferResource:"
            REQUEST: Regex = regex"struct TaskTransferRequest:"
            SESSION: Regex = regex"struct TaskTransferSession:"
            ERROR: Regex = regex"error TaskTransferError:"
            VALIDATE: Regex = regex"def validate_task_transfer\("
            ADVANCE: Regex = regex"def advance_task_transfer\("
            ITEM_LIMIT: Regex = regex"Limits::ITEMS"
            BYTE_LIMIT: Regex = regex"Limits::BYTES"
            BORROW_TICKS: Regex = regex"Limits::BORROW_TICKS"
            COPY_MODE: Regex = regex"TaskTransferMode.Copy"
            MOVE_MODE: Regex = regex"TaskTransferMode.Move"
            BORROW_MODE: Regex = regex"TaskTransferMode.Borrow"
            DUPLICATE_RESOURCE: Regex = regex"TaskTransferError.DuplicateResource"
            ADMITTED_ITEMS: Regex = regex"derived_admitted_items"
            COMMITTED_ITEMS: Regex = regex"derived_committed_items"
            ADMITTED_BYTES: Regex = regex"derived_admitted_bytes"
            COMMIT_NOT_READY: Regex = regex"TaskTransferError.CommitNotReady"
            COMMITTED_STATE: Regex = regex"TaskTransferState.Committed"
            COMMITTING_STATE: Regex = regex"TaskTransferState.Committing"
            PLANNED_STATE: Regex = regex"TaskTransferState.Planned and"
            VALIDATING_STATE: Regex = regex"TaskTransferState.Validating and"
            SESSION_COMMITTED: Regex = regex"session.state == TaskTransferState.Committed"
            FIXTURE_IMPORT: Regex = regex"using EsTaskTransfer"
            FIXTURE_CONTRACT: Regex = regex"typed_task_transfer_contract_preserves_move_and_borrow_ownership"
            FIXTURE_LINEAR: Regex = regex"TaskTransferValueKind.Linear"
            FIXTURE_HANDLER_CONTEXT: Regex = regex"TaskTransferValueKind.HandlerContext"
            FIXTURE_INVALID_MODE: Regex = regex"TaskTransferError.InvalidMode"
            FIXTURE_OWNER: Regex = regex"task_transfer_owner"
            FIXTURE_INVALID_ITEM_STATE: Regex = regex"TaskTransferError.ItemStateInvalid"
            DOCS_SESSION: Regex = regex"EsTaskTransfer::TaskTransferSession"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-040"


        const module Messages:
            MISSING_ROOT: sview = "task transfer audit: missing repository root"
            UNRESOLVED_ROOT: sview = "task transfer audit: unable to resolve repository root"
            MISSING_INPUT: sview = "task transfer audit: missing "
            READ_FAILED: sview = "task transfer audit: unable to read source: "
            SUCCESS: sview = "task transfer audit: bounded copy/move/borrow ownership protocol is present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::TRANSFER_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::VALUE_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::RESOURCE},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::ITEM_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::BYTE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::BORROW_TICKS},
                SearchCheck{input: inputs[0], pattern: Patterns::COPY_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::MOVE_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::BORROW_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_RESOURCE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADMITTED_ITEMS},
                SearchCheck{input: inputs[0], pattern: Patterns::COMMITTED_ITEMS},
                SearchCheck{input: inputs[0], pattern: Patterns::ADMITTED_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::COMMIT_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::COMMITTED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::COMMITTING_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATING_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION_COMMITTED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_LINEAR},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_HANDLER_CONTEXT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_MODE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_OWNER},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_ITEM_STATE},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsTaskTransferAudit::run_default()
