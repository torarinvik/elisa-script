# Bounded Elisascript port of check_differential_trace_window.sh.
# Fixed-string source checks stream through the shared scanner without rg/awk.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDifferentialTraceWindowAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/testing/trace_window_model.elisa"
            CONSUMER: sview = "src/testing/differential.elisa"
            FIXTURE: sview = "test/differential/elisascript_differential_test.elisa"
            DOCS: sview = "docs/differential-testing.md"


        const module Patterns:
            MODULE: sview = "module EsDifferentialTraceWindow:"
            STEP_LIMIT: sview = "Limits::STEPS"
            EVENT_LIMIT: sview = "Limits::EVENTS"
            STATE: sview = "const enum DifferentialTraceWindowState of u8:"
            EVENT: sview = "const enum DifferentialTraceWindowEvent of u8:"
            POSITION: sview = "const enum DifferentialTraceWindowPosition of u8:"
            POLICY: sview = "struct DifferentialTraceWindowPolicy:"
            RECORD: sview = "struct DifferentialTraceWindowRecord:"
            WINDOW: sview = "struct DifferentialTraceWindow:"
            ERROR: sview = "error DifferentialTraceWindowError:"
            VALIDATE: sview = "def validate_differential_trace_window("
            ADVANCE: sview = "def advance_differential_trace_window("
            FINGERPRINT: sview = "def differential_trace_window_fingerprint("
            BEFORE_STEPS: sview = "before_steps"
            AFTER_STEPS: sview = "after_steps"
            ANCHOR_STEP: sview = "anchor_step"
            ANCHOR_MISSING: sview = "AnchorMissing"
            ANCHOR_NOT_DIVERGENT: sview = "AnchorNotDivergent"
            OUTSIDE_WINDOW: sview = "OutsideWindow"
            STEP_ORDER: sview = "StepOrderInvalid"
            POSITION_BEFORE: sview = "DifferentialTraceWindowPosition.Before"
            POSITION_DIVERGENCE: sview = "DifferentialTraceWindowPosition.Divergence"
            POSITION_AFTER: sview = "DifferentialTraceWindowPosition.After"
            VALIDATION_CATCH: sview = "catch validate_differential_trace_window(window)"
            MODEL_IMPORT: sview = "include \"./trace_window_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsDifferentialTraceWindow"
            FIXTURE_CONTRACT: sview = "differential_trace_window_contract_bounds_context_around_first_divergence"
            FIXTURE_RECORD: sview = "DifferentialTraceWindowEvent.Record"
            FIXTURE_SEAL: sview = "DifferentialTraceWindowEvent.Seal"
            FIXTURE_OUTSIDE_WINDOW: sview = "DifferentialTraceWindowError.OutsideWindow"
            FIXTURE_EQUAL_ANCHOR: sview = "equal_anchor_rejected"
            FIXTURE_INVALID_SEALED: sview = "invalid_sealed_window"
            FIXTURE_INVALID_FINGERPRINT: sview = "differential_trace_window_fingerprint(invalid_sealed_window) == 0"
            DOCS_WINDOW: sview = "EsDifferentialTraceWindow::DifferentialTraceWindow"


        const module Messages:
            MISSING_ROOT: sview = "differential trace-window audit: missing repository root"
            UNRESOLVED_ROOT: sview = "differential trace-window audit: unable to resolve repository root"
            MISSING_INPUT: sview = "differential trace-window audit: missing "
            READ_FAILED: sview = "differential trace-window audit: unable to read source: "
            SUCCESS: sview = "differential trace-window audit: bounded pre/anchor/post records and first-divergence context are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::STEP_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POSITION},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD},
                SearchCheck{input: inputs[0], pattern: Patterns::WINDOW},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::FINGERPRINT},
                SearchCheck{input: inputs[0], pattern: Patterns::BEFORE_STEPS},
                SearchCheck{input: inputs[0], pattern: Patterns::AFTER_STEPS},
                SearchCheck{input: inputs[0], pattern: Patterns::ANCHOR_STEP},
                SearchCheck{input: inputs[0], pattern: Patterns::ANCHOR_MISSING},
                SearchCheck{input: inputs[0], pattern: Patterns::ANCHOR_NOT_DIVERGENT},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTSIDE_WINDOW},
                SearchCheck{input: inputs[0], pattern: Patterns::STEP_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::POSITION_BEFORE},
                SearchCheck{input: inputs[0], pattern: Patterns::POSITION_DIVERGENCE},
                SearchCheck{input: inputs[0], pattern: Patterns::POSITION_AFTER},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATION_CATCH},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_RECORD},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_SEAL},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_OUTSIDE_WINDOW},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_EQUAL_ANCHOR},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_SEALED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_FINGERPRINT},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_WINDOW}
            ]


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::CONSUMER),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            for check in searches(inputs):
                status: i64 = has_line(check.input, check.pattern)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDifferentialTraceWindowAudit::run_default()
