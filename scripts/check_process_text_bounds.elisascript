# Streaming Elisascript port of check_process_text_bounds.sh.
# Keep the shell oracle until its public-launcher parity contract is qualified.

include "./shell_invocation_path.elisascript"

module EsProcessTextBoundsAudit:
    private:
        const module Inputs:
            INTERPRETER: sview = "src/ir/interpret.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            LENGTH_HELPER: sview = "def process_text_length_fits\\(machine: Machine&, value: sview\\)"
            UNBOUNDED_DISABLED: sview = "return true if machine\\.process_argument_bytes_limit == 0"
            LENGTH_LIMIT: sview = "return sview_len\\(value\\) < machine\\.process_argument_bytes_limit"
            VALUE_LENGTH_CHECK: sview = "if not process_text_length_fits\\(machine, value\\.text\\)"
            EXECUTABLE_LENGTH_CHECK: sview = "if not process_text_length_fits\\(machine, executable\\.text\\)"
            ARGUMENT_LENGTH_CHECK: sview = "if not process_text_length_fits\\(machine, argument\\.text\\)"
            ENVIRONMENT_LENGTH_CHECK: sview = "if not process_text_length_fits\\(machine, name\\.text\\) or not process_text_length_fits\\(machine, value\\.text\\)"
            EXECUTABLE_NUL_CHECK: sview = "if text_has_nul\\(executable\\.text\\)"
            ARGUMENT_NUL_CHECK: sview = "if text_has_nul\\(argument\\.text\\)"
            ENVIRONMENT_NUL_CHECK: sview = "if text_has_nul\\(name\\.text\\) or sview_contains_byte\\(name\\.text, 61\\) or text_has_nul\\(value\\.text\\)"
            FUSED_EXECUTABLE_NUL: sview = "or text_has_nul\\(executable\\.text\\)"
            FUSED_ARGUMENT_NUL: sview = "or text_has_nul\\(argument\\.text\\)"
            FUSED_ENVIRONMENT_NUL: sview = "or text_has_nul\\(name\\.text\\)"
            DOCS_ADMISSION: sview = "per-field length admission|process_text_length_fits|borrowed.*NUL"
            LEDGER_ADMISSION: sview = "pre-scan|process_text_length_fits|process text"


        const module Messages:
            MISSING_ROOT: sview = "process text bounds audit: missing repository root"
            UNRESOLVED_ROOT: sview = "process text bounds audit: unable to resolve repository root"
            MISSING_INPUT: sview = "process text bounds audit: missing "
            FUSED_EXECUTABLE: sview = "process text bounds audit: executable NUL scan remains fused with type admission"
            FUSED_ARGUMENT: sview = "process text bounds audit: argument NUL scan remains fused with type admission"
            FUSED_ENVIRONMENT: sview = "process text bounds audit: environment NUL scan remains fused with type admission"


        const enum Expectation of u8:
            Present
            Absent


        struct SearchCheck:
            input: Path
            pattern: sview
            expectation: Expectation = Expectation.Present
            violation_message: sview = ""


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(interpreter: Path, docs: Path, ledger: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: interpreter, pattern: Patterns::LENGTH_HELPER},
                SearchCheck{input: interpreter, pattern: Patterns::UNBOUNDED_DISABLED},
                SearchCheck{input: interpreter, pattern: Patterns::LENGTH_LIMIT},
                SearchCheck{input: interpreter, pattern: Patterns::VALUE_LENGTH_CHECK},
                SearchCheck{input: interpreter, pattern: Patterns::EXECUTABLE_LENGTH_CHECK},
                SearchCheck{input: interpreter, pattern: Patterns::ARGUMENT_LENGTH_CHECK},
                SearchCheck{input: interpreter, pattern: Patterns::ENVIRONMENT_LENGTH_CHECK},
                SearchCheck{input: interpreter, pattern: Patterns::EXECUTABLE_NUL_CHECK},
                SearchCheck{input: interpreter, pattern: Patterns::ARGUMENT_NUL_CHECK},
                SearchCheck{input: interpreter, pattern: Patterns::ENVIRONMENT_NUL_CHECK},
                SearchCheck{input: interpreter, pattern: Patterns::FUSED_EXECUTABLE_NUL, expectation: Expectation.Absent, violation_message: Messages::FUSED_EXECUTABLE},
                SearchCheck{input: interpreter, pattern: Patterns::FUSED_ARGUMENT_NUL, expectation: Expectation.Absent, violation_message: Messages::FUSED_ARGUMENT},
                SearchCheck{input: interpreter, pattern: Patterns::FUSED_ENVIRONMENT_NUL, expectation: Expectation.Absent, violation_message: Messages::FUSED_ENVIRONMENT},
                SearchCheck{input: docs, pattern: Patterns::DOCS_ADMISSION},
                SearchCheck{input: ledger, pattern: Patterns::LEDGER_ADMISSION}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Environment.Read, File.Read, Directory.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            rg: Executable = try executable("rg") else err:
                return 127i64
            for check in checks:
                arguments: darray[sview] = ["-q", check.pattern, f"{check.input}"]
                status: i64 = try run_process(rg, arguments, 0i64) else err:
                    return 127i64
                match check.expectation:
                    Expectation.Present:
                        return status if status != 0i64
                        continue
                    Expectation.Absent:
                        if status == 0i64:
                            diagnostic(check.violation_message)
                            return 1i64
                        continue
                    _:
                        continue
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return 1i64
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return 1i64

            status: i64 = execute(searches(inputs[0], inputs[1], inputs[2]))
            return status if status != 0i64

            print("process text bounds audit: per-field process and environment admission precedes host scans")
            return 0i64


        def run_default() -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsProcessTextBoundsAudit::run_default()
