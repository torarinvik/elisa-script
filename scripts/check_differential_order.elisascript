# Bounded Elisascript port of check_differential_order.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDifferentialOrderAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/testing/order_model.elisa"
            CONSUMER: sview = "src/testing/differential.elisa"
            FIXTURE: sview = "test/differential/elisascript_differential_test.elisa"
            DOCS: sview = "docs/differential-testing.md"


        const module Patterns:
            MODULE: sview = "module EsDifferentialOrder:"
            OBSERVATION_LIMIT: sview = "Limits::OBSERVATIONS"
            EXECUTION_ORDER: sview = "const enum DifferentialExecutionOrder of u8:"
            ORDER_STATE: sview = "const enum DifferentialOrderState of u8:"
            ORDER_EVENT: sview = "const enum DifferentialOrderEvent of u8:"
            CLASSIFICATION: sview = "const enum DifferentialOrderClassification of u8:"
            CONTAMINATION_POLICY: sview = "const enum DifferentialContaminationPolicy of u8:"
            POLICY: sview = "struct DifferentialOrderPolicy:"
            OBSERVATION: sview = "struct DifferentialOrderObservation:"
            SESSION: sview = "struct DifferentialOrderSession:"
            ERROR: sview = "error DifferentialOrderError:"
            VALIDATE: sview = "def validate_differential_order_session("
            ADVANCE: sview = "def advance_differential_order_session("
            REQUIRE_BOTH: sview = "require_both_orders"
            INITIAL_FINGERPRINT: sview = "initial_world_fingerprint"
            FINAL_FINGERPRINT: sview = "final_world_fingerprint"
            DUPLICATE_ORDER: sview = "DuplicateOrder"
            CONTAMINATION_REJECTED: sview = "OrderContaminationRejected"
            ORDER_INDEPENDENT: sview = "OrderIndependent"
            ORDER_DEPENDENT: sview = "OrderDependent"
            WORLD_CONTAMINATED: sview = "WorldContaminated"
            EXPECTED_DEPENDENCY: sview = "expected_order_dependency"
            EXPECTED_CONTAMINATION: sview = "expected_world_contamination"
            CONTAMINATION_FLAG: sview = "session.has_world_contamination != expected_world_contamination"
            EMPTY_WITH_BASELINE: sview = "session.has_baseline and session.observations.count == 0"
            ORPHAN_BASELINE: sview = "session.observations.count != 0 or session.baseline_initial_world_fingerprint != 0 or session.baseline_comparison_fingerprint != 0 or session.baseline_equal"
            MODEL_IMPORT: sview = "include \"./order_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsDifferentialOrder"
            FIXTURE_CONTRACT: sview = "differential_order_contract_detects_world_leaks_and_order_dependency"
            REFERENCE_FIRST: sview = "DifferentialExecutionOrder.ReferenceThenCandidate"
            CANDIDATE_FIRST: sview = "DifferentialExecutionOrder.CandidateThenReference"
            FIXTURE_ORDER_INDEPENDENT: sview = "DifferentialOrderClassification.OrderIndependent"
            FIXTURE_WORLD_CONTAMINATED: sview = "DifferentialOrderClassification.WorldContaminated"
            FIXTURE_REJECTED: sview = "DifferentialOrderError.OrderContaminationRejected"
            RETAINED_LEAK: sview = "retained_leak"
            FORGED_FLAGS: sview = "forged_order_flags"
            HIDDEN_BASELINE: sview = "hidden_order_baseline_rejected"
            ORPHAN_BASELINE_FIXTURE: sview = "orphan_order_baseline_rejected"
            DOCS_SESSION: sview = "EsDifferentialOrder::DifferentialOrderSession"


        const module Messages:
            MISSING_ROOT: sview = "differential order audit: missing repository root"
            UNRESOLVED_ROOT: sview = "differential order audit: unable to resolve repository root"
            MISSING_INPUT: sview = "differential order audit: missing "
            READ_FAILED: sview = "differential order audit: unable to read source: "
            SUCCESS: sview = "differential order audit: bounded dual-order execution, world restoration fingerprints, and contamination classification are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::OBSERVATION_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::EXECUTION_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::ORDER_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ORDER_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::CLASSIFICATION},
                SearchCheck{input: inputs[0], pattern: Patterns::CONTAMINATION_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::OBSERVATION},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUIRE_BOTH},
                SearchCheck{input: inputs[0], pattern: Patterns::INITIAL_FINGERPRINT},
                SearchCheck{input: inputs[0], pattern: Patterns::FINAL_FINGERPRINT},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::CONTAMINATION_REJECTED},
                SearchCheck{input: inputs[0], pattern: Patterns::ORDER_INDEPENDENT},
                SearchCheck{input: inputs[0], pattern: Patterns::ORDER_DEPENDENT},
                SearchCheck{input: inputs[0], pattern: Patterns::WORLD_CONTAMINATED},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPECTED_DEPENDENCY},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPECTED_CONTAMINATION},
                SearchCheck{input: inputs[0], pattern: Patterns::CONTAMINATION_FLAG},
                SearchCheck{input: inputs[0], pattern: Patterns::EMPTY_WITH_BASELINE},
                SearchCheck{input: inputs[0], pattern: Patterns::ORPHAN_BASELINE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::REFERENCE_FIRST},
                SearchCheck{input: inputs[2], pattern: Patterns::CANDIDATE_FIRST},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ORDER_INDEPENDENT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_WORLD_CONTAMINATED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_REJECTED},
                SearchCheck{input: inputs[2], pattern: Patterns::RETAINED_LEAK},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_FLAGS},
                SearchCheck{input: inputs[2], pattern: Patterns::HIDDEN_BASELINE},
                SearchCheck{input: inputs[2], pattern: Patterns::ORPHAN_BASELINE_FIXTURE},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::CONSUMER),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDifferentialOrderAudit::run_default()
