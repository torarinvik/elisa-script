# Bounded Elisascript port of check_record_join.sh.
# Regex source checks stream through the shared line scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsRecordJoinAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/record_join_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            RUNTIME_FIXTURE: sview = "test/runtime/record_join_model_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsRecordJoin:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/record_join_model\.elisa\""
            STATE: Regex = regex"const enum RecordJoinState of u8"
            EVENT: Regex = regex"const enum RecordJoinEvent of u8"
            SIDE: Regex = regex"const enum RecordJoinSide of u8"
            KIND: Regex = regex"const enum RecordJoinKind of u8"
            POLICY: Regex = regex"struct RecordJoinPolicy:"
            ROW: Regex = regex"struct RecordJoinRow:"
            SESSION: Regex = regex"struct RecordJoinSession:"
            ERROR: Regex = regex"error RecordJoinError:"
            VALIDATE_HEADER: Regex = regex"def validate_record_join_header\("
            VALIDATE: Regex = regex"def validate_record_join\("
            SORT_ROW_INDICES: Regex = regex"def record_join_sort_row_indices\("
            PAIR_COUNT: Regex = regex"def record_join_pair_count\("
            ADVANCE: Regex = regex"def advance_record_join\("
            MAX_ROWS: Regex = regex"RECORD_JOIN_MAX_ROWS"
            MAX_PAIRS: Regex = regex"RECORD_JOIN_MAX_PAIRS"
            MAX_KEY_BYTES: Regex = regex"RECORD_JOIN_MAX_KEY_BYTES"
            MAX_VALUE_BYTES: Regex = regex"RECORD_JOIN_MAX_VALUE_BYTES"
            PAIR_ADD_MANY: Regex = regex"record_join_pair_add_many"
            BOUNDED_ADD: Regex = regex"current > limit or amount > limit - current"
            REMAINING_PAIRS: Regex = regex"remaining_pairs / right_count"
            BOUNDED_ADD_CALL: Regex = regex"record_join_bounded_add"
            VALUE_LIMIT: Regex = regex"sview_len\(value\) <= limit"
            ROW_COUNTS: Regex = regex"session.left_count > session.rows.count or session.right_count > session.rows.count"
            FULL_JOIN: Regex = regex"RecordJoinKind.Full"
            EMPTY_KEY: Regex = regex"RecordJoinError.EmptyKey"
            EMBEDDED_NUL: Regex = regex"RecordJoinError.EmbeddedNul"
            PAIR_LIMIT_EXCEEDED: Regex = regex"RecordJoinError.PairLimitExceeded"
            ACCOUNTING_INVALID: Regex = regex"RecordJoinError.AccountingInvalid"
            PLANNED_STATE: Regex = regex"session.state == RecordJoinState.Planned and"
            ADD_EVENT: Regex = regex"RecordJoinEvent.Add"
            VALIDATE_HEADER_CALL: Regex = regex"try validate_record_join_header\(session\)"
            SEALED_STATE: Regex = regex"RecordJoinState.Sealed"
            RUNTIME_DUPLICATES: Regex = regex"record_join_pair_count_groups_unsorted_duplicate_keys"
            RUNTIME_OVERFLOW: Regex = regex"record_join_pair_count_rejects_cartesian_pair_overflow"
            RUNTIME_LIMITS: Regex = regex"record_join_admits_key_and_value_at_exact_byte_limits"
            RUNTIME_FORGED_LEDGER: Regex = regex"record_join_rejects_forged_existing_ledger_before_add"
            RUNTIME_FULL_JOIN: Regex = regex"RecordJoinKind.Full"
            RUNTIME_PAIR_LIMIT: Regex = regex"RecordJoinError.PairLimitExceeded"
            FIXTURE_IMPORT: Regex = regex"using EsRecordJoin"
            FIXTURE_CONTRACT: Regex = regex"typed_record_join_contract_counts_duplicate_and_outer_pairs"
            LEFT_SIDE: Regex = regex"RecordJoinSide.Left"
            RIGHT_SIDE: Regex = regex"RecordJoinSide.Right"
            FIXTURE_PAIR_COUNT: Regex = regex"record_join_pair_count"
            FORGED_COUNT_BOUND: Regex = regex"forged_count_bound"
            FIXTURE_EMPTY_KEY: Regex = regex"RecordJoinError.EmptyKey"
            FIXTURE_EMBEDDED_NUL: Regex = regex"RecordJoinError.EmbeddedNul"
            DOCS_SESSION: Regex = regex"EsRecordJoin::RecordJoinSession"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-032"


        const module Messages:
            MISSING_ROOT: sview = "record join audit: missing repository root"
            UNRESOLVED_ROOT: sview = "record join audit: unable to resolve repository root"
            MISSING_INPUT: sview = "record join audit: missing "
            READ_FAILED: sview = "record join audit: unable to read source: "
            SUCCESS: sview = "record join audit: bounded duplicate-key matching and explicit outer pairs are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::SIDE},
                SearchCheck{input: inputs[0], pattern: Patterns::KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::ROW},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_HEADER},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::SORT_ROW_INDICES},
                SearchCheck{input: inputs[0], pattern: Patterns::PAIR_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_ROWS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_PAIRS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_KEY_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_VALUE_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::PAIR_ADD_MANY},
                SearchCheck{input: inputs[0], pattern: Patterns::BOUNDED_ADD},
                SearchCheck{input: inputs[0], pattern: Patterns::REMAINING_PAIRS},
                SearchCheck{input: inputs[0], pattern: Patterns::BOUNDED_ADD_CALL},
                SearchCheck{input: inputs[0], pattern: Patterns::VALUE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::ROW_COUNTS},
                SearchCheck{input: inputs[0], pattern: Patterns::FULL_JOIN},
                SearchCheck{input: inputs[0], pattern: Patterns::EMPTY_KEY},
                SearchCheck{input: inputs[0], pattern: Patterns::EMBEDDED_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::PAIR_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTING_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADD_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_HEADER_CALL},
                SearchCheck{input: inputs[0], pattern: Patterns::SEALED_STATE},
                SearchCheck{input: inputs[3], pattern: Patterns::RUNTIME_DUPLICATES},
                SearchCheck{input: inputs[3], pattern: Patterns::RUNTIME_OVERFLOW},
                SearchCheck{input: inputs[3], pattern: Patterns::RUNTIME_LIMITS},
                SearchCheck{input: inputs[3], pattern: Patterns::RUNTIME_FORGED_LEDGER},
                SearchCheck{input: inputs[3], pattern: Patterns::RUNTIME_FULL_JOIN},
                SearchCheck{input: inputs[3], pattern: Patterns::RUNTIME_PAIR_LIMIT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::LEFT_SIDE},
                SearchCheck{input: inputs[2], pattern: Patterns::RIGHT_SIDE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_PAIR_COUNT},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_COUNT_BOUND},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_EMPTY_KEY},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_EMBEDDED_NUL},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[5], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::RUNTIME_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsRecordJoinAudit::run_default()
