# Bounded Elisascript port of check_copy_tree_relative_paths.sh.
# Source checks use the shared scanner without launching rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsCopyTreeRelativePathAudit:
    private:
        const module Inputs:
            INTERPRETER: sview = "src/ir/interpret.elisa"
            FIXTURE: sview = "test/ir/elisascript_interpreter_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            CANONICAL_OVERLAPS: sview = "def copy_tree_destination_canonical_overlaps_source\\("
            NORMALIZED_DESTINATION: sview = "normalized_destination: dstr = Fs::normalize\\(&perm_arena, destination\\)"
            NORMALIZED_TEXT: sview = "normalized_destination_text: sview = bytes_view\\(normalized_destination\\)"
            CURRENT_PARENT: sview = "destination_parent: sview = \"\\.\" if parent_spelling == \"\" else parent_spelling"
            DESTINATION_LEAF: sview = "destination_leaf: sview = Fs::filename\\(normalized_destination_text\\)"
            REAL_PARENT_ORDER: sview = "normalized_destination: dstr = Fs::normalize\\(&perm_arena, destination\\).*parent_spelling: sview = Fs::parent\\(normalized_destination_text\\)"
            OVERLAP_AFTER_REAL: sview = "destination_parent: sview = \"\\.\" if parent_spelling == \"\" else parent_spelling.*canonical_parent: RuntimeValue = evaluate_path_real\\(machine, runtime_text\\(destination_parent\\)\\)"
            FIXTURE_ACCEPTS: sview = "interpreter_accepts_relative_and_trailing_slash_tree_destinations"
            FIXTURE_TRAILING_SLASH: sview = "copy_tree\\(path\\\\\"relative-source\\\\\", path\\\\\"relative-destination/\\\\\"\\)"
            FIXTURE_NO_TRAILING_SLASH: sview = "copy_tree\\(path\\\\\"relative-source\\\\\", path\\\\\"relative-plain-destination\\\\\"\\)"
            DOCS_RELATIVE_REALPATH: sview = "relative destination.*realpath"
            LEDGER_TRAILING_DESTINATION: sview = "relative and trailing-separator destination"


        const module Messages:
            MISSING_ROOT: sview = "copy-tree relative-path audit: missing repository root"
            UNRESOLVED_ROOT: sview = "copy-tree relative-path audit: unable to resolve repository root"
            MISSING_INPUT: sview = "copy-tree relative-path audit: missing "
            READ_FAILED: sview = "copy-tree relative-path audit: unable to read source: "
            SUCCESS: sview = "copy-tree relative-path audit: normalized relative/trailing destinations use a real current-directory parent before overlap checks"


        const enum SearchMode of u8:
            Line
            FullText


        struct SearchCheck:
            input: Path
            pattern: sview
            mode: SearchMode


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(interpreter: Path, fixture: Path, docs: Path, ledger: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: interpreter, pattern: Patterns::CANONICAL_OVERLAPS, mode: SearchMode.Line},
                SearchCheck{input: interpreter, pattern: Patterns::NORMALIZED_DESTINATION, mode: SearchMode.Line},
                SearchCheck{input: interpreter, pattern: Patterns::NORMALIZED_TEXT, mode: SearchMode.Line},
                SearchCheck{input: interpreter, pattern: Patterns::CURRENT_PARENT, mode: SearchMode.Line},
                SearchCheck{input: interpreter, pattern: Patterns::DESTINATION_LEAF, mode: SearchMode.Line},
                SearchCheck{input: interpreter, pattern: Patterns::REAL_PARENT_ORDER, mode: SearchMode.FullText},
                SearchCheck{input: interpreter, pattern: Patterns::OVERLAP_AFTER_REAL, mode: SearchMode.FullText},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_ACCEPTS, mode: SearchMode.Line},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_TRAILING_SLASH, mode: SearchMode.Line},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_NO_TRAILING_SLASH, mode: SearchMode.Line},
                SearchCheck{input: docs, pattern: Patterns::DOCS_RELATIVE_REALPATH, mode: SearchMode.Line},
                SearchCheck{input: ledger, pattern: Patterns::LEDGER_TRAILING_DESTINATION, mode: SearchMode.Line}
            ]


        def has_line_match(path: Path, pattern_text: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(pattern_text)
            catch EsSourceFunctionScope::contains_file_regex_line(path, pattern):
                ok found:
                    return 1i64 if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return 2i64


        def has_full_text_match(path: Path, pattern_text: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(pattern_text)
            catch EsSourceFunctionScope::contains_file_regex_text(path, pattern):
                ok found:
                    return 1i64 if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return 2i64


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                status: i64 = when check.mode:
                    SearchMode.Line -> has_line_match(check.input, check.pattern)
                    SearchMode.FullText -> has_full_text_match(check.input, check.pattern)
                    _ -> 1i64
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return 1i64
            root: Path = path_normalize(repository_root)

            inputs: darray[Path] = [
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return 1i64

            status: i64 = execute(searches(inputs[0], inputs[1], inputs[2], inputs[3]))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsCopyTreeRelativePathAudit::run_default()
