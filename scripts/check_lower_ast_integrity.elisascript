# Bounded Elisascript port of check_lower_ast_integrity.sh.
# Lexical source checks stream through FileStream; no compiler or child process.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsLowerAstIntegrityAudit:
    private:
        const module Inputs:
            LOWERER: sview = "src/ir/lower_ast.elisa"
            IR_MODEL: sview = "src/ir/ir_model.elisa"
            FIXTURE: sview = "test/ir/elisascript_lowering_test.elisa"


        const module Patterns:
            REMOVED_TYPE: sview = "TypeKind.Unmodeled"
            TYPE_KIND_DECLARATION: sview = "        const enum TypeKind of u8:"
            CONTEXTUAL_INTEGER_CHECK: sview = "contextual_type_ok: bool = (expected.kind == TypeKind.Named and expected.name == \"\") or (expected.kind == TypeKind.Int and same_type(literal_type, expected))"
            CONTEXTUAL_FIXTURE: sview = "def lowers_explicit_integer_suffixes_in_contextual_returns("


        const module Messages:
            MISSING_ROOT: sview = "lower AST integrity audit: missing repository root"
            UNRESOLVED_ROOT: sview = "lower AST integrity audit: unable to resolve repository root"
            MISSING_INPUT: sview = "lower AST integrity audit: missing file: "
            REMOVED_TYPE: sview = "lower AST integrity audit: lowerer references removed TypeKind.Unmodeled"
            MISSING_TYPE_KIND: sview = "lower AST integrity audit: closed TypeKind declaration is missing"
            CONTEXTUAL_COUNT_PREFIX: sview = "lower AST integrity audit: expected two contextual integer-literal checks, found "
            MISSING_FIXTURE: sview = "lower AST integrity audit: contextual suffixed-integer regression fixture is missing"
            READ_FAILED: sview = "lower AST integrity audit: unable to read source: "
            SUCCESS: sview = "lower AST integrity audit: closed TypeKind references and contextual integer literal checks are consistent"


        const module ExitStatus:
            FAILURE: i64 = 1
            INPUT_FAILURE: i64 = 2


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_line(path: Path, needle: sview, line_prefix: bool = false) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle, "", line_prefix):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::INPUT_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::LOWERER),
                root.joinpath(Inputs::IR_MODEL),
                root.joinpath(Inputs::FIXTURE)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::INPUT_FAILURE

            forbidden_status: i64 = has_line(inputs[0], Patterns::REMOVED_TYPE)
            return ExitStatus::INPUT_FAILURE if forbidden_status == ExitStatus::INPUT_FAILURE
            if forbidden_status == 0i64:
                diagnostic(Messages::REMOVED_TYPE)
                return ExitStatus::FAILURE

            declaration_status: i64 = has_line(inputs[1], Patterns::TYPE_KIND_DECLARATION, true)
            return ExitStatus::INPUT_FAILURE if declaration_status == ExitStatus::INPUT_FAILURE
            if declaration_status == ExitStatus::FAILURE:
                diagnostic(Messages::MISSING_TYPE_KIND)
                return ExitStatus::FAILURE

            contextual_count: usize = try EsSourceFunctionScope::occurrences_in_file(inputs[0], Patterns::CONTEXTUAL_INTEGER_CHECK) else err:
                diagnostic(Messages::READ_FAILED + f"{inputs[0]}")
                return ExitStatus::INPUT_FAILURE
            if contextual_count != 2:
                diagnostic(Messages::CONTEXTUAL_COUNT_PREFIX + f"{contextual_count}")
                return ExitStatus::FAILURE

            fixture_status: i64 = has_line(inputs[2], Patterns::CONTEXTUAL_FIXTURE, true)
            return fixture_status if fixture_status == ExitStatus::INPUT_FAILURE
            if fixture_status == ExitStatus::FAILURE:
                diagnostic(Messages::MISSING_FIXTURE)
                return ExitStatus::FAILURE

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsLowerAstIntegrityAudit::run_default()
