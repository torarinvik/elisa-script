# Bounded Elisascript port of check_map_delete_storage.sh.
# Scoped and fixed-string source checks stream through the shared scanner.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsMapDeleteStorageAudit:
    private:
        const module Inputs:
            INTERPRETER: sview = "src/ir/interpret.elisa"
            BYTECODE: sview = "src/bytecode/bytecode.elisa"
            INTERPRETER_FIXTURE: sview = "test/ir/elisascript_interpreter_test.elisa"
            BYTECODE_FIXTURE: sview = "test/ir/elisascript_bytecode_test.elisa"
            DOCS: sview = "docs/ir.md"
            SEMANTICS: sview = "docs/semantics.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            INTERPRETER_DECL: sview = "        def evaluate_delete_index("
            BYTECODE_DECL: sview = "        def bytecode_direct_delete_index("
            INTERPRETER_FUNCTION: sview = "def evaluate_delete_index"
            BYTECODE_FUNCTION: sview = "def bytecode_direct_delete_index"
            ABSENT_KEY_RETURN: sview = "return collection if not found"
            STORAGE_START: sview = "start: u32 = storage.count.u32()"
            PAIR_CAPACITY: sview = "runtime_storage_pairs_u32_valid(storage, collection.map_count.usize() - 1)"
            INTERPRETER_FIXTURE: sview = "interpreter_executes_mutable_dictionary_remove_and_clear"
            INTERPRETER_MISSING: sview = "def missing() -> bool"
            INTERPRETER_STORAGE: sview = "assert missing_storage.count == 2"
            BYTECODE_FIXTURE: sview = "bytecode_mutable_dictionary_remove_matches_reference"
            REFERENCE_STORAGE: sview = "missing_reference_storage.count == 2"
            BYTECODE_STORAGE: sview = "missing_bytecode_storage.count == 2"
            DOCS_MISSING_KEY: sview = "missing-key"
            DOCS_DELETE_INDEX: sview = "`DeleteIndex` returns the original map"
            SEMANTICS_STORAGE: sview = "flat map storage unchanged"
            LEDGER_NOOP: sview = "search-before-allocation rule applies to no-op `DeleteIndex`"


        const module Messages:
            MISSING_ROOT: sview = "map delete storage audit: missing repository root"
            UNRESOLVED_ROOT: sview = "map delete storage audit: unable to resolve repository root"
            MISSING_INPUT: sview = "map delete storage audit: missing "
            READ_FAILED: sview = "map delete storage audit: unable to read source: "
            MISSING_ABSENT_RETURN: sview = "map delete storage audit: missing absent-key return in "
            MISSING_MARKERS: sview = "map delete storage audit: missing search/allocation markers in "
            WRONG_ORDER: sview = "map delete storage audit: allocation precedes absent-key return in "
            SUCCESS: sview = "map delete storage audit: both backends search before allocation and missing-key fixtures assert unchanged storage"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_line(path: Path, needle: sview, line_prefix: bool = false) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle, "", "", line_prefix):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


        def assert_search_before_allocate(path: Path, definition: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            body: EsSourceFunctionScope::FunctionBody = try EsSourceFunctionScope::read_function_body(path, definition) else err:
                diagnostic(Messages::READ_FAILED + f"{path}")
                return ExitStatus::IO_FAILURE
            if not EsSourceFunctionScope::contains(body.text, Patterns::ABSENT_KEY_RETURN):
                diagnostic(Messages::MISSING_ABSENT_RETURN + f"{path}")
                return ExitStatus::FAILURE
            search_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::ABSENT_KEY_RETURN)
            allocate_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::STORAGE_START)
            if search_line == 0 or allocate_line == 0:
                diagnostic(Messages::MISSING_MARKERS + f"{path}")
                return ExitStatus::FAILURE
            if search_line >= allocate_line:
                diagnostic(Messages::WRONG_ORDER + f"{path}")
                return ExitStatus::FAILURE
            return 0i64


        def postcondition_searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::PAIR_CAPACITY},
                SearchCheck{input: inputs[1], pattern: Patterns::PAIR_CAPACITY},
                SearchCheck{input: inputs[2], pattern: Patterns::INTERPRETER_FIXTURE},
                SearchCheck{input: inputs[2], pattern: Patterns::INTERPRETER_MISSING},
                SearchCheck{input: inputs[2], pattern: Patterns::INTERPRETER_STORAGE},
                SearchCheck{input: inputs[3], pattern: Patterns::BYTECODE_FIXTURE},
                SearchCheck{input: inputs[3], pattern: Patterns::REFERENCE_STORAGE},
                SearchCheck{input: inputs[3], pattern: Patterns::BYTECODE_STORAGE},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_MISSING_KEY},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_DELETE_INDEX},
                SearchCheck{input: inputs[5], pattern: Patterns::SEMANTICS_STORAGE},
                SearchCheck{input: inputs[6], pattern: Patterns::LEDGER_NOOP}
            ]


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::BYTECODE),
                root.joinpath(Inputs::INTERPRETER_FIXTURE),
                root.joinpath(Inputs::BYTECODE_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::SEMANTICS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: mutable i64 = has_line(inputs[0], Patterns::INTERPRETER_DECL, true)
            return status if status != 0i64
            status <- has_line(inputs[1], Patterns::BYTECODE_DECL, true)
            return status if status != 0i64

            status <- assert_search_before_allocate(inputs[0], Patterns::INTERPRETER_FUNCTION)
            return status if status != 0i64
            status <- assert_search_before_allocate(inputs[1], Patterns::BYTECODE_FUNCTION)
            return status if status != 0i64

            for check in postcondition_searches(inputs):
                status <- has_line(check.input, check.pattern)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsMapDeleteStorageAudit::run_default()
