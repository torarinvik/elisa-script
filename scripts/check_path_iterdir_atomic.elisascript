# Bounded Elisascript port of check_path_iterdir_atomic.sh.
# Function-scoped and file-wide source checks stream through FileStream; this
# audit does not launch awk, rg, or another child process.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsPathIterdirAtomicAudit:
    private:
        const module Inputs:
            INTERPRETER: sview = "src/ir/interpret.elisa"
            BYTECODE: sview = "src/bytecode/bytecode.elisa"
            FIXTURE: sview = "test/ir/elisascript_interpreter_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            FUNCTION: sview = "def evaluate_path_iterdir("
            ENTRY_CURSOR: sview = "storage_start: usize = storage.count"
            STORAGE_ROLLBACK: sview = "storage.truncate(storage_start)"
            JOIN_LENGTH_CHECK: sview = "if not path_join_length_fits"
            SHAPE_CHECK: sview = "if not path_shape_result_valid"
            BYTECODE_CALL: sview = "path_iterdir_value(storage, path_value.text)"
            FIXTURE: sview = "interpreter_executes_python_path_iterdir_with_hidden_entries"
            DOCS_START: sview = "Path.iterdir()"
            DOCS_END: sview = "validates every joined child path"
            LEDGER: sview = "Path.iterdir()"
            ATOMIC: sview = "failure-atomic"


        const module Messages:
            MISSING_ROOT: sview = "path iterdir atomic audit: missing repository root"
            UNRESOLVED_ROOT: sview = "path iterdir atomic audit: unable to resolve repository root"
            MISSING_INPUT: sview = "path iterdir atomic audit: missing "
            MISSING_CURSOR: sview = "path iterdir atomic audit: missing entry cursor"
            MISSING_ROLLBACK: sview = "path iterdir atomic audit: late failures do not roll back storage"
            READ_FAILED: sview = "path iterdir atomic audit: unable to read source: "
            SUCCESS: sview = "path iterdir atomic audit: late child-path failures roll back shared storage before publication"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_line(path: Path, first: sview, second: sview = "") -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, first, second):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)

            inputs: darray[Path] = [
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::BYTECODE),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            interpreter_body: EsSourceFunctionScope::FunctionBody = try EsSourceFunctionScope::read_function_body(inputs[0], Patterns::FUNCTION) else err:
                diagnostic(Messages::READ_FAILED + f"{inputs[0]}")
                return ExitStatus::IO_FAILURE
            if not interpreter_body.found or not EsSourceFunctionScope::contains(interpreter_body.text, Patterns::ENTRY_CURSOR):
                diagnostic(Messages::MISSING_CURSOR)
                return ExitStatus::FAILURE
            rollback_lines: usize = EsSourceFunctionScope::matching_line_count(interpreter_body.text, Patterns::STORAGE_ROLLBACK)
            # `rg -c` prints zero but exits nonzero for no matches, so the
            # reference's set -e exits silently before its custom count error.
            return ExitStatus::FAILURE if rollback_lines == 0
            if rollback_lines < 2:
                diagnostic(Messages::MISSING_ROLLBACK)
                return ExitStatus::FAILURE
            if not EsSourceFunctionScope::contains(interpreter_body.text, Patterns::JOIN_LENGTH_CHECK):
                return ExitStatus::FAILURE
            if not EsSourceFunctionScope::contains(interpreter_body.text, Patterns::SHAPE_CHECK):
                return ExitStatus::FAILURE

            status: mutable i64 = has_line(inputs[1], Patterns::BYTECODE_CALL)
            return status if status != 0i64
            status <- has_line(inputs[2], Patterns::FIXTURE)
            return status if status != 0i64
            status <- has_line(inputs[3], Patterns::DOCS_START, Patterns::DOCS_END)
            return status if status != 0i64
            status <- has_line(inputs[4], Patterns::LEDGER)
            return status if status != 0i64
            status <- has_line(inputs[4], Patterns::ATOMIC)
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsPathIterdirAtomicAudit::run_default()
