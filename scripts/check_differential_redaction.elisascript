# Bounded Elisascript port of check_differential_redaction.sh.
# Fixed-string source checks stream through the shared scanner without rg/awk.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDifferentialRedactionAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/testing/redaction_model.elisa"
            CONSUMER: sview = "src/testing/differential.elisa"
            FIXTURE: sview = "test/differential/elisascript_differential_test.elisa"
            DOCS: sview = "docs/differential-testing.md"


        const module Patterns:
            AVAILABLE_MINIMUM: sview = "available < 2"
            VALUE_FITS_AVAILABLE: sview = "value_length > available - 2"
            MODULE: sview = "module EsDifferentialRedaction:"
            RULE_LIMIT: sview = "Limits::RULES"
            ENTRY_LIMIT: sview = "Limits::ENTRIES"
            STATE_ENUM: sview = "const enum DifferentialRedactionState of u8:"
            EVENT_ENUM: sview = "const enum DifferentialRedactionEvent of u8:"
            POLICY: sview = "struct DifferentialRedactionPolicy:"
            SOURCE_ENTRY: sview = "struct DifferentialRedactionSourceEntry:"
            ENTRY: sview = "struct DifferentialRedactionEntry:"
            SESSION: sview = "struct DifferentialRedactionSession:"
            ERROR: sview = "error DifferentialRedactionError:"
            VALIDATE: sview = "def validate_differential_redaction_session("
            ADVANCE: sview = "def advance_differential_redaction("
            REDACT_ALL: sview = "redact_all"
            VALUE_FINGERPRINT: sview = "value_fingerprint"
            REDACTED: sview = "redacted"
            DUPLICATE_NAME: sview = "DuplicateName"
            TEXT_LIMIT: sview = "TextLimitExceeded"
            EXPECTED_TEXT_BYTES: sview = "expected_text_bytes"
            TEXT_ACCOUNTING: sview = "session.text_bytes != expected_text_bytes"
            NAME_SELECTED: sview = "differential_redaction_name_selected"
            FINGERPRINT: sview = "differential_redaction_value_fingerprint"
            MODEL_IMPORT: sview = "include \"./redaction_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsDifferentialRedaction"
            FIXTURE_CONTRACT: sview = "differential_redaction_contract_preserves_fingerprints_without_secret_values"
            FIXTURE_CAPTURE: sview = "DifferentialRedactionEvent.Capture"
            FIXTURE_EMPTY_VALUE: sview = "assert session.entries[1].value == \"\""
            FIXTURE_DUPLICATE_NAME: sview = "DifferentialRedactionError.DuplicateName"
            FIXTURE_FORGED_DUPLICATE: sview = "forged_redaction_duplicate"
            DOCS_POLICY: sview = "EsDifferentialRedaction::DifferentialRedactionPolicy"


        const module Messages:
            MISSING_ROOT: sview = "differential redaction audit: missing repository root"
            UNRESOLVED_ROOT: sview = "differential redaction audit: unable to resolve repository root"
            MISSING_INPUT: sview = "differential redaction audit: missing "
            READ_FAILED: sview = "differential redaction audit: unable to read source: "
            SUCCESS: sview = "differential redaction audit: bounded explicit secret selection, value fingerprints, and omission are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::AVAILABLE_MINIMUM},
                SearchCheck{input: inputs[0], pattern: Patterns::VALUE_FITS_AVAILABLE},
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::RULE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE_ENUM},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT_ENUM},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::SOURCE_ENTRY},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::REDACT_ALL},
                SearchCheck{input: inputs[0], pattern: Patterns::VALUE_FINGERPRINT},
                SearchCheck{input: inputs[0], pattern: Patterns::REDACTED},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_NAME},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPECTED_TEXT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_SELECTED},
                SearchCheck{input: inputs[0], pattern: Patterns::FINGERPRINT},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CAPTURE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_EMPTY_VALUE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_DUPLICATE_NAME},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_FORGED_DUPLICATE},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_POLICY}
            ]


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::CONSUMER),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            for check in searches(inputs):
                status: i64 = has_line(check.input, check.pattern)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDifferentialRedactionAudit::run_default()
