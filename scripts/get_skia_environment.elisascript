# Companion for Skia's infra/bots/recipe_modules/vars/resources/get_env_var.py.
# Native POSIX adapter candidate; public interpreted-launcher support is open.
include "../src/runtime/environment_lookup_posix.elisa"

module EsSkiaEnvironment:
    private:
        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr("get environment: " + message + "\n")

    public:
        def run(arguments: darray[sview]) -> i64 can[Environment.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
            if arguments.count == 0:
                diagnostic("expected an environment variable name")
                return 1i64
            name: sview = arguments[0]
            value: mutable EsEnvironmentLookup::Value = EsEnvironmentLookup::Value{present: false}
            impossible: bool = try EsEnvironmentLookup::impossible_key(name) else err:
                diagnostic("unable to read environment within bounds")
                return 2i64
            if not impossible:
                value <- try EsEnvironmentLookup::lookup(name) else err:
                    diagnostic("unable to read environment within bounds")
                    return 2i64
            output: sview = try EsEnvironmentLookup::python_print_value(value) else err:
                diagnostic("invalid environment lookup value")
                return 2i64
            written: usize = try write_stdout(output) else err:
                diagnostic("unable to write stdout")
                return 1i64
            if written != len(output):
                diagnostic("short stdout write")
                return 1i64
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Environment.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write]:
    return EsSkiaEnvironment::run(arguments)
