# Bounded Elisascript port of check_differential_case.sh.
# This audit covers differential inputs, process/resource limits, world
# materialization, artifact encoding, comparison, and registered fixtures.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDifferentialCaseAudit:
    private:
        const module Inputs:
            SOURCE: sview = "src/testing/differential.elisa"
            RUNNER: sview = "src/ir/runner.elisa"
            INTERPRETER: sview = "src/ir/interpret.elisa"
            BYTECODE: sview = "src/bytecode/bytecode.elisa"
            FIXTURE: sview = "test/differential/elisascript_differential_test.elisa"
            BYTECODE_FIXTURE: sview = "test/ir/elisascript_bytecode_test.elisa"
            DOCS: sview = "docs/differential-testing.md"


        const module Messages:
            MISSING_ROOT: sview = "differential case audit: missing repository root"
            UNRESOLVED_ROOT: sview = "differential case audit: unable to resolve repository root"
            MISSING_INPUT: sview = "differential case audit: missing file: "
            READ_FAILED: sview = "differential case audit: unable to read source: "
            MISSING_DECLARATION: sview = "differential case audit: missing declaration or helper "
            MISSING_CONTRACT: sview = "differential case audit: missing contract: "
            SUCCESS: sview = "differential case audit: typed case, hermetic world, and artifact manifest boundary present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def require_patterns(input: Path, patterns: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for pattern in patterns:
                found: bool = try EsSourceFunctionScope::contains_file_line(input, pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{input}")
                    return ExitStatus::IO_FAILURE
                if not found:
                    diagnostic(Messages::MISSING_CONTRACT + f"{pattern}")
                    return ExitStatus::FAILURE
            return 0i64


        def require_definitions(input: Path, names: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for name in names:
                declaration: sview = "def " + name + "("
                found: bool = try EsSourceFunctionScope::contains_file_line(input, declaration) else err:
                    diagnostic(Messages::READ_FAILED + f"{input}")
                    return ExitStatus::IO_FAILURE
                if not found:
                    diagnostic(Messages::MISSING_DECLARATION + f"{name}")
                    return ExitStatus::FAILURE
            return 0i64


        def require_any_patterns(inputs: darray[Path], patterns: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for pattern in patterns:
                found_any: mutable bool = false
                for input in inputs:
                    found: bool = try EsSourceFunctionScope::contains_file_line(input, pattern) else err:
                        diagnostic(Messages::READ_FAILED + f"{input}")
                        return ExitStatus::IO_FAILURE
                    found_any <- true if found
                    break if found_any
                if not found_any:
                    diagnostic(Messages::MISSING_CONTRACT + f"{pattern}")
                    return ExitStatus::FAILURE
            return 0i64


        def require_regex_line(input: Path, pattern_text: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(pattern_text)
            found: bool = try EsSourceFunctionScope::contains_file_regex_line(input, pattern) else err:
                diagnostic(Messages::READ_FAILED + f"{input}")
                return ExitStatus::IO_FAILURE
            if not found:
                diagnostic(Messages::MISSING_CONTRACT + f"{pattern_text}")
                return ExitStatus::FAILURE
            return 0i64


        def require_regex_text(input: Path, pattern_text: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(pattern_text)
            found: bool = try EsSourceFunctionScope::contains_file_regex_text(input, pattern) else err:
                diagnostic(Messages::READ_FAILED + f"{input}")
                return ExitStatus::IO_FAILURE
            if not found:
                diagnostic(Messages::MISSING_CONTRACT + f"{pattern_text}")
                return ExitStatus::FAILURE
            return 0i64


        def run_inputs(inputs: darray[Path]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            source: Path = inputs[0]
            runner: Path = inputs[1]
            interpreter: Path = inputs[2]
            bytecode: Path = inputs[3]
            fixture: Path = inputs[4]
            bytecode_fixture: Path = inputs[5]
            docs: Path = inputs[6]

            status: mutable i64 = require_patterns(source, [
                "const enum DifferentialWorldFileKind", "bytes: mutable darray[u8]",
                "InvalidWorldFileKind", "InvalidWorldFilePayload",
                "def differential_world_file_kind_valid", "def differential_world_hash_bytes"
            ])
            return status if status != 0i64

            status <- require_definitions(source, ["differential_world_file_kind_valid", "differential_world_hash_bytes"])
            return status if status != 0i64

            status <- require_patterns(source, [
                "struct DifferentialWorldFile", "struct DifferentialWorld", "struct DifferentialWorldSnapshot",
                "struct DifferentialWorldSnapshotCheck", "struct DifferentialWorldMaterializationPlan",
                "struct DifferentialWorldMaterializationCheck", "struct DifferentialCase", "struct DifferentialComparatorPolicy",
                "struct DifferentialArtifactManifest", "struct DifferentialArtifactManifestDecode",
                "struct DifferentialProcessStreamArtifact", "struct DifferentialProcessStreamArtifactDecode",
                "struct DifferentialReproductionArtifact", "struct DifferentialReproductionArtifactDecode",
                "struct DifferentialValuePoolArtifact", "struct DifferentialValuePoolArtifactDecode",
                "struct DifferentialArtifactIndex", "struct DifferentialArtifactIndexDecode",
                "struct DifferentialArtifactReplayCheck", "struct DifferentialArtifactDirectoryPlan",
                "struct DifferentialArtifactDirectoryCheck", "struct DifferentialShrinkCandidate", "struct DifferentialShrinkResult",
                "struct DifferentialRunShrinkCandidate", "struct DifferentialRunShrinkResult", "struct DifferentialOracle",
                "struct DifferentialOracleCheck", "struct DifferentialComparison", "struct DifferentialComparisonArtifact",
                "struct DifferentialComparisonArtifactDecode", "const enum DifferentialArtifactPolicy",
                "const enum DifferentialArtifactPublicationState", "const enum DifferentialArtifactReplayIssue",
                "const enum DifferentialArtifactDirectoryState", "const enum DifferentialArtifactDirectoryIssue",
                "const enum DifferentialShrinkKind", "const enum DifferentialRunShrinkKind", "const enum DifferentialOracleLanguage",
                "const enum DifferentialOracleIssue", "const enum DifferentialWorldSnapshotIssue",
                "const enum DifferentialWorldMaterializationState", "const enum DifferentialWorldMaterializationIssue",
                "const enum DifferentialCaseSide", "const enum DifferentialCaseIssueKind", "const enum DifferentialDifferenceKind",
                "const enum DifferentialRunOutcome", "const enum DifferentialTextComparison", "const enum DifferentialMapComparison"
            ])
            return status if status != 0i64

            status <- require_definitions(source, [
                "differential_case_effective_limit", "differential_case_runner_with_limits", "differential_runner_kind_valid",
                "prepare_differential_case_runner", "differential_stream_pair_within_limit"
            ])
            return status if status != 0i64
            status <- require_patterns(source, [
                "case.timeout_steps == 0 or case.timeout_steps <= DIFFERENTIAL_DEFAULT_MAX_TIMEOUT_STEPS",
                "case.max_output_bytes == 0 or case.max_output_bytes <= DIFFERENTIAL_DEFAULT_MAX_OUTPUT_BYTES",
                "runner.timeout_steps > 0 and runner.timeout_steps <= DIFFERENTIAL_DEFAULT_MAX_TIMEOUT_STEPS",
                "DifferentialRunnerIssueKind.InvalidKind", "invocation.timeout_steps > DIFFERENTIAL_DEFAULT_MAX_TIMEOUT_STEPS",
