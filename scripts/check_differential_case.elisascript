            status <- require_any_patterns(shared_paths, [
                "DifferentialShrinkKind.RemoveWorldFile", "DifferentialShrinkKind.ClearWorldFileBytes",
                "DifferentialShrinkKind.RemoveWorldArgument", "DifferentialShrinkKind.RemoveWorldEnvironment",
                "DifferentialShrinkKind.ClearWorldStdin", "DifferentialShrinkKind.ClearWorldStdinBytes", "shrink_differential_case",
                "DifferentialOracleLanguage.Python", "DifferentialOracleLanguage.Perl", "DifferentialOracleLanguage.Awk",
                "DifferentialOracleLanguage.Shell", "DifferentialOracleLanguage.C", "DifferentialOracleLanguage.Cpp",
                "DifferentialOracleIssue.NotIndependent", "validate_differential_oracle", "make_differential_oracle",
                "make_differential_world_snapshot", "validate_differential_world_snapshot",
                "DifferentialWorldSnapshotIssue.FingerprintMismatch", "def differential_value_kind_byte_valid",
                "unknown_value_kind[25] <- 255", "DifferentialWorldMaterializationState.Planned",
                "DifferentialWorldMaterializationState.Materialized", "DifferentialWorldMaterializationState.Running",
                "DifferentialWorldMaterializationState.Restoring", "DifferentialWorldMaterializationState.Restored",
                "DifferentialWorldMaterializationIssue.InvalidTransition", "make_differential_world_materialization_plan",
                "validate_differential_world_materialization", "advance_differential_world_materialization"
            ])
            return status if status != 0i64
            status <- require_patterns(fixture, [
                "DifferentialRunShrinkKind.ClearReferenceStdout", "DifferentialRunShrinkKind.ClearCandidateStdout",
                "DifferentialRunShrinkKind.ClearReferenceStderr", "DifferentialRunShrinkKind.ClearCandidateStderr",
                "DifferentialRunShrinkKind.RemoveReferenceObservation", "DifferentialRunShrinkKind.RemoveCandidateObservation",
                "shrink_differential_runs", "generic_restore: DifferentialWorldMaterializationCheck",
                "wrong_restore: DifferentialWorldMaterializationCheck", "forged_restored: mutable DifferentialWorldMaterializationPlan",
                "partial: mutable DifferentialWorldMaterializationPlan"
            ])
            return status if status != 0i64

            status <- require_definitions(fixture, [
                "differential_process_execution_captures_native_stdout_and_stderr",
                "differential_process_execution_feeds_stdin_without_shell_joining",
                "differential_process_execution_applies_environment_only_in_child",
                "differential_process_execution_keeps_nonzero_exit_status_as_data",
                "differential_process_execution_rejects_invalid_invocation_through_error_channel",
                "differential_process_execution_rejects_zero_output_limit_before_launch",
                "differential_process_execution_rejects_output_beyond_declared_limit",
                "differential_process_execution_rejects_stderr_beyond_declared_limit",
                "differential_process_execution_reports_bounded_timeout", "differential_process_timeout_owns_descendant_process_group"
            ])
            return status if status != 0i64
            status <- require_patterns(source, [
                "if not group_ready:", "differential_terminate_process(pid, false, status)",
                "raise DifferentialRunnerError.Process", "DifferentialWorldMaterializationState.Materializing",
                "differential_world_materialization_transition_allowed", "complete_differential_world_restoration",
                "plan.has_materialization_attempt", "plan.has_reference_restoration", "plan.has_candidate_restoration",
                "plan.reference_restored_world_fingerprint", "plan.candidate_restored_world_fingerprint"
            ])
            return status if status != 0i64
            status <- require_regex_line(docs, "Define a Case|DifferentialCase|artifact manifest|artifact")
            return status if status != 0i64

            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::SOURCE), root.joinpath(Inputs::RUNNER), root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::BYTECODE), root.joinpath(Inputs::FIXTURE), root.joinpath(Inputs::BYTECODE_FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input in inputs:
                if not is_file(input):
                    diagnostic(Messages::MISSING_INPUT + f"{input}")
                    return ExitStatus::IO_FAILURE
            status: i64 = run_inputs(inputs)
            return status if status != 0i64
            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::IO_FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDifferentialCaseAudit::run_default()
