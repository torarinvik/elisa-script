# Bounded Elisascript port of check_interpreter_paths.sh.
# Path admission checks use the shared bounded line scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsInterpreterPathsAudit:
    private:
        const module Inputs:
            INTERPRETER: sview = "src/ir/interpret.elisa"
            FIXTURE: sview = "test/ir/elisascript_interpreter_test.elisa"
            BYTECODE_FIXTURE: sview = "test/ir/elisascript_bytecode_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MAX_PATH_BYTES: Regex = regex"const INTERPRET_MAX_PATH_BYTES: usize = 4096"
            MAX_TEMP_PREFIX_BYTES: Regex = regex"const INTERPRET_MAX_TEMPORARY_PREFIX_BYTES: usize = INTERPRET_MAX_PATH_BYTES - 1 - 17 - 6"
            PATH_TEXT_VALID: Regex = regex"def path_text_valid\("
            EMPTY_OR_TOO_LONG: Regex = regex"return false if length == 0 or length >= INTERPRET_MAX_PATH_BYTES"
            REJECT_PATH_NUL: Regex = regex"return not text_has_nul\(value\)"
            PATH_SHAPE_TEXT_VALID: Regex = regex"def path_shape_text_valid\("
            PATH_SHAPE_RESULT_VALID: Regex = regex"def path_shape_result_valid\("
            SHAPE_LENGTH_BOUND: Regex = regex"return false if sview_len\(value\) >= INTERPRET_MAX_PATH_BYTES"
            JOINED_VALID: Regex = regex"path_shape_result_valid\(bytes_view\(joined\)\)"
            NORMALIZED_VALID: Regex = regex"path_shape_result_valid\(bytes_view\(normalized\)\)"
            RELATIVE_VALID: Regex = regex"path_shape_result_valid\(bytes_view\(relative\)\)"
            PATH_VALUE_INPUT_VALID: Regex = regex"def path_value_input_valid\("
            PATH_VALUE_OUTPUT_VALID: Regex = regex"def path_value_output_valid\("
            NUL_TERMINATED_PATH: Regex = regex"def nul_terminated_path\("
            INVALID_PATH_EMPTY_RESULT: Regex = regex"return \[\] if not path_text_valid\(value\)"
            HOST_PATH_LENGTH: Regex = regex"def host_path_cstring_length_bounded\("
            HOST_PATH_LENGTH_LOOP: Regex = regex"while length < INTERPRET_MAX_PATH_BYTES"
            HOST_PATH_CAPACITY_LOOP: Regex = regex"while capacity <= INTERPRET_MAX_PATH_BYTES"
            HOST_PATH_COUNT_BOUND: Regex = regex"count.usize\(\) == 0 or count.usize\(\) >= INTERPRET_MAX_PATH_BYTES"
            HOST_PATH_FOUND_ITEMS: Regex = regex"host_path_cstring_length_bounded\(found_items, too_large\)"
            SCANNER_DIRECTORY_CLEAR: Regex = regex"scanner\.directory <- null"
            C_PATH_ADMITTED: Regex = regex"c_path: dstr = nul_terminated_path\("
            C_SOURCE_ADMITTED: Regex = regex"c_source: dstr = nul_terminated_path\("
            C_TARGET_ADMITTED: Regex = regex"c_target: dstr = nul_terminated_path\("
            WORKING_DIRECTORY_ADMITTED: Regex = regex"working_directory_bytes <- nul_terminated_path\("
            WORKING_DIRECTORY_VALID: Regex = regex"not path_text_valid\(working_directory\.text\)"
            TEMP_PREFIX_LIMIT: Regex = regex"sview_len\(prefix\.text\) > INTERPRET_MAX_TEMPORARY_PREFIX_BYTES"
            OVERSIZED_TEMP_PREFIX_FIXTURE: Regex = regex"interpreter_rejects_oversized_temporary_prefix_before_nul_scan"
            TEMP_PREFIX_BOUNDARY: Regex = regex"sview\(\"\", 0, 4073\)"
            PATH_TOTAL_BOUND: Regex = regex"return \[\] if total >= INTERPRET_MAX_PATH_BYTES"
            DIRECTORY_NAME_BOUND: Regex = regex"scanner\.name_bytes > INTERPRET_MAX_DIRECTORY_NAME_BYTES"
            DIRECTORY_NAME_REMAINING: Regex = regex"length > INTERPRET_MAX_DIRECTORY_NAME_BYTES - scanner\.name_bytes"
            PATH_JOIN_LENGTH_FITS: Regex = regex"def path_join_length_fits\(base: sview, leaf: sview\)"
            JOIN_BASE_LEAF: Regex = regex"if not path_join_length_fits\(base\.text, leaf\.text\)"
            JOIN_PATH_NAME: Regex = regex"if not path_join_length_fits\(path\.text, bytes_view\(name\)\)"
            JOIN_PATH_PATTERN: Regex = regex"if not path_join_length_fits\(path\.text, pattern_text\)"
            PATTERN_TEXT_VALID: Regex = regex"if not path_text_valid\(pattern\.text\)"
            CHILD_SHAPE_VALID: Regex = regex"if not path_shape_result_valid\(bytes_view\(child\)\)"
            JOINED_SHAPE_VALID: Regex = regex"if not path_shape_result_valid\(bytes_view\(joined\)\)"
            OVERSIZED_GLOB_FIXTURE: Regex = regex"interpreter_rejects_oversized_glob_before_scan"
            PATH_4096_BOUNDARY: Regex = regex"sview\(\"\", 0, 4096\)"
            CSTRING_BYPASS: Regex = regex"c_(path|source|destination|target|link): dstr = nul_terminated_text\("
            EMPTY_PATH_NUL_SCAN: Regex = regex"sview_len\(path\.text\) == 0 or text_has_nul\(path\.text\)"
            SOURCE_DESTINATION_NUL_SCAN: Regex = regex"sview_len\(source\.text\) == 0 or sview_len\(destination\.text\) == 0 or text_has_nul\(source\.text\)"
            SOURCE_DESTINATION_BARE_NUL_SCAN: Regex = regex"sview_len\(source\) == 0 or sview_len\(destination\) == 0 or text_has_nul\(source\)"
            BARE_PATH_NUL_SCAN: Regex = regex"sview_len\(path\) == 0 or text_has_nul\(path\)"
            OVERSIZED_PATH_CSTRING_FIXTURE: Regex = regex"interpreter_rejects_oversized_path_before_c_string_allocation"
            PURE_PATH_ARENA_FIXTURE: Regex = regex"interpreter_rejects_oversized_pure_path_before_arena_allocation"
            BYTECODE_PURE_PATH_ARENA_FIXTURE: Regex = regex"bytecode_direct_rejects_oversized_pure_path_before_arena_allocation"
            EMPTY_PATH_DOCS: Regex = regex"All filesystem text and byte operations reject an empty path"
            PATH_DOCS: Regex = regex"4 KiB path admission|4096-byte path|interpreter.*path"
            LEDGER_ITEM: Regex = regex"ES-FS-001"
            LEDGER_INTERPRETER: Regex = regex"interpret\.elisa"


        const module Messages:
            MISSING_ROOT: sview = "interpreter path audit: missing repository root"
            UNRESOLVED_ROOT: sview = "interpreter path audit: unable to resolve repository root"
            MISSING_INPUT: sview = "interpreter path audit: missing "
            READ_FAILED: sview = "interpreter path audit: unable to read source: "
            CSTRING_BYPASS: sview = "interpreter path audit: a filesystem c-string still bypasses path admission"
            SUCCESS: sview = "interpreter path audit: bounded path admission precedes C-string scans and host calls"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        const enum Expectation of u8:
            Present
            Absent


        struct SearchCheck:
            input: Path
            pattern: Regex
            expectation: Expectation = Expectation.Present
            violation_message: sview = ""


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_PATH_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_TEMP_PREFIX_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_TEXT_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::EMPTY_OR_TOO_LONG},
                SearchCheck{input: inputs[0], pattern: Patterns::REJECT_PATH_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_SHAPE_TEXT_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_SHAPE_RESULT_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::SHAPE_LENGTH_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::JOINED_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::NORMALIZED_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::RELATIVE_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_VALUE_INPUT_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_VALUE_OUTPUT_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::NUL_TERMINATED_PATH},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_PATH_EMPTY_RESULT},
                SearchCheck{input: inputs[0], pattern: Patterns::HOST_PATH_LENGTH},
                SearchCheck{input: inputs[0], pattern: Patterns::HOST_PATH_LENGTH_LOOP},
                SearchCheck{input: inputs[0], pattern: Patterns::HOST_PATH_CAPACITY_LOOP},
                SearchCheck{input: inputs[0], pattern: Patterns::HOST_PATH_COUNT_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::HOST_PATH_FOUND_ITEMS},
                SearchCheck{input: inputs[0], pattern: Patterns::SCANNER_DIRECTORY_CLEAR},
                SearchCheck{input: inputs[0], pattern: Patterns::C_PATH_ADMITTED},
                SearchCheck{input: inputs[0], pattern: Patterns::C_SOURCE_ADMITTED},
                SearchCheck{input: inputs[0], pattern: Patterns::C_TARGET_ADMITTED},
                SearchCheck{input: inputs[0], pattern: Patterns::WORKING_DIRECTORY_ADMITTED},
                SearchCheck{input: inputs[0], pattern: Patterns::WORKING_DIRECTORY_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::TEMP_PREFIX_LIMIT},
                SearchCheck{input: inputs[1], pattern: Patterns::OVERSIZED_TEMP_PREFIX_FIXTURE},
                SearchCheck{input: inputs[1], pattern: Patterns::TEMP_PREFIX_BOUNDARY},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_TOTAL_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::DIRECTORY_NAME_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::DIRECTORY_NAME_REMAINING},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_JOIN_LENGTH_FITS},
                SearchCheck{input: inputs[0], pattern: Patterns::JOIN_BASE_LEAF},
                SearchCheck{input: inputs[0], pattern: Patterns::JOIN_PATH_NAME},
                SearchCheck{input: inputs[0], pattern: Patterns::JOIN_PATH_PATTERN},
                SearchCheck{input: inputs[0], pattern: Patterns::PATTERN_TEXT_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::CHILD_SHAPE_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::JOINED_SHAPE_VALID},
                SearchCheck{input: inputs[1], pattern: Patterns::OVERSIZED_GLOB_FIXTURE},
                SearchCheck{input: inputs[1], pattern: Patterns::PATH_4096_BOUNDARY},
                SearchCheck{input: inputs[0], pattern: Patterns::CSTRING_BYPASS, expectation: Expectation.Absent, violation_message: Messages::CSTRING_BYPASS},
                SearchCheck{input: inputs[0], pattern: Patterns::EMPTY_PATH_NUL_SCAN, expectation: Expectation.Absent, violation_message: "interpreter path audit: unbounded path NUL scan remains: sview_len(path.text) == 0 or text_has_nul(path.text)"},
                SearchCheck{input: inputs[0], pattern: Patterns::SOURCE_DESTINATION_NUL_SCAN, expectation: Expectation.Absent, violation_message: "interpreter path audit: unbounded path NUL scan remains: sview_len(source.text) == 0 or sview_len(destination.text) == 0 or text_has_nul(source.text)"},
                SearchCheck{input: inputs[0], pattern: Patterns::SOURCE_DESTINATION_BARE_NUL_SCAN, expectation: Expectation.Absent, violation_message: "interpreter path audit: unbounded path NUL scan remains: sview_len(source) == 0 or sview_len(destination) == 0 or text_has_nul(source)"},
                SearchCheck{input: inputs[0], pattern: Patterns::BARE_PATH_NUL_SCAN, expectation: Expectation.Absent, violation_message: "interpreter path audit: unbounded path NUL scan remains: sview_len(path) == 0 or text_has_nul(path)"},
                SearchCheck{input: inputs[1], pattern: Patterns::OVERSIZED_PATH_CSTRING_FIXTURE},
                SearchCheck{input: inputs[1], pattern: Patterns::PURE_PATH_ARENA_FIXTURE},
                SearchCheck{input: inputs[2], pattern: Patterns::BYTECODE_PURE_PATH_ARENA_FIXTURE},
                SearchCheck{input: inputs[1], pattern: Patterns::PATH_4096_BOUNDARY},
                SearchCheck{input: inputs[3], pattern: Patterns::EMPTY_PATH_DOCS},
                SearchCheck{input: inputs[3], pattern: Patterns::PATH_DOCS},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_INTERPRETER}
            ]


        def search_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                ok found:
                    return 0i64 if found
                    return 1i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return ExitStatus::IO_FAILURE


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                status: i64 = search_status(check)
                match check.expectation:
                    Expectation.Present:
                        return status if status != 0i64
                        continue
                    Expectation.Absent:
                        if status == 0i64:
                            diagnostic(check.violation_message)
                            return ExitStatus::FAILURE
                        return status if status != 1i64
                        continue
                    _:
                        return ExitStatus::FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::BYTECODE_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsInterpreterPathsAudit::run_default()
