# Bounded Elisascript port of check_process_output.sh.
# Regex source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsProcessOutputAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/process_output_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"
            BYTECODE: sview = "src/bytecode/bytecode.elisa"


        const module Patterns:
            BYTECODE_STDERR_LIMIT: Regex = regex"stderr_length > ES_RUNTIME_DEFAULT_MAX_OUTPUT_BYTES"
            BYTECODE_STDOUT_LIMIT: Regex = regex"stdout_length > ES_RUNTIME_DEFAULT_MAX_OUTPUT_BYTES - stderr_length"
            BYTECODE_CURSOR_LIMIT: Regex = regex"cursor.output_bytes > ES_RUNTIME_DEFAULT_MAX_OUTPUT_BYTES"
            MODULE: Regex = regex"^module EsProcessOutput:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/process_output_model\.elisa\""
            DESTINATION_KIND: Regex = regex"const enum ProcessOutputDestinationKind of u8"
            STATE: Regex = regex"const enum ProcessOutputState of u8"
            EVENT: Regex = regex"const enum ProcessOutputEvent of u8"
            DESTINATION: Regex = regex"struct ProcessOutputDestination:"
            ROUTE: Regex = regex"struct ProcessOutputRoute:"
            CHUNK: Regex = regex"struct ProcessOutputChunk:"
            SESSION: Regex = regex"struct ProcessOutputSession:"
            ERROR: Regex = regex"error ProcessOutputError:"
            SAME_SINK: Regex = regex"def process_output_destination_same_sink\("
            VALIDATE: Regex = regex"def validate_process_output_session\("
            ADVANCE: Regex = regex"def advance_process_output\("
            DESTINATIONS: Regex = regex"Limits::DESTINATIONS"
            CHUNKS: Regex = regex"Limits::CHUNKS"
            BYTES: Regex = regex"Limits::BYTES"
            PATH_BYTES: Regex = regex"Limits::PATH_BYTES"
            TRUNCATE_FILE: Regex = regex"ProcessOutputDestinationKind.TruncateFile"
            APPEND_FILE: Regex = regex"ProcessOutputDestinationKind.AppendFile"
            DUPLICATE_DESTINATION: Regex = regex"ProcessOutputError.DuplicateDestination"
            SAME_FILE: Regex = regex"left_is_file and right_is_file and left.path == right.path"
            CHUNK_ORDER: Regex = regex"ProcessOutputError.ChunkOrderInvalid"
            ACCOUNTING: Regex = regex"ProcessOutputError.AccountingInvalid"
            SEQUENCE_COUNT: Regex = regex"session.next_sequence != session.chunk_count"
            CLOSED_STATE: Regex = regex"ProcessOutputState.Closed"
            FIXTURE_IMPORT: Regex = regex"using EsProcessOutput"
            FIXTURE_CONTRACT: Regex = regex"typed_process_output_contract_makes_redirection_and_tee_explicit"
            FIXTURE_APPEND: Regex = regex"ProcessOutputDestinationKind.AppendFile"
            FIXTURE_DUPLICATE: Regex = regex"ProcessOutputError.DuplicateDestination"
            FIXTURE_CONFLICTING_MODES: Regex = regex"conflicting_file_modes"
            FIXTURE_DISTINCT_MODES: Regex = regex"distinct_file_modes"
            FIXTURE_CHUNK: Regex = regex"ProcessOutputChunk"
            DOCS_SESSION: Regex = regex"EsProcessOutput::ProcessOutputSession"
            LEDGER_ERROR: Regex = regex"ProcessOutputError"


        const module Messages:
            MISSING_ROOT: sview = "process output audit: missing repository root"
            UNRESOLVED_ROOT: sview = "process output audit: unable to resolve repository root"
            MISSING_INPUT: sview = "process output audit: missing "
            READ_FAILED: sview = "process output audit: unable to read source: "
            SUCCESS: sview = "process output audit: bounded redirection, append, capture, and tee routing are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[5], pattern: Patterns::BYTECODE_STDERR_LIMIT},
                SearchCheck{input: inputs[5], pattern: Patterns::BYTECODE_STDOUT_LIMIT},
                SearchCheck{input: inputs[5], pattern: Patterns::BYTECODE_CURSOR_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::DESTINATION_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::DESTINATION},
                SearchCheck{input: inputs[0], pattern: Patterns::ROUTE},
                SearchCheck{input: inputs[0], pattern: Patterns::CHUNK},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::SAME_SINK},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::DESTINATIONS},
                SearchCheck{input: inputs[0], pattern: Patterns::CHUNKS},
                SearchCheck{input: inputs[0], pattern: Patterns::BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::TRUNCATE_FILE},
                SearchCheck{input: inputs[0], pattern: Patterns::APPEND_FILE},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_DESTINATION},
                SearchCheck{input: inputs[0], pattern: Patterns::SAME_FILE},
                SearchCheck{input: inputs[0], pattern: Patterns::CHUNK_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::SEQUENCE_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::CLOSED_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_APPEND},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_DUPLICATE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONFLICTING_MODES},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_DISTINCT_MODES},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CHUNK},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ERROR}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER),
                root.joinpath(Inputs::BYTECODE)
            ]
            preflight: darray[Path] = [inputs[0], inputs[1], inputs[2], inputs[3], inputs[4]]
            for input_path in preflight:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsProcessOutputAudit::run_default()
