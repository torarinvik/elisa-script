# Bounded Elisascript port of check_cli_workflow.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsCliWorkflowAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/cli_workflow_model.elisa"
            CLI_MODEL: sview = "src/runtime/cli_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DRIVER: sview = "src/driver/elisascript.elisa"
            STDIO: sview = "src/runtime/stdio_posix.elisa"
            TEST_SMOKE: sview = "test/driver/elisascript_bounded_test_smoke.elisascript"
            RUNNER_TEST: sview = "test/ir/elisascript_runner_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "module EsCliWorkflow:"
            LIMITS: sview = "const module Limits:"
            STEPS_LIMIT: sview = "Limits::STEPS"
            STEP: sview = "const enum CliWorkflowStep of u8:"
            STATE: sview = "const enum CliWorkflowState of u8:"
            EVENT: sview = "const enum CliWorkflowEvent of u8:"
            WORKFLOW: sview = "struct CliWorkflow:"
            ERROR: sview = "error CliWorkflowError:"
            VALIDATE: sview = "def validate_cli_workflow("
            PLAN: sview = "def plan_cli_workflow("
            ADVANCE: sview = "def advance_cli_workflow("
            MODE_SHAPE: sview = "workflow_mode_shape_valid"
            STEP_ORDER: sview = "StepOrderInvalid"
            PLANNED: sview = "workflow.state == CliWorkflowState.Planned"
            RUNNING: sview = "workflow.state == CliWorkflowState.Running"
            CANCELLING: sview = "workflow.state == CliWorkflowState.Cancelling"
            COMPLETE: sview = "workflow.state == CliWorkflowState.Complete"
            TERMINAL: sview = "workflow.state == CliWorkflowState.Failed or workflow.state == CliWorkflowState.Cancelled"
            CURSOR_BOUNDS: sview = "and workflow.next_step >= workflow.steps.count"
            STEP_NOT_READY: sview = "StepNotReady"
            INVOCATION_INVALID: sview = "InvocationInvalid"
            MODE_CHECK: sview = "CliMode.Check"
            MODE_TEST: sview = "CliMode.Test"
            MODE_FMT: sview = "CliMode.Fmt"
            MODE_DOC: sview = "CliMode.Doc"
            CANCEL_NOT_READY: sview = "CancelNotReady"
            IR_IMPORT: sview = "include \"../runtime/cli_workflow_model.elisa\""
            DRIVER_TEST_MODE: sview = "request.mode == EsCli::CliMode.Test"
            DRIVER_EXECUTE_TESTS: sview = "execute_elisascript_file_tests"
            DRIVER_TEST_REPORT: sview = "build_elisascript_test_report"
            DRIVER_OUTPUT_DOCUMENT: sview = "write_output_document_fd"
            DRIVER_REPORT_FORMAT: sview = "request.report_format <- invocation.report_format"
            DRIVER_JSON: sview = "requested_format == EsCli::CliReportFormat.Json"
            DRIVER_JUNIT: sview = "requested_format == EsCli::CliReportFormat.Junit"
            DRIVER_TEST_SELECTION: sview = "request.test_selection <- invocation.test_selection"
            DRIVER_SELECTED_NAMES: sview = "selected_names: selected_names"
            RUNNER_JSON_OPTIONS: sview = "json_options: OutputOptions = OutputOptions{format: OutputFormat.Json"
            RUNNER_JUNIT_OPTIONS: sview = "junit_options: OutputOptions = OutputOptions{format: OutputFormat.Junit"
            DRIVER_ISATTY: sview = "elisascript_posix_isatty"
            STDIO_ISATTY: sview = "def elisascript_posix_isatty("
            SMOKE_TEST: sview = "@test"
            FIXTURE_IMPORT: sview = "using EsCliWorkflow"
            FIXTURE_CONTRACT: sview = "typed_cli_workflow_contract_maps_modes_to_ordered_steps"
            STEP_COMPLETE: sview = "CliWorkflowEvent.StepComplete"
            STEP_VERIFY: sview = "CliWorkflowStep.Verify"
            STEP_EXECUTE_TESTS: sview = "CliWorkflowStep.ExecuteTests"
            STEP_FORMAT: sview = "CliWorkflowStep.Format"
            CANCEL_ACK: sview = "CliWorkflowEvent.CancelAck"
            FORGED_CANCELLING_CURSOR: sview = "forged_cancelling_cursor"
            ASSERT_CANCELLATION: sview = "assert validate_cli_workflow(cancellation)"
            FAILED_WORKFLOW: sview = "failed_workflow"
            ASSERT_FAILURE: sview = "assert validate_cli_workflow(failed_workflow)"
            DOCS_WORKFLOW: sview = "EsCliWorkflow separates planning from host execution"
            LEDGER_WORKFLOW: sview = "ES-SCRIPT-008 | EsCliWorkflow"


        const module Messages:
            MISSING_ROOT: sview = "cli workflow audit: missing repository root"
            UNRESOLVED_ROOT: sview = "cli workflow audit: unable to resolve repository root"
            MISSING_INPUT: sview = "cli workflow audit: missing "
            READ_FAILED: sview = "cli workflow audit: unable to read source: "
            SUCCESS: sview = "cli workflow audit: mode-specific step plans, ordering validation, completion, failure, and cancellation are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path], runner_test: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMITS},
                SearchCheck{input: inputs[0], pattern: Patterns::STEPS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::STEP},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::WORKFLOW},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::PLAN},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::MODE_SHAPE},
                SearchCheck{input: inputs[0], pattern: Patterns::STEP_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED},
                SearchCheck{input: inputs[0], pattern: Patterns::RUNNING},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLING},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETE},
                SearchCheck{input: inputs[0], pattern: Patterns::TERMINAL},
                SearchCheck{input: inputs[0], pattern: Patterns::CURSOR_BOUNDS},
                SearchCheck{input: inputs[0], pattern: Patterns::STEP_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::INVOCATION_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::MODE_CHECK},
                SearchCheck{input: inputs[0], pattern: Patterns::MODE_TEST},
                SearchCheck{input: inputs[0], pattern: Patterns::MODE_FMT},
                SearchCheck{input: inputs[0], pattern: Patterns::MODE_DOC},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_NOT_READY},
                SearchCheck{input: inputs[2], pattern: Patterns::IR_IMPORT},
                SearchCheck{input: inputs[4], pattern: Patterns::DRIVER_TEST_MODE},
                SearchCheck{input: inputs[4], pattern: Patterns::DRIVER_EXECUTE_TESTS},
                SearchCheck{input: inputs[4], pattern: Patterns::DRIVER_TEST_REPORT},
                SearchCheck{input: inputs[4], pattern: Patterns::DRIVER_OUTPUT_DOCUMENT},
                SearchCheck{input: inputs[4], pattern: Patterns::DRIVER_REPORT_FORMAT},
                SearchCheck{input: inputs[4], pattern: Patterns::DRIVER_JSON},
                SearchCheck{input: inputs[4], pattern: Patterns::DRIVER_JUNIT},
                SearchCheck{input: inputs[4], pattern: Patterns::DRIVER_TEST_SELECTION},
                SearchCheck{input: inputs[4], pattern: Patterns::DRIVER_SELECTED_NAMES},
                SearchCheck{input: runner_test, pattern: Patterns::RUNNER_JSON_OPTIONS},
                SearchCheck{input: runner_test, pattern: Patterns::RUNNER_JUNIT_OPTIONS},
                SearchCheck{input: inputs[4], pattern: Patterns::DRIVER_ISATTY},
                SearchCheck{input: inputs[5], pattern: Patterns::STDIO_ISATTY},
                SearchCheck{input: inputs[6], pattern: Patterns::SMOKE_TEST},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[3], pattern: Patterns::STEP_COMPLETE},
                SearchCheck{input: inputs[3], pattern: Patterns::STEP_VERIFY},
                SearchCheck{input: inputs[3], pattern: Patterns::STEP_EXECUTE_TESTS},
                SearchCheck{input: inputs[3], pattern: Patterns::STEP_FORMAT},
                SearchCheck{input: inputs[3], pattern: Patterns::CANCEL_ACK},
                SearchCheck{input: inputs[3], pattern: Patterns::FORGED_CANCELLING_CURSOR},
                SearchCheck{input: inputs[3], pattern: Patterns::ASSERT_CANCELLATION},
                SearchCheck{input: inputs[3], pattern: Patterns::FAILED_WORKFLOW},
                SearchCheck{input: inputs[3], pattern: Patterns::ASSERT_FAILURE},
                SearchCheck{input: inputs[7], pattern: Patterns::DOCS_WORKFLOW},
                SearchCheck{input: inputs[8], pattern: Patterns::LEDGER_WORKFLOW}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::CLI_MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DRIVER),
                root.joinpath(Inputs::STDIO),
                root.joinpath(Inputs::TEST_SMOKE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            runner_test: Path = root.joinpath(Inputs::RUNNER_TEST)
            status: i64 = execute(searches(inputs, runner_test))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsCliWorkflowAudit::run_default()
