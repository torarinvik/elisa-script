# Bounded Elisascript port of the AWK manifest checks and declared-root
# containment audit in check_migration_roots.sh. It reads metadata only; it
# never scans or executes anything inside a declared project root.

include "../src/runtime/encoding.elisa"
include "../src/runtime/file_posix.elisa"
include "../src/runtime/directory_posix.elisa"
include "../src/runtime/stdio_posix.elisa"

using EsEncoding
using EsRuntime


module EsMigrationRootsAudit:
    public:
        error MigrationRootsError:
            InputLimitExceeded
            HeaderInvalid
            RecordShapeInvalid
            FieldInvalid
            DuplicateName
            DuplicatePath
            EmptyManifest


    private:
        const module Limits:
            MANIFEST_BYTES: usize = 1048576
            ROWS: usize = 4096
            FIELD_BYTES: usize = 65536
            PATH_BYTES: usize = 4096
            READ_CHUNK_BYTES: usize = 16384
            READ_EINTR_RETRIES: usize = 4


        const module Syntax:
            HEADER: sview = "# name\trelative_path\towner\treview_status"


        const module Messages:
            ROOT_MISSING: sview = "migration roots audit: coding-projects root does not exist: "
            MANIFEST_MISSING: sview = "migration roots audit: manifest does not exist: "
            ROOT_CANONICAL_FAILED: sview = "migration roots audit: unable to canonicalize coding-projects root"
            MANIFEST_READ_FAILED: sview = "migration roots audit: unable to read manifest"
            MANIFEST_TOO_LARGE: sview = "migration roots audit: manifest exceeds audit limit"
            MANIFEST_INVALID: sview = "migration roots audit: malformed, duplicated, unsafe, or unowned reviewed row"
            DECLARED_ROOT_MISSING: sview = "migration roots audit: declared root is missing: "
            DECLARED_ROOT_CANONICAL_FAILED: sview = "migration roots audit: unable to canonicalize declared root: "
            ROOT_ESCAPES: sview = "migration roots audit: declared root escapes coding-projects tree through a symlink: "


        struct RootRow:
            name: sview
            relative_path: sview
            owner: sview
            review_status: sview


        struct BoundedManifestRead:
            contents: sview = ""
            failure: bool = false
            changed: bool = false
            exceeded_limit: bool = false


        const enum ManifestReadPhase of u8:
            ReadChunk
            Done


        def roots_manifest_open(path_value: cstr) -> int can[Blocking.IO]:
            retries: mutable usize = 0
            flags: int = DarwinOpenFlags::RDONLY | DarwinOpenFlags::NONBLOCK | DarwinOpenFlags::CLOSE_ON_EXEC
            while true:
                descriptor: int = elisascript_posix_open(path_value, flags, 0u32)
                return descriptor if descriptor >= 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::READ_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return -1


        def roots_manifest_stat(path_value: cstr, result: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_stat(path_value, result) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::READ_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def roots_manifest_fstat(descriptor: int, result: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_fstat(descriptor, result) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::READ_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def roots_manifest_same_file(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return left.device == right.device and left.inode == right.inode


        def roots_manifest_stable_file(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return roots_manifest_same_file(left, right) and left.size == right.size and left.modify_time == right.modify_time and left.change_time == right.change_time


        def roots_manifest_utf8_valid(contents: sview) -> bool:
            cursor: mutable EsEncoding::Utf8Cursor = EsEncoding::Utf8Cursor{}
            for offset in 0..<len(contents) |contents, cursor|:
                return false if not EsEncoding::utf8_feed(sview_at(contents, offset), cursor)
            return EsEncoding::utf8_complete(cursor)


        def read_manifest_bounded(manifest_path: Path, maximum_bytes: usize) -> BoundedManifestRead can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_text: sview = f"{manifest_path}"
            if path_text == "" or len(path_text) >= Limits::PATH_BYTES or sview_contains_byte(path_text, 0):
                return BoundedManifestRead{failure: true}
            path_bytes: mutable darray[u8] = []
            for byte in path_text |path_bytes|:
                path_bytes.push(byte)
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr]

            named_before_open: mutable ElisascriptStat = zeroed
            if not roots_manifest_stat(path_pointer, named_before_open) or (named_before_open.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR:
                return BoundedManifestRead{failure: true}
            descriptor: int = roots_manifest_open(path_pointer)
            return BoundedManifestRead{failure: true} if descriptor < 0
            opened: mutable ElisascriptStat = zeroed
            if not roots_manifest_fstat(descriptor, opened) or (opened.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR or not roots_manifest_same_file(named_before_open, opened):
                _ = elisascript_posix_close(descriptor)
                return BoundedManifestRead{failure: true}
            named_after_open: mutable ElisascriptStat = zeroed
            if not roots_manifest_stat(path_pointer, named_after_open) or not roots_manifest_same_file(opened, named_after_open):
                _ = elisascript_posix_close(descriptor)
                return BoundedManifestRead{changed: true}

            chunk: mutable darray[u8] = []
            chunk.reserve(Limits::READ_CHUNK_BYTES)
            for _ in 0..<Limits::READ_CHUNK_BYTES |chunk|:
                chunk.push(0u8)
            bytes: mutable darray[u8] = []
            initial_capacity: usize = maximum_bytes if maximum_bytes < Limits::READ_CHUNK_BYTES else Limits::READ_CHUNK_BYTES
            bytes.reserve(initial_capacity)
            phase: mutable ManifestReadPhase = ManifestReadPhase.ReadChunk
            interrupted: mutable usize = 0
            machine over phase while phase != ManifestReadPhase.Done:
                state ReadChunk
                start ReadChunk

                ReadChunk, ManifestReadPhase.ReadChunk:
                    remaining: usize = maximum_bytes - bytes.count
                    probe_capacity: usize = remaining + 1
                    capacity: usize = probe_capacity if probe_capacity < chunk.count else chunk.count
                    chunk_pointer: mutable u8& = (&chunk[0]).cast[mutable u8&]
                    amount: isize = elisascript_posix_read(descriptor, chunk_pointer.cast[mutable void&], capacity)
                    if amount < 0:
                        errno: mutable i32& = elisascript_posix_errno()
                        if errno[0] == DarwinErrno::EINTR and interrupted < Limits::READ_EINTR_RETRIES:
                            interrupted <- interrupted + 1
                            -> ReadChunk
                        _ = elisascript_posix_close(descriptor)
                        return BoundedManifestRead{failure: true}
                    if amount == 0:
                        phase <- ManifestReadPhase.Done
                        continue
                    read_count: usize = amount.usize()
                    if read_count > capacity:
                        _ = elisascript_posix_close(descriptor)
                        return BoundedManifestRead{failure: true}
                    if read_count > remaining:
                        _ = elisascript_posix_close(descriptor)
                        return BoundedManifestRead{exceeded_limit: true}
                    for offset in 0..<read_count |bytes, chunk|:
                        bytes.push(chunk[offset])
                    interrupted <- 0
                    -> ReadChunk

                ReadChunk, ManifestReadPhase.Done:
                    break

            final_opened: mutable ElisascriptStat = zeroed
            final_named: mutable ElisascriptStat = zeroed
            stable: bool = roots_manifest_fstat(descriptor, final_opened) and roots_manifest_stat(path_pointer, final_named) and roots_manifest_stable_file(opened, final_opened) and roots_manifest_same_file(final_opened, final_named)
            close_status: int = elisascript_posix_close(descriptor)
            if close_status != 0:
                return BoundedManifestRead{failure: true}
            if not stable:
                return BoundedManifestRead{changed: true}
            contents: sview = bytes_view(bytes)
            return BoundedManifestRead{failure: true} if not roots_manifest_utf8_valid(contents)
            return BoundedManifestRead{contents: contents}


        def relative_root_path_valid(value: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if value == "" or len(value) >= Limits::PATH_BYTES
            return false if path_is_absolute(path(value)) or value.startswith("./")
            components: darray[sview] = split(value, "/")
            for component in components:
                return false if component == ".."
            return true


        def root_row_from_fields(fields: darray[sview]) -> RootRow error[MigrationRootsError] can[Memory.Allocate, Abort.Panic]:
            raise MigrationRootsError.RecordShapeInvalid if fields.count != 4
            for field in fields:
                raise MigrationRootsError.FieldInvalid if field == "" or len(field) > Limits::FIELD_BYTES
            raise MigrationRootsError.FieldInvalid if not relative_root_path_valid(fields[1])
            raise MigrationRootsError.FieldInvalid if fields[3] != "pending" and fields[3] != "reviewed" and fields[3] != "blocked"
            raise MigrationRootsError.FieldInvalid if fields[3] == "reviewed" and fields[2] == "unassigned"
            return RootRow{name: fields[0], relative_path: fields[1], owner: fields[2], review_status: fields[3]}


        def roots_have_duplicate_names(rows: darray[RootRow]) -> bool can[Memory.Allocate, Abort.Panic]:
            names: mutable darray[sview] = []
            for row in rows:
                names.push(row.name)
            ordered_names: darray[sview] = sorted(names)
            for index in 1..<ordered_names.count |ordered_names|:
                return true if ordered_names[index - 1] == ordered_names[index]
            return false


        def roots_have_duplicate_paths(rows: darray[RootRow]) -> bool can[Memory.Allocate, Abort.Panic]:
            paths: mutable darray[sview] = []
            for row in rows:
                paths.push(row.relative_path)
            ordered_paths: darray[sview] = sorted(paths)
            for index in 1..<ordered_paths.count |ordered_paths|:
                return true if ordered_paths[index - 1] == ordered_paths[index]
            return false


        def parse_root_records(contents: sview) -> darray[RootRow] error[MigrationRootsError] can[Memory.Allocate, Abort.Panic]:
            # AWK's default record separator is LF only; preserve CR bytes so
            # CRLF headers do not become valid through split_lines normalization.
            lines: darray[sview] = split(contents, "\n")
            raise MigrationRootsError.HeaderInvalid if lines.count == 0 or lines[0] != Syntax::HEADER
            rows: mutable darray[RootRow] = []

            for index in 1..<lines.count |contents, lines, rows|:
                line: sview = lines[index]
                terminal_split_field: bool = index + 1 == lines.count and contents.endswith("\n") and line == ""
                if line != "" and not terminal_split_field:
                    raise MigrationRootsError.RecordShapeInvalid if rows.count >= Limits::ROWS
                    tabs: mutable usize = 0
                    for byte in line:
                        tabs <- tabs + 1 if byte == 9u8
                        raise MigrationRootsError.RecordShapeInvalid if tabs > 3
                    raise MigrationRootsError.RecordShapeInvalid if tabs != 3
                    fields: darray[sview] = split(line, "\t")
                    rows.push(try root_row_from_fields(fields))

            raise MigrationRootsError.EmptyManifest if rows.count == 0
            raise MigrationRootsError.DuplicateName if roots_have_duplicate_names(rows)
            raise MigrationRootsError.DuplicatePath if roots_have_duplicate_paths(rows)
            return rows


        def canonical_path_is_within(root: sview, candidate: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if root == candidate
            prefix: sview = "/" if root == "/" else root + "/"
            return candidate.startswith(prefix)


        def shell_readable_root_count(contents: sview, row_count: usize) -> usize:
            # Bash's `while read` loop in the reference does not enter its body
            # for a final record lacking LF, although the preceding AWK pass
            # validates that record. Mirror the containment-check subset only;
            # parse_root_records still validates every row.
            return row_count if contents.endswith("\n") else row_count - 1


        def read_manifest(manifest_path: Path) -> sview error[MigrationRootsError] can[Memory.Allocate, Abort.Panic, File.Read, Blocking.IO, Unsafe.PointerCast]:
            original_size: usize = try file_size(manifest_path) else err:
                raise MigrationRootsError.RecordShapeInvalid
            raise MigrationRootsError.InputLimitExceeded if original_size > Limits::MANIFEST_BYTES

            current_size: usize = try file_size(manifest_path) else err:
                raise MigrationRootsError.RecordShapeInvalid
            raise MigrationRootsError.InputLimitExceeded if current_size > Limits::MANIFEST_BYTES or current_size > original_size

            bounded: BoundedManifestRead = read_manifest_bounded(manifest_path, original_size)
            if bounded.failure:
                raise MigrationRootsError.RecordShapeInvalid
            raise MigrationRootsError.InputLimitExceeded if bounded.changed or bounded.exceeded_limit or len(bounded.contents) > Limits::MANIFEST_BYTES or len(bounded.contents) > original_size
            return bounded.contents


    public:
        def repository_root() -> Path error[MigrationRootsError] can[Memory.Allocate, Abort.Panic, Directory.Read]:
            script_path: Path = Script::source_path()
            script_directory: Path = try path_real(script_path.parent()) else err:
                raise MigrationRootsError.RecordShapeInvalid
            return script_directory.parent()


        def validate_root_records(contents: sview) -> bool error[MigrationRootsError] can[Memory.Allocate, Abort.Panic]:
            rows: darray[RootRow] = try parse_root_records(contents)
            return rows.count > 0


        def canonical_path_is_within_root(root: sview, candidate: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            return canonical_path_is_within(root, candidate)


        def containment_checked_row_count(contents: sview) -> usize error[MigrationRootsError] can[Memory.Allocate, Abort.Panic]:
            rows: darray[RootRow] = try parse_root_records(contents)
            return shell_readable_root_count(contents, rows.count)


        def run(coding_projects_root: Path, manifest_path: Path) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, File.Read, Directory.Read, Blocking.IO, Unsafe.PointerCast]:
            if not is_directory(coding_projects_root):
                eprint(f"{Messages::ROOT_MISSING}{coding_projects_root}")
                return 2i64
            if not is_file(manifest_path):
                eprint(f"{Messages::MANIFEST_MISSING}{manifest_path}")
                return 2i64

            canonical_root: Path = try path_real(coding_projects_root) else err:
                eprint(Messages::ROOT_CANONICAL_FAILED)
                return 2i64
            canonical_root_text: sview = f"{canonical_root}"
            manifest_contents: mutable sview = ""
            read_ok: mutable bool = false
            catch read_manifest(manifest_path):
                ok value:
                    manifest_contents <- value
                    read_ok <- true
                error failure:
                    if failure == MigrationRootsError.InputLimitExceeded:
                        eprint(Messages::MANIFEST_TOO_LARGE)
                    else:
                        eprint(f"{Messages::MANIFEST_READ_FAILED}: {manifest_path}")
                    return 1i64
            if not read_ok:
                eprint(f"{Messages::MANIFEST_READ_FAILED}: {manifest_path}")
                return 1i64

            rows: mutable darray[RootRow] = []
            catch parse_root_records(manifest_contents):
                ok value:
                    rows <- value
                error failure:
                    eprint(Messages::MANIFEST_INVALID)
                    return 1i64

            checked_root_count: usize = shell_readable_root_count(manifest_contents, rows.count)
            for index in 0..<checked_root_count |rows, canonical_root_text|:
                row: RootRow = rows[index]
                root_path: Path = coding_projects_root.joinpath(row.relative_path)
                if not is_directory(root_path):
                    eprint(f"{Messages::DECLARED_ROOT_MISSING}{root_path}")
                    return 1i64
                canonical_declared_root: Path = try path_real(root_path) else err:
                    eprint(f"{Messages::DECLARED_ROOT_CANONICAL_FAILED}{root_path}")
                    return 1i64
                canonical_declared_text: sview = f"{canonical_declared_root}"
                if not canonical_path_is_within(canonical_root_text, canonical_declared_text):
                    eprint(f"{Messages::ROOT_ESCAPES}{root_path}")
                    return 1i64

            println("migration roots audit: manifest shape, ownership, and declared directories are valid")
            return 0i64


        def run_default() -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, File.Read, Directory.Read, Blocking.IO, Unsafe.PointerCast]:
            root: Path = try repository_root() else err:
                eprint(Messages::ROOT_CANONICAL_FAILED)
                return 2i64
            coding_projects_root: Path = root.parent().parent()
            manifest_path: Path = root.joinpath("docs").joinpath("migration-project-roots.tsv")
            return run(coding_projects_root, manifest_path)


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, File.Read, Directory.Read, Blocking.IO, Unsafe.PointerCast]:
    if arguments.count > 2:
        eprint("usage: check_migration_roots [CODING_PROJECTS_ROOT [MANIFEST]]")
        return 2i64
    default_root: Path = try EsMigrationRootsAudit::repository_root() else err:
        eprint("migration roots audit: unable to canonicalize coding-projects root")
        return 2i64
    coding_projects_root: mutable Path = default_root.parent().parent()
    manifest_path: mutable Path = default_root.joinpath("docs").joinpath("migration-project-roots.tsv")
    if arguments.count >= 1:
        coding_projects_root <- path(arguments[0])
    if arguments.count == 2:
        manifest_path <- path(arguments[1])
    return EsMigrationRootsAudit::run(coding_projects_root, manifest_path)
