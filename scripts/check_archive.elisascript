# Bounded Elisascript port of check_archive.sh.
# Regex source checks stream through the shared line scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsArchiveAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/archive_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            RUNTIME_FIXTURE: sview = "test/runtime/archive_model_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            ID_INDEX_SLOTS: Regex = regex"id_index_slots: darray\[usize\]"
            PATH_INDEX_SLOTS: Regex = regex"path_index_slots: darray\[usize\]"
            ENTRY_ID_INDEX: Regex = regex"def archive_entry_id_index\("
            PATH_INDEX: Regex = regex"def archive_path_index\("
            ENSURE_INDEX_CAPACITY: Regex = regex"def archive_ensure_index_capacity\("
            VALIDATE_HEADER: Regex = regex"def validate_archive_header\("
            VALIDATE_HEADER_CALL: Regex = regex"try validate_archive_header\(session\)"
            INDEX_SLOTS_LIMIT: Regex = regex"INDEX_SLOTS: usize = 2097152"
            INDEX_PROBES_LIMIT: Regex = regex"INDEX_PROBES: usize = 64"
            PROBE_LIMIT_ERROR: Regex = regex"IndexProbeLimitExceeded"
            PREFLIGHT_ID_INDEX: Regex = regex"preflight_id_index: usize = try archive_entry_id_index\(session, entry.entry_id\)"
            PREFLIGHT_PATH_INDEX: Regex = regex"preflight_path_index: usize = try archive_path_index\(session.entries, session.path_index_slots, entry.path\)"
            ACCEPTED_OVERWRITE_FAIL: Regex = regex"if entry.state == ArchiveEntryState.Accepted and session.policy.overwrite == ArchiveOverwritePolicy.Fail"
            ENTRY_PATH_INDEX: Regex = regex"archive_path_index\(session.entries, session.path_index_slots, entry.path\)"
            STORED_ID_SLOTS: Regex = regex"for stored in session.id_index_slots"
            STORED_PATH_SLOTS: Regex = regex"for stored in session.path_index_slots"
            EARLIER_ENTRY_SCAN: Regex = regex"for earlier in 0\.\.<index"
            SKIPPED_PATHS: Regex = regex"skipped_archive_paths_do_not_conflict_with_accepted_entries"
            INDEX_ORDER_COLLISIONS: Regex = regex"archive_entry_indexes_preserve_order_across_collisions_and_growth"
            EXCESSIVE_COLLISIONS: Regex = regex"archive_rejects_excessive_index_collisions_without_partial_admission"
            EMPTY_ACCOUNTING: Regex = regex"session.entries.count == 64 and session.total_bytes == 0 and session.skipped_entries == 0"
            FULL_FORGED_INDEX: Regex = regex"archive_admission_rejects_a_full_forged_index_before_mutation"
            ORIGINAL_ENTRY: Regex = regex"session.entries.count == 1 and session.entries\[0\].entry_id == 1 and session.entries\[0\].path == \"original\""
            INDEX_SLOT_COUNTS: Regex = regex"session.id_index_slots.count == 16 and session.path_index_slots.count == 16"
            DUPLICATE_PATH: Regex = regex"ArchiveError.DuplicatePath"
            DUPLICATE_ENTRY_ID: Regex = regex"ArchiveError.DuplicateEntryId"
            SKIPPED_STATE: Regex = regex"ArchiveEntryState.Skipped"
            FIRST_ACCEPTED_ACCOUNTING: Regex = regex"first_accepted.total_bytes == 3 and first_accepted.skipped_entries == 1"
            FIRST_SKIPPED_ACCOUNTING: Regex = regex"first_skipped.total_bytes == 3 and first_skipped.skipped_entries == 1"
            MODULE: Regex = regex"^module EsArchive:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/archive_model\.elisa\""
            KIND: Regex = regex"const enum ArchiveKind of u8"
            LINK_POLICY: Regex = regex"const enum ArchiveLinkPolicy of u8"
            SESSION_STATE: Regex = regex"const enum ArchiveSessionState of u8"
            ENTRY_KIND: Regex = regex"const enum ArchiveEntryKind of u8"
            POLICY: Regex = regex"struct ArchivePolicy:"
            ENTRY: Regex = regex"struct ArchiveEntry:"
            SESSION: Regex = regex"struct ArchiveSession:"
            ERROR: Regex = regex"error ArchiveError:"
            VALIDATE_SESSION: Regex = regex"def validate_archive_session\("
            ADMIT_ENTRY: Regex = regex"def archive_admit_entry\("
            ADVANCE: Regex = regex"def advance_archive\("
            ENTRIES_LIMIT: Regex = regex"Limits::ENTRIES"
            PATH_BYTES_LIMIT: Regex = regex"Limits::PATH_BYTES"
            ENTRY_BYTES_LIMIT: Regex = regex"Limits::ENTRY_BYTES"
            TOTAL_BYTES_LIMIT: Regex = regex"Limits::TOTAL_BYTES"
            ABSOLUTE_PATH: Regex = regex"ArchiveError.AbsolutePath"
            TRAVERSAL_PATH: Regex = regex"ArchiveError.TraversalPath"
            LINK_REJECTED: Regex = regex"ArchiveError.LinkRejected"
            NON_SYMLINK_KIND: Regex = regex"entry.kind != ArchiveEntryKind.Symlink"
            TOTAL_LIMIT_ERROR: Regex = regex"ArchiveError.TotalLimitBytesExceeded"
            ACCOUNTED_BOUND: Regex = regex"accounted > session.policy.max_total_bytes"
            ENTRY_SIZE_BOUND: Regex = regex"entry.size > session.policy.max_total_bytes - accounted"
            TRIM_TRAILING: Regex = regex"archive_trim_trailing_separators"
            FINISH_TRAILING_SEPARATORS: Regex = regex"while finish > 1 and sview_at(path, finish - 1) == 47"
            PATHS_EQUIVALENT: Regex = regex"archive_paths_equivalent"
            ACCOUNTING_INVALID: Regex = regex"ArchiveError.AccountingInvalid"
            PLANNED_STATE: Regex = regex"ArchiveSessionState.Planned and"
            FAIL_EVENT: Regex = regex"event == ArchiveEvent.Fail"
            INVALID_TRANSITION: Regex = regex"ArchiveError.InvalidTransition"
            FIXTURE_IMPORT: Regex = regex"using EsArchive"
            FIXTURE_CONTRACT: Regex = regex"typed_archive_contract_rejects_traversal_and_links_before_commit"
            FIXTURE_TRAVERSAL: Regex = regex"ArchiveError.TraversalPath"
            FIXTURE_LINK_REJECTED: Regex = regex"ArchiveError.LinkRejected"
            COMMITTED_STATE: Regex = regex"ArchiveSessionState.Committed"
            DIRECTORY_SEPARATOR: Regex = regex"directory_separator"
            DUPLICATE_TRAILING_PATH: Regex = regex"duplicate_trailing_path"
            FIXTURE_ACCOUNTING_INVALID: Regex = regex"ArchiveError.AccountingInvalid"
            DOCS_SESSION: Regex = regex"EsArchive::ArchiveSession"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-050"


        const module Messages:
            MISSING_ROOT: sview = "archive audit: missing repository root"
            UNRESOLVED_ROOT: sview = "archive audit: unable to resolve repository root"
            MISSING_INPUT: sview = "archive audit: missing "
            READ_FAILED: sview = "archive audit: unable to read source: "
            SUCCESS: sview = "archive audit: bounded path, byte, link-policy, indexed duplicate admission, and commit validation are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        const enum Expectation of u8:
            Present
            Absent


        struct SearchCheck:
            input: Path
            pattern: Regex
            expectation: Expectation = Expectation.Present


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::ID_INDEX_SLOTS},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_INDEX_SLOTS},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_ID_INDEX},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_INDEX},
                SearchCheck{input: inputs[0], pattern: Patterns::ENSURE_INDEX_CAPACITY},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_HEADER},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_HEADER_CALL},
                SearchCheck{input: inputs[0], pattern: Patterns::INDEX_SLOTS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::INDEX_PROBES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::PROBE_LIMIT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::PREFLIGHT_ID_INDEX},
                SearchCheck{input: inputs[0], pattern: Patterns::PREFLIGHT_PATH_INDEX},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCEPTED_OVERWRITE_FAIL},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_PATH_INDEX},
                SearchCheck{input: inputs[0], pattern: Patterns::STORED_ID_SLOTS},
                SearchCheck{input: inputs[0], pattern: Patterns::STORED_PATH_SLOTS},
                SearchCheck{input: inputs[0], pattern: Patterns::EARLIER_ENTRY_SCAN, expectation: Expectation.Absent},
                SearchCheck{input: inputs[3], pattern: Patterns::SKIPPED_PATHS},
                SearchCheck{input: inputs[3], pattern: Patterns::INDEX_ORDER_COLLISIONS},
                SearchCheck{input: inputs[3], pattern: Patterns::EXCESSIVE_COLLISIONS},
                SearchCheck{input: inputs[3], pattern: Patterns::EMPTY_ACCOUNTING},
                SearchCheck{input: inputs[3], pattern: Patterns::FULL_FORGED_INDEX},
                SearchCheck{input: inputs[3], pattern: Patterns::ORIGINAL_ENTRY},
                SearchCheck{input: inputs[3], pattern: Patterns::INDEX_SLOT_COUNTS},
                SearchCheck{input: inputs[3], pattern: Patterns::DUPLICATE_PATH},
                SearchCheck{input: inputs[3], pattern: Patterns::DUPLICATE_ENTRY_ID},
                SearchCheck{input: inputs[3], pattern: Patterns::SKIPPED_STATE},
                SearchCheck{input: inputs[3], pattern: Patterns::FIRST_ACCEPTED_ACCOUNTING},
                SearchCheck{input: inputs[3], pattern: Patterns::FIRST_SKIPPED_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::LINK_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ADMIT_ENTRY},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRIES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_BYTES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_BYTES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::TOTAL_BYTES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::ABSOLUTE_PATH},
                SearchCheck{input: inputs[0], pattern: Patterns::TRAVERSAL_PATH},
                SearchCheck{input: inputs[0], pattern: Patterns::LINK_REJECTED},
                SearchCheck{input: inputs[0], pattern: Patterns::NON_SYMLINK_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::TOTAL_LIMIT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTED_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_SIZE_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::TRIM_TRAILING},
                SearchCheck{input: inputs[0], pattern: Patterns::FINISH_TRAILING_SEPARATORS},
                SearchCheck{input: inputs[0], pattern: Patterns::PATHS_EQUIVALENT},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTING_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::FAIL_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_TRANSITION},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_TRAVERSAL},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_LINK_REJECTED},
                SearchCheck{input: inputs[2], pattern: Patterns::COMMITTED_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::DIRECTORY_SEPARATOR},
                SearchCheck{input: inputs[2], pattern: Patterns::DUPLICATE_TRAILING_PATH},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ACCOUNTING_INVALID},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[5], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        match check.expectation:
                            Expectation.Present:
                                return ExitStatus::FAILURE if not found
                            Expectation.Absent:
                                return ExitStatus::FAILURE if found
                            _:
                                return ExitStatus::FAILURE
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::RUNTIME_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsArchiveAudit::run_default()
