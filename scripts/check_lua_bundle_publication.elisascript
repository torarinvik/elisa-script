# Bounded Elisascript port of check_lua_bundle_publication.sh.
# Cross-file alternatives and the forbidden same-inode check are preserved.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsLuaBundlePublicationAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/lua_bundle_publication_model.elisa"
            FILE_BRIDGE: sview = "src/runtime/file_posix.elisa"
            POSIX_ADAPTER: sview = "src/runtime/lua_bundle_publication_posix.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            RENAME_FAILURE: sview = "test/driver/lua_bundle_publication_rename_failure.elisascript"
            CLOSE_UNCERTAIN: sview = "test/driver/lua_bundle_publication_close_uncertain.elisascript"
            WRITE_FAILURE: sview = "test/driver/lua_bundle_publication_write_failure.elisascript"
            STAGE_REMOVE_UNCERTAIN: sview = "test/driver/lua_bundle_publication_stage_remove_uncertain.elisascript"
            DIRECTORY_SYNC_UNCERTAIN: sview = "test/driver/lua_bundle_publication_directory_sync_uncertain.elisascript"


        const module Patterns:
            MODULE: sview = "^module EsLuaBundlePublication:"
            LIMITS: sview = "const module Limits:"
            STATE: sview = "const enum PublicationState"
            EVENT: sview = "const enum PublicationEvent"
            REQUEST: sview = "struct PublicationRequest:"
            PARENT_PROOF: sview = "struct PublicationParentProof:"
            STAGING_PROOF: sview = "struct PublicationStagingProof:"
            SESSION: sview = "struct PublicationSession:"
            ERROR: sview = "error PublicationError:"
            VALIDATE: sview = "def validate_publication"
            ADVANCE: sview = "def advance_publication"
            STAGE_ADMISSION_MISSING: sview = "StageAdmissionMissing"
            DESCRIPTOR_OWNERSHIP_MISSING: sview = "DescriptorOwnershipMissing"
            PARENT_IDENTITY_MISSING: sview = "ParentIdentityMissing"
            STAGING_IDENTITY_MISSING: sview = "StagingIdentityMissing"
            STAGING_IDENTITY_INVALID: sview = "StagingIdentityInvalid"
            OWNER_MISMATCH: sview = "OwnerMismatch"
            PARENT_MISMATCH: sview = "ParentMismatch"
            DESCRIPTOR_COLLISION: sview = "DescriptorCollision"
            PARENT_DEVICE: sview = "parent_device"
            PARENT_INODE: sview = "parent_inode"
            DESCRIPTOR_TOKEN: sview = "descriptor_token"
            PARENT_DESCRIPTOR_OWNED: sview = "parent_descriptor_owned"
            PARENT_DESCRIPTOR_CLOSED: sview = "parent_descriptor_closed"
            PARENT_PROOF_EMPTY: sview = "publication_parent_proof_empty"
            IDENTITY_PROOFS_VALID: sview = "publication_identity_proofs_valid"
            WRITE_LIMIT_EXCEEDED: sview = "WriteLimitExceeded"
            STAGE_REMOVAL_MISSING: sview = "StageRemovalMissing"
            DIRECTORY_SYNC_MISSING: sview = "DirectorySyncMissing"
            DESTINATION_NOT_PRESERVED: sview = "DestinationNotPreserved"
            PUBLISHED_UNCERTAIN: sview = "PublishedUncertain"
            OUTCOME_UNKNOWN: sview = "PublicationEvent.OutcomeUnknown"
            PUBLICATION_UNCERTAIN: sview = "PublicationUncertain"
            STAGE_CREATED: sview = "PublicationEvent.StageCreated"
            CLOSE_EVENT: sview = "PublicationEvent.Close"
            NOT_PUBLISHING: sview = "session.state != PublicationState.Publishing"
            PUBLISH_NOT_READY: sview = "PublicationError.PublishNotReady"
            PUBLISH_ACK: sview = "PublicationEvent.PublishAck"
            RENAME_FAILED: sview = "PublicationEvent.PublishFailed"
            RENAME_FAILURE_RETRYABLE: sview = "confirmed_rename_failure_is_retryable_as_failure"
            DESTINATION_PRESERVED: sview = "session.destination_preserved_on_failure"
            CLEANUP_UNCERTAIN: sview = "PublicationState.CleanupUncertain"
            PARENT_CLOSE_UNCERTAIN: sview = "parent_descriptor_close_uncertain"
            STAGE_CLOSE_RESULT: sview = "stage_close_succeeded: true, parent_close_succeeded: false"
            DESCRIPTOR_CLEANUP_PENDING: sview = "session.descriptor_owned or session.parent_descriptor_owned or session.parent_descriptor_closed"
            CLEANUP_UNCERTAIN_ERROR: sview = "PublicationError.CleanupUncertain"
            CLOSE_OUTCOME_UNKNOWN: sview = "PublicationEvent.CloseOutcomeUnknown"
            INVALID_CLOSE_EVENT: sview = "InvalidEvent if not stage_close_succeeded or not parent_close_succeeded"
            STAGE_WRITE_FAILED: sview = "PublicationState.StageWriteFailed"
            WRITE_FAILED_EVENT: sview = "PublicationEvent.WriteFailed"
            RETRY_REJECTED: sview = "retry_rejected"
            STAGE_REMOVE_UNKNOWN: sview = "PublicationEvent.StageRemoveOutcomeUnknown"
            DIRECTORY_SYNC_UNKNOWN: sview = "PublicationEvent.DirectorySyncUnknown"
            RENAME_ACK_OR_STAGE_MISSING: sview = "session.rename_acknowledged or not session.stage_entry_removed"
            IR_MODEL_IMPORT: sview = "include \"\\.\\./runtime/lua_bundle_publication_model\\.elisa\""
            IR_POSIX_IMPORT: sview = "include \"\\.\\./runtime/lua_bundle_publication_posix\\.elisa\""
            FIXTURE_IMPORT: sview = "using EsLuaBundlePublication"
            RENAMEAT_LINK: sview = "@link_name\\(renameat\\)"
            RENAMEAT_LEAF_VALID: sview = "def posix_renameat_leaf_valid\\("
            LEAF_LIMIT_LOOP: sview = "0\\.\\.<4096 \\|bytes\\|"
            LEAF_INDEX_ZERO: sview = "return false if index == 0"
            LEAF_DOT: sview = "return false if index == 1 and bytes\\[0\\] == 46u8"
            LEAF_DOT_DOT: sview = "return false if index == 2 and bytes\\[0\\] == 46u8 and bytes\\[1\\] == 46u8"
            LEAF_SLASH: sview = "return false if byte == 47u8"
            LEAF_NUL: sview = "if byte == 0u8:"
            INVALID_LEAF_NAME: sview = "PosixFileAtError\\.InvalidLeafName"
            RENAMEAT_FUNCTION: sview = "def elisascript_posix_renameat\\("
            UNLINKAT_LINK: sview = "@link_name\\(unlinkat\\)"
            UNLINKAT_LEAF: sview = "def elisascript_posix_unlinkat_leaf\\("
            UNLINKAT_IMPL: sview = "elisascript_posix_unlinkat_leaf_impl\\(directory_fd, leaf_name, 0\\)"
            INVALID_DESCRIPTOR: sview = "InvalidDescriptor if directory_fd < 0"
            LEAF_NAME_VALID: sview = "def elisascript_posix_leaf_name_valid\\("
            OPENAT_PRIVATE_FILE: sview = "def elisascript_posix_openat_private_file\\("
            OPEN_FLAGS: sview = "DarwinOpenFlags::WRONLY \\| DarwinOpenFlags::CREATE \\| DarwinOpenFlags::EXCLUSIVE \\| DarwinOpenFlags::NOFOLLOW \\| DarwinOpenFlags::CLOSE_ON_EXEC"
            PRIVATE_FILE_MODE: sview = "flags, 384u32"
            POSIX_MODULE: sview = "^module EsLuaBundlePublicationPosix:"
            STAT_RETRIES: sview = "STAT_EINTR_RETRIES: usize = 8"
            EINTR: sview = "DarwinErrno::EINTR"
            CAPTURE_HOST_PROOF: sview = "def capture_publication_host_proof\\("
            DIFFERENT_DEVICES: sview = "parent_info.device != staging_info.device"
            SAME_INODE_FORBIDDEN: sview = "publication_posix_same_inode\\(parent_info, staging_info\\)"
            REVALIDATE_HOST_PROOF: sview = "def revalidate_publication_host_proof\\("
            CLOSE_DESCRIPTORS: sview = "def close_publication_descriptors\\("
            REMOVE_STAGE: sview = "def remove_publication_stage\\("
            REMOVE_LEAF: sview = "elisascript_posix_unlinkat_leaf\\(parent_fd, leaf_name\\)"
            POSIX_STAGE_REMOVE_UNKNOWN: sview = "PublicationEvent.StageRemoveOutcomeUnknown"
            ENOENT: sview = "DarwinPublicationErrno::ENOENT"
            EIO: sview = "DarwinPublicationErrno::EIO"
            CLOSE_STAGING_FD: sview = "elisascript_posix_close\\(staging_fd\\)"
            CLOSE_PARENT_FD: sview = "elisascript_posix_close\\(parent_fd\\)"
            POSIX_CLOSE_UNKNOWN: sview = "PublicationEvent.CloseOutcomeUnknown"
            IDENTITY_CHANGED: sview = "PublicationPosixError\\.IdentityChanged"
            HOST_PROOF_EQUAL: sview = "publication_host_proof_equal\\(expected, observed\\)"
            WRITE_CALLS: sview = "WRITE_CALLS: usize = 1048576"
            WRITE_STAGE_FULLY: sview = "def write_publication_stage_fully\\("
            WRITE_STAGE: sview = "def write_publication_stage\\("
            POSIX_WRITE_FAILED: sview = "PublicationEvent.WriteFailed"
            ADVANCE_WRITE: sview = "advance_publication\\(session, PublicationEvent.Write, written\\)"
            WRITE_CALL_BOUND: sview = "cursor\\.calls >= Limits::WRITE_CALLS"
            EINTR_BOUND: sview = "errno\\[0\\] == DarwinErrno::EINTR and cursor\\.eintr_retries < Limits::IO_EINTR_RETRIES"
            WRITE_AMOUNT_BOUND: sview = "amount == 0 or amount\\.usize\\(\\) > remaining"
            POSIX_WRITE_LIMIT: sview = "PublicationPosixError\\.WriteLimitExceeded"
            SYNC_STAGE: sview = "def sync_publication_stage\\("
            SYNC_DESCRIPTOR: sview = "def sync_publication_descriptor\\("
            ADVANCE_SYNC: sview = "advance_publication\\(session, PublicationEvent.Sync\\)"
            FSYNC: sview = "elisascript_posix_fsync\\(fd\\)"
            SYNC_RETRY_BOUND: sview = "retries < Limits::IO_EINTR_RETRIES"
            SYNC_FAILED: sview = "PublicationPosixError\\.SyncFailed"
            PUBLISH_STAGED: sview = "def publish_staged\\("
            PUBLICATION_EIO: sview = "DarwinPublicationErrno::EIO"
            POSIX_PUBLISH_FAILED: sview = "PublicationEvent.PublishFailed"
            POSIX_OUTCOME_UNKNOWN: sview = "PublicationEvent.OutcomeUnknown"
            POSIX_PUBLISH_ACK: sview = "PublicationEvent.PublishAck"
            POSIX_DIRECTORY_SYNC_UNKNOWN: sview = "PublicationEvent.DirectorySyncUnknown"
            DIRECTORY_SYNC_FAILED: sview = "PublicationPosixError.DirectorySyncFailed"
            EIO_CONSTANT: sview = "EIO: i32 = 5"
            INVALID_DESCRIPTOR_PAIR: sview = "parent_fd < 0 or staging_fd < 0"
            PARENT_DESCRIPTOR_TOKEN: sview = "descriptor_token: parent_fd.u64() + 1u64"
            STAGING_DESCRIPTOR_TOKEN: sview = "descriptor_token: staging_fd.u64() + 1u64"
            STAT_PARENT_DESCRIPTOR: sview = "publication_posix_stat_descriptor(parent_fd, parent_info)"
            STAT_STAGING_DESCRIPTOR: sview = "publication_posix_stat_descriptor(staging_fd, staging_info)"
            STAT_NAMED_STAGE: sview = "publication_posix_stat_name(parent_fd, leaf_name, named_info)"
            FSTAT: sview = "elisascript_posix_fstat(descriptor, result)"
            FSTATAT: sview = "elisascript_posix_fstatat(parent_fd, leaf_name, result, DarwinAtFlag::SYMLINK_NOFOLLOW)"
            STAGING_NAME_MISMATCH: sview = "StagingNameMismatch"
            EXCLUSIVE_STAGING_TEST: sview = "typed_lua_bundle_publication_requires_exclusive_staging"
            CLOSE_CANNOT_PUBLISH: sview = "close_cannot_publish"
            PARENT_MISMATCH_REJECTED: sview = "parent_mismatch_rejected"
            DESCRIPTOR_COLLISION_REJECTED: sview = "descriptor_collision_rejected"
            MISSING_PARENT_DESCRIPTOR: sview = "missing_parent_descriptor_rejected"
            CANCELLED_PARENT_CLOSED: sview = "cancelled.parent_descriptor_closed"


        const module Messages:
            MISSING_ROOT: sview = "lua bundle publication audit: missing repository root"
            UNRESOLVED_ROOT: sview = "lua bundle publication audit: unable to resolve repository root"
            MISSING_INPUT: sview = "lua bundle publication audit: missing "
            READ_FAILED: sview = "lua bundle publication audit: unable to read source: "
            SAME_INODE_REGRESSION: sview = "lua bundle publication audit: parent directory and staging file must share a device, not an inode"
            SUCCESS: sview = "lua bundle publication audit: exclusive sibling staging, paired descriptor ownership, identity-bound publish admission, bounded writes, directory sync, and failure preservation are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        struct EitherCheck:
            first: Path
            second: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                pattern: Regex = regex(check.pattern)
                found: bool = try EsSourceFunctionScope::contains_file_regex_line(check.input, pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return ExitStatus::IO_FAILURE
                return ExitStatus::FAILURE if not found
            return 0i64


        def execute_either(checks: darray[EitherCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                pattern: Regex = regex(check.pattern)
                first_found: bool = try EsSourceFunctionScope::contains_file_regex_line(check.first, pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{check.first}")
                    return ExitStatus::IO_FAILURE
                if not first_found:
                    second_found: bool = try EsSourceFunctionScope::contains_file_regex_line(check.second, pattern) else err:
                        diagnostic(Messages::READ_FAILED + f"{check.second}")
                        return ExitStatus::IO_FAILURE
                    return ExitStatus::FAILURE if not second_found
            return 0i64


        def reject_same_inode(parent_path: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(Patterns::SAME_INODE_FORBIDDEN)
            found: bool = try EsSourceFunctionScope::contains_file_regex_line(parent_path, pattern) else err:
                diagnostic(Messages::READ_FAILED + f"{parent_path}")
                return ExitStatus::IO_FAILURE
            if found:
                diagnostic(Messages::SAME_INODE_REGRESSION)
                return ExitStatus::FAILURE
            return 0i64


        def declarations(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMITS},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST},
                SearchCheck{input: inputs[0], pattern: Patterns::PARENT_PROOF},
                SearchCheck{input: inputs[0], pattern: Patterns::STAGING_PROOF},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE}
            ]


        def model_or_fixture_boundaries(inputs: darray[Path]) -> darray[EitherCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::STAGE_ADMISSION_MISSING},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::DESCRIPTOR_OWNERSHIP_MISSING},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::PARENT_IDENTITY_MISSING},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::STAGING_IDENTITY_MISSING},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::STAGING_IDENTITY_INVALID},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::OWNER_MISMATCH},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::PARENT_MISMATCH},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::DESCRIPTOR_COLLISION},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::PARENT_DEVICE},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::PARENT_INODE},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::DESCRIPTOR_TOKEN},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::PARENT_DESCRIPTOR_OWNED},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::PARENT_DESCRIPTOR_CLOSED},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::PARENT_PROOF_EMPTY},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::IDENTITY_PROOFS_VALID},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::WRITE_LIMIT_EXCEEDED},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::STAGE_REMOVAL_MISSING},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::DIRECTORY_SYNC_MISSING},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::DESTINATION_NOT_PRESERVED},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::PUBLISHED_UNCERTAIN},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::OUTCOME_UNKNOWN},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::PUBLICATION_UNCERTAIN},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::STAGE_CREATED},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::CLOSE_EVENT},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::NOT_PUBLISHING},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::PUBLISH_NOT_READY},
                EitherCheck{first: inputs[0], second: inputs[4], pattern: Patterns::PUBLISH_ACK}
            ]


        def after_boundaries(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[5], pattern: Patterns::RENAME_FAILED},
                SearchCheck{input: inputs[5], pattern: Patterns::RENAME_FAILURE_RETRYABLE},
                SearchCheck{input: inputs[5], pattern: Patterns::DESTINATION_PRESERVED}
            ]


        def close_uncertain_checks(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[6], pattern: Patterns::PARENT_CLOSE_UNCERTAIN},
                SearchCheck{input: inputs[6], pattern: Patterns::STAGE_CLOSE_RESULT},
                SearchCheck{input: inputs[6], pattern: Patterns::DESCRIPTOR_CLEANUP_PENDING},
                SearchCheck{input: inputs[6], pattern: Patterns::CLEANUP_UNCERTAIN_ERROR},
                SearchCheck{input: inputs[6], pattern: Patterns::CLOSE_OUTCOME_UNKNOWN}
            ]


        def write_failure_checks(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[7], pattern: Patterns::WRITE_FAILED_EVENT},
                SearchCheck{input: inputs[7], pattern: Patterns::RETRY_REJECTED}
            ]


        def file_bridge_checks(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[1], pattern: Patterns::RENAMEAT_LINK},
                SearchCheck{input: inputs[1], pattern: Patterns::RENAMEAT_LEAF_VALID},
                SearchCheck{input: inputs[1], pattern: Patterns::LEAF_LIMIT_LOOP},
                SearchCheck{input: inputs[1], pattern: Patterns::LEAF_INDEX_ZERO},
                SearchCheck{input: inputs[1], pattern: Patterns::LEAF_DOT},
                SearchCheck{input: inputs[1], pattern: Patterns::LEAF_DOT_DOT},
                SearchCheck{input: inputs[1], pattern: Patterns::LEAF_SLASH},
                SearchCheck{input: inputs[1], pattern: Patterns::LEAF_NUL},
                SearchCheck{input: inputs[1], pattern: Patterns::INVALID_LEAF_NAME},
                SearchCheck{input: inputs[1], pattern: Patterns::RENAMEAT_FUNCTION},
                SearchCheck{input: inputs[1], pattern: Patterns::UNLINKAT_LINK},
                SearchCheck{input: inputs[1], pattern: Patterns::UNLINKAT_LEAF},
                SearchCheck{input: inputs[1], pattern: Patterns::UNLINKAT_IMPL},
                SearchCheck{input: inputs[1], pattern: Patterns::INVALID_DESCRIPTOR},
                SearchCheck{input: inputs[1], pattern: Patterns::LEAF_NAME_VALID},
                SearchCheck{input: inputs[1], pattern: Patterns::OPENAT_PRIVATE_FILE},
                SearchCheck{input: inputs[1], pattern: Patterns::OPEN_FLAGS},
                SearchCheck{input: inputs[1], pattern: Patterns::PRIVATE_FILE_MODE}
            ]


        def posix_adapter_prefix_checks(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[2], pattern: Patterns::POSIX_MODULE},
                SearchCheck{input: inputs[2], pattern: Patterns::STAT_RETRIES},
                SearchCheck{input: inputs[2], pattern: Patterns::EINTR},
                SearchCheck{input: inputs[2], pattern: Patterns::CAPTURE_HOST_PROOF},
                SearchCheck{input: inputs[2], pattern: Patterns::DIFFERENT_DEVICES}
            ]


        def posix_adapter_after_identity_checks(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[2], pattern: Patterns::REVALIDATE_HOST_PROOF},
                SearchCheck{input: inputs[2], pattern: Patterns::CLOSE_DESCRIPTORS},
                SearchCheck{input: inputs[2], pattern: Patterns::REMOVE_STAGE},
                SearchCheck{input: inputs[2], pattern: Patterns::REMOVE_LEAF},
                SearchCheck{input: inputs[2], pattern: Patterns::POSIX_STAGE_REMOVE_UNKNOWN},
                SearchCheck{input: inputs[2], pattern: Patterns::ENOENT},
                SearchCheck{input: inputs[2], pattern: Patterns::EIO},
                SearchCheck{input: inputs[2], pattern: Patterns::CLOSE_STAGING_FD},
                SearchCheck{input: inputs[2], pattern: Patterns::CLOSE_PARENT_FD},
                SearchCheck{input: inputs[2], pattern: Patterns::POSIX_CLOSE_UNKNOWN},
                SearchCheck{input: inputs[2], pattern: Patterns::IDENTITY_CHANGED},
                SearchCheck{input: inputs[2], pattern: Patterns::HOST_PROOF_EQUAL},
                SearchCheck{input: inputs[2], pattern: Patterns::WRITE_CALLS},
                SearchCheck{input: inputs[2], pattern: Patterns::WRITE_STAGE_FULLY},
                SearchCheck{input: inputs[2], pattern: Patterns::WRITE_STAGE},
                SearchCheck{input: inputs[2], pattern: Patterns::POSIX_WRITE_FAILED},
                SearchCheck{input: inputs[2], pattern: Patterns::ADVANCE_WRITE},
                SearchCheck{input: inputs[2], pattern: Patterns::WRITE_CALL_BOUND},
                SearchCheck{input: inputs[2], pattern: Patterns::EINTR_BOUND},
                SearchCheck{input: inputs[2], pattern: Patterns::WRITE_AMOUNT_BOUND},
                SearchCheck{input: inputs[2], pattern: Patterns::POSIX_WRITE_LIMIT},
                SearchCheck{input: inputs[2], pattern: Patterns::SYNC_STAGE},
                SearchCheck{input: inputs[2], pattern: Patterns::SYNC_DESCRIPTOR},
                SearchCheck{input: inputs[2], pattern: Patterns::ADVANCE_SYNC},
                SearchCheck{input: inputs[2], pattern: Patterns::FSYNC},
                SearchCheck{input: inputs[2], pattern: Patterns::SYNC_RETRY_BOUND},
                SearchCheck{input: inputs[2], pattern: Patterns::SYNC_FAILED},
                SearchCheck{input: inputs[2], pattern: Patterns::PUBLISH_STAGED},
                SearchCheck{input: inputs[2], pattern: Patterns::PUBLICATION_EIO},
                SearchCheck{input: inputs[2], pattern: Patterns::POSIX_PUBLISH_FAILED},
                SearchCheck{input: inputs[2], pattern: Patterns::POSIX_OUTCOME_UNKNOWN},
                SearchCheck{input: inputs[2], pattern: Patterns::POSIX_PUBLISH_ACK},
                SearchCheck{input: inputs[2], pattern: Patterns::POSIX_DIRECTORY_SYNC_UNKNOWN},
                SearchCheck{input: inputs[2], pattern: Patterns::DIRECTORY_SYNC_FAILED},
                SearchCheck{input: inputs[2], pattern: Patterns::EIO_CONSTANT},
                SearchCheck{input: inputs[2], pattern: Patterns::INVALID_DESCRIPTOR_PAIR},
                SearchCheck{input: inputs[2], pattern: Patterns::PARENT_DESCRIPTOR_TOKEN},
                SearchCheck{input: inputs[2], pattern: Patterns::STAGING_DESCRIPTOR_TOKEN},
                SearchCheck{input: inputs[2], pattern: Patterns::STAT_PARENT_DESCRIPTOR},
                SearchCheck{input: inputs[2], pattern: Patterns::STAT_STAGING_DESCRIPTOR},
                SearchCheck{input: inputs[2], pattern: Patterns::STAT_NAMED_STAGE},
                SearchCheck{input: inputs[2], pattern: Patterns::FSTAT},
                SearchCheck{input: inputs[2], pattern: Patterns::FSTATAT},
                SearchCheck{input: inputs[2], pattern: Patterns::STAGING_NAME_MISMATCH}
            ]


        def execute_all(inputs: darray[Path]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = execute(declarations(inputs))
            return status if status != 0i64

            status <- execute_either(model_or_fixture_boundaries(inputs))
            return status if status != 0i64

            status <- execute(after_boundaries(inputs))
            return status if status != 0i64

            uncertain_state: i64 = execute_either([
                EitherCheck{first: inputs[0], second: inputs[6], pattern: Patterns::CLEANUP_UNCERTAIN}
            ])
            return uncertain_state if uncertain_state != 0i64

            status <- execute(close_uncertain_checks(inputs))
            return status if status != 0i64

            status <- execute([
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_CLOSE_EVENT}
            ])
            return status if status != 0i64

            write_failed_state: i64 = execute_either([
                EitherCheck{first: inputs[0], second: inputs[7], pattern: Patterns::STAGE_WRITE_FAILED}
            ])
            return write_failed_state if write_failed_state != 0i64

            status <- execute(write_failure_checks(inputs))
            return status if status != 0i64

            status <- execute([
                SearchCheck{input: inputs[8], pattern: Patterns::STAGE_REMOVE_UNKNOWN}
            ])
            return status if status != 0i64

            stage_cleanup_uncertain: i64 = execute_either([
                EitherCheck{first: inputs[0], second: inputs[8], pattern: Patterns::CLEANUP_UNCERTAIN}
            ])
            return stage_cleanup_uncertain if stage_cleanup_uncertain != 0i64

            status <- execute([
                SearchCheck{input: inputs[9], pattern: Patterns::DIRECTORY_SYNC_UNKNOWN},
                SearchCheck{input: inputs[9], pattern: Patterns::RENAME_ACK_OR_STAGE_MISSING},
                SearchCheck{input: inputs[3], pattern: Patterns::IR_MODEL_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::IR_POSIX_IMPORT},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_IMPORT}
            ])
            return status if status != 0i64

            status <- execute(file_bridge_checks(inputs))
            return status if status != 0i64

            status <- execute(posix_adapter_prefix_checks(inputs))
            return status if status != 0i64

            status <- reject_same_inode(inputs[2])
            return status if status != 0i64

            status <- execute(posix_adapter_after_identity_checks(inputs))
            return status if status != 0i64

            status <- execute([
                SearchCheck{input: inputs[4], pattern: Patterns::EXCLUSIVE_STAGING_TEST}
            ])
            return status if status != 0i64

            status <- execute([
                SearchCheck{input: inputs[4], pattern: Patterns::CLOSE_CANNOT_PUBLISH},
                SearchCheck{input: inputs[4], pattern: Patterns::PARENT_MISMATCH_REJECTED},
                SearchCheck{input: inputs[4], pattern: Patterns::DESCRIPTOR_COLLISION_REJECTED},
                SearchCheck{input: inputs[4], pattern: Patterns::MISSING_PARENT_DESCRIPTOR},
                SearchCheck{input: inputs[4], pattern: Patterns::CANCELLED_PARENT_CLOSED}
            ])
            return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::FILE_BRIDGE),
                root.joinpath(Inputs::POSIX_ADAPTER),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::RENAME_FAILURE),
                root.joinpath(Inputs::CLOSE_UNCERTAIN),
                root.joinpath(Inputs::WRITE_FAILURE),
                root.joinpath(Inputs::STAGE_REMOVE_UNCERTAIN),
                root.joinpath(Inputs::DIRECTORY_SYNC_UNCERTAIN)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute_all(inputs)
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsLuaBundlePublicationAudit::run_default()
