# Streaming Elisascript port of check_continuation_policy.sh.
# Keep the shell oracle until its public-launcher parity contract is qualified.

include "./shell_invocation_path.elisascript"

module EsContinuationPolicyAudit:
    private:
        const module Inputs:
            POLICY: sview = "docs/continuation-policy.md"
            VERIFIER: sview = "src/ir/ir_verify.elisa"
            LOWERER: sview = "src/ir/lower_ast.elisa"
            TESTS: sview = "test/ir/elisascript_ir_test.elisa"


        const module Patterns:
            VERIFIER_CLONE: sview = "ContinuationPolicy\\.MultiClone"
            VERIFIER_REPLAY: sview = "ContinuationPolicy\\.MultiReplay"
            MUTABLE_AGGREGATE_CAPTURE: sview = "capture\\.type\\.kind in \\{TypeKind\\.Array, TypeKind\\.Map\\}"
            SOURCE_HANDLER_CONFORMANCE: sview = "def source_handler_operation_conforms"
            KNOWN_RESULT_TYPES: sview = "effect_operation_result_is_known\\(expected_result\\) and effect_operation_result_is_known\\(actual_result\\)"
            MUTABLE_CAPTURE_TEST: sview = "multi_shot_rejects_mutable_aggregate_capture"
            CAPTURE_METADATA_TEST: sview = "set_capture: ContinuationCapture"
            UNSAFE_MULTISHOT_COUNT: sview = "issue_count\\(issues, IssueKind\\.UnsafeMultiShot\\) == 3"


        const module Messages:
            MISSING_ROOT: sview = "continuation policy audit: missing repository root"
            UNRESOLVED_ROOT: sview = "continuation policy audit: unable to resolve repository root"
            MISSING_INPUT: sview = "continuation policy audit: missing "
            POLICY_OMITS: sview = "continuation policy audit: policy omits "
            RG_UNAVAILABLE: sview = "continuation policy audit: unable to run rg"
            RG_FAILED_TO_RUN: sview = "continuation policy audit: rg failed to run"


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def policy_terms() -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            return [
                "Terminal", "Linear", "Affine", "MultiReplay", "MultiClone",
                "zero resumes", "duplicate resume", "resume after scope exit",
                "reentrant", "cleanup", "Cancellation", "InvalidContinuation",
                "UnsafeMultiShot", "stable", "release profile"
            ]


        def searches(verifier: Path, lowerer: Path, tests: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: verifier, pattern: Patterns::VERIFIER_CLONE},
                SearchCheck{input: verifier, pattern: Patterns::VERIFIER_REPLAY},
                SearchCheck{input: verifier, pattern: Patterns::MUTABLE_AGGREGATE_CAPTURE},
                SearchCheck{input: lowerer, pattern: Patterns::SOURCE_HANDLER_CONFORMANCE},
                SearchCheck{input: lowerer, pattern: Patterns::KNOWN_RESULT_TYPES},
                SearchCheck{input: tests, pattern: Patterns::MUTABLE_CAPTURE_TEST},
                SearchCheck{input: tests, pattern: Patterns::CAPTURE_METADATA_TEST},
                SearchCheck{input: tests, pattern: Patterns::UNSAFE_MULTISHOT_COUNT}
            ]


        def execute(rg: Executable, input: Path, pattern: sview) -> i64 can[Environment.Read, File.Read, Directory.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            arguments: darray[sview] = ["-q", pattern, f"{input}"]
            status: i64 = try run_process(rg, arguments, 0i64) else err:
                diagnostic(Messages::RG_FAILED_TO_RUN)
                return 127i64
            return status


    public:
        def run_root(repository_root: Path) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return 1i64
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::POLICY),
                root.joinpath(Inputs::VERIFIER),
                root.joinpath(Inputs::LOWERER),
                root.joinpath(Inputs::TESTS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return 1i64

            rg: Executable = try executable("rg") else err:
                diagnostic(Messages::RG_UNAVAILABLE)
                return 127i64
            for term in policy_terms():
                status: i64 = execute(rg, inputs[0], term)
                if status != 0i64:
                    diagnostic(Messages::POLICY_OMITS + term)
                    return 1i64

            checks: darray[SearchCheck] = searches(inputs[1], inputs[2], inputs[3])
            for check in checks:
                status: i64 = execute(rg, check.input, check.pattern)
                return status if status != 0i64

            print("continuation policy audit: decision record, verifier guard, and IR fixture present")
            return 0i64


        def run_default() -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsContinuationPolicyAudit::run_default()
