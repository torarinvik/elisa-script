# Bounded, read-only Elisascript port of check_continuation_policy.sh.

include "../src/runtime/bounded_text_posix.elisa"

using EsBoundedText


module EsContinuationPolicyAudit:
    private:
        const module Limits:
            SOURCE_BYTES_PER_FILE: usize = 1572864
            TOTAL_SOURCE_BYTES: usize = 3145728


        const module Messages:
            MISSING_PREFIX: sview = "continuation policy audit: missing "
            READ_FAILED: sview = "continuation policy audit: unable to read source: "
            TOO_LARGE: sview = "continuation policy audit: source exceeds audit limit: "
            POLICY_OMISSION: sview = "continuation policy audit: policy omits "


        const module PolicyTerms:
            TERMINAL: sview = "Terminal"
            LINEAR: sview = "Linear"
            AFFINE: sview = "Affine"
            MULTI_REPLAY: sview = "MultiReplay"
            MULTI_CLONE: sview = "MultiClone"
            ZERO_RESUMES: sview = "zero resumes"
            DUPLICATE_RESUME: sview = "duplicate resume"
            RESUME_AFTER_SCOPE_EXIT: sview = "resume after scope exit"
            REENTRANT: sview = "reentrant"
            CLEANUP: sview = "cleanup"
            CANCELLATION: sview = "Cancellation"
            INVALID_CONTINUATION: sview = "InvalidContinuation"
            UNSAFE_MULTI_SHOT: sview = "UnsafeMultiShot"
            STABLE: sview = "stable"
            RELEASE_PROFILE: sview = "release profile"


        error ReadFailure:
            Missing
            LimitExceeded
            AggregateLimitExceeded
            ReadFailed


        def write_diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def read_source(input_path: Path, remaining_total_bytes: usize) -> sview error[ReadFailure] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise ReadFailure.Missing if not is_file(input_path)
            source_size: usize = try file_size(input_path) else err:
                raise ReadFailure.ReadFailed
            raise ReadFailure.LimitExceeded if source_size > Limits::SOURCE_BYTES_PER_FILE
            raise ReadFailure.AggregateLimitExceeded if source_size > remaining_total_bytes
            read_limit: usize = Limits::SOURCE_BYTES_PER_FILE if remaining_total_bytes > Limits::SOURCE_BYTES_PER_FILE else remaining_total_bytes
            catch EsBoundedText::read_utf8(input_path, read_limit):
                ok contents:
                    return contents
                error failure:
                    if failure == EsBoundedText::ReadError.LimitExceeded:
                        raise ReadFailure.AggregateLimitExceeded if read_limit < Limits::SOURCE_BYTES_PER_FILE
                        raise ReadFailure.LimitExceeded
                    raise ReadFailure.ReadFailed


        def report_read_failure(input_path: Path, failure: ReadFailure) -> void can[Console.Format, Console.Write, Memory.Allocate, Abort.Panic]:
            if failure == ReadFailure.LimitExceeded:
                write_diagnostic(Messages::TOO_LARGE + f"{input_path}")
            elif failure == ReadFailure.AggregateLimitExceeded:
                write_diagnostic("continuation policy audit: aggregate source exceeds audit limit")
            elif failure == ReadFailure.Missing:
                write_diagnostic(Messages::MISSING_PREFIX + f"{input_path}")
            else:
                write_diagnostic(Messages::READ_FAILED + f"{input_path}")


        def first_missing(source: sview, required: darray[sview]) -> sview:
            for text in required:
                return text if source.index(text) < 0
            return ""


        def source_path(repository_root: Path, relative: sview) -> Path:
            return repository_root.joinpath(relative)


        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Console.Format, Console.Write, File.Read, Unsafe.PointerCast]:
            paths: darray[Path] = [
                source_path(repository_root, "docs/continuation-policy.md"),
                source_path(repository_root, "src/ir/ir_verify.elisa"),
                source_path(repository_root, "src/ir/lower_ast.elisa"),
                source_path(repository_root, "test/ir/elisascript_ir_test.elisa")
            ]
            for input_path in paths:
                if not is_file(input_path):
                    write_diagnostic(Messages::MISSING_PREFIX + f"{input_path}")
                    return 1i64

            sources: mutable darray[sview] = []
            sources.reserve(paths.count)
            total_source_bytes: mutable usize = 0
            for input_path in paths:
                remaining_total_bytes: usize = Limits::TOTAL_SOURCE_BYTES - total_source_bytes
                source_size: usize = try file_size(input_path) else err:
                    write_diagnostic(Messages::READ_FAILED + f"{input_path}")
                    return 1i64
                if source_size > Limits::SOURCE_BYTES_PER_FILE:
                    write_diagnostic(Messages::TOO_LARGE + f"{input_path}")
                    return 1i64
                if source_size > remaining_total_bytes:
                    write_diagnostic("continuation policy audit: aggregate source exceeds audit limit")
                    return 1i64
                source: sview = try read_source(input_path, remaining_total_bytes) else err:
                    report_read_failure(input_path, err)
                    return 1i64
                total_source_bytes <- total_source_bytes + source_size
                sources.push(source)

            policy_source: sview = sources[0]
            verifier_source: sview = sources[1]
            lowerer_source: sview = sources[2]
            tests_source: sview = sources[3]

            required_policy_terms: darray[sview] = [
                PolicyTerms::TERMINAL,
                PolicyTerms::LINEAR,
                PolicyTerms::AFFINE,
                PolicyTerms::MULTI_REPLAY,
                PolicyTerms::MULTI_CLONE,
                PolicyTerms::ZERO_RESUMES,
                PolicyTerms::DUPLICATE_RESUME,
                PolicyTerms::RESUME_AFTER_SCOPE_EXIT,
                PolicyTerms::REENTRANT,
                PolicyTerms::CLEANUP,
                PolicyTerms::CANCELLATION,
                PolicyTerms::INVALID_CONTINUATION,
                PolicyTerms::UNSAFE_MULTI_SHOT,
                PolicyTerms::STABLE,
                PolicyTerms::RELEASE_PROFILE
            ]
            for required_text in required_policy_terms:
                if policy_source.index(required_text) < 0:
                    write_diagnostic(Messages::POLICY_OMISSION + required_text)
                    return 1i64

            return 1i64 if verifier_source.index("ContinuationPolicy.MultiClone") < 0
            return 1i64 if verifier_source.index("ContinuationPolicy.MultiReplay") < 0
            return 1i64 if verifier_source.index("capture.type.kind in {TypeKind.Array, TypeKind.Map}") < 0
            return 1i64 if lowerer_source.index("def source_handler_operation_conforms") < 0
            return 1i64 if lowerer_source.index("effect_operation_result_is_known(expected_result) and effect_operation_result_is_known(actual_result)") < 0
            return 1i64 if tests_source.index("multi_shot_rejects_mutable_aggregate_capture") < 0
            return 1i64 if tests_source.index("set_capture: ContinuationCapture") < 0
            return 1i64 if tests_source.index("issue_count(issues, IssueKind.UnsafeMultiShot) == 3") < 0

            print("continuation policy audit: decision record, verifier guard, and IR fixture present")
            return 0i64

    public:
        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Console.Format, Console.Write, File.Read, Unsafe.PointerCast]:
            script_directory: Path = try path_real(path_parent(Script::source_path())) else err:
                write_diagnostic("continuation policy audit: unable to resolve script directory")
                return 1i64
            return run_root(script_directory.parent())


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Console.Format, Console.Write, File.Read, Unsafe.PointerCast]:
    _ = arguments
    return EsContinuationPolicyAudit::run_default()
