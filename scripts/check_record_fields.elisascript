# Bounded Elisascript port of check_record_fields.sh.
# Function-body assertions use bounded extraction instead of sed/awk.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsRecordFieldsAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/record_fields_model.elisa"
            ADAPTER: sview = "src/runtime/record_field_edit_adapter_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            ADAPTER_FIXTURE: sview = "test/runtime/record_field_edit_adapter_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODEL_MODULE: sview = "^module EsRecordFields:"
            ADAPTER_MODULE: sview = "^module EsRecordFieldEditAdapter:"
            ADAPTER_SESSION: sview = "struct RecordFieldEditAdapterSession:"
            ADAPTER_RECONSTRUCT_SIGNATURE: sview = "def record_field_reconstruct_record\\(session: RecordFieldEditAdapterSession&\\)"
            MODEL_IMPORT: sview = "include \"\\.\\./runtime/record_fields_model\\.elisa\""
            ADAPTER_IMPORT: sview = "include \"\\.\\./runtime/record_field_edit_adapter_model\\.elisa\""
            EDIT_STATE: sview = "const enum RecordFieldEditState of u8"
            EDIT_EVENT: sview = "const enum RecordFieldEditEvent of u8"
            EDIT_POLICY: sview = "struct RecordFieldEditPolicy:"
            EDIT: sview = "struct RecordFieldEdit:"
            EDIT_SESSION: sview = "struct RecordFieldEditSession:"
            EDIT_ERROR: sview = "error RecordFieldEditError:"
            VALIDATE_SESSION: sview = "def validate_record_field_edit_session\\("
            RECONSTRUCT_LENGTH: sview = "def record_field_edit_reconstruct_length\\("
            RECONSTRUCT: sview = "def record_field_reconstruct\\("
            ADVANCE: sview = "def advance_record_field_edit\\("
            SESSION_FROM_FIELDS: sview = "def record_field_edit_session_from_fields\\("
            SESSION_FROM_REGEX_SPANS: sview = "def record_field_edit_session_from_regex_spans\\("
            SPLIT_REGEX_SPANS: sview = "split_record_fields_from_regex_spans"
            ADAPTER_ADVANCE: sview = "def advance_record_field_edit_adapter\\("
            ADAPTER_RECONSTRUCT: sview = "def record_field_reconstruct_record\\("
            MODE_SUPPORTED: sview = "record_field_edit_adapter_mode_supported"
            LIMITED_SCAN_POLICY: sview = "record_field_edit_adapter_limited_scan_policy"
            FIELDS_MATCH: sview = "record_field_edit_adapter_fields_match"
            PRESERVED_SEPARATOR: sview = "record.separator if record_policy.preserve_separator"
            RECONSTRUCT_LENGTH_CALL: sview = "record_field_edit_reconstruct_length\\(session\\)"
            OUTPUT_LIMIT_ERROR: sview = "RecordFieldEditError.OutputLimitExceeded"
            VALIDATED_TRANSFER: sview = "def record_field_edit_session_from_validated_fields("
            VALIDATE_RECORD_CALL: sview = "validate_record\\("
            VALIDATE_RECORD_FIELD_CALL: sview = "validate_record_field\\("
            RECONSTRUCT_FUNCTION: sview = "def record_field_reconstruct_record("
            RECONSTRUCT_LENGTH_EXPRESSION: sview = "record_field_edit_reconstruct_length(session)"
            RECONSTRUCT_CONTENT_EXPRESSION: sview = "record_field_reconstruct(session)"
            EDIT_LIMIT: sview = "Limits::EDITS"
            MAX_FIELDS: sview = "max_fields"
            MAX_OUTPUT_BYTES: sview = "max_output_bytes"
            OUTPUT_SEPARATOR: sview = "output_separator"
            TRAILING_SEPARATOR: sview = "trailing_separator"
            ALLOW_APPEND: sview = "allow_append"
            BOUNDED_ADD: sview = "record_field_edit_bounded_add"
            INVALID_FIELD_INDEX: sview = "RecordFieldEditError.InvalidFieldIndex"
            EDIT_LIMIT_EXCEEDED: sview = "RecordFieldEditError.EditLimitExceeded"
            MODEL_OUTPUT_LIMIT_ERROR: sview = "RecordFieldEditError.OutputLimitExceeded"
            ACCOUNTING_INVALID: sview = "RecordFieldEditError.AccountingInvalid"
            PLANNED_STATE: sview = "session.state == RecordFieldEditState.Planned and"
            EDITING_STATE: sview = "session.state == RecordFieldEditState.Editing and"
            EXPECTED_OUTPUT_BYTES: sview = "expected_output_bytes"
            SET_EVENT: sview = "RecordFieldEditEvent.Set"
            RECONSTRUCT_EVENT: sview = "RecordFieldEditEvent.Reconstruct"
            READY_STATE: sview = "RecordFieldEditState.Ready"
            JOIN_FIELDS: sview = "join\\(session.fields, session.policy.output_separator\\)"
            ADAPTER_SCANNED_EDIT: sview = "scanned_fields_edit_and_reconstruct_with_explicit_separators"
            ADAPTER_PRESERVES_SEPARATOR: sview = "record_edit_adapter_preserves_consumed_separator_and_enforces_record_limit"
            RECONSTRUCTED_OUTPUT: sview = "reconstructed == \"a|changed|\\\\n\""
            ADAPTER_RECONSTRUCT_FUNCTION: sview = "record_field_reconstruct_record"
            ADAPTER_OUTPUT_LIMIT_ERROR: sview = "RecordFieldEditError.OutputLimitExceeded"
            INCOMPLETE_SCANNER_OUTPUT: sview = "record_edit_adapter_rejects_incomplete_scanner_output_and_unwired_modes"
            REGEX_SCANNED_RECONSTRUCT: sview = "record_edit_adapter_reconstructs_regex_scanned_fields"
            INVALID_REGEX_SPANS: sview = "record_edit_adapter_rejects_invalid_regex_spans_and_field_overflow"
            NARROW_EDIT_POLICY: sview = "narrow_edit_policy"
            INVALID_SEPARATOR_SPAN: sview = "RecordFieldScanError.InvalidSeparatorSpan"
            FIELD_LIMIT_EXCEEDED: sview = "RecordFieldScanError.FieldLimitExceeded"
            FIELD_SET_MISMATCH: sview = "RecordFieldScanError.FieldSetMismatch"
            FIXTURE_FIXED_WIDTH: sview = "RecordFieldMode.FixedWidth"
            FIXTURE_IMPORT: sview = "using EsRecordFields"
            FIXTURE_CONTRACT: sview = "typed_record_field_edit_contract_reconstructs_deterministically"
            FIXTURE_SET_EVENT: sview = "RecordFieldEditEvent.Set"
            FIXTURE_RECONSTRUCT_EVENT: sview = "RecordFieldEditEvent.Reconstruct"
            FIXTURE_RECONSTRUCT_CALL: sview = "record_field_reconstruct\\(session\\)"
            FIXTURE_INVALID_INDEX: sview = "RecordFieldEditError.InvalidFieldIndex"
            DOCS_EDIT_SESSION: sview = "EsRecordFields::RecordFieldEditSession"
            DOCS_ADAPTER_RECONSTRUCT: sview = "record_field_reconstruct_record"
            DOCS_FIELD_SET_MISMATCH: sview = "FieldSetMismatch"
            LEDGER_ITEM: sview = "ES-SCRIPT-030"


        const module Messages:
            MISSING_ROOT: sview = "record fields audit: missing repository root"
            UNRESOLVED_ROOT: sview = "record fields audit: unable to resolve repository root"
            MISSING_INPUT: sview = "record fields audit: missing "
            READ_FAILED: sview = "record fields audit: unable to read source: "
            VALIDATED_TRANSFER_RESCANS: sview = "record fields audit: validated field transfer must not rescan the owning record"
            RECONSTRUCTION_ORDER: sview = "record fields audit: record size must be checked before allocating reconstructed content"
            SUCCESS: sview = "record fields audit: bounded mutation, deletion, append policy, and reconstruction are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        const enum SearchMode of u8:
            Regex
            Literal


        struct SearchCheck:
            input: Path
            pattern: sview
            mode: SearchMode = SearchMode.Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def regex_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(check.pattern)
            catch EsSourceFunctionScope::contains_file_regex_line(check.input, pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return ExitStatus::IO_FAILURE


        def literal_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return ExitStatus::IO_FAILURE


        def search_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            match check.mode:
                SearchMode.Regex:
                    return regex_status(check)
                SearchMode.Literal:
                    return literal_status(check)
                _:
                    return ExitStatus.FAILURE


        def searches_before_body_checks(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODEL_MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::ADAPTER_MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::ADAPTER_SESSION},
                SearchCheck{input: inputs[1], pattern: Patterns::ADAPTER_RECONSTRUCT_SIGNATURE},
                SearchCheck{input: inputs[2], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::ADAPTER_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::EDIT_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EDIT_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::EDIT_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::EDIT},
                SearchCheck{input: inputs[0], pattern: Patterns::EDIT_SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::EDIT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::RECONSTRUCT_LENGTH},
                SearchCheck{input: inputs[0], pattern: Patterns::RECONSTRUCT},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[1], pattern: Patterns::SESSION_FROM_FIELDS},
                SearchCheck{input: inputs[1], pattern: Patterns::SESSION_FROM_REGEX_SPANS},
                SearchCheck{input: inputs[1], pattern: Patterns::SPLIT_REGEX_SPANS},
                SearchCheck{input: inputs[1], pattern: Patterns::ADAPTER_SESSION},
                SearchCheck{input: inputs[1], pattern: Patterns::ADAPTER_ADVANCE},
                SearchCheck{input: inputs[1], pattern: Patterns::ADAPTER_RECONSTRUCT},
                SearchCheck{input: inputs[1], pattern: Patterns::MODE_SUPPORTED},
                SearchCheck{input: inputs[1], pattern: Patterns::LIMITED_SCAN_POLICY},
                SearchCheck{input: inputs[1], pattern: Patterns::FIELDS_MATCH},
                SearchCheck{input: inputs[1], pattern: Patterns::PRESERVED_SEPARATOR},
                SearchCheck{input: inputs[1], pattern: Patterns::RECONSTRUCT_LENGTH_CALL},
                SearchCheck{input: inputs[1], pattern: Patterns::OUTPUT_LIMIT_ERROR}
            ]


        def validated_transfer_status(adapter_path: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            body: EsSourceFunctionScope::FunctionBody = try EsSourceFunctionScope::read_function_body(adapter_path, Patterns::VALIDATED_TRANSFER) else err:
                diagnostic(Messages::READ_FAILED + f"{adapter_path}")
                return ExitStatus::IO_FAILURE
            return 0i64 if not body.found

            validates_record: Regex = regex(Patterns::VALIDATE_RECORD_CALL)
            validates_field: Regex = regex(Patterns::VALIDATE_RECORD_FIELD_CALL)
            if validates_record.search(body.text) or validates_field.search(body.text):
                diagnostic(Messages::VALIDATED_TRANSFER_RESCANS)
                return ExitStatus::FAILURE
            return 0i64


        def line_number_at(text: sview, position: i64) -> i64:
            return 0i64 if position < 0
            prefix: sview = string_view_prefix(text, position)
            remaining: mutable sview = prefix
            line_number: mutable i64 = 1
            while true:
                newline: i64 = remaining.index("\n")
                break if newline < 0
                line_number <- line_number + 1
                remaining <- string_view_suffix(remaining, newline + 1)
            return line_number


        def reconstruction_order_status(adapter_path: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            body: EsSourceFunctionScope::FunctionBody = try EsSourceFunctionScope::read_function_body(adapter_path, Patterns::RECONSTRUCT_FUNCTION) else err:
                diagnostic(Messages::READ_FAILED + f"{adapter_path}")
                return ExitStatus::IO_FAILURE
            planned_position: i64 = body.text.index(Patterns::RECONSTRUCT_LENGTH_EXPRESSION)
            content_position: i64 = body.text.index(Patterns::RECONSTRUCT_CONTENT_EXPRESSION)
            planned_line: i64 = line_number_at(body.text, planned_position)
            content_line: i64 = line_number_at(body.text, content_position)
            if not body.found or planned_line == 0 or content_line == 0 or planned_line >= content_line:
                diagnostic(Messages::RECONSTRUCTION_ORDER)
                return ExitStatus::FAILURE
            return 0i64


        def searches_after_body_checks(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::EDIT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_FIELDS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_OUTPUT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_SEPARATOR},
                SearchCheck{input: inputs[0], pattern: Patterns::TRAILING_SEPARATOR},
                SearchCheck{input: inputs[0], pattern: Patterns::ALLOW_APPEND},
                SearchCheck{input: inputs[0], pattern: Patterns::BOUNDED_ADD},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_FIELD_INDEX},
                SearchCheck{input: inputs[0], pattern: Patterns::EDIT_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::MODEL_OUTPUT_LIMIT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTING_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EDITING_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPECTED_OUTPUT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::SET_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::RECONSTRUCT_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::READY_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::JOIN_FIELDS},
                SearchCheck{input: inputs[4], pattern: Patterns::ADAPTER_SCANNED_EDIT, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::ADAPTER_PRESERVES_SEPARATOR, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::RECONSTRUCTED_OUTPUT, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::ADAPTER_RECONSTRUCT_FUNCTION, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::ADAPTER_OUTPUT_LIMIT_ERROR, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::INCOMPLETE_SCANNER_OUTPUT, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::REGEX_SCANNED_RECONSTRUCT, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::INVALID_REGEX_SPANS, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::NARROW_EDIT_POLICY, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::INVALID_SEPARATOR_SPAN, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::FIELD_LIMIT_EXCEEDED, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::FIELD_SET_MISMATCH, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_FIXED_WIDTH, mode: SearchMode.Literal},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_SET_EVENT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_RECONSTRUCT_EVENT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_RECONSTRUCT_CALL},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_INVALID_INDEX},
                SearchCheck{input: inputs[5], pattern: Patterns::DOCS_EDIT_SESSION},
                SearchCheck{input: inputs[5], pattern: Patterns::DOCS_ADAPTER_RECONSTRUCT},
                SearchCheck{input: inputs[5], pattern: Patterns::DOCS_FIELD_SET_MISMATCH},
                SearchCheck{input: inputs[6], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(inputs: darray[Path]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in searches_before_body_checks(inputs):
                status: i64 = search_status(check)
                return status if status != 0i64

            transfer_status: i64 = validated_transfer_status(inputs[1])
            return transfer_status if transfer_status != 0i64

            reconstruction_status: i64 = reconstruction_order_status(inputs[1])
            return reconstruction_status if reconstruction_status != 0i64

            for check in searches_after_body_checks(inputs):
                status: i64 = search_status(check)
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::ADAPTER),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::ADAPTER_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(inputs)
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsRecordFieldsAudit::run_default()
