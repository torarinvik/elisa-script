# Bounded Elisascript port of check_json_stream.sh.
# Regex source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsJsonStreamAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/json_stream_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsJsonStream:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/json_stream_model\.elisa\""
            STATE: Regex = regex"const enum JsonStreamState of u8"
            EVENT: Regex = regex"const enum JsonStreamEvent of u8"
            POLICY: Regex = regex"struct JsonStreamPolicy:"
            SESSION: Regex = regex"struct JsonStreamSession:"
            ERROR: Regex = regex"error JsonStreamError:"
            VALIDATE: Regex = regex"def validate_json_stream\("
            ADVANCE: Regex = regex"def advance_json_stream\("
            MAX_INPUT_BYTES: Regex = regex"JSON_STREAM_MAX_INPUT_BYTES"
            MAX_RECORD_BYTES: Regex = regex"JSON_STREAM_MAX_RECORD_BYTES"
            MAX_RECORDS: Regex = regex"JSON_STREAM_MAX_RECORDS"
            MAX_DEPTH: Regex = regex"JSON_STREAM_MAX_DEPTH"
            PENDING_CR: Regex = regex"pending_cr: bool = false"
            FLUSH_PENDING_CR: Regex = regex"def json_stream_flush_pending_cr\("
            FINISH_RECORD: Regex = regex"json_stream_finish_record"
            CRLF: Regex = regex"session.pending_cr and byte == 10u8"
            CLOSED_CONTAINER: Regex = regex"return not session.in_string and session.depth == 0"
            RECORD_BYTES_INCREMENT: Regex = regex"not json_stream_increment\(session.record_bytes, session.policy.max_record_bytes\)"
            IN_STRING: Regex = regex"in_string"
            ESCAPED: Regex = regex"escaped"
            DEPTH_UNDERFLOW: Regex = regex"JsonStreamError.DepthUnderflow"
            MISMATCHED_DELIMITER: Regex = regex"JsonStreamError.MismatchedDelimiter"
            ACCOUNTING_INVALID: Regex = regex"JsonStreamError.AccountingInvalid"
            RECORDS_WITHIN_INPUT: Regex = regex"session.records > session.input_bytes"
            NONEMPTY_RECORDS: Regex = regex"session.records > session.input_bytes and not session.policy.allow_empty_records"
            CONTAINER_STACK: Regex = regex"container_stack"
            PENDING_TERMINAL_STATE: Regex = regex"session.pending_cr and (session.in_string or session.escaped or session.depth != 0)"
            READY_STATE: Regex = regex"session.state == JsonStreamState.Ready"
            COMPLETE_STATE: Regex = regex"session.state == JsonStreamState.Complete"
            UNTERMINATED_STRING: Regex = regex"JsonStreamError.UnterminatedString"
            UNTERMINATED_VALUE: Regex = regex"JsonStreamError.UnterminatedValue"
            INPUT_BYTE_INCREMENT: Regex = regex"session.input_bytes <- session.input_bytes \+ 1"
            RECORD_END: Regex = regex"JsonStreamEvent.RecordEnd"
            CANCEL: Regex = regex"JsonStreamEvent.Cancel"
            COMPLETE: Regex = regex"JsonStreamState.Complete"
            FIXTURE_IMPORT: Regex = regex"using EsJsonStream"
            FIXTURE_CONTRACT: Regex = regex"typed_json_stream_contract_frames_records_and_depth"
            FIXTURE_BYTE: Regex = regex"JsonStreamEvent.Byte"
            FIXTURE_END: Regex = regex"JsonStreamEvent.End"
            FIXTURE_UNTERMINATED: Regex = regex"JsonStreamError.UnterminatedValue"
            FIXTURE_LIMIT: Regex = regex"JsonStreamError.RecordBytesLimitExceeded"
            FIXTURE_OVERSIZED_INPUT: Regex = regex"assert oversized.input_bytes == 2"
            FIXTURE_EMPTY_RECORDS: Regex = regex"allow_empty_records"
            FIXTURE_CRLF: Regex = regex"crlf_exact.pending_cr"
            FIXTURE_FORGED_COMPLETE: Regex = regex"forged_complete"
            DOCS_SESSION: Regex = regex"EsJsonStream::JsonStreamSession"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-036"


        const module Messages:
            MISSING_ROOT: sview = "json stream audit: missing repository root"
            UNRESOLVED_ROOT: sview = "json stream audit: unable to resolve repository root"
            MISSING_INPUT: sview = "json stream audit: missing "
            READ_FAILED: sview = "json stream audit: unable to read source: "
            SUCCESS: sview = "json stream audit: bounded JSONL framing, string/escape tracking, and depth limits are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_INPUT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_RECORD_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_RECORDS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_DEPTH},
                SearchCheck{input: inputs[0], pattern: Patterns::PENDING_CR},
                SearchCheck{input: inputs[0], pattern: Patterns::FLUSH_PENDING_CR},
                SearchCheck{input: inputs[0], pattern: Patterns::FINISH_RECORD},
                SearchCheck{input: inputs[0], pattern: Patterns::CRLF},
                SearchCheck{input: inputs[0], pattern: Patterns::CLOSED_CONTAINER},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_BYTES_INCREMENT},
                SearchCheck{input: inputs[0], pattern: Patterns::IN_STRING},
                SearchCheck{input: inputs[0], pattern: Patterns::ESCAPED},
                SearchCheck{input: inputs[0], pattern: Patterns::DEPTH_UNDERFLOW},
                SearchCheck{input: inputs[0], pattern: Patterns::MISMATCHED_DELIMITER},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTING_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORDS_WITHIN_INPUT},
                SearchCheck{input: inputs[0], pattern: Patterns::NONEMPTY_RECORDS},
                SearchCheck{input: inputs[0], pattern: Patterns::CONTAINER_STACK},
                SearchCheck{input: inputs[0], pattern: Patterns::PENDING_TERMINAL_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::READY_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::UNTERMINATED_STRING},
                SearchCheck{input: inputs[0], pattern: Patterns::UNTERMINATED_VALUE},
                SearchCheck{input: inputs[0], pattern: Patterns::READY_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::INPUT_BYTE_INCREMENT},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_END},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_BYTE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_END},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_UNTERMINATED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_LIMIT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_OVERSIZED_INPUT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_EMPTY_RECORDS},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CRLF},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_FORGED_COMPLETE},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsJsonStreamAudit::run_default()
