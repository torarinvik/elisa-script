# Bounded Elisascript port of check_map_concat_capacity.sh.
# Scoped and documentation checks stream through the shared source scanner.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsMapConcatCapacityAudit:
    private:
        const module Inputs:
            INTERPRETER: sview = "src/ir/interpret.elisa"
            BYTECODE: sview = "src/bytecode/bytecode.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            INTERPRETER_FUNCTION: sview = "def evaluate_concat"
            BYTECODE_FUNCTION: sview = "def bytecode_direct_concat"
            ADDITIONAL_COUNT: sview = "additional: mutable usize = 0"
            EXACT_PREFLIGHT: sview = "runtime_storage_two_pair_spans_u32_valid(storage, left.map_count.usize(), additional)"
            STORAGE_START: sview = "start: u32 = storage.count.u32()"
            DOCS: sview = "Map concatenation likewise counts only right-hand keys"
            LEDGER: sview = "preflights only newly introduced right-hand keys"


        const module Messages:
            MISSING_ROOT: sview = "map concat capacity audit: missing repository root"
            UNRESOLVED_ROOT: sview = "map concat capacity audit: unable to resolve repository root"
            MISSING_INPUT: sview = "map concat capacity audit: missing "
            MISSING_MARKERS: sview = "map concat capacity audit: missing exact preflight markers in "
            WRONG_ORDER: sview = "map concat capacity audit: map copy precedes exact preflight in "
            READ_FAILED: sview = "map concat capacity audit: unable to read source: "
            SUCCESS: sview = "map concat capacity audit: duplicate-only merges do not require unused pair capacity"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


        def assert_exact_preflight(path: Path, definition: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            body: EsSourceFunctionScope::FunctionBody = try EsSourceFunctionScope::read_function_body(path, definition) else err:
                diagnostic(Messages::READ_FAILED + f"{path}")
                return ExitStatus::IO_FAILURE
            count_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::ADDITIONAL_COUNT)
            preflight_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::EXACT_PREFLIGHT)
            allocate_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::STORAGE_START)
            if count_line == 0 or preflight_line == 0 or allocate_line == 0:
                diagnostic(Messages::MISSING_MARKERS + f"{path}")
                return ExitStatus::FAILURE
            if count_line >= preflight_line or preflight_line >= allocate_line:
                diagnostic(Messages::WRONG_ORDER + f"{path}")
                return ExitStatus::FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::BYTECODE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: mutable i64 = assert_exact_preflight(inputs[0], Patterns::INTERPRETER_FUNCTION)
            return status if status != 0i64
            status <- assert_exact_preflight(inputs[1], Patterns::BYTECODE_FUNCTION)
            return status if status != 0i64

            checks: darray[SearchCheck] = [
                SearchCheck{input: inputs[2], pattern: Patterns::DOCS},
                SearchCheck{input: inputs[3], pattern: Patterns::LEDGER}
            ]
            for check in checks:
                status <- has_line(check.input, check.pattern)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsMapConcatCapacityAudit::run_default()
