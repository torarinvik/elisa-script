# Bounded Elisascript port of check_global_map_admission.sh.
# Source checks use the shared streaming scanner and do not launch awk or rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsGlobalMapAdmissionAudit:
    private:
        const module Inputs:
            INTERPRETER: sview = "src/ir/interpret.elisa"
            VERIFIER: sview = "src/ir/ir_verify.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            FUNCTION: sview = "def global_value("
            MAP_BRANCH: sview = "binding.type.kind == TypeKind.Map"
            ODD_PAYLOAD: sview = "binding.aggregate_values.count % 2 != 0"
            INVALID_CONTROL_FLOW: sview = "InterpretFailure.InvalidControlFlow"
            VERIFY_DIAGNOSTIC: sview = "module global map initializer must contain key/value pairs"
            DOCS_COVERAGE: sview = "fails closed on malformed odd-length map payloads"
            LEDGER_COVERAGE: sview = "rejects odd key/value payload lengths"


        const module Messages:
            MISSING_ROOT: sview = "global map admission audit: missing repository root"
            UNRESOLVED_ROOT: sview = "global map admission audit: unable to resolve repository root"
            MISSING_INPUT: sview = "global map admission audit: missing "
            MISSING_GUARD: sview = "global map admission audit: missing odd-payload runtime guard"
            GUARD_ORDER: sview = "global map admission audit: guard is not inside the map branch"
            READ_FAILED: sview = "global map admission audit: unable to read source: "
            SUCCESS: sview = "global map admission audit: verifier and runtime reject odd key/value initializer payloads"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)

            inputs: darray[Path] = [
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::VERIFIER),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            function_body: EsSourceFunctionScope::FunctionBody = try EsSourceFunctionScope::read_function_body(inputs[0], Patterns::FUNCTION) else err:
                diagnostic(Messages::READ_FAILED + f"{inputs[0]}")
                return ExitStatus::IO_FAILURE
            guard_line: usize = EsSourceFunctionScope::first_line_number(function_body.text, Patterns::ODD_PAYLOAD)
            branch_line: usize = EsSourceFunctionScope::first_line_number(function_body.text, Patterns::MAP_BRANCH)
            failure_line: usize = EsSourceFunctionScope::first_line_number(function_body.text, Patterns::INVALID_CONTROL_FLOW)
            if guard_line == 0 or branch_line == 0 or failure_line == 0:
                diagnostic(Messages::MISSING_GUARD)
                return ExitStatus::FAILURE
            if branch_line >= guard_line or guard_line >= failure_line:
                diagnostic(Messages::GUARD_ORDER)
                return ExitStatus::FAILURE

            status: mutable i64 = has_line(inputs[1], Patterns::VERIFY_DIAGNOSTIC)
            return status if status != 0i64
            status <- has_line(inputs[2], Patterns::DOCS_COVERAGE)
            return status if status != 0i64
            status <- has_line(inputs[3], Patterns::LEDGER_COVERAGE)
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsGlobalMapAdmissionAudit::run_default()
