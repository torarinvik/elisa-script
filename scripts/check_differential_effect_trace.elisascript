# Bounded Elisascript port of check_differential_effect_trace.sh.
# Fixed-string checks stream through the shared scanner without rg/awk.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDifferentialEffectTraceAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/testing/effect_trace_model.elisa"
            CONSUMER: sview = "src/testing/differential.elisa"
            FIXTURE: sview = "test/differential/elisascript_differential_test.elisa"
            DOCS: sview = "docs/differential-testing.md"


        const module Patterns:
            MODULE: sview = "module EsDifferentialEffectTrace:"
            EVENT_LIMIT: sview = "Limits::EVENTS"
            RESUMPTION_LIMIT: sview = "Limits::RESUMPTIONS"
            TRACE_STATE: sview = "const enum DifferentialEffectTraceState of u8:"
            TRACE_EVENT: sview = "const enum DifferentialEffectTraceEvent of u8:"
            EFFECT_EVENT: sview = "struct DifferentialEffectEvent:"
            TRACE: sview = "struct DifferentialEffectTrace:"
            DIFFERENCE_KIND: sview = "const enum DifferentialEffectDifferenceKind of u8:"
            DIFFERENCE: sview = "struct DifferentialEffectDifference:"
            ERROR: sview = "error DifferentialEffectTraceError:"
            VALIDATE: sview = "def validate_differential_effect_trace("
            ADVANCE: sview = "def advance_differential_effect_trace("
            FINGERPRINT: sview = "def differential_effect_trace_fingerprint("
            COMPARE: sview = "def compare_differential_effect_traces("
            PAYLOAD_FINGERPRINT: sview = "payload_fingerprint"
            RESULT_FINGERPRINT: sview = "result_fingerprint"
            RESUMPTION_COUNT: sview = "resumption_count"
            MULTISHOT_INVALID: sview = "MultishotInvalid"
            DIFFERENCE_FAMILY: sview = "DifferentialEffectDifferenceKind.Family"
            DIFFERENCE_OPERATION: sview = "DifferentialEffectDifferenceKind.Operation"
            DIFFERENCE_PAYLOAD: sview = "DifferentialEffectDifferenceKind.Payload"
            DIFFERENCE_RESUMPTION: sview = "DifferentialEffectDifferenceKind.Resumption"
            DIFFERENCE_INVALID: sview = "DifferentialEffectDifferenceKind.Invalid"
            SEQUENCE_INDEX: sview = "sequence_index != index"
            CATCH_VALIDATE: sview = "catch validate_differential_effect_trace(trace)"
            CONSUMER_IMPORT: sview = "include \"./effect_trace_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsDifferentialEffectTrace"
            FIXTURE_CONTRACT: sview = "differential_effect_trace_contract_preserves_operation_and_resumption_differences"
            FIXTURE_RECORD: sview = "DifferentialEffectTraceEvent.Record"
            FIXTURE_EQUAL: sview = "DifferentialEffectDifferenceKind.Equal"
            FIXTURE_OPERATION: sview = "DifferentialEffectDifferenceKind.Operation"
            FIXTURE_INVALID: sview = "DifferentialEffectDifferenceKind.Invalid"
            FIXTURE_MALFORMED: sview = "malformed_sequence"
            FIXTURE_INVALID_SEALED: sview = "invalid_sealed_trace"
            FIXTURE_REJECTED_FINGERPRINT: sview = "differential_effect_trace_fingerprint(invalid_sealed_trace) == 0"
            DOCS_TRACE: sview = "EsDifferentialEffectTrace::DifferentialEffectTrace"


        const module Messages:
            MISSING_ROOT: sview = "differential effect-trace audit: missing repository root"
            UNRESOLVED_ROOT: sview = "differential effect-trace audit: unable to resolve repository root"
            MISSING_INPUT: sview = "differential effect-trace audit: missing "
            READ_FAILED: sview = "differential effect-trace audit: unable to read source: "
            SUCCESS: sview = "differential effect-trace audit: bounded operation identities, resumption counts, fingerprints, and first differences are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::RESUMPTION_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::TRACE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::TRACE_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::EFFECT_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::TRACE},
                SearchCheck{input: inputs[0], pattern: Patterns::DIFFERENCE_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::DIFFERENCE},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::FINGERPRINT},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPARE},
                SearchCheck{input: inputs[0], pattern: Patterns::PAYLOAD_FINGERPRINT},
                SearchCheck{input: inputs[0], pattern: Patterns::RESULT_FINGERPRINT},
                SearchCheck{input: inputs[0], pattern: Patterns::RESUMPTION_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::MULTISHOT_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::DIFFERENCE_FAMILY},
                SearchCheck{input: inputs[0], pattern: Patterns::DIFFERENCE_OPERATION},
                SearchCheck{input: inputs[0], pattern: Patterns::DIFFERENCE_PAYLOAD},
                SearchCheck{input: inputs[0], pattern: Patterns::DIFFERENCE_RESUMPTION},
                SearchCheck{input: inputs[0], pattern: Patterns::DIFFERENCE_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::SEQUENCE_INDEX},
                SearchCheck{input: inputs[0], pattern: Patterns::CATCH_VALIDATE},
                SearchCheck{input: inputs[1], pattern: Patterns::CONSUMER_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_RECORD},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_EQUAL},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_OPERATION},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_MALFORMED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_SEALED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_REJECTED_FINGERPRINT},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_TRACE}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::CONSUMER),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDifferentialEffectTraceAudit::run_default()
