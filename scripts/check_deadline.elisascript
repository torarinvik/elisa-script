# Bounded Elisascript port of check_deadline.sh.
# Regex source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDeadlineAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/deadline_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsDeadline:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/deadline_model\.elisa\""
            CLOCK_MODE: Regex = regex"const enum DeadlineClockMode of u8"
            WAIT_STATE: Regex = regex"const enum DeadlineWaitState of u8"
            EVENT: Regex = regex"const enum DeadlineEvent of u8"
            POLICY: Regex = regex"struct DeadlinePolicy:"
            WAIT: Regex = regex"struct DeadlineWait:"
            CLOCK: Regex = regex"struct DeadlineClock:"
            ERROR: Regex = regex"error DeadlineError:"
            VALIDATE: Regex = regex"def validate_deadline_clock\("
            ARM: Regex = regex"def deadline_arm\("
            ADVANCE: Regex = regex"def deadline_advance\("
            FIRE: Regex = regex"def deadline_fire\("
            CANCEL: Regex = regex"def deadline_cancel\("
            WAIT_LIMIT: Regex = regex"Limits::WAITS"
            ADVANCE_LIMIT: Regex = regex"Limits::ADVANCE"
            HOST_MONOTONIC: Regex = regex"DeadlineClockMode.HostMonotonic"
            VIRTUAL: Regex = regex"DeadlineClockMode.Virtual"
            DEADLINE_IN_PAST: Regex = regex"DeadlineError.DeadlineInPast"
            ADVANCE_LIMIT_ERROR: Regex = regex"DeadlineError.AdvanceLimitExceeded"
            NO_DUE_WAIT: Regex = regex"DeadlineError.NoDueWait"
            FIRE_ORDER: Regex = regex"DeadlineError.FireOrderInvalid"
            CANDIDATE_LOOP: Regex = regex"for candidate in clock.waits"
            READY_AFTER_NOW: Regex = regex"wait.state == DeadlineWaitState.Ready and wait.deadline > clock.now"
            ACCOUNTING: Regex = regex"DeadlineError.AccountingInvalid"
            FIXTURE_IMPORT: Regex = regex"using EsDeadline"
            FIXTURE_CONTRACT: Regex = regex"typed_deadline_contract_is_monotonic_and_fireable_in_virtual_time"
            FIXTURE_VIRTUAL: Regex = regex"DeadlineClockMode.Virtual"
            FIXTURE_NO_DUE_WAIT: Regex = regex"DeadlineError.NoDueWait"
            FIXTURE_ADVANCE_LIMIT: Regex = regex"DeadlineError.AdvanceLimitExceeded"
            FIXTURE_FIRE_ORDER: Regex = regex"DeadlineError.FireOrderInvalid"
            DOCS_CLOCK: Regex = regex"EsDeadline::DeadlineClock"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-048"


        const module Messages:
            MISSING_ROOT: sview = "deadline audit: missing repository root"
            UNRESOLVED_ROOT: sview = "deadline audit: unable to resolve repository root"
            MISSING_INPUT: sview = "deadline audit: missing "
            READ_FAILED: sview = "deadline audit: unable to read source: "
            SUCCESS: sview = "deadline audit: monotonic host/virtual time, bounded waits, and due-fire transitions are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::CLOCK_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::WAIT_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::WAIT},
                SearchCheck{input: inputs[0], pattern: Patterns::CLOCK},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ARM},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::FIRE},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL},
                SearchCheck{input: inputs[0], pattern: Patterns::WAIT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::HOST_MONOTONIC},
                SearchCheck{input: inputs[0], pattern: Patterns::VIRTUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::DEADLINE_IN_PAST},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE_LIMIT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::NO_DUE_WAIT},
                SearchCheck{input: inputs[0], pattern: Patterns::FIRE_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::CANDIDATE_LOOP},
                SearchCheck{input: inputs[0], pattern: Patterns::READY_AFTER_NOW},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTING},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_VIRTUAL},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_NO_DUE_WAIT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ADVANCE_LIMIT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_FIRE_ORDER},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_CLOCK},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def has_match(path: Path, pattern: Regex) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_regex_line(path, pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            for check in searches(inputs):
                status: i64 = has_match(check.input, check.pattern)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDeadlineAudit::run_default()
