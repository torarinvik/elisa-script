# Bounded, read-only port of check_diagnostic_snapshot.sh.
# The candidate accepts the source path explicitly so the shell reference and
# Elisascript implementation inspect the same fixture bytes.
# With no path it finds src/ir/runner.elisa relative to this script, matching
# the shell reference even when the caller's current directory is elsewhere.

include "../src/runtime/bounded_text_posix.elisa"

using EsBoundedText


module EsDiagnosticSnapshotAudit:
    private:
        const module Limits:
            SOURCE_BYTES: usize = 262144
            FIELDS: usize = 256
            FIELD_BYTES: usize = 128


        const module Syntax:
            STRUCT_HEADER: sview = "        struct ElisascriptProgramDiagnostic:"
            FUNCTION_PREFIX: sview = "        def "
            FINGERPRINT_HEADER: sview = "        def elisascript_program_diagnostic_snapshot_fingerprint"
            EQUALITY_HEADER: sview = "        def elisascript_program_diagnostic_snapshot_equal"
            FIELD_INDENT: sview = "            "


        const enum Phase of u8:
            SeekStruct
            ReadStruct
            SearchFunctions
            Fingerprint
            Equality
            Done


        def write_diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        # Match the reference's LC_ALL=C awk byte classes; Unicode whitespace is not accepted.
        def is_ascii_field_start(byte: u8) -> bool:
            return byte == 95u8 or byte >= 97u8 and byte <= 122u8


        def is_ascii_field_continue(byte: u8) -> bool:
            return is_ascii_field_start(byte) or byte >= 48u8 and byte <= 57u8


        def is_c_locale_space(byte: u8) -> bool:
            return byte == 32u8 or byte >= 9u8 and byte <= 13u8


        def diagnostic_field_name(line: sview) -> sview:
            return "" if not line.startswith(Syntax::FIELD_INDENT)
            indent_length: usize = sview_len(Syntax::FIELD_INDENT)
            line_length: usize = sview_len(line)
            return "" if line_length <= indent_length

            cursor: mutable usize = indent_length
            return "" if not is_ascii_field_start(sview_at(line, cursor))
            cursor <- cursor + 1
            while cursor < line_length and is_ascii_field_continue(sview_at(line, cursor)) |line, cursor|:
                cursor <- cursor + 1

            name_end: usize = cursor
            while cursor < line_length and is_c_locale_space(sview_at(line, cursor)) |line, cursor|:
                cursor <- cursor + 1

            return "" if cursor >= line_length or sview_at(line, cursor) != 58u8
            return line[indent_length:name_end]


        def run_default() -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, File.Read, Blocking.IO, Unsafe.PointerCast]:
            script_directory: Path = try path_real(path_parent(Script::source_path())) else err:
                write_diagnostic("diagnostic snapshot audit: unable to resolve script directory")
                return 1i64
            repository_root: Path = script_directory.parent()
            runner_source: Path = repository_root.joinpath("src").joinpath("ir").joinpath("runner.elisa")
            return run(f"{runner_source}")


    public:
        def run(source_path: sview) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, File.Read, Blocking.IO, Unsafe.PointerCast]:
            input_path: Path = path(source_path)
            if not is_file(input_path):
                write_diagnostic("diagnostic snapshot audit: missing runner source")
                return 1i64

            source_size: usize = try file_size(input_path) else err:
                write_diagnostic("diagnostic snapshot audit: missing runner source")
                return 1i64

            if source_size > Limits::SOURCE_BYTES:
                write_diagnostic("diagnostic snapshot audit: runner source exceeds audit limit")
                return 1i64

            source: mutable sview = ""
            catch EsBoundedText::read_utf8(input_path, Limits::SOURCE_BYTES):
                ok contents:
                    source <- contents
                error failure:
                    if failure == EsBoundedText::ReadError.LimitExceeded:
                        write_diagnostic("diagnostic snapshot audit: runner source exceeds audit limit")
                    else:
                        write_diagnostic("diagnostic snapshot audit: missing runner source")
                    return 1i64

            if len(source) > Limits::SOURCE_BYTES:
                write_diagnostic("diagnostic snapshot audit: runner source exceeds audit limit")
                return 1i64

            normalized_source: sview = source.replace("\r\n", "\n")
            if normalized_source.index("\r") >= 0:
                write_diagnostic("diagnostic snapshot audit: bare carriage return is unsupported")
                return 1i64

            lines: darray[sview] = split_lines(normalized_source)
            fields: mutable darray[sview] = []
            fingerprint_lines: mutable darray[sview] = []
            equality_lines: mutable darray[sview] = []
            phase: mutable Phase = Phase.SeekStruct
            index: mutable usize = 0
            saw_fingerprint: mutable bool = false
            saw_equality: mutable bool = false

            machine over phase while phase != Phase.Done:
                state Scan
                start Scan

                Scan, Phase.SeekStruct if index >= lines.count:
                    phase <- Phase.Done
                    -> Scan

                Scan, Phase.SeekStruct if lines[index].startswith(Syntax::STRUCT_HEADER):
                    phase <- Phase.ReadStruct
                    index <- index + 1
                    -> Scan

                Scan, Phase.SeekStruct:
                    index <- index + 1
                    -> Scan

                Scan, Phase.ReadStruct if index >= lines.count:
                    phase <- Phase.SearchFunctions
                    index <- 0
                    -> Scan

                Scan, Phase.ReadStruct if lines[index] == "":
                    phase <- Phase.SearchFunctions
                    index <- 0
                    -> Scan

                Scan, Phase.ReadStruct if lines[index].startswith(Syntax::FIELD_INDENT):
                    field_line: sview = lines[index]
                    field_name: sview = diagnostic_field_name(field_line)
                    if field_name != "":
                        if fields.count >= Limits::FIELDS:
                            write_diagnostic("diagnostic snapshot audit: diagnostic field count exceeds audit limit")
                            return 1i64
                        fields.push(field_name)
                    index <- index + 1
                    -> Scan

                Scan, Phase.ReadStruct:
                    index <- index + 1
                    -> Scan

                Scan, Phase.SearchFunctions if index >= lines.count:
                    phase <- Phase.Done
                    -> Scan

                Scan, Phase.SearchFunctions if not saw_fingerprint and lines[index].startswith(Syntax::FINGERPRINT_HEADER):
                    saw_fingerprint <- true
                    fingerprint_lines.push(lines[index])
                    phase <- Phase.Fingerprint
                    index <- index + 1
                    -> Scan

                Scan, Phase.SearchFunctions if not saw_equality and lines[index].startswith(Syntax::EQUALITY_HEADER):
                    saw_equality <- true
                    equality_lines.push(lines[index])
                    phase <- Phase.Equality
                    index <- index + 1
                    -> Scan

                Scan, Phase.SearchFunctions:
                    index <- index + 1
                    -> Scan

                Scan, Phase.Fingerprint if index >= lines.count:
                    phase <- Phase.Done
                    -> Scan

                Scan, Phase.Fingerprint if not saw_equality and lines[index].startswith(Syntax::FUNCTION_PREFIX) and lines[index].startswith(Syntax::EQUALITY_HEADER):
                    saw_equality <- true
                    equality_lines.push(lines[index])
                    phase <- Phase.Equality
                    index <- index + 1
                    -> Scan

                Scan, Phase.Fingerprint if lines[index].startswith(Syntax::FUNCTION_PREFIX):
                    phase <- Phase.SearchFunctions
                    index <- index + 1
                    -> Scan

                Scan, Phase.Fingerprint:
                    fingerprint_lines.push(lines[index])
                    index <- index + 1
                    -> Scan

                Scan, Phase.Equality if index >= lines.count:
                    phase <- Phase.Done
                    -> Scan

                Scan, Phase.Equality if lines[index].startswith(Syntax::FUNCTION_PREFIX):
                    phase <- Phase.SearchFunctions
                    index <- index + 1
                    -> Scan

                Scan, Phase.Equality:
                    equality_lines.push(lines[index])
                    index <- index + 1
                    -> Scan

                Scan, Phase.Done:
                    break

            if fields.count == 0:
                write_diagnostic("diagnostic snapshot audit: no diagnostic fields found")
                return 1i64

            for field_name in fields:
                if len(field_name) > Limits::FIELD_BYTES:
                    write_diagnostic("diagnostic snapshot audit: diagnostic field name exceeds audit limit")
                    return 1i64

            if not saw_fingerprint or not saw_equality:
                write_diagnostic("diagnostic snapshot audit: missing snapshot operations")
                return 1i64

            fingerprint_body: sview = join(fingerprint_lines, "\n")
            equality_body: sview = join(equality_lines, "\n")
            missing: mutable bool = false
            covered_fields: mutable usize = 0

            for field_name in fields:
                if field_name == "execution":
                    continue

                covered_fields <- covered_fields + 1
                fingerprint_pattern_text: sview = "(^|[^A-Za-z0-9_])diagnostic[.]" + field_name + "([^A-Za-z0-9_]|$)"
                equality_left_pattern_text: sview = "(^|[^A-Za-z0-9_])left[.]" + field_name + "([^A-Za-z0-9_]|$)"
                equality_right_pattern_text: sview = "(^|[^A-Za-z0-9_])right[.]" + field_name + "([^A-Za-z0-9_]|$)"
                fingerprint_pattern: Regex = regex(fingerprint_pattern_text)
                equality_left_pattern: Regex = regex(equality_left_pattern_text)
                equality_right_pattern: Regex = regex(equality_right_pattern_text)

                if not fingerprint_pattern.search(fingerprint_body):
                    write_diagnostic(f"diagnostic snapshot audit: fingerprint omits {field_name}")
                    missing <- true

                if not equality_left_pattern.search(equality_body) or not equality_right_pattern.search(equality_body):
                    write_diagnostic(f"diagnostic snapshot audit: structural equality omits {field_name}")
                    missing <- true

            if missing:
                return 1i64

            print(f"diagnostic snapshot audit: {covered_fields} fields covered (execution intentionally excluded)")
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, File.Read, Blocking.IO, Unsafe.PointerCast]:
    if arguments.count > 1:
        _ = write_stderr("usage: diagnostic snapshot audit [runner-source]\n")
        return 2i64

    if arguments.count == 1:
        if arguments[0] != "":
            return EsDiagnosticSnapshotAudit::run(arguments[0])
    return EsDiagnosticSnapshotAudit::run_default()
