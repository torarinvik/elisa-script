# Bounded, read-only port of check_diagnostic_snapshot.sh.
# The candidate accepts the source path explicitly so the shell reference and
# Elisascript implementation inspect the same fixture bytes.
# With no path it finds src/ir/runner.elisa relative to this script, matching
# the shell reference even when the caller's current directory is elsewhere.

include "../src/runtime/encoding.elisa"
include "../src/runtime/file_posix.elisa"
include "../src/runtime/directory_posix.elisa"
include "../src/runtime/stdio_posix.elisa"

using EsEncoding
using EsRuntime


module EsDiagnosticSnapshotAudit:
    private:
        const module Limits:
            PATH_BYTES: usize = 4096
            SOURCE_BYTES: usize = 262144
            FIELDS: usize = 256
            FIELD_BYTES: usize = 128
            READ_CHUNK_BYTES: usize = 16384
            READ_EINTR_RETRIES: usize = 4


        const module Syntax:
            STRUCT_HEADER: sview = "        struct ElisascriptProgramDiagnostic:"
            FUNCTION_PREFIX: sview = "        def "
            FINGERPRINT_HEADER: sview = "        def elisascript_program_diagnostic_snapshot_fingerprint"
            EQUALITY_HEADER: sview = "        def elisascript_program_diagnostic_snapshot_equal"
            FIELD_INDENT: sview = "            "


        const enum Phase of u8:
            SeekStruct
            ReadStruct
            SearchFunctions
            Fingerprint
            Equality
            Done


        struct BoundedSourceRead:
            source: sview = ""
            failure: bool = false
            exceeded_limit: bool = false


        const enum ReadPhase of u8:
            ReadChunk
            Done


        def run_default() -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, File.Read]:
            script_directory: Path = try path_real(path_parent(Script::source_path())) else err:
                eprint("diagnostic snapshot audit: unable to resolve script directory")
                return 1i64
            repository_root: Path = script_directory.parent()
            runner_source: Path = repository_root.joinpath("src").joinpath("ir").joinpath("runner.elisa")
            return run(f"{runner_source}")


        def diagnostic_snapshot_open(path_value: cstr, flags: int) -> int can[Blocking.IO, Unsafe.PointerCast]:
            retries: mutable usize = 0
            while true:
                descriptor: int = elisascript_posix_open(path_value, flags, 0u32)
                return descriptor if descriptor >= 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::READ_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return -1


        def diagnostic_snapshot_stat(path_value: cstr, result: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_stat(path_value, result) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::READ_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def diagnostic_snapshot_fstat(descriptor: int, result: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_fstat(descriptor, result) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::READ_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def diagnostic_snapshot_same_file(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return left.device == right.device and left.inode == right.inode


        def diagnostic_snapshot_stable_file(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return diagnostic_snapshot_same_file(left, right) and left.size == right.size and left.modify_time == right.modify_time and left.change_time == right.change_time


        # Preserve the shell reference's symlink-following file semantics while
        # bounding bytes actually retained, not only a pre-read size sample.
        # NONBLOCK plus fstat keeps a path replaced by a FIFO from hanging.
        def read_bounded_source(input_path: Path, maximum_bytes: usize) -> BoundedSourceRead can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_text: sview = f"{input_path}"
            return BoundedSourceRead{failure: true} if path_text == "" or len(path_text) >= Limits::PATH_BYTES or sview_contains_byte(path_text, 0)
            path_bytes: mutable darray[u8] = []
            for byte in path_text |path_bytes|:
                path_bytes.push(byte)
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr]

            named_before_open: mutable ElisascriptStat = zeroed
            if not diagnostic_snapshot_stat(path_pointer, named_before_open) or (named_before_open.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR:
                return BoundedSourceRead{failure: true}
            open_flags: int = DarwinOpenFlags::RDONLY | DarwinOpenFlags::NONBLOCK | DarwinOpenFlags::CLOSE_ON_EXEC
            descriptor: int = diagnostic_snapshot_open(path_pointer, open_flags)
            return BoundedSourceRead{failure: true} if descriptor < 0
            opened: mutable ElisascriptStat = zeroed
            if not diagnostic_snapshot_fstat(descriptor, opened) or (opened.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR or not diagnostic_snapshot_same_file(named_before_open, opened):
                _ = elisascript_posix_close(descriptor)
                return BoundedSourceRead{failure: true}
            named_after_open: mutable ElisascriptStat = zeroed
            if not diagnostic_snapshot_stat(path_pointer, named_after_open) or not diagnostic_snapshot_same_file(opened, named_after_open):
                _ = elisascript_posix_close(descriptor)
                return BoundedSourceRead{failure: true}

            chunk: mutable darray[u8] = []
            chunk.reserve(Limits::READ_CHUNK_BYTES)
            for _ in 0..<Limits::READ_CHUNK_BYTES |chunk|:
                chunk.push(0u8)
            source: mutable darray[u8] = []
            initial_capacity: usize = maximum_bytes if maximum_bytes < Limits::READ_CHUNK_BYTES else Limits::READ_CHUNK_BYTES
            source.reserve(initial_capacity)
            phase: mutable ReadPhase = ReadPhase.ReadChunk
            interrupted: mutable usize = 0
            machine over phase while phase != ReadPhase.Done:
                state ReadChunk
                start ReadChunk

                ReadChunk, ReadPhase.ReadChunk:
                    remaining: usize = maximum_bytes - source.count
                    probe_capacity: usize = remaining + 1
                    capacity: usize = probe_capacity if probe_capacity < chunk.count else chunk.count
                    chunk_pointer: mutable u8& = (&chunk[0]).cast[mutable u8&]
                    amount: isize = elisascript_posix_read(descriptor, chunk_pointer.cast[mutable void&], capacity)
                    if amount < 0:
                        errno: mutable i32& = elisascript_posix_errno()
                        if errno[0] == DarwinErrno::EINTR and interrupted < Limits::READ_EINTR_RETRIES:
                            interrupted <- interrupted + 1
                            -> ReadChunk
                        _ = elisascript_posix_close(descriptor)
                        return BoundedSourceRead{failure: true}
                    if amount == 0:
                        phase <- ReadPhase.Done
                        continue
                    read_count: usize = amount.usize()
                    if read_count > capacity:
                        _ = elisascript_posix_close(descriptor)
                        return BoundedSourceRead{failure: true}
                    if read_count > remaining:
                        _ = elisascript_posix_close(descriptor)
                        return BoundedSourceRead{exceeded_limit: true}
                    for offset in 0..<read_count |source, chunk|:
                        source.push(chunk[offset])
                    interrupted <- 0
                    -> ReadChunk

                ReadChunk, ReadPhase.Done:
                    break

            final_opened: mutable ElisascriptStat = zeroed
            final_named: mutable ElisascriptStat = zeroed
            stable: bool = diagnostic_snapshot_fstat(descriptor, final_opened) and diagnostic_snapshot_stat(path_pointer, final_named) and diagnostic_snapshot_stable_file(opened, final_opened) and diagnostic_snapshot_same_file(final_opened, final_named)
            close_status: int = elisascript_posix_close(descriptor)
            return BoundedSourceRead{failure: true} if close_status != 0 or not stable
            return BoundedSourceRead{source: bytes_view(source)}


    public:
        def run(source_path: sview) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, File.Read]:
            input_path: Path = path(source_path)
            if not is_file(input_path):
                eprint("diagnostic snapshot audit: missing runner source")
                return 1i64

            source_size: usize = try file_size(input_path) else err:
                eprint("diagnostic snapshot audit: missing runner source")
                return 1i64

            if source_size > Limits::SOURCE_BYTES:
                eprint("diagnostic snapshot audit: runner source exceeds audit limit")
                return 1i64

            bounded: BoundedSourceRead = read_bounded_source(input_path, Limits::SOURCE_BYTES)
            if bounded.failure:
                eprint("diagnostic snapshot audit: missing runner source")
                return 1i64

            if bounded.exceeded_limit:
                eprint("diagnostic snapshot audit: runner source exceeds audit limit")
                return 1i64

            source: sview = bounded.source

            if len(source) > Limits::SOURCE_BYTES:
                eprint("diagnostic snapshot audit: runner source exceeds audit limit")
                return 1i64

            normalized_source: sview = source.replace("\r\n", "\n")
            if normalized_source.index("\r") >= 0:
                eprint("diagnostic snapshot audit: bare carriage return is unsupported")
                return 1i64

            lines: darray[sview] = split_lines(normalized_source)
            fields: mutable darray[sview] = []
            fingerprint_lines: mutable darray[sview] = []
            equality_lines: mutable darray[sview] = []
            identifier_pattern: Regex = regex"^[a-z_][a-z0-9_]*$"
            phase: mutable Phase = Phase.SeekStruct
            index: mutable usize = 0
            saw_fingerprint: mutable bool = false
            saw_equality: mutable bool = false

            machine over phase while phase != Phase.Done:
                state Scan
                start Scan

                Scan, Phase.SeekStruct if index >= lines.count:
                    phase <- Phase.Done
                    -> Scan

                Scan, Phase.SeekStruct if lines[index] == Syntax::STRUCT_HEADER:
                    phase <- Phase.ReadStruct
                    index <- index + 1
                    -> Scan

                Scan, Phase.SeekStruct:
                    index <- index + 1
                    -> Scan

                Scan, Phase.ReadStruct if index >= lines.count:
                    phase <- Phase.SearchFunctions
                    index <- 0
                    -> Scan

                Scan, Phase.ReadStruct if lines[index] == "":
                    phase <- Phase.SearchFunctions
                    index <- 0
                    -> Scan

                Scan, Phase.ReadStruct if lines[index].startswith(Syntax::FIELD_INDENT):
                    field_line: sview = lines[index]
                    field_match: bool = regex"^            [a-z_][a-z0-9_]*\s*:".match(field_line)
                    if field_match:
                        field_parts: darray[sview] = split(field_line.strip(), ":")
                        field_name: sview = field_parts[0].strip()
                        if identifier_pattern.fullmatch(field_name):
                            fields.push(field_name)
                    index <- index + 1
                    -> Scan

                Scan, Phase.ReadStruct:
                    index <- index + 1
                    -> Scan

                Scan, Phase.SearchFunctions if index >= lines.count:
                    phase <- Phase.Done
                    -> Scan

                Scan, Phase.SearchFunctions if not saw_fingerprint and lines[index].startswith(Syntax::FINGERPRINT_HEADER):
                    saw_fingerprint <- true
                    fingerprint_lines.push(lines[index])
                    phase <- Phase.Fingerprint
                    index <- index + 1
                    -> Scan

                Scan, Phase.SearchFunctions if not saw_equality and lines[index].startswith(Syntax::EQUALITY_HEADER):
                    saw_equality <- true
                    equality_lines.push(lines[index])
                    phase <- Phase.Equality
                    index <- index + 1
                    -> Scan

                Scan, Phase.SearchFunctions:
                    index <- index + 1
                    -> Scan

                Scan, Phase.Fingerprint if index >= lines.count:
                    phase <- Phase.Done
                    -> Scan

                Scan, Phase.Fingerprint if not saw_equality and lines[index].startswith(Syntax::FUNCTION_PREFIX) and lines[index].startswith(Syntax::EQUALITY_HEADER):
                    saw_equality <- true
                    equality_lines.push(lines[index])
                    phase <- Phase.Equality
                    index <- index + 1
                    -> Scan

                Scan, Phase.Fingerprint if lines[index].startswith(Syntax::FUNCTION_PREFIX):
                    phase <- Phase.SearchFunctions
                    index <- index + 1
                    -> Scan

                Scan, Phase.Fingerprint:
                    fingerprint_lines.push(lines[index])
                    index <- index + 1
                    -> Scan

                Scan, Phase.Equality if index >= lines.count:
                    phase <- Phase.Done
                    -> Scan

                Scan, Phase.Equality if lines[index].startswith(Syntax::FUNCTION_PREFIX):
                    phase <- Phase.SearchFunctions
                    index <- index + 1
                    -> Scan

                Scan, Phase.Equality:
                    equality_lines.push(lines[index])
                    index <- index + 1
                    -> Scan

                Scan, Phase.Done:
                    break

            if fields.count == 0:
                eprint("diagnostic snapshot audit: no diagnostic fields found")
                return 1i64

            if fields.count > Limits::FIELDS:
                eprint("diagnostic snapshot audit: diagnostic field count exceeds audit limit")
                return 1i64

            for field_name in fields:
                if len(field_name) > Limits::FIELD_BYTES:
                    eprint("diagnostic snapshot audit: diagnostic field name exceeds audit limit")
                    return 1i64

            if not saw_fingerprint or not saw_equality:
                eprint("diagnostic snapshot audit: missing snapshot operations")
                return 1i64

            fingerprint_body: sview = join(fingerprint_lines, "\n")
            equality_body: sview = join(equality_lines, "\n")
            missing: mutable bool = false
            covered_fields: mutable usize = 0

            for field_name in fields:
                if field_name == "execution":
                    continue

                covered_fields <- covered_fields + 1
                fingerprint_pattern_text: sview = "(^|[^A-Za-z0-9_])diagnostic[.]" + field_name + "([^A-Za-z0-9_]|$)"
                equality_left_pattern_text: sview = "(^|[^A-Za-z0-9_])left[.]" + field_name + "([^A-Za-z0-9_]|$)"
                equality_right_pattern_text: sview = "(^|[^A-Za-z0-9_])right[.]" + field_name + "([^A-Za-z0-9_]|$)"
                fingerprint_pattern: Regex = regex(fingerprint_pattern_text)
                equality_left_pattern: Regex = regex(equality_left_pattern_text)
                equality_right_pattern: Regex = regex(equality_right_pattern_text)

                if not fingerprint_pattern.search(fingerprint_body):
                    eprint(f"diagnostic snapshot audit: fingerprint omits {field_name}")
                    missing <- true

                if not equality_left_pattern.search(equality_body) or not equality_right_pattern.search(equality_body):
                    eprint(f"diagnostic snapshot audit: structural equality omits {field_name}")
                    missing <- true

            if missing:
                return 1i64

            println(f"diagnostic snapshot audit: {covered_fields} fields covered (execution intentionally excluded)")
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, File.Read]:
    if arguments.count > 1:
        eprint("usage: diagnostic snapshot audit [runner-source]")
        return 2i64

    if arguments.count == 1:
        if arguments[0] != "":
            return EsDiagnosticSnapshotAudit::run(arguments[0])
    return EsDiagnosticSnapshotAudit::run_default()
