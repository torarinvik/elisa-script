# Bounded Elisascript port of check_resource_policy.sh.
# Literal counts preserve the original lease-site and host-edge assertions.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsResourcePolicyAudit:
    private:
        const module Inputs:
            RUNTIME_MODEL: sview = "src/ir/runtime_model.elisa"
            INTERPRETER: sview = "src/ir/interpret.elisa"
            BYTECODE: sview = "src/bytecode/bytecode.elisa"
            DIFFERENTIAL: sview = "src/testing/differential.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"
            IR_FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            BYTECODE_FIXTURE: sview = "test/ir/elisascript_bytecode_test.elisa"
            INTERPRETER_FIXTURE: sview = "test/ir/elisascript_interpreter_test.elisa"


        const module Patterns:
            POLICY_STRUCT: sview = "struct RuntimeResourcePolicy"
            USAGE_STRUCT: sview = "struct RuntimeResourceUsage"
            COUNTER_ENUM: sview = "const enum RuntimeResourceCounter of u8"
            POLICY_VALID: sview = "runtime_resource_policy_valid"
            USAGE_WITHIN_POLICY: sview = "runtime_resource_usage_within_policy"
            POLICY_STEP_LIMIT: sview = "runtime_resource_policy_with_step_limit"
            REMAINING_POLICY: sview = "runtime_resource_remaining_policy"
            UNACCOUNTED_DIMENSIONS: sview = "runtime_resource_policy_has_unaccounted_dimensions"
            RESOURCE_ACQUIRE: sview = "runtime_resource_acquire"
            RESOURCE_RELEASE: sview = "runtime_resource_release"
            ADD_STEPS: sview = "runtime_resource_add_steps"
            ADD_ELAPSED: sview = "runtime_resource_add_elapsed"
            ADD_MEMORY: sview = "runtime_resource_add_memory"
            ADD_OUTPUT: sview = "runtime_resource_add_output"
            ADD_REGEX_WORK: sview = "runtime_resource_add_regex_work"
            ADD_RETAINED_TRACES: sview = "runtime_resource_add_retained_traces"
            STEPS: sview = "steps"
            ELAPSED_MICROS: sview = "elapsed_micros"
            MEMORY_BYTES: sview = "memory_bytes"
            OPEN_HANDLES: sview = "open_handles"
            PROCESSES: sview = "processes"
            OUTPUT_BYTES: sview = "output_bytes"
            RESOURCE_REGEX_WORK: sview = "regex_work"
            RETAINED_TRACES: sview = "retained_traces"
            CONCURRENT_TASKS: sview = "concurrent_tasks"
            POLICY_FIELD: sview = "policy: RuntimeResourcePolicy"
            USAGE_FIELD: sview = "usage: RuntimeResourceUsage"
            INTERPRETER_POLICY: sview = "resource_policy: RuntimeResourcePolicy"
            INTERPRETER_USAGE: sview = "resource_usage: mutable RuntimeResourceUsage"
            POLICY_STEP_CALL: sview = "runtime_resource_policy_with_step_limit"
            POLICY_UNACCOUNTED_CALL: sview = "runtime_resource_policy_has_unaccounted_dimensions(policy)"
            INTERPRET_POLICY: sview = "def interpret_with_resource_policy"
            MACHINE_POLICY: sview = "policy: machine.resource_policy"
            MACHINE_USAGE: sview = "usage: machine.resource_usage"
            RETAINED_TRACE_UPDATE: sview = "retained_traces <- observations.count"
            INTERPRETER_USAGE_CHECK: sview = "runtime_resource_usage_within_policy"
            INTERPRETER_ADD_STEPS: sview = "runtime_resource_add_steps(machine.resource_usage, machine.resource_policy, 1)"
            WRITER_OUTPUT: sview = "runtime_resource_add_output(machine.resource_usage, machine.resource_policy, writer.offset)"
            HOST_OUTPUT: sview = "runtime_resource_add_output(machine.resource_usage, machine.resource_policy, host_size)"
            PROCESS_ACQUIRE: sview = "def process_resource_acquire("
            PROCESS_COMPLETE: sview = "def process_resource_complete("
            WAITER_REAPED: sview = "waiter.reaped <- true"
            PROCESS_ACQUIRE_SITE: sview = "if not process_resource_acquire(machine)"
            PROCESS_COMPLETE_SITE: sview = "if not process_resource_complete(machine, waiter)"
            OPEN_FILE: sview = "def interpret_open_file("
            OPEN_TMPFILE: sview = "def interpret_open_tmpfile("
            CLOSE_FILE: sview = "def interpret_close_file("
            OPEN_DIRECTORY: sview = "def interpret_open_directory("
            CLOSE_DIRECTORY: sview = "def interpret_close_directory("
            OPEN_HANDLE_COUNTER: sview = "RuntimeResourceCounter.OpenHandle"
            RAW_FOPEN: sview = "fopen("
            RAW_FCLOSE: sview = "fclose("
            RAW_TMPFILE: sview = "elisascript_posix_tmpfile("
            RAW_OPENDIR: sview = "elisascript_posix_opendir("
            RAW_CLOSEDIR: sview = "elisascript_posix_closedir("
            RAW_MKSTEMP: sview = "elisascript_posix_mkstemp("
            RAW_CLOSE: sview = "elisascript_posix_close("
            READ_OWNED_DIRECTORY: sview = "read_owned_directory(machine: mutable Machine&"
            REGEX_ACCOUNT: sview = "def regex_work_account("
            ADD_REGEX_DELTA: sview = "runtime_resource_add_regex_work(machine.resource_usage, machine.resource_policy, delta)"
            REGEX_WORK_LIMIT: sview = "regex_work_budget_limit(machine)"
            REGEX_LIMITS: sview = "const module RegexLimits:"
            REGEX_PATTERN_BYTES: sview = "RegexLimits::PATTERN_BYTES"
            REGEX_TEXT_BYTES: sview = "RegexLimits::TEXT_BYTES"
            REGEX_OUTPUT_BYTES: sview = "RegexLimits::OUTPUT_BYTES"
            REGEX_GROUP_DEPTH: sview = "RegexLimits::GROUP_DEPTH"
            REGEX_REPEAT_DEPTH: sview = "RegexLimits::REPEAT_DEPTH"
            REGEX_WORK_BOUND: sview = "RegexLimits::WORK"
            DEFAULT_REGEX_WORK: sview = "WORK: u64 = ES_RUNTIME_DEFAULT_MAX_REGEX_WORK"
            STDIO_CONSUMED: sview = "consumed: mutable u64 = 0"
            STDIO_REMAINING: sview = "remaining: u64 = reader.limit - current"
            STDIO_CAPACITY: sview = "capacity <- remaining.usize()"
            STDIN_READ: sview = "elisascript_posix_read(0, (&chunk[0]).cast[mutable void&], capacity)"
            STDIO_ADD_COUNT: sview = "reader.consumed <- reader.consumed + count.u64()"
            STDIO_APPEND_FITS: sview = "if not stdio_read_append_fits(reader, 1)"
            STDIO_ADD_ONE: sview = "reader.consumed <- reader.consumed + 1"
            STEP_CEILING: sview = "step_limit > EsIr::ES_RUNTIME_DEFAULT_MAX_STEPS"
            POLICY_HANDLE_CEILING: sview = "policy.open_handles > ES_RUNTIME_DEFAULT_MAX_OPEN_HANDLES"
            POLICY_STEP_CEILING: sview = "policy.steps > ES_RUNTIME_DEFAULT_MAX_STEPS"
            POLICY_PROCESS_CEILING: sview = "policy.processes > ES_RUNTIME_DEFAULT_MAX_PROCESSES"
            POLICY_TASK_CEILING: sview = "policy.concurrent_tasks > ES_RUNTIME_DEFAULT_MAX_CONCURRENT_TASKS"
            HANDLES_OVER: sview = "handles_over"
            STEPS_OVER: sview = "steps_over"
            PROCESSES_OVER: sview = "processes_over"
            TASKS_OVER: sview = "tasks_over"
            COUNTER_OPEN_HANDLE: sview = "RuntimeResourceCounter.OpenHandle"
            COUNTER_PROCESS: sview = "RuntimeResourceCounter.Process"
            COUNTER_CONCURRENT_TASK: sview = "RuntimeResourceCounter.ConcurrentTask"
            FIXTURE_ADD_STEPS: sview = "runtime_resource_add_steps"
            FIXTURE_ADD_MEMORY: sview = "runtime_resource_add_memory"
            FIXTURE_ADD_OUTPUT: sview = "runtime_resource_add_output"
            FIXTURE_ADD_REGEX: sview = "runtime_resource_add_regex_work"
            FIXTURE_ADD_TRACES: sview = "runtime_resource_add_retained_traces"
            PARTIAL_USAGE: sview = "partial_usage: RuntimeResourceUsage"
            REMAINING_PARTIAL: sview = "runtime_resource_remaining_policy(partial_usage, policy)"
            EXHAUSTED_REMAINING: sview = "exhausted_remaining: RuntimeResourcePolicy"
            UNATTACHED_USAGE: sview = "unattached_usage: RuntimeResourceUsage"
            TINY_POLICY: sview = "tiny_policy: RuntimeResourcePolicy"
            TINY_USAGE: sview = "tiny_usage: mutable RuntimeResourceUsage"
            ACQUIRE_TINY: sview = "not runtime_resource_acquire(tiny_usage"
            RELEASE_TINY: sview = "not runtime_resource_release(tiny_usage"
            HANDLE_LIMITED: sview = "handle_limited: RuntimeResourcePolicy"
            ZERO_POLICY: sview = "zero_resource_policy: RuntimeResourcePolicy"
            ACQUIRE_ZERO: sview = "not runtime_resource_acquire(zero_resource_usage"
            BYTECODE_STEP_CEILING: sview = "bytecode_compatibility_entrypoints_reject_step_budget_above_shared_ceiling"
            BYTECODE_UNACCOUNTED: sview = "bytecode_strict_direct_entrypoint_rejects_unaccounted_resource_dimensions"
            BYTECODE_ZERO_BUDGET: sview = "bytecode_process_zero_budget_routes_to_accounted_interpreter"
            REFERENCE_OUTPUT_USAGE: sview = "reference.usage.output_bytes == 3"
            MATCHED_OUTPUT_USAGE: sview = "compiled.usage.output_bytes == reference.usage.output_bytes"
            EXECUTE_WITH_POLICY: sview = "def execute_bytecode_with_resource_policy"
            EXECUTE_DIRECT_WITH_POLICY: sview = "def execute_bytecode_direct_only_with_resource_policy"
            POLICY_REQUIRES_REFERENCE: sview = "def bytecode_policy_requires_reference"
            PROCESSES_DEFAULT_POLICY: sview = "policy.processes != ES_RUNTIME_DEFAULT_MAX_PROCESSES"
            UNSUPPORTED_DIMENSIONS: sview = "def bytecode_policy_has_unsupported_dimensions"
            BYTECODE_UNACCOUNTED_CALL: sview = "runtime_resource_policy_has_unaccounted_dimensions(policy)"
            REQUIRE_REFERENCE_CALL: sview = "bytecode_policy_requires_reference(policy)"
            UNSUPPORTED_CALL: sview = "bytecode_policy_has_unsupported_dimensions(policy)"
            BYTECODE_RETAINED_TRACES: sview = "retained_traces <- observations.count"
            BYTECODE_USAGE_CHECK: sview = "runtime_resource_usage_within_policy"
            OBSERVATION_LIMIT: sview = "observation_limit: usize"
            OBSERVATION_LIMIT_CHECK: sview = "observations.count >= observation_limit"
            GLOBAL_LIMIT: sview = "module.globals.count > ES_RUNTIME_DEFAULT_MAX_STORAGE_VALUES"
            DIRECT_GLOBAL_VALUES: sview = "bytecode_direct_global_values(module: BytecodeModule&"
            SCALAR_GLOBAL_FIXTURE: sview = "bytecode_scalar_globals_execute_direct_with_shared_state"
            STORAGE_SPAN_VALID: sview = "runtime_storage_span_u32_valid(storage, binding.aggregate_values.count)"
            FLAT_GLOBAL_FIXTURE: sview = "bytecode_flat_literal_collection_globals_execute_direct"
            INTEGER_GLOBAL_FIXTURE: sview = "bytecode_direct_i16_u16_i32_u32_match_reference"
            OUTPUT_BASE: sview = "output_base: usize = 0"
            OUTPUT_BYTES_REF: sview = "output_bytes: mutable usize&"
            DIRECT_WITH_LEDGER: sview = "def execute_bytecode_direct_with_ledger"
            OUTPUT_LEDGER: sview = "output_ledger: mutable usize&"
            NESTED_DIRECT_LEDGER: sview = "nested: Execution = try execute_bytecode_direct_with_ledger"
            STEPS_REF: sview = "steps: mutable u64&"
            OBSERVATION_AND_OUTPUT: sview = "observation_limit, output_bytes)"
            COPY_OUTPUT_BYTES: sview = "output_bytes <- nested.usage.output_bytes"
            RETURN_OUTPUT_LEDGER: sview = "output_bytes: output_ledger"
            NESTED_RECOVERY_FIXTURE: sview = "bytecode_direct_nested_recovered_calls_share_step_budget"
            DIRECT_VERIFY_FIXTURE: sview = "bytecode_direct_only_verifies_then_rejects_fallback"
            RESUME_FRAME: sview = "resume_frame: bool = false"
            MULTISHOT_FIXTURE: sview = "interpreter_replays_post_perform_frame_for_each_multi_shot_resume"
            ERROR_GUARDS: sview = "continuation_error_guards: mutable darray[ErrorGuard]"
            ERROR_GUARD_START: sview = "error_guard_snapshot_start: usize"
            ERROR_GUARD_COUNT: sview = "error_guard_snapshot_count: usize"
            RECOVER_ERROR_GUARD: sview = "def recover_error_guard("
            RESTORE_GUARDS_FIXTURE: sview = "interpreter_restores_error_guards_in_replayed_perform_frames"
            PROPAGATE_GUARD_FIXTURE: sview = "interpreter_propagates_replayed_error_to_suspended_caller_guard"
            MATCHING_GUARD_INDEX: sview = "def matching_error_guard_index"
            OUTER_TYPED_CATCH_FIXTURE: sview = "interpreter_searches_outer_typed_catch_after_inner_mismatch"
            CURSOR_OUTPUT: sview = "cursor.output_bytes <- output_ledger"
            LEDGER_OUTPUT: sview = "output_ledger <- cursor.output_bytes"
            NESTED_PROCESS_OUTPUT_FIXTURE: sview = "bytecode_direct_nested_process_output_is_accounted_once"
            RECOVERED_OUTPUT_EQUAL: sview = "recovered_direct.usage.output_bytes == recovered_reference.usage.output_bytes"
            POLICY_RETAINED_TRACES: sview = "policy.retained_traces"
            OBSERVATION_CEILING: sview = "observation_limit > ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS"
            USAGE_COPY: sview = "usage: usage"
            DIFF_POLICY_KNOWN: sview = "resource_policy_known: mutable bool"
            DIFF_POLICY: sview = "resource_policy: mutable EsIr::RuntimeResourcePolicy"
            DIFF_USAGE: sview = "resource_usage: mutable EsIr::RuntimeResourceUsage"
            COPY_DIFF_POLICY: sview = "result.resource_policy <- execution.policy"
            COPY_DIFF_USAGE: sview = "result.resource_usage <- execution.usage"
            DOCS_PER_RUN: sview = "per-run"
            DOCS_POLICY: sview = "RuntimeResourcePolicy"
            LEDGER_RUNTIME: sview = "ES-RUNTIME-001"


        const module Messages:
            MISSING_ROOT: sview = "resource policy audit: missing repository root"
            UNRESOLVED_ROOT: sview = "resource policy audit: unable to resolve repository root"
            MISSING_INPUT: sview = "resource policy audit: missing "
            READ_FAILED: sview = "resource policy audit: unable to read source: "
            FOUR_FORK_SITES: sview = "resource policy audit: expected four accounted interpreter fork paths, found "
            FOUR_REAP_SITES: sview = "resource policy audit: expected four child-reap accounting paths, found "
            ONE_HOST_EDGE: sview = "resource policy audit: expected one leased host edge "
            COUNT_SUFFIX: sview = ", found "
            SUCCESS: sview = "resource policy audit: shared policy, usage snapshot, and backend metadata are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        const module CountLimits:
            FOUR: usize = 4
            ONE: usize = 1


        struct SearchCheck:
            input: Path
            pattern: sview


        struct RawEdgeCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


        def model_contracts(input: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: input, pattern: Patterns::POLICY_STRUCT},
                SearchCheck{input: input, pattern: Patterns::USAGE_STRUCT},
                SearchCheck{input: input, pattern: Patterns::COUNTER_ENUM},
                SearchCheck{input: input, pattern: Patterns::POLICY_VALID},
                SearchCheck{input: input, pattern: Patterns::USAGE_WITHIN_POLICY},
                SearchCheck{input: input, pattern: Patterns::POLICY_STEP_LIMIT},
                SearchCheck{input: input, pattern: Patterns::REMAINING_POLICY},
                SearchCheck{input: input, pattern: Patterns::UNACCOUNTED_DIMENSIONS},
                SearchCheck{input: input, pattern: Patterns::RESOURCE_ACQUIRE},
                SearchCheck{input: input, pattern: Patterns::RESOURCE_RELEASE},
                SearchCheck{input: input, pattern: Patterns::ADD_STEPS},
                SearchCheck{input: input, pattern: Patterns::ADD_ELAPSED},
                SearchCheck{input: input, pattern: Patterns::ADD_MEMORY},
                SearchCheck{input: input, pattern: Patterns::ADD_OUTPUT},
                SearchCheck{input: input, pattern: Patterns::ADD_REGEX_WORK},
                SearchCheck{input: input, pattern: Patterns::ADD_RETAINED_TRACES},
                SearchCheck{input: input, pattern: Patterns::STEPS},
                SearchCheck{input: input, pattern: Patterns::ELAPSED_MICROS},
                SearchCheck{input: input, pattern: Patterns::MEMORY_BYTES},
                SearchCheck{input: input, pattern: Patterns::OPEN_HANDLES},
                SearchCheck{input: input, pattern: Patterns::PROCESSES},
                SearchCheck{input: input, pattern: Patterns::OUTPUT_BYTES},
                SearchCheck{input: input, pattern: Patterns::RESOURCE_REGEX_WORK},
                SearchCheck{input: input, pattern: Patterns::RETAINED_TRACES},
                SearchCheck{input: input, pattern: Patterns::CONCURRENT_TASKS},
                SearchCheck{input: input, pattern: Patterns::POLICY_FIELD},
                SearchCheck{input: input, pattern: Patterns::USAGE_FIELD}
            ]


        def interpreter_contracts(input: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: input, pattern: Patterns::INTERPRETER_POLICY},
                SearchCheck{input: input, pattern: Patterns::INTERPRETER_USAGE},
                SearchCheck{input: input, pattern: Patterns::POLICY_STEP_CALL},
                SearchCheck{input: input, pattern: Patterns::POLICY_UNACCOUNTED_CALL},
                SearchCheck{input: input, pattern: Patterns::INTERPRET_POLICY},
                SearchCheck{input: input, pattern: Patterns::MACHINE_POLICY},
                SearchCheck{input: input, pattern: Patterns::MACHINE_USAGE},
                SearchCheck{input: input, pattern: Patterns::RETAINED_TRACE_UPDATE},
                SearchCheck{input: input, pattern: Patterns::INTERPRETER_USAGE_CHECK},
                SearchCheck{input: input, pattern: Patterns::INTERPRETER_ADD_STEPS},
                SearchCheck{input: input, pattern: Patterns::WRITER_OUTPUT},
                SearchCheck{input: input, pattern: Patterns::HOST_OUTPUT},
                SearchCheck{input: input, pattern: Patterns::PROCESS_ACQUIRE},
                SearchCheck{input: input, pattern: Patterns::PROCESS_COMPLETE},
                SearchCheck{input: input, pattern: Patterns::WAITER_REAPED}
            ]


        def count_contract(input: Path, pattern: sview, expected: usize, count_occurrences: bool, message: sview, include_pattern: bool) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            count: usize = try EsSourceFunctionScope::count_file_literal(input, pattern, count_occurrences) else err:
                diagnostic(Messages::READ_FAILED + f"{input}")
                return ExitStatus::IO_FAILURE
            if count != expected:
                if include_pattern:
                    diagnostic(message + f"{pattern}" + Messages::COUNT_SUFFIX + f"{count}")
                else:
                    diagnostic(message + f"{count}")
                return ExitStatus::FAILURE
            return 0i64


        def raw_edges(input: Path) -> darray[RawEdgeCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                RawEdgeCheck{input: input, pattern: Patterns::RAW_FOPEN},
                RawEdgeCheck{input: input, pattern: Patterns::RAW_FCLOSE},
                RawEdgeCheck{input: input, pattern: Patterns::RAW_TMPFILE},
                RawEdgeCheck{input: input, pattern: Patterns::RAW_OPENDIR},
                RawEdgeCheck{input: input, pattern: Patterns::RAW_CLOSEDIR},
                RawEdgeCheck{input: input, pattern: Patterns::RAW_MKSTEMP},
                RawEdgeCheck{input: input, pattern: Patterns::RAW_CLOSE}
            ]


        def audit_counts(interpreter: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = count_contract(interpreter, Patterns::PROCESS_ACQUIRE_SITE, CountLimits::FOUR, false, Messages::FOUR_FORK_SITES, false)
            return status if status != 0i64
            status <- count_contract(interpreter, Patterns::PROCESS_COMPLETE_SITE, CountLimits::FOUR, false, Messages::FOUR_REAP_SITES, false)
            return status if status != 0i64
            edges: darray[RawEdgeCheck] = raw_edges(interpreter)
            for edge in edges:
                status <- count_contract(edge.input, edge.pattern, CountLimits::ONE, true, Messages::ONE_HOST_EDGE, true)
                return status if status != 0i64
            return 0i64


        def interpreter_rest(input: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: input, pattern: Patterns::OPEN_FILE},
                SearchCheck{input: input, pattern: Patterns::OPEN_TMPFILE},
                SearchCheck{input: input, pattern: Patterns::CLOSE_FILE},
                SearchCheck{input: input, pattern: Patterns::OPEN_DIRECTORY},
                SearchCheck{input: input, pattern: Patterns::CLOSE_DIRECTORY},
                SearchCheck{input: input, pattern: Patterns::OPEN_HANDLE_COUNTER},
                SearchCheck{input: input, pattern: Patterns::READ_OWNED_DIRECTORY},
                SearchCheck{input: input, pattern: Patterns::REGEX_ACCOUNT},
                SearchCheck{input: input, pattern: Patterns::ADD_REGEX_DELTA},
                SearchCheck{input: input, pattern: Patterns::REGEX_WORK_LIMIT},
                SearchCheck{input: input, pattern: Patterns::REGEX_LIMITS},
                SearchCheck{input: input, pattern: Patterns::REGEX_PATTERN_BYTES},
                SearchCheck{input: input, pattern: Patterns::REGEX_TEXT_BYTES},
                SearchCheck{input: input, pattern: Patterns::REGEX_OUTPUT_BYTES},
                SearchCheck{input: input, pattern: Patterns::REGEX_GROUP_DEPTH},
                SearchCheck{input: input, pattern: Patterns::REGEX_REPEAT_DEPTH},
                SearchCheck{input: input, pattern: Patterns::REGEX_WORK_BOUND},
                SearchCheck{input: input, pattern: Patterns::DEFAULT_REGEX_WORK},
                SearchCheck{input: input, pattern: Patterns::STDIO_CONSUMED},
                SearchCheck{input: input, pattern: Patterns::STDIO_REMAINING},
                SearchCheck{input: input, pattern: Patterns::STDIO_CAPACITY},
                SearchCheck{input: input, pattern: Patterns::STDIN_READ},
                SearchCheck{input: input, pattern: Patterns::STDIO_ADD_COUNT},
                SearchCheck{input: input, pattern: Patterns::STDIO_APPEND_FITS},
                SearchCheck{input: input, pattern: Patterns::STDIO_ADD_ONE}
            ]


        def policy_ceiling_contracts(input: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: input, pattern: Patterns::POLICY_HANDLE_CEILING},
                SearchCheck{input: input, pattern: Patterns::POLICY_STEP_CEILING},
                SearchCheck{input: input, pattern: Patterns::POLICY_PROCESS_CEILING},
                SearchCheck{input: input, pattern: Patterns::POLICY_TASK_CEILING}
            ]


        def ir_fixture_contracts(input: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: input, pattern: Patterns::HANDLES_OVER},
                SearchCheck{input: input, pattern: Patterns::STEPS_OVER},
                SearchCheck{input: input, pattern: Patterns::PROCESSES_OVER},
                SearchCheck{input: input, pattern: Patterns::TASKS_OVER},
                SearchCheck{input: input, pattern: Patterns::COUNTER_OPEN_HANDLE},
                SearchCheck{input: input, pattern: Patterns::COUNTER_PROCESS},
                SearchCheck{input: input, pattern: Patterns::COUNTER_CONCURRENT_TASK},
                SearchCheck{input: input, pattern: Patterns::FIXTURE_ADD_STEPS},
                SearchCheck{input: input, pattern: Patterns::FIXTURE_ADD_MEMORY},
                SearchCheck{input: input, pattern: Patterns::FIXTURE_ADD_OUTPUT},
                SearchCheck{input: input, pattern: Patterns::FIXTURE_ADD_REGEX},
                SearchCheck{input: input, pattern: Patterns::FIXTURE_ADD_TRACES},
                SearchCheck{input: input, pattern: Patterns::PARTIAL_USAGE},
                SearchCheck{input: input, pattern: Patterns::REMAINING_PARTIAL},
                SearchCheck{input: input, pattern: Patterns::EXHAUSTED_REMAINING},
                SearchCheck{input: input, pattern: Patterns::UNATTACHED_USAGE},
                SearchCheck{input: input, pattern: Patterns::TINY_POLICY},
                SearchCheck{input: input, pattern: Patterns::TINY_USAGE},
                SearchCheck{input: input, pattern: Patterns::ACQUIRE_TINY},
                SearchCheck{input: input, pattern: Patterns::RELEASE_TINY},
                SearchCheck{input: input, pattern: Patterns::HANDLE_LIMITED},
                SearchCheck{input: input, pattern: Patterns::ZERO_POLICY},
                SearchCheck{input: input, pattern: Patterns::ACQUIRE_ZERO}
            ]


        def bytecode_fixture_contracts(input: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: input, pattern: Patterns::BYTECODE_STEP_CEILING},
                SearchCheck{input: input, pattern: Patterns::BYTECODE_UNACCOUNTED},
                SearchCheck{input: input, pattern: Patterns::BYTECODE_ZERO_BUDGET},
                SearchCheck{input: input, pattern: Patterns::REFERENCE_OUTPUT_USAGE},
                SearchCheck{input: input, pattern: Patterns::MATCHED_OUTPUT_USAGE}
            ]


        def bytecode_contracts(input: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: input, pattern: Patterns::EXECUTE_WITH_POLICY},
                SearchCheck{input: input, pattern: Patterns::EXECUTE_DIRECT_WITH_POLICY},
                SearchCheck{input: input, pattern: Patterns::POLICY_REQUIRES_REFERENCE},
                SearchCheck{input: input, pattern: Patterns::PROCESSES_DEFAULT_POLICY},
                SearchCheck{input: input, pattern: Patterns::UNSUPPORTED_DIMENSIONS},
                SearchCheck{input: input, pattern: Patterns::BYTECODE_UNACCOUNTED_CALL},
                SearchCheck{input: input, pattern: Patterns::REQUIRE_REFERENCE_CALL},
                SearchCheck{input: input, pattern: Patterns::UNSUPPORTED_CALL},
                SearchCheck{input: input, pattern: Patterns::BYTECODE_RETAINED_TRACES},
                SearchCheck{input: input, pattern: Patterns::BYTECODE_USAGE_CHECK},
                SearchCheck{input: input, pattern: Patterns::OBSERVATION_LIMIT},
                SearchCheck{input: input, pattern: Patterns::OBSERVATION_LIMIT_CHECK},
                SearchCheck{input: input, pattern: Patterns::DIRECT_GLOBAL_VALUES},
                SearchCheck{input: input, pattern: Patterns::STORAGE_SPAN_VALID},
                SearchCheck{input: input, pattern: Patterns::OUTPUT_BASE},
                SearchCheck{input: input, pattern: Patterns::OUTPUT_BYTES_REF},
                SearchCheck{input: input, pattern: Patterns::DIRECT_WITH_LEDGER},
                SearchCheck{input: input, pattern: Patterns::OUTPUT_LEDGER},
                SearchCheck{input: input, pattern: Patterns::NESTED_DIRECT_LEDGER},
                SearchCheck{input: input, pattern: Patterns::STEPS_REF},
                SearchCheck{input: input, pattern: Patterns::OBSERVATION_AND_OUTPUT},
                SearchCheck{input: input, pattern: Patterns::COPY_OUTPUT_BYTES},
                SearchCheck{input: input, pattern: Patterns::RETURN_OUTPUT_LEDGER},
                SearchCheck{input: input, pattern: Patterns::CURSOR_OUTPUT},
                SearchCheck{input: input, pattern: Patterns::LEDGER_OUTPUT},
                SearchCheck{input: input, pattern: Patterns::POLICY_RETAINED_TRACES},
                SearchCheck{input: input, pattern: Patterns::OBSERVATION_CEILING},
                SearchCheck{input: input, pattern: Patterns::USAGE_COPY}
            ]


        def interpreter_fixture_contracts(input: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: input, pattern: Patterns::MULTISHOT_FIXTURE},
                SearchCheck{input: input, pattern: Patterns::RESTORE_GUARDS_FIXTURE},
                SearchCheck{input: input, pattern: Patterns::PROPAGATE_GUARD_FIXTURE},
                SearchCheck{input: input, pattern: Patterns::OUTER_TYPED_CATCH_FIXTURE}
            ]


        def interpreter_guard_contracts(input: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: input, pattern: Patterns::RESUME_FRAME},
                SearchCheck{input: input, pattern: Patterns::ERROR_GUARDS},
                SearchCheck{input: input, pattern: Patterns::ERROR_GUARD_START},
                SearchCheck{input: input, pattern: Patterns::ERROR_GUARD_COUNT},
                SearchCheck{input: input, pattern: Patterns::RECOVER_ERROR_GUARD},
                SearchCheck{input: input, pattern: Patterns::MATCHING_GUARD_INDEX}
            ]


        def differential_contracts(input: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: input, pattern: Patterns::DIFF_POLICY_KNOWN},
                SearchCheck{input: input, pattern: Patterns::DIFF_POLICY},
                SearchCheck{input: input, pattern: Patterns::DIFF_USAGE},
                SearchCheck{input: input, pattern: Patterns::COPY_DIFF_POLICY},
                SearchCheck{input: input, pattern: Patterns::COPY_DIFF_USAGE}
            ]


        def execute_all(inputs: darray[Path]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = execute(model_contracts(inputs[0]))
            return status if status != 0i64
            status <- execute(interpreter_contracts(inputs[1]))
            return status if status != 0i64
            status <- audit_counts(inputs[1])
            return status if status != 0i64
            status <- execute(interpreter_rest(inputs[1]))
            return status if status != 0i64
            status <- execute([
                SearchCheck{input: inputs[2], pattern: Patterns::STEP_CEILING}
            ])
            return status if status != 0i64
            status <- execute(policy_ceiling_contracts(inputs[0]))
            return status if status != 0i64
            status <- execute(ir_fixture_contracts(inputs[6]))
            return status if status != 0i64
            status <- execute(bytecode_fixture_contracts(inputs[7]))
            return status if status != 0i64
            status <- execute([
                SearchCheck{input: inputs[2], pattern: Patterns::POLICY_STEP_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::REMAINING_POLICY},
                SearchCheck{input: inputs[1], pattern: Patterns::GLOBAL_LIMIT},
                SearchCheck{input: inputs[2], pattern: Patterns::GLOBAL_LIMIT}
            ])
            return status if status != 0i64
            status <- execute(bytecode_contracts(inputs[2]))
            return status if status != 0i64
            status <- execute([
                SearchCheck{input: inputs[7], pattern: Patterns::SCALAR_GLOBAL_FIXTURE},
                SearchCheck{input: inputs[7], pattern: Patterns::FLAT_GLOBAL_FIXTURE},
                SearchCheck{input: inputs[7], pattern: Patterns::INTEGER_GLOBAL_FIXTURE},
                SearchCheck{input: inputs[7], pattern: Patterns::NESTED_RECOVERY_FIXTURE},
                SearchCheck{input: inputs[7], pattern: Patterns::DIRECT_VERIFY_FIXTURE},
                SearchCheck{input: inputs[7], pattern: Patterns::NESTED_PROCESS_OUTPUT_FIXTURE},
                SearchCheck{input: inputs[7], pattern: Patterns::RECOVERED_OUTPUT_EQUAL}
            ])
            return status if status != 0i64
            status <- execute(interpreter_guard_contracts(inputs[1]))
            return status if status != 0i64
            status <- execute(interpreter_fixture_contracts(inputs[8]))
            return status if status != 0i64
            status <- execute(differential_contracts(inputs[3]))
            return status if status != 0i64
            status <- execute([
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_PER_RUN},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_POLICY},
                SearchCheck{input: inputs[5], pattern: Patterns::LEDGER_RUNTIME}
            ])
            return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::RUNTIME_MODEL),
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::BYTECODE),
                root.joinpath(Inputs::DIFFERENTIAL),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER),
                root.joinpath(Inputs::IR_FIXTURE),
                root.joinpath(Inputs::BYTECODE_FIXTURE),
                root.joinpath(Inputs::INTERPRETER_FIXTURE)
            ]
            required_inputs: darray[Path] = [inputs[0], inputs[1], inputs[2], inputs[3], inputs[4], inputs[5]]
            for input_path in required_inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE
            status: i64 = execute_all(inputs)
            return status if status != 0i64
            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsResourcePolicyAudit::run_default()
