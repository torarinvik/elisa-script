# Bounded Elisascript port slice for build-graph and target-usage invariants.
# The broader shell audit remains the reference until this port is complete.

include "../src/runtime/bounded_text_posix.elisa"

using EsBoundedText


module EsBuildGraphIndexAudit:
    private:
        const module Limits:
            SOURCE_BYTES: usize = 2097152


        struct SourceRead:
            text: sview = ""
            failed: bool = false


        def write_diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def read_source(root: sview, relative_path: sview) -> SourceRead can[Memory.Allocate, Abort.Panic, Console.Format, Console.Write, File.Read, Blocking.IO, Unsafe.PointerCast]:
            display_path: sview = root + "/" + relative_path
            if not is_file(path(display_path)):
                write_diagnostic(f"build graph index audit: missing source: {relative_path}")
                return SourceRead{failed: true}
            source_size: usize = try file_size(path(display_path)) else err:
                write_diagnostic(f"build graph index audit: unable to inspect source: {relative_path}")
                return SourceRead{failed: true}
            if source_size > Limits::SOURCE_BYTES:
                write_diagnostic(f"build graph index audit: source exceeds byte limit: {relative_path}")
                return SourceRead{failed: true}
            contents: mutable sview = ""
            catch EsBoundedText::read_utf8(path(display_path), Limits::SOURCE_BYTES):
                ok value:
                    contents <- value
                error failure:
                    _ = failure
                    write_diagnostic(f"build graph index audit: unable to read stable UTF-8 source: {relative_path}")
                    return SourceRead{failed: true}
            return SourceRead{text: contents}


        def require_text(source: sview, expected: sview, source_name: sview) -> bool can[Memory.Allocate, Abort.Panic, Console.Format, Console.Write]:
            return true if source.index(expected) >= 0
            write_diagnostic(f"build graph index audit: missing invariant in {source_name}: {expected}")
            return false


        def require_in_order(source: sview, first: sview, second: sview, source_name: sview) -> bool can[Memory.Allocate, Abort.Panic, Console.Format, Console.Write]:
            first_position: i64 = source.index(first)
            second_position: i64 = source.index(second)
            return true if first_position >= 0 and second_position > first_position
            write_diagnostic(f"build graph index audit: invariant order is wrong in {source_name}")
            return false


        def require_patterns(source: sview, patterns: darray[sview], source_name: sview) -> bool can[Memory.Allocate, Abort.Panic, Console.Format, Console.Write]:
            all_present: mutable bool = true
            for expected in patterns |all_present|:
                all_present <- require_text(source, expected, source_name) and all_present
            return all_present


        def reject_text(source: sview, forbidden: sview, source_name: sview) -> bool can[Memory.Allocate, Abort.Panic, Console.Format, Console.Write]:
            return true if source.index(forbidden) < 0
            write_diagnostic(f"build graph index audit: forbidden pattern in {source_name}: {forbidden}")
            return false


        def count_text(source: sview, needle: sview) -> usize:
            return 0u64 if needle == ""
            count: mutable usize = 0
            cursor: mutable usize = 0
            while cursor < len(source):
                remaining: sview = source[cursor:len(source)]
                found: i64 = remaining.index(needle)
                if found < 0:
                    break
                count <- count + 1
                cursor <- cursor + found.usize() + len(needle)
            return count


        def require_count(source: sview, needle: sview, expected: usize, source_name: sview) -> bool can[Memory.Allocate, Abort.Panic, Console.Format, Console.Write]:
            actual: usize = count_text(source, needle)
            return true if actual == expected
            write_diagnostic(f"build graph index audit: wrong occurrence count in {source_name}: expected {expected}, found {actual}")
            return false


    public:
        def run(repository_root: sview) -> i64 can[Memory.Allocate, Abort.Panic, Console.Format, Console.Write, File.Read, Blocking.IO, Unsafe.PointerCast]:
            root_text: mutable sview = repository_root
            while root_text.endswith("/") and len(root_text) > 1:
                root_text <- root_text[0:len(root_text) - 1]
            if root_text == "" or len(root_text) >= 3072 or sview_contains_byte(root_text, 0) or not path_is_absolute(path(root_text)):
                write_diagnostic("build graph index audit: repository root must be a bounded absolute path")
                return 2i64

            model: SourceRead = read_source(root_text, "src/runtime/build_model.elisa")
            return 2i64 if model.failed
            usage_graph: SourceRead = read_source(root_text, "src/runtime/build_usage_graph_model.elisa")
            return 2i64 if usage_graph.failed
            fixture: SourceRead = read_source(root_text, "test/runtime/build_usage_graph_model_test.elisa")
            return 2i64 if fixture.failed
            shell_audit: SourceRead = read_source(root_text, "scripts/check_build_model.sh")
            return 2i64 if shell_audit.failed
            ir: SourceRead = read_source(root_text, "src/ir/ir.elisa")
            return 2i64 if ir.failed
            graph_fixture: SourceRead = read_source(root_text, "test/ir/elisascript_ir_test.elisa")
            return 2i64 if graph_fixture.failed
            scheduler: SourceRead = read_source(root_text, "src/runtime/build_scheduler_model.elisa")
            return 2i64 if scheduler.failed
            usage_model: SourceRead = read_source(root_text, "src/runtime/build_usage_model.elisa")
            return 2i64 if usage_model.failed
            usage_fixture: SourceRead = read_source(root_text, "test/runtime/build_usage_model_test.elisa")
            return 2i64 if usage_fixture.failed
            usage_argv_model: SourceRead = read_source(root_text, "src/runtime/build_usage_argv_model.elisa")
            return 2i64 if usage_argv_model.failed
            usage_argv_fixture: SourceRead = read_source(root_text, "test/runtime/build_usage_argv_model_test.elisa")
            return 2i64 if usage_argv_fixture.failed
            target_usage_candidate: SourceRead = read_source(root_text, "test/fixtures/script_parity/target_usage/build.elisascript")
            return 2i64 if target_usage_candidate.failed
            target_usage_parity: SourceRead = read_source(root_text, "test/script_parity/target_usage_launcher_test.elisascript")
            return 2i64 if target_usage_parity.failed
            executor_model: SourceRead = read_source(root_text, "src/runtime/build_executor_model.elisa")
            return 2i64 if executor_model.failed
            executor_fixture: SourceRead = read_source(root_text, "test/runtime/build_executor_test.elisa")
            return 2i64 if executor_fixture.failed
            incremental_executor_fixture: SourceRead = read_source(root_text, "test/runtime/build_incremental_executor_test.elisa")
            return 2i64 if incremental_executor_fixture.failed
            incremental_posix: SourceRead = read_source(root_text, "src/runtime/build_incremental_posix.elisa")
            return 2i64 if incremental_posix.failed
            incremental_posix_executor: SourceRead = read_source(root_text, "src/runtime/build_incremental_posix_executor.elisa")
            return 2i64 if incremental_posix_executor.failed
            sequential_reference: SourceRead = read_source(root_text, "test/fixtures/script_parity/sequential_tools/reference.sh")
            return 2i64 if sequential_reference.failed
            sequential_candidate: SourceRead = read_source(root_text, "test/fixtures/script_parity/sequential_tools/candidate.elisascript")
            return 2i64 if sequential_candidate.failed
            sequential_expected: SourceRead = read_source(root_text, "test/fixtures/script_parity/sequential_tools/expected.txt")
            return 2i64 if sequential_expected.failed
            sequential_contract: SourceRead = read_source(root_text, "test/fixtures/script_parity/sequential_tools/CONTRACT.md")
            return 2i64 if sequential_contract.failed
            sequential_parity: SourceRead = read_source(root_text, "test/script_parity/sequential_tools_launcher_test.elisascript")
            return 2i64 if sequential_parity.failed
            minimal_cmake: SourceRead = read_source(root_text, "test/fixtures/script_parity/minimal_native_build/CMakeLists.txt")
            return 2i64 if minimal_cmake.failed
            minimal_main: SourceRead = read_source(root_text, "test/fixtures/script_parity/minimal_native_build/src/main.c")
            return 2i64 if minimal_main.failed
            minimal_main_variant: SourceRead = read_source(root_text, "test/fixtures/script_parity/minimal_native_build/src/main_variant.c")
            return 2i64 if minimal_main_variant.failed
            minimal_candidate: SourceRead = read_source(root_text, "test/fixtures/script_parity/minimal_native_build/build.elisascript")
            return 2i64 if minimal_candidate.failed
            minimal_parity: SourceRead = read_source(root_text, "test/script_parity/minimal_native_build_launcher_test.elisascript")
            return 2i64 if minimal_parity.failed
            minimal_template: SourceRead = read_source(root_text, "test/fixtures/script_parity/minimal_native_build/include/generated_build_config.h.in")
            return 2i64 if minimal_template.failed
            minimal_variant_template: SourceRead = read_source(root_text, "test/fixtures/script_parity/minimal_native_build/include/generated_build_config_variant.h.in")
            return 2i64 if minimal_variant_template.failed
            ir_docs: SourceRead = read_source(root_text, "docs/ir.md")
            return 2i64 if ir_docs.failed
            compilation_database: SourceRead = read_source(root_text, "src/runtime/build_compilation_database_model.elisa")
            return 2i64 if compilation_database.failed
            compilation_database_fixture: SourceRead = read_source(root_text, "test/runtime/build_compilation_database_model_test.elisa")
            return 2i64 if compilation_database_fixture.failed

            model_source: sview = model.text
            usage_graph_source: sview = usage_graph.text
            fixture_source: sview = fixture.text
            shell_source: sview = shell_audit.text
            ir_source: sview = ir.text
            graph_fixture_source: sview = graph_fixture.text
            scheduler_source: sview = scheduler.text
            usage_model_source: sview = usage_model.text
            usage_fixture_source: sview = usage_fixture.text
            usage_argv_source: sview = usage_argv_model.text
            usage_argv_fixture_source: sview = usage_argv_fixture.text
            target_usage_source: sview = target_usage_candidate.text
            target_usage_parity_source: sview = target_usage_parity.text
            executor_source: sview = executor_model.text
            executor_fixture_source: sview = executor_fixture.text
            incremental_executor_fixture_source: sview = incremental_executor_fixture.text
            incremental_posix_source: sview = incremental_posix.text
            incremental_posix_executor_source: sview = incremental_posix_executor.text
            sequential_reference_source: sview = sequential_reference.text
            sequential_candidate_source: sview = sequential_candidate.text
            sequential_expected_source: sview = sequential_expected.text
            sequential_contract_source: sview = sequential_contract.text
            sequential_parity_source: sview = sequential_parity.text
            minimal_cmake_source: sview = minimal_cmake.text
            minimal_main_source: sview = minimal_main.text
            minimal_main_variant_source: sview = minimal_main_variant.text
            minimal_candidate_source: sview = minimal_candidate.text
            minimal_parity_source: sview = minimal_parity.text
            minimal_template_source: sview = minimal_template.text
            minimal_variant_template_source: sview = minimal_variant_template.text
            ir_docs_source: sview = ir_docs.text
            compilation_database_source: sview = compilation_database.text
            compilation_database_fixture_source: sview = compilation_database_fixture.text

            model_declarations: darray[sview] = [
                "module EsBuild:", "const module Limits:", "Limits::NODES", "Limits::DEPENDENCIES",
                "Limits::TOTAL_DEPENDENCIES", "Limits::NAME_BYTES", "Limits::UNINDEXED_NAME_SCAN_NODES",
                "Limits::LOG_BYTES", "const enum BuildNodeState of u8:", "const enum BuildGraphState of u8:",
                "BuildGraphState.Failing", "const enum BuildGraphEvent of u8:", "struct BuildNode:",
                "struct BuildDependencyNames:", "struct BuildNodeNameIndex:", "struct BuildDependencyResolution:",
                "struct BuildGraph:", "error BuildContractError:", "def validate_build_graph(",
                "def resolve_build_dependencies(", "def advance_build_graph("
            ]
            model_boundaries: darray[sview] = [
                "DependencyOrderInvalid", "DependencyListOrderInvalid", "DependencyShapeInvalid",
                "NodeNameIndexInvalid", "NodeNameOrderInvalid", "NodeNameIndexRequired",
                "TOTAL_DEPENDENCIES - total_dependencies", "sview_len(name) < Limits::NAME_BYTES",
                "DuplicateDependency", "MissingDependency", "InvalidParallelism", "DependencyNotReady",
                "BuildGraphEvent.CacheHit", "FingerprintMissing", "LogLimitExceeded",
                "total_log_bytes > Limits::LOG_BYTES", "node.log_bytes > Limits::LOG_BYTES - total_log_bytes",
                "planned_nodes", "graph.failed_nodes == 0 or graph.active_nodes == 0 or planned_nodes != 0",
                "failure_in_progress", "ack_failure", "cancelled_nodes",
                "graph.failed_nodes != 0 or cancelled_nodes != 0 or graph.completed_nodes >= graph.nodes.count",
                "graph.active_nodes != 0 or graph.completed_nodes != graph.nodes.count or graph.failed_nodes != 0 or cancelled_nodes == 0",
                "graph.failed_nodes != 0 or cancelled_nodes == 0", "or cancelled_nodes != 0", "CancelNotReady",
                "terminal_nodes", "graph.state == BuildGraphState.Succeeded", "graph.completed_nodes != graph.nodes.count",
                "graph.active_nodes != 0", "graph.nodes[index].state == BuildNodeState.Running",
                "graph.active_nodes <- graph.active_nodes - 1", "validate_process_command"
            ]
            model_ok: bool = require_patterns(model_source, model_declarations, "build_model.elisa")
            model_ok <- require_patterns(model_source, model_boundaries, "build_model.elisa") and model_ok
            model_ok <- require_in_order(model_source, "graph.nodes.count > Limits::UNINDEXED_NAME_SCAN_NODES", "if graph.node_name_order.count == 0:", "build_model.elisa") and model_ok
            model_ok <- require_patterns(ir_source, [
                "include \"../runtime/build_model.elisa\"", "include \"../runtime/build_usage_model.elisa\"",
                "include \"../runtime/build_usage_argv_model.elisa\"", "include \"../runtime/build_executor_model.elisa\"",
                "include \"../runtime/build_usage_graph_model.elisa\""
            ], "ir.elisa") and model_ok
            model_ok <- require_patterns(graph_fixture_source, [
                "typed_build_dependency_resolution_maps_names_to_canonical_indices",
                "build_graph_requires_canonical_name_index_above_legacy_scan_limit",
                "BuildContractError.NodeNameIndexRequired", "typed_build_graph_contract_is_ordered_bounded_and_cancelable",
                "BuildGraphEvent.NodeStart", "BuildGraphEvent.NodeFailure", "BuildGraphState.Failing",
                "BuildGraphEvent.CancelAck", "forged_cancelling_failure", "forged_cancelling_complete",
                "forged_cancelling_cancelled", "forged_cancelled_success", "forged_all_success_cancelled_state",
                "graph_success_during_drain", "cancel_after_failure", "BuildContractError.DependencyOrderInvalid",
                "BuildContractError.DependencyListOrderInvalid", "BuildContractError.DependencyShapeInvalid",
                "BuildContractError.NodeNameOrderInvalid", "BuildContractError.NodeNameIndexInvalid"
            ], "elisascript_ir_test.elisa") and model_ok
            model_ok <- require_text(scheduler_source, "scheduler.graph.node_name_order.count == scheduler.graph.nodes.count", "build_scheduler_model.elisa") and model_ok
            model_ok <- require_patterns(model_source, [
                "graph.nodes[node_index].name != entry.name",
                "graph.node_name_order.count != 0 and graph.node_name_order.count != graph.nodes.count",
                "graph.node_name_order.count == 0 and graph.nodes.count > Limits::UNINDEXED_NAME_SCAN_NODES",
                "helper_paths: darray[sview] = []",
                "build_sort_name_indices(node_names, order, scratch)",
                "build_sort_node_indices(node_dependencies, dependency_scratch)"
            ], "build_model.elisa") and model_ok

            usage_declarations: darray[sview] = [
                "module EsBuildUsage:", "const module Limits:", "TOTAL_INPUTS", "TOTAL_RESOLVED_ENTRIES",
                "TOTAL_VALUE_BYTES", "INDEX_WORK_BYTES", "INDEX_PROBE_STEPS", "INDEX_SLOTS", "INDEX_PROBES",
                "const enum BuildUsageTargetKind of u8:", "SharedLibrary", "const enum BuildUsageKind of u8:",
                "const enum BuildUsageVisibility of u8:", "const enum BuildUsageLibraryForm of u8:",
                "struct BuildUsageRequirement:", "library_form: BuildUsageLibraryForm", "struct BuildUsageDependency:",
                "struct BuildUsageTarget:", "struct BuildUsageTargetResult:", "target_artifact: bool = false",
                "error BuildUsageError:", "def validate_target_inputs(", "def resolve_build_usage("
            ]
            usage_boundaries: darray[sview] = [
                "InterfaceVisibilityRequired", "DependencyOrderInvalid", "InvalidDependencyTargetKind",
                "InvalidLibraryForm", "DuplicateDependency", "TotalValueLimitExceeded", "IndexWorkLimitExceeded",
                "IndexProbeWorkLimitExceeded", "IndexProbeLimitExceeded", "IndexCapacityExceeded",
                "BuildUsageTargetKind.StaticLibrary", "BuildUsageVisibility.Public", "BuildUsageVisibility.Interface",
                "dependency.target_index", "dependency.visibility != BuildUsageVisibility.Private",
                "target.kind == BuildUsageTargetKind.StaticLibrary", "link_only: true", "dependency_result.exported_compile",
                "dependency_result.exported_link", "dependency_target.kind == BuildUsageTargetKind.StaticLibrary",
                "dependency_target.kind == BuildUsageTargetKind.SharedLibrary", "value: dependency_result.name",
                "target_artifact: true", "library_form_matches_requirement", "if requirement.library_form == BuildUsageLibraryForm.Path:",
                "not sview_contains_byte(requirement.value, 32)", "candidate.library_form.u8().usize() * 2",
                "candidate.target_artifact else 0", "struct BuildUsageIndexSlot:",
                "def usage_index_hash(signature: u8, value: sview)", "def usage_index_count_probe(probe_steps: mutable usize&)",
                "index_probe_steps: mutable usize = 0",
                "for target_index in 0..<targets.count |targets, results, resolved_count, index_work_bytes, index_probe_steps|",
                "for dependency in target.dependencies |target, results, result, indices, resolved_count, index_work_bytes, index_probe_steps|",
                "for entry in dependency_result.exported_compile |indices, result, resolved_count, index_work_bytes, index_probe_steps|",
                "usage_index_probe(indices.slots, signature, candidate.value, hash, work_bytes, probe_steps)",
                "try usage_index_count_probe(probe_steps)", "try usage_index_ensure_capacity(indices, indices.count + 1, probe_steps)",
                "target_artifact: entry.target_artifact", "Limits::INDEX_PROBES", "Limits::INDEX_PROBE_STEPS",
                "Limits::INDEX_WORK_BYTES - work_bytes", "current.value == value",
                "entries[existing.entry_index].link_only <- false if not candidate.link_only",
                "raise BuildUsageError.TotalResolvedLimitExceeded if entries.count >= Limits::TOTAL_RESOLVED_ENTRIES",
                "raise BuildUsageError.TotalValueLimitExceeded if value_bytes > Limits::TOTAL_VALUE_BYTES - total_value_bytes",
                "TOTAL_INPUTS - total_inputs", "ordered_dependencies: darray[usize] = sorted(dependency_indices)",
                "ordered_target_names: darray[sview] = sorted(target_names)",
                "for index in 0..<targets.count |targets, total_inputs, total_value_bytes, target_names|",
                "for dependency_index in 0..<target.dependencies.count |target, dependency_indices|",
                "ordered_dependencies[ordered_index - 1] == ordered_dependencies[ordered_index]",
                "ordered_target_names[name_index - 1] == ordered_target_names[name_index]"
            ]
            usage_ok: bool = require_patterns(usage_model_source, usage_declarations, "build_usage_model.elisa")
            usage_ok <- require_patterns(usage_model_source, usage_boundaries, "build_usage_model.elisa") and usage_ok
            usage_ok <- require_patterns(usage_fixture_source, [
                "build_usage_public_private_interface_and_static_link_only_propagation",
                "build_usage_shared_dependency_contributes_its_artifact",
                "build_usage_distinguishes_target_artifacts_from_linker_names",
                "build_usage_rejects_mismatched_library_forms",
                "build_usage_index_preserves_order_and_deduplicates_high_cardinality_entries",
                "build_usage_index_rejects_collision_chains_over_probe_budget",
                "build_usage_index_rejects_excessive_aggregate_fanout_probe_work",
                "BuildUsageError.IndexProbeWorkLimitExceeded", "option_as_search_name", "whitespace_as_search_name",
                "bare_path_resolution", "build_usage_rejects_noncanonical_dependencies_and_interface_visibility",
                "build_usage_private_static_dependency_is_local_and_link_only_exported",
                "static_usage.exported_link[0].library_form == BuildUsageLibraryForm.LinkerArgument",
                "consumer_usage.link[0].value == \"static\" and consumer_usage.link[0].target_artifact",
                "consumer_usage.link[1].library_form == BuildUsageLibraryForm.LinkerArgument",
                "build_usage_interface_dependency_must_use_interface_visibility", "API_LEVEL=3",
                "core_usage.compile.count == 5", "include/internal", "app_usage.link[2].value == \"-Wl,--as-needed\"",
                "app_usage.link[0].value == \"core\"",
                "app_usage.link[3].value == \"helper\" and not app_usage.link[3].link_only",
                "wrapper_usage.exported_link[0].value == \"shared\"", "assert not app_usage.link[0].target_artifact",
                "assert app_usage.link[1].target_artifact", "value == \"/opt/fixture/lib/libcustom.a\"",
                "value == \"deps/lib/librelative.a\"", "value == \"-dash/libspecial.a\"", "value == \"-lcustom\"",
                "library_form == BuildUsageLibraryForm.Path", "library_form == BuildUsageLibraryForm.LinkerArgument",
                "BuildUsageError.InvalidDependencyTargetKind"
            ], "build_usage_model_test.elisa") and usage_ok

            usage_ok <- require_patterns(usage_graph_source, [
                "module EsBuildUsageGraph:", "struct BuildUsageActionSpec:", "struct BuildUsageGraphPlan:",
                "def build_usage_graph_plan(", "def validate_build_usage_graph_plan(", "def execute_build_usage_graph(",
                "BuildUsageGraphError.UnsupportedCommand", "BuildUsageGraphError.PlanOwnershipInvalid",
                "raise BuildContractError.FingerprintMissing if action.fingerprint == 0",
                "raise BuildContractError.FingerprintMissing if node.fingerprint == 0",
                "def build_usage_graph_dependencies_preflight(", "try build_usage_graph_dependencies_preflight(actions)",
                "build_usage_graph_account_command_text", "measured_metadata_bytes != plan.metadata_bytes",
                "validate_build_usage_process_command(action.command)",
                "validate_build_execution_output_sets(plan.graph, plan.output_sets)",
                "execute_build_graph_serial_with_outputs(plan.graph, plan.output_sets)"
            ], "build_usage_graph_model.elisa") and usage_ok
            usage_ok <- require_patterns(fixture_source, [
                "build_usage_actions_become_owned_ordered_output_checked_graph",
                "build_usage_graph_plans_large_graph_with_canonical_name_index", "expected_metadata_bytes",
                "build_usage_graph_rejects_unordered_dependencies_before_execution",
                "build_usage_graph_rejects_missing_fingerprint_during_action_preflight",
                "build_usage_graph_rejects_relative_declared_outputs", "build_usage_graph_rejects_forged_metadata_total"
            ], "build_usage_graph_model_test.elisa") and usage_ok

            usage_ok <- require_text(usage_graph_source, "def build_usage_graph_dependency_resolution(", "build_usage_graph_model.elisa") and usage_ok
            usage_ok <- require_text(usage_graph_source, "node_names.push(graph.nodes[action_index].name)", "build_usage_graph_model.elisa") and usage_ok
            usage_ok <- require_text(usage_graph_source, "names.push(graph.nodes[dependency_index].name)", "build_usage_graph_model.elisa") and usage_ok
            usage_ok <- require_text(usage_graph_source, "attach_build_dependency_resolution(plan.graph, resolution)", "build_usage_graph_model.elisa") and usage_ok
            usage_ok <- require_in_order(usage_graph_source, "build_usage_graph_dependency_resolution(plan.graph, actions)", "attach_build_dependency_resolution(plan.graph, resolution)", "build_usage_graph_model.elisa") and usage_ok
            usage_ok <- require_in_order(usage_graph_source, "attach_build_dependency_resolution(plan.graph, resolution)", "validate_build_graph(plan.graph)", "build_usage_graph_model.elisa") and usage_ok

            argv_declarations: darray[sview] = [
                "module EsBuildUsageArgv:", "struct BuildUsageArgSyntax:", "struct BuildUsageTargetArtifact:",
                "struct BuildUsageArgv:", "struct BuildUsageProcessCommand:", "error BuildUsageArgvError:",
                "def build_usage_raw_argv(", "def build_usage_compile_argv(", "def build_usage_link_argv(",
                "def build_usage_process_command("
            ]
            argv_boundaries: darray[sview] = [
                "owned_arguments: darray[darray[u8]]", "BuildUsageArgvError.ArgumentLimitExceeded",
                "BuildUsageArgvError.ArgumentBytesExceeded", "BuildUsageArgvError.InvalidCompileEntry",
                "BuildUsageArgvError.InvalidLinkEntry", "BuildUsageArgvError.InvalidArtifactMap",
                "BuildUsageArgvError.MissingTargetArtifact", "BuildUsageArgvError.InheritedEnvironmentUnsupported",
                "BuildUsageArgvError.InvalidOwnedArgv", "build_usage_argv_append_joined",
                "entry.target_artifact and (entry.kind != BuildUsageKind.LinkLibrary or entry.library_form != BuildUsageLibraryForm.SearchName)",
                "path_is_absolute(path(current.path))"
            ]
            argv_ok: bool = require_patterns(usage_argv_source, argv_declarations, "build_usage_argv_model.elisa")
            argv_ok <- require_patterns(usage_argv_source, argv_boundaries, "build_usage_argv_model.elisa") and argv_ok
            argv_ok <- require_patterns(usage_argv_fixture_source, [
                "build_usage_raw_argv_preserves_literal_tool_arguments",
                "build_usage_compile_entries_materialize_as_owned_argv",
                "build_usage_link_entries_resolve_artifacts_without_shell_parsing",
                "build_usage_link_entries_reject_unmapped_target_artifacts",
                "build_usage_argv_builds_owned_executor_compatible_process_command",
                "build_usage_process_command_rejects_ambient_environment"
            ], "build_usage_argv_model_test.elisa") and argv_ok
            argv_ok <- require_patterns(target_usage_source, [
                "build_usage_compile_argv(", "build_usage_link_argv(", "build_usage_raw_argv(",
                "build_usage_process_command(", "ProcessEnvironmentMode.Replace",
                "build_usage_graph_plan(actions)", "execute_build_usage_graph(plan)"
            ], "target_usage/build.elisascript") and argv_ok
            argv_ok <- reject_text(target_usage_source,
                "BuildUsageRequirement{kind: BuildUsageKind.LinkLibrary, visibility: BuildUsageVisibility.Private, value: \"core\"}",
                "target_usage/build.elisascript") and argv_ok
            argv_ok <- reject_text(target_usage_source,
                "BuildUsageRequirement{kind: BuildUsageKind.LinkLibrary, visibility: BuildUsageVisibility.Private, value: \"helper\"}",
                "target_usage/build.elisascript") and argv_ok
            argv_ok <- reject_text(target_usage_source, "execute_build_graph_serial_with_outputs(", "target_usage/build.elisascript") and argv_ok
            argv_ok <- require_patterns(target_usage_source, [
                "build_compilation_database_model.elisa", "using EsBuildCompilationDatabase",
                "BuildCompilationSource{action_index: 0", "BuildCompilationSource{action_index: 2",
                "BuildCompilationSource{action_index: 4", "render_build_compilation_database(plan, compilation_sources)",
                "build_directory.joinpath(\"compile_commands.json\")", "write_bytes(compilation_database_path, compilation_database)",
                "written_compilation_database != compilation_database.count", "File.Write"
            ], "target_usage/build.elisascript") and argv_ok

            executor_declarations: darray[sview] = [
                "module EsBuildExecutor:", "const enum BuildExecutionFailureKind of u8:",
                "BuildExecutionFailureKind.Invocation", "BuildExecutionFailureKind.NonzeroExit",
                "struct BuildExecutionNodeResult:", "struct BuildExecutionResult:", "error BuildExecutionError:",
                "OutputAlreadyPresent", "def build_executor_command_supported_impl(",
                "def execute_build_command(", "def execute_build_graph_serial("
            ]
            executor_boundaries: darray[sview] = [
                "ProcessEnvironmentMode.Inherit", "ProcessEnvironmentMode.Replace", "ProcessEnvironmentMode.Clear",
                "ENV_EXECUTABLE: sview = \"/usr/bin/env\"", "arguments <- [\"-i\"]", "absolute path",
                "ProcessStdioMode.Null", "ProcessStdioMode.Capture", "command.timeout_micros == 0",
                "Preflight every command that will execute before the first", "def execute_build_graph_incremental(",
                "def commit_build_incremental_execution(", "ExecutionNotSuccessful", "ExecutionResultMismatch",
                "build_executor_incremental_execution_result_matches(", "BuildGraphEvent.CacheHit",
                "BuildGraphEvent.NodeFailure", "LOG_BYTES - graph.log_bytes",
                "while offset < command.environment.count |command, environment, offset|", "offset <- offset + 2",
                "for argument in command.arguments |arguments|", "build_executor_first_present_output(output_set)"
            ]
            executor_ok: bool = require_patterns(executor_source, executor_declarations, "build_executor_model.elisa")
            executor_ok <- require_patterns(executor_source, executor_boundaries, "build_executor_model.elisa") and executor_ok
            executor_ok <- require_patterns(executor_fixture_source, [
                "build_executor_preflights_supported_process_command_subset",
                "build_executor_dispatches_exact_child_environment_modes", "replacement-only", "replaced_path_result",
                "inherited_overlay: ProcessCommand", "elisascript-build-inherit-probe",
                "process_stdout(cleared_result) == \"\"", "using EsBuild",
                "build_executor_rejects_late_unsupported_command_before_any_launch",
                "executable: \"/usr/bin/touch\"", "environment_mode: ProcessEnvironmentMode.Replace",
                "environment: [\"LC_ALL\", \"C\", \"TZ\", \"UTC\"]",
                "failure == BuildExecutionError.UnsupportedCommand", "marker_absent: bool = not is_file(marker)",
                "graph.state == BuildGraphState.Planned", "build_executor_rejects_preexisting_declared_output_before_launch",
                "failure == BuildExecutionError.OutputAlreadyPresent", "stale_bytes_preserved",
                "build_executor_nonzero_exit_cancels_dependent_launches", "executable: \"/usr/bin/false\"",
                "BuildExecutionFailureKind.NonzeroExit", "BuildNodeState.Cancelled", "arguments: [\"prepared\\n\"]",
                "execution.nodes.count == 3 and execution.log_bytes == len(\"prepared\\n\")",
                "execution.nodes[0].stdout == \"prepared\\n\"", "not execution.nodes[2].started",
                "graph.nodes[2].state == BuildNodeState.Cancelled and marker_absent",
                "graph.state == BuildGraphState.Failed"
            ], "build_executor_test.elisa") and executor_ok
            executor_ok <- require_patterns(incremental_executor_fixture_source, [
                "exact_environment_shims_require_explicit_toolchain_paths",
                "execute_build_graph_incremental(", "incremental_executor_marks_up_to_date_nodes_as_cache_hits",
                "commit_build_incremental_execution(result, graph, previous, recipes, observations)",
                "BuildExecutionError.ExecutionNotSuccessful"
            ], "build_incremental_executor_test.elisa") and executor_ok
            executor_ok <- require_patterns(incremental_posix_source, [
                "MissingEnvironmentShim"
            ], "build_incremental_posix.elisa") and executor_ok
            executor_ok <- require_patterns(incremental_posix_executor_source, [
                "resolution.helper_paths[0] != \"usr/bin/env\"", "observe_build_recipe_toolchain_set_at",
                "observe_build_recipe_toolchain_identity_at(scratch, root_fd, helper_path)"
            ], "build_incremental_posix_executor.elisa") and executor_ok

            executor_ok <- require_patterns(sequential_parity_source, [
                "sequential_tools_public_launcher_matches_shell_and_golden", "ELISASCRIPT_BOUNDED_TEST_RSS_GUARD",
                "return false if candidate_run.exit_status != 0 or candidate_run.stdout != golden"
            ], "sequential_tools_launcher_test.elisascript") and executor_ok
            executor_ok <- require_patterns(sequential_candidate_source, [
                "BuildExecutionFailureKind.NonzeroExit",
                "execution.nodes[2].started or graph.nodes[2].state != BuildNodeState.Cancelled"
            ], "sequential_tools/candidate.elisascript") and executor_ok
            executor_ok <- require_patterns(sequential_reference_source, [
                "failure_stdout=\"$(/usr/bin/false)\""
            ], "sequential_tools/reference.sh") and executor_ok
            executor_ok <- require_patterns(sequential_expected_source, ["graph=failed", "prepared"], "sequential_tools/expected.txt") and executor_ok
            executor_ok <- require_text(sequential_contract_source, "A07", "sequential_tools/CONTRACT.md") and executor_ok

            cmake_ok: bool = require_patterns(minimal_cmake_source, [
                "configure_file(", "MINIMAL_BUILD_CONFIG_INPUT", "include/generated_build_config.h.in",
                "generated_build_config.h", "MINIMAL_INCLUDE_OBSOLETE_TARGET",
                "OUTPUT \"${OBSOLETE_CONFIG_OUTPUT}\"", "OUTPUT \"${OBSOLETE_CONFIG_SECONDARY_OUTPUT}\"",
                "add_custom_target(obsolete-config-copy DEPENDS \"${OBSOLETE_CONFIG_OUTPUT}\")",
                "add_custom_target(obsolete-config-copy-secondary DEPENDS \"${OBSOLETE_CONFIG_SECONDARY_OUTPUT}\")",
                "add_library(minimal-answer STATIC src/answer.c)",
                "target_link_libraries(minimal-native PRIVATE minimal-answer)",
                "target_compile_definitions(minimal-native PRIVATE MINIMAL_MAIN_VARIANT=${MINIMAL_MAIN_VARIANT})",
                "MINIMAL_MAIN_SOURCE"
            ], "minimal_native_build/CMakeLists.txt")
            cmake_ok <- require_patterns(minimal_main_source, ["#include \"generated_build_config.h\"", "MINIMAL_MAIN_ADJUSTMENT"], "minimal_native_build/src/main.c") and cmake_ok
            cmake_ok <- require_patterns(minimal_main_variant_source, ["MINIMAL_MAIN_ADJUSTMENT 21 - 21"], "minimal_native_build/src/main_variant.c") and cmake_ok
            cmake_ok <- require_patterns(minimal_template_source, ["#define MINIMAL_BUILD_ANSWER 42"], "generated_build_config.h.in") and cmake_ok
            cmake_ok <- require_patterns(minimal_variant_template_source, ["#define MINIMAL_BUILD_ANSWER 42"], "generated_build_config_variant.h.in") and cmake_ok
            cmake_ok <- require_patterns(minimal_candidate_source, [
                "main_variant.c", "MINIMAL_MAIN_VARIANT=1", "flag-variant", "source-variant", "source_override",
                "header_input_override", "header-variant", "COPY: sview = \"/usr/bin/cp\"",
                "PARTIAL_FAIL: sview = \"/usr/bin/awk\"", "partial-header-created",
                "NO_WRITE: sview = \"/usr/bin/true\"", "TOUCH: sview = \"/usr/bin/touch\"",
                "main_compiler_executable <- Toolchain::NO_WRITE", "main_object_seed_relative",
                "main_compiler_executable <- Toolchain::COPY", "generator_executable: mutable sview = Toolchain::COPY",
                "generator_arguments: mutable darray[sview] = [generated_header_input_text, generated_header_output_text]",
                "generator_executable <- Toolchain::PARTIAL_FAIL", "main_compiler_executable: mutable sview = Toolchain::C_COMPILER",
                "main_compiler_arguments <- [\"-v\", \"output=\" + main_object_text, \"BEGIN { print \\\"partial-object-created\\\"; print \\\"partial\\\" > output; close(output); exit 1 }\"]",
                "executable: generator_executable", "arguments: generator_arguments", "\"-I\", build_directory_text",
                "executable: Toolchain::ARCHIVER", "arguments: [\"rcs\", static_library_text, answer_object_text]",
                "BuildNode{name: \"generate-config-header\", command: generate_header_command, dependencies: [], fingerprint: 1u64}",
                "BuildNode{name: \"compile-answer\", command: compile_answer_command, dependencies: [], fingerprint: 2u64}",
                "BuildNode{name: \"archive-answer\", command: archive_command, dependencies: [1], fingerprint: 3u64}",
                "BuildNode{name: \"compile-main\", command: compile_main_command, dependencies: [0], fingerprint: 4u64}",
                "BuildNode{name: Toolchain::TARGET_NAME, command: link_command, dependencies: [2, 3], fingerprint: 5u64}",
                "BuildIncrementalRecipeTarget{name: \"compile-main\"", "dependencies: [\"generate-config-header\"]",
                "execute_build_graph_incremental_cached_at(arena, lock,",
                "Toolchain::CACHE_LOCK, Toolchain::CACHE_NAME, Toolchain::CACHE_STAGING",
                "expected_node_count: usize = 7 if include_obsolete_target else 5", "include_obsolete_target",
                "obsolete-config-copy", "obsolete-config-copy-secondary", "OBSOLETE_SECONDARY_HEADER_FILENAME",
                "outputs: [obsolete_header_output_relative]", "outputs: [obsolete_secondary_header_output_relative]",
                "every_build_node_was_cached(execution)", "generated_build_config_variant.h.in"
            ], "minimal_native_build/build.elisascript") and cmake_ok
            cmake_ok <- require_count(minimal_candidate_source, "environment_mode: ProcessEnvironmentMode.Replace", 6, "minimal_native_build/build.elisascript") and cmake_ok
            cmake_ok <- require_count(minimal_candidate_source, "helper_paths: [\"usr/bin/env\"]", 6, "minimal_native_build/build.elisascript") and cmake_ok
            cmake_ok <- require_patterns(minimal_parity_source, [
                "reference_flag_variant_frontier_matches", "candidate_flag_variant_matches",
                "reference_restored_flag_frontier_matches", "candidate_flag_recovery_matches",
                "reference_source_variant_frontier_matches", "candidate_source_variant_matches",
                "reference_restored_source_frontier_matches", "candidate_source_recovery_matches",
                "source_variant_v1", "source_variant_v2", "answer() + (21 - 21)", "answer() + (22 - 22)",
                "source_variant_v1_written != len(source_variant_v1)", "source_variant_v2_written != len(source_variant_v2)",
                "reference_changed_source_frontier_matches", "candidate_changed_source_matches",
                "reference_changed_source_noop", "candidate_changed_source_noop",
                "changed_source_noop_run.stdout == \"build_cache=up_to_date\\n\"",
                "cmake-build-after-referenced-source-removal", "elisascript-refuses-removed-source-input",
                "source variant must be an existing absolute regular file", "cache_before_missing_source", "source_variant_restored",
                "removed referenced source was not rejected safely by both build routes",
                "cmake-minimal-native-changed-source-content", "reference_changed_source_run.stdout != \"answer=42\\n\"",
                "header_input_v1", "header_input_v2", "reference_header_input_v1_frontier_matches",
                "candidate_header_input_v1_matches", "reference_header_input_v1_run.stdout != \"answer=42\\n\"",
                "reference_header_input_v2_frontier_matches", "candidate_header_input_v2_matches",
                "reference_header_input_v2_run.stdout != \"answer=42\\n\"", "reference_header_recovery_frontier_matches",
                "candidate_header_recovery_matches", "reference_header_input_noop", "candidate_header_input_noop",
                "header_input_noop_run.stdout == \"build_cache=up_to_date\\n\"",
                "header_input_unchanged_written != len(header_input_v2)", "reference_identical_header_input_build",
                "candidate_identical_header_input_matches", "catch sleep_milliseconds(2000u64)",
                "cmake_header_mtime_before_identical", "elisa_header_mtime_before_identical",
                "unchanged configure input rewrote a generated-header timestamp",
                "elisascript-refuses-symlink-header-input", "header input must be an existing absolute regular file",
                "not path_exists(symlink_input_build)", "elisascript-refuses-directory-header-input",
                "directory_input_sentinel_after == directory_input_sentinel_contents", "not path_exists(directory_input_build)"
            ], "minimal_native_build_launcher_test.elisascript") and cmake_ok
            cmake_ok <- require_patterns(minimal_parity_source, [
                "modified_output_rejected", "modified cached output was not preserved", "restored_cache_matches",
                "stale_cleanup_matches", "modified stale output or committed cache was not preserved",
                "unchanged stale output was not removed after target deletion",
                "modified_dirty_output_rejected", "touch_launch_marker",
                "modified dirty output was not refused before launching its command",
                "stale_symlink_rejected", "stale-output symlink or its target was not preserved",
                "stale_symlink_recovery", "stale_directory_rejected",
                "non-regular stale output or cache was not preserved", "stale_directory_recovery",
                "dirty_fifo_refused", "confirm-dirty-fifo-output-preserved",
                "dirty cached-output FIFO was not refused and preserved before command launch",
                "fifo_recovery_matches", "fifo_recovery_cache_hit",
                "no_write_compile_rejected", "declared output missing", "no_write_retry_matches",
                "no_write_retry_noop", "byte_identical_rebuild_matches", "byte_identical_noop",
                "partial_compile_arguments", "compile_failure_matches", "generator_failure_matches",
                "failed generator did not clean only its started output", "generator_recovery_matches",
                "failed graph did not clean started outputs or preserve later unstarted outputs",
                "failed build replaced the prior cache", "recover-after-partial-compile-failure",
                "noop-after-partial-compile-recovery", "preserved_binary_run", "recovered_after_failure"
            ], "minimal_native_build_launcher_test.elisascript") and cmake_ok
            cmake_ok <- require_patterns(minimal_parity_source, [
                "reference_missing_output_frontier_matches", "candidate_missing_output_matches",
                "candidate_recovered_noop_matches", "was not recreated byte-for-byte",
                "cmake-reconfigure-minimal-native-missing-output", "remove_generated_headers",
                "obsolete_target_matches", "MINIMAL_INCLUDE_OBSOLETE_TARGET=ON",
                "cmake-build-obsolete-target", "CMake did not build the optional generated-file target",
                "MINIMAL_INCLUDE_OBSOLETE_TARGET=OFF", "cmake-list-targets-after-removal",
                "cmake_removed_target_run.stdout != \"answer=42\\n\"",
                "CMake target removal left the target in the graph or changed executable behavior",
                "stale_output_rejected", "obsolete_secondary_header",
                "generated_header_matches_template(variant_template, obsolete_header)",
                "generated_header_matches_template(default_header_template, obsolete_secondary_header)",
                "modified stale output or committed cache was not preserved",
                "unchanged stale output was not removed after target deletion"
            ], "minimal_native_build_launcher_test.elisascript") and cmake_ok
            cmake_ok <- require_patterns(ir_docs_source, [
                "`EsBuild` is the shell-replacement boundary",
                "`EsBuildIncrementalPosixExecutor::execute_build_graph_incremental_cached_at`",
                "A host kill or machine crash bypasses in-process cleanup", "OutputAlreadyPresent"
            ], "ir.md") and cmake_ok

            compilation_database_ok: bool = require_patterns(compilation_database_source, [
                "module EsBuildCompilationDatabase:", "struct BuildCompilationSource:",
                "const module Limits:", "ENTRIES: usize = EsBuild::Limits::NODES",
                "OUTPUT_BYTES: usize = 67108864", "DuplicateAction", "ActionOrderInvalid", "InvalidOutputPath",
                "def database_utf8_valid(", "utf8_feed(byte, cursor)",
                "def database_append_json_string(", "\\u00", "def render_build_compilation_database(",
                "validate_build_usage_graph_plan(plan)", "command.executable",
                "entry.output_file", "declared_path == output_path", "PROCESS_COMMAND_MAX_TEXT_BYTES",
                "\\\"arguments\\\":[", "sources[source_index - 1].action_index > source.action_index"
            ], "build_compilation_database_model.elisa")
            compilation_database_ok <- require_in_order(compilation_database_source,
                "database_utf8_valid(entry.source_file)", "path_is_absolute(path(entry.source_file))",
                "build_compilation_database_model.elisa") and compilation_database_ok
            compilation_database_ok <- require_in_order(compilation_database_source,
                "database_utf8_valid(output_path)", "path_is_absolute(path(output_path))",
                "build_compilation_database_model.elisa") and compilation_database_ok
            compilation_database_ok <- require_patterns(compilation_database_fixture_source, [
                "compilation_database_projects_owned_argv_as_stable_json",
                "compilation_database_escapes_control_and_unicode_bytes_without_shell_joining",
                "compilation_database_rejects_duplicate_actions_and_bounds_output",
                "BuildCompilationSource{action_index: 0", "-Iinclude path", "-DVALUE=",
                "café", "DuplicateAction", "ActionOrderInvalid", "OutputLimitExceeded", "InvalidUtf8",
                "parse_json_document(lexed)", "JsonDocumentState.Sealed", "JsonNodeKind.Array",
                "invalid_path_bytes: mutable darray[u8] = [47u8, 119u8, 111u8, 114u8, 107u8, 47u8, 255u8]"
            ], "build_compilation_database_model_test.elisa") and compilation_database_ok
            compilation_database_ok <- require_patterns(target_usage_parity_source, [
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON", "reference_database_path", "candidate_database_path",
                "candidate_database.ends_with(\"]\\n\")", "\"arguments\":[\"/usr/bin/cc\"",
                "helper_translation_unit", "core_translation_unit", "app_translation_unit",
                "elisa_build_text + \"/helper.o\"", "elisa_build_text + \"/core.o\"", "elisa_build_text + \"/app.o\"",
                "compilation database source/output mismatch"
            ], "target_usage_launcher_test.elisascript") and compilation_database_ok
            compilation_database_ok <- require_text(ir_source, "../runtime/build_compilation_database_model.elisa", "ir.elisa") and compilation_database_ok
            compilation_database_ok <- require_patterns(ir_docs_source, [
                "`EsBuildCompilationDatabase`", "`compile_commands.json`", "standard `arguments` array",
                "action indexes must be unique and in graph order", "64 MiB output ceiling"
            ], "ir.md") and compilation_database_ok

            fixture_ok: bool = require_text(fixture_source, "def build_usage_graph_plans_large_graph_with_canonical_name_index()", "build_usage_graph_model_test.elisa")
            fixture_ok <- require_text(fixture_source, "0..<129", "build_usage_graph_model_test.elisa") and fixture_ok
            fixture_ok <- require_text(fixture_source, "plan.graph.node_name_order.count == 129", "build_usage_graph_model_test.elisa") and fixture_ok

            audit_ok: bool = require_text(shell_source, "build_usage_graph_plans_large_graph_with_canonical_name_index", "check_build_model.sh")
            audit_ok <- require_text(shell_source, "attach_build_dependency_resolution(plan.graph, resolution)", "check_build_model.sh") and audit_ok

            return 1i64 if not model_ok or not usage_ok or not argv_ok or not executor_ok or not cmake_ok or not compilation_database_ok or not fixture_ok or not audit_ok
            print("build graph audit: bounded graph, usage, executor, CMake recovery, and compilation-database invariants are present")
            return 0i64


        def run_default() -> i64 can[Memory.Allocate, Abort.Panic, Console.Format, Console.Write, File.Read, Blocking.IO, Unsafe.PointerCast]:
            script_path: Path = Script::source_path()
            absolute_script_path: Path = try path_absolute(script_path) else err:
                write_diagnostic("build graph index audit: unable to resolve script path")
                return 2i64
            script_directory: Path = absolute_script_path.parent()
            repository_root: Path = script_directory.parent()
            return run(f"{repository_root}")


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Format, Console.Write, File.Read, Blocking.IO, Unsafe.PointerCast]:
    if arguments.count > 1:
        _ = write_stderr("usage: check_build_graph_index [repository-root]\n")
        return 2i64
    if arguments.count == 1:
        if arguments[0] == "":
            _ = write_stderr("usage: check_build_graph_index [repository-root]\n")
            return 2i64
        return EsBuildGraphIndexAudit::run(arguments[0])
    return EsBuildGraphIndexAudit::run_default()
