# Bounded Elisascript port of check_record_control.sh.
# Regex source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsRecordControlAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/record_control_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsRecordControl:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/record_control_model\.elisa\""
            STATE: Regex = regex"const enum RecordControlState of u8"
            EVENT: Regex = regex"const enum RecordControlEvent of u8"
            POLICY: Regex = regex"struct RecordControlPolicy:"
            SESSION: Regex = regex"struct RecordControlSession:"
            ERROR: Regex = regex"error RecordControlError:"
            VALIDATE: Regex = regex"def validate_record_control\("
            ADVANCE: Regex = regex"def advance_record_control\("
            FILE_LIMIT: Regex = regex"Limits::FILES"
            RECORD_LIMIT: Regex = regex"Limits::RECORDS"
            NEXT_RECORD: Regex = regex"RecordControlEvent.NextRecord"
            NEXT_FILE: Regex = regex"RecordControlEvent.NextFile"
            EXIT: Regex = regex"RecordControlEvent.Exit"
            RECORD_NOT_OPEN: Regex = regex"RecordControlError.RecordNotOpen"
            RECORD_LIMIT_GUARD: Regex = regex"RecordControlError.RecordLimitExceeded if session.record_count >= session.policy.max_records"
            FILE_NOT_CLOSED: Regex = regex"RecordControlError.FileNotClosed"
            OPEN_FILE_ZERO_FILES: Regex = regex"session.file_open and session.file_count == 0"
            RECORDS_WITHOUT_FILES: Regex = regex"session.record_count != 0 and session.file_count == 0"
            PLANNED: Regex = regex"RecordControlState.Planned"
            RECORD_SKIPPED: Regex = regex"RecordControlState.RecordSkipped"
            NOT_RECORD_SKIPPED: Regex = regex"session.state != RecordControlState.RecordSkipped"
            FILE_SKIPPED: Regex = regex"RecordControlState.FileSkipped"
            WAS_RECORD_OPEN: Regex = regex"was_record_open"
            EXITED: Regex = regex"RecordControlState.Exited"
            RECORD_END_BOUNDARY: Regex = regex"""elif event == RecordControlEvent.RecordEnd:
                raise RecordControlError.InvalidState if session.state != RecordControlState.Running
                raise RecordControlError.RecordNotOpen if not session.record_open
                raise RecordControlError.RecordLimitExceeded if session.record_count >= session.policy.max_records"""
            FIXTURE_IMPORT: Regex = regex"using EsRecordControl"
            FIXTURE_CONTRACT: Regex = regex"typed_record_control_contract_makes_next_and_exit_explicit"
            FIXTURE_NEXT_RECORD: Regex = regex"RecordControlEvent.NextRecord"
            FIXTURE_NEXT_FILE: Regex = regex"RecordControlEvent.NextFile"
            FIXTURE_EXIT: Regex = regex"RecordControlEvent.Exit"
            FIXTURE_FILE_NOT_OPEN: Regex = regex"RecordControlError.FileNotOpen"
            FIXTURE_FORGED_SKIP: Regex = regex"forged_skip"
            FIXTURE_NEXTFILE_COUNT: Regex = regex"nextfile_counts_record"
            FIXTURE_OVERFLOW_END: Regex = regex"overflow_end_rejected"
            DOCS_SESSION: Regex = regex"EsRecordControl::RecordControlSession"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-029"


        const module Messages:
            MISSING_ROOT: sview = "record control audit: missing repository root"
            UNRESOLVED_ROOT: sview = "record control audit: unable to resolve repository root"
            MISSING_INPUT: sview = "record control audit: missing "
            READ_FAILED: sview = "record control audit: unable to read source: "
            SUCCESS: sview = "record control audit: bounded next/nextfile/exit scope transitions are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        const enum SearchMode of u8:
            Line
            FullText


        struct SearchCheck:
            input: Path
            pattern: Regex
            mode: SearchMode = SearchMode.Line


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_line_match(path: Path, pattern: Regex) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_regex_line(path, pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


        def has_full_text_match(path: Path, pattern: Regex) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_regex_text(path, pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


        def has_match(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            match check.mode:
                SearchMode.Line:
                    return has_line_match(check.input, check.pattern)
                SearchMode.FullText:
                    return has_full_text_match(check.input, check.pattern)
                _:
                    return ExitStatus::FAILURE


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::FILE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::NEXT_RECORD},
                SearchCheck{input: inputs[0], pattern: Patterns::NEXT_FILE},
                SearchCheck{input: inputs[0], pattern: Patterns::EXIT},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_NOT_OPEN},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_LIMIT_GUARD},
                SearchCheck{input: inputs[0], pattern: Patterns::FILE_NOT_CLOSED},
                SearchCheck{input: inputs[0], pattern: Patterns::OPEN_FILE_ZERO_FILES},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORDS_WITHOUT_FILES},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_SKIPPED},
                SearchCheck{input: inputs[0], pattern: Patterns::NOT_RECORD_SKIPPED},
                SearchCheck{input: inputs[0], pattern: Patterns::FILE_SKIPPED},
                SearchCheck{input: inputs[0], pattern: Patterns::WAS_RECORD_OPEN},
                SearchCheck{input: inputs[0], pattern: Patterns::EXITED},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_END_BOUNDARY, mode: SearchMode.FullText},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_NEXT_RECORD},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_NEXT_FILE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_EXIT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_FILE_NOT_OPEN},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_FORGED_SKIP},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_NEXTFILE_COUNT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_OVERFLOW_END},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            for check in searches(inputs):
                status: i64 = has_match(check)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsRecordControlAudit::run_default()
