# Bounded Elisascript port of check_copy_path_safety.sh.
# Source checks use the shared scanner without launching rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsCopyPathSafetyAudit:
    private:
        const module Inputs:
            INTERPRETER: sview = "src/ir/interpret.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            COPY_PATH: sview = "def evaluate_copy_path\\("
            IDENTICAL_PATHS: sview = "if source\\.text == destination\\.text:"
            REJECT_BEFORE_OPEN: sview = "if source\\.text == destination\\.text:\\n                machine\\.failure <- InterpretFailure\\.FileIo\\n                return runtime_void\\(\\)\\n            c_source: dstr = nul_terminated_path\\(source\\.text\\)"
            SOURCE_STAT: sview = "source_info: mutable ElisascriptStat = zeroed"
            DESTINATION_STAT: sview = "destination_info: mutable ElisascriptStat = zeroed"
            SOURCE_IDENTITY: sview = "elisascript_posix_stat\\(source_items\\.cast\\[cstr\\], source_info\\)"
            DESTINATION_IDENTITY: sview = "elisascript_posix_stat\\(destination_items\\.cast\\[cstr\\], destination_info\\)"
            SAME_INODE: sview = "source_info\\.device == destination_info\\.device and source_info\\.inode == destination_info\\.inode"
            BOTH_EXIST: sview = "source_exists and destination_exists"
            DOCS_SELF_COPY: sview = "exactly identical source and destination|self-copy|self copy"
            DOCS_ALIAS: sview = "hard.link|hard link|same file|inode|alias"
            LEDGER_SELF_COPY: sview = "exactly identical source and|self-copy|self copy"
            LEDGER_ALIAS: sview = "hard.link|hard link|same file|inode|alias"


        const module Messages:
            MISSING_ROOT: sview = "copy-path audit: missing repository root"
            UNRESOLVED_ROOT: sview = "copy-path audit: unable to resolve repository root"
            MISSING_INPUT: sview = "copy-path audit: missing "
            READ_FAILED: sview = "copy-path audit: unable to read source: "
            SUCCESS: sview = "copy-path audit: identical source/destination is rejected before truncating open"


        const enum SearchMode of u8:
            Line
            FullText


        struct SearchCheck:
            input: Path
            pattern: sview
            mode: SearchMode


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(interpreter: Path, docs: Path, ledger: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: interpreter, pattern: Patterns::COPY_PATH, mode: SearchMode.Line},
                SearchCheck{input: interpreter, pattern: Patterns::IDENTICAL_PATHS, mode: SearchMode.Line},
                SearchCheck{input: interpreter, pattern: Patterns::REJECT_BEFORE_OPEN, mode: SearchMode.FullText},
                SearchCheck{input: interpreter, pattern: Patterns::SOURCE_STAT, mode: SearchMode.Line},
                SearchCheck{input: interpreter, pattern: Patterns::DESTINATION_STAT, mode: SearchMode.Line},
                SearchCheck{input: interpreter, pattern: Patterns::SOURCE_IDENTITY, mode: SearchMode.Line},
                SearchCheck{input: interpreter, pattern: Patterns::DESTINATION_IDENTITY, mode: SearchMode.Line},
                SearchCheck{input: interpreter, pattern: Patterns::SAME_INODE, mode: SearchMode.Line},
                SearchCheck{input: interpreter, pattern: Patterns::BOTH_EXIST, mode: SearchMode.Line},
                SearchCheck{input: docs, pattern: Patterns::DOCS_SELF_COPY, mode: SearchMode.Line},
                SearchCheck{input: docs, pattern: Patterns::DOCS_ALIAS, mode: SearchMode.Line},
                SearchCheck{input: ledger, pattern: Patterns::LEDGER_SELF_COPY, mode: SearchMode.Line},
                SearchCheck{input: ledger, pattern: Patterns::LEDGER_ALIAS, mode: SearchMode.Line}
            ]


        def has_line_match(path: Path, pattern_text: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(pattern_text)
            catch EsSourceFunctionScope::contains_file_regex_line(path, pattern):
                ok found:
                    return 1i64 if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return 2i64


        def has_full_text_match(path: Path, pattern_text: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(pattern_text)
            catch EsSourceFunctionScope::contains_file_regex_text(path, pattern):
                ok found:
                    return 1i64 if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return 2i64


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                status: i64 = when check.mode:
                    SearchMode.Line -> has_line_match(check.input, check.pattern)
                    SearchMode.FullText -> has_full_text_match(check.input, check.pattern)
                    _ -> 1i64
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return 1i64
            root: Path = path_normalize(repository_root)

            inputs: darray[Path] = [
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return 1i64

            status: i64 = execute(searches(inputs[0], inputs[1], inputs[2]))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsCopyPathSafetyAudit::run_default()
