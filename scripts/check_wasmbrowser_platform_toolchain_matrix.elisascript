# Typed, bounded replacement candidate for WasmBrowser's platform/toolchain check.
include "../src/runtime/encoding.elisa"
include "../src/runtime/data_model.elisa"
include "../src/runtime/json_model.elisa"
include "../src/runtime/json_lexer_model.elisa"
include "../src/runtime/json_parse_model.elisa"
include "../src/runtime/bounded_text_posix.elisa"
include "../src/runtime/platform_toolchain_matrix_model.elisa"

using EsBoundedText
using EsPlatformToolchainMatrix


module EsWasmBrowserPlatformToolchainMatrixCommand:
    private:
        const module Paths:
            PROJECT: sview = "WasmBrowser"
            MATRIX: sview = "docs/platform-toolchain-matrix.json"


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr("platform toolchain matrix check: " + message + "\n")


    public:
        def run(project_root: Path) -> i64 can[Blocking.IO, File.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
            matrix_path: Path = project_root.joinpath(Paths::MATRIX)
            source: sview = try EsBoundedText::read_utf8(matrix_path, 1048576) else err:
                diagnostic("unable to read bounded UTF-8 platform toolchain matrix")
                return 2i64
            target_count: usize = try validate_platform_toolchain_matrix_source(source) else err:
                diagnostic("platform toolchain matrix is invalid")
                return 1i64
            _ = write_stdout(f"platform toolchain matrix valid: {target_count} targets with separate build/device/legal fields\n")
            return 0i64


        def run_default() -> i64 can[Blocking.IO, File.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
            script_file: Path = try path_real(path(Script::source_path())) else err:
                diagnostic("unable to resolve script path")
                return 2i64
            script_directory: Path = script_file.parent()
            projects_root: Path = script_directory.parent().parent()
            project_root: Path = try path_real(projects_root.joinpath(Paths::PROJECT)) else err:
                diagnostic("unable to resolve WasmBrowser project root")
                return 2i64
            return run(project_root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, File.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
    _ = arguments
    return EsWasmBrowserPlatformToolchainMatrixCommand::run_default()
