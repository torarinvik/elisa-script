# Bounded Elisascript port of check_record_numeric.sh.
# Regex source checks stream through the shared line scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsRecordNumericAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/record_numeric_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            RUNTIME_FIXTURE: sview = "test/runtime/record_numeric_model_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsRecordNumeric:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/record_numeric_model\.elisa\""
            KIND: Regex = regex"const enum RecordNumericKind of u8"
            PHASE: Regex = regex"const enum RecordNumericPhase of u8"
            EVENT: Regex = regex"const enum RecordNumericEvent of u8"
            POLICY: Regex = regex"struct RecordNumericPolicy:"
            RESULT: Regex = regex"struct RecordNumericResult:"
            SESSION: Regex = regex"struct RecordNumericSession:"
            ERROR: Regex = regex"error RecordNumericError:"
            VALIDATE: Regex = regex"def validate_record_numeric_session\("
            RESULT_VALUE: Regex = regex"def record_numeric_result\("
            RESULT_I64: Regex = regex"def record_numeric_result_i64\("
            RESULT_U64: Regex = regex"def record_numeric_result_u64\("
            ADVANCE: Regex = regex"def advance_record_numeric\("
            MAX_BYTES: Regex = regex"RECORD_NUMERIC_MAX_BYTES"
            MAX_DIGITS: Regex = regex"RECORD_NUMERIC_MAX_DIGITS"
            MAX_EXPONENT_DIGITS: Regex = regex"RECORD_NUMERIC_MAX_EXPONENT_DIGITS"
            EXPONENT_DIGIT_LIMIT: Regex = regex"const RECORD_NUMERIC_MAX_EXPONENT_DIGITS: usize = 20"
            INTEGER_LIMIT: Regex = regex"record_numeric_integer_limit"
            EXPONENT_LIMIT: Regex = regex"record_numeric_exponent_limit"
            INTEGER_OVERFLOW: Regex = regex"RecordNumericError.IntegerOverflow"
            UNDERSCORE_PLACEMENT: Regex = regex"RecordNumericError.UnderscorePlacement"
            EXPONENT_LIMIT_EXCEEDED: Regex = regex"RecordNumericError.ExponentLimitExceeded"
            ACCOUNTING_INVALID: Regex = regex"RecordNumericError.AccountingInvalid"
            WIDE_EXPONENT: Regex = regex"wide_exponent"
            TRAILING_POINT_VALID: Regex = regex"record_numeric_trailing_point_valid"
            TRAILING_POINT_CANDIDATE: Regex = regex"trailing_point_candidate"
            EXPONENT_DIGITS_EMPTY: Regex = regex"session.phase == RecordNumericPhase.ExponentDigits and session.exponent_digits == 0"
            EXPONENT_LEAD_DIGITS: Regex = regex"session.phase == RecordNumericPhase.ExponentLead and \(session.exponent_digits != 0"
            DIGITS_EXCEED_CHARS: Regex = regex"session.digits > session.chars"
            SAW_EXPONENT_PHASE: Regex = regex"session.saw_exponent and session.phase"
            PLANNED: Regex = regex"RecordNumericState.Planned"
            FINISH: Regex = regex"RecordNumericEvent.Finish"
            CANCEL: Regex = regex"RecordNumericEvent.Cancel"
            UNDERSCORE_DECIMAL: Regex = regex"underscore_decimal_rejected"
            TRAILING_DECIMAL_CONTRACT: Regex = regex"record_numeric_accepts_trailing_decimal_point_forms"
            POINT_RESULT: Regex = regex"point_result.coefficient_digits == 1 and point_result.fraction_digits == 0"
            EXPONENT_RESULT: Regex = regex"exponent_result.coefficient_digits == 1 and exponent_result.fraction_digits == 0"
            FORGED_TRAILING_POINT: Regex = regex"forged_trailing_point_rejected <- failure == RecordNumericError.AccountingInvalid"
            FORGED_EXPONENT_PHASE: Regex = regex"forged_exponent_phase_rejected <- failure == RecordNumericError.AccountingInvalid"
            MATERIALIZES_INTEGER: Regex = regex"record_numeric_materializes_checked_integer_results"
            SIGNED_MINIMUM: Regex = regex"signed_minimum: RecordNumericResult"
            SIGNED_OVERFLOW: Regex = regex"signed_overflow_rejected"
            UNSIGNED_MAXIMUM: Regex = regex"unsigned_maximum: RecordNumericResult"
            FIXTURE_IMPORT: Regex = regex"using EsRecordNumeric"
            FIXTURE_CONTRACT: Regex = regex"typed_record_numeric_contract_checks_signed_unsigned_and_decimal_lexemes"
            INTEGER_KIND: Regex = regex"RecordNumericKind.Integer"
            UNSIGNED_KIND: Regex = regex"RecordNumericKind.Unsigned"
            DECIMAL_KIND: Regex = regex"RecordNumericKind.Decimal"
            SIGN_NOT_ALLOWED: Regex = regex"RecordNumericError.SignNotAllowed"
            TRAILING_SEPARATOR: Regex = regex"RecordNumericError.TrailingSeparator"
            FIXTURE_INTEGER_OVERFLOW: Regex = regex"RecordNumericError.IntegerOverflow"
            FIXTURE_ACCOUNTING_INVALID: Regex = regex"RecordNumericError.AccountingInvalid"
            FORGED: Regex = regex"forged"
            DOCS_SESSION: Regex = regex"EsRecordNumeric::RecordNumericSession"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-038"


        const module Messages:
            MISSING_ROOT: sview = "record numeric audit: missing repository root"
            UNRESOLVED_ROOT: sview = "record numeric audit: unable to resolve repository root"
            MISSING_INPUT: sview = "record numeric audit: missing "
            READ_FAILED: sview = "record numeric audit: unable to read source: "
            SUCCESS: sview = "record numeric audit: bounded signed/unsigned/decimal lexical parsing is present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::PHASE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::RESULT},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::RESULT_VALUE},
                SearchCheck{input: inputs[0], pattern: Patterns::RESULT_I64},
                SearchCheck{input: inputs[0], pattern: Patterns::RESULT_U64},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_DIGITS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_EXPONENT_DIGITS},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPONENT_DIGIT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::INTEGER_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPONENT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::INTEGER_OVERFLOW},
                SearchCheck{input: inputs[0], pattern: Patterns::UNDERSCORE_PLACEMENT},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPONENT_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTING_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::WIDE_EXPONENT},
                SearchCheck{input: inputs[0], pattern: Patterns::TRAILING_POINT_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::TRAILING_POINT_CANDIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPONENT_DIGITS_EMPTY},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPONENT_LEAD_DIGITS},
                SearchCheck{input: inputs[0], pattern: Patterns::DIGITS_EXCEED_CHARS},
                SearchCheck{input: inputs[0], pattern: Patterns::SAW_EXPONENT_PHASE},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED},
                SearchCheck{input: inputs[0], pattern: Patterns::FINISH},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL},
                SearchCheck{input: inputs[2], pattern: Patterns::UNDERSCORE_DECIMAL},
                SearchCheck{input: inputs[3], pattern: Patterns::TRAILING_DECIMAL_CONTRACT},
                SearchCheck{input: inputs[3], pattern: Patterns::POINT_RESULT},
                SearchCheck{input: inputs[3], pattern: Patterns::EXPONENT_RESULT},
                SearchCheck{input: inputs[3], pattern: Patterns::FORGED_TRAILING_POINT},
                SearchCheck{input: inputs[3], pattern: Patterns::FORGED_EXPONENT_PHASE},
                SearchCheck{input: inputs[3], pattern: Patterns::MATERIALIZES_INTEGER},
                SearchCheck{input: inputs[3], pattern: Patterns::SIGNED_MINIMUM},
                SearchCheck{input: inputs[3], pattern: Patterns::SIGNED_OVERFLOW},
                SearchCheck{input: inputs[3], pattern: Patterns::UNSIGNED_MAXIMUM},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::INTEGER_KIND},
                SearchCheck{input: inputs[2], pattern: Patterns::UNSIGNED_KIND},
                SearchCheck{input: inputs[2], pattern: Patterns::DECIMAL_KIND},
                SearchCheck{input: inputs[2], pattern: Patterns::SIGN_NOT_ALLOWED},
                SearchCheck{input: inputs[2], pattern: Patterns::TRAILING_SEPARATOR},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INTEGER_OVERFLOW},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ACCOUNTING_INVALID},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[5], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::RUNTIME_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsRecordNumericAudit::run_default()
