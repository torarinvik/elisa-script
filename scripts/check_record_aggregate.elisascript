# Bounded Elisascript port of check_record_aggregate.sh.
# With no root operand, resolve the repository from this script's own location,
# matching the shell reference even when the caller's working directory differs.
# The candidate never starts rg or another child process.

include "../src/runtime/bounded_text_posix.elisa"

using EsBoundedText


module EsRecordAggregateAudit:
    private:
        const module Limits:
            SOURCE_BYTES: usize = 16777216
            TOTAL_SOURCE_BYTES: usize = 4194304
            CANDIDATE_BYTES: usize = 1048576


        const module Inputs:
            MODEL: sview = "src/runtime/record_aggregate_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            RUNTIME_FIXTURE: sview = "test/runtime/record_aggregate_model_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"
            CANDIDATE: sview = "scripts/check_record_aggregate.elisascript"
            BOUNDED_READER: sview = "src/runtime/bounded_text_posix.elisa"


        error AuditReadError:
            Missing
            LimitExceeded
            Changed


        def display_path(root: sview, relative: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return "/" + relative if root == "/"
            return root + "/" + relative


        def write_diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def read_source(input_path: Path, source_size: usize) -> sview error[AuditReadError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Unsafe.PointerCast]:
            current_size: usize = try file_size(input_path) else err:
                raise AuditReadError.Missing
            raise AuditReadError.LimitExceeded if current_size > source_size or current_size > Limits::SOURCE_BYTES
            raise AuditReadError.Changed if current_size < source_size
            source: mutable sview = ""
            catch EsBoundedText::read_utf8(input_path, source_size):
                ok contents:
                    source <- contents
                error failure:
                    if failure == EsBoundedText::ReadError.LimitExceeded:
                        raise AuditReadError.LimitExceeded
                    if failure == EsBoundedText::ReadError.Changed:
                        raise AuditReadError.Changed
                    raise AuditReadError.Missing
            raise AuditReadError.LimitExceeded if len(source) > source_size
            raise AuditReadError.Changed if len(source) < source_size
            return source


        def read_auxiliary_source(root: Path, relative: sview, limit: usize) -> sview error[AuditReadError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Unsafe.PointerCast]:
            input_path: Path = path_join(root, relative)
            source_size: usize = try file_size(input_path) else err:
                raise AuditReadError.Missing
            raise AuditReadError.LimitExceeded if source_size > limit
            return try read_source(input_path, source_size)


        def has_prefix_line(source: sview, prefix: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            lines: darray[sview] = split_lines(source)
            for line in lines:
                return true if line.startswith(prefix)
            return false


        def contains_all(source: sview, required: darray[sview]) -> bool:
            for needle in required:
                return false if source.index(needle) < 0
            return true


    public:
        def run(repository_root: sview) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Blocking.IO, Directory.Read, File.Read, Unsafe.PointerCast]:
            if repository_root == "":
                write_diagnostic("record aggregate audit: missing repository root")
                return 1i64
            root_absolute: Path = try path_real(path_absolute(path(repository_root))) else err:
                write_diagnostic("record aggregate audit: missing repository root")
                return 1i64
            if not is_directory(root_absolute):
                write_diagnostic("record aggregate audit: missing repository root")
                return 1i64
            root_text: sview = f"{root_absolute}"
            relative_paths: darray[sview] = [Inputs::MODEL, Inputs::IR, Inputs::FIXTURE, Inputs::RUNTIME_FIXTURE, Inputs::DOCS, Inputs::LEDGER]
            required_paths: darray[sview] = [Inputs::MODEL, Inputs::IR, Inputs::FIXTURE, Inputs::RUNTIME_FIXTURE, Inputs::DOCS, Inputs::LEDGER, Inputs::CANDIDATE, Inputs::BOUNDED_READER]
            source_sizes: mutable darray[usize] = []
            sources: mutable darray[sview] = []
            total_bytes: mutable usize = 0

            # Match the shell reference's path/readability preflight: report
            # unavailable inputs before any source-size rejection. Candidate
            # and bounded-reader paths are resolved under the selected root,
            # matching the shell reference rather than this checkout.
            for relative in required_paths |required_paths, root_absolute, root_text|:
                input_display: sview = display_path(root_text, relative)
                input_path: Path = path_join(root_absolute, relative)
                if not is_file(input_path) or not is_readable(input_path):
                    write_diagnostic(f"record aggregate audit: missing {input_display}")
                    return 1i64

            # Match the shell reference's separate aggregate-size pass before
            # allocating any complete source text.
            for relative in relative_paths |relative_paths, root_absolute, root_text, source_sizes, total_bytes|:
                input_display: sview = display_path(root_text, relative)
                input_path: Path = path_join(root_absolute, relative)
                source_size: usize = try file_size(input_path) else err:
                    write_diagnostic(f"record aggregate audit: missing {input_display}")
                    return 1i64
                if source_size > Limits::SOURCE_BYTES or source_size > Limits::TOTAL_SOURCE_BYTES - total_bytes:
                    write_diagnostic(f"record aggregate audit: source exceeds audit limit: {input_display}")
                    return 2i64
                total_bytes <- total_bytes + source_size
                source_sizes.push(source_size)

            for relative in relative_paths |relative_paths, root_absolute, root_text, source_sizes, sources|:
                input_display: sview = display_path(root_text, relative)
                input_path: Path = path_join(root_absolute, relative)
                source_index: usize = sources.count
                catch read_source(input_path, source_sizes[source_index]):
                    ok source:
                        sources.push(source)
                    error failure:
                        if failure == AuditReadError.Missing:
                            write_diagnostic(f"record aggregate audit: missing {input_display}")
                            return 1i64
                        if failure == AuditReadError.LimitExceeded:
                            write_diagnostic(f"record aggregate audit: source exceeds audit limit: {input_display}")
                            return 2i64
                        write_diagnostic(f"record aggregate audit: source changed during audit: {input_display}")
                        return 2i64

            candidate_source: mutable sview = ""
            catch read_auxiliary_source(root_absolute, Inputs::CANDIDATE, Limits::CANDIDATE_BYTES):
                ok source:
                    candidate_source <- source
                error failure:
                    input_display: sview = display_path(root_text, Inputs::CANDIDATE)
                    if failure == AuditReadError.Missing:
                        write_diagnostic(f"record aggregate audit: missing {input_display}")
                        return 1i64
                    if failure == AuditReadError.LimitExceeded:
                        write_diagnostic(f"record aggregate audit: source exceeds audit limit: {input_display}")
                        return 2i64
                    write_diagnostic(f"record aggregate audit: source changed during audit: {input_display}")
                    return 2i64

            bounded_reader: mutable sview = ""
            catch read_auxiliary_source(root_absolute, Inputs::BOUNDED_READER, Limits::SOURCE_BYTES):
                ok source:
                    bounded_reader <- source
                error failure:
                    input_display: sview = display_path(root_text, Inputs::BOUNDED_READER)
                    if failure == AuditReadError.Missing:
                        write_diagnostic(f"record aggregate audit: missing {input_display}")
                        return 1i64
                    if failure == AuditReadError.LimitExceeded:
                        write_diagnostic(f"record aggregate audit: source exceeds audit limit: {input_display}")
                        return 2i64
                    write_diagnostic(f"record aggregate audit: source changed during audit: {input_display}")
                    return 2i64

            candidate_header_end: i64 = candidate_source.index("module EsRecordAggregateAudit:")
            return 1i64 if candidate_header_end < 0
            candidate_header: sview = string_view_slice(candidate_source, 0, candidate_header_end)
            header_marker: sview = "# With no root operand, resolve the repository " + "from this script's own location,"
            return 1i64 if candidate_header.index(header_marker) < 0

            # Split the expected source markers so this pattern table cannot
            # satisfy its own check by containing the literal being searched.
            candidate_source_patterns: darray[sview] = [
                "module EsRecord" + "AggregateAudit:",
                "include \"../src/runtime/" + "bounded_text_posix.elisa\"",
                "EsBoundedText::read_utf8(input_path, " + "source_size)",
                "ReadError." + "LimitExceeded",
                "AuditReadError." + "Changed",
                "source changed during audit:",
                "def read_" + "source(",
                "current_size: usize = try " + "file_size(input_path)",
                "catch EsBoundedText::read_utf8(input_path, " + "source_size)",
                "def run(" + "repository_root: sview)",
                "def run_" + "default()",
                "Script::source_" + "path()",
                "CANDIDATE: sview = \"scripts/" + "check_record_aggregate.elisascript\"",
                "BOUNDED_READER: sview = \"src/runtime/" + "bounded_text_posix.elisa\"",
                "required_" + "paths: darray[sview]",
                "for relative in required_paths " + "|required_paths, root_absolute, root_text|:",
                "input_path: Path = path_join(root_absolute, " + "relative)",
                "if not is_file(input_path) or not is_readable(input_path)",
                "CANDIDATE_BYTES: usize = " + "1048576",
                "def read_auxiliary_" + "source(",
                "candidate_header_end: i64 = candidate_source.index(" + "\"module EsRecordAggregateAudit:\")",
                "bounded_reader_patterns: darray[sview] = [",
                "script_directory." + "parent()",
                "if not is_directory(root_absolute)",
                "Match the shell reference's path/readability preflight",
                "not is_readable(input_path)",
                "source_sizes.push(source_size)",
                "catch read_source(input_path, " + "source_sizes[source_index])",
                "Limits::TOTAL_SOURCE_BYTES - " + "total_bytes",
                "usage: record aggregate audit " + "[repository-root]"
            ]
            if not contains_all(candidate_source, candidate_source_patterns):
                return 1i64
            forbidden_read: sview = "read_" + "text("
            return 1i64 if candidate_source.index(forbidden_read) >= 0

            source_preflight_index: i64 = candidate_source.index("for relative in required_paths " + "|required_paths, root_absolute, root_text|:")
            source_size_pass_index: i64 = candidate_source.index("for relative in relative_paths " + "|relative_paths, root_absolute, root_text, source_sizes, total_bytes|:")
            return 1i64 if source_preflight_index < 0 or source_size_pass_index < 0 or source_preflight_index >= source_size_pass_index
            source_size_capture_index: i64 = candidate_source.index("source_sizes.push(" + "source_size)")
            source_read_index: i64 = candidate_source.index("catch read_source(input_path, " + "source_sizes[source_index])")
            return 1i64 if source_size_capture_index < 0 or source_read_index < 0 or source_size_capture_index >= source_read_index
            input_size_check_index: i64 = candidate_source.index("current_size: usize = try " + "file_size(input_path)")
            bounded_input_read_index: i64 = candidate_source.index("catch EsBoundedText::read_utf8(input_path, " + "source_size)")
            return 1i64 if input_size_check_index < 0 or bounded_input_read_index < 0 or input_size_check_index >= bounded_input_read_index

            bounded_reader_patterns: darray[sview] = [
                "MAX_BYTES: usize = 16777216",
                "probe_capacity: usize = remaining + 1",
                "ReadError.Changed",
                "stable_file(opened, final_opened)"
            ]
            if not contains_all(bounded_reader, bounded_reader_patterns):
                return 1i64

            model: sview = sources[0]
            ir: sview = sources[1]
            fixture: sview = sources[2]
            runtime_fixture: sview = sources[3]
            docs: sview = sources[4]
            ledger: sview = sources[5]

            if not has_prefix_line(model, "module EsRecordAggregate:"):
                return 1i64
            if ir.index("include \"../runtime/record_aggregate_model.elisa\"") < 0:
                return 1i64

            declarations: darray[sview] = [
                "const enum RecordAggregateState of u8",
                "const enum RecordAggregateEvent of u8",
                "struct RecordAggregatePolicy:",
                "struct RecordAggregateGroup:",
                "struct RecordAggregateSession:",
                "error RecordAggregateError:",
                "def validate_record_aggregate(",
                "def record_aggregate_group_count(",
                "def record_aggregate_group_sum(",
                "def advance_record_aggregate("
            ]
            if not contains_all(model, declarations):
                return 1i64

            boundaries: darray[sview] = [
                "const module Limits:",
                "GROUPS: usize = 1048576",
                "EVENTS: usize = 1048576",
                "KEY_BYTES: usize = 268435456",
                "SUM: u64 = 67108864",
                "INDEX_SLOTS: usize = 2097152",
                "sum: i64 = 0",
                "def record_aggregate_group_sum(session: RecordAggregateSession&, key: sview) -> i64 error[RecordAggregateError]",
                "0 - session.policy.max_sum.i64()",
                "value > sum_limit or value < 0 - sum_limit",
                "value < 0 and session.groups[index].sum < 0 - sum_limit - value",
                "record_aggregate_key_hash",
                "record_aggregate_index_find",
                "record_aggregate_index_place",
                "record_aggregate_ensure_index_capacity",
                "validate_record_aggregate_header",
                "indexed_groups != session.groups.count",
                "record_aggregate_index_find(session.groups, session.index_slots, group.key)",
                "try validate_record_aggregate_header(session)",
                "try record_aggregate_ensure_index_capacity(session)",
                "record_aggregate_key_valid",
                "sview_len(key) <= policy.max_key_bytes",
                "RecordAggregateError.GroupLimitExceeded",
                "RecordAggregateError.EventLimitExceeded",
                "RecordAggregateError.KeyBytesLimitExceeded",
                "RecordAggregateError.AccountingInvalid",
                "session.state == RecordAggregateState.Planned and",
                "accounted_events",
                "previous_first_ordinal",
                "group.first_ordinal <= previous_first_ordinal",
                "RecordAggregateError.GroupIndexInvalid",
                "RecordAggregateEvent.Add",
                "RecordAggregateEvent.AddValue",
                "SumLimitExceeded",
                "RecordAggregateEvent.Seal"
            ]
            if not contains_all(model, boundaries):
                return 1i64
            if model.index("record_aggregate_index(session, key)") >= 0:
                return 1i64

            fixture_patterns: darray[sview] = [
                "using EsRecordAggregate",
                "typed_record_aggregate_contract_is_bounded_and_insertion_ordered",
                "RecordAggregateEvent.Add",
                "record_aggregate_group_count",
                "max_key_bytes: 5",
                "\"12345\"",
                "forged_aggregate_order",
                "RecordAggregateError.GroupIndexInvalid"
            ]
            if not contains_all(fixture, fixture_patterns):
                return 1i64

            runtime_fixture_patterns: darray[sview] = [
                "using EsRecordAggregate",
                "record_aggregate_hash_index_preserves_order_and_rejects_damage",
                "signed_aggregate",
                "record_aggregate_group_sum(signed_aggregate, \"alpha\") == -2",
                "negative_sum_rejected",
                "index_growth",
                "index_growth.index_slots.count == 16",
                "record_aggregate_group_count(index_growth, \"i\") == 1",
                "damaged.index_slots[index] <- 0",
                "RecordAggregateError.AccountingInvalid",
                "RecordAggregateError.SumLimitExceeded"
            ]
            if not contains_all(runtime_fixture, runtime_fixture_patterns):
                return 1i64

            return 1i64 if docs.index("EsRecordAggregate::RecordAggregateSession") < 0
            return 1i64 if ledger.index("ES-SCRIPT-027") < 0

            print("record aggregate audit: bounded insertion-ordered groups and sealed lookup are present")
            return 0i64


        def run_default() -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Blocking.IO, Directory.Read, File.Read, Unsafe.PointerCast]:
            script_path: Path = Script::source_path()
            absolute_script_path: Path = try path_absolute(script_path) else err:
                write_diagnostic("record aggregate audit: missing repository root")
                return 1i64
            script_directory: Path = absolute_script_path.parent()
            repository_root: Path = script_directory.parent()
            return run(f"{repository_root}")


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Blocking.IO, Directory.Read, File.Read, Unsafe.PointerCast]:
    if arguments.count > 1:
        _ = write_stderr("usage: record aggregate audit [repository-root]\n")
        return 2i64

    return EsRecordAggregateAudit::run(arguments[0]) if arguments.count == 1
    return EsRecordAggregateAudit::run_default()
