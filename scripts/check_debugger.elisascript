# Bounded Elisascript port of check_debugger.sh.
# Regex source checks stream through the shared scanner without rg/awk.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDebuggerAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/debugger_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsDebugger:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/debugger_model\.elisa\""
            STATE: Regex = regex"const enum DebuggerState of u8"
            EVENT: Regex = regex"const enum DebuggerEvent of u8"
            POLICY: Regex = regex"struct DebuggerPolicy:"
            BREAKPOINT: Regex = regex"struct DebuggerBreakpoint:"
            FRAME: Regex = regex"struct DebuggerFrame:"
            BRANCH: Regex = regex"struct DebuggerBranch:"
            SESSION: Regex = regex"struct DebuggerSession:"
            ERROR: Regex = regex"error DebuggerError:"
            VALIDATE: Regex = regex"def validate_debugger_session\("
            SET_BREAKPOINT: Regex = regex"def debugger_set_breakpoint\("
            PUSH_FRAME: Regex = regex"def debugger_push_frame\("
            ADVANCE: Regex = regex"def advance_debugger\("
            BREAKPOINT_LIMIT: Regex = regex"Limits::BREAKPOINTS"
            FRAME_LIMIT: Regex = regex"Limits::FRAMES"
            BRANCH_LIMIT: Regex = regex"Limits::BRANCHES"
            NAME_LIMIT: Regex = regex"Limits::NAME_BYTES"
            SELECT_BRANCH: Regex = regex"DebuggerEvent.SelectBranch"
            STEP: Regex = regex"DebuggerEvent.Step"
            INVALID_TRANSITION: Regex = regex"DebuggerError.InvalidTransition"
            BRANCH_SELECTION_INVALID: Regex = regex"DebuggerError.BranchSelectionInvalid"
            INVALID_DEPTH: Regex = regex"DebuggerError.InvalidDepth"
            INVALID_BRANCH: Regex = regex"DebuggerError.InvalidBranch"
            BRANCH_CYCLE: Regex = regex"DebuggerError.BranchCycle"
            FAILED_STATE: Regex = regex"session.state == DebuggerState.Failed"
            DETACHED_STATE: Regex = regex"DebuggerState.Detached and"
            FIXTURE_IMPORT: Regex = regex"using EsDebugger"
            FIXTURE_CONTRACT: Regex = regex"typed_debugger_contract_controls_breakpoints_frames_and_replay"
            FIXTURE_SELECT_BRANCH: Regex = regex"DebuggerEvent.SelectBranch"
            FIXTURE_STEP: Regex = regex"DebuggerEvent.Step"
            FIXTURE_INVALID_TRANSITION: Regex = regex"DebuggerError.InvalidTransition"
            FIXTURE_INVALID_BRANCH: Regex = regex"DebuggerError.InvalidBranch"
            FIXTURE_BRANCH_CYCLE: Regex = regex"DebuggerError.BranchCycle"
            DOCS_SESSION: Regex = regex"EsDebugger::DebuggerSession"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-049"


        const module Messages:
            MISSING_ROOT: sview = "debugger audit: missing repository root"
            UNRESOLVED_ROOT: sview = "debugger audit: unable to resolve repository root"
            MISSING_INPUT: sview = "debugger audit: missing "
            READ_FAILED: sview = "debugger audit: unable to read source: "
            SUCCESS: sview = "debugger audit: bounded breakpoints, frames, replay selection, and terminal states are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::BREAKPOINT},
                SearchCheck{input: inputs[0], pattern: Patterns::FRAME},
                SearchCheck{input: inputs[0], pattern: Patterns::BRANCH},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::SET_BREAKPOINT},
                SearchCheck{input: inputs[0], pattern: Patterns::PUSH_FRAME},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::BREAKPOINT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::FRAME_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::BRANCH_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::SELECT_BRANCH},
                SearchCheck{input: inputs[0], pattern: Patterns::STEP},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_TRANSITION},
                SearchCheck{input: inputs[0], pattern: Patterns::BRANCH_SELECTION_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_DEPTH},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_BRANCH},
                SearchCheck{input: inputs[0], pattern: Patterns::BRANCH_CYCLE},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::DETACHED_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_SELECT_BRANCH},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STEP},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_TRANSITION},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_BRANCH},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_BRANCH_CYCLE},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDebuggerAudit::run_default()
