# Bounded Elisascript port of the TSV record-validation stage in
# check_migration_review.sh. It replaces the AWK/rg field checks; it does not
# perform the shell script's separate `bash -n` syntax check.

include "../src/runtime/encoding.elisa"
include "../src/runtime/file_posix.elisa"
include "../src/runtime/directory_posix.elisa"
include "../src/runtime/stdio_posix.elisa"

using EsEncoding
using EsRuntime


module EsMigrationReviewAudit:
    public:
        error MigrationReviewError:
            InputLimitExceeded
            HeaderInvalid
            RecordShapeInvalid
            FieldInvalid
            DuplicatePath
            RowCountInvalid
            CandidateMissing
            SafetyDispositionInvalid


    private:
        const module Limits:
            FILE_BYTES: usize = 1048576
            ROWS: usize = 1024
            REVIEWED_ROWS: usize = 21
            PATH_BYTES: usize = 4096
            FIELD_BYTES: usize = 65536
            READ_CHUNK_BYTES: usize = 16384
            READ_EINTR_RETRIES: usize = 4


        const module Messages:
            MISSING_FILE: sview = "migration review audit: missing manifest"
            READ_FAILED: sview = "migration review audit: unable to read manifest"
            TOO_LARGE: sview = "migration review audit: manifest exceeds audit limit"
            HEADER_INVALID: sview = "migration review audit: invalid manifest header"
            ROWS_INVALID: sview = "migration review audit: rows are incomplete, duplicated, unreviewed, or use an unapproved disposition"
            SAFETY_INVALID: sview = "migration review audit: safety wrappers are not explicitly retained"


        const module Syntax:
            HEADER_TEXT: sview = "path\tkind\towner\treview_status\tentrypoint\tdisposition\trisk\tnotes"
            SAFETY_WRAPPERS: Regex = regex"/scripts/(run_bounded_lowering|run_bounded_test|stop_bounded_validation|check_validation_wrappers)[.]sh\tshell\telisascript-maintainers\treviewed\tdirect executable\tretain-external"


        const module RequiredCandidates:
            CHECK_DIFFERENTIAL_CASE: sview = "check_differential_case.sh"
            CHECK_NAMESPACE_MANIFEST: sview = "check_namespace_manifest.sh"
            CHECK_BUILTIN_SURFACE: sview = "check_builtin_surface.sh"
            CHECK_VALIDATION_WRAPPERS: sview = "check_validation_wrappers.sh"
            STOP_BOUNDED_VALIDATION: sview = "stop_bounded_validation.sh"
            RUN_BOUNDED_TEST: sview = "run_bounded_test.sh"
            INVENTORY_PROJECT_ROOTS: sview = "inventory_project_roots.sh"
            CHECK_SERIALIZATION_BOUNDS: sview = "check_serialization_bounds.sh"
            CHECK_CONTINUATION_POLICY: sview = "check_continuation_policy.sh"
            CHECK_DIAGNOSTIC_SNAPSHOT: sview = "check_diagnostic_snapshot.sh"
            INVENTORY_SIGNALS: sview = "inventory_signals.sh"
            INVENTORY_CANDIDATES: sview = "inventory_candidates.sh"
            CHECK_MIGRATION_INVENTORY: sview = "check_migration_inventory.sh"
            CHECK_MIGRATION_ROOTS: sview = "check_migration_roots.sh"
            CHECK_RUNTIME_LIMITS: sview = "check_runtime_limits.sh"
            CHECK_BUILTIN_REGISTRY: sview = "check_builtin_registry.sh"
            CHECK_STREAMING_FILE: sview = "check_streaming_file.sh"
            CHECK_PATH_LINE_CONTRACT: sview = "check_path_line_contract.sh"
            CHECK_RESOURCE_POLICY: sview = "check_resource_policy.sh"
            RUN_BOUNDED_LOWERING: sview = "run_bounded_lowering.sh"
            CHECK_EFFECT_OPERATION_METADATA: sview = "check_effect_operation_metadata.sh"


        struct ReviewRow:
            path: sview
            kind: sview
            owner: sview
            review_status: sview
            entrypoint: sview
            disposition: sview
            risk: sview
            notes: sview


        struct BoundedManifestRead:
            contents: sview = ""
            failure: bool = false
            changed: bool = false
            exceeded_limit: bool = false


        const enum ManifestReadPhase of u8:
            ReadChunk
            Done


        def migration_manifest_open(path_value: cstr) -> int can[Blocking.IO]:
            retries: mutable usize = 0
            flags: int = DarwinOpenFlags::RDONLY | DarwinOpenFlags::NONBLOCK | DarwinOpenFlags::CLOSE_ON_EXEC
            while true:
                descriptor: int = elisascript_posix_open(path_value, flags, 0u32)
                return descriptor if descriptor >= 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::READ_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return -1


        def migration_manifest_stat(path_value: cstr, result: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_stat(path_value, result) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::READ_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def migration_manifest_fstat(descriptor: int, result: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_fstat(descriptor, result) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::READ_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def migration_manifest_same_file(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return left.device == right.device and left.inode == right.inode


        def migration_manifest_stable_file(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return migration_manifest_same_file(left, right) and left.size == right.size and left.modify_time == right.modify_time and left.change_time == right.change_time


        def migration_manifest_utf8_valid(contents: sview) -> bool:
            cursor: mutable EsEncoding::Utf8Cursor = EsEncoding::Utf8Cursor{}
            for offset in 0..<len(contents) |contents, cursor|:
                return false if not EsEncoding::utf8_feed(sview_at(contents, offset), cursor)
            return EsEncoding::utf8_complete(cursor)


        def read_manifest_bounded(input_path: Path, maximum_bytes: usize) -> BoundedManifestRead can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_text: sview = f"{input_path}"
            if path_text == "" or len(path_text) >= Limits::PATH_BYTES or sview_contains_byte(path_text, 0):
                return BoundedManifestRead{failure: true}
            path_bytes: mutable darray[u8] = []
            for byte in path_text |path_bytes|:
                path_bytes.push(byte)
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr]

            named_before_open: mutable ElisascriptStat = zeroed
            if not migration_manifest_stat(path_pointer, named_before_open) or (named_before_open.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR:
                return BoundedManifestRead{failure: true}
            descriptor: int = migration_manifest_open(path_pointer)
            return BoundedManifestRead{failure: true} if descriptor < 0
            opened: mutable ElisascriptStat = zeroed
            if not migration_manifest_fstat(descriptor, opened) or (opened.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR or not migration_manifest_same_file(named_before_open, opened):
                _ = elisascript_posix_close(descriptor)
                return BoundedManifestRead{failure: true}
            named_after_open: mutable ElisascriptStat = zeroed
            if not migration_manifest_stat(path_pointer, named_after_open) or not migration_manifest_same_file(opened, named_after_open):
                _ = elisascript_posix_close(descriptor)
                return BoundedManifestRead{changed: true}

            chunk: mutable darray[u8] = []
            chunk.reserve(Limits::READ_CHUNK_BYTES)
            for _ in 0..<Limits::READ_CHUNK_BYTES |chunk|:
                chunk.push(0u8)
            bytes: mutable darray[u8] = []
            initial_capacity: usize = maximum_bytes if maximum_bytes < Limits::READ_CHUNK_BYTES else Limits::READ_CHUNK_BYTES
            bytes.reserve(initial_capacity)
            phase: mutable ManifestReadPhase = ManifestReadPhase.ReadChunk
            interrupted: mutable usize = 0
            machine over phase while phase != ManifestReadPhase.Done:
                state ReadChunk
                start ReadChunk

                ReadChunk, ManifestReadPhase.ReadChunk:
                    remaining: usize = maximum_bytes - bytes.count
                    probe_capacity: usize = remaining + 1
                    capacity: usize = probe_capacity if probe_capacity < chunk.count else chunk.count
                    chunk_pointer: mutable u8& = (&chunk[0]).cast[mutable u8&]
                    amount: isize = elisascript_posix_read(descriptor, chunk_pointer.cast[mutable void&], capacity)
                    if amount < 0:
                        errno: mutable i32& = elisascript_posix_errno()
                        if errno[0] == DarwinErrno::EINTR and interrupted < Limits::READ_EINTR_RETRIES:
                            interrupted <- interrupted + 1
                            -> ReadChunk
                        _ = elisascript_posix_close(descriptor)
                        return BoundedManifestRead{failure: true}
                    if amount == 0:
                        phase <- ManifestReadPhase.Done
                        continue
                    read_count: usize = amount.usize()
                    if read_count > capacity:
                        _ = elisascript_posix_close(descriptor)
                        return BoundedManifestRead{failure: true}
                    if read_count > remaining:
                        _ = elisascript_posix_close(descriptor)
                        return BoundedManifestRead{exceeded_limit: true}
                    for offset in 0..<read_count |bytes, chunk|:
                        bytes.push(chunk[offset])
                    interrupted <- 0
                    -> ReadChunk

                ReadChunk, ManifestReadPhase.Done:
                    break

            final_opened: mutable ElisascriptStat = zeroed
            final_named: mutable ElisascriptStat = zeroed
            stable: bool = migration_manifest_fstat(descriptor, final_opened) and migration_manifest_stat(path_pointer, final_named) and migration_manifest_stable_file(opened, final_opened) and migration_manifest_same_file(final_opened, final_named)
            close_status: int = elisascript_posix_close(descriptor)
            if close_status != 0:
                return BoundedManifestRead{failure: true}
            if not stable:
                return BoundedManifestRead{changed: true}
            contents: sview = bytes_view(bytes)
            return BoundedManifestRead{failure: true} if not migration_manifest_utf8_valid(contents)
            return BoundedManifestRead{contents: contents}


        def review_row_from_fields(fields: darray[sview]) -> ReviewRow error[MigrationReviewError]:
            raise MigrationReviewError.RecordShapeInvalid if fields.count != 8
            for field in fields:
                raise MigrationReviewError.FieldInvalid if len(field) > Limits::FIELD_BYTES

            row: ReviewRow = ReviewRow{
                path: fields[0],
                kind: fields[1],
                owner: fields[2],
                review_status: fields[3],
                entrypoint: fields[4],
                disposition: fields[5],
                risk: fields[6],
                notes: fields[7]
            }
            raise MigrationReviewError.FieldInvalid if not row.path.startswith("/") or len(row.path) >= Limits::PATH_BYTES
            raise MigrationReviewError.FieldInvalid if row.kind != "shell"
            raise MigrationReviewError.FieldInvalid if row.owner == "" or row.owner == "unassigned"
            raise MigrationReviewError.FieldInvalid if row.review_status != "reviewed"
            raise MigrationReviewError.FieldInvalid if row.entrypoint != "direct executable"
            raise MigrationReviewError.FieldInvalid if row.disposition != "port" and row.disposition != "retain-external"
            raise MigrationReviewError.FieldInvalid if row.risk != "test" and row.risk != "build" and row.risk != "release"
            raise MigrationReviewError.FieldInvalid if row.notes == ""
            return row


        def review_required_candidate_present(contents: sview, candidate: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            required_path: sview = "/scripts/" + candidate
            return contents.index(required_path) >= 0


        def review_first_missing_candidate(contents: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return RequiredCandidates::CHECK_DIFFERENTIAL_CASE if not review_required_candidate_present(contents, RequiredCandidates::CHECK_DIFFERENTIAL_CASE)
            return RequiredCandidates::CHECK_NAMESPACE_MANIFEST if not review_required_candidate_present(contents, RequiredCandidates::CHECK_NAMESPACE_MANIFEST)
            return RequiredCandidates::CHECK_BUILTIN_SURFACE if not review_required_candidate_present(contents, RequiredCandidates::CHECK_BUILTIN_SURFACE)
            return RequiredCandidates::CHECK_VALIDATION_WRAPPERS if not review_required_candidate_present(contents, RequiredCandidates::CHECK_VALIDATION_WRAPPERS)
            return RequiredCandidates::STOP_BOUNDED_VALIDATION if not review_required_candidate_present(contents, RequiredCandidates::STOP_BOUNDED_VALIDATION)
            return RequiredCandidates::RUN_BOUNDED_TEST if not review_required_candidate_present(contents, RequiredCandidates::RUN_BOUNDED_TEST)
            return RequiredCandidates::INVENTORY_PROJECT_ROOTS if not review_required_candidate_present(contents, RequiredCandidates::INVENTORY_PROJECT_ROOTS)
            return RequiredCandidates::CHECK_SERIALIZATION_BOUNDS if not review_required_candidate_present(contents, RequiredCandidates::CHECK_SERIALIZATION_BOUNDS)
            return RequiredCandidates::CHECK_CONTINUATION_POLICY if not review_required_candidate_present(contents, RequiredCandidates::CHECK_CONTINUATION_POLICY)
            return RequiredCandidates::CHECK_DIAGNOSTIC_SNAPSHOT if not review_required_candidate_present(contents, RequiredCandidates::CHECK_DIAGNOSTIC_SNAPSHOT)
            return RequiredCandidates::INVENTORY_SIGNALS if not review_required_candidate_present(contents, RequiredCandidates::INVENTORY_SIGNALS)
            return RequiredCandidates::INVENTORY_CANDIDATES if not review_required_candidate_present(contents, RequiredCandidates::INVENTORY_CANDIDATES)
            return RequiredCandidates::CHECK_MIGRATION_INVENTORY if not review_required_candidate_present(contents, RequiredCandidates::CHECK_MIGRATION_INVENTORY)
            return RequiredCandidates::CHECK_MIGRATION_ROOTS if not review_required_candidate_present(contents, RequiredCandidates::CHECK_MIGRATION_ROOTS)
            return RequiredCandidates::CHECK_RUNTIME_LIMITS if not review_required_candidate_present(contents, RequiredCandidates::CHECK_RUNTIME_LIMITS)
            return RequiredCandidates::CHECK_BUILTIN_REGISTRY if not review_required_candidate_present(contents, RequiredCandidates::CHECK_BUILTIN_REGISTRY)
            return RequiredCandidates::CHECK_STREAMING_FILE if not review_required_candidate_present(contents, RequiredCandidates::CHECK_STREAMING_FILE)
            return RequiredCandidates::CHECK_PATH_LINE_CONTRACT if not review_required_candidate_present(contents, RequiredCandidates::CHECK_PATH_LINE_CONTRACT)
            return RequiredCandidates::CHECK_RESOURCE_POLICY if not review_required_candidate_present(contents, RequiredCandidates::CHECK_RESOURCE_POLICY)
            return RequiredCandidates::RUN_BOUNDED_LOWERING if not review_required_candidate_present(contents, RequiredCandidates::RUN_BOUNDED_LOWERING)
            return RequiredCandidates::CHECK_EFFECT_OPERATION_METADATA if not review_required_candidate_present(contents, RequiredCandidates::CHECK_EFFECT_OPERATION_METADATA)
            return ""


        def review_safety_wrappers_valid(contents: sview) -> bool:
            return Syntax::SAFETY_WRAPPERS.search(contents)


        def review_required_candidates_valid(contents: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            return review_first_missing_candidate(contents) == ""


        def review_tab_count_valid(line: sview) -> bool:
            tabs: mutable usize = 0
            for character in line:
                tabs <- tabs + 1 if character == 9u8
                return false if tabs > 7
            return tabs == 7


        def review_header_present(lines: darray[sview]) -> bool:
            return false if lines.count == 0
            return lines[0] == Syntax::HEADER_TEXT


        def parse_review_rows(contents: sview) -> darray[ReviewRow] error[MigrationReviewError] can[Memory.Allocate, Abort.Panic]:
            # AWK's record separator is LF only; retain CR bytes so CRLF and
            # bare-CR inputs are not silently normalized into valid records.
            lines: darray[sview] = split(contents, "\n")
            raise MigrationReviewError.HeaderInvalid if not review_header_present(lines)
            rows: mutable darray[ReviewRow] = []
            paths: mutable darray[sview] = []
            index: mutable usize = 1

            while index < lines.count |contents, lines, rows, paths, index|:
                terminal_split_field: bool = index + 1 == lines.count and contents.endswith("\n") and lines[index] == ""
                if not terminal_split_field:
                    raise MigrationReviewError.RowCountInvalid if rows.count >= Limits::ROWS
                    raise MigrationReviewError.RecordShapeInvalid if not review_tab_count_valid(lines[index])
                    fields: darray[sview] = split(lines[index], "\t")
                    row: ReviewRow = try review_row_from_fields(fields)
                    paths.push(row.path)
                    rows.push(row)
                index <- index + 1

            raise MigrationReviewError.RowCountInvalid if rows.count != Limits::REVIEWED_ROWS
            ordered_paths: darray[sview] = sorted(paths)
            for index in 1..<ordered_paths.count |ordered_paths|:
                raise MigrationReviewError.DuplicatePath if ordered_paths[index - 1] == ordered_paths[index]
            return rows


        def audit_review_contents(contents: sview) -> void error[MigrationReviewError] can[Memory.Allocate, Abort.Panic]:
            rows: darray[ReviewRow] = try parse_review_rows(contents)
            raise MigrationReviewError.CandidateMissing if not review_required_candidates_valid(contents)
            raise MigrationReviewError.SafetyDispositionInvalid if not review_safety_wrappers_valid(contents)


        def audit_error_message(failure: MigrationReviewError) -> sview:
            return Messages::HEADER_INVALID if failure == MigrationReviewError.HeaderInvalid
            return Messages::SAFETY_INVALID if failure == MigrationReviewError.SafetyDispositionInvalid
            return Messages::ROWS_INVALID


        def read_review_manifest(input_path: Path) -> sview error[MigrationReviewError] can[Memory.Allocate, Abort.Panic, File.Read, Blocking.IO, Unsafe.PointerCast]:
            original_size: usize = try file_size(input_path) else err:
                raise MigrationReviewError.RecordShapeInvalid
            raise MigrationReviewError.InputLimitExceeded if original_size > Limits::FILE_BYTES

            current_size: usize = try file_size(input_path) else err:
                raise MigrationReviewError.RecordShapeInvalid
            raise MigrationReviewError.InputLimitExceeded if current_size > Limits::FILE_BYTES or current_size > original_size

            bounded: BoundedManifestRead = read_manifest_bounded(input_path, original_size)
            if bounded.failure:
                raise MigrationReviewError.RecordShapeInvalid
            raise MigrationReviewError.InputLimitExceeded if bounded.changed or bounded.exceeded_limit or len(bounded.contents) > Limits::FILE_BYTES or len(bounded.contents) > original_size
            return bounded.contents


    public:
        def validate_review_records(contents: sview) -> bool error[MigrationReviewError] can[Memory.Allocate, Abort.Panic]:
            rows: darray[ReviewRow] = try parse_review_rows(contents)
            return rows.count == Limits::REVIEWED_ROWS


        def run(manifest_path: Path) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, File.Read, Blocking.IO, Unsafe.PointerCast]:
            if not is_file(manifest_path):
                eprint(Messages::MISSING_FILE)
                return 1i64

            contents: mutable sview = ""
            read_ok: mutable bool = false
            catch read_review_manifest(manifest_path):
                ok value:
                    contents <- value
                    read_ok <- true
                error failure:
                    if failure == MigrationReviewError.InputLimitExceeded:
                        eprint(Messages::TOO_LARGE)
                    else:
                        eprint(Messages::READ_FAILED)
                    return 1i64
            if not read_ok:
                eprint(Messages::READ_FAILED)
                return 1i64

            catch audit_review_contents(contents):
                ok value:
                    println("migration review audit: 21 current candidates have reviewed ownership, disposition, and acceptance metadata")
                    return 0i64
                error failure:
                    if failure == MigrationReviewError.CandidateMissing:
                        missing_candidate: sview = review_first_missing_candidate(contents)
                        eprint("migration review audit: missing reviewed candidate " + missing_candidate)
                    else:
                        eprint(audit_error_message(failure))
                    return 1i64


        def run_default() -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, File.Read, Directory.Read, Blocking.IO, Unsafe.PointerCast]:
            script_path: Path = Script::source_path()
            script_directory: Path = try path_real(script_path.parent()) else err:
                eprint(Messages::MISSING_FILE)
                return 1i64
            repository_root: Path = script_directory.parent()
            manifest_path: Path = repository_root.joinpath("docs").joinpath("migration-review-current.tsv")
            return run(manifest_path)


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, File.Read, Directory.Read, Blocking.IO, Unsafe.PointerCast]:
    if arguments.count > 1:
        eprint("usage: check_migration_review [MANIFEST]")
        return 2i64
    if arguments.count == 1:
        return EsMigrationReviewAudit::run(path(arguments[0]))
    return EsMigrationReviewAudit::run_default()
