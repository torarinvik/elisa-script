# Bounded Elisascript port of check_script_test.sh.
# Dynamic InterpretError mapping coverage is preserved by scanning enum lines.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"
include "../src/runtime/stream_posix.elisa"

using EsRuntime


module EsScriptTestAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/script_test_model.elisa"
            RUNNER: sview = "src/ir/runner.elisa"
            EXECUTION: sview = "src/ir/execution.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            RUNNER_FIXTURE: sview = "test/ir/elisascript_runner_test.elisa"
            INTERPRET: sview = "src/ir/interpret.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            OUTPUT_MODEL_IMPORT: sview = "include \"../runtime/output_model.elisa\""
            TEST_MODEL_IMPORT: sview = "include \"../runtime/script_test_model.elisa\""
            MODULE: sview = "module EsScriptTest:"
            LIMITS: sview = "const module Limits:"
            CASE_STATE: sview = "const enum ScriptTestCaseState of u8"
            TEST_STATE: sview = "const enum ScriptTestState of u8"
            TEST_EVENT: sview = "const enum ScriptTestEvent of u8"
            SPEC: sview = "struct ScriptTestSpec:"
            FAILURE: sview = "struct ScriptTestFailure:"
            SESSION: sview = "struct ScriptTestSession:"
            NAME_ORDER: sview = "name_order: mutable darray[usize]"
            ERROR: sview = "error ScriptTestError:"
            VALIDATE_SPEC: sview = "def validate_script_test_spec("
            VALIDATE_SESSION: sview = "def validate_script_test_session("
            ADVANCE: sview = "def advance_script_test("
            SELECT: sview = "def select_script_test_session("
            DISCOVER_FILE_HANDLERS: sview = "def discover_elisascript_file_tests_with_handlers("
            DISCOVER_FILE: sview = "def discover_elisascript_file_tests("
            DISCOVER_SOURCE_HANDLERS: sview = "def discover_elisascript_source_tests_with_handlers("
            DISCOVER_SOURCE: sview = "def discover_elisascript_source_tests("
            DISCOVER_BYTES_HANDLERS: sview = "def discover_elisascript_source_bytes_tests_with_handlers("
            DISCOVER_BYTES: sview = "def discover_elisascript_source_bytes_tests("
            EXECUTION: sview = "struct ElisascriptTestExecution:"
            RUN: sview = "struct ElisascriptTestRun:"
            EXECUTE_TEST: sview = "def execute_elisascript_test("
            EXECUTE_FILE_HANDLERS: sview = "def execute_elisascript_file_tests_with_handlers("
            EXECUTE_FILE: sview = "def execute_elisascript_file_tests("
            EXECUTE_SOURCE_HANDLERS: sview = "def execute_elisascript_source_tests_with_handlers("
            EXECUTE_SOURCE: sview = "def execute_elisascript_source_tests("
            EXECUTE_BYTES_HANDLERS: sview = "def execute_elisascript_source_bytes_tests_with_handlers("
            EXECUTE_BYTES: sview = "def execute_elisascript_source_bytes_tests("
            BUILD_REPORT: sview = "def build_elisascript_test_report("
            TESTS_LIMIT: sview = "TESTS: usize = 4096"
            NAME_BYTES: sview = "NAME_BYTES"
            MESSAGE_BYTES: sview = "MESSAGE_BYTES"
            NO_ACTIVE: sview = "NO_ACTIVE"
            NAME_VALID: sview = "script_test_name_valid"
            MESSAGE_VALID: sview = "script_test_message_valid"
            DUPLICATE_NAME: sview = "DuplicateName"
            INVALID_CASE_STATE: sview = "InvalidCaseState"
            NO_TESTS: sview = "NoTests"
            CASE_NOT_READY: sview = "CaseNotReady"
            CASE_ORDER_INVALID: sview = "CaseOrderInvalid"
            CANCELLATION_NOT_READY: sview = "CancellationNotReady"
            FUNCTION_NOT_FOUND: sview = "FunctionNotFound"
            FUNCTION_SIGNATURE_INVALID: sview = "FunctionSignatureInvalid"
            NAME_INDEX_INVALID: sview = "NameIndexInvalid"
            SELECTION_LIMIT: sview = "SelectionLimitExceeded"
            SELECTION_INVALID: sview = "SelectionInvalid"
            DUPLICATE_SELECTION: sview = "DuplicateSelection"
            SELECTION_NOT_FOUND: sview = "SelectionNotFound"
            COUNTED_CANCELLED: sview = "counted_cancelled"
            CANCELLING_STATE: sview = "ScriptTestState.Cancelling"
            CANCELLED_STATE: sview = "ScriptTestState.Cancelled"
            PASSED_ACCOUNTING: sview = "session.passed != session.next_case"
            CANCEL_CASE: sview = "session.cases[index].state <- ScriptTestCaseState.Cancelled"
            VALIDATE_SESSION_CALL: sview = "try validate_script_test_session(session)"
            NAME_ORDER_COUNT: sview = "session.name_order.count != session.cases.count"
            NAME_ORDERED: sview = "script_test_name_less(session.cases[previous_index].name, session.cases[case_index].name)"
            NAME_ORDER_PUSH: sview = "session.name_order.push(new_case_index)"
            TEST_REMAINING_POLICY: sview = "elisascript_test_remaining_policy"
            RUNTIME_MESSAGE: sview = "elisascript_test_runtime_message"
            RUNTIME_STATUS: sview = "elisascript_test_runtime_status"
            ASSERTION_MAPPING: sview = "return \"Assertion\" if failure == InterpretError.Assertion"
            INVOCATION_CONTEXT_MAPPING: sview = "return \"InvocationContextUnavailable\" if failure == InterpretError.InvocationContextUnavailable"
            PANIC_STATUS: sview = "return OutputStatus.Crashed if failure == InterpretError.Panic"
            STEP_LIMIT_STATUS: sview = "return OutputStatus.TimedOut if failure == InterpretError.StepLimitExceeded"
            USAGE_ADD: sview = "elisascript_test_usage_add"
            CASE_BEGIN_STATE: sview = "cursor.state <- ElisascriptTestRunState.CaseBegin"
            CASE_FAIL_EVENT: sview = "ScriptTestEvent.CaseFail"
            CANCEL_ACK_EVENT: sview = "ScriptTestEvent.CancelAck"
            ERROR_KNOWN: sview = "result.runtime_error_known <- true"
            INVOCATION_CONTEXT: sview = "cursor.invocation_context"
            UNACCOUNTED_RESOURCES: sview = "runtime_resource_policy_has_unaccounted_dimensions"
            COMPLETED_CASE: sview = "successful completed-case"
            PUSH_EXECUTION: sview = "result.executions.push(ElisascriptTestExecution"
            SESSION_FROM_METADATA: sview = "elisascript_test_session_from_metadata"
            RUN_TEST_MODULE: sview = "elisascript_run_test_module"
            VALIDATE_TEST_RUN: sview = "elisascript_validate_test_run"
            REPORT_RECORD: sview = "elisascript_test_report_record"
            OUTPUT_BEGIN: sview = "OutputDocumentEvent.Begin"
            OUTPUT_SEAL: sview = "OutputDocumentEvent.Seal"
            TRAILING_CASES: sview = "trailing planned cases"
            STOPPED_AFTER_FAILURE: sview = "runner stopped after test failure"
            CANCELLED_BEFORE_LAUNCH: sview = "cancelled before launch"
            PASS_LIMITS_FUNCTION: sview = "def elisascript_record_pass_limits("
            PASS_LIMITS_BODY: sview = "            raise ScriptTestError.TestLimitExceeded if executions >= EsScriptTest::Limits::TESTS\n            raise InterpretError.OutputLimit if not elisascript_test_usage_add(usage, addition, policy)"
            INTERPRET_ERROR: sview = "error InterpretError:"
            INTERPRET_END: sview = "extend EsIr:"
            ERROR_MAPPING_PREFIX: sview = "return \""
            ERROR_MAPPING_MIDDLE: sview = "\" if failure == InterpretError."
            IR_IMPORT: sview = "include \"../runtime/script_test_model.elisa\""
            FIXTURE_USING: sview = "using EsScriptTest"
            FIXTURE_CONTRACT: sview = "typed_script_test_contract_discovers_ordered_cases_and_reports_outcomes"
            DISCOVER_EVENT: sview = "ScriptTestEvent.Discover"
            BEGIN_EVENT: sview = "ScriptTestEvent.Begin"
            CASE_BEGIN_EVENT: sview = "ScriptTestEvent.CaseBegin"
            CASE_PASS_EVENT: sview = "ScriptTestEvent.CasePass"
            CANCEL_EVENT: sview = "ScriptTestEvent.Cancel"
            FIXTURE_NO_TESTS: sview = "ScriptTestError.NoTests"
            FIXTURE_DUPLICATE_NAME: sview = "ScriptTestError.DuplicateName"
            FIXTURE_INVALID_CASE: sview = "ScriptTestError.InvalidCaseState"
            FIXTURE_CANCELLED_CASE: sview = "ScriptTestCaseState.Cancelled"
            FORGED_RUNNING: sview = "forged_running"
            FORGED_CANCELLED: sview = "forged_cancelled"
            TEST_NAME_INDEX_INVALID: sview = "NameIndexInvalid"
            SELECTION_CONTRACT: sview = "typed_script_test_selection_is_exact_transactional_and_source_ordered"
            SELECT_SESSION: sview = "select_script_test_session"
            NAME_ORDER_FIXTURE: sview = "name_order: [1, 0]"
            RUNNER_DISCOVER_FILE: sview = "runner_discovers_file_tests_without_requiring_main"
            DISCOVER_FILE_CALL: sview = "discover_elisascript_file_tests("
            EXECUTE_ONE_VOID: sview = "runner_executes_one_void_test_with_fresh_case_storage"
            EXECUTE_TEST_CALL: sview = "execute_elisascript_test("
            RUN_SOURCE_ORDER: sview = "runner_executes_file_tests_in_source_order_with_suite_budget"
            EXECUTE_FILE_CALL: sview = "execute_elisascript_file_tests("
            CANCEL_UNSTARTED: sview = "runner_cancels_unstarted_file_tests_at_state_machine_boundary"
            CANCEL_REQUESTED: sview = "cancel_requested: true"
            MAP_RUNTIME_FAILURE: sview = "runner_maps_runtime_failure_to_typed_case_diagnostic"
            PROJECT_PANIC_STEP: sview = "runner_projects_panic_and_step_budget_as_distinct_outcomes"
            RUNTIME_ASSERTION: sview = "runtime_error == InterpretError.Assertion"
            RUNTIME_PANIC: sview = "runtime_error == InterpretError.Panic"
            RUNTIME_STEP_LIMIT: sview = "runtime_error == InterpretError.StepLimitExceeded"
            OUTPUT_CRASHED: sview = "OutputStatus.Crashed"
            OUTPUT_TIMED_OUT: sview = "OutputStatus.TimedOut"
            SOURCE_BUFFER: sview = "runner_executes_source_buffer_tests_through_same_machine"
            SELECT_EXACT: sview = "runner_executes_only_exact_selected_tests_in_source_order"
            SELECTED_NAMES: sview = "selected_names: selected"
            EXECUTE_SOURCE_CALL: sview = "execute_elisascript_source_tests("
            EXECUTE_BYTES_CALL: sview = "execute_elisascript_source_bytes_tests("
            BUILD_REPORT_CALL: sview = "build_elisascript_test_report("
            OUTPUT_FAIL: sview = "OutputStatus.Fail"
            DOCS_MODEL: sview = "`EsScriptTest` supplies"
            DOCS_RUNNER: sview = "The runner"
            LEDGER_MODEL: sview = "ES-TEST-002 | `EsScriptTest`"
            LEDGER_RUNNER: sview = "ES-TEST-005 | runner discovery and single-case invocation"


        const module Messages:
            MISSING_ROOT: sview = "script test audit: missing repository root"
            UNRESOLVED_ROOT: sview = "script test audit: unable to resolve repository root"
            MISSING_INPUT: sview = "script test audit: missing "
            READ_FAILED: sview = "script test audit: unable to read source: "
            MISSING_VARIANTS: sview = "script test audit: missing InterpretError variants"
            MISSING_MAPPING: sview = "script test audit: missing test diagnostic mapping for InterpretError."
            SUCCESS: sview = "script test audit: bounded discovery, exact selection, ordered execution, failure diagnostics, and cancellation are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        const module ScanLimits:
            SOURCE_BYTES: usize = EsRuntime::FILE_STREAM_DEFAULT_MAX_BYTES
            LINE_BYTES: usize = 1048576
            PATH_BYTES: usize = 4095


        const enum InterpretErrorScanPhase of u8:
            FindHeader
            ReadVariants
            Done


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


        def declarations(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMITS},
                SearchCheck{input: inputs[0], pattern: Patterns::CASE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::TEST_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::TEST_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::SPEC},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILURE},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_SPEC},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::SELECT}
            ]


        def runner_declarations(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[1], pattern: Patterns::DISCOVER_FILE_HANDLERS},
                SearchCheck{input: inputs[1], pattern: Patterns::DISCOVER_FILE},
                SearchCheck{input: inputs[1], pattern: Patterns::DISCOVER_SOURCE_HANDLERS},
                SearchCheck{input: inputs[1], pattern: Patterns::DISCOVER_SOURCE},
                SearchCheck{input: inputs[1], pattern: Patterns::DISCOVER_BYTES_HANDLERS},
                SearchCheck{input: inputs[1], pattern: Patterns::DISCOVER_BYTES},
                SearchCheck{input: inputs[1], pattern: Patterns::EXECUTION},
                SearchCheck{input: inputs[1], pattern: Patterns::RUN},
                SearchCheck{input: inputs[1], pattern: Patterns::EXECUTE_TEST},
                SearchCheck{input: inputs[1], pattern: Patterns::EXECUTE_FILE_HANDLERS},
                SearchCheck{input: inputs[1], pattern: Patterns::EXECUTE_FILE},
                SearchCheck{input: inputs[1], pattern: Patterns::EXECUTE_SOURCE_HANDLERS},
                SearchCheck{input: inputs[1], pattern: Patterns::EXECUTE_SOURCE},
                SearchCheck{input: inputs[1], pattern: Patterns::EXECUTE_BYTES_HANDLERS},
                SearchCheck{input: inputs[1], pattern: Patterns::EXECUTE_BYTES},
                SearchCheck{input: inputs[1], pattern: Patterns::BUILD_REPORT}
            ]


        def model_boundaries(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::TESTS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::MESSAGE_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::NO_ACTIVE},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::MESSAGE_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_NAME},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_CASE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::NO_TESTS},
                SearchCheck{input: inputs[0], pattern: Patterns::CASE_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::CASE_ORDER_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLATION_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::FUNCTION_NOT_FOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::FUNCTION_SIGNATURE_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_INDEX_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::SELECTION_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::SELECTION_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_SELECTION},
                SearchCheck{input: inputs[0], pattern: Patterns::SELECTION_NOT_FOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::COUNTED_CANCELLED},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLING_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::PASSED_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_CASE},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_SESSION_CALL}
            ]


        def runner_contracts(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[1], pattern: Patterns::TEST_REMAINING_POLICY},
                SearchCheck{input: inputs[1], pattern: Patterns::RUNTIME_MESSAGE},
                SearchCheck{input: inputs[1], pattern: Patterns::RUNTIME_STATUS},
                SearchCheck{input: inputs[1], pattern: Patterns::ASSERTION_MAPPING},
                SearchCheck{input: inputs[1], pattern: Patterns::INVOCATION_CONTEXT_MAPPING},
                SearchCheck{input: inputs[1], pattern: Patterns::PANIC_STATUS},
                SearchCheck{input: inputs[1], pattern: Patterns::STEP_LIMIT_STATUS},
                SearchCheck{input: inputs[1], pattern: Patterns::USAGE_ADD},
                SearchCheck{input: inputs[1], pattern: Patterns::CASE_BEGIN_STATE},
                SearchCheck{input: inputs[1], pattern: Patterns::CASE_FAIL_EVENT},
                SearchCheck{input: inputs[1], pattern: Patterns::CANCEL_ACK_EVENT},
                SearchCheck{input: inputs[1], pattern: Patterns::ERROR_KNOWN},
                SearchCheck{input: inputs[1], pattern: Patterns::INVOCATION_CONTEXT},
                SearchCheck{input: inputs[1], pattern: Patterns::UNACCOUNTED_RESOURCES},
                SearchCheck{input: inputs[1], pattern: Patterns::COMPLETED_CASE},
                SearchCheck{input: inputs[1], pattern: Patterns::PUSH_EXECUTION},
                SearchCheck{input: inputs[1], pattern: Patterns::SESSION_FROM_METADATA},
                SearchCheck{input: inputs[1], pattern: Patterns::RUN_TEST_MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::VALIDATE_TEST_RUN},
                SearchCheck{input: inputs[1], pattern: Patterns::REPORT_RECORD},
                SearchCheck{input: inputs[1], pattern: Patterns::OUTPUT_BEGIN},
                SearchCheck{input: inputs[1], pattern: Patterns::OUTPUT_SEAL},
                SearchCheck{input: inputs[1], pattern: Patterns::TRAILING_CASES},
                SearchCheck{input: inputs[1], pattern: Patterns::STOPPED_AFTER_FAILURE},
                SearchCheck{input: inputs[1], pattern: Patterns::CANCELLED_BEFORE_LAUNCH}
            ]


        def audit_interpret_error_mappings(input_path: Path, runner_path: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            path_text: sview = f"{input_path}"
            path_length: usize = sview_len(path_text)
            if path_length == 0 or path_length > ScanLimits::PATH_BYTES:
                diagnostic(Messages::READ_FAILED + f"{input_path}")
                return ExitStatus::IO_FAILURE
            path_bytes: mutable darray[u8] = []
            for byte in path_text |path_bytes|:
                path_bytes.push(byte)
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr]

            stream: mutable FileStream = try file_stream_open(path_pointer, FileStreamMode.ReadBinary, ScanLimits::SOURCE_BYTES, FileStreamEncoding.Bytes) else err:
                diagnostic(Messages::READ_FAILED + f"{input_path}")
                return ExitStatus::IO_FAILURE
            phase: mutable InterpretErrorScanPhase = InterpretErrorScanPhase.FindHeader
            saw_enum: mutable bool = false
            saw_variant: mutable bool = false
            line: mutable darray[u8] = []
            identifier: Regex = regex("^[A-Za-z][A-Za-z0-9_]*$")
            machine over phase while phase != InterpretErrorScanPhase.Done:
                state Scan
                start Scan

                Scan, InterpretErrorScanPhase.FindHeader:
                    record: FileStreamRead = try file_stream_read_line(stream, line, ScanLimits::LINE_BYTES) else err:
                        _ = try file_stream_close(stream) else false
                        diagnostic(Messages::READ_FAILED + f"{input_path}")
                        return ExitStatus::IO_FAILURE
                    if record.eof and record.count == 0:
                        phase <- InterpretErrorScanPhase.Done
                        -> Scan
                    line_text: sview = bytes_view(line)
                    if line_text == Patterns::INTERPRET_ERROR:
                        saw_enum <- true
                        phase <- InterpretErrorScanPhase.ReadVariants
                    -> Scan

                Scan, InterpretErrorScanPhase.ReadVariants:
                    record: FileStreamRead = try file_stream_read_line(stream, line, ScanLimits::LINE_BYTES) else err:
                        _ = try file_stream_close(stream) else false
                        diagnostic(Messages::READ_FAILED + f"{input_path}")
                        return ExitStatus::IO_FAILURE
                    if record.eof and record.count == 0:
                        phase <- InterpretErrorScanPhase.Done
                        -> Scan
                    line_text: sview = bytes_view(line)
                    if line_text == Patterns::INTERPRET_END:
                        phase <- InterpretErrorScanPhase.Done
                        -> Scan
                    if line_text.startswith("    ") and not line_text.startswith("        "):
                        variant: sview = string_view_suffix(line_text, 4)
                        if identifier.search(variant):
                            saw_variant <- true
                            mapping: sview = Patterns::ERROR_MAPPING_PREFIX + variant + Patterns::ERROR_MAPPING_MIDDLE + variant
                            found: bool = try EsSourceFunctionScope::contains_file_line(runner_path, mapping) else err:
                                _ = try file_stream_close(stream) else false
                                diagnostic(Messages::READ_FAILED + f"{runner_path}")
                                return ExitStatus::IO_FAILURE
                            if not found:
                                _ = try file_stream_close(stream) else false
                                diagnostic(Messages::MISSING_MAPPING + f"{variant}")
                                return ExitStatus::FAILURE
                    -> Scan

                Scan, InterpretErrorScanPhase.Done:
                    break

            closed: bool = try file_stream_close(stream) else err:
                false
            if not closed:
                diagnostic(Messages::READ_FAILED + f"{input_path}")
                return ExitStatus::IO_FAILURE
            if not saw_enum or not saw_variant:
                diagnostic(Messages::MISSING_VARIANTS)
                return ExitStatus::FAILURE
            return 0i64


        def execute_all(inputs: darray[Path]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = execute([
                SearchCheck{input: inputs[2], pattern: Patterns::OUTPUT_MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::TEST_MODEL_IMPORT}
            ])
            return status if status != 0i64
            status <- execute(declarations(inputs))
            return status if status != 0i64
            status <- execute(runner_declarations(inputs))
            return status if status != 0i64
            status <- execute(model_boundaries(inputs))
            return status if status != 0i64
            status <- execute([
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_ORDER_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_ORDERED},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_ORDER_PUSH}
            ])
            return status if status != 0i64
            status <- execute(runner_contracts(inputs))
            return status if status != 0i64
            body: EsSourceFunctionScope::FunctionBody = try EsSourceFunctionScope::read_function_body(inputs[1], Patterns::PASS_LIMITS_FUNCTION) else err:
                diagnostic(Messages::READ_FAILED + f"{inputs[1]}")
                return ExitStatus::IO_FAILURE
            return ExitStatus::FAILURE if not body.found or body.text.index(Patterns::PASS_LIMITS_BODY) < 0
            status <- audit_interpret_error_mappings(inputs[6], inputs[1])
            return status if status != 0i64
            status <- execute([
                SearchCheck{input: inputs[3], pattern: Patterns::IR_IMPORT},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_USING},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[4], pattern: Patterns::DISCOVER_EVENT},
                SearchCheck{input: inputs[4], pattern: Patterns::BEGIN_EVENT},
                SearchCheck{input: inputs[4], pattern: Patterns::CASE_BEGIN_EVENT},
                SearchCheck{input: inputs[4], pattern: Patterns::CASE_PASS_EVENT},
                SearchCheck{input: inputs[4], pattern: Patterns::CASE_FAIL_EVENT},
                SearchCheck{input: inputs[4], pattern: Patterns::CANCEL_EVENT},
                SearchCheck{input: inputs[4], pattern: Patterns::CANCEL_ACK_EVENT},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_NO_TESTS},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_DUPLICATE_NAME},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_INVALID_CASE},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_CANCELLED_CASE},
                SearchCheck{input: inputs[4], pattern: Patterns::FORGED_RUNNING},
                SearchCheck{input: inputs[4], pattern: Patterns::FORGED_CANCELLED},
                SearchCheck{input: inputs[4], pattern: Patterns::TEST_NAME_INDEX_INVALID},
                SearchCheck{input: inputs[4], pattern: Patterns::SELECTION_CONTRACT},
                SearchCheck{input: inputs[4], pattern: Patterns::SELECT_SESSION},
                SearchCheck{input: inputs[4], pattern: Patterns::NAME_ORDER_FIXTURE},
                SearchCheck{input: inputs[5], pattern: Patterns::RUNNER_DISCOVER_FILE},
                SearchCheck{input: inputs[5], pattern: Patterns::DISCOVER_FILE_CALL},
                SearchCheck{input: inputs[5], pattern: Patterns::EXECUTE_ONE_VOID},
                SearchCheck{input: inputs[5], pattern: Patterns::EXECUTE_TEST_CALL},
                SearchCheck{input: inputs[5], pattern: Patterns::FUNCTION_SIGNATURE_INVALID},
                SearchCheck{input: inputs[5], pattern: Patterns::RUN_SOURCE_ORDER},
                SearchCheck{input: inputs[5], pattern: Patterns::EXECUTE_FILE_CALL},
                SearchCheck{input: inputs[5], pattern: Patterns::CANCEL_UNSTARTED},
                SearchCheck{input: inputs[5], pattern: Patterns::CANCEL_REQUESTED},
                SearchCheck{input: inputs[5], pattern: Patterns::MAP_RUNTIME_FAILURE},
                SearchCheck{input: inputs[5], pattern: Patterns::PROJECT_PANIC_STEP},
                SearchCheck{input: inputs[5], pattern: Patterns::RUNTIME_ASSERTION},
                SearchCheck{input: inputs[5], pattern: Patterns::RUNTIME_PANIC},
                SearchCheck{input: inputs[5], pattern: Patterns::RUNTIME_STEP_LIMIT},
                SearchCheck{input: inputs[5], pattern: Patterns::OUTPUT_CRASHED},
                SearchCheck{input: inputs[5], pattern: Patterns::OUTPUT_TIMED_OUT},
                SearchCheck{input: inputs[5], pattern: Patterns::STOPPED_AFTER_FAILURE},
                SearchCheck{input: inputs[5], pattern: Patterns::CANCELLED_BEFORE_LAUNCH},
                SearchCheck{input: inputs[5], pattern: Patterns::SOURCE_BUFFER},
                SearchCheck{input: inputs[5], pattern: Patterns::SELECT_EXACT},
                SearchCheck{input: inputs[5], pattern: Patterns::SELECTED_NAMES},
                SearchCheck{input: inputs[5], pattern: Patterns::EXECUTE_SOURCE_CALL},
                SearchCheck{input: inputs[5], pattern: Patterns::EXECUTE_BYTES_CALL},
                SearchCheck{input: inputs[5], pattern: Patterns::BUILD_REPORT_CALL},
                SearchCheck{input: inputs[5], pattern: Patterns::OUTPUT_FAIL},
                SearchCheck{input: inputs[7], pattern: Patterns::DOCS_MODEL},
                SearchCheck{input: inputs[7], pattern: Patterns::DOCS_RUNNER},
                SearchCheck{input: inputs[8], pattern: Patterns::LEDGER_MODEL},
                SearchCheck{input: inputs[8], pattern: Patterns::LEDGER_RUNNER}
            ])
            return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::RUNNER),
                root.joinpath(Inputs::EXECUTION),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::RUNNER_FIXTURE),
                root.joinpath(Inputs::INTERPRET),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            required_inputs: darray[Path] = [
                inputs[0], inputs[1], inputs[2], inputs[3], inputs[4],
                inputs[5], inputs[6], inputs[7], inputs[8]
            ]
            for input_path in required_inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE
            status: i64 = execute_all(inputs)
            return status if status != 0i64
            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsScriptTestAudit::run_default()
