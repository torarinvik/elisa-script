# Companion orchestration for neural-computer-agentV2's curated-artifact check.
# AWK validation is implemented in Elisa; shasum remains an explicit hash tool.
include "../src/runtime/bounded_text_posix.elisa"
include "../src/runtime/checksum_manifest_model.elisa"

module EsCuratedArtifactCheck:
    private:
        const module Inputs:
            MANIFEST: sview = "artifacts/manifests/curated_checkpoints.sha256"
            EMPTY_MESSAGE: sview = "No curated checkpoints are currently registered."
            TIMEOUT_MICROS: i64 = 0


        const enum Phase of u8:
            EnterRoot
            Inspect
            Read
            Validate
            Verify


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr("curated artifact check: " + message + "\n")

    public:
        def run_root(project_root: Path) -> i64 can[Directory.Write, File.Read, Process.Run, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
            phase: mutable Phase = Phase.EnterRoot
            manifest: Path = path(Inputs::MANIFEST)
            contents: mutable sview = ""
            machine over phase:
                state Dispatch
                start Dispatch

                Dispatch, Phase.EnterRoot:
                    changed: bool = try change_directory(project_root) else err:
                        diagnostic("unable to enter project root")
                        return 1i64
                    if not changed:
                        diagnostic("unable to enter project root")
                        return 1i64
                    phase <- Phase.Inspect
                    -> Dispatch

                Dispatch, Phase.Inspect:
                    # Bash's -s predicate is false for absent/empty inputs and
                    # failed metadata lookup; these are not read errors yet.
                    size: usize = try file_size(manifest) else 0usize
                    if size == 0:
                        print(Inputs::EMPTY_MESSAGE)
                        return 0i64
                    if size > EsChecksumManifest::Limits::INPUT_BYTES:
                        diagnostic("manifest exceeds input limit")
                        return 2i64
                    phase <- Phase.Read
                    -> Dispatch

                Dispatch, Phase.Read:
                    contents <- try EsBoundedText::read_utf8(manifest, EsChecksumManifest::Limits::INPUT_BYTES) else err:
                        diagnostic("unable to read bounded UTF-8 manifest")
                        return 2i64
                    phase <- Phase.Validate
                    -> Dispatch

                Dispatch, Phase.Validate:
                    issues: darray[usize] = try EsChecksumManifest::invalid_lines(contents) else err:
                        diagnostic("manifest record or issue limit exceeded")
                        return 2i64
                    for line in issues:
                        _ = write_stderr(f"invalid checksum manifest line {line}\n")
                    return 1i64 if issues.count > 0
                    phase <- Phase.Verify
                    -> Dispatch

                Dispatch, Phase.Verify:
                    # Preserve PATH lookup, inherited streams/environment,
                    # exact argv, and ordinary checksum-tool exit statuses.
                    return try run_process(exe"shasum", ["-a", "256", "-c", Inputs::MANIFEST], Inputs::TIMEOUT_MICROS) else err:
                        diagnostic("unable to run shasum")
                        return 1i64
            return 1i64


        def run_default() -> i64 can[Directory.Write, File.Read, Process.Run, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
            script_directory: Path = try path_real(path_parent(Script::source_path())) else err:
                diagnostic("unable to resolve script directory")
                return 1i64
            project_root: Path = script_directory.parent().parent().joinpath("neural-computer-agentV2")
            return run_root(project_root)


def main(arguments: darray[sview]) -> i64 can[Directory.Write, File.Read, Process.Run, Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
    _ = arguments
    return EsCuratedArtifactCheck::run_default()
