# Bounded Elisascript port of check_process_termination.sh.
# Source contracts retain their ripgrep-style line-regex checks through the
# shared bounded scanner, including the forbidden Poll declaration.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsProcessTerminationAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/process_termination_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsProcessTermination:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/process_termination_model\.elisa\""
            PROCESS_TERMINATION_STATE: Regex = regex"const enum ProcessTerminationState of u8"
            PROCESS_TERMINATION_EVENT: Regex = regex"const enum ProcessTerminationEvent of u8"
            POLICY: Regex = regex"struct ProcessTerminationPolicy:"
            MEMBER: Regex = regex"struct ProcessTerminationMember:"
            SESSION: Regex = regex"struct ProcessTerminationSession:"
            ERROR: Regex = regex"error ProcessTerminationError:"
            VALIDATE: Regex = regex"def validate_process_termination\("
            ADVANCE: Regex = regex"def advance_process_termination\("
            FORBIDDEN_POLL: Regex = regex"^[[:space:]]+Poll$"
            LIMIT_MEMBERS: Regex = regex"Limits::MEMBERS"
            LIMIT_POLLS: Regex = regex"Limits::POLLS"
            LIMIT_FORCE_ATTEMPTS: Regex = regex"Limits::FORCE_ATTEMPTS"
            START_TOKEN: Regex = regex"start_token"
            ROOT_NOT_OWNED: Regex = regex"RootNotOwned"
            REQUEST_GRACEFUL: Regex = regex"ProcessTerminationEvent.RequestGraceful"
            GRACEFUL_ACK: Regex = regex"ProcessTerminationEvent.GracefulAck"
            REQUEST_FORCE: Regex = regex"ProcessTerminationEvent.RequestForce"
            FORCE_ACK: Regex = regex"ProcessTerminationEvent.ForceAck"
            REAP_BATCH: Regex = regex"struct ProcessTerminationReapBatch:"
            SORT_REAP_IDENTITIES: Regex = regex"process_termination_sort_reap_identities"
            REPORT_REAPS: Regex = regex"def report_process_termination_reaps\("
            IDENTITY: Regex = regex"struct ProcessTerminationIdentity:"
            IDENTITY_VALID: Regex = regex"process_termination_identity_valid"
            EXPECTED_MEMBER_REAPED: Regex = regex"expected_member.reaped"
            MARK_MEMBER_REAPED: Regex = regex"session.members\[member_index\].reaped <- true"
            CANONICALIZE_MEMBERS: Regex = regex"canonicalize_process_termination_members"
            SORT_MEMBERS: Regex = regex"process_termination_sort_members"
            SIFT_MEMBERS: Regex = regex"process_termination_sift_members"
            MEMBER_INDEX: Regex = regex"process_termination_member_index"
            MEMBER_ORDER_INVALID: Regex = regex"ProcessTerminationError.MemberOrderInvalid"
            REAP_COUNT_INVALID: Regex = regex"ProcessTerminationError.ReapCountInvalid"
            RECORD_POLLS: Regex = regex"def record_process_termination_polls\("
            POLL_COUNT_BOUND: Regex = regex"poll_count > session.policy.max_polls - session.polls"
            REAP_IDENTITY_INVALID: Regex = regex"ProcessTerminationError.ReapIdentityInvalid"
            REAP_BATCH_EMPTY: Regex = regex"ProcessTerminationError.ReapBatchEmpty"
            REAP_BATCH_TOO_LARGE: Regex = regex"ProcessTerminationError.ReapBatchTooLarge"
            REAPED_COUNT: Regex = regex"reaped_count"
            PLANNED_STATE: Regex = regex"ProcessTerminationState.Planned and"
            RUNNING_STATE: Regex = regex"ProcessTerminationState.Running and"
            GRACEFUL_REQUESTED_STATE: Regex = regex"session.state == ProcessTerminationState.GracefulRequested and \(session.polls != 0 or session.force_attempts != 0 or session.reaped_members != 0\)"
            GRACEFUL_WAITING_STATE: Regex = regex"session.state == ProcessTerminationState.GracefulWaiting and \(session.force_attempts != 0 or session.reaped_members != 0\)"
            FORCE_REQUESTED_STATE: Regex = regex"session.state == ProcessTerminationState.ForceRequested and session.force_attempts == 0"
            REAPED_STATE: Regex = regex"session.state == ProcessTerminationState.Reaped"
            POLL_LIMIT_EXCEEDED: Regex = regex"ProcessTerminationError.PollLimitExceeded"
            POLL_BATCH_EMPTY: Regex = regex"ProcessTerminationError.PollBatchEmpty"
            FORCE_LIMIT_EXCEEDED: Regex = regex"ProcessTerminationError.ForceLimitExceeded"
            FIXTURE_IMPORT: Regex = regex"using EsProcessTermination"
            FIXTURE_CONTRACT: Regex = regex"typed_process_termination_contract_bounds_escalation_and_reaping"
            FIXTURE_REQUEST_GRACEFUL: Regex = regex"ProcessTerminationEvent.RequestGraceful"
            FIXTURE_REQUEST_FORCE: Regex = regex"ProcessTerminationEvent.RequestForce"
            RECORD_THREE_POLLS: Regex = regex"record_process_termination_polls\(session, 3\)"
            PREMATURE_POLL: Regex = regex"premature_poll_batch"
            EMPTY_POLL: Regex = regex"empty_poll_batch"
            EXCESSIVE_POLL: Regex = regex"excessive_poll_batch"
            TIMEOUT_SESSION: Regex = regex"timeout_session"
            FIXTURE_TIMEOUT: Regex = regex"ProcessTerminationEvent.Timeout"
            TIMED_OUT_STATE: Regex = regex"ProcessTerminationState.TimedOut"
            FIXTURE_REPORT_REAPS: Regex = regex"report_process_termination_reaps"
            REAP_BATCH_MEMBER: Regex = regex"ProcessTerminationReapBatch\{members: \[ProcessTerminationIdentity\{pid: 103, start_token: 3\}"
            WRONG_GENERATION: Regex = regex"wrong_generation"
            UNKNOWN_MEMBER: Regex = regex"unknown_member"
            BAD_MIXED_BATCH: Regex = regex"bad_mixed_batch"
            DUPLICATE_IN_BATCH: Regex = regex"duplicate_in_batch"
            EMPTY_REAP_BATCH: Regex = regex"empty_reap_batch"
            OVERSIZED_REAP_BATCH: Regex = regex"oversized_reap_batch"
            DUPLICATE_REAP: Regex = regex"duplicate_reap"
            FORGED_REAP_COUNT: Regex = regex"forged_reap_count"
            IMPOSSIBLE_GRACEFUL_REAP: Regex = regex"impossible_graceful_reap"
            GRACEFUL_POLL: Regex = regex"graceful_poll"
            WAITING_FORCE_ATTEMPT: Regex = regex"waiting_force_attempt"
            FORCE_WITHOUT_ATTEMPT: Regex = regex"force_without_attempt"
            FIXTURE_MEMBER_REAPED: Regex = regex"session.members\[1\].reaped"
            FIXTURE_CANCEL: Regex = regex"ProcessTerminationEvent.Cancel"
            FIXTURE_CANONICALIZE: Regex = regex"canonicalize_process_termination_members"
            FIXTURE_MEMBER_ORDER_INVALID: Regex = regex"ProcessTerminationError.MemberOrderInvalid"
            DUPLICATE_MEMBER: Regex = regex"ProcessTerminationError.DuplicateMember"
            FIXTURE_REAP_IDENTITY_INVALID: Regex = regex"ProcessTerminationError.ReapIdentityInvalid"
            FIXTURE_POLL_BATCH_EMPTY: Regex = regex"ProcessTerminationError.PollBatchEmpty"
            FIXTURE_POLL_LIMIT_EXCEEDED: Regex = regex"ProcessTerminationError.PollLimitExceeded"
            INVALID_TRANSITION: Regex = regex"ProcessTerminationError.InvalidTransition"
            FIXTURE_REAP_BATCH_EMPTY: Regex = regex"ProcessTerminationError.ReapBatchEmpty"
            FIXTURE_REAP_BATCH_TOO_LARGE: Regex = regex"ProcessTerminationError.ReapBatchTooLarge"
            ACCOUNTING_INVALID: Regex = regex"ProcessTerminationError.AccountingInvalid"
            DOCS_SESSION: Regex = regex"EsProcessTermination::ProcessTerminationSession"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-037"


        const module Messages:
            MISSING_ROOT: sview = "process termination audit: missing repository root"
            UNRESOLVED_ROOT: sview = "process termination audit: unable to resolve repository root"
            MISSING_INPUT: sview = "process termination audit: missing "
            READ_FAILED: sview = "process termination audit: unable to read source: "
            SUCCESS: sview = "process termination audit: bounded membership, batched polls, and identity-bound graceful/force reaping are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        const enum Expectation of u8:
            Present
            Absent


        struct SearchCheck:
            input: Path
            pattern: Regex
            expectation: Expectation = Expectation.Present


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::PROCESS_TERMINATION_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::PROCESS_TERMINATION_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::MEMBER},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::FORBIDDEN_POLL, expectation: Expectation.Absent},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMIT_MEMBERS},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMIT_POLLS},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMIT_FORCE_ATTEMPTS},
                SearchCheck{input: inputs[0], pattern: Patterns::START_TOKEN},
                SearchCheck{input: inputs[0], pattern: Patterns::ROOT_NOT_OWNED},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST_GRACEFUL},
                SearchCheck{input: inputs[0], pattern: Patterns::GRACEFUL_ACK},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST_FORCE},
                SearchCheck{input: inputs[0], pattern: Patterns::FORCE_ACK},
                SearchCheck{input: inputs[0], pattern: Patterns::REAP_BATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::SORT_REAP_IDENTITIES},
                SearchCheck{input: inputs[0], pattern: Patterns::REPORT_REAPS},
                SearchCheck{input: inputs[0], pattern: Patterns::IDENTITY},
                SearchCheck{input: inputs[0], pattern: Patterns::IDENTITY_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPECTED_MEMBER_REAPED},
                SearchCheck{input: inputs[0], pattern: Patterns::MARK_MEMBER_REAPED},
                SearchCheck{input: inputs[0], pattern: Patterns::CANONICALIZE_MEMBERS},
                SearchCheck{input: inputs[0], pattern: Patterns::SORT_MEMBERS},
                SearchCheck{input: inputs[0], pattern: Patterns::SIFT_MEMBERS},
                SearchCheck{input: inputs[0], pattern: Patterns::MEMBER_INDEX},
                SearchCheck{input: inputs[0], pattern: Patterns::MEMBER_ORDER_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::REAP_COUNT_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_POLLS},
                SearchCheck{input: inputs[0], pattern: Patterns::POLL_COUNT_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::REAP_IDENTITY_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::REAP_BATCH_EMPTY},
                SearchCheck{input: inputs[0], pattern: Patterns::REAP_BATCH_TOO_LARGE},
                SearchCheck{input: inputs[0], pattern: Patterns::REAPED_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::RUNNING_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::GRACEFUL_REQUESTED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::GRACEFUL_WAITING_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::FORCE_REQUESTED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::REAPED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::POLL_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::POLL_BATCH_EMPTY},
                SearchCheck{input: inputs[0], pattern: Patterns::FORCE_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_REQUEST_GRACEFUL},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_REQUEST_FORCE},
                SearchCheck{input: inputs[2], pattern: Patterns::RECORD_THREE_POLLS},
                SearchCheck{input: inputs[2], pattern: Patterns::PREMATURE_POLL},
                SearchCheck{input: inputs[2], pattern: Patterns::EMPTY_POLL},
                SearchCheck{input: inputs[2], pattern: Patterns::EXCESSIVE_POLL},
                SearchCheck{input: inputs[2], pattern: Patterns::TIMEOUT_SESSION},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_TIMEOUT},
                SearchCheck{input: inputs[2], pattern: Patterns::TIMED_OUT_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_REPORT_REAPS},
                SearchCheck{input: inputs[2], pattern: Patterns::REAP_BATCH_MEMBER},
                SearchCheck{input: inputs[2], pattern: Patterns::WRONG_GENERATION},
                SearchCheck{input: inputs[2], pattern: Patterns::UNKNOWN_MEMBER},
                SearchCheck{input: inputs[2], pattern: Patterns::BAD_MIXED_BATCH},
                SearchCheck{input: inputs[2], pattern: Patterns::DUPLICATE_IN_BATCH},
                SearchCheck{input: inputs[2], pattern: Patterns::EMPTY_REAP_BATCH},
                SearchCheck{input: inputs[2], pattern: Patterns::OVERSIZED_REAP_BATCH},
                SearchCheck{input: inputs[2], pattern: Patterns::DUPLICATE_REAP},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_REAP_COUNT},
                SearchCheck{input: inputs[2], pattern: Patterns::IMPOSSIBLE_GRACEFUL_REAP},
                SearchCheck{input: inputs[2], pattern: Patterns::GRACEFUL_POLL},
                SearchCheck{input: inputs[2], pattern: Patterns::WAITING_FORCE_ATTEMPT},
                SearchCheck{input: inputs[2], pattern: Patterns::FORCE_WITHOUT_ATTEMPT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_MEMBER_REAPED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CANCEL},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CANONICALIZE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_MEMBER_ORDER_INVALID},
                SearchCheck{input: inputs[2], pattern: Patterns::DUPLICATE_MEMBER},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_REAP_IDENTITY_INVALID},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_POLL_BATCH_EMPTY},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_POLL_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[2], pattern: Patterns::INVALID_TRANSITION},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_REAP_BATCH_EMPTY},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_REAP_BATCH_TOO_LARGE},
                SearchCheck{input: inputs[2], pattern: Patterns::ACCOUNTING_INVALID},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                found: mutable bool = try EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return ExitStatus::IO_FAILURE

                match check.expectation:
                    Expectation.Present:
                        return ExitStatus::FAILURE if not found
                    Expectation.Absent:
                        return ExitStatus::FAILURE if found
                    _:
                        return ExitStatus::FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsProcessTerminationAudit::run_default()
