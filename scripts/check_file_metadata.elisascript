# Bounded Elisascript port of check_file_metadata.sh.
# Mixed regex and fixed-string source checks stream through the shared scanner.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsFileMetadataAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/file_metadata_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module RegexPatterns:
            MODULE: Regex = regex"^module EsFileMetadata:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/file_metadata_model\.elisa\""
            LIMITS: Regex = regex"const module Limits:"
            KIND: Regex = regex"const enum FileMetadataKind of u8"
            STATE: Regex = regex"const enum FileMetadataState of u8"
            EVENT: Regex = regex"const enum FileMetadataEvent of u8"
            POLICY: Regex = regex"struct FileMetadataPolicy:"
            ENTRY: Regex = regex"struct FileMetadataEntry:"
            SIZE: Regex = regex"size: u64"
            SNAPSHOT: Regex = regex"struct FileMetadataSnapshot:"
            ERROR: Regex = regex"error FileMetadataError:"
            VALIDATE: Regex = regex"def validate_file_metadata_snapshot\("
            LOOKUP: Regex = regex"def file_metadata_lookup\("
            ADVANCE: Regex = regex"def advance_file_metadata\("
            FIXTURE_IMPORT: Regex = regex"using EsFileMetadata"
            FIXTURE_CONTRACT: Regex = regex"typed_file_metadata_contract_is_bounded_and_symlink_explicit"
            FIXTURE_SYMLINK: Regex = regex"FileMetadataKind.Symlink"
            FIXTURE_MISSING: Regex = regex"FileMetadataKind.Missing"
            FIXTURE_LOOKUP: Regex = regex"file_metadata_lookup"
            FIXTURE_DUPLICATE: Regex = regex"FileMetadataError.DuplicatePath"
            FIXTURE_SYMLINK_ERROR: Regex = regex"FileMetadataError.SymlinkTargetInvalid"
            FIXTURE_NUL: Regex = regex"FileMetadataError.EmbeddedNul"
            FIXTURE_ACCOUNTING: Regex = regex"FileMetadataError.AccountingInvalid"
            FIXTURE_FORGED_MISSING: Regex = regex"forged_missing_metadata"
            DOCS_SNAPSHOT: Regex = regex"EsFileMetadata::FileMetadataSnapshot"
            LEDGER_ITEM: Regex = regex"ES-FS-002"


        const module LiteralPatterns:
            ENTRY_LIMIT: sview = "Limits::ENTRIES"
            PATH_BYTES: sview = "Limits::PATH_BYTES"
            TARGET_BYTES: sview = "Limits::TARGET_BYTES"
            TOTAL_BYTES: sview = "Limits::TOTAL_BYTES"
            INDEX: sview = "file_metadata_index"
            ALLOW_MISSING: sview = "allow_missing"
            PRESERVE_SYMLINK: sview = "preserve_symlink"
            ENTRY_NUL: sview = "raise FileMetadataError.EmbeddedNul if sview_contains_byte(entry.path, 0) or sview_contains_byte(entry.target, 0)"
            PATH_NUL: sview = "raise FileMetadataError.EmbeddedNul if sview_contains_byte(path, 0)"
            SYMLINK_KIND: sview = "FileMetadataKind.Symlink"
            MISSING_KIND: sview = "FileMetadataKind.Missing"
            MISSING_IDENTITY: sview = "raise FileMetadataError.InvalidIdentity if entry.kind == FileMetadataKind.Missing and (entry.inode != 0 or entry.device != 0 or entry.link_count != 0)"
            MISSING_SIZE: sview = "raise FileMetadataError.InvalidSize if entry.kind == FileMetadataKind.Missing and entry.size != 0"
            MISSING_MODE: sview = "entry.kind == FileMetadataKind.Missing and (entry.mode != 0"
            DUPLICATE_PATH: sview = "FileMetadataError.DuplicatePath"
            INVALID_IDENTITY: sview = "FileMetadataError.InvalidIdentity"
            INVALID_SYMLINK_TARGET: sview = "FileMetadataError.SymlinkTargetInvalid"
            ACCOUNTING: sview = "FileMetadataError.AccountingInvalid"
            PLANNED: sview = "FileMetadataState.Planned and"
            ENTRY_EVENT: sview = "FileMetadataEvent.Entry"
            SEALED: sview = "FileMetadataState.Sealed"
            OVERSIZED_FILE: sview = "entry.size > Limits::TOTAL_BYTES"
            LARGE_SIZE_TEST: sview = "file_metadata_preserves_large_file_size_without_charging_metadata_budget"
            LARGE_SIZE_FIXTURE: sview = "size: 67108865u64"


        const module Messages:
            MISSING_ROOT: sview = "file metadata audit: missing repository root"
            UNRESOLVED_ROOT: sview = "file metadata audit: unable to resolve repository root"
            MISSING_INPUT: sview = "file metadata audit: missing "
            READ_FAILED: sview = "file metadata audit: unable to read source: "
            SIZE_CONFUSION: sview = "file metadata audit: file size must not be conflated with path/target text bytes"
            SUCCESS: sview = "file metadata audit: bounded stat/lstat shape, symlink policy, and lookup are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct RegexCheck:
            input: Path
            pattern: Regex


        struct LiteralCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def regex_checks(checks: darray[RegexCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


        def literal_checks(checks: darray[LiteralCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


        def model_regex_checks(model: Path, ir: Path) -> darray[RegexCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                RegexCheck{input: model, pattern: RegexPatterns::MODULE},
                RegexCheck{input: ir, pattern: RegexPatterns::MODEL_IMPORT},
                RegexCheck{input: model, pattern: RegexPatterns::LIMITS},
                RegexCheck{input: model, pattern: RegexPatterns::KIND},
                RegexCheck{input: model, pattern: RegexPatterns::STATE},
                RegexCheck{input: model, pattern: RegexPatterns::EVENT},
                RegexCheck{input: model, pattern: RegexPatterns::POLICY},
                RegexCheck{input: model, pattern: RegexPatterns::ENTRY},
                RegexCheck{input: model, pattern: RegexPatterns::SIZE},
                RegexCheck{input: model, pattern: RegexPatterns::SNAPSHOT},
                RegexCheck{input: model, pattern: RegexPatterns::ERROR},
                RegexCheck{input: model, pattern: RegexPatterns::VALIDATE},
                RegexCheck{input: model, pattern: RegexPatterns::LOOKUP},
                RegexCheck{input: model, pattern: RegexPatterns::ADVANCE}
            ]


        def model_literal_checks(model: Path) -> darray[LiteralCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                LiteralCheck{input: model, pattern: LiteralPatterns::ENTRY_LIMIT},
                LiteralCheck{input: model, pattern: LiteralPatterns::PATH_BYTES},
                LiteralCheck{input: model, pattern: LiteralPatterns::TARGET_BYTES},
                LiteralCheck{input: model, pattern: LiteralPatterns::TOTAL_BYTES},
                LiteralCheck{input: model, pattern: LiteralPatterns::INDEX},
                LiteralCheck{input: model, pattern: LiteralPatterns::ALLOW_MISSING},
                LiteralCheck{input: model, pattern: LiteralPatterns::PRESERVE_SYMLINK},
                LiteralCheck{input: model, pattern: LiteralPatterns::ENTRY_NUL},
                LiteralCheck{input: model, pattern: LiteralPatterns::PATH_NUL},
                LiteralCheck{input: model, pattern: LiteralPatterns::SYMLINK_KIND},
                LiteralCheck{input: model, pattern: LiteralPatterns::MISSING_KIND},
                LiteralCheck{input: model, pattern: LiteralPatterns::MISSING_IDENTITY},
                LiteralCheck{input: model, pattern: LiteralPatterns::MISSING_SIZE},
                LiteralCheck{input: model, pattern: LiteralPatterns::MISSING_MODE},
                LiteralCheck{input: model, pattern: LiteralPatterns::DUPLICATE_PATH},
                LiteralCheck{input: model, pattern: LiteralPatterns::INVALID_IDENTITY},
                LiteralCheck{input: model, pattern: LiteralPatterns::INVALID_SYMLINK_TARGET},
                LiteralCheck{input: model, pattern: LiteralPatterns::ACCOUNTING},
                LiteralCheck{input: model, pattern: LiteralPatterns::PLANNED},
                LiteralCheck{input: model, pattern: LiteralPatterns::ENTRY_EVENT},
                LiteralCheck{input: model, pattern: LiteralPatterns::SEALED}
            ]


        def fixture_regex_checks(fixture: Path) -> darray[RegexCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                RegexCheck{input: fixture, pattern: RegexPatterns::FIXTURE_IMPORT},
                RegexCheck{input: fixture, pattern: RegexPatterns::FIXTURE_CONTRACT},
                RegexCheck{input: fixture, pattern: RegexPatterns::FIXTURE_SYMLINK},
                RegexCheck{input: fixture, pattern: RegexPatterns::FIXTURE_MISSING},
                RegexCheck{input: fixture, pattern: RegexPatterns::FIXTURE_LOOKUP},
                RegexCheck{input: fixture, pattern: RegexPatterns::FIXTURE_DUPLICATE},
                RegexCheck{input: fixture, pattern: RegexPatterns::FIXTURE_SYMLINK_ERROR},
                RegexCheck{input: fixture, pattern: RegexPatterns::FIXTURE_NUL},
                RegexCheck{input: fixture, pattern: RegexPatterns::FIXTURE_ACCOUNTING},
                RegexCheck{input: fixture, pattern: RegexPatterns::FIXTURE_FORGED_MISSING}
            ]


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: mutable i64 = regex_checks(model_regex_checks(inputs[0], inputs[1]))
            return status if status != 0i64
            status <- literal_checks(model_literal_checks(inputs[0]))
            return status if status != 0i64

            catch EsSourceFunctionScope::contains_file_line(inputs[0], LiteralPatterns::OVERSIZED_FILE):
                ok found:
                    if found:
                        diagnostic(Messages::SIZE_CONFUSION)
                        return ExitStatus::FAILURE
                error _:
                    diagnostic(Messages::READ_FAILED + f"{inputs[0]}")
                    return ExitStatus::IO_FAILURE

            status <- regex_checks(fixture_regex_checks(inputs[2]))
            return status if status != 0i64
            extra_fixture_checks: darray[LiteralCheck] = [
                LiteralCheck{input: inputs[2], pattern: LiteralPatterns::LARGE_SIZE_TEST},
                LiteralCheck{input: inputs[2], pattern: LiteralPatterns::LARGE_SIZE_FIXTURE}
            ]
            status <- literal_checks(extra_fixture_checks)
            return status if status != 0i64

            final_checks: darray[RegexCheck] = [
                RegexCheck{input: inputs[3], pattern: RegexPatterns::DOCS_SNAPSHOT},
                RegexCheck{input: inputs[4], pattern: RegexPatterns::LEDGER_ITEM}
            ]
            status <- regex_checks(final_checks)
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsFileMetadataAudit::run_default()
