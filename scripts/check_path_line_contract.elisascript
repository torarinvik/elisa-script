# Elisascript port of check_path_line_contract.sh.
# Keep the shell oracle until its public-launcher parity contract is qualified.
# The typed runner keeps the original ordered rg expressions and their two
# case-insensitive searches, without a shell wrapper or hand-reimplemented ERE.

include "./shell_invocation_path.elisascript"

module EsPathLineContractAudit:
    private:
        const module Inputs:
            LOWERER: sview = "src/ir/lower_ast.elisa"
            INTERPRETER: sview = "src/ir/interpret.elisa"
            BYTECODE: sview = "src/bytecode/bytecode.elisa"
            LOWERING_TESTS: sview = "test/ir/elisascript_lowering_test.elisa"
            SOURCE_TESTS: sview = "test/ir/elisascript_source_test.elisa"
            INTERPRETER_TESTS: sview = "test/ir/elisascript_interpreter_test.elisa"
            BYTECODE_TESTS: sview = "test/ir/elisascript_bytecode_test.elisa"
            SEMANTICS: sview = "docs/semantics.md"
            IR_DOCS: sview = "docs/ir.md"


        const module Patterns:
            LOWERER_FUNCTION: sview = "def is_path_global_array_io_spec\\("
            LOWERER_PATH_READ_ROW: sview = "spec\\.argument_types == \"Path\" and spec\\.opcode == \"ReadText\" and spec\\.return_type == \"darray\\[text\\]\""
            LOWERER_PATH_READ: sview = "path_spec\\.known and path_spec\\.opcode == \"ReadText\""
            LOWERER_PATH_TEXT_TYPE: sview = "path_spec\\.return_type == \"darray\\[text\\]\""
            READ_TEXT_OPCODE: sview = "Opcode.ReadText"
            SPLIT_OPCODE: sview = "Opcode.Split"
            LOWERER_PATH_WRITE: sview = "path_spec\\.known and \\(path_spec\\.opcode == \"WriteText\" or path_spec\\.opcode == \"AppendText\"\\)"
            JOIN_OPCODE: sview = "Opcode.Join"
            APPEND_OPCODE: sview = "Opcode.AppendText if path_spec\\.opcode == \"AppendText\" else Opcode.WriteText"
            READ_LINES_PATH: sview = "read_lines requires a nominal Path operand"
            LINE_WRITER_TYPE: sview = "Path line writer requires a darray\\[sview\\] value"
            APPEND_LINES_TYPES: sview = "append_lines requires a nominal Path and darray\\[sview\\] operands"
            SPLIT_LINES_FUNCTION: sview = "def evaluate_split_lines"
            TRAILING_DELIMITER: sview = "trailing delimiter does not"
            TRAILING_LINE_BREAKS: sview = "trailing line breaks do not add an"
            SPLIT_LINES_OPCODE: sview = "Opcode.SplitLines"
            SOURCE_APPEND_LINES: sview = "source_loader_accepts_typed_append_lines"
            INTERPRETER_SPLIT_FIXTURE: sview = "interpreter_executes_text_split_lines_aliases"
            INTERPRETER_TRAILING_FIXTURE: sview = "interpreter_read_lines_preserves_trailing_empty_field"
            BYTECODE_SPLIT_FIXTURE: sview = "bytecode_direct_text_split_lines_matches_reference_interpreter"
            BYTECODE_TRAILING_FIXTURE: sview = "bytecode_direct_read_lines_preserves_trailing_empty_field"
            TREE_OVERLAP: sview = "copy_tree_destination_overlaps_source"
            TREE_CANONICAL_OVERLAP: sview = "copy_tree_destination_canonical_overlaps_source"
            CANONICAL_PARENT: sview = "canonical_parent: RuntimeValue = evaluate_path_real"
            NORMALIZED_SOURCE: sview = "normalized_source: dstr = Fs::normalize\\(&perm_arena, source\\)"
            NO_CWD_READ: sview = "without adding an undeclared current-directory read"
            REJECT_TREE_OVERLAP: sview = "interpreter_rejects_tree_destination_inside_source_before_mutation"
            REJECT_TREE_SYMLINK: sview = "interpreter_rejects_tree_destination_through_symlink_parent_before_mutation"
            BYTECODE_TREE_OVERLAP: sview = "bytecode_direct_tree_overlap_rejection_matches_reference_interpreter"
            BYTECODE_TREE_SYMLINK: sview = "bytecode_direct_tree_symlink_parent_rejection_matches_reference_interpreter"
            READ_LINES_EQUIVALENT: sview = "read_lines\\(path\\).*equivalent"
            TRAILING_EMPTY_FIELD: sview = "trailing empty field"
            IR_LINE_PIPELINE: sview = "ReadText.*Split|Split.*Join.*WriteText"


        const module Messages:
            MISSING_ROOT: sview = "path line audit: missing repository root"
            UNRESOLVED_ROOT: sview = "path line audit: unable to resolve repository root"
            MISSING_INPUT: sview = "path line audit: missing "
            RG_UNAVAILABLE: sview = "path line audit: unable to run rg"
            RG_FAILED_TO_RUN: sview = "path line audit: rg failed to run"
            SUCCESS: sview = "path line audit: typed Path line lowering, split semantics, and interpreter/direct-bytecode fixtures present"


        const module ExitStatus:
            FAILURE: i64 = 1
            TOOL_UNAVAILABLE: i64 = 127


        struct SearchCheck:
            input: Path
            pattern: sview
            ignore_case: bool


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::LOWERER_FUNCTION, ignore_case: false},
                SearchCheck{input: inputs[0], pattern: Patterns::LOWERER_PATH_READ_ROW, ignore_case: false},
                SearchCheck{input: inputs[0], pattern: Patterns::LOWERER_PATH_READ, ignore_case: false},
                SearchCheck{input: inputs[0], pattern: Patterns::LOWERER_PATH_TEXT_TYPE, ignore_case: false},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_TEXT_OPCODE, ignore_case: false},
                SearchCheck{input: inputs[0], pattern: Patterns::SPLIT_OPCODE, ignore_case: false},
                SearchCheck{input: inputs[0], pattern: Patterns::LOWERER_PATH_WRITE, ignore_case: false},
                SearchCheck{input: inputs[0], pattern: Patterns::JOIN_OPCODE, ignore_case: false},
                SearchCheck{input: inputs[0], pattern: Patterns::APPEND_OPCODE, ignore_case: false},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_LINES_PATH, ignore_case: false},
                SearchCheck{input: inputs[0], pattern: Patterns::LINE_WRITER_TYPE, ignore_case: false},
                SearchCheck{input: inputs[0], pattern: Patterns::APPEND_LINES_TYPES, ignore_case: false},
                SearchCheck{input: inputs[1], pattern: Patterns::SPLIT_LINES_FUNCTION, ignore_case: false},
                SearchCheck{input: inputs[1], pattern: Patterns::TRAILING_DELIMITER, ignore_case: true},
                SearchCheck{input: inputs[8], pattern: Patterns::TRAILING_LINE_BREAKS, ignore_case: true},
                SearchCheck{input: inputs[2], pattern: Patterns::SPLIT_LINES_OPCODE, ignore_case: false},
                SearchCheck{input: inputs[2], pattern: Patterns::SPLIT_OPCODE, ignore_case: false},
                SearchCheck{input: inputs[4], pattern: Patterns::SOURCE_APPEND_LINES, ignore_case: false},
                SearchCheck{input: inputs[5], pattern: Patterns::INTERPRETER_SPLIT_FIXTURE, ignore_case: false},
                SearchCheck{input: inputs[5], pattern: Patterns::INTERPRETER_TRAILING_FIXTURE, ignore_case: false},
                SearchCheck{input: inputs[6], pattern: Patterns::BYTECODE_SPLIT_FIXTURE, ignore_case: false},
                SearchCheck{input: inputs[6], pattern: Patterns::BYTECODE_TRAILING_FIXTURE, ignore_case: false},
                SearchCheck{input: inputs[1], pattern: Patterns::TREE_OVERLAP, ignore_case: false},
                SearchCheck{input: inputs[1], pattern: Patterns::TREE_CANONICAL_OVERLAP, ignore_case: false},
                SearchCheck{input: inputs[1], pattern: Patterns::CANONICAL_PARENT, ignore_case: false},
                SearchCheck{input: inputs[1], pattern: Patterns::NORMALIZED_SOURCE, ignore_case: false},
                SearchCheck{input: inputs[1], pattern: Patterns::NO_CWD_READ, ignore_case: false},
                SearchCheck{input: inputs[5], pattern: Patterns::REJECT_TREE_OVERLAP, ignore_case: false},
                SearchCheck{input: inputs[5], pattern: Patterns::REJECT_TREE_SYMLINK, ignore_case: false},
                SearchCheck{input: inputs[6], pattern: Patterns::BYTECODE_TREE_OVERLAP, ignore_case: false},
                SearchCheck{input: inputs[6], pattern: Patterns::BYTECODE_TREE_SYMLINK, ignore_case: false},
                SearchCheck{input: inputs[7], pattern: Patterns::READ_LINES_EQUIVALENT, ignore_case: false},
                SearchCheck{input: inputs[7], pattern: Patterns::TRAILING_EMPTY_FIELD, ignore_case: false},
                SearchCheck{input: inputs[8], pattern: Patterns::IR_LINE_PIPELINE, ignore_case: false}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Environment.Read, File.Read, Directory.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            rg: Executable = try executable("rg") else err:
                diagnostic(Messages::RG_UNAVAILABLE)
                return ExitStatus::TOOL_UNAVAILABLE
            for check in checks:
                arguments: darray[sview] = ["-q", check.pattern, f"{check.input}"]
                arguments <- ["-q", "-i", check.pattern, f"{check.input}"] if check.ignore_case
                status: i64 = try run_process(rg, arguments, 0i64) else err:
                    diagnostic(Messages::RG_FAILED_TO_RUN)
                    return ExitStatus::TOOL_UNAVAILABLE
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::LOWERER),
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::BYTECODE),
                root.joinpath(Inputs::LOWERING_TESTS),
                root.joinpath(Inputs::SOURCE_TESTS),
                root.joinpath(Inputs::INTERPRETER_TESTS),
                root.joinpath(Inputs::BYTECODE_TESTS),
                root.joinpath(Inputs::SEMANTICS),
                root.joinpath(Inputs::IR_DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsPathLineContractAudit::run_default()
