# Bounded Elisascript port of check_path_line_contract.sh.
# Source checks use the shared line scanner without launching rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsPathLineContractAudit:
    private:
        const module Inputs:
            LOWERER: sview = "src/ir/lower_ast.elisa"
            INTERPRETER: sview = "src/ir/interpret.elisa"
            BYTECODE: sview = "src/bytecode/bytecode.elisa"
            LOWERING_TESTS: sview = "test/ir/elisascript_lowering_test.elisa"
            SOURCE_TESTS: sview = "test/ir/elisascript_source_test.elisa"
            INTERPRETER_TESTS: sview = "test/ir/elisascript_interpreter_test.elisa"
            BYTECODE_TESTS: sview = "test/ir/elisascript_bytecode_test.elisa"
            SEMANTICS: sview = "docs/semantics.md"
            IR_DOCS: sview = "docs/ir.md"


        const module Patterns:
            LOWERER_FUNCTION: sview = "def is_path_global_array_io_spec\\("
            LOWERER_PATH_READ_ROW: sview = "spec\\.argument_types == \"Path\" and spec\\.opcode == \"ReadText\" and spec\\.return_type == \"darray\\[text\\]\""
            LOWERER_PATH_READ: sview = "path_spec\\.known and path_spec\\.opcode == \"ReadText\""
            LOWERER_PATH_TEXT_TYPE: sview = "path_spec\\.return_type == \"darray\\[text\\]\""
            READ_TEXT_OPCODE: sview = "Opcode.ReadText"
            SPLIT_OPCODE: sview = "Opcode.Split"
            LOWERER_PATH_WRITE: sview = "path_spec\\.known and \\(path_spec\\.opcode == \"WriteText\" or path_spec\\.opcode == \"AppendText\"\\)"
            JOIN_OPCODE: sview = "Opcode.Join"
            APPEND_OPCODE: sview = "Opcode.AppendText if path_spec\\.opcode == \"AppendText\" else Opcode.WriteText"
            READ_LINES_PATH: sview = "read_lines requires a nominal Path operand"
            LINE_WRITER_TYPE: sview = "Path line writer requires a darray\\[sview\\] value"
            APPEND_LINES_TYPES: sview = "append_lines requires a nominal Path and darray\\[sview\\] operands"
            SPLIT_LINES_FUNCTION: sview = "def evaluate_split_lines"
            TRAILING_DELIMITER: sview = "[Tt][Rr][Aa][Ii][Ll][Ii][Nn][Gg] [Dd][Ee][Ll][Ii][Mm][Ii][Tt][Ee][Rr] [Dd][Oo][Ee][Ss] [Nn][Oo][Tt]"
            TRAILING_LINE_BREAKS: sview = "[Tt][Rr][Aa][Ii][Ll][Ii][Nn][Gg] [Ll][Ii][Nn][Ee] [Bb][Rr][Ee][Aa][Kk][Ss] [Dd][Oo][Ee][Ss] [Nn][Oo][Tt] [Aa][Dd][Dd] [Aa][Nn]"
            SPLIT_LINES_OPCODE: sview = "Opcode.SplitLines"
            SOURCE_APPEND_LINES: sview = "source_loader_accepts_typed_append_lines"
            INTERPRETER_SPLIT_FIXTURE: sview = "interpreter_executes_text_split_lines_aliases"
            INTERPRETER_TRAILING_FIXTURE: sview = "interpreter_read_lines_preserves_trailing_empty_field"
            BYTECODE_SPLIT_FIXTURE: sview = "bytecode_direct_text_split_lines_matches_reference_interpreter"
            BYTECODE_TRAILING_FIXTURE: sview = "bytecode_direct_read_lines_preserves_trailing_empty_field"
            TREE_OVERLAP: sview = "copy_tree_destination_overlaps_source"
            TREE_CANONICAL_OVERLAP: sview = "copy_tree_destination_canonical_overlaps_source"
            CANONICAL_PARENT: sview = "canonical_parent: RuntimeValue = evaluate_path_real"
            NORMALIZED_SOURCE: sview = "normalized_source: dstr = Fs::normalize\\(&perm_arena, source\\)"
            NO_CWD_READ: sview = "without adding an undeclared current-directory read"
            REJECT_TREE_OVERLAP: sview = "interpreter_rejects_tree_destination_inside_source_before_mutation"
            REJECT_TREE_SYMLINK: sview = "interpreter_rejects_tree_destination_through_symlink_parent_before_mutation"
            BYTECODE_TREE_OVERLAP: sview = "bytecode_direct_tree_overlap_rejection_matches_reference_interpreter"
            BYTECODE_TREE_SYMLINK: sview = "bytecode_direct_tree_symlink_parent_rejection_matches_reference_interpreter"
            READ_LINES_EQUIVALENT: sview = "read_lines\\(path\\).*equivalent"
            TRAILING_EMPTY_FIELD: sview = "trailing empty field"
            IR_LINE_PIPELINE: sview = "ReadText.*Split|Split.*Join.*WriteText"


        const module Messages:
            MISSING_ROOT: sview = "path line audit: missing repository root"
            UNRESOLVED_ROOT: sview = "path line audit: unable to resolve repository root"
            MISSING_INPUT: sview = "path line audit: missing "
            READ_FAILED: sview = "path line audit: unable to read source: "
            SUCCESS: sview = "path line audit: typed Path line lowering, split semantics, and interpreter/direct-bytecode fixtures present"


        const module ExitStatus:
            FAILURE: i64 = 1


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::LOWERER_FUNCTION},
                SearchCheck{input: inputs[0], pattern: Patterns::LOWERER_PATH_READ_ROW},
                SearchCheck{input: inputs[0], pattern: Patterns::LOWERER_PATH_READ},
                SearchCheck{input: inputs[0], pattern: Patterns::LOWERER_PATH_TEXT_TYPE},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_TEXT_OPCODE},
                SearchCheck{input: inputs[0], pattern: Patterns::SPLIT_OPCODE},
                SearchCheck{input: inputs[0], pattern: Patterns::LOWERER_PATH_WRITE},
                SearchCheck{input: inputs[0], pattern: Patterns::JOIN_OPCODE},
                SearchCheck{input: inputs[0], pattern: Patterns::APPEND_OPCODE},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_LINES_PATH},
                SearchCheck{input: inputs[0], pattern: Patterns::LINE_WRITER_TYPE},
                SearchCheck{input: inputs[0], pattern: Patterns::APPEND_LINES_TYPES},
                SearchCheck{input: inputs[1], pattern: Patterns::SPLIT_LINES_FUNCTION},
                SearchCheck{input: inputs[1], pattern: Patterns::TRAILING_DELIMITER},
                SearchCheck{input: inputs[8], pattern: Patterns::TRAILING_LINE_BREAKS},
                SearchCheck{input: inputs[2], pattern: Patterns::SPLIT_LINES_OPCODE},
                SearchCheck{input: inputs[2], pattern: Patterns::SPLIT_OPCODE},
                SearchCheck{input: inputs[4], pattern: Patterns::SOURCE_APPEND_LINES},
                SearchCheck{input: inputs[5], pattern: Patterns::INTERPRETER_SPLIT_FIXTURE},
                SearchCheck{input: inputs[5], pattern: Patterns::INTERPRETER_TRAILING_FIXTURE},
                SearchCheck{input: inputs[6], pattern: Patterns::BYTECODE_SPLIT_FIXTURE},
                SearchCheck{input: inputs[6], pattern: Patterns::BYTECODE_TRAILING_FIXTURE},
                SearchCheck{input: inputs[1], pattern: Patterns::TREE_OVERLAP},
                SearchCheck{input: inputs[1], pattern: Patterns::TREE_CANONICAL_OVERLAP},
                SearchCheck{input: inputs[1], pattern: Patterns::CANONICAL_PARENT},
                SearchCheck{input: inputs[1], pattern: Patterns::NORMALIZED_SOURCE},
                SearchCheck{input: inputs[1], pattern: Patterns::NO_CWD_READ},
                SearchCheck{input: inputs[5], pattern: Patterns::REJECT_TREE_OVERLAP},
                SearchCheck{input: inputs[5], pattern: Patterns::REJECT_TREE_SYMLINK},
                SearchCheck{input: inputs[6], pattern: Patterns::BYTECODE_TREE_OVERLAP},
                SearchCheck{input: inputs[6], pattern: Patterns::BYTECODE_TREE_SYMLINK},
                SearchCheck{input: inputs[7], pattern: Patterns::READ_LINES_EQUIVALENT},
                SearchCheck{input: inputs[7], pattern: Patterns::TRAILING_EMPTY_FIELD},
                SearchCheck{input: inputs[8], pattern: Patterns::IR_LINE_PIPELINE}
            ]


        def has_match(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(check.pattern)
            catch EsSourceFunctionScope::contains_file_regex_line(check.input, pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return 2i64


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                status: i64 = has_match(check)
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::LOWERER),
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::BYTECODE),
                root.joinpath(Inputs::LOWERING_TESTS),
                root.joinpath(Inputs::SOURCE_TESTS),
                root.joinpath(Inputs::INTERPRETER_TESTS),
                root.joinpath(Inputs::BYTECODE_TESTS),
                root.joinpath(Inputs::SEMANTICS),
                root.joinpath(Inputs::IR_DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsPathLineContractAudit::run_default()
