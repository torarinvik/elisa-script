# Bounded Elisascript port of check_differential_replay.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDifferentialReplayAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/testing/replay_model.elisa"
            CONSUMER: sview = "src/testing/differential.elisa"
            FIXTURE: sview = "test/differential/elisascript_differential_test.elisa"
            DOCS: sview = "docs/differential-testing.md"


        const module Patterns:
            MODULE: sview = "module EsDifferentialReplay:"
            RUNS_LIMIT: sview = "Limits::RUNS"
            ORDER: sview = "const enum DifferentialReplayOrder of u8:"
            STATE: sview = "const enum DifferentialReplayState of u8:"
            EVENT: sview = "const enum DifferentialReplayEvent of u8:"
            SIDE: sview = "const enum DifferentialReplaySide of u8:"
            DISPOSITION: sview = "const enum DifferentialReplayDisposition of u8:"
            SESSION: sview = "struct DifferentialReplaySession:"
            ERROR: sview = "error DifferentialReplayError:"
            VALIDATE: sview = "def validate_differential_replay_session("
            EXPECTED_SIDE: sview = "def differential_replay_expected_side("
            ADVANCE: sview = "def advance_differential_replay("
            ADMISSION_MISMATCH: sview = "AdmissionMismatch"
            MATERIALIZATION_MISMATCH: sview = "MaterializationMismatch"
            RUN_ORDER_INVALID: sview = "RunOrderInvalid"
            COMPARISON_NOT_READY: sview = "ComparisonNotReady"
            RESTORE_MISMATCH: sview = "RestoreMismatch"
            RESTORATION_NOT_READY: sview = "RestorationNotReady"
            HIDDEN_ADMISSION: sview = "not session.has_admission and session.admission_fingerprint != 0"
            ADMISSION_FINGERPRINT: sview = "session.admission_fingerprint != session.expected_manifest_fingerprint"
            HIDDEN_REFERENCE: sview = "not session.has_reference and session.reference_run_fingerprint != 0"
            HIDDEN_CANDIDATE: sview = "not session.has_candidate and session.candidate_run_fingerprint != 0"
            HIDDEN_COMPARISON: sview = "not session.has_comparison and session.comparison_fingerprint != 0"
            HIDDEN_RESTORATION: sview = "not session.has_restoration and session.restored_world_fingerprint != 0"
            RESTORED_WORLD: sview = "session.restored_world_fingerprint != session.expected_world_fingerprint"
            MATERIALIZATION_WITHOUT_RESTORE: sview = "session.has_materialization_attempt and not session.has_restoration"
            RESTORING_NORMAL: sview = "session.state == DifferentialReplayState.Restoring and session.disposition == DifferentialReplayDisposition.Normal"
            COMPARING_EVIDENCE: sview = "session.state == DifferentialReplayState.Comparing and (session.has_comparison or session.has_restoration)"
            COMPARING: sview = "DifferentialReplayState.Comparing"
            RESTORING: sview = "DifferentialReplayState.Restoring"
            COMPARISON_EVIDENCE: sview = "ComparisonEvidence"
            ARTIFACT_EVIDENCE_VALID: sview = "differential_artifact_comparison_evidence_valid"
            SIDECAR_EVIDENCE: sview = "comparison sidecar does not describe the process and value-pool evidence"
            REFERENCE_OUTCOME: sview = "reference_process.outcome != reference_values.outcome"
            CANDIDATE_STATUS: sview = "candidate_process.exit_status != candidate_values.exit_status"
            COMPARISON_REFERENCE_OUTCOME: sview = "comparison.reference_outcome != reference_process.outcome"
            COMPARISON_REFERENCE_KIND: sview = "comparison.reference_value_kind != reference_values.root_value.kind"
            MODEL_IMPORT: sview = "include \"./replay_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsDifferentialReplay"
            FIXTURE_CONTRACT: sview = "differential_replay_contract_requires_admission_ordered_runs_and_restoration"
            FIXTURE_ABORT_RESTORATION: sview = "differential_replay_abort_paths_restore_started_worlds_before_terminal_state"
            FIXTURE_ADMIT: sview = "DifferentialReplayEvent.Admit"
            FIXTURE_COMPARE_COMPLETE: sview = "DifferentialReplayEvent.CompareComplete"
            FORGED_HIDDEN_FINGERPRINT: sview = "forged_hidden_replay_fingerprint"
            FIXTURE_RESTORE_COMPLETE: sview = "DifferentialReplayEvent.RestoreComplete"
            FIXTURE_RUN_ORDER: sview = "DifferentialReplayError.RunOrderInvalid"
            FORGED_COMPLETED: sview = "forged_completed_replay"
            FORGED_FAILED: sview = "forged_failed_replay"
            FORGED_CANCELLED: sview = "forged_cancelled_replay"
            FORGED_ADMISSION_IDENTITY: sview = "forged_admission_identity"
            FORGED_EQUAL_INDEX: sview = "forged_equal_index"
            FIXTURE_ARTIFACT_ISSUE: sview = "DifferentialArtifactReplayIssue.ComparisonInvalid"
            DOCS_SESSION: sview = "EsDifferentialReplay::DifferentialReplaySession"


        const module Messages:
            MISSING_ROOT: sview = "differential replay audit: missing repository root"
            UNRESOLVED_ROOT: sview = "differential replay audit: unable to resolve repository root"
            MISSING_INPUT: sview = "differential replay audit: missing "
            READ_FAILED: sview = "differential replay audit: unable to read source: "
            SUCCESS: sview = "differential replay audit: bounded admission, ordered side execution, abort cleanup, comparison, and world restoration are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::RUNS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::SIDE},
                SearchCheck{input: inputs[0], pattern: Patterns::DISPOSITION},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPECTED_SIDE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADMISSION_MISMATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::MATERIALIZATION_MISMATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::RUN_ORDER_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPARISON_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::RESTORE_MISMATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::RESTORATION_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::HIDDEN_ADMISSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ADMISSION_FINGERPRINT},
                SearchCheck{input: inputs[0], pattern: Patterns::HIDDEN_REFERENCE},
                SearchCheck{input: inputs[0], pattern: Patterns::HIDDEN_CANDIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::HIDDEN_COMPARISON},
                SearchCheck{input: inputs[0], pattern: Patterns::HIDDEN_RESTORATION},
                SearchCheck{input: inputs[0], pattern: Patterns::RESTORED_WORLD},
                SearchCheck{input: inputs[0], pattern: Patterns::MATERIALIZATION_WITHOUT_RESTORE},
                SearchCheck{input: inputs[0], pattern: Patterns::RESTORING_NORMAL},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPARING_EVIDENCE},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPARING},
                SearchCheck{input: inputs[0], pattern: Patterns::RESTORING},
                SearchCheck{input: inputs[1], pattern: Patterns::COMPARISON_EVIDENCE},
                SearchCheck{input: inputs[1], pattern: Patterns::ARTIFACT_EVIDENCE_VALID},
                SearchCheck{input: inputs[1], pattern: Patterns::SIDECAR_EVIDENCE},
                SearchCheck{input: inputs[1], pattern: Patterns::REFERENCE_OUTCOME},
                SearchCheck{input: inputs[1], pattern: Patterns::CANDIDATE_STATUS},
                SearchCheck{input: inputs[1], pattern: Patterns::COMPARISON_REFERENCE_OUTCOME},
                SearchCheck{input: inputs[1], pattern: Patterns::COMPARISON_REFERENCE_KIND},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ABORT_RESTORATION},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ADMIT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_COMPARE_COMPLETE},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_HIDDEN_FINGERPRINT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_RESTORE_COMPLETE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_RUN_ORDER},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_COMPLETED},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_FAILED},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_CANCELLED},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_ADMISSION_IDENTITY},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_EQUAL_INDEX},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ARTIFACT_ISSUE},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::CONSUMER),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDifferentialReplayAudit::run_default()
