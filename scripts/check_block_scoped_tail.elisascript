# Streaming Elisascript port of check_block_scoped_tail.sh.
# Keep the shell oracle until the public-launcher parity contract is qualified.

include "./shell_invocation_path.elisascript"

module EsBlockScopedTailAudit:
    private:
        const module Inputs:
            FIXTURE: sview = "test/driver/block_scoped_tail.elisascript"
            LOWERING_TEST: sview = "test/ir/elisascript_lowering_test.elisa"
            SEMANTIC_TEST: sview = "test/semantic/elisascript_semantic_test.elisa"
            LOWERER: sview = "src/ir/lower_ast.elisa"
            CLOSURE_CHECKER: sview = "vendor/elisa-compiler/src/semantic/check_closure_capture.elisa"
            FLOW_CHECKER: sview = "vendor/elisa-compiler/src/semantic/resolve_flow.elisa"


        const module Patterns:
            SCOPED_VALUE_BLOCK: sview = "def answer\\(\\) -> i64:\\n[[:space:]]+value: i64 =\\n[[:space:]]+hidden: i64 = 41\\n[[:space:]]+hidden \\+ 1\\n[[:space:]]+value"
            PROCESS_CAPTURE: sview = "capture_process_result(executable(\"/usr/bin/true\"), [], empty_input)"
            TAIL_ARITHMETIC: sview = "result.exit_status + answer() - 42"
            LOWERING_CASE: sview = "function_tail_returns_scoped_block_value"
            SEMANTIC_CASE: sview = "scoped_process_value_block_is_not_a_thread_submission"
            ARGUMENTS_TYPE: sview = "arguments: darray[sview]"
            FLOW_RULE: sview = "tail_is_value"
            LOWERING_DIAGNOSTIC: sview = "function tail expression does not match its return type"
            SUBMIT_ANNOTATION: sview = "annotation.name == \"__submit\""
            SUBMIT_LINE_RULE: sview = "submit_line == block_line.line"


        const module Messages:
            MISSING_ROOT: sview = "block-tail audit: missing repository root"
            UNRESOLVED_ROOT: sview = "block-tail audit: unable to resolve repository root"
            MISSING_INPUT: sview = "block-tail audit: missing "
            RG_UNAVAILABLE: sview = "block-tail audit: unable to run rg"
            READ_FAILED: sview = "block-tail audit: rg failed to run"


        const enum SearchMode of u8:
            Regex
            MultilineRegex
            Fixed


        struct SearchCheck:
            input: Path
            pattern: sview
            mode: SearchMode


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPED_VALUE_BLOCK, mode: SearchMode.MultilineRegex},
                SearchCheck{input: inputs[0], pattern: Patterns::PROCESS_CAPTURE, mode: SearchMode.Fixed},
                SearchCheck{input: inputs[0], pattern: Patterns::TAIL_ARITHMETIC, mode: SearchMode.Fixed},
                SearchCheck{input: inputs[1], pattern: Patterns::LOWERING_CASE, mode: SearchMode.Fixed},
                SearchCheck{input: inputs[2], pattern: Patterns::SEMANTIC_CASE, mode: SearchMode.Fixed},
                SearchCheck{input: inputs[2], pattern: Patterns::ARGUMENTS_TYPE, mode: SearchMode.Fixed},
                SearchCheck{input: inputs[5], pattern: Patterns::FLOW_RULE, mode: SearchMode.Fixed},
                SearchCheck{input: inputs[3], pattern: Patterns::LOWERING_DIAGNOSTIC, mode: SearchMode.Fixed},
                SearchCheck{input: inputs[4], pattern: Patterns::SUBMIT_ANNOTATION, mode: SearchMode.Fixed},
                SearchCheck{input: inputs[4], pattern: Patterns::SUBMIT_LINE_RULE, mode: SearchMode.Fixed}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Environment.Read, File.Read, Directory.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            rg: Executable = try executable("rg") else err:
                diagnostic(Messages::RG_UNAVAILABLE)
                return 127i64
            for check in checks:
                arguments: darray[sview] = when check.mode:
                    SearchMode.Regex -> ["-q", check.pattern, f"{check.input}"]
                    SearchMode.MultilineRegex -> ["-U", "-q", check.pattern, f"{check.input}"]
                    SearchMode.Fixed -> ["-Fq", check.pattern, f"{check.input}"]
                status: i64 = try run_process(rg, arguments, 0i64) else err:
                    diagnostic(Messages::READ_FAILED)
                    return 127i64
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return 1i64
            root: Path = path_normalize(repository_root)

            inputs: darray[Path] = [
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::LOWERING_TEST),
                root.joinpath(Inputs::SEMANTIC_TEST),
                root.joinpath(Inputs::LOWERER),
                root.joinpath(Inputs::CLOSURE_CHECKER),
                root.joinpath(Inputs::FLOW_CHECKER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return 1i64

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print("block-tail audit: fixture and source-level lowering/semantic/closure coverage are present; runtime behavior is not asserted")
            return 0i64


        def run_default() -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsBlockScopedTailAudit::run_default()
