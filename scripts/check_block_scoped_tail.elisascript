# Bounded Elisascript port of check_block_scoped_tail.sh.
# Keep the shell oracle until an isolated parity matrix is qualified.

include "../src/runtime/bounded_text_posix.elisa"

using EsBoundedText


module EsBlockScopedTailAudit:
    private:
        const module Limits:
            SOURCE_BYTES: usize = 16777216


        const module Inputs:
            FIXTURE: sview = "test/driver/block_scoped_tail.elisascript"
            LOWERING_TEST: sview = "test/ir/elisascript_lowering_test.elisa"
            SEMANTIC_TEST: sview = "test/semantic/elisascript_semantic_test.elisa"
            LOWERER: sview = "src/ir/lower_ast.elisa"
            CLOSURE_CHECKER: sview = "vendor/elisa-compiler/src/semantic/check_closure_capture.elisa"
            FLOW_CHECKER: sview = "vendor/elisa-compiler/src/semantic/resolve_flow.elisa"


        const module Syntax:
            SCOPED_VALUE_BLOCK: sview = "def answer\\(\\) -> i64:\n[[:space:]]+value: i64 =\n[[:space:]]+hidden: i64 = 41\n[[:space:]]+hidden \\+ 1\n[[:space:]]+value"
            PROCESS_CAPTURE: sview = "capture_process_result(executable(\"/usr/bin/true\"), [], empty_input)"
            TAIL_ARITHMETIC: sview = "result.exit_status + answer() - 42"
            LOWERING_CASE: sview = "function_tail_returns_scoped_block_value"
            SEMANTIC_CASE: sview = "scoped_process_value_block_is_not_a_thread_submission"
            ARGUMENTS_TYPE: sview = "arguments: darray[sview]"
            FLOW_RULE: sview = "tail_is_value"
            LOWERING_DIAGNOSTIC: sview = "function tail expression does not match its return type"
            SUBMIT_ANNOTATION: sview = "annotation.name == \"__submit\""
            SUBMIT_LINE_RULE: sview = "submit_line == block_line.line"


        const module Messages:
            MISSING_ROOT: sview = "block-tail audit: missing repository root"
            UNRESOLVED_ROOT: sview = "block-tail audit: unable to resolve repository root"
            MISSING_INPUT: sview = "block-tail audit: missing "
            READ_FAILED: sview = "block-tail audit: unable to read "


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def contains(source: sview, required: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            return source.index(required) >= 0


    public:
        def run_root(repository_root: Path) -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return 1i64
            root: Path = try path_real(path_absolute(repository_root)) else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64

            inputs: darray[Path] = [
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::LOWERING_TEST),
                root.joinpath(Inputs::SEMANTIC_TEST),
                root.joinpath(Inputs::LOWERER),
                root.joinpath(Inputs::CLOSURE_CHECKER),
                root.joinpath(Inputs::FLOW_CHECKER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return 1i64

            contents: mutable darray[sview] = []
            for input_path in inputs |contents|:
                source: mutable sview = ""
                catch EsBoundedText::read_utf8(input_path, Limits::SOURCE_BYTES):
                    ok text:
                        source <- text
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{input_path}")
                        return 2i64
                contents.push(source)

            scoped_block: Regex = regex(Syntax::SCOPED_VALUE_BLOCK)
            return 1i64 if not scoped_block.search(contents[0])
            return 1i64 if not contains(contents[0], Syntax::PROCESS_CAPTURE)
            return 1i64 if not contains(contents[0], Syntax::TAIL_ARITHMETIC)
            return 1i64 if not contains(contents[1], Syntax::LOWERING_CASE)
            return 1i64 if not contains(contents[2], Syntax::SEMANTIC_CASE)
            return 1i64 if not contains(contents[2], Syntax::ARGUMENTS_TYPE)
            return 1i64 if not contains(contents[5], Syntax::FLOW_RULE)
            return 1i64 if not contains(contents[3], Syntax::LOWERING_DIAGNOSTIC)
            return 1i64 if not contains(contents[4], Syntax::SUBMIT_ANNOTATION)
            return 1i64 if not contains(contents[4], Syntax::SUBMIT_LINE_RULE)

            print("block-tail audit: fixture and source-level lowering/semantic/closure coverage are present; runtime behavior is not asserted")
            return 0i64


        def run_default() -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            invocation_path: Path = path(Script::invocation_path())
            script_directory: Path = try path_real(path_absolute(invocation_path).parent()) else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(script_directory.parent())


def main(arguments: darray[sview]) -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
    _ = arguments
    return EsBlockScopedTailAudit::run_default()
