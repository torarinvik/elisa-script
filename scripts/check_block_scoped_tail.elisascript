# Bounded Elisascript port of check_block_scoped_tail.sh.
# Source checks use the shared scanner without launching rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsBlockScopedTailAudit:
    private:
        const module Inputs:
            FIXTURE: sview = "test/driver/block_scoped_tail.elisascript"
            LOWERING_TEST: sview = "test/ir/elisascript_lowering_test.elisa"
            SEMANTIC_TEST: sview = "test/semantic/elisascript_semantic_test.elisa"
            LOWERER: sview = "src/ir/lower_ast.elisa"
            CLOSURE_CHECKER: sview = "vendor/elisa-compiler/src/semantic/check_closure_capture.elisa"
            FLOW_CHECKER: sview = "vendor/elisa-compiler/src/semantic/resolve_flow.elisa"


        const module Patterns:
            SCOPED_VALUE_BLOCK: Regex = regex"""def answer\(\) -> i64:
[[:space:]]+value: i64 =
[[:space:]]+hidden: i64 = 41
[[:space:]]+hidden \+ 1
[[:space:]]+value"""
            PROCESS_CAPTURE: Regex = regex"capture_process_result\(executable\(\"/usr/bin/true\"\), \[\], empty_input\)"
            TAIL_ARITHMETIC: Regex = regex"result\.exit_status \+ answer\(\) - 42"
            LOWERING_CASE: Regex = regex"function_tail_returns_scoped_block_value"
            SEMANTIC_CASE: Regex = regex"scoped_process_value_block_is_not_a_thread_submission"
            ARGUMENTS_TYPE: Regex = regex"arguments: darray\[sview\]"
            FLOW_RULE: Regex = regex"tail_is_value"
            LOWERING_DIAGNOSTIC: Regex = regex"function tail expression does not match its return type"
            SUBMIT_ANNOTATION: Regex = regex"annotation\.name == \"__submit\""
            SUBMIT_LINE_RULE: Regex = regex"submit_line == block_line\.line"


        const module Messages:
            MISSING_ROOT: sview = "block-tail audit: missing repository root"
            UNRESOLVED_ROOT: sview = "block-tail audit: unable to resolve repository root"
            MISSING_INPUT: sview = "block-tail audit: missing "
            READ_FAILED: sview = "block-tail audit: unable to read source: "
            SUCCESS: sview = "block-tail audit: fixture and source-level lowering/semantic/closure coverage are present; runtime behavior is not asserted"


        const enum SearchMode of u8:
            Line
            FullText


        struct SearchCheck:
            input: Path
            pattern: Regex
            mode: SearchMode = SearchMode.Line


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPED_VALUE_BLOCK, mode: SearchMode.FullText},
                SearchCheck{input: inputs[0], pattern: Patterns::PROCESS_CAPTURE},
                SearchCheck{input: inputs[0], pattern: Patterns::TAIL_ARITHMETIC},
                SearchCheck{input: inputs[1], pattern: Patterns::LOWERING_CASE},
                SearchCheck{input: inputs[2], pattern: Patterns::SEMANTIC_CASE},
                SearchCheck{input: inputs[2], pattern: Patterns::ARGUMENTS_TYPE},
                SearchCheck{input: inputs[5], pattern: Patterns::FLOW_RULE},
                SearchCheck{input: inputs[3], pattern: Patterns::LOWERING_DIAGNOSTIC},
                SearchCheck{input: inputs[4], pattern: Patterns::SUBMIT_ANNOTATION},
                SearchCheck{input: inputs[4], pattern: Patterns::SUBMIT_LINE_RULE}
            ]


        def has_line_match(path: Path, pattern: Regex) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_regex_line(path, pattern):
                ok found:
                    return 1i64 if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return 2i64


        def has_full_text_match(path: Path, pattern: Regex) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_regex_text(path, pattern):
                ok found:
                    return 1i64 if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return 2i64


        def has_match(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            match check.mode:
                SearchMode.Line:
                    return has_line_match(check.input, check.pattern)
                SearchMode.FullText:
                    return has_full_text_match(check.input, check.pattern)
                _:
                    return 1i64


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                status: i64 = has_match(check)
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return 1i64
            root: Path = path_normalize(repository_root)

            inputs: darray[Path] = [
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::LOWERING_TEST),
                root.joinpath(Inputs::SEMANTIC_TEST),
                root.joinpath(Inputs::LOWERER),
                root.joinpath(Inputs::CLOSURE_CHECKER),
                root.joinpath(Inputs::FLOW_CHECKER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return 1i64

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsBlockScopedTailAudit::run_default()
