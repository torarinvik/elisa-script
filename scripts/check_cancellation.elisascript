# Bounded Elisascript port of check_cancellation.sh.
# Regex source checks stream through the shared scanner without rg/awk.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsCancellationAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/cancellation_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsCancellation:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/cancellation_model\.elisa\""
            TOKEN_STATE: Regex = regex"const enum CancellationTokenState of u8"
            EVENT: Regex = regex"const enum CancellationEvent of u8"
            POINT: Regex = regex"const enum CancellationPoint of u8"
            POLICY: Regex = regex"struct CancellationPolicy:"
            TOKEN: Regex = regex"struct CancellationToken:"
            LEDGER: Regex = regex"struct CancellationLedger:"
            ERROR: Regex = regex"error CancellationError:"
            VALIDATE: Regex = regex"def validate_cancellation_ledger\("
            REGISTER: Regex = regex"def cancellation_register\("
            POLL: Regex = regex"def poll_cancellation\("
            ADVANCE: Regex = regex"def advance_cancellation\("
            TOKEN_LIMIT: Regex = regex"Limits::TOKENS"
            CHILD_LIMIT: Regex = regex"Limits::CHILDREN"
            POLL_LIMIT: Regex = regex"Limits::POLLS"
            REASON_LIMIT: Regex = regex"Limits::REASON_BYTES"
            PROPAGATE: Regex = regex"CancellationEvent.Propagate"
            ACKNOWLEDGE: Regex = regex"CancellationEvent.Acknowledge"
            HOST_BEFORE_BLOCK: Regex = regex"CancellationPoint.HostBeforeBlock"
            HOST_BLOCK_DENIED: Regex = regex"CancellationError.HostBlockDenied"
            CHECK_HOST_BLOCK_POINT: Regex = regex"HostBlockDenied if point == CancellationPoint.HostBeforeBlock"
            PARENT_CYCLE: Regex = regex"CancellationError.ParentCycle"
            TERMINAL_PARENT: Regex = regex"InvalidTransition if cancellation_terminal\(ledger.tokens\[parent_index\].state\)"
            PARENT_INDEX: Regex = regex"parent_index: usize = cancellation_index"
            POLL_LIMIT_EXCEEDED: Regex = regex"CancellationError.PollLimitExceeded"
            ACKNOWLEDGED: Regex = regex"token.state == CancellationTokenState.Acknowledged"
            HOST_AFTER_BLOCK: Regex = regex"CancellationPoint.HostAfterBlock"
            FIXTURE_IMPORT: Regex = regex"using EsCancellation"
            FIXTURE_CONTRACT: Regex = regex"typed_cancellation_contract_polls_and_denies_blocking_work"
            FIXTURE_SAFE_POINT: Regex = regex"CancellationPoint.VmSafePoint"
            FIXTURE_HOST_BEFORE_BLOCK: Regex = regex"CancellationPoint.HostBeforeBlock"
            FIXTURE_HOST_BLOCK_DENIED: Regex = regex"CancellationError.HostBlockDenied"
            DOCS_LEDGER: Regex = regex"EsCancellation::CancellationLedger"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-044"


        const module Messages:
            MISSING_ROOT: sview = "cancellation audit: missing repository root"
            UNRESOLVED_ROOT: sview = "cancellation audit: unable to resolve repository root"
            MISSING_INPUT: sview = "cancellation audit: missing "
            READ_FAILED: sview = "cancellation audit: unable to read source: "
            SUCCESS: sview = "cancellation audit: bounded tokens, safe-point polling, and host blocking denial are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::TOKEN_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POINT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::TOKEN},
                SearchCheck{input: inputs[0], pattern: Patterns::LEDGER},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::REGISTER},
                SearchCheck{input: inputs[0], pattern: Patterns::POLL},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::TOKEN_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::CHILD_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLL_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::REASON_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::PROPAGATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ACKNOWLEDGE},
                SearchCheck{input: inputs[0], pattern: Patterns::HOST_BEFORE_BLOCK},
                SearchCheck{input: inputs[0], pattern: Patterns::HOST_BLOCK_DENIED},
                SearchCheck{input: inputs[0], pattern: Patterns::CHECK_HOST_BLOCK_POINT},
                SearchCheck{input: inputs[0], pattern: Patterns::PARENT_CYCLE},
                SearchCheck{input: inputs[0], pattern: Patterns::TERMINAL_PARENT},
                SearchCheck{input: inputs[0], pattern: Patterns::PARENT_INDEX},
                SearchCheck{input: inputs[0], pattern: Patterns::POLL_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::ACKNOWLEDGED},
                SearchCheck{input: inputs[0], pattern: Patterns::HOST_AFTER_BLOCK},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_SAFE_POINT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_HOST_BEFORE_BLOCK},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_HOST_BLOCK_DENIED},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_LEDGER},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsCancellationAudit::run_default()
