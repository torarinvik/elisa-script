# Bounded Elisascript port of check_sort_atomic.sh.
# Typed streaming checks preserve function scope and preflight order.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsSortAtomicAudit:
    private:
        const module Inputs:
            INTERPRETER: sview = "src/ir/interpret.elisa"
            BYTECODE: sview = "src/bytecode/bytecode.elisa"
            INTERPRETER_FIXTURE: sview = "test/ir/elisascript_interpreter_test.elisa"
            BYTECODE_FIXTURE: sview = "test/ir/elisascript_bytecode_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            INTERPRETER_FUNCTION: sview = "def evaluate_sort_array"
            INTERPRETER_DECLARATION: sview = "        def evaluate_sort_array("
            BYTECODE_FUNCTION: sview = "def bytecode_direct_sort_array"
            BYTECODE_DECLARATION: sview = "        def bytecode_direct_sort_array("
            SCALAR_KIND: sview = "value.kind not in"
            RESULT_START: sview = "result_start: u32 = storage.count.u32()"
            RESERVE: sview = "storage.reserve("
            INTERPRETER_SORT: sview = "values.sort()"
            BYTECODE_SORT: sview = "sorted([1i64, 3i64, 2i64]"
            DOCS_PREFLIGHT: sview = "preflight"
            DOCS_HOMOGENEITY: sview = "scalar homogeneity"
            LEDGER: sview = "`SortArray` preflights scalar element homogeneity"


        const module Messages:
            MISSING_ROOT: sview = "sort atomic audit: missing repository root"
            UNRESOLVED_ROOT: sview = "sort atomic audit: unable to resolve repository root"
            MISSING_INPUT: sview = "sort atomic audit: missing "
            MISSING_MARKERS: sview = "sort atomic audit: missing scalar preflight markers in "
            WRONG_ORDER: sview = "sort atomic audit: sort copies before scalar preflight in "
            READ_FAILED: sview = "sort atomic audit: unable to read source: "
            SUCCESS: sview = "sort atomic audit: both backends preflight scalar homogeneity before copying arrays"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


        def has_line_prefix(path: Path, prefix: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, prefix, "", true):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


        def assert_preflight_before_copy(path: Path, definition: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            body: EsSourceFunctionScope::FunctionBody = try EsSourceFunctionScope::read_function_body(path, definition) else err:
                diagnostic(Messages::READ_FAILED + f"{path}")
                return ExitStatus::IO_FAILURE
            kind_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::SCALAR_KIND)
            start_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::RESULT_START)
            reserve_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::RESERVE)
            if kind_line == 0 or start_line == 0 or reserve_line == 0:
                diagnostic(Messages::MISSING_MARKERS + f"{path}")
                return ExitStatus::FAILURE
            if kind_line >= start_line or kind_line >= reserve_line:
                diagnostic(Messages::WRONG_ORDER + f"{path}")
                return ExitStatus::FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::BYTECODE),
                root.joinpath(Inputs::INTERPRETER_FIXTURE),
                root.joinpath(Inputs::BYTECODE_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: mutable i64 = has_line_prefix(inputs[0], Patterns::INTERPRETER_DECLARATION)
            return status if status != 0i64
            status <- has_line_prefix(inputs[1], Patterns::BYTECODE_DECLARATION)
            return status if status != 0i64
            status <- assert_preflight_before_copy(inputs[0], Patterns::INTERPRETER_FUNCTION)
            return status if status != 0i64
            status <- assert_preflight_before_copy(inputs[1], Patterns::BYTECODE_FUNCTION)
            return status if status != 0i64

            checks: darray[SearchCheck] = [
                SearchCheck{input: inputs[2], pattern: Patterns::INTERPRETER_SORT},
                SearchCheck{input: inputs[3], pattern: Patterns::BYTECODE_SORT},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_PREFLIGHT},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_HOMOGENEITY},
                SearchCheck{input: inputs[5], pattern: Patterns::LEDGER}
            ]
            for check in checks:
                status <- has_line(check.input, check.pattern)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsSortAtomicAudit::run_default()
