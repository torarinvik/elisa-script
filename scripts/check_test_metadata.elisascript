# Bounded Elisascript port of check_test_metadata.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsTestMetadataAudit:
    private:
        const module Inputs:
            LOWERER: sview = "src/ir/lower_ast.elisa"
            SOURCE: sview = "src/ir/source.elisa"
            SOURCE_FILE: sview = "src/ir/source_file.elisa"
            FIXTURE: sview = "test/ir/elisascript_lowering_test.elisa"
            SOURCE_FIXTURE: sview = "test/ir/elisascript_source_test.elisa"
            SOURCE_FILE_FIXTURE: sview = "test/ir/elisascript_source_file_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            TEST_FUNCTION: sview = "struct ElisascriptTestFunction:"
            LOWER_RESULT: sview = "struct LowerResult:"
            TEST_FUNCTIONS: sview = "test_functions: darray[ElisascriptTestFunction]"
            TEST_FUNCTION_LIMIT: sview = "const LOWER_TEST_FUNCTIONS_MAX: usize = 4096"
            TEST_DECORATOR: sview = "def lower_function_has_test_decorator("
            LOWER_RESULT_RETURN: sview = "return LowerResult{module: lowered_module, issues: issues, test_functions: test_functions}"
            LOWER_BUFFER_DIAGNOSTIC_TESTS: sview = "def lower_elisascript_source_buffer_with_handlers_diagnostic_and_tests("
            LOWER_BUFFER_TESTS: sview = "def lower_elisascript_source_buffer_with_handlers_tests("
            LOWER_BYTES_TESTS: sview = "def lower_elisascript_source_bytes_with_handlers_tests("
            LOWER_SOURCE_TESTS: sview = "def lower_elisascript_source_with_handlers_tests("
            LOWER_BYTES_TESTS_SIMPLE: sview = "def lower_elisascript_source_bytes_tests("
            LOWER_FILE_DIAGNOSTIC_TESTS: sview = "def lower_elisascript_file_with_handlers_diagnostic_and_tests("
            LOWER_FILE_TESTS: sview = "def lower_elisascript_file_with_handlers_tests("
            LOWER_FILE_TESTS_SIMPLE: sview = "def lower_elisascript_file_tests("
            CLEAR_SOURCE_TESTS: sview = "test_functions.truncate(0)"
            EXTEND_SOURCE_TESTS: sview = "test_functions.extend(lowered.test_functions)"
            CLEAR_FILE_TESTS: sview = "test_functions.truncate(0)"
            FILE_LOWER_TESTS: sview = "lower_elisascript_source_buffer_with_handlers_diagnostic_and_tests(path_items, source_items"
            DECORATED_VOID_TEST: sview = "lower_function_has_test_decorator(decorators) and params.count == 0 and return_type.kind == TypeKind.Void"
            TEST_FUNCTIONS_BOUND: sview = "test_functions.count < LOWER_TEST_FUNCTIONS_MAX"
            TEST_FUNCTIONS_LIMIT_DIAGNOSTIC: sview = "test function count exceeds the bounded discovery limit"
            TEST_LIMIT_REPORTED: sview = "test_function_limit_reported"
            FIXTURE_CONTRACT: sview = "lower_result_collects_only_valid_top_level_test_metadata"
            FIXTURE_COUNT: sview = "lowered.test_functions.count == 2"
            FIRST_TEST: sview = "lowered.test_functions[0].name == \"first\""
            SECOND_TEST: sview = "lowered.test_functions[1].name == \"second\""
            MODULE_FUNCTION_COUNT: sview = "lowered.module.functions.count == 3"
            SOURCE_FIXTURE_CONTRACT: sview = "source_loader_exposes_top_level_test_metadata"
            SOURCE_FIXTURE_LOWER_SOURCE: sview = "lower_elisascript_source_with_handlers_tests("
            SOURCE_BYTES_FIXTURE_CONTRACT: sview = "source_bytes_loader_exposes_owned_test_metadata"
            SOURCE_FIXTURE_LOWER_BYTES: sview = "lower_elisascript_source_bytes_tests("
            SOURCE_SMOKE_TEST: sview = "tests[0].name == \"smoke\""
            SOURCE_BYTES_SMOKE_TEST: sview = "tests[0].name == \"bytes_smoke\""
            SOURCE_FILE_FIXTURE_CONTRACT: sview = "source_file_loader_exposes_top_level_test_metadata"
            SOURCE_FILE_FIXTURE_LOWER: sview = "lower_elisascript_file_tests("
            FILE_SMOKE_TEST: sview = "tests[0].name == \"file_smoke\""
            DOCS_LOWER_RESULT: sview = "`LowerResult.test_functions` is the first discovery side channel"
            DOCS_WRAPPERS: sview = "Source/file loader wrappers preserve the compact"
            LEDGER_LOWER_RESULT: sview = "ES-TEST-003 | `LowerResult.test_functions`"
            LEDGER_WRAPPERS: sview = "ES-TEST-004 | source/file test catalog wrappers"


        const module Messages:
            MISSING_ROOT: sview = "test metadata audit: missing repository root"
            UNRESOLVED_ROOT: sview = "test metadata audit: unable to resolve repository root"
            MISSING_INPUT: sview = "test metadata audit: missing "
            READ_FAILED: sview = "test metadata audit: unable to read source: "
            SUCCESS: sview = "test metadata audit: bounded top-level @test discovery metadata is present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::TEST_FUNCTION},
                SearchCheck{input: inputs[0], pattern: Patterns::LOWER_RESULT},
                SearchCheck{input: inputs[0], pattern: Patterns::TEST_FUNCTIONS},
                SearchCheck{input: inputs[0], pattern: Patterns::TEST_FUNCTION_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::TEST_DECORATOR},
                SearchCheck{input: inputs[0], pattern: Patterns::LOWER_RESULT_RETURN},
                SearchCheck{input: inputs[1], pattern: Patterns::LOWER_BUFFER_DIAGNOSTIC_TESTS},
                SearchCheck{input: inputs[1], pattern: Patterns::LOWER_BUFFER_TESTS},
                SearchCheck{input: inputs[1], pattern: Patterns::LOWER_BYTES_TESTS},
                SearchCheck{input: inputs[1], pattern: Patterns::LOWER_SOURCE_TESTS},
                SearchCheck{input: inputs[1], pattern: Patterns::LOWER_BYTES_TESTS_SIMPLE},
                SearchCheck{input: inputs[2], pattern: Patterns::LOWER_FILE_DIAGNOSTIC_TESTS},
                SearchCheck{input: inputs[2], pattern: Patterns::LOWER_FILE_TESTS},
                SearchCheck{input: inputs[2], pattern: Patterns::LOWER_FILE_TESTS_SIMPLE},
                SearchCheck{input: inputs[1], pattern: Patterns::CLEAR_SOURCE_TESTS},
                SearchCheck{input: inputs[1], pattern: Patterns::EXTEND_SOURCE_TESTS},
                SearchCheck{input: inputs[2], pattern: Patterns::CLEAR_FILE_TESTS},
                SearchCheck{input: inputs[2], pattern: Patterns::FILE_LOWER_TESTS},
                SearchCheck{input: inputs[0], pattern: Patterns::DECORATED_VOID_TEST},
                SearchCheck{input: inputs[0], pattern: Patterns::TEST_FUNCTIONS_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::TEST_FUNCTIONS_LIMIT_DIAGNOSTIC},
                SearchCheck{input: inputs[0], pattern: Patterns::TEST_LIMIT_REPORTED},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_COUNT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIRST_TEST},
                SearchCheck{input: inputs[3], pattern: Patterns::SECOND_TEST},
                SearchCheck{input: inputs[3], pattern: Patterns::MODULE_FUNCTION_COUNT},
                SearchCheck{input: inputs[4], pattern: Patterns::SOURCE_FIXTURE_CONTRACT},
                SearchCheck{input: inputs[4], pattern: Patterns::SOURCE_FIXTURE_LOWER_SOURCE},
                SearchCheck{input: inputs[4], pattern: Patterns::SOURCE_BYTES_FIXTURE_CONTRACT},
                SearchCheck{input: inputs[4], pattern: Patterns::SOURCE_FIXTURE_LOWER_BYTES},
                SearchCheck{input: inputs[4], pattern: Patterns::SOURCE_SMOKE_TEST},
                SearchCheck{input: inputs[4], pattern: Patterns::SOURCE_BYTES_SMOKE_TEST},
                SearchCheck{input: inputs[5], pattern: Patterns::SOURCE_FILE_FIXTURE_CONTRACT},
                SearchCheck{input: inputs[5], pattern: Patterns::SOURCE_FILE_FIXTURE_LOWER},
                SearchCheck{input: inputs[5], pattern: Patterns::FILE_SMOKE_TEST},
                SearchCheck{input: inputs[6], pattern: Patterns::DOCS_LOWER_RESULT},
                SearchCheck{input: inputs[6], pattern: Patterns::DOCS_WRAPPERS},
                SearchCheck{input: inputs[7], pattern: Patterns::LEDGER_LOWER_RESULT},
                SearchCheck{input: inputs[7], pattern: Patterns::LEDGER_WRAPPERS}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::LOWERER),
                root.joinpath(Inputs::SOURCE),
                root.joinpath(Inputs::SOURCE_FILE),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::SOURCE_FIXTURE),
                root.joinpath(Inputs::SOURCE_FILE_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsTestMetadataAudit::run_default()
