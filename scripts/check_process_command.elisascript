# Bounded Elisascript port of check_process_command.sh.
# Regex and fixed-string checks preserve their separate ripgrep semantics.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsProcessCommandAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/process_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            POLICY_FIXTURE: sview = "test/driver/process_command_policy_bounds.elisascript"
            DIFFERENTIAL_SOURCE: sview = "src/testing/differential.elisa"
            DIFFERENTIAL_FIXTURE: sview = "test/differential/elisascript_differential_test.elisa"
            DIFFERENTIAL_DOCS: sview = "docs/differential-testing.md"
            DOCS: sview = "docs/ir.md"


        const module Patterns:
            MODULE: sview = "^module EsProcess:"
            MODEL_IMPORT: sview = "include \"\\.\\./runtime/process_model\\.elisa\""
            STDIO_MODE: sview = "^        const enum ProcessStdioMode of u8:"
            ENVIRONMENT_MODE: sview = "^        const enum ProcessEnvironmentMode of u8:"
            FAILURE_MODE: sview = "^        const enum ProcessFailureMode of u8:"
            MAX_TIMEOUT: sview = "^        const PROCESS_COMMAND_MAX_TIMEOUT_MICROS: u64 ="
            MAX_ENVIRONMENT_ENTRIES: sview = "^        const PROCESS_COMMAND_MAX_ENVIRONMENT_ENTRIES: usize = 256$"
            MAX_ENVIRONMENT_NAME_BYTES: sview = "^        const PROCESS_COMMAND_MAX_ENVIRONMENT_NAME_BYTES: usize = 1024$"
            MAX_CAPTURE_OUTPUT_BYTES: sview = "^        const PROCESS_COMMAND_MAX_CAPTURE_OUTPUT_BYTES: usize ="
            RESULT_KIND: sview = "^        const enum ProcessResultKind of u8:"
            RESULT: sview = "^        struct ProcessResult:"
            COMMAND: sview = "^        struct ProcessCommand:"
            COMMAND_ERROR: sview = "^        error ProcessCommandError:"
            RESULT_ERROR: sview = "^        error ProcessResultError:"
            EXECUTABLE_FIELD: sview = "^            executable: sview$"
            ARGUMENTS_FIELD: sview = "^            arguments: darray\\[sview\\] = \\[\\]$"
            WORKING_DIRECTORY_FIELD: sview = "^            working_directory: sview = \"\"$"
            ENVIRONMENT_FIELD: sview = "^            environment: darray\\[sview\\] = \\[\\]$"
            STDIN_PATH_FIELD: sview = "^            stdin_path: sview = \"\"$"
            STDOUT_PATH_FIELD: sview = "^            stdout_path: sview = \"\"$"
            STDERR_PATH_FIELD: sview = "^            stderr_path: sview = \"\"$"
            TIMEOUT_FIELD: sview = "^            timeout_micros: u64 = 0$"
            CAPTURE_LIMIT_FIELD: sview = "^            capture_output_limit_bytes: usize = PROCESS_COMMAND_MAX_CAPTURE_OUTPUT_BYTES$"
            VALIDATE_COMMAND: sview = "def validate_process_command\\("
            RESOLVE_ENVIRONMENT: sview = "def resolve_process_environment\\("
            VALIDATE_ENVIRONMENT_VECTOR: sview = "def validate_process_environment_vector\\("
            VALIDATE_RESULT: sview = "def validate_process_result\\("
            COMMAND_ERROR_TYPE: sview = "error\\[ProcessCommandError\\]"
            RESULT_ERROR_TYPE: sview = "error\\[ProcessResultError\\]"
            TEXT_HAS_NUL: sview = "process_command_text_has_nul"
            ARGUMENT_COUNT_EXCEEDED: sview = "ProcessCommandError\\.ArgumentCountExceeded"
            MALFORMED_ENVIRONMENT_VECTOR: sview = "raise ProcessCommandError\\.EnvironmentVectorMalformed if command\\.environment\\.count % 2 != 0"
            ENVIRONMENT_COUNT_EXCEEDED: sview = "EnvironmentCountExceeded"
            ENTRY_PAIR_COUNT_BOUND: sview = "entries\\.count / 2 > PROCESS_COMMAND_MAX_ENVIRONMENT_ENTRIES"
            INHERITED_TEXT_FITS: sview = "not resolved_process_environment_text_fits\\(inherited\\)"
            RESULT_PAIR_COUNT_BOUND: sview = "result\\.count / 2 >= PROCESS_COMMAND_MAX_ENVIRONMENT_ENTRIES"
            OVERSIZED_AGGREGATE_INHERITED_REJECTED: sview = "oversized_aggregate_inherited_rejected"
            DUPLICATE_ENVIRONMENT_NAME: sview = "ProcessCommandError\\.DuplicateEnvironmentName"
            INVALID_STDIO_MODE: sview = "ProcessCommandError\\.InvalidStdioMode"
            TIMEOUT_LIMIT_EXCEEDED: sview = "ProcessCommandError\\.TimeoutLimitExceeded"
            CAPTURE_LIMIT_EXCEEDED: sview = "ProcessCommandError\\.CaptureLimitExceeded"
            INVALID_STDIO_PATH: sview = "ProcessCommandError\\.InvalidStdioPath"
            STDIO_PATH_EMBEDDED_NUL: sview = "ProcessCommandError\\.StdioPathEmbeddedNul"
            INVALID_SIGNAL: sview = "ProcessResultError\\.InvalidSignal"
            NEGATIVE_EXIT_STATUS: sview = "result\\.exit_status < 0"
            EXITED_KIND_STATUS: sview = "result\\.kind != ProcessResultKind\\.Exited and result\\.exit_status != 0"
            MAX_SIGNAL: sview = "PROCESS_MAX_SIGNAL"
            AGGREGATE_TEXT_LIMIT_EXCEEDED: sview = "ProcessResultError\\.AggregateTextLimitExceeded"
            PIPELINE_ACCOUNTING_INVALID: sview = "ProcessPipelineError\\.PipelineAccountingInvalid"
            CANCELLED_PIPELINE_STATE: sview = "pipeline\\.state == ProcessPipelineState\\.Cancelled"
            CANCELLED_PIPELINE_FIXTURE: sview = "state: ProcessPipelineState\\.Cancelled, completed_stages: 2"
            TEXT_ADD_FITS: sview = "process_command_text_add_fits"
            PROVE_AGGREGATE_CEILINGS: sview = "Prove aggregate length and individual ceilings before"
            ENVIRONMENT_PAIR_BOUND: sview = "EnvironmentCountExceeded if command\\.environment\\.count / 2"
            OVERSIZED_TEXT_ARGUMENTS: sview = "oversized_text_arguments_rejected"
            TYPED_ENVIRONMENT_LIMITS: sview = "typed_process_environment_limits_bound_duplicate_validation_work"
            TOO_MANY_ENTRIES: sview = "too_many_entries"
            OVERSIZED_NAME_REJECTED: sview = "oversized_name_rejected"
            ENVIRONMENT_NAME_INVALID: sview = "ProcessCommandError.EnvironmentNameInvalid"
            DIRECTORY_TEXT_BOUND: sview = "process_command_text_add_fits\\(total, command\\.working_directory\\)"
            TEXT_LENGTH_VALID: sview = "process_command_text_length_valid"
            STDIO_PATH_VALID: sview = "process_command_stdio_path_valid"
            VALUE_LENGTH_BOUND: sview = "sview_len\\(value\\) < PROCESS_COMMAND_MAX_TEXT_BYTES"
            NAME_EQUALS_CHECK: sview = "sview_contains_byte\\(name, 61\\)"
            FIXTURE_IMPORT: sview = "using EsProcess"
            COMMAND_CONTRACT: sview = "typed_process_command_contract_is_shell_free_and_bounded"
            ACCEPTS_FINITE_POLICY: sview = "accepts_explicit_finite_process_policy"
            REJECTS_TIMEOUT_RANGE: sview = "rejects_process_timeout_outside_signed_clock_range"
            REJECTS_CAPTURE_CEILING: sview = "rejects_process_capture_limit_above_runtime_ceiling"
            FIXTURE_TIMEOUT_ERROR: sview = "ProcessCommandError\\.TimeoutLimitExceeded"
            FIXTURE_CAPTURE_ERROR: sview = "ProcessCommandError\\.CaptureLimitExceeded"
            EMBEDDED_NUL: sview = "ProcessCommandError\\.EmbeddedNul"
            FIXTURE_DUPLICATE_ENVIRONMENT_NAME: sview = "ProcessCommandError\\.DuplicateEnvironmentName"
            WORKING_DIRECTORY_COMMAND: sview = "working_directory_command"
            FIXTURE_RESOLVE_ENVIRONMENT: sview = "resolve_process_environment"
            ENVIRONMENT_REPLACE: sview = "ProcessEnvironmentMode\\.Replace"
            ENVIRONMENT_CLEAR: sview = "ProcessEnvironmentMode\\.Clear"
            REPLACE_IGNORES_MALFORMED: sview = "replace_ignores_malformed_inherited"
            CLEAR_IGNORES_MALFORMED: sview = "clear_ignores_malformed_inherited"
            INHERIT_REJECTS_MALFORMED: sview = "inherit_rejects_malformed_inherited"
            FIXTURE_INVALID_STDIO_PATH: sview = "ProcessCommandError\\.InvalidStdioPath"
            FIXTURE_STDIO_PATH_NUL: sview = "ProcessCommandError\\.StdioPathEmbeddedNul"
            SIGNALED_RESULT: sview = "ProcessResultKind\\.Signaled"
            FIXTURE_INVALID_SIGNAL: sview = "ProcessResultError\\.InvalidSignal"
            NON_EXIT_STATUS: sview = "non_exit_status"
            RESULT_EMBEDDED_NUL: sview = "ProcessResultError\\.EmbeddedNul"
            DOCS_MAX_ARGUMENTS: sview = "PROCESS_COMMAND_MAX_ARGUMENTS"
            DOCS_VALIDATE_COMMAND: sview = "validate_process_command"
            DOCS_SHELL_FREE: sview = "shell-free"
            FILE_MODE_GUIDANCE: sview = "A \\x60File\\x60 mode must carry its corresponding"
            DOCS_PROCESS_RESULT: sview = "EsProcess::ProcessResult"
            DOCS_RESULT_ERROR: sview = "ProcessResultError"
            DIFFERENTIAL_IMPORT: sview = "using EsProcess"
            DIFFERENTIAL_COMMAND_VALID: sview = "def differential_process_command_valid\\("
            DIFFERENTIAL_VALIDATE_COMMAND: sview = "validate_process_command\\(command\\)"
            INVALID_DIFFERENTIAL_INVOCATION: sview = "not differential_process_command_valid\\(invocation\\)"
            DIFFERENTIAL_RESULT_FROM_STATUS: sview = "def differential_process_result_from_status\\("
            DIFFERENTIAL_VALIDATE_RESULT: sview = "validate_process_result\\(result\\)"
            DIFFERENTIAL_PROCESS_RESULT: sview = "process_result: ProcessResult"
            DIFFERENTIAL_PROCESS_CONTRACT: sview = "differential_process_execution_reuses_typed_command_environment_contract"
            DIFFERENTIAL_DOCS_COMMAND: sview = "EsProcess::ProcessCommand"


        const module Messages:
            MISSING_ROOT: sview = "process command audit: missing repository root"
            UNRESOLVED_ROOT: sview = "process command audit: unable to resolve repository root"
            MISSING_INPUT: sview = "process command audit: missing "
            READ_FAILED: sview = "process command audit: unable to read source: "
            SUCCESS: sview = "process command audit: typed shell-free command values, bounded vectors, and error[...] validation are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        const enum SearchMode of u8:
            Regex
            Literal


        struct SearchCheck:
            input: Path
            pattern: sview
            mode: SearchMode = SearchMode.Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def regex_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(check.pattern)
            catch EsSourceFunctionScope::contains_file_regex_line(check.input, pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return ExitStatus::IO_FAILURE


        def literal_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return ExitStatus::IO_FAILURE


        def search_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            match check.mode:
                SearchMode.Regex:
                    return regex_status(check)
                SearchMode.Literal:
                    return literal_status(check)
                _:
                    return ExitStatus.FAILURE


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::STDIO_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::ENVIRONMENT_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILURE_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_TIMEOUT},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_ENVIRONMENT_ENTRIES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_ENVIRONMENT_NAME_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_CAPTURE_OUTPUT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::RESULT_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::RESULT},
                SearchCheck{input: inputs[0], pattern: Patterns::COMMAND},
                SearchCheck{input: inputs[0], pattern: Patterns::COMMAND_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::RESULT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::EXECUTABLE_FIELD},
                SearchCheck{input: inputs[0], pattern: Patterns::ARGUMENTS_FIELD},
                SearchCheck{input: inputs[0], pattern: Patterns::WORKING_DIRECTORY_FIELD},
                SearchCheck{input: inputs[0], pattern: Patterns::ENVIRONMENT_FIELD},
                SearchCheck{input: inputs[0], pattern: Patterns::STDIN_PATH_FIELD},
                SearchCheck{input: inputs[0], pattern: Patterns::STDOUT_PATH_FIELD},
                SearchCheck{input: inputs[0], pattern: Patterns::STDERR_PATH_FIELD},
                SearchCheck{input: inputs[0], pattern: Patterns::TIMEOUT_FIELD},
                SearchCheck{input: inputs[0], pattern: Patterns::CAPTURE_LIMIT_FIELD},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_COMMAND},
                SearchCheck{input: inputs[0], pattern: Patterns::RESOLVE_ENVIRONMENT},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_ENVIRONMENT_VECTOR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_RESULT},
                SearchCheck{input: inputs[0], pattern: Patterns::COMMAND_ERROR_TYPE},
                SearchCheck{input: inputs[0], pattern: Patterns::RESULT_ERROR_TYPE},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_HAS_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::ARGUMENT_COUNT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::MALFORMED_ENVIRONMENT_VECTOR},
                SearchCheck{input: inputs[0], pattern: Patterns::ENVIRONMENT_COUNT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_PAIR_COUNT_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::INHERITED_TEXT_FITS},
                SearchCheck{input: inputs[0], pattern: Patterns::RESULT_PAIR_COUNT_BOUND},
                SearchCheck{input: inputs[2], pattern: Patterns::OVERSIZED_AGGREGATE_INHERITED_REJECTED},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_ENVIRONMENT_NAME},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_STDIO_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::TIMEOUT_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::CAPTURE_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_STDIO_PATH},
                SearchCheck{input: inputs[0], pattern: Patterns::STDIO_PATH_EMBEDDED_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_SIGNAL},
                SearchCheck{input: inputs[0], pattern: Patterns::NEGATIVE_EXIT_STATUS},
                SearchCheck{input: inputs[0], pattern: Patterns::EXITED_KIND_STATUS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_SIGNAL},
                SearchCheck{input: inputs[0], pattern: Patterns::AGGREGATE_TEXT_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::PIPELINE_ACCOUNTING_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLED_PIPELINE_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::CANCELLED_PIPELINE_FIXTURE},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_ADD_FITS},
                SearchCheck{input: inputs[0], pattern: Patterns::PROVE_AGGREGATE_CEILINGS},
                SearchCheck{input: inputs[0], pattern: Patterns::ENVIRONMENT_PAIR_BOUND},
                SearchCheck{input: inputs[2], pattern: Patterns::OVERSIZED_TEXT_ARGUMENTS},
                SearchCheck{input: inputs[2], pattern: Patterns::TYPED_ENVIRONMENT_LIMITS, mode: SearchMode.Literal},
                SearchCheck{input: inputs[2], pattern: Patterns::TOO_MANY_ENTRIES, mode: SearchMode.Literal},
                SearchCheck{input: inputs[2], pattern: Patterns::OVERSIZED_NAME_REJECTED, mode: SearchMode.Literal},
                SearchCheck{input: inputs[2], pattern: Patterns::ENVIRONMENT_NAME_INVALID, mode: SearchMode.Literal},
                SearchCheck{input: inputs[0], pattern: Patterns::DIRECTORY_TEXT_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_LENGTH_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::STDIO_PATH_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::VALUE_LENGTH_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_EQUALS_CHECK},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::COMMAND_CONTRACT},
                SearchCheck{input: inputs[3], pattern: Patterns::ACCEPTS_FINITE_POLICY},
                SearchCheck{input: inputs[3], pattern: Patterns::REJECTS_TIMEOUT_RANGE},
                SearchCheck{input: inputs[3], pattern: Patterns::REJECTS_CAPTURE_CEILING},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_TIMEOUT_ERROR},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_CAPTURE_ERROR},
                SearchCheck{input: inputs[2], pattern: Patterns::EMBEDDED_NUL},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_DUPLICATE_ENVIRONMENT_NAME},
                SearchCheck{input: inputs[2], pattern: Patterns::WORKING_DIRECTORY_COMMAND},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_RESOLVE_ENVIRONMENT},
                SearchCheck{input: inputs[2], pattern: Patterns::ENVIRONMENT_REPLACE},
                SearchCheck{input: inputs[2], pattern: Patterns::ENVIRONMENT_CLEAR},
                SearchCheck{input: inputs[2], pattern: Patterns::REPLACE_IGNORES_MALFORMED},
                SearchCheck{input: inputs[2], pattern: Patterns::CLEAR_IGNORES_MALFORMED},
                SearchCheck{input: inputs[2], pattern: Patterns::INHERIT_REJECTS_MALFORMED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_STDIO_PATH},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STDIO_PATH_NUL},
                SearchCheck{input: inputs[2], pattern: Patterns::SIGNALED_RESULT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_SIGNAL},
                SearchCheck{input: inputs[2], pattern: Patterns::NON_EXIT_STATUS},
                SearchCheck{input: inputs[2], pattern: Patterns::RESULT_EMBEDDED_NUL},
                SearchCheck{input: inputs[7], pattern: Patterns::DOCS_MAX_ARGUMENTS},
                SearchCheck{input: inputs[7], pattern: Patterns::DOCS_VALIDATE_COMMAND},
                SearchCheck{input: inputs[7], pattern: Patterns::DOCS_SHELL_FREE},
                SearchCheck{input: inputs[0], pattern: Patterns::STDIN_PATH_FIELD},
                SearchCheck{input: inputs[7], pattern: Patterns::FILE_MODE_GUIDANCE},
                SearchCheck{input: inputs[7], pattern: Patterns::DOCS_PROCESS_RESULT},
                SearchCheck{input: inputs[7], pattern: Patterns::DOCS_RESULT_ERROR},
                SearchCheck{input: inputs[4], pattern: Patterns::DIFFERENTIAL_IMPORT},
                SearchCheck{input: inputs[4], pattern: Patterns::DIFFERENTIAL_COMMAND_VALID},
                SearchCheck{input: inputs[4], pattern: Patterns::DIFFERENTIAL_VALIDATE_COMMAND},
                SearchCheck{input: inputs[4], pattern: Patterns::INVALID_DIFFERENTIAL_INVOCATION},
                SearchCheck{input: inputs[4], pattern: Patterns::DIFFERENTIAL_RESULT_FROM_STATUS},
                SearchCheck{input: inputs[4], pattern: Patterns::DIFFERENTIAL_VALIDATE_RESULT},
                SearchCheck{input: inputs[4], pattern: Patterns::DIFFERENTIAL_PROCESS_RESULT},
                SearchCheck{input: inputs[5], pattern: Patterns::DIFFERENTIAL_PROCESS_CONTRACT},
                SearchCheck{input: inputs[6], pattern: Patterns::DIFFERENTIAL_DOCS_COMMAND}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                status: mutable i64 = 0i64
                match check.mode:
                    SearchMode.Regex:
                        status <- regex_status(check)
                    SearchMode.Literal:
                        status <- literal_status(check)
                    _:
                        return ExitStatus::FAILURE
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::POLICY_FIXTURE),
                root.joinpath(Inputs::DIFFERENTIAL_SOURCE),
                root.joinpath(Inputs::DIFFERENTIAL_FIXTURE),
                root.joinpath(Inputs::DIFFERENTIAL_DOCS),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsProcessCommandAudit::run_default()
