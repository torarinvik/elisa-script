# Bounded Elisascript port of check_lua_bundle_metadata.sh.
# Regex source checks stream through the shared line scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsLuaBundleMetadataAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/lua_bundle_metadata_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            EMPTY_REPO_ROOT_FIXTURE: sview = "test/driver/lua_bundle_metadata_empty_repo_root.elisascript"


        const module Patterns:
            MODULE: sview = "^module EsLuaBundleMetadata:"
            LIMITS: sview = "const module Limits:"
            OPTIONS: sview = "const module Options:"
            HOST_OUTPUT_BYTES: sview = "HOST_OUTPUT_BYTES"
            HOST_TIMEOUT_MICROS: sview = "HOST_TIMEOUT_MICROS"
            METADATA_BYTES: sview = "METADATA_BYTES"
            ASSIGNMENT: sview = "struct MetadataAssignment:"
            ARGUMENTS: sview = "struct MetadataArguments:"
            FACTS: sview = "struct MetadataFacts:"
            PROCESS_RESULTS: sview = "struct MetadataProcessResults:"
            COMMAND_KIND: sview = "const enum MetadataHostCommandKind"
            ARGUMENTS_ERROR: sview = "error MetadataArgumentsError:"
            JSON_ERROR: sview = "error MetadataJsonError:"
            COMMAND_ERROR: sview = "error MetadataCommandError:"
            PARSE_ARGUMENTS: sview = "def parse_metadata_arguments\\("
            HOST_COMMAND: sview = "def metadata_host_command\\("
            RENDER_JSON: sview = "def render_metadata_json\\("
            OPTION_OUTPUT: sview = "--output"
            OPTION_BUNDLE_TYPE: sview = "--bundle-type"
            OPTION_REPO_ROOT: sview = "--repo-root"
            OPTION_OUT_DIR: sview = "--out-dir"
            OPTION_SETTING: sview = "--setting"
            OPTION_COMMAND: sview = "--command"
            ARGUMENT_TOO_LARGE: sview = "ArgumentTooLarge"
            MISSING_OPTION_VALUE: sview = "MissingOptionValue"
            AMBIGUOUS_OPTION: sview = "AmbiguousOption"
            UNEXPECTED_POSITIONAL: sview = "UnexpectedPositional"
            MISSING_REQUIRED_OPTION: sview = "MissingRequiredOption"
            INVALID_ASSIGNMENT: sview = "InvalidAssignment"
            EMPTY_ASSIGNMENT_KEY: sview = "EmptyAssignmentKey"
            ENTRY_LIMIT: sview = "EntryLimitExceeded"
            PATH_TOO_LONG: sview = "PathTooLong"
            AGGREGATE_BYTES: sview = "AggregateBytesExceeded"
            EMBEDDED_NUL: sview = "EmbeddedNul"
            PAYLOAD_ADD_FITS: sview = "metadata_payload_add_fits"
            ARGUMENTS_PAYLOAD_FITS: sview = "metadata_arguments_payload_fits"
            TIMESTAMP_VALID: sview = "metadata_timestamp_calendar_valid"
            ASSIGNMENT_VALUE: sview = "metadata_assignment_value"
            FINAL_ASSIGNMENTS: sview = "metadata_final_assignments"
            FACTS_VALID: sview = "metadata_facts_valid"
            FACTS_FROM_PROCESSES: sview = "metadata_facts_from_processes"
            METADATA_HOST_COMMAND: sview = "metadata_host_command"
            GIT_STATUS: sview = "MetadataHostCommandKind.GitStatus"
            INVALID_REPO_ROOT: sview = "MetadataCommandError.InvalidRepoRoot"
            FAILURE_ALLOW: sview = "ProcessFailureMode.Allow"
            STDIO_CAPTURE: sview = "ProcessStdioMode.Capture"
            STDIO_NULL: sview = "ProcessStdioMode.Null"
            UTF8_LOCALE: sview = "C.UTF-8"
            WORKING_DIRECTORY: sview = "working_directory"
            ASCII_DIGIT: sview = "metadata_ascii_digit"
            UNICODE_WHITESPACE: sview = "metadata_unicode_whitespace"
            JSON_UTF8: sview = "metadata_json_decode_utf8"
            PROCESS_EXITED: sview = "ProcessResultKind.Exited"
            JSON_HEX4: sview = "metadata_json_append_hex4"
            INVALID_FACTS: sview = "MetadataJsonError.InvalidFacts"
            INVALID_UTF8: sview = "MetadataJsonError.InvalidUtf8"
            OUTPUT_LIMIT: sview = "MetadataJsonError.OutputLimitExceeded"
            LAST_WINS: sview = "valid_and_last_wins"
            NEGATIVE_LOOKALIKE: sview = "negative_lookalike"
            EXPONENT_LOOKALIKE: sview = "exponent_lookalike"
            FIXTURE_NUL: sview = "embedded_nul"
            EXACT_PATH_REJECTED: sview = "exact_path_rejected"
            INVALID_CALENDAR: sview = "invalid_calendar"
            FIXTURE_RENDER_JSON: sview = "render_metadata_json"
            SMALL_LIMIT: sview = "small_limit"
            WORKING_DIRECTORY_DEFAULT: sview = "command\\.working_directory <- \"\\.\" if repo_root == \"\" else repo_root"
            OUTPUT_LIMIT_FIELD: sview = "capture_output_limit_bytes: Limits::HOST_OUTPUT_BYTES"
            EMPTY_ROOT_FUNCTION: sview = "def empty_repo_root_uses_current_directory"
            EMPTY_ROOT_ARGUMENTS: sview = "\"--repo-root\", \"\", \"--out-dir\""
            EMPTY_ROOT_WORKING_DIRECTORY: sview = "git\\.working_directory == \"\\.\""
            MODEL_IMPORT: sview = "include \"\\.\\./runtime/lua_bundle_metadata_model\\.elisa\""
            FIXTURE_IMPORT: sview = "using EsLuaBundleMetadata"


        const module Messages:
            MISSING_ROOT: sview = "lua bundle metadata audit: missing repository root"
            UNRESOLVED_ROOT: sview = "lua bundle metadata audit: unable to resolve repository root"
            MISSING_INPUT: sview = "lua bundle metadata audit: missing "
            READ_FAILED: sview = "lua bundle metadata audit: unable to read source: "
            SUCCESS: sview = "lua bundle metadata audit: typed parsing with argparse negative-number boundaries, bounded host command planning/normalization, sorted JSON serialization, repeated-key last-wins, and explicit limits are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        const enum SearchScope of u8:
            Model
            ModelOrFixture
            IR
            Fixture
            EmptyRepoRootFixture


        struct SearchCheck:
            pattern: sview
            scope: SearchScope


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def scan_line(path: Path, pattern_text: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(pattern_text)
            catch EsSourceFunctionScope::contains_file_regex_line(path, pattern):
                ok found:
                    return 0i64 if found
                    return 1i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


        def search_status(check: SearchCheck, inputs: darray[Path]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            match check.scope:
                SearchScope.Model:
                    return scan_line(inputs[0], check.pattern)
                SearchScope.ModelOrFixture:
                    model_status: i64 = scan_line(inputs[0], check.pattern)
                    return 0i64 if model_status == 0i64
                    return model_status if model_status != 1i64
                    return scan_line(inputs[2], check.pattern)
                SearchScope.IR:
                    return scan_line(inputs[1], check.pattern)
                SearchScope.Fixture:
                    return scan_line(inputs[2], check.pattern)
                SearchScope.EmptyRepoRootFixture:
                    return scan_line(inputs[3], check.pattern)
                _:
                    return ExitStatus::FAILURE


        def searches() -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{pattern: Patterns::MODULE, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::LIMITS, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::OPTIONS, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::HOST_OUTPUT_BYTES, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::HOST_TIMEOUT_MICROS, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::METADATA_BYTES, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::ASSIGNMENT, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::ARGUMENTS, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::FACTS, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::PROCESS_RESULTS, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::COMMAND_KIND, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::ARGUMENTS_ERROR, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::JSON_ERROR, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::COMMAND_ERROR, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::PARSE_ARGUMENTS, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::HOST_COMMAND, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::RENDER_JSON, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::OPTION_OUTPUT, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::OPTION_BUNDLE_TYPE, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::OPTION_REPO_ROOT, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::OPTION_OUT_DIR, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::OPTION_SETTING, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::OPTION_COMMAND, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::ARGUMENT_TOO_LARGE, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::MISSING_OPTION_VALUE, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::AMBIGUOUS_OPTION, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::UNEXPECTED_POSITIONAL, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::MISSING_REQUIRED_OPTION, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::INVALID_ASSIGNMENT, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::EMPTY_ASSIGNMENT_KEY, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::ENTRY_LIMIT, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::PATH_TOO_LONG, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::AGGREGATE_BYTES, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::EMBEDDED_NUL, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::PAYLOAD_ADD_FITS, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::ARGUMENTS_PAYLOAD_FITS, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::TIMESTAMP_VALID, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::ASSIGNMENT_VALUE, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::FINAL_ASSIGNMENTS, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::FACTS_VALID, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::FACTS_FROM_PROCESSES, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::METADATA_HOST_COMMAND, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::GIT_STATUS, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::INVALID_REPO_ROOT, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::FAILURE_ALLOW, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::STDIO_CAPTURE, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::STDIO_NULL, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::HOST_TIMEOUT_MICROS, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::UTF8_LOCALE, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::WORKING_DIRECTORY, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::ASCII_DIGIT, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::UNICODE_WHITESPACE, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::JSON_UTF8, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::PROCESS_EXITED, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::JSON_HEX4, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::INVALID_FACTS, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::INVALID_UTF8, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::OUTPUT_LIMIT, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::LAST_WINS, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::NEGATIVE_LOOKALIKE, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::EXPONENT_LOOKALIKE, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::FIXTURE_NUL, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::EXACT_PATH_REJECTED, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::INVALID_CALENDAR, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::FIXTURE_RENDER_JSON, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::SMALL_LIMIT, scope: SearchScope.ModelOrFixture},
                SearchCheck{pattern: Patterns::WORKING_DIRECTORY_DEFAULT, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::OUTPUT_LIMIT_FIELD, scope: SearchScope.Model},
                SearchCheck{pattern: Patterns::EMPTY_ROOT_FUNCTION, scope: SearchScope.EmptyRepoRootFixture},
                SearchCheck{pattern: Patterns::EMPTY_ROOT_ARGUMENTS, scope: SearchScope.EmptyRepoRootFixture},
                SearchCheck{pattern: Patterns::EMPTY_ROOT_WORKING_DIRECTORY, scope: SearchScope.EmptyRepoRootFixture},
                SearchCheck{pattern: Patterns::MODEL_IMPORT, scope: SearchScope.IR},
                SearchCheck{pattern: Patterns::FIXTURE_IMPORT, scope: SearchScope.Fixture}
            ]


        def execute(checks: darray[SearchCheck], inputs: darray[Path]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                status: i64 = search_status(check, inputs)
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::EMPTY_REPO_ROOT_FIXTURE)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(), inputs)
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsLuaBundleMetadataAudit::run_default()
