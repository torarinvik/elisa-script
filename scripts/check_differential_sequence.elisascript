# Bounded Elisascript port of check_differential_sequence.sh.
# Fixed-string source checks stream through the shared scanner without rg/awk.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDifferentialSequenceAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/testing/sequence_model.elisa"
            DIFFERENTIAL: sview = "src/testing/differential.elisa"
            FIXTURE: sview = "test/differential/elisascript_differential_test.elisa"
            DOCS: sview = "docs/differential-testing.md"


        const module Patterns:
            MODULE: sview = "module EsDifferentialSequence:"
            STEP_LIMIT: sview = "Limits::STEPS"
            STATE_ENUM: sview = "const enum DifferentialSequenceState of u8:"
            EVENT_ENUM: sview = "const enum DifferentialSequenceEvent of u8:"
            STEP: sview = "struct DifferentialSequenceStep:"
            CHECKPOINT: sview = "struct DifferentialSequenceCheckpoint:"
            SEQUENCE: sview = "struct DifferentialSequence:"
            ERROR: sview = "error DifferentialSequenceError:"
            VALIDATE: sview = "def validate_differential_sequence("
            ADVANCE: sview = "def advance_differential_sequence("
            FIRST_DIVERGENCE: sview = "first_divergence"
            CHECKPOINT_ORDER: sview = "CheckpointOrderInvalid"
            STEP_ORDER: sview = "StepOrderInvalid"
            OBSERVATION_LIMIT: sview = "ObservationLimitExceeded"
            OBSERVATION_ACCOUNTING: sview = "ObservationAccountingInvalid"
            COMPLETION_NOT_READY: sview = "CompletionNotReady"
            DIVERGENCE_STATE: sview = "DivergenceStateInvalid"
            NEXT_INDEX: sview = "sequence.next_index != sequence.steps.count"
            FORGED_STEP_CURSOR: sview = "forged_step_cursor"
            FUTURE_CHECKPOINT: sview = "checkpoint.index > sequence.next_index"
            FORGED_FUTURE_CHECKPOINT: sview = "forged_future_checkpoint"
            POST_DIVERGENCE_CHECKPOINT: sview = "checkpoint.index > sequence.first_divergence"
            FORGED_POST_DIVERGENCE_CHECKPOINT: sview = "forged_post_divergence_checkpoint"
            DIVERGENCE_POINTER: sview = "sequence.first_divergence != sequence.steps.count - 1"
            FORGED_DIVERGENCE_POINTER: sview = "forged_divergence_pointer"
            MODEL_IMPORT: sview = "include \"./sequence_model.elisa\""
            FIXTURE_CONTRACT: sview = "differential_sequence_contract_localizes_first_divergence_and_checkpoints"
            FIXTURE_CHECKPOINT: sview = "DifferentialSequenceEvent.Checkpoint"
            FIXTURE_DIVERGED: sview = "DifferentialSequenceState.Diverged"
            FIXTURE_STEP_ORDER: sview = "DifferentialSequenceError.StepOrderInvalid"
            FIXTURE_ACCOUNTING: sview = "forged_observation_accounting"
            DOCS_CONTRACT: sview = "`EsDifferentialSequence::DifferentialSequence`"


        const module Messages:
            MISSING_ROOT: sview = "differential sequence audit: missing repository root"
            UNRESOLVED_ROOT: sview = "differential sequence audit: unable to resolve repository root"
            MISSING_INPUT: sview = "differential sequence audit: missing "
            READ_FAILED: sview = "differential sequence audit: unable to read source: "
            SUCCESS: sview = "differential sequence audit: bounded lockstep steps, checkpoints, and first-divergence localization are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::STEP_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE_ENUM},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT_ENUM},
                SearchCheck{input: inputs[0], pattern: Patterns::STEP},
                SearchCheck{input: inputs[0], pattern: Patterns::CHECKPOINT},
                SearchCheck{input: inputs[0], pattern: Patterns::SEQUENCE},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::FIRST_DIVERGENCE},
                SearchCheck{input: inputs[0], pattern: Patterns::CHECKPOINT_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::STEP_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::OBSERVATION_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::OBSERVATION_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETION_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::DIVERGENCE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::NEXT_INDEX},
                SearchCheck{input: inputs[0], pattern: Patterns::FORGED_STEP_CURSOR},
                SearchCheck{input: inputs[0], pattern: Patterns::FUTURE_CHECKPOINT},
                SearchCheck{input: inputs[0], pattern: Patterns::FORGED_FUTURE_CHECKPOINT},
                SearchCheck{input: inputs[0], pattern: Patterns::POST_DIVERGENCE_CHECKPOINT},
                SearchCheck{input: inputs[0], pattern: Patterns::FORGED_POST_DIVERGENCE_CHECKPOINT},
                SearchCheck{input: inputs[0], pattern: Patterns::DIVERGENCE_POINTER},
                SearchCheck{input: inputs[0], pattern: Patterns::FORGED_DIVERGENCE_POINTER},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CHECKPOINT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_DIVERGED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STEP_ORDER},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ACCOUNTING},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_CONTRACT}
            ]


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::DIFFERENTIAL),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            for check in searches(inputs):
                status: i64 = has_line(check.input, check.pattern)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDifferentialSequenceAudit::run_default()
