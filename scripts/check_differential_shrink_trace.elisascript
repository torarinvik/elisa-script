# Bounded Elisascript port of check_differential_shrink_trace.sh.
# Its ordered fixed-string contract is checked by the shared streaming reader.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDifferentialShrinkTraceAudit:
    private:
        const module Inputs:
            SOURCE: sview = "src/testing/differential.elisa"
            FIXTURE: sview = "test/differential/elisascript_differential_test.elisa"
            DOCS: sview = "docs/differential-testing.md"


        const module Messages:
            MISSING_ROOT: sview = "differential shrink-trace audit: missing repository root"
            UNRESOLVED_ROOT: sview = "differential shrink-trace audit: unable to resolve repository root"
            MISSING_INPUT: sview = "differential shrink-trace audit: missing "
            READ_FAILED: sview = "differential shrink-trace audit: unable to read source: "
            SUCCESS: sview = "differential shrink-trace audit: bounded category-preserving steps and explicit minimality proof are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::SOURCE),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            declarations: darray[sview] = [
                "DIFFERENTIAL_SHRINK_TRACE_MAX_STEPS",
                "const enum DifferentialShrinkTraceState of u8:",
                "const enum DifferentialShrinkTraceEvent of u8:",
                "struct DifferentialShrinkTraceStep:",
                "struct DifferentialShrinkTrace:",
                "error DifferentialShrinkTraceError:",
                "def validate_differential_shrink_trace(",
                "def advance_differential_shrink_trace("
            ]
            status: mutable i64 = 0i64
            for declaration in declarations:
                status <- has_line(inputs[0], declaration)
                return status if status != 0i64

            boundaries: darray[sview] = [
                "minimality_proven",
                "trace.minimality_proven and trace.state != DifferentialShrinkTraceState.Complete",
                "MismatchCategory",
                "MinimalityUnproven",
                "candidate_fingerprint",
                "preserved_kind",
                "ClearReferenceValueSlot",
                "ClearCandidateValueSlot",
                "differential_run_with_value_slot_cleared"
            ]
            for boundary in boundaries:
                status <- has_line(inputs[0], boundary)
                return status if status != 0i64

            fixture_patterns: darray[sview] = [
                "differential_shrink_trace_contract_records_preserved_category_and_minimality",
                "differential_run_shrinker_preserves_first_difference_and_order",
                "DifferentialShrinkTraceEvent.Record",
                "DifferentialShrinkTraceError.MismatchCategory",
                "forged_shrink_proof",
                "ClearReferenceValueSlot",
                "ClearCandidateValueSlot",
                "exhausted: true"
            ]
            for pattern in fixture_patterns:
                status <- has_line(inputs[1], pattern)
                return status if status != 0i64

            status <- has_line(inputs[2], "DifferentialShrinkTrace")
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDifferentialShrinkTraceAudit::run_default()
