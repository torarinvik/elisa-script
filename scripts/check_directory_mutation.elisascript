# Bounded Elisascript port of check_directory_mutation.sh.
# Regex source checks stream through the shared line scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDirectoryMutationAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/directory_mutation_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsDirectoryMutation:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/directory_mutation_model\.elisa\""
            OPERATION: Regex = regex"const enum DirectoryMutationOperation of u8"
            SYMLINK_POLICY: Regex = regex"const enum DirectoryMutationSymlinkPolicy of u8"
            FAILURE_MODE: Regex = regex"const enum DirectoryMutationFailureMode of u8"
            ENTRY_STATE: Regex = regex"const enum DirectoryMutationEntryState of u8"
            POLICY: Regex = regex"struct DirectoryMutationPolicy:"
            ENTRY: Regex = regex"struct DirectoryMutationEntry:"
            SESSION: Regex = regex"struct DirectoryMutationSession:"
            ERROR: Regex = regex"error DirectoryMutationError:"
            VALIDATE: Regex = regex"def validate_directory_mutation\("
            ADVANCE: Regex = regex"def advance_directory_mutation\("
            MAX_ENTRIES: Regex = regex"DIRECTORY_MUTATION_MAX_ENTRIES"
            MAX_DEPTH: Regex = regex"DIRECTORY_MUTATION_MAX_DEPTH"
            MAX_IDENTITIES: Regex = regex"DIRECTORY_MUTATION_MAX_IDENTITIES"
            MAX_BYTES: Regex = regex"DIRECTORY_MUTATION_MAX_BYTES"
            IDENTITY_INDEX: Regex = regex"directory_mutation_identity_index"
            SYMLINK_PRESERVE: Regex = regex"DirectoryMutationSymlinkPolicy.Preserve"
            SYMLINK_FOLLOW: Regex = regex"DirectoryMutationSymlinkPolicy.Follow"
            SYMLINK_SKIP: Regex = regex"DirectoryMutationSymlinkPolicy.Skip"
            SYMLINK_REJECT: Regex = regex"DirectoryMutationSymlinkPolicy.Reject"
            FAILURE_COLLECT: Regex = regex"DirectoryMutationFailureMode.Collect"
            EVENT_ENTER: Regex = regex"DirectoryMutationEvent.Enter"
            EVENT_LEAVE: Regex = regex"DirectoryMutationEvent.Leave"
            CAN_ENTER_DEFAULT: Regex = regex"can_enter: bool = false"
            ENTRY_NOT_APPLIED: Regex = regex"raise DirectoryMutationError.EntryNotApplied if not session.can_enter"
            CLEAR_CAN_ENTER: Regex = regex"session.can_enter <- false"
            DUPLICATE_IDENTITY: Regex = regex"DirectoryMutationError.DuplicateIdentity"
            DESTINATION_COLLISION: Regex = regex"DirectoryMutationError.DestinationCollision"
            ACCOUNTED_BYTES: Regex = regex"accounted_bytes > session.policy.max_bytes"
            ENTRY_BYTES_BOUND: Regex = regex"entry.bytes > session.policy.max_bytes - accounted_bytes"
            TRIM_TRAILING: Regex = regex"directory_mutation_trim_trailing_separators"
            PATHS_EQUIVALENT: Regex = regex"directory_mutation_paths_equivalent"
            FINISH_TRAILING_SEPARATORS: Regex = regex"while finish > 1 and sview_at(path, finish - 1) == 47"
            PATH_PREFIX_EQUAL: Regex = regex"source_end == destination_end and source\[0:source_end\] == destination\[0:destination_end\]"
            ROOT_SOURCE: Regex = regex"source_end == 1 and sview_at(source, 0) == 47"
            DESTINATION_NESTED: Regex = regex"directory_mutation_destination_nested"
            SESSION_SOURCE_NUL: Regex = regex"raise DirectoryMutationError.EmbeddedNul if sview_contains_byte\(session.source_path, 0\)"
            SESSION_DESTINATION_NUL: Regex = regex"raise DirectoryMutationError.EmbeddedNul if sview_contains_byte\(session.destination_path, 0\)"
            ENTRY_SOURCE_NUL: Regex = regex"raise DirectoryMutationError.EmbeddedNul if sview_contains_byte\(entry.source, 0\)"
            ENTRY_DESTINATION_NUL: Regex = regex"raise DirectoryMutationError.EmbeddedNul if sview_contains_byte\(entry.destination, 0\)"
            PLANNED_STATE: Regex = regex"DirectoryMutationState.Planned and"
            COMPLETED_STATE: Regex = regex"DirectoryMutationState.Completed"
            CANCELLED_STATE: Regex = regex"DirectoryMutationState.Cancelled"
            IDENTITY_MATCH: Regex = regex"session\.identities\[index\] != entry\.identity"
            FAILURE_LIMIT: Regex = regex"DirectoryMutationError.FailureLimitExceeded"
            CANCEL_NOT_READY: Regex = regex"DirectoryMutationError.CancelNotReady"
            FIXTURE_IMPORT: Regex = regex"using EsDirectoryMutation"
            FIXTURE_CONTRACT: Regex = regex"typed_directory_mutation_contract_tracks_copy_remove_and_partial_failure"
            COPY_OPERATION: Regex = regex"DirectoryMutationOperation.Copy"
            REMOVE_OPERATION: Regex = regex"DirectoryMutationOperation.Remove"
            FIXTURE_DUPLICATE_IDENTITY: Regex = regex"DirectoryMutationError.DuplicateIdentity"
            EVENT_FAILURE: Regex = regex"DirectoryMutationEvent.Failure"
            EVENT_CANCEL: Regex = regex"DirectoryMutationEvent.Cancel"
            FIXTURE_DESTINATION_COLLISION: Regex = regex"DirectoryMutationError.DestinationCollision"
            NORMALIZED_COLLISION: Regex = regex"normalized_collision"
            NORMALIZED_PLAN_REJECTED: Regex = regex"normalized_plan_rejected"
            ACTIVE_SCOPE: Regex = regex"DirectoryMutationError.ActiveScope"
            REPEATED_ENTER: Regex = regex"repeated_enter_rejected"
            STALE_REGULAR_ENTER: Regex = regex"stale_regular_enter_rejected"
            TRAILING_NESTED_DESTINATION: Regex = regex"trailing_nested_destination"
            EQUIVALENT_TRAILING_DESTINATION: Regex = regex"equivalent_trailing_destination"
            NUL_SOURCE_PRECEDENCE: Regex = regex"nul_source_precedes_invalid_path"
            NUL_DESTINATION_PRECEDENCE: Regex = regex"nul_destination_precedes_invalid_path"
            NUL_PLAN_SOURCE_PRECEDENCE: Regex = regex"nul_plan_source_precedes_invalid_path"
            NUL_PLAN_DESTINATION_PRECEDENCE: Regex = regex"nul_plan_destination_precedes_invalid_path"
            FIXTURE_NESTED_DESTINATION: Regex = regex"nested_destination"
            DOCS_SESSION: Regex = regex"EsDirectoryMutation::DirectoryMutationSession"
            LEDGER_ITEM: Regex = regex"ES-FS-005"


        const module Messages:
            MISSING_ROOT: sview = "directory mutation audit: missing repository root"
            UNRESOLVED_ROOT: sview = "directory mutation audit: unable to resolve repository root"
            MISSING_INPUT: sview = "directory mutation audit: missing "
            READ_FAILED: sview = "directory mutation audit: unable to read source: "
            SUCCESS: sview = "directory mutation audit: bounded copy/remove planning, symlink policy, and partial-failure accounting are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::OPERATION},
                SearchCheck{input: inputs[0], pattern: Patterns::SYMLINK_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILURE_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_ENTRIES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_DEPTH},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_IDENTITIES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::IDENTITY_INDEX},
                SearchCheck{input: inputs[0], pattern: Patterns::SYMLINK_PRESERVE},
                SearchCheck{input: inputs[0], pattern: Patterns::SYMLINK_FOLLOW},
                SearchCheck{input: inputs[0], pattern: Patterns::SYMLINK_SKIP},
                SearchCheck{input: inputs[0], pattern: Patterns::SYMLINK_REJECT},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILURE_COLLECT},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT_ENTER},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT_LEAVE},
                SearchCheck{input: inputs[0], pattern: Patterns::CAN_ENTER_DEFAULT},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_NOT_APPLIED},
                SearchCheck{input: inputs[0], pattern: Patterns::CLEAR_CAN_ENTER},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_IDENTITY},
                SearchCheck{input: inputs[0], pattern: Patterns::DESTINATION_COLLISION},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTED_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_BYTES_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::TRIM_TRAILING},
                SearchCheck{input: inputs[0], pattern: Patterns::PATHS_EQUIVALENT},
                SearchCheck{input: inputs[0], pattern: Patterns::FINISH_TRAILING_SEPARATORS},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_PREFIX_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::ROOT_SOURCE},
                SearchCheck{input: inputs[0], pattern: Patterns::DESTINATION_NESTED},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION_SOURCE_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION_DESTINATION_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_SOURCE_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_DESTINATION_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::IDENTITY_MATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILURE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_NOT_READY},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::COPY_OPERATION},
                SearchCheck{input: inputs[2], pattern: Patterns::REMOVE_OPERATION},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_DUPLICATE_IDENTITY},
                SearchCheck{input: inputs[2], pattern: Patterns::EVENT_FAILURE},
                SearchCheck{input: inputs[2], pattern: Patterns::EVENT_CANCEL},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_DESTINATION_COLLISION},
                SearchCheck{input: inputs[2], pattern: Patterns::NORMALIZED_COLLISION},
                SearchCheck{input: inputs[2], pattern: Patterns::NORMALIZED_PLAN_REJECTED},
                SearchCheck{input: inputs[2], pattern: Patterns::ACTIVE_SCOPE},
                SearchCheck{input: inputs[2], pattern: Patterns::REPEATED_ENTER},
                SearchCheck{input: inputs[2], pattern: Patterns::STALE_REGULAR_ENTER},
                SearchCheck{input: inputs[2], pattern: Patterns::TRAILING_NESTED_DESTINATION},
                SearchCheck{input: inputs[2], pattern: Patterns::EQUIVALENT_TRAILING_DESTINATION},
                SearchCheck{input: inputs[2], pattern: Patterns::NUL_SOURCE_PRECEDENCE},
                SearchCheck{input: inputs[2], pattern: Patterns::NUL_DESTINATION_PRECEDENCE},
                SearchCheck{input: inputs[2], pattern: Patterns::NUL_PLAN_SOURCE_PRECEDENCE},
                SearchCheck{input: inputs[2], pattern: Patterns::NUL_PLAN_DESTINATION_PRECEDENCE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_NESTED_DESTINATION},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDirectoryMutationAudit::run_default()
