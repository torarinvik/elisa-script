# Bounded Elisascript port of check_package_cache.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsPackageCacheAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/package_cache_model.elisa"
            PACKAGE_MODEL: sview = "src/runtime/package_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "module EsPackageCache:"
            MAX_ENTRIES: sview = "PACKAGE_CACHE_MAX_ENTRIES"
            MAX_BYTES: sview = "PACKAGE_CACHE_MAX_BYTES"
            STATE: sview = "const enum PackageCacheState of u8:"
            EVENT: sview = "const enum PackageCacheEvent of u8:"
            ENTRY: sview = "struct PackageCacheEntry:"
            CACHE: sview = "struct PackageCache:"
            ERROR: sview = "error PackageCacheError:"
            VALIDATE: sview = "def validate_package_cache("
            LOOKUP: sview = "def package_cache_lookup("
            ADVANCE: sview = "def advance_package_cache("
            ENTRY_BEFORE: sview = "cache_entry_before"
            ENTRY_EQUAL: sview = "cache_entry_equal"
            ENTRY_INDEX: sview = "cache_entry_index"
            VERSION_PRECEDES: sview = "package_version_precedes"
            LOCATOR_FINGERPRINT: sview = "locator: sview, fingerprint: u64"
            EXACT_LOCATOR: sview = "entry.locator == locator"
            INVALID_ENTRY: sview = "not entry.valid"
            RETAINED_BYTES: sview = "retained_bytes"
            CACHE_NOT_READY: sview = "CacheNotReady"
            CACHE_MISS: sview = "CacheMiss"
            ENTRY_INDEX_INVALID: sview = "EntryIndexInvalid"
            INVALIDATE_NOT_READY: sview = "InvalidateNotReady"
            EMPTY_STATE: sview = "cache.state == PackageCacheState.Empty"
            NOT_UPDATING: sview = "cache.state != PackageCacheState.Updating"
            RESET_NOT_READY: sview = "ResetNotReady"
            BYTE_LIMIT_EXCEEDED: sview = "ByteLimitExceeded"
            MODEL_IMPORT: sview = "include \"../runtime/package_cache_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsPackageCache"
            FIXTURE_CONTRACT: sview = "typed_package_cache_contract_requires_exact_identity_and_explicit_invalidation"
            FIXTURE_STORE: sview = "PackageCacheEvent.Store"
            FIXTURE_LOOKUP: sview = "package_cache_lookup"
            FIXTURE_ALTERNATE: sview = "alternate_cache"
            FIXTURE_WRONG_LOCATOR: sview = "wrong_locator"
            FIXTURE_CACHE_MISS: sview = "PackageCacheError.CacheMiss"
            FIXTURE_INVALIDATE: sview = "PackageCacheEvent.Invalidate"
            FIXTURE_REFRESH: sview = "refresh_cache"
            FIXTURE_REPLACEMENT: sview = "replacement"
            FIXTURE_FORGED_EMPTY: sview = "forged_empty"
            DOCS_REGISTRY: sview = "EsPackageCache complements the registry"
            LEDGER_ITEM: sview = "ES-SCRIPT-005 | EsPackageCache"


        const module Messages:
            MISSING_ROOT: sview = "package cache audit: missing repository root"
            UNRESOLVED_ROOT: sview = "package cache audit: unable to resolve repository root"
            MISSING_INPUT: sview = "package cache audit: missing "
            READ_FAILED: sview = "package cache audit: unable to read source: "
            SUCCESS: sview = "package cache audit: bounded ordered entries, exact identity lookup, byte limits, invalidation, and reset transitions are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_ENTRIES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY},
                SearchCheck{input: inputs[0], pattern: Patterns::CACHE},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::LOOKUP},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_BEFORE},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_INDEX},
                SearchCheck{input: inputs[0], pattern: Patterns::VERSION_PRECEDES},
                SearchCheck{input: inputs[0], pattern: Patterns::LOCATOR_FINGERPRINT},
                SearchCheck{input: inputs[0], pattern: Patterns::EXACT_LOCATOR},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_ENTRY},
                SearchCheck{input: inputs[0], pattern: Patterns::RETAINED_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::CACHE_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::CACHE_MISS},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_INDEX_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALIDATE_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::EMPTY_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::NOT_UPDATING},
                SearchCheck{input: inputs[0], pattern: Patterns::RESET_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::BYTE_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[2], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_STORE},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_LOOKUP},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_ALTERNATE},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_WRONG_LOCATOR},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_CACHE_MISS},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_INVALIDATE},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_REFRESH},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_REPLACEMENT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_FORGED_EMPTY},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_REGISTRY},
                SearchCheck{input: inputs[5], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::PACKAGE_MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsPackageCacheAudit::run_default()
