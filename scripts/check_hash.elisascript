# Bounded Elisascript port of check_hash.sh.
# This repository audit reads source and documentation only; it never starts rg
# or another child process. The shell reference remains available for parity.

include "../src/runtime/bounded_text_posix.elisa"

using EsBoundedText


module EsHashAudit:
    private:
        const module Limits:
            SOURCE_BYTES: usize = 16777216
            TOTAL_SOURCE_BYTES: usize = 33554432


        const module Inputs:
            MODEL: sview = "src/runtime/hash_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        error AuditReadError:
            Missing
            LimitExceeded


        def display_path(root: sview, relative: sview) -> sview:
            return "/" + relative if root == "/"
            return root + "/" + relative


        def has_prefix_line(source: sview, prefix: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            lines: darray[sview] = split_lines(source)
            for line in lines:
                return true if line.startswith(prefix)
            return false


        def contains_all(source: sview, required: darray[sview]) -> bool:
            for needle in required:
                return false if source.index(needle) < 0
            return true


        def read_source(input_path: Path, source_size: usize) -> sview error[AuditReadError] can[Memory.Allocate, Abort.Panic, Blocking.IO, File.Read, Unsafe.PointerCast]:
            current_size: usize = try file_size(input_path) else err:
                raise AuditReadError.Missing
            raise AuditReadError.LimitExceeded if current_size > source_size or current_size > Limits::SOURCE_BYTES
            source: sview = try EsBoundedText::read_utf8(input_path, source_size) else err:
                raise AuditReadError.Missing
            raise AuditReadError.LimitExceeded if len(source) > source_size or len(source) > Limits::SOURCE_BYTES
            return source


    public:
        def run(repository_root: Path) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Blocking.IO, Directory.Read, File.Read, Unsafe.PointerCast]:
            if not is_directory(repository_root):
                _ = write_stderr("hash audit: missing repository root\n")
                return 1i64
            root_absolute: Path = try path_real(path_absolute(repository_root)) else err:
                _ = write_stderr("hash audit: missing repository root\n")
                return 1i64
            root_text: sview = f"{root_absolute}"
            relative_paths: darray[sview] = [Inputs::MODEL, Inputs::IR, Inputs::FIXTURE, Inputs::DOCS, Inputs::LEDGER]
            source_sizes: mutable darray[usize] = []
            sources: mutable darray[sview] = []
            total_bytes: mutable usize = 0

            for relative in relative_paths |relative_paths, root_absolute, root_text|:
                input_path: Path = path_join(root_absolute, relative)
                if not is_file(input_path) or not is_readable(input_path):
                    _ = write_stderr(f"hash audit: missing {display_path(root_text, relative)}\n")
                    return 1i64

            for relative in relative_paths |relative_paths, root_absolute, root_text, source_sizes, total_bytes|:
                input_display: sview = display_path(root_text, relative)
                input_path: Path = path_join(root_absolute, relative)
                source_size: usize = try file_size(input_path) else err:
                    _ = write_stderr(f"hash audit: missing {input_display}\n")
                    return 1i64
                if source_size > Limits::SOURCE_BYTES or source_size > Limits::TOTAL_SOURCE_BYTES - total_bytes:
                    _ = write_stderr(f"hash audit: source exceeds audit limit: {input_display}\n")
                    return 2i64
                total_bytes <- total_bytes + source_size
                source_sizes.push(source_size)

            for relative in relative_paths |relative_paths, root_absolute, root_text, source_sizes, sources|:
                input_display: sview = display_path(root_text, relative)
                input_path: Path = path_join(root_absolute, relative)
                source_index: usize = sources.count
                catch read_source(input_path, source_sizes[source_index]):
                    ok source:
                        sources.push(source)
                    error failure:
                        if failure == AuditReadError.LimitExceeded:
                            _ = write_stderr(f"hash audit: source exceeds audit limit: {input_display}\n")
                            return 2i64
                        _ = write_stderr(f"hash audit: missing {input_display}\n")
                        return 1i64

            model: sview = sources[0]
            ir: sview = sources[1]
            fixture: sview = sources[2]
            docs: sview = sources[3]
            ledger: sview = sources[4]

            if not has_prefix_line(model, "module EsHash:"):
                return 1i64
            if ir.index("include \"../runtime/hash_model.elisa\"") < 0:
                return 1i64

            declarations: darray[sview] = [
                "const enum HashAlgorithm of u8",
                "const enum HashState of u8",
                "const enum HashEvent of u8",
                "struct HashPolicy:",
                "struct HashDigest:",
                "struct HashContext:",
                "error HashError:",
                "def hash_wrapping_multiply_u64(",
                "def hash_wrapping_add_u64(",
                "def hash_multiply_low64(",
                "def validate_hash_context(",
                "def advance_hash("
            ]
            if not contains_all(model, declarations):
                return 1i64

            boundaries: darray[sview] = [
                "Limits::INPUT_BYTES",
                "Limits::CHUNK_BYTES",
                "Limits::CHUNKS",
                "HashAlgorithm.Sha256",
                "HashAlgorithm.Sha512",
                "HashError.DigestAlgorithmMismatch",
                "HashError.DigestAlreadyPublished",
                "hash_digest_unpublished_valid",
                "DigestAlreadyPublished if not hash_digest_unpublished_valid",
                "HashError.InputLimitExceeded",
                "HashError.AccountingInvalid",
                "left_low: u64 = left & HashArithmetic::LOW_WORD_MASK",
                "cross_low <- cross_low + ((left_high * right_low) & HashArithmetic::LOW_WORD_MASK)",
                "return (high_word << 32) | (low_product & HashArithmetic::LOW_WORD_MASK)",
                "return left - distance_to_max - 1u64",
                "context.chunks_seen == 0 and context.bytes_seen != 0",
                "context.chunks_seen != 0 and context.bytes_seen == 0",
                "digest.word1 == 0"
            ]
            if not contains_all(model, boundaries):
                return 1i64

            fixture_patterns: darray[sview] = [
                "using EsHash",
                "hash_modular_arithmetic_is_explicit_and_checked_safe",
                "hash_wrapping_multiply_u64",
                "typed_hash_contract_bounds_chunks_and_publishes_one_digest",
                "HashAlgorithm.Sha256",
                "HashError.DigestAlgorithmMismatch",
                "HashState.Finalized",
                "HashError.AccountingInvalid"
            ]
            if not contains_all(fixture, fixture_patterns):
                return 1i64
            return 1i64 if docs.index("EsHash::HashContext") < 0
            return 1i64 if ledger.index("ES-SCRIPT-051") < 0

            print("hash audit: bounded incremental algorithms, chunks, and one-shot digest publication are present")
            return 0i64


        def run_default() -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Blocking.IO, Directory.Read, File.Read, Unsafe.PointerCast]:
            script_path: Path = Script::source_path()
            script_directory: Path = try path_real(path_absolute(script_path.parent())) else err:
                _ = write_stderr("hash audit: missing repository root\n")
                return 1i64
            return run(script_directory.parent())


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Blocking.IO, Directory.Read, File.Read, Unsafe.PointerCast]:
    return EsHashAudit::run_default()
