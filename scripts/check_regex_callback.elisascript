# Bounded Elisascript port of check_regex_callback.sh.
# It scans repository source as data and never launches rg or another child.

include "../src/runtime/bounded_text_posix.elisa"

using EsBoundedText


module EsRegexCallbackAudit:
    private:
        const module Limits:
            SOURCE_BYTES: usize = 16777216
            TOTAL_SOURCE_BYTES: usize = 33554432


        const module Inputs:
            MODEL: sview = "src/runtime/regex_callback_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            RUNTIME_FIXTURE: sview = "test/runtime/regex_callback_model_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Diagnostics:
            MISSING_ROOT: sview = "regex callback audit: missing repository root"
            MISSING_PREFIX: sview = "regex callback audit: missing "
            TOO_LARGE_PREFIX: sview = "regex callback audit: source exceeds audit limit: "
            CHANGED_PREFIX: sview = "regex callback audit: source changed during audit: "
            READ_FAILED_PREFIX: sview = "regex callback audit: unable to read source: "
            SUCCESS: sview = "regex callback audit: bounded span accounting, callback output, and zero-width progress are present"


        error AuditReadError:
            Missing
            LimitExceeded
            Changed
            ReadFailed


        def display_path(root: sview, relative: sview) -> sview:
            return "/" + relative if root == "/"
            return root + "/" + relative


        def write_diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_prefix_line(source: sview, prefix: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            lines: darray[sview] = split_lines(source)
            for line in lines:
                return true if line.startswith(prefix)
            return false


        def contains_all(source: sview, required: darray[sview]) -> bool:
            for needle in required:
                return false if source.index(needle) < 0
            return true


        def read_source(input_path: Path, source_size: usize) -> sview error[AuditReadError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Unsafe.PointerCast]:
            current_size: usize = try file_size(input_path) else err:
                raise AuditReadError.Missing
            raise AuditReadError.LimitExceeded if current_size > Limits::SOURCE_BYTES
            raise AuditReadError.Changed if current_size != source_size
            source: mutable sview = ""
            catch EsBoundedText::read_utf8(input_path, Limits::SOURCE_BYTES):
                ok contents:
                    source <- contents
                error failure:
                    if failure == EsBoundedText::ReadError.LimitExceeded:
                        raise AuditReadError.LimitExceeded
                    if failure == EsBoundedText::ReadError.Changed:
                        raise AuditReadError.Changed
                    raise AuditReadError.ReadFailed
            raise AuditReadError.LimitExceeded if len(source) > Limits::SOURCE_BYTES
            raise AuditReadError.Changed if len(source) != source_size
            return source


    public:
        def run(repository_root: Path) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Blocking.IO, Directory.Read, File.Read, Unsafe.PointerCast]:
            if not is_directory(repository_root):
                write_diagnostic(Diagnostics::MISSING_ROOT)
                return 1i64
            root_absolute: Path = try path_real(path_absolute(repository_root)) else err:
                write_diagnostic(Diagnostics::MISSING_ROOT)
                return 1i64
            root_text: sview = f"{root_absolute}"
            relative_paths: darray[sview] = [Inputs::MODEL, Inputs::IR, Inputs::FIXTURE, Inputs::RUNTIME_FIXTURE, Inputs::DOCS, Inputs::LEDGER]
            source_sizes: mutable darray[usize] = []
            sources: mutable darray[sview] = []
            total_bytes: mutable usize = 0

            # Like the shell reference, report unavailable paths before
            # checking aggregate size or reading any complete source.
            for relative in relative_paths |relative_paths, root_absolute, root_text|:
                input_path: Path = path_join(root_absolute, relative)
                if not is_file(input_path) or not is_readable(input_path):
                    write_diagnostic(Diagnostics::MISSING_PREFIX + display_path(root_text, relative))
                    return 1i64

            for relative in relative_paths |relative_paths, root_absolute, root_text, source_sizes, total_bytes|:
                input_path: Path = path_join(root_absolute, relative)
                input_display: sview = display_path(root_text, relative)
                source_size: usize = try file_size(input_path) else err:
                    write_diagnostic(Diagnostics::MISSING_PREFIX + input_display)
                    return 1i64
                if source_size > Limits::SOURCE_BYTES or source_size > Limits::TOTAL_SOURCE_BYTES - total_bytes:
                    write_diagnostic(Diagnostics::TOO_LARGE_PREFIX + input_display)
                    return 2i64
                total_bytes <- total_bytes + source_size
                source_sizes.push(source_size)

            for relative in relative_paths |relative_paths, root_absolute, root_text, source_sizes, sources|:
                input_path: Path = path_join(root_absolute, relative)
                input_display: sview = display_path(root_text, relative)
                source_index: usize = sources.count
                catch read_source(input_path, source_sizes[source_index]):
                    ok source:
                        sources.push(source)
                    error failure:
                        if failure == AuditReadError.Missing:
                            write_diagnostic(Diagnostics::MISSING_PREFIX + input_display)
                            return 1i64
                        if failure == AuditReadError.LimitExceeded:
                            write_diagnostic(Diagnostics::TOO_LARGE_PREFIX + input_display)
                            return 2i64
                        if failure == AuditReadError.Changed:
                            write_diagnostic(Diagnostics::CHANGED_PREFIX + input_display)
                            return 2i64
                        write_diagnostic(Diagnostics::READ_FAILED_PREFIX + input_display)
                        return 2i64

            model: sview = sources[0]
            ir: sview = sources[1]
            fixture: sview = sources[2]
            runtime_fixture: sview = sources[3]
            docs: sview = sources[4]
            ledger: sview = sources[5]

            return 1i64 if not has_prefix_line(model, "module EsRegexCallback:")
            return 1i64 if ir.index("include \"../runtime/regex_callback_model.elisa\"") < 0

            declarations: darray[sview] = [
                "const enum RegexCallbackState of u8",
                "const enum RegexCallbackEvent of u8",
                "struct RegexCallbackPolicy:",
                "struct RegexCallbackSession:",
                "error RegexCallbackError:",
                "def validate_regex_callback(",
                "def advance_regex_callback("
            ]
            if not contains_all(model, declarations):
                return 1i64

            boundaries: darray[sview] = [
                "REGEX_CALLBACK_MAX_MATCHES",
                "REGEX_CALLBACK_MAX_CAPTURES",
                "REGEX_CALLBACK_MAX_INPUT_BYTES",
                "REGEX_CALLBACK_MAX_OUTPUT_BYTES",
                "regex_callback_add_fits",
                "pending",
                "pending_output_before",
                "replaced_input_bytes: usize = 0",
                "replacement_total_bytes: usize = 0",
                "session.pending_output_before <- session.output_bytes",
                "session.pending_output_before <- 0",
                "session.pending_start <- 0",
                "session.pending_end <- 0",
                "session.has_last_zero <- false",
                "session.last_zero_start <- 0",
                "pending_prefix_bytes",
                "expected_pending_output",
                "accounting_position: usize = session.pending_start if session.pending else session.cursor",
                "session.output_bytes + session.replaced_input_bytes != accounting_position + session.replacement_total_bytes",
                "session.cursor <- session.pending_start if session.pending",
                "has_last_zero",
                "RegexCallbackError.NonProgress",
                "RegexCallbackError.ReplacementNotReady",
                "RegexCallbackError.OutputLimitExceeded",
                "RegexCallbackError.AccountingInvalid",
                "not session.policy.global and session.matches > 1",
                "session.matches == 0 and (session.captures != 0 or session.replaced_input_bytes != 0 or session.replacement_total_bytes != 0 or session.has_last_zero)",
                "not session.has_last_zero and session.last_zero_start != 0",
                "session.has_last_zero and session.last_zero_start > session.input_bytes",
                "session.state == RegexCallbackState.Complete and session.cursor != session.input_bytes",
                "session.state == RegexCallbackState.Matching and session.matches == 0",
                "session.matches != 0 and not session.pending and session.cursor == 0",
                "at_consumed_eof: bool = session.cursor == session.input_bytes and session.last_zero_start == session.input_bytes",
                "session.cursor <- session.input_bytes",
                "policy.max_captures != 0",
                "session.pending and session.state != RegexCallbackState.Matching",
                "session.pending and session.pending_start < session.cursor",
                "RegexCallbackEvent.Match",
                "RegexCallbackEvent.Replace",
                "RegexCallbackState.Complete"
            ]
            if not contains_all(model, boundaries):
                return 1i64

            runtime_fixture_patterns: darray[sview] = [
                "regex_callback_rejects_match_count_without_span_progress",
                "regex_callback_rejects_forged_pending_prefix_accounting",
                "regex_callback_rejects_zero_width_marker_ahead_of_cursor",
                "regex_callback_accepts_empty_input_zero_width_match_at_eof",
                "regex_callback_abort_clears_unconsumed_zero_width_match",
                "regex_callback_uses_matcher_supplied_zero_width_advance",
                "regex_callback_rejects_missing_or_oversized_zero_width_advance",
                "regex_callback_rejects_forged_completed_output_accounting",
                "zero_width_advance_bytes: usize = 0",
                "raise RegexCallbackError.NonProgress if zero_width_advance_bytes == 0",
                "session.cursor <- session.pending_start + preserved"
            ]
            if not contains_all(runtime_fixture, runtime_fixture_patterns):
                return 1i64
            return 1i64 if fixture.index("zero_width_advance_bytes: 1") < 0
            return 1i64 if fixture.index("assert zero.output_bytes == 2") < 0

            fixture_patterns: darray[sview] = [
                "using EsRegexCallback",
                "typed_regex_callback_contract_accounts_spans_and_zero_width_progress",
                "RegexCallbackEvent.Match",
                "RegexCallbackEvent.Replace",
                "RegexCallbackError.NonProgress",
                "RegexCallbackError.MatchLimitExceeded",
                "RegexCallbackError.AccountingInvalid",
                "forged_pending",
                "forged_matching_prefix",
                "forged_pending_order",
                "forged_zero_marker",
                "forged_zero_offset",
                "forged_complete_cursor",
                "forged_complete_captures",
                "forged_complete_zero_marker",
                "forged_non_global_multiple_matches",
                "zero_capture_policy"
            ]
            return 1i64 if not contains_all(fixture, fixture_patterns)
            return 1i64 if docs.index("EsRegexCallback::RegexCallbackSession") < 0
            return 1i64 if ledger.index("ES-SCRIPT-035") < 0

            print(Diagnostics::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Blocking.IO, Directory.Read, File.Read, Unsafe.PointerCast]:
            script_path: Path = Script::source_path()
            script_directory: Path = try path_real(path_absolute(script_path.parent())) else err:
                write_diagnostic(Diagnostics::MISSING_ROOT)
                return 1i64
            return run(script_directory.parent())


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Blocking.IO, Directory.Read, File.Read, Unsafe.PointerCast]:
    return EsRegexCallbackAudit::run_default()
