# Streaming Elisascript port of check_source_map_model.sh.
# Keep the shell oracle until its public-launcher parity contract is qualified.

include "./shell_invocation_path.elisascript"

module EsSourceMapModelAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/source_map_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"


        const module Patterns:
            MODULE: sview = "module EsSourceMap:"
            ENTRY_LIMIT: sview = "Limits::ENTRIES"
            FORMAT_VERSION: sview = "Format::VERSION"
            MAP_STATE: sview = "const enum SourceMapState of u8:"
            MAP_EVENT: sview = "const enum SourceMapEvent of u8:"
            SOURCE_LOCATION: sview = "struct SourceLocation:"
            MAP_ENTRY: sview = "struct SourceMapEntry:"
            SOURCE_MAP: sview = "struct SourceMap:"
            MAP_ERROR: sview = "error SourceMapContractError:"
            VALIDATE_MAP: sview = "def validate_source_map("
            ADVANCE_MAP: sview = "def advance_source_map("
            LOOKUP_MAP: sview = "def source_map_lookup("
            ENTRY_ORDER_INVALID: sview = "EntryOrderInvalid"
            DUPLICATE_FILE: sview = "DuplicateFile"
            FILE_INDEX_INVALID: sview = "FileIndexInvalid"
            ADD_FILE_EVENT: sview = "SourceMapEvent.AddFile"
            FILE_LIMIT: sview = "map.files.count >= Limits::FILES"
            EMPTY_MAP: sview = "map.state == SourceMapState.Empty"
            APPEND_NOT_READY: sview = "AppendNotReady"
            LOCATION_ORDER: sview = "source_location_before"
            INVALID_MAP: sview = "map.state == SourceMapState.Invalid"
            MODEL_IMPORT: sview = "include \"../runtime/source_map_model.elisa\""
            FIXTURE_CONTRACT: sview = "typed_source_map_contract_orders_locations_and_supports_lookup"
            FIXTURE_BEGIN: sview = "SourceMapEvent.Begin"
            FIXTURE_SEAL: sview = "SourceMapEvent.Seal"
            FIXTURE_APPEND_NOT_READY: sview = "SourceMapContractError.AppendNotReady"
            FIXTURE_FORGED_EMPTY: sview = "forged_empty"
            DOCS_LAYER: sview = "`EsSourceMap` gives diagnostics and navigation a bounded identity layer"


        const module Messages:
            MISSING_ROOT: sview = "source map audit: missing repository root"
            UNRESOLVED_ROOT: sview = "source map audit: unable to resolve repository root"
            MISSING_INPUT: sview = "source map audit: missing "
            RG_UNAVAILABLE: sview = "source map audit: unable to run rg"
            RG_FAILED_TO_RUN: sview = "source map audit: rg failed to run"


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(model: Path, ir: Path, fixture: Path, docs: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: model, pattern: Patterns::MODULE},
                SearchCheck{input: model, pattern: Patterns::ENTRY_LIMIT},
                SearchCheck{input: model, pattern: Patterns::FORMAT_VERSION},
                SearchCheck{input: model, pattern: Patterns::MAP_STATE},
                SearchCheck{input: model, pattern: Patterns::MAP_EVENT},
                SearchCheck{input: model, pattern: Patterns::SOURCE_LOCATION},
                SearchCheck{input: model, pattern: Patterns::MAP_ENTRY},
                SearchCheck{input: model, pattern: Patterns::SOURCE_MAP},
                SearchCheck{input: model, pattern: Patterns::MAP_ERROR},
                SearchCheck{input: model, pattern: Patterns::VALIDATE_MAP},
                SearchCheck{input: model, pattern: Patterns::ADVANCE_MAP},
                SearchCheck{input: model, pattern: Patterns::LOOKUP_MAP},
                SearchCheck{input: model, pattern: Patterns::ENTRY_ORDER_INVALID},
                SearchCheck{input: model, pattern: Patterns::DUPLICATE_FILE},
                SearchCheck{input: model, pattern: Patterns::FILE_INDEX_INVALID},
                SearchCheck{input: model, pattern: Patterns::ADD_FILE_EVENT},
                SearchCheck{input: model, pattern: Patterns::FILE_LIMIT},
                SearchCheck{input: model, pattern: Patterns::EMPTY_MAP},
                SearchCheck{input: model, pattern: Patterns::APPEND_NOT_READY},
                SearchCheck{input: model, pattern: Patterns::LOCATION_ORDER},
                SearchCheck{input: model, pattern: Patterns::INVALID_MAP},
                SearchCheck{input: ir, pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_BEGIN},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_SEAL},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_APPEND_NOT_READY},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_FORGED_EMPTY},
                SearchCheck{input: docs, pattern: Patterns::DOCS_LAYER}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Environment.Read, File.Read, Directory.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            rg: Executable = try executable("rg") else err:
                diagnostic(Messages::RG_UNAVAILABLE)
                return 127i64
            for check in checks:
                arguments: darray[sview] = ["-Fq", check.pattern, f"{check.input}"]
                status: i64 = try run_process(rg, arguments, 0i64) else err:
                    diagnostic(Messages::RG_FAILED_TO_RUN)
                    return 127i64
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return 1i64
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return 1i64

            status: i64 = execute(searches(inputs[0], inputs[1], inputs[2], inputs[3]))
            return status if status != 0i64

            print("source map audit: bounded file identity, ordered locations, sealing, and lookup are present")
            return 0i64


        def run_default() -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsSourceMapModelAudit::run_default()
