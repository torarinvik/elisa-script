# Bounded Elisascript port of check_regex_model.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsRegexModelAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/regex_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            RUNTIME_FIXTURE: sview = "test/runtime/regex_model_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "module EsRegex:"
            PATTERN_BYTES: sview = "Limits::PATTERN_BYTES"
            INPUT_BYTES: sview = "Limits::INPUT_BYTES"
            REPLACEMENT_BYTES: sview = "Limits::REPLACEMENT_BYTES"
            GROUPS: sview = "Limits::GROUPS"
            MATCHES: sview = "Limits::MATCHES"
            WORK: sview = "Limits::WORK"
            OPERATION: sview = "const enum RegexOperation of u8:"
            STATE: sview = "const enum RegexState of u8:"
            EVENT: sview = "const enum RegexEvent of u8:"
            POLICY: sview = "struct RegexPolicy:"
            REQUEST: sview = "struct RegexRequest:"
            SESSION: sview = "struct RegexSession:"
            ERROR: sview = "error RegexContractError:"
            VALIDATE_POLICY: sview = "def validate_regex_policy("
            VALIDATE_REQUEST: sview = "def validate_regex_request("
            VALIDATE_SESSION: sview = "def validate_regex_session("
            ADVANCE: sview = "def advance_regex_session("
            TEXT_VALID: sview = "regex_text_valid"
            PATTERN_LIMIT: sview = "PatternLimitExceeded"
            INPUT_LIMIT: sview = "InputLimitExceeded"
            REPLACEMENT_NOT_ALLOWED: sview = "ReplacementNotAllowed"
            GLOBAL_POLICY_INVALID: sview = "GlobalPolicyInvalid"
            FIND_ALL_REQUIRES_GLOBAL: sview = "(request.operation == RegexOperation.FindAll or request.operation == RegexOperation.Split) and not request.global"
            SEARCH_REJECTS_GLOBAL: sview = "(request.operation == RegexOperation.Search or request.operation == RegexOperation.Match or request.operation == RegexOperation.FullMatch) and request.global"
            REPLACE_INVALID: sview = "InvalidOperation if session.request.operation == RegexOperation.Replace"
            GROUP_LIMIT: sview = "GroupLimitExceeded"
            MATCH_LIMIT: sview = "MatchLimitExceeded"
            CAPTURE_ACCOUNTING: sview = "CaptureAccountingInvalid"
            WORK_LIMIT: sview = "WorkLimitExceeded"
            OUTPUT_LIMIT: sview = "OutputLimitExceeded"
            NON_GLOBAL_MATCH: sview = "not session.request.global and session.matches != 0"
            NON_GLOBAL_MULTIPLE_MATCHES: sview = "not session.request.global and session.matches > 1"
            WORK_WITHOUT_OUTPUT: sview = "work_delta != 0 and capture_delta == 0 and output_delta == 0"
            END_NOT_READY: sview = "EndNotReady"
            CANCEL_NOT_READY: sview = "CancelNotReady"
            RUNTIME_GLOBAL_POLICY: sview = "regex_request_global_policy_matches_operation_shape"
            RUNTIME_FIND_ALL_GLOBAL: sview = "find_all_without_global"
            RUNTIME_SPLIT_GLOBAL: sview = "split_without_global"
            RUNTIME_FORGED_NON_GLOBAL: sview = "regex_session_rejects_forged_repeated_non_global_match_count"
            RUNTIME_ZERO_WORK: sview = "zero_work_rejected"
            MODEL_IMPORT: sview = "include \"../runtime/regex_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsRegex"
            FIXTURE_CONTRACT: sview = "typed_regex_session_contract_bounds_work_captures_and_replacements"
            FIXTURE_SEARCH: sview = "RegexOperation.Search"
            FIXTURE_REPLACE: sview = "RegexOperation.Replace"
            FIXTURE_MATCH: sview = "RegexEvent.Match"
            FIXTURE_EVENT_REPLACE: sview = "RegexEvent.Replace"
            FIXTURE_CANCEL_ACK: sview = "RegexEvent.CancelAck"
            FIXTURE_REPLACE_REJECTED: sview = "replace_match_rejected"
            DOCS_PUBLIC_LIMITS: sview = "EsRegex exposes the same limits as a public adapter contract"
            LEDGER_ITEM: sview = "ES-SCRIPT-012 | EsRegex"


        const module Messages:
            MISSING_ROOT: sview = "regex model audit: missing repository root"
            UNRESOLVED_ROOT: sview = "regex model audit: unable to resolve repository root"
            MISSING_INPUT: sview = "regex model audit: missing "
            READ_FAILED: sview = "regex model audit: unable to read source: "
            SUCCESS: sview = "regex model audit: operation identity, pattern/input/replacement limits, work/capture/output accounting, and cancellation are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::PATTERN_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::INPUT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::REPLACEMENT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::GROUPS},
                SearchCheck{input: inputs[0], pattern: Patterns::MATCHES},
                SearchCheck{input: inputs[0], pattern: Patterns::WORK},
                SearchCheck{input: inputs[0], pattern: Patterns::OPERATION},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_REQUEST},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::PATTERN_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::INPUT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::REPLACEMENT_NOT_ALLOWED},
                SearchCheck{input: inputs[0], pattern: Patterns::GLOBAL_POLICY_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::FIND_ALL_REQUIRES_GLOBAL},
                SearchCheck{input: inputs[0], pattern: Patterns::SEARCH_REJECTS_GLOBAL},
                SearchCheck{input: inputs[0], pattern: Patterns::REPLACE_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::GROUP_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::MATCH_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::CAPTURE_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::WORK_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::NON_GLOBAL_MATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::NON_GLOBAL_MULTIPLE_MATCHES},
                SearchCheck{input: inputs[0], pattern: Patterns::WORK_WITHOUT_OUTPUT},
                SearchCheck{input: inputs[0], pattern: Patterns::END_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_NOT_READY},
                SearchCheck{input: inputs[3], pattern: Patterns::RUNTIME_GLOBAL_POLICY},
                SearchCheck{input: inputs[3], pattern: Patterns::RUNTIME_FIND_ALL_GLOBAL},
                SearchCheck{input: inputs[3], pattern: Patterns::RUNTIME_SPLIT_GLOBAL},
                SearchCheck{input: inputs[3], pattern: Patterns::RUNTIME_FORGED_NON_GLOBAL},
                SearchCheck{input: inputs[3], pattern: Patterns::RUNTIME_ZERO_WORK},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_SEARCH},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_REPLACE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_MATCH},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_EVENT_REPLACE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CANCEL_ACK},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_REPLACE_REJECTED},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_PUBLIC_LIMITS},
                SearchCheck{input: inputs[5], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::RUNTIME_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsRegexModelAudit::run_default()
