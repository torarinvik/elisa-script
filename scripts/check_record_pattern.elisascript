# Bounded Elisascript port of check_record_pattern.sh.
# Regex source checks stream through the shared line scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsRecordPatternAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/record_pattern_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsRecordPattern:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/record_pattern_model\.elisa\""
            STATE: Regex = regex"const enum RecordPatternState of u8"
            PREDICATE_KIND: Regex = regex"const enum RecordPatternPredicateKind of u8"
            ACTION: Regex = regex"const enum RecordPatternAction of u8"
            CLAUSE: Regex = regex"struct RecordPatternClause:"
            RECORD_POLICY: Regex = regex"record_policy: RecordStreamPolicy"
            OBSERVATION: Regex = regex"struct RecordPatternObservation:"
            DECISION: Regex = regex"struct RecordPatternDecision:"
            SESSION: Regex = regex"struct RecordPatternSession:"
            ERROR: Regex = regex"error RecordPatternError:"
            VALIDATE: Regex = regex"def validate_record_pattern_session\("
            ADVANCE: Regex = regex"def advance_record_pattern\("
            CLAUSES_LIMIT: Regex = regex"Limits::CLAUSES"
            RECORDS_LIMIT: Regex = regex"Limits::RECORDS"
            MATCH_WORK_LIMIT: Regex = regex"Limits::MATCH_WORK"
            MAX_MATCH_WORK: Regex = regex"max_match_work"
            CHARGE_MATCH_WORK: Regex = regex"record_pattern_charge_match_work"
            TEXT_EQUAL: Regex = regex"record_pattern_text_equal"
            TEXT_CONTAINS: Regex = regex"record_pattern_text_contains"
            MATCH_WORK_EXCEEDED: Regex = regex"RecordPatternError.MatchWorkLimitExceeded"
            MATCH_WORK_ACCOUNTING: Regex = regex"MatchWorkAccountingInvalid"
            DERIVED_MATCH_WORK: Regex = regex"derived_match_work"
            DECISION_WORK_BOUND: Regex = regex"decision.match_work <= derived_match_work"
            RECORD_MATCH_WORK: Regex = regex"match_work: record_match_work"
            NEEDLE_MATCH_LOOP: Regex = regex"while offset < sview_len(needle) and matched"
            EXTERNAL_PREDICATE: Regex = regex"RecordPatternPredicateKind.External"
            RECORD_EVENT: Regex = regex"RecordPatternEvent.Record"
            OBSERVATION_SHAPE: Regex = regex"RecordPatternError.ObservationShapeInvalid"
            ACCOUNTING_INVALID: Regex = regex"RecordPatternError.AccountingInvalid"
            ACTIVE_CLAUSE_END: Regex = regex"clause_state == RecordPatternClauseState.Active and not session.clauses[index].has_end"
            RECORD_NUMBER_ORDER: Regex = regex"decision.record_number <= session.decisions[index - 1].record_number"
            END_NOT_READY: Regex = regex"RecordPatternError.EndNotReady"
            PREDICATE_VALID: Regex = regex"record_pattern_predicate_valid(clause.end, policy)"
            PROCESSED_RECORDS: Regex = regex"session.decisions.count != session.processed_records"
            ACTIVE_CLAUSE: Regex = regex"RecordPatternClauseState.Active"
            FIXTURE_IMPORT: Regex = regex"using EsRecordPattern"
            FIXTURE_CONTRACT: Regex = regex"typed_record_pattern_contract_selects_inclusive_ranges"
            FIXTURE_RECORD_EQUALS: Regex = regex"RecordPatternPredicateKind.RecordNumberEquals"
            FIXTURE_OBSERVATION_SHAPE: Regex = regex"RecordPatternError.ObservationShapeInvalid"
            FIXTURE_ACCOUNTING: Regex = regex"RecordPatternError.AccountingInvalid"
            SESSION_RECORD_POLICY: Regex = regex"session.policy.record_policy"
            PRESERVED_POLICY: Regex = regex"preserved_policy"
            PRESERVED_OBSERVATION: Regex = regex"preserved_observation"
            REJECTED_SEPARATOR: Regex = regex"rejected_separator_session"
            FORGED_ACCOUNTING: Regex = regex"forged_accounting"
            FORGED_RECORD_ORDER: Regex = regex"forged_record_order"
            DUPLICATE_RECORD_ORDER: Regex = regex"duplicate_record_order"
            HIDDEN_END_PAYLOAD: Regex = regex"hidden_end_payload"
            ACTIVE_WITHOUT_END: Regex = regex"active_without_end_rejected"
            INVALID_CLAUSE: Regex = regex"RecordPatternError.InvalidClause"
            SELECTED: Regex = regex"record_pattern_selected"
            BOUNDARY_POLICY: Regex = regex"boundary_pattern_policy"
            BOUNDED_MATCH_SESSION: Regex = regex"bounded_match_session"
            MATCH_WORK_REJECTED: Regex = regex"match_work_rejected"
            FORGED_MATCH_WORK: Regex = regex"forged_match_work"
            MISSING_DECISION_WORK: Regex = regex"missing_decision_work"
            FIXTURE_MATCH_WORK_ACCOUNTING: Regex = regex"RecordPatternError.MatchWorkAccountingInvalid"
            SESSION_MATCH_WORK: Regex = regex"session.match_work == 4"
            EQUAL_SESSION_MATCH_WORK: Regex = regex"equal_session.match_work == 5"
            RANGE_SESSION_MATCH_WORK: Regex = regex"range_work_session.match_work == 4"
            MAX_TEXT_BYTES: Regex = regex"max_text_bytes: 4"
            SELECTED_RECORD: Regex = regex"record_selected: mutable bool = false"
            MULTI_CLAUSES: Regex = regex"multi_clauses"
            TEXT_LENGTH_LIMIT: Regex = regex"sview_len\(value\) <= policy\.max_text_bytes"
            DOCS_SESSION: Regex = regex"EsRecordPattern::RecordPatternSession"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-039"


        const module Messages:
            MISSING_ROOT: sview = "record pattern audit: missing repository root"
            UNRESOLVED_ROOT: sview = "record pattern audit: unable to resolve repository root"
            MISSING_INPUT: sview = "record pattern audit: missing "
            READ_FAILED: sview = "record pattern audit: unable to read source: "
            SUCCESS: sview = "record pattern audit: bounded pattern/action and inclusive-range selection are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::PREDICATE_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::ACTION},
                SearchCheck{input: inputs[0], pattern: Patterns::CLAUSE},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::OBSERVATION},
                SearchCheck{input: inputs[0], pattern: Patterns::DECISION},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::CLAUSES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORDS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::MATCH_WORK_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_MATCH_WORK},
                SearchCheck{input: inputs[0], pattern: Patterns::CHARGE_MATCH_WORK},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_CONTAINS},
                SearchCheck{input: inputs[0], pattern: Patterns::MATCH_WORK_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::MATCH_WORK_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::DERIVED_MATCH_WORK},
                SearchCheck{input: inputs[0], pattern: Patterns::DECISION_WORK_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_MATCH_WORK},
                SearchCheck{input: inputs[0], pattern: Patterns::NEEDLE_MATCH_LOOP},
                SearchCheck{input: inputs[0], pattern: Patterns::EXTERNAL_PREDICATE},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::OBSERVATION_SHAPE},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTING_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::ACTIVE_CLAUSE_END},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_NUMBER_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::END_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::PREDICATE_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::PROCESSED_RECORDS},
                SearchCheck{input: inputs[0], pattern: Patterns::ACTIVE_CLAUSE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_RECORD_EQUALS},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_OBSERVATION_SHAPE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ACCOUNTING},
                SearchCheck{input: inputs[2], pattern: Patterns::SESSION_RECORD_POLICY},
                SearchCheck{input: inputs[2], pattern: Patterns::PRESERVED_POLICY},
                SearchCheck{input: inputs[2], pattern: Patterns::PRESERVED_OBSERVATION},
                SearchCheck{input: inputs[2], pattern: Patterns::REJECTED_SEPARATOR},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_ACCOUNTING},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_RECORD_ORDER},
                SearchCheck{input: inputs[2], pattern: Patterns::DUPLICATE_RECORD_ORDER},
                SearchCheck{input: inputs[2], pattern: Patterns::HIDDEN_END_PAYLOAD},
                SearchCheck{input: inputs[2], pattern: Patterns::ACTIVE_WITHOUT_END},
                SearchCheck{input: inputs[2], pattern: Patterns::INVALID_CLAUSE},
                SearchCheck{input: inputs[2], pattern: Patterns::SELECTED},
                SearchCheck{input: inputs[2], pattern: Patterns::BOUNDARY_POLICY},
                SearchCheck{input: inputs[2], pattern: Patterns::BOUNDED_MATCH_SESSION},
                SearchCheck{input: inputs[2], pattern: Patterns::MATCH_WORK_REJECTED},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_MATCH_WORK},
                SearchCheck{input: inputs[2], pattern: Patterns::MISSING_DECISION_WORK},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_MATCH_WORK_ACCOUNTING},
                SearchCheck{input: inputs[2], pattern: Patterns::SESSION_MATCH_WORK},
                SearchCheck{input: inputs[2], pattern: Patterns::EQUAL_SESSION_MATCH_WORK},
                SearchCheck{input: inputs[2], pattern: Patterns::RANGE_SESSION_MATCH_WORK},
                SearchCheck{input: inputs[2], pattern: Patterns::MAX_TEXT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::SELECTED_RECORD},
                SearchCheck{input: inputs[2], pattern: Patterns::MULTI_CLAUSES},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_LENGTH_LIMIT},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsRecordPatternAudit::run_default()
