# Bounded Elisascript port of check_streaming_file.sh.
# Line regexes and multiline contracts use the shared bounded source scanner.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsStreamingFileAudit:
    private:
        const module Inputs:
            STREAM: sview = "src/runtime/stream_posix.elisa"
            IR: sview = "src/ir/ir.elisa"
            TESTS: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"


        const module Patterns:
            IR_IMPORT: sview = "include \"\\.\\./runtime/stream_posix\\.elisa\""
            STREAM_ERROR: sview = "^error FileStreamError:"
            OPEN_FAILED: sview = "^    OpenFailed\\(path: cstr\\)$"
            READ_FAILED: sview = "^    ReadFailed\\(path: cstr\\)$"
            WRITE_FAILED: sview = "^    WriteFailed\\(path: cstr\\)$"
            FLUSH_FAILED: sview = "^    FlushFailed\\(path: cstr\\)$"
            INVALID_ENCODING: sview = "^    InvalidEncoding\\(path: cstr\\)$"
            INVALID_UTF8: sview = "^    InvalidUtf8\\(path: cstr\\)$"
            SYNC_FAILED: sview = "^    SyncFailed\\(path: cstr\\)$"
            CLOSE_FAILED: sview = "^    CloseFailed\\(path: cstr\\)$"
            SEEK_FAILED: sview = "^    SeekFailed\\(path: cstr\\)$"
            PUBLISH_FAILED: sview = "^    PublishFailed\\(path: cstr\\)$"
            PATH_COLLISION: sview = "^    PathCollision\\(path: cstr\\)$"
            DIRECTORY_SYNC_FAILED: sview = "^    DirectorySyncFailed\\(path: cstr\\)$"
            PUBLISH_OUTCOME_UNKNOWN: sview = "^    PublishOutcomeUnknown\\(path: cstr\\)$"
            DIRECTORY_SYNC_UNKNOWN: sview = "^    DirectorySyncOutcomeUnknown\\(path: cstr\\)$"
            CLEANUP_STATE_INVALID: sview = "^    CleanupStateInvalid\\(path: cstr\\)$"
            CLOSED: sview = "^    Closed\\(path: cstr\\)$"
            WRONG_MODE: sview = "^    WrongMode\\(path: cstr\\)$"
            LIMIT_EXCEEDED: sview = "^    LimitExceeded\\(path: cstr\\)$"
            PATH_TOO_LONG: sview = "^    PathTooLong\\(path: cstr\\)$"
            LINE_TOO_LONG: sview = "^    LineTooLong\\(path: cstr\\)$"
            INVALID_LINE_MODE: sview = "^    InvalidLineMode\\(path: cstr\\)$"
            DEFAULT_MAX_BYTES: sview = "const FILE_STREAM_DEFAULT_MAX_BYTES: usize = ES_RUNTIME_DEFAULT_MAX_MEMORY_BYTES"
            STREAM_MODE: sview = "^        const enum FileStreamMode of u8:"
            STREAM_STATE: sview = "^        const enum FileStreamState of u8:"
            STREAM_READ: sview = "^        struct FileStreamRead:"
            STREAM_WRITE: sview = "^        struct FileStreamWrite:"
            STREAM_STRUCT: sview = "^        struct FileStream:"
            OPEN_FUNCTION: sview = "def file_stream_open\\("
            DEFAULT_ENCODING: sview = "encoding: FileStreamEncoding = FileStreamEncoding.Auto"
            RESOLVED_ENCODING: sview = "resolved_encoding: FileStreamEncoding"
            MAX_PATH_BYTES: sview = "const FILE_STREAM_MAX_PATH_BYTES: usize = 4096"
            PATH_TERMINATED: sview = "def file_stream_path_terminated\\("
            PATH_EQUAL: sview = "def file_stream_path_equal\\("
            FIRST_BYTE_NUL: sview = "return false if bytes\\[0\\] == 0"
            PATH_TERMINATED_CHECK: sview = "PathTooLong\\(path\\) if not file_stream_path_terminated\\(path\\)"
            LINE_MODE: sview = "^        const enum FileStreamLineMode of u8:"
            ENCODING: sview = "^        const enum FileStreamEncoding of u8:"
            SEEK_ORIGIN: sview = "^        const enum FileStreamSeekOrigin of u8:"
            RECORD_STATE: sview = "^        const enum FileStreamRecordState of u8:"
            BYTE_STATE: sview = "^        const enum FileStreamByteState of u8:"
            WRITE_STATE: sview = "^        const enum FileStreamWriteState of u8:"
            WRITE_TRANSITION: sview = "def file_stream_write_transition\\("
            READ_BYTE: sview = "def file_stream_read_byte\\("
            READ_COUNT: sview = "read_count: usize = fread"
            READ_COUNT_BOUND: sview = "read_count > remaining or ferror\\(handle\\) != 0"
            READ_AMOUNT_BOUND: sview = "amount > 1 or ferror\\(handle\\) != 0"
            ENCODING_ERROR: sview = "EncodingError"
            MODE_IS_TEXT: sview = "def file_stream_mode_is_text\\("
            MODE_IS_WRITABLE: sview = "def file_stream_mode_is_writable\\("
            ENCODING_VALID: sview = "def file_stream_encoding_valid\\("
            UTF8_FEED: sview = "def file_stream_utf8_feed\\("
            UTF8_VALIDATE: sview = "def file_stream_utf8_validate\\("
            UTF8_CURSOR: sview = "EsEncoding::Utf8Cursor"
            UTF8_INCOMPLETE: sview = "read_count == 0 and stream\\.utf8_remaining != 0"
            RECORD_NEXT: sview = "def file_stream_record_next\\("
            BYTE_LIMIT_BEFORE_READ: sview = "return FileStreamByteState\\.Limit if stream\\.bytes_read >= stream\\.byte_budget\\n            handle: mutable heap void& = stream\\.handle\\n            amount: usize = fread"
            CR_BYTE: sview = "byte != 13"
            PENDING_VALID: sview = "pending_valid"
            LOOKAHEAD: sview = "lookahead"
            READ_CHUNK: sview = "def file_stream_read_chunk\\("
            PENDING_BYTE_CLEAR: sview = "if stream\\.pending_valid:\\n                buffer\\[0\\] <- stream\\.pending_byte\\n                stream\\.pending_valid <- false"
            REMAINING_CAPACITY: sview = "remaining: usize = capacity - count"
            READ_CURSOR: sview = "cursor: mutable u8& = buffer \\+ count"
            WRITE_CHUNK: sview = "def file_stream_write_chunk\\("
            WRITE_OFFSET_LOOP: sview = "offset: mutable usize = 0\\n            while offset < capacity:"
            WRITE_CURSOR: sview = "cursor: mutable u8& = buffer \\+ offset"
            WRITE_COUNT: sview = "write_count: usize = fwrite"
            WRITE_COUNT_BOUND: sview = "amount == 0 or amount > capacity - offset"
            WRITE_ERROR_STATE: sview = "state == FileStreamWriteState\\.Error"
            FERROR_HANDLE: sview = "ferror\\(handle\\) != 0"
            BYTES_WRITTEN: sview = "stream\\.bytes_written <- stream\\.bytes_written \\+ offset"
            SYNC: sview = "def file_stream_sync\\("
            FFLUSH: sview = "fflush\\(handle\\)"
            PUBLISH_STAGED: sview = "def file_stream_publish_staged\\("
            UNKNOWN_RENAME: sview = "file_stream_rename_outcome\\(errno\\[0\\]\\) == FileStreamRenameOutcome.Unknown"
            DIRECTORY_SYNC_UNKNOWN_ERROR: sview = "FileStreamError.DirectorySyncOutcomeUnknown\\(directory_path\\)"
            PUBLICATION_TEST: sview = "typed_file_stream_publication_distinguishes_uncertain_rename_outcomes"
            COLLIDING_PATHS: sview = "PathCollision\\(staging_path\\) if file_stream_path_equal\\(staging_path, destination_path\\)"
            POSIX_RENAME: sview = "elisascript_posix_rename\\(staging_path\\.cast\\[u8&\\], destination_path\\.cast\\[u8&\\]\\)"
            POSIX_OPENDIR: sview = "elisascript_posix_opendir\\(directory_path\\)"
            POSIX_CLOSEDIR: sview = "elisascript_posix_closedir\\(opened\\)"
            NON_WRITABLE_MODE: sview = "stream\\.mode != FileStreamMode\\.WriteText and stream\\.mode != FileStreamMode\\.WriteBinary"
            TELL: sview = "def file_stream_tell\\("
            SEEK: sview = "def file_stream_seek\\("
            PENDING_CURRENT: sview = "stream\\.pending_valid and origin == FileStreamSeekOrigin\\.Current"
            SEEK_OFFSET: sview = "seek_offset: mutable i64 = offset"
            MIN_SEEK_ERROR: sview = "raise FileStreamError\\.SeekFailed\\(stream\\.path\\) if offset == -9223372036854775807 - 1"
            SEEK_OFFSET_DECREMENT: sview = "seek_offset <- offset - 1"
            FSEEK: sview = "fseek\\(handle, seek_offset, whence\\)"
            PENDING_BYTE_CLEAR_ASSIGN: sview = "stream\\.pending_byte <- 0"
            UTF8_WRITABLE_SEEK: sview = "stream\\.encoding == FileStreamEncoding\\.Utf8 and stream\\.utf8_remaining != 0 and file_stream_mode_is_writable\\(stream\\.mode\\)"
            READ_LINE_MODE: sview = "def file_stream_read_line_mode\\("
            UNIVERSAL_LINE_MODE: sview = "FileStreamLineMode\\.Universal"
            RETAIN_LINE_MODE: sview = "FileStreamLineMode\\.Retain"
            READ_LINE: sview = "def file_stream_read_line\\("
            CLOSE: sview = "def file_stream_close\\("
            CLEANUP_STATE: sview = "const enum FileStreamCleanupState of u8:"
            CLEANUP_GUARD: sview = "struct FileStreamCleanupGuard:"
            CLEANUP_BEGIN: sview = "def file_stream_cleanup_begin\\("
            CLEANUP_COMMIT: sview = "def file_stream_cleanup_commit\\("
            CLEANUP_ABORT: sview = "def file_stream_cleanup_abort\\("
            GUARD_ARMED: sview = "guard\\.state != FileStreamCleanupState\\.Armed"
            CLOSED_WITH_HANDLE: sview = "stream\\.state == FileStreamState\\.Closed and stream\\.handle != null"
            CLOSED_STATE: sview = "stream\\.state == FileStreamState\\.Closed$"
            HANDLE_NULL: sview = "stream\\.handle == null"
            READ_BUDGET_REMAINING: sview = "remaining > stream\\.byte_budget - stream\\.bytes_read"
            BYTE_BUDGET_WITH_COUNT: sview = "stream\\.bytes_read >= stream\\.byte_budget and count > 0"
            READ_LIMIT_RAISE: sview = "raise FileStreamError\\.LimitExceeded\\(stream\\.path\\) if stream\\.bytes_read >= stream\\.byte_budget"
            WRITE_BUDGET_REMAINING: sview = "capacity > stream\\.byte_budget - stream\\.bytes_written"
            READ_BUDGET_VALIDATION: sview = "stream\\.bytes_read > stream\\.byte_budget\\n            raise FileStreamError\\.LimitExceeded\\(stream\\.path\\) if remaining > stream\\.byte_budget - stream\\.bytes_read"
            WRITE_BUDGET_VALIDATION: sview = "stream\\.bytes_written > stream\\.byte_budget\\n            raise FileStreamError\\.LimitExceeded\\(stream\\.path\\) if capacity > stream\\.byte_budget - stream\\.bytes_written"
            FORBIDDEN_FREAD_MACHINE: sview = "machine over fread\\("
            READ_LIMIT_STATE: sview = "Read, FileStreamRecordState\\.Limit:"
            READ_LINE_TOO_LONG_STATE: sview = "Read, FileStreamRecordState\\.LineTooLong:"
            READ_ENCODING_ERROR_STATE: sview = "Read, FileStreamRecordState\\.EncodingError:"
            READ_ERROR_STATE: sview = "Read, FileStreamRecordState\\.Error:"
            SET_CLOSED_STATE: sview = "stream\\.state <- FileStreamState\\.Closed"
            STREAM_TEST: sview = "typed_file_stream_contract_is_bounded_and_stateful"
            WRITE_TEST: sview = "typed_file_stream_write_contract_retries_short_progress"
            WRITE_TRANSITION_TEST: sview = "file_stream_write_transition\\(0, 8, 3, 8\\)"
            NEWLINE_TEST: sview = "typed_file_stream_newline_modes_are_explicit"
            UNIVERSAL_TEST: sview = "FileStreamLineMode\\.Universal"
            STAGED_PUBLICATION_TEST: sview = "typed_file_stream_staged_publication_contract_is_explicit"
            SEEK_UTF8_TEST: sview = "typed_file_stream_seek_rejects_incomplete_utf8_output"
            ENCODING_POLICY_TEST: sview = "typed_file_stream_encoding_policy_is_explicit"
            UTF8_ENCODING: sview = "FileStreamEncoding\\.Utf8"
            UTF8_BOUNDARY_TEST: sview = "typed_file_stream_utf8_boundary_state_is_explicit"
            UTF8_TWO_REMAINING: sview = "utf8_remaining: 2u8"
            UTF8_LOWER_160: sview = "utf8_lower: 160u8"
            UTF8_THREE_REMAINING: sview = "utf8_remaining: 3u8"
            UTF8_LOWER_144: sview = "utf8_lower: 144u8"
            CLOSE_WITHOUT_HANDLE_TEST: sview = "typed_file_stream_close_rejects_open_without_handle"
            CLEANUP_GUARD_TEST: sview = "FileStreamCleanupGuard"
            CLEANUP_TRANSITION_TEST: sview = "file_stream_cleanup_transition"
            CLOSED_COMMIT: sview = "file_stream_cleanup_transition\\(FileStreamCleanupState\\.Closed, FileStreamCleanupEvent\\.Commit\\)"
            CLOSED_ABORT: sview = "file_stream_cleanup_transition\\(FileStreamCleanupState\\.Closed, FileStreamCleanupEvent\\.Abort\\)"
            ABORTED_COMMIT: sview = "file_stream_cleanup_transition\\(FileStreamCleanupState\\.Aborted, FileStreamCleanupEvent\\.Commit\\)"
            ABORTED_ABORT: sview = "file_stream_cleanup_transition\\(FileStreamCleanupState\\.Aborted, FileStreamCleanupEvent\\.Abort\\)"
            DOCS_TERMS: sview = "typed streaming file handles|FileStream|file_stream_read_line"


        const module Messages:
            MISSING_ROOT: sview = "streaming file audit: missing repository root"
            UNRESOLVED_ROOT: sview = "streaming file audit: unable to resolve repository root"
            MISSING_INPUT: sview = "streaming file audit: missing "
            READ_FAILED: sview = "streaming file audit: unable to read source: "
            SUCCESS: sview = "streaming file audit: typed modes, bounded chunk/line operations, and close-state contract present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        const enum SearchMode of u8:
            Line
            Text


        const enum Expectation of u8:
            Present
            Absent


        struct SearchCheck:
            input: Path
            pattern: sview
            mode: SearchMode = SearchMode.Line
            expectation: Expectation = Expectation.Present


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[1], pattern: Patterns::IR_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::OPEN_FAILED},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_FAILED},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_FAILED},
                SearchCheck{input: inputs[0], pattern: Patterns::FLUSH_FAILED},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_ENCODING},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_UTF8},
                SearchCheck{input: inputs[0], pattern: Patterns::SYNC_FAILED},
                SearchCheck{input: inputs[0], pattern: Patterns::CLOSE_FAILED},
                SearchCheck{input: inputs[0], pattern: Patterns::SEEK_FAILED},
                SearchCheck{input: inputs[0], pattern: Patterns::PUBLISH_FAILED},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_COLLISION},
                SearchCheck{input: inputs[0], pattern: Patterns::DIRECTORY_SYNC_FAILED},
                SearchCheck{input: inputs[0], pattern: Patterns::PUBLISH_OUTCOME_UNKNOWN},
                SearchCheck{input: inputs[0], pattern: Patterns::DIRECTORY_SYNC_UNKNOWN},
                SearchCheck{input: inputs[0], pattern: Patterns::CLEANUP_STATE_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::CLOSED},
                SearchCheck{input: inputs[0], pattern: Patterns::WRONG_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_TOO_LONG},
                SearchCheck{input: inputs[0], pattern: Patterns::LINE_TOO_LONG},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_LINE_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::DEFAULT_MAX_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_READ},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_WRITE},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_STRUCT},
                SearchCheck{input: inputs[0], pattern: Patterns::OPEN_FUNCTION},
                SearchCheck{input: inputs[0], pattern: Patterns::DEFAULT_ENCODING},
                SearchCheck{input: inputs[0], pattern: Patterns::RESOLVED_ENCODING},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_PATH_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_TERMINATED},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::FIRST_BYTE_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_TERMINATED_CHECK},
                SearchCheck{input: inputs[0], pattern: Patterns::LINE_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::ENCODING},
                SearchCheck{input: inputs[0], pattern: Patterns::SEEK_ORIGIN},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::BYTE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_TRANSITION},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_BYTE},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_COUNT_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_AMOUNT_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::ENCODING_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::MODE_IS_TEXT},
                SearchCheck{input: inputs[0], pattern: Patterns::MODE_IS_WRITABLE},
                SearchCheck{input: inputs[0], pattern: Patterns::ENCODING_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::UTF8_FEED},
                SearchCheck{input: inputs[0], pattern: Patterns::UTF8_VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::UTF8_CURSOR},
                SearchCheck{input: inputs[0], pattern: Patterns::UTF8_INCOMPLETE},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_NEXT},
                SearchCheck{input: inputs[0], pattern: Patterns::BYTE_LIMIT_BEFORE_READ, mode: SearchMode.Text},
                SearchCheck{input: inputs[0], pattern: Patterns::CR_BYTE},
                SearchCheck{input: inputs[0], pattern: Patterns::PENDING_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::LOOKAHEAD},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_CHUNK},
                SearchCheck{input: inputs[0], pattern: Patterns::PENDING_BYTE_CLEAR, mode: SearchMode.Text},
                SearchCheck{input: inputs[0], pattern: Patterns::REMAINING_CAPACITY},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_CURSOR},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_CHUNK},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_OFFSET_LOOP, mode: SearchMode.Text},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_CURSOR},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_COUNT_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_ERROR_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::FERROR_HANDLE},
                SearchCheck{input: inputs[0], pattern: Patterns::BYTES_WRITTEN},
                SearchCheck{input: inputs[0], pattern: Patterns::SYNC},
                SearchCheck{input: inputs[0], pattern: Patterns::FFLUSH},
                SearchCheck{input: inputs[0], pattern: Patterns::PUBLISH_STAGED},
                SearchCheck{input: inputs[0], pattern: Patterns::UNKNOWN_RENAME},
                SearchCheck{input: inputs[0], pattern: Patterns::DIRECTORY_SYNC_UNKNOWN_ERROR},
                SearchCheck{input: inputs[2], pattern: Patterns::PUBLICATION_TEST},
                SearchCheck{input: inputs[0], pattern: Patterns::COLLIDING_PATHS},
                SearchCheck{input: inputs[0], pattern: Patterns::POSIX_RENAME},
                SearchCheck{input: inputs[0], pattern: Patterns::POSIX_OPENDIR},
                SearchCheck{input: inputs[0], pattern: Patterns::POSIX_CLOSEDIR},
                SearchCheck{input: inputs[0], pattern: Patterns::NON_WRITABLE_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::TELL},
                SearchCheck{input: inputs[0], pattern: Patterns::SEEK},
                SearchCheck{input: inputs[0], pattern: Patterns::PENDING_CURRENT},
                SearchCheck{input: inputs[0], pattern: Patterns::SEEK_OFFSET},
                SearchCheck{input: inputs[0], pattern: Patterns::MIN_SEEK_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::SEEK_OFFSET_DECREMENT},
                SearchCheck{input: inputs[0], pattern: Patterns::FSEEK},
                SearchCheck{input: inputs[0], pattern: Patterns::PENDING_BYTE_CLEAR_ASSIGN},
                SearchCheck{input: inputs[0], pattern: Patterns::UTF8_WRITABLE_SEEK},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_LINE_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::UNIVERSAL_LINE_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::RETAIN_LINE_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_LINE},
                SearchCheck{input: inputs[0], pattern: Patterns::CLOSE},
                SearchCheck{input: inputs[0], pattern: Patterns::CLEANUP_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::CLEANUP_GUARD},
                SearchCheck{input: inputs[0], pattern: Patterns::CLEANUP_BEGIN},
                SearchCheck{input: inputs[0], pattern: Patterns::CLEANUP_COMMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::CLEANUP_ABORT},
                SearchCheck{input: inputs[0], pattern: Patterns::GUARD_ARMED},
                SearchCheck{input: inputs[0], pattern: Patterns::CLOSED_WITH_HANDLE},
                SearchCheck{input: inputs[0], pattern: Patterns::CLOSED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::HANDLE_NULL},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_BUDGET_REMAINING},
                SearchCheck{input: inputs[0], pattern: Patterns::BYTE_BUDGET_WITH_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_LIMIT_RAISE},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_BUDGET_REMAINING},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_BUDGET_VALIDATION, mode: SearchMode.Text},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_BUDGET_VALIDATION, mode: SearchMode.Text},
                SearchCheck{input: inputs[0], pattern: Patterns::FORBIDDEN_FREAD_MACHINE, expectation: Expectation.Absent},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_LIMIT_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_LINE_TOO_LONG_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_ENCODING_ERROR_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_ERROR_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::SET_CLOSED_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::STREAM_TEST},
                SearchCheck{input: inputs[2], pattern: Patterns::WRITE_TEST},
                SearchCheck{input: inputs[2], pattern: Patterns::WRITE_TRANSITION_TEST},
                SearchCheck{input: inputs[2], pattern: Patterns::NEWLINE_TEST},
                SearchCheck{input: inputs[2], pattern: Patterns::UNIVERSAL_TEST},
                SearchCheck{input: inputs[2], pattern: Patterns::STAGED_PUBLICATION_TEST},
                SearchCheck{input: inputs[2], pattern: Patterns::SEEK_UTF8_TEST},
                SearchCheck{input: inputs[2], pattern: Patterns::ENCODING_POLICY_TEST},
                SearchCheck{input: inputs[2], pattern: Patterns::UTF8_ENCODING},
                SearchCheck{input: inputs[2], pattern: Patterns::UTF8_BOUNDARY_TEST},
                SearchCheck{input: inputs[2], pattern: Patterns::UTF8_TWO_REMAINING},
                SearchCheck{input: inputs[2], pattern: Patterns::UTF8_LOWER_160},
                SearchCheck{input: inputs[2], pattern: Patterns::UTF8_THREE_REMAINING},
                SearchCheck{input: inputs[2], pattern: Patterns::UTF8_LOWER_144},
                SearchCheck{input: inputs[2], pattern: Patterns::CLOSE_WITHOUT_HANDLE_TEST},
                SearchCheck{input: inputs[2], pattern: Patterns::CLEANUP_GUARD_TEST},
                SearchCheck{input: inputs[2], pattern: Patterns::CLEANUP_TRANSITION_TEST},
                SearchCheck{input: inputs[2], pattern: Patterns::CLOSED_COMMIT},
                SearchCheck{input: inputs[2], pattern: Patterns::CLOSED_ABORT},
                SearchCheck{input: inputs[2], pattern: Patterns::ABORTED_COMMIT},
                SearchCheck{input: inputs[2], pattern: Patterns::ABORTED_ABORT},
                SearchCheck{input: inputs[0], pattern: Patterns::DOCS_TERMS}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                found: mutable bool = false
                if check.mode == SearchMode.Line:
                    pattern: Regex = regex(check.pattern)
                    found <- try EsSourceFunctionScope::contains_file_regex_line(check.input, pattern) else err:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
                else:
                    pattern: Regex = regex(check.pattern)
                    found <- try EsSourceFunctionScope::contains_file_regex_text(check.input, pattern) else err:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE

                match check.expectation:
                    Expectation.Present:
                        return ExitStatus::FAILURE if not found
                    Expectation.Absent:
                        return ExitStatus::FAILURE if found
                    _:
                        return ExitStatus::FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::STREAM),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::TESTS),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsStreamingFileAudit::run_default()
