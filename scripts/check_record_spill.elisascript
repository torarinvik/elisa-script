# Bounded Elisascript port of check_record_spill.sh.
# Regex source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsRecordSpillAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/record_spill_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsRecordSpill:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/record_spill_model\.elisa\""
            STATE: Regex = regex"const enum RecordSpillState of u8"
            EVENT: Regex = regex"const enum RecordSpillEvent of u8"
            POLICY: Regex = regex"struct RecordSpillPolicy:"
            RUN: Regex = regex"struct RecordSpillRun:"
            SESSION: Regex = regex"struct RecordSpillSession:"
            ERROR: Regex = regex"error RecordSpillError:"
            VALIDATE: Regex = regex"def validate_record_spill\("
            ADVANCE: Regex = regex"def advance_record_spill\("
            MAX_RUNS: Regex = regex"RECORD_SPILL_MAX_RUNS"
            MAX_RECORDS_PER_RUN: Regex = regex"RECORD_SPILL_MAX_RECORDS_PER_RUN"
            MAX_TOTAL_RECORDS: Regex = regex"RECORD_SPILL_MAX_TOTAL_RECORDS"
            MAX_RUN_BYTES: Regex = regex"RECORD_SPILL_MAX_RUN_BYTES"
            MAX_TOTAL_BYTES: Regex = regex"RECORD_SPILL_MAX_TOTAL_BYTES"
            BOUNDED_ADD: Regex = regex"record_spill_bounded_add"
            ACTIVE_RUN: Regex = regex"has_active_run"
            PLANNED: Regex = regex"RecordSpillState.Planned"
            READY: Regex = regex"RecordSpillState.Ready"
            MERGING: Regex = regex"RecordSpillState.Merging"
            SEALED: Regex = regex"RecordSpillState.Sealed"
            MERGED_RUN_COUNT: Regex = regex"session.merged_runs != session.runs.count"
            MERGE_OR_SEALED: Regex = regex"session.state == RecordSpillState.Merging or session.state == RecordSpillState.Sealed"
            SEAL_RUN: Regex = regex"RecordSpillEvent.SealRun"
            SPILLING: Regex = regex"session.state <- RecordSpillState.Spilling"
            BEGIN_MERGE: Regex = regex"RecordSpillEvent.BeginMerge"
            MERGE_RUN: Regex = regex"RecordSpillEvent.MergeRun"
            MERGE_ORDER_ERROR: Regex = regex"RecordSpillError.MergeOrderInvalid"
            RUN_NOT_SEALED: Regex = regex"RecordSpillError.RunNotSealed"
            NOT_READY: Regex = regex"session.state != RecordSpillState.Ready"
            DESTINATION_COLLISION: Regex = regex"RecordSpillError.DestinationCollision"
            INACTIVE_RUN: Regex = regex"not session.has_active_run and"
            FIXTURE_IMPORT: Regex = regex"using EsRecordSpill"
            FIXTURE_CONTRACT: Regex = regex"typed_record_spill_contract_seals_runs_before_ordered_merge"
            FIXTURE_START_RUN: Regex = regex"RecordSpillEvent.StartRun"
            FIXTURE_SEAL_RUN: Regex = regex"RecordSpillEvent.SealRun"
            FIXTURE_MERGE_RUN: Regex = regex"RecordSpillEvent.MergeRun"
            FIXTURE_MERGE_ORDER: Regex = regex"RecordSpillError.MergeOrderInvalid"
            FIXTURE_ACCOUNTING: Regex = regex"RecordSpillError.AccountingInvalid"
            FORGED_EMPTY_MERGING: Regex = regex"forged_empty_merging"
            FORGED_EMPTY_SEALED: Regex = regex"forged_empty_sealed"
            FORGED_STATE: Regex = regex"forged_state"
            DOCS_SESSION: Regex = regex"EsRecordSpill::RecordSpillSession"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-034"


        const module Messages:
            MISSING_ROOT: sview = "record spill audit: missing repository root"
            UNRESOLVED_ROOT: sview = "record spill audit: unable to resolve repository root"
            MISSING_INPUT: sview = "record spill audit: missing "
            READ_FAILED: sview = "record spill audit: unable to read source: "
            SUCCESS: sview = "record spill audit: bounded run staging, sealing, ordered merge, and commit are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::RUN},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_RUNS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_RECORDS_PER_RUN},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_TOTAL_RECORDS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_RUN_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_TOTAL_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::BOUNDED_ADD},
                SearchCheck{input: inputs[0], pattern: Patterns::ACTIVE_RUN},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED},
                SearchCheck{input: inputs[0], pattern: Patterns::READY},
                SearchCheck{input: inputs[0], pattern: Patterns::MERGING},
                SearchCheck{input: inputs[0], pattern: Patterns::SEALED},
                SearchCheck{input: inputs[0], pattern: Patterns::MERGED_RUN_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::MERGE_OR_SEALED},
                SearchCheck{input: inputs[0], pattern: Patterns::SEAL_RUN},
                SearchCheck{input: inputs[0], pattern: Patterns::SPILLING},
                SearchCheck{input: inputs[0], pattern: Patterns::BEGIN_MERGE},
                SearchCheck{input: inputs[0], pattern: Patterns::MERGE_RUN},
                SearchCheck{input: inputs[0], pattern: Patterns::MERGE_ORDER_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::RUN_NOT_SEALED},
                SearchCheck{input: inputs[0], pattern: Patterns::NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::DESTINATION_COLLISION},
                SearchCheck{input: inputs[0], pattern: Patterns::INACTIVE_RUN},
                SearchCheck{input: inputs[0], pattern: Patterns::SEALED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_START_RUN},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_SEAL_RUN},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_MERGE_RUN},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_MERGE_ORDER},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ACCOUNTING},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_EMPTY_MERGING},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_EMPTY_SEALED},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_STATE},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsRecordSpillAudit::run_default()
