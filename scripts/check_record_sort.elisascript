# Bounded Elisascript port of check_record_sort.sh.
# Regex source checks stream through the shared line scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsRecordSortAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/record_sort_model.elisa"
            FIELD_ADAPTER: sview = "src/runtime/record_sort_field_adapter_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            FIELD_FIXTURE: sview = "test/runtime/record_sort_field_adapter_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsRecordSort:"
            FIELD_MODULE: Regex = regex"^module EsRecordSortFields:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/record_sort_model\.elisa\""
            FIELD_ADAPTER_IMPORT: Regex = regex"include \"\.\./runtime/record_sort_field_adapter_model\.elisa\""
            KEY_KIND: Regex = regex"const enum RecordSortKeyKind of u8"
            DIRECTION: Regex = regex"const enum RecordSortDirection of u8"
            ORDER: Regex = regex"const enum RecordSortOrder of u8"
            POLICY: Regex = regex"struct RecordSortPolicy:"
            ENTRY: Regex = regex"struct RecordSortEntry:"
            SESSION: Regex = regex"struct RecordSortSession:"
            ERROR: Regex = regex"error RecordSortError:"
            VALIDATE: Regex = regex"def validate_record_sort_session\("
            COMPARE: Regex = regex"def compare_record_sort_entries\("
            ORDER_INDICES: Regex = regex"def record_sort_order_indices\("
            ADVANCE: Regex = regex"def advance_record_sort\("
            KEY_FROM_FIELD: Regex = regex"def record_sort_key_from_field\("
            ENTRY_FROM_FIELDS: Regex = regex"def record_sort_entry_from_fields\("
            VALIDATE_SESSION: Regex = regex"validate_record_sort_session"
            FIELD_INDEX: Regex = regex"field.index != spec.field_index"
            VALIDATE_FIELD: Regex = regex"validate_record_field"
            NUMERIC_KIND: Regex = regex"numeric_policy.kind != RecordNumericKind.Integer"
            FIELD_ABSENT: Regex = regex"not field.present"
            PARSE_NUMERIC: Regex = regex"parse_record_numeric"
            NUMERIC_RESULT_I64: Regex = regex"record_numeric_result_i64"
            MAX_KEYS: Regex = regex"RECORD_SORT_MAX_KEYS"
            MAX_RECORDS: Regex = regex"RECORD_SORT_MAX_RECORDS"
            MAX_TEXT_BYTES: Regex = regex"RECORD_SORT_MAX_TEXT_BYTES"
            POLICY_VALID: Regex = regex"record_sort_policy_valid"
            ENTRY_VALID: Regex = regex"record_sort_entry_valid"
            KEY_ORDER_INVALID: Regex = regex"RecordSortError.KeyOrderInvalid"
            ORDINAL_INVALID: Regex = regex"RecordSortError.OrdinalInvalid"
            UNIQUE_VIOLATION: Regex = regex"RecordSortError.UniqueViolation"
            ORDER_NOT_READY: Regex = regex"RecordSortError.OrderNotReady"
            HIDDEN_KEY: Regex = regex"not key\.present and \(key\.text != \"\" or key\.integer != 0\)"
            INTEGER_KEY_TEXT: Regex = regex"key\.kind == RecordSortKeyKind.Integer and key\.text != \"\""
            TEXT_KEY_INTEGER: Regex = regex"key\.kind == RecordSortKeyKind.Text and key\.integer != 0"
            PLANNED_STATE: Regex = regex"session\.state == RecordSortState.Planned and"
            KEYS_EQUAL: Regex = regex"record_sort_keys_equal"
            TEXT_LIMIT: Regex = regex"RecordSortError.TextLimitExceeded"
            DESCENDING: Regex = regex"RecordSortDirection.Descending"
            SEALED_STATE: Regex = regex"RecordSortState.Sealed"
            FIXTURE_IMPORT: Regex = regex"using EsRecordSort"
            FIXTURE_CONTRACT: Regex = regex"typed_record_sort_contract_is_bounded_stable_and_typed"
            FIXTURE_INTEGER_KIND: Regex = regex"RecordSortKeyKind.Integer"
            FIXTURE_DESCENDING: Regex = regex"RecordSortDirection.Descending"
            FIXTURE_POLICY_INVALID: Regex = regex"RecordSortError.PolicyInvalid"
            TEXT_INTEGER_ABSENT_FIELDS: Regex = regex"text_integer_and_absent_record_fields_form_declared_sort_keys"
            MALFORMED_NUMERIC_FIELD: Regex = regex"malformed_numeric_sort_field_is_rejected_before_key_publication"
            NUMERIC_NOT_LEXICAL: Regex = regex"integer_sort_entries_use_numeric_not_lexical_order"
            STABLE_ORDER_INDICES: Regex = regex"sealed_record_sort_returns_stable_numeric_order_indices"
            FIXTURE_ENTRY_FROM_FIELDS: Regex = regex"record_sort_entry_from_fields"
            INVALID_NUMERIC_CHARACTER: Regex = regex"RecordNumericError.InvalidCharacter"
            NEGATIVE_INTEGER_KEY: Regex = regex"integer_key\.integer == -12"
            ABSENT_KEY: Regex = regex"not absent_key\.present"
            DOCS_SESSION: Regex = regex"EsRecordSort::RecordSortSession"
            DOCS_ORDER_INDICES: Regex = regex"record_sort_order_indices"
            DOCS_KEY_FROM_FIELD: Regex = regex"EsRecordSortFields::record_sort_key_from_field"
            DOCS_ENTRY_FROM_FIELDS: Regex = regex"record_sort_entry_from_fields"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-024"


        const module Messages:
            MISSING_ROOT: sview = "record sort audit: missing repository root"
            UNRESOLVED_ROOT: sview = "record sort audit: unable to resolve repository root"
            MISSING_INPUT: sview = "record sort audit: missing "
            READ_FAILED: sview = "record sort audit: unable to read source: "
            SUCCESS: sview = "record sort audit: bounded typed keys, stable order, and lifecycle checks are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::FIELD_MODULE},
                SearchCheck{input: inputs[2], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIELD_ADAPTER_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::KEY_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::DIRECTION},
                SearchCheck{input: inputs[0], pattern: Patterns::ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPARE},
                SearchCheck{input: inputs[0], pattern: Patterns::ORDER_INDICES},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[1], pattern: Patterns::KEY_FROM_FIELD},
                SearchCheck{input: inputs[1], pattern: Patterns::ENTRY_FROM_FIELDS},
                SearchCheck{input: inputs[1], pattern: Patterns::VALIDATE_SESSION},
                SearchCheck{input: inputs[1], pattern: Patterns::FIELD_INDEX},
                SearchCheck{input: inputs[1], pattern: Patterns::VALIDATE_FIELD},
                SearchCheck{input: inputs[1], pattern: Patterns::NUMERIC_KIND},
                SearchCheck{input: inputs[1], pattern: Patterns::FIELD_ABSENT},
                SearchCheck{input: inputs[1], pattern: Patterns::PARSE_NUMERIC},
                SearchCheck{input: inputs[1], pattern: Patterns::NUMERIC_RESULT_I64},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_KEYS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_RECORDS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_TEXT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::KEY_ORDER_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::ORDINAL_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::UNIQUE_VIOLATION},
                SearchCheck{input: inputs[0], pattern: Patterns::ORDER_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::HIDDEN_KEY},
                SearchCheck{input: inputs[0], pattern: Patterns::INTEGER_KEY_TEXT},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_KEY_INTEGER},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::KEYS_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::DESCENDING},
                SearchCheck{input: inputs[0], pattern: Patterns::SEALED_STATE},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_INTEGER_KIND},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_DESCENDING},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_POLICY_INVALID},
                SearchCheck{input: inputs[4], pattern: Patterns::TEXT_INTEGER_ABSENT_FIELDS},
                SearchCheck{input: inputs[4], pattern: Patterns::MALFORMED_NUMERIC_FIELD},
                SearchCheck{input: inputs[4], pattern: Patterns::NUMERIC_NOT_LEXICAL},
                SearchCheck{input: inputs[4], pattern: Patterns::STABLE_ORDER_INDICES},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_ENTRY_FROM_FIELDS},
                SearchCheck{input: inputs[4], pattern: Patterns::INVALID_NUMERIC_CHARACTER},
                SearchCheck{input: inputs[4], pattern: Patterns::NEGATIVE_INTEGER_KEY},
                SearchCheck{input: inputs[4], pattern: Patterns::ABSENT_KEY},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_ORDER_INDICES},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_KEY_FROM_FIELD},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_ENTRY_FROM_FIELDS},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::FIELD_ADAPTER),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::FIELD_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsRecordSortAudit::run_default()
