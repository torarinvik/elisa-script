# Bounded Elisascript port of check_split_lines_capacity.sh.
# Scoped source assertions use bounded streaming and fixed-string semantics.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsSplitLinesCapacityAudit:
    private:
        const module Inputs:
            INTERPRETER: sview = "src/ir/interpret.elisa"
            BYTECODE: sview = "src/bytecode/bytecode.elisa"
            INTERPRETER_FIXTURE: sview = "test/ir/elisascript_interpreter_test.elisa"
            BYTECODE_FIXTURE: sview = "test/ir/elisascript_bytecode_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            INTERPRETER_FUNCTION: sview = "def evaluate_split_lines"
            BYTECODE_FUNCTION: sview = "def bytecode_direct_split_lines"
            LOCAL_FIELDS: sview = "fields: mutable darray[sview] = []"
            EXACT_PREFLIGHT: sview = "runtime_storage_span_u32_valid(storage, fields.count)"
            STORAGE_START: sview = "start: u32 = storage.count.u32()"
            FIELD_PUSH: sview = "storage.push(runtime_text(field))"
            INTERPRETER_FIXTURE: sview = "split_lines"
            BYTECODE_FIXTURE: sview = "splitlines"
            DOCS: sview = "Line splitting also counts its actual fields"
            LEDGER: sview = "`SplitLines` now applies the same exact-result admission"


        const module Messages:
            MISSING_ROOT: sview = "split-lines capacity audit: missing repository root"
            UNRESOLVED_ROOT: sview = "split-lines capacity audit: unable to resolve repository root"
            MISSING_INPUT: sview = "split-lines capacity audit: missing "
            MISSING_MARKERS: sview = "split-lines capacity audit: missing exact result markers in "
            WRONG_ORDER: sview = "split-lines capacity audit: shared storage is touched before exact preflight in "
            READ_FAILED: sview = "split-lines capacity audit: unable to read source: "
            SUCCESS: sview = "split-lines capacity audit: actual fields are preflighted before publication"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


        def assert_exact(path: Path, definition: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            body: EsSourceFunctionScope::FunctionBody = try EsSourceFunctionScope::read_function_body(path, definition) else err:
                diagnostic(Messages::READ_FAILED + f"{path}")
                return ExitStatus::IO_FAILURE
            local_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::LOCAL_FIELDS)
            preflight_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::EXACT_PREFLIGHT)
            result_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::STORAGE_START)
            push_line: usize = EsSourceFunctionScope::first_line_number(body.text, Patterns::FIELD_PUSH)
            if local_line == 0 or preflight_line == 0 or result_line == 0 or push_line == 0:
                diagnostic(Messages::MISSING_MARKERS + f"{path}")
                return ExitStatus::FAILURE
            if local_line >= preflight_line or preflight_line >= result_line or result_line >= push_line:
                diagnostic(Messages::WRONG_ORDER + f"{path}")
                return ExitStatus::FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::BYTECODE),
                root.joinpath(Inputs::INTERPRETER_FIXTURE),
                root.joinpath(Inputs::BYTECODE_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: mutable i64 = assert_exact(inputs[0], Patterns::INTERPRETER_FUNCTION)
            return status if status != 0i64
            status <- assert_exact(inputs[1], Patterns::BYTECODE_FUNCTION)
            return status if status != 0i64

            checks: darray[SearchCheck] = [
                SearchCheck{input: inputs[2], pattern: Patterns::INTERPRETER_FIXTURE},
                SearchCheck{input: inputs[3], pattern: Patterns::BYTECODE_FIXTURE},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS},
                SearchCheck{input: inputs[5], pattern: Patterns::LEDGER}
            ]
            for check in checks:
                status <- has_line(check.input, check.pattern)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsSplitLinesCapacityAudit::run_default()
