# Bounded Elisascript port of check_executable.sh.
# Regex source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsExecutableAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/executable_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsExecutable:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/executable_model\.elisa\""
            LIMITS: Regex = regex"const module Limits:"
            DISCOVERY_STATE: Regex = regex"const enum ExecutableDiscoveryState of u8"
            DISCOVERY_EVENT: Regex = regex"const enum ExecutableDiscoveryEvent of u8"
            REQUEST: Regex = regex"struct ExecutableDiscoveryRequest:"
            CANDIDATE: Regex = regex"struct ExecutableCandidate:"
            EXECUTABLE: Regex = regex"struct Executable:"
            SESSION: Regex = regex"struct ExecutableDiscoverySession:"
            ERROR: Regex = regex"error ExecutableDiscoveryError:"
            VALIDATE: Regex = regex"def validate_executable_discovery\("
            RESULT: Regex = regex"def executable_discovery_result\("
            ADVANCE: Regex = regex"def advance_executable_discovery\("
            NAME_BYTES: Regex = regex"Limits::NAME_BYTES"
            PATH_ENTRIES: Regex = regex"Limits::PATH_ENTRIES"
            CANDIDATES: Regex = regex"Limits::CANDIDATES"
            PATH_BYTES: Regex = regex"Limits::PATH_BYTES"
            CANDIDATE_EVENT: Regex = regex"ExecutableDiscoveryEvent.Candidate"
            CANDIDATE_PATH_MATCHES: Regex = regex"def executable_candidate_path_matches"
            MISSING_NOT_READY: Regex = regex"ExecutableDiscoveryError.MissingNotReady"
            CANDIDATE_ORDER_INVALID: Regex = regex"ExecutableDiscoveryError.CandidateOrderInvalid"
            FOUND_STATE: Regex = regex"ExecutableDiscoveryState.Found"
            MISSING_STATE: Regex = regex"ExecutableDiscoveryState.Missing"
            PLANNED_STATE: Regex = regex"session.state == ExecutableDiscoveryState.Planned"
            SESSION_FOUND: Regex = regex"session.state == ExecutableDiscoveryState.Found"
            CANDIDATE_INDEX: Regex = regex"candidate.path_index >= session.request.path_entries.count"
            FIXTURE_IMPORT: Regex = regex"using EsExecutable"
            FIXTURE_CONTRACT: Regex = regex"typed_executable_discovery_contract_distinguishes_path_and_executable"
            FIXTURE_CANDIDATE_EVENT: Regex = regex"ExecutableDiscoveryEvent.Candidate"
            FIXTURE_MISSING_NOT_READY: Regex = regex"ExecutableDiscoveryError.MissingNotReady"
            FIXTURE_RESULT: Regex = regex"executable_discovery_result"
            FIXTURE_CANDIDATE_INVALID: Regex = regex"ExecutableDiscoveryError.CandidateInvalid"
            EMPTY_PATH_ENTRY: Regex = regex"allow_empty_path_entry: true"
            FORGED_CANDIDATE: Regex = regex"forged_candidate"
            EXAMINED_CANDIDATES: Regex = regex"examined_candidates == 0"
            DOCS_SESSION: Regex = regex"EsExecutable::ExecutableDiscoverySession"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-041"


        const module Messages:
            MISSING_ROOT: sview = "executable audit: missing repository root"
            UNRESOLVED_ROOT: sview = "executable audit: unable to resolve repository root"
            MISSING_INPUT: sview = "executable audit: missing "
            READ_FAILED: sview = "executable audit: unable to read source: "
            SUCCESS: sview = "executable audit: bounded PATH candidate and executable identity protocol is present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_match(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return ExitStatus::IO_FAILURE


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMITS},
                SearchCheck{input: inputs[0], pattern: Patterns::DISCOVERY_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::DISCOVERY_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST},
                SearchCheck{input: inputs[0], pattern: Patterns::CANDIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EXECUTABLE},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::RESULT},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_ENTRIES},
                SearchCheck{input: inputs[0], pattern: Patterns::CANDIDATES},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::CANDIDATE_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::CANDIDATE_PATH_MATCHES},
                SearchCheck{input: inputs[0], pattern: Patterns::MISSING_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::CANDIDATE_ORDER_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::FOUND_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::MISSING_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION_FOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::CANDIDATE_INDEX},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CANDIDATE_EVENT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_MISSING_NOT_READY},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_RESULT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CANDIDATE_INVALID},
                SearchCheck{input: inputs[2], pattern: Patterns::EMPTY_PATH_ENTRY},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_CANDIDATE},
                SearchCheck{input: inputs[2], pattern: Patterns::EXAMINED_CANDIDATES},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            for check in searches(inputs):
                status: i64 = has_match(check)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsExecutableAudit::run_default()
