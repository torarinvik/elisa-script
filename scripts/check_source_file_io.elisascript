# Bounded binary Elisascript port of check_source_file_io.sh.
# Keep the shell oracle until the launcher parity contract is qualified.

include "../src/runtime/bounded_bytes_posix.elisa"

using EsBoundedBytes

module EsSourceFileIoAudit:
    private:
        const module Limits:
            SOURCE_BYTES: usize = 16777216


        const module Inputs:
            SOURCE: sview = "src/ir/source_file.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            READ_STREAM: Regex = regex"def elisascript_read_stream_fully\("
            REJECTS_HOST_ERRORS: Regex = regex"amount == 0 or amount > remaining or ferror\(stream\) != 0"
            CHECKS_READ_AND_CLOSE: Regex = regex"read_count != size\.usize\(\) or close_status != 0"
            DOCUMENTED_HOST_ERROR: Regex = regex"sticky host error|ferror.*source|source.*ferror|source-file.*stdio"


        const module Messages:
            ROOT: sview = "source-file I/O audit: missing repository root"
            UNRESOLVED_ROOT: sview = "source-file I/O audit: unable to resolve repository root"
            MISSING: sview = "source-file I/O audit: missing "
            READ_FAILED: sview = "source-file I/O audit: unable to read "


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


    public:
        def run_root(repository_root: Path) -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            if not is_directory(repository_root):
                diagnostic(Messages::ROOT)
                return 1i64
            root: Path = try path_real(path_absolute(repository_root)) else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64

            inputs: darray[Path] = [
                root.joinpath(Inputs::SOURCE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING + f"{input_path}")
                    return 1i64

            contents: mutable darray[darray[u8]] = []
            for input_path in inputs |contents|:
                source: darray[u8] = try EsBoundedBytes::read_bounded_bytes(input_path, Limits::SOURCE_BYTES) else err:
                    diagnostic(Messages::READ_FAILED + f"{input_path}")
                    return 2i64
                contents.push(source)

            if not Patterns::READ_STREAM.search(bytes_view(contents[0])):
                return 1i64
            if not Patterns::REJECTS_HOST_ERRORS.search(bytes_view(contents[0])):
                return 1i64
            if not Patterns::CHECKS_READ_AND_CLOSE.search(bytes_view(contents[0])):
                return 1i64
            if not Patterns::DOCUMENTED_HOST_ERROR.search(bytes_view(contents[1])):
                return 1i64
            if not Patterns::DOCUMENTED_HOST_ERROR.search(bytes_view(contents[2])):
                return 1i64

            print("source-file I/O audit: exact-size reads reject host errors before source publication")
            return 0i64


        def run_default() -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            # Match dirname "$0": resolve the caller's spelling, not a
            # compiler-normalized source path that may point elsewhere.
            invocation_path: Path = path(Script::invocation_path())
            invocation_directory: Path = try path_real(path_absolute(invocation_path).parent()) else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(invocation_directory.parent())


def main(arguments: darray[sview]) -> i64 can[Directory.Read, File.Read, Blocking.IO, Memory.Allocate, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
    _ = arguments
    return EsSourceFileIoAudit::run_default()
