# Bounded Elisascript port of check_source_file_io.sh.
# Source checks stream through the shared scanner without launching rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsSourceFileIoAudit:
    private:
        const module Inputs:
            SOURCE: sview = "src/ir/source_file.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            READ_STREAM: Regex = regex"def elisascript_read_stream_fully\("
            REJECTS_HOST_ERRORS: Regex = regex"amount == 0 or amount > remaining or ferror\(stream\) != 0"
            CHECKS_READ_AND_CLOSE: Regex = regex"read_count != size\.usize\(\) or close_status != 0"
            DOCUMENTED_HOST_ERROR: Regex = regex"sticky host error|ferror.*source|source.*ferror|source-file.*stdio"


        const module Messages:
            ROOT: sview = "source-file I/O audit: missing repository root"
            UNRESOLVED_ROOT: sview = "source-file I/O audit: unable to resolve repository root"
            MISSING: sview = "source-file I/O audit: missing "
            READ_FAILED: sview = "source-file I/O audit: unable to read source: "
            SUCCESS: sview = "source-file I/O audit: exact-size reads reject host errors before source publication"


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::READ_STREAM},
                SearchCheck{input: inputs[0], pattern: Patterns::REJECTS_HOST_ERRORS},
                SearchCheck{input: inputs[0], pattern: Patterns::CHECKS_READ_AND_CLOSE},
                SearchCheck{input: inputs[1], pattern: Patterns::DOCUMENTED_HOST_ERROR},
                SearchCheck{input: inputs[2], pattern: Patterns::DOCUMENTED_HOST_ERROR}
            ]


        def has_match(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                ok found:
                    return 1i64 if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return 2i64


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                status: i64 = has_match(check)
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::ROOT)
                return 1i64
            root: Path = path_normalize(repository_root)

            inputs: darray[Path] = [
                root.joinpath(Inputs::SOURCE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING + f"{input_path}")
                    return 1i64

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsSourceFileIoAudit::run_default()
