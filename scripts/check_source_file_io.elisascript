# Streaming Elisascript port of check_source_file_io.sh.
# Keep the shell oracle until the public-launcher parity contract is qualified.

include "./shell_invocation_path.elisascript"

module EsSourceFileIoAudit:
    private:
        const module Inputs:
            SOURCE: sview = "src/ir/source_file.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            READ_STREAM: sview = "def elisascript_read_stream_fully\\("
            REJECTS_HOST_ERRORS: sview = "amount == 0 or amount > remaining or ferror\\(stream\\) != 0"
            CHECKS_READ_AND_CLOSE: sview = "read_count != size\\.usize\\(\\) or close_status != 0"
            DOCUMENTED_HOST_ERROR: sview = "sticky host error|ferror.*source|source.*ferror|source-file.*stdio"


        const module Messages:
            ROOT: sview = "source-file I/O audit: missing repository root"
            UNRESOLVED_ROOT: sview = "source-file I/O audit: unable to resolve repository root"
            MISSING: sview = "source-file I/O audit: missing "
            RG_UNAVAILABLE: sview = "source-file I/O audit: unable to run rg"
            READ_FAILED: sview = "source-file I/O audit: rg failed to run"


        const enum SearchMode of u8:
            Regex
            MultilineRegex


        struct SearchCheck:
            input: Path
            pattern: sview
            mode: SearchMode


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::READ_STREAM, mode: SearchMode.Regex},
                SearchCheck{input: inputs[0], pattern: Patterns::REJECTS_HOST_ERRORS, mode: SearchMode.MultilineRegex},
                SearchCheck{input: inputs[0], pattern: Patterns::CHECKS_READ_AND_CLOSE, mode: SearchMode.Regex},
                SearchCheck{input: inputs[1], pattern: Patterns::DOCUMENTED_HOST_ERROR, mode: SearchMode.Regex},
                SearchCheck{input: inputs[2], pattern: Patterns::DOCUMENTED_HOST_ERROR, mode: SearchMode.Regex}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Environment.Read, File.Read, Directory.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            rg: Executable = try executable("rg") else err:
                diagnostic(Messages::RG_UNAVAILABLE)
                return 127i64
            for check in checks:
                arguments: darray[sview] = when check.mode:
                    SearchMode.Regex -> ["-q", check.pattern, f"{check.input}"]
                    SearchMode.MultilineRegex -> ["-U", "-q", check.pattern, f"{check.input}"]
                status: i64 = try run_process(rg, arguments, 0i64) else err:
                    diagnostic(Messages::READ_FAILED)
                    return 127i64
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            if not is_directory(repository_root):
                diagnostic(Messages::ROOT)
                return 1i64
            root: Path = path_normalize(repository_root)

            inputs: darray[Path] = [
                root.joinpath(Inputs::SOURCE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING + f"{input_path}")
                    return 1i64

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print("source-file I/O audit: exact-size reads reject host errors before source publication")
            return 0i64


        def run_default() -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsSourceFileIoAudit::run_default()
