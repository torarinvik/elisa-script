# Bounded Elisascript port of check_validation_identity.sh.
# Source checks use the shared scanner without launching rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsValidationIdentityAudit:
    private:
        const module Inputs:
            HELPER: sview = "validation_identity.sh"
            DOCS_SUFFIX: sview = "/../docs/development.md"
            BASELINE_SUFFIX: sview = "/../docs/validation-baseline.md"


        const module Patterns:
            COMPILER_OVERRIDE: sview = "ELISA_LOCAL_COMPILER:-\\$\\{ELISACORE_BIN:-\\$expected_compiler_path\\}"
            COMPILER_PATH_FRAGMENT: sview = "Go projects/structpy-tree/compiler/bin/elisac"
            PINNED_COMPILER_PATH: sview = "expected_compiler_path=\"/Users/torarinvikbjarko/Documents/Coding Projects/Go projects/structpy-tree/compiler/bin/elisac\""
            COMPILER_PATH_GUARD: sview = "if [ \"$compiler\" != \"$expected_compiler_path\" ]; then"
            SUFFIX_MATCH_INSUFFICIENT: sview = "suffix match is insufficient"
            SYMLINKS_REJECTED: sview = "compiler symlinks are not accepted"
            SOURCE_REVISION: sview = "git -C \"\\$compiler_root\" rev-parse HEAD"
            SOURCE_DIRTY_CHECK: sview = "git -C \"\\$compiler_root\" status --porcelain --untracked-files=normal"
            EMBEDDED_REVISION: sview = "go version -m \"$compiler\""
            REVISION_MISMATCH: sview = "compiler_binary_revision\" != \"$compiler_revision\""
            MODIFIED_BINARY: sview = "compiler_binary_modified\" != \"false\""
            MODIFIED_STATUS_FIELD: sview = "compiler_binary_modified=%s\\n"
            BINARY_HASH: sview = "shasum -a 256 \"\\$compiler\""
            REVISION_STATUS_FIELD: sview = "compiler_binary_revision=%s\\n"
            CONFIGURATION_KEY: sview = "configuration_key="
            OUTPUT_DIRECTORY: sview = "output_dir="
            OUTPUT_ROOT_OVERRIDE: sview = "ELISASCRIPT_VALIDATION_OUTPUT_ROOT"
            DOCS_KEYED_OUTPUTS: sview = "configuration_key|keyed"
            BASELINE_HASH_FIELD: sview = "Compiler executable SHA-256"


        const module Messages:
            UNRESOLVED_SCRIPT_DIRECTORY: sview = "validation identity audit: unable to resolve script directory"
            READ_FAILED: sview = "validation identity audit: unable to read source: "
            SUCCESS: sview = "validation identity audit: clean pinned source, matching embedded binary revision, executable hash, and keyed outputs are present"


        const enum SearchMode of u8:
            Regex
            Fixed


        struct SearchCheck:
            input: Path
            pattern: sview
            mode: SearchMode


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(helper: Path, docs: Path, baseline: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: helper, pattern: Patterns::COMPILER_OVERRIDE, mode: SearchMode.Regex},
                SearchCheck{input: helper, pattern: Patterns::COMPILER_PATH_FRAGMENT, mode: SearchMode.Regex},
                SearchCheck{input: helper, pattern: Patterns::PINNED_COMPILER_PATH, mode: SearchMode.Fixed},
                SearchCheck{input: helper, pattern: Patterns::COMPILER_PATH_GUARD, mode: SearchMode.Fixed},
                SearchCheck{input: helper, pattern: Patterns::SUFFIX_MATCH_INSUFFICIENT, mode: SearchMode.Regex},
                SearchCheck{input: helper, pattern: Patterns::SYMLINKS_REJECTED, mode: SearchMode.Regex},
                SearchCheck{input: helper, pattern: Patterns::SOURCE_REVISION, mode: SearchMode.Regex},
                SearchCheck{input: helper, pattern: Patterns::SOURCE_DIRTY_CHECK, mode: SearchMode.Regex},
                SearchCheck{input: helper, pattern: Patterns::EMBEDDED_REVISION, mode: SearchMode.Fixed},
                SearchCheck{input: helper, pattern: Patterns::REVISION_MISMATCH, mode: SearchMode.Fixed},
                SearchCheck{input: helper, pattern: Patterns::MODIFIED_BINARY, mode: SearchMode.Fixed},
                SearchCheck{input: helper, pattern: Patterns::MODIFIED_STATUS_FIELD, mode: SearchMode.Fixed},
                SearchCheck{input: helper, pattern: Patterns::BINARY_HASH, mode: SearchMode.Regex},
                SearchCheck{input: helper, pattern: Patterns::REVISION_STATUS_FIELD, mode: SearchMode.Fixed},
                SearchCheck{input: helper, pattern: Patterns::CONFIGURATION_KEY, mode: SearchMode.Regex},
                SearchCheck{input: helper, pattern: Patterns::OUTPUT_DIRECTORY, mode: SearchMode.Regex},
                SearchCheck{input: helper, pattern: Patterns::OUTPUT_ROOT_OVERRIDE, mode: SearchMode.Regex},
                SearchCheck{input: docs, pattern: Patterns::DOCS_KEYED_OUTPUTS, mode: SearchMode.Regex},
                SearchCheck{input: baseline, pattern: Patterns::BASELINE_HASH_FIELD, mode: SearchMode.Regex}
            ]


        def has_fixed_match(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                ok found:
                    return 1i64 if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return 2i64


        def has_regex_match(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(check.pattern)
            catch EsSourceFunctionScope::contains_file_regex_line(check.input, pattern):
                ok found:
                    return 1i64 if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return 2i64


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                status: i64 = when check.mode:
                    SearchMode.Regex -> has_regex_match(check)
                    SearchMode.Fixed -> has_fixed_match(check)
                    _ -> 1i64
                return status if status != 0i64
            return 0i64


    public:
        def run_root(script_directory: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            helper: Path = script_directory.joinpath(Inputs::HELPER)
            if not is_executable(helper):
                return 1i64

            docs: Path = path(f"{script_directory}{Inputs::DOCS_SUFFIX}")
            baseline: Path = path(f"{script_directory}{Inputs::BASELINE_SUFFIX}")
            status: i64 = execute(searches(helper, docs, baseline))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            script_directory: Path = try EsShellInvocationPath::script_directory(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_SCRIPT_DIRECTORY)
                return 1i64
            return run_root(script_directory)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsValidationIdentityAudit::run_default()
