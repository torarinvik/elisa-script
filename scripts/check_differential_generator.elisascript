# Bounded Elisascript port of check_differential_generator.sh.
# Fixed-string source checks stream through the shared scanner without rg/awk.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDifferentialGeneratorAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/testing/generator_model.elisa"
            CONSUMER: sview = "src/testing/differential.elisa"
            FIXTURE: sview = "test/differential/elisascript_differential_test.elisa"
            DOCS: sview = "docs/differential-testing.md"


        const module Patterns:
            MODULE: sview = "module EsDifferentialGenerator:"
            CASE_LIMIT: sview = "Limits::CASES"
            BYTE_LIMIT: sview = "Limits::BYTES"
            STATE_ENUM: sview = "const enum DifferentialGeneratorState of u8:"
            EVENT_ENUM: sview = "const enum DifferentialGeneratorEvent of u8:"
            POLICY: sview = "struct DifferentialGeneratorPolicy:"
            GENERATED_INPUT: sview = "struct DifferentialGeneratedInput:"
            SESSION: sview = "struct DifferentialGeneratorSession:"
            ERROR: sview = "error DifferentialGeneratorError:"
            VALIDATE: sview = "def validate_differential_generator_session("
            ADVANCE: sview = "def advance_differential_generator("
            BASE_SEED: sview = "base_seed"
            CASE_SEED: sview = "differential_generator_case_seed"
            SEED_MISMATCH: sview = "SeedMismatch"
            CASE_ORDER: sview = "CaseOrderInvalid"
            BYTE_LIMIT_ERROR: sview = "ByteLimitExceeded"
            EXPECTED_BYTES: sview = "expected_bytes"
            EMPTY_COMPLETION: sview = "session.state == DifferentialGeneratorState.Completed and session.inputs.count == 0"
            EMPTY_PLAN: sview = "session.state == DifferentialGeneratorState.Planned and (session.next_case != 0 or session.generated_bytes != 0 or session.inputs.count != 0)"
            BYTE_ACCOUNTING: sview = "session.generated_bytes != expected_bytes"
            COMPLETE_NOT_READY: sview = "CompleteNotReady"
            MODEL_IMPORT: sview = "include \"./generator_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsDifferentialGenerator"
            FIXTURE_CONTRACT: sview = "differential_generator_contract_derives_case_seeds_and_bounds_payloads"
            FIXTURE_GENERATE: sview = "DifferentialGeneratorEvent.Generate"
            FIXTURE_SEED_MISMATCH: sview = "DifferentialGeneratorError.SeedMismatch"
            FIXTURE_COMPLETED: sview = "DifferentialGeneratorState.Completed"
            FIXTURE_FORGED_BYTES: sview = "forged_generator_bytes"
            FIXTURE_FORGED_PLAN: sview = "forged_planned_generator"
            FIXTURE_PLAN_REJECTED: sview = "planned_generator_rejected"
            FIXTURE_EMPTY_COMPLETE: sview = "forged_empty_complete"
            DOCS_SESSION: sview = "EsDifferentialGenerator::DifferentialGeneratorSession"


        const module Messages:
            MISSING_ROOT: sview = "differential generator audit: missing repository root"
            UNRESOLVED_ROOT: sview = "differential generator audit: unable to resolve repository root"
            MISSING_INPUT: sview = "differential generator audit: missing "
            READ_FAILED: sview = "differential generator audit: unable to read source: "
            SUCCESS: sview = "differential generator audit: bounded reproducible case seeds, ordering, and aggregate payload limits are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::CASE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::BYTE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE_ENUM},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT_ENUM},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::GENERATED_INPUT},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::BASE_SEED},
                SearchCheck{input: inputs[0], pattern: Patterns::CASE_SEED},
                SearchCheck{input: inputs[0], pattern: Patterns::SEED_MISMATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::CASE_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::BYTE_LIMIT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPECTED_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::EMPTY_COMPLETION},
                SearchCheck{input: inputs[0], pattern: Patterns::EMPTY_PLAN},
                SearchCheck{input: inputs[0], pattern: Patterns::BYTE_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETE_NOT_READY},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_GENERATE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_SEED_MISMATCH},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_COMPLETED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_FORGED_BYTES},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_FORGED_PLAN},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_PLAN_REJECTED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_EMPTY_COMPLETE},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION}
            ]


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::CONSUMER),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            for check in searches(inputs):
                status: i64 = has_line(check.input, check.pattern)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDifferentialGeneratorAudit::run_default()
