# Bounded Elisascript port of check_effect_operation_metadata.sh.
# Struct fields are checked within their indentation-delimited declarations.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsEffectOperationMetadataAudit:
    private:
        const module Inputs:
            TOKENS: sview = "vendor/elisa-compiler/src/parser/parser_tokens.elisa"
            PARSER: sview = "vendor/elisa-compiler/src/parser/parser_decl_effect.elisa"
            CAPTURE: sview = "vendor/elisa-compiler/src/parser/parser_decl_impl.elisa"
            SEMANTIC: sview = "vendor/elisa-compiler/src/semantic/check_signal_effect.elisa"
            DOCS: sview = "docs/semantics.md"
            LOWERER: sview = "src/ir/lower_ast.elisa"
            IR_MODEL: sview = "src/ir/ir_model.elisa"
            IR_VERIFY: sview = "src/ir/ir_verify.elisa"
            LOWERING_FIXTURE: sview = "test/ir/elisascript_lowering_test.elisa"
            RUNTIME: sview = "src/ir/interpret.elisa"
            SERIALIZE: sview = "src/ir/serialize.elisa"
            IR_FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            SEMANTIC_FIXTURE: sview = "test/semantic/elisascript_semantic_test.elisa"


        const module Patterns:
            EFFECT_OPERATION_STRUCT: sview = "struct EffectOperation:"
            EFFECT_OPERATION_END: sview = "    struct "
            SIG_EFFECT_OPERATION_STRUCT: sview = "struct SigEffectOperation:"
            SIG_EFFECT_OPERATION_END: sview = "        #"
            EFFECT_OPERATION_CONSTRUCTOR: sview = "Ast::EffectOperation{"
            PAYLOAD_SIGNATURE: sview = "payload_signature"
            RESULT_SIGNATURE: sview = "result_signature"
            OPERATION_ID: sview = "operation_id"
            EFFECT_IDENTITY_HELPER: sview = "def effect_operation_identity("
            STABLE_ID_ASSIGNMENT: sview = "operation_id: Ast::effect_operation_identity"
            IR_ID_DEFAULT: sview = "operation_id: u64 = 0"
            RESUMPTION_ID_DEFAULT: sview = "resumption_id: u64 = 0"
            RESUME_ID_ASSIGNMENT: sview = "resumption_id: Ast::effect_operation_identity(\"Resume\""
            OPERATION_IDENTITY_MATCH: sview = "operation_identity_matches("
            VERIFY_CLAUSE_MATCH: sview = "verify_clause_matches("
            VERIFY_HANDLER_OPERATION: sview = "verify_handler_covers_operation("
            INSTRUCTION_OPERATION_ID: sview = "instruction.operation_id"
            HANDLER_ID_MISMATCH: sview = "handler clause operation id does not match"
            FAMILY_WILDCARD_FIXTURE: sview = "def verifier_does_not_treat_handler_family_as_operation_wildcard("
            RESUME_ID_MISMATCH: sview = "resume id does not match its handler symbol"
            RESUMPTION_ID_FIXTURE: sview = "resumption_id == Ast::effect_operation_identity(\"Resume\""
            FAILURE_OPERATION_ID: sview = "failure_operation_id: mutable u64 = 0"
            CONTINUATION_OPERATION_ID: sview = "operation_id: u64 = 0"
            CONTINUATION_RESUMPTION_ID: sview = "resumption_id: u64 = 0"
            CONTINUATION_ID_USE: sview = "continuation.resumption_id"
            CANONICAL_EMIT_PREFIX: sview = "canonical_emit_u64(output, "
            CANONICAL_HASH_PREFIX: sview = "canonical_hash_u64(result, "
            RUNTIME_OPERATION_MATCH: sview = "def runtime_operation_matches("
            RUNTIME_HANDLER_COVERS: sview = "runtime_handler_covers_operation("
            TYPE_MISMATCH: sview = "DiagnosticKind.TypeMismatch"
            EXPECTED_VOID: sview = "expected: \"void\""
            OPERATION_RESULT_SIGNATURE: sview = "operation_info.result_signature"
            SIG_TRIM_EFFECT_SPAN: sview = "sig_trim_effect_span"
            SIG_EFFECT_PAYLOAD_SEGMENT: sview = "sig_effect_payload_segment"
            SIG_EFFECT_PAYLOAD_TYPE: sview = "sig_effect_payload_type"
            SIG_EFFECT_PAYLOAD_TYPE_AT: sview = "sig_effect_payload_type_at"
            SIG_CHECK_EFFECT_LITERAL: sview = "sig_check_effect_literal_payloads"
            SIG_CHECK_SIGNAL_LITERAL: sview = "sig_check_signal_literal_payloads"
            LITERAL_NEVER_FITS: sview = "literal_never_fits(literal_kind, expected)"
            STAGE0_LITERAL: sview = "stage0_literal_spelling(literal_kind)"
            PERFORM_LITERAL_CHECK: sview = "sig_check_effect_literal_payloads(arguments, 1, operation, operation_info.payload_signature"
            SIGNAL_LITERAL_CHECK: sview = "sig_check_signal_literal_payloads(body, operation, operation_info.payload_signature"
            NAMED_ARGUMENT_ERROR: sview = "DiagnosticKind.NamedArgError"
            EXPECTED_POSITIONAL: sview = "expected: \"positional\""
            VALIDATE_PERFORM: sview = "sig_validate_perform(callee, arguments, argument_names)"
            SIGNAL_LITERAL_FIXTURE: sview = "source_effect_signal_literal_payload_type_is_checked"
            PERFORM_LITERAL_FIXTURE: sview = "source_effect_perform_literal_payload_type_is_checked"
            POSITIONAL_FIXTURE: sview = "def source_effect_perform_payloads_must_be_positional("
            BARE_RESULT_SPELLING: sview = "effect_operation_bare_result_spelling"
            TRIM_TYPE_SPELLING: sview = "effect_operation_trim_type_spelling"
            TOP_LEVEL_COMMA: sview = "effect_operation_top_level_comma"
            TYPE_FROM_SPELLING: sview = "effect_operation_type_from_spelling"
            RESULT_TYPE: sview = "effect_operation_result_type"
            RESULT_IS_KNOWN: sview = "effect_operation_result_is_known"
            OPERATION_DECLARED: sview = "effect_operation_declared"
            DECLARED_ARITY: sview = "effect_operation_declared_arity"
            PARAMETER_TYPE: sview = "effect_operation_parameter_type"
            PAYLOAD_TYPE: sview = "effect_operation_payload_type"
            SINGLE_PAYLOAD_TYPE: sview = "effect_operation_single_payload_type"
            PAYLOAD_IS_KNOWN: sview = "effect_operation_payload_is_known"
            HANDLER_CONFORMS: sview = "def source_handler_operation_conforms("
            ADD_CALLBACK_CONTRACT: sview = "def source_handler_add_callback_contract"
            HANDLER_INTRODUCES: sview = "handler.introduces_effects <- updated_effects"
            HANDLER_ERRORS: sview = "handler.errors <- updated_errors"
            CALLBACK_CONTRACT_CALL: sview = "source_handler_add_callback_contract(file, function_line, effects, handler)"
            CALLBACK_PARAMETER_COUNT: sview = "callback parameter count does not match the declared effect operation"
            CALLBACK_PARAMETER_TYPE: sview = "callback parameter type does not match the declared effect operation payload"
            CALLBACK_RESULT_TYPE: sview = "callback result type does not match the declared effect operation result"
            PERFORM_RESULT_LOOKUP: sview = "effect_operation_result_type(state.source_file, family, operation)"
            PERFORM_PAYLOAD_LOOKUP: sview = "effect_operation_payload_type(state.source_file, family, operation, argument_index - 1)"
            SIGNAL_PAYLOAD_LOOKUP: sview = "effect_operation_payload_type(state.source_file, effect_family(reference), effect_operation(reference), payload_index)"
            ARRAY_IR_TYPE: sview = "array_ir_type(element)"
            SET_IR_TYPE: sview = "set_ir_type(element)"
            MAP_IR_TYPE: sview = "map_ir_type(key, value)"
            TYPE_TOP_LEVEL_COMMA: sview = "effect_operation_top_level_comma(inner)"
            SINGLE_PAYLOAD_LIMIT: sview = "at most one positional payload"
            PAYLOAD_COUNT_CAST: sview = "payloads.count.u16()"
            PAYLOAD_INDEX_LOOP: sview = "payload_index in 0..<operand_types.count"
            PERFORM_DECLARED_ARITY: sview = "effect_operation_declared(state.source_file, family, operation)"
            SIGNAL_DECLARED_ARITY: sview = "effect_operation_declared(state.source_file, effect_family(reference), effect_operation(reference))"
            PERFORM_ARITY_ERROR: sview = "perform payload arity does not match the declared effect operation"
            SIGNAL_ARITY_ERROR: sview = "signal payload arity does not match the declared effect operation"
            SIGNAL_VOID_ERROR: sview = "signal requires a void declared effect operation result"
            DOC_SPANS: sview = "exact source spans for the parenthesized payload list and result type"
            DOC_PAYLOAD_SIGNATURE: sview = "payload_signature"
            DOC_RESULT_SIGNATURE: sview = "result_signature"


        const module Messages:
            MISSING_ROOT: sview = "effect operation metadata audit: missing repository root"
            UNRESOLVED_ROOT: sview = "effect operation metadata audit: unable to resolve repository root"
            MISSING_INPUT: sview = "effect operation metadata audit: missing file: "
            READ_FAILED: sview = "effect operation metadata audit: unable to read source: "
            EFFECT_FIELD_MISSING: sview = "effect operation metadata audit: EffectOperation omits "
            SEMANTIC_FIELD_MISSING: sview = "effect operation metadata audit: semantic lookup omits "
            CAPTURE_FIELDS_MISSING: sview = "effect operation metadata audit: capture constructor omits operation signature fields"
            CAPTURE_ID_MISSING: sview = "effect operation metadata audit: capture constructor omits operation_id"
            PARSER_HELPER_MISSING: sview = "effect operation metadata audit: parser omits "
            SEMANTIC_CANDIDATE_MISSING: sview = "effect operation metadata audit: semantic lookup does not carry candidate."
            STABLE_ID_MISSING: sview = "effect operation metadata audit: parser does not assign the stable operation identity"
            IR_ID_MISSING: sview = "effect operation metadata audit: IR operation identity fields/helper are missing"
            RESUME_IR_ID_MISSING: sview = "effect operation metadata audit: IR/lowering resumption identity fields are missing"
            VERIFIER_IDENTITY_MISSING: sview = "effect operation metadata audit: verifier does not validate populated operation identities"
            WILDCARD_FIXTURE_MISSING: sview = "effect operation metadata audit: exact-operation handler coverage fixture is missing"
            FIXTURE_IDENTITY_MISSING: sview = "effect operation metadata audit: lowering fixtures omit operation identity coverage"
            RESUME_FIXTURE_MISSING: sview = "effect operation metadata audit: verifier/fixture resumption identity coverage is missing"
            RUNTIME_FAILURE_ID_MISSING: sview = "effect operation metadata audit: runtime failure/guard ids are missing"
            RUNTIME_RESUME_ID_MISSING: sview = "effect operation metadata audit: runtime continuation identity matching is missing"
            SERIALIZED_ID_MISSING: sview = "effect operation metadata audit: canonical serialization omits "
            RUNTIME_DISPATCH_MISSING: sview = "effect operation metadata audit: runtime handler dispatch does not consume operation identities"
            NONVOID_DECLARATION_MISSING: sview = "effect operation metadata audit: semantic signal checking does not reject non-void declarations"
            SEMANTIC_HELPER_MISSING: sview = "effect operation metadata audit: semantic literal-payload helper is missing: "
            MISMATCH_ORACLE_MISSING: sview = "effect operation metadata audit: semantic literal-payload check does not use the shared mismatch oracle"
            LITERAL_CHECK_WIRING_MISSING: sview = "effect operation metadata audit: semantic perform/signal literal payload checks are not wired"
            NAMED_ARGUMENT_MISSING: sview = "effect operation metadata audit: semantic perform named-argument rejection is missing"
            LITERAL_FIXTURE_MISSING: sview = "effect operation metadata audit: semantic literal-payload fixture is missing: "
            POSITIONAL_FIXTURE_MISSING: sview = "effect operation metadata audit: semantic perform named-argument fixture is missing"
            LOWERER_HELPER_MISSING: sview = "effect operation metadata audit: lowerer omits "
            HANDLER_CONFORMANCE_MISSING: sview = "effect operation metadata audit: source handler conformance helper is missing"
            CALLBACK_PROPAGATION_MISSING: sview = "effect operation metadata audit: source handler callback contract propagation helper is missing"
            CONFORMANCE_MISSING: sview = "effect operation metadata audit: source handler conformance omits "
            PERFORM_RESULT_LOOKUP_MISSING: sview = "effect operation metadata audit: perform lowering does not consult declared result metadata"
            PERFORM_PAYLOAD_LOOKUP_MISSING: sview = "effect operation metadata audit: perform lowering does not consult each declared payload type"
            SIGNAL_PAYLOAD_LOOKUP_MISSING: sview = "effect operation metadata audit: signal lowering does not consult each declared payload type"
            STRUCTURAL_TYPE_MISSING: sview = "effect operation metadata audit: structural type spelling support omits "
            SINGLE_PAYLOAD_REMAINS: sview = "effect operation metadata audit: lowerer still caps perform at one payload"
            MULTI_PAYLOAD_SHAPE_MISSING: sview = "effect operation metadata audit: ordered multi-payload lowering omits "
            PERFORM_ARITY_LOOKUP_MISSING: sview = "effect operation metadata audit: perform lowering does not enforce source operation arity"
            SIGNAL_ARITY_LOOKUP_MISSING: sview = "effect operation metadata audit: signal lowering does not enforce source operation arity"
            ARITY_DIAGNOSTIC_MISSING: sview = "effect operation metadata audit: lowerer omits arity diagnostic: "
            SIGNAL_VOID_LOOKUP_MISSING: sview = "effect operation metadata audit: signal lowering does not reject non-void declarations"
            DOCS_MISSING: sview = "effect operation metadata audit: semantics documentation omits preserved signature spans"
            SUCCESS: sview = "effect operation metadata audit: typed declaration spans preserved through parser and semantic lookup"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def require_patterns(input: Path, patterns: darray[sview], message: sview, append_pattern: bool = false) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for pattern in patterns:
                found: bool = try EsSourceFunctionScope::contains_file_line(input, pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{input}")
                    return ExitStatus::IO_FAILURE
                if not found:
                    if append_pattern:
                        diagnostic(message + f"{pattern}")
                    else:
                        diagnostic(message)
                    return ExitStatus::FAILURE
            return 0i64


        def require_line_sequence(input: Path, first: sview, second: sview, third: sview, message: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            found: bool = try EsSourceFunctionScope::contains_file_line(input, first, second, third) else err:
                diagnostic(Messages::READ_FAILED + f"{input}")
                return ExitStatus::IO_FAILURE
            if not found:
                diagnostic(message)
                return ExitStatus::FAILURE
            return 0i64


        def require_scope_fields(input: Path, start_marker: sview, end_prefix: sview, indentation: sview, fields: darray[sview], message: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for field in fields:
                pattern: sview = indentation + field + ":"
                found: bool = try EsSourceFunctionScope::contains_file_block_line(input, start_marker, end_prefix, pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{input}")
                    return ExitStatus::IO_FAILURE
                if not found:
                    diagnostic(message + f"{field}")
                    return ExitStatus::FAILURE
            return 0i64


        def require_constructor_fields(input: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            payload_signature: bool = try EsSourceFunctionScope::contains_file_line(input, Patterns::EFFECT_OPERATION_CONSTRUCTOR, "payload_signature:") else err:
                diagnostic(Messages::READ_FAILED + f"{input}")
                return ExitStatus::IO_FAILURE
            result_signature: bool = try EsSourceFunctionScope::contains_file_line(input, Patterns::EFFECT_OPERATION_CONSTRUCTOR, "result_signature:") else err:
                diagnostic(Messages::READ_FAILED + f"{input}")
                return ExitStatus::IO_FAILURE
            if not payload_signature or not result_signature:
                diagnostic(Messages::CAPTURE_FIELDS_MISSING)
                return ExitStatus::FAILURE
            operation_id: bool = try EsSourceFunctionScope::contains_file_line(input, Patterns::EFFECT_OPERATION_CONSTRUCTOR, "operation_id:") else err:
                diagnostic(Messages::READ_FAILED + f"{input}")
                return ExitStatus::IO_FAILURE
            if not operation_id:
                diagnostic(Messages::CAPTURE_ID_MISSING)
                return ExitStatus::FAILURE
            return 0i64


        def require_either_file(first_path: Path, second_path: Path, pattern: sview, message: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            first_found: bool = try EsSourceFunctionScope::contains_file_line(first_path, pattern) else err:
                diagnostic(Messages::READ_FAILED + f"{first_path}")
                return ExitStatus::IO_FAILURE
            if first_found:
                return 0i64
            second_found: bool = try EsSourceFunctionScope::contains_file_line(second_path, pattern) else err:
                diagnostic(Messages::READ_FAILED + f"{second_path}")
                return ExitStatus::IO_FAILURE
            if not second_found:
                diagnostic(message + f"{pattern}")
                return ExitStatus::FAILURE
            return 0i64


        def helper_checks(input: Path, helpers: darray[sview], prefix: sview, suffix: sview, missing_message: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for helper in helpers:
                pattern: sview = prefix + helper + suffix
                found: bool = try EsSourceFunctionScope::contains_file_line(input, pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{input}")
                    return ExitStatus::IO_FAILURE
                if not found:
                    diagnostic(missing_message + f"{helper}")
                    return ExitStatus::FAILURE
            return 0i64


        def check_identity_ids(serialize_path: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            ids: darray[sview] = ["value.operation_id", "value.resumption_id"]
            for serialized_id in ids:
                emit_pattern: sview = Patterns::CANONICAL_EMIT_PREFIX + serialized_id + ")"
                hash_pattern: sview = Patterns::CANONICAL_HASH_PREFIX + serialized_id + ")"
                emit_found: bool = try EsSourceFunctionScope::contains_file_line(serialize_path, emit_pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{serialize_path}")
                    return ExitStatus::IO_FAILURE
                hash_found: bool = try EsSourceFunctionScope::contains_file_line(serialize_path, hash_pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{serialize_path}")
                    return ExitStatus::IO_FAILURE
                if not emit_found or not hash_found:
                    diagnostic(Messages::SERIALIZED_ID_MISSING + f"{serialized_id}")
                    return ExitStatus::FAILURE
            return 0i64


        def has_any_line(input: Path, patterns: darray[sview]) -> bool error[EsSourceFunctionScope::Error] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            for pattern in patterns:
                found: bool = try EsSourceFunctionScope::contains_file_line(input, pattern)
                if found:
                    return true
            return false


        def execute_all(inputs: darray[Path]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = require_scope_fields(inputs[0], Patterns::EFFECT_OPERATION_STRUCT, Patterns::EFFECT_OPERATION_END, "        ", ["arity", Patterns::PAYLOAD_SIGNATURE, Patterns::RESULT_SIGNATURE, Patterns::OPERATION_ID], Messages::EFFECT_FIELD_MISSING)
            return status if status != 0i64
            status <- helper_checks(inputs[1], ["effect_operation_payload_signature", "effect_operation_result_signature"], "def ", "(", Messages::PARSER_HELPER_MISSING)
            return status if status != 0i64
            status <- require_constructor_fields(inputs[2])
            return status if status != 0i64
            status <- require_scope_fields(inputs[3], Patterns::SIG_EFFECT_OPERATION_STRUCT, Patterns::SIG_EFFECT_OPERATION_END, "            ", [Patterns::PAYLOAD_SIGNATURE, Patterns::RESULT_SIGNATURE, Patterns::OPERATION_ID], Messages::SEMANTIC_FIELD_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[3], ["candidate.payload_signature", "candidate.result_signature", "candidate.operation_id"], Messages::SEMANTIC_CANDIDATE_MISSING, true)
            return status if status != 0i64
            status <- require_patterns(inputs[0], [Patterns::EFFECT_IDENTITY_HELPER], Messages::STABLE_ID_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[2], [Patterns::STABLE_ID_ASSIGNMENT], Messages::STABLE_ID_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[6], [Patterns::IR_ID_DEFAULT, Patterns::EFFECT_IDENTITY_HELPER], Messages::IR_ID_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[6], [Patterns::RESUMPTION_ID_DEFAULT], Messages::RESUME_IR_ID_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[5], [Patterns::RESUME_ID_ASSIGNMENT], Messages::RESUME_IR_ID_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[7], [Patterns::OPERATION_IDENTITY_MATCH, Patterns::VERIFY_CLAUSE_MATCH, Patterns::HANDLER_ID_MISMATCH], Messages::VERIFIER_IDENTITY_MISSING)
            return status if status != 0i64
            status <- require_line_sequence(inputs[7], Patterns::VERIFY_HANDLER_OPERATION, Patterns::INSTRUCTION_OPERATION_ID, "", Messages::VERIFIER_IDENTITY_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[11], [Patterns::FAMILY_WILDCARD_FIXTURE], Messages::WILDCARD_FIXTURE_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[8], ["operation_id == Ast::effect_operation_identity", Patterns::HANDLER_ID_MISMATCH], Messages::FIXTURE_IDENTITY_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[7], [Patterns::RESUME_ID_MISMATCH], Messages::RESUME_FIXTURE_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[8], [Patterns::RESUMPTION_ID_FIXTURE], Messages::RESUME_FIXTURE_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[9], [Patterns::FAILURE_OPERATION_ID, Patterns::CONTINUATION_OPERATION_ID], Messages::RUNTIME_FAILURE_ID_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[9], [Patterns::CONTINUATION_RESUMPTION_ID, Patterns::CONTINUATION_ID_USE], Messages::RUNTIME_RESUME_ID_MISSING)
            return status if status != 0i64
            status <- check_identity_ids(inputs[10])
            return status if status != 0i64
            status <- require_patterns(inputs[9], [Patterns::RUNTIME_OPERATION_MATCH], Messages::RUNTIME_DISPATCH_MISSING)
            return status if status != 0i64
            status <- require_line_sequence(inputs[9], Patterns::RUNTIME_HANDLER_COVERS, Patterns::INSTRUCTION_OPERATION_ID, "", Messages::RUNTIME_DISPATCH_MISSING)
            return status if status != 0i64
            status <- require_line_sequence(inputs[3], Patterns::TYPE_MISMATCH, Patterns::EXPECTED_VOID, Patterns::OPERATION_RESULT_SIGNATURE, Messages::NONVOID_DECLARATION_MISSING)
            return status if status != 0i64
            status <- helper_checks(inputs[3], [Patterns::SIG_TRIM_EFFECT_SPAN, Patterns::SIG_EFFECT_PAYLOAD_SEGMENT, Patterns::SIG_EFFECT_PAYLOAD_TYPE, Patterns::SIG_EFFECT_PAYLOAD_TYPE_AT, Patterns::SIG_CHECK_EFFECT_LITERAL, Patterns::SIG_CHECK_SIGNAL_LITERAL], "def ", "(", Messages::SEMANTIC_HELPER_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[3], [Patterns::LITERAL_NEVER_FITS, Patterns::STAGE0_LITERAL], Messages::MISMATCH_ORACLE_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[3], [Patterns::PERFORM_LITERAL_CHECK, Patterns::SIGNAL_LITERAL_CHECK], Messages::LITERAL_CHECK_WIRING_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[3], [Patterns::NAMED_ARGUMENT_ERROR, Patterns::EXPECTED_POSITIONAL, Patterns::VALIDATE_PERFORM], Messages::NAMED_ARGUMENT_MISSING)
            return status if status != 0i64
            status <- require_either_file(inputs[8], inputs[12], Patterns::SIGNAL_LITERAL_FIXTURE, Messages::LITERAL_FIXTURE_MISSING)
            return status if status != 0i64
            status <- require_either_file(inputs[8], inputs[12], Patterns::PERFORM_LITERAL_FIXTURE, Messages::LITERAL_FIXTURE_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[12], [Patterns::POSITIONAL_FIXTURE], Messages::POSITIONAL_FIXTURE_MISSING)
            return status if status != 0i64
            status <- helper_checks(inputs[5], [Patterns::BARE_RESULT_SPELLING, Patterns::TRIM_TYPE_SPELLING, Patterns::TOP_LEVEL_COMMA, Patterns::TYPE_FROM_SPELLING, Patterns::RESULT_TYPE, Patterns::RESULT_IS_KNOWN, Patterns::OPERATION_DECLARED, Patterns::DECLARED_ARITY, Patterns::PARAMETER_TYPE, Patterns::PAYLOAD_TYPE, Patterns::SINGLE_PAYLOAD_TYPE, Patterns::PAYLOAD_IS_KNOWN], "def ", "(", Messages::LOWERER_HELPER_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[5], [Patterns::HANDLER_CONFORMS], Messages::HANDLER_CONFORMANCE_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[5], [Patterns::ADD_CALLBACK_CONTRACT], Messages::CALLBACK_PROPAGATION_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[5], [Patterns::HANDLER_INTRODUCES, Patterns::HANDLER_ERRORS], Messages::CALLBACK_PROPAGATION_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[5], [Patterns::CALLBACK_CONTRACT_CALL], Messages::CALLBACK_PROPAGATION_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[5], [Patterns::CALLBACK_PARAMETER_COUNT, Patterns::CALLBACK_PARAMETER_TYPE, Patterns::CALLBACK_RESULT_TYPE], Messages::CONFORMANCE_MISSING, true)
            return status if status != 0i64
            status <- require_patterns(inputs[5], [Patterns::PERFORM_RESULT_LOOKUP], Messages::PERFORM_RESULT_LOOKUP_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[5], [Patterns::PERFORM_PAYLOAD_LOOKUP], Messages::PERFORM_PAYLOAD_LOOKUP_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[5], [Patterns::SIGNAL_PAYLOAD_LOOKUP], Messages::SIGNAL_PAYLOAD_LOOKUP_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[5], [Patterns::ARRAY_IR_TYPE, Patterns::SET_IR_TYPE, Patterns::MAP_IR_TYPE, Patterns::TYPE_TOP_LEVEL_COMMA], Messages::STRUCTURAL_TYPE_MISSING, true)
            return status if status != 0i64
            unsupported_single_payload: bool = try EsSourceFunctionScope::contains_file_line(inputs[5], Patterns::SINGLE_PAYLOAD_LIMIT) else err:
                diagnostic(Messages::READ_FAILED + f"{inputs[5]}")
                return ExitStatus::IO_FAILURE
            if unsupported_single_payload:
                diagnostic(Messages::SINGLE_PAYLOAD_REMAINS)
                return ExitStatus::FAILURE
            status <- require_patterns(inputs[5], [Patterns::PAYLOAD_COUNT_CAST, Patterns::PAYLOAD_INDEX_LOOP], Messages::MULTI_PAYLOAD_SHAPE_MISSING, true)
            return status if status != 0i64
            status <- require_patterns(inputs[5], [Patterns::PERFORM_DECLARED_ARITY], Messages::PERFORM_ARITY_LOOKUP_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[5], [Patterns::SIGNAL_DECLARED_ARITY], Messages::SIGNAL_ARITY_LOOKUP_MISSING)
            return status if status != 0i64
            status <- require_patterns(inputs[5], [Patterns::PERFORM_ARITY_ERROR, Patterns::SIGNAL_ARITY_ERROR], Messages::ARITY_DIAGNOSTIC_MISSING, true)
            return status if status != 0i64
            status <- require_patterns(inputs[5], [Patterns::SIGNAL_VOID_ERROR], Messages::SIGNAL_VOID_LOOKUP_MISSING)
            return status if status != 0i64
            docs_has_span_evidence: bool = try has_any_line(inputs[4], [Patterns::DOC_SPANS, Patterns::DOC_PAYLOAD_SIGNATURE, Patterns::DOC_RESULT_SIGNATURE]) else err:
                diagnostic(Messages::READ_FAILED + f"{inputs[4]}")
                return ExitStatus::IO_FAILURE
            if not docs_has_span_evidence:
                diagnostic(Messages::DOCS_MISSING)
                return ExitStatus::FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::TOKENS),
                root.joinpath(Inputs::PARSER),
                root.joinpath(Inputs::CAPTURE),
                root.joinpath(Inputs::SEMANTIC),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LOWERER),
                root.joinpath(Inputs::IR_MODEL),
                root.joinpath(Inputs::IR_VERIFY),
                root.joinpath(Inputs::LOWERING_FIXTURE),
                root.joinpath(Inputs::RUNTIME),
                root.joinpath(Inputs::SERIALIZE),
                root.joinpath(Inputs::IR_FIXTURE),
                root.joinpath(Inputs::SEMANTIC_FIXTURE)
            ]
            required_inputs: darray[Path] = [
                inputs[0], inputs[1], inputs[2], inputs[3], inputs[4], inputs[5],
                inputs[6], inputs[7], inputs[8], inputs[9], inputs[10]
            ]
            for input_path in required_inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::IO_FAILURE
            status: i64 = execute_all(inputs)
            return status if status != 0i64
            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsEffectOperationMetadataAudit::run_default()
