# Public interpreted companion for the nine-line Skia environment query.
# Source-only: not compiled or qualified. The native candidate stays separate.
include "../src/runtime/environment_lookup_model.elisa"

module EsSkiaEnvironmentInterpreted:
    private:
        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr("get environment: " + message + "\n")

    public:
        def run(arguments: darray[sview]) -> i64 can[Environment.Read, Memory.Allocate, Abort.Panic, Console.Write]:
            if arguments.count == 0:
                diagnostic("expected an environment variable name")
                return 1i64
            name: sview = arguments[0]
            value: mutable EsEnvironmentLookup::Value = EsEnvironmentLookup::Value{present: false}
            if not EsEnvironmentLookup::impossible_key(name):
                try EsEnvironmentLookup::validate_name(name) else err:
                    diagnostic("unable to read environment within bounds")
                    return 2i64
                present: bool = try has_environment(name) else err:
                    diagnostic("unable to read environment within bounds")
                    return 2i64
                if present:
                    bytes: sview = try get_environment_bounded(name, EsEnvironmentLookup::Limits::VALUE_BYTES.i64()) else err:
                        diagnostic("unable to read environment within bounds")
                        return 2i64
                    value <- EsEnvironmentLookup::Value{present: true, bytes: bytes}
            output: sview = try EsEnvironmentLookup::python_print_value(value) else err:
                diagnostic("invalid environment lookup value")
                return 2i64
            written: usize = try write_stdout(output) else err:
                diagnostic("unable to write stdout")
                return 1i64
            if written != len(output):
                diagnostic("short stdout write")
                return 1i64
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Environment.Read, Memory.Allocate, Abort.Panic, Console.Write]:
    return EsSkiaEnvironmentInterpreted::run(arguments)
