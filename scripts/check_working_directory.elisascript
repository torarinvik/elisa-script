# Bounded Elisascript port of check_working_directory.sh.
# Regex source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsWorkingDirectoryAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/working_directory_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsWorkingDirectory:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/working_directory_model\.elisa\""
            LEASE_STATE: Regex = regex"const enum WorkingDirectoryLeaseState of u8"
            STATE: Regex = regex"const enum WorkingDirectoryState of u8"
            EVENT: Regex = regex"const enum WorkingDirectoryEvent of u8"
            POLICY: Regex = regex"struct WorkingDirectoryPolicy:"
            TABLE: Regex = regex"struct WorkingDirectoryTable:"
            SESSION: Regex = regex"struct WorkingDirectorySession:"
            ERROR: Regex = regex"error WorkingDirectoryError:"
            VALIDATE_TABLE: Regex = regex"def validate_working_directory_table\("
            VALIDATE_SESSION: Regex = regex"def validate_working_directory_session\("
            ADVANCE: Regex = regex"def advance_working_directory\("
            MAX_CONTEXTS: Regex = regex"WORKING_DIRECTORY_MAX_CONTEXTS"
            MAX_PATH_BYTES: Regex = regex"WORKING_DIRECTORY_MAX_PATH_BYTES"
            MAX_CHANGES: Regex = regex"WORKING_DIRECTORY_MAX_CHANGES"
            ACTIVE: Regex = regex"working_directory_active"
            CHANGE_ACK: Regex = regex"WorkingDirectoryEvent.ChangeAck"
            RESTORE_ACK: Regex = regex"WorkingDirectoryEvent.RestoreAck"
            CONCURRENT_OWNER: Regex = regex"WorkingDirectoryError.ConcurrentOwner"
            LEASE_ID_MONOTONIC: Regex = regex"table.next_lease_id <= lease.lease_id"
            LEASE_ID_EXHAUSTED: Regex = regex"table.next_lease_id == 18446744073709551615u64"
            CANCEL_NOT_READY: Regex = regex"WorkingDirectoryError.CancelNotReady"
            FAILED_STATE: Regex = regex"WorkingDirectoryLeaseState.Failed"
            INITIAL_NUL: Regex = regex"raise WorkingDirectoryError.EmbeddedNul if sview_contains_byte\(lease.initial_path, 0\) or sview_contains_byte\(lease.current_path, 0\)"
            PENDING_NUL: Regex = regex"raise WorkingDirectoryError.EmbeddedNul if sview_contains_byte\(lease.pending_path, 0\)"
            REQUEST_INITIAL_NUL: Regex = regex"raise WorkingDirectoryError.EmbeddedNul if sview_contains_byte\(session.request.initial_path, 0\)"
            PATH_NUL: Regex = regex"raise WorkingDirectoryError.EmbeddedNul if sview_contains_byte\(path, 0\)"
            HELD_WITH_PENDING: Regex = regex"lease.state == WorkingDirectoryLeaseState.Held and lease.pending_path != \"\""
            TRANSITIONING: Regex = regex"lease.state == WorkingDirectoryLeaseState.Changing or lease.state == WorkingDirectoryLeaseState.Restoring"
            RESTORED: Regex = regex"lease.state == WorkingDirectoryLeaseState.Restored and"
            ACTIVE_CONTEXTS: Regex = regex"active_contexts"
            FIXTURE_IMPORT: Regex = regex"using EsWorkingDirectory"
            FIXTURE_CONTRACT: Regex = regex"typed_working_directory_contract_serializes_changes_and_restore"
            FIXTURE_CHANGE: Regex = regex"WorkingDirectoryEvent.Change"
            FIXTURE_CHANGE_ACK: Regex = regex"WorkingDirectoryEvent.ChangeAck"
            FIXTURE_RESTORE_ACK: Regex = regex"WorkingDirectoryEvent.RestoreAck"
            FIXTURE_CONCURRENT_OWNER: Regex = regex"WorkingDirectoryError.ConcurrentOwner"
            FIXTURE_CANCEL_ACK: Regex = regex"WorkingDirectoryEvent.CancelAck"
            FORGED_IDENTITY: Regex = regex"forged_identity"
            EXHAUSTED_REJECTED: Regex = regex"exhausted_rejected"
            NUL_REQUEST: Regex = regex"nul_request_precedes_invalid_path"
            NUL_CHANGE: Regex = regex"nul_change_precedes_invalid_path"
            NUL_INITIAL: Regex = regex"nul_initial_precedes_invalid_path"
            NUL_CURRENT: Regex = regex"nul_current_precedes_invalid_path"
            NUL_PENDING: Regex = regex"nul_pending_precedes_invalid_path"
            DOCS_TABLE: Regex = regex"EsWorkingDirectory::WorkingDirectoryTable"
            LEDGER_ITEM: Regex = regex"ES-FS-006"


        const module Messages:
            MISSING_ROOT: sview = "working directory audit: missing repository root"
            UNRESOLVED_ROOT: sview = "working directory audit: unable to resolve repository root"
            MISSING_INPUT: sview = "working directory audit: missing "
            READ_FAILED: sview = "working directory audit: unable to read source: "
            SUCCESS: sview = "working directory audit: serialized bounded cwd ownership, acknowledgement, and restore edges are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::LEASE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::TABLE},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_TABLE},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_CONTEXTS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_PATH_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_CHANGES},
                SearchCheck{input: inputs[0], pattern: Patterns::ACTIVE},
                SearchCheck{input: inputs[0], pattern: Patterns::CHANGE_ACK},
                SearchCheck{input: inputs[0], pattern: Patterns::RESTORE_ACK},
                SearchCheck{input: inputs[0], pattern: Patterns::CONCURRENT_OWNER},
                SearchCheck{input: inputs[0], pattern: Patterns::LEASE_ID_MONOTONIC},
                SearchCheck{input: inputs[0], pattern: Patterns::LEASE_ID_EXHAUSTED},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::INITIAL_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::PENDING_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST_INITIAL_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::HELD_WITH_PENDING},
                SearchCheck{input: inputs[0], pattern: Patterns::TRANSITIONING},
                SearchCheck{input: inputs[0], pattern: Patterns::RESTORED},
                SearchCheck{input: inputs[0], pattern: Patterns::ACTIVE_CONTEXTS},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CHANGE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CHANGE_ACK},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_RESTORE_ACK},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONCURRENT_OWNER},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CANCEL_ACK},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_IDENTITY},
                SearchCheck{input: inputs[2], pattern: Patterns::EXHAUSTED_REJECTED},
                SearchCheck{input: inputs[2], pattern: Patterns::NUL_REQUEST},
                SearchCheck{input: inputs[2], pattern: Patterns::NUL_CHANGE},
                SearchCheck{input: inputs[2], pattern: Patterns::NUL_INITIAL},
                SearchCheck{input: inputs[2], pattern: Patterns::NUL_CURRENT},
                SearchCheck{input: inputs[2], pattern: Patterns::NUL_PENDING},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_TABLE},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsWorkingDirectoryAudit::run_default()
