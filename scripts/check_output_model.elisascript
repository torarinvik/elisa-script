# Bounded Elisascript port of check_output_model.sh.
# All source contracts are fixed-string checks through the shared line scanner.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsOutputModelAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/output_model.elisa"
            HUMAN_MODEL: sview = "src/runtime/output_human_model.elisa"
            JSON_MODEL: sview = "src/runtime/output_json_model.elisa"
            JUNIT_MODEL: sview = "src/runtime/output_junit_model.elisa"
            RENDERER: sview = "src/runtime/output_renderer_model.elisa"
            TRANSPORT: sview = "src/runtime/output_transport_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            EXECUTION: sview = "src/ir/execution.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"


        const module Patterns:
            MODULE: sview = "module EsOutput:"
            LIMITS: sview = "const module Limits:"
            RECORDS_LIMIT: sview = "Limits::RECORDS"
            TEXT_BYTES_LIMIT: sview = "Limits::TEXT_BYTES"
            NAME_BYTES_LIMIT: sview = "Limits::NAME_BYTES"
            FORMAT: sview = "const enum OutputFormat of u8:"
            STATUS: sview = "const enum OutputStatus of u8:"
            DOCUMENT_STATE: sview = "const enum OutputDocumentState of u8:"
            OPTIONS: sview = "struct OutputOptions:"
            RECORD: sview = "struct OutputRecord:"
            DOCUMENT: sview = "struct OutputDocument:"
            CONTRACT_ERROR: sview = "error OutputContractError:"
            VALIDATE_OPTIONS: sview = "def validate_output_options("
            VALIDATE_DOCUMENT: sview = "def validate_output_document("
            ADVANCE_DOCUMENT: sview = "def advance_output_document("
            TEXT_LIMIT_EXCEEDED: sview = "TextLimitExceeded"
            TEXT_ACCOUNTING_INVALID: sview = "TextAccountingInvalid"
            ACCOUNTED_TEXT: sview = "accounted_text"
            FAILED_RECORD_ACCOUNTING: sview = "FailedRecordAccountingInvalid"
            RECORD_LIMIT_EXCEEDED: sview = "RecordLimitExceeded"
            INVALID_COLOR_MODE: sview = "InvalidColorMode"
            OUTPUT_LIMIT_INVALID: sview = "OutputLimitInvalid"
            APPEND_NOT_READY: sview = "AppendNotReady"
            SEAL_NOT_READY: sview = "SealNotReady"
            FLAKY_STATUS: sview = "OutputStatus.Flaky"
            EMPTY_PAYLOAD: sview = "output_record_is_empty_payload"
            FAILED_RECORDS: sview = "failed_records"
            IR_OUTPUT_MODEL: sview = "include \"../runtime/output_model.elisa\""
            HUMAN_MODULE: sview = "module EsOutputHuman:"
            HUMAN_RENDER_DOCUMENT: sview = "def render_output_document_human("
            HUMAN_HEADER_FRAME: sview = "def render_output_human_header_frame("
            HUMAN_RECORD_FRAME: sview = "def render_output_human_record_frame("
            HUMAN_FOOTER_FRAME: sview = "def render_output_human_footer_frame("
            HUMAN_MEASURE_RECORD_FRAME: sview = "def measure_output_human_record_frame("
            HUMAN_APPEND_FOOTER: sview = "output_human_append_footer("
            HUMAN_APPEND_ESCAPED_TEXT: sview = "output_human_append_escaped_text("
            HUMAN_APPEND_HEX_BYTE: sview = "output_human_append_hex_byte("
            COUNT_ONLY: sview = "count_only"
            JSON_MODULE: sview = "module EsOutputJson:"
            JSON_APPEND_STRING: sview = "output_json_append_string("
            JSON_APPEND_FOOTER: sview = "output_json_append_footer("
            JSON_RENDER_DOCUMENT: sview = "def render_output_document_json("
            JSON_HEADER_FRAME: sview = "def render_output_json_header_frame("
            JSON_RECORD_FRAME: sview = "def render_output_json_record_frame("
            JSON_FOOTER_FRAME: sview = "def render_output_json_footer_frame("
            JSON_MEASURE_HEADER: sview = "def measure_output_json_header_frame("
            JSON_MEASURE_RECORD: sview = "def measure_output_json_record_frame("
            JSON_MEASURE_FOOTER: sview = "def measure_output_json_footer_frame("
            SUMMARY: sview = "summary"
            INVALID_UTF8: sview = "InvalidUtf8"
            JUNIT_RENDER_DOCUMENT: sview = "def render_output_document_junit("
            JUNIT_HEADER_FRAME: sview = "def render_output_junit_header_frame("
            JUNIT_RECORD_FRAME: sview = "def render_output_junit_record_frame("
            JUNIT_FOOTER_FRAME: sview = "def render_output_junit_footer_frame("
            JUNIT_MEASURE_HEADER: sview = "def measure_output_junit_header_frame("
            JUNIT_MEASURE_RECORD: sview = "def measure_output_junit_record_frame("
            JUNIT_MEASURE_FOOTER: sview = "def measure_output_junit_footer_frame("
            RENDERER_JSON_IMPORT: sview = "using EsOutputJson"
            RENDERER_HUMAN_IMPORT: sview = "using EsOutputHuman"
            MEASURE_JSON_RECORD: sview = "measure_output_json_record_frame"
            MEASURE_JUNIT_RECORD: sview = "measure_output_junit_record_frame"
            EXPECTED_DOCUMENT_BYTES: sview = "output_render_expected_document_bytes"
            MEASURE_RENDER_BYTES: sview = "def measure_output_render_document_bytes("
            FRAME_LIMIT_EXCEEDED: sview = "FrameLimitExceeded"
            TRANSPORT_PAYLOAD: sview = "struct OutputTransportPayload:"
            TRANSPORT_HUMAN_IMPORT: sview = "using EsOutputHuman"
            PEEK_TRANSPORT_PAYLOAD: sview = "def peek_output_transport_payload("
            ACK_TRANSPORT_PAYLOAD: sview = "def acknowledge_output_transport_payload("
            PAYLOAD_BYTES_EQUAL: sview = "output_transport_payload_bytes_equal"
            FRAME_PAYLOAD_MISMATCH: sview = "FramePayloadMismatch"
            IR_JSON_MODEL: sview = "include \"../runtime/output_json_model.elisa\""
            IR_HUMAN_MODEL: sview = "include \"../runtime/output_human_model.elisa\""
            IR_JUNIT_MODEL: sview = "include \"../runtime/output_junit_model.elisa\""
            EXECUTION_HUMAN_MODEL: sview = "include \"../runtime/output_human_model.elisa\""
            EXECUTION_JSON_MODEL: sview = "include \"../runtime/output_json_model.elisa\""
            EXECUTION_JUNIT_MODEL: sview = "include \"../runtime/output_junit_model.elisa\""
            DOCUMENT_CONTRACT: sview = "typed_output_document_contract_is_stable_and_bounded"
            HUMAN_CONTRACT: sview = "typed_output_human_frames_are_exact_bounded_and_color_aware"
            INVALID_TEXT: sview = "invalid_text"
            JSON_CONTRACT: sview = "typed_output_json_frames_match_schema_and_bounded_document_serialization"
            JUNIT_CONTRACT: sview = "typed_output_junit_frames_match_bounded_document_serialization"
            ALTERED_PAYLOAD_REJECTED: sview = "altered_payload_rejected"
            TRANSPORT_LIMIT_REJECTED: sview = "transport_limit_rejected"
            TRANSPORT_FRAME_LIMIT_REJECTED: sview = "transport_frame_limit_rejected"
            TRANSPORT_CHUNK_LIMIT_REJECTED: sview = "transport_chunk_limit_rejected"
            RENDER_BUDGET_REJECTED: sview = "render_budget_rejected"
            FIXTURE_JSON_FORMAT: sview = "OutputFormat.Json"
            FIXTURE_FAIL_STATUS: sview = "OutputStatus.Fail"
            SEAL_EVENT: sview = "OutputDocumentEvent.Seal"
            FIXTURE_OUTPUT_LIMIT_INVALID: sview = "OutputContractError.OutputLimitInvalid"
            FIXTURE_TEXT_ACCOUNTING: sview = "OutputContractError.TextAccountingInvalid"
            EXTRA_BEGIN_PAYLOAD_REJECTED: sview = "extraneous_begin_payload_rejected"
            TEXT_ACCOUNTING_REJECTED: sview = "text_accounting_rejected"
            DOCS_OUTPUT: sview = "`EsOutput` gives launcher, test, and differential renderers"
            DOCS_HUMAN: sview = "`EsOutputHuman`"
            DOCS_JSON: sview = "`EsOutputJson`"
            DOCS_JUNIT: sview = "`EsOutputJunit`"


        const module Messages:
            MISSING_ROOT: sview = "output model audit: missing repository root"
            UNRESOLVED_ROOT: sview = "output model audit: unable to resolve repository root"
            MISSING_INPUT: sview = "output model audit: missing "
            READ_FAILED: sview = "output model audit: unable to read source: "
            SUCCESS: sview = "output model audit: bounded Human/JSON/JUnit serializers, frames, and sealed document accounting are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMITS},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORDS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_BYTES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_BYTES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::FORMAT},
                SearchCheck{input: inputs[0], pattern: Patterns::STATUS},
                SearchCheck{input: inputs[0], pattern: Patterns::DOCUMENT_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::OPTIONS},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD},
                SearchCheck{input: inputs[0], pattern: Patterns::DOCUMENT},
                SearchCheck{input: inputs[0], pattern: Patterns::CONTRACT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_OPTIONS},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_DOCUMENT},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE_DOCUMENT},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_ACCOUNTING_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTED_TEXT},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILED_RECORD_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::RECORD_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_COLOR_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_LIMIT_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::APPEND_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::SEAL_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::FLAKY_STATUS},
                SearchCheck{input: inputs[0], pattern: Patterns::EMPTY_PAYLOAD},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILED_RECORDS},
                SearchCheck{input: inputs[6], pattern: Patterns::IR_OUTPUT_MODEL},
                SearchCheck{input: inputs[1], pattern: Patterns::HUMAN_MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::HUMAN_RENDER_DOCUMENT},
                SearchCheck{input: inputs[1], pattern: Patterns::HUMAN_HEADER_FRAME},
                SearchCheck{input: inputs[1], pattern: Patterns::HUMAN_RECORD_FRAME},
                SearchCheck{input: inputs[1], pattern: Patterns::HUMAN_FOOTER_FRAME},
                SearchCheck{input: inputs[1], pattern: Patterns::HUMAN_MEASURE_RECORD_FRAME},
                SearchCheck{input: inputs[1], pattern: Patterns::HUMAN_APPEND_FOOTER},
                SearchCheck{input: inputs[1], pattern: Patterns::HUMAN_APPEND_ESCAPED_TEXT},
                SearchCheck{input: inputs[1], pattern: Patterns::HUMAN_APPEND_HEX_BYTE},
                SearchCheck{input: inputs[1], pattern: Patterns::INVALID_COLOR_MODE},
                SearchCheck{input: inputs[1], pattern: Patterns::COUNT_ONLY},
                SearchCheck{input: inputs[2], pattern: Patterns::JSON_MODULE},
                SearchCheck{input: inputs[2], pattern: Patterns::JSON_APPEND_STRING},
                SearchCheck{input: inputs[2], pattern: Patterns::JSON_APPEND_FOOTER},
                SearchCheck{input: inputs[2], pattern: Patterns::JSON_RENDER_DOCUMENT},
                SearchCheck{input: inputs[2], pattern: Patterns::JSON_HEADER_FRAME},
                SearchCheck{input: inputs[2], pattern: Patterns::JSON_RECORD_FRAME},
                SearchCheck{input: inputs[2], pattern: Patterns::JSON_FOOTER_FRAME},
                SearchCheck{input: inputs[2], pattern: Patterns::JSON_MEASURE_HEADER},
                SearchCheck{input: inputs[2], pattern: Patterns::JSON_MEASURE_RECORD},
                SearchCheck{input: inputs[2], pattern: Patterns::JSON_MEASURE_FOOTER},
                SearchCheck{input: inputs[2], pattern: Patterns::SUMMARY},
                SearchCheck{input: inputs[2], pattern: Patterns::INVALID_UTF8},
                SearchCheck{input: inputs[2], pattern: Patterns::COUNT_ONLY},
                SearchCheck{input: inputs[3], pattern: Patterns::JUNIT_RENDER_DOCUMENT},
                SearchCheck{input: inputs[3], pattern: Patterns::JUNIT_HEADER_FRAME},
                SearchCheck{input: inputs[3], pattern: Patterns::JUNIT_RECORD_FRAME},
                SearchCheck{input: inputs[3], pattern: Patterns::JUNIT_FOOTER_FRAME},
                SearchCheck{input: inputs[3], pattern: Patterns::JUNIT_MEASURE_HEADER},
                SearchCheck{input: inputs[3], pattern: Patterns::JUNIT_MEASURE_RECORD},
                SearchCheck{input: inputs[3], pattern: Patterns::JUNIT_MEASURE_FOOTER},
                SearchCheck{input: inputs[3], pattern: Patterns::COUNT_ONLY},
                SearchCheck{input: inputs[4], pattern: Patterns::RENDERER_JSON_IMPORT},
                SearchCheck{input: inputs[4], pattern: Patterns::RENDERER_HUMAN_IMPORT},
                SearchCheck{input: inputs[4], pattern: Patterns::MEASURE_JSON_RECORD},
                SearchCheck{input: inputs[4], pattern: Patterns::MEASURE_JUNIT_RECORD},
                SearchCheck{input: inputs[4], pattern: Patterns::EXPECTED_DOCUMENT_BYTES},
                SearchCheck{input: inputs[4], pattern: Patterns::MEASURE_RENDER_BYTES},
                SearchCheck{input: inputs[4], pattern: Patterns::FRAME_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[5], pattern: Patterns::TRANSPORT_PAYLOAD},
                SearchCheck{input: inputs[5], pattern: Patterns::TRANSPORT_HUMAN_IMPORT},
                SearchCheck{input: inputs[5], pattern: Patterns::PEEK_TRANSPORT_PAYLOAD},
                SearchCheck{input: inputs[5], pattern: Patterns::ACK_TRANSPORT_PAYLOAD},
                SearchCheck{input: inputs[5], pattern: Patterns::PAYLOAD_BYTES_EQUAL},
                SearchCheck{input: inputs[5], pattern: Patterns::FRAME_PAYLOAD_MISMATCH},
                SearchCheck{input: inputs[6], pattern: Patterns::IR_JSON_MODEL},
                SearchCheck{input: inputs[6], pattern: Patterns::IR_HUMAN_MODEL},
                SearchCheck{input: inputs[6], pattern: Patterns::IR_JUNIT_MODEL},
                SearchCheck{input: inputs[7], pattern: Patterns::EXECUTION_HUMAN_MODEL},
                SearchCheck{input: inputs[7], pattern: Patterns::EXECUTION_JSON_MODEL},
                SearchCheck{input: inputs[7], pattern: Patterns::EXECUTION_JUNIT_MODEL},
                SearchCheck{input: inputs[8], pattern: Patterns::DOCUMENT_CONTRACT},
                SearchCheck{input: inputs[8], pattern: Patterns::HUMAN_CONTRACT},
                SearchCheck{input: inputs[8], pattern: Patterns::INVALID_TEXT},
                SearchCheck{input: inputs[8], pattern: Patterns::JSON_CONTRACT},
                SearchCheck{input: inputs[8], pattern: Patterns::JUNIT_CONTRACT},
                SearchCheck{input: inputs[8], pattern: Patterns::ALTERED_PAYLOAD_REJECTED},
                SearchCheck{input: inputs[8], pattern: Patterns::TRANSPORT_LIMIT_REJECTED},
                SearchCheck{input: inputs[8], pattern: Patterns::TRANSPORT_FRAME_LIMIT_REJECTED},
                SearchCheck{input: inputs[8], pattern: Patterns::TRANSPORT_CHUNK_LIMIT_REJECTED},
                SearchCheck{input: inputs[8], pattern: Patterns::RENDER_BUDGET_REJECTED},
                SearchCheck{input: inputs[8], pattern: Patterns::FIXTURE_JSON_FORMAT},
                SearchCheck{input: inputs[8], pattern: Patterns::FIXTURE_FAIL_STATUS},
                SearchCheck{input: inputs[8], pattern: Patterns::SEAL_EVENT},
                SearchCheck{input: inputs[8], pattern: Patterns::FIXTURE_OUTPUT_LIMIT_INVALID},
                SearchCheck{input: inputs[8], pattern: Patterns::FIXTURE_TEXT_ACCOUNTING},
                SearchCheck{input: inputs[8], pattern: Patterns::EXTRA_BEGIN_PAYLOAD_REJECTED},
                SearchCheck{input: inputs[8], pattern: Patterns::TEXT_ACCOUNTING_REJECTED},
                SearchCheck{input: inputs[9], pattern: Patterns::DOCS_OUTPUT},
                SearchCheck{input: inputs[9], pattern: Patterns::DOCS_HUMAN},
                SearchCheck{input: inputs[9], pattern: Patterns::DOCS_JSON},
                SearchCheck{input: inputs[9], pattern: Patterns::DOCS_JUNIT}
            ]


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::HUMAN_MODEL),
                root.joinpath(Inputs::JSON_MODEL),
                root.joinpath(Inputs::JUNIT_MODEL),
                root.joinpath(Inputs::RENDERER),
                root.joinpath(Inputs::TRANSPORT),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::EXECUTION),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsOutputModelAudit::run_default()
