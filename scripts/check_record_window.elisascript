# Bounded Elisascript port of check_record_window.sh.
# Regex source checks stream through the shared scanner without rg/awk.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsRecordWindowAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/record_window_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsRecordWindow:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/record_window_model\.elisa\""
            STATE: Regex = regex"const enum RecordWindowState of u8"
            EVENT: Regex = regex"const enum RecordWindowEvent of u8"
            POLICY: Regex = regex"struct RecordWindowPolicy:"
            SESSION: Regex = regex"struct RecordWindowSession:"
            ERROR: Regex = regex"error RecordWindowError:"
            VALIDATE: Regex = regex"def validate_record_window\("
            COUNT: Regex = regex"def record_window_count\("
            SUM: Regex = regex"def record_window_sum\("
            ADVANCE: Regex = regex"def advance_record_window\("
            WIDTH_LIMIT: Regex = regex"Limits::WIDTH"
            EVENT_LIMIT: Regex = regex"Limits::EVENTS"
            SUM_LIMIT: Regex = regex"Limits::SUM"
            ACTIVE_START: Regex = regex"active_start"
            SUM_VALID: Regex = regex"record_window_sum_valid"
            VALUES_ITERATION: Regex = regex"for value in session.values"
            PLANNED_STATE: Regex = regex"session.state == RecordWindowState.Planned"
            EMPTY_VALUES: Regex = regex"session.values.count == 0"
            FULL_WINDOW_AT_END: Regex = regex"session.values.count != 0 and session.active_start == session.values.count"
            EVENT_LIMIT_EXCEEDED: Regex = regex"RecordWindowError.EventLimitExceeded"
            WIDTH_EXCEEDED: Regex = regex"RecordWindowError.WidthExceeded"
            SUM_LIMIT_EXCEEDED: Regex = regex"RecordWindowError.SumLimitExceeded"
            NEXT_SUM: Regex = regex"next_sum"
            EVICTING: Regex = regex"evicting"
            PUSH_EVENT: Regex = regex"RecordWindowEvent.Push"
            SEALED_STATE: Regex = regex"RecordWindowState.Sealed"
            FIXTURE_IMPORT: Regex = regex"using EsRecordWindow"
            FIXTURE_CONTRACT: Regex = regex"typed_record_window_contract_evicts_oldest_with_bounded_sum"
            FIXTURE_PUSH: Regex = regex"RecordWindowEvent.Push"
            FIXTURE_COUNT: Regex = regex"record_window_count"
            FIXTURE_SUM: Regex = regex"record_window_sum"
            FIXTURE_SUM_LIMIT: Regex = regex"RecordWindowError.SumLimitExceeded"
            DOCS_SESSION: Regex = regex"EsRecordWindow::RecordWindowSession"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-031"


        const module Messages:
            MISSING_ROOT: sview = "record window audit: missing repository root"
            UNRESOLVED_ROOT: sview = "record window audit: unable to resolve repository root"
            MISSING_INPUT: sview = "record window audit: missing "
            READ_FAILED: sview = "record window audit: unable to read source: "
            SUCCESS: sview = "record window audit: bounded eviction, event history, and sum accounting are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::SUM},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::WIDTH_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::SUM_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::ACTIVE_START},
                SearchCheck{input: inputs[0], pattern: Patterns::SUM_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::VALUES_ITERATION},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EMPTY_VALUES},
                SearchCheck{input: inputs[0], pattern: Patterns::FULL_WINDOW_AT_END},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::WIDTH_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::SUM_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::NEXT_SUM},
                SearchCheck{input: inputs[0], pattern: Patterns::EVICTING},
                SearchCheck{input: inputs[0], pattern: Patterns::PUSH_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::SEALED_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_PUSH},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_COUNT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_SUM},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_SUM_LIMIT},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsRecordWindowAudit::run_default()
