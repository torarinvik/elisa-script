# Bounded Elisascript port of check_process_pipeline.sh.
# Fixed-string and one regex check use the shared bounded line scanner.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsProcessPipelineAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/process_model.elisa"
            INTERPRETER: sview = "src/ir/interpret.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            EVALUATE_CAPTURE_PIPELINE: sview = "def evaluate_capture_process_pipeline\\("
            INTERPRETER_STAGE_LOOP: sview = "for offset in 0..<executables.array_count.usize()"
            EVALUATE_CAPTURE_STAGE: sview = "evaluate_capture_process_result(machine, storage, executable, stage_arguments, current_input"
            STAGE_STDOUT: sview = "current_input <- runtime_text(final_capture.process_stdout)"
            DOCS_STAGED_STDOUT: sview = "each stage's captured stdout is staged as the next stage's"
            LEDGER_SEQUENTIAL: sview = "The transport remains sequential and buffered"
            MAX_STAGES: sview = "PROCESS_PIPELINE_MAX_STAGES"
            MAX_BUFFER_BYTES: sview = "PROCESS_PIPELINE_MAX_BUFFER_BYTES"
            FAILURE_MODE: sview = "const enum ProcessPipelineFailureMode of u8:"
            STATUS_POLICY: sview = "const enum ProcessPipelineStatusPolicy of u8:"
            STATE: sview = "const enum ProcessPipelineState of u8:"
            STAGE_STATE: sview = "const enum ProcessPipelineStageState of u8:"
            STREAM: sview = "const enum ProcessPipelineStream of u8:"
            EVENT: sview = "const enum ProcessPipelineEvent of u8:"
            STAGE_RESULT: sview = "struct ProcessPipelineStageResult:"
            PIPELINE: sview = "struct ProcessPipeline:"
            ERROR: sview = "error ProcessPipelineError:"
            VALIDATE: sview = "def validate_process_pipeline("
            ADVANCE: sview = "def advance_process_pipeline("
            STATE_VALID: sview = "process_pipeline_state_valid"
            EVENT_VALID: sview = "process_pipeline_event_valid"
            STREAM_VALID: sview = "process_pipeline_stream_valid"
            STAGE_RESULT_VALID: sview = "process_pipeline_stage_result_valid"
            SPAWN_FAILURE_RESULT: sview = "not was_pending and result.result.kind == ProcessResultKind.SpawnFailure"
            STAGE_OUTPUT_EVENT: sview = "ProcessPipelineEvent.StageOutput"
            RESULT_COUNT: sview = "pipeline.stage_results.count != pipeline.stages.count"
            STREAM_BYTES: sview = "pipeline.stream_bytes"
            INVALID_RECEIPT: sview = "ProcessPipelineError.InvalidReceipt"
            PIPELINE_NOT_DRAINED: sview = "ProcessPipelineError.PipelineNotDrained"
            OUTPUT_LIMIT: sview = "ProcessPipelineError.OutputLimitExceeded"
            CHANNEL_ACCOUNTING: sview = "ProcessPipelineError.ChannelAccountingInvalid"
            STAGE_EVENT_GROUP: sview = "ProcessPipelineEvent.StageOutput, ProcessPipelineEvent.StageExit, ProcessPipelineEvent.StageFailure, ProcessPipelineEvent.StageCancel"
            PENDING_STAGE: sview = "ProcessPipelineStageState.Pending"
            STAGE_STATE_COUNT: sview = "pipeline.stage_states.count != pipeline.stages.count"
            FAILURE_MODE_VALID: sview = "process_pipeline_failure_mode_valid"
            LAST_STAGE: sview = "            LastStage"
            PIPEFAIL: sview = "            Pipefail"
            INVALID_STAGE_COMMAND: sview = "InvalidStageCommand"
            INVALID_STAGE_INDEX: sview = "InvalidStageIndex"
            INVALID_STAGE_STATE: sview = "InvalidStageState"
            AGGREGATE_FAILURE: sview = "ProcessPipelineFailureMode.Aggregate"
            STAGE_START: sview = "ProcessPipelineEvent.StageStart"
            STAGE_FAILURE: sview = "ProcessPipelineEvent.StageFailure"
            STAGE_CANCEL: sview = "ProcessPipelineEvent.StageCancel"
            STDOUT_STREAM: sview = "ProcessPipelineStream.Stdout"
            STDIN_STREAM: sview = "ProcessPipelineStream.Stdin"
            CANCELLING_STATE: sview = "ProcessPipelineState.Cancelling"
            COMPLETED_DERIVED: sview = "pipeline.completed_stages != derived_completed"
            FAILED_DERIVED: sview = "pipeline.failed_stages != derived_failed"
            CANCELLED_DERIVED: sview = "pipeline.cancelled_stages != derived_cancelled"
            FAIL_FAST_FAILURE: sview = "pipeline.failure_mode == ProcessPipelineFailureMode.FailFast and pipeline.failed_stages != 0"
            CANCELLED_STAGES: sview = "pipeline.cancelled_stages != 0"
            PLANNED_NON_START: sview = "pipeline.state == ProcessPipelineState.Planned and event != ProcessPipelineEvent.Start and event != ProcessPipelineEvent.Cancel"
            COMPLETED_STAGE_COUNT: sview = "pipeline.completed_stages != pipeline.stages.count"
            CANCELLATION_REQUESTED: sview = "pipeline.cancellation_requested"
            CANCEL_ACK: sview = "ProcessPipelineEvent.CancelAck"
            FIXTURE_CONTRACT: sview = "typed_process_pipeline_contract_models_concurrent_cancellation"
            FIXTURE_AGGREGATE: sview = "ProcessPipelineFailureMode.Aggregate"
            FIXTURE_STAGE_START: sview = "ProcessPipelineEvent.StageStart"
            FIXTURE_STAGE_OUTPUT: sview = "ProcessPipelineEvent.StageOutput"
            FIXTURE_STAGE_EXIT: sview = "ProcessPipelineEvent.StageExit"
            FIXTURE_STAGE_FAILURE: sview = "ProcessPipelineEvent.StageFailure"
            FIXTURE_STAGE_CANCEL: sview = "ProcessPipelineEvent.StageCancel"
            FIXTURE_STDOUT: sview = "ProcessPipelineStream.Stdout"
            FIXTURE_STDIN: sview = "ProcessPipelineStream.Stdin"
            FIXTURE_INVALID_STAGE_STATE: sview = "ProcessPipelineError.InvalidStageState"
            FIXTURE_INVALID_RECEIPT: sview = "ProcessPipelineError.InvalidReceipt"
            FIXTURE_NOT_DRAINED: sview = "ProcessPipelineError.PipelineNotDrained"
            FIXTURE_OUTPUT_LIMIT: sview = "ProcessPipelineError.OutputLimitExceeded"
            LAUNCH_FAILURE: sview = "launch_failure_receipt"
            FIXTURE_CANCEL_ACK: sview = "ProcessPipelineEvent.CancelAck"
            FIXTURE_INVALID_STAGE_COMMAND: sview = "ProcessPipelineError.InvalidStageCommand"
            DOCS_PIPELINE: sview = "`ProcessPipeline`"
            LEDGER_PIPELINE: sview = "`ProcessPipeline`"


        const module Messages:
            MISSING_ROOT: sview = "process pipeline audit: missing repository root"
            UNRESOLVED_ROOT: sview = "process pipeline audit: unable to resolve repository root"
            MISSING_INPUT: sview = "process pipeline audit: missing "
            READ_FAILED: sview = "process pipeline audit: unable to read source: "
            SUCCESS: sview = "process pipeline audit: typed stage model and sequential buffered adapter are present; live POSIX pipes, backpressure, SIGPIPE, and host reaping remain open"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        const enum SearchMode of u8:
            Literal
            Regex


        struct SearchCheck:
            input: Path
            pattern: sview
            mode: SearchMode = SearchMode.Literal


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def literal_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return ExitStatus::IO_FAILURE


        def regex_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(check.pattern)
            catch EsSourceFunctionScope::contains_file_regex_line(check.input, pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return ExitStatus::IO_FAILURE


        def search_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            match check.mode:
                SearchMode.Literal:
                    return literal_status(check)
                SearchMode.Regex:
                    return regex_status(check)
                _:
                    return ExitStatus.FAILURE


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[1], pattern: Patterns::EVALUATE_CAPTURE_PIPELINE, mode: SearchMode.Regex},
                SearchCheck{input: inputs[1], pattern: Patterns::INTERPRETER_STAGE_LOOP},
                SearchCheck{input: inputs[1], pattern: Patterns::EVALUATE_CAPTURE_STAGE},
                SearchCheck{input: inputs[1], pattern: Patterns::STAGE_STDOUT},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_STAGED_STDOUT},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_SEQUENTIAL},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_STAGES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_BUFFER_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILURE_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::STATUS_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::STAGE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::STAGE_RESULT},
                SearchCheck{input: inputs[0], pattern: Patterns::PIPELINE},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::STAGE_RESULT_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::SPAWN_FAILURE_RESULT},
                SearchCheck{input: inputs[0], pattern: Patterns::STAGE_OUTPUT_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::RESULT_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::STREAM_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_RECEIPT},
                SearchCheck{input: inputs[0], pattern: Patterns::PIPELINE_NOT_DRAINED},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::CHANNEL_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::STAGE_EVENT_GROUP},
                SearchCheck{input: inputs[0], pattern: Patterns::PENDING_STAGE},
                SearchCheck{input: inputs[0], pattern: Patterns::STAGE_STATE_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILURE_MODE_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::LAST_STAGE},
                SearchCheck{input: inputs[0], pattern: Patterns::PIPEFAIL},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_STAGE_COMMAND},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_STAGE_INDEX},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_STAGE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::AGGREGATE_FAILURE},
                SearchCheck{input: inputs[0], pattern: Patterns::STAGE_START},
                SearchCheck{input: inputs[0], pattern: Patterns::STAGE_FAILURE},
                SearchCheck{input: inputs[0], pattern: Patterns::STAGE_CANCEL},
                SearchCheck{input: inputs[0], pattern: Patterns::STDOUT_STREAM},
                SearchCheck{input: inputs[0], pattern: Patterns::STDIN_STREAM},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLING_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETED_DERIVED},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILED_DERIVED},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLED_DERIVED},
                SearchCheck{input: inputs[0], pattern: Patterns::FAIL_FAST_FAILURE},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLED_STAGES},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_NON_START},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETED_STAGE_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLATION_REQUESTED},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_ACK},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_AGGREGATE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STAGE_START},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STAGE_OUTPUT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STAGE_EXIT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STAGE_FAILURE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STAGE_CANCEL},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STDOUT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STDIN},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_STAGE_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_RECEIPT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_NOT_DRAINED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_OUTPUT_LIMIT},
                SearchCheck{input: inputs[2], pattern: Patterns::LAUNCH_FAILURE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CANCEL_ACK},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_INVALID_STAGE_COMMAND},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_PIPELINE},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_PIPELINE}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                status: i64 = search_status(check)
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsProcessPipelineAudit::run_default()
