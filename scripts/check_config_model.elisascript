# Bounded Elisascript port of check_config_model.sh.
# Configuration-source precedence and parser boundaries are checked without
# invoking generators, launchers, shell tools, or compiler processes.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsConfigModelAudit:
    private:
        struct AuditInputs:
            model: Path
            json_model: Path
            environment_model: Path
            environment_runtime_model: Path
            cli_model: Path
            json_file_model: Path
            toml_model: Path
            toml_file_model: Path
            ir: Path
            ir_fixture: Path
            runtime_fixture: Path
            json_fixture: Path
            environment_fixture: Path
            cli_fixture: Path
            integration_fixture: Path
            json_file_fixture: Path
            json_file_data: Path
            toml_fixture: Path
            toml_file_fixture: Path
            toml_file_data: Path
            toml_cargo_data: Path
            toml_pyproject_data: Path
            toml_hugo_data: Path
            application_reference: Path
            application_candidate: Path
            application_golden: Path
            application_contract: Path
            application_parity: Path
            toml_manifest_reference: Path
            toml_manifest_candidate: Path
            toml_manifest_golden: Path
            toml_manifest_precedence_golden: Path
            toml_manifest_contract: Path
            toml_manifest_parity: Path
            docs: Path
            ledger: Path


        const module Messages:
            MISSING_ROOT: sview = "config audit: missing repository root"
            UNRESOLVED_ROOT: sview = "config audit: unable to resolve repository root"
            MISSING_INPUT: sview = "config audit: missing "
            READ_FAILED: sview = "config audit: unable to read source: "
            CONTRACT_MISSING: sview = "config audit: missing contract: "
            CASE_ORDER_MISMATCH: sview = "config audit: application CLI case ordering differs across reference, candidate, and golden"
            SUCCESS: sview = "config audit: bounded precedence, aggregate payload ceilings, and deterministic lookup are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def require_patterns(input: Path, patterns: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for pattern in patterns:
                found: bool = try EsSourceFunctionScope::contains_file_line(input, pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{input}")
                    return ExitStatus::IO_FAILURE
                if not found:
                    diagnostic(Messages::CONTRACT_MISSING + f"{pattern}")
                    return ExitStatus::FAILURE
            return 0i64


        def require_any_patterns(inputs: darray[Path], patterns: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for pattern in patterns:
                found_any: mutable bool = false
                for input in inputs:
                    found: bool = try EsSourceFunctionScope::contains_file_line(input, pattern) else err:
                        diagnostic(Messages::READ_FAILED + f"{input}")
                        return ExitStatus::IO_FAILURE
                    found_any <- true if found
                    break if found_any
                if not found_any:
                    diagnostic(Messages::CONTRACT_MISSING + f"{pattern}")
                    return ExitStatus::FAILURE
            return 0i64


        def require_definitions(input: Path, names: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for name in names:
                declaration: sview = "def " + name + "("
                found: bool = try EsSourceFunctionScope::contains_file_line(input, declaration) else err:
                    diagnostic(Messages::READ_FAILED + f"{input}")
                    return ExitStatus::IO_FAILURE
                if not found:
                    diagnostic(Messages::CONTRACT_MISSING + f"{declaration}")
                    return ExitStatus::FAILURE
            return 0i64


        def require_ordered_labels(input: Path, prefix: sview, labels: darray[sview]) -> bool error[EsSourceFunctionScope::Error] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            pattern_text: mutable sview = prefix
            for label in labels:
                pattern_text <- pattern_text + "[\\s\\S]*?" + label
            pattern: Regex = regex(pattern_text)
            return try EsSourceFunctionScope::contains_file_regex_text(input, pattern)


        def application_case_order_matches(inputs: AuditInputs) -> bool error[EsSourceFunctionScope::Error] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            labels: darray[sview] = [
                "attached-and-passthrough", "separated-short-value", "equals-short-value", "short-option-bundle",
                "negative-boolean", "root-help", "command-help", "empty-value-over-default", "build-defaults",
                "test-defaults", "missing-command", "unknown-command", "unknown-option", "missing-value",
                "duplicate-option", "duplicate-short-bundle", "unexpected-boolean-value"
            ]
            reference_ordered: bool = try require_ordered_labels(inputs.application_reference, "CASES = \\[", labels) else err:
                raise err
            candidate_ordered: bool = try require_ordered_labels(inputs.application_candidate, "def fixture_cases\\(\\)", labels) else err:
                raise err
            golden_ordered: bool = try require_ordered_labels(inputs.application_golden, "case=", labels) else err:
                raise err
            return reference_ordered and candidate_ordered and golden_ordered


        def audit_inputs(inputs: AuditInputs) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = require_patterns(inputs.toml_model, [
                "module EsConfigToml:", "CONFIG_TOML_MAX_BYTES", "CONFIG_TOML_MAX_TOTAL_ARRAY_ITEMS",
                "CONFIG_TOML_MAX_TOTAL_TABLE_FIELDS", "CONFIG_TOML_MAX_ARRAY_TABLE_ROWS", "CONFIG_TOML_MAX_TOTAL_VALUE_NODES",
                "CONFIG_TOML_MAX_VALUE_DEPTH", "struct ConfigTomlNode:", "struct ConfigTomlNodeChild:",
                "def config_toml_line_endings_valid(", "ConfigTomlError.InvalidLineEnding", "def config_toml_parse_value_graph(",
                "def config_toml_value_graph_valid(", "def parse_toml_config_layer(", "def resolve_toml_config_typed_layers(",
                "def lookup_resolved_toml_config_value(", "config_toml_bind_typed_winner(", "InvalidValueGraph",
                "struct ConfigTomlArrayTableInstance:", "config_toml_append_array_table_ordinal(", "config_toml_dotted_descendant(",
                "struct ConfigTomlTableField:", "config_toml_array_value_end(", "config_toml_skip_array_trivia(",
                "config_toml_parse_inline_table(", "def bind_toml_config_winner(", "def resolve_toml_config_layers(",
                "DuplicateKey", "def config_toml_parse_array(", "def parse_toml_config(", "UnsupportedEscape",
                "validate_config_layers([result.layer])"
            ])
            return status if status != 0i64

            status <- require_patterns(inputs.toml_fixture, ["dependencies = [", "build backend", "dependency = { version = "])
            return status if status != 0i64
            status <- require_patterns(inputs.toml_pyproject_data, [
                "requires-python = \">=3.11\"", "[tool.setuptools.packages.find]", "markers = ["
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.toml_hugo_data, [
                "[[params.links.user]]", "Source SHA-256: bb5b172a0c7aedb991b20efa65f76ae83341e6413585f54ef28fb23065da6fb1",
                "yes = 'Glad to hear it! Please"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.docs, ["across physical lines"])
            return status if status != 0i64
            status <- require_patterns(inputs.ledger, ["across physical lines"])
            return status if status != 0i64

            status <- require_patterns(inputs.toml_file_model, [
                "module EsConfigTomlFilePosix:", "def read_config_toml_file(",
                "EsBoundedText::read_utf8(input_path, maximum_bytes)", "parse_toml_config(source)"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.json_file_model, [
                "module EsConfigJsonFilePosix:", "struct ConfigJsonFileLayer:", "def read_config_json_file(",
                "JSON_CONFIG_FILE_MAX_BYTES", "DataDecodeLimits{input_bytes: JSON_CONFIG_FILE_MAX_BYTES}",
                "config_json_file_limits_valid(limits)", "ConfigJsonFileError.JsonPolicyInvalid",
                "EsBoundedText::read_utf8(input_path, limits.input_bytes)", "flat_json_config_layer(document)"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.environment_model, [
                "module EsConfigEnvironment:", "def environment_config_layer(", "EnvironmentState.Sealed",
                "EsConfig::Limits::ENTRIES_PER_LAYER", "if entry.present:"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.json_model, [
                "module EsConfigJson:", "def flat_json_config_layer(", "JsonDuplicateKeyPolicy.Reject",
                "EsConfig::Limits::ENTRIES_PER_LAYER", "JsonNodeKind.Number", "ConfigJsonError.StructuredValueUnsupported"
            ])
            return status if status != 0i64

            status <- require_patterns(inputs.cli_model, [
                "module EsConfigCli:", "def parse_config_cli(", "ConfigSource.CommandLine", "ConfigCliError.UnknownOption",
                "ConfigCliError.MissingValue", "ConfigCliError.DuplicateOption", "ConfigCliError.EmbeddedNul", "options_enabled",
                "def parse_config_cli_command(", "def config_cli_root_help(", "def config_cli_command_help(",
                "def config_cli_match_short(", "value_start: mutable usize = short_offset + 1", "short_offset <- short_offset + 1"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.environment_runtime_model, ["PROCESS_COMMAND_MAX_ENVIRONMENT_ENTRIES"])
            return status if status != 0i64

            status <- require_patterns(inputs.model, [
                "module EsConfig:", "const module Limits:", "const enum ConfigSource of u8:", "struct ConfigEntry:",
                "struct ConfigLayer:", "struct ConfigValue:", "struct ConfigLookup:", "error ConfigError:",
                "def validate_config_layers(", "def resolve_config_layers(", "def lookup_config_value(", "def config_entry_fits(",
                "ConfigSource.Defaults", "ConfigSource.File", "ConfigSource.Environment", "ConfigSource.CommandLine",
                "config_source_priority", "Limits::LAYER_BYTES", "Limits::OUTPUT_BYTES", "ConfigError.DuplicateLayer",
                "ConfigError.DuplicateKey", "ConfigError.InvalidKey", "ConfigError.InvalidValue", "ConfigError.LayerBytesExceeded",
                "ConfigError.OutputBytesExceeded", "ConfigError.OutputLimitExceeded", "config_values_valid",
                "return not sview_contains_byte(value, 0)"
            ])
            return status if status != 0i64

            status <- require_patterns(inputs.ir, [
                "include \"../runtime/config_model.elisa\"", "include \"../runtime/config_json_model.elisa\"",
                "include \"../runtime/config_toml_model.elisa\"", "include \"../runtime/config_environment_model.elisa\"",
                "include \"../runtime/config_cli_model.elisa\"", "include \"../runtime/config_json_file_posix.elisa\"",
                "include \"../runtime/config_toml_file_posix.elisa\""
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.ir_fixture, [
                "using EsConfig", "typed_config_precedence_is_explicit_and_deterministic", "ConfigSource.CommandLine",
                "ConfigError.DuplicateLayer", "ConfigError.DuplicateKey", "ConfigError.InvalidKey", "ConfigError.InvalidValue"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.runtime_fixture, ["config_values_preserve_line_breaks_and_reject_only_nul"])
            return status if status != 0i64
            status <- require_patterns(inputs.json_fixture, [
                "flat_json_configuration_preserves_scalar_contracts",
                "flat_json_configuration_rejects_structures_and_duplicate_tolerant_policy"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.environment_fixture, [
                "environment_config_layer_keeps_present_values_and_omits_tombstones",
                "environment_config_layer_requires_sealed_snapshot", "environment_snapshot_uses_the_environment_entry_limit"
            ])
            return status if status != 0i64

            status <- require_patterns(inputs.cli_fixture, [
                "declared_config_cli_options_preserve_empty_and_passthrough_values",
                "declared_config_cli_options_reject_unknown_missing_and_duplicate_values",
                "declared_config_cli_short_options_and_help_are_deterministic", "parse_config_cli([\"-vj8\"], options)",
                "duplicate_bundle_rejected", "declared_config_cli_subcommands_select_schema_and_render_root_help",
                "ConfigCliError.EmbeddedNul"
            ])
            return status if status != 0i64

            status <- require_patterns(inputs.application_parity, [
                "application_cli_public_launcher_matches_independent_python_and_goldens",
                "arguments: [f\"{candidate_path}\", \"--parity-batch\"]", "ELISASCRIPT_BOUNDED_TEST_RSS_GUARD",
                "return false if candidate_run.exit_status != 0 or candidate_run.stdout != golden"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.application_reference, ["\"--parity-batch\""])
            return status if status != 0i64
            status <- require_patterns(inputs.application_candidate, ["\"--parity-batch\""])
            return status if status != 0i64
            status <- require_patterns(inputs.application_candidate, ["resolve_config_layers([defaults, parsed.parsed.layer])"])
            return status if status != 0i64
            status <- require_patterns(inputs.application_contract, ["A05"])
            return status if status != 0i64
            status <- require_patterns(inputs.application_golden, [
                "case=attached-and-passthrough", "case=separated-short-value", "case=equals-short-value",
                "case=short-option-bundle", "case=negative-boolean", "case=root-help", "case=command-help",
                "case=empty-value-over-default", "case=build-defaults", "case=test-defaults", "case=missing-command",
                "case=unknown-command", "case=unknown-option", "case=missing-value", "case=duplicate-option",
                "case=duplicate-short-bundle", "case=unexpected-boolean-value"
            ])
            return status if status != 0i64
            orders_match: bool = try application_case_order_matches(inputs) else err:
                diagnostic(Messages::READ_FAILED + "application CLI case inventory")
                return ExitStatus::IO_FAILURE
            if not orders_match:
                diagnostic(Messages::CASE_ORDER_MISMATCH)
                return ExitStatus::FAILURE

            status <- require_patterns(inputs.toml_manifest_parity, [
                "toml_manifest_public_launcher_matches_independent_python_and_goldens", "ELISASCRIPT_BOUNDED_TEST_RSS_GUARD",
                "candidate_arguments: mutable darray[sview] = [f\"{candidate_path}\", mode]",
                "candidate_arguments.push(f\"{hugo_fixture_path}\")",
                "parity_case_matches(launcher, precedence_golden, \"--precedence-batch\")"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.toml_manifest_candidate, [
                "read_config_toml_file(path(path_text))", "lookup_toml_config_value(parsed, \"workspace.dependencies.wasmtime\")",
                "render_pyproject", "tool.pytest.ini_options.markers", "hugo.params.links.user.0.name",
                "\"--precedence-batch\"", "resolve_toml_config_typed_layers([defaults, file, environment, command_line])",
                "resolved_inline_field_index(resolution.values[settings_index], \"retries\")"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.toml_manifest_reference, [
                "tomllib.load(source)", "project[\"tool\"][\"pytest\"][\"ini_options\"]", "\"--precedence-batch\"",
                "tomllib.loads(document)"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.toml_manifest_contract, ["A06/C07"])
            return status if status != 0i64
            status <- require_patterns(inputs.toml_manifest_golden, [
                "workspace.dependencies.wasmtime.feature=component-model", "workspace.dependencies.sha2_11.package=sha2",
                "pyproject.tool.setuptools.packages.find.where=src",
                "pyproject.tool.pytest.marker=campaign: long-running archived research audit; excluded from the fast suite",
                "hugo.params.links.user.0.name=User mailing list", "hugo.params.ui.feedback.yes=Glad to hear it!",
                "hugo.disableKinds=taxonomyTerm", "hugo.markup.goldmark.renderer.unsafe=true", "workspace.member=crates/wb-manifest",
                "workspace.member=crates/wb-cli"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.toml_manifest_precedence_golden, [
                "precedence.features=command-line@command-line", "precedence.settings.mode=ci@environment"
            ])
            return status if status != 0i64

            status <- require_patterns(inputs.integration_fixture, [
                "config_precedence_composes_all_four_explicit_sources", "config_precedence_accepts_toml_table_file_values"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.json_file_fixture, [
                "bounded_json_configuration_file_retains_layer_document_storage",
                "bounded_json_configuration_file_rejects_over_limit_before_reading"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.toml_fixture, [
                "toml_configuration_parses_bounded_scalar_array_and_inline_table_subset",
                "resolve_toml_config_layers(project_arrays, [overrides])", "0xDEAD_BEEF", "+1_000",
                "ConfigTomlValueKind.Array", "ConfigTomlValueKind.InlineTable", "ConfigTomlTableField",
                "duplicate_inline_key_rejected", "dotted_inline_key_rejected",
                "array_table_rows_preserve_header_order_and_instance_indices", "nested_values: ConfigTomlLayer",
                "nested_array_root.child_count == 2", "validate_toml_value_graph(nested_array.values[nested_array_index].nodes",
                "validate_toml_value_graph(nested_values.values[dependency_index].nodes",
                "toml_typed_layers_replace_whole_values_by_source_precedence", "array_table_environment",
                "second_row_name >= array_table_resolution.values.count", "lookup_resolved_toml_config_value",
                "resolve_toml_config_typed_layers([defaults, file, environment, command_line])",
                "ConfigTomlError.ConflictingStructure", "deep_graph_nodes", "parsed.array_tables.count == 3",
                "empty_rows.array_tables.count == 2", "ConfigTomlValueKind.Integer", "mixed_array",
                "toml_configuration_rejects_unsupported_values_and_escapes", "quoted_keys: ConfigTomlLayer",
                "escaped_quoted_keys: ConfigTomlLayer", "unsupported_key_escape", "dotted_quoted_key_rejected",
                "unicode_escapes: ConfigTomlLayer", "unicode_surrogate_rejected", "unicode_out_of_range_rejected",
                "unicode_bad_hex_rejected", "toml_configuration_accepts_crlf_and_rejects_bare_carriage_returns", "123.name"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.toml_model, [
                "ConfigTomlError.UnsupportedValue", "node_depths[node_index] >= CONFIG_TOML_MAX_VALUE_DEPTH - 1",
                "def config_toml_parse_unicode_escape(", "codepoint > 1114111"
            ])
            return status if status != 0i64

            status <- require_patterns(inputs.toml_file_fixture, [
                "bounded_toml_configuration_file_returns_owned_layer", "ConfigTomlValueKind.Array", "setuptools>=68",
                "bounded_toml_configuration_file_rejects_invalid_budget_before_reading",
                "cargo_workspace_manifest_preserves_nested_typed_values", "workspace.dependencies.wasmtime"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.toml_cargo_data, [
                "crates/wb-manifest", "sha2_11 = { package = \"sha2\", version = \"0.11\" }",
                "d69c6241c9f1768b45caa2965eb2c125af2826d97fd06ed3cd766691dbc2c1c1"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.toml_file_data, ["mode = \"release\"", "dependencies = ["])
            return status if status != 0i64
            status <- require_patterns(inputs.json_file_data, ["\"name\":\"ElisaScript\",\"count\":23,\"enabled\":true"])
            return status if status != 0i64

            status <- require_patterns(inputs.docs, ["`EsConfig` is the pure configuration precedence boundary"])
            return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            fixtures: Path = root.joinpath("test/fixtures/script_parity")
            inputs: AuditInputs = AuditInputs{
                model: root.joinpath("src/runtime/config_model.elisa"),
                json_model: root.joinpath("src/runtime/config_json_model.elisa"),
                environment_model: root.joinpath("src/runtime/config_environment_model.elisa"),
                environment_runtime_model: root.joinpath("src/runtime/environment_model.elisa"),
                cli_model: root.joinpath("src/runtime/config_cli_model.elisa"),
                json_file_model: root.joinpath("src/runtime/config_json_file_posix.elisa"),
                toml_model: root.joinpath("src/runtime/config_toml_model.elisa"),
                toml_file_model: root.joinpath("src/runtime/config_toml_file_posix.elisa"),
                ir: root.joinpath("src/ir/ir.elisa"),
                ir_fixture: root.joinpath("test/ir/elisascript_ir_test.elisa"),
                runtime_fixture: root.joinpath("test/runtime/config_model_test.elisa"),
                json_fixture: root.joinpath("test/runtime/config_json_model_test.elisa"),
                environment_fixture: root.joinpath("test/runtime/config_environment_model_test.elisa"),
                cli_fixture: root.joinpath("test/runtime/config_cli_model_test.elisa"),
                integration_fixture: root.joinpath("test/runtime/config_precedence_integration_test.elisa"),
                json_file_fixture: root.joinpath("test/runtime/config_json_file_posix_test.elisa"),
                json_file_data: root.joinpath("test/runtime/config_json_file_fixture.json"),
                toml_fixture: root.joinpath("test/runtime/config_toml_model_test.elisa"),
                toml_file_fixture: root.joinpath("test/runtime/config_toml_file_posix_test.elisa"),
                toml_file_data: root.joinpath("test/runtime/config_toml_file_fixture.toml"),
                toml_cargo_data: root.joinpath("test/runtime/config_toml_cargo_fixture.toml"),
                toml_pyproject_data: root.joinpath("test/runtime/config_toml_pyproject_fixture.toml"),
                toml_hugo_data: root.joinpath("test/runtime/config_toml_hugo_fixture.toml"),
                application_reference: root.joinpath("test/fixtures/script_parity/application_cli/reference.py"),
                application_candidate: root.joinpath("test/fixtures/script_parity/application_cli/candidate.elisascript"),
                application_golden: root.joinpath("test/fixtures/script_parity/application_cli/expected.txt"),
                application_contract: root.joinpath("test/fixtures/script_parity/application_cli/CONTRACT.md"),
                application_parity: root.joinpath("test/script_parity/application_cli_launcher_test.elisascript"),
                toml_manifest_reference: fixtures.joinpath("toml_manifest/reference.py"),
                toml_manifest_candidate: fixtures.joinpath("toml_manifest/candidate.elisascript"),
                toml_manifest_golden: fixtures.joinpath("toml_manifest/expected.txt"),
                toml_manifest_precedence_golden: fixtures.joinpath("toml_manifest/precedence_expected.txt"),
                toml_manifest_contract: fixtures.joinpath("toml_manifest/CONTRACT.md"),
                toml_manifest_parity: root.joinpath("test/script_parity/toml_manifest_launcher_test.elisascript"),
                docs: root.joinpath("docs/ir.md"),
                ledger: root.joinpath("docs/capabilities/ledger.md")
            }
            required_files: darray[Path] = [
                inputs.model, inputs.json_model, inputs.environment_model, inputs.environment_runtime_model, inputs.cli_model, inputs.json_file_model,
                inputs.toml_model, inputs.toml_file_model, inputs.ir, inputs.ir_fixture, inputs.runtime_fixture,
                inputs.json_fixture, inputs.environment_fixture, inputs.cli_fixture, inputs.integration_fixture,
                inputs.json_file_fixture, inputs.json_file_data, inputs.toml_fixture, inputs.toml_file_fixture,
                inputs.toml_file_data, inputs.toml_cargo_data, inputs.toml_pyproject_data, inputs.toml_hugo_data,
                inputs.application_reference, inputs.application_candidate, inputs.application_golden,
                inputs.application_contract, inputs.application_parity, inputs.toml_manifest_reference,
                inputs.toml_manifest_candidate, inputs.toml_manifest_golden, inputs.toml_manifest_precedence_golden,
                inputs.toml_manifest_contract, inputs.toml_manifest_parity, inputs.docs, inputs.ledger
            ]
            for required_file in required_files:
                if not is_file(required_file):
                    diagnostic(Messages::MISSING_INPUT + f"{required_file}")
                    return ExitStatus::FAILURE
            status: i64 = audit_inputs(inputs)
            return status if status != 0i64
            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::IO_FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsConfigModelAudit::run_default()
