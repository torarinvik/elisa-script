# Bounded Elisascript port of check_network_session.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsNetworkSessionAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/network_session_model.elisa"
            NETWORK_MODEL: sview = "src/runtime/network_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "module EsNetworkSession:"
            POLLS_LIMIT: sview = "Limits::POLLS"
            REDIRECTS_LIMIT: sview = "Limits::REDIRECTS"
            STATE: sview = "const enum NetworkSessionState of u8:"
            EVENT: sview = "const enum NetworkSessionEvent of u8:"
            SESSION: sview = "struct NetworkSession:"
            REDIRECT_URL: sview = "current_url_from_redirect"
            ERROR: sview = "error NetworkSessionError:"
            VALIDATE: sview = "def validate_network_session("
            EFFECTIVE_HEADERS: sview = "def network_session_effective_request_headers("
            ADVANCE: sview = "def advance_network_session("
            STATE_ACTIVE: sview = "session_state_active"
            SEND_ACCOUNTING: sview = "SendAccountingInvalid"
            RECEIVE_LIMIT: sview = "ReceiveLimitExceeded"
            POLL_LIMIT: sview = "PollLimitExceeded"
            REDIRECT_LIMIT: sview = "RedirectLimitExceeded"
            EFFECTIVE_REQUEST: sview = "network_request_effective_headers(session.request, session.current_method, session.current_body_bytes, session.current_url_from_redirect, session.strip_sensitive_headers)"
            REDIRECT_TRUE: sview = "session.current_url_from_redirect <- true"
            REDIRECT_FALSE: sview = "session.current_url_from_redirect <- false"
            REDIRECT_NOT_ALLOWED: sview = "RedirectNotAllowed"
            INVALID_REDIRECT_STATUS: sview = "InvalidRedirectStatus"
            RETRY_NOT_READY: sview = "RetryNotReady"
            CANCEL_NOT_READY: sview = "CancelNotReady"
            REQUIRES_ATTEMPT: sview = "session_state_requires_attempt"
            REQUIRES_ATTEMPT_COUNT: sview = "session_state_requires_attempt(session.state) and session.attempts == 0"
            OUTCOME_CANCELLED: sview = "outcome == NetworkOutcome.Cancelled"
            STATUS_FAILURE: sview = "StatusFailure"
            PLANNED_STATE: sview = "NetworkSessionState.Planned and"
            COMPLETED_STATE: sview = "NetworkSessionState.Completed and"
            SENT_BYTES: sview = "session.sent_bytes != session.request.body.count"
            FAILED_STATE: sview = "NetworkSessionState.Failed and"
            STATUS_FAILURE_OUTCOME: sview = "session.outcome == NetworkOutcome.StatusFailure"
            ACTIVE_STATE: sview = "session_state_active(session.state) and"
            CANCELLED_STATE: sview = "NetworkSessionState.Cancelled"
            IR_IMPORT: sview = "include \"../runtime/network_session_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsNetworkSession"
            FIXTURE_CONTRACT: sview = "typed_network_session_contract_accounts_send_receive_and_cancel"
            DNS_READY: sview = "NetworkSessionEvent.DnsReady"
            SEND_COMPLETE: sview = "NetworkSessionEvent.SendComplete"
            RECEIVE_CHUNK: sview = "NetworkSessionEvent.ReceiveChunk"
            RECEIVE_COMPLETE: sview = "NetworkSessionEvent.ReceiveComplete"
            REDIRECT: sview = "NetworkSessionEvent.Redirect"
            FIXTURE_EFFECTIVE_HEADERS: sview = "network_session_effective_request_headers"
            PARTIAL_BODY: sview = "partial_effective_body_rejected"
            ORIGINAL_POST_HEADERS: sview = "original_post_headers.count == 8"
            REWRITTEN_POST_HEADERS: sview = "rewritten_post_headers.count == 4"
            REWRITTEN_CHUNKED_HEADERS: sview = "rewritten_chunked_headers.count == 0"
            CROSS_ORIGIN_HEADERS: sview = "cross_origin_headers.count == 2"
            RETRY_REDIRECT_URL: sview = "retry_redirect.current_url_from_redirect"
            RETRY_HEADERS: sview = "retry_headers.count == 4"
            FIXTURE_REDIRECT_NOT_ALLOWED: sview = "NetworkSessionError.RedirectNotAllowed"
            CANCEL_ACK: sview = "NetworkSessionEvent.CancelAck"
            FIXTURE_ACCOUNTING_INVALID: sview = "NetworkSessionError.AccountingInvalid"
            DOCS_SESSION: sview = "EsNetworkSession binds those policies to one transport attempt"
            LEDGER_SESSION: sview = "ES-SCRIPT-011 | EsNetworkSession"


        const module Messages:
            MISSING_ROOT: sview = "network session audit: missing repository root"
            UNRESOLVED_ROOT: sview = "network session audit: unable to resolve repository root"
            MISSING_INPUT: sview = "network session audit: missing "
            READ_FAILED: sview = "network session audit: unable to read source: "
            SUCCESS: sview = "network session audit: ordered transport phases, bounded send/receive accounting, redirects, polls, outcomes, retry, and cancellation are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::POLLS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::REDIRECTS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::REDIRECT_URL},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EFFECTIVE_HEADERS},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE_ACTIVE},
                SearchCheck{input: inputs[0], pattern: Patterns::SEND_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::RECEIVE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLL_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::REDIRECT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::EFFECTIVE_REQUEST},
                SearchCheck{input: inputs[0], pattern: Patterns::REDIRECT_TRUE},
                SearchCheck{input: inputs[0], pattern: Patterns::REDIRECT_FALSE},
                SearchCheck{input: inputs[0], pattern: Patterns::REDIRECT_NOT_ALLOWED},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_REDIRECT_STATUS},
                SearchCheck{input: inputs[0], pattern: Patterns::RETRY_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUIRES_ATTEMPT},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUIRES_ATTEMPT_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTCOME_CANCELLED},
                SearchCheck{input: inputs[0], pattern: Patterns::STATUS_FAILURE},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::SENT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::STATUS_FAILURE_OUTCOME},
                SearchCheck{input: inputs[0], pattern: Patterns::ACTIVE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLED_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::IR_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[3], pattern: Patterns::DNS_READY},
                SearchCheck{input: inputs[3], pattern: Patterns::SEND_COMPLETE},
                SearchCheck{input: inputs[3], pattern: Patterns::RECEIVE_CHUNK},
                SearchCheck{input: inputs[3], pattern: Patterns::RECEIVE_COMPLETE},
                SearchCheck{input: inputs[3], pattern: Patterns::REDIRECT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_EFFECTIVE_HEADERS},
                SearchCheck{input: inputs[3], pattern: Patterns::PARTIAL_BODY},
                SearchCheck{input: inputs[3], pattern: Patterns::ORIGINAL_POST_HEADERS},
                SearchCheck{input: inputs[3], pattern: Patterns::REWRITTEN_POST_HEADERS},
                SearchCheck{input: inputs[3], pattern: Patterns::REWRITTEN_CHUNKED_HEADERS},
                SearchCheck{input: inputs[3], pattern: Patterns::CROSS_ORIGIN_HEADERS},
                SearchCheck{input: inputs[3], pattern: Patterns::RETRY_REDIRECT_URL},
                SearchCheck{input: inputs[3], pattern: Patterns::RETRY_HEADERS},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_REDIRECT_NOT_ALLOWED},
                SearchCheck{input: inputs[3], pattern: Patterns::CANCEL_ACK},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_ACCOUNTING_INVALID},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[5], pattern: Patterns::LEDGER_SESSION}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::NETWORK_MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsNetworkSessionAudit::run_default()
