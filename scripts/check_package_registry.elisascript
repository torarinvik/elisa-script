# Bounded Elisascript port of check_package_registry.sh.
# Fixed-string checks stream through the shared scanner without rg/awk.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsPackageRegistryAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/package_registry_model.elisa"
            PACKAGE_MODEL: sview = "src/runtime/package_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "module EsPackageRegistry:"
            MAX_ENTRIES: sview = "PACKAGE_REGISTRY_MAX_ENTRIES"
            STATE: sview = "const enum PackageRegistryState of u8:"
            EVENT: sview = "const enum PackageRegistryEvent of u8:"
            CANDIDATE: sview = "struct PackageCandidate:"
            REGISTRY: sview = "struct PackageRegistry:"
            ERROR: sview = "error PackageRegistryError:"
            VALIDATE: sview = "def validate_package_registry("
            FIND: sview = "def package_registry_find("
            ADVANCE: sview = "def advance_package_registry("
            CANDIDATE_BEFORE: sview = "registry_candidate_before"
            CANDIDATE_EQUAL: sview = "registry_candidate_equal"
            CONSTRAINT_SATISFIED: sview = "registry_constraint_satisfied"
            VERSION_PRECEDES: sview = "package_version_precedes"
            INTEGRITY_MISSING: sview = "IntegrityMissing"
            ORDER_INVALID: sview = "OrderInvalid"
            EMPTY_STATE: sview = "registry.state == PackageRegistryState.Empty"
            NOT_READY: sview = "RegistryNotReady"
            CONSTRAINT_NO_MATCH: sview = "ConstraintNoMatch"
            LOADING_STATE: sview = "registry.state != PackageRegistryState.Loading"
            CANCEL_NOT_READY: sview = "CancelNotReady"
            IR_IMPORT: sview = "include \"../runtime/package_registry_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsPackageRegistry"
            FIXTURE_CONTRACT: sview = "typed_package_registry_contract_is_ordered_verified_and_constraint_aware"
            FIXTURE_ADD: sview = "PackageRegistryEvent.Add"
            FIXTURE_FIND: sview = "package_registry_find"
            FIXTURE_ORDER_ERROR: sview = "PackageRegistryError.OrderInvalid"
            FIXTURE_CANCEL: sview = "PackageRegistryEvent.Cancel"
            FIXTURE_REVERSE_ORDER: sview = "reverse_order_rejected"
            FIXTURE_NUMERIC_HIGH: sview = "numeric_prerelease_high"
            FIXTURE_NUMERIC_REVERSE: sview = "numeric_reverse_rejected"
            FIXTURE_FORGED_EMPTY: sview = "forged_empty"
            DOCS_BOUNDARY: sview = "EsPackageRegistry makes that adapter boundary explicit"
            LEDGER_ITEM: sview = "ES-SCRIPT-004 | EsPackageRegistry"


        const module Messages:
            MISSING_ROOT: sview = "package registry audit: missing repository root"
            UNRESOLVED_ROOT: sview = "package registry audit: unable to resolve repository root"
            MISSING_INPUT: sview = "package registry audit: missing "
            READ_FAILED: sview = "package registry audit: unable to read source: "
            SUCCESS: sview = "package registry audit: bounded integrity candidates, deterministic ordering, sealed lookup, constraints, and cancellation are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_ENTRIES},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::CANDIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::REGISTRY},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::FIND},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::CANDIDATE_BEFORE},
                SearchCheck{input: inputs[0], pattern: Patterns::CANDIDATE_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::CONSTRAINT_SATISFIED},
                SearchCheck{input: inputs[0], pattern: Patterns::VERSION_PRECEDES},
                SearchCheck{input: inputs[0], pattern: Patterns::INTEGRITY_MISSING},
                SearchCheck{input: inputs[0], pattern: Patterns::ORDER_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::EMPTY_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::CONSTRAINT_NO_MATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::LOADING_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_NOT_READY},
                SearchCheck{input: inputs[2], pattern: Patterns::IR_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_ADD},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_FIND},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_ORDER_ERROR},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_CANCEL},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_REVERSE_ORDER},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_NUMERIC_HIGH},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_NUMERIC_REVERSE},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_FORGED_EMPTY},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_BOUNDARY},
                SearchCheck{input: inputs[5], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::PACKAGE_MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsPackageRegistryAudit::run_default()
