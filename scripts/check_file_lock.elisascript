# Bounded Elisascript port of check_file_lock.sh.
# Regex source checks stream through the shared line scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsFileLockAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/file_lock_model.elisa"
            ADAPTER: sview = "src/runtime/file_lock_posix.elisa"
            FILE_POSIX: sview = "src/runtime/file_posix.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsFileLock:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/file_lock_model\.elisa\""
            ADAPTER_IMPORT: Regex = regex"include \"\.\./runtime/file_lock_posix\.elisa\""
            POSIX_MODULE: Regex = regex"^module EsFileLockPosix:"
            LEASE: Regex = regex"struct FileLockPosixLease:"
            LEASE_MATCHES_AT: Regex = regex"def file_lock_posix_lease_matches_at\("
            LEASE_DESCRIPTOR_MATCHES: Regex = regex"def file_lock_posix_lease_descriptor_matches\("
            ACQUIRE_AT: Regex = regex"def acquire_file_lock_at\("
            RELEASE_AT: Regex = regex"def release_file_lock_at\("
            ACCESS_MODE: Regex = regex"access_mode: int = DarwinOpenFlags::RDONLY if mode == FileLockMode.Shared else DarwinOpenFlags::WRONLY"
            OPENAT_PERMISSIONS: Regex = regex"elisascript_posix_openat\(directory_fd, lock_name, flags, 384u32\)"
            NOFOLLOW: Regex = regex"DarwinAtFlag::SYMLINK_NOFOLLOW"
            NONBLOCK: Regex = regex"PosixLockOperations::NONBLOCK"
            ACQUIRE_UNCERTAIN: Regex = regex"AcquireCleanupUncertain"
            RELEASE_UNCERTAIN: Regex = regex"ReleaseOutcomeUncertain"
            SHARED_FLAG: Regex = regex"SHARED: int = 1"
            UNLINKAT: Regex = regex"elisascript_posix_unlinkat"
            MODE: Regex = regex"const enum FileLockMode of u8"
            WAIT_MODE: Regex = regex"const enum FileLockWaitMode of u8"
            STATE: Regex = regex"const enum FileLockState of u8"
            EVENT: Regex = regex"const enum FileLockEvent of u8"
            POLICY: Regex = regex"struct FileLockPolicy:"
            TABLE: Regex = regex"struct FileLockTable:"
            SESSION: Regex = regex"struct FileLockSession:"
            ERROR: Regex = regex"error FileLockError:"
            VALIDATE_TABLE: Regex = regex"def validate_file_lock_table\("
            VALIDATE_SESSION: Regex = regex"def validate_file_lock_session\("
            ADVANCE: Regex = regex"def advance_file_lock\("
            MAX_LEASES: Regex = regex"FILE_LOCK_MAX_LEASES"
            MAX_PATH_BYTES: Regex = regex"FILE_LOCK_MAX_PATH_BYTES"
            MAX_ATTEMPTS: Regex = regex"FILE_LOCK_MAX_ATTEMPTS"
            CONFLICTS: Regex = regex"file_lock_conflicts"
            SHARED_MODE: Regex = regex"FileLockMode.Shared"
            EXCLUSIVE_MODE: Regex = regex"FileLockMode.Exclusive"
            NONBLOCKING_WAIT: Regex = regex"FileLockWaitMode.NonBlocking"
            BOUNDED_WAIT: Regex = regex"FileLockWaitMode.Bounded"
            RELEASE_ACK: Regex = regex"FileLockEvent.ReleaseAck"
            CANCEL_ACK: Regex = regex"FileLockEvent.CancelAck"
            CONFLICT: Regex = regex"FileLockError.Conflict"
            WOULD_BLOCK: Regex = regex"FileLockError.WouldBlock"
            RETRY_WITHOUT_ATTEMPT: Regex = regex"raise FileLockError.RetryNotAllowed if session.attempts == 0"
            RETRY_NOT_READY: Regex = regex"raise FileLockError.RetryNotAllowed if not session.retry_ready"
            RETRY_READY_TRUE: Regex = regex"session.retry_ready <- true"
            RETRY_READY_FALSE: Regex = regex"session.retry_ready <- false"
            DUPLICATE_OWNER_PATH: Regex = regex"FileLockError.DuplicateOwnerPath"
            LEASE_PATH_NUL: Regex = regex"raise FileLockError.EmbeddedNul if sview_contains_byte\(lease.path, 0\)"
            REQUEST_PATH_NUL: Regex = regex"raise FileLockError.EmbeddedNul if sview_contains_byte\(session.request.path, 0\)"
            NEXT_LEASE_ID: Regex = regex"table.next_lease_id <= lease.lease_id"
            MAX_LEASE_ID: Regex = regex"table.next_lease_id == 18446744073709551615u64"
            ACTIVE_LEASES: Regex = regex"active_leases"
            STATE_REQUIRES_ATTEMPT: Regex = regex"file_lock_state_requires_attempt"
            TIMED_OUT: Regex = regex"FileLockState.TimedOut"
            LEASE_FAILED: Regex = regex"FileLockLeaseState.Failed"
            FIXTURE_IMPORT: Regex = regex"using EsFileLock"
            FIXTURE_CONTRACT: Regex = regex"typed_file_lock_contract_distinguishes_shared_exclusive_and_waits"
            FIXTURE_SHARED: Regex = regex"FileLockMode.Shared"
            FIXTURE_EXCLUSIVE: Regex = regex"FileLockMode.Exclusive"
            FIXTURE_CONFLICT: Regex = regex"FileLockError.Conflict"
            FIXTURE_WOULD_BLOCK: Regex = regex"FileLockError.WouldBlock"
            RETRY_WITHOUT_ATTEMPT_FIXTURE: Regex = regex"retry_without_attempt"
            REPEATED_RETRY: Regex = regex"repeated_retry"
            FIXTURE_RELEASE_ACK: Regex = regex"FileLockEvent.ReleaseAck"
            FIXTURE_CANCEL_ACK: Regex = regex"FileLockEvent.CancelAck"
            FIXTURE_EMBEDDED_NUL: Regex = regex"FileLockError.EmbeddedNul"
            FORGED_IDENTITY: Regex = regex"forged_identity"
            EXHAUSTED_REJECTED: Regex = regex"exhausted_rejected"
            DOCS_TABLE: Regex = regex"EsFileLock::FileLockTable"
            LEDGER_ITEM: Regex = regex"ES-FS-004"


        const module Messages:
            MISSING_ROOT: sview = "file lock audit: missing repository root"
            UNRESOLVED_ROOT: sview = "file lock audit: unable to resolve repository root"
            MISSING_INPUT: sview = "file lock audit: missing "
            READ_FAILED: sview = "file lock audit: unable to read source: "
            UNLINKAT_FORBIDDEN: sview = "file lock audit: adapter must retain persistent lock names"
            SUCCESS: sview = "file lock audit: bounded advisory shared/exclusive ownership and cleanup edges are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        const enum Expectation of u8:
            Present
            Absent


        struct SearchCheck:
            input: Path
            pattern: Regex
            expectation: Expectation = Expectation.Present
            violation_message: sview = ""


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[3], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::ADAPTER_IMPORT},
                SearchCheck{input: inputs[1], pattern: Patterns::POSIX_MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::LEASE},
                SearchCheck{input: inputs[1], pattern: Patterns::LEASE_MATCHES_AT},
                SearchCheck{input: inputs[1], pattern: Patterns::LEASE_DESCRIPTOR_MATCHES},
                SearchCheck{input: inputs[1], pattern: Patterns::ACQUIRE_AT},
                SearchCheck{input: inputs[1], pattern: Patterns::RELEASE_AT},
                SearchCheck{input: inputs[1], pattern: Patterns::ACCESS_MODE},
                SearchCheck{input: inputs[1], pattern: Patterns::OPENAT_PERMISSIONS},
                SearchCheck{input: inputs[1], pattern: Patterns::NOFOLLOW},
                SearchCheck{input: inputs[1], pattern: Patterns::NONBLOCK},
                SearchCheck{input: inputs[1], pattern: Patterns::ACQUIRE_UNCERTAIN},
                SearchCheck{input: inputs[1], pattern: Patterns::RELEASE_UNCERTAIN},
                SearchCheck{input: inputs[2], pattern: Patterns::SHARED_FLAG},
                SearchCheck{input: inputs[1], pattern: Patterns::UNLINKAT, expectation: Expectation.Absent, violation_message: Messages::UNLINKAT_FORBIDDEN},
                SearchCheck{input: inputs[0], pattern: Patterns::MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::WAIT_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::TABLE},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_TABLE},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_LEASES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_PATH_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_ATTEMPTS},
                SearchCheck{input: inputs[0], pattern: Patterns::CONFLICTS},
                SearchCheck{input: inputs[0], pattern: Patterns::SHARED_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::EXCLUSIVE_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::NONBLOCKING_WAIT},
                SearchCheck{input: inputs[0], pattern: Patterns::BOUNDED_WAIT},
                SearchCheck{input: inputs[0], pattern: Patterns::RELEASE_ACK},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_ACK},
                SearchCheck{input: inputs[0], pattern: Patterns::CONFLICT},
                SearchCheck{input: inputs[0], pattern: Patterns::WOULD_BLOCK},
                SearchCheck{input: inputs[0], pattern: Patterns::RETRY_WITHOUT_ATTEMPT},
                SearchCheck{input: inputs[0], pattern: Patterns::RETRY_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::RETRY_READY_TRUE},
                SearchCheck{input: inputs[0], pattern: Patterns::RETRY_READY_FALSE},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_OWNER_PATH},
                SearchCheck{input: inputs[0], pattern: Patterns::LEASE_PATH_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST_PATH_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::NEXT_LEASE_ID},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_LEASE_ID},
                SearchCheck{input: inputs[0], pattern: Patterns::ACTIVE_LEASES},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE_REQUIRES_ATTEMPT},
                SearchCheck{input: inputs[0], pattern: Patterns::TIMED_OUT},
                SearchCheck{input: inputs[0], pattern: Patterns::LEASE_FAILED},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_SHARED},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_EXCLUSIVE},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_CONFLICT},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_WOULD_BLOCK},
                SearchCheck{input: inputs[4], pattern: Patterns::RETRY_WITHOUT_ATTEMPT_FIXTURE},
                SearchCheck{input: inputs[4], pattern: Patterns::REPEATED_RETRY},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_RELEASE_ACK},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_CANCEL_ACK},
                SearchCheck{input: inputs[4], pattern: Patterns::FIXTURE_EMBEDDED_NUL},
                SearchCheck{input: inputs[4], pattern: Patterns::FORGED_IDENTITY},
                SearchCheck{input: inputs[4], pattern: Patterns::EXHAUSTED_REJECTED},
                SearchCheck{input: inputs[5], pattern: Patterns::DOCS_TABLE},
                SearchCheck{input: inputs[6], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        match check.expectation:
                            Expectation.Present:
                                return ExitStatus::FAILURE if not found
                            Expectation.Absent:
                                diagnostic(check.violation_message) if found
                                return ExitStatus::FAILURE if found
                            _:
                                return ExitStatus::FAILURE
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::ADAPTER),
                root.joinpath(Inputs::FILE_POSIX),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsFileLockAudit::run_default()
