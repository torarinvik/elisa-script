# Bounded Elisascript port of check_task_model.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsTaskModelAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/task_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "module EsTask:"
            LIMITS: sview = "const module Limits:"
            CHILDREN_LIMIT: sview = "Limits::CHILDREN"
            MESSAGES_LIMIT: sview = "Limits::MESSAGES"
            MESSAGE_BYTES_LIMIT: sview = "Limits::MESSAGE_BYTES"
            FAILURE_MODE: sview = "const enum TaskFailureMode of u8:"
            SCOPE_STATE: sview = "const enum TaskScopeState of u8:"
            SCOPE_EVENT: sview = "const enum TaskScopeEvent of u8:"
            SCOPE: sview = "struct TaskScope:"
            CHANNEL_STATE: sview = "const enum TaskChannelState of u8:"
            CHANNEL_EVENT: sview = "const enum TaskChannelEvent of u8:"
            CHANNEL: sview = "struct TaskChannel:"
            ERROR: sview = "error TaskContractError:"
            VALIDATE_SCOPE: sview = "def validate_task_scope("
            ADVANCE_SCOPE: sview = "def advance_task_scope("
            VALIDATE_CHANNEL: sview = "def validate_task_channel("
            ADVANCE_CHANNEL: sview = "def advance_task_channel("
            CHANNEL_SEND: sview = "def task_channel_send("
            CHANNEL_RECEIVE: sview = "def task_channel_receive("
            SCOPE_STATE_VALID: sview = "task_scope_state_valid"
            SCOPE_EVENT_VALID: sview = "task_scope_event_valid"
            CHANNEL_STATE_VALID: sview = "task_channel_state_valid"
            CHILD_LIMIT_ERROR: sview = "ChildLimitExceeded"
            CHILD_ACCOUNTING_ERROR: sview = "ChildAccountingInvalid"
            SCOPE_SUCCEEDED: sview = "scope.state == TaskScopeState.Succeeded"
            SCOPE_CLOSING: sview = "scope.state == TaskScopeState.Closing"
            SCOPE_CANCELLING: sview = "scope.state == TaskScopeState.Cancelling"
            SCOPE_FAILED: sview = "scope.state == TaskScopeState.Failed"
            FAILED_CHILDREN_RESULT: sview = "scope.failed_children != 0 else TaskScopeState.Cancelled"
            ACTIVE_CHILDREN: sview = "scope.active_children != 0"
            SUCCESS_OR_FAILURE: sview = "scope.state <- TaskScopeState.Succeeded if scope.failed_children == 0 else TaskScopeState.Failed"
            SCOPE_CANCELLED: sview = "scope.state == TaskScopeState.Cancelled"
            CHANNEL_BUFFER_ERROR: sview = "ChannelBufferExceeded"
            EMPTY_WITH_BYTES: sview = "channel.buffered_messages == 0 and channel.buffered_bytes != 0"
            MESSAGES_WITHOUT_BYTES: sview = "channel.buffered_messages != 0 and channel.buffered_bytes == 0"
            CHANNEL_CLOSING: sview = "channel.state == TaskChannelState.Closing"
            CHANNEL_CLOSED: sview = "channel.state == TaskChannelState.Closed"
            CHANNEL_CANCELLED: sview = "channel.state == TaskChannelState.Cancelled"
            CHANNEL_EMPTY: sview = "ChannelEmpty"
            SINGLE_MESSAGE_BYTES: sview = "channel.buffered_messages == 1 and message_bytes != channel.buffered_bytes"
            SCOPE_CANCEL_ACK: sview = "TaskScopeEvent.CancelAck"
            CHANNEL_CANCEL_ACK: sview = "TaskChannelEvent.CancelAck"
            MODEL_IMPORT: sview = "include \"../runtime/task_model.elisa\""
            FIXTURE_CONTRACT: sview = "typed_task_scope_and_channel_contract_is_bounded"
            FIXTURE_AGGREGATE_CLOSE: sview = "aggregate_close"
            FIXTURE_AGGREGATE: sview = "TaskFailureMode.Aggregate"
            FIXTURE_BUFFER_ERROR: sview = "TaskContractError.ChannelBufferExceeded"
            FIXTURE_ACCOUNTING_ERROR: sview = "TaskContractError.ChildAccountingInvalid"
            FIXTURE_CLOSED: sview = "TaskChannelState.Closed"
            FIXTURE_PARTIAL_LAST: sview = "partial_last_rejected"
            DOCS_SCOPE: sview = "EsTask::TaskScope"


        const module Messages:
            MISSING_ROOT: sview = "task model audit: missing repository root"
            UNRESOLVED_ROOT: sview = "task model audit: unable to resolve repository root"
            MISSING_INPUT: sview = "task model audit: missing "
            READ_FAILED: sview = "task model audit: unable to read source: "
            SUCCESS: sview = "task model audit: bounded scopes, child accounting, channel backpressure, and cancellation edges are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMITS},
                SearchCheck{input: inputs[0], pattern: Patterns::CHILDREN_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::MESSAGES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::MESSAGE_BYTES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILURE_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE},
                SearchCheck{input: inputs[0], pattern: Patterns::CHANNEL_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::CHANNEL_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::CHANNEL},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_SCOPE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE_SCOPE},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_CHANNEL},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE_CHANNEL},
                SearchCheck{input: inputs[0], pattern: Patterns::CHANNEL_SEND},
                SearchCheck{input: inputs[0], pattern: Patterns::CHANNEL_RECEIVE},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_STATE_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_EVENT_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::CHANNEL_STATE_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::CHILD_LIMIT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::CHILD_ACCOUNTING_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_SUCCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_CLOSING},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_CANCELLING},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_FAILED},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILED_CHILDREN_RESULT},
                SearchCheck{input: inputs[0], pattern: Patterns::ACTIVE_CHILDREN},
                SearchCheck{input: inputs[0], pattern: Patterns::SUCCESS_OR_FAILURE},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_CANCELLED},
                SearchCheck{input: inputs[0], pattern: Patterns::CHANNEL_BUFFER_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::EMPTY_WITH_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::MESSAGES_WITHOUT_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::CHANNEL_CLOSING},
                SearchCheck{input: inputs[0], pattern: Patterns::CHANNEL_CLOSED},
                SearchCheck{input: inputs[0], pattern: Patterns::CHANNEL_CANCELLED},
                SearchCheck{input: inputs[0], pattern: Patterns::CHANNEL_EMPTY},
                SearchCheck{input: inputs[0], pattern: Patterns::SINGLE_MESSAGE_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_CANCEL_ACK},
                SearchCheck{input: inputs[0], pattern: Patterns::CHANNEL_CANCEL_ACK},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_AGGREGATE_CLOSE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_AGGREGATE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_BUFFER_ERROR},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ACCOUNTING_ERROR},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CLOSED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_PARTIAL_LAST},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SCOPE},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_SCOPE}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsTaskModelAudit::run_default()
