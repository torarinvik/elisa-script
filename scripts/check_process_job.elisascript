# Streaming Elisascript port of check_process_job.sh.
# Keep the shell oracle until its public-launcher parity contract is qualified.

include "./shell_invocation_path.elisascript"

module EsProcessJobAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/process_model.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            JOB_STATE: sview = "const enum ProcessJobState of u8:"
            JOB_EVENT: sview = "const enum ProcessJobEvent of u8:"
            JOB_STRUCT: sview = "struct ProcessJob:"
            JOB_ERROR: sview = "error ProcessJobError:"
            ADVANCE_JOB: sview = "def advance_process_job("
            INVALID_STATE: sview = "ProcessJobError.InvalidState"
            RETRY_LIMIT_ERROR: sview = "ProcessJobError.RetryLimitExceeded"
            REQUIRES_ATTEMPT: sview = "process_job_state_requires_attempt"
            ATTEMPTS_OVER_LIMIT: sview = "job.attempts > job.max_attempts"
            CREATED_AT_LIMIT: sview = "job.state == ProcessJobState.Created and job.attempts >= job.max_attempts"
            ATTEMPTS_AT_LIMIT: sview = "job.attempts >= job.max_attempts"
            CANCELLED_STATE: sview = "ProcessJobState.Cancelled"
            CANCEL_ACK_EVENT: sview = "ProcessJobEvent.CancelAck"
            FIXTURE_TIMEOUT: sview = "ProcessJobEvent.Timeout"
            FIXTURE_RETRY: sview = "ProcessJobEvent.Retry"
            FIXTURE_RETRY_LIMIT_ERROR: sview = "ProcessJobError.RetryLimitExceeded"
            FIXTURE_CANCEL_ACK: sview = "ProcessJobEvent.CancelAck"
            FIXTURE_FORGED_CANCEL: sview = "forged_cancelled_attempt"
            DOCS_JOB_API: sview = "`ProcessJob` and `advance_process_job`"
            LEDGER_JOB_MACHINE: sview = "`ProcessJob` adds a typed background-supervision state machine"


        const module Messages:
            MISSING_ROOT: sview = "process job audit: missing repository root"
            UNRESOLVED_ROOT: sview = "process job audit: unable to resolve repository root"
            MISSING_INPUT: sview = "process job audit: missing "


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(model: Path, fixture: Path, docs: Path, ledger: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: model, pattern: Patterns::JOB_STATE},
                SearchCheck{input: model, pattern: Patterns::JOB_EVENT},
                SearchCheck{input: model, pattern: Patterns::JOB_STRUCT},
                SearchCheck{input: model, pattern: Patterns::JOB_ERROR},
                SearchCheck{input: model, pattern: Patterns::ADVANCE_JOB},
                SearchCheck{input: model, pattern: Patterns::INVALID_STATE},
                SearchCheck{input: model, pattern: Patterns::RETRY_LIMIT_ERROR},
                SearchCheck{input: model, pattern: Patterns::REQUIRES_ATTEMPT},
                SearchCheck{input: model, pattern: Patterns::ATTEMPTS_OVER_LIMIT},
                SearchCheck{input: model, pattern: Patterns::CREATED_AT_LIMIT},
                SearchCheck{input: model, pattern: Patterns::ATTEMPTS_AT_LIMIT},
                SearchCheck{input: model, pattern: Patterns::CANCELLED_STATE},
                SearchCheck{input: model, pattern: Patterns::CANCEL_ACK_EVENT},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_TIMEOUT},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_RETRY},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_RETRY_LIMIT_ERROR},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_CANCEL_ACK},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_FORGED_CANCEL},
                SearchCheck{input: docs, pattern: Patterns::DOCS_JOB_API},
                SearchCheck{input: ledger, pattern: Patterns::LEDGER_JOB_MACHINE}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Environment.Read, File.Read, Directory.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Format]:
            rg: Executable = try executable("rg") else err:
                return 127i64
            for check in checks:
                arguments: darray[sview] = ["-Fq", check.pattern, f"{check.input}"]
                status: i64 = try run_process(rg, arguments, 0i64) else err:
                    return 127i64
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return 1i64
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return 1i64

            status: i64 = execute(searches(inputs[0], inputs[1], inputs[2], inputs[3]))
            return status if status != 0i64

            print("process job audit: bounded retry, cancellation, and terminal-state transitions are present")
            return 0i64


        def run_default() -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsProcessJobAudit::run_default()
