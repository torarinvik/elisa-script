# Logical path selection shared by small ports of shell wrappers.
# Bash `dirname` followed by `cd -L` and `pwd` preserves valid logical PWD
# spellings (including symlink components) while normalizing `.` and `..`.

module EsShellInvocationPath:
    public:
        const enum Error of u8:
            CurrentDirectoryUnavailable
            EmptyDirectorySpelling


        def project_root(invocation_path: sview) -> Path error[Error] can[Environment.Read, Directory.Read, File.Read, Memory.Allocate, Abort.Panic]:
            length: usize = sview_len(invocation_path)
            finish: mutable usize = length
            while finish > 0 and sview_at(invocation_path, finish - 1) == 47:
                finish <- finish - 1
            script_directory: mutable sview = "."
            if finish > 0:
                path_without_trailing_slashes: sview = string_view_prefix(invocation_path, finish.i64())
                slash: i64 = sview_find_last_byte(path_without_trailing_slashes, 47)
                if slash >= 0:
                    parent_end: mutable usize = slash.usize()
                    while parent_end > 0 and sview_at(path_without_trailing_slashes, parent_end - 1) == 47:
                        parent_end <- parent_end - 1
                    script_directory <- "/" if parent_end == 0
                    script_directory <- string_view_prefix(path_without_trailing_slashes, parent_end.i64()) if parent_end > 0

            # Bash command substitution strips all trailing LF bytes from the
            # output of dirname, including LFs that were part of the path.
            directory_end: mutable usize = sview_len(script_directory)
            while directory_end > 0 and sview_at(script_directory, directory_end - 1) == 10:
                directory_end <- directory_end - 1
            script_directory <- string_view_prefix(script_directory, directory_end.i64())
            raise Error.EmptyDirectorySpelling if script_directory == ""

            script_directory_path: Path = path(script_directory)
            if not path_is_absolute(script_directory_path):
                physical_directory: Path = try current_directory() else err:
                    raise Error.CurrentDirectoryUnavailable
                logical_directory: mutable Path = physical_directory
                inherited_pwd: sview = try getenv("PWD", "") else err:
                    ""
                inherited_path: Path = path(inherited_pwd)
                if path_is_absolute(inherited_path):
                    inherited_pwd_is_current: bool = try path_real(inherited_path) == physical_directory else false
                    if inherited_pwd_is_current:
                        logical_directory <- inherited_path
                script_directory_path <- path_join(logical_directory, script_directory)

            normalized_script_directory: Path = path_normalize(script_directory_path)
            return path_normalize(path_join(normalized_script_directory, ".."))
