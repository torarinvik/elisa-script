# Bounded Elisascript port of check_aggregate_literal_atomic.sh.
# Function bodies and source lines are streamed; no awk or rg child is needed.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsAggregateLiteralAtomicAudit:
    private:
        const module Inputs:
            INTERPRETER: sview = "src/ir/interpret.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            ARRAY_FUNCTION: sview = "def evaluate_array"
            MAP_FUNCTION: sview = "def evaluate_map"
            GLOBAL_FUNCTION: sview = "def global_value("
            ENTRY_CURSOR: sview = "storage_start: usize = storage.count"
            ENTRY_ROLLBACK: sview = "storage.truncate(storage_start)"
            GLOBAL_ROLLBACK: sview = "storage.truncate(start)"
            DOCS: sview = "rolls the shared storage cursor back"
            LEDGER: sview = "Array/map literal and global initialization paths likewise roll back"


        const module Messages:
            MISSING_ROOT: sview = "aggregate literal atomic audit: missing repository root"
            UNRESOLVED_ROOT: sview = "aggregate literal atomic audit: unable to resolve repository root"
            MISSING_INPUT: sview = "aggregate literal atomic audit: missing "
            MISSING_CURSOR: sview = "aggregate literal atomic audit: missing entry cursor in "
            MISSING_ROLLBACK: sview = "aggregate literal atomic audit: missing rollback in "
            GLOBAL_INCOMPLETE: sview = "aggregate literal atomic audit: global aggregate rollback is incomplete"
            READ_FAILED: sview = "aggregate literal atomic audit: unable to read source: "
            SUCCESS: sview = "aggregate literal atomic audit: array, map, and global construction roll back partial storage on failure"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


        def assert_rollback(path: Path, definition: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            body: EsSourceFunctionScope::FunctionBody = try EsSourceFunctionScope::read_function_body(path, definition) else err:
                diagnostic(Messages::READ_FAILED + f"{path}")
                return ExitStatus::IO_FAILURE
            if not body.found or not EsSourceFunctionScope::contains(body.text, Patterns::ENTRY_CURSOR):
                diagnostic(Messages::MISSING_CURSOR + f"{definition}")
                return ExitStatus::FAILURE
            if not EsSourceFunctionScope::contains(body.text, Patterns::ENTRY_ROLLBACK):
                diagnostic(Messages::MISSING_ROLLBACK + f"{definition}")
                return ExitStatus::FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: mutable i64 = assert_rollback(inputs[0], Patterns::ARRAY_FUNCTION)
            return status if status != 0i64
            status <- assert_rollback(inputs[0], Patterns::MAP_FUNCTION)
            return status if status != 0i64

            global_body: EsSourceFunctionScope::FunctionBody = try EsSourceFunctionScope::read_function_body(inputs[0], Patterns::GLOBAL_FUNCTION) else err:
                diagnostic(Messages::READ_FAILED + f"{inputs[0]}")
                return ExitStatus::IO_FAILURE
            global_rollback_lines: usize = EsSourceFunctionScope::matching_line_count(global_body.text, Patterns::GLOBAL_ROLLBACK)
            # Like the reference's `set -e` command substitution around
            # `rg -c`, zero matches exit silently before the custom check.
            return ExitStatus::FAILURE if global_rollback_lines == 0
            if global_rollback_lines < 2:
                diagnostic(Messages::GLOBAL_INCOMPLETE)
                return ExitStatus::FAILURE

            status <- has_line(inputs[1], Patterns::DOCS)
            return status if status != 0i64
            status <- has_line(inputs[2], Patterns::LEDGER)
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsAggregateLiteralAtomicAudit::run_default()
