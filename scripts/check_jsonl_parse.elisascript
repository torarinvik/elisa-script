# Bounded Elisascript port of check_jsonl_parse.sh.
# Fixed-string contracts and the line-count assertion use shared bounded scanners.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsJsonLinesParseAudit:
    private:
        const module Inputs:
            PARSER: sview = "src/runtime/jsonl_parse_model.elisa"
            STREAM: sview = "src/runtime/json_stream_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"


        const module Patterns:
            BOUNDARY_MODE: sview = "const enum JsonLineBoundaryMode of u8:"
            BALANCED_CONTAINERS: sview = "BalancedContainers"
            PHYSICAL_LINES: sview = "PhysicalLines"
            RECORD_BOUNDARY_DEFAULT: sview = "record_boundary: JsonLineBoundaryMode = JsonLineBoundaryMode.BalancedContainers"
            VALID_BOUNDARY_MODE: sview = "policy.record_boundary == JsonLineBoundaryMode.BalancedContainers or policy.record_boundary == JsonLineBoundaryMode.PhysicalLines"
            BOUNDARY_CANDIDATE: sview = "def json_stream_byte_is_boundary_candidate("
            UNTERMINATED_STRING: sview = "JsonStreamError.UnterminatedString if session.in_string or session.escaped"
            UNTERMINATED_PHYSICAL_VALUE: sview = "JsonStreamError.UnterminatedValue if session.policy.record_boundary == JsonLineBoundaryMode.PhysicalLines and session.depth != 0"
            MODULE: sview = "module EsJsonLinesParse:"
            READER: sview = "struct JsonLinesReader:"
            READ_RESULT: sview = "struct JsonLinesReadResult:"
            CHUNK_READER: sview = "struct JsonLinesChunkReader:"
            FEED_RESULT: sview = "struct JsonLinesFeedResult:"
            ERROR: sview = "error JsonLinesParseError:"
            WHITESPACE_RECORD: sview = "def json_lines_record_is_whitespace("
            BEGIN_READER: sview = "def begin_json_lines_reader("
            VALIDATE_READER: sview = "def validate_json_lines_reader("
            NEXT_DOCUMENT: sview = "def next_json_lines_document("
            FEED_CHUNK: sview = "def feed_json_lines_chunk("
            STREAM_DECODER_BYTES: sview = "reader.stream.input_bytes - reader.decoder.input_bytes != reader.stream.record_bytes"
            PENDING_CR: sview = "reader.stream.pending_cr"
            PENDING_CR_BEFORE: sview = "pending_cr_before: bool = reader.stream.pending_cr"
            DEFERRED_CURRENT_CR: sview = "deferred_current_cr: bool = byte == 13u8 and reader.stream.pending_cr"
            NEED_INPUT: sview = "JsonLinesFeedOutcome.NeedInput"
            ADVANCE_STREAM_BYTE: sview = "advance_json_stream(reader.stream, JsonStreamEvent.Byte, byte)"
            ADVANCE_STREAM_END: sview = "advance_json_stream(reader.stream, JsonStreamEvent.RecordEnd)"
            PARSE_DOCUMENT: sview = "parse_json_document(lexed)"
            ADVANCE_DECODER_TOKEN: sview = "advance_data_decoder(reader.decoder, DataDecoderEvent.Token"
            ADVANCE_DECODER_RECORD: sview = "advance_data_decoder(reader.decoder, DataDecoderEvent.Record"
            FAILURE_RECORD_START: sview = "reader.failure_record_start <- reader.record_start"
            ALLOW_EMPTY_RECORDS: sview = "reader.stream.policy.allow_empty_records"
            BOUNDARY_CANDIDATE_CALL: sview = "json_stream_byte_is_boundary_candidate(reader.stream, byte)"
            FRAMING_BOUNDARY: sview = "record_boundary: framing.record_boundary"
            STREAM_FAILED: sview = "JsonStreamState.Failed"
            MODEL_IMPORT: sview = "include \"../runtime/jsonl_parse_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsJsonLinesParse"
            FIXTURE_CONTRACT: sview = "typed_json_lines_reader_returns_bounded_documents_one_record_at_a_time"
            BEGIN_CHUNK_READER: sview = "begin_json_lines_chunk_reader(limits)"
            SECOND_CHUNK: sview = "second_chunk.outcome == JsonLinesFeedOutcome.Document and second_chunk.consumed_bytes == 3"
            FINAL_RECORD: sview = "final_record.record_number == 2 and final_record.source_offset == 5"
            FINAL_DELIMITER_SUFFIX: sview = "final_delimiter_suffix.outcome == JsonLinesFeedOutcome.Document and final_delimiter_suffix.consumed_bytes == 5"
            FINAL_DELIMITER_COMPLETE: sview = "final_delimiter_reader.stream.state == JsonStreamState.Complete"
            WRONG_SUFFIX_REJECTED: sview = "final_delimiter_wrong_suffix_rejected"
            SPLIT_CRLF: sview = "split_crlf.outcome == JsonLinesFeedOutcome.NeedInput and split_crlf.consumed_bytes == 1"
            TIGHT_CRLF_PREFIX: sview = "tight_crlf_prefix.outcome == JsonLinesFeedOutcome.NeedInput and tight_crlf_prefix.consumed_bytes == 5"
            EMPTY_CHUNK_RESULT: sview = "empty_chunk_result.record_number == 2 and empty_chunk_result.source_offset == 2 and empty_chunk_result.consumed_bytes == 6"
            CHUNK_FAILURE_LOCATION: sview = "chunk_limited_reader.failure_record_number == 2 and chunk_limited_reader.failure_record_start == 5"
            MULTI_RECORD_READER: sview = "begin_json_lines_reader(\"null\\r\\ntrue\\n[1]\", limits)"
            TIGHT_CRLF_DOCUMENT: sview = "tight_crlf_document"
            CRLF_BUFFER_SIZE: sview = "tight_crlf_chunk_reader.record_buffer.count == 4"
            DECODER_COUNTS: sview = "reader.decoder.records == 3 and reader.decoder.tokens == 5"
            EMPTY_READER: sview = "empty_reader"
            EMPTY_POLICY_READER: sview = "begin_json_lines_reader(\"\\r\\nnull\\n\", limits, JsonPolicy{}, empty_policy)"
            WHITESPACE_EOF_READER: sview = "whitespace_eof_reader"
            VALIDATE_LIMITED_READER: sview = "assert validate_json_lines_reader(limited_reader)"
            TOKEN_LIMIT: sview = "JsonLinesParseError.TokenLimitExceeded"
            FAILURE_RECORD_NUMBER: sview = "failure_record_number == 3 and limited_reader.failure_record_start == 10"
            READER_STAYS_FAILED: sview = "reader_stays_failed"
            FORMAT_VERSION: sview = "JSON_LINES_PARSE_FORMAT_VERSION == 2"
            BALANCED_MULTILINE: sview = "balanced_multiline_reader"
            PHYSICAL_MODE: sview = "JsonLineBoundaryMode.PhysicalLines"
            PHYSICAL_MULTILINE: sview = "physical_multiline_reader"
            PHYSICAL_STRING: sview = "physical_string_reader"
            PHYSICAL_CHUNK: sview = "physical_chunk_reader"
            PHYSICAL_CHUNK_STRING: sview = "physical_chunk_string_reader"
            PHYSICAL_EMPTY: sview = "physical_empty_reader"
            DOCS_NEXT_DOCUMENT: sview = "`EsJsonLinesParse::next_json_lines_document`"


        const module Messages:
            MISSING_ROOT: sview = "jsonl parse audit: missing repository root"
            UNRESOLVED_ROOT: sview = "jsonl parse audit: unable to resolve repository root"
            MISSING_INPUT: sview = "jsonl parse audit: missing "
            READ_FAILED: sview = "jsonl parse audit: unable to read source: "
            SUCCESS: sview = "jsonl parse audit: bounded framing, cumulative budgets, and record-at-a-time chunk parsing are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def boundary_searches(stream: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: stream, pattern: Patterns::BOUNDARY_MODE},
                SearchCheck{input: stream, pattern: Patterns::BALANCED_CONTAINERS},
                SearchCheck{input: stream, pattern: Patterns::PHYSICAL_LINES},
                SearchCheck{input: stream, pattern: Patterns::RECORD_BOUNDARY_DEFAULT},
                SearchCheck{input: stream, pattern: Patterns::VALID_BOUNDARY_MODE},
                SearchCheck{input: stream, pattern: Patterns::BOUNDARY_CANDIDATE},
                SearchCheck{input: stream, pattern: Patterns::UNTERMINATED_STRING},
                SearchCheck{input: stream, pattern: Patterns::UNTERMINATED_PHYSICAL_VALUE}
            ]


        def parser_searches(parser: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: parser, pattern: Patterns::MODULE},
                SearchCheck{input: parser, pattern: Patterns::READER},
                SearchCheck{input: parser, pattern: Patterns::READ_RESULT},
                SearchCheck{input: parser, pattern: Patterns::CHUNK_READER},
                SearchCheck{input: parser, pattern: Patterns::FEED_RESULT},
                SearchCheck{input: parser, pattern: Patterns::ERROR},
                SearchCheck{input: parser, pattern: Patterns::WHITESPACE_RECORD},
                SearchCheck{input: parser, pattern: Patterns::BEGIN_READER},
                SearchCheck{input: parser, pattern: Patterns::VALIDATE_READER},
                SearchCheck{input: parser, pattern: Patterns::NEXT_DOCUMENT},
                SearchCheck{input: parser, pattern: Patterns::FEED_CHUNK},
                SearchCheck{input: parser, pattern: Patterns::STREAM_DECODER_BYTES},
                SearchCheck{input: parser, pattern: Patterns::PENDING_CR},
                SearchCheck{input: parser, pattern: Patterns::PENDING_CR_BEFORE},
                SearchCheck{input: parser, pattern: Patterns::DEFERRED_CURRENT_CR},
                SearchCheck{input: parser, pattern: Patterns::NEED_INPUT},
                SearchCheck{input: parser, pattern: Patterns::ADVANCE_STREAM_BYTE},
                SearchCheck{input: parser, pattern: Patterns::ADVANCE_STREAM_END},
                SearchCheck{input: parser, pattern: Patterns::PARSE_DOCUMENT},
                SearchCheck{input: parser, pattern: Patterns::ADVANCE_DECODER_TOKEN},
                SearchCheck{input: parser, pattern: Patterns::ADVANCE_DECODER_RECORD},
                SearchCheck{input: parser, pattern: Patterns::FAILURE_RECORD_START},
                SearchCheck{input: parser, pattern: Patterns::ALLOW_EMPTY_RECORDS},
                SearchCheck{input: parser, pattern: Patterns::BOUNDARY_CANDIDATE_CALL},
                SearchCheck{input: parser, pattern: Patterns::FRAMING_BOUNDARY},
                SearchCheck{input: parser, pattern: Patterns::STREAM_FAILED}
            ]


        def tail_searches(ir: Path, fixture: Path, docs: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: ir, pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: fixture, pattern: Patterns::BEGIN_CHUNK_READER},
                SearchCheck{input: fixture, pattern: Patterns::SECOND_CHUNK},
                SearchCheck{input: fixture, pattern: Patterns::FINAL_RECORD},
                SearchCheck{input: fixture, pattern: Patterns::FINAL_DELIMITER_SUFFIX},
                SearchCheck{input: fixture, pattern: Patterns::FINAL_DELIMITER_COMPLETE},
                SearchCheck{input: fixture, pattern: Patterns::WRONG_SUFFIX_REJECTED},
                SearchCheck{input: fixture, pattern: Patterns::SPLIT_CRLF},
                SearchCheck{input: fixture, pattern: Patterns::TIGHT_CRLF_PREFIX},
                SearchCheck{input: fixture, pattern: Patterns::EMPTY_CHUNK_RESULT},
                SearchCheck{input: fixture, pattern: Patterns::CHUNK_FAILURE_LOCATION},
                SearchCheck{input: fixture, pattern: Patterns::MULTI_RECORD_READER},
                SearchCheck{input: fixture, pattern: Patterns::TIGHT_CRLF_DOCUMENT},
                SearchCheck{input: fixture, pattern: Patterns::CRLF_BUFFER_SIZE},
                SearchCheck{input: fixture, pattern: Patterns::DECODER_COUNTS},
                SearchCheck{input: fixture, pattern: Patterns::EMPTY_READER},
                SearchCheck{input: fixture, pattern: Patterns::EMPTY_POLICY_READER},
                SearchCheck{input: fixture, pattern: Patterns::WHITESPACE_EOF_READER},
                SearchCheck{input: fixture, pattern: Patterns::VALIDATE_LIMITED_READER},
                SearchCheck{input: fixture, pattern: Patterns::TOKEN_LIMIT},
                SearchCheck{input: fixture, pattern: Patterns::FAILURE_RECORD_NUMBER},
                SearchCheck{input: fixture, pattern: Patterns::READER_STAYS_FAILED},
                SearchCheck{input: fixture, pattern: Patterns::FORMAT_VERSION},
                SearchCheck{input: fixture, pattern: Patterns::BALANCED_MULTILINE},
                SearchCheck{input: fixture, pattern: Patterns::PHYSICAL_MODE},
                SearchCheck{input: fixture, pattern: Patterns::PHYSICAL_MULTILINE},
                SearchCheck{input: fixture, pattern: Patterns::PHYSICAL_STRING},
                SearchCheck{input: fixture, pattern: Patterns::PHYSICAL_CHUNK},
                SearchCheck{input: fixture, pattern: Patterns::PHYSICAL_CHUNK_STRING},
                SearchCheck{input: fixture, pattern: Patterns::PHYSICAL_EMPTY},
                SearchCheck{input: docs, pattern: Patterns::DOCS_NEXT_DOCUMENT}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


        def framing_assignment_line_count(parser: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::matching_file_line_count(parser, Patterns::FRAMING_BOUNDARY):
                ok count:
                    return ExitStatus::FAILURE if count != 2
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{parser}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::PARSER),
                root.joinpath(Inputs::STREAM),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: mutable i64 = execute(boundary_searches(inputs[1]))
            return status if status != 0i64
            status <- framing_assignment_line_count(inputs[0])
            return status if status != 0i64
            status <- execute(parser_searches(inputs[0]))
            return status if status != 0i64
            status <- execute(tail_searches(inputs[2], inputs[3], inputs[4]))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsJsonLinesParseAudit::run_default()
