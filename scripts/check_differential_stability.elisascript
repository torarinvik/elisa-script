# Bounded Elisascript port of check_differential_stability.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDifferentialStabilityAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/testing/stability_model.elisa"
            CONSUMER: sview = "src/testing/differential.elisa"
            FIXTURE: sview = "test/differential/elisascript_differential_test.elisa"
            DOCS: sview = "docs/differential-testing.md"


        const module Patterns:
            MODULE: sview = "module EsDifferentialStability:"
            REPEATS_LIMIT: sview = "Limits::REPEATS"
            STATE: sview = "const enum DifferentialStabilityState of u8:"
            EVENT: sview = "const enum DifferentialStabilityEvent of u8:"
            CLASSIFICATION: sview = "const enum DifferentialStabilityClassification of u8:"
            NONDETERMINISM_POLICY: sview = "const enum DifferentialNondeterminismPolicy of u8:"
            POLICY: sview = "struct DifferentialStabilityPolicy:"
            OBSERVATION: sview = "struct DifferentialStabilityObservation:"
            SESSION: sview = "struct DifferentialStabilitySession:"
            ERROR: sview = "error DifferentialStabilityError:"
            VALIDATE: sview = "def validate_differential_stability("
            ADVANCE: sview = "def advance_differential_stability("
            MINIMUM_REPEATS: sview = "minimum_repeats"
            MAXIMUM_REPEATS: sview = "maximum_repeats"
            NONDETERMINISTIC_REJECTED: sview = "NondeterministicRejected"
            POLICY_REJECT: sview = "DifferentialNondeterminismPolicy.Reject"
            POLICY_REPORT: sview = "DifferentialNondeterminismPolicy.Report"
            HAS_NONDETERMINISM: sview = "has_nondeterminism"
            EXPECTED_STABLE_REPEATS: sview = "expected_stable_repeats"
            EXPECTED_NONDETERMINISM: sview = "expected_nondeterminism"
            STABLE_REPEAT_COUNT: sview = "session.stable_repeats != expected_stable_repeats"
            NONDETERMINISM_FLAG: sview = "session.has_nondeterminism != expected_nondeterminism"
            PLANNED_OBSERVATIONS: sview = "session.state == DifferentialStabilityState.Planned and (session.observations.count != 0"
            PLANNED_CLASSIFICATION: sview = "session.state == DifferentialStabilityState.Planned and session.classification != DifferentialStabilityClassification.Unknown"
            COMPLETED_TOO_EARLY: sview = "session.state == DifferentialStabilityState.Completed and session.observations.count < session.policy.minimum_repeats"
            CLASSIFIED_EQUAL: sview = "session.classification == DifferentialStabilityClassification.StableEqual"
            BASELINE_EQUAL_REQUIRED: sview = "raise DifferentialStabilityError.ClassificationInvalid if not session.baseline_equal"
            CLASSIFIED_MISMATCH: sview = "session.classification == DifferentialStabilityClassification.StableMismatch"
            BASELINE_MISMATCH_REQUIRED: sview = "raise DifferentialStabilityError.ClassificationInvalid if session.baseline_equal"
            STABLE_EQUAL: sview = "StableEqual"
            STABLE_MISMATCH: sview = "StableMismatch"
            COMPLETE_NOT_READY: sview = "CompleteNotReady"
            REPEAT_ORDER_INVALID: sview = "RepeatOrderInvalid"
            MODEL_IMPORT: sview = "include \"./stability_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsDifferentialStability"
            FIXTURE_CONTRACT: sview = "differential_stability_contract_classifies_stable_and_nondeterministic_repeats"
            FIXTURE_OBSERVATION: sview = "DifferentialStabilityEvent.Observation"
            FIXTURE_STABLE_EQUAL: sview = "DifferentialStabilityClassification.StableEqual"
            FIXTURE_NONDETERMINISTIC: sview = "DifferentialStabilityClassification.Nondeterministic"
            FIXTURE_REJECTED: sview = "DifferentialStabilityError.NondeterministicRejected"
            FORGED_ACCOUNTING: sview = "forged_stability_accounting"
            FORGED_PLANNED: sview = "forged_planned_stability"
            TOO_EARLY: sview = "completed_too_early"
            WRONG_LABEL: sview = "wrong_stability_label"
            FORGED_NONDETERMINISTIC: sview = "forged_nondeterministic"
            DOCS_SESSION: sview = "EsDifferentialStability::DifferentialStabilitySession"


        const module Messages:
            MISSING_ROOT: sview = "differential stability audit: missing repository root"
            UNRESOLVED_ROOT: sview = "differential stability audit: unable to resolve repository root"
            MISSING_INPUT: sview = "differential stability audit: missing "
            READ_FAILED: sview = "differential stability audit: unable to read source: "
            SUCCESS: sview = "differential stability audit: bounded repeats, explicit stable classifications, and fail-closed nondeterminism policy are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::REPEATS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::CLASSIFICATION},
                SearchCheck{input: inputs[0], pattern: Patterns::NONDETERMINISM_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::OBSERVATION},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::MINIMUM_REPEATS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAXIMUM_REPEATS},
                SearchCheck{input: inputs[0], pattern: Patterns::NONDETERMINISTIC_REJECTED},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY_REJECT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY_REPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::HAS_NONDETERMINISM},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPECTED_STABLE_REPEATS},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPECTED_NONDETERMINISM},
                SearchCheck{input: inputs[0], pattern: Patterns::STABLE_REPEAT_COUNT},
                SearchCheck{input: inputs[0], pattern: Patterns::NONDETERMINISM_FLAG},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_OBSERVATIONS},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_CLASSIFICATION},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETED_TOO_EARLY},
                SearchCheck{input: inputs[0], pattern: Patterns::CLASSIFIED_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::BASELINE_EQUAL_REQUIRED},
                SearchCheck{input: inputs[0], pattern: Patterns::CLASSIFIED_MISMATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::BASELINE_MISMATCH_REQUIRED},
                SearchCheck{input: inputs[0], pattern: Patterns::STABLE_EQUAL},
                SearchCheck{input: inputs[0], pattern: Patterns::STABLE_MISMATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETE_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::REPEAT_ORDER_INVALID},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_OBSERVATION},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STABLE_EQUAL},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_NONDETERMINISTIC},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_REJECTED},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_ACCOUNTING},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_PLANNED},
                SearchCheck{input: inputs[2], pattern: Patterns::TOO_EARLY},
                SearchCheck{input: inputs[2], pattern: Patterns::WRONG_LABEL},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_NONDETERMINISTIC},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::CONSUMER),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDifferentialStabilityAudit::run_default()
