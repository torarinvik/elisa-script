# Bounded Elisascript port of check_jsonl_file_posix.sh.
# Fixed-string and regex source checks use the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsJsonLinesFileAudit:
    private:
        const module Inputs:
            ADAPTER: sview = "src/runtime/jsonl_file_posix.elisa"
            PARSER: sview = "src/runtime/jsonl_parse_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"


        const module Patterns:
            MODULE: sview = "module EsJsonLinesFilePosix:"
            USING_PARSER: sview = "using EsJsonLinesParse"
            USING_RUNTIME: sview = "using EsRuntime"
            CHUNK_BYTES: sview = "const JSON_LINES_FILE_CHUNK_BYTES: usize = 16384"
            MAX_INPUT: sview = "const JSON_LINES_FILE_MAX_INPUT_BYTES: usize = FILE_STREAM_DEFAULT_MAX_BYTES - 1"
            READER_STATE: sview = "const enum JsonLinesFileReaderState of u8:"
            READER: sview = "struct JsonLinesFileReader:"
            ACTION: sview = "const enum JsonLinesFileAction of u8:"
            ERROR: sview = "error JsonLinesFileError:"
            MACHINE: sview = "machine over json_lines_file_action(reader) while true:"
            READ_CAPACITY: sview = "def json_lines_file_read_capacity("
            STATE_VALID: sview = "def json_lines_file_reader_state_valid("
            BEGIN_READER: sview = "def begin_json_lines_file_reader("
            NEXT_DOCUMENT: sview = "def next_json_lines_file_document("
            CLOSE_READER: sview = "def close_json_lines_file_reader("
            EFFECTIVE_FRAMING: sview = "effective_framing: mutable JsonStreamPolicy = framing"
            FILE_OPEN: sview = "FileStreamMode.ReadBinary, effective_input_bytes + 1, FileStreamEncoding.Bytes"
            READ_CHUNK: sview = "file_stream_read_chunk(reader.file, buffer, capacity)"
            FEED_CHUNK: sview = "feed_json_lines_chunk(reader.parser, json_lines_file_chunk_view(reader))"
            FEED_EOF: sview = "feed_json_lines_chunk(reader.parser, \"\", true)"
            FILE_STREAM_LIMIT: sview = "FILE_STREAM_DEFAULT_MAX_BYTES - 1"
            INPUT_LIMIT_ERROR: sview = "JsonStreamError.InputLimitExceeded"
            CLEANUP_COMMIT: sview = "file_stream_cleanup_commit(reader.cleanup, reader.file)"
            CLEANUP_ABORT: sview = "file_stream_cleanup_abort(reader.cleanup, reader.file)"
            IR_IMPORT: sview = "include \"../runtime/jsonl_file_posix.elisa\""
            FORBIDDEN_LINE_READ: Regex = regex"file_stream_read_line(_mode)?\("
            FIXTURE_BOUNDED_CHUNKS: sview = "typed_json_lines_file_adapter_uses_bounded_owned_chunks"
            FIXTURE_READS_AND_CLOSES: sview = "typed_json_lines_file_adapter_reads_documents_and_closes"
            FIXTURE_LIMIT_PROBE: sview = "typed_json_lines_file_adapter_probes_exact_limit_and_rejects_overflow"
            FIXTURE_THIRD_DOCUMENT: sview = "assert third.has_document and third.record_number == 3"
            FIXTURE_BUFFER_PROGRESS: sview = "reader.source_bytes_read == 15 and reader.buffer_bytes == 15 and reader.buffer_offset == 5"
            FIXTURE_EXACT_LIMIT: sview = "exact_reader.source_bytes_read == 5 and exact_reader.file.bytes_read == 5"
            FIXTURE_OVERFLOW_LIMIT: sview = "overflow_reader.source_bytes_read == 6 and overflow_reader.file.bytes_read == 6"
            FIXTURE_OVERFLOW_VALID: sview = "validate_json_lines_file_reader(overflow_reader)"
            FIXTURE_CHUNK_SIZE: sview = "JSON_LINES_FILE_CHUNK_BYTES == 16384"
            FIXTURE_MAX_INPUT: sview = "JSON_LINES_FILE_MAX_INPUT_BYTES + 1 == FILE_STREAM_DEFAULT_MAX_BYTES"
            FIXTURE_FAILED_NOT_CLOSED: sview = "JsonLinesFileReaderState.Failed != JsonLinesFileReaderState.Closed"
            DOCS_BEGIN: sview = "begin_json_lines_file_reader"
            DOCS_CLOSE: sview = "close_json_lines_file_reader"


        const module Messages:
            MISSING_ROOT: sview = "jsonl file audit: missing repository root"
            UNRESOLVED_ROOT: sview = "jsonl file audit: unable to resolve repository root"
            MISSING_INPUT: sview = "jsonl file audit: missing "
            READ_FAILED: sview = "jsonl file audit: unable to read source: "
            SUCCESS: sview = "jsonl file audit: bounded FileStream ownership and one-document chunk feeding are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def adapter_contracts(adapter: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: adapter, pattern: Patterns::MODULE},
                SearchCheck{input: adapter, pattern: Patterns::USING_PARSER},
                SearchCheck{input: adapter, pattern: Patterns::USING_RUNTIME},
                SearchCheck{input: adapter, pattern: Patterns::CHUNK_BYTES},
                SearchCheck{input: adapter, pattern: Patterns::MAX_INPUT},
                SearchCheck{input: adapter, pattern: Patterns::READER_STATE},
                SearchCheck{input: adapter, pattern: Patterns::READER},
                SearchCheck{input: adapter, pattern: Patterns::ACTION},
                SearchCheck{input: adapter, pattern: Patterns::ERROR},
                SearchCheck{input: adapter, pattern: Patterns::MACHINE},
                SearchCheck{input: adapter, pattern: Patterns::READ_CAPACITY},
                SearchCheck{input: adapter, pattern: Patterns::STATE_VALID},
                SearchCheck{input: adapter, pattern: Patterns::BEGIN_READER},
                SearchCheck{input: adapter, pattern: Patterns::NEXT_DOCUMENT},
                SearchCheck{input: adapter, pattern: Patterns::CLOSE_READER},
                SearchCheck{input: adapter, pattern: Patterns::EFFECTIVE_FRAMING},
                SearchCheck{input: adapter, pattern: Patterns::FILE_OPEN},
                SearchCheck{input: adapter, pattern: Patterns::READ_CHUNK},
                SearchCheck{input: adapter, pattern: Patterns::FEED_CHUNK},
                SearchCheck{input: adapter, pattern: Patterns::FEED_EOF},
                SearchCheck{input: adapter, pattern: Patterns::FILE_STREAM_LIMIT},
                SearchCheck{input: adapter, pattern: Patterns::INPUT_LIMIT_ERROR},
                SearchCheck{input: adapter, pattern: Patterns::CLEANUP_COMMIT},
                SearchCheck{input: adapter, pattern: Patterns::CLEANUP_ABORT}
            ]


        def downstream_checks(fixture: Path, docs: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_BOUNDED_CHUNKS},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_READS_AND_CLOSES},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_LIMIT_PROBE},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_THIRD_DOCUMENT},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_BUFFER_PROGRESS},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_EXACT_LIMIT},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_OVERFLOW_LIMIT},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_OVERFLOW_VALID},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_CHUNK_SIZE},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_MAX_INPUT},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_FAILED_NOT_CLOSED},
                SearchCheck{input: docs, pattern: Patterns::DOCS_BEGIN},
                SearchCheck{input: docs, pattern: Patterns::DOCS_CLOSE}
            ]


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


        def has_forbidden_line_read(path: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic]:
            catch EsSourceFunctionScope::contains_file_regex_line(path, Patterns::FORBIDDEN_LINE_READ):
                ok found:
                    return ExitStatus::FAILURE if found
                    return 0i64
                error _:
                    return ExitStatus.FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::ADAPTER),
                root.joinpath(Inputs::PARSER),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            for check in adapter_contracts(inputs[0]):
                status: i64 = has_line(check.input, check.pattern)
                return status if status != 0i64

            status: i64 = has_line(inputs[2], Patterns::IR_IMPORT)
            return status if status != 0i64
            status <- has_forbidden_line_read(inputs[0])
            return status if status != 0i64

            for check in downstream_checks(inputs[3], inputs[4]):
                status <- has_line(check.input, check.pattern)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsJsonLinesFileAudit::run_default()
