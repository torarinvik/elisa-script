# Bounded Elisascript port of check_csv_model.sh.
# The shell version remains the reference until public-launcher parity is
# qualified. This candidate reads repository source as data and starts no
# child processes.

include "../src/runtime/bounded_text_posix.elisa"

using EsBoundedText


module EsCsvAudit:
    private:
        const module Limits:
            SOURCE_BYTES: usize = 16777216
            TOTAL_SOURCE_BYTES: usize = 33554432


        const module Inputs:
            MODEL: sview = "src/runtime/csv_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            RUNTIME_FIXTURE: sview = "test/runtime/csv_empty_input_test.elisa"
            DOCS: sview = "docs/ir.md"
            PARSER: sview = "src/runtime/csv_parser_model.elisa"
            ENCODER: sview = "src/runtime/csv_encode_model.elisa"
            FRAMER: sview = "src/runtime/csv_record_framer_model.elisa"
            FILE_READER: sview = "src/runtime/csv_record_file_posix.elisa"
            SCHEMA_CSV: sview = "src/runtime/schema_csv_materializer.elisa"
            SCHEMA_FILE_READER: sview = "src/runtime/schema_csv_file_posix.elisa"


        const module Diagnostics:
            MISSING_ROOT: sview = "csv model audit: missing repository root"
            MISSING_PREFIX: sview = "csv model audit: missing "
            TOO_LARGE_PREFIX: sview = "csv model audit: source exceeds audit limit: "
            CHANGED_PREFIX: sview = "csv model audit: source changed during audit: "
            READ_FAILED_PREFIX: sview = "csv model audit: unable to read source: "
            EMPTY_RECORD_GUARD: sview = "csv model audit: zero-field blank records were incorrectly rejected"
            SUCCESS: sview = "csv model audit: bounded POSIX CSV reading, schema-aware row streaming, chunk framing, and record encoding are present"


        const module ModelDeclarations:
            MODULE: sview = "module EsCsv:"
            DATA: sview = "using EsData"
            LIMITS: sview = "const module Limits:"
            STATE: sview = "const enum CsvStreamState of u8:"
            PENDING_TERMINATOR: sview = "PendingRecordTerminator"
            EVENT: sview = "const enum CsvStreamEvent of u8:"
            STREAM: sview = "struct CsvStream:"
            ERROR: sview = "error CsvContractError:"
            VALIDATE: sview = "def validate_csv_stream("
            ADVANCE: sview = "def advance_csv_stream("


        const module ModelBoundaries:
            RECORDS: sview = "Limits::RECORDS"
            FIELDS: sview = "Limits::FIELDS"
            FIELD_BYTES: sview = "Limits::FIELD_BYTES"
            INPUT_LIMIT: sview = "InputLimitExceeded"
            FIELD_BYTES_LIMIT: sview = "FieldBytesLimitExceeded"
            UNEXPECTED_QUOTE: sview = "UnexpectedQuote"
            AFTER_QUOTE: sview = "UnexpectedCharacterAfterQuote"
            RECORD_TERMINATOR: sview = "InvalidRecordTerminator"
            UNEXPECTED_END: sview = "UnexpectedEnd"
            ACCOUNTING: sview = "AccountingInvalid"
            CANCELLED: sview = "Cancelled"
            FIELD_STARTED: sview = "field_started"
            EMPTY_RECORD: sview = "stream.fields_in_record == 0 and stream.field_bytes == 0 and not stream.field_started"
            RECORD_GUARD: sview = "raise CsvContractError.RecordLimitExceeded if stream.records >= stream.limits.records"
            INVALID_EMPTY_RECORD_GUARD: sview = "stream.fields_total < stream.records"


        const module IrPatterns:
            CSV_INCLUDE: sview = "include \"../runtime/csv_model.elisa\""
            FRAMER_INCLUDE: sview = "include \"../runtime/csv_record_framer_model.elisa\""
            FILE_READER_INCLUDE: sview = "include \"../runtime/csv_record_file_posix.elisa\""
            SCHEMA_FILE_READER_INCLUDE: sview = "include \"../runtime/schema_csv_file_posix.elisa\""


        const module FixturePatterns:
            QUOTES_AND_ROWS: sview = "typed_csv_stream_contract_preserves_quotes_and_bounded_rows"
            LINE_ENDINGS: sview = "typed_csv_stream_handles_explicit_line_ending_modes"
            CRLF: sview = "CsvLineEndingMode.CrLf"
            PENDING_TERMINATOR: sview = "CsvStreamState.PendingRecordTerminator"
            BYTE_EVENT: sview = "CsvStreamEvent.Byte"
            UNEXPECTED_END: sview = "CsvContractError.UnexpectedEnd"
            LIMITED_FIELDS: sview = "assert limited.fields_total == 1"
            BYTE_REJECTED: sview = "assert byte_rejected.input_bytes == 1"


        const module RuntimeFixturePatterns:
            EMPTY_SHAPE: sview = "csv_empty_input_and_blank_records_match_python_shape"
            EMPTY_STREAM: sview = "empty_stream.records == 0"
            BLANK_RECORD: sview = "blank_record_stream.records == 1 and blank_record_stream.fields_total == 0"
            QUOTED_EMPTY: sview = "quoted_empty_stream.records == 1 and quoted_empty_stream.fields_total == 1"
            MIXED: sview = "mixed_stream.records == 3 and mixed_stream.fields_total == 2"
            SOURCE_PARSER: sview = "csv_source_parser_materializes_quoted_fields_blank_rows_and_crlf"
            PARSED_COUNTS: sview = "parsed.records.count == 3 and parsed.fields.count == 4"
            MALFORMED_QUOTE: sview = "assert failure == CsvContractError.UnexpectedQuote"


        const module ParserPatterns:
            MODULE: sview = "module EsCsvParser:"
            PARSE: sview = "def parse_csv_materializer("
            STREAM_BYTE: sview = "advance_csv_stream(stream, CsvStreamEvent.Byte, byte)"
            CRLF_STATE: sview = "CsvStreamState.PendingRecordTerminator"
            END_FLUSH: sview = "stream.records > previous_records"
            FIELD_RECONCILIATION: sview = "materializer.fields.count != stream.fields_total"
            RECORD_RECONCILIATION: sview = "materializer.records.count != stream.records"


        const module EncoderPatterns:
            MODULE: sview = "module EsCsvEncode:"
            PHASE: sview = "const enum CsvEncodePhase of u8:"
            OUTPUT_LIMIT: sview = "OutputLimitExceeded"
            ENCODE: sview = "def encode_csv_record("
            TERMINATOR: sview = "csv_policy_record_terminator_width(policy)"


        const module EncoderFixturePatterns:
            ROUND_TRIP: sview = "csv_record_encoder_preserves_cells_under_explicit_dialects"
            EMPTY_FIELD: sview = "one_empty_field"
            CUSTOM_ESCAPE: sview = "custom_escape"
            EXACT_LIMIT: sview = "exact_limit"
            OVER_LIMIT: sview = "over_limit_rejected"


        const module FramerPatterns:
            MODULE: sview = "module EsCsvRecordFramer:"
            CHUNK_LIMIT: sview = "CSV_RECORD_FRAMER_MAX_CHUNK_BYTES"
            BEGIN: sview = "def begin_csv_record_framer("
            FEED: sview = "def feed_csv_record_framer("
            FINISH: sview = "def finish_csv_record_framer("
            BYTE_EVENT: sview = "CsvStreamEvent.Byte"


        const module FramerFixturePatterns:
            CHUNK_ROUND_TRIP: sview = "csv_record_framer_preserves_quoted_content_and_split_crlf"
            EMPTY_PREFIX: sview = "first_chunk.count == 0"
            CRLF_COMPLETES: sview = "third_chunk.count == 1"
            EOF_COMPLETES: sview = "final_chunk.count == 1"
            BLANK_ROW: sview = "blank_materialized.records[0].field_count == 0"
            RECORD_LIMIT: sview = "record_limit_rejected"
            FAILS_CLOSED: sview = "malformed_framer.state == CsvRecordFramerState.Failed"


        const module FileReaderPatterns:
            MODULE: sview = "module EsCsvRecordFilePosix:"
            CSV_NAMESPACE: sview = "using EsCsv"
            CHUNK_LIMIT: sview = "CSV_RECORD_FILE_CHUNK_BYTES"
            BEGIN: sview = "def begin_csv_record_file_reader("
            NEXT: sview = "def next_csv_record_file("
            CLOSE: sview = "def close_csv_record_file_reader("
            PROBE_BUDGET: sview = "FILE_STREAM_DEFAULT_MAX_BYTES - 1"
            PROBE_BRANCH: sview = "if reader.source_bytes_read == input_limit:"
            PROBE_SIZE: sview = "return 1"
            BYTE_BUDGET: sview = "input_limit + 1"
            READ_CHUNK: sview = "file_stream_read_chunk(reader.file, buffer, capacity)"
            EOF_FLUSH: sview = "reader.pending_records <- try finish_csv_record_framer(reader.framer)"
            INPUT_LIMIT: sview = "InputLimitExceeded"


        const module FileReaderFixturePatterns:
            STREAMS_ROWS: sview = "csv_record_file_reader_streams_rows_and_rejects_over_limit_input"
            NAMESPACE: sview = "using EsCsvRecordFilePosix"
            EMPTY_INPUT: sview = "not empty_result.has_record and empty_result.bytes.count == 0"
            SPLIT_CRLF: sview = "first.bytes.count == CSV_RECORD_FILE_CHUNK_BYTES + 1"
            FINAL_EOF_ROW: sview = "second.has_record and bytes_view(second.bytes)"
            EXACT_LIMIT: sview = "exact_row.has_record"
            INPUT_LIMIT: sview = "CsvRecordFileError.InputLimitExceeded"


        const module SchemaCsvPatterns:
            MODULE: sview = "module EsSchemaCsv:"
            PROJECTION: sview = "struct SchemaCsvProjection:"
            PREPARE: sview = "def prepare_csv_schema_projection("
            MATERIALIZE: sview = "def materialize_csv_schema_record_with_projection("
            INVALID: sview = "InvalidProjection"


        const module SchemaFileReaderPatterns:
            MODULE: sview = "module EsSchemaCsvFilePosix:"
            NAMESPACE: sview = "using EsSchemaCsv"
            STRUCT: sview = "struct SchemaCsvFileReader:"
            BEGIN: sview = "def begin_schema_csv_file_reader("
            NEXT: sview = "def next_schema_csv_file_record("
            CLOSE: sview = "def close_schema_csv_file_reader("
            PREPARED: sview = "reader.projection <- projection"
            REUSE: sview = "materialize_csv_schema_record_with_projection"


        const module SchemaFileFixturePatterns:
            TEST: sview = "schema_csv_file_reader_streams_header_mapped_typed_rows"
            NAMESPACE: sview = "using EsSchemaCsvFilePosix"
            FIRST_ORDINAL: sview = "first.record.row_ordinal == 0"
            SECOND_ORDINAL: sview = "second.record.row_ordinal == 1"
            SOURCE_ALIAS: sview = "source_name: \"name\""
            INTEGER: sview = "SchemaCsvValueKind.Integer"
            DUPLICATE_HEADER: sview = "SchemaCsvMaterializeError.DuplicateHeader"


        error AuditReadError:
            Missing
            LimitExceeded
            Changed
            ReadFailed


        def display_path(root: sview, relative: sview) -> sview:
            return "/" + relative if root == "/"
            return root + "/" + relative


        def write_diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def contains_all(source: sview, required: darray[sview]) -> bool:
            for needle in required:
                return false if source.index(needle) < 0
            return true


        def read_source(input_path: Path, expected_size: usize) -> sview error[AuditReadError] can[Memory.Allocate, Abort.Panic, Blocking.IO, File.Read, Unsafe.PointerCast]:
            current_size: usize = try file_size(input_path) else err:
                raise AuditReadError.Missing
            raise AuditReadError.LimitExceeded if current_size > expected_size or current_size > Limits::SOURCE_BYTES
            raise AuditReadError.Changed if current_size < expected_size
            source: mutable sview = ""
            catch EsBoundedText::read_utf8(input_path, expected_size):
                ok contents:
                    source <- contents
                error failure:
                    if failure == EsBoundedText::ReadError.LimitExceeded:
                        raise AuditReadError.LimitExceeded
                    if failure == EsBoundedText::ReadError.Changed:
                        raise AuditReadError.Changed
                    raise AuditReadError.ReadFailed
            raise AuditReadError.LimitExceeded if len(source) > expected_size or len(source) > Limits::SOURCE_BYTES
            raise AuditReadError.Changed if len(source) != expected_size
            return source


    public:
        def run(repository_root: Path) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Blocking.IO, Directory.Read, File.Read, Unsafe.PointerCast]:
            if not is_directory(repository_root):
                write_diagnostic(Diagnostics::MISSING_ROOT)
                return 1i64
            root_absolute: Path = try path_real(path_absolute(repository_root)) else err:
                write_diagnostic(Diagnostics::MISSING_ROOT)
                return 1i64
            root_text: sview = f"{root_absolute}"
            relative_paths: darray[sview] = [Inputs::MODEL, Inputs::IR, Inputs::FIXTURE, Inputs::RUNTIME_FIXTURE, Inputs::DOCS, Inputs::PARSER, Inputs::ENCODER, Inputs::FRAMER, Inputs::FILE_READER, Inputs::SCHEMA_CSV, Inputs::SCHEMA_FILE_READER]
            source_sizes: mutable darray[usize] = []
            sources: mutable darray[sview] = []
            total_bytes: mutable usize = 0

            # Match the shell audit's first pass: report missing inputs before
            # rejecting the aggregate source budget.
            for relative in relative_paths |relative_paths, root_absolute, root_text|:
                input_path: Path = path_join(root_absolute, relative)
                if not is_file(input_path) or not is_readable(input_path):
                    write_diagnostic(Diagnostics::MISSING_PREFIX + display_path(root_text, relative))
                    return 1i64

            for relative in relative_paths |relative_paths, root_absolute, root_text, source_sizes, total_bytes|:
                input_path: Path = path_join(root_absolute, relative)
                input_display: sview = display_path(root_text, relative)
                source_size: usize = try file_size(input_path) else err:
                    write_diagnostic(Diagnostics::MISSING_PREFIX + input_display)
                    return 1i64
                if source_size > Limits::SOURCE_BYTES or source_size > Limits::TOTAL_SOURCE_BYTES - total_bytes:
                    write_diagnostic(Diagnostics::TOO_LARGE_PREFIX + input_display)
                    return 2i64
                total_bytes <- total_bytes + source_size
                source_sizes.push(source_size)

            for relative in relative_paths |relative_paths, root_absolute, root_text, source_sizes, sources|:
                input_path: Path = path_join(root_absolute, relative)
                input_display: sview = display_path(root_text, relative)
                source_index: usize = sources.count
                catch read_source(input_path, source_sizes[source_index]):
                    ok source:
                        sources.push(source)
                    error failure:
                        if failure == AuditReadError.Missing:
                            write_diagnostic(Diagnostics::MISSING_PREFIX + input_display)
                            return 1i64
                        if failure == AuditReadError.LimitExceeded:
                            write_diagnostic(Diagnostics::TOO_LARGE_PREFIX + input_display)
                            return 2i64
                        if failure == AuditReadError.Changed:
                            write_diagnostic(Diagnostics::CHANGED_PREFIX + input_display)
                            return 2i64
                        write_diagnostic(Diagnostics::READ_FAILED_PREFIX + input_display)
                        return 2i64

            model: sview = sources[0]
            ir: sview = sources[1]
            fixture: sview = sources[2]
            runtime_fixture: sview = sources[3]
            docs: sview = sources[4]
            parser: sview = sources[5]
            encoder: sview = sources[6]
            framer: sview = sources[7]
            file_reader: sview = sources[8]
            schema_csv: sview = sources[9]
            schema_file_reader: sview = sources[10]
            declarations: darray[sview] = [ModelDeclarations::MODULE, ModelDeclarations::DATA, ModelDeclarations::LIMITS, ModelDeclarations::STATE, ModelDeclarations::PENDING_TERMINATOR, ModelDeclarations::EVENT, ModelDeclarations::STREAM, ModelDeclarations::ERROR, ModelDeclarations::VALIDATE, ModelDeclarations::ADVANCE]
            boundaries: darray[sview] = [ModelBoundaries::RECORDS, ModelBoundaries::FIELDS, ModelBoundaries::FIELD_BYTES, ModelBoundaries::INPUT_LIMIT, ModelBoundaries::FIELD_BYTES_LIMIT, ModelBoundaries::UNEXPECTED_QUOTE, ModelBoundaries::AFTER_QUOTE, ModelBoundaries::RECORD_TERMINATOR, ModelBoundaries::UNEXPECTED_END, ModelBoundaries::ACCOUNTING, ModelBoundaries::CANCELLED, ModelBoundaries::FIELD_STARTED, ModelBoundaries::EMPTY_RECORD, ModelBoundaries::RECORD_GUARD]
            fixture_patterns: darray[sview] = [FixturePatterns::QUOTES_AND_ROWS, FixturePatterns::LINE_ENDINGS, FixturePatterns::CRLF, FixturePatterns::PENDING_TERMINATOR, FixturePatterns::BYTE_EVENT, FixturePatterns::UNEXPECTED_END, FixturePatterns::LIMITED_FIELDS, FixturePatterns::BYTE_REJECTED]
            runtime_fixture_patterns: darray[sview] = [RuntimeFixturePatterns::EMPTY_SHAPE, RuntimeFixturePatterns::EMPTY_STREAM, RuntimeFixturePatterns::BLANK_RECORD, RuntimeFixturePatterns::QUOTED_EMPTY, RuntimeFixturePatterns::MIXED, RuntimeFixturePatterns::SOURCE_PARSER, RuntimeFixturePatterns::PARSED_COUNTS, RuntimeFixturePatterns::MALFORMED_QUOTE]
            parser_patterns: darray[sview] = [ParserPatterns::MODULE, ParserPatterns::PARSE, ParserPatterns::STREAM_BYTE, ParserPatterns::CRLF_STATE, ParserPatterns::END_FLUSH, ParserPatterns::FIELD_RECONCILIATION, ParserPatterns::RECORD_RECONCILIATION]
            encoder_patterns: darray[sview] = [EncoderPatterns::MODULE, EncoderPatterns::PHASE, EncoderPatterns::OUTPUT_LIMIT, EncoderPatterns::ENCODE, EncoderPatterns::TERMINATOR]
            encoder_fixture_patterns: darray[sview] = [EncoderFixturePatterns::ROUND_TRIP, EncoderFixturePatterns::EMPTY_FIELD, EncoderFixturePatterns::CUSTOM_ESCAPE, EncoderFixturePatterns::EXACT_LIMIT, EncoderFixturePatterns::OVER_LIMIT]
            framer_patterns: darray[sview] = [FramerPatterns::MODULE, FramerPatterns::CHUNK_LIMIT, FramerPatterns::BEGIN, FramerPatterns::FEED, FramerPatterns::FINISH, FramerPatterns::BYTE_EVENT]
            framer_fixture_patterns: darray[sview] = [FramerFixturePatterns::CHUNK_ROUND_TRIP, FramerFixturePatterns::EMPTY_PREFIX, FramerFixturePatterns::CRLF_COMPLETES, FramerFixturePatterns::EOF_COMPLETES, FramerFixturePatterns::BLANK_ROW, FramerFixturePatterns::RECORD_LIMIT, FramerFixturePatterns::FAILS_CLOSED]
            file_reader_patterns: darray[sview] = [FileReaderPatterns::MODULE, FileReaderPatterns::CSV_NAMESPACE, FileReaderPatterns::CHUNK_LIMIT, FileReaderPatterns::BEGIN, FileReaderPatterns::NEXT, FileReaderPatterns::CLOSE, FileReaderPatterns::PROBE_BUDGET, FileReaderPatterns::PROBE_BRANCH, FileReaderPatterns::PROBE_SIZE, FileReaderPatterns::BYTE_BUDGET, FileReaderPatterns::READ_CHUNK, FileReaderPatterns::EOF_FLUSH, FileReaderPatterns::INPUT_LIMIT]
            file_reader_fixture_patterns: darray[sview] = [FileReaderFixturePatterns::STREAMS_ROWS, FileReaderFixturePatterns::NAMESPACE, FileReaderFixturePatterns::EMPTY_INPUT, FileReaderFixturePatterns::SPLIT_CRLF, FileReaderFixturePatterns::FINAL_EOF_ROW, FileReaderFixturePatterns::EXACT_LIMIT, FileReaderFixturePatterns::INPUT_LIMIT]
            schema_csv_patterns: darray[sview] = [SchemaCsvPatterns::MODULE, SchemaCsvPatterns::PROJECTION, SchemaCsvPatterns::PREPARE, SchemaCsvPatterns::MATERIALIZE, SchemaCsvPatterns::INVALID]
            schema_file_reader_patterns: darray[sview] = [SchemaFileReaderPatterns::MODULE, SchemaFileReaderPatterns::NAMESPACE, SchemaFileReaderPatterns::STRUCT, SchemaFileReaderPatterns::BEGIN, SchemaFileReaderPatterns::NEXT, SchemaFileReaderPatterns::CLOSE, SchemaFileReaderPatterns::PREPARED, SchemaFileReaderPatterns::REUSE]
            schema_file_fixture_patterns: darray[sview] = [SchemaFileFixturePatterns::TEST, SchemaFileFixturePatterns::NAMESPACE, SchemaFileFixturePatterns::FIRST_ORDINAL, SchemaFileFixturePatterns::SECOND_ORDINAL, SchemaFileFixturePatterns::SOURCE_ALIAS, SchemaFileFixturePatterns::INTEGER, SchemaFileFixturePatterns::DUPLICATE_HEADER]

            return 1i64 if not contains_all(model, declarations)
            return 1i64 if not contains_all(model, boundaries)
            if model.index(ModelBoundaries::INVALID_EMPTY_RECORD_GUARD) >= 0:
                write_diagnostic(Diagnostics::EMPTY_RECORD_GUARD)
                return 1i64
            return 1i64 if ir.index(IrPatterns::CSV_INCLUDE) < 0
            return 1i64 if ir.index(IrPatterns::FRAMER_INCLUDE) < 0
            return 1i64 if ir.index(IrPatterns::FILE_READER_INCLUDE) < 0
            return 1i64 if ir.index(IrPatterns::SCHEMA_FILE_READER_INCLUDE) < 0
            return 1i64 if not contains_all(fixture, fixture_patterns)
            return 1i64 if not contains_all(runtime_fixture, runtime_fixture_patterns)
            return 1i64 if docs.index("`EsCsv`") < 0
            return 1i64 if docs.index("`EsCsvParser::parse_csv_materializer`") < 0
            return 1i64 if not contains_all(parser, parser_patterns)
            return 1i64 if not contains_all(encoder, encoder_patterns)
            return 1i64 if not contains_all(runtime_fixture, encoder_fixture_patterns)
            return 1i64 if docs.index("`EsCsvEncode::encode_csv_record`") < 0
            return 1i64 if not contains_all(framer, framer_patterns)
            return 1i64 if not contains_all(runtime_fixture, framer_fixture_patterns)
            return 1i64 if docs.index("`EsCsvRecordFramer::feed_csv_record_framer`") < 0
            return 1i64 if not contains_all(file_reader, file_reader_patterns)
            return 1i64 if not contains_all(runtime_fixture, file_reader_fixture_patterns)
            return 1i64 if docs.index("`EsCsvRecordFilePosix::next_csv_record_file`") < 0
            return 1i64 if docs.index("`EsSchemaCsv::prepare_csv_schema_projection`") < 0
            return 1i64 if docs.index("`EsSchemaCsvFilePosix::next_schema_csv_file_record`") < 0
            return 1i64 if not contains_all(schema_csv, schema_csv_patterns)
            return 1i64 if not contains_all(schema_file_reader, schema_file_reader_patterns)
            return 1i64 if not contains_all(runtime_fixture, schema_file_fixture_patterns)

            print(Diagnostics::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Blocking.IO, Directory.Read, File.Read, Unsafe.PointerCast]:
            script_path: Path = Script::source_path()
            script_directory: Path = try path_real(path_absolute(script_path.parent())) else err:
                write_diagnostic(Diagnostics::MISSING_ROOT)
                return 1i64
            return run(script_directory.parent())


def main(arguments: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Blocking.IO, Directory.Read, File.Read, Unsafe.PointerCast]:
    return EsCsvAudit::run_default()
