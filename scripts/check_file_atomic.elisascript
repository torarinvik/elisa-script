# Bounded Elisascript port of check_file_atomic.sh.
# It audits the atomic-file model, POSIX adapter, fixtures, and capability docs.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsFileAtomicAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/file_atomic_model.elisa"
            ADAPTER: sview = "src/runtime/file_atomic_posix.elisa"
            IR: sview = "src/ir/ir.elisa"
            IR_FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            RUNTIME_FIXTURE: sview = "test/runtime/file_atomic_model_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            ADAPTER_LEASE_COLLISION: sview = "LeaseNameCollision if atomic_file_posix_path_leaf_matches(session.plan.staging_path, lock_leaf)"
            ADAPTER_LEASE_COLLISION_BACKUP: sview = "session.plan.backup_path, lock_leaf"
            ADAPTER_UNCERTAIN_CLEANUP: sview = "cleanup_state: bool = "
            ADAPTER_UNCERTAIN_STATE: sview = "AtomicFileState.PublishedUncertain"
            ADAPTER_APPEND_DECLARATION: sview = "def append_atomic_file_stage(session: mutable AtomicFileSession&, parent_fd: int, stage_handle: AtomicFilePosixStageHandle&"
            ADAPTER_SEAL_DECLARATION: sview = "def seal_atomic_file_stage(a: mutable Arena&, session: mutable AtomicFileSession&, parent_fd: int, stage_handle: mutable AtomicFilePosixStageHandle&"
            ADAPTER_UNSEALED_CLEANUP_DECLARATION: sview = "def cleanup_unsealed_atomic_file_stage(session: mutable AtomicFileSession&, parent_fd: int, stage_handle: mutable AtomicFilePosixStageHandle&"
            MODEL_MODULE: sview = "module EsFileAtomic:"
            ADAPTER_MODULE: sview = "module EsFileAtomicPosix:"
            MODEL_INCLUDE: sview = "include \"../runtime/file_atomic_model.elisa\""
            ADAPTER_INCLUDE: sview = "include \"../runtime/file_atomic_posix.elisa\""
            LEASE_REQUIRED: sview = "DirectoryLeaseRequired"
            REQUIRE_DIRECTORY_LEASE: sview = "def atomic_file_posix_require_directory_lease("
            OBSERVE: sview = "def observe_atomic_file_at("
            BEGIN_STAGE: sview = "def begin_atomic_file_stage("
            CREATE_STAGE: sview = "def create_atomic_file_stage("
            STAGE_OPENAT: sview = "elisascript_posix_openat(parent_fd, stage_leaf, create_flags, 384u32)"
            STAGE_DESCRIPTOR_NEGATIVE: sview = "stage_fd < 0"
            STAGE_CREATE_FAILED: sview = "StageCreateFailed(stage_leaf, errno[0])"
            STAGE_CREATE_UNKNOWN: sview = "StageCreateOutcomeUnknown(stage_leaf, errno[0])"
            CLOSE_STAGE: sview = "elisascript_posix_close(stage_fd)"
            DESCRIPTOR_CLEARED: sview = "stage_handle.descriptor <- -1"
            CLOSE_STATUS_SAVED: sview = "stage_handle.close_status <- close_status"
            ADMISSION_UNCERTAIN: sview = "StageAdmissionUncertain(stage_leaf, stage_fd, close_status)"
            STAGE_HANDLE: sview = "AtomicFilePosixStageHandle"
            SESSION_PLANNED: sview = "session.state != AtomicFileState.Planned"
            BEGIN_EVENT: sview = "AtomicFileEvent.Begin"
            CAPTURE_ADMISSION: sview = "capture_atomic_file_stage_proof(parent_fd, stage_fd, stage_leaf, session.plan.owner_token)"
            STAGE_ADMISSION_MODEL: sview = "stage_admission: AtomicFileStageAdmission"
            ADMISSION_VALID: sview = "atomic_file_stage_admission_valid(stage_admission, session.plan)"
            ADMISSION_SAVED: sview = "session.stage_admission <- stage_admission"
            SESSION_ADMISSION_MATCH: sview = "atomic_file_posix_session_stage_admission_matches(session, expected)"
            SESSION_IDENTITY_MATCH: sview = "atomic_file_posix_session_stage_identity_matches(session)"
            REJECT_ADMISSION_MISMATCH: sview = "not atomic_file_posix_session_stage_admission_matches(session, expected)"
            BYTES_EQUAL_AT: sview = "def atomic_file_bytes_equal_at("
            BYTES_EQUAL: sview = "atomic_file_posix_bytes_equal(observed, expected)"
            BYTE_MISMATCH: sview = "left[index] != right[index]"
            DEVICE_MISMATCH: sview = "parent_info.device != stage_info.device"
            PARENT_STABLE: sview = "parent_matches(parent_info, parent_after)"
            STAGE_IDENTITY_CHANGED: sview = "StageIdentityChanged if not atomic_file_posix_same_inode(stage_info, stage_after)"
            WRITE_BOUND: sview = "WRITE_CALLS: usize = 1048576"
            OWNER_TOKEN: sview = "session.plan.owner_token"
            PARENT_TOKEN_MISMATCH: sview = "expected.parent_descriptor_token != session.plan.parent_identity"
            WRITE_FULLY: sview = "atomic_file_posix_write_fully(stage_fd, bytes.items, bytes.count)"
            APPEND_EVENT: sview = "AtomicFileEvent.Append, appended_bytes: written"
            FAIL_SESSION: sview = "atomic_file_posix_fail_session(session)"
            FSYNC: sview = "elisascript_posix_fsync(fd)"
            READY_EVENT: sview = "AtomicFileEvent.StageReady, identity: staged"
            STAGE_INODE_MISMATCH: sview = "staged.object_id != expected.stage_inode"
            LINK_COUNT: sview = "link_count: usize"
            PRIVATE_MODE: sview = "private_mode: bool"
            PRIVATE_SINGLE_LINK: sview = "snapshot.link_count != 1 or not snapshot.private_mode"
            COMPARE_STAGE: sview = "def compare_atomic_file_stage("
            INVALID_LEAF: sview = "InvalidLeafName if not elisascript_posix_leaf_name_valid(stage_leaf)"
            COMPARE_EVENT: sview = "AtomicFileEvent.Compare, identity: destination_after.destination"
            IDENTITY_EQUAL: sview = "atomic_file_posix_identity_equal(destination_before.destination, destination_after.destination)"
            STAGE_CONTENT_MATCHES: sview = "stage_content_matches"
            SCRATCH_MARK: sview = "scratch_mark: ArenaMark = arena_snapshot(a)"
            ARENA_REWIND: sview = "arena_rewind(a, scratch_mark)"
            BOUNDED_OBSERVE: sview = "observe_atomic_file_at(a, parent_fd, destination_leaf, EsFileReadAtPosix::Limits::MAX_BYTES)"
            COMMIT_STAGE: sview = "def commit_atomic_file_stage("
            COMMIT_EVENT: sview = "advance_atomic_file(session, AtomicFileEvent.Commit)"
            RENAME_STAGE: sview = "elisascript_posix_renameat(parent_fd, stage_leaf, parent_fd, destination_leaf)"
            MARK_UNCERTAIN: sview = "atomic_file_posix_mark_publish_uncertain(session)"
            DIRECTORY_SYNC_EVENT: sview = "advance_atomic_file(session, AtomicFileEvent.DirectorySync)"
            COMMIT_ACK: sview = "AtomicFileEvent.CommitAck, identity: published"
            PUBLISHED_IDENTITY: sview = "atomic_file_posix_identity_equal(published, session.staged_identity)"
            PUBLISHED_PRIVATE: sview = "published_observation.link_count != 1 or not published_observation.private_mode"
            CLEANUP_UNSEALED: sview = "def cleanup_unsealed_atomic_file_stage("
            CLEANUP_CLOSED: sview = "def atomic_file_posix_cleanup_closed_unsealed_stage("
            CLOSED_STAGE_BRANCH: sview = "if stage_fd < 0:"
            RETURN_CLOSED_CLEANUP: sview = "return try atomic_file_posix_cleanup_closed_unsealed_stage(session, parent_fd, expected, stage_leaf, directory_lease, lock_leaf)"
            RECONCILE: sview = "def reconcile_atomic_file_publication("
            RESOLVE_PUBLISHED: sview = "AtomicFileEvent.ResolvePublished"
            RESOLVE_NOT_PUBLISHED: sview = "AtomicFileEvent.ResolveNotPublished"
            PUBLICATION_UNCERTAIN: sview = "PublicationStillUncertain"
            NOT_PUBLISHED_PATTERN: sview = "not_published_pattern: bool"
            FINAL_NOT_PUBLISHED: sview = "AtomicFileEvent.ResolveNotPublished, identity: not_published_destination_final.destination"
            FIXTURE_DIRECTORY_LEASE: sview = "AtomicFilePosixError.DirectoryLeaseRequired"
            FIXTURE_LEASE_COLLISION: sview = "AtomicFilePosixError.LeaseNameCollision"
            FIXTURE_BACKUP_COLLISION: sview = "backup_lock_collision_rejected"
            FIXTURE_UNCLEAN_STATES: sview = "session.state == AtomicFileState.FailedPendingCleanup or session.state == AtomicFileState.CancelledPendingCleanup"
            FIXTURE_OBSERVED_OR_PARENT: sview = "session.staged_identity.observed or parent_fd < 0"
            STAGE_TOKEN_EXPECTED: sview = "expected.stage_descriptor_token != stage_fd.u64() + 1u64"
            STAT_DESCRIPTOR: sview = "atomic_file_posix_stat_descriptor(stage_fd, stage_descriptor_before)"
            SAME_INODE: sview = "atomic_file_posix_same_inode(stage_descriptor_before, stage_before)"
            DESCRIPTOR_LINK_COUNT: sview = "stage_descriptor_before.link_count != 1u16"
            STAGE_DEVICE_INODE: sview = "stage_before.device.u64() != expected.stage_device or stage_before.inode != expected.stage_inode"
            STAGE_AGAIN: sview = "stage_again: mutable ElisascriptStat"
            CLEANUP: sview = "def cleanup_atomic_file_stage("
            SYNC_CLEANUP: sview = "def atomic_file_posix_sync_cleanup_directory(session: AtomicFileSession&, parent_fd: int)"
            SYNC_CLEANUP_CALL: sview = "atomic_file_posix_sync_cleanup_directory(session, parent_fd)"
            UNCHANGED_PENDING: sview = "session.state == AtomicFileState.UnchangedPendingCleanup"
            PUBLISHED_UNCERTAIN: sview = "session.state == AtomicFileState.PublishedUncertain"
            INVALID_EXPECTED: sview = "expected.stage_descriptor_token == 0 or expected.link_count != 1"
            STAGE_NOT_PRIVATE: sview = "stage_before.link_count != 1 or not stage_before.private_mode"
            STAGE_STAT_INVALID: sview = "stage_stat.inode != expected.stage_inode or stage_stat.link_count != 1u16 or not atomic_file_posix_private(stage_stat)"
            UNLINK_STAGE: sview = "elisascript_posix_unlinkat_leaf(parent_fd, stage_leaf)"
            CLEANUP_FAILED: sview = "AtomicFilePosixError.StageCleanupFailed if remove_status != 0"
            CLEANUP_ACK: sview = "AtomicFileEvent.CleanupAck"
            READ_REGULAR: sview = "read_regular_file_at(a, parent_fd, leaf_name, byte_limit)"
            HASH_BYTES: sview = "canonical_bytes_sha256(bytes)"
            PARENT_TOKEN: sview = "parent_descriptor_token: u64"
            PARENT_MATCHES: sview = "atomic_file_posix_parent_matches(parent_before, parent_after)"
            ENOENT: sview = "ENOENT: i32 = 2"
            NOFOLLOW: sview = "DarwinAtFlag::SYMLINK_NOFOLLOW"
            OBSERVATION_LIMIT: sview = "before.size.usize() > byte_limit"
            DESTINATION_DEFAULT: sview = "destination <- AtomicFileIdentity"
            USING_HASH: sview = "using EsHash"
            USING_LOCK: sview = "using EsFileLockPosix"
            SESSION_IDENTITY_MATCH_CALL: sview = "atomic_file_posix_session_stage_identity_matches(session)"
            TRAILING_SEPARATOR_PREDICATE: sview = "return sview_at(path, length - 1) != 47"
            FIXTURE_USING: sview = "using EsFileAtomic"
            FIXTURE_NOOP: sview = "typed_file_atomic_contract_preserves_noop_and_uncertain_recovery"
            FIXTURE_DESTINATION_RACE: sview = "destination_race_rejected"
            FIXTURE_RESTORE_PROOF: sview = "restore_proof_rejected"
            FIXTURE_NUL: sview = "embedded_nul"
            FIXTURE_UNCHANGED_COMMIT: sview = "unchanged_commit_rejected"
            FIXTURE_ACK: sview = "CleanupAck"
            FIXTURE_EMPTY_PLAN: sview = "empty_plan"
            FIXTURE_FORGED_READY: sview = "forged_ready"
            FIXTURE_UNCHANGED: sview = "AtomicFileState.Unchanged"
            FIXTURE_PUBLISHED_UNCERTAIN: sview = "AtomicFileState.PublishedUncertain"
            FIXTURE_ROLLED_BACK: sview = "AtomicFileState.RolledBack"
            DOC_SESSION: sview = "EsFileAtomic::AtomicFileSession"
            LEDGER_ID: sview = "ES-FS-007"
            FIXTURE_IRRELEVANT_PAYLOAD: sview = "atomic_file_events_reject_irrelevant_payloads_without_mutation"
            FIXTURE_FILE_ENTRY: sview = "atomic_file_paths_must_name_file_entries"
            FIXTURE_SIBLINGS: sview = "atomic_file_stage_and_backup_must_be_siblings"
            FIXTURE_SYNC_ACK: sview = "atomic_file_commit_ack_requires_directory_sync_receipt"
            FIXTURE_RESTORE_DESTINATION: sview = "atomic_file_restore_requires_a_known_current_destination"
            FIXTURE_INVALID_PARENT: sview = "atomic_file_posix_observation_rejects_invalid_parent"
            FIXTURE_PREFLIGHT: sview = "atomic_file_stage_admission_rejects_invalid_preflight_without_transition"
            FIXTURE_ADMISSION: sview = "atomic_file_begin_retains_valid_stage_admission"
            FIXTURE_APPEND_IDENTITY: sview = "append_identity_rejected"
            FIXTURE_BEGIN_BYTES: sview = "begin_bytes_rejected"
            FIXTURE_PREMATURE_ACK: sview = "premature_ack_rejected"
            FIXTURE_PENDING_CLEANUP: sview = "atomic_file_cleanup_ack_is_pending_only_and_idempotence_is_rejected"
            FIXTURE_DUPLICATE_ACK: sview = "duplicate_ack_rejected"
            FIXTURE_PARTIAL_UNOBSERVED: sview = "assert not partial.staged_identity.observed"


        const module Messages:
            MISSING_ROOT: sview = "file atomic audit: missing repository root"
            UNRESOLVED_ROOT: sview = "file atomic audit: unable to resolve repository root"
            MISSING_INPUT: sview = "file atomic audit: missing "
            READ_FAILED: sview = "file atomic audit: unable to read source: "
            MODEL_MISSING: sview = "file atomic audit: model contract missing: "
            ADAPTER_MISSING: sview = "file atomic audit: POSIX adapter contract missing: "
            FIXTURE_MISSING: sview = "file atomic audit: IR fixture contract missing: "
            RUNTIME_FIXTURE_MISSING: sview = "file atomic audit: runtime fixture contract missing: "
            DOCS_MISSING: sview = "file atomic audit: IR documentation contract missing"
            LEDGER_MISSING: sview = "file atomic audit: capability ledger contract missing"
            LEASE_BOUND_MISSING: sview = "file atomic audit: lease-bound operation contract missing: "
            LEASE_COLLISION_MISSING: sview = "file atomic audit: staging/backup lease collision check missing"
            UNCERTAIN_CLEANUP_PRESENT: sview = "file atomic audit: uncertain publications must be reconciled before cleanup"
            SUCCESS: sview = "file atomic source audit: proof-bound stage admission, transition, compare, commit, sealed and unsealed stage cleanup seams are present; restore, lease integration, and runtime parity remain open"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def require_patterns(input: Path, patterns: darray[sview], message: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for pattern in patterns:
                found: bool = try EsSourceFunctionScope::contains_file_line(input, pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{input}")
                    return ExitStatus::IO_FAILURE
                if not found:
                    diagnostic(message + f"{pattern}")
                    return ExitStatus::FAILURE
            return 0i64


        def require_line_sequence(input: Path, first: sview, second: sview, third: sview, message: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            found: bool = try EsSourceFunctionScope::contains_file_line(input, first, second, third) else err:
                diagnostic(Messages::READ_FAILED + f"{input}")
                return ExitStatus::IO_FAILURE
            if not found:
                diagnostic(message)
                return ExitStatus::FAILURE
            return 0i64


        def require_line_prefix(input: Path, prefix: sview, message: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            found: bool = try EsSourceFunctionScope::contains_file_line(input, prefix, "", "", true) else err:
                diagnostic(Messages::READ_FAILED + f"{input}")
                return ExitStatus::IO_FAILURE
            if not found:
                diagnostic(message + f"{prefix}")
                return ExitStatus::FAILURE
            return 0i64


        def require_lease_bound_operations(adapter: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            operations: darray[sview] = [
                "begin_atomic_file_stage", "create_atomic_file_stage", "append_atomic_file_stage",
                "seal_atomic_file_stage", "compare_atomic_file_stage", "commit_atomic_file_stage",
                "cleanup_unsealed_atomic_file_stage", "cleanup_atomic_file_stage"
            ]
            for operation in operations:
                first: sview = "def " + operation
                found: bool = try EsSourceFunctionScope::contains_file_line(adapter, first, "directory_lease: FileLockPosixLease&", "lock_leaf: cstr") else err:
                    diagnostic(Messages::READ_FAILED + f"{adapter}")
                    return ExitStatus::IO_FAILURE
                if not found:
                    diagnostic(Messages::LEASE_BOUND_MISSING + f"{operation}")
                    return ExitStatus::FAILURE
            return 0i64


        def check_file(input: Path, patterns: darray[sview], message: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            return require_patterns(input, patterns, message)


        def execute_all(inputs: darray[Path]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = require_line_prefix(inputs[0], Patterns::MODEL_MODULE, Messages::MODEL_MISSING)
            return status if status != 0i64
            status <- check_file(inputs[0], [Patterns::USING_HASH,
                "def atomic_file_identity_is_default(",
                "def atomic_file_event_payload_valid(",
                "AtomicFileError.InvalidEventPayload",
                "not atomic_file_event_payload_valid(event, identity, exact_contents_equal, appended_bytes)"], Messages::MODEL_MISSING)
            return status if status != 0i64
            status <- check_file(inputs[0], ["const module Limits:",
                "const enum AtomicFileState of u8",
                "const enum AtomicFileEvent of u8",
                "struct AtomicFileIdentity:",
                "struct AtomicFilePlan:",
                "struct AtomicFileStageAdmission:",
                "struct AtomicFileSession:",
                "error AtomicFileError:",
                "def validate_atomic_file_session(",
                "def advance_atomic_file("], Messages::MODEL_MISSING)
            return status if status != 0i64
            status <- check_file(inputs[0], ["CONTENT_BYTES",
                "OBSERVED_BYTES",
                "APPENDS",
                "expected_destination: AtomicFileIdentity",
                "restore_source_identity: AtomicFileIdentity",
                "volume_id: u64",
                "object_id: u64",
                "owner_token: u64",
                "parent_identity: u64",
                "stage_close_acknowledged: bool",
                "stage_admission: AtomicFileStageAdmission",
                "atomic_file_trim_trailing_separators",
                "atomic_file_paths_share_parent",
                "atomic_file_path_leaf_valid",
                "ParentPathMismatch",
                "atomic_file_identity_equal",
                "AtomicFileState.Unchanged",
                "AtomicFileState.UnchangedPendingCleanup",
                "AtomicFileState.PublishedUncertain",
                "AtomicFileState.RolledBackPendingCleanup",
                "AtomicFileState.RolledBack",
                "AtomicFileState.FailedPendingCleanup",
                "AtomicFileState.CancelledPendingCleanup",
                "AtomicFileEvent.StageReady",
                "AtomicFileEvent.Compare",
                "AtomicFileEvent.PublishUncertain",
                "AtomicFileEvent.ResolvePublished",
                "AtomicFileEvent.ResolveNotPublished",
                "AtomicFileEvent.BeginRestore",
                "AtomicFileEvent.RestoreAck",
                "AtomicFileEvent.CleanupAck",
                "AtomicFileError.DestinationChanged",
                "AtomicFileError.EmbeddedNul",
                "AtomicFileError.RestoreNotProven",
                "AtomicFileError.ReconciliationNotReady",
                "AtomicFileError.ReconciliationNotProven",
                "AtomicFileError.PathCollision",
                "AtomicFileError.ParentInvalid",
                "identity.size != session.staged_bytes",
                "exact_contents_equal",
                "session.contents_equal <- exact_contents_equal",
                "published_identity <- identity",
                "session.state <- AtomicFileState.UnchangedPendingCleanup if session.contents_equal",
                "session.state == AtomicFileState.Committing",
                "session.state == AtomicFileState.PublishedUncertain",
                "session.plan.require_directory_sync and not session.directory_sync_acknowledged",
                "session.state <- AtomicFileState.PublishedUncertain",
                "session.state <- AtomicFileState.Ready",
                "session.directory_sync_acknowledged <- false",
                "session.state <- AtomicFileState.RolledBack",
                Patterns::TRAILING_SEPARATOR_PREDICATE], Messages::MODEL_MISSING)
            return status if status != 0i64
            status <- require_line_sequence(inputs[1], Patterns::ADAPTER_LEASE_COLLISION, Patterns::ADAPTER_LEASE_COLLISION_BACKUP, "", Messages::LEASE_COLLISION_MISSING)
            return status if status != 0i64
            status <- require_lease_bound_operations(inputs[1])
            return status if status != 0i64
            status <- check_file(inputs[1], [Patterns::ADAPTER_MODULE,
                Patterns::USING_LOCK,
                Patterns::LEASE_REQUIRED,
                Patterns::REQUIRE_DIRECTORY_LEASE,
                Patterns::SESSION_IDENTITY_MATCH_CALL,
                Patterns::OBSERVE,
                Patterns::BEGIN_STAGE,
                Patterns::CREATE_STAGE,
                Patterns::ADAPTER_APPEND_DECLARATION,
                Patterns::ADAPTER_SEAL_DECLARATION,
                Patterns::ADAPTER_UNSEALED_CLEANUP_DECLARATION,
                Patterns::STAGE_OPENAT,
                Patterns::STAGE_DESCRIPTOR_NEGATIVE,
                Patterns::STAGE_CREATE_FAILED,
                Patterns::STAGE_CREATE_UNKNOWN,
                Patterns::CLOSE_STAGE,
                Patterns::DESCRIPTOR_CLEARED,
                Patterns::CLOSE_STATUS_SAVED,
                Patterns::ADMISSION_UNCERTAIN,
                Patterns::STAGE_HANDLE,
                Patterns::SESSION_PLANNED,
                Patterns::BEGIN_EVENT,
                Patterns::CAPTURE_ADMISSION,
                Patterns::STAGE_ADMISSION_MODEL,
                Patterns::ADMISSION_VALID,
                Patterns::ADMISSION_SAVED,
                Patterns::SESSION_ADMISSION_MATCH,
                Patterns::SESSION_IDENTITY_MATCH,
                Patterns::REJECT_ADMISSION_MISMATCH,
                Patterns::BYTES_EQUAL_AT,
                Patterns::BYTES_EQUAL,
                Patterns::BYTE_MISMATCH,
                Patterns::DEVICE_MISMATCH,
                Patterns::PARENT_STABLE,
                Patterns::STAGE_IDENTITY_CHANGED,
                Patterns::WRITE_BOUND,
                Patterns::OWNER_TOKEN,
                Patterns::PARENT_TOKEN_MISMATCH,
                Patterns::WRITE_FULLY,
                Patterns::APPEND_EVENT,
                Patterns::FAIL_SESSION,
                Patterns::FSYNC,
                Patterns::READY_EVENT,
                Patterns::STAGE_INODE_MISMATCH,
                Patterns::LINK_COUNT,
                Patterns::PRIVATE_MODE,
                Patterns::PRIVATE_SINGLE_LINK,
                Patterns::COMPARE_STAGE,
                Patterns::INVALID_LEAF,
                Patterns::COMPARE_EVENT,
                Patterns::IDENTITY_EQUAL,
                Patterns::STAGE_CONTENT_MATCHES,
                Patterns::SCRATCH_MARK,
                Patterns::ARENA_REWIND,
                Patterns::BOUNDED_OBSERVE,
                Patterns::COMMIT_STAGE,
                Patterns::COMMIT_EVENT,
                Patterns::RENAME_STAGE,
                Patterns::MARK_UNCERTAIN,
                Patterns::DIRECTORY_SYNC_EVENT,
                Patterns::COMMIT_ACK,
                Patterns::PUBLISHED_IDENTITY,
                Patterns::PUBLISHED_PRIVATE,
                Patterns::CLEANUP_UNSEALED,
                Patterns::CLEANUP_CLOSED,
                Patterns::CLOSED_STAGE_BRANCH,
                Patterns::RETURN_CLOSED_CLEANUP,
                Patterns::RECONCILE,
                Patterns::RESOLVE_PUBLISHED,
                Patterns::RESOLVE_NOT_PUBLISHED,
                Patterns::PUBLICATION_UNCERTAIN,
                Patterns::NOT_PUBLISHED_PATTERN,
                Patterns::FINAL_NOT_PUBLISHED,
                Patterns::FIXTURE_UNCLEAN_STATES,
                Patterns::FIXTURE_OBSERVED_OR_PARENT,
                Patterns::STAGE_TOKEN_EXPECTED,
                Patterns::STAT_DESCRIPTOR,
                Patterns::SAME_INODE,
                Patterns::DESCRIPTOR_LINK_COUNT,
                Patterns::STAGE_DEVICE_INODE,
                Patterns::STAGE_AGAIN,
                Patterns::CLEANUP,
                Patterns::SYNC_CLEANUP,
                Patterns::SYNC_CLEANUP_CALL,
                Patterns::UNCHANGED_PENDING,
                Patterns::PUBLISHED_UNCERTAIN,
                Patterns::INVALID_EXPECTED,
                Patterns::STAGE_NOT_PRIVATE,
                Patterns::STAGE_STAT_INVALID,
                Patterns::UNLINK_STAGE,
                Patterns::CLEANUP_FAILED,
                Patterns::CLEANUP_ACK,
                Patterns::READ_REGULAR,
                Patterns::HASH_BYTES,
                Patterns::PARENT_TOKEN,
                Patterns::PARENT_MATCHES,
                Patterns::ENOENT,
                Patterns::NOFOLLOW,
                Patterns::OBSERVATION_LIMIT,
                Patterns::DESTINATION_DEFAULT], Messages::ADAPTER_MISSING)
            return status if status != 0i64
            forbidden_uncertain_cleanup: bool = try EsSourceFunctionScope::contains_file_line(inputs[1], Patterns::ADAPTER_UNCERTAIN_CLEANUP, Patterns::ADAPTER_UNCERTAIN_STATE) else err:
                diagnostic(Messages::READ_FAILED + f"{inputs[1]}")
                return ExitStatus::IO_FAILURE
            if forbidden_uncertain_cleanup:
                diagnostic(Messages::UNCERTAIN_CLEANUP_PRESENT)
                return ExitStatus::FAILURE
            status <- check_file(inputs[1], ["AtomicFilePosixError.DirectoryLeaseRequired",
                "AtomicFilePosixError.LeaseNameCollision",
                "session.state == AtomicFileState.FailedPendingCleanup or session.state == AtomicFileState.CancelledPendingCleanup",
                "session.staged_identity.observed or parent_fd < 0",
                "expected.stage_descriptor_token != stage_fd.u64() + 1u64",
                "atomic_file_posix_stat_descriptor(stage_fd, stage_descriptor_before)",
                "atomic_file_posix_same_inode(stage_descriptor_before, stage_before)",
                "stage_descriptor_before.link_count != 1u16",
                "stage_before.device.u64() != expected.stage_device or stage_before.inode != expected.stage_inode",
                "stage_again: mutable ElisascriptStat"], Messages::ADAPTER_MISSING)
            return status if status != 0i64
            status <- check_file(inputs[2], [Patterns::MODEL_INCLUDE, Patterns::ADAPTER_INCLUDE], Messages::ADAPTER_MISSING)
            return status if status != 0i64
            status <- check_file(inputs[2], ["EsFileAtomic::AtomicFileSession"], Messages::ADAPTER_MISSING)
            return status if status != 0i64
            status <- check_file(inputs[3], [Patterns::FIXTURE_USING,
                Patterns::FIXTURE_NOOP,
                Patterns::FIXTURE_DESTINATION_RACE,
                Patterns::FIXTURE_RESTORE_PROOF,
                Patterns::FIXTURE_NUL,
                Patterns::FIXTURE_UNCHANGED_COMMIT,
                Patterns::FIXTURE_ACK,
                Patterns::FIXTURE_EMPTY_PLAN,
                Patterns::FIXTURE_FORGED_READY,
                Patterns::FIXTURE_UNCHANGED,
                Patterns::FIXTURE_PUBLISHED_UNCERTAIN,
                Patterns::FIXTURE_ROLLED_BACK], Messages::FIXTURE_MISSING)
            return status if status != 0i64
            status <- check_file(inputs[4], [Patterns::FIXTURE_DIRECTORY_LEASE,
                Patterns::FIXTURE_LEASE_COLLISION,
                Patterns::FIXTURE_BACKUP_COLLISION,
                Patterns::FIXTURE_IRRELEVANT_PAYLOAD,
                Patterns::FIXTURE_FILE_ENTRY,
                Patterns::FIXTURE_SIBLINGS,
                Patterns::FIXTURE_SYNC_ACK,
                Patterns::FIXTURE_RESTORE_DESTINATION,
                Patterns::FIXTURE_INVALID_PARENT,
                Patterns::FIXTURE_PREFLIGHT,
                Patterns::FIXTURE_ADMISSION,
                Patterns::FIXTURE_APPEND_IDENTITY,
                Patterns::FIXTURE_BEGIN_BYTES,
                Patterns::FIXTURE_PREMATURE_ACK,
                Patterns::FIXTURE_PENDING_CLEANUP,
                Patterns::FIXTURE_DUPLICATE_ACK,
                Patterns::FIXTURE_PARTIAL_UNOBSERVED], Messages::RUNTIME_FIXTURE_MISSING)
            return status if status != 0i64
            status <- check_file(inputs[5], [Patterns::DOC_SESSION], Messages::DOCS_MISSING)
            return status if status != 0i64
            status <- check_file(inputs[6], [Patterns::LEDGER_ID], Messages::LEDGER_MISSING)
            return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL), root.joinpath(Inputs::ADAPTER), root.joinpath(Inputs::IR),
                root.joinpath(Inputs::IR_FIXTURE), root.joinpath(Inputs::RUNTIME_FIXTURE),
                root.joinpath(Inputs::DOCS), root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::IO_FAILURE
            status: i64 = execute_all(inputs)
            return status if status != 0i64
            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsFileAtomicAudit::run_default()
