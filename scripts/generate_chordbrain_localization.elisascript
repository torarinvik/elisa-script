# Bounded Elisascript port of ChordBrain's generate_localization.py.
# It preserves Python dict insertion order, non-English key extension order,
# English fallback, and exact generated source layout for the current .lang data.

include "../src/runtime/bounded_text_posix.elisa"

using EsBoundedText

module EsChordBrainLocalizationGenerator:
    private:
        const module Limits:
            LANGUAGE_BYTES: usize = 1048576
            TOTAL_LANGUAGE_BYTES: usize = 6291456
            GENERATED_BYTES: usize = 33554432
            LANGUAGE_COUNT: usize = 6


        const module Messages:
            USAGE: sview = "usage: generate_chordbrain_localization --input-dir DIR --output FILE"
            HELP: sview = "usage: generate_chordbrain_localization --input-dir DIR --output FILE\n\noptions:\n  -h, --help       show this help message and exit\n  --input-dir DIR\n  --output FILE\n  --dry-run        report without writing the output\n  --verbose        report generation details"
            LANGUAGE_READ_FAILED: sview = "localization generator: unable to read language input"
            LANGUAGE_LIMIT: sview = "localization generator: language input exceeds size limit"
            GENERATED_LIMIT: sview = "localization generator: generated output exceeds size limit"
            LANGUAGE_LITERAL_UNSUPPORTED: sview = "localization generator: unsupported quoted entry"
            OUTPUT_WRITE_FAILED: sview = "localization generator: unable to write generated output"


        const enum LocalizationOption of u8:
            Other
            InputDirectory
            Output
            DryRun
            Verbose


        struct LocalizationEntry:
            key: sview
            value: mutable sview


        struct LocalizationSource:
            code: sview
            name: mutable sview
            entries: darray[LocalizationEntry] = []
            # Keep entries as the authoritative insertion-ordered sequence to
            # preserve Python dict iteration semantics. This side index avoids
            # rescanning that sequence for every duplicate and rendered key.
            entry_indices: dict[sview, usize] = {}


        error LocalizationError:
            InputReadFailed
            InputLimitExceeded
            OutputLimitExceeded
            UnsupportedLiteral


        def localization_language_code(index: usize) -> sview:
            return "en" if index == 0
            return "de" if index == 1
            return "es" if index == 2
            return "fr" if index == 3
            return "it" if index == 4
            return "pt" if index == 5
            return ""


        def localization_language_name(index: usize) -> sview:
            return "English" if index == 0
            return "German" if index == 1
            return "Spanish" if index == 2
            return "French" if index == 3
            return "Italian" if index == 4
            return "Portuguese" if index == 5
            return ""


        # Match argparse's default unique-prefix behavior for the two long
        # options. The bare `--` delimiter is not an option abbreviation.
        def localization_option(argument: sview) -> LocalizationOption:
            option_end: i64 = argument.index("=")
            option: sview = sview(argument, 0i64, option_end) if option_end >= 0 else argument
            return LocalizationOption.DryRun if option == "--dry-run"
            return LocalizationOption.Verbose if option == "--verbose"
            return LocalizationOption.InputDirectory if len(option) >= 3 and "--input-dir".starts_with(option)
            return LocalizationOption.Output if len(option) >= 3 and "--output".starts_with(option)
            return LocalizationOption.Other


        def localization_option_takes_value(option: LocalizationOption) -> bool:
            return option == LocalizationOption.InputDirectory or option == LocalizationOption.Output


        def localization_argument_is_option(argument: sview) -> bool:
            length: usize = len(argument)
            return false if length == 0 or argument == "-"
            return true if argument.starts_with("--")
            return false if not argument.starts_with("-")

            cursor: mutable usize = 1
            while cursor < length and sview_at(argument, cursor) >= 48u8 and sview_at(argument, cursor) <= 57u8:
                cursor <- cursor + 1
            return false if cursor == length and cursor > 1
            if cursor < length and sview_at(argument, cursor) == 46u8:
                cursor <- cursor + 1
                fraction_start: usize = cursor
                while cursor < length and sview_at(argument, cursor) >= 48u8 and sview_at(argument, cursor) <= 57u8:
                    cursor <- cursor + 1
                return false if cursor == length and cursor > fraction_start
            return true


        def localization_entry_index(source: LocalizationSource, key: sview) -> usize:
            return source.entry_indices.get(key, source.entries.count)


        def localization_hex_digit(byte: u8) -> i32:
            return (byte - 48u8).i32() if byte >= 48u8 and byte <= 57u8
            return (byte - 65u8 + 10u8).i32() if byte >= 65u8 and byte <= 70u8
            return (byte - 97u8 + 10u8).i32() if byte >= 97u8 and byte <= 102u8
            return -1i32


        def localization_append_codepoint(output: mutable darray[u8]&, codepoint: u32) -> void error[LocalizationError] can[Memory.Allocate, Abort.Panic]:
            raise LocalizationError.UnsupportedLiteral if codepoint > 1114111u32 or codepoint >= 55296u32 and codepoint <= 57343u32
            if codepoint <= 127u32:
                output.push(codepoint.u8())
            elif codepoint <= 2047u32:
                output.push((192u32 | (codepoint >> 6)).u8())
                output.push((128u32 | (codepoint & 63u32)).u8())
            elif codepoint <= 65535u32:
                output.push((224u32 | (codepoint >> 12)).u8())
                output.push((128u32 | ((codepoint >> 6) & 63u32)).u8())
                output.push((128u32 | (codepoint & 63u32)).u8())
            else:
                output.push((240u32 | (codepoint >> 18)).u8())
                output.push((128u32 | ((codepoint >> 12) & 63u32)).u8())
                output.push((128u32 | ((codepoint >> 6) & 63u32)).u8())
                output.push((128u32 | (codepoint & 63u32)).u8())


        def localization_decode_string_literal(literal: sview) -> sview error[LocalizationError] can[Memory.Allocate, Abort.Panic]:
            length: usize = len(literal)
            raise LocalizationError.UnsupportedLiteral if length < 2 or sview_at(literal, 0) != 34u8 or sview_at(literal, length - 1) != 34u8
            decoded: mutable darray[u8] = []
            cursor: mutable usize = 1
            while cursor < length - 1 |literal, decoded, cursor|:
                byte: u8 = sview_at(literal, cursor)
                if byte == 34u8:
                    raise LocalizationError.UnsupportedLiteral
                if byte != 92u8:
                    decoded.push(byte)
                    cursor <- cursor + 1
                    continue

                cursor <- cursor + 1
                raise LocalizationError.UnsupportedLiteral if cursor >= length - 1
                escaped: u8 = sview_at(literal, cursor)
                if escaped == 34u8 or escaped == 39u8 or escaped == 92u8:
                    decoded.push(escaped)
                elif escaped == 97u8:
                    decoded.push(7u8)
                elif escaped == 98u8:
                    decoded.push(8u8)
                elif escaped == 102u8:
                    decoded.push(12u8)
                elif escaped == 110u8:
                    decoded.push(10u8)
                elif escaped == 114u8:
                    decoded.push(13u8)
                elif escaped == 116u8:
                    decoded.push(9u8)
                elif escaped == 118u8:
                    decoded.push(11u8)
                elif escaped == 78u8:
                    # Python's \N{name} requires the Unicode database. Do not
                    # guess at names or silently produce different text.
                    raise LocalizationError.UnsupportedLiteral
                elif escaped == 120u8 or escaped == 117u8 or escaped == 85u8:
                    digit_count: usize = 2 if escaped == 120u8 else 4 if escaped == 117u8 else 8
                    raise LocalizationError.UnsupportedLiteral if cursor + digit_count >= length - 1
                    codepoint: mutable u32 = 0
                    for digit_offset in 1..<(digit_count + 1) |literal, cursor, codepoint|:
                        digit: i32 = localization_hex_digit(sview_at(literal, cursor + digit_offset))
                        raise LocalizationError.UnsupportedLiteral if digit < 0
                        codepoint <- (codepoint << 4) | digit.u32()
                    try localization_append_codepoint(decoded, codepoint)
                    cursor <- cursor + digit_count
                elif escaped >= 48u8 and escaped <= 55u8:
                    octal_codepoint: mutable u32 = 0
                    octal_end: mutable usize = cursor
                    while octal_end < length - 1 and octal_end < cursor + 3 and sview_at(literal, octal_end) >= 48u8 and sview_at(literal, octal_end) <= 55u8 |literal, octal_codepoint, octal_end|:
                        octal_codepoint <- (octal_codepoint << 3) | (sview_at(literal, octal_end) - 48u8).u32()
                        octal_end <- octal_end + 1
                    try localization_append_codepoint(decoded, octal_codepoint)
                    cursor <- octal_end - 1
                else:
                    # Python preserves unrecognized escapes (for example,
                    # \\q) in the string value rather than deleting '\\'.
                    decoded.push(92u8)
                    decoded.push(escaped)
                cursor <- cursor + 1
            return bytes_view(decoded)


        def localization_parse_language(code: sview, contents: sview) -> LocalizationSource error[LocalizationError] can[Memory.Allocate, Abort.Panic]:
            normalized: sview = contents.replace("\r\n", "\n").replace("\r", "\n")
            lines: darray[sview] = split_lines(normalized)
            entries: mutable darray[LocalizationEntry] = []
            entry_indices: mutable dict[sview, usize] = {}
            for line in lines |lines, entries, entry_indices|:
                trimmed: sview = line.strip()
                if not trimmed.startswith("\""):
                    continue

                # ENTRY_RE excludes quotes in keys but allows escapes and
                # embedded escaped quotes in the value literal.
                key_end: mutable usize = 1
                while key_end < len(trimmed) and sview_at(trimmed, key_end) != 34u8 |trimmed, key_end|:
                    key_end <- key_end + 1
                continue if key_end == len(trimmed)
                key: sview = sview(trimmed, 1, (key_end - 1).i64())
                continue if key == ""
                separator: sview = sview(trimmed, key_end + 1, (len(trimmed) - key_end - 1).i64())
                equals: i64 = separator.index("=")
                continue if equals < 0 or sview(separator, 0, equals).strip() != ""
                value_tail_start: usize = equals.usize() + 1
                raw_value: sview = sview(separator, value_tail_start, (len(separator) - value_tail_start).i64()).strip()
                if len(raw_value) < 2 or sview_at(raw_value, 0) != 34u8 or sview_at(raw_value, len(raw_value) - 1) != 34u8:
                    continue
                owned_value: sview = try localization_decode_string_literal(raw_value)

                # Own each key/value independently; no returned entry borrows
                # the temporary read_text buffer or split-line views.
                owned_key: sview = "" + key
                owned_value <- "" + owned_value
                existing: usize = entry_indices.get(owned_key, entries.count)
                if existing == entries.count:
                    entry_indices[owned_key] <- existing
                    entries.push(LocalizationEntry{key: owned_key, value: owned_value})
                else:
                    entries[existing].value <- owned_value
            return LocalizationSource{code: code, name: "", entries: entries, entry_indices: entry_indices}


        def localization_load_language(input_directory: Path, index: usize) -> LocalizationSource error[LocalizationError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            code: sview = localization_language_code(index)
            input_path: Path = input_directory.joinpath(code + ".lang")
            contents: mutable sview = ""
            catch EsBoundedText::read_utf8(input_path, Limits::LANGUAGE_BYTES):
                ok value:
                    contents <- value
                error failure:
                    if failure == EsBoundedText::ReadError.LimitExceeded:
                        raise LocalizationError.InputLimitExceeded
                    raise LocalizationError.InputReadFailed

            parsed: LocalizationSource = try localization_parse_language(code, contents)
            parsed.name <- localization_language_name(index)
            return parsed


        def localization_escape_elisa_string(value: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            escaped: sview = value.replace("\\", "\\\\")
            escaped <- escaped.replace("\"", "\\\"")
            escaped <- escaped.replace("\n", "\\n")
            return "\"" + escaped + "\""


        def localization_append_line(lines: mutable darray[sview]&, total_bytes: mutable usize&, line: sview) -> void error[LocalizationError] can[Memory.Allocate, Abort.Panic]:
            # The final output terminates every line with a newline. Reserve
            # that byte before retaining each intermediate line.
            return raise LocalizationError.OutputLimitExceeded if total_bytes >= Limits::GENERATED_BYTES or len(line) >= Limits::GENERATED_BYTES - total_bytes
            lines.push(line)
            total_bytes <- total_bytes + len(line) + 1


        def localization_render(sources: darray[LocalizationSource]) -> sview error[LocalizationError] can[Memory.Allocate, Abort.Panic]:
            keys: mutable darray[sview] = []
            english: LocalizationSource = sources[0]
            for entry in english.entries |english, keys|:
                keys.push(entry.key)
            for source_index in 1..<sources.count |sources, english, keys|:
                source: LocalizationSource = sources[source_index]
                for entry in source.entries |source, english, keys|:
                    in_english: bool = localization_entry_index(english, entry.key) != english.entries.count
                    # Match the Python generator's per-language extension:
                    # membership is checked against English only, so a
                    # foreign-only key present in multiple languages appears
                    # once for each such language in the generated tables.
                    if not in_english:
                        keys.push(entry.key)

            lines: mutable darray[sview] = []
            rendered_bytes: mutable usize = 0
            try localization_append_line(lines, rendered_bytes, "# Generated from the original ChordBrain Assets/Languages/*.lang files.")
            try localization_append_line(lines, rendered_bytes, "# Do not edit this file manually; run tools/generate_localization.py.")
            try localization_append_line(lines, rendered_bytes, "")
            for source_index in 0..<sources.count |sources, keys, lines|:
                source: LocalizationSource = sources[source_index]
                try localization_append_line(lines, rendered_bytes, "def chordbrain_translate_" + source.code + "(key: u8&) -> u8&?:")
                for key in keys |sources, keys, lines, source_index, source|:
                    source_entry_index: usize = localization_entry_index(source, key)
                    english_entry_index: usize = localization_entry_index(english, key)
                    value_text: mutable sview = ""
                    has_value: mutable bool = false
                    if source_entry_index != source.entries.count:
                        value_text <- source.entries[source_entry_index].value
                        has_value <- true
                    elif source_index != 0 and english_entry_index != english.entries.count:
                        value_text <- english.entries[english_entry_index].value
                        has_value <- true
                    if has_value:
                        value: sview = localization_escape_elisa_string(value_text)
                        key_literal: sview = localization_escape_elisa_string(key)
                        try localization_append_line(lines, rendered_bytes, "    " + value + " return if cstr_equal(key, " + key_literal + ")")
                try localization_append_line(lines, rendered_bytes, "    return null")
                try localization_append_line(lines, rendered_bytes, "")

            try localization_append_line(lines, rendered_bytes, "def chordbrain_language_count_impl() -> i32:")
            try localization_append_line(lines, rendered_bytes, "    return 6")
            try localization_append_line(lines, rendered_bytes, "")
            try localization_append_line(lines, rendered_bytes, "def chordbrain_language_code_impl(language: i32) -> u8&?:")
            for source_index in 0..<sources.count |sources, lines|:
                try localization_append_line(lines, rendered_bytes, f"    \"{sources[source_index].code}\" return if language == {source_index}")
            try localization_append_line(lines, rendered_bytes, "    return null")
            try localization_append_line(lines, rendered_bytes, "")

            try localization_append_line(lines, rendered_bytes, "def chordbrain_language_name_impl(language: i32) -> u8&?:")
            for source_index in 0..<sources.count |sources, lines|:
                try localization_append_line(lines, rendered_bytes, f"    {localization_escape_elisa_string(sources[source_index].name)} return if language == {source_index}")
            try localization_append_line(lines, rendered_bytes, "    return null")
            try localization_append_line(lines, rendered_bytes, "")

            try localization_append_line(lines, rendered_bytes, "def chordbrain_translate_impl(language: i32, key: u8&) -> u8&?:")
            for source_index in 0..<sources.count |sources, lines|:
                try localization_append_line(lines, rendered_bytes, f"    return chordbrain_translate_{sources[source_index].code}(key) if language == {source_index}")
            try localization_append_line(lines, rendered_bytes, "    return chordbrain_translate_en(key)")
            try localization_append_line(lines, rendered_bytes, "")
            try localization_append_line(lines, rendered_bytes, "export fn chordbrain_language_count() -> i32 = chordbrain_language_count_impl")
            try localization_append_line(lines, rendered_bytes, "export fn chordbrain_language_code(language: i32) -> u8&? = chordbrain_language_code_impl")
            try localization_append_line(lines, rendered_bytes, "export fn chordbrain_language_name(language: i32) -> u8&? = chordbrain_language_name_impl")
            try localization_append_line(lines, rendered_bytes, "export fn chordbrain_translate(language: i32, key: u8&) -> u8&? = chordbrain_translate_impl")
            return join(lines, "\n") + "\n"


    public:
        def generate(input_directory: Path) -> sview error[LocalizationError] can[Memory.Allocate, Abort.Panic, File.Read]:
            sources: mutable darray[LocalizationSource] = []
            total_bytes: mutable usize = 0
            for index in 0..<Limits::LANGUAGE_COUNT |sources, total_bytes|:
                code: sview = localization_language_code(index)
                input_path: Path = input_directory.joinpath(code + ".lang")
                input_size: usize = try file_size(input_path) else err:
                    raise LocalizationError.InputReadFailed
                raise LocalizationError.InputLimitExceeded if input_size > Limits::LANGUAGE_BYTES or input_size > Limits::TOTAL_LANGUAGE_BYTES - total_bytes
                total_bytes <- total_bytes + input_size
                source: LocalizationSource = try localization_load_language(input_directory, index)
                sources.push(source)
            return try localization_render(sources)


        def write_diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def run(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Console.Write, Directory.Read, File.Read, File.Write, Unsafe.PointerCast]:
            help_cursor: mutable usize = 0
            help_options_ended: mutable bool = false
            while help_cursor < arguments.count |arguments, help_cursor, help_options_ended|:
                is_help: bool = arguments[help_cursor] == "-h" or arguments[help_cursor] == "--help"
                previous_option_has_no_inline_value: bool = help_cursor != 0 and arguments[help_cursor - 1].index("=") < 0
                previous_is_value_option: bool = help_cursor != 0 and previous_option_has_no_inline_value and localization_option_takes_value(localization_option(arguments[help_cursor - 1]))
                follows_value_option: bool = previous_is_value_option
                if is_help and not help_options_ended and not follows_value_option:
                    print(Messages::HELP)
                    return 0i64
                help_options_ended <- true if arguments[help_cursor] == "--"
                help_cursor <- help_cursor + 1
            input_directory_text: mutable sview = ""
            output_path_text: mutable sview = ""
            has_input_directory: mutable bool = false
            has_output_path: mutable bool = false
            dry_run: mutable bool = false
            verbose: mutable bool = false
            cursor: mutable usize = 0
            while cursor < arguments.count |arguments, input_directory_text, output_path_text, has_input_directory, has_output_path, dry_run, verbose, cursor|:
                option: LocalizationOption = localization_option(arguments[cursor])
                option_end: i64 = arguments[cursor].index("=")
                if option == LocalizationOption.DryRun and option_end < 0:
                    dry_run <- true
                    cursor <- cursor + 1
                elif option == LocalizationOption.Verbose and option_end < 0:
                    verbose <- true
                    cursor <- cursor + 1
                elif option == LocalizationOption.InputDirectory and option_end >= 0:
                    input_value_start: i64 = option_end + 1
                    input_directory_text <- sview(arguments[cursor], input_value_start, len(arguments[cursor]).i64() - input_value_start)
                    has_input_directory <- true
                    cursor <- cursor + 1
                elif option == LocalizationOption.InputDirectory:
                    if cursor + 1 >= arguments.count or localization_argument_is_option(arguments[cursor + 1]):
                        write_diagnostic(Messages::USAGE)
                        return 2i64
                    input_directory_text <- arguments[cursor + 1]
                    has_input_directory <- true
                    cursor <- cursor + 2
                elif option == LocalizationOption.Output and option_end >= 0:
                    output_value_start: i64 = option_end + 1
                    output_path_text <- sview(arguments[cursor], output_value_start, len(arguments[cursor]).i64() - output_value_start)
                    has_output_path <- true
                    cursor <- cursor + 1
                elif option == LocalizationOption.Output:
                    if cursor + 1 >= arguments.count or localization_argument_is_option(arguments[cursor + 1]):
                        write_diagnostic(Messages::USAGE)
                        return 2i64
                    output_path_text <- arguments[cursor + 1]
                    has_output_path <- true
                    cursor <- cursor + 2
                else:
                    write_diagnostic(Messages::USAGE)
                    return 2i64
            if not has_input_directory or not has_output_path:
                write_diagnostic(Messages::USAGE)
                return 2i64
            input_directory: Path = path(input_directory_text)
            output_path: Path = path(output_path_text)
            generated: mutable sview = ""
            catch generate(input_directory):
                ok value:
                    generated <- value
                error failure:
                    if failure == LocalizationError.InputLimitExceeded:
                        write_diagnostic(Messages::LANGUAGE_LIMIT)
                    elif failure == LocalizationError.OutputLimitExceeded:
                        write_diagnostic(Messages::GENERATED_LIMIT)
                    elif failure == LocalizationError.UnsupportedLiteral:
                        write_diagnostic(Messages::LANGUAGE_LITERAL_UNSUPPORTED)
                    else:
                        write_diagnostic(Messages::LANGUAGE_READ_FAILED)
                    return 1i64
            if dry_run:
                print("dry-run: would write " + output_path_text)
                if verbose:
                    print("verbose: generated " + f"{len(generated)}" + " bytes from " + f"{Limits::LANGUAGE_COUNT}" + " language files")
                return 0i64
            if verbose:
                print("verbose: writing " + output_path_text)
            try write_text(output_path, generated) else err:
                write_diagnostic(Messages::OUTPUT_WRITE_FAILED)
                return 1i64
            if verbose:
                print("verbose: wrote " + f"{len(generated)}" + " bytes")
            return 0i64


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Console.Write, Directory.Read, File.Read, File.Write, Unsafe.PointerCast]:
    return EsChordBrainLocalizationGenerator::run(arguments)
