# Bounded Elisascript port of check_module_model.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsModuleModelAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/module_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"


        const module Patterns:
            MODULE: sview = "module EsModule:"
            MAX_NAME_BYTES: sview = "MODULE_MAX_NAME_BYTES"
            MAX_PATH_BYTES: sview = "MODULE_MAX_PATH_BYTES"
            MAX_IMPORTS: sview = "MODULE_MAX_IMPORTS"
            MAX_SYMBOLS: sview = "MODULE_MAX_SYMBOLS"
            MAX_MODULES: sview = "MODULE_MAX_MODULES"
            VISIBILITY: sview = "const enum ModuleVisibility of u8:"
            RESOLUTION_STATE: sview = "const enum ModuleResolutionState of u8:"
            RESOLUTION_EVENT: sview = "const enum ModuleResolutionEvent of u8:"
            IMPORT: sview = "struct ModuleImport:"
            DESCRIPTOR: sview = "struct ModuleDescriptor:"
            GRAPH: sview = "struct ModuleGraph:"
            STACK: sview = "struct ModuleResolutionStack:"
            ERROR: sview = "error ModuleContractError:"
            VALIDATE_DESCRIPTOR: sview = "def validate_module_descriptor("
            VALIDATE_GRAPH: sview = "def validate_module_graph("
            GRAPH_ACYCLIC: sview = "def module_graph_acyclic("
            ADVANCE: sview = "def advance_module_resolution("
            STACK_PUSH: sview = "def module_resolution_stack_push("
            STACK_POP: sview = "def module_resolution_stack_pop("
            VISIBILITY_VALID: sview = "module_visibility_valid"
            STATE_VALID: sview = "module_resolution_state_valid"
            DUPLICATE_IMPORT: sview = "DuplicateImport"
            DUPLICATE_MODULE: sview = "DuplicateModule"
            MODULE_NOT_FOUND: sview = "ModuleNotFound"
            DUPLICATE_SYMBOL: sview = "DuplicateSymbol"
            PUBLIC_PRIVATE_COLLISION: sview = "PublicPrivateCollision"
            RESOLUTION_CYCLE: sview = "ResolutionCycle"
            RESOLUTION_NOT_READY: sview = "ResolutionNotReady"
            RESOLVED_STATE: sview = "module.state == ModuleResolutionState.Resolved"
            IMPORT_RESOLVED: sview = "ModuleResolutionEvent.ImportResolved"
            MODEL_IMPORT: sview = "include \"../runtime/module_model.elisa\""
            FIXTURE_CONTRACT: sview = "typed_module_graph_contract_is_private_by_default_and_cycle_safe"
            FIXTURE_PUBLIC: sview = "ModuleVisibility.Public"
            FIXTURE_CYCLE: sview = "ModuleContractError.ResolutionCycle"
            FIXTURE_COLLISION: sview = "ModuleContractError.PublicPrivateCollision"
            FIXTURE_NOT_FOUND: sview = "ModuleContractError.ModuleNotFound"
            DOCS_MODULE: sview = "`EsModule`"


        const module Messages:
            MISSING_ROOT: sview = "module model audit: missing repository root"
            UNRESOLVED_ROOT: sview = "module model audit: unable to resolve repository root"
            MISSING_INPUT: sview = "module model audit: missing "
            READ_FAILED: sview = "module model audit: unable to read source: "
            SUCCESS: sview = "module model audit: explicit visibility, bounded imports, resolution states, and cycle rejection are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_NAME_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_PATH_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_IMPORTS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_SYMBOLS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_MODULES},
                SearchCheck{input: inputs[0], pattern: Patterns::VISIBILITY},
                SearchCheck{input: inputs[0], pattern: Patterns::RESOLUTION_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::RESOLUTION_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::DESCRIPTOR},
                SearchCheck{input: inputs[0], pattern: Patterns::GRAPH},
                SearchCheck{input: inputs[0], pattern: Patterns::STACK},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_DESCRIPTOR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_GRAPH},
                SearchCheck{input: inputs[0], pattern: Patterns::GRAPH_ACYCLIC},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::STACK_PUSH},
                SearchCheck{input: inputs[0], pattern: Patterns::STACK_POP},
                SearchCheck{input: inputs[0], pattern: Patterns::VISIBILITY_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE_NOT_FOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::GRAPH_ACYCLIC},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_SYMBOL},
                SearchCheck{input: inputs[0], pattern: Patterns::PUBLIC_PRIVATE_COLLISION},
                SearchCheck{input: inputs[0], pattern: Patterns::RESOLUTION_CYCLE},
                SearchCheck{input: inputs[0], pattern: Patterns::RESOLUTION_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::RESOLVED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::IMPORT_RESOLVED},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_PUBLIC},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CYCLE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_COLLISION},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_NOT_FOUND},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_MODULE}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsModuleModelAudit::run_default()
