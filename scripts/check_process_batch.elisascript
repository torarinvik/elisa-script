# Bounded Elisascript port of check_process_batch.sh.
# Model/IR checks use regex scans; the dispatch fixture retains fixed-string checks.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsProcessBatchAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/process_batch_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DISPATCH_FIXTURE: sview = "test/runtime/process_batch_dispatch_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "^module EsProcessBatch:"
            MODEL_IMPORT: sview = "include \"\\.\\./runtime/process_batch_model\\.elisa\""
            LIMITS_MODULE: sview = "const module Limits:"
            FAILURE_MODE: sview = "const enum ProcessBatchFailureMode of u8"
            BATCH_STATE: sview = "const enum ProcessBatchState of u8"
            JOB_STATE: sview = "const enum ProcessBatchJobState of u8"
            AWAITING_REAP: sview = "AwaitingReap"
            SKIPPED: sview = "Skipped"
            BATCH_EVENT: sview = "const enum ProcessBatchEvent of u8"
            REAP_ACK: sview = "ReapAck"
            LAUNCH_AT: sview = "LaunchAt"
            SKIP_AT: sview = "SkipAt"
            POLICY: sview = "struct ProcessBatchPolicy:"
            JOB: sview = "struct ProcessBatchJob:"
            DISPATCH: sview = "struct ProcessBatchDispatch:"
            SESSION: sview = "struct ProcessBatchSession:"
            ERROR: sview = "error ProcessBatchError:"
            VALIDATE: sview = "def validate_process_batch\\("
            ADVANCE: sview = "def advance_process_batch\\("
            ADMIT_NEXT: sview = "def admit_next_process_batch_job\\("
            ADMIT_JOB: sview = "def admit_process_batch_job\\("
            VALIDATE_DISPATCH: sview = "def validate_process_batch_dispatch\\("
            JOBS_LIMIT: sview = "Limits::JOBS"
            PARALLEL_LIMIT: sview = "Limits::PARALLEL"
            ATTEMPTS_LIMIT: sview = "Limits::ATTEMPTS"
            PENDING_INDEX: sview = "process_batch_pending_index"
            ALL_TERMINAL: sview = "process_batch_all_terminal"
            REQUIRES_ATTEMPT: sview = "process_batch_job_requires_attempt"
            FAIL_FAST_MODE: sview = "ProcessBatchFailureMode.FailFast"
            AGGREGATE_MODE: sview = "ProcessBatchFailureMode.Aggregate"
            RETRY_EVENT: sview = "ProcessBatchEvent.Retry"
            CANCEL_ACK_EVENT: sview = "ProcessBatchEvent.CancelAck"
            PARALLEL_LIMIT_ERROR: sview = "ProcessBatchError.ParallelLimitExceeded"
            DUPLICATE_JOB_ID: sview = "ProcessBatchError.DuplicateJobId"
            RETRY_NOT_READY: sview = "ProcessBatchError.RetryNotReady"
            STALE_ATTEMPT: sview = "ProcessBatchError.StaleAttempt"
            DISPATCH_MISMATCH: sview = "ProcessBatchError.DispatchMismatch"
            REAP_NOT_READY: sview = "ProcessBatchError.ReapNotReady"
            ATTEMPT_TOKEN: sview = "attempt_token"
            REAP_ACKNOWLEDGED: sview = "reap_acknowledged"
            QUEUED: sview = "queued"
            ATTEMPT_COUNT_BOUND: sview = "session.jobs\\[pending\\].attempts >= session.policy.max_attempts"
            SKIPPED_ACCOUNTING: sview = "job.state == ProcessBatchJobState.Skipped and (job.attempts != 0 or job.attempt_token != 0)"
            PLANNED_STATE: sview = "ProcessBatchState.Planned and"
            SUCCEEDED_STATE: sview = "ProcessBatchState.Succeeded and"
            FAILED_STATE: sview = "ProcessBatchState.Failed and"
            DRAINING_STATE: sview = "session.state == ProcessBatchState.Draining and"
            FAIL_FAST_LATCHED: sview = "session.state <- ProcessBatchState.Failed if session.fail_fast_latched"
            DRAINING: sview = "ProcessBatchState.Draining"
            CANCELLED_STATE: sview = "ProcessBatchState.Cancelled and"
            RUNNING_UNFINISHED: sview = "ProcessBatchState.Running and unfinished == 0"
            CANCELLING_UNFINISHED: sview = "ProcessBatchState.Cancelling and unfinished == 0"
            FAILED_ACCOUNTING: sview = "session.failed > session.jobs.count - session.completed"
            FAIL_FAST_POLICY: sview = "session.fail_fast_latched and session.policy.failure_mode != ProcessBatchFailureMode.FailFast"
            CANCELLED_ZERO: sview = "cancelled == 0"
            FIXTURE_IMPORT: sview = "using EsProcessBatch"
            FIXTURE_CONTRACT: sview = "typed_process_batch_contract_bounds_parallel_retry_and_cancel"
            FIXTURE_LAUNCH: sview = "ProcessBatchEvent.Launch"
            FIXTURE_RETRY: sview = "ProcessBatchEvent.Retry"
            FIXTURE_CANCEL_ACK: sview = "ProcessBatchEvent.CancelAck"
            FIXTURE_DUPLICATE_JOB: sview = "ProcessBatchError.DuplicateJobId"
            FIXTURE_ACCOUNTING: sview = "ProcessBatchError.AccountingInvalid"
            FORGED_COMPLETED_CANCELLED: sview = "forged_completed_cancelled"
            FORGED_FAILED: sview = "forged_failed"
            FORGED_FAILED_PENDING: sview = "forged_failed_with_pending"
            FORGED_DRAINING: sview = "forged_draining"
            FORGED_AGGREGATE_LATCH: sview = "forged_aggregate_latch"
            FIXTURE_REAP_ACK: sview = "ProcessBatchEvent.ReapAck"
            FIXTURE_STALE_ATTEMPT: sview = "StaleAttempt"
            RETRY_WITHOUT_REAP: sview = "retry_without_reap"
            STALE_REAP_RECEIPT: sview = "stale_reap_receipt"
            STALE_REAP_AGAIN: sview = "stale_reap_again"
            FAIL_FAST_CANCEL: sview = "fail_fast_cancel"
            FAIL_FAST_CANCEL_BEFORE_REAP: sview = "fail_fast_cancel_before_reap"
            FAIL_FAST_RETRY_POLICY: sview = "fail_fast_retry_policy"
            FAIL_FAST_LATCH: sview = "fail_fast_retry.fail_fast_latched"
            FORGED_RUNNING_COMPLETE: sview = "forged_running_complete"
            FORGED_CANCELLING_COMPLETE: sview = "forged_cancelling_complete"
            LAUNCH_LIMIT: sview = "launch_limit"
            SKIPS_VERIFIED_WORK: sview = "process_batch_skips_verified_work_without_fabricating_an_attempt"
            SKIP_AT_ZERO: sview = "advance_process_batch(session, ProcessBatchEvent.SkipAt, 0)"
            FIXTURE_SKIPPED: sview = "ProcessBatchJobState.Skipped"
            REPEATED_SKIP: sview = "repeated_skip_rejected"
            FORGED_ATTEMPT: sview = "forged_attempt_rejected"
            EXACT_RETRY_TOKEN: sview = "process_batch_admission_returns_exact_retry_token"
            SCHEDULER_SELECTED_JOB: sview = "process_batch_admits_a_scheduler_selected_job"
            FAIL_FAST_REAPS_CHILDREN: sview = "fail_fast_waits_for_every_unreaped_child_before_becoming_failed"
            ADMIT_NEXT_CALL: sview = "admit_next_process_batch_job(session)"
            ADMIT_JOB_CALL: sview = "admit_process_batch_job(session, 1)"
            INVALID_INDEX: sview = "invalid_index_rejected"
            VALIDATE_DISPATCH_CALL: sview = "validate_process_batch_dispatch(session, first)"
            FORGED_REJECTED: sview = "forged_rejected"
            RETRIED_TOKEN: sview = "retried.attempt_token == 2"
            DOCS_SESSION: sview = "EsProcessBatch::ProcessBatchSession"
            LEDGER_ITEM: sview = "ES-SCRIPT-033"


        const module Messages:
            MISSING_ROOT: sview = "process batch audit: missing repository root"
            UNRESOLVED_ROOT: sview = "process batch audit: unable to resolve repository root"
            MISSING_INPUT: sview = "process batch audit: missing "
            READ_FAILED: sview = "process batch audit: unable to read source: "
            SUCCESS: sview = "process batch audit: bounded parallel launch, retry, failure, and cancellation are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        const enum SearchMode of u8:
            Regex
            Literal


        struct SearchCheck:
            input: Path
            pattern: sview
            mode: SearchMode = SearchMode.Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def regex_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            pattern: Regex = regex(check.pattern)
            catch EsSourceFunctionScope::contains_file_regex_line(check.input, pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return ExitStatus::IO_FAILURE


        def literal_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{check.input}")
                    return ExitStatus::IO_FAILURE


        def search_status(check: SearchCheck) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            match check.mode:
                SearchMode.Regex:
                    return regex_status(check)
                SearchMode.Literal:
                    return literal_status(check)
                _:
                    return ExitStatus.FAILURE


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::LIMITS_MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILURE_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::BATCH_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::JOB_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::AWAITING_REAP},
                SearchCheck{input: inputs[0], pattern: Patterns::SKIPPED},
                SearchCheck{input: inputs[0], pattern: Patterns::BATCH_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::REAP_ACK},
                SearchCheck{input: inputs[0], pattern: Patterns::LAUNCH_AT},
                SearchCheck{input: inputs[0], pattern: Patterns::SKIP_AT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::JOB},
                SearchCheck{input: inputs[0], pattern: Patterns::DISPATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADMIT_NEXT},
                SearchCheck{input: inputs[0], pattern: Patterns::ADMIT_JOB},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE_DISPATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::JOBS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::PARALLEL_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::ATTEMPTS_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::PENDING_INDEX},
                SearchCheck{input: inputs[0], pattern: Patterns::ALL_TERMINAL},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUIRES_ATTEMPT},
                SearchCheck{input: inputs[0], pattern: Patterns::FAIL_FAST_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::AGGREGATE_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::RETRY_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_ACK_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::PARALLEL_LIMIT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_JOB_ID},
                SearchCheck{input: inputs[0], pattern: Patterns::RETRY_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::STALE_ATTEMPT},
                SearchCheck{input: inputs[0], pattern: Patterns::DISPATCH_MISMATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::REAP_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::ATTEMPT_TOKEN},
                SearchCheck{input: inputs[0], pattern: Patterns::REAP_ACKNOWLEDGED},
                SearchCheck{input: inputs[0], pattern: Patterns::QUEUED},
                SearchCheck{input: inputs[0], pattern: Patterns::ATTEMPT_COUNT_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::SKIPPED_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::SUCCEEDED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::DRAINING_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::FAIL_FAST_LATCHED},
                SearchCheck{input: inputs[0], pattern: Patterns::DRAINING},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::RUNNING_UNFINISHED},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLING_UNFINISHED},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILED_ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::FAIL_FAST_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLED_ZERO},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_LAUNCH},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_RETRY},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CANCEL_ACK},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_DUPLICATE_JOB},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ACCOUNTING},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_COMPLETED_CANCELLED},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_FAILED},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_FAILED_PENDING},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_DRAINING},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_AGGREGATE_LATCH},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_REAP_ACK},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STALE_ATTEMPT},
                SearchCheck{input: inputs[2], pattern: Patterns::RETRY_WITHOUT_REAP},
                SearchCheck{input: inputs[2], pattern: Patterns::STALE_REAP_RECEIPT},
                SearchCheck{input: inputs[2], pattern: Patterns::STALE_REAP_AGAIN},
                SearchCheck{input: inputs[2], pattern: Patterns::FAIL_FAST_CANCEL},
                SearchCheck{input: inputs[2], pattern: Patterns::FAIL_FAST_CANCEL_BEFORE_REAP},
                SearchCheck{input: inputs[2], pattern: Patterns::FAIL_FAST_RETRY_POLICY},
                SearchCheck{input: inputs[2], pattern: Patterns::FAIL_FAST_LATCH},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_RUNNING_COMPLETE},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_CANCELLING_COMPLETE},
                SearchCheck{input: inputs[2], pattern: Patterns::LAUNCH_LIMIT},
                SearchCheck{input: inputs[3], pattern: Patterns::SKIPS_VERIFIED_WORK, mode: SearchMode.Literal},
                SearchCheck{input: inputs[3], pattern: Patterns::SKIP_AT_ZERO, mode: SearchMode.Literal},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_SKIPPED, mode: SearchMode.Literal},
                SearchCheck{input: inputs[3], pattern: Patterns::REPEATED_SKIP, mode: SearchMode.Literal},
                SearchCheck{input: inputs[3], pattern: Patterns::FORGED_ATTEMPT, mode: SearchMode.Literal},
                SearchCheck{input: inputs[3], pattern: Patterns::EXACT_RETRY_TOKEN, mode: SearchMode.Literal},
                SearchCheck{input: inputs[3], pattern: Patterns::SCHEDULER_SELECTED_JOB, mode: SearchMode.Literal},
                SearchCheck{input: inputs[3], pattern: Patterns::FAIL_FAST_REAPS_CHILDREN, mode: SearchMode.Literal},
                SearchCheck{input: inputs[3], pattern: Patterns::ADMIT_NEXT_CALL, mode: SearchMode.Literal},
                SearchCheck{input: inputs[3], pattern: Patterns::ADMIT_JOB_CALL, mode: SearchMode.Literal},
                SearchCheck{input: inputs[3], pattern: Patterns::INVALID_INDEX, mode: SearchMode.Literal},
                SearchCheck{input: inputs[3], pattern: Patterns::VALIDATE_DISPATCH_CALL, mode: SearchMode.Literal},
                SearchCheck{input: inputs[3], pattern: Patterns::FORGED_REJECTED, mode: SearchMode.Literal},
                SearchCheck{input: inputs[3], pattern: Patterns::RETRIED_TOKEN, mode: SearchMode.Literal},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[5], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                status: mutable i64 = 0i64
                match check.mode:
                    SearchMode.Regex:
                        status <- regex_status(check)
                    SearchMode.Literal:
                        status <- literal_status(check)
                    _:
                        return ExitStatus::FAILURE
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DISPATCH_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsProcessBatchAudit::run_default()
