# Bounded Elisascript port of check_directory_tree.sh.
# Regex source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDirectoryTreeAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/directory_tree_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsDirectoryTree:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/directory_tree_model\.elisa\""
            SYMLINK_POLICY: Regex = regex"const enum DirectoryTreeSymlinkPolicy of u8"
            FAILURE_MODE: Regex = regex"const enum DirectoryTreeFailureMode of u8"
            ENTRY_KIND: Regex = regex"const enum DirectoryTreeEntryKind of u8"
            STATE: Regex = regex"const enum DirectoryTreeState of u8"
            EVENT: Regex = regex"const enum DirectoryTreeEvent of u8"
            POLICY: Regex = regex"struct DirectoryTreePolicy:"
            ENTRY: Regex = regex"struct DirectoryTreeEntry:"
            SESSION: Regex = regex"struct DirectoryTreeSession:"
            ERROR: Regex = regex"error DirectoryTreeError:"
            VALIDATE: Regex = regex"def validate_directory_tree\("
            ADVANCE: Regex = regex"def advance_directory_tree\("
            DEPTH_LIMIT: Regex = regex"Limits::DEPTH"
            ENTRY_LIMIT: Regex = regex"Limits::ENTRIES"
            BYTE_LIMIT: Regex = regex"Limits::BYTES"
            IDENTITY_LIMIT: Regex = regex"Limits::IDENTITIES"
            PATH_BYTES_LIMIT: Regex = regex"Limits::PATH_BYTES"
            IDENTITY_INDEX: Regex = regex"directory_tree_identity_index"
            DO_NOT_FOLLOW: Regex = regex"DirectoryTreeSymlinkPolicy.DoNotFollow"
            FOLLOW_DIRECTORIES: Regex = regex"DirectoryTreeSymlinkPolicy.FollowDirectories"
            COLLECT_FAILURES: Regex = regex"DirectoryTreeFailureMode.Collect"
            CYCLE: Regex = regex"DirectoryTreeError.CycleDetected"
            ENTRY_PATH_NUL: Regex = regex"raise DirectoryTreeError.EmbeddedNul if sview_contains_byte(entry.path, 0)"
            DEPTH_EXCEEDED: Regex = regex"DirectoryTreeError.DepthLimitExceeded"
            TRAVERSAL_DENIED: Regex = regex"DirectoryTreeError.SymlinkTraversalDenied"
            ACCOUNTING_INVALID: Regex = regex"DirectoryTreeError.AccountingInvalid"
            PLANNED: Regex = regex"DirectoryTreeState.Planned and"
            COMPLETE_WITH: Regex = regex"DirectoryTreeState.Complete and"
            CANCELLED_WITH: Regex = regex"DirectoryTreeState.Cancelled and"
            ACTIVE_DEPTH: Regex = regex"session.active_depth > session.entries.count"
            DESCEND: Regex = regex"DirectoryTreeEvent.Descend"
            ENTRY_DEPTH: Regex = regex"entry.depth != session.active_depth"
            CAN_DESCEND: Regex = regex"can_descend: bool = false"
            PARENT_DEPTH_MISMATCH: Regex = regex"raise DirectoryTreeError.ParentDepthMismatch if not session.can_descend"
            CLEAR_CAN_DESCEND: Regex = regex"session.can_descend <- false"
            LAST_SYMLINK: Regex = regex"last.kind == DirectoryTreeEntryKind.Symlink"
            FAILURE_LIMIT: Regex = regex"session.failures >= session.policy.max_entries"
            CANCEL: Regex = regex"DirectoryTreeEvent.Cancel"
            COMPLETE_STATE: Regex = regex"DirectoryTreeState.Complete"
            FIXTURE_IMPORT: Regex = regex"using EsDirectoryTree"
            FIXTURE_CONTRACT: Regex = regex"typed_directory_tree_contract_bounds_depth_and_cycles"
            FIXTURE_DESCEND: Regex = regex"DirectoryTreeEvent.Descend"
            FIXTURE_COMPLETE: Regex = regex"DirectoryTreeEvent.Complete"
            FIXTURE_CYCLE: Regex = regex"DirectoryTreeError.CycleDetected"
            FIXTURE_NOT_DIRECTORY: Regex = regex"DirectoryTreeError.NotDirectory"
            FIXTURE_PARENT_DEPTH: Regex = regex"DirectoryTreeError.ParentDepthMismatch"
            FIXTURE_NUL: Regex = regex"DirectoryTreeError.EmbeddedNul"
            FIXTURE_REPEATED_DESCEND: Regex = regex"repeated_descend_rejected"
            FIXTURE_ORPHAN_SCOPE: Regex = regex"forged_orphan_scope"
            FIXTURE_FOLLOW_SYMLINK: Regex = regex"follow_symlink"
            FIXTURE_SYMLINK_REJECTED: Regex = regex"symlink_descent_rejected"
            DOCS_SESSION: Regex = regex"EsDirectoryTree::DirectoryTreeSession"
            LEDGER_ITEM: Regex = regex"ES-FS-003"


        const module Messages:
            MISSING_ROOT: sview = "directory tree audit: missing repository root"
            UNRESOLVED_ROOT: sview = "directory tree audit: unable to resolve repository root"
            MISSING_INPUT: sview = "directory tree audit: missing "
            READ_FAILED: sview = "directory tree audit: unable to read source: "
            SUCCESS: sview = "directory tree audit: bounded depth, identity cycle checks, symlink policy, and cancellation are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::SYMLINK_POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILURE_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::DEPTH_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::BYTE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::IDENTITY_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::PATH_BYTES_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::IDENTITY_INDEX},
                SearchCheck{input: inputs[0], pattern: Patterns::DO_NOT_FOLLOW},
                SearchCheck{input: inputs[0], pattern: Patterns::FOLLOW_DIRECTORIES},
                SearchCheck{input: inputs[0], pattern: Patterns::COLLECT_FAILURES},
                SearchCheck{input: inputs[0], pattern: Patterns::CYCLE},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_PATH_NUL},
                SearchCheck{input: inputs[0], pattern: Patterns::DEPTH_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::TRAVERSAL_DENIED},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTING_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETE_WITH},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLED_WITH},
                SearchCheck{input: inputs[0], pattern: Patterns::ACTIVE_DEPTH},
                SearchCheck{input: inputs[0], pattern: Patterns::DESCEND},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_DEPTH},
                SearchCheck{input: inputs[0], pattern: Patterns::CAN_DESCEND},
                SearchCheck{input: inputs[0], pattern: Patterns::PARENT_DEPTH_MISMATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::CLEAR_CAN_DESCEND},
                SearchCheck{input: inputs[0], pattern: Patterns::LAST_SYMLINK},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILURE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPLETE_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_DESCEND},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_COMPLETE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CYCLE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_NOT_DIRECTORY},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_PARENT_DEPTH},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_NUL},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_REPEATED_DESCEND},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ORPHAN_SCOPE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_FOLLOW_SYMLINK},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_SYMLINK_REJECTED},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDirectoryTreeAudit::run_default()
