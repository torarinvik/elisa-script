# Bounded Elisascript port of check_differential_timeout_shrink.sh.
# Regex source checks stream through the shared line scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsDifferentialTimeoutShrinkAudit:
    private:
        const module Inputs:
            SOURCE: sview = "src/testing/timeout_shrink_model.elisa"
            FIXTURE: sview = "test/differential/elisascript_differential_test.elisa"
            DOCS: sview = "docs/differential-testing.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"module EsDifferentialTimeout:"
            USING_DIFFERENTIAL: Regex = regex"using EsDifferential"
            SIDE: Regex = regex"const enum DifferentialTimeoutSide of u8"
            STATE: Regex = regex"const enum DifferentialTimeoutState of u8"
            EVENT: Regex = regex"const enum DifferentialTimeoutEvent of u8"
            DECISION: Regex = regex"const enum DifferentialTimeoutDecision of u8"
            POLICY: Regex = regex"struct DifferentialTimeoutPolicy:"
            CANDIDATE: Regex = regex"struct DifferentialTimeoutCandidate:"
            SESSION: Regex = regex"struct DifferentialTimeoutSession:"
            ERROR: Regex = regex"error DifferentialTimeoutError:"
            MISMATCH_KIND: Regex = regex"mismatch_kind: DifferentialDifferenceKind"
            OBSERVED_KIND: Regex = regex"observed_kind: DifferentialDifferenceKind"
            DECISION_VALID: Regex = regex"def differential_timeout_decision_valid\("
            COMPARISON_KIND_VALID: Regex = regex"def differential_timeout_comparison_kind_valid\("
            VALIDATE: Regex = regex"def validate_differential_timeout\("
            ADVANCE: Regex = regex"def advance_differential_timeout\("
            CANDIDATE_LIMIT: Regex = regex"Limits::CANDIDATES"
            NOT_SMALLER: Regex = regex"CandidateNotSmaller"
            CANDIDATE_ORDER: Regex = regex"CandidateOrderInvalid"
            CANDIDATE_DECISION: Regex = regex"CandidateDecisionInvalid"
            MISMATCH_CATEGORY: Regex = regex"MismatchCategory"
            MINIMALITY_UNPROVEN: Regex = regex"MinimalityUnproven"
            EXHAUSTED_STATE: Regex = regex"session.exhausted and session.state != DifferentialTimeoutState.Complete"
            PLANNED_HISTORY: Regex = regex"session.state == DifferentialTimeoutState.Planned and \(session.current_timeout_steps != session.initial_timeout_steps or session.candidates.count != 0 or session.exhausted\)"
            HIDDEN_PENDING: Regex = regex"not session.has_pending and not differential_timeout_candidate_is_default\(session.pending\)"
            EXPECTED_TIMEOUT: Regex = regex"expected_timeout_steps: mutable u64 = session.initial_timeout_steps"
            CANDIDATE_TIMEOUT_ORDER: Regex = regex"candidate.timeout_steps >= expected_timeout_steps"
            DECISION_VALID_CALL: Regex = regex"differential_timeout_decision_valid\(candidate.decision\)"
            ACCEPTED_KIND: Regex = regex"candidate.decision == DifferentialTimeoutDecision.Accepted and candidate.observed_kind != session.policy.mismatch_kind"
            REJECTED_KIND: Regex = regex"candidate.decision == DifferentialTimeoutDecision.Rejected and candidate.observed_kind == session.policy.mismatch_kind"
            ABANDONED_FINAL: Regex = regex"candidate.decision == DifferentialTimeoutDecision.Abandoned and \(session.state != DifferentialTimeoutState.Cancelled or index \+ 1 != session.candidates.count\)"
            NON_EQUAL_MISMATCH: Regex = regex"policy.mismatch_kind != DifferentialDifferenceKind.Equal"
            CURRENT_TIMEOUT: Regex = regex"session.current_timeout_steps != expected_timeout_steps"
            REJECTED_DECISION: Regex = regex"decision: DifferentialTimeoutDecision.Rejected"
            ABANDONED_DECISION: Regex = regex"decision: DifferentialTimeoutDecision.Abandoned"
            PENDING_ORDINAL: Regex = regex"session.pending.ordinal != session.candidates.count"
            COMPARISON_FINGERPRINT: Regex = regex"comparison_fingerprint"
            EXHAUST_EVENT: Regex = regex"DifferentialTimeoutEvent.Exhaust"
            FIXTURE_IMPORT: Regex = regex"include \"../../src/testing/timeout_shrink_model.elisa\""
            FIXTURE_USING: Regex = regex"using EsDifferentialTimeout"
            FIXTURE_CONTRACT: Regex = regex"differential_timeout_shrinker_requires_monotonic_rerun_evidence"
            FIXTURE_NOT_SMALLER: Regex = regex"DifferentialTimeoutError.CandidateNotSmaller"
            FIXTURE_DECISION_INVALID: Regex = regex"DifferentialTimeoutError.CandidateDecisionInvalid"
            FIXTURE_EQUAL_MISMATCH: Regex = regex"mismatch_kind: DifferentialDifferenceKind.Equal"
            FIXTURE_POLICY_INVALID: Regex = regex"DifferentialTimeoutError.PolicyInvalid"
            HIDDEN_PENDING_REJECTED: Regex = regex"hidden_pending_rejected"
            PLANNED_HISTORY_REJECTED: Regex = regex"planned_history_rejected"
            FORGED_PLANNED_HISTORY: Regex = regex"forged_planned_history"
            INITIAL_TIMEOUT: Regex = regex"initial_timeout_steps: 16"
            REJECTED_CANDIDATE_ASSERT: Regex = regex"assert session.candidates.count == 1 and session.candidates\[0\].decision == DifferentialTimeoutDecision.Rejected"
            FIXTURE_ACCEPTED: Regex = regex"DifferentialTimeoutDecision.Accepted"
            FIXTURE_ABANDONED: Regex = regex"DifferentialTimeoutDecision.Abandoned"
            CANCELLED_PENDING_FINGERPRINT: Regex = regex"cancelled_pending.candidates\[0\].comparison_fingerprint == 96"
            ABANDONED_WHILE_RUNNING: Regex = regex"abandoned_while_running"
            INVALID_REJECT: Regex = regex"invalid_reject"
            INVALID_ACCEPT: Regex = regex"invalid_accept"
            FORGED_TIMEOUT_CANDIDATES: Regex = regex"forged_timeout_candidates"
            DOCS_SESSION: Regex = regex"EsDifferentialTimeout::DifferentialTimeoutSession"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-028"


        const module Messages:
            MISSING_ROOT: sview = "differential timeout-shrink audit: missing repository root"
            UNRESOLVED_ROOT: sview = "differential timeout-shrink audit: unable to resolve repository root"
            MISSING_INPUT: sview = "differential timeout-shrink audit: missing "
            READ_FAILED: sview = "differential timeout-shrink audit: unable to read source: "
            SUCCESS: sview = "differential timeout-shrink audit: accepted, rejected, and abandoned attempts are retained with explicit exhaustion"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::USING_DIFFERENTIAL},
                SearchCheck{input: inputs[0], pattern: Patterns::SIDE},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::DECISION},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::CANDIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::MISMATCH_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::OBSERVED_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::DECISION_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPARISON_KIND_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::CANDIDATE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::NOT_SMALLER},
                SearchCheck{input: inputs[0], pattern: Patterns::CANDIDATE_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::CANDIDATE_DECISION},
                SearchCheck{input: inputs[0], pattern: Patterns::MISMATCH_CATEGORY},
                SearchCheck{input: inputs[0], pattern: Patterns::MINIMALITY_UNPROVEN},
                SearchCheck{input: inputs[0], pattern: Patterns::EXHAUSTED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::PLANNED_HISTORY},
                SearchCheck{input: inputs[0], pattern: Patterns::HIDDEN_PENDING},
                SearchCheck{input: inputs[0], pattern: Patterns::EXPECTED_TIMEOUT},
                SearchCheck{input: inputs[0], pattern: Patterns::CANDIDATE_TIMEOUT_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::DECISION_VALID_CALL},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCEPTED_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::REJECTED_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::ABANDONED_FINAL},
                SearchCheck{input: inputs[0], pattern: Patterns::NON_EQUAL_MISMATCH},
                SearchCheck{input: inputs[0], pattern: Patterns::CURRENT_TIMEOUT},
                SearchCheck{input: inputs[0], pattern: Patterns::REJECTED_DECISION},
                SearchCheck{input: inputs[0], pattern: Patterns::ABANDONED_DECISION},
                SearchCheck{input: inputs[0], pattern: Patterns::PENDING_ORDINAL},
                SearchCheck{input: inputs[0], pattern: Patterns::COMPARISON_FINGERPRINT},
                SearchCheck{input: inputs[0], pattern: Patterns::EXHAUST_EVENT},
                SearchCheck{input: inputs[1], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[1], pattern: Patterns::FIXTURE_USING},
                SearchCheck{input: inputs[1], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[1], pattern: Patterns::FIXTURE_NOT_SMALLER},
                SearchCheck{input: inputs[1], pattern: Patterns::FIXTURE_DECISION_INVALID},
                SearchCheck{input: inputs[1], pattern: Patterns::FIXTURE_EQUAL_MISMATCH},
                SearchCheck{input: inputs[1], pattern: Patterns::FIXTURE_POLICY_INVALID},
                SearchCheck{input: inputs[1], pattern: Patterns::HIDDEN_PENDING_REJECTED},
                SearchCheck{input: inputs[1], pattern: Patterns::PLANNED_HISTORY_REJECTED},
                SearchCheck{input: inputs[1], pattern: Patterns::FORGED_PLANNED_HISTORY},
                SearchCheck{input: inputs[1], pattern: Patterns::INITIAL_TIMEOUT},
                SearchCheck{input: inputs[1], pattern: Patterns::REJECTED_CANDIDATE_ASSERT},
                SearchCheck{input: inputs[1], pattern: Patterns::FIXTURE_ACCEPTED},
                SearchCheck{input: inputs[1], pattern: Patterns::FIXTURE_ABANDONED},
                SearchCheck{input: inputs[1], pattern: Patterns::CANCELLED_PENDING_FINGERPRINT},
                SearchCheck{input: inputs[1], pattern: Patterns::ABANDONED_WHILE_RUNNING},
                SearchCheck{input: inputs[1], pattern: Patterns::INVALID_REJECT},
                SearchCheck{input: inputs[1], pattern: Patterns::INVALID_ACCEPT},
                SearchCheck{input: inputs[1], pattern: Patterns::FORGED_TIMEOUT_CANDIDATES},
                SearchCheck{input: inputs[2], pattern: Patterns::DOCS_SESSION},
                SearchCheck{input: inputs[3], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::SOURCE),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsDifferentialTimeoutShrinkAudit::run_default()
