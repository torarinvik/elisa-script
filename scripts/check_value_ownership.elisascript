# Bounded Elisascript port of check_value_ownership.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsValueOwnershipAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/value_ownership_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "module EsValueOwnership:"
            MODEL_IMPORT: sview = "include \"../runtime/value_ownership_model.elisa\""
            OWNERSHIP_KIND: sview = "const enum ValueOwnershipKind of u8"
            OWNERSHIP_STATE: sview = "const enum ValueOwnershipState of u8"
            BORROW_STATE: sview = "const enum BorrowLeaseState of u8"
            VALUE_LEASE: sview = "struct ValueLease:"
            BORROW_LEASE: sview = "struct BorrowLease:"
            LEDGER: sview = "struct ValueOwnershipLedger:"
            ERROR: sview = "error ValueOwnershipError:"
            VALIDATE: sview = "def validate_value_ownership("
            ACQUIRE: sview = "def value_ownership_acquire("
            ADVANCE: sview = "def advance_value_ownership("
            VALUE_LIMIT: sview = "Limits::VALUES"
            BORROW_LIMIT: sview = "Limits::BORROWS"
            BYTE_LIMIT: sview = "Limits::BYTES"
            LINEAR_KIND: sview = "ValueOwnershipKind.Linear"
            BORROWED_VIEW_KIND: sview = "ValueOwnershipKind.BorrowedView"
            BEGIN_BORROW: sview = "ValueOwnershipEvent.BeginBorrow"
            BORROW_CONFLICT: sview = "ValueOwnershipError.BorrowConflict"
            VALUE_NOT_OWNED: sview = "value.state != ValueOwnershipState.Owned"
            DROPPED_BYTES: sview = "value.state == ValueOwnershipState.Dropped and value.bytes != 0"
            MOVE_NOT_READY: sview = "ValueOwnershipError.MoveNotReady"
            DROP_NOT_READY: sview = "ValueOwnershipError.DropNotReady"
            FIXTURE_IMPORT: sview = "using EsValueOwnership"
            FIXTURE_CONTRACT: sview = "typed_value_ownership_contract_bounds_borrows_moves_and_reclamation"
            FIXTURE_LINEAR: sview = "ValueOwnershipKind.Linear"
            FIXTURE_END_BORROW: sview = "ValueOwnershipEvent.EndBorrow"
            FIXTURE_MOVE_NOT_READY: sview = "ValueOwnershipError.MoveNotReady"
            FIXTURE_BORROW_CONFLICT: sview = "ValueOwnershipError.BorrowConflict"
            FIXTURE_RETAINED_BYTES: sview = "ledger.retained_bytes"
            DOCS_LEDGER: sview = "EsValueOwnership::ValueOwnershipLedger"
            LEDGER_ITEM: sview = "ES-SCRIPT-042"


        const module Messages:
            MISSING_ROOT: sview = "value ownership audit: missing repository root"
            UNRESOLVED_ROOT: sview = "value ownership audit: unable to resolve repository root"
            MISSING_INPUT: sview = "value ownership audit: missing "
            READ_FAILED: sview = "value ownership audit: unable to read source: "
            SUCCESS: sview = "value ownership audit: bounded arena, borrow, move, and reclamation semantics are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview
            line_prefix: bool = false


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE, line_prefix: true},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::OWNERSHIP_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::OWNERSHIP_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::BORROW_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::VALUE_LEASE},
                SearchCheck{input: inputs[0], pattern: Patterns::BORROW_LEASE},
                SearchCheck{input: inputs[0], pattern: Patterns::LEDGER},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::ACQUIRE},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::VALUE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::BORROW_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::BYTE_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::LINEAR_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::BORROWED_VIEW_KIND},
                SearchCheck{input: inputs[0], pattern: Patterns::BEGIN_BORROW},
                SearchCheck{input: inputs[0], pattern: Patterns::BORROW_CONFLICT},
                SearchCheck{input: inputs[0], pattern: Patterns::VALUE_NOT_OWNED},
                SearchCheck{input: inputs[0], pattern: Patterns::DROPPED_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::MOVE_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::DROP_NOT_READY},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_LINEAR},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_END_BORROW},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_MOVE_NOT_READY},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_BORROW_CONFLICT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_RETAINED_BYTES},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_LEDGER},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def has_line(path: Path, needle: sview, line_prefix: bool = false) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle, "", "", line_prefix):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            for check in searches(inputs):
                status: i64 = has_line(check.input, check.pattern, check.line_prefix)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsValueOwnershipAudit::run_default()
