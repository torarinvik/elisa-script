# Bounded Elisascript port of check_regex_capture_capacity.sh.
# Function-scoped and file-wide lexical checks stream without awk or rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsRegexCaptureCapacityAudit:
    private:
        const module Inputs:
            INTERPRETER: sview = "src/ir/interpret.elisa"
            INTERPRETER_FIXTURE: sview = "test/ir/elisascript_interpreter_test.elisa"
            BYTECODE_FIXTURE: sview = "test/ir/elisascript_bytecode_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            CAPTURE_FUNCTION: sview = "def evaluate_regex_capture("
            NAMED_CAPTURE_FUNCTION: sview = "def evaluate_regex_capture_named("
            MATCHER_ACCOUNT: sview = "regex_work_account(machine, budget)"
            RESULT_PREFLIGHT: sview = "runtime_storage_span_u32_valid(storage, result_count)"
            PATTERN_CHARGE: sview = "runtime_storage_text_fields_u32_valid(storage, sview_len(pattern.text))"
            TEXT_FIELDS_HELPER: sview = "runtime_storage_text_fields_u32_valid"
            CAPTURE_REGEX: sview = "capture_regex"
            DOCS: sview = "sizes the exact proven group/name result"
            LEDGER: sview = "exact proven"


        const module Messages:
            MISSING_ROOT: sview = "regex capture capacity audit: missing repository root"
            UNRESOLVED_ROOT: sview = "regex capture capacity audit: unable to resolve repository root"
            MISSING_INPUT: sview = "regex capture capacity audit: missing "
            INCOMPLETE: sview = "regex capture capacity audit: exact post-match sizing is incomplete"
            WRONG_ORDER: sview = "regex capture capacity audit: exact sizing precedes matcher accounting"
            NAMED_LOOKUP: sview = "regex capture capacity audit: scalar named lookup still charges text-field storage"
            READ_FAILED: sview = "regex capture capacity audit: unable to read source: "
            SUCCESS: sview = "regex capture capacity audit: exact proven result slots are preflighted after matcher accounting"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::INTERPRETER_FIXTURE),
                root.joinpath(Inputs::BYTECODE_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            capture_body: EsSourceFunctionScope::FunctionBody = try EsSourceFunctionScope::read_function_body(inputs[0], Patterns::CAPTURE_FUNCTION) else err:
                diagnostic(Messages::READ_FAILED + f"{inputs[0]}")
                return ExitStatus::IO_FAILURE
            matcher_line: usize = EsSourceFunctionScope::last_line_number(capture_body.text, Patterns::MATCHER_ACCOUNT)
            exact_line: usize = EsSourceFunctionScope::first_line_number(capture_body.text, Patterns::RESULT_PREFLIGHT)
            pattern_charge_line: usize = EsSourceFunctionScope::first_line_number(capture_body.text, Patterns::PATTERN_CHARGE)
            if matcher_line == 0 or exact_line == 0 or pattern_charge_line != 0:
                diagnostic(Messages::INCOMPLETE)
                return ExitStatus::FAILURE
            if matcher_line >= exact_line:
                diagnostic(Messages::WRONG_ORDER)
                return ExitStatus::FAILURE

            status: mutable i64 = has_line(inputs[1], Patterns::CAPTURE_REGEX)
            return status if status != 0i64
            status <- has_line(inputs[2], Patterns::CAPTURE_REGEX)
            return status if status != 0i64

            named_body: EsSourceFunctionScope::FunctionBody = try EsSourceFunctionScope::read_function_body(inputs[0], Patterns::NAMED_CAPTURE_FUNCTION) else err:
                diagnostic(Messages::READ_FAILED + f"{inputs[0]}")
                return ExitStatus::IO_FAILURE
            if EsSourceFunctionScope::contains(named_body.text, Patterns::TEXT_FIELDS_HELPER):
                diagnostic(Messages::NAMED_LOOKUP)
                return ExitStatus::FAILURE

            status <- has_line(inputs[3], Patterns::DOCS)
            return status if status != 0i64
            status <- has_line(inputs[4], Patterns::LEDGER)
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsRegexCaptureCapacityAudit::run_default()
