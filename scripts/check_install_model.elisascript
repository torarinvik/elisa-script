# Bounded Elisascript port of check_install_model.sh.
# Typed install-model contracts are checked as ordered fixed-string source data.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsInstallModelAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/install_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"


        const module Messages:
            MISSING_ROOT: sview = "install model audit: missing repository root"
            UNRESOLVED_ROOT: sview = "install model audit: unable to resolve repository root"
            MISSING_INPUT: sview = "install model audit: missing "
            READ_FAILED: sview = "install model audit: unable to read source: "
            SUCCESS: sview = "install model audit: typed artifact targets, integrity admission, publication transitions, and rollback are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            declarations: darray[sview] = [
                "module EsInstall:",
                "INSTALL_FORMAT_VERSION",
                "INSTALL_MAX_TOTAL_ARTIFACT_BYTES",
                "const enum InstallTarget of u8:",
                "const enum InstallScope of u8:",
                "const enum InstallState of u8:",
                "struct InstallArtifact:",
                "struct InstallPlan:",
                "error InstallContractError:",
                "EmptyPlan",
                "PackageVersionInvalid",
                "def validate_install_plan(",
                "def advance_install_plan("
            ]
            status: mutable i64 = 0i64
            for declaration in declarations:
                status <- has_line(inputs[0], declaration)
                return status if status != 0i64

            boundaries: darray[sview] = [
                "plan.artifacts.count == 0",
                "SourceExtensionInvalid",
                "ArtifactBytesExceeded",
                "total_bytes",
                "total_bytes > INSTALL_MAX_TOTAL_ARTIFACT_BYTES",
                "INSTALL_MAX_TOTAL_ARTIFACT_BYTES - total_bytes",
                "IntegrityMissing",
                "DuplicateDestination",
                "plan.state == InstallState.Published",
                "RollbackNotReady"
            ]
            for boundary in boundaries:
                status <- has_line(inputs[0], boundary)
                return status if status != 0i64

            status <- has_line(inputs[1], "include \"../runtime/install_model.elisa\"")
            return status if status != 0i64

            fixture_patterns: darray[sview] = [
                "typed_install_plan_publishes_and_rolls_back_integrity_bound_artifacts",
                "InstallEvent.Stage",
                "InstallEvent.Rollback",
                "InstallContractError.DuplicateDestination",
                "aggregate_rejected"
            ]
            for pattern in fixture_patterns:
                status <- has_line(inputs[2], pattern)
                return status if status != 0i64

            status <- has_line(inputs[3], "`EsInstall` makes release publication a typed state machine")
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsInstallModelAudit::run_default()
