                SearchCheck{input: inputs[6], pattern: Patterns::OUTPUT_LIMIT_ARGUMENT},
                SearchCheck{input: inputs[13], pattern: Patterns::INTERPRETER_CAPTURE_LIMIT},
                SearchCheck{input: inputs[14], pattern: Patterns::BYTECODE_CAPTURE_LIMIT},
                SearchCheck{input: inputs[13], pattern: Patterns::INTERPRETER_CWD_POLICY},
                SearchCheck{input: inputs[14], pattern: Patterns::BYTECODE_CWD_POLICY},
                SearchCheck{input: inputs[15], pattern: Patterns::REGISTRY_CAPTURE_POLICY},
                SearchCheck{input: inputs[9], pattern: Patterns::CAPTURE_DIRECTORY_ENV},
                SearchCheck{input: inputs[6], pattern: Patterns::DEFAULT_OUTPUT_LIMIT},
                SearchCheck{input: inputs[6], pattern: Patterns::CAPTURE_DIRECTORY_SIGNATURE},
                SearchCheck{input: inputs[21], pattern: Patterns::REGISTRY_DIRECTORY_ENV},
                SearchCheck{input: inputs[6], pattern: Patterns::PROCESS_TIMEOUT_ADMITTED},
                SearchCheck{input: inputs[6], pattern: Patterns::PROCESS_TIMEOUT_CHECK},
                SearchCheck{input: inputs[6], pattern: Patterns::PROCESS_TIMEOUT_LIMIT},
                SearchCheck{input: inputs[6], pattern: Patterns::CLOCK_START},
                SearchCheck{input: inputs[6], pattern: Patterns::DEADLINE_REACHED},
                SearchCheck{input: inputs[6], pattern: Patterns::CLOCK_STARTED},
                SearchCheck{input: inputs[6], pattern: Patterns::ELAPSED_DEADLINE},
                SearchCheck{input: inputs[6], pattern: Patterns::CHECK_DEADLINE},
                SearchCheck{input: inputs[6], pattern: Patterns::TIMED_OUT_SET},
                SearchCheck{input: inputs[6], pattern: Patterns::TERMINATE_GROUP},
                SearchCheck{input: inputs[18], pattern: Patterns::CLOCK_BORROW_FIXTURE},
                SearchCheck{input: inputs[18], pattern: Patterns::ROUND_UP_FIXTURE},
                SearchCheck{input: inputs[18], pattern: Patterns::CONVERSION_BOUNDED_FIXTURE}
            ]


        def boundaries(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::BOUND_HANDLE_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::HANDLES_DISTINCT},
                SearchCheck{input: inputs[0], pattern: Patterns::STDIN_RESOURCE},
                SearchCheck{input: inputs[0], pattern: Patterns::STDIN_MODE},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_LIMIT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::POLL_LIMIT_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_OUTCOME},
                SearchCheck{input: inputs[0], pattern: Patterns::EXITED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EXIT_STATUS_SET},
                SearchCheck{input: inputs[0], pattern: Patterns::NEGATIVE_EXIT_STATUS},
                SearchCheck{input: inputs[0], pattern: Patterns::NONZERO_NOT_EXITED},
                SearchCheck{input: inputs[0], pattern: Patterns::CREATED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::CREATED_SPAWN_FAILURE},
                SearchCheck{input: inputs[0], pattern: Patterns::RUNNING_COLLECTING},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILED_HOST_IO},
                SearchCheck{input: inputs[0], pattern: Patterns::TIMED_OUT_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::OUTPUT_LIMIT_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::ELAPSED_EQUALS_TIMEOUT},
                SearchCheck{input: inputs[0], pattern: Patterns::ELAPSED_ASSIGNMENT},
                SearchCheck{input: inputs[0], pattern: Patterns::EXIT_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCEL_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTING_INVALID}
            ]


        def fixtures(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[16], pattern: Patterns::COMMAND_CEILING_FIXTURE},
                SearchCheck{input: inputs[16], pattern: Patterns::CANNOT_WIDEN_FIXTURE},
                SearchCheck{input: inputs[16], pattern: Patterns::DEADLINE_ENFORCED_FIXTURE},
                SearchCheck{input: inputs[16], pattern: Patterns::DEADLINE_SATURATES_FIXTURE},
                SearchCheck{input: inputs[16], pattern: Patterns::EARLY_EXIT_FIXTURE},
                SearchCheck{input: inputs[16], pattern: Patterns::TIMEOUT_ACK_PENDING},
                SearchCheck{input: inputs[16], pattern: Patterns::CLOCK_SAMPLE_MISSING},
                SearchCheck{input: inputs[16], pattern: Patterns::INVALID_LIMIT},
                SearchCheck{input: inputs[4], pattern: Patterns::SESSION_IR_IMPORT},
                SearchCheck{input: inputs[11], pattern: Patterns::SESSION_USING},
                SearchCheck{input: inputs[11], pattern: Patterns::SESSION_CONTRACT_FIXTURE},
                SearchCheck{input: inputs[11], pattern: Patterns::SPAWN_EVENT},
                SearchCheck{input: inputs[11], pattern: Patterns::STDOUT_EVENT},
                SearchCheck{input: inputs[11], pattern: Patterns::EXIT_EVENT},
                SearchCheck{input: inputs[11], pattern: Patterns::CANCEL_ACK_EVENT},
                SearchCheck{input: inputs[11], pattern: Patterns::FORGED_ACTIVE},
                SearchCheck{input: inputs[11], pattern: Patterns::FORGED_TIMEOUT},
                SearchCheck{input: inputs[11], pattern: Patterns::EXIT_STATUS_FIXTURE},
                SearchCheck{input: inputs[19], pattern: Patterns::DOCS_CONTRACT},
                SearchCheck{input: inputs[20], pattern: Patterns::LEDGER_CONTRACT}
            ]


        def execute_all(inputs: darray[Path]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = execute(declarations(inputs))
            return status if status != 0i64
            status <- execute(contracts(inputs))
            return status if status != 0i64
            status <- execute(boundaries(inputs))
            return status if status != 0i64
            status <- execute(fixtures(inputs))
            return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::CLOCK_MODEL),
                root.joinpath(Inputs::TIME_BRIDGE),
                root.joinpath(Inputs::PROCESS_MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::EXECUTION),
                root.joinpath(Inputs::INTERPRETER),
                root.joinpath(Inputs::LOWERER),
                root.joinpath(Inputs::VERIFIER),
                root.joinpath(Inputs::BYTECODE),
                root.joinpath(Inputs::SEMANTIC_BUILTIN_CHECKER),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::LOWERING_FIXTURE),
                root.joinpath(Inputs::INTERPRETER_FIXTURE),
                root.joinpath(Inputs::BYTECODE_FIXTURE),
                root.joinpath(Inputs::SEMANTIC_FIXTURE),
                root.joinpath(Inputs::COMMAND_POLICY_FIXTURE),
                root.joinpath(Inputs::EXIT_DEADLINE_FIXTURE),
                root.joinpath(Inputs::CLOCK_FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER),
                root.joinpath(Inputs::BUILTIN_REGISTRY)
            ]
            required_inputs: darray[Path] = [
                inputs[0], inputs[1], inputs[2], inputs[3], inputs[4], inputs[5],
                inputs[6], inputs[7], inputs[8], inputs[9], inputs[10], inputs[11],
                inputs[12], inputs[13], inputs[14], inputs[15], inputs[16], inputs[17],
                inputs[18], inputs[19], inputs[20]
            ]
            for input_path in required_inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE
            status: i64 = execute_all(inputs)
            return status if status != 0i64
            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsProcessSessionAudit::run_default()
