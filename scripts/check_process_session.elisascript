            return [
                SearchCheck{input: inputs[0], pattern: Patterns::TERMINAL_EXIT_RECEIPTS},
                SearchCheck{input: inputs[0], pattern: Patterns::NEXT_ELAPSED_ASSIGNMENT},
                SearchCheck{input: inputs[17], pattern: Patterns::DEADLINE_CLOCK_REQUIRED},
