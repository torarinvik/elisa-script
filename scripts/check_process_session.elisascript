        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


        def declarations(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION_MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_POLLS},
                SearchCheck{input: inputs[0], pattern: Patterns::MAX_OUTPUT},
                SearchCheck{input: inputs[0], pattern: Patterns::SESSION_FOR_COMMAND},
                SearchCheck{input: inputs[0], pattern: Patterns::ELAPSED_STATE_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::NEXT_ELAPSED},
                SearchCheck{input: inputs[0], pattern: Patterns::ELAPSED_SAMPLED},
                SearchCheck{input: inputs[0], pattern: Patterns::TIMING_OUT},
                SearchCheck{input: inputs[0], pattern: Patterns::TIMEOUT_ACK},
                SearchCheck{input: inputs[0], pattern: Patterns::TIMEOUT_NOT_READY},
