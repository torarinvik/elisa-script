# Streaming Elisascript port of check_differential_resources.sh.
# Keep the shell oracle until its public-launcher parity contract is qualified.

include "./shell_invocation_path.elisascript"

module EsDifferentialResourcesAudit:
    private:
        const module Inputs:
            SOURCE: sview = "src/testing/differential.elisa"
            FIXTURE: sview = "test/differential/elisascript_differential_test.elisa"
            DOCS: sview = "docs/differential-testing.md"


        const module Patterns:
            RESOURCE_DIFFERENCE_KIND: sview = "const enum DifferentialResourceDifferenceKind of u8:"
            RESOURCE_COMPARISON: sview = "struct DifferentialResourceComparison:"
            RESOURCE_USAGE_COMPARISON: sview = "def compare_differential_resource_usage("
            RESOURCE_POLICY: sview = "resource_policy_known"
            OPEN_HANDLES: sview = "OpenHandles"
            CONCURRENT_TASKS: sview = "ConcurrentTasks"
            UNKNOWN_SNAPSHOTS: sview = "resource snapshots are not known for both runs"
            OPEN_HANDLE_CLEANUP: sview = "open-handle cleanup usage differs"
            FIXTURE_CONTRACT: sview = "differential_resource_comparison_contract_reports_known_cleanup_differences"
            FIXTURE_EQUAL: sview = "DifferentialResourceDifferenceKind.Equal"
            FIXTURE_OPEN_HANDLES: sview = "DifferentialResourceDifferenceKind.OpenHandles"
            FIXTURE_UNKNOWN: sview = "DifferentialResourceDifferenceKind.Unknown"
            DOCS_COMPARISON: sview = "compare_differential_resource_usage"


        const module Messages:
            MISSING_ROOT: sview = "differential resource audit: missing repository root"
            UNRESOLVED_ROOT: sview = "differential resource audit: unable to resolve repository root"
            MISSING_INPUT: sview = "differential resource audit: missing "
            RG_UNAVAILABLE: sview = "differential resource audit: unable to run rg"
            RG_FAILED_TO_RUN: sview = "differential resource audit: rg failed to run"


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(source: Path, fixture: Path, docs: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: source, pattern: Patterns::RESOURCE_DIFFERENCE_KIND},
                SearchCheck{input: source, pattern: Patterns::RESOURCE_COMPARISON},
                SearchCheck{input: source, pattern: Patterns::RESOURCE_USAGE_COMPARISON},
                SearchCheck{input: source, pattern: Patterns::RESOURCE_POLICY},
                SearchCheck{input: source, pattern: Patterns::OPEN_HANDLES},
                SearchCheck{input: source, pattern: Patterns::CONCURRENT_TASKS},
                SearchCheck{input: source, pattern: Patterns::UNKNOWN_SNAPSHOTS},
                SearchCheck{input: source, pattern: Patterns::OPEN_HANDLE_CLEANUP},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_EQUAL},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_OPEN_HANDLES},
                SearchCheck{input: fixture, pattern: Patterns::FIXTURE_UNKNOWN},
                SearchCheck{input: docs, pattern: Patterns::DOCS_COMPARISON}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Environment.Read, File.Read, Directory.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            rg: Executable = try executable("rg") else err:
                diagnostic(Messages::RG_UNAVAILABLE)
                return 127i64
            for check in checks:
                arguments: darray[sview] = ["-Fq", check.pattern, f"{check.input}"]
                status: i64 = try run_process(rg, arguments, 0i64) else err:
                    diagnostic(Messages::RG_FAILED_TO_RUN)
                    return 127i64
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return 1i64
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::SOURCE),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return 1i64

            status: i64 = execute(searches(inputs[0], inputs[1], inputs[2]))
            return status if status != 0i64

            print("differential resource audit: known/unknown resource snapshots and cleanup counters are compared explicitly")
            return 0i64


        def run_default() -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsDifferentialResourcesAudit::run_default()
