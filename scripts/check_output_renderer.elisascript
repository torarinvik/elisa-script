# Bounded Elisascript port of check_output_renderer.sh.
# Fixed source contracts use the shared bounded literal line scanner.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsOutputRendererAudit:
    private:
        const module Inputs:
            TRANSPORT_POSIX: sview = "src/runtime/output_transport_posix.elisa"
            MODEL: sview = "src/runtime/output_renderer_model.elisa"
            TRANSPORT: sview = "src/runtime/output_transport_model.elisa"
            OUTPUT_MODEL: sview = "src/runtime/output_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            EXECUTION: sview = "src/ir/execution.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            POSIX_MODULE: sview = "module EsOutputTransportPosix:"
            POSIX_LIMITS: sview = "const module Limits:"
            POSIX_WRITE_CALLS: sview = "WRITE_CALLS: usize = 1048576"
            POSIX_ERROR: sview = "error OutputTransportPosixError:"
            WRITE_DOCUMENT_FD: sview = "def write_output_document_fd("
            WRITE_TRANSPORT_FD: sview = "def write_output_transport_fd("
            TRANSPORT_NOT_PLANNED: sview = "transport.state != OutputTransportState.Planned"
            EINTR: sview = "DarwinErrno::EINTR"
            ACK_PAYLOAD: sview = "acknowledge_output_transport_payload("
            WRITE_AMOUNT_BOUND: sview = "amount == 0 or amount.usize() > remaining"
            ACK_STATE: sview = "OutputTransportPosixWriteState.Acknowledge"
            FAIL_EVENT: sview = "OutputTransportEvent.Fail"
            WRITE_FAILED: sview = "OutputTransportPosixError.WriteFailed("
            WRITE_CALL_LIMIT: sview = "OutputTransportPosixError.WriteCallLimitExceeded"
            RENDER_MODULE: sview = "module EsOutputRender:"
            RENDER_LIMITS: sview = "const module Limits:"
            CHUNKS_LIMIT: sview = "Limits::CHUNKS"
            CHUNKS_BOUND: sview = "CHUNKS: usize = EsOutput::Limits::RECORDS + 2"
            RENDER_STATE: sview = "const enum OutputRenderState of u8:"
            RENDER_EVENT: sview = "const enum OutputRenderEvent of u8:"
            FRAME_KIND: sview = "const enum OutputRenderFrameKind of u8:"
            RENDER_FRAME: sview = "struct OutputRenderFrame:"
            RENDER: sview = "struct OutputRender:"
            RENDER_ERROR: sview = "error OutputRenderError:"
            VALIDATE_RENDER: sview = "def validate_output_render("
            ADVANCE_RENDER: sview = "def advance_output_render("
            JSON_ESCAPED_BYTES: sview = "output_render_json_escaped_bytes"
            XML_ESCAPED_BYTES: sview = "output_render_xml_escaped_bytes"
            ACCUMULATE: sview = "output_render_accumulate"
            EXPECTED_EMITTED_BYTES: sview = "output_render_expected_emitted_bytes"
            HEADER_BYTES: sview = "output_render_header_bytes"
            FOOTER_BYTES: sview = "output_render_footer_bytes"
            DOCUMENT_NOT_SEALED: sview = "DocumentNotSealed"
            DOCUMENT_SEALED_CHECK: sview = "render.document.state != OutputDocumentState.Sealed"
            RECORD_ORDER_INVALID: sview = "RecordOrderInvalid"
            RECORD_INDEX_NONZERO: sview = "record_index != 0"
            ACCOUNTING_INVALID: sview = "AccountingInvalid"
            RENDER_LIMIT_EXCEEDED: sview = "RenderLimitExceeded"
            INCOMPLETE: sview = "Incomplete"
            CANCEL_NOT_READY: sview = "CancelNotReady"
            TRANSPORT_MODULE: sview = "module EsOutputTransport:"
            TRANSPORT_LIMITS: sview = "const module Limits:"
            TRANSPORT_STATE: sview = "const enum OutputTransportState of u8:"
            TRANSPORT_EVENT: sview = "const enum OutputTransportEvent of u8:"
            TRANSPORT_POLICY: sview = "struct OutputTransportPolicy:"
            TRANSPORT: sview = "struct OutputTransport:"
            TRANSPORT_ERROR: sview = "error OutputTransportError:"
            VALIDATE_TRANSPORT: sview = "def validate_output_transport("
            BEGIN_TRANSPORT: sview = "def begin_output_transport("
            PEEK_FRAME: sview = "def peek_output_transport_frame("
            ADVANCE_TRANSPORT: sview = "def advance_output_transport("
            FRAME_MISMATCH: sview = "FrameMismatch"
            FRAME_ORDER_INVALID: sview = "FrameOrderInvalid"
            FRAME_TOO_LARGE: sview = "FrameTooLarge"
            SHORT_WRITE: sview = "ShortWrite"
            UNEXPECTED_PAYLOAD: sview = "UnexpectedPayload"
            MAX_FRAME_BYTES: sview = "max_frame_bytes"
            FRAME_MATCHES: sview = "output_transport_frame_matches"
            PLANNED_PREFLIGHT: sview = "output_transport_planned_preflight"
            EMPTY_PAYLOAD: sview = "output_transport_frame_is_empty_payload"
            CANCELLING_STATE: sview = "OutputTransportState.Cancelling"
            CANCELLED_STATE: sview = "OutputTransportState.Cancelled"
            IR_RENDER_IMPORT: sview = "include \"../runtime/output_renderer_model.elisa\""
            IR_TRANSPORT_IMPORT: sview = "include \"../runtime/output_transport_model.elisa\""
            IR_POSIX_IMPORT: sview = "include \"../runtime/output_transport_posix.elisa\""
            EXECUTION_POSIX_IMPORT: sview = "include \"../runtime/output_transport_posix.elisa\""
            FIXTURE_RENDER_IMPORT: sview = "using EsOutputRender"
            FIXTURE_TRANSPORT_IMPORT: sview = "using EsOutputTransport"
            FIXTURE_POSIX_IMPORT: sview = "using EsOutputTransportPosix"
            RENDER_CONTRACT: sview = "typed_output_renderer_contract_is_ordered_escaped_and_cancelable"
            EMIT_EVENT: sview = "OutputRenderEvent.Emit"
            FINISH_EVENT: sview = "OutputRenderEvent.Finish"
            CANCEL_ACK: sview = "OutputRenderEvent.CancelAck"
            COMPLETE_STATE: sview = "OutputRenderState.Complete"
            RENDER_BUDGET_REJECTED: sview = "render_budget_rejected"
            FORGED_EMITTED_REJECTED: sview = "forged_emitted_rejected"
            EXTRA_RENDER_PAYLOAD: sview = "extraneous_render_payload_rejected"
            TRANSPORT_CONTRACT: sview = "typed_output_transport_binds_frames_to_exact_host_acknowledgements"
            TRANSPORT_EMIT_EVENT: sview = "OutputTransportEvent.Emit"
            TRANSPORT_FRAME_MISMATCH: sview = "OutputTransportError.FrameMismatch"
            POSIX_INVALID_DESCRIPTOR: sview = "OutputTransportPosixError.InvalidDescriptor"
            FORGED_CHUNK_TRANSPORT: sview = "forged_chunk_transport"
            FORGED_TRANSPORT_REJECTED: sview = "forged_transport_rejected"
            FIXTURE_UNEXPECTED_PAYLOAD: sview = "OutputTransportError.UnexpectedPayload"
            EXTRA_TRANSPORT_PAYLOAD: sview = "extraneous_transport_payload_rejected"
            DOCS_RENDERER: sview = "EsOutputRender adds the renderer-side state machine"
            DOCS_TRANSPORT: sview = "`EsOutputTransport` wraps that renderer"
            DOCS_POSIX_ADAPTER: sview = "`EsOutputTransportPosix` adapter streams one owned frame at a"
            DOCS_WRITE_DOCUMENT: sview = "`write_output_document_fd` admits a sealed document"
            LEDGER_RENDERER: sview = "ES-SCRIPT-003 | EsOutputRender"


        const module Messages:
            MISSING_ROOT: sview = "output renderer audit: missing repository root"
            UNRESOLVED_ROOT: sview = "output renderer audit: unable to resolve repository root"
            MISSING_INPUT: sview = "output renderer audit: missing "
            READ_FAILED: sview = "output renderer audit: unable to read source: "
            SUCCESS: sview = "output renderer audit: bounded formatting, authenticated transport, and POSIX full-write adapter are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::POSIX_MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::POSIX_LIMITS},
                SearchCheck{input: inputs[0], pattern: Patterns::POSIX_WRITE_CALLS},
                SearchCheck{input: inputs[0], pattern: Patterns::POSIX_ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_DOCUMENT_FD},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_TRANSPORT_FD},
                SearchCheck{input: inputs[0], pattern: Patterns::TRANSPORT_NOT_PLANNED},
                SearchCheck{input: inputs[0], pattern: Patterns::EINTR},
                SearchCheck{input: inputs[0], pattern: Patterns::ACK_PAYLOAD},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_AMOUNT_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::ACK_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::FAIL_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_FAILED},
                SearchCheck{input: inputs[0], pattern: Patterns::WRITE_CALL_LIMIT},
                SearchCheck{input: inputs[1], pattern: Patterns::RENDER_MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::RENDER_LIMITS},
                SearchCheck{input: inputs[1], pattern: Patterns::CHUNKS_LIMIT},
                SearchCheck{input: inputs[1], pattern: Patterns::CHUNKS_BOUND},
                SearchCheck{input: inputs[1], pattern: Patterns::RENDER_STATE},
                SearchCheck{input: inputs[1], pattern: Patterns::RENDER_EVENT},
                SearchCheck{input: inputs[1], pattern: Patterns::FRAME_KIND},
                SearchCheck{input: inputs[1], pattern: Patterns::RENDER_FRAME},
                SearchCheck{input: inputs[1], pattern: Patterns::RENDER},
                SearchCheck{input: inputs[1], pattern: Patterns::RENDER_ERROR},
                SearchCheck{input: inputs[1], pattern: Patterns::VALIDATE_RENDER},
                SearchCheck{input: inputs[1], pattern: Patterns::ADVANCE_RENDER},
                SearchCheck{input: inputs[1], pattern: Patterns::JSON_ESCAPED_BYTES},
                SearchCheck{input: inputs[1], pattern: Patterns::XML_ESCAPED_BYTES},
                SearchCheck{input: inputs[1], pattern: Patterns::ACCUMULATE},
                SearchCheck{input: inputs[1], pattern: Patterns::EXPECTED_EMITTED_BYTES},
                SearchCheck{input: inputs[1], pattern: Patterns::HEADER_BYTES},
                SearchCheck{input: inputs[1], pattern: Patterns::FOOTER_BYTES},
                SearchCheck{input: inputs[1], pattern: Patterns::DOCUMENT_NOT_SEALED},
                SearchCheck{input: inputs[1], pattern: Patterns::DOCUMENT_SEALED_CHECK},
                SearchCheck{input: inputs[1], pattern: Patterns::RECORD_ORDER_INVALID},
                SearchCheck{input: inputs[1], pattern: Patterns::RECORD_INDEX_NONZERO},
                SearchCheck{input: inputs[1], pattern: Patterns::ACCOUNTING_INVALID},
                SearchCheck{input: inputs[1], pattern: Patterns::RENDER_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[1], pattern: Patterns::INCOMPLETE},
                SearchCheck{input: inputs[1], pattern: Patterns::CANCEL_NOT_READY},
                SearchCheck{input: inputs[2], pattern: Patterns::TRANSPORT_MODULE},
                SearchCheck{input: inputs[2], pattern: Patterns::TRANSPORT_LIMITS},
                SearchCheck{input: inputs[2], pattern: Patterns::TRANSPORT_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::TRANSPORT_EVENT},
                SearchCheck{input: inputs[2], pattern: Patterns::TRANSPORT_POLICY},
                SearchCheck{input: inputs[2], pattern: Patterns::TRANSPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::TRANSPORT_ERROR},
                SearchCheck{input: inputs[2], pattern: Patterns::VALIDATE_TRANSPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::BEGIN_TRANSPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::PEEK_FRAME},
                SearchCheck{input: inputs[2], pattern: Patterns::ADVANCE_TRANSPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FRAME_MISMATCH},
                SearchCheck{input: inputs[2], pattern: Patterns::FRAME_ORDER_INVALID},
                SearchCheck{input: inputs[2], pattern: Patterns::FRAME_TOO_LARGE},
                SearchCheck{input: inputs[2], pattern: Patterns::SHORT_WRITE},
                SearchCheck{input: inputs[2], pattern: Patterns::UNEXPECTED_PAYLOAD},
                SearchCheck{input: inputs[2], pattern: Patterns::MAX_FRAME_BYTES},
                SearchCheck{input: inputs[2], pattern: Patterns::FRAME_MATCHES},
                SearchCheck{input: inputs[2], pattern: Patterns::PLANNED_PREFLIGHT},
                SearchCheck{input: inputs[2], pattern: Patterns::EMPTY_PAYLOAD},
                SearchCheck{input: inputs[2], pattern: Patterns::CANCELLING_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::CANCELLED_STATE},
                SearchCheck{input: inputs[3], pattern: Patterns::IR_RENDER_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::IR_TRANSPORT_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::IR_POSIX_IMPORT},
                SearchCheck{input: inputs[4], pattern: Patterns::EXECUTION_POSIX_IMPORT},
                SearchCheck{input: inputs[5], pattern: Patterns::FIXTURE_RENDER_IMPORT},
                SearchCheck{input: inputs[5], pattern: Patterns::FIXTURE_TRANSPORT_IMPORT},
                SearchCheck{input: inputs[5], pattern: Patterns::FIXTURE_POSIX_IMPORT},
                SearchCheck{input: inputs[5], pattern: Patterns::RENDER_CONTRACT},
                SearchCheck{input: inputs[5], pattern: Patterns::EMIT_EVENT},
                SearchCheck{input: inputs[5], pattern: Patterns::FINISH_EVENT},
                SearchCheck{input: inputs[5], pattern: Patterns::CANCEL_ACK},
                SearchCheck{input: inputs[5], pattern: Patterns::COMPLETE_STATE},
                SearchCheck{input: inputs[5], pattern: Patterns::RENDER_BUDGET_REJECTED},
                SearchCheck{input: inputs[5], pattern: Patterns::FORGED_EMITTED_REJECTED},
                SearchCheck{input: inputs[5], pattern: Patterns::EXTRA_RENDER_PAYLOAD},
                SearchCheck{input: inputs[5], pattern: Patterns::TRANSPORT_CONTRACT},
                SearchCheck{input: inputs[5], pattern: Patterns::TRANSPORT_EMIT_EVENT},
                SearchCheck{input: inputs[5], pattern: Patterns::TRANSPORT_FRAME_MISMATCH},
                SearchCheck{input: inputs[5], pattern: Patterns::POSIX_INVALID_DESCRIPTOR},
                SearchCheck{input: inputs[5], pattern: Patterns::FORGED_CHUNK_TRANSPORT},
                SearchCheck{input: inputs[5], pattern: Patterns::FORGED_TRANSPORT_REJECTED},
                SearchCheck{input: inputs[5], pattern: Patterns::FIXTURE_UNEXPECTED_PAYLOAD},
                SearchCheck{input: inputs[5], pattern: Patterns::EXTRA_TRANSPORT_PAYLOAD},
                SearchCheck{input: inputs[6], pattern: Patterns::DOCS_RENDERER},
                SearchCheck{input: inputs[6], pattern: Patterns::DOCS_TRANSPORT},
                SearchCheck{input: inputs[6], pattern: Patterns::DOCS_POSIX_ADAPTER},
                SearchCheck{input: inputs[6], pattern: Patterns::DOCS_WRITE_DOCUMENT},
                SearchCheck{input: inputs[7], pattern: Patterns::LEDGER_RENDERER}
            ]


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::TRANSPORT_POSIX),
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::TRANSPORT),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::EXECUTION),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER),
                root.joinpath(Inputs::OUTPUT_MODEL)
            ]
            required_inputs: darray[Path] = [
                inputs[1], inputs[2], inputs[0], inputs[8], inputs[3], inputs[5], inputs[6], inputs[7]
            ]
            for input_path in required_inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsOutputRendererAudit::run_default()
