# Bounded Elisascript port of check_build_incremental.sh.
# This source audit covers pure stale decisions, signatures, cache publication,
# descriptor-relative observations, and successful-transition cleanup.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsBuildIncrementalAudit:
    private:
        struct AuditInputs:
            model: Path
            cache_model: Path
            build_model: Path
            executor_model: Path
            graph_model: Path
            posix_executor: Path
            artifact_cache: Path
            scheduler_model: Path
            posix: Path
            serialize: Path
            ir: Path
            fixture: Path
            transition_fixture: Path
            posix_fixture: Path
            posix_executor_fixture: Path
            recipe_signature: Path
            recipe_signature_fixture: Path
            cache_fixture: Path
            cache_adapter_fixture: Path
            executor_fixture: Path
            scheduler_fixture: Path
            install_source_adapter: Path
            docs: Path
            ledger: Path


        const module Messages:
            MISSING_ROOT: sview = "incremental build audit: missing repository root"
            UNRESOLVED_ROOT: sview = "incremental build audit: unable to resolve repository root"
            MISSING_INPUT: sview = "incremental build audit: missing "
            READ_FAILED: sview = "incremental build audit: unable to read source: "
            CONTRACT_MISSING: sview = "incremental build audit: missing contract: "
            FORBIDDEN_SOURCE: sview = "incremental build audit: forbidden source form remains: "
            SUCCESS: sview = "incremental build audit: bounded cached-to-current recipe transitions and post-success cleanup plans are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def require_patterns(input: Path, patterns: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for pattern in patterns:
                found: bool = try EsSourceFunctionScope::contains_file_line(input, pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{input}")
                    return ExitStatus::IO_FAILURE
                if not found:
                    diagnostic(Messages::CONTRACT_MISSING + f"{pattern}")
                    return ExitStatus::FAILURE
            return 0i64


        def reject_patterns(input: Path, patterns: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for pattern in patterns:
                found: bool = try EsSourceFunctionScope::contains_file_line(input, pattern) else err:
                    diagnostic(Messages::READ_FAILED + f"{input}")
                    return ExitStatus::IO_FAILURE
                if found:
                    diagnostic(Messages::FORBIDDEN_SOURCE + f"{pattern}")
                    return ExitStatus::FAILURE
            return 0i64


        def audit_manifest_models(inputs: AuditInputs) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = require_patterns(inputs.cache_model, [
                "module EsBuildIncrementalCache:", "CACHE_BYTES: usize", "FORMAT_VERSION: u8 = 4",
                "def encode_build_incremental_cache(", "def decode_build_incremental_cache(",
                "BuildIncrementalCacheError.ChecksumMismatch", "payload_end: usize = bytes.count - Limits::CHECKSUM_BYTES",
                "validate_build_incremental_signed_manifest(targets)"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.build_model, [
                "def attach_build_dependency_resolution(", "resolution.dependencies[node_index]"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.model, [
                "module EsBuildIncremental:", "const module Limits:", "Limits::TARGETS", "Limits::INPUTS", "Limits::OUTPUTS",
                "Limits::OBSERVATIONS", "Limits::CLEANUP_OUTPUTS", "Limits::TOTAL_INPUTS", "Limits::TOTAL_OUTPUTS",
                "const enum BuildIncrementalTargetKind of u8:", "Phony", "const enum BuildIncrementalDecision of u8:",
                "struct BuildIncrementalTarget:", "struct BuildIncrementalRecipeTarget:", "struct BuildIncrementalPlan:",
                "struct BuildIncrementalCommit:", "struct BuildIncrementalResolvedManifest:", "struct BuildIncrementalStaleOutput:",
                "struct BuildIncrementalObservation:", "ObservationSetMismatch", "error BuildIncrementalError:",
                "len(name) < Limits::NAME_BYTES", "len(path) < Limits::PATH_BYTES", "def validate_build_incremental_manifest(",
                "def resolve_incremental_build_dependencies(", "def build_incremental_manifest_resolution(",
                "def build_incremental_dependency_resolution(", "def build_incremental_path_owners(",
                "def build_sort_incremental_path_owners(", "def classify_build_incremental_target(",
                "def classify_build_incremental_manifest(", "def build_incremental_find_target_index(",
                "def build_incremental_recipe_shape_matches(", "def build_incremental_materialize_recipe_targets(",
                "def plan_build_incremental_transition(", "target_names: darray[sview]", "recipe_fingerprints: darray[u64]",
                "def build_incremental_observed_commit_file(", "def build_incremental_observations_match_paths(",
                "def validate_build_incremental_stable_sources(", "def commit_build_incremental_success(",
                "def build_incremental_target_decision_validated(", "def build_incremental_target_valid(target)",
                "def build_incremental_dependency_order(", "def build_incremental_dependency_observation_position(",
                "def build_incremental_observation_order(", "def build_sort_incremental_observation_indices(",
                "def build_incremental_observation_paths(", "def validate_build_incremental_signed_manifest(",
                "segment_length == 2 and sview_at(path, segment_start) == 46", "def plan_build_incremental_cleanup(",
                "current_recipe_fingerprint != target.recipe_fingerprint", "build_incremental_observation_order(observations)",
                "decisions[dependency_index] == BuildIncrementalDecision.UpToDate", "build_sort_incremental_path_owners(owners, scratch)",
                "build_incremental_dependency_observation_position(dependency_order, dependency)"
            ])
            return status if status != 0i64

            status <- require_patterns(inputs.model, [
                "BuildIncrementalDecision.UpToDate", "BuildIncrementalDecision.RecipeChanged", "BuildIncrementalDecision.DependencyDirty",
                "BuildIncrementalDecision.InputChanged", "BuildIncrementalDecision.OutputMissing",
                "BuildIncrementalError.DuplicateInput", "BuildIncrementalError.DuplicateOutput", "BuildIncrementalError.OutputForbidden",
                "BuildIncrementalError.OutputCollision", "BuildIncrementalError.InputOutputCollision",
                "BuildIncrementalError.UndeclaredOutputDependency", "BuildIncrementalError.OrphanedOutputInput",
                "BuildIncrementalError.CleanupOutputLimitExceeded", "BuildIncrementalError.DependencyOrderInvalid",
                "BuildIncrementalError.CurrentRecipeShapeInvalid", "BuildIncrementalError.TotalInputLimitExceeded",
                "BuildIncrementalError.TotalOutputLimitExceeded", "BuildIncrementalError.DependencyResolutionInvalid",
                "BuildIncrementalError.InvalidDependencyObservation", "BuildContractError.DuplicateNode",
                "BuildContractError.DuplicateDependency", "build_incremental_target_shape_valid(target)",
                "BuildIncrementalPathOrder", "build_incremental_path_order",
                "build_incremental_observation_index(observations, sorted_observation_indices, input.path)",
                "build_incremental_dependency_index_contains",
                "build_incremental_dependency_index_contains(resolution.dependencies[input_owner.target_index], output_target_index)",
                "build_incremental_path_owner_position", "build_incremental_path_owner_position(input_owners, output.path)",
                "build_incremental_path_owner_order", "build_sort_incremental_path_owners(dependency_owners, dependency_scratch)",
                "Limits::TOTAL_INPUTS - owners.count", "Limits::TOTAL_OUTPUTS - owners.count",
                "BuildIncrementalError.DuplicateInput if previous.path == current.path and previous.target_index == current.target_index",
                "build_incremental_path_owner_position(current_manifest.output_owners, output.path)",
                "build_incremental_path_owner_position(current_manifest.input_owners, output.path)",
                "current_manifest <- try build_incremental_manifest_resolution(current_targets)"
            ])
            return status if status != 0i64
            return 0i64


        def audit_execution_models(inputs: AuditInputs) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = require_patterns(inputs.ir, [
                "include \"../runtime/build_incremental_model.elisa\"",
                "include \"../runtime/build_incremental_cache_model.elisa\"",
                "include \"../runtime/build_recipe_signature.elisa\"",
                "include \"../runtime/build_incremental_graph_model.elisa\"",
                "include \"../runtime/build_incremental_posix_executor.elisa\"",
                "include \"../runtime/build_incremental_posix.elisa\""
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.graph_model, [
                "def plan_build_incremental_graph_transition(", "def validate_build_incremental_graph_signatures(",
                "build_recipe_signatures_for_actions(commands, recipes, toolchains)", "graph.state != BuildGraphState.Planned"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.posix_executor, [
                "def execute_build_graph_incremental_at(", "def commit_build_incremental_execution_at(",
                "def execute_build_graph_incremental_cached_at(",
                "admit_build_incremental_cache_at_held(scratch, lock, cache_directory_fd, lock_name, owner_token, cache_name)",
                "publish_build_incremental_cache_at_held(scratch, lock, cache_directory_fd, lock_name, owner_token, staging_name, cache_name, prepared.cache_bytes)",
                "cache_unchanged: bool = false", "cache_unchanged: publication.unchanged", "ToolchainObservationError.ToolchainChanged",
                "validate_build_incremental_stable_sources(execution.recipes, execution.pre_execution_observations, observations)",
                "BuildIncrementalPosixExecution{result: result, recipes: signed.recipes, pre_execution_observations: observations}",
                "def validate_build_recipe_toolchain_paths(", "ToolchainObservationError.ToolchainCommandMismatch",
                "ToolchainObservationError.InvalidToolchainPath", "permissions == observed.permissions"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.artifact_cache, [
                "def artifact_cache_writer_lock_matches_at(",
                "elisascript_posix_flock(lock.descriptor, PosixLockOperations::EXCLUSIVE + PosixLockOperations::NONBLOCK)",
                "def admit_build_incremental_cache_at_held(", "manifest_bytes: darray[u8]",
                "manifest_bytes: bytes, previous_targets: targets", "def publish_build_incremental_cache_at_held("
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.scheduler_model, ["def admit_build_incremental_graph("])
            return status if status != 0i64
            status <- reject_patterns(inputs.scheduler_model, ["def admit_build_incremental_plan("])
            return status if status != 0i64

            status <- require_patterns(inputs.executor_model, [
                "def execute_build_graph_incremental(", "def commit_build_incremental_execution("
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.posix, [
                "def open_build_incremental_file_at(", "def observe_build_incremental_file_at(",
                "def build_incremental_opened_file_identity_matches(", "catch open_build_incremental_file_at(root_fd, path):",
                "named_path_matches <- build_incremental_opened_file_identity_matches(opened, named_file)",
                "not stable or not named_path_matches", "def observe_build_recipe_toolchain_identity_at(",
                "word3: observation.fingerprint_word3", "def observe_build_incremental_recipes_at(", "arena_rewind(scratch, mark)",
                "DarwinOpenFlags::NOFOLLOW", "canonical_file_identity_sha256_words(bytes, opened.permissions, fingerprint_words)",
                "canonical_file_identity_sha256_words(bytes, opened.permissions"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.serialize, [
                "def canonical_bytes_sha256_word(", "def canonical_file_identity_sha256_words(",
                "schedule: mutable u64[64] = zeroed", "constants: u64[64] = ["
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.install_source_adapter, [
                "left.permissions == right.permissions", "EsBuildIncrementalPosix::Limits::FILE_PERMISSION_MASK) == stamp.permissions",
                "permissions: opened.permissions"
            ])
            return status if status != 0i64
            return 0i64


        def audit_recipe_signatures(inputs: AuditInputs) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = require_patterns(inputs.recipe_signature, [
                "def sign_build_incremental_graph(", "def build_recipe_signatures_for_actions(",
                "def build_recipe_signature(", "EsIr::canonical_bytes_sha256_word(bytes, 3)",
                "toolchain_identity: BuildRecipeToolchainIdentity", "toolchain.word3", "command.executable", "command.arguments",
                "command.working_directory", "command.environment_mode", "command.environment", "command.stdin_mode",
                "command.stdin_path", "command.stdout_mode", "command.stdout_path", "command.stderr_mode", "command.stderr_path",
                "command.timeout_micros", "command.capture_output_limit_bytes", "command.failure_mode", "recipe.inputs",
                "recipe.outputs", "recipe.dependencies",
                "InheritedEnvironmentUncacheable if command.environment_mode == ProcessEnvironmentMode.Inherit",
                "AmbientExecutableUncacheable if not path_is_absolute(path(command.executable))",
                "WorkingDirectoryUncacheable if command.working_directory == \"\" or not path_is_absolute(path(command.working_directory))",
                "StdioPolicyUncacheable if command.stdin_mode != ProcessStdioMode.Null or command.stdout_mode != ProcessStdioMode.Capture or command.stderr_mode != ProcessStdioMode.Capture",
                "StdioPolicyUncacheable if command.stdin_path != \"\" or command.stdout_path != \"\" or command.stderr_path != \"\"",
                "FailurePolicyUncacheable if command.failure_mode != ProcessFailureMode.Check",
                "UnboundedExecutionUncacheable if command.timeout_micros == 0"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.recipe_signature_fixture, [
                "build_recipe_signature_binds_command_target_and_toolchain", "AmbientExecutableUncacheable",
                "InheritedEnvironmentUncacheable", "WorkingDirectoryUncacheable", "StdioPolicyUncacheable",
                "FailurePolicyUncacheable", "UnboundedExecutionUncacheable", "sign_build_incremental_recipe",
                "split_arguments", "changed_command", "changed_recipe", "changed_toolchain", "relative_executable_rejected",
                "relative_working_directory_rejected", "empty_working_directory_rejected", "inherited_stdin_rejected",
                "unbounded_execution_rejected", "permissive_failure_rejected", "uncaptured_output_rejected", "file_redirect_rejected"
            ])
            return status if status != 0i64
            return 0i64


        def audit_fixtures_and_docs(inputs: AuditInputs) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = require_patterns(inputs.posix_executor_fixture, [
                "toolchain_resolution_must_match_graph_command_before_observation", "ToolchainObservationError.InvalidToolchainPath(0)",
                "stable_source_validation_rejects_mid_build_changes", "generated_change_allowed"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.posix_fixture, [
                "incremental_file_fingerprint_uses_complete_canonical_sha256", "incremental_file_open_rejects_invalid_capability_and_paths",
                "observe_build_recipe_toolchain_identity_at(scratch, -1, \"usr/bin/compiler\")"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.posix_executor_fixture, ["changed_mode"])
            return status if status != 0i64
            status <- require_patterns(inputs.cache_fixture, [
                "incremental_cache_codec_rejects_legacy_content_only_v3_records",
                "incremental_cache_codec_round_trips_a_valid_manifest", "incremental_cache_codec_rejects_checksum_corruption",
                "incremental_cache_codec_rejects_scalar_recipe_v2_records", "incremental_cache_codec_rejects_unsigned_recipe_manifests",
                "decode_build_incremental_cache(encoded)", "BuildIncrementalCacheError.ChecksumMismatch"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.cache_adapter_fixture, [
                "incremental_cache_descriptor_io_rejects_invalid_directory_handles",
                "publish_build_incremental_cache_at_held(arena, unrelated_lock",
                "read_build_incremental_cache_at_held(arena, unrelated_lock", "held_publish_rejected", "held_read_rejected"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.executor_fixture, [
                "incremental_executor_marks_up_to_date_nodes_as_cache_hits", "command_mismatch_rejected",
                "BuildIncrementalObservation{path: \"build/app\", present: false}", "missing_output_rejected",
                "BuildIncrementalError.CommitOutputMissing",
                "commit_build_incremental_execution(result, graph, previous, recipes, observations)",
                "execute_build_graph_incremental(graph, previous, recipes, observations)", "cache_hit and not result.nodes[0].started"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.scheduler_fixture, ["signature_mismatch_rejected"])
            return status if status != 0i64

            status <- require_patterns(inputs.fixture, [
                "include \"../runtime/build_incremental_model.elisa\"",
                "typed_build_incremental_contract_distinguishes_noop_and_rebuild_reasons",
                "resolve_incremental_build_dependencies(manifest)",
                "classify_build_incremental_manifest(manifest, changed_recipes, build_observations)",
                "BuildIncrementalDecision.DependencyDirty", "duplicate_observation_rejected", "attach_build_dependency_resolution(graph, resolution)",
                "malformed_resolution_rejected", "BuildIncrementalDecision.InputMissing", "BuildIncrementalDecision.OutputChanged",
                "BuildIncrementalError.DuplicateInput", "BuildIncrementalError.DuplicateOutput", "BuildIncrementalError.DuplicateTarget",
                "BuildIncrementalError.DuplicateDependency", "duplicate_output_rejected", "duplicate_target_rejected",
                "duplicate_dependency_rejected", "BuildIncrementalError.OutputForbidden", "BuildIncrementalError.OutputCollision",
                "BuildIncrementalError.UndeclaredOutputDependency", "plan_build_incremental_cleanup", "BuildIncrementalError.OrphanedOutputInput",
                "BuildIncrementalError.DependencyOrderInvalid", "build_incremental_manifest_rejects_unsafe_relative_paths"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.transition_fixture, [
                "build_incremental_generated_header_changes_rebuild_only_its_w07_dependents",
                "build_incremental_distinguishes_missing_and_changed_generated_outputs",
                "build_incremental_transition_rebuilds_on_signature_change_without_scalar_change",
                "build_incremental_transition_rebuilds_changed_and_new_targets", "build_incremental_observation_paths_are_unique_and_sorted",
                "build_incremental_observation_paths(recipes)", "BuildIncrementalError.ObservationSetMismatch",
                "build_incremental_transition_plans_removed_outputs_only_after_success",
                "build_incremental_success_commit_is_complete_and_atomic",
                "plan_build_incremental_transition(previous, current, observations)",
                "commit_build_incremental_success(previous, current, complete_observations)",
                "BuildIncrementalDecision.RecipeChanged", "BuildIncrementalDecision.DependencyDirty", "BuildIncrementalDecision.OutputChanged",
                "BuildIncrementalDecision.OutputMissing", "BuildIncrementalDecision.UpToDate", "build/libminimal-answer.a",
                "changed_header.rebuild_target_indices == [0, 3, 4, 5]", "missing_header.rebuild_target_indices == [0, 3, 4, 5]",
                "stale_outputs_after_success"
            ])
            return status if status != 0i64
            status <- require_patterns(inputs.docs, ["`EsBuildIncremental` is the pure CMake/Ninja-style stale-decision boundary"])
            return status if status != 0i64
            status <- require_patterns(inputs.ledger, ["`EsBuildIncremental` adds the bounded pure manifest boundary"])
            return status if status != 0i64
            return 0i64


        def audit_all(inputs: AuditInputs) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            status: mutable i64 = audit_manifest_models(inputs)
            return status if status != 0i64
            status <- audit_execution_models(inputs)
            return status if status != 0i64
            status <- audit_recipe_signatures(inputs)
            return status if status != 0i64
            return audit_fixtures_and_docs(inputs)


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus.FAILURE
            root: Path = path_normalize(repository_root)
            inputs: AuditInputs = AuditInputs{
                model: root.joinpath("src/runtime/build_incremental_model.elisa"),
                cache_model: root.joinpath("src/runtime/build_incremental_cache_model.elisa"),
                build_model: root.joinpath("src/runtime/build_model.elisa"),
                executor_model: root.joinpath("src/runtime/build_executor_model.elisa"),
                graph_model: root.joinpath("src/runtime/build_incremental_graph_model.elisa"),
                posix_executor: root.joinpath("src/runtime/build_incremental_posix_executor.elisa"),
                artifact_cache: root.joinpath("src/ir/artifact_cache.elisa"),
                scheduler_model: root.joinpath("src/runtime/build_scheduler_model.elisa"),
                posix: root.joinpath("src/runtime/build_incremental_posix.elisa"),
                serialize: root.joinpath("src/ir/serialize.elisa"),
                ir: root.joinpath("src/ir/ir.elisa"),
                fixture: root.joinpath("test/ir/elisascript_ir_test.elisa"),
                transition_fixture: root.joinpath("test/runtime/build_incremental_transition_test.elisa"),
                posix_fixture: root.joinpath("test/runtime/build_incremental_posix_test.elisa"),
                posix_executor_fixture: root.joinpath("test/runtime/build_incremental_posix_executor_test.elisa"),
                recipe_signature: root.joinpath("src/runtime/build_recipe_signature.elisa"),
                recipe_signature_fixture: root.joinpath("test/runtime/build_recipe_signature_test.elisa"),
                cache_fixture: root.joinpath("test/runtime/build_incremental_cache_test.elisa"),
                cache_adapter_fixture: root.joinpath("test/runtime/build_incremental_cache_adapter_test.elisa"),
                executor_fixture: root.joinpath("test/runtime/build_incremental_executor_test.elisa"),
                scheduler_fixture: root.joinpath("test/runtime/build_incremental_scheduler_test.elisa"),
                install_source_adapter: root.joinpath("src/runtime/install_source_posix.elisa"),
                docs: root.joinpath("docs/ir.md"),
                ledger: root.joinpath("docs/capabilities/ledger.md")
            }
            required_files: darray[Path] = [
                inputs.model, inputs.cache_model, inputs.build_model, inputs.executor_model, inputs.graph_model,
                inputs.posix_executor, inputs.artifact_cache, inputs.scheduler_model, inputs.posix, inputs.serialize,
                inputs.ir, inputs.fixture, inputs.transition_fixture, inputs.posix_fixture, inputs.posix_executor_fixture,
                inputs.recipe_signature, inputs.recipe_signature_fixture, inputs.cache_fixture, inputs.cache_adapter_fixture,
                inputs.executor_fixture, inputs.scheduler_fixture, inputs.install_source_adapter, inputs.docs, inputs.ledger
            ]
            for required_file in required_files:
                if not is_file(required_file):
                    diagnostic(Messages::MISSING_INPUT + f"{required_file}")
                    return ExitStatus.FAILURE
            status: i64 = audit_all(inputs)
            return status if status != 0i64
            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus.IO_FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsBuildIncrementalAudit::run_default()
