# Bounded Elisascript port of check_binary.sh.
# Regex source checks stream through the shared scanner without rg/awk.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsBinarySourceAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/binary_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsBinary:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/binary_model\.elisa\""
            BYTE_ORDER: Regex = regex"const enum BinaryByteOrder of u8"
            CURSOR_STATE: Regex = regex"const enum BinaryCursorState of u8"
            EVENT: Regex = regex"const enum BinaryEvent of u8"
            POLICY: Regex = regex"struct BinaryPolicy:"
            CURSOR: Regex = regex"struct BinaryCursor:"
            ERROR: Regex = regex"error BinaryError:"
            VALIDATE: Regex = regex"def validate_binary_cursor\("
            READ_U8: Regex = regex"def binary_read_u8\("
            READ_U16: Regex = regex"def binary_read_u16\("
            READ_U32: Regex = regex"def binary_read_u32\("
            READ_U64: Regex = regex"def binary_read_u64\("
            ADVANCE: Regex = regex"def advance_binary\("
            INPUT_LIMIT: Regex = regex"Limits::INPUT_BYTES"
            READ_LIMIT: Regex = regex"Limits::READS"
            LITTLE_ENDIAN: Regex = regex"BinaryByteOrder.Little"
            BIG_ENDIAN: Regex = regex"BinaryByteOrder.Big"
            TRUNCATED: Regex = regex"BinaryError.Truncated"
            TRAILING_BYTES: Regex = regex"BinaryError.TrailingBytes"
            READ_LIMIT_EXCEEDED: Regex = regex"BinaryError.ReadLimitExceeded"
            ACCOUNTING_INVALID: Regex = regex"BinaryError.AccountingInvalid"
            NONZERO_OFFSET_WITHOUT_READS: Regex = regex"cursor.offset != 0 and cursor.reads == 0"
            READS_EXCEED_OFFSET: Regex = regex"cursor.reads > cursor.offset"
            EXHAUSTED_STATE: Regex = regex"cursor.state == BinaryCursorState.Exhausted"
            INVALID_STATE: Regex = regex"BinaryError.InvalidState"
            FIXTURE_IMPORT: Regex = regex"using EsBinary"
            FIXTURE_CONTRACT: Regex = regex"typed_binary_contract_checks_endianness_and_trailing_bytes"
            FIXTURE_LITTLE_ENDIAN: Regex = regex"BinaryByteOrder.Little"
            FIXTURE_BIG_ENDIAN: Regex = regex"BinaryByteOrder.Big"
            FIXTURE_READ_U64: Regex = regex"binary_read_u64"
            FIXTURE_TRUNCATED: Regex = regex"BinaryError.Truncated"
            FIXTURE_TRAILING_BYTES: Regex = regex"BinaryError.TrailingBytes"
            DOCS_CURSOR: Regex = regex"EsBinary::BinaryCursor"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-052"


        const module Messages:
            MISSING_ROOT: sview = "binary audit: missing repository root"
            UNRESOLVED_ROOT: sview = "binary audit: unable to resolve repository root"
            MISSING_INPUT: sview = "binary audit: missing "
            READ_FAILED: sview = "binary audit: unable to read source: "
            SUCCESS: sview = "binary audit: bounded endian reads, truncation checks, and explicit finish are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::BYTE_ORDER},
                SearchCheck{input: inputs[0], pattern: Patterns::CURSOR_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::CURSOR},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_U8},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_U16},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_U32},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_U64},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::INPUT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::LITTLE_ENDIAN},
                SearchCheck{input: inputs[0], pattern: Patterns::BIG_ENDIAN},
                SearchCheck{input: inputs[0], pattern: Patterns::TRUNCATED},
                SearchCheck{input: inputs[0], pattern: Patterns::TRAILING_BYTES},
                SearchCheck{input: inputs[0], pattern: Patterns::READ_LIMIT_EXCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTING_INVALID},
                SearchCheck{input: inputs[0], pattern: Patterns::NONZERO_OFFSET_WITHOUT_READS},
                SearchCheck{input: inputs[0], pattern: Patterns::READS_EXCEED_OFFSET},
                SearchCheck{input: inputs[0], pattern: Patterns::EXHAUSTED_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::INVALID_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_LITTLE_ENDIAN},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_BIG_ENDIAN},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_READ_U64},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_TRUNCATED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_TRAILING_BYTES},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_CURSOR},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsBinarySourceAudit::run_default()
