# Bounded Elisascript port of check_structured_task.sh.
# Regex source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsStructuredTaskAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/structured_task_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: Regex = regex"^module EsStructuredTask:"
            MODEL_IMPORT: Regex = regex"include \"\.\./runtime/structured_task_model\.elisa\""
            SCOPE_STATE: Regex = regex"const enum StructuredScopeState of u8"
            CHILD_STATE: Regex = regex"const enum StructuredChildState of u8"
            TASK_EVENT: Regex = regex"const enum StructuredTaskEvent of u8"
            POLICY: Regex = regex"struct StructuredTaskPolicy:"
            CHILD: Regex = regex"struct StructuredChild:"
            SCOPE: Regex = regex"struct StructuredTaskScope:"
            ERROR: Regex = regex"error StructuredTaskError:"
            VALIDATE: Regex = regex"def validate_structured_task_scope\("
            SPAWN: Regex = regex"def structured_task_spawn\("
            ADVANCE: Regex = regex"def advance_structured_task\("
            CHILDREN_LIMIT: Regex = regex"Limits::CHILDREN"
            CLEANUP_DEPTH_LIMIT: Regex = regex"Limits::CLEANUP_DEPTH"
            REQUEST_CHILD_CANCEL: Regex = regex"StructuredTaskEvent.RequestChildCancel"
            ENTER_CLEANUP: Regex = regex"StructuredTaskEvent.EnterCleanup"
            CHILD_CANCEL_ACK: Regex = regex"StructuredTaskEvent.ChildCancelAck"
            CANCELLATION_SHIELDED: Regex = regex"StructuredTaskError.CancellationShielded"
            JOIN_NOT_READY: Regex = regex"StructuredTaskError.JoinNotReady"
            CHILD_PLANNED: Regex = regex"StructuredChildState.Planned"
            FAILURE_CODE_MISSING: Regex = regex"StructuredTaskError.FailureCodeMissing"
            SCOPE_PLANNED: Regex = regex"StructuredScopeState.Planned and"
            SCOPE_SUCCEEDED: Regex = regex"StructuredScopeState.Succeeded and"
            SCOPE_CANCELLED: Regex = regex"StructuredScopeState.Cancelled and"
            SCOPE_FAILED: Regex = regex"StructuredScopeState.Failed and"
            SCOPE_JOINING: Regex = regex"StructuredScopeState.Joining and"
            SCOPE_NOT_RUNNING: Regex = regex"scope.state != StructuredScopeState.Running"
            REQUEST_CANCEL: Regex = regex"StructuredTaskEvent.RequestCancel"
            CHILD_CLEANING: Regex = regex"StructuredChildState.Cleaning and"
            CLEANUP_DEPTH: Regex = regex"StructuredChildState.Cleaning and child.cleanup_depth"
            CHILD_CANCEL_STATE: Regex = regex"child_state != StructuredChildState.CancelRequested and child_state != StructuredChildState.Cleaning"
            FORGED_FAILED_PLANNED: Regex = regex"forged_failed_planned"
            FIXTURE_IMPORT: Regex = regex"using EsStructuredTask"
            FIXTURE_CONTRACT: Regex = regex"typed_structured_task_contract_shields_cleanup_before_join"
            FIXTURE_ENTER_CLEANUP: Regex = regex"StructuredTaskEvent.EnterCleanup"
            FIXTURE_CANCELLATION_SHIELDED: Regex = regex"StructuredTaskError.CancellationShielded"
            FIXTURE_STILL_SHIELDED: Regex = regex"still_shielded"
            FIXTURE_CANCELLED: Regex = regex"StructuredScopeState.Cancelled"
            FIXTURE_CLEANUP_DEPTH: Regex = regex"StructuredTaskError.CleanupDepthInvalid"
            JOIN_PLANNED: Regex = regex"StructuredTaskError.JoinNotReady if child.state == StructuredChildState.Planned"
            FIXTURE_PENDING_REJECTED: Regex = regex"fail_pending_rejected"
            FIXTURE_FORGED_JOINING: Regex = regex"forged_joining"
            DOCS_SCOPE: Regex = regex"EsStructuredTask::StructuredTaskScope"
            LEDGER_ITEM: Regex = regex"ES-SCRIPT-046"


        const module Messages:
            MISSING_ROOT: sview = "structured task audit: missing repository root"
            UNRESOLVED_ROOT: sview = "structured task audit: unable to resolve repository root"
            MISSING_INPUT: sview = "structured task audit: missing "
            READ_FAILED: sview = "structured task audit: unable to read source: "
            SUCCESS: sview = "structured task audit: child cleanup shielding, cancellation, and join ordering are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: Regex


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[1], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::CHILD_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::TASK_EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::POLICY},
                SearchCheck{input: inputs[0], pattern: Patterns::CHILD},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::SPAWN},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::CHILDREN_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::CLEANUP_DEPTH_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST_CHILD_CANCEL},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTER_CLEANUP},
                SearchCheck{input: inputs[0], pattern: Patterns::CHILD_CANCEL_ACK},
                SearchCheck{input: inputs[0], pattern: Patterns::CANCELLATION_SHIELDED},
                SearchCheck{input: inputs[0], pattern: Patterns::JOIN_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::CHILD_PLANNED},
                SearchCheck{input: inputs[0], pattern: Patterns::FAILURE_CODE_MISSING},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_PLANNED},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_SUCCEEDED},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_CANCELLED},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_FAILED},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_JOINING},
                SearchCheck{input: inputs[0], pattern: Patterns::SCOPE_NOT_RUNNING},
                SearchCheck{input: inputs[0], pattern: Patterns::REQUEST_CANCEL},
                SearchCheck{input: inputs[0], pattern: Patterns::CHILD_CLEANING},
                SearchCheck{input: inputs[0], pattern: Patterns::CLEANUP_DEPTH},
                SearchCheck{input: inputs[0], pattern: Patterns::CHILD_CANCEL_STATE},
                SearchCheck{input: inputs[2], pattern: Patterns::FORGED_FAILED_PLANNED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_ENTER_CLEANUP},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CANCELLATION_SHIELDED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_STILL_SHIELDED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CANCELLED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_CLEANUP_DEPTH},
                SearchCheck{input: inputs[0], pattern: Patterns::JOIN_PLANNED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_PENDING_REJECTED},
                SearchCheck{input: inputs[2], pattern: Patterns::FIXTURE_FORGED_JOINING},
                SearchCheck{input: inputs[3], pattern: Patterns::DOCS_SCOPE},
                SearchCheck{input: inputs[4], pattern: Patterns::LEDGER_ITEM}
            ]


        def execute(checks: darray[SearchCheck]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            for check in checks:
                catch EsSourceFunctionScope::contains_file_regex_line(check.input, check.pattern):
                    ok found:
                        return ExitStatus::FAILURE if not found
                    error _:
                        diagnostic(Messages::READ_FAILED + f"{check.input}")
                        return ExitStatus::IO_FAILURE
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            status: i64 = execute(searches(inputs))
            return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsStructuredTaskAudit::run_default()
