# Bounded Elisascript port of check_environment_model.sh.
# Fixed-string source checks stream through the shared scanner without rg.

include "./shell_invocation_path.elisascript"
include "./source_function_scope.elisascript"

module EsEnvironmentModelAudit:
    private:
        const module Inputs:
            MODEL: sview = "src/runtime/environment_model.elisa"
            PROCESS_MODEL: sview = "src/runtime/process_model.elisa"
            IR: sview = "src/ir/ir.elisa"
            FIXTURE: sview = "test/ir/elisascript_ir_test.elisa"
            DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"


        const module Patterns:
            MODULE: sview = "module EsEnvironment:"
            ENTRY_LIMIT: sview = "ENVIRONMENT_MAX_ENTRIES"
            TEXT_LIMIT: sview = "ENVIRONMENT_MAX_TEXT_BYTES"
            STATE: sview = "const enum EnvironmentState of u8:"
            EVENT: sview = "const enum EnvironmentEvent of u8:"
            ENTRY: sview = "struct EnvironmentEntry:"
            SNAPSHOT: sview = "struct EnvironmentSnapshot:"
            ERROR: sview = "error EnvironmentContractError:"
            VALIDATE: sview = "def validate_environment_snapshot("
            LOOKUP: sview = "def environment_lookup("
            ADVANCE: sview = "def advance_environment_snapshot("
            NAME_VALID: sview = "environment_name_valid"
            VALUE_VALID: sview = "environment_value_valid"
            ADD_FITS: sview = "environment_add_fits"
            ADD_REJECTION: sview = "not environment_add_fits(snapshot.text_bytes, name, value)"
            VALUE_LENGTH_BOUND: sview = "sview_len(value) > ENVIRONMENT_MAX_TEXT_BYTES - without_previous"
            READY_STATE: sview = "EnvironmentState.Ready and"
            NAME_CHECK: sview = "environment_name_valid(name)"
            DUPLICATE_NAME: sview = "DuplicateName"
            NAME_MISSING: sview = "NameMissing"
            LOOKUP_NOT_READY: sview = "LookupNotReady"
            ACCOUNTING: sview = "AccountingInvalid"
            RESET_NOT_READY: sview = "ResetNotReady"
            MODEL_IMPORT: sview = "include \"../runtime/environment_model.elisa\""
            FIXTURE_IMPORT: sview = "using EsEnvironment"
            FIXTURE_CONTRACT: sview = "typed_environment_snapshot_contract_is_bounded_and_tombstone_stable"
            FIXTURE_SET: sview = "EnvironmentEvent.Set"
            FIXTURE_UNSET: sview = "EnvironmentEvent.Unset"
            FIXTURE_LOOKUP: sview = "environment_lookup"
            FIXTURE_NAME_MISSING: sview = "EnvironmentContractError.NameMissing"
            DOCS_BOUNDARY: sview = "EsEnvironment provides the child-facing data boundary"
            LEDGER_ITEM: sview = "ES-SCRIPT-010 | EsEnvironment"


        const module Messages:
            MISSING_ROOT: sview = "environment audit: missing repository root"
            UNRESOLVED_ROOT: sview = "environment audit: unable to resolve repository root"
            MISSING_INPUT: sview = "environment audit: missing "
            READ_FAILED: sview = "environment audit: unable to read source: "
            SUCCESS: sview = "environment audit: bounded unique entries, sealed lookup, deterministic set/unset overlays, tombstones, and reset are present"


        const module ExitStatus:
            FAILURE: i64 = 1
            IO_FAILURE: i64 = 2


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def searches(inputs: darray[Path]) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: inputs[0], pattern: Patterns::MODULE},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::TEXT_LIMIT},
                SearchCheck{input: inputs[0], pattern: Patterns::STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::EVENT},
                SearchCheck{input: inputs[0], pattern: Patterns::ENTRY},
                SearchCheck{input: inputs[0], pattern: Patterns::SNAPSHOT},
                SearchCheck{input: inputs[0], pattern: Patterns::ERROR},
                SearchCheck{input: inputs[0], pattern: Patterns::VALIDATE},
                SearchCheck{input: inputs[0], pattern: Patterns::LOOKUP},
                SearchCheck{input: inputs[0], pattern: Patterns::ADVANCE},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::VALUE_VALID},
                SearchCheck{input: inputs[0], pattern: Patterns::ADD_FITS},
                SearchCheck{input: inputs[0], pattern: Patterns::ADD_REJECTION},
                SearchCheck{input: inputs[0], pattern: Patterns::VALUE_LENGTH_BOUND},
                SearchCheck{input: inputs[0], pattern: Patterns::READY_STATE},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_CHECK},
                SearchCheck{input: inputs[0], pattern: Patterns::DUPLICATE_NAME},
                SearchCheck{input: inputs[0], pattern: Patterns::NAME_MISSING},
                SearchCheck{input: inputs[0], pattern: Patterns::LOOKUP_NOT_READY},
                SearchCheck{input: inputs[0], pattern: Patterns::ACCOUNTING},
                SearchCheck{input: inputs[0], pattern: Patterns::RESET_NOT_READY},
                SearchCheck{input: inputs[2], pattern: Patterns::MODEL_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_IMPORT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_CONTRACT},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_SET},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_UNSET},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_LOOKUP},
                SearchCheck{input: inputs[3], pattern: Patterns::FIXTURE_NAME_MISSING},
                SearchCheck{input: inputs[4], pattern: Patterns::DOCS_BOUNDARY},
                SearchCheck{input: inputs[5], pattern: Patterns::LEDGER_ITEM}
            ]


        def has_line(path: Path, needle: sview) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast]:
            catch EsSourceFunctionScope::contains_file_line(path, needle):
                ok found:
                    return ExitStatus::FAILURE if not found
                    return 0i64
                error _:
                    diagnostic(Messages::READ_FAILED + f"{path}")
                    return ExitStatus::IO_FAILURE


    public:
        def run_root(repository_root: Path) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Directory.Read, File.Read]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return ExitStatus::FAILURE
            root: Path = path_normalize(repository_root)
            inputs: darray[Path] = [
                root.joinpath(Inputs::MODEL),
                root.joinpath(Inputs::PROCESS_MODEL),
                root.joinpath(Inputs::IR),
                root.joinpath(Inputs::FIXTURE),
                root.joinpath(Inputs::DOCS),
                root.joinpath(Inputs::LEDGER)
            ]
            for input_path in inputs:
                if not is_file(input_path):
                    diagnostic(Messages::MISSING_INPUT + f"{input_path}")
                    return ExitStatus::FAILURE

            for check in searches(inputs):
                status: i64 = has_line(check.input, check.pattern)
                return status if status != 0i64

            print(Messages::SUCCESS)
            return 0i64


        def run_default() -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return ExitStatus::FAILURE
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Console.Write, Console.Format, Unsafe.PointerCast, Environment.Read, Directory.Read, File.Read]:
    _ = arguments
    return EsEnvironmentModelAudit::run_default()
