# Streaming Elisascript port of check_multishot_type_table.sh.
# Keep the shell oracle until its public-launcher parity contract is qualified.

include "./shell_invocation_path.elisascript"

module EsMultishotTypeTableAudit:
    private:
        const module Inputs:
            VERIFIER: sview = "src/ir/ir_verify.elisa"
            TYPE_TABLE: sview = "src/ir/type_table.elisa"
            IR_DOCS: sview = "docs/ir.md"
            LEDGER: sview = "docs/capabilities/ledger.md"
            IR_TESTS: sview = "test/ir/elisascript_ir_test.elisa"


        const module Patterns:
            RECURSIVE_DECLARATION: sview = "def type_table_contains_mutable_aggregate\\(type_id: u32, table: TypeTable&"
            RECURSIVE_AGGREGATE: sview = "return true if row\\.kind in \\{TypeKind\\.Array, TypeKind\\.Map\\}"
            RECURSIVE_CHILD: sview = "type_table_contains_mutable_aggregate\\(child_id, table, depth \\+ 1\\)"
            RECURSION_LIMIT: sview = "depth >= TypeTableLimits::MATCH_DEPTH"
            TABLE_CHILD_LOOKUP: sview = "type_table_child\\(type_id, position\\.u16\\(\\), table\\)"
            INLINE_DECLARATION: sview = "def type_inline_contains_mutable_aggregate\\(value: Type\\)"
            NESTED_AGGREGATE_KIND: sview = "value\\.element_element_element_element_element_element_kind in \\{TypeKind\\.Array, TypeKind\\.Map\\}"
            CAPTURE_INLINE_CHECK: sview = "type_inline_contains_mutable_aggregate\\(capture\\.type\\)"
            CAPTURE_TABLE_CHECK: sview = "capture\\.type\\.descriptor_id != 0 and type_table_contains_mutable_aggregate"
            DOCS_MALFORMED_LINKS: sview = "unknown or malformed child links fail closed"
            LEDGER_INTERNED_CHILDREN: sview = "interned TypeTable child descriptors"
            NESTED_AGGREGATE_TEST: sview = "multi_shot_rejects_nested_aggregate_in_malformed_type_descriptor"
            SINGLE_UNSAFE_ISSUE: sview = "IssueKind\\.UnsafeMultiShot\\) == 1"
            VALID_TYPE_DESCRIPTOR: sview = "return 0 if not type_kind_valid\\(kind\\) or not type_descriptor_child_arity_valid"
            VALID_CHILD_LINK: sview = "return 0 if child_id == 0 or child_id\\.usize\\(\\) > table\\.rows\\.count"
            CHILD_COUNT_LIMIT: sview = "return 0 if table\\.children\\.count > TypeTableLimits::U32_MAX"
            APPENDED_CHILD_COUNT_LIMIT: sview = "return 0 if children\\.count > TypeTableLimits::U32_MAX - table\\.children\\.count"
            INVALID_FORWARD_CHILD_TEST: sview = "invalid_forward_child"


        const module Messages:
            MISSING_ROOT: sview = "multi-shot TypeTable audit: missing repository root"
            UNRESOLVED_ROOT: sview = "multi-shot TypeTable audit: unable to resolve repository root"
            INCOMPLETE_RECURSIVE_WALK: sview = "multi-shot TypeTable audit: bounded recursive aggregate walk is incomplete"
            INCOMPLETE_ADMISSION: sview = "multi-shot TypeTable audit: descriptor admission/docs are incomplete"


        struct SearchCheck:
            input: Path
            pattern: sview


        def diagnostic(message: sview) -> void can[Console.Write]:
            _ = write_stderr(message + "\n")


        def recursive_walk_checks(verifier: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: verifier, pattern: Patterns::RECURSIVE_DECLARATION},
                SearchCheck{input: verifier, pattern: Patterns::RECURSIVE_AGGREGATE},
                SearchCheck{input: verifier, pattern: Patterns::RECURSIVE_CHILD},
                SearchCheck{input: verifier, pattern: Patterns::RECURSION_LIMIT}
            ]


        def descriptor_admission_checks(verifier: Path, type_table: Path, docs: Path, ledger: Path, tests: Path) -> darray[SearchCheck] can[Memory.Allocate, Abort.Panic]:
            return [
                SearchCheck{input: verifier, pattern: Patterns::TABLE_CHILD_LOOKUP},
                SearchCheck{input: verifier, pattern: Patterns::INLINE_DECLARATION},
                SearchCheck{input: verifier, pattern: Patterns::NESTED_AGGREGATE_KIND},
                SearchCheck{input: verifier, pattern: Patterns::CAPTURE_INLINE_CHECK},
                SearchCheck{input: verifier, pattern: Patterns::CAPTURE_TABLE_CHECK},
                SearchCheck{input: docs, pattern: Patterns::DOCS_MALFORMED_LINKS},
                SearchCheck{input: ledger, pattern: Patterns::LEDGER_INTERNED_CHILDREN},
                SearchCheck{input: tests, pattern: Patterns::NESTED_AGGREGATE_TEST},
                SearchCheck{input: tests, pattern: Patterns::SINGLE_UNSAFE_ISSUE},
                SearchCheck{input: type_table, pattern: Patterns::VALID_TYPE_DESCRIPTOR},
                SearchCheck{input: type_table, pattern: Patterns::VALID_CHILD_LINK},
                SearchCheck{input: type_table, pattern: Patterns::CHILD_COUNT_LIMIT},
                SearchCheck{input: type_table, pattern: Patterns::APPENDED_CHILD_COUNT_LIMIT},
                SearchCheck{input: tests, pattern: Patterns::INVALID_FORWARD_CHILD_TEST}
            ]


        def execute(rg: Executable, checks: darray[SearchCheck]) -> i64 can[Environment.Read, File.Read, Directory.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Format]:
            for check in checks:
                arguments: darray[sview] = ["-q", check.pattern, f"{check.input}"]
                status: i64 = try run_process(rg, arguments, 0i64) else err:
                    return 127i64
                return status if status != 0i64
            return 0i64


    public:
        def run_root(repository_root: Path) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            if not is_directory(repository_root):
                diagnostic(Messages::MISSING_ROOT)
                return 1i64
            root: Path = path_normalize(repository_root)
            paths: darray[Path] = [
                root.joinpath(Inputs::VERIFIER),
                root.joinpath(Inputs::TYPE_TABLE),
                root.joinpath(Inputs::IR_DOCS),
                root.joinpath(Inputs::LEDGER),
                root.joinpath(Inputs::IR_TESTS)
            ]
            for input_path in paths:
                return 1i64 if not is_file(input_path)

            rg: Executable = try executable("rg") else err:
                diagnostic(Messages::INCOMPLETE_RECURSIVE_WALK)
                return 1i64
            first_group: i64 = execute(rg, recursive_walk_checks(paths[0]))
            if first_group != 0i64:
                diagnostic(Messages::INCOMPLETE_RECURSIVE_WALK)
                return 1i64

            second_group: i64 = execute(rg, descriptor_admission_checks(paths[0], paths[1], paths[2], paths[3], paths[4]))
            if second_group != 0i64:
                diagnostic(Messages::INCOMPLETE_ADMISSION)
                return 1i64

            print("multi-shot TypeTable audit: nested aggregate capture rejection is bounded and fail-closed")
            return 0i64


        def run_default() -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
            root: Path = try EsShellInvocationPath::project_root(f"{Script::invocation_path()}") else err:
                diagnostic(Messages::UNRESOLVED_ROOT)
                return 1i64
            return run_root(root)


def main(arguments: darray[sview]) -> i64 can[Environment.Read, Directory.Read, File.Read, Process.Run, Memory.Allocate, Abort.Panic, Console.Write, Console.Format]:
    _ = arguments
    return EsMultishotTypeTableAudit::run_default()
