# ============================================================
# Elisa core Runtime - public wrappers and stage 1 adapters
# ============================================================

# ------------------------------------------------------------
# Type-to-string public API
# ------------------------------------------------------------

@link_name(strtod)
extern elisascript_float_strtod(value: u8&, end: u8&?) -> f64

def elisascript_float_format_candidate(buffer: mutable u8&, capacity: usize, value: f64, precision: i32) -> usize:
    can Console.Format, Abort.Panic:
        length: int = snprintf(buffer.cast[u8&?], capacity, "%.*g", precision, value)
        panic("float formatting failed") if length < 0 or length.usize() >= capacity
        return length.usize()

# Normalize a round-tripping C `%g` candidate to Python's fixed/scientific
# exponent ranges. The source and destination buffers must not overlap.
def elisascript_float_python_notation(source: mutable u8&, source_length: usize, destination: mutable u8&, destination_capacity: usize) -> usize:
    can Console.Format, Abort.Panic:
        normalized: mutable u8[64] = zeroed
        digits: mutable u8[32] = zeroed
        sign_length: usize = 1 if source_length > 0 and source[0] == 45u8 else 0
        first: u8 = source[sign_length]
        if first == 110u8:
            panic("float formatting buffer is too small") if destination_capacity < 4
            destination[0] <- 110
            destination[1] <- 97
            destination[2] <- 110
            destination[3] <- 0
            return 3
        if first == 105u8:
            panic("float formatting buffer is too small") if destination_capacity < source_length + 1
            for index in 0..<source_length:
                destination[index] <- source[index]
            destination[source_length] <- 0
            return source_length

        exponent_marker, decimal_marker =
            for index in sign_length..<source_length |exponent: usize = source_length, decimal: usize = source_length| -> (exponent, decimal):
                exponent <- index if source[index] == 101u8 or source[index] == 69u8
                decimal <- index if source[index] == 46u8

        digit_count: mutable usize = 0
        digits_before_decimal: mutable usize = 0
        mantissa_end: usize = exponent_marker
        for index in sign_length..<mantissa_end:
            byte: u8 = source[index]
            if byte >= 48u8 and byte <= 57u8:
                digits[digit_count] <- byte
                digit_count <- digit_count + 1
                digits_before_decimal <- digits_before_decimal + 1 if decimal_marker == source_length or index < decimal_marker

        scientific_exponent: mutable i32 = 0
        if exponent_marker < source_length:
            exponent_start: mutable usize = exponent_marker + 1
            exponent_negative: mutable bool = false
            if exponent_start < source_length and (source[exponent_start] == 43u8 or source[exponent_start] == 45u8):
                exponent_negative <- source[exponent_start] == 45u8
                exponent_start <- exponent_start + 1
            for index in exponent_start..<source_length:
                byte: u8 = source[index]
                if byte >= 48u8 and byte <= 57u8:
                    scientific_exponent <- scientific_exponent * 10 + (byte - 48u8).i32()
            scientific_exponent <- -scientific_exponent if exponent_negative
            if scientific_exponent >= -4 and scientific_exponent < 16:
                decimal_position: i32 = digits_before_decimal.i32() + scientific_exponent
                output_length: mutable usize = 0
                if sign_length != 0:
                    normalized[output_length] <- 45
                    output_length <- output_length + 1
                if decimal_position <= 0:
                    normalized[output_length] <- 48
                    normalized[output_length + 1] <- 46
                    output_length <- output_length + 2
                    zero_count: usize = (-decimal_position).usize()
                    for _ in 0..<zero_count:
                        normalized[output_length] <- 48
                        output_length <- output_length + 1
                    for index in 0..<digit_count:
                        normalized[output_length] <- digits[index]
                        output_length <- output_length + 1
                elif decimal_position.usize() >= digit_count:
                    for index in 0..<digit_count:
                        normalized[output_length] <- digits[index]
                        output_length <- output_length + 1
                    zero_count: usize = decimal_position.usize() - digit_count
                    for _ in 0..<zero_count:
                        normalized[output_length] <- 48
                        output_length <- output_length + 1
                else:
                    for index in 0..<digit_count:
                        normalized[output_length] <- digits[index]
                        output_length <- output_length + 1
                        if index + 1 == decimal_position.usize():
                            normalized[output_length] <- 46
                            output_length <- output_length + 1
                panic("float formatting buffer is too small") if output_length >= destination_capacity
                for index in 0..<output_length:
                    destination[index] <- normalized[index]
                destination[output_length] <- 0
                return output_length

        first_nonzero: mutable usize = digit_count
        for index in 0..<digit_count:
            first_nonzero <- index if first_nonzero == digit_count and digits[index] != 48u8
        if first_nonzero == digit_count:
            panic("float formatting buffer is too small") if destination_capacity < source_length + 1
            for index in 0..<source_length:
                destination[index] <- source[index]
            destination[source_length] <- 0
            return source_length

        fixed_exponent: i32 = digits_before_decimal.i32() - first_nonzero.i32() - 1
        if fixed_exponent >= 16:
            last_nonzero: mutable usize = digit_count - 1
            while last_nonzero > first_nonzero and digits[last_nonzero] == 48u8:
                last_nonzero <- last_nonzero - 1
            output_length: mutable usize = 0
            if sign_length != 0:
                normalized[output_length] <- 45
                output_length <- output_length + 1
            normalized[output_length] <- digits[first_nonzero]
            output_length <- output_length + 1
            if last_nonzero > first_nonzero:
                normalized[output_length] <- 46
                output_length <- output_length + 1
                for index in (first_nonzero + 1)..<(last_nonzero + 1):
                    normalized[output_length] <- digits[index]
                    output_length <- output_length + 1
            normalized[output_length] <- 101
            output_length <- output_length + 1
            exponent_text: mutable u8[16] = zeroed
            exponent_length: int = snprintf((&exponent_text[0]).cast[u8&?], 16.usize(), "%+03d", fixed_exponent)
            panic("float formatting exponent failed") if exponent_length < 0 or exponent_length.usize() >= 16
            final_length: usize = output_length + exponent_length.usize()
            panic("float formatting buffer is too small") if final_length >= destination_capacity
            for index in 0..<output_length:
                destination[index] <- normalized[index]
            for index in 0..<exponent_length.usize():
                destination[output_length + index] <- exponent_text[index]
            destination[final_length] <- 0
            return final_length

        panic("float formatting buffer is too small") if destination_capacity < source_length + 1
        for index in 0..<source_length:
            destination[index] <- source[index]
        destination[source_length] <- 0
        return source_length

# Write the first round-tripping candidate from one through seventeen
# significant digits in Python's fixed/scientific notation into caller-owned
# NUL-terminated storage. Callers choose their own policy for non-finite values.
def format_float_roundtrip_buffer(buffer: mutable u8&, capacity: usize, value: f64) -> usize:
    can Console.Format, Abort.Panic:
        panic("float formatting buffer is too small") if capacity < 2
        candidate: mutable u8[64] = zeroed
        precision: mutable i32 = 1
        candidate_length: mutable usize = 0
        matched: mutable bool = false
        while precision <= 17 and not matched:
            candidate_length <- elisascript_float_format_candidate((&candidate[0]), 64.usize(), value, precision)
            matched <- elisascript_float_strtod((&candidate[0]), null) == value
            precision <- precision + 1
        return elisascript_float_python_notation((&candidate[0]), candidate_length, buffer, capacity)

# The parameter and alloc_perm refer to the same arena descriptor. The helper
# uses them sequentially; returned storage is an allocation, not the descriptor.
# Its short-string and length-cache paths also allocate from perm_arena by name.
def int_to_string(value: i64) -> cstr:
    trusted Unsafe.Alias:
        return int_to_string_into(&perm_arena, value) can Memory.Allocate, Console.Format, Abort.Panic

def int_to_string_scratch(value: i64) -> cstr:
    return int_to_string_into(&scratch_arena, value) can Memory.Allocate, Console.Format, Abort.Panic

def bool_to_string(value: int) -> cstr:
    return bool_to_string_into(&perm_arena, value)

def bool_to_string_scratch(value: int) -> cstr:
    return bool_to_string_into(&scratch_arena, value)

# char_to_string_into ignores the arena parameter and allocates its copy through
# alloc_perm. This is the same deliberate descriptor alias as int_to_string.
def char_to_string(value: i64) -> cstr:
    trusted Unsafe.Alias:
        return char_to_string_into(&perm_arena, value) can Memory.Allocate, Abort.Panic

def char_to_string_scratch(value: i64) -> cstr:
    return char_to_string_into(&scratch_arena, value) can Memory.Allocate, Abort.Panic

def uint_to_string_scratch(value: u64) -> cstr:
    can Memory.Allocate, Console.Format, Abort.Panic:
        len: int = snprintf(null, 0, "%llu", value)
        panic("uint_to_string_scratch: snprintf failed") if len < 0
        length: usize = len.usize()
        allocation_length: usize = length + 1
        panic("uint_to_string_scratch: size overflow") if allocation_length == 0
        allocation_i64: i64 = allocation_length.i64()
        assert allocation_i64 >= 0 and allocation_i64.usize() == allocation_length
        out: mutable heap u8& = alloc_scratch(allocation_i64).cast[heap u8&]
        written: int = snprintf(out.cast[mutable u8&?], allocation_length, "%llu", value)
        panic("uint_to_string_scratch: snprintf length changed") if written != len
        trusted Unsafe.PointerCast:
            return out.cast[cstr]

def float_to_string_scratch(value: f64) -> cstr:
    can Memory.Allocate, Console.Format, Abort.Panic:
        buffer: mutable u8[64] = zeroed
        length: usize = format_float_roundtrip_buffer((&buffer[0]), 64.usize(), value)
        first: u8 = buffer[0]
        numeric_head: bool = (first >= 48u8 and first <= 57u8) or (first == 45u8 and length > 1 and buffer[1] >= 48u8 and buffer[1] <= 57u8)
        has_decimal_or_exponent: bool =
            for index in 0..<length |found: bool = false| -> found:
                found <- true if buffer[index] == 46u8 or buffer[index] == 101u8 or buffer[index] == 69u8
        append_integral_fraction: bool = numeric_head and not has_decimal_or_exponent
        allocation_length: usize = length + 1 if not append_integral_fraction else length + 3
        panic("float_to_string_scratch: size overflow") if allocation_length == 0
        allocation_i64: i64 = allocation_length.i64()
        assert allocation_i64 >= 0 and allocation_i64.usize() == allocation_length
        out: mutable heap u8& = alloc_scratch(allocation_i64).cast[heap u8&]
        for index in 0..<length:
            out[index] <- buffer[index]
        if append_integral_fraction:
            out[length] <- 46
            out[length + 1] <- 48
            out[length + 2] <- 0
        else:
            out[length] <- 0
        trusted Unsafe.PointerCast:
            return out.cast[cstr]

# ------------------------------------------------------------
# Basic string predicates
# ------------------------------------------------------------

def __cast__(value: static u8&) -> u8&:
    return value.cast[u8&]


def string_len(value: u8&?) -> i64:
    return runtime_strlen(value).i64()

def streq(lhs: u8&?, rhs: u8&?) -> int:
    left: u8& = lhs if lhs != null else ""
    right: u8& = rhs if rhs != null else ""

    return 1 if left.cast[uintptr] == right.cast[uintptr] or strcmp(left, right) == 0 else 0

# ============================================================
# Stage 1 runtime forwarding wrappers
# ============================================================

def rt_concat2(lhs: cstr[shape_left], rhs: cstr[shape_right]) -> cstr[shape_result]:
    return concat2(lhs, rhs) can Memory.Allocate, Abort.Panic

def rt_concat2_scratch(lhs: cstr[shape_left], rhs: cstr[shape_right]) -> cstr[shape_result]:
    return concat2_scratch(lhs, rhs) can Memory.Allocate, Abort.Panic

def rt_int_to_string(value: i64) -> cstr[shape_out]:
    return int_to_string(value) can Memory.Allocate, Console.Format, Abort.Panic

def rt_int_to_string_scratch(value: i64) -> cstr[shape_out]:
    return int_to_string_scratch(value) can Memory.Allocate, Console.Format, Abort.Panic

def rt_bool_to_string(value: int) -> cstr[shape_out]:
    return bool_to_string(value)

def rt_bool_to_string_scratch(value: int) -> cstr[shape_out]:
    return bool_to_string_scratch(value)

def rt_char_to_string(value: i64) -> cstr[shape_out]:
    return char_to_string(value) can Memory.Allocate, Abort.Panic

def rt_char_to_string_scratch(value: i64) -> cstr[shape_out]:
    return char_to_string_scratch(value) can Memory.Allocate, Abort.Panic

def ctx_strlen(value: cstr[shape_in]) -> i64:
    return string_len(value)

def ctx_streq(lhs: cstr[shape_left], rhs: cstr[shape_right]) -> int:
    return streq(lhs, rhs)

def ctx_string_slice_eq(value: cstr[shape_in], start: i64, end: i64, other: cstr[shape_other]) -> int:
    return string_slice_eq(value, start, end, other)

def ctx_string_slices_eq(lhs: cstr[shape_left], lhs_start: i64, lhs_end: i64, rhs: cstr[shape_right], rhs_start: i64, rhs_end: i64) -> int:
    return string_slices_eq(lhs, lhs_start, lhs_end, rhs, rhs_start, rhs_end)

def ctx_string_index(value: cstr[shape_in], index: i64) -> i64:
    return string_index(value, index)

def ctx_string_slice(value: cstr[shape_in], start: i64, end: i64) -> cstr[shape_out]:
    return string_slice(value, start, end) can Memory.Allocate, Abort.Panic

def ctx_string_view(value: cstr[shape_in], start: i64, end: i64) -> sview:
    return sview(value, start, end)

def ctx_string_view_len(view: sview) -> i64:
    return string_view_len(view)

def ctx_string_view_slice(view: sview, start: i64, end: i64) -> sview:
    return string_view_slice(view, start, end)

def ctx_string_view_prefix(view: sview, end: i64) -> sview:
    return string_view_prefix(view, end)

def ctx_string_view_suffix(view: sview, start: i64) -> sview:
    return string_view_suffix(view, start)

def ctx_string_view_index(view: sview, index: i64) -> i64:
    return string_view_index(view, index)

def ctx_string_view_eq(view: sview, other: cstr[shape_other]) -> int:
    return string_view_eq(view, other)

def ctx_string_views_eq(lhs: sview, rhs: sview) -> int:
    if likely lhs.len != rhs.len:
        return 0
    1 return if lhs.len == 0 or lhs.data.cast[uintptr] == rhs.data.cast[uintptr]
    return 1 if memcmp(lhs.data.cast[void&], rhs.data.cast[void&], lhs.len.usize()) == 0 else 0

def ctx_string_from_view(view: sview) -> cstr[shape_out]:
    return string_view_copy(view) can Memory.Allocate, Abort.Panic

def rt_reset_scratch():
    reset_scratch()

def rt_puts(value: u8&?) -> int:
    return puts(value if value != null else "") can Console.Write

# ------------------------------------------------------------
# Console printing
# ------------------------------------------------------------

const enum FileDescriptor of int:
    Input = 0
    Output = 1
    Error = 2

@link_name(write)
extern runtime_write(fd: FileDescriptor, buf: void&, count: usize) -> isize can[Console.Write]

# ------------------------------------------------------------
# Operator protocols (operator overloading)
# ------------------------------------------------------------
# A type opts into an operator by impl-ing the matching protocol; the compiler
# lowers `a OP b` to the protocol's dunder method. A value-returning op is a
# direct call to the impl. The inverses are DERIVED, so a type never redeclares
# them: `Eq`'s single `__eq__` yields both `==` and `!=` (negated), and `Ord`'s
# single `__cmp__` (which returns <0 / 0 / >0) yields all of `<` `>` `<=` `>=`.
# These are ordinary protocols — so they double as generic bounds, e.g.
# `def sum[T: Add](xs: darray[T]) -> T`. Value-type-first: strings use f-strings,
# not `+` (a naive concat chain would be quadratic).
protocol Add:
    def __add__(self: Self, other: Self) -> Self

protocol Sub:
    def __sub__(self: Self, other: Self) -> Self

protocol Mul:
    def __mul__(self: Self, other: Self) -> Self

protocol Div:
    def __div__(self: Self, other: Self) -> Self

protocol Neg:
    def __neg__(self: Self) -> Self

protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

protocol Ord:
    def __cmp__(self: Self, other: Self) -> i64

protocol Str:
    def __cast__(self: Self) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]

impl Str for cstr:
    def __cast__(self: cstr) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return self

impl Str for bool:
    def __cast__(self: bool) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return "true" if self else "false"

impl Str for sview:
    def __cast__(self: sview) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return string_view_copy(self)

impl Str for dstr:
    def __cast__(self: dstr) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return string_view_copy(bytes_view(self))

impl Str for char:
    def __cast__(self: char) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return char_to_string_scratch(self.i64())

impl Str for int:
    def __cast__(self: int) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return int_to_string_scratch(self.i64())

impl Str for i64:
    def __cast__(self: i64) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return int_to_string_scratch(self)

impl Str for i32:
    def __cast__(self: i32) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return int_to_string_scratch(self.i64())

impl Str for i16:
    def __cast__(self: i16) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return int_to_string_scratch(self.i64())

impl Str for i8:
    def __cast__(self: i8) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return int_to_string_scratch(self.i64())

impl Str for u32:
    def __cast__(self: u32) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return uint_to_string_scratch(self.u64())

impl Str for u16:
    def __cast__(self: u16) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return uint_to_string_scratch(self.u64())

impl Str for u8:
    def __cast__(self: u8) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return uint_to_string_scratch(self.u64())

impl Str for u64:
    def __cast__(self: u64) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return uint_to_string_scratch(self)

impl Str for usize:
    def __cast__(self: usize) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return uint_to_string_scratch(self.u64())

impl Str for uintptr:
    def __cast__(self: uintptr) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return uint_to_string_scratch(self.u64())

impl Str for f64:
    def __cast__(self: f64) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return float_to_string_scratch(self)

impl Str for f32:
    def __cast__(self: f32) -> cstr can[Memory.Allocate, Console.Format, Abort.Panic]:
        return float_to_string_scratch(self.f64())

def printr(value: cstr) -> void can[Console.Write]:
    length: usize = runtime_strlen(value)
    return if length == 0
    _ = runtime_write(FileDescriptor.Output, value.cast[void&], length) can Console.Write

def print(value: cstr) -> void can[Console.Write]:
    printr(value) can Console.Write
    _ = runtime_write(FileDescriptor.Output, "\n".cast[void&], 1.usize()) can Console.Write

def printr[T: Str](value: T) -> void can[Console.Write, Memory.Allocate, Console.Format, Abort.Panic]:
    printr(T.__cast__(value) can Memory.Allocate, Console.Format, Abort.Panic) can Console.Write

def print[T: Str](value: T) -> void can[Console.Write, Memory.Allocate, Console.Format, Abort.Panic]:
    print(T.__cast__(value) can Memory.Allocate, Console.Format, Abort.Panic) can Console.Write

def printr(value: dstr) -> void can[Console.Write]:
    return if value.count == 0 or value.items == null
    items: u8& = value.items
    _ = runtime_write(FileDescriptor.Output, items.cast[void&], value.count) can Console.Write

def print(value: dstr) -> void can[Console.Write]:
    printr(value) can Console.Write
    _ = runtime_write(FileDescriptor.Output, "\n".cast[void&], 1.usize()) can Console.Write

# ------------------------------------------------------------
# Fatal error handler (weak linkage)
# ------------------------------------------------------------

# weak
def ctx_llvm_codegen_fatal(msg: u8&?):
    can Console, Abort.Exit:
        actual_msg: u8& = msg if msg != null else "<null>"
        puts("ctx_llvm_codegen_fatal:")
        puts(actual_msg)
        exit(1)
