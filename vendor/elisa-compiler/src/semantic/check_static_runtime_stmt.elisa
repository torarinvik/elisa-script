# Runtime call inside a `static:` block. A `static:` block evaluates at compile time, so an
# expression statement that calls an ordinary (runtime) function cannot be evaluated:
#
#   def keep() -> void: ...
#   def run() -> void:
#       static:
#           keep()          # error: must evaluate at compile time
#
# SOUND subset: flag a `Stmt.Expr` inside a `static:` block whose callee is a declared
# NON-static user function. A call to a static function, a builtin, or an extern (none in the
# user-function set) is a conservative miss, never a false positive.
extend Semantic:
    private:
        def srs_name_in(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        def srs_collect_user_fns(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            out.push(function_name)
                        Decl.Module(module_name, module_body, module_line):
                            srs_collect_user_fns(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            srs_collect_user_fns(scoped_body, out)
                        _:
                            pass

        def srs_walk_static_expr(expression: Ast::Expr, user_fns: darray[sview]&, static_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        callee_name: sview = ident_name_of(callee)
                        is_runtime_user_call: bool = callee_name != "" and srs_name_in(user_fns, callee_name) and not srs_name_in(static_fns, callee_name)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StaticRuntimeStatement, name: callee_name, line: call_line.line, expected: "", actual: ""}) if is_runtime_user_call
                        table <- srs_walk_static_expr(callee, user_fns, static_fns, table)
                        for argument in arguments |table| -> table:
                            table <- srs_walk_static_expr(argument, user_fns, static_fns, table)
                    Expr.Field(object, field, field_line) | Expr.Scope(object, field, field_line):
                        table <- srs_walk_static_expr(object, user_fns, static_fns, table)
                    Expr.Index(object, index, index_line):
                        table <- srs_walk_static_expr(object, user_fns, static_fns, table)
                        table <- srs_walk_static_expr(index, user_fns, static_fns, table)
                    Expr.Slice(object, low, high, slice_line):
                        table <- srs_walk_static_expr(object, user_fns, static_fns, table)
                        table <- srs_walk_static_expr(low, user_fns, static_fns, table)
                        table <- srs_walk_static_expr(high, user_fns, static_fns, table)
                    Expr.IndexN(object, arguments, index_line):
                        table <- srs_walk_static_expr(object, user_fns, static_fns, table)
                        for argument in arguments |table| -> table:
                            table <- srs_walk_static_expr(argument, user_fns, static_fns, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- srs_walk_static_expr(left, user_fns, static_fns, table)
                        table <- srs_walk_static_expr(right, user_fns, static_fns, table)
                    Expr.Unary(operator, operand, unary_line) | Expr.Move(operand, unary_line) | Expr.Paren(operand, unary_line):
                        table <- srs_walk_static_expr(operand, user_fns, static_fns, table)
                    Expr.If(condition, selected, alternative, if_line):
                        table <- srs_walk_static_expr(condition, user_fns, static_fns, table)
                        table <- srs_walk_static_expr(selected, user_fns, static_fns, table)
                        table <- srs_walk_static_expr(alternative, user_fns, static_fns, table)
                    Expr.Match(scrutinee, arms, match_line) | Expr.Catch(scrutinee, arms, match_line):
                        table <- srs_walk_static_expr(scrutinee, user_fns, static_fns, table)
                        for arm in arms |table| -> table:
                            table <- srs_walk_static_expr(arm.guard, user_fns, static_fns, table)
                            table <- srs_walk_static(arm.body, user_fns, static_fns, table)
                    Expr.Refinement(base, predicate, refinement_line):
                        table <- srs_walk_static_expr(base, user_fns, static_fns, table)
                        table <- srs_walk_static_expr(predicate, user_fns, static_fns, table)
                    Expr.GetElse(guarded, recovery, get_else_line):
                        table <- srs_walk_static_expr(guarded, user_fns, static_fns, table)
                        table <- srs_walk_static(recovery, user_fns, static_fns, table)
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_line):
                        table <- srs_walk_static_expr(iterable, user_fns, static_fns, table)
                        table <- srs_walk_static_expr(condition, user_fns, static_fns, table)
                        table <- srs_walk_static_expr(body, user_fns, static_fns, table)
                    Expr.Block(statements, value, captures, block_line):
                        table <- srs_walk_static(statements, user_fns, static_fns, table)
                        table <- srs_walk_static_expr(value, user_fns, static_fns, table)
                    Expr.Array(elements, array_line) | Expr.Tuple(elements, array_line) | Expr.SetLit(elements, array_line):
                        for element in elements |table| -> table:
                            table <- srs_walk_static_expr(element, user_fns, static_fns, table)
                    Expr.DictLit(entries, dict_line):
                        for entry in entries |table| -> table:
                            table <- srs_walk_static_expr(entry.key, user_fns, static_fns, table)
                            table <- srs_walk_static_expr(entry.value, user_fns, static_fns, table)
                    Expr.Construct(type_expression, fields, construct_line) | Expr.RecordUpdate(type_expression, fields, construct_line):
                        table <- srs_walk_static_expr(type_expression, user_fns, static_fns, table)
                        for field in fields |table| -> table:
                            table <- srs_walk_static_expr(field.value, user_fns, static_fns, table)
                    _:
                        pass

        # Walk a compile-time (static) statement subtree, flagging runtime-function call
        # statements.
        def srs_walk_static(statements: darray[Ast::Stmt], user_fns: darray[sview]&, static_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- srs_walk_static_expr(expression, user_fns, static_fns, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- srs_walk_static_expr(value, user_fns, static_fns, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- srs_walk_static_expr(target, user_fns, static_fns, table)
                            table <- srs_walk_static_expr(value, user_fns, static_fns, table)
                        Stmt.Return(value, line):
                            table <- srs_walk_static_expr(returned, user_fns, static_fns, table) if value is returned
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- srs_walk_static_expr(condition, user_fns, static_fns, table)
                            table <- srs_walk_static(then_body, user_fns, static_fns, table)
                            table <- srs_walk_static(else_body, user_fns, static_fns, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- srs_walk_static_expr(condition, user_fns, static_fns, table)
                            table <- srs_walk_static(while_body, user_fns, static_fns, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- srs_walk_static_expr(iterable, user_fns, static_fns, table)
                            table <- srs_walk_static(for_body, user_fns, static_fns, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- srs_walk_static(body, user_fns, static_fns, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- srs_walk_static_expr(scrutinee, user_fns, static_fns, table)
                            for arm in arms |table| -> table:
                                table <- srs_walk_static_expr(arm.guard, user_fns, static_fns, table)
                                table <- srs_walk_static(arm.body, user_fns, static_fns, table)
                        _:
                            pass

        # Walk ordinary (runtime) statements, entering static-block subtrees.
        def srs_walk(statements: darray[Ast::Stmt], user_fns: darray[sview]&, static_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- srs_walk_static(body, user_fns, static_fns, table) if kind == "static"
                            table <- srs_walk(body, user_fns, static_fns, table) if kind != "static"
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- srs_walk(then_body, user_fns, static_fns, table)
                            table <- srs_walk(else_body, user_fns, static_fns, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- srs_walk(while_body, user_fns, static_fns, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- srs_walk(for_body, user_fns, static_fns, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- srs_walk(arm.body, user_fns, static_fns, table)
                        _:
                            pass

        def srs_check_declarations(declarations: darray[Ast::Decl], user_fns: darray[sview]&, static_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- srs_walk(body, user_fns, static_fns, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- srs_check_declarations(module_body, user_fns, static_fns, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- srs_check_declarations(scoped_body, user_fns, static_fns, table)
                        _:
                            pass

    public:
        def check_static_runtime_stmt(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                user_fns: mutable darray[sview] = []
                srs_collect_user_fns(file.top_decls, user_fns)
                static_fns: mutable darray[sview] = []
                for annotation in file.enum_annotations |static_fns|:
                    static_fns.push(annotation.name) if annotation.owner == "__static_fn"
                table <- srs_check_declarations(file.top_decls, user_fns, static_fns, table)
