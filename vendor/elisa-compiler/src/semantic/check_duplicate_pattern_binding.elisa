# Duplicate pattern binding check — detects when a single match arm pattern
# or a for-loop binds the same name twice.

extend Semantic:
    private:
        # Match-arm alternatives bind independently: `A(x) | B(x)` is valid,
        # while `Pair(x, x)` is not.  Keep the name set local to each `or`
        # alternative, but share it across the fields of one concrete pattern.
        def check_duplicate_pattern_names(pattern: Ast::Pattern, names: mutable darray[sview]&, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Ast::Pattern.Binding(name):
                        if name != "":
                            duplicate: bool = any existing in names where existing == name
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicatePatternBinding, name: name, line: line, expected: "", actual: ""}) if duplicate
                            names.push(name) if not duplicate
                    Ast::Pattern.TypeBind(type_name, binder):
                        if binder != "":
                            duplicate: bool = any existing in names where existing == binder
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicatePatternBinding, name: binder, line: line, expected: "", actual: ""}) if duplicate
                            names.push(binder) if not duplicate
                    Ast::Pattern.Rest(name):
                        if name != "":
                            duplicate: bool = any existing in names where existing == name
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicatePatternBinding, name: name, line: line, expected: "", actual: ""}) if duplicate
                            names.push(name) if not duplicate
                    Ast::Pattern.As(name, inner):
                        if name != "":
                            duplicate: bool = any existing in names where existing == name
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicatePatternBinding, name: name, line: line, expected: "", actual: ""}) if duplicate
                            names.push(name) if not duplicate
                        for nested in inner |names, line, table|:
                            table <- check_duplicate_pattern_names(nested, names, line, table)
                    Ast::Pattern.Variant(path, fields) | Ast::Pattern.Struct(path, fields):
                        for field in fields |names, line, table|:
                            table <- check_duplicate_pattern_names(field, names, line, table)
                    Ast::Pattern.Field(selector, inner):
                        for nested in inner |names, line, table|:
                            table <- check_duplicate_pattern_names(nested, names, line, table)
                    Ast::Pattern.Tuple(elements):
                        for element in elements |names, line, table|:
                            table <- check_duplicate_pattern_names(element, names, line, table)
                    Ast::Pattern.Or(options):
                        # Each alternative has its own scope.  Do not merge
                        # names between alternatives, otherwise a valid
                        # `A(x) | B(x)` would be diagnosed as a duplicate.
                        for option in options |line, table|:
                            # Preserve names bound by an enclosing `as`/field
                            # pattern so an alternative cannot silently rebind
                            # one of them, while still isolating sibling arms.
                            alternative_names: mutable darray[sview] = [existing for existing in names]
                            table <- check_duplicate_pattern_names(option, alternative_names, line, table)
                    _:
                        pass


        def check_duplicate_pattern_binding_match_arms(arms: darray[Ast::MatchArm], line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for arm in arms |table|:
                    names: mutable darray[sview] = []
                    table <- check_duplicate_pattern_names(arm.pattern, names, line, table)


        # Recursively check for duplicate pattern bindings in statements.
        def check_duplicate_pattern_binding_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table|:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- check_duplicate_pattern_binding_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_duplicate_pattern_binding_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- check_duplicate_pattern_binding_expression(target, table)
                            table <- check_duplicate_pattern_binding_expression(value, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_duplicate_pattern_binding_expression(condition, table)
                            table <- check_duplicate_pattern_binding_statements(then_body, table)
                            table <- check_duplicate_pattern_binding_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_duplicate_pattern_binding_expression(condition, table)
                            table <- check_duplicate_pattern_binding_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            # Check for duplicate variables in the for loop
                            for i in 0..<variables.count:
                                for j in i + 1..<variables.count:
                                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicatePatternBinding, name: variables[i], line: line.line, expected: "", actual: ""}) if variables[i] != "_" and variables[i] == variables[j]
                            table <- check_duplicate_pattern_binding_expression(iterable, table)
                            table <- check_duplicate_pattern_binding_statements(body, table)
                        Stmt.Return(value, line):
                            table <- check_duplicate_pattern_binding_expression(return_value, table) if value is return_value
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_duplicate_pattern_binding_statements(body, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- check_duplicate_pattern_binding_expression(scrutinee, table)
                            table <- check_duplicate_pattern_binding_match_arms(arms, line.line, table)
                            for arm in arms |table|:
                                table <- check_duplicate_pattern_binding_expression(arm.guard, table)
                                table <- check_duplicate_pattern_binding_statements(arm.body, table)
                        Stmt.Contract(kind, expression, line):
                            table <- check_duplicate_pattern_binding_expression(expression, table)
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass


        # Recursively check for duplicate pattern bindings in expressions.
        def check_duplicate_pattern_binding_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- check_duplicate_pattern_binding_expression(callee, table)
                        for argument in arguments |table|:
                            table <- check_duplicate_pattern_binding_expression(argument, table)
                    Expr.Field(object, field, line):
                        table <- check_duplicate_pattern_binding_expression(object, table)
                    Expr.Scope(base, name, line):
                        table <- check_duplicate_pattern_binding_expression(base, table)
                    Expr.Index(object, index, line):
                        table <- check_duplicate_pattern_binding_expression(object, table)
                        table <- check_duplicate_pattern_binding_expression(index, table)
                    Expr.Slice(object, low, high, line):
                        table <- check_duplicate_pattern_binding_expression(object, table)
                        table <- check_duplicate_pattern_binding_expression(low, table)
                        table <- check_duplicate_pattern_binding_expression(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- check_duplicate_pattern_binding_expression(object, table)
                        for argument in arguments |table|:
                            table <- check_duplicate_pattern_binding_expression(argument, table)
                    Expr.Binary(left, operator, right, line):
                        table <- check_duplicate_pattern_binding_expression(left, table)
                        table <- check_duplicate_pattern_binding_expression(right, table)
                    Expr.Unary(operator, operand, line):
                        table <- check_duplicate_pattern_binding_expression(operand, table)
                    Expr.Paren(inner, line):
                        table <- check_duplicate_pattern_binding_expression(inner, table)
                    Expr.Array(elements, line):
                        for element in elements |table|:
                            table <- check_duplicate_pattern_binding_expression(element, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- check_duplicate_pattern_binding_expression(element, table)
                    Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- check_duplicate_pattern_binding_expression(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- check_duplicate_pattern_binding_expression(entry.key, table)
                            table <- check_duplicate_pattern_binding_expression(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- check_duplicate_pattern_binding_expression(type_expression, table)
                        for field in fields |table|:
                            table <- check_duplicate_pattern_binding_expression(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- check_duplicate_pattern_binding_expression(base, table)
                        for field in fields |table|:
                            table <- check_duplicate_pattern_binding_expression(field.value, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- check_duplicate_pattern_binding_expression(condition, table)
                        table <- check_duplicate_pattern_binding_expression(then_expr, table)
                        table <- check_duplicate_pattern_binding_expression(else_expr, table)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        table <- check_duplicate_pattern_binding_expression(scrutinee, table)
                        table <- check_duplicate_pattern_binding_match_arms(arms, line.line, table)
                        for arm in arms |table|:
                            table <- check_duplicate_pattern_binding_expression(arm.guard, table)
                            table <- check_duplicate_pattern_binding_statements(arm.body, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, line):
                        table <- check_duplicate_pattern_binding_expression(iterable, table)
                        table <- check_duplicate_pattern_binding_expression(condition, table)
                        table <- check_duplicate_pattern_binding_expression(body, table)
                    Expr.Lambda(parameters, body, line):
                        table <- check_duplicate_pattern_binding_statements(body, table)
                    Expr.Block(statements, value, captures, line):
                        table <- check_duplicate_pattern_binding_statements(statements, table)
                        table <- check_duplicate_pattern_binding_expression(value, table)
                    _:
                        pass


    public:
        # Entry point: check all function bodies for duplicate pattern bindings.
        def check_duplicate_pattern_binding(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- check_duplicate_pattern_binding_impl(body, table)
                        Decl.Module(module_name, body, line):
                            table <- check_duplicate_pattern_binding(body, table)
                        Decl.Scoped(body, line):
                            table <- check_duplicate_pattern_binding(body, table)
                        _:
                            pass


        # Helper to recurse into declaration bodies.
        def check_duplicate_pattern_binding_impl(body: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_duplicate_pattern_binding_statements(body, table)
