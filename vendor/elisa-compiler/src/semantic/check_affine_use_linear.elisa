# Stage1 semantic — the affine-use walk and linear types (`extend Semantic:
# private+public:`). Walks a body tracking which affine locals have been consumed,
# collects the linear type names and the locals holding them, and `check_affine_use_flow`
# drives the whole check. Continues check_affine_use.elisa; split out to keep each part
# file under 600 lines.

extend Semantic:
    private:
        def walk_affine_expression(expression: Ast::Expr, names: mutable darray[sview]&, flags: mutable darray[bool]&, consumed: mutable darray[sview]&, linear_names: darray[sview]&, consuming_fns: darray[sview]&, consuming_positions: darray[usize]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Unary(operator, operand, line):
                        table <- walk_affine_expression(operand, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                    Expr.Move(operand, line):
                        table <- walk_affine_expression(operand, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                        root: sview = affine_root(operand)
                        consumed.push(root) if root != "" and affine_local(names, flags, root) and not affine_consumed(consumed, root)
                    Expr.Ident(name, line):
                        table <- report_affine_consumed(name, line.line, consumed, table)
                    Expr.Field(object, field, line):
                        table <- walk_affine_expression(object, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                    Expr.Index(object, index, line):
                        table <- walk_affine_expression(object, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                        table <- walk_affine_expression(index, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- walk_affine_expression(callee, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                        for argument in arguments |table, consumed| -> table:
                            table <- walk_affine_expression(argument, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                        match callee:
                            Expr.Ident(consume_fn, consume_fn_line):
                                cc_probe: mutable usize = 0
                                while cc_probe < consuming_fns.count |cc_probe, consumed, consume_fn, arguments, consuming_fns, consuming_positions, names, flags|:
                                    if consuming_fns[cc_probe] == consume_fn and consuming_positions[cc_probe] < arguments.count:
                                        consume_root: sview = affine_root(arguments[consuming_positions[cc_probe]])
                                        consumed.push(consume_root) if consume_root != "" and affine_local(names, flags, consume_root) and not affine_consumed(consumed, consume_root)
                                    cc_probe <- cc_probe + 1
                            _:
                                pass
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        for field in fields |table, consumed| -> table:
                            table <- walk_affine_expression(field.value, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |table, consumed| -> table:
                            table <- walk_affine_expression(element, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                    Expr.Binary(left, operator, right, line):
                        table <- walk_affine_expression(left, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                        table <- walk_affine_expression(right, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table) if operator != TokenKind.Is and operator != TokenKind.As
                    Expr.Paren(inner, line):
                        table <- walk_affine_expression(inner, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                    Expr.Scope(base, name, line):
                        table <- walk_affine_expression(base, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                    Expr.Slice(object, low, high, line):
                        table <- walk_affine_expression(object, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                        table <- walk_affine_expression(low, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                        table <- walk_affine_expression(high, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                    Expr.IndexN(object, arguments, line):
                        table <- walk_affine_expression(object, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                        for argument in arguments |table, consumed| -> table:
                            table <- walk_affine_expression(argument, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                    Expr.If(condition, selected, alternative, line):
                        table <- walk_affine_expression(condition, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                        then_consumed: mutable darray[sview] = []
                        else_consumed: mutable darray[sview] = []
                        then_consumed.extend(consumed)
                        else_consumed.extend(consumed)
                        table <- walk_affine_expression(selected, names, flags, then_consumed, linear_names, consuming_fns, consuming_positions, table)
                        table <- walk_affine_expression(alternative, names, flags, else_consumed, linear_names, consuming_fns, consuming_positions, table)
                        for consumed_name in then_consumed |consumed|:
                            consumed.push(consumed_name) if affine_consumed(else_consumed, consumed_name) and not affine_consumed(consumed, consumed_name)
                    Expr.Match(scrutinee, arms, line):
                        table <- walk_affine_expression(scrutinee, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                        match_consumed: mutable darray[sview] = []
                        match_has_arm: mutable bool = false
                        for arm in arms |table, match_consumed, match_has_arm| -> table:
                            arm_names: mutable darray[sview] = []
                            arm_flags: mutable darray[bool] = []
                            arm_consumed: mutable darray[sview] = []
                            arm_names.extend(names)
                            arm_flags.extend(flags)
                            arm_consumed.extend(consumed)
                            table <- walk_affine_expression(arm.guard, arm_names, arm_flags, arm_consumed, linear_names, consuming_fns, consuming_positions, table)
                            table <- walk_affine_statements(arm.body, arm_names, arm_flags, arm_consumed, linear_names, consuming_fns, consuming_positions, table)
                            if not match_has_arm:
                                match_consumed.extend(arm_consumed)
                                match_has_arm <- true
                            else:
                                retained: mutable darray[sview] = []
                                for carried in match_consumed |retained|:
                                    retained.push(carried) if affine_consumed(arm_consumed, carried)
                                match_consumed.truncate(0)
                                match_consumed.extend(retained)
                        for consumed_name in match_consumed |consumed|:
                            consumed.push(consumed_name) if not affine_consumed(consumed, consumed_name)
                    Expr.Catch(guarded, arms, line):
                        guarded_consumed: mutable darray[sview] = []
                        guarded_consumed.extend(consumed)
                        table <- walk_affine_expression(guarded, names, flags, guarded_consumed, linear_names, consuming_fns, consuming_positions, table)
                        catch_consumed: mutable darray[sview] = []
                        catch_consumed.extend(guarded_consumed)
                        catch_has_arm: mutable bool = false
                        for arm in arms |table, catch_consumed, catch_has_arm| -> table:
                            arm_names: mutable darray[sview] = []
                            arm_flags: mutable darray[bool] = []
                            arm_consumed: mutable darray[sview] = []
                            arm_names.extend(names)
                            arm_flags.extend(flags)
                            arm_consumed.extend(consumed)
                            table <- walk_affine_expression(arm.guard, arm_names, arm_flags, arm_consumed, linear_names, consuming_fns, consuming_positions, table)
                            table <- walk_affine_statements(arm.body, arm_names, arm_flags, arm_consumed, linear_names, consuming_fns, consuming_positions, table)
                            if not catch_has_arm:
                                retained: mutable darray[sview] = []
                                for carried in catch_consumed |retained|:
                                    retained.push(carried) if affine_consumed(arm_consumed, carried)
                                catch_consumed.truncate(0)
                                catch_consumed.extend(retained)
                                catch_has_arm <- true
                            else:
                                retained: mutable darray[sview] = []
                                for carried in catch_consumed |retained|:
                                    retained.push(carried) if affine_consumed(arm_consumed, carried)
                                catch_consumed.truncate(0)
                                catch_consumed.extend(retained)
                        for consumed_name in catch_consumed |consumed|:
                            consumed.push(consumed_name) if not affine_consumed(consumed, consumed_name)
                    Expr.Refinement(base, predicate, line):
                        table <- walk_affine_expression(base, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                        table <- walk_affine_expression(predicate, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                    Expr.GetElse(guarded, recovery, line):
                        guarded_consumed: mutable darray[sview] = []
                        recovery_consumed: mutable darray[sview] = []
                        guarded_consumed.extend(consumed)
                        recovery_consumed.extend(consumed)
                        recovery_names: mutable darray[sview] = []
                        recovery_flags: mutable darray[bool] = []
                        recovery_names.extend(names)
                        recovery_flags.extend(flags)
                        table <- walk_affine_expression(guarded, names, flags, guarded_consumed, linear_names, consuming_fns, consuming_positions, table)
                        table <- walk_affine_statements(recovery, recovery_names, recovery_flags, recovery_consumed, linear_names, consuming_fns, consuming_positions, table)
                        # Both branches start with consumed and only add names.
                        # Preserve those entries and append the shared additions,
                        # as for Expr.If, without storing a temporary array owner.
                        for carried in guarded_consumed |consumed|:
                            consumed.push(carried) if affine_consumed(recovery_consumed, carried) and not affine_consumed(consumed, carried)
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        table <- walk_affine_expression(iterable, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                        table <- walk_affine_expression(condition, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                        table <- walk_affine_expression(body, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                    # `await EXPR` / value-transparent blocks: walk both the statements and
                    # the payload so a moved task handle used after
                    # `task_group_add(..., move task)` is flagged. The block's declarations
                    # are scoped and must not make an affine name visible after the block.
                    Expr.Block(statements, value, captures, line):
                        block_scope_mark: usize = names.count
                        table <- walk_affine_statements(statements, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                        table <- walk_affine_expression(value, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                        names.truncate(block_scope_mark)
                        flags.truncate(block_scope_mark)
                    _:
                        pass


        def walk_affine_statements(statements: darray[Ast::Stmt], names: mutable darray[sview]&, flags: mutable darray[bool]&, consumed: mutable darray[sview]&, linear_names: darray[sview]&, consuming_fns: darray[sview]&, consuming_positions: darray[usize]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |names, flags, consumed, table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- walk_affine_expression(value, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                            names.push(name)
                            flags.push(affine_type_expression(type_expression, table))
                        Stmt.Assign(target, operator, value, line):
                            # Assignment targets can themselves read affine values through
                            # field/index receivers or computed keys.  Walking only the RHS
                            # let `slots[token] <- value` (and similar target expressions)
                            # bypass the use-after-consume check for `token`; preserve source
                            # evaluation order by visiting the target before the assigned value.
                            table <- walk_affine_expression(target, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                            table <- walk_affine_expression(value, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                            # An un-annotated `t = Ticket.new(...)` binds a fresh linear local (parsed
                            # as Assign, not VarDecl); register it so a later `move t` is tracked.
                            assign_name: sview = ident_name_of(target)
                            assign_is_linear: bool = assign_name != "" and linear_local_type((Ast::Expr.Absent), value, linear_names, table) != ""
                            names.push(assign_name) if assign_is_linear
                            flags.push(true) if assign_is_linear
                        Stmt.Expr(expression, line):
                            table <- walk_affine_expression(expression, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                            # A consuming call `f(x)` (f drives x to a terminal typestate)
                            # completes x's protocol — mark the linear-local argument consumed.
                            match expression:
                                Expr.Call(consume_callee, consume_args, consume_arg_names, consume_line):
                                    match consume_callee:
                                        Expr.Ident(consume_fn, consume_fn_line):
                                            cc_probe: mutable usize = 0
                                            while cc_probe < consuming_fns.count |cc_probe, consumed, consume_fn, consume_args, consuming_fns, consuming_positions, names, flags|:
                                                if consuming_fns[cc_probe] == consume_fn and consuming_positions[cc_probe] < consume_args.count:
                                                    consume_root: sview = affine_root(consume_args[consuming_positions[cc_probe]])
                                                    consumed.push(consume_root) if consume_root != "" and affine_local(names, flags, consume_root) and not affine_consumed(consumed, consume_root)
                                                cc_probe <- cc_probe + 1
                                        _:
                                            pass
                                _:
                                    pass
                        Stmt.Return(value, line):
                            match value:
                                returned:
                                    table <- walk_affine_expression(returned, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                                    returned_root: sview = affine_root(returned)
                                    consumed.push(returned_root) if returned_root != "" and affine_local(names, flags, returned_root) and not affine_consumed(consumed, returned_root)
                                _:
                                    pass
                        Stmt.If(condition, then_body, else_body, line):
                            table <- walk_affine_expression(condition, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                            then_names: mutable darray[sview] = []
                            then_flags: mutable darray[bool] = []
                            else_names: mutable darray[sview] = []
                            else_flags: mutable darray[bool] = []
                            then_names.extend(names)
                            then_flags.extend(flags)
                            else_names.extend(names)
                            else_flags.extend(flags)
                            then_consumed: mutable darray[sview] = []
                            else_consumed: mutable darray[sview] = []
                            then_consumed.extend(consumed)
                            else_consumed.extend(consumed)
                            table <- walk_affine_statements(then_body, then_names, then_flags, then_consumed, linear_names, consuming_fns, consuming_positions, table)
                            table <- walk_affine_statements(else_body, else_names, else_flags, else_consumed, linear_names, consuming_fns, consuming_positions, table)
                            for consumed_name in then_consumed |consumed|:
                                consumed.push(consumed_name) if affine_consumed(else_consumed, consumed_name) and not affine_consumed(consumed, consumed_name)
                        Stmt.Block(kind, clause, binding, body, line):
                            moved_root: sview = move_block_root(kind, body)
                            block_scope_mark: usize = names.count
                            table <- walk_affine_statements(body, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                            names.truncate(block_scope_mark)
                            flags.truncate(block_scope_mark)
                            consumed.push(moved_root) if moved_root != "" and affine_local(names, flags, moved_root) and not affine_consumed(consumed, moved_root)
                        Stmt.While(condition, body, line):
                            table <- walk_affine_expression(condition, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                            loop_names: mutable darray[sview] = []
                            loop_flags: mutable darray[bool] = []
                            loop_consumed: mutable darray[sview] = []
                            loop_names.extend(names)
                            loop_flags.extend(flags)
                            loop_consumed.extend(consumed)
                            table <- walk_affine_statements(body, loop_names, loop_flags, loop_consumed, linear_names, consuming_fns, consuming_positions, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- walk_affine_expression(iterable, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                            loop_names: mutable darray[sview] = []
                            loop_flags: mutable darray[bool] = []
                            loop_consumed: mutable darray[sview] = []
                            loop_names.extend(names)
                            loop_flags.extend(flags)
                            loop_consumed.extend(consumed)
                            table <- walk_affine_statements(body, loop_names, loop_flags, loop_consumed, linear_names, consuming_fns, consuming_positions, table)
                        Stmt.Match(scrutinee, arms, line):
                            matched_root: sview = affine_match_root(scrutinee)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineUseAfterConsume, name: matched_root, line: line.line, expected: "match", actual: ""}) if matched_root != "" and affine_consumed(consumed, matched_root)
                            table <- walk_affine_expression(scrutinee, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                            match_consumed: mutable darray[sview] = []
                            match_has_arm: mutable bool = false
                            for arm in arms |table, match_consumed, match_has_arm| -> table:
                                arm_names: mutable darray[sview] = []
                                arm_flags: mutable darray[bool] = []
                                arm_consumed: mutable darray[sview] = []
                                arm_names.extend(names)
                                arm_flags.extend(flags)
                                arm_consumed.extend(consumed)
                                table <- walk_affine_expression(arm.guard, arm_names, arm_flags, arm_consumed, linear_names, consuming_fns, consuming_positions, table)
                                table <- walk_affine_statements(arm.body, arm_names, arm_flags, arm_consumed, linear_names, consuming_fns, consuming_positions, table)
                                if not match_has_arm:
                                    match_consumed.extend(arm_consumed)
                                    match_has_arm <- true
                                else:
                                    retained: mutable darray[sview] = []
                                    for carried in match_consumed |retained|:
                                        retained.push(carried) if affine_consumed(arm_consumed, carried)
                                    match_consumed.truncate(0)
                                    match_consumed.extend(retained)
                            for consumed_name in match_consumed |consumed|:
                                consumed.push(consumed_name) if not affine_consumed(consumed, consumed_name)
                            consumed.push(matched_root) if matched_root != "" and affine_local(names, flags, matched_root) and not affine_consumed(consumed, matched_root)
                        _:
                            pass
                table <- report_linear_scope_leaks(statements, linear_names, consumed, table)


        # Names of `linear struct`/`linear typestate` types (affinity "linear"): a value of such
        # a type must be consumed exactly once, so an unconsumed local is a leak.
        def collect_linear_type_names(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations:
                    match declaration:
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, struct_line):
                            out.push(struct_name) if affinity == "linear"
                        Decl.Module(module_name, module_body, module_line):
                            collect_linear_type_names(module_body, out)
                        Decl.Scoped(scoped_body, scoped_line):
                            collect_linear_type_names(scoped_body, out)
                        _:
                            pass

        def linear_type_name_present(names: darray[sview]&, wanted: sview) -> bool:
            can Abort.Panic:
                return any name in names where name == wanted

        # The linear type name of a local (from its `: Linear` / `: Linear[State]` annotation or a
        # `Linear.new(...)` initializer), or "" when the local is not linear-typed.
        # Whether WHOLE equals PREFIX ++ MIDDLE ++ SUFFIX byte-for-byte.
        def linear_sview_wrapped(whole: sview, prefix: sview, middle: sview, suffix: sview) -> bool:
            can Abort.Panic:
                prefix_len: usize = sview_len(prefix)
                middle_len: usize = sview_len(middle)
                suffix_len: usize = sview_len(suffix)
                false return if sview_len(whole) != prefix_len + middle_len + suffix_len
                prefix_ok: bool =
                    for probe in 0..<prefix_len |ok: bool = true| -> ok:
                        ok <- false if sview_at(whole, probe) != sview_at(prefix, probe)
                false return if not prefix_ok
                middle_ok: bool =
                    for probe in 0..<middle_len |ok: bool = true| -> ok:
                        ok <- false if sview_at(whole, prefix_len + probe) != sview_at(middle, probe)
                false return if not middle_ok
                result: bool =
                    for probe in 0..<suffix_len |ok: bool = true| -> ok:
                        ok <- false if sview_at(whole, prefix_len + middle_len + probe) != sview_at(suffix, probe)
                return result

        # The linear type T of a synthesized typestate constructor call `__typestate_T_new(...)`
        # (the lowering of `T.new(...)` for a `linear typestate T`), else "". T must be a known
        # linear type name.
        def linear_typestate_new_type(callee_name: sview, linear_names: darray[sview]&) -> sview:
            can Memory.Allocate, Abort.Panic:
                prefix: sview = sview("__typestate_", 0, -1)
                suffix: sview = sview("_new", 0, -1)
                found: mutable sview = sview("", 0, 0)
                for candidate in linear_names |found|:
                    found <- candidate if found == "" and linear_sview_wrapped(callee_name, prefix, candidate, suffix)
                return found

        def linear_local_type(type_expression: Ast::Expr, value: Ast::Expr, linear_names: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                head_name: sview = match type_expression:
                    Expr.Index(head, argument, index_line): ident_name_of(head)
                    Expr.IndexN(head, arguments, index_n_line): ident_name_of(head)
                    _: bare_type_name(type_expression)
                head_name return if head_name != "" and linear_type_name_present(linear_names, head_name)
                match value:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Field(object, field, field_line):
                                ctor_type: sview = ident_name_of(object)
                                return ctor_type if field == "new" and linear_type_name_present(linear_names, ctor_type) else sview("", 0, 0)
                            _:
                                return linear_typestate_new_type(ident_name_of(callee), linear_names)
                    _:
                        return sview("", 0, 0)

        # Check only declarations owned by THIS statement list. Nested control-flow bodies are
        # checked when their own walk returns, using that body's path-specific consumption state;
        # flattening them into the enclosing function would incorrectly report a branch-local value
        # as leaked on paths where the branch never executes.
        def report_linear_scope_leaks(statements: darray[Ast::Stmt], linear_names: darray[sview]&, consumed: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            is_linear: bool = linear_local_type(type_expression, value, linear_names, table) != ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LinearScopeExit, name: name, line: line.line, expected: "", actual: ""}) if is_linear and not affine_consumed(consumed, name)
                        Stmt.Assign(target, operator, value, line):
                            name: sview = ident_name_of(target)
                            is_linear: bool = name != "" and linear_local_type((Ast::Expr.Absent), value, linear_names, table) != ""
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LinearScopeExit, name: name, line: line.line, expected: "", actual: ""}) if is_linear and not affine_consumed(consumed, name)
                        _:
                            pass

        # Collect (linear-local name, decl line) declared in a statement list (recursively).
        def collect_linear_locals(statements: darray[Ast::Stmt], linear_names: darray[sview]&, table: SymbolTable&, out_names: mutable darray[sview]&, out_lines: mutable darray[u32]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out_names, out_lines|:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            linear_type: sview = linear_local_type(type_expression, value, linear_names, table)
                            out_names.push(name) if linear_type != ""
                            out_lines.push(line.line) if linear_type != ""
                        Stmt.Assign(target, operator, value, line):
                            # An un-annotated first binding `t = Ticket.new(...)` parses as Assign,
                            # not VarDecl; detect a linear-valued one by its target ident.
                            assign_name: sview = ident_name_of(target)
                            assign_type: sview = linear_local_type((Ast::Expr.Absent), value, linear_names, table) if assign_name != "" else sview("", 0, 0)
                            out_names.push(assign_name) if assign_type != ""
                            out_lines.push(line.line) if assign_type != ""
                        Stmt.If(condition, then_body, else_body, line):
                            collect_linear_locals(then_body, linear_names, table, out_names, out_lines)
                            collect_linear_locals(else_body, linear_names, table, out_names, out_lines)
                        Stmt.While(condition, body, line):
                            collect_linear_locals(body, linear_names, table, out_names, out_lines)
                        Stmt.For(bind, variables, iterable, body, line):
                            collect_linear_locals(body, linear_names, table, out_names, out_lines)
                        Stmt.Block(kind, clause, binding, body, line):
                            collect_linear_locals(body, linear_names, table, out_names, out_lines)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |out_names, out_lines|:
                                collect_linear_locals(arm.body, linear_names, table, out_names, out_lines)
                        _:
                            pass

        # A BARE `return g` of a linear local returns it by COPY; a linear value must be moved
        # out (`return move g`). `move` wraps the value in Expr.Move, so only a plain-ident
        # return of a known linear local is flagged. Self-contained (own linear-local set),
        # so it needs no threading through the affine walk.
        def linear_return_walk(statements: darray[Ast::Stmt], linear_local_names: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                match returned:
                                    Expr.Ident(returned_name, returned_line):
                                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineMoveRequired, name: returned_name, line: line.line, expected: "Return", actual: ""}) if any linear_name in linear_local_names where linear_name == returned_name
                                    _:
                                        pass
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- linear_return_walk(then_body, linear_local_names, table)
                            table <- linear_return_walk(else_body, linear_local_names, table)
                        Stmt.While(while_condition, while_body, while_line):
                            table <- linear_return_walk(while_body, linear_local_names, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- linear_return_walk(for_body, linear_local_names, table)
                        Stmt.Block(block_kind, block_clause, block_binding, block_body, block_stmt_line):
                            table <- linear_return_walk(block_body, linear_local_names, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table| -> table:
                                table <- linear_return_walk(arm.body, linear_local_names, table)
                        _:
                            pass

        def check_affine_uses(declarations: darray[Ast::Decl], linear_names: darray[sview]&, consuming_fns: darray[sview]&, consuming_positions: darray[usize]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            names: mutable darray[sview] = []
                            flags: mutable darray[bool] = []
                            consumed: mutable darray[sview] = []
                            alias_names: mutable darray[sview] = []
                            alias_roots: mutable darray[sview] = []
                            shutdown_names: mutable darray[sview] = []
                            shutdown_flags: mutable darray[bool] = []
                            for param in params |names, flags|:
                                names.push(param.name)
                                flags.push(affine_type_expression(param.type_expression, table))
                            table <- walk_affine_statements(body, names, flags, consumed, linear_names, consuming_fns, consuming_positions, table)
                            linear_local_names: mutable darray[sview] = []
                            linear_local_lines: mutable darray[u32] = []
                            collect_linear_locals(body, linear_names, table, linear_local_names, linear_local_lines)
                            table <- linear_return_walk(body, linear_local_names, table)
                            lifecycle: u32 = lifecycle_statement_flags(body)
                            table <- walk_thread_pool_lifecycle(body, alias_names, alias_roots, shutdown_names, shutdown_flags, table) if (lifecycle & 8) != 0
                            for param in params |table| -> table:
                                obligation: sview = exit_obligation(param.type_expression, table)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineScopeExit, name: param.name, line: line.line, expected: obligation, actual: ""}) if obligation != "" and body_is_empty_pass(body)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineScopeExit, name: "group", line: line.line, expected: "task group with pending tasks", actual: ""}) if (lifecycle & 1) != 0 and (lifecycle & 2) == 0
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.AffineScopeExit, name: "pool", line: line.line, expected: "thread pool requiring shutdown", actual: ""}) if (lifecycle & 4) != 0 and (lifecycle & 8) == 0
                        Decl.Module(name, body, line):
                            table <- check_affine_uses(body, linear_names, consuming_fns, consuming_positions, table)
                        Decl.Scoped(body, line):
                            table <- check_affine_uses(body, linear_names, consuming_fns, consuming_positions, table)
                        _:
                            pass

    public:
        def check_affine_use_flow(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                linear_names: mutable darray[sview] = []
                collect_linear_type_names(file.top_decls, linear_names)
                # A call `f(x)` where f declares a typestate postcondition `x => S` drives x's
                # protocol forward via the callee — so passing a linear local there COMPLETES
                # its obligation for the caller (the callee owns the transition). Collect the
                # (fn, position) pairs that carry a typestate postcondition.
                consuming_fns: mutable darray[sview] = []
                consuming_positions: mutable darray[usize] = []
                for postcondition in file.typestate_postconditions |consuming_fns, consuming_positions|:
                    consuming_fns.push(postcondition.function_name)
                    consuming_positions.push(postcondition.position.usize())
                table <- check_affine_uses(file.top_decls, linear_names, consuming_fns, consuming_positions, table)
