# Check for a FIRM PRIMITIVE value (literal or firm scalar) bound where the declared
# type is a registered STRUCT (`q: P = 5`, `return 3` from `-> P`). Struct targets only:
# enums are NEVER targeted (an enum may legally accept int-ish values) and unknown/named
# targets never fire (the type-inference engine's Unknown is bottom).

extend Semantic:
    private:
        def close_named_type_scope(scope_mark: usize, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                var_types.truncate(scope_mark)
                type_names.truncate(scope_mark)

        # Whether `type_name` names a registered STRUCT. Query declaration identity rather
        # than struct-field rows so empty and positional-only structs are recognized too.
        def named_struct_target(type_name: sview, table: SymbolTable&) -> bool:
            can Abort.Panic:
                false return if type_name == ""
                row: mutable u32 = symbol_chain_head(table, type_name)
                while row != 4294967295 |row, table, type_name|:
                    symbol: Semantic::Symbol = table.symbols[row.usize()]
                    return true if symbol.name == type_name and symbol.kind == SymbolKind.Struct
                    row <- table.symbol_name_next[row.usize()]
                return false

        # The value's firm-primitive descriptor ("int"/"float"/"string"/"char"/"bool" from
        # a direct literal, or the inferred family for a firm scalar expression), "" if the
        # value is not a firm primitive (Construct/call/struct-typed ident/Unknown all yield
        # "" via the engine's Unknown bottom, by design — never flagged).
        def named_mismatch_value_kind(value: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: SymbolTable&) -> sview:
            can Memory.Allocate, Abort.Panic:
                literal_kind: sview = literal_kind_of(value)
                literal_kind return if literal_kind != ""
                return infer_family(value, names, types, table)

        # Flag a value against a declared STRUCT type if the value is a firm primitive.
        def check_named_value_against(value: Ast::Expr, type_name: sview, declared_name: sview, line: u32, names: darray[sview]&, types: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                value_kind: sview = named_mismatch_value_kind(value, names, types, table)
                firm_primitive: bool = value_kind == "int" or value_kind == "float" or value_kind == "string" or value_kind == "char" or value_kind == "bool"
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamedTypeMismatch, name: declared_name, line: line, expected: type_name, actual: value_kind}) if named_struct_target(type_name, table) and firm_primitive

        # Walk through statements, tracking variable types and checking for named-type
        # mismatches on var-decl initializers, `<-` reassignments, and returns.
        def walk_statements_for_named_type_mismatch(statements: darray[Ast::Stmt], return_type_name: sview, table: lmut SymbolTable, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, var_types, type_names| -> table:
                    match statement:
                        Stmt.VarDecl(name, type_expression, value, line):
                            type_name: sview = bare_type_name(type_expression)
                            table <- check_named_value_against(value, type_name, name, line.line, var_types, type_names, table)
                            note_local_type(var_types, type_names, name, type_name)
                        Stmt.Assign(target, operator, value, line):
                            if operator == TokenKind.LArrow:
                                match target:
                                    Expr.Ident(target_name, _):
                                        target_type: sview = local_type_of(var_types, type_names, target_name)
                                        table <- check_named_value_against(value, target_type, target_name, line.line, var_types, type_names, table)
                                    _:
                                        pass
                        Stmt.Return(value, line):
                            table <- check_named_value_against(returned_value, return_type_name, "return", line.line, var_types, type_names, table) if value is returned_value
                        Stmt.If(condition, then_body, else_body, line):
                            branch_scope_mark: usize = var_types.count
                            table <- walk_statements_for_named_type_mismatch(then_body, return_type_name, table, var_types, type_names)
                            close_named_type_scope(branch_scope_mark, var_types, type_names)
                            table <- walk_statements_for_named_type_mismatch(else_body, return_type_name, table, var_types, type_names)
                            close_named_type_scope(branch_scope_mark, var_types, type_names)
                        Stmt.While(condition, body, line):
                            loop_scope_mark: usize = var_types.count
                            table <- walk_statements_for_named_type_mismatch(body, return_type_name, table, var_types, type_names)
                            close_named_type_scope(loop_scope_mark, var_types, type_names)
                        Stmt.For(bind, variables, iterable, body, line):
                            loop_scope_mark: usize = var_types.count
                            for variable in variables |var_types, type_names|:
                                note_local_type(var_types, type_names, variable, "")
                            table <- walk_statements_for_named_type_mismatch(body, return_type_name, table, var_types, type_names)
                            close_named_type_scope(loop_scope_mark, var_types, type_names)
                        Stmt.Block(kind, clause, binding, body, line):
                            block_scope_mark: usize = var_types.count
                            note_local_type(var_types, type_names, binding, "") if binding != ""
                            table <- walk_statements_for_named_type_mismatch(body, return_type_name, table, var_types, type_names)
                            close_named_type_scope(block_scope_mark, var_types, type_names)
                        Stmt.Match(scrutinee, arms, line):
                            for arm in arms |table, var_types, type_names| -> table:
                                arm_scope_mark: usize = var_types.count
                                table <- walk_statements_for_named_type_mismatch(arm.body, return_type_name, table, var_types, type_names)
                                close_named_type_scope(arm_scope_mark, var_types, type_names)
                        Stmt.Expr(expression, line):
                            pass
                        Stmt.Contract(kind, expression, line):
                            pass
                        Stmt.Invalid:
                            pass
                        Stmt.Break(label, line):
                            pass
                        Stmt.Continue(label, line):
                            pass

        # Walk through function declarations, seeding a fresh local-type table + the
        # declared return type name per function.
        def check_named_type_mismatch_declarations(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table|:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            for param in params |var_types, type_names|:
                                param_type: sview = bare_type_name(param.type_expression)
                                note_local_type(var_types, type_names, param.name, param_type)
                            return_type_name: mutable sview = ""
                            if return_type is return_type_expr:
                                return_type_name <- bare_type_name(return_type_expr)
                            table <- walk_statements_for_named_type_mismatch(body, return_type_name, table, var_types, type_names)
                        Decl.Module(module_name, body, line):
                            table <- check_named_type_mismatch_declarations(body, table)
                        Decl.Scoped(body, line):
                            table <- check_named_type_mismatch_declarations(body, table)
                        _:
                            pass

    public:
        # Public entry point for the check.
        def check_named_type_mismatch(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_named_type_mismatch_declarations(declarations, table)
