# `signal Effect.Operation` names a permission whose family must exist: a builtin effect family, a
# user-declared `permission`/`effect`, or a family granted by a `can` clause somewhere in the file.
# User-declared `effect` families also carry a first-level operation registry captured by the
# parser; an unknown operation is reported before lowering can accidentally dispatch it.
# The signal statement is parsed as an inert Block("signal", [ref], …); this pass validates its clause.
extend Semantic:
    private:
        def sig_is_builtin_family(family: sview) -> bool:
            can Abort.Panic:
                return family in {"Progress", "Memory", "Abort", "Unsafe", "Sync", "Atomics", "Console", "Blocking", "Segment", "IO", "Time", "Panic", "Alloc", "Scalar", "ComplexFlow"}

        # Families that are known because a `can` grant in the file names them (recurse into blocks).
        def sig_collect_can_families(statements: darray[Ast::Stmt], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |out|:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            if kind == "can" or kind == "trusted":
                                out.extend([effect_ref_family(entry) for entry in clause])
                            sig_collect_can_families(body, out)
                        Stmt.If(condition, then_body, else_body, line):
                            sig_collect_can_families(then_body, out)
                            sig_collect_can_families(else_body, out)
                        Stmt.While(condition, body, line):
                            sig_collect_can_families(body, out)
                        Stmt.For(bind, variables, iterable, body, line):
                            sig_collect_can_families(body, out)
                        _:
                            pass

        def sig_collect_can_families_decls(declarations: darray[Ast::Decl], out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |out|:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            sig_collect_can_families(body, out)
                        Decl.Module(name, body, line):
                            sig_collect_can_families_decls(body, out)
                        Decl.Scoped(body, line):
                            sig_collect_can_families_decls(body, out)
                        _:
                            pass

        def sig_family_known(family: sview, user_perms: darray[sview]&, effect_declarations: darray[sview]&, can_families: darray[sview]&) -> bool:
            can Memory.Allocate, Abort.Panic:
                true return if sig_is_builtin_family(family)
                true return if any p in user_perms where p == family
                true return if any e in effect_declarations where e == family
                true return if any c in can_families where c == family
                return false

        struct SigEffectOperation:
            known: bool
            arity: u32
            enforce_arity: bool
            # Source-preserved declaration spans. These remain opaque until the
            # typed effect resolver interns them, but carrying them through the
            # operation lookup prevents payload/result syntax from being lost at
            # the semantic boundary.
            payload_signature: sview
            result_signature: sview
            # Stable `(family, operation)` identity shared with the parser and IR.
            # Zero remains the compatibility value for open families; rejected
            # unknown operations still receive a deterministic diagnostic identity.
            operation_id: u64 = 0


        # Whether a source-declared effect owns an operation with this name, and the
        # number of payload expressions its signature accepts. Builtin and
        # permission-only families intentionally remain open: their operation sets are
        # defined by the runtime/host, not by this source file.
        def sig_effect_operation(family: sview, operation: sview, declared: darray[sview]&, operations: darray[Ast::EffectOperation]&) -> SigEffectOperation:
            can Memory.Allocate, Abort.Panic:
                return SigEffectOperation{known: true, arity: 0, enforce_arity: false, payload_signature: "", result_signature: "", operation_id: 0} if operation == ""
                return SigEffectOperation{known: true, arity: 0, enforce_arity: false, payload_signature: "", result_signature: "", operation_id: 0} if not any name in declared where name == family
                for candidate in operations:
                    return SigEffectOperation{known: true, arity: candidate.arity, enforce_arity: true, payload_signature: candidate.payload_signature, result_signature: candidate.result_signature, operation_id: candidate.operation_id} if candidate.family == family and candidate.name == operation
                return SigEffectOperation{known: false, arity: 0, enforce_arity: true, payload_signature: "", result_signature: "", operation_id: Ast::effect_operation_identity(family, operation)}


        # The parser deliberately preserves an effect payload declaration as an opaque
        # source span.  The semantic pass only needs the small, sound subset that can be
        # checked without inventing a second type parser: top-level parameters whose
        # type is a bare primitive name.  Nested/container/function types stay unknown and
        # are left to the typed lowerer, which has the full type machinery.
        def sig_trim_effect_span(span: sview) -> sview:
            can Abort.Panic:
                start: mutable usize = 0
                finish: mutable usize = sview_len(span)
                while start < finish and (sview_at(span, start) == 32 or sview_at(span, start) == 9 or sview_at(span, start) == 10 or sview_at(span, start) == 13) |start, span, finish|:
                    start <- start + 1
                while finish > start and (sview_at(span, finish - 1) == 32 or sview_at(span, finish - 1) == 9 or sview_at(span, finish - 1) == 10 or sview_at(span, finish - 1) == 13) |start, span, finish|:
                    finish <- finish - 1
                return span[start:finish]


        def sig_effect_payload_segment(signature: sview, wanted: usize) -> sview:
            can Abort.Panic:
                return sview("", 0, 0) if sview_len(signature) < 2 or sview_at(signature, 0) != 40 or sview_at(signature, sview_len(signature) - 1) != 41
                segment_start: mutable usize = 1
                segment_index: mutable usize = 0
                parens: mutable u32 = 0
                brackets: mutable u32 = 0
                braces: mutable u32 = 0
                cursor: mutable usize = 1
                while cursor + 1 < sview_len(signature) |cursor, segment_start, segment_index, parens, brackets, braces|:
                    byte: u8 = sview_at(signature, cursor)
                    parens <- parens + 1 if byte == 40
                    parens <- parens - 1 if byte == 41 and parens > 0
                    brackets <- brackets + 1 if byte == 91
                    brackets <- brackets - 1 if byte == 93 and brackets > 0
                    braces <- braces + 1 if byte == 123
                    braces <- braces - 1 if byte == 125 and braces > 0
                    if byte == 44 and parens == 0 and brackets == 0 and braces == 0:
                        return sig_trim_effect_span(signature[segment_start:cursor]) if segment_index == wanted
                        segment_index <- segment_index + 1
                        segment_start <- cursor + 1
                    cursor <- cursor + 1
                return sig_trim_effect_span(signature[segment_start:sview_len(signature) - 1]) if segment_index == wanted
                return sview("", 0, 0)


        def sig_effect_payload_type(segment: sview) -> sview:
            can Abort.Panic:
                cleaned: sview = sig_trim_effect_span(segment)
                colon: mutable usize = sview_len(cleaned)
                parens: mutable u32 = 0
                brackets: mutable u32 = 0
                braces: mutable u32 = 0
                cursor: mutable usize = 0
                while cursor < sview_len(cleaned) |cursor, colon, parens, brackets, braces|:
                    byte: u8 = sview_at(cleaned, cursor)
                    parens <- parens + 1 if byte == 40
                    parens <- parens - 1 if byte == 41 and parens > 0
                    brackets <- brackets + 1 if byte == 91
                    brackets <- brackets - 1 if byte == 93 and brackets > 0
                    braces <- braces + 1 if byte == 123
                    braces <- braces - 1 if byte == 125 and braces > 0
                    colon <- cursor if colon == sview_len(cleaned) and byte == 58 and parens == 0 and brackets == 0 and braces == 0
                    cursor <- cursor + 1
                return sview("", 0, 0) if colon == sview_len(cleaned)
                type_name: sview = sig_trim_effect_span(cleaned[colon + 1:sview_len(cleaned)])
                if sview_len(type_name) >= 8 and type_name[0:8] == "mutable ":
                    type_name <- sig_trim_effect_span(type_name[8:sview_len(type_name)])
                return type_name if is_integer_type_name(type_name) or is_float_type_name(type_name) or is_string_type_name(type_name) or type_name == "bool" or type_name == "char"
                return sview("", 0, 0)


        def sig_effect_payload_type_at(signature: sview, wanted: usize) -> sview:
            can Abort.Panic:
                return sig_effect_payload_type(sig_effect_payload_segment(signature, wanted))


        def sig_check_effect_literal_payloads(arguments: darray[Ast::Expr]&, start_index: usize, operation: sview, signature: sview, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                return if start_index >= arguments.count
                argument_index: mutable usize = start_index
                payload_index: mutable usize = 0
                while argument_index < arguments.count |argument_index, payload_index, arguments, operation, signature, line, table|:
                    expected: sview = sig_effect_payload_type_at(signature, payload_index)
                    literal_kind: sview = literal_kind_of(arguments[argument_index])
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: operation, line: line, expected: expected, actual: stage0_literal_spelling(literal_kind), expected_count: (payload_index + 1).u32()}) if expected != "" and literal_kind != "" and literal_never_fits(literal_kind, expected)
                    argument_index <- argument_index + 1
                    payload_index <- payload_index + 1


        def sig_check_signal_literal_payloads(body: darray[Ast::Stmt]&, operation: sview, signature: sview, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                payload_index: mutable usize = 0
                for statement in body |payload_index, body, operation, signature, line, table|:
                    expected: sview = sig_effect_payload_type_at(signature, payload_index)
                    match statement:
                        Stmt.Expr(expression, expression_line):
                            literal_kind: sview = literal_kind_of(expression)
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: operation, line: line, expected: expected, actual: stage0_literal_spelling(literal_kind), expected_count: (payload_index + 1).u32()}) if expected != "" and literal_kind != "" and literal_never_fits(literal_kind, expected)
                        _:
                            pass
                    payload_index <- payload_index + 1


        # Source effect operation names are closed within their family. Overloads are
        # deliberately not part of the first Elisascript effect ABI: dispatch identifies
        # an operation by `(family, name)`, and accepting two signatures with that identity
        # would make payload arity (and eventually payload types) order-dependent. Report
        # only the later declaration so one typo cannot produce duplicate diagnostics for
        # the same pair.
        def sig_validate_effect_operation_duplicates(operations: darray[Ast::EffectOperation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                current_index: mutable usize = 0
                while current_index < operations.count |current_index, operations, table|:
                    current: Ast::EffectOperation = operations[current_index]
                    prior_index: mutable usize = 0
                    duplicate: mutable bool = false
                    while prior_index < current_index |operations, current, prior_index, duplicate|:
                        prior: Ast::EffectOperation = operations[prior_index]
                        duplicate <- true if prior.family == current.family and prior.name == current.name
                        prior_index <- prior_index + 1
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.DuplicateDecl, name: current.name, pos: Ast::Pos{line: current.line, column: current.column, offset: 0, end_line: current.line, end_column: current.end_column, end_offset: 0}, line: current.line, expected: current.family, actual: "effect operation"}) if duplicate
                    current_index <- current_index + 1


        # Validate the value-producing intrinsic `perform("Family.Operation", payload?)`.
        # Source-declared effects are closed over their first-level operations, so a direct
        # perform must name an existing operation and supply exactly its declared payload
        # count. Builtin and permission-only families remain open to host-defined operations.
        def sig_validate_perform(callee: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, line: u32, user_perms: darray[sview]&, can_families: darray[sview]&, effect_declarations: darray[sview]&, effect_operations: darray[Ast::EffectOperation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match callee:
                    Expr.Ident(name, ident_line):
                        return if name != "perform"
                    _:
                        return
                return if arguments.count == 0
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.NamedArgError, name: "perform", line: line, expected: "positional", actual: ""}) if any name in argument_names where name != ""
                match arguments[0]:
                    Expr.StringLit(reference):
                        dot_count: mutable u32 = 0
                        dot_index: mutable usize = 0
                        probe: mutable usize = 0
                        while probe < sview_len(reference) |dot_count, dot_index, probe|:
                            if sview_at(reference, probe) == 46:
                                dot_count <- dot_count + 1
                                dot_index <- probe
                            probe <- probe + 1
                        # The lowering intrinsic requires one non-empty family and operation;
                        # malformed references are owned by that lowerer, not this metadata pass.
                        return if dot_count != 1 or dot_index == 0 or dot_index + 1 >= sview_len(reference)
                        family: sview = reference[0:dot_index]
                        operation: sview = reference[dot_index + 1:sview_len(reference)]
                        known_family: bool = sig_family_known(family, user_perms, effect_declarations, can_families)
                        operation_info: SigEffectOperation = sig_effect_operation(family, operation, effect_declarations, effect_operations)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownPermissionMember, name: family, line: line, expected: "", actual: reference}) if not known_family
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownPermissionMember, name: family, line: line, expected: "", actual: operation}) if known_family and not operation_info.known
                        payload_count: u32 = arguments.count.u32() - 1
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownPermissionMember, name: family, line: line, expected: "", actual: operation}) if known_family and operation_info.known and operation_info.enforce_arity and payload_count != operation_info.arity
                        table <- sig_check_effect_literal_payloads(arguments, 1, operation, operation_info.payload_signature, line, table) if known_family and operation_info.known and operation_info.enforce_arity and payload_count == operation_info.arity
                    _:
                        pass


        # Recursive expression scan used only by the effect metadata pass. It deliberately
        # performs no name/type resolution; the ordinary resolver owns those diagnostics.
        def sig_scan_expression(expression: Ast::Expr, user_perms: darray[sview]&, can_families: darray[sview]&, effect_declarations: darray[sview]&, effect_operations: darray[Ast::EffectOperation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- sig_validate_perform(callee, arguments, argument_names, line.line, user_perms, can_families, effect_declarations, effect_operations, table)
                        table <- sig_scan_expression(callee, user_perms, can_families, effect_declarations, effect_operations, table)
                        for argument in arguments |table| -> table:
                            table <- sig_scan_expression(argument, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Field(object, field, line):
                        table <- sig_scan_expression(object, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Scope(base, name, line):
                        table <- sig_scan_expression(base, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Index(object, index, line):
                        table <- sig_scan_expression(object, user_perms, can_families, effect_declarations, effect_operations, table)
                        table <- sig_scan_expression(index, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Slice(object, low, high, line):
                        table <- sig_scan_expression(object, user_perms, can_families, effect_declarations, effect_operations, table)
                        table <- sig_scan_expression(low, user_perms, can_families, effect_declarations, effect_operations, table)
                        table <- sig_scan_expression(high, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.IndexN(object, arguments, line):
                        table <- sig_scan_expression(object, user_perms, can_families, effect_declarations, effect_operations, table)
                        for argument in arguments |table| -> table:
                            table <- sig_scan_expression(argument, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Binary(left, operator, right, line):
                        table <- sig_scan_expression(left, user_perms, can_families, effect_declarations, effect_operations, table)
                        table <- sig_scan_expression(right, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Unary(operator, operand, line):
                        table <- sig_scan_expression(operand, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Move(operand, line):
                        table <- sig_scan_expression(operand, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.RegionNew(operand, region, line):
                        table <- sig_scan_expression(operand, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Paren(inner, line):
                        table <- sig_scan_expression(inner, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- sig_scan_expression(element, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- sig_scan_expression(entry.key, user_perms, can_families, effect_declarations, effect_operations, table)
                            table <- sig_scan_expression(entry.value, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- sig_scan_expression(type_expression, user_perms, can_families, effect_declarations, effect_operations, table)
                        for field in fields |table| -> table:
                            table <- sig_scan_expression(field.value, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- sig_scan_expression(base, user_perms, can_families, effect_declarations, effect_operations, table)
                        for field in fields |table| -> table:
                            table <- sig_scan_expression(field.value, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.If(condition, then_expr, else_expr, line):
                        table <- sig_scan_expression(condition, user_perms, can_families, effect_declarations, effect_operations, table)
                        table <- sig_scan_expression(then_expr, user_perms, can_families, effect_declarations, effect_operations, table)
                        table <- sig_scan_expression(else_expr, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        table <- sig_scan_expression(scrutinee, user_perms, can_families, effect_declarations, effect_operations, table)
                        for arm in arms |table| -> table:
                            table <- sig_scan_expression(arm.guard, user_perms, can_families, effect_declarations, effect_operations, table)
                            table <- sig_walk_statements(arm.body, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        table <- sig_scan_expression(iterable, user_perms, can_families, effect_declarations, effect_operations, table)
                        table <- sig_scan_expression(condition, user_perms, can_families, effect_declarations, effect_operations, table)
                        table <- sig_scan_expression(body, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Refinement(base, predicate, line):
                        table <- sig_scan_expression(base, user_perms, can_families, effect_declarations, effect_operations, table)
                        table <- sig_scan_expression(predicate, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.GetElse(guarded, recovery, line):
                        table <- sig_scan_expression(guarded, user_perms, can_families, effect_declarations, effect_operations, table)
                        table <- sig_walk_statements(recovery, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Lambda(parameters, body, line):
                        table <- sig_walk_statements(body, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Block(statements, value, captures, line):
                        table <- sig_walk_statements(statements, user_perms, can_families, effect_declarations, effect_operations, table)
                        table <- sig_scan_expression(value, user_perms, can_families, effect_declarations, effect_operations, table)
                    Expr.Invalid:
                        pass
                    Expr.Absent:
                        pass
                    Expr.IntLit(_):
                        pass
                    Expr.IntLitTyped(_, _):
                        pass
                    Expr.FloatLit(_):
                        pass
                    Expr.StringLit(_):
                        pass
                    Expr.CharLit(_):
                        pass
                    Expr.BoolLit(_):
                        pass
                    Expr.Ident(_, _):
                        pass
                    Expr.ShorthandMember(_, _):
                        pass


        # Validate each `signal` clause's family; recurse through blocks (signals nest in grants).
        def sig_walk_statements(statements: darray[Ast::Stmt], user_perms: darray[sview]&, can_families: darray[sview]&, effect_declarations: darray[sview]&, effect_operations: darray[Ast::EffectOperation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Block(kind, clause, binding, body, line):
                            if kind == "signal" and clause.count > 0:
                                family: sview = effect_ref_family(clause[0])
                                operation: mutable sview = ""
                                dot: mutable usize = 0
                                while dot < sview_len(clause[0]) |clause, dot, operation|:
                                    if sview_at(clause[0], dot) == 46:
                                        operation <- clause[0][dot + 1:sview_len(clause[0])]
                                        break
                                    dot <- dot + 1
                                known_family: bool = sig_family_known(family, user_perms, effect_declarations, can_families)
                                operation_info: SigEffectOperation = sig_effect_operation(family, operation, effect_declarations, effect_operations)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownPermissionMember, name: family, line: line.line, expected: "", actual: clause[0]}) if not known_family
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownPermissionMember, name: family, line: line.line, expected: "", actual: operation}) if known_family and not operation_info.known
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownPermissionMember, name: family, line: line.line, expected: "", actual: operation}) if known_family and operation_info.known and operation_info.enforce_arity and body.count.u32() != operation_info.arity
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.TypeMismatch, name: operation, line: line.line, expected: "void", actual: operation_info.result_signature}) if known_family and operation_info.known and operation_info.enforce_arity and operation_info.result_signature != "" and operation_info.result_signature != "void"
                                table <- sig_check_signal_literal_payloads(body, operation, operation_info.payload_signature, line.line, table) if known_family and operation_info.known and operation_info.enforce_arity and body.count.u32() == operation_info.arity
                            table <- sig_walk_statements(body, user_perms, can_families, effect_declarations, effect_operations, table)
                        Stmt.Expr(expression, line):
                            table <- sig_scan_expression(expression, user_perms, can_families, effect_declarations, effect_operations, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- sig_scan_expression(type_expression, user_perms, can_families, effect_declarations, effect_operations, table)
                            table <- sig_scan_expression(value, user_perms, can_families, effect_declarations, effect_operations, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- sig_scan_expression(target, user_perms, can_families, effect_declarations, effect_operations, table)
                            table <- sig_scan_expression(value, user_perms, can_families, effect_declarations, effect_operations, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- sig_scan_expression(condition, user_perms, can_families, effect_declarations, effect_operations, table)
                            table <- sig_walk_statements(then_body, user_perms, can_families, effect_declarations, effect_operations, table)
                            table <- sig_walk_statements(else_body, user_perms, can_families, effect_declarations, effect_operations, table)
                        Stmt.While(condition, body, line):
                            table <- sig_scan_expression(condition, user_perms, can_families, effect_declarations, effect_operations, table)
                            table <- sig_walk_statements(body, user_perms, can_families, effect_declarations, effect_operations, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- sig_scan_expression(iterable, user_perms, can_families, effect_declarations, effect_operations, table)
                            table <- sig_walk_statements(body, user_perms, can_families, effect_declarations, effect_operations, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- sig_scan_expression(scrutinee, user_perms, can_families, effect_declarations, effect_operations, table)
                            for arm in arms |table| -> table:
                                table <- sig_scan_expression(arm.guard, user_perms, can_families, effect_declarations, effect_operations, table)
                                table <- sig_walk_statements(arm.body, user_perms, can_families, effect_declarations, effect_operations, table)
                        Stmt.Return(value, line):
                            if value is return_expression:
                                table <- sig_scan_expression(return_expression, user_perms, can_families, effect_declarations, effect_operations, table)
                        Stmt.Contract(kind, expression, line):
                            table <- sig_scan_expression(expression, user_perms, can_families, effect_declarations, effect_operations, table)
                        _:
                            pass

        def sig_walk_declarations(declarations: darray[Ast::Decl], user_perms: darray[sview]&, can_families: darray[sview]&, effect_declarations: darray[sview]&, effect_operations: darray[Ast::EffectOperation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                            table <- sig_walk_statements(body, user_perms, can_families, effect_declarations, effect_operations, table)
                        Decl.Module(name, body, line):
                            table <- sig_walk_declarations(body, user_perms, can_families, effect_declarations, effect_operations, table)
                        Decl.Scoped(body, line):
                            table <- sig_walk_declarations(body, user_perms, can_families, effect_declarations, effect_operations, table)
                        _:
                            pass

    public:
        def check_signal_effect(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                user_perms: mutable darray[sview] = []
                effect_declarations: mutable darray[sview] = []
                for annotation in file.enum_annotations |user_perms|:
                    user_perms.push(annotation.name) if annotation.owner == "__permission_decl"
                    effect_declarations.push(annotation.name) if annotation.owner == "__effect_decl"
                can_families: mutable darray[sview] = []
                sig_collect_can_families_decls(file.top_decls, can_families)
                table <- sig_validate_effect_operation_duplicates(file.effect_operations, table)
                table <- sig_walk_declarations(file.top_decls, user_perms, can_families, effect_declarations, file.effect_operations, table)
