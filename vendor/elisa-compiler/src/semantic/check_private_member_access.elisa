# Private module-member access. A member declared inside a module's `private:` section may
# only be referenced from within that module. A qualified access `Module::member` from
# OUTSIDE the module is rejected:
#
#   module Bar:
#       private:
#           def hidden() -> i32: ...
#       def open() -> i32: return hidden() * 2     # inside Bar — fine
#   def outside() -> i32:
#       return Bar::hidden()                       # outside Bar — error
#
# The parser records private members plus a source-line-paired owner marker. The owner is
# matched with the symbol table before rejecting qualified access, so same-named public
# members in another module remain accessible. Name resolution consumes the same index to
# keep imported private names out of unqualified scope.
extend Semantic:
    private:
        def pma_index_private_members(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table|:
                    continue if annotation.owner != "__private_member"
                    for owner_annotation in file.enum_annotations |table, annotation|:
                        if owner_annotation.name == "__private_member_owner" and owner_annotation.line == annotation.line:
                            table.private_member_owner <- table.private_member_owner.push(owner_annotation.owner)
                            table.private_member_name <- table.private_member_name.push(annotation.name)

        def pma_is_private(annotations: darray[Ast::EnumAnnotation]&, module_name: sview, member: sview) -> bool:
            can Abort.Panic:
                for annotation in annotations |annotations, module_name, member|:
                    continue if annotation.owner != "__private_member" or annotation.name != member
                    for owner_annotation in annotations |annotation, annotations, module_name|:
                        true return if owner_annotation.name == "__private_member_owner" and owner_annotation.line == annotation.line and owner_annotation.owner == module_name
                return false

        def pma_module_owns(table: SymbolTable&, module_name: sview, member: sview) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                while index < table.module_member_owner.count |index|:
                    true return if table.module_member_owner[index] == module_name and table.module_member_name[index] == member
                    index <- index + 1
                return false

        def pma_report(expression: Ast::Expr, current_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Scope(base, member, scope_line):
                        match base:
                            Expr.Ident(module_name, ident_line):
                                outside: bool = module_name != current_module and pma_is_private(annotations, module_name, member) and pma_module_owns(table, module_name, member)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PrivateMemberAccess, name: member, line: scope_line.line, expected: "", actual: module_name}) if outside
                            _:
                                pass
                        table <- pma_report(base, current_module, annotations, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- pma_report(callee, current_module, annotations, table)
                        for argument in arguments |table| -> table:
                            table <- pma_report(argument, current_module, annotations, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- pma_report(left, current_module, annotations, table)
                        table <- pma_report(right, current_module, annotations, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- pma_report(operand, current_module, annotations, table)
                    Expr.Paren(inner, paren_line):
                        table <- pma_report(inner, current_module, annotations, table)
                    Expr.Field(object, field, field_line):
                        table <- pma_report(object, current_module, annotations, table)
                    Expr.Index(object, index_argument, index_line):
                        table <- pma_report(object, current_module, annotations, table)
                        table <- pma_report(index_argument, current_module, annotations, table)
                    _:
                        pass

        def pma_walk_stmts(statements: darray[Ast::Stmt], current_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            table <- pma_report(returned, current_module, annotations, table) if value is returned
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- pma_report(value, current_module, annotations, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- pma_report(value, current_module, annotations, table)
                        Stmt.Expr(expression, line):
                            table <- pma_report(expression, current_module, annotations, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- pma_report(condition, current_module, annotations, table)
                            table <- pma_walk_stmts(then_body, current_module, annotations, table)
                            table <- pma_walk_stmts(else_body, current_module, annotations, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- pma_report(condition, current_module, annotations, table)
                            table <- pma_walk_stmts(while_body, current_module, annotations, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- pma_report(iterable, current_module, annotations, table)
                            table <- pma_walk_stmts(for_body, current_module, annotations, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- pma_walk_stmts(body, current_module, annotations, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- pma_report(scrutinee, current_module, annotations, table)
                            for arm in arms |table| -> table:
                                table <- pma_walk_stmts(arm.body, current_module, annotations, table)
                        _:
                            pass

        def pma_walk_declarations(declarations: darray[Ast::Decl], current_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            table <- pma_walk_stmts(body, current_module, annotations, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- pma_walk_declarations(module_body, module_name, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- pma_walk_declarations(scoped_body, current_module, annotations, table)
                        _:
                            pass

    public:
        def check_private_member_access(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                has_private: bool = any annotation in file.enum_annotations where annotation.owner == "__private_member"
                table <- pma_walk_declarations(file.top_decls, "", file.enum_annotations, table) if has_private
