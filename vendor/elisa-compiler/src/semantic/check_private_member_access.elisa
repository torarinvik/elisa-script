# Private module-member access. A member declared inside a module's `private:` section may
# only be referenced from within that module. A qualified access `Module::member` from
# OUTSIDE the module is rejected:
#
#   module Bar:
#       private:
#           def hidden() -> i32: ...
#       def open() -> i32: return hidden() * 2     # inside Bar — fine
#   def outside() -> i32:
#       return Bar::hidden()                       # outside Bar — error
#
# The parser records private members plus a source-line-paired owner marker. The owner is
# matched with the symbol table before rejecting qualified access, so same-named public
# members in another module remain accessible. Name resolution consumes the same index to
# keep imported private names out of unqualified scope.
extend Semantic:
    private:
        def pma_index_visibility_metadata(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for annotation in file.enum_annotations |table|:
                    if annotation.owner == "__private_member":
                        for owner_annotation in file.enum_annotations |table, annotation|:
                            if owner_annotation.name == "__private_member_owner" and owner_annotation.line == annotation.line:
                                table.private_member_owner <- table.private_member_owner.push(owner_annotation.owner)
                                table.private_member_name <- table.private_member_name.push(annotation.name)
                    elif annotation.owner == "__from_member":
                        imported_owner: mutable sview = ""
                        for source_annotation in file.enum_annotations |table, annotation|:
                            imported_owner <- source_annotation.name if imported_owner == "" and source_annotation.owner == "__from_src" and source_annotation.line == annotation.line
                        table.imported_member_owner <- table.imported_member_owner.push(imported_owner)

        def pma_is_private(annotations: darray[Ast::EnumAnnotation]&, module_name: sview, member: sview) -> bool:
            can Abort.Panic:
                for annotation in annotations |annotations, module_name, member|:
                    continue if annotation.owner != "__private_member" or annotation.name != member
                    for owner_annotation in annotations |annotation, annotations, module_name|:
                        true return if owner_annotation.name == "__private_member_owner" and owner_annotation.line == annotation.line and owner_annotation.owner == module_name
                return false

        def pma_module_owns(table: SymbolTable&, module_name: sview, member: sview) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                while index < table.module_member_owner.count |index|:
                    true return if table.module_member_owner[index] == module_name and table.module_member_name[index] == member
                    index <- index + 1
                return false

        def pma_module_owns_type(table: SymbolTable&, module_name: sview, member: sview) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                while index < table.qualified_type_module.count |index, table, module_name, member|:
                    true return if table.qualified_type_module[index] == module_name and table.qualified_type_name[index] == member
                    index <- index + 1
                return false

        def pma_is_generic_parameter(table: SymbolTable&, declaration_line: u32, name: sview) -> bool:
            can Abort.Panic:
                index: mutable usize = 0
                while index < table.generic_param_lines.count and index < table.generic_param_names.count |index, table, declaration_line, name|:
                    true return if table.generic_param_lines[index] == declaration_line and table.generic_param_names[index] == name
                    index <- index + 1
                return false

        def pma_is_value_parameter(value_names: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                # The SymbolTable's const-name rows are file-wide and carry no
                # declaration owner. Do not let an unrelated module's same-spelled
                # constant hide a private type reference in a generic argument.
                return any value_name in value_names where value_name == name

        def pma_has_public_imported_type(name: sview, excluded_owner: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for owner in table.imported_modules |owner, name, excluded_owner, annotations, table|:
                    true return if owner != excluded_owner and pma_module_owns_type(table, owner, name) and not pma_is_private(annotations, owner, name)
                index: mutable usize = 0
                while index < table.imported_members.count and index < table.imported_member_owner.count |index, table, name, excluded_owner, annotations|:
                    owner: sview = table.imported_member_owner[index]
                    true return if table.imported_members[index] == name and owner != excluded_owner and pma_module_owns_type(table, owner, name) and not pma_is_private(annotations, owner, name)
                    index <- index + 1
                return false

        def pma_is_imported_private_type(name: sview, current_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: SymbolTable&) -> bool:
            can Abort.Panic:
                for owner in table.imported_modules |owner, name, current_module, annotations, table|:
                    continue if owner == current_module or not pma_module_owns_type(table, owner, name)
                    continue if not pma_is_private(annotations, owner, name)
                    false return if pma_has_public_imported_type(name, owner, annotations, table)
                    return true
                index: mutable usize = 0
                while index < table.imported_members.count and index < table.imported_member_owner.count |index, table, name, current_module, annotations|:
                    owner: sview = table.imported_member_owner[index]
                    if table.imported_members[index] == name and owner != current_module and pma_module_owns_type(table, owner, name) and pma_is_private(annotations, owner, name):
                        false return if pma_has_public_imported_type(name, owner, annotations, table)
                        return true
                    index <- index + 1
                return false

        def pma_report_type(expression: Ast::Expr, current_module: sview, declaration_line: u32, allow_bare_type: bool, value_names: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Scope(base, member, scope_line):
                        match base:
                            Expr.Ident(module_name, ident_line):
                                outside: bool = module_name != current_module and pma_is_private(annotations, module_name, member) and pma_module_owns_type(table, module_name, member)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PrivateMemberAccess, name: member, line: scope_line.line, expected: "type", actual: module_name}) if outside
                            _:
                                pass
                        table <- pma_report_type(base, current_module, declaration_line, false, value_names, annotations, table)
                    Expr.Ident(name, line):
                        outside: bool = not pma_is_generic_parameter(table, declaration_line, name) and pma_is_imported_private_type(name, current_module, annotations, table)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PrivateMemberAccess, name: name, line: line.line, expected: "type", actual: "imported module"}) if allow_bare_type and outside
                    Expr.Unary(operator, operand, line):
                        table <- pma_report_type(operand, current_module, declaration_line, allow_bare_type, value_names, annotations, table)
                    Expr.Index(object, index, line):
                        # Generic arguments normally denote types, but fixed-array extents and
                        # dependent arguments can be values. Skip a bare argument already bound
                        # as a value; still inspect registered private type names and qualified
                        # types in the type positions.
                        table <- pma_report_type(object, current_module, declaration_line, allow_bare_type, value_names, annotations, table)
                        match index:
                            Expr.Ident(name, _):
                                table <- pma_report_type(index, current_module, declaration_line, not pma_is_value_parameter(value_names, name), value_names, annotations, table)
                            _:
                                table <- pma_report_type(index, current_module, declaration_line, true, value_names, annotations, table)
                    Expr.IndexN(object, arguments, line):
                        table <- pma_report_type(object, current_module, declaration_line, allow_bare_type, value_names, annotations, table)
                        for argument in arguments |table|:
                            match argument:
                                Expr.Ident(name, _):
                                    table <- pma_report_type(argument, current_module, declaration_line, not pma_is_value_parameter(value_names, name), value_names, annotations, table)
                                _:
                                    table <- pma_report_type(argument, current_module, declaration_line, true, value_names, annotations, table)
                    Expr.Tuple(elements, line):
                        for element in elements |table|:
                            table <- pma_report_type(element, current_module, declaration_line, allow_bare_type, value_names, annotations, table)
                    Expr.Paren(inner, line):
                        table <- pma_report_type(inner, current_module, declaration_line, allow_bare_type, value_names, annotations, table)
                    Expr.Refinement(base, predicate, line):
                        table <- pma_report_type(base, current_module, declaration_line, allow_bare_type, value_names, annotations, table)
                    _:
                        pass

        def pma_report(expression: Ast::Expr, current_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Scope(base, member, scope_line):
                        match base:
                            Expr.Ident(module_name, ident_line):
                                outside: bool = module_name != current_module and pma_is_private(annotations, module_name, member) and pma_module_owns(table, module_name, member)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.PrivateMemberAccess, name: member, line: scope_line.line, expected: "", actual: module_name}) if outside
                            _:
                                pass
                        table <- pma_report(base, current_module, annotations, table)
                    Expr.Call(callee, arguments, argument_names, call_line):
                        table <- pma_report(callee, current_module, annotations, table)
                        for argument in arguments |table| -> table:
                            table <- pma_report(argument, current_module, annotations, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- pma_report(left, current_module, annotations, table)
                        table <- pma_report(right, current_module, annotations, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- pma_report(operand, current_module, annotations, table)
                    Expr.Paren(inner, paren_line):
                        table <- pma_report(inner, current_module, annotations, table)
                    Expr.Field(object, field, field_line):
                        table <- pma_report(object, current_module, annotations, table)
                    Expr.Index(object, index_argument, index_line):
                        table <- pma_report(object, current_module, annotations, table)
                        table <- pma_report(index_argument, current_module, annotations, table)
                    _:
                        pass

        def pma_walk_stmts(statements: darray[Ast::Stmt], current_module: sview, declaration_line: u32, value_names: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            table <- pma_report(returned, current_module, annotations, table) if value is returned
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- pma_report_type(type_expression, current_module, declaration_line, true, value_names, annotations, table)
                            table <- pma_report(value, current_module, annotations, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- pma_report(value, current_module, annotations, table)
                        Stmt.Expr(expression, line):
                            table <- pma_report(expression, current_module, annotations, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- pma_report(condition, current_module, annotations, table)
                            table <- pma_walk_stmts(then_body, current_module, declaration_line, value_names, annotations, table)
                            table <- pma_walk_stmts(else_body, current_module, declaration_line, value_names, annotations, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- pma_report(condition, current_module, annotations, table)
                            table <- pma_walk_stmts(while_body, current_module, declaration_line, value_names, annotations, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- pma_report(iterable, current_module, annotations, table)
                            table <- pma_walk_stmts(for_body, current_module, declaration_line, value_names, annotations, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- pma_walk_stmts(body, current_module, declaration_line, value_names, annotations, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- pma_report(scrutinee, current_module, annotations, table)
                            for arm in arms |table| -> table:
                                table <- pma_walk_stmts(arm.body, current_module, declaration_line, value_names, annotations, table)
                        _:
                            pass

        def pma_walk_declarations(declarations: darray[Ast::Decl], current_module: sview, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                empty_value_names: darray[sview] = []
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            parameter_names: mutable darray[sview] = []
                            for parameter in parameters |parameter_names|:
                                parameter_names <- parameter_names.push(parameter.name)
                            for parameter in parameters |table|:
                                table <- pma_report_type(parameter.type_expression, current_module, line.line, true, parameter_names, annotations, table)
                            table <- pma_report_type(return_value, current_module, line.line, true, parameter_names, annotations, table) if return_type is return_value
                            table <- pma_walk_stmts(body, current_module, line.line, parameter_names, annotations, table)
                        Decl.Struct(struct_name, members, affinity, has_named_states, has_derive, invariants, line):
                            for member in members |table|:
                                table <- pma_report_type(member.type_expression, current_module, line.line, true, empty_value_names, annotations, table)
                        Decl.Const(const_name, type_expression, value, is_mutable, line):
                            table <- pma_report_type(type_expression, current_module, line.line, true, empty_value_names, annotations, table)
                        Decl.Alias(alias_name, target, line):
                            table <- pma_report_type(target, current_module, line.line, true, empty_value_names, annotations, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- pma_walk_declarations(module_body, module_name, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- pma_walk_declarations(scoped_body, current_module, annotations, table)
                        _:
                            pass

    public:
        def check_private_member_access(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                has_private: bool = any annotation in file.enum_annotations where annotation.owner == "__private_member"
                table <- pma_walk_declarations(file.top_decls, "", file.enum_annotations, table) if has_private
