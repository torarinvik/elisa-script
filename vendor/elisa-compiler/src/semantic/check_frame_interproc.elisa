# Interprocedural frame propagation. A function that declares `changes P.f` may only write those
# param fields — including THROUGH a call. When it calls `g(P)` and g declares `changes Q.h`, the
# caller may write `P.h`; if `h` is not in the caller's own `changes` set that is a violation
# ("may write P.h, which is outside the `changes` set of caller"). SOUND subset: fires only when
# BOTH caller and callee declare a `changes` clause, the argument is one of the caller's params,
# and the callee receives it in a `mutable T&` position (so it can write it). A callee with NO
# `changes` clause may write anything ("may write P" whole) but that broader case is left out here
# to keep over-fire near zero. Field registries: sentinel 3900000003 (owner=fn, name=field).
extend Semantic:
    private:
        def frame_interproc_changes_fields(annotations: darray[Ast::EnumAnnotation]&, function_name: sview, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                out.extend([annotation.name for annotation in annotations if annotation.owner == function_name and annotation.line == 3900000003 and annotation.name != ""])
                # A `fulfills SUBJECT is FrameLaw` (sentinel 3900000029) contributes the frame
                # law's own `changes` fields (sentinel 3900000028) — so `step` whose only
                # `changes` come from `fulfills s is MovesPlayerOnly` still has a KNOWN set.
                for fulfill in annotations |out, function_name, annotations|:
                    if fulfill.owner == function_name and fulfill.line == 3900000029 and fulfill.name != "":
                        out.extend([law_field.name for law_field in annotations if law_field.owner == fulfill.name and law_field.line == 3900000028 and law_field.name != ""])
        def frame_interproc_field_present(fields: darray[sview]&, field: sview) -> bool:
            can Abort.Panic:
                return any present in fields where present == field

        def frame_interproc_param_present(params: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                return any parameter in params where parameter == name

        # Whether callee's positional parameter at `position` is a `mutable T&` borrow.
        def frame_interproc_param_mutable_ref(table: SymbolTable&, callee: sview, position: usize) -> bool:
            can Abort.Panic:
                # Was an O(function_param_owner.count) scan of every parameter in the whole
                # program, per call argument — see the matching comment on
                # function_parameter_count in resolve_expr.elisa.
                seen: mutable usize = 0
                result: mutable bool = false
                cur: mutable u32 = function_param_chain_head(table, callee)
                while cur != 4294967295:
                    if table.function_param_owner[cur.usize()] == callee:
                        result <- table.function_param_mutable_ref[cur.usize()] if seen == position
                        seen <- seen + 1
                    cur <- table.function_param_name_next[cur.usize()]
                return result

        def frame_interproc_check_call(callee: sview, arguments: darray[Ast::Expr], caller_name: sview, caller_changes: darray[sview]&, caller_params: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                callee_changes: mutable darray[sview] = []
                frame_interproc_changes_fields(annotations, callee, callee_changes)
                # A callee with a `changes` clause writes only those fields; one WITHOUT any is
                # unconstrained and may write the whole param.
                callee_declares_changes: bool = callee_changes.count > 0
                callee_is_known: bool = direct_function_count(table, callee) > 0
                return if not callee_is_known
                position: mutable usize = 0
                for argument in arguments |table, position| -> table:
                    root: sview = ident_name_of(argument)
                    if root != "" and frame_interproc_param_present(caller_params, root) and frame_interproc_param_mutable_ref(table, callee, position):
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.WritesOutsideChanges, name: root, line: 0, expected: caller_name, actual: "", expected_count: 1}) if not callee_declares_changes
                        for changed_field in callee_changes |table| -> table:
                            table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.WritesOutsideChanges, name: root, line: 0, expected: caller_name, actual: changed_field, expected_count: 1}) if callee_declares_changes and not frame_interproc_field_present(caller_changes, changed_field)
                    position <- position + 1

        # Calls can occur in any value expression, not only as a standalone statement. Walk the
        # expression tree so interprocedural `changes` obligations cannot be bypassed by an
        # initializer, assignment, index, predicate, or aggregate literal.
        def frame_interproc_walk_expr(expression: Ast::Expr, caller_name: sview, caller_changes: darray[sview]&, caller_params: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Ident(callee_name, ident_line):
                                table <- frame_interproc_check_call(callee_name, arguments, caller_name, caller_changes, caller_params, annotations, table)
                            _:
                                pass
                        table <- frame_interproc_walk_expr(callee, caller_name, caller_changes, caller_params, annotations, table)
                        for argument in arguments |table| -> table:
                            table <- frame_interproc_walk_expr(argument, caller_name, caller_changes, caller_params, annotations, table)
                    Expr.Field(object, field, field_line) | Expr.Scope(object, field, field_line):
                        table <- frame_interproc_walk_expr(object, caller_name, caller_changes, caller_params, annotations, table)
                    Expr.Index(object, index, index_line):
                        table <- frame_interproc_walk_expr(object, caller_name, caller_changes, caller_params, annotations, table)
                        table <- frame_interproc_walk_expr(index, caller_name, caller_changes, caller_params, annotations, table)
                    Expr.Slice(object, low, high, slice_line):
                        table <- frame_interproc_walk_expr(object, caller_name, caller_changes, caller_params, annotations, table)
                        table <- frame_interproc_walk_expr(low, caller_name, caller_changes, caller_params, annotations, table)
                        table <- frame_interproc_walk_expr(high, caller_name, caller_changes, caller_params, annotations, table)
                    Expr.IndexN(object, arguments, index_line):
                        table <- frame_interproc_walk_expr(object, caller_name, caller_changes, caller_params, annotations, table)
                        for argument in arguments |table| -> table:
                            table <- frame_interproc_walk_expr(argument, caller_name, caller_changes, caller_params, annotations, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- frame_interproc_walk_expr(left, caller_name, caller_changes, caller_params, annotations, table)
                        table <- frame_interproc_walk_expr(right, caller_name, caller_changes, caller_params, annotations, table)
                    Expr.Unary(operator, operand, unary_line) | Expr.Move(operand, unary_line) | Expr.Paren(operand, unary_line):
                        table <- frame_interproc_walk_expr(operand, caller_name, caller_changes, caller_params, annotations, table)
                    Expr.If(condition, selected, alternative, if_line):
                        table <- frame_interproc_walk_expr(condition, caller_name, caller_changes, caller_params, annotations, table)
                        table <- frame_interproc_walk_expr(selected, caller_name, caller_changes, caller_params, annotations, table)
                        table <- frame_interproc_walk_expr(alternative, caller_name, caller_changes, caller_params, annotations, table)
                    Expr.Match(scrutinee, arms, match_line) | Expr.Catch(scrutinee, arms, match_line):
                        table <- frame_interproc_walk_expr(scrutinee, caller_name, caller_changes, caller_params, annotations, table)
                        for arm in arms |table| -> table:
                            table <- frame_interproc_walk_expr(arm.guard, caller_name, caller_changes, caller_params, annotations, table)
                            table <- frame_interproc_walk(arm.body, caller_name, caller_changes, caller_params, annotations, table)
                    Expr.Refinement(base, predicate, refinement_line):
                        table <- frame_interproc_walk_expr(base, caller_name, caller_changes, caller_params, annotations, table)
                        table <- frame_interproc_walk_expr(predicate, caller_name, caller_changes, caller_params, annotations, table)
                    Expr.GetElse(guarded, recovery, get_else_line):
                        table <- frame_interproc_walk_expr(guarded, caller_name, caller_changes, caller_params, annotations, table)
                        table <- frame_interproc_walk(recovery, caller_name, caller_changes, caller_params, annotations, table)
                    Expr.Comprehension(variable, iterable, condition, body, comprehension_line):
                        table <- frame_interproc_walk_expr(iterable, caller_name, caller_changes, caller_params, annotations, table)
                        table <- frame_interproc_walk_expr(condition, caller_name, caller_changes, caller_params, annotations, table)
                        table <- frame_interproc_walk_expr(body, caller_name, caller_changes, caller_params, annotations, table)
                    Expr.Block(statements, value, captures, block_line):
                        table <- frame_interproc_walk(statements, caller_name, caller_changes, caller_params, annotations, table)
                        table <- frame_interproc_walk_expr(value, caller_name, caller_changes, caller_params, annotations, table)
                    Expr.Array(elements, array_line) | Expr.Tuple(elements, array_line) | Expr.SetLit(elements, array_line):
                        for element in elements |table| -> table:
                            table <- frame_interproc_walk_expr(element, caller_name, caller_changes, caller_params, annotations, table)
                    Expr.DictLit(entries, dict_line):
                        for entry in entries |table| -> table:
                            table <- frame_interproc_walk_expr(entry.key, caller_name, caller_changes, caller_params, annotations, table)
                            table <- frame_interproc_walk_expr(entry.value, caller_name, caller_changes, caller_params, annotations, table)
                    Expr.Construct(type_expression, fields, construct_line) | Expr.RecordUpdate(type_expression, fields, construct_line):
                        table <- frame_interproc_walk_expr(type_expression, caller_name, caller_changes, caller_params, annotations, table)
                        for field in fields |table| -> table:
                            table <- frame_interproc_walk_expr(field.value, caller_name, caller_changes, caller_params, annotations, table)
                    _:
                        pass

        def frame_interproc_walk(statements: darray[Ast::Stmt], caller_name: sview, caller_changes: darray[sview]&, caller_params: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- frame_interproc_walk_expr(expression, caller_name, caller_changes, caller_params, annotations, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- frame_interproc_walk_expr(value, caller_name, caller_changes, caller_params, annotations, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- frame_interproc_walk_expr(target, caller_name, caller_changes, caller_params, annotations, table)
                            table <- frame_interproc_walk_expr(value, caller_name, caller_changes, caller_params, annotations, table)
                        Stmt.Return(value, line):
                            table <- frame_interproc_walk_expr(returned, caller_name, caller_changes, caller_params, annotations, table) if value is returned
                        Stmt.If(condition, then_body, else_body, line):
                            table <- frame_interproc_walk_expr(condition, caller_name, caller_changes, caller_params, annotations, table)
                            table <- frame_interproc_walk(then_body, caller_name, caller_changes, caller_params, annotations, table)
                            table <- frame_interproc_walk(else_body, caller_name, caller_changes, caller_params, annotations, table)
                        Stmt.While(condition, body, line):
                            table <- frame_interproc_walk_expr(condition, caller_name, caller_changes, caller_params, annotations, table)
                            table <- frame_interproc_walk(body, caller_name, caller_changes, caller_params, annotations, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- frame_interproc_walk_expr(iterable, caller_name, caller_changes, caller_params, annotations, table)
                            table <- frame_interproc_walk(body, caller_name, caller_changes, caller_params, annotations, table)
                        Stmt.Block(block_kind, clause, binding, body, line):
                            table <- frame_interproc_walk(body, caller_name, caller_changes, caller_params, annotations, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- frame_interproc_walk_expr(scrutinee, caller_name, caller_changes, caller_params, annotations, table)
                            for arm in arms |table| -> table:
                                table <- frame_interproc_walk_expr(arm.guard, caller_name, caller_changes, caller_params, annotations, table)
                                table <- frame_interproc_walk(arm.body, caller_name, caller_changes, caller_params, annotations, table)
                        _:
                            pass

        def check_frame_interproc_decls(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            caller_changes: mutable darray[sview] = []
                            frame_interproc_changes_fields(annotations, name, caller_changes)
                            if caller_changes.count > 0:
                                caller_params: darray[sview] = [parameter.name for parameter in params]
                                table <- frame_interproc_walk(body, name, caller_changes, caller_params, annotations, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_frame_interproc_decls(module_body, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_frame_interproc_decls(scoped_body, annotations, table)
                        _:
                            pass

    public:
        def check_frame_interproc(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- check_frame_interproc_decls(file.top_decls, file.enum_annotations, table)
