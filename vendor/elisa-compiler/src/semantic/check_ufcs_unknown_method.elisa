# UFCS method call to a non-existent method. `recv.method(args)` on a value of known struct
# type resolves to a field, a free UFCS function, or a conformed protocol method. When none
# exist it is an unknown access:
#
#   struct Bare: y: i64
#   protocol Eq: def eq(self: Self, other: Self) -> bool
#   def same(a: Bare, b: Bare) -> bool: return a.eq(b)   # error: Bare has no field "eq"
#
# SOUND subset: fire only when the receiver's struct has NO such field, NO free function of
# that name (an impl method registers a Func, so a conforming call is safe), AND the method is
# NOT a protocol DEFAULT method (a default is callable on any conformer without an impl —
# recorded by the parser at sentinel line 3900000062).
extend Semantic:
    private:
        def ufm_is_default_method(annotations: darray[Ast::EnumAnnotation]&, method: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.line == 3900000062 and annotation.name == method

        # Elisascript adds these typed text/collection operations in its lowerer
        # rather than as ordinary source-level UFCS functions. Text rows come
        # from the shared registry so semantic admission cannot drift from
        # receiver-aware lowering; the remaining collection/path rows stay in
        # this compatibility list until their structural descriptors migrate.
        def ufm_is_elisascript_builtin_method(method: sview) -> bool:
            return EsBuiltin::typed_builtin_method_spec("Text", method).known or EsBuiltin::typed_builtin_method_spec("Regex", method).known or EsBuiltin::typed_builtin_method_spec("Path", method).known or EsBuiltin::typed_builtin_method_spec("Map", method).known or EsBuiltin::typed_builtin_method_spec("Array", method).known or EsBuiltin::typed_builtin_method_spec("Set", method).known or method == "split" or method == "keys" or method == "values" or method == "contains" or method == "count" or method == "find" or method == "index" or method == "rfind" or method == "rindex" or method == "partition" or method == "rpartition" or method == "copy" or method == "reverse" or method == "setdefault" or method == "mkdir"

        def ufm_has_source_function(table: SymbolTable&, method: sview) -> bool:
            can Abort.Panic:
                for symbol in table.symbols:
                    return true if symbol.kind == SymbolKind.Func and symbol.name == method and symbol.line != 0
                return false

        # Registry-backed Text methods are lowered as builtins rather than source-level
        # UFCS functions, so direct-call arity checking cannot see their receiver-excluded
        # parameter range. Keep that contract at the semantic boundary: only a firmly known
        # string receiver is checked, while Unknown/container/Named receivers continue through
        # ordinary UFCS resolution without speculative diagnostics.
        def ufm_text_named_argument_allowed(spec: EsBuiltin::BuiltinSpec, index: usize, argument_name: sview) -> bool:
            return true if argument_name == ""
            return spec.argument_names != "" and index.u32() == spec.named_argument_index and argument_name == spec.argument_names

        def ufm_text_has_invalid_named_arguments(spec: EsBuiltin::BuiltinSpec, argument_names: darray[sview]&) -> bool:
            while argument_index < argument_names.count |argument_index: usize = 0|:
                return true if not ufm_text_named_argument_allowed(spec, argument_index, argument_names[argument_index])
                argument_index <- argument_index + 1
            return false

        def ufm_check_text_builtin_arity(method: sview, argument_count: usize, argument_names: darray[sview]&, method_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method)
                actual: u32 = argument_count.u32()
                mismatch: bool = spec.known and (actual < spec.arity_min or actual > spec.arity_max)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "n", actual: "", expected_count: spec.arity_min, actual_count: actual}) if mismatch and spec.arity_min == spec.arity_max
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "", actual: ""}) if mismatch and spec.arity_min != spec.arity_max
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CallArgumentError, name: method, pos: method_line, line: method_line.line, expected: "no_names", actual: ""}) if spec.known and ufm_text_has_invalid_named_arguments(spec, argument_names)

        # The first registry rows with positional text arguments use the compact
        # `text`/`text,text` descriptor. `join` additionally has a structural
        # `darray[text]` argument; validate it when the existing interned type table
        # gives us a firm container element ID, while keeping unknown expressions
        # conservative.
        def ufm_text_array_argument_is_text(expression: Ast::Expr, var_types: darray[sview]&, type_names: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                argument_id: u32 = structural_type_id_of(expression, var_types, type_names, table)
                return false if argument_id == 0 or interned_kind(argument_id, table) != SemTypeKind.Container
                head: sview = interned_name(argument_id, table)
                return false if head != "darray" and head != "array"
                return false if interned_elem_count(argument_id, table) != 1
                element_id: u32 = interned_elem(argument_id, 0, table)
                return interned_kind(element_id, table) == SemTypeKind.String

        def ufm_text_array_argument_is_known(expression: Ast::Expr, var_types: darray[sview]&, type_names: darray[sview]&, table: SymbolTable&) -> bool:
            return structural_type_id_of(expression, var_types, type_names, table) != 0

        def ufm_byte_array_argument_is_u8(expression: Ast::Expr, var_types: darray[sview]&, type_names: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                argument_id: u32 = structural_type_id_of(expression, var_types, type_names, table)
                return false if argument_id == 0 or interned_kind(argument_id, table) != SemTypeKind.Container
                head: sview = interned_name(argument_id, table)
                return false if head != "darray" and head != "array"
                return false if interned_elem_count(argument_id, table) != 1
                element_id: u32 = interned_elem(argument_id, 0, table)
                return interned_kind(element_id, table) == SemTypeKind.Int and interned_name(element_id, table) == "u8"

        def ufm_dictionary_argument_is_text_text(expression: Ast::Expr, var_types: darray[sview]&, type_names: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                argument_id: u32 = structural_type_id_of(expression, var_types, type_names, table)
                return false if argument_id == 0 or interned_kind(argument_id, table) != SemTypeKind.Container or interned_name(argument_id, table) != "dict"
                return false if interned_elem_count(argument_id, table) != 2
                key_id: u32 = interned_elem(argument_id, 0, table)
                value_id: u32 = interned_elem(argument_id, 1, table)
                return interned_kind(key_id, table) == SemTypeKind.String and interned_kind(value_id, table) == SemTypeKind.String

        # Process pipelines are the first registry contract with a nested
        # collection shape. Keep this recursive predicate bounded to the exact
        # one-element darray/array shells used by the pipeline ABI.
        def ufm_executable_array_argument_is_executable(expression: Ast::Expr, var_types: darray[sview]&, type_names: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                argument_id: u32 = structural_type_id_of(expression, var_types, type_names, table)
                return false if argument_id == 0 or interned_kind(argument_id, table) != SemTypeKind.Container
                head: sview = interned_name(argument_id, table)
                return false if head != "darray" and head != "array"
                return false if interned_elem_count(argument_id, table) != 1
                element_id: u32 = interned_elem(argument_id, 0, table)
                return interned_kind(element_id, table) == SemTypeKind.Named and interned_name(element_id, table) == "Executable"

        def ufm_nested_text_array_argument_is_text(expression: Ast::Expr, var_types: darray[sview]&, type_names: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                outer_id: u32 = structural_type_id_of(expression, var_types, type_names, table)
                return false if outer_id == 0 or interned_kind(outer_id, table) != SemTypeKind.Container
                outer_head: sview = interned_name(outer_id, table)
                return false if outer_head != "darray" and outer_head != "array"
                return false if interned_elem_count(outer_id, table) != 1
                inner_id: u32 = interned_elem(outer_id, 0, table)
                return false if interned_kind(inner_id, table) != SemTypeKind.Container
                inner_head: sview = interned_name(inner_id, table)
                return false if inner_head != "darray" and inner_head != "array"
                return false if interned_elem_count(inner_id, table) != 1
                element_id: u32 = interned_elem(inner_id, 0, table)
                return interned_kind(element_id, table) == SemTypeKind.String

        def ufm_check_text_builtin_argument_types(method: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, var_types: darray[sview]&, type_names: darray[sview]&, method_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method)
                argument_index: mutable usize = 0
                while argument_index < arguments.count:
                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    named_allowed: bool = ufm_text_named_argument_allowed(spec, argument_index, argument_name)
                    expected_text: bool = (spec.argument_types == "text" and argument_index == 0) or (spec.argument_types == "text,text" and argument_index < 2) or (spec.argument_types == "text,i64" and argument_index == 0)
                    expected_integer: bool = spec.argument_types == "text,i64" and argument_index == 1
                    expected_array_text: bool = spec.argument_types == "darray[text]" and argument_index == 0
                    expected_type: sview = "text" if expected_text else ("i64" if expected_integer else ("darray[text]" if expected_array_text else ""))
                    literal_kind: sview = literal_kind_of(arguments[argument_index])
                    argument_type: InferType = infer_expression_type(arguments[argument_index], var_types, type_names, table)
                    argument_family: sview = stage0_value_spelling(argument_type)
                    literal_fits: bool = (expected_text and literal_kind == "string") or (expected_integer and literal_kind == "int")
                    firm_fits: bool = (expected_text and argument_type.kind == SemTypeKind.String) or (expected_integer and argument_type.kind == SemTypeKind.Int)
                    structural_known: bool = expected_array_text and ufm_text_array_argument_is_known(arguments[argument_index], var_types, type_names, table)
                    structural_fits: bool = expected_array_text and ufm_text_array_argument_is_text(arguments[argument_index], var_types, type_names, table)
                    literal_bad: bool = expected_type != "" and named_allowed and literal_kind != "" and not literal_fits
                    firm_scalar_bad: bool = (expected_text or expected_integer) and argument_type.kind != SemTypeKind.Unknown and not firm_fits
                    firm_bad: bool = expected_type != "" and named_allowed and literal_kind == "" and (firm_scalar_bad or (structural_known and not structural_fits))
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LiteralArgTypeMismatch, name: method, pos: method_line, line: method_line.line, expected: expected_type, actual: stage0_literal_spelling(literal_kind), expected_count: (argument_index + 1).u32()}) if literal_bad
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: method, pos: method_line, line: method_line.line, expected: expected_type, actual: argument_family, expected_count: (argument_index + 1).u32()}) if firm_bad
                    argument_index <- argument_index + 1

        # Regex receiver rows currently accept only positional text values. Keep
        # this checker deliberately narrow: unknown expressions remain unknown,
        # while literals and firmly inferred scalar values receive precise
        # diagnostics before lowering.
        def ufm_check_regex_builtin_arity(method: sview, argument_count: usize, argument_names: darray[sview]&, method_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Regex", method)
                actual: u32 = argument_count.u32()
                mismatch: bool = spec.known and (actual < spec.arity_min or actual > spec.arity_max)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "n", actual: "", expected_count: spec.arity_min, actual_count: actual}) if mismatch and spec.arity_min == spec.arity_max
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "", actual: ""}) if mismatch and spec.arity_min != spec.arity_max
                while argument_index < argument_names.count |argument_index: usize = 0|:
                    named_allowed: bool = argument_names[argument_index] == "" or (spec.argument_types == "print" and (argument_names[argument_index] == "sep" or argument_names[argument_index] == "end" or argument_names[argument_index] == "flush")) or (spec.argument_names != "" and argument_index.u32() == spec.named_argument_index and argument_names[argument_index] == spec.argument_names)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CallArgumentError, name: method, pos: method_line, line: method_line.line, expected: "no_names", actual: ""}) if not named_allowed
                    argument_index <- argument_index + 1

        def ufm_check_regex_builtin_argument_types(method: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, var_types: darray[sview]&, type_names: darray[sview]&, method_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Regex", method)
                while argument_index < arguments.count |argument_index: usize = 0|:
                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    expected_text: bool = (spec.argument_types == "text" and argument_index == 0) or (spec.argument_types == "text,text" and argument_index < 2)
                    expected_type: sview = "text" if expected_text else ""
                    literal_kind: sview = literal_kind_of(arguments[argument_index])
                    argument_type: InferType = infer_expression_type(arguments[argument_index], var_types, type_names, table)
                    argument_family: sview = stage0_value_spelling(argument_type)
                    literal_fits: bool = expected_text and literal_kind == "string"
                    firm_fits: bool = expected_text and argument_type.kind == SemTypeKind.String
                    literal_bad: bool = expected_type != "" and argument_name == "" and literal_kind != "" and not literal_fits
                    firm_bad: bool = expected_type != "" and argument_name == "" and literal_kind == "" and argument_type.kind != SemTypeKind.Unknown and not firm_fits
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LiteralArgTypeMismatch, name: method, pos: method_line, line: method_line.line, expected: expected_type, actual: stage0_literal_spelling(literal_kind), expected_count: (argument_index + 1).u32()}) if literal_bad
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: method, pos: method_line, line: method_line.line, expected: expected_type, actual: argument_family, expected_count: (argument_index + 1).u32()}) if firm_bad
                    argument_index <- argument_index + 1

        def ufm_check_path_builtin_arity(method: sview, argument_count: usize, argument_names: darray[sview]&, method_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Path", method)
                actual: u32 = argument_count.u32()
                mismatch: bool = spec.known and (actual < spec.arity_min or actual > spec.arity_max)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "n", actual: "", expected_count: spec.arity_min, actual_count: actual}) if mismatch and spec.arity_min == spec.arity_max
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "", actual: ""}) if mismatch and spec.arity_min != spec.arity_max
                while argument_index < argument_names.count |argument_index: usize = 0|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CallArgumentError, name: method, pos: method_line, line: method_line.line, expected: "no_names", actual: ""}) if argument_names[argument_index] != ""
                    argument_index <- argument_index + 1

        def ufm_check_map_builtin_arity(method: sview, argument_count: usize, argument_names: darray[sview]&, method_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Map", method)
                actual: u32 = argument_count.u32()
                mismatch: bool = spec.known and (actual < spec.arity_min or actual > spec.arity_max)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "n", actual: "", expected_count: spec.arity_min, actual_count: actual}) if mismatch and spec.arity_min == spec.arity_max
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "", actual: ""}) if mismatch and spec.arity_min != spec.arity_max
                while argument_index < argument_names.count |argument_index: usize = 0|:
                    named_allowed: bool = argument_names[argument_index] == "" or (spec.argument_names != "" and argument_index.u32() == spec.named_argument_index and argument_names[argument_index] == spec.argument_names)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CallArgumentError, name: method, pos: method_line, line: method_line.line, expected: "no_names", actual: ""}) if not named_allowed
                    argument_index <- argument_index + 1

        def ufm_check_array_builtin_arity(method: sview, argument_count: usize, argument_names: darray[sview]&, method_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Array", method)
                actual: u32 = argument_count.u32()
                mismatch: bool = spec.known and (actual < spec.arity_min or actual > spec.arity_max)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "n", actual: "", expected_count: spec.arity_min, actual_count: actual}) if mismatch and spec.arity_min == spec.arity_max
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "", actual: ""}) if mismatch and spec.arity_min != spec.arity_max
                while argument_index < argument_names.count |argument_index: usize = 0|:
                    named_allowed: bool = argument_names[argument_index] == "" or (spec.argument_names != "" and argument_index.u32() == spec.named_argument_index and argument_names[argument_index] == spec.argument_names)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CallArgumentError, name: method, pos: method_line, line: method_line.line, expected: "no_names", actual: ""}) if not named_allowed
                    argument_index <- argument_index + 1

        def ufm_check_set_builtin_arity(method: sview, argument_count: usize, argument_names: darray[sview]&, method_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Set", method)
                actual: u32 = argument_count.u32()
                mismatch: bool = spec.known and (actual < spec.arity_min or actual > spec.arity_max)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "n", actual: "", expected_count: spec.arity_min, actual_count: actual}) if mismatch and spec.arity_min == spec.arity_max
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "", actual: ""}) if mismatch and spec.arity_min != spec.arity_max
                while argument_index < argument_names.count |argument_index: usize = 0|:
                    named_allowed: bool = argument_names[argument_index] == "" or (spec.argument_names != "" and argument_index.u32() == spec.named_argument_index and argument_names[argument_index] == spec.argument_names)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CallArgumentError, name: method, pos: method_line, line: method_line.line, expected: "no_names", actual: ""}) if not named_allowed
                    argument_index <- argument_index + 1

        def ufm_check_path_builtin_argument_types(method: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, var_types: darray[sview]&, type_names: darray[sview]&, method_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Path", method)
                while argument_index < arguments.count |argument_index: usize = 0|:
                    expected: sview = "text" if spec.argument_types == "text" and argument_index == 0 else ("darray[text]" if spec.argument_types == "darray[text]" and argument_index == 0 else ("darray[u8]" if spec.argument_types == "darray[u8]" and argument_index == 0 else ("Path" if spec.argument_types == "Path" and argument_index == 0 else ("u64" if spec.argument_types == "u64" and argument_index == 0 else ("bool" if spec.argument_types == "bool" and argument_index == 0 else "")))))
                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    literal_kind: sview = literal_kind_of(arguments[argument_index])
                    argument_type: InferType = infer_expression_type(arguments[argument_index], var_types, type_names, table)
                    argument_family: sview = stage0_value_spelling(argument_type)
                    fits: bool = ufm_global_argument_fits(expected, literal_kind, argument_type, arguments[argument_index], var_types, type_names, table)
                    literal_bad: bool = expected != "" and literal_kind != "" and not fits
                    structural_expected: bool = expected == "darray[text]" or expected == "darray[u8]"
                    structural_known: bool = structural_expected and structural_type_id_of(arguments[argument_index], var_types, type_names, table) != 0
                    firm_bad: bool = expected != "" and literal_kind == "" and argument_type.kind != SemTypeKind.Unknown and (not structural_expected or structural_known) and not fits
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LiteralArgTypeMismatch, name: method, pos: method_line, line: method_line.line, expected: expected, actual: stage0_literal_spelling(literal_kind), expected_count: (argument_index + 1).u32()}) if literal_bad
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: method, pos: method_line, line: method_line.line, expected: expected, actual: argument_family, expected_count: (argument_index + 1).u32()}) if firm_bad
                    argument_index <- argument_index + 1

        def ufm_global_argument_expected(spec: EsBuiltin::BuiltinSpec, index: usize) -> sview:
            return "collection" if spec.argument_types == "collection|text" and index == 0
            return "collection_path" if spec.argument_types == "collection|text|Path" and index == 0
            return "collection" if spec.argument_types == "collection,any" and index == 0
            return "any" if spec.argument_types == "collection,any" and index == 1
            return "text" if spec.argument_types == "text,any" and index == 0
            return "any" if spec.argument_types == "text,any" and index == 1
            return "text" if spec.argument_types == "text" and index == 0
            return "text|i64" if spec.argument_types == "text|i64" and index == 0
            return "text|f64" if spec.argument_types == "text|f64" and index == 0
            return "text" if spec.argument_types == "text,text" and index < 2
            return "text" if spec.argument_types == "text,text,text" and index < 3
            return "text" if spec.argument_types == "text,text,i64" and index < 2
            return "i64" if spec.argument_types == "text,text,i64" and index == 2
            return "array" if spec.argument_types == "array" and index == 0
            return "array" if spec.argument_types == "array,bool" and index == 0
            return "bool" if spec.argument_types == "array,bool" and index == 1
            return "i64|f64" if spec.argument_types == "i64|f64" and index == 0
            return "u64" if spec.argument_types == "u64" and index == 0
            return "darray[text]" if spec.argument_types == "darray[text],text" and index == 0
            return "text" if spec.argument_types == "darray[text],text" and index == 1
            return "text" if spec.argument_types == "text,Regex" and index == 0
            return "Regex" if spec.argument_types == "text,Regex" and index == 1
            return "text" if spec.argument_types == "text,Regex,text" and (index == 0 or index == 2)
            return "Regex" if spec.argument_types == "text,Regex,text" and index == 1
            return "Path" if spec.argument_types == "Path,u64" and index == 0
            return "u64" if spec.argument_types == "Path,u64" and index == 1
            return "Path" if spec.argument_types == "Path,Path" and index < 2
            return "Glob" if spec.argument_types == "Glob" and index == 0
            return "Path" if spec.argument_types == "Path,text" and index == 0
            return "text" if spec.argument_types == "Path,text" and index == 1
            return "Path" if (spec.argument_types == "Path,darray[text]" or spec.argument_types == "Path,darray[u8]") and index == 0
            return "darray[text]" if spec.argument_types == "Path,darray[text]" and index == 1
            return "darray[u8]" if spec.argument_types == "Path,darray[u8]" and index == 1
            return "sview" if spec.argument_types == "sview" and index == 0
            return "Executable" if spec.argument_types == "Executable,darray[text],i64" and index == 0
            return "darray[text]" if spec.argument_types == "Executable,darray[text],i64" and index == 1
            return "i64" if spec.argument_types == "Executable,darray[text],i64" and index == 2
            return "Executable" if spec.argument_types == "Executable,darray[text]" and index == 0
            return "darray[text]" if spec.argument_types == "Executable,darray[text]" and index == 1
            return "Executable" if spec.argument_types == "Executable,darray[text],sview" and index == 0
            return "darray[text]" if spec.argument_types == "Executable,darray[text],sview" and index == 1
            return "sview" if spec.argument_types == "Executable,darray[text],sview" and index == 2
            return "Executable" if spec.argument_types == "Executable,darray[text],sview,i64,i64" and index == 0
            return "darray[text]" if spec.argument_types == "Executable,darray[text],sview,i64,i64" and index == 1
            return "sview" if spec.argument_types == "Executable,darray[text],sview,i64,i64" and index == 2
            return "i64" if spec.argument_types == "Executable,darray[text],sview,i64,i64" and (index == 3 or index == 4)
            return "Executable" if spec.argument_types == "Executable,darray[text],Path" and index == 0
            return "darray[text]" if spec.argument_types == "Executable,darray[text],Path" and index == 1
            return "Path" if spec.argument_types == "Executable,darray[text],Path" and index == 2
            return "Executable" if spec.argument_types == "Executable,darray[text],dict[sview,sview]" and index == 0
            return "darray[text]" if spec.argument_types == "Executable,darray[text],dict[sview,sview]" and index == 1
            return "dict[sview,sview]" if spec.argument_types == "Executable,darray[text],dict[sview,sview]" and index == 2
            return "Executable" if spec.argument_types == "Executable,darray[text],Path,dict[sview,sview]" and index == 0
            return "darray[text]" if spec.argument_types == "Executable,darray[text],Path,dict[sview,sview]" and index == 1
            return "Path" if spec.argument_types == "Executable,darray[text],Path,dict[sview,sview]" and index == 2
            return "dict[sview,sview]" if spec.argument_types == "Executable,darray[text],Path,dict[sview,sview]" and index == 3
            return "Executable" if spec.argument_types == "Executable,darray[text],sview,Path,i64,i64" and index == 0
            return "darray[text]" if spec.argument_types == "Executable,darray[text],sview,Path,i64,i64" and index == 1
            return "sview" if spec.argument_types == "Executable,darray[text],sview,Path,i64,i64" and index == 2
            return "Path" if spec.argument_types == "Executable,darray[text],sview,Path,i64,i64" and index == 3
            return "i64" if spec.argument_types == "Executable,darray[text],sview,Path,i64,i64" and (index == 4 or index == 5)
            return "Executable" if spec.argument_types == "Executable,darray[text],sview,dict[sview,sview],i64,i64" and index == 0
            return "darray[text]" if spec.argument_types == "Executable,darray[text],sview,dict[sview,sview],i64,i64" and index == 1
            return "sview" if spec.argument_types == "Executable,darray[text],sview,dict[sview,sview],i64,i64" and index == 2
            return "dict[sview,sview]" if spec.argument_types == "Executable,darray[text],sview,dict[sview,sview],i64,i64" and index == 3
            return "i64" if spec.argument_types == "Executable,darray[text],sview,dict[sview,sview],i64,i64" and (index == 4 or index == 5)
            return "Executable" if spec.argument_types == "Executable,darray[text],sview,Path,dict[sview,sview],i64,i64" and index == 0
            return "darray[text]" if spec.argument_types == "Executable,darray[text],sview,Path,dict[sview,sview],i64,i64" and index == 1
            return "sview" if spec.argument_types == "Executable,darray[text],sview,Path,dict[sview,sview],i64,i64" and index == 2
            return "Path" if spec.argument_types == "Executable,darray[text],sview,Path,dict[sview,sview],i64,i64" and index == 3
            return "dict[sview,sview]" if spec.argument_types == "Executable,darray[text],sview,Path,dict[sview,sview],i64,i64" and index == 4
            return "i64" if spec.argument_types == "Executable,darray[text],sview,Path,dict[sview,sview],i64,i64" and (index == 5 or index == 6)
            return "darray[Executable]" if spec.argument_types == "darray[Executable],darray[darray[text]],sview" and index == 0
            return "darray[darray[text]]" if spec.argument_types == "darray[Executable],darray[darray[text]],sview" and index == 1
            return "sview" if spec.argument_types == "darray[Executable],darray[darray[text]],sview" and index == 2
            return "Regex" if spec.argument_types == "Regex,text" and index == 0
            return "text" if spec.argument_types == "Regex,text" and index == 1
            return "Regex" if spec.argument_types == "Regex,text,text" and index == 0
            return "text" if spec.argument_types == "Regex,text,text" and (index == 1 or index == 2)
            return "ProcessCapture" if spec.argument_types == "ProcessCapture" and index == 0
            return "i64" if spec.argument_types == "i64" and index == 0
            return "f64" if spec.argument_types == "f64" and index == 0
            return "bool" if spec.argument_types == "bool" and index == 0
            return "char" if spec.argument_types == "char" and index == 0
            return "Path" if spec.argument_types == "Path" and index == 0
            return "any" if spec.argument_types == "any" and index == 0
            return ""

        def ufm_global_argument_fits(expected: sview, literal_kind: sview, argument_type: InferType, expression: Ast::Expr, var_types: darray[sview]&, type_names: darray[sview]&, table: SymbolTable&) -> bool:
            return true if expected == "any"
            return (literal_kind == "string" or argument_type.kind == SemTypeKind.String) if expected == "text" or expected == "sview"
            return (literal_kind == "int" or (argument_type.kind == SemTypeKind.Int and argument_type.name == "i64")) if expected == "i64"
            return (literal_kind == "int" or (argument_type.kind == SemTypeKind.Int and argument_type.name == "u64")) if expected == "u64"
            return (literal_kind == "float" or argument_type.kind == SemTypeKind.Float) if expected == "f64"
            return (literal_kind == "string" or argument_type.kind == SemTypeKind.String or (argument_type.kind == SemTypeKind.Int and argument_type.name == "i64")) if expected == "text|i64"
            return (literal_kind == "string" or argument_type.kind == SemTypeKind.String or (argument_type.kind == SemTypeKind.Float and argument_type.name == "f64")) if expected == "text|f64"
            return (literal_kind == "int" or literal_kind == "float" or argument_type.kind == SemTypeKind.Int or argument_type.kind == SemTypeKind.Float) if expected == "i64|f64"
            return (literal_kind == "bool" or argument_type.kind == SemTypeKind.Bool) if expected == "bool"
            return (literal_kind == "char" or argument_type.kind == SemTypeKind.Char) if expected == "char"
            return (argument_type.kind == SemTypeKind.Container and (argument_type.name == "darray" or argument_type.name == "array")) or argument_type.kind == SemTypeKind.Tuple if expected == "array"
            return argument_type.kind == SemTypeKind.Named and argument_type.name == "Regex" if expected == "Regex"
            return argument_type.kind == SemTypeKind.Named and argument_type.name == "Path" if expected == "Path"
            return argument_type.kind == SemTypeKind.Named and argument_type.name == "Glob" if expected == "Glob"
            return argument_type.kind == SemTypeKind.Named and argument_type.name == "Executable" if expected == "Executable"
            return argument_type.kind == SemTypeKind.Named and argument_type.name == "ProcessCapture" if expected == "ProcessCapture"
            return ufm_dictionary_argument_is_text_text(expression, var_types, type_names, table) if expected == "dict[sview,sview]"
            return (argument_type.kind == SemTypeKind.Container or argument_type.kind == SemTypeKind.String) if expected == "collection"
            return (argument_type.kind == SemTypeKind.Container or argument_type.kind == SemTypeKind.String or (argument_type.kind == SemTypeKind.Named and argument_type.name == "Path")) if expected == "collection_path"
            return ufm_text_array_argument_is_text(expression, var_types, type_names, table) if expected == "darray[text]"
            return ufm_byte_array_argument_is_u8(expression, var_types, type_names, table) if expected == "darray[u8]"
            return ufm_executable_array_argument_is_executable(expression, var_types, type_names, table) if expected == "darray[Executable]"
            return ufm_nested_text_array_argument_is_text(expression, var_types, type_names, table) if expected == "darray[darray[text]]"
            return false

        def ufm_check_global_builtin_arity(name: sview, spec: EsBuiltin::BuiltinSpec, argument_count: usize, argument_names: darray[sview]&, call_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                actual: u32 = argument_count.u32()
                mismatch: bool = actual < spec.arity_min or actual > spec.arity_max
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: name, pos: call_line, line: call_line.line, expected: "n", actual: "", expected_count: spec.arity_min, actual_count: actual}) if mismatch and spec.arity_min == spec.arity_max
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: name, pos: call_line, line: call_line.line, expected: "", actual: ""}) if mismatch and spec.arity_min != spec.arity_max
                while argument_index < argument_names.count |argument_index: usize = 0|:
                    named_allowed: bool = argument_names[argument_index] == "" or (spec.argument_names != "" and argument_index.u32() == spec.named_argument_index and argument_names[argument_index] == spec.argument_names)
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CallArgumentError, name: name, pos: call_line, line: call_line.line, expected: "no_names", actual: ""}) if not named_allowed
                    argument_index <- argument_index + 1

        def ufm_check_global_builtin_argument_types(name: sview, spec: EsBuiltin::BuiltinSpec, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, var_types: darray[sview]&, type_names: darray[sview]&, call_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                while argument_index < arguments.count |argument_index: usize = 0|:
                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    expected: mutable sview = ufm_global_argument_expected(spec, argument_index)
                    expected <- "text" if spec.argument_types == "print" and (argument_name == "sep" or argument_name == "end")
                    expected <- "bool" if spec.argument_types == "print" and argument_name == "flush"
                    literal_kind: sview = literal_kind_of(arguments[argument_index])
                    argument_type: InferType = infer_expression_type(arguments[argument_index], var_types, type_names, table)
                    argument_family: sview = stage0_value_spelling(argument_type)
                    fits: bool = ufm_global_argument_fits(expected, literal_kind, argument_type, arguments[argument_index], var_types, type_names, table)
                    literal_bad: bool = expected != "" and expected != "any" and literal_kind != "" and not fits
                    structural_expected: bool = expected == "darray[text]" or expected == "darray[u8]" or expected == "dict[sview,sview]" or expected == "darray[Executable]" or expected == "darray[darray[text]]"
                    structural_known: bool = structural_expected and structural_type_id_of(arguments[argument_index], var_types, type_names, table) != 0
                    firm_bad: bool = expected != "" and expected != "any" and literal_kind == "" and argument_type.kind != SemTypeKind.Unknown and (not structural_expected or structural_known) and not fits
                    named_type_checked: bool = argument_name == "" or (spec.argument_types == "print" and expected != "")
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LiteralArgTypeMismatch, name: name, pos: call_line, line: call_line.line, expected: expected, actual: stage0_literal_spelling(literal_kind), expected_count: (argument_index + 1).u32()}) if literal_bad and named_type_checked
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: name, pos: call_line, line: call_line.line, expected: expected, actual: argument_family, expected_count: (argument_index + 1).u32()}) if firm_bad and named_type_checked
                    argument_index <- argument_index + 1

        def ufm_check_expression(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Field(receiver, method, method_line):
                                receiver_type: InferType = infer_expression_type(receiver, var_types, type_names, table)
                                # A source-level UFCS function owns the spelling before a
                                # registry builtin does.  Keep the builtin diagnostics
                                # behind the same direct-function shadowing guard used by
                                # unknown-method admission; otherwise a user-defined
                                # `contains`/`split` would inherit Text's arity and labels.
                                source_ufcs_owned: bool = ufm_has_source_function(table, method)
                                source_ufcs_available: bool = scripting_has_unique_source_function(table, method)
                                table <- check_source_ufcs_arity(table, method, arguments.count + 1, call_line.line) if source_ufcs_available
                                table <- check_source_ufcs_named_arguments(table, method, argument_names, call_line.line) if source_ufcs_available and argument_names.count > 0
                                text_builtin_available: bool = receiver_type.kind == SemTypeKind.String and not source_ufcs_owned and EsBuiltin::typed_builtin_method_spec("Text", method).known
                                table <- ufm_check_text_builtin_arity(method, arguments.count, argument_names, method_line, table) if text_builtin_available
                                table <- ufm_check_text_builtin_argument_types(method, arguments, argument_names, var_types, type_names, method_line, table) if text_builtin_available
                                regex_builtin_available: bool = receiver_type.kind == SemTypeKind.Named and receiver_type.name == "Regex" and not source_ufcs_owned and EsBuiltin::typed_builtin_method_spec("Regex", method).known
                                table <- ufm_check_regex_builtin_arity(method, arguments.count, argument_names, method_line, table) if regex_builtin_available
                                table <- ufm_check_regex_builtin_argument_types(method, arguments, argument_names, var_types, type_names, method_line, table) if regex_builtin_available
                                path_builtin_available: bool = receiver_type.kind == SemTypeKind.Named and receiver_type.name == "Path" and not source_ufcs_owned and EsBuiltin::typed_builtin_method_spec("Path", method).known
                                table <- ufm_check_path_builtin_arity(method, arguments.count, argument_names, method_line, table) if path_builtin_available
                                table <- ufm_check_path_builtin_argument_types(method, arguments, argument_names, var_types, type_names, method_line, table) if path_builtin_available
                                map_builtin_available: bool = receiver_type.kind == SemTypeKind.Container and receiver_type.name == "dict" and not source_ufcs_owned and EsBuiltin::typed_builtin_method_spec("Map", method).known
                                table <- ufm_check_map_builtin_arity(method, arguments.count, argument_names, method_line, table) if map_builtin_available
                                array_builtin_available: bool = receiver_type.kind == SemTypeKind.Container and (receiver_type.name == "darray" or receiver_type.name == "array") and not source_ufcs_owned and EsBuiltin::typed_builtin_method_spec("Array", method).known
                                table <- ufm_check_array_builtin_arity(method, arguments.count, argument_names, method_line, table) if array_builtin_available
                                set_builtin_available: bool = receiver_type.kind == SemTypeKind.Container and receiver_type.name == "set" and not source_ufcs_owned and EsBuiltin::typed_builtin_method_spec("Set", method).known
                                table <- ufm_check_set_builtin_arity(method, arguments.count, argument_names, method_line, table) if set_builtin_available
                                struct_name: sview = receiver_type.name
                                unknown: bool = receiver_type.kind == SemTypeKind.Named and struct_is_registered(table, struct_name) and not struct_has_field(table, struct_name, method) and direct_function_count(table, method) == 0 and not ufm_is_default_method(annotations, method) and not ufm_is_elisascript_builtin_method(method)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownFieldAccess, name: method, pos: method_line, line: method_line.line, expected: struct_name, actual: ""}) if unknown
                                table <- ufm_check_expression(receiver, annotations, var_types, type_names, table)
                            Expr.Ident(function_name, function_line):
                                global_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_spec(function_name)
                                global_builtin_available: bool = global_spec.known and not ufm_has_source_function(table, function_name)
                                table <- ufm_check_global_builtin_arity(function_name, global_spec, arguments.count, argument_names, function_line, table) if global_builtin_available
                                table <- ufm_check_global_builtin_argument_types(function_name, global_spec, arguments, argument_names, var_types, type_names, function_line, table) if global_builtin_available
                            Expr.Scope(scope_base, scope_member, scope_line):
                                script_module: mutable bool = false
                                match scope_base:
                                    Expr.Ident(scope_module_name, scope_module_line):
                                        script_module <- scope_module_name == "Script"
                                        if script_module:
                                            module_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_module_spec(scope_module_name, scope_member)
                                            module_builtin_available: bool = module_spec.known and name_is_unshadowed_builtin_module(table, var_types, scope_module_name)
                                            # Qualified calls deliberately bypass
                                            # direct-call arity analysis; check
                                            # the exact module member here while
                                            # keeping source/imported Script
                                            # modules ahead of this intrinsic.
                                            table <- ufm_check_global_builtin_arity(scope_member, module_spec, arguments.count, argument_names, call_line, table) if module_builtin_available
                                            table <- ufm_check_global_builtin_argument_types(scope_member, module_spec, arguments, argument_names, var_types, type_names, call_line, table) if module_builtin_available
                                    _:
                                        pass
                                table <- ufm_check_expression(callee, annotations, var_types, type_names, table) if not script_module
                            _:
                                table <- ufm_check_expression(callee, annotations, var_types, type_names, table)
                        for argument in arguments |table, var_types, type_names| -> table:
                            table <- ufm_check_expression(argument, annotations, var_types, type_names, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- ufm_check_expression(left, annotations, var_types, type_names, table)
                        table <- ufm_check_expression(right, annotations, var_types, type_names, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- ufm_check_expression(operand, annotations, var_types, type_names, table)
                    Expr.Paren(inner, paren_line):
                        table <- ufm_check_expression(inner, annotations, var_types, type_names, table)
                    Expr.Field(object, field, field_line) | Expr.Scope(object, field, scope_line):
                        table <- ufm_check_expression(object, annotations, var_types, type_names, table)
                    Expr.Index(object, index, index_line):
                        table <- ufm_check_expression(object, annotations, var_types, type_names, table)
                        table <- ufm_check_expression(index, annotations, var_types, type_names, table)
                    Expr.IndexN(object, arguments, index_n_line):
                        table <- ufm_check_expression(object, annotations, var_types, type_names, table)
                        for argument in arguments |table, var_types, type_names| -> table:
                            table <- ufm_check_expression(argument, annotations, var_types, type_names, table)
                    Expr.Slice(object, low, high, slice_line):
                        table <- ufm_check_expression(object, annotations, var_types, type_names, table)
                        table <- ufm_check_expression(low, annotations, var_types, type_names, table)
                        table <- ufm_check_expression(high, annotations, var_types, type_names, table)
                    Expr.Move(operand, move_line):
                        table <- ufm_check_expression(operand, annotations, var_types, type_names, table)
                    Expr.Array(elements, array_line) | Expr.Tuple(elements, tuple_line) | Expr.SetLit(elements, set_line):
                        for element in elements |table, var_types, type_names| -> table:
                            table <- ufm_check_expression(element, annotations, var_types, type_names, table)
                    Expr.DictLit(entries, dict_line):
                        for entry in entries |table, var_types, type_names| -> table:
                            table <- ufm_check_expression(entry.key, annotations, var_types, type_names, table)
                            table <- ufm_check_expression(entry.value, annotations, var_types, type_names, table)
                    Expr.Construct(type_expression, fields, construct_line):
                        table <- ufm_check_expression(type_expression, annotations, var_types, type_names, table)
                        for field in fields |table, var_types, type_names| -> table:
                            table <- ufm_check_expression(field.value, annotations, var_types, type_names, table)
                    Expr.RecordUpdate(base, fields, update_line):
                        table <- ufm_check_expression(base, annotations, var_types, type_names, table)
                        for field in fields |table, var_types, type_names| -> table:
                            table <- ufm_check_expression(field.value, annotations, var_types, type_names, table)
                    Expr.If(condition, then_expr, else_expr, if_line):
                        table <- ufm_check_expression(condition, annotations, var_types, type_names, table)
                        table <- ufm_check_expression(then_expr, annotations, var_types, type_names, table)
                        table <- ufm_check_expression(else_expr, annotations, var_types, type_names, table)
                    Expr.Refinement(base, predicate, refinement_line):
                        table <- ufm_check_expression(base, annotations, var_types, type_names, table)
                        table <- ufm_check_expression(predicate, annotations, var_types, type_names, table)
                    Expr.GetElse(guarded, recovery, get_line):
                        table <- ufm_check_expression(guarded, annotations, var_types, type_names, table)
                        table <- ufm_check_statements(recovery, annotations, var_types, type_names, table)
                    Expr.Comprehension(loop_variable, iterable, condition, body, comprehension_line):
                        table <- ufm_check_expression(iterable, annotations, var_types, type_names, table)
                        table <- ufm_check_expression(condition, annotations, var_types, type_names, table)
                        table <- ufm_check_expression(body, annotations, var_types, type_names, table)
                    Expr.Lambda(parameters, body, lambda_line):
                        table <- ufm_check_statements(body, annotations, var_types, type_names, table)
                    Expr.Block(statements, value, captures, block_line):
                        table <- ufm_check_statements(statements, annotations, var_types, type_names, table)
                        table <- ufm_check_expression(value, annotations, var_types, type_names, table)
                    Expr.Match(scrutinee, arms, match_line) | Expr.Catch(scrutinee, arms, match_line):
                        table <- ufm_check_expression(scrutinee, annotations, var_types, type_names, table)
                        for arm in arms |table, var_types, type_names| -> table:
                            table <- ufm_check_expression(arm.guard, annotations, var_types, type_names, table)
                            table <- ufm_check_statements(arm.body, annotations, var_types, type_names, table)
                    _:
                        pass

        def ufm_check_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, var_types, type_names| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- ufm_check_expression(returned, annotations, var_types, type_names, table)
                        Stmt.Expr(expression, line):
                            table <- ufm_check_expression(expression, annotations, var_types, type_names, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            note_local_type(var_types, type_names, name, bare_type_name(type_expression))
                            table <- ufm_check_expression(value, annotations, var_types, type_names, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- ufm_check_expression(target, annotations, var_types, type_names, table)
                            table <- ufm_check_expression(value, annotations, var_types, type_names, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- ufm_check_expression(condition, annotations, var_types, type_names, table)
                            table <- ufm_check_statements(then_body, annotations, var_types, type_names, table)
                            table <- ufm_check_statements(else_body, annotations, var_types, type_names, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- ufm_check_expression(condition, annotations, var_types, type_names, table)
                            table <- ufm_check_statements(while_body, annotations, var_types, type_names, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- ufm_check_expression(iterable, annotations, var_types, type_names, table)
                            table <- ufm_check_statements(for_body, annotations, var_types, type_names, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- ufm_check_statements(body, annotations, var_types, type_names, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            table <- ufm_check_expression(scrutinee, annotations, var_types, type_names, table)
                            for arm in arms |table, var_types, type_names| -> table:
                                table <- ufm_check_expression(arm.guard, annotations, var_types, type_names, table)
                                table <- ufm_check_statements(arm.body, annotations, var_types, type_names, table)
                        Stmt.Contract(kind, expression, line):
                            table <- ufm_check_expression(expression, annotations, var_types, type_names, table)
                        _:
                            pass

        def ufm_check_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            for parameter in parameters |var_types, type_names|:
                                note_local_type(var_types, type_names, parameter.name, bare_type_name(parameter.type_expression))
                            table <- ufm_check_statements(body, annotations, var_types, type_names, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- ufm_check_declarations(module_body, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- ufm_check_declarations(scoped_body, annotations, table)
                        _:
                            pass

    public:
        def check_ufcs_unknown_method(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- ufm_check_declarations(file.top_decls, file.enum_annotations, table)
