# UFCS method call to a non-existent method. `recv.method(args)` on a value of known struct
# type resolves to a field, a free UFCS function, or a conformed protocol method. When none
# exist it is an unknown access:
#
#   struct Bare: y: i64
#   protocol Eq: def eq(self: Self, other: Self) -> bool
#   def same(a: Bare, b: Bare) -> bool: return a.eq(b)   # error: Bare has no field "eq"
#
# SOUND subset: fire only when the receiver's struct has NO such field, NO free function of
# that name (an impl method registers a Func, so a conforming call is safe), AND the method is
# NOT a protocol DEFAULT method (a default is callable on any conformer without an impl —
# recorded by the parser at sentinel line 3900000062).
extend Semantic:
    private:
        def ufm_is_default_method(annotations: darray[Ast::EnumAnnotation]&, method: sview) -> bool:
            can Abort.Panic:
                return any annotation in annotations where annotation.line == 3900000062 and annotation.name == method

        # Elisascript adds these typed text/collection operations in its lowerer
        # rather than as ordinary source-level UFCS functions. Text rows come
        # from the shared registry so semantic admission cannot drift from
        # receiver-aware lowering; the remaining collection/path rows stay in
        # this compatibility list until their structural descriptors migrate.
        def ufm_is_elisascript_builtin_method(method: sview) -> bool:
            return EsBuiltin::typed_builtin_method_spec("Text", method).known or EsBuiltin::typed_builtin_method_spec("Regex", method).known or method == "split" or method == "keys" or method == "values" or method == "contains" or method == "count" or method == "find" or method == "index" or method == "rfind" or method == "rindex" or method == "partition" or method == "rpartition" or method == "copy" or method == "reverse" or method == "setdefault" or method == "joinpath" or method == "exists" or method == "is_file" or method == "is_symlink" or method == "readlink" or method == "read_link" or method == "symlink_to" or method == "is_dir"

        def ufm_has_source_function(table: SymbolTable&, method: sview) -> bool:
            can Abort.Panic:
                for symbol in table.symbols:
                    return true if symbol.kind == SymbolKind.Func and symbol.name == method and symbol.line != 0
                return false

        # Registry-backed Text methods are lowered as builtins rather than source-level
        # UFCS functions, so direct-call arity checking cannot see their receiver-excluded
        # parameter range. Keep that contract at the semantic boundary: only a firmly known
        # string receiver is checked, while Unknown/container/Named receivers continue through
        # ordinary UFCS resolution without speculative diagnostics.
        def ufm_text_named_argument_allowed(spec: EsBuiltin::BuiltinSpec, index: usize, argument_name: sview) -> bool:
            return true if argument_name == ""
            return spec.argument_names == "maxsplit" and index.u32() == spec.named_argument_index and argument_name == "maxsplit"

        def ufm_text_has_invalid_named_arguments(spec: EsBuiltin::BuiltinSpec, argument_names: darray[sview]&) -> bool:
            while argument_index < argument_names.count |argument_index: usize = 0|:
                return true if not ufm_text_named_argument_allowed(spec, argument_index, argument_names[argument_index])
                argument_index <- argument_index + 1
            return false

        def ufm_check_text_builtin_arity(method: sview, argument_count: usize, argument_names: darray[sview]&, method_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method)
                actual: u32 = argument_count.u32()
                mismatch: bool = spec.known and (actual < spec.arity_min or actual > spec.arity_max)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "n", actual: "", expected_count: spec.arity_min, actual_count: actual}) if mismatch and spec.arity_min == spec.arity_max
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "", actual: ""}) if mismatch and spec.arity_min != spec.arity_max
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CallArgumentError, name: method, pos: method_line, line: method_line.line, expected: "no_names", actual: ""}) if spec.known and ufm_text_has_invalid_named_arguments(spec, argument_names)

        # The first registry rows with positional text arguments use the compact
        # `text`/`text,text` descriptor. `join` additionally has a structural
        # `darray[text]` argument; validate it when the existing interned type table
        # gives us a firm container element ID, while keeping unknown expressions
        # conservative.
        def ufm_text_array_argument_is_text(expression: Ast::Expr, var_types: darray[sview]&, type_names: darray[sview]&, table: SymbolTable&) -> bool:
            can Memory.Allocate, Abort.Panic:
                argument_id: u32 = structural_type_id_of(expression, var_types, type_names, table)
                return false if argument_id == 0 or interned_kind(argument_id, table) != SemTypeKind.Container
                head: sview = interned_name(argument_id, table)
                return false if head != "darray" and head != "array"
                return false if interned_elem_count(argument_id, table) != 1
                element_id: u32 = interned_elem(argument_id, 0, table)
                return interned_kind(element_id, table) == SemTypeKind.String

        def ufm_text_array_argument_is_known(expression: Ast::Expr, var_types: darray[sview]&, type_names: darray[sview]&, table: SymbolTable&) -> bool:
            return structural_type_id_of(expression, var_types, type_names, table) != 0

        def ufm_check_text_builtin_argument_types(method: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, var_types: darray[sview]&, type_names: darray[sview]&, method_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method)
                argument_index: mutable usize = 0
                while argument_index < arguments.count:
                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    named_allowed: bool = ufm_text_named_argument_allowed(spec, argument_index, argument_name)
                    expected_text: bool = (spec.argument_types == "text" and argument_index == 0) or (spec.argument_types == "text,text" and argument_index < 2) or (spec.argument_types == "text,i64" and argument_index == 0)
                    expected_integer: bool = spec.argument_types == "text,i64" and argument_index == 1
                    expected_array_text: bool = spec.argument_types == "darray[text]" and argument_index == 0
                    expected_type: sview = "text" if expected_text else ("i64" if expected_integer else ("darray[text]" if expected_array_text else ""))
                    literal_kind: sview = literal_kind_of(arguments[argument_index])
                    argument_type: InferType = infer_expression_type(arguments[argument_index], var_types, type_names, table)
                    argument_family: sview = stage0_value_spelling(argument_type)
                    literal_fits: bool = (expected_text and literal_kind == "string") or (expected_integer and literal_kind == "int")
                    firm_fits: bool = (expected_text and argument_type.kind == SemTypeKind.String) or (expected_integer and argument_type.kind == SemTypeKind.Int)
                    structural_known: bool = expected_array_text and ufm_text_array_argument_is_known(arguments[argument_index], var_types, type_names, table)
                    structural_fits: bool = expected_array_text and ufm_text_array_argument_is_text(arguments[argument_index], var_types, type_names, table)
                    literal_bad: bool = expected_type != "" and named_allowed and literal_kind != "" and not literal_fits
                    firm_scalar_bad: bool = (expected_text or expected_integer) and argument_type.kind != SemTypeKind.Unknown and not firm_fits
                    firm_bad: bool = expected_type != "" and named_allowed and literal_kind == "" and (firm_scalar_bad or (structural_known and not structural_fits))
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LiteralArgTypeMismatch, name: method, pos: method_line, line: method_line.line, expected: expected_type, actual: stage0_literal_spelling(literal_kind), expected_count: (argument_index + 1).u32()}) if literal_bad
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: method, pos: method_line, line: method_line.line, expected: expected_type, actual: argument_family, expected_count: (argument_index + 1).u32()}) if firm_bad
                    argument_index <- argument_index + 1

        # Regex receiver rows currently accept only positional text values. Keep
        # this checker deliberately narrow: unknown expressions remain unknown,
        # while literals and firmly inferred scalar values receive precise
        # diagnostics before lowering.
        def ufm_check_regex_builtin_arity(method: sview, argument_count: usize, argument_names: darray[sview]&, method_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Regex", method)
                actual: u32 = argument_count.u32()
                mismatch: bool = spec.known and (actual < spec.arity_min or actual > spec.arity_max)
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "n", actual: "", expected_count: spec.arity_min, actual_count: actual}) if mismatch and spec.arity_min == spec.arity_max
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: method, pos: method_line, line: method_line.line, expected: "", actual: ""}) if mismatch and spec.arity_min != spec.arity_max
                while argument_index < argument_names.count |argument_index: usize = 0|:
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CallArgumentError, name: method, pos: method_line, line: method_line.line, expected: "no_names", actual: ""}) if argument_names[argument_index] != ""
                    argument_index <- argument_index + 1

        def ufm_check_regex_builtin_argument_types(method: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, var_types: darray[sview]&, type_names: darray[sview]&, method_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Regex", method)
                while argument_index < arguments.count |argument_index: usize = 0|:
                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    expected_text: bool = (spec.argument_types == "text" and argument_index == 0) or (spec.argument_types == "text,text" and argument_index < 2)
                    expected_type: sview = "text" if expected_text else ""
                    literal_kind: sview = literal_kind_of(arguments[argument_index])
                    argument_type: InferType = infer_expression_type(arguments[argument_index], var_types, type_names, table)
                    argument_family: sview = stage0_value_spelling(argument_type)
                    literal_fits: bool = expected_text and literal_kind == "string"
                    firm_fits: bool = expected_text and argument_type.kind == SemTypeKind.String
                    literal_bad: bool = expected_type != "" and argument_name == "" and literal_kind != "" and not literal_fits
                    firm_bad: bool = expected_type != "" and argument_name == "" and literal_kind == "" and argument_type.kind != SemTypeKind.Unknown and not firm_fits
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LiteralArgTypeMismatch, name: method, pos: method_line, line: method_line.line, expected: expected_type, actual: stage0_literal_spelling(literal_kind), expected_count: (argument_index + 1).u32()}) if literal_bad
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: method, pos: method_line, line: method_line.line, expected: expected_type, actual: argument_family, expected_count: (argument_index + 1).u32()}) if firm_bad
                    argument_index <- argument_index + 1

        def ufm_global_argument_expected(spec: EsBuiltin::BuiltinSpec, index: usize) -> sview:
            return "collection" if spec.argument_types == "collection|text" and index == 0
            return "collection_path" if spec.argument_types == "collection|text|Path" and index == 0
            return "collection" if spec.argument_types == "collection,any" and index == 0
            return "any" if spec.argument_types == "collection,any" and index == 1
            return "text" if spec.argument_types == "text" and index == 0
            return "text" if spec.argument_types == "text,text" and index < 2
            return "text" if spec.argument_types == "text,text,text" and index < 3
            return "text" if spec.argument_types == "text,text,i64" and index < 2
            return "i64" if spec.argument_types == "text,text,i64" and index == 2
            return "darray[text]" if spec.argument_types == "darray[text],text" and index == 0
            return "text" if spec.argument_types == "darray[text],text" and index == 1
            return "text" if spec.argument_types == "text,Regex" and index == 0
            return "Regex" if spec.argument_types == "text,Regex" and index == 1
            return "text" if spec.argument_types == "text,Regex,text" and (index == 0 or index == 2)
            return "Regex" if spec.argument_types == "text,Regex,text" and index == 1
            return "i64" if spec.argument_types == "i64" and index == 0
            return "f64" if spec.argument_types == "f64" and index == 0
            return "bool" if spec.argument_types == "bool" and index == 0
            return "char" if spec.argument_types == "char" and index == 0
            return "any" if spec.argument_types == "any" and index == 0
            return ""

        def ufm_global_argument_fits(expected: sview, literal_kind: sview, argument_type: InferType, expression: Ast::Expr, var_types: darray[sview]&, type_names: darray[sview]&, table: SymbolTable&) -> bool:
            return true if expected == "any"
            return (literal_kind == "string" or argument_type.kind == SemTypeKind.String) if expected == "text"
            return (literal_kind == "int" or argument_type.kind == SemTypeKind.Int) if expected == "i64"
            return (literal_kind == "float" or argument_type.kind == SemTypeKind.Float) if expected == "f64"
            return (literal_kind == "bool" or argument_type.kind == SemTypeKind.Bool) if expected == "bool"
            return (literal_kind == "char" or argument_type.kind == SemTypeKind.Char) if expected == "char"
            return argument_type.kind == SemTypeKind.Named and argument_type.name == "Regex" if expected == "Regex"
            return (argument_type.kind == SemTypeKind.Container or argument_type.kind == SemTypeKind.String) if expected == "collection"
            return (argument_type.kind == SemTypeKind.Container or argument_type.kind == SemTypeKind.String or (argument_type.kind == SemTypeKind.Named and argument_type.name == "Path")) if expected == "collection_path"
            return ufm_text_array_argument_is_text(expression, var_types, type_names, table) if expected == "darray[text]"
            return false

        def ufm_check_global_builtin_arity(name: sview, spec: EsBuiltin::BuiltinSpec, argument_count: usize, argument_names: darray[sview]&, call_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                actual: u32 = argument_count.u32()
                mismatch: bool = actual < spec.arity_min or actual > spec.arity_max
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: name, pos: call_line, line: call_line.line, expected: "n", actual: "", expected_count: spec.arity_min, actual_count: actual}) if mismatch and spec.arity_min == spec.arity_max
                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.ArityMismatch, name: name, pos: call_line, line: call_line.line, expected: "", actual: ""}) if mismatch and spec.arity_min != spec.arity_max
                while argument_index < argument_names.count |argument_index: usize = 0|:
                    named_allowed: bool = argument_names[argument_index] == "" or (spec.argument_names == "maxsplit" and argument_index.u32() == spec.named_argument_index and argument_names[argument_index] == "maxsplit")
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.CallArgumentError, name: name, pos: call_line, line: call_line.line, expected: "no_names", actual: ""}) if not named_allowed
                    argument_index <- argument_index + 1

        def ufm_check_global_builtin_argument_types(name: sview, spec: EsBuiltin::BuiltinSpec, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, var_types: darray[sview]&, type_names: darray[sview]&, call_line: Ast::Pos, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                while argument_index < arguments.count |argument_index: usize = 0|:
                    expected: sview = ufm_global_argument_expected(spec, argument_index)
                    argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                    literal_kind: sview = literal_kind_of(arguments[argument_index])
                    argument_type: InferType = infer_expression_type(arguments[argument_index], var_types, type_names, table)
                    argument_family: sview = stage0_value_spelling(argument_type)
                    fits: bool = ufm_global_argument_fits(expected, literal_kind, argument_type, arguments[argument_index], var_types, type_names, table)
                    literal_bad: bool = expected != "" and expected != "any" and literal_kind != "" and not fits
                    firm_bad: bool = expected != "" and expected != "any" and literal_kind == "" and argument_type.kind != SemTypeKind.Unknown and not fits
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.LiteralArgTypeMismatch, name: name, pos: call_line, line: call_line.line, expected: expected, actual: stage0_literal_spelling(literal_kind), expected_count: (argument_index + 1).u32()}) if literal_bad and argument_name == ""
                    table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.FirmArgTypeMismatch, name: name, pos: call_line, line: call_line.line, expected: expected, actual: argument_family, expected_count: (argument_index + 1).u32()}) if firm_bad and argument_name == ""
                    argument_index <- argument_index + 1

        def ufm_check_expression(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, call_line):
                        match callee:
                            Expr.Field(receiver, method, method_line):
                                receiver_type: InferType = infer_expression_type(receiver, var_types, type_names, table)
                                # A source-level UFCS function owns the spelling before a
                                # registry builtin does.  Keep the builtin diagnostics
                                # behind the same direct-function shadowing guard used by
                                # unknown-method admission; otherwise a user-defined
                                # `contains`/`split` would inherit Text's arity and labels.
                                text_builtin_available: bool = receiver_type.kind == SemTypeKind.String and not ufm_has_source_function(table, method) and EsBuiltin::typed_builtin_method_spec("Text", method).known
                                ufm_check_text_builtin_arity(method, arguments.count, argument_names, method_line, table) if text_builtin_available
                                ufm_check_text_builtin_argument_types(method, arguments, argument_names, var_types, type_names, method_line, table) if text_builtin_available
                                regex_builtin_available: bool = receiver_type.kind == SemTypeKind.Named and receiver_type.name == "Regex" and not ufm_has_source_function(table, method) and EsBuiltin::typed_builtin_method_spec("Regex", method).known
                                ufm_check_regex_builtin_arity(method, arguments.count, argument_names, method_line, table) if regex_builtin_available
                                ufm_check_regex_builtin_argument_types(method, arguments, argument_names, var_types, type_names, method_line, table) if regex_builtin_available
                                struct_name: sview = receiver_type.name
                                unknown: bool = receiver_type.kind == SemTypeKind.Named and struct_is_registered(table, struct_name) and not struct_has_field(table, struct_name, method) and direct_function_count(table, method) == 0 and not ufm_is_default_method(annotations, method) and not ufm_is_elisascript_builtin_method(method)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.UnknownFieldAccess, name: method, pos: method_line, line: method_line.line, expected: struct_name, actual: ""}) if unknown
                                table <- ufm_check_expression(receiver, annotations, var_types, type_names, table)
                            Expr.Ident(function_name, function_line):
                                global_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_spec(function_name)
                                global_builtin_available: bool = global_spec.known and not ufm_has_source_function(table, function_name)
                                ufm_check_global_builtin_arity(function_name, global_spec, arguments.count, argument_names, function_line, table) if global_builtin_available
                                ufm_check_global_builtin_argument_types(function_name, global_spec, arguments, argument_names, var_types, type_names, function_line, table) if global_builtin_available
                            _:
                                table <- ufm_check_expression(callee, annotations, var_types, type_names, table)
                        for argument in arguments |table, var_types, type_names| -> table:
                            table <- ufm_check_expression(argument, annotations, var_types, type_names, table)
                    Expr.Binary(left, operator, right, binary_line):
                        table <- ufm_check_expression(left, annotations, var_types, type_names, table)
                        table <- ufm_check_expression(right, annotations, var_types, type_names, table)
                    Expr.Unary(operator, operand, unary_line):
                        table <- ufm_check_expression(operand, annotations, var_types, type_names, table)
                    Expr.Paren(inner, paren_line):
                        table <- ufm_check_expression(inner, annotations, var_types, type_names, table)
                    _:
                        pass

        def ufm_check_statements(statements: darray[Ast::Stmt], annotations: darray[Ast::EnumAnnotation]&, var_types: mutable darray[sview]&, type_names: mutable darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table, var_types, type_names| -> table:
                    match statement:
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- ufm_check_expression(returned, annotations, var_types, type_names, table)
                        Stmt.Expr(expression, line):
                            table <- ufm_check_expression(expression, annotations, var_types, type_names, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- ufm_check_expression(value, annotations, var_types, type_names, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- ufm_check_expression(value, annotations, var_types, type_names, table)
                        Stmt.If(condition, then_body, else_body, if_line):
                            table <- ufm_check_expression(condition, annotations, var_types, type_names, table)
                            table <- ufm_check_statements(then_body, annotations, var_types, type_names, table)
                            table <- ufm_check_statements(else_body, annotations, var_types, type_names, table)
                        Stmt.While(condition, while_body, while_line):
                            table <- ufm_check_expression(condition, annotations, var_types, type_names, table)
                            table <- ufm_check_statements(while_body, annotations, var_types, type_names, table)
                        Stmt.For(bind, variables, iterable, for_body, for_line):
                            table <- ufm_check_statements(for_body, annotations, var_types, type_names, table)
                        Stmt.Block(kind, clause, binding, body, block_line):
                            table <- ufm_check_statements(body, annotations, var_types, type_names, table)
                        Stmt.Match(scrutinee, arms, match_line):
                            for arm in arms |table, var_types, type_names| -> table:
                                table <- ufm_check_statements(arm.body, annotations, var_types, type_names, table)
                        _:
                            pass

        def ufm_check_declarations(declarations: darray[Ast::Decl], annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            var_types: mutable darray[sview] = []
                            type_names: mutable darray[sview] = []
                            for parameter in parameters |var_types, type_names|:
                                note_local_type(var_types, type_names, parameter.name, bare_type_name(parameter.type_expression))
                            table <- ufm_check_statements(body, annotations, var_types, type_names, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- ufm_check_declarations(module_body, annotations, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- ufm_check_declarations(scoped_body, annotations, table)
                        _:
                            pass

    public:
        def check_ufcs_unknown_method(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                table <- ufm_check_declarations(file.top_decls, file.enum_annotations, table)
