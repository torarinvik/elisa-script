# Shared Elisascript builtin registry.
#
# This first registry slice deliberately covers only strict scalar/text builtins
# whose signatures fit the existing Symbol return-type fields and IR Type model.
# Aggregate, variadic, receiver-polymorphic, and generic builtins remain in the
# migration queue until their structural descriptors are available.

module EsBuiltin:
    public:
        struct BuiltinSpec:
            known: bool
            name: sview
            receiver: sview
            arity_min: u32
            arity_max: u32
            return_type: sview
            effects: sview
            errors: sview
            opcode: sview


        def unknown_builtin_spec() -> BuiltinSpec:
            return BuiltinSpec{known: false, name: "", receiver: "", arity_min: 0, arity_max: 0, return_type: "", effects: "", errors: "", opcode: ""}


        # One spelling is one registry identity. Aliases have their own rows so
        # semantic diagnostics and future deprecation metadata can distinguish
        # canonical names from compatibility spellings.
        def typed_builtin_spec(name: sview) -> BuiltinSpec:
            return BuiltinSpec{known: true, name: "len", receiver: "global", arity_min: 1, arity_max: 1, return_type: "usize", effects: "", errors: "", opcode: "Length"} if name == "len"
            return BuiltinSpec{known: true, name: "contains", receiver: "global", arity_min: 2, arity_max: 2, return_type: "bool", effects: "", errors: "", opcode: "Contains"} if name == "contains"
            return BuiltinSpec{known: true, name: "is_empty", receiver: "global", arity_min: 1, arity_max: 1, return_type: "bool", effects: "", errors: "", opcode: "Equal"} if name == "is_empty"
            return BuiltinSpec{known: true, name: "isempty", receiver: "global", arity_min: 1, arity_max: 1, return_type: "bool", effects: "", errors: "", opcode: "Equal"} if name == "isempty"
            return BuiltinSpec{known: true, name: "is_nonempty", receiver: "global", arity_min: 1, arity_max: 1, return_type: "bool", effects: "", errors: "", opcode: "Not"} if name == "is_nonempty"
            return BuiltinSpec{known: true, name: "nonempty", receiver: "global", arity_min: 1, arity_max: 1, return_type: "bool", effects: "", errors: "", opcode: "Not"} if name == "nonempty"
            return BuiltinSpec{known: true, name: "str", receiver: "global", arity_min: 1, arity_max: 1, return_type: "sview", effects: "", errors: "", opcode: "FormatNominal"} if name == "str"
            return BuiltinSpec{known: true, name: "starts_with", receiver: "global", arity_min: 2, arity_max: 2, return_type: "bool", effects: "", errors: "", opcode: "StartsWith"} if name == "starts_with"
            return BuiltinSpec{known: true, name: "startswith", receiver: "global", arity_min: 2, arity_max: 2, return_type: "bool", effects: "", errors: "", opcode: "StartsWith"} if name == "startswith"
            return BuiltinSpec{known: true, name: "ends_with", receiver: "global", arity_min: 2, arity_max: 2, return_type: "bool", effects: "", errors: "", opcode: "EndsWith"} if name == "ends_with"
            return BuiltinSpec{known: true, name: "endswith", receiver: "global", arity_min: 2, arity_max: 2, return_type: "bool", effects: "", errors: "", opcode: "EndsWith"} if name == "endswith"
            return BuiltinSpec{known: true, name: "replace", receiver: "global", arity_min: 3, arity_max: 3, return_type: "sview", effects: "", errors: "", opcode: "TextReplace"} if name == "replace"
            return BuiltinSpec{known: true, name: "strip", receiver: "global", arity_min: 1, arity_max: 1, return_type: "sview", effects: "", errors: "", opcode: "TrimText"} if name == "strip"
            return BuiltinSpec{known: true, name: "trim", receiver: "global", arity_min: 1, arity_max: 1, return_type: "sview", effects: "", errors: "", opcode: "TrimText"} if name == "trim"
            return BuiltinSpec{known: true, name: "lower", receiver: "global", arity_min: 1, arity_max: 1, return_type: "sview", effects: "", errors: "", opcode: "LowerText"} if name == "lower"
            return BuiltinSpec{known: true, name: "upper", receiver: "global", arity_min: 1, arity_max: 1, return_type: "sview", effects: "", errors: "", opcode: "UpperText"} if name == "upper"
            # The current IR deliberately shares the allocation-free lowercase
            # operation for casefold until a Unicode-aware fold opcode exists.
            return BuiltinSpec{known: true, name: "casefold", receiver: "global", arity_min: 1, arity_max: 1, return_type: "sview", effects: "", errors: "", opcode: "LowerText"} if name == "casefold"
            return BuiltinSpec{known: true, name: "parse_int", receiver: "global", arity_min: 1, arity_max: 1, return_type: "i64", effects: "", errors: "ParseError", opcode: "ParseInt"} if name == "parse_int"
            return BuiltinSpec{known: true, name: "format_int", receiver: "global", arity_min: 1, arity_max: 1, return_type: "sview", effects: "", errors: "", opcode: "FormatInt"} if name == "format_int"
            return BuiltinSpec{known: true, name: "parse_float", receiver: "global", arity_min: 1, arity_max: 1, return_type: "f64", effects: "", errors: "ParseError", opcode: "ParseFloat"} if name == "parse_float"
            return BuiltinSpec{known: true, name: "format_float", receiver: "global", arity_min: 1, arity_max: 1, return_type: "sview", effects: "", errors: "", opcode: "FormatFloat"} if name == "format_float"
            return BuiltinSpec{known: true, name: "format_bool", receiver: "global", arity_min: 1, arity_max: 1, return_type: "sview", effects: "", errors: "", opcode: "FormatBool"} if name == "format_bool"
            return BuiltinSpec{known: true, name: "format_char", receiver: "global", arity_min: 1, arity_max: 1, return_type: "sview", effects: "", errors: "", opcode: "FormatChar"} if name == "format_char"
            return unknown_builtin_spec()


        def typed_builtin_names() -> darray[sview]:
            return ["len", "contains", "is_empty", "isempty", "is_nonempty", "nonempty", "str", "starts_with", "startswith", "ends_with", "endswith", "replace", "strip", "trim", "lower", "upper", "casefold", "parse_int", "format_int", "parse_float", "format_float", "format_bool", "format_char"]
