# Shared Elisascript builtin registry.
#
# This first registry slice deliberately covers only strict scalar/text builtins
# whose signatures fit the existing Symbol return-type fields and IR Type model.
# Aggregate, variadic, receiver-polymorphic, and generic builtins remain in the
# migration queue until their structural descriptors are available.

module EsBuiltin:
    public:
        struct BuiltinSpec:
            known: bool
            name: sview
            receiver: sview
            arity_min: u32
            arity_max: u32
            argument_types: sview
            return_type: sview
            effects: sview
            errors: sview
            opcode: sview
            # Optional named-argument descriptor. An empty value means that the
            # builtin exposes no parameter names; `maxsplit` is interpreted as
            # the second positional slot for split/rsplit rows.
            argument_names: sview = ""


        def unknown_builtin_spec() -> BuiltinSpec:
            return BuiltinSpec{known: false, name: "", receiver: "", arity_min: 0, arity_max: 0, argument_types: "", return_type: "", effects: "", errors: "", opcode: ""}


        # One spelling is one registry identity. Aliases have their own rows so
        # semantic diagnostics and future deprecation metadata can distinguish
        # canonical names from compatibility spellings.
        def typed_builtin_spec(name: sview) -> BuiltinSpec:
            return BuiltinSpec{known: true, name: "len", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "collection|text", return_type: "usize", effects: "", errors: "", opcode: "Length"} if name == "len"
            return BuiltinSpec{known: true, name: "contains", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "collection,any", return_type: "bool", effects: "", errors: "", opcode: "Contains"} if name == "contains"
            return BuiltinSpec{known: true, name: "is_empty", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "collection|text", return_type: "bool", effects: "", errors: "", opcode: "Equal"} if name == "is_empty"
            return BuiltinSpec{known: true, name: "isempty", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "collection|text", return_type: "bool", effects: "", errors: "", opcode: "Equal"} if name == "isempty"
            return BuiltinSpec{known: true, name: "is_nonempty", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "collection|text|Path", return_type: "bool", effects: "", errors: "", opcode: "Not"} if name == "is_nonempty"
            return BuiltinSpec{known: true, name: "nonempty", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "collection|text|Path", return_type: "bool", effects: "", errors: "", opcode: "Not"} if name == "nonempty"
            return BuiltinSpec{known: true, name: "str", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "any", return_type: "sview", effects: "", errors: "", opcode: "FormatNominal"} if name == "str"
            return BuiltinSpec{known: true, name: "starts_with", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,text", return_type: "bool", effects: "", errors: "", opcode: "StartsWith"} if name == "starts_with"
            return BuiltinSpec{known: true, name: "startswith", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,text", return_type: "bool", effects: "", errors: "", opcode: "StartsWith"} if name == "startswith"
            return BuiltinSpec{known: true, name: "ends_with", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,text", return_type: "bool", effects: "", errors: "", opcode: "EndsWith"} if name == "ends_with"
            return BuiltinSpec{known: true, name: "endswith", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,text", return_type: "bool", effects: "", errors: "", opcode: "EndsWith"} if name == "endswith"
            return BuiltinSpec{known: true, name: "replace", receiver: "global", arity_min: 3, arity_max: 3, argument_types: "text,text,text", return_type: "sview", effects: "", errors: "", opcode: "TextReplace"} if name == "replace"
            return BuiltinSpec{known: true, name: "strip", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "sview", effects: "", errors: "", opcode: "TrimText"} if name == "strip"
            return BuiltinSpec{known: true, name: "trim", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "sview", effects: "", errors: "", opcode: "TrimText"} if name == "trim"
            return BuiltinSpec{known: true, name: "lower", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "sview", effects: "", errors: "", opcode: "LowerText"} if name == "lower"
            return BuiltinSpec{known: true, name: "upper", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "sview", effects: "", errors: "", opcode: "UpperText"} if name == "upper"
            # The current IR deliberately shares the allocation-free lowercase
            # operation for casefold until a Unicode-aware fold opcode exists.
            return BuiltinSpec{known: true, name: "casefold", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "sview", effects: "", errors: "", opcode: "LowerText"} if name == "casefold"
            return BuiltinSpec{known: true, name: "parse_int", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "i64", effects: "", errors: "ParseError", opcode: "ParseInt"} if name == "parse_int"
            return BuiltinSpec{known: true, name: "format_int", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "i64", return_type: "sview", effects: "", errors: "", opcode: "FormatInt"} if name == "format_int"
            return BuiltinSpec{known: true, name: "parse_float", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "f64", effects: "", errors: "ParseError", opcode: "ParseFloat"} if name == "parse_float"
            return BuiltinSpec{known: true, name: "format_float", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "f64", return_type: "sview", effects: "", errors: "", opcode: "FormatFloat"} if name == "format_float"
            return BuiltinSpec{known: true, name: "format_bool", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "bool", return_type: "sview", effects: "", errors: "", opcode: "FormatBool"} if name == "format_bool"
            return BuiltinSpec{known: true, name: "format_char", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "char", return_type: "sview", effects: "", errors: "", opcode: "FormatChar"} if name == "format_char"
            return unknown_builtin_spec()


        def typed_builtin_names() -> darray[sview]:
            return ["len", "contains", "is_empty", "isempty", "is_nonempty", "nonempty", "str", "starts_with", "startswith", "ends_with", "endswith", "replace", "strip", "trim", "lower", "upper", "casefold", "parse_int", "format_int", "parse_float", "format_float", "format_bool", "format_char"]


        # Receiver methods share the same contract record as global builtins,
        # but carry an explicit receiver category and exclude the receiver from
        # their positional arity. Keeping these rows separate prevents a global
        # alias such as `lower(text)` from silently changing the method contract
        # `text.lower()`.
        def typed_builtin_method_spec(receiver: sview, name: sview) -> BuiltinSpec:
            return BuiltinSpec{known: true, name: "lower", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "sview", effects: "", errors: "", opcode: "LowerText"} if receiver == "Text" and name == "lower"
            return BuiltinSpec{known: true, name: "upper", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "sview", effects: "", errors: "", opcode: "UpperText"} if receiver == "Text" and name == "upper"
            return BuiltinSpec{known: true, name: "casefold", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "sview", effects: "", errors: "", opcode: "LowerText"} if receiver == "Text" and name == "casefold"
            return BuiltinSpec{known: true, name: "starts_with", receiver: "Text", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "bool", effects: "", errors: "", opcode: "StartsWith"} if receiver == "Text" and name == "starts_with"
            return BuiltinSpec{known: true, name: "startswith", receiver: "Text", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "bool", effects: "", errors: "", opcode: "StartsWith"} if receiver == "Text" and name == "startswith"
            return BuiltinSpec{known: true, name: "ends_with", receiver: "Text", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "bool", effects: "", errors: "", opcode: "EndsWith"} if receiver == "Text" and name == "ends_with"
            return BuiltinSpec{known: true, name: "endswith", receiver: "Text", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "bool", effects: "", errors: "", opcode: "EndsWith"} if receiver == "Text" and name == "endswith"
            return BuiltinSpec{known: true, name: "replace", receiver: "Text", arity_min: 2, arity_max: 2, argument_types: "text,text", return_type: "sview", effects: "", errors: "", opcode: "TextReplace"} if receiver == "Text" and name == "replace"
            return BuiltinSpec{known: true, name: "strip", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "sview", effects: "", errors: "", opcode: "TrimText"} if receiver == "Text" and name == "strip"
            return BuiltinSpec{known: true, name: "trim", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "sview", effects: "", errors: "", opcode: "TrimText"} if receiver == "Text" and name == "trim"
            return BuiltinSpec{known: true, name: "lstrip", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "sview", effects: "", errors: "", opcode: "TrimText"} if receiver == "Text" and name == "lstrip"
            return BuiltinSpec{known: true, name: "rstrip", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "sview", effects: "", errors: "", opcode: "TrimText"} if receiver == "Text" and name == "rstrip"
            return BuiltinSpec{known: true, name: "join", receiver: "Text", arity_min: 1, arity_max: 1, argument_types: "darray[text]", return_type: "sview", effects: "", errors: "", opcode: "Join"} if receiver == "Text" and name == "join"
            return BuiltinSpec{known: true, name: "splitlines", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "darray[text]", effects: "", errors: "", opcode: "SplitLines"} if receiver == "Text" and name == "splitlines"
            return BuiltinSpec{known: true, name: "split_lines", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "darray[text]", effects: "", errors: "", opcode: "SplitLines"} if receiver == "Text" and name == "split_lines"
            return BuiltinSpec{known: true, name: "isdigit", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "bool", effects: "", errors: "", opcode: "TextPredicate"} if receiver == "Text" and name == "isdigit"
            return BuiltinSpec{known: true, name: "isdecimal", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "bool", effects: "", errors: "", opcode: "TextPredicate"} if receiver == "Text" and name == "isdecimal"
            return BuiltinSpec{known: true, name: "isnumeric", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "bool", effects: "", errors: "", opcode: "TextPredicate"} if receiver == "Text" and name == "isnumeric"
            return BuiltinSpec{known: true, name: "isalpha", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "bool", effects: "", errors: "", opcode: "TextPredicate"} if receiver == "Text" and name == "isalpha"
            return BuiltinSpec{known: true, name: "isalnum", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "bool", effects: "", errors: "", opcode: "TextPredicate"} if receiver == "Text" and name == "isalnum"
            return BuiltinSpec{known: true, name: "isspace", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "bool", effects: "", errors: "", opcode: "TextPredicate"} if receiver == "Text" and name == "isspace"
            return BuiltinSpec{known: true, name: "islower", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "bool", effects: "", errors: "", opcode: "TextPredicate"} if receiver == "Text" and name == "islower"
            return BuiltinSpec{known: true, name: "isupper", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "bool", effects: "", errors: "", opcode: "TextPredicate"} if receiver == "Text" and name == "isupper"
            return BuiltinSpec{known: true, name: "isascii", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "bool", effects: "", errors: "", opcode: "TextPredicate"} if receiver == "Text" and name == "isascii"
            return BuiltinSpec{known: true, name: "isprintable", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "bool", effects: "", errors: "", opcode: "TextPredicate"} if receiver == "Text" and name == "isprintable"
            return BuiltinSpec{known: true, name: "removeprefix", receiver: "Text", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "sview", effects: "", errors: "", opcode: "TextRemoveBoundary"} if receiver == "Text" and name == "removeprefix"
            return BuiltinSpec{known: true, name: "removesuffix", receiver: "Text", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "sview", effects: "", errors: "", opcode: "TextRemoveBoundary"} if receiver == "Text" and name == "removesuffix"
            return BuiltinSpec{known: true, name: "contains", receiver: "Text", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "bool", effects: "", errors: "", opcode: "Contains"} if receiver == "Text" and name == "contains"
            return BuiltinSpec{known: true, name: "count", receiver: "Text", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "usize", effects: "", errors: "", opcode: "TextCount"} if receiver == "Text" and name == "count"
            return BuiltinSpec{known: true, name: "find", receiver: "Text", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "i64", effects: "", errors: "", opcode: "TextFind"} if receiver == "Text" and name == "find"
            return BuiltinSpec{known: true, name: "rfind", receiver: "Text", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "i64", effects: "", errors: "", opcode: "TextRFind"} if receiver == "Text" and name == "rfind"
            return BuiltinSpec{known: true, name: "index", receiver: "Text", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "i64", effects: "", errors: "IndexOutOfBounds", opcode: "TextIndex"} if receiver == "Text" and name == "index"
            return BuiltinSpec{known: true, name: "rindex", receiver: "Text", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "i64", effects: "", errors: "IndexOutOfBounds", opcode: "TextRIndex"} if receiver == "Text" and name == "rindex"
            return BuiltinSpec{known: true, name: "partition", receiver: "Text", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "darray[text]", effects: "", errors: "", opcode: "TextPartition"} if receiver == "Text" and name == "partition"
            return BuiltinSpec{known: true, name: "rpartition", receiver: "Text", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "darray[text]", effects: "", errors: "", opcode: "TextPartition"} if receiver == "Text" and name == "rpartition"
            return BuiltinSpec{known: true, name: "is_empty", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "bool", effects: "", errors: "", opcode: "Equal"} if receiver == "Text" and name == "is_empty"
            return BuiltinSpec{known: true, name: "isempty", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "bool", effects: "", errors: "", opcode: "Equal"} if receiver == "Text" and name == "isempty"
            return BuiltinSpec{known: true, name: "is_nonempty", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "bool", effects: "", errors: "", opcode: "Greater"} if receiver == "Text" and name == "is_nonempty"
            return BuiltinSpec{known: true, name: "nonempty", receiver: "Text", arity_min: 0, arity_max: 0, argument_types: "", return_type: "bool", effects: "", errors: "", opcode: "Greater"} if receiver == "Text" and name == "nonempty"
            return BuiltinSpec{known: true, name: "split", receiver: "Text", arity_min: 0, arity_max: 2, argument_types: "text,i64", argument_names: "maxsplit", return_type: "darray[text]", effects: "", errors: "", opcode: "Split"} if receiver == "Text" and name == "split"
            return BuiltinSpec{known: true, name: "rsplit", receiver: "Text", arity_min: 0, arity_max: 2, argument_types: "text,i64", argument_names: "maxsplit", return_type: "darray[text]", effects: "", errors: "", opcode: "Split"} if receiver == "Text" and name == "rsplit"
            return unknown_builtin_spec()


        def typed_builtin_method_names() -> darray[sview]:
            return ["lower", "upper", "casefold", "starts_with", "startswith", "ends_with", "endswith", "replace", "strip", "trim", "lstrip", "rstrip", "join", "splitlines", "split_lines", "isdigit", "isdecimal", "isnumeric", "isalpha", "isalnum", "isspace", "islower", "isupper", "isascii", "isprintable", "removeprefix", "removesuffix", "contains", "count", "find", "rfind", "index", "rindex", "partition", "rpartition", "is_empty", "isempty", "is_nonempty", "nonempty", "split", "rsplit"]
