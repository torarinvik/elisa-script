# Shared Elisascript builtin registry.
#
# This registry slice covers strict scalar/text builtins plus the fixed Regex
# receiver methods whose signatures fit the existing Symbol return-type fields
# and IR Type model. Generic, variadic, receiver-polymorphic, and richer
# capture-group descriptors remain in the migration queue until structural
# descriptors are available.

module EsBuiltin:
    public:
        struct BuiltinSpec:
            known: bool
            name: sview
            receiver: sview
            arity_min: u32
            arity_max: u32
            argument_types: sview
            return_type: sview
            effects: sview
            effects_secondary: sview = ""
            errors: sview
            opcode: sview
            lowering_steps: sview = ""
            lowering_mode: i64 = 0
            # Optional named-argument descriptor. An empty value means that the
            # builtin exposes no parameter names. The explicit slot lets the
            # receiver and global split contracts place `maxsplit` differently.
            argument_names: sview = ""
            named_argument_index: u32 = 4294967295
            # Public rows are source-facing scripting contracts. Private rows
            # are compiler-generated intrinsics and must not be added to the
            # public typed_builtin_names() surface.
            visibility: sview = "public"


        def unknown_builtin_spec() -> BuiltinSpec:
            return BuiltinSpec{known: false, name: "", receiver: "", arity_min: 0, arity_max: 0, argument_types: "", return_type: "", effects: "", errors: "", opcode: ""}


        # Effect rows are intentionally exposed through indexed access instead of
        # making every consumer know the storage layout. The current registry
        # supports two independent effect slots; an empty result means that the
        # requested slot is not part of the builtin contract.
        def builtin_effect_at(spec: BuiltinSpec, index: u32) -> sview:
            return spec.effects if index == 0 else spec.effects_secondary if index == 1 else sview("", 0, 0)


        # One spelling is one registry identity. Aliases have their own rows so
        # semantic diagnostics and future deprecation metadata can distinguish
        # canonical names from compatibility spellings.
        def typed_builtin_spec(name: sview) -> BuiltinSpec:
            return BuiltinSpec{known: true, name: "len", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "collection|text", return_type: "usize", effects: "", errors: "", opcode: "Length"} if name == "len"
            return BuiltinSpec{known: true, name: "contains", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "collection,any", return_type: "bool", effects: "", errors: "", opcode: "Contains"} if name == "contains"
            return BuiltinSpec{known: true, name: "is_empty", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "collection|text", return_type: "bool", effects: "", errors: "", opcode: "Equal", lowering_steps: "Length,Equal"} if name == "is_empty"
            return BuiltinSpec{known: true, name: "isempty", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "collection|text", return_type: "bool", effects: "", errors: "", opcode: "Equal", lowering_steps: "Length,Equal"} if name == "isempty"
            return BuiltinSpec{known: true, name: "is_nonempty", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "collection|text|Path", return_type: "bool", effects: "", errors: "", opcode: "Greater", lowering_steps: "Length,Greater"} if name == "is_nonempty"
            return BuiltinSpec{known: true, name: "nonempty", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "collection|text|Path", return_type: "bool", effects: "", errors: "", opcode: "Greater", lowering_steps: "Length,Greater"} if name == "nonempty"
            return BuiltinSpec{known: true, name: "file_nonempty", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "Path", return_type: "bool", effects: "File.Read", errors: "FileIoError", opcode: "FileSize", lowering_steps: "FileSize,Greater"} if name == "file_nonempty"
            return BuiltinSpec{known: true, name: "str", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "any", return_type: "sview", effects: "", errors: "", opcode: "FormatNominal", lowering_steps: "FormatChar|FormatNominal|FormatBool|FormatInt|FormatFloat|FormatAggregate"} if name == "str"
            # Scalar constructors are strict scripting facades: text is parsed
            # through the checked conversion opcode, while the exact target
            # scalar is an identity. Other numeric widths and truthiness
            # conversions remain outside the registry contract.
            return BuiltinSpec{known: true, name: "int", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text|i64", return_type: "i64", effects: "", errors: "ParseError", opcode: "ParseInt", lowering_steps: "ParseInt|IdentityInt"} if name == "int"
            return BuiltinSpec{known: true, name: "float", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text|f64", return_type: "f64", effects: "", errors: "ParseError", opcode: "ParseFloat", lowering_steps: "ParseFloat|IdentityFloat"} if name == "float"
            # Bool identity emits no instruction; Copy is the verifier-covered
            # identity opcode used for metadata compatibility while the lowerer
            # returns the already-typed operand directly.
            return BuiltinSpec{known: true, name: "bool", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "bool", return_type: "bool", effects: "", errors: "", opcode: "Copy", lowering_steps: "IdentityBool"} if name == "bool"
            return BuiltinSpec{known: true, name: "starts_with", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,text", return_type: "bool", effects: "", errors: "", opcode: "StartsWith"} if name == "starts_with"
            return BuiltinSpec{known: true, name: "startswith", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,text", return_type: "bool", effects: "", errors: "", opcode: "StartsWith"} if name == "startswith"
            return BuiltinSpec{known: true, name: "ends_with", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,text", return_type: "bool", effects: "", errors: "", opcode: "EndsWith"} if name == "ends_with"
            return BuiltinSpec{known: true, name: "endswith", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,text", return_type: "bool", effects: "", errors: "", opcode: "EndsWith"} if name == "endswith"
            return BuiltinSpec{known: true, name: "replace", receiver: "global", arity_min: 3, arity_max: 3, argument_types: "text,text,text", return_type: "sview", effects: "", errors: "", opcode: "TextReplace"} if name == "replace"
            return BuiltinSpec{known: true, name: "strip", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "sview", effects: "", errors: "", opcode: "TrimText", lowering_mode: 0} if name == "strip"
            return BuiltinSpec{known: true, name: "trim", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "sview", effects: "", errors: "", opcode: "TrimText", lowering_mode: 0} if name == "trim"
            return BuiltinSpec{known: true, name: "lstrip", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "sview", effects: "", errors: "", opcode: "TrimText", lowering_mode: 1} if name == "lstrip"
            return BuiltinSpec{known: true, name: "rstrip", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "sview", effects: "", errors: "", opcode: "TrimText", lowering_mode: 2} if name == "rstrip"
            return BuiltinSpec{known: true, name: "lower", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "sview", effects: "", errors: "", opcode: "LowerText"} if name == "lower"
            return BuiltinSpec{known: true, name: "upper", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "sview", effects: "", errors: "", opcode: "UpperText"} if name == "upper"
            # The current IR deliberately shares the allocation-free lowercase
            # operation for casefold until a Unicode-aware fold opcode exists.
            return BuiltinSpec{known: true, name: "casefold", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "sview", effects: "", errors: "", opcode: "LowerText"} if name == "casefold"
            return BuiltinSpec{known: true, name: "parse_int", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "i64", effects: "", errors: "ParseError", opcode: "ParseInt"} if name == "parse_int"
            return BuiltinSpec{known: true, name: "format_int", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "i64", return_type: "sview", effects: "", errors: "", opcode: "FormatInt"} if name == "format_int"
            return BuiltinSpec{known: true, name: "parse_float", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "f64", effects: "", errors: "ParseError", opcode: "ParseFloat"} if name == "parse_float"
            return BuiltinSpec{known: true, name: "format_float", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "f64", return_type: "sview", effects: "", errors: "", opcode: "FormatFloat"} if name == "format_float"
            return BuiltinSpec{known: true, name: "format_bool", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "bool", return_type: "sview", effects: "", errors: "", opcode: "FormatBool"} if name == "format_bool"
            return BuiltinSpec{known: true, name: "format_char", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "char", return_type: "sview", effects: "", errors: "", opcode: "FormatChar"} if name == "format_char"
            return BuiltinSpec{known: true, name: "partition", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,text", return_type: "darray[text]", effects: "", errors: "", opcode: "TextPartition", lowering_mode: 0} if name == "partition"
            return BuiltinSpec{known: true, name: "rpartition", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,text", return_type: "darray[text]", effects: "", errors: "", opcode: "TextPartition", lowering_mode: 1} if name == "rpartition"
            return BuiltinSpec{known: true, name: "split_lines", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "darray[text]", effects: "", errors: "", opcode: "SplitLines"} if name == "split_lines"
            return BuiltinSpec{known: true, name: "splitlines", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "text", return_type: "darray[text]", effects: "", errors: "", opcode: "SplitLines"} if name == "splitlines"
            return BuiltinSpec{known: true, name: "split", receiver: "global", arity_min: 2, arity_max: 3, argument_types: "text,text,i64", argument_names: "maxsplit", named_argument_index: 2, return_type: "darray[text]", effects: "", errors: "", opcode: "Split", lowering_mode: 0} if name == "split"
            return BuiltinSpec{known: true, name: "join", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "darray[text],text", return_type: "sview", effects: "", errors: "", opcode: "Join"} if name == "join"
            # `reversed` preserves the concrete array element type in the
            # lowerer; `array` is the registry shape marker while polymorphic
            # inference carries the recursive descriptor.
            return BuiltinSpec{known: true, name: "reversed", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "array", return_type: "array", effects: "", errors: "", opcode: "ReverseArray"} if name == "reversed"
            return BuiltinSpec{known: true, name: "sorted", receiver: "global", arity_min: 1, arity_max: 2, argument_types: "array,bool", argument_names: "reverse", named_argument_index: 1, return_type: "array", effects: "", errors: "", opcode: "SortArray"} if name == "sorted"
            # `observe` is a backend-independent trace point. It accepts one
            # value of any static type and produces no value; the lowerer still
            # requires a source declaration to lose precedence before emitting
            # the Observe instruction.
            return BuiltinSpec{known: true, name: "observe", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "any", return_type: "void", effects: "", errors: "", opcode: "Observe"} if name == "observe"
            return BuiltinSpec{known: true, name: "assert", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "bool", return_type: "void", effects: "", errors: "AssertionError", opcode: "Assert"} if name == "assert"
            return BuiltinSpec{known: true, name: "panic", receiver: "global", arity_min: 0, arity_max: 1, argument_types: "any", return_type: "void", effects: "Abort.Panic", errors: "", opcode: "Panic"} if name == "panic"
            # raise is a compiler intrinsic rather than a normal value
            # constructor: its single argument is an Error.Tag reference or
            # payload-bearing constructor validated against the enclosing
            # function's declared error[...] row. The registry still owns
            # its arity, void result, and Raise opcode identity so semantic
            # seeding and lowering cannot drift on the spelling.
            return BuiltinSpec{known: true, name: "raise", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "error", return_type: "void", effects: "", errors: "", opcode: "Raise"} if name == "raise"
            # resume is the dynamic-handler callback intrinsic. Its resumed
            # value is deliberately polymorphic in the registry because the
            # enclosing callback return type supplies the exact payload type;
            # the lowerer performs that callback-specific equality check.
            return BuiltinSpec{known: true, name: "resume", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,any", return_type: "polymorphic", effects: "", errors: "", opcode: "Resume"} if name == "resume"
            # F-string expansion is a compiler-generated call, not a public
            # scripting builtin. Keep it in the shared registry so semantic
            # seeding, inference, and lowering agree on its private contract,
            # while intentionally omitting it from typed_builtin_names().
            return BuiltinSpec{known: true, name: "__fstr", receiver: "global", arity_min: 1, arity_max: 4294967295, argument_types: "any", return_type: "sview", effects: "", errors: "", opcode: "", lowering_steps: "FString", visibility: "private"} if name == "__fstr"
            # Console facades accept a variadic sequence of values followed by
            # optional typed `sep`, `end`, and `flush` controls. `print` adds a
            # newline by default and `printr` writes without one; `end` may
            # explicitly override either default. The lowerer owns that custom
            # shape while this row supplies the shared result and stream
            # effect/error contract.
            return BuiltinSpec{known: true, name: "print", receiver: "global", arity_min: 0, arity_max: 4294967295, argument_types: "print", return_type: "usize", effects: "Console.Write", errors: "ConsoleError", opcode: "WriteStdout", lowering_steps: "PrintValues,PrintControls"} if name == "print"
            return BuiltinSpec{known: true, name: "printr", receiver: "global", arity_min: 0, arity_max: 4294967295, argument_types: "print", return_type: "usize", effects: "Console.Write", errors: "ConsoleError", opcode: "WriteStdout", lowering_steps: "PrintValues,PrintControls"} if name == "printr"
            return BuiltinSpec{known: true, name: "echo", receiver: "global", arity_min: 0, arity_max: 4294967295, argument_types: "print", return_type: "usize", effects: "Console.Write", errors: "ConsoleError", opcode: "WriteStdout", lowering_steps: "PrintValues,PrintControls"} if name == "echo"
            # `abs` returns the exact numeric family of its operand; the
            # polymorphic inference adapter retains that family while this row
            # supplies the shared argument and lowering identity.
            return BuiltinSpec{known: true, name: "abs", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "i64|f64", return_type: "numeric", effects: "", errors: "", opcode: "Negate", lowering_steps: "Compare,Negate,Select"} if name == "abs"
            # `min` and `max` accept either one orderable array or two or more
            # positional orderable values. The lowerer owns that variadic
            # shape; this row records the shared SortArray/Index composition
            # while polymorphic inference carries the concrete element type.
            return BuiltinSpec{known: true, name: "min", receiver: "global", arity_min: 1, arity_max: 4294967295, argument_types: "orderable|array", return_type: "polymorphic", effects: "", errors: "", opcode: "SortArray", lowering_steps: "SortArray,Index"} if name == "min"
            return BuiltinSpec{known: true, name: "max", receiver: "global", arity_min: 1, arity_max: 4294967295, argument_types: "orderable|array", return_type: "polymorphic", effects: "", errors: "", opcode: "SortArray", lowering_steps: "SortArray,Index"} if name == "max"
            # Map projections preserve their concrete key/value descriptors in
            # the dedicated lowerers; the registry supplies the map input and
            # verified projection opcode without flattening those results.
            return BuiltinSpec{known: true, name: "keys", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "dict", return_type: "array", effects: "", errors: "", opcode: "MapKeys"} if name == "keys"
            return BuiltinSpec{known: true, name: "values", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "dict", return_type: "array", effects: "", errors: "", opcode: "MapValues"} if name == "values"
            # Numeric folds accept one iterable/range value plus an optional
            # typed `start` seed. The state-machine helper owns iterable
            # validation and accumulator typing; these rows provide its
            # primitive operation identity and named-argument contract.
            return BuiltinSpec{known: true, name: "sum", receiver: "global", arity_min: 1, arity_max: 2, argument_types: "iterable|range,i64", return_type: "polymorphic", effects: "", errors: "", opcode: "Add", lowering_steps: "Comprehension,Fold", argument_names: "start", named_argument_index: 1} if name == "sum"
            return BuiltinSpec{known: true, name: "product", receiver: "global", arity_min: 1, arity_max: 2, argument_types: "iterable|range,i64", return_type: "polymorphic", effects: "", errors: "", opcode: "Multiply", lowering_steps: "Comprehension,Fold", argument_names: "start", named_argument_index: 1} if name == "product"
            # Quantifiers short-circuit through the existing state-machine
            # helper. Equal is the verifier-covered primitive identity for the
            # boolean result; the lowering step records the quantifier mode.
            return BuiltinSpec{known: true, name: "any", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "iterable|range", return_type: "bool", effects: "", errors: "", opcode: "Equal", lowering_steps: "Comprehension,Any"} if name == "any"
            return BuiltinSpec{known: true, name: "all", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "iterable|range", return_type: "bool", effects: "", errors: "", opcode: "Equal", lowering_steps: "Comprehension,All"} if name == "all"
            return BuiltinSpec{known: true, name: "matches", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,Regex", return_type: "bool", effects: "", errors: "", opcode: "RegexSearch"} if name == "matches"
            return BuiltinSpec{known: true, name: "replace_regex", receiver: "global", arity_min: 3, arity_max: 3, argument_types: "text,Regex,text", return_type: "sview", effects: "", errors: "", opcode: "RegexReplace"} if name == "replace_regex"
            return BuiltinSpec{known: true, name: "split_regex", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,Regex", return_type: "darray[text]", effects: "", errors: "", opcode: "RegexSplit"} if name == "split_regex"
            return BuiltinSpec{known: true, name: "find_regex", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,Regex", return_type: "darray[text]", effects: "", errors: "", opcode: "RegexFind"} if name == "find_regex"
            return BuiltinSpec{known: true, name: "capture_regex", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,Regex", return_type: "darray[text]", effects: "", errors: "", opcode: "RegexCapture"} if name == "capture_regex"
            return BuiltinSpec{known: true, name: "captures_regex", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "text,Regex", return_type: "darray[text]", effects: "", errors: "", opcode: "RegexCapture"} if name == "captures_regex"
            return BuiltinSpec{known: true, name: "regex_search", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "Regex,text", return_type: "bool", effects: "", errors: "", opcode: "RegexSearch", lowering_mode: 0} if name == "regex_search"
            return BuiltinSpec{known: true, name: "regex_match", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "Regex,text", return_type: "bool", effects: "", errors: "", opcode: "RegexSearch", lowering_mode: 1} if name == "regex_match"
            return BuiltinSpec{known: true, name: "regex_fullmatch", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "Regex,text", return_type: "bool", effects: "", errors: "", opcode: "RegexSearch", lowering_mode: 2} if name == "regex_fullmatch"
            return BuiltinSpec{known: true, name: "regex_findall", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "Regex,text", return_type: "darray[text]", effects: "", errors: "", opcode: "RegexFind"} if name == "regex_findall"
            return BuiltinSpec{known: true, name: "regex_count", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "Regex,text", return_type: "usize", effects: "", errors: "", opcode: "RegexFind", lowering_steps: "RegexFind,Length"} if name == "regex_count"
            return BuiltinSpec{known: true, name: "regex_capture_named", receiver: "global", arity_min: 3, arity_max: 3, argument_types: "Regex,text,text", return_type: "sview", effects: "", errors: "", opcode: "RegexCaptureNamed"} if name == "regex_capture_named"
            return BuiltinSpec{known: true, name: "regex_split", receiver: "global", arity_min: 2, arity_max: 2, argument_types: "Regex,text", return_type: "darray[text]", effects: "", errors: "", opcode: "RegexSplit"} if name == "regex_split"
            return BuiltinSpec{known: true, name: "regex_sub", receiver: "global", arity_min: 3, arity_max: 3, argument_types: "Regex,text,text", return_type: "sview", effects: "", errors: "", opcode: "RegexReplace"} if name == "regex_sub"
            return BuiltinSpec{known: true, name: "path_exists", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "Path", return_type: "bool", effects: "File.Read", errors: "FileIoError", opcode: "PathExists"} if name == "path_exists"
            return BuiltinSpec{known: true, name: "exists", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "Path", return_type: "bool", effects: "File.Read", errors: "FileIoError", opcode: "PathExists"} if name == "exists"
            return BuiltinSpec{known: true, name: "is_file", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "Path", return_type: "bool", effects: "File.Read", errors: "", opcode: "IsFile"} if name == "is_file"
            return BuiltinSpec{known: true, name: "isfile", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "Path", return_type: "bool", effects: "File.Read", errors: "", opcode: "IsFile"} if name == "isfile"
            return BuiltinSpec{known: true, name: "is_directory", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "Path", return_type: "bool", effects: "Directory.Read", errors: "DirectoryError", opcode: "IsDirectory"} if name == "is_directory"
            return BuiltinSpec{known: true, name: "isdir", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "Path", return_type: "bool", effects: "Directory.Read", errors: "DirectoryError", opcode: "IsDirectory"} if name == "isdir"
            return BuiltinSpec{known: true, name: "is_dir", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "Path", return_type: "bool", effects: "Directory.Read", errors: "DirectoryError", opcode: "IsDirectory"} if name == "is_dir"
            return BuiltinSpec{known: true, name: "is_symlink", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "Path", return_type: "bool", effects: "File.Read", errors: "", opcode: "IsSymlink"} if name == "is_symlink"
            return BuiltinSpec{known: true, name: "islink", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "Path", return_type: "bool", effects: "File.Read", errors: "", opcode: "IsSymlink"} if name == "islink"
            # PathAccess lowering_mode carries the POSIX access(2) bit without
            # making the lowerer infer it from the alias spelling.
            return BuiltinSpec{known: true, name: "is_readable", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "Path", return_type: "bool", effects: "File.Read", errors: "", opcode: "PathAccess", lowering_mode: 4} if name == "is_readable"
            return BuiltinSpec{known: true, name: "is_writable", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "Path", return_type: "bool", effects: "File.Read", errors: "", opcode: "PathAccess", lowering_mode: 2} if name == "is_writable"
            return BuiltinSpec{known: true, name: "is_executable", receiver: "global", arity_min: 1, arity_max: 1, argument_types: "Path", return_type: "bool", effects: "File.Read", errors: "", opcode: "PathAccess", lowering_mode: 1} if name == "is_executable"
