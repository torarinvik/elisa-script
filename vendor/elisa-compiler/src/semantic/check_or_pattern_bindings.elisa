# Or-pattern binding-consistency check: every alternative of an `A | B | …` pattern must
# introduce the SAME set of binding names, because the arm body may run under any
# alternative — `A(x) | B(y):` would leave `x` or `y` unbound depending on which matched.
#
# SOUNDNESS (zero false positives is the prime directive): binding names are collected
# structurally from the AST (`Pattern.Binding` / `TypeBind` / `As`, recursing through
# Variant/Struct/Tuple/nested-Or fields). The check fires only when two alternatives' name
# SETS actually differ (subset both ways). Order and duplicates don't matter. No type
# inference, no region concerns.

extend Semantic:
    private:
        # Append every binding name introduced by `pattern` to `out`.
        def collect_pattern_binding_names(pattern: Ast::Pattern, out: mutable darray[sview]&) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Binding(binding_name):
                        out.push(binding_name)
                    Pattern.TypeBind(type_name, binder):
                        out.push(binder)
                    Pattern.As(as_name, inner):
                        out.push(as_name)
                        for inner_pattern in inner:
                            collect_pattern_binding_names(inner_pattern, out)
                    Pattern.Variant(path, fields):
                        for field_pattern in fields:
                            collect_pattern_binding_names(field_pattern, out)
                    Pattern.Struct(struct_path, struct_fields):
                        for struct_field_pattern in struct_fields:
                            collect_pattern_binding_names(struct_field_pattern, out)
                    Pattern.Field(selector, inner):
                        for inner_pattern in inner:
                            collect_pattern_binding_names(inner_pattern, out)
                    Pattern.Tuple(elements):
                        for element_pattern in elements:
                            collect_pattern_binding_names(element_pattern, out)
                    Pattern.Or(options):
                        for option_pattern in options:
                            collect_pattern_binding_names(option_pattern, out)
                    _:
                        pass

        # Whether every name in `a` also appears in `b`.
        def names_subset(a: darray[sview], b: darray[sview]) -> bool:
            for candidate in a:
                present: bool =
                    for other in b |seen = false| -> seen:
                        if other == candidate:
                            seen <- true
                            break
                false return if not present
            return true

        # Check one pattern (recursing into sub-patterns) for inconsistent or-alternatives.
        def check_pattern_for_or_bindings(pattern: Ast::Pattern, line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match pattern:
                    Pattern.Or(options):
                        # stage0 requires matching binder names only for a NESTED
                        # or-pattern — one inside a variant/struct/tuple field. Isolated
                        # by fixture, varying ONE thing at a time:
                        #
                        #   arm-level, overlapping names   Circle(r, tag) | Square(r)
                        #   arm-level, DISJOINT names      Circle(r) | Square(w)
                        #       -> stage0 ACCEPTS both
                        #   nested, overlapping            Leaf(Ident(v, e) | Keyword(v))
                        #   nested, disjoint               Leaf(Ident(v) | Keyword(w))
                        #       -> stage0 REJECTS both, "must bind the same names with
                        #          compatible types"
                        #
                        # So the discriminator is NESTING, not name overlap — my first
                        # reading (overlap) fitted two fixtures that differed in two
                        # variables at once. At arm level the alternatives may bind
                        # different sets and only the INTERSECTION scopes the body
                        # (resolve_scope.elisa Pattern.Or); a body naming a non-common
                        # binder then gets an ordinary `undefined identifier`, which is
                        # exactly what stage0 reports. The arm-level SKIP lives at the
                        # caller (check_or_pattern_bindings_statements), so everything
                        # reached from here is nested by construction.
                        if options.count >= 2:
                            reference: mutable darray[sview] = []
                            collect_pattern_binding_names(options[0], reference)
                            for option in options |table| -> table:
                                current: mutable darray[sview] = []
                                collect_pattern_binding_names(option, current)
                                consistent: bool = names_subset(reference, current) and names_subset(current, reference)
                                table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.OrPatternBindingMismatch, name: "", line: line, expected: "", actual: ""}) if not consistent
                                table
                        # Recurse into the alternatives for any nested or-patterns.
                        for nested_option in options |table| -> table:
                            table <- check_pattern_for_or_bindings(nested_option, line, table)
                    Pattern.Variant(path, fields):
                        for field_pattern in fields |table| -> table:
                            table <- check_pattern_for_or_bindings(field_pattern, line, table)
                    Pattern.Struct(struct_path, struct_fields):
                        for struct_field_pattern in struct_fields |table| -> table:
                            table <- check_pattern_for_or_bindings(struct_field_pattern, line, table)
                    Pattern.Field(selector, inner):
                        for inner_pattern in inner |table| -> table:
                            table <- check_pattern_for_or_bindings(inner_pattern, line, table)
                    Pattern.Tuple(elements):
                        for element_pattern in elements |table| -> table:
                            table <- check_pattern_for_or_bindings(element_pattern, line, table)
                    Pattern.As(as_name, inner):
                        for inner_pattern in inner |table| -> table:
                            table <- check_pattern_for_or_bindings(inner_pattern, line, table)
                    _:
                        pass

        # Walk match/catch arms through the same top-level exemption used by
        # statement matches.  Nested alternatives are still checked recursively.
        def check_or_pattern_binding_arms(arms: darray[Ast::MatchArm], line: u32, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for arm in arms |table| -> table:
                    match arm.pattern:
                        Pattern.Or(walk_options):
                            for walk_option in walk_options |table| -> table:
                                table <- check_pattern_for_or_bindings(walk_option, line, table)
                        _:
                            table <- check_pattern_for_or_bindings(arm.pattern, line, table)
                    table <- check_or_pattern_bindings_expression(arm.guard, table)
                    table <- check_or_pattern_bindings_statements(arm.body, table)

        # Recurse through every expression position so a pattern nested inside
        # a call, condition, block, match expression, or catch cannot evade the
        # consistency check.
        def check_or_pattern_bindings_expression(expression: Ast::Expr, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        table <- check_or_pattern_bindings_expression(callee, table)
                        for argument in arguments |table|:
                            table <- check_or_pattern_bindings_expression(argument, table)
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        table <- check_or_pattern_bindings_expression(object, table)
                    Expr.Index(object, index, line):
                        table <- check_or_pattern_bindings_expression(object, table)
                        table <- check_or_pattern_bindings_expression(index, table)
                    Expr.Slice(object, low, high, line):
                        table <- check_or_pattern_bindings_expression(object, table)
                        table <- check_or_pattern_bindings_expression(low, table)
                        table <- check_or_pattern_bindings_expression(high, table)
                    Expr.IndexN(object, arguments, line):
                        table <- check_or_pattern_bindings_expression(object, table)
                        for argument in arguments |table|:
                            table <- check_or_pattern_bindings_expression(argument, table)
                    Expr.Binary(left, operator, right, line):
                        table <- check_or_pattern_bindings_expression(left, table)
                        table <- check_or_pattern_bindings_expression(right, table)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line):
                        table <- check_or_pattern_bindings_expression(operand, table)
                    Expr.RegionNew(operand, region, line):
                        table <- check_or_pattern_bindings_expression(operand, table)
                    Expr.Paren(inner, line):
                        table <- check_or_pattern_bindings_expression(inner, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |table|:
                            table <- check_or_pattern_bindings_expression(element, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table|:
                            table <- check_or_pattern_bindings_expression(entry.key, table)
                            table <- check_or_pattern_bindings_expression(entry.value, table)
                    Expr.Construct(type_expression, fields, line):
                        table <- check_or_pattern_bindings_expression(type_expression, table)
                        for field in fields |table|:
                            table <- check_or_pattern_bindings_expression(field.value, table)
                    Expr.RecordUpdate(base, fields, line):
                        table <- check_or_pattern_bindings_expression(base, table)
                        for field in fields |table|:
                            table <- check_or_pattern_bindings_expression(field.value, table)
                    Expr.If(condition, then_expression, else_expression, line):
                        table <- check_or_pattern_bindings_expression(condition, table)
                        table <- check_or_pattern_bindings_expression(then_expression, table)
                        table <- check_or_pattern_bindings_expression(else_expression, table)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        table <- check_or_pattern_bindings_expression(scrutinee, table)
                        table <- check_or_pattern_binding_arms(arms, line.line, table)
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        table <- check_or_pattern_bindings_expression(iterable, table)
                        table <- check_or_pattern_bindings_expression(condition, table)
                        table <- check_or_pattern_bindings_expression(body, table)
                    Expr.Refinement(base, predicate, line):
                        table <- check_or_pattern_bindings_expression(base, table)
                        table <- check_or_pattern_bindings_expression(predicate, table)
                    Expr.GetElse(guarded, recovery, line):
                        table <- check_or_pattern_bindings_expression(guarded, table)
                        table <- check_or_pattern_bindings_statements(recovery, table)
                    Expr.Lambda(parameters, body, line):
                        table <- check_or_pattern_bindings_statements(body, table)
                    Expr.Block(statements, value, captures, line):
                        table <- check_or_pattern_bindings_statements(statements, table)
                        table <- check_or_pattern_bindings_expression(value, table)
                    _:
                        pass

        # Walk statements, checking every match arm's pattern.
        def check_or_pattern_bindings_statements(statements: darray[Ast::Stmt], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Match(scrutinee, arms, line):
                            table <- check_or_pattern_bindings_expression(scrutinee, table)
                            table <- check_or_pattern_binding_arms(arms, line.line, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- check_or_pattern_bindings_expression(condition, table)
                            table <- check_or_pattern_bindings_statements(then_body, table)
                            table <- check_or_pattern_bindings_statements(else_body, table)
                        Stmt.While(condition, body, line):
                            table <- check_or_pattern_bindings_expression(condition, table)
                            table <- check_or_pattern_bindings_statements(body, table)
                        Stmt.For(bind, variables, iterable, body, line):
                            table <- check_or_pattern_bindings_expression(iterable, table)
                            table <- check_or_pattern_bindings_statements(body, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            table <- check_or_pattern_bindings_statements(body, table)
                        Stmt.Expr(expression, line):
                            table <- check_or_pattern_bindings_expression(expression, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- check_or_pattern_bindings_expression(type_expression, table)
                            table <- check_or_pattern_bindings_expression(value, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- check_or_pattern_bindings_expression(target, table)
                            table <- check_or_pattern_bindings_expression(value, table)
                        Stmt.Return(value, line):
                            table <- check_or_pattern_bindings_expression(return_value, table) if value is return_value
                        Stmt.Contract(kind, expression, line):
                            table <- check_or_pattern_bindings_expression(expression, table)
                        _:
                            pass

    public:
        # Entry point: descend all function bodies (recursing into modules and scoped blocks).
        def check_or_pattern_bindings(declarations: darray[Ast::Decl], table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(name, params, return_type, body, effects, decorators, line):
                            table <- check_or_pattern_bindings_statements(body, table)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_or_pattern_bindings(module_body, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_or_pattern_bindings(scoped_body, table)
                        _:
                            pass
