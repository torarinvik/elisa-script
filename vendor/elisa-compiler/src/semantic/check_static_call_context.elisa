# Static-function call context (stage0 static-evaluation). A `static def` function is compile-time
# only; calling it from ordinary runtime code is rejected ("static function X can only be called
# from a static context"). The parser records each static function's name (owner "__static_fn").
#
# SOUND subset: a call to a static function from a function that is NOT itself a static function is
# flagged. Calls from another static function are fine (both compile-time). Static-if/static-generate
# bodies inside a runtime function are a rarer static context left to the full evaluator.
extend Semantic:
    private:
        def is_static_function(static_fns: darray[sview]&, name: sview) -> bool:
            can Abort.Panic:
                return any static_name in static_fns where static_name == name

        def static_call_check_expression(expression: Ast::Expr, static_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                match expression:
                    Expr.Call(callee, arguments, argument_names, line):
                        callee_name: sview = ident_name_of(callee)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: DiagnosticKind.StaticCallContext, name: callee_name, line: line.line, expected: "", actual: ""}) if callee_name != "" and is_static_function(static_fns, callee_name)
                        table <- static_call_check_expression(callee, static_fns, table)
                        for argument in arguments |table| -> table:
                            table <- static_call_check_expression(argument, static_fns, table)
                    Expr.Field(object, field, line) | Expr.Scope(object, field, line):
                        table <- static_call_check_expression(object, static_fns, table)
                    Expr.Index(object, index, line):
                        table <- static_call_check_expression(object, static_fns, table)
                        table <- static_call_check_expression(index, static_fns, table)
                    Expr.Slice(object, low, high, line):
                        table <- static_call_check_expression(object, static_fns, table)
                        table <- static_call_check_expression(low, static_fns, table)
                        table <- static_call_check_expression(high, static_fns, table)
                    Expr.IndexN(object, arguments, line):
                        table <- static_call_check_expression(object, static_fns, table)
                        for argument in arguments |table| -> table:
                            table <- static_call_check_expression(argument, static_fns, table)
                    Expr.Binary(left, operator, right, line):
                        table <- static_call_check_expression(left, static_fns, table)
                        table <- static_call_check_expression(right, static_fns, table)
                    Expr.Unary(operator, operand, line) | Expr.Move(operand, line) | Expr.Paren(operand, line):
                        table <- static_call_check_expression(operand, static_fns, table)
                    Expr.If(condition, selected, alternative, line):
                        table <- static_call_check_expression(condition, static_fns, table)
                        table <- static_call_check_expression(selected, static_fns, table)
                        table <- static_call_check_expression(alternative, static_fns, table)
                    Expr.Match(scrutinee, arms, line) | Expr.Catch(scrutinee, arms, line):
                        table <- static_call_check_expression(scrutinee, static_fns, table)
                        for arm in arms |table| -> table:
                            table <- static_call_check_expression(arm.guard, static_fns, table)
                            table <- static_call_check_statements(arm.body, static_fns, table)
                    Expr.Refinement(base, predicate, line):
                        table <- static_call_check_expression(base, static_fns, table)
                        table <- static_call_check_expression(predicate, static_fns, table)
                    Expr.GetElse(guarded, recovery, line):
                        table <- static_call_check_expression(guarded, static_fns, table)
                        table <- static_call_check_statements(recovery, static_fns, table)
                    Expr.Comprehension(variable, iterable, condition, body, line):
                        table <- static_call_check_expression(iterable, static_fns, table)
                        table <- static_call_check_expression(condition, static_fns, table)
                        table <- static_call_check_expression(body, static_fns, table)
                    Expr.Block(statements, value, captures, line):
                        table <- static_call_check_statements(statements, static_fns, table)
                        table <- static_call_check_expression(value, static_fns, table)
                    Expr.Array(elements, line) | Expr.Tuple(elements, line) | Expr.SetLit(elements, line):
                        for element in elements |table| -> table:
                            table <- static_call_check_expression(element, static_fns, table)
                    Expr.DictLit(entries, line):
                        for entry in entries |table| -> table:
                            table <- static_call_check_expression(entry.key, static_fns, table)
                            table <- static_call_check_expression(entry.value, static_fns, table)
                    Expr.Construct(type_expression, fields, line) | Expr.RecordUpdate(type_expression, fields, line):
                        table <- static_call_check_expression(type_expression, static_fns, table)
                        for field in fields |table| -> table:
                            table <- static_call_check_expression(field.value, static_fns, table)
                    Expr.Lambda(parameters, body, line):
                        table <- static_call_check_statements(body, static_fns, table)
                    _:
                        pass

        def static_call_check_statements(statements: darray[Ast::Stmt], static_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for statement in statements |table| -> table:
                    match statement:
                        Stmt.Expr(expression, line):
                            table <- static_call_check_expression(expression, static_fns, table)
                        Stmt.VarDecl(name, type_expression, value, line):
                            table <- static_call_check_expression(value, static_fns, table)
                        Stmt.Assign(target, operator, value, line):
                            table <- static_call_check_expression(target, static_fns, table)
                            table <- static_call_check_expression(value, static_fns, table)
                        Stmt.Return(value, line):
                            if value is returned:
                                table <- static_call_check_expression(returned, static_fns, table)
                        Stmt.If(condition, then_body, else_body, line):
                            table <- static_call_check_expression(condition, static_fns, table)
                            table <- static_call_check_statements(then_body, static_fns, table)
                            table <- static_call_check_statements(else_body, static_fns, table)
                        Stmt.While(condition, while_body, line):
                            table <- static_call_check_expression(condition, static_fns, table)
                            table <- static_call_check_statements(while_body, static_fns, table)
                        Stmt.For(bind, variables, iterable, for_body, line):
                            table <- static_call_check_expression(iterable, static_fns, table)
                            table <- static_call_check_statements(for_body, static_fns, table)
                        Stmt.Match(scrutinee, arms, line):
                            table <- static_call_check_expression(scrutinee, static_fns, table)
                            for arm in arms |table| -> table:
                                table <- static_call_check_expression(arm.guard, static_fns, table)
                                table <- static_call_check_statements(arm.body, static_fns, table)
                        Stmt.Contract(kind, expression, line):
                            table <- static_call_check_expression(expression, static_fns, table)
                        Stmt.Block(kind, clause, binding, body, line):
                            # A `static:` block is itself a compile-time (static) context, so
                            # calls to static functions inside it are fine — don't walk it.
                            table <- static_call_check_statements(body, static_fns, table) if kind != "static"
                        _:
                            pass

        def check_static_call_context_walk(declarations: darray[Ast::Decl], static_fns: darray[sview]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                for declaration in declarations |table| -> table:
                    match declaration:
                        Decl.Func(function_name, parameters, return_type, body, effects, decorators, line):
                            # A static function is itself a static context — its calls to statics are fine.
                            table <- static_call_check_statements(body, static_fns, table) if not is_static_function(static_fns, function_name)
                        Decl.Module(module_name, module_body, module_line):
                            table <- check_static_call_context_walk(module_body, static_fns, table)
                        Decl.Scoped(scoped_body, scoped_line):
                            table <- check_static_call_context_walk(scoped_body, static_fns, table)
                        _:
                            pass

        def check_static_call_context(file: Ast::File&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                static_fns: mutable darray[sview] = []
                for annotation in file.enum_annotations |static_fns|:
                    static_fns.push(annotation.name) if annotation.owner == "__static_fn"
                table <- check_static_call_context_walk(file.top_decls, static_fns, table) if static_fns.count > 0
