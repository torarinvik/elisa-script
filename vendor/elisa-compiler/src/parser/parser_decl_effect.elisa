# Stage1 parser — source-declared effect operation metadata. Effect declarations
# remain Alias nodes in the stable Decl ABI, so this extension preserves their
# typed signature spelling in the parser-owned side table for later resolution.

extend Parser:
    private:
        # Preserve the complete parenthesized payload span for a first-level effect
        # operation. This is deliberately a token scan rather than a second parse:
        # the ordinary declaration parser still owns syntax errors and the returned
        # source view remains tied to the file's source buffer.
        def effect_operation_payload_signature(parser: Parser&, start_offset: usize) -> sview:
            can Abort.Panic:
                offset: mutable usize = start_offset + 2       # `def` + operation name
                depth: mutable int = 0
                payload_start: mutable usize = 0
                while parser.peek_at(offset) != TokenKind.Eof |parser, offset, depth, payload_start|:
                    token: Token = parser.tokens[parser.position + offset]
                    kind: TokenKind = token.kind
                    if kind == TokenKind.LParen and depth == 0:
                        payload_start <- token.start.usize()
                        depth <- 1
                    elif kind == TokenKind.LParen and depth > 0:
                        depth <- depth + 1
                    elif kind == TokenKind.LBracket and depth > 0:
                        depth <- depth + 1
                    elif kind == TokenKind.RBracket and depth > 1:
                        depth <- depth - 1
                    elif kind == TokenKind.RParen and depth > 1:
                        depth <- depth - 1
                    elif kind == TokenKind.RParen and depth == 1:
                        end: usize = token.start.usize() + token.length.usize()
                        return Lexer::source_view_or_empty(parser.source, payload_start, end)
                    elif depth == 0 and kind == TokenKind.Newline:
                        return sview("", 0, 0)
                    offset <- offset + 1
                return sview("", 0, 0)


        # Preserve the type span after a top-level `->`. The scan stops before the
        # operation body, and before signature clauses whose words belong to the
        # enclosing declaration rather than the result type. Nested generic/function
        # type punctuation is kept inside the returned source view.
        def effect_operation_result_signature(parser: Parser&, start_offset: usize) -> sview:
            can Abort.Panic:
                offset: mutable usize = start_offset + 2
                depth: mutable int = 0
                saw_arrow: mutable bool = false
                saw_result_token: mutable bool = false
                result_start: mutable usize = 0
                result_end: mutable usize = 0
                while parser.peek_at(offset) != TokenKind.Eof |parser, offset, depth, saw_arrow, saw_result_token, result_start, result_end|:
                    token: Token = parser.tokens[parser.position + offset]
                    kind: TokenKind = token.kind
                    if not saw_arrow and depth == 0 and kind == TokenKind.Arrow:
                        saw_arrow <- true
                    elif saw_arrow and depth == 0 and (kind == TokenKind.Colon or kind == TokenKind.Newline or kind == TokenKind.Assign):
                        return Lexer::source_view_or_empty(parser.source, result_start, result_end)
                    elif saw_arrow and depth == 0 and kind == TokenKind.Ident:
                        word: sview = Lexer::text_or_empty(token, parser.source)
                        return Lexer::source_view_or_empty(parser.source, result_start, result_end) if word == "can" or word == "error" or word == "raises" or word == "requires" or word == "ensures" or word == "ensure" or word == "fulfills" or word == "changes" or word == "preserves" or word == "decreases" or word == "invariant" or word == "uses" or word == "at" or word == "abi"
                    if saw_arrow and not saw_result_token:
                        saw_result_token <- true
                        result_start <- token.start.usize()
                    depth <- depth + 1 if saw_arrow and (kind == TokenKind.LParen or kind == TokenKind.LBracket)
                    depth <- depth - 1 if saw_arrow and (kind == TokenKind.RParen or kind == TokenKind.RBracket) and depth > 0
                    if saw_arrow and kind != TokenKind.Arrow:
                        result_end <- token.start.usize() + token.length.usize()
                    offset <- offset + 1
                return Lexer::source_view_or_empty(parser.source, result_start, result_end) if saw_arrow else sview("", 0, 0)
