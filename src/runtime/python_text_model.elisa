# Python-compatible Unicode whitespace rules for text boundary operations.
# Invalid UTF-8 bytes are retained as non-whitespace; strict-decoding callers
# should validate before invoking these operations when Python parity requires it.

module EsPythonText:
    private:
        const module PythonWhitespace:
            NEXT_LINE: u32 = 133u32
            NO_BREAK_SPACE: u32 = 160u32
            OGHAM_SPACE_MARK: u32 = 5760u32
            LINE_SEPARATOR: u32 = 8232u32
            PARAGRAPH_SEPARATOR: u32 = 8233u32
            NARROW_NO_BREAK_SPACE: u32 = 8239u32
            MEDIUM_MATHEMATICAL_SPACE: u32 = 8287u32
            IDEOGRAPHIC_SPACE: u32 = 12288u32


        def python_text_unicode_whitespace(codepoint: u32) -> bool:
            return true if codepoint >= 9u32 and codepoint <= 13u32
            return true if codepoint >= 28u32 and codepoint <= 32u32
            return true if codepoint == PythonWhitespace::NEXT_LINE or codepoint == PythonWhitespace::NO_BREAK_SPACE or codepoint == PythonWhitespace::OGHAM_SPACE_MARK
            return true if codepoint >= 8192u32 and codepoint <= 8202u32
            return true if codepoint == PythonWhitespace::LINE_SEPARATOR or codepoint == PythonWhitespace::PARAGRAPH_SEPARATOR or codepoint == PythonWhitespace::NARROW_NO_BREAK_SPACE or codepoint == PythonWhitespace::MEDIUM_MATHEMATICAL_SPACE or codepoint == PythonWhitespace::IDEOGRAPHIC_SPACE
            return false


        # Return the next UTF-8 boundary. On malformed input, advance one byte
        # as a non-whitespace replacement scalar so trimming never drops data.
        def python_text_decode_next(value: sview, cursor: mutable usize&, codepoint: mutable u32&) -> void:
            first: u8 = sview_at(value, cursor)
            width: mutable usize = 1
            if first <= 127u8:
                codepoint <- first.u32()
            elif first >= 194u8 and first <= 223u8 and len(value) - cursor >= 2:
                second: u8 = sview_at(value, cursor + 1)
                if second < 128u8 or second > 191u8:
                    codepoint <- 65533u32
                    cursor <- cursor + 1
                    return
                codepoint <- ((first & 31u8).u32() << 6) | (second & 63u8).u32()
                width <- 2
            elif first >= 224u8 and first <= 239u8 and len(value) - cursor >= 3:
                second: u8 = sview_at(value, cursor + 1)
                third: u8 = sview_at(value, cursor + 2)
                if second < 128u8 or second > 191u8 or third < 128u8 or third > 191u8:
                    codepoint <- 65533u32
                    cursor <- cursor + 1
                    return
                scalar_three: u32 = ((first & 15u8).u32() << 12) | ((second & 63u8).u32() << 6) | (third & 63u8).u32()
                if scalar_three < 2048u32 or scalar_three >= 55296u32 and scalar_three <= 57343u32:
                    codepoint <- 65533u32
                    cursor <- cursor + 1
                    return
                codepoint <- scalar_three
                width <- 3
            elif first >= 240u8 and first <= 244u8 and len(value) - cursor >= 4:
                second: u8 = sview_at(value, cursor + 1)
                third: u8 = sview_at(value, cursor + 2)
                fourth: u8 = sview_at(value, cursor + 3)
                if second < 128u8 or second > 191u8 or third < 128u8 or third > 191u8 or fourth < 128u8 or fourth > 191u8:
                    codepoint <- 65533u32
                    cursor <- cursor + 1
                    return
                scalar_four: u32 = ((first & 7u8).u32() << 18) | ((second & 63u8).u32() << 12) | ((third & 63u8).u32() << 6) | (fourth & 63u8).u32()
                if scalar_four < 65536u32 or scalar_four > 1114111u32:
                    codepoint <- 65533u32
                    cursor <- cursor + 1
                    return
                codepoint <- scalar_four
                width <- 4
            else:
                codepoint <- 65533u32
                cursor <- cursor + 1
                return
            cursor <- cursor + width


    public:
        # mode: 0 = both ends, 1 = left, 2 = right, matching TrimText.
        def trim_unicode_whitespace(value: sview, mode: i64) -> sview:
            low: mutable usize = 0
            high: mutable usize = len(value)
            if mode != 2:
                while low < high:
                    cursor: mutable usize = low
                    codepoint: mutable u32 = 0u32
                    python_text_decode_next(value, cursor, codepoint)
                    if not python_text_unicode_whitespace(codepoint):
                        break
                    low <- cursor
            if mode != 1:
                cursor: mutable usize = low
                last_nonspace_end: mutable usize = low
                while cursor < high:
                    codepoint: mutable u32 = 0u32
                    python_text_decode_next(value, cursor, codepoint)
                    if not python_text_unicode_whitespace(codepoint):
                        last_nonspace_end <- cursor
                high <- last_nonspace_end
            return value[low:high]
