# Typed schema-binding contract for structured input.
#
# Schema binding is deliberately separate from parsing. A JSON/CSV adapter
# supplies bounded source values; this module checks that each declared field
# receives the expected kind before application code can observe it. No
# unchecked cast or host-language default is part of this boundary.

module EsSchema:
    using EsJson
    using EsEncoding

    public:
        const SCHEMA_FORMAT_VERSION: u8 = 1
        const SCHEMA_MAX_FIELDS: usize = 1048576
        const SCHEMA_MAX_TYPES: usize = 1048576
        const SCHEMA_MAX_NESTED_FIELDS: usize = 1048576
        const SCHEMA_MAX_NAME_BYTES: usize = 4096
        const SCHEMA_MAX_TOTAL_NAME_BYTES: usize = 67108864
        const SCHEMA_SOURCE_INDEX_AUTO: usize = 4294967295
        const SCHEMA_TYPE_INDEX_NONE: usize = 4294967295


        const enum SchemaSource of u8:
            Json
            Csv
            Tsv
            Toml


        const enum SchemaValueKind of u8:
            Null
            Bool
            Number
            Text
            Array
            Object
            Any


        const enum SchemaIntegerTarget of u8:
            None
            I8
            I16
            I32
            I64
            U8
            U16
            U32
            U64


        const enum SchemaDecimalTarget of u8:
            None
            Exact


        struct SchemaIntegerValue:
            target: SchemaIntegerTarget = SchemaIntegerTarget.None
            signed_value: i64 = 0
            unsigned_value: u64 = 0


        # Signed coefficient * 10^-scale. Coefficient digits are owned ASCII
        # decimal digits; leading/trailing zeros and the sign of zero are preserved.
        struct SchemaDecimalValue:
            negative: bool = false
            coefficient_digits: darray[u8] = []
            scale: i64 = 0


        # Indexed schema graph. Recursive references are valid: runtime walks
        # finite input values iteratively under the JSON depth/node limits.
        struct SchemaTypeNode:
            kind: SchemaValueKind
            integer_target: SchemaIntegerTarget = SchemaIntegerTarget.None
            decimal_target: SchemaDecimalTarget = SchemaDecimalTarget.None
            array_item_type_index: usize = SCHEMA_TYPE_INDEX_NONE
            object_field_start: usize = SCHEMA_TYPE_INDEX_NONE
            object_field_count: usize = 0
            allow_unknown: bool = false


        # Object fields are grouped by SchemaTypeNode range and stored in
        # strictly increasing effective-source-name order for bounded lookup.
        struct SchemaNestedField:
            name: sview
            source_name: sview = ""
            required: bool = true
            type_index: usize = SCHEMA_TYPE_INDEX_NONE


        const enum SchemaDecodeState of u8:
            Ready
            Binding
            Complete
            Failed


        const enum SchemaDecodeEvent of u8:
            Begin
            Bind
            Complete
            Fail


        struct SchemaField:
            name: sview
            kind: SchemaValueKind
            source_name: sview = ""
            source_index: usize = SCHEMA_SOURCE_INDEX_AUTO
            required: bool = true
            integer_target: SchemaIntegerTarget = SchemaIntegerTarget.None
            decimal_target: SchemaDecimalTarget = SchemaDecimalTarget.None
            # NONE preserves the legacy shallow kind/target declaration.
            type_index: usize = SCHEMA_TYPE_INDEX_NONE


        struct SchemaDescriptor:
            format_version: u8 = SCHEMA_FORMAT_VERSION
            name: sview
            source: SchemaSource
            fields: darray[SchemaField] = []
            allow_unknown: bool = false
            types: darray[SchemaTypeNode] = []
            nested_fields: darray[SchemaNestedField] = []


        struct SchemaBinding:
            field_index: usize
            node_index: usize
            present: bool = true


        struct SchemaDecodeSession:
            schema: SchemaDescriptor
            state: SchemaDecodeState = SchemaDecodeState.Ready
            input_nodes: darray[JsonNode] = []
            bindings: darray[SchemaBinding] = []
            bound_fields: usize = 0


        error SchemaContractError:
            InvalidFormatVersion
            InvalidSource
            InvalidValueKind
            InvalidIntegerTarget
            InvalidDecimalTarget
            ConflictingNumericTargets
            InvalidTypeLimit
            InvalidTypeReference
            InvalidTypeShape
            InvalidNestedFieldRange
            InvalidNestedFieldOrder
            InvalidState
            InvalidEvent
            InvalidName
            InvalidNameByteLimit
            InvalidFieldLimit
            DuplicateField
            DuplicateSourceName
            FieldIndexInvalid
            NodeIndexInvalid
            BindingLimitExceeded
            BindingAccountingInvalid
            RequiredFieldMissing
            ValueKindMismatch
            PresenceInvalid
            BindNotReady
            CompleteNotReady


    private:
        const enum SchemaNameOrder of u8:
            Before
            Equal
            After


        def schema_source_valid(source: SchemaSource) -> bool:
            return source in {SchemaSource.Json, SchemaSource.Csv, SchemaSource.Tsv, SchemaSource.Toml}


        def schema_value_kind_valid(kind: SchemaValueKind) -> bool:
            return kind in {SchemaValueKind.Null, SchemaValueKind.Bool, SchemaValueKind.Number, SchemaValueKind.Text, SchemaValueKind.Array, SchemaValueKind.Object, SchemaValueKind.Any}


        def schema_integer_target_valid(target: SchemaIntegerTarget) -> bool:
            return target in {SchemaIntegerTarget.None, SchemaIntegerTarget.I8, SchemaIntegerTarget.I16, SchemaIntegerTarget.I32, SchemaIntegerTarget.I64, SchemaIntegerTarget.U8, SchemaIntegerTarget.U16, SchemaIntegerTarget.U32, SchemaIntegerTarget.U64}


        def schema_decimal_target_valid(target: SchemaDecimalTarget) -> bool:
            return target in {SchemaDecimalTarget.None, SchemaDecimalTarget.Exact}


        def schema_nested_field_source_name(field: SchemaNestedField) -> sview:
            return field.name if field.source_name == ""
            return field.source_name


        def schema_nested_field_name_order(schema: SchemaDescriptor&, left_index: usize, right_index: usize, effective_source: bool) -> SchemaNameOrder:
            left: SchemaNestedField = schema.nested_fields[left_index]
            right: SchemaNestedField = schema.nested_fields[right_index]
            left_name: sview = left.name
            right_name: sview = right.name
            if effective_source:
                left_name <- schema_nested_field_source_name(left)
                right_name <- schema_nested_field_source_name(right)
            return schema_name_order(left_name, right_name)


        def schema_sort_nested_field_indices(schema: SchemaDescriptor&, order: mutable darray[usize]&, scratch: mutable darray[usize]&) -> void:
            width: mutable usize = 1
            while width < order.count:
                start: mutable usize = 0
                while start < order.count:
                    middle: usize = start + width
                    middle <- order.count if middle > order.count
                    end: usize = middle + width
                    end <- order.count if end > order.count
                    left: mutable usize = start
                    right: mutable usize = middle
                    destination: mutable usize = start
                    while destination < end:
                        if left == middle:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        elif right == end:
                            scratch[destination] <- order[left]
                            left <- left + 1
                        elif schema_nested_field_name_order(schema, order[left], order[right], false) != SchemaNameOrder.After:
                            scratch[destination] <- order[left]
                            left <- left + 1
                        else:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        destination <- destination + 1
                    start <- end
                for index in 0..<order.count |order, scratch|:
                    order[index] <- scratch[index]
                width <- order.count if width > order.count / 2 else width * 2


        def schema_nested_duplicate_names_rejected(schema: SchemaDescriptor&, order: darray[usize]) -> bool error[SchemaContractError]:
            for index in 1..<order.count |schema, order|:
                raise SchemaContractError.DuplicateField if schema_nested_field_name_order(schema, order[index - 1], order[index], false) == SchemaNameOrder.Equal
            return true


        def schema_state_valid(state: SchemaDecodeState) -> bool:
            return state in {SchemaDecodeState.Ready, SchemaDecodeState.Binding, SchemaDecodeState.Complete, SchemaDecodeState.Failed}


        def schema_event_valid(event: SchemaDecodeEvent) -> bool:
            return event in {SchemaDecodeEvent.Begin, SchemaDecodeEvent.Bind, SchemaDecodeEvent.Complete, SchemaDecodeEvent.Fail}


        def schema_name_valid(name: sview) -> bool:
            return false if sview_len(name) == 0 or sview_len(name) >= SCHEMA_MAX_NAME_BYTES or sview_contains_byte(name, 0)
            cursor: mutable Utf8Cursor = Utf8Cursor{}
            for offset in 0..<sview_len(name) |name, cursor|:
                return false if not utf8_feed(sview_at(name, offset), cursor)
            return utf8_complete(cursor)


        def schema_effective_source_name(field: SchemaField) -> sview:
            return field.name if field.source_name == ""
            return field.source_name


        def schema_name_order(left: sview, right: sview) -> SchemaNameOrder:
            left_length: usize = sview_len(left)
            right_length: usize = sview_len(right)
            common: usize = left_length if left_length < right_length else right_length
            for offset in 0..<common |left, right|:
                return SchemaNameOrder.Before if sview_at(left, offset) < sview_at(right, offset)
                return SchemaNameOrder.After if sview_at(left, offset) > sview_at(right, offset)
            return SchemaNameOrder.Equal if left_length == right_length
            return SchemaNameOrder.Before if left_length < right_length
            return SchemaNameOrder.After


        def schema_indexed_name(schema: SchemaDescriptor&, field_index: usize, effective_source: bool) -> sview:
            field: SchemaField = schema.fields[field_index]
            return schema_effective_source_name(field) if effective_source
            return field.name


        def schema_index_name_order(schema: SchemaDescriptor&, left_index: usize, right_index: usize, effective_source: bool) -> SchemaNameOrder:
            return schema_name_order(schema_indexed_name(schema, left_index, effective_source), schema_indexed_name(schema, right_index, effective_source))


        def schema_sort_field_indices(schema: SchemaDescriptor&, order: mutable darray[usize]&, scratch: mutable darray[usize]&, effective_source: bool) -> void:
            width: mutable usize = 1
            while width < order.count:
                start: mutable usize = 0
                while start < order.count:
                    middle: mutable usize = start + width
                    middle <- order.count if middle > order.count
                    end: mutable usize = middle + width
                    end <- order.count if end > order.count
                    left: mutable usize = start
                    right: mutable usize = middle
                    destination: mutable usize = start
                    while destination < end:
                        if left == middle:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        elif right == end:
                            scratch[destination] <- order[left]
                            left <- left + 1
                        elif schema_index_name_order(schema, order[left], order[right], effective_source) != SchemaNameOrder.After:
                            scratch[destination] <- order[left]
                            left <- left + 1
                        else:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        destination <- destination + 1
                    start <- end
                for index in 0..<order.count |order, scratch|:
                    order[index] <- scratch[index]
                width <- order.count if width > order.count / 2 else width * 2


        def schema_duplicate_names_rejected(schema: SchemaDescriptor&, order: darray[usize], effective_source: bool) -> bool error[SchemaContractError]:
            for index in 1..<order.count |schema, order, effective_source|:
                raise SchemaContractError.DuplicateSourceName if effective_source and schema_index_name_order(schema, order[index - 1], order[index], effective_source) == SchemaNameOrder.Equal
                raise SchemaContractError.DuplicateField if not effective_source and schema_index_name_order(schema, order[index - 1], order[index], effective_source) == SchemaNameOrder.Equal
            return true


        def schema_node_matches(kind: SchemaValueKind, node_kind: JsonNodeKind) -> bool:
            if kind == SchemaValueKind.Any:
                return true
            if kind == SchemaValueKind.Null:
                return node_kind == JsonNodeKind.Null
            if kind == SchemaValueKind.Bool:
                return node_kind == JsonNodeKind.Bool
            if kind == SchemaValueKind.Number:
                return node_kind == JsonNodeKind.Number
            if kind == SchemaValueKind.Text:
                return node_kind == JsonNodeKind.Text
            if kind == SchemaValueKind.Array:
                return node_kind == JsonNodeKind.Array
            return node_kind == JsonNodeKind.Object


        def schema_json_node_kind_valid(kind: JsonNodeKind) -> bool:
            return kind in {JsonNodeKind.Null, JsonNodeKind.Bool, JsonNodeKind.Number, JsonNodeKind.Text, JsonNodeKind.Array, JsonNodeKind.Object}


        def schema_field_valid(field: SchemaField) -> bool error[SchemaContractError]:
            raise SchemaContractError.InvalidName if not schema_name_valid(field.name)
            raise SchemaContractError.InvalidName if field.source_name != "" and not schema_name_valid(field.source_name)
            raise SchemaContractError.InvalidValueKind if not schema_value_kind_valid(field.kind)
            raise SchemaContractError.InvalidIntegerTarget if not schema_integer_target_valid(field.integer_target)
            raise SchemaContractError.InvalidDecimalTarget if not schema_decimal_target_valid(field.decimal_target)
            raise SchemaContractError.ConflictingNumericTargets if field.integer_target != SchemaIntegerTarget.None and field.decimal_target != SchemaDecimalTarget.None
            return true


        def schema_type_mark_reachable(types: darray[SchemaTypeNode]&, seen: mutable darray[bool]&, queue: mutable darray[usize]&, type_index: usize) -> void error[SchemaContractError] can[Memory.Allocate, Abort.Panic]:
            raise SchemaContractError.InvalidTypeReference if type_index >= types.count or type_index >= seen.count
            if not seen[type_index]:
                seen[type_index] <- true
                queue.push(type_index)


        def schema_type_graph_fully_reachable(schema: SchemaDescriptor&) -> bool error[SchemaContractError] can[Memory.Allocate, Abort.Panic]:
            seen: mutable darray[bool] = []
            queue: mutable darray[usize] = []
            for _ in 0..<schema.types.count |seen|:
                seen.push(false)
            for field in schema.fields |schema, seen, queue|:
                if field.type_index != SCHEMA_TYPE_INDEX_NONE:
                    try schema_type_mark_reachable(schema.types, seen, queue, field.type_index)
            cursor: mutable usize = 0
            while cursor < queue.count:
                type_node: SchemaTypeNode = schema.types[queue[cursor]]
                if type_node.kind == SchemaValueKind.Array:
                    try schema_type_mark_reachable(schema.types, seen, queue, type_node.array_item_type_index)
                elif type_node.kind == SchemaValueKind.Object and type_node.object_field_count != 0:
                    for nested_index in type_node.object_field_start..<(type_node.object_field_start + type_node.object_field_count) |schema, seen, queue|:
                        try schema_type_mark_reachable(schema.types, seen, queue, schema.nested_fields[nested_index].type_index)
                cursor <- cursor + 1
            return queue.count == schema.types.count


    public:
        def validate_schema_descriptor(schema: SchemaDescriptor&) -> bool error[SchemaContractError] can[Memory.Allocate, Abort.Panic]:
            raise SchemaContractError.InvalidFormatVersion if schema.format_version != SCHEMA_FORMAT_VERSION
            raise SchemaContractError.InvalidName if not schema_name_valid(schema.name)
            raise SchemaContractError.InvalidSource if not schema_source_valid(schema.source)
            raise SchemaContractError.InvalidFieldLimit if schema.fields.count == 0 or schema.fields.count > SCHEMA_MAX_FIELDS
            raise SchemaContractError.InvalidTypeLimit if schema.types.count > SCHEMA_MAX_TYPES or schema.nested_fields.count > SCHEMA_MAX_NESTED_FIELDS
            name_bytes: mutable usize = sview_len(schema.name)
            raise SchemaContractError.InvalidNameByteLimit if name_bytes > SCHEMA_MAX_TOTAL_NAME_BYTES
            raise SchemaContractError.InvalidSource if schema.source != SchemaSource.Json and (schema.types.count != 0 or schema.nested_fields.count != 0)
            for field in schema.fields |name_bytes|:
                try schema_field_valid(field)
                raise SchemaContractError.InvalidNameByteLimit if sview_len(field.name) > SCHEMA_MAX_TOTAL_NAME_BYTES - name_bytes
                name_bytes <- name_bytes + sview_len(field.name)
                if field.source_name != "":
                    raise SchemaContractError.InvalidNameByteLimit if sview_len(field.source_name) > SCHEMA_MAX_TOTAL_NAME_BYTES - name_bytes
                    name_bytes <- name_bytes + sview_len(field.source_name)
                numeric_source: bool = schema.source == SchemaSource.Json or schema.source == SchemaSource.Toml
                raise SchemaContractError.InvalidIntegerTarget if field.integer_target != SchemaIntegerTarget.None and numeric_source and field.kind != SchemaValueKind.Number
                raise SchemaContractError.InvalidIntegerTarget if field.integer_target != SchemaIntegerTarget.None and not numeric_source and field.kind != SchemaValueKind.Text
                raise SchemaContractError.InvalidDecimalTarget if field.decimal_target != SchemaDecimalTarget.None and numeric_source and field.kind != SchemaValueKind.Number
                raise SchemaContractError.InvalidDecimalTarget if field.decimal_target != SchemaDecimalTarget.None and not numeric_source and field.kind != SchemaValueKind.Text
                if field.type_index != SCHEMA_TYPE_INDEX_NONE:
                    raise SchemaContractError.InvalidSource if schema.source != SchemaSource.Json
                    raise SchemaContractError.InvalidTypeReference if field.type_index >= schema.types.count
                    type_node: SchemaTypeNode = schema.types[field.type_index]
                    raise SchemaContractError.InvalidTypeShape if type_node.kind != field.kind or type_node.integer_target != field.integer_target or type_node.decimal_target != field.decimal_target

            expected_nested_field_start: mutable usize = 0
            nested_order_indices: mutable darray[usize] = []
            nested_scratch_indices: mutable darray[usize] = []
            for type_index in 0..<schema.types.count |schema, expected_nested_field_start, nested_order_indices, nested_scratch_indices|:
                type_node: SchemaTypeNode = schema.types[type_index]
                raise SchemaContractError.InvalidValueKind if not schema_value_kind_valid(type_node.kind) or type_node.kind == SchemaValueKind.Any
                raise SchemaContractError.InvalidIntegerTarget if not schema_integer_target_valid(type_node.integer_target)
                raise SchemaContractError.InvalidDecimalTarget if not schema_decimal_target_valid(type_node.decimal_target)
                raise SchemaContractError.ConflictingNumericTargets if type_node.integer_target != SchemaIntegerTarget.None and type_node.decimal_target != SchemaDecimalTarget.None
                raise SchemaContractError.InvalidIntegerTarget if type_node.integer_target != SchemaIntegerTarget.None and type_node.kind != SchemaValueKind.Number
                raise SchemaContractError.InvalidDecimalTarget if type_node.decimal_target != SchemaDecimalTarget.None and type_node.kind != SchemaValueKind.Number
                if type_node.kind == SchemaValueKind.Array:
                    raise SchemaContractError.InvalidTypeReference if type_node.array_item_type_index == SCHEMA_TYPE_INDEX_NONE or type_node.array_item_type_index >= schema.types.count
                    raise SchemaContractError.InvalidTypeShape if type_node.object_field_start != SCHEMA_TYPE_INDEX_NONE or type_node.object_field_count != 0 or type_node.allow_unknown
                elif type_node.kind == SchemaValueKind.Object:
                    raise SchemaContractError.InvalidTypeShape if type_node.array_item_type_index != SCHEMA_TYPE_INDEX_NONE
                    if type_node.object_field_count == 0:
                        raise SchemaContractError.InvalidNestedFieldRange if type_node.object_field_start != SCHEMA_TYPE_INDEX_NONE
                    else:
                        raise SchemaContractError.InvalidNestedFieldRange if type_node.object_field_start != expected_nested_field_start
                        raise SchemaContractError.InvalidNestedFieldRange if type_node.object_field_start > schema.nested_fields.count
                        raise SchemaContractError.InvalidNestedFieldRange if type_node.object_field_count > schema.nested_fields.count - type_node.object_field_start
                        range_end: usize = type_node.object_field_start + type_node.object_field_count
                        for field_index in type_node.object_field_start..<range_end |schema|:
                            nested_field: SchemaNestedField = schema.nested_fields[field_index]
                            raise SchemaContractError.InvalidName if not schema_name_valid(nested_field.name)
                            raise SchemaContractError.InvalidName if nested_field.source_name != "" and not schema_name_valid(nested_field.source_name)
                            raise SchemaContractError.InvalidNameByteLimit if sview_len(nested_field.name) > SCHEMA_MAX_TOTAL_NAME_BYTES - name_bytes
                            name_bytes <- name_bytes + sview_len(nested_field.name)
                            if nested_field.source_name != "":
                                raise SchemaContractError.InvalidNameByteLimit if sview_len(nested_field.source_name) > SCHEMA_MAX_TOTAL_NAME_BYTES - name_bytes
                                name_bytes <- name_bytes + sview_len(nested_field.source_name)
                            raise SchemaContractError.InvalidTypeReference if nested_field.type_index == SCHEMA_TYPE_INDEX_NONE or nested_field.type_index >= schema.types.count
                            if field_index > type_node.object_field_start:
                                order: SchemaNameOrder = schema_nested_field_name_order(schema, field_index - 1, field_index, true)
                                raise SchemaContractError.DuplicateSourceName if order == SchemaNameOrder.Equal
                                raise SchemaContractError.InvalidNestedFieldOrder if order != SchemaNameOrder.Before
                        nested_order_indices.truncate(0)
                        nested_scratch_indices.truncate(0)
                        for field_index in type_node.object_field_start..<range_end |nested_order_indices, nested_scratch_indices|:
                            nested_order_indices.push(field_index)
                            nested_scratch_indices.push(field_index)
                        schema_sort_nested_field_indices(schema, nested_order_indices, nested_scratch_indices)
                        try schema_nested_duplicate_names_rejected(schema, nested_order_indices)
                        expected_nested_field_start <- range_end
                else:
                    raise SchemaContractError.InvalidTypeShape if type_node.array_item_type_index != SCHEMA_TYPE_INDEX_NONE or type_node.object_field_start != SCHEMA_TYPE_INDEX_NONE or type_node.object_field_count != 0 or type_node.allow_unknown
            raise SchemaContractError.InvalidNestedFieldRange if expected_nested_field_start != schema.nested_fields.count
            type_graph_reachable: bool = try schema_type_graph_fully_reachable(schema)
            raise SchemaContractError.InvalidTypeReference if not type_graph_reachable

            order: mutable darray[usize] = []
            scratch: mutable darray[usize] = []
            for index in 0..<schema.fields.count |order, scratch|:
                order.push(index)
                scratch.push(index)
            schema_sort_field_indices(schema, order, scratch, false)
            try schema_duplicate_names_rejected(schema, order, false)
            for index in 0..<order.count |order|:
                order[index] <- index
            schema_sort_field_indices(schema, order, scratch, true)
            try schema_duplicate_names_rejected(schema, order, true)
            return true


        def validate_schema_session(session: SchemaDecodeSession&) -> bool error[SchemaContractError] can[Memory.Allocate, Abort.Panic]:
            try validate_schema_descriptor(session.schema)
            raise SchemaContractError.InvalidState if not schema_state_valid(session.state)
            raise SchemaContractError.BindingLimitExceeded if session.bindings.count > session.schema.fields.count
            raise SchemaContractError.BindingAccountingInvalid if session.bound_fields != session.bindings.count
            raise SchemaContractError.InvalidState if session.state == SchemaDecodeState.Ready and (session.bindings.count != 0 or session.bound_fields != 0)
            for binding in session.bindings:
                raise SchemaContractError.FieldIndexInvalid if binding.field_index >= session.schema.fields.count
                raise SchemaContractError.NodeIndexInvalid if binding.node_index >= session.input_nodes.count
                raise SchemaContractError.PresenceInvalid if not binding.present
                field: SchemaField = session.schema.fields[binding.field_index]
                node: JsonNode = session.input_nodes[binding.node_index]
                raise SchemaContractError.InvalidValueKind if not schema_json_node_kind_valid(node.kind)
                raise SchemaContractError.ValueKindMismatch if not schema_node_matches(field.kind, node.kind)
            for index in 0..<session.bindings.count |session|:
                binding: SchemaBinding = session.bindings[index]
                for earlier in 0..<index |session, binding|:
                    raise SchemaContractError.DuplicateField if session.bindings[earlier].field_index == binding.field_index
            if session.state == SchemaDecodeState.Complete:
                for index in 0..<session.schema.fields.count |session|:
                    field: SchemaField = session.schema.fields[index]
                    if field.required:
                        present: mutable bool = false
                        for binding in session.bindings:
                            present <- true if binding.field_index == index
                        raise SchemaContractError.RequiredFieldMissing if not present
            return true


        def advance_schema_session(session: mutable SchemaDecodeSession&, event: SchemaDecodeEvent, binding: SchemaBinding = SchemaBinding{field_index: 0, node_index: 0}) -> SchemaDecodeState error[SchemaContractError] can[Memory.Allocate, Abort.Panic]:
            try validate_schema_session(session)
            raise SchemaContractError.InvalidEvent if not schema_event_valid(event)
            if event == SchemaDecodeEvent.Begin:
                raise SchemaContractError.InvalidState if session.state != SchemaDecodeState.Ready
                session.state <- SchemaDecodeState.Binding
            elif event == SchemaDecodeEvent.Bind:
                raise SchemaContractError.BindNotReady if session.state != SchemaDecodeState.Binding
                raise SchemaContractError.BindingLimitExceeded if session.bindings.count >= session.schema.fields.count
                raise SchemaContractError.FieldIndexInvalid if binding.field_index >= session.schema.fields.count
                raise SchemaContractError.NodeIndexInvalid if binding.node_index >= session.input_nodes.count
                raise SchemaContractError.PresenceInvalid if not binding.present
                field: SchemaField = session.schema.fields[binding.field_index]
                node: JsonNode = session.input_nodes[binding.node_index]
                raise SchemaContractError.InvalidValueKind if not schema_json_node_kind_valid(node.kind)
                raise SchemaContractError.ValueKindMismatch if not schema_node_matches(field.kind, node.kind)
                for earlier in session.bindings:
                    raise SchemaContractError.DuplicateField if earlier.field_index == binding.field_index
                session.bindings.push(binding)
                session.bound_fields <- session.bound_fields + 1
            elif event == SchemaDecodeEvent.Complete:
                raise SchemaContractError.CompleteNotReady if session.state != SchemaDecodeState.Binding
                for index in 0..<session.schema.fields.count |session|:
                    field: SchemaField = session.schema.fields[index]
                    if field.required:
                        present: mutable bool = false
                        for binding_entry in session.bindings:
                            present <- true if binding_entry.field_index == index
                        raise SchemaContractError.RequiredFieldMissing if not present
                session.state <- SchemaDecodeState.Complete
            elif event == SchemaDecodeEvent.Fail:
                raise SchemaContractError.BindNotReady if session.state != SchemaDecodeState.Binding
                session.state <- SchemaDecodeState.Failed
            return session.state
