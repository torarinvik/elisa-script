# Pure launcher-script rendering for the Elisa Engine macOS app packager.

module EsMacosAppLauncher:
    public:
        error MacosAppLauncherError:
            InvalidBinaryName


    private:
        const module LauncherAssets:
            SHADER_MANIFEST_NAME: sview = "elisa.shader-manifest.json"


        def macos_app_launcher_safe_binary_byte(byte: u8) -> bool:
            return true if byte >= 48 and byte <= 57
            return true if byte >= 65 and byte <= 90
            return true if byte >= 97 and byte <= 122
            return byte == 32 or byte == 46 or byte == 95 or byte == 45


        def macos_app_launcher_binary_name_valid(binary_name: sview) -> bool:
            length: usize = sview_len(binary_name)
            return false if length <= 4
            return false if sview_at(binary_name, length - 4) != 46 or sview_at(binary_name, length - 3) != 98 or sview_at(binary_name, length - 2) != 105 or sview_at(binary_name, length - 1) != 110
            for byte in binary_name:
                return false if not macos_app_launcher_safe_binary_byte(byte)
            return true


        def macos_app_launcher_append_text(output: mutable darray[u8]&, text: sview) -> void can[Memory.Allocate, Abort.Panic]:
            for byte in text |output|:
                output.push(byte)


        def macos_app_launcher_shell_byte_is_safe(byte: u8) -> bool:
            return byte >= 48 and byte <= 57 or byte >= 65 and byte <= 90 or byte >= 97 and byte <= 122 or byte == 95 or byte == 64 or byte == 37 or byte == 43 or byte == 61 or byte == 58 or byte == 44 or byte == 46 or byte == 47 or byte == 45


        # Match shlex.quote's POSIX safe-byte set and apostrophe escaping.
        def macos_app_launcher_append_shell_quote(output: mutable darray[u8]&, value: sview) -> void can[Memory.Allocate, Abort.Panic]:
            safe: mutable bool = true
            for byte in value |safe|:
                safe <- false if not macos_app_launcher_shell_byte_is_safe(byte)
            if safe and sview_len(value) > 0:
                try macos_app_launcher_append_text(output, value)
                return
            if sview_len(value) == 0:
                try macos_app_launcher_append_text(output, "''")
                return
            try macos_app_launcher_append_text(output, "'")
            for byte in value |output|:
                if byte == 39:
                    try macos_app_launcher_append_text(output, "'\"'\"'")
                else:
                    output.push(byte)
            try macos_app_launcher_append_text(output, "'")


        def macos_app_launcher_append_default(output: mutable darray[u8]&, variable: sview, value: sview) -> void can[Memory.Allocate, Abort.Panic]:
            try macos_app_launcher_append_text(output, ": \"${")
            try macos_app_launcher_append_text(output, variable)
            try macos_app_launcher_append_text(output, ":=")
            try macos_app_launcher_append_shell_quote(output, value)
            try macos_app_launcher_append_text(output, "}\"\n")


    public:
        # `binary_name` is the packager-generated safe bundle name plus `.bin`.
        # Validate that restricted domain because the reference launcher embeds
        # this value inside a double-quoted shell word rather than shell-quoting it.
        def macos_app_launcher_text(binary_name: sview, title: sview, width: usize, height: usize, identity: sview) -> darray[u8] error[MacosAppLauncherError] can[Memory.Allocate, Abort.Panic]:
            raise MacosAppLauncherError.InvalidBinaryName if not macos_app_launcher_binary_name_valid(binary_name)
            output: mutable darray[u8] = []
            try macos_app_launcher_append_text(output, "#!/bin/sh\nset -eu\nresources=\"$(CDPATH= cd -- \"$(dirname -- \"$0\")/../Resources\" && pwd)\"\ncd \"$resources\"\n")
            try macos_app_launcher_append_default(output, "ELISA_PROJECT_TITLE", title)
            try macos_app_launcher_append_default(output, "ELISA_PROJECT_WIDTH", f"{width}")
            try macos_app_launcher_append_default(output, "ELISA_PROJECT_HEIGHT", f"{height}")
            try macos_app_launcher_append_text(output, "export ELISA_PROJECT_TITLE ELISA_PROJECT_WIDTH ELISA_PROJECT_HEIGHT\nif [ -d \"$resources/shaders\" ]; then\n    ELISA_ENGINE_SHADER_PATH=\"$resources/shaders\"\n    export ELISA_ENGINE_SHADER_PATH\n    if [ -f \"$resources/shaders/")
            try macos_app_launcher_append_text(output, LauncherAssets::SHADER_MANIFEST_NAME)
            try macos_app_launcher_append_text(output, "\" ]; then\n        ELISA_ENGINE_SHADER_MANIFEST=\"$resources/shaders/")
            try macos_app_launcher_append_text(output, LauncherAssets::SHADER_MANIFEST_NAME)
            try macos_app_launcher_append_text(output, "\"\n        export ELISA_ENGINE_SHADER_MANIFEST\n    fi\nfi\n")
            if identity != "":
                try macos_app_launcher_append_text(output, "echo ")
                try macos_app_launcher_append_shell_quote(output, identity)
                try macos_app_launcher_append_text(output, " >&2\n")
            try macos_app_launcher_append_text(output, "exec \"$resources/")
            try macos_app_launcher_append_text(output, binary_name)
            try macos_app_launcher_append_text(output, "\" \"$@\"\n")
            return output
