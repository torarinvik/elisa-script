# Bounded POSIX loader for the Elisa Engine macOS app manifest.

module EsMacosAppManifestFile:
    using EsData
    using EsJson
    using EsJsonLex
    using EsJsonParse
    using EsBoundedText
    using EsMacosAppManifest

    public:
        const module Limits:
            INPUT_BYTES: usize = 16777216


        struct DecodedMacosAppManifest:
            settings: MacosAppSettings
            paths: MacosAppPathSelection


        def decode_macos_app_manifest(source: sview, project_name: sview) -> DecodedMacosAppManifest error[JsonLexError, JsonParseError, JsonContractError, MacosAppManifestError] can[Memory.Allocate, Abort.Panic]:
            policy: JsonPolicy = JsonPolicy{duplicate_keys: JsonDuplicateKeyPolicy.KeepLast}
            lexed: JsonLexedSource = try lex_json(source, DataDecodeLimits{input_bytes: Limits::INPUT_BYTES}, policy)
            document: JsonDocument = try parse_json_document(lexed)
            settings: MacosAppSettings = try decode_macos_app_settings(document, project_name)
            paths: MacosAppPathSelection = try decode_macos_app_path_selection(document)
            return DecodedMacosAppManifest{settings: settings, paths: paths}


        # Python's load_project_manifest() treats a missing or non-file
        # manifest as an empty object. The project path is expected to be the
        # already-selected project spelling; the package driver resolves it
        # before loading settings.
        def load_macos_app_manifest(project: Path) -> DecodedMacosAppManifest error[ReadError, JsonLexError, JsonParseError, JsonContractError, MacosAppManifestError] can[Blocking.IO, File.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            manifest_path: Path = project.joinpath("elisa.project.json")
            present: bool = try is_file(manifest_path) else false
            source: mutable sview = "{}"
            if present:
                source <- try read_utf8(manifest_path, Limits::INPUT_BYTES)
            return try decode_macos_app_manifest(source, project.name())
