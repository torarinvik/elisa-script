# Narrow POSIX environment bridge. Higher layers provide typed effects, errors,
# owned text, and NUL validation rather than exposing process-global C pointers.

@link_name(getenv)
extern elisascript_posix_getenv(name: cstr) -> u8&?

@link_name(setenv)
extern elisascript_posix_setenv(name: cstr, value: cstr, overwrite: int) -> int

@link_name(unsetenv)
extern elisascript_posix_unsetenv(name: cstr) -> int
