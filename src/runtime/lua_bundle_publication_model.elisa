# Pure publication admission contract for Lua bundle metadata.
#
# The host adapter still owns descriptor-relative creation, writes, fsync,
# rename, close, and cleanup. This state machine records the facts that must be
# acknowledged at each publication edge. The existing path-only
# `file_stream_publish_staged` helper cannot consume these descriptor proofs and
# must not be treated as the secure adapter for this contract.

module EsLuaBundlePublication:
    public:
        const module Limits:
            BYTES: usize = 67108864
            PATH_BYTES: usize = 4096


        const enum PublicationState of u8:
            Planned
            Staging
            Staged
            Publishing
            Published
            PublishedUncertain
            CleanupUncertain
            Failed
            Cancelling
            Cancelled


        const enum PublicationEvent of u8:
            Begin
            StageCreated
            Write
            Sync
            Close
            CloseOutcomeUnknown
            Publish
            PublishFailed
            PublishAck
            OutcomeUnknown
            Fail
            Cancel
            CancelAck


        struct PublicationRequest:
            destination: sview
            staging: sview
            directory: sview = ""
            bytes: usize
            require_directory_sync: bool = true


        struct PublicationParentProof:
            device: u64
            inode: u64
            # Opaque host identity for the retained parent descriptor.
            descriptor_token: u64
            owner_token: u64
            directory: bool = false


        struct PublicationStagingProof:
            device: u64
            inode: u64
            parent_device: u64
            parent_inode: u64
            # Opaque host identity for the retained staging descriptor.
            descriptor_token: u64
            owner_token: u64
            link_count: usize
            regular: bool = false
            private_mode: bool = false


        struct PublicationSession:
            request: PublicationRequest
            state: PublicationState = PublicationState.Planned
            parent_proof: PublicationParentProof = PublicationParentProof{device: 0, inode: 0, descriptor_token: 0, owner_token: 0}
            staging_proof: PublicationStagingProof = PublicationStagingProof{device: 0, inode: 0, parent_device: 0, parent_inode: 0, descriptor_token: 0, owner_token: 0, link_count: 0}
            staging_sibling: bool = false
            staging_exclusive: bool = false
            # Both descriptors remain live through publication. A successful
            # Close acknowledges both; ambiguous per-descriptor close outcomes
            # are recorded separately and freeze the session.
            parent_descriptor_owned: bool = false
            parent_descriptor_closed: bool = false
            parent_descriptor_close_uncertain: bool = false
            # These two fields describe the staging descriptor.
            descriptor_owned: bool = false
            descriptor_closed: bool = false
            descriptor_close_uncertain: bool = false
            bytes_written: usize = 0
            stage_synced: bool = false
            rename_acknowledged: bool = false
            directory_synced: bool = false
            destination_preserved_on_failure: bool = true


        error PublicationError:
            InvalidState
            InvalidEvent
            InvalidRequest
            InvalidPath
            PathCollision
            BytesInvalid
            StageAdmissionMissing
            DescriptorOwnershipMissing
            ParentIdentityMissing
            StagingIdentityMissing
            OwnerMismatch
            ParentMismatch
            DescriptorCollision
            StagingIdentityInvalid
            WriteNotReady
            WriteLimitExceeded
            SyncNotReady
            CloseNotReady
            PublishNotReady
            RenameAckMissing
            DirectorySyncMissing
            DestinationNotPreserved
            PublicationUncertain
            CleanupUncertain
            CancelNotReady
            AccountingInvalid


    private:
        def publication_state_valid(state: PublicationState) -> bool:
            return state in {PublicationState.Planned, PublicationState.Staging, PublicationState.Staged, PublicationState.Publishing, PublicationState.Published, PublicationState.PublishedUncertain, PublicationState.CleanupUncertain, PublicationState.Failed, PublicationState.Cancelling, PublicationState.Cancelled}


        def publication_event_valid(event: PublicationEvent) -> bool:
            return event in {PublicationEvent.Begin, PublicationEvent.StageCreated, PublicationEvent.Write, PublicationEvent.Sync, PublicationEvent.Close, PublicationEvent.CloseOutcomeUnknown, PublicationEvent.Publish, PublicationEvent.PublishFailed, PublicationEvent.PublishAck, PublicationEvent.OutcomeUnknown, PublicationEvent.Fail, PublicationEvent.Cancel, PublicationEvent.CancelAck}


        def publication_path_valid(path: sview, optional: bool) -> bool:
            return optional if path == "" else sview_len(path) < Limits::PATH_BYTES and not sview_contains_byte(path, 0)


        def publication_request_valid(request: PublicationRequest) -> bool error[PublicationError]:
            raise PublicationError.InvalidPath if not publication_path_valid(request.destination, false) or not publication_path_valid(request.staging, false) or not publication_path_valid(request.directory, true)
            raise PublicationError.PathCollision if request.destination == request.staging
            raise PublicationError.BytesInvalid if request.bytes == 0 or request.bytes > Limits::BYTES
            raise PublicationError.InvalidRequest if request.require_directory_sync and request.directory == ""
            return true


        def publication_parent_proof_valid(proof: PublicationParentProof) -> bool:
            return proof.device != 0 and proof.inode != 0 and proof.descriptor_token != 0 and proof.owner_token != 0 and proof.directory


        def publication_parent_proof_identity_present(proof: PublicationParentProof) -> bool:
            return proof.device != 0 and proof.inode != 0 and proof.descriptor_token != 0 and proof.owner_token != 0


        def publication_staging_proof_valid(proof: PublicationStagingProof) -> bool:
            return proof.device != 0 and proof.inode != 0 and proof.parent_device != 0 and proof.parent_inode != 0 and proof.descriptor_token != 0 and proof.owner_token != 0 and proof.link_count == 1 and proof.regular and proof.private_mode


        def publication_staging_proof_identity_present(proof: PublicationStagingProof) -> bool:
            return proof.device != 0 and proof.inode != 0 and proof.parent_device != 0 and proof.parent_inode != 0 and proof.descriptor_token != 0 and proof.owner_token != 0


        def publication_parent_proof_empty(proof: PublicationParentProof) -> bool:
            return proof.device == 0 and proof.inode == 0 and proof.descriptor_token == 0 and proof.owner_token == 0 and not proof.directory


        def publication_staging_proof_empty(proof: PublicationStagingProof) -> bool:
            return proof.device == 0 and proof.inode == 0 and proof.parent_device == 0 and proof.parent_inode == 0 and proof.descriptor_token == 0 and proof.owner_token == 0 and proof.link_count == 0 and not proof.regular and not proof.private_mode


        def publication_identity_proofs_valid(parent: PublicationParentProof, staging: PublicationStagingProof) -> bool:
            return publication_parent_proof_valid(parent) and publication_staging_proof_valid(staging) and parent.owner_token == staging.owner_token and parent.device == staging.device and parent.device == staging.parent_device and parent.inode == staging.parent_inode and parent.descriptor_token != staging.descriptor_token


    public:
        def validate_publication(session: PublicationSession&) -> bool error[PublicationError]:
            raise PublicationError.InvalidState if not publication_state_valid(session.state)
            try publication_request_valid(session.request)
            raise PublicationError.BytesInvalid if session.bytes_written > session.request.bytes
            raise PublicationError.AccountingInvalid if session.parent_descriptor_owned and session.parent_descriptor_closed
            raise PublicationError.AccountingInvalid if session.descriptor_owned and session.descriptor_closed
            raise PublicationError.AccountingInvalid if session.parent_descriptor_close_uncertain and (session.parent_descriptor_owned or session.parent_descriptor_closed)
            raise PublicationError.AccountingInvalid if session.descriptor_close_uncertain and (session.descriptor_owned or session.descriptor_closed)
            raise PublicationError.AccountingInvalid if (session.state == PublicationState.CleanupUncertain) != (session.parent_descriptor_close_uncertain or session.descriptor_close_uncertain)
            raise PublicationError.AccountingInvalid if session.stage_synced and session.bytes_written != session.request.bytes
            raise PublicationError.StageAdmissionMissing if (session.state == PublicationState.Staged or session.state == PublicationState.Publishing or session.state == PublicationState.Published or session.state == PublicationState.PublishedUncertain) and (not session.staging_sibling or not session.staging_exclusive)
            raise PublicationError.SyncNotReady if (session.state == PublicationState.Staged or session.state == PublicationState.Publishing or session.state == PublicationState.Published or session.state == PublicationState.PublishedUncertain) and not session.stage_synced
            raise PublicationError.ParentIdentityMissing if (session.state == PublicationState.Staged or session.state == PublicationState.Publishing or session.state == PublicationState.Published or session.state == PublicationState.PublishedUncertain) and not publication_parent_proof_valid(session.parent_proof)
            raise PublicationError.StagingIdentityMissing if (session.state == PublicationState.Staged or session.state == PublicationState.Publishing or session.state == PublicationState.Published or session.state == PublicationState.PublishedUncertain) and not publication_staging_proof_valid(session.staging_proof)
            raise PublicationError.OwnerMismatch if (session.state == PublicationState.Staged or session.state == PublicationState.Publishing or session.state == PublicationState.Published or session.state == PublicationState.PublishedUncertain) and not publication_identity_proofs_valid(session.parent_proof, session.staging_proof)
            raise PublicationError.StageAdmissionMissing if session.staging_sibling and not session.staging_exclusive
            raise PublicationError.StageAdmissionMissing if session.staging_exclusive and not session.staging_sibling
            raise PublicationError.AccountingInvalid if not session.staging_sibling and (session.staging_exclusive or not publication_parent_proof_empty(session.parent_proof) or not publication_staging_proof_empty(session.staging_proof) or session.parent_descriptor_owned or session.parent_descriptor_closed or session.parent_descriptor_close_uncertain or session.descriptor_owned or session.descriptor_closed or session.descriptor_close_uncertain or session.bytes_written != 0 or session.stage_synced)
            if session.staging_sibling:
                raise PublicationError.ParentIdentityMissing if not publication_parent_proof_valid(session.parent_proof)
                raise PublicationError.StagingIdentityMissing if not publication_staging_proof_valid(session.staging_proof)
                raise PublicationError.OwnerMismatch if not publication_identity_proofs_valid(session.parent_proof, session.staging_proof)
                raise PublicationError.DescriptorOwnershipMissing if not session.parent_descriptor_owned and not session.parent_descriptor_closed and not session.parent_descriptor_close_uncertain
                raise PublicationError.DescriptorOwnershipMissing if not session.descriptor_owned and not session.descriptor_closed and not session.descriptor_close_uncertain
            raise PublicationError.DescriptorOwnershipMissing if session.state == PublicationState.Publishing and (not session.parent_descriptor_owned or session.parent_descriptor_closed or not session.descriptor_owned or session.descriptor_closed)
            raise PublicationError.RenameAckMissing if session.state == PublicationState.Published and not session.rename_acknowledged
            raise PublicationError.DirectorySyncMissing if session.state == PublicationState.Published and session.request.require_directory_sync and not session.directory_synced
            raise PublicationError.AccountingInvalid if session.rename_acknowledged and session.state != PublicationState.Published and session.state != PublicationState.CleanupUncertain
            raise PublicationError.AccountingInvalid if session.directory_synced and not session.rename_acknowledged
            raise PublicationError.AccountingInvalid if session.state == PublicationState.Staging and session.stage_synced
            raise PublicationError.AccountingInvalid if session.state == PublicationState.PublishedUncertain and (not session.staging_sibling or not session.staging_exclusive or not session.stage_synced or session.rename_acknowledged or session.destination_preserved_on_failure)
            raise PublicationError.DescriptorOwnershipMissing if session.state == PublicationState.PublishedUncertain and not session.descriptor_owned and not session.descriptor_closed
            raise PublicationError.CleanupUncertain if session.state == PublicationState.CleanupUncertain and (session.descriptor_owned or session.parent_descriptor_owned)
            raise PublicationError.DestinationNotPreserved if (session.state == PublicationState.Failed or session.state == PublicationState.Cancelled) and not session.destination_preserved_on_failure
            raise PublicationError.AccountingInvalid if (session.state == PublicationState.Failed or session.state == PublicationState.Cancelled) and session.rename_acknowledged
            if session.state == PublicationState.Failed or session.state == PublicationState.Cancelled:
                raise PublicationError.DescriptorOwnershipMissing if session.staging_sibling and (session.parent_descriptor_owned or not session.parent_descriptor_closed or session.parent_descriptor_close_uncertain or session.descriptor_owned or not session.descriptor_closed or session.descriptor_close_uncertain)
            if session.state == PublicationState.Cancelling:
                raise PublicationError.DescriptorOwnershipMissing if session.staging_sibling and (session.parent_descriptor_owned or not session.parent_descriptor_closed or session.parent_descriptor_close_uncertain or session.descriptor_owned or not session.descriptor_closed or session.descriptor_close_uncertain)
            if session.state == PublicationState.Planned:
                raise PublicationError.AccountingInvalid if session.parent_proof.device != 0 or session.parent_proof.inode != 0 or session.parent_proof.descriptor_token != 0 or session.parent_proof.owner_token != 0 or session.staging_proof.device != 0 or session.staging_proof.inode != 0 or session.staging_proof.parent_device != 0 or session.staging_proof.parent_inode != 0 or session.staging_proof.descriptor_token != 0 or session.staging_proof.owner_token != 0 or session.staging_proof.link_count != 0 or session.staging_sibling or session.staging_exclusive or session.parent_descriptor_owned or session.parent_descriptor_closed or session.parent_descriptor_close_uncertain or session.descriptor_owned or session.descriptor_closed or session.descriptor_close_uncertain or session.bytes_written != 0 or session.stage_synced or session.rename_acknowledged or session.directory_synced
            return true


        def advance_publication(session: mutable PublicationSession&, event: PublicationEvent, bytes_delta: usize = 0, staging_sibling: bool = false, staging_exclusive: bool = false, descriptor_owned: bool = false, destination_preserved: bool = true, directory_synced: bool = false, parent_proof: PublicationParentProof = PublicationParentProof{device: 0, inode: 0, descriptor_token: 0, owner_token: 0}, staging_proof: PublicationStagingProof = PublicationStagingProof{device: 0, inode: 0, parent_device: 0, parent_inode: 0, descriptor_token: 0, owner_token: 0, link_count: 0}, parent_descriptor_owned: bool = false, stage_close_succeeded: bool = true, parent_close_succeeded: bool = true) -> PublicationState error[PublicationError] can[Memory.Allocate, Abort.Panic]:
            try validate_publication(session)
            raise PublicationError.InvalidEvent if not publication_event_valid(event)
            raise PublicationError.CleanupUncertain if session.state == PublicationState.CleanupUncertain
            if event == PublicationEvent.Begin:
                raise PublicationError.InvalidState if session.state != PublicationState.Planned
                session.state <- PublicationState.Staging
            elif event == PublicationEvent.StageCreated:
                raise PublicationError.InvalidState if session.state != PublicationState.Staging
                raise PublicationError.InvalidState if session.staging_sibling or session.staging_exclusive or session.parent_descriptor_owned or session.parent_descriptor_closed or session.parent_descriptor_close_uncertain or session.descriptor_owned or session.descriptor_closed or session.descriptor_close_uncertain
                raise PublicationError.StageAdmissionMissing if not staging_sibling or not staging_exclusive
                raise PublicationError.DescriptorOwnershipMissing if not descriptor_owned
                raise PublicationError.DescriptorOwnershipMissing if not parent_descriptor_owned
                raise PublicationError.ParentIdentityMissing if not publication_parent_proof_identity_present(parent_proof)
                raise PublicationError.StagingIdentityMissing if not publication_staging_proof_identity_present(staging_proof)
                raise PublicationError.StagingIdentityInvalid if not parent_proof.directory or not staging_proof.regular or not staging_proof.private_mode or staging_proof.link_count != 1
                raise PublicationError.ParentMismatch if parent_proof.device != staging_proof.device or parent_proof.device != staging_proof.parent_device or parent_proof.inode != staging_proof.parent_inode
                raise PublicationError.DescriptorCollision if parent_proof.descriptor_token == staging_proof.descriptor_token
                raise PublicationError.OwnerMismatch if not publication_identity_proofs_valid(parent_proof, staging_proof)
                session.staging_sibling <- true
                session.staging_exclusive <- true
                session.parent_descriptor_owned <- true
                session.descriptor_owned <- true
                session.parent_proof <- parent_proof
                session.staging_proof <- staging_proof
            elif event == PublicationEvent.Write:
                raise PublicationError.WriteNotReady if session.state != PublicationState.Staging or not session.staging_sibling or not session.staging_exclusive or not session.parent_descriptor_owned or session.parent_descriptor_closed or not session.descriptor_owned or session.descriptor_closed
                raise PublicationError.WriteLimitExceeded if bytes_delta == 0 or bytes_delta > session.request.bytes - session.bytes_written
                session.bytes_written <- session.bytes_written + bytes_delta
            elif event == PublicationEvent.Sync:
                raise PublicationError.SyncNotReady if session.state != PublicationState.Staging or not session.parent_descriptor_owned or session.parent_descriptor_closed or not session.descriptor_owned or session.descriptor_closed or session.bytes_written != session.request.bytes
                raise PublicationError.InvalidState if session.stage_synced
                session.stage_synced <- true
                session.state <- PublicationState.Staged
            elif event == PublicationEvent.Close:
                # This event acknowledges that both host close calls
                # succeeded. A mixed or ambiguous result uses the terminal
                # CloseOutcomeUnknown event instead.
                # A rename is in flight while Publishing. The host must first
                # report PublishAck or OutcomeUnknown; closing descriptors in
                # that interval would otherwise strand the session with no
                # valid recovery edge.
                raise PublicationError.InvalidEvent if not stage_close_succeeded or not parent_close_succeeded
                raise PublicationError.CloseNotReady if session.state != PublicationState.Staging and session.state != PublicationState.Staged and session.state != PublicationState.Published and session.state != PublicationState.PublishedUncertain
                raise PublicationError.CloseNotReady if not session.staging_sibling or not session.staging_exclusive or not session.parent_descriptor_owned or session.parent_descriptor_closed or not session.descriptor_owned or session.descriptor_closed
                session.descriptor_owned <- false
                session.descriptor_closed <- true
                session.descriptor_close_uncertain <- false
                session.parent_descriptor_owned <- false
                session.parent_descriptor_closed <- true
                session.parent_descriptor_close_uncertain <- false
            elif event == PublicationEvent.CloseOutcomeUnknown:
                raise PublicationError.CloseNotReady if session.state != PublicationState.Staging and session.state != PublicationState.Staged and session.state != PublicationState.Published and session.state != PublicationState.PublishedUncertain
                raise PublicationError.CloseNotReady if not session.staging_sibling or not session.staging_exclusive or not session.parent_descriptor_owned or session.parent_descriptor_closed or not session.descriptor_owned or session.descriptor_closed
                raise PublicationError.InvalidEvent if stage_close_succeeded and parent_close_succeeded
                session.descriptor_owned <- false
                session.descriptor_closed <- stage_close_succeeded
                session.descriptor_close_uncertain <- not stage_close_succeeded
                session.parent_descriptor_owned <- false
                session.parent_descriptor_closed <- parent_close_succeeded
                session.parent_descriptor_close_uncertain <- not parent_close_succeeded
                session.state <- PublicationState.CleanupUncertain
            elif event == PublicationEvent.Publish:
                raise PublicationError.PublishNotReady if session.state != PublicationState.Staged or not session.staging_sibling or not session.staging_exclusive or not session.parent_descriptor_owned or session.parent_descriptor_closed or not session.descriptor_owned or session.descriptor_closed or not session.stage_synced
                session.state <- PublicationState.Publishing
            elif event == PublicationEvent.PublishFailed:
                # A completed rename syscall that reports failure is a known
                # non-publication outcome. Return to Staged so the owner can
                # close both descriptors and then record ordinary failure.
                # Lost acknowledgement after a successful rename must use
                # OutcomeUnknown instead and remain non-retryable.
                raise PublicationError.PublishNotReady if session.state != PublicationState.Publishing or not session.parent_descriptor_owned or session.parent_descriptor_closed or not session.descriptor_owned or session.descriptor_closed
                raise PublicationError.DestinationNotPreserved if not destination_preserved
                session.state <- PublicationState.Staged
            elif event == PublicationEvent.PublishAck:
                # The host reports the rename and, when requested, the
                # descriptor-relative parent-directory fsync together. Both
                # retained descriptors remain live until this acknowledgement.
                raise PublicationError.PublishNotReady if session.state != PublicationState.Publishing or not session.parent_descriptor_owned or session.parent_descriptor_closed or not session.descriptor_owned or session.descriptor_closed
                raise PublicationError.DirectorySyncMissing if session.request.require_directory_sync and not directory_synced
                session.rename_acknowledged <- true
                session.directory_synced <- directory_synced
                session.state <- PublicationState.Published
            elif event == PublicationEvent.OutcomeUnknown:
                raise PublicationError.PublishNotReady if session.state != PublicationState.Publishing or not session.parent_descriptor_owned or session.parent_descriptor_closed or not session.descriptor_owned or session.descriptor_closed
                session.destination_preserved_on_failure <- false
                session.state <- PublicationState.PublishedUncertain
            elif event == PublicationEvent.Fail:
                raise PublicationError.InvalidState if session.state == PublicationState.Planned or session.state == PublicationState.Published or session.state == PublicationState.Failed or session.state == PublicationState.Cancelled
                raise PublicationError.PublicationUncertain if session.state == PublicationState.PublishedUncertain
                raise PublicationError.DestinationNotPreserved if not destination_preserved
                raise PublicationError.DescriptorOwnershipMissing if session.staging_sibling and (session.parent_descriptor_owned or not session.parent_descriptor_closed or session.descriptor_owned or not session.descriptor_closed)
                session.destination_preserved_on_failure <- true
                session.state <- PublicationState.Failed
            elif event == PublicationEvent.Cancel:
                raise PublicationError.CancelNotReady if session.state != PublicationState.Planned and session.state != PublicationState.Staging and session.state != PublicationState.Staged
                raise PublicationError.DestinationNotPreserved if not destination_preserved
                raise PublicationError.DescriptorOwnershipMissing if session.staging_sibling and (session.parent_descriptor_owned or not session.parent_descriptor_closed or session.descriptor_owned or not session.descriptor_closed)
                session.destination_preserved_on_failure <- true
                session.state <- PublicationState.Cancelling
            elif event == PublicationEvent.CancelAck:
                raise PublicationError.CancelNotReady if session.state != PublicationState.Cancelling
                raise PublicationError.DescriptorOwnershipMissing if session.staging_sibling and (session.parent_descriptor_owned or not session.parent_descriptor_closed or session.descriptor_owned or not session.descriptor_closed)
                session.state <- PublicationState.Cancelled
            return session.state
