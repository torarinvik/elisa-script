# Typed build/test orchestration graph.
#
# Build recipes are data, not shell snippets. Nodes carry validated
# ProcessCommands, resolved dependency indices, stable fingerprints, and
# bounded logs. The graph order is a deterministic topological order: every
# dependency must appear earlier, which rejects cycles before a scheduler
# starts a child.

module EsBuild:
    using EsProcess

    public:
        const module Limits:
            NODES: usize = 4096
            DEPENDENCIES: usize = 4096
            TOTAL_DEPENDENCIES: usize = 1048576
            NAME_BYTES: usize = 4096
            LOG_BYTES: usize = 67108864


        # Full-width identity used when incremental reuse must be cryptographically
        # bound to an action recipe. The scalar BuildNode fingerprint remains a
        # compact scheduler key and is not sufficient evidence for reuse.
        struct BuildRecipeSignature:
            word0: u64 = 0
            word1: u64 = 0
            word2: u64 = 0
            word3: u64 = 0


        # Caller-provided content/version identity for the compiler, linker,
        # interpreter, or other toolchain used by this action. Hosts should
        # derive it from immutable toolchain bytes or a versioned manifest.
        struct BuildRecipeToolchainIdentity:
            word0: u64 = 0
            word1: u64 = 0
            word2: u64 = 0
            word3: u64 = 0


        # Host-resolved mapping for a command's tool executable. `path` and
        # every helper path are canonical relative paths beneath the POSIX
        # directory capability; command_executable must exactly match the
        # corresponding graph node. Helpers include execution shims such as
        # `/usr/bin/env` when an action requests an exact child environment.
        struct BuildRecipeToolchainPath:
            command_executable: sview
            path: sview
            helper_paths: darray[sview] = []


        def build_recipe_signature_valid(signature: BuildRecipeSignature) -> bool:
            return signature.word0 != 0 or signature.word1 != 0 or signature.word2 != 0 or signature.word3 != 0


        # Compact scheduler compatibility key only. Incremental admission must
        # compare the complete BuildRecipeSignature as well.
        def build_recipe_scheduler_fingerprint(signature: BuildRecipeSignature) -> u64:
            value: u64 = signature.word0 ^ signature.word1 ^ signature.word2 ^ signature.word3
            return 1 if value == 0 else value


        const enum BuildNodeState of u8:
            Planned
            Running
            Succeeded
            Failed
            Cancelled


        const enum BuildGraphState of u8:
            Planned
            Running
            Failing
            Cancelling
            Succeeded
            Failed
            Cancelled


        const enum BuildGraphEvent of u8:
            Start
            NodeStart
            CacheHit
            NodeSuccess
            NodeFailure
            Cancel
            # Host confirms all active siblings stopped/reaped. In Failing this
            # drains the failure without converting it into user cancellation.
            CancelAck


        struct BuildNode:
            name: sview
            command: ProcessCommand
            # Earlier node indices, sorted ascending and duplicate-free.
            dependencies: darray[usize] = []
            fingerprint: u64
            recipe_signature: BuildRecipeSignature = BuildRecipeSignature{}
            state: BuildNodeState = BuildNodeState.Planned
            log_bytes: usize = 0


        # Name-based dependencies are the authoring/manifest form. Resolve
        # these once before constructing BuildNode's canonical index edges.
        struct BuildDependencyNames:
            names: darray[sview] = []


        struct BuildNodeNameIndex:
            name: sview
            node_index: usize


        struct BuildDependencyResolution:
            dependencies: darray[darray[usize]] = []
            node_name_order: darray[BuildNodeNameIndex] = []


        struct BuildGraph:
            nodes: darray[BuildNode] = []
            # Optional canonical name index returned by
            # resolve_build_dependencies. Empty retains a checked legacy path.
            node_name_order: darray[BuildNodeNameIndex] = []
            state: BuildGraphState = BuildGraphState.Planned
            max_parallel: usize = 1
            active_nodes: usize = 0
            completed_nodes: usize = 0
            failed_nodes: usize = 0
            log_bytes: usize = 0


        error BuildContractError:
            EmptyGraph
            NodeLimitExceeded
            DependencyLimitExceeded
            InvalidNodeState
            InvalidGraphState
            InvalidEvent
            InvalidParallelism
            InvalidNodeName
            DuplicateNode
            DuplicateDependency
            MissingDependency
            DependencyShapeInvalid
            DependencyOrderInvalid
            DependencyListOrderInvalid
            DependencyNotReady
            NodeNameIndexInvalid
            NodeNameOrderInvalid
            InvalidCommand
            FingerprintMissing
            LogLimitExceeded
            NodeIndexInvalid
            NodeAccountingInvalid
            CancelNotReady


    private:
        const enum BuildNameOrder of u8:
            Before
            Equal
            After


        def build_node_state_valid(state: BuildNodeState) -> bool:
            return state in {BuildNodeState.Planned, BuildNodeState.Running, BuildNodeState.Succeeded, BuildNodeState.Failed, BuildNodeState.Cancelled}


        def build_graph_state_valid(state: BuildGraphState) -> bool:
            return state in {BuildGraphState.Planned, BuildGraphState.Running, BuildGraphState.Failing, BuildGraphState.Cancelling, BuildGraphState.Succeeded, BuildGraphState.Failed, BuildGraphState.Cancelled}


        def build_event_valid(event: BuildGraphEvent) -> bool:
            return event in {BuildGraphEvent.Start, BuildGraphEvent.NodeStart, BuildGraphEvent.CacheHit, BuildGraphEvent.NodeSuccess, BuildGraphEvent.NodeFailure, BuildGraphEvent.Cancel, BuildGraphEvent.CancelAck}


        def build_name_valid(name: sview) -> bool:
            return sview_len(name) != 0 and sview_len(name) < Limits::NAME_BYTES and not sview_contains_byte(name, 0)


        def build_name_order(left: sview, right: sview) -> BuildNameOrder:
            left_length: usize = sview_len(left)
            right_length: usize = sview_len(right)
            common: usize = left_length if left_length < right_length else right_length
            for offset in 0..<common |left, right|:
                return BuildNameOrder.Before if sview_at(left, offset) < sview_at(right, offset)
                return BuildNameOrder.After if sview_at(left, offset) > sview_at(right, offset)
            return BuildNameOrder.Before if left_length < right_length
            return BuildNameOrder.After if left_length > right_length
            return BuildNameOrder.Equal


        def build_sort_name_indices(node_names: darray[sview], order: mutable darray[usize]&, scratch: mutable darray[usize]&) -> void:
            width: mutable usize = 1
            while width < order.count:
                start: mutable usize = 0
                while start < order.count:
                    middle: mutable usize = start + width
                    middle <- order.count if middle > order.count
                    end: mutable usize = middle + width
                    end <- order.count if end > order.count
                    left: mutable usize = start
                    right: mutable usize = middle
                    destination: mutable usize = start
                    while destination < end:
                        if left == middle:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        elif right == end:
                            scratch[destination] <- order[left]
                            left <- left + 1
                        elif build_name_order(node_names[order[left]], node_names[order[right]]) != BuildNameOrder.After:
                            scratch[destination] <- order[left]
                            left <- left + 1
                        else:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        destination <- destination + 1
                    start <- end
                for index in 0..<order.count |order, scratch|:
                    order[index] <- scratch[index]
                width <- order.count if width > order.count / 2 else width * 2


        def build_sort_node_indices(indices: mutable darray[usize]&, scratch: mutable darray[usize]&) -> void:
            width: mutable usize = 1
            while width < indices.count:
                start: mutable usize = 0
                while start < indices.count:
                    middle: mutable usize = start + width
                    middle <- indices.count if middle > indices.count
                    end: mutable usize = middle + width
                    end <- indices.count if end > indices.count
                    left: mutable usize = start
                    right: mutable usize = middle
                    destination: mutable usize = start
                    while destination < end:
                        if left == middle:
                            scratch[destination] <- indices[right]
                            right <- right + 1
                        elif right == end:
                            scratch[destination] <- indices[left]
                            left <- left + 1
                        elif indices[left] <= indices[right]:
                            scratch[destination] <- indices[left]
                            left <- left + 1
                        else:
                            scratch[destination] <- indices[right]
                            right <- right + 1
                        destination <- destination + 1
                    start <- end
                for index in 0..<indices.count |indices, scratch|:
                    indices[index] <- scratch[index]
                width <- indices.count if width > indices.count / 2 else width * 2


        def build_find_node_index(node_names: darray[sview], order: darray[usize], name: sview) -> usize:
            low: mutable usize = 0
            high: mutable usize = order.count
            while low < high:
                middle: usize = low + (high - low) / 2
                node_index: usize = order[middle]
                name_order: BuildNameOrder = build_name_order(node_names[node_index], name)
                return node_index if name_order == BuildNameOrder.Equal
                low <- middle + 1 if name_order == BuildNameOrder.Before
                high <- middle if name_order == BuildNameOrder.After
            return node_names.count


    public:
        # Resolve author-facing names to canonical earlier-node indices. Name
        # lookup is O(log N) after one stable O(N log N) index sort; dependency
        # lists are sorted once so subsequent graph validation remains linear
        # in the number of edges.
        def resolve_build_dependencies(node_names: darray[sview], dependency_names: darray[BuildDependencyNames]) -> BuildDependencyResolution error[BuildContractError] can[Memory.Allocate, Abort.Panic]:
            raise BuildContractError.EmptyGraph if node_names.count == 0
            raise BuildContractError.NodeLimitExceeded if node_names.count > Limits::NODES
            raise BuildContractError.DependencyShapeInvalid if dependency_names.count != node_names.count
            order: mutable darray[usize] = []
            scratch: mutable darray[usize] = []
            for index in 0..<node_names.count |node_names, order, scratch|:
                raise BuildContractError.InvalidNodeName if not build_name_valid(node_names[index])
                order.push(index)
                scratch.push(0)
            build_sort_name_indices(node_names, order, scratch)
            for index in 1..<order.count |node_names, order|:
                raise BuildContractError.DuplicateNode if build_name_order(node_names[order[index - 1]], node_names[order[index]]) == BuildNameOrder.Equal

            resolved: mutable darray[darray[usize]] = []
            total_dependencies: mutable usize = 0
            for node_index in 0..<node_names.count |node_names, dependency_names, order, resolved, total_dependencies|:
                named: BuildDependencyNames = dependency_names[node_index]
                raise BuildContractError.DependencyLimitExceeded if named.names.count > Limits::DEPENDENCIES
                raise BuildContractError.DependencyLimitExceeded if named.names.count > Limits::TOTAL_DEPENDENCIES - total_dependencies
                total_dependencies <- total_dependencies + named.names.count
                node_dependencies: mutable darray[usize] = []
                for dependency_name in named.names |node_names, order, node_index, node_dependencies|:
                    raise BuildContractError.InvalidNodeName if not build_name_valid(dependency_name)
                    dependency_index: usize = build_find_node_index(node_names, order, dependency_name)
                    raise BuildContractError.MissingDependency if dependency_index == node_names.count
                    raise BuildContractError.DependencyOrderInvalid if dependency_index >= node_index
                    node_dependencies.push(dependency_index)
                dependency_scratch: mutable darray[usize] = []
                for _ in 0..<node_dependencies.count |dependency_scratch|:
                    dependency_scratch.push(0)
                build_sort_node_indices(node_dependencies, dependency_scratch)
                for index in 1..<node_dependencies.count |node_dependencies|:
                    raise BuildContractError.DuplicateDependency if node_dependencies[index - 1] == node_dependencies[index]
                resolved.push(node_dependencies)
            node_name_index: mutable darray[BuildNodeNameIndex] = []
            for node_index in order |node_names, node_name_index|:
                node_name_index.push(BuildNodeNameIndex{name: node_names[node_index], node_index: node_index})
            return BuildDependencyResolution{dependencies: resolved, node_name_order: node_name_index}


        def validate_build_graph(graph: BuildGraph&) -> bool error[BuildContractError]:
            raise BuildContractError.EmptyGraph if graph.nodes.count == 0
            raise BuildContractError.NodeLimitExceeded if graph.nodes.count > Limits::NODES
            raise BuildContractError.InvalidGraphState if not build_graph_state_valid(graph.state)
            raise BuildContractError.InvalidParallelism if graph.max_parallel == 0 or graph.max_parallel > graph.nodes.count
            raise BuildContractError.NodeAccountingInvalid if graph.active_nodes > graph.max_parallel or graph.completed_nodes > graph.nodes.count or graph.failed_nodes > graph.completed_nodes
            raise BuildContractError.LogLimitExceeded if graph.log_bytes > Limits::LOG_BYTES
            running_nodes: mutable usize = 0
            planned_nodes: mutable usize = 0
            cancelled_nodes: mutable usize = 0
            terminal_nodes: mutable usize = 0
            failed_nodes: mutable usize = 0
            total_log_bytes: mutable usize = 0
            total_dependencies: mutable usize = 0
            raise BuildContractError.NodeNameIndexInvalid if graph.node_name_order.count != 0 and graph.node_name_order.count != graph.nodes.count
            for index in 0..<graph.nodes.count |graph|:
                node: BuildNode = graph.nodes[index]
                raise BuildContractError.InvalidNodeName if not build_name_valid(node.name)
                raise BuildContractError.InvalidNodeState if not build_node_state_valid(node.state)
                running_nodes <- running_nodes + 1 if node.state == BuildNodeState.Running
                planned_nodes <- planned_nodes + 1 if node.state == BuildNodeState.Planned
                cancelled_nodes <- cancelled_nodes + 1 if node.state == BuildNodeState.Cancelled
                terminal_nodes <- terminal_nodes + 1 if node.state == BuildNodeState.Succeeded or node.state == BuildNodeState.Failed or node.state == BuildNodeState.Cancelled
                failed_nodes <- failed_nodes + 1 if node.state == BuildNodeState.Failed
                raise BuildContractError.FingerprintMissing if node.fingerprint == 0
                raise BuildContractError.LogLimitExceeded if total_log_bytes > Limits::LOG_BYTES
                raise BuildContractError.LogLimitExceeded if node.log_bytes > Limits::LOG_BYTES - total_log_bytes
                total_log_bytes <- total_log_bytes + node.log_bytes
                catch validate_process_command(node.command):
                    ok:
                        pass
                    error failure:
                        raise BuildContractError.InvalidCommand
                raise BuildContractError.DependencyLimitExceeded if node.dependencies.count > Limits::DEPENDENCIES
                raise BuildContractError.DependencyLimitExceeded if node.dependencies.count > Limits::TOTAL_DEPENDENCIES - total_dependencies
                total_dependencies <- total_dependencies + node.dependencies.count
                # Canonical earlier-node indices permit direct bounded lookups
                # and make duplicate detection linear in the edge count.
                for dependency_position in 0..<node.dependencies.count |node|:
                    dependency_index: usize = node.dependencies[dependency_position]
                    raise BuildContractError.MissingDependency if dependency_index >= graph.nodes.count
                    raise BuildContractError.DependencyOrderInvalid if dependency_index >= index
                    if dependency_position > 0:
                        earlier_dependency: usize = node.dependencies[dependency_position - 1]
                        raise BuildContractError.DuplicateDependency if earlier_dependency == dependency_index
                        raise BuildContractError.DependencyListOrderInvalid if earlier_dependency > dependency_index
            raise BuildContractError.LogLimitExceeded if total_log_bytes != graph.log_bytes
            raise BuildContractError.NodeAccountingInvalid if graph.active_nodes != running_nodes or graph.completed_nodes != terminal_nodes or graph.failed_nodes != failed_nodes
            if graph.state == BuildGraphState.Planned:
                raise BuildContractError.NodeAccountingInvalid if graph.active_nodes != 0 or graph.completed_nodes != 0 or graph.failed_nodes != 0
            elif graph.state == BuildGraphState.Running:
                raise BuildContractError.NodeAccountingInvalid if graph.failed_nodes != 0 or cancelled_nodes != 0 or graph.completed_nodes >= graph.nodes.count
            elif graph.state == BuildGraphState.Failing:
                raise BuildContractError.NodeAccountingInvalid if graph.failed_nodes == 0 or graph.active_nodes == 0 or planned_nodes != 0
            elif graph.state == BuildGraphState.Cancelling:
                raise BuildContractError.NodeAccountingInvalid if graph.failed_nodes != 0 or cancelled_nodes != 0 or graph.completed_nodes >= graph.nodes.count
            elif graph.state == BuildGraphState.Succeeded:
                raise BuildContractError.NodeAccountingInvalid if graph.active_nodes != 0 or graph.completed_nodes != graph.nodes.count or graph.failed_nodes != 0 or cancelled_nodes != 0
            elif graph.state == BuildGraphState.Failed:
                raise BuildContractError.NodeAccountingInvalid if graph.failed_nodes == 0 or graph.active_nodes != 0 or graph.completed_nodes != graph.nodes.count
            elif graph.state == BuildGraphState.Cancelled:
                raise BuildContractError.NodeAccountingInvalid if graph.active_nodes != 0 or graph.completed_nodes != graph.nodes.count or graph.failed_nodes != 0 or cancelled_nodes == 0
            if graph.node_name_order.count == 0:
                for index in 0..<graph.nodes.count |graph|:
                    for earlier in 0..<index |graph|:
                        raise BuildContractError.DuplicateNode if graph.nodes[earlier].name == graph.nodes[index].name
            else:
                for order_index in 0..<graph.node_name_order.count |graph|:
                    entry: BuildNodeNameIndex = graph.node_name_order[order_index]
                    node_index: usize = entry.node_index
                    raise BuildContractError.NodeNameIndexInvalid if node_index >= graph.nodes.count
                    raise BuildContractError.NodeNameIndexInvalid if graph.nodes[node_index].name != entry.name
                    if order_index > 0:
                        previous: BuildNodeNameIndex = graph.node_name_order[order_index - 1]
                        previous_index: usize = previous.node_index
                        raise BuildContractError.NodeNameIndexInvalid if previous_index >= graph.nodes.count
                        raise BuildContractError.NodeNameIndexInvalid if graph.nodes[previous_index].name != previous.name
                        name_order: BuildNameOrder = build_name_order(previous.name, entry.name)
                        raise BuildContractError.DuplicateNode if name_order == BuildNameOrder.Equal
                        raise BuildContractError.NodeNameOrderInvalid if name_order == BuildNameOrder.After
            return true


        # Attach a canonical name resolution to a fresh graph of command
        # templates. Validate the templates and complete resolution before
        # mutating it, so malformed dependency data cannot leave half-attached
        # edges or a stale name index behind. The resolution's sorted name
        # index avoids an initial pairwise duplicate-name scan.
        def attach_build_dependency_resolution(graph: mutable BuildGraph&, resolution: BuildDependencyResolution) -> bool error[BuildContractError] can[Memory.Allocate, Abort.Panic]:
            raise BuildContractError.EmptyGraph if graph.nodes.count == 0
            raise BuildContractError.NodeLimitExceeded if graph.nodes.count > Limits::NODES
            raise BuildContractError.InvalidGraphState if graph.state != BuildGraphState.Planned
            raise BuildContractError.InvalidParallelism if graph.max_parallel == 0 or graph.max_parallel > graph.nodes.count
            raise BuildContractError.NodeAccountingInvalid if graph.active_nodes != 0 or graph.completed_nodes != 0 or graph.failed_nodes != 0
            raise BuildContractError.LogLimitExceeded if graph.log_bytes != 0
            raise BuildContractError.NodeNameIndexInvalid if graph.node_name_order.count != 0
            raise BuildContractError.DependencyShapeInvalid if resolution.dependencies.count != graph.nodes.count
            raise BuildContractError.NodeNameIndexInvalid if resolution.node_name_order.count != graph.nodes.count
            for node_index in 0..<graph.nodes.count |graph, resolution|:
                node: BuildNode = graph.nodes[node_index]
                raise BuildContractError.InvalidNodeName if not build_name_valid(node.name)
                raise BuildContractError.InvalidNodeState if node.state != BuildNodeState.Planned or node.log_bytes != 0
                raise BuildContractError.FingerprintMissing if node.fingerprint == 0
                raise BuildContractError.DependencyShapeInvalid if node.dependencies.count != 0
                catch validate_process_command(node.command):
                    ok:
                        pass
                    error failure:
                        raise BuildContractError.InvalidCommand
                dependencies: darray[usize] = resolution.dependencies[node_index]
                raise BuildContractError.DependencyLimitExceeded if dependencies.count > Limits::DEPENDENCIES
            total_dependencies: mutable usize = 0
            for node_index in 0..<graph.nodes.count |graph, resolution, total_dependencies|:
                dependencies: darray[usize] = resolution.dependencies[node_index]
                raise BuildContractError.DependencyLimitExceeded if dependencies.count > Limits::TOTAL_DEPENDENCIES - total_dependencies
                total_dependencies <- total_dependencies + dependencies.count
                for position in 0..<dependencies.count |graph, resolution, node_index, dependencies|:
                    dependency_index: usize = dependencies[position]
                    raise BuildContractError.NodeIndexInvalid if dependency_index >= graph.nodes.count
                    raise BuildContractError.DependencyOrderInvalid if dependency_index >= node_index
                    if position > 0:
                        previous_dependency: usize = dependencies[position - 1]
                        raise BuildContractError.DuplicateDependency if previous_dependency == dependency_index
                        raise BuildContractError.DependencyListOrderInvalid if previous_dependency > dependency_index
            for order_index in 0..<resolution.node_name_order.count |graph, resolution|:
                entry: BuildNodeNameIndex = resolution.node_name_order[order_index]
                raise BuildContractError.NodeNameIndexInvalid if entry.node_index >= graph.nodes.count
                raise BuildContractError.NodeNameIndexInvalid if graph.nodes[entry.node_index].name != entry.name
                if order_index > 0:
                    previous: BuildNodeNameIndex = resolution.node_name_order[order_index - 1]
                    name_order: BuildNameOrder = build_name_order(previous.name, entry.name)
                    raise BuildContractError.DuplicateNode if name_order == BuildNameOrder.Equal
                    raise BuildContractError.NodeNameOrderInvalid if name_order == BuildNameOrder.After
            for node_index in 0..<graph.nodes.count |graph, resolution|:
                graph.nodes[node_index].dependencies <- resolution.dependencies[node_index]
            graph.node_name_order <- resolution.node_name_order
            try validate_build_graph(graph)
            return true


        def advance_build_graph(graph: mutable BuildGraph&, event: BuildGraphEvent, node_index: usize = 0) -> BuildGraphState error[BuildContractError]:
            try validate_build_graph(graph)
            raise BuildContractError.InvalidEvent if not build_event_valid(event)
            if event == BuildGraphEvent.Start:
                raise BuildContractError.InvalidGraphState if graph.state != BuildGraphState.Planned
                graph.state <- BuildGraphState.Running
            elif event == BuildGraphEvent.NodeStart:
                raise BuildContractError.InvalidGraphState if graph.state != BuildGraphState.Running
                raise BuildContractError.NodeIndexInvalid if node_index >= graph.nodes.count
                raise BuildContractError.InvalidNodeState if graph.nodes[node_index].state != BuildNodeState.Planned
                for dependency_index in graph.nodes[node_index].dependencies:
                    raise BuildContractError.DependencyNotReady if graph.nodes[dependency_index].state != BuildNodeState.Succeeded
                raise BuildContractError.InvalidParallelism if graph.active_nodes >= graph.max_parallel
                graph.nodes[node_index].state <- BuildNodeState.Running
                graph.active_nodes <- graph.active_nodes + 1
            elif event == BuildGraphEvent.CacheHit:
                raise BuildContractError.InvalidGraphState if graph.state != BuildGraphState.Running
                raise BuildContractError.NodeIndexInvalid if node_index >= graph.nodes.count
                raise BuildContractError.InvalidNodeState if graph.nodes[node_index].state != BuildNodeState.Planned
                for dependency_index in graph.nodes[node_index].dependencies:
                    raise BuildContractError.DependencyNotReady if graph.nodes[dependency_index].state != BuildNodeState.Succeeded
                graph.nodes[node_index].state <- BuildNodeState.Succeeded
                graph.completed_nodes <- graph.completed_nodes + 1
                if graph.completed_nodes == graph.nodes.count:
                    graph.state <- BuildGraphState.Succeeded if graph.failed_nodes == 0 and graph.active_nodes == 0
            elif event == BuildGraphEvent.NodeSuccess or event == BuildGraphEvent.NodeFailure:
                raise BuildContractError.InvalidGraphState if graph.state != BuildGraphState.Running and graph.state != BuildGraphState.Failing
                raise BuildContractError.NodeIndexInvalid if node_index >= graph.nodes.count
                raise BuildContractError.InvalidNodeState if graph.nodes[node_index].state != BuildNodeState.Running
                raise BuildContractError.NodeAccountingInvalid if graph.active_nodes == 0
                failure_in_progress: bool = graph.state == BuildGraphState.Failing or event == BuildGraphEvent.NodeFailure
                graph.nodes[node_index].state <- BuildNodeState.Succeeded if event == BuildGraphEvent.NodeSuccess else BuildNodeState.Failed
                graph.active_nodes <- graph.active_nodes - 1
                graph.completed_nodes <- graph.completed_nodes + 1
                graph.failed_nodes <- graph.failed_nodes + 1 if event == BuildGraphEvent.NodeFailure
                if event == BuildGraphEvent.NodeFailure:
                    for index in 0..<graph.nodes.count |graph|:
                        if graph.nodes[index].state == BuildNodeState.Planned:
                            graph.nodes[index].state <- BuildNodeState.Cancelled
                            graph.completed_nodes <- graph.completed_nodes + 1
                if failure_in_progress:
                    graph.state <- BuildGraphState.Failed if graph.active_nodes == 0 else BuildGraphState.Failing
                elif graph.completed_nodes == graph.nodes.count:
                    graph.state <- BuildGraphState.Succeeded if graph.failed_nodes == 0 and graph.active_nodes == 0
            elif event == BuildGraphEvent.Cancel:
                if graph.state == BuildGraphState.Planned:
                    for index in 0..<graph.nodes.count |graph|:
                        if graph.nodes[index].state == BuildNodeState.Planned:
                            graph.nodes[index].state <- BuildNodeState.Cancelled
                            graph.completed_nodes <- graph.completed_nodes + 1
                    graph.state <- BuildGraphState.Cancelled
                else:
                    raise BuildContractError.CancelNotReady if graph.state != BuildGraphState.Running
                    graph.state <- BuildGraphState.Cancelling
            elif event == BuildGraphEvent.CancelAck:
                raise BuildContractError.CancelNotReady if graph.state != BuildGraphState.Cancelling and graph.state != BuildGraphState.Failing
                ack_failure: bool = graph.state == BuildGraphState.Failing
                for index in 0..<graph.nodes.count |graph|:
                    if graph.nodes[index].state == BuildNodeState.Running:
                        graph.nodes[index].state <- BuildNodeState.Cancelled
                        graph.active_nodes <- graph.active_nodes - 1
                        graph.completed_nodes <- graph.completed_nodes + 1
                    elif graph.nodes[index].state == BuildNodeState.Planned:
                        graph.nodes[index].state <- BuildNodeState.Cancelled
                        graph.completed_nodes <- graph.completed_nodes + 1
                graph.state <- BuildGraphState.Failed if ack_failure else BuildGraphState.Cancelled
            return graph.state
