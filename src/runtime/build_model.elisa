# Typed build/test orchestration graph.
#
# Build recipes are data, not shell snippets. Nodes carry validated
# ProcessCommands, resolved dependency indices, stable fingerprints, and
# bounded logs. The graph order is a deterministic topological order: every
# dependency must appear earlier, which rejects cycles before a scheduler
# starts a child.

module EsBuild:
    using EsProcess

    public:
        const module Limits:
            NODES: usize = 4096
            DEPENDENCIES: usize = 4096
            LOG_BYTES: usize = 67108864


        const enum BuildNodeState of u8:
            Planned
            Running
            Succeeded
            Failed
            Cancelled


        const enum BuildGraphState of u8:
            Planned
            Running
            Failing
            Cancelling
            Succeeded
            Failed
            Cancelled


        const enum BuildGraphEvent of u8:
            Start
            NodeStart
            NodeSuccess
            NodeFailure
            Cancel
            # Host confirms all active siblings stopped/reaped. In Failing this
            # drains the failure without converting it into user cancellation.
            CancelAck


        struct BuildNode:
            name: sview
            command: ProcessCommand
            # Earlier node indices, sorted ascending and duplicate-free.
            dependencies: darray[usize] = []
            fingerprint: u64
            state: BuildNodeState = BuildNodeState.Planned
            log_bytes: usize = 0


        struct BuildGraph:
            nodes: darray[BuildNode] = []
            state: BuildGraphState = BuildGraphState.Planned
            max_parallel: usize = 1
            active_nodes: usize = 0
            completed_nodes: usize = 0
            failed_nodes: usize = 0
            log_bytes: usize = 0


        error BuildContractError:
            EmptyGraph
            NodeLimitExceeded
            DependencyLimitExceeded
            InvalidNodeState
            InvalidGraphState
            InvalidEvent
            InvalidParallelism
            InvalidNodeName
            DuplicateNode
            DuplicateDependency
            MissingDependency
            DependencyOrderInvalid
            DependencyListOrderInvalid
            DependencyNotReady
            InvalidCommand
            FingerprintMissing
            LogLimitExceeded
            NodeIndexInvalid
            NodeAccountingInvalid
            CancelNotReady


    private:
        def build_node_state_valid(state: BuildNodeState) -> bool:
            return state in {BuildNodeState.Planned, BuildNodeState.Running, BuildNodeState.Succeeded, BuildNodeState.Failed, BuildNodeState.Cancelled}


        def build_graph_state_valid(state: BuildGraphState) -> bool:
            return state in {BuildGraphState.Planned, BuildGraphState.Running, BuildGraphState.Failing, BuildGraphState.Cancelling, BuildGraphState.Succeeded, BuildGraphState.Failed, BuildGraphState.Cancelled}


        def build_event_valid(event: BuildGraphEvent) -> bool:
            return event in {BuildGraphEvent.Start, BuildGraphEvent.NodeStart, BuildGraphEvent.NodeSuccess, BuildGraphEvent.NodeFailure, BuildGraphEvent.Cancel, BuildGraphEvent.CancelAck}


        def build_name_valid(name: sview) -> bool:
            return sview_len(name) != 0 and sview_len(name) < PROCESS_COMMAND_MAX_TEXT_BYTES and not sview_contains_byte(name, 0)


    public:
        def validate_build_graph(graph: BuildGraph&) -> bool error[BuildContractError]:
            raise BuildContractError.EmptyGraph if graph.nodes.count == 0
            raise BuildContractError.NodeLimitExceeded if graph.nodes.count > Limits::NODES
            raise BuildContractError.InvalidGraphState if not build_graph_state_valid(graph.state)
            raise BuildContractError.InvalidParallelism if graph.max_parallel == 0 or graph.max_parallel > graph.nodes.count
            raise BuildContractError.NodeAccountingInvalid if graph.active_nodes > graph.max_parallel or graph.completed_nodes > graph.nodes.count or graph.failed_nodes > graph.completed_nodes
            raise BuildContractError.LogLimitExceeded if graph.log_bytes > Limits::LOG_BYTES
            running_nodes: mutable usize = 0
            planned_nodes: mutable usize = 0
            cancelled_nodes: mutable usize = 0
            terminal_nodes: mutable usize = 0
            failed_nodes: mutable usize = 0
            total_log_bytes: mutable usize = 0
            for index in 0..<graph.nodes.count |graph|:
                node: BuildNode = graph.nodes[index]
                raise BuildContractError.InvalidNodeName if not build_name_valid(node.name)
                raise BuildContractError.InvalidNodeState if not build_node_state_valid(node.state)
                running_nodes <- running_nodes + 1 if node.state == BuildNodeState.Running
                planned_nodes <- planned_nodes + 1 if node.state == BuildNodeState.Planned
                cancelled_nodes <- cancelled_nodes + 1 if node.state == BuildNodeState.Cancelled
                terminal_nodes <- terminal_nodes + 1 if node.state == BuildNodeState.Succeeded or node.state == BuildNodeState.Failed or node.state == BuildNodeState.Cancelled
                failed_nodes <- failed_nodes + 1 if node.state == BuildNodeState.Failed
                raise BuildContractError.FingerprintMissing if node.fingerprint == 0
                raise BuildContractError.LogLimitExceeded if total_log_bytes > Limits::LOG_BYTES
                raise BuildContractError.LogLimitExceeded if node.log_bytes > Limits::LOG_BYTES - total_log_bytes
                total_log_bytes <- total_log_bytes + node.log_bytes
                catch validate_process_command(node.command):
                    ok:
                        pass
                    error failure:
                        raise BuildContractError.InvalidCommand
                raise BuildContractError.DependencyLimitExceeded if node.dependencies.count > Limits::DEPENDENCIES
                # Canonical earlier-node indices permit direct bounded lookups
                # and make duplicate detection linear in the edge count.
                for dependency_position in 0..<node.dependencies.count |node|:
                    dependency_index: usize = node.dependencies[dependency_position]
                    raise BuildContractError.MissingDependency if dependency_index >= graph.nodes.count
                    raise BuildContractError.DependencyOrderInvalid if dependency_index >= index
                    if dependency_position > 0:
                        earlier_dependency: usize = node.dependencies[dependency_position - 1]
                        raise BuildContractError.DuplicateDependency if earlier_dependency == dependency_index
                        raise BuildContractError.DependencyListOrderInvalid if earlier_dependency > dependency_index
            raise BuildContractError.LogLimitExceeded if total_log_bytes != graph.log_bytes
            raise BuildContractError.NodeAccountingInvalid if graph.active_nodes != running_nodes or graph.completed_nodes != terminal_nodes or graph.failed_nodes != failed_nodes
            if graph.state == BuildGraphState.Planned:
                raise BuildContractError.NodeAccountingInvalid if graph.active_nodes != 0 or graph.completed_nodes != 0 or graph.failed_nodes != 0
            elif graph.state == BuildGraphState.Running:
                raise BuildContractError.NodeAccountingInvalid if graph.failed_nodes != 0 or cancelled_nodes != 0 or graph.completed_nodes >= graph.nodes.count
            elif graph.state == BuildGraphState.Failing:
                raise BuildContractError.NodeAccountingInvalid if graph.failed_nodes == 0 or graph.active_nodes == 0 or planned_nodes != 0
            elif graph.state == BuildGraphState.Cancelling:
                raise BuildContractError.NodeAccountingInvalid if graph.failed_nodes != 0 or cancelled_nodes != 0 or graph.completed_nodes >= graph.nodes.count
            elif graph.state == BuildGraphState.Succeeded:
                raise BuildContractError.NodeAccountingInvalid if graph.active_nodes != 0 or graph.completed_nodes != graph.nodes.count or graph.failed_nodes != 0 or cancelled_nodes != 0
            elif graph.state == BuildGraphState.Failed:
                raise BuildContractError.NodeAccountingInvalid if graph.failed_nodes == 0 or graph.active_nodes != 0 or graph.completed_nodes != graph.nodes.count
            elif graph.state == BuildGraphState.Cancelled:
                raise BuildContractError.NodeAccountingInvalid if graph.active_nodes != 0 or graph.completed_nodes != graph.nodes.count or graph.failed_nodes != 0 or cancelled_nodes == 0
            for index in 0..<graph.nodes.count |graph|:
                for earlier in 0..<index |graph|:
                    raise BuildContractError.DuplicateNode if graph.nodes[earlier].name == graph.nodes[index].name
            return true


        def advance_build_graph(graph: mutable BuildGraph&, event: BuildGraphEvent, node_index: usize = 0) -> BuildGraphState error[BuildContractError]:
            try validate_build_graph(graph)
            raise BuildContractError.InvalidEvent if not build_event_valid(event)
            if event == BuildGraphEvent.Start:
                raise BuildContractError.InvalidGraphState if graph.state != BuildGraphState.Planned
                graph.state <- BuildGraphState.Running
            elif event == BuildGraphEvent.NodeStart:
                raise BuildContractError.InvalidGraphState if graph.state != BuildGraphState.Running
                raise BuildContractError.NodeIndexInvalid if node_index >= graph.nodes.count
                raise BuildContractError.InvalidNodeState if graph.nodes[node_index].state != BuildNodeState.Planned
                for dependency_index in graph.nodes[node_index].dependencies:
                    raise BuildContractError.DependencyNotReady if graph.nodes[dependency_index].state != BuildNodeState.Succeeded
                raise BuildContractError.InvalidParallelism if graph.active_nodes >= graph.max_parallel
                graph.nodes[node_index].state <- BuildNodeState.Running
                graph.active_nodes <- graph.active_nodes + 1
            elif event == BuildGraphEvent.NodeSuccess or event == BuildGraphEvent.NodeFailure:
                raise BuildContractError.InvalidGraphState if graph.state != BuildGraphState.Running and graph.state != BuildGraphState.Failing
                raise BuildContractError.NodeIndexInvalid if node_index >= graph.nodes.count
                raise BuildContractError.InvalidNodeState if graph.nodes[node_index].state != BuildNodeState.Running
                raise BuildContractError.NodeAccountingInvalid if graph.active_nodes == 0
                failure_in_progress: bool = graph.state == BuildGraphState.Failing or event == BuildGraphEvent.NodeFailure
                graph.nodes[node_index].state <- BuildNodeState.Succeeded if event == BuildGraphEvent.NodeSuccess else BuildNodeState.Failed
                graph.active_nodes <- graph.active_nodes - 1
                graph.completed_nodes <- graph.completed_nodes + 1
                graph.failed_nodes <- graph.failed_nodes + 1 if event == BuildGraphEvent.NodeFailure
                if event == BuildGraphEvent.NodeFailure:
                    for index in 0..<graph.nodes.count |graph|:
                        if graph.nodes[index].state == BuildNodeState.Planned:
                            graph.nodes[index].state <- BuildNodeState.Cancelled
                            graph.completed_nodes <- graph.completed_nodes + 1
                if failure_in_progress:
                    graph.state <- BuildGraphState.Failed if graph.active_nodes == 0 else BuildGraphState.Failing
                elif graph.completed_nodes == graph.nodes.count:
                    graph.state <- BuildGraphState.Succeeded if graph.failed_nodes == 0 and graph.active_nodes == 0
            elif event == BuildGraphEvent.Cancel:
                if graph.state == BuildGraphState.Planned:
                    for index in 0..<graph.nodes.count |graph|:
                        if graph.nodes[index].state == BuildNodeState.Planned:
                            graph.nodes[index].state <- BuildNodeState.Cancelled
                            graph.completed_nodes <- graph.completed_nodes + 1
                    graph.state <- BuildGraphState.Cancelled
                else:
                    raise BuildContractError.CancelNotReady if graph.state != BuildGraphState.Running
                    graph.state <- BuildGraphState.Cancelling
            elif event == BuildGraphEvent.CancelAck:
                raise BuildContractError.CancelNotReady if graph.state != BuildGraphState.Cancelling and graph.state != BuildGraphState.Failing
                ack_failure: bool = graph.state == BuildGraphState.Failing
                for index in 0..<graph.nodes.count |graph|:
                    if graph.nodes[index].state == BuildNodeState.Running:
                        graph.nodes[index].state <- BuildNodeState.Cancelled
                        graph.active_nodes <- graph.active_nodes - 1
                        graph.completed_nodes <- graph.completed_nodes + 1
                    elif graph.nodes[index].state == BuildNodeState.Planned:
                        graph.nodes[index].state <- BuildNodeState.Cancelled
                        graph.completed_nodes <- graph.completed_nodes + 1
                graph.state <- BuildGraphState.Failed if ack_failure else BuildGraphState.Cancelled
            return graph.state
