# Pure parser for the deployment targets printed by Apple's `otool -l`.
#
# This models the small Python helper used by package_macos_app.py. It does
# not execute otool or inspect Mach-O files; those remain an adapter concern.

module EsMacosDeploymentTarget:
    public:
        # Python int is not machine-word-limited. Store canonical decimal
        # digits rather than imposing a fixed-width limit on tool output.
        struct DecimalInteger:
            # Parsed values keep the backing bytes here for the lifetime of text.
            text: sview
            owned: darray[u8] = []


        struct MacosVersion:
            major: DecimalInteger = DecimalInteger{text: "0"}
            minor: DecimalInteger = DecimalInteger{text: "0"}
            patch: DecimalInteger = DecimalInteger{text: "0"}


        const module Policy:
            METAL_MINIMUM_MACOS_MAJOR: sview = "26"
            METAL_MINIMUM_MACOS_MINOR: sview = "0"
            METAL_MINIMUM_MACOS_PATCH: sview = "0"


        error MacosDeploymentTargetError:
            NonMacosTarget
            MalformedTarget
            NoDeploymentTarget


    private:
        const module Byte:
            SPACE: u8 = 32
            DOT: u8 = 46
            ZERO: u8 = 48
            NINE: u8 = 57
            UNDERSCORE: u8 = 95


        const enum VersionScanState of u8:
            MajorDigits
            MajorEnd
            MinorDigits
            MinorEnd
            PatchDigits
            PatchEnd
            Complete
            Invalid


        struct LiteralMatch:
            found: bool = false
            start: usize = 0


        struct VersionScan:
            matched: bool = false
            version: MacosVersion = MacosVersion{}


        struct FieldVersion:
            found: bool = false
            version: MacosVersion = MacosVersion{}


        struct SegmentTarget:
            found: bool = false
            version: MacosVersion = MacosVersion{}


        def deployment_byte_is_word(byte: u8) -> bool:
            return (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == Byte::UNDERSCORE


        def deployment_byte_is_digit(byte: u8) -> bool:
            return byte >= Byte::ZERO and byte <= Byte::NINE


        def deployment_byte_is_whitespace(byte: u8) -> bool:
            return byte == 9 or byte == 10 or byte == 11 or byte == 12 or byte == 13 or byte == Byte::SPACE


        def deployment_literal_at(source: sview, start: usize, literal: sview) -> bool:
            literal_length: usize = sview_len(literal)
            return false if start > sview_len(source) or literal_length > sview_len(source) - start
            for offset in 0..<literal_length |source, literal|:
                return false if sview_at(source, start + offset) != sview_at(literal, offset)
            return true


        def deployment_find_word(source: sview, word: sview, start: usize) -> LiteralMatch:
            source_length: usize = sview_len(source)
            word_length: usize = sview_len(word)
            cursor: mutable usize = start
            while cursor <= source_length and word_length <= source_length - cursor |source, word, cursor|:
                if deployment_literal_at(source, cursor, word):
                    before_is_boundary: bool = cursor == 0 or not deployment_byte_is_word(sview_at(source, cursor - 1))
                    after: usize = cursor + word_length
                    after_is_boundary: bool = after == source_length or not deployment_byte_is_word(sview_at(source, after))
                    if before_is_boundary and after_is_boundary:
                        return LiteralMatch{found: true, start: cursor}
                cursor <- cursor + 1
            return LiteralMatch{}


        def deployment_find_literal(source: sview, literal: sview, start: usize) -> LiteralMatch:
            source_length: usize = sview_len(source)
            literal_length: usize = sview_len(literal)
            cursor: mutable usize = start
            while cursor <= source_length and literal_length <= source_length - cursor |source, literal, cursor|:
                if deployment_literal_at(source, cursor, literal):
                    before_is_boundary: bool = cursor == 0 or not deployment_byte_is_word(sview_at(source, cursor - 1))
                    after: usize = cursor + literal_length
                    after_is_boundary: bool = after == source_length or not deployment_byte_is_word(sview_at(source, after))
                    if before_is_boundary and after_is_boundary:
                        return LiteralMatch{found: true, start: cursor}
                cursor <- cursor + 1
            return LiteralMatch{}


        def deployment_decimal_from_literal(source: sview) -> DecimalInteger can[Memory.Allocate, Abort.Panic]:
            digits: mutable darray[u8] = []
            for byte in source |digits|:
                digits.push(byte)
            canonical: sview = bytes_view(digits)
            return DecimalInteger{text: canonical, owned: digits}


        def deployment_decimal_from_range(source: sview, start: usize, end: usize) -> DecimalInteger can[Memory.Allocate, Abort.Panic]:
            normalized_start: mutable usize = start
            while normalized_start < end and sview_at(source, normalized_start) == Byte::ZERO |source, normalized_start, end|:
                normalized_start <- normalized_start + 1
            digits: mutable darray[u8] = []
            if normalized_start == end:
                digits.push(Byte::ZERO)
            else:
                for index in normalized_start..<end |source, digits|:
                    digits.push(sview_at(source, index))
            canonical: sview = bytes_view(digits)
            return DecimalInteger{text: canonical, owned: digits}


        def deployment_decimal_before(left: DecimalInteger, right: DecimalInteger) -> bool:
            left_length: usize = sview_len(left.text)
            right_length: usize = sview_len(right.text)
            return left_length < right_length if left_length != right_length
            for index in 0..<left_length |left, right|:
                left_byte: u8 = sview_at(left.text, index)
                right_byte: u8 = sview_at(right.text, index)
                return left_byte < right_byte if left_byte != right_byte
            return false


        def deployment_scan_version(source: sview, start: usize) -> VersionScan can[Memory.Allocate, Abort.Panic]:
            length: usize = sview_len(source)
            cursor: mutable usize = start
            state: mutable VersionScanState = VersionScanState.MajorDigits
            major_end: mutable usize = start
            minor_start: mutable usize = 0
            minor_end: mutable usize = 0
            patch_start: mutable usize = 0
            patch_end: mutable usize = 0
            component_digits: mutable usize = 0
            while state != VersionScanState.Complete and state != VersionScanState.Invalid |source, cursor, state, major_end, minor_start, minor_end, patch_start, patch_end, component_digits|:
                byte: u8 = 0 if cursor >= length else sview_at(source, cursor)
                match state:
                    VersionScanState.MajorDigits:
                        if cursor < length and deployment_byte_is_digit(byte):
                            component_digits <- component_digits + 1
                            cursor <- cursor + 1
                            major_end <- cursor
                        else:
                            state <- VersionScanState.MajorEnd
                    VersionScanState.MajorEnd:
                        if component_digits == 0:
                            state <- VersionScanState.Invalid
                        elif cursor < length and byte == Byte::DOT:
                            cursor <- cursor + 1
                            minor_start <- cursor
                            component_digits <- 0
                            state <- VersionScanState.MinorDigits
                        elif cursor < length and deployment_byte_is_whitespace(byte):
                            state <- VersionScanState.Complete
                        else:
                            state <- VersionScanState.Invalid
                    VersionScanState.MinorDigits:
                        if cursor < length and deployment_byte_is_digit(byte):
                            component_digits <- component_digits + 1
                            cursor <- cursor + 1
                            minor_end <- cursor
                        else:
                            state <- VersionScanState.MinorEnd
                    VersionScanState.MinorEnd:
                        if component_digits == 0:
                            state <- VersionScanState.Invalid
                        elif cursor < length and byte == Byte::DOT:
                            cursor <- cursor + 1
                            patch_start <- cursor
                            component_digits <- 0
                            state <- VersionScanState.PatchDigits
                        elif cursor < length and deployment_byte_is_whitespace(byte):
                            state <- VersionScanState.Complete
                        else:
                            state <- VersionScanState.Invalid
                    VersionScanState.PatchDigits:
                        if cursor < length and deployment_byte_is_digit(byte):
                            component_digits <- component_digits + 1
                            cursor <- cursor + 1
                            patch_end <- cursor
                        else:
                            state <- VersionScanState.PatchEnd
                    VersionScanState.PatchEnd:
                        if component_digits == 0:
                            state <- VersionScanState.Invalid
                        elif cursor < length and deployment_byte_is_whitespace(byte):
                            state <- VersionScanState.Complete
                        else:
                            state <- VersionScanState.Invalid
                    VersionScanState.Complete:
                        _ = byte
                    VersionScanState.Invalid:
                        _ = byte
            if state != VersionScanState.Complete:
                return VersionScan{}
            major: DecimalInteger = deployment_decimal_from_range(source, start, major_end)
            minor: DecimalInteger = DecimalInteger{text: "0"} if minor_end == 0 else deployment_decimal_from_range(source, minor_start, minor_end)
            patch: DecimalInteger = DecimalInteger{text: "0"} if patch_end == 0 else deployment_decimal_from_range(source, patch_start, patch_end)
            return VersionScan{matched: true, version: MacosVersion{major: major, minor: minor, patch: patch}}


        def deployment_find_version_field(source: sview, field: sview) -> FieldVersion error[MacosDeploymentTargetError] can[Memory.Allocate, Abort.Panic]:
            field_match: LiteralMatch = deployment_find_word(source, field, 0)
            while field_match.found:
                after_field: usize = field_match.start + sview_len(field)
                if after_field < sview_len(source) and sview_at(source, after_field) == Byte::SPACE:
                    scan: VersionScan = deployment_scan_version(source, after_field + 1)
                    if scan.matched:
                        return FieldVersion{found: true, version: scan.version}
                field_match <- deployment_find_word(source, field, field_match.start + 1)
            return FieldVersion{}


        def deployment_has_macos_platform(source: sview) -> bool:
            field_match: LiteralMatch = deployment_find_word(source, "platform", 0)
            while field_match.found:
                after_field: usize = field_match.start + 8
                if after_field < sview_len(source) and sview_at(source, after_field) == Byte::SPACE:
                    value_start: usize = after_field + 1
                    if deployment_literal_at(source, value_start, "1") and value_start + 1 < sview_len(source) and deployment_byte_is_whitespace(sview_at(source, value_start + 1)):
                        return true
                    if deployment_literal_at(source, value_start, "MACOS") and value_start + 5 < sview_len(source) and deployment_byte_is_whitespace(sview_at(source, value_start + 5)):
                        return true
                    if deployment_literal_at(source, value_start, "macOS") and value_start + 5 < sview_len(source) and deployment_byte_is_whitespace(sview_at(source, value_start + 5)):
                        return true
                field_match <- deployment_find_word(source, "platform", field_match.start + 1)
            return false


        def deployment_segment_target(segment: sview) -> SegmentTarget error[MacosDeploymentTargetError] can[Memory.Allocate, Abort.Panic]:
            modern_command: LiteralMatch = deployment_find_literal(segment, "cmd LC_BUILD_VERSION", 0)
            if modern_command.found:
                raise MacosDeploymentTargetError.NonMacosTarget if not deployment_has_macos_platform(segment)
                minimum: FieldVersion = try deployment_find_version_field(segment, "minos")
                raise MacosDeploymentTargetError.MalformedTarget if not minimum.found
                return SegmentTarget{found: true, version: minimum.version}
            legacy_command: LiteralMatch = deployment_find_literal(segment, "cmd LC_VERSION_MIN_MACOSX", 0)
            if legacy_command.found:
                version_field: FieldVersion = try deployment_find_version_field(segment, "version")
                raise MacosDeploymentTargetError.MalformedTarget if not version_field.found
                return SegmentTarget{found: true, version: version_field.version}
            return SegmentTarget{}


        def deployment_find_load_delimiter(source: sview, start: usize) -> usize:
            length: usize = sview_len(source)
            cursor: mutable usize = start
            while cursor <= length and 13 <= length - cursor |source, cursor|:
                if deployment_literal_at(source, cursor, "Load command "):
                    digit_start: usize = cursor + 13
                    digit_end: mutable usize = digit_start
                    while digit_end < length and deployment_byte_is_digit(sview_at(source, digit_end)) |source, digit_end|:
                        digit_end <- digit_end + 1
                    return cursor if digit_end > digit_start
                cursor <- cursor + 1
            return length


        def deployment_process_segment(source: sview, start: usize, end: usize, targets: mutable darray[MacosVersion]&) -> void error[MacosDeploymentTargetError] can[Memory.Allocate, Abort.Panic]:
            segment: sview = string_view_slice(source, start.i64(), end.i64())
            target: SegmentTarget = try deployment_segment_target(segment)
            if target.found:
                targets.push(target.version)


    public:
        def metal_minimum_macos() -> MacosVersion can[Memory.Allocate, Abort.Panic]:
            return MacosVersion{
                major: deployment_decimal_from_literal(Policy::METAL_MINIMUM_MACOS_MAJOR),
                minor: deployment_decimal_from_literal(Policy::METAL_MINIMUM_MACOS_MINOR),
                patch: deployment_decimal_from_literal(Policy::METAL_MINIMUM_MACOS_PATCH)
            }


        def deployment_targets(load_commands: sview) -> darray[MacosVersion] error[MacosDeploymentTargetError] can[Memory.Allocate, Abort.Panic]:
            length: usize = sview_len(load_commands)
            targets: mutable darray[MacosVersion] = []
            segment_start: mutable usize = 0
            search_start: mutable usize = 0
            delimiter: usize = deployment_find_load_delimiter(load_commands, search_start)
            while delimiter < length |load_commands, targets, segment_start, search_start, delimiter|:
                try deployment_process_segment(load_commands, segment_start, delimiter, targets)
                digit_start: usize = delimiter + 13
                search_start <- digit_start
                while search_start < length and deployment_byte_is_digit(sview_at(load_commands, search_start)) |load_commands, search_start|:
                    search_start <- search_start + 1
                segment_start <- search_start
                delimiter <- deployment_find_load_delimiter(load_commands, search_start)
            try deployment_process_segment(load_commands, segment_start, length, targets)
            raise MacosDeploymentTargetError.NoDeploymentTarget if targets.count == 0
            return targets


        def format_version(version: MacosVersion) -> sview can[Memory.Allocate, Abort.Panic]:
            base: sview = version.major.text + "." + version.minor.text
            return base if version.patch.text == "0" else base + "." + version.patch.text


        def version_before(left: MacosVersion, right: MacosVersion) -> bool:
            return deployment_decimal_before(left.major, right.major) if left.major.text != right.major.text
            return deployment_decimal_before(left.minor, right.minor) if left.minor.text != right.minor.text
            return deployment_decimal_before(left.patch, right.patch) if left.patch.text != right.patch.text
            return false
