# Bounded associative aggregation contract for record streams.
#
# This core models the common AWK/Perl keyed-count operation without exposing a
# host map or relying on nondeterministic iteration order. Adapters can extend
# the entry payload with typed sums after defining their overflow policy.

module EsRecordAggregate:
    public:
        const RECORD_AGGREGATE_MAX_GROUPS: usize = 1048576
        const RECORD_AGGREGATE_MAX_EVENTS: usize = 1048576
        const RECORD_AGGREGATE_MAX_KEY_BYTES: usize = 268435456


        const enum RecordAggregateState of u8:
            Planned
            Collecting
            Sealed
            Failed
            Cancelled


        const enum RecordAggregateEvent of u8:
            Begin
            Add
            Seal
            Fail
            Cancel


        struct RecordAggregatePolicy:
            max_groups: usize = RECORD_AGGREGATE_MAX_GROUPS
            max_events: usize = RECORD_AGGREGATE_MAX_EVENTS
            max_key_bytes: usize = RECORD_AGGREGATE_MAX_KEY_BYTES


        struct RecordAggregateGroup:
            key: sview
            count: usize = 0
            first_ordinal: usize = 0


        struct RecordAggregateSession:
            policy: RecordAggregatePolicy
            state: RecordAggregateState = RecordAggregateState.Planned
            groups: darray[RecordAggregateGroup] = []
            event_count: usize = 0
            key_bytes: usize = 0


        error RecordAggregateError:
            InvalidState
            InvalidEvent
            PolicyInvalid
            KeyInvalid
            GroupLimitExceeded
            EventLimitExceeded
            KeyBytesLimitExceeded
            OrdinalInvalid
            GroupIndexInvalid
            LookupNotReady
            CancelNotReady


    private:
        def record_aggregate_state_valid(state: RecordAggregateState) -> bool:
            return state in {RecordAggregateState.Planned, RecordAggregateState.Collecting, RecordAggregateState.Sealed, RecordAggregateState.Failed, RecordAggregateState.Cancelled}


        def record_aggregate_event_valid(event: RecordAggregateEvent) -> bool:
            return event in {RecordAggregateEvent.Begin, RecordAggregateEvent.Add, RecordAggregateEvent.Seal, RecordAggregateEvent.Fail, RecordAggregateEvent.Cancel}


        def record_aggregate_policy_valid(policy: RecordAggregatePolicy) -> bool:
            return policy.max_groups != 0 and policy.max_groups <= RECORD_AGGREGATE_MAX_GROUPS and policy.max_events != 0 and policy.max_events <= RECORD_AGGREGATE_MAX_EVENTS and policy.max_key_bytes != 0 and policy.max_key_bytes <= RECORD_AGGREGATE_MAX_KEY_BYTES


        def record_aggregate_key_valid(key: sview, policy: RecordAggregatePolicy) -> bool:
            return sview_len(key) < policy.max_key_bytes and not sview_contains_byte(key, 0)


        def record_aggregate_index(session: RecordAggregateSession&, key: sview) -> usize:
            for index in 0..<session.groups.count |session, key|:
                return index if session.groups[index].key == key
            return session.groups.count


    public:
        def validate_record_aggregate(session: RecordAggregateSession&) -> bool error[RecordAggregateError]:
            raise RecordAggregateError.InvalidState if not record_aggregate_state_valid(session.state)
            raise RecordAggregateError.PolicyInvalid if not record_aggregate_policy_valid(session.policy)
            raise RecordAggregateError.GroupLimitExceeded if session.groups.count > session.policy.max_groups
            raise RecordAggregateError.EventLimitExceeded if session.event_count > session.policy.max_events
            raise RecordAggregateError.KeyBytesLimitExceeded if session.key_bytes > session.policy.max_key_bytes
            accounted_keys: mutable usize = 0
            for index in 0..<session.groups.count |session, accounted_keys|:
                group: RecordAggregateGroup = session.groups[index]
                raise RecordAggregateError.KeyInvalid if not record_aggregate_key_valid(group.key, session.policy)
                raise RecordAggregateError.OrdinalInvalid if group.first_ordinal >= session.event_count and session.event_count != 0
                raise RecordAggregateError.EventLimitExceeded if group.count == 0 or group.count > session.event_count
                for earlier in 0..<index |session, group|:
                    raise RecordAggregateError.KeyInvalid if session.groups[earlier].key == group.key
                raise RecordAggregateError.KeyBytesLimitExceeded if sview_len(group.key) > session.policy.max_key_bytes - accounted_keys
                accounted_keys <- accounted_keys + sview_len(group.key)
            raise RecordAggregateError.KeyBytesLimitExceeded if accounted_keys != session.key_bytes
            return true


        def record_aggregate_group_count(session: RecordAggregateSession&, key: sview) -> usize error[RecordAggregateError]:
            try validate_record_aggregate(session)
            raise RecordAggregateError.LookupNotReady if session.state != RecordAggregateState.Sealed
            raise RecordAggregateError.KeyInvalid if not record_aggregate_key_valid(key, session.policy)
            index: usize = record_aggregate_index(session, key)
            raise RecordAggregateError.GroupIndexInvalid if index == session.groups.count
            return session.groups[index].count


        def advance_record_aggregate(session: mutable RecordAggregateSession&, event: RecordAggregateEvent, key: sview = "") -> RecordAggregateState error[RecordAggregateError]:
            try validate_record_aggregate(session)
            raise RecordAggregateError.InvalidEvent if not record_aggregate_event_valid(event)
            if event == RecordAggregateEvent.Begin:
                raise RecordAggregateError.InvalidState if session.state != RecordAggregateState.Planned
                session.state <- RecordAggregateState.Collecting
            elif event == RecordAggregateEvent.Add:
                raise RecordAggregateError.InvalidState if session.state != RecordAggregateState.Collecting
                raise RecordAggregateError.EventLimitExceeded if session.event_count >= session.policy.max_events
                raise RecordAggregateError.KeyInvalid if not record_aggregate_key_valid(key, session.policy)
                index: usize = record_aggregate_index(session, key)
                if index == session.groups.count:
                    raise RecordAggregateError.GroupLimitExceeded if session.groups.count >= session.policy.max_groups
                    raise RecordAggregateError.KeyBytesLimitExceeded if sview_len(key) > session.policy.max_key_bytes - session.key_bytes
                    session.groups.push(RecordAggregateGroup{key: key, count: 1, first_ordinal: session.event_count})
                    session.key_bytes <- session.key_bytes + sview_len(key)
                else:
                    raise RecordAggregateError.EventLimitExceeded if session.groups[index].count >= session.policy.max_events
                    session.groups[index].count <- session.groups[index].count + 1
                session.event_count <- session.event_count + 1
            elif event == RecordAggregateEvent.Seal:
                raise RecordAggregateError.InvalidState if session.state != RecordAggregateState.Collecting
                session.state <- RecordAggregateState.Sealed
            elif event == RecordAggregateEvent.Fail:
                raise RecordAggregateError.InvalidState if session.state != RecordAggregateState.Collecting
                session.state <- RecordAggregateState.Failed
            elif event == RecordAggregateEvent.Cancel:
                raise RecordAggregateError.CancelNotReady if session.state != RecordAggregateState.Planned and session.state != RecordAggregateState.Collecting
                session.state <- RecordAggregateState.Cancelled
            return session.state
