# Deterministic XML Info.plist metadata for the Elisa Engine macOS app packager.

module EsMacosAppInfoPlist:
    using EsEncoding
    using EsMacosDeploymentTarget

    public:
        struct MacosAppInfoPlist:
            bundle_name: sview
            bundle_id: sview
            version: sview
            minimum_os: MacosVersion
            has_icon: bool = false


        error MacosAppInfoPlistError:
            InvalidXmlText


    private:
        const module Xml:
            HEADER: sview = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n"
            FOOTER: sview = "</dict>\n</plist>\n"


        const module Key:
            DEVELOPMENT_REGION: sview = "CFBundleDevelopmentRegion"
            DISPLAY_NAME: sview = "CFBundleDisplayName"
            EXECUTABLE: sview = "CFBundleExecutable"
            IDENTIFIER: sview = "CFBundleIdentifier"
            INFO_DICTIONARY_VERSION: sview = "CFBundleInfoDictionaryVersion"
            NAME: sview = "CFBundleName"
            PACKAGE_TYPE: sview = "CFBundlePackageType"
            SHORT_VERSION: sview = "CFBundleShortVersionString"
            VERSION: sview = "CFBundleVersion"
            MINIMUM_SYSTEM_VERSION: sview = "LSMinimumSystemVersion"
            HIGH_RESOLUTION: sview = "NSHighResolutionCapable"
            ICON_FILE: sview = "CFBundleIconFile"


        def macos_app_info_plist_text_valid(value: sview) -> bool error[MacosAppInfoPlistError]:
            cursor: mutable Utf8Cursor = Utf8Cursor{}
            for byte in value |cursor|:
                raise MacosAppInfoPlistError.InvalidXmlText if byte < 32 and byte != 9 and byte != 10 and byte != 13
                raise MacosAppInfoPlistError.InvalidXmlText if not utf8_feed(byte, cursor)
            raise MacosAppInfoPlistError.InvalidXmlText if not utf8_complete(cursor)
            return true


        def macos_app_info_plist_append_text(output: mutable darray[u8]&, text: sview) -> void can[Memory.Allocate, Abort.Panic]:
            for byte in text |output|:
                output.push(byte)


        def macos_app_info_plist_append_escaped(output: mutable darray[u8]&, text: sview) -> void can[Memory.Allocate, Abort.Panic]:
            for byte in text |output|:
                if byte == 38:
                    try macos_app_info_plist_append_text(output, "&amp;")
                elif byte == 60:
                    try macos_app_info_plist_append_text(output, "&lt;")
                elif byte == 62:
                    try macos_app_info_plist_append_text(output, "&gt;")
                else:
                    output.push(byte)


        def macos_app_info_plist_append_string(output: mutable darray[u8]&, key: sview, value: sview) -> void can[Memory.Allocate, Abort.Panic]:
            try macos_app_info_plist_append_text(output, "\t<key>")
            try macos_app_info_plist_append_text(output, key)
            try macos_app_info_plist_append_text(output, "</key>\n\t<string>")
            try macos_app_info_plist_append_escaped(output, value)
            try macos_app_info_plist_append_text(output, "</string>\n")


    public:
        # Preserve plistlib's insertion order; consumers use XML plist semantics,
        # and this stable order also makes the document easy to diff.
        def macos_app_info_plist_xml(info: MacosAppInfoPlist) -> darray[u8] error[MacosAppInfoPlistError] can[Memory.Allocate, Abort.Panic]:
            try macos_app_info_plist_text_valid(info.bundle_name)
            try macos_app_info_plist_text_valid(info.bundle_id)
            try macos_app_info_plist_text_valid(info.version)
            minimum_os: sview = format_version(info.minimum_os)
            output: mutable darray[u8] = []
            try macos_app_info_plist_append_text(output, Xml::HEADER)
            try macos_app_info_plist_append_string(output, Key::DEVELOPMENT_REGION, "en")
            try macos_app_info_plist_append_string(output, Key::DISPLAY_NAME, info.bundle_name)
            try macos_app_info_plist_append_string(output, Key::EXECUTABLE, info.bundle_name)
            try macos_app_info_plist_append_string(output, Key::IDENTIFIER, info.bundle_id)
            try macos_app_info_plist_append_string(output, Key::INFO_DICTIONARY_VERSION, "6.0")
            try macos_app_info_plist_append_string(output, Key::NAME, info.bundle_name)
            try macos_app_info_plist_append_string(output, Key::PACKAGE_TYPE, "APPL")
            try macos_app_info_plist_append_string(output, Key::SHORT_VERSION, info.version)
            try macos_app_info_plist_append_string(output, Key::VERSION, info.version)
            try macos_app_info_plist_append_string(output, Key::MINIMUM_SYSTEM_VERSION, minimum_os)
            try macos_app_info_plist_append_text(output, "\t<key>")
            try macos_app_info_plist_append_text(output, Key::HIGH_RESOLUTION)
            try macos_app_info_plist_append_text(output, "</key>\n\t<true/>\n")
            if info.has_icon:
                try macos_app_info_plist_append_string(output, Key::ICON_FILE, "AppIcon.icns")
            try macos_app_info_plist_append_text(output, Xml::FOOTER)
            return output
