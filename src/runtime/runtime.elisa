# Qualified host-runtime namespace. Platform bridge files extend this module
# with private C ABI declarations and public typed forwarding operations.

module EsRuntime:
    public:
        # Bump when the public host-operation contract changes. This is metadata
        # for artifact/tooling checks, not a platform ABI version.
        const ES_RUNTIME_CONTRACT_VERSION: u8 = 1
        # POSIX retries are bounded rather than treating an interrupted host
        # call as a permanent language error. The value is stable across the
        # supported Darwin/POSIX errno ABI and is kept in the runtime module so
        # higher layers do not duplicate a platform magic number.
        const ES_RUNTIME_ERRNO_EINTR: int = 4
        # A parent-side setpgid may observe EACCES after the child has already
        # established its own group and crossed exec. In that race the group
        # admission is still confirmed by the child-side setpgid edge.
        const ES_RUNTIME_ERRNO_EACCES: int = 13
