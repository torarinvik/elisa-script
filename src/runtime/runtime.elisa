# Qualified host-runtime namespace. Platform bridge files extend this module
# with private C ABI declarations and public typed forwarding operations.

module EsRuntime:
    public:
        # Bump when the public host-operation contract changes. This is metadata
        # for artifact/tooling checks, not a platform ABI version.
        const module Contract:
            VERSION: u8 = 1


        # Platform errno values belong to the Darwin adapter namespace; another
        # host target can supply its own values without changing callers' policy.
        const module DarwinErrno:
            # Retries are bounded rather than treating interruption as a
            # permanent language error.
            EINTR: int = 4
            # A parent-side setpgid may observe EACCES after the child has
            # established its own group and crossed exec. In that race the
            # group admission is confirmed by the child-side setpgid edge.
            EACCES: int = 13
