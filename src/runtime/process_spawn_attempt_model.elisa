# Darwin posix_spawn return admission. Nonzero positive return codes are errno
# values, not wait statuses and not values read from the thread's errno slot.
include "process_exec_search_model.elisa"

module EsProcessSpawnAttempt:
    public:
        const enum Kind of u8:
            Spawned
            NoChild
            Unknown


        const enum Decision of u8:
            AdoptChild
            NextCandidate
            NextDenied
            StopNoChild
            StopUncertain


        struct Attempt:
            kind: Kind
            pid: i32
            code: i32


        def classify(code: i32, reported_pid: i32) -> Attempt:
            # PID/group 1 is not an admissible owned Darwin spawn group: its
            # negation is kill(-1), the broadcast selector, not group signaling.
            return Attempt{kind: Kind.Spawned, pid: reported_pid, code: code} if code == 0 and reported_pid > 1
            # Darwin documents no child on failure. Ignore unspecified PID
            # output on a positive failure return; never signal that number.
            return Attempt{kind: Kind.NoChild, pid: 0, code: code} if code > 0
            return Attempt{kind: Kind.Unknown, pid: reported_pid, code: code}


        def decide(attempt: Attempt) -> Decision:
            if attempt.kind == Kind.Spawned:
                return Decision.AdoptChild if attempt.code == 0 and attempt.pid > 1
                return Decision.StopUncertain
            if attempt.kind == Kind.NoChild:
                return Decision.StopUncertain if attempt.code <= 0 or attempt.pid != 0
                action: EsProcessExecSearch::Action = EsProcessExecSearch::after_failure(attempt.code)
                return Decision.NextCandidate if action == EsProcessExecSearch::Action.Next
                return Decision.NextDenied if action == EsProcessExecSearch::Action.NextDenied
                return Decision.StopNoChild
            return Decision.StopUncertain
