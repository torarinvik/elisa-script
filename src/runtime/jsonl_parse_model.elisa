# Bounded one-record-at-a-time JSON Lines parsing.
#
# The whole-view reader borrows its input; the chunk reader retains only one
# bounded record buffer. Both carry cumulative budgets and return each
# completed document to the caller without retaining a document collection.

module EsJsonLinesParse:
    using EsData
    using EsJson
    using EsJsonLex
    using EsJsonParse
    using EsJsonStream

    public:
        const JSON_LINES_PARSE_FORMAT_VERSION: u8 = 2


        struct JsonLinesReader:
            format_version: u8 = JSON_LINES_PARSE_FORMAT_VERSION
            source: sview
            source_bytes: usize
            limits: DataDecodeLimits
            json_policy: JsonPolicy = JsonPolicy{}
            stream: JsonStreamSession
            decoder: DataDecoder
            offset: usize = 0
            record_start: usize = 0
            failure_record_number: usize = 0
            failure_record_start: usize = 0


        struct JsonLinesReadResult:
            has_document: bool = false
            record_number: usize = 0
            source_offset: usize = 0
            document: JsonDocument = JsonDocument{}


        const enum JsonLinesFeedOutcome of u8:
            NeedInput
            Document
            Complete


        struct JsonLinesChunkReader:
            format_version: u8 = JSON_LINES_PARSE_FORMAT_VERSION
            limits: DataDecodeLimits
            json_policy: JsonPolicy = JsonPolicy{}
            stream: JsonStreamSession
            decoder: DataDecoder
            record_buffer: darray[u8] = []
            offset: usize = 0
            record_start: usize = 0
            final_input_pending: bool = false
            final_bytes_remaining: usize = 0
            failure_record_number: usize = 0
            failure_record_start: usize = 0


        struct JsonLinesFeedResult:
            outcome: JsonLinesFeedOutcome = JsonLinesFeedOutcome.NeedInput
            consumed_bytes: usize = 0
            record_number: usize = 0
            source_offset: usize = 0
            document: JsonDocument = JsonDocument{}


        error JsonLinesParseError:
            InvalidFormatVersion
            InvalidState
            InvalidSource
            AccountingInvalid
            TokenLimitExceeded
            FieldLimitExceeded
            FieldBytesLimitExceeded


    private:
        def json_lines_min(left: usize, right: usize) -> usize:
            return left if left < right else right


        def json_lines_record_is_whitespace(source: sview, start: usize, end: usize) -> bool:
            cursor: mutable usize = start
            while cursor < end:
                byte: u8 = sview_at(source, cursor)
                return false if byte != 9u8 and byte != 10u8 and byte != 13u8 and byte != 32u8
                cursor <- cursor + 1
            return true


        def json_lines_reader_state_valid(reader: JsonLinesReader&) -> bool error[JsonLinesParseError, JsonStreamError, DataContractError]:
            try validate_json_stream(reader.stream)
            try validate_data_decoder(reader.decoder)
            try validate_json_policy(reader.json_policy)
            raise JsonLinesParseError.InvalidFormatVersion if reader.format_version != JSON_LINES_PARSE_FORMAT_VERSION
            raise JsonLinesParseError.InvalidSource if reader.source_bytes != sview_len(reader.source)
            raise JsonLinesParseError.AccountingInvalid if reader.offset != reader.stream.input_bytes
            raise JsonLinesParseError.AccountingInvalid if reader.record_start > reader.source_bytes or reader.record_start > reader.offset
            raise JsonLinesParseError.AccountingInvalid if reader.stream.policy.max_input_bytes > reader.limits.input_bytes
            raise JsonLinesParseError.AccountingInvalid if reader.stream.policy.max_record_bytes > reader.limits.input_bytes
            raise JsonLinesParseError.AccountingInvalid if reader.stream.policy.max_records > reader.limits.records
            raise JsonLinesParseError.AccountingInvalid if reader.stream.policy.max_depth > reader.limits.depth
            raise JsonLinesParseError.AccountingInvalid if reader.decoder.format != DataFormat.JsonLines
            raise JsonLinesParseError.AccountingInvalid if reader.decoder.limits.input_bytes != reader.limits.input_bytes or reader.decoder.limits.tokens != reader.limits.tokens or reader.decoder.limits.depth != reader.limits.depth or reader.decoder.limits.records != reader.limits.records or reader.decoder.limits.fields != reader.limits.fields or reader.decoder.limits.field_bytes != reader.limits.field_bytes
            if reader.stream.state == JsonStreamState.Reading:
                raise JsonLinesParseError.InvalidState if reader.decoder.state != DataDecoderState.Decoding
                raise JsonLinesParseError.AccountingInvalid if reader.stream.record_bytes != 0
                raise JsonLinesParseError.AccountingInvalid if reader.decoder.input_bytes != reader.stream.input_bytes
                raise JsonLinesParseError.AccountingInvalid if reader.decoder.records != reader.stream.records
                raise JsonLinesParseError.AccountingInvalid if reader.failure_record_number != 0 or reader.failure_record_start != 0
            elif reader.stream.state == JsonStreamState.Complete:
                raise JsonLinesParseError.InvalidState if reader.decoder.state != DataDecoderState.Complete
                raise JsonLinesParseError.AccountingInvalid if reader.offset != reader.source_bytes
                raise JsonLinesParseError.AccountingInvalid if reader.decoder.input_bytes != reader.stream.input_bytes
                raise JsonLinesParseError.AccountingInvalid if reader.decoder.records != reader.stream.records
                raise JsonLinesParseError.AccountingInvalid if reader.failure_record_number != 0 or reader.failure_record_start != 0
            elif reader.stream.state == JsonStreamState.Failed:
                raise JsonLinesParseError.InvalidState if reader.decoder.state != DataDecoderState.Failed
                raise JsonLinesParseError.AccountingInvalid if reader.failure_record_number == 0
                raise JsonLinesParseError.AccountingInvalid if reader.failure_record_start > reader.source_bytes
            else:
                raise JsonLinesParseError.InvalidState
            return true


        def json_lines_parse_record(record_source: sview, limits: DataDecodeLimits, policy: JsonPolicy, decoder: mutable DataDecoder&, framed_bytes: usize) -> JsonDocument error[JsonLinesParseError, DataContractError, JsonLexError, JsonParseError, JsonContractError] can[Memory.Allocate, Abort.Panic]:
            raise JsonLinesParseError.InvalidSource if framed_bytes < sview_len(record_source)
            lexed: JsonLexedSource = try lex_json(record_source, limits, policy)
            raise JsonLinesParseError.TokenLimitExceeded if lexed.tokens.count > limits.tokens - decoder.tokens
            document: JsonDocument = try parse_json_document(lexed)
            raise JsonLinesParseError.FieldLimitExceeded if document.members.count > limits.fields - decoder.fields
            raise JsonLinesParseError.FieldBytesLimitExceeded if document.key_bytes.count > framed_bytes
            raise JsonLinesParseError.FieldBytesLimitExceeded if document.scalar_data.count > framed_bytes - document.key_bytes.count
            record_field_bytes: usize = document.key_bytes.count + document.scalar_data.count
            raise JsonLinesParseError.FieldBytesLimitExceeded if record_field_bytes > limits.field_bytes - decoder.field_bytes
            for _ in 0..<lexed.tokens.count |decoder, document|:
                _ = try advance_data_decoder(decoder, DataDecoderEvent.Token, 0, 0, document.max_depth, 0)
            _ = try advance_data_decoder(decoder, DataDecoderEvent.Record, framed_bytes, document.members.count, 0, record_field_bytes)
            return document


        def json_lines_record_document(reader: mutable JsonLinesReader&, start: usize, end: usize, framed_bytes: usize) -> JsonDocument error[JsonLinesParseError, JsonStreamError, DataContractError, JsonLexError, JsonParseError, JsonContractError] can[Memory.Allocate, Abort.Panic]:
            raise JsonLinesParseError.InvalidSource if start > end or end > reader.source_bytes
            record_source: sview = string_view_slice(reader.source, start.i64(), end.i64())
            return try json_lines_parse_record(record_source, reader.limits, reader.json_policy, reader.decoder, framed_bytes)


        def json_lines_skip_empty_record(decoder: mutable DataDecoder&, framed_bytes: usize) -> void error[DataContractError]:
            # Empty records accepted by policy are counted and skipped; they
            # do not represent a JSON value or produce an empty document.
            _ = try advance_data_decoder(decoder, DataDecoderEvent.Record, framed_bytes, 0, 0, 0)


        def json_lines_next_impl(reader: mutable JsonLinesReader&) -> JsonLinesReadResult error[JsonLinesParseError, JsonStreamError, DataContractError, JsonLexError, JsonParseError, JsonContractError] can[Memory.Allocate, Abort.Panic]:
            if reader.stream.state == JsonStreamState.Complete:
                return JsonLinesReadResult{}
            raise JsonLinesParseError.InvalidState if reader.stream.state != JsonStreamState.Reading
            while reader.offset < reader.source_bytes:
                byte: u8 = sview_at(reader.source, reader.offset)
                is_record_separator: bool = json_stream_byte_is_boundary_candidate(reader.stream, byte)
                current_offset: usize = reader.offset
                if is_record_separator:
                    start: usize = reader.record_start
                    end: usize = current_offset
                    if reader.stream.pending_cr:
                        raise JsonLinesParseError.AccountingInvalid if current_offset == start
                        end <- current_offset - 1
                    _ = try advance_json_stream(reader.stream, JsonStreamEvent.Byte, byte)
                    reader.offset <- reader.offset + 1
                    framed_bytes: usize = reader.offset - start
                    if reader.stream.policy.allow_empty_records and json_lines_record_is_whitespace(reader.source, start, end):
                        _ = try json_lines_skip_empty_record(reader.decoder, framed_bytes)
                        reader.record_start <- reader.offset
                    else:
                        document: JsonDocument = try json_lines_record_document(reader, start, end, framed_bytes)
                        record_number: usize = reader.stream.records
                        reader.record_start <- reader.offset
                        return JsonLinesReadResult{has_document: true, record_number: record_number, source_offset: start, document: document}
                else:
                    _ = try advance_json_stream(reader.stream, JsonStreamEvent.Byte, byte)
                    reader.offset <- reader.offset + 1
            if reader.stream.record_bytes != 0 or reader.stream.pending_cr:
                start: usize = reader.record_start
                end: usize = reader.source_bytes
                framed_bytes: usize = end - start
                if reader.stream.policy.allow_empty_records and json_lines_record_is_whitespace(reader.source, start, end):
                    _ = try advance_json_stream(reader.stream, JsonStreamEvent.RecordEnd)
                    _ = try json_lines_skip_empty_record(reader.decoder, framed_bytes)
                    reader.record_start <- end
                    _ = try advance_json_stream(reader.stream, JsonStreamEvent.End)
                    _ = try advance_data_decoder(reader.decoder, DataDecoderEvent.End)
                    return JsonLinesReadResult{}
                _ = try advance_json_stream(reader.stream, JsonStreamEvent.RecordEnd)
                document: JsonDocument = try json_lines_record_document(reader, start, end, framed_bytes)
                record_number: usize = reader.stream.records
                reader.record_start <- end
                _ = try advance_json_stream(reader.stream, JsonStreamEvent.End)
                _ = try advance_data_decoder(reader.decoder, DataDecoderEvent.End)
                return JsonLinesReadResult{has_document: true, record_number: record_number, source_offset: start, document: document}
            _ = try advance_json_stream(reader.stream, JsonStreamEvent.End)
            _ = try advance_data_decoder(reader.decoder, DataDecoderEvent.End)
            return JsonLinesReadResult{}


        def json_lines_chunk_reader_state_valid(reader: JsonLinesChunkReader&) -> bool error[JsonLinesParseError, JsonStreamError, DataContractError]:
            try validate_json_stream(reader.stream)
            try validate_data_decoder(reader.decoder)
            try validate_json_policy(reader.json_policy)
            raise JsonLinesParseError.InvalidFormatVersion if reader.format_version != JSON_LINES_PARSE_FORMAT_VERSION
            raise JsonLinesParseError.AccountingInvalid if reader.offset != reader.stream.input_bytes
            raise JsonLinesParseError.AccountingInvalid if reader.record_start > reader.offset
            raise JsonLinesParseError.AccountingInvalid if reader.stream.policy.max_input_bytes > reader.limits.input_bytes
            raise JsonLinesParseError.AccountingInvalid if reader.stream.policy.max_record_bytes > reader.limits.input_bytes
            raise JsonLinesParseError.AccountingInvalid if reader.stream.policy.max_records > reader.limits.records
            raise JsonLinesParseError.AccountingInvalid if reader.stream.policy.max_depth > reader.limits.depth
            raise JsonLinesParseError.AccountingInvalid if reader.decoder.format != DataFormat.JsonLines
            raise JsonLinesParseError.AccountingInvalid if reader.decoder.limits.input_bytes != reader.limits.input_bytes or reader.decoder.limits.tokens != reader.limits.tokens or reader.decoder.limits.depth != reader.limits.depth or reader.decoder.limits.records != reader.limits.records or reader.decoder.limits.fields != reader.limits.fields or reader.decoder.limits.field_bytes != reader.limits.field_bytes
            raise JsonLinesParseError.AccountingInvalid if reader.record_buffer.count > reader.stream.policy.max_record_bytes
            if reader.stream.state == JsonStreamState.Reading:
                raise JsonLinesParseError.InvalidState if reader.decoder.state != DataDecoderState.Decoding
                raise JsonLinesParseError.AccountingInvalid if reader.record_buffer.count != reader.stream.record_bytes
                raise JsonLinesParseError.AccountingInvalid if reader.decoder.input_bytes > reader.stream.input_bytes
                if reader.stream.pending_cr:
                    raise JsonLinesParseError.AccountingInvalid if reader.stream.input_bytes - reader.decoder.input_bytes == 0
                    raise JsonLinesParseError.AccountingInvalid if reader.stream.input_bytes - reader.decoder.input_bytes - 1 != reader.stream.record_bytes
                else:
                    raise JsonLinesParseError.AccountingInvalid if reader.stream.input_bytes - reader.decoder.input_bytes != reader.stream.record_bytes
                raise JsonLinesParseError.AccountingInvalid if reader.decoder.records != reader.stream.records
                if reader.stream.pending_cr:
                    raise JsonLinesParseError.AccountingInvalid if reader.offset == reader.record_start
                    raise JsonLinesParseError.AccountingInvalid if reader.offset - reader.record_start - 1 != reader.stream.record_bytes
                else:
                    raise JsonLinesParseError.AccountingInvalid if reader.offset - reader.record_start != reader.stream.record_bytes
                raise JsonLinesParseError.InvalidState if reader.final_input_pending and reader.final_bytes_remaining == 0
                raise JsonLinesParseError.AccountingInvalid if not reader.final_input_pending and reader.final_bytes_remaining != 0
                raise JsonLinesParseError.AccountingInvalid if reader.failure_record_number != 0 or reader.failure_record_start != 0
            elif reader.stream.state == JsonStreamState.Complete:
                raise JsonLinesParseError.InvalidState if reader.decoder.state != DataDecoderState.Complete
                raise JsonLinesParseError.AccountingInvalid if reader.record_buffer.count != 0
                raise JsonLinesParseError.AccountingInvalid if reader.decoder.input_bytes != reader.stream.input_bytes
                raise JsonLinesParseError.AccountingInvalid if reader.decoder.records != reader.stream.records
                raise JsonLinesParseError.AccountingInvalid if reader.final_input_pending or reader.final_bytes_remaining != 0
                raise JsonLinesParseError.AccountingInvalid if reader.failure_record_number != 0 or reader.failure_record_start != 0
            elif reader.stream.state == JsonStreamState.Failed:
                raise JsonLinesParseError.InvalidState if reader.decoder.state != DataDecoderState.Failed
                raise JsonLinesParseError.AccountingInvalid if reader.failure_record_number == 0
                raise JsonLinesParseError.AccountingInvalid if reader.failure_record_start > reader.offset
            else:
                raise JsonLinesParseError.InvalidState
            return true


        def json_lines_chunk_record_view(reader: JsonLinesChunkReader&) -> sview:
            data: u8& = (&reader.record_buffer[0]).cast[u8&]
            return sview(data, 0, reader.record_buffer.count.i64())


        def json_lines_parse_chunk_record(reader: mutable JsonLinesChunkReader&, framed_bytes: usize) -> JsonDocument error[JsonLinesParseError, DataContractError, JsonLexError, JsonParseError, JsonContractError] can[Memory.Allocate, Abort.Panic]:
            record_source: sview = json_lines_chunk_record_view(reader)
            return try json_lines_parse_record(record_source, reader.limits, reader.json_policy, reader.decoder, framed_bytes)


        def json_lines_finish_chunk_input(reader: mutable JsonLinesChunkReader&) -> JsonLinesFeedResult error[JsonLinesParseError, JsonStreamError, DataContractError, JsonLexError, JsonParseError, JsonContractError] can[Memory.Allocate, Abort.Panic]:
            reader.final_input_pending <- false
            reader.final_bytes_remaining <- 0
            if reader.stream.record_bytes != 0 or reader.stream.pending_cr:
                if reader.stream.pending_cr:
                    reader.record_buffer.push(13u8)
                framed_bytes: usize = reader.offset - reader.record_start
                source_offset: usize = reader.record_start
                if reader.stream.policy.allow_empty_records and json_lines_record_is_whitespace(json_lines_chunk_record_view(reader), 0, reader.record_buffer.count):
                    _ = try advance_json_stream(reader.stream, JsonStreamEvent.RecordEnd)
                    _ = try json_lines_skip_empty_record(reader.decoder, framed_bytes)
                    reader.record_buffer.truncate(0)
                    reader.record_start <- reader.offset
                    _ = try advance_json_stream(reader.stream, JsonStreamEvent.End)
                    _ = try advance_data_decoder(reader.decoder, DataDecoderEvent.End)
                    return JsonLinesFeedResult{outcome: JsonLinesFeedOutcome.Complete}
                _ = try advance_json_stream(reader.stream, JsonStreamEvent.RecordEnd)
                document: JsonDocument = try json_lines_parse_chunk_record(reader, framed_bytes)
                record_number: usize = reader.stream.records
                reader.record_buffer.truncate(0)
                reader.record_start <- reader.offset
                _ = try advance_json_stream(reader.stream, JsonStreamEvent.End)
                _ = try advance_data_decoder(reader.decoder, DataDecoderEvent.End)
                return JsonLinesFeedResult{outcome: JsonLinesFeedOutcome.Document, record_number: record_number, source_offset: source_offset, document: document}
            _ = try advance_json_stream(reader.stream, JsonStreamEvent.End)
            _ = try advance_data_decoder(reader.decoder, DataDecoderEvent.End)
            return JsonLinesFeedResult{outcome: JsonLinesFeedOutcome.Complete}


        def json_lines_feed_chunk_impl(reader: mutable JsonLinesChunkReader&, chunk: sview, final_chunk: bool) -> JsonLinesFeedResult error[JsonLinesParseError, JsonStreamError, DataContractError, JsonLexError, JsonParseError, JsonContractError] can[Memory.Allocate, Abort.Panic]:
            chunk_bytes: usize = sview_len(chunk)
            cursor: mutable usize = 0
            while cursor < chunk_bytes:
                byte: u8 = sview_at(chunk, cursor)
                is_record_separator: bool = json_stream_byte_is_boundary_candidate(reader.stream, byte)
                if is_record_separator:
                    source_offset: usize = reader.record_start
                    _ = try advance_json_stream(reader.stream, JsonStreamEvent.Byte, byte)
                    reader.offset <- reader.offset + 1
                    cursor <- cursor + 1
                    framed_bytes: usize = reader.offset - source_offset
                    empty_payload: mutable bool = reader.record_buffer.count == 0
                    if not empty_payload:
                        empty_payload <- json_lines_record_is_whitespace(json_lines_chunk_record_view(reader), 0, reader.record_buffer.count)
                    if reader.stream.policy.allow_empty_records and empty_payload:
                        _ = try json_lines_skip_empty_record(reader.decoder, framed_bytes)
                        reader.record_buffer.truncate(0)
                        reader.record_start <- reader.offset
                    else:
                        document: JsonDocument = try json_lines_parse_chunk_record(reader, framed_bytes)
                        record_number: usize = reader.stream.records
                        reader.record_buffer.truncate(0)
                        reader.record_start <- reader.offset
                        if final_chunk:
                            if cursor == chunk_bytes:
                                _ = try advance_json_stream(reader.stream, JsonStreamEvent.End)
                                _ = try advance_data_decoder(reader.decoder, DataDecoderEvent.End)
                            else:
                                reader.final_input_pending <- true
                                reader.final_bytes_remaining <- chunk_bytes - cursor
                        return JsonLinesFeedResult{outcome: JsonLinesFeedOutcome.Document, consumed_bytes: cursor, record_number: record_number, source_offset: source_offset, document: document}
                else:
                    pending_cr_before: bool = reader.stream.pending_cr
                    _ = try advance_json_stream(reader.stream, JsonStreamEvent.Byte, byte)
                    deferred_current_cr: bool = byte == 13u8 and reader.stream.pending_cr
                    if pending_cr_before:
                        reader.record_buffer.push(13u8)
                    if not deferred_current_cr:
                        reader.record_buffer.push(byte)
                    reader.offset <- reader.offset + 1
                    cursor <- cursor + 1
            if final_chunk:
                result: mutable JsonLinesFeedResult = try json_lines_finish_chunk_input(reader)
                result.consumed_bytes <- chunk_bytes
                return result
            return JsonLinesFeedResult{outcome: JsonLinesFeedOutcome.NeedInput, consumed_bytes: chunk_bytes}


    public:
        def begin_json_lines_reader(source: sview, limits: DataDecodeLimits = DataDecodeLimits{}, policy: JsonPolicy = JsonPolicy{}, framing: JsonStreamPolicy = JsonStreamPolicy{}) -> JsonLinesReader error[DataContractError, JsonStreamError] can[Memory.Allocate, Abort.Panic]:
            try validate_data_decoder(DataDecoder{format: DataFormat.JsonLines, limits: limits})
            try validate_json_policy(policy)
            _ = try validate_json_stream(JsonStreamSession{policy: framing})
            effective_input_bytes: usize = json_lines_min(framing.max_input_bytes, limits.input_bytes)
            effective_record_bytes: usize = json_lines_min(json_lines_min(framing.max_record_bytes, effective_input_bytes), limits.input_bytes)
            effective_records: usize = json_lines_min(framing.max_records, limits.records)
            effective_depth: usize = json_lines_min(framing.max_depth, limits.depth)
            effective_framing: JsonStreamPolicy = JsonStreamPolicy{max_input_bytes: effective_input_bytes, max_record_bytes: effective_record_bytes, max_records: effective_records, max_depth: effective_depth, allow_empty_records: framing.allow_empty_records, record_boundary: framing.record_boundary}
            stream: mutable JsonStreamSession = JsonStreamSession{policy: effective_framing}
            _ = try advance_json_stream(stream, JsonStreamEvent.Begin)
            decoder: mutable DataDecoder = DataDecoder{format: DataFormat.JsonLines, limits: limits}
            _ = try advance_data_decoder(decoder, DataDecoderEvent.Begin)
            return JsonLinesReader{source: source, source_bytes: sview_len(source), limits: limits, json_policy: policy, stream: stream, decoder: decoder}


        def begin_json_lines_chunk_reader(limits: DataDecodeLimits = DataDecodeLimits{}, policy: JsonPolicy = JsonPolicy{}, framing: JsonStreamPolicy = JsonStreamPolicy{}) -> JsonLinesChunkReader error[DataContractError, JsonStreamError] can[Memory.Allocate, Abort.Panic]:
            try validate_data_decoder(DataDecoder{format: DataFormat.JsonLines, limits: limits})
            try validate_json_policy(policy)
            _ = try validate_json_stream(JsonStreamSession{policy: framing})
            effective_input_bytes: usize = json_lines_min(framing.max_input_bytes, limits.input_bytes)
            effective_record_bytes: usize = json_lines_min(framing.max_record_bytes, effective_input_bytes)
            effective_records: usize = json_lines_min(framing.max_records, limits.records)
            effective_depth: usize = json_lines_min(framing.max_depth, limits.depth)
            effective_framing: JsonStreamPolicy = JsonStreamPolicy{max_input_bytes: effective_input_bytes, max_record_bytes: effective_record_bytes, max_records: effective_records, max_depth: effective_depth, allow_empty_records: framing.allow_empty_records, record_boundary: framing.record_boundary}
            stream: mutable JsonStreamSession = JsonStreamSession{policy: effective_framing}
            _ = try advance_json_stream(stream, JsonStreamEvent.Begin)
            decoder: mutable DataDecoder = DataDecoder{format: DataFormat.JsonLines, limits: limits}
            _ = try advance_data_decoder(decoder, DataDecoderEvent.Begin)
            return JsonLinesChunkReader{limits: limits, json_policy: policy, stream: stream, decoder: decoder}


        def validate_json_lines_chunk_reader(reader: JsonLinesChunkReader&) -> bool error[JsonLinesParseError, JsonStreamError, DataContractError]:
            try json_lines_chunk_reader_state_valid(reader)
            return true


        def feed_json_lines_chunk(reader: mutable JsonLinesChunkReader&, chunk: sview, final_chunk: bool = false) -> JsonLinesFeedResult error[JsonLinesParseError, JsonStreamError, DataContractError, JsonLexError, JsonParseError, JsonContractError] can[Memory.Allocate, Abort.Panic]:
            try validate_json_lines_chunk_reader(reader)
            if reader.stream.state == JsonStreamState.Complete:
                raise JsonLinesParseError.InvalidState if sview_len(chunk) != 0
                return JsonLinesFeedResult{outcome: JsonLinesFeedOutcome.Complete}
            raise JsonLinesParseError.InvalidState if reader.stream.state == JsonStreamState.Failed
            if reader.final_input_pending:
                raise JsonLinesParseError.InvalidState if not final_chunk
                raise JsonLinesParseError.InvalidState if sview_len(chunk) != reader.final_bytes_remaining
                # The complete final suffix has been supplied. If parsing
                # returns at another boundary, the implementation installs a
                # fresh pending suffix for the bytes it did not consume.
                reader.final_input_pending <- false
                reader.final_bytes_remaining <- 0
            catch json_lines_feed_chunk_impl(reader, chunk, final_chunk):
                ok result:
                    return result
                error failure:
                    reader.failure_record_number <- reader.stream.records + 1 if reader.stream.record_bytes != 0 or reader.offset == reader.record_start else reader.stream.records
                    reader.failure_record_start <- reader.record_start
                    if reader.stream.state == JsonStreamState.Reading:
                        catch advance_json_stream(reader.stream, JsonStreamEvent.Fail):
                            ok failed_stream:
                                _ = failed_stream
                            error fail_stream:
                                _ = fail_stream
                    if reader.decoder.state == DataDecoderState.Decoding:
                        catch advance_data_decoder(reader.decoder, DataDecoderEvent.Fail):
                            ok failed_decoder:
                                _ = failed_decoder
                            error fail_decoder:
                                _ = fail_decoder
                    raise failure


        def validate_json_lines_reader(reader: JsonLinesReader&) -> bool error[JsonLinesParseError, JsonStreamError, DataContractError]:
            try json_lines_reader_state_valid(reader)
            return true


        def next_json_lines_document(reader: mutable JsonLinesReader&) -> JsonLinesReadResult error[JsonLinesParseError, JsonStreamError, DataContractError, JsonLexError, JsonParseError, JsonContractError] can[Memory.Allocate, Abort.Panic]:
            try validate_json_lines_reader(reader)
            raise JsonLinesParseError.InvalidState if reader.stream.state == JsonStreamState.Failed
            catch json_lines_next_impl(reader):
                ok result:
                    return result
                error failure:
                    reader.failure_record_number <- reader.stream.records + 1 if reader.stream.record_bytes != 0 or reader.offset == reader.record_start else reader.stream.records
                    reader.failure_record_start <- reader.record_start
                    if reader.stream.state == JsonStreamState.Reading:
                        catch advance_json_stream(reader.stream, JsonStreamEvent.Fail):
                            ok failed_stream:
                                _ = failed_stream
                            error fail_stream:
                                _ = fail_stream
                    if reader.decoder.state == DataDecoderState.Decoding:
                        catch advance_data_decoder(reader.decoder, DataDecoderEvent.Fail):
                            ok failed_decoder:
                                _ = failed_decoder
                            error fail_decoder:
                                _ = fail_decoder
                    raise failure
