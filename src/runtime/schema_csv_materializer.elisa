# Owned text-only CSV/TSV row projection into a checked schema.
#
# Parsing and source-span accounting are separate. This adapter accepts only
# completed, policy-bound EsCsvMaterialize records, then unquotes and copies a
# selected row into schema order. Header and positional mappings share the
# schema's alias, requiredness, unknown-column, and explicit Missing contract.

module EsSchemaCsv:
    using EsData
    using EsCsvMaterialize
    using EsSchema
    using EsEncoding

    public:
        const SCHEMA_CSV_MAX_PAYLOAD_BYTES: usize = DATA_MAX_INPUT_BYTES
        const SCHEMA_CSV_MAX_INDEX_ENTRIES: usize = SCHEMA_MAX_FIELDS * 2


        const enum SchemaCsvValueKind of u8:
            Missing
            Text


        struct SchemaCsvValue:
            field_index: usize
            kind: SchemaCsvValueKind
            bytes: darray[u8] = []


        struct SchemaCsvRecord:
            row_ordinal: usize
            values: darray[SchemaCsvValue] = []
            payload_bytes: usize = 0


        error SchemaCsvMaterializeError:
            UnsupportedValueKind
            RowIndexInvalid
            MaterializerIncomplete
            DuplicateHeader
            DuplicateSourceIndex
            SourceIndexInvalid
            UnknownColumn
            MalformedField
            InvalidUtf8
            PayloadLimitExceeded


    private:
        const SCHEMA_CSV_INDEX_NONE: usize = 4294967295


        const enum SchemaCsvDecodeState of u8:
            Unquoted
            Quoted
            Escaped
            Complete


        const enum SchemaCsvNameOrder of u8:
            Before
            Equal
            After


        struct SchemaCsvNameEntry:
            start: usize
            end: usize
            index: usize
            schema_name: bool


        def schema_csv_bytes_valid_utf8(bytes: darray[u8]&, start: usize, end: usize) -> bool:
            cursor: mutable Utf8Cursor = Utf8Cursor{}
            for offset in start..<end |bytes, cursor|:
                return false if not utf8_feed(bytes[offset], cursor)
            return utf8_complete(cursor)


        def schema_csv_decode_cell(materializer: CsvMaterializer&, span: CsvFieldSpan, destination: mutable darray[u8]&, field_limit: usize) -> usize error[SchemaCsvMaterializeError] can[Memory.Allocate, Abort.Panic]:
            initial_count: usize = destination.count
            cursor: mutable usize = span.start
            finish: usize = span.end
            if span.quoted:
                cursor <- span.start + 1
                finish <- span.end - 1
            else:
                if materializer.policy.trim_unquoted:
                    while cursor < finish and (sview_at(materializer.source, cursor) == 32 or sview_at(materializer.source, cursor) == 9):
                        cursor <- cursor + 1
                    while finish > cursor and (sview_at(materializer.source, finish - 1) == 32 or sview_at(materializer.source, finish - 1) == 9):
                        finish <- finish - 1
            state: mutable SchemaCsvDecodeState = SchemaCsvDecodeState.Quoted if span.quoted else SchemaCsvDecodeState.Unquoted
            utf8: mutable Utf8Cursor = Utf8Cursor{}
            while state != SchemaCsvDecodeState.Complete:
                if state == SchemaCsvDecodeState.Unquoted:
                    if cursor >= finish:
                        state <- SchemaCsvDecodeState.Complete
                    else:
                        byte: u8 = sview_at(materializer.source, cursor)
                        raise SchemaCsvMaterializeError.PayloadLimitExceeded if destination.count - initial_count >= field_limit
                        raise SchemaCsvMaterializeError.InvalidUtf8 if not utf8_feed(byte, utf8)
                        destination.push(byte)
                        cursor <- cursor + 1
                elif state == SchemaCsvDecodeState.Quoted:
                    if cursor >= finish:
                        state <- SchemaCsvDecodeState.Complete
                    else:
                        byte: u8 = sview_at(materializer.source, cursor)
                        if materializer.policy.escape != materializer.policy.quote and byte == materializer.policy.escape:
                            cursor <- cursor + 1
                            state <- SchemaCsvDecodeState.Escaped
                        elif byte == materializer.policy.quote:
                            raise SchemaCsvMaterializeError.MalformedField if materializer.policy.escape != materializer.policy.quote or cursor + 1 >= finish or sview_at(materializer.source, cursor + 1) != materializer.policy.quote
                            raise SchemaCsvMaterializeError.PayloadLimitExceeded if destination.count - initial_count >= field_limit
                            raise SchemaCsvMaterializeError.InvalidUtf8 if not utf8_feed(byte, utf8)
                            destination.push(byte)
                            cursor <- cursor + 2
                        else:
                            raise SchemaCsvMaterializeError.PayloadLimitExceeded if destination.count - initial_count >= field_limit
                            raise SchemaCsvMaterializeError.InvalidUtf8 if not utf8_feed(byte, utf8)
                            destination.push(byte)
                            cursor <- cursor + 1
                elif state == SchemaCsvDecodeState.Escaped:
                    raise SchemaCsvMaterializeError.MalformedField if cursor >= finish
                    byte: u8 = sview_at(materializer.source, cursor)
                    raise SchemaCsvMaterializeError.PayloadLimitExceeded if destination.count - initial_count >= field_limit
                    raise SchemaCsvMaterializeError.InvalidUtf8 if not utf8_feed(byte, utf8)
                    destination.push(byte)
                    cursor <- cursor + 1
                    state <- SchemaCsvDecodeState.Quoted
            raise SchemaCsvMaterializeError.InvalidUtf8 if not utf8_complete(utf8)
            return destination.count - initial_count


        def schema_csv_copy_name(bytes: mutable darray[u8]&, name: sview, limit: usize) -> SchemaCsvNameEntry error[SchemaCsvMaterializeError] can[Memory.Allocate, Abort.Panic]:
            start: usize = bytes.count
            raise SchemaCsvMaterializeError.PayloadLimitExceeded if sview_len(name) > limit - bytes.count
            for offset in 0..<sview_len(name) |bytes, name|:
                bytes.push(sview_at(name, offset))
            return SchemaCsvNameEntry{start: start, end: bytes.count, index: 0, schema_name: true}


        def schema_csv_name_order(bytes: darray[u8]&, left: SchemaCsvNameEntry, right: SchemaCsvNameEntry) -> SchemaCsvNameOrder:
            left_length: usize = left.end - left.start
            right_length: usize = right.end - right.start
            common: usize = left_length if left_length < right_length else right_length
            for offset in 0..<common |bytes, left, right|:
                return SchemaCsvNameOrder.Before if bytes[left.start + offset] < bytes[right.start + offset]
                return SchemaCsvNameOrder.After if bytes[left.start + offset] > bytes[right.start + offset]
            return SchemaCsvNameOrder.Equal if left_length == right_length
            return SchemaCsvNameOrder.Before if left_length < right_length
            return SchemaCsvNameOrder.After


        def schema_csv_sort_name_indices(bytes: darray[u8]&, entries: darray[SchemaCsvNameEntry]&, order: mutable darray[usize]&, scratch: mutable darray[usize]&) -> void:
            width: mutable usize = 1
            while width < order.count:
                start: mutable usize = 0
                while start < order.count:
                    middle: mutable usize = start + width
                    middle <- order.count if middle > order.count
                    end: mutable usize = middle + width
                    end <- order.count if end > order.count
                    left: mutable usize = start
                    right: mutable usize = middle
                    destination: mutable usize = start
                    while destination < end:
                        if left == middle:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        elif right == end:
                            scratch[destination] <- order[left]
                            left <- left + 1
                        elif schema_csv_name_order(bytes, entries[order[left]], entries[order[right]]) != SchemaCsvNameOrder.After:
                            scratch[destination] <- order[left]
                            left <- left + 1
                        else:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        destination <- destination + 1
                    start <- end
                for index in 0..<order.count |order, scratch|:
                    order[index] <- scratch[index]
                width <- order.count if width > order.count / 2 else width * 2


        def schema_csv_effective_source_name(field: SchemaField) -> sview:
            return field.name if field.source_name == ""
            return field.source_name


        def schema_csv_effective_source_index(field: SchemaField, field_index: usize) -> usize:
            return field_index if field.source_index == SCHEMA_SOURCE_INDEX_AUTO
            return field.source_index


        def schema_csv_sort_position_indices(schema: SchemaDescriptor&, order: mutable darray[usize]&, scratch: mutable darray[usize]&) -> void:
            width: mutable usize = 1
            while width < order.count:
                start: mutable usize = 0
                while start < order.count:
                    middle: mutable usize = start + width
                    middle <- order.count if middle > order.count
                    end: mutable usize = middle + width
                    end <- order.count if end > order.count
                    left: mutable usize = start
                    right: mutable usize = middle
                    destination: mutable usize = start
                    while destination < end:
                        if left == middle:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        elif right == end:
                            scratch[destination] <- order[left]
                            left <- left + 1
                        elif schema_csv_effective_source_index(schema.fields[order[left]], order[left]) <= schema_csv_effective_source_index(schema.fields[order[right]], order[right]):
                            scratch[destination] <- order[left]
                            left <- left + 1
                        else:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        destination <- destination + 1
                    start <- end
                for index in 0..<order.count |order, scratch|:
                    order[index] <- scratch[index]
                width <- order.count if width > order.count / 2 else width * 2


        def schema_csv_append_header_names(schema: SchemaDescriptor&, materializer: CsvMaterializer&, header_record: CsvRecordSpan, arena: mutable darray[u8]&, entries: mutable darray[SchemaCsvNameEntry]&) -> void error[SchemaCsvMaterializeError] can[Memory.Allocate, Abort.Panic]:
            for field_index in 0..<schema.fields.count |schema, arena, entries|:
                entry: SchemaCsvNameEntry = try schema_csv_copy_name(arena, schema_csv_effective_source_name(schema.fields[field_index]), SCHEMA_CSV_MAX_PAYLOAD_BYTES)
                entry.index <- field_index
                entry.schema_name <- true
                entries.push(entry)
            for column_index in 0..<header_record.field_count |materializer, header_record, arena, entries|:
                span: CsvFieldSpan = materializer.fields[header_record.first_field + column_index]
                start: usize = arena.count
                _ = try schema_csv_decode_cell(materializer, span, arena, DATA_MAX_FIELD_BYTES)
                raise SchemaCsvMaterializeError.PayloadLimitExceeded if arena.count > SCHEMA_CSV_MAX_PAYLOAD_BYTES
                raise SchemaCsvMaterializeError.InvalidUtf8 if not schema_csv_bytes_valid_utf8(arena, start, arena.count)
                entries.push(SchemaCsvNameEntry{start: start, end: arena.count, index: column_index, schema_name: false})


    public:
        def materialize_csv_schema_record(schema: SchemaDescriptor&, materializer: CsvMaterializer&, row_ordinal: usize) -> SchemaCsvRecord error[DataContractError, CsvMaterializerError, SchemaContractError, SchemaCsvMaterializeError] can[Memory.Allocate, Abort.Panic]:
            try validate_schema_descriptor(schema)
            raise SchemaContractError.InvalidSource if schema.source != SchemaSource.Csv and schema.source != SchemaSource.Tsv
            try validate_csv_materializer(materializer)
            raise SchemaCsvMaterializeError.MaterializerIncomplete if materializer.state != CsvMaterializerState.Complete
            for field in schema.fields:
                raise SchemaCsvMaterializeError.UnsupportedValueKind if field.kind != SchemaValueKind.Text

            header_record: CsvRecordSpan = CsvRecordSpan{first_field: 0, field_count: 0}
            source_record_index: usize = row_ordinal
            if materializer.policy.header:
                raise SchemaCsvMaterializeError.RowIndexInvalid if materializer.records.count <= 1 or row_ordinal >= materializer.records.count - 1
                header_record <- materializer.records[0]
                source_record_index <- row_ordinal + 1
            else:
                raise SchemaCsvMaterializeError.RowIndexInvalid if row_ordinal >= materializer.records.count
            row: CsvRecordSpan = materializer.records[source_record_index]

            field_to_column: mutable darray[usize] = []
            for _ in 0..<schema.fields.count |field_to_column|:
                field_to_column.push(SCHEMA_CSV_INDEX_NONE)
            if materializer.policy.header:
                name_bytes: mutable darray[u8] = []
                name_entries: mutable darray[SchemaCsvNameEntry] = []
                name_order: mutable darray[usize] = []
                name_scratch: mutable darray[usize] = []
                try schema_csv_append_header_names(schema, materializer, header_record, name_bytes, name_entries)
                raise SchemaCsvMaterializeError.PayloadLimitExceeded if name_entries.count > SCHEMA_CSV_MAX_INDEX_ENTRIES
                for entry_index in 0..<name_entries.count |name_order, name_scratch|:
                    name_order.push(entry_index)
                    name_scratch.push(entry_index)
                schema_csv_sort_name_indices(name_bytes, name_entries, name_order, name_scratch)
                header_column_to_field: mutable darray[usize] = []
                for _ in 0..<header_record.field_count |header_column_to_field|:
                    header_column_to_field.push(SCHEMA_CSV_INDEX_NONE)
                cursor: mutable usize = 0
                while cursor < name_order.count:
                    group_end: mutable usize = cursor + 1
                    while group_end < name_order.count and schema_csv_name_order(name_bytes, name_entries[name_order[cursor]], name_entries[name_order[group_end]]) == SchemaCsvNameOrder.Equal:
                        group_end <- group_end + 1
                    schema_field_index: mutable usize = SCHEMA_CSV_INDEX_NONE
                    header_column_index: mutable usize = SCHEMA_CSV_INDEX_NONE
                    header_matches: mutable usize = 0
                    for group_offset in cursor..<group_end |name_order, name_entries, schema_field_index, header_column_index, header_matches|:
                        entry: SchemaCsvNameEntry = name_entries[name_order[group_offset]]
                        if entry.schema_name:
                            schema_field_index <- entry.index
                        else:
                            header_matches <- header_matches + 1
                            header_column_index <- entry.index
                    raise SchemaCsvMaterializeError.DuplicateHeader if header_matches > 1
                    if header_matches != 0:
                        if schema_field_index == SCHEMA_CSV_INDEX_NONE:
                            raise SchemaCsvMaterializeError.UnknownColumn if not schema.allow_unknown
                        else:
                            field_to_column[schema_field_index] <- header_column_index
                            header_column_to_field[header_column_index] <- schema_field_index
                    cursor <- group_end
                for column_index in 0..<row.field_count |row, header_column_to_field|:
                    raise SchemaCsvMaterializeError.UnknownColumn if column_index >= header_column_to_field.count and not schema.allow_unknown
                    raise SchemaCsvMaterializeError.UnknownColumn if column_index < header_column_to_field.count and header_column_to_field[column_index] == SCHEMA_CSV_INDEX_NONE and not schema.allow_unknown
            else:
                position_order: mutable darray[usize] = []
                position_scratch: mutable darray[usize] = []
                for field_index in 0..<schema.fields.count |schema, position_order, position_scratch|:
                    position: usize = schema_csv_effective_source_index(schema.fields[field_index], field_index)
                    raise SchemaCsvMaterializeError.SourceIndexInvalid if position >= SCHEMA_MAX_FIELDS
                    position_order.push(field_index)
                    position_scratch.push(field_index)
                schema_csv_sort_position_indices(schema, position_order, position_scratch)
                for index in 1..<position_order.count |schema, position_order|:
                    left: usize = schema_csv_effective_source_index(schema.fields[position_order[index - 1]], position_order[index - 1])
                    right: usize = schema_csv_effective_source_index(schema.fields[position_order[index]], position_order[index])
                    raise SchemaCsvMaterializeError.DuplicateSourceIndex if left == right
                for field_index in 0..<schema.fields.count |schema, field_to_column|:
                    position: usize = schema_csv_effective_source_index(schema.fields[field_index], field_index)
                    field_to_column[field_index] <- position
                position_to_field: mutable darray[usize] = []
                for _ in 0..<row.field_count |position_to_field|:
                    position_to_field.push(SCHEMA_CSV_INDEX_NONE)
                for field_index in 0..<field_to_column.count |field_to_column, position_to_field, row|:
                    position: usize = field_to_column[field_index]
                    position_to_field[position] <- field_index if position < row.field_count
                for column_index in 0..<row.field_count |position_to_field|:
                    raise SchemaCsvMaterializeError.UnknownColumn if position_to_field[column_index] == SCHEMA_CSV_INDEX_NONE and not schema.allow_unknown

            record: mutable SchemaCsvRecord = SchemaCsvRecord{row_ordinal: row_ordinal}
            for field_index in 0..<schema.fields.count |schema, field_to_column, row, materializer, record|:
                field: SchemaField = schema.fields[field_index]
                column_index: usize = field_to_column[field_index]
                if column_index == SCHEMA_CSV_INDEX_NONE or column_index >= row.field_count:
                    raise SchemaContractError.RequiredFieldMissing if field.required
                    record.values.push(SchemaCsvValue{field_index: field_index, kind: SchemaCsvValueKind.Missing})
                else:
                    span: CsvFieldSpan = materializer.fields[row.first_field + column_index]
                    value: mutable SchemaCsvValue = SchemaCsvValue{field_index: field_index, kind: SchemaCsvValueKind.Text}
                    payload_bytes: usize = try schema_csv_decode_cell(materializer, span, value.bytes, DATA_MAX_FIELD_BYTES)
                    raise SchemaCsvMaterializeError.PayloadLimitExceeded if record.payload_bytes > SCHEMA_CSV_MAX_PAYLOAD_BYTES
                    raise SchemaCsvMaterializeError.PayloadLimitExceeded if payload_bytes > SCHEMA_CSV_MAX_PAYLOAD_BYTES - record.payload_bytes
                    record.payload_bytes <- record.payload_bytes + payload_bytes
                    record.values.push(value)
            return record
