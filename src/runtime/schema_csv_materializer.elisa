# Owned text and exact-integer CSV/TSV projection into a checked schema.
#
# Parsing and source-span accounting are separate. This adapter accepts only
# completed, policy-bound EsCsvMaterialize records, then unquotes and copies a
# selected row into schema order. Header and positional mappings share the
# schema's alias, requiredness, unknown-column, and explicit Missing contract.

module EsSchemaCsv:
    using EsData
    using EsCsvMaterialize
    using EsSchema
    using EsSchemaNumeric
    using EsEncoding

    public:
        const SCHEMA_CSV_MAX_PAYLOAD_BYTES: usize = DATA_MAX_INPUT_BYTES
        const SCHEMA_CSV_MAX_INDEX_ENTRIES: usize = SCHEMA_MAX_FIELDS * 2
        const SCHEMA_CSV_MAX_BATCH_ROWS: usize = 4096
        const SCHEMA_CSV_MAX_BATCH_VALUES: usize = DATA_MAX_FIELDS


        const enum SchemaCsvValueKind of u8:
            Missing
            Text
            Integer
            Decimal


        struct SchemaCsvValue:
            field_index: usize
            kind: SchemaCsvValueKind
            integer_value: SchemaIntegerValue = SchemaIntegerValue{}
            decimal_value: SchemaDecimalValue = SchemaDecimalValue{}
            bytes: darray[u8] = []


        struct SchemaCsvRecord:
            row_ordinal: usize
            values: darray[SchemaCsvValue] = []
            payload_bytes: usize = 0


        struct SchemaCsvRecordBatch:
            first_row: usize
            records: darray[SchemaCsvRecord] = []
            value_count: usize = 0
            payload_bytes: usize = 0


        error SchemaCsvMaterializeError:
            UnsupportedValueKind
            RowIndexInvalid
            MaterializerIncomplete
            DuplicateHeader
            DuplicateSourceIndex
            SourceIndexInvalid
            UnknownColumn
            MalformedField
            InvalidUtf8
            PayloadLimitExceeded
            BatchRowLimitExceeded
            BatchValueLimitExceeded


    private:
        const SCHEMA_CSV_INDEX_NONE: usize = 4294967295


        const enum SchemaCsvDecodeState of u8:
            Unquoted
            Quoted
            Escaped
            Complete


        const enum SchemaCsvNameOrder of u8:
            Before
            Equal
            After


        struct SchemaCsvNameEntry:
            start: usize
            end: usize
            index: usize
            schema_name: bool


        struct SchemaCsvProjection:
            field_to_column: darray[usize] = []
            header_column_to_field: darray[usize] = []
            position_order: darray[usize] = []
            has_header: bool = false


        def schema_csv_bytes_valid_utf8(bytes: darray[u8]&, start: usize, end: usize) -> bool:
            cursor: mutable Utf8Cursor = Utf8Cursor{}
            for offset in start..<end |bytes, cursor|:
                return false if not utf8_feed(bytes[offset], cursor)
            return utf8_complete(cursor)


        def schema_csv_decode_cell(materializer: CsvMaterializer&, span: CsvFieldSpan, destination: mutable darray[u8]&, field_limit: usize) -> usize error[SchemaCsvMaterializeError] can[Memory.Allocate, Abort.Panic]:
            initial_count: usize = destination.count
            cursor: mutable usize = span.start
            finish: usize = span.end
            if span.quoted:
                cursor <- span.start + 1
                finish <- span.end - 1
            else:
                if materializer.policy.trim_unquoted:
                    while cursor < finish and (sview_at(materializer.source, cursor) == 32 or sview_at(materializer.source, cursor) == 9):
                        cursor <- cursor + 1
                    while finish > cursor and (sview_at(materializer.source, finish - 1) == 32 or sview_at(materializer.source, finish - 1) == 9):
                        finish <- finish - 1
            state: mutable SchemaCsvDecodeState = SchemaCsvDecodeState.Quoted if span.quoted else SchemaCsvDecodeState.Unquoted
            utf8: mutable Utf8Cursor = Utf8Cursor{}
            while state != SchemaCsvDecodeState.Complete:
                if state == SchemaCsvDecodeState.Unquoted:
                    if cursor >= finish:
                        state <- SchemaCsvDecodeState.Complete
                    else:
                        byte: u8 = sview_at(materializer.source, cursor)
                        raise SchemaCsvMaterializeError.PayloadLimitExceeded if destination.count - initial_count >= field_limit
                        raise SchemaCsvMaterializeError.InvalidUtf8 if not utf8_feed(byte, utf8)
                        destination.push(byte)
                        cursor <- cursor + 1
                elif state == SchemaCsvDecodeState.Quoted:
                    if cursor >= finish:
                        state <- SchemaCsvDecodeState.Complete
                    else:
                        byte: u8 = sview_at(materializer.source, cursor)
                        if materializer.policy.escape != materializer.policy.quote and byte == materializer.policy.escape:
                            cursor <- cursor + 1
                            state <- SchemaCsvDecodeState.Escaped
                        elif byte == materializer.policy.quote:
                            raise SchemaCsvMaterializeError.MalformedField if materializer.policy.escape != materializer.policy.quote or cursor + 1 >= finish or sview_at(materializer.source, cursor + 1) != materializer.policy.quote
                            raise SchemaCsvMaterializeError.PayloadLimitExceeded if destination.count - initial_count >= field_limit
                            raise SchemaCsvMaterializeError.InvalidUtf8 if not utf8_feed(byte, utf8)
                            destination.push(byte)
                            cursor <- cursor + 2
                        else:
                            raise SchemaCsvMaterializeError.PayloadLimitExceeded if destination.count - initial_count >= field_limit
                            raise SchemaCsvMaterializeError.InvalidUtf8 if not utf8_feed(byte, utf8)
                            destination.push(byte)
                            cursor <- cursor + 1
                elif state == SchemaCsvDecodeState.Escaped:
                    raise SchemaCsvMaterializeError.MalformedField if cursor >= finish
                    byte: u8 = sview_at(materializer.source, cursor)
                    raise SchemaCsvMaterializeError.PayloadLimitExceeded if destination.count - initial_count >= field_limit
                    raise SchemaCsvMaterializeError.InvalidUtf8 if not utf8_feed(byte, utf8)
                    destination.push(byte)
                    cursor <- cursor + 1
                    state <- SchemaCsvDecodeState.Quoted
            raise SchemaCsvMaterializeError.InvalidUtf8 if not utf8_complete(utf8)
            return destination.count - initial_count


        def schema_csv_copy_name(bytes: mutable darray[u8]&, name: sview, limit: usize) -> SchemaCsvNameEntry error[SchemaCsvMaterializeError] can[Memory.Allocate, Abort.Panic]:
            start: usize = bytes.count
            raise SchemaCsvMaterializeError.PayloadLimitExceeded if sview_len(name) > limit - bytes.count
            for offset in 0..<sview_len(name) |bytes, name|:
                bytes.push(sview_at(name, offset))
            return SchemaCsvNameEntry{start: start, end: bytes.count, index: 0, schema_name: true}


        def schema_csv_name_order(bytes: darray[u8]&, left: SchemaCsvNameEntry, right: SchemaCsvNameEntry) -> SchemaCsvNameOrder:
            left_length: usize = left.end - left.start
            right_length: usize = right.end - right.start
            common: usize = left_length if left_length < right_length else right_length
            for offset in 0..<common |bytes, left, right|:
                return SchemaCsvNameOrder.Before if bytes[left.start + offset] < bytes[right.start + offset]
                return SchemaCsvNameOrder.After if bytes[left.start + offset] > bytes[right.start + offset]
            return SchemaCsvNameOrder.Equal if left_length == right_length
            return SchemaCsvNameOrder.Before if left_length < right_length
            return SchemaCsvNameOrder.After


        def schema_csv_sort_name_indices(bytes: darray[u8]&, entries: darray[SchemaCsvNameEntry]&, order: mutable darray[usize]&, scratch: mutable darray[usize]&) -> void:
            width: mutable usize = 1
            while width < order.count:
                start: mutable usize = 0
                while start < order.count:
                    middle: mutable usize = start + width
                    middle <- order.count if middle > order.count
                    end: mutable usize = middle + width
                    end <- order.count if end > order.count
                    left: mutable usize = start
                    right: mutable usize = middle
                    destination: mutable usize = start
                    while destination < end:
                        if left == middle:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        elif right == end:
                            scratch[destination] <- order[left]
                            left <- left + 1
                        elif schema_csv_name_order(bytes, entries[order[left]], entries[order[right]]) != SchemaCsvNameOrder.After:
                            scratch[destination] <- order[left]
                            left <- left + 1
                        else:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        destination <- destination + 1
                    start <- end
                for index in 0..<order.count |order, scratch|:
                    order[index] <- scratch[index]
                width <- order.count if width > order.count / 2 else width * 2


        def schema_csv_effective_source_name(field: SchemaField) -> sview:
            return field.name if field.source_name == ""
            return field.source_name


        def schema_csv_effective_source_index(field: SchemaField, field_index: usize) -> usize:
            return field_index if field.source_index == SCHEMA_SOURCE_INDEX_AUTO
            return field.source_index


        def schema_csv_sort_position_indices(schema: SchemaDescriptor&, order: mutable darray[usize]&, scratch: mutable darray[usize]&) -> void:
            width: mutable usize = 1
            while width < order.count:
                start: mutable usize = 0
                while start < order.count:
                    middle: mutable usize = start + width
                    middle <- order.count if middle > order.count
                    end: mutable usize = middle + width
                    end <- order.count if end > order.count
                    left: mutable usize = start
                    right: mutable usize = middle
                    destination: mutable usize = start
                    while destination < end:
                        if left == middle:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        elif right == end:
                            scratch[destination] <- order[left]
                            left <- left + 1
                        elif schema_csv_effective_source_index(schema.fields[order[left]], order[left]) <= schema_csv_effective_source_index(schema.fields[order[right]], order[right]):
                            scratch[destination] <- order[left]
                            left <- left + 1
                        else:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        destination <- destination + 1
                    start <- end
                for index in 0..<order.count |order, scratch|:
                    order[index] <- scratch[index]
                width <- order.count if width > order.count / 2 else width * 2


        def schema_csv_append_header_names(schema: SchemaDescriptor&, materializer: CsvMaterializer&, header_record: CsvRecordSpan, arena: mutable darray[u8]&, entries: mutable darray[SchemaCsvNameEntry]&) -> void error[SchemaCsvMaterializeError] can[Memory.Allocate, Abort.Panic]:
            for field_index in 0..<schema.fields.count |schema, arena, entries|:
                entry: SchemaCsvNameEntry = try schema_csv_copy_name(arena, schema_csv_effective_source_name(schema.fields[field_index]), SCHEMA_CSV_MAX_PAYLOAD_BYTES)
                entry.index <- field_index
                entry.schema_name <- true
                entries.push(entry)
            for column_index in 0..<header_record.field_count |materializer, header_record, arena, entries|:
                span: CsvFieldSpan = materializer.fields[header_record.first_field + column_index]
                start: usize = arena.count
                raise SchemaCsvMaterializeError.PayloadLimitExceeded if arena.count > SCHEMA_CSV_MAX_PAYLOAD_BYTES
                remaining_bytes: usize = SCHEMA_CSV_MAX_PAYLOAD_BYTES - arena.count
                _ = try schema_csv_decode_cell(materializer, span, arena, remaining_bytes)
                raise SchemaCsvMaterializeError.InvalidUtf8 if not schema_csv_bytes_valid_utf8(arena, start, arena.count)
                entries.push(SchemaCsvNameEntry{start: start, end: arena.count, index: column_index, schema_name: false})


        def schema_csv_validate_inputs(schema: SchemaDescriptor&, materializer: CsvMaterializer&) -> bool error[DataContractError, CsvMaterializerError, SchemaContractError, SchemaCsvMaterializeError] can[Memory.Allocate, Abort.Panic]:
            try validate_schema_descriptor(schema)
            raise SchemaContractError.InvalidSource if schema.source != SchemaSource.Csv and schema.source != SchemaSource.Tsv
            try validate_csv_materializer(materializer)
            raise SchemaCsvMaterializeError.MaterializerIncomplete if materializer.state != CsvMaterializerState.Complete
            for field in schema.fields:
                raise SchemaCsvMaterializeError.UnsupportedValueKind if field.kind != SchemaValueKind.Text
            return true


        def schema_csv_prepare_projection(schema: SchemaDescriptor&, materializer: CsvMaterializer&) -> SchemaCsvProjection error[SchemaCsvMaterializeError] can[Memory.Allocate, Abort.Panic]:
            projection: mutable SchemaCsvProjection = SchemaCsvProjection{has_header: materializer.policy.header}
            for _ in 0..<schema.fields.count |projection|:
                projection.field_to_column.push(SCHEMA_CSV_INDEX_NONE)
            if projection.has_header:
                # An empty source has no header record and, by definition,
                # no data rows. Keep the empty projection so a zero-row batch
                # can succeed without indexing a nonexistent record.
                return projection if materializer.records.count == 0
                header_record: CsvRecordSpan = materializer.records[0]
                raise SchemaCsvMaterializeError.PayloadLimitExceeded if header_record.field_count > SCHEMA_CSV_MAX_INDEX_ENTRIES
                raise SchemaCsvMaterializeError.PayloadLimitExceeded if schema.fields.count > SCHEMA_CSV_MAX_INDEX_ENTRIES - header_record.field_count
                name_bytes: mutable darray[u8] = []
                name_entries: mutable darray[SchemaCsvNameEntry] = []
                name_order: mutable darray[usize] = []
                name_scratch: mutable darray[usize] = []
                try schema_csv_append_header_names(schema, materializer, header_record, name_bytes, name_entries)
                raise SchemaCsvMaterializeError.PayloadLimitExceeded if name_entries.count > SCHEMA_CSV_MAX_INDEX_ENTRIES
                for entry_index in 0..<name_entries.count |name_order, name_scratch|:
                    name_order.push(entry_index)
                    name_scratch.push(entry_index)
                schema_csv_sort_name_indices(name_bytes, name_entries, name_order, name_scratch)
                for _ in 0..<header_record.field_count |projection|:
                    projection.header_column_to_field.push(SCHEMA_CSV_INDEX_NONE)
                cursor: mutable usize = 0
                while cursor < name_order.count:
                    group_end: mutable usize = cursor + 1
                    while group_end < name_order.count and schema_csv_name_order(name_bytes, name_entries[name_order[cursor]], name_entries[name_order[group_end]]) == SchemaCsvNameOrder.Equal:
                        group_end <- group_end + 1
                    schema_field_index: mutable usize = SCHEMA_CSV_INDEX_NONE
                    header_column_index: mutable usize = SCHEMA_CSV_INDEX_NONE
                    header_matches: mutable usize = 0
                    for group_offset in cursor..<group_end |name_order, name_entries, schema_field_index, header_column_index, header_matches|:
                        entry: SchemaCsvNameEntry = name_entries[name_order[group_offset]]
                        if entry.schema_name:
                            schema_field_index <- entry.index
                        else:
                            header_matches <- header_matches + 1
                            header_column_index <- entry.index
                    raise SchemaCsvMaterializeError.DuplicateHeader if header_matches > 1
                    if header_matches != 0:
                        if schema_field_index == SCHEMA_CSV_INDEX_NONE:
                            raise SchemaCsvMaterializeError.UnknownColumn if not schema.allow_unknown
                        else:
                            projection.field_to_column[schema_field_index] <- header_column_index
                            projection.header_column_to_field[header_column_index] <- schema_field_index
                    cursor <- group_end
            else:
                position_scratch: mutable darray[usize] = []
                for field_index in 0..<schema.fields.count |schema, projection, position_scratch|:
                    position: usize = schema_csv_effective_source_index(schema.fields[field_index], field_index)
                    raise SchemaCsvMaterializeError.SourceIndexInvalid if position >= SCHEMA_MAX_FIELDS
                    projection.position_order.push(field_index)
                    position_scratch.push(field_index)
                schema_csv_sort_position_indices(schema, projection.position_order, position_scratch)
                for index in 1..<projection.position_order.count |schema, projection|:
                    left: usize = schema_csv_effective_source_index(schema.fields[projection.position_order[index - 1]], projection.position_order[index - 1])
                    right: usize = schema_csv_effective_source_index(schema.fields[projection.position_order[index]], projection.position_order[index])
                    raise SchemaCsvMaterializeError.DuplicateSourceIndex if left == right
                for field_index in 0..<schema.fields.count |schema, projection|:
                    position: usize = schema_csv_effective_source_index(schema.fields[field_index], field_index)
                    projection.field_to_column[field_index] <- position
            return projection


        def schema_csv_position_is_mapped(schema: SchemaDescriptor&, projection: SchemaCsvProjection&, position: usize) -> bool:
            low: mutable usize = 0
            high: mutable usize = projection.position_order.count
            while low < high:
                middle: usize = low + (high - low) / 2
                field_index: usize = projection.position_order[middle]
                mapped_position: usize = schema_csv_effective_source_index(schema.fields[field_index], field_index)
                if mapped_position == position:
                    return true
                elif mapped_position < position:
                    low <- middle + 1
                else:
                    high <- middle
            return false


        def schema_csv_validate_row_columns(schema: SchemaDescriptor&, projection: SchemaCsvProjection&, row: CsvRecordSpan) -> bool error[SchemaCsvMaterializeError]:
            if projection.has_header:
                for column_index in 0..<row.field_count |row, projection|:
                    if not schema.allow_unknown:
                        raise SchemaCsvMaterializeError.UnknownColumn if column_index >= projection.header_column_to_field.count
                        raise SchemaCsvMaterializeError.UnknownColumn if projection.header_column_to_field[column_index] == SCHEMA_CSV_INDEX_NONE
            else:
                for column_index in 0..<row.field_count |row, schema, projection|:
                    raise SchemaCsvMaterializeError.UnknownColumn if not schema.allow_unknown and not schema_csv_position_is_mapped(schema, projection, column_index)
            return true


        def schema_csv_materialize_row_with_projection(schema: SchemaDescriptor&, materializer: CsvMaterializer&, projection: SchemaCsvProjection&, row_ordinal: usize, source_record_index: usize, payload_limit: usize) -> SchemaCsvRecord error[SchemaContractError, SchemaIntegerError, SchemaDecimalError, SchemaCsvMaterializeError] can[Memory.Allocate, Abort.Panic]:
            row: CsvRecordSpan = materializer.records[source_record_index]
            try schema_csv_validate_row_columns(schema, projection, row)
            record: mutable SchemaCsvRecord = SchemaCsvRecord{row_ordinal: row_ordinal}
            integer_bytes: mutable darray[u8] = []
            for field_index in 0..<schema.fields.count |schema, projection, row, materializer, record, integer_bytes|:
                field: SchemaField = schema.fields[field_index]
                column_index: usize = projection.field_to_column[field_index]
                if column_index == SCHEMA_CSV_INDEX_NONE or column_index >= row.field_count:
                    raise SchemaContractError.RequiredFieldMissing if field.required
                    record.values.push(SchemaCsvValue{field_index: field_index, kind: SchemaCsvValueKind.Missing})
                else:
                    span: CsvFieldSpan = materializer.fields[row.first_field + column_index]
                    value: mutable SchemaCsvValue = SchemaCsvValue{field_index: field_index, kind: SchemaCsvValueKind.Text}
                    if field.integer_target != SchemaIntegerTarget.None:
                        integer_bytes.truncate(0)
                        _ = try schema_csv_decode_cell(materializer, span, integer_bytes, SCHEMA_INTEGER_MAX_BYTES)
                        value.integer_value <- try parse_schema_integer(integer_bytes, 0, integer_bytes.count, field.integer_target)
                        value.kind <- SchemaCsvValueKind.Integer
                    elif field.decimal_target == SchemaDecimalTarget.Exact:
                        integer_bytes.truncate(0)
                        _ = try schema_csv_decode_cell(materializer, span, integer_bytes, SCHEMA_DECIMAL_MAX_BYTES)
                        value.decimal_value <- try parse_schema_decimal(integer_bytes, 0, integer_bytes.count)
                        raise SchemaCsvMaterializeError.PayloadLimitExceeded if record.payload_bytes > payload_limit
                        decimal_payload_bytes: usize = value.decimal_value.coefficient_digits.count
                        raise SchemaCsvMaterializeError.PayloadLimitExceeded if decimal_payload_bytes > payload_limit - record.payload_bytes
                        record.payload_bytes <- record.payload_bytes + decimal_payload_bytes
                        value.kind <- SchemaCsvValueKind.Decimal
                    else:
                        raise SchemaCsvMaterializeError.PayloadLimitExceeded if record.payload_bytes > payload_limit
                        remaining_payload: usize = payload_limit - record.payload_bytes
                        field_payload_limit: mutable usize = DATA_MAX_FIELD_BYTES
                        field_payload_limit <- remaining_payload if remaining_payload < field_payload_limit
                        payload_bytes: usize = try schema_csv_decode_cell(materializer, span, value.bytes, field_payload_limit)
                        raise SchemaCsvMaterializeError.PayloadLimitExceeded if payload_bytes > remaining_payload
                        record.payload_bytes <- record.payload_bytes + payload_bytes
                    record.values.push(value)
            return record


        def schema_csv_data_row_count(materializer: CsvMaterializer&) -> usize:
            if materializer.policy.header:
                return 0 if materializer.records.count == 0
                return materializer.records.count - 1
            return materializer.records.count


        def schema_csv_source_record_index(materializer: CsvMaterializer&, row_ordinal: usize) -> usize:
            return row_ordinal + 1 if materializer.policy.header else row_ordinal


    public:
        def materialize_csv_schema_record(schema: SchemaDescriptor&, materializer: CsvMaterializer&, row_ordinal: usize) -> SchemaCsvRecord error[DataContractError, CsvMaterializerError, SchemaContractError, SchemaIntegerError, SchemaDecimalError, SchemaCsvMaterializeError] can[Memory.Allocate, Abort.Panic]:
            try schema_csv_validate_inputs(schema, materializer)
            raise SchemaCsvMaterializeError.RowIndexInvalid if row_ordinal >= schema_csv_data_row_count(materializer)
            projection: SchemaCsvProjection = try schema_csv_prepare_projection(schema, materializer)
            return try schema_csv_materialize_row_with_projection(schema, materializer, projection, row_ordinal, schema_csv_source_record_index(materializer, row_ordinal), SCHEMA_CSV_MAX_PAYLOAD_BYTES)


        def materialize_csv_schema_batch(schema: SchemaDescriptor&, materializer: CsvMaterializer&, first_data_row: usize, row_count: usize) -> SchemaCsvRecordBatch error[DataContractError, CsvMaterializerError, SchemaContractError, SchemaIntegerError, SchemaDecimalError, SchemaCsvMaterializeError] can[Memory.Allocate, Abort.Panic]:
            raise SchemaCsvMaterializeError.BatchRowLimitExceeded if row_count > SCHEMA_CSV_MAX_BATCH_ROWS
            try schema_csv_validate_inputs(schema, materializer)
            available_rows: usize = schema_csv_data_row_count(materializer)
            raise SchemaCsvMaterializeError.RowIndexInvalid if first_data_row > available_rows
            raise SchemaCsvMaterializeError.RowIndexInvalid if row_count > available_rows - first_data_row
            if row_count != 0:
                raise SchemaCsvMaterializeError.BatchValueLimitExceeded if schema.fields.count > SCHEMA_CSV_MAX_BATCH_VALUES / row_count
            projection: SchemaCsvProjection = try schema_csv_prepare_projection(schema, materializer)
            batch: mutable SchemaCsvRecordBatch = SchemaCsvRecordBatch{first_row: first_data_row}
            row_offset: mutable usize = 0
            while row_offset < row_count:
                row_ordinal: usize = first_data_row + row_offset
                remaining_payload: usize = SCHEMA_CSV_MAX_PAYLOAD_BYTES - batch.payload_bytes
                record: SchemaCsvRecord = try schema_csv_materialize_row_with_projection(schema, materializer, projection, row_ordinal, schema_csv_source_record_index(materializer, row_ordinal), remaining_payload)
                raise SchemaCsvMaterializeError.BatchValueLimitExceeded if record.values.count > SCHEMA_CSV_MAX_BATCH_VALUES - batch.value_count
                raise SchemaCsvMaterializeError.PayloadLimitExceeded if record.payload_bytes > SCHEMA_CSV_MAX_PAYLOAD_BYTES - batch.payload_bytes
                batch.value_count <- batch.value_count + record.values.count
                batch.payload_bytes <- batch.payload_bytes + record.payload_bytes
                batch.records.push(record)
                row_offset <- row_offset + 1
            return batch
