# Bounded POSIX TOML configuration-file reader. The returned layer owns its
# parsed key/value buffers; it does not borrow the temporary file text.

module EsConfigTomlFilePosix:
    using EsConfig
    using EsConfigToml
    using EsBoundedText

    public:
        const TOML_CONFIG_FILE_MAX_BYTES: usize = CONFIG_TOML_MAX_BYTES


        error ConfigTomlFileError:
            InputLimitInvalid


        struct ConfigTomlFileLayer:
            parsed: ConfigTomlLayer


        def read_config_toml_file(input_path: Path, maximum_bytes: usize = TOML_CONFIG_FILE_MAX_BYTES) -> ConfigTomlFileLayer error[ReadError, ConfigTomlError, ConfigError, ConfigTomlFileError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise ConfigTomlFileError.InputLimitInvalid if maximum_bytes == 0 or maximum_bytes > TOML_CONFIG_FILE_MAX_BYTES
            source: sview = try EsBoundedText::read_utf8(input_path, maximum_bytes)
            parsed: ConfigTomlLayer = try parse_toml_config(source)
            return ConfigTomlFileLayer{parsed: parsed}
