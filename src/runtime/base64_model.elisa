# Strict, bounded RFC 4648 standard-alphabet Base64 decoding.
#
# This model matches Python's base64.b64decode(..., validate=True) for the
# standard alphabet and canonical four-character grouping. Host adapters may
# map these typed failures to their own diagnostic wording.

module EsBase64:
    public:
        const module Limits:
            MAX_INPUT_BYTES: usize = 268435456
            MAX_OUTPUT_BYTES: usize = 268435456


        error Base64Error:
            InvalidLimit
            InputTooLarge
            InvalidLength
            InvalidCharacter
            InvalidPadding
            OutputTooLarge


    private:
        const module Decode:
            INVALID_VALUE: u8 = 255
            PADDING: u8 = 61


        def base64_value(byte: u8) -> u8:
            return byte - 65u8 if byte >= 65u8 and byte <= 90u8
            return byte - 71u8 if byte >= 97u8 and byte <= 122u8
            return byte + 4u8 if byte >= 48u8 and byte <= 57u8
            return 62u8 if byte == 43u8
            return 63u8 if byte == 47u8
            return Decode::INVALID_VALUE


    public:
        def decode_base64(source: sview, max_output_bytes: usize = Limits::MAX_OUTPUT_BYTES) -> darray[u8] error[Base64Error] can[Memory.Allocate, Abort.Panic]:
            input_bytes: usize = sview_len(source)
            raise Base64Error.InvalidLimit if max_output_bytes == 0 or max_output_bytes > Limits::MAX_OUTPUT_BYTES
            raise Base64Error.InputTooLarge if input_bytes > Limits::MAX_INPUT_BYTES
            raise Base64Error.InvalidLength if input_bytes % 4 != 0

            padding: mutable usize = 0
            if input_bytes != 0:
                padding <- 1 if sview_at(source, input_bytes - 1) == Decode::PADDING
                padding <- 2 if padding == 1 and input_bytes >= 2 and sview_at(source, input_bytes - 2) == Decode::PADDING

            padding_start: usize = input_bytes - padding
            for offset in 0..<input_bytes |source, padding_start|:
                byte: u8 = sview_at(source, offset)
                if byte == Decode::PADDING:
                    raise Base64Error.InvalidPadding if offset < padding_start
                else:
                    raise Base64Error.InvalidCharacter if base64_value(byte) == Decode::INVALID_VALUE

            decoded_bytes: usize = (input_bytes / 4) * 3
            raise Base64Error.InvalidLength if padding > decoded_bytes
            decoded_bytes <- decoded_bytes - padding
            raise Base64Error.OutputTooLarge if decoded_bytes > max_output_bytes

            output: mutable darray[u8] = []
            for group in 0..<(input_bytes / 4) |source, output|:
                offset: usize = group * 4
                first_value: u32 = base64_value(sview_at(source, offset)).u32()
                second_value: u32 = base64_value(sview_at(source, offset + 1)).u32()
                third_value: mutable u32 = 0
                fourth_value: mutable u32 = 0
                third_is_data: bool = sview_at(source, offset + 2) != Decode::PADDING
                fourth_is_data: bool = sview_at(source, offset + 3) != Decode::PADDING
                if third_is_data:
                    third_value <- base64_value(sview_at(source, offset + 2)).u32()
                if fourth_is_data:
                    fourth_value <- base64_value(sview_at(source, offset + 3)).u32()

                output.push(((first_value << 2) | (second_value >> 4)).u8())
                if third_is_data:
                    output.push((((second_value & 15u32) << 4) | (third_value >> 2)).u8())
                if fourth_is_data:
                    output.push((((third_value & 3u32) << 6) | fourth_value).u8())
            return output
