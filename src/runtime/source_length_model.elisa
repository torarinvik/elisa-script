# Python text-file iteration semantics, not Unicode splitlines semantics.
module EsSourceLength:
    public:
        # Mutable byte-scanning state. It can be carried between arbitrary
        # input chunks; in particular, `after_cr` must survive a chunk edge so
        # a CRLF pair is still counted as one universal newline.
        struct UniversalLineCounter:
            lines: mutable usize = 0
            after_cr: mutable bool = false
            unfinished: mutable bool = false


        def new_universal_line_counter() -> UniversalLineCounter:
            return UniversalLineCounter{}


        def feed_universal_line_count(contents: sview, counter: mutable UniversalLineCounter&) -> void:
            for byte in contents |counter|:
                if byte == 13u8:
                    counter.lines <- counter.lines + 1
                    counter.after_cr <- true
                    counter.unfinished <- false
                elif byte == 10u8:
                    counter.lines <- counter.lines + 1 if not counter.after_cr
                    counter.after_cr <- false
                    counter.unfinished <- false
                else:
                    counter.after_cr <- false
                    counter.unfinished <- true


        # Finalize a snapshot without mutating the counter. Callers may feed
        # another chunk afterward when they have not actually reached EOF.
        def finish_universal_line_count(counter: UniversalLineCounter) -> usize:
            return counter.lines + 1 if counter.unfinished else counter.lines


        def universal_line_count(contents: sview) -> usize:
            counter: mutable UniversalLineCounter = new_universal_line_counter()
            feed_universal_line_count(contents, counter)
            return finish_universal_line_count(counter)
