# Python text-file iteration semantics, not Unicode splitlines semantics.
module EsSourceLength:
    public:
        def universal_line_count(contents: sview) -> usize:
            lines: mutable usize = 0
            after_cr: mutable bool = false
            unfinished: mutable bool = false
            for byte in contents |lines, after_cr, unfinished|:
                if byte == 13u8:
                    lines <- lines + 1
                    after_cr <- true
                    unfinished <- false
                elif byte == 10u8:
                    lines <- lines + 1 if not after_cr
                    after_cr <- false
                    unfinished <- false
                else:
                    after_cr <- false
                    unfinished <- true
            return lines + 1 if unfinished else lines
