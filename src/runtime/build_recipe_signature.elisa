# Canonical identity for an incremental build action.
#
# The signature binds the command policy and declared graph shape to an
# explicit toolchain identity. It is pure: hashing and serialization perform
# no filesystem or process effects.

module EsBuildRecipeSignature:
    using EsBuild
    using EsBuildIncremental
    using EsProcess
    using EsIr

    public:
        const module Limits:
            ENCODED_BYTES: usize = 67108864


        error BuildRecipeSignatureError:
            InvalidToolchainIdentity
            InvalidRecipe
            InvalidCommand
            InheritedEnvironmentUncacheable
            EncodingLimitExceeded
            HashFailed


        struct BuildRecipeSignedGraph:
            graph: BuildGraph
            recipes: darray[BuildIncrementalRecipeTarget]


    private:
        def signature_recipe_graph_valid(recipes: darray[BuildIncrementalRecipeTarget]) -> bool error[BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic]:
            # Reject oversized caller input before copying its recipe and path
            # vectors. The downstream manifest validator has the same target
            # ceiling, but reaching it after normalization would allocate
            # proportionally to the untrusted input first.
            raise BuildRecipeSignatureError.InvalidRecipe if recipes.count > EsBuildIncremental::Limits::TARGETS
            total_inputs: mutable usize = 0
            total_outputs: mutable usize = 0
            total_dependencies: mutable usize = 0
            for recipe in recipes |total_inputs, total_outputs, total_dependencies|:
                raise BuildRecipeSignatureError.InvalidRecipe if recipe.inputs.count > EsBuildIncremental::Limits::INPUTS
                raise BuildRecipeSignatureError.InvalidRecipe if recipe.outputs.count > EsBuildIncremental::Limits::OUTPUTS
                raise BuildRecipeSignatureError.InvalidRecipe if recipe.dependencies.count > EsBuildIncremental::Limits::DEPENDENCIES
                raise BuildRecipeSignatureError.InvalidRecipe if recipe.inputs.count > EsBuildIncremental::Limits::TOTAL_INPUTS - total_inputs
                raise BuildRecipeSignatureError.InvalidRecipe if recipe.outputs.count > EsBuildIncremental::Limits::TOTAL_OUTPUTS - total_outputs
                raise BuildRecipeSignatureError.InvalidRecipe if recipe.dependencies.count > EsBuild::Limits::TOTAL_DEPENDENCIES - total_dependencies
                total_inputs <- total_inputs + recipe.inputs.count
                total_outputs <- total_outputs + recipe.outputs.count
                total_dependencies <- total_dependencies + recipe.dependencies.count
            normalized: mutable darray[BuildIncrementalRecipeTarget] = []
            for recipe in recipes |normalized|:
                normalized.push(BuildIncrementalRecipeTarget{
                    name: recipe.name,
                    kind: recipe.kind,
                    recipe_fingerprint: 1,
                    recipe_signature: BuildRecipeSignature{word0: 1},
                    inputs: recipe.inputs,
                    outputs: recipe.outputs,
                    dependencies: recipe.dependencies
                })
            valid: mutable bool = false
            catch build_incremental_observation_paths(normalized):
                ok paths:
                    _ = paths
                    valid <- true
                error failure:
                    raise BuildRecipeSignatureError.InvalidRecipe
            return valid
        const module Encoding:
            DOMAIN_0: u8 = 69
            DOMAIN_1: u8 = 83
            DOMAIN_2: u8 = 82
            DOMAIN_3: u8 = 67
            VERSION: u8 = 1


        def signature_append_byte(bytes: mutable darray[u8]&, value: u8) -> void error[BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic]:
            raise BuildRecipeSignatureError.EncodingLimitExceeded if bytes.count >= Limits::ENCODED_BYTES
            bytes.push(value)


        def signature_append_u64(bytes: mutable darray[u8]&, value: u64) -> void error[BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic]:
            for shift in 0..<8 |bytes, value|:
                try signature_append_byte(bytes, (value >> (shift * 8)).u8())


        def signature_append_count(bytes: mutable darray[u8]&, value: usize) -> void error[BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic]:
            try signature_append_u64(bytes, value.u64())


        def signature_append_text(bytes: mutable darray[u8]&, value: sview) -> void error[BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic]:
            try signature_append_count(bytes, sview_len(value))
            raise BuildRecipeSignatureError.EncodingLimitExceeded if sview_len(value) > Limits::ENCODED_BYTES - bytes.count
            for byte in value |bytes|:
                bytes.push(byte)


        def signature_append_string_vector(bytes: mutable darray[u8]&, values: darray[sview]) -> void error[BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic]:
            try signature_append_count(bytes, values.count)
            for value in values |bytes|:
                try signature_append_text(bytes, value)


        def signature_toolchain_identity_valid(identity: BuildRecipeToolchainIdentity) -> bool:
            return identity.word0 != 0 or identity.word1 != 0 or identity.word2 != 0 or identity.word3 != 0


        def signature_encode_recipe(recipe: BuildIncrementalRecipeTarget, command: ProcessCommand, toolchain: BuildRecipeToolchainIdentity) -> darray[u8] error[BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic]:
            command_valid: mutable bool = false
            catch validate_process_command(command):
                ok valid:
                    command_valid <- valid
                error failure:
                    raise BuildRecipeSignatureError.InvalidCommand
            raise BuildRecipeSignatureError.InvalidCommand if not command_valid
            # An inherited environment depends on host state not represented by
            # ProcessCommand. Caching it without a captured environment snapshot
            # could reuse outputs after relevant variables change.
            raise BuildRecipeSignatureError.InheritedEnvironmentUncacheable if command.environment_mode == ProcessEnvironmentMode.Inherit

            raise BuildRecipeSignatureError.InvalidToolchainIdentity if not signature_toolchain_identity_valid(toolchain)

            bytes: mutable darray[u8] = []
            try signature_append_byte(bytes, Encoding::DOMAIN_0)
            try signature_append_byte(bytes, Encoding::DOMAIN_1)
            try signature_append_byte(bytes, Encoding::DOMAIN_2)
            try signature_append_byte(bytes, Encoding::DOMAIN_3)
            try signature_append_byte(bytes, Encoding::VERSION)
            try signature_append_byte(bytes, recipe.kind.u8())
            try signature_append_text(bytes, recipe.name)
            try signature_append_u64(bytes, toolchain.word0)
            try signature_append_u64(bytes, toolchain.word1)
            try signature_append_u64(bytes, toolchain.word2)
            try signature_append_u64(bytes, toolchain.word3)

            try signature_append_text(bytes, command.executable)
            try signature_append_string_vector(bytes, command.arguments)
            try signature_append_text(bytes, command.working_directory)
            try signature_append_byte(bytes, command.environment_mode.u8())
            try signature_append_string_vector(bytes, command.environment)
            try signature_append_byte(bytes, command.stdin_mode.u8())
            try signature_append_text(bytes, command.stdin_path)
            try signature_append_byte(bytes, command.stdout_mode.u8())
            try signature_append_text(bytes, command.stdout_path)
            try signature_append_byte(bytes, command.stderr_mode.u8())
            try signature_append_text(bytes, command.stderr_path)
            try signature_append_u64(bytes, command.timeout_micros)
            try signature_append_count(bytes, command.capture_output_limit_bytes)
            try signature_append_byte(bytes, command.failure_mode.u8())

            try signature_append_string_vector(bytes, recipe.inputs)
            try signature_append_string_vector(bytes, recipe.outputs)
            try signature_append_string_vector(bytes, recipe.dependencies)
            return bytes


        def signature_hash_recipe(recipe: BuildIncrementalRecipeTarget, command: ProcessCommand, toolchain: BuildRecipeToolchainIdentity) -> BuildRecipeSignature error[BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic]:
            bytes: darray[u8] = try signature_encode_recipe(recipe, command, toolchain)
            signature: BuildRecipeSignature = BuildRecipeSignature{
                word0: EsIr::canonical_bytes_sha256_word(bytes, 0),
                word1: EsIr::canonical_bytes_sha256_word(bytes, 1),
                word2: EsIr::canonical_bytes_sha256_word(bytes, 2),
                word3: EsIr::canonical_bytes_sha256_word(bytes, 3)
            }
            raise BuildRecipeSignatureError.HashFailed if signature.word0 == 0 and signature.word1 == 0 and signature.word2 == 0 and signature.word3 == 0
            return signature


    public:
        def build_recipe_signature(recipes: darray[BuildIncrementalRecipeTarget], target_index: usize, command: ProcessCommand, toolchain: BuildRecipeToolchainIdentity) -> BuildRecipeSignature error[BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic]:
            raise BuildRecipeSignatureError.InvalidRecipe if target_index >= recipes.count
            _ = try signature_recipe_graph_valid(recipes)
            return try signature_hash_recipe(recipes[target_index], command, toolchain)


        # Validate the recipe graph once, then hash aligned commands and
        # toolchains in linear traversal order. This avoids revalidating all
        # recipes once per target.
        def build_recipe_signatures_for_actions(commands: darray[ProcessCommand], recipes: darray[BuildIncrementalRecipeTarget], toolchains: darray[BuildRecipeToolchainIdentity]) -> darray[BuildRecipeSignature] error[BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic]:
            raise BuildRecipeSignatureError.InvalidRecipe if commands.count != recipes.count or recipes.count != toolchains.count
            _ = try signature_recipe_graph_valid(recipes)
            signatures: mutable darray[BuildRecipeSignature] = []
            for index in 0..<recipes.count |commands, recipes, toolchains, signatures|:
                signatures.push(try signature_hash_recipe(recipes[index], commands[index], toolchains[index]))
            return signatures


        # Graph construction convenience: validate the graph and project its
        # commands in canonical node order before signing the action vector.
        def build_recipe_signatures_for_graph(graph: BuildGraph, recipes: darray[BuildIncrementalRecipeTarget], toolchains: darray[BuildRecipeToolchainIdentity]) -> darray[BuildRecipeSignature] error[BuildRecipeSignatureError, BuildContractError] can[Memory.Allocate, Abort.Panic]:
            graph_valid: bool = try validate_build_graph(graph)
            raise BuildRecipeSignatureError.InvalidRecipe if not graph_valid or graph.state != BuildGraphState.Planned
            raise BuildRecipeSignatureError.InvalidRecipe if graph.nodes.count != recipes.count or recipes.count != toolchains.count
            commands: mutable darray[ProcessCommand] = []
            for node in graph.nodes |commands|:
                commands.push(node.command)
            return try build_recipe_signatures_for_actions(commands, recipes, toolchains)


        # Return a signed copy so graph construction need not mutate an
        # unsigned recipe in place. Call once per node, then use the resulting
        # signed recipe vector for incremental planning and cache admission.
        def sign_build_incremental_recipe(recipes: darray[BuildIncrementalRecipeTarget], target_index: usize, command: ProcessCommand, toolchain: BuildRecipeToolchainIdentity) -> BuildIncrementalRecipeTarget error[BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic]:
            signature: BuildRecipeSignature = try build_recipe_signature(recipes, target_index, command, toolchain)
            recipe: BuildIncrementalRecipeTarget = recipes[target_index]
            return BuildIncrementalRecipeTarget{
                name: recipe.name,
                kind: recipe.kind,
                recipe_fingerprint: build_recipe_scheduler_fingerprint(signature),
                recipe_signature: signature,
                toolchain_identity: toolchain,
                inputs: recipe.inputs,
                outputs: recipe.outputs,
                dependencies: recipe.dependencies
            }


        # Sign a complete graph/recipe pair so command fingerprints cannot be
        # accidentally copied from an unrelated graph construction step.
        def sign_build_incremental_graph(graph: BuildGraph, recipes: darray[BuildIncrementalRecipeTarget], toolchains: darray[BuildRecipeToolchainIdentity]) -> BuildRecipeSignedGraph error[BuildRecipeSignatureError, BuildContractError] can[Memory.Allocate, Abort.Panic]:
            signatures: darray[BuildRecipeSignature] = try build_recipe_signatures_for_graph(graph, recipes, toolchains)
            signed_graph: mutable BuildGraph = graph
            signed_recipes: mutable darray[BuildIncrementalRecipeTarget] = []
            for index in 0..<recipes.count |graph, recipes, toolchains, signed_graph, signed_recipes|:
                recipe: BuildIncrementalRecipeTarget = recipes[index]
                signed_recipe: BuildIncrementalRecipeTarget = BuildIncrementalRecipeTarget{
                    name: recipe.name,
                    kind: recipe.kind,
                    recipe_fingerprint: build_recipe_scheduler_fingerprint(signatures[index]),
                    recipe_signature: signatures[index],
                    toolchain_identity: toolchains[index],
                    inputs: recipe.inputs,
                    outputs: recipe.outputs,
                    dependencies: recipe.dependencies
                }
                signed_graph.nodes[index].fingerprint <- signed_recipe.recipe_fingerprint
                signed_graph.nodes[index].recipe_signature <- signed_recipe.recipe_signature
                signed_recipes.push(signed_recipe)
            return BuildRecipeSignedGraph{graph: signed_graph, recipes: signed_recipes}
