# Stable, bounded UTF-8 file adapter for shader permutation selections.
module EsShaderPermutationSelectionPosix:
    using EsBoundedText
    using EsShaderPermutationSelection

    public:
        error BinarySelectionError:
            BinaryOutsideRoot


        struct ShaderBinaryPaths:
            paths: darray[Path] = []
            # These views borrow selection.names; keep the Selection alive
            # while rendering missing-name diagnostics.
            missing: darray[sview] = []


        def read_shader_selection_file(path: Path) -> Selection error[EsBoundedText::ReadError, SelectionError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            source: sview = try EsBoundedText::read_utf8(path, Limits::INPUT_BYTES) else err:
                if err == EsBoundedText::ReadError.LimitExceeded:
                    raise SelectionError.SelectionTooLarge
                elif err == EsBoundedText::ReadError.InvalidUtf8:
                    raise SelectionError.JsonArrayRequired
                else:
                    raise err
            return try parse_selection_json(source)


        def read_optional_shader_selection(has_path: bool, path: Path) -> Selection error[EsBoundedText::ReadError, SelectionError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return all_shader_permutations() if not has_path
            return try read_shader_selection_file(path)


        # Value-level counterpart of Python's select_binaries(root, binaries,
        # selected): omitted selection preserves input order, while an
        # explicit selection sorts names and keeps the last duplicate path.
        def select_shader_binary_paths(root: Path, binaries: darray[Path], selection: Selection&) -> ShaderBinaryPaths error[BinarySelectionError] can[Memory.Allocate, Abort.Panic]:
            if selection.select_all:
                return ShaderBinaryPaths{paths: binaries}

            available_names: mutable darray[sview] = []
            available_names.reserve(binaries.count)
            for binary in binaries |available_names|:
                relative_name: sview = try shader_relative_to(root, binary)
                available_names.push(relative_name)

            resolved: Resolution = resolve_shader_permutations(selection, available_names)
            result: mutable ShaderBinaryPaths = ShaderBinaryPaths{missing: resolved.missing}
            result.paths.reserve(resolved.indices.count)
            for index in resolved.indices:
                result.paths.push(binaries[index])
            return result


    private:
        # Match pathlib.Path.relative_to's lexical component-prefix rule.
        # The language's Path.relative_to is an os.path.relpath-style helper,
        # which would incorrectly accept sibling prefixes such as /rooted.
        def shader_relative_to(root: Path, target: Path) -> sview error[BinarySelectionError] can[Memory.Allocate, Abort.Panic]:
            root_text: sview = f"{root}"
            target_text: sview = f"{target}"
            root_absolute: bool = len(root_text) != 0 and sview_at(root_text, 0) == 47u8
            target_absolute: bool = len(target_text) != 0 and sview_at(target_text, 0) == 47u8
            same_anchor: bool = root_absolute == target_absolute and shader_double_slash_root(root_text) == shader_double_slash_root(target_text)
            raise BinarySelectionError.BinaryOutsideRoot if not same_anchor

            root_components: darray[sview] = shader_path_components(root_text)
            target_components: darray[sview] = shader_path_components(target_text)
            raise BinarySelectionError.BinaryOutsideRoot if target_components.count < root_components.count
            for index in 0..<root_components.count |root_components, target_components|:
                raise BinarySelectionError.BinaryOutsideRoot if root_components[index] != target_components[index]

            relative_components: mutable darray[sview] = []
            relative_components.reserve(target_components.count - root_components.count)
            for index in root_components.count..<target_components.count |target_components, relative_components|:
                relative_components.push(target_components[index])
            return "." if relative_components.count == 0
            return join(relative_components, "/")


        def shader_path_components(path_text: sview) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            components: mutable darray[sview] = []
            component_start: mutable usize = 0
            cursor: mutable usize = 0
            while cursor <= len(path_text):
                at_end: bool = cursor == len(path_text)
                at_separator: bool = not at_end and sview_at(path_text, cursor) == 47u8
                if at_end or at_separator:
                    if cursor > component_start:
                        component: sview = path_text[component_start:cursor]
                        if component != ".":
                            components.push(component)
                    component_start <- cursor + 1
                cursor <- cursor + 1
            return components


        def shader_double_slash_root(path_text: sview) -> bool:
            return false if len(path_text) < 2 or sview_at(path_text, 0) != 47u8 or sview_at(path_text, 1) != 47u8
            return len(path_text) == 2 or sview_at(path_text, 2) != 47u8
