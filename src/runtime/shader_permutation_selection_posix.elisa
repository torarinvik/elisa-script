# Stable, bounded UTF-8 file adapter for shader permutation selections.
module EsShaderPermutationSelectionPosix:
    using EsBoundedText
    using EsShaderPermutationSelection

    public:
        def read_shader_selection_file(path: Path) -> Selection error[EsBoundedText::ReadError, SelectionError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            source: sview = try EsBoundedText::read_utf8(path, Limits::INPUT_BYTES) else err:
                if err == EsBoundedText::ReadError.LimitExceeded:
                    raise SelectionError.SelectionTooLarge
                elif err == EsBoundedText::ReadError.InvalidUtf8:
                    raise SelectionError.JsonArrayRequired
                else:
                    raise err
            return try parse_selection_json(source)


        def read_optional_shader_selection(has_path: bool, path: Path) -> Selection error[EsBoundedText::ReadError, SelectionError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return all_shader_permutations() if not has_path
            return try read_shader_selection_file(path)
