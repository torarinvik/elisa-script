# Pure bounded-C-string admission. A payload limit excludes the NUL terminator.
module EsEnvironmentReadBudget:
    public:
        const module Limits:
            MAX_VALUE_BYTES: i64 = 67108863


        error BudgetError:
            InvalidLimit


        const enum ByteAction of u8:
            Payload
            Terminator
            Exceeded


        # Zero admits only an empty value; it never means unlimited.
        def admit_limit(max_bytes: i64) -> usize error[BudgetError]:
            raise BudgetError.InvalidLimit if max_bytes < 0 or max_bytes > Limits::MAX_VALUE_BYTES
            return max_bytes.usize()


        # The caller reads indices 0..limit inclusive, then stops. At the
        # boundary, a terminator is admitted but another payload byte is not.
        def classify_byte(byte: u8, index: usize, limit: usize) -> ByteAction:
            return ByteAction.Exceeded if index > limit
            return ByteAction.Terminator if byte == 0u8
            return ByteAction.Exceeded if index == limit
            return ByteAction.Payload
