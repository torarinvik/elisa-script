# Typed CLI workflow planning boundary.
#
# Parsing an invocation is not execution. This module maps every accepted
# launcher mode to a deterministic sequence of typed steps, so a future host
# driver cannot silently route check/test/fmt/doc through run.

module EsCliWorkflow:
    using EsCli

    public:
        const CLI_WORKFLOW_MAX_STEPS: usize = 8


        const enum CliWorkflowStep of u8:
            LoadSource
            Lower
            Verify
            Execute
            Format
            Document
            Render


        const enum CliWorkflowState of u8:
            Planned
            Running
            Cancelling
            Complete
            Failed
            Cancelled


        const enum CliWorkflowEvent of u8:
            Begin
            StepComplete
            Fail
            Cancel
            CancelAck


        struct CliWorkflow:
            invocation: CliInvocation
            steps: darray[CliWorkflowStep] = []
            state: CliWorkflowState = CliWorkflowState.Planned
            next_step: usize = 0


        error CliWorkflowError:
            InvalidState
            InvalidEvent
            InvalidStep
            StepLimitExceeded
            StepOrderInvalid
            StepNotReady
            CancelNotReady
            InvocationInvalid


    private:
        def workflow_state_valid(state: CliWorkflowState) -> bool:
            return state in {CliWorkflowState.Planned, CliWorkflowState.Running, CliWorkflowState.Cancelling, CliWorkflowState.Complete, CliWorkflowState.Failed, CliWorkflowState.Cancelled}


        def workflow_event_valid(event: CliWorkflowEvent) -> bool:
            return event in {CliWorkflowEvent.Begin, CliWorkflowEvent.StepComplete, CliWorkflowEvent.Fail, CliWorkflowEvent.Cancel, CliWorkflowEvent.CancelAck}


        def workflow_step_valid(step: CliWorkflowStep) -> bool:
            return step in {CliWorkflowStep.LoadSource, CliWorkflowStep.Lower, CliWorkflowStep.Verify, CliWorkflowStep.Execute, CliWorkflowStep.Format, CliWorkflowStep.Document, CliWorkflowStep.Render}


        def workflow_add_step(steps: mutable darray[CliWorkflowStep]&, step: CliWorkflowStep) -> bool error[CliWorkflowError]:
            raise CliWorkflowError.StepLimitExceeded if steps.count >= CLI_WORKFLOW_MAX_STEPS
            steps.push(step)
            return true


        def workflow_mode_shape_valid(workflow: CliWorkflow&) -> bool:
            mode: CliMode = workflow.invocation.mode
            if mode == CliMode.Run or mode == CliMode.Test:
                return workflow.steps.count == 5 and workflow.steps[0] == CliWorkflowStep.LoadSource and workflow.steps[1] == CliWorkflowStep.Lower and workflow.steps[2] == CliWorkflowStep.Verify and workflow.steps[3] == CliWorkflowStep.Execute and workflow.steps[4] == CliWorkflowStep.Render
            if mode == CliMode.Check:
                return workflow.steps.count == 4 and workflow.steps[0] == CliWorkflowStep.LoadSource and workflow.steps[1] == CliWorkflowStep.Lower and workflow.steps[2] == CliWorkflowStep.Verify and workflow.steps[3] == CliWorkflowStep.Render
            if mode == CliMode.Fmt:
                return workflow.steps.count == 3 and workflow.steps[0] == CliWorkflowStep.LoadSource and workflow.steps[1] == CliWorkflowStep.Format and workflow.steps[2] == CliWorkflowStep.Render
            if mode == CliMode.Doc:
                return workflow.steps.count == 3 and workflow.steps[0] == CliWorkflowStep.LoadSource and workflow.steps[1] == CliWorkflowStep.Document and workflow.steps[2] == CliWorkflowStep.Render
            return (mode == CliMode.Help or mode == CliMode.Version) and workflow.steps.count == 1 and workflow.steps[0] == CliWorkflowStep.Render


        public:
        def validate_cli_workflow(workflow: CliWorkflow&) -> bool error[CliWorkflowError]:
            valid_invocation: mutable bool = false
            catch validate_cli_invocation(workflow.invocation):
                ok:
                    valid_invocation <- true
                error failure:
                    valid_invocation <- false
            raise CliWorkflowError.InvocationInvalid if not valid_invocation
            raise CliWorkflowError.InvalidState if not workflow_state_valid(workflow.state)
            raise CliWorkflowError.StepLimitExceeded if workflow.steps.count == 0 or workflow.steps.count > CLI_WORKFLOW_MAX_STEPS
            raise CliWorkflowError.StepOrderInvalid if workflow.next_step > workflow.steps.count
            raise CliWorkflowError.StepOrderInvalid if not workflow_mode_shape_valid(workflow)
            raise CliWorkflowError.StepOrderInvalid if workflow.state == CliWorkflowState.Planned and workflow.next_step != 0
            raise CliWorkflowError.StepOrderInvalid if workflow.state == CliWorkflowState.Running and workflow.next_step >= workflow.steps.count
            raise CliWorkflowError.StepOrderInvalid if workflow.state == CliWorkflowState.Cancelling and workflow.next_step >= workflow.steps.count
            raise CliWorkflowError.StepOrderInvalid if workflow.state == CliWorkflowState.Complete and workflow.next_step != workflow.steps.count
            raise CliWorkflowError.StepOrderInvalid if (workflow.state == CliWorkflowState.Failed or workflow.state == CliWorkflowState.Cancelled) and workflow.next_step >= workflow.steps.count
            for step in workflow.steps:
                raise CliWorkflowError.InvalidStep if not workflow_step_valid(step)
            return true


        def plan_cli_workflow(invocation: CliInvocation) -> CliWorkflow error[CliWorkflowError]:
            valid_invocation: mutable bool = false
            catch validate_cli_invocation(invocation):
                ok:
                    valid_invocation <- true
                error failure:
                    valid_invocation <- false
            raise CliWorkflowError.InvocationInvalid if not valid_invocation
            steps: mutable darray[CliWorkflowStep] = []
            if invocation.mode == CliMode.Run:
                try workflow_add_step(steps, CliWorkflowStep.LoadSource)
                try workflow_add_step(steps, CliWorkflowStep.Lower)
                try workflow_add_step(steps, CliWorkflowStep.Verify)
                try workflow_add_step(steps, CliWorkflowStep.Execute)
                try workflow_add_step(steps, CliWorkflowStep.Render)
            elif invocation.mode == CliMode.Check:
                try workflow_add_step(steps, CliWorkflowStep.LoadSource)
                try workflow_add_step(steps, CliWorkflowStep.Lower)
                try workflow_add_step(steps, CliWorkflowStep.Verify)
                try workflow_add_step(steps, CliWorkflowStep.Render)
            elif invocation.mode == CliMode.Test:
                try workflow_add_step(steps, CliWorkflowStep.LoadSource)
                try workflow_add_step(steps, CliWorkflowStep.Lower)
                try workflow_add_step(steps, CliWorkflowStep.Verify)
                try workflow_add_step(steps, CliWorkflowStep.Execute)
                try workflow_add_step(steps, CliWorkflowStep.Render)
            elif invocation.mode == CliMode.Fmt:
                try workflow_add_step(steps, CliWorkflowStep.LoadSource)
                try workflow_add_step(steps, CliWorkflowStep.Format)
                try workflow_add_step(steps, CliWorkflowStep.Render)
            elif invocation.mode == CliMode.Doc:
                try workflow_add_step(steps, CliWorkflowStep.LoadSource)
                try workflow_add_step(steps, CliWorkflowStep.Document)
                try workflow_add_step(steps, CliWorkflowStep.Render)
            elif invocation.mode == CliMode.Help or invocation.mode == CliMode.Version:
                try workflow_add_step(steps, CliWorkflowStep.Render)
            else:
                raise CliWorkflowError.InvocationInvalid
            return CliWorkflow{invocation: invocation, steps: steps}


        def advance_cli_workflow(workflow: mutable CliWorkflow&, event: CliWorkflowEvent, step: CliWorkflowStep = CliWorkflowStep.LoadSource) -> CliWorkflowState error[CliWorkflowError]:
            try validate_cli_workflow(workflow)
            raise CliWorkflowError.InvalidEvent if not workflow_event_valid(event)
            if event == CliWorkflowEvent.Begin:
                raise CliWorkflowError.InvalidState if workflow.state != CliWorkflowState.Planned
                workflow.state <- CliWorkflowState.Running
            elif event == CliWorkflowEvent.StepComplete:
                raise CliWorkflowError.StepNotReady if workflow.state != CliWorkflowState.Running or workflow.next_step >= workflow.steps.count
                raise CliWorkflowError.InvalidStep if workflow.steps[workflow.next_step] != step
                workflow.next_step <- workflow.next_step + 1
                workflow.state <- CliWorkflowState.Complete if workflow.next_step == workflow.steps.count
            elif event == CliWorkflowEvent.Fail:
                raise CliWorkflowError.InvalidState if workflow.state != CliWorkflowState.Running
                workflow.state <- CliWorkflowState.Failed
            elif event == CliWorkflowEvent.Cancel:
                raise CliWorkflowError.CancelNotReady if workflow.state != CliWorkflowState.Running
                workflow.state <- CliWorkflowState.Cancelling
            elif event == CliWorkflowEvent.CancelAck:
                raise CliWorkflowError.CancelNotReady if workflow.state != CliWorkflowState.Cancelling
                workflow.state <- CliWorkflowState.Cancelled
            return workflow.state
