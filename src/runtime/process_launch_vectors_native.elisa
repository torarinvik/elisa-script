# Unwired parent-side pointer tables. No cast-to-void, host syscall or fork.
# The caller must retain and not mutate storage while any table is borrowed.
include "process_launch_vectors_model.elisa"

extend EsProcessLaunchVectors:
    public:
        struct BorrowedTables:
            argv: darray[u8&?]
            environment: darray[u8&?]
            candidates: darray[u8&?]
            receipt: Receipt


        def native_pointer_bytes() -> usize error[VectorError]:
            return try admit_pointer_layout(size_of(uintptr), size_of(u8&?))


        def validate_native_bindings(storage: EsProcessLaunchStorage::Prepared&, tables: BorrowedTables&, max_total_bytes: usize = EsProcessLaunchStorage::Limits::STORAGE_BYTES) -> Receipt error[VectorError]:
            pointer_bytes: usize = try native_pointer_bytes()
            admitted: Receipt = try admit(storage, pointer_bytes, max_total_bytes)
            raise VectorError.InvalidBinding if tables.argv.count != admitted.argv_slots or tables.environment.count != admitted.environment_slots or tables.candidates.count != admitted.candidate_slots
            raise VectorError.InvalidReceipt if tables.receipt.argv_slots != admitted.argv_slots or tables.receipt.environment_slots != admitted.environment_slots or tables.receipt.candidate_slots != admitted.candidate_slots or tables.receipt.pointer_bytes != admitted.pointer_bytes or tables.receipt.table_bytes != admitted.table_bytes or tables.receipt.total_bytes != admitted.total_bytes
            raise VectorError.InvalidBinding if tables.argv[tables.argv.count - 1] != null or tables.environment[tables.environment.count - 1] != null or tables.candidates[tables.candidates.count - 1] != null
            for index in 0..<storage.arguments.count:
                raise VectorError.InvalidBinding if tables.argv[index] != &storage.arguments[index][0]
            for index in 0..<storage.environment.environment.count:
                raise VectorError.InvalidBinding if tables.environment[index] != &storage.environment.environment[index][0]
            for index in 0..<storage.environment.executable_candidates.count:
                raise VectorError.InvalidBinding if tables.candidates[index] != &storage.environment.executable_candidates[index][0]
            return admitted


        def build_native_tables(storage: EsProcessLaunchStorage::Prepared&, max_total_bytes: usize = EsProcessLaunchStorage::Limits::STORAGE_BYTES) -> BorrowedTables error[VectorError] can[Memory.Allocate, Abort.Panic]:
            # Derive the pointer width from the native target, not an env marker
            # or caller assertion. ABI/layout and region lifetime need compiler
            # qualification before this source is integrated into an executor.
            pointer_bytes: usize = try native_pointer_bytes()
            receipt: Receipt = try admit(storage, pointer_bytes, max_total_bytes)
            argv: mutable darray[u8&?] = []
            environment: mutable darray[u8&?] = []
            candidates: mutable darray[u8&?] = []
            argv.reserve(receipt.argv_slots)
            environment.reserve(receipt.environment_slots)
            candidates.reserve(receipt.candidate_slots)
            for index in 0..<storage.arguments.count |argv|:
                argv.push(&storage.arguments[index][0])
            argv.push(null)
            for index in 0..<storage.environment.environment.count |environment|:
                environment.push(&storage.environment.environment[index][0])
            environment.push(null)
            for index in 0..<storage.environment.executable_candidates.count |candidates|:
                candidates.push(&storage.environment.executable_candidates[index][0])
            candidates.push(null)
            return BorrowedTables{argv: argv, environment: environment, candidates: candidates, receipt: receipt}
