# Typed, bounded network request/response contracts.
#
# This module is transport-neutral: it validates the data and policy that an
# HTTP/TLS adapter must honor without opening sockets or silently retrying a
# mutation. Headers remain ordered flat pairs so canonicalization is explicit.

module EsNetwork:
    public:
        const NETWORK_MAX_URL_BYTES: usize = 16384
        const NETWORK_MAX_HEADER_BYTES: usize = 1048576
        const NETWORK_MAX_BODY_BYTES: usize = 67108864
        const NETWORK_MAX_RETRY_ATTEMPTS: usize = 8
        const NETWORK_MAX_BACKOFF_MICROS: u64 = 60000000
        const NETWORK_MAX_TLS_PATH_BYTES: usize = 4096
        const NETWORK_MAX_CHUNK_BYTES: usize = 1048576
        const NETWORK_MAX_BUFFER_BYTES: usize = 16777216
        const NETWORK_MAX_STREAM_CHUNKS: usize = 1048576


        const enum NetworkMethod of u8:
            Get
            Head
            Post
            Put
            Patch
            Delete


        const enum NetworkOutcome of u8:
            Success
            DnsFailure
            TlsFailure
            TransportFailure
            Timeout
            ProtocolFailure
            StatusFailure
            DecodeFailure
            Cancelled


        const enum NetworkRetryMode of u8:
            Never
            IdempotentOnly
            Explicit


        struct NetworkRetryPolicy:
            mode: NetworkRetryMode = NetworkRetryMode.Never
            max_attempts: usize = 1
            initial_backoff_micros: u64 = 0
            max_backoff_micros: u64 = 0


        const enum NetworkTlsVersion of u8:
            Tls12
            Tls13


        const enum NetworkTlsTrustMode of u8:
            System
            CustomBundle
            InsecureTestOnly


        struct NetworkTlsPolicy:
            version: NetworkTlsVersion = NetworkTlsVersion.Tls12
            trust_mode: NetworkTlsTrustMode = NetworkTlsTrustMode.System
            ca_bundle_path: sview = ""
            server_name: sview = ""
            client_certificate_path: sview = ""
            client_key_path: sview = ""


        const enum NetworkStreamDirection of u8:
            Request
            Response


        const enum NetworkStreamState of u8:
            Idle
            Open
            Paused
            Finished
            Failed
            Cancelling
            Cancelled


        const enum NetworkStreamEvent of u8:
            Open
            Pause
            Resume
            Finish
            Fail
            Cancel
            CancelAck


        struct NetworkChunk:
            sequence: usize
            bytes: darray[u8] = []
            final_chunk: bool = false


        struct NetworkStream:
            direction: NetworkStreamDirection
            state: NetworkStreamState = NetworkStreamState.Idle
            next_sequence: usize = 0
            buffered_bytes: usize = 0
            max_buffer_bytes: usize = NETWORK_MAX_BUFFER_BYTES
            final_seen: bool = false


        const enum NetworkRequestState of u8:
            Planned
            Resolving
            Connecting
            Securing
            Sending
            Receiving
            Completed
            Failed
            Cancelling
            Cancelled


        const enum NetworkRequestEvent of u8:
            Begin
            DnsReady
            ConnectReady
            TlsReady
            SendComplete
            ReceiveComplete
            Fail
            Cancel
            CancelAck
            Retry


        struct NetworkRequestJob:
            state: NetworkRequestState = NetworkRequestState.Planned
            attempts: usize = 0
            max_attempts: usize = 1


        struct NetworkRequest:
            url: sview
            method: NetworkMethod = NetworkMethod.Get
            headers: darray[sview] = []
            body: darray[u8] = []
            timeout_micros: u64 = 0
            max_response_bytes: usize = NETWORK_MAX_BODY_BYTES
            follow_redirects: bool = false
            retry: NetworkRetryPolicy = NetworkRetryPolicy{}
            tls: NetworkTlsPolicy = NetworkTlsPolicy{}


        struct NetworkResponse:
            outcome: NetworkOutcome = NetworkOutcome.Success
            status: u16 = 200
            headers: darray[sview] = []
            body: darray[u8] = []
            error_text: sview = ""


        error NetworkContractError:
            InvalidMethod
            InvalidOutcome
            MissingUrl
            EmbeddedNul
            UrlLimitExceeded
            HeaderVectorMalformed
            HeaderNameInvalid
            DuplicateHeaderName
            HeaderLimitExceeded
            BodyLimitExceeded
            InvalidTimeout
            InvalidResponseLimit
            InvalidRetryMode
            InvalidRetryAttempts
            InvalidRetryBackoff
            NonIdempotentRetry
            InvalidTlsVersion
            InvalidTlsTrustMode
            InvalidTlsBundle
            InvalidTlsClientIdentity
            TlsPathLimitExceeded
            TlsPathEmbeddedNul
            InvalidStreamDirection
            InvalidStreamState
            InvalidStreamEvent
            InvalidChunk
            ChunkLimitExceeded
            ChunkSequenceMismatch
            StreamBufferExceeded
            StreamNotComplete
            StreamNotDrained
            StreamAccountingInvalid
            InvalidRequestState
            InvalidRequestEvent
            RetryLimitExceeded
            InvalidStatus
            ErrorTextInvalid


    private:
        def network_method_valid(method: NetworkMethod) -> bool:
            return method in {NetworkMethod.Get, NetworkMethod.Head, NetworkMethod.Post, NetworkMethod.Put, NetworkMethod.Patch, NetworkMethod.Delete}


        def network_outcome_valid(outcome: NetworkOutcome) -> bool:
            return outcome in {NetworkOutcome.Success, NetworkOutcome.DnsFailure, NetworkOutcome.TlsFailure, NetworkOutcome.TransportFailure, NetworkOutcome.Timeout, NetworkOutcome.ProtocolFailure, NetworkOutcome.StatusFailure, NetworkOutcome.DecodeFailure, NetworkOutcome.Cancelled}


        def network_retry_mode_valid(mode: NetworkRetryMode) -> bool:
            return mode in {NetworkRetryMode.Never, NetworkRetryMode.IdempotentOnly, NetworkRetryMode.Explicit}


        def network_tls_version_valid(version: NetworkTlsVersion) -> bool:
            return version in {NetworkTlsVersion.Tls12, NetworkTlsVersion.Tls13}


        def network_tls_trust_mode_valid(mode: NetworkTlsTrustMode) -> bool:
            return mode in {NetworkTlsTrustMode.System, NetworkTlsTrustMode.CustomBundle, NetworkTlsTrustMode.InsecureTestOnly}


        def network_tls_path_valid(value: sview) -> bool:
            return value == "" or (sview_len(value) < NETWORK_MAX_TLS_PATH_BYTES and not sview_contains_byte(value, 0))


        def network_stream_direction_valid(direction: NetworkStreamDirection) -> bool:
            return direction in {NetworkStreamDirection.Request, NetworkStreamDirection.Response}


        def network_stream_state_valid(state: NetworkStreamState) -> bool:
            return state in {NetworkStreamState.Idle, NetworkStreamState.Open, NetworkStreamState.Paused, NetworkStreamState.Finished, NetworkStreamState.Failed, NetworkStreamState.Cancelling, NetworkStreamState.Cancelled}


        def network_stream_event_valid(event: NetworkStreamEvent) -> bool:
            return event in {NetworkStreamEvent.Open, NetworkStreamEvent.Pause, NetworkStreamEvent.Resume, NetworkStreamEvent.Finish, NetworkStreamEvent.Fail, NetworkStreamEvent.Cancel, NetworkStreamEvent.CancelAck}


        def network_stream_active(state: NetworkStreamState) -> bool:
            return state == NetworkStreamState.Open or state == NetworkStreamState.Paused


        def network_method_is_idempotent(method: NetworkMethod) -> bool:
            return method in {NetworkMethod.Get, NetworkMethod.Head, NetworkMethod.Put, NetworkMethod.Delete}


        def network_request_state_valid(state: NetworkRequestState) -> bool:
            return state in {NetworkRequestState.Planned, NetworkRequestState.Resolving, NetworkRequestState.Connecting, NetworkRequestState.Securing, NetworkRequestState.Sending, NetworkRequestState.Receiving, NetworkRequestState.Completed, NetworkRequestState.Failed, NetworkRequestState.Cancelling, NetworkRequestState.Cancelled}


        def network_request_event_valid(event: NetworkRequestEvent) -> bool:
            return event in {NetworkRequestEvent.Begin, NetworkRequestEvent.DnsReady, NetworkRequestEvent.ConnectReady, NetworkRequestEvent.TlsReady, NetworkRequestEvent.SendComplete, NetworkRequestEvent.ReceiveComplete, NetworkRequestEvent.Fail, NetworkRequestEvent.Cancel, NetworkRequestEvent.CancelAck, NetworkRequestEvent.Retry}


        def network_request_state_is_active(state: NetworkRequestState) -> bool:
            return state in {NetworkRequestState.Resolving, NetworkRequestState.Connecting, NetworkRequestState.Securing, NetworkRequestState.Sending, NetworkRequestState.Receiving}


        def network_request_state_requires_attempt(state: NetworkRequestState) -> bool:
            return state in {NetworkRequestState.Resolving, NetworkRequestState.Connecting, NetworkRequestState.Securing, NetworkRequestState.Sending, NetworkRequestState.Receiving, NetworkRequestState.Completed, NetworkRequestState.Failed, NetworkRequestState.Cancelling}


        def network_text_length_valid(value: sview, limit: usize) -> bool:
            return sview_len(value) < limit


        def network_text_valid(value: sview, limit: usize) -> bool:
            return network_text_length_valid(value, limit) and not sview_contains_byte(value, 0)


        def network_header_name_valid(name: sview) -> bool:
            return sview_len(name) != 0 and network_text_valid(name, NETWORK_MAX_HEADER_BYTES) and not sview_contains_byte(name, 58) and not sview_contains_byte(name, 32)


        def network_headers_valid(headers: darray[sview]) -> bool error[NetworkContractError]:
            raise NetworkContractError.HeaderVectorMalformed if headers.count % 2 != 0
            total: mutable usize = 0
            for offset in 0..<headers.count |headers, total|:
                entry: sview = headers[offset]
                raise NetworkContractError.HeaderLimitExceeded if not network_text_length_valid(entry, NETWORK_MAX_HEADER_BYTES)
                raise NetworkContractError.EmbeddedNul if sview_contains_byte(entry, 0)
                if offset % 2 == 0:
                    raise NetworkContractError.HeaderNameInvalid if not network_header_name_valid(entry)
                    for earlier in 0..<offset |headers, entry|:
                        raise NetworkContractError.DuplicateHeaderName if earlier % 2 == 0 and headers[earlier] == entry
                raise NetworkContractError.HeaderLimitExceeded if total > NETWORK_MAX_HEADER_BYTES - sview_len(entry) - 1
                total <- total + sview_len(entry) + 1
            return true


        public:
            def validate_network_stream(stream: NetworkStream&) -> bool error[NetworkContractError]:
                raise NetworkContractError.InvalidStreamDirection if not network_stream_direction_valid(stream.direction)
                raise NetworkContractError.InvalidStreamState if not network_stream_state_valid(stream.state)
                raise NetworkContractError.StreamBufferExceeded if stream.max_buffer_bytes == 0 or stream.max_buffer_bytes > NETWORK_MAX_BUFFER_BYTES
                raise NetworkContractError.StreamBufferExceeded if stream.buffered_bytes > stream.max_buffer_bytes
                raise NetworkContractError.ChunkSequenceMismatch if stream.next_sequence > NETWORK_MAX_STREAM_CHUNKS
                raise NetworkContractError.StreamAccountingInvalid if stream.next_sequence == 0 and (stream.buffered_bytes != 0 or stream.final_seen)
                raise NetworkContractError.StreamAccountingInvalid if stream.state == NetworkStreamState.Idle and (stream.next_sequence != 0 or stream.buffered_bytes != 0 or stream.final_seen)
                raise NetworkContractError.StreamAccountingInvalid if stream.state == NetworkStreamState.Finished and (stream.next_sequence == 0 or not stream.final_seen or stream.buffered_bytes != 0)
                return true


            def advance_network_stream(stream: mutable NetworkStream&, event: NetworkStreamEvent) -> NetworkStreamState error[NetworkContractError]:
                try validate_network_stream(stream)
                raise NetworkContractError.InvalidStreamEvent if not network_stream_event_valid(event)
                if event == NetworkStreamEvent.Open:
                    raise NetworkContractError.InvalidStreamState if stream.state != NetworkStreamState.Idle
                    stream.state <- NetworkStreamState.Open
                elif event == NetworkStreamEvent.Pause:
                    raise NetworkContractError.InvalidStreamState if stream.state != NetworkStreamState.Open
                    stream.state <- NetworkStreamState.Paused
                elif event == NetworkStreamEvent.Resume:
                    raise NetworkContractError.InvalidStreamState if stream.state != NetworkStreamState.Paused
                    stream.state <- NetworkStreamState.Open
                elif event == NetworkStreamEvent.Finish:
                    raise NetworkContractError.InvalidStreamState if not network_stream_active(stream.state)
                    raise NetworkContractError.StreamNotComplete if not stream.final_seen
                    raise NetworkContractError.StreamNotDrained if stream.buffered_bytes != 0
                    stream.state <- NetworkStreamState.Finished
                elif event == NetworkStreamEvent.Fail:
                    raise NetworkContractError.InvalidStreamState if not network_stream_active(stream.state)
                    stream.state <- NetworkStreamState.Failed
                elif event == NetworkStreamEvent.Cancel:
                    if stream.state == NetworkStreamState.Idle:
                        stream.state <- NetworkStreamState.Cancelled
                    else:
                        raise NetworkContractError.InvalidStreamState if not network_stream_active(stream.state)
                        stream.state <- NetworkStreamState.Cancelling
                elif event == NetworkStreamEvent.CancelAck:
                    raise NetworkContractError.InvalidStreamState if stream.state != NetworkStreamState.Cancelling
                    stream.state <- NetworkStreamState.Cancelled
                return stream.state


            def enqueue_network_chunk(stream: mutable NetworkStream&, chunk: NetworkChunk&) -> bool error[NetworkContractError]:
                try validate_network_stream(stream)
                raise NetworkContractError.InvalidStreamState if stream.state != NetworkStreamState.Open
                raise NetworkContractError.InvalidChunk if chunk.bytes.count == 0 and not chunk.final_chunk
                raise NetworkContractError.ChunkLimitExceeded if chunk.bytes.count > NETWORK_MAX_CHUNK_BYTES
                raise NetworkContractError.ChunkSequenceMismatch if chunk.sequence != stream.next_sequence
                raise NetworkContractError.ChunkSequenceMismatch if stream.final_seen
                raise NetworkContractError.StreamBufferExceeded if chunk.bytes.count > stream.max_buffer_bytes - stream.buffered_bytes
                raise NetworkContractError.ChunkSequenceMismatch if stream.next_sequence >= NETWORK_MAX_STREAM_CHUNKS
                stream.buffered_bytes <- stream.buffered_bytes + chunk.bytes.count
                stream.next_sequence <- stream.next_sequence + 1
                stream.final_seen <- chunk.final_chunk if chunk.final_chunk
                return true


            def consume_network_stream(stream: mutable NetworkStream&, amount: usize) -> usize error[NetworkContractError]:
                try validate_network_stream(stream)
                raise NetworkContractError.StreamBufferExceeded if amount > stream.buffered_bytes
                stream.buffered_bytes <- stream.buffered_bytes - amount
                return amount


            def validate_network_tls_policy(policy: NetworkTlsPolicy&) -> bool error[NetworkContractError]:
                raise NetworkContractError.InvalidTlsVersion if not network_tls_version_valid(policy.version)
                raise NetworkContractError.InvalidTlsTrustMode if not network_tls_trust_mode_valid(policy.trust_mode)
                raise NetworkContractError.TlsPathEmbeddedNul if sview_contains_byte(policy.ca_bundle_path, 0) or sview_contains_byte(policy.server_name, 0) or sview_contains_byte(policy.client_certificate_path, 0) or sview_contains_byte(policy.client_key_path, 0)
                raise NetworkContractError.TlsPathLimitExceeded if not network_tls_path_valid(policy.ca_bundle_path) or not network_tls_path_valid(policy.server_name) or not network_tls_path_valid(policy.client_certificate_path) or not network_tls_path_valid(policy.client_key_path)
                if policy.trust_mode == NetworkTlsTrustMode.CustomBundle:
                    raise NetworkContractError.InvalidTlsBundle if policy.ca_bundle_path == ""
                else:
                    raise NetworkContractError.InvalidTlsBundle if policy.ca_bundle_path != ""
                raise NetworkContractError.InvalidTlsClientIdentity if (policy.client_certificate_path == "") != (policy.client_key_path == "")
                return true


            def advance_network_request(job: mutable NetworkRequestJob&, event: NetworkRequestEvent) -> NetworkRequestState error[NetworkContractError]:
                raise NetworkContractError.InvalidRequestState if not network_request_state_valid(job.state)
                raise NetworkContractError.InvalidRequestEvent if not network_request_event_valid(event)
                raise NetworkContractError.InvalidRetryAttempts if job.max_attempts == 0 or job.max_attempts > NETWORK_MAX_RETRY_ATTEMPTS
                raise NetworkContractError.RetryLimitExceeded if job.attempts > job.max_attempts
                raise NetworkContractError.InvalidRequestState if network_request_state_requires_attempt(job.state) and job.attempts == 0
                raise NetworkContractError.RetryLimitExceeded if job.state == NetworkRequestState.Planned and job.attempts >= job.max_attempts
                if event == NetworkRequestEvent.Begin:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Planned
                    raise NetworkContractError.RetryLimitExceeded if job.attempts >= job.max_attempts
                    job.attempts <- job.attempts + 1
                    job.state <- NetworkRequestState.Resolving
                elif event == NetworkRequestEvent.DnsReady:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Resolving
                    job.state <- NetworkRequestState.Connecting
                elif event == NetworkRequestEvent.ConnectReady:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Connecting
                    job.state <- NetworkRequestState.Securing
                elif event == NetworkRequestEvent.TlsReady:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Securing
                    job.state <- NetworkRequestState.Sending
                elif event == NetworkRequestEvent.SendComplete:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Sending
                    job.state <- NetworkRequestState.Receiving
                elif event == NetworkRequestEvent.ReceiveComplete:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Receiving
                    job.state <- NetworkRequestState.Completed
                elif event == NetworkRequestEvent.Fail:
                    raise NetworkContractError.InvalidRequestState if not network_request_state_is_active(job.state)
                    job.state <- NetworkRequestState.Failed
                elif event == NetworkRequestEvent.Cancel:
                    if job.state == NetworkRequestState.Planned:
                        job.state <- NetworkRequestState.Cancelled
                    else:
                        raise NetworkContractError.InvalidRequestState if not network_request_state_is_active(job.state)
                        job.state <- NetworkRequestState.Cancelling
                elif event == NetworkRequestEvent.CancelAck:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Cancelling
                    job.state <- NetworkRequestState.Cancelled
                elif event == NetworkRequestEvent.Retry:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Failed
                    raise NetworkContractError.RetryLimitExceeded if job.attempts >= job.max_attempts
                    job.state <- NetworkRequestState.Planned
                return job.state


            def validate_network_retry_policy(policy: NetworkRetryPolicy&, method: NetworkMethod) -> bool error[NetworkContractError]:
                raise NetworkContractError.InvalidRetryMode if not network_retry_mode_valid(policy.mode)
                raise NetworkContractError.InvalidRetryAttempts if policy.max_attempts == 0 or policy.max_attempts > NETWORK_MAX_RETRY_ATTEMPTS
                raise NetworkContractError.InvalidRetryBackoff if policy.initial_backoff_micros > NETWORK_MAX_BACKOFF_MICROS or policy.max_backoff_micros > NETWORK_MAX_BACKOFF_MICROS
                raise NetworkContractError.InvalidRetryBackoff if policy.initial_backoff_micros > policy.max_backoff_micros
                if policy.max_attempts == 1:
                    raise NetworkContractError.InvalidRetryBackoff if policy.initial_backoff_micros != 0 or policy.max_backoff_micros != 0
                else:
                    raise NetworkContractError.InvalidRetryBackoff if policy.initial_backoff_micros == 0 or policy.max_backoff_micros == 0
                if policy.mode == NetworkRetryMode.Never:
                    raise NetworkContractError.InvalidRetryAttempts if policy.max_attempts != 1
                elif policy.mode == NetworkRetryMode.IdempotentOnly:
                    raise NetworkContractError.NonIdempotentRetry if not network_method_is_idempotent(method) and policy.max_attempts > 1
                return true


            def validate_network_request(request: NetworkRequest&) -> bool error[NetworkContractError]:
                raise NetworkContractError.InvalidMethod if not network_method_valid(request.method)
                raise NetworkContractError.MissingUrl if request.url == ""
                raise NetworkContractError.UrlLimitExceeded if not network_text_length_valid(request.url, NETWORK_MAX_URL_BYTES)
                raise NetworkContractError.EmbeddedNul if sview_contains_byte(request.url, 0)
                raise NetworkContractError.HeaderVectorMalformed if not network_headers_valid(request.headers)
                raise NetworkContractError.BodyLimitExceeded if request.body.count > NETWORK_MAX_BODY_BYTES
                raise NetworkContractError.InvalidTimeout if request.timeout_micros == 0
                raise NetworkContractError.InvalidResponseLimit if request.max_response_bytes == 0 or request.max_response_bytes > NETWORK_MAX_BODY_BYTES
                try validate_network_retry_policy(request.retry, request.method)
                try validate_network_tls_policy(request.tls)
                return true


            def validate_network_response(response: NetworkResponse&) -> bool error[NetworkContractError]:
                raise NetworkContractError.InvalidOutcome if not network_outcome_valid(response.outcome)
                raise NetworkContractError.HeaderVectorMalformed if not network_headers_valid(response.headers)
                raise NetworkContractError.BodyLimitExceeded if response.body.count > NETWORK_MAX_BODY_BYTES
                raise NetworkContractError.ErrorTextInvalid if not network_text_valid(response.error_text, NETWORK_MAX_BODY_BYTES)
                if response.outcome in {NetworkOutcome.Success, NetworkOutcome.StatusFailure}:
                    raise NetworkContractError.InvalidStatus if response.status < 100 or response.status > 599
                else:
                    raise NetworkContractError.InvalidStatus if response.status != 0
                return true
