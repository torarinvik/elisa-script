# Typed, bounded network request/response contracts.
#
# This module is transport-neutral: it validates the data and policy that an
# HTTP/TLS adapter must honor without opening sockets or silently retrying a
# mutation. Headers remain ordered flat pairs so canonicalization is explicit.

module EsNetwork:
    public:
        const module Limits:
            URL_BYTES: usize = 16384
            HEADER_BYTES: usize = 1048576
            HEADER_COMPARISON_WORK: usize = 1048576
            SENSITIVE_HEADER_NAMES: usize = 128
            BODY_BYTES: usize = 67108864
            RETRY_ATTEMPTS: usize = 8
            BACKOFF_MICROS: u64 = 60000000
            TLS_PATH_BYTES: usize = 4096
            CHUNK_BYTES: usize = 1048576
            BUFFER_BYTES: usize = 16777216
            STREAM_CHUNKS: usize = 1048576


        const enum NetworkMethod of u8:
            Get
            Head
            Post
            Put
            Patch
            Delete


        const enum NetworkOutcome of u8:
            Success
            DnsFailure
            TlsFailure
            TransportFailure
            Timeout
            ProtocolFailure
            StatusFailure
            DecodeFailure
            Cancelled


        const enum NetworkRetryMode of u8:
            Never
            IdempotentOnly
            Explicit


        struct NetworkRetryPolicy:
            mode: NetworkRetryMode = NetworkRetryMode.Never
            max_attempts: usize = 1
            initial_backoff_micros: u64 = 0
            max_backoff_micros: u64 = 0


        const enum NetworkTlsVersion of u8:
            Tls12
            Tls13


        const enum NetworkTlsTrustMode of u8:
            System
            CustomBundle
            InsecureTestOnly


        struct NetworkTlsPolicy:
            version: NetworkTlsVersion = NetworkTlsVersion.Tls12
            trust_mode: NetworkTlsTrustMode = NetworkTlsTrustMode.System
            ca_bundle_path: sview = ""
            server_name: sview = ""
            client_certificate_path: sview = ""
            client_key_path: sview = ""


        const enum NetworkStreamDirection of u8:
            Request
            Response


        const enum NetworkStreamState of u8:
            Idle
            Open
            Paused
            Finished
            Failed
            Cancelling
            Cancelled


        const enum NetworkStreamEvent of u8:
            Open
            Pause
            Resume
            Finish
            Fail
            Cancel
            CancelAck


        struct NetworkChunk:
            sequence: usize
            bytes: darray[u8] = []
            final_chunk: bool = false


        struct NetworkStream:
            direction: NetworkStreamDirection
            state: NetworkStreamState = NetworkStreamState.Idle
            next_sequence: usize = 0
            buffered_bytes: usize = 0
            max_buffer_bytes: usize = Limits::BUFFER_BYTES
            final_seen: bool = false


        const enum NetworkRequestState of u8:
            Planned
            Resolving
            Connecting
            Securing
            Sending
            Receiving
            Completed
            Failed
            Cancelling
            Cancelled


        const enum NetworkRequestEvent of u8:
            Begin
            DnsReady
            ConnectReady
            TlsReady
            SendComplete
            ReceiveComplete
            Fail
            Cancel
            CancelAck
            Retry


        struct NetworkRequestJob:
            state: NetworkRequestState = NetworkRequestState.Planned
            attempts: usize = 0
            max_attempts: usize = 1


        struct NetworkRequest:
            url: sview
            method: NetworkMethod = NetworkMethod.Get
            headers: darray[sview] = []
            sensitive_headers: darray[sview] = []
            body: darray[u8] = []
            timeout_micros: u64 = 0
            max_response_bytes: usize = Limits::BODY_BYTES
            follow_redirects: bool = false
            retry: NetworkRetryPolicy = NetworkRetryPolicy{}
            tls: NetworkTlsPolicy = NetworkTlsPolicy{}


        struct NetworkResponse:
            outcome: NetworkOutcome = NetworkOutcome.Success
            status: u16 = 200
            headers: darray[sview] = []
            body: darray[u8] = []
            error_text: sview = ""


        error NetworkContractError:
            InvalidMethod
            InvalidOutcome
            MissingUrl
            InvalidUrl
            EmbeddedNul
            UrlLimitExceeded
            HeaderVectorMalformed
            HeaderNameInvalid
            HeaderValueInvalid
            DuplicateHeaderName
            HeaderComparisonLimitExceeded
            SensitiveHeaderLimitExceeded
            SensitiveHeaderNameInvalid
            DuplicateSensitiveHeaderName
            HeaderLimitExceeded
            InvalidRedirectLocation
            RedirectTargetLimitExceeded
            BodyLimitExceeded
            EffectiveBodyLimitExceeded
            InvalidTimeout
            InvalidResponseLimit
            InvalidRetryMode
            InvalidRetryAttempts
            InvalidRetryBackoff
            NonIdempotentRetry
            InvalidTlsVersion
            InvalidTlsTrustMode
            InvalidTlsBundle
            InvalidTlsClientIdentity
            TlsPathLimitExceeded
            TlsPathEmbeddedNul
            InvalidStreamDirection
            InvalidStreamState
            InvalidStreamEvent
            InvalidChunk
            ChunkLimitExceeded
            ChunkSequenceMismatch
            StreamBufferExceeded
            StreamNotComplete
            StreamNotDrained
            StreamAccountingInvalid
            InvalidRequestState
            InvalidRequestEvent
            RetryLimitExceeded
            InvalidStatus
            ErrorTextInvalid


    private:
        def network_method_valid(method: NetworkMethod) -> bool:
            return method in {NetworkMethod.Get, NetworkMethod.Head, NetworkMethod.Post, NetworkMethod.Put, NetworkMethod.Patch, NetworkMethod.Delete}


        def network_outcome_valid(outcome: NetworkOutcome) -> bool:
            return outcome in {NetworkOutcome.Success, NetworkOutcome.DnsFailure, NetworkOutcome.TlsFailure, NetworkOutcome.TransportFailure, NetworkOutcome.Timeout, NetworkOutcome.ProtocolFailure, NetworkOutcome.StatusFailure, NetworkOutcome.DecodeFailure, NetworkOutcome.Cancelled}


        def network_retry_mode_valid(mode: NetworkRetryMode) -> bool:
            return mode in {NetworkRetryMode.Never, NetworkRetryMode.IdempotentOnly, NetworkRetryMode.Explicit}


        def network_tls_version_valid(version: NetworkTlsVersion) -> bool:
            return version in {NetworkTlsVersion.Tls12, NetworkTlsVersion.Tls13}


        def network_tls_trust_mode_valid(mode: NetworkTlsTrustMode) -> bool:
            return mode in {NetworkTlsTrustMode.System, NetworkTlsTrustMode.CustomBundle, NetworkTlsTrustMode.InsecureTestOnly}


        def network_tls_path_valid(value: sview) -> bool:
            return value == "" or (sview_len(value) < Limits::TLS_PATH_BYTES and not sview_contains_byte(value, 0))


        def network_url_prefix_matches(url: sview, prefix: sview) -> bool:
            return false if sview_len(url) < sview_len(prefix)
            for index in 0..<sview_len(prefix) |url, prefix|:
                url_byte: u8 = sview_at(url, index)
                prefix_byte: u8 = sview_at(prefix, index)
                url_lower: u8 = url_byte + 32u8 if url_byte >= 65u8 and url_byte <= 90u8 else url_byte
                prefix_lower: u8 = prefix_byte + 32u8 if prefix_byte >= 65u8 and prefix_byte <= 90u8 else prefix_byte
                return false if url_lower != prefix_lower
            return true


        def network_url_scheme_is_tls(url: sview) -> bool:
            return network_url_prefix_matches(url, "https://")


        def network_url_authority_start(url: sview) -> usize:
            return 8 if network_url_scheme_is_tls(url) else 7


        def network_url_authority_end(url: sview, start: usize) -> usize:
            authority_end: mutable usize = sview_len(url)
            for index in start..<sview_len(url) |url, authority_end|:
                byte: u8 = sview_at(url, index)
                authority_end <- index if (byte == 47u8 or byte == 63u8 or byte == 35u8) and authority_end == sview_len(url)
            return authority_end


        def network_url_valid(url: sview) -> bool:
            is_http: bool = network_url_prefix_matches(url, "http://")
            is_https: bool = network_url_prefix_matches(url, "https://")
            return false if not is_http and not is_https
            authority_start: usize = network_url_authority_start(url)
            return false if authority_start >= sview_len(url)
            authority_end: usize = network_url_authority_end(url, authority_start)
            return false if authority_end == authority_start
            return false if sview_at(url, authority_start) == 58u8 or sview_at(url, authority_start) == 64u8
            for index in authority_start..<authority_end |url|:
                return false if sview_at(url, index) == 64u8
            for index in 0..<sview_len(url) |url|:
                byte: u8 = sview_at(url, index)
                return false if byte <= 32u8 or byte == 127u8 or byte == 92u8
            return true


        def network_stream_direction_valid(direction: NetworkStreamDirection) -> bool:
            return direction in {NetworkStreamDirection.Request, NetworkStreamDirection.Response}


        def network_stream_state_valid(state: NetworkStreamState) -> bool:
            return state in {NetworkStreamState.Idle, NetworkStreamState.Open, NetworkStreamState.Paused, NetworkStreamState.Finished, NetworkStreamState.Failed, NetworkStreamState.Cancelling, NetworkStreamState.Cancelled}


        def network_stream_event_valid(event: NetworkStreamEvent) -> bool:
            return event in {NetworkStreamEvent.Open, NetworkStreamEvent.Pause, NetworkStreamEvent.Resume, NetworkStreamEvent.Finish, NetworkStreamEvent.Fail, NetworkStreamEvent.Cancel, NetworkStreamEvent.CancelAck}


        def network_stream_active(state: NetworkStreamState) -> bool:
            return state == NetworkStreamState.Open or state == NetworkStreamState.Paused


        def network_method_is_idempotent(method: NetworkMethod) -> bool:
            return method in {NetworkMethod.Get, NetworkMethod.Head, NetworkMethod.Put, NetworkMethod.Delete}


        def network_request_state_valid(state: NetworkRequestState) -> bool:
            return state in {NetworkRequestState.Planned, NetworkRequestState.Resolving, NetworkRequestState.Connecting, NetworkRequestState.Securing, NetworkRequestState.Sending, NetworkRequestState.Receiving, NetworkRequestState.Completed, NetworkRequestState.Failed, NetworkRequestState.Cancelling, NetworkRequestState.Cancelled}


        def network_request_event_valid(event: NetworkRequestEvent) -> bool:
            return event in {NetworkRequestEvent.Begin, NetworkRequestEvent.DnsReady, NetworkRequestEvent.ConnectReady, NetworkRequestEvent.TlsReady, NetworkRequestEvent.SendComplete, NetworkRequestEvent.ReceiveComplete, NetworkRequestEvent.Fail, NetworkRequestEvent.Cancel, NetworkRequestEvent.CancelAck, NetworkRequestEvent.Retry}


        def network_request_state_is_active(state: NetworkRequestState) -> bool:
            return state in {NetworkRequestState.Resolving, NetworkRequestState.Connecting, NetworkRequestState.Securing, NetworkRequestState.Sending, NetworkRequestState.Receiving}


        def network_request_state_requires_attempt(state: NetworkRequestState) -> bool:
            return state in {NetworkRequestState.Resolving, NetworkRequestState.Connecting, NetworkRequestState.Securing, NetworkRequestState.Sending, NetworkRequestState.Receiving, NetworkRequestState.Completed, NetworkRequestState.Failed, NetworkRequestState.Cancelling}


        def network_text_length_valid(value: sview, limit: usize) -> bool:
            return sview_len(value) < limit


        def network_text_valid(value: sview, limit: usize) -> bool:
            return network_text_length_valid(value, limit) and not sview_contains_byte(value, 0)


        def network_header_name_byte_valid(byte: u8) -> bool:
            return false if byte <= 32u8 or byte >= 127u8
            return false if byte == 34u8 or byte == 40u8 or byte == 41u8 or byte == 44u8 or byte == 47u8 or byte == 58u8 or byte == 59u8 or byte == 60u8 or byte == 61u8 or byte == 62u8 or byte == 63u8 or byte == 64u8 or byte == 91u8 or byte == 92u8 or byte == 93u8 or byte == 123u8 or byte == 124u8 or byte == 125u8
            return true


        def network_header_name_valid(name: sview) -> bool:
            return false if sview_len(name) == 0 or not network_text_valid(name, Limits::HEADER_BYTES)
            for index in 0..<sview_len(name) |name|:
                return false if not network_header_name_byte_valid(sview_at(name, index))
            return true


        def network_header_value_valid(value: sview) -> bool:
            return false if not network_text_valid(value, Limits::HEADER_BYTES)
            for index in 0..<sview_len(value) |value|:
                byte: u8 = sview_at(value, index)
                return false if byte < 32u8 and byte != 9u8
                return false if byte == 127u8
            return true


        def network_header_name_byte_equal(left: u8, right: u8) -> bool:
            left_folded: u8 = left + 32u8 if left >= 65u8 and left <= 90u8 else left
            right_folded: u8 = right + 32u8 if right >= 65u8 and right <= 90u8 else right
            return left_folded == right_folded


        def network_header_names_equal(left: sview, right: sview) -> bool:
            return false if sview_len(left) != sview_len(right)
            equal: mutable bool = true
            for index in 0..<sview_len(left) |left, right, equal|:
                equal <- false if not network_header_name_byte_equal(sview_at(left, index), sview_at(right, index))
            return equal


        def network_header_comparison_matches(left: sview, right: sview, comparison_work: mutable usize&) -> bool error[NetworkContractError]:
            shared_name_bytes: usize = sview_len(left) if sview_len(left) < sview_len(right) else sview_len(right)
            comparison_cost: usize = shared_name_bytes + 1
            raise NetworkContractError.HeaderComparisonLimitExceeded if comparison_cost > Limits::HEADER_COMPARISON_WORK - comparison_work
            comparison_work <- comparison_work + comparison_cost
            return network_header_names_equal(left, right)


        def network_headers_valid(headers: darray[sview], reject_duplicate_names: bool) -> bool error[NetworkContractError]:
            raise NetworkContractError.HeaderVectorMalformed if headers.count % 2 != 0
            total: mutable usize = 0
            comparison_work: mutable usize = 0
            for offset in 0..<headers.count |headers, total, comparison_work|:
                entry: sview = headers[offset]
                raise NetworkContractError.HeaderLimitExceeded if not network_text_length_valid(entry, Limits::HEADER_BYTES)
                raise NetworkContractError.EmbeddedNul if sview_contains_byte(entry, 0)
                if offset % 2 == 0:
                    raise NetworkContractError.HeaderNameInvalid if not network_header_name_valid(entry)
                    if reject_duplicate_names:
                        for earlier in 0..<offset |headers, entry, comparison_work|:
                            if earlier % 2 == 0:
                                previous_name: sview = headers[earlier]
                                duplicate: bool = try network_header_comparison_matches(previous_name, entry, comparison_work)
                                raise NetworkContractError.DuplicateHeaderName if duplicate
                else:
                    raise NetworkContractError.HeaderValueInvalid if not network_header_value_valid(entry)
                raise NetworkContractError.HeaderLimitExceeded if total > Limits::HEADER_BYTES - sview_len(entry) - 1
                total <- total + sview_len(entry) + 1
            return true


        def network_sensitive_header_names_valid(names: darray[sview]) -> bool error[NetworkContractError]:
            raise NetworkContractError.SensitiveHeaderLimitExceeded if names.count > Limits::SENSITIVE_HEADER_NAMES
            total: mutable usize = 0
            comparison_work: mutable usize = 0
            for index in 0..<names.count |names, comparison_work|:
                raise NetworkContractError.SensitiveHeaderNameInvalid if not network_header_name_valid(names[index])
                for earlier in 0..<index |names, index, comparison_work|:
                    previous_name: sview = names[earlier]
                    duplicate: bool = try network_header_comparison_matches(previous_name, names[index], comparison_work)
                    raise NetworkContractError.DuplicateSensitiveHeaderName if duplicate
                raise NetworkContractError.HeaderLimitExceeded if total > Limits::HEADER_BYTES - sview_len(names[index]) - 1
                total <- total + sview_len(names[index]) + 1
            return true


        def network_url_append_view(output: mutable darray[u8]&, value: sview) -> void error[NetworkContractError] can[Memory.Allocate, Abort.Panic]:
            raise NetworkContractError.RedirectTargetLimitExceeded if output.count >= Limits::URL_BYTES
            raise NetworkContractError.RedirectTargetLimitExceeded if sview_len(value) > Limits::URL_BYTES - 1 - output.count
            for byte in value |output|:
                output.push(byte)


        def network_url_append_slice(output: mutable darray[u8]&, value: sview, start: usize, end: usize) -> void error[NetworkContractError] can[Memory.Allocate, Abort.Panic]:
            raise NetworkContractError.InvalidRedirectLocation if start > end or end > sview_len(value)
            try network_url_append_view(output, string_view_slice(value, start.i64(), end.i64()))


        def network_url_reference_path_end(value: sview, start: usize) -> usize:
            end: mutable usize = sview_len(value)
            for index in start..<sview_len(value) |value, end|:
                byte: u8 = sview_at(value, index)
                end <- index if (byte == 63u8 or byte == 35u8) and end == sview_len(value)
            return end


        def network_url_fragment_start(value: sview, start: usize) -> usize:
            fragment: mutable usize = sview_len(value)
            for index in start..<sview_len(value) |value, fragment|:
                fragment <- index if sview_at(value, index) == 35u8 and fragment == sview_len(value)
            return fragment


        def network_url_append_normalized_path(output: mutable darray[u8]&, path: sview) -> void error[NetworkContractError] can[Memory.Allocate, Abort.Panic]:
            raise NetworkContractError.InvalidRedirectLocation if path == ""
            raise NetworkContractError.InvalidRedirectLocation if sview_at(path, 0) != 47u8
            segments: mutable darray[sview] = []
            segment_start: mutable usize = 1
            for index in 1..<sview_len(path) |path, segment_start, segments|:
                if sview_at(path, index) == 47u8:
                    segment: sview = string_view_slice(path, segment_start.i64(), index.i64())
                    if segment == "..":
                        if segments.count != 0:
                            _ = segments.pop()
                    elif segment != ".":
                        segments.push(segment)
                    segment_start <- index + 1
            final_segment: sview = string_view_slice(path, segment_start.i64(), sview_len(path).i64())
            if final_segment == "..":
                if segments.count != 0:
                    _ = segments.pop()
                segments.push("")
            elif final_segment == ".":
                segments.push("")
            else:
                segments.push(final_segment)
            try network_url_append_view(output, "/")
            for index in 0..<segments.count |segments, output|:
                if index != 0:
                    try network_url_append_view(output, "/")
                try network_url_append_view(output, segments[index])


        public:
            def validate_network_stream(stream: NetworkStream&) -> bool error[NetworkContractError]:
                raise NetworkContractError.InvalidStreamDirection if not network_stream_direction_valid(stream.direction)
                raise NetworkContractError.InvalidStreamState if not network_stream_state_valid(stream.state)
                raise NetworkContractError.StreamBufferExceeded if stream.max_buffer_bytes == 0 or stream.max_buffer_bytes > Limits::BUFFER_BYTES
                raise NetworkContractError.StreamBufferExceeded if stream.buffered_bytes > stream.max_buffer_bytes
                raise NetworkContractError.ChunkSequenceMismatch if stream.next_sequence > Limits::STREAM_CHUNKS
                raise NetworkContractError.StreamAccountingInvalid if stream.next_sequence == 0 and (stream.buffered_bytes != 0 or stream.final_seen)
                raise NetworkContractError.StreamAccountingInvalid if stream.state == NetworkStreamState.Idle and (stream.next_sequence != 0 or stream.buffered_bytes != 0 or stream.final_seen)
                raise NetworkContractError.StreamAccountingInvalid if stream.state == NetworkStreamState.Finished and (stream.next_sequence == 0 or not stream.final_seen or stream.buffered_bytes != 0)
                raise NetworkContractError.StreamAccountingInvalid if (stream.state == NetworkStreamState.Cancelling or stream.state == NetworkStreamState.Cancelled) and (stream.buffered_bytes != 0 or stream.final_seen)
                return true


            def advance_network_stream(stream: mutable NetworkStream&, event: NetworkStreamEvent) -> NetworkStreamState error[NetworkContractError]:
                try validate_network_stream(stream)
                raise NetworkContractError.InvalidStreamEvent if not network_stream_event_valid(event)
                if event == NetworkStreamEvent.Open:
                    raise NetworkContractError.InvalidStreamState if stream.state != NetworkStreamState.Idle
                    stream.state <- NetworkStreamState.Open
                elif event == NetworkStreamEvent.Pause:
                    raise NetworkContractError.InvalidStreamState if stream.state != NetworkStreamState.Open
                    stream.state <- NetworkStreamState.Paused
                elif event == NetworkStreamEvent.Resume:
                    raise NetworkContractError.InvalidStreamState if stream.state != NetworkStreamState.Paused
                    stream.state <- NetworkStreamState.Open
                elif event == NetworkStreamEvent.Finish:
                    raise NetworkContractError.InvalidStreamState if not network_stream_active(stream.state)
                    raise NetworkContractError.StreamNotComplete if not stream.final_seen
                    raise NetworkContractError.StreamNotDrained if stream.buffered_bytes != 0
                    stream.state <- NetworkStreamState.Finished
                elif event == NetworkStreamEvent.Fail:
                    raise NetworkContractError.InvalidStreamState if not network_stream_active(stream.state)
                    stream.state <- NetworkStreamState.Failed
                elif event == NetworkStreamEvent.Cancel:
                    if stream.state == NetworkStreamState.Idle:
                        stream.state <- NetworkStreamState.Cancelled
                    else:
                        raise NetworkContractError.InvalidStreamState if not network_stream_active(stream.state)
                        stream.buffered_bytes <- 0
                        stream.final_seen <- false
                        stream.state <- NetworkStreamState.Cancelling
                elif event == NetworkStreamEvent.CancelAck:
                    raise NetworkContractError.InvalidStreamState if stream.state != NetworkStreamState.Cancelling
                    stream.buffered_bytes <- 0
                    stream.final_seen <- false
                    stream.state <- NetworkStreamState.Cancelled
                return stream.state


            def enqueue_network_chunk(stream: mutable NetworkStream&, chunk: NetworkChunk&) -> bool error[NetworkContractError]:
                try validate_network_stream(stream)
                raise NetworkContractError.InvalidStreamState if stream.state != NetworkStreamState.Open
                raise NetworkContractError.InvalidChunk if chunk.bytes.count == 0 and not chunk.final_chunk
                raise NetworkContractError.ChunkLimitExceeded if chunk.bytes.count > Limits::CHUNK_BYTES
                raise NetworkContractError.ChunkSequenceMismatch if chunk.sequence != stream.next_sequence
                raise NetworkContractError.ChunkSequenceMismatch if stream.final_seen
                raise NetworkContractError.StreamBufferExceeded if chunk.bytes.count > stream.max_buffer_bytes - stream.buffered_bytes
                raise NetworkContractError.ChunkSequenceMismatch if stream.next_sequence >= Limits::STREAM_CHUNKS
                stream.buffered_bytes <- stream.buffered_bytes + chunk.bytes.count
                stream.next_sequence <- stream.next_sequence + 1
                stream.final_seen <- chunk.final_chunk if chunk.final_chunk
                return true


            def consume_network_stream(stream: mutable NetworkStream&, amount: usize) -> usize error[NetworkContractError]:
                try validate_network_stream(stream)
                raise NetworkContractError.StreamBufferExceeded if amount > stream.buffered_bytes
                stream.buffered_bytes <- stream.buffered_bytes - amount
                return amount


            def validate_network_tls_policy(policy: NetworkTlsPolicy&) -> bool error[NetworkContractError]:
                raise NetworkContractError.InvalidTlsVersion if not network_tls_version_valid(policy.version)
                raise NetworkContractError.InvalidTlsTrustMode if not network_tls_trust_mode_valid(policy.trust_mode)
                raise NetworkContractError.TlsPathEmbeddedNul if sview_contains_byte(policy.ca_bundle_path, 0) or sview_contains_byte(policy.server_name, 0) or sview_contains_byte(policy.client_certificate_path, 0) or sview_contains_byte(policy.client_key_path, 0)
                raise NetworkContractError.TlsPathLimitExceeded if not network_tls_path_valid(policy.ca_bundle_path) or not network_tls_path_valid(policy.server_name) or not network_tls_path_valid(policy.client_certificate_path) or not network_tls_path_valid(policy.client_key_path)
                if policy.trust_mode == NetworkTlsTrustMode.CustomBundle:
                    raise NetworkContractError.InvalidTlsBundle if policy.ca_bundle_path == ""
                else:
                    raise NetworkContractError.InvalidTlsBundle if policy.ca_bundle_path != ""
                raise NetworkContractError.InvalidTlsClientIdentity if (policy.client_certificate_path == "") != (policy.client_key_path == "")
                return true


            def advance_network_request(job: mutable NetworkRequestJob&, event: NetworkRequestEvent) -> NetworkRequestState error[NetworkContractError]:
                raise NetworkContractError.InvalidRequestState if not network_request_state_valid(job.state)
                raise NetworkContractError.InvalidRequestEvent if not network_request_event_valid(event)
                raise NetworkContractError.InvalidRetryAttempts if job.max_attempts == 0 or job.max_attempts > Limits::RETRY_ATTEMPTS
                raise NetworkContractError.RetryLimitExceeded if job.attempts > job.max_attempts
                raise NetworkContractError.InvalidRequestState if network_request_state_requires_attempt(job.state) and job.attempts == 0
                raise NetworkContractError.RetryLimitExceeded if job.state == NetworkRequestState.Planned and job.attempts >= job.max_attempts
                if event == NetworkRequestEvent.Begin:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Planned
                    raise NetworkContractError.RetryLimitExceeded if job.attempts >= job.max_attempts
                    job.attempts <- job.attempts + 1
                    job.state <- NetworkRequestState.Resolving
                elif event == NetworkRequestEvent.DnsReady:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Resolving
                    job.state <- NetworkRequestState.Connecting
                elif event == NetworkRequestEvent.ConnectReady:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Connecting
                    job.state <- NetworkRequestState.Securing
                elif event == NetworkRequestEvent.TlsReady:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Securing
                    job.state <- NetworkRequestState.Sending
                elif event == NetworkRequestEvent.SendComplete:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Sending
                    job.state <- NetworkRequestState.Receiving
                elif event == NetworkRequestEvent.ReceiveComplete:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Receiving
                    job.state <- NetworkRequestState.Completed
                elif event == NetworkRequestEvent.Fail:
                    raise NetworkContractError.InvalidRequestState if not network_request_state_is_active(job.state)
                    job.state <- NetworkRequestState.Failed
                elif event == NetworkRequestEvent.Cancel:
                    if job.state == NetworkRequestState.Planned:
                        job.state <- NetworkRequestState.Cancelled
                    else:
                        raise NetworkContractError.InvalidRequestState if not network_request_state_is_active(job.state)
                        job.state <- NetworkRequestState.Cancelling
                elif event == NetworkRequestEvent.CancelAck:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Cancelling
                    job.state <- NetworkRequestState.Cancelled
                elif event == NetworkRequestEvent.Retry:
                    raise NetworkContractError.InvalidRequestState if job.state != NetworkRequestState.Failed
                    raise NetworkContractError.RetryLimitExceeded if job.attempts >= job.max_attempts
                    job.state <- NetworkRequestState.Planned
                return job.state


            def validate_network_retry_policy(policy: NetworkRetryPolicy&, method: NetworkMethod) -> bool error[NetworkContractError]:
                raise NetworkContractError.InvalidRetryMode if not network_retry_mode_valid(policy.mode)
                raise NetworkContractError.InvalidRetryAttempts if policy.max_attempts == 0 or policy.max_attempts > Limits::RETRY_ATTEMPTS
                raise NetworkContractError.InvalidRetryBackoff if policy.initial_backoff_micros > Limits::BACKOFF_MICROS or policy.max_backoff_micros > Limits::BACKOFF_MICROS
                raise NetworkContractError.InvalidRetryBackoff if policy.initial_backoff_micros > policy.max_backoff_micros
                if policy.max_attempts == 1:
                    raise NetworkContractError.InvalidRetryBackoff if policy.initial_backoff_micros != 0 or policy.max_backoff_micros != 0
                else:
                    raise NetworkContractError.InvalidRetryBackoff if policy.initial_backoff_micros == 0 or policy.max_backoff_micros == 0
                if policy.mode == NetworkRetryMode.Never:
                    raise NetworkContractError.InvalidRetryAttempts if policy.max_attempts != 1
                elif policy.mode == NetworkRetryMode.IdempotentOnly:
                    raise NetworkContractError.NonIdempotentRetry if not network_method_is_idempotent(method) and policy.max_attempts > 1
                return true


            # Return the delay before a one-based attempt. Attempt one is the
            # initial dispatch and therefore has no retry delay. Later attempts
            # double the initial delay, saturating at the explicit ceiling.
            def network_retry_backoff_micros(policy: NetworkRetryPolicy&, method: NetworkMethod, attempt: usize) -> u64 error[NetworkContractError]:
                try validate_network_retry_policy(policy, method)
                raise NetworkContractError.InvalidRetryAttempts if attempt == 0 or attempt > policy.max_attempts
                return 0 if attempt == 1
                delay: mutable u64 = policy.initial_backoff_micros
                ordinal: mutable usize = 2
                while ordinal < attempt:
                    delay <- policy.max_backoff_micros if delay > policy.max_backoff_micros / 2 else delay * 2
                    ordinal <- ordinal + 1
                return delay


            def network_url_uses_tls(url: sview) -> bool error[NetworkContractError]:
                raise NetworkContractError.MissingUrl if url == ""
                raise NetworkContractError.UrlLimitExceeded if not network_text_length_valid(url, Limits::URL_BYTES)
                raise NetworkContractError.EmbeddedNul if sview_contains_byte(url, 0)
                raise NetworkContractError.InvalidUrl if not network_url_valid(url)
                return network_url_scheme_is_tls(url)


            # Resolve a Location reference into owned absolute URL bytes. The
            # caller must retain the returned buffer while a session borrows
            # `bytes_view(buffer)` as its current URL.
            def network_resolve_redirect_location(base_url: sview, location: sview) -> darray[u8] error[NetworkContractError] can[Memory.Allocate, Abort.Panic]:
                base_uses_tls: bool = try network_url_uses_tls(base_url)
                raise NetworkContractError.RedirectTargetLimitExceeded if sview_len(location) >= Limits::URL_BYTES
                raise NetworkContractError.EmbeddedNul if sview_contains_byte(location, 0)
                for index in 0..<sview_len(location) |location|:
                    byte: u8 = sview_at(location, index)
                    raise NetworkContractError.InvalidRedirectLocation if byte <= 32u8 or byte == 127u8 or byte == 92u8

                is_absolute_http: bool = network_url_prefix_matches(location, "http://")
                is_absolute_https: bool = network_url_prefix_matches(location, "https://")
                if is_absolute_http or is_absolute_https:
                    _ = try network_url_uses_tls(location)
                    absolute: mutable darray[u8] = []
                    try network_url_append_view(absolute, location)
                    return absolute

                location_path_end: usize = network_url_reference_path_end(location, 0)
                first_segment_end: mutable usize = sview_len(location)
                for index in 0..<sview_len(location) |location, first_segment_end|:
                    byte: u8 = sview_at(location, index)
                    first_segment_end <- index if (byte == 47u8 or byte == 63u8 or byte == 35u8) and first_segment_end == sview_len(location)
                for index in 0..<first_segment_end |location|:
                    raise NetworkContractError.InvalidRedirectLocation if sview_at(location, index) == 58u8

                if sview_len(location) >= 2 and sview_at(location, 0) == 47u8 and sview_at(location, 1) == 47u8:
                    scheme_end: usize = 6 if base_uses_tls else 5
                    network_path: mutable darray[u8] = []
                    try network_url_append_slice(network_path, base_url, 0, scheme_end)
                    try network_url_append_view(network_path, location)
                    _ = try network_url_uses_tls(bytes_view(network_path))
                    return network_path

                base_authority_start: usize = network_url_authority_start(base_url)
                base_authority_end: usize = network_url_authority_end(base_url, base_authority_start)
                base_path_end: usize = network_url_reference_path_end(base_url, base_authority_end)
                if location_path_end == 0:
                    suffix_base_end: mutable usize = network_url_fragment_start(base_url, base_path_end)
                    if sview_len(location) != 0:
                        if sview_at(location, 0) == 63u8:
                            suffix_base_end <- base_path_end
                    suffix_url: mutable darray[u8] = []
                    try network_url_append_slice(suffix_url, base_url, 0, suffix_base_end)
                    try network_url_append_view(suffix_url, location)
                    _ = try network_url_uses_tls(bytes_view(suffix_url))
                    return suffix_url

                merged_path: mutable darray[u8] = []
                if sview_at(location, 0) == 47u8:
                    try network_url_append_slice(merged_path, location, 0, location_path_end)
                else:
                    if base_authority_end == base_path_end:
                        try network_url_append_view(merged_path, "/")
                    else:
                        directory_end: mutable usize = base_authority_end
                        for index in base_authority_end..<base_path_end |base_url, directory_end|:
                            directory_end <- index + 1 if sview_at(base_url, index) == 47u8
                        try network_url_append_slice(merged_path, base_url, base_authority_end, directory_end)
                    try network_url_append_slice(merged_path, location, 0, location_path_end)

                resolved: mutable darray[u8] = []
                try network_url_append_slice(resolved, base_url, 0, base_authority_end)
                try network_url_append_normalized_path(resolved, bytes_view(merged_path))
                try network_url_append_slice(resolved, location, location_path_end, sview_len(location))
                _ = try network_url_uses_tls(bytes_view(resolved))
                return resolved


            # Authority comparison is intentionally conservative: it folds
            # ASCII case but does not equate an omitted port with an explicit
            # default port. False negatives only strip credentials more often.
            def network_url_same_origin(left: sview, right: sview) -> bool error[NetworkContractError]:
                left_uses_tls: bool = try network_url_uses_tls(left)
                right_uses_tls: bool = try network_url_uses_tls(right)
                return false if left_uses_tls != right_uses_tls
                left_start: usize = network_url_authority_start(left)
                right_start: usize = network_url_authority_start(right)
                left_end: usize = network_url_authority_end(left, left_start)
                right_end: usize = network_url_authority_end(right, right_start)
                return false if left_end - left_start != right_end - right_start
                equal: mutable bool = true
                for offset in 0..<(left_end - left_start) |left, right, equal|:
                    equal <- false if not network_header_name_byte_equal(sview_at(left, left_start + offset), sview_at(right, right_start + offset))
                return equal


            def network_request_header_is_sensitive(name: sview, request: NetworkRequest&) -> bool error[NetworkContractError]:
                raise NetworkContractError.HeaderNameInvalid if not network_header_name_valid(name)
                try network_sensitive_header_names_valid(request.sensitive_headers)
                comparison_work: mutable usize = 0
                sensitive: mutable bool = false
                match: mutable bool = try network_header_comparison_matches(name, "authorization", comparison_work)
                sensitive <- true if match
                if not sensitive:
                    match <- try network_header_comparison_matches(name, "proxy-authorization", comparison_work)
                    sensitive <- true if match
                if not sensitive:
                    match <- try network_header_comparison_matches(name, "cookie", comparison_work)
                    sensitive <- true if match
                if not sensitive:
                    match <- try network_header_comparison_matches(name, "cookie2", comparison_work)
                    sensitive <- true if match
                for index in 0..<request.sensitive_headers.count |request, sensitive, comparison_work, match|:
                    if not sensitive:
                        match <- try network_header_comparison_matches(name, request.sensitive_headers[index], comparison_work)
                        sensitive <- true if match
                return sensitive


            def validate_network_request(request: NetworkRequest&) -> bool error[NetworkContractError]:
                raise NetworkContractError.InvalidMethod if not network_method_valid(request.method)
                _ = try network_url_uses_tls(request.url)
                raise NetworkContractError.HeaderVectorMalformed if not network_headers_valid(request.headers, true)
                try network_sensitive_header_names_valid(request.sensitive_headers)
                raise NetworkContractError.BodyLimitExceeded if request.body.count > Limits::BODY_BYTES
                raise NetworkContractError.InvalidTimeout if request.timeout_micros == 0
                raise NetworkContractError.InvalidResponseLimit if request.max_response_bytes == 0 or request.max_response_bytes > Limits::BODY_BYTES
                try validate_network_retry_policy(request.retry, request.method)
                try validate_network_tls_policy(request.tls)
                return true


            # Return an ordered pair-vector copy for the effective method/body.
            # Text views still borrow from request storage. Redirects drop stale
            # Host fields; body rewrites drop framing and cross-origin hops
            # omit standard/application-declared credentials.
            def network_request_effective_headers(request: NetworkRequest&, effective_method: NetworkMethod, effective_body_bytes: usize, after_redirect: bool, strip_sensitive_headers: bool) -> darray[sview] error[NetworkContractError] can[Memory.Allocate, Abort.Panic]:
                try validate_network_request(request)
                raise NetworkContractError.InvalidMethod if not network_method_valid(effective_method)
                raise NetworkContractError.EffectiveBodyLimitExceeded if effective_body_bytes != request.body.count and effective_body_bytes != 0
                raise NetworkContractError.EffectiveBodyLimitExceeded if effective_method != request.method and (effective_method != NetworkMethod.Get or effective_body_bytes != 0)
                raise NetworkContractError.EffectiveBodyLimitExceeded if effective_method == request.method and effective_body_bytes != request.body.count
                body_rewritten: bool = effective_method != request.method or effective_body_bytes != request.body.count
                comparison_work: mutable usize = 0
                effective_headers: mutable darray[sview] = []
                for offset in 0..<request.headers.count |request, effective_headers, comparison_work|:
                    if offset % 2 == 0:
                        name: sview = request.headers[offset]
                        omit_header: mutable bool = false
                        match: mutable bool = false
                        if after_redirect:
                            match <- try network_header_comparison_matches(name, "host", comparison_work)
                            omit_header <- true if match
                        if body_rewritten:
                            if not omit_header:
                                match <- try network_header_comparison_matches(name, "content-length", comparison_work)
                                omit_header <- true if match
                            if not omit_header:
                                match <- try network_header_comparison_matches(name, "transfer-encoding", comparison_work)
                                omit_header <- true if match
                            if not omit_header:
                                match <- try network_header_comparison_matches(name, "trailer", comparison_work)
                                omit_header <- true if match
                        if strip_sensitive_headers and not omit_header:
                            sensitive: mutable bool = false
                            match <- try network_header_comparison_matches(name, "authorization", comparison_work)
                            sensitive <- true if match
                            if not sensitive:
                                match <- try network_header_comparison_matches(name, "proxy-authorization", comparison_work)
                                sensitive <- true if match
                            if not sensitive:
                                match <- try network_header_comparison_matches(name, "cookie", comparison_work)
                                sensitive <- true if match
                            if not sensitive:
                                match <- try network_header_comparison_matches(name, "cookie2", comparison_work)
                                sensitive <- true if match
                            for index in 0..<request.sensitive_headers.count |request, name, sensitive, comparison_work, match|:
                                if not sensitive:
                                    match <- try network_header_comparison_matches(name, request.sensitive_headers[index], comparison_work)
                                    sensitive <- true if match
                            omit_header <- sensitive
                        if not omit_header:
                            effective_headers.push(name)
                            effective_headers.push(request.headers[offset + 1])
                return effective_headers


            def validate_network_response(response: NetworkResponse&) -> bool error[NetworkContractError]:
                raise NetworkContractError.InvalidOutcome if not network_outcome_valid(response.outcome)
                # Responses may legally contain repeated field lines such as
                # Set-Cookie; preserve their order for field-specific handling.
                raise NetworkContractError.HeaderVectorMalformed if not network_headers_valid(response.headers, false)
                raise NetworkContractError.BodyLimitExceeded if response.body.count > Limits::BODY_BYTES
                raise NetworkContractError.ErrorTextInvalid if not network_text_valid(response.error_text, Limits::BODY_BYTES)
                if response.outcome == NetworkOutcome.Success:
                    raise NetworkContractError.InvalidStatus if response.status < 200 or response.status > 399
                elif response.outcome == NetworkOutcome.StatusFailure:
                    raise NetworkContractError.InvalidStatus if response.status < 100 or response.status > 599 or response.status >= 200 and response.status <= 399
                else:
                    raise NetworkContractError.InvalidStatus if response.status != 0
                return true
