# Bounded CMake-style target usage-requirement propagation.
#
# This is a pure model: a host supplies an ordered target graph, then uses the
# resolved compile/link requirements when constructing explicit ProcessCommand
# argv. It does not parse CMake or perform filesystem/process effects.

module EsBuildUsage:
    public:
        const module Limits:
            TARGETS: usize = 4096
            REQUIREMENTS_PER_TARGET: usize = 4096
            DEPENDENCIES_PER_TARGET: usize = 4096
            TOTAL_INPUTS: usize = 1048576
            TOTAL_RESOLVED_ENTRIES: usize = 1048576
            NAME_BYTES: usize = 4096
            VALUE_BYTES: usize = 65536


        const enum BuildUsageTargetKind of u8:
            Executable
            StaticLibrary
            SharedLibrary
            InterfaceLibrary


        const enum BuildUsageKind of u8:
            IncludeDirectory
            CompileDefinition
            CompileOption
            LinkLibrary
            LinkOption


        const enum BuildUsageVisibility of u8:
            Private
            Public
            Interface


        # Describes how one non-target LinkLibrary value becomes argv: a
        # search name receives `-l`, while Path and LinkerArgument are literal.
        const enum BuildUsageLibraryForm of u8:
            SearchName
            Path
            LinkerArgument


        struct BuildUsageRequirement:
            kind: BuildUsageKind
            visibility: BuildUsageVisibility
            value: sview
            library_form: BuildUsageLibraryForm = BuildUsageLibraryForm.SearchName


        struct BuildUsageDependency:
            target_index: usize
            visibility: BuildUsageVisibility


        struct BuildUsageTarget:
            name: sview
            kind: BuildUsageTargetKind
            # Usage dependencies refer to earlier target indices; this is the
            # canonical, cycle-free graph form produced by build resolution.
            # Visibility controls local/exported usage; concrete library
            # targets also contribute their artifact to the link closure.
            dependencies: darray[BuildUsageDependency] = []
            requirements: darray[BuildUsageRequirement] = []


        struct BuildUsageEntry:
            kind: BuildUsageKind
            value: sview
            library_form: BuildUsageLibraryForm = BuildUsageLibraryForm.SearchName
            # Distinguishes a target artifact name from a literal linker name
            # such as `m`; spelling equality does not imply identity.
            target_artifact: bool = false
            # In exported_link, true means a PRIVATE dependency artifact of
            # a static library is carried downstream only; a local link
            # closure materializes it as an ordinary input, without the flag.
            link_only: bool = false


        struct BuildUsageTargetResult:
            name: sview
            compile: darray[BuildUsageEntry] = []
            link: darray[BuildUsageEntry] = []
            exported_compile: darray[BuildUsageEntry] = []
            exported_link: darray[BuildUsageEntry] = []


        struct BuildUsageResolution:
            targets: darray[BuildUsageTargetResult] = []
            resolved_entries: usize = 0


        error BuildUsageError:
            EmptyGraph
            TargetLimitExceeded
            RequirementLimitExceeded
            DependencyLimitExceeded
            TotalInputLimitExceeded
            TotalResolvedLimitExceeded
            InvalidTargetKind
            InvalidTargetName
            DuplicateTarget
            InvalidRequirementKind
            InvalidVisibility
            InvalidRequirementValue
            InvalidLibraryForm
            InterfaceVisibilityRequired
            DependencyIndexInvalid
            DependencyOrderInvalid
            InvalidDependencyTargetKind
            DuplicateDependency


    private:
        const enum BuildUsageCollection of u8:
            Compile
            Link
            ExportedCompile
            ExportedLink


        struct BuildUsageEntryIndex:
            positions: mutable dict[sview, usize] = {}


        struct BuildUsageEntryIndices:
            maps: mutable darray[BuildUsageEntryIndex] = []
            map_lookup: mutable dict[u8, usize] = {}


        def target_kind_valid(kind: BuildUsageTargetKind) -> bool:
            return kind in {BuildUsageTargetKind.Executable, BuildUsageTargetKind.StaticLibrary, BuildUsageTargetKind.SharedLibrary, BuildUsageTargetKind.InterfaceLibrary}


        def usage_kind_valid(kind: BuildUsageKind) -> bool:
            return kind in {BuildUsageKind.IncludeDirectory, BuildUsageKind.CompileDefinition, BuildUsageKind.CompileOption, BuildUsageKind.LinkLibrary, BuildUsageKind.LinkOption}


        def visibility_valid(visibility: BuildUsageVisibility) -> bool:
            return visibility in {BuildUsageVisibility.Private, BuildUsageVisibility.Public, BuildUsageVisibility.Interface}


        def library_form_valid(form: BuildUsageLibraryForm) -> bool:
            return form in {BuildUsageLibraryForm.SearchName, BuildUsageLibraryForm.Path, BuildUsageLibraryForm.LinkerArgument}


        def library_form_matches_requirement(requirement: BuildUsageRequirement) -> bool:
            return requirement.library_form == BuildUsageLibraryForm.SearchName if requirement.kind != BuildUsageKind.LinkLibrary
            if requirement.library_form == BuildUsageLibraryForm.SearchName:
                return not sview_contains_byte(requirement.value, 47) and not sview_contains_byte(requirement.value, 92) and not sview_contains_byte(requirement.value, 32) and not sview_contains_byte(requirement.value, 9) and not sview_contains_byte(requirement.value, 10) and not sview_contains_byte(requirement.value, 13) and not requirement.value.startswith("-")
            if requirement.library_form == BuildUsageLibraryForm.Path:
                return true
            return requirement.value.startswith("-") if requirement.library_form == BuildUsageLibraryForm.LinkerArgument
            return false


        def usage_kind_is_compile(kind: BuildUsageKind) -> bool:
            return kind == BuildUsageKind.IncludeDirectory or kind == BuildUsageKind.CompileDefinition or kind == BuildUsageKind.CompileOption


        def usage_kind_is_link(kind: BuildUsageKind) -> bool:
            return kind == BuildUsageKind.LinkLibrary or kind == BuildUsageKind.LinkOption


        def append_usage_entry(entries: mutable darray[BuildUsageEntry]&, indices: mutable BuildUsageEntryIndices&, collection: BuildUsageCollection, candidate: BuildUsageEntry, resolved_count: mutable usize&) -> bool error[BuildUsageError] can[Memory.Allocate, Abort.Panic]:
            # The four output collections have independent deduplication
            # domains. Within each, the finite signature partitions keys by
            # the fields other than value; the dictionary then hashes and
            # compares the original borrowed value without constructing a
            # potentially large composite string key.
            entry_signature: usize = collection.u8().usize() * 30 + candidate.kind.u8().usize() * 6 + candidate.library_form.u8().usize() * 2 + (1 if candidate.target_artifact else 0)
            signature: u8 = entry_signature.u8()
            map_index: usize = indices.map_lookup.get(signature, indices.maps.count)
            if map_index == indices.maps.count:
                indices.maps.push(BuildUsageEntryIndex{})
                indices.map_lookup[signature] <- map_index
            existing_index: usize = indices.maps[map_index].positions.get(candidate.value, entries.count)
            if existing_index != entries.count:
                # A normal link requirement subsumes link-only propagation.
                entries[existing_index].link_only <- false if not candidate.link_only
                return false
            raise BuildUsageError.TotalResolvedLimitExceeded if entries.count >= Limits::TOTAL_RESOLVED_ENTRIES
            raise BuildUsageError.TotalResolvedLimitExceeded if resolved_count >= Limits::TOTAL_RESOLVED_ENTRIES
            indices.maps[map_index].positions[candidate.value] <- entries.count
            entries.push(candidate)
            resolved_count <- resolved_count + 1
            return true


        def validate_target_inputs(targets: darray[BuildUsageTarget]) -> bool error[BuildUsageError] can[Memory.Allocate, Abort.Panic]:
            raise BuildUsageError.EmptyGraph if targets.count == 0
            raise BuildUsageError.TargetLimitExceeded if targets.count > Limits::TARGETS
            total_inputs: mutable usize = 0
            target_names: mutable darray[sview] = []
            for index in 0..<targets.count |targets, total_inputs, target_names|:
                target: BuildUsageTarget = targets[index]
                raise BuildUsageError.InvalidTargetKind if not target_kind_valid(target.kind)
                raise BuildUsageError.InvalidTargetName if sview_len(target.name) == 0 or sview_len(target.name) > Limits::NAME_BYTES or sview_contains_byte(target.name, 0)
                target_names.push(target.name)
                raise BuildUsageError.RequirementLimitExceeded if target.requirements.count > Limits::REQUIREMENTS_PER_TARGET
                raise BuildUsageError.DependencyLimitExceeded if target.dependencies.count > Limits::DEPENDENCIES_PER_TARGET
                raise BuildUsageError.TotalInputLimitExceeded if target.requirements.count > Limits::TOTAL_INPUTS - total_inputs
                total_inputs <- total_inputs + target.requirements.count
                raise BuildUsageError.TotalInputLimitExceeded if target.dependencies.count > Limits::TOTAL_INPUTS - total_inputs
                total_inputs <- total_inputs + target.dependencies.count
                for requirement in target.requirements:
                    raise BuildUsageError.InvalidRequirementKind if not usage_kind_valid(requirement.kind)
                    raise BuildUsageError.InvalidVisibility if not visibility_valid(requirement.visibility)
                    raise BuildUsageError.InvalidRequirementValue if sview_len(requirement.value) == 0 or sview_len(requirement.value) > Limits::VALUE_BYTES or sview_contains_byte(requirement.value, 0)
                    raise BuildUsageError.InvalidLibraryForm if not library_form_valid(requirement.library_form) or not library_form_matches_requirement(requirement)
                    raise BuildUsageError.InterfaceVisibilityRequired if target.kind == BuildUsageTargetKind.InterfaceLibrary and requirement.visibility != BuildUsageVisibility.Interface
                dependency_indices: mutable darray[usize] = []
                for dependency_index in 0..<target.dependencies.count |target, dependency_indices|:
                    dependency: BuildUsageDependency = target.dependencies[dependency_index]
                    raise BuildUsageError.InvalidVisibility if not visibility_valid(dependency.visibility)
                    raise BuildUsageError.InterfaceVisibilityRequired if target.kind == BuildUsageTargetKind.InterfaceLibrary and dependency.visibility != BuildUsageVisibility.Interface
                    raise BuildUsageError.DependencyIndexInvalid if dependency.target_index >= targets.count
                    raise BuildUsageError.DependencyOrderInvalid if dependency.target_index >= index
                    # Executable-to-executable or library-to-executable link
                    # edges require CMake's ENABLE_EXPORTS contract, which is
                    # not modeled by this portable usage graph.
                    raise BuildUsageError.InvalidDependencyTargetKind if targets[dependency.target_index].kind == BuildUsageTargetKind.Executable
                    dependency_indices.push(dependency.target_index)
                ordered_dependencies: darray[usize] = sorted(dependency_indices)
                for ordered_index in 1..<ordered_dependencies.count |ordered_dependencies|:
                    raise BuildUsageError.DuplicateDependency if ordered_dependencies[ordered_index - 1] == ordered_dependencies[ordered_index]
            ordered_target_names: darray[sview] = sorted(target_names)
            for name_index in 1..<ordered_target_names.count |ordered_target_names|:
                raise BuildUsageError.DuplicateTarget if ordered_target_names[name_index - 1] == ordered_target_names[name_index]
            return true


    public:
        # Targets are given in dependency order. Compile/link arrays retain
        # first-seen target/requirement order, include concrete dependency
        # artifacts, and deduplicate exact kind/value pairs. Build-system-
        # specific generator expressions and configuration conditions are
        # intentionally outside this first portable contract.
        def resolve_build_usage(targets: darray[BuildUsageTarget]) -> BuildUsageResolution error[BuildUsageError] can[Memory.Allocate, Abort.Panic]:
            try validate_target_inputs(targets)
            results: mutable darray[BuildUsageTargetResult] = []
            resolved_count: mutable usize = 0
            for target_index in 0..<targets.count |targets, results, resolved_count|:
                target: BuildUsageTarget = targets[target_index]
                result: mutable BuildUsageTargetResult = BuildUsageTargetResult{name: target.name}
                indices: mutable BuildUsageEntryIndices = BuildUsageEntryIndices{}

                for requirement in target.requirements |target, result, indices, resolved_count|:
                    is_compile: bool = usage_kind_is_compile(requirement.kind)
                    is_link: bool = usage_kind_is_link(requirement.kind)
                    local: bool = requirement.visibility != BuildUsageVisibility.Interface and target.kind != BuildUsageTargetKind.InterfaceLibrary
                    exported: bool = requirement.visibility == BuildUsageVisibility.Public or requirement.visibility == BuildUsageVisibility.Interface
                    entry: BuildUsageEntry = BuildUsageEntry{kind: requirement.kind, value: requirement.value, library_form: requirement.library_form}
                    if is_compile and local:
                        _ = try append_usage_entry(result.compile, indices, BuildUsageCollection.Compile, entry, resolved_count)
                    if is_link and local:
                        _ = try append_usage_entry(result.link, indices, BuildUsageCollection.Link, entry, resolved_count)
                    if is_compile and exported:
                        _ = try append_usage_entry(result.exported_compile, indices, BuildUsageCollection.ExportedCompile, entry, resolved_count)
                    if is_link and exported:
                        _ = try append_usage_entry(result.exported_link, indices, BuildUsageCollection.ExportedLink, entry, resolved_count)
                    # CMake static libraries retain a PRIVATE link dependency
                    # in their link interface, marked here as link-only.
                    if is_link and requirement.kind == BuildUsageKind.LinkLibrary and requirement.visibility == BuildUsageVisibility.Private and target.kind == BuildUsageTargetKind.StaticLibrary:
                        _ = try append_usage_entry(result.exported_link, indices, BuildUsageCollection.ExportedLink, BuildUsageEntry{kind: requirement.kind, value: requirement.value, library_form: requirement.library_form, link_only: true}, resolved_count)

                for dependency in target.dependencies |target, results, result, indices, resolved_count|:
                    dependency_result: BuildUsageTargetResult = results[dependency.target_index]
                    dependency_target: BuildUsageTarget = targets[dependency.target_index]
                    local: bool = dependency.visibility != BuildUsageVisibility.Interface
                    exported: bool = dependency.visibility != BuildUsageVisibility.Private
                    for entry in dependency_result.exported_compile |indices, result, resolved_count|:
                        if local:
                            _ = try append_usage_entry(result.compile, indices, BuildUsageCollection.Compile, entry, resolved_count)
                        if exported:
                            _ = try append_usage_entry(result.exported_compile, indices, BuildUsageCollection.ExportedCompile, entry, resolved_count)
                    if dependency_target.kind == BuildUsageTargetKind.StaticLibrary or dependency_target.kind == BuildUsageTargetKind.SharedLibrary:
                        direct_library: BuildUsageEntry = BuildUsageEntry{kind: BuildUsageKind.LinkLibrary, value: dependency_result.name, target_artifact: true}
                        if local:
                            _ = try append_usage_entry(result.link, indices, BuildUsageCollection.Link, direct_library, resolved_count)
                        if exported:
                            _ = try append_usage_entry(result.exported_link, indices, BuildUsageCollection.ExportedLink, direct_library, resolved_count)
                        elif target.kind == BuildUsageTargetKind.StaticLibrary:
                            _ = try append_usage_entry(result.exported_link, indices, BuildUsageCollection.ExportedLink, BuildUsageEntry{kind: direct_library.kind, value: direct_library.value, target_artifact: true, link_only: true}, resolved_count)
                    for entry in dependency_result.exported_link |indices, result, resolved_count|:
                        if local:
                            # Link-only is an export modifier, not a limitation
                            # on the current target's own final link closure.
                            _ = try append_usage_entry(result.link, indices, BuildUsageCollection.Link, BuildUsageEntry{kind: entry.kind, value: entry.value, target_artifact: entry.target_artifact, library_form: entry.library_form}, resolved_count)
                        if exported:
                            _ = try append_usage_entry(result.exported_link, indices, BuildUsageCollection.ExportedLink, entry, resolved_count)
                        if not exported and target.kind == BuildUsageTargetKind.StaticLibrary:
                            _ = try append_usage_entry(result.exported_link, indices, BuildUsageCollection.ExportedLink, BuildUsageEntry{kind: entry.kind, value: entry.value, target_artifact: entry.target_artifact, library_form: entry.library_form, link_only: true}, resolved_count)

                results.push(result)
            return BuildUsageResolution{targets: results, resolved_entries: resolved_count}
