# Exact integer and decimal conversion shared by JSON and CSV schema adapters.
#
# Both parsers reuse the bounded record-numeric state machine with separators
# disabled. Integers retain a checked magnitude; decimals own coefficient
# digits and a signed scale without passing through a floating type.

module EsSchemaNumeric:
    using EsRecordNumeric
    using EsSchema

    public:
        const SCHEMA_INTEGER_MAX_BYTES: usize = RECORD_NUMERIC_MAX_BYTES
        const SCHEMA_DECIMAL_MAX_BYTES: usize = RECORD_NUMERIC_MAX_BYTES
        const SCHEMA_DECIMAL_MAX_DIGITS: usize = RECORD_NUMERIC_MAX_DIGITS
        const SCHEMA_DECIMAL_MAX_EXPONENT_DIGITS: usize = RECORD_NUMERIC_MAX_EXPONENT_DIGITS
        const SCHEMA_DECIMAL_MIN_SCALE: i64 = -9999
        const SCHEMA_DECIMAL_MAX_SCALE: i64 = 14095


        error SchemaIntegerError:
            InvalidTarget
            InputLimitExceeded
            MalformedInteger
            TargetOutOfRange
            NumericStateInvalid


        error SchemaDecimalError:
            InputLimitExceeded
            MalformedDecimal
            ScaleOutOfRange
            NumericStateInvalid


        const enum SchemaDecimalOrdering of u8:
            Less
            Equal
            Greater


    private:
        def schema_decimal_byte_is_digit(byte: u8) -> bool:
            return byte >= 48 and byte <= 57


        def schema_integer_target_is_signed(target: SchemaIntegerTarget) -> bool:
            return target == SchemaIntegerTarget.I8 or target == SchemaIntegerTarget.I16 or target == SchemaIntegerTarget.I32 or target == SchemaIntegerTarget.I64


        def schema_integer_target_limit(target: SchemaIntegerTarget, negative: bool) -> u64 error[SchemaIntegerError]:
            if target == SchemaIntegerTarget.I8:
                return 128 if negative else 127
            elif target == SchemaIntegerTarget.I16:
                return 32768 if negative else 32767
            elif target == SchemaIntegerTarget.I32:
                return 2147483648 if negative else 2147483647
            elif target == SchemaIntegerTarget.I64:
                return 9223372036854775808u64 if negative else 9223372036854775807u64
            elif target == SchemaIntegerTarget.U8:
                return 255
            elif target == SchemaIntegerTarget.U16:
                return 65535
            elif target == SchemaIntegerTarget.U32:
                return 4294967295
            elif target == SchemaIntegerTarget.U64:
                return 18446744073709551615u64
            raise SchemaIntegerError.InvalidTarget


        def schema_integer_advance(session: mutable RecordNumericSession&, event: RecordNumericEvent, byte: u8 = 0) -> void error[SchemaIntegerError]:
            catch advance_record_numeric(session, event, byte):
                ok state:
                    _ = state
                error failure:
                    raise SchemaIntegerError.TargetOutOfRange if failure == RecordNumericError.IntegerOverflow
                    raise SchemaIntegerError.InputLimitExceeded if failure == RecordNumericError.TextLimitExceeded or failure == RecordNumericError.DigitLimitExceeded
                    raise SchemaIntegerError.MalformedInteger


        def schema_integer_result(session: RecordNumericSession&) -> RecordNumericResult error[SchemaIntegerError]:
            result: mutable RecordNumericResult = RecordNumericResult{kind: session.policy.kind}
            catch record_numeric_result(session):
                ok value:
                    result <- value
                error failure:
                    _ = failure
                    raise SchemaIntegerError.NumericStateInvalid
            return result


        def schema_decimal_advance(session: mutable RecordNumericSession&, event: RecordNumericEvent, byte: u8 = 0) -> void error[SchemaDecimalError]:
            catch advance_record_numeric(session, event, byte):
                ok state:
                    _ = state
                error failure:
                    raise SchemaDecimalError.InputLimitExceeded if failure == RecordNumericError.TextLimitExceeded or failure == RecordNumericError.DigitLimitExceeded or failure == RecordNumericError.ExponentLimitExceeded
                    raise SchemaDecimalError.MalformedDecimal


        def schema_decimal_result(session: RecordNumericSession&) -> RecordNumericResult error[SchemaDecimalError]:
            result: mutable RecordNumericResult = RecordNumericResult{kind: session.policy.kind}
            catch record_numeric_result(session):
                ok value:
                    result <- value
                error failure:
                    _ = failure
                    raise SchemaDecimalError.NumericStateInvalid
            return result


    public:
        def schema_decimal_value_valid(value: SchemaDecimalValue) -> bool:
            return false if value.coefficient_digits.count == 0 or value.coefficient_digits.count > SCHEMA_DECIMAL_MAX_DIGITS
            return false if value.scale < SCHEMA_DECIMAL_MIN_SCALE or value.scale > SCHEMA_DECIMAL_MAX_SCALE
            for digit in value.coefficient_digits:
                return false if digit < 48 or digit > 57
            return true


        def schema_decimal_value_empty(value: SchemaDecimalValue) -> bool:
            return value.coefficient_digits.count == 0 and not value.negative and value.scale == 0


    private:
        def schema_decimal_first_nonzero(value: SchemaDecimalValue&) -> usize:
            index: mutable usize = 0
            while index < value.coefficient_digits.count:
                return index if value.coefficient_digits[index] != 48
                index <- index + 1
            return value.coefficient_digits.count


        def schema_decimal_compare_magnitude(left: SchemaDecimalValue&, right: SchemaDecimalValue&) -> SchemaDecimalOrdering:
            left_start: usize = schema_decimal_first_nonzero(left)
            right_start: usize = schema_decimal_first_nonzero(right)
            left_digits: usize = left.coefficient_digits.count - left_start
            right_digits: usize = right.coefficient_digits.count - right_start
            left_order: i64 = left_digits.i64() - left.scale
            right_order: i64 = right_digits.i64() - right.scale
            return SchemaDecimalOrdering.Less if left_order < right_order
            return SchemaDecimalOrdering.Greater if left_order > right_order

            compared_digits: usize = left_digits if left_digits > right_digits else right_digits
            offset: mutable usize = 0
            while offset < compared_digits:
                left_digit: u8 = 48 if offset >= left_digits else left.coefficient_digits[left_start + offset]
                right_digit: u8 = 48 if offset >= right_digits else right.coefficient_digits[right_start + offset]
                return SchemaDecimalOrdering.Less if left_digit < right_digit
                return SchemaDecimalOrdering.Greater if left_digit > right_digit
                offset <- offset + 1
            return SchemaDecimalOrdering.Equal


        def schema_decimal_invert_ordering(ordering: SchemaDecimalOrdering) -> SchemaDecimalOrdering:
            return SchemaDecimalOrdering.Greater if ordering == SchemaDecimalOrdering.Less
            return SchemaDecimalOrdering.Less if ordering == SchemaDecimalOrdering.Greater
            return SchemaDecimalOrdering.Equal


    public:
        # This compares mathematical values, not source representations:
        # 1.0 equals 1.00, and negative zero equals positive zero. The owned
        # digits, scale, trailing zeros, and zero sign remain unchanged.
        def compare_schema_decimal(left: SchemaDecimalValue&, right: SchemaDecimalValue&) -> SchemaDecimalOrdering error[SchemaDecimalError]:
            raise SchemaDecimalError.NumericStateInvalid if not schema_decimal_value_valid(left) or not schema_decimal_value_valid(right)
            left_start: usize = schema_decimal_first_nonzero(left)
            right_start: usize = schema_decimal_first_nonzero(right)
            left_is_zero: bool = left_start == left.coefficient_digits.count
            right_is_zero: bool = right_start == right.coefficient_digits.count
            return SchemaDecimalOrdering.Equal if left_is_zero and right_is_zero
            return SchemaDecimalOrdering.Greater if left_is_zero and right.negative
            return SchemaDecimalOrdering.Less if left_is_zero
            return SchemaDecimalOrdering.Less if right_is_zero and left.negative
            return SchemaDecimalOrdering.Greater if right_is_zero
            return SchemaDecimalOrdering.Less if left.negative and not right.negative
            return SchemaDecimalOrdering.Greater if not left.negative and right.negative

            magnitude_ordering: SchemaDecimalOrdering = schema_decimal_compare_magnitude(left, right)
            return schema_decimal_invert_ordering(magnitude_ordering) if left.negative
            return magnitude_ordering


        def parse_schema_integer(bytes: darray[u8]&, start: usize, byte_count: usize, target: SchemaIntegerTarget) -> SchemaIntegerValue error[SchemaIntegerError]:
            raise SchemaIntegerError.InvalidTarget if target == SchemaIntegerTarget.None
            raise SchemaIntegerError.MalformedInteger if byte_count == 0
            raise SchemaIntegerError.InputLimitExceeded if byte_count > SCHEMA_INTEGER_MAX_BYTES
            raise SchemaIntegerError.InputLimitExceeded if start > bytes.count
            raise SchemaIntegerError.InputLimitExceeded if byte_count > bytes.count - start

            numeric_kind: RecordNumericKind = RecordNumericKind.Integer if schema_integer_target_is_signed(target) else RecordNumericKind.Unsigned
            policy: RecordNumericPolicy = RecordNumericPolicy{kind: numeric_kind, max_bytes: byte_count, max_digits: byte_count, allow_underscores: false}
            session: mutable RecordNumericSession = RecordNumericSession{policy: policy}
            try schema_integer_advance(session, RecordNumericEvent.Begin)
            finish: usize = start + byte_count
            for offset in start..<finish |bytes, session|:
                try schema_integer_advance(session, RecordNumericEvent.Byte, bytes[offset])
            try schema_integer_advance(session, RecordNumericEvent.Finish)

            parsed: RecordNumericResult = try schema_integer_result(session)
            negative: bool = parsed.negative if schema_integer_target_is_signed(target) else false
            limit: u64 = try schema_integer_target_limit(target, negative)
            raise SchemaIntegerError.TargetOutOfRange if parsed.magnitude > limit
            if schema_integer_target_is_signed(target):
                signed_value: i64 = 0
                if negative:
                    signed_minimum_magnitude: u64 = try schema_integer_target_limit(target, true)
                    if parsed.magnitude == signed_minimum_magnitude:
                        signed_value <- -9223372036854775807i64 - 1 if target == SchemaIntegerTarget.I64
                        signed_value <- -(signed_minimum_magnitude.i64()) if target != SchemaIntegerTarget.I64
                    else:
                        signed_value <- 0i64 - parsed.magnitude.i64()
                else:
                    signed_value <- parsed.magnitude.i64()
                return SchemaIntegerValue{target: target, signed_value: signed_value}
            return SchemaIntegerValue{target: target, unsigned_value: parsed.magnitude}


        def parse_schema_decimal(bytes: darray[u8]&, start: usize, byte_count: usize) -> SchemaDecimalValue error[SchemaDecimalError] can[Memory.Allocate, Abort.Panic]:
            raise SchemaDecimalError.MalformedDecimal if byte_count == 0
            raise SchemaDecimalError.InputLimitExceeded if byte_count > SCHEMA_DECIMAL_MAX_BYTES
            raise SchemaDecimalError.InputLimitExceeded if start > bytes.count
            raise SchemaDecimalError.InputLimitExceeded if byte_count > bytes.count - start

            policy: RecordNumericPolicy = RecordNumericPolicy{kind: RecordNumericKind.Decimal, max_bytes: byte_count, max_digits: SCHEMA_DECIMAL_MAX_DIGITS, max_exponent_digits: SCHEMA_DECIMAL_MAX_EXPONENT_DIGITS, allow_underscores: false}
            session: mutable RecordNumericSession = RecordNumericSession{policy: policy}
            try schema_decimal_advance(session, RecordNumericEvent.Begin)
            finish: usize = start + byte_count
            for offset in start..<finish |bytes, session|:
                try schema_decimal_advance(session, RecordNumericEvent.Byte, bytes[offset])
            try schema_decimal_advance(session, RecordNumericEvent.Finish)

            parsed: RecordNumericResult = try schema_decimal_result(session)
            coefficient: mutable darray[u8] = []
            in_exponent: mutable bool = false
            for offset in start..<finish |bytes, coefficient, in_exponent|:
                byte: u8 = bytes[offset]
                if byte == 69 or byte == 101:
                    in_exponent <- true
                elif not in_exponent and schema_decimal_byte_is_digit(byte):
                    coefficient.push(byte)
            raise SchemaDecimalError.NumericStateInvalid if coefficient.count != parsed.coefficient_digits

            fractional_digits: i64 = parsed.fraction_digits.i64()
            exponent: i64 = parsed.exponent_magnitude.i64()
            scale: mutable i64 = fractional_digits
            if parsed.exponent_negative:
                scale <- fractional_digits + exponent
            elif exponent > fractional_digits:
                scale <- 0i64 - (exponent - fractional_digits)
            else:
                scale <- fractional_digits - exponent
            raise SchemaDecimalError.ScaleOutOfRange if scale < SCHEMA_DECIMAL_MIN_SCALE or scale > SCHEMA_DECIMAL_MAX_SCALE
            value: SchemaDecimalValue = SchemaDecimalValue{negative: parsed.negative, coefficient_digits: coefficient, scale: scale}
            raise SchemaDecimalError.NumericStateInvalid if not schema_decimal_value_valid(value)
            return value
