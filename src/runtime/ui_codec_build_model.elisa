# Exact ordinary compile recipe for elisa-ui's small host codec gate.
module EsUiCodecBuild:
    public:
        const module Defaults:
            COMPILER: sview = "clang"
            OUTPUT_NAME: sview = "utf8_utf16_codec_test"
            TEMP_PREFIX: sview = "ui-codec-"
            TEMP_LEAF_PREFIX: sview = "elisascript-ui-codec-"
            TIMEOUT_MICROS: i64 = 0


        const module Limits:
            TEXT_BYTES: usize = 4096


        const enum Phase of u8:
            Prepare
            Compile
            Run
            Cleanup
            Done


        struct Recipe:
            compiler: sview
            arguments: darray[sview]
            executable: sview


        struct CompilerEnvironment:
            # A child-only set operation is needed only for inherited empty CC.
            set_cc: bool = false
            cc_value: sview = ""


        error RecipeError:
            InvalidRoot
            InvalidTemporaryRoot
            InvalidCompiler


        def compiler_environment(configured: sview, present: bool) -> CompilerEnvironment error[RecipeError]:
            raise RecipeError.InvalidCompiler if not admitted(configured) or (not present and configured != "")
            return CompilerEnvironment{set_cc: true, cc_value: Defaults::COMPILER} if present and configured == ""
            return CompilerEnvironment{}


        def recipe(project_root: sview, temporary_root: sview, configured_compiler: sview = "") -> Recipe error[RecipeError] can[Memory.Allocate, Abort.Panic]:
            raise RecipeError.InvalidRoot if not absolute_text(project_root)
            raise RecipeError.InvalidTemporaryRoot if temporary_root == "" or not admitted(temporary_root) or temporary_root == "/" or temporary_root == "." or temporary_root == ".."
            compiler: sview = Defaults::COMPILER if configured_compiler == "" else configured_compiler
            raise RecipeError.InvalidCompiler if not admitted(compiler)
            output: sview = temporary_root + "/" + Defaults::OUTPUT_NAME
            return Recipe{compiler: compiler, executable: output, arguments: [
                "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
                "-fsanitize=address,undefined", "-fno-omit-frame-pointer",
                "-I" + project_root + "/src/platform/common",
                project_root + "/test/utf8_utf16_codec_test.c", "-o", output
            ]}


        def after_compile(status: i64) -> Phase:
            return Phase.Run if status == 0
            return Phase.Cleanup


        def final_status(selected_status: i64, cleanup_succeeded: bool) -> i64:
            # An EXIT trap does not overwrite the selected normal exit status.
            _ = cleanup_succeeded
            return selected_status

    private:
        def admitted(text: sview) -> bool:
            count: mutable usize = 0
            for byte in text |count|:
                return false if byte == 0u8 or count >= Limits::TEXT_BYTES
                count <- count + 1
            return true


        def absolute_text(text: sview) -> bool:
            return false if not admitted(text)
            for byte in text:
                return byte == 47u8
            return false
