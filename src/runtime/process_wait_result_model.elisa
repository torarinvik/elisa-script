# Pure terminal receipt decoding. This does not prove a wait or PID ownership.
include "process_model.elisa"
include "process_spawn_wait_model.elisa"

module EsProcessWaitResult:
    public:
        error DecodeError:
            InvalidStatus
            OutputLimit


        # Differential streams are bytes and may contain NUL. They are not the
        # general text-only ProcessResult schema. Signal status here is the
        # normalized observation (128 + signal), not an ordinary exit code.
        struct Receipt:
            kind: EsProcessSpawnWait::Kind
            exit_status: i64
            signal: u32
            stdout: sview
            stderr: sview


        def capture_sizes_fit(stdout_bytes: usize, stderr_bytes: usize) -> bool:
            limit: usize = EsProcess::PROCESS_COMMAND_MAX_CAPTURE_OUTPUT_BYTES
            return false if stdout_bytes > limit
            return stderr_bytes <= limit - stdout_bytes


        def decode(status: i64, stdout: sview, stderr: sview) -> Receipt error[DecodeError]:
            code: i64 = try EsProcessSpawnWait::exit_status(status) else failure:
                raise DecodeError.InvalidStatus
            signaled: bool = EsProcessSpawnWait::classify(status) == EsProcessSpawnWait::Kind.Signaled
            raise DecodeError.OutputLimit if not capture_sizes_fit(len(stdout), len(stderr))
            return Receipt{
                kind: EsProcessSpawnWait::classify(status),
                exit_status: code, signal: (status & EsProcessSpawnWait::Status::LOW_MASK).u32() if signaled else 0u32,
                stdout: stdout, stderr: stderr
            }
