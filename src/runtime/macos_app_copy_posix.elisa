# Darwin file-copy primitive for macOS app staging.
#
# copyfile(3) is used for one file at a time so Elisa owns traversal and ignore
# policy. Omitting COPYFILE_NOFOLLOW_SRC follows source symlinks, matching the
# leaf behavior needed by Python copy2/copytree(symlinks=False).

module EsMacosAppCopyPosix:
    public:
        error MacosAppCopyError:
            InvalidPath
            CopyFailed


        def copy_macos_app_file(source: Path, destination: Path) -> bool error[MacosAppCopyError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            source_text: sview = f"{source}"
            destination_text: sview = f"{destination}"
            raise MacosAppCopyError.InvalidPath if source_text == "" or destination_text == "" or sview_contains_byte(source_text, 0) or sview_contains_byte(destination_text, 0)

            source_bytes: mutable darray[u8] = []
            for byte in source_text |source_bytes|:
                source_bytes.push(byte)
            source_bytes.push(0u8)
            destination_bytes: mutable darray[u8] = []
            for byte in destination_text |destination_bytes|:
                destination_bytes.push(byte)
            destination_bytes.push(0u8)

            source_pointer: cstr = (&source_bytes[0]).cast[cstr]
            destination_pointer: cstr = (&destination_bytes[0]).cast[cstr]
            flags: u32 = CopyfileFlags::DATA | CopyfileFlags::STAT | CopyfileFlags::XATTR
            copied: int = macos_app_copyfile_impl(source_pointer, destination_pointer, null, flags)
            raise MacosAppCopyError.CopyFailed if copied != 0
            return true


    private:
        const module CopyfileFlags:
            STAT: u32 = 2
            XATTR: u32 = 4
            DATA: u32 = 8


        @link_name(copyfile)
        extern macos_app_copyfile_impl(source: cstr, destination: cstr, state: void&?, flags: u32) -> int can[Blocking.IO]
