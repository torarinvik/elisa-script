# Serial host executor for the portable ProcessCommand subset used by builds.
#
# The graph remains data and all invocations pass through Process.Run without
# shell parsing. This first adapter intentionally rejects command modes that
# the current capture builtins cannot preserve exactly; it never silently
# changes environment or stdio semantics.

module EsBuildExecutor:
    using EsBuild
    using EsBuildIncremental
    using EsBuildIncrementalGraph
    using EsBuildRecipeSignature
    using EsProcess
    using EsExecutable

    public:
        const module Limits:
            NODE_RESULTS: usize = EsBuild::Limits::NODES


        const enum BuildExecutionFailureKind of u8:
            None
            Invocation
            NonzeroExit
            OutputMissing


        struct BuildExecutionNodeResult:
            target_name: sview
            started: bool = false
            cache_hit: bool = false
            failure: BuildExecutionFailureKind = BuildExecutionFailureKind.None
            exit_status: i64 = 0
            stdout: sview = ""
            stderr: sview = ""
            missing_output: sview = ""


        struct BuildExecutionNodeOutputs:
            target_name: sview
            paths: darray[sview] = []


        struct BuildExecutionResult:
            graph_state: BuildGraphState = BuildGraphState.Planned
            nodes: darray[BuildExecutionNodeResult] = []
            log_bytes: usize = 0


        error BuildExecutionError:
            GraphInvalid
            GraphNotPlanned
            UnsupportedCommand
            NodeResultLimitExceeded
            OutputListMismatch
            OutputPathInvalid
            LogAccountingInvalid
            ExecutionNotSuccessful
            ExecutionResultMismatch


    private:
        def build_executor_command_supported_impl(command: ProcessCommand) -> bool:
            valid: mutable bool = false
            catch validate_process_command(command):
                ok value:
                    valid <- value
                error failure:
                    return false
            return false if not valid
            return false if command.environment_mode != ProcessEnvironmentMode.Inherit
            # CaptureProcessResult sends an empty, closed input stream and
            # captures both output streams. This build subset promises EOF to
            # stdin consumers, not /dev/null descriptor identity; tools that
            # inspect the underlying descriptor need a lower-level adapter.
            # Reject all other modes rather than silently overriding them.
            return false if command.stdin_mode != ProcessStdioMode.Null
            return false if command.stdout_mode != ProcessStdioMode.Capture or command.stderr_mode != ProcessStdioMode.Capture
            return false if command.stdin_path != "" or command.stdout_path != "" or command.stderr_path != ""
            return false if command.failure_mode != ProcessFailureMode.Check
            return false if command.timeout_micros == 0
            return true


        def execute_build_command(command: ProcessCommand, output_limit: usize) -> ProcessCapture error[ProcessError] can[Memory.Allocate, Abort.Panic, Process.Run]:
            executable_value: Executable = try executable(command.executable)
            environment: mutable dict[sview, sview] = {}
            offset: mutable usize = 0
            while offset < command.environment.count |command, environment, offset|:
                environment[command.environment[offset]] <- command.environment[offset + 1]
                offset <- offset + 2
            if command.working_directory == "":
                return try capture_process_result_with_environment(executable_value, command.arguments, "", environment, command.timeout_micros.i64(), output_limit.i64())
            return try capture_process_result_in_directory_with_environment(executable_value, command.arguments, "", path(command.working_directory), environment, command.timeout_micros.i64(), output_limit.i64())


        def build_executor_output_sets_valid(graph: BuildGraph, output_sets: darray[BuildExecutionNodeOutputs]) -> bool:
            return true if output_sets.count == 0
            return false if output_sets.count != graph.nodes.count
            for index in 0..<output_sets.count |graph, output_sets|:
                for path_index in 0..<output_sets[index].paths.count |output_sets, index|:
                    output_path: sview = output_sets[index].paths[path_index]
                    return false if output_path == "" or sview_contains_byte(output_path, 0) or not path_is_absolute(path(output_path))
                    for prior_index in 0..<index |output_sets, output_path|:
                        for prior_path in output_sets[prior_index].paths:
                            return false if prior_path == output_path
                    for earlier_path in 0..<path_index |output_sets, index, output_path|:
                        return false if output_sets[index].paths[earlier_path] == output_path
            return true


        def build_executor_first_missing_output(outputs: BuildExecutionNodeOutputs) -> sview can[Memory.Allocate, Abort.Panic, File.Read]:
            for output_path in outputs.paths |outputs|:
                return output_path if not is_file(path(output_path))
            return ""


        def build_executor_incremental_execution_result_matches(result: BuildExecutionResult, graph: BuildGraph, recipes: darray[BuildIncrementalRecipeTarget]) -> bool:
            return false if result.graph_state != BuildGraphState.Succeeded or graph.state != BuildGraphState.Succeeded
            return false if result.nodes.count != graph.nodes.count or recipes.count != graph.nodes.count
            return false if result.log_bytes > EsBuild::Limits::LOG_BYTES or graph.log_bytes != result.log_bytes
            total_log_bytes: mutable usize = 0
            for index in 0..<graph.nodes.count |result, graph, recipes, total_log_bytes|:
                node_result: BuildExecutionNodeResult = result.nodes[index]
                recipe: BuildIncrementalRecipeTarget = recipes[index]
                return false if graph.nodes[index].state != BuildNodeState.Succeeded
                return false if graph.nodes[index].name != recipe.name or graph.nodes[index].fingerprint != recipe.recipe_fingerprint or graph.nodes[index].recipe_signature != recipe.recipe_signature
                return false if node_result.target_name != recipe.name or node_result.failure != BuildExecutionFailureKind.None or node_result.missing_output != ""
                return false if node_result.started == node_result.cache_hit or node_result.exit_status != 0
                if node_result.cache_hit:
                    return false if node_result.stdout != "" or node_result.stderr != "" or graph.nodes[index].log_bytes != 0
                else:
                    stdout_bytes: usize = len(node_result.stdout)
                    stderr_bytes: usize = len(node_result.stderr)
                    return false if stdout_bytes > EsBuild::Limits::LOG_BYTES - total_log_bytes
                    total_log_bytes <- total_log_bytes + stdout_bytes
                    return false if stderr_bytes > EsBuild::Limits::LOG_BYTES - total_log_bytes
                    total_log_bytes <- total_log_bytes + stderr_bytes
                    return false if graph.nodes[index].log_bytes != stdout_bytes + stderr_bytes
                return false if graph.nodes[index].dependencies.count != recipe.dependencies.count
                for dependency_position in 0..<graph.nodes[index].dependencies.count |graph, recipes, index, recipe|:
                    dependency_index: usize = graph.nodes[index].dependencies[dependency_position]
                    return false if graph.nodes[dependency_index].name != recipe.dependencies[dependency_position]
            return total_log_bytes == result.log_bytes


    public:
        def build_executor_command_supported(command: ProcessCommand) -> bool:
            return build_executor_command_supported_impl(command)


    private:
        # Execute a validated graph in dependency order with fail-fast
        # semantics. Each command's timeout/output policy remains explicit;
        # the graph-wide retained log ceiling is enforced by reducing each
        # invocation's capture budget to the remaining capacity.
        def execute_build_graph_serial_with_decisions(graph: mutable BuildGraph&, decisions: darray[BuildIncrementalDecision], output_sets: darray[BuildExecutionNodeOutputs]) -> BuildExecutionResult error[BuildExecutionError, BuildContractError] can[Memory.Allocate, Abort.Panic, File.Read, Process.Run]:
            valid_graph: mutable bool = false
            catch validate_build_graph(graph):
                ok value:
                    valid_graph <- value
                error failure:
                    raise BuildExecutionError.GraphInvalid
            raise BuildExecutionError.GraphInvalid if not valid_graph
            raise BuildExecutionError.GraphNotPlanned if graph.state != BuildGraphState.Planned
            raise BuildExecutionError.NodeResultLimitExceeded if graph.nodes.count > Limits::NODE_RESULTS
            raise BuildExecutionError.GraphInvalid if decisions.count != 0 and decisions.count != graph.nodes.count
            raise BuildExecutionError.OutputListMismatch if output_sets.count != 0 and output_sets.count != graph.nodes.count
            if output_sets.count != 0:
                for index in 0..<output_sets.count |graph, output_sets|:
                    raise BuildExecutionError.OutputListMismatch if output_sets[index].target_name != graph.nodes[index].name
                raise BuildExecutionError.OutputPathInvalid if not build_executor_output_sets_valid(graph, output_sets)

            # Preflight every command that will execute before the first
            # external side effect; cache-hit nodes are intentionally skipped.
            for node_index in 0..<graph.nodes.count |graph, decisions|:
                if decisions.count == 0 or decisions[node_index] != BuildIncrementalDecision.UpToDate:
                    raise BuildExecutionError.UnsupportedCommand if not build_executor_command_supported_impl(graph.nodes[node_index].command)

            results: mutable darray[BuildExecutionNodeResult] = []
            for node in graph.nodes |results|:
                results.push(BuildExecutionNodeResult{target_name: node.name})

            _ = try advance_build_graph(graph, BuildGraphEvent.Start)
            for node_index in 0..<graph.nodes.count |graph, results|:
                if graph.state != BuildGraphState.Running:
                    break
                if decisions.count != 0 and decisions[node_index] == BuildIncrementalDecision.UpToDate:
                    _ = try advance_build_graph(graph, BuildGraphEvent.CacheHit, node_index)
                    results[node_index].cache_hit <- true
                else:
                    _ = try advance_build_graph(graph, BuildGraphEvent.NodeStart, node_index)
                    results[node_index].started <- true
                    remaining_log_bytes: usize = EsBuild::Limits::LOG_BYTES - graph.log_bytes
                    command_limit: usize = graph.nodes[node_index].command.capture_output_limit_bytes
                    effective_limit: usize = command_limit if command_limit < remaining_log_bytes else remaining_log_bytes
                    process_error: mutable bool = false
                    catch execute_build_command(graph.nodes[node_index].command, effective_limit):
                        ok value:
                            results[node_index].exit_status <- value.exit_status
                            results[node_index].stdout <- value.stdout
                            results[node_index].stderr <- value.stderr
                        error failure:
                            process_error <- true

                    node_log_bytes: mutable usize = 0
                    if not process_error:
                        stdout_bytes: usize = len(results[node_index].stdout)
                        stderr_bytes: usize = len(results[node_index].stderr)
                        if stdout_bytes > effective_limit:
                            process_error <- true
                        elif stderr_bytes > effective_limit - stdout_bytes:
                            process_error <- true
                        else:
                            node_log_bytes <- stdout_bytes + stderr_bytes

                    if process_error:
                        results[node_index].failure <- BuildExecutionFailureKind.Invocation
                        results[node_index].stdout <- ""
                        results[node_index].stderr <- ""
                        _ = try advance_build_graph(graph, BuildGraphEvent.NodeFailure, node_index)
                        break

                    raise BuildExecutionError.LogAccountingInvalid if node_log_bytes > EsBuild::Limits::LOG_BYTES - graph.log_bytes
                    graph.nodes[node_index].log_bytes <- node_log_bytes
                    graph.log_bytes <- graph.log_bytes + node_log_bytes
                    if results[node_index].exit_status != 0:
                        results[node_index].failure <- BuildExecutionFailureKind.NonzeroExit
                        _ = try advance_build_graph(graph, BuildGraphEvent.NodeFailure, node_index)
                        break
                    if output_sets.count != 0:
                        missing_output: sview = try build_executor_first_missing_output(output_sets[node_index])
                        if missing_output != "":
                            results[node_index].failure <- BuildExecutionFailureKind.OutputMissing
                            results[node_index].missing_output <- missing_output
                            _ = try advance_build_graph(graph, BuildGraphEvent.NodeFailure, node_index)
                            break
                    _ = try advance_build_graph(graph, BuildGraphEvent.NodeSuccess, node_index)

            return BuildExecutionResult{graph_state: graph.state, nodes: results, log_bytes: graph.log_bytes}


    public:
        def execute_build_graph_serial(graph: mutable BuildGraph&) -> BuildExecutionResult error[BuildExecutionError, BuildContractError] can[Memory.Allocate, Abort.Panic, File.Read, Process.Run]:
            return try execute_build_graph_serial_with_decisions(graph, [], [])


        # Verify each declared absolute file output immediately after its
        # producer exits successfully and before the graph exposes NodeSuccess.
        # This is the post-command counterpart to incremental commit's
        # post-execution observation check. It checks presence, not freshness
        # against a pre-command filesystem snapshot.
        def execute_build_graph_serial_with_outputs(graph: mutable BuildGraph&, output_sets: darray[BuildExecutionNodeOutputs]) -> BuildExecutionResult error[BuildExecutionError, BuildContractError] can[Memory.Allocate, Abort.Panic, File.Read, Process.Run]:
            return try execute_build_graph_serial_with_decisions(graph, [], output_sets)


        # Classify against the current graph and observed filesystem snapshot,
        # then skip only nodes that the pure planner admits as UpToDate.
        def execute_build_graph_incremental(graph: mutable BuildGraph&, previous_targets: darray[BuildIncrementalTarget], current_recipes: darray[BuildIncrementalRecipeTarget], observations: darray[BuildIncrementalObservation]) -> BuildExecutionResult error[BuildExecutionError, BuildContractError, BuildIncrementalError, BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic, File.Read, Process.Run]:
            plan: BuildIncrementalPlan = try plan_build_incremental_graph_transition(previous_targets, graph, current_recipes, observations)
            return try execute_build_graph_serial_with_decisions(graph, plan.decisions, [])


        # Only a successful, aligned execution can create the next cache
        # snapshot. The host must still obtain fresh post-success observations;
        # persistence and stale-output deletion remain separate transactions.
        def commit_build_incremental_execution(result: BuildExecutionResult, graph: BuildGraph, previous_targets: darray[BuildIncrementalTarget], current_recipes: darray[BuildIncrementalRecipeTarget], post_success_observations: darray[BuildIncrementalObservation]) -> BuildIncrementalCommit error[BuildExecutionError, BuildContractError, BuildIncrementalError, BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic]:
            graph_valid: bool = try validate_build_graph(graph)
            raise BuildExecutionError.GraphInvalid if not graph_valid
            raise BuildExecutionError.ExecutionNotSuccessful if result.graph_state != BuildGraphState.Succeeded
            _ = try validate_build_incremental_graph_signatures(graph, current_recipes)
            raise BuildExecutionError.ExecutionResultMismatch if not build_executor_incremental_execution_result_matches(result, graph, current_recipes)
            return try commit_build_incremental_success(previous_targets, current_recipes, post_success_observations)
