# Convert resolved pkg-config flags into ordered build-target usage inputs.
#
# The lower-level adapter preserves exact argv order and owns every resulting
# requirement value. The build-facing operation adds effectful canonical path
# and filesystem-kind preflight against caller-approved roots; a build host
# still owns any race-resistant descriptor policy required before dispatch.

module EsPkgConfigUsage:
    using EsBuildUsage
    using EsPkgConfigResult
    using EsPkgConfigWords

    public:
        const module Limits:
            REQUIREMENTS: usize = EsBuildUsage::Limits::REQUIREMENTS_PER_TARGET
            PATH_BYTES: usize = 4096
            TRUSTED_ROOTS: usize = 256


        struct PkgConfigBuildUsage:
            requirements: darray[BuildUsageRequirement] = []
            # Requirement.value views point into these individually owned
            # buffers. Retain this record while the requirements are used.
            owned_values: darray[darray[u8]] = []


        struct PkgConfigPathPolicy:
            # Roots are caller-approved absolute directory spellings. They
            # are canonicalized and checked before any pkg-config path is
            # admitted; symlink targets must remain inside one such root.
            allowed_roots: darray[sview] = []


        error PkgConfigUsageError:
            DiscoveryUnavailable
            InvalidVisibility
            InvalidFlagShape
            RequirementLimitExceeded
            InvalidWorkingDirectory
            PathResolutionFailed
            WrongPathKind
            InvalidPathPolicy
            OutsideTrustedRoots


    private:
        def pkg_config_usage_visibility_valid(visibility: BuildUsageVisibility) -> bool:
            return visibility == BuildUsageVisibility.Private or visibility == BuildUsageVisibility.Public or visibility == BuildUsageVisibility.Interface


        def pkg_config_usage_append_value(output: mutable darray[u8]&, input: darray[u8]) -> void error[PkgConfigUsageError] can[Memory.Allocate, Abort.Panic]:
            raise PkgConfigUsageError.InvalidFlagShape if input.count == 0 or input.count > EsBuildUsage::Limits::VALUE_BYTES
            for byte in input |output|:
                raise PkgConfigUsageError.InvalidFlagShape if byte == 0
                raise PkgConfigUsageError.InvalidFlagShape if output.count >= EsBuildUsage::Limits::VALUE_BYTES
                output.push(byte)


        def pkg_config_usage_text_bytes(input: sview) -> darray[u8] error[PkgConfigUsageError] can[Memory.Allocate, Abort.Panic]:
            raise PkgConfigUsageError.InvalidFlagShape if input == "" or sview_len(input) > EsBuildUsage::Limits::VALUE_BYTES
            bytes: mutable darray[u8] = []
            for byte in input |bytes|:
                raise PkgConfigUsageError.InvalidFlagShape if byte == 0
                bytes.push(byte)
            return bytes


        def pkg_config_usage_copy_flag_value(flag: PkgConfigFlag) -> darray[u8] error[PkgConfigUsageError] can[Memory.Allocate, Abort.Panic]:
            value: mutable darray[u8] = []
            if flag.kind == PkgConfigFlagKind.LibraryDirectory:
                raise PkgConfigUsageError.InvalidFlagShape if flag.value.count > EsBuildUsage::Limits::VALUE_BYTES - 2
                value.push(45u8)
                value.push(76u8)
            try pkg_config_usage_append_value(value, flag.value)
            return value


        def pkg_config_usage_requirement_kind(flag: PkgConfigFlag, stream: PkgConfigFlagStream) -> BuildUsageKind error[PkgConfigUsageError]:
            if stream == PkgConfigFlagStream.Compile:
                return BuildUsageKind.IncludeDirectory if flag.kind == PkgConfigFlagKind.IncludeDirectory
                return BuildUsageKind.CompileDefinition if flag.kind == PkgConfigFlagKind.CompileDefinition
                return BuildUsageKind.CompileOption if flag.kind == PkgConfigFlagKind.CompileOption
                raise PkgConfigUsageError.InvalidFlagShape
            return BuildUsageKind.LinkOption if flag.kind == PkgConfigFlagKind.LibraryDirectory or flag.kind == PkgConfigFlagKind.LinkOption
            return BuildUsageKind.LinkLibrary if flag.kind == PkgConfigFlagKind.LibraryName or flag.kind == PkgConfigFlagKind.LibraryPath
            raise PkgConfigUsageError.InvalidFlagShape


        def pkg_config_usage_library_form(flag: PkgConfigFlag) -> BuildUsageLibraryForm error[PkgConfigUsageError]:
            return BuildUsageLibraryForm.SearchName if flag.kind == PkgConfigFlagKind.LibraryName
            return BuildUsageLibraryForm.Path if flag.kind == PkgConfigFlagKind.LibraryPath
            raise PkgConfigUsageError.InvalidFlagShape


        def pkg_config_usage_canonical_path(discovery: PkgConfigDiscovery, raw_path: sview, want_directory: bool) -> Path error[PkgConfigUsageError] can[Memory.Allocate, Abort.Panic, File.Read, Directory.Read]:
            working_directory: sview = bytes_view(discovery.working_directory)
            raise PkgConfigUsageError.InvalidWorkingDirectory if working_directory == "" or sview_len(working_directory) >= Limits::PATH_BYTES or sview_contains_byte(working_directory, 0) or not path_is_absolute(path(working_directory))
            raise PkgConfigUsageError.InvalidFlagShape if raw_path == "" or sview_len(raw_path) >= Limits::PATH_BYTES or sview_contains_byte(raw_path, 0)

            raw: Path = path(raw_path)
            candidate: Path = raw if path_is_absolute(raw) else path_join(path(working_directory), raw_path)
            canonical: Path = try path_real(candidate) else err:
                raise PkgConfigUsageError.PathResolutionFailed

            if want_directory:
                directory_match: bool = try is_directory(canonical) else err:
                    raise PkgConfigUsageError.PathResolutionFailed
                raise PkgConfigUsageError.WrongPathKind if not directory_match
            else:
                raise PkgConfigUsageError.WrongPathKind if not is_file(canonical)
            return canonical


        struct PkgConfigCanonicalRoots:
            values: darray[darray[u8]] = []


        def pkg_config_usage_canonical_roots(discovery: PkgConfigDiscovery, policy: PkgConfigPathPolicy) -> PkgConfigCanonicalRoots error[PkgConfigUsageError] can[Memory.Allocate, Abort.Panic, File.Read, Directory.Read]:
            raise PkgConfigUsageError.InvalidPathPolicy if policy.allowed_roots.count == 0 or policy.allowed_roots.count > Limits::TRUSTED_ROOTS
            roots: mutable darray[darray[u8]] = []
            for root in policy.allowed_roots |discovery, roots|:
                raise PkgConfigUsageError.InvalidPathPolicy if root == "" or sview_len(root) >= Limits::PATH_BYTES or sview_contains_byte(root, 0) or not path_is_absolute(path(root))
                canonical_root: Path = try pkg_config_usage_canonical_path(discovery, root, true)
                root_text: sview = f"{canonical_root}"
                raise PkgConfigUsageError.InvalidPathPolicy if sview_len(root_text) >= Limits::PATH_BYTES
                root_bytes: darray[u8] = try pkg_config_usage_text_bytes(root_text)
                duplicate: mutable bool = false
                for earlier in roots |duplicate|:
                    duplicate <- true if bytes_view(earlier) == bytes_view(root_bytes)
                if not duplicate:
                    roots.push(root_bytes)
            raise PkgConfigUsageError.InvalidPathPolicy if roots.count == 0
            return PkgConfigCanonicalRoots{values: roots}


        def pkg_config_usage_path_within_root(candidate: sview, root_bytes: darray[u8]) -> bool:
            root: sview = bytes_view(root_bytes)
            return false if candidate == "" or root == "" or not candidate.startswith("/") or not root.startswith("/")
            return true if root == "/"
            return true if candidate == root
            root_length: usize = sview_len(root)
            return false if sview_len(candidate) <= root_length or not candidate.startswith(root)
            return sview_at(candidate, root_length) == 47


        def pkg_config_usage_canonical_path_text(discovery: PkgConfigDiscovery, raw_path: sview, want_directory: bool, roots: PkgConfigCanonicalRoots) -> sview error[PkgConfigUsageError] can[Memory.Allocate, Abort.Panic, File.Read, Directory.Read]:
            canonical: Path = try pkg_config_usage_canonical_path(discovery, raw_path, want_directory)
            canonical_text: sview = f"{canonical}"
            raise PkgConfigUsageError.InvalidFlagShape if canonical_text == "" or sview_len(canonical_text) >= Limits::PATH_BYTES or sview_contains_byte(canonical_text, 0)
            allowed: mutable bool = false
            for root in roots.values |canonical_text, allowed|:
                allowed <- true if pkg_config_usage_path_within_root(canonical_text, root)
            raise PkgConfigUsageError.OutsideTrustedRoots if not allowed
            return canonical_text


        def pkg_config_usage_compile_option_path_kind(option: sview) -> u8:
            # 1 = directory operand; 2 = file operand; 0 = not a recognized
            # path-taking option. Keep this in sync with the word classifier.
            return 1u8 if option == "-isystem" or option == "-iquote" or option == "-idirafter" or option == "-isysroot" or option == "-iframework" or option == "-F"
            return 2u8 if option == "-include" or option == "-imacros"
            return 0u8


        def pkg_config_usage_compile_joined_path_prefix(option: sview) -> usize:
            return 2 if option.startswith("-F") and sview_len(option) > 2
            return 10 if option.startswith("--sysroot=")
            return 0


        def pkg_config_usage_wl_path_prefix(option: sview) -> usize:
            return sview_len("-Wl,-rpath,") if option.startswith("-Wl,-rpath,")
            return sview_len("-Wl,-rpath=") if option.startswith("-Wl,-rpath=")
            return sview_len("-Wl,-rpath-link,") if option.startswith("-Wl,-rpath-link,")
            return sview_len("-Wl,-rpath-link=") if option.startswith("-Wl,-rpath-link=")
            return sview_len("-Wl,-syslibroot,") if option.startswith("-Wl,-syslibroot,")
            return sview_len("-Wl,-syslibroot=") if option.startswith("-Wl,-syslibroot=")
            return 0


        def pkg_config_usage_link_option_is_rpath_operand(option: sview) -> bool:
            return option == "-R"


        def pkg_config_usage_link_option_missing_embedded_path(option: sview) -> bool:
            return option == "-Wl,-rpath" or option == "-Wl,-rpath-link" or option == "-Wl,-syslibroot"


        def pkg_config_usage_link_option_path_prefix(option: sview) -> usize:
            return 2 if option.startswith("-R") and sview_len(option) > 2 else 0


        def pkg_config_usage_embedded_path_end(option: sview, start: usize) -> usize:
            for index in start..<sview_len(option) |option, start|:
                return index if sview_at(option, index) == 44
            return sview_len(option)


    public:
        # Produce requirements suitable for one consumer-selected target.
        # Visibility is explicit because pkg-config cannot decide whether a
        # discovered dependency is private, public, or interface-only.
        def pkg_config_build_usage_requirements_unchecked_paths(discovery: PkgConfigDiscovery, visibility: BuildUsageVisibility) -> PkgConfigBuildUsage error[PkgConfigUsageError] can[Memory.Allocate, Abort.Panic]:
            raise PkgConfigUsageError.DiscoveryUnavailable if discovery.outcome != PkgConfigDiscoveryOutcome.Resolved
            raise PkgConfigUsageError.InvalidVisibility if not pkg_config_usage_visibility_valid(visibility)
            raise PkgConfigUsageError.InvalidFlagShape if discovery.compile_flags.stream != PkgConfigFlagStream.Compile or discovery.link_flags.stream != PkgConfigFlagStream.Link
            raise PkgConfigUsageError.RequirementLimitExceeded if discovery.compile_flags.flags.count > Limits::REQUIREMENTS
            raise PkgConfigUsageError.RequirementLimitExceeded if discovery.link_flags.flags.count > Limits::REQUIREMENTS - discovery.compile_flags.flags.count

            requirements: mutable darray[BuildUsageRequirement] = []
            owned_values: mutable darray[darray[u8]] = []
            for flag in discovery.compile_flags.flags |requirements, owned_values, visibility|:
                kind: BuildUsageKind = try pkg_config_usage_requirement_kind(flag, PkgConfigFlagStream.Compile)
                value: darray[u8] = try pkg_config_usage_copy_flag_value(flag)
                owned_values.push(value)
                requirements.push(BuildUsageRequirement{kind: kind, visibility: visibility, value: bytes_view(owned_values[owned_values.count - 1])})

            for flag in discovery.link_flags.flags |requirements, owned_values, visibility|:
                kind: BuildUsageKind = try pkg_config_usage_requirement_kind(flag, PkgConfigFlagStream.Link)
                value: darray[u8] = try pkg_config_usage_copy_flag_value(flag)
                library_form: BuildUsageLibraryForm = BuildUsageLibraryForm.SearchName
                if kind == BuildUsageKind.LinkLibrary:
                    library_form <- try pkg_config_usage_library_form(flag)
                owned_values.push(value)
                requirements.push(BuildUsageRequirement{kind: kind, visibility: visibility, value: bytes_view(owned_values[owned_values.count - 1]), library_form: library_form})

            return PkgConfigBuildUsage{requirements: requirements, owned_values: owned_values}


    private:
        # Resolve every directory/file-bearing flag against the recorded
        # pkg-config cwd, require its expected filesystem kind, and replace
        # relative or symlinked spellings with real absolute paths. This is a
        # preflight snapshot, not an open-handle guarantee; the build host must
        # revalidate immediately before using the paths if concurrent mutation
        # is in scope.
        def pkg_config_canonicalize_build_usage_paths(discovery: PkgConfigDiscovery, usage: PkgConfigBuildUsage, policy: PkgConfigPathPolicy) -> PkgConfigBuildUsage error[PkgConfigUsageError] can[Memory.Allocate, Abort.Panic, File.Read, Directory.Read]:
            raise PkgConfigUsageError.DiscoveryUnavailable if discovery.outcome != PkgConfigDiscoveryOutcome.Resolved
            raise PkgConfigUsageError.RequirementLimitExceeded if usage.requirements.count > Limits::REQUIREMENTS or usage.owned_values.count != usage.requirements.count
            roots: PkgConfigCanonicalRoots = try pkg_config_usage_canonical_roots(discovery, policy)
            requirements: mutable darray[BuildUsageRequirement] = []
            owned_values: mutable darray[darray[u8]] = []
            for index in 0..<usage.requirements.count |discovery, usage, roots, requirements, owned_values|:
                requirement: BuildUsageRequirement = usage.requirements[index]
                owned_value: darray[u8] = []
                if requirement.kind == BuildUsageKind.IncludeDirectory:
                    canonical_text: sview = try pkg_config_usage_canonical_path_text(discovery, requirement.value, true, roots)
                    owned_value <- try pkg_config_usage_text_bytes(canonical_text)
                elif requirement.kind == BuildUsageKind.LinkOption and requirement.value.startswith("-L"):
                    raw_path: sview = string_view_slice(requirement.value, 2, -1)
                    canonical_text: sview = try pkg_config_usage_canonical_path_text(discovery, raw_path, true, roots)
                    owned_value <- try pkg_config_usage_text_bytes("-L" + canonical_text)
                elif requirement.kind == BuildUsageKind.LinkOption and pkg_config_usage_wl_path_prefix(requirement.value) != 0:
                    prefix_length: usize = pkg_config_usage_wl_path_prefix(requirement.value)
                    path_end: usize = pkg_config_usage_embedded_path_end(requirement.value, prefix_length)
                    raise PkgConfigUsageError.InvalidFlagShape if path_end == prefix_length
                    raw_path: sview = string_view_slice(requirement.value, prefix_length.i64(), (path_end - prefix_length).i64())
                    canonical_text: sview = try pkg_config_usage_canonical_path_text(discovery, raw_path, true, roots)
                    prefix: sview = string_view_slice(requirement.value, 0, prefix_length.i64())
                    suffix: sview = string_view_slice(requirement.value, path_end.i64(), -1)
                    owned_value <- try pkg_config_usage_text_bytes(prefix + canonical_text + suffix)
                elif requirement.kind == BuildUsageKind.LinkOption and pkg_config_usage_link_option_path_prefix(requirement.value) != 0:
                    prefix_length: usize = pkg_config_usage_link_option_path_prefix(requirement.value)
                    raw_path: sview = string_view_slice(requirement.value, prefix_length.i64(), -1)
                    canonical_text: sview = try pkg_config_usage_canonical_path_text(discovery, raw_path, true, roots)
                    prefix: sview = string_view_slice(requirement.value, 0, prefix_length.i64())
                    owned_value <- try pkg_config_usage_text_bytes(prefix + canonical_text)
                elif requirement.kind == BuildUsageKind.LinkLibrary and requirement.library_form == BuildUsageLibraryForm.Path:
                    canonical_text: sview = try pkg_config_usage_canonical_path_text(discovery, requirement.value, false, roots)
                    owned_value <- try pkg_config_usage_text_bytes(canonical_text)
                elif requirement.kind == BuildUsageKind.LinkOption and pkg_config_usage_link_option_is_rpath_operand(requirement.value):
                    raise PkgConfigUsageError.InvalidFlagShape if index + 1 >= usage.requirements.count or usage.requirements[index + 1].kind != BuildUsageKind.LinkOption or usage.requirements[index + 1].value.startswith("-")
                    owned_value <- try pkg_config_usage_text_bytes(requirement.value)
                elif requirement.kind == BuildUsageKind.LinkOption and index > 0 and pkg_config_usage_link_option_is_rpath_operand(usage.requirements[index - 1].value):
                    canonical_text: sview = try pkg_config_usage_canonical_path_text(discovery, requirement.value, true, roots)
                    owned_value <- try pkg_config_usage_text_bytes(canonical_text)
                elif requirement.kind == BuildUsageKind.LinkOption and pkg_config_usage_link_option_missing_embedded_path(requirement.value):
                    raise PkgConfigUsageError.InvalidFlagShape
                elif requirement.kind == BuildUsageKind.CompileOption:
                    joined_prefix: usize = pkg_config_usage_compile_joined_path_prefix(requirement.value)
                    current_path_kind: u8 = pkg_config_usage_compile_option_path_kind(requirement.value)
                    if joined_prefix != 0:
                        raise PkgConfigUsageError.InvalidFlagShape if sview_len(requirement.value) <= joined_prefix
                        raw_path: sview = string_view_slice(requirement.value, joined_prefix.i64(), -1)
                        canonical_text: sview = try pkg_config_usage_canonical_path_text(discovery, raw_path, true, roots)
                        prefix: sview = string_view_slice(requirement.value, 0, joined_prefix.i64())
                        owned_value <- try pkg_config_usage_text_bytes(prefix + canonical_text)
                    elif current_path_kind != 0:
                        raise PkgConfigUsageError.InvalidFlagShape if index + 1 >= usage.requirements.count or usage.requirements[index + 1].kind != BuildUsageKind.CompileOption or usage.requirements[index + 1].value.startswith("-")
                        owned_value <- try pkg_config_usage_text_bytes(requirement.value)
                    else:
                        previous_path_kind: mutable u8 = 0u8
                        if index > 0:
                            previous: BuildUsageRequirement = usage.requirements[index - 1]
                            previous_path_kind <- pkg_config_usage_compile_option_path_kind(previous.value) if previous.kind == BuildUsageKind.CompileOption
                        if previous_path_kind != 0:
                            canonical_text: sview = try pkg_config_usage_canonical_path_text(discovery, requirement.value, previous_path_kind == 1u8, roots)
                            owned_value <- try pkg_config_usage_text_bytes(canonical_text)
                        else:
                            owned_value <- try pkg_config_usage_text_bytes(requirement.value)
                else:
                    owned_value <- try pkg_config_usage_text_bytes(requirement.value)

                owned_values.push(owned_value)
                requirements.push(BuildUsageRequirement{
                    kind: requirement.kind,
                    visibility: requirement.visibility,
                    value: bytes_view(owned_values[owned_values.count - 1]),
                    library_form: requirement.library_form
                })
            return PkgConfigBuildUsage{requirements: requirements, owned_values: owned_values}


    public:
        # Preferred build-facing entry point: path-bearing flags are resolved
        # and type-checked before the caller receives build usage. The lower
        # level `...unchecked_paths` mapper remains available for
        # inspection/reporting only.
        def pkg_config_build_usage_with_canonical_paths(discovery: PkgConfigDiscovery, visibility: BuildUsageVisibility, policy: PkgConfigPathPolicy) -> PkgConfigBuildUsage error[PkgConfigUsageError] can[Memory.Allocate, Abort.Panic, File.Read, Directory.Read]:
            uncanonicalized: PkgConfigBuildUsage = try pkg_config_build_usage_requirements_unchecked_paths(discovery, visibility)
            return try pkg_config_canonicalize_build_usage_paths(discovery, uncanonicalized, policy)
