# Presence is data, not a fallback string or a swallowed host error.
module EsEnvironmentLookup:
    public:
        const module Limits:
            NAME_BYTES: usize = 4096
            VALUE_BYTES: usize = 1048576


        struct Value:
            present: bool
            bytes: sview = ""


        error LookupError:
            InvalidName
            NameLimit
            ValueLimit
            InvalidAbsentValue
            EmbeddedNulValue


        def validate_name(name: sview) -> void error[LookupError]:
            raise LookupError.NameLimit if len(name) > Limits::NAME_BYTES
            raise LookupError.InvalidName if name == ""
            for byte in name:
                raise LookupError.InvalidName if byte == 0u8 or byte == 61u8


        def validate_value(value: Value) -> void error[LookupError]:
            raise LookupError.InvalidAbsentValue if not value.present and value.bytes != ""
            # Check the owned view's envelope before examining payload bytes.
            # Oversized values never become success or a content-dependent error.
            raise LookupError.ValueLimit if len(value.bytes) > Limits::VALUE_BYTES
            for byte in value.bytes:
                raise LookupError.EmbeddedNulValue if byte == 0u8


        # os.environ.get returns None for these dictionary keys in an ordinary
        # well-formed POSIX environment. Do not pass them to a C string lookup.
        # Admit length before scanning, even when an invalid byte would make
        # the key absent. Oversized input is a limit error, never absence.
        def impossible_key(name: sview) -> bool error[LookupError]:
            raise LookupError.NameLimit if len(name) > Limits::NAME_BYTES
            return true if name == ""
            for byte in name:
                return true if byte == 0u8 or byte == 61u8
            return false


        def python_print_value(value: Value) -> sview error[LookupError] can[Memory.Allocate, Abort.Panic]:
            try validate_value(value)
            return value.bytes + "\n" if value.present
            return "None\n"
