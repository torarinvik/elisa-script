# Pure byte admission for descriptor reads. Capacity includes an EOF probe at
# the payload boundary; it is not permission to append beyond the byte limit.
module EsStdinReadBudget:
    public:
        def read_capacity(consumed: u64, limit: u64, chunk_bytes: usize) -> usize:
            return 0usize if consumed > limit or chunk_bytes == 0usize
            remaining: u64 = limit - consumed
            return 1usize if remaining == 0u64
            return remaining.usize() if remaining < chunk_bytes.u64()
            return chunk_bytes


        def payload_fits(consumed: u64, limit: u64, additional: usize) -> bool:
            return false if consumed > limit
            return additional.u64() <= limit - consumed
