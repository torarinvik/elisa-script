# POSIX directory bridge. The interpreter adds nominal Path typing, owned cwd
# snapshots, structured errors, and explicit Directory effects.

extend EsRuntime:
    public:
        # Darwin's public dirent layout. Keep this platform boundary isolated
        # here so a Linux lowering can replace it without changing the typed IR
        # or interpreter API.
        struct ElisascriptDirectoryEntry:
            inode: u64
            seek_offset: u64
            record_length: u16
            name_length: u16
            kind: u8
            name: u8[1024]


        # Darwin arm64's `struct stat` layout. Keep the full object here because
        # libc writes every field, while the interpreter only inspects `mode` to
        # distinguish regular files from directories and other entries.
        struct ElisascriptStatTimespec:
            seconds: i64
            nanoseconds: i64


        struct ElisascriptStat:
            device: u32
            mode: u16
            link_count: u16
            inode: u64
            user: u32
            group: u32
            device_type: u32
            alignment_padding: u32
            access_time: ElisascriptStatTimespec
            modify_time: ElisascriptStatTimespec
            change_time: ElisascriptStatTimespec
            birth_time: ElisascriptStatTimespec
            size: i64
            blocks: i64
            block_size: u32
            flags: u32
            generation: u32
            spare: u32
            quad_spare: i64[2]


        const module DarwinStatMode:
            MASK: u16 = 61440
            REGULAR: u16 = 32768
            DIRECTORY: u16 = 16384
            SYMLINK: u16 = 40960


        const module DarwinAtFlag:
            REMOVE_DIRECTORY: int = 128
            SYMLINK_NOFOLLOW: int = 32

    private:
        @link_name(mkdir)
        extern elisascript_posix_mkdir_impl(path: cstr, mode: int) -> int can[Blocking.IO]

        @link_name(mkdirat)
        extern elisascript_posix_mkdirat_impl(directory_fd: int, path: cstr, mode: int) -> int can[Blocking.IO]

        @link_name(unlinkat)
        extern elisascript_posix_unlinkat_impl(directory_fd: int, path: cstr, flags: int) -> int can[Blocking.IO]

        @link_name(fchmodat)
        extern elisascript_posix_fchmodat_impl(directory_fd: int, path: cstr, mode: u32, flags: int) -> int can[Blocking.IO]

        @link_name(rmdir)
        extern elisascript_posix_rmdir_impl(path: cstr) -> int can[Blocking.IO]

        @link_name(chdir)
        extern elisascript_posix_chdir_impl(path: cstr) -> int can[Blocking.IO]

        @link_name(getcwd)
        extern elisascript_posix_getcwd_impl(buffer: mutable u8&?, size: usize) -> mutable heap u8&? can[Blocking.IO, Memory.Allocate]

        @link_name(opendir)
        extern elisascript_posix_opendir_impl(path: cstr) -> mutable heap void&? can[Blocking.IO, Memory.Allocate]

        @link_name(fdopendir)
        extern elisascript_posix_fdopendir_impl(fd: int) -> mutable heap void&? can[Blocking.IO, Memory.Allocate]

        @link_name(readdir)
        extern elisascript_posix_readdir_impl(directory: void&) -> mutable ElisascriptDirectoryEntry&? can[Blocking.IO]

        @link_name(closedir)
        extern elisascript_posix_closedir_impl(directory: heap void&) -> int can[Blocking.IO, Memory.Release]

        @link_name(dirfd)
        extern elisascript_posix_dirfd_impl(directory: void&) -> int can[Blocking.IO]

        @link_name(fchdir)
        extern elisascript_posix_fchdir_impl(directory_fd: int) -> int can[Blocking.IO]

        @link_name(__error)
        extern elisascript_darwin_errno_impl() -> mutable int&

        @link_name(stat)
        extern elisascript_posix_stat_impl(path: cstr, result: mutable ElisascriptStat&) -> int can[Blocking.IO]

        @link_name(fstat)
        extern elisascript_posix_fstat_impl(fd: int, result: mutable ElisascriptStat&) -> int can[Blocking.IO]

        @link_name(lstat)
        extern elisascript_posix_lstat_impl(path: cstr, result: mutable ElisascriptStat&) -> int can[Blocking.IO]

        @link_name(fstatat)
        extern elisascript_posix_fstatat_impl(directory_fd: int, path: cstr, result: mutable ElisascriptStat&, flags: int) -> int can[Blocking.IO]

    public:
        def elisascript_posix_mkdir(path: cstr, mode: int) -> int can[Blocking.IO]:
            return elisascript_posix_mkdir_impl(path, mode)

        def elisascript_posix_mkdirat(directory_fd: int, path: cstr, mode: int) -> int can[Blocking.IO]:
            return elisascript_posix_mkdirat_impl(directory_fd, path, mode)

        def elisascript_posix_unlinkat(directory_fd: int, path: cstr, flags: int) -> int can[Blocking.IO]:
            return elisascript_posix_unlinkat_impl(directory_fd, path, flags)

        # Change permissions relative to a directory capability. Supplying
        # SYMLINK_NOFOLLOW avoids changing the target if the name is replaced
        # by a symlink before the operation.
        def elisascript_posix_fchmodat(directory_fd: int, path: cstr, mode: u32, flags: int) -> int can[Blocking.IO]:
            return elisascript_posix_fchmodat_impl(directory_fd, path, mode, flags)

        def elisascript_posix_rmdir(path: cstr) -> int can[Blocking.IO]:
            return elisascript_posix_rmdir_impl(path)

        def elisascript_posix_chdir(path: cstr) -> int can[Blocking.IO]:
            return elisascript_posix_chdir_impl(path)

        def elisascript_posix_getcwd(buffer: mutable u8&?, size: usize) -> mutable heap u8&? can[Blocking.IO, Memory.Allocate]:
            return elisascript_posix_getcwd_impl(buffer, size)

        def elisascript_posix_opendir(path: cstr) -> mutable heap void&? can[Blocking.IO, Memory.Allocate]:
            return elisascript_posix_opendir_impl(path)

        # On success fdopendir takes ownership of `fd`; callers that need to
        # retain the directory capability must pass a separately opened fd.
        def elisascript_posix_fdopendir(fd: int) -> mutable heap void&? can[Blocking.IO, Memory.Allocate]:
            return elisascript_posix_fdopendir_impl(fd)

        def elisascript_posix_readdir(directory: void&) -> mutable ElisascriptDirectoryEntry&? can[Blocking.IO]:
            return elisascript_posix_readdir_impl(directory)

        def elisascript_posix_closedir(directory: heap void&) -> int can[Blocking.IO, Memory.Release]:
            return elisascript_posix_closedir_impl(directory)

        def elisascript_posix_dirfd(directory: void&) -> int can[Blocking.IO]:
            return elisascript_posix_dirfd_impl(directory)

        # fchdir mutates the process-global cwd; use it only in a forked child
        # during process setup, never in the adapter/interpreter parent.
        def elisascript_posix_fchdir(directory_fd: int) -> int can[Blocking.IO]:
            return elisascript_posix_fchdir_impl(directory_fd)

        def elisascript_darwin_errno() -> mutable int&:
            return elisascript_darwin_errno_impl()

        # Keep the higher-level adapters independent from the Darwin symbol
        # name. A non-Darwin bridge can provide the same public accessor while
        # preserving the typed IR and retry policy.
        def elisascript_posix_errno() -> mutable int&:
            return elisascript_darwin_errno_impl()

        def elisascript_posix_stat(path: cstr, result: mutable ElisascriptStat&) -> int can[Blocking.IO]:
            return elisascript_posix_stat_impl(path, result)

        # Inspect the opened object itself; unlike stat(path), this cannot be
        # redirected by replacing a directory entry after openat succeeds.
        def elisascript_posix_fstat(fd: int, result: mutable ElisascriptStat&) -> int can[Blocking.IO]:
            return elisascript_posix_fstat_impl(fd, result)

        def elisascript_posix_lstat(path: cstr, result: mutable ElisascriptStat&) -> int can[Blocking.IO]:
            return elisascript_posix_lstat_impl(path, result)

        # Use SYMLINK_NOFOLLOW when the entry kind must be observed without
        # following a runner-created link. Paths must be one validated segment
        # when walking from an owned directory descriptor.
        def elisascript_posix_fstatat(directory_fd: int, path: cstr, result: mutable ElisascriptStat&, flags: int) -> int can[Blocking.IO]:
            return elisascript_posix_fstatat_impl(directory_fd, path, result, flags)
