# POSIX directory bridge. The interpreter adds nominal Path typing, owned cwd
# snapshots, structured errors, and explicit Directory effects.

@link_name(mkdir)
extern elisascript_posix_mkdir(path: cstr, mode: int) -> int can[Blocking.IO]

@link_name(rmdir)
extern elisascript_posix_rmdir(path: cstr) -> int can[Blocking.IO]

@link_name(chdir)
extern elisascript_posix_chdir(path: cstr) -> int can[Blocking.IO]

@link_name(getcwd)
extern elisascript_posix_getcwd(buffer: mutable u8&?, size: usize) -> mutable heap u8&? can[Blocking.IO, Memory.Allocate]
