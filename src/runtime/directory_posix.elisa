# POSIX directory bridge. The interpreter adds nominal Path typing, owned cwd
# snapshots, structured errors, and explicit Directory effects.

@link_name(mkdir)
extern elisascript_posix_mkdir(path: cstr, mode: int) -> int can[Blocking.IO]

@link_name(rmdir)
extern elisascript_posix_rmdir(path: cstr) -> int can[Blocking.IO]

@link_name(chdir)
extern elisascript_posix_chdir(path: cstr) -> int can[Blocking.IO]

@link_name(getcwd)
extern elisascript_posix_getcwd(buffer: mutable u8&?, size: usize) -> mutable heap u8&? can[Blocking.IO, Memory.Allocate]

# Darwin's public dirent layout. Keep this platform boundary isolated here so a
# Linux lowering can replace it without changing the typed IR or interpreter API.
struct ElisascriptDirectoryEntry:
    inode: u64
    seek_offset: u64
    record_length: u16
    name_length: u16
    kind: u8
    name: u8[1024]

@link_name(opendir)
extern elisascript_posix_opendir(path: cstr) -> mutable heap void&? can[Blocking.IO, Memory.Allocate]

@link_name(readdir)
extern elisascript_posix_readdir(directory: void&) -> mutable ElisascriptDirectoryEntry&? can[Blocking.IO]

@link_name(closedir)
extern elisascript_posix_closedir(directory: heap void&) -> int can[Blocking.IO, Memory.Release]

@link_name(__error)
extern elisascript_darwin_errno() -> mutable int&

# Darwin arm64's `struct stat` layout. Keep the full object here because libc
# writes every field, while the interpreter only inspects `mode` to distinguish
# regular files from directories, sockets, and other filesystem entries.
struct ElisascriptStatTimespec:
    seconds: i64
    nanoseconds: i64

struct ElisascriptStat:
    device: u32
    mode: u16
    link_count: u16
    inode: u64
    user: u32
    group: u32
    device_type: u32
    alignment_padding: u32
    access_time: ElisascriptStatTimespec
    modify_time: ElisascriptStatTimespec
    change_time: ElisascriptStatTimespec
    birth_time: ElisascriptStatTimespec
    size: i64
    blocks: i64
    block_size: u32
    flags: u32
    generation: u32
    spare: u32
    quad_spare: i64[2]

@link_name(stat)
extern elisascript_posix_stat(path: cstr, result: mutable ElisascriptStat&) -> int can[Blocking.IO]

const ELISASCRIPT_STAT_MODE_MASK: u16 = 61440
const ELISASCRIPT_STAT_MODE_REGULAR: u16 = 32768
