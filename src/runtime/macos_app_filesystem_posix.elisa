# POSIX filesystem checks required by the Elisa Engine macOS app packager.
#
# This validates package notice inputs and stages resource/notice files. It
# does not assemble or transactionally publish a complete app bundle.

module EsMacosAppFilesystem:
    using EsMacosAppManifest
    using EsMacosAppAssetFilter
    using EsMacosAppCopyPosix

    public:
        error MacosAppFilesystemError:
            InvalidSelection
            ProjectUnavailable
            NoticeRejected
            NoticeConflict
            ResourceRejected
            StageFailed


    private:
        def macos_app_text_starts_with(value: sview, prefix: sview) -> bool:
            return false if sview_len(value) < sview_len(prefix)
            for index in 0..<sview_len(prefix):
                return false if sview_at(value, index) != sview_at(prefix, index)
            return true


        def macos_app_relative_path_escapes(relative: Path) -> bool can[Console.Format]:
            relative_text: sview = f"{relative}"
            return true if relative_text == ".."
            return macos_app_text_starts_with(relative_text, "../")


        def macos_app_copy_chain_contains(chain: darray[Path], candidate: Path) -> bool:
            for ancestor in chain:
                return true if ancestor == candidate
            return false


        # Directory roots and symlinked directory entries are traversed in
        # Elisa so the packager's per-entry ignore policy is applied at every
        # level. Regular files use the Darwin copyfile adapter, which follows
        # file symlinks and copies supported metadata. The active canonical
        # chain rejects symlink cycles without rejecting sibling aliases.
        def macos_app_copy_directory_tree(source: Path, destination: Path, policy: MacosAppAssetFilterPolicy, active_directories: mutable darray[Path]&) -> bool error[MacosAppFilesystemError] can[Blocking.IO, File.Read, File.Write, Directory.Read, Directory.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            source_is_directory: bool = try is_directory(source) else false
            raise MacosAppFilesystemError.ResourceRejected if not source_is_directory
            canonical_source: Path = try path_real(source) else err:
                raise MacosAppFilesystemError.StageFailed
            raise MacosAppFilesystemError.StageFailed if macos_app_copy_chain_contains(active_directories, canonical_source)

            destination_created: bool = try create_directory(destination) else false
            raise MacosAppFilesystemError.StageFailed if not destination_created
            active_count: usize = active_directories.count
            active_directories.push(canonical_source)
            names: darray[sview] = try list_directory(source) else err:
                raise MacosAppFilesystemError.StageFailed
            for name in names |source, destination, policy, active_directories|:
                continue if macos_app_asset_name_is_ignored(name, policy)
                source_child: Path = source.joinpath(name)
                destination_child: Path = destination.joinpath(name)
                child_is_directory: bool = try is_directory(source_child) else false
                if child_is_directory:
                    try macos_app_copy_directory_tree(source_child, destination_child, policy, active_directories)
                else:
                    child_is_file: bool = try is_file(source_child) else false
                    raise MacosAppFilesystemError.StageFailed if not child_is_file
                    copied: bool = try copy_macos_app_file(source_child, destination_child) else err:
                        raise MacosAppFilesystemError.StageFailed
                    raise MacosAppFilesystemError.StageFailed if not copied

            source_mode: i64 = try file_mode(source) else err:
                raise MacosAppFilesystemError.StageFailed
            mode_copied: bool = try chmod(destination, source_mode.u64()) else false
            raise MacosAppFilesystemError.StageFailed if not mode_copied
            active_directories.truncate(active_count)
            return true


    public:
        # Match manifest_notices(): canonicalize each notice, require it to
        # remain under the project, reject a symlink leaf, require a regular
        # file, and require at least one byte. Resolve failures collapse into
        # the same rejected-notice outcome as the Python helper's predicate.
        def validate_macos_app_notice_files(project: Path, selection: MacosAppPathSelection) -> bool error[MacosAppFilesystemError, MacosAppManifestError] can[Blocking.IO, File.Read, Directory.Read, Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            catch validate_macos_app_path_selection(selection):
                ok valid:
                    _ = valid
                error _:
                    raise MacosAppFilesystemError.InvalidSelection

            canonical_project: Path = try path_real(project) else err:
                raise MacosAppFilesystemError.ProjectUnavailable
            for notice in selection.notice_paths:
                source: Path = canonical_project.joinpath(bytes_view(notice))
                resolved: Path = try path_real(source) else err:
                    raise MacosAppFilesystemError.NoticeRejected
                inside_project: mutable bool = false
                catch resolved.relative_to(canonical_project):
                    ok relative:
                        inside_project <- not macos_app_relative_path_escapes(relative)
                    error _:
                        inside_project <- false
                raise MacosAppFilesystemError.NoticeRejected if not inside_project
                raise MacosAppFilesystemError.NoticeRejected if is_symlink(source)
                regular_file: bool = try is_file(source) else false
                raise MacosAppFilesystemError.NoticeRejected if not regular_file
                size: usize = try file_size(source) else err:
                    raise MacosAppFilesystemError.NoticeRejected
                raise MacosAppFilesystemError.NoticeRejected if size == 0
            return true


        # Match the packaging entry's resource-root admission. Implicit asset
        # mode requires the conventional assets directory. For explicit paths,
        # stage_resource() rejects a symlink at the selected leaf, then accepts
        # either a directory (copytree) or a regular file (copy2); missing and
        # special entries fail. Descendant copying is implemented by the
        # staging adapter below.
        def validate_macos_app_resource_inputs(project: Path, selection: MacosAppPathSelection) -> bool error[MacosAppFilesystemError, MacosAppManifestError] can[Blocking.IO, File.Read, Directory.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            catch validate_macos_app_path_selection(selection):
                ok valid:
                    _ = valid
                error _:
                    raise MacosAppFilesystemError.InvalidSelection

            if selection.resource_mode == MacosResourceMode.AllAssets:
                assets: Path = project.joinpath("assets")
                directory: bool = try is_directory(assets) else false
                raise MacosAppFilesystemError.ResourceRejected if not directory
                return true
            for resource in selection.resource_paths:
                source: Path = project.joinpath(bytes_view(resource))
                raise MacosAppFilesystemError.ResourceRejected if is_symlink(source)
                directory: bool = try is_directory(source) else false
                file: bool = try is_file(source) else false
                raise MacosAppFilesystemError.ResourceRejected if not directory and not file
            return true


        def copy_macos_app_directory(source: Path, destination: Path, policy: MacosAppAssetFilterPolicy) -> bool error[MacosAppFilesystemError] can[Blocking.IO, File.Read, File.Write, Directory.Read, Directory.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            source_is_directory: bool = try is_directory(source) else false
            raise MacosAppFilesystemError.ResourceRejected if not source_is_directory
            parent: Path = destination.parent()
            parent_created: bool = try create_directories(parent) else false
            raise MacosAppFilesystemError.StageFailed if not parent_created
            active_directories: mutable darray[Path] = []
            return try macos_app_copy_directory_tree(source, destination, policy, active_directories)


        # Stage the selected project resources into an existing Resources
        # directory. Directory roots must not already exist, like copytree's
        # default dirs_exist_ok=False; file copies retain copy2-style overwrite
        # behavior. This routine does not publish an app bundle transaction.
        def stage_macos_app_resources(project: Path, resources: Path, selection: MacosAppPathSelection) -> bool error[MacosAppFilesystemError, MacosAppManifestError] can[Blocking.IO, File.Read, File.Write, Directory.Read, Directory.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            try validate_macos_app_resource_inputs(project, selection)
            if selection.resource_mode == MacosResourceMode.AllAssets:
                source: Path = project.joinpath("assets")
                destination: Path = resources.joinpath("assets")
                return try copy_macos_app_directory(source, destination, MacosAppAssetFilterPolicy.ProjectResources)
            for relative in selection.resource_paths |project, resources|:
                source: Path = project.joinpath(bytes_view(relative))
                destination: Path = resources.joinpath(bytes_view(relative))
                source_is_directory: bool = try is_directory(source) else false
                if source_is_directory:
                    try copy_macos_app_directory(source, destination, MacosAppAssetFilterPolicy.ProjectResources)
                else:
                    parent: Path = destination.parent()
                    parent_created: bool = try create_directories(parent) else false
                    raise MacosAppFilesystemError.StageFailed if not parent_created
                    copied: bool = try copy_macos_app_file(source, destination) else err:
                        raise MacosAppFilesystemError.StageFailed
                    raise MacosAppFilesystemError.StageFailed if not copied
            return true


        # Stage already-validated notice files under Resources/Notices. Unlike
        # ordinary resource files, an existing destination is a hard conflict
        # rather than an overwrite, matching _assemble_app().
        def stage_macos_app_notices(project: Path, resources: Path, selection: MacosAppPathSelection) -> bool error[MacosAppFilesystemError, MacosAppManifestError] can[Blocking.IO, File.Read, File.Write, Directory.Read, Directory.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            try validate_macos_app_notice_files(project, selection)
            for notice in selection.notice_paths:
                source: Path = project.joinpath(bytes_view(notice))
                destination: Path = resources.joinpath("Notices").joinpath(bytes_view(notice))
                raise MacosAppFilesystemError.NoticeConflict if path_exists(destination)
                parent_created: bool = try create_directories(destination.parent()) else false
                raise MacosAppFilesystemError.StageFailed if not parent_created
                copied: bool = try copy_macos_app_file(source, destination) else err:
                    raise MacosAppFilesystemError.StageFailed
                raise MacosAppFilesystemError.StageFailed if not copied
            return true
