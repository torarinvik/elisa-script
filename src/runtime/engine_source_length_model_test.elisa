include "engine_source_length_model.elisa"

using EsEngineSourceLengthModel


@test
def engine_source_suffix_matches_pathlib_final_suffix() -> void:
    assert source_name_matches("module.elisa")
    assert source_name_matches("module.elisascript")
    assert source_name_matches("native.cpp")
    assert source_name_matches("native.h")
    assert source_name_matches("native.inc")
    assert source_name_matches("audit.py")
    assert source_name_matches("scene.gd")
    assert source_name_matches("README.md")
    assert source_name_matches(".hidden") == false
    assert source_name_matches(".elisa") == false
    assert source_name_matches(".hidden.py")
    assert source_name_matches(".md") == false
    assert source_name_matches("module.MD") == false
    assert source_name_matches("module.txt") == false


@test
def engine_source_order_matches_path_component_prefixes() -> void:
    can Memory.Allocate, Abort.Panic:
        ordered: darray[sview] = ordered_source_paths([
            "src/a.elisa",
            "src/a/z.elisa",
            "src/a-/z.elisa",
            "src/.hidden/child.elisa",
            "src/.hidden.elisa"
        ])
        assert ordered.count == 5
        assert ordered[0] == "src/.hidden/child.elisa"
        assert ordered[1] == "src/.hidden.elisa"
        assert ordered[2] == "src/a/z.elisa"
        assert ordered[3] == "src/a-/z.elisa"
        assert ordered[4] == "src/a.elisa"
