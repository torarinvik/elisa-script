# Typed, shell-free process command values.
#
# This model is deliberately independent of fork/exec. It gives the language
# and higher-level adapters one validated command shape before a host bridge
# chooses POSIX, Windows, or a deterministic test backend. Arguments and
# environment entries remain separate values; no shell grammar is involved.

module EsProcess:
    public:
        const PROCESS_COMMAND_MAX_ARGUMENTS: usize = 1048576
        const PROCESS_COMMAND_MAX_TEXT_BYTES: usize = 67108864
        const PROCESS_PIPELINE_MAX_STAGES: usize = 256
        const PROCESS_PIPELINE_MAX_BUFFER_BYTES: usize = 67108864
        const PROCESS_MAX_SIGNAL: u32 = 64


        const enum ProcessStdioMode of u8:
            Inherit
            Capture
            Null
            File


        const enum ProcessEnvironmentMode of u8:
            # Preserve the host environment and overlay the supplied entries.
            Inherit
            # Give the child exactly the supplied entries.
            Replace
            # Give the child no environment; the entry vector must be empty.
            Clear


        const enum ProcessFailureMode of u8:
            Check
            Allow


        const enum ProcessResultKind of u8:
            Exited
            Signaled
            SpawnFailure
            TimedOut
            Cancelled
            OutputLimit
            HostIoFailure


        struct ProcessResult:
            kind: ProcessResultKind = ProcessResultKind.Exited
            exit_status: i64 = 0
            signal: u32 = 0
            stdout: sview = ""
            stderr: sview = ""
            error_text: sview = ""


        const enum ProcessJobState of u8:
            Created
            Running
            Cancelling
            Succeeded
            Failed
            TimedOut
            Cancelled


        const enum ProcessJobEvent of u8:
            Start
            Complete
            Fail
            Timeout
            Cancel
            CancelAck
            Retry


        struct ProcessJob:
            state: mutable ProcessJobState = ProcessJobState.Created
            attempts: mutable usize = 0
            max_attempts: usize = 1


        # Environment entries are an alternating name/value vector. Keeping
        # the representation flat makes duplicate-name checks deterministic
        # and lets host adapters preserve insertion order without a map-order
        # promise. The validator requires an even number of entries.
        struct ProcessCommand:
            executable: sview
            arguments: darray[sview] = []
            working_directory: sview = ""
            environment: darray[sview] = []
            environment_mode: ProcessEnvironmentMode = ProcessEnvironmentMode.Inherit
            stdin_mode: ProcessStdioMode = ProcessStdioMode.Inherit
            stdout_mode: ProcessStdioMode = ProcessStdioMode.Capture
            stderr_mode: ProcessStdioMode = ProcessStdioMode.Capture
            stdin_path: sview = ""
            stdout_path: sview = ""
            stderr_path: sview = ""
            timeout_micros: u64 = 0
            failure_mode: ProcessFailureMode = ProcessFailureMode.Check


        const enum ProcessPipelineFailureMode of u8:
            FailFast
            Aggregate


        # Exit-status selection is independent of stage execution/failure
        # handling: both policies run every stage, but expose a different
        # status in the final capture.
        const enum ProcessPipelineStatusPolicy of u8:
            LastStage
            Pipefail


        const enum ProcessPipelineState of u8:
            Planned
            Running
            Cancelling
            Succeeded
            Failed
            Cancelled


        const enum ProcessPipelineStageState of u8:
            Pending
            Running
            Exited
            Failed
            Cancelled


        const enum ProcessPipelineStream of u8:
            Stdin
            Stdout
            Stderr


        const enum ProcessPipelineEvent of u8:
            Start
            StageStart
            StageExit
            StageFailure
            StageCancel
            Cancel
            CancelAck
            # Appended to preserve the numeric identity of the original
            # lifecycle events for hosts that persist or bridge event tags.
            StageOutput


        # A terminal receipt is not publishable until the host has logically
        # closed the stage's stdin (no more writes are possible) and observed
        # EOF on both output channels. The closure is logical for inherited,
        # null, file, or pipeline-owned routes; it does not require the model
        # to own a particular descriptor. Stream byte counters remain separate
        # from captured `ProcessResult` views so a concurrent adapter can drain
        # data without retaining every byte. Pipeline adapters may override a
        # command's direct stdio route with connected channels, but must report
        # those logical channels through this receipt.
        struct ProcessPipelineStageResult:
            published: bool = false
            result: ProcessResult = ProcessResult{}
            stdin_closed: bool = false
            stdout_eof: bool = false
            stderr_eof: bool = false
            stdin_bytes: mutable usize = 0
            stdout_bytes: mutable usize = 0
            stderr_bytes: mutable usize = 0


        struct ProcessPipeline:
            stages: darray[ProcessCommand] = []
            stage_states: darray[ProcessPipelineStageState] = []
            stage_results: darray[ProcessPipelineStageResult] = []
            state: mutable ProcessPipelineState = ProcessPipelineState.Planned
            failure_mode: ProcessPipelineFailureMode = ProcessPipelineFailureMode.FailFast
            cancellation_requested: mutable bool = false
            completed_stages: mutable usize = 0
            failed_stages: mutable usize = 0
            cancelled_stages: mutable usize = 0
            buffer_limit_bytes: usize = PROCESS_PIPELINE_MAX_BUFFER_BYTES
            stream_bytes: mutable usize = 0


        error ProcessCommandError:
            EmptyExecutable
            EmbeddedNul
            TextLimitExceeded
            ArgumentCountExceeded
            ArgumentVectorMalformed
            InvalidWorkingDirectory
            EnvironmentVectorMalformed
            EnvironmentCountExceeded
            EnvironmentNameInvalid
            DuplicateEnvironmentName
            InvalidEnvironmentMode
            EnvironmentClearHasEntries
            InvalidStdioMode
            InvalidStdioPath
            StdioPathEmbeddedNul
            InvalidFailureMode


        error ProcessResultError:
            InvalidOutcome
            InvalidSignal
            TextLimitExceeded
            EmbeddedNul
            AggregateTextLimitExceeded


        error ProcessJobError:
            InvalidState
            InvalidEvent
            InvalidAttemptLimit
            RetryLimitExceeded


        error ProcessPipelineError:
            EmptyPipeline
            StageLimitExceeded
            InvalidPipelineState
            InvalidPipelineEvent
            InvalidFailureMode
            InvalidStageIndex
            InvalidStageState
            InvalidStageCommand
            InvalidBufferLimit
            InvalidChannel
            InvalidReceipt
            PipelineNotDrained
            OutputLimitExceeded
            ChannelAccountingInvalid
            PipelineAccountingInvalid


        private:
            def process_job_state_valid(state: ProcessJobState) -> bool:
                return state in {ProcessJobState.Created, ProcessJobState.Running, ProcessJobState.Cancelling, ProcessJobState.Succeeded, ProcessJobState.Failed, ProcessJobState.TimedOut, ProcessJobState.Cancelled}


            def process_job_state_requires_attempt(state: ProcessJobState) -> bool:
                return state == ProcessJobState.Running or state == ProcessJobState.Cancelling or state == ProcessJobState.Succeeded or state == ProcessJobState.Failed or state == ProcessJobState.TimedOut or state == ProcessJobState.Cancelled


            def process_job_event_valid(event: ProcessJobEvent) -> bool:
                return event in {ProcessJobEvent.Start, ProcessJobEvent.Complete, ProcessJobEvent.Fail, ProcessJobEvent.Timeout, ProcessJobEvent.Cancel, ProcessJobEvent.CancelAck, ProcessJobEvent.Retry}


            def process_pipeline_state_valid(state: ProcessPipelineState) -> bool:
                return state in {ProcessPipelineState.Planned, ProcessPipelineState.Running, ProcessPipelineState.Cancelling, ProcessPipelineState.Succeeded, ProcessPipelineState.Failed, ProcessPipelineState.Cancelled}


            def process_pipeline_stage_state_valid(state: ProcessPipelineStageState) -> bool:
                return state in {ProcessPipelineStageState.Pending, ProcessPipelineStageState.Running, ProcessPipelineStageState.Exited, ProcessPipelineStageState.Failed, ProcessPipelineStageState.Cancelled}


            def process_pipeline_stream_valid(stream: ProcessPipelineStream) -> bool:
                return stream in {ProcessPipelineStream.Stdin, ProcessPipelineStream.Stdout, ProcessPipelineStream.Stderr}


            def process_pipeline_event_valid(event: ProcessPipelineEvent) -> bool:
                return event in {ProcessPipelineEvent.Start, ProcessPipelineEvent.StageStart, ProcessPipelineEvent.StageOutput, ProcessPipelineEvent.StageExit, ProcessPipelineEvent.StageFailure, ProcessPipelineEvent.StageCancel, ProcessPipelineEvent.Cancel, ProcessPipelineEvent.CancelAck}


            def process_pipeline_failure_mode_valid(mode: ProcessPipelineFailureMode) -> bool:
                return mode in {ProcessPipelineFailureMode.FailFast, ProcessPipelineFailureMode.Aggregate}


            def process_pipeline_stage_result_open_valid(result: ProcessPipelineStageResult) -> bool:
                return not result.published and not result.stdin_closed and not result.stdout_eof and not result.stderr_eof and result.result.kind == ProcessResultKind.Exited and result.result.exit_status == 0 and result.result.signal == 0 and result.result.stdout == "" and result.result.stderr == "" and result.result.error_text == ""


            def process_pipeline_stage_result_valid(result: ProcessPipelineStageResult, event: ProcessPipelineEvent, observed: ProcessPipelineStageResult, was_pending: bool = false) -> bool error[ProcessPipelineError]:
                raise ProcessPipelineError.InvalidReceipt if not result.published
                raise ProcessPipelineError.PipelineNotDrained if not result.stdin_closed or not result.stdout_eof or not result.stderr_eof
                checked_result: mutable ProcessResult = result.result
                valid: bool = try validate_process_result(checked_result) else false
                raise ProcessPipelineError.InvalidReceipt if not valid
                raise ProcessPipelineError.InvalidReceipt if result.stdin_bytes != observed.stdin_bytes or result.stdout_bytes != observed.stdout_bytes or result.stderr_bytes != observed.stderr_bytes
                raise ProcessPipelineError.InvalidReceipt if result.stdout_bytes < sview_len(result.result.stdout) or result.stderr_bytes < sview_len(result.result.stderr)
                raise ProcessPipelineError.InvalidReceipt if was_pending and result.result.kind != ProcessResultKind.SpawnFailure
                raise ProcessPipelineError.InvalidReceipt if not was_pending and result.result.kind == ProcessResultKind.SpawnFailure
                if event == ProcessPipelineEvent.StageExit:
                    raise ProcessPipelineError.InvalidReceipt if result.result.kind != ProcessResultKind.Exited or result.result.exit_status != 0
                elif event == ProcessPipelineEvent.StageCancel:
                    raise ProcessPipelineError.InvalidReceipt if result.result.kind != ProcessResultKind.Cancelled
                elif event == ProcessPipelineEvent.StageFailure:
                    raise ProcessPipelineError.InvalidReceipt if result.result.kind == ProcessResultKind.Exited and result.result.exit_status == 0
                    raise ProcessPipelineError.InvalidReceipt if result.result.kind == ProcessResultKind.Cancelled
                return true


            def process_pipeline_stage_result_add_fits(total: usize, result: ProcessPipelineStageResult, limit: usize) -> bool:
                return false if total > limit
                remaining: mutable usize = limit - total
                return false if result.stdin_bytes > remaining
                remaining <- remaining - result.stdin_bytes
                return false if result.stdout_bytes > remaining
                remaining <- remaining - result.stdout_bytes
                return result.stderr_bytes <= remaining


            def process_result_kind_valid(kind: ProcessResultKind) -> bool:
                return kind in {ProcessResultKind.Exited, ProcessResultKind.Signaled, ProcessResultKind.SpawnFailure, ProcessResultKind.TimedOut, ProcessResultKind.Cancelled, ProcessResultKind.OutputLimit, ProcessResultKind.HostIoFailure}


            def process_result_text_add_fits(total: usize, value: sview) -> bool:
                return false if total > PROCESS_COMMAND_MAX_TEXT_BYTES
                return false if sview_len(value) >= PROCESS_COMMAND_MAX_TEXT_BYTES - total
                return true


            def process_command_text_length_valid(value: sview) -> bool:
                return sview_len(value) < PROCESS_COMMAND_MAX_TEXT_BYTES


            def process_command_text_add_fits(total: usize, value: sview) -> bool:
                return false if total > PROCESS_COMMAND_MAX_TEXT_BYTES
                # Every host C-string copy needs one terminator byte.
                return false if sview_len(value) >= PROCESS_COMMAND_MAX_TEXT_BYTES - total
                return true


            def process_command_stdio_mode_valid(mode: ProcessStdioMode) -> bool:
                return mode in {ProcessStdioMode.Inherit, ProcessStdioMode.Capture, ProcessStdioMode.Null, ProcessStdioMode.File}


            def process_command_environment_mode_valid(mode: ProcessEnvironmentMode) -> bool:
                return mode in {ProcessEnvironmentMode.Inherit, ProcessEnvironmentMode.Replace, ProcessEnvironmentMode.Clear}


            def process_command_failure_mode_valid(mode: ProcessFailureMode) -> bool:
                return mode in {ProcessFailureMode.Check, ProcessFailureMode.Allow}


            def process_command_environment_name_valid(name: sview) -> bool:
                return sview_len(name) != 0 and process_command_text_length_valid(name) and not sview_contains_byte(name, 0) and not sview_contains_byte(name, 61)


            def process_command_text_has_nul(value: sview) -> bool:
                return sview_contains_byte(value, 0)


            def process_command_stdio_path_valid(mode: ProcessStdioMode, path: sview) -> bool:
                return path != "" if mode == ProcessStdioMode.File else path == ""


            def process_environment_entry_index(entries: darray[sview], name: sview) -> usize:
                index: mutable usize = 0
                while index < entries.count |index, entries, name|:
                    return index if entries[index] == name
                    index <- index + 2
                return entries.count


            def validate_process_environment_vector(entries: darray[sview]) -> bool error[ProcessCommandError]:
                raise ProcessCommandError.EnvironmentVectorMalformed if entries.count % 2 != 0
                raise ProcessCommandError.EnvironmentCountExceeded if entries.count / 2 > PROCESS_COMMAND_MAX_ARGUMENTS
                for offset in 0..<entries.count |entries|:
                    entry: sview = entries[offset]
                    raise ProcessCommandError.TextLimitExceeded if not process_command_text_length_valid(entry)
                    raise ProcessCommandError.EmbeddedNul if process_command_text_has_nul(entry)
                    if offset % 2 == 0:
                        raise ProcessCommandError.EnvironmentNameInvalid if not process_command_environment_name_valid(entry)
                        for earlier in 0..<offset |entries, entry|:
                            raise ProcessCommandError.DuplicateEnvironmentName if earlier % 2 == 0 and entries[earlier] == entry
                return true


        public:
            # Validate all data that a host process adapter would copy or use
            # as policy. This is intentionally an error[...] boundary rather
            # than a Result-shaped value so callers cannot ignore malformed
            # command construction accidentally.
            def validate_process_command(command: ProcessCommand&) -> bool error[ProcessCommandError]:
                raise ProcessCommandError.EmptyExecutable if sview_len(command.executable) == 0
                raise ProcessCommandError.TextLimitExceeded if not process_command_text_length_valid(command.executable)
                raise ProcessCommandError.EmbeddedNul if process_command_text_has_nul(command.executable)
                raise ProcessCommandError.ArgumentCountExceeded if command.arguments.count > PROCESS_COMMAND_MAX_ARGUMENTS
                raise ProcessCommandError.EnvironmentVectorMalformed if command.environment.count % 2 != 0
                raise ProcessCommandError.InvalidWorkingDirectory if command.working_directory != "" and not process_command_text_length_valid(command.working_directory)
                raise ProcessCommandError.EmbeddedNul if command.working_directory != "" and process_command_text_has_nul(command.working_directory)
                raise ProcessCommandError.InvalidEnvironmentMode if not process_command_environment_mode_valid(command.environment_mode)
                raise ProcessCommandError.EnvironmentClearHasEntries if command.environment_mode == ProcessEnvironmentMode.Clear and command.environment.count != 0
                raise ProcessCommandError.InvalidStdioMode if not process_command_stdio_mode_valid(command.stdin_mode) or not process_command_stdio_mode_valid(command.stdout_mode) or not process_command_stdio_mode_valid(command.stderr_mode)
                raise ProcessCommandError.InvalidStdioPath if not process_command_stdio_path_valid(command.stdin_mode, command.stdin_path) or not process_command_stdio_path_valid(command.stdout_mode, command.stdout_path) or not process_command_stdio_path_valid(command.stderr_mode, command.stderr_path)
                raise ProcessCommandError.TextLimitExceeded if command.stdin_path != "" and not process_command_text_length_valid(command.stdin_path)
                raise ProcessCommandError.TextLimitExceeded if command.stdout_path != "" and not process_command_text_length_valid(command.stdout_path)
                raise ProcessCommandError.TextLimitExceeded if command.stderr_path != "" and not process_command_text_length_valid(command.stderr_path)
                raise ProcessCommandError.StdioPathEmbeddedNul if command.stdin_path != "" and process_command_text_has_nul(command.stdin_path)
                raise ProcessCommandError.StdioPathEmbeddedNul if command.stdout_path != "" and process_command_text_has_nul(command.stdout_path)
                raise ProcessCommandError.StdioPathEmbeddedNul if command.stderr_path != "" and process_command_text_has_nul(command.stderr_path)
                raise ProcessCommandError.InvalidFailureMode if not process_command_failure_mode_valid(command.failure_mode)
                try validate_process_environment_vector(command.environment)

                total: mutable usize = 0
                raise ProcessCommandError.ArgumentVectorMalformed if not process_command_text_add_fits(total, command.executable)
                total <- total + sview_len(command.executable) + 1
                if command.working_directory != "":
                    raise ProcessCommandError.ArgumentVectorMalformed if not process_command_text_add_fits(total, command.working_directory)
                    total <- total + sview_len(command.working_directory) + 1
                for argument in command.arguments |command, total|:
                    raise ProcessCommandError.TextLimitExceeded if not process_command_text_length_valid(argument)
                    raise ProcessCommandError.EmbeddedNul if process_command_text_has_nul(argument)
                    raise ProcessCommandError.ArgumentVectorMalformed if not process_command_text_add_fits(total, argument)
                    total <- total + sview_len(argument) + 1

                for offset in 0..<command.environment.count |command, total|:
                    entry: sview = command.environment[offset]
                    raise ProcessCommandError.EnvironmentVectorMalformed if not process_command_text_add_fits(total, entry)
                    total <- total + sview_len(entry) + 1
                for path in [command.stdin_path, command.stdout_path, command.stderr_path] |command, total|:
                    if path != "":
                        raise ProcessCommandError.ArgumentVectorMalformed if not process_command_text_add_fits(total, path)
                        total <- total + sview_len(path) + 1
                return true


            # Resolve the exact child environment without consulting or
            # mutating process-global state. `inherited` is a captured,
            # alternating name/value vector supplied by the host adapter;
            # `Inherit` overlays command entries in place order, `Replace`
            # discards the captured vector, and `Clear` emits no entries.
            def resolve_process_environment(command: ProcessCommand&, inherited: darray[sview] = []) -> darray[sview] error[ProcessCommandError] can[Memory.Allocate, Abort.Panic]:
                try validate_process_command(command)
                result: mutable darray[sview] = []
                if command.environment_mode == ProcessEnvironmentMode.Clear:
                    return result
                if command.environment_mode == ProcessEnvironmentMode.Replace:
                    for entry in command.environment |result|:
                        result.push(entry)
                    return result
                try validate_process_environment_vector(inherited)
                for entry in inherited |result|:
                    result.push(entry)
                offset: mutable usize = 0
                while offset < command.environment.count |offset, command, result|:
                    name: sview = command.environment[offset]
                    value: sview = command.environment[offset + 1]
                    existing: usize = process_environment_entry_index(result, name)
                    if existing == result.count:
                        result.push(name)
                        result.push(value)
                    else:
                        result[existing + 1] <- value
                    offset <- offset + 2
                return result


            def validate_process_pipeline(pipeline: ProcessPipeline&) -> bool error[ProcessPipelineError]:
                raise ProcessPipelineError.EmptyPipeline if pipeline.stages.count == 0
                raise ProcessPipelineError.StageLimitExceeded if pipeline.stages.count > PROCESS_PIPELINE_MAX_STAGES
                raise ProcessPipelineError.InvalidPipelineState if not process_pipeline_state_valid(pipeline.state)
                raise ProcessPipelineError.InvalidFailureMode if not process_pipeline_failure_mode_valid(pipeline.failure_mode)
                raise ProcessPipelineError.InvalidBufferLimit if pipeline.buffer_limit_bytes == 0 or pipeline.buffer_limit_bytes > PROCESS_PIPELINE_MAX_BUFFER_BYTES
                if pipeline.state == ProcessPipelineState.Planned:
                    raise ProcessPipelineError.PipelineAccountingInvalid if pipeline.stage_states.count != 0 or pipeline.stage_results.count != 0 or pipeline.cancellation_requested or pipeline.completed_stages != 0 or pipeline.failed_stages != 0 or pipeline.cancelled_stages != 0 or pipeline.stream_bytes != 0
                else:
                    raise ProcessPipelineError.PipelineAccountingInvalid if pipeline.stage_states.count != pipeline.stages.count or pipeline.stage_results.count != pipeline.stages.count
                    raise ProcessPipelineError.OutputLimitExceeded if pipeline.stream_bytes > pipeline.buffer_limit_bytes
                    derived_completed: mutable usize = 0
                    derived_failed: mutable usize = 0
                    derived_cancelled: mutable usize = 0
                    derived_stream_bytes: mutable usize = 0
                    for index in 0..<pipeline.stage_states.count |pipeline, derived_completed, derived_failed, derived_cancelled, derived_stream_bytes|:
                        stage_state: ProcessPipelineStageState = pipeline.stage_states[index]
                        stage_result: ProcessPipelineStageResult = pipeline.stage_results[index]
                        raise ProcessPipelineError.InvalidStageState if not process_pipeline_stage_state_valid(stage_state)
                        if stage_state == ProcessPipelineStageState.Pending:
                            raise ProcessPipelineError.InvalidReceipt if not process_pipeline_stage_result_open_valid(stage_result) or stage_result.stdin_bytes != 0 or stage_result.stdout_bytes != 0 or stage_result.stderr_bytes != 0
                        elif stage_state == ProcessPipelineStageState.Running:
                            raise ProcessPipelineError.InvalidReceipt if not process_pipeline_stage_result_open_valid(stage_result)
                        elif stage_state == ProcessPipelineStageState.Exited:
                            try process_pipeline_stage_result_valid(stage_result, ProcessPipelineEvent.StageExit, stage_result, false)
                        elif stage_state == ProcessPipelineStageState.Failed:
                            try process_pipeline_stage_result_valid(stage_result, ProcessPipelineEvent.StageFailure, stage_result, false)
                        elif stage_state == ProcessPipelineStageState.Cancelled:
                            try process_pipeline_stage_result_valid(stage_result, ProcessPipelineEvent.StageCancel, stage_result, false)
                        raise ProcessPipelineError.OutputLimitExceeded if not process_pipeline_stage_result_add_fits(derived_stream_bytes, stage_result, pipeline.buffer_limit_bytes)
                        derived_stream_bytes <- derived_stream_bytes + stage_result.stdin_bytes + stage_result.stdout_bytes + stage_result.stderr_bytes
                        if stage_state == ProcessPipelineStageState.Exited or stage_state == ProcessPipelineStageState.Failed or stage_state == ProcessPipelineStageState.Cancelled:
                            derived_completed <- derived_completed + 1
                        if stage_state == ProcessPipelineStageState.Failed:
                            derived_failed <- derived_failed + 1
                        if stage_state == ProcessPipelineStageState.Cancelled:
                            derived_cancelled <- derived_cancelled + 1
                    raise ProcessPipelineError.PipelineAccountingInvalid if pipeline.completed_stages != derived_completed or pipeline.failed_stages != derived_failed or pipeline.cancelled_stages != derived_cancelled
                    raise ProcessPipelineError.ChannelAccountingInvalid if pipeline.stream_bytes != derived_stream_bytes
                    if pipeline.state == ProcessPipelineState.Running:
                        raise ProcessPipelineError.PipelineAccountingInvalid if pipeline.cancellation_requested or pipeline.completed_stages >= pipeline.stages.count
                        raise ProcessPipelineError.PipelineAccountingInvalid if pipeline.failure_mode == ProcessPipelineFailureMode.FailFast and pipeline.failed_stages != 0
                        raise ProcessPipelineError.PipelineAccountingInvalid if pipeline.cancelled_stages != 0
                    elif pipeline.state == ProcessPipelineState.Cancelling:
                        raise ProcessPipelineError.PipelineAccountingInvalid if not pipeline.cancellation_requested or (pipeline.completed_stages == pipeline.stages.count and pipeline.failed_stages != 0)
                    elif pipeline.state == ProcessPipelineState.Succeeded:
                        raise ProcessPipelineError.PipelineAccountingInvalid if pipeline.cancellation_requested or pipeline.completed_stages != pipeline.stages.count or pipeline.failed_stages != 0 or pipeline.cancelled_stages != 0
                    elif pipeline.state == ProcessPipelineState.Failed:
                        raise ProcessPipelineError.PipelineAccountingInvalid if pipeline.completed_stages != pipeline.stages.count or pipeline.failed_stages == 0
                        raise ProcessPipelineError.PipelineAccountingInvalid if pipeline.cancelled_stages != 0 and not pipeline.cancellation_requested
                    elif pipeline.state == ProcessPipelineState.Cancelled:
                        raise ProcessPipelineError.PipelineAccountingInvalid if not pipeline.cancellation_requested or pipeline.completed_stages != pipeline.stages.count or pipeline.failed_stages != 0
                for stage in pipeline.stages |pipeline|:
                    valid: mutable bool = false
                    catch validate_process_command(stage):
                        ok:
                            valid <- true
                            true
                        error failure:
                            valid <- false
                            true
                    raise ProcessPipelineError.InvalidStageCommand if not valid
                return true


            def process_pipeline_refresh_accounting(pipeline: mutable ProcessPipeline&) -> void:
                pipeline.completed_stages <- 0
                pipeline.failed_stages <- 0
                pipeline.cancelled_stages <- 0
                for stage_state in pipeline.stage_states |pipeline|:
                    if stage_state == ProcessPipelineStageState.Exited or stage_state == ProcessPipelineStageState.Failed or stage_state == ProcessPipelineStageState.Cancelled:
                        pipeline.completed_stages <- pipeline.completed_stages + 1
                    if stage_state == ProcessPipelineStageState.Failed:
                        pipeline.failed_stages <- pipeline.failed_stages + 1
                    if stage_state == ProcessPipelineStageState.Cancelled:
                        pipeline.cancelled_stages <- pipeline.cancelled_stages + 1


            def advance_process_pipeline(pipeline: mutable ProcessPipeline&, event: ProcessPipelineEvent, stage_index: usize = 0, receipt: ProcessPipelineStageResult = ProcessPipelineStageResult{}, stream: ProcessPipelineStream = ProcessPipelineStream.Stdout, bytes: usize = 0) -> ProcessPipelineState error[ProcessPipelineError] can[Memory.Allocate, Abort.Panic]:
                try validate_process_pipeline(pipeline)
                raise ProcessPipelineError.InvalidPipelineEvent if not process_pipeline_event_valid(event)
                # Planned pipelines have no per-stage state vector. Only Start
                # and immediate cancellation are meaningful before allocation.
                raise ProcessPipelineError.InvalidPipelineState if pipeline.state == ProcessPipelineState.Planned and event != ProcessPipelineEvent.Start and event != ProcessPipelineEvent.Cancel
                if event == ProcessPipelineEvent.Start:
                    raise ProcessPipelineError.InvalidPipelineState if pipeline.state != ProcessPipelineState.Planned
                    for stage_offset in 0..<pipeline.stages.count |pipeline|:
                        pipeline.stage_states.push(ProcessPipelineStageState.Pending)
                        pipeline.stage_results.push(ProcessPipelineStageResult{})
                    pipeline.state <- ProcessPipelineState.Running
                elif event == ProcessPipelineEvent.StageStart:
                    raise ProcessPipelineError.InvalidStageIndex if stage_index >= pipeline.stages.count
                    raise ProcessPipelineError.InvalidStageState if pipeline.stage_states[stage_index] != ProcessPipelineStageState.Pending
                    raise ProcessPipelineError.InvalidPipelineState if pipeline.state != ProcessPipelineState.Running
                    pipeline.stage_states[stage_index] <- ProcessPipelineStageState.Running
                elif event == ProcessPipelineEvent.StageOutput:
                    raise ProcessPipelineError.InvalidStageIndex if stage_index >= pipeline.stages.count
                    raise ProcessPipelineError.InvalidStageState if pipeline.stage_states[stage_index] != ProcessPipelineStageState.Running
                    raise ProcessPipelineError.InvalidPipelineState if pipeline.state != ProcessPipelineState.Running and pipeline.state != ProcessPipelineState.Cancelling
                    raise ProcessPipelineError.InvalidChannel if not process_pipeline_stream_valid(stream)
                    raise ProcessPipelineError.InvalidReceipt if bytes == 0
                    raise ProcessPipelineError.OutputLimitExceeded if bytes > pipeline.buffer_limit_bytes - pipeline.stream_bytes
                    if stream == ProcessPipelineStream.Stdin:
                        pipeline.stage_results[stage_index].stdin_bytes <- pipeline.stage_results[stage_index].stdin_bytes + bytes
                    elif stream == ProcessPipelineStream.Stdout:
                        pipeline.stage_results[stage_index].stdout_bytes <- pipeline.stage_results[stage_index].stdout_bytes + bytes
                    else:
                        pipeline.stage_results[stage_index].stderr_bytes <- pipeline.stage_results[stage_index].stderr_bytes + bytes
                    pipeline.stream_bytes <- pipeline.stream_bytes + bytes
                elif event == ProcessPipelineEvent.StageExit:
                    raise ProcessPipelineError.InvalidStageIndex if stage_index >= pipeline.stages.count
                    raise ProcessPipelineError.InvalidStageState if pipeline.stage_states[stage_index] != ProcessPipelineStageState.Running
                    raise ProcessPipelineError.InvalidPipelineState if pipeline.state != ProcessPipelineState.Running and pipeline.state != ProcessPipelineState.Cancelling
                    try process_pipeline_stage_result_valid(receipt, ProcessPipelineEvent.StageExit, pipeline.stage_results[stage_index], false)
                    pipeline.stage_results[stage_index] <- receipt
                    pipeline.stage_states[stage_index] <- ProcessPipelineStageState.Exited
                    process_pipeline_refresh_accounting(pipeline)
                    if pipeline.completed_stages == pipeline.stages.count:
                        if pipeline.failed_stages != 0:
                            pipeline.state <- ProcessPipelineState.Failed
                        elif pipeline.state == ProcessPipelineState.Running:
                            pipeline.state <- ProcessPipelineState.Succeeded
                elif event == ProcessPipelineEvent.StageFailure:
                    raise ProcessPipelineError.InvalidStageIndex if stage_index >= pipeline.stages.count
                    # Pending means the adapter failed to launch this stage;
                    # Running means the launched process reported failure.
                    raise ProcessPipelineError.InvalidStageState if pipeline.stage_states[stage_index] != ProcessPipelineStageState.Pending and pipeline.stage_states[stage_index] != ProcessPipelineStageState.Running
                    raise ProcessPipelineError.InvalidPipelineState if pipeline.state != ProcessPipelineState.Running and pipeline.state != ProcessPipelineState.Cancelling
                    was_pending: bool = pipeline.stage_states[stage_index] == ProcessPipelineStageState.Pending
                    try process_pipeline_stage_result_valid(receipt, ProcessPipelineEvent.StageFailure, pipeline.stage_results[stage_index], was_pending)
                    pipeline.stage_results[stage_index] <- receipt
                    pipeline.stage_states[stage_index] <- ProcessPipelineStageState.Failed
                    # The failed stage is already counted as terminal.  Test
                    # against the total stage count so a two-stage pipeline
                    # enters cancellation draining when its first stage
                    # fails; `count - 1` would incorrectly leave it Running.
                    if pipeline.failure_mode == ProcessPipelineFailureMode.FailFast and pipeline.state == ProcessPipelineState.Running and pipeline.completed_stages < pipeline.stages.count:
                        pipeline.cancellation_requested <- true
                        pipeline.state <- ProcessPipelineState.Cancelling
                    process_pipeline_refresh_accounting(pipeline)
                    if pipeline.completed_stages == pipeline.stages.count:
                        pipeline.state <- ProcessPipelineState.Failed
                elif event == ProcessPipelineEvent.StageCancel:
                    raise ProcessPipelineError.InvalidStageIndex if stage_index >= pipeline.stages.count
                    raise ProcessPipelineError.InvalidStageState if pipeline.stage_states[stage_index] != ProcessPipelineStageState.Pending and pipeline.stage_states[stage_index] != ProcessPipelineStageState.Running
                    raise ProcessPipelineError.InvalidPipelineState if pipeline.state != ProcessPipelineState.Cancelling or not pipeline.cancellation_requested
                    try process_pipeline_stage_result_valid(receipt, ProcessPipelineEvent.StageCancel, pipeline.stage_results[stage_index], false)
                    pipeline.stage_results[stage_index] <- receipt
                    pipeline.stage_states[stage_index] <- ProcessPipelineStageState.Cancelled
                    process_pipeline_refresh_accounting(pipeline)
                    if pipeline.completed_stages == pipeline.stages.count and pipeline.failed_stages != 0:
                        pipeline.state <- ProcessPipelineState.Failed
                elif event == ProcessPipelineEvent.Cancel:
                    if pipeline.state == ProcessPipelineState.Planned:
                        pipeline.cancellation_requested <- true
                        for stage_offset in 0..<pipeline.stages.count |pipeline|:
                            pipeline.stage_states.push(ProcessPipelineStageState.Cancelled)
                            pipeline.stage_results.push(ProcessPipelineStageResult{published: true, result: ProcessResult{kind: ProcessResultKind.Cancelled}, stdin_closed: true, stdout_eof: true, stderr_eof: true})
                        process_pipeline_refresh_accounting(pipeline)
                        pipeline.state <- ProcessPipelineState.Cancelled
                    else:
                        raise ProcessPipelineError.InvalidPipelineState if pipeline.state != ProcessPipelineState.Running
                        pipeline.cancellation_requested <- true
                        pipeline.state <- ProcessPipelineState.Cancelling
                elif event == ProcessPipelineEvent.CancelAck:
                    raise ProcessPipelineError.InvalidPipelineState if pipeline.state != ProcessPipelineState.Cancelling
                    raise ProcessPipelineError.PipelineAccountingInvalid if not pipeline.cancellation_requested or pipeline.completed_stages != pipeline.stages.count or pipeline.failed_stages != 0
                    pipeline.state <- ProcessPipelineState.Cancelled
                return pipeline.state


            # Validate the outcome independently from command construction so a
            # host adapter cannot reinterpret a signal, timeout, or output
            # ceiling as an ordinary nonzero exit status.
            def validate_process_result(result: ProcessResult&) -> bool error[ProcessResultError]:
                raise ProcessResultError.InvalidOutcome if not process_result_kind_valid(result.kind)
                raise ProcessResultError.InvalidSignal if result.kind == ProcessResultKind.Signaled and result.signal == 0
                raise ProcessResultError.InvalidSignal if result.kind == ProcessResultKind.Signaled and result.signal > PROCESS_MAX_SIGNAL
                raise ProcessResultError.InvalidSignal if result.kind != ProcessResultKind.Signaled and result.signal != 0
                raise ProcessResultError.InvalidOutcome if result.kind == ProcessResultKind.Exited and result.exit_status < 0
                raise ProcessResultError.InvalidOutcome if result.kind != ProcessResultKind.Exited and result.exit_status != 0
                raise ProcessResultError.TextLimitExceeded if not process_command_text_length_valid(result.stdout) or not process_command_text_length_valid(result.stderr) or not process_command_text_length_valid(result.error_text)
                raise ProcessResultError.EmbeddedNul if process_command_text_has_nul(result.stdout) or process_command_text_has_nul(result.stderr) or process_command_text_has_nul(result.error_text)
                total: mutable usize = 0
                for value in [result.stdout, result.stderr, result.error_text] |result, total|:
                    raise ProcessResultError.AggregateTextLimitExceeded if not process_result_text_add_fits(total, value)
                    total <- total + sview_len(value) + 1
                return true


            # Advance a background job through one explicit supervision edge.
            # Retry never reuses a running child: terminal failure must first
            # return to Created, and Start consumes the next attempt.
            def advance_process_job(job: mutable ProcessJob&, event: ProcessJobEvent) -> ProcessJobState error[ProcessJobError]:
                raise ProcessJobError.InvalidState if not process_job_state_valid(job.state)
                raise ProcessJobError.InvalidEvent if not process_job_event_valid(event)
                raise ProcessJobError.InvalidAttemptLimit if job.max_attempts == 0 or job.max_attempts > PROCESS_COMMAND_MAX_ARGUMENTS
                raise ProcessJobError.RetryLimitExceeded if job.attempts > job.max_attempts
                raise ProcessJobError.InvalidState if process_job_state_requires_attempt(job.state) and job.attempts == 0
                raise ProcessJobError.RetryLimitExceeded if job.state == ProcessJobState.Created and job.attempts >= job.max_attempts
                if event == ProcessJobEvent.Start:
                    raise ProcessJobError.InvalidState if job.state != ProcessJobState.Created
                    raise ProcessJobError.RetryLimitExceeded if job.attempts >= job.max_attempts
                    job.attempts <- job.attempts + 1
                    job.state <- ProcessJobState.Running
                elif event == ProcessJobEvent.Complete:
                    raise ProcessJobError.InvalidState if job.state != ProcessJobState.Running
                    job.state <- ProcessJobState.Succeeded
                elif event == ProcessJobEvent.Fail:
                    raise ProcessJobError.InvalidState if job.state != ProcessJobState.Running
                    job.state <- ProcessJobState.Failed
                elif event == ProcessJobEvent.Timeout:
                    raise ProcessJobError.InvalidState if job.state != ProcessJobState.Running
                    job.state <- ProcessJobState.TimedOut
                elif event == ProcessJobEvent.Cancel:
                    raise ProcessJobError.InvalidState if job.state != ProcessJobState.Running
                    job.state <- ProcessJobState.Cancelling
                elif event == ProcessJobEvent.CancelAck:
                    raise ProcessJobError.InvalidState if job.state != ProcessJobState.Cancelling
                    job.state <- ProcessJobState.Cancelled
                elif event == ProcessJobEvent.Retry:
                    raise ProcessJobError.InvalidState if job.state != ProcessJobState.Failed and job.state != ProcessJobState.TimedOut
                    raise ProcessJobError.RetryLimitExceeded if job.attempts >= job.max_attempts
                    job.state <- ProcessJobState.Created
                return job.state
