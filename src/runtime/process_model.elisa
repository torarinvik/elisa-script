# Typed, shell-free process command values.
#
# This model is deliberately independent of fork/exec. It gives the language
# and higher-level adapters one validated command shape before a host bridge
# chooses POSIX, Windows, or a deterministic test backend. Arguments and
# environment entries remain separate values; no shell grammar is involved.

module EsProcess:
    public:
        const PROCESS_COMMAND_MAX_ARGUMENTS: usize = 1048576
        const PROCESS_COMMAND_MAX_TEXT_BYTES: usize = 67108864


        const enum ProcessStdioMode of u8:
            Inherit
            Capture
            Null
            File


        const enum ProcessEnvironmentMode of u8:
            Inherit
            Replace
            Clear


        const enum ProcessFailureMode of u8:
            Check
            Allow


        const enum ProcessResultKind of u8:
            Exited
            Signaled
            SpawnFailure
            TimedOut
            Cancelled
            OutputLimit
            HostIoFailure


        struct ProcessResult:
            kind: ProcessResultKind = ProcessResultKind.Exited
            exit_status: i64 = 0
            signal: u32 = 0
            stdout: sview = ""
            stderr: sview = ""
            error_text: sview = ""


        const enum ProcessJobState of u8:
            Created
            Running
            Cancelling
            Succeeded
            Failed
            TimedOut
            Cancelled


        const enum ProcessJobEvent of u8:
            Start
            Complete
            Fail
            Timeout
            Cancel
            CancelAck
            Retry


        struct ProcessJob:
            state: ProcessJobState = ProcessJobState.Created
            attempts: usize = 0
            max_attempts: usize = 1


        # Environment entries are an alternating name/value vector. Keeping
        # the representation flat makes duplicate-name checks deterministic
        # and lets host adapters preserve insertion order without a map-order
        # promise. The validator requires an even number of entries.
        struct ProcessCommand:
            executable: sview
            arguments: darray[sview] = []
            working_directory: sview = ""
            environment: darray[sview] = []
            environment_mode: ProcessEnvironmentMode = ProcessEnvironmentMode.Inherit
            stdin_mode: ProcessStdioMode = ProcessStdioMode.Inherit
            stdout_mode: ProcessStdioMode = ProcessStdioMode.Capture
            stderr_mode: ProcessStdioMode = ProcessStdioMode.Capture
            stdin_path: sview = ""
            stdout_path: sview = ""
            stderr_path: sview = ""
            timeout_micros: u64 = 0
            failure_mode: ProcessFailureMode = ProcessFailureMode.Check


        error ProcessCommandError:
            EmptyExecutable
            EmbeddedNul
            TextLimitExceeded
            ArgumentCountExceeded
            ArgumentVectorMalformed
            InvalidWorkingDirectory
            EnvironmentVectorMalformed
            EnvironmentNameInvalid
            DuplicateEnvironmentName
            InvalidEnvironmentMode
            InvalidStdioMode
            InvalidStdioPath
            StdioPathEmbeddedNul
            InvalidFailureMode


        error ProcessResultError:
            InvalidOutcome
            InvalidSignal
            TextLimitExceeded
            EmbeddedNul
            AggregateTextLimitExceeded


        error ProcessJobError:
            InvalidState
            InvalidEvent
            InvalidAttemptLimit
            RetryLimitExceeded


        private:
            def process_job_state_valid(state: ProcessJobState) -> bool:
                return state in {ProcessJobState.Created, ProcessJobState.Running, ProcessJobState.Cancelling, ProcessJobState.Succeeded, ProcessJobState.Failed, ProcessJobState.TimedOut, ProcessJobState.Cancelled}


            def process_job_event_valid(event: ProcessJobEvent) -> bool:
                return event in {ProcessJobEvent.Start, ProcessJobEvent.Complete, ProcessJobEvent.Fail, ProcessJobEvent.Timeout, ProcessJobEvent.Cancel, ProcessJobEvent.CancelAck, ProcessJobEvent.Retry}


            def process_result_kind_valid(kind: ProcessResultKind) -> bool:
                return kind in {ProcessResultKind.Exited, ProcessResultKind.Signaled, ProcessResultKind.SpawnFailure, ProcessResultKind.TimedOut, ProcessResultKind.Cancelled, ProcessResultKind.OutputLimit, ProcessResultKind.HostIoFailure}


            def process_result_text_add_fits(total: usize, value: sview) -> bool:
                return false if total > PROCESS_COMMAND_MAX_TEXT_BYTES
                return false if sview_len(value) >= PROCESS_COMMAND_MAX_TEXT_BYTES - total
                return true


            def process_command_text_length_valid(value: sview) -> bool:
                return sview_len(value) < PROCESS_COMMAND_MAX_TEXT_BYTES


            def process_command_text_add_fits(total: usize, value: sview) -> bool:
                return false if total > PROCESS_COMMAND_MAX_TEXT_BYTES
                # Every host C-string copy needs one terminator byte.
                return false if sview_len(value) >= PROCESS_COMMAND_MAX_TEXT_BYTES - total
                return true


            def process_command_stdio_mode_valid(mode: ProcessStdioMode) -> bool:
                return mode in {ProcessStdioMode.Inherit, ProcessStdioMode.Capture, ProcessStdioMode.Null, ProcessStdioMode.File}


            def process_command_environment_mode_valid(mode: ProcessEnvironmentMode) -> bool:
                return mode in {ProcessEnvironmentMode.Inherit, ProcessEnvironmentMode.Replace, ProcessEnvironmentMode.Clear}


            def process_command_failure_mode_valid(mode: ProcessFailureMode) -> bool:
                return mode in {ProcessFailureMode.Check, ProcessFailureMode.Allow}


            def process_command_environment_name_valid(name: sview) -> bool:
                return sview_len(name) != 0 and process_command_text_length_valid(name) and not sview_contains_byte(name, 0) and not sview_contains_byte(name, 61)


            def process_command_text_has_nul(value: sview) -> bool:
                return sview_contains_byte(value, 0)


            def process_command_stdio_path_valid(mode: ProcessStdioMode, path: sview) -> bool:
                return path != "" if mode == ProcessStdioMode.File else path == ""


        public:
            # Validate all data that a host process adapter would copy or use
            # as policy. This is intentionally an error[...] boundary rather
            # than a Result-shaped value so callers cannot ignore malformed
            # command construction accidentally.
            def validate_process_command(command: ProcessCommand&) -> bool error[ProcessCommandError]:
                raise ProcessCommandError.EmptyExecutable if sview_len(command.executable) == 0
                raise ProcessCommandError.TextLimitExceeded if not process_command_text_length_valid(command.executable)
                raise ProcessCommandError.EmbeddedNul if process_command_text_has_nul(command.executable)
                raise ProcessCommandError.ArgumentCountExceeded if command.arguments.count > PROCESS_COMMAND_MAX_ARGUMENTS
                raise ProcessCommandError.ArgumentVectorMalformed if command.environment.count % 2 != 0
                raise ProcessCommandError.InvalidWorkingDirectory if command.working_directory != "" and not process_command_text_length_valid(command.working_directory)
                raise ProcessCommandError.EmbeddedNul if command.working_directory != "" and process_command_text_has_nul(command.working_directory)
                raise ProcessCommandError.InvalidEnvironmentMode if not process_command_environment_mode_valid(command.environment_mode)
                raise ProcessCommandError.InvalidStdioMode if not process_command_stdio_mode_valid(command.stdin_mode) or not process_command_stdio_mode_valid(command.stdout_mode) or not process_command_stdio_mode_valid(command.stderr_mode)
                raise ProcessCommandError.InvalidStdioPath if not process_command_stdio_path_valid(command.stdin_mode, command.stdin_path) or not process_command_stdio_path_valid(command.stdout_mode, command.stdout_path) or not process_command_stdio_path_valid(command.stderr_mode, command.stderr_path)
                raise ProcessCommandError.TextLimitExceeded if command.stdin_path != "" and not process_command_text_length_valid(command.stdin_path)
                raise ProcessCommandError.TextLimitExceeded if command.stdout_path != "" and not process_command_text_length_valid(command.stdout_path)
                raise ProcessCommandError.TextLimitExceeded if command.stderr_path != "" and not process_command_text_length_valid(command.stderr_path)
                raise ProcessCommandError.StdioPathEmbeddedNul if command.stdin_path != "" and process_command_text_has_nul(command.stdin_path)
                raise ProcessCommandError.StdioPathEmbeddedNul if command.stdout_path != "" and process_command_text_has_nul(command.stdout_path)
                raise ProcessCommandError.StdioPathEmbeddedNul if command.stderr_path != "" and process_command_text_has_nul(command.stderr_path)
                raise ProcessCommandError.InvalidFailureMode if not process_command_failure_mode_valid(command.failure_mode)

                total: mutable usize = 0
                raise ProcessCommandError.ArgumentVectorMalformed if not process_command_text_add_fits(total, command.executable)
                total <- total + sview_len(command.executable) + 1
                for argument in command.arguments |command, total|:
                    raise ProcessCommandError.TextLimitExceeded if not process_command_text_length_valid(argument)
                    raise ProcessCommandError.EmbeddedNul if process_command_text_has_nul(argument)
                    raise ProcessCommandError.ArgumentVectorMalformed if not process_command_text_add_fits(total, argument)
                    total <- total + sview_len(argument) + 1

                for offset in 0..<command.environment.count |command, total|:
                    entry: sview = command.environment[offset]
                    raise ProcessCommandError.TextLimitExceeded if not process_command_text_length_valid(entry)
                    raise ProcessCommandError.EmbeddedNul if process_command_text_has_nul(entry)
                    if offset % 2 == 0:
                        raise ProcessCommandError.EnvironmentNameInvalid if not process_command_environment_name_valid(entry)
                        for earlier in 0..<offset |command, entry|:
                            raise ProcessCommandError.DuplicateEnvironmentName if earlier % 2 == 0 and command.environment[earlier] == entry
                    raise ProcessCommandError.EnvironmentVectorMalformed if not process_command_text_add_fits(total, entry)
                    total <- total + sview_len(entry) + 1
                for path in [command.stdin_path, command.stdout_path, command.stderr_path] |command, total|:
                    if path != "":
                        raise ProcessCommandError.ArgumentVectorMalformed if not process_command_text_add_fits(total, path)
                        total <- total + sview_len(path) + 1
                return true


            # Validate the outcome independently from command construction so a
            # host adapter cannot reinterpret a signal, timeout, or output
            # ceiling as an ordinary nonzero exit status.
            def validate_process_result(result: ProcessResult&) -> bool error[ProcessResultError]:
                raise ProcessResultError.InvalidOutcome if not process_result_kind_valid(result.kind)
                raise ProcessResultError.InvalidSignal if result.kind == ProcessResultKind.Signaled and result.signal == 0
                raise ProcessResultError.InvalidSignal if result.kind != ProcessResultKind.Signaled and result.signal != 0
                raise ProcessResultError.TextLimitExceeded if not process_command_text_length_valid(result.stdout) or not process_command_text_length_valid(result.stderr) or not process_command_text_length_valid(result.error_text)
                raise ProcessResultError.EmbeddedNul if process_command_text_has_nul(result.stdout) or process_command_text_has_nul(result.stderr) or process_command_text_has_nul(result.error_text)
                total: mutable usize = 0
                for value in [result.stdout, result.stderr, result.error_text] |result, total|:
                    raise ProcessResultError.AggregateTextLimitExceeded if not process_result_text_add_fits(total, value)
                    total <- total + sview_len(value) + 1
                return true


            # Advance a background job through one explicit supervision edge.
            # Retry never reuses a running child: terminal failure must first
            # return to Created, and Start consumes the next attempt.
            def advance_process_job(job: mutable ProcessJob&, event: ProcessJobEvent) -> ProcessJobState error[ProcessJobError]:
                raise ProcessJobError.InvalidState if not process_job_state_valid(job.state)
                raise ProcessJobError.InvalidEvent if not process_job_event_valid(event)
                raise ProcessJobError.InvalidAttemptLimit if job.max_attempts == 0 or job.max_attempts > PROCESS_COMMAND_MAX_ARGUMENTS
                if event == ProcessJobEvent.Start:
                    raise ProcessJobError.InvalidState if job.state != ProcessJobState.Created
                    raise ProcessJobError.RetryLimitExceeded if job.attempts >= job.max_attempts
                    job.attempts <- job.attempts + 1
                    job.state <- ProcessJobState.Running
                elif event == ProcessJobEvent.Complete:
                    raise ProcessJobError.InvalidState if job.state != ProcessJobState.Running
                    job.state <- ProcessJobState.Succeeded
                elif event == ProcessJobEvent.Fail:
                    raise ProcessJobError.InvalidState if job.state != ProcessJobState.Running
                    job.state <- ProcessJobState.Failed
                elif event == ProcessJobEvent.Timeout:
                    raise ProcessJobError.InvalidState if job.state != ProcessJobState.Running
                    job.state <- ProcessJobState.TimedOut
                elif event == ProcessJobEvent.Cancel:
                    raise ProcessJobError.InvalidState if job.state != ProcessJobState.Running
                    job.state <- ProcessJobState.Cancelling
                elif event == ProcessJobEvent.CancelAck:
                    raise ProcessJobError.InvalidState if job.state != ProcessJobState.Cancelling
                    job.state <- ProcessJobState.Cancelled
                elif event == ProcessJobEvent.Retry:
                    raise ProcessJobError.InvalidState if job.state != ProcessJobState.Failed and job.state != ProcessJobState.TimedOut
                    raise ProcessJobError.RetryLimitExceeded if job.attempts >= job.max_attempts
                    job.state <- ProcessJobState.Created
                return job.state
