# Bounded parser for pkg-config's shell-escaped flag output.
#
# This recognizes only word quoting and escaping. It never expands variables,
# executes substitutions, or invokes a shell; parsed arguments remain data for
# explicit ProcessCommand construction by a build host.

module EsPkgConfigWords:
    public:
        const module Limits:
            OUTPUT_BYTES: usize = 1048576
            WORDS: usize = 65536
            WORD_BYTES: usize = 65536


        struct PkgConfigWords:
            values: darray[darray[u8]] = []


        error PkgConfigWordsError:
            OutputLimitExceeded
            WordLimitExceeded
            WordSizeLimitExceeded
            InvalidWordOutput


    private:
        const enum WordState of u8:
            Unquoted
            SingleQuoted
            DoubleQuoted


        def pkg_config_word_space(byte: u8) -> bool:
            return byte == 32 or byte == 9 or byte == 10 or byte == 13 or byte == 11 or byte == 12


        def pkg_config_word_append(word: mutable darray[u8]&, byte: u8) -> void error[PkgConfigWordsError] can[Memory.Allocate, Abort.Panic]:
            raise PkgConfigWordsError.WordSizeLimitExceeded if word.count >= Limits::WORD_BYTES
            word.push(byte)


        def pkg_config_finish_word(words: mutable darray[darray[u8]]&, word: mutable darray[u8]&, active: mutable bool&) -> void error[PkgConfigWordsError] can[Memory.Allocate, Abort.Panic]:
            return if not active
            raise PkgConfigWordsError.WordLimitExceeded if words.count >= Limits::WORDS
            words.push(word)
            word <- []
            active <- false


    public:
        # Tokenize only quoting/escaping in pkg-config output. Metacharacters
        # are inert bytes, and unmatched quotes/trailing escapes fail closed.
        def pkg_config_parse_words(output: sview) -> PkgConfigWords error[PkgConfigWordsError] can[Memory.Allocate, Abort.Panic]:
            length: usize = sview_len(output)
            raise PkgConfigWordsError.OutputLimitExceeded if length > Limits::OUTPUT_BYTES
            words: mutable darray[darray[u8]] = []
            word: mutable darray[u8] = []
            state: mutable WordState = WordState.Unquoted
            active: mutable bool = false
            cursor: mutable usize = 0
            while cursor < length |output, words, word, state, active, cursor|:
                byte: u8 = sview_at(output, cursor)
                raise PkgConfigWordsError.InvalidWordOutput if byte == 0
                if state == WordState.SingleQuoted:
                    if byte == 39:
                        state <- WordState.Unquoted
                    else:
                        try pkg_config_word_append(word, byte)
                    cursor <- cursor + 1
                elif state == WordState.DoubleQuoted:
                    if byte == 34:
                        state <- WordState.Unquoted
                        cursor <- cursor + 1
                    elif byte == 92:
                        raise PkgConfigWordsError.InvalidWordOutput if cursor + 1 >= length
                        escaped: u8 = sview_at(output, cursor + 1)
                        raise PkgConfigWordsError.InvalidWordOutput if escaped == 0
                        if escaped == 34 or escaped == 92 or escaped == 36 or escaped == 96:
                            try pkg_config_word_append(word, escaped)
                        elif escaped == 10:
                            _ = escaped
                        else:
                            try pkg_config_word_append(word, 92)
                            try pkg_config_word_append(word, escaped)
                        cursor <- cursor + 2
                    else:
                        try pkg_config_word_append(word, byte)
                        cursor <- cursor + 1
                else:
                    if pkg_config_word_space(byte):
                        try pkg_config_finish_word(words, word, active)
                        cursor <- cursor + 1
                    elif byte == 39:
                        state <- WordState.SingleQuoted
                        active <- true
                        cursor <- cursor + 1
                    elif byte == 34:
                        state <- WordState.DoubleQuoted
                        active <- true
                        cursor <- cursor + 1
                    elif byte == 92:
                        raise PkgConfigWordsError.InvalidWordOutput if cursor + 1 >= length
                        escaped: u8 = sview_at(output, cursor + 1)
                        raise PkgConfigWordsError.InvalidWordOutput if escaped == 0
                        active <- true
                        if escaped != 10:
                            try pkg_config_word_append(word, escaped)
                        cursor <- cursor + 2
                    else:
                        active <- true
                        try pkg_config_word_append(word, byte)
                        cursor <- cursor + 1
            raise PkgConfigWordsError.InvalidWordOutput if state != WordState.Unquoted
            try pkg_config_finish_word(words, word, active)
            return PkgConfigWords{values: words}


        def pkg_config_word_matches(words: PkgConfigWords, index: usize, expected: sview) -> bool:
            return false if index >= words.values.count
            value: darray[u8] = words.values[index]
            return false if value.count != sview_len(expected)
            for offset in 0..<value.count |value, expected|:
                return false if value[offset] != sview_at(expected, offset)
            return true
