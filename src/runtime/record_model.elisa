# Typed, bounded record and field-stream contracts for Perl/AWK-style tools.
#
# This module describes scanner policy and record metadata without choosing a
# particular regex engine, file adapter, or aggregation implementation. Host
# adapters must validate it before allocating a record buffer or walking fields.

module EsRecord:
    public:
        const RECORD_MAX_TEXT_BYTES: usize = 67108864
        const RECORD_MAX_FIELDS: usize = 1048576


        const enum RecordSeparatorMode of u8:
            Line
            Literal
            Regex
            Paragraph


        const enum RecordFieldMode of u8:
            Whole
            Whitespace
            Literal
            Regex
            FixedWidth
            Schema


        struct RecordStreamPolicy:
            separator_mode: RecordSeparatorMode = RecordSeparatorMode.Line
            separator: sview = ""
            field_mode: RecordFieldMode = RecordFieldMode.Whole
            field_separator: sview = ""
            fixed_widths: darray[usize] = []
            schema_name: sview = ""
            preserve_separator: bool = false
            output_separator: sview = "\n"
            max_record_bytes: usize = RECORD_MAX_TEXT_BYTES - 1
            max_fields: usize = RECORD_MAX_FIELDS


        struct Record:
            source: sview
            filename: sview = ""
            record_number: u64 = 1
            file_record_number: u64 = 1
            byte_offset: u64 = 0
            raw: sview = ""
            separator: sview = ""


        struct RecordField:
            index: usize
            start_byte: usize
            end_byte: usize
            value: sview
            present: bool = true


        error RecordContractError:
            MissingSource
            EmbeddedNul
            TextLimitExceeded
            InvalidSeparatorMode
            InvalidSeparator
            InvalidFieldMode
            InvalidFieldSeparator
            FixedWidthMalformed
            FixedWidthOverflow
            SchemaMissing
            InvalidRecordLimit
            InvalidFieldLimit
            InvalidRecordNumber
            InvalidFieldRange


    private:
        def record_separator_mode_valid(mode: RecordSeparatorMode) -> bool:
            return mode in {RecordSeparatorMode.Line, RecordSeparatorMode.Literal, RecordSeparatorMode.Regex, RecordSeparatorMode.Paragraph}


        def record_field_mode_valid(mode: RecordFieldMode) -> bool:
            return mode in {RecordFieldMode.Whole, RecordFieldMode.Whitespace, RecordFieldMode.Literal, RecordFieldMode.Regex, RecordFieldMode.FixedWidth, RecordFieldMode.Schema}


        def record_text_length_valid(value: sview) -> bool:
            return sview_len(value) < RECORD_MAX_TEXT_BYTES


        def record_text_valid(value: sview) -> bool:
            return record_text_length_valid(value) and not sview_contains_byte(value, 0)


        def record_fixed_widths_fit(widths: darray[usize], max_fields: usize) -> bool error[RecordContractError]:
            raise RecordContractError.FixedWidthMalformed if widths.count == 0 or widths.count > max_fields
            total: mutable usize = 0
            for width in widths:
                raise RecordContractError.FixedWidthMalformed if width == 0
                raise RecordContractError.FixedWidthOverflow if total > RECORD_MAX_TEXT_BYTES - width
                total <- total + width
            return true


        public:
            # Policy admission is intentionally separate from scanner execution:
            # malformed separator/field choices must fail before a host adapter
            # allocates a record or starts a regex walk.
            def validate_record_stream_policy(policy: RecordStreamPolicy&) -> bool error[RecordContractError]:
                raise RecordContractError.InvalidRecordLimit if policy.max_record_bytes == 0 or policy.max_record_bytes >= RECORD_MAX_TEXT_BYTES
                raise RecordContractError.InvalidFieldLimit if policy.max_fields == 0 or policy.max_fields > RECORD_MAX_FIELDS
                raise RecordContractError.InvalidSeparatorMode if not record_separator_mode_valid(policy.separator_mode)
                raise RecordContractError.InvalidFieldMode if not record_field_mode_valid(policy.field_mode)
                raise RecordContractError.TextLimitExceeded if not record_text_length_valid(policy.separator) or not record_text_length_valid(policy.field_separator) or not record_text_length_valid(policy.schema_name) or not record_text_length_valid(policy.output_separator)
                raise RecordContractError.EmbeddedNul if not record_text_valid(policy.separator) or not record_text_valid(policy.field_separator) or not record_text_valid(policy.schema_name) or not record_text_valid(policy.output_separator)
                if policy.separator_mode in {RecordSeparatorMode.Literal, RecordSeparatorMode.Regex}:
                    raise RecordContractError.InvalidSeparator if policy.separator == ""
                else:
                    raise RecordContractError.InvalidSeparator if policy.separator != ""
                if policy.field_mode in {RecordFieldMode.Literal, RecordFieldMode.Regex}:
                    raise RecordContractError.InvalidFieldSeparator if policy.field_separator == ""
                else:
                    raise RecordContractError.InvalidFieldSeparator if policy.field_separator != ""
                if policy.field_mode == RecordFieldMode.FixedWidth:
                    try record_fixed_widths_fit(policy.fixed_widths, policy.max_fields)
                else:
                    raise RecordContractError.FixedWidthMalformed if policy.fixed_widths.count != 0
                raise RecordContractError.SchemaMissing if policy.field_mode == RecordFieldMode.Schema and policy.schema_name == ""
                raise RecordContractError.InvalidFieldSeparator if policy.field_mode != RecordFieldMode.Schema and policy.schema_name != ""
                return true


            def validate_record(record: Record&, policy: RecordStreamPolicy&) -> bool error[RecordContractError]:
                raise RecordContractError.MissingSource if record.source == ""
                raise RecordContractError.TextLimitExceeded if not record_text_length_valid(record.source) or not record_text_length_valid(record.filename) or not record_text_length_valid(record.raw) or not record_text_length_valid(record.separator)
                raise RecordContractError.EmbeddedNul if not record_text_valid(record.source) or not record_text_valid(record.filename) or not record_text_valid(record.raw) or not record_text_valid(record.separator)
                raise RecordContractError.InvalidRecordNumber if record.record_number == 0 or record.file_record_number == 0
                raise RecordContractError.InvalidSeparator if record.separator != "" and policy.separator_mode in {RecordSeparatorMode.Line, RecordSeparatorMode.Paragraph}
                raise RecordContractError.InvalidFieldRange if record.raw != "" and sview_len(record.raw) > policy.max_record_bytes
                return true


            def validate_record_field(field: RecordField&, record: Record&, policy: RecordStreamPolicy&) -> bool error[RecordContractError]:
                raise RecordContractError.InvalidFieldRange if field.index >= policy.max_fields
                raise RecordContractError.InvalidFieldRange if field.start_byte > field.end_byte or field.end_byte > sview_len(record.raw)
                raise RecordContractError.TextLimitExceeded if not record_text_length_valid(field.value)
                raise RecordContractError.EmbeddedNul if not record_text_valid(field.value)
                raise RecordContractError.InvalidFieldRange if field.value != record.raw[field.start_byte:field.end_byte]
                return true
