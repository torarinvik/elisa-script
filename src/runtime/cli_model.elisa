# Typed launcher argument contract.
#
# The launcher parses host argv once, before source loading. Script arguments are
# never reinterpreted as launcher options after the source path or `--` boundary.

module EsCli:
    public:
        const CLI_MAX_ARGUMENTS: usize = 1048576
        const CLI_MAX_TEXT_BYTES: usize = 67108864
        const CLI_MAX_SOURCE_PATH_BYTES: usize = 4096


        const enum CliMode of u8:
            Run
            Check
            Test
            Fmt
            Doc
            Version
            Help


        const enum CliColorMode of u8:
            Auto
            Always
            Never


        struct CliInvocation:
            mode: CliMode = CliMode.Run
            source_path: sview = ""
            script_arguments: darray[sview] = []
            color: CliColorMode = CliColorMode.Auto
            strict_engine: bool = false
            option_end_seen: bool = false


        error CliContractError:
            InvalidMode
            InvalidColorMode
            UnknownOption
            MissingOptionValue
            DuplicateMode
            DuplicateOption
            MissingSource
            UnexpectedArgument
            ArgumentLimitExceeded
            TextLimitExceeded
            SourcePathLimitExceeded
            EmbeddedNul


    private:
        def cli_mode_valid(mode: CliMode) -> bool:
            return mode in {CliMode.Run, CliMode.Check, CliMode.Test, CliMode.Fmt, CliMode.Doc, CliMode.Version, CliMode.Help}


        def cli_color_valid(color: CliColorMode) -> bool:
            return color in {CliColorMode.Auto, CliColorMode.Always, CliColorMode.Never}


        def cli_text_valid(value: sview) -> bool:
            return sview_len(value) < CLI_MAX_TEXT_BYTES and not sview_contains_byte(value, 0)


        def cli_mode_requires_source(mode: CliMode) -> bool:
            return mode in {CliMode.Run, CliMode.Check, CliMode.Test, CliMode.Fmt, CliMode.Doc}


        def cli_mode_from_argument(value: sview) -> CliMode error[CliContractError]:
            return CliMode.Run if value == "--run"
            return CliMode.Check if value == "--check"
            return CliMode.Test if value == "--test"
            return CliMode.Fmt if value == "--fmt"
            return CliMode.Doc if value == "--doc"
            return CliMode.Version if value == "--version" or value == "-V"
            return CliMode.Help if value == "--help" or value == "-h"
            raise CliContractError.UnknownOption


        def cli_set_mode(invocation: mutable CliInvocation&, mode: CliMode, selected: mutable bool&) -> bool error[CliContractError]:
            raise CliContractError.DuplicateMode if selected
            invocation.mode <- mode
            selected <- true
            return true


    public:
        def validate_cli_invocation(invocation: CliInvocation&) -> bool error[CliContractError]:
            raise CliContractError.InvalidMode if not cli_mode_valid(invocation.mode)
            raise CliContractError.InvalidColorMode if not cli_color_valid(invocation.color)
            raise CliContractError.MissingSource if cli_mode_requires_source(invocation.mode) and invocation.source_path == ""
            raise CliContractError.UnexpectedArgument if not cli_mode_requires_source(invocation.mode) and (invocation.source_path != "" or invocation.script_arguments.count != 0)
            raise CliContractError.SourcePathLimitExceeded if invocation.source_path != "" and sview_len(invocation.source_path) >= CLI_MAX_SOURCE_PATH_BYTES
            raise CliContractError.EmbeddedNul if invocation.source_path != "" and sview_contains_byte(invocation.source_path, 0)
            raise CliContractError.ArgumentLimitExceeded if invocation.script_arguments.count > CLI_MAX_ARGUMENTS
            for argument in invocation.script_arguments:
                raise CliContractError.TextLimitExceeded if not cli_text_valid(argument)
                raise CliContractError.EmbeddedNul if sview_contains_byte(argument, 0)
            return true


        def parse_cli_arguments(arguments: darray[sview]) -> CliInvocation error[CliContractError]:
            invocation: mutable CliInvocation = CliInvocation{}
            mode_selected: mutable bool = false
            color_selected: mutable bool = false
            options: mutable bool = true
            index: mutable usize = 0
            while options:
                break if index >= arguments.count
                argument: sview = arguments[index]
                if argument == "--":
                    invocation.option_end_seen <- true
                    index <- index + 1
                    options <- false
                    # `--` terminates launcher options, but it does not make
                    # the source path disappear.  When the source has not
                    # been selected yet, consume the first post-boundary
                    # token as the source and preserve the remainder as
                    # script arguments.  Non-source modes intentionally do
                    # not consume it; validation then reports the extra
                    # argument instead of silently accepting it.
                    if index < arguments.count and cli_mode_requires_source(invocation.mode):
                        invocation.source_path <- arguments[index]
                        index <- index + 1
                elif argument == "--strict-engine":
                    raise CliContractError.DuplicateOption if invocation.strict_engine
                    invocation.strict_engine <- true
                    index <- index + 1
                elif argument == "--color":
                    raise CliContractError.MissingOptionValue if index + 1 >= arguments.count
                    raise CliContractError.DuplicateOption if color_selected
                    color_value: sview = arguments[index + 1]
                    invocation.color <- CliColorMode.Auto if color_value == "auto" else CliColorMode.Always if color_value == "always" else CliColorMode.Never if color_value == "never" else raise CliContractError.InvalidColorMode
                    color_selected <- true
                    index <- index + 2
                elif argument == "--run" or argument == "--check" or argument == "--test" or argument == "--fmt" or argument == "--doc" or argument == "--version" or argument == "-V" or argument == "--help" or argument == "-h":
                    selected_mode: CliMode = try cli_mode_from_argument(argument)
                    try cli_set_mode(invocation, selected_mode, mode_selected)
                    index <- index + 1
                elif argument != "" and sview_at(argument, 0) == 45:
                    raise CliContractError.UnknownOption
                else:
                    invocation.source_path <- argument
                    index <- index + 1
                    options <- false
            while index < arguments.count:
                raise CliContractError.ArgumentLimitExceeded if invocation.script_arguments.count >= CLI_MAX_ARGUMENTS
                invocation.script_arguments.push(arguments[index])
                index <- index + 1
            try validate_cli_invocation(invocation)
            return invocation
