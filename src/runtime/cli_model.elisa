# Typed launcher argument contract.
#
# The launcher parses host argv once, before source loading. Script arguments are
# never reinterpreted as launcher options after the source path or `--` boundary.

module EsCli:
    public:
        const module Limits:
            ARGUMENTS: usize = 1048576
            TEXT_BYTES: usize = 67108864
            SOURCE_PATH_BYTES: usize = 4096
            TEST_SELECTIONS: usize = 4096
            TEST_NAME_BYTES: usize = 4096


        const enum CliMode of u8:
            Run
            Check
            Test
            Fmt
            Doc
            Version
            Help


        const enum CliColorMode of u8:
            Auto
            Always
            Never


        const enum CliReportFormat of u8:
            Human
            Json
            Junit


        struct CliInvocation:
            mode: mutable CliMode = CliMode.Run
            source_path: mutable sview = ""
            script_arguments: mutable darray[sview] = []
            test_selection: mutable darray[sview] = []
            color: mutable CliColorMode = CliColorMode.Auto
            report_format: mutable CliReportFormat = CliReportFormat.Human
            strict_engine: mutable bool = false
            option_end_seen: mutable bool = false


        error CliContractError:
            InvalidMode
            InvalidColorMode
            UnknownOption
            MissingOptionValue
            DuplicateMode
            DuplicateOption
            MissingSource
            UnexpectedArgument
            TestArgumentsUnsupported
            InvalidSourceExtension
            ArgumentLimitExceeded
            TextLimitExceeded
            SourcePathLimitExceeded
            EmbeddedNul
            InvalidReportFormat
            ReportFormatUnavailable
            ColorNotApplicable
            TestSelectionUnavailable
            TestSelectionLimitExceeded
            TestSelectionInvalid
            DuplicateTestSelection


    private:
        def cli_mode_valid(mode: CliMode) -> bool:
            return mode in {CliMode.Run, CliMode.Check, CliMode.Test, CliMode.Fmt, CliMode.Doc, CliMode.Version, CliMode.Help}


        def cli_color_valid(color: CliColorMode) -> bool:
            return color in {CliColorMode.Auto, CliColorMode.Always, CliColorMode.Never}


        def cli_report_format_valid(format: CliReportFormat) -> bool:
            return format in {CliReportFormat.Human, CliReportFormat.Json, CliReportFormat.Junit}


        def cli_text_valid(value: sview) -> bool:
            return sview_len(value) < Limits::TEXT_BYTES and not sview_contains_byte(value, 0)


        def cli_mode_requires_source(mode: CliMode) -> bool:
            return mode in {CliMode.Run, CliMode.Check, CliMode.Test, CliMode.Fmt, CliMode.Doc}


        def cli_mode_from_argument(value: sview) -> CliMode error[CliContractError]:
            return CliMode.Run if value == "--run"
            return CliMode.Check if value == "--check"
            return CliMode.Test if value == "--test"
            return CliMode.Fmt if value == "--fmt"
            return CliMode.Doc if value == "--doc"
            return CliMode.Version if value == "--version" or value == "-V"
            return CliMode.Help if value == "--help" or value == "-h"
            raise CliContractError.UnknownOption


        def cli_report_format_from_argument(value: sview) -> CliReportFormat error[CliContractError]:
            return CliReportFormat.Human if value == "human"
            return CliReportFormat.Json if value == "json"
            return CliReportFormat.Junit if value == "junit"
            raise CliContractError.InvalidReportFormat


        def cli_set_mode(invocation: mutable CliInvocation&, mode: CliMode, selected: mutable bool&) -> bool error[CliContractError]:
            raise CliContractError.DuplicateMode if selected[0]
            invocation.mode <- mode
            selected <- true
            return true


    public:
        def validate_cli_invocation(invocation: CliInvocation&) -> bool error[CliContractError]:
            raise CliContractError.InvalidMode if not cli_mode_valid(invocation.mode)
            raise CliContractError.InvalidColorMode if not cli_color_valid(invocation.color)
            raise CliContractError.InvalidReportFormat if not cli_report_format_valid(invocation.report_format)
            raise CliContractError.MissingSource if cli_mode_requires_source(invocation.mode) and invocation.source_path == ""
            raise CliContractError.UnexpectedArgument if not cli_mode_requires_source(invocation.mode) and (invocation.source_path != "" or invocation.script_arguments.count != 0)
            # The in-process test runner executes discovered zero-argument
            # functions and accepts only explicit exact-name selection options.
            # Reject positional values after a test source instead of silently
            # discarding them at driver routing.
            raise CliContractError.TestArgumentsUnsupported if invocation.mode == CliMode.Test and invocation.script_arguments.count != 0
            raise CliContractError.TestSelectionUnavailable if invocation.test_selection.count != 0 and invocation.mode != CliMode.Test
            raise CliContractError.TestSelectionLimitExceeded if invocation.test_selection.count > Limits::TEST_SELECTIONS
            for index in 0..<invocation.test_selection.count |invocation|:
                selection: sview = invocation.test_selection[index]
                raise CliContractError.TestSelectionInvalid if selection == "" or sview_len(selection) >= Limits::TEST_NAME_BYTES or not cli_text_valid(selection)
                for earlier in 0..<index |invocation, selection|:
                    raise CliContractError.DuplicateTestSelection if invocation.test_selection[earlier] == selection
            raise CliContractError.ReportFormatUnavailable if invocation.report_format != CliReportFormat.Human and invocation.mode != CliMode.Test
            raise CliContractError.ColorNotApplicable if invocation.report_format != CliReportFormat.Human and invocation.color == CliColorMode.Always
            raise CliContractError.SourcePathLimitExceeded if invocation.source_path != "" and sview_len(invocation.source_path) >= Limits::SOURCE_PATH_BYTES
            raise CliContractError.EmbeddedNul if invocation.source_path != "" and sview_contains_byte(invocation.source_path, 0)
            raise CliContractError.InvalidSourceExtension if cli_mode_requires_source(invocation.mode) and not sview_ends_with(invocation.source_path, ".elisascript")
            raise CliContractError.ArgumentLimitExceeded if invocation.script_arguments.count > Limits::ARGUMENTS
            for argument in invocation.script_arguments:
                raise CliContractError.TextLimitExceeded if not cli_text_valid(argument)
                raise CliContractError.EmbeddedNul if sview_contains_byte(argument, 0)
            return true


        def parse_cli_arguments(arguments: darray[sview]) -> CliInvocation error[CliContractError]:
            # Raw argv includes the source path in addition to the maximum
            # number of script arguments. Launcher options also consume slots
            # within that same host-side argc ceiling.
            raise CliContractError.ArgumentLimitExceeded if arguments.count > Limits::ARGUMENTS + 1
            input_bytes: mutable usize = 0
            for argument in arguments |input_bytes|:
                argument_bytes: usize = sview_len(argument)
                raise CliContractError.TextLimitExceeded if argument_bytes >= Limits::TEXT_BYTES
                raise CliContractError.EmbeddedNul if sview_contains_byte(argument, 0)
                raise CliContractError.TextLimitExceeded if argument_bytes > Limits::TEXT_BYTES - input_bytes
                input_bytes <- input_bytes + argument_bytes
            invocation: mutable CliInvocation = CliInvocation{}
            mode_selected: mutable bool = false
            color_selected: mutable bool = false
            report_format_selected: mutable bool = false
            options: mutable bool = true
            index: mutable usize = 0
            while options:
                break if index >= arguments.count
                argument: sview = arguments[index]
                if argument == "--":
                    invocation.option_end_seen <- true
                    index <- index + 1
                    options <- false
                    # `--` terminates launcher options, but it does not make
                    # the source path disappear.  When the source has not
                    # been selected yet, consume the first post-boundary
                    # token as the source and preserve the remainder as
                    # script arguments.  Non-source modes intentionally do
                    # not consume it; validation then reports the extra
                    # argument instead of silently accepting it.
                    if index < arguments.count and cli_mode_requires_source(invocation.mode):
                        invocation.source_path <- arguments[index]
                        index <- index + 1
                elif argument == "--strict-engine":
                    raise CliContractError.DuplicateOption if invocation.strict_engine
                    invocation.strict_engine <- true
                    index <- index + 1
                elif argument == "--color":
                    raise CliContractError.MissingOptionValue if index + 1 >= arguments.count
                    raise CliContractError.DuplicateOption if color_selected
                    color_value: sview = arguments[index + 1]
                    raise CliContractError.InvalidColorMode if color_value not in {"auto", "always", "never"}
                    invocation.color <- CliColorMode.Auto if color_value == "auto" else CliColorMode.Always if color_value == "always" else CliColorMode.Never
                    color_selected <- true
                    index <- index + 2
                elif argument == "--format":
                    raise CliContractError.MissingOptionValue if index + 1 >= arguments.count
                    raise CliContractError.DuplicateOption if report_format_selected
                    invocation.report_format <- try cli_report_format_from_argument(arguments[index + 1])
                    report_format_selected <- true
                    index <- index + 2
                elif argument == "--select":
                    raise CliContractError.MissingOptionValue if index + 1 >= arguments.count
                    raise CliContractError.TestSelectionLimitExceeded if invocation.test_selection.count >= Limits::TEST_SELECTIONS
                    invocation.test_selection.push(arguments[index + 1])
                    index <- index + 2
                elif argument == "--run" or argument == "--check" or argument == "--test" or argument == "--fmt" or argument == "--doc" or argument == "--version" or argument == "-V" or argument == "--help" or argument == "-h":
                    selected_mode: CliMode = try cli_mode_from_argument(argument)
                    try cli_set_mode(invocation, selected_mode, &mode_selected)
                    index <- index + 1
                elif argument != "" and sview_at(argument, 0) == 45:
                    raise CliContractError.UnknownOption
                else:
                    invocation.source_path <- argument
                    index <- index + 1
                    options <- false
            while index < arguments.count:
                # A source path also ends option parsing, but a following
                # `--` is still the explicit script-argument boundary.  Do
                # not leak that marker into the script's argv; preserve every
                # value after it byte-for-byte.
                if arguments[index] == "--" and not invocation.option_end_seen:
                    invocation.option_end_seen <- true
                    index <- index + 1
                else:
                    raise CliContractError.ArgumentLimitExceeded if invocation.script_arguments.count >= Limits::ARGUMENTS
                    invocation.script_arguments.push(arguments[index])
                    index <- index + 1
            try validate_cli_invocation(invocation)
            return invocation
