                126571u32,                 126579u32,                 126584u32,                 126589u32,                 126591u32,                 126602u32,                 126624u32,                 126628u32,
                126634u32,                 126703u32,                 126975u32,                 127023u32,                 127135u32,                 127152u32,                 127168u32,                 127184u32,
                127231u32,                 127461u32,                 127503u32,                 127551u32,                 127567u32,                 127583u32,                 127743u32,                 128731u32,
                128751u32,                 128767u32,                 128890u32,                 128991u32,                 129007u32,                 129023u32,                 129039u32,                 129103u32,
                129119u32,                 129167u32,                 129199u32,                 129215u32,                 129279u32,                 129631u32,                 129647u32,                 129663u32,
                129678u32,                 129741u32,                 129758u32,                 129775u32,                 129791u32,                 129939u32,                 131071u32,                 173823u32,
                177983u32,                 178207u32,                 183983u32,                 191471u32,                 194559u32,                 196607u32,                 201551u32,                 917759u32,
                1114111u32
            ]

        enum LookupPhase of u8:
            Probe
            Done

        enum BoundaryCheckPhase of u8:
            Inspect
            Done

        def lookup_nonprintable(codepoint: usize) -> bool:
            return false if codepoint > 1114111
            lower: mutable usize = 0
            upper: mutable usize = UnicodeData::RANGE_COUNT
            middle: mutable usize = 0
            found: mutable bool = false
            phase: mutable LookupPhase = LookupPhase.Probe

            machine over phase while phase != LookupPhase.Done:
                state Probe
                state Done
                start Probe

                Probe, LookupPhase.Probe:
                    if lower >= upper:
                        phase <- LookupPhase.Done
                        -> Done
                    middle <- lower + ((upper - lower) / 2)
                    first: usize = UnicodeData::NONPRINTABLE_STARTS[middle].usize()
                    last: usize = UnicodeData::NONPRINTABLE_ENDS[middle].usize()
                    if codepoint < first:
                        upper <- middle
                        -> Probe
                    if codepoint > last:
                        lower <- middle + 1
                        -> Probe
                    found <- true
                    phase <- LookupPhase.Done
                    -> Done

                Probe, LookupPhase.Done:
                    break

                Done, LookupPhase.Done:
                    break

            return found

    public:
        def is_nonprintable(codepoint: usize) -> bool:
            return lookup_nonprintable(codepoint)

        def range_boundary_contract() -> bool:
            index: mutable usize = 0
            previous_end: mutable usize = 0
            valid: mutable bool = true
            phase: mutable BoundaryCheckPhase = BoundaryCheckPhase.Inspect

            machine over phase while phase != BoundaryCheckPhase.Done:
                state Inspect
                state Done
                start Inspect

                Inspect, BoundaryCheckPhase.Inspect:
                    if index >= UnicodeData::RANGE_COUNT:
                        valid <- false if previous_end != 1114111
                        phase <- BoundaryCheckPhase.Done
                        -> Done

                    first: usize = UnicodeData::NONPRINTABLE_STARTS[index].usize()
                    last: usize = UnicodeData::NONPRINTABLE_ENDS[index].usize()
                    if first > last or last > 1114111:
                        valid <- false
                        phase <- BoundaryCheckPhase.Done
                        -> Done
                    if index == 0 and first != 0:
                        valid <- false
                        phase <- BoundaryCheckPhase.Done
                        -> Done
                    middle: usize = first + ((last - first) / 2)
                    if index > 0 and first <= previous_end + 1:
                        valid <- false
                        phase <- BoundaryCheckPhase.Done
                        -> Done
                    if not lookup_nonprintable(first) or not lookup_nonprintable(middle) or not lookup_nonprintable(last):
                        valid <- false
                        phase <- BoundaryCheckPhase.Done
                        -> Done
                    if first > 0 and lookup_nonprintable(first - 1):
                        valid <- false
                        phase <- BoundaryCheckPhase.Done
                        -> Done
                    if last < 1114111 and lookup_nonprintable(last + 1):
                        valid <- false
                        phase <- BoundaryCheckPhase.Done
                        -> Done
                    previous_end <- last
                    index <- index + 1
                    -> Inspect

                Inspect, BoundaryCheckPhase.Done:
                    break

                Done, BoundaryCheckPhase.Done:
                    break

            return valid
