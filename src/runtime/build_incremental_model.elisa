# Bounded, pure incremental-build admission.
#
# `EsBuild` and `EsBuildScheduler` own command graphs and execution state. This
# module owns the CMake/Ninja-style question that must happen before dispatch:
# does a target still describe the current recipe, inputs, dependencies, and
# outputs, or must it be rebuilt? Hosts provide the current observations; no
# filesystem or process effect is performed here.

module EsBuildIncremental:
    using EsBuild

    public:
        const module Limits:
            TARGETS: usize = 4096
            INPUTS: usize = 4096
            OUTPUTS: usize = 4096
            DEPENDENCIES: usize = 4096
            TOTAL_INPUTS: usize = 1048576
            TOTAL_OUTPUTS: usize = 1048576
            OBSERVATIONS: usize = 2097152
            CLEANUP_OUTPUTS: usize = 16384
            PATH_BYTES: usize = 4096
            NAME_BYTES: usize = 4096


        const enum BuildIncrementalTargetKind of u8:
            Executable
            StaticLibrary
            SharedLibrary
            GeneratedFile
            Phony


        const enum BuildIncrementalDecision of u8:
            UpToDate
            RecipeChanged
            DependencyMissing
            DependencyDirty
            ObservationMissing
            InputMissing
            InputChanged
            OutputMissing
            OutputChanged


        # Content identity is the complete SHA-256 digest, stored as four
        # little-endian words to keep hashing and cache persistence allocation-free.
        struct BuildIncrementalFile:
            path: sview
            fingerprint: u64
            fingerprint_word1: u64 = 0
            fingerprint_word2: u64 = 0
            fingerprint_word3: u64 = 0


        # A stale output is data for a host cleanup adapter, not permission to
        # delete anything. The previous owner and fingerprint let that adapter
        # re-check ownership and identity immediately before a destructive
        # operation.
        struct BuildIncrementalStaleOutput:
            target_name: sview
            output: BuildIncrementalFile


        # A file record in a target is the digest captured by the last
        # successful build. An all-zero digest is reserved as invalid.
        struct BuildIncrementalTarget:
            name: sview
            kind: BuildIncrementalTargetKind
            recipe_fingerprint: u64
            inputs: darray[BuildIncrementalFile] = []
            outputs: darray[BuildIncrementalFile] = []
            dependencies: darray[sview] = []


        # Current build definitions do not yet have successful artifact
        # fingerprints. Keep their path-only shape separate from the last
        # committed BuildIncrementalTarget cache records.
        struct BuildIncrementalRecipeTarget:
            name: sview
            kind: BuildIncrementalTargetKind
            recipe_fingerprint: u64
            inputs: darray[sview] = []
            outputs: darray[sview] = []
            dependencies: darray[sview] = []


        struct BuildIncrementalPlan:
            decisions: darray[BuildIncrementalDecision] = []
            target_names: darray[sview] = []
            recipe_fingerprints: darray[u64] = []
            rebuild_target_indices: darray[usize] = []
            # Cleanup is post-success intent only. The host must revalidate
            # each path's ownership/identity before deleting it.
            stale_outputs_after_success: darray[BuildIncrementalStaleOutput] = []


        # A complete replacement cache value plus cleanup candidates. A host
        # may publish this only after the whole build succeeded, and may
        # delete candidates only after revalidating filesystem identity.
        struct BuildIncrementalCommit:
            targets: darray[BuildIncrementalTarget] = []
            stale_outputs_after_success: darray[BuildIncrementalStaleOutput] = []


        # Observations are supplied by a host adapter after it has statted or
        # hashed a path. Missing paths carry no fingerprint, so a stale output
        # cannot be confused with a valid all-zero digest.
        struct BuildIncrementalObservation:
            path: sview
            present: bool = false
            fingerprint: u64 = 0
            fingerprint_word1: u64 = 0
            fingerprint_word2: u64 = 0
            fingerprint_word3: u64 = 0


        struct BuildIncrementalDependencyObservation:
            name: sview
            current: bool = false


        error BuildIncrementalError:
            EmptyManifest
            TargetLimitExceeded
            InvalidTargetKind
            InvalidTargetName
            InvalidPath
            FingerprintMissing
            CurrentRecipeShapeInvalid
            InputLimitExceeded
            OutputRequired
            OutputForbidden
            OutputLimitExceeded
            DependencyLimitExceeded
            ObservationLimitExceeded
            InvalidObservation
            ObservationSetMismatch
            InvalidDependencyObservation
            CommitObservationMissing
            CommitInputMissing
            CommitOutputMissing
            TotalInputLimitExceeded
            TotalOutputLimitExceeded
            DependencyResolutionInvalid
            DuplicateTarget
            DuplicateInput
            DuplicateOutput
            OutputCollision
            InputOutputCollision
            DuplicateDependency
            MissingDependency
            DependencyOrderInvalid
            UndeclaredOutputDependency
            OrphanedOutputInput
            CleanupOutputLimitExceeded


    private:
        def build_incremental_digest_present(word0: u64, word1: u64, word2: u64, word3: u64) -> bool:
            return word0 != 0 or word1 != 0 or word2 != 0 or word3 != 0


        def build_incremental_digests_equal(left_word0: u64, left_word1: u64, left_word2: u64, left_word3: u64, right_word0: u64, right_word1: u64, right_word2: u64, right_word3: u64) -> bool:
            return left_word0 == right_word0 and left_word1 == right_word1 and left_word2 == right_word2 and left_word3 == right_word3


        const enum BuildIncrementalPathOrder of u8:
            Before
            Equal
            After


        struct BuildIncrementalPathOwner:
            path: sview
            target_index: usize


        struct BuildIncrementalResolvedManifest:
            resolution: BuildDependencyResolution = BuildDependencyResolution{}
            output_owners: darray[BuildIncrementalPathOwner] = []
            input_owners: darray[BuildIncrementalPathOwner] = []


        def build_incremental_target_kind_valid(kind: BuildIncrementalTargetKind) -> bool:
            return kind in {BuildIncrementalTargetKind.Executable, BuildIncrementalTargetKind.StaticLibrary, BuildIncrementalTargetKind.SharedLibrary, BuildIncrementalTargetKind.GeneratedFile, BuildIncrementalTargetKind.Phony}


        def build_incremental_name_valid(name: sview) -> bool:
            return len(name) != 0 and len(name) < Limits::NAME_BYTES and not sview_contains_byte(name, 0) and not sview_contains_byte(name, 9) and not sview_contains_byte(name, 10) and not sview_contains_byte(name, 13)


        def build_incremental_path_valid(path: sview) -> bool:
            length: usize = len(path)
            return false if length == 0 or length >= Limits::PATH_BYTES or sview_contains_byte(path, 0) or sview_contains_byte(path, 9) or sview_contains_byte(path, 10) or sview_contains_byte(path, 13) or sview_at(path, 0) == 47
            segment_start: mutable usize = 0
            index: mutable usize = 0
            while index <= length:
                at_end: bool = index == length
                separator: bool = not at_end and sview_at(path, index) == 47
                if at_end or separator:
                    return false if index == segment_start
                    segment_length: usize = index - segment_start
                    return false if segment_length == 1 and sview_at(path, segment_start) == 46
                    return false if segment_length == 2 and sview_at(path, segment_start) == 46 and sview_at(path, segment_start + 1) == 46
                    segment_start <- index + 1
                index <- index + 1
            return true


        def build_incremental_path_order(left: sview, right: sview) -> BuildIncrementalPathOrder:
            left_length: usize = len(left)
            right_length: usize = len(right)
            common: usize = left_length if left_length < right_length else right_length
            for offset in 0..<common |left, right|:
                return BuildIncrementalPathOrder.Before if sview_at(left, offset) < sview_at(right, offset)
                return BuildIncrementalPathOrder.After if sview_at(left, offset) > sview_at(right, offset)
            return BuildIncrementalPathOrder.Before if left_length < right_length
            return BuildIncrementalPathOrder.After if left_length > right_length
            return BuildIncrementalPathOrder.Equal


        def build_incremental_path_owner_order(left: BuildIncrementalPathOwner, right: BuildIncrementalPathOwner) -> BuildIncrementalPathOrder:
            path_order: BuildIncrementalPathOrder = build_incremental_path_order(left.path, right.path)
            return path_order if path_order != BuildIncrementalPathOrder.Equal
            return BuildIncrementalPathOrder.Before if left.target_index < right.target_index
            return BuildIncrementalPathOrder.After if left.target_index > right.target_index
            return BuildIncrementalPathOrder.Equal


        def build_sort_incremental_path_owners(owners: mutable darray[BuildIncrementalPathOwner]&, scratch: mutable darray[BuildIncrementalPathOwner]&) -> void:
            width: mutable usize = 1
            while width < owners.count |owners, scratch, width|:
                start: mutable usize = 0
                while start < owners.count |owners, scratch, width, start|:
                    middle: usize = start + width if width < owners.count - start else owners.count
                    end: usize = middle + width if width < owners.count - middle else owners.count
                    left: mutable usize = start
                    right: mutable usize = middle
                    destination: mutable usize = start
                    while left < middle or right < end |owners, scratch, width, start, middle, end, left, right, destination|:
                        if right >= end:
                            scratch[destination] <- owners[left]
                            left <- left + 1
                        elif left >= middle:
                            scratch[destination] <- owners[right]
                            right <- right + 1
                        elif build_incremental_path_owner_order(owners[left], owners[right]) != BuildIncrementalPathOrder.After:
                            scratch[destination] <- owners[left]
                            left <- left + 1
                        else:
                            scratch[destination] <- owners[right]
                            right <- right + 1
                        destination <- destination + 1
                    start <- end
                for index in 0..<owners.count |owners, scratch|:
                    owners[index] <- scratch[index]
                width <- owners.count if width > owners.count / 2 else width * 2


        def build_incremental_path_owners(targets: darray[BuildIncrementalTarget], outputs: bool) -> darray[BuildIncrementalPathOwner] error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            owners: mutable darray[BuildIncrementalPathOwner] = []
            scratch: mutable darray[BuildIncrementalPathOwner] = []
            for target_index in 0..<targets.count |targets, owners, scratch, outputs|:
                target: BuildIncrementalTarget = targets[target_index]
                if outputs:
                    raise BuildIncrementalError.TotalOutputLimitExceeded if target.outputs.count > Limits::TOTAL_OUTPUTS - owners.count
                    for output in target.outputs |target, owners, scratch, outputs|:
                        owners.push(BuildIncrementalPathOwner{path: output.path, target_index: target_index})
                        scratch.push(BuildIncrementalPathOwner{path: "", target_index: 0})
                else:
                    raise BuildIncrementalError.TotalInputLimitExceeded if target.inputs.count > Limits::TOTAL_INPUTS - owners.count
                    for input in target.inputs |target, owners, scratch, outputs|:
                        owners.push(BuildIncrementalPathOwner{path: input.path, target_index: target_index})
                        scratch.push(BuildIncrementalPathOwner{path: "", target_index: 0})
            build_sort_incremental_path_owners(owners, scratch)
            return owners


        def build_incremental_path_owner_position(owners: darray[BuildIncrementalPathOwner], path: sview) -> usize:
            low: mutable usize = 0
            high: mutable usize = owners.count
            while low < high |owners, path, low, high|:
                middle: usize = low + (high - low) / 2
                path_order: BuildIncrementalPathOrder = build_incremental_path_order(owners[middle].path, path)
                return middle if path_order == BuildIncrementalPathOrder.Equal
                low <- middle + 1 if path_order == BuildIncrementalPathOrder.Before
                high <- middle if path_order == BuildIncrementalPathOrder.After
            return owners.count


        def build_sort_incremental_observation_indices(observations: darray[BuildIncrementalObservation], indices: mutable darray[usize]&, scratch: mutable darray[usize]&) -> void:
            width: mutable usize = 1
            while width < indices.count |observations, indices, scratch, width|:
                start: mutable usize = 0
                while start < indices.count |observations, indices, scratch, width, start|:
                    middle: usize = start + width if width < indices.count - start else indices.count
                    end: usize = middle + width if width < indices.count - middle else indices.count
                    left: mutable usize = start
                    right: mutable usize = middle
                    destination: mutable usize = start
                    while left < middle or right < end |observations, indices, scratch, width, start, middle, end, left, right, destination|:
                        if right >= end:
                            scratch[destination] <- indices[left]
                            left <- left + 1
                        elif left >= middle:
                            scratch[destination] <- indices[right]
                            right <- right + 1
                        elif build_incremental_path_order(observations[indices[left]].path, observations[indices[right]].path) != BuildIncrementalPathOrder.After:
                            scratch[destination] <- indices[left]
                            left <- left + 1
                        else:
                            scratch[destination] <- indices[right]
                            right <- right + 1
                        destination <- destination + 1
                    start <- end
                for index in 0..<indices.count |indices, scratch|:
                    indices[index] <- scratch[index]
                width <- indices.count if width > indices.count / 2 else width * 2


        def build_incremental_observation_order(observations: darray[BuildIncrementalObservation]) -> darray[usize] error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            raise BuildIncrementalError.ObservationLimitExceeded if observations.count > Limits::OBSERVATIONS
            indices: mutable darray[usize] = []
            scratch: mutable darray[usize] = []
            for index in 0..<observations.count |observations, indices, scratch|:
                observation: BuildIncrementalObservation = observations[index]
                raise BuildIncrementalError.InvalidPath if not build_incremental_path_valid(observation.path)
                if observation.present:
                    raise BuildIncrementalError.FingerprintMissing if not build_incremental_digest_present(observation.fingerprint, observation.fingerprint_word1, observation.fingerprint_word2, observation.fingerprint_word3)
                else:
                    raise BuildIncrementalError.InvalidObservation if build_incremental_digest_present(observation.fingerprint, observation.fingerprint_word1, observation.fingerprint_word2, observation.fingerprint_word3)
                indices.push(index)
                scratch.push(0)
            build_sort_incremental_observation_indices(observations, indices, scratch)
            if indices.count > 1:
                for position in 1..<indices.count |observations, indices|:
                    previous: BuildIncrementalObservation = observations[indices[position - 1]]
                    current: BuildIncrementalObservation = observations[indices[position]]
                    raise BuildIncrementalError.InvalidObservation if previous.path == current.path
            return indices


        def build_incremental_observation_index(observations: darray[BuildIncrementalObservation], sorted_indices: darray[usize], path: sview) -> usize:
            low: mutable usize = 0
            high: mutable usize = sorted_indices.count
            while low < high |observations, sorted_indices, path, low, high|:
                middle: usize = low + (high - low) / 2
                observation_index: usize = sorted_indices[middle]
                path_order: BuildIncrementalPathOrder = build_incremental_path_order(observations[observation_index].path, path)
                return observation_index if path_order == BuildIncrementalPathOrder.Equal
                low <- middle + 1 if path_order == BuildIncrementalPathOrder.Before
                high <- middle if path_order == BuildIncrementalPathOrder.After
            return observations.count


        def build_incremental_observations_match_paths(paths: darray[sview], observations: darray[BuildIncrementalObservation], sorted_indices: darray[usize]) -> bool error[BuildIncrementalError]:
            raise BuildIncrementalError.ObservationSetMismatch if paths.count != observations.count
            for path in paths |paths, observations, sorted_indices|:
                observation_index: usize = build_incremental_observation_index(observations, sorted_indices, path)
                raise BuildIncrementalError.ObservationSetMismatch if observation_index == observations.count
            return true


        def build_incremental_dependency_order(observations: darray[BuildIncrementalDependencyObservation]) -> darray[BuildIncrementalPathOwner] error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            raise BuildIncrementalError.DependencyLimitExceeded if observations.count > Limits::DEPENDENCIES
            owners: mutable darray[BuildIncrementalPathOwner] = []
            scratch: mutable darray[BuildIncrementalPathOwner] = []
            for index in 0..<observations.count |observations, owners, scratch|:
                observation: BuildIncrementalDependencyObservation = observations[index]
                raise BuildIncrementalError.InvalidTargetName if not build_incremental_name_valid(observation.name)
                owners.push(BuildIncrementalPathOwner{path: observation.name, target_index: index})
                scratch.push(BuildIncrementalPathOwner{path: "", target_index: 0})
            build_sort_incremental_path_owners(owners, scratch)
            if owners.count > 1:
                for position in 1..<owners.count |owners|:
                    raise BuildIncrementalError.InvalidDependencyObservation if owners[position - 1].path == owners[position].path
            return owners


        def build_incremental_dependency_observation_position(owners: darray[BuildIncrementalPathOwner], name: sview) -> usize:
            low: mutable usize = 0
            high: mutable usize = owners.count
            while low < high |owners, name, low, high|:
                middle: usize = low + (high - low) / 2
                name_order: BuildIncrementalPathOrder = build_incremental_path_order(owners[middle].path, name)
                return middle if name_order == BuildIncrementalPathOrder.Equal
                low <- middle + 1 if name_order == BuildIncrementalPathOrder.Before
                high <- middle if name_order == BuildIncrementalPathOrder.After
            return owners.count


        def build_incremental_target_shape_valid(target: BuildIncrementalTarget) -> bool error[BuildIncrementalError]:
            raise BuildIncrementalError.InvalidTargetKind if not build_incremental_target_kind_valid(target.kind)
            raise BuildIncrementalError.InvalidTargetName if not build_incremental_name_valid(target.name)
            raise BuildIncrementalError.FingerprintMissing if target.recipe_fingerprint == 0
            raise BuildIncrementalError.InputLimitExceeded if target.inputs.count > Limits::INPUTS
            raise BuildIncrementalError.OutputForbidden if target.kind == BuildIncrementalTargetKind.Phony and target.outputs.count != 0
            raise BuildIncrementalError.OutputRequired if target.outputs.count == 0 and target.kind != BuildIncrementalTargetKind.Phony
            raise BuildIncrementalError.OutputLimitExceeded if target.outputs.count > Limits::OUTPUTS
            raise BuildIncrementalError.DependencyLimitExceeded if target.dependencies.count > Limits::DEPENDENCIES
            for input_index in 0..<target.inputs.count |target|:
                input: BuildIncrementalFile = target.inputs[input_index]
                raise BuildIncrementalError.InvalidPath if not build_incremental_path_valid(input.path)
                raise BuildIncrementalError.FingerprintMissing if not build_incremental_digest_present(input.fingerprint, input.fingerprint_word1, input.fingerprint_word2, input.fingerprint_word3)
            for output_index in 0..<target.outputs.count |target|:
                output: BuildIncrementalFile = target.outputs[output_index]
                raise BuildIncrementalError.InvalidPath if not build_incremental_path_valid(output.path)
                raise BuildIncrementalError.FingerprintMissing if not build_incremental_digest_present(output.fingerprint, output.fingerprint_word1, output.fingerprint_word2, output.fingerprint_word3)
            for dependency in target.dependencies:
                raise BuildIncrementalError.InvalidTargetName if not build_incremental_name_valid(dependency)
            return true


        def build_incremental_target_valid(target: BuildIncrementalTarget) -> bool error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            try build_incremental_target_shape_valid(target)
            single_target: mutable darray[BuildIncrementalTarget] = []
            single_target.push(target)
            input_owners: darray[BuildIncrementalPathOwner] = try build_incremental_path_owners(single_target, false)
            output_owners: darray[BuildIncrementalPathOwner] = try build_incremental_path_owners(single_target, true)
            if input_owners.count > 1:
                for position in 1..<input_owners.count |input_owners|:
                    raise BuildIncrementalError.DuplicateInput if input_owners[position - 1].path == input_owners[position].path
            if output_owners.count > 1:
                for position in 1..<output_owners.count |output_owners|:
                    raise BuildIncrementalError.DuplicateOutput if output_owners[position - 1].path == output_owners[position].path
            for output in output_owners |input_owners|:
                raise BuildIncrementalError.InputOutputCollision if build_incremental_path_owner_position(input_owners, output.path) != input_owners.count

            dependency_owners: mutable darray[BuildIncrementalPathOwner] = []
            dependency_scratch: mutable darray[BuildIncrementalPathOwner] = []
            for dependency in target.dependencies |dependency_owners, dependency_scratch|:
                dependency_owners.push(BuildIncrementalPathOwner{path: dependency, target_index: 0})
                dependency_scratch.push(BuildIncrementalPathOwner{path: "", target_index: 0})
            build_sort_incremental_path_owners(dependency_owners, dependency_scratch)
            if dependency_owners.count > 1:
                for position in 1..<dependency_owners.count |dependency_owners|:
                    raise BuildIncrementalError.DuplicateDependency if dependency_owners[position - 1].path == dependency_owners[position].path
            return true


        def build_incremental_dependency_index_contains(dependencies: darray[usize], target_index: usize) -> bool:
            low: mutable usize = 0
            high: mutable usize = dependencies.count
            while low < high |dependencies, target_index, low, high|:
                middle: usize = low + (high - low) / 2
                dependency_index: usize = dependencies[middle]
                return true if dependency_index == target_index
                low <- middle + 1 if dependency_index < target_index
                high <- middle if dependency_index > target_index
            return false


        def build_incremental_target_decision_validated(target: BuildIncrementalTarget, current_recipe_fingerprint: u64, observations: darray[BuildIncrementalObservation], sorted_observation_indices: darray[usize], dependency_dirty: bool) -> BuildIncrementalDecision:
            return BuildIncrementalDecision.RecipeChanged if current_recipe_fingerprint != target.recipe_fingerprint
            return BuildIncrementalDecision.DependencyDirty if dependency_dirty
            for input in target.inputs:
                observation_index: usize = build_incremental_observation_index(observations, sorted_observation_indices, input.path)
                return BuildIncrementalDecision.ObservationMissing if observation_index == observations.count
                return BuildIncrementalDecision.InputMissing if not observations[observation_index].present
                return BuildIncrementalDecision.InputChanged if not build_incremental_digests_equal(observations[observation_index].fingerprint, observations[observation_index].fingerprint_word1, observations[observation_index].fingerprint_word2, observations[observation_index].fingerprint_word3, input.fingerprint, input.fingerprint_word1, input.fingerprint_word2, input.fingerprint_word3)
            for output in target.outputs:
                observation_index: usize = build_incremental_observation_index(observations, sorted_observation_indices, output.path)
                return BuildIncrementalDecision.ObservationMissing if observation_index == observations.count
                return BuildIncrementalDecision.OutputMissing if not observations[observation_index].present
                return BuildIncrementalDecision.OutputChanged if not build_incremental_digests_equal(observations[observation_index].fingerprint, observations[observation_index].fingerprint_word1, observations[observation_index].fingerprint_word2, observations[observation_index].fingerprint_word3, output.fingerprint, output.fingerprint_word1, output.fingerprint_word2, output.fingerprint_word3)
            return BuildIncrementalDecision.UpToDate


        def build_incremental_find_target_index(resolution: BuildDependencyResolution, name: sview) -> usize:
            low: mutable usize = 0
            high: mutable usize = resolution.node_name_order.count
            while low < high |resolution, name, low, high|:
                middle: usize = low + (high - low) / 2
                entry: BuildNodeNameIndex = resolution.node_name_order[middle]
                order: BuildIncrementalPathOrder = build_incremental_path_order(entry.name, name)
                return entry.node_index if order == BuildIncrementalPathOrder.Equal
                low <- middle + 1 if order == BuildIncrementalPathOrder.Before
                high <- middle if order == BuildIncrementalPathOrder.After
            return resolution.node_name_order.count


        def build_incremental_recipe_shape_matches(previous: BuildIncrementalTarget, current: BuildIncrementalRecipeTarget) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if previous.kind != current.kind or previous.dependencies != current.dependencies
            return false if previous.inputs.count != current.inputs.count or previous.outputs.count != current.outputs.count
            previous_inputs: mutable darray[sview] = []
            previous_outputs: mutable darray[sview] = []
            for input in previous.inputs |previous_inputs|:
                previous_inputs.push(input.path)
            for output in previous.outputs |previous_outputs|:
                previous_outputs.push(output.path)
            return sorted(previous_inputs) == sorted(current.inputs) and sorted(previous_outputs) == sorted(current.outputs)


        def build_incremental_materialize_recipe_targets(recipes: darray[BuildIncrementalRecipeTarget]) -> darray[BuildIncrementalTarget] error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            raise BuildIncrementalError.TargetLimitExceeded if recipes.count > Limits::TARGETS
            targets: mutable darray[BuildIncrementalTarget] = []
            total_inputs: mutable usize = 0
            total_outputs: mutable usize = 0
            for recipe in recipes |recipes, targets, total_inputs, total_outputs|:
                raise BuildIncrementalError.InvalidTargetKind if not build_incremental_target_kind_valid(recipe.kind)
                raise BuildIncrementalError.InvalidTargetName if not build_incremental_name_valid(recipe.name)
                raise BuildIncrementalError.FingerprintMissing if recipe.recipe_fingerprint == 0
                raise BuildIncrementalError.InputLimitExceeded if recipe.inputs.count > Limits::INPUTS
                raise BuildIncrementalError.OutputLimitExceeded if recipe.outputs.count > Limits::OUTPUTS
                raise BuildIncrementalError.DependencyLimitExceeded if recipe.dependencies.count > Limits::DEPENDENCIES
                raise BuildIncrementalError.TotalInputLimitExceeded if recipe.inputs.count > Limits::TOTAL_INPUTS - total_inputs
                raise BuildIncrementalError.TotalOutputLimitExceeded if recipe.outputs.count > Limits::TOTAL_OUTPUTS - total_outputs
                total_inputs <- total_inputs + recipe.inputs.count
                total_outputs <- total_outputs + recipe.outputs.count
                inputs: mutable darray[BuildIncrementalFile] = []
                outputs: mutable darray[BuildIncrementalFile] = []
                for input_path in recipe.inputs |recipe, inputs|:
                    raise BuildIncrementalError.InvalidPath if not build_incremental_path_valid(input_path)
                    inputs.push(BuildIncrementalFile{path: input_path, fingerprint: 1})
                for output_path in recipe.outputs |recipe, outputs|:
                    raise BuildIncrementalError.InvalidPath if not build_incremental_path_valid(output_path)
                    outputs.push(BuildIncrementalFile{path: output_path, fingerprint: 1})
                for dependency in recipe.dependencies:
                    raise BuildIncrementalError.InvalidTargetName if not build_incremental_name_valid(dependency)
                targets.push(BuildIncrementalTarget{name: recipe.name, kind: recipe.kind, recipe_fingerprint: recipe.recipe_fingerprint, inputs: inputs, outputs: outputs, dependencies: recipe.dependencies})
            return targets


        def build_incremental_observed_commit_file(path: sview, is_output: bool, observations: darray[BuildIncrementalObservation], sorted_observation_indices: darray[usize]) -> BuildIncrementalFile error[BuildIncrementalError]:
            observation_index: usize = build_incremental_observation_index(observations, sorted_observation_indices, path)
            raise BuildIncrementalError.CommitObservationMissing if observation_index == observations.count
            observation: BuildIncrementalObservation = observations[observation_index]
            raise BuildIncrementalError.CommitOutputMissing if is_output and not observation.present
            raise BuildIncrementalError.CommitInputMissing if not is_output and not observation.present
            raise BuildIncrementalError.FingerprintMissing if not build_incremental_digest_present(observation.fingerprint, observation.fingerprint_word1, observation.fingerprint_word2, observation.fingerprint_word3)
            return BuildIncrementalFile{path: path, fingerprint: observation.fingerprint, fingerprint_word1: observation.fingerprint_word1, fingerprint_word2: observation.fingerprint_word2, fingerprint_word3: observation.fingerprint_word3}


        def build_incremental_dependency_resolution(targets: darray[BuildIncrementalTarget]) -> BuildDependencyResolution error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            node_names: mutable darray[sview] = []
            dependency_names: mutable darray[BuildDependencyNames] = []
            for target in targets |targets, node_names, dependency_names|:
                node_names.push(target.name)
                dependency_names.push(BuildDependencyNames{names: target.dependencies})
            resolution: mutable BuildDependencyResolution = BuildDependencyResolution{}
            catch resolve_build_dependencies(node_names, dependency_names):
                ok value:
                    resolution <- value
                error failure:
                    raise BuildIncrementalError.EmptyManifest if failure == BuildContractError.EmptyGraph
                    raise BuildIncrementalError.TargetLimitExceeded if failure == BuildContractError.NodeLimitExceeded
                    raise BuildIncrementalError.InvalidTargetName if failure == BuildContractError.InvalidNodeName
                    raise BuildIncrementalError.DuplicateTarget if failure == BuildContractError.DuplicateNode
                    raise BuildIncrementalError.DependencyLimitExceeded if failure == BuildContractError.DependencyLimitExceeded
                    raise BuildIncrementalError.MissingDependency if failure == BuildContractError.MissingDependency
                    raise BuildIncrementalError.DependencyOrderInvalid if failure == BuildContractError.DependencyOrderInvalid
                    raise BuildIncrementalError.DuplicateDependency if failure == BuildContractError.DuplicateDependency
                    raise BuildIncrementalError.DependencyResolutionInvalid
            return resolution


        def build_incremental_manifest_resolution(targets: darray[BuildIncrementalTarget]) -> BuildIncrementalResolvedManifest error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            raise BuildIncrementalError.EmptyManifest if targets.count == 0
            raise BuildIncrementalError.TargetLimitExceeded if targets.count > Limits::TARGETS
            for target in targets:
                try build_incremental_target_shape_valid(target)
            resolution: BuildDependencyResolution = try build_incremental_dependency_resolution(targets)
            output_owners: darray[BuildIncrementalPathOwner] = try build_incremental_path_owners(targets, true)
            if output_owners.count > 1:
                for position in 1..<output_owners.count |output_owners|:
                    previous: BuildIncrementalPathOwner = output_owners[position - 1]
                    current: BuildIncrementalPathOwner = output_owners[position]
                    if previous.path == current.path:
                        raise BuildIncrementalError.DuplicateOutput if previous.target_index == current.target_index
                        raise BuildIncrementalError.OutputCollision
            input_owners: darray[BuildIncrementalPathOwner] = try build_incremental_path_owners(targets, false)
            if input_owners.count > 1:
                for position in 1..<input_owners.count |input_owners|:
                    previous: BuildIncrementalPathOwner = input_owners[position - 1]
                    current: BuildIncrementalPathOwner = input_owners[position]
                    raise BuildIncrementalError.DuplicateInput if previous.path == current.path and previous.target_index == current.target_index
            for input_owner in input_owners |input_owners, output_owners, resolution|:
                output_position: usize = build_incremental_path_owner_position(output_owners, input_owner.path)
                if output_position != output_owners.count:
                    output_target_index: usize = output_owners[output_position].target_index
                    raise BuildIncrementalError.InputOutputCollision if output_target_index == input_owner.target_index
                    raise BuildIncrementalError.UndeclaredOutputDependency if not build_incremental_dependency_index_contains(resolution.dependencies[input_owner.target_index], output_target_index)
            return BuildIncrementalResolvedManifest{resolution: resolution, output_owners: output_owners, input_owners: input_owners}


        def build_incremental_observation_paths_from_manifest(manifest: BuildIncrementalResolvedManifest) -> darray[sview] error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            owners: mutable darray[BuildIncrementalPathOwner] = []
            scratch: mutable darray[BuildIncrementalPathOwner] = []
            for owner in manifest.input_owners |owners, scratch|:
                owners.push(owner)
                scratch.push(BuildIncrementalPathOwner{path: "", target_index: 0})
            for owner in manifest.output_owners |owners, scratch|:
                owners.push(owner)
                scratch.push(BuildIncrementalPathOwner{path: "", target_index: 0})
            build_sort_incremental_path_owners(owners, scratch)
            raise BuildIncrementalError.ObservationLimitExceeded if owners.count > Limits::OBSERVATIONS
            paths: mutable darray[sview] = []
            previous_path: mutable sview = ""
            for owner in owners |owners, paths, previous_path|:
                if paths.count == 0 or owner.path != previous_path:
                    paths.push(owner.path)
                    previous_path <- owner.path
            return paths


    public:
        # Shared by filesystem adapters before they resolve a recipe path from
        # a directory capability. The model and host must enforce one relative
        # path contract so a valid plan cannot escape the adapter's root.
        def build_incremental_path_is_canonical_relative(path: sview) -> bool:
            return build_incremental_path_valid(path)


        # Return the deterministic unique path set a host must observe before
        # planning or after a successful build. Validation and graph ownership
        # rules run before any host performs filesystem reads; shared inputs or
        # producer/consumer paths appear exactly once in the result.
        def build_incremental_observation_paths(recipes: darray[BuildIncrementalRecipeTarget]) -> darray[sview] error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            return [] if recipes.count == 0
            targets: darray[BuildIncrementalTarget] = try build_incremental_materialize_recipe_targets(recipes)
            manifest: BuildIncrementalResolvedManifest = try build_incremental_manifest_resolution(targets)
            return try build_incremental_observation_paths_from_manifest(manifest)


        # Validate a complete target manifest before it is handed to the
        # scheduler. Dependency order is deterministic and prevents a manifest
        # from claiming a consumer before its producer exists.
        def validate_build_incremental_manifest(targets: darray[BuildIncrementalTarget]) -> bool error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            try build_incremental_manifest_resolution(targets)
            return true


        # Validate and resolve the existing named-target manifest into the
        # canonical graph-edge representation consumed by EsBuild.
        def resolve_incremental_build_dependencies(targets: darray[BuildIncrementalTarget]) -> BuildDependencyResolution error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            manifest: BuildIncrementalResolvedManifest = try build_incremental_manifest_resolution(targets)
            return manifest.resolution


        # Reconcile a successful manifest with the current manifest before the
        # host removes anything. Outputs absent from the current graph are
        # returned in deterministic previous-manifest order. An output adopted
        # by another current target is retained, while a current consumer that
        # still names a removed generated output is rejected rather than being
        # allowed to reuse a stale artifact as if it were a source input. An
        # empty current manifest is valid here and means that every previous
        # output is obsolete; the scheduler-facing manifest validator still
        # rejects an empty graph.
        # The returned plan is pure; filesystem identity, build-root safety, and
        # the final deletion remain host-adapter responsibilities.
        def plan_build_incremental_cleanup(previous_targets: darray[BuildIncrementalTarget], current_targets: darray[BuildIncrementalTarget]) -> darray[BuildIncrementalStaleOutput] error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            cleanup: mutable darray[BuildIncrementalStaleOutput] = []
            current_manifest: mutable BuildIncrementalResolvedManifest = BuildIncrementalResolvedManifest{}
            if current_targets.count != 0:
                current_manifest <- try build_incremental_manifest_resolution(current_targets)
            return cleanup if previous_targets.count == 0
            try validate_build_incremental_manifest(previous_targets)
            for previous in previous_targets |previous_targets, current_manifest, cleanup|:
                for output in previous.outputs:
                    output_owner_position: usize = build_incremental_path_owner_position(current_manifest.output_owners, output.path)
                    if output_owner_position == current_manifest.output_owners.count:
                        input_owner_position: usize = build_incremental_path_owner_position(current_manifest.input_owners, output.path)
                        raise BuildIncrementalError.OrphanedOutputInput if input_owner_position != current_manifest.input_owners.count
                        raise BuildIncrementalError.CleanupOutputLimitExceeded if cleanup.count >= Limits::CLEANUP_OUTPUTS
                        cleanup.push(BuildIncrementalStaleOutput{target_name: previous.name, output: output})
            return cleanup


        # Construct the next cache snapshot after the host has observed a
        # fully successful build. All current input/output observations are
        # required before this returns, so callers can publish the returned
        # value atomically instead of exposing a partial cache update. This
        # function does not execute commands, persist the manifest, or delete
        # stale outputs.
        def commit_build_incremental_success(previous_targets: darray[BuildIncrementalTarget], current_recipes: darray[BuildIncrementalRecipeTarget], post_success_observations: darray[BuildIncrementalObservation]) -> BuildIncrementalCommit error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            raise BuildIncrementalError.EmptyManifest if current_recipes.count == 0
            recipe_targets: darray[BuildIncrementalTarget] = try build_incremental_materialize_recipe_targets(current_recipes)
            recipe_manifest: BuildIncrementalResolvedManifest = try build_incremental_manifest_resolution(recipe_targets)
            observation_paths: darray[sview] = try build_incremental_observation_paths_from_manifest(recipe_manifest)
            sorted_observation_indices: darray[usize] = try build_incremental_observation_order(post_success_observations)
            _ = try build_incremental_observations_match_paths(observation_paths, post_success_observations, sorted_observation_indices)
            committed_targets: mutable darray[BuildIncrementalTarget] = []
            for index in 0..<current_recipes.count |current_recipes, recipe_targets, post_success_observations, sorted_observation_indices, committed_targets|:
                recipe: BuildIncrementalRecipeTarget = current_recipes[index]
                validated_recipe: BuildIncrementalTarget = recipe_targets[index]
                inputs: mutable darray[BuildIncrementalFile] = []
                outputs: mutable darray[BuildIncrementalFile] = []
                for input_path in recipe.inputs |post_success_observations, sorted_observation_indices, inputs|:
                    inputs.push(try build_incremental_observed_commit_file(input_path, false, post_success_observations, sorted_observation_indices))
                for output_path in recipe.outputs |post_success_observations, sorted_observation_indices, outputs|:
                    outputs.push(try build_incremental_observed_commit_file(output_path, true, post_success_observations, sorted_observation_indices))
                committed_targets.push(BuildIncrementalTarget{name: validated_recipe.name, kind: validated_recipe.kind, recipe_fingerprint: recipe.recipe_fingerprint, inputs: inputs, outputs: outputs, dependencies: validated_recipe.dependencies})
            try build_incremental_manifest_resolution(committed_targets)
            stale_outputs: darray[BuildIncrementalStaleOutput] = try plan_build_incremental_cleanup(previous_targets, committed_targets)
            return BuildIncrementalCommit{targets: committed_targets, stale_outputs_after_success: stale_outputs}


        # Return the first deterministic reason a target is stale. `UpToDate`
        # means every declared input/output and dependency was observed and
        # matched; the scheduler may then admit a cache hit without launching a
        # compiler or linker.
        def classify_build_incremental_target(target: BuildIncrementalTarget, current_recipe_fingerprint: u64, observations: darray[BuildIncrementalObservation], dependencies: darray[BuildIncrementalDependencyObservation]) -> BuildIncrementalDecision error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            try build_incremental_target_valid(target)
            sorted_observation_indices: darray[usize] = try build_incremental_observation_order(observations)
            dependency_order: darray[BuildIncrementalPathOwner] = try build_incremental_dependency_order(dependencies)
            raise BuildIncrementalError.FingerprintMissing if current_recipe_fingerprint == 0
            return build_incremental_target_decision_validated(target, current_recipe_fingerprint, observations, sorted_observation_indices, false) if current_recipe_fingerprint != target.recipe_fingerprint
            for dependency in target.dependencies |target, dependencies, dependency_order|:
                dependency_position: usize = build_incremental_dependency_observation_position(dependency_order, dependency)
                return BuildIncrementalDecision.DependencyMissing if dependency_position == dependency_order.count
                dependency_index: usize = dependency_order[dependency_position].target_index
                return build_incremental_target_decision_validated(target, current_recipe_fingerprint, observations, sorted_observation_indices, true) if not dependencies[dependency_index].current
            return build_incremental_target_decision_validated(target, current_recipe_fingerprint, observations, sorted_observation_indices, false)


        # Classify the complete topologically ordered manifest in one pass.
        # Dependency-current flags are derived from earlier target decisions,
        # not supplied by a caller that could accidentally admit a stale cache
        # hit. The returned decision at index i belongs to targets[i].
        def classify_build_incremental_manifest(targets: darray[BuildIncrementalTarget], current_recipe_fingerprints: darray[u64], observations: darray[BuildIncrementalObservation]) -> darray[BuildIncrementalDecision] error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            manifest: BuildIncrementalResolvedManifest = try build_incremental_manifest_resolution(targets)
            resolution: BuildDependencyResolution = manifest.resolution
            raise BuildIncrementalError.CurrentRecipeShapeInvalid if current_recipe_fingerprints.count != targets.count
            sorted_observation_indices: darray[usize] = try build_incremental_observation_order(observations)
            expected_paths: darray[sview] = try build_incremental_observation_paths_from_manifest(manifest)
            _ = try build_incremental_observations_match_paths(expected_paths, observations, sorted_observation_indices)
            decisions: mutable darray[BuildIncrementalDecision] = []
            for target_index in 0..<targets.count |targets, current_recipe_fingerprints, observations, resolution, decisions|:
                current_recipe_fingerprint: u64 = current_recipe_fingerprints[target_index]
                raise BuildIncrementalError.FingerprintMissing if current_recipe_fingerprint == 0
                dependency_dirty: mutable bool = false
                for dependency_index in resolution.dependencies[target_index] |decisions, dependency_dirty|:
                    dependency_dirty <- true if decisions[dependency_index] != BuildIncrementalDecision.UpToDate
                decision: BuildIncrementalDecision = build_incremental_target_decision_validated(targets[target_index], current_recipe_fingerprint, observations, sorted_observation_indices, dependency_dirty)
                decisions.push(decision)
            return decisions


        # Compare the last successfully committed graph with the current
        # path-only recipe graph. New/changed targets rebuild; removed outputs
        # are returned only as post-success cleanup candidates. Dependency
        # dirtiness is derived in the current graph's topological order.
        def plan_build_incremental_transition(previous_targets: darray[BuildIncrementalTarget], current_recipes: darray[BuildIncrementalRecipeTarget], observations: darray[BuildIncrementalObservation]) -> BuildIncrementalPlan error[BuildIncrementalError] can[Memory.Allocate, Abort.Panic]:
            current_targets: darray[BuildIncrementalTarget] = try build_incremental_materialize_recipe_targets(current_recipes)
            previous_manifest: mutable BuildIncrementalResolvedManifest = BuildIncrementalResolvedManifest{}
            current_manifest: mutable BuildIncrementalResolvedManifest = BuildIncrementalResolvedManifest{}
            if previous_targets.count != 0:
                previous_manifest <- try build_incremental_manifest_resolution(previous_targets)
            if current_targets.count != 0:
                current_manifest <- try build_incremental_manifest_resolution(current_targets)
            sorted_observation_indices: darray[usize] = try build_incremental_observation_order(observations)
            observation_paths: darray[sview] = try build_incremental_observation_paths_from_manifest(current_manifest)
            _ = try build_incremental_observations_match_paths(observation_paths, observations, sorted_observation_indices)
            decisions: mutable darray[BuildIncrementalDecision] = []
            target_names: mutable darray[sview] = []
            recipe_fingerprints: mutable darray[u64] = []
            rebuild_indices: mutable darray[usize] = []
            for current_index in 0..<current_recipes.count |previous_targets, current_recipes, previous_manifest, current_manifest, observations, sorted_observation_indices, decisions, target_names, recipe_fingerprints, rebuild_indices|:
                current: BuildIncrementalRecipeTarget = current_recipes[current_index]
                previous_index: usize = build_incremental_find_target_index(previous_manifest.resolution, current.name)
                decision: mutable BuildIncrementalDecision = BuildIncrementalDecision.RecipeChanged
                if previous_index != previous_manifest.resolution.node_name_order.count:
                    previous: BuildIncrementalTarget = previous_targets[previous_index]
                    shape_matches: bool = try build_incremental_recipe_shape_matches(previous, current)
                    if shape_matches:
                        dependency_dirty: mutable bool = false
                        for dependency_index in current_manifest.resolution.dependencies[current_index] |decisions, dependency_dirty|:
                            dependency_dirty <- true if decisions[dependency_index] != BuildIncrementalDecision.UpToDate
                        decision <- build_incremental_target_decision_validated(previous, current.recipe_fingerprint, observations, sorted_observation_indices, dependency_dirty)
                decisions.push(decision)
                target_names.push(current.name)
                recipe_fingerprints.push(current.recipe_fingerprint)
                rebuild_indices.push(current_index) if decision != BuildIncrementalDecision.UpToDate
            stale_outputs: darray[BuildIncrementalStaleOutput] = try plan_build_incremental_cleanup(previous_targets, current_targets)
            return BuildIncrementalPlan{decisions: decisions, target_names: target_names, recipe_fingerprints: recipe_fingerprints, rebuild_target_indices: rebuild_indices, stale_outputs_after_success: stale_outputs}


        # Validate the parallel recipe metadata against the exact command
        # graph before classifying it. The graph owns executable command
        # fingerprints and canonical dependency indices; the recipe records
        # supply typed target kinds and declared file paths.
        def plan_build_incremental_graph_transition(previous_targets: darray[BuildIncrementalTarget], graph: BuildGraph, current_recipes: darray[BuildIncrementalRecipeTarget], observations: darray[BuildIncrementalObservation]) -> BuildIncrementalPlan error[BuildIncrementalError, BuildContractError] can[Memory.Allocate, Abort.Panic]:
            graph_valid: bool = try validate_build_graph(graph)
            raise BuildIncrementalError.CurrentRecipeShapeInvalid if not graph_valid
            raise BuildIncrementalError.CurrentRecipeShapeInvalid if graph.state != BuildGraphState.Planned
            raise BuildIncrementalError.CurrentRecipeShapeInvalid if graph.nodes.count != current_recipes.count
            for index in 0..<graph.nodes.count |graph, current_recipes|:
                node: BuildNode = graph.nodes[index]
                recipe: BuildIncrementalRecipeTarget = current_recipes[index]
                raise BuildIncrementalError.CurrentRecipeShapeInvalid if node.name != recipe.name or node.fingerprint != recipe.recipe_fingerprint
                raise BuildIncrementalError.CurrentRecipeShapeInvalid if node.dependencies.count != recipe.dependencies.count
                for dependency_position in 0..<node.dependencies.count |graph, current_recipes, index, recipe|:
                    dependency_index: usize = node.dependencies[dependency_position]
                    raise BuildIncrementalError.CurrentRecipeShapeInvalid if graph.nodes[dependency_index].name != recipe.dependencies[dependency_position]
            return try plan_build_incremental_transition(previous_targets, current_recipes, observations)
