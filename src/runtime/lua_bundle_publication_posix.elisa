# POSIX identity snapshot used to admit the Lua metadata staging descriptor.
# The caller must recapture and compare this proof immediately before rename;
# a proof is not a lock on a mutable directory entry.

module EsLuaBundlePublicationPosix:
    using EsRuntime
    using EsLuaBundlePublication

    public:
        const module Limits:
            STAT_EINTR_RETRIES: usize = 8
            IO_EINTR_RETRIES: usize = 8
            WRITE_CALLS: usize = 1048576
            MAX_BYTES: usize = 67108864


        struct PublicationHostProof:
            parent: PublicationParentProof
            staging: PublicationStagingProof


        error PublicationPosixError:
            InvalidDescriptor
            InvalidOwnerToken
            InvalidLeafName
            ParentStatFailed
            StagingStatFailed
            NameStatFailed
            ParentNotDirectory
            StagingNotRegular
            StagingNotPrivate
            StagingNotSingleLink
            StagingNameMismatch
            IdentityChanged
            InvalidPublicationState
            CloseNotReady
            WriteNotReady
            SyncNotReady
            DescriptorProofMismatch
            InvalidWriteBuffer
            WriteLimitExceeded
            WriteFailed
            SyncFailed
            StageRemoveNotReady
            StageRemoveFailed
            StageRemovalOutcomeUnknown
            RenameRejected
            PublicationOutcomeUnknown
            DirectorySyncFailed


    private:
        const module DarwinPublicationErrno:
            # Keep the publication adapter's syscall error values explicitly
            # 32-bit to match the platform errno reference type.
            ENOENT: i32 = 2
            EIO: i32 = 5


        const enum PublicationWriteState of u8:
            Write
            Done
            Failed


        struct PublicationWriteCursor:
            state: PublicationWriteState = PublicationWriteState.Write
            offset: usize = 0
            calls: usize = 0
            eintr_retries: usize = 0


        def publication_posix_stat_descriptor(descriptor: int, result: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_fstat(descriptor, result) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::STAT_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def publication_posix_stat_name(parent_fd: int, leaf_name: cstr, result: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                status: int = elisascript_posix_fstatat(parent_fd, leaf_name, result, DarwinAtFlag::SYMLINK_NOFOLLOW)
                return true if status == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::STAT_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def publication_posix_same_inode(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return left.device == right.device and left.inode == right.inode


        def publication_posix_directory(stat: ElisascriptStat) -> bool:
            return (stat.mode & DarwinStatMode::MASK) == DarwinStatMode::DIRECTORY


        def publication_posix_regular(stat: ElisascriptStat) -> bool:
            return (stat.mode & DarwinStatMode::MASK) == DarwinStatMode::REGULAR


        def publication_posix_private(stat: ElisascriptStat) -> bool:
            # Group and other rwx bits must be clear. Owner permissions may be
            # narrowed by the caller without weakening privacy.
            return (stat.mode & 63u16) == 0u16


        def publication_host_proof_equal(left: PublicationHostProof, right: PublicationHostProof) -> bool:
            return false if left.parent.device != right.parent.device or left.parent.inode != right.parent.inode or left.parent.descriptor_token != right.parent.descriptor_token or left.parent.owner_token != right.parent.owner_token or left.parent.directory != right.parent.directory
            return false if left.staging.device != right.staging.device or left.staging.inode != right.staging.inode or left.staging.parent_device != right.staging.parent_device or left.staging.parent_inode != right.staging.parent_inode or left.staging.descriptor_token != right.staging.descriptor_token or left.staging.owner_token != right.staging.owner_token or left.staging.link_count != right.staging.link_count or left.staging.regular != right.staging.regular or left.staging.private_mode != right.staging.private_mode
            return true


    public:
        # Confirm the stage fd, its current directory entry, and the parent fd
        # all identify the same-filesystem private sibling. `owner_token` must
        # be minted by the caller and retained for this descriptor pair.
        # Call again just before rename and compare both returned proofs with
        # the initially admitted proofs; concurrent mutation can invalidate a
        # previous snapshot between operations.
        def capture_publication_host_proof(parent_fd: int, staging_fd: int, leaf_name: cstr, owner_token: u64) -> PublicationHostProof error[PublicationPosixError] can[Blocking.IO]:
            raise PublicationPosixError.InvalidDescriptor if parent_fd < 0 or staging_fd < 0 or parent_fd == staging_fd
            raise PublicationPosixError.InvalidOwnerToken if owner_token == 0
            raise PublicationPosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(leaf_name)

            parent_info: mutable ElisascriptStat = ElisascriptStat{}
            raise PublicationPosixError.ParentStatFailed if not publication_posix_stat_descriptor(parent_fd, parent_info)
            raise PublicationPosixError.ParentNotDirectory if not publication_posix_directory(parent_info)

            staging_info: mutable ElisascriptStat = ElisascriptStat{}
            raise PublicationPosixError.StagingStatFailed if not publication_posix_stat_descriptor(staging_fd, staging_info)
            raise PublicationPosixError.StagingNotRegular if not publication_posix_regular(staging_info)
            raise PublicationPosixError.StagingNotPrivate if not publication_posix_private(staging_info)
            raise PublicationPosixError.StagingNotSingleLink if staging_info.link_count != 1u16

            named_info: mutable ElisascriptStat = ElisascriptStat{}
            raise PublicationPosixError.NameStatFailed if not publication_posix_stat_name(parent_fd, leaf_name, named_info)
            raise PublicationPosixError.StagingNameMismatch if not publication_posix_same_inode(staging_info, named_info) or not publication_posix_regular(named_info) or not publication_posix_private(named_info) or named_info.link_count != 1u16
            raise PublicationPosixError.StagingNameMismatch if not publication_posix_same_inode(parent_info, staging_info)

            parent_proof: PublicationParentProof = PublicationParentProof{device: parent_info.device.u64(), inode: parent_info.inode, descriptor_token: parent_fd.u64() + 1u64, owner_token: owner_token, directory: true}
            staging_proof: PublicationStagingProof = PublicationStagingProof{device: staging_info.device.u64(), inode: staging_info.inode, parent_device: parent_info.device.u64(), parent_inode: parent_info.inode, descriptor_token: staging_fd.u64() + 1u64, owner_token: owner_token, link_count: staging_info.link_count.usize(), regular: true, private_mode: true}
            return PublicationHostProof{parent: parent_proof, staging: staging_proof}


        # Re-observe immediately before rename. A mismatch is a hard refusal;
        # callers must not ignore it or fall back to path-based publication.
        # Because another writer can mutate the directory after this function
        # returns, use this only with the publication parent protected by the
        # adapter's declared ownership/locking policy.
        def revalidate_publication_host_proof(parent_fd: int, staging_fd: int, leaf_name: cstr, owner_token: u64, expected: PublicationHostProof) -> PublicationHostProof error[PublicationPosixError] can[Blocking.IO]:
            observed: PublicationHostProof = try capture_publication_host_proof(parent_fd, staging_fd, leaf_name, owner_token)
            raise PublicationPosixError.IdentityChanged if not publication_host_proof_equal(expected, observed)
            return observed


        # Close each owned descriptor exactly once. POSIX close errors can
        # leave descriptor state ambiguous, so they are never retried; the
        # publication machine records mixed/failed outcomes as terminal
        # CleanupUncertain instead of claiming cleanup or risking fd reuse.
        def close_publication_descriptors(session: mutable PublicationSession&, parent_fd: int, staging_fd: int) -> PublicationState error[PublicationPosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            raise PublicationPosixError.InvalidDescriptor if parent_fd < 0 or staging_fd < 0 or parent_fd == staging_fd
            raise PublicationPosixError.CloseNotReady if session.state != PublicationState.Staging and session.state != PublicationState.StageWriteFailed and session.state != PublicationState.Staged and session.state != PublicationState.StageRemoved and session.state != PublicationState.Published and session.state != PublicationState.PublishedUncertain
            raise PublicationPosixError.CloseNotReady if not session.parent_descriptor_owned or session.parent_descriptor_closed or not session.descriptor_owned or session.descriptor_closed
            raise PublicationPosixError.DescriptorProofMismatch if session.parent_proof.descriptor_token != parent_fd.u64() + 1u64 or session.staging_proof.descriptor_token != staging_fd.u64() + 1u64
            catch validate_publication(session):
                ok:
                    pass
                error failure:
                    raise PublicationPosixError.InvalidPublicationState
            staging_close_status: int = elisascript_posix_close(staging_fd)
            parent_close_status: int = elisascript_posix_close(parent_fd)
            stage_close_succeeded: bool = staging_close_status == 0
            parent_close_succeeded: bool = parent_close_status == 0
            if stage_close_succeeded and parent_close_succeeded:
                catch advance_publication(session, PublicationEvent.Close):
                    ok state:
                        return state
                    error failure:
                        raise PublicationPosixError.InvalidPublicationState
            catch advance_publication(session, PublicationEvent.CloseOutcomeUnknown, stage_close_succeeded: stage_close_succeeded, parent_close_succeeded: parent_close_succeeded):
                ok state:
                    return state
                error failure:
                    raise PublicationPosixError.InvalidPublicationState


        # Remove the admitted staging name before close. The caller must hold
        # its declared exclusive directory-mutation lease for this operation;
        # otherwise another writer could replace the name after revalidation.
        def remove_publication_stage(session: mutable PublicationSession&, parent_fd: int, staging_fd: int, leaf_name: cstr) -> PublicationState error[PublicationPosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            raise PublicationPosixError.InvalidDescriptor if parent_fd < 0 or staging_fd < 0 or parent_fd == staging_fd
            catch validate_publication(session):
                ok:
                    pass
                error failure:
                    raise PublicationPosixError.InvalidPublicationState
            raise PublicationPosixError.StageRemoveNotReady if session.state != PublicationState.Staging and session.state != PublicationState.StageWriteFailed and session.state != PublicationState.Staged
            raise PublicationPosixError.StageRemoveNotReady if not session.parent_descriptor_owned or session.parent_descriptor_closed or not session.descriptor_owned or session.descriptor_closed or session.stage_entry_removed
            raise PublicationPosixError.DescriptorProofMismatch if session.parent_proof.descriptor_token != parent_fd.u64() + 1u64 or session.staging_proof.descriptor_token != staging_fd.u64() + 1u64
            expected: PublicationHostProof = PublicationHostProof{parent: session.parent_proof, staging: session.staging_proof}
            _ = try revalidate_publication_host_proof(parent_fd, staging_fd, leaf_name, session.parent_proof.owner_token, expected)

            remove_status: mutable int = -1
            catch elisascript_posix_unlinkat_leaf(parent_fd, leaf_name):
                ok status:
                    remove_status <- status
                error failure:
                    raise PublicationPosixError.InvalidLeafName
            if remove_status == 0:
                catch advance_publication(session, PublicationEvent.StageRemove):
                    ok state:
                        return state
                    error failure:
                        raise PublicationPosixError.InvalidPublicationState

            errno: mutable i32& = elisascript_posix_errno()
            if errno[0] == DarwinPublicationErrno::ENOENT:
                # Under the caller's exclusive directory lease, ENOENT means
                # there is no staging entry left to clean up.
                catch advance_publication(session, PublicationEvent.StageRemove):
                    ok state:
                        return state
                    error failure:
                        raise PublicationPosixError.InvalidPublicationState
            if errno[0] != DarwinPublicationErrno::EIO:
                raise PublicationPosixError.StageRemoveFailed

            _ = try close_publication_descriptors(session, parent_fd, staging_fd)
            if session.state != PublicationState.CleanupUncertain:
                catch advance_publication(session, PublicationEvent.StageRemoveOutcomeUnknown):
                    ok state:
                        pass
                    error failure:
                        raise PublicationPosixError.InvalidPublicationState
            raise PublicationPosixError.StageRemovalOutcomeUnknown


        # Write all admitted bytes despite short writes and bounded EINTR.
        # A failed partial write is surfaced; callers must leave the old
        # destination untouched and clean up the private staging file.
        def write_publication_stage_fully(fd: int, buffer: u8&, length: usize) -> usize error[PublicationPosixError] can[Blocking.IO]:
            raise PublicationPosixError.InvalidDescriptor if fd < 0
            raise PublicationPosixError.InvalidWriteBuffer if length != 0 and buffer == null
            raise PublicationPosixError.WriteLimitExceeded if length > Limits::MAX_BYTES
            cursor: mutable PublicationWriteCursor = PublicationWriteCursor{}
            machine over cursor.state:
                state Write
                start Write

                Write, PublicationWriteState.Write if cursor.offset >= length:
                    cursor.state <- PublicationWriteState.Done
                    -> Write
                Write, PublicationWriteState.Write:
                    if cursor.calls >= Limits::WRITE_CALLS:
                        cursor.state <- PublicationWriteState.Failed
                        -> Write
                    remaining: usize = length - cursor.offset
                    next_bytes: mutable u8& = buffer + cursor.offset
                    amount: isize = elisascript_posix_write(fd, next_bytes.cast[void&], remaining)
                    cursor.calls <- cursor.calls + 1
                    if amount < 0:
                        errno: mutable i32& = elisascript_posix_errno()
                        if errno[0] == DarwinErrno::EINTR and cursor.eintr_retries < Limits::IO_EINTR_RETRIES:
                            cursor.eintr_retries <- cursor.eintr_retries + 1
                            -> Write
                        cursor.state <- PublicationWriteState.Failed
                        -> Write
                    if amount == 0 or amount.usize() > remaining:
                        cursor.state <- PublicationWriteState.Failed
                        -> Write
                    cursor.offset <- cursor.offset + amount.usize()
                    cursor.eintr_retries <- 0
                    -> Write

                Write, PublicationWriteState.Done:
                    break
                Write, PublicationWriteState.Failed:
                    break

            raise PublicationPosixError.WriteFailed if cursor.state != PublicationWriteState.Done
            return cursor.offset


        # Count bytes in the pure publication machine only after the complete
        # host write succeeds. Descriptor token and current leaf identity are
        # rechecked before touching the staging inode.
        def write_publication_stage(session: mutable PublicationSession&, parent_fd: int, staging_fd: int, leaf_name: cstr, buffer: u8&, length: usize) -> usize error[PublicationPosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            raise PublicationPosixError.InvalidDescriptor if parent_fd < 0 or staging_fd < 0 or parent_fd == staging_fd
            catch validate_publication(session):
                ok:
                    pass
                error failure:
                    raise PublicationPosixError.InvalidPublicationState
            raise PublicationPosixError.WriteNotReady if session.state != PublicationState.Staging or not session.parent_descriptor_owned or session.parent_descriptor_closed or not session.descriptor_owned or session.descriptor_closed
            raise PublicationPosixError.WriteLimitExceeded if length == 0 or length > session.request.bytes - session.bytes_written
            raise PublicationPosixError.DescriptorProofMismatch if session.parent_proof.descriptor_token != parent_fd.u64() + 1u64 or session.staging_proof.descriptor_token != staging_fd.u64() + 1u64
            expected: PublicationHostProof = PublicationHostProof{parent: session.parent_proof, staging: session.staging_proof}
            _ = try revalidate_publication_host_proof(parent_fd, staging_fd, leaf_name, session.parent_proof.owner_token, expected)
            written: mutable usize = 0
            catch write_publication_stage_fully(staging_fd, buffer, length):
                ok amount:
                    written <- amount
                error failure:
                    if failure == PublicationPosixError.WriteFailed:
                        catch advance_publication(session, PublicationEvent.WriteFailed):
                            ok state:
                                pass
                            error transition_failure:
                                raise PublicationPosixError.InvalidPublicationState
                    raise failure
            catch advance_publication(session, PublicationEvent.Write, written):
                ok state:
                    return written
                error failure:
                    raise PublicationPosixError.InvalidPublicationState


        # Sync a retained descriptor with bounded EINTR retry. Staging and
        # parent-directory callers interpret failure according to their phase.
        def sync_publication_descriptor(fd: int) -> bool error[PublicationPosixError] can[Blocking.IO]:
            raise PublicationPosixError.InvalidDescriptor if fd < 0
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_fsync(fd) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::IO_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                raise PublicationPosixError.SyncFailed


        # Sync is an acknowledged model transition only after the host reports
        # fsync success and the descriptor/name proof still matches admission.
        def sync_publication_stage(session: mutable PublicationSession&, parent_fd: int, staging_fd: int, leaf_name: cstr) -> PublicationState error[PublicationPosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            raise PublicationPosixError.InvalidDescriptor if parent_fd < 0 or staging_fd < 0 or parent_fd == staging_fd
            catch validate_publication(session):
                ok:
                    pass
                error failure:
                    raise PublicationPosixError.InvalidPublicationState
            raise PublicationPosixError.SyncNotReady if session.state != PublicationState.Staging or not session.parent_descriptor_owned or session.parent_descriptor_closed or not session.descriptor_owned or session.descriptor_closed or session.bytes_written != session.request.bytes
            raise PublicationPosixError.DescriptorProofMismatch if session.parent_proof.descriptor_token != parent_fd.u64() + 1u64 or session.staging_proof.descriptor_token != staging_fd.u64() + 1u64
            expected: PublicationHostProof = PublicationHostProof{parent: session.parent_proof, staging: session.staging_proof}
            _ = try revalidate_publication_host_proof(parent_fd, staging_fd, leaf_name, session.parent_proof.owner_token, expected)
            _ = try sync_publication_descriptor(staging_fd)
            catch advance_publication(session, PublicationEvent.Sync):
                ok state:
                    return state
                error failure:
                    raise PublicationPosixError.InvalidPublicationState


        # Rename the admitted staging sibling to a destination sibling. A
        # non-EIO rename error is specified to leave the destination
        # unaffected; EIO and a failed directory fsync are not reported as a
        # clean rollback. Never retry rename after an error.
        def publish_staged(session: mutable PublicationSession&, parent_fd: int, staging_fd: int, staging_leaf: cstr, destination_leaf: cstr) -> PublicationState error[PublicationPosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            raise PublicationPosixError.InvalidDescriptor if parent_fd < 0 or staging_fd < 0 or parent_fd == staging_fd
            raise PublicationPosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(staging_leaf) or not elisascript_posix_leaf_name_valid(destination_leaf)
            catch validate_publication(session):
                ok:
                    pass
                error failure:
                    raise PublicationPosixError.InvalidPublicationState
            raise PublicationPosixError.InvalidPublicationState if session.state != PublicationState.Staged or not session.parent_descriptor_owned or session.parent_descriptor_closed or not session.descriptor_owned or session.descriptor_closed or not session.stage_synced
            raise PublicationPosixError.DescriptorProofMismatch if session.parent_proof.descriptor_token != parent_fd.u64() + 1u64 or session.staging_proof.descriptor_token != staging_fd.u64() + 1u64
            expected: PublicationHostProof = PublicationHostProof{parent: session.parent_proof, staging: session.staging_proof}
            _ = try revalidate_publication_host_proof(parent_fd, staging_fd, staging_leaf, session.parent_proof.owner_token, expected)
            catch advance_publication(session, PublicationEvent.Publish):
                ok state:
                    pass
                error failure:
                    raise PublicationPosixError.InvalidPublicationState

            rename_status: mutable int = -1
            catch elisascript_posix_renameat(parent_fd, staging_leaf, parent_fd, destination_leaf):
                ok status:
                    rename_status <- status
                error failure:
                    catch advance_publication(session, PublicationEvent.PublishFailed, destination_preserved: true):
                        ok state:
                            pass
                        error transition_failure:
                            raise PublicationPosixError.InvalidPublicationState
                    raise PublicationPosixError.InvalidLeafName
            if rename_status != 0:
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == DarwinPublicationErrno::EIO:
                    catch advance_publication(session, PublicationEvent.OutcomeUnknown, destination_preserved: false):
                        ok state:
                            pass
                        error failure:
                            raise PublicationPosixError.InvalidPublicationState
                    raise PublicationPosixError.PublicationOutcomeUnknown
                catch advance_publication(session, PublicationEvent.PublishFailed, destination_preserved: true):
                    ok state:
                        pass
                    error failure:
                        raise PublicationPosixError.InvalidPublicationState
                raise PublicationPosixError.RenameRejected

            directory_synced: bool = false
            if session.request.require_directory_sync:
                catch sync_publication_descriptor(parent_fd):
                    ok synced:
                        directory_synced <- synced
                    error failure:
                        catch advance_publication(session, PublicationEvent.DirectorySyncUnknown):
                            ok state:
                                pass
                            error transition_failure:
                                raise PublicationPosixError.InvalidPublicationState
                        raise PublicationPosixError.DirectorySyncFailed
            catch advance_publication(session, PublicationEvent.PublishAck, directory_synced: directory_synced):
                ok state:
                    return state
                error failure:
                    raise PublicationPosixError.InvalidPublicationState
