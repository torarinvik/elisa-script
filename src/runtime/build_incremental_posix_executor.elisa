# POSIX transaction boundary for incremental build execution.
#
# This adapter binds fresh source/output observations and toolchain-file
# identities to the signed graph before dispatch, then refreshes both before
# cache publication. A caller supplies already-resolved toolchain paths under
# the directory capability; this module never parses PATH or follows links.

module EsBuildIncrementalPosixExecutor:
    using EsBuild
    using EsBuildIncremental
    using EsBuildIncrementalGraph
    using EsBuildIncrementalCache
    using EsBuildIncrementalPosix
    using EsBuildExecutor
    using EsBuildRecipeSignature
    using EsArtifactCache
    using EsProcess
    using EsRuntime
    using EsIr

    public:
        error OutputInvalidationError:
            InvalidCachedOutput(path: sview)
            CachedOutputChanged(path: sview)
            ParentOpenFailed(path: sview, errno: i32)
            RemoveFailed(path: sview, errno: i32)
            RemovalOutcomeUnknown(path: sview)
            OutputStillPresent(path: sview)
            CloseFailed(path: sview)


        const module OutputInvalidationErrno:
            EIO: i32 = 5


        struct BuildIncrementalPosixExecution:
            result: BuildExecutionResult
            recipes: darray[BuildIncrementalRecipeTarget]
            pre_execution_observations: darray[BuildIncrementalObservation]
            toolchain_stamps: darray[darray[BuildIncrementalFileStamp]]


        # A cache payload is returned only after successful execution and fresh
        # post-build observations have been validated. Persistence remains a
        # separate caller-owned transaction so the host can publish atomically.
        struct BuildIncrementalPosixCacheCommit:
            commit: BuildIncrementalCommit
            cache_bytes: darray[u8]


        struct BuildIncrementalPosixCacheRun:
            execution: BuildIncrementalPosixExecution
            commit: BuildIncrementalCommit
            reused_cache: bool = false
            cache_published: bool = false
            cache_unchanged: bool = false


        def validate_build_recipe_toolchain_paths(graph: BuildGraph, resolutions: darray[BuildRecipeToolchainPath]) -> bool error[BuildContractError, ToolchainObservationError]:
            graph_valid: bool = try validate_build_graph(graph)
            raise BuildContractError.InvalidGraphState if not graph_valid
            raise ToolchainObservationError.ToolchainPathCountMismatch if resolutions.count != graph.nodes.count
            for index in 0..<resolutions.count |graph, resolutions|:
                raise ToolchainObservationError.ToolchainCommandMismatch(index) if resolutions[index].command_executable != graph.nodes[index].command.executable
                raise ToolchainObservationError.InvalidToolchainPath(index) if not build_incremental_path_is_canonical_relative(resolutions[index].path)
                if graph.nodes[index].command.environment_mode == ProcessEnvironmentMode.Inherit:
                    raise ToolchainObservationError.UnexpectedEnvironmentShim(index) if resolutions[index].helper_paths.count != 0
                else:
                    raise ToolchainObservationError.MissingEnvironmentShim(index) if resolutions[index].helper_paths.count != 1
                    raise ToolchainObservationError.MissingEnvironmentShim(index) if resolutions[index].helper_paths[0] != "usr/bin/env"
                for helper_path in resolutions[index].helper_paths:
                    raise ToolchainObservationError.InvalidToolchainPath(index) if not build_incremental_path_is_canonical_relative(helper_path)
                    raise ToolchainObservationError.EnvironmentShimLimitExceeded if sview_len(helper_path) > EsBuildIncremental::Limits::PATH_BYTES
            return true


        def validate_build_recipe_toolchain_identity(path: sview, expected: BuildRecipeToolchainIdentity, observed: BuildRecipeToolchainIdentity) -> bool error[ToolchainObservationError]:
            raise ToolchainObservationError.ToolchainChanged(path) if expected != observed
            return true


        def validate_build_recipe_toolchain_stamp(expected: BuildIncrementalFileStamp, observed: BuildIncrementalFileStamp) -> bool error[ToolchainObservationError]:
            same_stamp: bool = expected.path == observed.path
                and expected.present == observed.present
                and expected.size == observed.size
                and expected.device == observed.device
                and expected.inode == observed.inode
                and expected.permissions == observed.permissions
                and expected.modify_time.seconds == observed.modify_time.seconds
                and expected.modify_time.nanoseconds == observed.modify_time.nanoseconds
                and expected.change_time.seconds == observed.change_time.seconds
                and expected.change_time.nanoseconds == observed.change_time.nanoseconds
            raise ToolchainObservationError.ToolchainChanged(expected.path) if not same_stamp
            return true


        # Equality for the content files behind a resolved command. The
        # command spelling itself remains part of the per-node recipe
        # signature and is checked separately against its graph node.
        def build_recipe_toolchain_file_set_equal(left: BuildRecipeToolchainPath, right: BuildRecipeToolchainPath) -> bool:
            return false if left.path != right.path or left.helper_paths.count != right.helper_paths.count
            for index in 0..<left.helper_paths.count |left, right|:
                return false if left.helper_paths[index] != right.helper_paths[index]
            return true


    private:
        const module OutputInvalidationLimits:
            OPEN_EINTR_RETRIES: usize = 8


        const module ToolchainIndex:
            FNV_OFFSET: u64 = 14695981039346656037u64
            FNV_PRIME: u64 = 1099511628211u64
            MAX_PROBES: usize = 64


        def build_incremental_output_openat(directory_fd: int, component: cstr, flags: int, errno_out: mutable i32&) -> int can[Blocking.IO, Unsafe.PointerCast]:
            retries: mutable usize = 0
            while true:
                descriptor: int = elisascript_posix_openat(directory_fd, component, flags, 0u32)
                return descriptor if descriptor >= 0
                errno: mutable i32& = elisascript_posix_errno()
                errno_out[0] <- errno[0]
                if errno[0] == DarwinErrno::EINTR and retries < OutputInvalidationLimits::OPEN_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return -1


        def build_incremental_output_close_owned(descriptor: int, root_fd: int) -> bool can[Blocking.IO]:
            return true if descriptor == root_fd
            return elisascript_posix_close(descriptor) == 0


        struct BuildRecipeToolchainIndexEntry:
            occupied: bool = false
            hash: u64 = 0
            resolution_index: usize = 0


        # This destructive primitive is private to the executor so it cannot
        # be called outside the cache-locked transaction below.
        def invalidate_build_incremental_output_at(scratch: mutable Arena&, root_fd: int, cached_output: BuildIncrementalFile, require_cached_content: bool) -> bool error[OutputInvalidationError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            path: sview = cached_output.path
            raise OutputInvalidationError.InvalidCachedOutput(path) if not build_incremental_path_is_canonical_relative(path)
            raise OutputInvalidationError.InvalidCachedOutput(path) if require_cached_content and cached_output.fingerprint == 0 and cached_output.fingerprint_word1 == 0 and cached_output.fingerprint_word2 == 0 and cached_output.fingerprint_word3 == 0
            current: BuildIncrementalObservation = try observe_build_incremental_file_at(scratch, root_fd, path)
            return true if not current.present
            if require_cached_content:
                matches_cached_content: bool = current.fingerprint == cached_output.fingerprint and current.fingerprint_word1 == cached_output.fingerprint_word1 and current.fingerprint_word2 == cached_output.fingerprint_word2 and current.fingerprint_word3 == cached_output.fingerprint_word3
                raise OutputInvalidationError.CachedOutputChanged(path) if not matches_cached_content

            path_length: usize = sview_len(path)
            leaf_start: mutable usize = 0
            for index in 0..<path_length:
                leaf_start <- index + 1 if sview_at(path, index) == 47
            leaf_storage: mutable u8[EsBuildIncremental::Limits::PATH_BYTES] = zeroed
            component_storage: mutable u8[EsBuildIncremental::Limits::PATH_BYTES] = zeroed
            leaf: mutable u8& = &leaf_storage[0]
            component: mutable u8& = &component_storage[0]
            leaf_length: usize = path_length - leaf_start
            for index in 0..<leaf_length:
                leaf[index] <- sview_at(path, leaf_start + index)
            leaf[leaf_length] <- 0

            parent_fd: mutable int = root_fd
            segment_start: mutable usize = 0
            parent_length: usize = leaf_start if leaf_start == 0 else leaf_start - 1
            while segment_start < parent_length |component, parent_fd, segment_start|:
                segment_end: mutable usize = segment_start
                while segment_end < leaf_start and sview_at(path, segment_end) != 47:
                    segment_end <- segment_end + 1
                component_length: usize = segment_end - segment_start
                for index in 0..<component_length |component, index|:
                    component[index] <- sview_at(path, segment_start + index)
                component[component_length] <- 0
                errno_out: mutable i32 = 0
                next_fd: int = build_incremental_output_openat(parent_fd, component.cast[cstr], DarwinOpenFlags::RDONLY | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::DIRECTORY | DarwinOpenFlags::CLOSE_ON_EXEC, errno_out)
                if next_fd < 0:
                    parent_close_ok: bool = build_incremental_output_close_owned(parent_fd, root_fd)
                    raise OutputInvalidationError.CloseFailed(path) if not parent_close_ok
                    raise OutputInvalidationError.ParentOpenFailed(path, errno_out[0])
                parent_close_ok: bool = build_incremental_output_close_owned(parent_fd, root_fd)
                if not parent_close_ok:
                    _ = elisascript_posix_close(next_fd)
                    raise OutputInvalidationError.CloseFailed(path)
                parent_fd <- next_fd
                segment_start <- segment_end + 1

            remove_status: mutable int = -1
            catch elisascript_posix_unlinkat_leaf(parent_fd, leaf.cast[cstr]):
                ok status:
                    remove_status <- status
                error failure:
                    parent_close_ok: bool = build_incremental_output_close_owned(parent_fd, root_fd)
                    raise OutputInvalidationError.CloseFailed(path) if not parent_close_ok
                    raise OutputInvalidationError.InvalidCachedOutput(path)
            if remove_status != 0:
                errno: mutable i32& = elisascript_posix_errno()
                remove_errno: i32 = errno[0]
                missing_after_race: bool = remove_errno == DarwinErrno::ENOENT
                if not missing_after_race:
                    parent_close_ok: bool = build_incremental_output_close_owned(parent_fd, root_fd)
                    raise OutputInvalidationError.CloseFailed(path) if not parent_close_ok
                    raise OutputInvalidationError.RemovalOutcomeUnknown(path) if remove_errno == OutputInvalidationErrno::EIO or remove_errno == DarwinErrno::EINTR
                    raise OutputInvalidationError.RemoveFailed(path, remove_errno)
            parent_close_ok: bool = build_incremental_output_close_owned(parent_fd, root_fd)
            raise OutputInvalidationError.CloseFailed(path) if not parent_close_ok
            after: BuildIncrementalObservation = try observe_build_incremental_file_at(scratch, root_fd, path)
            raise OutputInvalidationError.OutputStillPresent(path) if after.present
            return true


        # Once a node has started, its declared outputs were absent at the
        # dispatch boundary and any files now at those paths are command
        # products. If the serial graph fails, discard all outputs of started
        # nodes so the previous manifest can safely drive a retry. Unstarted
        # nodes retain their prior cached outputs. This relies on the existing
        # exclusive build-root ownership contract for the duration of a run.
        def cleanup_failed_build_graph_outputs_at(scratch: mutable Arena&, root_fd: int, results: darray[BuildExecutionNodeResult], recipes: darray[BuildIncrementalRecipeTarget]) -> bool error[BuildIncrementalError, OutputInvalidationError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            raise BuildIncrementalError.CurrentRecipeShapeInvalid if results.count != recipes.count
            for node_index in 0..<results.count |results, recipes, scratch|:
                continue if not results[node_index].started
                for output_path in recipes[node_index].outputs |scratch|:
                    _ = try observe_build_incremental_file_at(scratch, root_fd, output_path)
            for node_index in 0..<results.count |results, recipes, scratch|:
                continue if not results[node_index].started
                for output_path in recipes[node_index].outputs |scratch|:
                    _ = try invalidate_build_incremental_output_at(scratch, root_fd, BuildIncrementalFile{path: output_path}, false)
            return true


        # Stale outputs belong to the previous committed graph but are not
        # inputs or outputs of the new one. Validate the full stale set before
        # deleting any artifact, then revalidate each path immediately before
        # its no-follow unlink. A modified or unowned stale path is preserved.
        def cleanup_stale_build_outputs_at(scratch: mutable Arena&, root_fd: int, stale_outputs: darray[BuildIncrementalStaleOutput]) -> bool error[OutputInvalidationError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            for stale in stale_outputs |scratch|:
                output: BuildIncrementalFile = stale.output
                path: sview = output.path
                raise OutputInvalidationError.InvalidCachedOutput(path) if not build_incremental_path_is_canonical_relative(path)
                raise OutputInvalidationError.InvalidCachedOutput(path) if output.fingerprint == 0 and output.fingerprint_word1 == 0 and output.fingerprint_word2 == 0 and output.fingerprint_word3 == 0
                current: BuildIncrementalObservation = try observe_build_incremental_file_at(scratch, root_fd, path)
                if current.present:
                    matches_cached_content: bool = current.fingerprint == output.fingerprint and current.fingerprint_word1 == output.fingerprint_word1 and current.fingerprint_word2 == output.fingerprint_word2 and current.fingerprint_word3 == output.fingerprint_word3
                    raise OutputInvalidationError.CachedOutputChanged(path) if not matches_cached_content
            for stale in stale_outputs |scratch|:
                _ = try invalidate_build_incremental_output_at(scratch, root_fd, stale.output, true)
            return true


        def build_incremental_posix_find_observation(observations: darray[BuildIncrementalObservation], path: sview, output: mutable BuildIncrementalObservation&) -> bool:
            for observation in observations:
                if observation.path == path:
                    output[0] <- observation
                    return true
            return false


        def build_incremental_posix_find_cached_output(previous_targets: darray[BuildIncrementalTarget], path: sview, output: mutable BuildIncrementalFile&) -> bool:
            for target in previous_targets |output|:
                for cached_output in target.outputs |output|:
                    if cached_output.path == path:
                        output[0] <- cached_output
                        return true
            return false


        # Validate one node's complete output set before deleting any of its
        # artifacts. The caller invokes this immediately before that node's
        # command, after dependencies have succeeded.
        def invalidate_dirty_build_target_outputs_at(scratch: mutable Arena&, root_fd: int, target_index: usize, previous_targets: darray[BuildIncrementalTarget], recipes: darray[BuildIncrementalRecipeTarget], observations: darray[BuildIncrementalObservation]) -> bool error[BuildIncrementalError, OutputInvalidationError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            raise BuildIncrementalError.CurrentRecipeShapeInvalid if target_index >= recipes.count
            recipe: BuildIncrementalRecipeTarget = recipes[target_index]
            for output_path in recipe.outputs |recipe, observations, previous_targets|:
                observed: mutable BuildIncrementalObservation = BuildIncrementalObservation{}
                raise BuildIncrementalError.ObservationSetMismatch if not build_incremental_posix_find_observation(observations, output_path, observed)
                continue if not observed.present
                cached: mutable BuildIncrementalFile = BuildIncrementalFile{path: ""}
                if not build_incremental_posix_find_cached_output(previous_targets, output_path, cached):
                    raise BuildIncrementalError.OutputInvalidationOwnershipMissing(output_path)
                matches_cache: bool = observed.fingerprint == cached.fingerprint and observed.fingerprint_word1 == cached.fingerprint_word1 and observed.fingerprint_word2 == cached.fingerprint_word2 and observed.fingerprint_word3 == cached.fingerprint_word3
                raise BuildIncrementalError.OutputInvalidationFingerprintChanged(output_path) if not matches_cache

            for output_path in recipe.outputs |recipe, observations, previous_targets, scratch|:
                observed: mutable BuildIncrementalObservation = BuildIncrementalObservation{}
                raise BuildIncrementalError.ObservationSetMismatch if not build_incremental_posix_find_observation(observations, output_path, observed)
                cached: mutable BuildIncrementalFile = BuildIncrementalFile{path: ""}
                if build_incremental_posix_find_cached_output(previous_targets, output_path, cached):
                    _ = try invalidate_build_incremental_output_at(scratch, root_fd, cached, true)
                elif observed.present:
                    raise BuildIncrementalError.OutputInvalidationOwnershipMissing(output_path)
                else:
                    current: BuildIncrementalObservation = try observe_build_incremental_file_at(scratch, root_fd, output_path)
                    raise BuildIncrementalError.OutputInvalidationOwnershipMissing(output_path) if current.present
            return true


        def toolchain_identity_mix_bytes(bytes: mutable darray[u8]&, value: u64) -> void can[Memory.Allocate, Abort.Panic]:
            for shift in 0..<8 |bytes, value|:
                bytes.push((value >> (shift * 8)).u8())


        def toolchain_index_hash_byte(hash: u64, value: u8) -> u64:
            return EsHash::hash_wrapping_multiply_u64(hash ^ value.u64(), ToolchainIndex::FNV_PRIME)


        def toolchain_index_hash_u64(hash: u64, value: u64) -> u64:
            result: mutable u64 = hash
            for shift in 0..<8 |result, value|:
                result <- toolchain_index_hash_byte(result, (value >> (shift * 8)).u8())
            return result


        def toolchain_index_hash_text(hash: u64, value: sview) -> u64:
            result: mutable u64 = toolchain_index_hash_u64(hash, sview_len(value).u64())
            for byte in value |result|:
                result <- toolchain_index_hash_byte(result, byte)
            return result


        def build_recipe_toolchain_file_set_hash(resolution: BuildRecipeToolchainPath) -> u64:
            hash: mutable u64 = ToolchainIndex::FNV_OFFSET
            hash <- toolchain_index_hash_text(hash, resolution.path)
            hash <- toolchain_index_hash_u64(hash, resolution.helper_paths.count.u64())
            for helper_path in resolution.helper_paths |hash|:
                hash <- toolchain_index_hash_text(hash, helper_path)
            return hash


        def observe_build_recipe_toolchain_set_at(scratch: mutable Arena&, root_fd: int, resolution: BuildRecipeToolchainPath, stamps: mutable darray[BuildIncrementalFileStamp]&) -> BuildRecipeToolchainIdentity error[OpenError, ObserveError, ToolchainObservationError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            primary_observation: BuildRecipeToolchainFileObservation = try observe_build_recipe_toolchain_file_at(scratch, root_fd, resolution.path)
            stamps[0].push(primary_observation.stamp)
            primary: BuildRecipeToolchainIdentity = primary_observation.identity
            return primary if resolution.helper_paths.count == 0
            bytes: mutable darray[u8] = [69u8, 83u8, 84u8, 67u8, 1u8]
            toolchain_identity_mix_bytes(bytes, primary.word0)
            toolchain_identity_mix_bytes(bytes, primary.word1)
            toolchain_identity_mix_bytes(bytes, primary.word2)
            toolchain_identity_mix_bytes(bytes, primary.word3)
            toolchain_identity_mix_bytes(bytes, resolution.helper_paths.count.u64())
            for helper_path in resolution.helper_paths |bytes, scratch, root_fd|:
                toolchain_identity_mix_bytes(bytes, sview_len(helper_path).u64())
                for byte in helper_path |bytes|:
                    bytes.push(byte)
                helper_observation: BuildRecipeToolchainFileObservation = try observe_build_recipe_toolchain_file_at(scratch, root_fd, helper_path)
                stamps[0].push(helper_observation.stamp)
                helper: BuildRecipeToolchainIdentity = helper_observation.identity
                toolchain_identity_mix_bytes(bytes, helper.word0)
                toolchain_identity_mix_bytes(bytes, helper.word1)
                toolchain_identity_mix_bytes(bytes, helper.word2)
                toolchain_identity_mix_bytes(bytes, helper.word3)
            return BuildRecipeToolchainIdentity{
                word0: EsIr::canonical_bytes_sha256_word(bytes, 0),
                word1: EsIr::canonical_bytes_sha256_word(bytes, 1),
                word2: EsIr::canonical_bytes_sha256_word(bytes, 2),
                word3: EsIr::canonical_bytes_sha256_word(bytes, 3)
            }


        def observe_build_recipe_toolchains_at(scratch: mutable Arena&, root_fd: int, graph: BuildGraph, resolutions: darray[BuildRecipeToolchainPath], stamp_sets: mutable darray[darray[BuildIncrementalFileStamp]]&) -> darray[BuildRecipeToolchainIdentity] error[OpenError, ObserveError, ToolchainObservationError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            raise ToolchainObservationError.ToolchainPathCountMismatch if resolutions.count != graph.nodes.count
            table_capacity: usize = resolutions.count * 2 + 1
            slots: mutable darray[BuildRecipeToolchainIndexEntry] = []
            for unused in 0..<table_capacity |slots|:
                slots.push(BuildRecipeToolchainIndexEntry{})
            identities: mutable darray[BuildRecipeToolchainIdentity] = []
            unique_indices: mutable darray[usize] = []
            for index in 0..<resolutions.count |graph, resolutions, identities, scratch, stamp_sets, slots, unique_indices|:
                resolution: BuildRecipeToolchainPath = resolutions[index]
                raise ToolchainObservationError.ToolchainCommandMismatch(index) if resolution.command_executable != graph.nodes[index].command.executable
                hash: u64 = build_recipe_toolchain_file_set_hash(resolution)
                slot_index: mutable usize = (hash % slots.count.u64()).usize()
                probes: mutable usize = 0
                cached_index: mutable usize = index
                while true:
                    slot: BuildRecipeToolchainIndexEntry = slots[slot_index]
                    if not slot.occupied:
                        slots[slot_index] <- BuildRecipeToolchainIndexEntry{occupied: true, hash: hash, resolution_index: index}
                        unique_indices.push(index)
                        break
                    if slot.hash == hash and build_recipe_toolchain_file_set_equal(resolutions[slot.resolution_index], resolution):
                        cached_index <- slot.resolution_index
                        break
                    probes <- probes + 1
                    raise ToolchainObservationError.ToolchainIndexProbeLimitExceeded if probes >= ToolchainIndex::MAX_PROBES
                    slot_index <- slot_index + 1
                    slot_index <- 0 if slot_index == slots.count
                if cached_index < index:
                    identities.push(identities[cached_index])
                    copied_stamps: mutable darray[BuildIncrementalFileStamp] = []
                    previous_stamps: darray[BuildIncrementalFileStamp] = stamp_sets[0][cached_index]
                    for stamp in previous_stamps |copied_stamps|:
                        copied_stamps.push(stamp)
                    stamp_sets[0].push(copied_stamps)
                    continue
                stamps: mutable darray[BuildIncrementalFileStamp] = []
                identities.push(try observe_build_recipe_toolchain_set_at(scratch, root_fd, resolution, stamps))
                stamp_sets[0].push(stamps)
            # Recheck each unique set after the final content hash so an early
            # toolchain cannot drift while later distinct sets are being read.
            for unique_index in unique_indices |unique_indices, stamp_sets, root_fd|:
                stamps: darray[BuildIncrementalFileStamp] = stamp_sets[0][unique_index]
                for stamp in stamps |stamps, root_fd|:
                    current: BuildIncrementalFileStamp = try observe_build_incremental_file_stamp_at(root_fd, stamp.path)
                    _ = try validate_build_recipe_toolchain_stamp(stamp, current)
            return identities


        # Re-observe the executable and any exact-environment shim at the
        # node's dispatch boundary. This catches changes after planning; the
        # final path-based process spawn still has an OS-level replacement
        # window that would require descriptor-bound execution to eliminate.
        def validate_build_recipe_toolchain_for_dispatch_at(root_fd: int, resolution: BuildRecipeToolchainPath, expected_stamps: darray[BuildIncrementalFileStamp]) -> bool error[OpenError, ToolchainObservationError] can[Blocking.IO, Unsafe.PointerCast]:
            raise ToolchainObservationError.ToolchainStampCountMismatch if expected_stamps.count != resolution.helper_paths.count + 1
            raise ToolchainObservationError.ToolchainStampCountMismatch if expected_stamps[0].path != resolution.path
            primary: BuildIncrementalFileStamp = try observe_build_incremental_file_stamp_at(root_fd, resolution.path)
            _ = try validate_build_recipe_toolchain_stamp(expected_stamps[0], primary)
            for helper_index in 0..<resolution.helper_paths.count |resolution, expected_stamps, root_fd|:
                expected: BuildIncrementalFileStamp = expected_stamps[helper_index + 1]
                helper_path: sview = resolution.helper_paths[helper_index]
                raise ToolchainObservationError.ToolchainStampCountMismatch if expected.path != helper_path
                observed: BuildIncrementalFileStamp = try observe_build_incremental_file_stamp_at(root_fd, helper_path)
                _ = try validate_build_recipe_toolchain_stamp(expected, observed)
            return true


        # Serial incremental dispatcher with a per-node invalidation boundary.
        # A failed node therefore cannot erase outputs belonging to later dirty
        # nodes which have not started.
        def execute_build_graph_incremental_serial_at(scratch: mutable Arena&, root_fd: int, graph: mutable BuildGraph&, previous_targets: darray[BuildIncrementalTarget], recipes: darray[BuildIncrementalRecipeTarget], observations: darray[BuildIncrementalObservation], toolchain_resolutions: darray[BuildRecipeToolchainPath], toolchain_stamps: darray[darray[BuildIncrementalFileStamp]], plan: BuildIncrementalPlan) -> BuildExecutionResult error[BuildExecutionError, BuildContractError, BuildIncrementalError, OutputInvalidationError, OpenError, ObserveError, ToolchainObservationError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast, Process.Run]:
            valid_graph: mutable bool = false
            catch validate_build_graph(graph):
                ok value:
                    valid_graph <- value
                error failure:
                    raise BuildExecutionError.GraphInvalid
            raise BuildExecutionError.GraphInvalid if not valid_graph
            raise BuildExecutionError.GraphNotPlanned if graph.state != BuildGraphState.Planned
            raise BuildExecutionError.NodeResultLimitExceeded if graph.nodes.count > EsBuildExecutor::Limits::NODE_RESULTS
            raise BuildExecutionError.GraphInvalid if plan.decisions.count != graph.nodes.count or recipes.count != graph.nodes.count or toolchain_stamps.count != graph.nodes.count

            for node_index in 0..<graph.nodes.count |graph, plan|:
                if plan.decisions[node_index] != BuildIncrementalDecision.UpToDate:
                    raise BuildExecutionError.UnsupportedCommand if not build_executor_command_supported(graph.nodes[node_index].command)

            results: mutable darray[BuildExecutionNodeResult] = []
            for node in graph.nodes |results|:
                results.push(BuildExecutionNodeResult{target_name: node.name})

            _ = try advance_build_graph(graph, BuildGraphEvent.Start)
            for node_index in 0..<graph.nodes.count |graph, results, plan, previous_targets, recipes, observations, scratch|:
                if graph.state != BuildGraphState.Running:
                    break
                if plan.decisions[node_index] == BuildIncrementalDecision.UpToDate:
                    _ = try advance_build_graph(graph, BuildGraphEvent.CacheHit, node_index)
                    results[node_index].cache_hit <- true
                else:
                    catch invalidate_dirty_build_target_outputs_at(scratch, root_fd, node_index, previous_targets, recipes, observations):
                        ok:
                            pass
                        error failure:
                            _ = try cleanup_failed_build_graph_outputs_at(scratch, root_fd, results, recipes)
                            _ = try advance_build_graph(graph, BuildGraphEvent.Cancel)
                            _ = try advance_build_graph(graph, BuildGraphEvent.CancelAck)
                            raise failure
                    _ = try advance_build_graph(graph, BuildGraphEvent.NodeStart, node_index)
                    results[node_index].started <- true
                    catch validate_build_recipe_toolchain_for_dispatch_at(root_fd, toolchain_resolutions[node_index], toolchain_stamps[node_index]):
                        ok:
                            pass
                        error failure:
                            _ = try cleanup_failed_build_graph_outputs_at(scratch, root_fd, results, recipes)
                            _ = try advance_build_graph(graph, BuildGraphEvent.Cancel)
                            _ = try advance_build_graph(graph, BuildGraphEvent.CancelAck)
                            raise failure
                    remaining_log_bytes: usize = EsBuild::Limits::LOG_BYTES - graph.log_bytes
                    command_limit: usize = graph.nodes[node_index].command.capture_output_limit_bytes
                    effective_limit: usize = command_limit if command_limit < remaining_log_bytes else remaining_log_bytes
                    process_error: mutable bool = false
                    catch run_build_command(graph.nodes[node_index].command, effective_limit):
                        ok value:
                            results[node_index].exit_status <- value.exit_status
                            results[node_index].stdout <- value.stdout
                            results[node_index].stderr <- value.stderr
                        error failure:
                            process_error <- true

                    node_log_bytes: mutable usize = 0
                    if not process_error:
                        stdout_bytes: usize = len(results[node_index].stdout)
                        stderr_bytes: usize = len(results[node_index].stderr)
                        if stdout_bytes > effective_limit:
                            process_error <- true
                        elif stderr_bytes > effective_limit - stdout_bytes:
                            process_error <- true
                        else:
                            node_log_bytes <- stdout_bytes + stderr_bytes

                    if process_error:
                        results[node_index].failure <- BuildExecutionFailureKind.Invocation
                        results[node_index].stdout <- ""
                        results[node_index].stderr <- ""
                        _ = try advance_build_graph(graph, BuildGraphEvent.NodeFailure, node_index)
                        break

                    raise BuildExecutionError.LogAccountingInvalid if node_log_bytes > EsBuild::Limits::LOG_BYTES - graph.log_bytes
                    graph.nodes[node_index].log_bytes <- node_log_bytes
                    graph.log_bytes <- graph.log_bytes + node_log_bytes
                    if results[node_index].exit_status != 0:
                        results[node_index].failure <- BuildExecutionFailureKind.NonzeroExit
                        _ = try advance_build_graph(graph, BuildGraphEvent.NodeFailure, node_index)
                        break
                    missing_output: mutable sview = ""
                    for output_path in recipes[node_index].outputs |recipes, scratch, missing_output|:
                        output_observation: mutable BuildIncrementalObservation = BuildIncrementalObservation{path: output_path}
                        catch observe_build_incremental_file_at(scratch, root_fd, output_path):
                            ok observation:
                                output_observation <- observation
                            error failure:
                                _ = try cleanup_failed_build_graph_outputs_at(scratch, root_fd, results, recipes)
                                _ = try advance_build_graph(graph, BuildGraphEvent.Cancel)
                                _ = try advance_build_graph(graph, BuildGraphEvent.CancelAck)
                                raise failure
                        if not output_observation.present:
                            missing_output <- output_path
                            break
                    if missing_output != "":
                        results[node_index].failure <- BuildExecutionFailureKind.OutputMissing
                        results[node_index].missing_output <- missing_output
                        _ = try advance_build_graph(graph, BuildGraphEvent.NodeFailure, node_index)
                        break
                    _ = try advance_build_graph(graph, BuildGraphEvent.NodeSuccess, node_index)

            if graph.state == BuildGraphState.Failed:
                _ = try cleanup_failed_build_graph_outputs_at(scratch, root_fd, results, recipes)
            return BuildExecutionResult{graph_state: graph.state, nodes: results, log_bytes: graph.log_bytes}


    private:
        # Observe the complete recipe file set and each resolved tool binary
        # before signing. Toolchain identity is therefore tied to fresh bytes,
        # not copied from the previous manifest or an unchecked string.
        def execute_build_graph_incremental_at(scratch: mutable Arena&, root_fd: int, graph: mutable BuildGraph&, previous_targets: darray[BuildIncrementalTarget], unsigned_recipes: darray[BuildIncrementalRecipeTarget], toolchain_resolutions: darray[BuildRecipeToolchainPath]) -> BuildIncrementalPosixExecution error[BuildExecutionError, BuildContractError, BuildIncrementalError, BuildRecipeSignatureError, OpenError, ObserveError, OutputInvalidationError, ToolchainObservationError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast, Process.Run]:
            _ = try validate_build_recipe_toolchain_paths(graph, toolchain_resolutions)
            observations: darray[BuildIncrementalObservation] = try observe_build_incremental_recipes_at(scratch, root_fd, unsigned_recipes)
            toolchain_stamps: mutable darray[darray[BuildIncrementalFileStamp]] = []
            toolchains: darray[BuildRecipeToolchainIdentity] = try observe_build_recipe_toolchains_at(scratch, root_fd, graph, toolchain_resolutions, toolchain_stamps)
            signed: BuildRecipeSignedGraph = try sign_build_incremental_graph(graph, unsigned_recipes, toolchains)
            graph <- signed.graph
            plan: BuildIncrementalPlan = try plan_build_incremental_graph_transition(previous_targets, graph, signed.recipes, observations)
            raise BuildExecutionError.NodeResultLimitExceeded if graph.nodes.count > EsBuildExecutor::Limits::NODE_RESULTS
            result: BuildExecutionResult = try execute_build_graph_incremental_serial_at(scratch, root_fd, graph, previous_targets, signed.recipes, observations, toolchain_resolutions, toolchain_stamps, plan)
            return BuildIncrementalPosixExecution{result: result, recipes: signed.recipes, pre_execution_observations: observations, toolchain_stamps: toolchain_stamps}


    public:
        # Re-observe toolchain files and recipe inputs/outputs after a
        # successful run. If the toolchain changed between planning and
        # publication, refuse to create a reusable manifest.
        def commit_build_incremental_execution_at(scratch: mutable Arena&, root_fd: int, execution: BuildIncrementalPosixExecution, graph: BuildGraph, previous_targets: darray[BuildIncrementalTarget], toolchain_resolutions: darray[BuildRecipeToolchainPath]) -> BuildIncrementalCommit error[BuildExecutionError, BuildContractError, BuildIncrementalError, BuildRecipeSignatureError, OpenError, ObserveError, ToolchainObservationError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            _ = try validate_build_recipe_toolchain_paths(graph, toolchain_resolutions)
            unused_stamps: mutable darray[darray[BuildIncrementalFileStamp]] = []
            toolchains: darray[BuildRecipeToolchainIdentity] = try observe_build_recipe_toolchains_at(scratch, root_fd, graph, toolchain_resolutions, unused_stamps)
            for index in 0..<execution.recipes.count |execution, toolchains|:
                raise ToolchainObservationError.ToolchainChanged(toolchain_resolutions[index].path) if execution.recipes[index].toolchain_identity != toolchains[index]
            observations: darray[BuildIncrementalObservation] = try observe_build_incremental_recipes_at(scratch, root_fd, execution.recipes)
            _ = try validate_build_incremental_stable_sources(execution.recipes, execution.pre_execution_observations, observations)
            return try commit_build_incremental_execution(execution.result, graph, previous_targets, execution.recipes, observations)


        # Join the post-success observation boundary to the versioned cache
        # codec. Callers receive a complete publishable manifest only after
        # toolchain identity, source stability, and declared outputs have all
        # been revalidated; failed builds never produce replacement cache bytes.
        def commit_build_incremental_execution_cache_at(scratch: mutable Arena&, root_fd: int, execution: BuildIncrementalPosixExecution, graph: BuildGraph, previous_targets: darray[BuildIncrementalTarget], toolchain_resolutions: darray[BuildRecipeToolchainPath]) -> BuildIncrementalPosixCacheCommit error[BuildExecutionError, BuildContractError, BuildIncrementalError, BuildRecipeSignatureError, BuildIncrementalCacheError, OpenError, ObserveError, ToolchainObservationError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            commit: BuildIncrementalCommit = try commit_build_incremental_execution_at(scratch, root_fd, execution, graph, previous_targets, toolchain_resolutions)
            cache_bytes: darray[u8] = try encode_build_incremental_cache(commit.targets)
            return BuildIncrementalPosixCacheCommit{commit: commit, cache_bytes: cache_bytes}


    private:
        # The caller-held lock covers the entire read/plan/execute/observe/
        # publish interval. Invalid prior bytes admit a full rebuild; a lost
        # lock, failed command graph, changed source, or failed publication
        # never creates a reusable replacement manifest.
        def execute_build_incremental_cache_under_lock_at(scratch: mutable Arena&, lock: ArtifactCacheWriterLock, owner_token: u64, cache_directory_fd: int, lock_name: cstr, cache_name: cstr, staging_name: cstr, root_fd: int, graph: mutable BuildGraph&, unsigned_recipes: darray[BuildIncrementalRecipeTarget], toolchain_resolutions: darray[BuildRecipeToolchainPath]) -> BuildIncrementalPosixCacheRun error[ArtifactCacheIoError, BuildExecutionError, BuildContractError, BuildIncrementalError, BuildRecipeSignatureError, BuildIncrementalCacheError, OpenError, ObserveError, OutputInvalidationError, ToolchainObservationError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast, Process.Run]:
            admission: BuildIncrementalCacheAdmission = try admit_build_incremental_cache_at_held(scratch, lock, cache_directory_fd, lock_name, owner_token, cache_name)
            execution: BuildIncrementalPosixExecution = try execute_build_graph_incremental_at(scratch, root_fd, graph, admission.previous_targets, unsigned_recipes, toolchain_resolutions)
            return BuildIncrementalPosixCacheRun{execution: execution, commit: BuildIncrementalCommit{}, reused_cache: admission.reusable} if execution.result.graph_state != BuildGraphState.Succeeded
            prepared: mutable BuildIncrementalPosixCacheCommit = BuildIncrementalPosixCacheCommit{commit: BuildIncrementalCommit{}}
            catch commit_build_incremental_execution_cache_at(scratch, root_fd, execution, graph, admission.previous_targets, toolchain_resolutions):
                ok value:
                    prepared <- value
                error failure:
                    _ = try cleanup_failed_build_graph_outputs_at(scratch, root_fd, execution.result.nodes, execution.recipes)
                    raise failure
            catch cleanup_stale_build_outputs_at(scratch, root_fd, prepared.commit.stale_outputs_after_success):
                ok:
                    prepared.commit <- BuildIncrementalCommit{targets: prepared.commit.targets}
                error failure:
                    _ = try cleanup_failed_build_graph_outputs_at(scratch, root_fd, execution.result.nodes, execution.recipes)
                    raise failure
            publication: mutable ArtifactCachePayloadPublication = ArtifactCachePayloadPublication{state: ArtifactCacheLifecycle.Rejected}
            catch publish_build_incremental_cache_at_held(scratch, lock, cache_directory_fd, lock_name, owner_token, staging_name, cache_name, prepared.cache_bytes):
                ok value:
                    publication <- value
                error failure:
                    # Cleanup is secondary to the publication outcome. In
                    # particular, an uncertain rename must remain visible even
                    # if output invalidation also fails; callers cannot infer
                    # that the previous cache manifest is still installed.
                    catch cleanup_failed_build_graph_outputs_at(scratch, root_fd, execution.result.nodes, execution.recipes):
                        ok cleaned:
                            _ = cleaned
                        error cleanup_failure:
                            pass
                    raise failure
            return BuildIncrementalPosixCacheRun{execution: execution, commit: prepared.commit, reused_cache: admission.reusable, cache_published: publication.state == ArtifactCacheLifecycle.Committed, cache_unchanged: publication.unchanged}


    public:
        # End-to-end persistent incremental execution for one build directory.
        # The advisory lock is held from manifest admission through graph
        # execution and atomic cache publication, and is released on every
        # normal or typed-error path.
        def execute_build_graph_incremental_cached_at(scratch: mutable Arena&, lock: mutable ArtifactCacheWriterLock&, owner_token: u64, cache_directory_fd: int, lock_name: cstr, cache_name: cstr, staging_name: cstr, root_fd: int, graph: mutable BuildGraph&, unsigned_recipes: darray[BuildIncrementalRecipeTarget], toolchain_resolutions: darray[BuildRecipeToolchainPath]) -> BuildIncrementalPosixCacheRun error[ArtifactCacheIoError, BuildExecutionError, BuildContractError, BuildIncrementalError, BuildRecipeSignatureError, BuildIncrementalCacheError, OpenError, ObserveError, OutputInvalidationError, ToolchainObservationError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast, Process.Run]:
            _ = try artifact_cache_writer_lock_acquire_at(lock, cache_directory_fd, lock_name, owner_token)
            catch execute_build_incremental_cache_under_lock_at(scratch, lock, owner_token, cache_directory_fd, lock_name, cache_name, staging_name, root_fd, graph, unsigned_recipes, toolchain_resolutions):
                ok run:
                    released: bool = try artifact_cache_writer_lock_release(lock, owner_token)
                    raise ArtifactCacheIoError.LockFailed(lock_name) if not released
                    return run
                error failure:
                    catch artifact_cache_writer_lock_release(lock, owner_token):
                        ok status:
                            pass
                        error release_failure:
                            pass
                    raise failure
