# Policy helpers for the Elisa Engine source-length audit.
module EsEngineSourceLengthModel:
    private:
        const module SourceSuffix:
            ELISA: sview = ".elisa"
            ELISASCRIPT: sview = ".elisascript"
            CPP: sview = ".cpp"
            HEADER: sview = ".h"
            INCLUDE: sview = ".inc"
            PYTHON: sview = ".py"
            GODOT: sview = ".gd"
            MARKDOWN: sview = ".md"


        def has_path_suffix(name: sview, suffix: sview) -> bool:
            return len(name) > len(suffix) and name.endswith(suffix)


        # On POSIX, a slash sorts after every legal filename byte. Replacing
        # separators with NUL reproduces pathlib's component-wise ordering.
        def path_order_key(value: sview) -> sview:
            return replace(value, "/", "\0")


    public:
        def source_name_matches(name: sview) -> bool:
            # pathlib.Path.suffix is empty for a lone dot-prefixed name.
            return true if has_path_suffix(name, SourceSuffix::ELISA)
            return true if has_path_suffix(name, SourceSuffix::ELISASCRIPT)
            return true if has_path_suffix(name, SourceSuffix::CPP)
            return true if has_path_suffix(name, SourceSuffix::HEADER)
            return true if has_path_suffix(name, SourceSuffix::INCLUDE)
            return true if has_path_suffix(name, SourceSuffix::PYTHON)
            return true if has_path_suffix(name, SourceSuffix::GODOT)
            return true if has_path_suffix(name, SourceSuffix::MARKDOWN)
            return false


        def ordered_source_paths(paths: darray[sview]) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            keys: mutable darray[sview] = []
            for value in paths:
                keys.push(path_order_key(value))
            result: mutable darray[sview] = []
            for key in sorted(keys):
                result.push(replace(key, "\0", "/"))
            return result
