# Bounded, pure POSIX template construction. No environment read or allocation
# syscall occurs here; the caller selects the parent directory explicitly.
module EsTemporaryPath:
    public:
        const module Limits:
            PATH_BYTES: usize = 4096
            PREFIX_BYTES: usize = 4072


        const module Syntax:
            LEAF_PREFIX: sview = "elisascript-"
            PLACEHOLDERS: sview = "XXXXXX"


        error TemplateError:
            InvalidParent
            InvalidPrefix
            PathLimit


        def template(parent: sview, prefix: sview = "") -> sview error[TemplateError] can[Memory.Allocate, Abort.Panic]:
            raise TemplateError.InvalidParent if parent == ""
            parent_bytes: mutable usize = 0
            for byte in parent |parent_bytes|:
                raise TemplateError.PathLimit if parent_bytes >= Limits::PATH_BYTES - 1
                raise TemplateError.InvalidParent if byte == 0u8
                parent_bytes <- parent_bytes + 1
            prefix_bytes: mutable usize = 0
            for byte in prefix |prefix_bytes|:
                raise TemplateError.PathLimit if prefix_bytes >= Limits::PREFIX_BYTES
                raise TemplateError.InvalidPrefix if byte == 0u8 or byte == 47u8
                prefix_bytes <- prefix_bytes + 1
            # Slash + fixed leaf prefix + six placeholders + C terminator.
            raise TemplateError.PathLimit if parent_bytes + prefix_bytes + 20 > Limits::PATH_BYTES
            return parent + "/" + Syntax::LEAF_PREFIX + prefix + Syntax::PLACEHOLDERS
