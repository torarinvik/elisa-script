# Unwired Darwin posix_spawn bridge. No public launch function is exposed.
# SDK spawn.h uses void* opaque handles; callers pass views of handle SLOTS,
# never guessed attribute internals. Ownership/lifecycle integration is pending.
include "process_spawn_attempt_model.elisa"

module EsProcessSpawnDarwin:
    private:
        const module Flags:
            SETPGROUP: i16 = 2


        @link_name(posix_spawnattr_init)
        extern native_spawnattr_init(slot: mutable void&) -> i32 can[Blocking.IO, Memory.Allocate]

        @link_name(posix_spawnattr_destroy)
        extern native_spawnattr_destroy(slot: mutable void&) -> i32 can[Blocking.IO, Memory.Release]

        @link_name(posix_spawnattr_setflags)
        extern native_spawnattr_setflags(slot: mutable void&, flags: i16) -> i32 can[Blocking.IO]

        @link_name(posix_spawnattr_setpgroup)
        extern native_spawnattr_setpgroup(slot: mutable void&, group: i32) -> i32 can[Blocking.IO]

        @link_name(posix_spawn)
        extern native_spawn(pid: mutable i32&, candidate: cstr, file_actions: void&?, attributes: void&, argv: void&, environment: void&) -> i32 can[Blocking.IO, Memory.Allocate, Memory.Release]


        def spawn_candidate(candidate: cstr, attributes: void&, argv: void&, environment: void&) -> EsProcessSpawnAttempt::Attempt can[Blocking.IO, Memory.Allocate, Memory.Release]:
            # Parent prerequisites: one reserved process resource, freshly
            # admitted/retained tables and configured owned attributes with
            # SETPGROUP and group 0. Lifecycle must adopt the returned PID before
            # any other fallible work; this helper does not wait or discard it.
            pid: mutable i32 = 0
            code: i32 = native_spawn(pid, candidate, null, attributes, argv, environment)
            return EsProcessSpawnAttempt::classify(code, pid)
