# Darwin UNIX03 wait-status admission, derived from the installed sys/wait.h.
# Pure observations do not prove that a native wait occurred or grant signaling.
include "process_pid_model.elisa"
module EsProcessSpawnWait:
    public:
        const module Status:
            MAX: i64 = 65535
            LOW_MASK: i64 = 127
            STOPPED: i64 = 127
            CORE: i64 = 128
            EXIT_MASK: i64 = 255
            MAX_SIGNAL: i64 = 31


        const enum Kind of u8:
            Invalid
            Exited
            Signaled
            NonTerminal


        const module ErrorCode:
            # Installed Darwin sys/errno.h; not a portable errno numbering.
            INTERRUPTED: i64 = 4
            NO_CHILD: i64 = 10
            INVALID_ARGUMENT: i64 = 22


        const enum NegativeFailure of u8:
            NotFailed
            Interrupted
            OwnershipLost
            InvalidRequest
            Unknown


        error PollBudgetError:
            InvalidInterval
            InvalidMinimum


        def negative_failure(reported_pid: i64, code: i64) -> NegativeFailure:
            return NegativeFailure.NotFailed if reported_pid >= 0
            return NegativeFailure.Unknown if reported_pid != -1
            return NegativeFailure.Interrupted if code == ErrorCode::INTERRUPTED
            return NegativeFailure.OwnershipLost if code == ErrorCode::NO_CHILD
            return NegativeFailure.InvalidRequest if code == ErrorCode::INVALID_ARGUMENT
            return NegativeFailure.Unknown


        # Only the expected interrupted syscall preserves the existing wait
        # ownership assumptions. ECHILD is not a confirmed terminal receipt.
        def uncertain_negative_wait(reported_pid: i64, code: i64) -> bool:
            failure: NegativeFailure = negative_failure(reported_pid, code)
            return failure != NegativeFailure.NotFailed and failure != NegativeFailure.Interrupted


        # Charge every native wait attempt, including EINTR. A failed charge
        # leaves the counter unchanged; this is work accounting, not a clock
        # deadline or proof of native child ownership.
        def take_poll(consumed: mutable u64&, limit: u64) -> bool:
            return false if consumed >= limit
            consumed <- consumed + 1u64
            return true


        # Keep a timeout's monotonic deadline authoritative while allowing
        # enough wait attempts for its requested duration. The baseline remains
        # a finite guard for commands with no deadline and tolerates scheduling
        # variance beyond the requested poll count.
        def poll_limit(timeout_micros: u64, interval_micros: u64, minimum_polls: u64) -> u64 error[PollBudgetError]:
            raise PollBudgetError.InvalidInterval if interval_micros == 0u64
            raise PollBudgetError.InvalidMinimum if minimum_polls == 0u64
            return minimum_polls if timeout_micros == 0u64
            requested_polls: u64 = timeout_micros / interval_micros
            maximum: u64 = 18446744073709551615u64
            return maximum if requested_polls > maximum - minimum_polls
            requested_polls + minimum_polls


        def classify(status: i64) -> Kind:
            return Kind.Invalid if status < 0 or status > Status::MAX
            low: i64 = status & Status::LOW_MASK
            if low == Status::STOPPED:
                return Kind.Invalid if (status & Status::CORE) != 0
                signal: i64 = status >> 8
                return Kind.NonTerminal if signal > 0 and signal <= Status::MAX_SIGNAL
                return Kind.Invalid
            if low == 0:
                return Kind.Invalid if (status & Status::CORE) != 0
                return Kind.Exited
            return Kind.Invalid if low > Status::MAX_SIGNAL or (status >> 8) != 0
            return Kind.Signaled


        def terminal(status: i64) -> bool:
            kind: Kind = classify(status)
            return kind == Kind.Exited or kind == Kind.Signaled


        def exact_reap(reported_pid: i64, owned_pid: i64, status: i64) -> bool:
            return EsProcessPid::child_shape(owned_pid) and reported_pid == owned_pid and terminal(status)


        # A positive result may have consumed the child even when its status
        # cannot be decoded. It must not be followed by guessed PID signaling.
        # Zero and negative returns need their own pending/errno handling.
        def uncertain_positive_wait(reported_pid: i64, owned_pid: i64, status: i64) -> bool:
            return true if not EsProcessPid::child_shape(owned_pid)
            return false if reported_pid <= 0
            return reported_pid != owned_pid or classify(status) == Kind.Invalid


        def exit_status(status: i64) -> i64 error[WaitError]:
            match classify(status):
                Kind.Exited:
                    return (status >> 8) & Status::EXIT_MASK
                Kind.Signaled:
                    return 128 + (status & Status::LOW_MASK)
                _:
                    raise WaitError.NotTerminal


        error WaitError:
            NotTerminal
