# Typed output rendering boundary.
#
# This module accounts the serialized byte cost of output frames while keeping
# host writes outside the IR contract. JUnit frame sizes share the concrete
# serializer's count/write path; Human and JSON frame accounting remain
# modeled until their concrete frame writers are connected. A renderer must
# consume sealed OutputDocuments in record order and never silently truncate.

module EsOutputRender:
    using EsOutput
    using EsOutputJunit

    public:
        const module Limits:
            CHUNKS: usize = EsOutput::Limits::RECORDS + 2


        const enum OutputRenderState of u8:
            Ready
            Rendering
            Complete
            Failed
            Cancelling
            Cancelled


        const enum OutputRenderEvent of u8:
            Begin
            Emit
            Finish
            Fail
            Cancel
            CancelAck


        const enum OutputRenderFrameKind of u8:
            Header
            Record
            Footer


        # A frame is a renderer-to-host hand-off descriptor, not an owned byte
        # buffer.  The formatter uses `kind` and `record_index` to produce the
        # bytes while `bytes` and `sequence` bind that production to the
        # renderer's checked accounting.  Keeping text out of this value makes
        # it safe to pass across a host write boundary without retaining a
        # borrowed view beyond the current render step.
        struct OutputRenderFrame:
            kind: OutputRenderFrameKind = OutputRenderFrameKind.Header
            record_index: usize = 0
            sequence: usize = 0
            bytes: usize = 0
            final_frame: bool = false


        struct OutputRender:
            document: OutputDocument
            state: mutable OutputRenderState = OutputRenderState.Ready
            next_record: mutable usize = 0
            emitted_bytes: mutable usize = 0
            chunks: mutable usize = 0


        error OutputRenderError:
            InvalidState
            InvalidEvent
            DocumentNotSealed
            RecordIndexInvalid
            RecordOrderInvalid
            AccountingInvalid
            ChunkLimitExceeded
            RenderLimitExceeded
            Incomplete
            CancelNotReady
            OutputTextInvalid


    private:
        def output_render_state_valid(state: OutputRenderState) -> bool:
            return state in {OutputRenderState.Ready, OutputRenderState.Rendering, OutputRenderState.Complete, OutputRenderState.Failed, OutputRenderState.Cancelling, OutputRenderState.Cancelled}


        def output_render_event_valid(event: OutputRenderEvent) -> bool:
            return event in {OutputRenderEvent.Begin, OutputRenderEvent.Emit, OutputRenderEvent.Finish, OutputRenderEvent.Fail, OutputRenderEvent.Cancel, OutputRenderEvent.CancelAck}


        def output_render_frame_kind_valid(kind: OutputRenderFrameKind) -> bool:
            return kind in {OutputRenderFrameKind.Header, OutputRenderFrameKind.Record, OutputRenderFrameKind.Footer}


        def output_render_add(current: usize, addition: usize, limit: usize) -> bool:
            return current <= limit and addition <= limit - current


        def output_render_accumulate(total: mutable usize&, addition: usize, limit: usize) -> void error[OutputRenderError]:
            raise OutputRenderError.RenderLimitExceeded if not output_render_add(total, addition, limit)
            total <- total + addition


        def output_render_json_escaped_bytes(value: sview, limit: usize) -> usize error[OutputRenderError]:
            total: mutable usize = 0
            for index in 0..<sview_len(value) |value, limit|:
                byte: u8 = sview_at(value, index)
                addition: usize = 2 if byte in {8, 9, 10, 12, 13} else 6 if byte < 32 else 2 if byte == 34 or byte == 92 else 1
                raise OutputRenderError.RenderLimitExceeded if not output_render_add(total, addition, limit)
                total <- total + addition
            return total


        def output_render_status_bytes(status: OutputStatus) -> usize error[OutputRenderError]:
            return 4 if status == OutputStatus.Pass or status == OutputStatus.Fail or status == OutputStatus.Skip
            return 5 if status == OutputStatus.Flaky
            return 5 if status == OutputStatus.Error
            raise OutputRenderError.InvalidState


        def output_render_record_bytes(document: OutputDocument&, record_index: usize) -> usize error[OutputRenderError]:
            raise OutputRenderError.RecordIndexInvalid if record_index >= document.records.count
            record: OutputRecord = document.records[record_index]
            limit: usize = document.options.max_bytes
            separator: usize = 0 if record_index == 0 else 1
            if document.options.format == OutputFormat.Human:
                status_bytes: usize = try output_render_status_bytes(record.status)
                total: mutable usize = 8 + separator + status_bytes
                try output_render_accumulate(total, sview_len(record.name), limit)
                try output_render_accumulate(total, sview_len(record.message), limit)
                try output_render_accumulate(total, sview_len(record.stdout), limit)
                try output_render_accumulate(total, sview_len(record.stderr), limit)
                if sview_len(record.message) != 0:
                    try output_render_accumulate(total, 3, limit)
                if sview_len(record.stdout) != 0:
                    try output_render_accumulate(total, 8, limit)
                if sview_len(record.stderr) != 0:
                    try output_render_accumulate(total, 8, limit)
                return total
            elif document.options.format == OutputFormat.Json:
                total: mutable usize = 14 + separator
                name_bytes: usize = try output_render_json_escaped_bytes(record.name, limit)
                status_bytes: usize = try output_render_status_bytes(record.status)
                message_bytes: usize = try output_render_json_escaped_bytes(record.message, limit)
                stdout_bytes: usize = try output_render_json_escaped_bytes(record.stdout, limit)
                stderr_bytes: usize = try output_render_json_escaped_bytes(record.stderr, limit)
                try output_render_accumulate(total, name_bytes, limit)
                try output_render_accumulate(total, status_bytes, limit)
                try output_render_accumulate(total, message_bytes, limit)
                try output_render_accumulate(total, stdout_bytes, limit)
                try output_render_accumulate(total, stderr_bytes, limit)
                return total
            elif document.options.format == OutputFormat.Junit:
                catch measure_output_junit_record_frame(record, limit):
                    ok value:
                        return value
                    error failure:
                        if failure == OutputJunitError.OutputLimitExceeded:
                            raise OutputRenderError.RenderLimitExceeded
                        elif failure == OutputJunitError.XmlCharacterInvalid:
                            raise OutputRenderError.OutputTextInvalid
                        raise OutputRenderError.AccountingInvalid
            raise OutputRenderError.InvalidState


        def output_render_header_bytes(document: OutputDocument&) -> usize error[OutputRenderError]:
            return 1 if document.options.format == OutputFormat.Json
            if document.options.format == OutputFormat.Junit:
                catch measure_output_junit_header_frame(document, document.options.max_bytes):
                    ok value:
                        return value
                    error failure:
                        if failure == OutputJunitError.OutputLimitExceeded:
                            raise OutputRenderError.RenderLimitExceeded
                        elif failure == OutputJunitError.XmlCharacterInvalid:
                            raise OutputRenderError.OutputTextInvalid
                        raise OutputRenderError.AccountingInvalid
            return 0


        def output_render_footer_bytes(document: OutputDocument&) -> usize error[OutputRenderError]:
            return 1 if document.options.format == OutputFormat.Json
            if document.options.format == OutputFormat.Junit:
                catch measure_output_junit_footer_frame(document.options.max_bytes):
                    ok value:
                        return value
                    error failure:
                        if failure == OutputJunitError.OutputLimitExceeded:
                            raise OutputRenderError.RenderLimitExceeded
                        raise OutputRenderError.AccountingInvalid
            return 0


        def output_render_expected_emitted_bytes(render: OutputRender&) -> usize error[OutputRenderError]:
            expected: mutable usize = 0
            if render.state != OutputRenderState.Ready:
                header: usize = try output_render_header_bytes(render.document)
                try output_render_accumulate(expected, header, render.document.options.max_bytes)
                for index in 0..<render.next_record |render, expected|:
                    record_bytes: usize = try output_render_record_bytes(render.document, index)
                    try output_render_accumulate(expected, record_bytes, render.document.options.max_bytes)
                if render.state == OutputRenderState.Complete:
                    footer: usize = try output_render_footer_bytes(render.document)
                    try output_render_accumulate(expected, footer, render.document.options.max_bytes)
            return expected


    public:
        def validate_output_render(render: OutputRender&) -> bool error[OutputRenderError]:
            raise OutputRenderError.InvalidState if not output_render_state_valid(render.state)
            catch validate_output_document(render.document):
                valid:
                    raise OutputRenderError.AccountingInvalid if not valid
                error failure:
                    raise OutputRenderError.AccountingInvalid
            raise OutputRenderError.DocumentNotSealed if render.document.state != OutputDocumentState.Sealed
            raise OutputRenderError.RecordIndexInvalid if render.next_record > render.document.records.count
            raise OutputRenderError.ChunkLimitExceeded if render.chunks > Limits::CHUNKS
            raise OutputRenderError.RenderLimitExceeded if render.emitted_bytes > render.document.options.max_bytes
            expected_emitted_bytes: usize = try output_render_expected_emitted_bytes(render)
            raise OutputRenderError.AccountingInvalid if render.emitted_bytes != expected_emitted_bytes
            if render.state == OutputRenderState.Ready:
                raise OutputRenderError.AccountingInvalid if render.next_record != 0 or render.chunks != 0 or render.emitted_bytes != 0
            elif render.state == OutputRenderState.Rendering or render.state == OutputRenderState.Cancelling or render.state == OutputRenderState.Failed:
                raise OutputRenderError.AccountingInvalid if render.chunks != render.next_record + 1
            elif render.state == OutputRenderState.Complete:
                raise OutputRenderError.AccountingInvalid if render.next_record != render.document.records.count or render.chunks != render.document.records.count + 2
            else:
                raise OutputRenderError.AccountingInvalid if render.chunks != render.next_record + 1
            return true


        def peek_output_render_frame(render: OutputRender&) -> OutputRenderFrame error[OutputRenderError]:
            # Peeking is deliberately side-effect free.  A host adapter can
            # format and write the returned frame, then acknowledge it through
            # `next_output_render_frame`; a failed write therefore cannot
            # consume a renderer frame by accident.
            try validate_output_render(render)
            if render.state == OutputRenderState.Ready:
                header_bytes: usize = try output_render_header_bytes(render.document)
                return OutputRenderFrame{kind: OutputRenderFrameKind.Header, sequence: render.chunks, bytes: header_bytes}
            raise OutputRenderError.InvalidState if render.state != OutputRenderState.Rendering
            if render.next_record < render.document.records.count:
                record_bytes: usize = try output_render_record_bytes(render.document, render.next_record)
                return OutputRenderFrame{kind: OutputRenderFrameKind.Record, record_index: render.next_record, sequence: render.chunks, bytes: record_bytes}
            footer_bytes: usize = try output_render_footer_bytes(render.document)
            return OutputRenderFrame{kind: OutputRenderFrameKind.Footer, sequence: render.chunks, bytes: footer_bytes, final_frame: true}


        def next_output_render_frame(render: mutable OutputRender&, frame: mutable OutputRenderFrame&) -> OutputRenderState error[OutputRenderError]:
            candidate: OutputRenderFrame = try peek_output_render_frame(render)
            if candidate.kind == OutputRenderFrameKind.Header:
                try advance_output_render(render, OutputRenderEvent.Begin, 0)
            elif candidate.kind == OutputRenderFrameKind.Record:
                try advance_output_render(render, OutputRenderEvent.Emit, candidate.record_index)
            elif candidate.kind == OutputRenderFrameKind.Footer:
                try advance_output_render(render, OutputRenderEvent.Finish, 0)
            else:
                raise OutputRenderError.InvalidState
            raise OutputRenderError.AccountingInvalid if not output_render_frame_kind_valid(candidate.kind)
            frame <- candidate
            return render.state


        def advance_output_render(render: mutable OutputRender&, event: OutputRenderEvent, record_index: usize = 0) -> OutputRenderState error[OutputRenderError]:
            try validate_output_render(render)
            raise OutputRenderError.InvalidEvent if not output_render_event_valid(event)
            raise OutputRenderError.InvalidEvent if event != OutputRenderEvent.Emit and record_index != 0
            if event == OutputRenderEvent.Begin:
                raise OutputRenderError.InvalidState if render.state != OutputRenderState.Ready
                raise OutputRenderError.DocumentNotSealed if render.document.state != OutputDocumentState.Sealed
                header: usize = try output_render_header_bytes(render.document)
                raise OutputRenderError.ChunkLimitExceeded if render.chunks >= Limits::CHUNKS
                raise OutputRenderError.RenderLimitExceeded if not output_render_add(render.emitted_bytes, header, render.document.options.max_bytes)
                render.emitted_bytes <- render.emitted_bytes + header
                render.chunks <- render.chunks + 1
                render.state <- OutputRenderState.Rendering
            elif event == OutputRenderEvent.Emit:
                raise OutputRenderError.InvalidState if render.state != OutputRenderState.Rendering
                raise OutputRenderError.RecordIndexInvalid if record_index >= render.document.records.count
                raise OutputRenderError.RecordOrderInvalid if record_index != render.next_record
                chunk_bytes: usize = try output_render_record_bytes(render.document, record_index)
                raise OutputRenderError.ChunkLimitExceeded if render.chunks >= Limits::CHUNKS
                raise OutputRenderError.RenderLimitExceeded if not output_render_add(render.emitted_bytes, chunk_bytes, render.document.options.max_bytes)
                render.emitted_bytes <- render.emitted_bytes + chunk_bytes
                render.chunks <- render.chunks + 1
                render.next_record <- render.next_record + 1
            elif event == OutputRenderEvent.Finish:
                raise OutputRenderError.InvalidState if render.state != OutputRenderState.Rendering
                raise OutputRenderError.Incomplete if render.next_record != render.document.records.count
                footer: usize = try output_render_footer_bytes(render.document)
                raise OutputRenderError.ChunkLimitExceeded if render.chunks >= Limits::CHUNKS
                raise OutputRenderError.RenderLimitExceeded if not output_render_add(render.emitted_bytes, footer, render.document.options.max_bytes)
                render.emitted_bytes <- render.emitted_bytes + footer
                render.chunks <- render.chunks + 1
                render.state <- OutputRenderState.Complete
            elif event == OutputRenderEvent.Fail:
                raise OutputRenderError.InvalidState if render.state != OutputRenderState.Rendering
                render.state <- OutputRenderState.Failed
            elif event == OutputRenderEvent.Cancel:
                raise OutputRenderError.CancelNotReady if render.state != OutputRenderState.Rendering
                render.state <- OutputRenderState.Cancelling
            elif event == OutputRenderEvent.CancelAck:
                raise OutputRenderError.CancelNotReady if render.state != OutputRenderState.Cancelling
                render.state <- OutputRenderState.Cancelled
            return render.state
