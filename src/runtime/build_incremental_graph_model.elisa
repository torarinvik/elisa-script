# Command-bound incremental planning.
#
# The base incremental planner validates manifests and observations. This
# layer joins that pure decision model to the exact BuildNode commands and
# recomputes each action signature before a cache hit can be admitted.

module EsBuildIncrementalGraph:
    using EsBuild
    using EsBuildIncremental
    using EsBuildRecipeSignature
    using EsProcess

    public:
        def validate_build_incremental_graph_signatures(graph: BuildGraph, recipes: darray[BuildIncrementalRecipeTarget]) -> bool error[BuildIncrementalError, BuildContractError, BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic]:
            graph_valid: bool = try validate_build_graph(graph)
            raise BuildIncrementalError.CurrentRecipeShapeInvalid if not graph_valid
            raise BuildIncrementalError.CurrentRecipeShapeInvalid if graph.nodes.count != recipes.count
            commands: mutable darray[ProcessCommand] = []
            toolchains: mutable darray[BuildRecipeToolchainIdentity] = []
            for index in 0..<graph.nodes.count |graph, recipes, commands, toolchains|:
                node: BuildNode = graph.nodes[index]
                recipe: BuildIncrementalRecipeTarget = recipes[index]
                raise BuildIncrementalError.CurrentRecipeShapeInvalid if node.name != recipe.name or node.fingerprint != recipe.recipe_fingerprint
                raise BuildIncrementalError.CurrentRecipeShapeInvalid if node.recipe_signature != recipe.recipe_signature
                raise BuildIncrementalError.CurrentRecipeShapeInvalid if not build_recipe_signature_valid(node.recipe_signature)
                raise BuildIncrementalError.CurrentRecipeShapeInvalid if recipe.toolchain_identity.word0 == 0 and recipe.toolchain_identity.word1 == 0 and recipe.toolchain_identity.word2 == 0 and recipe.toolchain_identity.word3 == 0
                commands.push(node.command)
                toolchains.push(recipe.toolchain_identity)
                raise BuildIncrementalError.CurrentRecipeShapeInvalid if node.dependencies.count != recipe.dependencies.count
                for dependency_position in 0..<node.dependencies.count |graph, recipes, index, recipe|:
                    dependency_index: usize = node.dependencies[dependency_position]
                    raise BuildIncrementalError.CurrentRecipeShapeInvalid if graph.nodes[dependency_index].name != recipe.dependencies[dependency_position]
            expected_signatures: darray[BuildRecipeSignature] = try build_recipe_signatures_for_actions(commands, recipes, toolchains)
            for index in 0..<recipes.count |recipes, expected_signatures, graph|:
                raise BuildIncrementalError.CurrentRecipeShapeInvalid if recipes[index].recipe_signature != expected_signatures[index]
                raise BuildIncrementalError.CurrentRecipeShapeInvalid if recipes[index].recipe_fingerprint != build_recipe_scheduler_fingerprint(expected_signatures[index])
                raise BuildIncrementalError.CurrentRecipeShapeInvalid if graph.nodes[index].recipe_signature != expected_signatures[index]
            return true


        # This is the only graph-aware path that may produce UpToDate cache
        # decisions. Every signature is recomputed from the final command and
        # explicit toolchain identity before entering the transition planner.
        def plan_build_incremental_graph_transition(previous_targets: darray[BuildIncrementalTarget], graph: BuildGraph, current_recipes: darray[BuildIncrementalRecipeTarget], observations: darray[BuildIncrementalObservation]) -> BuildIncrementalPlan error[BuildIncrementalError, BuildContractError, BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic]:
            raise BuildIncrementalError.CurrentRecipeShapeInvalid if graph.state != BuildGraphState.Planned
            _ = try validate_build_incremental_graph_signatures(graph, current_recipes)
            return try plan_build_incremental_transition(previous_targets, current_recipes, observations)
