# Descriptor-relative file opening for the incremental build observer.
#
# This adapter resolves each path beneath a directory capability, hashes file
# bytes plus POSIX permission bits through the retained descriptor, and rejects
# observed mutation. A missing file is data; permission, symlink, and I/O
# failures stay typed.

module EsBuildIncrementalPosix:
    using EsBuild
    using EsBuildIncremental
    using EsRuntime
    using EsIr

    public:
        const module Limits:
            OPEN_EINTR_RETRIES: usize = 8
            READ_EINTR_RETRIES: usize = 8
            READ_CALLS: usize = 1048576
            FILE_BYTES: usize = 268435456
            FILE_PERMISSION_MASK: u16 = 4095


        struct OpenedFile:
            present: bool = false
            descriptor: int = -1
            size: usize = 0
            device: u32 = 0
            inode: u64 = 0
            permissions: u16 = 0
            modify_time: ElisascriptStatTimespec = ElisascriptStatTimespec{}
            change_time: ElisascriptStatTimespec = ElisascriptStatTimespec{}


        struct BuildIncrementalFileStamp:
            path: sview
            present: bool = false
            size: usize = 0
            device: u32 = 0
            inode: u64 = 0
            permissions: u16 = 0
            modify_time: ElisascriptStatTimespec = ElisascriptStatTimespec{}
            change_time: ElisascriptStatTimespec = ElisascriptStatTimespec{}


        struct BuildRecipeToolchainFileObservation:
            identity: BuildRecipeToolchainIdentity
            stamp: BuildIncrementalFileStamp


        error OpenError:
            InvalidDirectoryDescriptor
            InvalidPath
            OpenFailed(path: sview, errno: i32)
            MetadataFailed(path: sview)
            NotRegularFile(path: sview)
            FileTooLarge(path: sview)
            CloseFailed(path: sview)


        error ObserveError:
            ReadFailed(path: sview, errno: i32)
            ReadIncomplete(path: sview)
            MetadataFailed(path: sview)
            ChangedDuringRead(path: sview)
            HashFailed(path: sview)
            ZeroFingerprint(path: sview)


        error ToolchainObservationError:
            ToolchainMissing(path: sview)
            ToolchainChanged(path: sview)
            ToolchainPathCountMismatch
            ToolchainStampCountMismatch
            ToolchainIndexProbeLimitExceeded
            ToolchainCommandMismatch(node_index: usize)
            InvalidToolchainPath(node_index: usize)
            MissingEnvironmentShim(node_index: usize)
            UnexpectedEnvironmentShim(node_index: usize)
            EnvironmentShimLimitExceeded


        const enum BuildIncrementalReadState of u8:
            Read
            Done
            Failed


    private:
        def build_incremental_posix_openat(directory_fd: int, component: cstr, flags: int, errno_out: mutable i32&) -> int can[Blocking.IO, Unsafe.PointerCast]:
            retries: mutable usize = 0
            while true:
                descriptor: int = elisascript_posix_openat(directory_fd, component, flags, 0u32)
                return descriptor if descriptor >= 0
                errno: mutable i32& = elisascript_posix_errno()
                errno_out[0] <- errno[0]
                if errno[0] == DarwinErrno::EINTR and retries < Limits::OPEN_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return -1


        def build_incremental_posix_fstat(descriptor: int, result: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_fstat(descriptor, result) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::OPEN_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def build_incremental_posix_close_owned(descriptor: int, root_fd: int) -> bool can[Blocking.IO]:
            return true if descriptor == root_fd
            return elisascript_posix_close(descriptor) == 0


        def build_incremental_posix_read_fully(descriptor: int, bytes: mutable darray[u8]&, expected_count: usize, errno_out: mutable i32&) -> bool can[Blocking.IO, Unsafe.PointerCast]:
            state: mutable BuildIncrementalReadState = BuildIncrementalReadState.Read
            offset: mutable usize = 0
            calls: mutable usize = 0
            interrupted: mutable usize = 0
            errno_out[0] <- 0
            machine over state:
                state Read
                start Read

                Read, BuildIncrementalReadState.Read if offset >= expected_count:
                    state <- BuildIncrementalReadState.Done
                    -> Read
                Read, BuildIncrementalReadState.Read:
                    if calls >= Limits::READ_CALLS:
                        state <- BuildIncrementalReadState.Failed
                        -> Read
                    remaining: usize = expected_count - offset
                    destination: mutable u8& = bytes.items + offset
                    amount: isize = elisascript_posix_read(descriptor, destination.cast[mutable void&], remaining)
                    calls <- calls + 1
                    if amount < 0:
                        errno: mutable i32& = elisascript_posix_errno()
                        errno_out[0] <- errno[0]
                        if errno[0] == DarwinErrno::EINTR and interrupted < Limits::READ_EINTR_RETRIES:
                            interrupted <- interrupted + 1
                            -> Read
                        state <- BuildIncrementalReadState.Failed
                        -> Read
                    if amount == 0 or amount.usize() > remaining:
                        state <- BuildIncrementalReadState.Failed
                        -> Read
                    offset <- offset + amount.usize()
                    bytes.count <- offset
                    interrupted <- 0
                    -> Read
                Read, BuildIncrementalReadState.Done:
                    break
                Read, BuildIncrementalReadState.Failed:
                    break
            return state == BuildIncrementalReadState.Done


        def build_incremental_opened_file_matches(opened: OpenedFile, current: ElisascriptStat&) -> bool:
            return (current.mode & DarwinStatMode::MASK) == DarwinStatMode::REGULAR
                and current.device == opened.device
                and current.inode == opened.inode
                and (current.mode & Limits::FILE_PERMISSION_MASK) == opened.permissions
                and current.size >= 0
                and current.size.usize().i64() == current.size
                and current.size.usize() == opened.size
                and current.modify_time.seconds == opened.modify_time.seconds
                and current.modify_time.nanoseconds == opened.modify_time.nanoseconds
                and current.change_time.seconds == opened.change_time.seconds
                and current.change_time.nanoseconds == opened.change_time.nanoseconds


        def build_incremental_opened_file_identity_matches(left: OpenedFile, right: OpenedFile) -> bool:
            return left.present and right.present
                and left.device == right.device
                and left.inode == right.inode
                and left.permissions == right.permissions
                and left.size == right.size
                and left.modify_time.seconds == right.modify_time.seconds
                and left.modify_time.nanoseconds == right.modify_time.nanoseconds
                and left.change_time.seconds == right.change_time.seconds
                and left.change_time.nanoseconds == right.change_time.nanoseconds


    public:
        # Resolve each path segment independently beneath `root_fd`. O_NOFOLLOW
        # therefore applies to every component, not merely the leaf. On success
        # the caller owns `result.descriptor`; root_fd is never closed here.
        def open_build_incremental_file_at(root_fd: int, path: sview) -> OpenedFile error[OpenError] can[Blocking.IO, Unsafe.PointerCast]:
            raise OpenError.InvalidPath if not build_incremental_path_is_canonical_relative(path)
            root_info: mutable ElisascriptStat = zeroed
            raise OpenError.InvalidDirectoryDescriptor if root_fd < 0 or not build_incremental_posix_fstat(root_fd, root_info) or (root_info.mode & DarwinStatMode::MASK) != DarwinStatMode::DIRECTORY

            path_length: usize = sview_len(path)
            component_storage: mutable u8[Limits::PATH_BYTES] = zeroed
            component: mutable u8& = (&component_storage[0])
            current_fd: mutable int = root_fd
            segment_start: mutable usize = 0
            while segment_start < path_length |component, current_fd, segment_start|:
                segment_end: mutable usize = segment_start
                while segment_end < path_length and sview_at(path, segment_end) != 47:
                    segment_end <- segment_end + 1
                segment_length: usize = segment_end - segment_start
                for offset in 0..<segment_length |component, offset|:
                    component[offset] <- sview_at(path, segment_start + offset)
                component[segment_length] <- 0
                is_leaf: bool = segment_end == path_length
                flags: int = DarwinOpenFlags::RDONLY | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
                flags <- flags | DarwinOpenFlags::NONBLOCK if is_leaf
                flags <- flags | DarwinOpenFlags::DIRECTORY if not is_leaf
                failure_errno: mutable i32 = 0
                next_fd: int = build_incremental_posix_openat(current_fd, component.cast[cstr], flags, failure_errno)
                if next_fd < 0:
                    close_ok: bool = build_incremental_posix_close_owned(current_fd, root_fd)
                    raise OpenError.CloseFailed(path) if not close_ok
                    return OpenedFile{} if failure_errno == DarwinErrno::ENOENT
                    raise OpenError.OpenFailed(path, failure_errno)

                if is_leaf:
                    file_info: mutable ElisascriptStat = zeroed
                    metadata_ok: bool = build_incremental_posix_fstat(next_fd, file_info)
                    if not metadata_ok:
                        leaf_close_ok: bool = elisascript_posix_close(next_fd) == 0
                        parent_close_ok: bool = build_incremental_posix_close_owned(current_fd, root_fd)
                        raise OpenError.CloseFailed(path) if not leaf_close_ok or not parent_close_ok
                        raise OpenError.MetadataFailed(path)
                    if (file_info.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR:
                        leaf_close_ok: bool = elisascript_posix_close(next_fd) == 0
                        parent_close_ok: bool = build_incremental_posix_close_owned(current_fd, root_fd)
                        raise OpenError.CloseFailed(path) if not leaf_close_ok or not parent_close_ok
                        raise OpenError.NotRegularFile(path)
                    if file_info.size < 0 or file_info.size.usize().i64() != file_info.size or file_info.size.usize() > Limits::FILE_BYTES:
                        leaf_close_ok: bool = elisascript_posix_close(next_fd) == 0
                        parent_close_ok: bool = build_incremental_posix_close_owned(current_fd, root_fd)
                        raise OpenError.CloseFailed(path) if not leaf_close_ok or not parent_close_ok
                        raise OpenError.FileTooLarge(path)
                    close_ok: bool = build_incremental_posix_close_owned(current_fd, root_fd)
                    if not close_ok:
                        _ = elisascript_posix_close(next_fd)
                        raise OpenError.CloseFailed(path)
                    return OpenedFile{present: true, descriptor: next_fd, size: file_info.size.usize(), device: file_info.device, inode: file_info.inode, permissions: file_info.mode & Limits::FILE_PERMISSION_MASK, modify_time: file_info.modify_time, change_time: file_info.change_time}

                directory_info: mutable ElisascriptStat = zeroed
                if not build_incremental_posix_fstat(next_fd, directory_info) or (directory_info.mode & DarwinStatMode::MASK) != DarwinStatMode::DIRECTORY:
                    directory_close_ok: bool = elisascript_posix_close(next_fd) == 0
                    parent_close_ok: bool = build_incremental_posix_close_owned(current_fd, root_fd)
                    raise OpenError.CloseFailed(path) if not directory_close_ok or not parent_close_ok
                    raise OpenError.MetadataFailed(path)
                close_ok: bool = build_incremental_posix_close_owned(current_fd, root_fd)
                if not close_ok:
                    _ = elisascript_posix_close(next_fd)
                    raise OpenError.CloseFailed(path)
                current_fd <- next_fd
                segment_start <- segment_end + 1
            raise OpenError.InvalidPath


        # Hash exactly the bytes read from the retained descriptor together
        # with the descriptor's permission bits. Temporary file contents live
        # in the caller's scratch arena and are rewound before returning; no
        # per-file read buffer accumulates across a build.
        # Metadata is captured before and after reading, then the name is
        # reopened beneath the same root capability and matched to the retained
        # descriptor. This rejects ordinary mutation and path replacement
        # rather than publishing a fingerprint for an object no longer named.
        def observe_build_incremental_file_with_stamp_at(scratch: mutable Arena&, root_fd: int, path: sview, stamp_out: mutable BuildIncrementalFileStamp&) -> BuildIncrementalObservation error[OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            opened: OpenedFile = try open_build_incremental_file_at(root_fd, path)
            if not opened.present:
                stamp_out[0] <- BuildIncrementalFileStamp{path: path}
                return BuildIncrementalObservation{path: path}
            mark: ArenaMark = arena_snapshot(scratch)
            bytes: mutable darray[u8] = []
            if opened.size != 0:
                _ = arena_da_reserve(scratch, bytes, opened.size)
            read_errno: mutable i32 = 0
            read_ok: bool = build_incremental_posix_read_fully(opened.descriptor, bytes, opened.size, read_errno)
            current_info: mutable ElisascriptStat = zeroed
            metadata_ok: bool = build_incremental_posix_fstat(opened.descriptor, current_info)
            stable: bool = metadata_ok and build_incremental_opened_file_matches(opened, current_info)
            digest_ok: mutable bool = false
            fingerprint: mutable u64 = 0
            fingerprint_word1: mutable u64 = 0
            fingerprint_word2: mutable u64 = 0
            fingerprint_word3: mutable u64 = 0
            if read_ok and stable and bytes.count == opened.size:
                fingerprint <- EsIr::canonical_file_identity_sha256_word(bytes, opened.permissions, 0)
                fingerprint_word1 <- EsIr::canonical_file_identity_sha256_word(bytes, opened.permissions, 1)
                fingerprint_word2 <- EsIr::canonical_file_identity_sha256_word(bytes, opened.permissions, 2)
                fingerprint_word3 <- EsIr::canonical_file_identity_sha256_word(bytes, opened.permissions, 3)
                digest_ok <- true
            named_path_matches: mutable bool = false
            named_path_close_ok: mutable bool = true
            reopen_close_failed: mutable bool = false
            catch open_build_incremental_file_at(root_fd, path):
                ok named_file:
                    named_path_matches <- build_incremental_opened_file_identity_matches(opened, named_file)
                    if named_file.present:
                        named_path_close_ok <- elisascript_posix_close(named_file.descriptor) == 0
                error failure:
                    reopen_close_failed <- failure == OpenError.CloseFailed(path)
            close_status: int = elisascript_posix_close(opened.descriptor)
            arena_rewind(scratch, mark)
            raise OpenError.CloseFailed(path) if close_status != 0 or not named_path_close_ok or reopen_close_failed
            raise ObserveError.ReadIncomplete(path) if not read_ok and read_errno == 0
            raise ObserveError.ReadFailed(path, read_errno) if not read_ok
            raise ObserveError.MetadataFailed(path) if not metadata_ok
            raise ObserveError.ChangedDuringRead(path) if not stable or not named_path_matches
            raise ObserveError.ReadIncomplete(path) if bytes.count != opened.size
            raise ObserveError.HashFailed(path) if not digest_ok
            raise ObserveError.ZeroFingerprint(path) if fingerprint == 0 and fingerprint_word1 == 0 and fingerprint_word2 == 0 and fingerprint_word3 == 0
            stamp_out[0] <- BuildIncrementalFileStamp{path: path, present: true, size: opened.size, device: opened.device, inode: opened.inode, permissions: opened.permissions, modify_time: opened.modify_time, change_time: opened.change_time}
            return BuildIncrementalObservation{path: path, present: true, fingerprint: fingerprint, fingerprint_word1: fingerprint_word1, fingerprint_word2: fingerprint_word2, fingerprint_word3: fingerprint_word3}


        def observe_build_incremental_file_at(scratch: mutable Arena&, root_fd: int, path: sview) -> BuildIncrementalObservation error[OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            stamp: mutable BuildIncrementalFileStamp = BuildIncrementalFileStamp{path: path}
            return try observe_build_incremental_file_with_stamp_at(scratch, root_fd, path, stamp)


        # Capture only the current descriptor-relative file identity for a
        # cheap dispatch-time recheck. Content and permission bits are hashed
        # during recipe admission; this snapshot compares inode, size, mode,
        # mtime, and ctime without rereading a large compiler for every target.
        def observe_build_incremental_file_stamp_at(root_fd: int, path: sview) -> BuildIncrementalFileStamp error[OpenError] can[Blocking.IO, Unsafe.PointerCast]:
            opened: OpenedFile = try open_build_incremental_file_at(root_fd, path)
            return BuildIncrementalFileStamp{path: path} if not opened.present
            close_status: int = elisascript_posix_close(opened.descriptor)
            raise OpenError.CloseFailed(path) if close_status != 0
            return BuildIncrementalFileStamp{path: path, present: true, size: opened.size, device: opened.device, inode: opened.inode, permissions: opened.permissions, modify_time: opened.modify_time, change_time: opened.change_time}


        # Derive the recipe's toolchain identity from file bytes read through
        # the same descriptor-relative, no-follow and mutation-checked path as
        # source inputs. The caller must resolve command.executable to this
        # path using its trusted execution environment before attaching it.
        def observe_build_recipe_toolchain_file_at(scratch: mutable Arena&, root_fd: int, resolved_toolchain_path: sview) -> BuildRecipeToolchainFileObservation error[OpenError, ObserveError, ToolchainObservationError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            stamp: mutable BuildIncrementalFileStamp = BuildIncrementalFileStamp{path: resolved_toolchain_path}
            observation: BuildIncrementalObservation = try observe_build_incremental_file_with_stamp_at(scratch, root_fd, resolved_toolchain_path, stamp)
            raise ToolchainObservationError.ToolchainMissing(resolved_toolchain_path) if not observation.present
            return BuildRecipeToolchainFileObservation{
                identity: BuildRecipeToolchainIdentity{word0: observation.fingerprint, word1: observation.fingerprint_word1, word2: observation.fingerprint_word2, word3: observation.fingerprint_word3},
                stamp: stamp
            }


        def observe_build_recipe_toolchain_identity_at(scratch: mutable Arena&, root_fd: int, resolved_toolchain_path: sview) -> BuildRecipeToolchainIdentity error[OpenError, ObserveError, ToolchainObservationError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            observation: BuildRecipeToolchainFileObservation = try observe_build_recipe_toolchain_file_at(scratch, root_fd, resolved_toolchain_path)
            return observation.identity


        # Collect precisely the validated path set for a recipe manifest. Each
        # file is read, hashed, and released from scratch before the next path,
        # so memory use is bounded by the largest admitted file rather than
        # the sum of every source and output in the build graph.
        def observe_build_incremental_recipes_at(scratch: mutable Arena&, root_fd: int, recipes: darray[BuildIncrementalRecipeTarget]) -> darray[BuildIncrementalObservation] error[BuildIncrementalError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            paths: darray[sview] = try build_incremental_observation_paths(recipes)
            observations: mutable darray[BuildIncrementalObservation] = []
            for path in paths |observations, scratch|:
                observation: BuildIncrementalObservation = try observe_build_incremental_file_at(scratch, root_fd, path)
                observations.push(observation)
            return observations
