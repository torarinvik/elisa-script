# Dependency-aware bridge between the build graph scheduler and bounded
# process-batch lifecycle. The host still owns process creation and reaping;
# this module gives it deterministic launch requests and validates receipts.

module EsBuildBatch:
    using EsBuild
    using EsBuildExecutor
    using EsBuildIncremental
    using EsBuildRecipeSignature
    using EsBuildScheduler
    using EsProcess
    using EsProcessBatch

    public:
        const module Limits:
            NODES: usize = EsProcessBatch::Limits::JOBS
            PARALLEL: usize = EsProcessBatch::Limits::PARALLEL


        struct BuildBatchLaunch:
            node_index: usize
            target_name: sview
            command: ProcessCommand
            dispatch: ProcessBatchDispatch


        struct BuildBatchNodeResult:
            target_name: sview
            cache_hit: bool = false
            dispatched: bool = false
            command_snapshot_bound: bool = false
            dispatched_command_snapshot: ProcessCommand = ProcessCommand{executable: ""}
            outputs_snapshot_bound: bool = false
            dispatched_outputs_snapshot: BuildExecutionNodeOutputs = BuildExecutionNodeOutputs{target_name: ""}
            published: bool = false
            reserved_output_bytes: usize = 0
            process: ProcessResult = ProcessResult{kind: ProcessResultKind.SpawnFailure}
            missing_output: sview = ""


        # Immutable recipe identity captured when the host-neutral batch is
        # created. Build-node state and log accounting evolve during the run,
        # but these plan fields must not.
        struct BuildBatchNodePlan:
            name: sview
            command: ProcessCommand
            dependencies: darray[usize] = []
            fingerprint: u64
            recipe_signature: BuildRecipeSignature = BuildRecipeSignature{}


        struct BuildBatchSession:
            scheduler: BuildScheduler
            processes: ProcessBatchSession
            results: darray[BuildBatchNodeResult] = []
            output_sets: darray[BuildExecutionNodeOutputs] = []
            plan_nodes: darray[BuildBatchNodePlan] = []
            plan_name_order: darray[BuildNodeNameIndex] = []
            plan_max_parallel: usize = 1
            declared_output_sets: darray[BuildExecutionNodeOutputs] = []
            reserved_output_bytes: usize = 0


        error BuildBatchError:
            InvalidSession
            JobLimitExceeded
            ParallelLimitExceeded
            JobMappingInvalid
            ResultInvalid
            ResultAlreadyPublished
            OutputLimitExceeded
            OutputListMismatch
            OutputPathInvalid
            OutputMissing
            InvalidOutputRoot
            StopAcknowledgementMismatch
            ExecutionNotComplete


    private:
        def build_batch_parallel_limit(graph_limit: usize) -> usize:
            return Limits::PARALLEL if graph_limit > Limits::PARALLEL else graph_limit


        def build_batch_result_kind_valid(kind: ProcessResultKind) -> bool:
            return kind in {ProcessResultKind.Exited, ProcessResultKind.Signaled, ProcessResultKind.SpawnFailure, ProcessResultKind.TimedOut, ProcessResultKind.Cancelled, ProcessResultKind.OutputLimit, ProcessResultKind.HostIoFailure}


        def build_batch_process_succeeded(result: ProcessResult) -> bool:
            return result.kind == ProcessResultKind.Exited and result.exit_status == 0 and result.signal == 0


        def build_batch_process_result_valid(result: ProcessResult) -> bool:
            checked_result: mutable ProcessResult = result
            return try validate_process_result(checked_result) else false


        def build_batch_text_vectors_equal(left: darray[sview], right: darray[sview]) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            return true


        def build_batch_index_vectors_equal(left: darray[usize], right: darray[usize]) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            return true


        def build_batch_node_name_orders_equal(left: darray[BuildNodeNameIndex], right: darray[BuildNodeNameIndex]) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index].name != right[index].name or left[index].node_index != right[index].node_index
            return true


        def build_batch_recipe_signatures_equal(left: BuildRecipeSignature, right: BuildRecipeSignature) -> bool:
            return left.word0 == right.word0 and left.word1 == right.word1 and left.word2 == right.word2 and left.word3 == right.word3


        def build_batch_process_commands_equal(left: ProcessCommand, right: ProcessCommand) -> bool:
            return false if left.executable != right.executable or left.working_directory != right.working_directory
            return false if left.environment_mode != right.environment_mode or left.stdin_mode != right.stdin_mode or left.stdout_mode != right.stdout_mode or left.stderr_mode != right.stderr_mode
            return false if left.stdin_path != right.stdin_path or left.stdout_path != right.stdout_path or left.stderr_path != right.stderr_path
            return false if left.timeout_micros != right.timeout_micros or left.capture_output_limit_bytes != right.capture_output_limit_bytes or left.failure_mode != right.failure_mode
            return false if not build_batch_text_vectors_equal(left.arguments, right.arguments) or not build_batch_text_vectors_equal(left.environment, right.environment)
            return true


        def build_batch_execution_outputs_equal(left: BuildExecutionNodeOutputs, right: BuildExecutionNodeOutputs) -> bool:
            return left.target_name == right.target_name and build_batch_text_vectors_equal(left.paths, right.paths)


        def build_batch_result_byte_count(result: ProcessResult, limit: usize) -> usize error[BuildBatchError]:
            stdout_bytes: usize = len(result.stdout)
            stderr_bytes: usize = len(result.stderr)
            error_bytes: usize = len(result.error_text)
            raise BuildBatchError.OutputLimitExceeded if stdout_bytes > limit
            remaining: mutable usize = limit - stdout_bytes
            raise BuildBatchError.OutputLimitExceeded if stderr_bytes > remaining
            remaining <- remaining - stderr_bytes
            raise BuildBatchError.OutputLimitExceeded if error_bytes > remaining
            return stdout_bytes + stderr_bytes + error_bytes


        def build_batch_job_matches_node_state(node_state: BuildNodeState, job_state: ProcessBatchJobState) -> bool:
            return job_state == ProcessBatchJobState.Pending if node_state == BuildNodeState.Planned
            return job_state == ProcessBatchJobState.Running if node_state == BuildNodeState.Running
            if node_state == BuildNodeState.Succeeded:
                return job_state == ProcessBatchJobState.Succeeded or job_state == ProcessBatchJobState.Skipped
            return job_state == ProcessBatchJobState.Failed if node_state == BuildNodeState.Failed
            return job_state == ProcessBatchJobState.Cancelled if node_state == BuildNodeState.Cancelled
            return false


        def build_batch_dependencies_succeeded(graph: BuildGraph&, node_index: usize) -> bool:
            for dependency_index in graph.nodes[node_index].dependencies |graph, node_index|:
                return false if graph.nodes[dependency_index].state != BuildNodeState.Succeeded
            return true


        def build_batch_stop_acknowledgements_match(session: BuildBatchSession&, acknowledgements: darray[ProcessBatchDispatch]) -> bool:
            expected_count: mutable usize = 0
            for job in session.processes.jobs:
                expected_count <- expected_count + 1 if job.state == ProcessBatchJobState.Running
            return false if acknowledgements.count != expected_count
            acknowledgement_index: mutable usize = 0
            for index in 0..<session.processes.jobs.count |session, acknowledgements, acknowledgement_index|:
                job: ProcessBatchJob = session.processes.jobs[index]
                if job.state == ProcessBatchJobState.Running:
                    acknowledgement: ProcessBatchDispatch = acknowledgements[acknowledgement_index]
                    return false if acknowledgement.job_index != index or acknowledgement.job_id != job.id or acknowledgement.attempt_token != job.attempt_token
                    acknowledgement_index <- acknowledgement_index + 1
            return acknowledgement_index == acknowledgements.count


    public:
        # Convert recipe-relative output declarations to the absolute paths
        # required by the output-checking receipt API. Recipe paths are
        # validated before joining so `..` or absolute paths cannot escape
        # the caller-provided absolute build root.
        def build_batch_output_sets_from_recipes(root: Path, graph: BuildGraph, recipes: darray[BuildIncrementalRecipeTarget]) -> darray[BuildExecutionNodeOutputs] error[BuildContractError, BuildIncrementalError, BuildExecutionError, BuildBatchError] can[Memory.Allocate, Abort.Panic]:
            valid_graph: bool = try validate_build_graph(graph)
            raise BuildBatchError.InvalidSession if not valid_graph or graph.state != BuildGraphState.Planned
            raise BuildBatchError.InvalidOutputRoot if not path_is_absolute(root)
            raise BuildBatchError.OutputListMismatch if recipes.count != graph.nodes.count
            _ = try build_incremental_materialize_recipe_targets(recipes)
            output_sets: mutable darray[BuildExecutionNodeOutputs] = []
            for index in 0..<recipes.count |graph, recipes, output_sets|:
                recipe: BuildIncrementalRecipeTarget = recipes[index]
                raise BuildBatchError.OutputListMismatch if recipe.name != graph.nodes[index].name
                outputs: mutable darray[sview] = []
                for relative_output in recipe.outputs |recipe, outputs|:
                    raise BuildBatchError.OutputPathInvalid if not build_incremental_path_is_canonical_relative(relative_output)
                    absolute_output: Path = root.joinpath(relative_output)
                    outputs.push(f"{absolute_output}")
                output_sets.push(BuildExecutionNodeOutputs{target_name: recipe.name, paths: outputs})
            raise BuildBatchError.OutputPathInvalid if not build_executor_output_sets_valid(graph, output_sets)
            return output_sets


        def build_batch_session_for_recipes(root: Path, graph: BuildGraph, recipes: darray[BuildIncrementalRecipeTarget]) -> BuildBatchSession error[BuildContractError, BuildIncrementalError, BuildExecutionError, ProcessBatchError, BuildBatchError] can[Memory.Allocate, Abort.Panic]:
            output_sets: darray[BuildExecutionNodeOutputs] = try build_batch_output_sets_from_recipes(root, graph, recipes)
            return try build_batch_session_for_graph_with_outputs(graph, output_sets)


        # Construct the bounded batch coordinator and admit only cache entries
        # justified by the current recipes, previous committed targets, and a
        # complete host observation set. `begin_build_batch` turns those
        # admitted entries into explicit skipped jobs before dispatching work.
        def build_incremental_batch_session_for_recipes(root: Path, graph: BuildGraph, previous_targets: darray[BuildIncrementalTarget], recipes: darray[BuildIncrementalRecipeTarget], observations: darray[BuildIncrementalObservation]) -> BuildBatchSession error[BuildContractError, BuildIncrementalError, BuildRecipeSignatureError, BuildExecutionError, BuildSchedulerError, ProcessBatchError, BuildBatchError] can[Memory.Allocate, Abort.Panic]:
            session: mutable BuildBatchSession = try build_batch_session_for_recipes(root, graph, recipes)
            _ = try admit_build_incremental_graph(session.scheduler, previous_targets, recipes, observations)
            return session


        def build_batch_session_for_graph(graph: BuildGraph) -> BuildBatchSession error[BuildContractError, BuildExecutionError, ProcessBatchError, BuildBatchError] can[Memory.Allocate, Abort.Panic]:
            return try build_batch_session_for_graph_with_outputs(graph, [])


        def build_batch_session_for_graph_with_outputs(graph: BuildGraph, output_sets: darray[BuildExecutionNodeOutputs]) -> BuildBatchSession error[BuildContractError, BuildExecutionError, ProcessBatchError, BuildBatchError] can[Memory.Allocate, Abort.Panic]:
            valid: bool = try validate_build_graph(graph)
            raise BuildBatchError.InvalidSession if not valid or graph.state != BuildGraphState.Planned
            raise BuildBatchError.JobLimitExceeded if graph.nodes.count > Limits::NODES
            raise BuildBatchError.OutputListMismatch if output_sets.count != 0 and output_sets.count != graph.nodes.count
            if output_sets.count != 0:
                for index in 0..<output_sets.count |graph, output_sets|:
                    raise BuildBatchError.OutputListMismatch if output_sets[index].target_name != graph.nodes[index].name
                raise BuildBatchError.OutputPathInvalid if not build_executor_output_sets_valid(graph, output_sets)
            jobs: mutable darray[ProcessBatchJob] = []
            results: mutable darray[BuildBatchNodeResult] = []
            plan_nodes: mutable darray[BuildBatchNodePlan] = []
            for index in 0..<graph.nodes.count |graph, jobs, results|:
                raise BuildExecutionError.UnsupportedCommand if not build_executor_command_supported(graph.nodes[index].command)
                jobs.push(ProcessBatchJob{id: (index + 1).u64()})
                results.push(BuildBatchNodeResult{target_name: graph.nodes[index].name})
                node: BuildNode = graph.nodes[index]
                plan_nodes.push(BuildBatchNodePlan{
                    name: node.name,
                    command: node.command,
                    dependencies: node.dependencies,
                    fingerprint: node.fingerprint,
                    recipe_signature: node.recipe_signature
                })

            process_session: ProcessBatchSession = ProcessBatchSession{
                policy: ProcessBatchPolicy{max_jobs: graph.nodes.count, max_parallel: build_batch_parallel_limit(graph.max_parallel), max_attempts: 1, failure_mode: ProcessBatchFailureMode.FailFast},
                jobs: jobs
            }
            scheduler: mutable BuildScheduler = BuildScheduler{graph: graph}
            scheduler.ready_queue.reserve(graph.nodes.count)
            session: BuildBatchSession = BuildBatchSession{
                scheduler: scheduler,
                processes: process_session,
                results: results,
                output_sets: output_sets,
                plan_nodes: plan_nodes,
                plan_name_order: graph.node_name_order,
                plan_max_parallel: graph.max_parallel,
                declared_output_sets: output_sets
            }
            _ = try validate_build_batch_session(session)
            return session


        def validate_build_batch_session(session: BuildBatchSession) -> bool error[BuildContractError, BuildSchedulerError, ProcessBatchError, BuildBatchError] can[Memory.Allocate, Abort.Panic]:
            _ = try validate_build_scheduler(session.scheduler)
            _ = try validate_process_batch(session.processes)
            graph: BuildGraph = session.scheduler.graph
            raise BuildBatchError.InvalidSession if graph.nodes.count == 0 or graph.nodes.count > Limits::NODES
            raise BuildBatchError.InvalidSession if session.results.count != graph.nodes.count or session.processes.jobs.count != graph.nodes.count
            raise BuildBatchError.JobMappingInvalid if session.plan_nodes.count != graph.nodes.count
            raise BuildBatchError.JobMappingInvalid if session.plan_max_parallel != graph.max_parallel
            raise BuildBatchError.JobMappingInvalid if not build_batch_node_name_orders_equal(session.plan_name_order, graph.node_name_order)
            for index in 0..<graph.nodes.count |session, graph|:
                node: BuildNode = graph.nodes[index]
                plan: BuildBatchNodePlan = session.plan_nodes[index]
                raise BuildBatchError.JobMappingInvalid if node.name != plan.name or node.fingerprint != plan.fingerprint
                raise BuildBatchError.JobMappingInvalid if not build_batch_process_commands_equal(node.command, plan.command)
                raise BuildBatchError.JobMappingInvalid if not build_batch_index_vectors_equal(node.dependencies, plan.dependencies)
                raise BuildBatchError.JobMappingInvalid if not build_batch_recipe_signatures_equal(node.recipe_signature, plan.recipe_signature)
            raise BuildBatchError.JobMappingInvalid if session.output_sets.count != session.declared_output_sets.count
            for index in 0..<session.output_sets.count |session|:
                raise BuildBatchError.JobMappingInvalid if not build_batch_execution_outputs_equal(session.output_sets[index], session.declared_output_sets[index])
            raise BuildBatchError.OutputListMismatch if session.output_sets.count != 0 and session.output_sets.count != graph.nodes.count
            if session.output_sets.count != 0:
                for index in 0..<session.output_sets.count |graph, session|:
                    raise BuildBatchError.OutputListMismatch if session.output_sets[index].target_name != graph.nodes[index].name
                raise BuildBatchError.OutputPathInvalid if not build_executor_output_sets_valid(graph, session.output_sets)
            raise BuildBatchError.InvalidSession if session.processes.policy.max_jobs != graph.nodes.count
            raise BuildBatchError.ParallelLimitExceeded if session.processes.policy.max_parallel != build_batch_parallel_limit(graph.max_parallel)
            raise BuildBatchError.InvalidSession if session.processes.policy.max_attempts != 1 or session.processes.policy.failure_mode != ProcessBatchFailureMode.FailFast
            raise BuildBatchError.InvalidSession if session.reserved_output_bytes > EsBuild::Limits::LOG_BYTES
            raise BuildBatchError.InvalidSession if session.reserved_output_bytes > EsBuild::Limits::LOG_BYTES - graph.log_bytes

            reserved: mutable usize = 0
            total_logs: mutable usize = 0
            cache_hit_results: mutable usize = 0
            for index in 0..<graph.nodes.count |session, graph, reserved, total_logs, cache_hit_results|:
                node: BuildNode = graph.nodes[index]
                job: ProcessBatchJob = session.processes.jobs[index]
                result: BuildBatchNodeResult = session.results[index]
                raise BuildBatchError.JobMappingInvalid if job.id != (index + 1).u64() or result.target_name != node.name
                raise BuildBatchError.JobMappingInvalid if not build_batch_job_matches_node_state(node.state, job.state)
                raise BuildBatchError.JobMappingInvalid if result.cache_hit != (job.state == ProcessBatchJobState.Skipped)
                cache_hit_results <- cache_hit_results + 1 if result.cache_hit
                raise BuildBatchError.JobMappingInvalid if result.dispatched != (job.attempts != 0)
                raise BuildBatchError.JobMappingInvalid if job.attempts > 1
                raise BuildBatchError.JobMappingInvalid if result.command_snapshot_bound != result.dispatched
                raise BuildBatchError.JobMappingInvalid if result.outputs_snapshot_bound != result.dispatched
                if result.dispatched:
                    raise BuildBatchError.JobMappingInvalid if not build_batch_process_commands_equal(result.dispatched_command_snapshot, node.command)
                    expected_outputs: BuildExecutionNodeOutputs = BuildExecutionNodeOutputs{target_name: node.name}
                    if session.output_sets.count == graph.nodes.count:
                        expected_outputs <- session.output_sets[index]
                    raise BuildBatchError.JobMappingInvalid if not build_batch_execution_outputs_equal(result.dispatched_outputs_snapshot, expected_outputs)
                raise BuildBatchError.JobMappingInvalid if result.published and not result.dispatched
                raise BuildBatchError.JobMappingInvalid if (node.state == BuildNodeState.Succeeded or node.state == BuildNodeState.Failed) and not result.published and not result.cache_hit
                raise BuildBatchError.JobMappingInvalid if result.published and node.state != BuildNodeState.Succeeded and node.state != BuildNodeState.Failed
                if result.cache_hit:
                    cached: mutable bool = false
                    for entry in session.scheduler.cache:
                        cached <- true if entry.node_name == node.name and entry.fingerprint == node.fingerprint
                    raise BuildBatchError.JobMappingInvalid if not cached or node.state != BuildNodeState.Succeeded or result.dispatched or result.published or result.reserved_output_bytes != 0 or result.missing_output != "" or node.log_bytes != 0
                if job.state == ProcessBatchJobState.Running:
                    raise BuildBatchError.JobMappingInvalid if result.published
                    raise BuildBatchError.JobMappingInvalid if result.reserved_output_bytes > node.command.capture_output_limit_bytes
                    raise BuildBatchError.JobMappingInvalid if result.reserved_output_bytes > EsBuild::Limits::LOG_BYTES - reserved
                    reserved <- reserved + result.reserved_output_bytes
                else:
                    raise BuildBatchError.JobMappingInvalid if result.reserved_output_bytes != 0
                if result.published:
                    raise BuildBatchError.ResultInvalid if not build_batch_result_kind_valid(result.process.kind)
                    raise BuildBatchError.ResultInvalid if not build_batch_process_result_valid(result.process)
                    log_bytes: usize = try build_batch_result_byte_count(result.process, EsBuild::Limits::LOG_BYTES)
                    raise BuildBatchError.OutputLimitExceeded if log_bytes > node.command.capture_output_limit_bytes
                    raise BuildBatchError.InvalidSession if node.log_bytes != log_bytes
                    raise BuildBatchError.InvalidSession if log_bytes > EsBuild::Limits::LOG_BYTES - total_logs
                    total_logs <- total_logs + log_bytes
                    raise BuildBatchError.ResultInvalid if node.state == BuildNodeState.Succeeded and not build_batch_process_succeeded(result.process)
                    raise BuildBatchError.ResultInvalid if node.state == BuildNodeState.Failed and build_batch_process_succeeded(result.process) and result.missing_output == ""
                    if result.missing_output != "":
                        raise BuildBatchError.ResultInvalid if node.state != BuildNodeState.Failed or not build_batch_process_succeeded(result.process)
                        raise BuildBatchError.ResultInvalid if session.output_sets.count != graph.nodes.count
                        declared_missing: mutable bool = false
                        for output_path in session.output_sets[index].paths:
                            declared_missing <- true if output_path == result.missing_output
                        raise BuildBatchError.ResultInvalid if not declared_missing
                else:
                    raise BuildBatchError.ResultInvalid if result.missing_output != ""
                    raise BuildBatchError.InvalidSession if node.log_bytes != 0
                    raise BuildBatchError.ResultInvalid if result.process.kind != ProcessResultKind.SpawnFailure or result.process.exit_status != 0 or result.process.signal != 0 or result.process.stdout != "" or result.process.stderr != "" or result.process.error_text != ""
            raise BuildBatchError.JobMappingInvalid if cache_hit_results != session.scheduler.cache_hits
            if session.scheduler.state != BuildSchedulerState.Ready and session.scheduler.state != BuildSchedulerState.Cancelled:
                raise BuildBatchError.JobMappingInvalid if session.scheduler.cache.count != session.scheduler.cache_hits
            raise BuildBatchError.InvalidSession if reserved != session.reserved_output_bytes or total_logs != graph.log_bytes

            if session.scheduler.state == BuildSchedulerState.Running:
                expected_ready: mutable usize = 0
                for index in 0..<graph.nodes.count |session, graph, expected_ready|:
                    if graph.nodes[index].state == BuildNodeState.Planned:
                        ready: bool = build_batch_dependencies_succeeded(graph, index)
                        expected_ready <- expected_ready + 1 if ready
                raise BuildBatchError.JobMappingInvalid if expected_ready != session.scheduler.ready_queue.count

            if session.scheduler.state == BuildSchedulerState.Ready:
                raise BuildBatchError.InvalidSession if session.processes.state != ProcessBatchState.Planned
            elif session.scheduler.state == BuildSchedulerState.Running:
                raise BuildBatchError.InvalidSession if session.processes.state != ProcessBatchState.Running
            elif session.scheduler.state == BuildSchedulerState.Failing:
                raise BuildBatchError.InvalidSession if session.processes.state != ProcessBatchState.Draining and session.processes.state != ProcessBatchState.Cancelling
            elif session.scheduler.state == BuildSchedulerState.Cancelling:
                raise BuildBatchError.InvalidSession if session.processes.state != ProcessBatchState.Cancelling
            elif session.scheduler.state == BuildSchedulerState.Complete:
                raise BuildBatchError.InvalidSession if session.processes.state != ProcessBatchState.Succeeded
            elif session.scheduler.state == BuildSchedulerState.Failed:
                raise BuildBatchError.InvalidSession if session.processes.state != ProcessBatchState.Failed
            elif session.scheduler.state == BuildSchedulerState.Cancelled:
                raise BuildBatchError.InvalidSession if session.processes.state != ProcessBatchState.Cancelled
            return true


        def begin_build_batch(session: mutable BuildBatchSession&) -> BuildSchedulerState error[BuildContractError, BuildSchedulerError, ProcessBatchError, BuildBatchError] can[Memory.Allocate, Abort.Panic]:
            _ = try validate_build_batch_session(session)
            raise BuildBatchError.InvalidSession if session.scheduler.state != BuildSchedulerState.Ready
            _ = try advance_build_scheduler(session.scheduler, BuildSchedulerEvent.Begin)
            _ = try advance_process_batch(session.processes, ProcessBatchEvent.Begin)
            for node_index in 0..<session.scheduler.graph.nodes.count |session|:
                node: BuildNode = session.scheduler.graph.nodes[node_index]
                for entry in session.scheduler.cache |session|:
                    if entry.node_name == node.name:
                        raise BuildBatchError.InvalidSession if entry.fingerprint != node.fingerprint
                        _ = try advance_build_scheduler(session.scheduler, BuildSchedulerEvent.CacheHit, node_index)
                        _ = try advance_process_batch(session.processes, ProcessBatchEvent.SkipAt, node_index)
                        session.results[node_index].cache_hit <- true
            if session.scheduler.state == BuildSchedulerState.Running and session.scheduler.active_nodes == 0 and session.scheduler.completed_nodes == session.scheduler.graph.nodes.count:
                _ = try advance_build_scheduler(session.scheduler, BuildSchedulerEvent.Complete)
            _ = try validate_build_batch_session(session)
            return session.scheduler.state


        # Export only a validated successful batch into the existing
        # incremental commit contract. Cache hits remain unstarted successes;
        # process-backed nodes must have a successful exit receipt.
        def build_batch_execution_result(session: BuildBatchSession) -> BuildExecutionResult error[BuildContractError, BuildSchedulerError, ProcessBatchError, BuildBatchError] can[Memory.Allocate, Abort.Panic]:
            _ = try validate_build_batch_session(session)
            raise BuildBatchError.ExecutionNotComplete if session.scheduler.state != BuildSchedulerState.Complete or session.processes.state != ProcessBatchState.Succeeded
            nodes: mutable darray[BuildExecutionNodeResult] = []
            nodes.reserve(session.scheduler.graph.nodes.count)
            for index in 0..<session.scheduler.graph.nodes.count |session, nodes|:
                node: BuildNode = session.scheduler.graph.nodes[index]
                result: BuildBatchNodeResult = session.results[index]
                if result.cache_hit:
                    raise BuildBatchError.JobMappingInvalid if result.dispatched or result.published or result.process.stdout != "" or result.process.stderr != "" or result.process.error_text != ""
                    nodes.push(BuildExecutionNodeResult{target_name: node.name, cache_hit: true})
                else:
                    raise BuildBatchError.ExecutionNotComplete if not result.dispatched or not result.published
                    raise BuildBatchError.ResultInvalid if result.process.kind != ProcessResultKind.Exited or result.process.exit_status != 0 or result.process.signal != 0 or result.process.error_text != ""
                    nodes.push(BuildExecutionNodeResult{target_name: node.name, started: true, exit_status: result.process.exit_status, stdout: result.process.stdout, stderr: result.process.stderr})
            return BuildExecutionResult{graph_state: session.scheduler.graph.state, nodes: nodes, log_bytes: session.scheduler.graph.log_bytes}


        # Return a deterministic ready wave, bounded both by the scheduler's
        # graph limit and by the process adapter's tighter process cap. Output
        # budget is reserved before any node transition so concurrent children
        # cannot collectively exceed the graph's retained-log ceiling.
        def dispatch_build_batch_ready(session: mutable BuildBatchSession&) -> darray[BuildBatchLaunch] error[BuildContractError, BuildExecutionError, BuildSchedulerError, ProcessBatchError, BuildBatchError] can[Memory.Allocate, Abort.Panic]:
            _ = try validate_build_batch_session(session)
            raise BuildBatchError.InvalidSession if session.scheduler.state != BuildSchedulerState.Running
            available_parallel: usize = session.processes.policy.max_parallel - session.processes.active
            candidates: mutable darray[usize] = []
            candidates.reserve(available_parallel)
            planned_reservation: mutable usize = session.reserved_output_bytes
            ready_count: usize = session.scheduler.ready_queue.count
            for offset in 0..<ready_count |session, candidates, planned_reservation|:
                break if candidates.count >= available_parallel
                node_index: usize = session.scheduler.ready_queue[offset]
                node: BuildNode = session.scheduler.graph.nodes[node_index]
                raise BuildExecutionError.UnsupportedCommand if not build_executor_command_supported(node.command)
                remaining: usize = EsBuild::Limits::LOG_BYTES - session.scheduler.graph.log_bytes - planned_reservation
                reservation: usize = node.command.capture_output_limit_bytes if node.command.capture_output_limit_bytes < remaining else remaining
                candidates.push(node_index)
                planned_reservation <- planned_reservation + reservation
            launches: mutable darray[BuildBatchLaunch] = []
            launches.reserve(candidates.count)
            for node_index in candidates |session, launches|:
                node: BuildNode = session.scheduler.graph.nodes[node_index]
                reservation: mutable usize = node.command.capture_output_limit_bytes
                remaining_before: usize = EsBuild::Limits::LOG_BYTES - session.scheduler.graph.log_bytes - session.reserved_output_bytes
                reservation <- remaining_before if reservation > remaining_before
                _ = try advance_build_scheduler(session.scheduler, BuildSchedulerEvent.Dispatch, node_index)
                dispatch: ProcessBatchDispatch = try admit_process_batch_job(session.processes, node_index)
                command: mutable ProcessCommand = node.command
                command.capture_output_limit_bytes <- reservation
                session.results[node_index].dispatched <- true
                session.results[node_index].command_snapshot_bound <- true
                session.results[node_index].dispatched_command_snapshot <- node.command
                session.results[node_index].outputs_snapshot_bound <- true
                session.results[node_index].dispatched_outputs_snapshot <- BuildExecutionNodeOutputs{target_name: node.name} if session.output_sets.count == 0
                session.results[node_index].dispatched_outputs_snapshot <- session.output_sets[node_index] if session.output_sets.count == session.scheduler.graph.nodes.count
                session.results[node_index].reserved_output_bytes <- reservation
                session.reserved_output_bytes <- session.reserved_output_bytes + reservation
                launches.push(BuildBatchLaunch{node_index: node_index, target_name: node.name, command: command, dispatch: dispatch})
            _ = try validate_build_batch_session(session)
            return launches


    private:
        def build_batch_first_missing_output(outputs: BuildExecutionNodeOutputs) -> sview can[Memory.Allocate, Abort.Panic, File.Read]:
            for output_path in outputs.paths |outputs|:
                return output_path if not is_file(path(output_path))
            return ""


        def report_build_batch_result_impl(session: mutable BuildBatchSession&, dispatch: ProcessBatchDispatch, process_result: ProcessResult, missing_output: sview) -> BuildSchedulerState error[BuildContractError, BuildSchedulerError, ProcessBatchError, BuildBatchError] can[Memory.Allocate, Abort.Panic]:
            _ = try validate_build_batch_session(session)
            _ = try validate_process_batch_dispatch(session.processes, dispatch)
            node_index: usize = dispatch.job_index
            node: BuildNode = session.scheduler.graph.nodes[node_index]
            prior: BuildBatchNodeResult = session.results[node_index]
            raise BuildBatchError.ResultAlreadyPublished if prior.published
            raise BuildBatchError.ResultInvalid if not build_batch_result_kind_valid(process_result.kind)
            raise BuildBatchError.ResultInvalid if not build_batch_process_result_valid(process_result)
            raise BuildBatchError.ResultInvalid if build_batch_process_succeeded(process_result) and process_result.error_text != ""
            raise BuildBatchError.OutputMissing if missing_output != "" and not build_batch_process_succeeded(process_result)
            if missing_output != "":
                raise BuildBatchError.OutputMissing if session.output_sets.count != session.scheduler.graph.nodes.count
                declared_path: mutable bool = false
                for output_path in session.output_sets[node_index].paths:
                    declared_path <- true if output_path == missing_output
                raise BuildBatchError.OutputMissing if not declared_path
            log_bytes: usize = try build_batch_result_byte_count(process_result, prior.reserved_output_bytes)
            raise BuildBatchError.OutputLimitExceeded if log_bytes > node.command.capture_output_limit_bytes

            session.scheduler.graph.nodes[node_index].log_bytes <- log_bytes
            session.scheduler.graph.log_bytes <- session.scheduler.graph.log_bytes + log_bytes
            session.reserved_output_bytes <- session.reserved_output_bytes - prior.reserved_output_bytes
            session.results[node_index].reserved_output_bytes <- 0
            session.results[node_index].published <- true
            session.results[node_index].process <- process_result
            session.results[node_index].missing_output <- missing_output

            succeeded: bool = build_batch_process_succeeded(process_result) and missing_output == ""
            if succeeded:
                _ = try advance_process_batch(session.processes, ProcessBatchEvent.Complete, node_index, dispatch.attempt_token)
                _ = try advance_build_scheduler(session.scheduler, BuildSchedulerEvent.NodeComplete, node_index)
                if session.scheduler.active_nodes == 0 and session.scheduler.completed_nodes == session.scheduler.graph.nodes.count:
                    _ = try advance_build_scheduler(session.scheduler, BuildSchedulerEvent.Complete)
            else:
                _ = try advance_process_batch(session.processes, ProcessBatchEvent.Fail, node_index, dispatch.attempt_token)
                _ = try advance_build_scheduler(session.scheduler, BuildSchedulerEvent.NodeFail, node_index)
                _ = try advance_process_batch(session.processes, ProcessBatchEvent.ReapAck, node_index, dispatch.attempt_token)
            _ = try validate_build_batch_session(session)
            return session.scheduler.state


    public:
        # A receipt is accepted only after the host has completed/reaped the
        # process. Every nonzero, signaled, spawn, timeout, output-limit, or
        # host-I/O result enters fail-fast drain; successful siblings may still
        # complete while that drain is in progress. Sessions with declared
        # outputs must use the checking variant below.
        def report_build_batch_result(session: mutable BuildBatchSession&, dispatch: ProcessBatchDispatch, process_result: ProcessResult) -> BuildSchedulerState error[BuildContractError, BuildSchedulerError, ProcessBatchError, BuildBatchError] can[Memory.Allocate, Abort.Panic]:
            raise BuildBatchError.InvalidSession if session.output_sets.count != 0
            return try report_build_batch_result_impl(session, dispatch, process_result, "")


        def report_build_batch_result_with_outputs(session: mutable BuildBatchSession&, dispatch: ProcessBatchDispatch, process_result: ProcessResult) -> BuildSchedulerState error[BuildContractError, BuildSchedulerError, ProcessBatchError, BuildBatchError] can[Memory.Allocate, Abort.Panic, File.Read]:
            _ = try validate_build_batch_session(session)
            _ = try validate_process_batch_dispatch(session.processes, dispatch)
            raise BuildBatchError.ResultInvalid if not build_batch_process_result_valid(process_result)
            prior: BuildBatchNodeResult = session.results[dispatch.job_index]
            raise BuildBatchError.ResultAlreadyPublished if prior.published
            missing_output: sview = ""
            if build_batch_process_succeeded(process_result) and session.output_sets.count != 0:
                missing_output <- try build_batch_first_missing_output(session.output_sets[dispatch.job_index])
            return try report_build_batch_result_impl(session, dispatch, process_result, missing_output)


        # Ask the host to stop exactly the currently active attempts. The host
        # must confirm process-group termination and reap before ack can close
        # either state machine.
        def cancel_build_batch(session: mutable BuildBatchSession&) -> darray[ProcessBatchDispatch] error[BuildContractError, BuildSchedulerError, ProcessBatchError, BuildBatchError] can[Memory.Allocate, Abort.Panic]:
            _ = try validate_build_batch_session(session)
            raise BuildBatchError.InvalidSession if session.scheduler.state != BuildSchedulerState.Ready and session.scheduler.state != BuildSchedulerState.Running and session.scheduler.state != BuildSchedulerState.Failing
            active: mutable darray[ProcessBatchDispatch] = []
            active.reserve(session.processes.active)
            for index in 0..<session.processes.jobs.count |session, active|:
                job: ProcessBatchJob = session.processes.jobs[index]
                if job.state == ProcessBatchJobState.Running:
                    active.push(ProcessBatchDispatch{job_index: index, job_id: job.id, attempt_token: job.attempt_token})
            if session.scheduler.state == BuildSchedulerState.Ready:
                # No child has been launched yet, so both state machines can
                # close cancellation immediately without asking the host to
                # stop or reap anything.
                _ = try advance_build_scheduler(session.scheduler, BuildSchedulerEvent.Cancel)
            elif session.scheduler.state == BuildSchedulerState.Running:
                _ = try advance_build_scheduler(session.scheduler, BuildSchedulerEvent.Cancel)
            _ = try advance_process_batch(session.processes, ProcessBatchEvent.Cancel)
            _ = try validate_build_batch_session(session)
            return active


        def acknowledge_build_batch_stop(session: mutable BuildBatchSession&, acknowledgements: darray[ProcessBatchDispatch]) -> BuildSchedulerState error[BuildContractError, BuildSchedulerError, ProcessBatchError, BuildBatchError] can[Memory.Allocate, Abort.Panic]:
            _ = try validate_build_batch_session(session)
            raise BuildBatchError.InvalidSession if session.scheduler.state != BuildSchedulerState.Cancelling and session.scheduler.state != BuildSchedulerState.Failing
            raise BuildBatchError.InvalidSession if session.processes.state != ProcessBatchState.Cancelling
            raise BuildBatchError.StopAcknowledgementMismatch if not build_batch_stop_acknowledgements_match(session, acknowledgements)
            _ = try advance_process_batch(session.processes, ProcessBatchEvent.CancelAck)
            _ = try advance_build_scheduler(session.scheduler, BuildSchedulerEvent.CancelAck)
            for index in 0..<session.results.count |session|:
                if session.results[index].reserved_output_bytes != 0:
                    session.reserved_output_bytes <- session.reserved_output_bytes - session.results[index].reserved_output_bytes
                    session.results[index].reserved_output_bytes <- 0
            _ = try validate_build_batch_session(session)
            return session.scheduler.state
