# Completion routing is pure metadata, not native PID/handle authority.
include "process_spawn_owner_model.elisa"

module EsProcessLaunchCompletion:
    public:
        struct Report:
            coordinator_complete: bool = false
            launch_failed: bool = false
            setup_failed: bool = false
            setup_code: i32 = 0
            cleanup_attempted: bool = false
            cleanup_failed: bool = false


        const enum Route of u8:
            Wait
            TerminateThenPanic
            ProcessFailure
            Panic


        def route(child: EsProcessSpawnOwner::Owner&, budget_held: bool, report: Report) -> Route:
            match child.state:
                EsProcessSpawnOwner::State.Running:
                    return Route.Panic if not budget_held
                    return Route.TerminateThenPanic if not report.coordinator_complete or report.launch_failed or report.setup_failed or report.setup_code != 0 or not report.cleanup_attempted or report.cleanup_failed
                    return Route.Wait
                EsProcessSpawnOwner::State.NoChild:
                    return Route.Panic if budget_held or child.pid != 0 or child.diagnostic_pid != 0
                    return Route.Panic if not report.coordinator_complete or not report.cleanup_attempted or report.cleanup_failed
                    return Route.Panic if not report.setup_failed and report.setup_code != 0
                    return Route.ProcessFailure
                EsProcessSpawnOwner::State.Fresh:
                    return Route.Panic if budget_held or child.resource_id != 0 or child.owner_token != 0 or child.pid != 0 or child.diagnostic_pid != 0 or child.code != 0 or child.attempts != 0 or child.saw_denied
                    return Route.Panic if not report.launch_failed or report.coordinator_complete or report.setup_failed or report.setup_code != 0 or report.cleanup_attempted or report.cleanup_failed
                    return Route.ProcessFailure
                _:
                    # Reserved/Unknown/Reaped are not a new successful launch.
                    return Route.Panic
