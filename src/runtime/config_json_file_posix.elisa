# Bounded POSIX JSON configuration-file reader.
#
# The returned wrapper owns the sealed JsonDocument that backs its borrowed
# ConfigLayer views. Keep the wrapper alive and unchanged while reading the
# layer or any values resolved from it.

module EsConfigJsonFilePosix:
    using EsData
    using EsJson
    using EsJsonLex
    using EsJsonParse
    using EsConfig
    using EsConfigJson
    using EsBoundedText

    public:
        const JSON_CONFIG_FILE_MAX_BYTES: usize = 16777216


        struct ConfigJsonFileLayer:
            document: JsonDocument
            layer: ConfigLayer


        error ConfigJsonFileError:
            InputLimitInvalid
            DecodeLimitsInvalid
            JsonPolicyInvalid


    private:
        def config_json_file_limits_valid(limits: DataDecodeLimits) -> bool error[ConfigJsonFileError]:
            raise ConfigJsonFileError.InputLimitInvalid if limits.input_bytes == 0 or limits.input_bytes > JSON_CONFIG_FILE_MAX_BYTES
            raise ConfigJsonFileError.DecodeLimitsInvalid if limits.tokens == 0 or limits.tokens > DATA_MAX_TOKENS
            raise ConfigJsonFileError.DecodeLimitsInvalid if limits.depth == 0 or limits.depth > DATA_MAX_DEPTH
            raise ConfigJsonFileError.DecodeLimitsInvalid if limits.records == 0 or limits.records > DATA_MAX_RECORDS
            raise ConfigJsonFileError.DecodeLimitsInvalid if limits.fields == 0 or limits.fields > DATA_MAX_FIELDS
            raise ConfigJsonFileError.DecodeLimitsInvalid if limits.field_bytes == 0 or limits.field_bytes > DATA_MAX_FIELD_BYTES
            return true


        def read_config_json_file(input_path: Path, limits: DataDecodeLimits = DataDecodeLimits{input_bytes: JSON_CONFIG_FILE_MAX_BYTES}, policy: JsonPolicy = JsonPolicy{}) -> ConfigJsonFileLayer error[ReadError, JsonLexError, JsonParseError, JsonContractError, ConfigError, ConfigJsonError, ConfigJsonFileError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            try config_json_file_limits_valid(limits)
            raise ConfigJsonFileError.JsonPolicyInvalid if policy.duplicate_keys not in {JsonDuplicateKeyPolicy.Reject, JsonDuplicateKeyPolicy.KeepFirst, JsonDuplicateKeyPolicy.KeepLast}
            raise ConfigJsonFileError.JsonPolicyInvalid if policy.trailing_commas not in {JsonTrailingCommaPolicy.Reject, JsonTrailingCommaPolicy.Allow}
            raise ConfigJsonFileError.JsonPolicyInvalid if policy.numbers not in {DataNumberPolicy.ExactInteger, DataNumberPolicy.Decimal, DataNumberPolicy.BinaryFloat}
            source: sview = try EsBoundedText::read_utf8(input_path, limits.input_bytes)
            lexed: JsonLexedSource = try lex_json(source, limits, policy)
            document: JsonDocument = try parse_json_document(lexed)
            layer: ConfigLayer = try flat_json_config_layer(document)
            return ConfigJsonFileLayer{document: document, layer: layer}
