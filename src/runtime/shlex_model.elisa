# Bounded equivalent of Python shlex.split(..., comments=False, posix=True).
# This splits words only; it never expands variables or executes shell syntax.

module EsShlex:
    public:
        const module Limits:
            INPUT_BYTES: usize = 1048576
            WORDS: usize = 65536
            WORD_BYTES: usize = 65536


        struct WordList:
            values: darray[darray[u8]] = []


        error SplitError:
            InputLimitExceeded
            WordLimitExceeded
            WordSizeLimitExceeded
            UnterminatedQuote
            TrailingEscape


    private:
        const enum State of u8:
            Unquoted
            SingleQuoted
            DoubleQuoted
            EscapedUnquoted
            EscapedDoubleQuoted


        def whitespace(byte: u8) -> bool:
            return byte == 32u8 or byte == 9u8 or byte == 10u8 or byte == 13u8


        def append_byte(word: mutable darray[u8]&, byte: u8) -> void error[SplitError] can[Memory.Allocate, Abort.Panic]:
            raise SplitError.WordSizeLimitExceeded if word.count >= Limits::WORD_BYTES
            word.push(byte)


        def finish_word(words: mutable darray[darray[u8]]&, word: mutable darray[u8]&, active: mutable bool&) -> void error[SplitError] can[Memory.Allocate, Abort.Panic]:
            return if not active
            raise SplitError.WordLimitExceeded if words.count >= Limits::WORDS
            words.push(word)
            word <- []
            active <- false


    public:
        # Matches the default Python shlex.split rules: only space, tab, CR,
        # and LF delimit unquoted words; comments are ordinary characters;
        # inside double quotes, backslash only escapes quote or backslash.
        def split_words(input: sview) -> WordList error[SplitError] can[Memory.Allocate, Abort.Panic]:
            length: usize = sview_len(input)
            raise SplitError.InputLimitExceeded if length > Limits::INPUT_BYTES
            words: mutable darray[darray[u8]] = []
            word: mutable darray[u8] = []
            state: mutable State = State.Unquoted
            active: mutable bool = false
            cursor: mutable usize = 0
            while cursor < length |input, words, word, state, active, cursor|:
                byte: u8 = sview_at(input, cursor)
                if state == State.SingleQuoted:
                    if byte == 39u8:
                        state <- State.Unquoted
                    else:
                        try append_byte(word, byte)
                    cursor <- cursor + 1
                elif state == State.DoubleQuoted:
                    if byte == 34u8:
                        state <- State.Unquoted
                    elif byte == 92u8:
                        state <- State.EscapedDoubleQuoted
                    else:
                        try append_byte(word, byte)
                    cursor <- cursor + 1
                elif state == State.EscapedUnquoted:
                    try append_byte(word, byte)
                    state <- State.Unquoted
                    cursor <- cursor + 1
                elif state == State.EscapedDoubleQuoted:
                    if byte == 34u8 or byte == 92u8:
                        try append_byte(word, byte)
                    else:
                        try append_byte(word, 92u8)
                        try append_byte(word, byte)
                    state <- State.DoubleQuoted
                    cursor <- cursor + 1
                else:
                    if whitespace(byte):
                        try finish_word(words, word, active)
                    elif byte == 39u8:
                        active <- true
                        state <- State.SingleQuoted
                    elif byte == 34u8:
                        active <- true
                        state <- State.DoubleQuoted
                    elif byte == 92u8:
                        active <- true
                        state <- State.EscapedUnquoted
                    else:
                        active <- true
                        try append_byte(word, byte)
                    cursor <- cursor + 1
            raise SplitError.TrailingEscape if state == State.EscapedUnquoted or state == State.EscapedDoubleQuoted
            raise SplitError.UnterminatedQuote if state == State.SingleQuoted or state == State.DoubleQuoted
            try finish_word(words, word, active)
            return WordList{values: words}
