# Typed installation and release-artifact contract.
#
# Installation is a publication protocol, not a collection of shell copy
# commands. The plan names the exact artifact targets, destination paths,
# integrity identity, scope, and rollback state before a host adapter mutates
# the filesystem.

module EsInstall:
    using EsPackage

    public:
        const INSTALL_FORMAT_VERSION: u8 = 1
        const INSTALL_MAX_ARTIFACTS: usize = 256
        const INSTALL_MAX_PATH_BYTES: usize = 4096
        const INSTALL_MAX_PACKAGE_NAME_BYTES: usize = 256
        const INSTALL_MAX_ARTIFACT_BYTES: usize = 268435456
        const INSTALL_MAX_TOTAL_ARTIFACT_BYTES: usize = 1073741824


        const enum InstallTarget of u8:
            Source
            Bytecode
            Native


        const enum InstallScope of u8:
            Workspace
            User
            System


        const enum InstallState of u8:
            Planned
            SourcesVerified
            Staged
            Verified
            PublishReady
            Publishing
            Published
            PublishUncertain
            RollingBack
            RolledBack
            RollbackUncertain
            Failed


        const enum InstallEvent of u8:
            VerifySources
            Stage
            Verify
            # Host acknowledgement after stage contents and permissions are
            # revalidated for publication.
            Preflight
            Publish
            PublishAck
            PublishOutcomeUnknown
            Fail
            Rollback
            RollbackAck
            RollbackOutcomeUnknown


        const enum InstallFileMode of u8:
            Data
            Executable


        struct InstallArtifact:
            target: InstallTarget
            source_path: sview
            destination_path: sview
            byte_count: usize
            fingerprint: u64
            digest_0: u64
            digest_1: u64
            digest_2: u64
            digest_3: u64
            integrity_present: bool = false
            mode: InstallFileMode = InstallFileMode.Data


        # A manifest-shaped summary of one artifact after it has been copied
        # into the private stage. The POSIX adapter must produce this only
        # after descriptor-relative readback and permission verification; this
        # pure model validates completeness and agreement with the plan.
        struct InstallStageReceipt:
            artifact_index: usize
            destination_path: sview
            byte_count: usize
            digest_0: u64
            digest_1: u64
            digest_2: u64
            digest_3: u64
            mode: InstallFileMode


        struct InstallPlan:
            format_version: u8 = INSTALL_FORMAT_VERSION
            package_name: sview
            package_version: PackageVersion
            scope: InstallScope = InstallScope.User
            artifacts: darray[InstallArtifact] = []
            staged_receipts: darray[InstallStageReceipt] = []
            offline_only: bool = false
            state: InstallState = InstallState.Planned


        error InstallContractError:
            EmptyPlan
            InvalidFormatVersion
            InvalidTarget
            InvalidScope
            InvalidState
            InvalidEvent
            PackageNameInvalid
            PackageVersionInvalid
            PathInvalid
            SourceExtensionInvalid
            ArtifactLimitExceeded
            ArtifactBytesExceeded
            IntegrityMissing
            DuplicateDestination
            DestinationPathOverlap
            InvalidFileMode
            StageReceiptCountMismatch
            StageReceiptOrderMismatch
            StageReceiptPathMismatch
            StageReceiptBytesMismatch
            StageReceiptDigestMismatch
            StageReceiptModeMismatch
            RollbackNotReady
            PublishAckNotReady
            PublishOutcomeNotReady
            RollbackAckNotReady
            RollbackOutcomeNotReady


    private:
        def install_target_valid(target: InstallTarget) -> bool:
            return target in {InstallTarget.Source, InstallTarget.Bytecode, InstallTarget.Native}


        def install_scope_valid(scope: InstallScope) -> bool:
            return scope in {InstallScope.Workspace, InstallScope.User, InstallScope.System}


        def install_state_valid(state: InstallState) -> bool:
            return state in {InstallState.Planned, InstallState.SourcesVerified, InstallState.Staged, InstallState.Verified, InstallState.PublishReady, InstallState.Publishing, InstallState.Published, InstallState.PublishUncertain, InstallState.RollingBack, InstallState.RolledBack, InstallState.RollbackUncertain, InstallState.Failed}


        def install_event_valid(event: InstallEvent) -> bool:
            return event in {InstallEvent.VerifySources, InstallEvent.Stage, InstallEvent.Verify, InstallEvent.Preflight, InstallEvent.Publish, InstallEvent.PublishAck, InstallEvent.PublishOutcomeUnknown, InstallEvent.Fail, InstallEvent.Rollback, InstallEvent.RollbackAck, InstallEvent.RollbackOutcomeUnknown}


        def install_file_mode_valid(mode: InstallFileMode) -> bool:
            return mode in {InstallFileMode.Data, InstallFileMode.Executable}


        def install_path_valid(path: sview) -> bool:
            length: usize = len(path)
            return false if length == 0 or length >= INSTALL_MAX_PATH_BYTES
            return false if sview_at(path, 0) == 47
            for offset in 0..<length |path|:
                byte: u8 = sview_at(path, offset)
                return false if byte < 32 or byte == 127 or byte == 92 or byte == 58
            segment_start: mutable usize = 0
            index: mutable usize = 0
            while index <= length:
                at_end: bool = index == length
                separator: bool = not at_end and sview_at(path, index) == 47
                if at_end or separator:
                    return false if index == segment_start
                    segment_length: usize = index - segment_start
                    return false if segment_length == 1 and sview_at(path, segment_start) == 46
                    return false if segment_length == 2 and sview_at(path, segment_start) == 46 and sview_at(path, segment_start + 1) == 46
                    segment_start <- index + 1
                index <- index + 1
            return true


        def install_path_is_ancestor(parent: sview, child: sview) -> bool:
            parent_length: usize = len(parent)
            child_length: usize = len(child)
            return false if parent_length >= child_length
            for offset in 0..<parent_length |parent, child|:
                return false if sview_at(parent, offset) != sview_at(child, offset)
            return sview_at(child, parent_length) == 47


        def install_destination_paths_overlap(left: sview, right: sview) -> bool:
            return true if left == right
            return install_path_is_ancestor(left, right) or install_path_is_ancestor(right, left)


        def install_package_name_valid(name: sview) -> bool:
            return sview_len(name) != 0 and sview_len(name) < INSTALL_MAX_PACKAGE_NAME_BYTES and not sview_contains_byte(name, 0)


        def install_artifact_valid(artifact: InstallArtifact) -> bool error[InstallContractError]:
            raise InstallContractError.InvalidTarget if not install_target_valid(artifact.target)
            raise InstallContractError.InvalidFileMode if not install_file_mode_valid(artifact.mode)
            raise InstallContractError.PathInvalid if not install_path_valid(artifact.source_path) or not install_path_valid(artifact.destination_path)
            raise InstallContractError.SourceExtensionInvalid if artifact.target == InstallTarget.Source and not sview_ends_with(artifact.source_path, ".elisascript")
            raise InstallContractError.ArtifactBytesExceeded if artifact.byte_count > INSTALL_MAX_ARTIFACT_BYTES
            raise InstallContractError.IntegrityMissing if not artifact.integrity_present
            return true


        def install_stage_receipts_match_artifacts(artifacts: darray[InstallArtifact], receipts: darray[InstallStageReceipt]) -> bool error[InstallContractError]:
            raise InstallContractError.StageReceiptCountMismatch if receipts.count != artifacts.count
            for index in 0..<artifacts.count |artifacts, receipts|:
                artifact: InstallArtifact = artifacts[index]
                receipt: InstallStageReceipt = receipts[index]
                raise InstallContractError.StageReceiptOrderMismatch if receipt.artifact_index != index
                raise InstallContractError.StageReceiptPathMismatch if receipt.destination_path != artifact.destination_path
                raise InstallContractError.StageReceiptBytesMismatch if receipt.byte_count != artifact.byte_count
                raise InstallContractError.StageReceiptDigestMismatch if receipt.digest_0 != artifact.digest_0 or receipt.digest_1 != artifact.digest_1 or receipt.digest_2 != artifact.digest_2 or receipt.digest_3 != artifact.digest_3
                raise InstallContractError.StageReceiptModeMismatch if receipt.mode != artifact.mode
            return true


    public:
        def validate_install_plan(plan: InstallPlan&) -> bool error[InstallContractError]:
            raise InstallContractError.EmptyPlan if plan.artifacts.count == 0
            raise InstallContractError.InvalidFormatVersion if plan.format_version != INSTALL_FORMAT_VERSION
            raise InstallContractError.PackageNameInvalid if not install_package_name_valid(plan.package_name)
            raise InstallContractError.PackageVersionInvalid if not package_version_is_valid(plan.package_version)
            raise InstallContractError.InvalidScope if not install_scope_valid(plan.scope)
            raise InstallContractError.InvalidState if not install_state_valid(plan.state)
            raise InstallContractError.ArtifactLimitExceeded if plan.artifacts.count > INSTALL_MAX_ARTIFACTS
            total_bytes: mutable usize = 0
            for artifact in plan.artifacts:
                try install_artifact_valid(artifact)
                raise InstallContractError.ArtifactBytesExceeded if total_bytes > INSTALL_MAX_TOTAL_ARTIFACT_BYTES
                raise InstallContractError.ArtifactBytesExceeded if artifact.byte_count > INSTALL_MAX_TOTAL_ARTIFACT_BYTES - total_bytes
                total_bytes <- total_bytes + artifact.byte_count
            for index in 0..<plan.artifacts.count |plan|:
                artifact: InstallArtifact = plan.artifacts[index]
                for earlier in 0..<index |plan, artifact|:
                    earlier_destination: sview = plan.artifacts[earlier].destination_path
                    raise InstallContractError.DuplicateDestination if earlier_destination == artifact.destination_path
                    raise InstallContractError.DestinationPathOverlap if install_destination_paths_overlap(earlier_destination, artifact.destination_path)

            if plan.state in {InstallState.Staged, InstallState.Verified, InstallState.PublishReady, InstallState.Publishing, InstallState.Published, InstallState.PublishUncertain, InstallState.RollingBack, InstallState.RolledBack, InstallState.RollbackUncertain}:
                _ = try install_stage_receipts_match_artifacts(plan.artifacts, plan.staged_receipts)
            elif plan.state == InstallState.SourcesVerified or plan.state == InstallState.Failed:
                if plan.staged_receipts.count != 0:
                    _ = try install_stage_receipts_match_artifacts(plan.artifacts, plan.staged_receipts)
            else:
                raise InstallContractError.StageReceiptCountMismatch if plan.staged_receipts.count != 0
            return true


        # Save the complete staged manifest before admitting the Stage event.
        # Receipt validation is deliberately separate from POSIX provenance:
        # only the descriptor-based adapter can attest actual staged bytes,
        # object identity, and permissions.
        def stage_install_plan(plan: mutable InstallPlan&, receipts: darray[InstallStageReceipt]) -> InstallState error[InstallContractError] can[Memory.Allocate, Abort.Panic]:
            _ = try validate_install_plan(plan)
            raise InstallContractError.InvalidState if plan.state != InstallState.SourcesVerified
            _ = try install_stage_receipts_match_artifacts(plan.artifacts, receipts)
            plan.staged_receipts <- receipts
            return try advance_install_plan(plan, InstallEvent.Stage)


        def advance_install_plan(plan: mutable InstallPlan&, event: InstallEvent) -> InstallState error[InstallContractError]:
            try validate_install_plan(plan)
            raise InstallContractError.InvalidEvent if not install_event_valid(event)
            if event == InstallEvent.VerifySources:
                raise InstallContractError.InvalidState if plan.state != InstallState.Planned
                plan.state <- InstallState.SourcesVerified
            elif event == InstallEvent.Stage:
                raise InstallContractError.InvalidState if plan.state != InstallState.SourcesVerified
                _ = try install_stage_receipts_match_artifacts(plan.artifacts, plan.staged_receipts)
                plan.state <- InstallState.Staged
            elif event == InstallEvent.Verify:
                raise InstallContractError.InvalidState if plan.state != InstallState.Staged
                plan.state <- InstallState.Verified
            elif event == InstallEvent.Preflight:
                raise InstallContractError.InvalidState if plan.state != InstallState.Verified
                plan.state <- InstallState.PublishReady
            elif event == InstallEvent.Publish:
                raise InstallContractError.InvalidState if plan.state != InstallState.PublishReady
                plan.state <- InstallState.Publishing
            elif event == InstallEvent.PublishAck:
                raise InstallContractError.PublishAckNotReady if plan.state != InstallState.Publishing
                plan.state <- InstallState.Published
            elif event == InstallEvent.PublishOutcomeUnknown:
                raise InstallContractError.PublishOutcomeNotReady if plan.state != InstallState.Publishing
                plan.state <- InstallState.PublishUncertain
            elif event == InstallEvent.Fail:
                raise InstallContractError.InvalidState if plan.state == InstallState.Publishing or plan.state == InstallState.Published or plan.state == InstallState.PublishUncertain or plan.state == InstallState.RollingBack or plan.state == InstallState.RolledBack or plan.state == InstallState.RollbackUncertain or plan.state == InstallState.Failed
                plan.state <- InstallState.Failed
            elif event == InstallEvent.Rollback:
                raise InstallContractError.RollbackNotReady if plan.state != InstallState.Published and plan.state != InstallState.PublishUncertain and plan.state != InstallState.PublishReady and plan.state != InstallState.Verified and plan.state != InstallState.Staged
                plan.state <- InstallState.RollingBack
            elif event == InstallEvent.RollbackAck:
                raise InstallContractError.RollbackAckNotReady if plan.state != InstallState.RollingBack
                plan.state <- InstallState.RolledBack
            elif event == InstallEvent.RollbackOutcomeUnknown:
                raise InstallContractError.RollbackOutcomeNotReady if plan.state != InstallState.RollingBack
                plan.state <- InstallState.RollbackUncertain
            return plan.state
