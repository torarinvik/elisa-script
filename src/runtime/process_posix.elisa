# Shell-free POSIX process bridge. The higher-level interpreter builds an explicit
# argv vector and never delegates parsing, expansion, or quoting to `/bin/sh`.

extend EsRuntime:
    private:
        @link_name(fork)
        extern elisascript_posix_fork_impl() -> int can[Blocking.IO]

        @link_name(execvp)
        extern elisascript_posix_execvp_impl(file: cstr, argv: void&) -> int can[Blocking.IO]

        @link_name(waitpid)
        extern elisascript_posix_waitpid_impl(pid: int, status: mutable int&, options: int) -> int can[Blocking.IO]

        @link_name(kill)
        extern elisascript_posix_kill_impl(pid: int, signal: int) -> int can[Blocking.IO]

        @link_name(setpgid)
        extern elisascript_posix_setpgid_impl(pid: int, process_group: int) -> int can[Blocking.IO]

        @link_name(_exit)
        extern elisascript_posix_exit_impl(status: int) -> void can[Blocking.IO]

        @link_name(dup2)
        extern elisascript_posix_dup2_impl(source: int, destination: int) -> int can[Blocking.IO]

        @link_name(tmpfile)
        extern elisascript_posix_tmpfile_impl() -> mutable heap void&? can[Blocking.IO, Memory.Allocate]

        @link_name(fileno)
        extern elisascript_posix_fileno_impl(stream: void&) -> int can[Blocking.IO]

    public:
        def elisascript_posix_fork() -> int can[Blocking.IO]:
            return elisascript_posix_fork_impl()

        def elisascript_posix_execvp(file: cstr, argv: void&) -> int can[Blocking.IO]:
            return elisascript_posix_execvp_impl(file, argv)

        def elisascript_posix_waitpid(pid: int, status: mutable int&, options: int) -> int can[Blocking.IO]:
            return elisascript_posix_waitpid_impl(pid, status, options)

        def elisascript_posix_kill(pid: int, signal: int) -> int can[Blocking.IO]:
            return elisascript_posix_kill_impl(pid, signal)

        def elisascript_posix_setpgid(pid: int, process_group: int) -> int can[Blocking.IO]:
            return elisascript_posix_setpgid_impl(pid, process_group)

        def elisascript_posix_exit(status: int) -> void can[Blocking.IO]:
            return elisascript_posix_exit_impl(status)

        def elisascript_posix_dup2(source: int, destination: int) -> int can[Blocking.IO]:
            return elisascript_posix_dup2_impl(source, destination)

        def elisascript_posix_tmpfile() -> mutable heap void&? can[Blocking.IO, Memory.Allocate]:
            return elisascript_posix_tmpfile_impl()

        def elisascript_posix_fileno(stream: void&) -> int can[Blocking.IO]:
            return elisascript_posix_fileno_impl(stream)
