# Shell-free POSIX process bridge. The higher-level interpreter builds an explicit
# argv vector and never delegates parsing, expansion, or quoting to `/bin/sh`.
# Native C int/pid_t values are i32, not Elisa's 64-bit int. Public wrappers
# widen signed results; invalid scalar arguments return -2 without a syscall
# or errno update. Callers must not interpret errno for that admission failure.
include "process_scalar_abi_model.elisa"

extend EsRuntime:
    private:
        @link_name(fork)
        extern elisascript_posix_fork_impl() -> i32 can[Blocking.IO]

        @link_name(execvp)
        extern elisascript_posix_execvp_impl(file: cstr, argv: void&) -> i32 can[Blocking.IO]

        @link_name(execve)
        extern elisascript_posix_execve_impl(file: cstr, argv: void&, environment: void&) -> i32 can[Blocking.IO]

        @link_name(waitpid)
        extern elisascript_posix_waitpid_impl(pid: i32, status: mutable i32&, options: i32) -> i32 can[Blocking.IO]

        @link_name(kill)
        extern elisascript_posix_kill_impl(pid: i32, signal: i32) -> i32 can[Blocking.IO]

        @link_name(setpgid)
        extern elisascript_posix_setpgid_impl(pid: i32, process_group: i32) -> i32 can[Blocking.IO]

        @link_name(_exit)
        extern elisascript_posix_exit_impl(status: i32) -> void can[Blocking.IO]

        @link_name(dup2)
        extern elisascript_posix_dup2_impl(source: i32, destination: i32) -> i32 can[Blocking.IO]

        @link_name(tmpfile)
        extern elisascript_posix_tmpfile_impl() -> mutable heap void&? can[Blocking.IO, Memory.Allocate]

        @link_name(fileno)
        extern elisascript_posix_fileno_impl(stream: void&) -> i32 can[Blocking.IO]

    public:
        def elisascript_posix_fork() -> int can[Blocking.IO]:
            return elisascript_posix_fork_impl().int()

        def elisascript_posix_execvp(file: cstr, argv: void&) -> int can[Blocking.IO]:
            return elisascript_posix_execvp_impl(file, argv).int()

        # `execve` is the exact-environment boundary. Unlike `execvp`, it
        # cannot consult the host environment or perform shell fallback for an
        # executable text file without a recognized binary/script format.
        def elisascript_posix_execve(file: cstr, argv: void&, environment: void&) -> int can[Blocking.IO]:
            return elisascript_posix_execve_impl(file, argv, environment).int()

        def elisascript_posix_waitpid(pid: int, status: mutable int&, options: int) -> int can[Blocking.IO]:
            return EsProcessScalarAbi::Limits::REJECTED if not EsProcessScalarAbi::fits(pid) or not EsProcessScalarAbi::fits(options)
            # C writes exactly four bytes. Never borrow the low half of an
            # eight-byte Elisa int and leave its high half stale.
            native_status: mutable i32 = 0
            reported: i32 = elisascript_posix_waitpid_impl(pid.i32(), &native_status, options.i32())
            status <- native_status.int() if reported > 0i32
            return reported.int()

        def elisascript_posix_kill(pid: int, signal: int) -> int can[Blocking.IO]:
            return EsProcessScalarAbi::Limits::REJECTED if not EsProcessScalarAbi::fits(pid) or not EsProcessScalarAbi::fits(signal)
            return elisascript_posix_kill_impl(pid.i32(), signal.i32()).int()

        def elisascript_posix_setpgid(pid: int, process_group: int) -> int can[Blocking.IO]:
            return EsProcessScalarAbi::Limits::REJECTED if not EsProcessScalarAbi::fits(pid) or not EsProcessScalarAbi::fits(process_group)
            return elisascript_posix_setpgid_impl(pid.i32(), process_group.i32()).int()

        def elisascript_posix_exit(status: int) -> void can[Blocking.IO]:
            elisascript_posix_exit_impl(EsProcessScalarAbi::exit_byte(status))

        def elisascript_posix_dup2(source: int, destination: int) -> int can[Blocking.IO]:
            return EsProcessScalarAbi::Limits::REJECTED if not EsProcessScalarAbi::fits(source) or not EsProcessScalarAbi::fits(destination)
            return elisascript_posix_dup2_impl(source.i32(), destination.i32()).int()

        def elisascript_posix_tmpfile() -> mutable heap void&? can[Blocking.IO, Memory.Allocate]:
            return elisascript_posix_tmpfile_impl()

        def elisascript_posix_fileno(stream: void&) -> int can[Blocking.IO]:
            return elisascript_posix_fileno_impl(stream).int()
