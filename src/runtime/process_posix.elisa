# Shell-free POSIX process bridge. The higher-level interpreter builds an explicit
# argv vector and never delegates parsing, expansion, or quoting to `/bin/sh`.

@link_name(fork)
extern elisascript_posix_fork() -> int can[Blocking.IO]

@link_name(execvp)
extern elisascript_posix_execvp(file: cstr, argv: void&) -> int can[Blocking.IO]

@link_name(waitpid)
extern elisascript_posix_waitpid(pid: int, status: mutable int&, options: int) -> int can[Blocking.IO]

@link_name(kill)
extern elisascript_posix_kill(pid: int, signal: int) -> int can[Blocking.IO]

@link_name(setpgid)
extern elisascript_posix_setpgid(pid: int, process_group: int) -> int can[Blocking.IO]

@link_name(_exit)
extern elisascript_posix_exit(status: int) -> void can[Blocking.IO]

@link_name(dup2)
extern elisascript_posix_dup2(source: int, destination: int) -> int can[Blocking.IO]

@link_name(tmpfile)
extern elisascript_posix_tmpfile() -> mutable heap void&? can[Blocking.IO, Memory.Allocate]

@link_name(fileno)
extern elisascript_posix_fileno(stream: void&) -> int can[Blocking.IO]
