# Bounded JUnit XML serialization for sealed generic output documents.
#
# This module is the concrete record formatter: it owns escaping, status
# projection, counters, and the final byte ceiling before a host begins
# transport. Its count-only writer shares the byte-production path, so frame
# sizes and serialized bytes cannot drift apart.

module EsOutputJunit:
    using EsEncoding
    using EsOutput

    public:
        const module Limits:
            MAX_BYTES: usize = EsOutput::Limits::TEXT_BYTES


        error OutputJunitError:
            InvalidLimit
            InvalidFormat
            XmlCharacterInvalid
            OutputLimitExceeded
            InvalidRecord


    private:
        struct OutputJunitWriter:
            bytes: mutable darray[u8] = []
            byte_count: mutable usize = 0
            count_only: bool = false


        struct OutputJunitCounts:
            tests: usize = 0
            failures: usize = 0
            errors: usize = 0
            skipped: usize = 0


        def output_junit_xml_text_valid(value: sview) -> bool:
            cursor: mutable Utf8Cursor = Utf8Cursor{}
            for index in 0..<sview_len(value) |value, cursor|:
                byte: u8 = sview_at(value, index)
                return false if byte < 32u8 and byte not in {9u8, 10u8, 13u8}
                if byte == 239u8 and index + 2 < sview_len(value):
                    return false if sview_at(value, index + 1) == 191u8 and sview_at(value, index + 2) in {190u8, 191u8}
                return false if not utf8_feed(byte, cursor)
            return utf8_complete(cursor)


        def output_junit_append_byte(writer: mutable OutputJunitWriter&, byte: u8, limit: usize) -> void error[OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            raise OutputJunitError.OutputLimitExceeded if writer.byte_count >= limit
            if not writer.count_only:
                writer.bytes.push(byte)
            writer.byte_count <- writer.byte_count + 1


        def output_junit_append_text(writer: mutable OutputJunitWriter&, text: sview, limit: usize) -> void error[OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            raise OutputJunitError.OutputLimitExceeded if writer.byte_count > limit or sview_len(text) > limit - writer.byte_count
            if not writer.count_only:
                for index in 0..<sview_len(text) |writer, text|:
                    writer.bytes.push(sview_at(text, index))
            writer.byte_count <- writer.byte_count + sview_len(text)


        def output_junit_append_u64(writer: mutable OutputJunitWriter&, value: u64, limit: usize) -> void error[OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            digits: mutable darray[u8] = []
            remaining: mutable u64 = value
            if remaining == 0u64:
                digits.push(48u8)
            while remaining != 0u64:
                digits.push(48u8 + (remaining % 10u64).u8())
                remaining <- remaining / 10u64
            for index in 0..<digits.count |writer, digits, limit|:
                try output_junit_append_byte(writer, digits[digits.count - index - 1], limit)


        def output_junit_append_usize(writer: mutable OutputJunitWriter&, value: usize, limit: usize) -> void error[OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            try output_junit_append_u64(writer, value.u64(), limit)


        def output_junit_append_xml(writer: mutable OutputJunitWriter&, value: sview, limit: usize) -> void error[OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            raise OutputJunitError.XmlCharacterInvalid if not output_junit_xml_text_valid(value)
            for index in 0..<sview_len(value) |writer, value, limit|:
                byte: u8 = sview_at(value, index)
                if byte == 38u8:
                    try output_junit_append_text(writer, "&amp;", limit)
                elif byte == 60u8:
                    try output_junit_append_text(writer, "&lt;", limit)
                elif byte == 62u8:
                    try output_junit_append_text(writer, "&gt;", limit)
                elif byte == 34u8:
                    try output_junit_append_text(writer, "&quot;", limit)
                elif byte == 39u8:
                    try output_junit_append_text(writer, "&apos;", limit)
                elif byte == 9u8:
                    try output_junit_append_text(writer, "&#x9;", limit)
                elif byte == 10u8:
                    try output_junit_append_text(writer, "&#xA;", limit)
                elif byte == 13u8:
                    try output_junit_append_text(writer, "&#xD;", limit)
                else:
                    try output_junit_append_byte(writer, byte, limit)


        def output_junit_append_attribute(writer: mutable OutputJunitWriter&, value: sview, limit: usize) -> void error[OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            try output_junit_append_byte(writer, 34u8, limit)
            try output_junit_append_xml(writer, value, limit)
            try output_junit_append_byte(writer, 34u8, limit)


        def output_junit_append_attribute_usize(writer: mutable OutputJunitWriter&, value: usize, limit: usize) -> void error[OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            try output_junit_append_byte(writer, 34u8, limit)
            try output_junit_append_usize(writer, value, limit)
            try output_junit_append_byte(writer, 34u8, limit)


        def output_junit_append_time(writer: mutable OutputJunitWriter&, milliseconds: u64, limit: usize) -> void error[OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            whole_seconds: u64 = milliseconds / 1000u64
            fraction: u64 = milliseconds % 1000u64
            try output_junit_append_u64(writer, whole_seconds, limit)
            try output_junit_append_byte(writer, 46u8, limit)
            try output_junit_append_byte(writer, 48u8, limit) if fraction < 100u64
            try output_junit_append_byte(writer, 48u8, limit) if fraction < 10u64
            try output_junit_append_u64(writer, fraction, limit)


        def output_junit_append_property(writer: mutable OutputJunitWriter&, name: sview, value: sview, limit: usize) -> void error[OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            try output_junit_append_text(writer, "      <properties><property name=", limit)
            try output_junit_append_attribute(writer, name, limit)
            try output_junit_append_text(writer, " value=", limit)
            try output_junit_append_attribute(writer, value, limit)
            try output_junit_append_text(writer, "/></properties>\n", limit)


        def output_junit_append_record(writer: mutable OutputJunitWriter&, record: OutputRecord, limit: usize) -> void error[OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            try output_junit_append_text(writer, "    <testcase name=", limit)
            try output_junit_append_attribute(writer, record.name, limit)
            try output_junit_append_text(writer, " classname=", limit)
            try output_junit_append_attribute(writer, "elisascript", limit)
            try output_junit_append_text(writer, " time=", limit)
            try output_junit_append_byte(writer, 34u8, limit)
            try output_junit_append_time(writer, record.duration_ms, limit)
            try output_junit_append_text(writer, ">\n", limit)

            if record.status == OutputStatus.Fail:
                try output_junit_append_text(writer, "      <failure message=", limit)
                try output_junit_append_attribute(writer, record.message, limit)
                try output_junit_append_text(writer, "/>\n", limit)
            elif record.status == OutputStatus.Error:
                try output_junit_append_text(writer, "      <error message=", limit)
                try output_junit_append_attribute(writer, record.message, limit)
                try output_junit_append_text(writer, "/>\n", limit)
            elif record.status == OutputStatus.Crashed:
                try output_junit_append_text(writer, "      <error message=", limit)
                try output_junit_append_attribute(writer, record.message, limit)
                try output_junit_append_text(writer, " type=\"crashed\"/>\n", limit)
            elif record.status == OutputStatus.TimedOut:
                try output_junit_append_text(writer, "      <error message=", limit)
                try output_junit_append_attribute(writer, record.message, limit)
                try output_junit_append_text(writer, " type=\"timed_out\"/>\n", limit)
            elif record.status == OutputStatus.Cancelled:
                try output_junit_append_text(writer, "      <skipped message=", limit)
                try output_junit_append_attribute(writer, record.message, limit)
                try output_junit_append_text(writer, " type=\"cancelled\"/>\n", limit)
            elif record.status == OutputStatus.Skip:
                try output_junit_append_text(writer, "      <skipped message=", limit)
                try output_junit_append_attribute(writer, record.message, limit)
                try output_junit_append_text(writer, "/>\n", limit)
            elif record.status == OutputStatus.Flaky:
                # The report record retains the final result, not failed-attempt
                # history, so do not fabricate a JUnit <flakyFailure> payload.
                try output_junit_append_property(writer, "elisascript.flaky", "true", limit)
                if record.message != "":
                    try output_junit_append_property(writer, "elisascript.message", record.message, limit)
            elif record.status == OutputStatus.Pass and record.message != "":
                try output_junit_append_property(writer, "elisascript.message", record.message, limit)

            if record.stdout != "":
                try output_junit_append_text(writer, "      <system-out>", limit)
                try output_junit_append_xml(writer, record.stdout, limit)
                try output_junit_append_text(writer, "</system-out>\n", limit)
            if record.stderr != "":
                try output_junit_append_text(writer, "      <system-err>", limit)
                try output_junit_append_xml(writer, record.stderr, limit)
                try output_junit_append_text(writer, "</system-err>\n", limit)

            try output_junit_append_text(writer, "    </testcase>\n", limit)


        def output_junit_prepare(document: OutputDocument&, max_bytes: usize) -> OutputJunitCounts error[OutputContractError, OutputJunitError]:
            raise OutputJunitError.InvalidLimit if max_bytes == 0 or max_bytes > Limits::MAX_BYTES
            try validate_output_document(document)
            raise OutputJunitError.InvalidFormat if document.state != OutputDocumentState.Sealed or document.options.format != OutputFormat.Junit

            failures: mutable usize = 0
            errors: mutable usize = 0
            skipped: mutable usize = 0
            for record in document.records |document, failures, errors, skipped|:
                failures <- failures + 1 if record.status == OutputStatus.Fail
                errors <- errors + 1 if record.status == OutputStatus.Error or record.status == OutputStatus.Crashed or record.status == OutputStatus.TimedOut
                skipped <- skipped + 1 if record.status == OutputStatus.Skip or record.status == OutputStatus.Cancelled
            return OutputJunitCounts{tests: document.records.count, failures: failures, errors: errors, skipped: skipped}


        def output_junit_record_valid(record: OutputRecord) -> bool:
            return false if sview_len(record.name) == 0 or sview_len(record.name) >= EsOutput::Limits::NAME_BYTES or sview_contains_byte(record.name, 0)
            return false if sview_len(record.message) >= EsOutput::Limits::TEXT_BYTES or sview_contains_byte(record.message, 0)
            return false if sview_len(record.stdout) >= EsOutput::Limits::TEXT_BYTES or sview_contains_byte(record.stdout, 0)
            return false if sview_len(record.stderr) >= EsOutput::Limits::TEXT_BYTES or sview_contains_byte(record.stderr, 0)
            return record.status in {OutputStatus.Pass, OutputStatus.Flaky, OutputStatus.Fail, OutputStatus.Error, OutputStatus.Skip, OutputStatus.Crashed, OutputStatus.TimedOut, OutputStatus.Cancelled}


        def output_junit_document_limit(document: OutputDocument&, requested_bytes: usize) -> usize error[OutputJunitError]:
            raise OutputJunitError.InvalidLimit if requested_bytes == 0 or requested_bytes > Limits::MAX_BYTES
            return document.options.max_bytes if requested_bytes > document.options.max_bytes
            return requested_bytes


        def output_junit_append_header(writer: mutable OutputJunitWriter&, counts: OutputJunitCounts, limit: usize) -> void error[OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            try output_junit_append_text(writer, "<testsuites tests=", limit)
            try output_junit_append_attribute_usize(writer, counts.tests, limit)
            try output_junit_append_text(writer, " failures=", limit)
            try output_junit_append_attribute_usize(writer, counts.failures, limit)
            try output_junit_append_text(writer, " errors=", limit)
            try output_junit_append_attribute_usize(writer, counts.errors, limit)
            try output_junit_append_text(writer, " skipped=", limit)
            try output_junit_append_attribute_usize(writer, counts.skipped, limit)
            try output_junit_append_text(writer, ">\n  <testsuite name=", limit)
            try output_junit_append_attribute(writer, "elisascript", limit)
            try output_junit_append_text(writer, " tests=", limit)
            try output_junit_append_attribute_usize(writer, counts.tests, limit)
            try output_junit_append_text(writer, " failures=", limit)
            try output_junit_append_attribute_usize(writer, counts.failures, limit)
            try output_junit_append_text(writer, " errors=", limit)
            try output_junit_append_attribute_usize(writer, counts.errors, limit)
            try output_junit_append_text(writer, " skipped=", limit)
            try output_junit_append_attribute_usize(writer, counts.skipped, limit)
            try output_junit_append_text(writer, ">\n", limit)


        def output_junit_append_footer(writer: mutable OutputJunitWriter&, limit: usize) -> void error[OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            try output_junit_append_text(writer, "  </testsuite>\n</testsuites>\n", limit)


    public:
        def render_output_junit_header_frame(document: OutputDocument&, max_bytes: usize) -> darray[u8] error[OutputContractError, OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            effective_limit: usize = try output_junit_document_limit(document, max_bytes)
            counts: OutputJunitCounts = try output_junit_prepare(document, effective_limit)
            writer: mutable OutputJunitWriter = OutputJunitWriter{}
            try output_junit_append_header(writer, counts, effective_limit)
            return writer.bytes


        def render_output_junit_record_frame(record: OutputRecord, max_bytes: usize) -> darray[u8] error[OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            raise OutputJunitError.InvalidLimit if max_bytes == 0 or max_bytes > Limits::MAX_BYTES
            raise OutputJunitError.InvalidRecord if not output_junit_record_valid(record)
            writer: mutable OutputJunitWriter = OutputJunitWriter{}
            try output_junit_append_record(writer, record, max_bytes)
            return writer.bytes


        def render_output_junit_footer_frame(max_bytes: usize) -> darray[u8] error[OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            raise OutputJunitError.InvalidLimit if max_bytes == 0 or max_bytes > Limits::MAX_BYTES
            writer: mutable OutputJunitWriter = OutputJunitWriter{}
            try output_junit_append_footer(writer, max_bytes)
            return writer.bytes


        def measure_output_junit_header_frame(document: OutputDocument&, max_bytes: usize) -> usize error[OutputContractError, OutputJunitError]:
            effective_limit: usize = try output_junit_document_limit(document, max_bytes)
            counts: OutputJunitCounts = try output_junit_prepare(document, effective_limit)
            writer: mutable OutputJunitWriter = OutputJunitWriter{count_only: true}
            try output_junit_append_header(writer, counts, effective_limit)
            return writer.byte_count


        def measure_output_junit_record_frame(record: OutputRecord, max_bytes: usize) -> usize error[OutputJunitError]:
            raise OutputJunitError.InvalidLimit if max_bytes == 0 or max_bytes > Limits::MAX_BYTES
            raise OutputJunitError.InvalidRecord if not output_junit_record_valid(record)
            writer: mutable OutputJunitWriter = OutputJunitWriter{count_only: true}
            try output_junit_append_record(writer, record, max_bytes)
            return writer.byte_count


        def measure_output_junit_footer_frame(max_bytes: usize) -> usize error[OutputJunitError]:
            raise OutputJunitError.InvalidLimit if max_bytes == 0 or max_bytes > Limits::MAX_BYTES
            writer: mutable OutputJunitWriter = OutputJunitWriter{count_only: true}
            try output_junit_append_footer(writer, max_bytes)
            return writer.byte_count


        def render_output_document_junit(document: OutputDocument&, max_bytes: usize = Limits::MAX_BYTES) -> darray[u8] error[OutputContractError, OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            effective_limit: usize = try output_junit_document_limit(document, max_bytes)
            counts: OutputJunitCounts = try output_junit_prepare(document, effective_limit)
            writer: mutable OutputJunitWriter = OutputJunitWriter{}
            try output_junit_append_header(writer, counts, effective_limit)
            for record in document.records |writer, document, effective_limit|:
                try output_junit_append_record(writer, record, effective_limit)
            try output_junit_append_footer(writer, effective_limit)
            return writer.bytes
