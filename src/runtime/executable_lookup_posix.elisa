# POSIX executable discovery for adapters that mirror shutil.which semantics.
# An explicitly empty PATH searches the current directory; only an unset PATH
# selects the platform's default search path.
module EsExecutableLookupPosix:
    public:
        def which(program: sview) -> sview can[Environment.Read, Directory.Read, File.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            selected_path: sview = try getenv("PATH", "\0") else "\0"
            selected_path <- Defaults::POSIX_PATH if selected_path == "\0"
            return which_in_path(program, selected_path)


        def which_in_path(program: sview, search_path: sview) -> sview can[Directory.Read, File.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return "" if program == "" or sview_contains_byte(program, 0u8) or sview_contains_byte(search_path, 0u8)
            if sview_contains_byte(program, 47u8):
                candidate: Path = path(program)
                return f"{candidate}" if executable_file(candidate)
                return ""

            length: usize = sview_len(search_path)
            segment_start: mutable usize = 0
            cursor: mutable usize = 0
            while cursor <= length |search_path, program, segment_start, cursor|:
                if cursor == length or sview_at(search_path, cursor) == 58u8:
                    directory: sview = string_view_slice(search_path, segment_start.i64(), cursor.i64())
                    candidate: Path = path(program) if directory == "" else path(directory).joinpath(program)
                    return f"{candidate}" if executable_file(candidate)
                    segment_start <- cursor + 1
                cursor <- cursor + 1
            return ""


    private:
        const module Defaults:
            POSIX_PATH: sview = "/bin:/usr/bin"


        def executable_file(candidate: Path) -> bool can[File.Read, Directory.Read, Unsafe.PointerCast]:
            return try is_file(candidate) and is_executable(candidate) else failure:
                _ = failure
                false
