# Pure Darwin exec-search decisions. This is an explicit policy, not a claim
# of every execvp/Bash behavior or proof that a native exec has happened.
module EsProcessExecSearch:
    public:
        const module DarwinErrno:
            ENOENT: i32 = 2
            EINTR: i32 = 4
            ENOEXEC: i32 = 8
            EACCES: i32 = 13
            ENOTDIR: i32 = 20


        const enum Action of u8:
            Next
            NextDenied
            Stop


        const enum ReturnedExecKind of u8:
            NotFound
            AccessDenied
            OtherFailure
            InvalidErrno
            InvalidBridgeReturn


        # This describes only a return from the native exec call. A normal
        # child's exit status is a different process outcome and cannot be
        # represented by this type.
        struct ReturnedExec:
            kind: ReturnedExecKind
            shell_status: i32
            errno: i32 = 0
            errno_admitted: bool = false


        def after_failure(errno: i32) -> Action:
            return Action.Next if errno == DarwinErrno::ENOENT or errno == DarwinErrno::ENOTDIR
            return Action.NextDenied if errno == DarwinErrno::EACCES
            # Invalid format (ENOEXEC), E2BIG, ENOMEM, EIO, ETXTBSY, EINTR
            # and unrecognized failures stop. Never interpret a text executable
            # as a shell program, retry a fatal host failure or hide it behind
            # a later PATH candidate that happens to exist.
            return Action.Stop


        def exhausted_status(saw_denied: bool) -> i32:
            return 126i32 if saw_denied
            return 127i32


        def fatal_status() -> i32:
            return 126i32


        # Only a native -1 admits the sampled errno. Keep its category and
        # provenance intact so callers can construct typed launch errors
        # instead of treating 126/127 as proof that exec failed.
        def classify_returned_exec(result: i64, errno: i32) -> ReturnedExec:
            return ReturnedExec{kind: ReturnedExecKind.InvalidBridgeReturn, shell_status: fatal_status()} if result != -1i64
            return ReturnedExec{kind: ReturnedExecKind.InvalidErrno, shell_status: fatal_status(), errno: errno, errno_admitted: true} if errno <= 0
            return ReturnedExec{kind: ReturnedExecKind.NotFound, shell_status: exhausted_status(false), errno: errno, errno_admitted: true} if errno == DarwinErrno::ENOENT or errno == DarwinErrno::ENOTDIR
            return ReturnedExec{kind: ReturnedExecKind.AccessDenied, shell_status: fatal_status(), errno: errno, errno_admitted: true} if errno == DarwinErrno::EACCES
            return ReturnedExec{kind: ReturnedExecKind.OtherFailure, shell_status: fatal_status(), errno: errno, errno_admitted: true}


        # Legacy child-exit compatibility only. This is not a parent-side
        # launch receipt: a tool can also normally return either status.
        # Only native -1 admits errno; invalid/bridge returns fail closed.
        def returned_exec_status(result: i64, errno: i32) -> i32:
            return classify_returned_exec(result, errno).shell_status
