# Descriptor-verified, bounded UTF-8 scanner for source-length audits.
# Unlike EsBoundedText::read_utf8, this reader retains only its fixed-size
# chunk and the newline/UTF-8 cursors, not the complete file contents.

include "encoding.elisa"
include "file_posix.elisa"
include "directory_posix.elisa"
include "stdio_posix.elisa"
include "source_length_model.elisa"

using EsEncoding
using EsRuntime
using EsSourceLength


module EsSourceLengthFile:
    public:
        struct ScanResult:
            bytes_read: usize = 0
            lines: usize = 0


        error ReadError:
            InvalidPath
            ReadFailed
            Changed
            LimitExceeded
            InvalidUtf8


    private:
        const module Limits:
            MAX_BYTES: usize = 16777216
            PATH_BYTES: usize = 4096
            READ_CHUNK_BYTES: usize = 16384
            READ_EINTR_RETRIES: usize = 4
            MAX_DESCRIPTOR: int = 2147483647


        const enum ReadPhase of u8:
            ReadChunk
            Done


        def descriptor_shape(value: int) -> bool:
            return value >= 0 and value <= Limits::MAX_DESCRIPTOR


        def errno_shape(value: i64) -> bool:
            return value == -1i64


        def open_path(path_value: cstr) -> int can[Blocking.IO]:
            retries: mutable usize = 0
            flags: int = DarwinOpenFlags::RDONLY | DarwinOpenFlags::NONBLOCK | DarwinOpenFlags::CLOSE_ON_EXEC
            while true:
                descriptor: int = elisascript_posix_open(path_value, flags, 0u32)
                return descriptor if descriptor_shape(descriptor)
                return -1 if not errno_shape(descriptor.i64())
                errno: mutable int& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::READ_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return -1


        def stat_path(path_value: cstr, result: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                returned: int = elisascript_posix_stat(path_value, result)
                return true if returned == 0
                return false if not errno_shape(returned.i64())
                errno: mutable int& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::READ_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def fstat_descriptor(descriptor: int, result: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                returned: int = elisascript_posix_fstat(descriptor, result)
                return true if returned == 0
                return false if not errno_shape(returned.i64())
                errno: mutable int& = elisascript_posix_errno()
                if errno[0] == DarwinErrno::EINTR and retries < Limits::READ_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def same_file(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return left.device == right.device and left.inode == right.inode


        def stable_file(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return same_file(left, right) and left.size == right.size and left.modify_time.seconds == right.modify_time.seconds and left.modify_time.nanoseconds == right.modify_time.nanoseconds and left.change_time.seconds == right.change_time.seconds and left.change_time.nanoseconds == right.change_time.nanoseconds


    public:
        # Follows file symlinks like Python's open(), but verifies the named
        # object before/after open and the opened descriptor before/after read.
        # maximum_bytes is inclusive; one extra probe byte distinguishes an
        # exactly-at-limit file from an oversized one without buffering it.
        def read_utf8_line_count(input_path: Path, maximum_bytes: usize) -> ScanResult error[ReadError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise ReadError.LimitExceeded if maximum_bytes > Limits::MAX_BYTES
            path_text: sview = f"{input_path}"
            raise ReadError.InvalidPath if path_text == "" or len(path_text) >= Limits::PATH_BYTES or sview_contains_byte(path_text, 0)
            path_bytes: mutable darray[u8] = []
            for byte in path_text |path_bytes|:
                path_bytes.push(byte)
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr]

            named_before_open: mutable ElisascriptStat = zeroed
            raise ReadError.ReadFailed if not stat_path(path_pointer, named_before_open) or (named_before_open.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR
            descriptor: int = open_path(path_pointer)
            raise ReadError.ReadFailed if descriptor < 0
            opened: mutable ElisascriptStat = zeroed
            if not fstat_descriptor(descriptor, opened) or (opened.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR or not same_file(named_before_open, opened):
                _ = elisascript_posix_close(descriptor)
                raise ReadError.ReadFailed
            named_after_open: mutable ElisascriptStat = zeroed
            if not stat_path(path_pointer, named_after_open) or (named_after_open.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR or not same_file(opened, named_after_open):
                _ = elisascript_posix_close(descriptor)
                raise ReadError.Changed

            chunk: mutable darray[u8] = []
            chunk.reserve(Limits::READ_CHUNK_BYTES)
            for _ in 0..<Limits::READ_CHUNK_BYTES |chunk|:
                chunk.push(0u8)
            bytes_read: mutable usize = 0
            lines: mutable UniversalLineCounter = new_universal_line_counter()
            utf8: mutable Utf8Cursor = Utf8Cursor{}
            utf8_valid: mutable bool = true
            interrupted: mutable usize = 0
            phase: mutable ReadPhase = ReadPhase.ReadChunk

            machine over phase while phase != ReadPhase.Done:
                state ReadChunk
                start ReadChunk

                ReadChunk, ReadPhase.ReadChunk:
                    remaining: usize = maximum_bytes - bytes_read
                    probe_capacity: usize = remaining + 1
                    capacity: usize = probe_capacity if probe_capacity < chunk.count else chunk.count
                    chunk_pointer: mutable u8& = (&chunk[0]).cast[mutable u8&]
                    amount: isize = elisascript_posix_read(descriptor, chunk_pointer.cast[mutable void&], capacity)
                    if amount < 0:
                        if not errno_shape(amount.i64()):
                            _ = elisascript_posix_close(descriptor)
                            raise ReadError.ReadFailed
                        errno: mutable int& = elisascript_posix_errno()
                        if errno[0] == DarwinErrno::EINTR and interrupted < Limits::READ_EINTR_RETRIES:
                            interrupted <- interrupted + 1
                            -> ReadChunk
                        _ = elisascript_posix_close(descriptor)
                        raise ReadError.ReadFailed
                    if amount == 0:
                        phase <- ReadPhase.Done
                        continue
                    read_count: usize = amount.usize()
                    if read_count > capacity:
                        _ = elisascript_posix_close(descriptor)
                        raise ReadError.ReadFailed
                    if read_count > remaining:
                        _ = elisascript_posix_close(descriptor)
                        raise ReadError.LimitExceeded
                    if utf8_valid and not utf8_validate(chunk_pointer, read_count, utf8):
                        utf8_valid <- false
                    for offset in 0..<read_count |chunk, lines|:
                        feed_universal_line_byte(chunk[offset], lines)
                    bytes_read <- bytes_read + read_count
                    interrupted <- 0
                    -> ReadChunk

                ReadChunk, ReadPhase.Done:
                    break

            utf8_valid <- false if not utf8_complete(utf8)
            final_opened: mutable ElisascriptStat = zeroed
            final_named: mutable ElisascriptStat = zeroed
            stable: bool = fstat_descriptor(descriptor, final_opened) and stat_path(path_pointer, final_named) and stable_file(opened, final_opened) and same_file(final_opened, final_named)
            close_status: int = elisascript_posix_close(descriptor)
            raise ReadError.ReadFailed if close_status != 0
            raise ReadError.Changed if not stable
            raise ReadError.InvalidUtf8 if not utf8_valid
            return ScanResult{bytes_read: bytes_read, lines: finish_universal_line_count(lines)}
