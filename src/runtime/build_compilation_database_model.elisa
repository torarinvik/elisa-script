# Deterministic, bounded clang/CMake compilation-database projection.
#
# The caller explicitly selects translation-unit actions from an owned build
# plan. Argument vectors stay tokenized; no shell command is reconstructed.

module EsBuildCompilationDatabase:
    using EsBuild
    using EsBuildExecutor
    using EsBuildUsageGraph
    using EsEncoding
    using EsProcess

    public:
        const module Limits:
            ENTRIES: usize = EsBuild::Limits::NODES
            PATH_BYTES: usize = 4096
            OUTPUT_BYTES: usize = 67108864


        struct BuildCompilationSource:
            action_index: usize
            source_file: sview
            output_file: sview = ""


        error BuildCompilationDatabaseError:
            EntryLimitExceeded
            OutputLimitExceeded
            InvalidLimit
            InvalidActionIndex
            DuplicateAction
            ActionOrderInvalid
            InvalidDirectory
            InvalidSourceFile
            InvalidCompileAction
            InvalidOutputPath
            InvalidUtf8
            InvalidArgument
            UnsupportedEnvironment


    private:
        const module Clang:
            MODULE_OUTPUT: sview = "-fmodule-output"
            MODULE_OUTPUT_EQUALS: sview = "-fmodule-output="
            TIME_TRACE: sview = "-ftime-trace"
            TIME_TRACE_EQUALS: sview = "-ftime-trace="
            INDEX_STORE_PATH: sview = "-index-store-path"
            INDEX_STORE_PATH_EQUALS: sview = "-index-store-path="
            INDEX_UNIT_OUTPUT_PATH: sview = "-index-unit-output-path"
            INDEX_UNIT_OUTPUT_PATH_EQUALS: sview = "-index-unit-output-path="
            MODULES_CACHE_PATH_EQUALS: sview = "-fmodules-cache-path="
            MODULES_USER_BUILD_PATH: sview = "-fmodules-user-build-path"
            MODULES_USER_BUILD_PATH_EQUALS: sview = "-fmodules-user-build-path="


        const module Dwarf:
            SPLIT: sview = "-gsplit-dwarf"
            SPLIT_EQUALS: sview = "-gsplit-dwarf="
            SPLIT_MODE: sview = "-gsplit-dwarf=split"
            SINGLE_MODE: sview = "-gsplit-dwarf=single"
            DISABLE_SPLIT: sview = "-gno-split-dwarf"


        const module Dependency:
            FILE: sview = "-dependency-file"
            DOT: sview = "-dependency-dot"


        const module OptimizationRecord:
            SAVE: sview = "-fsave-optimization-record"
            SAVE_EQUALS: sview = "-fsave-optimization-record="
            DISABLE: sview = "-fno-save-optimization-record"
            FILE_EQUALS: sview = "-foptimization-record-file="
            PASSES_EQUALS: sview = "-foptimization-record-passes="


        const module Json:
            HEX: sview = "0123456789abcdef"


        def database_utf8_valid(value: sview) -> bool:
            cursor: mutable Utf8Cursor = Utf8Cursor{}
            for byte in value |cursor|:
                return false if not utf8_feed(byte, cursor)
            return utf8_complete(cursor)


        def database_append_byte(output: mutable darray[u8]&, byte: u8, limit: usize) -> void error[BuildCompilationDatabaseError] can[Memory.Allocate, Abort.Panic]:
            raise BuildCompilationDatabaseError.OutputLimitExceeded if output.count >= limit
            output.push(byte)


        def database_append_text(output: mutable darray[u8]&, value: sview, limit: usize) -> void error[BuildCompilationDatabaseError] can[Memory.Allocate, Abort.Panic]:
            length: usize = sview_len(value)
            raise BuildCompilationDatabaseError.OutputLimitExceeded if output.count > limit or length > limit - output.count
            for index in 0..<length |output, value|:
                output.push(sview_at(value, index))


        def database_append_json_string(output: mutable darray[u8]&, value: sview, limit: usize) -> void error[BuildCompilationDatabaseError] can[Memory.Allocate, Abort.Panic]:
            try database_append_byte(output, 34u8, limit)
            for index in 0..<sview_len(value) |output, value, limit|:
                byte: u8 = sview_at(value, index)
                if byte == 34u8 or byte == 92u8:
                    try database_append_byte(output, 92u8, limit)
                    try database_append_byte(output, byte, limit)
                elif byte == 8u8:
                    try database_append_text(output, "\\b", limit)
                elif byte == 9u8:
                    try database_append_text(output, "\\t", limit)
                elif byte == 10u8:
                    try database_append_text(output, "\\n", limit)
                elif byte == 12u8:
                    try database_append_text(output, "\\f", limit)
                elif byte == 13u8:
                    try database_append_text(output, "\\r", limit)
                elif byte < 32u8:
                    try database_append_text(output, "\\u00", limit)
                    try database_append_byte(output, sview_at(Json::HEX, ((byte >> 4) & 15u8).usize()), limit)
                    try database_append_byte(output, sview_at(Json::HEX, (byte & 15u8).usize()), limit)
                else:
                    try database_append_byte(output, byte, limit)
            try database_append_byte(output, 34u8, limit)


        def database_argument_count(arguments: darray[sview], expected: sview) -> usize:
            count: mutable usize = 0
            for argument in arguments |count|:
                count <- count + 1 if argument == expected
            return count


        def database_text_starts_with(value: sview, prefix: sview) -> bool:
            return false if sview_len(value) < sview_len(prefix)
            for index in 0..<sview_len(prefix) |value, prefix|:
                return false if sview_at(value, index) != sview_at(prefix, index)
            return true


        def database_joined_output_option(value: sview) -> bool:
            return false if sview_len(value) <= 2 or not database_text_starts_with(value, "-o")
            # These Clang option families begin with the same bytes as the
            # joined `-o<file>` form but do not select the primary output.
            return false if database_text_starts_with(value, "-object")
            return false if database_text_starts_with(value, "-objc")
            return false if database_text_starts_with(value, "-offload")
            return false if database_text_starts_with(value, "-openmp")
            return false if database_text_starts_with(value, "-opt-")
            return true


        def database_output_option_count(arguments: darray[sview]) -> usize:
            count: mutable usize = 0
            for argument in arguments |count|:
                if argument == "-o" or argument == "--output" or database_text_starts_with(argument, "--output=") or database_joined_output_option(argument):
                    count <- count + 1
            return count


        def database_output_option_operand(arguments: darray[sview]) -> sview:
            operand: mutable sview = ""
            for index in 0..<arguments.count |arguments, operand|:
                argument: sview = arguments[index]
                if argument == "-o" or argument == "--output":
                    operand <- arguments[index + 1] if index + 1 < arguments.count
                elif database_text_starts_with(argument, "--output="):
                    operand <- string_view_slice(argument, 9i64, sview_len(argument).i64())
                elif database_joined_output_option(argument):
                    operand <- string_view_slice(argument, 2i64, sview_len(argument).i64())
            return operand


        def database_output_option_shape_valid(arguments: darray[sview]) -> bool:
            count: usize = database_output_option_count(arguments)
            return false if count > 1
            return true if count == 0
            return database_output_option_operand(arguments) != ""


        def database_file_output_option_count(arguments: darray[sview], option: sview) -> usize:
            count: mutable usize = 0
            for argument in arguments |count|:
                count <- count + 1 if argument == option or (sview_len(argument) > sview_len(option) and database_text_starts_with(argument, option))
            return count


        def database_file_output_option_operand(arguments: darray[sview], option: sview) -> sview:
            operand: mutable sview = ""
            for index in 0..<arguments.count |arguments, operand|:
                argument: sview = arguments[index]
                if argument == option:
                    operand <- arguments[index + 1] if index + 1 < arguments.count
                elif sview_len(argument) > sview_len(option) and database_text_starts_with(argument, option):
                    operand <- string_view_slice(argument, sview_len(option).i64(), sview_len(argument).i64())
            return operand


        def database_file_output_option_shape_valid(arguments: darray[sview], option: sview) -> bool:
            count: usize = database_file_output_option_count(arguments, option)
            return false if count > 1
            return true if count == 0
            return database_file_output_option_operand(arguments, option) != ""


        def database_dependency_file_option_count(arguments: darray[sview]) -> usize:
            count: mutable usize = 0
            consume_next: mutable bool = false
            for argument in arguments |count, consume_next|:
                if consume_next:
                    consume_next <- false
                elif argument == "-MF" or argument == Dependency::FILE:
                    count <- count + 1
                    consume_next <- true
                elif (sview_len(argument) > 3 and database_text_starts_with(argument, "-MF")) or database_text_starts_with(argument, Dependency::FILE):
                    count <- count + 1
            return count


        def database_dependency_file_option_operand(arguments: darray[sview]) -> sview:
            operand: mutable sview = database_file_output_option_operand(arguments, "-MF")
            for index in 0..<arguments.count |arguments, operand|:
                argument: sview = arguments[index]
                if argument == Dependency::FILE:
                    operand <- arguments[index + 1] if index + 1 < arguments.count
            return operand


        def database_dependency_file_option_shape_valid(arguments: darray[sview]) -> bool:
            count: usize = database_dependency_file_option_count(arguments)
            return false if count > 1
            malformed_alias: mutable bool = false
            consume_next: mutable bool = false
            for argument in arguments |malformed_alias, consume_next|:
                if consume_next:
                    consume_next <- false
                elif argument == "-MF" or argument == Dependency::FILE:
                    consume_next <- true
                elif database_text_starts_with(argument, Dependency::FILE):
                    malformed_alias <- true
            return false if malformed_alias
            return true if count == 0
            return database_dependency_file_option_operand(arguments) != ""


        def database_dependency_dot_option_count(arguments: darray[sview]) -> usize:
            count: mutable usize = 0
            consume_next: mutable bool = false
            for argument in arguments |count, consume_next|:
                if consume_next:
                    consume_next <- false
                elif argument == Dependency::DOT:
                    count <- count + 1
                    consume_next <- true
                elif database_text_starts_with(argument, Dependency::DOT):
                    count <- count + 1
            return count


        def database_dependency_dot_option_operand(arguments: darray[sview]) -> sview:
            for index in 0..<arguments.count |arguments|:
                if arguments[index] == Dependency::DOT and index + 1 < arguments.count:
                    return arguments[index + 1]
            return ""


        def database_dependency_dot_option_shape_valid(arguments: darray[sview]) -> bool:
            count: usize = database_dependency_dot_option_count(arguments)
            return false if count > 1
            malformed_alias: mutable bool = false
            consume_next: mutable bool = false
            for argument in arguments |malformed_alias, consume_next|:
                if consume_next:
                    consume_next <- false
                elif argument == Dependency::DOT:
                    consume_next <- true
                elif database_text_starts_with(argument, Dependency::DOT):
                    malformed_alias <- true
            return false if malformed_alias
            return true if count == 0
            return database_dependency_dot_option_operand(arguments) != ""


        def database_generates_implicit_depfile(arguments: darray[sview]) -> bool:
            dependency_mode: mutable bool = false
            for argument in arguments |dependency_mode|:
                dependency_mode <- true if argument == "-MD" or argument == "-MMD"
            return dependency_mode and database_dependency_file_option_count(arguments) == 0


        def database_has_unmodeled_auxiliary_outputs(arguments: darray[sview]) -> bool:
            for argument in arguments:
                if argument == "-save-temps" or argument == "--save-temps" or argument == "-save-stats" or argument == "--save-stats":
                    return true
                if database_text_starts_with(argument, "-save-temps=") or database_text_starts_with(argument, "--save-temps=") or database_text_starts_with(argument, "-save-stats=") or database_text_starts_with(argument, "--save-stats="):
                    return true
                if argument == "--save-dynamic-debugging-temps":
                    return true
                if argument == "-module-dependency-dir" or database_text_starts_with(argument, "-module-dependency-dir="):
                    return true
                # These options write compiler-managed trees rather than a
                # single file that this graph can own. Index-store paths are
                # common in Xcode compile commands; module caches are also
                # directory-valued side effects.
                if argument == Clang::INDEX_STORE_PATH or database_text_starts_with(argument, Clang::INDEX_STORE_PATH_EQUALS):
                    return true
                if argument == Clang::INDEX_UNIT_OUTPUT_PATH or database_text_starts_with(argument, Clang::INDEX_UNIT_OUTPUT_PATH_EQUALS):
                    return true
                if database_text_starts_with(argument, Clang::MODULES_CACHE_PATH_EQUALS):
                    return true
                if argument == Clang::MODULES_USER_BUILD_PATH or database_text_starts_with(argument, Clang::MODULES_USER_BUILD_PATH_EQUALS):
                    return true
                if argument == "-emit-symbol-graph" or argument == "--emit-extension-symbol-graphs" or database_text_starts_with(argument, "--symbol-graph-dir="):
                    return true
                if database_text_starts_with(argument, "-fcrash-diagnostics-dir=") or database_text_starts_with(argument, "-fcrash-diagnostics-tar="):
                    return true
                if argument == "-fcrash-diagnostics":
                    return true
                if database_text_starts_with(argument, "-fcrash-diagnostics="):
                    crash_diagnostics_mode: sview = string_view_slice(argument, sview_len("-fcrash-diagnostics=").i64(), sview_len(argument).i64())
                    return true if crash_diagnostics_mode != "off"
                if database_text_starts_with(argument, "-gen-reproducer="):
                    reproducer_mode: sview = string_view_slice(argument, sview_len("-gen-reproducer=").i64(), sview_len(argument).i64())
                    return true if reproducer_mode != "off"
                if database_text_starts_with(argument, "-fproc-stat-report="):
                    return true
                if argument == "-ftest-coverage" or argument == "--coverage" or argument == "-coverage":
                    return true
            return false


        def database_time_trace_option_count(arguments: darray[sview]) -> usize:
            count: mutable usize = 0
            for argument in arguments |count|:
                count <- count + 1 if argument == Clang::TIME_TRACE or database_text_starts_with(argument, Clang::TIME_TRACE_EQUALS)
            return count


        def database_time_trace_option_operand(arguments: darray[sview]) -> sview:
            for argument in arguments:
                if database_text_starts_with(argument, Clang::TIME_TRACE_EQUALS):
                    return string_view_slice(argument, sview_len(Clang::TIME_TRACE_EQUALS).i64(), sview_len(argument).i64())
            return ""


        def database_time_trace_option_shape_valid(arguments: darray[sview]) -> bool:
            count: usize = database_time_trace_option_count(arguments)
            return false if count > 1
            return true if count == 0 or database_argument_count(arguments, Clang::TIME_TRACE) == 1
            return database_time_trace_option_operand(arguments) != ""


        def database_default_time_trace_output_path(primary_output_path: Path) -> Path can[Memory.Allocate, Abort.Panic]:
            trace_name: sview = path_stem(primary_output_path) + ".json"
            return path_normalize(path_join(path_parent(primary_output_path), trace_name))


        def database_time_trace_output_path_in_directory(directory: Path, primary_output_path: Path) -> Path can[Memory.Allocate, Abort.Panic]:
            default_trace_path: Path = database_default_time_trace_output_path(primary_output_path)
            return path_normalize(path_join(directory, path_name(default_trace_path)))


        def database_optimization_record_enabled(arguments: darray[sview]) -> bool:
            enabled: mutable bool = false
            for argument in arguments |enabled|:
                if argument == OptimizationRecord::SAVE or database_text_starts_with(argument, OptimizationRecord::SAVE_EQUALS) or database_text_starts_with(argument, OptimizationRecord::FILE_EQUALS) or database_text_starts_with(argument, OptimizationRecord::PASSES_EQUALS):
                    enabled <- true
                elif argument == OptimizationRecord::DISABLE:
                    enabled <- false
            return enabled


        def database_optimization_record_format(arguments: darray[sview]) -> sview:
            format: mutable sview = "yaml"
            for argument in arguments |format|:
                if database_text_starts_with(argument, OptimizationRecord::SAVE_EQUALS):
                    format <- string_view_slice(argument, sview_len(OptimizationRecord::SAVE_EQUALS).i64(), sview_len(argument).i64())
            return format


        def database_optimization_record_file_option_count(arguments: darray[sview]) -> usize:
            count: mutable usize = 0
            for argument in arguments |count|:
                count <- count + 1 if database_text_starts_with(argument, OptimizationRecord::FILE_EQUALS)
            return count


        def database_optimization_record_file_option_operand(arguments: darray[sview]) -> sview:
            for argument in arguments:
                if database_text_starts_with(argument, OptimizationRecord::FILE_EQUALS):
                    return string_view_slice(argument, sview_len(OptimizationRecord::FILE_EQUALS).i64(), sview_len(argument).i64())
            return ""


        def database_optimization_record_format_option_count(arguments: darray[sview]) -> usize:
            count: mutable usize = 0
            for argument in arguments |count|:
                count <- count + 1 if database_text_starts_with(argument, OptimizationRecord::SAVE_EQUALS)
            return count


        def database_optimization_record_option_shape_valid(arguments: darray[sview]) -> bool:
            file_option_count: usize = database_optimization_record_file_option_count(arguments)
            return false if file_option_count > 1
            format_option_count: usize = database_optimization_record_format_option_count(arguments)
            return false if format_option_count > 1
            format: sview = database_optimization_record_format(arguments)
            return false if format != "yaml" and format != "bitstream"
            return true if file_option_count == 0
            return database_optimization_record_file_option_operand(arguments) != ""


        def database_optimization_record_output_path(primary_output_path: Path, format: sview) -> Path can[Memory.Allocate, Abort.Panic]:
            record_name: sview = path_stem(primary_output_path) + ".opt." + format
            return path_normalize(path_join(path_parent(primary_output_path), record_name))


        def database_optimization_record_path_is_modelable(arguments: darray[sview]) -> bool:
            # Darwin's per-architecture optimization-record naming is not
            # represented by this single-output projection.
            return false if database_argument_count(arguments, "-arch") > 0
            for argument in arguments:
                # LTO can emit per-backend records whose names are not
                # derivable from the frontend's primary output.
                return false if database_text_starts_with(argument, "-flto")
            return true


        def database_split_dwarf_option_shape_valid(arguments: darray[sview]) -> bool:
            for argument in arguments:
                if database_text_starts_with(argument, Dwarf::SPLIT_EQUALS):
                    mode: sview = string_view_slice(argument, sview_len(Dwarf::SPLIT_EQUALS).i64(), sview_len(argument).i64())
                    return false if mode != "split" and mode != "single"
            return true


        def database_debug_information_enabled(arguments: darray[sview]) -> bool:
            enabled: mutable bool = false
            for argument in arguments |enabled|:
                if argument == "-g0" or argument == "-ggdb0":
                    enabled <- false
                elif argument == "-g" or argument == "-g1" or argument == "-g2" or argument == "-g3" or argument == "-ggdb" or argument == "-ggdb1" or argument == "-ggdb2" or argument == "-ggdb3" or database_text_starts_with(argument, "-gdwarf-") or argument == "-gline-tables-only":
                    enabled <- true
            return enabled


        def database_split_dwarf_sidecar_required(arguments: darray[sview]) -> bool:
            split_enabled: mutable bool = false
            for argument in arguments |split_enabled|:
                if argument == Dwarf::SPLIT or argument == Dwarf::SPLIT_MODE:
                    split_enabled <- true
                elif argument == Dwarf::DISABLE_SPLIT or argument == Dwarf::SINGLE_MODE:
                    split_enabled <- false
            return split_enabled and database_debug_information_enabled(arguments)


        def database_split_dwarf_sidecar_path_is_modelable(arguments: darray[sview]) -> bool:
            for argument in arguments:
                if argument == "-dumpdir" or argument == "--dumpdir" or database_text_starts_with(argument, "-dumpdir=") or database_text_starts_with(argument, "--dumpdir="):
                    return false
                if argument == "-dumpbase" or argument == "--dumpbase" or database_text_starts_with(argument, "-dumpbase=") or database_text_starts_with(argument, "--dumpbase="):
                    return false
                if argument == "-dumpbase-ext" or argument == "--dumpbase-ext" or database_text_starts_with(argument, "-dumpbase-ext=") or database_text_starts_with(argument, "--dumpbase-ext="):
                    return false
            return true


        def database_split_dwarf_output_path(primary_output_path: Path) -> Path can[Memory.Allocate, Abort.Panic]:
            dwarf_name: sview = path_stem(primary_output_path) + ".dwo"
            return path_normalize(path_join(path_parent(primary_output_path), dwarf_name))


        def database_serialized_diagnostics_option_count(arguments: darray[sview]) -> usize:
            count: mutable usize = 0
            for argument in arguments |count|:
                count <- count + 1 if argument == "-serialize-diagnostics" or argument == "--serialize-diagnostics"
            return count


        def database_serialized_diagnostics_option_operand(arguments: darray[sview]) -> sview:
            operand: mutable sview = ""
            for index in 0..<arguments.count |arguments, operand|:
                argument: sview = arguments[index]
                if argument == "-serialize-diagnostics" or argument == "--serialize-diagnostics":
                    operand <- arguments[index + 1] if index + 1 < arguments.count
            return operand


        def database_serialized_diagnostics_option_shape_valid(arguments: darray[sview]) -> bool:
            count: usize = database_serialized_diagnostics_option_count(arguments)
            return false if count > 1
            return true if count == 0
            return database_serialized_diagnostics_option_operand(arguments) != ""


        def database_module_output_option_count(arguments: darray[sview]) -> usize:
            count: mutable usize = 0
            for argument in arguments |count|:
                count <- count + 1 if argument == Clang::MODULE_OUTPUT or database_text_starts_with(argument, Clang::MODULE_OUTPUT_EQUALS)
            return count


        def database_module_output_option_operand(arguments: darray[sview]) -> sview:
            operand: mutable sview = ""
            for argument in arguments |operand|:
                if database_text_starts_with(argument, Clang::MODULE_OUTPUT_EQUALS):
                    operand <- string_view_slice(argument, sview_len(Clang::MODULE_OUTPUT_EQUALS).i64(), sview_len(argument).i64())
            return operand


        def database_module_output_option_uses_default(arguments: darray[sview]) -> bool:
            for argument in arguments:
                return true if argument == Clang::MODULE_OUTPUT
            return false


        def database_module_output_option_shape_valid(arguments: darray[sview]) -> bool:
            count: usize = database_module_output_option_count(arguments)
            return false if count > 1
            for argument in arguments:
                return false if database_text_starts_with(argument, Clang::MODULE_OUTPUT_EQUALS) and sview_len(argument) == sview_len(Clang::MODULE_OUTPUT_EQUALS)
            return true


        # Compiler output operands are interpreted relative to the command's
        # working directory. Normalize lexically, then compare with the
        # graph's canonical absolute output identity (without touching disk).
        def database_resolved_output_path(output_path: sview, working_directory: sview) -> Path can[Memory.Allocate, Abort.Panic]:
            raw_path: Path = path(output_path)
            return path_normalize(raw_path) if path_is_absolute(raw_path) else path_normalize(path_join(path(working_directory), output_path))


        def database_resolved_path_is_declared(resolved_path: Path, output_set: BuildExecutionNodeOutputs) -> bool:
            for declared_path in output_set.paths:
                return true if resolved_path == path(declared_path)
            return false


        def database_record_unique_output_path(paths: mutable darray[Path]&, candidate: Path, output_set: BuildExecutionNodeOutputs) -> void error[BuildCompilationDatabaseError] can[Memory.Allocate, Abort.Panic]:
            raise BuildCompilationDatabaseError.InvalidOutputPath if not database_resolved_path_is_declared(candidate, output_set)
            for previous_path in paths:
                raise BuildCompilationDatabaseError.InvalidOutputPath if previous_path == candidate
            paths.push(candidate)


        def database_output_path_is_declared(output_path: sview, working_directory: sview, output_set: BuildExecutionNodeOutputs) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if output_path == "" or sview_len(output_path) > Limits::PATH_BYTES or sview_contains_byte(output_path, 0)
            resolved_path: Path = database_resolved_output_path(output_path, working_directory)
            return database_resolved_path_is_declared(resolved_path, output_set)


        def database_output_path_matches_resolved(output_path: sview, working_directory: sview, expected_path: Path) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if output_path == "" or sview_len(output_path) > Limits::PATH_BYTES or sview_contains_byte(output_path, 0)
            return database_resolved_output_path(output_path, working_directory) == expected_path


        def database_default_primary_output_path(source_file: sview, working_directory: sview, arguments: darray[sview]) -> Path can[Memory.Allocate, Abort.Panic]:
            # GCC and Clang derive the default -c output from the source
            # basename. Clang's -emit-llvm form writes bitcode instead of an
            # object, and uses .bc as the output suffix.
            suffix: mutable sview = ".o"
            suffix <- ".bc" if database_argument_count(arguments, "-emit-llvm") > 0
            primary_name: sview = path_stem(path(source_file)) + suffix
            return path_normalize(path_join(path(working_directory), primary_name))


        def database_default_module_output_path(source_file: sview, primary_output_path: Path) -> Path can[Memory.Allocate, Abort.Panic]:
            # With `-c -fmodule-output`, Clang places the default BMI beside
            # the object output and uses the source basename with `.pcm`.
            module_name: sview = path_stem(path(source_file)) + ".pcm"
            return path_normalize(path_join(path_parent(primary_output_path), module_name))


        def database_precompiled_header_language(language: sview) -> bool:
            return language == "c-header" or language == "c++-header" or language == "objective-c-header" or language == "objective-c++-header"


        def database_uses_precompiled_header_language(arguments: darray[sview]) -> bool:
            for index in 0..<arguments.count |arguments|:
                argument: sview = arguments[index]
                if argument == "-x":
                    return true if index + 1 < arguments.count and database_precompiled_header_language(arguments[index + 1])
                elif sview_len(argument) > 2 and database_text_starts_with(argument, "-x"):
                    language: sview = string_view_slice(argument, 2i64, sview_len(argument).i64())
                    return true if database_precompiled_header_language(language)
            return false


        def database_option_has_unique_operand(arguments: darray[sview], option: sview, expected: sview) -> bool:
            option_count: mutable usize = 0
            operand_matches: mutable bool = false
            for index in 0..<arguments.count |arguments, option_count, operand_matches|:
                if arguments[index] == option:
                    option_count <- option_count + 1
                    operand_matches <- false
                    if index + 1 < arguments.count:
                        operand_matches <- arguments[index + 1] == expected
            return option_count == 1 and operand_matches


        def database_supported_compile_mode(arguments: darray[sview]) -> bool:
            # The projector's `-c` primary-output model is for object or
            # bitcode compilation. These driver modes replace or suppress
            # that primary output, so do not mislabel one as an object file.
            for argument in arguments:
                if argument == "-E" or argument == "--preprocess" or argument == "-S" or argument == "--assemble":
                    return false
                if argument == "-M" or argument == "-MM" or argument == "--dependencies" or argument == "--user-dependencies":
                    return false
                if argument == "-fsyntax-only" or argument == "--precompile" or argument == "--precompile-reduced-bmi":
                    return false
                if argument == "-emit-cir" or argument == "-emit-ast" or argument == "-emit-interface-stubs" or argument == "-emit-merged-ifs":
                    return false
                if argument == "-analyze" or argument == "--analyze" or argument == "-module-file-info" or argument == "-fdriver-only":
                    return false
            return true


        def database_action_valid(plan: BuildUsageGraphPlan, entry: BuildCompilationSource) -> bool error[BuildCompilationDatabaseError] can[Memory.Allocate, Abort.Panic]:
            raise BuildCompilationDatabaseError.InvalidActionIndex if entry.action_index >= plan.command_owners.count or entry.action_index >= plan.output_sets.count
            command: ProcessCommand = plan.command_owners[entry.action_index].command
            output_set: BuildExecutionNodeOutputs = plan.output_sets[entry.action_index]
            # compile_commands.json has no environment field. Never emit an
            # argv projection that silently omits command-specific variables.
            raise BuildCompilationDatabaseError.UnsupportedEnvironment if command.environment_mode != ProcessEnvironmentMode.Inherit or command.environment.count != 0
            raise BuildCompilationDatabaseError.InvalidDirectory if command.working_directory == "" or sview_len(command.working_directory) > Limits::PATH_BYTES or sview_contains_byte(command.working_directory, 0)
            raise BuildCompilationDatabaseError.InvalidUtf8 if not database_utf8_valid(command.working_directory)
            raise BuildCompilationDatabaseError.InvalidDirectory if not path_is_absolute(path(command.working_directory))
            raise BuildCompilationDatabaseError.InvalidSourceFile if entry.source_file == "" or sview_len(entry.source_file) > Limits::PATH_BYTES or sview_contains_byte(entry.source_file, 0)
            raise BuildCompilationDatabaseError.InvalidUtf8 if not database_utf8_valid(entry.source_file)
            raise BuildCompilationDatabaseError.InvalidSourceFile if not path_is_absolute(path(entry.source_file))
            raise BuildCompilationDatabaseError.InvalidSourceFile if path_name(path(entry.source_file)) == ""
            raise BuildCompilationDatabaseError.InvalidArgument if command.executable == "" or sview_len(command.executable) > Limits::PATH_BYTES or sview_contains_byte(command.executable, 0)
            raise BuildCompilationDatabaseError.InvalidUtf8 if not database_utf8_valid(command.executable)
            for argument in command.arguments:
                raise BuildCompilationDatabaseError.InvalidArgument if sview_len(argument) > EsProcess::PROCESS_COMMAND_MAX_TEXT_BYTES or sview_contains_byte(argument, 0)
                raise BuildCompilationDatabaseError.InvalidUtf8 if not database_utf8_valid(argument)
            # Do not let caller-selected metadata claim that an arbitrary
            # process action compiled this file. The projected action must be
            # a compile-mode invocation containing this source in its argv.
            raise BuildCompilationDatabaseError.InvalidCompileAction if database_argument_count(command.arguments, "-c") != 1
            raise BuildCompilationDatabaseError.InvalidSourceFile if database_argument_count(command.arguments, entry.source_file) != 1 or not database_option_has_unique_operand(command.arguments, "-c", entry.source_file)
            raise BuildCompilationDatabaseError.InvalidCompileAction if not database_supported_compile_mode(command.arguments)
            # These GCC/Clang options create auxiliary files (intermediates,
            # statistics, or coverage notes) not yet bound to outputs. The
            # recognized Clang time-trace and optimization-record sidecars
            # are validated separately below.
            raise BuildCompilationDatabaseError.InvalidOutputPath if database_has_unmodeled_auxiliary_outputs(command.arguments)
            # Even without the optional JSON `output` field, every primary
            # output spelling must have one unambiguous, graph-owned operand.
            raise BuildCompilationDatabaseError.InvalidOutputPath if not database_output_option_shape_valid(command.arguments)
            raise BuildCompilationDatabaseError.InvalidOutputPath if not database_dependency_file_option_shape_valid(command.arguments)
            raise BuildCompilationDatabaseError.InvalidOutputPath if not database_dependency_dot_option_shape_valid(command.arguments)
            raise BuildCompilationDatabaseError.InvalidOutputPath if not database_file_output_option_shape_valid(command.arguments, "-MJ")
            raise BuildCompilationDatabaseError.InvalidOutputPath if not database_serialized_diagnostics_option_shape_valid(command.arguments)
            raise BuildCompilationDatabaseError.InvalidOutputPath if not database_module_output_option_shape_valid(command.arguments)
            raise BuildCompilationDatabaseError.InvalidOutputPath if not database_time_trace_option_shape_valid(command.arguments)
            raise BuildCompilationDatabaseError.InvalidOutputPath if not database_optimization_record_option_shape_valid(command.arguments)
            raise BuildCompilationDatabaseError.InvalidCompileAction if not database_split_dwarf_option_shape_valid(command.arguments)
            if database_split_dwarf_sidecar_required(command.arguments):
                raise BuildCompilationDatabaseError.InvalidOutputPath if not database_split_dwarf_sidecar_path_is_modelable(command.arguments)
                raise BuildCompilationDatabaseError.InvalidCompileAction if database_argument_count(command.arguments, "-emit-llvm") > 0 or database_uses_precompiled_header_language(command.arguments)
            if database_optimization_record_enabled(command.arguments):
                raise BuildCompilationDatabaseError.InvalidCompileAction if not database_optimization_record_path_is_modelable(command.arguments)
                raise BuildCompilationDatabaseError.InvalidCompileAction if database_uses_precompiled_header_language(command.arguments)
            # Without an explicit dependency-file option, GCC/Clang choose a
            # depfile path implicitly from -o or the input name. The graph has
            # no portable way to prove ownership of that compiler-specific
            # side effect.
            raise BuildCompilationDatabaseError.InvalidOutputPath if database_generates_implicit_depfile(command.arguments)
            owned_output_paths: mutable darray[Path] = []
            primary_output_path: mutable Path = path(command.working_directory)
            output_option_count: usize = database_output_option_count(command.arguments)
            if output_option_count == 1:
                output_operand: sview = database_output_option_operand(command.arguments)
                raise BuildCompilationDatabaseError.InvalidOutputPath if not database_output_path_is_declared(output_operand, command.working_directory, output_set)
                primary_output_path <- database_resolved_output_path(output_operand, command.working_directory)
                try database_record_unique_output_path(owned_output_paths, primary_output_path, output_set)
            else:
                # GCC/Clang `-x *-header` commands create a PCH (`.gch` or
                # `.pch`), not the default object. Its implicit extension is
                # compiler-specific, so require an explicit graph-owned `-o`.
                raise BuildCompilationDatabaseError.InvalidCompileAction if database_uses_precompiled_header_language(command.arguments)
                primary_output_path <- database_default_primary_output_path(entry.source_file, command.working_directory, command.arguments)
                try database_record_unique_output_path(owned_output_paths, primary_output_path, output_set)
            time_trace_option_count: usize = database_time_trace_option_count(command.arguments)
            if time_trace_option_count == 1:
                time_trace_operand: sview = database_time_trace_option_operand(command.arguments)
                time_trace_output_path: mutable Path = database_default_time_trace_output_path(primary_output_path)
                if time_trace_operand != "":
                    explicit_trace_path: Path = database_resolved_output_path(time_trace_operand, command.working_directory)
                    explicit_file_is_declared: bool = database_resolved_path_is_declared(explicit_trace_path, output_set)
                    directory_trace_path: Path = database_time_trace_output_path_in_directory(explicit_trace_path, primary_output_path)
                    directory_trace_is_declared: bool = database_resolved_path_is_declared(directory_trace_path, output_set)
                    raise BuildCompilationDatabaseError.InvalidOutputPath if explicit_file_is_declared == directory_trace_is_declared
                    time_trace_output_path <- directory_trace_path if directory_trace_is_declared
                    time_trace_output_path <- explicit_trace_path if explicit_file_is_declared
                try database_record_unique_output_path(owned_output_paths, time_trace_output_path, output_set)
            if database_optimization_record_enabled(command.arguments):
                optimization_record_path: mutable Path = database_optimization_record_output_path(primary_output_path, database_optimization_record_format(command.arguments))
                if database_optimization_record_file_option_count(command.arguments) == 1:
                    optimization_record_operand: sview = database_optimization_record_file_option_operand(command.arguments)
                    raise BuildCompilationDatabaseError.InvalidOutputPath if not database_output_path_is_declared(optimization_record_operand, command.working_directory, output_set)
                    optimization_record_path <- database_resolved_output_path(optimization_record_operand, command.working_directory)
                try database_record_unique_output_path(owned_output_paths, optimization_record_path, output_set)
            if database_split_dwarf_sidecar_required(command.arguments):
                split_dwarf_output_path: Path = database_split_dwarf_output_path(primary_output_path)
                try database_record_unique_output_path(owned_output_paths, split_dwarf_output_path, output_set)
            module_output_option_count: usize = database_module_output_option_count(command.arguments)
            if module_output_option_count == 1:
                module_output_path: mutable Path = primary_output_path
                if database_module_output_option_uses_default(command.arguments):
                    module_output_path <- database_default_module_output_path(entry.source_file, primary_output_path)
                else:
                    module_output_operand: sview = database_module_output_option_operand(command.arguments)
                    raise BuildCompilationDatabaseError.InvalidOutputPath if not database_output_path_is_declared(module_output_operand, command.working_directory, output_set)
                    module_output_path <- database_resolved_output_path(module_output_operand, command.working_directory)
                try database_record_unique_output_path(owned_output_paths, module_output_path, output_set)
            depfile_option_count: usize = database_dependency_file_option_count(command.arguments)
            if depfile_option_count == 1:
                depfile_operand: sview = database_dependency_file_option_operand(command.arguments)
                # GCC and Clang permit `-MF -` to send dependency data to
                # stdout; it creates no sidecar path to bind to this action.
                if depfile_operand != "-":
                    raise BuildCompilationDatabaseError.InvalidOutputPath if not database_output_path_is_declared(depfile_operand, command.working_directory, output_set)
                    depfile_output_path: Path = database_resolved_output_path(depfile_operand, command.working_directory)
                    try database_record_unique_output_path(owned_output_paths, depfile_output_path, output_set)
            dependency_dot_option_count: usize = database_dependency_dot_option_count(command.arguments)
            if dependency_dot_option_count == 1:
                dependency_dot_operand: sview = database_dependency_dot_option_operand(command.arguments)
                raise BuildCompilationDatabaseError.InvalidOutputPath if not database_output_path_is_declared(dependency_dot_operand, command.working_directory, output_set)
                dependency_dot_output_path: Path = database_resolved_output_path(dependency_dot_operand, command.working_directory)
                try database_record_unique_output_path(owned_output_paths, dependency_dot_output_path, output_set)
            database_json_option_count: usize = database_file_output_option_count(command.arguments, "-MJ")
            if database_json_option_count == 1:
                database_json_operand: sview = database_file_output_option_operand(command.arguments, "-MJ")
                raise BuildCompilationDatabaseError.InvalidOutputPath if not database_output_path_is_declared(database_json_operand, command.working_directory, output_set)
                database_json_output_path: Path = database_resolved_output_path(database_json_operand, command.working_directory)
                try database_record_unique_output_path(owned_output_paths, database_json_output_path, output_set)
            serialized_diagnostics_option_count: usize = database_serialized_diagnostics_option_count(command.arguments)
            if serialized_diagnostics_option_count == 1:
                serialized_diagnostics_operand: sview = database_serialized_diagnostics_option_operand(command.arguments)
                raise BuildCompilationDatabaseError.InvalidOutputPath if not database_output_path_is_declared(serialized_diagnostics_operand, command.working_directory, output_set)
                serialized_diagnostics_output_path: Path = database_resolved_output_path(serialized_diagnostics_operand, command.working_directory)
                try database_record_unique_output_path(owned_output_paths, serialized_diagnostics_output_path, output_set)
            if entry.output_file != "":
                output_path: sview = entry.output_file
                raise BuildCompilationDatabaseError.InvalidOutputPath if output_path == "" or sview_len(output_path) > Limits::PATH_BYTES or sview_contains_byte(output_path, 0)
                raise BuildCompilationDatabaseError.InvalidUtf8 if not database_utf8_valid(output_path)
                raise BuildCompilationDatabaseError.InvalidOutputPath if not build_executor_output_path_valid(output_path)
                raise BuildCompilationDatabaseError.InvalidOutputPath if not database_output_path_matches_resolved(output_path, command.working_directory, primary_output_path)
            return true


    public:
        # The caller-selected entries map one translation unit to one graph
        # action. The returned compact JSON has stable field/entry/argv order
        # and ends in LF, matching common compile-database consumers.
        def render_build_compilation_database(plan: mutable BuildUsageGraphPlan&, sources: darray[BuildCompilationSource], max_output_bytes: usize = Limits::OUTPUT_BYTES) -> darray[u8] error[BuildCompilationDatabaseError, BuildUsageGraphError, BuildUsageArgvError, ProcessCommandError, BuildExecutionError, BuildContractError] can[Memory.Allocate, Abort.Panic]:
            raise BuildCompilationDatabaseError.InvalidLimit if max_output_bytes == 0 or max_output_bytes > Limits::OUTPUT_BYTES
            _ = try validate_build_usage_graph_plan(plan)
            raise BuildCompilationDatabaseError.EntryLimitExceeded if sources.count > Limits::ENTRIES or sources.count > plan.graph.nodes.count
            for source_index in 0..<sources.count |plan, sources|:
                source: BuildCompilationSource = sources[source_index]
                raise BuildCompilationDatabaseError.DuplicateAction if source_index > 0 and sources[source_index - 1].action_index == source.action_index
                raise BuildCompilationDatabaseError.ActionOrderInvalid if source_index > 0 and sources[source_index - 1].action_index > source.action_index
                _ = try database_action_valid(plan, source)

            output: mutable darray[u8] = []
            try Json::database_append_byte(output, 91u8, max_output_bytes)
            for source_index in 0..<sources.count |output, plan, sources, max_output_bytes|:
                source: BuildCompilationSource = sources[source_index]
                command: ProcessCommand = plan.command_owners[source.action_index].command
                if source_index != 0:
                    try Json::database_append_byte(output, 44u8, max_output_bytes)
                try Json::database_append_text(output, "{\"directory\":", max_output_bytes)
                try Json::database_append_json_string(output, command.working_directory, max_output_bytes)
                try Json::database_append_text(output, ",\"file\":", max_output_bytes)
                try Json::database_append_json_string(output, source.source_file, max_output_bytes)
                try Json::database_append_text(output, ",\"arguments\":[", max_output_bytes)
                try Json::database_append_json_string(output, command.executable, max_output_bytes)
                for argument_index in 0..<command.arguments.count |output, command, max_output_bytes|:
                    try Json::database_append_byte(output, 44u8, max_output_bytes)
                    try Json::database_append_json_string(output, command.arguments[argument_index], max_output_bytes)
                try Json::database_append_byte(output, 93u8, max_output_bytes)
                if source.output_file != "":
                    try Json::database_append_text(output, ",\"output\":", max_output_bytes)
                    try Json::database_append_json_string(output, source.output_file, max_output_bytes)
                try Json::database_append_byte(output, 125u8, max_output_bytes)
            try Json::database_append_text(output, "]\n", max_output_bytes)
            return output
