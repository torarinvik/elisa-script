# Opt-in declaration for the prepared-spawn host seam, not a default prelude.
# ProcessError is the existing builtin error-row identity. No ordinary names
# are introduced globally. Field order is EsProcessLaunchPayload::Schema.
# Byte arrays preserve raw path spelling; this is not a rendered message.
error ProcessError:
    LaunchFailure(i64, i64, i64, bool, darray[u8], darray[u8], darray[u8], darray[u8], i64, i64, i64, i64)
