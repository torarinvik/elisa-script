# Typed package manifest and lockfile contracts.
#
# Package metadata is deliberately separate from module source resolution. A
# manifest declares intent; a lockfile records the exact bounded graph that a
# hermetic or offline build is allowed to consume. Registry/network adapters
# must verify these values before they hand source bytes to the compiler.

module EsPackage:
    public:
        const PACKAGE_FORMAT_VERSION: u8 = 1
        const PACKAGE_MAX_NAME_BYTES: usize = 256
        const PACKAGE_MAX_VERSION_TEXT_BYTES: usize = 128
        const PACKAGE_MAX_CONSTRAINT_BYTES: usize = 256
        const PACKAGE_MAX_PATH_BYTES: usize = 4096
        const PACKAGE_MAX_DEPENDENCIES: usize = 2048
        const PACKAGE_MAX_NATIVE_DEPENDENCIES: usize = 256
        const PACKAGE_MAX_LOCK_ENTRIES: usize = 4096
        const PACKAGE_MAX_LOCK_DEPENDENCIES: usize = 2048


        const enum PackageDependencyKind of u8:
            Runtime
            Development
            Build
            Native


        const enum PackageSourceKind of u8:
            Workspace
            Path
            Registry
            Git


        const enum PackageResolutionState of u8:
            Declared
            Locked
            Verified
            Failed


        const enum PackageResolutionEvent of u8:
            Lock
            Verify
            Fail
            Reset


        struct PackageVersion:
            major: u64
            minor: u64
            patch: u64
            pre_release: sview = ""


        struct PackageConstraint:
            raw: sview
            has_min: bool = false
            min_version: PackageVersion = PackageVersion{major: 0, minor: 0, patch: 0}
            include_min: bool = true
            has_max: bool = false
            max_version: PackageVersion = PackageVersion{major: 0, minor: 0, patch: 0}
            include_max: bool = true


        struct PackageDependency:
            name: sview
            constraint: PackageConstraint
            kind: PackageDependencyKind = PackageDependencyKind.Runtime
            optional: bool = false


        struct PackageManifest:
            format_version: u8 = PACKAGE_FORMAT_VERSION
            name: sview
            version: PackageVersion
            root_path: sview
            dependencies: darray[PackageDependency] = []
            native_dependencies: darray[sview] = []
            offline_only: bool = false


        struct PackageLockEntry:
            order: usize
            name: sview
            version: PackageVersion
            source: PackageSourceKind = PackageSourceKind.Registry
            locator: sview
            integrity_0: u64
            integrity_1: u64
            integrity_2: u64
            integrity_3: u64
            dependencies: darray[sview] = []


        struct PackageLock:
            format_version: u8 = PACKAGE_FORMAT_VERSION
            root_name: sview
            root_version: PackageVersion
            entries: darray[PackageLockEntry] = []
            state: PackageResolutionState = PackageResolutionState.Declared
            offline_only: bool = false


        error PackageContractError:
            InvalidFormatVersion
            InvalidDependencyKind
            InvalidSourceKind
            InvalidResolutionState
            InvalidResolutionEvent
            NameInvalid
            VersionInvalid
            ConstraintInvalid
            PathInvalid
            LocatorInvalid
            DependencyLimitExceeded
            NativeDependencyLimitExceeded
            LockEntryLimitExceeded
            LockDependencyLimitExceeded
            DuplicateDependency
            DuplicateLockEntry
            LockOrderInvalid
            IntegrityMissing
            MissingLockedDependency
            ConstraintUnsatisfied
            RootMismatch
            OfflinePolicyMismatch
            ResolutionNotReady


    private:
        def package_dependency_kind_valid(kind: PackageDependencyKind) -> bool:
            return kind in {PackageDependencyKind.Runtime, PackageDependencyKind.Development, PackageDependencyKind.Build, PackageDependencyKind.Native}


        def package_source_kind_valid(source: PackageSourceKind) -> bool:
            return source in {PackageSourceKind.Workspace, PackageSourceKind.Path, PackageSourceKind.Registry, PackageSourceKind.Git}


        def package_resolution_state_valid(state: PackageResolutionState) -> bool:
            return state in {PackageResolutionState.Declared, PackageResolutionState.Locked, PackageResolutionState.Verified, PackageResolutionState.Failed}


        def package_resolution_event_valid(event: PackageResolutionEvent) -> bool:
            return event in {PackageResolutionEvent.Lock, PackageResolutionEvent.Verify, PackageResolutionEvent.Fail, PackageResolutionEvent.Reset}


        def package_text_valid(value: sview, limit: usize, allow_empty: bool = false) -> bool:
            return false if not allow_empty and sview_len(value) == 0
            return sview_len(value) < limit and not sview_contains_byte(value, 0)


        def package_name_valid(name: sview) -> bool:
            return package_text_valid(name, PACKAGE_MAX_NAME_BYTES)


        def package_path_valid(path: sview) -> bool:
            return package_text_valid(path, PACKAGE_MAX_PATH_BYTES)


        def package_version_valid(version: PackageVersion) -> bool:
            return package_text_valid(version.pre_release, PACKAGE_MAX_VERSION_TEXT_BYTES, true)


        def package_version_equal(left: PackageVersion, right: PackageVersion) -> bool:
            return left.major == right.major and left.minor == right.minor and left.patch == right.patch and left.pre_release == right.pre_release


        def package_text_before(left: sview, right: sview) -> bool:
            left_length: usize = sview_len(left)
            right_length: usize = sview_len(right)
            common: usize = left_length if left_length < right_length else right_length
            for index in 0..<common |left, right|:
                return sview_at(left, index) < sview_at(right, index) if sview_at(left, index) != sview_at(right, index)
            return left_length < right_length


        def package_version_before(left: PackageVersion, right: PackageVersion) -> bool:
            return left.major < right.major if left.major != right.major else left.minor < right.minor if left.minor != right.minor else left.patch < right.patch if left.patch != right.patch else package_text_before(left.pre_release, right.pre_release)


        def package_constraint_valid(constraint: PackageConstraint) -> bool error[PackageContractError]:
            raise PackageContractError.ConstraintInvalid if not package_text_valid(constraint.raw, PACKAGE_MAX_CONSTRAINT_BYTES)
            raise PackageContractError.VersionInvalid if constraint.has_min and not package_version_valid(constraint.min_version)
            raise PackageContractError.VersionInvalid if constraint.has_max and not package_version_valid(constraint.max_version)
            raise PackageContractError.ConstraintInvalid if constraint.has_min and constraint.has_max and package_version_before(constraint.max_version, constraint.min_version)
            raise PackageContractError.ConstraintInvalid if constraint.has_min and constraint.has_max and package_version_equal(constraint.max_version, constraint.min_version) and (not constraint.include_min or not constraint.include_max)
            return true


        def package_lock_entry_index(lock: PackageLock&, name: sview) -> usize:
            for index in 0..<lock.entries.count |lock, name|:
                return index if lock.entries[index].name == name
            return lock.entries.count


        def package_constraint_satisfied(version: PackageVersion, constraint: PackageConstraint) -> bool:
            return false if constraint.has_min and (package_version_before(version, constraint.min_version) or not constraint.include_min and package_version_equal(version, constraint.min_version))
            return false if constraint.has_max and (package_version_before(constraint.max_version, version) or not constraint.include_max and package_version_equal(version, constraint.max_version))
            return true


    public:
        def package_version_is_valid(version: PackageVersion) -> bool:
            return package_version_valid(version)


        def validate_package_manifest(manifest: PackageManifest&) -> bool error[PackageContractError]:
            raise PackageContractError.InvalidFormatVersion if manifest.format_version != PACKAGE_FORMAT_VERSION
            raise PackageContractError.NameInvalid if not package_name_valid(manifest.name)
            raise PackageContractError.VersionInvalid if not package_version_valid(manifest.version)
            raise PackageContractError.PathInvalid if not package_path_valid(manifest.root_path)
            raise PackageContractError.DependencyLimitExceeded if manifest.dependencies.count > PACKAGE_MAX_DEPENDENCIES
            raise PackageContractError.NativeDependencyLimitExceeded if manifest.native_dependencies.count > PACKAGE_MAX_NATIVE_DEPENDENCIES
            for native_dependency in manifest.native_dependencies:
                raise PackageContractError.NameInvalid if not package_name_valid(native_dependency)
            for dependency in manifest.dependencies:
                raise PackageContractError.NameInvalid if not package_name_valid(dependency.name)
                raise PackageContractError.InvalidDependencyKind if not package_dependency_kind_valid(dependency.kind)
                try package_constraint_valid(dependency.constraint)
            for index in 0..<manifest.dependencies.count |manifest|:
                dependency: PackageDependency = manifest.dependencies[index]
                for earlier in 0..<index |manifest, dependency|:
                    raise PackageContractError.DuplicateDependency if manifest.dependencies[earlier].name == dependency.name
            return true


        def validate_package_lock(lock: PackageLock&) -> bool error[PackageContractError]:
            raise PackageContractError.InvalidFormatVersion if lock.format_version != PACKAGE_FORMAT_VERSION
            raise PackageContractError.NameInvalid if not package_name_valid(lock.root_name)
            raise PackageContractError.VersionInvalid if not package_version_valid(lock.root_version)
            raise PackageContractError.InvalidResolutionState if not package_resolution_state_valid(lock.state)
            raise PackageContractError.LockEntryLimitExceeded if lock.entries.count > PACKAGE_MAX_LOCK_ENTRIES
            for index in 0..<lock.entries.count |lock|:
                entry: PackageLockEntry = lock.entries[index]
                raise PackageContractError.LockOrderInvalid if entry.order != index
                raise PackageContractError.NameInvalid if not package_name_valid(entry.name)
                raise PackageContractError.VersionInvalid if not package_version_valid(entry.version)
                raise PackageContractError.InvalidSourceKind if not package_source_kind_valid(entry.source)
                raise PackageContractError.LocatorInvalid if not package_path_valid(entry.locator)
                raise PackageContractError.IntegrityMissing if entry.integrity_0 == 0 or entry.integrity_1 == 0 or entry.integrity_2 == 0 or entry.integrity_3 == 0
                raise PackageContractError.LockDependencyLimitExceeded if entry.dependencies.count > PACKAGE_MAX_LOCK_DEPENDENCIES
                for dependency_name in entry.dependencies:
                    raise PackageContractError.NameInvalid if not package_name_valid(dependency_name)
            for index in 0..<lock.entries.count |lock|:
                entry: PackageLockEntry = lock.entries[index]
                for earlier in 0..<index |lock, entry|:
                    raise PackageContractError.DuplicateLockEntry if lock.entries[earlier].name == entry.name
            return true


        def validate_package_resolution(manifest: PackageManifest&, lock: PackageLock&) -> bool error[PackageContractError]:
            try validate_package_manifest(manifest)
            try validate_package_lock(lock)
            raise PackageContractError.RootMismatch if manifest.name != lock.root_name or not package_version_equal(manifest.version, lock.root_version)
            raise PackageContractError.OfflinePolicyMismatch if manifest.offline_only != lock.offline_only
            for dependency in manifest.dependencies:
                index: usize = package_lock_entry_index(lock, dependency.name)
                raise PackageContractError.MissingLockedDependency if index == lock.entries.count
                raise PackageContractError.ConstraintUnsatisfied if not package_constraint_satisfied(lock.entries[index].version, dependency.constraint)
            for entry in lock.entries:
                for dependency_name in entry.dependencies:
                    raise PackageContractError.MissingLockedDependency if package_lock_entry_index(lock, dependency_name) == lock.entries.count and dependency_name != lock.root_name
            return true


        def advance_package_resolution(lock: mutable PackageLock&, event: PackageResolutionEvent) -> PackageResolutionState error[PackageContractError]:
            try validate_package_lock(lock)
            raise PackageContractError.InvalidResolutionEvent if not package_resolution_event_valid(event)
            if event == PackageResolutionEvent.Lock:
                raise PackageContractError.InvalidResolutionState if lock.state != PackageResolutionState.Declared
                lock.state <- PackageResolutionState.Locked
            elif event == PackageResolutionEvent.Verify:
                raise PackageContractError.InvalidResolutionState if lock.state != PackageResolutionState.Locked
                lock.state <- PackageResolutionState.Verified
            elif event == PackageResolutionEvent.Fail:
                raise PackageContractError.InvalidResolutionState if lock.state == PackageResolutionState.Failed
                lock.state <- PackageResolutionState.Failed
            elif event == PackageResolutionEvent.Reset:
                raise PackageContractError.ResolutionNotReady if lock.state != PackageResolutionState.Failed
                lock.state <- PackageResolutionState.Declared
            return lock.state
