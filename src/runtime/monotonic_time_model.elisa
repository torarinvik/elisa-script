# Pure validation and conversion for monotonic host-clock samples.
#
# The POSIX adapter supplies Darwin `timespec` values; this module admits only
# normalized, nonnegative samples and computes bounded elapsed microseconds.
# Fractional microseconds round up so deadline accounting never understates
# elapsed time.

module EsMonotonicTime:
    public:
        const module Limits:
            NANOSECONDS_PER_SECOND: u64 = 1000000000u64
            MICROSECONDS_PER_SECOND: u64 = 1000000u64
            NANOSECONDS_PER_MICROSECOND: u64 = 1000u64
            MAX_MICROSECONDS: u64 = 9223372036854775807u64


        struct MonotonicTimestamp:
            seconds: i64
            nanoseconds: i64


        # Selected Darwin64 timespec and scalar profile. Widths are necessary,
        # not a proof of field offsets, alignment, native writes or clock behavior.
        def darwin64_clock_layout_supported(pointer_bytes: usize, integer_bytes: usize, sample_bytes: usize, result_bytes: usize, clock_id_bytes: usize) -> bool:
            return pointer_bytes == 8 and integer_bytes == 8 and sample_bytes == 16 and result_bytes == 4 and clock_id_bytes == 4


        error MonotonicTimeError:
            InvalidTimestamp
            ClockMovedBackwards
            DurationOverflow


    private:
        def monotonic_timestamp_shape_valid(timestamp: MonotonicTimestamp) -> bool:
            return timestamp.seconds >= 0 and timestamp.nanoseconds >= 0 and timestamp.nanoseconds < 1000000000i64


    public:
        def validate_monotonic_timestamp(timestamp: MonotonicTimestamp) -> bool error[MonotonicTimeError]:
            raise MonotonicTimeError.InvalidTimestamp if not monotonic_timestamp_shape_valid(timestamp)
            return true


        def monotonic_elapsed_microseconds(start: MonotonicTimestamp, end: MonotonicTimestamp) -> u64 error[MonotonicTimeError]:
            try validate_monotonic_timestamp(start)
            try validate_monotonic_timestamp(end)
            raise MonotonicTimeError.ClockMovedBackwards if end.seconds < start.seconds or (end.seconds == start.seconds and end.nanoseconds < start.nanoseconds)
            seconds: mutable u64 = (end.seconds - start.seconds).u64()
            nanoseconds: mutable u64 = 0u64
            if end.nanoseconds >= start.nanoseconds:
                nanoseconds <- (end.nanoseconds - start.nanoseconds).u64()
            else:
                seconds <- seconds - 1u64
                nanoseconds <- (1000000000i64 - start.nanoseconds + end.nanoseconds).u64()
            raise MonotonicTimeError.DurationOverflow if seconds > Limits::MAX_MICROSECONDS / Limits::MICROSECONDS_PER_SECOND
            whole_microseconds: u64 = seconds * Limits::MICROSECONDS_PER_SECOND
            fractional_microseconds: u64 = (nanoseconds + Limits::NANOSECONDS_PER_MICROSECOND - 1u64) / Limits::NANOSECONDS_PER_MICROSECOND
            raise MonotonicTimeError.DurationOverflow if fractional_microseconds > Limits::MAX_MICROSECONDS - whole_microseconds
            return whole_microseconds + fractional_microseconds
