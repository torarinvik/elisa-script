# Selected Darwin C-width PID shapes. Numeric admission is not ownership,
# permission to signal, or evidence that a process/group still exists.
include "process_scalar_abi_model.elisa"

module EsProcessPid:
    public:
        def child_shape(pid: i64) -> bool:
            return pid > 1i64 and EsProcessScalarAbi::fits(pid)


        # Only one admitted child or its corresponding negative group number.
        # Reject kill(0), kill(-1), PID 1 and negation overflow/broadcast shapes.
        def signal_shape(selector: i64) -> bool:
            return child_shape(selector) if selector > 0i64
            return false if selector >= -1i64 or selector < -EsProcessScalarAbi::Limits::MAX
            return child_shape(-selector)
