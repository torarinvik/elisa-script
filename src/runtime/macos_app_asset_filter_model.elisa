# Pure ignore policy used while staging project and shader assets for macOS.

module EsMacosAppAssetFilter:
    public:
        const enum MacosAppAssetFilterPolicy of u8:
            ProjectResources
            ShaderResources


        def macos_app_asset_name_is_ignored(name: sview, policy: MacosAppAssetFilterPolicy) -> bool:
            return true if macos_app_asset_name_equals(name, IgnoredNames::GIT)
            return true if macos_app_asset_name_equals(name, IgnoredNames::GITATTRIBUTES)
            return true if macos_app_asset_name_equals(name, IgnoredNames::GITIGNORE)
            return true if macos_app_asset_name_equals(name, IgnoredNames::DS_STORE)
            return true if macos_app_asset_name_equals(name, IgnoredNames::PYTHON_CACHE)
            return true if macos_app_asset_name_equals(name, IgnoredNames::THUMBS)
            return false if policy == MacosAppAssetFilterPolicy.ProjectResources
            return true if macos_app_asset_name_equals(name, ShaderMetadata::GENERATED_INVENTORY)
            return macos_app_asset_name_ends_with(name, ShaderMetadata::SUFFIX)


    private:
        const module IgnoredNames:
            GIT: sview = ".git"
            GITATTRIBUTES: sview = ".gitattributes"
            GITIGNORE: sview = ".gitignore"
            DS_STORE: sview = ".DS_Store"
            PYTHON_CACHE: sview = "__pycache__"
            THUMBS: sview = "Thumbs.db"


        const module ShaderMetadata:
            SUFFIX: sview = ".wishadermeta"
            GENERATED_INVENTORY: sview = "elisa.metal-generated.json"


        def macos_app_asset_name_equals(value: sview, expected: sview) -> bool:
            return false if sview_len(value) != sview_len(expected)
            for offset in 0..<sview_len(value) |value, expected|:
                return false if sview_at(value, offset) != sview_at(expected, offset)
            return true


        def macos_app_asset_name_ends_with(value: sview, suffix: sview) -> bool:
            value_length: usize = sview_len(value)
            suffix_length: usize = sview_len(suffix)
            return false if suffix_length > value_length
            start: usize = value_length - suffix_length
            for offset in 0..<suffix_length |value, suffix, start|:
                return false if sview_at(value, start + offset) != sview_at(suffix, offset)
            return true
