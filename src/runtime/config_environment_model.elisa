# Explicit child/environment snapshot adapter for configuration precedence.
#
# No process-global environment is observed or mutated here. The returned
# Environment layer borrows names and values from the sealed snapshot, which
# must stay alive and unchanged while the layer or resolved values are used.

module EsConfigEnvironment:
    using EsEnvironment
    using EsConfig

    public:
        error ConfigEnvironmentError:
            SnapshotNotSealed


        def environment_config_layer(snapshot: EnvironmentSnapshot&) -> ConfigLayer error[EnvironmentContractError, ConfigError, ConfigEnvironmentError] can[Memory.Allocate, Abort.Panic]:
            try validate_environment_snapshot(snapshot)
            raise ConfigEnvironmentError.SnapshotNotSealed if snapshot.state != EnvironmentState.Sealed
            present_count: mutable usize = 0
            for entry in snapshot.entries |snapshot, present_count|:
                present_count <- present_count + 1 if entry.present
            raise ConfigError.EntryLimitExceeded if present_count > EsConfig::Limits::ENTRIES_PER_LAYER
            layer: mutable ConfigLayer = ConfigLayer{source: ConfigSource.Environment}
            layer.entries.reserve(present_count)
            for entry in snapshot.entries |snapshot, layer|:
                if entry.present:
                    layer.entries.push(ConfigEntry{key: entry.name, value: entry.value})
            try validate_config_layers([layer])
            return layer
