# Small POSIX file-mutation bridge kept separate from the shared stdio helpers.
#
# The C ABI declarations are deliberately private to EsRuntime.  The public
# wrappers below are the only names imported by the IR/interpreter modules;
# `@link_name` still preserves the stable libc symbol at the native boundary.

error PosixFileAtError:
    InvalidDescriptor
    InvalidLeafName

extend EsRuntime:
    private:
        @link_name(rename)
        extern elisascript_posix_rename_impl(source: u8&, destination: u8&) -> int can[Blocking.IO]

        @link_name(renameat)
        extern elisascript_posix_renameat_impl(source_directory_fd: int, source_name: cstr, destination_directory_fd: int, destination_name: cstr) -> int can[Blocking.IO]

        @link_name(unlinkat)
        extern elisascript_posix_unlinkat_leaf_impl(directory_fd: int, leaf_name: cstr, flags: int) -> int can[Blocking.IO]

        @link_name(utimes)
        extern elisascript_posix_utimes_impl(path: cstr, times: void&?) -> int can[Blocking.IO]

        @link_name(chmod)
        extern elisascript_posix_chmod_impl(path: cstr, mode: u32) -> int can[Blocking.IO]

        @link_name(access)
        extern elisascript_posix_access_impl(path: cstr, mode: int) -> int can[Blocking.IO]

        @link_name(readlink)
        extern elisascript_posix_readlink_impl(path: cstr, buffer: mutable u8&, size: usize) -> isize can[Blocking.IO]

        @link_name(realpath)
        extern elisascript_posix_realpath_impl(path: cstr, resolved_path: mutable u8&?) -> mutable heap u8&? can[Blocking.IO, Memory.Allocate]

        @link_name(mkstemp)
        extern elisascript_posix_mkstemp_impl(template: mutable u8&) -> int can[Blocking.IO]

        @link_name(mkdtemp)
        extern elisascript_posix_mkdtemp_impl(template: mutable u8&) -> mutable u8&? can[Blocking.IO]

        @link_name(open)
        extern elisascript_posix_open_impl(path: cstr, flags: int, mode: u32) -> int can[Blocking.IO]

        @link_name(close)
        extern elisascript_posix_close_impl(fd: int) -> int can[Blocking.IO]

        @link_name(openat)
        extern elisascript_posix_openat_impl(directory_fd: int, path: cstr, flags: int, mode: u32) -> int can[Blocking.IO]

        @link_name(readlinkat)
        extern elisascript_posix_readlinkat_impl(directory_fd: int, path: cstr, buffer: mutable u8&, size: usize) -> isize can[Blocking.IO]

        @link_name(write)
        extern elisascript_posix_write_impl(fd: int, buffer: void&, count: usize) -> isize can[Blocking.IO]

        @link_name(fchmod)
        extern elisascript_posix_fchmod_impl(fd: int, mode: u32) -> int can[Blocking.IO]

        @link_name(fsync)
        extern elisascript_posix_fsync_impl(fd: int) -> int can[Blocking.IO]

        @link_name(flock)
        extern elisascript_posix_flock_impl(fd: int, operation: int) -> int can[Blocking.IO]

        @link_name(symlink)
        extern elisascript_posix_symlink_impl(target: cstr, link: cstr) -> int can[Blocking.IO]

        def posix_renameat_leaf_valid(name: cstr) -> bool:
            bytes: u8& = name.cast[u8&]
            for index in 0..<4096 |bytes|:
                byte: u8 = bytes[index]
                return false if byte == 47u8
                if byte == 0u8:
                    return false if index == 0
                    return false if index == 1 and bytes[0] == 46u8
                    return false if index == 2 and bytes[0] == 46u8 and bytes[1] == 46u8
                    return true
            return false

    public:
        # Darwin POSIX open flags used by the descriptor-relative world host
        # adapter. Keep names platform-qualified: other POSIX targets provide
        # their own flag values in their runtime bridge.
        const module DarwinOpenFlags:
            RDONLY: int = 0
            WRONLY: int = 1
            NONBLOCK: int = 4
            NOFOLLOW: int = 256
            CREATE: int = 512
            EXCLUSIVE: int = 2048
            DIRECTORY: int = 1048576
            CLOSE_ON_EXEC: int = 16777216


        const module PosixLockOperations:
            SHARED: int = 1
            EXCLUSIVE: int = 2
            NONBLOCK: int = 4

        def elisascript_posix_rename(source: u8&, destination: u8&) -> int can[Blocking.IO]:
            return elisascript_posix_rename_impl(source, destination)

        def elisascript_posix_leaf_name_valid(name: cstr) -> bool:
            return posix_renameat_leaf_valid(name)

        # Publish between exactly one source and destination component
        # relative to already-open directory capabilities. This rejects path
        # traversal here rather than relying on every caller to do so.
        def elisascript_posix_renameat(source_directory_fd: int, source_name: cstr, destination_directory_fd: int, destination_name: cstr) -> int error[PosixFileAtError] can[Blocking.IO]:
            raise PosixFileAtError.InvalidDescriptor if source_directory_fd < 0 or destination_directory_fd < 0
            raise PosixFileAtError.InvalidLeafName if not elisascript_posix_leaf_name_valid(source_name) or not elisascript_posix_leaf_name_valid(destination_name)
            return elisascript_posix_renameat_impl(source_directory_fd, source_name, destination_directory_fd, destination_name)

        # Remove one file-or-link leaf relative to an already-open directory.
        # Flags are fixed to zero: this operation never requests directory
        # removal, and callers remain responsible for proving entry identity
        # and serializing mutations when cleanup correctness depends on it.
        def elisascript_posix_unlinkat_leaf(directory_fd: int, leaf_name: cstr) -> int error[PosixFileAtError] can[Blocking.IO]:
            raise PosixFileAtError.InvalidDescriptor if directory_fd < 0
            raise PosixFileAtError.InvalidLeafName if not elisascript_posix_leaf_name_valid(leaf_name)
            return elisascript_posix_unlinkat_leaf_impl(directory_fd, leaf_name, 0)

        # Create a caller-named staging sibling relative to an already-open
        # directory capability. Exclusivity and the fixed private mode are
        # enforced here; callers still own retry/name-generation policy and
        # must retain and inspect the returned descriptor before publication.
        def elisascript_posix_openat_private_file(directory_fd: int, leaf_name: cstr) -> int error[PosixFileAtError] can[Blocking.IO]:
            raise PosixFileAtError.InvalidLeafName if not elisascript_posix_leaf_name_valid(leaf_name)
            flags: int = DarwinOpenFlags::WRONLY | DarwinOpenFlags::CREATE | DarwinOpenFlags::EXCLUSIVE | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
            return elisascript_posix_openat_impl(directory_fd, leaf_name, flags, 384u32)

        def elisascript_posix_utimes(path: cstr, times: void&?) -> int can[Blocking.IO]:
            return elisascript_posix_utimes_impl(path, times)

        def elisascript_posix_chmod(path: cstr, mode: u32) -> int can[Blocking.IO]:
            return elisascript_posix_chmod_impl(path, mode)

        def elisascript_posix_access(path: cstr, mode: int) -> int can[Blocking.IO]:
            return elisascript_posix_access_impl(path, mode)

        def elisascript_posix_readlink(path: cstr, buffer: mutable u8&, size: usize) -> isize can[Blocking.IO]:
            return elisascript_posix_readlink_impl(path, buffer, size)

        def elisascript_posix_realpath(path: cstr, resolved_path: mutable u8&?) -> mutable heap u8&? can[Blocking.IO, Memory.Allocate]:
            return elisascript_posix_realpath_impl(path, resolved_path)

        def elisascript_posix_mkstemp(template: mutable u8&) -> int can[Blocking.IO]:
            return elisascript_posix_mkstemp_impl(template)

        def elisascript_posix_mkdtemp(template: mutable u8&) -> mutable u8&? can[Blocking.IO]:
            return elisascript_posix_mkdtemp_impl(template)

        # `open` is variadic in libc; callers pass `mode` only when O_CREAT is
        # set. This only prevents following the final component when O_NOFOLLOW
        # is supplied and does not secure parent components.
        def elisascript_posix_open(path: cstr, flags: int, mode: u32) -> int can[Blocking.IO]:
            return elisascript_posix_open_impl(path, flags, mode)

        def elisascript_posix_close(fd: int) -> int can[Blocking.IO]:
            return elisascript_posix_close_impl(fd)

        # `O_NOFOLLOW` protects the final component only. Secure tree walkers
        # must resolve one validated component per descriptor-relative call.
        def elisascript_posix_openat(directory_fd: int, path: cstr, flags: int, mode: u32) -> int can[Blocking.IO]:
            return elisascript_posix_openat_impl(directory_fd, path, flags, mode)

        def elisascript_posix_readlinkat(directory_fd: int, path: cstr, buffer: mutable u8&, size: usize) -> isize can[Blocking.IO]:
            return elisascript_posix_readlinkat_impl(directory_fd, path, buffer, size)

        def elisascript_posix_write(fd: int, buffer: void&, count: usize) -> isize can[Blocking.IO]:
            return elisascript_posix_write_impl(fd, buffer, count)

        def elisascript_posix_fchmod(fd: int, mode: u32) -> int can[Blocking.IO]:
            return elisascript_posix_fchmod_impl(fd, mode)

        def elisascript_posix_fsync(fd: int) -> int can[Blocking.IO]:
            return elisascript_posix_fsync_impl(fd)

        def elisascript_posix_flock(fd: int, operation: int) -> int can[Blocking.IO]:
            return elisascript_posix_flock_impl(fd, operation)

        def elisascript_posix_symlink(target: cstr, link: cstr) -> int can[Blocking.IO]:
            return elisascript_posix_symlink_impl(target, link)
