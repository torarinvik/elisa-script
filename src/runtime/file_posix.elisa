# Small POSIX file-mutation bridge kept separate from the shared stdio helpers.
#
# The C ABI declarations are deliberately private to EsRuntime.  The public
# wrappers below are the only names imported by the IR/interpreter modules;
# `@link_name` still preserves the stable libc symbol at the native boundary.

extend EsRuntime:
    private:
        @link_name(rename)
        extern elisascript_posix_rename_impl(source: u8&, destination: u8&) -> int can[Blocking.IO]

        @link_name(utimes)
        extern elisascript_posix_utimes_impl(path: cstr, times: void&?) -> int can[Blocking.IO]

        @link_name(chmod)
        extern elisascript_posix_chmod_impl(path: cstr, mode: u32) -> int can[Blocking.IO]

        @link_name(access)
        extern elisascript_posix_access_impl(path: cstr, mode: int) -> int can[Blocking.IO]

        @link_name(readlink)
        extern elisascript_posix_readlink_impl(path: cstr, buffer: mutable u8&, size: usize) -> isize can[Blocking.IO]

        @link_name(realpath)
        extern elisascript_posix_realpath_impl(path: cstr, resolved_path: mutable u8&?) -> mutable heap u8&? can[Blocking.IO, Memory.Allocate]

        @link_name(mkstemp)
        extern elisascript_posix_mkstemp_impl(template: mutable u8&) -> int can[Blocking.IO]

        @link_name(mkdtemp)
        extern elisascript_posix_mkdtemp_impl(template: mutable u8&) -> mutable u8&? can[Blocking.IO]

        @link_name(close)
        extern elisascript_posix_close_impl(fd: int) -> int can[Blocking.IO]

        @link_name(fsync)
        extern elisascript_posix_fsync_impl(fd: int) -> int can[Blocking.IO]

        @link_name(symlink)
        extern elisascript_posix_symlink_impl(target: cstr, link: cstr) -> int can[Blocking.IO]

    public:
        def elisascript_posix_rename(source: u8&, destination: u8&) -> int can[Blocking.IO]:
            return elisascript_posix_rename_impl(source, destination)

        def elisascript_posix_utimes(path: cstr, times: void&?) -> int can[Blocking.IO]:
            return elisascript_posix_utimes_impl(path, times)

        def elisascript_posix_chmod(path: cstr, mode: u32) -> int can[Blocking.IO]:
            return elisascript_posix_chmod_impl(path, mode)

        def elisascript_posix_access(path: cstr, mode: int) -> int can[Blocking.IO]:
            return elisascript_posix_access_impl(path, mode)

        def elisascript_posix_readlink(path: cstr, buffer: mutable u8&, size: usize) -> isize can[Blocking.IO]:
            return elisascript_posix_readlink_impl(path, buffer, size)

        def elisascript_posix_realpath(path: cstr, resolved_path: mutable u8&?) -> mutable heap u8&? can[Blocking.IO, Memory.Allocate]:
            return elisascript_posix_realpath_impl(path, resolved_path)

        def elisascript_posix_mkstemp(template: mutable u8&) -> int can[Blocking.IO]:
            return elisascript_posix_mkstemp_impl(template)

        def elisascript_posix_mkdtemp(template: mutable u8&) -> mutable u8&? can[Blocking.IO]:
            return elisascript_posix_mkdtemp_impl(template)

        def elisascript_posix_close(fd: int) -> int can[Blocking.IO]:
            return elisascript_posix_close_impl(fd)

        def elisascript_posix_fsync(fd: int) -> int can[Blocking.IO]:
            return elisascript_posix_fsync_impl(fd)

        def elisascript_posix_symlink(target: cstr, link: cstr) -> int can[Blocking.IO]:
            return elisascript_posix_symlink_impl(target, link)
