# Small POSIX file-mutation bridge kept separate from the shared stdio helpers.

@link_name(rename)
extern elisascript_posix_rename(source: u8&, destination: u8&) -> int can[Blocking.IO]

@link_name(utimes)
extern elisascript_posix_utimes(path: cstr, times: void&?) -> int can[Blocking.IO]

@link_name(chmod)
extern elisascript_posix_chmod(path: cstr, mode: u32) -> int can[Blocking.IO]

@link_name(readlink)
extern elisascript_posix_readlink(path: cstr, buffer: mutable u8&, size: usize) -> isize can[Blocking.IO]
