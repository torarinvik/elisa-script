# Small POSIX file-mutation bridge kept separate from the shared stdio helpers.

@link_name(rename)
extern elisascript_posix_rename(source: u8&, destination: u8&) -> int can[Blocking.IO]

@link_name(utimes)
extern elisascript_posix_utimes(path: cstr, times: void&?) -> int can[Blocking.IO]

@link_name(chmod)
extern elisascript_posix_chmod(path: cstr, mode: u32) -> int can[Blocking.IO]

@link_name(access)
extern elisascript_posix_access(path: cstr, mode: int) -> int can[Blocking.IO]

@link_name(readlink)
extern elisascript_posix_readlink(path: cstr, buffer: mutable u8&, size: usize) -> isize can[Blocking.IO]

@link_name(realpath)
extern elisascript_posix_realpath(path: cstr, resolved_path: mutable u8&?) -> mutable heap u8&? can[Blocking.IO, Memory.Allocate]

@link_name(mkstemp)
extern elisascript_posix_mkstemp(template: mutable u8&) -> int can[Blocking.IO]

@link_name(mkdtemp)
extern elisascript_posix_mkdtemp(template: mutable u8&) -> mutable u8&? can[Blocking.IO]

@link_name(close)
extern elisascript_posix_close(fd: int) -> int can[Blocking.IO]

@link_name(symlink)
extern elisascript_posix_symlink(target: cstr, link: cstr) -> int can[Blocking.IO]
