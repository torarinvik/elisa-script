# The pure text boundary used by Skia's VarsApi.getenv after capturing stdout.
include "python_text_model.elisa"

module EsSkiaEnvironmentCaller:
    public:
        def captured_stdout_value(stdout: sview) -> sview error[EsPythonText::PythonTextError]:
            decoded: sview = try EsPythonText::decode_utf8(stdout)
            return EsPythonText::trim_unicode_whitespace(decoded, 2)
