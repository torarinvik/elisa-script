# Assemble validated target-usage commands into an executor-ready build graph.
#
# This remains a planning layer. Creating a graph never launches a tool; the
# separate execution function exposes Process.Run and verifies declared file
# outputs through the serial build executor.

module EsBuildUsageGraph:
    using EsBuild
    using EsBuildExecutor
    using EsBuildUsageArgv
    using EsProcess

    public:
        const module Limits:
            ACTIONS: usize = EsBuild::Limits::NODES
            OUTPUTS: usize = EsBuildExecutor::Limits::OUTPUT_PATHS
            METADATA_BYTES: usize = EsProcess::PROCESS_COMMAND_MAX_TEXT_BYTES


        struct BuildUsageActionSpec:
            name: sview
            command: BuildUsageProcessCommand
            dependencies: darray[usize] = []
            fingerprint: u64
            outputs: darray[sview] = []


        struct BuildUsageGraphPlan:
            graph: BuildGraph = BuildGraph{}
            output_sets: darray[BuildExecutionNodeOutputs] = []
            command_owners: darray[BuildUsageProcessCommand] = []
            owned_node_names: darray[darray[u8]] = []
            owned_output_paths: darray[darray[u8]] = []
            metadata_bytes: mutable usize = 0


        error BuildUsageGraphError:
            EmptyActions
            ActionLimitExceeded
            OutputLimitExceeded
            MetadataLimitExceeded
            InvalidActionName
            InvalidOutputPath
            InvalidPreparedCommand
            UnsupportedCommand
            PlanOwnershipInvalid
            GraphNotPlanned


    private:
        def build_usage_graph_copy_text(value: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            copied: mutable darray[u8] = []
            for byte in value |copied|:
                copied.push(byte)
            return copied


        def build_usage_graph_process_commands_equal(left: ProcessCommand, right: ProcessCommand) -> bool:
            return false if left.executable != right.executable or left.arguments != right.arguments or left.working_directory != right.working_directory
            return false if left.environment != right.environment or left.environment_mode != right.environment_mode
            return false if left.stdin_mode != right.stdin_mode or left.stdout_mode != right.stdout_mode or left.stderr_mode != right.stderr_mode
            return false if left.stdin_path != right.stdin_path or left.stdout_path != right.stdout_path or left.stderr_path != right.stderr_path
            return false if left.timeout_micros != right.timeout_micros or left.capture_output_limit_bytes != right.capture_output_limit_bytes or left.failure_mode != right.failure_mode
            return true


    public:
        # Every action's dependencies use the same canonical earlier-index
        # form as BuildGraph. Command buffers, names, and declared output paths
        # are retained by the returned plan for the graph's entire lifetime.
        def build_usage_graph_plan(actions: darray[BuildUsageActionSpec]) -> BuildUsageGraphPlan error[BuildUsageGraphError, BuildUsageArgvError, ProcessCommandError, BuildExecutionError, BuildContractError] can[Memory.Allocate, Abort.Panic]:
            raise BuildUsageGraphError.EmptyActions if actions.count == 0
            raise BuildUsageGraphError.ActionLimitExceeded if actions.count > Limits::ACTIONS
            plan: mutable BuildUsageGraphPlan = BuildUsageGraphPlan{}
            total_outputs: mutable usize = 0
            for action in actions |plan, total_outputs|:
                raise BuildUsageGraphError.InvalidActionName if action.name == "" or sview_len(action.name) >= EsBuild::Limits::NAME_BYTES or sview_contains_byte(action.name, 0)
                command_valid: bool = try validate_build_usage_process_command(action.command)
                raise BuildUsageGraphError.InvalidPreparedCommand if not command_valid
                raise BuildUsageGraphError.UnsupportedCommand if not build_executor_command_supported(action.command.command)

                name_length: usize = sview_len(action.name)
                raise BuildUsageGraphError.MetadataLimitExceeded if name_length > Limits::METADATA_BYTES - plan.metadata_bytes
                owned_name: darray[u8] = build_usage_graph_copy_text(action.name)
                plan.metadata_bytes <- plan.metadata_bytes + name_length
                plan.owned_node_names.push(owned_name)
                retained_name: sview = bytes_view(plan.owned_node_names[plan.owned_node_names.count - 1])

                node: BuildNode = BuildNode{
                    name: retained_name,
                    command: action.command.command,
                    dependencies: action.dependencies,
                    fingerprint: action.fingerprint
                }
                plan.graph.nodes.push(node)
                plan.command_owners.push(action.command)

                raise BuildUsageGraphError.OutputLimitExceeded if action.outputs.count > Limits::OUTPUTS - total_outputs
                total_outputs <- total_outputs + action.outputs.count
                paths: mutable darray[sview] = []
                for output_path in action.outputs |plan, paths|:
                    raise BuildUsageGraphError.InvalidOutputPath if output_path == "" or sview_len(output_path) > EsBuildExecutor::Limits::OUTPUT_PATH_BYTES or sview_contains_byte(output_path, 0) or not path_is_absolute(path(output_path))
                    output_length: usize = sview_len(output_path)
                    raise BuildUsageGraphError.MetadataLimitExceeded if output_length > Limits::METADATA_BYTES - plan.metadata_bytes
                    owned_path: darray[u8] = build_usage_graph_copy_text(output_path)
                    plan.metadata_bytes <- plan.metadata_bytes + output_length
                    plan.owned_output_paths.push(owned_path)
                    paths.push(bytes_view(plan.owned_output_paths[plan.owned_output_paths.count - 1]))
                plan.output_sets.push(BuildExecutionNodeOutputs{target_name: retained_name, paths: paths})

            _ = try validate_build_graph(plan.graph)
            _ = try validate_build_execution_output_sets(plan.graph, plan.output_sets)
            return plan


        # Public revalidation protects executor admission if a caller has
        # reconstructed or changed any public plan fields after creation.
        def validate_build_usage_graph_plan(plan: mutable BuildUsageGraphPlan&) -> bool error[BuildUsageGraphError, BuildUsageArgvError, ProcessCommandError, BuildExecutionError, BuildContractError] can[Memory.Allocate, Abort.Panic]:
            raise BuildUsageGraphError.GraphNotPlanned if plan.graph.state != BuildGraphState.Planned
            raise BuildUsageGraphError.PlanOwnershipInvalid if plan.graph.nodes.count == 0 or plan.graph.nodes.count != plan.command_owners.count or plan.graph.nodes.count != plan.output_sets.count or plan.graph.nodes.count != plan.owned_node_names.count
            raise BuildUsageGraphError.PlanOwnershipInvalid if plan.metadata_bytes > Limits::METADATA_BYTES
            owned_output_index: mutable usize = 0
            measured_metadata_bytes: mutable usize = 0
            for index in 0..<plan.graph.nodes.count |plan, owned_output_index, measured_metadata_bytes|:
                node: BuildNode = plan.graph.nodes[index]
                raise BuildUsageGraphError.PlanOwnershipInvalid if node.state != BuildNodeState.Planned or node.name != bytes_view(plan.owned_node_names[index]) or plan.output_sets[index].target_name != node.name
                raise BuildUsageGraphError.PlanOwnershipInvalid if sview_len(node.name) > Limits::METADATA_BYTES - measured_metadata_bytes
                measured_metadata_bytes <- measured_metadata_bytes + sview_len(node.name)
                command_valid: bool = try validate_build_usage_process_command(plan.command_owners[index])
                raise BuildUsageGraphError.InvalidPreparedCommand if not command_valid
                raise BuildUsageGraphError.UnsupportedCommand if not build_executor_command_supported(plan.command_owners[index].command)
                raise BuildUsageGraphError.PlanOwnershipInvalid if not build_usage_graph_process_commands_equal(node.command, plan.command_owners[index].command)
                raise BuildUsageGraphError.PlanOwnershipInvalid if plan.output_sets[index].paths.count > plan.owned_output_paths.count - owned_output_index
                for output_path in plan.output_sets[index].paths |plan, index, owned_output_index|:
                    raise BuildUsageGraphError.PlanOwnershipInvalid if owned_output_index >= plan.owned_output_paths.count or output_path != bytes_view(plan.owned_output_paths[owned_output_index])
                    raise BuildUsageGraphError.PlanOwnershipInvalid if sview_len(output_path) > Limits::METADATA_BYTES - measured_metadata_bytes
                    measured_metadata_bytes <- measured_metadata_bytes + sview_len(output_path)
                    owned_output_index <- owned_output_index + 1
            raise BuildUsageGraphError.PlanOwnershipInvalid if owned_output_index != plan.owned_output_paths.count
            raise BuildUsageGraphError.PlanOwnershipInvalid if measured_metadata_bytes != plan.metadata_bytes
            _ = try validate_build_graph(plan.graph)
            _ = try validate_build_execution_output_sets(plan.graph, plan.output_sets)
            return true


        # Explicit Process.Run boundary. The graph and output contract are
        # revalidated immediately before handing them to the serial executor.
        def execute_build_usage_graph(plan: mutable BuildUsageGraphPlan&) -> BuildExecutionResult error[BuildUsageGraphError, BuildUsageArgvError, ProcessCommandError, BuildExecutionError, BuildContractError] can[Memory.Allocate, Abort.Panic, File.Read, Process.Run]:
            _ = try validate_build_usage_graph_plan(plan)
            return try execute_build_graph_serial_with_outputs(plan.graph, plan.output_sets)
