# Typed streaming file handles for large-file workflows.
#
# The existing read_entire_file/write_entire_file helpers remain convenient for
# small bounded payloads.  This module gives scripts a scoped, stateful handle
# for chunk and line iteration without exposing an untyped FILE* API at the
# language boundary.  The path is a borrowed cstr owned by the caller for the
# lifetime of the handle; no implicit path conversion or NUL truncation occurs.

error FileStreamError:
    OpenFailed(path: cstr)
    ReadFailed(path: cstr)
    WriteFailed(path: cstr)
    FlushFailed(path: cstr)
    InvalidEncoding(path: cstr)
    InvalidUtf8(path: cstr)
    SyncFailed(path: cstr)
    CloseFailed(path: cstr)
    SeekFailed(path: cstr)
    CleanupStateInvalid(path: cstr)
    Closed(path: cstr)
    WrongMode(path: cstr)
    LimitExceeded(path: cstr)
    PathTooLong(path: cstr)
    LineTooLong(path: cstr)
    InvalidLineMode(path: cstr)


extend EsRuntime:
    public:
        # A stream is bounded independently of the process-capture helpers.  A
        # caller may choose a smaller limit, but cannot silently turn this
        # adapter into an unbounded host allocation/IO commitment.
        const FILE_STREAM_DEFAULT_MAX_BYTES: usize = ES_RUNTIME_DEFAULT_MAX_MEMORY_BYTES


        const enum FileStreamMode of u8:
            ReadText
            ReadBinary
            WriteText
            WriteBinary
            AppendText
            AppendBinary


        const enum FileStreamState of u8:
            Open
            Closed


        const enum FileStreamLineMode of u8:
            Lf
            Universal
            Retain


        const enum FileStreamEncoding of u8:
            Auto
            Bytes
            Utf8


        const enum FileStreamSeekOrigin of u8:
            Begin
            Current
            End


        struct FileStreamRead:
            count: usize
            eof: bool


        struct FileStreamWrite:
            count: usize


        # Public state inspection keeps the short-write contract testable
        # without exposing the opaque FILE* handle or the host adapter.
        const enum FileStreamWriteState of u8:
            Progress
            Done
            Limit
            Error


        def file_stream_write_transition(offset: usize, capacity: usize, amount: usize, remaining_budget: usize) -> FileStreamWriteState:
            return FileStreamWriteState.Error if offset > capacity
            return FileStreamWriteState.Done if offset == capacity
            return FileStreamWriteState.Error if amount == 0 or amount > capacity - offset
            return FileStreamWriteState.Limit if amount > remaining_budget
            return FileStreamWriteState.Done if amount == capacity - offset
            return FileStreamWriteState.Progress


        struct FileStream:
            # `handle` is an opaque POSIX value owned by this module.  Callers
            # must obtain it from `file_stream_open` and release it through
            # `file_stream_close`; the state field makes use-after-close
            # fail as a typed error.
            handle: mutable heap void&?
            path: cstr
            mode: FileStreamMode
            encoding: FileStreamEncoding = FileStreamEncoding.Bytes
            state: FileStreamState
            byte_budget: usize
            bytes_read: usize = 0
            bytes_written: usize = 0
            pending_byte: u8 = 0
            pending_valid: bool = false
            utf8_remaining: u8 = 0
            utf8_lower: u8 = 128
            utf8_upper: u8 = 191


        const enum FileStreamCleanupState of u8:
            Armed
            Closed
            Aborted


        const enum FileStreamCleanupEvent of u8:
            Commit
            Abort


        struct FileStreamCleanupGuard:
            state: FileStreamCleanupState = FileStreamCleanupState.Armed


        def file_stream_cleanup_begin() -> FileStreamCleanupGuard:
            return FileStreamCleanupGuard{}


        def file_stream_cleanup_transition(state: FileStreamCleanupState, event: FileStreamCleanupEvent) -> FileStreamCleanupState:
            return FileStreamCleanupState.Closed if state == FileStreamCleanupState.Armed and event == FileStreamCleanupEvent.Commit
            return FileStreamCleanupState.Aborted if state == FileStreamCleanupState.Armed and event == FileStreamCleanupEvent.Abort
            return state


        def file_stream_cleanup_commit(guard: mutable FileStreamCleanupGuard&, stream: mutable FileStream&) -> bool error[FileStreamError] can[Blocking.IO, Memory.Release]:
            raise FileStreamError.CleanupStateInvalid(stream.path) if guard.state != FileStreamCleanupState.Armed
            catch file_stream_close(stream):
                ok:
                    guard.state <- file_stream_cleanup_transition(guard.state, FileStreamCleanupEvent.Commit)
                    return true
                error failure:
                    guard.state <- file_stream_cleanup_transition(guard.state, FileStreamCleanupEvent.Abort)
                    raise failure


        def file_stream_cleanup_abort(guard: mutable FileStreamCleanupGuard&, stream: mutable FileStream&) -> bool error[FileStreamError] can[Blocking.IO, Memory.Release]:
            raise FileStreamError.CleanupStateInvalid(stream.path) if guard.state != FileStreamCleanupState.Armed
            catch file_stream_close(stream):
                ok:
                    guard.state <- file_stream_cleanup_transition(guard.state, FileStreamCleanupEvent.Abort)
                    return true
                error failure:
                    guard.state <- file_stream_cleanup_transition(guard.state, FileStreamCleanupEvent.Abort)
                    raise failure


    private:
        const FILE_STREAM_MAX_PATH_BYTES: usize = 4096


        const enum FileStreamRecordState of u8:
            Progress
            Done
            End
            Limit
            LineTooLong
            EncodingError
            Error


        const enum FileStreamByteState of u8:
            Byte
            End
            Limit
            EncodingError
            Error


        def file_stream_mode_is_text(mode: FileStreamMode) -> bool:
            return mode == FileStreamMode.ReadText or mode == FileStreamMode.WriteText or mode == FileStreamMode.AppendText


        def file_stream_encoding_valid(mode: FileStreamMode, encoding: FileStreamEncoding) -> bool:
            return encoding == FileStreamEncoding.Auto or encoding == FileStreamEncoding.Bytes or (encoding == FileStreamEncoding.Utf8 and file_stream_mode_is_text(mode))


        def file_stream_utf8_feed(byte: u8, remaining: mutable u8&, lower: mutable u8&, upper: mutable u8&) -> bool:
            if remaining == 0:
                return true if byte <= 127
                if byte >= 194 and byte <= 223:
                    remaining <- 1
                    lower <- 128
                    upper <- 191
                    return true
                if byte == 224:
                    remaining <- 2
                    lower <- 160
                    upper <- 191
                    return true
                if byte >= 225 and byte <= 236 or byte >= 238 and byte <= 239:
                    remaining <- 2
                    lower <- 128
                    upper <- 191
                    return true
                if byte == 237:
                    remaining <- 2
                    lower <- 128
                    upper <- 159
                    return true
                if byte == 240:
                    remaining <- 3
                    lower <- 144
                    upper <- 191
                    return true
                if byte >= 241 and byte <= 243:
                    remaining <- 3
                    lower <- 128
                    upper <- 191
                    return true
                if byte == 244:
                    remaining <- 3
                    lower <- 128
                    upper <- 143
                    return true
                return false
            return false if byte < lower or byte > upper
            remaining <- remaining - 1
            lower <- 128
            upper <- 191
            return true


        def file_stream_utf8_validate(buffer: u8&, count: usize, remaining: mutable u8&, lower: mutable u8&, upper: mutable u8&) -> bool:
            for index in 0..<count |buffer, remaining, lower, upper|:
                return false if not file_stream_utf8_feed(buffer[index], remaining, lower, upper)
            return true


        def file_stream_read_byte(stream: mutable FileStream&, byte: mutable u8&) -> FileStreamByteState can[Blocking.IO]:
            if stream.pending_valid:
                byte <- stream.pending_byte
                stream.pending_valid <- false
                return FileStreamByteState.Byte
            return FileStreamByteState.Limit if stream.bytes_read >= stream.byte_budget
            handle: mutable heap void& = stream.handle
            amount: usize = fread((&byte).cast[mutable void&], 1, 1, handle)
            return FileStreamByteState.Error if amount > 1 or amount == 0 and ferror(handle) != 0
            return FileStreamByteState.EncodingError if amount == 0 and stream.encoding == FileStreamEncoding.Utf8 and stream.utf8_remaining != 0
            return FileStreamByteState.End if amount == 0
            stream.bytes_read <- stream.bytes_read + 1
            return FileStreamByteState.EncodingError if stream.encoding == FileStreamEncoding.Utf8 and not file_stream_utf8_feed(byte, stream.utf8_remaining, stream.utf8_lower, stream.utf8_upper)
            return FileStreamByteState.Byte


        def file_stream_record_append(line: mutable darray[u8]&, byte: u8, max_line_bytes: usize) -> FileStreamRecordState:
            return FileStreamRecordState.LineTooLong if line.count >= max_line_bytes
            line.push(byte)
            return FileStreamRecordState.Progress


        def file_stream_record_next(stream: mutable FileStream&, line: mutable darray[u8]&, max_line_bytes: usize, mode: FileStreamLineMode, byte: mutable u8&) -> FileStreamRecordState can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            state: FileStreamByteState = file_stream_read_byte(stream, byte)
            return FileStreamRecordState.Limit if state == FileStreamByteState.Limit
            return FileStreamRecordState.EncodingError if state == FileStreamByteState.EncodingError
            return FileStreamRecordState.Error if state == FileStreamByteState.Error
            return FileStreamRecordState.End if state == FileStreamByteState.End and line.count == 0
            return FileStreamRecordState.Done if state == FileStreamByteState.End
            if mode == FileStreamLineMode.Lf:
                return FileStreamRecordState.Done if byte == 10
                return file_stream_record_append(line, byte, max_line_bytes)
            if byte == 10:
                if mode == FileStreamLineMode.Retain:
                    result: FileStreamRecordState = file_stream_record_append(line, byte, max_line_bytes)
                    return FileStreamRecordState.LineTooLong if result == FileStreamRecordState.LineTooLong else FileStreamRecordState.Done
                return FileStreamRecordState.Done
            if byte != 13:
                return file_stream_record_append(line, byte, max_line_bytes)
            if stream.bytes_read >= stream.byte_budget:
                if mode == FileStreamLineMode.Retain:
                    result: FileStreamRecordState = file_stream_record_append(line, byte, max_line_bytes)
                    return FileStreamRecordState.LineTooLong if result == FileStreamRecordState.LineTooLong else FileStreamRecordState.Done
                return FileStreamRecordState.Done
            lookahead: mutable u8 = 0
            next_state: FileStreamByteState = file_stream_read_byte(stream, lookahead)
            if next_state == FileStreamByteState.EncodingError:
                return FileStreamRecordState.EncodingError
            if next_state == FileStreamByteState.Error:
                return FileStreamRecordState.Error
            if next_state == FileStreamByteState.Byte and lookahead != 10:
                stream.pending_byte <- lookahead
                stream.pending_valid <- true
            if mode == FileStreamLineMode.Retain:
                result: FileStreamRecordState = file_stream_record_append(line, byte, max_line_bytes)
                return FileStreamRecordState.LineTooLong if result == FileStreamRecordState.LineTooLong
                if next_state == FileStreamByteState.Byte and lookahead == 10:
                    result <- file_stream_record_append(line, lookahead, max_line_bytes)
                    return FileStreamRecordState.LineTooLong if result == FileStreamRecordState.LineTooLong
            return FileStreamRecordState.Done


        # `file_stream_open` accepts an already-terminated host pointer for
        # compatibility with the POSIX ABI. Admit it with a bounded scan before
        # passing the pointer to libc; an empty or unterminated path must never
        # turn `fopen` into an unbounded read or an ambiguous host lookup.
        def file_stream_path_terminated(path: cstr) -> bool:
            bytes: u8& = path.cast[u8&]
            return false if bytes[0] == 0
            for index in 0..<FILE_STREAM_MAX_PATH_BYTES |bytes|:
                return true if bytes[index] == 0
            return false


    public:
        def file_stream_open(path: cstr, mode: FileStreamMode, byte_budget: usize = FILE_STREAM_DEFAULT_MAX_BYTES, encoding: FileStreamEncoding = FileStreamEncoding.Auto) -> FileStream error[FileStreamError] can[Blocking.IO, Memory.Allocate, Memory.Release]:
            raise FileStreamError.PathTooLong(path) if not file_stream_path_terminated(path)
            raise FileStreamError.LimitExceeded(path) if byte_budget == 0 or byte_budget > FILE_STREAM_DEFAULT_MAX_BYTES
            raise FileStreamError.InvalidEncoding(path) if not file_stream_encoding_valid(mode, encoding)
            resolved_encoding: FileStreamEncoding = FileStreamEncoding.Utf8 if encoding == FileStreamEncoding.Auto and file_stream_mode_is_text(mode) else FileStreamEncoding.Bytes if encoding == FileStreamEncoding.Auto else encoding
            mode_bytes: u8& = "rb"
            if mode == FileStreamMode.ReadText:
                mode_bytes <- "r"
            elif mode == FileStreamMode.WriteText:
                mode_bytes <- "w"
            elif mode == FileStreamMode.WriteBinary:
                mode_bytes <- "wb"
            elif mode == FileStreamMode.AppendText:
                mode_bytes <- "a"
            elif mode == FileStreamMode.AppendBinary:
                mode_bytes <- "ab"
            elif mode != FileStreamMode.ReadBinary:
                raise FileStreamError.OpenFailed(path)
            opened: mutable heap void&? = fopen(path.cast[u8&], mode_bytes)
            raise FileStreamError.OpenFailed(path) if opened == null
            return FileStream{handle: opened, path: path, mode: mode, encoding: resolved_encoding, state: FileStreamState.Open, byte_budget: byte_budget}


        def file_stream_read_chunk(stream: mutable FileStream&, buffer: mutable u8&, capacity: usize) -> FileStreamRead error[FileStreamError] can[Blocking.IO]:
            raise FileStreamError.Closed(stream.path) if stream.state != FileStreamState.Open or stream.handle == null
            raise FileStreamError.WrongMode(stream.path) if stream.mode != FileStreamMode.ReadText and stream.mode != FileStreamMode.ReadBinary
            return FileStreamRead{count: 0, eof: false} if capacity == 0
            count: mutable usize = 0
            # Universal/retained line reads may have consumed a non-delimiter
            # lookahead into the bounded pending slot. Publish it before any
            # host probe so switching from record to chunk reads cannot lose a
            # byte or read past the shared budget.
            if stream.pending_valid:
                buffer[0] <- stream.pending_byte
                stream.pending_valid <- false
                count <- 1
            return FileStreamRead{count: count, eof: false} if count == capacity
            return FileStreamRead{count: count, eof: false} if stream.bytes_read >= stream.byte_budget
            remaining: usize = capacity - count
            raise FileStreamError.LimitExceeded(stream.path) if stream.bytes_read > stream.byte_budget or remaining > stream.byte_budget - stream.bytes_read
            handle: mutable heap void& = stream.handle
            cursor: mutable u8& = buffer + count
            read_count: usize = fread(cursor.cast[mutable void&], 1, remaining, handle)
            raise FileStreamError.ReadFailed(stream.path) if read_count > remaining or read_count == 0 and ferror(handle) != 0
            raise FileStreamError.LimitExceeded(stream.path) if read_count > stream.byte_budget - stream.bytes_read
            stream.bytes_read <- stream.bytes_read + read_count
            if stream.encoding == FileStreamEncoding.Utf8:
                raise FileStreamError.InvalidUtf8(stream.path) if not file_stream_utf8_validate(cursor, read_count, stream.utf8_remaining, stream.utf8_lower, stream.utf8_upper)
                raise FileStreamError.InvalidUtf8(stream.path) if read_count == 0 and count == 0 and stream.utf8_remaining != 0
            return FileStreamRead{count: count + read_count, eof: read_count == 0 and count == 0}


        def file_stream_write_chunk(stream: mutable FileStream&, buffer: mutable u8&, capacity: usize) -> FileStreamWrite error[FileStreamError] can[Blocking.IO]:
            raise FileStreamError.Closed(stream.path) if stream.state != FileStreamState.Open or stream.handle == null
            raise FileStreamError.WrongMode(stream.path) if stream.mode != FileStreamMode.WriteText and stream.mode != FileStreamMode.WriteBinary and stream.mode != FileStreamMode.AppendText and stream.mode != FileStreamMode.AppendBinary
            return FileStreamWrite{count: 0} if capacity == 0
            raise FileStreamError.LimitExceeded(stream.path) if stream.bytes_written > stream.byte_budget or capacity > stream.byte_budget - stream.bytes_written
            handle: mutable heap void& = stream.handle
            offset: mutable usize = 0
            while offset < capacity:
                remaining: usize = capacity - offset
                cursor: mutable u8& = buffer + offset
                if stream.encoding == FileStreamEncoding.Utf8:
                    next_remaining: mutable u8 = stream.utf8_remaining
                    next_lower: mutable u8 = stream.utf8_lower
                    next_upper: mutable u8 = stream.utf8_upper
                    raise FileStreamError.InvalidUtf8(stream.path) if not file_stream_utf8_validate(cursor, remaining, next_remaining, next_lower, next_upper)
                write_count: usize = fwrite(cursor.cast[void&], 1, remaining, handle)
                state: FileStreamWriteState = file_stream_write_transition(offset, capacity, write_count, stream.byte_budget - stream.bytes_written - offset)
                # A short positive write is recoverable; zero progress is a
                # terminal host failure even when libc has not set ferror.
                raise FileStreamError.WriteFailed(stream.path) if state == FileStreamWriteState.Error
                raise FileStreamError.LimitExceeded(stream.path) if state == FileStreamWriteState.Limit
                if stream.encoding == FileStreamEncoding.Utf8 and write_count > 0:
                    raise FileStreamError.InvalidUtf8(stream.path) if not file_stream_utf8_validate(cursor, write_count, stream.utf8_remaining, stream.utf8_lower, stream.utf8_upper)
                offset <- offset + write_count
                break if state == FileStreamWriteState.Done
            stream.bytes_written <- stream.bytes_written + offset
            return FileStreamWrite{count: offset}


        def file_stream_sync(stream: mutable FileStream&) -> bool error[FileStreamError] can[Blocking.IO]:
            raise FileStreamError.Closed(stream.path) if stream.state != FileStreamState.Open or stream.handle == null
            raise FileStreamError.WrongMode(stream.path) if stream.mode != FileStreamMode.WriteText and stream.mode != FileStreamMode.WriteBinary and stream.mode != FileStreamMode.AppendText and stream.mode != FileStreamMode.AppendBinary
            raise FileStreamError.InvalidUtf8(stream.path) if stream.encoding == FileStreamEncoding.Utf8 and stream.utf8_remaining != 0
            handle: mutable heap void& = stream.handle
            raise FileStreamError.FlushFailed(stream.path) if fflush(handle) != 0
            descriptor: int = elisascript_posix_fileno(handle)
            raise FileStreamError.SyncFailed(stream.path) if descriptor < 0 or elisascript_posix_fsync(descriptor) != 0
            return true


        def file_stream_tell(stream: mutable FileStream&) -> i64 error[FileStreamError] can[Blocking.IO]:
            raise FileStreamError.Closed(stream.path) if stream.state != FileStreamState.Open or stream.handle == null
            handle: mutable heap void& = stream.handle
            position: i64 = ftell(handle)
            raise FileStreamError.SeekFailed(stream.path) if position < 0
            # A universal/retained record read may have probed one byte past
            # the logical record boundary. Report the caller-visible position,
            # not libc's position after that unpublished lookahead.
            return position - 1 if stream.pending_valid and position > 0
            return position


        def file_stream_seek(stream: mutable FileStream&, offset: i64, origin: FileStreamSeekOrigin) -> i64 error[FileStreamError] can[Blocking.IO]:
            raise FileStreamError.Closed(stream.path) if stream.state != FileStreamState.Open or stream.handle == null
            raise FileStreamError.SeekFailed(stream.path) if origin not in {FileStreamSeekOrigin.Begin, FileStreamSeekOrigin.Current, FileStreamSeekOrigin.End}
            handle: mutable heap void& = stream.handle
            if stream.pending_valid and origin == FileStreamSeekOrigin.Current:
                raise FileStreamError.SeekFailed(stream.path) if fseek(handle, -1, FILEIO_SEEK_CUR) != 0
            whence: int = FILEIO_SEEK_SET if origin == FileStreamSeekOrigin.Begin else FILEIO_SEEK_CUR if origin == FileStreamSeekOrigin.Current else FILEIO_SEEK_END
            raise FileStreamError.SeekFailed(stream.path) if fseek(handle, offset, whence) != 0
            stream.pending_valid <- false
            stream.pending_byte <- 0
            stream.utf8_remaining <- 0
            stream.utf8_lower <- 128
            stream.utf8_upper <- 191
            return file_stream_tell(stream)


        # Read one logical record with an explicit newline policy. `Lf` keeps
        # the historical LF-only behavior and preserves CR as data;
        # `Universal` treats LF, CRLF, and lone CR as delimiters; `Retain`
        # includes the delimiter bytes in the returned record.
        def file_stream_read_line_mode(stream: mutable FileStream&, line: mutable darray[u8]&, max_line_bytes: usize, mode: FileStreamLineMode) -> FileStreamRead error[FileStreamError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            raise FileStreamError.Closed(stream.path) if stream.state != FileStreamState.Open or stream.handle == null
            raise FileStreamError.WrongMode(stream.path) if stream.mode != FileStreamMode.ReadText and stream.mode != FileStreamMode.ReadBinary
            raise FileStreamError.LineTooLong(stream.path) if max_line_bytes == 0
            raise FileStreamError.InvalidLineMode(stream.path) if mode not in {FileStreamLineMode.Lf, FileStreamLineMode.Universal, FileStreamLineMode.Retain}
            line.truncate(0)
            byte: mutable u8 = 0
            result: mutable FileStreamRead = FileStreamRead{count: 0, eof: false}
            machine over file_stream_record_next(stream, line, max_line_bytes, mode, byte) while true:
                state Read
                start Read

                Read, FileStreamRecordState.Progress:
                    -> Read
                Read, FileStreamRecordState.Done:
                    result <- FileStreamRead{count: line.count, eof: false}
                    break
                Read, FileStreamRecordState.End:
                    result <- FileStreamRead{count: line.count, eof: true}
                    break
                Read, FileStreamRecordState.Limit:
                    raise FileStreamError.LimitExceeded(stream.path)
                Read, FileStreamRecordState.LineTooLong:
                    raise FileStreamError.LineTooLong(stream.path)
                Read, FileStreamRecordState.EncodingError:
                    raise FileStreamError.InvalidUtf8(stream.path)
                Read, FileStreamRecordState.Error:
                    raise FileStreamError.ReadFailed(stream.path)
            return result


        # Backward-compatible LF-only spelling. Callers that need Python-like
        # universal-newline records or retained delimiters use the explicit
        # mode API above.
        def file_stream_read_line(stream: mutable FileStream&, line: mutable darray[u8]&, max_line_bytes: usize) -> FileStreamRead error[FileStreamError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            return file_stream_read_line_mode(stream, line, max_line_bytes, FileStreamLineMode.Lf)


        def file_stream_close(stream: mutable FileStream&) -> bool error[FileStreamError] can[Blocking.IO, Memory.Release]:
            # A terminal stream is idempotently closable only when both pieces
            # of its representation agree.  Treat an externally assembled
            # `Closed` stream that still owns a handle, or an `Open` stream
            # whose handle was already cleared, as a malformed cleanup state
            # instead of silently accepting a split-brain resource.
            raise FileStreamError.CleanupStateInvalid(stream.path) if stream.state == FileStreamState.Closed and stream.handle != null
            return true if stream.state == FileStreamState.Closed
            raise FileStreamError.CleanupStateInvalid(stream.path) if stream.handle == null
            handle: mutable heap void& = stream.handle
            status: int = fclose(handle)
            incomplete_utf8: bool = stream.encoding == FileStreamEncoding.Utf8 and stream.utf8_remaining != 0
            stream.handle <- null
            stream.state <- FileStreamState.Closed
            raise FileStreamError.CloseFailed(stream.path) if status != 0
            raise FileStreamError.InvalidUtf8(stream.path) if incomplete_utf8
            return true
