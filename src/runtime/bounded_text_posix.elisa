# Shared bounded UTF-8 file reader for repository automation and host adapters.
# It follows symlinks like ordinary text-file APIs, but only reads a verified
# regular file through a nonblocking descriptor and a caller-owned byte budget.

include "runtime.elisa"
include "encoding.elisa"
include "file_posix.elisa"
include "directory_posix.elisa"
include "stdio_posix.elisa"
include "process_exec_search_model.elisa"

using EsEncoding
using EsRuntime


module EsBoundedText:
    public:
        error ReadError:
            InvalidPath
            ReadFailed
            Changed
            LimitExceeded
            InvalidUtf8


        # The returned view owns permanent backing storage so it can outlive this reader frame.
        # Callers should budget one retained copy up to `maximum_bytes`, plus transient read
        # and scratch storage. Dynamic-array capacity growth can make peak usage exceed twice the
        # input limit, so the limit is not a peak-memory ceiling.
        def read_utf8[T: Str](input_path: T, maximum_bytes: usize) -> sview error[ReadError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global{Read,Write}]:
            can Global:
                return try read_utf8_text(f"{input_path}", maximum_bytes)


        # Keep the reader independent of the script-only Path type. Callers that
        # own a Path format it at this boundary, then share the same bounded read.
        def read_utf8_path_text(input_path: sview, maximum_bytes: usize) -> sview error[ReadError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global{Read,Write}]:
            can Global:
                return try read_utf8_text(input_path, maximum_bytes)


    private:
        def read_utf8_text(input_path: sview, maximum_bytes: usize) -> sview error[ReadError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global{Read,Write}]:
            raise ReadError.LimitExceeded if maximum_bytes > Limits::MAX_BYTES
            raise ReadError.InvalidPath if input_path == "" or len(input_path) >= Limits::PATH_BYTES or sview_contains_byte(input_path, 0)
            path_bytes: mutable darray[u8] = []
            path_bytes.extend([byte for byte in input_path])
            path_bytes.push(0u8)
            path_pointer: cstr = (&path_bytes[0]).cast[cstr]

            named_before_open: mutable ElisascriptStat = zeroed
            raise ReadError.ReadFailed if not stat_path(path_pointer, named_before_open) or (named_before_open.mode & EsRuntime::DarwinStatMode::MASK) != EsRuntime::DarwinStatMode::REGULAR
            descriptor: int = open_path(path_pointer)
            raise ReadError.ReadFailed if descriptor < 0
            opened: mutable ElisascriptStat = zeroed
            if not fstat_descriptor(descriptor, opened) or (opened.mode & EsRuntime::DarwinStatMode::MASK) != EsRuntime::DarwinStatMode::REGULAR or opened.size < 0 or not same_file(named_before_open, opened):
                _ = elisascript_posix_close(descriptor)
                raise ReadError.ReadFailed
            if opened.size > maximum_bytes.i64():
                _ = elisascript_posix_close(descriptor)
                raise ReadError.LimitExceeded
            named_after_open: mutable ElisascriptStat = zeroed
            if not stat_path(path_pointer, named_after_open) or not same_file(opened, named_after_open):
                _ = elisascript_posix_close(descriptor)
                raise ReadError.Changed

            chunk: mutable darray[u8] = []
            # Size scratch storage from the verified file size when it is below the
            # caller's limit; leave room for an overflow probe and cap the chunk.
            chunk_capacity: mutable usize = maximum_bytes + 1
            chunk_capacity <- opened.size.usize() + 1 if opened.size.usize() < maximum_bytes
            chunk_capacity <- Limits::READ_CHUNK_BYTES if chunk_capacity > Limits::READ_CHUNK_BYTES
            chunk.reserve(chunk_capacity)
            for _ in 0..<chunk_capacity |chunk|:
                chunk.push(0u8)
            bytes: mutable darray[u8] = []
            initial_capacity: mutable usize = maximum_bytes if maximum_bytes < Limits::READ_CHUNK_BYTES else Limits::READ_CHUNK_BYTES
            initial_capacity <- opened.size.usize() if opened.size.usize() < maximum_bytes
            bytes.reserve(initial_capacity)
            interrupted: mutable usize = 0
            while true:
                remaining: usize = maximum_bytes - bytes.count
                probe_capacity: usize = remaining + 1
                capacity: usize = probe_capacity if probe_capacity < chunk.count else chunk.count
                chunk_pointer: mutable u8& = (&chunk[0]).cast[mutable u8&]
                amount: isize = elisascript_posix_read(descriptor, chunk_pointer.cast[mutable void&], capacity)
                if amount < 0:
                    if not errno_shape(amount.i64()):
                        _ = elisascript_posix_close(descriptor)
                        raise ReadError.ReadFailed
                    errno: mutable i32& = elisascript_posix_errno()
                    if errno[0] == EsProcessExecSearch::DarwinErrno::EINTR and interrupted < Limits::READ_EINTR_RETRIES:
                        interrupted <- interrupted + 1
                        continue
                    _ = elisascript_posix_close(descriptor)
                    raise ReadError.ReadFailed
                if amount == 0:
                    break
                read_count: usize = amount.usize()
                if read_count > capacity:
                    _ = elisascript_posix_close(descriptor)
                    raise ReadError.ReadFailed
                if read_count > remaining:
                    _ = elisascript_posix_close(descriptor)
                    raise ReadError.LimitExceeded
                for offset in 0..<read_count |bytes, chunk|:
                    bytes.push(chunk[offset])
                # Small-file scratch buffers keep transient storage low. If the
                # opened file changes after sizing, stop promptly instead of
                # issuing one small read per byte until the final stability check.
                if capacity < Limits::READ_CHUNK_BYTES:
                    current_opened: mutable ElisascriptStat = zeroed
                    if not fstat_descriptor(descriptor, current_opened):
                        _ = elisascript_posix_close(descriptor)
                        raise ReadError.ReadFailed
                    if not stable_file(opened, current_opened):
                        _ = elisascript_posix_close(descriptor)
                        raise ReadError.Changed
                interrupted <- 0

            final_opened: mutable ElisascriptStat = zeroed
            final_named: mutable ElisascriptStat = zeroed
            # Check the final named-path metadata as well as its inode: an
            # inode-only comparison can miss a write between the last fstat
            # and stat(path).
            stable: bool = fstat_descriptor(descriptor, final_opened) and stat_path(path_pointer, final_named) and stable_file(opened, final_opened) and stable_file(final_opened, final_named)
            close_status: int = elisascript_posix_close(descriptor)
            raise ReadError.ReadFailed if close_status != 0
            raise ReadError.Changed if not stable
            contents: sview = bytes_view(bytes)
            raise ReadError.InvalidUtf8 if not text_is_valid_utf8(contents)
            # `bytes_view` borrows the local byte array. Copy only after validation so the
            # returned view remains backed by permanent string storage after this frame exits.
            can Global:
                owned_text: cstr = string_view_copy(contents)
                return sview(owned_text, 0, len(contents).i64())


        const module Limits:
            MAX_BYTES: usize = 16777216
            PATH_BYTES: usize = 4096
            READ_CHUNK_BYTES: usize = 16384
            READ_EINTR_RETRIES: usize = 4
            # Selected Darwin C-int descriptor carrier, not an ownership proof.
            MAX_DESCRIPTOR: int = 2147483647


        def descriptor_shape(value: int) -> bool:
            return value >= 0 and value <= Limits::MAX_DESCRIPTOR


        def errno_shape(value: i64) -> bool:
            return value == -1i64


        def open_path(path_value: cstr) -> int can[Blocking.IO]:
            retries: mutable usize = 0
            flags: int = EsRuntime::DarwinOpenFlags::RDONLY | EsRuntime::DarwinOpenFlags::NONBLOCK | EsRuntime::DarwinOpenFlags::CLOSE_ON_EXEC
            while true:
                descriptor: int = elisascript_posix_open(path_value, flags, 0u32)
                return descriptor if descriptor_shape(descriptor)
                return -1 if not errno_shape(descriptor.i64())
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == EsProcessExecSearch::DarwinErrno::EINTR and retries < Limits::READ_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return -1
            return -1


        def stat_path(path_value: cstr, result: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                returned: int = elisascript_posix_stat(path_value, result)
                return true if returned == 0
                return false if not errno_shape(returned.i64())
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == EsProcessExecSearch::DarwinErrno::EINTR and retries < Limits::READ_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false
            return false


        def fstat_descriptor(descriptor: int, result: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                returned: int = elisascript_posix_fstat(descriptor, result)
                return true if returned == 0
                return false if not errno_shape(returned.i64())
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == EsProcessExecSearch::DarwinErrno::EINTR and retries < Limits::READ_EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false
            return false


        def same_file(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return left.device == right.device and left.inode == right.inode


        def stable_file(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return same_file(left, right) and left.size == right.size and left.modify_time.seconds == right.modify_time.seconds and left.modify_time.nanoseconds == right.modify_time.nanoseconds and left.change_time.seconds == right.change_time.seconds and left.change_time.nanoseconds == right.change_time.nanoseconds


        def text_is_valid_utf8(contents: sview) -> bool:
            cursor: mutable EsEncoding::Utf8Cursor = EsEncoding::Utf8Cursor{}
            for offset in 0..<len(contents) |contents, cursor|:
                return false if not EsEncoding::utf8_feed(sview_at(contents, offset), cursor)
            return EsEncoding::utf8_complete(cursor)
