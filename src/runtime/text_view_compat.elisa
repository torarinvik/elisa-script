# Bounded sview access for compiler versions whose builtin surface predates
# sview_len/sview_at. Negative lengths are the C-string sentinel; scan those
# only through the caller's explicit byte ceiling plus one overflow byte.

module EsTextViewCompat:
    public:
        def length(text: sview, maximum_bytes: usize) -> usize:
            if text.len >= 0:
                declared: usize = text.len.usize()
                return maximum_bytes + 1 if declared > maximum_bytes
                return declared
            return maximum_bytes + 1 if text.len != -1
            cursor: mutable usize = 0
            while cursor <= maximum_bytes |text, maximum_bytes, cursor|:
                return cursor if text.data[cursor] == 0
                cursor <- cursor + 1
            return maximum_bytes + 1


        def byte_at(text: sview, index: usize) -> u8:
            return text.data[index]


        def contains_byte(text: sview, expected: u8, maximum_bytes: usize) -> bool:
            length: usize = EsTextViewCompat::length(text, maximum_bytes)
            for index in 0..<length |text, expected, length|:
                return true if EsTextViewCompat::byte_at(text, index) == expected
            return false
