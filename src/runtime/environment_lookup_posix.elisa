# Native POSIX adapter. Never turn admission/allocation errors into absence.
# The host must exclude concurrent setenv/unsetenv/putenv during this copy.
include "environment_lookup_model.elisa"

extend EsEnvironmentLookup:
    private:
        @link_name(getenv)
        extern lookup_posix_getenv(name: cstr) -> u8&? can[Environment.Read]

    public:
        def lookup(name: sview) -> Value error[LookupError] can[Environment.Read, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            try validate_name(name)
            name_bytes: mutable darray[u8] = []
            for byte in name |name_bytes|:
                name_bytes.push(byte)
            name_bytes.push(0u8)
            name_pointer: cstr = (&name_bytes[0]).cast[cstr]
            borrowed: u8&? = lookup_posix_getenv(name_pointer)
            return Value{present: false} if borrowed == null
            pointer: u8& = borrowed
            owned: mutable darray[u8] = []
            # The extra byte is a terminator probe. At the admitted boundary,
            # accept NUL but never append another payload byte.
            for index in 0..<(Limits::VALUE_BYTES + 1) |pointer, owned|:
                byte: u8 = pointer[index]
                return Value{present: true, bytes: bytes_view(owned)} if byte == 0u8
                raise LookupError.ValueLimit if index == Limits::VALUE_BYTES
                owned.push(byte)
            raise LookupError.ValueLimit
