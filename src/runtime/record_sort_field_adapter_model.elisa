# Convert validated source record fields into the typed keys used by sorting.
#
# Text keys preserve the field view. Integer keys use the bounded numeric
# scanner and checked signed conversion; no locale or float coercion is hidden
# in sorting.

module EsRecordSortFields:
    using EsRecord
    using EsRecordNumeric
    using EsRecordSort

    private:
        def record_sort_key_from_field_validated(policy: RecordSortPolicy, spec_index: usize, spec: RecordSortKeySpec, record: mutable Record&, field: mutable RecordField&, numeric_policy: RecordNumericPolicy) -> RecordSortKey error[RecordContractError, RecordNumericError, RecordSortError]:
            raise RecordSortError.KeyInvalid if field.index != spec.field_index
            record_policy: mutable RecordStreamPolicy = policy.record_policy
            _ = try validate_record_field(field, record, record_policy)
            if spec.kind == RecordSortKeyKind.Integer:
                raise RecordSortError.KeyKindInvalid if numeric_policy.kind != RecordNumericKind.Integer
            if not field.present:
                return RecordSortKey{spec_index: spec_index, kind: spec.kind, present: false}
            if spec.kind == RecordSortKeyKind.Text:
                return RecordSortKey{spec_index: spec_index, kind: spec.kind, text: field.value}
            numeric: RecordNumericSession = try parse_record_numeric(field.value, numeric_policy)
            result: RecordNumericResult = try record_numeric_result(numeric)
            integer: i64 = try record_numeric_result_i64(result)
            return RecordSortKey{spec_index: spec_index, kind: spec.kind, integer: integer}

    public:
        def record_sort_key_from_field(policy: RecordSortPolicy, spec_index: usize, record: mutable Record&, field: mutable RecordField&, numeric_policy: RecordNumericPolicy) -> RecordSortKey error[RecordContractError, RecordNumericError, RecordSortError]:
            _ = try validate_record_sort_session(RecordSortSession{policy: policy})
            raise RecordSortError.KeyInvalid if spec_index >= policy.keys.count
            spec: RecordSortKeySpec = policy.keys[spec_index]
            return try record_sort_key_from_field_validated(policy, spec_index, spec, record, field, numeric_policy)


        def record_sort_entry_from_fields(policy: RecordSortPolicy, record: mutable Record&, fields: darray[RecordField], numeric_policy: RecordNumericPolicy, ordinal: usize) -> RecordSortEntry error[RecordContractError, RecordNumericError, RecordSortError]:
            _ = try validate_record_sort_session(RecordSortSession{policy: policy})
            raise RecordSortError.KeyOrderInvalid if fields.count != policy.keys.count
            raise RecordSortError.OrdinalInvalid if ordinal >= RECORD_SORT_MAX_RECORDS
            keys: mutable darray[RecordSortKey] = []
            for index in 0..<policy.keys.count |policy, record, fields, numeric_policy, keys|:
                spec: RecordSortKeySpec = policy.keys[index]
                field: mutable RecordField = fields[index]
                key: RecordSortKey = try record_sort_key_from_field_validated(policy, index, spec, record, field, numeric_policy)
                keys.push(key)
            return RecordSortEntry{record: record, keys: keys, ordinal: ordinal}
