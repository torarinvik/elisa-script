# Pure, source-derived model of Bash 3.2 `exec` PATH lookup policy.
# Native execvp retry behavior and host filesystem observations are separate.

module EsBashExecLookup:
    public:
        const enum SelectionKind of u8:
            NotFound
            Executable
            NonExecutableFallback


        const enum SearchMode of u8:
            DirectName
            PathDirectories


        const enum PathDirectoryKind of u8:
            NamedDirectory
            CurrentDirectory


        const module ExecuteMode:
            OWNER: u16 = 0o100u16
            GROUP: u16 = 0o010u16
            OTHER: u16 = 0o001u16
            ANY: u16 = 0o111u16


        const module Limits:
            COMMAND_BYTES: usize = 4096
            PATH_BYTES: usize = 65536
            PATH_ENTRIES: usize = 4096
            CANDIDATE_PATH_BYTES: usize = PATH_BYTES + COMMAND_BYTES + 1


        struct CredentialSnapshot:
            effective_user: u32 = 0
            real_group: u32 = 0
            effective_group: u32 = 0
            supplementary_groups: darray[u32] = []


        # The shell's current-user tilde value is supplied as an explicit
        # snapshot. An absent HOME still needs the shell's passwd fallback and
        # remains unsupported by this model adapter.
        struct PathTildeContext:
            home_present: bool = false
            home_directory: darray[u8] = []


        struct PathDirectory:
            kind: PathDirectoryKind = PathDirectoryKind.NamedDirectory
            start: usize = 0
            length: usize = 0
            tilde_expansion_candidate: bool = false


        struct PathSearchPlan:
            mode: SearchMode = SearchMode.DirectName
            path_bytes: darray[u8] = []
            directories: darray[PathDirectory] = []


        struct PathCandidate:
            exists: bool = false
            executable: bool = false
            directory: bool = false


        struct Selection:
            kind: SelectionKind = SelectionKind.NotFound
            index: usize = 0


        error LookupError:
            InvalidCandidateState
            InvalidSearchPlan
            SearchInputContainsNul
            CommandLimitExceeded
            PathLimitExceeded
            PathEntryLimitExceeded
            DirectNameMustBypassPath
            CandidatePathLimitExceeded
            TildeExpansionUnsupported


        # Model the non-AFS Bash 3.2 file_status permission-bit check. This
        # deliberately consumes an explicit credential snapshot: the caller
        # must obtain credentials and stat metadata from a qualified host
        # adapter. ACL evaluation and access(X_OK) are not substituted here.
        def mode_allows_execution(mode: u16, file_user: u32, file_group: u32, credentials: CredentialSnapshot) -> bool:
            if credentials.effective_user == 0:
                return (mode & ExecuteMode::ANY) != 0u16
            if credentials.effective_user == file_user:
                return (mode & ExecuteMode::OWNER) != 0u16
            if bash_group_member(file_group, credentials):
                return (mode & ExecuteMode::GROUP) != 0u16
            return (mode & ExecuteMode::OTHER) != 0u16


        # Preserve Bash 3.2's search-input rules without observing the
        # filesystem: slash-containing commands and empty/unset PATH go
        # directly to the command spelling. For a non-empty PATH, each
        # interior empty component denotes '.', while a final empty component
        # is omitted by the source loop. Named components remain byte spans
        # into the caller's PATH snapshot and mark leading-tilde candidates for
        # the eventual host expansion adapter.
        def plan_path_search(command: sview, path_value: sview) -> PathSearchPlan error[LookupError]:
            command_length: usize = sview_len(command)
            raise LookupError.CommandLimitExceeded if command_length > Limits::COMMAND_BYTES
            raise LookupError.SearchInputContainsNul if sview_contains_byte(command, 0u8)

            has_slash: mutable bool = false
            for index in 0..<command_length |command, has_slash|:
                has_slash <- true if sview_at(command, index) == 47u8
            return PathSearchPlan{} if has_slash

            path_length: usize = sview_len(path_value)
            raise LookupError.PathLimitExceeded if path_length > Limits::PATH_BYTES
            raise LookupError.SearchInputContainsNul if sview_contains_byte(path_value, 0u8)
            return PathSearchPlan{} if path_length == 0

            plan: mutable PathSearchPlan = PathSearchPlan{mode: SearchMode.PathDirectories}
            for byte in path_value |plan|:
                plan.path_bytes.push(byte)
            cursor: mutable usize = 0
            while cursor < path_length |path_value, plan, cursor|:
                start: usize = cursor
                while cursor < path_length and sview_at(path_value, cursor) != 58u8 |path_value, cursor|:
                    cursor <- cursor + 1
                length: usize = cursor - start
                raise LookupError.PathEntryLimitExceeded if plan.directories.count >= Limits::PATH_ENTRIES
                if length == 0:
                    plan.directories.push(PathDirectory{kind: PathDirectoryKind.CurrentDirectory})
                else:
                    plan.directories.push(PathDirectory{kind: PathDirectoryKind.NamedDirectory, start: start, length: length, tilde_expansion_candidate: sview_at(path_value, start) == 126u8})
                cursor <- cursor + 1 if cursor < path_length
            return plan


        def path_directory_spelling(plan: PathSearchPlan&, index: usize) -> sview error[LookupError]:
            raise LookupError.InvalidSearchPlan if plan.mode != SearchMode.PathDirectories or index >= plan.directories.count
            path_value: sview = bytes_view(plan.path_bytes)
            raise LookupError.InvalidSearchPlan if sview_len(path_value) > Limits::PATH_BYTES or sview_contains_byte(path_value, 0u8)
            directory: PathDirectory = plan.directories[index]
            if directory.kind == PathDirectoryKind.CurrentDirectory:
                raise LookupError.InvalidSearchPlan if directory.start != 0 or directory.length != 0 or directory.tilde_expansion_candidate
                return "."
            raise LookupError.InvalidSearchPlan if directory.kind != PathDirectoryKind.NamedDirectory or directory.length == 0 or directory.start > sview_len(path_value) or directory.length > sview_len(path_value) - directory.start
            raise LookupError.InvalidSearchPlan if directory.tilde_expansion_candidate != (sview_at(path_value, directory.start) == 126u8)
            return string_view_slice(path_value, directory.start.i64(), (directory.start + directory.length).i64())


        # Match Bash's `~` and `~/suffix` prefix concatenation when the shell's
        # HOME value is available. Do not normalize bytes: repeated separators
        # are significant to the subsequent sh_makepath-compatible join.
        # Named-user, ~+/~-, and passwd fallback forms require more shell state.
        def resolve_path_directory(directory: sview, tilde: PathTildeContext&) -> darray[u8] error[LookupError] can[Memory.Allocate, Abort.Panic]:
            directory_length: usize = sview_len(directory)
            raise LookupError.PathLimitExceeded if directory_length > Limits::PATH_BYTES
            raise LookupError.SearchInputContainsNul if sview_contains_byte(directory, 0u8)
            is_tilde: mutable bool = false
            is_tilde <- sview_at(directory, 0) == 126u8 if directory_length > 0
            if is_tilde:
                raise LookupError.TildeExpansionUnsupported if directory_length > 1 and sview_at(directory, 1) != 47u8
                raise LookupError.TildeExpansionUnsupported if not tilde.home_present
                raise LookupError.PathLimitExceeded if tilde.home_directory.count > Limits::PATH_BYTES
                raise LookupError.SearchInputContainsNul if sview_contains_byte(bytes_view(tilde.home_directory), 0u8)

            home_length: usize = tilde.home_directory.count if is_tilde else 0
            suffix_length: usize = directory_length - 1 if is_tilde else directory_length
            raise LookupError.PathLimitExceeded if suffix_length > Limits::PATH_BYTES - home_length

            resolved: mutable darray[u8] = []
            resolved.reserve(home_length + suffix_length)
            for index in 0..<home_length |tilde, resolved|:
                resolved.push(tilde.home_directory[index])
            suffix_start: usize = 1 if is_tilde else 0
            for index in suffix_start..<directory_length |directory, resolved|:
                resolved.push(sview_at(directory, index))
            return resolved


        # Plans are public data for easy inspection, so re-derive their shape
        # from the owned PATH snapshot before an adapter performs observations.
        def validate_path_search_plan(plan: PathSearchPlan, command: sview) -> void error[LookupError]:
            expected: PathSearchPlan = try plan_path_search(command, bytes_view(plan.path_bytes))
            raise LookupError.InvalidSearchPlan if plan.mode != expected.mode
            raise LookupError.InvalidSearchPlan if plan.path_bytes.count != expected.path_bytes.count or plan.directories.count != expected.directories.count
            for index in 0..<expected.path_bytes.count |plan, expected|:
                raise LookupError.InvalidSearchPlan if plan.path_bytes[index] != expected.path_bytes[index]
            for index in 0..<expected.directories.count |plan, expected|:
                actual_directory: PathDirectory = plan.directories[index]
                expected_directory: PathDirectory = expected.directories[index]
                raise LookupError.InvalidSearchPlan if actual_directory.kind != expected_directory.kind or actual_directory.start != expected_directory.start or actual_directory.length != expected_directory.length or actual_directory.tilde_expansion_candidate != expected_directory.tilde_expansion_candidate


        # Match sh_makepath(path, name, 0) after Bash has expanded any PATH
        # tilde prefix: empty path becomes '.', a slash is inserted only when
        # the directory lacks a trailing slash, and no normalization occurs.
        # `resolved_directory` must already include any Bash-compatible tilde
        # expansion; this pure join does not perform home-directory lookup.
        def join_search_candidate(resolved_directory: sview, command: sview) -> darray[u8] error[LookupError] can[Memory.Allocate, Abort.Panic]:
            directory_length: usize = sview_len(resolved_directory)
            command_length: usize = sview_len(command)
            raise LookupError.PathLimitExceeded if directory_length > Limits::PATH_BYTES
            raise LookupError.CommandLimitExceeded if command_length > Limits::COMMAND_BYTES
            raise LookupError.SearchInputContainsNul if sview_contains_byte(resolved_directory, 0u8) or sview_contains_byte(command, 0u8)
            for index in 0..<command_length |command|:
                raise LookupError.DirectNameMustBypassPath if sview_at(command, index) == 47u8

            effective_directory_length: usize = 1 if directory_length == 0 else directory_length
            needs_separator: mutable bool = true
            if directory_length > 0:
                needs_separator <- sview_at(resolved_directory, directory_length - 1) != 47u8
            candidate_length: usize = effective_directory_length + command_length + (1 if needs_separator else 0)
            raise LookupError.CandidatePathLimitExceeded if candidate_length > Limits::CANDIDATE_PATH_BYTES

            candidate: mutable darray[u8] = []
            candidate.reserve(candidate_length)
            if directory_length == 0:
                candidate.push(46u8)
            else:
                for index in 0..<directory_length |resolved_directory, candidate|:
                    candidate.push(sview_at(resolved_directory, index))
            candidate.push(47u8) if needs_separator
            for index in 0..<command_length |command, candidate|:
                candidate.push(sview_at(command, index))
            return candidate


    private:
        def bash_group_member(file_group: u32, credentials: CredentialSnapshot) -> bool:
            return true if credentials.real_group == file_group or credentials.effective_group == file_group
            for index in 0..<credentials.supplementary_groups.count |credentials|:
                return true if credentials.supplementary_groups[index] == file_group
            return false


    public:
        # Model find_user_command_in_path(..., FS_EXEC_PREFERRED|FS_NODIRS):
        # choose the first executable non-directory; if none exists, retain
        # the first existing entry as a fallback, then reject it if it is a
        # directory. Bash can therefore let a leading directory shadow a
        # later non-executable file when no executable candidate exists.
        def select_path_candidate(candidates: darray[PathCandidate]) -> Selection error[LookupError]:
            fallback: mutable usize = candidates.count
            for index in 0..<candidates.count |candidates, fallback|:
                candidate: PathCandidate = candidates[index]
                raise LookupError.InvalidCandidateState if (candidate.executable or candidate.directory) and not candidate.exists
                raise LookupError.InvalidCandidateState if candidate.executable and candidate.directory
                continue if not candidate.exists
                if candidate.executable and not candidate.directory:
                    return Selection{kind: SelectionKind.Executable, index: index}
                fallback <- index if fallback == candidates.count
            if fallback < candidates.count and not candidates[fallback].directory:
                return Selection{kind: SelectionKind.NonExecutableFallback, index: fallback}
            return Selection{}
