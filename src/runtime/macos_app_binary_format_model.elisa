# Pure prefix classification for native files staged by the macOS app packager.

module EsMacosAppBinaryFormat:
    public:
        def macos_app_header_is_mach_o(prefix: darray[u8]) -> bool:
            return false if prefix.count != 4
            return true if macos_app_header_matches(prefix, MachOMagic::THIN_64)
            return true if macos_app_header_matches(prefix, MachOMagic::THIN_32)
            return macos_app_header_matches(prefix, MachOMagic::FAT)


    private:
        struct MachOMagicBytes:
            first: u8
            second: u8
            third: u8
            fourth: u8


        const module MachOMagic:
            THIN_64: MachOMagicBytes = MachOMagicBytes{first: 207, second: 250, third: 237, fourth: 254}
            THIN_32: MachOMagicBytes = MachOMagicBytes{first: 206, second: 250, third: 237, fourth: 254}
            FAT: MachOMagicBytes = MachOMagicBytes{first: 202, second: 254, third: 186, fourth: 190}


        def macos_app_header_matches(prefix: darray[u8], magic: MachOMagicBytes) -> bool:
            return prefix[0] == magic.first and prefix[1] == magic.second and prefix[2] == magic.third and prefix[3] == magic.fourth
