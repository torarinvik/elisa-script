# Typed executable discovery contract for shell-free process invocation.
#
# The host adapter performs PATH lookup and permission/stat calls, then submits
# bounded candidate observations. The typed process layer receives a selected
# executable path or a distinct Missing result; a Path is never silently used
# as an Executable.

module EsExecutable:
    public:
        const module Limits:
            NAME_BYTES: usize = 4096
            PATH_ENTRIES: usize = 4096
            CANDIDATES: usize = 4096
            PATH_BYTES: usize = 4096


        const enum ExecutableDiscoveryState of u8:
            Planned
            Searching
            Found
            Missing
            Failed
            Cancelled


        const enum ExecutableDiscoveryEvent of u8:
            Begin
            Candidate
            Missing
            Fail
            Cancel


        struct ExecutableDiscoveryPolicy:
            max_path_entries: usize = Limits::PATH_ENTRIES
            max_candidates: usize = Limits::CANDIDATES
            allow_empty_path_entry: bool = false


        struct ExecutableDiscoveryRequest:
            name: sview
            path_entries: darray[sview] = []
            policy: ExecutableDiscoveryPolicy


        struct ExecutableCandidate:
            path: sview
            path_index: usize
            regular_file: bool = false
            executable: bool = false


        struct Executable:
            path: sview
            path_index: usize


        struct ExecutableDiscoverySession:
            request: ExecutableDiscoveryRequest
            state: ExecutableDiscoveryState = ExecutableDiscoveryState.Planned
            examined_candidates: usize = 0
            selected: Executable = Executable{path: "", path_index: 0}


        error ExecutableDiscoveryError:
            InvalidState
            InvalidEvent
            InvalidPolicy
            InvalidName
            EmbeddedNul
            PathLimitExceeded
            CandidateLimitExceeded
            CandidateOrderInvalid
            CandidateInvalid
            MissingNotReady
            ResultNotReady
            CancelNotReady


    private:
        def executable_discovery_state_valid(state: ExecutableDiscoveryState) -> bool:
            return state in {ExecutableDiscoveryState.Planned, ExecutableDiscoveryState.Searching, ExecutableDiscoveryState.Found, ExecutableDiscoveryState.Missing, ExecutableDiscoveryState.Failed, ExecutableDiscoveryState.Cancelled}


        def executable_discovery_event_valid(event: ExecutableDiscoveryEvent) -> bool:
            return event in {ExecutableDiscoveryEvent.Begin, ExecutableDiscoveryEvent.Candidate, ExecutableDiscoveryEvent.Missing, ExecutableDiscoveryEvent.Fail, ExecutableDiscoveryEvent.Cancel}


        def executable_discovery_policy_valid(policy: ExecutableDiscoveryPolicy) -> bool:
            return policy.max_path_entries != 0 and policy.max_path_entries <= Limits::PATH_ENTRIES and policy.max_candidates != 0 and policy.max_candidates <= Limits::CANDIDATES


        def executable_discovery_text_valid(value: sview, limit: usize, allow_empty: bool) -> bool:
            return (allow_empty or value != "") and sview_len(value) < limit and not sview_contains_byte(value, 0)


        def executable_discovery_request_valid(request: ExecutableDiscoveryRequest) -> bool error[ExecutableDiscoveryError]:
            raise ExecutableDiscoveryError.InvalidPolicy if not executable_discovery_policy_valid(request.policy)
            raise ExecutableDiscoveryError.InvalidName if not executable_discovery_text_valid(request.name, Limits::NAME_BYTES, false)
            raise ExecutableDiscoveryError.InvalidName if request.name == "." or request.name == ".."
            raise ExecutableDiscoveryError.PathLimitExceeded if request.path_entries.count > request.policy.max_path_entries
            for path in request.path_entries:
                raise ExecutableDiscoveryError.EmbeddedNul if sview_contains_byte(path, 0)
                raise ExecutableDiscoveryError.PathLimitExceeded if not executable_discovery_text_valid(path, Limits::PATH_BYTES, request.policy.allow_empty_path_entry)
            return true


        def executable_candidate_valid(candidate: ExecutableCandidate) -> bool:
            return executable_discovery_text_valid(candidate.path, Limits::PATH_BYTES, false)


        # The host may observe candidates in any representation, but the submitted path
        # must still be the exact PATH-entry/name pair it claims to represent. Preserve an
        # empty PATH entry as the current-directory spelling (`name`) and avoid adding a
        # second separator when an entry already ends in `/`. Compare borrowed views in
        # place so forged paths are rejected without constructing an unbounded temporary.
        def executable_candidate_path_matches(request: ExecutableDiscoveryRequest, candidate_path: sview, path_index: usize) -> bool:
            return false if path_index >= request.path_entries.count
            entry: sview = request.path_entries[path_index]
            entry_length: usize = sview_len(entry)
            name_length: usize = sview_len(request.name)
            separator_bytes: usize = 0
            if entry_length != 0 and sview_at(entry, entry_length - 1) != 47:
                separator_bytes <- 1
            expected_length: usize = entry_length + separator_bytes + name_length
            return false if expected_length >= Limits::PATH_BYTES or sview_len(candidate_path) != expected_length
            for offset in 0..<entry_length |entry, candidate_path|:
                return false if sview_at(entry, offset) != sview_at(candidate_path, offset)
            candidate_name_start: usize = entry_length + separator_bytes
            if separator_bytes != 0:
                return false if sview_at(candidate_path, entry_length) != 47
            for offset in 0..<name_length |request, candidate_path, candidate_name_start|:
                return false if sview_at(request.name, offset) != sview_at(candidate_path, candidate_name_start + offset)
            return true


    public:
        def validate_executable_discovery(session: ExecutableDiscoverySession&) -> bool error[ExecutableDiscoveryError]:
            raise ExecutableDiscoveryError.InvalidState if not executable_discovery_state_valid(session.state)
            try executable_discovery_request_valid(session.request)
            raise ExecutableDiscoveryError.CandidateLimitExceeded if session.examined_candidates > session.request.policy.max_candidates
            raise ExecutableDiscoveryError.CandidateInvalid if session.state == ExecutableDiscoveryState.Planned and (session.examined_candidates != 0 or session.selected.path != "")
            raise ExecutableDiscoveryError.CandidateInvalid if (session.state == ExecutableDiscoveryState.Searching or session.state == ExecutableDiscoveryState.Failed or session.state == ExecutableDiscoveryState.Cancelled) and session.selected.path != ""
            raise ExecutableDiscoveryError.CandidateInvalid if session.state == ExecutableDiscoveryState.Found and (session.selected.path == "" or session.selected.path_index >= session.examined_candidates)
            raise ExecutableDiscoveryError.CandidateInvalid if session.state == ExecutableDiscoveryState.Missing and session.selected.path != ""
            raise ExecutableDiscoveryError.MissingNotReady if session.state == ExecutableDiscoveryState.Missing and session.examined_candidates != session.request.path_entries.count
            raise ExecutableDiscoveryError.CandidateInvalid if session.selected.path != "" and not executable_discovery_text_valid(session.selected.path, Limits::PATH_BYTES, false)
            raise ExecutableDiscoveryError.CandidateInvalid if session.selected.path != "" and not executable_candidate_path_matches(session.request, session.selected.path, session.selected.path_index)
            return true


        def executable_discovery_result(session: ExecutableDiscoverySession&) -> Executable error[ExecutableDiscoveryError]:
            try validate_executable_discovery(session)
            raise ExecutableDiscoveryError.ResultNotReady if session.state != ExecutableDiscoveryState.Found
            return session.selected


        def advance_executable_discovery(session: mutable ExecutableDiscoverySession&, event: ExecutableDiscoveryEvent, candidate: ExecutableCandidate = ExecutableCandidate{path: "", path_index: 0}) -> ExecutableDiscoveryState error[ExecutableDiscoveryError]:
            try validate_executable_discovery(session)
            raise ExecutableDiscoveryError.InvalidEvent if not executable_discovery_event_valid(event)
            if event == ExecutableDiscoveryEvent.Begin:
                raise ExecutableDiscoveryError.InvalidState if session.state != ExecutableDiscoveryState.Planned
                session.state <- ExecutableDiscoveryState.Searching
            elif event == ExecutableDiscoveryEvent.Candidate:
                raise ExecutableDiscoveryError.InvalidState if session.state != ExecutableDiscoveryState.Searching
                raise ExecutableDiscoveryError.CandidateLimitExceeded if session.examined_candidates >= session.request.policy.max_candidates
                raise ExecutableDiscoveryError.CandidateOrderInvalid if candidate.path_index != session.examined_candidates
                raise ExecutableDiscoveryError.CandidateOrderInvalid if candidate.path_index >= session.request.path_entries.count
                raise ExecutableDiscoveryError.CandidateInvalid if not executable_candidate_valid(candidate)
                raise ExecutableDiscoveryError.CandidateInvalid if not executable_candidate_path_matches(session.request, candidate.path, candidate.path_index)
                session.examined_candidates <- session.examined_candidates + 1
                if candidate.regular_file and candidate.executable:
                    session.selected <- Executable{path: candidate.path, path_index: candidate.path_index}
                    session.state <- ExecutableDiscoveryState.Found
            elif event == ExecutableDiscoveryEvent.Missing:
                raise ExecutableDiscoveryError.MissingNotReady if session.state != ExecutableDiscoveryState.Searching or session.examined_candidates != session.request.path_entries.count
                session.state <- ExecutableDiscoveryState.Missing
            elif event == ExecutableDiscoveryEvent.Fail:
                raise ExecutableDiscoveryError.InvalidState if session.state != ExecutableDiscoveryState.Searching
                session.state <- ExecutableDiscoveryState.Failed
            elif event == ExecutableDiscoveryEvent.Cancel:
                raise ExecutableDiscoveryError.CancelNotReady if session.state != ExecutableDiscoveryState.Planned and session.state != ExecutableDiscoveryState.Searching
                session.state <- ExecutableDiscoveryState.Cancelled
            return session.state
