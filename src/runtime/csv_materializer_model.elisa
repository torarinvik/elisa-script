# Typed CSV/TSV field materialization boundary.
#
# This layer owns bounded source slices and record layout. Its policy-bound
# validation checks that imported spans really partition complete CSV fields
# and records; quote unescaping and typed schema conversion remain separate.

module EsCsvMaterialize:
    using EsData

    public:
        const CSV_MATERIALIZER_MAX_FIELDS: usize = DATA_MAX_FIELDS
        const CSV_MATERIALIZER_MAX_RECORDS: usize = DATA_MAX_RECORDS


        const enum CsvMaterializerState of u8:
            Ready
            Building
            Complete
            Failed
            Cancelled


        const enum CsvMaterializerEvent of u8:
            Begin
            Field
            Record
            End
            Fail
            Cancel


        struct CsvFieldSpan:
            start: usize
            end: usize
            quoted: bool = false


        struct CsvRecordSpan:
            first_field: usize
            field_count: usize


        struct CsvMaterializer:
            source: sview
            policy: CsvPolicy = CsvPolicy{}
            state: CsvMaterializerState = CsvMaterializerState.Ready
            fields: darray[CsvFieldSpan] = []
            records: darray[CsvRecordSpan] = []
            next_field: usize = 0
            record_field_cursor: usize = 0
            source_bytes: usize = 0


        error CsvMaterializerError:
            InvalidState
            InvalidEvent
            SourceInvalid
            FieldLimitExceeded
            RecordLimitExceeded
            FieldIndexInvalid
            FieldRangeInvalid
            FieldOrderInvalid
            FieldLayoutInvalid
            RecordLayoutInvalid
            EmptyRecord
            RecordOrderInvalid
            SourceAccountingInvalid
            EndNotReady
            CancelNotReady


    private:
        const enum CsvSpanScanState of u8:
            Quoted
            Escaped


        def materializer_state_valid(state: CsvMaterializerState) -> bool:
            return state in {CsvMaterializerState.Ready, CsvMaterializerState.Building, CsvMaterializerState.Complete, CsvMaterializerState.Failed, CsvMaterializerState.Cancelled}


        def materializer_event_valid(event: CsvMaterializerEvent) -> bool:
            return event in {CsvMaterializerEvent.Begin, CsvMaterializerEvent.Field, CsvMaterializerEvent.Record, CsvMaterializerEvent.End, CsvMaterializerEvent.Fail, CsvMaterializerEvent.Cancel}


        def materializer_source_valid(source: sview) -> bool:
            return sview_len(source) <= DATA_MAX_INPUT_BYTES and not sview_contains_byte(source, 0)


        def materializer_field_range_valid(materializer: CsvMaterializer&, span: CsvFieldSpan) -> bool:
            return span.start <= span.end and span.end <= sview_len(materializer.source) and span.end - span.start <= DATA_MAX_FIELD_BYTES


        def materializer_raw_field_valid(materializer: CsvMaterializer&, span: CsvFieldSpan) -> bool:
            source_bytes: usize = sview_len(materializer.source)
            if not span.quoted:
                for offset in span.start..<span.end |materializer, span|:
                    byte: u8 = sview_at(materializer.source, offset)
                    return false if byte == materializer.policy.quote or byte == materializer.policy.separator or csv_policy_record_terminator_contains(materializer.policy, byte)
                return true
            return false if span.end - span.start < 2
            return false if sview_at(materializer.source, span.start) != materializer.policy.quote
            return false if sview_at(materializer.source, span.end - 1) != materializer.policy.quote
            scan_end: usize = span.end - 1
            offset: mutable usize = span.start + 1
            state: mutable CsvSpanScanState = CsvSpanScanState.Quoted
            while offset < scan_end:
                byte: u8 = sview_at(materializer.source, offset)
                if state == CsvSpanScanState.Escaped:
                    state <- CsvSpanScanState.Quoted
                elif materializer.policy.escape != materializer.policy.quote and byte == materializer.policy.escape:
                    state <- CsvSpanScanState.Escaped
                elif byte == materializer.policy.quote:
                    if materializer.policy.escape == materializer.policy.quote and offset + 1 < scan_end and sview_at(materializer.source, offset + 1) == materializer.policy.quote:
                        offset <- offset + 1
                    else:
                        return false
                offset <- offset + 1
            return state == CsvSpanScanState.Quoted and span.end <= source_bytes


        def materializer_record_terminator_at(materializer: CsvMaterializer&, offset: usize) -> usize:
            source_bytes: usize = sview_len(materializer.source)
            terminator_width: usize = csv_policy_record_terminator_width(materializer.policy)
            return 0 if offset > source_bytes
            return 0 if terminator_width > source_bytes - offset
            matched: mutable bool = true
            for byte_index in 0..<terminator_width |materializer, offset, matched|:
                matched <- false if sview_at(materializer.source, offset + byte_index) != csv_policy_record_terminator_byte(materializer.policy, byte_index)
            return terminator_width if matched else 0


        def materializer_complete_source_covered(materializer: CsvMaterializer&) -> bool:
            return sview_len(materializer.source) == 0 if materializer.records.count == 0
            last_record: CsvRecordSpan = materializer.records[materializer.records.count - 1]
            last_span: CsvFieldSpan = materializer.fields[last_record.first_field + last_record.field_count - 1]
            source_bytes: usize = sview_len(materializer.source)
            terminator_width: usize = csv_policy_record_terminator_width(materializer.policy)
            return true if last_span.end == source_bytes
            return last_span.end < source_bytes and source_bytes - last_span.end == terminator_width and materializer_record_terminator_at(materializer, last_span.end) == terminator_width


        def validate_csv_materializer_ledger(materializer: CsvMaterializer&, validate_cell_bytes: bool) -> bool error[DataContractError, CsvMaterializerError]:
            raise CsvMaterializerError.InvalidState if not materializer_state_valid(materializer.state)
            raise CsvMaterializerError.SourceInvalid if not materializer_source_valid(materializer.source)
            try validate_csv_policy(materializer.policy)
            raise CsvMaterializerError.FieldLimitExceeded if materializer.fields.count > CSV_MATERIALIZER_MAX_FIELDS
            raise CsvMaterializerError.RecordLimitExceeded if materializer.records.count > CSV_MATERIALIZER_MAX_RECORDS
            raise CsvMaterializerError.SourceAccountingInvalid if materializer.state == CsvMaterializerState.Ready and (materializer.fields.count != 0 or materializer.records.count != 0 or materializer.next_field != 0 or materializer.record_field_cursor != 0 or materializer.source_bytes != 0)
            raise CsvMaterializerError.SourceAccountingInvalid if materializer.state != CsvMaterializerState.Ready and materializer.source_bytes != sview_len(materializer.source)
            raise CsvMaterializerError.RecordOrderInvalid if materializer.next_field > materializer.fields.count
            raise CsvMaterializerError.RecordOrderInvalid if materializer.record_field_cursor > materializer.fields.count
            raise CsvMaterializerError.RecordOrderInvalid if materializer.next_field != materializer.fields.count
            accounted_record_fields: mutable usize = 0
            for index in 0..<materializer.fields.count |materializer|:
                span: CsvFieldSpan = materializer.fields[index]
                raise CsvMaterializerError.FieldRangeInvalid if not materializer_field_range_valid(materializer, span)
                raise CsvMaterializerError.FieldLayoutInvalid if validate_cell_bytes and not materializer_raw_field_valid(materializer, span)
                raise CsvMaterializerError.FieldOrderInvalid if index != 0 and span.start < materializer.fields[index - 1].end
            source_cursor: mutable usize = 0
            for record_index in 0..<materializer.records.count |materializer, accounted_record_fields, source_cursor|:
                record: CsvRecordSpan = materializer.records[record_index]
                raise CsvMaterializerError.EmptyRecord if record.field_count == 0
                raise CsvMaterializerError.RecordOrderInvalid if record.first_field > materializer.fields.count
                raise CsvMaterializerError.RecordOrderInvalid if record.field_count > materializer.fields.count - record.first_field
                raise CsvMaterializerError.RecordOrderInvalid if record.first_field != accounted_record_fields
                for record_offset in 0..<record.field_count |materializer, record, record_index, source_cursor|:
                    span: CsvFieldSpan = materializer.fields[record.first_field + record_offset]
                    raise CsvMaterializerError.RecordLayoutInvalid if span.start != source_cursor
                    if record_offset + 1 < record.field_count:
                        raise CsvMaterializerError.RecordLayoutInvalid if span.end >= sview_len(materializer.source)
                        raise CsvMaterializerError.RecordLayoutInvalid if sview_at(materializer.source, span.end) != materializer.policy.separator
                        source_cursor <- span.end + 1
                    elif span.end < sview_len(materializer.source):
                        terminator_width: usize = materializer_record_terminator_at(materializer, span.end)
                        raise CsvMaterializerError.RecordLayoutInvalid if terminator_width == 0
                        source_cursor <- span.end + terminator_width
                    else:
                        source_cursor <- span.end
                        raise CsvMaterializerError.RecordLayoutInvalid if record_index + 1 < materializer.records.count
                accounted_record_fields <- accounted_record_fields + record.field_count
            raise CsvMaterializerError.RecordOrderInvalid if accounted_record_fields != materializer.record_field_cursor
            raise CsvMaterializerError.EndNotReady if materializer.state == CsvMaterializerState.Complete and materializer.record_field_cursor != materializer.fields.count
            raise CsvMaterializerError.EndNotReady if materializer.state == CsvMaterializerState.Complete and materializer.records.count == 0 and sview_len(materializer.source) != 0
            raise CsvMaterializerError.RecordLayoutInvalid if materializer.state == CsvMaterializerState.Complete and source_cursor != sview_len(materializer.source)
            return true


    public:
        def validate_csv_materializer(materializer: CsvMaterializer&) -> bool error[DataContractError, CsvMaterializerError]:
            return validate_csv_materializer_ledger(materializer, true)


        def csv_materialized_field(materializer: CsvMaterializer&, field_index: usize) -> sview error[DataContractError, CsvMaterializerError]:
            try validate_csv_materializer(materializer)
            raise CsvMaterializerError.InvalidState if materializer.state != CsvMaterializerState.Building and materializer.state != CsvMaterializerState.Complete
            raise CsvMaterializerError.FieldIndexInvalid if field_index >= materializer.fields.count
            span: CsvFieldSpan = materializer.fields[field_index]
            return materializer.source[span.start:span.end]


        def advance_csv_materializer(materializer: mutable CsvMaterializer&, event: CsvMaterializerEvent, start: usize = 0, end: usize = 0, quoted: bool = false, first_field: usize = 0, field_count: usize = 0) -> CsvMaterializerState error[DataContractError, CsvMaterializerError]:
            raise CsvMaterializerError.InvalidEvent if not materializer_event_valid(event)
            if event == CsvMaterializerEvent.End:
                try validate_csv_materializer(materializer)
                raise CsvMaterializerError.EndNotReady if materializer.records.count == 0 and sview_len(materializer.source) != 0
                raise CsvMaterializerError.RecordLayoutInvalid if not materializer_complete_source_covered(materializer)
            else:
                try validate_csv_materializer_ledger(materializer, false)
            if event == CsvMaterializerEvent.Begin:
                raise CsvMaterializerError.InvalidState if materializer.state != CsvMaterializerState.Ready
                materializer.source_bytes <- sview_len(materializer.source)
                materializer.state <- CsvMaterializerState.Building
            elif event == CsvMaterializerEvent.Field:
                raise CsvMaterializerError.InvalidState if materializer.state != CsvMaterializerState.Building
                raise CsvMaterializerError.FieldLimitExceeded if materializer.fields.count >= CSV_MATERIALIZER_MAX_FIELDS
                span: CsvFieldSpan = CsvFieldSpan{start: start, end: end, quoted: quoted}
                raise CsvMaterializerError.FieldRangeInvalid if not materializer_field_range_valid(materializer, span)
                materializer.fields.push(span)
                materializer.next_field <- materializer.next_field + 1
            elif event == CsvMaterializerEvent.Record:
                raise CsvMaterializerError.InvalidState if materializer.state != CsvMaterializerState.Building
                raise CsvMaterializerError.RecordLimitExceeded if materializer.records.count >= CSV_MATERIALIZER_MAX_RECORDS
                raise CsvMaterializerError.EmptyRecord if field_count == 0
                raise CsvMaterializerError.RecordOrderInvalid if first_field != materializer.record_field_cursor
                raise CsvMaterializerError.RecordOrderInvalid if first_field > materializer.fields.count
                raise CsvMaterializerError.RecordOrderInvalid if field_count > materializer.fields.count - first_field
                materializer.records.push(CsvRecordSpan{first_field: first_field, field_count: field_count})
                materializer.record_field_cursor <- materializer.record_field_cursor + field_count
            elif event == CsvMaterializerEvent.End:
                raise CsvMaterializerError.EndNotReady if materializer.state != CsvMaterializerState.Building
                raise CsvMaterializerError.RecordOrderInvalid if materializer.record_field_cursor != materializer.fields.count
                raise CsvMaterializerError.EndNotReady if materializer.records.count == 0
                materializer.state <- CsvMaterializerState.Complete
            elif event == CsvMaterializerEvent.Fail:
                raise CsvMaterializerError.InvalidState if materializer.state != CsvMaterializerState.Building
                materializer.state <- CsvMaterializerState.Failed
            elif event == CsvMaterializerEvent.Cancel:
                raise CsvMaterializerError.CancelNotReady if materializer.state != CsvMaterializerState.Building
                materializer.state <- CsvMaterializerState.Cancelled
            return materializer.state
