# Parent-held spawn receipts. Pure data is not native PID ownership authority.
include "process_spawn_attempt_model.elisa"

module EsProcessSpawnOwner:
    public:
        const module Limits:
            ATTEMPTS: usize = 4096


        const enum State of u8:
            Fresh
            Reserved
            Running
            NoChild
            Unknown
            Reaped


        struct Owner:
            resource_id: u64 = 0
            owner_token: u64 = 0
            state: State = State.Fresh
            pid: i32 = 0
            diagnostic_pid: i32 = 0
            code: i32 = 0
            attempts: usize = 0
            saw_denied: bool = false
            # One-based observed attempts; zero means no denied candidate.
            # No path/view is borrowed, and capture cannot allocate or raise.
            first_denied_attempt: usize = 0
            last_denied_attempt: usize = 0


        error OwnerError:
            InvalidState
            WrongOwner
            WrongResourceKind
            ResourceNotAcquired


        def can_attempt(owner: Owner) -> bool:
            return owner.state == State.Reserved and owner.pid == 0 and owner.resource_id != 0 and owner.owner_token != 0 and owner.attempts < Limits::ATTEMPTS and denial_history_valid(owner)


        def denial_history_valid(owner: Owner&) -> bool:
            return false if owner.attempts > Limits::ATTEMPTS
            return owner.first_denied_attempt == 0 and owner.last_denied_attempt == 0 if not owner.saw_denied
            return owner.first_denied_attempt > 0 and owner.first_denied_attempt <= owner.last_denied_attempt and owner.last_denied_attempt <= owner.attempts


        # Called immediately after the native return. No error, allocation,
        # cleanup or ledger operation can hide a newly reported child PID.
        def observe(owner: mutable Owner&, attempt: EsProcessSpawnAttempt::Attempt) -> EsProcessSpawnAttempt::Decision:
            return EsProcessSpawnAttempt::Decision.StopUncertain if owner.state != State.Reserved or owner.pid != 0
            decision: EsProcessSpawnAttempt::Decision = EsProcessSpawnAttempt::decide(attempt)
            owner.diagnostic_pid <- attempt.pid
            owner.code <- attempt.code
            owner.attempts <- owner.attempts + 1 if owner.attempts < Limits::ATTEMPTS
            match decision:
                EsProcessSpawnAttempt::Decision.AdoptChild:
                    owner.pid <- attempt.pid
                    owner.state <- State.Running
                EsProcessSpawnAttempt::Decision.NextCandidate:
                    pass
                EsProcessSpawnAttempt::Decision.NextDenied:
                    owner.first_denied_attempt <- owner.attempts if not owner.saw_denied
                    owner.last_denied_attempt <- owner.attempts
                    owner.saw_denied <- true
                EsProcessSpawnAttempt::Decision.StopNoChild:
                    owner.state <- State.NoChild
                EsProcessSpawnAttempt::Decision.StopUncertain:
                    owner.state <- State.Unknown
            return decision


        def exhausted(owner: mutable Owner&) -> void:
            return if owner.state != State.Reserved or owner.pid != 0
            owner.state <- State.NoChild
            owner.code <- EsProcessExecSearch::DarwinErrno::EACCES if owner.saw_denied else EsProcessExecSearch::DarwinErrno::ENOENT


        def can_release_without_wait(owner: Owner) -> bool:
            return owner.state == State.NoChild and owner.pid == 0 and denial_history_valid(owner)


        # Only a private synchronous controller may use this after a typed
        # error BEFORE its next native attempt. Public fields are not proof.
        # Keep the last native error distinct from full PATH exhaustion.
        def stop_retrying_before_next_attempt(owner: mutable Owner&) -> bool:
            return false if not denial_history_valid(owner)
            return false if owner.state != State.Reserved or owner.pid != 0 or owner.diagnostic_pid != 0 or owner.resource_id == 0 or owner.owner_token == 0 or owner.attempts == 0 or owner.attempts > Limits::ATTEMPTS
            decision: EsProcessExecSearch::Action = EsProcessExecSearch::after_failure(owner.code)
            return false if decision != EsProcessExecSearch::Action.Next and decision != EsProcessExecSearch::Action.NextDenied
            owner.state <- State.NoChild
            return true


        # Pure metadata transition. Only the private host coordinator's fresh
        # exact-PID wait observation may supply these fields as real evidence.
        def record_reap(owner: mutable Owner&, reported_pid: i32, confirmed: bool) -> bool:
            return false if not confirmed or owner.state != State.Running or owner.pid <= 1 or reported_pid != owner.pid
            owner.state <- State.Reaped
            return true
