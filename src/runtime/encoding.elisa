# Shared strict UTF-8 validation for source and streaming text boundaries.
#
# The cursor is deliberately a small typed state object. Callers may carry it
# across host chunks, but no function here allocates or exposes a raw decoder
# pointer. Bytes mode remains available to adapters whose contract is binary.

module EsEncoding:
    public:
        struct Utf8Cursor:
            remaining: u8 = 0
            lower: u8 = 128
            upper: u8 = 191


        def utf8_feed(byte: u8, cursor: mutable Utf8Cursor&) -> bool:
            if cursor.remaining == 0:
                return true if byte <= 127
                if byte >= 194 and byte <= 223:
                    cursor.remaining <- 1
                    cursor.lower <- 128
                    cursor.upper <- 191
                    return true
                if byte == 224:
                    cursor.remaining <- 2
                    cursor.lower <- 160
                    cursor.upper <- 191
                    return true
                if byte >= 225 and byte <= 236 or byte >= 238 and byte <= 239:
                    cursor.remaining <- 2
                    cursor.lower <- 128
                    cursor.upper <- 191
                    return true
                if byte == 237:
                    cursor.remaining <- 2
                    cursor.lower <- 128
                    cursor.upper <- 159
                    return true
                if byte == 240:
                    cursor.remaining <- 3
                    cursor.lower <- 144
                    cursor.upper <- 191
                    return true
                if byte >= 241 and byte <= 243:
                    cursor.remaining <- 3
                    cursor.lower <- 128
                    cursor.upper <- 191
                    return true
                if byte == 244:
                    cursor.remaining <- 3
                    cursor.lower <- 128
                    cursor.upper <- 143
                    return true
                return false
            return false if byte < cursor.lower or byte > cursor.upper
            cursor.remaining <- cursor.remaining - 1
            cursor.lower <- 128
            cursor.upper <- 191
            return true


        def utf8_validate(buffer: u8&, count: usize, cursor: mutable Utf8Cursor&) -> bool:
            for index in 0..<count |buffer, cursor|:
                return false if not utf8_feed(buffer[index], cursor)
            return true


        def utf8_complete(cursor: Utf8Cursor&) -> bool:
            return cursor.remaining == 0
