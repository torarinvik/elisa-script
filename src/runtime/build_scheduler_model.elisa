# Deterministic build-graph scheduler contract.
#
# `EsBuild` describes nodes and dependencies; this module describes the
# scheduler that may dispatch them. Readiness is derived from completed
# dependency states, cache identity is an exact fingerprint match, and every
# mutation is bounded by the graph's declared parallelism.

module EsBuildScheduler:
    using EsBuild
    using EsBuildIncremental
    using EsBuildIncrementalGraph
    using EsBuildRecipeSignature

    public:
        const module Limits:
            CACHE_ENTRIES: usize = EsBuild::Limits::NODES


        const enum BuildSchedulerState of u8:
            Ready
            Running
            Failing
            Cancelling
            Complete
            Failed
            Cancelled


        const enum BuildSchedulerEvent of u8:
            Begin
            Refresh
            Dispatch
            CacheHit
            NodeComplete
            NodeFail
            Complete
            Cancel
            # Host confirms all active children stopped/reaped. In Failing this
            # drains the latched failure and still finishes as Failed.
            CancelAck


        struct BuildCacheEntry:
            node_name: sview
            fingerprint: u64


        struct BuildScheduler:
            graph: BuildGraph
            cache: darray[BuildCacheEntry] = []
            ready_queue: darray[usize] = []
            state: BuildSchedulerState = BuildSchedulerState.Ready
            active_nodes: usize = 0
            completed_nodes: usize = 0
            cache_hits: usize = 0


        error BuildSchedulerError:
            InvalidState
            InvalidEvent
            CacheLimitExceeded
            CacheEntryInvalid
            DuplicateCacheEntry
            QueueLimitExceeded
            QueueEntryInvalid
            DuplicateQueueEntry
            QueueOrderInvalid
            NodeIndexInvalid
            NodeNotReady
            DependencyNotReady
            CacheMiss
            ActiveLimitExceeded
            NodeAccountingInvalid
            CompleteNotReady
            CancelNotReady
            IncrementalPlanInvalid
            IncrementalPlanMismatch


    private:
        const enum SchedulerNameOrder of u8:
            Before
            Equal
            After


        def scheduler_state_valid(state: BuildSchedulerState) -> bool:
            return state in {BuildSchedulerState.Ready, BuildSchedulerState.Running, BuildSchedulerState.Failing, BuildSchedulerState.Cancelling, BuildSchedulerState.Complete, BuildSchedulerState.Failed, BuildSchedulerState.Cancelled}


        def scheduler_event_valid(event: BuildSchedulerEvent) -> bool:
            return event in {BuildSchedulerEvent.Begin, BuildSchedulerEvent.Refresh, BuildSchedulerEvent.Dispatch, BuildSchedulerEvent.CacheHit, BuildSchedulerEvent.NodeComplete, BuildSchedulerEvent.NodeFail, BuildSchedulerEvent.Complete, BuildSchedulerEvent.Cancel, BuildSchedulerEvent.CancelAck}


        def scheduler_name_valid(name: sview) -> bool:
            return sview_len(name) != 0 and sview_len(name) < EsBuild::Limits::NAME_BYTES and not sview_contains_byte(name, 0)


        def scheduler_name_order(left: sview, right: sview) -> SchedulerNameOrder:
            left_length: usize = sview_len(left)
            right_length: usize = sview_len(right)
            common: usize = left_length if left_length < right_length else right_length
            for offset in 0..<common |left, right|:
                return SchedulerNameOrder.Before if sview_at(left, offset) < sview_at(right, offset)
                return SchedulerNameOrder.After if sview_at(left, offset) > sview_at(right, offset)
            return SchedulerNameOrder.Before if left_length < right_length
            return SchedulerNameOrder.After if left_length > right_length
            return SchedulerNameOrder.Equal


        def scheduler_node_index(scheduler: BuildScheduler&, name: sview) -> usize:
            if scheduler.graph.node_name_order.count == scheduler.graph.nodes.count:
                low: mutable usize = 0
                high: mutable usize = scheduler.graph.node_name_order.count
                while low < high:
                    middle: usize = low + (high - low) / 2
                    entry: BuildNodeNameIndex = scheduler.graph.node_name_order[middle]
                    name_order: SchedulerNameOrder = scheduler_name_order(entry.name, name)
                    return entry.node_index if name_order == SchedulerNameOrder.Equal
                    low <- middle + 1 if name_order == SchedulerNameOrder.Before
                    high <- middle if name_order == SchedulerNameOrder.After
                return scheduler.graph.nodes.count
            for index in 0..<scheduler.graph.nodes.count |scheduler, name|:
                return index if scheduler.graph.nodes[index].name == name
            return scheduler.graph.nodes.count


        def scheduler_queue_contains(scheduler: BuildScheduler&, node_index: usize) -> bool:
            for queued in scheduler.ready_queue:
                return true if queued == node_index
            return false


        def scheduler_dependency_ready(scheduler: BuildScheduler&, node_index: usize) -> bool error[BuildSchedulerError]:
            raise BuildSchedulerError.NodeIndexInvalid if node_index >= scheduler.graph.nodes.count
            for dependency_index in scheduler.graph.nodes[node_index].dependencies:
                return false if scheduler.graph.nodes[dependency_index].state != BuildNodeState.Succeeded
            return true


        def scheduler_cache_matches(scheduler: BuildScheduler&, node_index: usize) -> bool:
            for entry in scheduler.cache:
                if entry.node_name == scheduler.graph.nodes[node_index].name and entry.fingerprint == scheduler.graph.nodes[node_index].fingerprint:
                    return true
            return false


        def scheduler_refresh_ready(scheduler: mutable BuildScheduler&) -> bool error[BuildSchedulerError]:
            for index in 0..<scheduler.graph.nodes.count |scheduler|:
                node: BuildNode = scheduler.graph.nodes[index]
                if node.state == BuildNodeState.Planned and not scheduler_queue_contains(scheduler, index):
                    ready: bool = try scheduler_dependency_ready(scheduler, index)
                    if ready:
                        raise BuildSchedulerError.QueueLimitExceeded if scheduler.ready_queue.count >= EsBuild::Limits::NODES
                        scheduler.ready_queue.push(index)
            return true


        def scheduler_rebuild_ready(scheduler: mutable BuildScheduler&) -> bool error[BuildSchedulerError]:
            scheduler.ready_queue <- []
            return try scheduler_refresh_ready(scheduler)


    public:
        def validate_build_scheduler(scheduler: BuildScheduler&) -> bool error[BuildSchedulerError]:
            try validate_build_graph(scheduler.graph)
            raise BuildSchedulerError.InvalidState if not scheduler_state_valid(scheduler.state)
            raise BuildSchedulerError.CacheLimitExceeded if scheduler.cache.count > Limits::CACHE_ENTRIES
            raise BuildSchedulerError.QueueLimitExceeded if scheduler.ready_queue.count > EsBuild::Limits::NODES
            raise BuildSchedulerError.ActiveLimitExceeded if scheduler.active_nodes > scheduler.graph.max_parallel
            raise BuildSchedulerError.NodeAccountingInvalid if scheduler.completed_nodes > scheduler.graph.nodes.count
            raise BuildSchedulerError.NodeAccountingInvalid if scheduler.cache_hits > scheduler.completed_nodes
            raise BuildSchedulerError.NodeAccountingInvalid if scheduler.active_nodes > scheduler.graph.nodes.count - scheduler.completed_nodes
            raise BuildSchedulerError.NodeAccountingInvalid if scheduler.active_nodes != scheduler.graph.active_nodes or scheduler.completed_nodes != scheduler.graph.completed_nodes
            if scheduler.state == BuildSchedulerState.Ready:
                raise BuildSchedulerError.NodeAccountingInvalid if scheduler.graph.state != BuildGraphState.Planned or scheduler.active_nodes != 0 or scheduler.completed_nodes != 0 or scheduler.cache_hits != 0
            elif scheduler.state == BuildSchedulerState.Running:
                raise BuildSchedulerError.NodeAccountingInvalid if scheduler.graph.state != BuildGraphState.Running and scheduler.graph.state != BuildGraphState.Succeeded
            elif scheduler.state == BuildSchedulerState.Failing:
                raise BuildSchedulerError.NodeAccountingInvalid if scheduler.graph.state != BuildGraphState.Failing or scheduler.active_nodes == 0 or scheduler.ready_queue.count != 0
            elif scheduler.state == BuildSchedulerState.Cancelling:
                raise BuildSchedulerError.NodeAccountingInvalid if scheduler.graph.state != BuildGraphState.Cancelling
            elif scheduler.state == BuildSchedulerState.Complete:
                raise BuildSchedulerError.NodeAccountingInvalid if scheduler.graph.state != BuildGraphState.Succeeded
            elif scheduler.state == BuildSchedulerState.Failed:
                raise BuildSchedulerError.NodeAccountingInvalid if scheduler.graph.state != BuildGraphState.Failed
                raise BuildSchedulerError.NodeAccountingInvalid if scheduler.active_nodes != 0 or scheduler.graph.active_nodes != 0 or scheduler.completed_nodes != scheduler.graph.nodes.count or scheduler.graph.completed_nodes != scheduler.graph.nodes.count or scheduler.ready_queue.count != 0
            elif scheduler.state == BuildSchedulerState.Cancelled:
                raise BuildSchedulerError.NodeAccountingInvalid if scheduler.graph.state != BuildGraphState.Cancelled
                raise BuildSchedulerError.NodeAccountingInvalid if scheduler.graph.completed_nodes != scheduler.graph.nodes.count or scheduler.ready_queue.count != 0
            for index in 0..<scheduler.cache.count |scheduler|:
                entry: BuildCacheEntry = scheduler.cache[index]
                raise BuildSchedulerError.CacheEntryInvalid if not scheduler_name_valid(entry.node_name) or entry.fingerprint == 0 or scheduler_node_index(scheduler, entry.node_name) == scheduler.graph.nodes.count
                for earlier in 0..<index |scheduler, entry|:
                    raise BuildSchedulerError.DuplicateCacheEntry if scheduler.cache[earlier].node_name == entry.node_name
            for index in 0..<scheduler.ready_queue.count |scheduler|:
                queued: usize = scheduler.ready_queue[index]
                raise BuildSchedulerError.QueueEntryInvalid if queued >= scheduler.graph.nodes.count or scheduler.graph.nodes[queued].state != BuildNodeState.Planned
                ready: bool = try scheduler_dependency_ready(scheduler, queued)
                raise BuildSchedulerError.DependencyNotReady if not ready
                # `scheduler_refresh_ready` emits node indices in ascending
                # graph order. Preserve that order at the public boundary so
                # a forged or host-reordered queue cannot change which ready
                # target is dispatched first.
                raise BuildSchedulerError.QueueOrderInvalid if index > 0 and scheduler.ready_queue[index - 1] > queued
                for earlier in 0..<index |scheduler, queued|:
                    raise BuildSchedulerError.DuplicateQueueEntry if scheduler.ready_queue[earlier] == queued
            raise BuildSchedulerError.NodeAccountingInvalid if scheduler.state == BuildSchedulerState.Ready and scheduler.ready_queue.count != 0
            return true


    private:
        # Apply a planner result before Begin. A cache entry is retained only
        # when the corresponding current recipe is proven UpToDate and both
        # target name and recipe fingerprint align with the graph. Build this
        # filtered cache locally so any validation failure leaves the scheduler
        # byte-for-byte unchanged. A missing cache entry remains a safe miss.
        def scheduler_admit_verified_incremental_plan(scheduler: mutable BuildScheduler&, plan: BuildIncrementalPlan) -> bool error[BuildSchedulerError, BuildContractError] can[Memory.Allocate, Abort.Panic]:
            try validate_build_scheduler(scheduler)
            raise BuildSchedulerError.InvalidState if scheduler.state != BuildSchedulerState.Ready
            raise BuildSchedulerError.IncrementalPlanInvalid if plan.decisions.count != scheduler.graph.nodes.count
            raise BuildSchedulerError.IncrementalPlanInvalid if plan.target_names.count != scheduler.graph.nodes.count or plan.recipe_fingerprints.count != scheduler.graph.nodes.count or plan.recipe_signatures.count != scheduler.graph.nodes.count
            raise BuildSchedulerError.IncrementalPlanInvalid if plan.rebuild_target_indices.count > scheduler.graph.nodes.count
            rebuild_position: mutable usize = 0
            for index in 0..<scheduler.graph.nodes.count |scheduler, plan, rebuild_position|:
                decision: BuildIncrementalDecision = plan.decisions[index]
                raise BuildSchedulerError.IncrementalPlanInvalid if decision not in {BuildIncrementalDecision.UpToDate, BuildIncrementalDecision.RecipeChanged, BuildIncrementalDecision.DependencyMissing, BuildIncrementalDecision.DependencyDirty, BuildIncrementalDecision.ObservationMissing, BuildIncrementalDecision.InputMissing, BuildIncrementalDecision.InputChanged, BuildIncrementalDecision.OutputMissing, BuildIncrementalDecision.OutputChanged}
                raise BuildSchedulerError.IncrementalPlanMismatch if plan.target_names[index] != scheduler.graph.nodes[index].name or plan.recipe_fingerprints[index] != scheduler.graph.nodes[index].fingerprint or plan.recipe_signatures[index] != scheduler.graph.nodes[index].recipe_signature
                raise BuildSchedulerError.IncrementalPlanInvalid if plan.recipe_fingerprints[index] == 0
                raise BuildSchedulerError.IncrementalPlanInvalid if not build_recipe_signature_valid(plan.recipe_signatures[index])
                if decision != BuildIncrementalDecision.UpToDate:
                    raise BuildSchedulerError.IncrementalPlanInvalid if rebuild_position >= plan.rebuild_target_indices.count or plan.rebuild_target_indices[rebuild_position] != index
                    rebuild_position <- rebuild_position + 1
            raise BuildSchedulerError.IncrementalPlanInvalid if rebuild_position != plan.rebuild_target_indices.count

            admitted_cache: mutable darray[BuildCacheEntry] = []
            for entry in scheduler.cache |scheduler, plan, admitted_cache|:
                target_index: usize = scheduler_node_index(scheduler, entry.node_name)
                raise BuildSchedulerError.IncrementalPlanMismatch if target_index == scheduler.graph.nodes.count
                if plan.decisions[target_index] == BuildIncrementalDecision.UpToDate and entry.fingerprint == plan.recipe_fingerprints[target_index]:
                    admitted_cache.push(entry)
            scheduler.cache <- admitted_cache
            return true


    public:
        # Public cache admission always derives the plan from the validated
        # graph, signed recipes, previous manifest, and complete observations.
        # A caller cannot submit a hand-constructed UpToDate decision vector.
        def admit_build_incremental_graph(scheduler: mutable BuildScheduler&, previous_targets: darray[BuildIncrementalTarget], current_recipes: darray[BuildIncrementalRecipeTarget], observations: darray[BuildIncrementalObservation]) -> BuildIncrementalPlan error[BuildSchedulerError, BuildContractError, BuildIncrementalError, BuildRecipeSignatureError] can[Memory.Allocate, Abort.Panic]:
            try validate_build_scheduler(scheduler)
            raise BuildSchedulerError.InvalidState if scheduler.state != BuildSchedulerState.Ready
            plan: BuildIncrementalPlan = try plan_build_incremental_graph_transition(previous_targets, scheduler.graph, current_recipes, observations)
            _ = try scheduler_admit_verified_incremental_plan(scheduler, plan)
            return plan


        def advance_build_scheduler(scheduler: mutable BuildScheduler&, event: BuildSchedulerEvent, node_index: usize = 0) -> BuildSchedulerState error[BuildSchedulerError]:
            try validate_build_scheduler(scheduler)
            raise BuildSchedulerError.InvalidEvent if not scheduler_event_valid(event)
            if event == BuildSchedulerEvent.Begin:
                raise BuildSchedulerError.InvalidState if scheduler.state != BuildSchedulerState.Ready
                scheduler.state <- BuildSchedulerState.Running
                scheduler.graph.state <- BuildGraphState.Running
                try scheduler_rebuild_ready(scheduler)
            elif event == BuildSchedulerEvent.Refresh:
                raise BuildSchedulerError.InvalidState if scheduler.state != BuildSchedulerState.Running
                try scheduler_rebuild_ready(scheduler)
            elif event == BuildSchedulerEvent.Dispatch:
                raise BuildSchedulerError.InvalidState if scheduler.state != BuildSchedulerState.Running
                raise BuildSchedulerError.NodeIndexInvalid if node_index >= scheduler.graph.nodes.count
                raise BuildSchedulerError.ActiveLimitExceeded if scheduler.active_nodes >= scheduler.graph.max_parallel
                raise BuildSchedulerError.NodeNotReady if scheduler.graph.nodes[node_index].state != BuildNodeState.Planned or not scheduler_queue_contains(scheduler, node_index)
                ready: bool = try scheduler_dependency_ready(scheduler, node_index)
                raise BuildSchedulerError.DependencyNotReady if not ready
                scheduler.graph.nodes[node_index].state <- BuildNodeState.Running
                scheduler.active_nodes <- scheduler.active_nodes + 1
                scheduler.graph.active_nodes <- scheduler.graph.active_nodes + 1
                try scheduler_rebuild_ready(scheduler)
            elif event == BuildSchedulerEvent.CacheHit:
                raise BuildSchedulerError.InvalidState if scheduler.state != BuildSchedulerState.Running
                raise BuildSchedulerError.NodeIndexInvalid if node_index >= scheduler.graph.nodes.count
                raise BuildSchedulerError.NodeNotReady if scheduler.graph.nodes[node_index].state != BuildNodeState.Planned
                raise BuildSchedulerError.NodeNotReady if not scheduler_queue_contains(scheduler, node_index)
                raise BuildSchedulerError.CacheMiss if not scheduler_cache_matches(scheduler, node_index)
                ready: bool = try scheduler_dependency_ready(scheduler, node_index)
                raise BuildSchedulerError.DependencyNotReady if not ready
                scheduler.graph.nodes[node_index].state <- BuildNodeState.Succeeded
                scheduler.completed_nodes <- scheduler.completed_nodes + 1
                scheduler.cache_hits <- scheduler.cache_hits + 1
                scheduler.graph.completed_nodes <- scheduler.graph.completed_nodes + 1
                scheduler.graph.state <- BuildGraphState.Succeeded if scheduler.graph.completed_nodes == scheduler.graph.nodes.count
                try scheduler_rebuild_ready(scheduler)
            elif event == BuildSchedulerEvent.NodeComplete or event == BuildSchedulerEvent.NodeFail:
                raise BuildSchedulerError.InvalidState if scheduler.state != BuildSchedulerState.Running and scheduler.state != BuildSchedulerState.Failing
                raise BuildSchedulerError.NodeIndexInvalid if node_index >= scheduler.graph.nodes.count
                raise BuildSchedulerError.NodeAccountingInvalid if scheduler.active_nodes == 0 or scheduler.graph.nodes[node_index].state != BuildNodeState.Running
                failure_in_progress: bool = scheduler.state == BuildSchedulerState.Failing or event == BuildSchedulerEvent.NodeFail
                scheduler.graph.nodes[node_index].state <- BuildNodeState.Succeeded if event == BuildSchedulerEvent.NodeComplete else BuildNodeState.Failed
                scheduler.active_nodes <- scheduler.active_nodes - 1
                scheduler.completed_nodes <- scheduler.completed_nodes + 1
                scheduler.graph.active_nodes <- scheduler.graph.active_nodes - 1
                scheduler.graph.completed_nodes <- scheduler.graph.completed_nodes + 1
                scheduler.graph.failed_nodes <- scheduler.graph.failed_nodes + 1 if event == BuildSchedulerEvent.NodeFail
                if event == BuildSchedulerEvent.NodeFail:
                    for index in 0..<scheduler.graph.nodes.count |scheduler|:
                        if scheduler.graph.nodes[index].state == BuildNodeState.Planned:
                            scheduler.graph.nodes[index].state <- BuildNodeState.Cancelled
                            scheduler.completed_nodes <- scheduler.completed_nodes + 1
                            scheduler.graph.completed_nodes <- scheduler.graph.completed_nodes + 1
                    scheduler.ready_queue <- []
                if failure_in_progress:
                    if scheduler.active_nodes == 0:
                        scheduler.graph.state <- BuildGraphState.Failed
                        scheduler.state <- BuildSchedulerState.Failed
                    else:
                        scheduler.graph.state <- BuildGraphState.Failing
                        scheduler.state <- BuildSchedulerState.Failing
                else:
                    scheduler.graph.state <- BuildGraphState.Succeeded if scheduler.graph.completed_nodes == scheduler.graph.nodes.count
                    try scheduler_rebuild_ready(scheduler)
            elif event == BuildSchedulerEvent.Complete:
                raise BuildSchedulerError.CompleteNotReady if scheduler.state != BuildSchedulerState.Running or scheduler.active_nodes != 0 or scheduler.completed_nodes != scheduler.graph.nodes.count
                scheduler.state <- BuildSchedulerState.Complete
            elif event == BuildSchedulerEvent.Cancel:
                if scheduler.state == BuildSchedulerState.Ready:
                    # A scheduler that has not begun must still honor a
                    # cancellation request.  This mirrors EsBuild's planned
                    # cancellation edge and prevents a host abort from
                    # forcing an unnecessary Begin/Cancel round trip.
                    for index in 0..<scheduler.graph.nodes.count |scheduler|:
                        if scheduler.graph.nodes[index].state == BuildNodeState.Planned:
                            scheduler.graph.nodes[index].state <- BuildNodeState.Cancelled
                            scheduler.completed_nodes <- scheduler.completed_nodes + 1
                            scheduler.graph.completed_nodes <- scheduler.graph.completed_nodes + 1
                    scheduler.ready_queue <- []
                    scheduler.state <- BuildSchedulerState.Cancelled
                    scheduler.graph.state <- BuildGraphState.Cancelled
                else:
                    raise BuildSchedulerError.CancelNotReady if scheduler.state != BuildSchedulerState.Running
                    raise BuildSchedulerError.CancelNotReady if scheduler.graph.state == BuildGraphState.Succeeded or scheduler.completed_nodes == scheduler.graph.nodes.count
                    scheduler.state <- BuildSchedulerState.Cancelling
                    scheduler.graph.state <- BuildGraphState.Cancelling
            elif event == BuildSchedulerEvent.CancelAck:
                raise BuildSchedulerError.CancelNotReady if scheduler.state != BuildSchedulerState.Cancelling and scheduler.state != BuildSchedulerState.Failing
                ack_failure: bool = scheduler.state == BuildSchedulerState.Failing
                for index in 0..<scheduler.graph.nodes.count |scheduler|:
                    if scheduler.graph.nodes[index].state == BuildNodeState.Running:
                        scheduler.graph.nodes[index].state <- BuildNodeState.Cancelled
                        scheduler.active_nodes <- scheduler.active_nodes - 1
                        scheduler.graph.active_nodes <- scheduler.graph.active_nodes - 1
                        scheduler.completed_nodes <- scheduler.completed_nodes + 1
                        scheduler.graph.completed_nodes <- scheduler.graph.completed_nodes + 1
                    elif scheduler.graph.nodes[index].state == BuildNodeState.Planned:
                        scheduler.graph.nodes[index].state <- BuildNodeState.Cancelled
                        scheduler.completed_nodes <- scheduler.completed_nodes + 1
                        scheduler.graph.completed_nodes <- scheduler.graph.completed_nodes + 1
                scheduler.ready_queue <- []
                scheduler.state <- BuildSchedulerState.Failed if ack_failure else BuildSchedulerState.Cancelled
                scheduler.graph.state <- BuildGraphState.Failed if ack_failure else BuildGraphState.Cancelled
            return scheduler.state
