# Iterative JSON grammar parser and owned-document materializer.
#
# The parser consumes the lossless byte lexer directly. It never routes number
# spellings or source ranges through the vendored floating-point JSON DOM.

module EsJsonParse:
    using EsData
    using EsJson
    using EsJsonLex

    public:
        const JSON_PARSE_MAX_FRAMES: usize = DATA_MAX_DEPTH


        error JsonParseError:
            EmptyInput
            UnexpectedToken(offset: usize)
            ExpectedObjectKey(offset: usize)
            ExpectedColon(offset: usize)
            ExpectedValue(offset: usize)
            ExpectedCommaOrEnd(offset: usize)
            NonStringObjectKey(offset: usize)
            TrailingComma(offset: usize)
            MultipleRoots(offset: usize)
            UnterminatedContainer(offset: usize)
            FrameLimitExceeded(offset: usize)


    private:
        const enum JsonParseFrameKind of u8:
            Array
            Object


        const enum JsonParsePhase of u8:
            ArrayFirstValueOrEnd
            ArrayValue
            ArrayCommaOrEnd
            ObjectFirstKeyOrEnd
            ObjectKey
            ObjectColon
            ObjectValue
            ObjectCommaOrEnd


        struct JsonParsePendingMember:
            key_start: usize
            key_bytes: usize
            key_range: JsonRange
            value_index: usize


        const enum JsonParseKeyOrder of u8:
            Before
            Equal
            After


        struct JsonParseFrame:
            kind: JsonParseFrameKind
            phase: JsonParsePhase
            open_start: usize
            depth: usize
            key_start: usize = 0
            key_bytes: usize = 0
            key_range: JsonRange = JsonRange{}
            children: darray[usize] = []
            members: darray[JsonParsePendingMember] = []


        def json_parse_value_kind(kind: JsonLexemeKind) -> bool:
            return kind in {JsonLexemeKind.String, JsonLexemeKind.Number, JsonLexemeKind.True, JsonLexemeKind.False, JsonLexemeKind.Null, JsonLexemeKind.ArrayOpen, JsonLexemeKind.ObjectOpen}


        def json_parse_scalar_kind(kind: JsonLexemeKind) -> bool:
            return kind in {JsonLexemeKind.String, JsonLexemeKind.Number, JsonLexemeKind.True, JsonLexemeKind.False, JsonLexemeKind.Null}


        def json_parse_pending_key_order(decoded: darray[u8], members: darray[JsonParsePendingMember], left_index: usize, right_index: usize) -> JsonParseKeyOrder:
            left: JsonParsePendingMember = members[left_index]
            right: JsonParsePendingMember = members[right_index]
            common_bytes: usize = left.key_bytes if left.key_bytes < right.key_bytes else right.key_bytes
            for offset in 0..<common_bytes |decoded, left, right|:
                left_byte: u8 = decoded[left.key_start + offset]
                right_byte: u8 = decoded[right.key_start + offset]
                return JsonParseKeyOrder.Before if left_byte < right_byte
                return JsonParseKeyOrder.After if left_byte > right_byte
            return JsonParseKeyOrder.Equal if left.key_bytes == right.key_bytes
            return JsonParseKeyOrder.Before if left.key_bytes < right.key_bytes
            return JsonParseKeyOrder.After


        def json_parse_sorted_pending_members(decoded: darray[u8], members: darray[JsonParsePendingMember]) -> darray[usize] can[Memory.Allocate, Abort.Panic]:
            order: mutable darray[usize] = []
            scratch: mutable darray[usize] = []
            for index in 0..<members.count |order, scratch|:
                order.push(index)
                scratch.push(index)
            width: mutable usize = 1
            while width < order.count:
                start: mutable usize = 0
                while start < order.count:
                    middle: mutable usize = start + width
                    middle <- order.count if middle > order.count
                    end: mutable usize = middle + width
                    end <- order.count if end > order.count
                    left: mutable usize = start
                    right: mutable usize = middle
                    destination: mutable usize = start
                    while destination < end:
                        if left == middle:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        elif right == end:
                            scratch[destination] <- order[left]
                            left <- left + 1
                        # Taking the left row on equal keys keeps the order
                        # stable, so duplicate groups retain source ordinals.
                        elif json_parse_pending_key_order(decoded, members, order[left], order[right]) != JsonParseKeyOrder.After:
                            scratch[destination] <- order[left]
                            left <- left + 1
                        else:
                            scratch[destination] <- order[right]
                            right <- right + 1
                        destination <- destination + 1
                    start <- end
                for index in 0..<order.count |order, scratch|:
                    order[index] <- scratch[index]
                width <- order.count if width > order.count / 2 else width * 2
            return order


        def json_parse_push_frame(frames: mutable darray[JsonParseFrame]&, kind: JsonParseFrameKind, token: JsonLexeme, depth: usize, limits: DataDecodeLimits) -> void error[JsonParseError] can[Memory.Allocate, Abort.Panic]:
            raise JsonParseError.FrameLimitExceeded(token.range.start) if frames.count >= limits.depth or frames.count >= JSON_PARSE_MAX_FRAMES
            phase: JsonParsePhase = JsonParsePhase.ArrayFirstValueOrEnd if kind == JsonParseFrameKind.Array else JsonParsePhase.ObjectFirstKeyOrEnd
            frames.push(JsonParseFrame{kind: kind, phase: phase, open_start: token.range.start, depth: depth})


        def json_parse_close_allowed(frame: JsonParseFrame, policy: JsonPolicy, offset: usize) -> bool error[JsonParseError]:
            if frame.kind == JsonParseFrameKind.Array:
                if frame.phase == JsonParsePhase.ArrayFirstValueOrEnd or frame.phase == JsonParsePhase.ArrayCommaOrEnd:
                    return true
                elif frame.phase == JsonParsePhase.ArrayValue:
                    raise JsonParseError.TrailingComma(offset) if policy.trailing_commas == JsonTrailingCommaPolicy.Reject
                    return true
                else:
                    raise JsonParseError.ExpectedValue(offset)
            else:
                if frame.phase == JsonParsePhase.ObjectFirstKeyOrEnd or frame.phase == JsonParsePhase.ObjectCommaOrEnd:
                    return true
                elif frame.phase == JsonParsePhase.ObjectKey:
                    raise JsonParseError.TrailingComma(offset) if policy.trailing_commas == JsonTrailingCommaPolicy.Reject
                    return true
                elif frame.phase == JsonParsePhase.ObjectColon:
                    raise JsonParseError.ExpectedColon(offset)
                elif frame.phase == JsonParsePhase.ObjectValue:
                    raise JsonParseError.ExpectedValue(offset)
                else:
                    raise JsonParseError.ExpectedObjectKey(offset)
            return false


        def json_parse_append_scalar(document: mutable JsonDocument&, lexed: JsonLexedSource&, token: JsonLexeme, depth: usize, source_view: sview, decoded_view: sview) -> usize error[JsonParseError, JsonContractError] can[Memory.Allocate, Abort.Panic]:
            node_kind: JsonNodeKind = JsonNodeKind.Null
            scalar_value: sview = ""
            bool_value: bool = false
            if token.kind == JsonLexemeKind.String:
                node_kind <- JsonNodeKind.Text
                decoded_end: usize = token.payload_start + token.payload_bytes
                scalar_value <- string_view_slice(decoded_view, token.payload_start.i64(), decoded_end.i64())
            elif token.kind == JsonLexemeKind.Number:
                node_kind <- JsonNodeKind.Number
                scalar_value <- string_view_slice(source_view, token.range.start.i64(), token.range.end.i64())
            elif token.kind == JsonLexemeKind.True:
                node_kind <- JsonNodeKind.Bool
                bool_value <- true
            elif token.kind == JsonLexemeKind.False:
                node_kind <- JsonNodeKind.Bool
            elif token.kind == JsonLexemeKind.Null:
                node_kind <- JsonNodeKind.Null
            else:
                raise JsonParseError.UnexpectedToken(token.range.start)
            scalar_bytes: usize = sview_len(scalar_value)
            raise JsonContractError.InvalidScalarBytes if scalar_bytes > lexed.limits.field_bytes
            raise JsonContractError.TokenLimitExceeded if document.token_count >= lexed.limits.tokens
            raise JsonContractError.NodeLimitExceeded if document.nodes.count >= JSON_MAX_NODES
            raise JsonContractError.InvalidScalarPayload if document.scalar_data.count > JSON_MAX_TOTAL_SCALAR_BYTES
            raise JsonContractError.InvalidScalarPayload if document.scalar_data.count > lexed.limits.input_bytes
            raise JsonContractError.InvalidScalarPayload if scalar_bytes > JSON_MAX_TOTAL_SCALAR_BYTES - document.scalar_data.count
            raise JsonContractError.InvalidScalarPayload if scalar_bytes > lexed.limits.input_bytes - document.scalar_data.count
            stored_node: mutable JsonNode = JsonNode{kind: node_kind, range: token.range, depth: depth, bool_value: bool_value}
            if node_kind == JsonNodeKind.Text or node_kind == JsonNodeKind.Number:
                if node_kind == JsonNodeKind.Number:
                    raise JsonContractError.InvalidScalarPayload if not json_number_lexeme_is_valid(scalar_value)
                stored_node.scalar_start <- document.scalar_data.count
                stored_node.scalar_bytes <- scalar_bytes
                for offset in 0..<scalar_bytes |document, scalar_value|:
                    document.scalar_data.push(sview_at(scalar_value, offset))
            document.nodes.push(stored_node)
            document.token_count <- document.token_count + 1
            document.max_depth <- depth if depth > document.max_depth
            return document.nodes.count - 1


        def json_parse_record_value(document: mutable JsonDocument&, frames: mutable darray[JsonParseFrame]&, value_index: usize, offset: usize) -> void error[JsonParseError, JsonContractError] can[Memory.Allocate, Abort.Panic]:
            if frames.count == 0:
                raise JsonParseError.MultipleRoots(offset) if document.roots.count != 0
                raise JsonContractError.RootLimitExceeded if document.roots.count >= document.limits.records
                root: mutable JsonNode = document.nodes[value_index]
                root.owner_kind <- JsonNodeOwnerKind.Root
                root.owner_index <- JSON_INDEX_NONE
                root.owner_ordinal <- document.roots.count
                document.nodes[value_index] <- root
                document.roots.push(value_index)
            else:
                frame_index: usize = frames.count - 1
                frame: mutable JsonParseFrame = frames[frame_index]
                if frame.kind == JsonParseFrameKind.Array:
                    raise JsonParseError.ExpectedValue(offset) if frame.phase != JsonParsePhase.ArrayFirstValueOrEnd and frame.phase != JsonParsePhase.ArrayValue
                    raise JsonParseError.FrameLimitExceeded(offset) if frame.children.count >= document.limits.tokens
                    frame.children.push(value_index)
                    frame.phase <- JsonParsePhase.ArrayCommaOrEnd
                else:
                    raise JsonParseError.ExpectedValue(offset) if frame.phase != JsonParsePhase.ObjectValue
                    raise JsonContractError.MemberLimitExceeded if frame.members.count >= document.limits.fields
                    raise JsonParseError.FrameLimitExceeded(offset) if frame.members.count >= document.limits.tokens
                    frame.members.push(JsonParsePendingMember{key_start: frame.key_start, key_bytes: frame.key_bytes, key_range: frame.key_range, value_index: value_index})
                    frame.phase <- JsonParsePhase.ObjectCommaOrEnd
                frames[frame_index] <- frame


        def json_parse_finish_container(document: mutable JsonDocument&, lexed: JsonLexedSource&, frames: mutable darray[JsonParseFrame]&, token: JsonLexeme) -> void error[JsonParseError, JsonContractError] can[Memory.Allocate, Abort.Panic]:
            raise JsonParseError.UnexpectedToken(token.range.start) if frames.count == 0
            frame_index: usize = frames.count - 1
            frame: JsonParseFrame = frames[frame_index]
            raise JsonParseError.UnexpectedToken(token.range.start) if frame.kind == JsonParseFrameKind.Array and token.kind != JsonLexemeKind.ArrayClose
            raise JsonParseError.UnexpectedToken(token.range.start) if frame.kind == JsonParseFrameKind.Object and token.kind != JsonLexemeKind.ObjectClose
            _ = try json_parse_close_allowed(frame, document.policy, token.range.start)
            container_kind: JsonNodeKind = JsonNodeKind.Array if frame.kind == JsonParseFrameKind.Array else JsonNodeKind.Object
            container_range: JsonRange = JsonRange{start: frame.open_start, end: token.range.end}
            pending_order: mutable darray[usize] = []
            retained: mutable darray[bool] = []
            selected_values: mutable darray[usize] = []
            pending_to_document: mutable darray[usize] = []
            retained_count: mutable usize = 0
            retained_key_bytes: mutable usize = 0
            order_cursor: mutable usize = 0
            if frame.kind == JsonParseFrameKind.Object:
                raise JsonContractError.InvalidScalarPayload if document.scalar_data.count > document.source_bytes
                raise JsonContractError.InvalidMemberKey if document.key_bytes.count > document.source_bytes - document.scalar_data.count
                raise JsonContractError.InvalidMemberKey if document.key_bytes.count > JSON_MAX_TOTAL_KEY_BYTES
                available_key_bytes: usize = document.source_bytes - document.scalar_data.count - document.key_bytes.count
                pending_order <- try json_parse_sorted_pending_members(lexed.decoded_data, frame.members)
                for pending_index in 0..<frame.members.count |frame, retained, selected_values, pending_to_document|:
                    retained.push(false)
                    selected_values.push(frame.members[pending_index].value_index)
                    pending_to_document.push(JSON_INDEX_NONE)
                while order_cursor < pending_order.count:
                    first_pending: usize = pending_order[order_cursor]
                    group_end: mutable usize = order_cursor + 1
                    while group_end < pending_order.count and json_parse_pending_key_order(lexed.decoded_data, frame.members, first_pending, pending_order[group_end]) == JsonParseKeyOrder.Equal:
                        group_end <- group_end + 1
                    raise JsonContractError.DuplicateObjectKey if group_end - order_cursor > 1 and document.policy.duplicate_keys == JsonDuplicateKeyPolicy.Reject
                    retained[first_pending] <- true
                    if document.policy.duplicate_keys == JsonDuplicateKeyPolicy.KeepLast:
                        last_pending: usize = pending_order[group_end - 1]
                        selected_values[first_pending] <- frame.members[last_pending].value_index
                    retained_count <- retained_count + 1
                    pending_key_bytes: usize = frame.members[first_pending].key_bytes
                    raise JsonContractError.InvalidMemberKey if retained_key_bytes > available_key_bytes
                    raise JsonContractError.InvalidMemberKey if pending_key_bytes > available_key_bytes - retained_key_bytes
                    raise JsonContractError.InvalidMemberKey if retained_key_bytes > JSON_MAX_TOTAL_KEY_BYTES
                    raise JsonContractError.InvalidMemberKey if pending_key_bytes > JSON_MAX_TOTAL_KEY_BYTES - retained_key_bytes
                    retained_key_bytes <- retained_key_bytes + pending_key_bytes
                    order_cursor <- group_end
                raise JsonContractError.NodeLimitExceeded if document.nodes.count >= JSON_MAX_NODES
                raise JsonContractError.TokenLimitExceeded if document.token_count >= lexed.limits.tokens
                raise JsonContractError.MemberLimitExceeded if document.members.count > document.limits.fields
                raise JsonContractError.MemberLimitExceeded if document.members.count > JSON_MAX_MEMBERS
                raise JsonContractError.MemberLimitExceeded if retained_count > document.limits.fields - document.members.count
                raise JsonContractError.MemberLimitExceeded if retained_count > JSON_MAX_MEMBERS - document.members.count
                raise JsonContractError.MemberLimitExceeded if document.member_key_order.count != document.members.count
                raise JsonContractError.InvalidMemberKey if retained_key_bytes > JSON_MAX_TOTAL_KEY_BYTES - document.key_bytes.count
                for pending_index in 0..<frame.members.count |frame, retained|:
                    if retained[pending_index]:
                        raise JsonContractError.InvalidMemberKey if frame.members[pending_index].key_bytes > document.limits.field_bytes
                        raise JsonContractError.InvalidMemberKey if frame.members[pending_index].key_bytes >= JSON_MAX_KEY_BYTES
            else:
                raise JsonContractError.NodeLimitExceeded if document.nodes.count >= JSON_MAX_NODES
                raise JsonContractError.TokenLimitExceeded if document.token_count >= lexed.limits.tokens
                raise JsonContractError.NodeLimitExceeded if frame.children.count > JSON_MAX_NODES - document.children.count
                raise JsonContractError.TokenLimitExceeded if frame.children.count > document.limits.tokens - document.children.count
            container: mutable JsonNode = JsonNode{kind: container_kind, range: container_range, depth: frame.depth}
            document.nodes.push(container)
            document.token_count <- document.token_count + 1
            document.max_depth <- frame.depth if frame.depth > document.max_depth
            container_index: usize = document.nodes.count - 1
            if frame.kind == JsonParseFrameKind.Array:
                if frame.children.count != 0:
                    container.child_start <- document.children.count
                for ordinal in 0..<frame.children.count |document, frame, container_index, ordinal|:
                    child_index: usize = frame.children[ordinal]
                    child: JsonArrayChild = JsonArrayChild{owner_index: container_index, value_index: child_index, ordinal: ordinal}
                    value: mutable JsonNode = document.nodes[child_index]
                    value.owner_kind <- JsonNodeOwnerKind.ArrayChild
                    value.owner_index <- container_index
                    value.owner_ordinal <- ordinal
                    document.nodes[child_index] <- value
                    document.children.push(child)
                container.child_count <- frame.children.count
            else:
                if retained_count != 0:
                    container.member_start <- document.members.count
                    container.member_key_order_start <- document.member_key_order.count
                retained_ordinal: mutable usize = 0
                for pending_index in 0..<frame.members.count |document, frame, retained, selected_values, pending_to_document, retained_ordinal, container_index|:
                    if retained[pending_index]:
                        pending: JsonParsePendingMember = frame.members[pending_index]
                        key_start: usize = document.key_bytes.count
                        for offset in 0..<pending.key_bytes |document, lexed, pending|:
                            document.key_bytes.push(lexed.decoded_data[pending.key_start + offset])
                        member_index: usize = document.members.count
                        member: JsonMember = JsonMember{owner_index: container_index, key_start: key_start, key_bytes: pending.key_bytes, key_range: pending.key_range, value_index: selected_values[pending_index], ordinal: retained_ordinal}
                        document.members.push(member)
                        pending_to_document[pending_index] <- member_index
                        value: mutable JsonNode = document.nodes[selected_values[pending_index]]
                        value.owner_kind <- JsonNodeOwnerKind.ObjectMember
                        value.owner_index <- container_index
                        value.owner_ordinal <- retained_ordinal
                        document.nodes[selected_values[pending_index]] <- value
                        retained_ordinal <- retained_ordinal + 1
                order_cursor <- 0
                while order_cursor < pending_order.count:
                    first_pending: usize = pending_order[order_cursor]
                    group_end: mutable usize = order_cursor + 1
                    while group_end < pending_order.count and json_parse_pending_key_order(lexed.decoded_data, frame.members, first_pending, pending_order[group_end]) == JsonParseKeyOrder.Equal:
                        group_end <- group_end + 1
                    member_index: usize = pending_to_document[first_pending]
                    member: mutable JsonMember = document.members[member_index]
                    member.member_key_order_rank <- document.member_key_order.count
                    document.members[member_index] <- member
                    document.member_key_order.push(member_index)
                    order_cursor <- group_end
                container.member_count <- retained_count
            document.nodes[container_index] <- container
            _ = frames.pop()
            try json_parse_record_value(document, frames, container_index, token.range.start)


        def json_parse_build(lexed: JsonLexedSource&, document: mutable JsonDocument&) -> void error[JsonParseError, JsonContractError] can[Memory.Allocate, Abort.Panic]:
            source_view: sview = bytes_view(lexed.source_data)
            decoded_view: sview = bytes_view(lexed.decoded_data)
            document.source_bytes <- lexed.source_bytes
            frames: mutable darray[JsonParseFrame] = []
            cursor: mutable usize = 0
            while cursor < lexed.tokens.count:
                token: JsonLexeme = lexed.tokens[cursor]
                if frames.count == 0:
                    raise JsonParseError.MultipleRoots(token.range.start) if document.roots.count != 0
                    if token.kind == JsonLexemeKind.ArrayOpen:
                        try json_parse_push_frame(frames, JsonParseFrameKind.Array, token, 0, lexed.limits)
                        cursor <- cursor + 1
                    elif token.kind == JsonLexemeKind.ObjectOpen:
                        try json_parse_push_frame(frames, JsonParseFrameKind.Object, token, 0, lexed.limits)
                        cursor <- cursor + 1
                    elif json_parse_scalar_kind(token.kind):
                        value_index: usize = try json_parse_append_scalar(document, lexed, token, 0, source_view, decoded_view)
                        try json_parse_record_value(document, frames, value_index, token.range.start)
                        cursor <- cursor + 1
                    else:
                        raise JsonParseError.UnexpectedToken(token.range.start)
                else:
                    frame_index: usize = frames.count - 1
                    frame: mutable JsonParseFrame = frames[frame_index]
                    if token.kind == JsonLexemeKind.ArrayClose or token.kind == JsonLexemeKind.ObjectClose:
                        try json_parse_finish_container(document, lexed, frames, token)
                        cursor <- cursor + 1
                    elif token.kind == JsonLexemeKind.Comma:
                        if frame.kind == JsonParseFrameKind.Array and frame.phase == JsonParsePhase.ArrayCommaOrEnd:
                            frame.phase <- JsonParsePhase.ArrayValue
                        elif frame.kind == JsonParseFrameKind.Object and frame.phase == JsonParsePhase.ObjectCommaOrEnd:
                            frame.phase <- JsonParsePhase.ObjectKey
                        else:
                            raise JsonParseError.UnexpectedToken(token.range.start)
                        frames[frame_index] <- frame
                        cursor <- cursor + 1
                    elif token.kind == JsonLexemeKind.Colon:
                        raise JsonParseError.ExpectedColon(token.range.start) if frame.kind != JsonParseFrameKind.Object or frame.phase != JsonParsePhase.ObjectColon
                        frame.phase <- JsonParsePhase.ObjectValue
                        frames[frame_index] <- frame
                        cursor <- cursor + 1
                    elif frame.kind == JsonParseFrameKind.Object and frame.phase == JsonParsePhase.ObjectColon:
                        raise JsonParseError.ExpectedColon(token.range.start)
                    elif frame.kind == JsonParseFrameKind.Object and (frame.phase == JsonParsePhase.ObjectFirstKeyOrEnd or frame.phase == JsonParsePhase.ObjectKey):
                        raise JsonParseError.NonStringObjectKey(token.range.start) if token.kind != JsonLexemeKind.String
                        raise JsonContractError.InvalidMemberKey if token.payload_bytes > lexed.limits.field_bytes or token.payload_bytes >= JSON_MAX_KEY_BYTES
                        frame.key_start <- token.payload_start
                        frame.key_bytes <- token.payload_bytes
                        frame.key_range <- token.range
                        frame.phase <- JsonParsePhase.ObjectColon
                        frames[frame_index] <- frame
                        cursor <- cursor + 1
                    elif (frame.kind == JsonParseFrameKind.Array and (frame.phase == JsonParsePhase.ArrayFirstValueOrEnd or frame.phase == JsonParsePhase.ArrayValue)) or (frame.kind == JsonParseFrameKind.Object and frame.phase == JsonParsePhase.ObjectValue):
                        raise JsonParseError.ExpectedValue(token.range.start) if not json_parse_value_kind(token.kind)
                        if token.kind == JsonLexemeKind.ArrayOpen:
                            child_depth: usize = frame.depth + 1
                            try json_parse_push_frame(frames, JsonParseFrameKind.Array, token, child_depth, lexed.limits)
                            cursor <- cursor + 1
                        elif token.kind == JsonLexemeKind.ObjectOpen:
                            child_depth: usize = frame.depth + 1
                            try json_parse_push_frame(frames, JsonParseFrameKind.Object, token, child_depth, lexed.limits)
                            cursor <- cursor + 1
                        else:
                            value_depth: usize = frame.depth + 1
                            value_index: usize = try json_parse_append_scalar(document, lexed, token, value_depth, source_view, decoded_view)
                            try json_parse_record_value(document, frames, value_index, token.range.start)
                            cursor <- cursor + 1
                    else:
                        raise JsonParseError.ExpectedCommaOrEnd(token.range.start)
            raise JsonParseError.EmptyInput if document.roots.count == 0 and lexed.tokens.count == 0
            raise JsonParseError.UnterminatedContainer(lexed.source_bytes) if frames.count != 0
            raise JsonParseError.EmptyInput if document.roots.count == 0
            raise JsonParseError.MultipleRoots(lexed.source_bytes) if document.roots.count != 1
            _ = try advance_json_document(document, JsonDocumentEvent.Seal)


    public:
        def parse_json_document(lexed: JsonLexedSource&) -> JsonDocument error[JsonParseError, JsonLexError, JsonContractError] can[Memory.Allocate, Abort.Panic]:
            try validate_json_lexed_source(lexed)
            document: mutable JsonDocument = JsonDocument{limits: lexed.limits, policy: lexed.policy}
            _ = try advance_json_document(document, JsonDocumentEvent.Begin)
            catch json_parse_build(lexed, document):
                ok:
                    _ = document.state
                error parse_failure:
                    if document.state == JsonDocumentState.Building:
                        catch advance_json_document(document, JsonDocumentEvent.Fail):
                            ok failed_state:
                                _ = failed_state
                            error fail_failure:
                                _ = fail_failure
                    raise parse_failure
            return document
