# Descriptor-relative verification and staging of installation sources.
#
# This adapter binds an install manifest entry to bytes observed beneath an
# already-open build-root capability. It rejects symlinked path components,
# bounds the read, hashes the exact file contents, and returns the stable file
# stamp needed by staging to detect source replacement. Staging and cleanup
# likewise remain rooted in directory capabilities rather than ambient paths.

module EsInstallSourcePosix:
    using EsBuildIncremental
    using EsBuildIncrementalPosix
    using EsInstall
    using EsRuntime

    public:
        const module Limits:
            STREAM_CHUNK_BYTES: usize = 65536
            STREAM_READ_CALLS: usize = 1048576
            EINTR_RETRIES: usize = 8
            STAGE_PATH_BYTES: usize = 4096
            STAGE_WALK_DEPTH: usize = 2048
            STAGE_WALK_ENTRIES: usize = 524288
            STAGE_WRITE_CALLS: usize = 1048576


        struct InstallSourceReceipt:
            artifact_index: usize
            source_path: sview
            byte_count: usize
            source_stamp: BuildIncrementalFileStamp
            digest_0: u64
            digest_1: u64
            digest_2: u64
            digest_3: u64


        struct InstallStageRootProof:
            device: u32
            inode: u64
            user: u32


        # The stage descriptor is owned by this handle; the parent descriptor
        # is borrowed and must remain open through cleanup/publication. The
        # fixed NUL-terminated leaf lets the owner identify this sibling.
        struct InstallStageRootHandle:
            parent_descriptor: int
            descriptor: int
            leaf_length: usize
            leaf: u8[256]
            proof: InstallStageRootProof


        struct InstallStageArtifactProof:
            receipt: InstallStageReceipt
            stage_stamp: BuildIncrementalFileStamp


        struct InstallStageProof:
            root: InstallStageRootProof
            artifacts: darray[InstallStageArtifactProof]


        struct InstallSourceCopyHandle:
            root_descriptor: int
            source_descriptor: int
            receipt: InstallSourceReceipt
            bytes_read: usize = 0
            read_calls: usize = 0
            interrupted: usize = 0
            failed: bool = false


        error InstallSourceError:
            ArtifactIndexOutOfRange
            PlanNotPlanned
            PlanNotSourcesVerified
            SourceMissing
            SourceChanged
            ByteCountMismatch
            DigestMismatch
            StageArtifactMissing
            StageArtifactChanged
            StageDigestMismatch
            StageMetadataFailed
            StageModeMismatch
            StageRootInvalid
            StageRootNotPrivate
            StageParentInvalid
            StageParentNotTrusted
            StageRootNameInvalid
            StageRootNameCollision
            StageRootCreateFailed(errno: i32)
            StageRootCreateOutcomeUnknown(errno: i32)
            StageRootOpenAfterCreateFailed(errno: i32)
            StageRootEntryChanged
            StageRootCleanupPending
            StageRootNotEmpty
            StageRootHandleInvalid
            StageRootCloseFailed(status: int)
            StageProofCountMismatch
            StageProofReceiptMismatch
            StageProofRootChanged
            StageRevalidationNotReady
            StageTreeEntryLimitExceeded
            StageTreeDepthLimitExceeded
            StageTreePathLimitExceeded
            StageTreeUnexpectedEntry
            StageTreeArtifactChanged
            StageTreeMissingArtifact
            StageTreeMissingDirectory
            StageTreeReadFailed(errno: i32)
            StageTreeOpenFailed(errno: i32)
            StageTreeMetadataFailed
            StageTreeDirectoryCloseFailed
            StageDirectoryCreateFailed(errno: i32)
            StageDirectoryCreateOutcomeUnknown(errno: i32)
            StageDirectoryOpenFailed(errno: i32)
            StageDirectoryChanged
            StageDirectoryCloseFailed(status: int)
            StageDirectoryModeFailed(errno: i32)
            StageDirectorySyncFailed(errno: i32)
            StageFileCreateFailed(errno: i32)
            StageFileDescriptorInvalid
            StageFileBufferInvalid
            StageFileWriteFailed(errno: i32)
            StageFileWriteLimitExceeded
            StageFileWriteIncomplete
            StageFileMetadataFailed
            StageFileModeFailed(errno: i32)
            StageFileChanged
            StageFileSyncFailed(errno: i32)
            StageFileCloseFailed(status: int)
            StageCleanupEntryLimitExceeded
            StageCleanupDepthLimitExceeded
            StageCleanupChanged
            StageCleanupNameInvalid
            StageCleanupReadFailed(errno: i32)
            StageCleanupOpenFailed(errno: i32)
            StageCleanupFailed(errno: i32)
            StageCleanupOutcomeUnknown(errno: i32)
            StageCleanupDirectoryCloseFailed
            StageCleanupCloseFailed(status: int)
            ReceiptPathMismatch
            ReceiptCountMismatch
            ReceiptOrderMismatch
            CopyHandleInvalid
            CopyHandleFailed
            CopyBufferInvalid
            CopyReadFailed(errno: i32)
            CopyReadLimitExceeded
            CopyReadIncomplete
            CopySourceCloseFailed(status: int)


    private:
        @link_name(geteuid)
        extern install_source_effective_user() -> u32


        const module InstallSourceErrno:
            EINTR: i32 = 4
            EIO: i32 = 5
            EEXIST: i32 = 17


        const module InstallSourceMode:
            PERMISSION_MASK: u16 = 4095
            PRIVATE_DIRECTORY: u16 = 448
            DIRECTORY: u16 = 493
            STICKY: u16 = 512
            DATA: u16 = 420
            EXECUTABLE: u16 = 493


        const enum InstallSourceReadState of u8:
            Read
            Done


        struct InstallStageDirectoryFrame:
            directory: mutable heap void&?
            path_length: usize
            interrupted: usize = 0


        struct InstallStageCleanupFrame:
            directory: mutable heap void&?
            proof: InstallStageRootProof
            parent_leaf_length: usize
            parent_leaf: u8[256]
            interrupted: usize = 0


        struct InstallStageDestinationParent:
            descriptor: int
            owned: bool
            leaf_length: usize
            leaf: u8[256]


        const enum InstallStageWriteState of u8:
            Write
            Complete
            Failed


        struct InstallStageWriteCursor:
            state: mutable InstallStageWriteState = InstallStageWriteState.Write
            offset: mutable usize = 0
            calls: mutable usize = 0
            interrupted: mutable usize = 0
            failure_errno: mutable i32 = 0


        struct InstallStageCopyCloseStatus:
            source: int = 0
            destination: int = 0
            parent: int = 0


        const enum InstallStageWalkState of u8:
            Walk
            Complete
            Failed


        const enum InstallStageWalkFailure of u8:
            None
            EntryLimit
            DepthLimit
            PathLimit
            UnexpectedEntry
            ArtifactChanged
            ModeMismatch
            Read
            Open
            Metadata
            Close


        const enum InstallStageCleanupState of u8:
            Walk
            Complete
            Failed


        const enum InstallStageEmptyState of u8:
            Read
            Complete
            Failed


        const enum InstallStageCleanupFailure of u8:
            None
            EntryLimit
            DepthLimit
            Changed
            NameInvalid
            Read
            Open
            Unlink
            UnlinkUnknown
            Sync
            DirectoryClose
            Metadata


        def install_source_stamp_equal(left: BuildIncrementalFileStamp, right: BuildIncrementalFileStamp) -> bool:
            return left.path == right.path and left.present and right.present and left.size == right.size and left.device == right.device and left.inode == right.inode and left.modify_time.seconds == right.modify_time.seconds and left.modify_time.nanoseconds == right.modify_time.nanoseconds and left.change_time.seconds == right.change_time.seconds and left.change_time.nanoseconds == right.change_time.nanoseconds


        def install_source_stat_matches_stamp(stat: ElisascriptStat, stamp: BuildIncrementalFileStamp) -> bool:
            return (stat.mode & DarwinStatMode::MASK) == DarwinStatMode::REGULAR and stat.device == stamp.device and stat.inode == stamp.inode and stat.size >= 0 and stat.size.usize().i64() == stat.size and stat.size.usize() == stamp.size and stat.modify_time.seconds == stamp.modify_time.seconds and stat.modify_time.nanoseconds == stamp.modify_time.nanoseconds and stat.change_time.seconds == stamp.change_time.seconds and stat.change_time.nanoseconds == stamp.change_time.nanoseconds


        def install_source_stat_descriptor(descriptor: int, result: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_fstat(descriptor, result) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == InstallSourceErrno::EINTR and retries < Limits::EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def install_source_stat_entry_at(parent_fd: int, leaf: cstr, result: mutable ElisascriptStat&, flags: int) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_fstatat(parent_fd, leaf, result, flags) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == InstallSourceErrno::EINTR and retries < Limits::EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def install_source_expected_mode(mode: InstallFileMode) -> u16:
            return InstallSourceMode::DATA if mode == InstallFileMode.Data
            return InstallSourceMode::EXECUTABLE


        def install_source_stage_file_matches(stat: ElisascriptStat, root: InstallStageRootProof, device: u32, inode: u64, byte_count: usize, mode: InstallFileMode) -> bool:
            return false if (stat.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR or stat.device != device or stat.user != root.user or stat.inode != inode or stat.link_count != 1u16
            return false if stat.size < 0 or stat.size.usize().i64() != stat.size or stat.size.usize() != byte_count
            return (stat.mode & InstallSourceMode::PERMISSION_MASK) == install_source_expected_mode(mode)


        def install_source_stage_mode_matches(root_fd: int, root: InstallStageRootProof, path: sview, stamp: BuildIncrementalFileStamp, mode: InstallFileMode) -> bool error[InstallSourceError, OpenError] can[Blocking.IO, Unsafe.PointerCast]:
            opened: OpenedFile = try open_build_incremental_file_at(root_fd, path)
            raise InstallSourceError.StageArtifactChanged if not opened.present
            observed: mutable ElisascriptStat = ElisascriptStat{}
            metadata_ok: bool = install_source_stat_descriptor(opened.descriptor, observed)
            close_status: int = elisascript_posix_close(opened.descriptor)
            raise OpenError.CloseFailed(path) if close_status != 0
            raise InstallSourceError.StageMetadataFailed if not metadata_ok
            raise InstallSourceError.StageArtifactChanged if not install_source_stat_matches_stamp(observed, stamp)
            raise InstallSourceError.StageArtifactChanged if observed.device != root.device or observed.user != root.user or observed.link_count != 1u16
            return (observed.mode & InstallSourceMode::PERMISSION_MASK) == install_source_expected_mode(mode)


        def install_source_require_private_stage_root(root_fd: int) -> InstallStageRootProof error[InstallSourceError] can[Blocking.IO]:
            raise InstallSourceError.StageRootInvalid if root_fd < 0
            observed: mutable ElisascriptStat = ElisascriptStat{}
            raise InstallSourceError.StageMetadataFailed if not install_source_stat_descriptor(root_fd, observed)
            raise InstallSourceError.StageRootInvalid if (observed.mode & DarwinStatMode::MASK) != DarwinStatMode::DIRECTORY
            raise InstallSourceError.StageRootNotPrivate if observed.user != install_source_effective_user() or (observed.mode & InstallSourceMode::PERMISSION_MASK) != InstallSourceMode::PRIVATE_DIRECTORY
            return InstallStageRootProof{device: observed.device, inode: observed.inode, user: observed.user}


        def install_source_stage_root_identity_matches(observed: ElisascriptStat, expected: InstallStageRootProof) -> bool:
            return (observed.mode & DarwinStatMode::MASK) == DarwinStatMode::DIRECTORY and observed.device == expected.device and observed.inode == expected.inode and observed.user == expected.user


        def install_source_stage_root_handle_matches(handle: InstallStageRootHandle&) -> bool can[Blocking.IO]:
            return false if handle.parent_descriptor < 0 or handle.descriptor < 0 or handle.leaf_length == 0 or handle.leaf_length >= 256
            return false if handle.leaf[handle.leaf_length] != 0u8
            opened: mutable ElisascriptStat = ElisascriptStat{}
            return false if not install_source_stat_descriptor(handle.descriptor, opened)
            return false if not install_source_stage_root_identity_matches(opened, handle.proof)
            return false if (opened.mode & InstallSourceMode::PERMISSION_MASK) != InstallSourceMode::PRIVATE_DIRECTORY or opened.user != install_source_effective_user()
            named: mutable ElisascriptStat = ElisascriptStat{}
            name: u8& = (&handle.leaf[0])
            return false if not install_source_stat_entry_at(handle.parent_descriptor, name.cast[cstr], named, DarwinAtFlag::SYMLINK_NOFOLLOW)
            return install_source_stage_root_identity_matches(named, handle.proof) and (named.mode & InstallSourceMode::PERMISSION_MASK) == InstallSourceMode::PRIVATE_DIRECTORY


        def install_source_stage_root_is_empty(handle: InstallStageRootHandle&) -> bool error[InstallSourceError] can[Blocking.IO, Memory.Allocate, Memory.Release]:
            raise InstallSourceError.StageRootHandleInvalid if not install_source_stage_root_handle_matches(handle)
            flags: int = DarwinOpenFlags::RDONLY | DarwinOpenFlags::DIRECTORY | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
            retries: mutable usize = 0
            descriptor: mutable int = -1
            while descriptor < 0:
                descriptor <- elisascript_posix_openat(handle.descriptor, ".", flags, 0u32)
                if descriptor < 0:
                    errno: mutable i32& = elisascript_posix_errno()
                    if errno[0] == InstallSourceErrno::EINTR and retries < Limits::EINTR_RETRIES:
                        retries <- retries + 1
                        continue
                    raise InstallSourceError.StageCleanupOpenFailed(errno[0])
            directory: mutable heap void&? = elisascript_posix_fdopendir(descriptor)
            if directory == null:
                errno: mutable i32& = elisascript_posix_errno()
                open_errno: i32 = errno[0]
                close_status: int = elisascript_posix_close(descriptor)
                raise InstallSourceError.StageCleanupCloseFailed(close_status) if close_status != 0
                raise InstallSourceError.StageCleanupOpenFailed(open_errno)

            state: mutable InstallStageEmptyState = InstallStageEmptyState.Read
            interrupted: mutable usize = 0
            has_entry: mutable bool = false
            failure_errno: mutable i32 = 0
            machine over state:
                state Read
                start Read

                Read, InstallStageEmptyState.Read:
                    errno_pointer: mutable i32& = elisascript_posix_errno()
                    errno_pointer[0] <- 0
                    entry_option: mutable ElisascriptDirectoryEntry&? = elisascript_posix_readdir(directory)
                    if entry_option == null:
                        if errno_pointer[0] == InstallSourceErrno::EINTR and interrupted < Limits::EINTR_RETRIES:
                            interrupted <- interrupted + 1
                            -> Read
                        if errno_pointer[0] != 0:
                            failure_errno <- errno_pointer[0]
                            state <- InstallStageEmptyState.Failed
                            -> Read
                        state <- InstallStageEmptyState.Complete
                        -> Read
                    entry: mutable ElisascriptDirectoryEntry& = entry_option
                    interrupted <- 0
                    name_length: usize = entry.name_length.usize()
                    if entry.record_length == 0u16 or name_length == 0 or name_length >= 1024 or entry.name[name_length] != 0u8:
                        failure_errno <- InstallSourceErrno::EIO
                        state <- InstallStageEmptyState.Failed
                        -> Read
                    if (name_length == 1 and entry.name[0] == 46u8) or (name_length == 2 and entry.name[0] == 46u8 and entry.name[1] == 46u8):
                        interrupted <- 0
                        -> Read
                    has_entry <- true
                    state <- InstallStageEmptyState.Complete
                    -> Read

                Read, InstallStageEmptyState.Complete:
                    break

                Read, InstallStageEmptyState.Failed:
                    break

            close_status: int = elisascript_posix_closedir(directory)
            raise InstallSourceError.StageCleanupDirectoryCloseFailed if close_status != 0
            raise InstallSourceError.StageCleanupReadFailed(failure_errno) if state == InstallStageEmptyState.Failed
            return not has_entry


        def install_source_copy_stage_segment(path: sview, start: usize, end: usize, buffer: mutable u8&) -> usize:
            length: usize = end - start
            return 0 if length == 0 or length >= 256
            return 0 if (length == 1 and sview_at(path, start) == 46u8) or (length == 2 and sview_at(path, start) == 46u8 and sview_at(path, start + 1) == 46u8)
            for offset in 0..<length |path, buffer|:
                byte: u8 = sview_at(path, start + offset)
                return 0 if byte == 0u8 or byte == 47u8 or byte < 32u8 or byte == 127u8
                buffer[offset] <- byte
            buffer[length] <- 0u8
            return length


        def install_source_copy_cleanup_name(name: u8&, length: usize, buffer: mutable u8&) -> usize:
            return 0 if length == 0 or length >= 256
            return 0 if (length == 1 and name[0] == 46u8) or (length == 2 and name[0] == 46u8 and name[1] == 46u8)
            for offset in 0..<length |name, buffer|:
                byte: u8 = name[offset]
                return 0 if byte == 0u8 or byte == 47u8
                buffer[offset] <- byte
            buffer[length] <- 0u8
            return length


        def install_source_write_stage_fully(descriptor: int, buffer: mutable u8&, length: usize) -> usize error[InstallSourceError] can[Blocking.IO, Unsafe.PointerCast]:
            raise InstallSourceError.StageFileDescriptorInvalid if descriptor < 0
            raise InstallSourceError.StageFileBufferInvalid if length != 0 and buffer == null
            cursor: mutable InstallStageWriteCursor = InstallStageWriteCursor{}
            machine over cursor.state:
                state Write
                start Write

                Write, InstallStageWriteState.Write if cursor.offset >= length:
                    cursor.state <- InstallStageWriteState.Complete
                    -> Write
                Write, InstallStageWriteState.Write if cursor.calls >= Limits::STAGE_WRITE_CALLS:
                    cursor.state <- InstallStageWriteState.Failed
                    -> Write
                Write, InstallStageWriteState.Write:
                    remaining: usize = length - cursor.offset
                    next_bytes: mutable u8& = buffer + cursor.offset
                    amount: isize = elisascript_posix_write(descriptor, next_bytes.cast[void&], remaining)
                    cursor.calls <- cursor.calls + 1
                    if amount < 0:
                        errno: mutable i32& = elisascript_posix_errno()
                        if errno[0] == InstallSourceErrno::EINTR and cursor.interrupted < Limits::EINTR_RETRIES:
                            cursor.interrupted <- cursor.interrupted + 1
                            -> Write
                        cursor.failure_errno <- errno[0]
                        cursor.state <- InstallStageWriteState.Failed
                        -> Write
                    if amount == 0 or amount.usize() > remaining:
                        cursor.failure_errno <- InstallSourceErrno::EIO
                        cursor.state <- InstallStageWriteState.Failed
                        -> Write
                    cursor.offset <- cursor.offset + amount.usize()
                    cursor.interrupted <- 0
                    -> Write

                Write, InstallStageWriteState.Complete:
                    break

                Write, InstallStageWriteState.Failed:
                    break

            raise InstallSourceError.StageFileWriteFailed(cursor.failure_errno) if cursor.failure_errno != 0
            raise InstallSourceError.StageFileWriteLimitExceeded if cursor.calls >= Limits::STAGE_WRITE_CALLS and cursor.offset < length
            raise InstallSourceError.StageFileWriteIncomplete if cursor.offset != length
            return cursor.offset


        def install_source_sync_stage_descriptor(descriptor: int) -> i32 can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return 0 if elisascript_posix_fsync(descriptor) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == InstallSourceErrno::EINTR and retries < Limits::EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return errno[0]


        def install_source_close_owned_stage_directory(descriptor: int, owned: bool) -> int can[Blocking.IO]:
            return 0 if not owned
            return elisascript_posix_close(descriptor)


        def install_source_close_stage_destination_parent(parent: mutable InstallStageDestinationParent&) -> int can[Blocking.IO]:
            return 0 if not parent.owned
            descriptor: int = parent.descriptor
            parent.descriptor <- -1
            parent.owned <- false
            return elisascript_posix_close(descriptor)


        def install_source_open_stage_destination_parent(stage: InstallStageRootHandle&, path: sview) -> InstallStageDestinationParent error[InstallSourceError] can[Blocking.IO, Unsafe.PointerCast]:
            raise InstallSourceError.StageRootHandleInvalid if not install_source_stage_root_handle_matches(stage)
            path_length: usize = sview_len(path)
            segment_storage: mutable u8[256] = zeroed
            segment_buffer: mutable u8& = (&segment_storage[0])
            leaf_storage: mutable u8[256] = zeroed
            segment_start: mutable usize = 0
            index: mutable usize = 0
            current_fd: mutable int = stage.descriptor
            current_owned: mutable bool = false
            while index <= path_length:
                at_end: bool = index == path_length
                at_separator: bool = not at_end and sview_at(path, index) == 47u8
                if at_end or at_separator:
                    segment_length: usize = install_source_copy_stage_segment(path, segment_start, index, segment_buffer)
                    if segment_length == 0:
                        close_status: int = install_source_close_owned_stage_directory(current_fd, current_owned)
                        raise InstallSourceError.StageDirectoryCloseFailed(close_status) if close_status != 0
                        raise InstallSourceError.StageRootNameInvalid
                    if at_end:
                        for offset in 0..<segment_length |segment_storage, leaf_storage|:
                            leaf_storage[offset] <- segment_storage[offset]
                        leaf_storage[segment_length] <- 0u8
                        return InstallStageDestinationParent{descriptor: current_fd, owned: current_owned, leaf_length: segment_length, leaf: leaf_storage}

                    create_status: int = elisascript_posix_mkdirat(current_fd, segment_buffer.cast[cstr], InstallSourceMode::DIRECTORY.i32())
                    created: bool = create_status == 0
                    if create_status != 0:
                        errno: mutable i32& = elisascript_posix_errno()
                        create_errno: i32 = errno[0]
                        if create_errno != InstallSourceErrno::EEXIST:
                            close_status: int = install_source_close_owned_stage_directory(current_fd, current_owned)
                            raise InstallSourceError.StageDirectoryCloseFailed(close_status) if close_status != 0
                            raise InstallSourceError.StageDirectoryCreateOutcomeUnknown(create_errno) if create_errno == InstallSourceErrno::EINTR
                            raise InstallSourceError.StageDirectoryCreateFailed(create_errno)

                    child_retries: mutable usize = 0
                    child_fd: mutable int = -1
                    child_errno: mutable i32 = 0
                    directory_flags: int = DarwinOpenFlags::RDONLY | DarwinOpenFlags::DIRECTORY | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
                    while child_fd < 0 and child_retries <= Limits::EINTR_RETRIES:
                        child_fd <- elisascript_posix_openat(current_fd, segment_buffer.cast[cstr], directory_flags, 0u32)
                        if child_fd < 0:
                            errno: mutable i32& = elisascript_posix_errno()
                            child_errno <- errno[0]
                            if child_errno == InstallSourceErrno::EINTR:
                                child_retries <- child_retries + 1
                                continue
                            break
                    if child_fd < 0:
                        close_status: int = install_source_close_owned_stage_directory(current_fd, current_owned)
                        raise InstallSourceError.StageDirectoryCloseFailed(close_status) if close_status != 0
                        raise InstallSourceError.StageDirectoryOpenFailed(child_errno)

                    child_info: mutable ElisascriptStat = ElisascriptStat{}
                    if not install_source_stat_descriptor(child_fd, child_info):
                        child_close_status: int = elisascript_posix_close(child_fd)
                        parent_close_status: int = install_source_close_owned_stage_directory(current_fd, current_owned)
                        raise InstallSourceError.StageDirectoryCloseFailed(child_close_status) if child_close_status != 0
                        raise InstallSourceError.StageDirectoryCloseFailed(parent_close_status) if parent_close_status != 0
                        raise InstallSourceError.StageTreeMetadataFailed
                    if (child_info.mode & DarwinStatMode::MASK) != DarwinStatMode::DIRECTORY or child_info.device != stage.proof.device or child_info.user != stage.proof.user:
                        child_close_status: int = elisascript_posix_close(child_fd)
                        parent_close_status: int = install_source_close_owned_stage_directory(current_fd, current_owned)
                        raise InstallSourceError.StageDirectoryCloseFailed(child_close_status) if child_close_status != 0
                        raise InstallSourceError.StageDirectoryCloseFailed(parent_close_status) if parent_close_status != 0
                        raise InstallSourceError.StageDirectoryChanged
                    named_before: mutable ElisascriptStat = ElisascriptStat{}
                    named_before_ok: bool = install_source_stat_entry_at(current_fd, segment_buffer.cast[cstr], named_before, DarwinAtFlag::SYMLINK_NOFOLLOW)
                    if not named_before_ok or not install_source_stage_root_identity_matches(named_before, InstallStageRootProof{device: child_info.device, inode: child_info.inode, user: child_info.user}):
                        child_close_status: int = elisascript_posix_close(child_fd)
                        parent_close_status: int = install_source_close_owned_stage_directory(current_fd, current_owned)
                        raise InstallSourceError.StageDirectoryCloseFailed(child_close_status) if child_close_status != 0
                        raise InstallSourceError.StageDirectoryCloseFailed(parent_close_status) if parent_close_status != 0
                        raise InstallSourceError.StageDirectoryChanged
                    if created:
                        if elisascript_posix_fchmod(child_fd, InstallSourceMode::DIRECTORY.u32()) != 0:
                            errno: mutable i32& = elisascript_posix_errno()
                            mode_errno: i32 = errno[0]
                            child_close_status: int = elisascript_posix_close(child_fd)
                            parent_close_status: int = install_source_close_owned_stage_directory(current_fd, current_owned)
                            raise InstallSourceError.StageDirectoryCloseFailed(child_close_status) if child_close_status != 0
                            raise InstallSourceError.StageDirectoryCloseFailed(parent_close_status) if parent_close_status != 0
                            raise InstallSourceError.StageDirectoryModeFailed(mode_errno)
                        child_info <- ElisascriptStat{}
                        if not install_source_stat_descriptor(child_fd, child_info):
                            child_close_status: int = elisascript_posix_close(child_fd)
                            parent_close_status: int = install_source_close_owned_stage_directory(current_fd, current_owned)
                            raise InstallSourceError.StageDirectoryCloseFailed(child_close_status) if child_close_status != 0
                            raise InstallSourceError.StageDirectoryCloseFailed(parent_close_status) if parent_close_status != 0
                            raise InstallSourceError.StageTreeMetadataFailed
                    if child_info.device != stage.proof.device or child_info.user != stage.proof.user or (child_info.mode & DarwinStatMode::MASK) != DarwinStatMode::DIRECTORY:
                        child_close_status: int = elisascript_posix_close(child_fd)
                        parent_close_status: int = install_source_close_owned_stage_directory(current_fd, current_owned)
                        raise InstallSourceError.StageDirectoryCloseFailed(child_close_status) if child_close_status != 0
                        raise InstallSourceError.StageDirectoryCloseFailed(parent_close_status) if parent_close_status != 0
                        raise InstallSourceError.StageDirectoryChanged
                    if (child_info.mode & InstallSourceMode::PERMISSION_MASK) != InstallSourceMode::DIRECTORY:
                        child_close_status: int = elisascript_posix_close(child_fd)
                        parent_close_status: int = install_source_close_owned_stage_directory(current_fd, current_owned)
                        raise InstallSourceError.StageDirectoryCloseFailed(child_close_status) if child_close_status != 0
                        raise InstallSourceError.StageDirectoryCloseFailed(parent_close_status) if parent_close_status != 0
                        raise InstallSourceError.StageModeMismatch

                    named_info: mutable ElisascriptStat = ElisascriptStat{}
                    named_ok: bool = install_source_stat_entry_at(current_fd, segment_buffer.cast[cstr], named_info, DarwinAtFlag::SYMLINK_NOFOLLOW)
                    if not named_ok or not install_source_stage_root_identity_matches(named_info, InstallStageRootProof{device: child_info.device, inode: child_info.inode, user: child_info.user}) or (named_info.mode & InstallSourceMode::PERMISSION_MASK) != InstallSourceMode::DIRECTORY:
                        child_close_status: int = elisascript_posix_close(child_fd)
                        parent_close_status: int = install_source_close_owned_stage_directory(current_fd, current_owned)
                        raise InstallSourceError.StageDirectoryCloseFailed(child_close_status) if child_close_status != 0
                        raise InstallSourceError.StageDirectoryCloseFailed(parent_close_status) if parent_close_status != 0
                        raise InstallSourceError.StageDirectoryChanged
                    if created:
                        child_sync_errno: i32 = install_source_sync_stage_descriptor(child_fd)
                        if child_sync_errno != 0:
                            child_close_status: int = elisascript_posix_close(child_fd)
                            parent_close_status: int = install_source_close_owned_stage_directory(current_fd, current_owned)
                            raise InstallSourceError.StageDirectoryCloseFailed(child_close_status) if child_close_status != 0
                            raise InstallSourceError.StageDirectoryCloseFailed(parent_close_status) if parent_close_status != 0
                            raise InstallSourceError.StageDirectorySyncFailed(child_sync_errno)
                        parent_sync_errno: i32 = install_source_sync_stage_descriptor(current_fd)
                        if parent_sync_errno != 0:
                            child_close_status: int = elisascript_posix_close(child_fd)
                            parent_close_status: int = install_source_close_owned_stage_directory(current_fd, current_owned)
                            raise InstallSourceError.StageDirectoryCloseFailed(child_close_status) if child_close_status != 0
                            raise InstallSourceError.StageDirectoryCloseFailed(parent_close_status) if parent_close_status != 0
                            raise InstallSourceError.StageDirectorySyncFailed(parent_sync_errno)
                    parent_close_status: int = install_source_close_owned_stage_directory(current_fd, current_owned)
                    if parent_close_status != 0:
                        child_close_status: int = elisascript_posix_close(child_fd)
                        raise InstallSourceError.StageDirectoryCloseFailed(child_close_status) if child_close_status != 0
                        raise InstallSourceError.StageDirectoryCloseFailed(parent_close_status)
                    current_fd <- child_fd
                    current_owned <- true
                    segment_start <- index + 1
                index <- index + 1
            raise InstallSourceError.StageRootNameInvalid


        def install_source_copy_stage_root_leaf(leaf: sview, buffer: mutable u8&) -> usize:
            length: usize = sview_len(leaf)
            return 0 if length == 0 or length >= 256
            return 0 if (length == 1 and sview_at(leaf, 0) == 46u8) or (length == 2 and sview_at(leaf, 0) == 46u8 and sview_at(leaf, 1) == 46u8)
            for offset in 0..<length |leaf, buffer|:
                byte: u8 = sview_at(leaf, offset)
                return 0 if byte == 0u8 or byte == 47u8 or byte < 32u8 or byte == 127u8
                buffer[offset] <- byte
            buffer[length] <- 0u8
            return length


        def install_source_close_descriptor(handle: mutable InstallSourceCopyHandle&) -> int can[Blocking.IO]:
            return -1 if handle.source_descriptor < 0
            descriptor: int = handle.source_descriptor
            handle.source_descriptor <- -1
            return elisascript_posix_close(descriptor)


        def install_source_close_stage_copy_handles(source: mutable InstallSourceCopyHandle&, destination_fd: int, parent: mutable InstallStageDestinationParent&) -> InstallStageCopyCloseStatus can[Blocking.IO]:
            source_status: int = 0 if source.source_descriptor < 0 else install_source_close_descriptor(source)
            destination_status: int = 0 if destination_fd < 0 else elisascript_posix_close(destination_fd)
            parent_status: int = install_source_close_stage_destination_parent(parent)
            return InstallStageCopyCloseStatus{source: source_status, destination: destination_status, parent: parent_status}


        def install_source_require_stage_copy_cleanup(cleanup: InstallStageCopyCloseStatus) -> void error[InstallSourceError]:
            raise InstallSourceError.CopySourceCloseFailed(cleanup.source) if cleanup.source != 0
            raise InstallSourceError.StageFileCloseFailed(cleanup.destination) if cleanup.destination != 0
            raise InstallSourceError.StageDirectoryCloseFailed(cleanup.parent) if cleanup.parent != 0


        def install_source_receipt_matches_artifact(artifact: InstallArtifact, index: usize, receipt: InstallSourceReceipt) -> bool error[InstallSourceError]:
            raise InstallSourceError.ReceiptOrderMismatch if receipt.artifact_index != index
            raise InstallSourceError.ReceiptPathMismatch if receipt.source_path != artifact.source_path or receipt.source_stamp.path != artifact.source_path
            raise InstallSourceError.SourceMissing if not receipt.source_stamp.present
            raise InstallSourceError.ByteCountMismatch if receipt.byte_count != artifact.byte_count or receipt.source_stamp.size != artifact.byte_count
            raise InstallSourceError.DigestMismatch if receipt.digest_0 != artifact.digest_0 or receipt.digest_1 != artifact.digest_1 or receipt.digest_2 != artifact.digest_2 or receipt.digest_3 != artifact.digest_3
            return true


        def install_source_stage_path_matches(path_buffer: mutable u8&, path_length: usize, expected: sview) -> bool:
            return false if sview_len(expected) != path_length
            for offset in 0..<path_length |path_buffer, expected|:
                return false if path_buffer[offset] != sview_at(expected, offset)
            return true


        def install_source_stage_path_is_parent(path_buffer: mutable u8&, path_length: usize, child: sview) -> bool:
            child_length: usize = sview_len(child)
            return false if path_length >= child_length or sview_at(child, path_length) != 47
            for offset in 0..<path_length |path_buffer, child|:
                return false if path_buffer[offset] != sview_at(child, offset)
            return true


        def install_source_stage_artifact_index(plan: InstallPlan&, path_buffer: mutable u8&, path_length: usize) -> usize:
            for index in 0..<plan.artifacts.count |plan, path_buffer|:
                return index if install_source_stage_path_matches(path_buffer, path_length, plan.artifacts[index].destination_path)
            return plan.artifacts.count


        def install_source_stage_parent_count(path: sview) -> usize:
            count: mutable usize = 0
            for offset in 0..<sview_len(path) |path, count|:
                count <- count + 1 if sview_at(path, offset) == 47
            return count


        def observe_install_source_entry_at(a: mutable Arena&, root_fd: int, artifact: InstallArtifact, artifact_index: usize) -> InstallSourceReceipt error[InstallSourceError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            initial_stamp: BuildIncrementalFileStamp = try observe_build_incremental_file_stamp_at(root_fd, artifact.source_path)
            raise InstallSourceError.SourceMissing if not initial_stamp.present
            # Check size before the content observer allocates its bounded read
            # buffer. A manifest expecting a small artifact must not be forced
            # to materialize a different, much larger file before rejection.
            raise InstallSourceError.ByteCountMismatch if initial_stamp.size != artifact.byte_count
            stamp: mutable BuildIncrementalFileStamp = BuildIncrementalFileStamp{path: artifact.source_path}
            observed: BuildIncrementalObservation = try observe_build_incremental_file_with_stamp_at(a, root_fd, artifact.source_path, stamp)
            raise InstallSourceError.SourceChanged if not observed.present or not install_source_stamp_equal(initial_stamp, stamp[0])
            raise InstallSourceError.DigestMismatch if observed.fingerprint != artifact.digest_0 or observed.fingerprint_word1 != artifact.digest_1 or observed.fingerprint_word2 != artifact.digest_2 or observed.fingerprint_word3 != artifact.digest_3

            return InstallSourceReceipt{
                artifact_index: artifact_index,
                source_path: artifact.source_path,
                byte_count: stamp[0].size,
                source_stamp: stamp[0],
                digest_0: observed.fingerprint,
                digest_1: observed.fingerprint_word1,
                digest_2: observed.fingerprint_word2,
                digest_3: observed.fingerprint_word3
            }


        # Enumerate the private stage through directory capabilities. Every
        # regular file must bind to one manifest receipt, every directory must
        # be a required parent of a planned destination, and symlinks/other
        # entries are rejected. The walk is iterative so depth and cleanup are
        # explicit rather than delegated to the host call stack.
        def install_source_validate_stage_tree(root_fd: int, root: InstallStageRootProof, plan: InstallPlan&, artifacts: darray[InstallStageArtifactProof]) -> bool error[InstallSourceError] can[Blocking.IO, Abort.Panic, Unsafe.PointerCast]:
            raise InstallSourceError.StageProofCountMismatch if artifacts.count != plan.artifacts.count
            duplicate_flags: int = DarwinOpenFlags::RDONLY | DarwinOpenFlags::DIRECTORY | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
            root_open_retries: mutable usize = 0
            root_duplicate: mutable int = -1
            while root_duplicate < 0:
                root_duplicate <- elisascript_posix_openat(root_fd, ".", duplicate_flags, 0u32)
                if root_duplicate < 0:
                    errno: mutable i32& = elisascript_posix_errno()
                    if errno[0] == InstallSourceErrno::EINTR and root_open_retries < Limits::EINTR_RETRIES:
                        root_open_retries <- root_open_retries + 1
                        continue
                    raise InstallSourceError.StageTreeOpenFailed(errno[0])
            duplicate_info: mutable ElisascriptStat = ElisascriptStat{}
            if not install_source_stat_descriptor(root_duplicate, duplicate_info):
                close_status: int = elisascript_posix_close(root_duplicate)
                raise InstallSourceError.StageTreeDirectoryCloseFailed if close_status != 0
                raise InstallSourceError.StageMetadataFailed
            if duplicate_info.device != root.device or duplicate_info.inode != root.inode or duplicate_info.user != root.user:
                close_status: int = elisascript_posix_close(root_duplicate)
                raise InstallSourceError.StageTreeDirectoryCloseFailed if close_status != 0
                raise InstallSourceError.StageProofRootChanged
            if (duplicate_info.mode & DarwinStatMode::MASK) != DarwinStatMode::DIRECTORY:
                close_status: int = elisascript_posix_close(root_duplicate)
                raise InstallSourceError.StageTreeDirectoryCloseFailed if close_status != 0
                raise InstallSourceError.StageRootInvalid
            if (duplicate_info.mode & InstallSourceMode::PERMISSION_MASK) != InstallSourceMode::PRIVATE_DIRECTORY:
                close_status: int = elisascript_posix_close(root_duplicate)
                raise InstallSourceError.StageTreeDirectoryCloseFailed if close_status != 0
                raise InstallSourceError.StageRootNotPrivate
            root_stream: mutable heap void&? = elisascript_posix_fdopendir(root_duplicate)
            if root_stream == null:
                errno: mutable i32& = elisascript_posix_errno()
                open_errno: i32 = errno[0]
                close_status: int = elisascript_posix_close(root_duplicate)
                raise InstallSourceError.StageTreeDirectoryCloseFailed if close_status != 0
                raise InstallSourceError.StageTreeOpenFailed(open_errno)

            frames: mutable InstallStageDirectoryFrame[Limits::STAGE_WALK_DEPTH] = zeroed
            frames[0] <- InstallStageDirectoryFrame{directory: root_stream, path_length: 0}
            frame_count: mutable usize = 1
            path_storage: mutable u8[Limits::STAGE_PATH_BYTES] = zeroed
            path_buffer: mutable u8& = (&path_storage[0])
            seen_files: mutable bool[INSTALL_MAX_ARTIFACTS] = zeroed
            seen_parent_directories: mutable usize[INSTALL_MAX_ARTIFACTS] = zeroed
            entries_seen: mutable usize = 0
            path_length: mutable usize = 0
            failure: mutable InstallStageWalkFailure = InstallStageWalkFailure.None
            failure_errno: mutable i32 = 0
            close_failed: mutable bool = false
            cleanup_close_failed: mutable bool = false
            state: mutable InstallStageWalkState = InstallStageWalkState.Walk

            machine over state:
                state Walk
                start Walk

                Walk, InstallStageWalkState.Walk:
                    if frame_count == 0:
                        state <- InstallStageWalkState.Complete
                        -> Walk
                    top: usize = frame_count - 1
                    frame: InstallStageDirectoryFrame = frames[top]
                    if frame.directory == null:
                        failure <- InstallStageWalkFailure.Metadata
                        state <- InstallStageWalkState.Failed
                        -> Walk
                    directory: mutable heap void& = frame.directory
                    errno_pointer: mutable i32& = elisascript_posix_errno()
                    errno_pointer[0] <- 0
                    entry_option: mutable ElisascriptDirectoryEntry&? = elisascript_posix_readdir(directory)
                    if entry_option == null:
                        if errno_pointer[0] == InstallSourceErrno::EINTR and frame.interrupted < Limits::EINTR_RETRIES:
                            frames[top].interrupted <- frame.interrupted + 1
                            -> Walk
                        if errno_pointer[0] != 0:
                            failure <- InstallStageWalkFailure.Read
                            failure_errno <- errno_pointer[0]
                            state <- InstallStageWalkState.Failed
                            -> Walk
                        closed_frame: InstallStageDirectoryFrame = frames[top]
                        frame_count <- frame_count - 1
                        if closed_frame.directory == null or elisascript_posix_closedir(closed_frame.directory) != 0:
                            failure <- InstallStageWalkFailure.Close
                            state <- InstallStageWalkState.Failed
                            -> Walk
                        path_length <- frames[frame_count - 1].path_length if frame_count != 0 else 0
                        -> Walk

                    frames[top].interrupted <- 0
                    entry: mutable ElisascriptDirectoryEntry& = entry_option
                    name_length: usize = entry.name_length.usize()
                    if entry.record_length == 0u16 or name_length == 0 or name_length >= 1024:
                        failure <- InstallStageWalkFailure.Metadata
                        state <- InstallStageWalkState.Failed
                        -> Walk
                    if (name_length == 1 and entry.name[0] == 46u8) or (name_length == 2 and entry.name[0] == 46u8 and entry.name[1] == 46u8):
                        -> Walk
                    if entries_seen >= Limits::STAGE_WALK_ENTRIES:
                        failure <- InstallStageWalkFailure.EntryLimit
                        state <- InstallStageWalkState.Failed
                        -> Walk
                    entries_seen <- entries_seen + 1
                    parent_path_length: usize = frame.path_length
                    separator_bytes: usize = 1 if parent_path_length != 0 else 0
                    if parent_path_length + separator_bytes + name_length > Limits::STAGE_PATH_BYTES:
                        failure <- InstallStageWalkFailure.PathLimit
                        state <- InstallStageWalkState.Failed
                        -> Walk
                    path_length <- parent_path_length
                    if separator_bytes != 0:
                        path_buffer[path_length] <- 47u8
                        path_length <- path_length + 1
                    for offset in 0..<name_length |entry, path_buffer, path_length|:
                        byte: u8 = entry.name[offset]
                        if byte == 0u8 or byte == 47u8:
                            failure <- InstallStageWalkFailure.Metadata
                            state <- InstallStageWalkState.Failed
                        path_buffer[path_length] <- byte
                        path_length <- path_length + 1
                    if state == InstallStageWalkState.Failed:
                        -> Walk
                    if entry.name[name_length] != 0u8:
                        failure <- InstallStageWalkFailure.Metadata
                        state <- InstallStageWalkState.Failed
                        -> Walk

                    parent_fd: int = elisascript_posix_dirfd(directory)
                    if parent_fd < 0:
                        failure <- InstallStageWalkFailure.Metadata
                        state <- InstallStageWalkState.Failed
                        -> Walk
                    entry_info: mutable ElisascriptStat = ElisascriptStat{}
                    stat_retries: mutable usize = 0
                    stat_status: mutable int = -1
                    while stat_status != 0:
                        stat_status <- elisascript_posix_fstatat(parent_fd, (&entry.name[0]).cast[cstr], entry_info, DarwinAtFlag::SYMLINK_NOFOLLOW)
                        if stat_status != 0:
                            errno: mutable i32& = elisascript_posix_errno()
                            if errno[0] == InstallSourceErrno::EINTR and stat_retries < Limits::EINTR_RETRIES:
                                stat_retries <- stat_retries + 1
                                continue
                            failure <- InstallStageWalkFailure.Metadata
                            failure_errno <- errno[0]
                            state <- InstallStageWalkState.Failed
                            break
                    if state == InstallStageWalkState.Failed:
                        -> Walk
                    if entry_info.device != root.device or entry_info.user != root.user:
                        failure <- InstallStageWalkFailure.UnexpectedEntry
                        state <- InstallStageWalkState.Failed
                        -> Walk

                    kind: u16 = entry_info.mode & DarwinStatMode::MASK
                    if kind == DarwinStatMode::REGULAR:
                        artifact_index: usize = install_source_stage_artifact_index(plan, path_buffer, path_length)
                        if artifact_index == plan.artifacts.count:
                            failure <- InstallStageWalkFailure.UnexpectedEntry
                            state <- InstallStageWalkState.Failed
                            -> Walk
                        proof: InstallStageArtifactProof = artifacts[artifact_index]
                        if seen_files[artifact_index] or not install_source_stat_matches_stamp(entry_info, proof.stage_stamp) or entry_info.user != root.user or entry_info.device != root.device or entry_info.link_count != 1u16:
                            failure <- InstallStageWalkFailure.ArtifactChanged
                            state <- InstallStageWalkState.Failed
                            -> Walk
                        if (entry_info.mode & InstallSourceMode::PERMISSION_MASK) != install_source_expected_mode(plan.artifacts[artifact_index].mode):
                            failure <- InstallStageWalkFailure.ModeMismatch
                            state <- InstallStageWalkState.Failed
                            -> Walk
                        seen_files[artifact_index] <- true
                        path_length <- parent_path_length
                        -> Walk

                    if kind != DarwinStatMode::DIRECTORY or (entry_info.mode & InstallSourceMode::PERMISSION_MASK) != InstallSourceMode::DIRECTORY:
                        failure <- InstallStageWalkFailure.UnexpectedEntry
                        state <- InstallStageWalkState.Failed
                        -> Walk
                    directory_is_expected: mutable bool = false
                    for artifact_index in 0..<plan.artifacts.count |plan, path_buffer, path_length, seen_parent_directories, directory_is_expected|:
                        if install_source_stage_path_is_parent(path_buffer, path_length, plan.artifacts[artifact_index].destination_path):
                            directory_is_expected <- true
                            seen_parent_directories[artifact_index] <- seen_parent_directories[artifact_index] + 1
                    if not directory_is_expected:
                        failure <- InstallStageWalkFailure.UnexpectedEntry
                        state <- InstallStageWalkState.Failed
                        -> Walk
                    if frame_count >= Limits::STAGE_WALK_DEPTH:
                        failure <- InstallStageWalkFailure.DepthLimit
                        state <- InstallStageWalkState.Failed
                        -> Walk

                    child_open_retries: mutable usize = 0
                    child_fd: mutable int = -1
                    child_flags: int = DarwinOpenFlags::RDONLY | DarwinOpenFlags::DIRECTORY | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
                    while child_fd < 0:
                        child_fd <- elisascript_posix_openat(parent_fd, (&entry.name[0]).cast[cstr], child_flags, 0u32)
                        if child_fd < 0:
                            errno: mutable i32& = elisascript_posix_errno()
                            if errno[0] == InstallSourceErrno::EINTR and child_open_retries < Limits::EINTR_RETRIES:
                                child_open_retries <- child_open_retries + 1
                                continue
                            failure <- InstallStageWalkFailure.Open
                            failure_errno <- errno[0]
                            state <- InstallStageWalkState.Failed
                            break
                    if state == InstallStageWalkState.Failed:
                        path_length <- parent_path_length
                        -> Walk
                    child_info: mutable ElisascriptStat = ElisascriptStat{}
                    child_metadata_ok: bool = install_source_stat_descriptor(child_fd, child_info)
                    if child_metadata_ok and (child_info.device != entry_info.device or child_info.inode != entry_info.inode or child_info.user != root.user or (child_info.mode & DarwinStatMode::MASK) != DarwinStatMode.DIRECTORY):
                        close_status: int = elisascript_posix_close(child_fd)
                        close_failed <- true if close_status != 0
                        failure <- InstallStageWalkFailure.ArtifactChanged
                        state <- InstallStageWalkState.Failed
                        path_length <- parent_path_length
                        -> Walk
                    if not child_metadata_ok:
                        close_status: int = elisascript_posix_close(child_fd)
                        close_failed <- true if close_status != 0
                        failure <- InstallStageWalkFailure.Metadata
                        state <- InstallStageWalkState.Failed
                        path_length <- parent_path_length
                        -> Walk
                    if (child_info.mode & InstallSourceMode::PERMISSION_MASK) != InstallSourceMode::DIRECTORY:
                        close_status: int = elisascript_posix_close(child_fd)
                        close_failed <- true if close_status != 0
                        failure <- InstallStageWalkFailure.ModeMismatch
                        state <- InstallStageWalkState.Failed
                        path_length <- parent_path_length
                        -> Walk
                    named_info: mutable ElisascriptStat = ElisascriptStat{}
                    named_retries: mutable usize = 0
                    named_status: mutable int = -1
                    while named_status != 0:
                        named_status <- elisascript_posix_fstatat(parent_fd, (&entry.name[0]).cast[cstr], named_info, DarwinAtFlag::SYMLINK_NOFOLLOW)
                        if named_status != 0:
                            errno: mutable i32& = elisascript_posix_errno()
                            if errno[0] == InstallSourceErrno::EINTR and named_retries < Limits::EINTR_RETRIES:
                                named_retries <- named_retries + 1
                                continue
                            failure_errno <- errno[0]
                            break
                    if named_status != 0:
                        close_status: int = elisascript_posix_close(child_fd)
                        close_failed <- true if close_status != 0
                        failure <- InstallStageWalkFailure.Metadata
                        state <- InstallStageWalkState.Failed
                        path_length <- parent_path_length
                        -> Walk
                    if named_info.device != child_info.device or named_info.inode != child_info.inode or named_info.user != child_info.user or (named_info.mode & DarwinStatMode::MASK) != DarwinStatMode.DIRECTORY or (named_info.mode & InstallSourceMode::PERMISSION_MASK) != InstallSourceMode.DIRECTORY:
                        close_status: int = elisascript_posix_close(child_fd)
                        close_failed <- true if close_status != 0
                        failure <- InstallStageWalkFailure.ArtifactChanged
                        state <- InstallStageWalkState.Failed
                        path_length <- parent_path_length
                        -> Walk
                    child_stream: mutable heap void&? = elisascript_posix_fdopendir(child_fd)
                    if child_stream == null:
                        errno: mutable i32& = elisascript_posix_errno()
                        open_errno: i32 = errno[0]
                        close_status: int = elisascript_posix_close(child_fd)
                        close_failed <- true if close_status != 0
                        failure <- InstallStageWalkFailure.Open
                        failure_errno <- open_errno
                        state <- InstallStageWalkState.Failed
                        path_length <- parent_path_length
                        -> Walk
                    frames[frame_count] <- InstallStageDirectoryFrame{directory: child_stream, path_length: path_length}
                    frame_count <- frame_count + 1
                    -> Walk

                Walk, InstallStageWalkState.Complete:
                    break

                Walk, InstallStageWalkState.Failed:
                    break

            while frame_count != 0:
                frame_count <- frame_count - 1
                abandoned: InstallStageDirectoryFrame = frames[frame_count]
                if abandoned.directory != null and elisascript_posix_closedir(abandoned.directory) != 0:
                    cleanup_close_failed <- true
            raise InstallSourceError.StageTreeDirectoryCloseFailed if close_failed or cleanup_close_failed or failure == InstallStageWalkFailure.Close
            raise InstallSourceError.StageTreeEntryLimitExceeded if failure == InstallStageWalkFailure.EntryLimit
            raise InstallSourceError.StageTreeDepthLimitExceeded if failure == InstallStageWalkFailure.DepthLimit
            raise InstallSourceError.StageTreePathLimitExceeded if failure == InstallStageWalkFailure.PathLimit
            raise InstallSourceError.StageTreeUnexpectedEntry if failure == InstallStageWalkFailure.UnexpectedEntry
            raise InstallSourceError.StageTreeArtifactChanged if failure == InstallStageWalkFailure.ArtifactChanged
            raise InstallSourceError.StageModeMismatch if failure == InstallStageWalkFailure.ModeMismatch
            raise InstallSourceError.StageTreeReadFailed(failure_errno) if failure == InstallStageWalkFailure.Read
            raise InstallSourceError.StageTreeOpenFailed(failure_errno) if failure == InstallStageWalkFailure.Open
            raise InstallSourceError.StageTreeMetadataFailed if failure == InstallStageWalkFailure.Metadata
            for artifact_index in 0..<plan.artifacts.count |plan, seen_files, seen_parent_directories|:
                raise InstallSourceError.StageTreeMissingArtifact if not seen_files[artifact_index]
                raise InstallSourceError.StageTreeMissingDirectory if seen_parent_directories[artifact_index] != install_source_stage_parent_count(plan.artifacts[artifact_index].destination_path)
            return true


    public:
        # Create an exclusively named private sibling beneath a caller-owned
        # directory capability. The caller supplies a unique leaf and can
        # recover the name if a post-mkdir operation has an uncertain outcome.
        # The returned descriptor is owned by the handle; parent_fd is borrowed.
        def create_install_stage_root_at(parent_fd: int, leaf: sview) -> InstallStageRootHandle error[InstallSourceError] can[Blocking.IO, Unsafe.PointerCast]:
            raise InstallSourceError.StageParentInvalid if parent_fd < 0
            parent_info: mutable ElisascriptStat = ElisascriptStat{}
            raise InstallSourceError.StageMetadataFailed if not install_source_stat_descriptor(parent_fd, parent_info)
            raise InstallSourceError.StageParentInvalid if (parent_info.mode & DarwinStatMode::MASK) != DarwinStatMode.DIRECTORY
            parent_permissions: u16 = parent_info.mode & InstallSourceMode::PERMISSION_MASK
            effective_user: u32 = install_source_effective_user()
            raise InstallSourceError.StageParentNotTrusted if parent_info.user != effective_user and parent_info.user != 0u32
            raise InstallSourceError.StageParentNotTrusted if (parent_permissions & 18u16) != 0u16 and (parent_permissions & InstallSourceMode::STICKY) == 0u16

            leaf_storage: mutable u8[256] = zeroed
            leaf_buffer: mutable u8& = (&leaf_storage[0])
            leaf_length: usize = install_source_copy_stage_root_leaf(leaf, leaf_buffer)
            raise InstallSourceError.StageRootNameInvalid if leaf_length == 0
            create_status: int = elisascript_posix_mkdirat(parent_fd, leaf_buffer.cast[cstr], InstallSourceMode::PRIVATE_DIRECTORY.i32())
            if create_status != 0:
                errno: mutable i32& = elisascript_posix_errno()
                create_errno: i32 = errno[0]
                raise InstallSourceError.StageRootNameCollision if create_errno == InstallSourceErrno::EEXIST
                raise InstallSourceError.StageRootCreateOutcomeUnknown(create_errno) if create_errno == InstallSourceErrno::EINTR
                raise InstallSourceError.StageRootCreateFailed(create_errno)

            open_retries: mutable usize = 0
            stage_fd: mutable int = -1
            open_errno: mutable i32 = 0
            open_flags: int = DarwinOpenFlags::RDONLY | DarwinOpenFlags::DIRECTORY | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
            while stage_fd < 0 and open_retries <= Limits::EINTR_RETRIES:
                stage_fd <- elisascript_posix_openat(parent_fd, leaf_buffer.cast[cstr], open_flags, 0u32)
                if stage_fd < 0:
                    errno: mutable i32& = elisascript_posix_errno()
                    open_errno <- errno[0]
                    if open_errno == InstallSourceErrno::EINTR:
                        open_retries <- open_retries + 1
                        continue
                    break
            raise InstallSourceError.StageRootOpenAfterCreateFailed(open_errno) if stage_fd < 0

            opened_info: mutable ElisascriptStat = ElisascriptStat{}
            if not install_source_stat_descriptor(stage_fd, opened_info):
                close_status: int = elisascript_posix_close(stage_fd)
                raise InstallSourceError.StageRootCloseFailed(close_status) if close_status != 0
                raise InstallSourceError.StageRootCleanupPending
            if opened_info.device != parent_info.device or opened_info.user != install_source_effective_user():
                close_status: int = elisascript_posix_close(stage_fd)
                raise InstallSourceError.StageRootCloseFailed(close_status) if close_status != 0
                raise InstallSourceError.StageRootEntryChanged
            root_proof: InstallStageRootProof = InstallStageRootProof{device: opened_info.device, inode: opened_info.inode, user: opened_info.user}
            named_info: mutable ElisascriptStat = ElisascriptStat{}
            named_ok: bool = install_source_stat_entry_at(parent_fd, leaf_buffer.cast[cstr], named_info, DarwinAtFlag::SYMLINK_NOFOLLOW)
            if not named_ok or not install_source_stage_root_identity_matches(named_info, root_proof):
                close_status: int = elisascript_posix_close(stage_fd)
                raise InstallSourceError.StageRootCloseFailed(close_status) if close_status != 0
                raise InstallSourceError.StageRootEntryChanged

            if elisascript_posix_fchmod(stage_fd, InstallSourceMode::PRIVATE_DIRECTORY.u32()) != 0:
                close_status: int = elisascript_posix_close(stage_fd)
                raise InstallSourceError.StageRootCloseFailed(close_status) if close_status != 0
                raise InstallSourceError.StageRootCleanupPending
            opened_info <- ElisascriptStat{}
            if not install_source_stat_descriptor(stage_fd, opened_info):
                close_status: int = elisascript_posix_close(stage_fd)
                raise InstallSourceError.StageRootCloseFailed(close_status) if close_status != 0
                raise InstallSourceError.StageRootCleanupPending
            named_info <- ElisascriptStat{}
            named_ok <- install_source_stat_entry_at(parent_fd, leaf_buffer.cast[cstr], named_info, DarwinAtFlag::SYMLINK_NOFOLLOW)
            if not named_ok or not install_source_stage_root_identity_matches(opened_info, root_proof) or not install_source_stage_root_identity_matches(named_info, root_proof) or (opened_info.mode & InstallSourceMode::PERMISSION_MASK) != InstallSourceMode::PRIVATE_DIRECTORY or (named_info.mode & InstallSourceMode::PERMISSION_MASK) != InstallSourceMode::PRIVATE_DIRECTORY:
                close_status: int = elisascript_posix_close(stage_fd)
                raise InstallSourceError.StageRootCloseFailed(close_status) if close_status != 0
                raise InstallSourceError.StageRootEntryChanged
            stage_sync_errno: i32 = install_source_sync_stage_descriptor(stage_fd)
            if stage_sync_errno != 0:
                close_status: int = elisascript_posix_close(stage_fd)
                raise InstallSourceError.StageRootCloseFailed(close_status) if close_status != 0
                raise InstallSourceError.StageDirectorySyncFailed(stage_sync_errno)
            parent_sync_errno: i32 = install_source_sync_stage_descriptor(parent_fd)
            if parent_sync_errno != 0:
                close_status: int = elisascript_posix_close(stage_fd)
                raise InstallSourceError.StageRootCloseFailed(close_status) if close_status != 0
                raise InstallSourceError.StageDirectorySyncFailed(parent_sync_errno)
            return InstallStageRootHandle{parent_descriptor: parent_fd, descriptor: stage_fd, leaf_length: leaf_length, leaf: leaf_storage, proof: root_proof}


        def close_install_stage_root(handle: mutable InstallStageRootHandle&) -> void error[InstallSourceError] can[Blocking.IO]:
            raise InstallSourceError.StageRootHandleInvalid if handle.descriptor < 0 or handle.parent_descriptor < 0 or handle.leaf_length == 0
            descriptor: int = handle.descriptor
            handle.descriptor <- -1
            close_status: int = elisascript_posix_close(descriptor)
            raise InstallSourceError.StageRootCloseFailed(close_status) if close_status != 0


        # Purely validate one receipt against its plan entry. Filesystem
        # provenance comes from verify_install_source_at; callers must retain
        # the returned stamp and re-observe it before copying if any time has
        # elapsed or another actor can modify the build tree.
        def validate_install_source_receipt(plan: InstallPlan&, receipt: InstallSourceReceipt) -> bool error[InstallContractError, InstallSourceError] can[Memory.Allocate, Abort.Panic]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.ArtifactIndexOutOfRange if receipt.artifact_index >= plan.artifacts.count
            return try install_source_receipt_matches_artifact(plan.artifacts[receipt.artifact_index], receipt.artifact_index, receipt)


        # A verified manifest is complete only when there is exactly one
        # receipt per artifact in canonical plan order. This rejects a caller
        # that accidentally omits an artifact or reuses one receipt twice.
        def validate_install_source_receipts(plan: InstallPlan&, receipts: darray[InstallSourceReceipt]) -> bool error[InstallContractError, InstallSourceError] can[Memory.Allocate, Abort.Panic]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.ReceiptCountMismatch if receipts.count != plan.artifacts.count
            for index in 0..<plan.artifacts.count |plan, receipts|:
                _ = try install_source_receipt_matches_artifact(plan.artifacts[index], index, receipts[index])
            return true


        # Observe and hash one artifact through EsBuildIncrementalPosix. That
        # observer opens every path segment with no-follow semantics, checks
        # regular-file identity and metadata before/after reading, and bounds
        # the input to the shared build/install file ceiling.
        def verify_install_source_at(a: mutable Arena&, root_fd: int, plan: InstallPlan&, artifact_index: usize) -> InstallSourceReceipt error[InstallContractError, InstallSourceError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.PlanNotPlanned if plan.state != InstallState.Planned
            raise InstallSourceError.ArtifactIndexOutOfRange if artifact_index >= plan.artifacts.count
            return try observe_install_source_entry_at(a, root_fd, plan.artifacts[artifact_index], artifact_index)


        # Hash a complete install plan in canonical artifact order. The
        # observer rewinds its temporary content buffer after each source, so
        # this retains only the bounded receipt vector rather than aggregate
        # artifact bytes. Stamps remain point-in-time evidence and must be
        # revalidated by the later staging adapter.
        def verify_install_sources_at(a: mutable Arena&, root_fd: int, plan: mutable InstallPlan&) -> darray[InstallSourceReceipt] error[InstallContractError, InstallSourceError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.PlanNotPlanned if plan.state != InstallState.Planned
            receipts: mutable darray[InstallSourceReceipt] = []
            for index in 0..<plan.artifacts.count |plan, receipts, a, root_fd|:
                receipts.push(try observe_install_source_entry_at(a, root_fd, plan.artifacts[index], index))
            _ = try validate_install_source_receipts(plan, receipts)
            _ = try advance_install_plan(plan, InstallEvent.VerifySources)
            return receipts


        # Read back one expected entry from a private staging root. Content is
        # hashed with the shared no-follow observer; permissions are inspected
        # on a separately opened descriptor and must match the fixed install
        # mapping (Data=0644, Executable=0755).
        def verify_install_stage_artifact_at(a: mutable Arena&, stage_root_fd: int, plan: InstallPlan&, artifact_index: usize) -> InstallStageArtifactProof error[InstallContractError, InstallSourceError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.PlanNotSourcesVerified if plan.state != InstallState.SourcesVerified
            root_proof: InstallStageRootProof = try install_source_require_private_stage_root(stage_root_fd)
            raise InstallSourceError.ArtifactIndexOutOfRange if artifact_index >= plan.artifacts.count
            artifact: InstallArtifact = plan.artifacts[artifact_index]
            initial_stamp: BuildIncrementalFileStamp = try observe_build_incremental_file_stamp_at(stage_root_fd, artifact.destination_path)
            raise InstallSourceError.StageArtifactMissing if not initial_stamp.present
            raise InstallSourceError.ByteCountMismatch if initial_stamp.size != artifact.byte_count
            stamp: mutable BuildIncrementalFileStamp = BuildIncrementalFileStamp{path: artifact.destination_path}
            observed: BuildIncrementalObservation = try observe_build_incremental_file_with_stamp_at(a, stage_root_fd, artifact.destination_path, stamp)
            raise InstallSourceError.StageArtifactChanged if not observed.present or not install_source_stamp_equal(initial_stamp, stamp[0])
            raise InstallSourceError.StageDigestMismatch if observed.fingerprint != artifact.digest_0 or observed.fingerprint_word1 != artifact.digest_1 or observed.fingerprint_word2 != artifact.digest_2 or observed.fingerprint_word3 != artifact.digest_3
            mode_matches: bool = try install_source_stage_mode_matches(stage_root_fd, root_proof, artifact.destination_path, stamp[0], artifact.mode)
            raise InstallSourceError.StageModeMismatch if not mode_matches
            return InstallStageArtifactProof{
                receipt: InstallStageReceipt{
                    artifact_index: artifact_index,
                    destination_path: artifact.destination_path,
                    byte_count: stamp[0].size,
                    digest_0: observed.fingerprint,
                    digest_1: observed.fingerprint_word1,
                    digest_2: observed.fingerprint_word2,
                    digest_3: observed.fingerprint_word3,
                    mode: artifact.mode
                },
                stage_stamp: stamp[0]
            }


        # Admit staging only after every planned output passes content/mode
        # verification and a bounded whole-tree scan proves exact manifest
        # closure: no extras, links, unsupported entries, or missing parents.
        def verify_install_stage_at(a: mutable Arena&, stage_root_fd: int, plan: mutable InstallPlan&) -> InstallStageProof error[InstallContractError, InstallSourceError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.PlanNotSourcesVerified if plan.state != InstallState.SourcesVerified
            root_proof: InstallStageRootProof = try install_source_require_private_stage_root(stage_root_fd)
            artifact_proofs: mutable darray[InstallStageArtifactProof] = []
            receipts: mutable darray[InstallStageReceipt] = []
            for index in 0..<plan.artifacts.count |plan, artifact_proofs, receipts, a, stage_root_fd|:
                artifact_proof: InstallStageArtifactProof = try verify_install_stage_artifact_at(a, stage_root_fd, plan, index)
                artifact_proofs.push(artifact_proof)
                receipts.push(artifact_proof.receipt)
            _ = try install_source_validate_stage_tree(stage_root_fd, root_proof, plan, artifact_proofs)
            _ = try stage_install_plan(plan, receipts)
            _ = try advance_install_plan(plan, InstallEvent.Verify)
            return InstallStageProof{root: root_proof, artifacts: artifact_proofs}


        # Recheck the retained point-in-time proof immediately before publish.
        # This avoids rehashing large outputs while detecting replacement,
        # ordinary content mutation, mode changes, and stage-root substitution.
        # Success consumes the proof by moving the plan to PublishReady.
        def revalidate_install_stage_at(stage_root_fd: int, plan: mutable InstallPlan&, proof: InstallStageProof&) -> InstallState error[InstallContractError, InstallSourceError, OpenError] can[Blocking.IO, Abort.Panic, Unsafe.PointerCast]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.StageRevalidationNotReady if plan.state != InstallState.Verified
            root_now: InstallStageRootProof = try install_source_require_private_stage_root(stage_root_fd)
            raise InstallSourceError.StageProofRootChanged if root_now.device != proof.root.device or root_now.inode != proof.root.inode or root_now.user != proof.root.user
            raise InstallSourceError.StageProofCountMismatch if proof.artifacts.count != plan.artifacts.count
            for index in 0..<plan.artifacts.count |plan, proof|:
                artifact: InstallArtifact = plan.artifacts[index]
                entry: InstallStageArtifactProof = proof.artifacts[index]
                receipt: InstallStageReceipt = entry.receipt
                stored: InstallStageReceipt = plan.staged_receipts[index]
                raise InstallSourceError.ReceiptOrderMismatch if receipt.artifact_index != index or stored.artifact_index != index
                raise InstallSourceError.ReceiptPathMismatch if receipt.destination_path != artifact.destination_path or stored.destination_path != artifact.destination_path or entry.stage_stamp.path != artifact.destination_path
                raise InstallSourceError.ByteCountMismatch if receipt.byte_count != artifact.byte_count or stored.byte_count != artifact.byte_count or entry.stage_stamp.size != artifact.byte_count
                raise InstallSourceError.DigestMismatch if receipt.digest_0 != artifact.digest_0 or receipt.digest_1 != artifact.digest_1 or receipt.digest_2 != artifact.digest_2 or receipt.digest_3 != artifact.digest_3
                raise InstallSourceError.StageProofReceiptMismatch if receipt.digest_0 != stored.digest_0 or receipt.digest_1 != stored.digest_1 or receipt.digest_2 != stored.digest_2 or receipt.digest_3 != stored.digest_3 or receipt.mode != stored.mode or receipt.byte_count != stored.byte_count
                raise InstallSourceError.StageArtifactChanged if not entry.stage_stamp.present
                current_stamp: BuildIncrementalFileStamp = try observe_build_incremental_file_stamp_at(stage_root_fd, artifact.destination_path)
                raise InstallSourceError.StageArtifactChanged if not install_source_stamp_equal(entry.stage_stamp, current_stamp)
                mode_matches: bool = try install_source_stage_mode_matches(stage_root_fd, root_now, artifact.destination_path, current_stamp, artifact.mode)
                raise InstallSourceError.StageModeMismatch if not mode_matches
            _ = try install_source_validate_stage_tree(stage_root_fd, root_now, plan, proof.artifacts)
            return try advance_install_plan(plan, InstallEvent.Preflight)


        # Open the exact source snapshot admitted by the complete source batch.
        # The retained no-follow descriptor lets the caller stream it into the
        # private install tree without reading the entire artifact into memory.
        def open_install_source_for_copy(root_fd: int, plan: InstallPlan&, receipt: InstallSourceReceipt) -> InstallSourceCopyHandle error[InstallContractError, InstallSourceError, OpenError] can[Blocking.IO, Unsafe.PointerCast]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.PlanNotSourcesVerified if plan.state != InstallState.SourcesVerified
            raise InstallSourceError.ArtifactIndexOutOfRange if receipt.artifact_index >= plan.artifacts.count
            _ = try install_source_receipt_matches_artifact(plan.artifacts[receipt.artifact_index], receipt.artifact_index, receipt)
            opened: OpenedFile = try open_build_incremental_file_at(root_fd, receipt.source_path)
            raise InstallSourceError.SourceChanged if not opened.present
            if not install_source_stamp_equal(receipt.source_stamp, BuildIncrementalFileStamp{path: receipt.source_path, present: opened.present, size: opened.size, device: opened.device, inode: opened.inode, modify_time: opened.modify_time, change_time: opened.change_time}):
                close_status: int = elisascript_posix_close(opened.descriptor)
                raise OpenError.CloseFailed(receipt.source_path) if close_status != 0
                raise InstallSourceError.SourceChanged
            return InstallSourceCopyHandle{root_descriptor: root_fd, source_descriptor: opened.descriptor, receipt: receipt}


        # Read at most one 64 KiB chunk. Call until this returns zero, then
        # finish_install_source_copy; on any read error, cancel the handle to
        # close the retained descriptor before abandoning the staging attempt.
        def read_install_source_chunk(handle: mutable InstallSourceCopyHandle&, buffer: mutable u8&, capacity: usize) -> usize error[InstallSourceError] can[Blocking.IO, Unsafe.PointerCast]:
            raise InstallSourceError.CopyHandleInvalid if handle.root_descriptor < 0 or handle.source_descriptor < 0
            raise InstallSourceError.CopyHandleFailed if handle.failed
            raise InstallSourceError.CopyBufferInvalid if buffer == null or capacity == 0 or capacity > Limits::STREAM_CHUNK_BYTES
            raise InstallSourceError.CopyHandleInvalid if handle.bytes_read > handle.receipt.byte_count or handle.read_calls > Limits::STREAM_READ_CALLS
            return 0 if handle.bytes_read == handle.receipt.byte_count
            state: mutable InstallSourceReadState = InstallSourceReadState.Read
            amount: mutable usize = 0
            machine over state:
                state Read
                start Read

                Read, InstallSourceReadState.Read:
                    if handle.read_calls >= Limits::STREAM_READ_CALLS:
                        handle.failed <- true
                        raise InstallSourceError.CopyReadLimitExceeded
                    remaining: usize = handle.receipt.byte_count - handle.bytes_read
                    requested: usize = capacity if capacity < remaining else remaining
                    read_amount: isize = elisascript_posix_read(handle.source_descriptor, buffer.cast[mutable void&], requested)
                    handle.read_calls <- handle.read_calls + 1
                    if read_amount < 0:
                        errno: mutable i32& = elisascript_posix_errno()
                        if errno[0] == InstallSourceErrno::EINTR and handle.interrupted < Limits::EINTR_RETRIES:
                            handle.interrupted <- handle.interrupted + 1
                            -> Read
                        handle.failed <- true
                        raise InstallSourceError.CopyReadFailed(errno[0])
                    if read_amount == 0:
                        handle.failed <- true
                        raise InstallSourceError.CopyReadIncomplete
                    if read_amount.usize() > requested:
                        handle.failed <- true
                        raise InstallSourceError.CopyReadFailed(InstallSourceErrno::EIO)
                    amount <- read_amount.usize()
                    handle.bytes_read <- handle.bytes_read + amount
                    handle.interrupted <- 0
                    state <- InstallSourceReadState.Done
                    -> Read

                Read, InstallSourceReadState.Done:
                    break

            return amount


        # The caller may discard a partially streamed source after any failed
        # staging write. Closing consumes the descriptor exactly once and does
        # not claim that the copy was complete or stable.
        def cancel_install_source_copy(handle: mutable InstallSourceCopyHandle&) -> bool error[InstallSourceError] can[Blocking.IO]:
            raise InstallSourceError.CopyHandleInvalid if handle.root_descriptor < 0 or handle.source_descriptor < 0
            close_status: int = install_source_close_descriptor(handle)
            raise InstallSourceError.CopySourceCloseFailed(close_status) if close_status != 0
            return true


        # Complete the streaming receipt only after every expected byte was
        # consumed, the open descriptor still matches its admission stamp, and
        # the source path still names that same snapshot. A successful return
        # is safe input for staging; it is not a publication receipt.
        def finish_install_source_copy(handle: mutable InstallSourceCopyHandle&) -> bool error[InstallSourceError] can[Blocking.IO, Unsafe.PointerCast]:
            raise InstallSourceError.CopyHandleInvalid if handle.root_descriptor < 0 or handle.source_descriptor < 0
            if handle.failed:
                close_status: int = install_source_close_descriptor(handle)
                raise InstallSourceError.CopySourceCloseFailed(close_status) if close_status != 0
                raise InstallSourceError.CopyHandleFailed
            descriptor_info: mutable ElisascriptStat = ElisascriptStat{}
            descriptor_matches: bool = install_source_stat_descriptor(handle.source_descriptor, descriptor_info) and install_source_stat_matches_stamp(descriptor_info, handle.receipt.source_stamp)
            named_matches: mutable bool = false
            catch observe_build_incremental_file_stamp_at(handle.root_descriptor, handle.receipt.source_path):
                ok observed:
                    named_matches <- install_source_stamp_equal(handle.receipt.source_stamp, observed)
                error failure:
                    named_matches <- false
            close_status: int = install_source_close_descriptor(handle)
            raise InstallSourceError.CopySourceCloseFailed(close_status) if close_status != 0
            raise InstallSourceError.CopyReadIncomplete if handle.bytes_read != handle.receipt.byte_count
            raise InstallSourceError.SourceChanged if not descriptor_matches or not named_matches
            return true


        # Stream one already-verified source receipt into a private stage.
        # Parents are created one component at a time with no-follow opens;
        # the incomplete file remains private mode until source revalidation,
        # then receives its manifest mode and is synced before the caller's
        # later readback/closure verification. A failure aborts the stage; it
        # never returns a receipt that could be mistaken for readback proof.
        def copy_install_source_to_stage(stage: mutable InstallStageRootHandle&, source_root_fd: int, plan: InstallPlan&, receipt: InstallSourceReceipt) -> usize error[InstallContractError, InstallSourceError, OpenError] can[Blocking.IO, Unsafe.PointerCast]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.PlanNotSourcesVerified if plan.state != InstallState.SourcesVerified
            raise InstallSourceError.StageRootHandleInvalid if not install_source_stage_root_handle_matches(stage)
            raise InstallSourceError.ArtifactIndexOutOfRange if receipt.artifact_index >= plan.artifacts.count
            _ = try install_source_receipt_matches_artifact(plan.artifacts[receipt.artifact_index], receipt.artifact_index, receipt)
            artifact: InstallArtifact = plan.artifacts[receipt.artifact_index]
            parent: mutable InstallStageDestinationParent = try install_source_open_stage_destination_parent(stage, artifact.destination_path)
            source: mutable InstallSourceCopyHandle = InstallSourceCopyHandle{root_descriptor: -1, source_descriptor: -1, receipt: receipt}

            catch open_install_source_for_copy(source_root_fd, plan, receipt):
                ok opened:
                    source <- opened
                error failure:
                    cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, -1, parent)
                    _ = try install_source_require_stage_copy_cleanup(cleanup)
                    raise failure

            file_flags: int = DarwinOpenFlags::WRONLY | DarwinOpenFlags::CREATE | DarwinOpenFlags::EXCLUSIVE | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
            stage_file_fd: int = elisascript_posix_openat(parent.descriptor, (&parent.leaf[0]).cast[cstr], file_flags, 384u32)
            if stage_file_fd < 0:
                errno: mutable i32& = elisascript_posix_errno()
                create_errno: i32 = errno[0]
                cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, -1, parent)
                _ = try install_source_require_stage_copy_cleanup(cleanup)
                raise InstallSourceError.StageFileCreateFailed(create_errno)

            stage_file_info: mutable ElisascriptStat = ElisascriptStat{}
            if not install_source_stat_descriptor(stage_file_fd, stage_file_info):
                cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, stage_file_fd, parent)
                _ = try install_source_require_stage_copy_cleanup(cleanup)
                raise InstallSourceError.StageFileMetadataFailed
            if (stage_file_info.mode & DarwinStatMode::MASK) != DarwinStatMode.REGULAR or stage_file_info.device != stage.proof.device or stage_file_info.user != stage.proof.user or stage_file_info.size != 0 or stage_file_info.link_count != 1u16:
                cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, stage_file_fd, parent)
                _ = try install_source_require_stage_copy_cleanup(cleanup)
                raise InstallSourceError.StageFileChanged
            stage_file_device: u32 = stage_file_info.device
            stage_file_inode: u64 = stage_file_info.inode
            if elisascript_posix_fchmod(stage_file_fd, 384u32) != 0:
                errno: mutable i32& = elisascript_posix_errno()
                mode_errno: i32 = errno[0]
                cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, stage_file_fd, parent)
                _ = try install_source_require_stage_copy_cleanup(cleanup)
                raise InstallSourceError.StageFileModeFailed(mode_errno)
            stage_file_info <- ElisascriptStat{}
            if not install_source_stat_descriptor(stage_file_fd, stage_file_info) or stage_file_info.device != stage_file_device or stage_file_info.inode != stage_file_inode or stage_file_info.user != stage.proof.user or stage_file_info.size != 0 or stage_file_info.link_count != 1u16 or (stage_file_info.mode & DarwinStatMode::MASK) != DarwinStatMode.REGULAR or (stage_file_info.mode & InstallSourceMode::PERMISSION_MASK) != 384u16:
                cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, stage_file_fd, parent)
                _ = try install_source_require_stage_copy_cleanup(cleanup)
                raise InstallSourceError.StageFileChanged
            stage_file_named_info: mutable ElisascriptStat = ElisascriptStat{}
            named_ok: bool = install_source_stat_entry_at(parent.descriptor, (&parent.leaf[0]).cast[cstr], stage_file_named_info, DarwinAtFlag::SYMLINK_NOFOLLOW)
            if not named_ok or stage_file_named_info.device != stage_file_device or stage_file_named_info.inode != stage_file_inode or stage_file_named_info.user != stage.proof.user or (stage_file_named_info.mode & DarwinStatMode::MASK) != DarwinStatMode.REGULAR or (stage_file_named_info.mode & InstallSourceMode::PERMISSION_MASK) != 384u16:
                cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, stage_file_fd, parent)
                _ = try install_source_require_stage_copy_cleanup(cleanup)
                raise InstallSourceError.StageFileChanged

            copy_buffer_storage: mutable u8[Limits::STREAM_CHUNK_BYTES] = zeroed
            copy_buffer: mutable u8& = (&copy_buffer_storage[0])
            bytes_copied: mutable usize = 0
            while bytes_copied < receipt.byte_count:
                remaining: usize = receipt.byte_count - bytes_copied
                capacity: usize = Limits::STREAM_CHUNK_BYTES if remaining > Limits::STREAM_CHUNK_BYTES else remaining
                chunk_length: mutable usize = 0
                catch read_install_source_chunk(source, copy_buffer, capacity):
                    ok amount:
                        chunk_length <- amount
                    error failure:
                        cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, stage_file_fd, parent)
                        _ = try install_source_require_stage_copy_cleanup(cleanup)
                        raise failure
                if chunk_length == 0 or chunk_length > remaining:
                    cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, stage_file_fd, parent)
                    _ = try install_source_require_stage_copy_cleanup(cleanup)
                    raise InstallSourceError.StageFileWriteIncomplete
                catch install_source_write_stage_fully(stage_file_fd, copy_buffer, chunk_length):
                    ok written:
                        bytes_copied <- bytes_copied + written
                    error failure:
                        cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, stage_file_fd, parent)
                        _ = try install_source_require_stage_copy_cleanup(cleanup)
                        raise failure

            catch finish_install_source_copy(source):
                ok finished:
                    _ = finished
                error failure:
                    cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, stage_file_fd, parent)
                    _ = try install_source_require_stage_copy_cleanup(cleanup)
                    raise failure

            final_mode: u16 = install_source_expected_mode(artifact.mode)
            if elisascript_posix_fchmod(stage_file_fd, final_mode.u32()) != 0:
                errno: mutable i32& = elisascript_posix_errno()
                mode_errno: i32 = errno[0]
                cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, stage_file_fd, parent)
                _ = try install_source_require_stage_copy_cleanup(cleanup)
                raise InstallSourceError.StageFileModeFailed(mode_errno)
            file_sync_errno: i32 = install_source_sync_stage_descriptor(stage_file_fd)
            if file_sync_errno != 0:
                cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, stage_file_fd, parent)
                _ = try install_source_require_stage_copy_cleanup(cleanup)
                raise InstallSourceError.StageFileSyncFailed(file_sync_errno)
            stage_file_info <- ElisascriptStat{}
            if not install_source_stat_descriptor(stage_file_fd, stage_file_info) or not install_source_stage_file_matches(stage_file_info, stage.proof, stage_file_device, stage_file_inode, receipt.byte_count, artifact.mode):
                cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, stage_file_fd, parent)
                _ = try install_source_require_stage_copy_cleanup(cleanup)
                raise InstallSourceError.StageFileChanged
            stage_file_named_info <- ElisascriptStat{}
            named_ok <- install_source_stat_entry_at(parent.descriptor, (&parent.leaf[0]).cast[cstr], stage_file_named_info, DarwinAtFlag::SYMLINK_NOFOLLOW)
            if not named_ok or not install_source_stage_file_matches(stage_file_named_info, stage.proof, stage_file_device, stage_file_inode, receipt.byte_count, artifact.mode):
                cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, stage_file_fd, parent)
                _ = try install_source_require_stage_copy_cleanup(cleanup)
                raise InstallSourceError.StageFileChanged

            parent_sync_errno: i32 = install_source_sync_stage_descriptor(parent.descriptor)
            if parent_sync_errno != 0:
                cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, stage_file_fd, parent)
                _ = try install_source_require_stage_copy_cleanup(cleanup)
                raise InstallSourceError.StageDirectorySyncFailed(parent_sync_errno)

            cleanup: InstallStageCopyCloseStatus = install_source_close_stage_copy_handles(source, stage_file_fd, parent)
            _ = try install_source_require_stage_copy_cleanup(cleanup)
            return bytes_copied


        # Stage each complete source receipt, then read back and verify the
        # exact tree before returning a proof. Copy or verification failures
        # discard the private root; cleanup failure takes precedence because
        # the caller must reconcile that still-present staging name.
        def stage_install_sources_at(a: mutable Arena&, stage: mutable InstallStageRootHandle&, source_root_fd: int, plan: mutable InstallPlan&, receipts: darray[InstallSourceReceipt]) -> InstallStageProof error[InstallContractError, InstallSourceError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.PlanNotSourcesVerified if plan.state != InstallState.SourcesVerified
            _ = try validate_install_source_receipts(plan, receipts)
            stage_empty: bool = try install_source_stage_root_is_empty(stage)
            raise InstallSourceError.StageRootNotEmpty if not stage_empty

            for index in 0..<plan.artifacts.count |plan, receipts, stage, source_root_fd|:
                catch copy_install_source_to_stage(stage, source_root_fd, plan, receipts[index]):
                    ok copied:
                        _ = copied
                    error failure:
                        # A failed population is a failed install attempt even
                        # when cleanup succeeds. Retrying requires a fresh plan
                        # and fresh source receipts, not reuse of stale state.
                        _ = try advance_install_plan(plan, InstallEvent.Fail)
                        catch remove_install_stage_root(stage):
                            ok removed:
                                _ = removed
                            error cleanup_failure:
                                raise cleanup_failure
                        raise failure

            catch verify_install_stage_at(a, stage.descriptor, plan):
                ok proof:
                    if not install_source_stage_root_handle_matches(stage) or proof.root.device != stage.proof.device or proof.root.inode != stage.proof.inode or proof.root.user != stage.proof.user:
                        _ = try advance_install_plan(plan, InstallEvent.Fail)
                        catch remove_install_stage_root(stage):
                            ok removed:
                                _ = removed
                            error cleanup_failure:
                                raise cleanup_failure
                        raise InstallSourceError.StageRootEntryChanged
                    return proof
                error failure:
                    # Verification errors happen before the verifier admits
                    # Staged, so the plan is still SourcesVerified here.
                    _ = try advance_install_plan(plan, InstallEvent.Fail)
                    catch remove_install_stage_root(stage):
                        ok removed:
                            _ = removed
                        error cleanup_failure:
                            raise cleanup_failure
                    raise failure


        # Remove an incomplete or rejected stage using only directory
        # capabilities. A failure may leave a partially emptied private tree;
        # the root handle remains available for an explicit retry unless the
        # root name itself was successfully removed.
        def remove_install_stage_root(handle: mutable InstallStageRootHandle&) -> bool error[InstallSourceError] can[Blocking.IO, Memory.Allocate, Memory.Release, Unsafe.PointerCast]:
            raise InstallSourceError.StageRootHandleInvalid if not install_source_stage_root_handle_matches(handle)
            duplicate_flags: int = DarwinOpenFlags::RDONLY | DarwinOpenFlags::DIRECTORY | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
            duplicate_retries: mutable usize = 0
            root_duplicate: mutable int = -1
            while root_duplicate < 0:
                root_duplicate <- elisascript_posix_openat(handle.descriptor, ".", duplicate_flags, 0u32)
                if root_duplicate < 0:
                    errno: mutable i32& = elisascript_posix_errno()
                    if errno[0] == InstallSourceErrno::EINTR and duplicate_retries < Limits::EINTR_RETRIES:
                        duplicate_retries <- duplicate_retries + 1
                        continue
                    raise InstallSourceError.StageCleanupOpenFailed(errno[0])

            root_info: mutable ElisascriptStat = ElisascriptStat{}
            if not install_source_stat_descriptor(root_duplicate, root_info):
                close_status: int = elisascript_posix_close(root_duplicate)
                raise InstallSourceError.StageCleanupCloseFailed(close_status) if close_status != 0
                raise InstallSourceError.StageTreeMetadataFailed
            if not install_source_stage_root_identity_matches(root_info, handle.proof) or root_info.user != install_source_effective_user() or (root_info.mode & InstallSourceMode::PERMISSION_MASK) != InstallSourceMode::PRIVATE_DIRECTORY:
                close_status: int = elisascript_posix_close(root_duplicate)
                raise InstallSourceError.StageCleanupCloseFailed(close_status) if close_status != 0
                raise InstallSourceError.StageCleanupChanged
            root_stream: mutable heap void&? = elisascript_posix_fdopendir(root_duplicate)
            if root_stream == null:
                errno: mutable i32& = elisascript_posix_errno()
                open_errno: i32 = errno[0]
                close_status: int = elisascript_posix_close(root_duplicate)
                raise InstallSourceError.StageCleanupCloseFailed(close_status) if close_status != 0
                raise InstallSourceError.StageCleanupOpenFailed(open_errno)

            frames: mutable InstallStageCleanupFrame[Limits::STAGE_WALK_DEPTH] = zeroed
            root_leaf_storage: mutable u8[256] = zeroed
            frames[0] <- InstallStageCleanupFrame{directory: root_stream, proof: handle.proof, parent_leaf_length: 0, parent_leaf: root_leaf_storage}
            frame_count: mutable usize = 1
            entries_seen: mutable usize = 0
            failure: mutable InstallStageCleanupFailure = InstallStageCleanupFailure.None
            failure_errno: mutable i32 = 0
            cleanup_directory_close_failed: mutable bool = false
            cleanup_close_status: mutable int = 0
            state: mutable InstallStageCleanupState = InstallStageCleanupState.Walk

            machine over state:
                state Walk
                start Walk

                Walk, InstallStageCleanupState.Walk:
                    if frame_count == 0:
                        state <- InstallStageCleanupState.Complete
                        -> Walk
                    top: usize = frame_count - 1
                    frame: InstallStageCleanupFrame = frames[top]
                    if frame.directory == null:
                        failure <- InstallStageCleanupFailure.Metadata
                        state <- InstallStageCleanupState.Failed
                        -> Walk
                    directory: mutable heap void& = frame.directory
                    errno_pointer: mutable i32& = elisascript_posix_errno()
                    errno_pointer[0] <- 0
                    entry_option: mutable ElisascriptDirectoryEntry&? = elisascript_posix_readdir(directory)
                    if entry_option == null:
                        if errno_pointer[0] == InstallSourceErrno::EINTR and frame.interrupted < Limits::EINTR_RETRIES:
                            frames[top].interrupted <- frame.interrupted + 1
                            -> Walk
                        if errno_pointer[0] != 0:
                            failure <- InstallStageCleanupFailure.Read
                            failure_errno <- errno_pointer[0]
                            state <- InstallStageCleanupState.Failed
                            -> Walk

                        closing: InstallStageCleanupFrame = frames[top]
                        directory_fd: int = elisascript_posix_dirfd(directory)
                        directory_info: mutable ElisascriptStat = ElisascriptStat{}
                        if directory_fd < 0 or not install_source_stat_descriptor(directory_fd, directory_info):
                            failure <- InstallStageCleanupFailure.Metadata
                            state <- InstallStageCleanupState.Failed
                        else:
                            if not install_source_stage_root_identity_matches(directory_info, closing.proof):
                                failure <- InstallStageCleanupFailure.Changed
                                state <- InstallStageCleanupState.Failed
                            else:
                                sync_errno: i32 = install_source_sync_stage_descriptor(directory_fd)
                                if sync_errno != 0:
                                    failure <- InstallStageCleanupFailure.Sync
                                    failure_errno <- sync_errno
                                    state <- InstallStageCleanupState.Failed

                        frames[top].directory <- null
                        frame_count <- frame_count - 1
                        close_status: int = elisascript_posix_closedir(closing.directory)
                        if close_status != 0:
                            failure <- InstallStageCleanupFailure.DirectoryClose
                            state <- InstallStageCleanupState.Failed
                        if state == InstallStageCleanupState.Failed:
                            -> Walk

                        if frame_count == 0:
                            state <- InstallStageCleanupState.Complete
                            -> Walk

                        parent_frame: InstallStageCleanupFrame = frames[frame_count - 1]
                        parent_directory: mutable heap void& = parent_frame.directory
                        parent_fd: int = elisascript_posix_dirfd(parent_directory)
                        if parent_fd < 0:
                            failure <- InstallStageCleanupFailure.Metadata
                            state <- InstallStageCleanupState.Failed
                            -> Walk
                        child_name: u8& = (&closing.parent_leaf[0])
                        if closing.parent_leaf_length == 0 or closing.parent_leaf_length >= 256 or closing.parent_leaf[closing.parent_leaf_length] != 0u8:
                            failure <- InstallStageCleanupFailure.NameInvalid
                            state <- InstallStageCleanupState.Failed
                            -> Walk
                        named_info: mutable ElisascriptStat = ElisascriptStat{}
                        if not install_source_stat_entry_at(parent_fd, child_name.cast[cstr], named_info, DarwinAtFlag::SYMLINK_NOFOLLOW):
                            failure <- InstallStageCleanupFailure.Changed
                            state <- InstallStageCleanupState.Failed
                            -> Walk
                        if not install_source_stage_root_identity_matches(named_info, closing.proof):
                            failure <- InstallStageCleanupFailure.Changed
                            state <- InstallStageCleanupState.Failed
                            -> Walk
                        unlink_status: int = elisascript_posix_unlinkat(parent_fd, child_name.cast[cstr], DarwinAtFlag::REMOVE_DIRECTORY)
                        if unlink_status != 0:
                            errno: mutable i32& = elisascript_posix_errno()
                            failure_errno <- errno[0]
                            failure <- InstallStageCleanupFailure.UnlinkUnknown if failure_errno == InstallSourceErrno::EINTR else InstallStageCleanupFailure.Unlink
                            state <- InstallStageCleanupState.Failed
                            -> Walk
                        parent_sync_errno: i32 = install_source_sync_stage_descriptor(parent_fd)
                        if parent_sync_errno != 0:
                            failure <- InstallStageCleanupFailure.Sync
                            failure_errno <- parent_sync_errno
                            state <- InstallStageCleanupState.Failed
                        -> Walk

                    frames[top].interrupted <- 0
                    entry: mutable ElisascriptDirectoryEntry& = entry_option
                    name_length: usize = entry.name_length.usize()
                    if entry.record_length == 0u16 or name_length == 0 or name_length >= 1024 or entry.name[name_length] != 0u8:
                        failure <- InstallStageCleanupFailure.Metadata
                        state <- InstallStageCleanupState.Failed
                        -> Walk
                    if (name_length == 1 and entry.name[0] == 46u8) or (name_length == 2 and entry.name[0] == 46u8 and entry.name[1] == 46u8):
                        -> Walk
                    if entries_seen >= Limits::STAGE_WALK_ENTRIES:
                        failure <- InstallStageCleanupFailure.EntryLimit
                        state <- InstallStageCleanupState.Failed
                        -> Walk
                    entries_seen <- entries_seen + 1
                    name_storage: mutable u8[256] = zeroed
                    name_buffer: mutable u8& = (&name_storage[0])
                    copied_name_length: usize = install_source_copy_cleanup_name((&entry.name[0]), name_length, name_buffer)
                    if copied_name_length == 0:
                        failure <- InstallStageCleanupFailure.NameInvalid
                        state <- InstallStageCleanupState.Failed
                        -> Walk

                    parent_fd: int = elisascript_posix_dirfd(directory)
                    if parent_fd < 0:
                        failure <- InstallStageCleanupFailure.Metadata
                        state <- InstallStageCleanupState.Failed
                        -> Walk
                    entry_info: mutable ElisascriptStat = ElisascriptStat{}
                    if not install_source_stat_entry_at(parent_fd, name_buffer.cast[cstr], entry_info, DarwinAtFlag::SYMLINK_NOFOLLOW):
                        failure <- InstallStageCleanupFailure.Metadata
                        state <- InstallStageCleanupState.Failed
                        -> Walk
                    if entry_info.device != handle.proof.device or entry_info.user != handle.proof.user:
                        failure <- InstallStageCleanupFailure.Changed
                        state <- InstallStageCleanupState.Failed
                        -> Walk
                    entry_kind: u16 = entry_info.mode & DarwinStatMode::MASK
                    if entry_kind == DarwinStatMode::DIRECTORY:
                        if frame_count >= Limits::STAGE_WALK_DEPTH:
                            failure <- InstallStageCleanupFailure.DepthLimit
                            state <- InstallStageCleanupState.Failed
                            -> Walk
                        child_retries: mutable usize = 0
                        child_fd: mutable int = -1
                        child_flags: int = DarwinOpenFlags::RDONLY | DarwinOpenFlags::DIRECTORY | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
                        while child_fd < 0:
                            child_fd <- elisascript_posix_openat(parent_fd, name_buffer.cast[cstr], child_flags, 0u32)
                            if child_fd < 0:
                                errno: mutable i32& = elisascript_posix_errno()
                                if errno[0] == InstallSourceErrno::EINTR and child_retries < Limits::EINTR_RETRIES:
                                    child_retries <- child_retries + 1
                                    continue
                                failure_errno <- errno[0]
                                failure <- InstallStageCleanupFailure.Open
                                state <- InstallStageCleanupState.Failed
                                break
                        if state == InstallStageCleanupState.Failed:
                            -> Walk
                        child_info: mutable ElisascriptStat = ElisascriptStat{}
                        if not install_source_stat_descriptor(child_fd, child_info):
                            close_status: int = elisascript_posix_close(child_fd)
                            cleanup_close_status <- close_status if close_status != 0
                            failure <- InstallStageCleanupFailure.Metadata
                            state <- InstallStageCleanupState.Failed
                            -> Walk
                        if not install_source_stage_root_identity_matches(child_info, InstallStageRootProof{device: entry_info.device, inode: entry_info.inode, user: entry_info.user}):
                            close_status: int = elisascript_posix_close(child_fd)
                            cleanup_close_status <- close_status if close_status != 0
                            failure <- InstallStageCleanupFailure.Changed
                            state <- InstallStageCleanupState.Failed
                            -> Walk
                        named_child: mutable ElisascriptStat = ElisascriptStat{}
                        if not install_source_stat_entry_at(parent_fd, name_buffer.cast[cstr], named_child, DarwinAtFlag::SYMLINK_NOFOLLOW) or not install_source_stage_root_identity_matches(named_child, InstallStageRootProof{device: child_info.device, inode: child_info.inode, user: child_info.user}):
                            close_status: int = elisascript_posix_close(child_fd)
                            cleanup_close_status <- close_status if close_status != 0
                            failure <- InstallStageCleanupFailure.Changed
                            state <- InstallStageCleanupState.Failed
                            -> Walk
                        child_stream: mutable heap void&? = elisascript_posix_fdopendir(child_fd)
                        if child_stream == null:
                            errno: mutable i32& = elisascript_posix_errno()
                            failure_errno <- errno[0]
                            close_status: int = elisascript_posix_close(child_fd)
                            cleanup_close_status <- close_status if close_status != 0
                            failure <- InstallStageCleanupFailure.Open
                            state <- InstallStageCleanupState.Failed
                            -> Walk
                        frames[frame_count] <- InstallStageCleanupFrame{directory: child_stream, proof: InstallStageRootProof{device: child_info.device, inode: child_info.inode, user: child_info.user}, parent_leaf_length: copied_name_length, parent_leaf: name_storage}
                        frame_count <- frame_count + 1
                        -> Walk

                    named_leaf: mutable ElisascriptStat = ElisascriptStat{}
                    if not install_source_stat_entry_at(parent_fd, name_buffer.cast[cstr], named_leaf, DarwinAtFlag::SYMLINK_NOFOLLOW) or named_leaf.device != entry_info.device or named_leaf.inode != entry_info.inode or named_leaf.user != entry_info.user or (named_leaf.mode & DarwinStatMode::MASK) != entry_kind:
                        failure <- InstallStageCleanupFailure.Changed
                        state <- InstallStageCleanupState.Failed
                        -> Walk
                    unlink_status: int = elisascript_posix_unlinkat(parent_fd, name_buffer.cast[cstr], 0)
                    if unlink_status != 0:
                        errno: mutable i32& = elisascript_posix_errno()
                        failure_errno <- errno[0]
                        failure <- InstallStageCleanupFailure.UnlinkUnknown if failure_errno == InstallSourceErrno::EINTR else InstallStageCleanupFailure.Unlink
                        state <- InstallStageCleanupState.Failed
                        -> Walk
                    -> Walk

                Walk, InstallStageCleanupState.Complete:
                    break

                Walk, InstallStageCleanupState.Failed:
                    break

            while frame_count != 0:
                frame_count <- frame_count - 1
                abandoned: InstallStageCleanupFrame = frames[frame_count]
                frames[frame_count].directory <- null
                if abandoned.directory != null and elisascript_posix_closedir(abandoned.directory) != 0:
                    cleanup_directory_close_failed <- true

            raise InstallSourceError.StageCleanupCloseFailed(cleanup_close_status) if cleanup_close_status != 0
            raise InstallSourceError.StageCleanupDirectoryCloseFailed if cleanup_directory_close_failed or failure == InstallStageCleanupFailure.DirectoryClose
            raise InstallSourceError.StageCleanupEntryLimitExceeded if failure == InstallStageCleanupFailure.EntryLimit
            raise InstallSourceError.StageCleanupDepthLimitExceeded if failure == InstallStageCleanupFailure.DepthLimit
            raise InstallSourceError.StageCleanupNameInvalid if failure == InstallStageCleanupFailure.NameInvalid
            raise InstallSourceError.StageCleanupChanged if failure == InstallStageCleanupFailure.Changed
            raise InstallSourceError.StageCleanupReadFailed(failure_errno) if failure == InstallStageCleanupFailure.Read
            raise InstallSourceError.StageCleanupOpenFailed(failure_errno) if failure == InstallStageCleanupFailure.Open
            raise InstallSourceError.StageCleanupOutcomeUnknown(failure_errno) if failure == InstallStageCleanupFailure.UnlinkUnknown
            raise InstallSourceError.StageCleanupFailed(failure_errno) if failure == InstallStageCleanupFailure.Unlink
            raise InstallSourceError.StageDirectorySyncFailed(failure_errno) if failure == InstallStageCleanupFailure.Sync
            raise InstallSourceError.StageTreeMetadataFailed if failure == InstallStageCleanupFailure.Metadata

            raise InstallSourceError.StageCleanupChanged if not install_source_stage_root_handle_matches(handle)
            root_leaf: u8& = (&handle.leaf[0])
            root_unlink_status: int = elisascript_posix_unlinkat(handle.parent_descriptor, root_leaf.cast[cstr], DarwinAtFlag::REMOVE_DIRECTORY)
            if root_unlink_status != 0:
                errno: mutable i32& = elisascript_posix_errno()
                raise InstallSourceError.StageCleanupOutcomeUnknown(errno[0]) if errno[0] == InstallSourceErrno::EINTR
                raise InstallSourceError.StageCleanupFailed(errno[0])

            root_descriptor: int = handle.descriptor
            handle.descriptor <- -1
            parent_sync_errno: i32 = install_source_sync_stage_descriptor(handle.parent_descriptor)
            close_status: int = elisascript_posix_close(root_descriptor)
            raise InstallSourceError.StageRootCloseFailed(close_status) if close_status != 0
            raise InstallSourceError.StageDirectorySyncFailed(parent_sync_errno) if parent_sync_errno != 0
            return true
