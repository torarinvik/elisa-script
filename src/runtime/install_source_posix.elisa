# Descriptor-relative verification of installation sources.
#
# This adapter binds an install manifest entry to bytes observed beneath an
# already-open build-root capability. It rejects symlinked path components,
# bounds the read, hashes the exact file contents, and returns the stable file
# stamp needed by a later staging step to detect source replacement.

module EsInstallSourcePosix:
    using EsBuildIncremental
    using EsBuildIncrementalPosix
    using EsInstall
    using EsRuntime

    public:
        const module Limits:
            STREAM_CHUNK_BYTES: usize = 65536
            STREAM_READ_CALLS: usize = 1048576
            EINTR_RETRIES: usize = 8


        struct InstallSourceReceipt:
            artifact_index: usize
            source_path: sview
            byte_count: usize
            source_stamp: BuildIncrementalFileStamp
            digest_0: u64
            digest_1: u64
            digest_2: u64
            digest_3: u64


        struct InstallSourceCopyHandle:
            root_descriptor: int
            source_descriptor: int
            receipt: InstallSourceReceipt
            bytes_read: usize = 0
            read_calls: usize = 0
            interrupted: usize = 0
            failed: bool = false


        error InstallSourceError:
            ArtifactIndexOutOfRange
            PlanNotPlanned
            PlanNotSourcesVerified
            SourceMissing
            SourceChanged
            ByteCountMismatch
            DigestMismatch
            StageArtifactMissing
            StageArtifactChanged
            StageDigestMismatch
            StageMetadataFailed
            StageModeMismatch
            StageRootInvalid
            StageRootNotPrivate
            ReceiptPathMismatch
            ReceiptCountMismatch
            ReceiptOrderMismatch
            CopyHandleInvalid
            CopyHandleFailed
            CopyBufferInvalid
            CopyReadFailed(errno: i32)
            CopyReadLimitExceeded
            CopyReadIncomplete
            CopySourceCloseFailed(status: int)


    private:
        const module InstallSourceErrno:
            EINTR: i32 = 4
            EIO: i32 = 5


        const module InstallSourceMode:
            PERMISSION_MASK: u16 = 4095
            PRIVATE_DIRECTORY: u16 = 448
            DATA: u16 = 420
            EXECUTABLE: u16 = 493


        const enum InstallSourceReadState of u8:
            Read
            Done


        def install_source_stamp_equal(left: BuildIncrementalFileStamp, right: BuildIncrementalFileStamp) -> bool:
            return left.path == right.path and left.present and right.present and left.size == right.size and left.device == right.device and left.inode == right.inode and left.modify_time.seconds == right.modify_time.seconds and left.modify_time.nanoseconds == right.modify_time.nanoseconds and left.change_time.seconds == right.change_time.seconds and left.change_time.nanoseconds == right.change_time.nanoseconds


        def install_source_stat_matches_stamp(stat: ElisascriptStat, stamp: BuildIncrementalFileStamp) -> bool:
            return (stat.mode & DarwinStatMode::MASK) == DarwinStatMode::REGULAR and stat.device == stamp.device and stat.inode == stamp.inode and stat.size >= 0 and stat.size.usize().i64() == stat.size and stat.size.usize() == stamp.size and stat.modify_time.seconds == stamp.modify_time.seconds and stat.modify_time.nanoseconds == stamp.modify_time.nanoseconds and stat.change_time.seconds == stamp.change_time.seconds and stat.change_time.nanoseconds == stamp.change_time.nanoseconds


        def install_source_stat_descriptor(descriptor: int, result: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_fstat(descriptor, result) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == InstallSourceErrno::EINTR and retries < Limits::EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def install_source_expected_mode(mode: InstallFileMode) -> u16:
            return InstallSourceMode::DATA if mode == InstallFileMode.Data
            return InstallSourceMode::EXECUTABLE


        def install_source_stage_mode_matches(root_fd: int, path: sview, stamp: BuildIncrementalFileStamp, mode: InstallFileMode) -> bool error[InstallSourceError, OpenError] can[Blocking.IO, Unsafe.PointerCast]:
            opened: OpenedFile = try open_build_incremental_file_at(root_fd, path)
            raise InstallSourceError.StageArtifactChanged if not opened.present
            observed: mutable ElisascriptStat = ElisascriptStat{}
            metadata_ok: bool = install_source_stat_descriptor(opened.descriptor, observed)
            close_status: int = elisascript_posix_close(opened.descriptor)
            raise OpenError.CloseFailed(path) if close_status != 0
            raise InstallSourceError.StageMetadataFailed if not metadata_ok
            raise InstallSourceError.StageArtifactChanged if not install_source_stat_matches_stamp(observed, stamp)
            return (observed.mode & InstallSourceMode::PERMISSION_MASK) == install_source_expected_mode(mode)


        def install_source_require_private_stage_root(root_fd: int) -> bool error[InstallSourceError] can[Blocking.IO]:
            raise InstallSourceError.StageRootInvalid if root_fd < 0
            observed: mutable ElisascriptStat = ElisascriptStat{}
            raise InstallSourceError.StageMetadataFailed if not install_source_stat_descriptor(root_fd, observed)
            raise InstallSourceError.StageRootInvalid if (observed.mode & DarwinStatMode::MASK) != DarwinStatMode::DIRECTORY
            raise InstallSourceError.StageRootNotPrivate if (observed.mode & InstallSourceMode::PERMISSION_MASK) != InstallSourceMode::PRIVATE_DIRECTORY
            return true


        def install_source_close_descriptor(handle: mutable InstallSourceCopyHandle&) -> int can[Blocking.IO]:
            return -1 if handle.source_descriptor < 0
            descriptor: int = handle.source_descriptor
            handle.source_descriptor <- -1
            return elisascript_posix_close(descriptor)


        def install_source_receipt_matches_artifact(artifact: InstallArtifact, index: usize, receipt: InstallSourceReceipt) -> bool error[InstallSourceError]:
            raise InstallSourceError.ReceiptOrderMismatch if receipt.artifact_index != index
            raise InstallSourceError.ReceiptPathMismatch if receipt.source_path != artifact.source_path or receipt.source_stamp.path != artifact.source_path
            raise InstallSourceError.SourceMissing if not receipt.source_stamp.present
            raise InstallSourceError.ByteCountMismatch if receipt.byte_count != artifact.byte_count or receipt.source_stamp.size != artifact.byte_count
            raise InstallSourceError.DigestMismatch if receipt.digest_0 != artifact.digest_0 or receipt.digest_1 != artifact.digest_1 or receipt.digest_2 != artifact.digest_2 or receipt.digest_3 != artifact.digest_3
            return true


        def observe_install_source_entry_at(a: mutable Arena&, root_fd: int, artifact: InstallArtifact, artifact_index: usize) -> InstallSourceReceipt error[InstallSourceError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            initial_stamp: BuildIncrementalFileStamp = try observe_build_incremental_file_stamp_at(root_fd, artifact.source_path)
            raise InstallSourceError.SourceMissing if not initial_stamp.present
            # Check size before the content observer allocates its bounded read
            # buffer. A manifest expecting a small artifact must not be forced
            # to materialize a different, much larger file before rejection.
            raise InstallSourceError.ByteCountMismatch if initial_stamp.size != artifact.byte_count
            stamp: mutable BuildIncrementalFileStamp = BuildIncrementalFileStamp{path: artifact.source_path}
            observed: BuildIncrementalObservation = try observe_build_incremental_file_with_stamp_at(a, root_fd, artifact.source_path, stamp)
            raise InstallSourceError.SourceChanged if not observed.present or not install_source_stamp_equal(initial_stamp, stamp[0])
            raise InstallSourceError.DigestMismatch if observed.fingerprint != artifact.digest_0 or observed.fingerprint_word1 != artifact.digest_1 or observed.fingerprint_word2 != artifact.digest_2 or observed.fingerprint_word3 != artifact.digest_3

            return InstallSourceReceipt{
                artifact_index: artifact_index,
                source_path: artifact.source_path,
                byte_count: stamp[0].size,
                source_stamp: stamp[0],
                digest_0: observed.fingerprint,
                digest_1: observed.fingerprint_word1,
                digest_2: observed.fingerprint_word2,
                digest_3: observed.fingerprint_word3
            }


    public:
        # Purely validate one receipt against its plan entry. Filesystem
        # provenance comes from verify_install_source_at; callers must retain
        # the returned stamp and re-observe it before copying if any time has
        # elapsed or another actor can modify the build tree.
        def validate_install_source_receipt(plan: InstallPlan&, receipt: InstallSourceReceipt) -> bool error[InstallContractError, InstallSourceError] can[Memory.Allocate, Abort.Panic]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.ArtifactIndexOutOfRange if receipt.artifact_index >= plan.artifacts.count
            return try install_source_receipt_matches_artifact(plan.artifacts[receipt.artifact_index], receipt.artifact_index, receipt)


        # A verified manifest is complete only when there is exactly one
        # receipt per artifact in canonical plan order. This rejects a caller
        # that accidentally omits an artifact or reuses one receipt twice.
        def validate_install_source_receipts(plan: InstallPlan&, receipts: darray[InstallSourceReceipt]) -> bool error[InstallContractError, InstallSourceError] can[Memory.Allocate, Abort.Panic]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.ReceiptCountMismatch if receipts.count != plan.artifacts.count
            for index in 0..<plan.artifacts.count |plan, receipts|:
                _ = try install_source_receipt_matches_artifact(plan.artifacts[index], index, receipts[index])
            return true


        # Observe and hash one artifact through EsBuildIncrementalPosix. That
        # observer opens every path segment with no-follow semantics, checks
        # regular-file identity and metadata before/after reading, and bounds
        # the input to the shared build/install file ceiling.
        def verify_install_source_at(a: mutable Arena&, root_fd: int, plan: InstallPlan&, artifact_index: usize) -> InstallSourceReceipt error[InstallContractError, InstallSourceError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.PlanNotPlanned if plan.state != InstallState.Planned
            raise InstallSourceError.ArtifactIndexOutOfRange if artifact_index >= plan.artifacts.count
            return try observe_install_source_entry_at(a, root_fd, plan.artifacts[artifact_index], artifact_index)


        # Hash a complete install plan in canonical artifact order. The
        # observer rewinds its temporary content buffer after each source, so
        # this retains only the bounded receipt vector rather than aggregate
        # artifact bytes. Stamps remain point-in-time evidence and must be
        # revalidated by the later staging adapter.
        def verify_install_sources_at(a: mutable Arena&, root_fd: int, plan: mutable InstallPlan&) -> darray[InstallSourceReceipt] error[InstallContractError, InstallSourceError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.PlanNotPlanned if plan.state != InstallState.Planned
            receipts: mutable darray[InstallSourceReceipt] = []
            for index in 0..<plan.artifacts.count |plan, receipts, a, root_fd|:
                receipts.push(try observe_install_source_entry_at(a, root_fd, plan.artifacts[index], index))
            _ = try validate_install_source_receipts(plan, receipts)
            _ = try advance_install_plan(plan, InstallEvent.VerifySources)
            return receipts


        # Read back one expected entry from a private staging root. Content is
        # hashed with the shared no-follow observer; permissions are inspected
        # on a separately opened descriptor and must match the fixed install
        # mapping (Data=0644, Executable=0755).
        def verify_install_stage_artifact_at(a: mutable Arena&, stage_root_fd: int, plan: InstallPlan&, artifact_index: usize) -> InstallStageReceipt error[InstallContractError, InstallSourceError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.PlanNotSourcesVerified if plan.state != InstallState.SourcesVerified
            _ = try install_source_require_private_stage_root(stage_root_fd)
            raise InstallSourceError.ArtifactIndexOutOfRange if artifact_index >= plan.artifacts.count
            artifact: InstallArtifact = plan.artifacts[artifact_index]
            initial_stamp: BuildIncrementalFileStamp = try observe_build_incremental_file_stamp_at(stage_root_fd, artifact.destination_path)
            raise InstallSourceError.StageArtifactMissing if not initial_stamp.present
            raise InstallSourceError.ByteCountMismatch if initial_stamp.size != artifact.byte_count
            stamp: mutable BuildIncrementalFileStamp = BuildIncrementalFileStamp{path: artifact.destination_path}
            observed: BuildIncrementalObservation = try observe_build_incremental_file_with_stamp_at(a, stage_root_fd, artifact.destination_path, stamp)
            raise InstallSourceError.StageArtifactChanged if not observed.present or not install_source_stamp_equal(initial_stamp, stamp[0])
            raise InstallSourceError.StageDigestMismatch if observed.fingerprint != artifact.digest_0 or observed.fingerprint_word1 != artifact.digest_1 or observed.fingerprint_word2 != artifact.digest_2 or observed.fingerprint_word3 != artifact.digest_3
            mode_matches: bool = try install_source_stage_mode_matches(stage_root_fd, artifact.destination_path, stamp[0], artifact.mode)
            raise InstallSourceError.StageModeMismatch if not mode_matches
            return InstallStageReceipt{
                artifact_index: artifact_index,
                destination_path: artifact.destination_path,
                byte_count: stamp[0].size,
                digest_0: observed.fingerprint,
                digest_1: observed.fingerprint_word1,
                digest_2: observed.fingerprint_word2,
                digest_3: observed.fingerprint_word3,
                mode: artifact.mode
            }


        # Admit staging only after every planned output has passed descriptor-
        # relative content and exact-mode verification. Unexpected extra paths
        # still require the whole-tree closure scan before publication.
        def verify_install_stage_at(a: mutable Arena&, stage_root_fd: int, plan: mutable InstallPlan&) -> darray[InstallStageReceipt] error[InstallContractError, InstallSourceError, OpenError, ObserveError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.PlanNotSourcesVerified if plan.state != InstallState.SourcesVerified
            _ = try install_source_require_private_stage_root(stage_root_fd)
            receipts: mutable darray[InstallStageReceipt] = []
            for index in 0..<plan.artifacts.count |plan, receipts, a, stage_root_fd|:
                receipts.push(try verify_install_stage_artifact_at(a, stage_root_fd, plan, index))
            _ = try stage_install_plan(plan, receipts)
            return receipts


        # Open the exact source snapshot admitted by the complete source batch.
        # The retained no-follow descriptor lets the caller stream it into the
        # private install tree without reading the entire artifact into memory.
        def open_install_source_for_copy(root_fd: int, plan: InstallPlan&, receipt: InstallSourceReceipt) -> InstallSourceCopyHandle error[InstallContractError, InstallSourceError, OpenError] can[Blocking.IO, Unsafe.PointerCast]:
            _ = try validate_install_plan(plan)
            raise InstallSourceError.PlanNotSourcesVerified if plan.state != InstallState.SourcesVerified
            raise InstallSourceError.ArtifactIndexOutOfRange if receipt.artifact_index >= plan.artifacts.count
            _ = try install_source_receipt_matches_artifact(plan.artifacts[receipt.artifact_index], receipt.artifact_index, receipt)
            opened: OpenedFile = try open_build_incremental_file_at(root_fd, receipt.source_path)
            raise InstallSourceError.SourceChanged if not opened.present
            if not install_source_stamp_equal(receipt.source_stamp, BuildIncrementalFileStamp{path: receipt.source_path, present: opened.present, size: opened.size, device: opened.device, inode: opened.inode, modify_time: opened.modify_time, change_time: opened.change_time}):
                close_status: int = elisascript_posix_close(opened.descriptor)
                raise OpenError.CloseFailed(receipt.source_path) if close_status != 0
                raise InstallSourceError.SourceChanged
            return InstallSourceCopyHandle{root_descriptor: root_fd, source_descriptor: opened.descriptor, receipt: receipt}


        # Read at most one 64 KiB chunk. Call until this returns zero, then
        # finish_install_source_copy; on any read error, cancel the handle to
        # close the retained descriptor before abandoning the staging attempt.
        def read_install_source_chunk(handle: mutable InstallSourceCopyHandle&, buffer: mutable u8&, capacity: usize) -> usize error[InstallSourceError] can[Blocking.IO, Unsafe.PointerCast]:
            raise InstallSourceError.CopyHandleInvalid if handle.root_descriptor < 0 or handle.source_descriptor < 0
            raise InstallSourceError.CopyHandleFailed if handle.failed
            raise InstallSourceError.CopyBufferInvalid if buffer == null or capacity == 0 or capacity > Limits::STREAM_CHUNK_BYTES
            raise InstallSourceError.CopyHandleInvalid if handle.bytes_read > handle.receipt.byte_count or handle.read_calls > Limits::STREAM_READ_CALLS
            return 0 if handle.bytes_read == handle.receipt.byte_count
            state: mutable InstallSourceReadState = InstallSourceReadState.Read
            amount: mutable usize = 0
            machine over state:
                state Read
                start Read

                Read, InstallSourceReadState.Read:
                    if handle.read_calls >= Limits::STREAM_READ_CALLS:
                        handle.failed <- true
                        raise InstallSourceError.CopyReadLimitExceeded
                    remaining: usize = handle.receipt.byte_count - handle.bytes_read
                    requested: usize = capacity if capacity < remaining else remaining
                    read_amount: isize = elisascript_posix_read(handle.source_descriptor, buffer.cast[mutable void&], requested)
                    handle.read_calls <- handle.read_calls + 1
                    if read_amount < 0:
                        errno: mutable i32& = elisascript_posix_errno()
                        if errno[0] == InstallSourceErrno::EINTR and handle.interrupted < Limits::EINTR_RETRIES:
                            handle.interrupted <- handle.interrupted + 1
                            -> Read
                        handle.failed <- true
                        raise InstallSourceError.CopyReadFailed(errno[0])
                    if read_amount == 0:
                        handle.failed <- true
                        raise InstallSourceError.CopyReadIncomplete
                    if read_amount.usize() > requested:
                        handle.failed <- true
                        raise InstallSourceError.CopyReadFailed(InstallSourceErrno::EIO)
                    amount <- read_amount.usize()
                    handle.bytes_read <- handle.bytes_read + amount
                    handle.interrupted <- 0
                    state <- InstallSourceReadState.Done
                    -> Read

                Read, InstallSourceReadState.Done:
                    break

            return amount


        # The caller may discard a partially streamed source after any failed
        # staging write. Closing consumes the descriptor exactly once and does
        # not claim that the copy was complete or stable.
        def cancel_install_source_copy(handle: mutable InstallSourceCopyHandle&) -> bool error[InstallSourceError] can[Blocking.IO]:
            raise InstallSourceError.CopyHandleInvalid if handle.root_descriptor < 0 or handle.source_descriptor < 0
            close_status: int = install_source_close_descriptor(handle)
            raise InstallSourceError.CopySourceCloseFailed(close_status) if close_status != 0
            return true


        # Complete the streaming receipt only after every expected byte was
        # consumed, the open descriptor still matches its admission stamp, and
        # the source path still names that same snapshot. A successful return
        # is safe input for staging; it is not a publication receipt.
        def finish_install_source_copy(handle: mutable InstallSourceCopyHandle&) -> bool error[InstallSourceError] can[Blocking.IO, Unsafe.PointerCast]:
            raise InstallSourceError.CopyHandleInvalid if handle.root_descriptor < 0 or handle.source_descriptor < 0
            if handle.failed:
                close_status: int = install_source_close_descriptor(handle)
                raise InstallSourceError.CopySourceCloseFailed(close_status) if close_status != 0
                raise InstallSourceError.CopyHandleFailed
            descriptor_info: mutable ElisascriptStat = ElisascriptStat{}
            descriptor_matches: bool = install_source_stat_descriptor(handle.source_descriptor, descriptor_info) and install_source_stat_matches_stamp(descriptor_info, handle.receipt.source_stamp)
            named_matches: mutable bool = false
            catch observe_build_incremental_file_stamp_at(handle.root_descriptor, handle.receipt.source_path):
                ok observed:
                    named_matches <- install_source_stamp_equal(handle.receipt.source_stamp, observed)
                error failure:
                    named_matches <- false
            close_status: int = install_source_close_descriptor(handle)
            raise InstallSourceError.CopySourceCloseFailed(close_status) if close_status != 0
            raise InstallSourceError.CopyReadIncomplete if handle.bytes_read != handle.receipt.byte_count
            raise InstallSourceError.SourceChanged if not descriptor_matches or not named_matches
            return true
