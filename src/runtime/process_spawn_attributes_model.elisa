# Pure opaque-attribute receipts. Handle presence is a report about the slot,
# not a pointer-validity proof. Canonical resource ownership is checked elsewhere.
module EsProcessSpawnAttributes:
    public:
        const enum State of u8:
            Fresh
            Initialized
            GroupSet
            Configured
            InitFailed
            ConfigurationFailed
            InitUncertain
            ConfigurationUncertain
            Released
            DestroyUncertain


        struct Receipt:
            state: State = State.Fresh
            code: i32 = 0
            handle_present: bool = false


        error AttributeError:
            InvalidState
            InvalidOwner
            MissingHandle
            WrongResourceKind
            ResourceNotAcquired


        def initialized(code: i32, handle_present: bool) -> Receipt:
            return Receipt{state: State.Initialized, code: code, handle_present: true} if code == 0 and handle_present
            return Receipt{state: State.InitFailed, code: code} if code > 0 and not handle_present
            return Receipt{state: State.InitUncertain, code: code, handle_present: handle_present}


        def group_set(code: i32, handle_present: bool) -> Receipt:
            return configured_result(code, handle_present, State.GroupSet)


        def flags_set(code: i32, handle_present: bool) -> Receipt:
            return configured_result(code, handle_present, State.Configured)


        def destroyable(receipt: Receipt) -> bool:
            return receipt.handle_present and receipt.state in {State.Initialized, State.GroupSet, State.Configured, State.ConfigurationFailed}


        def destroyed(code: i32, handle_present: bool) -> Receipt:
            return Receipt{state: State.Released} if code == 0
            return Receipt{state: State.DestroyUncertain, code: code, handle_present: handle_present}

    private:
        def configured_result(code: i32, handle_present: bool, success: State) -> Receipt:
            return Receipt{state: success, handle_present: true} if code == 0 and handle_present
            return Receipt{state: State.ConfigurationFailed, code: code, handle_present: true} if code > 0 and handle_present
            return Receipt{state: State.ConfigurationUncertain, code: code, handle_present: handle_present}
