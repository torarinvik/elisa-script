# Pure opaque-attribute receipts. Handle presence is a report about the slot,
# not a pointer-validity proof. Canonical resource ownership is checked elsewhere.
module EsProcessSpawnAttributes:
    public:
        const enum State of u8:
            Fresh
            Initialized
            GroupSet
            Configured
            InitFailed
            ConfigurationFailed
            InitUncertain
            ConfigurationUncertain
            Released
            DestroyUncertain


        struct Receipt:
            state: State = State.Fresh
            code: i32 = 0
            handle_present: bool = false


        const enum PreparationStep of u8:
            Initialize
            SetGroup
            SetFlags
            Ready
            Stop


        const enum FinalizationStep of u8:
            AlreadyReleased
            Destroy
            RetainUncertain
            Invalid


        error AttributeError:
            InvalidState
            InvalidOwner
            MissingHandle
            WrongResourceKind
            ResourceNotAcquired


        def initialized(code: i32, handle_present: bool) -> Receipt:
            return Receipt{state: State.Initialized, code: code, handle_present: true} if code == 0 and handle_present
            return Receipt{state: State.InitFailed, code: code} if code > 0 and not handle_present
            return Receipt{state: State.InitUncertain, code: code, handle_present: handle_present}


        def group_set(code: i32, handle_present: bool) -> Receipt:
            return configured_result(code, handle_present, State.GroupSet)


        def flags_set(code: i32, handle_present: bool) -> Receipt:
            return configured_result(code, handle_present, State.Configured)


        def destroyable(receipt: Receipt) -> bool:
            return finalization_step(receipt) == FinalizationStep.Destroy


        # Pure scheduling decisions, not authority to call native functions.
        # Failed or malformed setup never advances to another host operation.
        def preparation_step(receipt: Receipt) -> PreparationStep:
            match receipt.state:
                State.Fresh:
                    return PreparationStep.Initialize if receipt.code == 0 and not receipt.handle_present else PreparationStep.Stop
                State.Initialized:
                    return PreparationStep.SetGroup if receipt.code == 0 and receipt.handle_present else PreparationStep.Stop
                State.GroupSet:
                    return PreparationStep.SetFlags if receipt.code == 0 and receipt.handle_present else PreparationStep.Stop
                State.Configured:
                    return PreparationStep.Ready if receipt.code == 0 and receipt.handle_present else PreparationStep.Stop
                _:
                    return PreparationStep.Stop


        def finalization_step(receipt: Receipt) -> FinalizationStep:
            match receipt.state:
                State.Initialized:
                    return FinalizationStep.Destroy if receipt.code == 0 and receipt.handle_present else FinalizationStep.Invalid
                State.GroupSet:
                    return FinalizationStep.Destroy if receipt.code == 0 and receipt.handle_present else FinalizationStep.Invalid
                State.Configured:
                    return FinalizationStep.Destroy if receipt.code == 0 and receipt.handle_present else FinalizationStep.Invalid
                State.ConfigurationFailed:
                    return FinalizationStep.Destroy if receipt.code > 0 and receipt.handle_present else FinalizationStep.Invalid
                State.InitFailed:
                    return FinalizationStep.AlreadyReleased if receipt.code > 0 and not receipt.handle_present else FinalizationStep.Invalid
                State.Released:
                    return FinalizationStep.AlreadyReleased if receipt.code == 0 and not receipt.handle_present else FinalizationStep.Invalid
                State.InitUncertain:
                    return FinalizationStep.RetainUncertain
                State.ConfigurationUncertain:
                    return FinalizationStep.RetainUncertain
                State.DestroyUncertain:
                    return FinalizationStep.RetainUncertain
                _:
                    return FinalizationStep.Invalid


        def destroyed(code: i32, handle_present: bool) -> Receipt:
            return Receipt{state: State.Released} if code == 0
            return Receipt{state: State.DestroyUncertain, code: code, handle_present: handle_present}

    private:
        def configured_result(code: i32, handle_present: bool, success: State) -> Receipt:
            return Receipt{state: success, handle_present: true} if code == 0 and handle_present
            return Receipt{state: State.ConfigurationFailed, code: code, handle_present: true} if code > 0 and handle_present
            return Receipt{state: State.ConfigurationUncertain, code: code, handle_present: handle_present}
