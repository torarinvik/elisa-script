# Checked bridge from integer-valued record fields into keyed aggregation.
# Decimal/floating coercion remains explicit and is not inferred here.

module EsRecordNumericAggregate:
    using EsRecord
    using EsRecordAggregate
    using EsRecordNumeric

    public:
        def record_aggregate_add_numeric(session: mutable RecordAggregateSession&, key: sview, numeric: RecordNumericSession) -> RecordAggregateState error[RecordAggregateError, RecordNumericError]:
            result: RecordNumericResult = try record_numeric_result(numeric)
            value: i64 = try record_numeric_result_i64(result)
            return try advance_record_aggregate(session, RecordAggregateEvent.AddValue, key, value)


        def record_aggregate_add_numeric_field(session: mutable RecordAggregateSession&, key: sview, field_value: sview, numeric_policy: RecordNumericPolicy) -> RecordAggregateState error[RecordAggregateError, RecordNumericError]:
            numeric: RecordNumericSession = try parse_record_numeric(field_value, numeric_policy)
            return try record_aggregate_add_numeric(session, key, numeric)


        def record_aggregate_add_numeric_record_field(session: mutable RecordAggregateSession&, key: sview, record: mutable Record&, field: mutable RecordField&, record_policy: mutable RecordStreamPolicy&, numeric_policy: RecordNumericPolicy) -> RecordAggregateState error[RecordContractError, RecordAggregateError, RecordNumericError]:
            _ = try validate_record_field(field, record, record_policy)
            raise RecordContractError.InvalidFieldRange if not field.present
            return try record_aggregate_add_numeric_field(session, key, field.value, numeric_policy)


        def record_aggregate_add_numeric_record_fields(session: mutable RecordAggregateSession&, record: mutable Record&, key_field: mutable RecordField&, value_field: mutable RecordField&, record_policy: mutable RecordStreamPolicy&, numeric_policy: RecordNumericPolicy) -> RecordAggregateState error[RecordContractError, RecordAggregateError, RecordNumericError]:
            _ = try validate_record_field(key_field, record, record_policy)
            _ = try validate_record_field(value_field, record, record_policy)
            raise RecordContractError.InvalidFieldRange if not key_field.present or not value_field.present
            return try record_aggregate_add_numeric_field(session, key_field.value, value_field.value, numeric_policy)
