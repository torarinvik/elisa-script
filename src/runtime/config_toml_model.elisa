# Bounded TOML configuration subset with explicit rejection of unsupported
# constructs. Keys and recursive typed value graphs are owned by the result
# wrapper; none borrows the source buffer.

module EsConfigToml:
    using EsConfig
    using EsEncoding

    public:
        const CONFIG_TOML_MAX_BYTES: usize = 16777216
        const CONFIG_TOML_MAX_ARRAY_ITEMS: usize = 4096
        const CONFIG_TOML_MAX_TOTAL_ARRAY_ITEMS: usize = 65536
        const CONFIG_TOML_MAX_TOTAL_TABLE_FIELDS: usize = 65536
        const CONFIG_TOML_MAX_ARRAY_TABLE_ROWS: usize = 65536
        const CONFIG_TOML_MAX_TOTAL_VALUE_NODES: usize = 262144
        const CONFIG_TOML_MAX_VALUE_DEPTH: usize = 128
        const CONFIG_TOML_NODE_INDEX_NONE: usize = 4294967295


        const enum ConfigTomlValueKind of u8:
            Text
            Boolean
            Integer
            Float
            Array
            InlineTable


        struct ConfigTomlArrayItem:
            kind: ConfigTomlValueKind
            text: darray[u8] = []


        struct ConfigTomlTableField:
            key: darray[u8] = []
            kind: ConfigTomlValueKind
            text: darray[u8] = []
            items: darray[ConfigTomlArrayItem] = []


        # Recursive typed representation. Child edges are stored contiguously
        # per node; object edges carry decoded key bytes and arrays carry an
        # empty key. Flat items/fields below remain compatibility projections
        # for values representable by the earlier one-level adapter.
        struct ConfigTomlNode:
            kind: ConfigTomlValueKind
            text: darray[u8] = []
            child_start: usize = CONFIG_TOML_NODE_INDEX_NONE
            child_count: usize = 0


        struct ConfigTomlNodeChild:
            owner_index: usize
            value_index: usize
            ordinal: usize
            key: darray[u8] = []


        struct ConfigTomlValue:
            key: sview
            kind: ConfigTomlValueKind
            text: darray[u8] = []
            items: darray[ConfigTomlArrayItem] = []
            fields: darray[ConfigTomlTableField] = []
            nodes: darray[ConfigTomlNode] = []
            children: darray[ConfigTomlNodeChild] = []


        struct ConfigTomlArrayTableInstance:
            path: darray[u8] = []
            index: usize


        struct ConfigTomlResolvedValue:
            key: sview
            # Borrowed from the winning ConfigValue. Typed payload arrays are
            # independent owned copies so they can outlive the parser sidecar.
            raw_value: sview
            source: ConfigSource
            kind: ConfigTomlValueKind
            text: darray[u8] = []
            items: darray[ConfigTomlArrayItem] = []
            fields: darray[ConfigTomlTableField] = []
            nodes: darray[ConfigTomlNode] = []
            children: darray[ConfigTomlNodeChild] = []


        struct ConfigTomlResolution:
            values: darray[ConfigTomlResolvedValue] = []
            array_tables: darray[ConfigTomlArrayTableInstance] = []


        struct ConfigTomlLayer:
            layer: ConfigLayer
            # Typed rows parallel to layer.entries. The latter remains the
            # format-neutral precedence view; typed consumers use these rows
            # when the selected source is TOML.
            values: darray[ConfigTomlValue] = []
            array_tables: darray[ConfigTomlArrayTableInstance] = []
            key_storage: darray[darray[u8]] = []
            value_storage: darray[darray[u8]] = []


        error ConfigTomlError:
            InputLimitExceeded
            InvalidUtf8
            InvalidValueGraph
            InvalidTable
            DuplicateTable
            ConflictingStructure
            InvalidKey
            DuplicateKey
            ExpectedEquals
            InvalidString
            UnsupportedEscape
            UnsupportedValue
            InvalidNumber
            TypedValueMissing
            OutputLimitExceeded
            OutputBytesExceeded


    private:
        def config_toml_space(byte: u8) -> bool:
            return byte == 32 or byte == 9


        def config_toml_trim_start(source: sview, start: usize, end: usize) -> usize:
            cursor: mutable usize = start
            while cursor < end and config_toml_space(sview_at(source, cursor)):
                cursor <- cursor + 1
            return cursor


        def config_toml_trim_end(source: sview, start: usize, end: usize) -> usize:
            cursor: mutable usize = end
            while cursor > start and config_toml_space(sview_at(source, cursor - 1)):
                cursor <- cursor - 1
            return cursor


        def config_toml_comment_end(source: sview, start: usize, end: usize) -> usize:
            quote: mutable u8 = 0
            escaped: mutable bool = false
            cursor: mutable usize = start
            while cursor < end:
                byte: u8 = sview_at(source, cursor)
                if quote == 34 and escaped:
                    escaped <- false
                elif quote == 34 and byte == 92:
                    escaped <- true
                elif quote != 0 and byte == quote:
                    quote <- 0
                elif quote == 0 and (byte == 34 or byte == 39):
                    quote <- byte
                elif quote == 0 and byte == 35:
                    return cursor
                cursor <- cursor + 1
            return end


        def config_toml_bare_key_byte(byte: u8) -> bool:
            return (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or (byte >= 48 and byte <= 57) or byte == 95 or byte == 45


        def config_toml_parse_key_path(source: sview, start: usize, end: usize) -> darray[u8] error[ConfigTomlError] can[Memory.Allocate, Abort.Panic]:
            key: mutable darray[u8] = []
            cursor: mutable usize = config_toml_trim_start(source, start, end)
            segments: mutable usize = 0
            while cursor < end:
                segment: mutable darray[u8] = []
                first: u8 = sview_at(source, cursor)
                if first == 34 or first == 39:
                    quote: u8 = first
                    cursor <- cursor + 1
                    closed: mutable bool = false
                    while cursor < end and not closed:
                        byte: u8 = sview_at(source, cursor)
                        if quote == 34 and byte == 92:
                            cursor <- cursor + 1
                            raise ConfigTomlError.InvalidKey if cursor >= end
                            escaped: u8 = sview_at(source, cursor)
                            raise ConfigTomlError.UnsupportedEscape if escaped != 34 and escaped != 92
                            segment.push(escaped)
                            cursor <- cursor + 1
                        elif byte == quote:
                            closed <- true
                            cursor <- cursor + 1
                        else:
                            raise ConfigTomlError.InvalidKey if byte < 32 or byte == 127
                            segment.push(byte)
                            cursor <- cursor + 1
                    raise ConfigTomlError.InvalidKey if not closed or segment.count == 0
                else:
                    segment_start: usize = cursor
                    while cursor < end and config_toml_bare_key_byte(sview_at(source, cursor)):
                        cursor <- cursor + 1
                    raise ConfigTomlError.InvalidKey if cursor == segment_start
                    for offset in segment_start..<cursor |segment, source|:
                        segment.push(sview_at(source, offset))
                for byte in segment |segment|:
                    raise ConfigTomlError.InvalidKey if byte == 46 or byte == 61 or byte == 127
                if segments != 0:
                    key.push(46u8)
                for byte in segment |segment, key|:
                    key.push(byte)
                segments <- segments + 1
                cursor <- config_toml_trim_start(source, cursor, end)
                if cursor < end:
                    raise ConfigTomlError.InvalidKey if sview_at(source, cursor) != 46
                    cursor <- config_toml_trim_start(source, cursor + 1, end)
                    raise ConfigTomlError.InvalidKey if cursor >= end
            raise ConfigTomlError.InvalidKey if segments == 0
            return key


        def config_toml_tables_unique(tables: darray[darray[u8]]) -> bool can[Memory.Allocate, Abort.Panic]:
            views: mutable darray[sview] = []
            for table in tables |tables, views|:
                views.push(bytes_view(table))
            ordered: darray[sview] = sorted(views)
            for index in 1..<ordered.count |ordered|:
                return false if ordered[index - 1] == ordered[index]
            return true


        def config_toml_array_table_index(paths: darray[darray[u8]], path: darray[u8]) -> usize:
            for index in 0..<paths.count |paths, path|:
                return index if bytes_view(paths[index]) == bytes_view(path)
            return paths.count


        def config_toml_dotted_descendant(path: darray[u8], prefix: darray[u8]) -> bool:
            return false if path.count <= prefix.count
            for offset in 0..<prefix.count |path, prefix|:
                return false if path[offset] != prefix[offset]
            return path[prefix.count] == 46


        def config_toml_key_descendant(key: sview, prefix: darray[u8]) -> bool:
            return false if sview_len(key) <= prefix.count
            return false if sview_at(key, prefix.count) != 46
            for offset in 0..<prefix.count |key, prefix|:
                return false if sview_at(key, offset) != prefix[offset]
            return true


        def config_toml_source_priority(source: ConfigSource) -> usize:
            return 0 if source == ConfigSource.Defaults else 1 if source == ConfigSource.File else 2 if source == ConfigSource.Environment else 3


        def config_toml_array_table_source(layers: darray[ConfigTomlLayer], path: darray[u8]) -> ConfigSource:
            winner: mutable ConfigSource = ConfigSource.Defaults
            found: mutable bool = false
            for layer in layers |layers, path, winner, found|:
                for row in layer.array_tables |layer, winner, found|:
                    if bytes_view(row.path) == bytes_view(path):
                        if not found or config_toml_source_priority(layer.layer.source) > config_toml_source_priority(winner):
                            winner <- layer.layer.source
                            found <- true
            return winner


        def config_toml_layer_declares_array_table(layer: ConfigTomlLayer, path: darray[u8]) -> bool:
            for row in layer.array_tables |layer, path|:
                return true if bytes_view(row.path) == bytes_view(path)
            return false


        def config_toml_typed_layer_entry_wins_array_group(layers: darray[ConfigTomlLayer], layer: ConfigTomlLayer, key: sview) -> bool error[ConfigTomlError]:
            for candidate in layers |layers, layer, key|:
                for group in candidate.array_tables |candidate, layer, key|:
                    if config_toml_key_descendant(key, group.path):
                        raise ConfigTomlError.ConflictingStructure if not config_toml_layer_declares_array_table(layer, group.path)
                        return layer.layer.source == config_toml_array_table_source(layers, group.path)
            return true


        def config_toml_array_table_parent(paths: darray[darray[u8]], path: darray[u8]) -> usize:
            parent: mutable usize = paths.count
            parent_bytes: mutable usize = 0
            for index in 0..<paths.count |paths, path, parent, parent_bytes|:
                if paths[index].count > parent_bytes and config_toml_dotted_descendant(path, paths[index]):
                    parent <- index
                    parent_bytes <- paths[index].count
            return parent


        def config_toml_append_array_table_ordinal(prefix: mutable darray[u8]&, ordinal: usize) can[Memory.Allocate, Abort.Panic]:
            digits: mutable darray[u8] = []
            remaining: mutable usize = ordinal
            if remaining == 0:
                digits.push(48u8)
            while remaining != 0:
                digits.push(48u8 + (remaining % 10).u8())
                remaining <- remaining / 10
            for offset in 0..<digits.count |digits, prefix|:
                prefix.push(digits[digits.count - offset - 1])


        def config_toml_digit(byte: u8, radix: usize) -> bool:
            return byte >= 48 and byte <= 57 if radix == 10
            return (byte >= 48 and byte <= 49) if radix == 2
            return (byte >= 48 and byte <= 55) if radix == 8
            return (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 70) or (byte >= 97 and byte <= 102)


        def config_toml_digit_sequence(source: sview, cursor: mutable usize&, end: usize, radix: usize) -> bool:
            digits: mutable usize = 0
            previous_digit: mutable bool = false
            while cursor < end and (config_toml_digit(sview_at(source, cursor), radix) or sview_at(source, cursor) == 95):
                byte: u8 = sview_at(source, cursor)
                if config_toml_digit(byte, radix):
                    digits <- digits + 1
                    previous_digit <- true
                else:
                    return false if not previous_digit or cursor + 1 >= end or not config_toml_digit(sview_at(source, cursor + 1), radix)
                    previous_digit <- false
                cursor <- cursor + 1
            return digits != 0 and previous_digit


        def config_toml_number_valid(source: sview, start: usize, end: usize) -> bool:
            return false if start >= end
            cursor: mutable usize = start
            if sview_at(source, cursor) == 43 or sview_at(source, cursor) == 45:
                cursor <- cursor + 1
                return false if cursor >= end

            remaining: sview = string_view_slice(source, cursor.i64(), end.i64())
            return true if remaining == "inf" or remaining == "nan"

            # TOML base-prefixed integer forms are unsigned and allow one
            # underscore only between radix-valid digits.
            if cursor + 1 < end and sview_at(source, cursor) == 48:
                prefix: u8 = sview_at(source, cursor + 1)
                radix: usize = 16 if prefix == 120 or prefix == 88 else 8 if prefix == 111 or prefix == 79 else 2 if prefix == 98 or prefix == 66 else 0
                if radix != 0:
                    return false if cursor != start
                    cursor <- cursor + 2
                    return false if not config_toml_digit_sequence(source, cursor, end, radix)
                    return cursor == end

            # Decimal integer part: TOML permits exactly "0" or a non-zero
            # digit followed by digit groups; leading zeroes are invalid.
            if cursor >= end:
                return false
            if sview_at(source, cursor) == 48:
                cursor <- cursor + 1
                return false if cursor < end and (config_toml_digit(sview_at(source, cursor), 10) or sview_at(source, cursor) == 95)
            else:
                return false if sview_at(source, cursor) < 49 or sview_at(source, cursor) > 57
                return false if not config_toml_digit_sequence(source, cursor, end, 10)

            if cursor < end and sview_at(source, cursor) == 46:
                cursor <- cursor + 1
                return false if not config_toml_digit_sequence(source, cursor, end, 10)
            if cursor < end and (sview_at(source, cursor) == 101 or sview_at(source, cursor) == 69):
                cursor <- cursor + 1
                if cursor < end and (sview_at(source, cursor) == 43 or sview_at(source, cursor) == 45):
                    cursor <- cursor + 1
                return false if not config_toml_digit_sequence(source, cursor, end, 10)
            return cursor == end


        def config_toml_parse_string(source: sview, start: usize, end: usize) -> darray[u8] error[ConfigTomlError] can[Memory.Allocate, Abort.Panic]:
            quote: u8 = sview_at(source, start)
            cursor: mutable usize = start + 1
            value: mutable darray[u8] = []
            closed: mutable bool = false
            while cursor < end and not closed:
                byte: u8 = sview_at(source, cursor)
                if byte == quote:
                    closed <- true
                    cursor <- cursor + 1
                elif quote == 34 and byte == 92:
                    cursor <- cursor + 1
                    raise ConfigTomlError.InvalidString if cursor >= end
                    escaped: u8 = sview_at(source, cursor)
                    if escaped == 34 or escaped == 92:
                        value.push(escaped)
                    elif escaped == 98:
                        value.push(8u8)
                    elif escaped == 116:
                        value.push(9u8)
                    elif escaped == 110:
                        value.push(10u8)
                    elif escaped == 102:
                        value.push(12u8)
                    elif escaped == 114:
                        value.push(13u8)
                    else:
                        raise ConfigTomlError.UnsupportedEscape
                    cursor <- cursor + 1
                else:
                    raise ConfigTomlError.InvalidString if byte < 32 and byte != 9
                    value.push(byte)
                    cursor <- cursor + 1
            raise ConfigTomlError.InvalidString if not closed
            cursor <- config_toml_trim_start(source, cursor, end)
            raise ConfigTomlError.InvalidString if cursor != end
            return value


        def config_toml_parse_scalar(source: sview, start: usize, end: usize) -> darray[u8] error[ConfigTomlError] can[Memory.Allocate, Abort.Panic]:
            value_start: usize = config_toml_trim_start(source, start, end)
            value_end: usize = config_toml_trim_end(source, value_start, end)
            raise ConfigTomlError.UnsupportedValue if value_start >= value_end
            first: u8 = sview_at(source, value_start)
            if first == 34 or first == 39:
                return try config_toml_parse_string(source, value_start, value_end)
            if first == 91 or first == 123:
                raise ConfigTomlError.UnsupportedValue
            if string_view_slice(source, value_start.i64(), value_end.i64()) == "true" or string_view_slice(source, value_start.i64(), value_end.i64()) == "false":
                parsed_bool: mutable darray[u8] = []
                for offset in value_start..<value_end |parsed_bool, source|:
                    parsed_bool.push(sview_at(source, offset))
                return parsed_bool
            raise ConfigTomlError.InvalidNumber if not config_toml_number_valid(source, value_start, value_end)
            number: mutable darray[u8] = []
            for offset in value_start..<value_end |number, source|:
                number.push(sview_at(source, offset))
            return number


        def config_toml_scalar_kind(source: sview, start: usize, end: usize) -> ConfigTomlValueKind:
            first: u8 = sview_at(source, start)
            return ConfigTomlValueKind.Text if first == 34 or first == 39
            remaining: sview = string_view_slice(source, start.i64(), end.i64())
            return ConfigTomlValueKind.Boolean if remaining == "true" or remaining == "false"
            return ConfigTomlValueKind.Float if remaining == "inf" or remaining == "+inf" or remaining == "-inf" or remaining == "nan" or remaining == "+nan" or remaining == "-nan"
            return ConfigTomlValueKind.Integer if end - start >= 2 and first == 48 and (sview_at(source, start + 1) == 120 or sview_at(source, start + 1) == 88 or sview_at(source, start + 1) == 111 or sview_at(source, start + 1) == 79 or sview_at(source, start + 1) == 98 or sview_at(source, start + 1) == 66)
            for offset in start..<end |source|:
                return ConfigTomlValueKind.Float if sview_at(source, offset) == 46 or sview_at(source, offset) == 101 or sview_at(source, offset) == 69
            return ConfigTomlValueKind.Integer


        def config_toml_array_value_end(source: sview, start: usize, physical_line_end: mutable usize&) -> usize error[ConfigTomlError]:
            raise ConfigTomlError.UnsupportedValue if start >= sview_len(source) or sview_at(source, start) != 91
            depth: mutable usize = 0
            quote: mutable u8 = 0
            escaped: mutable bool = false
            in_comment: mutable bool = false
            cursor: mutable usize = start
            while cursor < sview_len(source):
                byte: u8 = sview_at(source, cursor)
                if in_comment:
                    if byte == 10:
                        in_comment <- false
                elif quote != 0:
                    raise ConfigTomlError.InvalidString if byte == 10 or byte == 13
                    if quote == 34 and escaped:
                        escaped <- false
                    elif quote == 34 and byte == 92:
                        escaped <- true
                    elif byte == quote:
                        quote <- 0
                elif byte == 34 or byte == 39:
                    quote <- byte
                elif byte == 35:
                    in_comment <- true
                elif byte == 91:
                    depth <- depth + 1
                elif byte == 93:
                    depth <- depth - 1
                    if depth == 0:
                        value_end: usize = cursor + 1
                        suffix: mutable usize = value_end
                        while suffix < sview_len(source) and (config_toml_space(sview_at(source, suffix)) or sview_at(source, suffix) == 13):
                            suffix <- suffix + 1
                        if suffix < sview_len(source) and sview_at(source, suffix) == 35:
                            while suffix < sview_len(source) and sview_at(source, suffix) != 10:
                                suffix <- suffix + 1
                        raise ConfigTomlError.UnsupportedValue if suffix < sview_len(source) and sview_at(source, suffix) != 10
                        physical_line_end <- suffix
                        return value_end
                cursor <- cursor + 1
            raise ConfigTomlError.UnsupportedValue


        def config_toml_skip_array_trivia(source: sview, cursor: mutable usize&, end: usize) -> void:
            while cursor < end:
                byte: u8 = sview_at(source, cursor)
                if config_toml_space(byte) or byte == 10 or byte == 13:
                    cursor <- cursor + 1
                elif byte == 35:
                    while cursor < end and sview_at(source, cursor) != 10:
                        cursor <- cursor + 1
                else:
                    break


        def config_toml_inline_value_end(source: sview, start: usize, end: usize) -> usize error[ConfigTomlError]:
            cursor: mutable usize = start
            array_depth: mutable usize = 0
            table_depth: mutable usize = 0
            quote: mutable u8 = 0
            escaped: mutable bool = false
            while cursor < end:
                byte: u8 = sview_at(source, cursor)
                raise ConfigTomlError.UnsupportedValue if byte == 10 or byte == 13
                if quote != 0:
                    if quote == 34 and escaped:
                        escaped <- false
                    elif quote == 34 and byte == 92:
                        escaped <- true
                    elif byte == quote:
                        quote <- 0
                elif byte == 34 or byte == 39:
                    quote <- byte
                elif byte == 91:
                    array_depth <- array_depth + 1
                elif byte == 93:
                    raise ConfigTomlError.UnsupportedValue if array_depth == 0
                    array_depth <- array_depth - 1
                elif byte == 123:
                    table_depth <- table_depth + 1
                elif byte == 125:
                    if table_depth == 0:
                        return cursor
                    table_depth <- table_depth - 1
                elif array_depth == 0 and table_depth == 0 and byte == 44:
                    return cursor
                cursor <- cursor + 1
            raise ConfigTomlError.UnsupportedValue


        def config_toml_graph_item_end(source: sview, start: usize, end: usize) -> usize error[ConfigTomlError]:
            cursor: mutable usize = start
            array_depth: mutable usize = 0
            table_depth: mutable usize = 0
            quote: mutable u8 = 0
            escaped: mutable bool = false
            in_comment: mutable bool = false
            while cursor < end:
                byte: u8 = sview_at(source, cursor)
                if in_comment:
                    in_comment <- false if byte == 10
                elif quote != 0:
                    if quote == 34 and escaped:
                        escaped <- false
                    elif quote == 34 and byte == 92:
                        escaped <- true
                    elif byte == quote:
                        quote <- 0
                elif byte == 34 or byte == 39:
                    quote <- byte
                elif byte == 35:
                    in_comment <- true
                elif byte == 91:
                    array_depth <- array_depth + 1
                elif byte == 93:
                    return cursor if array_depth == 0
                    array_depth <- array_depth - 1
                elif byte == 123:
                    table_depth <- table_depth + 1
                elif byte == 125:
                    return cursor if table_depth == 0
                    table_depth <- table_depth - 1
                elif byte == 44 and array_depth == 0 and table_depth == 0:
                    return cursor
                cursor <- cursor + 1
            return cursor


        def config_toml_inline_fields_unique(fields: darray[ConfigTomlTableField]) -> bool can[Memory.Allocate, Abort.Panic]:
            keys: mutable darray[sview] = []
            for field in fields |fields, keys|:
                keys.push(bytes_view(field.key))
            ordered: darray[sview] = sorted(keys)
            for index in 1..<ordered.count |ordered|:
                return false if ordered[index - 1] == ordered[index]
            return true


        def config_toml_parse_inline_table(source: sview, start: usize, end: usize, remaining_item_limit: usize, remaining_field_limit: usize) -> darray[ConfigTomlTableField] error[ConfigTomlError] can[Memory.Allocate, Abort.Panic]:
            raise ConfigTomlError.UnsupportedValue if start >= end or sview_at(source, start) != 123 or sview_at(source, end - 1) != 125
            fields: mutable darray[ConfigTomlTableField] = []
            cursor: mutable usize = start + 1
            array_item_count: mutable usize = 0
            while cursor < end - 1:
                cursor <- config_toml_trim_start(source, cursor, end - 1)
                if cursor == end - 1:
                    break
                raise ConfigTomlError.OutputLimitExceeded if fields.count >= EsConfig::Limits::ENTRIES_PER_LAYER or fields.count >= remaining_field_limit
                field_start: usize = cursor
                while cursor < end - 1 and sview_at(source, cursor) != 61:
                    cursor <- cursor + 1
                raise ConfigTomlError.ExpectedEquals if cursor >= end - 1
                field_key: darray[u8] = try config_toml_parse_key_path(source, field_start, cursor)
                cursor <- config_toml_trim_start(source, cursor + 1, end - 1)
                field_value_start: usize = cursor
                field_value_end: usize = try config_toml_inline_value_end(source, field_value_start, end - 1)
                field_value_start <- config_toml_trim_start(source, field_value_start, field_value_end)
                field_value_end <- config_toml_trim_end(source, field_value_start, field_value_end)
                raise ConfigTomlError.UnsupportedValue if field_value_start >= field_value_end
                field_kind: ConfigTomlValueKind = ConfigTomlValueKind.Array if sview_at(source, field_value_start) == 91 else config_toml_scalar_kind(source, field_value_start, field_value_end)
                field_text: darray[u8] = []
                field_items: darray[ConfigTomlArrayItem] = []
                if field_kind == ConfigTomlValueKind.Array:
                    remaining_items: usize = remaining_item_limit - array_item_count
                    field_items <- try config_toml_parse_array(source, field_value_start, field_value_end, remaining_items)
                    array_item_count <- array_item_count + field_items.count
                else:
                    field_text <- try config_toml_parse_scalar(source, field_value_start, field_value_end)
                raise ConfigTomlError.OutputLimitExceeded if field_key.count >= EsConfig::Limits::KEY_BYTES or field_text.count >= EsConfig::Limits::VALUE_BYTES
                fields.push(ConfigTomlTableField{key: field_key, kind: field_kind, text: field_text, items: field_items})
                cursor <- field_value_end
                cursor <- config_toml_trim_start(source, cursor, end - 1)
                if cursor < end - 1:
                    raise ConfigTomlError.UnsupportedValue if sview_at(source, cursor) != 44
                    cursor <- cursor + 1
                    cursor <- config_toml_trim_start(source, cursor, end - 1)
                    raise ConfigTomlError.UnsupportedValue if cursor == end - 1
            raise ConfigTomlError.DuplicateKey if not config_toml_inline_fields_unique(fields)
            return fields


        def config_toml_parse_array(source: sview, start: usize, end: usize, remaining_item_limit: usize) -> darray[ConfigTomlArrayItem] error[ConfigTomlError] can[Memory.Allocate, Abort.Panic]:
            raise ConfigTomlError.UnsupportedValue if start >= end or sview_at(source, start) != 91 or sview_at(source, end - 1) != 93
            items: mutable darray[ConfigTomlArrayItem] = []
            cursor: mutable usize = start + 1
            last_was_comma: mutable bool = false
            while cursor < end - 1:
                config_toml_skip_array_trivia(source, cursor, end - 1)
                if cursor == end - 1:
                    break
                raise ConfigTomlError.OutputLimitExceeded if items.count >= CONFIG_TOML_MAX_ARRAY_ITEMS or items.count >= remaining_item_limit
                item_start: usize = cursor
                first: u8 = sview_at(source, cursor)
                if first == 34 or first == 39:
                    quote: u8 = first
                    cursor <- cursor + 1
                    escaped: mutable bool = false
                    closed: mutable bool = false
                    while cursor < end - 1 and not closed:
                        byte: u8 = sview_at(source, cursor)
                        if quote == 34 and escaped:
                            escaped <- false
                        elif quote == 34 and byte == 92:
                            escaped <- true
                        elif byte == quote:
                            closed <- true
                        cursor <- cursor + 1
                    raise ConfigTomlError.InvalidString if not closed
                else:
                    while cursor < end - 1 and sview_at(source, cursor) != 44 and sview_at(source, cursor) != 93 and sview_at(source, cursor) != 10 and sview_at(source, cursor) != 13 and sview_at(source, cursor) != 35:
                        cursor <- cursor + 1
                item_end: usize = config_toml_trim_end(source, item_start, cursor)
                raise ConfigTomlError.UnsupportedValue if item_start == item_end
                item_kind: ConfigTomlValueKind = config_toml_scalar_kind(source, item_start, item_end)
                atom: darray[u8] = try config_toml_parse_scalar(source, item_start, item_end)
                raise ConfigTomlError.OutputLimitExceeded if atom.count >= EsConfig::Limits::VALUE_BYTES
                items.push(ConfigTomlArrayItem{kind: item_kind, text: atom})
                config_toml_skip_array_trivia(source, cursor, end - 1)
                if cursor < end - 1:
                    raise ConfigTomlError.UnsupportedValue if sview_at(source, cursor) != 44
                    cursor <- cursor + 1
                    last_was_comma <- true
                else:
                    last_was_comma <- false
            raise ConfigTomlError.UnsupportedValue if last_was_comma and items.count == 0
            return items


        def config_toml_graph_children_unique(children: darray[ConfigTomlNodeChild]) -> bool can[Memory.Allocate, Abort.Panic]:
            names: mutable darray[sview] = []
            for child in children |names|:
                names.push(bytes_view(child.key))
            ordered: darray[sview] = sorted(names)
            for index in 1..<ordered.count |ordered|:
                return false if ordered[index - 1] == ordered[index]
            return true


        def config_toml_view_before(left: sview, right: sview) -> bool:
            left_length: usize = sview_len(left)
            right_length: usize = sview_len(right)
            common: usize = left_length if left_length < right_length else right_length
            for offset in 0..<common |left, right|:
                return true if sview_at(left, offset) < sview_at(right, offset)
                return false if sview_at(left, offset) > sview_at(right, offset)
            return left_length < right_length


        def config_toml_dotted_key_structure_conflict(keys: darray[sview]) -> bool:
            ordered: darray[sview] = sorted(keys)
            for key in ordered |ordered|:
                key_length: usize = sview_len(key)
                for offset in 0..<key_length |key, ordered, key_length|:
                    if sview_at(key, offset) == 46:
                        prefix: sview = string_view_slice(key, 0, offset.i64())
                        low: mutable usize = 0
                        high: mutable usize = ordered.count
                        while low < high:
                            middle: usize = low + (high - low) / 2
                            if ordered[middle] == prefix:
                                return true
                            if config_toml_view_before(ordered[middle], prefix):
                                low <- middle + 1
                            else:
                                high <- middle
            return false


        def config_toml_parse_value_graph(source: sview, start: usize, end: usize, depth: usize, nodes: mutable darray[ConfigTomlNode]&, children: mutable darray[ConfigTomlNodeChild]&, total_nodes: mutable usize&, total_array_items: mutable usize&, total_table_fields: mutable usize&) -> usize error[ConfigTomlError] can[Memory.Allocate, Abort.Panic]:
            raise ConfigTomlError.UnsupportedValue if start >= end or depth >= CONFIG_TOML_MAX_VALUE_DEPTH
            raise ConfigTomlError.OutputLimitExceeded if total_nodes >= CONFIG_TOML_MAX_TOTAL_VALUE_NODES
            kind: ConfigTomlValueKind = ConfigTomlValueKind.Array if sview_at(source, start) == 91 else ConfigTomlValueKind.InlineTable if sview_at(source, start) == 123 else config_toml_scalar_kind(source, start, end)
            node_index: usize = nodes.count
            nodes.push(ConfigTomlNode{kind: kind})
            total_nodes <- total_nodes + 1
            if kind == ConfigTomlValueKind.Array:
                raise ConfigTomlError.UnsupportedValue if sview_at(source, end - 1) != 93
                pending_children: mutable darray[ConfigTomlNodeChild] = []
                cursor: mutable usize = start + 1
                last_was_comma: mutable bool = false
                while cursor < end - 1:
                    config_toml_skip_array_trivia(source, cursor, end - 1)
                    if cursor == end - 1:
                        break
                    raise ConfigTomlError.OutputLimitExceeded if pending_children.count >= CONFIG_TOML_MAX_ARRAY_ITEMS
                    item_end: usize = try config_toml_graph_item_end(source, cursor, end - 1)
                    item_start: usize = config_toml_trim_start(source, cursor, item_end)
                    item_finish: usize = config_toml_trim_end(source, item_start, item_end)
                    raise ConfigTomlError.UnsupportedValue if item_start >= item_finish
                    child_index: usize = try config_toml_parse_value_graph(source, item_start, item_finish, depth + 1, nodes, children, total_nodes, total_array_items, total_table_fields)
                    raise ConfigTomlError.OutputLimitExceeded if total_array_items >= CONFIG_TOML_MAX_TOTAL_ARRAY_ITEMS
                    total_array_items <- total_array_items + 1
                    pending_children.push(ConfigTomlNodeChild{owner_index: node_index, value_index: child_index, ordinal: pending_children.count})
                    cursor <- item_finish
                    cursor <- config_toml_trim_start(source, cursor, end - 1)
                    if cursor < end - 1:
                        raise ConfigTomlError.UnsupportedValue if sview_at(source, cursor) != 44
                        cursor <- cursor + 1
                        last_was_comma <- true
                    else:
                        last_was_comma <- false
                raise ConfigTomlError.UnsupportedValue if last_was_comma and pending_children.count == 0
                nodes[node_index].child_start <- children.count
                nodes[node_index].child_count <- pending_children.count
                for child in pending_children |children|:
                    children.push(child)
                return node_index
            elif kind == ConfigTomlValueKind.InlineTable:
                raise ConfigTomlError.UnsupportedValue if sview_at(source, end - 1) != 125
                pending_children: mutable darray[ConfigTomlNodeChild] = []
                cursor: mutable usize = start + 1
                while cursor < end - 1:
                    cursor <- config_toml_trim_start(source, cursor, end - 1)
                    if cursor == end - 1:
                        break
                    raise ConfigTomlError.OutputLimitExceeded if pending_children.count >= EsConfig::Limits::ENTRIES_PER_LAYER
                    key_end: mutable usize = cursor
                    while key_end < end - 1 and sview_at(source, key_end) != 61:
                        key_end <- key_end + 1
                    raise ConfigTomlError.ExpectedEquals if key_end >= end - 1
                    key: darray[u8] = try config_toml_parse_key_path(source, cursor, key_end)
                    # A dotted inline-table key denotes nested tables in TOML;
                    # flattening it into one object key would silently change
                    # the document's structure. Until expansion is supported,
                    # reject it rather than misrepresent it in the graph.
                    raise ConfigTomlError.UnsupportedValue if sview_contains_byte(bytes_view(key), 46u8)
                    value_start: usize = config_toml_trim_start(source, key_end + 1, end - 1)
                    value_end: usize = try config_toml_inline_value_end(source, value_start, end - 1)
                    value_start <- config_toml_trim_start(source, value_start, value_end)
                    value_end <- config_toml_trim_end(source, value_start, value_end)
                    raise ConfigTomlError.UnsupportedValue if value_start >= value_end
                    child_index: usize = try config_toml_parse_value_graph(source, value_start, value_end, depth + 1, nodes, children, total_nodes, total_array_items, total_table_fields)
                    raise ConfigTomlError.OutputLimitExceeded if total_table_fields >= CONFIG_TOML_MAX_TOTAL_TABLE_FIELDS
                    total_table_fields <- total_table_fields + 1
                    pending_children.push(ConfigTomlNodeChild{owner_index: node_index, value_index: child_index, ordinal: pending_children.count, key: key})
                    cursor <- value_end
                    cursor <- config_toml_trim_start(source, cursor, end - 1)
                    if cursor < end - 1:
                        raise ConfigTomlError.UnsupportedValue if sview_at(source, cursor) != 44
                        cursor <- cursor + 1
                        cursor <- config_toml_trim_start(source, cursor, end - 1)
                        raise ConfigTomlError.UnsupportedValue if cursor == end - 1
                raise ConfigTomlError.DuplicateKey if not config_toml_graph_children_unique(pending_children)
                nodes[node_index].child_start <- children.count
                nodes[node_index].child_count <- pending_children.count
                for child in pending_children |children|:
                    children.push(child)
                return node_index
            else:
                nodes[node_index].text <- try config_toml_parse_scalar(source, start, end)
                return node_index


        def config_toml_graph_legacy_projection_supported(root_index: usize, nodes: darray[ConfigTomlNode], children: darray[ConfigTomlNodeChild]) -> bool:
            root: ConfigTomlNode = nodes[root_index]
            if root.kind == ConfigTomlValueKind.Array:
                for ordinal in 0..<root.child_count |nodes, children, root|:
                    child_index: usize = children[root.child_start + ordinal].value_index
                    return false if nodes[child_index].kind == ConfigTomlValueKind.Array or nodes[child_index].kind == ConfigTomlValueKind.InlineTable
            elif root.kind == ConfigTomlValueKind.InlineTable:
                for ordinal in 0..<root.child_count |nodes, children, root|:
                    child_index: usize = children[root.child_start + ordinal].value_index
                    child_node: ConfigTomlNode = nodes[child_index]
                    return false if child_node.kind == ConfigTomlValueKind.InlineTable
                    if child_node.kind == ConfigTomlValueKind.Array:
                        for item_ordinal in 0..<child_node.child_count |nodes, children, child_node|:
                            item_index: usize = children[child_node.child_start + item_ordinal].value_index
                            return false if nodes[item_index].kind == ConfigTomlValueKind.Array or nodes[item_index].kind == ConfigTomlValueKind.InlineTable
            return true


        def config_toml_value_kind_valid(kind: ConfigTomlValueKind) -> bool:
            return kind in {ConfigTomlValueKind.Text, ConfigTomlValueKind.Boolean, ConfigTomlValueKind.Integer, ConfigTomlValueKind.Float, ConfigTomlValueKind.Array, ConfigTomlValueKind.InlineTable}


        def config_toml_value_graph_valid(nodes: darray[ConfigTomlNode], children: darray[ConfigTomlNodeChild]) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if nodes.count == 0 or nodes.count > CONFIG_TOML_MAX_TOTAL_VALUE_NODES
            return false if children.count > CONFIG_TOML_MAX_TOTAL_ARRAY_ITEMS + CONFIG_TOML_MAX_TOTAL_TABLE_FIELDS
            parent_counts: mutable darray[usize] = []
            edge_counts: mutable darray[usize] = []
            node_depths: mutable darray[usize] = []
            total_array_children: mutable usize = 0
            total_table_children: mutable usize = 0
            for _ in 0..<nodes.count |parent_counts, edge_counts, node_depths|:
                parent_counts.push(0)
                node_depths.push(0)
            for _ in 0..<children.count |edge_counts|:
                edge_counts.push(0)
            for node_index in 0..<nodes.count |nodes, children, parent_counts, edge_counts|:
                node: ConfigTomlNode = nodes[node_index]
                return false if not config_toml_value_kind_valid(node.kind)
                if node.kind != ConfigTomlValueKind.Array and node.kind != ConfigTomlValueKind.InlineTable:
                    return false if node.child_start != CONFIG_TOML_NODE_INDEX_NONE or node.child_count != 0
                    if node.kind == ConfigTomlValueKind.Text:
                        return false if not config_toml_utf8_valid(bytes_view(node.text))
                    else:
                        return false if node.text.count == 0
                        scalar_view: sview = bytes_view(node.text)
                        return false if config_toml_scalar_kind(scalar_view, 0, node.text.count) != node.kind
                        return false if node.kind == ConfigTomlValueKind.Boolean and scalar_view != "true" and scalar_view != "false"
                        return false if (node.kind == ConfigTomlValueKind.Integer or node.kind == ConfigTomlValueKind.Float) and not config_toml_number_valid(scalar_view, 0, node.text.count)
                else:
                    return false if node.text.count != 0
                    return false if node.child_start == CONFIG_TOML_NODE_INDEX_NONE or node.child_start > children.count
                    return false if node.child_count > children.count - node.child_start
                    if node.kind == ConfigTomlValueKind.Array:
                        return false if node.child_count > CONFIG_TOML_MAX_ARRAY_ITEMS
                        return false if node.child_count > CONFIG_TOML_MAX_TOTAL_ARRAY_ITEMS - total_array_children
                        total_array_children <- total_array_children + node.child_count
                    else:
                        return false if node.child_count > EsConfig::Limits::ENTRIES_PER_LAYER
                        return false if node.child_count > CONFIG_TOML_MAX_TOTAL_TABLE_FIELDS - total_table_children
                        total_table_children <- total_table_children + node.child_count
                    key_names: mutable darray[sview] = []
                    for ordinal in 0..<node.child_count |nodes, children, parent_counts, edge_counts, node_index, node, key_names|:
                        edge_index: usize = node.child_start + ordinal
                        edge: ConfigTomlNodeChild = children[edge_index]
                        return false if edge.owner_index != node_index or edge.ordinal != ordinal or edge.value_index <= node_index or edge.value_index >= nodes.count
                        return false if parent_counts[edge.value_index] != 0
                        return false if node_depths[node_index] >= CONFIG_TOML_MAX_VALUE_DEPTH - 1
                        parent_counts[edge.value_index] <- 1
                        node_depths[edge.value_index] <- node_depths[node_index] + 1
                        edge_counts[edge_index] <- edge_counts[edge_index] + 1
                        if node.kind == ConfigTomlValueKind.Array:
                            return false if edge.key.count != 0
                        else:
                            return false if edge.key.count == 0 or sview_contains_byte(bytes_view(edge.key), 0)
                            return false if not config_toml_utf8_valid(bytes_view(edge.key))
                            key_names.push(bytes_view(edge.key))
                    if node.kind == ConfigTomlValueKind.InlineTable:
                        ordered_names: darray[sview] = sorted(key_names)
                        for offset in 1..<ordered_names.count |ordered_names|:
                            return false if ordered_names[offset - 1] == ordered_names[offset]
            return false if parent_counts[0] != 0
            for index in 1..<parent_counts.count |parent_counts|:
                return false if parent_counts[index] != 1
            for edge_index in 0..<edge_counts.count |edge_counts|:
                return false if edge_counts[edge_index] != 1
            return true


        def config_toml_copy_span(source: sview, start: usize, end: usize) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            copied: mutable darray[u8] = []
            for offset in start..<end |source, copied|:
                copied.push(sview_at(source, offset))
            return copied


        def config_toml_copy_bytes(source: darray[u8]) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            copied: mutable darray[u8] = []
            for byte in source |source, copied|:
                copied.push(byte)
            return copied


        def config_toml_copy_array_items(source: darray[ConfigTomlArrayItem]) -> darray[ConfigTomlArrayItem] can[Memory.Allocate, Abort.Panic]:
            copied: mutable darray[ConfigTomlArrayItem] = []
            for item in source |source, copied|:
                copied.push(ConfigTomlArrayItem{kind: item.kind, text: config_toml_copy_bytes(item.text)})
            return copied


        def config_toml_copy_table_fields(source: darray[ConfigTomlTableField]) -> darray[ConfigTomlTableField] can[Memory.Allocate, Abort.Panic]:
            copied: mutable darray[ConfigTomlTableField] = []
            for field in source |source, copied|:
                copied.push(ConfigTomlTableField{key: config_toml_copy_bytes(field.key), kind: field.kind, text: config_toml_copy_bytes(field.text), items: config_toml_copy_array_items(field.items)})
            return copied


        def config_toml_copy_nodes(source: darray[ConfigTomlNode]) -> darray[ConfigTomlNode] can[Memory.Allocate, Abort.Panic]:
            copied: mutable darray[ConfigTomlNode] = []
            for node in source |source, copied|:
                copied.push(ConfigTomlNode{kind: node.kind, text: config_toml_copy_bytes(node.text), child_start: node.child_start, child_count: node.child_count})
            return copied


        def config_toml_copy_node_children(source: darray[ConfigTomlNodeChild]) -> darray[ConfigTomlNodeChild] can[Memory.Allocate, Abort.Panic]:
            copied: mutable darray[ConfigTomlNodeChild] = []
            for child in source |source, copied|:
                copied.push(ConfigTomlNodeChild{owner_index: child.owner_index, value_index: child.value_index, ordinal: child.ordinal, key: config_toml_copy_bytes(child.key)})
            return copied


        def config_toml_utf8_valid(source: sview) -> bool:
            cursor: mutable Utf8Cursor = Utf8Cursor{}
            for offset in 0..<sview_len(source) |source, cursor|:
                return false if not utf8_feed(sview_at(source, offset), cursor)
            return utf8_complete(cursor)


        def config_toml_bind_typed_winner(layers: darray[ConfigTomlLayer], winner: ConfigValue) -> ConfigTomlResolvedValue error[ConfigTomlError] can[Memory.Allocate, Abort.Panic]:
            for layer in layers |layers, winner|:
                if layer.layer.source == winner.source:
                    raise ConfigTomlError.TypedValueMissing if layer.values.count != layer.layer.entries.count
                    for entry_index in 0..<layer.layer.entries.count |layer, winner|:
                        entry: ConfigEntry = layer.layer.entries[entry_index]
                        if entry.key == winner.key and entry.value == winner.value:
                            raise ConfigTomlError.TypedValueMissing if layer.values[entry_index].key != winner.key
                            typed: ConfigTomlValue = layer.values[entry_index]
                            raise ConfigTomlError.InvalidValueGraph if not config_toml_value_graph_valid(typed.nodes, typed.children)
                            raise ConfigTomlError.InvalidValueGraph if typed.nodes[0].kind != typed.kind
                            typed_text: darray[u8] = config_toml_copy_bytes(typed.text)
                            typed_items: darray[ConfigTomlArrayItem] = config_toml_copy_array_items(typed.items)
                            typed_fields: darray[ConfigTomlTableField] = config_toml_copy_table_fields(typed.fields)
                            typed_nodes: darray[ConfigTomlNode] = config_toml_copy_nodes(typed.nodes)
                            typed_children: darray[ConfigTomlNodeChild] = config_toml_copy_node_children(typed.children)
                            return ConfigTomlResolvedValue{key: winner.key, raw_value: winner.value, source: winner.source, kind: typed.kind, text: typed_text, items: typed_items, fields: typed_fields, nodes: typed_nodes, children: typed_children}
            raise ConfigTomlError.TypedValueMissing


    public:
        def validate_toml_value_graph(nodes: darray[ConfigTomlNode], children: darray[ConfigTomlNodeChild]) -> bool can[Memory.Allocate, Abort.Panic]:
            return config_toml_value_graph_valid(nodes, children)


        def parse_toml_config_layer(source: sview, layer_source: ConfigSource) -> ConfigTomlLayer error[ConfigTomlError, ConfigError] can[Memory.Allocate, Abort.Panic]:
            raise ConfigTomlError.InputLimitExceeded if sview_len(source) > CONFIG_TOML_MAX_BYTES
            raise ConfigTomlError.InvalidUtf8 if not config_toml_utf8_valid(source)
            raise ConfigTomlError.InvalidSource if layer_source not in {ConfigSource.Defaults, ConfigSource.File, ConfigSource.Environment, ConfigSource.CommandLine}
            result: mutable ConfigTomlLayer = ConfigTomlLayer{layer: ConfigLayer{source: layer_source}}
            table_prefix: mutable darray[u8] = []
            declared_tables: mutable darray[darray[u8]] = []
            array_table_paths: mutable darray[darray[u8]] = []
            array_table_counts: mutable darray[usize] = []
            array_table_rows: mutable usize = 0
            table_bytes: mutable usize = 0
            layer_bytes: mutable usize = 0
            array_item_count: mutable usize = 0
            table_field_count: mutable usize = 0
            value_node_count: mutable usize = 0
            graph_array_item_count: mutable usize = 0
            graph_table_field_count: mutable usize = 0
            line_start: mutable usize = 0
            while line_start <= sview_len(source):
                line_end: mutable usize = line_start
                while line_end < sview_len(source) and sview_at(source, line_end) != 10:
                    line_end <- line_end + 1
                content_end: mutable usize = line_end
                content_end <- content_end - 1 if content_end > line_start and sview_at(source, content_end - 1) == 13
                comment_end: usize = config_toml_comment_end(source, line_start, content_end)
                start: usize = config_toml_trim_start(source, line_start, comment_end)
                end: usize = config_toml_trim_end(source, start, comment_end)
                if start < end:
                    first: u8 = sview_at(source, start)
                    if first == 91:
                        is_array_table: bool = start + 1 < end and sview_at(source, start + 1) == 91
                        if is_array_table:
                            raise ConfigTomlError.InvalidTable if end - start < 4 or sview_at(source, end - 1) != 93 or sview_at(source, end - 2) != 93
                            parsed_table: darray[u8] = try config_toml_parse_key_path(source, start + 2, end - 2)
                            raise ConfigTomlError.OutputLimitExceeded if parsed_table.count >= EsConfig::Limits::KEY_BYTES
                            raise ConfigTomlError.OutputLimitExceeded if array_table_rows >= CONFIG_TOML_MAX_ARRAY_TABLE_ROWS
                            for existing_array_table_path in array_table_paths |array_table_paths, parsed_table|:
                                raise ConfigTomlError.UnsupportedValue if config_toml_dotted_descendant(parsed_table, existing_array_table_path) or config_toml_dotted_descendant(existing_array_table_path, parsed_table)
                            for declared in declared_tables |declared, parsed_table|:
                                raise ConfigTomlError.InvalidTable if bytes_view(declared) == bytes_view(parsed_table)
                            array_table_index: usize = config_toml_array_table_index(array_table_paths, parsed_table)
                            array_table_ordinal: mutable usize = 0
                            if array_table_index == array_table_paths.count:
                                raise ConfigTomlError.OutputLimitExceeded if array_table_paths.count >= EsConfig::Limits::ENTRIES_PER_LAYER
                                array_table_paths.push(parsed_table)
                                array_table_counts.push(1)
                            else:
                                array_table_ordinal <- array_table_counts[array_table_index]
                                array_table_counts[array_table_index] <- array_table_ordinal + 1
                            array_table_rows <- array_table_rows + 1
                            result.array_tables.push(ConfigTomlArrayTableInstance{path: parsed_table, index: array_table_ordinal})
                            table_prefix <- []
                            for byte in parsed_table |table_prefix|:
                                table_prefix.push(byte)
                            table_prefix.push(46u8)
                            config_toml_append_array_table_ordinal(table_prefix, array_table_ordinal)
                        else:
                            raise ConfigTomlError.InvalidTable if sview_at(source, end - 1) != 93
                            parsed_table: darray[u8] = try config_toml_parse_key_path(source, start + 1, end - 1)
                            raise ConfigTomlError.OutputLimitExceeded if declared_tables.count >= EsConfig::Limits::ENTRIES_PER_LAYER
                            raise ConfigTomlError.OutputLimitExceeded if parsed_table.count >= EsConfig::Limits::KEY_BYTES
                            for array_table_path in array_table_paths |array_table_paths, parsed_table|:
                                raise ConfigTomlError.InvalidTable if bytes_view(array_table_path) == bytes_view(parsed_table)
                            array_parent: usize = config_toml_array_table_parent(array_table_paths, parsed_table)
                            effective_table: mutable darray[u8] = []
                            if array_parent < array_table_paths.count:
                                parent_path: darray[u8] = array_table_paths[array_parent]
                                for byte in parent_path |parent_path, effective_table|:
                                    effective_table.push(byte)
                                effective_table.push(46u8)
                                latest_ordinal: usize = array_table_counts[array_parent] - 1
                                config_toml_append_array_table_ordinal(effective_table, latest_ordinal)
                                for offset in parent_path.count..<parsed_table.count |parsed_table, effective_table|:
                                    effective_table.push(parsed_table[offset])
                            else:
                                for byte in parsed_table |parsed_table, effective_table|:
                                    effective_table.push(byte)
                            remaining_table_bytes: mutable usize = EsConfig::Limits::LAYER_BYTES - table_bytes
                            raise ConfigTomlError.OutputBytesExceeded if effective_table.count > remaining_table_bytes
                            table_bytes <- table_bytes + effective_table.count
                            declared_tables.push(effective_table)
                            table_prefix <- declared_tables[declared_tables.count - 1]
                    else:
                        equals: mutable usize = start
                        while equals < end and sview_at(source, equals) != 61:
                            equals <- equals + 1
                        raise ConfigTomlError.ExpectedEquals if equals >= end
                        parsed_key: darray[u8] = try config_toml_parse_key_path(source, start, equals)
                        full_key: mutable darray[u8] = []
                        for byte in table_prefix |full_key|:
                            full_key.push(byte)
                        if full_key.count != 0:
                            full_key.push(46u8)
                        for byte in parsed_key |full_key|:
                            full_key.push(byte)
                        value_start: usize = config_toml_trim_start(source, equals + 1, end)
                        if value_start < end and sview_at(source, value_start) == 91:
                            logical_value_end: usize = config_toml_array_value_end(source, value_start, line_end)
                            end <- logical_value_end
                        value_end: usize = config_toml_trim_end(source, value_start, end)
                        raise ConfigTomlError.UnsupportedValue if value_start >= value_end
                        value_kind: ConfigTomlValueKind = ConfigTomlValueKind.Array if sview_at(source, value_start) == 91 else ConfigTomlValueKind.InlineTable if sview_at(source, value_start) == 123 else config_toml_scalar_kind(source, value_start, value_end)
                        typed_text: mutable darray[u8] = []
                        array_items: mutable darray[ConfigTomlArrayItem] = []
                        table_fields: mutable darray[ConfigTomlTableField] = []
                        typed_nodes: mutable darray[ConfigTomlNode] = []
                        typed_children: mutable darray[ConfigTomlNodeChild] = []
                        root_node_index: usize = try config_toml_parse_value_graph(source, value_start, value_end, 0, typed_nodes, typed_children, value_node_count, graph_array_item_count, graph_table_field_count)
                        raise ConfigTomlError.InvalidValueGraph if root_node_index != 0 or typed_nodes[0].kind != value_kind or not config_toml_value_graph_valid(typed_nodes, typed_children)
                        value: darray[u8] = []
                        if value_kind == ConfigTomlValueKind.Array:
                            value <- config_toml_copy_span(source, value_start, value_end)
                            if config_toml_graph_legacy_projection_supported(root_node_index, typed_nodes, typed_children):
                                remaining_array_items: usize = CONFIG_TOML_MAX_TOTAL_ARRAY_ITEMS - array_item_count
                                array_items <- try config_toml_parse_array(source, value_start, value_end, remaining_array_items)
                                array_item_count <- array_item_count + array_items.count
                        elif value_kind == ConfigTomlValueKind.InlineTable:
                            value <- config_toml_copy_span(source, value_start, value_end)
                            if config_toml_graph_legacy_projection_supported(root_node_index, typed_nodes, typed_children):
                                remaining_array_items: usize = CONFIG_TOML_MAX_TOTAL_ARRAY_ITEMS - array_item_count
                                remaining_table_fields: usize = CONFIG_TOML_MAX_TOTAL_TABLE_FIELDS - table_field_count
                                table_fields <- try config_toml_parse_inline_table(source, value_start, value_end, remaining_array_items, remaining_table_fields)
                                table_field_count <- table_field_count + table_fields.count
                                for field in table_fields |table_fields, array_item_count|:
                                    array_item_count <- array_item_count + field.items.count
                        else:
                            typed_text <- try config_toml_parse_scalar(source, value_start, value_end)
                            value <- typed_text
                        raise ConfigTomlError.OutputLimitExceeded if result.layer.entries.count >= EsConfig::Limits::ENTRIES_PER_LAYER
                        raise ConfigTomlError.OutputLimitExceeded if full_key.count >= EsConfig::Limits::KEY_BYTES or value.count >= EsConfig::Limits::VALUE_BYTES
                        remaining: mutable usize = EsConfig::Limits::LAYER_BYTES - layer_bytes
                        raise ConfigTomlError.OutputBytesExceeded if full_key.count > remaining
                        remaining <- remaining - full_key.count
                        raise ConfigTomlError.OutputBytesExceeded if value.count > remaining
                        remaining <- remaining - value.count
                        raise ConfigTomlError.OutputBytesExceeded if remaining < 2
                        layer_bytes <- layer_bytes + full_key.count + value.count + 2
                        result.key_storage.push(full_key)
                        result.value_storage.push(value)
                        key_view: sview = bytes_view(result.key_storage[result.key_storage.count - 1])
                        value_view: sview = bytes_view(result.value_storage[result.value_storage.count - 1])
                        result.layer.entries.push(ConfigEntry{key: key_view, value: value_view})
                        result.values.push(ConfigTomlValue{key: key_view, kind: value_kind, text: typed_text, items: array_items, fields: table_fields, nodes: typed_nodes, children: typed_children})
                if line_end == sview_len(source):
                    break
                line_start <- line_end + 1
            raise ConfigTomlError.DuplicateTable if not config_toml_tables_unique(declared_tables)
            try validate_config_layers([result.layer])
            return result


        def parse_toml_config(source: sview) -> ConfigTomlLayer error[ConfigTomlError, ConfigError] can[Memory.Allocate, Abort.Panic]:
            return try parse_toml_config_layer(source, ConfigSource.File)


        def lookup_toml_config_value(parsed: ConfigTomlLayer&, key: sview) -> usize:
            for index in 0..<parsed.values.count |parsed, key|:
                return index if parsed.values[index].key == key
            return parsed.values.count


        def lookup_resolved_toml_config_value(resolution: ConfigTomlResolution&, key: sview) -> usize:
            for index in 0..<resolution.values.count |resolution, key|:
                return index if resolution.values[index].key == key
            return resolution.values.count


        # Restore TOML types after the generic precedence resolver has selected
        # the winning source for a key. Non-file overrides are configuration
        # strings and therefore become Text without trying to reinterpret them.
        def bind_toml_config_winner(parsed: ConfigTomlLayer&, winner: ConfigValue) -> ConfigTomlResolvedValue error[ConfigTomlError, ConfigError] can[Memory.Allocate, Abort.Panic]:
            if winner.source != ConfigSource.File:
                override_text: mutable darray[u8] = []
                for offset in 0..<sview_len(winner.value) |winner, override_text|:
                    override_text.push(sview_at(winner.value, offset))
                override_nodes: darray[ConfigTomlNode] = [ConfigTomlNode{kind: ConfigTomlValueKind.Text, text: config_toml_copy_bytes(override_text)}]
                return ConfigTomlResolvedValue{key: winner.key, raw_value: winner.value, source: winner.source, kind: ConfigTomlValueKind.Text, text: override_text, nodes: override_nodes}
            raise ConfigTomlError.TypedValueMissing if parsed.layer.source != ConfigSource.File
            entry_index: mutable usize = parsed.layer.entries.count
            for index in 0..<parsed.layer.entries.count |parsed, winner|:
                if parsed.layer.entries[index].key == winner.key and parsed.layer.entries[index].value == winner.value:
                    entry_index <- index
                    break
            raise ConfigTomlError.TypedValueMissing if entry_index >= parsed.values.count
            raise ConfigTomlError.TypedValueMissing if parsed.values[entry_index].key != winner.key
            typed: ConfigTomlValue = parsed.values[entry_index]
            raise ConfigTomlError.InvalidValueGraph if not config_toml_value_graph_valid(typed.nodes, typed.children)
            typed_text: darray[u8] = config_toml_copy_bytes(typed.text)
            typed_items: darray[ConfigTomlArrayItem] = config_toml_copy_array_items(typed.items)
            typed_fields: darray[ConfigTomlTableField] = config_toml_copy_table_fields(typed.fields)
            typed_nodes: darray[ConfigTomlNode] = config_toml_copy_nodes(typed.nodes)
            typed_children: darray[ConfigTomlNodeChild] = config_toml_copy_node_children(typed.children)
            return ConfigTomlResolvedValue{key: winner.key, raw_value: winner.value, source: winner.source, kind: typed.kind, text: typed_text, items: typed_items, fields: typed_fields, nodes: typed_nodes, children: typed_children}


        def resolve_toml_config_layers(parsed: ConfigTomlLayer&, overrides: darray[ConfigLayer]) -> ConfigTomlResolution error[ConfigTomlError, ConfigError] can[Memory.Allocate, Abort.Panic]:
            raise ConfigTomlError.TypedValueMissing if parsed.layer.source != ConfigSource.File
            raise ConfigTomlError.OutputLimitExceeded if parsed.array_tables.count > CONFIG_TOML_MAX_ARRAY_TABLE_ROWS
            raise ConfigError.LayerLimitExceeded if overrides.count >= EsConfig::Limits::LAYERS
            layers: mutable darray[ConfigLayer] = [parsed.layer]
            for layer in overrides |overrides, layers|:
                layers.push(layer)
            winners: darray[ConfigValue] = try resolve_config_layers(layers)
            resolution: mutable ConfigTomlResolution = ConfigTomlResolution{}
            for winner in winners |winners, parsed, resolution|:
                resolution.values.push(try bind_toml_config_winner(parsed, winner))
            for array_table in parsed.array_tables |parsed, resolution|:
                resolution.array_tables.push(ConfigTomlArrayTableInstance{path: config_toml_copy_bytes(array_table.path), index: array_table.index})
            return resolution


        # Resolve explicitly parsed TOML documents at every precedence level.
        # Each key is a whole-value replacement: nested objects are not merged
        # recursively. Each array-of-table path is replaced as one row group
        # by its highest-precedence declaration; rows never merge by index.
        def resolve_toml_config_typed_layers(layers: darray[ConfigTomlLayer]) -> ConfigTomlResolution error[ConfigTomlError, ConfigError] can[Memory.Allocate, Abort.Panic]:
            raise ConfigTomlError.InvalidSource if layers.count == 0
            raise ConfigTomlError.InputLimitExceeded if layers.count > EsConfig::Limits::LAYERS
            raw_layers: mutable darray[ConfigLayer] = []
            total_nodes: mutable usize = 0
            total_edges: mutable usize = 0
            total_array_table_rows: mutable usize = 0
            for layer in layers |layers, raw_layers, total_nodes, total_edges, total_array_table_rows|:
                raise ConfigTomlError.TypedValueMissing if layer.values.count != layer.layer.entries.count
                raise ConfigTomlError.InputLimitExceeded if layer.array_tables.count > EsConfig::Limits::ENTRIES_PER_LAYER - total_array_table_rows
                total_array_table_rows <- total_array_table_rows + layer.array_tables.count
                for row_index in 0..<layer.array_tables.count |layer, row_index|:
                    row: ConfigTomlArrayTableInstance = layer.array_tables[row_index]
                    raise ConfigTomlError.InvalidTable if row.path.count == 0
                    raise ConfigTomlError.ConflictingStructure if row.index >= CONFIG_TOML_MAX_ARRAY_TABLE_ROWS
                    group_count: mutable usize = 0
                    for prior_index in 0..<row_index |layer, row, prior_index|:
                        prior: ConfigTomlArrayTableInstance = layer.array_tables[prior_index]
                        if bytes_view(prior.path) == bytes_view(row.path):
                            raise ConfigTomlError.ConflictingStructure if prior.index == row.index
                        else:
                            raise ConfigTomlError.ConflictingStructure if config_toml_dotted_descendant(row.path, prior.path) or config_toml_dotted_descendant(prior.path, row.path)
                    for candidate_row in layer.array_tables |layer, row, group_count|:
                        group_count <- group_count + 1 if bytes_view(candidate_row.path) == bytes_view(row.path)
                    raise ConfigTomlError.ConflictingStructure if row.index >= group_count
                for other_layer in layers |layers, layer|:
                    if config_toml_source_priority(layer.layer.source) < config_toml_source_priority(other_layer.layer.source):
                        for row in layer.array_tables |layer, other_layer|:
                            for other_row in other_layer.array_tables |other_layer, row|:
                                if bytes_view(other_row.path) != bytes_view(row.path):
                                    raise ConfigTomlError.ConflictingStructure if config_toml_dotted_descendant(row.path, other_row.path) or config_toml_dotted_descendant(other_row.path, row.path)
                for value_index in 0..<layer.values.count |layer, value_index, total_nodes, total_edges|:
                    input: ConfigTomlValue = layer.values[value_index]
                    entry: ConfigEntry = layer.layer.entries[value_index]
                    raise ConfigTomlError.TypedValueMissing if input.key != entry.key
                    raise ConfigTomlError.InvalidValueGraph if not config_toml_value_graph_valid(input.nodes, input.children)
                    raise ConfigTomlError.InvalidValueGraph if input.nodes[0].kind != input.kind
                    raise ConfigTomlError.InputLimitExceeded if input.nodes.count > CONFIG_TOML_MAX_TOTAL_VALUE_NODES - total_nodes
                    raise ConfigTomlError.InputLimitExceeded if input.children.count > CONFIG_TOML_MAX_TOTAL_ARRAY_ITEMS + CONFIG_TOML_MAX_TOTAL_TABLE_FIELDS - total_edges
                    total_nodes <- total_nodes + input.nodes.count
                    total_edges <- total_edges + input.children.count
                filtered: mutable ConfigLayer = ConfigLayer{source: layer.layer.source}
                for entry in layer.layer.entries |layer, entry, filtered|:
                    keep: bool = try config_toml_typed_layer_entry_wins_array_group(layers, layer, entry.key)
                    if keep:
                        filtered.entries.push(entry)
                raw_layers.push(filtered)
            try validate_config_layers(raw_layers)
            winners: darray[ConfigValue] = try resolve_config_layers(raw_layers)
            winner_keys: mutable darray[sview] = []
            for winner in winners |winners, winner_keys|:
                winner_keys.push(winner.key)
            raise ConfigTomlError.ConflictingStructure if config_toml_dotted_key_structure_conflict(winner_keys)
            resolution: mutable ConfigTomlResolution = ConfigTomlResolution{}
            for winner in winners |layers, winners, resolution|:
                resolution.values.push(try config_toml_bind_typed_winner(layers, winner))
            for layer in layers |layers, resolution|:
                for row in layer.array_tables |layer, resolution|:
                    if config_toml_array_table_source(layers, row.path) == layer.layer.source:
                        resolution.array_tables.push(ConfigTomlArrayTableInstance{path: config_toml_copy_bytes(row.path), index: row.index})
            return resolution
