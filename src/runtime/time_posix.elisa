# Narrow POSIX time bridge. The IR exposes a typed sleep operation while this
# boundary keeps the platform-specific blocking call out of the language model.

extend EsRuntime:
    private:
        @link_name(usleep)
        extern elisascript_posix_usleep_impl(microseconds: u32) -> int can[Blocking.IO]

    public:
        def elisascript_posix_usleep(microseconds: u32) -> int can[Blocking.IO]:
            return elisascript_posix_usleep_impl(microseconds)
