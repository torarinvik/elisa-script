# Narrow POSIX time bridge. The IR exposes a typed sleep operation while this
# boundary keeps the platform-specific blocking call out of the language model.

extend EsRuntime:
    public:
        const module DarwinClock:
            MONOTONIC: int = 6


    private:
        @link_name(usleep)
        extern elisascript_posix_usleep_impl(microseconds: u32) -> int can[Blocking.IO]

        @link_name(clock_gettime)
        extern elisascript_posix_clock_gettime_impl(clock_id: int, result: mutable EsMonotonicTime::MonotonicTimestamp&) -> int can[Blocking.IO]

    public:
        def elisascript_posix_usleep(microseconds: u32) -> int can[Blocking.IO]:
            return elisascript_posix_usleep_impl(microseconds)


        def elisascript_posix_monotonic_time(result: mutable EsMonotonicTime::MonotonicTimestamp&) -> int can[Blocking.IO]:
            return elisascript_posix_clock_gettime_impl(DarwinClock::MONOTONIC, result)
