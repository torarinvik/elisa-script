# Narrow POSIX time bridge. The IR exposes a typed sleep operation while this
# boundary keeps the platform-specific blocking call out of the language model.
include "monotonic_time_model.elisa"
include "process_scalar_abi_model.elisa"

extend EsRuntime:
    public:
        const module DarwinClock:
            MONOTONIC: int = 6


    private:
        @link_name(usleep)
        extern elisascript_posix_usleep_impl(microseconds: u32) -> i32 can[Blocking.IO]

        @link_name(clock_gettime)
        # Darwin clockid_t is a C-width enum. Only its positive MONOTONIC
        # value is emitted, using a 32-bit carrier; return is signed C int.
        extern elisascript_posix_clock_gettime_impl(clock_id: u32, result: mutable EsMonotonicTime::MonotonicTimestamp&) -> i32 can[Blocking.IO]

    public:
        def elisascript_posix_usleep(microseconds: u32) -> int can[Blocking.IO]:
            return elisascript_posix_usleep_impl(microseconds).int()


        def elisascript_posix_monotonic_time(result: mutable EsMonotonicTime::MonotonicTimestamp&) -> int can[Blocking.IO]:
            # Reject an unsupported representation before C writes timespec.
            # Like process scalar rejection, -2 does not update errno.
            return EsProcessScalarAbi::Limits::REJECTED if not EsMonotonicTime::darwin64_clock_layout_supported(size_of(uintptr), size_of(i64), size_of(EsMonotonicTime::MonotonicTimestamp), size_of(i32), size_of(u32))
            return elisascript_posix_clock_gettime_impl(DarwinClock::MONOTONIC.u32(), result).int()
