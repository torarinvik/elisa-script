include "macos_deployment_target_model.elisa"

using EsMacosDeploymentTarget


@test
def parses_universal_and_legacy_macos_targets() -> void can[Memory.Allocate, Abort.Panic]:
    output: sview = "Load command 1\n cmd LC_BUILD_VERSION\n platform 1\n minos 27.0\n sdk 27.0\nLoad command 2\n cmd LC_VERSION_MIN_MACOSX\n version 13.2.1\n sdk 14.0\n"
    targets: mutable darray[MacosVersion] = []
    catch deployment_targets(output):
        ok value:
            targets <- value
        error failure:
            _ = failure
            assert false
    assert targets.count == 2
    assert targets[0].major == 27 and targets[0].minor == 0 and targets[0].patch == 0
    assert targets[1].major == 13 and targets[1].minor == 2 and targets[1].patch == 1
    assert format_version(targets[0]) == "27.0"
    assert format_version(targets[1]) == "13.2.1"
    assert version_before(targets[1], targets[0])
    assert Policy::METAL_MINIMUM_MACOS.major == 26


@test
def accepts_supported_platform_spellings_and_two_component_versions() -> void can[Memory.Allocate, Abort.Panic]:
    output: sview = "Load command 0\n cmd LC_BUILD_VERSION\n platform MACOS\t\n minos 00026.03 \nLoad command 1\n cmd LC_BUILD_VERSION\n platform macOS\n minos 25\n"
    targets: mutable darray[MacosVersion] = []
    catch deployment_targets(output):
        ok value:
            targets <- value
        error failure:
            _ = failure
            assert false
    assert targets.count == 2
    assert targets[0].major == 26 and targets[0].minor == 3 and targets[0].patch == 0
    assert targets[1].major == 25 and targets[1].minor == 0 and targets[1].patch == 0
    assert format_version(targets[0]) == "26.3"


def deployment_failure_matches(output: sview, expected: MacosDeploymentTargetError) -> bool can[Memory.Allocate, Abort.Panic]:
    observed: mutable bool = false
    catch deployment_targets(output):
        ok targets:
            _ = targets
        error failure:
            observed <- failure == expected
    return observed


@test
def rejects_foreign_malformed_and_missing_targets() -> void can[Memory.Allocate, Abort.Panic]:
    assert deployment_failure_matches("", MacosDeploymentTargetError.NoDeploymentTarget)
    assert deployment_failure_matches("Load command 0\n cmd LC_BUILD_VERSION\n platform 2\n minos 26.0\n", MacosDeploymentTargetError.NonMacosTarget)
    assert deployment_failure_matches("Load command 0\n cmd LC_BUILD_VERSION\n platform 1\n minos broken\n", MacosDeploymentTargetError.MalformedTarget)
    assert deployment_failure_matches("Load command 0\n cmd LC_BUILD_VERSION\n platform 1\n minos 26.0.0.1\n", MacosDeploymentTargetError.MalformedTarget)
    assert deployment_failure_matches("Load command 0\n cmd LC_VERSION_MIN_MACOSX\n", MacosDeploymentTargetError.MalformedTarget)
    assert deployment_failure_matches("Load command 0\n cmd LC_VERSION_MIN_MACOSX\n version 18446744073709551616 \n", MacosDeploymentTargetError.VersionComponentOverflow)


@test
def command_tokens_require_the_python_helpers_word_boundaries() -> void can[Memory.Allocate, Abort.Panic]:
    assert deployment_failure_matches("Load command 0\n xcmd LC_BUILD_VERSION\n platform 1\n minos 26.0\n", MacosDeploymentTargetError.NoDeploymentTarget)
