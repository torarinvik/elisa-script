# Bridge scanned record fields into bounded editing and record reconstruction.
#
# The caller chooses the output field separator (OFS-like behavior). The
# record policy independently controls whether to preserve the consumed record
# separator or emit its configured output separator.

module EsRecordFieldEditAdapter:
    using EsRecord
    using EsRecordFieldScan
    using EsRecordFields

    public:
        struct RecordFieldEditAdapterSession:
            record: Record
            record_policy: RecordStreamPolicy
            edits: RecordFieldEditSession


    private:
        def record_field_edit_adapter_mode_supported(mode: RecordFieldMode) -> bool:
            return mode in {RecordFieldMode.Whole, RecordFieldMode.Whitespace, RecordFieldMode.Literal}


        def record_field_edit_adapter_fields_match(actual: darray[RecordField], expected: darray[RecordField]) -> bool:
            return false if actual.count != expected.count
            for index in 0..<actual.count |actual, expected|:
                actual_field: mutable RecordField = actual[index]
                expected_field: mutable RecordField = expected[index]
                return false if actual_field.index != expected_field.index
                return false if actual_field.start_byte != expected_field.start_byte or actual_field.end_byte != expected_field.end_byte
                return false if actual_field.present != expected_field.present or actual_field.value != expected_field.value
            return true


        def record_field_edit_adapter_limited_scan_policy(record_policy: RecordStreamPolicy, edit_policy: RecordFieldEditPolicy) -> RecordStreamPolicy:
            bounded_policy: mutable RecordStreamPolicy = record_policy
            bounded_policy.max_fields <- edit_policy.max_fields if edit_policy.max_fields < bounded_policy.max_fields
            return bounded_policy


        def record_field_edit_session_from_validated_fields(fields: darray[RecordField], edit_policy: RecordFieldEditPolicy) -> RecordFieldEditSession error[RecordFieldEditError, RecordFieldScanError] can[Memory.Allocate, Abort.Panic]:
            raise RecordFieldEditError.FieldLimitExceeded if fields.count > edit_policy.max_fields
            values: mutable darray[sview] = []
            for index in 0..<fields.count |fields, values|:
                field: mutable RecordField = fields[index]
                raise RecordFieldScanError.FieldIndexInvalid if field.index != index
                values.push(field.value)
            session: mutable RecordFieldEditSession = RecordFieldEditSession{policy: edit_policy, fields: values}
            _ = try validate_record_field_edit_session(session)
            return session


    public:
        def record_field_edit_session_from_fields(record: Record, record_policy: RecordStreamPolicy, fields: darray[RecordField], edit_policy: RecordFieldEditPolicy) -> RecordFieldEditAdapterSession error[RecordContractError, RecordFieldEditError, RecordFieldScanError] can[Memory.Allocate, Abort.Panic]:
            empty_session: mutable RecordFieldEditSession = RecordFieldEditSession{policy: edit_policy}
            _ = try validate_record_field_edit_session(empty_session)
            raise RecordFieldEditError.FieldLimitExceeded if fields.count > edit_policy.max_fields
            if not record_field_edit_adapter_mode_supported(record_policy.field_mode):
                admitted_record: mutable Record = record
                admitted_record_policy: mutable RecordStreamPolicy = record_policy
                _ = try validate_record(admitted_record, admitted_record_policy)
                raise RecordFieldScanError.UnsupportedMode
            bounded_policy: RecordStreamPolicy = record_field_edit_adapter_limited_scan_policy(record_policy, edit_policy)
            expected_fields: darray[RecordField] = try split_record_fields(record, bounded_policy)
            raise RecordFieldScanError.FieldSetMismatch if not record_field_edit_adapter_fields_match(fields, expected_fields)
            edits: RecordFieldEditSession = try record_field_edit_session_from_validated_fields(expected_fields, edit_policy)
            return RecordFieldEditAdapterSession{record: record, record_policy: record_policy, edits: edits}


        def record_field_edit_session_from_regex_spans(record: Record, record_policy: RecordStreamPolicy, separators: darray[RecordFieldSeparatorSpan], edit_policy: RecordFieldEditPolicy) -> RecordFieldEditAdapterSession error[RecordContractError, RecordFieldEditError, RecordFieldScanError] can[Memory.Allocate, Abort.Panic]:
            empty_session: mutable RecordFieldEditSession = RecordFieldEditSession{policy: edit_policy}
            _ = try validate_record_field_edit_session(empty_session)
            bounded_policy: RecordStreamPolicy = record_field_edit_adapter_limited_scan_policy(record_policy, edit_policy)
            fields: darray[RecordField] = try split_record_fields_from_regex_spans(record, bounded_policy, separators)
            edits: RecordFieldEditSession = try record_field_edit_session_from_validated_fields(fields, edit_policy)
            return RecordFieldEditAdapterSession{record: record, record_policy: record_policy, edits: edits}


        def advance_record_field_edit_adapter(session: mutable RecordFieldEditAdapterSession&, event: RecordFieldEditEvent, edit: RecordFieldEdit = RecordFieldEdit{index: 0, value: ""}) -> RecordFieldEditState error[RecordFieldEditError] can[Memory.Allocate, Abort.Panic]:
            return try advance_record_field_edit(session.edits, event, edit)


        def record_field_reconstruct_record(session: RecordFieldEditAdapterSession&) -> sview error[RecordContractError, RecordFieldEditError] can[Memory.Allocate, Abort.Panic]:
            admitted_record: mutable Record = session.record
            admitted_record_policy: mutable RecordStreamPolicy = session.record_policy
            _ = try validate_record(admitted_record, admitted_record_policy)
            separator: sview = session.record.separator if session.record_policy.preserve_separator else session.record_policy.output_separator
            content_bytes: usize = try record_field_edit_reconstruct_length(session.edits)
            raise RecordFieldEditError.OutputLimitExceeded if content_bytes > session.record_policy.max_record_bytes
            raise RecordFieldEditError.OutputLimitExceeded if sview_len(separator) > session.record_policy.max_record_bytes - content_bytes
            content: sview = try record_field_reconstruct(session.edits)
            return content + separator
