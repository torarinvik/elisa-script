# Bounded RFC-style HTTP Link pagination planning.
#
# This layer parses one successful GET response and drives a bounded
# multi-response pagination session. It performs no network I/O.

module EsNetworkPagination:
    using EsNetwork
    using EsHash

    public:
        const module Limits:
            LINK_VALUES: usize = 1024
            PARAMETERS: usize = 4096
            PAGES: usize = 256
            URL_ARENA_BYTES: usize = 8388608
            VISITED_URLS: usize = 513


        struct NetworkPaginationResult:
            has_next: bool = false
            next_url: darray[u8] = []
            next_headers: darray[sview] = []
            credentials_stripping_active: bool = false


        const enum NetworkPaginationSessionState of u8:
            Ready
            InFlight
            Completed
            Failed
            Cancelling
            Cancelled


        const enum NetworkPaginationSessionEvent of u8:
            Fail
            Cancel
            CancelAck


        struct NetworkPaginationVisitedUrl:
            start: usize = 0
            byte_count: usize = 0
            fingerprint: u64 = 0


        struct NetworkPaginationDispatch:
            page_token: usize
            request: NetworkRequest


        # The session owns its URL bytes and visitation ledger. Header views
        # retain the same lifetime requirement as NetworkRequest header views.
        # `request.url` is refreshed whenever another URL is appended so no
        # internal view points into an invalidated arena allocation.
        struct NetworkPaginationSession:
            request: NetworkRequest
            state: NetworkPaginationSessionState = NetworkPaginationSessionState.Ready
            url_arena: darray[u8] = []
            visited_urls: darray[NetworkPaginationVisitedUrl] = []
            current_visit: usize = 0
            current_headers: darray[sview] = []
            max_pages: usize = Limits::PAGES
            pages_started: usize = 0
            credentials_stripping_active: bool = false


        error NetworkPaginationError:
            InvalidRequest
            InvalidResponseStatus
            InvalidLinkValue
            LinkValueLimitExceeded
            ParameterLimitExceeded
            DuplicateRelationParameter
            MultipleNextLinks
            HttpsDowngrade
            InvalidState
            InvalidEvent
            InvalidPageLimit
            InvalidResponseUrl
            PageLimitExceeded
            CycleDetected
            UrlArenaLimitExceeded
            VisitedUrlLimitExceeded
            InvalidPageToken
            StalePageToken
            AccountingInvalid
            CancelNotReady


    private:
        const module UrlFingerprint:
            FNV_OFFSET: u64 = 14695981039346656037u64
            FNV_PRIME: u64 = 1099511628211u64


        const enum LinkFieldScanState of u8:
            Outside
            Target
            Quoted
            QuotedEscape


        def pagination_ascii_lower(byte: u8) -> u8:
            return byte + 32u8 if byte >= 65u8 and byte <= 90u8 else byte


        def pagination_ascii_equal_ignore_case(left: sview, right: sview) -> bool:
            return false if sview_len(left) != sview_len(right)
            equal: mutable bool = true
            for index in 0..<sview_len(left) |left, right, equal|:
                equal <- false if pagination_ascii_lower(sview_at(left, index)) != pagination_ascii_lower(sview_at(right, index))
            return equal


        def pagination_token_byte_valid(byte: u8) -> bool:
            return true if byte >= 48u8 and byte <= 57u8
            return true if byte >= 65u8 and byte <= 90u8
            return true if byte >= 97u8 and byte <= 122u8
            return true if byte == 33u8 or byte == 35u8 or byte == 36u8 or byte == 37u8 or byte == 38u8 or byte == 39u8 or byte == 42u8 or byte == 43u8 or byte == 45u8 or byte == 46u8 or byte == 94u8 or byte == 95u8 or byte == 96u8 or byte == 124u8 or byte == 126u8
            return false


        def pagination_skip_ows(value: sview, cursor: mutable usize&, end: usize) -> void:
            while cursor < end and (sview_at(value, cursor) == 32u8 or sview_at(value, cursor) == 9u8):
                cursor <- cursor + 1


        def pagination_relation_value_has_next(value: sview, start: usize, end: usize) -> bool:
            cursor: mutable usize = start
            found: mutable bool = false
            while cursor < end:
                pagination_skip_ows(value, cursor, end)
                relation_start: usize = cursor
                while cursor < end and sview_at(value, cursor) != 32u8 and sview_at(value, cursor) != 9u8:
                    cursor <- cursor + 1
                if cursor > relation_start:
                    relation: sview = string_view_slice(value, relation_start.i64(), cursor.i64())
                    found <- true if pagination_ascii_equal_ignore_case(relation, "next")
            return found


        def pagination_target_byte_valid(byte: u8) -> bool:
            return false if byte <= 32u8 or byte == 127u8
            return false if byte == 34u8 or byte == 60u8 or byte == 62u8 or byte == 92u8 or byte == 94u8 or byte == 96u8 or byte == 123u8 or byte == 124u8 or byte == 125u8
            return true


        def pagination_session_state_valid(state: NetworkPaginationSessionState) -> bool:
            return state in {NetworkPaginationSessionState.Ready, NetworkPaginationSessionState.InFlight, NetworkPaginationSessionState.Completed, NetworkPaginationSessionState.Failed, NetworkPaginationSessionState.Cancelling, NetworkPaginationSessionState.Cancelled}


        def pagination_session_event_valid(event: NetworkPaginationSessionEvent) -> bool:
            return event in {NetworkPaginationSessionEvent.Fail, NetworkPaginationSessionEvent.Cancel, NetworkPaginationSessionEvent.CancelAck}


        def pagination_url_fingerprint(url: sview) -> u64:
            fingerprint: mutable u64 = UrlFingerprint::FNV_OFFSET
            for byte in url |url, fingerprint|:
                fingerprint <- EsHash::hash_wrapping_multiply_u64(fingerprint ^ byte.u64(), UrlFingerprint::FNV_PRIME)
            return fingerprint


        def pagination_visited_url_view(session: NetworkPaginationSession&, index: usize) -> sview:
            entry: NetworkPaginationVisitedUrl = session.visited_urls[index]
            return string_view_slice(bytes_view(session.url_arena), entry.start.i64(), (entry.start + entry.byte_count).i64())


        def pagination_find_visited_url(session: NetworkPaginationSession&, fingerprint: u64) -> usize:
            for index in 0..<session.visited_urls.count |session, fingerprint|:
                return index if session.visited_urls[index].fingerprint == fingerprint
            return session.visited_urls.count


        def pagination_header_vectors_equal(left: darray[sview], right: darray[sview]) -> bool:
            return false if left.count != right.count
            equal: mutable bool = true
            for index in 0..<left.count |left, right, equal|:
                equal <- false if left[index] != right[index]
            return equal


        def pagination_append_visited_url(session: mutable NetworkPaginationSession&, url: sview) -> usize error[NetworkPaginationError, NetworkContractError] can[Memory.Allocate, Abort.Panic]:
            url_bytes: usize = sview_len(url)
            raise NetworkPaginationError.InvalidResponseUrl if url_bytes == 0 or url_bytes >= EsNetwork::Limits::URL_BYTES
            raise NetworkPaginationError.UrlArenaLimitExceeded if session.url_arena.count > Limits::URL_ARENA_BYTES
            raise NetworkPaginationError.UrlArenaLimitExceeded if url_bytes > Limits::URL_ARENA_BYTES - session.url_arena.count
            raise NetworkPaginationError.VisitedUrlLimitExceeded if session.visited_urls.count >= Limits::VISITED_URLS
            _ = try network_url_uses_tls(url)
            start: usize = session.url_arena.count
            for byte in url |url, session|:
                session.url_arena.push(byte)
            session.visited_urls.push(NetworkPaginationVisitedUrl{start: start, byte_count: url_bytes, fingerprint: pagination_url_fingerprint(url)})
            return session.visited_urls.count - 1


        def pagination_session_current_request(session: NetworkPaginationSession&) -> NetworkRequest:
            current_request: mutable NetworkRequest = session.request
            current_request.url <- pagination_visited_url_view(session, session.current_visit)
            current_request.headers <- session.current_headers
            return current_request


        def pagination_parse_link_value(value: sview, start: usize, end: usize, base_url: sview, base_uses_tls: bool, result: mutable NetworkPaginationResult&, link_count: mutable usize&, parameter_count: mutable usize&) -> void error[NetworkPaginationError, NetworkContractError] can[Memory.Allocate, Abort.Panic]:
            cursor: mutable usize = start
            pagination_skip_ows(value, cursor, end)
            return if cursor == end
            raise NetworkPaginationError.InvalidLinkValue if sview_at(value, cursor) != 60u8
            target_start: usize = cursor + 1
            cursor <- target_start
            while cursor < end and sview_at(value, cursor) != 62u8:
                raise NetworkPaginationError.InvalidLinkValue if sview_at(value, cursor) == 60u8 or not pagination_target_byte_valid(sview_at(value, cursor))
                cursor <- cursor + 1
            raise NetworkPaginationError.InvalidLinkValue if cursor >= end
            target_end: usize = cursor
            target: sview = string_view_slice(value, target_start.i64(), target_end.i64())
            cursor <- cursor + 1
            rel_seen: mutable bool = false
            rel_has_next: mutable bool = false
            while cursor < end:
                pagination_skip_ows(value, cursor, end)
                if cursor < end:
                    raise NetworkPaginationError.InvalidLinkValue if sview_at(value, cursor) != 59u8
                    cursor <- cursor + 1
                    pagination_skip_ows(value, cursor, end)
                    parameter_start: usize = cursor
                    while cursor < end and pagination_token_byte_valid(sview_at(value, cursor)):
                        cursor <- cursor + 1
                    raise NetworkPaginationError.InvalidLinkValue if cursor == parameter_start
                    parameter_name: sview = string_view_slice(value, parameter_start.i64(), cursor.i64())
                    pagination_skip_ows(value, cursor, end)
                    has_value: mutable bool = false
                    quoted_value: mutable bool = false
                    value_had_escape: mutable bool = false
                    parameter_value_start: mutable usize = cursor
                    parameter_value_end: mutable usize = cursor
                    if cursor < end and sview_at(value, cursor) == 61u8:
                        has_value <- true
                        cursor <- cursor + 1
                        pagination_skip_ows(value, cursor, end)
                        if cursor < end and sview_at(value, cursor) == 34u8:
                            quoted_value <- true
                            cursor <- cursor + 1
                            parameter_value_start <- cursor
                            closed: mutable bool = false
                            while cursor < end and not closed:
                                byte: u8 = sview_at(value, cursor)
                                if value_had_escape:
                                    value_had_escape <- false
                                    cursor <- cursor + 1
                                elif byte == 92u8:
                                    value_had_escape <- true
                                    cursor <- cursor + 1
                                elif byte == 34u8:
                                    parameter_value_end <- cursor
                                    cursor <- cursor + 1
                                    closed <- true
                                else:
                                    cursor <- cursor + 1
                            raise NetworkPaginationError.InvalidLinkValue if not closed or value_had_escape
                        else:
                            parameter_value_start <- cursor
                            while cursor < end and pagination_token_byte_valid(sview_at(value, cursor)):
                                cursor <- cursor + 1
                            raise NetworkPaginationError.InvalidLinkValue if cursor == parameter_value_start
                            parameter_value_end <- cursor
                    raise NetworkPaginationError.ParameterLimitExceeded if parameter_count >= Limits::PARAMETERS
                    parameter_count <- parameter_count + 1
                    if pagination_ascii_equal_ignore_case(parameter_name, "rel"):
                        raise NetworkPaginationError.DuplicateRelationParameter if rel_seen
                        rel_seen <- true
                        if has_value:
                            parameter_value: sview = string_view_slice(value, parameter_value_start.i64(), parameter_value_end.i64())
                            rel_has_next <- pagination_relation_value_has_next(parameter_value, 0, sview_len(parameter_value)) if quoted_value
                            rel_has_next <- pagination_ascii_equal_ignore_case(parameter_value, "next") if not quoted_value
            link_count <- link_count + 1
            raise NetworkPaginationError.LinkValueLimitExceeded if link_count > Limits::LINK_VALUES
            if rel_has_next:
                raise NetworkPaginationError.MultipleNextLinks if result.has_next
                result.next_url <- try network_resolve_redirect_location(base_url, target)
                next_uses_tls: bool = try network_url_uses_tls(bytes_view(result.next_url))
                raise NetworkPaginationError.HttpsDowngrade if base_uses_tls and not next_uses_tls
                result.has_next <- true


        def pagination_parse_link_field(value: sview, base_url: sview, base_uses_tls: bool, result: mutable NetworkPaginationResult&, link_count: mutable usize&, parameter_count: mutable usize&) -> void error[NetworkPaginationError, NetworkContractError] can[Memory.Allocate, Abort.Panic]:
            state: mutable LinkFieldScanState = LinkFieldScanState.Outside
            segment_start: mutable usize = 0
            for index in 0..<sview_len(value) |value, state, segment_start, base_url, base_uses_tls, result, link_count, parameter_count|:
                byte: u8 = sview_at(value, index)
                match state:
                    LinkFieldScanState.Outside:
                        if byte == 60u8:
                            state <- LinkFieldScanState.Target
                        elif byte == 34u8:
                            state <- LinkFieldScanState.Quoted
                        elif byte == 44u8:
                            try pagination_parse_link_value(value, segment_start, index, base_url, base_uses_tls, result, link_count, parameter_count)
                            segment_start <- index + 1
                    LinkFieldScanState.Target:
                        state <- LinkFieldScanState.Outside if byte == 62u8
                    LinkFieldScanState.Quoted:
                        state <- LinkFieldScanState.QuotedEscape if byte == 92u8
                        state <- LinkFieldScanState.Outside if byte == 34u8
                    LinkFieldScanState.QuotedEscape:
                        state <- LinkFieldScanState.Quoted
            raise NetworkPaginationError.InvalidLinkValue if state != LinkFieldScanState.Outside
            try pagination_parse_link_value(value, segment_start, sview_len(value), base_url, base_uses_tls, result, link_count, parameter_count)


    public:
        def validate_network_pagination_session(session: NetworkPaginationSession&) -> bool error[NetworkPaginationError, NetworkContractError] can[Memory.Allocate, Abort.Panic]:
            raise NetworkPaginationError.InvalidState if not pagination_session_state_valid(session.state)
            raise NetworkPaginationError.InvalidPageLimit if session.max_pages == 0 or session.max_pages > Limits::PAGES
            raise NetworkPaginationError.PageLimitExceeded if session.pages_started > session.max_pages
            raise NetworkPaginationError.UrlArenaLimitExceeded if session.url_arena.count > Limits::URL_ARENA_BYTES
            raise NetworkPaginationError.VisitedUrlLimitExceeded if session.visited_urls.count == 0 or session.visited_urls.count > Limits::VISITED_URLS or session.visited_urls.count > session.max_pages * 2 + 1
            raise NetworkPaginationError.AccountingInvalid if session.current_visit >= session.visited_urls.count or session.current_visit != session.visited_urls.count - 1
            raise NetworkPaginationError.AccountingInvalid if session.pages_started > session.visited_urls.count
            try validate_network_request(session.request)
            raise NetworkPaginationError.InvalidRequest if session.request.method != NetworkMethod.Get or session.request.body.count != 0
            raise NetworkPaginationError.AccountingInvalid if session.current_headers.count % 2 != 0
            expected_start: mutable usize = 0
            for index in 0..<session.visited_urls.count |session, expected_start|:
                entry: NetworkPaginationVisitedUrl = session.visited_urls[index]
                raise NetworkPaginationError.AccountingInvalid if entry.start != expected_start or entry.byte_count == 0 or entry.byte_count >= EsNetwork::Limits::URL_BYTES
                raise NetworkPaginationError.AccountingInvalid if entry.start > session.url_arena.count
                raise NetworkPaginationError.AccountingInvalid if entry.byte_count > session.url_arena.count - entry.start
                url: sview = pagination_visited_url_view(session, index)
                raise NetworkPaginationError.AccountingInvalid if pagination_url_fingerprint(url) != entry.fingerprint
                _ = try network_url_uses_tls(url)
                for prior in 0..<index |session, entry|:
                    raise NetworkPaginationError.CycleDetected if session.visited_urls[prior].fingerprint == entry.fingerprint
                expected_start <- expected_start + entry.byte_count
            raise NetworkPaginationError.AccountingInvalid if expected_start != session.url_arena.count
            raise NetworkPaginationError.AccountingInvalid if session.request.url != pagination_visited_url_view(session, session.current_visit)
            current_request: NetworkRequest = pagination_session_current_request(session)
            try validate_network_request(current_request)
            raise NetworkPaginationError.InvalidRequest if current_request.method != NetworkMethod.Get or current_request.body.count != 0
            expected_headers: mutable darray[sview] = session.request.headers
            if session.current_visit != 0:
                expected_headers <- try network_request_effective_headers(session.request, NetworkMethod.Get, 0, true, session.credentials_stripping_active)
            raise NetworkPaginationError.AccountingInvalid if not pagination_header_vectors_equal(session.current_headers, expected_headers)
            if session.state == NetworkPaginationSessionState.Ready:
                raise NetworkPaginationError.InvalidState if session.pages_started >= session.max_pages
            elif session.state == NetworkPaginationSessionState.InFlight:
                raise NetworkPaginationError.AccountingInvalid if session.pages_started == 0
            elif session.state == NetworkPaginationSessionState.Completed:
                raise NetworkPaginationError.AccountingInvalid if session.pages_started == 0
            elif session.state == NetworkPaginationSessionState.Cancelling or session.state == NetworkPaginationSessionState.Cancelled:
                raise NetworkPaginationError.AccountingInvalid if session.state == NetworkPaginationSessionState.Cancelling and session.pages_started == 0
            return true


        # Capture a GET policy into an owned pagination session. URL bytes are
        # copied; the request's header and sensitive-header views remain
        # borrowed for the lifetime of the session.
        def start_network_pagination(request: NetworkRequest, max_pages: usize = Limits::PAGES) -> NetworkPaginationSession error[NetworkPaginationError, NetworkContractError] can[Memory.Allocate, Abort.Panic]:
            try validate_network_request(request)
            raise NetworkPaginationError.InvalidRequest if request.method != NetworkMethod.Get or request.body.count != 0
            raise NetworkPaginationError.InvalidPageLimit if max_pages == 0 or max_pages > Limits::PAGES
            initial_url: sview = request.url
            session: mutable NetworkPaginationSession = NetworkPaginationSession{request: request, current_headers: request.headers, max_pages: max_pages}
            initial_visit: usize = try pagination_append_visited_url(session, initial_url)
            session.current_visit <- initial_visit
            session.request.url <- pagination_visited_url_view(session, initial_visit)
            try validate_network_pagination_session(session)
            return session


        # Dispatch exactly one page request. The returned URL is backed by the
        # session-owned arena; the caller must keep the session alive until the
        # request has completed or cancellation has been acknowledged.
        def dispatch_network_pagination_page(session: mutable NetworkPaginationSession&) -> NetworkPaginationDispatch error[NetworkPaginationError, NetworkContractError] can[Memory.Allocate, Abort.Panic]:
            try validate_network_pagination_session(session)
            raise NetworkPaginationError.InvalidState if session.state != NetworkPaginationSessionState.Ready
            raise NetworkPaginationError.PageLimitExceeded if session.pages_started >= session.max_pages
            request: NetworkRequest = pagination_session_current_request(session)
            session.pages_started <- session.pages_started + 1
            session.state <- NetworkPaginationSessionState.InFlight
            return NetworkPaginationDispatch{page_token: session.pages_started, request: request}


        # Complete the in-flight GET response and either seal the session or
        # prepare its next request. Repeated URL fingerprints fail closed, so
        # even a hash collision cannot turn a cycle into an unbounded fetch.
        def complete_network_pagination_page(session: mutable NetworkPaginationSession&, page_token: usize, response: NetworkResponse, effective_response_url: sview, hop_credentials_stripping_active: bool = false) -> NetworkPaginationResult error[NetworkPaginationError, NetworkContractError] can[Memory.Allocate, Abort.Panic]:
            try validate_network_pagination_session(session)
            raise NetworkPaginationError.InvalidState if session.state != NetworkPaginationSessionState.InFlight
            raise NetworkPaginationError.InvalidPageToken if page_token == 0
            raise NetworkPaginationError.StalePageToken if page_token != session.pages_started
            effective_url_valid: mutable bool = false
            catch network_url_uses_tls(effective_response_url):
                ok value:
                    effective_url_valid <- true
                error issue:
                    effective_url_valid <- false
            raise NetworkPaginationError.InvalidResponseUrl if not effective_url_valid
            request: NetworkRequest = pagination_session_current_request(session)
            requested_uses_tls: bool = try network_url_uses_tls(request.url)
            effective_uses_tls: bool = try network_url_uses_tls(effective_response_url)
            raise NetworkPaginationError.HttpsDowngrade if requested_uses_tls and not effective_uses_tls
            credentials_were_stripped: bool = session.credentials_stripping_active or hop_credentials_stripping_active
            result: mutable NetworkPaginationResult = try network_pagination_next_page(request, effective_response_url, response, credentials_were_stripped)
            if not result.has_next:
                session.state <- NetworkPaginationSessionState.Completed
                try validate_network_pagination_session(session)
                return result

            if session.pages_started >= session.max_pages:
                session.state <- NetworkPaginationSessionState.Failed
                raise NetworkPaginationError.PageLimitExceeded

            effective_fingerprint: u64 = pagination_url_fingerprint(effective_response_url)
            effective_index: usize = pagination_find_visited_url(session, effective_fingerprint)
            current_url: sview = pagination_visited_url_view(session, session.current_visit)
            if effective_index < session.visited_urls.count:
                if effective_index != session.current_visit or pagination_visited_url_view(session, effective_index) != effective_response_url:
                    session.state <- NetworkPaginationSessionState.Failed
                    raise NetworkPaginationError.CycleDetected
            next_url: sview = bytes_view(result.next_url)
            next_fingerprint: u64 = pagination_url_fingerprint(next_url)
            if pagination_find_visited_url(session, next_fingerprint) < session.visited_urls.count or next_fingerprint == effective_fingerprint:
                session.state <- NetworkPaginationSessionState.Failed
                raise NetworkPaginationError.CycleDetected

            add_effective_url: bool = effective_response_url != current_url
            url_bytes_needed: usize = sview_len(next_url)
            if url_bytes_needed > Limits::URL_ARENA_BYTES:
                session.state <- NetworkPaginationSessionState.Failed
                raise NetworkPaginationError.UrlArenaLimitExceeded
            if add_effective_url:
                if sview_len(effective_response_url) > Limits::URL_ARENA_BYTES - url_bytes_needed:
                    session.state <- NetworkPaginationSessionState.Failed
                    raise NetworkPaginationError.UrlArenaLimitExceeded
                url_bytes_needed <- url_bytes_needed + sview_len(effective_response_url)
            if session.url_arena.count > Limits::URL_ARENA_BYTES or url_bytes_needed > Limits::URL_ARENA_BYTES - session.url_arena.count:
                session.state <- NetworkPaginationSessionState.Failed
                raise NetworkPaginationError.UrlArenaLimitExceeded
            new_visit_count: usize = 1 if not add_effective_url else 2
            if new_visit_count > session.max_pages * 2 + 1 - session.visited_urls.count:
                session.state <- NetworkPaginationSessionState.Failed
                raise NetworkPaginationError.VisitedUrlLimitExceeded

            if add_effective_url:
                _ = try pagination_append_visited_url(session, effective_response_url)
            next_visit: usize = try pagination_append_visited_url(session, next_url)
            session.current_visit <- next_visit
            session.current_headers <- result.next_headers
            session.credentials_stripping_active <- result.credentials_stripping_active
            session.request.url <- pagination_visited_url_view(session, next_visit)
            session.state <- NetworkPaginationSessionState.Ready
            try validate_network_pagination_session(session)
            return result


        def advance_network_pagination_session(session: mutable NetworkPaginationSession&, event: NetworkPaginationSessionEvent, page_token: usize = 0) -> NetworkPaginationSessionState error[NetworkPaginationError, NetworkContractError] can[Memory.Allocate, Abort.Panic]:
            try validate_network_pagination_session(session)
            raise NetworkPaginationError.InvalidEvent if not pagination_session_event_valid(event)
            if event == NetworkPaginationSessionEvent.Fail:
                raise NetworkPaginationError.InvalidState if session.state != NetworkPaginationSessionState.Ready and session.state != NetworkPaginationSessionState.InFlight
                if session.state == NetworkPaginationSessionState.Ready:
                    raise NetworkPaginationError.InvalidPageToken if page_token != 0
                else:
                    raise NetworkPaginationError.InvalidPageToken if page_token == 0
                    raise NetworkPaginationError.StalePageToken if page_token != session.pages_started
                session.state <- NetworkPaginationSessionState.Failed
            elif event == NetworkPaginationSessionEvent.Cancel:
                raise NetworkPaginationError.CancelNotReady if session.state != NetworkPaginationSessionState.Ready and session.state != NetworkPaginationSessionState.InFlight
                if session.state == NetworkPaginationSessionState.Ready:
                    raise NetworkPaginationError.InvalidPageToken if page_token != 0
                    session.state <- NetworkPaginationSessionState.Cancelled
                else:
                    raise NetworkPaginationError.InvalidPageToken if page_token == 0
                    raise NetworkPaginationError.StalePageToken if page_token != session.pages_started
                    session.state <- NetworkPaginationSessionState.Cancelling
            elif event == NetworkPaginationSessionEvent.CancelAck:
                raise NetworkPaginationError.CancelNotReady if session.state != NetworkPaginationSessionState.Cancelling
                raise NetworkPaginationError.InvalidPageToken if page_token == 0
                raise NetworkPaginationError.StalePageToken if page_token != session.pages_started
                session.state <- NetworkPaginationSessionState.Cancelled
            try validate_network_pagination_session(session)
            return session.state


        # Extract exactly one rel=next target from an HTTP Link response. The
        # returned URL bytes are owned; header text views still borrow from the
        # request, which the caller must keep alive while using next_headers.
        # Carry credentials_stripping_active into the next call to keep
        # credential removal sticky across a cross-origin pagination chain.
        def network_pagination_next_page(request: NetworkRequest&, current_url: sview, response: NetworkResponse&, credentials_stripping_active: bool = false) -> NetworkPaginationResult error[NetworkPaginationError, NetworkContractError] can[Memory.Allocate, Abort.Panic]:
            try validate_network_request(request)
            raise NetworkPaginationError.InvalidRequest if request.method != NetworkMethod.Get or request.body.count != 0
            base_uses_tls: bool = try network_url_uses_tls(current_url)
            try validate_network_response(response)
            raise NetworkPaginationError.InvalidResponseStatus if response.outcome != NetworkOutcome.Success or response.status < 200 or response.status > 299
            result: mutable NetworkPaginationResult = NetworkPaginationResult{credentials_stripping_active: credentials_stripping_active}
            link_count: mutable usize = 0
            parameter_count: mutable usize = 0
            for index in 0..<response.headers.count |response, result, link_count, parameter_count, current_url, base_uses_tls|:
                if index % 2 == 0 and pagination_ascii_equal_ignore_case(response.headers[index], "link"):
                    try pagination_parse_link_field(response.headers[index + 1], current_url, base_uses_tls, result, link_count, parameter_count)
            if result.has_next:
                next_url: sview = bytes_view(result.next_url)
                same_origin: bool = try network_url_same_origin(current_url, next_url)
                result.credentials_stripping_active <- result.credentials_stripping_active or not same_origin
                result.next_headers <- try network_request_effective_headers(request, NetworkMethod.Get, 0, true, result.credentials_stripping_active)
            return result
