# Stable process-exit classification and bounded OS-status mapping.
#
# A script may return an explicit user status, but launcher/host failures retain
# their category and use reserved codes. Signal-derived statuses are kept
# distinct from cancellation and never accept an arbitrary negative integer.

module EsExitStatus:
    public:
        const module ExitCode:
            SUCCESS: i64 = 0
            USAGE: i64 = 2
            SOURCE: i64 = 65
            CHECK: i64 = 66
            TEST: i64 = 67
            SCRIPT: i64 = 70
            HOST: i64 = 71
            LIMIT: i64 = 124
            CANCELLED: i64 = 130
            MAX_USER: i64 = 123


        const module SignalCode:
            STATUS_BASE: i64 = 128
            MAX_SIGNAL: i64 = 64


        const enum ExitOutcome of u8:
            Success
            User
            UsageError
            SourceError
            CheckFailure
            TestFailure
            ScriptError
            HostError
            LimitExceeded
            Cancelled
            Signal


        struct ExitStatus:
            outcome: ExitOutcome
            user_code: i64 = 0
            signal: i64 = 0
            detail_code: u32 = 0


        error ExitStatusError:
            InvalidOutcome
            InvalidUserCode
            InvalidSignal
            InvalidDetail
            StatusUnavailable


    private:
        def exit_outcome_valid(outcome: ExitOutcome) -> bool:
            return outcome in {ExitOutcome.Success, ExitOutcome.User, ExitOutcome.UsageError, ExitOutcome.SourceError, ExitOutcome.CheckFailure, ExitOutcome.TestFailure, ExitOutcome.ScriptError, ExitOutcome.HostError, ExitOutcome.LimitExceeded, ExitOutcome.Cancelled, ExitOutcome.Signal}


        def exit_reserved_code(outcome: ExitOutcome) -> i64:
            return ExitCode::SUCCESS if outcome == ExitOutcome.Success else ExitCode::USAGE if outcome == ExitOutcome.UsageError else ExitCode::SOURCE if outcome == ExitOutcome.SourceError else ExitCode::CHECK if outcome == ExitOutcome.CheckFailure else ExitCode::TEST if outcome == ExitOutcome.TestFailure else ExitCode::SCRIPT if outcome == ExitOutcome.ScriptError else ExitCode::HOST if outcome == ExitOutcome.HostError else ExitCode::LIMIT if outcome == ExitOutcome.LimitExceeded else ExitCode::CANCELLED


    public:
        def validate_exit_status(status: ExitStatus) -> bool error[ExitStatusError]:
            raise ExitStatusError.InvalidOutcome if not exit_outcome_valid(status.outcome)
            if status.outcome == ExitOutcome.User:
                raise ExitStatusError.InvalidUserCode if status.user_code < 0 or status.user_code > ExitCode::MAX_USER
                raise ExitStatusError.InvalidDetail if status.detail_code != 0
            elif status.outcome == ExitOutcome.Success:
                raise ExitStatusError.InvalidUserCode if status.user_code != 0 or status.signal != 0
                raise ExitStatusError.InvalidDetail if status.detail_code != 0
            elif status.outcome == ExitOutcome.Signal:
                raise ExitStatusError.InvalidSignal if status.signal <= 0 or status.signal > SignalCode::MAX_SIGNAL
                raise ExitStatusError.InvalidUserCode if status.user_code != 0
                raise ExitStatusError.InvalidDetail if status.detail_code != 0
            else:
                raise ExitStatusError.InvalidUserCode if status.user_code != 0
                raise ExitStatusError.InvalidSignal if status.signal != 0
            return true


        def exit_status_code(status: ExitStatus) -> i64 error[ExitStatusError]:
            try validate_exit_status(status)
            if status.outcome == ExitOutcome.User:
                return status.user_code
            if status.outcome == ExitOutcome.Signal:
                return SignalCode::STATUS_BASE + status.signal
            return exit_reserved_code(status.outcome)
