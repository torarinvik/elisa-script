# Darwin filesystem adapter for the pure Bash 3.2 lookup model.
# This remains opt-in: callers own the PATH plan and credential snapshot.
include "directory_posix.elisa"
include "bash_exec_lookup_model.elisa"

using EsRuntime

module EsBashExecLookupPosix:
    using EsEnvironmentLookup

    public:
        const module Limits:
            CANDIDATE_PATH_BYTES: usize = EsBashExecLookup::Limits::CANDIDATE_PATH_BYTES
            SUPPLEMENTARY_GROUPS: usize = 1024
            PASSWD_BUFFER_BYTES: usize = 65536
            PASSWD_USERNAME_BYTES: usize = 1024


        const enum TildeEnvironmentVariable of u8:
            Home
            WorkingDirectory
            PreviousWorkingDirectory


        struct TildeEnvironmentSnapshot:
            present: bool = false
            bytes: darray[u8] = []


        error ObservationError:
            CandidatePathLimitExceeded
            CandidatePathContainsNul
            CredentialGroupLimitExceeded
            CredentialGroupObservationInvalid
            InvalidTildeEnvironmentVariable
            PasswordDatabaseLookupUnavailable
            PasswordHomePointerOutsideBuffer
            PasswordHomeStringUnterminated
            PasswordHomeLimitExceeded
            InvalidInvocationPathObservation


        struct ObservedPathCandidate:
            path: darray[u8] = []
            observation: EsBashExecLookup::PathCandidate = EsBashExecLookup::PathCandidate{}


        struct SearchObservation:
            mode: EsBashExecLookup::SearchMode = EsBashExecLookup::SearchMode::DirectName
            path_selection_available: bool = false
            unsearched_name_returned: bool = false
            unsearched_name: darray[u8] = []
            candidates: darray[ObservedPathCandidate] = []
            selection: EsBashExecLookup::Selection = EsBashExecLookup::Selection{}


        struct InvocationPath:
            available: bool = false
            bytes: darray[u8] = []


    private:
        # Darwin arm64's pwd.h `struct passwd`. Keep this ABI declaration
        # private to the Darwin adapter; reentrant libc APIs write the full
        # record into caller-owned storage.
        struct DarwinPasswdRecord:
            name: u8&?
            password: u8&?
            user: u32
            group: u32
            changed: i64
            class_name: u8&?
            gecos: u8&?
            home_directory: u8&?
            shell: u8&?
            expires: i64


        const enum ReachedTildeEnvironmentNeed of u8:
            None
            Home
            WorkingDirectory
            PreviousWorkingDirectory


        def copy_environment_bytes(value: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            owned: mutable darray[u8] = []
            for byte in value |owned|:
                owned.push(byte)
            return owned


        def reached_tilde_environment_need(directory: sview, tilde: EsBashExecLookup::PathTildeContext&) -> ReachedTildeEnvironmentNeed:
            directory_length: usize = sview_len(directory)
            return ReachedTildeEnvironmentNeed::None if directory_length == 0 or sview_at(directory, 0) != 126u8

            prefix_end: mutable usize = 1
            while prefix_end < directory_length and sview_at(directory, prefix_end) != 47u8 |directory, prefix_end|:
                prefix_end <- prefix_end + 1
            word_length: usize = prefix_end - 1
            return ReachedTildeEnvironmentNeed::Home if word_length == 0
            return ReachedTildeEnvironmentNeed::WorkingDirectory if word_length == 1 and sview_at(directory, 1) == 43u8
            return ReachedTildeEnvironmentNeed::PreviousWorkingDirectory if word_length == 1 and sview_at(directory, 1) == 45u8

            digits_start: mutable usize = 1
            from_right: mutable bool = false
            first_byte: u8 = sview_at(directory, 1)
            if first_byte == 43u8 or first_byte == 45u8:
                digits_start <- 2
                from_right <- first_byte == 45u8
            return ReachedTildeEnvironmentNeed::None if digits_start >= prefix_end

            if not from_right:
                index_is_zero: mutable bool = true
                for index in digits_start..<prefix_end |directory|:
                    byte: u8 = sview_at(directory, index)
                    return ReachedTildeEnvironmentNeed::None if byte < 48u8 or byte > 57u8
                    index_is_zero <- false if byte != 48u8
                return ReachedTildeEnvironmentNeed::WorkingDirectory if index_is_zero
                return ReachedTildeEnvironmentNeed::None

            return ReachedTildeEnvironmentNeed::None if not tilde.directory_stack_present
            requested_index: mutable usize = 0
            stack_count: usize = tilde.directory_stack.count
            for index in digits_start..<prefix_end |directory, requested_index|:
                byte: u8 = sview_at(directory, index)
                return ReachedTildeEnvironmentNeed::None if byte < 48u8 or byte > 57u8
                digit: usize = (byte - 48u8).usize()
                return ReachedTildeEnvironmentNeed::None if digit > stack_count
                return ReachedTildeEnvironmentNeed::None if requested_index > (stack_count - digit) / 10
                requested_index <- requested_index * 10 + digit
            return ReachedTildeEnvironmentNeed::WorkingDirectory if requested_index == stack_count
            return ReachedTildeEnvironmentNeed::None


        @link_name(geteuid)
        extern bash_lookup_effective_user() -> u32

        @link_name(getgid)
        extern bash_lookup_real_group() -> u32

        @link_name(getegid)
        extern bash_lookup_effective_group() -> u32

        @link_name(getuid)
        extern bash_lookup_real_user() -> u32 can[Blocking.IO]

        @link_name(getpwuid_r)
        extern bash_lookup_getpwuid(user: u32, record: mutable DarwinPasswdRecord&, buffer: mutable u8&, buffer_size: usize, result: mutable DarwinPasswdRecord&?&) -> i32 can[Blocking.IO]

        @link_name(getpwnam_r)
        extern bash_lookup_getpwnam(name: cstr, record: mutable DarwinPasswdRecord&, buffer: mutable u8&, buffer_size: usize, result: mutable DarwinPasswdRecord&?&) -> i32 can[Blocking.IO]

        @link_name(getgroups)
        extern bash_lookup_getgroups(count: i32, groups: mutable u32&?) -> i32 can[Blocking.IO]


        def copy_passwd_home_bytes(home_pointer: u8&?, buffer: darray[u8]&) -> darray[u8] error[ObservationError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return [] if home_pointer == null
            home: u8& = home_pointer

            # POSIX *_r results point into the supplied buffer. Locate the
            # borrowed string by pointer identity first, then copy only within
            # that allocation; never scan an unbounded libc pointer.
            start: mutable usize = buffer.count
            for index in 0..<buffer.count |buffer, start|:
                element_pointer: u8& = (&buffer[index]).cast[u8&]
                if element_pointer == home:
                    start <- index
                    break
            raise ObservationError.PasswordHomePointerOutsideBuffer if start == buffer.count

            owned: mutable darray[u8] = []
            for index in start..<buffer.count |buffer, owned|:
                byte: u8 = buffer[index]
                return owned if byte == 0u8
                raise ObservationError.PasswordHomeLimitExceeded if owned.count >= EsBashExecLookup::Limits::PATH_BYTES
                owned.push(byte)
            raise ObservationError.PasswordHomeStringUnterminated


        def zeroed_passwd_buffer() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            buffer: mutable darray[u8] = []
            buffer.reserve(Limits::PASSWD_BUFFER_BYTES)
            for _ in 0..<Limits::PASSWD_BUFFER_BYTES |buffer|:
                buffer.push(0u8)
            return buffer


        def current_account_home_directory() -> darray[u8] error[ObservationError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            record: mutable DarwinPasswdRecord = zeroed
            buffer: mutable darray[u8] = zeroed_passwd_buffer()
            result: mutable DarwinPasswdRecord&? = null
            result_pointer: mutable DarwinPasswdRecord&?& = (&result).cast[mutable DarwinPasswdRecord&?&]
            buffer_pointer: mutable u8& = (&buffer[0]).cast[mutable u8&]
            status: i32 = bash_lookup_getpwuid(bash_lookup_real_user(), record, buffer_pointer, buffer.count, result_pointer)
            raise ObservationError.PasswordDatabaseLookupUnavailable if status != 0
            return [] if result == null
            return try copy_passwd_home_bytes(record.home_directory, buffer)


        def named_user_home_lookup(username: sview) -> EsBashExecLookup::NamedUserHomeLookup error[ObservationError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            username_length: usize = sview_len(username)
            owned_name: mutable darray[u8] = []
            if username_length > Limits::PASSWD_USERNAME_BYTES:
                return EsBashExecLookup::NamedUserHomeLookup{username: try copy_environment_bytes(username), state: EsBashExecLookup::NamedUserHomeState.LookupUnavailable}
            owned_name.reserve(username_length + 1)
            for index in 0..<username_length |username, owned_name|:
                owned_name.push(sview_at(username, index))
            owned_name.push(0u8)

            record: mutable DarwinPasswdRecord = zeroed
            buffer: mutable darray[u8] = zeroed_passwd_buffer()
            result: mutable DarwinPasswdRecord&? = null
            result_pointer: mutable DarwinPasswdRecord&?& = (&result).cast[mutable DarwinPasswdRecord&?&]
            username_pointer: cstr = (&owned_name[0]).cast[cstr]
            buffer_pointer: mutable u8& = (&buffer[0]).cast[mutable u8&]
            status: i32 = bash_lookup_getpwnam(username_pointer, record, buffer_pointer, buffer.count, result_pointer)
            if status != 0:
                return EsBashExecLookup::NamedUserHomeLookup{username: try copy_environment_bytes(username), state: EsBashExecLookup::NamedUserHomeState.LookupUnavailable}
            if result == null:
                return EsBashExecLookup::NamedUserHomeLookup{username: try copy_environment_bytes(username), state: EsBashExecLookup::NamedUserHomeState.UserNotFound}
            home: darray[u8] = try copy_passwd_home_bytes(record.home_directory, buffer)
            return EsBashExecLookup::NamedUserHomeLookup{username: try copy_environment_bytes(username), state: EsBashExecLookup::NamedUserHomeState.HomeFound, home_directory: home}


        def resolve_path_directory_with_named_user_lookup(directory: sview, tilde: mutable EsBashExecLookup::PathTildeContext&) -> darray[u8] error[EsBashExecLookup::LookupError, ObservationError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            catch EsBashExecLookup::resolve_path_directory(directory, tilde):
                ok resolved:
                    return resolved
                error failure:
                    raise failure if failure != EsBashExecLookup::LookupError.TildeExpansionUnsupported

            directory_length: usize = sview_len(directory)
            prefix_end: mutable usize = 1
            while prefix_end < directory_length and sview_at(directory, prefix_end) != 47u8 |directory, prefix_end|:
                prefix_end <- prefix_end + 1
            username: sview = string_view_slice(directory, 1, prefix_end.i64())
            lookup: EsBashExecLookup::NamedUserHomeLookup = try named_user_home_lookup(username)
            tilde.named_user_homes.push(lookup)
            return try EsBashExecLookup::resolve_path_directory(directory, tilde)


    public:
        # Read one exported tilde variable at a time. Callers should do this
        # only for a reached PATH component so unused values cannot block an
        # earlier executable. The host must exclude concurrent environment
        # mutation for each individual lookup/copy.
        def process_tilde_environment_value(variable: TildeEnvironmentVariable) -> TildeEnvironmentSnapshot error[EsEnvironmentLookup::LookupError, ObservationError] can[Environment.Read, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            name: mutable sview = "HOME"
            if variable == TildeEnvironmentVariable::WorkingDirectory:
                name <- "PWD"
            else if variable == TildeEnvironmentVariable::PreviousWorkingDirectory:
                name <- "OLDPWD"
            else:
                raise ObservationError.InvalidTildeEnvironmentVariable if variable != TildeEnvironmentVariable::Home
            value: EsEnvironmentLookup::Value = try EsEnvironmentLookup::lookup(name)
            return TildeEnvironmentSnapshot{present: value.present, bytes: try copy_environment_bytes(value.bytes)}


        # Resolve one already-reached PATH component. Load only the selected
        # environment variable, and consult the account database only when
        # HOME is absent or a named-user fallback is actually reached.
        def resolve_reached_path_directory_from_process_environment(directory: sview, tilde: mutable EsBashExecLookup::PathTildeContext&) -> darray[u8] error[EsBashExecLookup::LookupError, EsEnvironmentLookup::LookupError, ObservationError] can[Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            directory_length: usize = sview_len(directory)
            raise EsBashExecLookup::LookupError.PathLimitExceeded if directory_length > EsBashExecLookup::Limits::PATH_BYTES
            raise EsBashExecLookup::LookupError.SearchInputContainsNul if sview_contains_byte(directory, 0u8)
            need: ReachedTildeEnvironmentNeed = reached_tilde_environment_need(directory, tilde)
            if need == ReachedTildeEnvironmentNeed::Home:
                snapshot: TildeEnvironmentSnapshot = try process_tilde_environment_value(TildeEnvironmentVariable::Home)
                tilde.home_present <- snapshot.present
                tilde.home_directory <- snapshot.bytes
                if not snapshot.present and not tilde.account_home_present:
                    tilde.account_home_directory <- try current_account_home_directory()
                    tilde.account_home_present <- true
            else if need == ReachedTildeEnvironmentNeed::WorkingDirectory:
                snapshot: TildeEnvironmentSnapshot = try process_tilde_environment_value(TildeEnvironmentVariable::WorkingDirectory)
                tilde.pwd_present <- snapshot.present
                tilde.pwd_directory <- snapshot.bytes
            else if need == ReachedTildeEnvironmentNeed::PreviousWorkingDirectory:
                snapshot: TildeEnvironmentSnapshot = try process_tilde_environment_value(TildeEnvironmentVariable::PreviousWorkingDirectory)
                tilde.oldpwd_present <- snapshot.present
                tilde.oldpwd_directory <- snapshot.bytes
            return try resolve_path_directory_with_named_user_lookup(directory, tilde)


        # Capture the ids Bash 3.2 uses around group membership plus the
        # supplementary list returned by getgroups(2). Bash falls back to
        # real/effective GIDs when getgroups fails; preserve that behavior with
        # an empty list, while rejecting impossible ABI counts explicitly.
        # Callers must keep process credentials stable during this snapshot.
        def current_credentials() -> EsBashExecLookup::CredentialSnapshot error[ObservationError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            effective_user: u32 = bash_lookup_effective_user()
            real_group: u32 = bash_lookup_real_group()
            effective_group: u32 = bash_lookup_effective_group()
            group_count: i32 = bash_lookup_getgroups(0, null)
            supplementary: mutable darray[u32] = []

            if group_count > 0:
                raise ObservationError.CredentialGroupLimitExceeded if group_count.usize() > Limits::SUPPLEMENTARY_GROUPS
                supplementary.reserve(group_count.usize())
                for _ in 0..<group_count.usize() |supplementary|:
                    supplementary.push(0u32)
                supplementary_pointer: mutable u32& = (&supplementary[0]).cast[mutable u32&]
                observed_count: i32 = bash_lookup_getgroups(group_count, supplementary_pointer)
                raise ObservationError.CredentialGroupObservationInvalid if observed_count > group_count
                supplementary.truncate(observed_count.usize()) if observed_count >= 0
                supplementary.truncate(0) if observed_count < 0

            return EsBashExecLookup::CredentialSnapshot{effective_user: effective_user, real_group: real_group, effective_group: effective_group, supplementary_groups: supplementary}


        # Bash 3.2 file_status follows symlinks with stat(), treats every
        # stat failure as absent, and treats directories as present but not
        # executable. For all other file kinds, its non-AFS executable bit
        # decision is delegated to the pure mode/credential model.
        def observe_candidate(path: sview, credentials: EsBashExecLookup::CredentialSnapshot) -> EsBashExecLookup::PathCandidate error[ObservationError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            path_length: usize = sview_len(path)
            raise ObservationError.CandidatePathLimitExceeded if path_length > Limits::CANDIDATE_PATH_BYTES
            raise ObservationError.CandidatePathContainsNul if sview_contains_byte(path, 0u8)

            native_path: mutable darray[u8] = []
            native_path.reserve(path_length + 1)
            for index in 0..<path_length |path, native_path|:
                native_path.push(sview_at(path, index))
            native_path.push(0u8)

            information: mutable ElisascriptStat = zeroed
            path_pointer: cstr = (&native_path[0]).cast[cstr]
            return EsBashExecLookup::PathCandidate{} if elisascript_posix_stat(path_pointer, information) < 0

            is_directory: bool = (information.mode & DarwinStatMode::MASK) == DarwinStatMode::DIRECTORY
            executable: bool = false
            if not is_directory:
                executable <- EsBashExecLookup::mode_allows_execution(information.mode, information.user, information.group, credentials)
            return EsBashExecLookup::PathCandidate{exists: true, executable: executable, directory: is_directory}


        # Observe one validated plan, retaining exact path spellings and
        # stat-derived facts. A slashless command with empty PATH is returned
        # literally without a stat, as Bash does. Other direct-name mode
        # observes the command once without PATH candidate preference.
        # This explicit-snapshot variant uses caller-supplied HOME,
        # account-home, PWD, OLDPWD, indexed-stack and named-user results; it
        # does not query the passwd database. The process-environment variant
        # below performs bounded lazy passwd lookups where required.
        # Unsupported or unavailable forms fail when reached, before stat;
        # a confirmed missing account keeps Bash's unchanged spelling.
        def observe_search_plan(plan: EsBashExecLookup::PathSearchPlan&, command: sview, credentials: EsBashExecLookup::CredentialSnapshot, tilde: EsBashExecLookup::PathTildeContext&) -> SearchObservation error[EsBashExecLookup::LookupError, ObservationError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            try EsBashExecLookup::validate_path_search_plan(plan, command)
            command_length: usize = sview_len(command)
            result: mutable SearchObservation = SearchObservation{mode: plan.mode, path_selection_available: plan.mode == EsBashExecLookup::SearchMode::PathDirectories}

            if plan.mode == EsBashExecLookup::SearchMode::DirectName:
                command_has_slash: mutable bool = false
                for index in 0..<command_length |command, command_has_slash|:
                    command_has_slash <- true if sview_at(command, index) == 47u8
                if plan.path_bytes.count == 0 and not command_has_slash:
                    result.unsearched_name.reserve(command_length)
                    for index in 0..<command_length |command, result|:
                        result.unsearched_name.push(sview_at(command, index))
                    result.unsearched_name_returned <- true
                    return result

                path_bytes: mutable darray[u8] = []
                path_bytes.reserve(command_length)
                for index in 0..<command_length |command, path_bytes|:
                    path_bytes.push(sview_at(command, index))
                observation: EsBashExecLookup::PathCandidate = try observe_candidate(bytes_view(path_bytes), credentials)
                result.candidates.push(ObservedPathCandidate{path: path_bytes, observation: observation})
                return result

            for index in 0..<plan.directories.count |plan|:
                _ = try EsBashExecLookup::path_directory_spelling(plan, index)

            facts: mutable darray[EsBashExecLookup::PathCandidate] = []
            result.candidates.reserve(plan.directories.count)
            facts.reserve(plan.directories.count)
            for index in 0..<plan.directories.count |plan, result, facts|:
                directory: sview = try EsBashExecLookup::path_directory_spelling(plan, index)
                resolved_directory: mutable darray[u8] = []
                directory_for_join: mutable sview = directory
                if plan.directories[index].tilde_expansion_candidate:
                    resolved_directory <- try EsBashExecLookup::resolve_path_directory(directory, tilde)
                    directory_for_join <- bytes_view(resolved_directory)
                path_bytes: darray[u8] = try EsBashExecLookup::join_search_candidate(directory_for_join, command)
                observation: EsBashExecLookup::PathCandidate = try observe_candidate(bytes_view(path_bytes), credentials)
                facts.push(observation)
                result.candidates.push(ObservedPathCandidate{path: path_bytes, observation: observation})
                # Bash's find_user_command_in_path returns the first executable
                # candidate immediately. Do not stat later PATH components.
                if observation.executable:
                    selection: EsBashExecLookup::Selection = try EsBashExecLookup::select_path_candidate(facts)
                    if selection.kind == EsBashExecLookup::SelectionKind.Executable:
                        result.selection <- selection
                        return result
            result.selection <- try EsBashExecLookup::select_path_candidate(facts)
            return result


        # Turn a checked Bash lookup observation into the exact path to hand to
        # a direct process launch. This avoids asking libc execvp to repeat a
        # PATH search with potentially different empty-component semantics.
        # NotFound remains unavailable so the caller can preserve its existing
        # launch/error path until parent-side exec receipts are wired.
        def invocation_path_from_observation(observation: SearchObservation) -> InvocationPath error[ObservationError, EsBashExecLookup::LookupError] can[Memory.Allocate, Abort.Panic]:
            if observation.mode == EsBashExecLookup::SearchMode.DirectName:
                raise ObservationError.InvalidInvocationPathObservation if observation.path_selection_available
                raise ObservationError.InvalidInvocationPathObservation if observation.unsearched_name_returned and observation.candidates.count != 0
                if observation.unsearched_name_returned:
                    name: sview = bytes_view(observation.unsearched_name)
                    raise ObservationError.InvalidInvocationPathObservation if sview_len(name) > EsBashExecLookup::Limits::COMMAND_BYTES
                    raise ObservationError.InvalidInvocationPathObservation if name == "" or sview_contains_byte(name, 0u8)
                    return InvocationPath{available: true, bytes: try copy_environment_bytes(name)}
                return InvocationPath{} if observation.candidates.count == 0
                raise ObservationError.InvalidInvocationPathObservation if observation.candidates.count != 1
                candidate: ObservedPathCandidate = observation.candidates[0]
                candidate_path: sview = bytes_view(candidate.path)
                raise ObservationError.InvalidInvocationPathObservation if sview_len(candidate_path) > EsBashExecLookup::Limits::CANDIDATE_PATH_BYTES
                raise ObservationError.InvalidInvocationPathObservation if candidate_path == "" or sview_contains_byte(candidate_path, 0u8)
                return InvocationPath{available: true, bytes: try copy_environment_bytes(candidate_path)}

            raise ObservationError.InvalidInvocationPathObservation if observation.mode != EsBashExecLookup::SearchMode.PathDirectories or not observation.path_selection_available or observation.unsearched_name_returned
            raise ObservationError.InvalidInvocationPathObservation if observation.candidates.count > EsBashExecLookup::Limits::PATH_ENTRIES
            facts: mutable darray[EsBashExecLookup::PathCandidate] = []
            for candidate in observation.candidates |facts|:
                candidate_path: sview = bytes_view(candidate.path)
                raise ObservationError.InvalidInvocationPathObservation if sview_len(candidate_path) > EsBashExecLookup::Limits::CANDIDATE_PATH_BYTES
                raise ObservationError.InvalidInvocationPathObservation if candidate_path == "" or sview_contains_byte(candidate_path, 0u8)
                facts.push(candidate.observation)
            expected: EsBashExecLookup::Selection = try EsBashExecLookup::select_path_candidate(facts)
            raise ObservationError.InvalidInvocationPathObservation if expected.kind != observation.selection.kind or expected.index != observation.selection.index
            return InvocationPath{} if expected.kind == EsBashExecLookup::SelectionKind.NotFound
            raise ObservationError.InvalidInvocationPathObservation if expected.kind != EsBashExecLookup::SelectionKind.Executable and expected.kind != EsBashExecLookup::SelectionKind.NonExecutableFallback
            raise ObservationError.InvalidInvocationPathObservation if expected.index >= observation.candidates.count
            selected: ObservedPathCandidate = observation.candidates[expected.index]
            raise ObservationError.InvalidInvocationPathObservation if not selected.observation.exists or selected.observation.directory
            raise ObservationError.InvalidInvocationPathObservation if expected.kind == EsBashExecLookup::SelectionKind.Executable and not selected.observation.executable
            raise ObservationError.InvalidInvocationPathObservation if expected.kind == EsBashExecLookup::SelectionKind.NonExecutableFallback and selected.observation.executable
            selected_path: sview = bytes_view(selected.path)
            raise ObservationError.InvalidInvocationPathObservation if sview_len(selected_path) > EsBashExecLookup::Limits::CANDIDATE_PATH_BYTES
            raise ObservationError.InvalidInvocationPathObservation if selected_path == "" or sview_contains_byte(selected_path, 0u8)
            return InvocationPath{available: true, bytes: try copy_environment_bytes(selected_path)}


        # Process-environment variant of the ordered PATH observer. It uses
        # the reached-directory resolver for each tilde component, so neither
        # an unused environment value nor a suffix after an executable is read.
        # Directory-stack entries remain explicit because they are shell state.
        def observe_search_plan_with_process_environment(plan: EsBashExecLookup::PathSearchPlan&, command: sview, credentials: EsBashExecLookup::CredentialSnapshot, tilde: mutable EsBashExecLookup::PathTildeContext&) -> SearchObservation error[EsBashExecLookup::LookupError, ObservationError, EsEnvironmentLookup::LookupError] can[Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            try EsBashExecLookup::validate_path_search_plan(plan, command)
            return try observe_search_plan(plan, command, credentials, tilde) if plan.mode == EsBashExecLookup::SearchMode.DirectName

            for index in 0..<plan.directories.count |plan|:
                _ = try EsBashExecLookup::path_directory_spelling(plan, index)

            facts: mutable darray[EsBashExecLookup::PathCandidate] = []
            result: mutable SearchObservation = SearchObservation{mode: plan.mode, path_selection_available: true}
            result.candidates.reserve(plan.directories.count)
            facts.reserve(plan.directories.count)
            for index in 0..<plan.directories.count |plan, result, facts|:
                directory: sview = try EsBashExecLookup::path_directory_spelling(plan, index)
                resolved_directory: mutable darray[u8] = []
                directory_for_join: mutable sview = directory
                if plan.directories[index].tilde_expansion_candidate:
                    resolved_directory <- try resolve_reached_path_directory_from_process_environment(directory, tilde)
                    directory_for_join <- bytes_view(resolved_directory)
                path_bytes: darray[u8] = try EsBashExecLookup::join_search_candidate(directory_for_join, command)
                observation: EsBashExecLookup::PathCandidate = try observe_candidate(bytes_view(path_bytes), credentials)
                facts.push(observation)
                result.candidates.push(ObservedPathCandidate{path: path_bytes, observation: observation})
                if observation.executable:
                    selection: EsBashExecLookup::Selection = try EsBashExecLookup::select_path_candidate(facts)
                    if selection.kind == EsBashExecLookup::SelectionKind.Executable:
                        result.selection <- selection
                        return result
            result.selection <- try EsBashExecLookup::select_path_candidate(facts)
            return result
