# Bounded incremental hash/checksum contract for artifacts and archives.
#
# Host adapters perform the algorithm; this model ensures the selected
# algorithm, input accounting, chunk limits, and one-shot digest publication
# cannot be silently changed or exceeded.

module EsHash:
    public:
        const module Limits:
            INPUT_BYTES: usize = 1099511627776
            CHUNK_BYTES: usize = 67108864
            CHUNKS: usize = 1048576


        const enum HashAlgorithm of u8:
            Sha256
            Sha512
            Fnv1a64


        const enum HashState of u8:
            Planned
            Active
            Finalized
            Failed


        const enum HashEvent of u8:
            Begin
            Update
            Finalize
            Fail


        struct HashPolicy:
            algorithm: HashAlgorithm = HashAlgorithm.Sha256
            max_input_bytes: usize = Limits::INPUT_BYTES
            max_chunk_bytes: usize = Limits::CHUNK_BYTES
            max_chunks: usize = Limits::CHUNKS


        struct HashDigest:
            algorithm: HashAlgorithm
            word_count: usize
            word0: u64 = 0
            word1: u64 = 0
            word2: u64 = 0
            word3: u64 = 0
            word4: u64 = 0
            word5: u64 = 0
            word6: u64 = 0
            word7: u64 = 0


        struct HashContext:
            policy: HashPolicy
            state: mutable HashState = HashState.Planned
            bytes_seen: mutable usize = 0
            chunks_seen: mutable usize = 0
            digest: mutable HashDigest = HashDigest{algorithm: HashAlgorithm.Sha256, word_count: 0}


        error HashError:
            InvalidPolicy
            InvalidAlgorithm
            InvalidState
            InvalidEvent
            InvalidChunk
            ChunkLimitExceeded
            InputLimitExceeded
            DigestShapeInvalid
            DigestAlgorithmMismatch
            DigestAlreadyPublished
            AccountingInvalid
            InvalidTransition


    private:
        const module HashArithmetic:
            LOW_WORD_MASK: u64 = 4294967295u64
            U64_MAX: u64 = 18446744073709551615u64


        # Return the low 64 bits of a product without overflowing checked
        # Elisa arithmetic. Products of two low 32-bit limbs fit in u64; only
        # the low 32 bits of cross terms contribute to the result's high word.
        def hash_multiply_low64(left: u64, right: u64) -> u64:
            left_low: u64 = left & HashArithmetic::LOW_WORD_MASK
            left_high: u64 = left >> 32
            right_low: u64 = right & HashArithmetic::LOW_WORD_MASK
            right_high: u64 = right >> 32
            low_product: u64 = left_low * right_low
            cross_low: u64 = ((left_low * right_high) & HashArithmetic::LOW_WORD_MASK) + ((left_high * right_low) & HashArithmetic::LOW_WORD_MASK)
            high_word: u64 = ((low_product >> 32) + cross_low) & HashArithmetic::LOW_WORD_MASK
            return (high_word << 32) | (low_product & HashArithmetic::LOW_WORD_MASK)


        def hash_add_wrapping(left: u64, right: u64) -> u64:
            distance_to_max: u64 = HashArithmetic::U64_MAX - right
            if left > distance_to_max:
                return left - distance_to_max - 1u64
            return left + right


        def hash_algorithm_valid(algorithm: HashAlgorithm) -> bool:
            return algorithm in {HashAlgorithm.Sha256, HashAlgorithm.Sha512, HashAlgorithm.Fnv1a64}


        def hash_state_valid(state: HashState) -> bool:
            return state in {HashState.Planned, HashState.Active, HashState.Finalized, HashState.Failed}


        def hash_event_valid(event: HashEvent) -> bool:
            return event in {HashEvent.Begin, HashEvent.Update, HashEvent.Finalize, HashEvent.Fail}


        def hash_word_count(algorithm: HashAlgorithm) -> usize:
            return 1 if algorithm == HashAlgorithm.Fnv1a64 else 4 if algorithm == HashAlgorithm.Sha256 else 8


        def hash_policy_valid(policy: HashPolicy) -> bool:
            return hash_algorithm_valid(policy.algorithm) and policy.max_input_bytes != 0 and policy.max_input_bytes <= Limits::INPUT_BYTES and policy.max_chunk_bytes != 0 and policy.max_chunk_bytes <= Limits::CHUNK_BYTES and policy.max_chunks != 0 and policy.max_chunks <= Limits::CHUNKS


        def hash_digest_shape_valid(digest: HashDigest) -> bool:
            return hash_algorithm_valid(digest.algorithm) and digest.word_count == hash_word_count(digest.algorithm) and (digest.algorithm == HashAlgorithm.Fnv1a64 and digest.word1 == 0 and digest.word2 == 0 and digest.word3 == 0 and digest.word4 == 0 and digest.word5 == 0 and digest.word6 == 0 and digest.word7 == 0 or digest.algorithm == HashAlgorithm.Sha256 and digest.word4 == 0 and digest.word5 == 0 and digest.word6 == 0 and digest.word7 == 0 or digest.algorithm == HashAlgorithm.Sha512)


        def hash_digest_unpublished_valid(digest: HashDigest) -> bool:
            return digest.word_count == 0 and digest.word0 == 0 and digest.word1 == 0 and digest.word2 == 0 and digest.word3 == 0 and digest.word4 == 0 and digest.word5 == 0 and digest.word6 == 0 and digest.word7 == 0


    public:
        # Hash construction needs modulo arithmetic even though normal Elisa
        # integer operators intentionally report overflow.
        def hash_wrapping_multiply_u64(left: u64, right: u64) -> u64:
            return hash_multiply_low64(left, right)


        def hash_wrapping_add_u64(left: u64, right: u64) -> u64:
            return hash_add_wrapping(left, right)


        def validate_hash_context(context: HashContext) -> bool error[HashError]:
            raise HashError.InvalidPolicy if not hash_policy_valid(context.policy)
            raise HashError.InvalidState if not hash_state_valid(context.state)
            raise HashError.ChunkLimitExceeded if context.chunks_seen > context.policy.max_chunks
            raise HashError.InputLimitExceeded if context.bytes_seen > context.policy.max_input_bytes
            raise HashError.AccountingInvalid if context.chunks_seen == 0 and context.bytes_seen != 0
            raise HashError.AccountingInvalid if context.chunks_seen != 0 and context.bytes_seen == 0
            raise HashError.AccountingInvalid if context.state == HashState.Planned and (context.bytes_seen != 0 or context.chunks_seen != 0)
            if context.state == HashState.Finalized:
                raise HashError.DigestShapeInvalid if not hash_digest_shape_valid(context.digest)
                raise HashError.DigestAlgorithmMismatch if context.digest.algorithm != context.policy.algorithm
            else:
                raise HashError.DigestAlreadyPublished if not hash_digest_unpublished_valid(context.digest)
            return true


        def advance_hash(context: mutable HashContext&, event: HashEvent, chunk_bytes: usize = 0, digest: HashDigest = HashDigest{algorithm: HashAlgorithm.Sha256, word_count: 0}) -> HashState error[HashError]:
            try validate_hash_context(HashContext{policy: context.policy, state: context.state, bytes_seen: context.bytes_seen, chunks_seen: context.chunks_seen, digest: context.digest})
            raise HashError.InvalidEvent if not hash_event_valid(event)
            if event == HashEvent.Begin:
                raise HashError.InvalidTransition if context.state != HashState.Planned
                context.state <- HashState.Active
            elif event == HashEvent.Update:
                raise HashError.InvalidTransition if context.state != HashState.Active
                raise HashError.InvalidChunk if chunk_bytes == 0 or chunk_bytes > context.policy.max_chunk_bytes
                raise HashError.ChunkLimitExceeded if context.chunks_seen >= context.policy.max_chunks
                raise HashError.InputLimitExceeded if chunk_bytes > context.policy.max_input_bytes - context.bytes_seen
                context.chunks_seen <- context.chunks_seen + 1
                context.bytes_seen <- context.bytes_seen + chunk_bytes
            elif event == HashEvent.Finalize:
                raise HashError.InvalidTransition if context.state != HashState.Active
                raise HashError.DigestShapeInvalid if not hash_digest_shape_valid(digest)
                raise HashError.DigestAlgorithmMismatch if digest.algorithm != context.policy.algorithm
                context.digest <- digest
                context.state <- HashState.Finalized
            elif event == HashEvent.Fail:
                raise HashError.InvalidTransition if context.state == HashState.Finalized or context.state == HashState.Failed
                context.state <- HashState.Failed
            return context.state
