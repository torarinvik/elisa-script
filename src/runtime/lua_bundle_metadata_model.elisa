# Typed argument contract for the Lua bundle metadata generator.
#
# The host-facing writer is deliberately layered on top of this pure parser.
# It owns no process, clock, Git, or filesystem effects; callers can therefore
# differential-test option semantics before a destination is touched.

module EsLuaBundleMetadata:
    using EsProcess

    public:
        const module Limits:
            ARGUMENT_BYTES: usize = 65536
            HOST_OUTPUT_BYTES: usize = 65536
            HOST_TIMEOUT_MICROS: u64 = 5000000
            PATH_BYTES: usize = 4096
            ENTRIES: usize = 4096


        const module Options:
            OUTPUT: sview = "--output"
            BUNDLE_TYPE: sview = "--bundle-type"
            REPO_ROOT: sview = "--repo-root"
            OUT_DIR: sview = "--out-dir"
            SETTING: sview = "--setting"
            COMMAND: sview = "--command"


        struct MetadataAssignment:
            key: sview
            value: sview


        struct MetadataArguments:
            output: sview = ""
            bundle_type: sview = ""
            repo_root: sview = ""
            out_dir: sview = ""
            has_output: bool = false
            has_bundle_type: bool = false
            has_repo_root: bool = false
            has_out_dir: bool = false
            settings: darray[MetadataAssignment] = []
            commands: darray[MetadataAssignment] = []


        struct MetadataFacts:
            generated_at_utc: sview
            git_head: sview = "unknown"
            git_branch: sview = "unknown"
            git_status: sview = "unknown"
            hostname: sview = "unknown"
            uname: sview = "unknown"


        struct MetadataProcessResults:
            hostname: ProcessResult = ProcessResult{}
            uname: ProcessResult = ProcessResult{}
            git_head: ProcessResult = ProcessResult{}
            git_branch: ProcessResult = ProcessResult{}
            git_status: ProcessResult = ProcessResult{}


        const enum MetadataHostCommandKind of u8:
            Hostname
            Uname
            GitHead
            GitBranch
            GitStatus


        error MetadataArgumentsError:
            ArgumentTooLarge
            MissingOptionValue
            UnknownOption
            AmbiguousOption
            UnexpectedPositional
            MissingRequiredOption
            InvalidAssignment
            EmptyAssignmentKey
            EntryLimitExceeded
            PathTooLong


        error MetadataJsonError:
            InvalidArguments
            InvalidFacts
            InvalidLimit
            InvalidUtf8
            OutputLimitExceeded


        error MetadataCommandError:
            InvalidKind
            InvalidRepoRoot
            InvalidCommand


    private:
        const enum MetadataOptionKind of u8:
            Unknown
            Ambiguous
            Output
            BundleType
            RepoRoot
            OutDir
            Setting
            Command


        const module Json:
            HEX: sview = "0123456789abcdef"
            MAX_BYTES: usize = 67108864


        struct MetadataObservedText:
            available: bool = false
            value: sview = ""


        def metadata_host_command_kind_valid(kind: MetadataHostCommandKind) -> bool:
            return kind in {MetadataHostCommandKind.Hostname, MetadataHostCommandKind.Uname, MetadataHostCommandKind.GitHead, MetadataHostCommandKind.GitBranch, MetadataHostCommandKind.GitStatus}


        def metadata_option_matches(spelling: sview, candidate: sview) -> bool:
            return false if len(spelling) == 0 or len(spelling) > len(candidate)
            return candidate[0:len(spelling)] == spelling


        def metadata_option_kind(spelling: sview) -> MetadataOptionKind:
            matches: mutable usize = 0
            selected: mutable MetadataOptionKind = MetadataOptionKind.Unknown
            if metadata_option_matches(spelling, Options::OUTPUT):
                matches <- matches + 1
                selected <- MetadataOptionKind.Output
            if metadata_option_matches(spelling, Options::BUNDLE_TYPE):
                matches <- matches + 1
                selected <- MetadataOptionKind.BundleType
            if metadata_option_matches(spelling, Options::REPO_ROOT):
                matches <- matches + 1
                selected <- MetadataOptionKind.RepoRoot
            if metadata_option_matches(spelling, Options::OUT_DIR):
                matches <- matches + 1
                selected <- MetadataOptionKind.OutDir
            if metadata_option_matches(spelling, Options::SETTING):
                matches <- matches + 1
                selected <- MetadataOptionKind.Setting
            if metadata_option_matches(spelling, Options::COMMAND):
                matches <- matches + 1
                selected <- MetadataOptionKind.Command
            return MetadataOptionKind.Unknown if matches == 0
            return MetadataOptionKind.Ambiguous if matches > 1
            return selected


        def metadata_ascii_digit(byte: u8) -> bool:
            return byte >= 48u8 and byte <= 57u8


        # Match argparse's negative-number exception exactly. A separated
        # option value is accepted only when it is `-digits` or `-digits*.`
        # followed by at least one digit; lookalikes such as `-1abc` and
        # `-1e3` remain option syntax, while `-.5` is a valid negative number.
        def metadata_value_looks_like_option(value: sview) -> bool:
            return false if len(value) < 2 or sview_at(value, 0) != 45u8
            cursor: mutable usize = 1
            digits_before_dot: mutable usize = 0
            while cursor < len(value) and metadata_ascii_digit(sview_at(value, cursor)):
                cursor <- cursor + 1
                digits_before_dot <- digits_before_dot + 1
            return false if cursor == len(value) and digits_before_dot != 0
            if cursor < len(value) and sview_at(value, cursor) == 46u8:
                cursor <- cursor + 1
                digits_after_dot: mutable usize = 0
                while cursor < len(value) and metadata_ascii_digit(sview_at(value, cursor)):
                    cursor <- cursor + 1
                    digits_after_dot <- digits_after_dot + 1
                return false if cursor == len(value) and digits_after_dot != 0
            return true


        def metadata_append_assignment(entries: mutable darray[MetadataAssignment]&, value: sview) -> void error[MetadataArgumentsError]:
            raise MetadataArgumentsError.EntryLimitExceeded if entries.count >= Limits::ENTRIES
            separator: i64 = value.index("=")
            raise MetadataArgumentsError.InvalidAssignment if separator < 0
            raise MetadataArgumentsError.EmptyAssignmentKey if separator == 0
            entries.push(MetadataAssignment{key: value[0:separator], value: value[separator + 1:len(value)]})


        def metadata_assignment_value(entries: darray[MetadataAssignment], key: sview) -> sview:
            index: mutable usize = entries.count
            while index > 0:
                index <- index - 1
                return entries[index].value if entries[index].key == key
            return ""


        def metadata_assignment_present(entries: darray[MetadataAssignment], key: sview) -> bool:
            index: mutable usize = entries.count
            while index > 0:
                index <- index - 1
                return true if entries[index].key == key
            return false


        def metadata_assignment_less(left: MetadataAssignment, right: MetadataAssignment) -> bool:
            common: usize = len(left.key) if len(left.key) < len(right.key) else len(right.key)
            for index in 0..<common |left, right|:
                return true if sview_at(left.key, index) < sview_at(right.key, index)
                return false if sview_at(left.key, index) > sview_at(right.key, index)
            return len(left.key) < len(right.key)


        def metadata_final_assignments(entries: darray[MetadataAssignment]) -> darray[MetadataAssignment] can[Memory.Allocate, Abort.Panic]:
            result: mutable darray[MetadataAssignment] = []
            for entry in entries |result|:
                found: mutable bool = false
                for index in 0..<result.count |result, entry, found|:
                    if result[index].key == entry.key:
                        result[index].value <- entry.value
                        found <- true
                        break
                result.push(entry) if not found
            if result.count > 1:
                for index in 1..<result.count |result|:
                    current: MetadataAssignment = result[index]
                    cursor: mutable usize = index
                    while cursor > 0 and metadata_assignment_less(current, result[cursor - 1]) |cursor, current, result|:
                        result[cursor] <- result[cursor - 1]
                        cursor <- cursor - 1
                    result[cursor] <- current
            return result


        def metadata_arguments_shape_valid(arguments: MetadataArguments) -> bool:
            return false if not arguments.has_output or not arguments.has_bundle_type or not arguments.has_repo_root or not arguments.has_out_dir
            return false if len(arguments.output) > Limits::PATH_BYTES or len(arguments.bundle_type) > Limits::ARGUMENT_BYTES or len(arguments.repo_root) > Limits::PATH_BYTES or len(arguments.out_dir) > Limits::PATH_BYTES
            return false if arguments.settings.count > Limits::ENTRIES or arguments.commands.count > Limits::ENTRIES
            for entry in arguments.settings:
                return false if len(entry.key) == 0 or len(entry.key) > Limits::ARGUMENT_BYTES or len(entry.value) > Limits::ARGUMENT_BYTES
            for entry in arguments.commands:
                return false if len(entry.key) == 0 or len(entry.key) > Limits::ARGUMENT_BYTES or len(entry.value) > Limits::ARGUMENT_BYTES
            return true


        def metadata_facts_valid(facts: MetadataFacts) -> bool:
            return false if len(facts.generated_at_utc) != 20
            for index in 0..<20 |facts|:
                if index == 4 or index == 7:
                    return false if sview_at(facts.generated_at_utc, index) != 45u8
                elif index == 10:
                    return false if sview_at(facts.generated_at_utc, index) != 84u8
                elif index == 13 or index == 16:
                    return false if sview_at(facts.generated_at_utc, index) != 58u8
                elif index == 19:
                    return false if sview_at(facts.generated_at_utc, index) != 90u8
                else:
                    return false if sview_at(facts.generated_at_utc, index) < 48u8 or sview_at(facts.generated_at_utc, index) > 57u8
            return false if len(facts.generated_at_utc) > Limits::ARGUMENT_BYTES or len(facts.git_head) > Limits::ARGUMENT_BYTES or len(facts.git_branch) > Limits::ARGUMENT_BYTES or len(facts.git_status) > Limits::ARGUMENT_BYTES or len(facts.hostname) > Limits::ARGUMENT_BYTES or len(facts.uname) > Limits::ARGUMENT_BYTES
            return true


        def metadata_unicode_whitespace(codepoint: u32) -> bool:
            return true if codepoint >= 9u32 and codepoint <= 13u32
            return true if codepoint >= 28u32 and codepoint <= 32u32
            return true if codepoint == 133u32 or codepoint == 160u32 or codepoint == 5760u32
            return true if codepoint >= 8192u32 and codepoint <= 8202u32
            return true if codepoint == 8232u32 or codepoint == 8233u32 or codepoint == 8239u32 or codepoint == 8287u32 or codepoint == 12288u32
            return false


        def metadata_trim_process_text(value: sview) -> sview error[MetadataJsonError]:
            cursor: mutable usize = 0
            start: mutable usize = 0
            end: mutable usize = 0
            found: mutable bool = false
            while cursor < len(value):
                before: usize = cursor
                codepoint: mutable u32 = 0
                try metadata_json_decode_utf8(value, cursor, codepoint)
                if not metadata_unicode_whitespace(codepoint):
                    start <- before if not found
                    found <- true
                    end <- cursor
            return "" if not found
            return value[start:end]


        def metadata_process_observation(result: ProcessResult&) -> MetadataObservedText:
            valid: mutable bool = false
            catch validate_process_result(result):
                ok:
                    valid <- true
                error failure:
                    valid <- false
            return MetadataObservedText{} if not valid or result.kind != ProcessResultKind.Exited or result.exit_status != 0 or len(result.stdout) > Limits::HOST_OUTPUT_BYTES
            trimmed: mutable sview = ""
            catch metadata_trim_process_text(result.stdout):
                ok value:
                    trimmed <- value
                error failure:
                    return MetadataObservedText{}
            return MetadataObservedText{available: true, value: trimmed}


        def metadata_json_append_byte(output: mutable darray[u8]&, byte: u8, limit: usize) -> void error[MetadataJsonError] can[Memory.Allocate, Abort.Panic]:
            raise MetadataJsonError.OutputLimitExceeded if output.count >= limit
            output.push(byte)


        def metadata_json_append_text(output: mutable darray[u8]&, text: sview, limit: usize) -> void error[MetadataJsonError] can[Memory.Allocate, Abort.Panic]:
            raise MetadataJsonError.OutputLimitExceeded if len(text) > limit - output.count
            for index in 0..<len(text) |output, text|:
                output.push(sview_at(text, index))


        def metadata_json_append_hex4(output: mutable darray[u8]&, value: u32, limit: usize) -> void error[MetadataJsonError] can[Memory.Allocate, Abort.Panic]:
            try metadata_json_append_text(output, "\\u", limit)
            for shift in [12u32, 8u32, 4u32, 0u32] |output, value|:
                try metadata_json_append_byte(output, sview_at(Json::HEX, ((value >> shift) & 15u32).usize()), limit)


        def metadata_json_decode_utf8(value: sview, cursor: mutable usize&, codepoint: mutable u32&) -> void error[MetadataJsonError]:
            raise MetadataJsonError.InvalidUtf8 if cursor >= len(value)
            first: u8 = sview_at(value, cursor)
            width: mutable usize = 1
            if first <= 127u8:
                codepoint <- first.u32()
            elif first >= 194u8 and first <= 223u8 and cursor + 1 < len(value):
                second: u8 = sview_at(value, cursor + 1)
                raise MetadataJsonError.InvalidUtf8 if second < 128u8 or second > 191u8
                codepoint <- ((first & 31u8).u32() << 6) | (second & 63u8).u32()
                width <- 2
            elif first >= 224u8 and first <= 239u8 and cursor + 2 < len(value):
                second: u8 = sview_at(value, cursor + 1)
                third: u8 = sview_at(value, cursor + 2)
                raise MetadataJsonError.InvalidUtf8 if second < 128u8 or second > 191u8 or third < 128u8 or third > 191u8
                codepoint <- ((first & 15u8).u32() << 12) | ((second & 63u8).u32() << 6) | (third & 63u8).u32()
                raise MetadataJsonError.InvalidUtf8 if codepoint < 2048u32 or codepoint >= 55296u32 and codepoint <= 57343u32
                width <- 3
            elif first >= 240u8 and first <= 244u8 and cursor + 3 < len(value):
                second: u8 = sview_at(value, cursor + 1)
                third: u8 = sview_at(value, cursor + 2)
                fourth: u8 = sview_at(value, cursor + 3)
                raise MetadataJsonError.InvalidUtf8 if second < 128u8 or second > 191u8 or third < 128u8 or third > 191u8 or fourth < 128u8 or fourth > 191u8
                codepoint <- ((first & 7u8).u32() << 18) | ((second & 63u8).u32() << 12) | ((third & 63u8).u32() << 6) | (fourth & 63u8).u32()
                raise MetadataJsonError.InvalidUtf8 if codepoint < 65536u32 or codepoint > 1114111u32
                width <- 4
            else:
                raise MetadataJsonError.InvalidUtf8
            cursor <- cursor + width


        def metadata_json_append_escaped(output: mutable darray[u8]&, value: sview, limit: usize) -> void error[MetadataJsonError] can[Memory.Allocate, Abort.Panic]:
            try metadata_json_append_byte(output, 34u8, limit)
            cursor: mutable usize = 0
            while cursor < len(value):
                codepoint: mutable u32 = 0
                try metadata_json_decode_utf8(value, cursor, codepoint)
                if codepoint == 34u32 or codepoint == 92u32:
                    try metadata_json_append_byte(output, 92u8, limit)
                    try metadata_json_append_byte(output, codepoint.u8(), limit)
                elif codepoint == 8u32:
                    try metadata_json_append_text(output, "\\b", limit)
                elif codepoint == 9u32:
                    try metadata_json_append_text(output, "\\t", limit)
                elif codepoint == 10u32:
                    try metadata_json_append_text(output, "\\n", limit)
                elif codepoint == 12u32:
                    try metadata_json_append_text(output, "\\f", limit)
                elif codepoint == 13u32:
                    try metadata_json_append_text(output, "\\r", limit)
                elif codepoint < 32u32:
                    try metadata_json_append_hex4(output, codepoint, limit)
                elif codepoint <= 126u32:
                    try metadata_json_append_byte(output, codepoint.u8(), limit)
                elif codepoint <= 65535u32:
                    try metadata_json_append_hex4(output, codepoint, limit)
                else:
                    high: u32 = 55296u32 + ((codepoint - 65536u32) >> 10)
                    low: u32 = 56320u32 + ((codepoint - 65536u32) & 1023u32)
                    try metadata_json_append_hex4(output, high, limit)
                    try metadata_json_append_hex4(output, low, limit)
            try metadata_json_append_byte(output, 34u8, limit)


        def metadata_json_append_json_key(output: mutable darray[u8]&, key: sview, limit: usize) -> void error[MetadataJsonError] can[Memory.Allocate, Abort.Panic]:
            try metadata_json_append_escaped(output, key, limit)


        def metadata_json_append_assignment_object(output: mutable darray[u8]&, entries: darray[MetadataAssignment], indent: sview, limit: usize) -> void error[MetadataJsonError] can[Memory.Allocate, Abort.Panic]:
            final_entries: darray[MetadataAssignment] = metadata_final_assignments(entries)
            if final_entries.count == 0:
                try metadata_json_append_text(output, "{}", limit)
                return
            try metadata_json_append_text(output, "{\n", limit)
            for index in 0..<final_entries.count |output, final_entries, indent, limit|:
                try metadata_json_append_text(output, indent, limit)
                try metadata_json_append_json_key(output, final_entries[index].key, limit)
                try metadata_json_append_text(output, ": ", limit)
                try metadata_json_append_escaped(output, final_entries[index].value, limit)
                try metadata_json_append_text(output, "\n" if index + 1 == final_entries.count else ",\n", limit)
            try metadata_json_append_text(output, "  }", limit)

        def metadata_json_append_git_object(output: mutable darray[u8]&, facts: MetadataFacts, limit: usize) -> void error[MetadataJsonError] can[Memory.Allocate, Abort.Panic]:
            try metadata_json_append_text(output, "{\n    ", limit)
            try metadata_json_append_json_key(output, "branch", limit)
            try metadata_json_append_text(output, ": ", limit)
            try metadata_json_append_escaped(output, facts.git_branch, limit)
            try metadata_json_append_text(output, ",\n    ", limit)
            try metadata_json_append_json_key(output, "head", limit)
            try metadata_json_append_text(output, ": ", limit)
            try metadata_json_append_escaped(output, facts.git_head, limit)
            try metadata_json_append_text(output, ",\n    ", limit)
            try metadata_json_append_json_key(output, "status", limit)
            try metadata_json_append_text(output, ": ", limit)
            try metadata_json_append_escaped(output, facts.git_status, limit)
            try metadata_json_append_text(output, "\n  }", limit)


    public:
        def metadata_host_command(kind: MetadataHostCommandKind, repo_root: sview = "") -> ProcessCommand error[MetadataCommandError] can[Memory.Allocate, Abort.Panic]:
            raise MetadataCommandError.InvalidKind if not metadata_host_command_kind_valid(kind)
            if kind == MetadataHostCommandKind.GitHead or kind == MetadataHostCommandKind.GitBranch or kind == MetadataHostCommandKind.GitStatus:
                raise MetadataCommandError.InvalidRepoRoot if repo_root == "" or len(repo_root) >= Limits::PATH_BYTES or sview_contains_byte(repo_root, 0)
            command: mutable ProcessCommand = ProcessCommand{executable: "", environment: ["LC_ALL", "C.UTF-8", "LANG", "C.UTF-8"], environment_mode: ProcessEnvironmentMode.Inherit, stdin_mode: ProcessStdioMode.Null, stdout_mode: ProcessStdioMode.Capture, stderr_mode: ProcessStdioMode.Null, timeout_micros: Limits::HOST_TIMEOUT_MICROS, failure_mode: ProcessFailureMode.Allow}
            if kind == MetadataHostCommandKind.Hostname:
                command.executable <- "hostname"
            elif kind == MetadataHostCommandKind.Uname:
                command.executable <- "uname"
                command.arguments.push("-a")
            else:
                command.executable <- "git"
                command.working_directory <- repo_root
                if kind == MetadataHostCommandKind.GitHead:
                    command.arguments <- ["rev-parse", "HEAD"]
                elif kind == MetadataHostCommandKind.GitBranch:
                    command.arguments <- ["rev-parse", "--abbrev-ref", "HEAD"]
                else:
                    command.arguments <- ["status", "--short", "--untracked-files=no"]
            catch validate_process_command(command):
                ok:
                    pass
                error failure:
                    raise MetadataCommandError.InvalidCommand
            return command


        def metadata_facts_from_processes(generated_at_utc: sview, results: MetadataProcessResults&) -> MetadataFacts error[MetadataJsonError]:
            facts: mutable MetadataFacts = MetadataFacts{generated_at_utc: generated_at_utc}
            hostname: MetadataObservedText = metadata_process_observation(results.hostname)
            uname: MetadataObservedText = metadata_process_observation(results.uname)
            head: MetadataObservedText = metadata_process_observation(results.git_head)
            branch: MetadataObservedText = metadata_process_observation(results.git_branch)
            status: MetadataObservedText = metadata_process_observation(results.git_status)
            facts.hostname <- hostname.value if hostname.available and hostname.value != "" else "unknown"
            facts.uname <- uname.value if uname.available and uname.value != "" else "unknown"
            if head.available and head.value != "":
                facts.git_head <- head.value
                facts.git_branch <- branch.value if branch.available and branch.value != "" else "unknown"
                if status.available:
                    facts.git_status <- "clean" if status.value == "" else "dirty"
            raise MetadataJsonError.InvalidFacts if not metadata_facts_valid(facts)
            return facts


        def render_metadata_json(arguments: MetadataArguments&, facts: MetadataFacts&, max_bytes: usize = Json::MAX_BYTES) -> darray[u8] error[MetadataJsonError] can[Memory.Allocate, Abort.Panic]:
            raise MetadataJsonError.InvalidArguments if not metadata_arguments_shape_valid(arguments)
            raise MetadataJsonError.InvalidFacts if not metadata_facts_valid(facts)
            raise MetadataJsonError.InvalidLimit if max_bytes == 0 or max_bytes > Json::MAX_BYTES
            output: mutable darray[u8] = []
            try metadata_json_append_text(output, "{\n  ", max_bytes)
            try metadata_json_append_json_key(output, "bundle_type", max_bytes)
            try metadata_json_append_text(output, ": ", max_bytes)
            try metadata_json_append_escaped(output, arguments.bundle_type, max_bytes)
            try metadata_json_append_text(output, ",\n  ", max_bytes)
            try metadata_json_append_json_key(output, "commands", max_bytes)
            try metadata_json_append_text(output, ": ", max_bytes)
            try metadata_json_append_assignment_object(output, arguments.commands, "    ", max_bytes)
            try metadata_json_append_text(output, ",\n  ", max_bytes)
            try metadata_json_append_json_key(output, "generated_at_utc", max_bytes)
            try metadata_json_append_text(output, ": ", max_bytes)
            try metadata_json_append_escaped(output, facts.generated_at_utc, max_bytes)
            try metadata_json_append_text(output, ",\n  ", max_bytes)
            try metadata_json_append_json_key(output, "git", max_bytes)
            try metadata_json_append_text(output, ": ", max_bytes)
            try metadata_json_append_git_object(output, facts, max_bytes)
            try metadata_json_append_text(output, ",\n  ", max_bytes)
            try metadata_json_append_json_key(output, "hostname", max_bytes)
            try metadata_json_append_text(output, ": ", max_bytes)
            try metadata_json_append_escaped(output, facts.hostname, max_bytes)
            try metadata_json_append_text(output, ",\n  ", max_bytes)
            try metadata_json_append_json_key(output, "out_dir", max_bytes)
            try metadata_json_append_text(output, ": ", max_bytes)
            try metadata_json_append_escaped(output, arguments.out_dir, max_bytes)
            try metadata_json_append_text(output, ",\n  ", max_bytes)
            try metadata_json_append_json_key(output, "repo_root", max_bytes)
            try metadata_json_append_text(output, ": ", max_bytes)
            try metadata_json_append_escaped(output, arguments.repo_root, max_bytes)
            try metadata_json_append_text(output, ",\n  ", max_bytes)
            try metadata_json_append_json_key(output, "settings", max_bytes)
            try metadata_json_append_text(output, ": ", max_bytes)
            try metadata_json_append_assignment_object(output, arguments.settings, "    ", max_bytes)
            try metadata_json_append_text(output, ",\n  ", max_bytes)
            try metadata_json_append_json_key(output, "uname", max_bytes)
            try metadata_json_append_text(output, ": ", max_bytes)
            try metadata_json_append_escaped(output, facts.uname, max_bytes)
            try metadata_json_append_text(output, "\n}\n", max_bytes)
            return output


    public:
        def parse_metadata_arguments(arguments: darray[sview]) -> MetadataArguments error[MetadataArgumentsError]:
            result: mutable MetadataArguments = MetadataArguments{}
            index: mutable usize = 0
            options_ended: mutable bool = false
            while index < arguments.count:
                token: sview = arguments[index]
                raise MetadataArgumentsError.ArgumentTooLarge if len(token) > Limits::ARGUMENT_BYTES
                if options_ended:
                    raise MetadataArgumentsError.UnexpectedPositional
                if token == "--":
                    options_ended <- true
                    index <- index + 1
                else:
                    raise MetadataArgumentsError.UnexpectedPositional if len(token) < 2 or token[0:2] != "--"
                    equals: i64 = token.index("=")
                    option_name: sview = token if equals < 0 else token[0:equals]
                    kind: MetadataOptionKind = metadata_option_kind(option_name)
                    raise MetadataArgumentsError.UnknownOption if kind == MetadataOptionKind.Unknown
                    raise MetadataArgumentsError.AmbiguousOption if kind == MetadataOptionKind.Ambiguous
                    attached: bool = equals >= 0
                    value: mutable sview = ""
                    if attached:
                        value <- token[equals + 1:len(token)]
                    else:
                        raise MetadataArgumentsError.MissingOptionValue if index + 1 >= arguments.count
                        next_value: sview = arguments[index + 1]
                        raise MetadataArgumentsError.ArgumentTooLarge if len(next_value) > Limits::ARGUMENT_BYTES
                        raise MetadataArgumentsError.MissingOptionValue if metadata_value_looks_like_option(next_value)
                        value <- next_value
                        index <- index + 1
                    if kind == MetadataOptionKind.Output:
                        raise MetadataArgumentsError.PathTooLong if len(value) > Limits::PATH_BYTES
                        result.output <- value
                        result.has_output <- true
                    elif kind == MetadataOptionKind.BundleType:
                        result.bundle_type <- value
                        result.has_bundle_type <- true
                    elif kind == MetadataOptionKind.RepoRoot:
                        raise MetadataArgumentsError.PathTooLong if len(value) > Limits::PATH_BYTES
                        result.repo_root <- value
                        result.has_repo_root <- true
                    elif kind == MetadataOptionKind.OutDir:
                        raise MetadataArgumentsError.PathTooLong if len(value) > Limits::PATH_BYTES
                        result.out_dir <- value
                        result.has_out_dir <- true
                    elif kind == MetadataOptionKind.Setting:
                        try metadata_append_assignment(result.settings, value)
                    else:
                        try metadata_append_assignment(result.commands, value)
                    index <- index + 1
            raise MetadataArgumentsError.MissingRequiredOption if not result.has_output or not result.has_bundle_type or not result.has_repo_root or not result.has_out_dir
            return result


        def metadata_setting_value(arguments: MetadataArguments, key: sview) -> sview:
            return metadata_assignment_value(arguments.settings, key)


        def metadata_command_value(arguments: MetadataArguments, key: sview) -> sview:
            return metadata_assignment_value(arguments.commands, key)


        def metadata_has_setting(arguments: MetadataArguments, key: sview) -> bool:
            return metadata_assignment_present(arguments.settings, key)


        def metadata_has_command(arguments: MetadataArguments, key: sview) -> bool:
            return metadata_assignment_present(arguments.commands, key)
