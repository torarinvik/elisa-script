# Descriptor-relative observations for the generic atomic-file state machine.
# This module captures current regular-file identities; publication remains a
# separate operation so callers can compare the receipt under their lock.

module EsFileAtomicPosix:
    using EsFileAtomic
    using EsHash
    using EsFileReadAtPosix
    using EsIr
    using EsRuntime

    public:
        struct AtomicFilePosixObservation:
            parent_device: u64
            parent_inode: u64
            parent_descriptor_token: u64
            destination: AtomicFileIdentity


        struct AtomicFilePosixStageProof:
            parent_device: u64
            parent_inode: u64
            parent_descriptor_token: u64
            stage_device: u64
            stage_inode: u64
            stage_descriptor_token: u64
            owner_token: u64
            link_count: usize


        error AtomicFilePosixError:
            InvalidDirectoryDescriptor
            InvalidLeafName
            DestinationStatFailed(path: cstr)
            DestinationNotRegular(path: cstr)
            DestinationTooLarge(path: cstr)
            DestinationReadFailed(path: cstr)
            DigestUnavailable(path: cstr)
            InvalidStageDescriptor
            InvalidOwnerToken
            ParentNotDirectory
            StageStatFailed
            StageNotRegular
            StageNotPrivate
            StageNotSingleLink
            StageNameMismatch
            StageIdentityChanged


    private:
        const module AtomicFilePosixErrno:
            ENOENT: i32 = 2
            EINTR: i32 = 4


        def atomic_file_posix_stat_descriptor(directory_fd: int, info: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_fstat(directory_fd, info) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == AtomicFilePosixErrno::EINTR and retries < EsFileReadAtPosix::Limits::EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def atomic_file_posix_stat_name(parent_fd: int, leaf_name: cstr, info: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_fstatat(parent_fd, leaf_name, info, DarwinAtFlag::SYMLINK_NOFOLLOW) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == AtomicFilePosixErrno::EINTR and retries < EsFileReadAtPosix::Limits::EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def atomic_file_posix_parent_matches(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return (right.mode & DarwinStatMode::MASK) == DarwinStatMode::DIRECTORY and left.device == right.device and left.inode == right.inode


        def atomic_file_posix_snapshot_matches(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return (right.mode & DarwinStatMode::MASK) == DarwinStatMode::REGULAR and left.device == right.device and left.inode == right.inode and left.size == right.size and left.modify_time.seconds == right.modify_time.seconds and left.modify_time.nanoseconds == right.modify_time.nanoseconds and left.change_time.seconds == right.change_time.seconds and left.change_time.nanoseconds == right.change_time.nanoseconds


        def atomic_file_posix_private(stat: ElisascriptStat) -> bool:
            return (stat.mode & 63u16) == 0u16


        def atomic_file_posix_same_inode(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return left.device == right.device and left.inode == right.inode


        def atomic_file_posix_stage_proof_equal(left: AtomicFilePosixStageProof, right: AtomicFilePosixStageProof) -> bool:
            return left.parent_device == right.parent_device and left.parent_inode == right.parent_inode and left.parent_descriptor_token == right.parent_descriptor_token and left.stage_device == right.stage_device and left.stage_inode == right.stage_inode and left.stage_descriptor_token == right.stage_descriptor_token and left.owner_token == right.owner_token and left.link_count == right.link_count


        def atomic_file_posix_digest(bytes: darray[u8]&) -> HashDigest can[Memory.Allocate, Abort.Panic]:
            raw_digest: darray[u8] = canonical_bytes_sha256(bytes)
            return HashDigest{algorithm: HashAlgorithm.Sha256, word_count: 4, word0: canonical_digest_word(raw_digest, 0), word1: canonical_digest_word(raw_digest, 1), word2: canonical_digest_word(raw_digest, 2), word3: canonical_digest_word(raw_digest, 3)} if raw_digest.count == 32
            return HashDigest{algorithm: HashAlgorithm.Sha256, word_count: 0}


        def atomic_file_posix_bytes_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            return false if left.count != right.count
            index: mutable usize = 0
            while index < left.count:
                return false if left[index] != right[index]
                index <- index + 1
            return true


    public:
        # Bind an already-open exclusive staging descriptor to a no-follow
        # sibling entry and its parent directory. The caller creates the file
        # with elisascript_posix_openat_private_file and must hold the declared
        # directory-mutation lease; recapture and compare this proof before
        # cleanup or rename because a snapshot is not a lock.
        def capture_atomic_file_stage_proof(parent_fd: int, stage_fd: int, leaf_name: cstr, owner_token: u64) -> AtomicFilePosixStageProof error[AtomicFilePosixError] can[Blocking.IO]:
            raise AtomicFilePosixError.InvalidStageDescriptor if parent_fd < 0 or stage_fd < 0 or parent_fd == stage_fd
            raise AtomicFilePosixError.InvalidOwnerToken if owner_token == 0
            raise AtomicFilePosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(leaf_name)

            parent_info: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_info)
            raise AtomicFilePosixError.ParentNotDirectory if (parent_info.mode & DarwinStatMode::MASK) != DarwinStatMode::DIRECTORY or parent_info.device == 0 or parent_info.inode == 0

            stage_info: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.StageStatFailed if not atomic_file_posix_stat_descriptor(stage_fd, stage_info)
            raise AtomicFilePosixError.StageNotRegular if (stage_info.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR
            raise AtomicFilePosixError.StageNotPrivate if not atomic_file_posix_private(stage_info)
            raise AtomicFilePosixError.StageNotSingleLink if stage_info.link_count != 1u16

            named_info: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.StageStatFailed if not atomic_file_posix_stat_name(parent_fd, leaf_name, named_info)
            raise AtomicFilePosixError.StageNameMismatch if not atomic_file_posix_same_inode(stage_info, named_info) or (named_info.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR or not atomic_file_posix_private(named_info) or named_info.link_count != 1u16
            raise AtomicFilePosixError.StageNameMismatch if parent_info.device != stage_info.device

            stage_after: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.StageStatFailed if not atomic_file_posix_stat_descriptor(stage_fd, stage_after)
            raise AtomicFilePosixError.StageIdentityChanged if not atomic_file_posix_same_inode(stage_info, stage_after) or (stage_after.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR or not atomic_file_posix_private(stage_after) or stage_after.link_count != 1u16
            parent_after: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_after) or not atomic_file_posix_parent_matches(parent_info, parent_after)

            stage_proof: AtomicFilePosixStageProof = AtomicFilePosixStageProof{parent_device: parent_after.device.u64(), parent_inode: parent_after.inode, parent_descriptor_token: parent_fd.u64() + 1u64, stage_device: stage_after.device.u64(), stage_inode: stage_after.inode, stage_descriptor_token: stage_fd.u64() + 1u64, owner_token: owner_token, link_count: stage_after.link_count.usize()}
            return stage_proof


        # A captured proof can go stale immediately after return. Mutating
        # callers must compare a fresh proof while holding their exclusive
        # parent-directory lease and refuse cleanup/rename on mismatch.
        def revalidate_atomic_file_stage_proof(parent_fd: int, stage_fd: int, leaf_name: cstr, owner_token: u64, expected: AtomicFilePosixStageProof) -> AtomicFilePosixStageProof error[AtomicFilePosixError] can[Blocking.IO]:
            observed: AtomicFilePosixStageProof = try capture_atomic_file_stage_proof(parent_fd, stage_fd, leaf_name, owner_token)
            raise AtomicFilePosixError.StageIdentityChanged if not atomic_file_posix_stage_proof_equal(expected, observed)
            return observed


        # Capture either an observed absence or the identity and SHA-256 of a
        # stable regular-file snapshot. The byte limit applies before owned
        # allocation. The caller must recapture under its mutation lock before
        # allowing a later rename or restore.
        def observe_atomic_file_at(a: mutable Arena&, parent_fd: int, leaf_name: cstr, byte_limit: usize = EsFileReadAtPosix::Limits::MAX_BYTES) -> AtomicFilePosixObservation error[AtomicFilePosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if parent_fd < 0
            raise AtomicFilePosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(leaf_name)
            raise AtomicFilePosixError.DestinationTooLarge(leaf_name) if byte_limit == 0 or byte_limit > EsFileReadAtPosix::Limits::MAX_BYTES

            parent_before: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_before) or (parent_before.mode & DarwinStatMode::MASK) != DarwinStatMode::DIRECTORY or parent_before.device == 0 or parent_before.inode == 0

            before: mutable ElisascriptStat = ElisascriptStat{}
            destination: mutable AtomicFileIdentity = AtomicFileIdentity{observed: true}
            if not atomic_file_posix_stat_name(parent_fd, leaf_name, before):
                errno: mutable i32& = elisascript_posix_errno()
                raise AtomicFilePosixError.DestinationStatFailed(leaf_name) if errno[0] != AtomicFilePosixErrno::ENOENT
            else:
                raise AtomicFilePosixError.DestinationNotRegular(leaf_name) if (before.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR
                raise AtomicFilePosixError.DestinationTooLarge(leaf_name) if before.size < 0 or before.size.usize().i64() != before.size or before.size.usize() > byte_limit

                bytes: mutable darray[u8] = []
                catch read_regular_file_at(a, parent_fd, leaf_name, byte_limit):
                    ok snapshot:
                        bytes <- snapshot
                    error failure:
                        raise AtomicFilePosixError.DestinationReadFailed(leaf_name)

                after: mutable ElisascriptStat = ElisascriptStat{}
                raise AtomicFilePosixError.DestinationStatFailed(leaf_name) if not atomic_file_posix_stat_name(parent_fd, leaf_name, after)
                raise AtomicFilePosixError.DestinationReadFailed(leaf_name) if not atomic_file_posix_snapshot_matches(before, after) or bytes.count != before.size.usize()
                digest: HashDigest = atomic_file_posix_digest(bytes)
                raise AtomicFilePosixError.DigestUnavailable(leaf_name) if digest.word_count != 4
                raise AtomicFilePosixError.DestinationStatFailed(leaf_name) if before.device == 0 or before.inode == 0
                destination <- AtomicFileIdentity{observed: true, present: true, size: bytes.count, volume_id: before.device.u64(), object_id: before.inode, digest: digest}

            parent_after: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_after) or not atomic_file_posix_parent_matches(parent_before, parent_after)
            return AtomicFilePosixObservation{parent_device: parent_before.device.u64(), parent_inode: parent_before.inode, parent_descriptor_token: parent_fd.u64() + 1u64, destination: destination}


        # Compare the current leaf with caller-owned output bytes exactly, not
        # by digest alone. This is the no-op decision primitive for the future
        # AtomicFileSession publisher; the caller still supplies its exclusive
        # directory-mutation policy around comparison and publication.
        def atomic_file_bytes_equal_at(a: mutable Arena&, parent_fd: int, leaf_name: cstr, expected: darray[u8]&, byte_limit: usize = EsFileReadAtPosix::Limits::MAX_BYTES) -> bool error[AtomicFilePosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if parent_fd < 0
            raise AtomicFilePosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(leaf_name)
            raise AtomicFilePosixError.DestinationTooLarge(leaf_name) if byte_limit == 0 or byte_limit > EsFileReadAtPosix::Limits::MAX_BYTES or expected.count > byte_limit

            parent_before: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_before) or (parent_before.mode & DarwinStatMode::MASK) != DarwinStatMode::DIRECTORY

            before: mutable ElisascriptStat = ElisascriptStat{}
            if not atomic_file_posix_stat_name(parent_fd, leaf_name, before):
                errno: mutable i32& = elisascript_posix_errno()
                raise AtomicFilePosixError.DestinationStatFailed(leaf_name) if errno[0] != AtomicFilePosixErrno::ENOENT
                parent_after_absent: mutable ElisascriptStat = ElisascriptStat{}
                raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_after_absent) or not atomic_file_posix_parent_matches(parent_before, parent_after_absent)
                return false

            raise AtomicFilePosixError.DestinationNotRegular(leaf_name) if (before.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR
            raise AtomicFilePosixError.DestinationTooLarge(leaf_name) if before.size < 0 or before.size.usize().i64() != before.size or before.size.usize() > byte_limit
            observed: mutable darray[u8] = []
            catch read_regular_file_at(a, parent_fd, leaf_name, byte_limit):
                ok bytes:
                    observed <- bytes
                error failure:
                    raise AtomicFilePosixError.DestinationReadFailed(leaf_name)

            after: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.DestinationStatFailed(leaf_name) if not atomic_file_posix_stat_name(parent_fd, leaf_name, after)
            raise AtomicFilePosixError.DestinationReadFailed(leaf_name) if not atomic_file_posix_snapshot_matches(before, after) or observed.count != before.size.usize()
            parent_after: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_after) or not atomic_file_posix_parent_matches(parent_before, parent_after)
            return atomic_file_posix_bytes_equal(observed, expected)
