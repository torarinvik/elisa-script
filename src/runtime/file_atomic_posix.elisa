# Descriptor-relative observations for the generic atomic-file state machine.
# This module captures current regular-file identities; publication remains a
# separate operation so callers can compare the receipt under their lock.

module EsFileAtomicPosix:
    using EsFileAtomic
    using EsHash
    using EsFileReadAtPosix
    using EsIr
    using EsRuntime

    public:
        const module Limits:
            WRITE_CALLS: usize = 1048576
            EINTR_RETRIES: usize = 8


        struct AtomicFilePosixObservation:
            parent_device: u64
            parent_inode: u64
            parent_descriptor_token: u64
            destination: AtomicFileIdentity
            link_count: usize
            private_mode: bool


        struct AtomicFilePosixStageProof:
            parent_device: u64
            parent_inode: u64
            parent_descriptor_token: u64
            stage_device: u64
            stage_inode: u64
            stage_descriptor_token: u64
            owner_token: u64
            link_count: usize


        struct AtomicFilePosixStageHandle:
            descriptor: int
            proof: AtomicFilePosixStageProof
            close_status: int = 0


        error AtomicFilePosixError:
            InvalidDirectoryDescriptor
            InvalidLeafName
            DestinationStatFailed(path: cstr)
            DestinationNotRegular(path: cstr)
            DestinationTooLarge(path: cstr)
            DestinationReadFailed(path: cstr)
            DigestUnavailable(path: cstr)
            StageCreateFailed(path: cstr, errno: i32)
            StageCreateOutcomeUnknown(path: cstr, errno: i32)
            StageAdmissionUncertain(path: cstr, descriptor: int, close_status: int)
            InvalidStageDescriptor
            InvalidOwnerToken
            ParentNotDirectory
            StageStatFailed
            StageNotRegular
            StageNotPrivate
            StageNotSingleLink
            StageNameMismatch
            StageIdentityChanged
            StageNotReady
            StageWriteFailed
            StageSyncFailed
            StageCloseFailed(close_status: int)
            StageReceiptFailed
            StageContentMismatch
            DestinationChanged
            RenameOutcomeUnknown
            DirectorySyncFailed
            StageCleanupFailed


    private:
        const module AtomicFilePosixErrno:
            ENOENT: i32 = 2
            EINTR: i32 = 4
            EIO: i32 = 5


        const enum AtomicFilePosixWriteState of u8:
            Write
            Done
            Failed


        struct AtomicFilePosixWriteCursor:
            state: AtomicFilePosixWriteState = AtomicFilePosixWriteState.Write
            offset: usize = 0
            calls: usize = 0
            interrupted: usize = 0


        def atomic_file_posix_stat_descriptor(directory_fd: int, info: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_fstat(directory_fd, info) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == AtomicFilePosixErrno::EINTR and retries < EsFileReadAtPosix::Limits::EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def atomic_file_posix_stat_name(parent_fd: int, leaf_name: cstr, info: mutable ElisascriptStat&) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_fstatat(parent_fd, leaf_name, info, DarwinAtFlag::SYMLINK_NOFOLLOW) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == AtomicFilePosixErrno::EINTR and retries < EsFileReadAtPosix::Limits::EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def atomic_file_posix_parent_matches(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return (right.mode & DarwinStatMode::MASK) == DarwinStatMode::DIRECTORY and left.device == right.device and left.inode == right.inode


        def atomic_file_posix_snapshot_matches(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return (right.mode & DarwinStatMode::MASK) == DarwinStatMode::REGULAR and left.device == right.device and left.inode == right.inode and left.size == right.size and left.modify_time.seconds == right.modify_time.seconds and left.modify_time.nanoseconds == right.modify_time.nanoseconds and left.change_time.seconds == right.change_time.seconds and left.change_time.nanoseconds == right.change_time.nanoseconds


        def atomic_file_posix_private(stat: ElisascriptStat) -> bool:
            return (stat.mode & 63u16) == 0u16


        def atomic_file_posix_same_inode(left: ElisascriptStat, right: ElisascriptStat) -> bool:
            return left.device == right.device and left.inode == right.inode


        def atomic_file_posix_stage_proof_equal(left: AtomicFilePosixStageProof, right: AtomicFilePosixStageProof) -> bool:
            return left.parent_device == right.parent_device and left.parent_inode == right.parent_inode and left.parent_descriptor_token == right.parent_descriptor_token and left.stage_device == right.stage_device and left.stage_inode == right.stage_inode and left.stage_descriptor_token == right.stage_descriptor_token and left.owner_token == right.owner_token and left.link_count == right.link_count


        def atomic_file_posix_session_stage_admission_matches(session: AtomicFileSession&, proof: AtomicFilePosixStageProof) -> bool:
            return session.stage_admission.parent_device == proof.parent_device and session.stage_admission.parent_inode == proof.parent_inode and session.stage_admission.parent_descriptor_token == proof.parent_descriptor_token and session.stage_admission.stage_device == proof.stage_device and session.stage_admission.stage_inode == proof.stage_inode and session.stage_admission.stage_descriptor_token == proof.stage_descriptor_token and session.stage_admission.owner_token == proof.owner_token and session.stage_admission.link_count == proof.link_count


        def atomic_file_posix_stage_admission_is_default(session: AtomicFileSession&) -> bool:
            return session.stage_admission.parent_device == 0 and session.stage_admission.parent_inode == 0 and session.stage_admission.parent_descriptor_token == 0 and session.stage_admission.stage_device == 0 and session.stage_admission.stage_inode == 0 and session.stage_admission.stage_descriptor_token == 0 and session.stage_admission.owner_token == 0 and session.stage_admission.link_count == 0


        def atomic_file_posix_session_stage_identity_matches(session: AtomicFileSession&) -> bool:
            return false if atomic_file_posix_stage_admission_is_default(session) or not session.staged_identity.observed or not session.staged_identity.present
            return session.stage_admission.stage_device == session.staged_identity.volume_id and session.stage_admission.stage_inode == session.staged_identity.object_id


        def atomic_file_posix_digest_equal(left: HashDigest, right: HashDigest) -> bool:
            return left.algorithm == right.algorithm and left.word_count == right.word_count and left.word0 == right.word0 and left.word1 == right.word1 and left.word2 == right.word2 and left.word3 == right.word3 and left.word4 == right.word4 and left.word5 == right.word5 and left.word6 == right.word6 and left.word7 == right.word7


        def atomic_file_posix_identity_equal(left: AtomicFileIdentity, right: AtomicFileIdentity) -> bool:
            return false if not left.observed or not right.observed
            return false if left.present != right.present or left.size != right.size or left.volume_id != right.volume_id or left.object_id != right.object_id
            return true if not left.present
            return atomic_file_posix_digest_equal(left.digest, right.digest)


        def atomic_file_posix_path_leaf_matches(path: sview, leaf_name: cstr) -> bool:
            path_length: usize = sview_len(path)
            leaf_length: usize = runtime_strlen(leaf_name)
            leaf_start: mutable usize = 0
            for index in 0..<path_length |leaf_start, path|:
                leaf_start <- index + 1 if path[index] == 47u8
            return false if path_length - leaf_start != leaf_length
            leaf_bytes: u8& = leaf_name.cast[u8&]
            for index in 0..<leaf_length |path, leaf_bytes|:
                return false if path[leaf_start + index] != leaf_bytes[index]
            return true


        def atomic_file_posix_write_fully(fd: int, buffer: u8&, length: usize) -> usize error[AtomicFilePosixError] can[Blocking.IO]:
            raise AtomicFilePosixError.InvalidStageDescriptor if fd < 0 or (length != 0 and buffer == null)
            cursor: mutable AtomicFilePosixWriteCursor = AtomicFilePosixWriteCursor{}
            machine over cursor.state:
                state Write
                start Write

                Write, AtomicFilePosixWriteState.Write if cursor.offset >= length:
                    cursor.state <- AtomicFilePosixWriteState.Done
                    -> Write
                Write, AtomicFilePosixWriteState.Write if cursor.calls >= Limits::WRITE_CALLS:
                    cursor.state <- AtomicFilePosixWriteState.Failed
                    -> Write
                Write, AtomicFilePosixWriteState.Write:
                    remaining: usize = length - cursor.offset
                    next_bytes: mutable u8& = buffer + cursor.offset
                    amount: isize = elisascript_posix_write(fd, next_bytes.cast[void&], remaining)
                    cursor.calls <- cursor.calls + 1
                    if amount < 0:
                        errno: mutable i32& = elisascript_posix_errno()
                        if errno[0] == AtomicFilePosixErrno::EINTR and cursor.interrupted < Limits::EINTR_RETRIES:
                            cursor.interrupted <- cursor.interrupted + 1
                            -> Write
                        cursor.state <- AtomicFilePosixWriteState.Failed
                        -> Write
                    if amount == 0 or amount.usize() > remaining:
                        cursor.state <- AtomicFilePosixWriteState.Failed
                        -> Write
                    cursor.offset <- cursor.offset + amount.usize()
                    cursor.interrupted <- 0
                    -> Write

                Write, AtomicFilePosixWriteState.Done:
                    break
                Write, AtomicFilePosixWriteState.Failed:
                    break

            raise AtomicFilePosixError.StageWriteFailed if cursor.state != AtomicFilePosixWriteState.Done
            return cursor.offset


        def atomic_file_posix_sync_descriptor(fd: int) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while true:
                return true if elisascript_posix_fsync(fd) == 0
                errno: mutable i32& = elisascript_posix_errno()
                if errno[0] == AtomicFilePosixErrno::EINTR and retries < Limits::EINTR_RETRIES:
                    retries <- retries + 1
                    continue
                return false


        def atomic_file_posix_fail_session(session: mutable AtomicFileSession&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if session.state != AtomicFileState.Staging
            catch advance_atomic_file(session, AtomicFileEvent.Fail):
                ok state:
                    return state == AtomicFileState.FailedPendingCleanup
                error failure:
                    return false


        def atomic_file_posix_mark_publish_uncertain(session: mutable AtomicFileSession&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if session.state != AtomicFileState.Committing and session.state != AtomicFileState.Committed
            catch advance_atomic_file(session, AtomicFileEvent.PublishUncertain):
                ok state:
                    return state == AtomicFileState.PublishedUncertain
                error failure:
                    return false


        # Acknowledging cleanup means the staging-directory entry removal is
        # durable whenever the plan requires directory synchronization. If
        # sync fails after unlink, leave the session pending so a retry can
        # observe the already-absent entry and retry the directory sync.
        def atomic_file_posix_sync_cleanup_directory(session: AtomicFileSession&, parent_fd: int) -> bool can[Blocking.IO]:
            return true if not session.plan.require_directory_sync
            return atomic_file_posix_sync_descriptor(parent_fd)


        def atomic_file_posix_digest(bytes: darray[u8]&) -> HashDigest can[Memory.Allocate, Abort.Panic]:
            raw_digest: darray[u8] = canonical_bytes_sha256(bytes)
            return HashDigest{algorithm: HashAlgorithm.Sha256, word_count: 4, word0: canonical_digest_word(raw_digest, 0), word1: canonical_digest_word(raw_digest, 1), word2: canonical_digest_word(raw_digest, 2), word3: canonical_digest_word(raw_digest, 3)} if raw_digest.count == 32
            return HashDigest{algorithm: HashAlgorithm.Sha256, word_count: 0}


        def atomic_file_posix_bytes_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            return false if left.count != right.count
            index: mutable usize = 0
            while index < left.count:
                return false if left[index] != right[index]
                index <- index + 1
            return true


    public:
        # Admit an already-created private staging sibling into the generic
        # publication session. The caller owns stage creation and the returned
        # descriptor; this operation binds that descriptor to the planned
        # parent/name before the model enters Staging. The exclusive directory
        # mutation lease must cover admission and remain held through cleanup
        # or publication.
        def begin_atomic_file_stage(session: mutable AtomicFileSession&, parent_fd: int, stage_fd: int, stage_leaf: cstr) -> AtomicFilePosixStageProof error[AtomicFilePosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            catch validate_atomic_file_session(session):
                ok:
                    pass
                error failure:
                    raise AtomicFilePosixError.StageNotReady
            raise AtomicFilePosixError.StageNotReady if session.state != AtomicFileState.Planned or parent_fd < 0 or stage_fd < 0 or parent_fd == stage_fd
            raise AtomicFilePosixError.StageNotReady if session.plan.parent_identity != parent_fd.u64() + 1u64
            raise AtomicFilePosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(stage_leaf)
            raise AtomicFilePosixError.StageNotReady if not atomic_file_posix_path_leaf_matches(session.plan.staging_path, stage_leaf)
            proof: AtomicFilePosixStageProof = try capture_atomic_file_stage_proof(parent_fd, stage_fd, stage_leaf, session.plan.owner_token)
            admission: AtomicFileStageAdmission = AtomicFileStageAdmission{parent_device: proof.parent_device, parent_inode: proof.parent_inode, parent_descriptor_token: proof.parent_descriptor_token, stage_device: proof.stage_device, stage_inode: proof.stage_inode, stage_descriptor_token: proof.stage_descriptor_token, owner_token: proof.owner_token, link_count: proof.link_count}
            catch advance_atomic_file(session, AtomicFileEvent.Begin, stage_admission: admission):
                ok state:
                    return proof if state == AtomicFileState.Staging
                    raise AtomicFilePosixError.StageNotReady
                error failure:
                    raise AtomicFilePosixError.StageNotReady


        # Create and admit an exclusive private sibling as one caller-facing
        # step. On success the caller owns the returned descriptor and must
        # keep the directory-mutation lease through sealing/publication or
        # cleanup. If admission fails after creation, make one close attempt
        # and report the path plus descriptor; do not unlink a name whose live
        # identity could not be proved.
        def create_atomic_file_stage(session: mutable AtomicFileSession&, parent_fd: int, stage_leaf: cstr) -> AtomicFilePosixStageHandle error[AtomicFilePosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            catch validate_atomic_file_session(session):
                ok:
                    pass
                error failure:
                    raise AtomicFilePosixError.StageNotReady
            raise AtomicFilePosixError.StageNotReady if session.state != AtomicFileState.Planned or parent_fd < 0 or session.plan.parent_identity != parent_fd.u64() + 1u64
            raise AtomicFilePosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(stage_leaf)
            raise AtomicFilePosixError.StageNotReady if not atomic_file_posix_path_leaf_matches(session.plan.staging_path, stage_leaf)
            parent_info: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_info)
            raise AtomicFilePosixError.ParentNotDirectory if (parent_info.mode & DarwinStatMode::MASK) != DarwinStatMode.DIRECTORY or parent_info.device == 0 or parent_info.inode == 0

            create_flags: int = DarwinOpenFlags::WRONLY | DarwinOpenFlags::CREATE | DarwinOpenFlags::EXCLUSIVE | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
            stage_fd: int = elisascript_posix_openat(parent_fd, stage_leaf, create_flags, 384u32)
            if stage_fd < 0:
                errno: mutable i32& = elisascript_posix_errno()
                raise AtomicFilePosixError.StageCreateOutcomeUnknown(stage_leaf, errno[0]) if errno[0] == AtomicFilePosixErrno::EINTR or errno[0] == AtomicFilePosixErrno::EIO
                raise AtomicFilePosixError.StageCreateFailed(stage_leaf, errno[0])

            proof: mutable AtomicFilePosixStageProof = AtomicFilePosixStageProof{parent_device: 0, parent_inode: 0, parent_descriptor_token: 0, stage_device: 0, stage_inode: 0, stage_descriptor_token: 0, owner_token: 0, link_count: 0}
            catch begin_atomic_file_stage(session, parent_fd, stage_fd, stage_leaf):
                ok admitted:
                    proof <- admitted
                error failure:
                    _ = failure
                    close_status: int = elisascript_posix_close(stage_fd)
                    raise AtomicFilePosixError.StageAdmissionUncertain(stage_leaf, stage_fd, close_status)
            return AtomicFilePosixStageHandle{descriptor: stage_fd, proof: proof}


        # Bind an already-open exclusive staging descriptor to a no-follow
        # sibling entry and its parent directory. The caller creates the file
        # with elisascript_posix_openat_private_file and must hold the declared
        # directory-mutation lease; recapture and compare this proof before
        # cleanup or rename because a snapshot is not a lock.
        def capture_atomic_file_stage_proof(parent_fd: int, stage_fd: int, leaf_name: cstr, owner_token: u64) -> AtomicFilePosixStageProof error[AtomicFilePosixError] can[Blocking.IO]:
            raise AtomicFilePosixError.InvalidStageDescriptor if parent_fd < 0 or stage_fd < 0 or parent_fd == stage_fd
            raise AtomicFilePosixError.InvalidOwnerToken if owner_token == 0
            raise AtomicFilePosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(leaf_name)

            parent_info: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_info)
            raise AtomicFilePosixError.ParentNotDirectory if (parent_info.mode & DarwinStatMode::MASK) != DarwinStatMode::DIRECTORY or parent_info.device == 0 or parent_info.inode == 0

            stage_info: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.StageStatFailed if not atomic_file_posix_stat_descriptor(stage_fd, stage_info)
            raise AtomicFilePosixError.StageNotRegular if (stage_info.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR
            raise AtomicFilePosixError.StageNotPrivate if not atomic_file_posix_private(stage_info)
            raise AtomicFilePosixError.StageNotSingleLink if stage_info.link_count != 1u16

            named_info: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.StageStatFailed if not atomic_file_posix_stat_name(parent_fd, leaf_name, named_info)
            raise AtomicFilePosixError.StageNameMismatch if not atomic_file_posix_same_inode(stage_info, named_info) or (named_info.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR or not atomic_file_posix_private(named_info) or named_info.link_count != 1u16
            raise AtomicFilePosixError.StageNameMismatch if parent_info.device != stage_info.device

            stage_after: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.StageStatFailed if not atomic_file_posix_stat_descriptor(stage_fd, stage_after)
            raise AtomicFilePosixError.StageIdentityChanged if not atomic_file_posix_same_inode(stage_info, stage_after) or (stage_after.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR or not atomic_file_posix_private(stage_after) or stage_after.link_count != 1u16
            parent_after: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_after) or not atomic_file_posix_parent_matches(parent_info, parent_after)

            stage_proof: AtomicFilePosixStageProof = AtomicFilePosixStageProof{parent_device: parent_after.device.u64(), parent_inode: parent_after.inode, parent_descriptor_token: parent_fd.u64() + 1u64, stage_device: stage_after.device.u64(), stage_inode: stage_after.inode, stage_descriptor_token: stage_fd.u64() + 1u64, owner_token: owner_token, link_count: stage_after.link_count.usize()}
            return stage_proof


        # A captured proof can go stale immediately after return. Mutating
        # callers must compare a fresh proof while holding their exclusive
        # parent-directory lease and refuse cleanup/rename on mismatch.
        def revalidate_atomic_file_stage_proof(parent_fd: int, stage_fd: int, leaf_name: cstr, owner_token: u64, expected: AtomicFilePosixStageProof) -> AtomicFilePosixStageProof error[AtomicFilePosixError] can[Blocking.IO]:
            observed: AtomicFilePosixStageProof = try capture_atomic_file_stage_proof(parent_fd, stage_fd, leaf_name, owner_token)
            raise AtomicFilePosixError.StageIdentityChanged if not atomic_file_posix_stage_proof_equal(expected, observed)
            return observed


        # Append only after validating the pure session and the live stage
        # proof. A short/failed write can leave a partial file, so the session
        # moves to FailedPendingCleanup and never accounts unconfirmed bytes.
        def append_atomic_file_stage(session: mutable AtomicFileSession&, parent_fd: int, stage_handle: AtomicFilePosixStageHandle&, leaf_name: cstr, bytes: darray[u8]&) -> usize error[AtomicFilePosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            catch validate_atomic_file_session(session):
                ok:
                    pass
                error failure:
                    raise AtomicFilePosixError.StageNotReady
            stage_fd: int = stage_handle.descriptor
            expected: AtomicFilePosixStageProof = stage_handle.proof
            raise AtomicFilePosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(leaf_name)
            raise AtomicFilePosixError.StageNotReady if session.state != AtomicFileState.Staging or stage_fd < 0 or expected.owner_token != session.plan.owner_token or expected.parent_descriptor_token != session.plan.parent_identity or expected.stage_descriptor_token != stage_fd.u64() + 1u64 or expected.parent_descriptor_token != parent_fd.u64() + 1u64 or not atomic_file_posix_session_stage_admission_matches(session, expected) or not atomic_file_posix_path_leaf_matches(session.plan.staging_path, leaf_name)
            raise AtomicFilePosixError.StageNotReady if bytes.count > session.plan.max_content_bytes - session.staged_bytes or (bytes.count != 0 and session.append_count >= EsFileAtomic::Limits::APPENDS)
            return 0 if bytes.count == 0

            pre_write_matches: mutable bool = true
            catch revalidate_atomic_file_stage_proof(parent_fd, stage_fd, leaf_name, expected.owner_token, expected):
                ok observed:
                    pre_write_matches <- atomic_file_posix_stage_proof_equal(expected, observed)
                error failure:
                    pre_write_matches <- false
            if not pre_write_matches:
                _ = atomic_file_posix_fail_session(session)
                raise AtomicFilePosixError.StageIdentityChanged

            written: mutable usize = 0
            catch atomic_file_posix_write_fully(stage_fd, bytes.items, bytes.count):
                ok amount:
                    written <- amount
                error failure:
                    _ = atomic_file_posix_fail_session(session)
                    raise AtomicFilePosixError.StageWriteFailed

            post_write_matches: mutable bool = true
            catch revalidate_atomic_file_stage_proof(parent_fd, stage_fd, leaf_name, expected.owner_token, expected):
                ok observed:
                    post_write_matches <- atomic_file_posix_stage_proof_equal(expected, observed)
                error failure:
                    post_write_matches <- false
            if not post_write_matches:
                _ = atomic_file_posix_fail_session(session)
                raise AtomicFilePosixError.StageIdentityChanged

            catch advance_atomic_file(session, AtomicFileEvent.Append, appended_bytes: written):
                ok state:
                    return written
                error failure:
                    _ = atomic_file_posix_fail_session(session)
                    raise AtomicFilePosixError.StageNotReady


        # Consume the admitted stage descriptor: sync once with bounded EINTR
        # handling, never retry close, verify the descriptor was not swapped,
        # and build the StageReady receipt only from a stable post-close read.
        # After the live stage proof is revalidated this function consumes the
        # handle's descriptor with exactly one close attempt on every exit.
        def seal_atomic_file_stage(a: mutable Arena&, session: mutable AtomicFileSession&, parent_fd: int, stage_handle: mutable AtomicFilePosixStageHandle&, leaf_name: cstr) -> AtomicFileIdentity error[AtomicFilePosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            catch validate_atomic_file_session(session):
                ok:
                    pass
                error failure:
                    raise AtomicFilePosixError.StageNotReady
            stage_fd: int = stage_handle.descriptor
            expected: AtomicFilePosixStageProof = stage_handle.proof
            raise AtomicFilePosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(leaf_name)
            raise AtomicFilePosixError.StageNotReady if session.state != AtomicFileState.Staging or stage_fd < 0 or parent_fd < 0 or parent_fd == stage_fd or expected.owner_token != session.plan.owner_token or expected.parent_descriptor_token != session.plan.parent_identity or expected.parent_descriptor_token != parent_fd.u64() + 1u64 or expected.stage_descriptor_token != stage_fd.u64() + 1u64 or not atomic_file_posix_session_stage_admission_matches(session, expected) or not atomic_file_posix_path_leaf_matches(session.plan.staging_path, leaf_name)

            preflight_matches: mutable bool = true
            catch revalidate_atomic_file_stage_proof(parent_fd, stage_fd, leaf_name, expected.owner_token, expected):
                ok observed:
                    preflight_matches <- atomic_file_posix_stage_proof_equal(expected, observed)
                error failure:
                    preflight_matches <- false
            if not preflight_matches:
                _ = atomic_file_posix_fail_session(session)
                raise AtomicFilePosixError.StageIdentityChanged

            synced: bool = atomic_file_posix_sync_descriptor(stage_fd)
            post_sync_matches: mutable bool = true
            if synced:
                catch revalidate_atomic_file_stage_proof(parent_fd, stage_fd, leaf_name, expected.owner_token, expected):
                    ok observed:
                        post_sync_matches <- atomic_file_posix_stage_proof_equal(expected, observed)
                    error failure:
                        post_sync_matches <- false

            close_status: int = elisascript_posix_close(stage_fd)
            stage_handle.descriptor <- -1
            stage_handle.close_status <- close_status
            if not synced or not post_sync_matches or close_status != 0:
                _ = atomic_file_posix_fail_session(session)
                raise AtomicFilePosixError.StageSyncFailed if not synced
                raise AtomicFilePosixError.StageIdentityChanged if not post_sync_matches
                raise AtomicFilePosixError.StageCloseFailed(close_status)

            snapshot: mutable AtomicFilePosixObservation = AtomicFilePosixObservation{parent_device: 0, parent_inode: 0, parent_descriptor_token: 0, destination: AtomicFileIdentity{}, link_count: 0, private_mode: false}
            catch observe_atomic_file_at(a, parent_fd, leaf_name, session.plan.max_content_bytes):
                ok observed:
                    snapshot <- observed
                error failure:
                    _ = atomic_file_posix_fail_session(session)
                    raise AtomicFilePosixError.StageReceiptFailed
            staged: AtomicFileIdentity = snapshot.destination
            if not staged.present or staged.volume_id != expected.stage_device or staged.object_id != expected.stage_inode or staged.size != session.staged_bytes or snapshot.link_count != 1 or not snapshot.private_mode:
                _ = atomic_file_posix_fail_session(session)
                raise AtomicFilePosixError.StageReceiptFailed

            catch advance_atomic_file(session, AtomicFileEvent.StageReady, identity: staged):
                ok state:
                    return staged
                error failure:
                    _ = atomic_file_posix_fail_session(session)
                    raise AtomicFilePosixError.StageNotReady


        # Capture either an observed absence or the identity and SHA-256 of a
        # stable regular-file snapshot. The byte limit applies before owned
        # allocation. The caller must recapture under its mutation lock before
        # allowing a later rename or restore.
        def observe_atomic_file_at(a: mutable Arena&, parent_fd: int, leaf_name: cstr, byte_limit: usize = EsFileReadAtPosix::Limits::MAX_BYTES) -> AtomicFilePosixObservation error[AtomicFilePosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            scratch_mark: ArenaMark = arena_snapshot(a)
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if parent_fd < 0
            raise AtomicFilePosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(leaf_name)
            raise AtomicFilePosixError.DestinationTooLarge(leaf_name) if byte_limit == 0 or byte_limit > EsFileReadAtPosix::Limits::MAX_BYTES

            parent_before: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_before) or (parent_before.mode & DarwinStatMode::MASK) != DarwinStatMode::DIRECTORY or parent_before.device == 0 or parent_before.inode == 0

            before: mutable ElisascriptStat = ElisascriptStat{}
            destination: mutable AtomicFileIdentity = AtomicFileIdentity{observed: true}
            link_count: mutable usize = 0
            private_mode: mutable bool = false
            if not atomic_file_posix_stat_name(parent_fd, leaf_name, before):
                errno: mutable i32& = elisascript_posix_errno()
                raise AtomicFilePosixError.DestinationStatFailed(leaf_name) if errno[0] != AtomicFilePosixErrno::ENOENT
            else:
                raise AtomicFilePosixError.DestinationNotRegular(leaf_name) if (before.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR
                raise AtomicFilePosixError.DestinationTooLarge(leaf_name) if before.size < 0 or before.size.usize().i64() != before.size or before.size.usize() > byte_limit

                bytes: mutable darray[u8] = []
                catch read_regular_file_at(a, parent_fd, leaf_name, byte_limit):
                    ok snapshot:
                        bytes <- snapshot
                    error failure:
                        arena_rewind(a, scratch_mark)
                        raise AtomicFilePosixError.DestinationReadFailed(leaf_name)

                after: mutable ElisascriptStat = ElisascriptStat{}
                if not atomic_file_posix_stat_name(parent_fd, leaf_name, after):
                    arena_rewind(a, scratch_mark)
                    raise AtomicFilePosixError.DestinationStatFailed(leaf_name)
                if not atomic_file_posix_snapshot_matches(before, after) or bytes.count != before.size.usize():
                    arena_rewind(a, scratch_mark)
                    raise AtomicFilePosixError.DestinationReadFailed(leaf_name)
                digest: HashDigest = atomic_file_posix_digest(bytes)
                if digest.word_count != 4:
                    arena_rewind(a, scratch_mark)
                    raise AtomicFilePosixError.DigestUnavailable(leaf_name)
                if before.device == 0 or before.inode == 0:
                    arena_rewind(a, scratch_mark)
                    raise AtomicFilePosixError.DestinationStatFailed(leaf_name)
                link_count <- after.link_count.usize()
                private_mode <- atomic_file_posix_private(after)
                destination <- AtomicFileIdentity{observed: true, present: true, size: bytes.count, volume_id: before.device.u64(), object_id: before.inode, digest: digest}

            parent_after: mutable ElisascriptStat = ElisascriptStat{}
            if not atomic_file_posix_stat_descriptor(parent_fd, parent_after) or not atomic_file_posix_parent_matches(parent_before, parent_after):
                arena_rewind(a, scratch_mark)
                raise AtomicFilePosixError.InvalidDirectoryDescriptor
            result: AtomicFilePosixObservation = AtomicFilePosixObservation{parent_device: parent_before.device.u64(), parent_inode: parent_before.inode, parent_descriptor_token: parent_fd.u64() + 1u64, destination: destination, link_count: link_count, private_mode: private_mode}
            arena_rewind(a, scratch_mark)
            return result


        # Compare the current leaf with caller-owned output bytes exactly, not
        # by digest alone. This is the no-op decision primitive for the future
        # AtomicFileSession publisher; the caller still supplies its exclusive
        # directory-mutation policy around comparison and publication.
        def atomic_file_bytes_equal_at(a: mutable Arena&, parent_fd: int, leaf_name: cstr, expected: darray[u8]&, byte_limit: usize = EsFileReadAtPosix::Limits::MAX_BYTES) -> bool error[AtomicFilePosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            scratch_mark: ArenaMark = arena_snapshot(a)
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if parent_fd < 0
            raise AtomicFilePosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(leaf_name)
            raise AtomicFilePosixError.DestinationTooLarge(leaf_name) if byte_limit == 0 or byte_limit > EsFileReadAtPosix::Limits::MAX_BYTES or expected.count > byte_limit

            parent_before: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_before) or (parent_before.mode & DarwinStatMode::MASK) != DarwinStatMode::DIRECTORY

            before: mutable ElisascriptStat = ElisascriptStat{}
            if not atomic_file_posix_stat_name(parent_fd, leaf_name, before):
                errno: mutable i32& = elisascript_posix_errno()
                raise AtomicFilePosixError.DestinationStatFailed(leaf_name) if errno[0] != AtomicFilePosixErrno::ENOENT
                parent_after_absent: mutable ElisascriptStat = ElisascriptStat{}
                raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_after_absent) or not atomic_file_posix_parent_matches(parent_before, parent_after_absent)
                arena_rewind(a, scratch_mark)
                return false

            raise AtomicFilePosixError.DestinationNotRegular(leaf_name) if (before.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR
            raise AtomicFilePosixError.DestinationTooLarge(leaf_name) if before.size < 0 or before.size.usize().i64() != before.size or before.size.usize() > byte_limit
            observed: mutable darray[u8] = []
            catch read_regular_file_at(a, parent_fd, leaf_name, byte_limit):
                ok bytes:
                    observed <- bytes
                error failure:
                    arena_rewind(a, scratch_mark)
                    raise AtomicFilePosixError.DestinationReadFailed(leaf_name)

            after: mutable ElisascriptStat = ElisascriptStat{}
            if not atomic_file_posix_stat_name(parent_fd, leaf_name, after):
                arena_rewind(a, scratch_mark)
                raise AtomicFilePosixError.DestinationStatFailed(leaf_name)
            if not atomic_file_posix_snapshot_matches(before, after) or observed.count != before.size.usize():
                arena_rewind(a, scratch_mark)
                raise AtomicFilePosixError.DestinationReadFailed(leaf_name)
            parent_after: mutable ElisascriptStat = ElisascriptStat{}
            if not atomic_file_posix_stat_descriptor(parent_fd, parent_after) or not atomic_file_posix_parent_matches(parent_before, parent_after):
                arena_rewind(a, scratch_mark)
                raise AtomicFilePosixError.InvalidDirectoryDescriptor
            equal: bool = atomic_file_posix_bytes_equal(observed, expected)
            arena_rewind(a, scratch_mark)
            return equal


        # Capture Compare evidence from the sealed stage and current
        # destination. Exact stage/destination comparisons are tied to their
        # stable identity snapshots; the caller must hold the directory lease
        # across this operation and the following commit/cleanup decision.
        def compare_atomic_file_stage(a: mutable Arena&, session: mutable AtomicFileSession&, parent_fd: int, stage_leaf: cstr, destination_leaf: cstr, staged_contents: darray[u8]&) -> AtomicFileIdentity error[AtomicFilePosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            catch validate_atomic_file_session(session):
                ok:
                    pass
                error failure:
                    raise AtomicFilePosixError.StageNotReady
            raise AtomicFilePosixError.StageNotReady if session.state != AtomicFileState.Ready or parent_fd < 0 or session.plan.parent_identity != parent_fd.u64() + 1u64 or not atomic_file_posix_session_stage_identity_matches(session)
            raise AtomicFilePosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(stage_leaf) or not elisascript_posix_leaf_name_valid(destination_leaf)
            raise AtomicFilePosixError.StageNotReady if not atomic_file_posix_path_leaf_matches(session.plan.staging_path, stage_leaf) or not atomic_file_posix_path_leaf_matches(session.plan.destination_path, destination_leaf)
            raise AtomicFilePosixError.StageContentMismatch if staged_contents.count != session.staged_bytes or staged_contents.count > session.plan.max_content_bytes
            digest_mark: ArenaMark = arena_snapshot(a)
            supplied_digest: HashDigest = atomic_file_posix_digest(staged_contents)
            supplied_digest_matches: bool = atomic_file_posix_digest_equal(supplied_digest, session.staged_identity.digest)
            arena_rewind(a, digest_mark)
            raise AtomicFilePosixError.StageContentMismatch if not supplied_digest_matches

            stage_before: AtomicFilePosixObservation = try observe_atomic_file_at(a, parent_fd, stage_leaf, session.plan.max_content_bytes)
            raise AtomicFilePosixError.StageContentMismatch if not atomic_file_posix_identity_equal(stage_before.destination, session.staged_identity) or stage_before.link_count != 1 or not stage_before.private_mode
            stage_content_matches: bool = try atomic_file_bytes_equal_at(a, parent_fd, stage_leaf, staged_contents, session.plan.max_content_bytes)
            raise AtomicFilePosixError.StageContentMismatch if not stage_content_matches

            destination_before: AtomicFilePosixObservation = try observe_atomic_file_at(a, parent_fd, destination_leaf, EsFileReadAtPosix::Limits::MAX_BYTES)
            destination_contents_match: bool = try atomic_file_bytes_equal_at(a, parent_fd, destination_leaf, staged_contents, EsFileAtomic::Limits::CONTENT_BYTES)
            destination_after: AtomicFilePosixObservation = try observe_atomic_file_at(a, parent_fd, destination_leaf, EsFileReadAtPosix::Limits::MAX_BYTES)
            raise AtomicFilePosixError.DestinationChanged if not atomic_file_posix_identity_equal(destination_before.destination, destination_after.destination)

            stage_after: AtomicFilePosixObservation = try observe_atomic_file_at(a, parent_fd, stage_leaf, session.plan.max_content_bytes)
            raise AtomicFilePosixError.StageContentMismatch if not atomic_file_posix_identity_equal(stage_after.destination, session.staged_identity) or stage_after.link_count != 1 or not stage_after.private_mode
            catch advance_atomic_file(session, AtomicFileEvent.Compare, identity: destination_after.destination, exact_contents_equal: destination_contents_match):
                ok state:
                    return destination_after.destination
                error failure:
                    raise AtomicFilePosixError.DestinationChanged if failure == AtomicFileError.DestinationChanged
                    raise AtomicFilePosixError.StageNotReady


        # Commit only from a completed non-no-op Compare transition. The
        # destination and stage receipts are recaptured immediately before the
        # one renameat attempt. Every rename error and every post-rename proof
        # failure remains PublishedUncertain; callers must recover by observing
        # the destination instead of retrying the rename blindly.
        def commit_atomic_file_stage(a: mutable Arena&, session: mutable AtomicFileSession&, parent_fd: int, stage_leaf: cstr, destination_leaf: cstr) -> AtomicFileIdentity error[AtomicFilePosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            catch validate_atomic_file_session(session):
                ok:
                    pass
                error failure:
                    raise AtomicFilePosixError.StageNotReady
            raise AtomicFilePosixError.StageNotReady if session.state != AtomicFileState.Ready or not session.comparison_acknowledged or session.contents_equal or parent_fd < 0 or session.plan.parent_identity != parent_fd.u64() + 1u64 or not atomic_file_posix_session_stage_identity_matches(session)
            raise AtomicFilePosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(stage_leaf) or not elisascript_posix_leaf_name_valid(destination_leaf)
            raise AtomicFilePosixError.StageNotReady if not atomic_file_posix_path_leaf_matches(session.plan.staging_path, stage_leaf) or not atomic_file_posix_path_leaf_matches(session.plan.destination_path, destination_leaf)

            stage_before: AtomicFilePosixObservation = try observe_atomic_file_at(a, parent_fd, stage_leaf, session.plan.max_content_bytes)
            raise AtomicFilePosixError.StageContentMismatch if not atomic_file_posix_identity_equal(stage_before.destination, session.staged_identity) or stage_before.link_count != 1 or not stage_before.private_mode
            destination_before: AtomicFilePosixObservation = try observe_atomic_file_at(a, parent_fd, destination_leaf, EsFileReadAtPosix::Limits::MAX_BYTES)
            raise AtomicFilePosixError.DestinationChanged if not atomic_file_posix_identity_equal(destination_before.destination, session.destination_snapshot)
            catch advance_atomic_file(session, AtomicFileEvent.Commit):
                ok state:
                    pass
                error failure:
                    raise AtomicFilePosixError.StageNotReady

            rename_status: mutable int = -1
            catch elisascript_posix_renameat(parent_fd, stage_leaf, parent_fd, destination_leaf):
                ok status:
                    rename_status <- status
                error failure:
                    _ = atomic_file_posix_mark_publish_uncertain(session)
                    raise AtomicFilePosixError.RenameOutcomeUnknown
            if rename_status != 0:
                _ = atomic_file_posix_mark_publish_uncertain(session)
                raise AtomicFilePosixError.RenameOutcomeUnknown

            if session.plan.require_directory_sync:
                if not atomic_file_posix_sync_descriptor(parent_fd):
                    _ = atomic_file_posix_mark_publish_uncertain(session)
                    raise AtomicFilePosixError.DirectorySyncFailed
                catch advance_atomic_file(session, AtomicFileEvent.DirectorySync):
                    ok state:
                        pass
                    error failure:
                        _ = atomic_file_posix_mark_publish_uncertain(session)
                        raise AtomicFilePosixError.DirectorySyncFailed

            published_observation: mutable AtomicFilePosixObservation = AtomicFilePosixObservation{parent_device: 0, parent_inode: 0, parent_descriptor_token: 0, destination: AtomicFileIdentity{}, link_count: 0, private_mode: false}
            catch observe_atomic_file_at(a, parent_fd, destination_leaf, session.plan.max_content_bytes):
                ok observed:
                    published_observation <- observed
                error failure:
                    _ = atomic_file_posix_mark_publish_uncertain(session)
                    raise AtomicFilePosixError.RenameOutcomeUnknown
            published: AtomicFileIdentity = published_observation.destination
            if not atomic_file_posix_identity_equal(published, session.staged_identity) or published_observation.link_count != 1 or not published_observation.private_mode:
                _ = atomic_file_posix_mark_publish_uncertain(session)
                raise AtomicFilePosixError.RenameOutcomeUnknown

            catch advance_atomic_file(session, AtomicFileEvent.CommitAck, identity: published):
                ok state:
                    return published
                error failure:
                    _ = atomic_file_posix_mark_publish_uncertain(session)
                    raise AtomicFilePosixError.RenameOutcomeUnknown


        # Remove an unsealed partial stage after a failed or cancelled write.
        # The caller retains ownership of any open stage descriptor and must
        # hold the exclusive directory lease; this never hashes partial data.
        def cleanup_unsealed_atomic_file_stage(session: mutable AtomicFileSession&, parent_fd: int, stage_handle: mutable AtomicFilePosixStageHandle&, stage_leaf: cstr) -> AtomicFileState error[AtomicFilePosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            catch validate_atomic_file_session(session):
                ok:
                    pass
                error failure:
                    raise AtomicFilePosixError.StageNotReady
            stage_fd: int = stage_handle.descriptor
            expected: AtomicFilePosixStageProof = stage_handle.proof
            cleanup_state: bool = session.state == AtomicFileState.FailedPendingCleanup or session.state == AtomicFileState.CancelledPendingCleanup
            raise AtomicFilePosixError.StageNotReady if not cleanup_state or session.staged_identity.observed or parent_fd < 0 or stage_fd < 0 or stage_fd == parent_fd or not atomic_file_posix_session_stage_admission_matches(session, expected)
            raise AtomicFilePosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(stage_leaf)
            raise AtomicFilePosixError.StageNotReady if not atomic_file_posix_path_leaf_matches(session.plan.staging_path, stage_leaf)
            raise AtomicFilePosixError.StageNotReady if expected.owner_token != session.plan.owner_token or expected.parent_descriptor_token != session.plan.parent_identity or expected.parent_descriptor_token != parent_fd.u64() + 1u64 or expected.stage_descriptor_token != stage_fd.u64() + 1u64 or expected.link_count != 1

            parent_before: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_before) or (parent_before.mode & DarwinStatMode::MASK) != DarwinStatMode.DIRECTORY or parent_before.device.u64() != expected.parent_device or parent_before.inode != expected.parent_inode

            stage_descriptor_before: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.StageStatFailed if not atomic_file_posix_stat_descriptor(stage_fd, stage_descriptor_before)
            raise AtomicFilePosixError.StageContentMismatch if stage_descriptor_before.device.u64() != expected.stage_device or stage_descriptor_before.inode != expected.stage_inode or stage_descriptor_before.device != parent_before.device or (stage_descriptor_before.mode & DarwinStatMode::MASK) != DarwinStatMode.REGULAR or not atomic_file_posix_private(stage_descriptor_before) or stage_descriptor_before.link_count > 1u16

            stage_before: mutable ElisascriptStat = ElisascriptStat{}
            if not atomic_file_posix_stat_name(parent_fd, stage_leaf, stage_before):
                errno: mutable i32& = elisascript_posix_errno()
                raise AtomicFilePosixError.StageCleanupFailed if errno[0] != AtomicFilePosixErrno::ENOENT
                stage_descriptor_after_absent: mutable ElisascriptStat = ElisascriptStat{}
                raise AtomicFilePosixError.StageStatFailed if not atomic_file_posix_stat_descriptor(stage_fd, stage_descriptor_after_absent)
                raise AtomicFilePosixError.StageContentMismatch if not atomic_file_posix_same_inode(stage_descriptor_before, stage_descriptor_after_absent) or stage_descriptor_after_absent.link_count != 0u16
                parent_after_absent: mutable ElisascriptStat = ElisascriptStat{}
                raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_after_absent) or not atomic_file_posix_parent_matches(parent_before, parent_after_absent)
                raise AtomicFilePosixError.DirectorySyncFailed if not atomic_file_posix_sync_cleanup_directory(session, parent_fd)
                catch advance_atomic_file(session, AtomicFileEvent.CleanupAck):
                    ok state:
                        close_status: int = elisascript_posix_close(stage_fd)
                        stage_handle.descriptor <- -1
                        stage_handle.close_status <- close_status
                        raise AtomicFilePosixError.StageCloseFailed(close_status) if close_status != 0
                        return state
                    error failure:
                        raise AtomicFilePosixError.StageNotReady

            raise AtomicFilePosixError.StageContentMismatch if stage_before.device.u64() != expected.stage_device or stage_before.inode != expected.stage_inode or stage_before.device != parent_before.device or (stage_before.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR or not atomic_file_posix_private(stage_before) or stage_before.link_count != 1u16
            raise AtomicFilePosixError.StageContentMismatch if not atomic_file_posix_same_inode(stage_descriptor_before, stage_before)
            raise AtomicFilePosixError.StageContentMismatch if stage_descriptor_before.link_count != 1u16
            stage_again: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.StageStatFailed if not atomic_file_posix_stat_name(parent_fd, stage_leaf, stage_again)
            raise AtomicFilePosixError.StageContentMismatch if not atomic_file_posix_same_inode(stage_before, stage_again) or (stage_again.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR or not atomic_file_posix_private(stage_again) or stage_again.link_count != 1u16

            remove_status: mutable int = -1
            catch elisascript_posix_unlinkat_leaf(parent_fd, stage_leaf):
                ok status:
                    remove_status <- status
                error failure:
                    raise AtomicFilePosixError.StageCleanupFailed
            raise AtomicFilePosixError.StageCleanupFailed if remove_status != 0

            stage_after: mutable ElisascriptStat = ElisascriptStat{}
            if atomic_file_posix_stat_name(parent_fd, stage_leaf, stage_after):
                raise AtomicFilePosixError.StageCleanupFailed
            errno: mutable i32& = elisascript_posix_errno()
            raise AtomicFilePosixError.StageCleanupFailed if errno[0] != AtomicFilePosixErrno::ENOENT
            parent_after: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_after) or not atomic_file_posix_parent_matches(parent_before, parent_after)
            raise AtomicFilePosixError.DirectorySyncFailed if not atomic_file_posix_sync_cleanup_directory(session, parent_fd)
            catch advance_atomic_file(session, AtomicFileEvent.CleanupAck):
                ok state:
                    close_status: int = elisascript_posix_close(stage_fd)
                    stage_handle.descriptor <- -1
                    stage_handle.close_status <- close_status
                    raise AtomicFilePosixError.StageCloseFailed(close_status) if close_status != 0
                    return state
                error failure:
                    raise AtomicFilePosixError.StageNotReady


        # Remove a closed staging entry only when its current no-follow
        # identity still matches the sealed session receipt. Under the caller's
        # exclusive directory lease, an already-absent stage is reconciled as
        # completed cleanup; unlink errors remain pending for a later recheck.
        def cleanup_atomic_file_stage(a: mutable Arena&, session: mutable AtomicFileSession&, parent_fd: int, stage_leaf: cstr, expected: AtomicFilePosixStageProof) -> AtomicFileState error[AtomicFilePosixError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            catch validate_atomic_file_session(session):
                ok:
                    pass
                error failure:
                    raise AtomicFilePosixError.StageNotReady
            cleanup_state: bool = session.state == AtomicFileState.UnchangedPendingCleanup or session.state == AtomicFileState.FailedPendingCleanup or session.state == AtomicFileState.CancelledPendingCleanup or session.state == AtomicFileState.RolledBackPendingCleanup or session.state == AtomicFileState.PublishedUncertain
            raise AtomicFilePosixError.StageNotReady if not cleanup_state or not session.staged_identity.observed or not session.staged_identity.present or parent_fd < 0 or not atomic_file_posix_session_stage_identity_matches(session)
            raise AtomicFilePosixError.InvalidLeafName if not elisascript_posix_leaf_name_valid(stage_leaf)
            raise AtomicFilePosixError.StageNotReady if not atomic_file_posix_path_leaf_matches(session.plan.staging_path, stage_leaf)
            raise AtomicFilePosixError.StageNotReady if expected.owner_token != session.plan.owner_token or expected.parent_descriptor_token != session.plan.parent_identity or expected.parent_descriptor_token != parent_fd.u64() + 1u64 or expected.stage_descriptor_token == 0 or expected.link_count != 1 or expected.stage_device != session.stage_admission.stage_device or expected.stage_inode != session.stage_admission.stage_inode or expected.stage_descriptor_token != session.stage_admission.stage_descriptor_token
            raise AtomicFilePosixError.StageContentMismatch if expected.stage_device != session.staged_identity.volume_id or expected.stage_inode != session.staged_identity.object_id

            parent_before: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_before) or (parent_before.mode & DarwinStatMode::MASK) != DarwinStatMode::DIRECTORY or parent_before.device.u64() != expected.parent_device or parent_before.inode != expected.parent_inode

            stage_stat: mutable ElisascriptStat = ElisascriptStat{}
            if not atomic_file_posix_stat_name(parent_fd, stage_leaf, stage_stat):
                errno: mutable i32& = elisascript_posix_errno()
                raise AtomicFilePosixError.StageCleanupFailed if errno[0] != AtomicFilePosixErrno::ENOENT
                parent_after_absent: mutable ElisascriptStat = ElisascriptStat{}
                raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_after_absent) or not atomic_file_posix_parent_matches(parent_before, parent_after_absent)
                raise AtomicFilePosixError.DirectorySyncFailed if not atomic_file_posix_sync_cleanup_directory(session, parent_fd)
                catch advance_atomic_file(session, AtomicFileEvent.CleanupAck):
                    ok state:
                        return state
                    error failure:
                        raise AtomicFilePosixError.StageNotReady

            stage_before: AtomicFilePosixObservation = try observe_atomic_file_at(a, parent_fd, stage_leaf, session.plan.max_content_bytes)
            raise AtomicFilePosixError.StageContentMismatch if not atomic_file_posix_identity_equal(stage_before.destination, session.staged_identity) or stage_before.link_count != 1 or not stage_before.private_mode
            raise AtomicFilePosixError.StageContentMismatch if stage_stat.device.u64() != expected.stage_device or stage_stat.inode != expected.stage_inode or stage_stat.link_count != 1u16 or not atomic_file_posix_private(stage_stat)
            stage_again: AtomicFilePosixObservation = try observe_atomic_file_at(a, parent_fd, stage_leaf, session.plan.max_content_bytes)
            raise AtomicFilePosixError.StageContentMismatch if not atomic_file_posix_identity_equal(stage_before.destination, stage_again.destination) or stage_again.link_count != 1 or not stage_again.private_mode

            remove_status: mutable int = -1
            catch elisascript_posix_unlinkat_leaf(parent_fd, stage_leaf):
                ok status:
                    remove_status <- status
                error failure:
                    raise AtomicFilePosixError.StageCleanupFailed
            raise AtomicFilePosixError.StageCleanupFailed if remove_status != 0

            stage_after: mutable ElisascriptStat = ElisascriptStat{}
            if atomic_file_posix_stat_name(parent_fd, stage_leaf, stage_after):
                raise AtomicFilePosixError.StageCleanupFailed
            errno: mutable i32& = elisascript_posix_errno()
            raise AtomicFilePosixError.StageCleanupFailed if errno[0] != AtomicFilePosixErrno::ENOENT
            parent_after: mutable ElisascriptStat = ElisascriptStat{}
            raise AtomicFilePosixError.InvalidDirectoryDescriptor if not atomic_file_posix_stat_descriptor(parent_fd, parent_after) or not atomic_file_posix_parent_matches(parent_before, parent_after)
            raise AtomicFilePosixError.DirectorySyncFailed if not atomic_file_posix_sync_cleanup_directory(session, parent_fd)
            catch advance_atomic_file(session, AtomicFileEvent.CleanupAck):
                ok state:
                    return state
                error failure:
                    raise AtomicFilePosixError.StageNotReady
