# Parent-side compiler/test preparation, not a host executor or source builtin.
# The caller supplies one sealed snapshot and stable project/temp context for
# both stages. Returned argv/env/search buffers own their bytes independently.
include "ui_codec_build_model.elisa"
include "process_launch_storage.elisa"

module EsUiCodecLaunch:
    public:
        error LaunchPlanError:
            InvalidPhase


        def prepare(ambient: EsEnvironment::EnvironmentSnapshot&, phase: EsUiCodecBuild::Phase, project_root: sview, temporary_root: sview, absent_path: EsProcessEnvironmentPlan::AbsentPath = EsProcessEnvironmentPlan::AbsentPath{}, max_storage_bytes: usize = EsProcessLaunchStorage::Limits::STORAGE_BYTES) -> EsProcessLaunchStorage::Prepared error[LaunchPlanError, EsEnvironment::EnvironmentContractError, EsUiCodecBuild::RecipeError, EsProcessLaunchStorage::StorageError, EsProcessEnvironmentPlan::PlanError] can[Memory.Allocate, Abort.Panic]:
            raise LaunchPlanError.InvalidPhase if phase != EsUiCodecBuild::Phase.Compile and phase != EsUiCodecBuild::Phase.Run
            _ = try EsEnvironment::validate_environment_snapshot(ambient)
            raise EsProcessEnvironmentPlan::PlanError.AmbientNotSealed if ambient.state != EsEnvironment::EnvironmentState.Sealed
            configured: mutable sview = ""
            present: mutable bool = false
            for entry in ambient.entries |configured, present|:
                if entry.name == "CC" and entry.present:
                    configured <- entry.value
                    present <- true
            # Derive presence/value together from the validated snapshot, not
            # independent caller flags or a swallowed getenv failure.
            policy: EsUiCodecBuild::CompilerEnvironment = try EsUiCodecBuild::compiler_environment(configured, present)
            planned: EsUiCodecBuild::Recipe = try EsUiCodecBuild::recipe(project_root, temporary_root, configured)
            overlay: mutable darray[EsEnvironment::EnvironmentEntry] = []
            overlay.push(EsEnvironment::EnvironmentEntry{name: "CC", value: policy.cc_value}) if policy.set_cc
            match phase:
                EsUiCodecBuild::Phase.Compile:
                    return try EsProcessLaunchStorage::prepare(ambient, overlay, planned.compiler, planned.arguments, absent_path, max_storage_bytes)
                EsUiCodecBuild::Phase.Run:
                    return try EsProcessLaunchStorage::prepare(ambient, overlay, planned.executable, [], absent_path, max_storage_bytes)
                _:
                    raise LaunchPlanError.InvalidPhase
