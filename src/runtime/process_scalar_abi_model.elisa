# Selected POSIX host profile: C int and pid_t are signed 32-bit carriers.
# This is scalar admission, not native ABI or pointer-lifetime qualification.
module EsProcessScalarAbi:
    public:
        const module Limits:
            MIN: i64 = -2147483648
            MAX: i64 = 2147483647
            # Distinct from native -1, so stale errno cannot look like EINTR.
            REJECTED: int = -2


        def fits(value: i64) -> bool:
            return value >= Limits::MIN and value <= Limits::MAX


        # For these POSIX scalar APIs only native -1 admits an errno read.
        # The -2 bridge rejection did not perform a syscall or update errno.
        def native_errno_failure(result: i64) -> bool:
            return result == -1


        # Called after a permitted errno sample, not instead of the result gate
        # that must precede reading the host slot. Errno zero/negative is not a
        # known native failure and cannot populate a native-error receipt.
        def native_error_observation(result: i64, code: i32) -> bool:
            return native_errno_failure(result) and code > 0i32


        # POSIX exit status is the low eight bits, even for negative inputs.
        def exit_byte(status: i64) -> i32:
            return (status & 255i64).i32()
