# Bounded archive-entry admission and safe extraction planning.
#
# Tar/zip adapters must validate every entry through this model before touching
# the destination filesystem. Paths are relative, normalized segments; links
# are an explicit policy choice, never an implicit extraction capability.

module EsArchive:
    public:
        const module Limits:
            ENTRIES: usize = 1048576
            PATH_BYTES: usize = 4096
            ENTRY_BYTES: usize = 1073741824
            TOTAL_BYTES: usize = 1099511627776
            INDEX_SLOTS: usize = 2097152
            INDEX_MINIMUM: usize = 8
            INDEX_PROBES: usize = 64


        const enum ArchiveKind of u8:
            Tar
            Zip


        const enum ArchiveLinkPolicy of u8:
            Reject
            Preserve


        const enum ArchiveOverwritePolicy of u8:
            Fail
            Replace


        const enum ArchiveSessionState of u8:
            Planned
            Extracting
            Committed
            Failed
            Cancelled


        const enum ArchiveEvent of u8:
            Begin
            Commit
            Fail
            Cancel


        const enum ArchiveEntryKind of u8:
            File
            Directory
            Symlink
            Hardlink


        const enum ArchiveEntryState of u8:
            Accepted
            Skipped


        struct ArchivePolicy:
            kind: ArchiveKind = ArchiveKind.Tar
            max_entries: usize = Limits::ENTRIES
            max_path_bytes: usize = Limits::PATH_BYTES
            max_entry_bytes: usize = Limits::ENTRY_BYTES
            max_total_bytes: usize = Limits::TOTAL_BYTES
            links: ArchiveLinkPolicy = ArchiveLinkPolicy.Reject
            overwrite: ArchiveOverwritePolicy = ArchiveOverwritePolicy.Fail


        struct ArchiveEntry:
            entry_id: u64
            path: sview
            kind: ArchiveEntryKind
            size: usize = 0
            target: sview = ""
            state: ArchiveEntryState = ArchiveEntryState.Accepted


        struct ArchiveSession:
            policy: ArchivePolicy
            state: ArchiveSessionState = ArchiveSessionState.Planned
            entries: darray[ArchiveEntry] = []
            # ID slots index every entry. Path slots index accepted entries
            # only; each table stores entry_index + 1, with zero as empty.
            id_index_slots: darray[usize] = []
            path_index_slots: darray[usize] = []
            total_bytes: usize = 0
            skipped_entries: usize = 0


        error ArchiveError:
            InvalidPolicy
            InvalidKind
            InvalidLinkPolicy
            InvalidOverwritePolicy
            InvalidState
            InvalidEvent
            InvalidEntryKind
            InvalidEntryState
            InvalidId
            DuplicateEntryId
            DuplicatePath
            EntryLimitExceeded
            PathLimitExceeded
            EmptyPath
            EmbeddedNul
            AbsolutePath
            TraversalPath
            BackslashPath
            EntryLimitBytesExceeded
            TotalLimitBytesExceeded
            LinkRejected
            TargetInvalid
            AccountingInvalid
            IndexProbeLimitExceeded
            InvalidTransition


    private:
        def archive_kind_valid(kind: ArchiveKind) -> bool:
            return kind in {ArchiveKind.Tar, ArchiveKind.Zip}


        def archive_link_policy_valid(policy: ArchiveLinkPolicy) -> bool:
            return policy in {ArchiveLinkPolicy.Reject, ArchiveLinkPolicy.Preserve}


        def archive_overwrite_policy_valid(policy: ArchiveOverwritePolicy) -> bool:
            return policy in {ArchiveOverwritePolicy.Fail, ArchiveOverwritePolicy.Replace}


        def archive_state_valid(state: ArchiveSessionState) -> bool:
            return state in {ArchiveSessionState.Planned, ArchiveSessionState.Extracting, ArchiveSessionState.Committed, ArchiveSessionState.Failed, ArchiveSessionState.Cancelled}


        def archive_event_valid(event: ArchiveEvent) -> bool:
            return event in {ArchiveEvent.Begin, ArchiveEvent.Commit, ArchiveEvent.Fail, ArchiveEvent.Cancel}


        def archive_entry_kind_valid(kind: ArchiveEntryKind) -> bool:
            return kind in {ArchiveEntryKind.File, ArchiveEntryKind.Directory, ArchiveEntryKind.Symlink, ArchiveEntryKind.Hardlink}


        def archive_entry_state_valid(state: ArchiveEntryState) -> bool:
            return state in {ArchiveEntryState.Accepted, ArchiveEntryState.Skipped}


        def archive_policy_valid(policy: ArchivePolicy) -> bool:
            return archive_kind_valid(policy.kind) and policy.max_entries != 0 and policy.max_entries <= Limits::ENTRIES and policy.max_path_bytes != 0 and policy.max_path_bytes <= Limits::PATH_BYTES and policy.max_entry_bytes != 0 and policy.max_entry_bytes <= Limits::ENTRY_BYTES and policy.max_total_bytes != 0 and policy.max_total_bytes <= Limits::TOTAL_BYTES and archive_link_policy_valid(policy.links) and archive_overwrite_policy_valid(policy.overwrite)


        def archive_segment_safe(segment: sview) -> bool:
            return segment != "" and segment != "." and segment != ".."


        def archive_trim_trailing_separators(path: sview) -> usize:
            finish: mutable usize = sview_len(path)
            while finish > 1 and sview_at(path, finish - 1) == 47:
                finish <- finish - 1
            return finish


        const enum ArchivePathIssue of u8:
            Safe
            Empty
            TooLong
            EmbeddedNul
            Absolute
            Backslash
            Traversal


        def archive_path_issue(path: sview, policy: ArchivePolicy) -> ArchivePathIssue:
            raw_length: usize = sview_len(path)
            return ArchivePathIssue.Empty if raw_length == 0
            return ArchivePathIssue.TooLong if raw_length >= policy.max_path_bytes
            return ArchivePathIssue.EmbeddedNul if sview_contains_byte(path, 0)
            length: usize = archive_trim_trailing_separators(path)
            return ArchivePathIssue.Absolute if sview_at(path, 0) == 47 or sview_at(path, 0) == 92 or length > 1 and sview_at(path, 1) == 58
            start: mutable usize = 0
            while start < length:
                cursor: mutable usize = start
                while cursor < length and sview_at(path, cursor) != 47:
                    return ArchivePathIssue.Backslash if sview_at(path, cursor) == 92
                    cursor <- cursor + 1
                return ArchivePathIssue.Traversal if not archive_segment_safe(path[start:cursor])
                start <- cursor + 1
            return ArchivePathIssue.Safe


        def archive_relative_path_safe(path: sview, policy: ArchivePolicy) -> bool:
            return archive_path_issue(path, policy) == ArchivePathIssue.Safe


        def archive_paths_equivalent(left: sview, right: sview) -> bool:
            left_end: usize = archive_trim_trailing_separators(left)
            right_end: usize = archive_trim_trailing_separators(right)
            return left_end == right_end and left[0:left_end] == right[0:right_end]


        const module Hash:
            FNV_OFFSET: u64 = 14695981039346656037u64
            FNV_PRIME: u64 = 1099511628211u64


        def archive_hash_entry_id(entry_id: u64) -> u64:
            hash: mutable u64 = Hash::FNV_OFFSET
            for shift in 0..<8 |entry_id, hash|:
                byte: u8 = ((entry_id >> (shift * 8)) & 255u64).u8()
                hash <- EsHash::hash_wrapping_multiply_u64(hash ^ byte.u64(), Hash::FNV_PRIME)
            return hash


        def archive_hash_path(path: sview) -> u64:
            hash: mutable u64 = Hash::FNV_OFFSET
            finish: usize = archive_trim_trailing_separators(path)
            for offset in 0..<finish |path, hash|:
                hash <- EsHash::hash_wrapping_multiply_u64(hash ^ sview_at(path, offset).u64(), Hash::FNV_PRIME)
            return hash


        def archive_index_capacity_limit(max_entries: usize) -> usize:
            required: usize = max_entries * 2
            capacity: mutable usize = Limits::INDEX_MINIMUM
            while capacity < required:
                capacity <- capacity * 2
            return capacity


        def archive_index_shape_valid(session: ArchiveSession&) -> bool:
            if session.id_index_slots.count == 0:
                return session.entries.count == 0 and session.path_index_slots.count == 0
            return false if session.id_index_slots.count != session.path_index_slots.count or session.id_index_slots.count > Limits::INDEX_SLOTS
            return false if session.id_index_slots.count < Limits::INDEX_MINIMUM or session.entries.count * 2 > session.id_index_slots.count
            return (session.id_index_slots.count & (session.id_index_slots.count - 1)) == 0


        def archive_entry_id_index(session: ArchiveSession&, entry_id: u64) -> usize error[ArchiveError]:
            return session.entries.count if session.id_index_slots.count == 0
            slot: mutable usize = (archive_hash_entry_id(entry_id) % session.id_index_slots.count.u64()).usize()
            probe_count: usize = Limits::INDEX_PROBES if session.id_index_slots.count > Limits::INDEX_PROBES else session.id_index_slots.count
            for _ in 0..<probe_count |session, entry_id, slot|:
                stored: usize = session.id_index_slots[slot]
                return session.entries.count if stored == 0
                entry_index: usize = stored - 1
                raise ArchiveError.AccountingInvalid if entry_index >= session.entries.count
                return entry_index if session.entries[entry_index].entry_id == entry_id
                slot <- 0 if slot + 1 == session.id_index_slots.count else slot + 1
            raise ArchiveError.IndexProbeLimitExceeded if session.id_index_slots.count > probe_count
            raise ArchiveError.AccountingInvalid


        def archive_path_index(entries: darray[ArchiveEntry], slots: darray[usize], path: sview) -> usize error[ArchiveError]:
            return entries.count if slots.count == 0
            slot: mutable usize = (archive_hash_path(path) % slots.count.u64()).usize()
            probe_count: usize = Limits::INDEX_PROBES if slots.count > Limits::INDEX_PROBES else slots.count
            for _ in 0..<probe_count |entries, slots, path, slot|:
                stored: usize = slots[slot]
                return entries.count if stored == 0
                entry_index: usize = stored - 1
                raise ArchiveError.AccountingInvalid if entry_index >= entries.count
                return entry_index if entries[entry_index].state == ArchiveEntryState.Accepted and archive_paths_equivalent(entries[entry_index].path, path)
                slot <- 0 if slot + 1 == slots.count else slot + 1
            raise ArchiveError.IndexProbeLimitExceeded if slots.count > probe_count
            raise ArchiveError.AccountingInvalid


        def archive_place_id_index(entries: darray[ArchiveEntry], slots: mutable darray[usize]&, entry_index: usize) -> void error[ArchiveError]:
            raise ArchiveError.AccountingInvalid if slots.count == 0 or entry_index >= entries.count
            slot: mutable usize = (archive_hash_entry_id(entries[entry_index].entry_id) % slots.count.u64()).usize()
            probe_count: usize = Limits::INDEX_PROBES if slots.count > Limits::INDEX_PROBES else slots.count
            for _ in 0..<probe_count |entries, slots, entry_index, slot|:
                if slots[slot] == 0:
                    slots[slot] <- entry_index + 1
                    return
                stored_index: usize = slots[slot] - 1
                raise ArchiveError.AccountingInvalid if stored_index >= entries.count
                raise ArchiveError.DuplicateEntryId if entries[stored_index].entry_id == entries[entry_index].entry_id
                slot <- 0 if slot + 1 == slots.count else slot + 1
            raise ArchiveError.IndexProbeLimitExceeded if slots.count > probe_count
            raise ArchiveError.AccountingInvalid


        def archive_place_path_index(entries: darray[ArchiveEntry], slots: mutable darray[usize]&, entry_index: usize) -> void error[ArchiveError]:
            raise ArchiveError.AccountingInvalid if slots.count == 0 or entry_index >= entries.count or entries[entry_index].state != ArchiveEntryState.Accepted
            slot: mutable usize = (archive_hash_path(entries[entry_index].path) % slots.count.u64()).usize()
            probe_count: usize = Limits::INDEX_PROBES if slots.count > Limits::INDEX_PROBES else slots.count
            for _ in 0..<probe_count |entries, slots, entry_index, slot|:
                stored: usize = slots[slot]
                if stored == 0:
                    slots[slot] <- entry_index + 1
                    return
                stored_index: usize = stored - 1
                raise ArchiveError.AccountingInvalid if stored_index >= entries.count
                if entries[stored_index].state == ArchiveEntryState.Accepted and archive_paths_equivalent(entries[stored_index].path, entries[entry_index].path):
                    slots[slot] <- entry_index + 1
                    return
                slot <- 0 if slot + 1 == slots.count else slot + 1
            raise ArchiveError.IndexProbeLimitExceeded if slots.count > probe_count
            raise ArchiveError.AccountingInvalid


        def archive_ensure_index_capacity(session: mutable ArchiveSession&) -> void error[ArchiveError]:
            required: usize = (session.entries.count + 1) * 2
            capacity: mutable usize = Limits::INDEX_MINIMUM if session.id_index_slots.count == 0 else session.id_index_slots.count
            while capacity < required:
                capacity <- capacity * 2
            if capacity == session.id_index_slots.count:
                return
            raise ArchiveError.EntryLimitExceeded if capacity > archive_index_capacity_limit(session.policy.max_entries) or capacity > Limits::INDEX_SLOTS

            id_slots: mutable darray[usize] = []
            path_slots: mutable darray[usize] = []
            for offset in 0..<capacity |id_slots, path_slots|:
                id_slots.push(0)
                path_slots.push(0)
            for index in 0..<session.entries.count |session, id_slots, path_slots|:
                try archive_place_id_index(session.entries, id_slots, index)
                if session.entries[index].state == ArchiveEntryState.Accepted:
                    try archive_place_path_index(session.entries, path_slots, index)
            session.id_index_slots <- id_slots
            session.path_index_slots <- path_slots


        def validate_archive_header(session: ArchiveSession&) -> bool error[ArchiveError]:
            raise ArchiveError.InvalidPolicy if not archive_policy_valid(session.policy)
            raise ArchiveError.InvalidState if not archive_state_valid(session.state)
            raise ArchiveError.EntryLimitExceeded if session.entries.count > session.policy.max_entries
            raise ArchiveError.TotalLimitBytesExceeded if session.total_bytes > session.policy.max_total_bytes
            raise ArchiveError.AccountingInvalid if session.skipped_entries > session.entries.count
            raise ArchiveError.AccountingInvalid if session.state == ArchiveSessionState.Planned and (session.entries.count != 0 or session.total_bytes != 0 or session.skipped_entries != 0)
            return true


    public:
        def validate_archive_session(session: ArchiveSession&) -> bool error[ArchiveError]:
            try validate_archive_header(session)
            skipped: mutable usize = 0
            accounted: mutable usize = 0
            indexed_ids: mutable usize = 0
            indexed_paths: mutable usize = 0
            for index in 0..<session.entries.count |session|:
                entry: ArchiveEntry = session.entries[index]
                raise ArchiveError.InvalidId if entry.entry_id == 0
                raise ArchiveError.InvalidEntryKind if not archive_entry_kind_valid(entry.kind)
                raise ArchiveError.InvalidEntryState if not archive_entry_state_valid(entry.state)
                path_issue: ArchivePathIssue = archive_path_issue(entry.path, session.policy)
                raise ArchiveError.EmptyPath if path_issue == ArchivePathIssue.Empty
                raise ArchiveError.PathLimitExceeded if path_issue == ArchivePathIssue.TooLong
                raise ArchiveError.EmbeddedNul if path_issue == ArchivePathIssue.EmbeddedNul
                raise ArchiveError.AbsolutePath if path_issue == ArchivePathIssue.Absolute
                raise ArchiveError.BackslashPath if path_issue == ArchivePathIssue.Backslash
                raise ArchiveError.TraversalPath if path_issue == ArchivePathIssue.Traversal
                raise ArchiveError.EntryLimitBytesExceeded if entry.size > session.policy.max_entry_bytes
                raise ArchiveError.TargetInvalid if entry.kind != ArchiveEntryKind.Symlink and entry.kind != ArchiveEntryKind.Hardlink and entry.target != ""
                raise ArchiveError.TargetInvalid if (entry.kind == ArchiveEntryKind.Symlink or entry.kind == ArchiveEntryKind.Hardlink) and not archive_relative_path_safe(entry.target, session.policy)
                raise ArchiveError.LinkRejected if (entry.kind == ArchiveEntryKind.Symlink or entry.kind == ArchiveEntryKind.Hardlink) and session.policy.links == ArchiveLinkPolicy.Reject
                skipped <- skipped + 1 if entry.state == ArchiveEntryState.Skipped
                if entry.state == ArchiveEntryState.Accepted:
                    raise ArchiveError.TotalLimitBytesExceeded if accounted > session.policy.max_total_bytes
                    raise ArchiveError.TotalLimitBytesExceeded if entry.size > session.policy.max_total_bytes - accounted
                accounted <- accounted + entry.size if entry.state == ArchiveEntryState.Accepted
            raise ArchiveError.AccountingInvalid if skipped != session.skipped_entries or accounted != session.total_bytes
            raise ArchiveError.AccountingInvalid if not archive_index_shape_valid(session)
            for stored in session.id_index_slots:
                if stored != 0:
                    entry_index: usize = stored - 1
                    raise ArchiveError.AccountingInvalid if entry_index >= session.entries.count
                    indexed_entry: usize = try archive_entry_id_index(session, session.entries[entry_index].entry_id)
                    raise ArchiveError.AccountingInvalid if indexed_entry != entry_index
                    indexed_ids <- indexed_ids + 1
            for stored in session.path_index_slots:
                if stored != 0:
                    entry_index: usize = stored - 1
                    raise ArchiveError.AccountingInvalid if entry_index >= session.entries.count
                    raise ArchiveError.AccountingInvalid if session.entries[entry_index].state != ArchiveEntryState.Accepted
                    indexed_path: usize = try archive_path_index(session.entries, session.path_index_slots, session.entries[entry_index].path)
                    raise ArchiveError.AccountingInvalid if indexed_path != entry_index
                    indexed_paths <- indexed_paths + 1
            for index in 0..<session.entries.count |session|:
                entry: ArchiveEntry = session.entries[index]
                entry_id_index: usize = try archive_entry_id_index(session, entry.entry_id)
                raise ArchiveError.DuplicateEntryId if entry_id_index != index
                if entry.state == ArchiveEntryState.Accepted:
                    path_index: usize = try archive_path_index(session.entries, session.path_index_slots, entry.path)
                    raise ArchiveError.AccountingInvalid if path_index == session.entries.count
                    raise ArchiveError.DuplicatePath if session.policy.overwrite == ArchiveOverwritePolicy.Fail and path_index != index
                    raise ArchiveError.AccountingInvalid if path_index < index and session.policy.overwrite == ArchiveOverwritePolicy.Replace
            raise ArchiveError.AccountingInvalid if indexed_ids != session.entries.count
            raise ArchiveError.AccountingInvalid if indexed_paths > session.entries.count - session.skipped_entries
            return true


        def archive_admit_entry(session: mutable ArchiveSession&, entry: ArchiveEntry) -> bool error[ArchiveError]:
            try validate_archive_header(session)
            raise ArchiveError.InvalidTransition if session.state != ArchiveSessionState.Extracting
            raise ArchiveError.AccountingInvalid if not archive_index_shape_valid(session)
            raise ArchiveError.EntryLimitExceeded if session.entries.count >= session.policy.max_entries
            raise ArchiveError.InvalidId if entry.entry_id == 0
            raise ArchiveError.InvalidEntryKind if not archive_entry_kind_valid(entry.kind)
            raise ArchiveError.InvalidEntryState if not archive_entry_state_valid(entry.state)
            existing_id_index: usize = try archive_entry_id_index(session, entry.entry_id)
            raise ArchiveError.DuplicateEntryId if existing_id_index != session.entries.count
            path_issue: ArchivePathIssue = archive_path_issue(entry.path, session.policy)
            raise ArchiveError.EmptyPath if path_issue == ArchivePathIssue.Empty
            raise ArchiveError.PathLimitExceeded if path_issue == ArchivePathIssue.TooLong
            raise ArchiveError.EmbeddedNul if path_issue == ArchivePathIssue.EmbeddedNul
            raise ArchiveError.AbsolutePath if path_issue == ArchivePathIssue.Absolute
            raise ArchiveError.BackslashPath if path_issue == ArchivePathIssue.Backslash
            raise ArchiveError.TraversalPath if path_issue == ArchivePathIssue.Traversal
            raise ArchiveError.EntryLimitBytesExceeded if entry.size > session.policy.max_entry_bytes
            raise ArchiveError.TargetInvalid if entry.kind != ArchiveEntryKind.Symlink and entry.kind != ArchiveEntryKind.Hardlink and entry.target != ""
            raise ArchiveError.LinkRejected if (entry.kind == ArchiveEntryKind.Symlink or entry.kind == ArchiveEntryKind.Hardlink) and session.policy.links == ArchiveLinkPolicy.Reject
            raise ArchiveError.TargetInvalid if (entry.kind == ArchiveEntryKind.Symlink or entry.kind == ArchiveEntryKind.Hardlink) and not archive_relative_path_safe(entry.target, session.policy)
            if entry.state == ArchiveEntryState.Accepted and session.policy.overwrite == ArchiveOverwritePolicy.Fail:
                existing_path_index: usize = try archive_path_index(session.entries, session.path_index_slots, entry.path)
                raise ArchiveError.DuplicatePath if existing_path_index != session.entries.count
            if entry.state == ArchiveEntryState.Skipped:
                try archive_ensure_index_capacity(session)
                preflight_id_index: usize = try archive_entry_id_index(session, entry.entry_id)
                raise ArchiveError.DuplicateEntryId if preflight_id_index != session.entries.count
                entry_index: usize = session.entries.count
                session.skipped_entries <- session.skipped_entries + 1
                session.entries.push(entry)
                try archive_place_id_index(session.entries, session.id_index_slots, entry_index)
            else:
                raise ArchiveError.TotalLimitBytesExceeded if entry.size > session.policy.max_total_bytes - session.total_bytes
                try archive_ensure_index_capacity(session)
                preflight_id_index: usize = try archive_entry_id_index(session, entry.entry_id)
                raise ArchiveError.DuplicateEntryId if preflight_id_index != session.entries.count
                preflight_path_index: usize = try archive_path_index(session.entries, session.path_index_slots, entry.path)
                raise ArchiveError.DuplicatePath if session.policy.overwrite == ArchiveOverwritePolicy.Fail and preflight_path_index != session.entries.count
                entry_index: usize = session.entries.count
                session.total_bytes <- session.total_bytes + entry.size
                session.entries.push(entry)
                try archive_place_id_index(session.entries, session.id_index_slots, entry_index)
                try archive_place_path_index(session.entries, session.path_index_slots, entry_index)
            return true


        def advance_archive(session: mutable ArchiveSession&, event: ArchiveEvent) -> ArchiveSessionState error[ArchiveError]:
            try validate_archive_session(session)
            raise ArchiveError.InvalidEvent if not archive_event_valid(event)
            if event == ArchiveEvent.Begin:
                raise ArchiveError.InvalidTransition if session.state != ArchiveSessionState.Planned
                session.state <- ArchiveSessionState.Extracting
            elif event == ArchiveEvent.Commit:
                raise ArchiveError.InvalidTransition if session.state != ArchiveSessionState.Extracting
                session.state <- ArchiveSessionState.Committed
            elif event == ArchiveEvent.Fail:
                raise ArchiveError.InvalidTransition if session.state != ArchiveSessionState.Extracting
                session.state <- ArchiveSessionState.Failed
            elif event == ArchiveEvent.Cancel:
                raise ArchiveError.InvalidTransition if session.state != ArchiveSessionState.Extracting and session.state != ArchiveSessionState.Planned
                session.state <- ArchiveSessionState.Cancelled
            return session.state
