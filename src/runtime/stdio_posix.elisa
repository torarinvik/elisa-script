# POSIX standard-stream bridge. Higher layers retain typed text, explicit
# Console effects, and structured ConsoleError failures.

extend EsRuntime:
    private:
        @link_name(read)
        extern elisascript_posix_read_impl(fd: int, buffer: mutable void&, count: usize) -> isize can[Blocking.IO]

    public:
        def elisascript_posix_read(fd: int, buffer: mutable void&, count: usize) -> isize can[Blocking.IO]:
            return elisascript_posix_read_impl(fd, buffer, count)
