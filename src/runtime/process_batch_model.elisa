# Bounded parallel process-batch scheduling contract.
#
# This module never launches a child. It gives host schedulers one typed queue
# for bounded fan-out/fan-in, retry admission, fail-fast policy, and scoped
# cancellation acknowledgement.

module EsProcessBatch:
    public:
        const module Limits:
            JOBS: usize = 1024
            PARALLEL: usize = 64
            ATTEMPTS: usize = 16


        const enum ProcessBatchFailureMode of u8:
            FailFast
            Aggregate


        const enum ProcessBatchState of u8:
            Planned
            Running
            Draining
            Succeeded
            Failed
            Cancelling
            Cancelled


        const enum ProcessBatchJobState of u8:
            Pending
            Running
            AwaitingReap
            Retryable
            Succeeded
            Failed
            Cancelled


        const enum ProcessBatchEvent of u8:
            Begin
            Launch
            Complete
            Fail
            ReapAck
            Retry
            Cancel
            CancelAck
            # Appended so dependency-aware hosts can admit a specific ready
            # item without changing the identity of the original Launch tag.
            LaunchAt


        struct ProcessBatchPolicy:
            max_jobs: usize = Limits::JOBS
            max_parallel: usize = Limits::PARALLEL
            max_attempts: usize = Limits::ATTEMPTS
            failure_mode: ProcessBatchFailureMode = ProcessBatchFailureMode.FailFast


        struct ProcessBatchJob:
            id: u64
            state: ProcessBatchJobState = ProcessBatchJobState.Pending
            attempts: usize = 0
            # A host receipt must echo the token returned by the matching
            # launch. Attempt counts are not sufficient once a delayed event
            # from an earlier retry can arrive after a new launch.
            attempt_token: u64 = 0
            # Pending/terminal jobs have no unreaped child. A failed running
            # job must pass through AwaitingReap before it may be retried.
            reap_acknowledged: bool = true


        # Exact host handoff for one admitted launch. `job_id` identifies the
        # caller's command; the token makes delayed receipts from a prior
        # retry distinguishable from the currently running attempt.
        struct ProcessBatchDispatch:
            job_index: usize
            job_id: u64
            attempt_token: u64


        struct ProcessBatchSession:
            policy: ProcessBatchPolicy
            state: ProcessBatchState = ProcessBatchState.Planned
            jobs: darray[ProcessBatchJob] = []
            active: usize = 0
            completed: usize = 0
            failed: usize = 0
            # Once a fail-fast failure is observed, no new queued work may be
            # admitted while the failed child is awaiting its reap receipt.
            fail_fast_latched: bool = false


        error ProcessBatchError:
            InvalidState
            InvalidEvent
            InvalidPolicy
            InvalidFailureMode
            InvalidJobState
            StaleAttempt
            InvalidJobIndex
            DuplicateJobId
            InvalidJobId
            JobLimitExceeded
            ParallelLimitExceeded
            AttemptLimitExceeded
            AccountingInvalid
            NoPendingJob
            RetryNotReady
            ReapNotReady
            CancelNotReady
            DispatchMismatch


    private:
        def process_batch_state_valid(state: ProcessBatchState) -> bool:
            return state in {ProcessBatchState.Planned, ProcessBatchState.Running, ProcessBatchState.Draining, ProcessBatchState.Succeeded, ProcessBatchState.Failed, ProcessBatchState.Cancelling, ProcessBatchState.Cancelled}


        def process_batch_job_state_valid(state: ProcessBatchJobState) -> bool:
            return state in {ProcessBatchJobState.Pending, ProcessBatchJobState.Running, ProcessBatchJobState.AwaitingReap, ProcessBatchJobState.Retryable, ProcessBatchJobState.Succeeded, ProcessBatchJobState.Failed, ProcessBatchJobState.Cancelled}


        def process_batch_event_valid(event: ProcessBatchEvent) -> bool:
            return event in {ProcessBatchEvent.Begin, ProcessBatchEvent.Launch, ProcessBatchEvent.Complete, ProcessBatchEvent.Fail, ProcessBatchEvent.ReapAck, ProcessBatchEvent.Retry, ProcessBatchEvent.Cancel, ProcessBatchEvent.CancelAck, ProcessBatchEvent.LaunchAt}


        def process_batch_failure_mode_valid(mode: ProcessBatchFailureMode) -> bool:
            return mode in {ProcessBatchFailureMode.FailFast, ProcessBatchFailureMode.Aggregate}


        def process_batch_policy_valid(policy: ProcessBatchPolicy) -> bool:
            return policy.max_jobs != 0 and policy.max_jobs <= Limits::JOBS and policy.max_parallel != 0 and policy.max_parallel <= Limits::PARALLEL and policy.max_attempts != 0 and policy.max_attempts <= Limits::ATTEMPTS and process_batch_failure_mode_valid(policy.failure_mode)


        def process_batch_job_active(state: ProcessBatchJobState) -> bool:
            return state == ProcessBatchJobState.Running


        def process_batch_job_terminal(state: ProcessBatchJobState) -> bool:
            return state == ProcessBatchJobState.Succeeded or state == ProcessBatchJobState.Failed or state == ProcessBatchJobState.Cancelled


        def process_batch_job_requires_attempt(state: ProcessBatchJobState) -> bool:
            return state == ProcessBatchJobState.Running or state == ProcessBatchJobState.AwaitingReap or state == ProcessBatchJobState.Retryable or state == ProcessBatchJobState.Succeeded or state == ProcessBatchJobState.Failed


        def process_batch_pending_index(session: ProcessBatchSession&) -> usize:
            for index in 0..<session.jobs.count |session|:
                return index if session.jobs[index].state == ProcessBatchJobState.Pending
            return session.jobs.count


        def process_batch_all_terminal(session: ProcessBatchSession&) -> bool:
            terminal: mutable usize = 0
            for job in session.jobs |session, terminal|:
                terminal <- terminal + 1 if process_batch_job_terminal(job.state)
            return terminal == session.jobs.count


    public:
        def validate_process_batch(session: ProcessBatchSession&) -> bool error[ProcessBatchError]:
            raise ProcessBatchError.InvalidState if not process_batch_state_valid(session.state)
            raise ProcessBatchError.InvalidPolicy if not process_batch_policy_valid(session.policy)
            raise ProcessBatchError.JobLimitExceeded if session.jobs.count > session.policy.max_jobs
            raise ProcessBatchError.ParallelLimitExceeded if session.active > session.policy.max_parallel
            raise ProcessBatchError.AccountingInvalid if session.completed > session.jobs.count
            raise ProcessBatchError.AccountingInvalid if session.failed > session.jobs.count - session.completed
            # The latch is semantic state, not a free-standing override.  An
            # aggregate batch can contain failed jobs, but it must never be
            # imported as fail-fast draining; otherwise CancelAck could turn
            # an aggregate run into the fail-fast terminal path.
            raise ProcessBatchError.AccountingInvalid if session.fail_fast_latched and session.policy.failure_mode != ProcessBatchFailureMode.FailFast
            raise ProcessBatchError.AccountingInvalid if session.state == ProcessBatchState.Planned and (session.active != 0 or session.completed != 0 or session.failed != 0 or session.fail_fast_latched)
            active: mutable usize = 0
            completed: mutable usize = 0
            failed: mutable usize = 0
            unfinished: mutable usize = 0
            cancelled: mutable usize = 0
            queued: mutable usize = 0
            for index in 0..<session.jobs.count |session, active, completed, failed, unfinished, cancelled, queued|:
                job: ProcessBatchJob = session.jobs[index]
                raise ProcessBatchError.InvalidJobId if job.id == 0
                raise ProcessBatchError.InvalidJobState if not process_batch_job_state_valid(job.state)
                raise ProcessBatchError.AttemptLimitExceeded if job.attempts > session.policy.max_attempts
                raise ProcessBatchError.AccountingInvalid if process_batch_job_requires_attempt(job.state) and job.attempts == 0
                raise ProcessBatchError.AccountingInvalid if session.state == ProcessBatchState.Planned and (job.state != ProcessBatchJobState.Pending or job.attempts != 0)
                active <- active + 1 if process_batch_job_active(job.state)
                completed <- completed + 1 if job.state == ProcessBatchJobState.Succeeded
                failed <- failed + 1 if job.state == ProcessBatchJobState.Failed
                cancelled <- cancelled + 1 if job.state == ProcessBatchJobState.Cancelled
                queued <- queued + 1 if job.state == ProcessBatchJobState.Pending or job.state == ProcessBatchJobState.Retryable
                raise ProcessBatchError.AccountingInvalid if job.attempts == 0 and job.attempt_token != 0
                raise ProcessBatchError.AccountingInvalid if job.attempts != 0 and job.attempt_token == 0
                raise ProcessBatchError.AccountingInvalid if job.attempts != 0 and job.attempt_token != job.attempts.u64()
                raise ProcessBatchError.AccountingInvalid if job.state == ProcessBatchJobState.Running and job.reap_acknowledged
                raise ProcessBatchError.AccountingInvalid if job.state == ProcessBatchJobState.AwaitingReap and job.reap_acknowledged
                raise ProcessBatchError.AccountingInvalid if (job.state == ProcessBatchJobState.Pending or job.state == ProcessBatchJobState.Retryable or job.state == ProcessBatchJobState.Succeeded or job.state == ProcessBatchJobState.Failed or job.state == ProcessBatchJobState.Cancelled) and not job.reap_acknowledged
                unfinished <- unfinished + 1 if job.state == ProcessBatchJobState.Pending or job.state == ProcessBatchJobState.Running or job.state == ProcessBatchJobState.AwaitingReap or job.state == ProcessBatchJobState.Retryable
                for earlier in 0..<index |session, job|:
                    raise ProcessBatchError.DuplicateJobId if session.jobs[earlier].id == job.id
            raise ProcessBatchError.AccountingInvalid if active != session.active or completed != session.completed or failed != session.failed
            # Running and Cancelling are in-flight states.  They must retain
            # at least one owned job; otherwise a forged snapshot can pass
            # validation and let CancelAck relabel an already terminal batch
            # as Cancelled (or manufacture a cancellation with no work to
            # acknowledge).
            raise ProcessBatchError.AccountingInvalid if session.state == ProcessBatchState.Running and unfinished == 0
            raise ProcessBatchError.AccountingInvalid if session.state == ProcessBatchState.Cancelling and unfinished == 0
            raise ProcessBatchError.AccountingInvalid if session.state == ProcessBatchState.Running and session.fail_fast_latched
            raise ProcessBatchError.AccountingInvalid if session.state == ProcessBatchState.Succeeded and (active != 0 or failed != 0 or completed != session.jobs.count)
            raise ProcessBatchError.AccountingInvalid if session.state == ProcessBatchState.Failed and (failed == 0 or active != 0 or unfinished != 0)
            raise ProcessBatchError.AccountingInvalid if session.state == ProcessBatchState.Draining and (not session.fail_fast_latched or unfinished == 0 or queued != 0)
            raise ProcessBatchError.AccountingInvalid if session.state == ProcessBatchState.Cancelled and (session.fail_fast_latched or unfinished != 0 or (session.jobs.count != 0 and cancelled == 0))
            return true


        def advance_process_batch(session: mutable ProcessBatchSession&, event: ProcessBatchEvent, job_index: usize = 0, attempt_token: u64 = 0) -> ProcessBatchState error[ProcessBatchError]:
            try validate_process_batch(session)
            raise ProcessBatchError.InvalidEvent if not process_batch_event_valid(event)
            if event == ProcessBatchEvent.Begin:
                raise ProcessBatchError.InvalidState if session.state != ProcessBatchState.Planned
                session.state <- ProcessBatchState.Succeeded if session.jobs.count == 0 else ProcessBatchState.Running
            elif event == ProcessBatchEvent.Launch or event == ProcessBatchEvent.LaunchAt:
                raise ProcessBatchError.InvalidState if session.state != ProcessBatchState.Running and session.state != ProcessBatchState.Draining
                raise ProcessBatchError.ParallelLimitExceeded if session.active >= session.policy.max_parallel
                pending: mutable usize = process_batch_pending_index(session)
                if event == ProcessBatchEvent.LaunchAt:
                    raise ProcessBatchError.InvalidJobIndex if job_index >= session.jobs.count
                    pending <- job_index
                    raise ProcessBatchError.InvalidJobState if session.jobs[pending].state != ProcessBatchJobState.Pending
                else:
                    raise ProcessBatchError.NoPendingJob if pending == session.jobs.count
                raise ProcessBatchError.AttemptLimitExceeded if session.jobs[pending].attempts >= session.policy.max_attempts
                session.jobs[pending].state <- ProcessBatchJobState.Running
                session.jobs[pending].attempts <- session.jobs[pending].attempts + 1
                session.jobs[pending].attempt_token <- session.jobs[pending].attempts.u64()
                session.jobs[pending].reap_acknowledged <- false
                session.active <- session.active + 1
            elif event == ProcessBatchEvent.Complete:
                raise ProcessBatchError.InvalidState if session.state != ProcessBatchState.Running and session.state != ProcessBatchState.Draining
                raise ProcessBatchError.InvalidJobIndex if job_index >= session.jobs.count
                raise ProcessBatchError.InvalidJobState if session.jobs[job_index].state != ProcessBatchJobState.Running
                raise ProcessBatchError.StaleAttempt if attempt_token == 0 or attempt_token != session.jobs[job_index].attempt_token
                session.jobs[job_index].state <- ProcessBatchJobState.Succeeded
                session.jobs[job_index].reap_acknowledged <- true
                session.active <- session.active - 1
                session.completed <- session.completed + 1
                session.state <- ProcessBatchState.Failed if process_batch_all_terminal(session) and session.failed != 0 else ProcessBatchState.Succeeded if process_batch_all_terminal(session) else session.state
            elif event == ProcessBatchEvent.Fail:
                raise ProcessBatchError.InvalidState if session.state != ProcessBatchState.Running and session.state != ProcessBatchState.Draining
                raise ProcessBatchError.InvalidJobIndex if job_index >= session.jobs.count
                raise ProcessBatchError.InvalidJobState if session.jobs[job_index].state != ProcessBatchJobState.Running
                raise ProcessBatchError.StaleAttempt if attempt_token == 0 or attempt_token != session.jobs[job_index].attempt_token
                session.active <- session.active - 1
                session.jobs[job_index].state <- ProcessBatchJobState.AwaitingReap
                session.jobs[job_index].reap_acknowledged <- false
                if session.policy.failure_mode == ProcessBatchFailureMode.FailFast and (session.jobs[job_index].attempts >= session.policy.max_attempts or session.state == ProcessBatchState.Draining):
                    session.fail_fast_latched <- true
                    for index in 0..<session.jobs.count |session|:
                        session.jobs[index].state <- ProcessBatchJobState.Cancelled if session.jobs[index].state == ProcessBatchJobState.Pending or session.jobs[index].state == ProcessBatchJobState.Retryable
                    session.state <- ProcessBatchState.Draining
            elif event == ProcessBatchEvent.ReapAck:
                raise ProcessBatchError.InvalidState if session.state != ProcessBatchState.Running and session.state != ProcessBatchState.Draining
                raise ProcessBatchError.InvalidJobIndex if job_index >= session.jobs.count
                raise ProcessBatchError.ReapNotReady if session.jobs[job_index].state != ProcessBatchJobState.AwaitingReap
                raise ProcessBatchError.StaleAttempt if attempt_token == 0 or attempt_token != session.jobs[job_index].attempt_token
                session.jobs[job_index].reap_acknowledged <- true
                if session.jobs[job_index].attempts < session.policy.max_attempts and session.state != ProcessBatchState.Draining:
                    session.jobs[job_index].state <- ProcessBatchJobState.Retryable
                else:
                    session.jobs[job_index].state <- ProcessBatchJobState.Failed
                    session.failed <- session.failed + 1
                    if session.policy.failure_mode == ProcessBatchFailureMode.FailFast:
                        session.fail_fast_latched <- true
                        for index in 0..<session.jobs.count |session|:
                            session.jobs[index].state <- ProcessBatchJobState.Cancelled if session.jobs[index].state == ProcessBatchJobState.Pending or session.jobs[index].state == ProcessBatchJobState.Retryable
                        session.state <- ProcessBatchState.Failed if session.active == 0 else ProcessBatchState.Draining
                session.state <- ProcessBatchState.Failed if process_batch_all_terminal(session) and session.failed != 0 else session.state
            elif event == ProcessBatchEvent.Retry:
                raise ProcessBatchError.InvalidState if session.state != ProcessBatchState.Running and session.state != ProcessBatchState.Draining
                raise ProcessBatchError.InvalidJobIndex if job_index >= session.jobs.count
                raise ProcessBatchError.RetryNotReady if session.jobs[job_index].state != ProcessBatchJobState.Retryable
                raise ProcessBatchError.ReapNotReady if not session.jobs[job_index].reap_acknowledged
                session.jobs[job_index].state <- ProcessBatchJobState.Pending
            elif event == ProcessBatchEvent.Cancel:
                raise ProcessBatchError.CancelNotReady if session.state == ProcessBatchState.Succeeded or session.state == ProcessBatchState.Failed or session.state == ProcessBatchState.Cancelled
                if session.state == ProcessBatchState.Planned:
                    for index in 0..<session.jobs.count |session|:
                        session.jobs[index].state <- ProcessBatchJobState.Cancelled if session.jobs[index].state == ProcessBatchJobState.Pending
                    session.state <- ProcessBatchState.Cancelled
                else:
                    session.state <- ProcessBatchState.Cancelling
            elif event == ProcessBatchEvent.CancelAck:
                raise ProcessBatchError.InvalidState if session.state != ProcessBatchState.Cancelling
                for index in 0..<session.jobs.count |session|:
                    # A latched fail-fast child is already a semantic failure
                    # even if its host-side reap receipt has not arrived yet.
                    # Treat CancelAck as the terminal reap acknowledgement for
                    # that child instead of allowing cancellation to erase the
                    # failure from the session accounting.
                    if session.fail_fast_latched and session.jobs[index].state == ProcessBatchJobState.AwaitingReap:
                        session.jobs[index].state <- ProcessBatchJobState.Failed
                        session.jobs[index].reap_acknowledged <- true
                        session.failed <- session.failed + 1
                    else:
                        session.jobs[index].state <- ProcessBatchJobState.Cancelled if session.jobs[index].state == ProcessBatchJobState.Pending or session.jobs[index].state == ProcessBatchJobState.Retryable or session.jobs[index].state == ProcessBatchJobState.Running or session.jobs[index].state == ProcessBatchJobState.AwaitingReap
                    session.jobs[index].reap_acknowledged <- true if session.jobs[index].state == ProcessBatchJobState.Cancelled
                session.active <- 0
                # A latched fail-fast failure remains the terminal outcome even
                # when the host cancels the still-running siblings. This keeps
                # cancellation from masking a real failed child, matching the
                # scheduler's Failing -> Failed drain semantics.
                session.state <- ProcessBatchState.Failed if session.fail_fast_latched else ProcessBatchState.Cancelled
            return session.state


        # Admit the next deterministic pending job and return the exact
        # identity/token pair a host must attach to its eventual receipt.
        # Keeping selection and transition together prevents a caller from
        # racing a separate queue lookup against launch admission.
        def admit_next_process_batch_job(session: mutable ProcessBatchSession&) -> ProcessBatchDispatch error[ProcessBatchError]:
            _ = try validate_process_batch(session)
            pending: usize = process_batch_pending_index(session)
            _ = try advance_process_batch(session, ProcessBatchEvent.Launch)
            job: ProcessBatchJob = session.jobs[pending]
            return ProcessBatchDispatch{job_index: pending, job_id: job.id, attempt_token: job.attempt_token}


        # Dependency-aware schedulers must call this only after proving the
        # selected job is ready. This preserves the scheduler's chosen graph
        # node instead of forcing global job-list order on the host.
        def admit_process_batch_job(session: mutable ProcessBatchSession&, job_index: usize) -> ProcessBatchDispatch error[ProcessBatchError]:
            _ = try validate_process_batch(session)
            _ = try advance_process_batch(session, ProcessBatchEvent.LaunchAt, job_index)
            job: ProcessBatchJob = session.jobs[job_index]
            return ProcessBatchDispatch{job_index: job_index, job_id: job.id, attempt_token: job.attempt_token}


        # A dispatch value is ordinary typed data and can be copied or forged;
        # revalidate it against the live session before a host associates it
        # with a command or accepts a result for that attempt.
        def validate_process_batch_dispatch(session: ProcessBatchSession&, dispatch: ProcessBatchDispatch) -> bool error[ProcessBatchError]:
            _ = try validate_process_batch(session)
            raise ProcessBatchError.InvalidJobIndex if dispatch.job_index >= session.jobs.count
            job: ProcessBatchJob = session.jobs[dispatch.job_index]
            raise ProcessBatchError.DispatchMismatch if job.state != ProcessBatchJobState.Running or dispatch.job_id != job.id or dispatch.attempt_token == 0 or dispatch.attempt_token != job.attempt_token
            return true
