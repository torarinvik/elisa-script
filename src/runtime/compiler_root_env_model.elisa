# Pure selection policy for Elisa-LSP's sourced compiler-root helper.
# It does not inspect the host or mutate a parent process environment.
module EsCompilerRootEnv:
    private:
        const module Paths:
            DEFAULT_SUFFIX: sview = "/../Elisa-compiler"

    public:
        const module Limits:
            PATH_BYTES: usize = 4096


        error RootError:
            PathLimit
            EmbeddedNul


        def select(default_lsp_root: sview, configured: sview) -> sview error[RootError] can[Memory.Allocate, Abort.Panic]:
            if configured != "":
                raise RootError.PathLimit if len(configured) >= Limits::PATH_BYTES
                for byte in configured:
                    raise RootError.EmbeddedNul if byte == 0u8
                return configured
            # Subtraction admits the complete default spelling before the
            # suffix allocation. It also avoids a large transient string.
            raise RootError.PathLimit if len(default_lsp_root) >= Limits::PATH_BYTES - len(Paths::DEFAULT_SUFFIX)
            for byte in default_lsp_root:
                raise RootError.EmbeddedNul if byte == 0u8
            return default_lsp_root + Paths::DEFAULT_SUFFIX
