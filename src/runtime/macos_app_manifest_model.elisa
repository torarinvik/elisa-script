# Typed manifest policy used by the Elisa Engine macOS app packager.
#
# The returned text fields are owned UTF-8 byte arrays. Filesystem path
# expansion/resolution and bundle publication belong to the host adapter.

module EsMacosAppManifest:
    using EsData
    using EsJson

    public:
        struct MacosAppSettings:
            name: darray[u8]
            bundle_id: darray[u8]
            output_setting: darray[u8]
            window_title: darray[u8]
            window_width: usize
            window_height: usize


        const enum MacosResourceMode of u8:
            AllAssets
            ExplicitPaths


        struct MacosAppPathSelection:
            resource_mode: MacosResourceMode = MacosResourceMode.AllAssets
            resource_paths: darray[darray[u8]] = []
            notice_paths: darray[darray[u8]] = []


        error MacosAppManifestError:
            InvalidJsonPolicy
            InvalidManifestRoot
            InvalidApplication
            InvalidTextField
            InvalidApplicationName
            InvalidOutput
            InvalidWindowDimension
            InvalidPackage
            InvalidResourceList
            InvalidNoticeList
            InvalidResourcePath
            DuplicateNoticePath
            PathLimitExceeded


    private:
        const module JsonKey:
            NAME: sview = "name"
            APPLICATION: sview = "application"
            TITLE: sview = "title"
            BUNDLE_ID: sview = "bundle_id"
            OUTPUT: sview = "output"
            PACKAGE: sview = "package"
            RESOURCES: sview = "resources"
            NOTICES: sview = "notices"
            WIDTH: sview = "width"
            HEIGHT: sview = "height"


        const module PathLimits:
            ENTRIES: usize = 256


        const module IgnoredNames:
            GIT: sview = ".git"
            GITATTRIBUTES: sview = ".gitattributes"
            GITIGNORE: sview = ".gitignore"
            DS_STORE: sview = ".DS_Store"
            PYTHON_CACHE: sview = "__pycache__"
            THUMBS: sview = "Thumbs.db"


        const module ApplicationDefaults:
            WINDOW_WIDTH: usize = 1280
            WINDOW_HEIGHT: usize = 720
            MAX_WINDOW_DIMENSION: usize = 16384


        struct RootIndexes:
            name: usize = JSON_INDEX_NONE
            application: usize = JSON_INDEX_NONE
            output: usize = JSON_INDEX_NONE
            package: usize = JSON_INDEX_NONE


        struct ApplicationIndexes:
            title: usize = JSON_INDEX_NONE
            bundle_id: usize = JSON_INDEX_NONE
            width: usize = JSON_INDEX_NONE
            height: usize = JSON_INDEX_NONE


        struct PackageIndexes:
            resources: usize = JSON_INDEX_NONE
            notices: usize = JSON_INDEX_NONE


        struct NormalizedPath:
            bytes: darray[u8] = []
            absolute: bool = false
            has_parent: bool = false
            has_ignored_name: bool = false


        def app_manifest_key_equals(document: JsonDocument&, member: JsonMember, key: sview) -> bool:
            return false if member.key_bytes != sview_len(key)
            for offset in 0..<member.key_bytes |document, member, key|:
                return false if document.key_bytes[member.key_start + offset] != sview_at(key, offset)
            return true


        def app_manifest_root_indexes(document: JsonDocument&, root: JsonNode) -> RootIndexes:
            indexes: mutable RootIndexes = RootIndexes{}
            member_end: usize = root.member_start + root.member_count
            for member_index in root.member_start..<member_end |document, indexes|:
                member: JsonMember = document.members[member_index]
                if app_manifest_key_equals(document, member, JsonKey::NAME):
                    indexes.name <- member.value_index
                elif app_manifest_key_equals(document, member, JsonKey::APPLICATION):
                    indexes.application <- member.value_index
                elif app_manifest_key_equals(document, member, JsonKey::OUTPUT):
                    indexes.output <- member.value_index
                elif app_manifest_key_equals(document, member, JsonKey::PACKAGE):
                    indexes.package <- member.value_index
            return indexes


        def app_manifest_package_indexes(document: JsonDocument&, package: JsonNode) -> PackageIndexes:
            indexes: mutable PackageIndexes = PackageIndexes{}
            member_end: usize = package.member_start + package.member_count
            for member_index in package.member_start..<member_end |document, indexes|:
                member: JsonMember = document.members[member_index]
                if app_manifest_key_equals(document, member, JsonKey::RESOURCES):
                    indexes.resources <- member.value_index
                elif app_manifest_key_equals(document, member, JsonKey::NOTICES):
                    indexes.notices <- member.value_index
            return indexes


        def app_manifest_application_indexes(document: JsonDocument&, application: JsonNode) -> ApplicationIndexes:
            indexes: mutable ApplicationIndexes = ApplicationIndexes{}
            member_end: usize = application.member_start + application.member_count
            for member_index in application.member_start..<member_end |document, indexes|:
                member: JsonMember = document.members[member_index]
                if app_manifest_key_equals(document, member, JsonKey::TITLE):
                    indexes.title <- member.value_index
                elif app_manifest_key_equals(document, member, JsonKey::BUNDLE_ID):
                    indexes.bundle_id <- member.value_index
                elif app_manifest_key_equals(document, member, JsonKey::WIDTH):
                    indexes.width <- member.value_index
                elif app_manifest_key_equals(document, member, JsonKey::HEIGHT):
                    indexes.height <- member.value_index
            return indexes


        def app_manifest_text_view(document: JsonDocument&, node_index: usize) -> sview error[JsonContractError, MacosAppManifestError]:
            raise MacosAppManifestError.InvalidTextField if node_index >= document.nodes.count
            node: JsonNode = document.nodes[node_index]
            raise MacosAppManifestError.InvalidTextField if node.kind != JsonNodeKind.Text
            raise JsonContractError.InvalidScalarPayload if node.scalar_start > document.scalar_data.count
            raise JsonContractError.InvalidScalarPayload if node.scalar_bytes > document.scalar_data.count - node.scalar_start
            scalar_bytes: sview = bytes_view(document.scalar_data)
            end: usize = node.scalar_start + node.scalar_bytes
            return string_view_slice(scalar_bytes, node.scalar_start.i64(), end.i64())


        def app_manifest_copy_text(value: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            bytes: mutable darray[u8] = []
            for offset in 0..<sview_len(value) |value, bytes|:
                bytes.push(sview_at(value, offset))
            return bytes


        def app_manifest_bytes_equal(left: darray[u8], right: darray[u8]) -> bool:
            return false if left.count != right.count
            for offset in 0..<left.count |left, right|:
                return false if left[offset] != right[offset]
            return true


        def app_manifest_path_segment_is_ignored(value: sview, start: usize, end: usize) -> bool:
            segment: sview = string_view_slice(value, start.i64(), end.i64())
            return segment == IgnoredNames::GIT or segment == IgnoredNames::GITATTRIBUTES or segment == IgnoredNames::GITIGNORE or segment == IgnoredNames::DS_STORE or segment == IgnoredNames::PYTHON_CACHE or segment == IgnoredNames::THUMBS


        def app_manifest_normalize_path(value: sview) -> NormalizedPath can[Memory.Allocate, Abort.Panic]:
            length: usize = sview_len(value)
            normalized: mutable NormalizedPath = NormalizedPath{absolute: length != 0 and sview_at(value, 0) == 47}
            cursor: mutable usize = 0
            while cursor < length |value, normalized, cursor|:
                while cursor < length and sview_at(value, cursor) == 47 |value, cursor|:
                    cursor <- cursor + 1
                segment_start: usize = cursor
                while cursor < length and sview_at(value, cursor) != 47 |value, cursor|:
                    cursor <- cursor + 1
                segment_end: usize = cursor
                segment_length: usize = segment_end - segment_start
                if segment_length != 0 and not (segment_length == 1 and sview_at(value, segment_start) == 46):
                    normalized.has_parent <- true if segment_length == 2 and sview_at(value, segment_start) == 46 and sview_at(value, segment_start + 1) == 46
                    normalized.has_ignored_name <- true if app_manifest_path_segment_is_ignored(value, segment_start, segment_end)
                    if normalized.bytes.count != 0:
                        normalized.bytes.push(47)
                    for offset in segment_start..<segment_end |value, normalized|:
                        normalized.bytes.push(sview_at(value, offset))
            if normalized.bytes.count == 0:
                normalized.bytes.push(46)
            return normalized


        def app_manifest_array_item(document: JsonDocument&, array: JsonNode, index: usize) -> usize error[JsonContractError]:
            raise JsonContractError.InvalidArrayChild if array.kind != JsonNodeKind.Array or index >= array.child_count
            child_index: usize = array.child_start + index
            raise JsonContractError.InvalidArrayChild if child_index >= document.children.count
            return document.children[child_index].value_index


        def app_manifest_path_already_selected(paths: darray[darray[u8]], candidate: darray[u8]) -> bool:
            for previous in paths:
                return true if app_manifest_bytes_equal(previous, candidate)
            return false


        def app_manifest_resources(document: JsonDocument&, root_indexes: RootIndexes) -> MacosAppPathSelection error[JsonContractError, MacosAppManifestError] can[Memory.Allocate, Abort.Panic]:
            selection: mutable MacosAppPathSelection = MacosAppPathSelection{}
            if root_indexes.package == JSON_INDEX_NONE:
                return selection
            raise MacosAppManifestError.InvalidPackage if root_indexes.package >= document.nodes.count
            package: JsonNode = document.nodes[root_indexes.package]
            return selection if package.kind == JsonNodeKind.Null
            raise MacosAppManifestError.InvalidPackage if package.kind != JsonNodeKind.Object
            package_indexes: PackageIndexes = app_manifest_package_indexes(document, package)
            return selection if package_indexes.resources == JSON_INDEX_NONE
            raise MacosAppManifestError.InvalidResourceList if package_indexes.resources >= document.nodes.count
            raw_resources: JsonNode = document.nodes[package_indexes.resources]
            return selection if raw_resources.kind == JsonNodeKind.Null
            raise MacosAppManifestError.InvalidResourceList if raw_resources.kind != JsonNodeKind.Array
            raise MacosAppManifestError.PathLimitExceeded if raw_resources.child_count > PathLimits::ENTRIES
            selection.resource_mode <- MacosResourceMode.ExplicitPaths
            for index in 0..<raw_resources.child_count |document, raw_resources, selection|:
                entry_index: usize = try app_manifest_array_item(document, raw_resources, index)
                entry: sview = try app_manifest_text_view(document, entry_index)
                raise MacosAppManifestError.InvalidResourcePath if not app_manifest_text_has_non_whitespace(entry)
                relative: NormalizedPath = app_manifest_normalize_path(entry)
                raise MacosAppManifestError.InvalidResourcePath if relative.absolute or relative.has_parent or relative.has_ignored_name
                continue if app_manifest_path_already_selected(selection.resource_paths, relative.bytes)
                selection.resource_paths.push(relative.bytes)
            return selection


        def app_manifest_notices(document: JsonDocument&, root_indexes: RootIndexes) -> darray[darray[u8]] error[JsonContractError, MacosAppManifestError] can[Memory.Allocate, Abort.Panic]:
            paths: mutable darray[darray[u8]] = []
            return paths if root_indexes.package == JSON_INDEX_NONE
            raise MacosAppManifestError.InvalidPackage if root_indexes.package >= document.nodes.count
            package: JsonNode = document.nodes[root_indexes.package]
            raise MacosAppManifestError.InvalidPackage if package.kind != JsonNodeKind.Object
            package_indexes: PackageIndexes = app_manifest_package_indexes(document, package)
            return paths if package_indexes.notices == JSON_INDEX_NONE
            raise MacosAppManifestError.InvalidNoticeList if package_indexes.notices >= document.nodes.count
            raw_notices: JsonNode = document.nodes[package_indexes.notices]
            raise MacosAppManifestError.InvalidNoticeList if raw_notices.kind != JsonNodeKind.Array
            raise MacosAppManifestError.PathLimitExceeded if raw_notices.child_count > PathLimits::ENTRIES
            for index in 0..<raw_notices.child_count |document, raw_notices, paths|:
                entry_index: usize = try app_manifest_array_item(document, raw_notices, index)
                entry: sview = try app_manifest_text_view(document, entry_index)
                raise MacosAppManifestError.InvalidNoticeList if sview_len(entry) == 0 or sview_contains_byte(entry, 0)
                relative: NormalizedPath = app_manifest_normalize_path(entry)
                raise MacosAppManifestError.InvalidNoticeList if relative.absolute or relative.has_parent
                raise MacosAppManifestError.DuplicateNoticePath if app_manifest_path_already_selected(paths, relative.bytes)
                paths.push(relative.bytes)
            return paths


        def app_manifest_byte_allowed_in_name(byte: u8) -> bool:
            return byte >= 48 and byte <= 57 or byte >= 65 and byte <= 90 or byte >= 97 and byte <= 122 or byte == 32 or byte == 46 or byte == 95 or byte == 45


        def app_manifest_safe_name(value: sview) -> darray[u8] error[MacosAppManifestError] can[Memory.Allocate, Abort.Panic]:
            filtered: mutable darray[u8] = []
            for byte in value |filtered|:
                if app_manifest_byte_allowed_in_name(byte):
                    filtered.push(byte)
            start: mutable usize = 0
            end: mutable usize = filtered.count
            while start < end and (filtered[start] == 32 or filtered[start] == 46) |filtered, start, end|:
                start <- start + 1
            while end > start and (filtered[end - 1] == 32 or filtered[end - 1] == 46) |filtered, start, end|:
                end <- end - 1
            raise MacosAppManifestError.InvalidApplicationName if start == end
            result: mutable darray[u8] = []
            for offset in start..<end |filtered, result|:
                result.push(filtered[offset])
            return result


        def app_manifest_default_bundle_id(name: darray[u8]) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            slug: mutable darray[u8] = []
            pending_separator: mutable bool = false
            for byte in name |slug, pending_separator|:
                lower: u8 = byte + 32 if byte >= 65 and byte <= 90 else byte
                if (lower >= 97 and lower <= 122) or (lower >= 48 and lower <= 57):
                    if pending_separator and slug.count > 0:
                        slug.push(45)
                    slug.push(lower)
                    pending_separator <- false
                else:
                    pending_separator <- true
            result: mutable darray[u8] = [111, 114, 103, 46, 101, 108, 105, 115, 97, 46]
            if slug.count == 0:
                for byte in "application" |result|:
                    result.push(byte)
            else:
                for byte in slug |result|:
                    result.push(byte)
            return result


        def app_manifest_utf8_space_width(value: sview, offset: usize) -> usize:
            length: usize = sview_len(value)
            first: u8 = sview_at(value, offset)
            if (first >= 9 and first <= 13) or (first >= 28 and first <= 32):
                return 1
            if first == 194 and offset + 1 < length:
                second: u8 = sview_at(value, offset + 1)
                return 2 if second == 133 or second == 160
            if offset + 2 < length:
                second: u8 = sview_at(value, offset + 1)
                third: u8 = sview_at(value, offset + 2)
                return 3 if first == 225 and second == 154 and third == 128
                return 3 if first == 226 and second == 128 and (third >= 128 and third <= 138 or third == 168 or third == 169 or third == 175)
                return 3 if first == 226 and second == 129 and third == 159
                return 3 if first == 227 and second == 128 and third == 128
            return 0


        def app_manifest_text_has_non_whitespace(value: sview) -> bool:
            cursor: mutable usize = 0
            while cursor < sview_len(value) |value, cursor|:
                whitespace_bytes: usize = app_manifest_utf8_space_width(value, cursor)
                return true if whitespace_bytes == 0
                cursor <- cursor + whitespace_bytes
            return false


        def app_manifest_window_dimension(document: JsonDocument&, node_index: usize, default_value: usize) -> usize error[MacosAppManifestError, JsonContractError]:
            return default_value if node_index == JSON_INDEX_NONE
            raise MacosAppManifestError.InvalidWindowDimension if node_index >= document.nodes.count
            node: JsonNode = document.nodes[node_index]
            raise MacosAppManifestError.InvalidWindowDimension if node.kind != JsonNodeKind.Number
            raise JsonContractError.InvalidScalarPayload if node.scalar_start > document.scalar_data.count
            raise JsonContractError.InvalidScalarPayload if node.scalar_bytes > document.scalar_data.count - node.scalar_start
            raise MacosAppManifestError.InvalidWindowDimension if node.scalar_bytes == 0
            width: mutable usize = 0
            for offset in 0..<node.scalar_bytes |document, node, width|:
                byte: u8 = document.scalar_data[node.scalar_start + offset]
                raise MacosAppManifestError.InvalidWindowDimension if byte < 48 or byte > 57
                raise MacosAppManifestError.InvalidWindowDimension if width > ApplicationDefaults::MAX_WINDOW_DIMENSION / 10
                width <- width * 10 + (byte - 48).usize()
                raise MacosAppManifestError.InvalidWindowDimension if width > ApplicationDefaults::MAX_WINDOW_DIMENSION
            raise MacosAppManifestError.InvalidWindowDimension if width == 0
            return width


    public:
        # Reject mutated or manually constructed selections before a host
        # adapter uses their paths for filesystem access.
        def validate_macos_app_path_selection(selection: MacosAppPathSelection) -> bool error[MacosAppManifestError] can[Memory.Allocate, Abort.Panic]:
            raise MacosAppManifestError.InvalidResourceList if selection.resource_mode != MacosResourceMode.AllAssets and selection.resource_mode != MacosResourceMode.ExplicitPaths
            raise MacosAppManifestError.PathLimitExceeded if selection.resource_paths.count > PathLimits::ENTRIES or selection.notice_paths.count > PathLimits::ENTRIES
            raise MacosAppManifestError.InvalidResourceList if selection.resource_mode == MacosResourceMode.AllAssets and selection.resource_paths.count != 0
            for index in 0..<selection.resource_paths.count |selection|:
                value: sview = bytes_view(selection.resource_paths[index])
                normalized: NormalizedPath = app_manifest_normalize_path(value)
                raise MacosAppManifestError.InvalidResourcePath if not app_manifest_text_has_non_whitespace(value) or normalized.absolute or normalized.has_parent or normalized.has_ignored_name or not app_manifest_bytes_equal(normalized.bytes, selection.resource_paths[index])
                for earlier in 0..<index |selection, value|:
                    raise MacosAppManifestError.InvalidResourcePath if app_manifest_bytes_equal(selection.resource_paths[earlier], selection.resource_paths[index])
            for index in 0..<selection.notice_paths.count |selection|:
                value: sview = bytes_view(selection.notice_paths[index])
                normalized: NormalizedPath = app_manifest_normalize_path(value)
                raise MacosAppManifestError.InvalidNoticeList if sview_len(value) == 0 or sview_contains_byte(value, 0) or normalized.absolute or normalized.has_parent or not app_manifest_bytes_equal(normalized.bytes, selection.notice_paths[index])
                for earlier in 0..<index |selection, value|:
                    raise MacosAppManifestError.DuplicateNoticePath if app_manifest_bytes_equal(selection.notice_paths[earlier], selection.notice_paths[index])
            return true


        # Mirrors manifest_resources() followed by manifest_notices(). The
        # returned relative paths are pathlib-normalized lexical paths; notice
        # existence, symlink, containment, and nonempty-file checks still
        # belong to the filesystem adapter.
        def decode_macos_app_path_selection(document: JsonDocument&) -> MacosAppPathSelection error[JsonContractError, MacosAppManifestError] can[Memory.Allocate, Abort.Panic]:
            try validate_json_document(document)
            raise JsonContractError.InvalidDocumentState if document.state != JsonDocumentState.Sealed
            raise MacosAppManifestError.InvalidJsonPolicy if document.policy.duplicate_keys != JsonDuplicateKeyPolicy.KeepLast or document.policy.trailing_commas != JsonTrailingCommaPolicy.Reject or document.policy.allow_comments
            raise MacosAppManifestError.InvalidManifestRoot if document.roots.count != 1
            root_index: usize = document.roots[0]
            raise MacosAppManifestError.InvalidManifestRoot if root_index >= document.nodes.count
            root: JsonNode = document.nodes[root_index]
            raise MacosAppManifestError.InvalidManifestRoot if root.kind != JsonNodeKind.Object
            root_indexes: RootIndexes = app_manifest_root_indexes(document, root)
            selection: mutable MacosAppPathSelection = try app_manifest_resources(document, root_indexes)
            selection.notice_paths <- try app_manifest_notices(document, root_indexes)
            return selection


        # Mirrors manifest_application() and manifest_window() in the Python
        # packager. output_setting remains unresolved for the path adapter.
        def decode_macos_app_settings(document: JsonDocument&, project_name: sview) -> MacosAppSettings error[JsonContractError, MacosAppManifestError] can[Memory.Allocate, Abort.Panic]:
            try validate_json_document(document)
            raise JsonContractError.InvalidDocumentState if document.state != JsonDocumentState.Sealed
            raise MacosAppManifestError.InvalidJsonPolicy if document.policy.duplicate_keys != JsonDuplicateKeyPolicy.KeepLast or document.policy.trailing_commas != JsonTrailingCommaPolicy.Reject or document.policy.allow_comments
            raise MacosAppManifestError.InvalidManifestRoot if document.roots.count != 1
            root_index: usize = document.roots[0]
            raise MacosAppManifestError.InvalidManifestRoot if root_index >= document.nodes.count
            root: JsonNode = document.nodes[root_index]
            raise MacosAppManifestError.InvalidManifestRoot if root.kind != JsonNodeKind.Object
            root_indexes: RootIndexes = app_manifest_root_indexes(document, root)

            application_indexes: ApplicationIndexes = ApplicationIndexes{}
            if root_indexes.application != JSON_INDEX_NONE:
                raise MacosAppManifestError.InvalidApplication if root_indexes.application >= document.nodes.count
                application: JsonNode = document.nodes[root_indexes.application]
                raise MacosAppManifestError.InvalidApplication if application.kind != JsonNodeKind.Object
                application_indexes <- app_manifest_application_indexes(document, application)

            title: sview = project_name
            if application_indexes.title != JSON_INDEX_NONE:
                title <- try app_manifest_text_view(document, application_indexes.title)
            elif root_indexes.name != JSON_INDEX_NONE:
                title <- try app_manifest_text_view(document, root_indexes.name)
            raise MacosAppManifestError.InvalidTextField if not app_manifest_text_has_non_whitespace(title)
            clean_name: darray[u8] = try app_manifest_safe_name(title)

            output_setting: darray[u8] = []
            if root_indexes.output == JSON_INDEX_NONE:
                default_output: sview = "build/" + bytes_view(clean_name)
                output_setting <- app_manifest_copy_text(default_output)
            else:
                raw_output: sview = try app_manifest_text_view(document, root_indexes.output)
                raise MacosAppManifestError.InvalidOutput if sview_len(raw_output) == 0 or sview_contains_byte(raw_output, 0)
                output_setting <- app_manifest_copy_text(raw_output)

            bundle_id: darray[u8] = []
            if application_indexes.bundle_id == JSON_INDEX_NONE:
                bundle_id <- app_manifest_default_bundle_id(clean_name)
            else:
                raw_bundle_id: sview = try app_manifest_text_view(document, application_indexes.bundle_id)
                bundle_id <- app_manifest_copy_text(raw_bundle_id) if sview_len(raw_bundle_id) != 0 else app_manifest_default_bundle_id(clean_name)

            width: usize = try app_manifest_window_dimension(document, application_indexes.width, ApplicationDefaults::WINDOW_WIDTH)
            height: usize = try app_manifest_window_dimension(document, application_indexes.height, ApplicationDefaults::WINDOW_HEIGHT)
            return MacosAppSettings{
                name: clean_name,
                bundle_id: bundle_id,
                output_setting: output_setting,
                window_title: app_manifest_copy_text(title),
                window_width: width,
                window_height: height
            }
