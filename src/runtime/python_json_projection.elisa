# Predicate-scoped projection for CPython's non-RFC JSON float constants.
# This deliberately maps NaN and infinities to integer 1: callers may use it
# only when their observations preserve truthiness and non-string type checks,
# not when they inspect numeric identity, ordering, formatting, or arithmetic.
# Callers must cap the source before invoking this allocating projection.
module EsPythonJsonProjection:
    public:
        def normalize_truthy_nonfinite_json_constants(source: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            normalized: mutable darray[u8] = []
            inside_string: mutable bool = false
            escaped: mutable bool = false
            offset: mutable usize = 0
            while offset < len(source) |source, normalized, inside_string, escaped, offset|:
                byte: u8 = sview_at(source, offset)
                if inside_string:
                    normalized.push(byte)
                    if escaped:
                        escaped <- false
                    elif byte == 92u8:
                        escaped <- true
                    elif byte == 34u8:
                        inside_string <- false
                    offset <- offset + 1
                elif byte == 34u8:
                    normalized.push(byte)
                    inside_string <- true
                    offset <- offset + 1
                else:
                    token_bytes: usize = python_json_nonfinite_token_bytes(source, offset)
                    if token_bytes != 0:
                        normalized.push(PythonJsonProjection::TRUTHY_REPLACEMENT)
                        offset <- offset + token_bytes
                    else:
                        normalized.push(byte)
                        offset <- offset + 1
            return normalized


    private:
        def python_json_nonfinite_token_bytes(source: sview, offset: usize) -> usize:
            return 0 if not python_json_value_boundary_before(source, offset)
            token_bytes: mutable usize = 0
            if python_json_source_matches_at(source, offset, PythonJsonProjection::NEGATIVE_INFINITY):
                token_bytes <- len(PythonJsonProjection::NEGATIVE_INFINITY)
            elif python_json_source_matches_at(source, offset, PythonJsonProjection::NAN):
                token_bytes <- len(PythonJsonProjection::NAN)
            elif python_json_source_matches_at(source, offset, PythonJsonProjection::POSITIVE_INFINITY):
                token_bytes <- len(PythonJsonProjection::POSITIVE_INFINITY)
            return 0 if token_bytes == 0 or not python_json_value_boundary_after(source, offset + token_bytes)
            return token_bytes


        def python_json_source_matches_at(source: sview, offset: usize, expected: sview) -> bool:
            return false if offset > len(source)
            return false if len(expected) > len(source) - offset
            for index in 0..<len(expected) |source, offset, expected|:
                return false if sview_at(source, offset + index) != sview_at(expected, index)
            return true


        def python_json_value_boundary_before(source: sview, offset: usize) -> bool:
            return true if offset == 0
            previous: u8 = sview_at(source, offset - 1)
            return previous == 32u8 or previous == 9u8 or previous == 10u8 or previous == 13u8 or previous == 44u8 or previous == 58u8 or previous == 91u8 or previous == 123u8


        def python_json_value_boundary_after(source: sview, offset: usize) -> bool:
            return true if offset == len(source)
            following: u8 = sview_at(source, offset)
            return following == 32u8 or following == 9u8 or following == 10u8 or following == 13u8 or following == 44u8 or following == 93u8 or following == 125u8


        const module PythonJsonProjection:
            NAN: sview = "NaN"
            POSITIVE_INFINITY: sview = "Infinity"
            NEGATIVE_INFINITY: sview = "-Infinity"
            TRUTHY_REPLACEMENT: u8 = 49
