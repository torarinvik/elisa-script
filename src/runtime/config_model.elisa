# Typed configuration precedence and deterministic materialization.
#
# Configuration is data until a host adapter reads a file or environment and
# supplies one of the explicit layers. Command-line values win over
# environment, file, and defaults; an unset layer is represented by no entry,
# while an empty value remains an intentional value. The resolver owns no file,
# process, or global-environment effects.

include "hash_model.elisa"
include "text_view_compat.elisa"

using EsTextViewCompat

module EsConfig:
    using EsTextViewCompat

    public:
        const module Limits:
            LAYERS: usize = 4
            ENTRIES_PER_LAYER: usize = 4096
            OUTPUTS: usize = 4096
            KEY_BYTES: usize = 4096
            VALUE_BYTES: usize = 65536
            LAYER_BYTES: usize = 16777216
            OUTPUT_BYTES: usize = 16777216
            INDEX_SLOTS: usize = 8192


        const enum ConfigSource of u8:
            Defaults
            File
            Environment
            CommandLine


        struct ConfigEntry:
            key: sview
            value: sview


        struct ConfigLayer:
            source: ConfigSource
            entries: mutable darray[ConfigEntry] = []


        struct ConfigValue:
            key: sview
            value: sview
            source: ConfigSource


        struct ConfigLookup:
            present: bool = false
            value: sview = ""
            source: ConfigSource = ConfigSource.Defaults


        error ConfigError:
            LayerLimitExceeded
            EntryLimitExceeded
            LayerBytesExceeded
            OutputLimitExceeded
            OutputBytesExceeded
            InvalidSource
            DuplicateLayer
            InvalidKey
            KeyTooLong
            ValueTooLong
            DuplicateKey
            InvalidValue
            IndexInvalid


    private:
        def config_source_valid(source: ConfigSource) -> bool:
            return source in {ConfigSource.Defaults, ConfigSource.File, ConfigSource.Environment, ConfigSource.CommandLine}


        def config_source_priority(source: ConfigSource) -> usize:
            return 0 if source == ConfigSource.Defaults else 1 if source == ConfigSource.File else 2 if source == ConfigSource.Environment else 3


        def config_key_valid(key: sview) -> bool:
            key_length: usize = EsTextViewCompat::length(key, Limits::VALUE_BYTES)
            return false if key_length == 0
            for index in 0..<key_length |key|:
                byte: u8 = EsTextViewCompat::byte_at(key, index)
                return false if byte < 32 or byte == 127 or byte == 61
            return true


        def config_value_valid(value: sview) -> bool:
            # Process arguments and environment values may contain line breaks;
            # only NUL is unrepresentable at the host C-string boundary.
            value_length: usize = EsTextViewCompat::length(value, Limits::VALUE_BYTES)
            for index in 0..<value_length |value|:
                return false if EsTextViewCompat::byte_at(value, index) == 0
            return true


        def config_entry_bytes(key: sview, value: sview) -> usize:
            return EsTextViewCompat::length(key, Limits::VALUE_BYTES) + EsTextViewCompat::length(value, Limits::VALUE_BYTES) + 2


        def config_entry_fits(current: usize, key: sview, value: sview, limit: usize) -> bool:
            return false if current > limit
            remaining: mutable usize = limit - current
            key_bytes: usize = EsTextViewCompat::length(key, Limits::VALUE_BYTES)
            value_bytes: usize = EsTextViewCompat::length(value, Limits::VALUE_BYTES)
            return false if key_bytes > remaining
            remaining <- remaining - key_bytes
            return false if value_bytes > remaining
            remaining <- remaining - value_bytes
            return remaining >= 2


        def config_sview_less(left: sview, right: sview) -> bool:
            left_length: usize = EsTextViewCompat::length(left, Limits::VALUE_BYTES)
            right_length: usize = EsTextViewCompat::length(right, Limits::VALUE_BYTES)
            shared: usize = left_length if left_length < right_length else right_length
            for index in 0..<shared |left, right|:
                left_byte: u8 = EsTextViewCompat::byte_at(left, index)
                right_byte: u8 = EsTextViewCompat::byte_at(right, index)
                return left_byte < right_byte if left_byte != right_byte
            return left_length < right_length


        # The pinned compiler predates its global `sorted` helper. Use an
        # in-place heapsort here so validation stays O(n log n) under the
        # configured 4096-entry ceiling on both compiler versions.
        def config_sview_sift_down(values: mutable darray[sview]&, root_start: usize, end: usize) -> void:
            root: mutable usize = root_start
            while root < end / 2 |values, root, end|:
                child: usize = root * 2 + 1
                swap: mutable usize = root
                swap <- child if config_sview_less(values[swap], values[child])
                swap <- child + 1 if child + 1 < end and config_sview_less(values[swap], values[child + 1])
                return if swap == root
                temporary: sview = values[root]
                values[root] <- values[swap]
                values[swap] <- temporary
                root <- swap


        def config_sort_sviews(values: mutable darray[sview]&) -> void:
            start: mutable usize = values.count / 2
            while start > 0 |values, start|:
                start <- start - 1
                config_sview_sift_down(values, start, values.count)
            end: mutable usize = values.count
            while end > 1 |values, end|:
                end <- end - 1
                temporary: sview = values[0]
                values[0] <- values[end]
                values[end] <- temporary
                config_sview_sift_down(values, 0, end)


        def config_sorted_sviews(keys: darray[sview]) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            ordered: mutable darray[sview] = []
            for key in keys |keys, ordered|:
                ordered.push(key)
            config_sort_sviews(ordered)
            return ordered


        def config_keys_unique(keys: darray[sview]) -> bool can[Memory.Allocate, Abort.Panic]:
            ordered: darray[sview] = config_sorted_sviews(keys)
            for index in 1..<ordered.count |ordered|:
                return false if ordered[index - 1] == ordered[index]
            return true


        const module Hash:
            FNV_OFFSET: u64 = 14695981039346656037u64
            FNV_PRIME: u64 = 1099511628211u64


        def config_key_hash(key: sview) -> u64:
            hash: mutable u64 = Hash::FNV_OFFSET
            key_length: usize = EsTextViewCompat::length(key, Limits::VALUE_BYTES)
            for index in 0..<key_length |key, hash|:
                byte: u8 = EsTextViewCompat::byte_at(key, index)
                hash <- EsHash::hash_wrapping_multiply_u64(hash ^ byte.u64(), Hash::FNV_PRIME)
            return hash


        def config_index_find(values: darray[ConfigValue], slots: darray[usize], key: sview) -> usize error[ConfigError]:
            return values.count if slots.count == 0
            slot: mutable usize = (config_key_hash(key) % slots.count.u64()).usize()
            for probe in 0..<slots.count |values, slots, key, slot|:
                stored: usize = slots[slot]
                return values.count if stored == 0
                value_index: usize = stored - 1
                raise ConfigError.IndexInvalid if value_index >= values.count
                return value_index if values[value_index].key == key
                slot <- 0 if slot + 1 == slots.count else slot + 1
            return values.count


        def config_index_place(values: darray[ConfigValue], slots: mutable darray[usize]&, value_index: usize) -> void error[ConfigError]:
            raise ConfigError.IndexInvalid if slots.count != Limits::INDEX_SLOTS or value_index >= values.count
            slot: mutable usize = (config_key_hash(values[value_index].key) % slots.count.u64()).usize()
            for probe in 0..<slots.count |values, slots, value_index, slot|:
                if slots[slot] == 0:
                    slots[slot] <- value_index + 1
                    return
                stored_index: usize = slots[slot] - 1
                raise ConfigError.IndexInvalid if stored_index >= values.count
                raise ConfigError.DuplicateKey if values[stored_index].key == values[value_index].key
                slot <- 0 if slot + 1 == slots.count else slot + 1
            raise ConfigError.IndexInvalid


        def config_value_index(values: darray[ConfigValue], key: sview) -> usize:
            for index in 0..<values.count |values, key|:
                return index if values[index].key == key
            return values.count


        def config_layer_valid(layer: ConfigLayer) -> bool error[ConfigError] can[Memory.Allocate, Abort.Panic]:
            raise ConfigError.InvalidSource if not config_source_valid(layer.source)
            raise ConfigError.EntryLimitExceeded if layer.entries.count > Limits::ENTRIES_PER_LAYER
            layer_bytes: mutable usize = 0
            keys: mutable darray[sview] = []
            for index in 0..<layer.entries.count |layer|:
                entry: ConfigEntry = layer.entries[index]
                raise ConfigError.InvalidKey if not config_key_valid(entry.key)
                raise ConfigError.KeyTooLong if EsTextViewCompat::length(entry.key, Limits::VALUE_BYTES) >= Limits::KEY_BYTES
                raise ConfigError.ValueTooLong if EsTextViewCompat::length(entry.value, Limits::VALUE_BYTES) >= Limits::VALUE_BYTES
                raise ConfigError.InvalidValue if not config_value_valid(entry.value)
                raise ConfigError.LayerBytesExceeded if not config_entry_fits(layer_bytes, entry.key, entry.value, Limits::LAYER_BYTES)
                layer_bytes <- layer_bytes + config_entry_bytes(entry.key, entry.value)
                keys.push(entry.key)
            raise ConfigError.DuplicateKey if not config_keys_unique(keys)
            return true


        def config_values_valid(values: darray[ConfigValue]) -> bool error[ConfigError] can[Memory.Allocate, Abort.Panic]:
            raise ConfigError.OutputLimitExceeded if values.count > Limits::OUTPUTS
            output_bytes: mutable usize = 0
            keys: mutable darray[sview] = []
            for index in 0..<values.count |values|:
                value: ConfigValue = values[index]
                raise ConfigError.InvalidSource if not config_source_valid(value.source)
                raise ConfigError.InvalidKey if not config_key_valid(value.key)
                raise ConfigError.KeyTooLong if EsTextViewCompat::length(value.key, Limits::VALUE_BYTES) >= Limits::KEY_BYTES
                raise ConfigError.ValueTooLong if EsTextViewCompat::length(value.value, Limits::VALUE_BYTES) >= Limits::VALUE_BYTES
                raise ConfigError.InvalidValue if not config_value_valid(value.value)
                raise ConfigError.OutputBytesExceeded if not config_entry_fits(output_bytes, value.key, value.value, Limits::OUTPUT_BYTES)
                output_bytes <- output_bytes + config_entry_bytes(value.key, value.value)
                keys.push(value.key)
            raise ConfigError.DuplicateKey if not config_keys_unique(keys)
            return true


    public:
        def validate_config_layers(layers: darray[ConfigLayer]) -> bool error[ConfigError] can[Memory.Allocate, Abort.Panic]:
            raise ConfigError.LayerLimitExceeded if layers.count > Limits::LAYERS
            for index in 0..<layers.count |layers|:
                layer: ConfigLayer = layers[index]
                try config_layer_valid(layer)
                for earlier in 0..<index |layers, layer|:
                    raise ConfigError.DuplicateLayer if layers[earlier].source == layer.source
            return true


        def resolve_config_layers(layers: darray[ConfigLayer]) -> darray[ConfigValue] error[ConfigError] can[Memory.Allocate, Abort.Panic]:
            try validate_config_layers(layers)
            result: mutable darray[ConfigValue] = []
            index_slots: mutable darray[usize] = []
            result_bytes: mutable usize = 0
            for layer in layers:
                for entry in layer.entries:
                    index: usize = try config_index_find(result, index_slots, entry.key)
                    candidate: ConfigValue = ConfigValue{key: entry.key, value: entry.value, source: layer.source}
                    if index == result.count:
                        raise ConfigError.OutputLimitExceeded if result.count >= Limits::OUTPUTS
                        raise ConfigError.OutputBytesExceeded if not config_entry_fits(result_bytes, entry.key, entry.value, Limits::OUTPUT_BYTES)
                        if index_slots.count == 0:
                            index_slots.reserve(Limits::INDEX_SLOTS)
                            for _ in 0..<Limits::INDEX_SLOTS |index_slots|:
                                index_slots.push(0)
                        result.push(candidate)
                        try config_index_place(result, index_slots, result.count - 1)
                        result_bytes <- result_bytes + config_entry_bytes(entry.key, entry.value)
                    elif config_source_priority(layer.source) > config_source_priority(result[index].source):
                        previous_bytes: usize = config_entry_bytes(result[index].key, result[index].value)
                        without_previous: usize = result_bytes - previous_bytes
                        raise ConfigError.OutputBytesExceeded if not config_entry_fits(without_previous, entry.key, entry.value, Limits::OUTPUT_BYTES)
                        result[index] <- candidate
                        result_bytes <- without_previous + config_entry_bytes(entry.key, entry.value)
            keys: mutable darray[sview] = []
            for value in result |keys|:
                keys.push(value.key)
            ordered_keys: darray[sview] = config_sorted_sviews(keys)
            ordered_values: mutable darray[ConfigValue] = []
            for key in ordered_keys |result, index_slots, key, ordered_values|:
                index: usize = try config_index_find(result, index_slots, key)
                raise ConfigError.IndexInvalid if index >= result.count
                ordered_values.push(result[index])
            result <- ordered_values
            return result


        def lookup_config_value(values: darray[ConfigValue], key: sview) -> ConfigLookup error[ConfigError] can[Memory.Allocate, Abort.Panic]:
            try config_values_valid(values)
            raise ConfigError.InvalidKey if not config_key_valid(key)
            raise ConfigError.KeyTooLong if EsTextViewCompat::length(key, Limits::VALUE_BYTES) >= Limits::KEY_BYTES
            index: usize = config_value_index(values, key)
            return ConfigLookup{} if index == values.count
            return ConfigLookup{present: true, value: values[index].value, source: values[index].source}
