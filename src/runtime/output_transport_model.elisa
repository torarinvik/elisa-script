# Renderer-to-host byte transport contract.
#
# EsOutputRender owns format order and escaped-size accounting.  This module
# owns the hand-off between that renderer and a host writer: it admits only
# complete, in-order frame acknowledgements and keeps all byte limits visible
# in a small state machine. It can return canonical frame bytes for every
# supported output format, but deliberately does not retain a borrowed text
# view or call an OS writer. The host adapter writes a payload during the
# session and acknowledges it before advancing the renderer.

module EsOutputTransport:
    using EsOutput
    using EsOutputHuman
    using EsOutputJson
    using EsOutputJunit
    using EsOutputRender

    public:
        const module Limits:
            CHUNKS: usize = EsOutputRender::Limits::CHUNKS
            BYTES: usize = EsOutput::Limits::TEXT_BYTES
            FRAME_BYTES: usize = EsOutput::Limits::TEXT_BYTES


        const enum OutputTransportState of u8:
            Planned
            Streaming
            Complete
            Failed
            Cancelling
            Cancelled


        const enum OutputTransportEvent of u8:
            Begin
            Emit
            Fail
            Cancel
            CancelAck


        struct OutputTransportPolicy:
            max_chunks: usize = Limits::CHUNKS
            max_bytes: usize = Limits::BYTES
            max_frame_bytes: usize = Limits::FRAME_BYTES
            color_enabled: bool = false


        # Canonical bytes for one peeked frame. Hosts should write this payload
        # rather than independently formatting from the frame descriptor.
        struct OutputTransportPayload:
            frame: OutputRenderFrame
            bytes: darray[u8]


        # `frame` contains no text. `OutputTransportPayload` couples it with
        # canonical owned bytes so the checked acknowledgement path can reject
        # accidental host-side reformatting or payload mutation.
        struct OutputTransport:
            renderer: mutable OutputRender
            policy: OutputTransportPolicy
            state: mutable OutputTransportState = OutputTransportState.Planned
            next_frame: mutable usize = 0
            emitted_bytes: mutable usize = 0
            frames: mutable usize = 0


        error OutputTransportError:
            InvalidState
            InvalidEvent
            InvalidPolicy
            RendererInvalid
            FrameNotReady
            FrameOrderInvalid
            FrameMismatch
            FramePayloadMismatch
            FrameFormatUnsupported
            FrameTooLarge
            ShortWrite
            UnexpectedPayload
            ChunkLimitExceeded
            ByteLimitExceeded
            AccountingInvalid
            Incomplete
            CancelNotReady


    private:
        def output_transport_state_valid(state: OutputTransportState) -> bool:
            return state in {OutputTransportState.Planned, OutputTransportState.Streaming, OutputTransportState.Complete, OutputTransportState.Failed, OutputTransportState.Cancelling, OutputTransportState.Cancelled}


        def output_transport_event_valid(event: OutputTransportEvent) -> bool:
            return event in {OutputTransportEvent.Begin, OutputTransportEvent.Emit, OutputTransportEvent.Fail, OutputTransportEvent.Cancel, OutputTransportEvent.CancelAck}


        def output_transport_policy_valid(policy: OutputTransportPolicy) -> bool:
            return policy.max_chunks != 0 and policy.max_chunks <= Limits::CHUNKS and policy.max_bytes != 0 and policy.max_bytes <= Limits::BYTES and policy.max_frame_bytes != 0 and policy.max_frame_bytes <= Limits::FRAME_BYTES and policy.max_frame_bytes <= policy.max_bytes


        def output_transport_frame_matches(left: OutputRenderFrame, right: OutputRenderFrame) -> bool:
            return left.kind == right.kind and left.record_index == right.record_index and left.sequence == right.sequence and left.bytes == right.bytes and left.final_frame == right.final_frame


        def output_transport_frame_is_empty_payload(frame: OutputRenderFrame) -> bool:
            return frame.kind == OutputRenderFrameKind.Header and frame.record_index == 0 and frame.sequence == 0 and frame.bytes == 0 and not frame.final_frame


        def output_transport_renderer_state_valid(transport: OutputTransport&) -> bool:
            if transport.state == OutputTransportState.Planned:
                return transport.renderer.state == OutputRenderState.Ready and transport.next_frame == 0 and transport.frames == 0 and transport.emitted_bytes == 0
            if transport.state == OutputTransportState.Streaming:
                return (transport.renderer.state == OutputRenderState.Ready or transport.renderer.state == OutputRenderState.Rendering) and transport.next_frame == transport.renderer.chunks and transport.frames == transport.next_frame
            if transport.state == OutputTransportState.Complete:
                return transport.renderer.state == OutputRenderState.Complete and transport.next_frame == transport.renderer.chunks and transport.frames == transport.next_frame
            if transport.state == OutputTransportState.Failed or transport.state == OutputTransportState.Cancelling or transport.state == OutputTransportState.Cancelled:
                return (transport.renderer.state == OutputRenderState.Ready or transport.renderer.state == OutputRenderState.Rendering) and transport.next_frame == transport.renderer.chunks and transport.frames == transport.next_frame
            return false


        def output_transport_add(current: usize, addition: usize, limit: usize) -> bool:
            return current <= limit and addition <= limit - current


        def output_transport_render_frame_bytes(transport: OutputTransport&, frame: OutputRenderFrame) -> darray[u8] error[OutputTransportError, OutputContractError, OutputHumanError, OutputJsonError, OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            format: OutputFormat = transport.renderer.document.options.format
            if frame.kind == OutputRenderFrameKind.Header:
                if format == OutputFormat.Human:
                    return try render_output_human_header_frame(transport.renderer.document, transport.policy.max_frame_bytes, transport.policy.color_enabled)
                elif format == OutputFormat.Json:
                    return try render_output_json_header_frame(transport.renderer.document, transport.policy.max_frame_bytes)
                elif format == OutputFormat.Junit:
                    return try render_output_junit_header_frame(transport.renderer.document, transport.policy.max_frame_bytes)
            elif frame.kind == OutputRenderFrameKind.Record:
                raise OutputTransportError.FrameOrderInvalid if frame.record_index >= transport.renderer.document.records.count
                record: OutputRecord = transport.renderer.document.records[frame.record_index]
                if format == OutputFormat.Human:
                    return try render_output_human_record_frame(record, transport.policy.color_enabled, transport.policy.max_frame_bytes)
                elif format == OutputFormat.Json:
                    return try render_output_json_record_frame(record, frame.record_index == 0, transport.policy.max_frame_bytes)
                elif format == OutputFormat.Junit:
                    return try render_output_junit_record_frame(record, transport.policy.max_frame_bytes)
            elif frame.kind == OutputRenderFrameKind.Footer:
                if format == OutputFormat.Human:
                    return try render_output_human_footer_frame(transport.renderer.document, transport.policy.max_frame_bytes, transport.policy.color_enabled)
                elif format == OutputFormat.Json:
                    return try render_output_json_footer_frame(transport.renderer.document, transport.policy.max_frame_bytes)
                elif format == OutputFormat.Junit:
                    return try render_output_junit_footer_frame(transport.policy.max_frame_bytes)
            raise OutputTransportError.FrameFormatUnsupported


        def output_transport_payload_bytes_equal(left: darray[u8], right: darray[u8]) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            return true


        def output_transport_planned_preflight(transport: OutputTransport&) -> bool error[OutputTransportError, OutputRenderError]:
            document: OutputDocument = transport.renderer.document
            raise OutputTransportError.ChunkLimitExceeded if document.records.count > transport.policy.max_chunks
            raise OutputTransportError.ChunkLimitExceeded if transport.policy.max_chunks - document.records.count < 2
            effective_total_limit: usize = transport.policy.max_bytes if transport.policy.max_bytes < document.options.max_bytes else document.options.max_bytes
            effective_frame_limit: usize = transport.policy.max_frame_bytes if transport.policy.max_frame_bytes < effective_total_limit else effective_total_limit
            if effective_total_limit < document.options.max_bytes or effective_frame_limit < document.options.max_bytes:
                catch measure_output_render_document_bytes(document, transport.policy.color_enabled, transport.policy.max_bytes, transport.policy.max_frame_bytes):
                    ok total:
                        _ = total
                    error failure:
                        if failure == OutputRenderError.FrameLimitExceeded:
                            raise OutputTransportError.FrameTooLarge
                        raise failure
            return true


    public:
        def validate_output_transport(transport: OutputTransport&) -> bool error[OutputTransportError, OutputRenderError]:
            raise OutputTransportError.InvalidState if not output_transport_state_valid(transport.state)
            raise OutputTransportError.InvalidPolicy if not output_transport_policy_valid(transport.policy)
            try validate_output_render(transport.renderer)
            raise OutputTransportError.AccountingInvalid if transport.emitted_bytes > transport.policy.max_bytes
            raise OutputTransportError.ChunkLimitExceeded if transport.frames > transport.policy.max_chunks
            raise OutputTransportError.AccountingInvalid if transport.next_frame != transport.frames
            raise OutputTransportError.AccountingInvalid if transport.emitted_bytes != transport.renderer.emitted_bytes
            raise OutputTransportError.AccountingInvalid if not output_transport_renderer_state_valid(transport)
            if transport.state == OutputTransportState.Planned:
                _ = try output_transport_planned_preflight(transport)
            return true


        def begin_output_transport(document: OutputDocument&, policy: OutputTransportPolicy = OutputTransportPolicy{}) -> OutputTransport error[OutputTransportError, OutputRenderError]:
            raise OutputTransportError.InvalidPolicy if not output_transport_policy_valid(policy)
            raise OutputTransportError.InvalidPolicy if document.options.format == OutputFormat.Human and document.options.color == OutputColorMode.Always and not policy.color_enabled
            raise OutputTransportError.InvalidPolicy if document.options.format == OutputFormat.Human and document.options.color == OutputColorMode.Never and policy.color_enabled
            renderer: OutputRender = OutputRender{document: document, color_enabled: policy.color_enabled}
            transport: mutable OutputTransport = OutputTransport{renderer: renderer, policy: policy}
            try validate_output_transport(transport)
            return transport


        def peek_output_transport_frame(transport: OutputTransport&) -> OutputRenderFrame error[OutputTransportError, OutputRenderError]:
            try validate_output_transport(transport)
            raise OutputTransportError.FrameNotReady if transport.state != OutputTransportState.Planned and transport.state != OutputTransportState.Streaming
            frame: OutputRenderFrame = try peek_output_render_frame(transport.renderer)
            raise OutputTransportError.FrameOrderInvalid if frame.sequence != transport.next_frame
            raise OutputTransportError.FrameTooLarge if frame.bytes > transport.policy.max_frame_bytes
            raise OutputTransportError.ByteLimitExceeded if not output_transport_add(transport.emitted_bytes, frame.bytes, transport.policy.max_bytes)
            return frame


        def peek_output_transport_payload(transport: OutputTransport&) -> OutputTransportPayload error[OutputTransportError, OutputRenderError, OutputContractError, OutputHumanError, OutputJsonError, OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            frame: OutputRenderFrame = try peek_output_transport_frame(transport)
            bytes: darray[u8] = try output_transport_render_frame_bytes(transport, frame)
            raise OutputTransportError.FrameMismatch if bytes.count != frame.bytes
            return OutputTransportPayload{frame: frame, bytes: bytes}


        def acknowledge_output_transport_payload(transport: mutable OutputTransport&, payload: OutputTransportPayload, written_bytes: usize) -> OutputTransportState error[OutputTransportError, OutputRenderError, OutputContractError, OutputHumanError, OutputJsonError, OutputJunitError] can[Memory.Allocate, Abort.Panic]:
            expected: OutputTransportPayload = try peek_output_transport_payload(transport)
            raise OutputTransportError.FrameMismatch if not output_transport_frame_matches(payload.frame, expected.frame)
            raise OutputTransportError.FramePayloadMismatch if not output_transport_payload_bytes_equal(payload.bytes, expected.bytes)
            return try advance_output_transport(transport, OutputTransportEvent.Emit, payload.frame, written_bytes)


        def advance_output_transport(transport: mutable OutputTransport&, event: OutputTransportEvent, frame: OutputRenderFrame = OutputRenderFrame{}, written_bytes: usize = 0) -> OutputTransportState error[OutputTransportError, OutputRenderError]:
            try validate_output_transport(transport)
            raise OutputTransportError.InvalidEvent if not output_transport_event_valid(event)
            raise OutputTransportError.UnexpectedPayload if event != OutputTransportEvent.Emit and (not output_transport_frame_is_empty_payload(frame) or written_bytes != 0)
            if event == OutputTransportEvent.Begin:
                raise OutputTransportError.InvalidState if transport.state != OutputTransportState.Planned
                transport.state <- OutputTransportState.Streaming
            elif event == OutputTransportEvent.Emit:
                raise OutputTransportError.InvalidState if transport.state != OutputTransportState.Streaming
                expected: OutputRenderFrame = try peek_output_transport_frame(transport)
                raise OutputTransportError.FrameMismatch if not output_transport_frame_matches(frame, expected)
                raise OutputTransportError.ShortWrite if written_bytes != expected.bytes
                raise OutputTransportError.ChunkLimitExceeded if transport.frames >= transport.policy.max_chunks
                raise OutputTransportError.ByteLimitExceeded if not output_transport_add(transport.emitted_bytes, written_bytes, transport.policy.max_bytes)
                advanced: mutable OutputRenderFrame = OutputRenderFrame{}
                try next_output_render_frame(transport.renderer, advanced)
                raise OutputTransportError.FrameMismatch if not output_transport_frame_matches(advanced, expected)
                transport.emitted_bytes <- transport.emitted_bytes + written_bytes
                transport.frames <- transport.frames + 1
                transport.next_frame <- transport.next_frame + 1
                transport.state <- OutputTransportState.Complete if transport.renderer.state == OutputRenderState.Complete
            elif event == OutputTransportEvent.Fail:
                raise OutputTransportError.InvalidState if transport.state != OutputTransportState.Planned and transport.state != OutputTransportState.Streaming
                transport.state <- OutputTransportState.Failed
            elif event == OutputTransportEvent.Cancel:
                raise OutputTransportError.CancelNotReady if transport.state != OutputTransportState.Planned and transport.state != OutputTransportState.Streaming
                transport.state <- OutputTransportState.Cancelling
            elif event == OutputTransportEvent.CancelAck:
                raise OutputTransportError.CancelNotReady if transport.state != OutputTransportState.Cancelling
                transport.state <- OutputTransportState.Cancelled
            return transport.state
