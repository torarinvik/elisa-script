# Verified, deterministic bytecode facade for Elisascript.
#
# This first backend keeps semantic opcodes and typed operand pools intact while
# assigning each CFG block a contiguous bytecode offset. A later packed encoder can
# replace `Instruction` payloads without changing the verifier or source-level IR.

module EsBytecode:
    public:
        const enum BytecodeDispatchClass of u8:
            Literal
            Frame
            Unary
            Aggregate
            Text
            Regex
            Filesystem
            Process
            Environment
            Directory
            Stdio
            Binary
            Call
            Effect
            Observation
            Handler
            Continuation
            Invalid


        struct BytecodeBlock:
            id: u32
            parameter_start: u32
            parameter_count: u16
            instruction_offset: u32
            instruction_count: u32
            terminator: Terminator


        struct BytecodeFunction:
            name: sview
            parameters: darray[Parameter]
            return_type: Type
            effects: darray[sview]
            errors: darray[sview]
            operand_pool: darray[u32]
            edge_arg_pool: darray[u32]
            block_parameter_pool: darray[Parameter]
            instructions: darray[Instruction]
            dispatch_classes: darray[BytecodeDispatchClass]
            blocks: darray[BytecodeBlock]
            entry: u32


        struct BytecodeModule:
            name: sview
            functions: darray[BytecodeFunction]
            handlers: darray[Handler]


        struct BytecodeLowerResult:
            module: BytecodeModule
            issues: darray[Issue]


        const enum BytecodePreflightState of u8:
            Function
            Instruction
            Done
            Invalid


        const enum BytecodeOpcodeClassState of u8:
            Classify


        struct BytecodeOpcodeClassCursor:
            state: mutable BytecodeOpcodeClassState
            opcode: Opcode
            result: mutable BytecodeDispatchClass


        struct BytecodePreflightCursor:
            state: mutable BytecodePreflightState
            function_index: mutable usize
            instruction_index: mutable usize


        const enum BytecodeControlState of u8:
            Instruction
            Terminator
            Done
            Invalid


        const enum BytecodeControlAction of u8:
            ExecuteInstruction
            Jump
            Return
            Invalid


        struct BytecodeControlCursor:
            state: mutable BytecodeControlState
            block_index: mutable usize
            instruction_index: mutable usize
            action: mutable BytecodeControlAction
            target: mutable u32
            edge_start: mutable u32
            edge_count: mutable u16


        const enum BytecodeExecutionState of u8:
            EnterBlock
            Condition
            SelectAction
            ExecuteInstruction
            StoreInstruction
            DispatchAction
            ValidateJump
            CollectEdge
            BindEdge
            Done


        struct BytecodeExecutionCursor:
            state: mutable BytecodeExecutionState
            control: mutable BytecodeControlCursor
            entered: mutable bool
            branch_condition: mutable bool
            target_index: mutable usize
            edge_offset: mutable usize
            pending: mutable darray[RuntimeValue]
            value: mutable RuntimeValue
            result: mutable RuntimeValue
            steps: mutable u64


        const enum BytecodeValueState of u8:
            Execute
            Done


        struct BytecodeValueCursor:
            state: mutable BytecodeValueState
            opcode: Opcode
            value: mutable RuntimeValue


        const enum BytecodeBinaryState of u8:
            Select
            EqualityKind
            EqualityResult
            Float
            Integer
            Done


        struct BytecodeBinaryCursor:
            state: mutable BytecodeBinaryState
            opcode: Opcode
            left: RuntimeValue
            right: RuntimeValue
            equal: mutable bool
            value: mutable RuntimeValue


        def empty_bytecode_module(name: sview) -> BytecodeModule:
            return BytecodeModule{name: name, functions: [], handlers: []}


        # Every semantic opcode is assigned one stable dispatch family. The
        # exhaustive machine is deliberately independent of instruction layout:
        # packed and direct encodings can share the same family handlers.
        def bytecode_opcode_class(opcode: Opcode) -> BytecodeDispatchClass:
            cursor: mutable BytecodeOpcodeClassCursor = BytecodeOpcodeClassCursor{state: BytecodeOpcodeClassState.Classify, opcode: opcode, result: BytecodeDispatchClass.Invalid}
            machine over cursor.state:
                state Classify
                start Classify

                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.Constant:
                    cursor.result <- BytecodeDispatchClass.Literal
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.Copy:
                    cursor.result <- BytecodeDispatchClass.Frame
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.Negate or cursor.opcode == Opcode.Not or cursor.opcode == Opcode.BitNot:
                    cursor.result <- BytecodeDispatchClass.Unary
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.MakeArray or cursor.opcode == Opcode.MakeMap or cursor.opcode == Opcode.MapKeys or cursor.opcode == Opcode.Index or cursor.opcode == Opcode.Length or cursor.opcode == Opcode.Slice or cursor.opcode == Opcode.Contains or cursor.opcode == Opcode.SetIndex:
                    cursor.result <- BytecodeDispatchClass.Aggregate
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.MakePath or cursor.opcode == Opcode.MakeGlob or cursor.opcode == Opcode.MakeRegex or cursor.opcode == Opcode.MakeUrl:
                    cursor.result <- BytecodeDispatchClass.Literal
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.Concat or cursor.opcode == Opcode.Split or cursor.opcode == Opcode.Join or cursor.opcode == Opcode.ParseInt or cursor.opcode == Opcode.FormatInt or cursor.opcode == Opcode.ParseFloat or cursor.opcode == Opcode.FormatFloat:
                    cursor.result <- BytecodeDispatchClass.Text
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.RegexSearch or cursor.opcode == Opcode.RegexReplace or cursor.opcode == Opcode.RegexSplit:
                    cursor.result <- BytecodeDispatchClass.Regex
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.PathJoin or cursor.opcode == Opcode.PathParent or cursor.opcode == Opcode.PathName or cursor.opcode == Opcode.PathExtension or cursor.opcode == Opcode.PathStem or cursor.opcode == Opcode.PathExists or cursor.opcode == Opcode.ReadText or cursor.opcode == Opcode.WriteText or cursor.opcode == Opcode.RemovePath or cursor.opcode == Opcode.CopyPath or cursor.opcode == Opcode.MovePath:
                    cursor.result <- BytecodeDispatchClass.Filesystem
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.MakeExecutable or cursor.opcode == Opcode.RunProcess or cursor.opcode == Opcode.CaptureProcessStdout or cursor.opcode == Opcode.CaptureProcessStderr or cursor.opcode == Opcode.CaptureProcessStdoutWithStdin or cursor.opcode == Opcode.CaptureProcessResult or cursor.opcode == Opcode.ProcessResultExitStatus or cursor.opcode == Opcode.ProcessResultStdout or cursor.opcode == Opcode.ProcessResultStderr:
                    cursor.result <- BytecodeDispatchClass.Process
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.GetEnvironment or cursor.opcode == Opcode.SetEnvironment or cursor.opcode == Opcode.UnsetEnvironment:
                    cursor.result <- BytecodeDispatchClass.Environment
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.CreateDirectory or cursor.opcode == Opcode.RemoveDirectory or cursor.opcode == Opcode.CurrentDirectory or cursor.opcode == Opcode.ChangeDirectory or cursor.opcode == Opcode.ListDirectory or cursor.opcode == Opcode.IsDirectory or cursor.opcode == Opcode.ExpandGlob:
                    cursor.result <- BytecodeDispatchClass.Directory
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.ReadStdin or cursor.opcode == Opcode.WriteStdout or cursor.opcode == Opcode.WriteStderr:
                    cursor.result <- BytecodeDispatchClass.Stdio
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.Add or cursor.opcode == Opcode.Subtract or cursor.opcode == Opcode.Multiply or cursor.opcode == Opcode.Divide or cursor.opcode == Opcode.Equal or cursor.opcode == Opcode.Less or cursor.opcode == Opcode.Remainder or cursor.opcode == Opcode.NotEqual or cursor.opcode == Opcode.LessEqual or cursor.opcode == Opcode.Greater or cursor.opcode == Opcode.GreaterEqual or cursor.opcode == Opcode.BitAnd or cursor.opcode == Opcode.BitOr or cursor.opcode == Opcode.BitXor or cursor.opcode == Opcode.ShiftLeft or cursor.opcode == Opcode.ShiftRight:
                    cursor.result <- BytecodeDispatchClass.Binary
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.Call:
                    cursor.result <- BytecodeDispatchClass.Call
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.Perform:
                    cursor.result <- BytecodeDispatchClass.Effect
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.Observe:
                    cursor.result <- BytecodeDispatchClass.Observation
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.HandlerPush or cursor.opcode == Opcode.HandlerPop:
                    cursor.result <- BytecodeDispatchClass.Handler
                    break
                Classify, BytecodeOpcodeClassState.Classify if cursor.opcode == Opcode.Resume:
                    cursor.result <- BytecodeDispatchClass.Continuation
                    break

                Classify, BytecodeOpcodeClassState.Classify:
                    break

            return cursor.result


        # Validate the parallel dispatch table with explicit state transitions.
        # This is cheap enough for the bootstrap path and prevents a stale packed
        # class table from silently selecting the wrong handler.
        def bytecode_dispatch_table_valid(module: BytecodeModule&) -> bool:
            cursor: mutable BytecodePreflightCursor = BytecodePreflightCursor{state: BytecodePreflightState.Function, function_index: 0, instruction_index: 0}
            machine over cursor.state while cursor.state != BytecodePreflightState.Done and cursor.state != BytecodePreflightState.Invalid:
                state Validate
                start Validate

                Validate, BytecodePreflightState.Function if cursor.function_index >= module.functions.count:
                    cursor.state <- BytecodePreflightState.Done
                    -> Validate
                Validate, BytecodePreflightState.Function:
                    cursor.instruction_index <- 0
                    cursor.state <- BytecodePreflightState.Instruction
                    -> Validate

                Validate, BytecodePreflightState.Instruction if cursor.instruction_index >= module.functions[cursor.function_index].instructions.count and module.functions[cursor.function_index].dispatch_classes.count != module.functions[cursor.function_index].instructions.count:
                    cursor.state <- BytecodePreflightState.Invalid
                    -> Validate
                Validate, BytecodePreflightState.Instruction if cursor.instruction_index >= module.functions[cursor.function_index].instructions.count and module.functions[cursor.function_index].dispatch_classes.count == module.functions[cursor.function_index].instructions.count:
                    cursor.function_index <- cursor.function_index + 1
                    cursor.state <- BytecodePreflightState.Function
                    -> Validate
                Validate, BytecodePreflightState.Instruction if cursor.instruction_index >= module.functions[cursor.function_index].dispatch_classes.count:
                    cursor.state <- BytecodePreflightState.Invalid
                    -> Validate
                Validate, BytecodePreflightState.Instruction if bytecode_opcode_class(module.functions[cursor.function_index].instructions[cursor.instruction_index].opcode) == BytecodeDispatchClass.Invalid:
                    cursor.state <- BytecodePreflightState.Invalid
                    -> Validate
                Validate, BytecodePreflightState.Instruction if bytecode_opcode_class(module.functions[cursor.function_index].instructions[cursor.instruction_index].opcode) != module.functions[cursor.function_index].dispatch_classes[cursor.instruction_index]:
                    cursor.state <- BytecodePreflightState.Invalid
                    -> Validate
                Validate, BytecodePreflightState.Instruction:
                    cursor.instruction_index <- cursor.instruction_index + 1
                    -> Validate

                Validate, BytecodePreflightState.Done | BytecodePreflightState.Invalid:
                    break

            return cursor.state == BytecodePreflightState.Done


        # Advance one packed program-counter step. The value/effect engine will
        # supply branch_condition and execute the returned instruction; this
        # machine owns only structural control flow and never guesses a value.
        def bytecode_next_control(function: BytecodeFunction&, cursor: mutable BytecodeControlCursor&, branch_condition: bool) -> BytecodeControlAction:
            cursor.action <- BytecodeControlAction.Invalid
            machine over cursor.state:
                state Step
                start Step

                Step, BytecodeControlState.Instruction if cursor.block_index >= function.blocks.count:
                    cursor.state <- BytecodeControlState.Invalid
                    -> Step
                Step, BytecodeControlState.Instruction if cursor.instruction_index < function.blocks[cursor.block_index].instruction_count.usize():
                    cursor.action <- BytecodeControlAction.ExecuteInstruction
                    cursor.instruction_index <- cursor.instruction_index + 1
                    cursor.state <- BytecodeControlState.Done
                    -> Step
                Step, BytecodeControlState.Instruction:
                    cursor.state <- BytecodeControlState.Terminator
                    -> Step

                Step, BytecodeControlState.Terminator if cursor.block_index >= function.blocks.count:
                    cursor.state <- BytecodeControlState.Invalid
                    -> Step
                Step, BytecodeControlState.Terminator if function.blocks[cursor.block_index].terminator.kind == TerminatorKind.Return:
                    cursor.action <- BytecodeControlAction.Return
                    cursor.state <- BytecodeControlState.Done
                    -> Step
                Step, BytecodeControlState.Terminator if function.blocks[cursor.block_index].terminator.kind == TerminatorKind.Jump:
                    cursor.action <- BytecodeControlAction.Jump
                    cursor.target <- function.blocks[cursor.block_index].terminator.target0
                    cursor.edge_start <- function.blocks[cursor.block_index].terminator.edge0_arg_start
                    cursor.edge_count <- function.blocks[cursor.block_index].terminator.edge0_arg_count
                    cursor.state <- BytecodeControlState.Done
                    -> Step
                Step, BytecodeControlState.Terminator if function.blocks[cursor.block_index].terminator.kind == TerminatorKind.Branch and branch_condition:
                    cursor.action <- BytecodeControlAction.Jump
                    cursor.target <- function.blocks[cursor.block_index].terminator.target0
                    cursor.edge_start <- function.blocks[cursor.block_index].terminator.edge0_arg_start
                    cursor.edge_count <- function.blocks[cursor.block_index].terminator.edge0_arg_count
                    cursor.state <- BytecodeControlState.Done
                    -> Step
                Step, BytecodeControlState.Terminator if function.blocks[cursor.block_index].terminator.kind == TerminatorKind.Branch:
                    cursor.action <- BytecodeControlAction.Jump
                    cursor.target <- function.blocks[cursor.block_index].terminator.target1
                    cursor.edge_start <- function.blocks[cursor.block_index].terminator.edge1_arg_start
                    cursor.edge_count <- function.blocks[cursor.block_index].terminator.edge1_arg_count
                    cursor.state <- BytecodeControlState.Done
                    -> Step
                Step, BytecodeControlState.Terminator:
                    cursor.state <- BytecodeControlState.Invalid
                    -> Step

                Step, BytecodeControlState.Done | BytecodeControlState.Invalid:
                    break

            return cursor.action


        def bytecode_direct_frame_value(ids: darray[u32]&, values: darray[RuntimeValue]&, id: u32) -> RuntimeValue:
            for index in 0..<ids.count |ids, values, id|:
                return values[index] if ids[index] == id
            return runtime_void()


        def bytecode_direct_set_frame_value(ids: mutable darray[u32]&, values: mutable darray[RuntimeValue]&, id: u32, value: RuntimeValue) can[Memory.Allocate, Abort.Panic]:
            for index in 0..<ids.count |ids, values, id, value|:
                if ids[index] == id:
                    values[index] <- value
                    return
            ids.push(id)
            values.push(value)


        def bytecode_direct_binary(opcode: Opcode, left: RuntimeValue, right: RuntimeValue) -> RuntimeValue:
            cursor: mutable BytecodeBinaryCursor = BytecodeBinaryCursor{state: BytecodeBinaryState.Select, opcode: opcode, left: left, right: right, equal: false, value: runtime_void()}
            machine over cursor.state:
                state Binary
                start Binary

                Binary, BytecodeBinaryState.Select if cursor.opcode == Opcode.Equal or cursor.opcode == Opcode.NotEqual:
                    cursor.state <- BytecodeBinaryState.EqualityKind
                    -> Binary
                Binary, BytecodeBinaryState.Select if cursor.left.kind == RuntimeValueKind.Float and cursor.right.kind == RuntimeValueKind.Float:
                    cursor.state <- BytecodeBinaryState.Float
                    -> Binary
                Binary, BytecodeBinaryState.Select if cursor.left.kind != RuntimeValueKind.Int or cursor.right.kind != RuntimeValueKind.Int:
                    cursor.value <- runtime_void()
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Select:
                    cursor.state <- BytecodeBinaryState.Integer
                    -> Binary

                Binary, BytecodeBinaryState.EqualityKind if cursor.left.kind != cursor.right.kind:
                    cursor.value <- runtime_void()
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.EqualityKind if cursor.left.kind == RuntimeValueKind.Int:
                    cursor.equal <- cursor.left.integer == cursor.right.integer
                    cursor.state <- BytecodeBinaryState.EqualityResult
                    -> Binary
                Binary, BytecodeBinaryState.EqualityKind if cursor.left.kind == RuntimeValueKind.Bool:
                    cursor.equal <- cursor.left.boolean == cursor.right.boolean
                    cursor.state <- BytecodeBinaryState.EqualityResult
                    -> Binary
                Binary, BytecodeBinaryState.EqualityKind if cursor.left.kind == RuntimeValueKind.Float:
                    cursor.equal <- cursor.left.decimal == cursor.right.decimal
                    cursor.state <- BytecodeBinaryState.EqualityResult
                    -> Binary
                Binary, BytecodeBinaryState.EqualityKind if cursor.left.kind == RuntimeValueKind.Text:
                    cursor.equal <- cursor.left.text == cursor.right.text
                    cursor.state <- BytecodeBinaryState.EqualityResult
                    -> Binary
                Binary, BytecodeBinaryState.EqualityKind if cursor.left.kind == RuntimeValueKind.ProcessCapture:
                    cursor.equal <- cursor.left.process_exit_status == cursor.right.process_exit_status and cursor.left.process_stdout == cursor.right.process_stdout and cursor.left.process_stderr == cursor.right.process_stderr
                    cursor.state <- BytecodeBinaryState.EqualityResult
                    -> Binary
                Binary, BytecodeBinaryState.EqualityKind:
                    cursor.state <- BytecodeBinaryState.EqualityResult
                    -> Binary

                Binary, BytecodeBinaryState.EqualityResult if cursor.opcode == Opcode.Equal:
                    cursor.value <- runtime_bool(cursor.equal)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.EqualityResult:
                    cursor.value <- runtime_bool(not cursor.equal)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary

                Binary, BytecodeBinaryState.Float if cursor.opcode == Opcode.Add:
                    cursor.value <- runtime_float(cursor.left.decimal + cursor.right.decimal)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Float if cursor.opcode == Opcode.Subtract:
                    cursor.value <- runtime_float(cursor.left.decimal - cursor.right.decimal)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Float if cursor.opcode == Opcode.Multiply:
                    cursor.value <- runtime_float(cursor.left.decimal * cursor.right.decimal)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Float if cursor.opcode == Opcode.Divide:
                    cursor.value <- runtime_float(cursor.left.decimal / cursor.right.decimal)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Float if cursor.opcode == Opcode.Less:
                    cursor.value <- runtime_bool(cursor.left.decimal < cursor.right.decimal)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Float if cursor.opcode == Opcode.LessEqual:
                    cursor.value <- runtime_bool(cursor.left.decimal <= cursor.right.decimal)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Float if cursor.opcode == Opcode.Greater:
                    cursor.value <- runtime_bool(cursor.left.decimal > cursor.right.decimal)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Float:
                    cursor.value <- runtime_bool(cursor.left.decimal >= cursor.right.decimal)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary

                Binary, BytecodeBinaryState.Integer if cursor.opcode == Opcode.Add:
                    cursor.value <- runtime_int(cursor.left.integer + cursor.right.integer)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer if cursor.opcode == Opcode.Subtract:
                    cursor.value <- runtime_int(cursor.left.integer - cursor.right.integer)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer if cursor.opcode == Opcode.Multiply:
                    cursor.value <- runtime_int(cursor.left.integer * cursor.right.integer)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer if cursor.opcode == Opcode.Divide and cursor.right.integer == 0:
                    cursor.value <- runtime_void()
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer if cursor.opcode == Opcode.Divide:
                    cursor.value <- runtime_int(cursor.left.integer / cursor.right.integer)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer if cursor.opcode == Opcode.Remainder and cursor.right.integer == 0:
                    cursor.value <- runtime_void()
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer if cursor.opcode == Opcode.Remainder:
                    cursor.value <- runtime_int(cursor.left.integer % cursor.right.integer)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer if cursor.opcode == Opcode.BitAnd:
                    cursor.value <- runtime_int(cursor.left.integer & cursor.right.integer)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer if cursor.opcode == Opcode.BitOr:
                    cursor.value <- runtime_int(cursor.left.integer | cursor.right.integer)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer if cursor.opcode == Opcode.BitXor:
                    cursor.value <- runtime_int(cursor.left.integer ^ cursor.right.integer)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer if (cursor.opcode == Opcode.ShiftLeft or cursor.opcode == Opcode.ShiftRight) and (cursor.right.integer < 0 or cursor.right.integer >= 64):
                    cursor.value <- runtime_void()
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer if cursor.opcode == Opcode.ShiftLeft:
                    cursor.value <- runtime_int(cursor.left.integer << cursor.right.integer.u32())
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer if cursor.opcode == Opcode.ShiftRight:
                    cursor.value <- runtime_int(cursor.left.integer >> cursor.right.integer.u32())
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer if cursor.opcode == Opcode.Less:
                    cursor.value <- runtime_bool(cursor.left.integer < cursor.right.integer)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer if cursor.opcode == Opcode.LessEqual:
                    cursor.value <- runtime_bool(cursor.left.integer <= cursor.right.integer)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer if cursor.opcode == Opcode.Greater:
                    cursor.value <- runtime_bool(cursor.left.integer > cursor.right.integer)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary
                Binary, BytecodeBinaryState.Integer:
                    cursor.value <- runtime_bool(cursor.left.integer >= cursor.right.integer)
                    cursor.state <- BytecodeBinaryState.Done
                    -> Binary

                Binary, BytecodeBinaryState.Done:
                    break

            return cursor.value


        def bytecode_direct_scalar_type(type: Type&) -> bool:
            return true if type.kind == TypeKind.Bool
            return true if type.kind == TypeKind.Text or type.kind == TypeKind.Char
            return true if type.kind == TypeKind.Named and type.name in {"Path", "Glob", "Regex", "Executable", "Url", "ProcessCapture"}
            return true if type.kind == TypeKind.Float and type.bits == 64
            return type.kind == TypeKind.Int and type.bits == 64


        def bytecode_direct_value_type(type: Type&) -> bool:
            return true if bytecode_direct_scalar_type(type)
            if type.kind == TypeKind.Map:
                key_type: Type = Type{kind: type.element_kind, name: type.element_name, bits: type.element_bits, signed: type.element_signed}
                value_type: Type = Type{kind: type.element_element_kind, name: type.element_element_name, bits: type.element_element_bits, signed: type.element_element_signed}
                return bytecode_direct_scalar_type(key_type) and bytecode_direct_scalar_type(value_type)
            return false if type.kind != TypeKind.Array
            return true if type.element_kind == TypeKind.Bool or (type.element_kind == TypeKind.Int and type.element_bits == 64) or (type.element_kind == TypeKind.Float and type.element_bits == 64) or type.element_kind == TypeKind.Text or type.element_kind == TypeKind.Char
            return type.element_kind == TypeKind.Array and (type.element_element_kind == TypeKind.Bool or (type.element_element_kind == TypeKind.Int and type.element_element_bits == 64) or (type.element_element_kind == TypeKind.Float and type.element_element_bits == 64) or type.element_element_kind == TypeKind.Text or type.element_element_kind == TypeKind.Char)


        const enum BytecodeArrayEqualState of u8:
            Select
            Compare
            Value
            Done


        struct BytecodeArrayEqualCursor:
            state: mutable BytecodeArrayEqualState
            left: RuntimeValue
            right: RuntimeValue
            offset: mutable usize
            left_value: mutable RuntimeValue
            right_value: mutable RuntimeValue
            equal: mutable bool


        def bytecode_direct_array_equal(storage: darray[RuntimeValue]&, left: RuntimeValue, right: RuntimeValue) -> bool:
            cursor: mutable BytecodeArrayEqualCursor = BytecodeArrayEqualCursor{state: BytecodeArrayEqualState.Select, left: left, right: right, offset: 0, left_value: runtime_void(), right_value: runtime_void(), equal: false}
            machine over cursor.state:
                state ArrayEqual
                start ArrayEqual

                ArrayEqual, BytecodeArrayEqualState.Select if cursor.left.kind != RuntimeValueKind.Array or cursor.right.kind != RuntimeValueKind.Array:
                    cursor.equal <- false
                    cursor.state <- BytecodeArrayEqualState.Done
                    -> ArrayEqual
                ArrayEqual, BytecodeArrayEqualState.Select if cursor.left.array_count != cursor.right.array_count:
                    cursor.equal <- false
                    cursor.state <- BytecodeArrayEqualState.Done
                    -> ArrayEqual
                ArrayEqual, BytecodeArrayEqualState.Select if not runtime_array_range_valid(storage, cursor.left) or not runtime_array_range_valid(storage, cursor.right):
                    cursor.equal <- false
                    cursor.state <- BytecodeArrayEqualState.Done
                    -> ArrayEqual
                ArrayEqual, BytecodeArrayEqualState.Select:
                    cursor.offset <- 0
                    cursor.state <- BytecodeArrayEqualState.Compare
                    -> ArrayEqual

                ArrayEqual, BytecodeArrayEqualState.Compare if cursor.offset >= cursor.left.array_count.usize():
                    cursor.equal <- true
                    cursor.state <- BytecodeArrayEqualState.Done
                    -> ArrayEqual
                ArrayEqual, BytecodeArrayEqualState.Compare:
                    cursor.left_value <- storage[cursor.left.array_start.usize() + cursor.offset]
                    cursor.right_value <- storage[cursor.right.array_start.usize() + cursor.offset]
                    cursor.state <- BytecodeArrayEqualState.Value
                    -> ArrayEqual

                ArrayEqual, BytecodeArrayEqualState.Value if cursor.left_value.kind != cursor.right_value.kind:
                    cursor.equal <- false
                    cursor.state <- BytecodeArrayEqualState.Done
                    -> ArrayEqual
                ArrayEqual, BytecodeArrayEqualState.Value if cursor.left_value.kind == RuntimeValueKind.Int and cursor.left_value.integer != cursor.right_value.integer:
                    cursor.equal <- false
                    cursor.state <- BytecodeArrayEqualState.Done
                    -> ArrayEqual
                ArrayEqual, BytecodeArrayEqualState.Value if cursor.left_value.kind == RuntimeValueKind.Bool and cursor.left_value.boolean != cursor.right_value.boolean:
                    cursor.equal <- false
                    cursor.state <- BytecodeArrayEqualState.Done
                    -> ArrayEqual
                ArrayEqual, BytecodeArrayEqualState.Value if cursor.left_value.kind == RuntimeValueKind.Float and cursor.left_value.decimal != cursor.right_value.decimal:
                    cursor.equal <- false
                    cursor.state <- BytecodeArrayEqualState.Done
                    -> ArrayEqual
                ArrayEqual, BytecodeArrayEqualState.Value if cursor.left_value.kind == RuntimeValueKind.Text and cursor.left_value.text != cursor.right_value.text:
                    cursor.equal <- false
                    cursor.state <- BytecodeArrayEqualState.Done
                    -> ArrayEqual
                ArrayEqual, BytecodeArrayEqualState.Value if cursor.left_value.kind == RuntimeValueKind.Array and not bytecode_direct_array_equal(storage, cursor.left_value, cursor.right_value):
                    cursor.equal <- false
                    cursor.state <- BytecodeArrayEqualState.Done
                    -> ArrayEqual
                ArrayEqual, BytecodeArrayEqualState.Value:
                    cursor.offset <- cursor.offset + 1
                    cursor.state <- BytecodeArrayEqualState.Compare
                    -> ArrayEqual

                ArrayEqual, BytecodeArrayEqualState.Done:
                    break

            return cursor.equal


        def bytecode_direct_map_equal(storage: darray[RuntimeValue]&, left: RuntimeValue, right: RuntimeValue) -> bool:
            false return if left.kind != RuntimeValueKind.Map or right.kind != RuntimeValueKind.Map
            false return if left.map_count != right.map_count
            false return if not runtime_map_range_valid(storage, left) or not runtime_map_range_valid(storage, right)
            matched: mutable darray[bool] = []
            for _ in 0..<right.map_count.usize() |matched|:
                matched.push(false)
            for left_offset in 0..<left.map_count.usize() |storage, left, right|:
                left_key: RuntimeValue = storage[left.map_start.usize() + left_offset * 2]
                left_value: RuntimeValue = storage[left.map_start.usize() + left_offset * 2 + 1]
                found: mutable bool = false
                for right_offset in 0..<right.map_count.usize() |storage, right, left_key, left_value, found, matched|:
                    right_key: RuntimeValue = storage[right.map_start.usize() + right_offset * 2]
                    right_value: RuntimeValue = storage[right.map_start.usize() + right_offset * 2 + 1]
                    key_equal: bool = bytecode_direct_scalar_equal(right_key, left_key)
                    value_equal: bool = bytecode_direct_scalar_equal(right_value, left_value)
                    if not matched[right_offset] and key_equal and value_equal:
                        found <- true
                        matched[right_offset] <- true
                false return if not found
            return true


        def bytecode_direct_scalar_equal(left: RuntimeValue, right: RuntimeValue) -> bool:
            false return if left.kind != right.kind
            return left.integer == right.integer if left.kind == RuntimeValueKind.Int
            return left.boolean == right.boolean if left.kind == RuntimeValueKind.Bool
            return left.decimal == right.decimal if left.kind == RuntimeValueKind.Float
            return left.text == right.text if left.kind == RuntimeValueKind.Text
            return left.process_exit_status == right.process_exit_status and left.process_stdout == right.process_stdout and left.process_stderr == right.process_stderr if left.kind == RuntimeValueKind.ProcessCapture
            return left.kind == RuntimeValueKind.Void


        def bytecode_direct_text_matches_at(text: sview, separator: sview, start: usize) -> bool:
            false return if start + sview_len(separator) > sview_len(text)
            for offset in 0..<sview_len(separator) |text, separator, start|:
                false return if sview_at(text, start + offset) != sview_at(separator, offset)
            return true


        def bytecode_direct_text_contains(haystack: sview, needle: sview) -> bool:
            true return if sview_len(needle) == 0
            false return if sview_len(needle) > sview_len(haystack)
            for start in 0..=(sview_len(haystack) - sview_len(needle)) |haystack, needle|:
                matched: mutable bool = true
                for offset in 0..<sview_len(needle) |haystack, needle, start, matched|:
                    matched <- false if sview_at(haystack, start + offset) != sview_at(needle, offset)
                true return if matched
            return false


        def bytecode_direct_text_concat(left: RuntimeValue, right: RuntimeValue) -> RuntimeValue error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            raise InterpretError.TypeMismatch if left.kind != RuntimeValueKind.Text or right.kind != RuntimeValueKind.Text
            total: usize = sview_len(left.text) + sview_len(right.text)
            bytes: mutable dstr = ctx_fstr_alloc(total)
            ctx_fstr_append(bytes, left.text.data, sview_len(left.text))
            ctx_fstr_append(bytes, right.text.data, sview_len(right.text))
            return runtime_text(bytes_view(bytes))


        def bytecode_direct_split(storage: mutable darray[RuntimeValue]&, text: RuntimeValue, separator: RuntimeValue) -> RuntimeValue error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            raise InterpretError.TypeMismatch if text.kind != RuntimeValueKind.Text or separator.kind != RuntimeValueKind.Text
            start: u32 = storage.count.u32()
            separator_length: usize = sview_len(separator.text)
            if separator_length == 0:
                for index in 0..<sview_len(text.text) |storage, text|:
                    storage.push(runtime_text(text.text[index:index + 1]))
                return runtime_array(start, sview_len(text.text).u32())
            field_start: mutable usize = 0
            cursor: mutable usize = 0
            fields: mutable u32 = 0
            while cursor + separator_length <= sview_len(text.text):
                if bytecode_direct_text_matches_at(text.text, separator.text, cursor):
                    storage.push(runtime_text(text.text[field_start:cursor]))
                    fields <- fields + 1
                    cursor <- cursor + separator_length
                    field_start <- cursor
                else:
                    cursor <- cursor + 1
            storage.push(runtime_text(text.text[field_start:sview_len(text.text)]))
            return runtime_array(start, fields + 1)


        def bytecode_direct_join(storage: darray[RuntimeValue]&, fields: RuntimeValue, separator: RuntimeValue) -> RuntimeValue error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            raise InterpretError.TypeMismatch if fields.kind != RuntimeValueKind.Array or separator.kind != RuntimeValueKind.Text
            raise InterpretError.IndexOutOfBounds if not runtime_array_range_valid(storage, fields)
            return runtime_text("") if fields.array_count == 0
            total: mutable usize = sview_len(separator.text) * (fields.array_count.usize() - 1)
            for offset in 0..<fields.array_count.usize() |storage, fields, total|:
                field: RuntimeValue = storage[fields.array_start.usize() + offset]
                raise InterpretError.TypeMismatch if field.kind != RuntimeValueKind.Text
                total <- total + sview_len(field.text)
            bytes: mutable dstr = ctx_fstr_alloc(total)
            for offset in 0..<fields.array_count.usize() |storage, fields, separator, bytes|:
                if offset > 0:
                    ctx_fstr_append(bytes, separator.text.data, sview_len(separator.text))
                field: RuntimeValue = storage[fields.array_start.usize() + offset]
                ctx_fstr_append(bytes, field.text.data, sview_len(field.text))
            return runtime_text(bytes_view(bytes))


        def bytecode_direct_index(storage: darray[RuntimeValue]&, collection: RuntimeValue, index: RuntimeValue) -> RuntimeValue error[InterpretError]:
            if collection.kind == RuntimeValueKind.Map:
                raise InterpretError.IndexOutOfBounds if not runtime_map_range_valid(storage, collection)
                for offset in 0..<collection.map_count.usize() |storage, collection, index|:
                    key: RuntimeValue = storage[collection.map_start.usize() + offset * 2]
                    return storage[collection.map_start.usize() + offset * 2 + 1] if bytecode_direct_scalar_equal(key, index)
                raise InterpretError.IndexOutOfBounds
            raise InterpretError.TypeMismatch if collection.kind not in {RuntimeValueKind.Array, RuntimeValueKind.Text} or index.kind != RuntimeValueKind.Int
            raise InterpretError.IndexOutOfBounds if collection.kind == RuntimeValueKind.Array and not runtime_array_range_valid(storage, collection)
            length: i64 = collection.array_count.i64() if collection.kind == RuntimeValueKind.Array else sview_len(collection.text).i64()
            raise InterpretError.IndexOutOfBounds if index.integer < 0 or index.integer >= length
            return runtime_text(collection.text[index.integer.usize():index.integer.usize() + 1]) if collection.kind == RuntimeValueKind.Text
            return storage[collection.array_start.usize() + index.integer.usize()]


        def bytecode_direct_slice(storage: darray[RuntimeValue]&, collection: RuntimeValue, low: RuntimeValue, high: RuntimeValue) -> RuntimeValue error[InterpretError]:
            raise InterpretError.TypeMismatch if collection.kind not in {RuntimeValueKind.Array, RuntimeValueKind.Text} or low.kind != RuntimeValueKind.Int or high.kind != RuntimeValueKind.Int
            raise InterpretError.IndexOutOfBounds if collection.kind == RuntimeValueKind.Array and not runtime_array_range_valid(storage, collection)
            length: i64 = collection.array_count.i64() if collection.kind == RuntimeValueKind.Array else sview_len(collection.text).i64()
            raise InterpretError.IndexOutOfBounds if low.integer < 0 or high.integer < low.integer or high.integer > length
            return runtime_text(collection.text[low.integer.usize():high.integer.usize()]) if collection.kind == RuntimeValueKind.Text
            return runtime_array(collection.array_start + low.integer.u32(), (high.integer - low.integer).u32())


        def bytecode_direct_set_index(storage: mutable darray[RuntimeValue]&, collection: RuntimeValue, index: RuntimeValue, replacement: RuntimeValue) -> RuntimeValue error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            if collection.kind == RuntimeValueKind.Map:
                raise InterpretError.IndexOutOfBounds if not runtime_map_range_valid(storage, collection)
                start: u32 = storage.count.u32()
                found: mutable bool = false
                for offset in 0..<collection.map_count.usize() |storage, collection, index, replacement, found|:
                    key: RuntimeValue = storage[collection.map_start.usize() + offset * 2]
                    old_value: RuntimeValue = storage[collection.map_start.usize() + offset * 2 + 1]
                    storage.push(key)
                    storage.push(replacement) if bytecode_direct_scalar_equal(key, index)
                    storage.push(old_value) if not bytecode_direct_scalar_equal(key, index)
                    found <- true if bytecode_direct_scalar_equal(key, index)
                if not found:
                    storage.push(index)
                    storage.push(replacement)
                return runtime_map(start, collection.map_count + 1) if not found
                return runtime_map(start, collection.map_count)
            raise InterpretError.TypeMismatch if collection.kind != RuntimeValueKind.Array or index.kind != RuntimeValueKind.Int
            raise InterpretError.IndexOutOfBounds if not runtime_array_range_valid(storage, collection)
            raise InterpretError.IndexOutOfBounds if index.integer < 0 or index.integer >= collection.array_count.i64()
            old_value: RuntimeValue = storage[collection.array_start.usize() + index.integer.usize()]
            raise InterpretError.TypeMismatch if old_value.kind != replacement.kind
            start: u32 = storage.count.u32()
            storage.reserve(storage.count + collection.array_count.usize())
            for offset in 0..<collection.array_count.usize() |storage, collection|:
                storage.push(storage[collection.array_start.usize() + offset])
            storage[start.usize() + index.integer.usize()] <- replacement
            return runtime_array(start, collection.array_count)


        def bytecode_direct_concat(storage: mutable darray[RuntimeValue]&, left: RuntimeValue, right: RuntimeValue) -> RuntimeValue error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            if left.kind == RuntimeValueKind.Text and right.kind == RuntimeValueKind.Text:
                return try bytecode_direct_text_concat(left, right)
            raise InterpretError.TypeMismatch if left.kind != RuntimeValueKind.Array or right.kind != RuntimeValueKind.Array
            raise InterpretError.IndexOutOfBounds if not runtime_array_range_valid(storage, left) or not runtime_array_range_valid(storage, right)
            start: u32 = storage.count.u32()
            storage.reserve(storage.count + left.array_count.usize() + right.array_count.usize())
            for offset in 0..<left.array_count.usize() |storage, left|:
                storage.push(storage[left.array_start.usize() + offset])
            for offset in 0..<right.array_count.usize() |storage, right|:
                storage.push(storage[right.array_start.usize() + offset])
            return runtime_array(start, left.array_count + right.array_count)


        # Evaluate the closed scalar, aggregate, filesystem, and process subset
        # through a state machine driven by the instruction cursor. Unsupported
        # families never enter this path.
        def bytecode_direct_instruction(module: BytecodeModule&, instruction: Instruction, fn: BytecodeFunction&, ids: darray[u32]&, values: darray[RuntimeValue]&, storage: mutable darray[RuntimeValue]&, observations: mutable darray[Observation]&, step_limit: u64, steps: mutable u64&) -> RuntimeValue error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            operand: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.Negate or instruction.opcode == Opcode.Not or instruction.opcode == Opcode.BitNot:
                operand <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()])
            raise InterpretError.TypeMismatch if instruction.opcode == Opcode.Negate and operand.kind != RuntimeValueKind.Int and operand.kind != RuntimeValueKind.Float
            raise InterpretError.TypeMismatch if instruction.opcode == Opcode.Not and operand.kind != RuntimeValueKind.Bool
            raise InterpretError.TypeMismatch if instruction.opcode == Opcode.BitNot and operand.kind != RuntimeValueKind.Int
            raise InterpretError.IntegerOverflow if instruction.opcode == Opcode.Negate and operand.kind == RuntimeValueKind.Int and operand.integer == -9223372036854775807 - 1
            left: mutable RuntimeValue = runtime_void()
            right: mutable RuntimeValue = runtime_void()
            binary: bool = instruction.opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Equal, Opcode.Less, Opcode.Remainder, Opcode.NotEqual, Opcode.LessEqual, Opcode.Greater, Opcode.GreaterEqual, Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight}
            if binary:
                left <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()])
                right <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1])
            # Preserve the interpreter's typed failure behavior on the packed path.
            # The value-only binary helper cannot report these cases itself, so
            # validate them before host arithmetic executes.
            raise InterpretError.DivisionByZero if (instruction.opcode == Opcode.Divide or instruction.opcode == Opcode.Remainder) and right.kind == RuntimeValueKind.Int and right.integer == 0
            raise InterpretError.IntegerOverflow if (instruction.opcode == Opcode.Divide or instruction.opcode == Opcode.Remainder) and left.kind == RuntimeValueKind.Int and right.kind == RuntimeValueKind.Int and left.integer == -9223372036854775807 - 1 and right.integer == -1
            raise InterpretError.InvalidShift if (instruction.opcode == Opcode.ShiftLeft or instruction.opcode == Opcode.ShiftRight) and right.kind == RuntimeValueKind.Int and (right.integer < 0 or right.integer >= 64)
            observed: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.Observe:
                observed <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()])
            collection: mutable RuntimeValue = runtime_void()
            index_value: mutable RuntimeValue = runtime_void()
            low_value: mutable RuntimeValue = runtime_void()
            high_value: mutable RuntimeValue = runtime_void()
            needle: mutable RuntimeValue = runtime_void()
            replacement: mutable RuntimeValue = runtime_void()
            if instruction.opcode in {Opcode.MapKeys, Opcode.Index, Opcode.Length, Opcode.Slice, Opcode.Contains, Opcode.SetIndex, Opcode.Concat, Opcode.Split, Opcode.Join}:
                collection <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()])
            if instruction.opcode == Opcode.Index or instruction.opcode == Opcode.SetIndex:
                index_value <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1])
            if instruction.opcode == Opcode.Slice:
                low_value <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1])
                high_value <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2])
            if instruction.opcode == Opcode.Contains:
                needle <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()])
                collection <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1])
            separator: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.Split or instruction.opcode == Opcode.Join:
                separator <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1])
            regex_text: mutable RuntimeValue = runtime_void()
            regex_pattern: mutable RuntimeValue = runtime_void()
            regex_replacement: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.RegexSearch or instruction.opcode == Opcode.RegexReplace or instruction.opcode == Opcode.RegexSplit:
                regex_text <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()])
                regex_pattern <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1])
            if instruction.opcode == Opcode.RegexReplace:
                regex_replacement <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2])
            integer_text: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.ParseInt or instruction.opcode == Opcode.FormatInt or instruction.opcode == Opcode.ParseFloat or instruction.opcode == Opcode.FormatFloat:
                integer_text <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()])
            if instruction.opcode == Opcode.SetIndex:
                replacement <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2])
            array_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.MakeArray:
                start: u32 = storage.count.u32()
                for offset in 0..<instruction.operand_count.usize() |storage, fn, instruction, ids, values|:
                    storage.push(bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + offset]))
                array_value <- runtime_array(start, instruction.operand_count.u32())
            map_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.MakeMap:
                if instruction.operand_count % 2 != 0:
                    raise InterpretError.TypeMismatch
                start: u32 = storage.count.u32()
                for offset in 0..<instruction.operand_count.usize() |storage, fn, instruction, ids, values|:
                    storage.push(bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + offset]))
                map_value <- runtime_map(start, (instruction.operand_count / 2).u32())
            keys_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.MapKeys:
                raise InterpretError.TypeMismatch if collection.kind != RuntimeValueKind.Map
                raise InterpretError.IndexOutOfBounds if not runtime_map_range_valid(storage, collection)
                start: u32 = storage.count.u32()
                for offset in 0..<collection.map_count.usize() |storage, collection|:
                    storage.push(storage[collection.map_start.usize() + offset * 2])
                keys_value <- runtime_array(start, collection.map_count)
            indexed_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.Index:
                indexed_value <- try bytecode_direct_index(storage, collection, index_value)
            sliced_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.Slice:
                sliced_value <- try bytecode_direct_slice(storage, collection, low_value, high_value)
            length_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.Length:
                raise InterpretError.TypeMismatch if collection.kind not in {RuntimeValueKind.Array, RuntimeValueKind.Map, RuntimeValueKind.Text}
                length_value <- runtime_int(collection.array_count.i64()) if collection.kind == RuntimeValueKind.Array
                length_value <- runtime_int(collection.map_count.i64()) if collection.kind == RuntimeValueKind.Map
                length_value <- runtime_int(sview_len(collection.text).i64()) if collection.kind == RuntimeValueKind.Text
            contains_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.Contains:
                if collection.kind == RuntimeValueKind.Text:
                    raise InterpretError.TypeMismatch if needle.kind != RuntimeValueKind.Text
                    contains_value <- runtime_bool(bytecode_direct_text_contains(collection.text, needle.text))
                else:
                    if collection.kind == RuntimeValueKind.Array:
                        raise InterpretError.IndexOutOfBounds if not runtime_array_range_valid(storage, collection)
                        found: mutable bool = false
                        for offset in 0..<collection.array_count.usize() |storage, collection, needle, found|:
                            element: RuntimeValue = storage[collection.array_start.usize() + offset]
                            found <- found or (element.kind == needle.kind and ((element.kind == RuntimeValueKind.Int and element.integer == needle.integer) or (element.kind == RuntimeValueKind.Bool and element.boolean == needle.boolean) or (element.kind == RuntimeValueKind.Float and element.decimal == needle.decimal) or (element.kind == RuntimeValueKind.Text and element.text == needle.text) or (element.kind == RuntimeValueKind.Array and bytecode_direct_array_equal(storage, element, needle))))
                        contains_value <- runtime_bool(found)
                    else:
                        raise InterpretError.TypeMismatch if collection.kind != RuntimeValueKind.Map
                        raise InterpretError.IndexOutOfBounds if not runtime_map_range_valid(storage, collection)
                        found: mutable bool = false
                        for offset in 0..<collection.map_count.usize() |storage, collection, needle, found|:
                            key: RuntimeValue = storage[collection.map_start.usize() + offset * 2]
                            found <- found or bytecode_direct_scalar_equal(key, needle)
                        contains_value <- runtime_bool(found)
            updated_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.SetIndex:
                updated_value <- try bytecode_direct_set_index(storage, collection, index_value, replacement)
            concatenated_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.Concat:
                right <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1])
                concatenated_value <- try bytecode_direct_concat(storage, collection, right)
            split_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.Split:
                split_value <- try bytecode_direct_split(storage, collection, separator)
            joined_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.Join:
                joined_value <- try bytecode_direct_join(storage, collection, separator)
            regex_search_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.RegexSearch:
                raise InterpretError.TypeMismatch if regex_text.kind != RuntimeValueKind.Text or regex_pattern.kind != RuntimeValueKind.Text
                regex_search_value <- runtime_bool(EsIr::regex_search_text(regex_text.text, regex_pattern.text))
            regex_replace_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.RegexReplace:
                raise InterpretError.TypeMismatch if regex_text.kind != RuntimeValueKind.Text or regex_pattern.kind != RuntimeValueKind.Text or regex_replacement.kind != RuntimeValueKind.Text
                regex_replace_value <- runtime_text(EsIr::regex_replace_text(regex_text.text, regex_pattern.text, regex_replacement.text))
            regex_split_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.RegexSplit:
                raise InterpretError.TypeMismatch if regex_text.kind != RuntimeValueKind.Text or regex_pattern.kind != RuntimeValueKind.Text
                regex_split_value <- try EsIr::regex_split_value(storage, regex_text.text, regex_pattern.text)
            numeric_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.ParseInt:
                raise InterpretError.TypeMismatch if integer_text.kind != RuntimeValueKind.Text
                numeric_value <- runtime_int(try EsIr::parse_integer_value(integer_text.text))
            if instruction.opcode == Opcode.FormatInt:
                raise InterpretError.TypeMismatch if integer_text.kind != RuntimeValueKind.Int
                numeric_value <- runtime_text(EsIr::format_integer_value(integer_text.integer))
            if instruction.opcode == Opcode.ParseFloat:
                raise InterpretError.TypeMismatch if integer_text.kind != RuntimeValueKind.Text
                numeric_value <- runtime_float(try EsIr::parse_float_value(integer_text.text))
            if instruction.opcode == Opcode.FormatFloat:
                raise InterpretError.TypeMismatch if integer_text.kind != RuntimeValueKind.Float
                numeric_value <- runtime_text(EsIr::format_float_value(integer_text.decimal))
            typed_constructor_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.MakePath or instruction.opcode == Opcode.MakeGlob or instruction.opcode == Opcode.MakeRegex or instruction.opcode == Opcode.MakeUrl:
                typed_constructor_input: RuntimeValue = bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()])
                raise InterpretError.TypeMismatch if typed_constructor_input.kind != RuntimeValueKind.Text
                typed_constructor_value <- runtime_text(typed_constructor_input.text)
            path_value: mutable RuntimeValue = runtime_void()
            filesystem_text: mutable RuntimeValue = runtime_void()
            if instruction.opcode in {Opcode.PathJoin, Opcode.PathParent, Opcode.PathName, Opcode.PathExtension, Opcode.PathStem, Opcode.PathExists, Opcode.ReadText, Opcode.WriteText, Opcode.RemovePath, Opcode.CopyPath, Opcode.MovePath, Opcode.MakeExecutable}:
                path_value <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()])
            path_leaf: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.PathJoin:
                path_leaf <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1])
            if instruction.opcode == Opcode.WriteText:
                filesystem_text <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1])
            destination_path: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.CopyPath or instruction.opcode == Opcode.MovePath:
                destination_path <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1])
            filesystem_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.PathExists:
                raise InterpretError.TypeMismatch if path_value.kind != RuntimeValueKind.Text
                filesystem_value <- runtime_bool(try EsIr::path_exists_text(path_value.text))
            if instruction.opcode == Opcode.ReadText:
                raise InterpretError.TypeMismatch if path_value.kind != RuntimeValueKind.Text
                filesystem_value <- runtime_text(try EsIr::read_text_path(path_value.text))
            if instruction.opcode == Opcode.WriteText:
                raise InterpretError.TypeMismatch if path_value.kind != RuntimeValueKind.Text or filesystem_text.kind != RuntimeValueKind.Text
                filesystem_value <- runtime_int(try EsIr::write_text_path(path_value.text, filesystem_text.text))
            if instruction.opcode == Opcode.RemovePath:
                raise InterpretError.TypeMismatch if path_value.kind != RuntimeValueKind.Text
                filesystem_value <- runtime_bool(try EsIr::remove_path_text(path_value.text))
            if instruction.opcode == Opcode.CopyPath:
                raise InterpretError.TypeMismatch if path_value.kind != RuntimeValueKind.Text or destination_path.kind != RuntimeValueKind.Text
                filesystem_value <- runtime_bool(try EsIr::copy_path_value(path_value.text, destination_path.text))
            if instruction.opcode == Opcode.MovePath:
                raise InterpretError.TypeMismatch if path_value.kind != RuntimeValueKind.Text or destination_path.kind != RuntimeValueKind.Text
                filesystem_value <- runtime_bool(try EsIr::move_path_value(path_value.text, destination_path.text))
            if instruction.opcode == Opcode.MakeExecutable:
                raise InterpretError.TypeMismatch if path_value.kind != RuntimeValueKind.Text
                filesystem_value <- runtime_text(try EsIr::make_executable_text(path_value.text))
            if instruction.opcode == Opcode.PathJoin:
                raise InterpretError.TypeMismatch if path_value.kind != RuntimeValueKind.Text or path_leaf.kind != RuntimeValueKind.Text
                filesystem_value <- runtime_text(EsIr::path_join_value(path_value.text, path_leaf.text))
            if instruction.opcode == Opcode.PathParent:
                raise InterpretError.TypeMismatch if path_value.kind != RuntimeValueKind.Text
                filesystem_value <- runtime_text(EsIr::path_parent_value(path_value.text))
            if instruction.opcode == Opcode.PathName:
                raise InterpretError.TypeMismatch if path_value.kind != RuntimeValueKind.Text
                filesystem_value <- runtime_text(EsIr::path_name_value(path_value.text))
            if instruction.opcode == Opcode.PathExtension:
                raise InterpretError.TypeMismatch if path_value.kind != RuntimeValueKind.Text
                filesystem_value <- runtime_text(EsIr::path_extension_value(path_value.text))
            if instruction.opcode == Opcode.PathStem:
                raise InterpretError.TypeMismatch if path_value.kind != RuntimeValueKind.Text
                filesystem_value <- runtime_text(EsIr::path_stem_value(path_value.text))
            process_executable: mutable RuntimeValue = runtime_void()
            process_arguments: mutable RuntimeValue = runtime_void()
            process_input: mutable RuntimeValue = runtime_void()
            if instruction.opcode in {Opcode.RunProcess, Opcode.CaptureProcessStdout, Opcode.CaptureProcessStderr, Opcode.CaptureProcessStdoutWithStdin, Opcode.CaptureProcessResult}:
                process_executable <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()])
                process_arguments <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1])
                raise InterpretError.TypeMismatch if process_executable.kind != RuntimeValueKind.Text or process_arguments.kind != RuntimeValueKind.Array
            if instruction.opcode == Opcode.CaptureProcessStdoutWithStdin or instruction.opcode == Opcode.CaptureProcessResult:
                process_input <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2])
                raise InterpretError.TypeMismatch if process_input.kind != RuntimeValueKind.Text
            process_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.RunProcess:
                process_value <- runtime_int(try EsIr::run_process_value(storage, process_executable.text, process_arguments))
            if instruction.opcode == Opcode.CaptureProcessStdout:
                process_value <- runtime_text(try EsIr::capture_process_stdout_value(storage, process_executable.text, process_arguments))
            if instruction.opcode == Opcode.CaptureProcessStderr:
                process_value <- runtime_text(try EsIr::capture_process_stderr_value(storage, process_executable.text, process_arguments))
            if instruction.opcode == Opcode.CaptureProcessStdoutWithStdin:
                process_value <- runtime_text(try EsIr::capture_process_stdout_with_stdin_value(storage, process_executable.text, process_arguments, process_input.text))
            if instruction.opcode == Opcode.CaptureProcessResult:
                process_value <- try EsIr::capture_process_result_value(storage, process_executable.text, process_arguments, process_input.text)
            if instruction.opcode == Opcode.ProcessResultExitStatus or instruction.opcode == Opcode.ProcessResultStdout or instruction.opcode == Opcode.ProcessResultStderr:
                process_capture: RuntimeValue = bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()])
                raise InterpretError.TypeMismatch if process_capture.kind != RuntimeValueKind.ProcessCapture
                process_value <- runtime_int(try EsIr::process_exit_status_value(process_capture)) if instruction.opcode == Opcode.ProcessResultExitStatus
                process_value <- runtime_text(try EsIr::process_stdout_value(process_capture)) if instruction.opcode == Opcode.ProcessResultStdout
                process_value <- runtime_text(try EsIr::process_stderr_value(process_capture)) if instruction.opcode == Opcode.ProcessResultStderr
            environment_name: mutable RuntimeValue = runtime_void()
            environment_value_input: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.GetEnvironment or instruction.opcode == Opcode.SetEnvironment or instruction.opcode == Opcode.UnsetEnvironment:
                environment_name <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()])
                raise InterpretError.TypeMismatch if environment_name.kind != RuntimeValueKind.Text
            if instruction.opcode == Opcode.SetEnvironment:
                environment_value_input <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1])
                raise InterpretError.TypeMismatch if environment_value_input.kind != RuntimeValueKind.Text
            environment_result: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.GetEnvironment:
                environment_result <- runtime_text(try EsIr::get_environment_value(environment_name.text))
            if instruction.opcode == Opcode.SetEnvironment:
                environment_result <- runtime_bool(try EsIr::set_environment_value(environment_name.text, environment_value_input.text))
            if instruction.opcode == Opcode.UnsetEnvironment:
                environment_result <- runtime_bool(try EsIr::unset_environment_value(environment_name.text))
            directory_path: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.CreateDirectory or instruction.opcode == Opcode.RemoveDirectory or instruction.opcode == Opcode.ChangeDirectory or instruction.opcode == Opcode.ListDirectory or instruction.opcode == Opcode.IsDirectory or instruction.opcode == Opcode.ExpandGlob:
                directory_path <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()])
                raise InterpretError.TypeMismatch if directory_path.kind != RuntimeValueKind.Text
            directory_result: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.CreateDirectory:
                directory_result <- runtime_bool(try EsIr::create_directory_value(directory_path.text))
            if instruction.opcode == Opcode.RemoveDirectory:
                directory_result <- runtime_bool(try EsIr::remove_directory_value(directory_path.text))
            if instruction.opcode == Opcode.ChangeDirectory:
                directory_result <- runtime_bool(try EsIr::change_directory_value(directory_path.text))
            if instruction.opcode == Opcode.CurrentDirectory:
                directory_result <- runtime_text(try EsIr::current_directory_value())
            if instruction.opcode == Opcode.ListDirectory:
                directory_result <- try EsIr::list_directory_value(storage, directory_path.text)
            if instruction.opcode == Opcode.IsDirectory:
                directory_result <- runtime_bool(try EsIr::is_directory_value(directory_path.text))
            if instruction.opcode == Opcode.ExpandGlob:
                directory_result <- try EsIr::expand_glob_value(storage, directory_path.text)
            stdio_text: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.WriteStdout or instruction.opcode == Opcode.WriteStderr:
                stdio_text <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()])
                raise InterpretError.TypeMismatch if stdio_text.kind != RuntimeValueKind.Text
            stdio_result: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.ReadStdin:
                stdio_result <- runtime_text(try EsIr::read_stdin_value())
            if instruction.opcode == Opcode.WriteStdout:
                stdio_result <- runtime_int(try EsIr::write_stdout_value(stdio_text.text))
            if instruction.opcode == Opcode.WriteStderr:
                stdio_result <- runtime_int(try EsIr::write_stderr_value(stdio_text.text))
            call_value: mutable RuntimeValue = runtime_void()
            if instruction.opcode == Opcode.Call:
                call_arguments: mutable darray[RuntimeValue] = []
                for offset in 0..<instruction.operand_count.usize() |module, instruction, fn, ids, values, call_arguments|:
                    call_arguments.push(bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + offset]))
                remaining: u64 = step_limit - steps
                nested: Execution = try execute_bytecode_direct(module, instruction.symbol, call_arguments, observations, storage, remaining)
                steps <- steps + nested.steps
                call_value <- nested.value
            binary_value: mutable RuntimeValue = runtime_void()
            if binary:
                if (instruction.opcode == Opcode.Equal or instruction.opcode == Opcode.NotEqual) and left.kind == RuntimeValueKind.Array:
                    equal: bool = bytecode_direct_array_equal(storage, left, right)
                    binary_value <- runtime_bool(equal) if instruction.opcode == Opcode.Equal
                    binary_value <- runtime_bool(not equal) if instruction.opcode == Opcode.NotEqual
                elif (instruction.opcode == Opcode.Equal or instruction.opcode == Opcode.NotEqual) and left.kind == RuntimeValueKind.Map:
                    equal: bool = bytecode_direct_map_equal(storage, left, right)
                    binary_value <- runtime_bool(equal) if instruction.opcode == Opcode.Equal
                    binary_value <- runtime_bool(not equal) if instruction.opcode == Opcode.NotEqual
                else:
                    binary_value <- bytecode_direct_binary(instruction.opcode, left, right)
            cursor: mutable BytecodeValueCursor = BytecodeValueCursor{state: BytecodeValueState.Execute, opcode: instruction.opcode, value: runtime_void()}
            machine over cursor.state:
                state Execute
                start Execute

                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Constant and instruction.result_type.kind == TypeKind.Bool:
                    cursor.value <- runtime_bool(instruction.boolean)
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Constant and instruction.result_type.kind == TypeKind.Int:
                    cursor.value <- runtime_int(instruction.integer)
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Constant and instruction.result_type.kind == TypeKind.Float:
                    cursor.value <- runtime_float(EsIr::parse_decimal_value(instruction.decimal))
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Constant and instruction.result_type.kind in {TypeKind.Text, TypeKind.Char, TypeKind.Named}:
                    cursor.value <- runtime_text(instruction.text)
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.MakePath or instruction.opcode == Opcode.MakeGlob or instruction.opcode == Opcode.MakeRegex or instruction.opcode == Opcode.MakeUrl:
                    cursor.value <- typed_constructor_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Copy:
                    cursor.value <- bytecode_direct_frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()])
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Negate and operand.kind == RuntimeValueKind.Int:
                    cursor.value <- runtime_int(-operand.integer)
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Negate and operand.kind == RuntimeValueKind.Float:
                    cursor.value <- runtime_float(-operand.decimal)
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Not:
                    cursor.value <- runtime_bool(not operand.boolean)
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.BitNot:
                    cursor.value <- runtime_int(~operand.integer)
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Equal, Opcode.Less, Opcode.Remainder, Opcode.NotEqual, Opcode.LessEqual, Opcode.Greater, Opcode.GreaterEqual, Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight}:
                    cursor.value <- binary_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.MakeArray:
                    cursor.value <- array_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.MakeMap:
                    cursor.value <- map_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.MapKeys:
                    cursor.value <- keys_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Index:
                    cursor.value <- indexed_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Length:
                    cursor.value <- length_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Slice:
                    cursor.value <- sliced_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Contains:
                    cursor.value <- contains_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.SetIndex:
                    cursor.value <- updated_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Concat:
                    cursor.value <- concatenated_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Split:
                    cursor.value <- split_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Join:
                    cursor.value <- joined_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.RegexSearch:
                    cursor.value <- regex_search_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.RegexReplace:
                    cursor.value <- regex_replace_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.RegexSplit:
                    cursor.value <- regex_split_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.ParseInt or instruction.opcode == Opcode.FormatInt or instruction.opcode == Opcode.ParseFloat or instruction.opcode == Opcode.FormatFloat:
                    cursor.value <- numeric_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.PathJoin or instruction.opcode == Opcode.PathParent or instruction.opcode == Opcode.PathName or instruction.opcode == Opcode.PathExtension or instruction.opcode == Opcode.PathStem or instruction.opcode == Opcode.PathExists or instruction.opcode == Opcode.ReadText or instruction.opcode == Opcode.WriteText or instruction.opcode == Opcode.RemovePath or instruction.opcode == Opcode.CopyPath or instruction.opcode == Opcode.MovePath or instruction.opcode == Opcode.MakeExecutable:
                    cursor.value <- filesystem_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.RunProcess or instruction.opcode == Opcode.CaptureProcessStdout or instruction.opcode == Opcode.CaptureProcessStderr or instruction.opcode == Opcode.CaptureProcessStdoutWithStdin or instruction.opcode == Opcode.CaptureProcessResult or instruction.opcode == Opcode.ProcessResultExitStatus or instruction.opcode == Opcode.ProcessResultStdout or instruction.opcode == Opcode.ProcessResultStderr:
                    cursor.value <- process_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.GetEnvironment or instruction.opcode == Opcode.SetEnvironment or instruction.opcode == Opcode.UnsetEnvironment:
                    cursor.value <- environment_result
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.CreateDirectory or instruction.opcode == Opcode.RemoveDirectory or instruction.opcode == Opcode.ChangeDirectory or instruction.opcode == Opcode.CurrentDirectory or instruction.opcode == Opcode.ListDirectory or instruction.opcode == Opcode.IsDirectory or instruction.opcode == Opcode.ExpandGlob:
                    cursor.value <- directory_result
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.ReadStdin or instruction.opcode == Opcode.WriteStdout or instruction.opcode == Opcode.WriteStderr:
                    cursor.value <- stdio_result
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Call:
                    cursor.value <- call_value
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute if instruction.opcode == Opcode.Observe:
                    observations.push(Observation{trace: instruction.trace.id, value: observed})
                    cursor.state <- BytecodeValueState.Done
                    -> Execute
                Execute, BytecodeValueState.Execute:
                    raise InterpretError.UnsupportedInstruction
                    break

                Execute, BytecodeValueState.Done:
                    break

            return cursor.value


        def bytecode_direct_supported(module: BytecodeModule&) -> bool:
            for function in module.functions:
                if function.return_type.kind != TypeKind.Void and not bytecode_direct_value_type(function.return_type):
                    return false
                for parameter in function.parameters:
                    if not bytecode_direct_value_type(parameter.type):
                        return false
                for parameter in function.block_parameter_pool:
                    if not bytecode_direct_value_type(parameter.type):
                        return false
                for instruction in function.instructions:
                    if instruction.opcode not in {Opcode.Constant, Opcode.Copy, Opcode.Negate, Opcode.Not, Opcode.BitNot, Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Equal, Opcode.Less, Opcode.Remainder, Opcode.NotEqual, Opcode.LessEqual, Opcode.Greater, Opcode.GreaterEqual, Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight, Opcode.Observe, Opcode.MakeArray, Opcode.MakeMap, Opcode.MapKeys, Opcode.MakePath, Opcode.MakeGlob, Opcode.MakeRegex, Opcode.MakeUrl, Opcode.Index, Opcode.Length, Opcode.Slice, Opcode.Contains, Opcode.SetIndex, Opcode.Concat, Opcode.Split, Opcode.Join, Opcode.ParseInt, Opcode.FormatInt, Opcode.ParseFloat, Opcode.FormatFloat, Opcode.RegexSearch, Opcode.RegexReplace, Opcode.RegexSplit, Opcode.PathJoin, Opcode.PathParent, Opcode.PathName, Opcode.PathExtension, Opcode.PathStem, Opcode.PathExists, Opcode.ReadText, Opcode.WriteText, Opcode.RemovePath, Opcode.CopyPath, Opcode.MovePath, Opcode.MakeExecutable, Opcode.RunProcess, Opcode.CaptureProcessStdout, Opcode.CaptureProcessStderr, Opcode.CaptureProcessStdoutWithStdin, Opcode.CaptureProcessResult, Opcode.ProcessResultExitStatus, Opcode.ProcessResultStdout, Opcode.ProcessResultStderr, Opcode.GetEnvironment, Opcode.SetEnvironment, Opcode.UnsetEnvironment, Opcode.CreateDirectory, Opcode.RemoveDirectory, Opcode.CurrentDirectory, Opcode.ChangeDirectory, Opcode.ListDirectory, Opcode.IsDirectory, Opcode.ExpandGlob, Opcode.ReadStdin, Opcode.WriteStdout, Opcode.WriteStderr, Opcode.Call}:
                        return false
                    if instruction.opcode == Opcode.Constant and not bytecode_direct_scalar_type(instruction.result_type):
                        return false
                    if instruction.opcode != Opcode.Observe and not bytecode_direct_value_type(instruction.result_type):
                        return false
            return true


        def bytecode_function_index(module: BytecodeModule&, name: sview) -> usize:
            for index in 0..<module.functions.count |module, name|:
                return index if module.functions[index].name == name
            return module.functions.count


        def bytecode_block_index(function: BytecodeFunction&, id: u32) -> usize:
            for index in 0..<function.blocks.count |function, id|:
                return index if function.blocks[index].id == id
            return function.blocks.count


        def execute_bytecode_direct(module: BytecodeModule&, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            function_index: usize = bytecode_function_index(module, entry)
            raise InterpretError.UnknownFunction if function_index == module.functions.count
            fn: BytecodeFunction = module.functions[function_index]
            raise InterpretError.ArgumentMismatch if arguments.count != fn.parameters.count
            ids: mutable darray[u32] = []
            values: mutable darray[RuntimeValue] = []
            for index in 0..<arguments.count |fn, arguments, ids, values|:
                ids.push(fn.parameters[index].value)
                values.push(arguments[index])
            cursor: mutable BytecodeExecutionCursor = BytecodeExecutionCursor{state: BytecodeExecutionState.EnterBlock, control: BytecodeControlCursor{state: BytecodeControlState.Instruction, block_index: bytecode_block_index(fn, fn.entry), instruction_index: 0, action: BytecodeControlAction.Invalid, target: 0, edge_start: 0, edge_count: 0}, entered: true, branch_condition: false, target_index: fn.blocks.count, edge_offset: 0, pending: [], value: runtime_void(), result: runtime_void(), steps: 0}
            machine over cursor.state:
                state Execute
                start Execute

                Execute, BytecodeExecutionState.EnterBlock if cursor.control.block_index >= fn.blocks.count:
                    raise InterpretError.InvalidControlFlow
                    break
                Execute, BytecodeExecutionState.EnterBlock if cursor.entered and cursor.steps + 1 > step_limit:
                    raise InterpretError.StepLimitExceeded
                    break
                Execute, BytecodeExecutionState.EnterBlock if cursor.entered:
                    cursor.entered <- false
                    # The reference interpreter ticks once on block entry.
                    cursor.steps <- cursor.steps + 1
                    cursor.state <- BytecodeExecutionState.Condition
                    -> Execute
                Execute, BytecodeExecutionState.EnterBlock:
                    cursor.state <- BytecodeExecutionState.Condition
                    -> Execute

                Execute, BytecodeExecutionState.Condition if cursor.control.instruction_index >= fn.blocks[cursor.control.block_index].instruction_count.usize() and fn.blocks[cursor.control.block_index].terminator.kind == TerminatorKind.Branch and bytecode_direct_frame_value(ids, values, fn.blocks[cursor.control.block_index].terminator.operand).kind != RuntimeValueKind.Bool:
                    raise InterpretError.TypeMismatch
                    break
                Execute, BytecodeExecutionState.Condition if cursor.control.instruction_index >= fn.blocks[cursor.control.block_index].instruction_count.usize() and fn.blocks[cursor.control.block_index].terminator.kind == TerminatorKind.Branch:
                    condition: RuntimeValue = bytecode_direct_frame_value(ids, values, fn.blocks[cursor.control.block_index].terminator.operand)
                    cursor.branch_condition <- condition.boolean
                    cursor.state <- BytecodeExecutionState.SelectAction
                    -> Execute
                Execute, BytecodeExecutionState.Condition:
                    cursor.branch_condition <- false
                    cursor.state <- BytecodeExecutionState.SelectAction
                    -> Execute

                Execute, BytecodeExecutionState.SelectAction:
                    cursor.control.action <- bytecode_next_control(fn, cursor.control, cursor.branch_condition)
                    cursor.state <- BytecodeExecutionState.DispatchAction
                    -> Execute

                Execute, BytecodeExecutionState.DispatchAction if cursor.control.action == BytecodeControlAction.ExecuteInstruction:
                    cursor.state <- BytecodeExecutionState.ExecuteInstruction
                    -> Execute
                Execute, BytecodeExecutionState.DispatchAction if cursor.control.action == BytecodeControlAction.Return and fn.blocks[cursor.control.block_index].terminator.operand_count == 0:
                    terminator: Terminator = fn.blocks[cursor.control.block_index].terminator
                    cursor.result <- runtime_void()
                    cursor.state <- BytecodeExecutionState.Done
                    -> Execute
                Execute, BytecodeExecutionState.DispatchAction if cursor.control.action == BytecodeControlAction.Return:
                    terminator: Terminator = fn.blocks[cursor.control.block_index].terminator
                    cursor.result <- bytecode_direct_frame_value(ids, values, terminator.operand)
                    cursor.state <- BytecodeExecutionState.Done
                    -> Execute
                Execute, BytecodeExecutionState.DispatchAction if cursor.control.action == BytecodeControlAction.Jump:
                    cursor.target_index <- bytecode_block_index(fn, cursor.control.target)
                    cursor.state <- BytecodeExecutionState.ValidateJump
                    -> Execute
                Execute, BytecodeExecutionState.DispatchAction:
                    raise InterpretError.InvalidControlFlow
                    break

                Execute, BytecodeExecutionState.ExecuteInstruction if cursor.steps + 1 > step_limit:
                    raise InterpretError.StepLimitExceeded
                    break
                Execute, BytecodeExecutionState.ExecuteInstruction:
                    instruction_index: usize = fn.blocks[cursor.control.block_index].instruction_offset.usize() + cursor.control.instruction_index - 1
                    cursor.steps <- cursor.steps + 1
                    cursor.value <- try bytecode_direct_instruction(module, fn.instructions[instruction_index], fn, ids, values, storage, observations, step_limit, cursor.steps)
                    cursor.state <- BytecodeExecutionState.StoreInstruction
                    -> Execute

                Execute, BytecodeExecutionState.StoreInstruction if fn.instructions[fn.blocks[cursor.control.block_index].instruction_offset.usize() + cursor.control.instruction_index - 1].opcode != Opcode.Observe:
                    instruction_index: usize = fn.blocks[cursor.control.block_index].instruction_offset.usize() + cursor.control.instruction_index - 1
                    bytecode_direct_set_frame_value(ids, values, fn.instructions[instruction_index].result, cursor.value)
                    cursor.control.state <- BytecodeControlState.Instruction
                    cursor.state <- BytecodeExecutionState.EnterBlock
                    -> Execute
                Execute, BytecodeExecutionState.StoreInstruction:
                    cursor.control.state <- BytecodeControlState.Instruction
                    cursor.state <- BytecodeExecutionState.EnterBlock
                    -> Execute

                Execute, BytecodeExecutionState.ValidateJump if cursor.target_index == fn.blocks.count or cursor.control.edge_count != fn.blocks[cursor.target_index].parameter_count:
                    raise InterpretError.InvalidControlFlow
                    break
                Execute, BytecodeExecutionState.ValidateJump:
                    cursor.pending <- []
                    cursor.edge_offset <- 0
                    cursor.state <- BytecodeExecutionState.CollectEdge
                    -> Execute

                Execute, BytecodeExecutionState.CollectEdge if cursor.edge_offset >= cursor.control.edge_count.usize():
                    cursor.edge_offset <- 0
                    cursor.state <- BytecodeExecutionState.BindEdge
                    -> Execute
                Execute, BytecodeExecutionState.CollectEdge:
                    cursor.pending.push(bytecode_direct_frame_value(ids, values, fn.edge_arg_pool[cursor.control.edge_start.usize() + cursor.edge_offset]))
                    cursor.edge_offset <- cursor.edge_offset + 1
                    -> Execute

                Execute, BytecodeExecutionState.BindEdge if cursor.edge_offset >= cursor.control.edge_count.usize():
                    cursor.control.block_index <- cursor.target_index
                    cursor.control.instruction_index <- 0
                    cursor.control.state <- BytecodeControlState.Instruction
                    cursor.entered <- true
                    cursor.state <- BytecodeExecutionState.EnterBlock
                    -> Execute
                Execute, BytecodeExecutionState.BindEdge:
                    parameter: Parameter = fn.block_parameter_pool[fn.blocks[cursor.target_index].parameter_start.usize() + cursor.edge_offset]
                    bytecode_direct_set_frame_value(ids, values, parameter.value, cursor.pending[cursor.edge_offset])
                    cursor.edge_offset <- cursor.edge_offset + 1
                    -> Execute

                Execute, BytecodeExecutionState.Done:
                    break

            return Execution{value: cursor.result, steps: cursor.steps}


        def bytecode_block_offset(function: BytecodeFunction&, block_id: u32) -> u32:
            for block in function.blocks:
                return block.instruction_offset if block.id == block_id
            return function.instructions.count.u32()


        # Lowering is intentionally a state-preserving copy: every instruction,
        # operand, edge argument, block parameter, handler, and terminator remains
        # typed and ordered. The block offset table is the only backend fact added.
        def lower_bytecode(module: Module&) -> BytecodeLowerResult can[Memory.Allocate, Abort.Panic]:
            issues: darray[Issue] = verify(module)
            if issues.count != 0:
                return BytecodeLowerResult{module: empty_bytecode_module(module.name), issues: issues}
            functions: mutable darray[BytecodeFunction] = []
            for source_function in module.functions |functions, module|:
                instructions: mutable darray[Instruction] = []
                dispatch_classes: mutable darray[BytecodeDispatchClass] = []
                blocks: mutable darray[BytecodeBlock] = []
                offset: mutable u32 = 0
                for source_block in source_function.blocks |instructions, blocks, source_function, offset|:
                    for instruction_offset in source_block.instruction_start..<(source_block.instruction_start + source_block.instruction_count) |instructions, source_function|:
                        instructions.push(source_function.instruction_pool[instruction_offset.usize()])
                        dispatch_classes.push(bytecode_opcode_class(source_function.instruction_pool[instruction_offset.usize()].opcode))
                    blocks.push(BytecodeBlock{id: source_block.id, parameter_start: source_block.parameter_start, parameter_count: source_block.parameter_count, instruction_offset: offset, instruction_count: source_block.instruction_count, terminator: source_block.terminator})
                    offset <- offset + source_block.instruction_count
                functions.push(BytecodeFunction{name: source_function.name, parameters: source_function.parameters, return_type: source_function.return_type, effects: source_function.effects, errors: source_function.errors, operand_pool: source_function.operand_pool, edge_arg_pool: source_function.edge_arg_pool, block_parameter_pool: source_function.block_parameter_pool, instructions: instructions, dispatch_classes: dispatch_classes, blocks: blocks, entry: source_function.entry})
            return BytecodeLowerResult{module: BytecodeModule{name: module.name, functions: functions, handlers: module.handlers}, issues: []}


        # Bootstrap execution path. Rebuild the exact verified IR shape from the
        # bytecode tables, then enter the reference semantic engine. This keeps
        # effect, error, continuation, and resource behavior identical while the
        # packed bytecode dispatch loop is developed independently.
        def bytecode_to_ir[@r](module: BytecodeModule& @r) -> Module:
            functions: mutable darray[Function] = []
            for bytecode_function in module.functions |functions|:
                blocks: mutable darray[Block] = []
                offset: mutable u32 = 0
                for bytecode_block in bytecode_function.blocks |blocks, offset|:
                    blocks.push(Block{id: bytecode_block.id, parameter_start: bytecode_block.parameter_start, parameter_count: bytecode_block.parameter_count, instruction_start: offset, instruction_count: bytecode_block.instruction_count, terminator: bytecode_block.terminator})
                    offset <- offset + bytecode_block.instruction_count
                functions.push(Function{name: bytecode_function.name, parameters: bytecode_function.parameters, return_type: bytecode_function.return_type, effects: bytecode_function.effects, operand_pool: bytecode_function.operand_pool, edge_arg_pool: bytecode_function.edge_arg_pool, block_parameter_pool: bytecode_function.block_parameter_pool, instruction_pool: bytecode_function.instructions, blocks: blocks, entry: bytecode_function.entry, errors: bytecode_function.errors})
            return Module{name: module.name, functions: functions, handlers: module.handlers}


        def execute_bytecode(module: BytecodeModule&, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            raise InterpretError.VerificationFailed if not bytecode_dispatch_table_valid(module)
            region bytecode_execution(1048576) using malloc:
                ir_module: Module = bytecode_to_ir(module)
                raise InterpretError.VerificationFailed if verify(ir_module).count != 0
                return execute_bytecode_direct(module, entry, arguments, observations, storage, step_limit) if bytecode_direct_supported(module)
                return interpret(ir_module, entry, arguments, observations, storage, step_limit)
