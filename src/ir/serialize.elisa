# Canonical structural identity for the backend-neutral Elisascript IR.
#
# This is intentionally a field-wise encoding rather than a hash of host memory:
# pointers, allocator addresses, enum padding, and platform ABI layout never enter
# the result. Every collection records its length before its ordered elements, and
# every model component has one fixed field order shared by all backends. The
# module stream starts with the `ES` magic bytes and format version 1.


extend EsIr:
    private:
        # Collection lengths in the canonical stream are encoded as u32. Keep
        # the narrowing explicit and target-independent: a host collection that
        # cannot round-trip through that field must never be serialized or
        # fingerprinted as a truncated value.
        const module CanonicalLimits:
            U32_COUNT_MAX: usize = 4294967295
            # SHA-256 is used only after canonical bytes have been emitted.
            # Keep this portable implementation bounded until the serializer
            # gains a streaming sink; oversized streams produce no digest.
            SHA256_MAX_INPUT_BYTES: usize = 268435456
            MODULE_TEXT_BYTES: usize = 67108864
            # The largest current emitted record is an instruction with a
            # span, recursive legacy type, trace, and five text fields. Keep
            # the per-item reserve above that fixed envelope.
            MODULE_BUDGET_ITEM_BYTES: usize = 512


        def canonical_u32_count_valid(count: usize) -> bool:
            return count <= CanonicalLimits::U32_COUNT_MAX


        # Run an allocation-free upper-bound pass before canonical emission.
        # Length-prefixed text and collection elements are accounted for with
        # checked subtraction; this keeps a borrowed oversized view or a very
        # large but otherwise representable collection from forcing an
        # unbounded output allocation before the digest ceiling can reject it.
        def canonical_budget_add(total: mutable usize&, amount: usize) -> bool:
            return false if total > CanonicalLimits::SHA256_MAX_INPUT_BYTES or amount > CanonicalLimits::SHA256_MAX_INPUT_BYTES - total
            total <- total + amount
            return true


        def canonical_budget_text(total: mutable usize&, value: sview) -> bool:
            length: usize = sview_len(value)
            return false if length > CanonicalLimits::MODULE_TEXT_BYTES
            return canonical_budget_add(total, length + 8)


        def canonical_budget_items(total: mutable usize&, count: usize) -> bool:
            return false if total > CanonicalLimits::SHA256_MAX_INPUT_BYTES
            return false if count > (CanonicalLimits::SHA256_MAX_INPUT_BYTES - total) / CanonicalLimits::MODULE_BUDGET_ITEM_BYTES
            return canonical_budget_add(total, count * CanonicalLimits::MODULE_BUDGET_ITEM_BYTES)


        def canonical_type_budget_valid(total: mutable usize&, value: Type&) -> bool:
            return false if not canonical_budget_text(total, value.name) or not canonical_budget_text(total, value.element_name) or not canonical_budget_text(total, value.element_element_name) or not canonical_budget_text(total, value.element_element_element_name) or not canonical_budget_text(total, value.element_element_element_element_name) or not canonical_budget_text(total, value.element_element_element_element_element_name) or not canonical_budget_text(total, value.element_element_element_element_element_element_name)
            return true


        def canonical_span_budget_valid(total: mutable usize&, value: SourceSpan&) -> bool:
            return canonical_budget_text(total, value.file)


        def canonical_trace_budget_valid(total: mutable usize&, value: TraceSite&) -> bool:
            return canonical_budget_text(total, value.label)


        def canonical_parameter_budget_valid(total: mutable usize&, value: Parameter&) -> bool:
            return canonical_type_budget_valid(total, value.type) and canonical_budget_text(total, value.name)


        def canonical_instruction_budget_valid(total: mutable usize&, value: Instruction&) -> bool:
            return canonical_span_budget_valid(total, value.span) and canonical_type_budget_valid(total, value.result_type) and canonical_trace_budget_valid(total, value.trace) and canonical_budget_text(total, value.decimal) and canonical_budget_text(total, value.text) and canonical_budget_text(total, value.symbol) and canonical_budget_text(total, value.effect_family) and canonical_budget_text(total, value.effect_operation)


        def canonical_terminator_budget_valid(total: mutable usize&, value: Terminator&) -> bool:
            return canonical_span_budget_valid(total, value.span)


        def canonical_block_budget_valid(total: mutable usize&, value: Block&) -> bool:
            return canonical_terminator_budget_valid(total, value.terminator)


        def canonical_clause_budget_valid(total: mutable usize&, value: HandlerClause&) -> bool:
            return canonical_budget_text(total, value.effect_family) and canonical_budget_text(total, value.effect_operation) and canonical_budget_text(total, value.function)


        def canonical_capture_budget_valid(total: mutable usize&, value: ContinuationCapture&) -> bool:
            return canonical_budget_text(total, value.name) and canonical_type_budget_valid(total, value.type)


        def canonical_literal_budget_valid(total: mutable usize&, value: GlobalLiteral&) -> bool:
            return canonical_budget_text(total, value.decimal) and canonical_budget_text(total, value.text)


        def canonical_global_budget_valid(total: mutable usize&, value: Global&) -> bool:
            return false if not canonical_budget_text(total, value.name) or not canonical_type_budget_valid(total, value.type) or not canonical_budget_text(total, value.decimal) or not canonical_budget_text(total, value.text)
            if value.type.kind == TypeKind.Array or value.type.kind == TypeKind.Map:
                return false if not canonical_budget_items(total, value.aggregate_values.count)
                for literal in value.aggregate_values |total|:
                    return false if not canonical_literal_budget_valid(total, literal)
            return true


        def canonical_handler_budget_valid(total: mutable usize&, value: Handler&) -> bool:
            return false if not canonical_budget_text(total, value.name) or not canonical_budget_items(total, value.handles.count) or not canonical_budget_items(total, value.introduces_effects.count) or not canonical_budget_items(total, value.errors.count) or not canonical_budget_items(total, value.clauses.count) or not canonical_budget_items(total, value.captures.count) or not canonical_budget_items(total, value.replay_safe_effects.count)
            for item in value.handles |total|:
                return false if not canonical_budget_text(total, item)
            for item in value.introduces_effects |total|:
                return false if not canonical_budget_text(total, item)
            for item in value.errors |total|:
                return false if not canonical_budget_text(total, item)
            for item in value.clauses |total|:
                return false if not canonical_clause_budget_valid(total, item)
            for item in value.captures |total|:
                return false if not canonical_capture_budget_valid(total, item)
            for item in value.replay_safe_effects |total|:
                return false if not canonical_budget_text(total, item)
            return true


        def canonical_function_budget_valid(total: mutable usize&, value: Function&) -> bool:
            return false if not canonical_budget_text(total, value.name) or not canonical_budget_items(total, value.parameters.count) or not canonical_type_budget_valid(total, value.return_type) or not canonical_budget_items(total, value.effects.count) or not canonical_budget_items(total, value.operand_pool.count) or not canonical_budget_items(total, value.edge_arg_pool.count) or not canonical_budget_items(total, value.block_parameter_pool.count) or not canonical_budget_items(total, value.instruction_pool.count) or not canonical_budget_items(total, value.blocks.count) or not canonical_budget_items(total, value.errors.count)
            for item in value.parameters |total|:
                return false if not canonical_parameter_budget_valid(total, item)
            for item in value.effects |total|:
                return false if not canonical_budget_text(total, item)
            for item in value.block_parameter_pool |total|:
                return false if not canonical_parameter_budget_valid(total, item)
            for item in value.instruction_pool |total|:
                return false if not canonical_instruction_budget_valid(total, item)
            for item in value.blocks |total|:
                return false if not canonical_block_budget_valid(total, item)
            for item in value.errors |total|:
                return false if not canonical_budget_text(total, item)
            return true


        def canonical_module_budget_valid(module: Module&) -> bool:
            total: mutable usize = 0
            return false if not canonical_budget_text(total, module.name) or not canonical_budget_items(total, module.type_table.rows.count) or not canonical_budget_items(total, module.type_table.children.count) or not canonical_budget_items(total, module.globals.count) or not canonical_budget_items(total, module.functions.count) or not canonical_budget_items(total, module.handlers.count)
            for row in module.type_table.rows |total|:
                return false if not canonical_budget_text(total, row.name)
            for binding in module.globals |total|:
                return false if not canonical_global_budget_valid(total, binding)
            for function in module.functions |total|:
                return false if not canonical_function_budget_valid(total, function)
            for handler in module.handlers |total|:
                return false if not canonical_handler_budget_valid(total, handler)
            return true


        def canonical_sha256_mask(value: u64) -> u64:
            return value & 0xffffffffu64


        def canonical_sha256_add2(left: u64, right: u64) -> u64:
            return canonical_sha256_mask(left + right)


        def canonical_sha256_add4(first: u64, second: u64, third: u64, fourth: u64) -> u64:
            return canonical_sha256_mask(first + second + third + fourth)


        def canonical_sha256_add5(first: u64, second: u64, third: u64, fourth: u64, fifth: u64) -> u64:
            return canonical_sha256_mask(first + second + third + fourth + fifth)


        def canonical_sha256_rotr(value: u64, shift: u64) -> u64:
            return canonical_sha256_mask((value >> shift) | (value << (32u64 - shift)))


        def canonical_sha256_ch(x: u64, y: u64, z: u64) -> u64:
            return canonical_sha256_mask((x & y) ^ ((~x) & z))


        def canonical_sha256_maj(x: u64, y: u64, z: u64) -> u64:
            return canonical_sha256_mask((x & y) ^ (x & z) ^ (y & z))


        def canonical_sha256_big0(value: u64) -> u64:
            return canonical_sha256_mask(canonical_sha256_rotr(value, 2) ^ canonical_sha256_rotr(value, 13) ^ canonical_sha256_rotr(value, 22))


        def canonical_sha256_big1(value: u64) -> u64:
            return canonical_sha256_mask(canonical_sha256_rotr(value, 6) ^ canonical_sha256_rotr(value, 11) ^ canonical_sha256_rotr(value, 25))


        def canonical_sha256_small0(value: u64) -> u64:
            return canonical_sha256_mask(canonical_sha256_rotr(value, 7) ^ canonical_sha256_rotr(value, 18) ^ (value >> 3))


        def canonical_sha256_small1(value: u64) -> u64:
            return canonical_sha256_mask(canonical_sha256_rotr(value, 17) ^ canonical_sha256_rotr(value, 19) ^ (value >> 10))


        def canonical_sha256_compress(state: mutable darray[u64]&, block: darray[u8]&) -> void:
            constants: darray[u64] = [
                0x428a2f98u64, 0x71374491u64, 0xb5c0fbcfu64, 0xe9b5dba5u64,
                0x3956c25bu64, 0x59f111f1u64, 0x923f82a4u64, 0xab1c5ed5u64,
                0xd807aa98u64, 0x12835b01u64, 0x243185beu64, 0x550c7dc3u64,
                0x72be5d74u64, 0x80deb1feu64, 0x9bdc06a7u64, 0xc19bf174u64,
                0xe49b69c1u64, 0xefbe4786u64, 0x0fc19dc6u64, 0x240ca1ccu64,
                0x2de92c6fu64, 0x4a7484aau64, 0x5cb0a9dcu64, 0x76f988dau64,
                0x983e5152u64, 0xa831c66du64, 0xb00327c8u64, 0xbf597fc7u64,
                0xc6e00bf3u64, 0xd5a79147u64, 0x06ca6351u64, 0x14292967u64,
                0x27b70a85u64, 0x2e1b2138u64, 0x4d2c6dfcu64, 0x53380d13u64,
                0x650a7354u64, 0x766a0abbu64, 0x81c2c92eu64, 0x92722c85u64,
                0xa2bfe8a1u64, 0xa81a664bu64, 0xc24b8b70u64, 0xc76c51a3u64,
                0xd192e819u64, 0xd6990624u64, 0xf40e3585u64, 0x106aa070u64,
                0x19a4c116u64, 0x1e376c08u64, 0x2748774cu64, 0x34b0bcb5u64,
                0x391c0cb3u64, 0x4ed8aa4au64, 0x5b9cca4fu64, 0x682e6ff3u64,
                0x748f82eeu64, 0x78a5636fu64, 0x84c87814u64, 0x8cc70208u64,
                0x90befffau64, 0xa4506cebu64, 0xbef9a3f7u64, 0xc67178f2u64
            ]
            schedule: mutable darray[u64] = []
            for _ in 0..<64 |schedule|:
                schedule.push(0)
            for index in 0..<16 |schedule, block|:
                offset: usize = index * 4
                schedule[index] <- (block[offset].u64() << 24) | (block[offset + 1].u64() << 16) | (block[offset + 2].u64() << 8) | block[offset + 3].u64()
            for index in 16..<64 |schedule|:
                schedule[index] <- canonical_sha256_add4(schedule[index - 16], canonical_sha256_small0(schedule[index - 15]), schedule[index - 7], canonical_sha256_small1(schedule[index - 2]))
            a: mutable u64 = state[0]
            b: mutable u64 = state[1]
            c: mutable u64 = state[2]
            d: mutable u64 = state[3]
            e: mutable u64 = state[4]
            f: mutable u64 = state[5]
            g: mutable u64 = state[6]
            h: mutable u64 = state[7]
            for index in 0..<64 |constants, schedule, a, b, c, d, e, f, g, h|:
                temp1: u64 = canonical_sha256_add5(h, canonical_sha256_big1(e), canonical_sha256_ch(e, f, g), constants[index], schedule[index])
                temp2: u64 = canonical_sha256_add2(canonical_sha256_big0(a), canonical_sha256_maj(a, b, c))
                h <- g
                g <- f
                f <- e
                e <- canonical_sha256_add2(d, temp1)
                d <- c
                c <- b
                b <- a
                a <- canonical_sha256_add2(temp1, temp2)
            state[0] <- canonical_sha256_add2(state[0], a)
            state[1] <- canonical_sha256_add2(state[1], b)
            state[2] <- canonical_sha256_add2(state[2], c)
            state[3] <- canonical_sha256_add2(state[3], d)
            state[4] <- canonical_sha256_add2(state[4], e)
            state[5] <- canonical_sha256_add2(state[5], f)
            state[6] <- canonical_sha256_add2(state[6], g)
            state[7] <- canonical_sha256_add2(state[7], h)


        def canonical_sha256_digest(bytes: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [] if bytes.count > CanonicalLimits::SHA256_MAX_INPUT_BYTES
            state: mutable darray[u64] = [
                0x6a09e667u64, 0xbb67ae85u64, 0x3c6ef372u64, 0xa54ff53au64,
                0x510e527fu64, 0x9b05688cu64, 0x1f83d9abu64, 0x5be0cd19u64
            ]
            block: mutable darray[u8] = []
            for _ in 0..<64 |block|:
                block.push(0)
            block_length: mutable usize = 0
            for byte in bytes |block, block_length, state|:
                block[block_length] <- byte
                block_length <- block_length + 1
                if block_length == 64:
                    canonical_sha256_compress(state, block)
                    block_length <- 0
            block[block_length] <- 128
            block_length <- block_length + 1
            if block_length > 56:
                for index in block_length..<64 |block|:
                    block[index] <- 0
                canonical_sha256_compress(state, block)
                block_length <- 0
            for index in block_length..<56 |block|:
                block[index] <- 0
            bit_length: u64 = bytes.count.u64() * 8
            for index in 0..<8 |block, bit_length|:
                block[56 + index] <- (bit_length >> (56 - index * 8)).u8()
            canonical_sha256_compress(state, block)
            result: mutable darray[u8] = []
            for word in state |result|:
                for shift in 0..<4 |result, word|:
                    result.push(((word >> (24 - shift * 8)) & 255u64).u8())
            return result


        def canonical_module_counts_valid(module: Module&) -> bool:
            return false if not canonical_u32_count_valid(module.type_table.rows.count) or not canonical_u32_count_valid(module.type_table.children.count) or not canonical_u32_count_valid(module.globals.count) or not canonical_u32_count_valid(module.functions.count) or not canonical_u32_count_valid(module.handlers.count)
            for binding in module.globals |module|:
                return false if not canonical_u32_count_valid(binding.aggregate_values.count)
            for handler in module.handlers |module|:
                return false if not canonical_u32_count_valid(handler.handles.count) or not canonical_u32_count_valid(handler.introduces_effects.count) or not canonical_u32_count_valid(handler.errors.count) or not canonical_u32_count_valid(handler.clauses.count) or not canonical_u32_count_valid(handler.captures.count) or not canonical_u32_count_valid(handler.replay_safe_effects.count)
            for function in module.functions |module|:
                return false if not canonical_u32_count_valid(function.parameters.count) or not canonical_u32_count_valid(function.effects.count) or not canonical_u32_count_valid(function.operand_pool.count) or not canonical_u32_count_valid(function.edge_arg_pool.count) or not canonical_u32_count_valid(function.block_parameter_pool.count) or not canonical_u32_count_valid(function.instruction_pool.count) or not canonical_u32_count_valid(function.blocks.count) or not canonical_u32_count_valid(function.errors.count)
            return canonical_module_budget_valid(module)


        def canonical_hash_byte(hash: u64, value: u8) -> u64:
            return (hash ^ value.u64()) * 1099511628211


        def canonical_hash_u16(hash: u64, value: u16) -> u64:
            result: mutable u64 = hash
            wide: u64 = value.u64()
            for shift in 0..<2 |result, wide|:
                result <- canonical_hash_byte(result, (wide >> (shift * 8)).u8())
            return result


        def canonical_hash_u32(hash: u64, value: u32) -> u64:
            result: mutable u64 = hash
            wide: u64 = value.u64()
            for shift in 0..<4 |result, wide|:
                result <- canonical_hash_byte(result, (wide >> (shift * 8)).u8())
            return result


        def canonical_hash_u64(hash: u64, value: u64) -> u64:
            result: mutable u64 = hash
            for shift in 0..<8 |result, value|:
                result <- canonical_hash_byte(result, (value >> (shift * 8)).u8())
            return result


        def canonical_hash_i64(hash: u64, value: i64) -> u64:
            return canonical_hash_u64(hash, value.u64())


        def canonical_hash_bool(hash: u64, value: bool) -> u64:
            return canonical_hash_byte(hash, 1) if value else canonical_hash_byte(hash, 0)


        def canonical_hash_text(hash: u64, value: sview) -> u64:
            result: mutable u64 = canonical_hash_u64(hash, sview_len(value).u64())
            for byte in value |result|:
                result <- canonical_hash_byte(result, byte)
            return result


        # The byte encoder mirrors the hash's field order. Length prefixes make
        # concatenated text and collection fields unambiguous.
        def canonical_emit_byte(output: mutable darray[u8]&, value: u8) -> void can[Memory.Allocate, Abort.Panic]:
            output.push(value)


        def canonical_emit_u16(output: mutable darray[u8]&, value: u16) -> void can[Memory.Allocate, Abort.Panic]:
            wide: u64 = value.u64()
            for shift in 0..<2 |output, wide|:
                output.push((wide >> (shift * 8)).u8())


        def canonical_emit_u32(output: mutable darray[u8]&, value: u32) -> void can[Memory.Allocate, Abort.Panic]:
            wide: u64 = value.u64()
            for shift in 0..<4 |output, wide|:
                output.push((wide >> (shift * 8)).u8())


        def canonical_emit_u64(output: mutable darray[u8]&, value: u64) -> void can[Memory.Allocate, Abort.Panic]:
            for shift in 0..<8 |output, value|:
                output.push((value >> (shift * 8)).u8())


        def canonical_emit_i64(output: mutable darray[u8]&, value: i64) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_u64(output, value.u64())


        def canonical_emit_bool(output: mutable darray[u8]&, value: bool) -> void can[Memory.Allocate, Abort.Panic]:
            output.push(1) if value
            output.push(0) if not value


        def canonical_emit_text(output: mutable darray[u8]&, value: sview) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_u64(output, sview_len(value).u64())
            for byte in value |output|:
                output.push(byte)


        def canonical_emit_type(output: mutable darray[u8]&, value: Type&) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_byte(output, 1)
            canonical_emit_text(output, value.name)
            canonical_emit_text(output, value.element_name)
            canonical_emit_text(output, value.element_element_name)
            canonical_emit_text(output, value.element_element_element_name)
            canonical_emit_text(output, value.element_element_element_element_name)
            canonical_emit_text(output, value.element_element_element_element_element_name)
            canonical_emit_text(output, value.element_element_element_element_element_element_name)
            canonical_emit_u16(output, value.bits)
            canonical_emit_u16(output, value.element_bits)
            canonical_emit_u16(output, value.element_element_bits)
            canonical_emit_u16(output, value.element_element_element_bits)
            canonical_emit_u16(output, value.element_element_element_element_bits)
            canonical_emit_u16(output, value.element_element_element_element_element_bits)
            canonical_emit_u16(output, value.element_element_element_element_element_element_bits)
            canonical_emit_byte(output, value.kind.u8())
            canonical_emit_byte(output, value.element_kind.u8())
            canonical_emit_byte(output, value.element_element_kind.u8())
            canonical_emit_byte(output, value.element_element_element_kind.u8())
            canonical_emit_byte(output, value.element_element_element_element_kind.u8())
            canonical_emit_byte(output, value.element_element_element_element_element_kind.u8())
            canonical_emit_byte(output, value.element_element_element_element_element_element_kind.u8())
            canonical_emit_bool(output, value.signed)
            canonical_emit_bool(output, value.element_signed)
            canonical_emit_bool(output, value.element_element_signed)
            canonical_emit_bool(output, value.element_element_element_signed)
            canonical_emit_bool(output, value.element_element_element_element_signed)
            canonical_emit_bool(output, value.element_element_element_element_element_signed)
            canonical_emit_bool(output, value.element_element_element_element_element_element_signed)


        def canonical_emit_type_descriptor(output: mutable darray[u8]&, value: TypeDescriptor&) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_byte(output, 13)
            canonical_emit_byte(output, value.kind.u8())
            canonical_emit_text(output, value.name)
            canonical_emit_u16(output, value.bits)
            canonical_emit_bool(output, value.signed)
            canonical_emit_u32(output, value.child_start)
            canonical_emit_u16(output, value.child_count)


        def canonical_emit_type_table(output: mutable darray[u8]&, table: TypeTable&) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_byte(output, 14)
            canonical_emit_u32(output, table.rows.count.u32())
            for row in table.rows |output|:
                canonical_emit_type_descriptor(output, row)
            canonical_emit_u32(output, table.children.count.u32())
            for child in table.children |output|:
                canonical_emit_u32(output, child)


        def canonical_emit_global(output: mutable darray[u8]&, binding: Global&) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_byte(output, 15)
            canonical_emit_text(output, binding.name)
            canonical_emit_type(output, binding.type)
            canonical_emit_text(output, binding.decimal)
            canonical_emit_text(output, binding.text)
            canonical_emit_i64(output, binding.integer)
            canonical_emit_bool(output, binding.boolean)
            canonical_emit_bool(output, binding.initialized)
            if binding.type.kind == TypeKind.Array or binding.type.kind == TypeKind.Map:
                canonical_emit_u32(output, binding.aggregate_values.count.u32())
                for literal in binding.aggregate_values |output|:
                    canonical_emit_byte(output, 16)
                    canonical_emit_byte(output, literal.kind.u8())
                    canonical_emit_text(output, literal.decimal)
                    canonical_emit_text(output, literal.text)
                    canonical_emit_i64(output, literal.integer)
                    canonical_emit_bool(output, literal.boolean)


        def canonical_emit_span(output: mutable darray[u8]&, value: SourceSpan&) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_byte(output, 2)
            canonical_emit_text(output, value.file)
            canonical_emit_u32(output, value.line)
            canonical_emit_u32(output, value.column)
            canonical_emit_u32(output, value.end_line)
            canonical_emit_u32(output, value.end_column)


        def canonical_emit_trace(output: mutable darray[u8]&, value: TraceSite&) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_byte(output, 3)
            canonical_emit_u64(output, value.id)
            canonical_emit_text(output, value.label)


        def canonical_emit_parameter(output: mutable darray[u8]&, value: Parameter&) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_byte(output, 4)
            canonical_emit_u32(output, value.value)
            canonical_emit_type(output, value.type)
            canonical_emit_text(output, value.name)


        def canonical_emit_instruction(output: mutable darray[u8]&, value: Instruction&) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_byte(output, 5)
            canonical_emit_span(output, value.span)
            canonical_emit_type(output, value.result_type)
            canonical_emit_trace(output, value.trace)
            canonical_emit_text(output, value.decimal)
            canonical_emit_text(output, value.text)
            canonical_emit_text(output, value.symbol)
            canonical_emit_text(output, value.effect_family)
            canonical_emit_text(output, value.effect_operation)
            canonical_emit_u64(output, value.operation_id)
            canonical_emit_u64(output, value.resumption_id)
            canonical_emit_i64(output, value.integer)
            canonical_emit_u32(output, value.result)
            canonical_emit_u32(output, value.operand_start)
            canonical_emit_u16(output, value.operand_count)
            canonical_emit_byte(output, value.opcode.u8())
            canonical_emit_bool(output, value.boolean)


        def canonical_emit_terminator(output: mutable darray[u8]&, value: Terminator&) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_byte(output, 6)
            canonical_emit_span(output, value.span)
            canonical_emit_u32(output, value.operand)
            canonical_emit_u32(output, value.target0)
            canonical_emit_u32(output, value.target1)
            canonical_emit_u32(output, value.edge0_arg_start)
            canonical_emit_u32(output, value.edge1_arg_start)
            canonical_emit_byte(output, value.kind.u8())
            canonical_emit_byte(output, value.operand_count)
            canonical_emit_byte(output, value.target_count)
            canonical_emit_u16(output, value.edge0_arg_count)
            canonical_emit_u16(output, value.edge1_arg_count)


        def canonical_emit_block(output: mutable darray[u8]&, value: Block&) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_byte(output, 7)
            canonical_emit_u32(output, value.id)
            canonical_emit_u32(output, value.parameter_start)
            canonical_emit_u16(output, value.parameter_count)
            canonical_emit_u32(output, value.instruction_start)
            canonical_emit_u32(output, value.instruction_count)
            canonical_emit_terminator(output, value.terminator)


        def canonical_hash_type(hash: u64, value: Type&) -> u64:
            result: mutable u64 = canonical_hash_byte(hash, 1)
            result <- canonical_hash_text(result, value.name)
            result <- canonical_hash_text(result, value.element_name)
            result <- canonical_hash_text(result, value.element_element_name)
            result <- canonical_hash_text(result, value.element_element_element_name)
            result <- canonical_hash_text(result, value.element_element_element_element_name)
            result <- canonical_hash_text(result, value.element_element_element_element_element_name)
            result <- canonical_hash_text(result, value.element_element_element_element_element_element_name)
            result <- canonical_hash_u16(result, value.bits)
            result <- canonical_hash_u16(result, value.element_bits)
            result <- canonical_hash_u16(result, value.element_element_bits)
            result <- canonical_hash_u16(result, value.element_element_element_bits)
            result <- canonical_hash_u16(result, value.element_element_element_element_bits)
            result <- canonical_hash_u16(result, value.element_element_element_element_element_bits)
            result <- canonical_hash_u16(result, value.element_element_element_element_element_element_bits)
            result <- canonical_hash_byte(result, value.kind.u8())
            result <- canonical_hash_byte(result, value.element_kind.u8())
            result <- canonical_hash_byte(result, value.element_element_kind.u8())
            result <- canonical_hash_byte(result, value.element_element_element_kind.u8())
            result <- canonical_hash_byte(result, value.element_element_element_element_kind.u8())
            result <- canonical_hash_byte(result, value.element_element_element_element_element_kind.u8())
            result <- canonical_hash_byte(result, value.element_element_element_element_element_element_kind.u8())
            result <- canonical_hash_bool(result, value.signed)
            result <- canonical_hash_bool(result, value.element_signed)
            result <- canonical_hash_bool(result, value.element_element_signed)
            result <- canonical_hash_bool(result, value.element_element_element_signed)
            result <- canonical_hash_bool(result, value.element_element_element_element_signed)
            result <- canonical_hash_bool(result, value.element_element_element_element_element_signed)
            result <- canonical_hash_bool(result, value.element_element_element_element_element_element_signed)
            return result


        def canonical_hash_type_descriptor(hash: u64, value: TypeDescriptor&) -> u64:
            result: mutable u64 = canonical_hash_byte(hash, 13)
            result <- canonical_hash_byte(result, value.kind.u8())
            result <- canonical_hash_text(result, value.name)
            result <- canonical_hash_u16(result, value.bits)
            result <- canonical_hash_bool(result, value.signed)
            result <- canonical_hash_u32(result, value.child_start)
            result <- canonical_hash_u16(result, value.child_count)
            return result


        def canonical_hash_type_table(hash: u64, table: TypeTable&) -> u64:
            result: mutable u64 = canonical_hash_byte(hash, 14)
            result <- canonical_hash_u32(result, table.rows.count.u32())
            for row in table.rows |result|:
                result <- canonical_hash_type_descriptor(result, row)
            result <- canonical_hash_u32(result, table.children.count.u32())
            for child in table.children |result|:
                result <- canonical_hash_u32(result, child)
            return result


        def canonical_hash_global(hash: u64, binding: Global&) -> u64:
            result: mutable u64 = canonical_hash_byte(hash, 15)
            result <- canonical_hash_text(result, binding.name)
            result <- canonical_hash_type(result, binding.type)
            result <- canonical_hash_text(result, binding.decimal)
            result <- canonical_hash_text(result, binding.text)
            result <- canonical_hash_i64(result, binding.integer)
            result <- canonical_hash_bool(result, binding.boolean)
            result <- canonical_hash_bool(result, binding.initialized)
            if binding.type.kind == TypeKind.Array or binding.type.kind == TypeKind.Map:
                result <- canonical_hash_u32(result, binding.aggregate_values.count.u32())
                for literal in binding.aggregate_values |result|:
                    result <- canonical_hash_byte(result, 16)
                    result <- canonical_hash_byte(result, literal.kind.u8())
                    result <- canonical_hash_text(result, literal.decimal)
                    result <- canonical_hash_text(result, literal.text)
                    result <- canonical_hash_i64(result, literal.integer)
                    result <- canonical_hash_bool(result, literal.boolean)
            return result


        def canonical_hash_span(hash: u64, value: SourceSpan&) -> u64:
            result: mutable u64 = canonical_hash_byte(hash, 2)
            result <- canonical_hash_text(result, value.file)
            result <- canonical_hash_u32(result, value.line)
            result <- canonical_hash_u32(result, value.column)
            result <- canonical_hash_u32(result, value.end_line)
            result <- canonical_hash_u32(result, value.end_column)
            return result


        def canonical_hash_trace(hash: u64, value: TraceSite&) -> u64:
            result: mutable u64 = canonical_hash_byte(hash, 3)
            result <- canonical_hash_u64(result, value.id)
            result <- canonical_hash_text(result, value.label)
            return result


        def canonical_hash_parameter(hash: u64, value: Parameter&) -> u64:
            result: mutable u64 = canonical_hash_byte(hash, 4)
            result <- canonical_hash_u32(result, value.value)
            result <- canonical_hash_type(result, value.type)
            result <- canonical_hash_text(result, value.name)
            return result


        def canonical_hash_instruction(hash: u64, value: Instruction&) -> u64:
            result: mutable u64 = canonical_hash_byte(hash, 5)
            result <- canonical_hash_span(result, value.span)
            result <- canonical_hash_type(result, value.result_type)
            result <- canonical_hash_trace(result, value.trace)
            result <- canonical_hash_text(result, value.decimal)
            result <- canonical_hash_text(result, value.text)
            result <- canonical_hash_text(result, value.symbol)
            result <- canonical_hash_text(result, value.effect_family)
            result <- canonical_hash_text(result, value.effect_operation)
            result <- canonical_hash_u64(result, value.operation_id)
            result <- canonical_hash_u64(result, value.resumption_id)
            result <- canonical_hash_i64(result, value.integer)
            result <- canonical_hash_u32(result, value.result)
            result <- canonical_hash_u32(result, value.operand_start)
            result <- canonical_hash_u16(result, value.operand_count)
            result <- canonical_hash_byte(result, value.opcode.u8())
            result <- canonical_hash_bool(result, value.boolean)
            return result


        def canonical_hash_terminator(hash: u64, value: Terminator&) -> u64:
            result: mutable u64 = canonical_hash_byte(hash, 6)
            result <- canonical_hash_span(result, value.span)
            result <- canonical_hash_u32(result, value.operand)
            result <- canonical_hash_u32(result, value.target0)
            result <- canonical_hash_u32(result, value.target1)
            result <- canonical_hash_u32(result, value.edge0_arg_start)
            result <- canonical_hash_u32(result, value.edge1_arg_start)
            result <- canonical_hash_byte(result, value.kind.u8())
            result <- canonical_hash_byte(result, value.operand_count)
            result <- canonical_hash_byte(result, value.target_count)
            result <- canonical_hash_u16(result, value.edge0_arg_count)
            result <- canonical_hash_u16(result, value.edge1_arg_count)
            return result


        def canonical_hash_block(hash: u64, value: Block&) -> u64:
            result: mutable u64 = canonical_hash_byte(hash, 7)
            result <- canonical_hash_u32(result, value.id)
            result <- canonical_hash_u32(result, value.parameter_start)
            result <- canonical_hash_u16(result, value.parameter_count)
            result <- canonical_hash_u32(result, value.instruction_start)
            result <- canonical_hash_u32(result, value.instruction_count)
            result <- canonical_hash_terminator(result, value.terminator)
            return result


        def canonical_emit_clause(output: mutable darray[u8]&, value: HandlerClause&) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_byte(output, 8)
            canonical_emit_text(output, value.effect_family)
            canonical_emit_text(output, value.effect_operation)
            canonical_emit_text(output, value.function)
            canonical_emit_u64(output, value.operation_id)


        def canonical_emit_capture(output: mutable darray[u8]&, value: ContinuationCapture&) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_byte(output, 9)
            canonical_emit_text(output, value.name)
            canonical_emit_type(output, value.type)
            canonical_emit_byte(output, value.class.u8())


        def canonical_emit_handler(output: mutable darray[u8]&, value: Handler&) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_byte(output, 10)
            canonical_emit_text(output, value.name)
            canonical_emit_u32(output, value.handles.count.u32())
            for item in value.handles |output|:
                canonical_emit_text(output, item)
            canonical_emit_u32(output, value.introduces_effects.count.u32())
            for item in value.introduces_effects |output|:
                canonical_emit_text(output, item)
            canonical_emit_u32(output, value.errors.count.u32())
            for item in value.errors |output|:
                canonical_emit_text(output, item)
            canonical_emit_byte(output, value.continuation.u8())
            canonical_emit_u32(output, value.clauses.count.u32())
            for item in value.clauses |output|:
                canonical_emit_clause(output, item)
            canonical_emit_u32(output, value.captures.count.u32())
            for item in value.captures |output|:
                canonical_emit_capture(output, item)
            canonical_emit_u32(output, value.replay_safe_effects.count.u32())
            for item in value.replay_safe_effects |output|:
                canonical_emit_text(output, item)


        def canonical_emit_function(output: mutable darray[u8]&, value: Function&) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_byte(output, 11)
            canonical_emit_text(output, value.name)
            canonical_emit_u32(output, value.parameters.count.u32())
            for item in value.parameters |output|:
                canonical_emit_parameter(output, item)
            canonical_emit_type(output, value.return_type)
            canonical_emit_u32(output, value.effects.count.u32())
            for item in value.effects |output|:
                canonical_emit_text(output, item)
            canonical_emit_u32(output, value.operand_pool.count.u32())
            for item in value.operand_pool |output|:
                canonical_emit_u32(output, item)
            canonical_emit_u32(output, value.edge_arg_pool.count.u32())
            for item in value.edge_arg_pool |output|:
                canonical_emit_u32(output, item)
            canonical_emit_u32(output, value.block_parameter_pool.count.u32())
            for item in value.block_parameter_pool |output|:
                canonical_emit_parameter(output, item)
            canonical_emit_u32(output, value.instruction_pool.count.u32())
            for item in value.instruction_pool |output|:
                canonical_emit_instruction(output, item)
            canonical_emit_u32(output, value.blocks.count.u32())
            for item in value.blocks |output|:
                canonical_emit_block(output, item)
            canonical_emit_u32(output, value.entry)
            canonical_emit_u32(output, value.errors.count.u32())
            for item in value.errors |output|:
                canonical_emit_text(output, item)


    public:
        def canonical_module_bytes(module: Module&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return [] if not canonical_module_counts_valid(module)
            output: mutable darray[u8] = []
            canonical_emit_byte(output, 69)
            canonical_emit_byte(output, 83)
            canonical_emit_byte(output, 1)
            canonical_emit_byte(output, 12)
            canonical_emit_text(output, module.name)
            canonical_emit_type_table(output, module.type_table) if module.type_table.rows.count != 0 or module.type_table.children.count != 0
            if module.globals.count != 0:
                canonical_emit_byte(output, 15)
                canonical_emit_u32(output, module.globals.count.u32())
                for binding in module.globals |output|:
                    canonical_emit_global(output, binding)
            canonical_emit_u32(output, module.functions.count.u32())
            for item in module.functions |output|:
                canonical_emit_function(output, item)
            canonical_emit_u32(output, module.handlers.count.u32())
            for item in module.handlers |output|:
                canonical_emit_handler(output, item)
            return output


        # Cryptographic identity is deliberately separate from the compact
        # FNV-style correlation fingerprint. The digest covers the exact
        # canonical byte stream and returns an empty sentinel if that stream
        # was unavailable or exceeded the portable bounded implementation.
        def canonical_bytes_sha256(bytes: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return canonical_sha256_digest(bytes)


        def canonical_module_digest(module: Module&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            bytes: darray[u8] = canonical_module_bytes(module)
            return [] if bytes.count == 0
            return canonical_sha256_digest(bytes)


        # Expose fixed-width digest words for artifact envelopes that keep the
        # cryptographic identity inline without retaining an owned byte array.
        # The canonical byte order is little endian, matching the serialized
        # u64 fields used by the artifact writers.
        def canonical_digest_word(bytes: darray[u8]&, word_index: usize) -> u64:
            return 0 if word_index >= 4 or bytes.count != 32
            offset: usize = word_index * 8
            value: mutable u64 = 0
            for shift in 0..<8 |bytes, offset, value|:
                value <- value | (bytes[offset + shift].u64() << (shift * 8))
            return value


        def canonical_module_digest_word(module: Module&, word_index: usize) -> u64 can[Memory.Allocate, Abort.Panic]:
            digest: darray[u8] = canonical_module_digest(module)
            return canonical_digest_word(digest, word_index)


        # Artifact envelopes have a deliberately small public adapter surface;
        # field-level IR emitters remain private to this serializer.
        def canonical_artifact_emit_byte(output: mutable darray[u8]&, value: u8) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_byte(output, value)


        def canonical_artifact_emit_u64(output: mutable darray[u8]&, value: u64) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_u64(output, value)


        def canonical_artifact_emit_bool(output: mutable darray[u8]&, value: bool) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_bool(output, value)


        def canonical_artifact_emit_text(output: mutable darray[u8]&, value: sview) -> void can[Memory.Allocate, Abort.Panic]:
            canonical_emit_text(output, value)


        def canonical_artifact_hash_byte(hash: u64, value: u8) -> u64:
            return canonical_hash_byte(hash, value)


    private:
        def canonical_hash_clause(hash: u64, value: HandlerClause&) -> u64:
            result: mutable u64 = canonical_hash_byte(hash, 8)
            result <- canonical_hash_text(result, value.effect_family)
            result <- canonical_hash_text(result, value.effect_operation)
            result <- canonical_hash_text(result, value.function)
            result <- canonical_hash_u64(result, value.operation_id)
            return result


        def canonical_hash_capture(hash: u64, value: ContinuationCapture&) -> u64:
            result: mutable u64 = canonical_hash_byte(hash, 9)
            result <- canonical_hash_text(result, value.name)
            result <- canonical_hash_type(result, value.type)
            result <- canonical_hash_byte(result, value.class.u8())
            return result


        def canonical_hash_handler(hash: u64, value: Handler&) -> u64:
            result: mutable u64 = canonical_hash_byte(hash, 10)
            result <- canonical_hash_text(result, value.name)
            result <- canonical_hash_u32(result, value.handles.count.u32())
            for item in value.handles |result|:
                result <- canonical_hash_text(result, item)
            result <- canonical_hash_u32(result, value.introduces_effects.count.u32())
            for item in value.introduces_effects |result|:
                result <- canonical_hash_text(result, item)
            result <- canonical_hash_u32(result, value.errors.count.u32())
            for item in value.errors |result|:
                result <- canonical_hash_text(result, item)
            result <- canonical_hash_byte(result, value.continuation.u8())
            result <- canonical_hash_u32(result, value.clauses.count.u32())
            for item in value.clauses |result|:
                result <- canonical_hash_clause(result, item)
            result <- canonical_hash_u32(result, value.captures.count.u32())
            for item in value.captures |result|:
                result <- canonical_hash_capture(result, item)
            result <- canonical_hash_u32(result, value.replay_safe_effects.count.u32())
            for item in value.replay_safe_effects |result|:
                result <- canonical_hash_text(result, item)
            return result


        def canonical_hash_function(hash: u64, value: Function&) -> u64:
            result: mutable u64 = canonical_hash_byte(hash, 11)
            result <- canonical_hash_text(result, value.name)
            result <- canonical_hash_u32(result, value.parameters.count.u32())
            for item in value.parameters |result|:
                result <- canonical_hash_parameter(result, item)
            result <- canonical_hash_type(result, value.return_type)
            result <- canonical_hash_u32(result, value.effects.count.u32())
            for item in value.effects |result|:
                result <- canonical_hash_text(result, item)
            result <- canonical_hash_u32(result, value.operand_pool.count.u32())
            for item in value.operand_pool |result|:
                result <- canonical_hash_u32(result, item)
            result <- canonical_hash_u32(result, value.edge_arg_pool.count.u32())
            for item in value.edge_arg_pool |result|:
                result <- canonical_hash_u32(result, item)
            result <- canonical_hash_u32(result, value.block_parameter_pool.count.u32())
            for item in value.block_parameter_pool |result|:
                result <- canonical_hash_parameter(result, item)
            result <- canonical_hash_u32(result, value.instruction_pool.count.u32())
            for item in value.instruction_pool |result|:
                result <- canonical_hash_instruction(result, item)
            result <- canonical_hash_u32(result, value.blocks.count.u32())
            for item in value.blocks |result|:
                result <- canonical_hash_block(result, item)
            result <- canonical_hash_u32(result, value.entry)
            result <- canonical_hash_u32(result, value.errors.count.u32())
            for item in value.errors |result|:
                result <- canonical_hash_text(result, item)
            return result


    public:
        def canonical_module_hash(module: Module&) -> u64:
            return 0 if not canonical_module_counts_valid(module)
            result: mutable u64 = 14695981039346656037
            result <- canonical_hash_byte(result, 69)
            result <- canonical_hash_byte(result, 83)
            result <- canonical_hash_byte(result, 1)
            result <- canonical_hash_byte(result, 12)
            result <- canonical_hash_text(result, module.name)
            result <- canonical_hash_type_table(result, module.type_table) if module.type_table.rows.count != 0 or module.type_table.children.count != 0
            if module.globals.count != 0:
                result <- canonical_hash_byte(result, 15)
                result <- canonical_hash_u32(result, module.globals.count.u32())
                for binding in module.globals |result|:
                    result <- canonical_hash_global(result, binding)
            result <- canonical_hash_u32(result, module.functions.count.u32())
            for item in module.functions |result|:
                result <- canonical_hash_function(result, item)
            result <- canonical_hash_u32(result, module.handlers.count.u32())
            for item in module.handlers |result|:
                result <- canonical_hash_handler(result, item)
            return result


        # Public facade name used by differential artifacts and backend reports.
        # The canonical hash is deliberately a compact u64 fingerprint, not a
        # cryptographic identity or a substitute for the verified module itself.
        def module_fingerprint(module: Module&) -> u64:
            return canonical_module_hash(module)
