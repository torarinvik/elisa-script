extend EsIr:
    private:
        def has_u32(values: darray[u32]&, wanted: u32) -> bool:
            return any value in values where value == wanted


        def has_u64(values: darray[u64]&, wanted: u64) -> bool:
            return any value in values where value == wanted


        def has_text(values: darray[sview]&, wanted: sview) -> bool:
            return any value in values where value == wanted


        # Compute a pool slice end without allowing a hostile start/count pair
        # to wrap the host `usize`. The verifier uses the returned saturated end
        # for bounded iteration and the flag for the precise contract issue. An
        # invalid start or count returns an out-of-range marker so opcode checks
        # cannot mistake a clamped end for a valid slice and index the hostile
        # original start. Pool counts are always strictly below the host address
        # space limit, so `limit + 1` is representable for a real darray.
        def bounded_slice_end(start: usize, count: usize, limit: usize, valid: mutable bool&) -> usize:
            valid <- false
            return start if start > limit
            return limit + 1 if count > limit - start
            valid <- true
            return start + count


        def effect_granted(effects: darray[sview]&, required: sview) -> bool:
            for effect in effects |required|:
                true return if effect == required
                if sview_len(effect) > sview_len(required) and effect[0:sview_len(required)] == required and sview_at(effect, sview_len(required)) == 46:
                    return true
                if sview_len(required) > sview_len(effect) and required[0:sview_len(effect)] == effect and sview_at(required, sview_len(effect)) == 46:
                    return true
            return false


        def effect_reference_family(reference: sview) -> sview:
            for index in 0..<sview_len(reference) |reference|:
                reference[0:index] return if sview_at(reference, index) == 46
            return reference


        def effect_reference_operation(reference: sview) -> sview:
            for index in 0..<sview_len(reference) |reference|:
                return reference[index + 1:sview_len(reference)] if sview_at(reference, index) == 46 and index + 1 < sview_len(reference)
            return ""


        # Legacy hand-authored fixtures may leave operation_id at zero. Any
        # populated id, however, must be the canonical hash of the two textual
        # components so dispatch cannot silently pair a clause with another
        # operation after serialization or backend lowering.
        def operation_identity_matches(family: sview, operation: sview, operation_id: u64) -> bool:
            return true if operation_id == 0
            return operation_id == effect_operation_identity(family, operation)


        def verify_clause_matches(family: sview, operation: sview, operation_id: u64, clause: HandlerClause) -> bool:
            return false if clause.effect_family != family or clause.effect_operation != operation
            return true if clause.operation_id == 0 or operation_id == 0
            return clause.operation_id == operation_id


        def handler_index(handlers: darray[Handler]&, name: sview) -> usize:
            for index in 0..<handlers.count |handlers, name|:
                index return if handlers[index].name == name
            return handlers.count


        def function_index(functions: darray[Function]&, name: sview) -> usize:
            for index in 0..<functions.count |functions, name|:
                index return if functions[index].name == name
            return functions.count


        # A handler with no clauses is an explicit family mask. Once clauses
        # are present, coverage is operation-specific: a Progress.Tick clause
        # must not swallow Progress.Done or prevent an outer handler from
        # receiving it. This mirrors the runtime dispatcher and keeps effect
        # subtraction declaration-authoritative.
        def verify_handler_covers_operation(handler: Handler&, family: sview, operation: sview, operation_id: u64 = 0) -> bool:
            return false if not has_text(handler.handles, family)
            return true if handler.clauses.count == 0
            return any clause in handler.clauses where verify_clause_matches(family, operation, operation_id, clause)


        def active_handler_covers(installed: darray[sview]&, handlers: darray[Handler]&, family: sview, operation: sview, operation_id: u64 = 0) -> bool:
            while stack_index > 0 |stack_index: usize = installed.count|:
                stack_index <- stack_index - 1
                index: usize = handler_index(handlers, installed[stack_index])
                if index < handlers.count and verify_handler_covers_operation(handlers[index], family, operation, operation_id):
                    return true
            return false


        def validate_handler(handler: Handler&, module: Module&, issues: mutable darray[Issue]&) -> void can[Memory.Allocate, Abort.Panic]:
            issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "handler must have a non-empty name")) if handler.name == ""
            issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "handler has an unknown continuation policy")) if handler.continuation not in {ContinuationPolicy.Terminal, ContinuationPolicy.Linear, ContinuationPolicy.Affine, ContinuationPolicy.MultiReplay, ContinuationPolicy.MultiClone}
            for coverage_index in 0..<handler.handles.count |handler, issues|:
                coverage: sview = handler.handles[coverage_index]
                issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "handler coverage entries must not be empty")) if coverage == ""
                for earlier in 0..<coverage_index |handler, coverage, issues|:
                    issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "handler coverage family is declared more than once")) if handler.handles[earlier] == coverage
            for introduced in handler.introduces_effects |handler, issues|:
                issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "handler-introduced effects must not be empty")) if introduced == ""
            for handler_error in handler.errors |handler, issues|:
                issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "handler error sets must not be empty")) if handler_error == ""
            for replay_index in 0..<handler.replay_safe_effects.count |handler, issues|:
                replay_effect: sview = handler.replay_safe_effects[replay_index]
                issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "replay-safe effect entries must not be empty")) if replay_effect == ""
                for earlier in 0..<replay_index |handler, replay_effect, issues|:
                    issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "replay-safe effect is declared more than once")) if handler.replay_safe_effects[earlier] == replay_effect
            for capture_index in 0..<handler.captures.count |handler, issues|:
                capture: ContinuationCapture = handler.captures[capture_index]
                issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "continuation capture name must not be empty")) if capture.name == ""
                issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "continuation capture type must not be void")) if capture.type.kind == TypeKind.Void
                issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "continuation capture has an unknown capture class")) if capture.class not in {CaptureClass.Unrestricted, CaptureClass.Affine, CaptureClass.Linear, CaptureClass.Borrowed, CaptureClass.RegionBound, CaptureClass.Opaque}
                for earlier in 0..<capture_index |handler, capture, issues|:
                    issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "continuation capture name is declared more than once")) if handler.captures[earlier].name == capture.name and capture.name != ""
            for clause_index in 0..<handler.clauses.count |handler, module, issues|:
                clause: HandlerClause = handler.clauses[clause_index]
                issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "handler clause must name an effect family, operation, and function")) if clause.effect_family == "" or clause.effect_operation == "" or clause.function == ""
                issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "handler clause operation id does not match its family and operation")) if clause.effect_family != "" and clause.effect_operation != "" and not operation_identity_matches(clause.effect_family, clause.effect_operation, clause.operation_id)
                issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "handler clause family is absent from the handler coverage set")) if clause.effect_family != "" and not has_text(handler.handles, clause.effect_family)
                issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "handler clause names an unknown function")) if clause.function != "" and function_index(module.functions, clause.function) == module.functions.count
                issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "terminal handler clauses cannot resume continuations")) if handler.continuation == ContinuationPolicy.Terminal
                for earlier in 0..<clause_index |handler, clause, issues|:
                    duplicate: bool = handler.clauses[earlier].effect_family == clause.effect_family and handler.clauses[earlier].effect_operation == clause.effect_operation
                    issues.push(issue(IssueKind.HandlerContract, handler.name, 0, 0, 0, "handler declares the same operation clause more than once")) if duplicate
            if handler.continuation in {ContinuationPolicy.MultiClone, ContinuationPolicy.MultiReplay}:
                for capture in handler.captures |handler, issues|:
                    issues.push(issue(IssueKind.UnsafeMultiShot, handler.name, 0, 0, 0, "multi-shot continuation captures a value that is not unrestricted")) if capture.class != CaptureClass.Unrestricted
                    # Flat RuntimeValue snapshots cannot deep-copy mutable
                    # aggregate storage yet. TypeKind.Map deliberately includes
                    # the `__elisascript_set` representation, so dictionaries
                    # and sets are rejected uniformly at the verified IR
                    # boundary instead of waiting for the runtime to discover
                    # an alias after a resume.
                    issues.push(issue(IssueKind.UnsafeMultiShot, handler.name, 0, 0, 0, "multi-shot continuation captures mutable aggregate storage")) if capture.type.kind in {TypeKind.Array, TypeKind.Map}
            if handler.continuation == ContinuationPolicy.MultiReplay:
                for effect in handler.introduces_effects |handler, issues|:
                    issues.push(issue(IssueKind.UnsafeMultiShot, handler.name, 0, 0, 0, "multi-replay handler introduces an effect not proven replay-safe")) if not has_text(handler.replay_safe_effects, effect)


        def issue(kind: IssueKind, function: sview, block: u32, value: u32, trace: u64, message: sview) -> Issue:
            return Issue{kind: kind, function: function, block: block, value: value, trace: trace, message: message}


        def definition_block(values: darray[u32]&, blocks: darray[u32]&, value: u32) -> u32:
            for index in 0..<values.count |values, blocks, value|:
                blocks[index] return if values[index] == value
            return 0


        def definition_type(values: darray[u32]&, types: darray[Type]&, value: u32) -> Type:
            for index in 0..<values.count |values, types, value|:
                types[index] return if values[index] == value
            return Type{kind: TypeKind.Void}


        def same_type(left: Type&, right: Type&) -> bool:
            # Once a module has been interned, ids are canonical within that
            # module and provide the fast structural equality path. Lowering and
            # legacy hand-built IR keep ids at zero and use the compatibility
            # field-wise comparison below.
            return left.descriptor_id == right.descriptor_id if left.descriptor_id != 0 and right.descriptor_id != 0
            return false if left.element_element_element_element_element_element_kind != right.element_element_element_element_element_element_kind
            return false if left.element_element_element_element_element_element_name != right.element_element_element_element_element_element_name
            return false if left.element_element_element_element_element_element_bits != right.element_element_element_element_element_element_bits
            return false if left.element_element_element_element_element_element_signed != right.element_element_element_element_element_element_signed
            return left.kind == right.kind and left.name == right.name and left.bits == right.bits and left.signed == right.signed and left.element_kind == right.element_kind and left.element_name == right.element_name and left.element_bits == right.element_bits and left.element_signed == right.element_signed and left.element_element_kind == right.element_element_kind and left.element_element_name == right.element_element_name and left.element_element_bits == right.element_element_bits and left.element_element_signed == right.element_element_signed and left.element_element_element_kind == right.element_element_element_kind and left.element_element_element_name == right.element_element_element_name and left.element_element_element_bits == right.element_element_element_bits and left.element_element_element_signed == right.element_element_element_signed and left.element_element_element_element_kind == right.element_element_element_element_kind and left.element_element_element_element_name == right.element_element_element_element_name and left.element_element_element_element_bits == right.element_element_element_element_bits and left.element_element_element_element_signed == right.element_element_element_element_signed and left.element_element_element_element_element_kind == right.element_element_element_element_element_kind and left.element_element_element_element_element_name == right.element_element_element_element_element_name and left.element_element_element_element_element_bits == right.element_element_element_element_element_bits and left.element_element_element_element_element_signed == right.element_element_element_element_element_signed


        def exact_usize(value: Type&) -> bool:
            return value.kind == TypeKind.Int and value.bits == 64 and not value.signed


        def verify_type_kinds_valid(value: Type&) -> bool:
            return value.kind in {TypeKind.Void, TypeKind.Bool, TypeKind.Int, TypeKind.Float, TypeKind.Char, TypeKind.Text, TypeKind.Bytes, TypeKind.Array, TypeKind.Map, TypeKind.Named, TypeKind.Function, TypeKind.Block} and value.element_kind in {TypeKind.Void, TypeKind.Bool, TypeKind.Int, TypeKind.Float, TypeKind.Char, TypeKind.Text, TypeKind.Bytes, TypeKind.Array, TypeKind.Map, TypeKind.Named, TypeKind.Function, TypeKind.Block} and value.element_element_kind in {TypeKind.Void, TypeKind.Bool, TypeKind.Int, TypeKind.Float, TypeKind.Char, TypeKind.Text, TypeKind.Bytes, TypeKind.Array, TypeKind.Map, TypeKind.Named, TypeKind.Function, TypeKind.Block} and value.element_element_element_kind in {TypeKind.Void, TypeKind.Bool, TypeKind.Int, TypeKind.Float, TypeKind.Char, TypeKind.Text, TypeKind.Bytes, TypeKind.Array, TypeKind.Map, TypeKind.Named, TypeKind.Function, TypeKind.Block} and value.element_element_element_element_kind in {TypeKind.Void, TypeKind.Bool, TypeKind.Int, TypeKind.Float, TypeKind.Char, TypeKind.Text, TypeKind.Bytes, TypeKind.Array, TypeKind.Map, TypeKind.Named, TypeKind.Function, TypeKind.Block} and value.element_element_element_element_element_kind in {TypeKind.Void, TypeKind.Bool, TypeKind.Int, TypeKind.Float, TypeKind.Char, TypeKind.Text, TypeKind.Bytes, TypeKind.Array, TypeKind.Map, TypeKind.Named, TypeKind.Function, TypeKind.Block} and value.element_element_element_element_element_element_kind in {TypeKind.Void, TypeKind.Bool, TypeKind.Int, TypeKind.Float, TypeKind.Char, TypeKind.Text, TypeKind.Bytes, TypeKind.Array, TypeKind.Map, TypeKind.Named, TypeKind.Function, TypeKind.Block}


        def validate_type_id(value: Type, function: sview, module: Module&, issues: mutable darray[Issue]&) -> void can[Memory.Allocate, Abort.Panic]:
            issues.push(issue(IssueKind.InvalidTypeTable, function, 0, 0, 0, "typed IR value carries an unknown type kind")) if not verify_type_kinds_valid(value)
            issues.push(issue(IssueKind.InvalidTypeTable, function, 0, 0, 0, "typed IR value carries a descriptor id that does not match its inline shape")) if value.descriptor_id != 0 and not type_table_matches_inline(value, value.descriptor_id, module.type_table)


        def validate_module_type_ids(module: Module&, issues: mutable darray[Issue]&) -> void can[Memory.Allocate, Abort.Panic]:
            for binding in module.globals |module, issues|:
                validate_type_id(binding.type, binding.name, module, issues)
            for fn in module.functions |module, issues|:
                validate_type_id(fn.return_type, fn.name, module, issues)
                for parameter in fn.parameters |fn, module, issues|:
                    validate_type_id(parameter.type, fn.name, module, issues)
                for parameter in fn.block_parameter_pool |fn, module, issues|:
                    validate_type_id(parameter.type, fn.name, module, issues)
                for instruction in fn.instruction_pool |fn, module, issues|:
                    validate_type_id(instruction.result_type, fn.name, module, issues)
            for handler in module.handlers |module, issues|:
                for capture in handler.captures |handler, module, issues|:
                    validate_type_id(capture.type, handler.name, module, issues)


        def array_element_type_legacy(array_type: Type&) -> Type:
            return Type{kind: array_type.element_kind, name: array_type.element_name, bits: array_type.element_bits, signed: array_type.element_signed, element_kind: array_type.element_element_kind, element_name: array_type.element_element_name, element_bits: array_type.element_element_bits, element_signed: array_type.element_element_signed, element_element_kind: array_type.element_element_element_kind, element_element_name: array_type.element_element_element_name, element_element_bits: array_type.element_element_element_bits, element_element_signed: array_type.element_element_element_signed, element_element_element_kind: array_type.element_element_element_element_kind, element_element_element_name: array_type.element_element_element_element_name, element_element_element_bits: array_type.element_element_element_element_bits, element_element_element_signed: array_type.element_element_element_element_signed, element_element_element_element_kind: array_type.element_element_element_element_element_kind, element_element_element_element_name: array_type.element_element_element_element_element_name, element_element_element_element_bits: array_type.element_element_element_element_element_bits, element_element_element_element_signed: array_type.element_element_element_element_element_signed}


        def array_element_type(array_type: Type&) -> Type:
            result: mutable Type = array_element_type_legacy(array_type)
            result.element_element_element_element_element_kind <- array_type.element_element_element_element_element_element_kind
            result.element_element_element_element_element_name <- array_type.element_element_element_element_element_element_name
            result.element_element_element_element_element_bits <- array_type.element_element_element_element_element_element_bits
            result.element_element_element_element_element_signed <- array_type.element_element_element_element_element_element_signed
            return result


        def map_key_type(map_type: Type&) -> Type:
            return Type{kind: map_type.element_kind, name: map_type.element_name, bits: map_type.element_bits, signed: map_type.element_signed}


        def map_value_type_legacy(map_type: Type&) -> Type:
            return Type{kind: map_type.element_element_kind, name: map_type.element_element_name, bits: map_type.element_element_bits, signed: map_type.element_element_signed, element_kind: map_type.element_element_element_kind, element_name: map_type.element_element_element_name, element_bits: map_type.element_element_element_bits, element_signed: map_type.element_element_element_signed, element_element_kind: map_type.element_element_element_element_kind, element_element_name: map_type.element_element_element_element_name, element_element_bits: map_type.element_element_element_element_bits, element_element_signed: map_type.element_element_element_element_signed, element_element_element_kind: map_type.element_element_element_element_element_kind, element_element_element_name: map_type.element_element_element_element_element_name, element_element_element_bits: map_type.element_element_element_element_element_bits, element_element_element_signed: map_type.element_element_element_element_element_signed}


        def map_value_type(map_type: Type&) -> Type:
            result: mutable Type = map_value_type_legacy(map_type)
            result.element_element_element_element_kind <- map_type.element_element_element_element_element_element_kind
            result.element_element_element_element_name <- map_type.element_element_element_element_element_element_name
            result.element_element_element_element_bits <- map_type.element_element_element_element_element_element_bits
            result.element_element_element_element_signed <- map_type.element_element_element_element_element_element_signed
            return result


        def array_of_type_legacy(element: Type&) -> Type:
            return Type{kind: TypeKind.Array, element_kind: element.kind, element_name: element.name, element_bits: element.bits, element_element_kind: element.element_kind, element_element_name: element.element_name, element_element_bits: element.element_bits, element_element_element_kind: element.element_element_kind, element_element_element_name: element.element_element_name, element_element_element_bits: element.element_element_bits, element_element_element_signed: element.element_element_signed, element_element_element_element_kind: element.element_element_element_kind, element_element_element_element_name: element.element_element_element_name, element_element_element_element_bits: element.element_element_element_bits, element_element_element_element_signed: element.element_element_element_signed, element_element_element_element_element_kind: element.element_element_element_element_kind, element_element_element_element_element_name: element.element_element_element_element_name, element_element_element_element_element_bits: element.element_element_element_element_bits, element_element_element_element_element_signed: element.element_element_element_element_signed, element_element_signed: element.element_signed, element_signed: element.signed}


        def array_of_type(element: Type&) -> Type:
            result: mutable Type = array_of_type_legacy(element)
            result.element_element_element_element_element_element_kind <- element.element_element_element_element_element_kind
            result.element_element_element_element_element_element_name <- element.element_element_element_element_element_name
            result.element_element_element_element_element_element_bits <- element.element_element_element_element_element_bits
            result.element_element_element_element_element_element_signed <- element.element_element_element_element_element_signed
            return result


        def numeric_type(value: Type&) -> bool:
            return value.kind == TypeKind.Int or value.kind == TypeKind.Float


        def text_backed_named_type(value: Type&) -> bool:
            return value.kind == TypeKind.Named and value.name in {"Path", "Glob", "Regex", "Executable", "Url"}


        def global_scalar_type_supported(value: Type&) -> bool:
            return value.kind in {TypeKind.Bool, TypeKind.Int, TypeKind.Float, TypeKind.Char, TypeKind.Text} or text_backed_named_type(value)


        def global_type_supported(value: Type&) -> bool:
            return true if global_scalar_type_supported(value)
            # The element/key/value accessors return a TEMPORARY, and a temporary has no
            # address to take, so it cannot bind to the `Type&` parameter. Name each one.
            if value.kind == TypeKind.Array:
                element_type: Type = array_element_type(value)
                return global_scalar_type_supported(element_type)
            if value.kind == TypeKind.Map:
                key_type: Type = map_key_type(value)
                value_type: Type = map_value_type(value)
                return global_scalar_type_supported(key_type) and global_scalar_type_supported(value_type)
            return false


        def global_literal_matches_type(value: GlobalLiteral&, expected: Type&) -> bool:
            return value.kind == expected.kind


        def global_index(globals: darray[Global]&, name: sview) -> usize:
            for index in 0..<globals.count |globals, name|:
                return index if globals[index].name == name
            return globals.count


        def equality_type(value: Type&) -> bool:
            return value.kind in {TypeKind.Bool, TypeKind.Int, TypeKind.Float, TypeKind.Char, TypeKind.Text, TypeKind.Array, TypeKind.Map} or text_backed_named_type(value) or (value.kind == TypeKind.Named and value.name == "ProcessCapture")


        def verify_edge(fn: Function&, source: Block&, target_id: u32, argument_start: u32, argument_count: u16, defined: darray[u32]&, definition_blocks: darray[u32]&, definition_types: darray[Type]&, issues: mutable darray[Issue]&) -> void can[Memory.Allocate, Abort.Panic]:
            for target in fn.blocks |fn, source, target_id, argument_start, argument_count, defined, definition_blocks, definition_types, issues|:
                if target.id == target_id:
                    issues.push(issue(IssueKind.EdgeArgumentArity, fn.name, source.id, 0, 0, "edge argument count does not match target block parameters")) if argument_count != target.parameter_count
                    argument_end_valid: mutable bool = false
                    argument_end: usize = bounded_slice_end(argument_start.usize(), argument_count.usize(), fn.edge_arg_pool.count, argument_end_valid)
                    if not argument_end_valid:
                        issues.push(issue(IssueKind.EdgeArgumentArity, fn.name, source.id, 0, 0, "edge argument slice is outside the function pool"))
                        return
                    paired: usize = argument_count.usize() if argument_count < target.parameter_count else target.parameter_count.usize()
                    for offset in 0..<paired |fn, source, target, argument_start, defined, definition_blocks, definition_types, issues|:
                        value: u32 = fn.edge_arg_pool[argument_start.usize() + offset]
                        if value == 0 or not has_u32(defined, value):
                            issues.push(issue(IssueKind.UndefinedValue, fn.name, source.id, value, 0, "edge passes an undefined SSA value"))
                        else:
                            def_block: u32 = definition_block(defined, definition_blocks, value)
                            issues.push(issue(IssueKind.NonDominatingValue, fn.name, source.id, value, 0, "edge argument definition does not dominate its source block")) if not block_dominates(fn, def_block, source.id)
                            actual: Type = definition_type(defined, definition_types, value)
                            parameter_index: mutable usize = target.parameter_start.usize()
                            if parameter_index <= fn.block_parameter_pool.count:
                                if offset <= fn.block_parameter_pool.count - parameter_index:
                                    parameter_index <- parameter_index + offset
                                else:
                                    parameter_index <- fn.block_parameter_pool.count
                            else:
                                parameter_index <- fn.block_parameter_pool.count
                            issues.push(issue(IssueKind.EdgeArgumentType, fn.name, source.id, value, 0, "edge argument type does not match target block parameter")) if parameter_index >= fn.block_parameter_pool.count or not same_type(actual, fn.block_parameter_pool[parameter_index].type)
                    return


        # A definition dominates USE when removing its block makes USE unreachable from
        # entry. Same-block ordering is checked separately by the ordinary defined set.
        def block_dominates(fn: Function&, definition: u32, use: u32) -> bool can[Memory.Allocate, Abort.Panic]:
            true return if definition == use or definition == fn.entry
            frontier: mutable darray[u32] = [fn.entry]
            visited: mutable darray[u32] = []
            while frontier.count > 0 |frontier, visited, fn, definition, use|:
                current: u32 = frontier.pop()
                continue if current == definition or has_u32(visited, current)
                false return if current == use
                visited.push(current)
                for block in fn.blocks |frontier, current, visited, definition|:
                    if block.id == current:
                        frontier.push(block.terminator.target0) if block.terminator.target_count >= 1 and block.terminator.target0 != definition and not has_u32(visited, block.terminator.target0)
                        frontier.push(block.terminator.target1) if block.terminator.target_count >= 2 and block.terminator.target1 != definition and not has_u32(visited, block.terminator.target1)
            return true


        def verify_terminator(fn: Function&, block: Block&, defined: darray[u32]&, definition_blocks: darray[u32]&, definition_types: darray[Type]&, block_ids: darray[u32]&, issues: mutable darray[Issue]&) -> void can[Memory.Allocate, Abort.Panic]:
            issues.push(issue(IssueKind.UndefinedValue, fn.name, block.id, block.terminator.operand, 0, "terminator uses an undefined SSA value")) if block.terminator.operand_count == 1 and (block.terminator.operand == 0 or not has_u32(defined, block.terminator.operand))
            if block.terminator.operand_count == 1 and has_u32(defined, block.terminator.operand):
                def_block: u32 = definition_block(defined, definition_blocks, block.terminator.operand)
                issues.push(issue(IssueKind.NonDominatingValue, fn.name, block.id, block.terminator.operand, 0, "terminator value definition does not dominate this block")) if not block_dominates(fn, def_block, block.id)
            issues.push(issue(IssueKind.UnknownTarget, fn.name, block.id, block.terminator.target0, 0, "terminator targets an unknown block")) if block.terminator.target_count >= 1 and not has_u32(block_ids, block.terminator.target0)
            issues.push(issue(IssueKind.UnknownTarget, fn.name, block.id, block.terminator.target1, 0, "terminator targets an unknown block")) if block.terminator.target_count >= 2 and not has_u32(block_ids, block.terminator.target1)
            verify_edge(fn, block, block.terminator.target0, block.terminator.edge0_arg_start, block.terminator.edge0_arg_count, defined, definition_blocks, definition_types, issues) if block.terminator.target_count >= 1 and has_u32(block_ids, block.terminator.target0)
            verify_edge(fn, block, block.terminator.target1, block.terminator.edge1_arg_start, block.terminator.edge1_arg_count, defined, definition_blocks, definition_types, issues) if block.terminator.target_count >= 2 and has_u32(block_ids, block.terminator.target1)
            match block.terminator.kind:
                TerminatorKind.Return:
                    expected: usize = 0 if fn.return_type.kind == TypeKind.Void else 1
                    issues.push(issue(IssueKind.InvalidTerminator, fn.name, block.id, 0, 0, "return has the wrong number of values")) if block.terminator.operand_count.usize() != expected or block.terminator.target_count != 0
                    if expected == 1 and block.terminator.operand_count == 1 and has_u32(defined, block.terminator.operand):
                        actual: Type = definition_type(defined, definition_types, block.terminator.operand)
                        issues.push(issue(IssueKind.InvalidTerminator, fn.name, block.id, block.terminator.operand, 0, "return value type does not match the function return type")) if not same_type(actual, fn.return_type)
                TerminatorKind.Jump:
                    issues.push(issue(IssueKind.InvalidTerminator, fn.name, block.id, 0, 0, "jump requires exactly one target")) if block.terminator.target_count != 1 or block.terminator.operand_count != 0
                TerminatorKind.Branch:
                    issues.push(issue(IssueKind.InvalidTerminator, fn.name, block.id, 0, 0, "branch requires a condition and two targets")) if block.terminator.operand_count != 1 or block.terminator.target_count != 2
                    if block.terminator.operand_count == 1 and has_u32(defined, block.terminator.operand):
                        condition_type: Type = definition_type(defined, definition_types, block.terminator.operand)
                        issues.push(issue(IssueKind.InvalidTerminator, fn.name, block.id, block.terminator.operand, 0, "branch condition must be boolean")) if condition_type.kind != TypeKind.Bool
                TerminatorKind.Unreachable:
                    issues.push(issue(IssueKind.InvalidTerminator, fn.name, block.id, 0, 0, "unreachable cannot carry operands or targets")) if block.terminator.operand_count != 0 or block.terminator.target_count != 0


        def verify_function(fn: Function&, module: Module&, issues: mutable darray[Issue]&) -> void can[Memory.Allocate, Abort.Panic]:
            block_ids: mutable darray[u32] = []
            for block in fn.blocks |block_ids, issues|:
                issues.push(issue(IssueKind.DuplicateBlock, fn.name, block.id, 0, 0, "block id is defined more than once")) if has_u32(block_ids, block.id)
                block_ids.push(block.id)
            issues.push(issue(IssueKind.MissingEntry, fn.name, fn.entry, 0, 0, "entry block does not exist")) if not has_u32(block_ids, fn.entry)

            defined: mutable darray[u32] = []
            definition_blocks: mutable darray[u32] = []
            definition_types: mutable darray[Type] = []
            traces: mutable darray[u64] = []
            handler_stack: mutable darray[sview] = []
            for parameter in fn.parameters |defined, definition_blocks, definition_types, issues|:
                issues.push(issue(IssueKind.DuplicateValue, fn.name, fn.entry, parameter.value, 0, "parameter SSA value is duplicated or zero")) if parameter.value == 0 or has_u32(defined, parameter.value)
                defined.push(parameter.value) if parameter.value != 0 and not has_u32(defined, parameter.value)
                definition_blocks.push(fn.entry) if parameter.value != 0 and definition_blocks.count < defined.count
                definition_types.push(parameter.type) if parameter.value != 0 and definition_types.count < defined.count
            for block in fn.blocks |defined, definition_blocks, definition_types, traces, block_ids, issues|:
                parameter_end_valid: mutable bool = false
                parameter_end: usize = bounded_slice_end(block.parameter_start.usize(), block.parameter_count.usize(), fn.block_parameter_pool.count, parameter_end_valid)
                issues.push(issue(IssueKind.EdgeArgumentArity, fn.name, block.id, 0, 0, "block parameter slice is outside the function pool")) if not parameter_end_valid
                safe_parameter_start: usize = block.parameter_start.usize() if block.parameter_start.usize() <= fn.block_parameter_pool.count else fn.block_parameter_pool.count
                safe_parameter_end: usize = parameter_end if parameter_end <= fn.block_parameter_pool.count else fn.block_parameter_pool.count
                for parameter_index in safe_parameter_start..<safe_parameter_end |defined, definition_blocks, definition_types, issues, block, fn|:
                    parameter: Parameter = fn.block_parameter_pool[parameter_index]
                    issues.push(issue(IssueKind.DuplicateValue, fn.name, block.id, parameter.value, 0, "block parameter SSA value is duplicated or zero")) if parameter.value == 0 or has_u32(defined, parameter.value)
                    defined.push(parameter.value) if parameter.value != 0 and not has_u32(defined, parameter.value)
                    definition_blocks.push(block.id) if parameter.value != 0 and definition_blocks.count < defined.count
                    definition_types.push(parameter.type) if parameter.value != 0 and definition_types.count < defined.count
                instruction_end_valid: mutable bool = false
                instruction_end: usize = bounded_slice_end(block.instruction_start.usize(), block.instruction_count.usize(), fn.instruction_pool.count, instruction_end_valid)
                issues.push(issue(IssueKind.UndefinedValue, fn.name, block.id, 0, 0, "block instruction slice is outside the function pool")) if not instruction_end_valid
                safe_instruction_start: usize = block.instruction_start.usize() if block.instruction_start.usize() <= fn.instruction_pool.count else fn.instruction_pool.count
                safe_instruction_end: usize = instruction_end if instruction_end <= fn.instruction_pool.count else fn.instruction_pool.count
                for instruction_index in safe_instruction_start..<safe_instruction_end |defined, traces, issues, block, fn, block_ids|:
                    instruction: Instruction = fn.instruction_pool[instruction_index]
                    operand_end_valid: mutable bool = false
                    operand_end: usize = bounded_slice_end(instruction.operand_start.usize(), instruction.operand_count.usize(), fn.operand_pool.count, operand_end_valid)
                    issues.push(issue(IssueKind.UndefinedValue, fn.name, block.id, 0, instruction.trace.id, "instruction operand slice is outside the function pool")) if not operand_end_valid
                    safe_operand_start: usize = instruction.operand_start.usize() if instruction.operand_start.usize() <= fn.operand_pool.count else fn.operand_pool.count
                    safe_end: usize = operand_end if operand_end <= fn.operand_pool.count else fn.operand_pool.count
                    for operand_index in safe_operand_start..<safe_end |defined, issues, block, instruction, fn|:
                        operand: u32 = fn.operand_pool[operand_index]
                        issues.push(issue(IssueKind.UndefinedValue, fn.name, block.id, operand, instruction.trace.id, "instruction uses an undefined SSA value")) if operand == 0 or not has_u32(defined, operand)
                        if operand != 0 and has_u32(defined, operand):
                            def_block: u32 = definition_block(defined, definition_blocks, operand)
                            issues.push(issue(IssueKind.NonDominatingValue, fn.name, block.id, operand, instruction.trace.id, "SSA value definition does not dominate this use")) if not block_dominates(fn, def_block, block.id)
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "constant must not have operands")) if instruction.opcode == Opcode.Constant and instruction.operand_count != 0
                    supported_constant: bool = instruction.result_type.kind in {TypeKind.Bool, TypeKind.Int, TypeKind.Float, TypeKind.Char, TypeKind.Text} or text_backed_named_type(instruction.result_type)
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "constant result type has no canonical runtime representation")) if instruction.opcode == Opcode.Constant and not supported_constant
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "global load must not have operands and must produce a value")) if instruction.opcode == Opcode.LoadGlobal and (instruction.operand_count != 0 or instruction.result == 0)
                    if instruction.opcode == Opcode.LoadGlobal and instruction.operand_count == 0 and instruction.result != 0:
                        valid_global: bool = instruction.integer >= 0 and instruction.integer.usize() < module.globals.count
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "global load names an unknown module global")) if not valid_global
                        if valid_global:
                            load_global_type: Type = module.globals[instruction.integer.usize()].type
                            issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "global load result type does not match the module global")) if not same_type(instruction.result_type, load_global_type)
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "global store requires one operand, a void result, and no SSA result")) if instruction.opcode == Opcode.StoreGlobal and (instruction.operand_count != 1 or instruction.result != 0 or instruction.result_type.kind != TypeKind.Void)
                    if instruction.opcode == Opcode.StoreGlobal and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        valid_global: bool = instruction.integer >= 0 and instruction.integer.usize() < module.globals.count
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "global store names an unknown module global")) if not valid_global
                        if valid_global:
                            operand: u32 = fn.operand_pool[instruction.operand_start.usize()]
                            if has_u32(defined, operand):
                                stored_type: Type = definition_type(defined, definition_types, operand)
                                global_store_type: Type = module.globals[instruction.integer.usize()].type
                                issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "global store value type does not match the module global")) if not same_type(stored_type, global_store_type)
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "copy must have exactly one operand")) if instruction.opcode == Opcode.Copy and instruction.operand_count != 1
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "nominal formatting must have exactly one operand")) if instruction.opcode == Opcode.FormatNominal and instruction.operand_count != 1
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "aggregate formatting must have exactly one operand")) if instruction.opcode == Opcode.FormatAggregate and instruction.operand_count != 1
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "char formatting must have exactly one operand")) if instruction.opcode == Opcode.FormatChar and instruction.operand_count != 1
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "binary instruction must have exactly two operands")) if instruction.opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder, Opcode.Equal, Opcode.NotEqual, Opcode.Less, Opcode.LessEqual, Opcode.Greater, Opcode.GreaterEqual, Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight} and instruction.operand_count != 2
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "concatenation must have exactly two operands")) if instruction.opcode == Opcode.Concat and instruction.operand_count != 2
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "indexed update must have exactly three operands")) if instruction.opcode == Opcode.SetIndex and instruction.operand_count != 3
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "indexed deletion must have exactly two operands")) if instruction.opcode == Opcode.DeleteIndex and instruction.operand_count != 2
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "error guard push must not have operands and must have a void result")) if instruction.opcode == Opcode.ErrorGuardPush and (instruction.operand_count != 0 or instruction.result_type.kind != TypeKind.Void)
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "error guard push target must name a known block")) if instruction.opcode == Opcode.ErrorGuardPush and (instruction.integer < 0 or not has_u32(block_ids, instruction.integer.u32()))
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "error guard variant metadata must provide both family and operation or neither")) if instruction.opcode == Opcode.ErrorGuardPush and (instruction.effect_family == "" and instruction.effect_operation != "" or instruction.effect_family != "" and instruction.effect_operation == "")
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "error guard pop must not have operands and must have a void result")) if instruction.opcode == Opcode.ErrorGuardPop and (instruction.operand_count != 0 or instruction.result_type.kind != TypeKind.Void)
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "unary instruction must have exactly one operand")) if instruction.opcode in {Opcode.Negate, Opcode.Not, Opcode.BitNot} and instruction.operand_count != 1
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "assert requires one operand and a void result")) if instruction.opcode == Opcode.Assert and (instruction.operand_count != 1 or instruction.result_type.kind != TypeKind.Void)
                    if instruction.opcode == Opcode.Assert and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        condition_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "assert operand must be boolean")) if condition_type.kind != TypeKind.Bool
                        issues.push(issue(IssueKind.MissingError, fn.name, block.id, instruction.result, instruction.trace.id, "assert requires AssertionError in the function error row")) if not has_text(fn.errors, "AssertionError")
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "panic requires zero or one operand, a void result, and Abort.Panic metadata")) if instruction.opcode == Opcode.Panic and (instruction.operand_count > 1 or instruction.result != 0 or instruction.result_type.kind != TypeKind.Void or instruction.effect_family != "Abort" or instruction.effect_operation != "Panic")
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "raise operands must produce no result and carry a family/tag")) if instruction.opcode == Opcode.Raise and (instruction.result != 0 or instruction.result_type.kind != TypeKind.Void or instruction.effect_family == "" or instruction.effect_operation == "")
                    if instruction.opcode == Opcode.Raise and instruction.effect_family != "" and instruction.effect_operation != "":
                        issues.push(issue(IssueKind.MissingError, fn.name, block.id, instruction.result, instruction.trace.id, "raised error family is absent from the function error row")) if not has_text(fn.errors, instruction.effect_family)
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "error payload extraction must have no operands, a typed value result, and a non-negative payload index")) if instruction.opcode == Opcode.ErrorPayload and (instruction.operand_count != 0 or instruction.result == 0 or instruction.integer < 0 or (instruction.result_type.kind == TypeKind.Named and instruction.result_type.name == ""))
                    if instruction.opcode == Opcode.Copy and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        operand: u32 = fn.operand_pool[instruction.operand_start.usize()]
                        if has_u32(defined, operand):
                            operand_type: Type = definition_type(defined, definition_types, operand)
                            issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "copy result type must match its operand")) if not same_type(instruction.result_type, operand_type)
                    if instruction.opcode == Opcode.FormatNominal and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        operand: u32 = fn.operand_pool[instruction.operand_start.usize()]
                        if has_u32(defined, operand):
                            operand_type: Type = definition_type(defined, definition_types, operand)
                            issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "nominal formatting requires a text-backed nominal operand and text result")) if not text_backed_named_type(operand_type) or instruction.result_type.kind != TypeKind.Text
                    if instruction.opcode == Opcode.FormatAggregate and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        operand: u32 = fn.operand_pool[instruction.operand_start.usize()]
                        if has_u32(defined, operand):
                            operand_type: Type = definition_type(defined, definition_types, operand)
                            issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "aggregate formatting requires an array or dictionary operand and text result")) if operand_type.kind != TypeKind.Array and operand_type.kind != TypeKind.Map or instruction.result_type.kind != TypeKind.Text
                    if instruction.opcode == Opcode.FormatChar and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        operand: u32 = fn.operand_pool[instruction.operand_start.usize()]
                        if has_u32(defined, operand):
                            operand_type: Type = definition_type(defined, definition_types, operand)
                            issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "char formatting requires a char operand and text result")) if operand_type.kind != TypeKind.Char or instruction.result_type.kind != TypeKind.Text
                    if instruction.opcode in {Opcode.Negate, Opcode.Not, Opcode.BitNot} and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        operand: u32 = fn.operand_pool[instruction.operand_start.usize()]
                        if has_u32(defined, operand):
                            operand_type: Type = definition_type(defined, definition_types, operand)
                            valid_negate: bool = instruction.opcode == Opcode.Negate and numeric_type(operand_type) and same_type(instruction.result_type, operand_type)
                            valid_not: bool = instruction.opcode == Opcode.Not and operand_type.kind == TypeKind.Bool and instruction.result_type.kind == TypeKind.Bool
                            valid_bit_not: bool = instruction.opcode == Opcode.BitNot and operand_type.kind == TypeKind.Int and same_type(instruction.result_type, operand_type)
                            issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "unary operand and result types do not match the operation")) if not valid_negate and not valid_not and not valid_bit_not
                    if instruction.opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder, Opcode.Equal, Opcode.NotEqual, Opcode.Less, Opcode.LessEqual, Opcode.Greater, Opcode.GreaterEqual, Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight} and instruction.operand_count == 2 and operand_end <= fn.operand_pool.count:
                        left_value: u32 = fn.operand_pool[instruction.operand_start.usize()]
                        right_value: u32 = fn.operand_pool[instruction.operand_start.usize() + 1]
                        if has_u32(defined, left_value) and has_u32(defined, right_value):
                            left_type: Type = definition_type(defined, definition_types, left_value)
                            right_type: Type = definition_type(defined, definition_types, right_value)
                            operands_match: bool = same_type(left_type, right_type)
                            arithmetic: bool = instruction.opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder}
                            equality: bool = instruction.opcode == Opcode.Equal or instruction.opcode == Opcode.NotEqual
                            ordering: bool = instruction.opcode in {Opcode.Less, Opcode.LessEqual, Opcode.Greater, Opcode.GreaterEqual}
                            bitwise: bool = instruction.opcode in {Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight}
                            arithmetic_valid: bool = arithmetic and operands_match and numeric_type(left_type) and same_type(instruction.result_type, left_type) and (instruction.opcode != Opcode.Remainder or left_type.kind == TypeKind.Int)
                            equality_valid: bool = equality and operands_match and equality_type(left_type) and instruction.result_type.kind == TypeKind.Bool
                            ordering_valid: bool = ordering and operands_match and (numeric_type(left_type) or left_type.kind == TypeKind.Text or left_type.kind == TypeKind.Char) and instruction.result_type.kind == TypeKind.Bool
                            bitwise_valid: bool = bitwise and operands_match and left_type.kind == TypeKind.Int and same_type(instruction.result_type, left_type)
                            issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "binary operand and result types do not match the operation")) if not arithmetic_valid and not equality_valid and not ordering_valid and not bitwise_valid
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "dynamic range condition requires current, bound, and step operands")) if instruction.opcode == Opcode.RangeCondition and instruction.operand_count != 3
                    if instruction.opcode == Opcode.RangeCondition and instruction.operand_count == 3 and operand_end <= fn.operand_pool.count:
                        current_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                        high_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize() + 1])
                        step_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize() + 2])
                        valid_range_types: bool = current_type.kind == TypeKind.Int and same_type(current_type, high_type) and same_type(current_type, step_type) and instruction.result_type.kind == TypeKind.Bool and instruction.integer >= 0 and instruction.integer <= 2
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "dynamic range condition requires matching integer operands, boolean result, and a valid endpoint mode")) if not valid_range_types
                        issues.push(issue(IssueKind.MissingError, fn.name, block.id, instruction.result, instruction.trace.id, "dynamic range condition requires RangeStepZero in the function error row")) if not has_text(fn.errors, "RangeStepZero")
                    if instruction.opcode == Opcode.Concat and instruction.operand_count == 2 and operand_end <= fn.operand_pool.count:
                        left_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                        right_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize() + 1])
                        concat_kind: bool = left_type.kind in {TypeKind.Array, TypeKind.Text} or (left_type.kind == TypeKind.Map and left_type.name != "__elisascript_set")
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "concatenation operands and result must have one exact array, dictionary, or text type")) if not concat_kind or not same_type(left_type, right_type) or not same_type(instruction.result_type, left_type)
                    if instruction.opcode == Opcode.SetIndex and instruction.operand_count == 3 and operand_end <= fn.operand_pool.count:
                        collection_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                        index_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize() + 1])
                        value_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize() + 2])
                        element_type: Type = map_value_type(collection_type) if collection_type.kind == TypeKind.Map else array_element_type(collection_type)
                        map_key: Type = map_key_type(collection_type)
                        map_update_valid: bool = collection_type.kind == TypeKind.Map and same_type(index_type, map_key) and same_type(value_type, element_type)
                        array_update_valid: bool = collection_type.kind == TypeKind.Array and index_type.kind == TypeKind.Int and same_type(value_type, element_type)
