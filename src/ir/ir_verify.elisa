extend EsIr:
    private:
        def has_u32(values: darray[u32]&, wanted: u32) -> bool:
            return any value in values where value == wanted


        def has_u64(values: darray[u64]&, wanted: u64) -> bool:
            return any value in values where value == wanted


        def has_text(values: darray[sview]&, wanted: sview) -> bool:
            return any value in values where value == wanted


        def effect_granted(effects: darray[sview]&, required: sview) -> bool:
            for effect in effects |required|:
                true return if effect == required
                if sview_len(effect) > sview_len(required) and effect[0:sview_len(required)] == required and sview_at(effect, sview_len(required)) == 46:
                    return true
                if sview_len(required) > sview_len(effect) and required[0:sview_len(effect)] == effect and sview_at(required, sview_len(effect)) == 46:
                    return true
            return false


        def effect_reference_family(reference: sview) -> sview:
            for index in 0..<sview_len(reference) |reference|:
                reference[0:index] return if sview_at(reference, index) == 46
            return reference


        def handler_index(handlers: darray[Handler]&, name: sview) -> usize:
            for index in 0..<handlers.count |handlers, name|:
                index return if handlers[index].name == name
            return handlers.count


        def function_index(functions: darray[Function]&, name: sview) -> usize:
            for index in 0..<functions.count |functions, name|:
                index return if functions[index].name == name
            return functions.count


        def active_handler_covers(installed: darray[sview]&, handlers: darray[Handler]&, family: sview) -> bool:
            while stack_index > 0 |stack_index: usize = installed.count|:
                stack_index <- stack_index - 1
                index: usize = handler_index(handlers, installed[stack_index])
                if index < handlers.count and has_text(handlers[index].handles, family):
                    return true
            return false


        def validate_handler(handler: Handler&, issues: mutable darray[Issue]&) -> void can[Memory.Allocate, Abort.Panic]:
            if handler.continuation == ContinuationPolicy.MultiClone:
                for capture in handler.captures |handler, issues|:
                    issues.push(issue(IssueKind.UnsafeMultiShot, handler.name, 0, 0, 0, "multi-clone continuation captures a value that is not unrestricted")) if capture.class != CaptureClass.Unrestricted
            if handler.continuation == ContinuationPolicy.MultiReplay:
                for effect in handler.introduces_effects |handler, issues|:
                    issues.push(issue(IssueKind.UnsafeMultiShot, handler.name, 0, 0, 0, "multi-replay handler introduces an effect not proven replay-safe")) if not has_text(handler.replay_safe_effects, effect)


        def issue(kind: IssueKind, function: sview, block: u32, value: u32, trace: u64, message: sview) -> Issue:
            return Issue{kind: kind, function: function, block: block, value: value, trace: trace, message: message}


        def definition_block(values: darray[u32]&, blocks: darray[u32]&, value: u32) -> u32:
            for index in 0..<values.count |values, blocks, value|:
                blocks[index] return if values[index] == value
            return 0


        def definition_type(values: darray[u32]&, types: darray[Type]&, value: u32) -> Type:
            for index in 0..<values.count |values, types, value|:
                types[index] return if values[index] == value
            return Type{kind: TypeKind.Void}


        def same_type(left: Type&, right: Type&) -> bool:
            return left.kind == right.kind and left.name == right.name and left.bits == right.bits and left.signed == right.signed and left.element_kind == right.element_kind and left.element_name == right.element_name and left.element_bits == right.element_bits and left.element_signed == right.element_signed


        def array_element_type(array_type: Type&) -> Type:
            return Type{kind: array_type.element_kind, name: array_type.element_name, bits: array_type.element_bits, signed: array_type.element_signed}


        def numeric_type(value: Type&) -> bool:
            return value.kind == TypeKind.Int or value.kind == TypeKind.Float


        def equality_type(value: Type&) -> bool:
            return value.kind in {TypeKind.Bool, TypeKind.Int, TypeKind.Float, TypeKind.Char, TypeKind.Text}


        def verify_edge(fn: Function&, source: Block&, target_id: u32, argument_start: u32, argument_count: u16, defined: darray[u32]&, definition_blocks: darray[u32]&, definition_types: darray[Type]&, issues: mutable darray[Issue]&) -> void can[Memory.Allocate, Abort.Panic]:
            for target in fn.blocks |fn, source, target_id, argument_start, argument_count, defined, definition_blocks, definition_types, issues|:
                if target.id == target_id:
                    issues.push(issue(IssueKind.EdgeArgumentArity, fn.name, source.id, 0, 0, "edge argument count does not match target block parameters")) if argument_count != target.parameter_count
                    argument_end: usize = argument_start.usize() + argument_count.usize()
                    if argument_end > fn.edge_arg_pool.count:
                        issues.push(issue(IssueKind.EdgeArgumentArity, fn.name, source.id, 0, 0, "edge argument slice is outside the function pool"))
                        return
                    paired: usize = argument_count.usize() if argument_count < target.parameter_count else target.parameter_count.usize()
                    for offset in 0..<paired |fn, source, target, argument_start, defined, definition_blocks, definition_types, issues|:
                        value: u32 = fn.edge_arg_pool[argument_start.usize() + offset]
                        if value == 0 or not has_u32(defined, value):
                            issues.push(issue(IssueKind.UndefinedValue, fn.name, source.id, value, 0, "edge passes an undefined SSA value"))
                        else:
                            def_block: u32 = definition_block(defined, definition_blocks, value)
                            issues.push(issue(IssueKind.NonDominatingValue, fn.name, source.id, value, 0, "edge argument definition does not dominate its source block")) if not block_dominates(fn, def_block, source.id)
                            actual: Type = definition_type(defined, definition_types, value)
                            parameter_index: usize = target.parameter_start.usize() + offset
                            issues.push(issue(IssueKind.EdgeArgumentType, fn.name, source.id, value, 0, "edge argument type does not match target block parameter")) if parameter_index >= fn.block_parameter_pool.count or not same_type(actual, fn.block_parameter_pool[parameter_index].type)
                    return


        # A definition dominates USE when removing its block makes USE unreachable from
        # entry. Same-block ordering is checked separately by the ordinary defined set.
        def block_dominates(fn: Function&, definition: u32, use: u32) -> bool can[Memory.Allocate, Abort.Panic]:
            true return if definition == use or definition == fn.entry
            frontier: mutable darray[u32] = [fn.entry]
            visited: mutable darray[u32] = []
            while frontier.count > 0 |frontier, visited, fn, definition, use|:
                current: u32 = frontier.pop()
                continue if current == definition or has_u32(visited, current)
                false return if current == use
                visited.push(current)
                for block in fn.blocks |frontier, current, visited, definition|:
                    if block.id == current:
                        frontier.push(block.terminator.target0) if block.terminator.target_count >= 1 and block.terminator.target0 != definition and not has_u32(visited, block.terminator.target0)
                        frontier.push(block.terminator.target1) if block.terminator.target_count >= 2 and block.terminator.target1 != definition and not has_u32(visited, block.terminator.target1)
            return true


        def verify_terminator(fn: Function&, block: Block&, defined: darray[u32]&, definition_blocks: darray[u32]&, definition_types: darray[Type]&, block_ids: darray[u32]&, issues: mutable darray[Issue]&) -> void can[Memory.Allocate, Abort.Panic]:
            issues.push(issue(IssueKind.UndefinedValue, fn.name, block.id, block.terminator.operand, 0, "terminator uses an undefined SSA value")) if block.terminator.operand_count == 1 and (block.terminator.operand == 0 or not has_u32(defined, block.terminator.operand))
            if block.terminator.operand_count == 1 and has_u32(defined, block.terminator.operand):
                def_block: u32 = definition_block(defined, definition_blocks, block.terminator.operand)
                issues.push(issue(IssueKind.NonDominatingValue, fn.name, block.id, block.terminator.operand, 0, "terminator value definition does not dominate this block")) if not block_dominates(fn, def_block, block.id)
            issues.push(issue(IssueKind.UnknownTarget, fn.name, block.id, block.terminator.target0, 0, "terminator targets an unknown block")) if block.terminator.target_count >= 1 and not has_u32(block_ids, block.terminator.target0)
            issues.push(issue(IssueKind.UnknownTarget, fn.name, block.id, block.terminator.target1, 0, "terminator targets an unknown block")) if block.terminator.target_count >= 2 and not has_u32(block_ids, block.terminator.target1)
            verify_edge(fn, block, block.terminator.target0, block.terminator.edge0_arg_start, block.terminator.edge0_arg_count, defined, definition_blocks, definition_types, issues) if block.terminator.target_count >= 1 and has_u32(block_ids, block.terminator.target0)
            verify_edge(fn, block, block.terminator.target1, block.terminator.edge1_arg_start, block.terminator.edge1_arg_count, defined, definition_blocks, definition_types, issues) if block.terminator.target_count >= 2 and has_u32(block_ids, block.terminator.target1)
            match block.terminator.kind:
                TerminatorKind.Return:
                    expected: usize = 0 if fn.return_type.kind == TypeKind.Void else 1
                    issues.push(issue(IssueKind.InvalidTerminator, fn.name, block.id, 0, 0, "return has the wrong number of values")) if block.terminator.operand_count.usize() != expected or block.terminator.target_count != 0
                    if expected == 1 and block.terminator.operand_count == 1 and has_u32(defined, block.terminator.operand):
                        actual: Type = definition_type(defined, definition_types, block.terminator.operand)
                        issues.push(issue(IssueKind.InvalidTerminator, fn.name, block.id, block.terminator.operand, 0, "return value type does not match the function return type")) if not same_type(actual, fn.return_type)
                TerminatorKind.Jump:
                    issues.push(issue(IssueKind.InvalidTerminator, fn.name, block.id, 0, 0, "jump requires exactly one target")) if block.terminator.target_count != 1 or block.terminator.operand_count != 0
                TerminatorKind.Branch:
                    issues.push(issue(IssueKind.InvalidTerminator, fn.name, block.id, 0, 0, "branch requires a condition and two targets")) if block.terminator.operand_count != 1 or block.terminator.target_count != 2
                    if block.terminator.operand_count == 1 and has_u32(defined, block.terminator.operand):
                        condition_type: Type = definition_type(defined, definition_types, block.terminator.operand)
                        issues.push(issue(IssueKind.InvalidTerminator, fn.name, block.id, block.terminator.operand, 0, "branch condition must be boolean")) if condition_type.kind != TypeKind.Bool
                TerminatorKind.Unreachable:
                    issues.push(issue(IssueKind.InvalidTerminator, fn.name, block.id, 0, 0, "unreachable cannot carry operands or targets")) if block.terminator.operand_count != 0 or block.terminator.target_count != 0


        def verify_function(fn: Function&, module: Module&, issues: mutable darray[Issue]&) -> void can[Memory.Allocate, Abort.Panic]:
            block_ids: mutable darray[u32] = []
            for block in fn.blocks |block_ids, issues|:
                issues.push(issue(IssueKind.DuplicateBlock, fn.name, block.id, 0, 0, "block id is defined more than once")) if has_u32(block_ids, block.id)
                block_ids.push(block.id)
            issues.push(issue(IssueKind.MissingEntry, fn.name, fn.entry, 0, 0, "entry block does not exist")) if not has_u32(block_ids, fn.entry)

            defined: mutable darray[u32] = []
            definition_blocks: mutable darray[u32] = []
            definition_types: mutable darray[Type] = []
            traces: mutable darray[u64] = []
            handler_stack: mutable darray[sview] = []
            for parameter in fn.parameters |defined, definition_blocks, definition_types, issues|:
                issues.push(issue(IssueKind.DuplicateValue, fn.name, fn.entry, parameter.value, 0, "parameter SSA value is duplicated or zero")) if parameter.value == 0 or has_u32(defined, parameter.value)
                defined.push(parameter.value) if parameter.value != 0 and not has_u32(defined, parameter.value)
                definition_blocks.push(fn.entry) if parameter.value != 0 and definition_blocks.count < defined.count
                definition_types.push(parameter.type) if parameter.value != 0 and definition_types.count < defined.count
            for block in fn.blocks |defined, definition_blocks, definition_types, traces, block_ids, issues|:
                parameter_end: usize = block.parameter_start.usize() + block.parameter_count.usize()
                issues.push(issue(IssueKind.EdgeArgumentArity, fn.name, block.id, 0, 0, "block parameter slice is outside the function pool")) if parameter_end > fn.block_parameter_pool.count
                safe_parameter_end: usize = parameter_end if parameter_end <= fn.block_parameter_pool.count else fn.block_parameter_pool.count
                for parameter_index in block.parameter_start.usize()..<safe_parameter_end |defined, definition_blocks, definition_types, issues, block, fn|:
                    parameter: Parameter = fn.block_parameter_pool[parameter_index]
                    issues.push(issue(IssueKind.DuplicateValue, fn.name, block.id, parameter.value, 0, "block parameter SSA value is duplicated or zero")) if parameter.value == 0 or has_u32(defined, parameter.value)
                    defined.push(parameter.value) if parameter.value != 0 and not has_u32(defined, parameter.value)
                    definition_blocks.push(block.id) if parameter.value != 0 and definition_blocks.count < defined.count
                    definition_types.push(parameter.type) if parameter.value != 0 and definition_types.count < defined.count
                instruction_end: usize = block.instruction_start.usize() + block.instruction_count.usize()
                issues.push(issue(IssueKind.UndefinedValue, fn.name, block.id, 0, 0, "block instruction slice is outside the function pool")) if instruction_end > fn.instruction_pool.count
                safe_instruction_end: usize = instruction_end if instruction_end <= fn.instruction_pool.count else fn.instruction_pool.count
                for instruction_index in block.instruction_start.usize()..<safe_instruction_end |defined, traces, issues, block, fn|:
                    instruction: Instruction = fn.instruction_pool[instruction_index]
                    operand_end: usize = instruction.operand_start.usize() + instruction.operand_count.usize()
                    issues.push(issue(IssueKind.UndefinedValue, fn.name, block.id, 0, instruction.trace.id, "instruction operand slice is outside the function pool")) if operand_end > fn.operand_pool.count
                    safe_end: usize = operand_end if operand_end <= fn.operand_pool.count else fn.operand_pool.count
                    for operand_index in instruction.operand_start.usize()..<safe_end |defined, issues, block, instruction, fn|:
                        operand: u32 = fn.operand_pool[operand_index]
                        issues.push(issue(IssueKind.UndefinedValue, fn.name, block.id, operand, instruction.trace.id, "instruction uses an undefined SSA value")) if operand == 0 or not has_u32(defined, operand)
                        if operand != 0 and has_u32(defined, operand):
                            def_block: u32 = definition_block(defined, definition_blocks, operand)
                            issues.push(issue(IssueKind.NonDominatingValue, fn.name, block.id, operand, instruction.trace.id, "SSA value definition does not dominate this use")) if not block_dominates(fn, def_block, block.id)
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "constant must not have operands")) if instruction.opcode == Opcode.Constant and instruction.operand_count != 0
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "copy must have exactly one operand")) if instruction.opcode == Opcode.Copy and instruction.operand_count != 1
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "binary instruction must have exactly two operands")) if instruction.opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder, Opcode.Equal, Opcode.NotEqual, Opcode.Less, Opcode.LessEqual, Opcode.Greater, Opcode.GreaterEqual, Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight} and instruction.operand_count != 2
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "unary instruction must have exactly one operand")) if instruction.opcode in {Opcode.Negate, Opcode.Not, Opcode.BitNot} and instruction.operand_count != 1
                    if instruction.opcode == Opcode.Copy and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        operand: u32 = fn.operand_pool[instruction.operand_start.usize()]
                        if has_u32(defined, operand):
                            operand_type: Type = definition_type(defined, definition_types, operand)
                            issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "copy result type must match its operand")) if not same_type(instruction.result_type, operand_type)
                    if instruction.opcode in {Opcode.Negate, Opcode.Not, Opcode.BitNot} and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        operand: u32 = fn.operand_pool[instruction.operand_start.usize()]
                        if has_u32(defined, operand):
                            operand_type: Type = definition_type(defined, definition_types, operand)
                            valid_negate: bool = instruction.opcode == Opcode.Negate and numeric_type(operand_type) and same_type(instruction.result_type, operand_type)
                            valid_not: bool = instruction.opcode == Opcode.Not and operand_type.kind == TypeKind.Bool and instruction.result_type.kind == TypeKind.Bool
                            valid_bit_not: bool = instruction.opcode == Opcode.BitNot and operand_type.kind == TypeKind.Int and same_type(instruction.result_type, operand_type)
                            issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "unary operand and result types do not match the operation")) if not valid_negate and not valid_not and not valid_bit_not
                    if instruction.opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder, Opcode.Equal, Opcode.NotEqual, Opcode.Less, Opcode.LessEqual, Opcode.Greater, Opcode.GreaterEqual, Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight} and instruction.operand_count == 2 and operand_end <= fn.operand_pool.count:
                        left_value: u32 = fn.operand_pool[instruction.operand_start.usize()]
                        right_value: u32 = fn.operand_pool[instruction.operand_start.usize() + 1]
                        if has_u32(defined, left_value) and has_u32(defined, right_value):
                            left_type: Type = definition_type(defined, definition_types, left_value)
                            right_type: Type = definition_type(defined, definition_types, right_value)
                            operands_match: bool = same_type(left_type, right_type)
                            arithmetic: bool = instruction.opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder}
                            equality: bool = instruction.opcode == Opcode.Equal or instruction.opcode == Opcode.NotEqual
                            ordering: bool = instruction.opcode in {Opcode.Less, Opcode.LessEqual, Opcode.Greater, Opcode.GreaterEqual}
                            bitwise: bool = instruction.opcode in {Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight}
                            arithmetic_valid: bool = arithmetic and operands_match and numeric_type(left_type) and same_type(instruction.result_type, left_type) and (instruction.opcode != Opcode.Remainder or left_type.kind == TypeKind.Int)
                            equality_valid: bool = equality and operands_match and equality_type(left_type) and instruction.result_type.kind == TypeKind.Bool
                            ordering_valid: bool = ordering and operands_match and numeric_type(left_type) and instruction.result_type.kind == TypeKind.Bool
                            bitwise_valid: bool = bitwise and operands_match and left_type.kind == TypeKind.Int and same_type(instruction.result_type, left_type)
                            issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "binary operand and result types do not match the operation")) if not arithmetic_valid and not equality_valid and not ordering_valid and not bitwise_valid
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "array construction must produce an array type")) if instruction.opcode == Opcode.MakeArray and instruction.result_type.kind != TypeKind.Array
                    if instruction.opcode == Opcode.MakeArray and instruction.result_type.kind == TypeKind.Array:
                        element_type: Type = array_element_type(instruction.result_type)
                        for operand_index in instruction.operand_start.usize()..<safe_end |fn, defined, definition_types, issues, instruction, block, element_type|:
                            operand: u32 = fn.operand_pool[operand_index]
                            if has_u32(defined, operand):
                                actual: Type = definition_type(defined, definition_types, operand)
                                issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "array element type does not match the array element type")) if not same_type(actual, element_type)
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "index requires a collection and integer index")) if instruction.opcode == Opcode.Index and instruction.operand_count != 2
                    if instruction.opcode == Opcode.Index and instruction.operand_count == 2 and operand_end <= fn.operand_pool.count:
                        collection_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                        index_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize() + 1])
                        element_type: Type = Type{kind: TypeKind.Char, bits: 8} if collection_type.kind == TypeKind.Text else array_element_type(collection_type)
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "index first operand must be an array or text")) if collection_type.kind not in {TypeKind.Array, TypeKind.Text}
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "collection index must be an integer")) if index_type.kind != TypeKind.Int
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "index result type must match the collection element type")) if collection_type.kind in {TypeKind.Array, TypeKind.Text} and not same_type(instruction.result_type, element_type)
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "length requires exactly one collection operand")) if instruction.opcode == Opcode.Length and instruction.operand_count != 1
                    if instruction.opcode == Opcode.Length and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        collection_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "length operand must be an array or text")) if collection_type.kind not in {TypeKind.Array, TypeKind.Text}
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "length result must be an integer")) if instruction.result_type.kind != TypeKind.Int
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "slice requires a collection and two bounds")) if instruction.opcode == Opcode.Slice and instruction.operand_count != 3
                    if instruction.opcode == Opcode.Slice and instruction.operand_count == 3 and operand_end <= fn.operand_pool.count:
                        collection_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                        low_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize() + 1])
                        high_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize() + 2])
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "slice first operand must be an array or text")) if collection_type.kind not in {TypeKind.Array, TypeKind.Text}
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "slice bounds must be integers")) if low_type.kind != TypeKind.Int or high_type.kind != TypeKind.Int
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "slice result must preserve its collection type")) if not same_type(instruction.result_type, collection_type)
                    if instruction.opcode == Opcode.Call and operand_end <= fn.operand_pool.count:
                        callee_index: usize = function_index(module.functions, instruction.symbol)
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "call names an unknown function")) if callee_index == module.functions.count
                        if callee_index < module.functions.count:
                            callee: Function = module.functions[callee_index]
                            issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "call argument count does not match the function signature")) if instruction.operand_count != callee.parameters.count
                            paired: usize = instruction.operand_count.usize() if instruction.operand_count < callee.parameters.count else callee.parameters.count
                            for offset in 0..<paired |fn, instruction, defined, definition_types, issues, callee|:
                                operand: u32 = fn.operand_pool[instruction.operand_start.usize() + offset]
                                if has_u32(defined, operand):
                                    actual: Type = definition_type(defined, definition_types, operand)
                                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "call argument type does not match the function parameter")) if not same_type(actual, callee.parameters[offset].type)
                            issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "call result type does not match the function return type")) if not same_type(instruction.result_type, callee.return_type)
                            for required_effect in callee.effects |fn, block, instruction, issues, handler_stack, module|:
                                covered: bool = active_handler_covers(handler_stack, module.handlers, effect_reference_family(required_effect))
                                issues.push(issue(IssueKind.MissingEffect, fn.name, block.id, instruction.result, instruction.trace.id, "callee effect is neither dynamically handled nor present in the caller effect row")) if not covered and not effect_granted(fn.effects, required_effect)
                            for required_error in callee.errors |fn, block, instruction, issues|:
                                issues.push(issue(IssueKind.MissingError, fn.name, block.id, instruction.result, instruction.trace.id, "callee error set is absent from the caller error row")) if not has_text(fn.errors, required_error)
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "handler stack instruction must not have operands")) if instruction.opcode in {Opcode.HandlerPush, Opcode.HandlerPop} and instruction.operand_count != 0
                    if instruction.result != 0:
                        issues.push(issue(IssueKind.DuplicateValue, fn.name, block.id, instruction.result, instruction.trace.id, "instruction result violates SSA uniqueness")) if has_u32(defined, instruction.result)
                        defined.push(instruction.result) if not has_u32(defined, instruction.result)
                        definition_blocks.push(block.id) if definition_blocks.count < defined.count
                        definition_types.push(instruction.result_type) if definition_types.count < defined.count
                    if instruction.opcode == Opcode.Perform:
                        issues.push(issue(IssueKind.InvalidPerform, fn.name, block.id, instruction.result, instruction.trace.id, "perform must name an effect family and operation")) if instruction.effect_family == "" or instruction.effect_operation == ""
                        covered: bool = active_handler_covers(handler_stack, module.handlers, instruction.effect_family)
                        issues.push(issue(IssueKind.MissingEffect, fn.name, block.id, instruction.result, instruction.trace.id, "performed effect is neither dynamically handled nor present in the function effect row")) if instruction.effect_family != "" and not covered and not effect_granted(fn.effects, instruction.effect_family)
                    if instruction.opcode == Opcode.HandlerPush:
                        pushed_index: usize = handler_index(module.handlers, instruction.symbol)
                        issues.push(issue(IssueKind.UnknownHandler, fn.name, block.id, instruction.result, instruction.trace.id, "dynamic handler is not declared in the IR module")) if pushed_index == module.handlers.count
                        if pushed_index < module.handlers.count:
                            for introduced in module.handlers[pushed_index].introduces_effects |fn, block, instruction, issues|:
                                issues.push(issue(IssueKind.HandlerContract, fn.name, block.id, 0, instruction.trace.id, "handler-introduced effect is absent from the function effect row")) if not effect_granted(fn.effects, introduced)
                            for handler_error in module.handlers[pushed_index].errors |fn, block, instruction, issues|:
                                issues.push(issue(IssueKind.HandlerContract, fn.name, block.id, 0, instruction.trace.id, "handler error set is absent from the function error row")) if not has_text(fn.errors, handler_error)
                        handler_stack.push(instruction.symbol)
                    if instruction.opcode == Opcode.HandlerPop:
                        if handler_stack.count == 0 or handler_stack[handler_stack.count - 1] != instruction.symbol:
                            issues.push(issue(IssueKind.UnbalancedHandler, fn.name, block.id, instruction.result, instruction.trace.id, "dynamic handler pop does not match the active lexical handler"))
                        else:
                            _ = handler_stack.pop()
                    if instruction.opcode == Opcode.Resume:
                        index: usize = handler_index(module.handlers, instruction.symbol)
                        issues.push(issue(IssueKind.UnknownHandler, fn.name, block.id, instruction.result, instruction.trace.id, "resume names an unknown handler")) if index == module.handlers.count
                        issues.push(issue(IssueKind.InvalidResume, fn.name, block.id, instruction.result, instruction.trace.id, "terminal handlers cannot resume continuations")) if index < module.handlers.count and module.handlers[index].continuation == ContinuationPolicy.Terminal
                    if instruction.opcode == Opcode.Observe and instruction.result != 0:
                        issues.push(issue(IssueKind.InvalidObserve, fn.name, block.id, instruction.result, instruction.trace.id, "observe records values but cannot define one"))
                    issues.push(issue(IssueKind.InvalidObserve, fn.name, block.id, instruction.result, instruction.trace.id, "observe requires exactly one operand")) if instruction.opcode == Opcode.Observe and instruction.operand_count != 1
                    if instruction.opcode == Opcode.Perform or instruction.opcode == Opcode.Observe:
                        issues.push(issue(IssueKind.MissingTraceSite, fn.name, block.id, instruction.result, 0, "observable instruction requires a stable trace site")) if instruction.trace.id == 0
                        issues.push(issue(IssueKind.DuplicateTraceSite, fn.name, block.id, instruction.result, instruction.trace.id, "trace site id is not unique within the function")) if instruction.trace.id != 0 and has_u64(traces, instruction.trace.id)
                        traces.push(instruction.trace.id) if instruction.trace.id != 0 and not has_u64(traces, instruction.trace.id)
                verify_terminator(fn, block, defined, definition_blocks, definition_types, block_ids, issues)
            issues.push(issue(IssueKind.UnbalancedHandler, fn.name, fn.entry, 0, 0, "function exits with a dynamic handler still installed")) if handler_stack.count != 0


    public:
        # Verification is deterministic and target-independent. Backends must refuse a
        # module with issues instead of attempting recovery differently.
        def verify(module: Module&) -> darray[Issue] can[Memory.Allocate, Abort.Panic]:
            issues: mutable darray[Issue] = []
            for index in 0..<module.handlers.count |module, issues|:
                validate_handler(module.handlers[index], issues)
                for earlier in 0..<index |module, issues, index|:
                    issues.push(issue(IssueKind.DuplicateHandler, "", 0, 0, 0, "handler name is declared more than once")) if module.handlers[index].name == module.handlers[earlier].name
            for fn in module.functions |issues, module|:
                verify_function(fn, module, issues)
            return issues
