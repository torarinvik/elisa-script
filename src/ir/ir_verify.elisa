                        issues.push(issue(IssueKind.MissingEffect, fn.name, block.id, instruction.result, instruction.trace.id, "process result capture requires Process.Run in the function effect row")) if not effect_granted(fn.effects, "Process.Run")
                        issues.push(issue(IssueKind.MissingError, fn.name, block.id, instruction.result, instruction.trace.id, "process result capture requires ProcessError in the function error row")) if not has_text(fn.errors, "ProcessError")
                    process_result_accessor: bool = instruction.opcode == Opcode.ProcessResultExitStatus or instruction.opcode == Opcode.ProcessResultStdout or instruction.opcode == Opcode.ProcessResultStderr
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "process result accessor requires one ProcessCapture operand")) if process_result_accessor and instruction.operand_count != 1
                    if process_result_accessor and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        capture_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                        valid_capture: bool = capture_type.kind == TypeKind.Named and capture_type.name == "ProcessCapture"
                        valid_exit: bool = instruction.opcode == Opcode.ProcessResultExitStatus and instruction.result_type.kind == TypeKind.Int and instruction.result_type.bits == 64 and instruction.result_type.signed
                        valid_output: bool = (instruction.opcode == Opcode.ProcessResultStdout or instruction.opcode == Opcode.ProcessResultStderr) and instruction.result_type.kind == TypeKind.Text
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "process result accessor has an invalid operand or result type")) if not valid_capture or not valid_exit and not valid_output
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "environment read requires one name operand")) if instruction.opcode == Opcode.GetEnvironment and instruction.operand_count != 1
                    if instruction.opcode == Opcode.GetEnvironment and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        name_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "environment read requires sview name and result")) if name_type.kind != TypeKind.Text or instruction.result_type.kind != TypeKind.Text
                        issues.push(issue(IssueKind.MissingEffect, fn.name, block.id, instruction.result, instruction.trace.id, "environment read requires Environment.Read in the function effect row")) if not effect_granted(fn.effects, "Environment.Read")
                        issues.push(issue(IssueKind.MissingError, fn.name, block.id, instruction.result, instruction.trace.id, "environment read requires EnvironmentError in the function error row")) if not has_text(fn.errors, "EnvironmentError")
                    expected_environment_operands: u32 = 2 if instruction.opcode == Opcode.SetEnvironment else 1
                    environment_mutation: bool = instruction.opcode == Opcode.SetEnvironment or instruction.opcode == Opcode.UnsetEnvironment
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "environment mutation has invalid operand count")) if environment_mutation and instruction.operand_count != expected_environment_operands
                    if environment_mutation and instruction.operand_count == expected_environment_operands and operand_end <= fn.operand_pool.count:
                        name_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                        valid_operands: mutable bool = name_type.kind == TypeKind.Text
                        if instruction.opcode == Opcode.SetEnvironment:
                            value_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize() + 1])
                            valid_operands <- valid_operands and value_type.kind == TypeKind.Text
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "environment mutation requires sview operands and boolean result")) if not valid_operands or instruction.result_type.kind != TypeKind.Bool
                        issues.push(issue(IssueKind.MissingEffect, fn.name, block.id, instruction.result, instruction.trace.id, "environment mutation requires Environment.Write in the function effect row")) if not effect_granted(fn.effects, "Environment.Write")
                        issues.push(issue(IssueKind.MissingError, fn.name, block.id, instruction.result, instruction.trace.id, "environment mutation requires EnvironmentError in the function error row")) if not has_text(fn.errors, "EnvironmentError")
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "current directory takes no operands")) if instruction.opcode == Opcode.CurrentDirectory and instruction.operand_count != 0
                    if instruction.opcode == Opcode.CurrentDirectory and instruction.operand_count == 0:
                        valid_result: bool = instruction.result_type.kind == TypeKind.Named and instruction.result_type.name == "Path"
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "current directory requires nominal Path result")) if not valid_result
                        issues.push(issue(IssueKind.MissingEffect, fn.name, block.id, instruction.result, instruction.trace.id, "current directory requires Directory.Read in the function effect row")) if not effect_granted(fn.effects, "Directory.Read")
                        issues.push(issue(IssueKind.MissingError, fn.name, block.id, instruction.result, instruction.trace.id, "current directory requires DirectoryError in the function error row")) if not has_text(fn.errors, "DirectoryError")
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "directory listing requires one path operand")) if instruction.opcode == Opcode.ListDirectory and instruction.operand_count != 1
                    if instruction.opcode == Opcode.ListDirectory and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        path_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                        valid_path: bool = path_type.kind == TypeKind.Named and path_type.name == "Path"
                        valid_result: bool = instruction.result_type.kind == TypeKind.Array and instruction.result_type.element_kind == TypeKind.Text
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "directory listing requires nominal Path operand and darray[sview] result")) if not valid_path or not valid_result
                        issues.push(issue(IssueKind.MissingEffect, fn.name, block.id, instruction.result, instruction.trace.id, "directory listing requires Directory.Read in the function effect row")) if not effect_granted(fn.effects, "Directory.Read")
                        issues.push(issue(IssueKind.MissingError, fn.name, block.id, instruction.result, instruction.trace.id, "directory listing requires DirectoryError in the function error row")) if not has_text(fn.errors, "DirectoryError")
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "directory predicate requires one path operand")) if instruction.opcode == Opcode.IsDirectory and instruction.operand_count != 1
                    if instruction.opcode == Opcode.IsDirectory and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        path_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                        valid_path: bool = path_type.kind == TypeKind.Named and path_type.name == "Path"
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "directory predicate requires nominal Path operand and boolean result")) if not valid_path or instruction.result_type.kind != TypeKind.Bool
                        issues.push(issue(IssueKind.MissingEffect, fn.name, block.id, instruction.result, instruction.trace.id, "directory predicate requires Directory.Read in the function effect row")) if not effect_granted(fn.effects, "Directory.Read")
                        issues.push(issue(IssueKind.MissingError, fn.name, block.id, instruction.result, instruction.trace.id, "directory predicate requires DirectoryError in the function error row")) if not has_text(fn.errors, "DirectoryError")
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "glob expansion requires one pattern operand")) if instruction.opcode == Opcode.ExpandGlob and instruction.operand_count != 1
                    if instruction.opcode == Opcode.ExpandGlob and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        pattern_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                        valid_pattern: bool = pattern_type.kind == TypeKind.Named and pattern_type.name == "Glob"
                        valid_result: bool = instruction.result_type.kind == TypeKind.Array and instruction.result_type.element_kind == TypeKind.Text
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "glob expansion requires nominal Glob operand and darray[sview] result")) if not valid_pattern or not valid_result
                        issues.push(issue(IssueKind.MissingEffect, fn.name, block.id, instruction.result, instruction.trace.id, "glob expansion requires Directory.Read in the function effect row")) if not effect_granted(fn.effects, "Directory.Read")
                        issues.push(issue(IssueKind.MissingError, fn.name, block.id, instruction.result, instruction.trace.id, "glob expansion requires DirectoryError in the function error row")) if not has_text(fn.errors, "DirectoryError")
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "stdin read takes no operands")) if instruction.opcode == Opcode.ReadStdin and instruction.operand_count != 0
                    if instruction.opcode == Opcode.ReadStdin and instruction.operand_count == 0:
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "stdin read requires an sview result")) if instruction.result_type.kind != TypeKind.Text
                        issues.push(issue(IssueKind.MissingEffect, fn.name, block.id, instruction.result, instruction.trace.id, "stdin read requires Console.Read in the function effect row")) if not effect_granted(fn.effects, "Console.Read")
                        issues.push(issue(IssueKind.MissingError, fn.name, block.id, instruction.result, instruction.trace.id, "stdin read requires ConsoleError in the function error row")) if not has_text(fn.errors, "ConsoleError")
                    standard_stream_write: bool = instruction.opcode == Opcode.WriteStdout or instruction.opcode == Opcode.WriteStderr
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "standard-stream write requires one operand")) if standard_stream_write and instruction.operand_count != 1
                    if standard_stream_write and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        text_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                        valid_result: bool = instruction.result_type.kind == TypeKind.Int and instruction.result_type.bits == 64 and not instruction.result_type.signed
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "standard-stream write requires an sview operand and usize result")) if text_type.kind != TypeKind.Text or not valid_result
                        issues.push(issue(IssueKind.MissingEffect, fn.name, block.id, instruction.result, instruction.trace.id, "standard-stream write requires Console.Write in the function effect row")) if not effect_granted(fn.effects, "Console.Write")
                        issues.push(issue(IssueKind.MissingError, fn.name, block.id, instruction.result, instruction.trace.id, "standard-stream write requires ConsoleError in the function error row")) if not has_text(fn.errors, "ConsoleError")
                    directory_mutation: bool = instruction.opcode == Opcode.CreateDirectory or instruction.opcode == Opcode.RemoveDirectory or instruction.opcode == Opcode.ChangeDirectory
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "directory mutation requires one path operand")) if directory_mutation and instruction.operand_count != 1
                    if directory_mutation and instruction.operand_count == 1 and operand_end <= fn.operand_pool.count:
                        path_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                        valid_path: bool = path_type.kind == TypeKind.Named and path_type.name == "Path"
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "directory mutation requires nominal Path operand and boolean result")) if not valid_path or instruction.result_type.kind != TypeKind.Bool
                        issues.push(issue(IssueKind.MissingEffect, fn.name, block.id, instruction.result, instruction.trace.id, "directory mutation requires Directory.Write in the function effect row")) if not effect_granted(fn.effects, "Directory.Write")
                        issues.push(issue(IssueKind.MissingError, fn.name, block.id, instruction.result, instruction.trace.id, "directory mutation requires DirectoryError in the function error row")) if not has_text(fn.errors, "DirectoryError")
                    if instruction.opcode == Opcode.Call and operand_end <= fn.operand_pool.count:
                        callee_index: usize = function_index(module.functions, instruction.symbol)
                        issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "call names an unknown function")) if callee_index == module.functions.count
                        if callee_index < module.functions.count:
                            callee: Function = module.functions[callee_index]
                            issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "call argument count does not match the function signature")) if instruction.operand_count != callee.parameters.count
                            paired: usize = instruction.operand_count.usize() if instruction.operand_count < callee.parameters.count else callee.parameters.count
                            for offset in 0..<paired |fn, instruction, defined, definition_types, issues, callee|:
                                operand: u32 = fn.operand_pool[instruction.operand_start.usize() + offset]
                                if has_u32(defined, operand):
                                    actual: Type = definition_type(defined, definition_types, operand)
                                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "call argument type does not match the function parameter")) if not same_type(actual, callee.parameters[offset].type)
                            issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "call result type does not match the function return type")) if not same_type(instruction.result_type, callee.return_type)
                            for required_effect in callee.effects |fn, block, instruction, issues, handler_stack, module|:
                                covered: bool = active_handler_covers(handler_stack, module.handlers, effect_reference_family(required_effect))
                                issues.push(issue(IssueKind.MissingEffect, fn.name, block.id, instruction.result, instruction.trace.id, "callee effect is neither dynamically handled nor present in the caller effect row")) if not covered and not effect_granted(fn.effects, required_effect)
                            for required_error in callee.errors |fn, block, instruction, issues|:
                                issues.push(issue(IssueKind.MissingError, fn.name, block.id, instruction.result, instruction.trace.id, "callee error set is absent from the caller error row")) if not has_text(fn.errors, required_error)
                    issues.push(issue(IssueKind.InvalidInstruction, fn.name, block.id, instruction.result, instruction.trace.id, "handler stack instruction must not have operands")) if instruction.opcode in {Opcode.HandlerPush, Opcode.HandlerPop} and instruction.operand_count != 0
                    if instruction.result != 0:
                        issues.push(issue(IssueKind.DuplicateValue, fn.name, block.id, instruction.result, instruction.trace.id, "instruction result violates SSA uniqueness")) if has_u32(defined, instruction.result)
                        defined.push(instruction.result) if not has_u32(defined, instruction.result)
                        definition_blocks.push(block.id) if definition_blocks.count < defined.count
                        definition_types.push(instruction.result_type) if definition_types.count < defined.count
                    if instruction.opcode == Opcode.Perform:
                        issues.push(issue(IssueKind.InvalidPerform, fn.name, block.id, instruction.result, instruction.trace.id, "perform must name an effect family and operation")) if instruction.effect_family == "" or instruction.effect_operation == ""
                        covered: bool = active_handler_covers(handler_stack, module.handlers, instruction.effect_family)
                        issues.push(issue(IssueKind.MissingEffect, fn.name, block.id, instruction.result, instruction.trace.id, "performed effect is neither dynamically handled nor present in the function effect row")) if instruction.effect_family != "" and not covered and not effect_granted(fn.effects, instruction.effect_family)
                        selected_handler: mutable bool = false
                        while installed_index > 0 and not selected_handler |installed_index: usize = handler_stack.count|:
                            installed_index <- installed_index - 1
                            installed_handler_index: usize = handler_index(module.handlers, handler_stack[installed_index])
                            if installed_handler_index < module.handlers.count:
                                installed_handler: Handler = module.handlers[installed_handler_index]
                                if has_text(installed_handler.handles, instruction.effect_family):
                                    selected_handler <- true
                                    matched_clause: mutable bool = false
                                    for clause in installed_handler.clauses |fn, instruction, operand_end, defined, definition_types, module, issues, block, matched_clause|:
                                        if not matched_clause and clause.effect_family == instruction.effect_family and clause.effect_operation == instruction.effect_operation:
                                            matched_clause <- true
                                            callback_index: usize = function_index(module.functions, clause.function)
                                            if callback_index < module.functions.count:
                                                callback: Function = module.functions[callback_index]
                                                issues.push(issue(IssueKind.HandlerContract, fn.name, block.id, instruction.result, instruction.trace.id, "handler callback argument count does not match the performed payload")) if instruction.operand_count != callback.parameters.count
                                                paired: mutable usize = 0
                                                paired <- (instruction.operand_count.usize() if instruction.operand_count < callback.parameters.count else callback.parameters.count) if operand_end <= fn.operand_pool.count
                                                for offset in 0..<paired |fn, instruction, defined, definition_types, callback, issues, block|:
                                                    operand: u32 = fn.operand_pool[instruction.operand_start.usize() + offset]
                                                    actual: Type = definition_type(defined, definition_types, operand)
                                                    issues.push(issue(IssueKind.HandlerContract, fn.name, block.id, instruction.result, instruction.trace.id, "handler callback parameter does not match the performed payload type")) if has_u32(defined, operand) and not same_type(actual, callback.parameters[offset].type)
                                                issues.push(issue(IssueKind.HandlerContract, fn.name, block.id, instruction.result, instruction.trace.id, "handler callback return type does not match the performed result type")) if not same_type(callback.return_type, instruction.result_type)
                    if instruction.opcode == Opcode.HandlerPush:
                        pushed_index: usize = handler_index(module.handlers, instruction.symbol)
                        issues.push(issue(IssueKind.UnknownHandler, fn.name, block.id, instruction.result, instruction.trace.id, "dynamic handler is not declared in the IR module")) if pushed_index == module.handlers.count
                        if pushed_index < module.handlers.count:
                            for introduced in module.handlers[pushed_index].introduces_effects |fn, block, instruction, issues|:
                                issues.push(issue(IssueKind.HandlerContract, fn.name, block.id, 0, instruction.trace.id, "handler-introduced effect is absent from the function effect row")) if not effect_granted(fn.effects, introduced)
                            for handler_error in module.handlers[pushed_index].errors |fn, block, instruction, issues|:
                                issues.push(issue(IssueKind.HandlerContract, fn.name, block.id, 0, instruction.trace.id, "handler error set is absent from the function error row")) if not has_text(fn.errors, handler_error)
                        handler_stack.push(instruction.symbol)
                    if instruction.opcode == Opcode.HandlerPop:
                        if handler_stack.count == 0 or handler_stack[handler_stack.count - 1] != instruction.symbol:
                            issues.push(issue(IssueKind.UnbalancedHandler, fn.name, block.id, instruction.result, instruction.trace.id, "dynamic handler pop does not match the active lexical handler"))
                        else:
                            _ = handler_stack.pop()
                    if instruction.opcode == Opcode.Resume:
                        index: usize = handler_index(module.handlers, instruction.symbol)
                        issues.push(issue(IssueKind.UnknownHandler, fn.name, block.id, instruction.result, instruction.trace.id, "resume names an unknown handler")) if index == module.handlers.count
                        issues.push(issue(IssueKind.InvalidResume, fn.name, block.id, instruction.result, instruction.trace.id, "terminal handlers cannot resume continuations")) if index < module.handlers.count and module.handlers[index].continuation == ContinuationPolicy.Terminal
                        issues.push(issue(IssueKind.InvalidResume, fn.name, block.id, instruction.result, instruction.trace.id, "resume requires exactly one payload operand")) if instruction.operand_count != 1
                        issues.push(issue(IssueKind.InvalidResume, fn.name, block.id, instruction.result, instruction.trace.id, "resume must produce a resumed value")) if instruction.result == 0
                        if instruction.operand_count == 1 and operand_end <= fn.operand_pool.count and has_u32(defined, fn.operand_pool[instruction.operand_start.usize()]):
                            payload_type: Type = definition_type(defined, definition_types, fn.operand_pool[instruction.operand_start.usize()])
                            issues.push(issue(IssueKind.InvalidResume, fn.name, block.id, instruction.result, instruction.trace.id, "resume payload and resumed value must have the same type")) if not same_type(payload_type, instruction.result_type)
                    if instruction.opcode == Opcode.Observe and instruction.result != 0:
                        issues.push(issue(IssueKind.InvalidObserve, fn.name, block.id, instruction.result, instruction.trace.id, "observe records values but cannot define one"))
                    issues.push(issue(IssueKind.InvalidObserve, fn.name, block.id, instruction.result, instruction.trace.id, "observe requires exactly one operand")) if instruction.opcode == Opcode.Observe and instruction.operand_count != 1
                    if instruction.opcode == Opcode.Perform or instruction.opcode == Opcode.Observe:
                        issues.push(issue(IssueKind.MissingTraceSite, fn.name, block.id, instruction.result, 0, "observable instruction requires a stable trace site")) if instruction.trace.id == 0
                        issues.push(issue(IssueKind.DuplicateTraceSite, fn.name, block.id, instruction.result, instruction.trace.id, "trace site id is not unique within the function")) if instruction.trace.id != 0 and has_u64(traces, instruction.trace.id)
                        traces.push(instruction.trace.id) if instruction.trace.id != 0 and not has_u64(traces, instruction.trace.id)
                verify_terminator(fn, block, defined, definition_blocks, definition_types, block_ids, issues)
            issues.push(issue(IssueKind.UnbalancedHandler, fn.name, fn.entry, 0, 0, "function exits with a dynamic handler still installed")) if handler_stack.count != 0


    public:
        # Verification is deterministic and target-independent. Backends must refuse a
        # module with issues instead of attempting recovery differently.
        def verify(module: Module&) -> darray[Issue] can[Memory.Allocate, Abort.Panic]:
            issues: mutable darray[Issue] = []
            for index in 0..<module.handlers.count |module, issues|:
                validate_handler(module.handlers[index], module, issues)
                for earlier in 0..<index |module, issues, index|:
                    issues.push(issue(IssueKind.DuplicateHandler, "", 0, 0, 0, "handler name is declared more than once")) if module.handlers[index].name == module.handlers[earlier].name
            for fn in module.functions |issues, module|:
                verify_function(fn, module, issues)
            return issues
