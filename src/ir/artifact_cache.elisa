# Bounded cache-boundary decisions for persisted IR and bytecode metadata.
#
# This module keeps admission and publication state beside bounded POSIX
# adapters. Persistent incremental-cache operations use directory-relative
# APIs to avoid parent-path traversal during lock, read, stage, publish, and
# cleanup. Older IR/bytecode artifact APIs retain path compatibility.

error ArtifactCacheIoError:
    NotAdmissible
    InvalidDirectoryDescriptor
    StagingWriteFailed(path: cstr)
    PublishFailed(path: cstr)
    DirectorySyncFailed(path: cstr)
    DirectoryDescriptorSyncFailed(descriptor: int)
    LockFailed(path: cstr)
    InvalidLeafName(path: cstr)
    PathCollision(path: cstr)
    PathTooLong(path: cstr)


module EsArtifactCache:
    using EsIrArtifact
    using EsBytecode
    using EsBuildIncrementalCache
    using EsRuntime

    private:
        const module Limits:
            BYTES: usize = 65536
            PAYLOAD_BYTES: usize = EsBuildIncrementalCache::Limits::CACHE_BYTES
            PATH_BYTES: usize = 4096


        # Cache paths cross several POSIX helpers, so admit every borrowed cstr
        # once before `file_size`, rename, directory sync, or flock can scan it.
        # Empty paths are rejected alongside unterminated paths so no cache
        # operation delegates an ambiguous name to libc.
        def artifact_cache_path_terminated(path: cstr) -> bool:
            bytes: u8& = path.cast[u8&]
            return false if bytes[0] == 0
            for index in 0..<Limits::PATH_BYTES |bytes|:
                return true if bytes[index] == 0
            return false


        def artifact_cache_path_equal(left: cstr, right: cstr) -> bool:
            left_bytes: u8& = left.cast[u8&]
            right_bytes: u8& = right.cast[u8&]
            for index in 0..<Limits::PATH_BYTES |left_bytes, right_bytes|:
                return false if left_bytes[index] != right_bytes[index]
                return true if left_bytes[index] == 0
            return false


        # A lock struct is ordinary data, so its Held tag alone is not a host
        # lock proof. Re-check that the descriptor still names the lock leaf
        # under this directory and that the descriptor can assert its flock.
        def artifact_cache_writer_lock_matches_at(lock: ArtifactCacheWriterLock, directory_fd: int, lock_name: cstr, owner_token: u64) -> bool can[Blocking.IO]:
            return false if lock.state != ArtifactCacheWriterLockState.Held or lock.owner_token != owner_token or owner_token == 0 or lock.descriptor < 0
            return false if not artifact_cache_path_terminated(lock.path) or not artifact_cache_path_equal(lock.path, lock_name)
            return false if not artifact_cache_directory_descriptor_valid(directory_fd)
            descriptor_info: mutable ElisascriptStat = ElisascriptStat{}
            named_info: mutable ElisascriptStat = ElisascriptStat{}
            return false if elisascript_posix_fstat(lock.descriptor, descriptor_info) != 0
            return false if elisascript_posix_fstatat(directory_fd, lock_name, named_info, DarwinAtFlag::SYMLINK_NOFOLLOW) != 0
            return false if (descriptor_info.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR or descriptor_info.link_count != 1
            return false if descriptor_info.device != named_info.device or descriptor_info.inode != named_info.inode
            return elisascript_posix_flock(lock.descriptor, PosixLockOperations::EXCLUSIVE + PosixLockOperations::NONBLOCK) == 0

    public:
        const enum ArtifactCacheKind of u8:
            IrMetadata
            BytecodeMetadata


        const enum ArtifactCacheAdmission of u8:
            Current
            NeedsMigration
            Invalid


        struct ArtifactCacheDecision:
            kind: ArtifactCacheKind
            admission: ArtifactCacheAdmission
            fingerprint: u64 = 0


        const enum ArtifactCacheLifecycle of u8:
            Empty
            Staged
            Committed
            Rejected


        const enum ArtifactCacheEvent of u8:
            Stage
            Commit
            Abort
            Restart


        # Recovery is deliberately a pure decision.  A host adapter supplies
        # the observed staging/destination state and performs the selected
        # filesystem action under its lock; this module never guesses that a
        # rename or commit marker survived a crash.
        const enum ArtifactCacheRecoveryAction of u8:
            Noop
            KeepPublished
            RemoveStaging
            RebuildPublished


        struct ArtifactCachePublication:
            state: ArtifactCacheLifecycle
            bytes_count: usize = 0
            fingerprint: u64 = 0


        struct ArtifactCachePayloadPublication:
            state: ArtifactCacheLifecycle
            bytes_count: usize = 0


        struct ArtifactCacheLoad:
            bytes: darray[u8]
            decision: ArtifactCacheDecision


        const enum ArtifactCacheWriterState of u8:
            Available
            Held
            Published
            Aborted


        const enum ArtifactCacheWriterEvent of u8:
            Acquire
            Publish
            Abort


        struct ArtifactCacheWriterLease:
            state: ArtifactCacheWriterState = ArtifactCacheWriterState.Available
            owner_token: u64 = 0


        const enum ArtifactCacheWriterLockState of u8:
            Available
            Held
            Released


        const enum ArtifactCacheWriterLockEvent of u8:
            Acquire
            Release


        struct ArtifactCacheWriterLock:
            state: ArtifactCacheWriterLockState = ArtifactCacheWriterLockState.Available
            owner_token: u64 = 0
            path: cstr = ""
            descriptor: int = -1


    private:
        const module StageWriteLimits:
            EINTR_RETRIES: usize = 16


        const enum StageWriteState of u8:
            Write
            Done
            Failed


        struct StageWriteCursor:
            state: StageWriteState = StageWriteState.Write
            offset: usize = 0
            calls: usize = 0
            interrupted: usize = 0


        const enum CacheReadState of u8:
            Read
            Done
            Failed


        struct CacheReadCursor:
            state: CacheReadState = CacheReadState.Read
            offset: usize = 0
            calls: usize = 0
            interrupted: usize = 0


        def artifact_cache_write_descriptor_fully(descriptor: int, bytes: mutable darray[u8]&) -> bool can[Blocking.IO]:
            cursor: mutable StageWriteCursor = StageWriteCursor{}
            machine over cursor.state:
                state Write
                start Write

                Write, StageWriteState.Write if cursor.offset >= bytes.count:
                    cursor.state <- StageWriteState.Done
                    -> Write
                Write, StageWriteState.Write:
                    if cursor.calls >= bytes.count + StageWriteLimits::EINTR_RETRIES:
                        cursor.state <- StageWriteState.Failed
                        -> Write
                    remaining: usize = bytes.count - cursor.offset
                    buffer: mutable u8& = bytes.items + cursor.offset
                    amount: isize = elisascript_posix_write(descriptor, buffer.cast[void&], remaining)
                    cursor.calls <- cursor.calls + 1
                    if amount < 0:
                        errno: mutable i32& = elisascript_posix_errno()
                        if errno[0] == DarwinErrno::EINTR and cursor.interrupted < StageWriteLimits::EINTR_RETRIES:
                            cursor.interrupted <- cursor.interrupted + 1
                            -> Write
                        cursor.state <- StageWriteState.Failed
                        -> Write
                    if amount == 0 or amount.usize() > remaining:
                        cursor.state <- StageWriteState.Failed
                        -> Write
                    cursor.offset <- cursor.offset + amount.usize()
                    -> Write

                Write, StageWriteState.Done:
                    break
                Write, StageWriteState.Failed:
                    break
            return cursor.state == StageWriteState.Done


        def artifact_cache_read_descriptor_fully(descriptor: int, bytes: mutable darray[u8]&, expected_count: usize) -> bool can[Blocking.IO]:
            cursor: mutable CacheReadCursor = CacheReadCursor{}
            machine over cursor.state:
                state Read
                start Read

                Read, CacheReadState.Read if cursor.offset >= expected_count:
                    cursor.state <- CacheReadState.Done
                    -> Read
                Read, CacheReadState.Read:
                    if cursor.calls >= expected_count + StageWriteLimits::EINTR_RETRIES:
                        cursor.state <- CacheReadState.Failed
                        -> Read
                    remaining: usize = expected_count - cursor.offset
                    destination: mutable u8& = bytes.items + cursor.offset
                    amount: isize = elisascript_posix_read(descriptor, destination.cast[mutable void&], remaining)
                    cursor.calls <- cursor.calls + 1
                    if amount < 0:
                        errno: mutable i32& = elisascript_posix_errno()
                        if errno[0] == DarwinErrno::EINTR and cursor.interrupted < StageWriteLimits::EINTR_RETRIES:
                            cursor.interrupted <- cursor.interrupted + 1
                            -> Read
                        cursor.state <- CacheReadState.Failed
                        -> Read
                    if amount == 0 or amount.usize() > remaining:
                        cursor.state <- CacheReadState.Failed
                        -> Read
                    cursor.offset <- cursor.offset + amount.usize()
                    bytes.count <- cursor.offset
                    -> Read

                Read, CacheReadState.Done:
                    break
                Read, CacheReadState.Failed:
                    break
            return cursor.state == CacheReadState.Done


        def artifact_cache_read_bounded_file(a: mutable Arena&, path: cstr, byte_limit: usize = Limits::BYTES) -> darray[u8] error[FileIoError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic]:
            raise FileIoError.ReadFailed(path) if not artifact_cache_path_terminated(path)
            raise FileIoError.ReadFailed(path) if byte_limit == 0 or byte_limit > Limits::PAYLOAD_BYTES
            size: i64 = try file_size(path)
            return [] if size == 0
            raise FileIoError.ReadFailed(path) if size < 0 or size.usize().i64() != size or size.usize() > byte_limit
            expected_count: usize = size.usize()
            bytes: darray[u8] = try read_entire_file(a, path)
            raise FileIoError.ReadFailed(path) if bytes.count != expected_count or bytes.count > byte_limit
            return bytes


        def artifact_cache_write_staging(staging_path: cstr, bytes: mutable darray[u8]&, byte_limit: usize = Limits::BYTES) -> void error[ArtifactCacheIoError] can[Blocking.IO]:
            raise ArtifactCacheIoError.PathTooLong(staging_path) if not artifact_cache_path_terminated(staging_path)
            raise ArtifactCacheIoError.StagingWriteFailed(staging_path) if byte_limit == 0 or byte_limit > Limits::PAYLOAD_BYTES or bytes.count == 0 or bytes.count > byte_limit or bytes.items == null
            flags: int = DarwinOpenFlags::WRONLY | DarwinOpenFlags::CREATE | DarwinOpenFlags::EXCLUSIVE | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
            descriptor: int = elisascript_posix_open(staging_path, flags, 384u32)
            raise ArtifactCacheIoError.StagingWriteFailed(staging_path) if descriptor < 0
            write_complete: bool = artifact_cache_write_descriptor_fully(descriptor, bytes)
            sync_status: int = elisascript_posix_fsync(descriptor) if write_complete else -1
            close_status: int = elisascript_posix_close(descriptor)
            if not write_complete or sync_status != 0 or close_status != 0:
                _ = remove_file(staging_path)
                raise ArtifactCacheIoError.StagingWriteFailed(staging_path)


        def artifact_cache_directory_descriptor_valid(directory_fd: int) -> bool can[Blocking.IO]:
            return false if directory_fd < 0
            info: mutable ElisascriptStat = ElisascriptStat{}
            return elisascript_posix_fstat(directory_fd, info) == 0 and (info.mode & DarwinStatMode::MASK) == DarwinStatMode::DIRECTORY


        def artifact_cache_read_file_at(a: mutable Arena&, directory_fd: int, cache_name: cstr) -> darray[u8] error[FileIoError] can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            raise FileIoError.ReadFailed(cache_name) if not artifact_cache_directory_descriptor_valid(directory_fd) or not elisascript_posix_leaf_name_valid(cache_name)
            flags: int = DarwinOpenFlags::RDONLY | DarwinOpenFlags::NONBLOCK | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
            descriptor: int = elisascript_posix_openat(directory_fd, cache_name, flags, 0u32)
            raise FileIoError.ReadFailed(cache_name) if descriptor < 0
            info: mutable ElisascriptStat = ElisascriptStat{}
            if elisascript_posix_fstat(descriptor, info) != 0 or (info.mode & DarwinStatMode::MASK) != DarwinStatMode::REGULAR or info.size <= 0 or info.size.usize().i64() != info.size or info.size.usize() > Limits::PAYLOAD_BYTES:
                _ = elisascript_posix_close(descriptor)
                raise FileIoError.ReadFailed(cache_name)
            expected_count: usize = info.size.usize()
            bytes: mutable darray[u8] = []
            _ = arena_da_reserve(a, bytes, expected_count)
            read_complete: bool = artifact_cache_read_descriptor_fully(descriptor, bytes, expected_count)
            close_status: int = elisascript_posix_close(descriptor)
            raise FileIoError.ReadFailed(cache_name) if not read_complete or close_status != 0 or bytes.count != expected_count
            return bytes


        def artifact_cache_write_staging_at(directory_fd: int, staging_name: cstr, bytes: mutable darray[u8]&, byte_limit: usize) -> void error[ArtifactCacheIoError] can[Blocking.IO]:
            raise ArtifactCacheIoError.InvalidDirectoryDescriptor if not artifact_cache_directory_descriptor_valid(directory_fd)
            raise ArtifactCacheIoError.InvalidLeafName(staging_name) if not elisascript_posix_leaf_name_valid(staging_name)
            raise ArtifactCacheIoError.StagingWriteFailed(staging_name) if byte_limit == 0 or byte_limit > Limits::PAYLOAD_BYTES or bytes.count == 0 or bytes.count > byte_limit or bytes.items == null
            flags: int = DarwinOpenFlags::WRONLY | DarwinOpenFlags::CREATE | DarwinOpenFlags::EXCLUSIVE | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
            descriptor: int = elisascript_posix_openat(directory_fd, staging_name, flags, 384u32)
            raise ArtifactCacheIoError.StagingWriteFailed(staging_name) if descriptor < 0
            write_complete: bool = artifact_cache_write_descriptor_fully(descriptor, bytes)
            sync_status: int = elisascript_posix_fsync(descriptor) if write_complete else -1
            close_status: int = elisascript_posix_close(descriptor)
            if not write_complete or sync_status != 0 or close_status != 0:
                catch elisascript_posix_unlinkat_leaf(directory_fd, staging_name):
                    ok status:
                        pass
                    error failure:
                        pass
                raise ArtifactCacheIoError.StagingWriteFailed(staging_name)


        def artifact_cache_sync_directory(directory_path: cstr) -> bool error[ArtifactCacheIoError] can[Blocking.IO, Memory.Release]:
            raise ArtifactCacheIoError.PathTooLong(directory_path) if not artifact_cache_path_terminated(directory_path)
            directory: mutable heap void&? = elisascript_posix_opendir(directory_path)
            raise ArtifactCacheIoError.DirectorySyncFailed(directory_path) if directory == null
            opened: mutable heap void& = directory
            descriptor: int = elisascript_posix_dirfd(opened)
            sync_status: int = elisascript_posix_fsync(descriptor) if descriptor >= 0 else -1
            close_status: int = elisascript_posix_closedir(opened)
            raise ArtifactCacheIoError.DirectorySyncFailed(directory_path) if descriptor < 0 or sync_status != 0 or close_status != 0
            return true


        def artifact_cache_publish_file(staging_path: cstr, destination_path: cstr, bytes: mutable darray[u8]&, decision: ArtifactCacheDecision, directory_path: cstr = "") -> ArtifactCachePublication error[ArtifactCacheIoError] can[Blocking.IO]:
            raise ArtifactCacheIoError.PathTooLong(staging_path) if not artifact_cache_path_terminated(staging_path)
            raise ArtifactCacheIoError.PathTooLong(destination_path) if not artifact_cache_path_terminated(destination_path)
            raise ArtifactCacheIoError.PathTooLong(directory_path) if directory_path != "" and not artifact_cache_path_terminated(directory_path)
            raise ArtifactCacheIoError.PathCollision(staging_path) if artifact_cache_path_equal(staging_path, destination_path)
            publication: ArtifactCachePublication = artifact_cache_stage(decision, bytes.count)
            raise ArtifactCacheIoError.NotAdmissible if publication.state != ArtifactCacheLifecycle.Staged
            catch artifact_cache_write_staging(staging_path, bytes):
                ok:
                    pass
                error failure:
                    raise failure
            if elisascript_posix_rename(staging_path.cast[u8&], destination_path.cast[u8&]) != 0:
                _ = remove_file(staging_path)
                raise ArtifactCacheIoError.PublishFailed(destination_path)
            if directory_path != "":
                catch artifact_cache_sync_directory(directory_path):
                    ok:
                        pass
                    error failure:
                        raise failure
            return artifact_cache_commit(publication)


        def artifact_cache_publish_payload_at(directory_fd: int, lock_name: cstr, staging_name: cstr, destination_name: cstr, bytes: mutable darray[u8]&, byte_limit: usize) -> ArtifactCachePayloadPublication error[ArtifactCacheIoError] can[Blocking.IO]:
            raise ArtifactCacheIoError.InvalidDirectoryDescriptor if not artifact_cache_directory_descriptor_valid(directory_fd)
            raise ArtifactCacheIoError.InvalidLeafName(lock_name) if not elisascript_posix_leaf_name_valid(lock_name)
            raise ArtifactCacheIoError.InvalidLeafName(staging_name) if not elisascript_posix_leaf_name_valid(staging_name)
            raise ArtifactCacheIoError.InvalidLeafName(destination_name) if not elisascript_posix_leaf_name_valid(destination_name)
            raise ArtifactCacheIoError.PathCollision(lock_name) if artifact_cache_path_equal(lock_name, staging_name) or artifact_cache_path_equal(lock_name, destination_name)
            raise ArtifactCacheIoError.PathCollision(staging_name) if artifact_cache_path_equal(staging_name, destination_name)
            raise ArtifactCacheIoError.StagingWriteFailed(staging_name) if byte_limit == 0 or byte_limit > Limits::PAYLOAD_BYTES or bytes.count == 0 or bytes.count > byte_limit
            try artifact_cache_write_staging_at(directory_fd, staging_name, bytes, byte_limit)
            published: mutable bool = false
            catch elisascript_posix_renameat(directory_fd, staging_name, directory_fd, destination_name):
                ok status:
                    published <- status == 0
                error failure:
                    pass
            if not published:
                catch elisascript_posix_unlinkat_leaf(directory_fd, staging_name):
                    ok status:
                        pass
                    error failure:
                        pass
                raise ArtifactCacheIoError.PublishFailed(destination_name)
            raise ArtifactCacheIoError.DirectoryDescriptorSyncFailed(directory_fd) if elisascript_posix_fsync(directory_fd) != 0
            return ArtifactCachePayloadPublication{state: ArtifactCacheLifecycle.Committed, bytes_count: bytes.count}


        def artifact_cache_publish_payload_at_locked(lock: mutable ArtifactCacheWriterLock&, directory_fd: int, lock_name: cstr, owner_token: u64, staging_name: cstr, destination_name: cstr, bytes: mutable darray[u8]&, byte_limit: usize) -> ArtifactCachePayloadPublication error[ArtifactCacheIoError] can[Blocking.IO]:
            _ = try artifact_cache_writer_lock_acquire_at(lock, directory_fd, lock_name, owner_token)
            catch artifact_cache_publish_payload_at(directory_fd, lock_name, staging_name, destination_name, bytes, byte_limit):
                ok publication:
                    released: bool = false
                    catch artifact_cache_writer_lock_release(lock, owner_token):
                        ok status:
                            released <- status
                        error failure:
                            raise failure
                    raise ArtifactCacheIoError.LockFailed(lock_name) if not released
                    return publication
                error failure:
                    catch artifact_cache_writer_lock_release(lock, owner_token):
                        ok:
                            pass
                        error release_failure:
                            pass
                    raise failure


    public:
        def classify_module_artifact_cache(bytes: darray[u8]&) -> ArtifactCacheDecision:
            status: ModuleArtifactEnvelopeStatus = module_artifact_envelope_status(bytes)
            return ArtifactCacheDecision{kind: ArtifactCacheKind.IrMetadata, admission: ArtifactCacheAdmission.NeedsMigration} if status == ModuleArtifactEnvelopeStatus.Legacy
            return ArtifactCacheDecision{kind: ArtifactCacheKind.IrMetadata, admission: ArtifactCacheAdmission.Invalid} if status == ModuleArtifactEnvelopeStatus.Invalid
            decoded: ModuleArtifactDecode = decode_module_artifact(bytes)
            return ArtifactCacheDecision{kind: ArtifactCacheKind.IrMetadata, admission: ArtifactCacheAdmission.Invalid} if not decoded.valid
            return ArtifactCacheDecision{kind: ArtifactCacheKind.IrMetadata, admission: ArtifactCacheAdmission.Current, fingerprint: decoded.artifact.fingerprint}


        def classify_bytecode_artifact_cache(bytes: darray[u8]&) -> ArtifactCacheDecision:
            status: BytecodeArtifactEnvelopeStatus = bytecode_artifact_envelope_status(bytes)
            return ArtifactCacheDecision{kind: ArtifactCacheKind.BytecodeMetadata, admission: ArtifactCacheAdmission.NeedsMigration} if status == BytecodeArtifactEnvelopeStatus.Legacy
            return ArtifactCacheDecision{kind: ArtifactCacheKind.BytecodeMetadata, admission: ArtifactCacheAdmission.Invalid} if status == BytecodeArtifactEnvelopeStatus.Invalid
            decoded: BytecodeArtifactDecode = decode_bytecode_artifact(bytes)
            return ArtifactCacheDecision{kind: ArtifactCacheKind.BytecodeMetadata, admission: ArtifactCacheAdmission.Invalid} if not decoded.valid
            return ArtifactCacheDecision{kind: ArtifactCacheKind.BytecodeMetadata, admission: ArtifactCacheAdmission.Current, fingerprint: decoded.artifact.module_fingerprint}


        def load_module_artifact_file(a: mutable Arena&, path: cstr) -> ArtifactCacheLoad error[FileIoError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic]:
            bytes: darray[u8] = try artifact_cache_read_bounded_file(a, path)
            return ArtifactCacheLoad{bytes: bytes, decision: classify_module_artifact_cache(bytes)}


        def load_bytecode_artifact_file(a: mutable Arena&, path: cstr) -> ArtifactCacheLoad error[FileIoError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic]:
            bytes: darray[u8] = try artifact_cache_read_bounded_file(a, path)
            return ArtifactCacheLoad{bytes: bytes, decision: classify_bytecode_artifact_cache(bytes)}


        def publish_module_artifact_file(staging_path: cstr, destination_path: cstr, bytes: mutable darray[u8]&, directory_path: cstr = "") -> ArtifactCachePublication error[ArtifactCacheIoError] can[Blocking.IO]:
            return try artifact_cache_publish_file(staging_path, destination_path, bytes, classify_module_artifact_cache(bytes), directory_path)


        def publish_bytecode_artifact_file(staging_path: cstr, destination_path: cstr, bytes: mutable darray[u8]&, directory_path: cstr = "") -> ArtifactCachePublication error[ArtifactCacheIoError] can[Blocking.IO]:
            return try artifact_cache_publish_file(staging_path, destination_path, bytes, classify_bytecode_artifact_cache(bytes), directory_path)


        # This is an ownership admission contract, not a replacement for an
        # OS lock.  A host adapter must hold one nonzero token while it stages
        # and publishes; stale or competing tokens fail closed.
        def artifact_cache_writer_transition(state: ArtifactCacheWriterState, event: ArtifactCacheWriterEvent) -> ArtifactCacheWriterState:
            return ArtifactCacheWriterState.Held if state == ArtifactCacheWriterState.Available and event == ArtifactCacheWriterEvent.Acquire
            return ArtifactCacheWriterState.Published if state == ArtifactCacheWriterState.Held and event == ArtifactCacheWriterEvent.Publish
            return ArtifactCacheWriterState.Aborted if state == ArtifactCacheWriterState.Held and event == ArtifactCacheWriterEvent.Abort
            return ArtifactCacheWriterState.Held if state == ArtifactCacheWriterState.Aborted and event == ArtifactCacheWriterEvent.Acquire
            return state


        def artifact_cache_writer_acquire(lease: mutable ArtifactCacheWriterLease&, owner_token: u64) -> bool:
            return false if owner_token == 0 or (lease.state != ArtifactCacheWriterState.Available and lease.state != ArtifactCacheWriterState.Aborted)
            lease.state <- artifact_cache_writer_transition(lease.state, ArtifactCacheWriterEvent.Acquire)
            lease.owner_token <- owner_token
            return true


        def artifact_cache_writer_publish(lease: mutable ArtifactCacheWriterLease&, owner_token: u64) -> bool:
            return false if owner_token == 0 or lease.state != ArtifactCacheWriterState.Held or lease.owner_token != owner_token
            lease.state <- artifact_cache_writer_transition(lease.state, ArtifactCacheWriterEvent.Publish)
            return true


        def artifact_cache_writer_abort(lease: mutable ArtifactCacheWriterLease&, owner_token: u64) -> bool:
            return false if owner_token == 0 or lease.state != ArtifactCacheWriterState.Held or lease.owner_token != owner_token
            lease.state <- artifact_cache_writer_transition(lease.state, ArtifactCacheWriterEvent.Abort)
            lease.owner_token <- 0
            return true


        # POSIX hosts may opt into an actual nonblocking advisory lock. The
        # portable owner-token lease remains the admission contract; this edge
        # supplies host arbitration without exposing flock or FILE* to callers.
        def artifact_cache_writer_lock_transition(state: ArtifactCacheWriterLockState, event: ArtifactCacheWriterLockEvent) -> ArtifactCacheWriterLockState:
            return ArtifactCacheWriterLockState.Held if (state == ArtifactCacheWriterLockState.Available or state == ArtifactCacheWriterLockState.Released) and event == ArtifactCacheWriterLockEvent.Acquire
            return ArtifactCacheWriterLockState.Released if state == ArtifactCacheWriterLockState.Held and event == ArtifactCacheWriterLockEvent.Release
            return state


        def artifact_cache_writer_lock_acquire(lock: mutable ArtifactCacheWriterLock&, path: cstr, owner_token: u64) -> bool error[ArtifactCacheIoError] can[Blocking.IO]:
            raise ArtifactCacheIoError.PathTooLong(path) if not artifact_cache_path_terminated(path)
            raise ArtifactCacheIoError.LockFailed(path) if owner_token == 0 or (lock.state != ArtifactCacheWriterLockState.Available and lock.state != ArtifactCacheWriterLockState.Released)
            flags: int = DarwinOpenFlags::WRONLY | DarwinOpenFlags::CREATE | DarwinOpenFlags::NONBLOCK | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
            descriptor: int = elisascript_posix_open(path, flags, 384u32)
            if descriptor < 0 or elisascript_posix_flock(descriptor, PosixLockOperations::EXCLUSIVE + PosixLockOperations::NONBLOCK) != 0:
                _ = elisascript_posix_close(descriptor) if descriptor >= 0
                raise ArtifactCacheIoError.LockFailed(path)
            lock.state <- artifact_cache_writer_lock_transition(lock.state, ArtifactCacheWriterLockEvent.Acquire)
            lock.owner_token <- owner_token
            lock.path <- path
            lock.descriptor <- descriptor
            return true


        def artifact_cache_writer_lock_acquire_at(lock: mutable ArtifactCacheWriterLock&, directory_fd: int, lock_name: cstr, owner_token: u64) -> bool error[ArtifactCacheIoError] can[Blocking.IO]:
            raise ArtifactCacheIoError.InvalidDirectoryDescriptor if not artifact_cache_directory_descriptor_valid(directory_fd)
            raise ArtifactCacheIoError.InvalidLeafName(lock_name) if not elisascript_posix_leaf_name_valid(lock_name)
            raise ArtifactCacheIoError.LockFailed(lock_name) if owner_token == 0 or (lock.state != ArtifactCacheWriterLockState.Available and lock.state != ArtifactCacheWriterLockState.Released)
            flags: int = DarwinOpenFlags::WRONLY | DarwinOpenFlags::CREATE | DarwinOpenFlags::NONBLOCK | DarwinOpenFlags::NOFOLLOW | DarwinOpenFlags::CLOSE_ON_EXEC
            descriptor: int = elisascript_posix_openat(directory_fd, lock_name, flags, 384u32)
            if descriptor < 0 or elisascript_posix_flock(descriptor, PosixLockOperations::EXCLUSIVE + PosixLockOperations::NONBLOCK) != 0:
                _ = elisascript_posix_close(descriptor) if descriptor >= 0
                raise ArtifactCacheIoError.LockFailed(lock_name)
            lock.state <- artifact_cache_writer_lock_transition(lock.state, ArtifactCacheWriterLockEvent.Acquire)
            lock.owner_token <- owner_token
            lock.path <- lock_name
            lock.descriptor <- descriptor
            return true


        def artifact_cache_writer_lock_release(lock: mutable ArtifactCacheWriterLock&, owner_token: u64) -> bool error[ArtifactCacheIoError] can[Blocking.IO]:
            return false if owner_token == 0 or lock.state != ArtifactCacheWriterLockState.Held or lock.owner_token != owner_token
            descriptor: int = lock.descriptor
            lock.state <- artifact_cache_writer_lock_transition(lock.state, ArtifactCacheWriterLockEvent.Release)
            lock.owner_token <- 0
            lock.descriptor <- -1
            raise ArtifactCacheIoError.LockFailed(lock.path) if descriptor < 0 or elisascript_posix_close(descriptor) != 0
            return true


    private:
        # Keep the host lock held across the complete staged-write, rename, and
        # optional parent-directory sync sequence.  A publication failure still
        # reports its original cause after best-effort lock cleanup; a successful
        # publication treats a failed or stale release as a lock error.
        def artifact_cache_publish_locked(lock: mutable ArtifactCacheWriterLock&, lock_path: cstr, owner_token: u64, staging_path: cstr, destination_path: cstr, bytes: mutable darray[u8]&, decision: ArtifactCacheDecision, directory_path: cstr = "") -> ArtifactCachePublication error[ArtifactCacheIoError] can[Blocking.IO]:
            raise ArtifactCacheIoError.PathTooLong(lock_path) if not artifact_cache_path_terminated(lock_path)
            raise ArtifactCacheIoError.PathTooLong(staging_path) if not artifact_cache_path_terminated(staging_path)
            raise ArtifactCacheIoError.PathTooLong(destination_path) if not artifact_cache_path_terminated(destination_path)
            raise ArtifactCacheIoError.PathCollision(lock_path) if artifact_cache_path_equal(lock_path, staging_path) or artifact_cache_path_equal(lock_path, destination_path)
            _ = try artifact_cache_writer_lock_acquire(lock, lock_path, owner_token)
            catch artifact_cache_publish_file(staging_path, destination_path, bytes, decision, directory_path):
                ok publication:
                    released: bool = false
                    catch artifact_cache_writer_lock_release(lock, owner_token):
                        ok status:
                            released <- status
                        error failure:
                            raise failure
                    raise ArtifactCacheIoError.LockFailed(lock_path) if not released
                    return publication
                error failure:
                    catch artifact_cache_writer_lock_release(lock, owner_token):
                        ok:
                            pass
                        error release_failure:
                            pass
                    raise failure


    public:
        def publish_module_artifact_file_locked(lock: mutable ArtifactCacheWriterLock&, lock_path: cstr, owner_token: u64, staging_path: cstr, destination_path: cstr, bytes: mutable darray[u8]&, directory_path: cstr = "") -> ArtifactCachePublication error[ArtifactCacheIoError] can[Blocking.IO]:
            return try artifact_cache_publish_locked(lock, lock_path, owner_token, staging_path, destination_path, bytes, classify_module_artifact_cache(bytes), directory_path)


        def publish_bytecode_artifact_file_locked(lock: mutable ArtifactCacheWriterLock&, lock_path: cstr, owner_token: u64, staging_path: cstr, destination_path: cstr, bytes: mutable darray[u8]&, directory_path: cstr = "") -> ArtifactCachePublication error[ArtifactCacheIoError] can[Blocking.IO]:
            return try artifact_cache_publish_locked(lock, lock_path, owner_token, staging_path, destination_path, bytes, classify_bytecode_artifact_cache(bytes), directory_path)


        # Compatibility reader for older path-oriented callers. New persistent
        # cache callers should use the descriptor-relative API below.
        def read_build_incremental_cache_file(a: mutable Arena&, path: cstr) -> darray[u8] error[FileIoError, BuildIncrementalCacheError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            bytes: darray[u8] = try artifact_cache_read_bounded_file(a, path, EsBuildIncrementalCache::Limits::CACHE_BYTES)
            _ = try decode_build_incremental_cache(bytes)
            return bytes


        def read_build_incremental_cache_at(a: mutable Arena&, directory_fd: int, cache_name: cstr) -> darray[u8] error[FileIoError, BuildIncrementalCacheError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            bytes: darray[u8] = try artifact_cache_read_file_at(a, directory_fd, cache_name)
            _ = try decode_build_incremental_cache(bytes)
            return bytes


        # This is the hardened persistence entry point: the caller supplies an
        # already-open directory descriptor and single-component names, so all
        # cache mutations remain anchored to that directory capability.
        def publish_build_incremental_cache_at_locked(lock: mutable ArtifactCacheWriterLock&, directory_fd: int, lock_name: cstr, owner_token: u64, staging_name: cstr, destination_name: cstr, bytes: mutable darray[u8]&) -> ArtifactCachePayloadPublication error[ArtifactCacheIoError, BuildIncrementalCacheError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            _ = try decode_build_incremental_cache(bytes)
            return try artifact_cache_publish_payload_at_locked(lock, directory_fd, lock_name, owner_token, staging_name, destination_name, bytes, EsBuildIncrementalCache::Limits::CACHE_BYTES)


        # Publish while a caller-held lock spans the larger build transaction.
        # Unlike the convenience `_locked` form, this does not reacquire or
        # release the lock; the owner must release it on both success and
        # failure. Matching the stored lock name and owner token prevents an
        # unrelated lease from authorizing publication through this handle;
        # the descriptor and named lock inode are also revalidated.
        def publish_build_incremental_cache_at_held(lock: mutable ArtifactCacheWriterLock&, directory_fd: int, lock_name: cstr, owner_token: u64, staging_name: cstr, destination_name: cstr, bytes: mutable darray[u8]&) -> ArtifactCachePayloadPublication error[ArtifactCacheIoError, BuildIncrementalCacheError] can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            raise ArtifactCacheIoError.LockFailed(lock_name) if not artifact_cache_writer_lock_matches_at(lock, directory_fd, lock_name, owner_token)
            _ = try decode_build_incremental_cache(bytes)
            return try artifact_cache_publish_payload_at(directory_fd, lock_name, staging_name, destination_name, bytes, EsBuildIncrementalCache::Limits::CACHE_BYTES)


    public:
        def artifact_cache_decision_valid(decision: ArtifactCacheDecision&) -> bool:
            return decision.admission in {ArtifactCacheAdmission.Current, ArtifactCacheAdmission.NeedsMigration} and decision.kind in {ArtifactCacheKind.IrMetadata, ArtifactCacheKind.BytecodeMetadata}


        # A cache publication is a small state machine.  Invalid transitions
        # fail closed to Rejected; a restart never turns staged bytes into a
        # committed entry without an observed commit marker.
        def artifact_cache_lifecycle_transition(state: ArtifactCacheLifecycle, event: ArtifactCacheEvent) -> ArtifactCacheLifecycle:
            return ArtifactCacheLifecycle.Staged if state == ArtifactCacheLifecycle.Empty and event == ArtifactCacheEvent.Stage
            return ArtifactCacheLifecycle.Committed if state == ArtifactCacheLifecycle.Staged and event == ArtifactCacheEvent.Commit
            return ArtifactCacheLifecycle.Rejected if state == ArtifactCacheLifecycle.Staged and event == ArtifactCacheEvent.Abort
            return ArtifactCacheLifecycle.Committed if state == ArtifactCacheLifecycle.Committed and event == ArtifactCacheEvent.Restart
            return ArtifactCacheLifecycle.Empty if state == ArtifactCacheLifecycle.Empty and event == ArtifactCacheEvent.Restart
            return ArtifactCacheLifecycle.Rejected


        def artifact_cache_stage(decision: ArtifactCacheDecision&, bytes_count: usize) -> ArtifactCachePublication:
            return ArtifactCachePublication{state: ArtifactCacheLifecycle.Rejected, bytes_count: bytes_count, fingerprint: decision.fingerprint} if not artifact_cache_decision_valid(decision) or decision.admission != ArtifactCacheAdmission.Current or bytes_count == 0 or bytes_count > Limits::BYTES
            return ArtifactCachePublication{state: ArtifactCacheLifecycle.Staged, bytes_count: bytes_count, fingerprint: decision.fingerprint}


        def artifact_cache_commit(publication: ArtifactCachePublication&) -> ArtifactCachePublication:
            return ArtifactCachePublication{state: artifact_cache_lifecycle_transition(publication.state, ArtifactCacheEvent.Commit), bytes_count: publication.bytes_count, fingerprint: publication.fingerprint}


        def artifact_cache_abort(publication: ArtifactCachePublication&) -> ArtifactCachePublication:
            return ArtifactCachePublication{state: artifact_cache_lifecycle_transition(publication.state, ArtifactCacheEvent.Abort), bytes_count: publication.bytes_count, fingerprint: publication.fingerprint}


        def artifact_cache_restart(publication: ArtifactCachePublication&) -> ArtifactCachePublication:
            return ArtifactCachePublication{state: artifact_cache_lifecycle_transition(publication.state, ArtifactCacheEvent.Restart), bytes_count: publication.bytes_count, fingerprint: publication.fingerprint}


        # Decide what a cache owner must do after reopening its metadata.  A
        # committed record is retained only when the destination is present and
        # already validated against its digest/capability metadata.  A staged
        # record has no commit marker and therefore cannot be promoted merely
        # because a destination happens to exist; the owner either removes the
        # stale staging file or rebuilds the destination.  Empty/rejected
        # records never authorize touching a destination.
        def artifact_cache_recovery_action(state: ArtifactCacheLifecycle, staging_present: bool, destination_present: bool, destination_valid: bool) -> ArtifactCacheRecoveryAction:
            return ArtifactCacheRecoveryAction.KeepPublished if state == ArtifactCacheLifecycle.Committed and destination_present and destination_valid
            return ArtifactCacheRecoveryAction.RebuildPublished if state == ArtifactCacheLifecycle.Committed
            return ArtifactCacheRecoveryAction.RemoveStaging if state == ArtifactCacheLifecycle.Staged and staging_present
            return ArtifactCacheRecoveryAction.RebuildPublished if state == ArtifactCacheLifecycle.Staged and destination_present
            return ArtifactCacheRecoveryAction.RemoveStaging if (state == ArtifactCacheLifecycle.Empty or state == ArtifactCacheLifecycle.Rejected) and staging_present
            return ArtifactCacheRecoveryAction.Noop
