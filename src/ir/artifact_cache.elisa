# Bounded cache-boundary decisions for persisted IR and bytecode metadata.
#
# This module keeps admission and publication state beside a bounded POSIX
# adapter.  The adapter writes a staged file, closes it through the typed
# stream API, and publishes it with one rename edge; crash recovery and fsync
# policy remain explicit host qualifications rather than hidden assumptions.

error ArtifactCacheIoError:
    NotAdmissible
    StagingWriteFailed(path: cstr)
    PublishFailed(path: cstr)
    DirectorySyncFailed(path: cstr)
    LockFailed(path: cstr)
    PathTooLong(path: cstr)


module EsArtifactCache:
    using EsIrArtifact
    using EsBytecode
    using EsRuntime

    private:
        const ARTIFACT_CACHE_MAX_BYTES: usize = 65536
        const ARTIFACT_CACHE_MAX_PATH_BYTES: usize = 4096


        # Cache paths cross several POSIX helpers, so admit every borrowed cstr
        # once before `file_size`, rename, directory sync, or flock can scan it.
        def artifact_cache_path_terminated(path: cstr) -> bool:
            bytes: u8& = path.cast[u8&]
            for index in 0..<ARTIFACT_CACHE_MAX_PATH_BYTES |bytes|:
                return true if bytes[index] == 0
            return false

    public:
        const enum ArtifactCacheKind of u8:
            IrMetadata
            BytecodeMetadata


        const enum ArtifactCacheAdmission of u8:
            Current
            NeedsMigration
            Invalid


        struct ArtifactCacheDecision:
            kind: ArtifactCacheKind
            admission: ArtifactCacheAdmission
            fingerprint: u64 = 0


        const enum ArtifactCacheLifecycle of u8:
            Empty
            Staged
            Committed
            Rejected


        const enum ArtifactCacheEvent of u8:
            Stage
            Commit
            Abort
            Restart


        struct ArtifactCachePublication:
            state: ArtifactCacheLifecycle
            bytes_count: usize = 0
            fingerprint: u64 = 0


        struct ArtifactCacheLoad:
            bytes: darray[u8]
            decision: ArtifactCacheDecision


        const enum ArtifactCacheWriterState of u8:
            Available
            Held
            Published
            Aborted


        const enum ArtifactCacheWriterEvent of u8:
            Acquire
            Publish
            Abort


        struct ArtifactCacheWriterLease:
            state: ArtifactCacheWriterState = ArtifactCacheWriterState.Available
            owner_token: u64 = 0


        const enum ArtifactCacheWriterLockState of u8:
            Available
            Held
            Released


        const enum ArtifactCacheWriterLockEvent of u8:
            Acquire
            Release


        struct ArtifactCacheWriterLock:
            state: ArtifactCacheWriterLockState = ArtifactCacheWriterLockState.Available
            owner_token: u64 = 0
            path: cstr = ""
            stream: FileStream = FileStream{handle: null, path: "", mode: FileStreamMode.AppendBinary, state: FileStreamState.Closed, byte_budget: 1}


    private:
        def artifact_cache_read_bounded_file(a: mutable Arena&, path: cstr) -> darray[u8] error[FileIoError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic]:
            raise FileIoError.ReadFailed(path) if not artifact_cache_path_terminated(path)
            size: i64 = try file_size(path)
            return [] if size == 0
            raise FileIoError.ReadFailed(path) if size < 0 or size.usize().i64() != size or size.usize() > ARTIFACT_CACHE_MAX_BYTES
            bytes: darray[u8] = try read_entire_file(a, path)
            raise FileIoError.ReadFailed(path) if bytes.count > ARTIFACT_CACHE_MAX_BYTES
            return bytes


        def artifact_cache_write_staging(staging_path: cstr, bytes: mutable darray[u8]&) -> void error[ArtifactCacheIoError, FileStreamError] can[Blocking.IO, Memory.Allocate, Memory.Release]:
            raise ArtifactCacheIoError.PathTooLong(staging_path) if not artifact_cache_path_terminated(staging_path)
            raise ArtifactCacheIoError.StagingWriteFailed(staging_path) if bytes.count == 0 or bytes.count > ARTIFACT_CACHE_MAX_BYTES or bytes.items == null
            stream: mutable FileStream = try file_stream_open(staging_path, FileStreamMode.WriteBinary, bytes.count)
            cleanup: mutable FileStreamCleanupGuard = file_stream_cleanup_begin()
            offset: mutable usize = 0
            while offset < bytes.count:
                remaining: usize = bytes.count - offset
                buffer: mutable u8& = bytes.items + offset
                catch file_stream_write_chunk(stream, buffer, remaining):
                    ok progress:
                        if progress.count == 0 or progress.count > remaining:
                            _ = file_stream_cleanup_abort(cleanup, stream)
                            _ = remove_file(staging_path)
                            raise ArtifactCacheIoError.StagingWriteFailed(staging_path)
                        offset <- offset + progress.count
                    error failure:
                        _ = file_stream_cleanup_abort(cleanup, stream)
                        _ = remove_file(staging_path)
                        raise failure
            catch file_stream_sync(stream):
                ok:
                    pass
                error failure:
                    _ = file_stream_cleanup_abort(cleanup, stream)
                    _ = remove_file(staging_path)
                    raise failure
            catch file_stream_cleanup_commit(cleanup, stream):
                ok:
                    pass
                error failure:
                    _ = remove_file(staging_path)
                    raise failure
            raise ArtifactCacheIoError.StagingWriteFailed(staging_path) if offset != bytes.count


        def artifact_cache_sync_directory(directory_path: cstr) -> bool error[ArtifactCacheIoError] can[Blocking.IO, Memory.Release]:
            raise ArtifactCacheIoError.PathTooLong(directory_path) if not artifact_cache_path_terminated(directory_path)
            directory: mutable heap void&? = elisascript_posix_opendir(directory_path)
            raise ArtifactCacheIoError.DirectorySyncFailed(directory_path) if directory == null
            opened: mutable heap void& = directory
            descriptor: int = elisascript_posix_dirfd(opened)
            sync_status: int = elisascript_posix_fsync(descriptor) if descriptor >= 0 else -1
            close_status: int = elisascript_posix_closedir(opened)
            raise ArtifactCacheIoError.DirectorySyncFailed(directory_path) if descriptor < 0 or sync_status != 0 or close_status != 0
            return true


        def artifact_cache_publish_file(staging_path: cstr, destination_path: cstr, bytes: mutable darray[u8]&, decision: ArtifactCacheDecision, directory_path: cstr = "") -> ArtifactCachePublication error[ArtifactCacheIoError, FileStreamError] can[Blocking.IO, Memory.Allocate, Memory.Release]:
            raise ArtifactCacheIoError.PathTooLong(staging_path) if not artifact_cache_path_terminated(staging_path)
            raise ArtifactCacheIoError.PathTooLong(destination_path) if not artifact_cache_path_terminated(destination_path)
            raise ArtifactCacheIoError.PathTooLong(directory_path) if directory_path != "" and not artifact_cache_path_terminated(directory_path)
            publication: ArtifactCachePublication = artifact_cache_stage(decision, bytes.count)
            raise ArtifactCacheIoError.NotAdmissible if publication.state != ArtifactCacheLifecycle.Staged
            catch artifact_cache_write_staging(staging_path, bytes):
                ok:
                    pass
                error failure:
                    _ = remove_file(staging_path)
                    raise failure
            if elisascript_posix_rename(staging_path.cast[u8&], destination_path.cast[u8&]) != 0:
                _ = remove_file(staging_path)
                raise ArtifactCacheIoError.PublishFailed(destination_path)
            if directory_path != "":
                catch artifact_cache_sync_directory(directory_path):
                    ok:
                        pass
                    error failure:
                        raise failure
            return artifact_cache_commit(publication)


    public:
        def classify_module_artifact_cache(bytes: darray[u8]&) -> ArtifactCacheDecision:
            status: ModuleArtifactEnvelopeStatus = module_artifact_envelope_status(bytes)
            return ArtifactCacheDecision{kind: ArtifactCacheKind.IrMetadata, admission: ArtifactCacheAdmission.NeedsMigration} if status == ModuleArtifactEnvelopeStatus.Legacy
            return ArtifactCacheDecision{kind: ArtifactCacheKind.IrMetadata, admission: ArtifactCacheAdmission.Invalid} if status == ModuleArtifactEnvelopeStatus.Invalid
            decoded: ModuleArtifactDecode = decode_module_artifact(bytes)
            return ArtifactCacheDecision{kind: ArtifactCacheKind.IrMetadata, admission: ArtifactCacheAdmission.Invalid} if not decoded.valid
            return ArtifactCacheDecision{kind: ArtifactCacheKind.IrMetadata, admission: ArtifactCacheAdmission.Current, fingerprint: decoded.artifact.fingerprint}


        def classify_bytecode_artifact_cache(bytes: darray[u8]&) -> ArtifactCacheDecision:
            status: BytecodeArtifactEnvelopeStatus = bytecode_artifact_envelope_status(bytes)
            return ArtifactCacheDecision{kind: ArtifactCacheKind.BytecodeMetadata, admission: ArtifactCacheAdmission.NeedsMigration} if status == BytecodeArtifactEnvelopeStatus.Legacy
            return ArtifactCacheDecision{kind: ArtifactCacheKind.BytecodeMetadata, admission: ArtifactCacheAdmission.Invalid} if status == BytecodeArtifactEnvelopeStatus.Invalid
            decoded: BytecodeArtifactDecode = decode_bytecode_artifact(bytes)
            return ArtifactCacheDecision{kind: ArtifactCacheKind.BytecodeMetadata, admission: ArtifactCacheAdmission.Invalid} if not decoded.valid
            return ArtifactCacheDecision{kind: ArtifactCacheKind.BytecodeMetadata, admission: ArtifactCacheAdmission.Current, fingerprint: decoded.artifact.module_fingerprint}


        def load_module_artifact_file(a: mutable Arena&, path: cstr) -> ArtifactCacheLoad error[FileIoError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic]:
            bytes: darray[u8] = try artifact_cache_read_bounded_file(a, path)
            return ArtifactCacheLoad{bytes: bytes, decision: classify_module_artifact_cache(bytes)}


        def load_bytecode_artifact_file(a: mutable Arena&, path: cstr) -> ArtifactCacheLoad error[FileIoError] can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic]:
            bytes: darray[u8] = try artifact_cache_read_bounded_file(a, path)
            return ArtifactCacheLoad{bytes: bytes, decision: classify_bytecode_artifact_cache(bytes)}


        def publish_module_artifact_file(staging_path: cstr, destination_path: cstr, bytes: mutable darray[u8]&, directory_path: cstr = "") -> ArtifactCachePublication error[ArtifactCacheIoError, FileStreamError] can[Blocking.IO, Memory.Allocate, Memory.Release]:
            return try artifact_cache_publish_file(staging_path, destination_path, bytes, classify_module_artifact_cache(bytes), directory_path)


        def publish_bytecode_artifact_file(staging_path: cstr, destination_path: cstr, bytes: mutable darray[u8]&, directory_path: cstr = "") -> ArtifactCachePublication error[ArtifactCacheIoError, FileStreamError] can[Blocking.IO, Memory.Allocate, Memory.Release]:
            return try artifact_cache_publish_file(staging_path, destination_path, bytes, classify_bytecode_artifact_cache(bytes), directory_path)


        # This is an ownership admission contract, not a replacement for an
        # OS lock.  A host adapter must hold one nonzero token while it stages
        # and publishes; stale or competing tokens fail closed.
        def artifact_cache_writer_transition(state: ArtifactCacheWriterState, event: ArtifactCacheWriterEvent) -> ArtifactCacheWriterState:
            return ArtifactCacheWriterState.Held if state == ArtifactCacheWriterState.Available and event == ArtifactCacheWriterEvent.Acquire
            return ArtifactCacheWriterState.Published if state == ArtifactCacheWriterState.Held and event == ArtifactCacheWriterEvent.Publish
            return ArtifactCacheWriterState.Aborted if state == ArtifactCacheWriterState.Held and event == ArtifactCacheWriterEvent.Abort
            return ArtifactCacheWriterState.Held if state == ArtifactCacheWriterState.Aborted and event == ArtifactCacheWriterEvent.Acquire
            return state


        def artifact_cache_writer_acquire(lease: mutable ArtifactCacheWriterLease&, owner_token: u64) -> bool:
            return false if owner_token == 0 or (lease.state != ArtifactCacheWriterState.Available and lease.state != ArtifactCacheWriterState.Aborted)
            lease.state <- artifact_cache_writer_transition(lease.state, ArtifactCacheWriterEvent.Acquire)
            lease.owner_token <- owner_token
            return true


        def artifact_cache_writer_publish(lease: mutable ArtifactCacheWriterLease&, owner_token: u64) -> bool:
            return false if owner_token == 0 or lease.state != ArtifactCacheWriterState.Held or lease.owner_token != owner_token
            lease.state <- artifact_cache_writer_transition(lease.state, ArtifactCacheWriterEvent.Publish)
            return true


        def artifact_cache_writer_abort(lease: mutable ArtifactCacheWriterLease&, owner_token: u64) -> bool:
            return false if owner_token == 0 or lease.state != ArtifactCacheWriterState.Held or lease.owner_token != owner_token
            lease.state <- artifact_cache_writer_transition(lease.state, ArtifactCacheWriterEvent.Abort)
            lease.owner_token <- 0
            return true


        # POSIX hosts may opt into an actual nonblocking advisory lock. The
        # portable owner-token lease remains the admission contract; this edge
        # supplies host arbitration without exposing flock or FILE* to callers.
        def artifact_cache_writer_lock_transition(state: ArtifactCacheWriterLockState, event: ArtifactCacheWriterLockEvent) -> ArtifactCacheWriterLockState:
            return ArtifactCacheWriterLockState.Held if (state == ArtifactCacheWriterLockState.Available or state == ArtifactCacheWriterLockState.Released) and event == ArtifactCacheWriterLockEvent.Acquire
            return ArtifactCacheWriterLockState.Released if state == ArtifactCacheWriterLockState.Held and event == ArtifactCacheWriterLockEvent.Release
            return state


        def artifact_cache_writer_lock_acquire(lock: mutable ArtifactCacheWriterLock&, path: cstr, owner_token: u64) -> bool error[ArtifactCacheIoError, FileStreamError] can[Blocking.IO, Memory.Allocate, Memory.Release]:
            raise ArtifactCacheIoError.PathTooLong(path) if not artifact_cache_path_terminated(path)
            raise ArtifactCacheIoError.LockFailed(path) if owner_token == 0 or (lock.state != ArtifactCacheWriterLockState.Available and lock.state != ArtifactCacheWriterLockState.Released)
            lock.stream <- try file_stream_open(path, FileStreamMode.AppendBinary, 1)
            handle: mutable heap void& = lock.stream.handle
            descriptor: int = elisascript_posix_fileno(handle)
            if descriptor < 0 or elisascript_posix_flock(descriptor, ELISASCRIPT_POSIX_LOCK_EXCLUSIVE + ELISASCRIPT_POSIX_LOCK_NONBLOCK) != 0:
                _ = file_stream_close(lock.stream)
                raise ArtifactCacheIoError.LockFailed(path)
            lock.state <- artifact_cache_writer_lock_transition(lock.state, ArtifactCacheWriterLockEvent.Acquire)
            lock.owner_token <- owner_token
            lock.path <- path
            return true


        def artifact_cache_writer_lock_release(lock: mutable ArtifactCacheWriterLock&, owner_token: u64) -> bool error[FileStreamError] can[Blocking.IO, Memory.Release]:
            return false if owner_token == 0 or lock.state != ArtifactCacheWriterLockState.Held or lock.owner_token != owner_token
            catch file_stream_close(lock.stream):
                ok:
                    lock.state <- artifact_cache_writer_lock_transition(lock.state, ArtifactCacheWriterLockEvent.Release)
                    lock.owner_token <- 0
                    return true
                error failure:
                    lock.state <- artifact_cache_writer_lock_transition(lock.state, ArtifactCacheWriterLockEvent.Release)
                    lock.owner_token <- 0
                    raise failure


    private:
        # Keep the host lock held across the complete staged-write, rename, and
        # optional parent-directory sync sequence.  A publication failure still
        # reports its original cause after best-effort lock cleanup; a successful
        # publication treats a failed or stale release as a lock error.
        def artifact_cache_publish_locked(lock: mutable ArtifactCacheWriterLock&, lock_path: cstr, owner_token: u64, staging_path: cstr, destination_path: cstr, bytes: mutable darray[u8]&, decision: ArtifactCacheDecision, directory_path: cstr = "") -> ArtifactCachePublication error[ArtifactCacheIoError, FileStreamError] can[Blocking.IO, Memory.Allocate, Memory.Release]:
            _ = try artifact_cache_writer_lock_acquire(lock, lock_path, owner_token)
            catch artifact_cache_publish_file(staging_path, destination_path, bytes, decision, directory_path):
                ok publication:
                    released: bool = false
                    catch artifact_cache_writer_lock_release(lock, owner_token):
                        ok status:
                            released <- status
                        error failure:
                            raise failure
                    raise ArtifactCacheIoError.LockFailed(lock_path) if not released
                    return publication
                error failure:
                    catch artifact_cache_writer_lock_release(lock, owner_token):
                        ok:
                            pass
                        error release_failure:
                            pass
                    raise failure


    public:
        def publish_module_artifact_file_locked(lock: mutable ArtifactCacheWriterLock&, lock_path: cstr, owner_token: u64, staging_path: cstr, destination_path: cstr, bytes: mutable darray[u8]&, directory_path: cstr = "") -> ArtifactCachePublication error[ArtifactCacheIoError, FileStreamError] can[Blocking.IO, Memory.Allocate, Memory.Release]:
            return try artifact_cache_publish_locked(lock, lock_path, owner_token, staging_path, destination_path, bytes, classify_module_artifact_cache(bytes), directory_path)


        def publish_bytecode_artifact_file_locked(lock: mutable ArtifactCacheWriterLock&, lock_path: cstr, owner_token: u64, staging_path: cstr, destination_path: cstr, bytes: mutable darray[u8]&, directory_path: cstr = "") -> ArtifactCachePublication error[ArtifactCacheIoError, FileStreamError] can[Blocking.IO, Memory.Allocate, Memory.Release]:
            return try artifact_cache_publish_locked(lock, lock_path, owner_token, staging_path, destination_path, bytes, classify_bytecode_artifact_cache(bytes), directory_path)


    public:
        def artifact_cache_decision_valid(decision: ArtifactCacheDecision&) -> bool:
            return decision.admission in {ArtifactCacheAdmission.Current, ArtifactCacheAdmission.NeedsMigration} and decision.kind in {ArtifactCacheKind.IrMetadata, ArtifactCacheKind.BytecodeMetadata}


        # A cache publication is a small state machine.  Invalid transitions
        # fail closed to Rejected; a restart never turns staged bytes into a
        # committed entry without an observed commit marker.
        def artifact_cache_lifecycle_transition(state: ArtifactCacheLifecycle, event: ArtifactCacheEvent) -> ArtifactCacheLifecycle:
            return ArtifactCacheLifecycle.Staged if state == ArtifactCacheLifecycle.Empty and event == ArtifactCacheEvent.Stage
            return ArtifactCacheLifecycle.Committed if state == ArtifactCacheLifecycle.Staged and event == ArtifactCacheEvent.Commit
            return ArtifactCacheLifecycle.Rejected if state == ArtifactCacheLifecycle.Staged and event == ArtifactCacheEvent.Abort
            return ArtifactCacheLifecycle.Committed if state == ArtifactCacheLifecycle.Committed and event == ArtifactCacheEvent.Restart
            return ArtifactCacheLifecycle.Empty if state == ArtifactCacheLifecycle.Empty and event == ArtifactCacheEvent.Restart
            return ArtifactCacheLifecycle.Rejected


        def artifact_cache_stage(decision: ArtifactCacheDecision&, bytes_count: usize) -> ArtifactCachePublication:
            return ArtifactCachePublication{state: ArtifactCacheLifecycle.Rejected, bytes_count: bytes_count, fingerprint: decision.fingerprint} if not artifact_cache_decision_valid(decision) or decision.admission != ArtifactCacheAdmission.Current or bytes_count == 0 or bytes_count > ARTIFACT_CACHE_MAX_BYTES
            return ArtifactCachePublication{state: ArtifactCacheLifecycle.Staged, bytes_count: bytes_count, fingerprint: decision.fingerprint}


        def artifact_cache_commit(publication: ArtifactCachePublication&) -> ArtifactCachePublication:
            return ArtifactCachePublication{state: artifact_cache_lifecycle_transition(publication.state, ArtifactCacheEvent.Commit), bytes_count: publication.bytes_count, fingerprint: publication.fingerprint}


        def artifact_cache_abort(publication: ArtifactCachePublication&) -> ArtifactCachePublication:
            return ArtifactCachePublication{state: artifact_cache_lifecycle_transition(publication.state, ArtifactCacheEvent.Abort), bytes_count: publication.bytes_count, fingerprint: publication.fingerprint}


        def artifact_cache_restart(publication: ArtifactCachePublication&) -> ArtifactCachePublication:
            return ArtifactCachePublication{state: artifact_cache_lifecycle_transition(publication.state, ArtifactCacheEvent.Restart), bytes_count: publication.bytes_count, fingerprint: publication.fingerprint}
