# File-backed `.elisascript` source boundary.
#
# The byte-oriented loader in source.elisa is the canonical parser pipeline. This
# adapter only owns the file bytes and forwards them to that pipeline, keeping the
# resulting IR's source text views alive in permanent runtime storage.

extend EsIr:
    private:
        # stdio may return a positive short read even when the caller knows the
        # exact file size. Continue from the advanced offset, but fail closed on
        # zero progress, an impossible over-count, or a sticky host error so a
        # truncated/racing file cannot publish a partial source buffer.
        def elisascript_read_stream_fully(stream: heap void&, data: mutable u8&, length: usize) -> usize can[Blocking.IO]:
            offset: mutable usize = 0
            while offset < length:
                remaining: usize = length - offset
                buffer: mutable u8& = &data[offset]
                amount: usize = fread(buffer.cast[mutable void&], 1, remaining, stream)
                return offset if amount == 0 or amount > remaining or ferror(stream) != 0
                offset <- offset + amount
            return offset

    public:
        # Read, validate, and lower one `.elisascript` path with caller-supplied
        # dynamic handlers. The filename is copied into permanent storage as
        # well because source spans retain it. Diagnostic callers receive only
        # region-independent parser/semantic coordinates and lowering facts.
        def lower_elisascript_file_with_handlers_diagnostic(filename: u8&, module_name: sview, handlers: darray[Handler]&, source_diagnostic: mutable ElisascriptSourceDiagnosticSummary&, lower_issue: mutable ElisascriptLowerIssueSummary&) -> Module error[ElisascriptSourceError] can[Memory.Allocate, Abort.Panic]:
            source_diagnostic.parse_known <- false
            source_diagnostic.semantic_known <- false
            source_diagnostic.line <- 0
            source_diagnostic.column <- 0
            source_diagnostic.end_line <- 0
            source_diagnostic.end_column <- 0
            source_diagnostic.payload_hash <- 0
            source_diagnostic.payload_context <- []
            source_diagnostic.payload_name <- []
            source_diagnostic.payload_expected <- []
            source_diagnostic.payload_actual <- []
            source_diagnostic.payload_detail <- []
            source_diagnostic.payload_detail2 <- []
            source_diagnostic.payload_detail3 <- []
            source_diagnostic.payload_excerpt <- []
            source_diagnostic.payload_expected_count <- 0
            source_diagnostic.payload_actual_count <- 0
            source_diagnostic.payload_truncated <- false
            lower_issue.known <- false
            lower_issue.kind <- LowerIssueKind.TypeMismatch
            lower_issue.line <- 0
            try elisascript_source_validate_extension(filename)
            filename_length: usize = try elisascript_source_filename_length(filename)
            path: mutable dstr = ctx_fstr_alloc(filename_length + 1)
            if path.items == null:
                raise ElisascriptSourceError.FileIo
            ctx_fstr_append(path, filename, filename_length)
            ctx_fstr_append(path, "\0", 1)
            path_items: mutable u8& = path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                handle: mutable heap void&? = fopen(path_items, "rb")
                if handle == null:
                    raise ElisascriptSourceError.FileIo
                stream: mutable heap void& = handle
                if fseek(stream, 0, FILEIO_SEEK_END) != 0:
                    _ = fclose(stream)
                    raise ElisascriptSourceError.FileIo
                size: i64 = ftell(stream)
                if size < 0 or fseek(stream, 0, FILEIO_SEEK_SET) != 0:
                    _ = fclose(stream)
                    raise ElisascriptSourceError.FileIo
                if size > SourceLimits::SOURCE_BYTES.i64():
                    _ = fclose(stream)
                    raise ElisascriptSourceError.SourceTooLarge
                source: mutable dstr = ctx_fstr_alloc(size.usize() + 1)
                if source.items == null:
                    _ = fclose(stream)
                    raise ElisascriptSourceError.FileIo
                source_items: mutable u8& = source.items
                read_count: usize = elisascript_read_stream_fully(stream, source_items, size.usize()) if size > 0 else 0
                close_status: int = fclose(stream)
                if read_count != size.usize() or close_status != 0:
                    raise ElisascriptSourceError.FileIo
                source.count <- size.usize()
                raise ElisascriptSourceError.EmbeddedNul if elisascript_source_bytes_have_nul(source_items, size.usize())
                ctx_fstr_append(source, "\0", 1)
                return try lower_elisascript_source_buffer_with_handlers_diagnostic(path_items, source_items, module_name, handlers, source_diagnostic, lower_issue)


        # Ordinary file callers retain the existing compact API and typed error
        # row; only the phase-aware launcher needs the primitive issue summary.
        def lower_elisascript_file_with_handlers(filename: u8&, module_name: sview, handlers: darray[Handler]&) -> Module error[ElisascriptSourceError] can[Memory.Allocate, Abort.Panic]:
            source_diagnostic: mutable ElisascriptSourceDiagnosticSummary = ElisascriptSourceDiagnosticSummary{}
            lower_issue: mutable ElisascriptLowerIssueSummary = ElisascriptLowerIssueSummary{}
            return lower_elisascript_file_with_handlers_diagnostic(filename, module_name, handlers, source_diagnostic, lower_issue)


        # File loading without dynamic handlers remains the compact default.
        def lower_elisascript_file(filename: u8&, module_name: sview) -> Module error[ElisascriptSourceError] can[Memory.Allocate, Abort.Panic]:
            handlers: darray[Handler] = []
            return lower_elisascript_file_with_handlers(filename, module_name, handlers)
