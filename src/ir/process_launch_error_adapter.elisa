# Private publication helper; include only AFTER interpret.elisa defines Machine.
# No default facade includes this. No native operation occurs in this helper.
include "process_launch_payload_model.elisa"
include "process_spawn_session_storage.elisa"

extend EsIr:
    private:
        def publish_session_launch_failure(machine: mutable Machine&, runtime_storage: mutable darray[RuntimeValue]&, session: PreparedSpawnSession&, prepared: EsProcessLaunchStorage::Prepared&) -> void can[Memory.Allocate, Abort.Panic]:
            # Only this invocation's generic Process failure may be replaced.
            # Panic and other failures cannot turn into recoverable variants.
            if machine.failure != InterpretFailure.Process or machine.failure_family != "" or machine.failure_operation != "" or machine.failure_operation_id != 0:
                interpret_set_failure(machine, InterpretFailure.Panic)
                return
            diagnostic: EsProcessLaunchDiagnostic::Snapshot = try snapshot_session_launch_diagnostic(session, prepared) else failure:
                interpret_set_failure(machine, InterpretFailure.Panic)
                return
            payloads: darray[RuntimeValue] = try EsProcessLaunchPayload::encode(diagnostic, runtime_storage) else failure:
                interpret_set_failure(machine, InterpretFailure.Panic)
                return
            # Payloads left by an earlier handled named error are replaced, not
            # appended. The validated local payload is complete before identity
            # publication. Its array indices live in the enclosing run's pool.
            machine.failure_payloads <- payloads
            machine.failure_family <- EsProcessLaunchPayload::Schema::FAMILY
            machine.failure_operation <- EsProcessLaunchPayload::Schema::OPERATION
            machine.failure_operation_id <- effect_operation_identity(EsProcessLaunchPayload::Schema::FAMILY, EsProcessLaunchPayload::Schema::OPERATION)
            interpret_set_failure(machine, InterpretFailure.Raised)
