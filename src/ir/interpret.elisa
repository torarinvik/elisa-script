        def process_input_next(writer: mutable ProcessInputWriter&) -> ProcessInputState:
            return ProcessInputState.Done if writer.offset >= writer.length
            remaining: usize = writer.length - writer.offset
            buffer: mutable u8& = writer.data + writer.offset
            can Blocking.IO:
                amount: usize = fwrite(buffer.cast[void&], 1, remaining, writer.stream)
                if amount == 0:
                    writer.failed <- true
                    return ProcessInputState.Error
                writer.offset <- writer.offset + amount
                return ProcessInputState.Done if writer.offset >= writer.length
                return ProcessInputState.Progress


        def process_wait_next(waiter: mutable ProcessWaiter&) -> ProcessWaitState can[Blocking.IO]:
            waited: int = elisascript_posix_waitpid(waiter.pid, waiter.status, 0)
            if waited != waiter.pid:
                waiter.failed <- true
                return ProcessWaitState.Error
            return ProcessWaitState.Exited


        def read_process_output(machine: mutable Machine&, stream: heap void&) -> sview can[Blocking.IO, Memory.Allocate, Memory.Release]:
            if fseek(stream, 0, FILEIO_SEEK_END) != 0:
                machine.failure <- InterpretFailure.Process
                _ = fclose(stream)
                return ""
            size: i64 = ftell(stream)
            if size < 0 or fseek(stream, 0, FILEIO_SEEK_SET) != 0:
                machine.failure <- InterpretFailure.Process
                _ = fclose(stream)
                return ""
            if size == 0:
                close_status: int = fclose(stream)
                if close_status != 0:
                    machine.failure <- InterpretFailure.Process
                    return ""
                return ""
            bytes: mutable dstr = ctx_fstr_alloc(size.usize())
            if bytes.items == null:
                machine.failure <- InterpretFailure.Process
                _ = fclose(stream)
                return ""
            byte_items: mutable u8& = bytes.items
            read_count: usize = fread(byte_items.cast[mutable void&], 1, size.usize(), stream)
            close_status: int = fclose(stream)
            if read_count != size.usize() or close_status != 0:
                machine.failure <- InterpretFailure.Process
                return ""
            bytes.count <- size.usize()
            return bytes_view(bytes)


        def evaluate_capture_process_result(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, executable: RuntimeValue, arguments: RuntimeValue, input: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if executable.kind != RuntimeValueKind.Text or arguments.kind != RuntimeValueKind.Array or input.kind != RuntimeValueKind.Text or text_has_nul(executable.text):
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if not runtime_array_range_valid(storage, arguments):
                machine.failure <- InterpretFailure.IndexOutOfBounds
                return runtime_void()
            executable_bytes: dstr = nul_terminated_text(executable.text)
            if executable_bytes.items == null:
                machine.failure <- InterpretFailure.Process
                return runtime_void()
            executable_items: u8& = executable_bytes.items
            owned_arguments: mutable darray[dstr] = []
            argv: mutable darray[cstr] = []
            owned_arguments.reserve(arguments.array_count.usize())
            argv.reserve(arguments.array_count.usize() + 2)
            argv.push(executable_items.cast[cstr])
            for offset in 0..<arguments.array_count.usize() |machine, storage, arguments, owned_arguments, argv|:
                argument: RuntimeValue = storage[arguments.array_start.usize() + offset]
                if argument.kind != RuntimeValueKind.Text or text_has_nul(argument.text):
                    machine.failure <- InterpretFailure.TypeMismatch
                    return runtime_void()
                argument_bytes: dstr = nul_terminated_text(argument.text)
                if argument_bytes.items == null:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                owned_arguments.push(argument_bytes)
                argument_storage: mutable u8&? = owned_arguments[owned_arguments.count - 1].items
                if argument_storage == null:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                argument_items: mutable u8& = argument_storage
                argv.push(argument_items.cast[cstr])
            argv.push(executable_items.cast[cstr])
            if argv.items == null:
                machine.failure <- InterpretFailure.Process
                return runtime_void()
            terminator: mutable void& = (&argv[argv.count - 1]).cast[mutable void&] can Unsafe.PointerCast
            _ = memset(terminator, 0, 8)
            argv_items: void& = argv.items.cast[void&] can Unsafe.PointerCast
            can Blocking.IO, Memory.Allocate, Memory.Release:
                input_handle: mutable heap void&? = elisascript_posix_tmpfile()
                if input_handle == null:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                input_stream: mutable heap void& = input_handle
                input_descriptor: int = elisascript_posix_fileno(input_stream)
                if input_descriptor < 0:
                    _ = fclose(input_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                input_writer: mutable ProcessInputWriter = ProcessInputWriter{stream: input_stream, data: input.text.data, length: sview_len(input.text), offset: 0, failed: false}
                machine over process_input_next(input_writer):
                    state Write
                    start Write

                    Write, ProcessInputState.Progress:
                        -> Write
                    Write, ProcessInputState.Done:
                        break
                    Write, ProcessInputState.Error:
                        break
                if input_writer.failed or fseek(input_stream, 0, FILEIO_SEEK_SET) != 0:
                    _ = fclose(input_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                stdout_handle: mutable heap void&? = elisascript_posix_tmpfile()
                if stdout_handle == null:
                    _ = fclose(input_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                stdout_stream: mutable heap void& = stdout_handle
                stdout_descriptor: int = elisascript_posix_fileno(stdout_stream)
                if stdout_descriptor < 0:
                    _ = fclose(input_stream)
                    _ = fclose(stdout_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                stderr_handle: mutable heap void&? = elisascript_posix_tmpfile()
                if stderr_handle == null:
                    _ = fclose(input_stream)
                    _ = fclose(stdout_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                stderr_stream: mutable heap void& = stderr_handle
                stderr_descriptor: int = elisascript_posix_fileno(stderr_stream)
                if stderr_descriptor < 0:
                    _ = fclose(input_stream)
                    _ = fclose(stdout_stream)
                    _ = fclose(stderr_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                pid: int = elisascript_posix_fork()
                if pid < 0:
                    _ = fclose(input_stream)
                    _ = fclose(stdout_stream)
                    _ = fclose(stderr_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                if pid == 0:
                    elisascript_posix_exit(126) if elisascript_posix_dup2(input_descriptor, 0) < 0
                    elisascript_posix_exit(126) if elisascript_posix_dup2(stdout_descriptor, 1) < 0
                    elisascript_posix_exit(126) if elisascript_posix_dup2(stderr_descriptor, 2) < 0
                    _ = elisascript_posix_execvp(executable_items.cast[cstr], argv_items)
                    elisascript_posix_exit(127)
                    return runtime_void()
                waiter: mutable ProcessWaiter = ProcessWaiter{pid: pid, status: 0, failed: false}
                machine over process_wait_next(waiter):
                    state Wait
                    start Wait

                    Wait, ProcessWaitState.Exited:
                        break
                    Wait, ProcessWaitState.Error:
                        break
                input_close_status: int = fclose(input_stream)
                if waiter.failed or input_close_status != 0:
                    _ = fclose(stdout_stream)
                    _ = fclose(stderr_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                stdout_text: sview = read_process_output(machine, stdout_stream)
                if machine.failure != InterpretFailure.None:
                    _ = fclose(stderr_stream)
                    return runtime_void()
                stderr_text: sview = read_process_output(machine, stderr_stream)
                if machine.failure != InterpretFailure.None:
                    return runtime_void()
                signal_number: int = waiter.status & 0x7f
                exit_status: i64 = ((waiter.status >> 8) & 0xff).i64() if signal_number == 0 else (128 + signal_number).i64()
                return runtime_process_capture(exit_status, stdout_text, stderr_text)


        def evaluate_process_result_accessor(machine: mutable Machine&, capture: RuntimeValue, opcode: Opcode) -> RuntimeValue:
            if capture.kind != RuntimeValueKind.ProcessCapture:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            return runtime_int(capture.process_exit_status) if opcode == Opcode.ProcessResultExitStatus
            return runtime_text(capture.process_stdout) if opcode == Opcode.ProcessResultStdout
            return runtime_text(capture.process_stderr) if opcode == Opcode.ProcessResultStderr
            machine.failure <- InterpretFailure.UnsupportedInstruction
            return runtime_void()


