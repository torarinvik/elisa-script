                                timeout_micros: mutable u64 = ProcessWait::MAX_RUNTIME_MICROS
                                if instruction.operand_count == 3:
                                    timeout_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
