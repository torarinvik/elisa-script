                    Wait, ProcessWaitState.Error:
                        break
                if not process_resource_complete(machine, waiter):
                    _ = interpret_close_file(machine, input_stream)
                    _ = interpret_close_file(machine, stdout_stream)
                    _ = interpret_close_file(machine, stderr_stream)
                    return runtime_void()
                if waiter.output_exceeded:
                    _ = interpret_close_file(machine, input_stream)
