            machine: mutable Machine = Machine{steps: 0, step_limit: 1, resource_policy: runtime_resource_policy_default(), failure: InterpretFailure.None, continuations: [], resume_requested: false, resume_value: runtime_void()}
            machine.resource_policy.processes <- ES_RUNTIME_DEFAULT_MAX_PROCESSES
            machine.resource_policy.open_handles <- ES_RUNTIME_DEFAULT_MAX_OPEN_HANDLES
            value: RuntimeValue = evaluate_capture_process_result(machine, storage, runtime_text(executable), arguments, runtime_text(input), runtime_text(directory), runtime_void(), timeout_micros, output_limit_bytes)
            if machine.failure != InterpretFailure.None:
                try raise_interpret_failure(machine.failure)
            return value


