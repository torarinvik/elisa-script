                waiter: mutable ProcessWaiter = ProcessWaiter{pid: pid, group_ready: group_ready, status: 0, failed: false, stdout_stream: output_stream, output_limit: process_output_remaining(machine), timeout_micros: timeout_micros}
                machine over process_wait_next(waiter):
