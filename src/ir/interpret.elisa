        def capture_process_pipeline_value(storage: mutable darray[RuntimeValue]&, executables: RuntimeValue, arguments: RuntimeValue, input: sview, status_policy: EsProcess::ProcessPipelineStatusPolicy, output_used: mutable usize&, output_budget: usize = ES_RUNTIME_DEFAULT_MAX_OUTPUT_BYTES) -> RuntimeValue error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            # Intermediate stage output is not present in the final capture,
            # so a fresh default ledger here would let a pipeline exceed the
            # caller's aggregate output budget. Give every stage the same
            # remaining budget and charge each stage through that local policy.
            machine: mutable Machine = Machine{steps: 0, step_limit: 1, resource_policy: RuntimeResourcePolicy{output_bytes: output_budget}, process_output_limit: output_budget.u64(), failure: InterpretFailure.None, continuations: [], resume_requested: false, resume_value: runtime_void()}
            value: RuntimeValue = evaluate_capture_process_pipeline(machine, storage, executables, arguments, runtime_text(input), status_policy)
            output_used <- machine.resource_usage.output_bytes
            if machine.failure != InterpretFailure.None:
                try raise_interpret_failure(machine.failure)
            return value


