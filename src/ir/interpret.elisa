        def interpret_with_resource_policy(module: Module&, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, policy: RuntimeResourcePolicy, invocation_context: ScriptInvocationContext = ScriptInvocationContext{}) -> Execution error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            raise InterpretError.OutputLimit if not runtime_resource_policy_valid(policy)
            raise InterpretError.UnsupportedInstruction if runtime_resource_policy_has_unaccounted_dimensions(policy)
            raise InterpretError.OutputLimit if module.globals.count > ES_RUNTIME_DEFAULT_MAX_STORAGE_VALUES
            raise InterpretError.VerificationFailed if verify(module).count != 0
            function_index: usize = find_function(module, entry)
            raise InterpretError.UnknownFunction if function_index == module.functions.count
            machine: mutable Machine = Machine{steps: 0, step_limit: policy.steps, resource_policy: policy, resource_usage: RuntimeResourceUsage{}, invocation_context: invocation_context, process_output_limit: policy.output_bytes.u64(), failure: InterpretFailure.None, continuations: [], resume_requested: false, resume_value: runtime_void(), globals: []}
            for binding in module.globals |machine, storage|:
                machine.globals.push(global_value(binding, machine, storage))
            if machine.failure != InterpretFailure.None:
                try raise_interpret_failure(machine.failure)
            handler_stack: mutable darray[sview] = []
            value: RuntimeValue = execute_function(machine, observations, storage, handler_stack, module, function_index, arguments)
            if machine.failure != InterpretFailure.None:
                try raise_interpret_failure(machine.failure)
            machine.resource_usage.steps <- machine.steps
            machine.resource_usage.retained_traces <- observations.count
            raise InterpretError.OutputLimit if not runtime_resource_usage_within_policy(machine.resource_usage, machine.resource_policy)
            return Execution{value: value, steps: machine.steps, policy: machine.resource_policy, usage: machine.resource_usage, engine: ExecutionEngine.ReferenceInterpreter}


        # Compatibility entrypoint: callers that only provide a step limit get
        # the shared defaults for every other budget dimension.
        def interpret(module: Module&, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = ES_RUNTIME_DEFAULT_MAX_STEPS) -> Execution error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            policy: RuntimeResourcePolicy = runtime_resource_policy_with_step_limit(RuntimeResourcePolicy{}, step_limit)
            return interpret_with_resource_policy(module, entry, arguments, observations, storage, policy, ScriptInvocationContext{})
