                            arguments_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            input_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                            dispatch.value <- evaluate_capture_process_stream_with_stdin(machine, storage, executable_value, arguments_value, input_value, 1)
                            break

                        Dispatch, Opcode.CaptureProcessStderrWithStdin:
                            executable_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            arguments_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            input_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                            dispatch.value <- evaluate_capture_process_stream_with_stdin(machine, storage, executable_value, arguments_value, input_value, 2)
                            break

                        Dispatch, Opcode.CaptureProcessPipeline:
                            executables_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            arguments_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            input_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                            dispatch.value <- evaluate_capture_process_pipeline(machine, storage, executables_value, arguments_value, input_value)
                            break

                        Dispatch, Opcode.CaptureProcessResult:
                            executable_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            arguments_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            input_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                            dispatch.value <- evaluate_capture_process_result(machine, storage, executable_value, arguments_value, input_value, runtime_void(), runtime_void())
                            break

                        Dispatch, Opcode.CaptureProcessResultInDirectory:
                            executable_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            arguments_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            input_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                            directory_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 3], machine)
                            dispatch.value <- evaluate_capture_process_result(machine, storage, executable_value, arguments_value, input_value, directory_value, runtime_void())
                            break

                        Dispatch, Opcode.CaptureProcessResultWithEnvironment:
                            executable_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            arguments_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            input_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                            environment_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 3], machine)
