        def evaluate_path_real(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                found: mutable heap u8&? = elisascript_posix_realpath(path_items.cast[cstr], null)
                if found == null:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                found_items: mutable heap u8& = found
                too_large: mutable bool = false
                length: usize = host_path_cstring_length_bounded(found_items, too_large)
                if too_large or length == 0:
                    free(found_items.cast[heap void&])
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                bytes: mutable dstr = ctx_fstr_alloc(length)
                if bytes.items == null:
                    free(found_items.cast[heap void&])
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                ctx_fstr_append(bytes, found_items, length)
                free(found_items.cast[heap void&])
                return runtime_text(bytes_view(bytes))


        # Secure temporary paths are created directly through POSIX mkstemp/mkdtemp.
        # The returned Path is permanent, while the file descriptor from mkstemp is
        # closed before the operation succeeds; callers own cleanup through the
        # ordinary typed remove_path/remove_tree operations.
        def evaluate_create_temporary(machine: mutable Machine&, prefix: RuntimeValue, directory: bool, parent: RuntimeValue = runtime_text("/tmp")) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if prefix.kind != RuntimeValueKind.Text or parent.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if sview_len(prefix.text) > INTERPRET_MAX_TEMPORARY_PREFIX_BYTES:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            if text_has_nul(prefix.text) or sview_contains_byte(prefix.text, 47):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            spelling: sview = try EsTemporaryPath::template(parent.text, prefix.text) else err:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            template_length: usize = sview_len(spelling)
            template: mutable dstr = ctx_fstr_alloc(template_length + 1)
            if template.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            ctx_fstr_append(template, spelling.data, template_length)
            ctx_fstr_append(template, "\0", 1)
            template.count <- template_length
            template_items: mutable u8& = template.items
            if directory:
                can Blocking.IO, Memory.Allocate:
                    created: mutable u8&? = elisascript_posix_mkdtemp(template_items)
                    if created == null:
                        interpret_set_failure(machine, InterpretFailure.FileIo)
                        return runtime_void()
                return runtime_text(bytes_view(template))
            if not runtime_resource_acquire(machine.resource_usage, machine.resource_policy, RuntimeResourceCounter.OpenHandle):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            descriptor: mutable int = 0
            can Blocking.IO:
                descriptor <- elisascript_posix_mkstemp(template_items)
            if descriptor < 0:
                if not runtime_resource_release(machine.resource_usage, RuntimeResourceCounter.OpenHandle):
                    interpret_set_failure(machine, InterpretFailure.Panic)
                    return runtime_void()
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            close_status: mutable int = 0
            can Blocking.IO:
                close_status <- elisascript_posix_close(descriptor)
            if close_status != 0:
                can Blocking.IO:
                    _ = unlink(template_items)
                # POSIX close failure may leave descriptor state uncertain;
                # retain the lease and abort rather than admitting another
                # resource as if this descriptor were definitely gone.
                interpret_set_failure(machine, InterpretFailure.Panic)
                return runtime_void()
            if not runtime_resource_release(machine.resource_usage, RuntimeResourceCounter.OpenHandle):
                interpret_set_failure(machine, InterpretFailure.Panic)
                return runtime_void()
            return runtime_text(bytes_view(template))


        def evaluate_path_relative(machine: mutable Machine&, target: RuntimeValue, base: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if target.kind != RuntimeValueKind.Text or base.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_shape_text_valid(target.text) or not path_shape_text_valid(base.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            relative: dstr = Fs::relative(&perm_arena, target.text, base.text)
            if not path_shape_result_valid(bytes_view(relative)):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            return runtime_text(bytes_view(relative))


        # Sleep is deliberately expressed as a single semantic operation. The
        # POSIX bridge only accepts microseconds, so the interpreter chunks long
        # integer waits and fractional seconds into bounded calls. Invalid
        # (negative, NaN, or infinite) seconds are typed time failures rather
        # than silently truncating into an accidental host duration.
        def bounded_usleep(microseconds: u32) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while retries <= PosixRetry::EINTR_RETRIES:
                return true if elisascript_posix_usleep(microseconds) == 0
                errno: mutable int& = elisascript_posix_errno()
                return false if errno[0] != EsRuntime::DarwinErrno::EINTR
                retries <- retries + 1
            return false


        def evaluate_sleep(machine: mutable Machine&, duration: RuntimeValue, unit: i64) -> RuntimeValue:
            if unit != 0 and unit != 1:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if duration.kind == RuntimeValueKind.Int:
                if duration.integer < 0:
                    interpret_set_failure(machine, InterpretFailure.Time)
                    return runtime_void()
                remaining: mutable i64 = duration.integer
                if unit == 0:
                    while remaining > 0 |machine, remaining|:
                        slept: mutable bool = false
                        can Blocking.IO:
                            slept <- bounded_usleep(1000000u32)
                        if not slept:
                            interpret_set_failure(machine, InterpretFailure.Time)
                            return runtime_void()
                        remaining <- remaining - 1
                else:
                    while remaining > 0 |machine, remaining|:
                        chunk: i64 = 1000 if remaining > 1000 else remaining
                        slept: mutable bool = false
                        can Blocking.IO:
                            slept <- bounded_usleep((chunk * 1000).u32())
                        if not slept:
                            interpret_set_failure(machine, InterpretFailure.Time)
                            return runtime_void()
                        remaining <- remaining - chunk
                return runtime_void()
            if duration.kind != RuntimeValueKind.Float or unit != 0:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if duration.decimal != duration.decimal or duration.decimal < 0.0 or duration.decimal > 9223372036854.0:
                interpret_set_failure(machine, InterpretFailure.Time)
                return runtime_void()
            remaining_seconds: mutable f64 = duration.decimal
            while remaining_seconds > 0.0 |machine, remaining_seconds|:
                chunk_seconds: f64 = 1.0 if remaining_seconds > 1.0 else remaining_seconds
                microseconds: mutable u32 = (chunk_seconds * 1000000.0).u32()
                microseconds <- 1u32 if microseconds == 0u32
                slept: mutable bool = false
                can Blocking.IO:
                    slept <- bounded_usleep(microseconds)
                if not slept:
                    interpret_set_failure(machine, InterpretFailure.Time)
                    return runtime_void()
                remaining_seconds <- remaining_seconds - chunk_seconds
            return runtime_void()


        def evaluate_run_process(machine: mutable Machine&, storage: darray[RuntimeValue]&, executable: RuntimeValue, arguments: RuntimeValue, timeout_micros: u64 = ProcessWait::MAX_RUNTIME_MICROS) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if not process_timeout_admitted(machine, timeout_micros):
                return runtime_void()
            if executable.kind != RuntimeValueKind.Text or arguments.kind != RuntimeValueKind.Array:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not process_text_length_fits(machine, executable.text):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if text_has_nul(executable.text):
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if sview_len(executable.text) == 0:
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if not runtime_array_range_valid(storage, arguments):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if not process_argument_count_fits(machine, arguments):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if not process_argument_bytes_fits(machine, storage, executable, arguments):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            executable_bytes: dstr = nul_terminated_text(executable.text)
            if executable_bytes.items == null:
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            executable_items: u8& = executable_bytes.items
            owned_arguments: mutable darray[dstr] = []
            argv: mutable darray[cstr] = []
            owned_arguments.reserve(arguments.array_count.usize())
            argv.reserve(arguments.array_count.usize())
            argv.push(executable_items.cast[cstr])
            for offset in 0..<arguments.array_count.usize() |machine, storage, arguments, owned_arguments, argv|:
                argument: RuntimeValue = storage[arguments.array_start.usize() + offset]
                if argument.kind != RuntimeValueKind.Text:
                    interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                    return runtime_void()
                if not process_text_length_fits(machine, argument.text):
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                if text_has_nul(argument.text):
                    interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                    return runtime_void()
                argument_bytes: dstr = nul_terminated_text(argument.text)
                if argument_bytes.items == null:
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                owned_arguments.push(argument_bytes)
                argument_storage: mutable u8&? = owned_arguments[owned_arguments.count - 1].items
                if argument_storage == null:
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                argument_items: mutable u8& = argument_storage
                argv.push(argument_items.cast[cstr])
            argv.push(executable_items.cast[cstr])
            if argv.items == null:
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            terminator: mutable void& = (&argv[argv.count - 1]).cast[mutable void&] can Unsafe.PointerCast
            _ = memset(terminator, 0, size_of(uintptr))
            argv_items: void& = argv.items.cast[void&] can Unsafe.PointerCast
            can Blocking.IO:
                if not process_resource_acquire(machine):
                    return runtime_void()
                pid: int = elisascript_posix_fork()
                if pid < 0:
                    process_resource_release(machine)
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                if pid == 0:
                    # Give each launched job its own group so timeout cleanup can
                    # terminate descendants without affecting the interpreter.
                    elisascript_posix_exit(126) if not process_setpgid_child()
                    _ = elisascript_posix_execvp(executable_items.cast[cstr], argv_items)
                    elisascript_posix_exit(127)
                    return runtime_void()
                group_ready: bool = process_setpgid_parent(pid)
                waiter: mutable ProcessWaiter = ProcessWaiter{pid: pid, group_ready: group_ready, status: 0, failed: false, timeout_micros: timeout_micros}
                machine over process_wait_next(waiter):
                    state Wait
                    start Wait

                    Wait, ProcessWaitState.Progress:
                        -> Wait
                    Wait, ProcessWaitState.Exited:
                        break
                    Wait, ProcessWaitState.Error:
                        break
                if not process_resource_complete(machine, waiter):
                    return runtime_void()
                if waiter.timed_out:
                    interpret_set_failure(machine, InterpretFailure.Time)
                    return runtime_void()
                if waiter.failed:
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                signal_number: int = waiter.status & 0x7f
                return runtime_int(((waiter.status >> 8) & 0xff).i64()) if signal_number == 0
                return runtime_int((128 + signal_number).i64())


        def evaluate_capture_process_stream(machine: mutable Machine&, storage: darray[RuntimeValue]&, executable: RuntimeValue, arguments: RuntimeValue, output_fd: int, timeout_micros: u64 = ProcessWait::MAX_RUNTIME_MICROS) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if not process_timeout_admitted(machine, timeout_micros):
                return runtime_void()
            if executable.kind != RuntimeValueKind.Text or arguments.kind != RuntimeValueKind.Array:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not process_text_length_fits(machine, executable.text):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if text_has_nul(executable.text):
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if sview_len(executable.text) == 0:
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if not runtime_array_range_valid(storage, arguments):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if not process_argument_count_fits(machine, arguments):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if not process_argument_bytes_fits(machine, storage, executable, arguments):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            executable_bytes: dstr = nul_terminated_text(executable.text)
            if executable_bytes.items == null:
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            executable_items: u8& = executable_bytes.items
            owned_arguments: mutable darray[dstr] = []
            argv: mutable darray[cstr] = []
            owned_arguments.reserve(arguments.array_count.usize())
            argv.reserve(arguments.array_count.usize())
            argv.push(executable_items.cast[cstr])
            for offset in 0..<arguments.array_count.usize() |machine, storage, arguments, owned_arguments, argv|:
                argument: RuntimeValue = storage[arguments.array_start.usize() + offset]
                if argument.kind != RuntimeValueKind.Text:
                    interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                    return runtime_void()
                if not process_text_length_fits(machine, argument.text):
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                if text_has_nul(argument.text):
                    interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                    return runtime_void()
                argument_bytes: dstr = nul_terminated_text(argument.text)
                if argument_bytes.items == null:
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                owned_arguments.push(argument_bytes)
                argument_storage: mutable u8&? = owned_arguments[owned_arguments.count - 1].items
                if argument_storage == null:
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                argument_items: mutable u8& = argument_storage
                argv.push(argument_items.cast[cstr])
            argv.push(executable_items.cast[cstr])
            if argv.items == null:
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            terminator: mutable void& = (&argv[argv.count - 1]).cast[mutable void&] can Unsafe.PointerCast
            _ = memset(terminator, 0, size_of(uintptr))
            argv_items: void& = argv.items.cast[void&] can Unsafe.PointerCast
            can Blocking.IO, Memory.Allocate, Memory.Release:
                handle: mutable heap void&? = interpret_open_tmpfile(machine)
                if handle == null:
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                stream: mutable heap void& = handle
                descriptor: int = elisascript_posix_fileno(stream)
                if descriptor < 0:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                if not process_resource_acquire(machine):
                    _ = interpret_close_file(machine, stream)
                    return runtime_void()
                pid: int = elisascript_posix_fork()
                if pid < 0:
                    _ = interpret_close_file(machine, stream)
                    process_resource_release(machine)
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                if pid == 0:
                    elisascript_posix_exit(126) if not process_setpgid_child()
                    elisascript_posix_exit(126) if not process_dup2_child(descriptor, output_fd)
                    _ = elisascript_posix_execvp(executable_items.cast[cstr], argv_items)
                    elisascript_posix_exit(127)
                    return runtime_void()
                group_ready: bool = process_setpgid_parent(pid)
                waiter: mutable ProcessWaiter = ProcessWaiter{pid: pid, group_ready: group_ready, status: 0, failed: false, stdout_stream: stream, output_limit: process_output_remaining(machine), timeout_micros: timeout_micros}
                machine over process_wait_next(waiter):
                    state Wait
                    start Wait

                    Wait, ProcessWaitState.Progress:
                        -> Wait
                    Wait, ProcessWaitState.Exited:
                        break
                    Wait, ProcessWaitState.Error:
                        break
                if not process_resource_complete(machine, waiter):
                    _ = interpret_close_file(machine, stream)
                    return runtime_void()
                if waiter.output_exceeded:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                if waiter.timed_out:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.Time)
                    return runtime_void()
                if waiter.failed or fseek(stream, 0, FILEIO_SEEK_END) != 0:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                captured: sview = read_process_output(machine, stream)
                if machine.failure != InterpretFailure.None:
                    return runtime_void()
                return runtime_text(captured)


        def process_input_next(writer: mutable ProcessInputWriter&) -> ProcessInputState:
            return ProcessInputState.Done if writer.offset >= writer.length
            remaining: usize = writer.length - writer.offset
            buffer: mutable u8& = &writer.data[writer.offset]
            amount: mutable usize = 0
            can Blocking.IO:
                amount <- fwrite(buffer.cast[void&], 1, remaining, writer.stream)
            if amount == 0 or amount > remaining or ferror(writer.stream) != 0:
                writer.failed <- true
                return ProcessInputState.Error
            writer.offset <- writer.offset + amount
            return ProcessInputState.Done if writer.offset >= writer.length
            return ProcessInputState.Progress


        # stdio may accept a prefix of a requested file write. Continue from
        # the advanced byte offset so regular file and temporary-stream writes
        # preserve the exact payload instead of turning a recoverable short
        # write into silent truncation. A zero-byte progress report is the
        # terminal I/O failure and prevents an infinite retry loop.
        def write_stream_fully(stream: heap void&, data: u8&, length: usize) -> usize can[Blocking.IO]:
            offset: mutable usize = 0
            while offset < length:
                remaining: usize = length - offset
                buffer: mutable u8& = &data[offset]
                amount: usize = fwrite(buffer.cast[void&], 1, remaining, stream)
                return offset if amount == 0 or amount > remaining or ferror(stream) != 0
                offset <- offset + amount
            return offset


        # Exact-size stdio reads use the same bounded progress policy as writes.
        # A positive short read advances the offset and is retried; zero or an
        # impossible over-count is terminal so a truncated/racing file cannot
        # publish a partial value or spin forever.
        def read_stream_fully(stream: heap void&, data: mutable u8&, length: usize) -> usize can[Blocking.IO]:
            offset: mutable usize = 0
            while offset < length:
                remaining: usize = length - offset
                buffer: mutable u8& = &data[offset]
                amount: usize = fread(buffer.cast[mutable void&], 1, remaining, stream)
                return offset if amount == 0 or amount > remaining or ferror(stream) != 0
                offset <- offset + amount
            return offset


        def process_wait_signal(pid: int, signal: int) -> void can[Blocking.IO]:
            retries: mutable usize = 0
            while retries <= PosixRetry::EINTR_RETRIES:
                return if elisascript_posix_kill(pid, signal) == 0
                errno: mutable int& = elisascript_posix_errno()
                return if errno[0] != EsRuntime::DarwinErrno::EINTR
                retries <- retries + 1


        def process_setpgid_parent(pid: int) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while retries <= PosixRetry::EINTR_RETRIES:
                return true if elisascript_posix_setpgid(pid, pid) == 0
                errno: mutable int& = elisascript_posix_errno()
                return true if errno[0] == EsRuntime::DarwinErrno::EACCES
                return false if errno[0] != EsRuntime::DarwinErrno::EINTR
                retries <- retries + 1
            return false


        def process_dup2_child(source: int, destination: int) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while retries <= PosixRetry::EINTR_RETRIES:
                return true if elisascript_posix_dup2(source, destination) >= 0
                errno: mutable int& = elisascript_posix_errno()
                return false if errno[0] != EsRuntime::DarwinErrno::EINTR
                retries <- retries + 1
            return false


        def process_setpgid_child() -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while retries <= PosixRetry::EINTR_RETRIES:
                return true if elisascript_posix_setpgid(0, 0) == 0
                errno: mutable int& = elisascript_posix_errno()
                return false if errno[0] != EsRuntime::DarwinErrno::EINTR
                retries <- retries + 1
            return false


        def process_wait_grace_sleep() -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while retries <= PosixRetry::EINTR_RETRIES:
                return true if elisascript_posix_usleep(ProcessWait::POLL_MICROSECONDS) == 0
                errno: mutable int& = elisascript_posix_errno()
                return false if errno[0] != EsRuntime::DarwinErrno::EINTR
                retries <- retries + 1
            return false


        # Terminate and reap the private process group on every parent-side
        # wait failure. Give the child and its descendants a bounded
        # cooperative TERM window first, then force KILL and reap. The direct
        # PID covers the fork/setpgid race; the group signal handles
        # descendants only when group_ready was established by a successful
        # parent-side setpgid. Keeping this protocol in one helper prevents a
        # failed poll from stranding a child or zombie without ever signaling
        # an unrelated process group. Both signaling and the blocking reap
        # tolerate bounded EINTR interruptions.
        def process_wait_terminate(waiter: mutable ProcessWaiter&) -> void can[Blocking.IO]:
            if waiter.reaped:
                process_wait_terminate_group(waiter)
                return
            process_wait_signal(-waiter.pid, ProcessWait::SIGNAL_TERM) if waiter.group_ready
            process_wait_signal(waiter.pid, ProcessWait::SIGNAL_TERM)
            grace_polls: mutable u64 = 0
            leader_reaped: mutable bool = false
            while grace_polls < ProcessWait::TERM_GRACE_POLLS:
                waited: int = elisascript_posix_waitpid(waiter.pid, waiter.status, ProcessWait::NOHANG)
                if EsProcessSpawnWait::exact_reap(waited.i64(), waiter.pid.i64(), waiter.status.i64()):
                    leader_reaped <- true
                    waiter.reaped <- true
                    break
                if waited < 0:
                    errno: mutable int& = elisascript_posix_errno()
                    break if errno[0] != EsRuntime::DarwinErrno::EINTR
                break if not process_wait_grace_sleep()
                grace_polls <- grace_polls + 1
            process_wait_signal(-waiter.pid, ProcessWait::SIGNAL_KILL) if waiter.group_ready
            process_wait_signal(waiter.pid, ProcessWait::SIGNAL_KILL) if not leader_reaped
            return if leader_reaped
            retries: mutable usize = 0
            while retries <= PosixRetry::EINTR_RETRIES:
                waited: int = elisascript_posix_waitpid(waiter.pid, waiter.status, 0)
                if EsProcessSpawnWait::exact_reap(waited.i64(), waiter.pid.i64(), waiter.status.i64()):
                    waiter.reaped <- true
                    return
                if waited == waiter.pid:
                    # A traced stop/continue report is not terminal reaping.
                    # Recheck after KILL within the same bounded retry budget.
                    retries <- retries + 1
                    continue
                return if waited >= 0
                errno: mutable int& = elisascript_posix_errno()
                return if errno[0] != EsRuntime::DarwinErrno::EINTR
                retries <- retries + 1


        # The direct child may already have been reaped when the final output
        # sample discovers an overflow. Do not signal waiter.pid in that case:
        # the PID can be reused immediately after waitpid. The private group
        # remains the only safe cleanup target for descendants. Give them the
        # same bounded TERM window as the live-child path, then force KILL.
        def process_wait_terminate_group(waiter: ProcessWaiter&) -> void can[Blocking.IO]:
            return if not waiter.group_ready
            process_wait_signal(-waiter.pid, ProcessWait::SIGNAL_TERM)
            grace_polls: mutable u64 = 0
            while grace_polls < ProcessWait::TERM_GRACE_POLLS:
                break if not process_wait_grace_sleep()
                grace_polls <- grace_polls + 1
            process_wait_signal(-waiter.pid, ProcessWait::SIGNAL_KILL)


        # A reaped leader does not imply that a child which inherited the
        # temporary stdout/stderr descriptors has stopped.  Probe only the
        # confirmed private group; an unknown host error is treated as
        # "still present" so a capture is never published without a bounded
        # quiescence observation.
        def process_wait_group_has_members(pid: int) -> bool can[Blocking.IO]:
            retries: mutable usize = 0
            while retries <= PosixRetry::EINTR_RETRIES:
                return true if elisascript_posix_kill(-pid, 0) == 0
                errno: mutable int& = elisascript_posix_errno()
                return false if errno[0] == EsRuntime::DarwinErrno::ESRCH
                return true if errno[0] == EsRuntime::DarwinErrno::EACCES
                if errno[0] == EsRuntime::DarwinErrno::EINTR:
                    retries <- retries + 1
                    continue
                return true
            return true


        # Give short-lived descendants a bounded opportunity to close their
        # inherited descriptors.  A surviving group is handled by the caller
        # as a process failure and is terminated before any output is read.
        def process_wait_group_quiescent(pid: int) -> bool can[Blocking.IO]:
            polls: mutable u64 = 0
            while polls < ProcessWait::TERM_GRACE_POLLS:
                return true if not process_wait_group_has_members(pid)
                return false if not process_wait_grace_sleep()
                polls <- polls + 1
            return not process_wait_group_has_members(pid)


        def process_resource_acquire(machine: mutable Machine&) -> bool:
            if runtime_resource_acquire(machine.resource_usage, machine.resource_policy, RuntimeResourceCounter.Process):
                return true
            interpret_set_failure(machine, InterpretFailure.Process)
            return false


        # Short-lived interpreter file bridges use the same per-run handle
        # ledger as process-capture temporaries. Acquire before entering libc,
        # and roll back if the host open fails so a recoverable script error
        # never consumes capacity that was not actually acquired.
        def interpret_open_file(machine: mutable Machine&, path: u8&, mode: u8&) -> mutable heap void&? can[Blocking.IO, Memory.Allocate, Memory.Release]:
            if not runtime_resource_acquire(machine.resource_usage, machine.resource_policy, RuntimeResourceCounter.OpenHandle):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return null
            opened: mutable heap void&? = fopen(path, mode)
            if opened == null:
                if not runtime_resource_release(machine.resource_usage, RuntimeResourceCounter.OpenHandle):
                    interpret_set_failure(machine, InterpretFailure.Panic)
            return opened


        def interpret_open_tmpfile(machine: mutable Machine&) -> mutable heap void&? can[Blocking.IO, Memory.Allocate, Memory.Release]:
            if not runtime_resource_acquire(machine.resource_usage, machine.resource_policy, RuntimeResourceCounter.OpenHandle):
                interpret_set_failure(machine, InterpretFailure.Process)
                return null
            opened: mutable heap void&? = elisascript_posix_tmpfile()
            if opened == null:
                if not runtime_resource_release(machine.resource_usage, RuntimeResourceCounter.OpenHandle):
                    interpret_set_failure(machine, InterpretFailure.Panic)
            return opened


        # POSIX fclose releases the stream even when its final flush reports an
        # error. Retire the ledger slot after the close attempt, but fail closed
        # if the accounting edge itself proves that the stream was not leased.
        def interpret_close_file(machine: mutable Machine&, stream: heap void&) -> int can[Blocking.IO, Memory.Release]:
            close_status: int = fclose(stream)
            if not runtime_resource_release(machine.resource_usage, RuntimeResourceCounter.OpenHandle):
                interpret_set_failure(machine, InterpretFailure.Panic)
            return close_status


        def interpret_open_directory(machine: mutable Machine&, path: cstr) -> mutable heap void&? can[Blocking.IO, Memory.Allocate, Memory.Release]:
            if not runtime_resource_acquire(machine.resource_usage, machine.resource_policy, RuntimeResourceCounter.OpenHandle):
                interpret_set_failure(machine, InterpretFailure.Directory)
                return null
            opened: mutable heap void&? = elisascript_posix_opendir(path)
            if opened == null:
                if not runtime_resource_release(machine.resource_usage, RuntimeResourceCounter.OpenHandle):
                    interpret_set_failure(machine, InterpretFailure.Panic)
            return opened


        def interpret_close_directory(machine: mutable Machine&, directory: heap void&) -> int can[Blocking.IO, Memory.Release]:
            close_status: int = elisascript_posix_closedir(directory)
            if not runtime_resource_release(machine.resource_usage, RuntimeResourceCounter.OpenHandle):
                interpret_set_failure(machine, InterpretFailure.Panic)
            return close_status


        def process_resource_release(machine: mutable Machine&) -> void:
            if not runtime_resource_release(machine.resource_usage, RuntimeResourceCounter.Process):
                interpret_set_failure(machine, InterpretFailure.Process)


        def process_resource_complete(machine: mutable Machine&, waiter: ProcessWaiter&) -> bool:
            if not waiter.reaped:
                # Continuing through a recoverable Process error could let a
                # handler launch more children while this one may still live.
                interpret_set_failure(machine, InterpretFailure.Panic)
                return false
            if not runtime_resource_release(machine.resource_usage, RuntimeResourceCounter.Process):
                interpret_set_failure(machine, InterpretFailure.Panic)
                return false
            return true


        def process_output_remaining(machine: Machine&) -> u64:
            return 0 if machine.resource_usage.output_bytes >= machine.resource_policy.output_bytes
            return (machine.resource_policy.output_bytes - machine.resource_usage.output_bytes).u64()


        def process_timeout_admitted(machine: mutable Machine&, timeout_micros: u64) -> bool:
            if timeout_micros > EsProcess::PROCESS_COMMAND_MAX_TIMEOUT_MICROS:
                interpret_set_failure(machine, InterpretFailure.Process)
                return false
            return true


        def process_wait_stream_size(waiter: mutable ProcessWaiter&, stream: heap void&) -> u64 can[Blocking.IO]:
            if fseek(stream, 0, FILEIO_SEEK_END) != 0:
                waiter.failed <- true
                return 0
            size: i64 = ftell(stream)
            if size < 0:
                waiter.failed <- true
                return 0
            return size.u64()

        def process_wait_output_exceeded(waiter: mutable ProcessWaiter&) -> bool can[Blocking.IO]:
            stdout_size: mutable u64 = 0
            stderr_size: mutable u64 = 0
            if waiter.stdout_stream != null:
                stdout_stream: heap void& = waiter.stdout_stream
                stdout_size <- process_wait_stream_size(waiter, stdout_stream)
            if waiter.stderr_stream != null:
                stderr_stream: heap void& = waiter.stderr_stream
                stderr_size <- process_wait_stream_size(waiter, stderr_stream)
            return true if waiter.failed
            if stdout_size > waiter.output_limit:
                waiter.output_exceeded <- true
                return true
            if stderr_size > waiter.output_limit - stdout_size:
                waiter.output_exceeded <- true
                return true
            return false


        def process_wait_sleep() -> bool can[Blocking.IO]:
            return bounded_usleep(ProcessWait::POLL_MICROSECONDS)


        def process_wait_clock_start(waiter: mutable ProcessWaiter&) -> bool can[Blocking.IO]:
            return false if waiter.timeout_micros > EsProcess::PROCESS_COMMAND_MAX_TIMEOUT_MICROS
            if waiter.timeout_micros == 0u64:
                waiter.clock_started <- true
                return true
            sample: mutable EsMonotonicTime::MonotonicTimestamp = EsMonotonicTime::MonotonicTimestamp{seconds: 0, nanoseconds: 0}
            return false if elisascript_posix_monotonic_time(sample) != 0
            catch EsMonotonicTime::validate_monotonic_timestamp(sample):
                ok value:
                    pass
                error failure:
                    return false
            waiter.started_at <- sample
            waiter.clock_started <- true
            return true


        def process_wait_deadline_reached(waiter: mutable ProcessWaiter&) -> bool can[Blocking.IO]:
            return false if waiter.timeout_micros == 0u64
            sample: mutable EsMonotonicTime::MonotonicTimestamp = EsMonotonicTime::MonotonicTimestamp{seconds: 0, nanoseconds: 0}
            if elisascript_posix_monotonic_time(sample) != 0:
                waiter.failed <- true
                return false
            elapsed: mutable u64 = 0u64
            catch EsMonotonicTime::monotonic_elapsed_microseconds(waiter.started_at, sample):
                ok value:
                    elapsed <- value
                error failure:
                    waiter.failed <- true
                    return false
            return elapsed >= waiter.timeout_micros


        def process_wait_next(waiter: mutable ProcessWaiter&) -> ProcessWaitState can[Blocking.IO]:
            if not waiter.clock_started and not process_wait_clock_start(waiter):
                waiter.failed <- true
                process_wait_terminate(waiter)
                return ProcessWaitState.Error
            waited: int = elisascript_posix_waitpid(waiter.pid, waiter.status, ProcessWait::NOHANG)
            if waited == waiter.pid:
                if not EsProcessSpawnWait::terminal(waiter.status.i64()):
                    waiter.failed <- true
                    process_wait_terminate(waiter)
                    return ProcessWaitState.Error
                waiter.reaped <- true
                waiter.eintr_retries <- 0
                if process_wait_deadline_reached(waiter):
                    waiter.timed_out <- true
                    process_wait_terminate_group(waiter)
                    waiter.failed <- true
                    return ProcessWaitState.Error
                if waiter.failed:
                    process_wait_terminate_group(waiter)
                    return ProcessWaitState.Error
                # A short-lived child may finish between polls after producing
                # its full output. Recheck both streams after reaping so the
                # final sample cannot be skipped.
                if process_wait_output_exceeded(waiter):
                    process_wait_terminate_group(waiter)
                    return ProcessWaitState.Error
                if waiter.group_ready and not process_wait_group_quiescent(waiter.pid):
                    # Never read a regular-file snapshot while a confirmed
                    # group member can still append through an inherited
                    # descriptor. The group cleanup is best effort; the typed
                    # Process failure prevents unstable capture from escaping.
                    process_wait_terminate_group(waiter)
                    waiter.failed <- true
                    return ProcessWaitState.Error
                return ProcessWaitState.Exited
            if waited < 0:
                errno: mutable int& = elisascript_posix_errno()
                if errno[0] == EsRuntime::DarwinErrno::EINTR and waiter.eintr_retries < PosixRetry::EINTR_RETRIES:
                    waiter.eintr_retries <- waiter.eintr_retries + 1
                    return ProcessWaitState.Progress
                process_wait_terminate(waiter)
                waiter.failed <- true
                return ProcessWaitState.Error
            waiter.eintr_retries <- 0
            if process_wait_output_exceeded(waiter):
                # `waited == 0` means the child is still live. Terminate it on
                # output overflow and stream-inspection failure; otherwise a
                # failed fseek/ftell could leave it writing after cleanup.
                process_wait_terminate(waiter)
                return ProcessWaitState.Error
            if process_wait_deadline_reached(waiter):
                waiter.timed_out <- true
                process_wait_terminate(waiter)
                waiter.failed <- true
                return ProcessWaitState.Error
            if waiter.failed:
                process_wait_terminate(waiter)
                return ProcessWaitState.Error
            if waiter.polls >= ProcessWait::MAX_POLLS:
                waiter.timed_out <- true
                process_wait_terminate(waiter)
                waiter.failed <- true
                return ProcessWaitState.Error
            if not process_wait_sleep():
                process_wait_terminate(waiter)
                waiter.failed <- true
                return ProcessWaitState.Error
            waiter.polls <- waiter.polls + 1
            return ProcessWaitState.Progress


        def read_process_output(machine: mutable Machine&, stream: heap void&) -> sview can[Blocking.IO, Memory.Allocate, Memory.Release]:
            if fseek(stream, 0, FILEIO_SEEK_END) != 0:
                interpret_set_failure(machine, InterpretFailure.Process)
                _ = interpret_close_file(machine, stream)
                return ""
            size: i64 = ftell(stream)
            if size < 0:
                interpret_set_failure(machine, InterpretFailure.Process)
                _ = interpret_close_file(machine, stream)
                return ""
            if size.u64() > machine.process_output_limit:
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                _ = interpret_close_file(machine, stream)
                return ""
            host_size: usize = size.usize()
            if host_size.i64() != size:
                interpret_set_failure(machine, InterpretFailure.Process)
                _ = interpret_close_file(machine, stream)
                return ""
            if not runtime_resource_add_output(machine.resource_usage, machine.resource_policy, host_size):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                _ = interpret_close_file(machine, stream)
                return ""
            if fseek(stream, 0, FILEIO_SEEK_SET) != 0:
                interpret_set_failure(machine, InterpretFailure.Process)
                _ = interpret_close_file(machine, stream)
                return ""
            if size == 0:
                close_status: int = interpret_close_file(machine, stream)
                if close_status != 0:
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return ""
                return ""
            bytes: mutable dstr = ctx_fstr_alloc(host_size)
            if bytes.items == null:
                interpret_set_failure(machine, InterpretFailure.Process)
                _ = interpret_close_file(machine, stream)
                return ""
            byte_items: mutable u8& = bytes.items
            read_count: usize = read_stream_fully(stream, byte_items, host_size)
            close_status: int = interpret_close_file(machine, stream)
            if read_count != host_size or close_status != 0:
                interpret_set_failure(machine, InterpretFailure.Process)
                return ""
            bytes.count <- host_size
            return bytes_view(bytes)


        # Execute a shell-free pipeline by staging each stage's stdout as the
        # next stage's stdin. This deliberately reuses the checked one-shot
        # ProcessCapture path, so argv handling, output limits, child setup, and
        # bounded waits are identical to standalone process execution.
        def evaluate_capture_process_pipeline(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, executables: RuntimeValue, arguments: RuntimeValue, input: RuntimeValue, status_policy: EsProcess::ProcessPipelineStatusPolicy, timeout_micros: u64 = ProcessWait::MAX_RUNTIME_MICROS) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if not process_timeout_admitted(machine, timeout_micros):
                return runtime_void()
            if executables.kind != RuntimeValueKind.Array or arguments.kind != RuntimeValueKind.Array or input.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_array_range_valid(storage, executables) or not runtime_array_range_valid(storage, arguments):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if executables.array_count == 0 or executables.array_count != arguments.array_count:
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if executables.array_count.usize() > EsProcess::PROCESS_PIPELINE_MAX_STAGES:
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if not process_argument_count_fits(machine, executables):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if not process_input_bytes_fits(machine, input):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            current_input: mutable RuntimeValue = input
            final_capture: mutable RuntimeValue = runtime_void()
            pipefail_exit_status: mutable i64 = 0
            aggregate_stderr_bytes: mutable usize = 0
            aggregate_stderr_segments: mutable darray[sview] = []
            for offset in 0..<executables.array_count.usize() |machine, storage, executables, arguments, offset, current_input, final_capture, pipefail_exit_status, aggregate_stderr_bytes, aggregate_stderr_segments|:
                executable: RuntimeValue = storage[executables.array_start.usize() + offset]
                stage_arguments: RuntimeValue = storage[arguments.array_start.usize() + offset]
                if executable.kind != RuntimeValueKind.Text or stage_arguments.kind != RuntimeValueKind.Array:
                    interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                    return runtime_void()
                final_capture <- evaluate_capture_process_result(machine, storage, executable, stage_arguments, current_input, runtime_void(), runtime_void(), timeout_micros)
                return runtime_void() if machine.failure != InterpretFailure.None
                pipefail_exit_status <- final_capture.process_exit_status if final_capture.process_exit_status != 0
                stage_stderr_length: usize = sview_len(final_capture.process_stderr)
                if aggregate_stderr_bytes > machine.resource_policy.output_bytes:
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                if stage_stderr_length > machine.resource_policy.output_bytes - aggregate_stderr_bytes:
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                if stage_stderr_length > 0:
                    aggregate_stderr_segments.push(final_capture.process_stderr)
                    aggregate_stderr_bytes <- aggregate_stderr_bytes + stage_stderr_length
                current_input <- runtime_text(final_capture.process_stdout)
            final_capture.process_exit_status <- pipefail_exit_status if status_policy == EsProcess::ProcessPipelineStatusPolicy.Pipefail
            if aggregate_stderr_bytes > 0:
                aggregate_stderr: mutable dstr = ctx_fstr_alloc(aggregate_stderr_bytes)
                if aggregate_stderr.items == null:
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                for segment_index in 0..<aggregate_stderr_segments.count |aggregate_stderr, aggregate_stderr_segments|:
                    segment: sview = aggregate_stderr_segments[segment_index]
                    ctx_fstr_append(aggregate_stderr, segment.data, sview_len(segment))
                final_capture.process_stderr <- bytes_view(aggregate_stderr)
            return final_capture


        def evaluate_capture_process_result(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, executable: RuntimeValue, arguments: RuntimeValue, input: RuntimeValue, working_directory: RuntimeValue, environment: RuntimeValue, timeout_micros: u64 = ProcessWait::MAX_RUNTIME_MICROS, output_limit_bytes: usize = ES_RUNTIME_DEFAULT_MAX_OUTPUT_BYTES) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if not process_timeout_admitted(machine, timeout_micros):
                return runtime_void()
            if output_limit_bytes > ES_RUNTIME_DEFAULT_MAX_OUTPUT_BYTES:
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if executable.kind != RuntimeValueKind.Text or arguments.kind != RuntimeValueKind.Array or input.kind != RuntimeValueKind.Text or (working_directory.kind != RuntimeValueKind.Void and working_directory.kind != RuntimeValueKind.Text) or (environment.kind != RuntimeValueKind.Void and environment.kind != RuntimeValueKind.Map):
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not process_text_length_fits(machine, executable.text):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if text_has_nul(executable.text):
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if working_directory.kind == RuntimeValueKind.Text and not path_text_valid(working_directory.text):
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if sview_len(executable.text) == 0:
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if not runtime_array_range_valid(storage, arguments):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if not process_argument_count_fits(machine, arguments):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if not process_argument_bytes_fits(machine, storage, executable, arguments):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if not process_input_bytes_fits(machine, input):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            capture_output_limit: mutable u64 = process_output_remaining(machine)
            if output_limit_bytes.u64() < capture_output_limit:
                capture_output_limit <- output_limit_bytes.u64()
            if machine.process_output_limit < capture_output_limit:
                capture_output_limit <- machine.process_output_limit
            executable_bytes: dstr = nul_terminated_text(executable.text)
            if executable_bytes.items == null:
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            executable_items: u8& = executable_bytes.items
            working_directory_bytes: mutable dstr = []
            working_directory_items: mutable u8&? = null
            if working_directory.kind == RuntimeValueKind.Text:
