                    elisascript_posix_exit(126) if not process_dup2_child(input_descriptor, 0)
                    elisascript_posix_exit(126) if not process_dup2_child(output_descriptor, output_fd)
                    _ = elisascript_posix_execvp(executable_items.cast[cstr], argv_items)
                    elisascript_posix_exit(127)
                    return runtime_void()
