                    Write, ProcessInputState.Done:
                        break
                    Write, ProcessInputState.Error:
                        break
                if input_writer.failed or fseek(input_stream, 0, FILEIO_SEEK_SET) != 0:
                    _ = interpret_close_file(machine, input_stream)
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                output_handle: mutable heap void&? = interpret_open_tmpfile(machine)
                if output_handle == null:
                    _ = interpret_close_file(machine, input_stream)
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                output_stream: mutable heap void& = output_handle
