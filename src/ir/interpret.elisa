                if working_directory_bytes.items == null:
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                directory_storage: mutable u8&? = working_directory_bytes.items
                if directory_storage == null:
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                working_directory_items <- directory_storage
            environment_names: mutable darray[dstr] = []
            environment_values: mutable darray[dstr] = []
            if environment.kind == RuntimeValueKind.Map:
                if not runtime_map_range_valid(storage, environment):
                    interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                    return runtime_void()
                if environment.map_count.usize() > machine.process_argument_limit:
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                if not process_environment_bytes_fits(machine, storage, environment):
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                environment_names.reserve(environment.map_count.usize())
                environment_values.reserve(environment.map_count.usize())
                for offset in 0..<environment.map_count.usize() |machine, storage, environment, environment_names, environment_values|:
                    name: RuntimeValue = storage[environment.map_start.usize() + offset * 2]
                    value: RuntimeValue = storage[environment.map_start.usize() + offset * 2 + 1]
                    if name.kind != RuntimeValueKind.Text or value.kind != RuntimeValueKind.Text or sview_len(name.text) == 0:
                        interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                        return runtime_void()
                    if not process_text_length_fits(machine, name.text) or not process_text_length_fits(machine, value.text):
                        interpret_set_failure(machine, InterpretFailure.Process)
                        return runtime_void()
                    if text_has_nul(name.text) or sview_contains_byte(name.text, 61) or text_has_nul(value.text):
                        interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                        return runtime_void()
                    name_bytes: dstr = nul_terminated_text(name.text)
                    value_bytes: dstr = nul_terminated_text(value.text)
                    if name_bytes.items == null or value_bytes.items == null:
                        interpret_set_failure(machine, InterpretFailure.Process)
                        return runtime_void()
