        def create_temporary_value(prefix: sview, directory: bool, parent: sview = "/tmp") -> sview error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            # Initialize every host policy field explicitly, including the
            # descriptor budget used by the mkstemp acquire/close boundary.
            policy: RuntimeResourcePolicy = RuntimeResourcePolicy{
                steps: ES_RUNTIME_DEFAULT_MAX_STEPS,
                elapsed_micros: ES_RUNTIME_DEFAULT_MAX_ELAPSED_MICROS,
                memory_bytes: ES_RUNTIME_DEFAULT_MAX_MEMORY_BYTES,
                open_handles: ES_RUNTIME_DEFAULT_MAX_OPEN_HANDLES,
                processes: ES_RUNTIME_DEFAULT_MAX_PROCESSES,
                output_bytes: ES_RUNTIME_DEFAULT_MAX_OUTPUT_BYTES,
                regex_work: ES_RUNTIME_DEFAULT_MAX_REGEX_WORK,
                retained_traces: ES_RUNTIME_DEFAULT_MAX_RETAINED_TRACES,
                concurrent_tasks: ES_RUNTIME_DEFAULT_MAX_CONCURRENT_TASKS
            }
            machine: mutable Machine = Machine{steps: 0, step_limit: 1, resource_policy: policy, failure: InterpretFailure.None, continuations: [], resume_requested: false, resume_value: runtime_void()}
            value: RuntimeValue = evaluate_create_temporary(machine, runtime_text(prefix), directory, runtime_text(parent))
            if machine.failure != InterpretFailure.None:
                try raise_interpret_failure(machine.failure)
            return value.text


        def path_relative_value(target: sview, base: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return "" if not path_shape_text_valid(target) or not path_shape_text_valid(base)
            relative: dstr = Fs::relative(&perm_arena, target, base)
            result: sview = bytes_view(relative)
            return "" if not path_shape_result_valid(result)
            return result


