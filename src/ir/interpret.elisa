            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                handle: mutable heap void&? = fopen(path_items, "ab")
                if handle == null:
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                stream: mutable heap void& = handle
                written: mutable usize = 0
                written <- fwrite(text.text.data.cast[void&], 1, sview_len(text.text), stream) if sview_len(text.text) > 0
                close_status: int = fclose(stream)
                if written != sview_len(text.text) or close_status != 0:
