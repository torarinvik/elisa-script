                            Opcode.ProcessResultExitStatus | Opcode.ProcessResultStdout | Opcode.ProcessResultStderr:
                                capture_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_process_result_accessor(machine, capture_value, instruction.opcode)
                                break

                            Opcode.GetEnvironment:
                                name_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                value_limit: mutable i64 = EsEnvironmentReadBudget::Limits::MAX_VALUE_BYTES
                                if instruction.integer == 2:
                                    limit_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                    interpret_set_failure(machine, InterpretFailure.TypeMismatch) if limit_value.kind != RuntimeValueKind.Int
                                    value_limit <- limit_value.integer
                                dispatch.value <- evaluate_get_environment(machine, name_value, instruction.integer == 1, value_limit) if machine.failure == InterpretFailure.None
                                break

                            Opcode.SetEnvironment:
                                name_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                environment_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_set_environment(machine, name_value, environment_value)
                                break

                            Opcode.UnsetEnvironment:
                                name_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_unset_environment(machine, name_value)
                                break

                            Opcode.CreateDirectories:
                                path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_create_directories(machine, path_value)
                                break

                            # One arm per OPERAND COUNT. The arm law (docs/123 §5) allows no branch in an arm
                            # body, and the compiler names the remedy: put the condition in the header. The
                            # three cases are the same ones the two `if` blocks used to select, in the same
                            # order of precedence — 4 operands carry an explicit mode, 3 carry only the flags,
                            # and anything else takes every default.
                            Opcode.CreateDirectory if instruction.operand_count == 4:
                                path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                mode_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                parents_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                                exist_ok_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 3], machine)
                                dispatch.value <- evaluate_path_mkdir(machine, path_value, mode_value, parents_value, exist_ok_value)
                                break

                            Opcode.CreateDirectory if instruction.operand_count == 3:
                                path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                parents_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                exist_ok_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                                dispatch.value <- evaluate_path_mkdir(machine, path_value, runtime_int(493), parents_value, exist_ok_value)
                                break

                            Opcode.CreateDirectory:
                                path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_path_mkdir(machine, path_value, runtime_int(493), runtime_bool(false), runtime_bool(false))
                                break

                            Opcode.RemoveDirectory | Opcode.ChangeDirectory:
                                path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_directory_mutation(machine, instruction.opcode, path_value)
                                break

                            Opcode.CurrentDirectory:
                                dispatch.value <- evaluate_current_directory(machine)
                                break

                            Opcode.ScriptSourcePath:
                                if machine.invocation_context.available and path_shape_result_valid(machine.invocation_context.source_path) and path_is_absolute_value(machine.invocation_context.source_path):
                                    dispatch.value <- runtime_text(machine.invocation_context.source_path)
                                else:
                                    interpret_set_failure(machine, InterpretFailure.InvocationContextUnavailable)
                                break

                            Opcode.ListDirectory:
                                path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_list_directory(machine, storage, path_value)
                                break

                            Opcode.IsDirectory:
                                path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_is_directory(machine, path_value)
                                break

                            Opcode.ExpandGlob:
                                pattern_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_expand_glob(machine, storage, pattern_value)
                                break

                            Opcode.PathGlob:
                                path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                pattern_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_path_glob(machine, storage, path_value, pattern_value, false)
                                break

                            Opcode.PathIterDir:
                                path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_path_iterdir(machine, storage, path_value)
                                break

                            Opcode.PathRGlob:
                                path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                pattern_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_path_glob(machine, storage, path_value, pattern_value, true)
                                break

                            Opcode.ReadStdin:
                                dispatch.value <- evaluate_read_stdin(machine)
                                break

                            Opcode.ReadStdinLine:
                                dispatch.value <- evaluate_read_stdin_line(machine)
                                break

                            Opcode.WriteStdout:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_write_stream(machine, text_value, FileDescriptor.Output)
                                break

                            Opcode.WriteStderr:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_write_stream(machine, text_value, FileDescriptor.Error)
                                break

                            Opcode.Concat:
                                left: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                right: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_concat(machine, storage, left, right)
                                break

                            Opcode.SetIndex:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                index: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                replacement: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                                dispatch.value <- evaluate_set_index(machine, storage, collection, index, replacement)
                                break

                            Opcode.DeleteIndex:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                index: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_delete_index(machine, storage, collection, index)
                                break

                            Opcode.RangeCondition:
                                current: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                high: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                step: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                                dispatch.value <- evaluate_range_condition(current, high, step, instruction.integer, machine)
                                break

                            Opcode.Add | Opcode.Subtract | Opcode.Multiply | Opcode.Divide | Opcode.Remainder | Opcode.Equal | Opcode.NotEqual | Opcode.Less | Opcode.LessEqual | Opcode.Greater | Opcode.GreaterEqual | Opcode.BitAnd | Opcode.BitOr | Opcode.BitXor | Opcode.ShiftLeft | Opcode.ShiftRight:
                                left: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                right: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_binary(instruction.opcode, left, right, instruction.result_type, storage, machine)
                                break

                            Opcode.Call:
                                dispatch.value <- evaluate_call(machine, observations, storage, handler_stack, error_guards, module, fn, function_index, current_block, instruction_index, instruction, ids, values)
                                break

                            Opcode.Observe:
                                observed: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                note_observation(machine, observations, instruction.trace.id, observed)
                                dispatch.produces_value <- false
                                break

                            Opcode.Assert:
                                condition: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                evaluate_assertion(condition, machine)
                                dispatch.produces_value <- false
                                break

                            Opcode.Panic:
                                evaluate_panic(machine)
                                dispatch.produces_value <- false
                                break

                            Opcode.Raise:
                                evaluate_raise(machine, instruction, fn, ids, values)
                                dispatch.produces_value <- false
                                break

                            Opcode.ErrorPayload:
                                dispatch.value <- evaluate_error_payload(machine, instruction.integer, instruction.result_type)
                                break

                            Opcode.HandlerPush:
                                if handler_stack.count >= ES_RUNTIME_DEFAULT_MAX_EXECUTION_CALL_DEPTH:
                                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                                else:
                                    handler_stack.push(instruction.symbol)
                                dispatch.produces_value <- false
                                break

                            Opcode.HandlerPop:
                                pop_runtime_handler(machine, handler_stack, instruction.symbol)
                                dispatch.produces_value <- false
                                break

                            Opcode.Perform:
                                dispatch.value <- evaluate_perform(machine, observations, storage, handler_stack, error_guards, module, fn, function_index, current_block, instruction_index, instruction, ids, values)
                                break

                            Opcode.Resume:
                                payload_id: u32 = fn.operand_pool[instruction.operand_start.usize()]
                                request_continuation_resume(machine, observations, storage, module, handler_stack, instruction, payload_id, ids, values)
                                dispatch.value <- machine.resume_value
                                break

                    return dispatch.value if machine.resume_requested
                    if instruction.opcode == Opcode.ErrorGuardPush:
                        if error_guards.count >= ES_RUNTIME_DEFAULT_MAX_ERROR_GUARD_DEPTH:
                            interpret_set_failure(machine, InterpretFailure.OutputLimit)
                            guard_limit_failure <- true
                        else:
                            error_guards.push(ErrorGuard{target: instruction.integer.u32(), handler_depth: handler_stack.count, effect_family: instruction.effect_family, effect_operation: instruction.effect_operation, operation_id: instruction.operation_id})
                    if instruction.opcode == Opcode.ErrorGuardPop:
                        interpret_set_failure(machine, InterpretFailure.InvalidControlFlow) if error_guards.count == 0
                        if error_guards.count > 0:
                            _ = error_guards.pop()
                    if machine.failure != InterpretFailure.None:
                        if not guard_limit_failure:
                            recovered_jump <- recover_error_guard(machine, error_guards, handler_stack, recovery_target)
                        break
                    set_frame_value(ids, values, instruction.result, dispatch.value) if machine.failure == InterpretFailure.None and dispatch.produces_value

                runtime_void() return if machine.failure != InterpretFailure.None
                terminator: Terminator = block.terminator
                transfer: mutable TerminatorDispatch = TerminatorDispatch{state: TerminatorDispatchState.Done, action: TerminatorDispatchAction.Invalid, target: 0, edge_start: 0, edge_count: 0, failure: InterpretFailure.None}
                if recovered_jump:
                    transfer.action <- TerminatorDispatchAction.Jump
                    transfer.target <- recovery_target
                else:
                    transfer <- select_terminator(machine, fn, terminator, ids, values)
                runtime_void() return if machine.failure != InterpretFailure.None
                if transfer.action == TerminatorDispatchAction.Return:
                    return runtime_void() if terminator.operand_count == 0
                    return frame_value(ids, values, terminator.operand, machine)
                if transfer.action != TerminatorDispatchAction.Jump:
                    interpret_set_failure(machine, InterpretFailure.InvalidControlFlow)
                    return runtime_void()
                target: u32 = transfer.target
                edge_start: u32 = transfer.edge_start
                edge_count: u16 = transfer.edge_count
                target_index: usize = find_block(fn, target)
                if target_index == fn.blocks.count or edge_count != fn.blocks[target_index].parameter_count:
                    interpret_set_failure(machine, InterpretFailure.InvalidControlFlow)
                    return runtime_void()
                pending: mutable darray[RuntimeValue] = []
                for offset in 0..<edge_count.usize() |machine, fn, edge_start, ids, values, pending|:
                    pending.push(frame_value(ids, values, fn.edge_arg_pool[edge_start.usize() + offset], machine))
                for offset in 0..<edge_count.usize() |fn, target_index, pending, ids, values|:
                    parameter: Parameter = fn.block_parameter_pool[fn.blocks[target_index].parameter_start.usize() + offset]
                    set_frame_value(ids, values, parameter.value, pending[offset])
                current_block <- target
            return runtime_void()


        def raise_interpret_failure(failure: InterpretFailure) -> void error[InterpretError]:
            machine over failure:
                state Dispatch
                start Dispatch

                Dispatch, InterpretFailure.None:
                    break
                Dispatch, InterpretFailure.UnknownFunction:
                    raise InterpretError.UnknownFunction
                    break
                Dispatch, InterpretFailure.ArgumentMismatch:
                    raise InterpretError.ArgumentMismatch
                    break
                Dispatch, InterpretFailure.MissingValue:
                    raise InterpretError.MissingValue
                    break
                Dispatch, InterpretFailure.TypeMismatch:
                    raise InterpretError.TypeMismatch
                    break
                Dispatch, InterpretFailure.DivisionByZero:
                    raise InterpretError.DivisionByZero
                    break
                Dispatch, InterpretFailure.IntegerOverflow:
                    raise InterpretError.IntegerOverflow
                    break
                Dispatch, InterpretFailure.InvalidNumber:
                    raise InterpretError.InvalidNumber
                    break
                Dispatch, InterpretFailure.FileIo:
                    raise InterpretError.FileIo
                    break
                Dispatch, InterpretFailure.Process:
                    raise InterpretError.Process
                    break
                Dispatch, InterpretFailure.OutputLimit:
                    raise InterpretError.OutputLimit
                    break
                Dispatch, InterpretFailure.Environment:
                    raise InterpretError.Environment
                    break
                Dispatch, InterpretFailure.Directory:
                    raise InterpretError.Directory
                    break
                Dispatch, InterpretFailure.Console:
                    raise InterpretError.Console
                    break
                Dispatch, InterpretFailure.Time:
                    raise InterpretError.Time
                    break
                Dispatch, InterpretFailure.RangeStepZero:
                    raise InterpretError.RangeStepZero
                    break
                Dispatch, InterpretFailure.InvalidShift:
                    raise InterpretError.InvalidShift
                    break
                Dispatch, InterpretFailure.IndexOutOfBounds:
                    raise InterpretError.IndexOutOfBounds
                    break
                Dispatch, InterpretFailure.InvalidContinuation:
                    raise InterpretError.InvalidContinuation
                    break
                Dispatch, InterpretFailure.InvalidControlFlow:
                    raise InterpretError.InvalidControlFlow
                    break
                Dispatch, InterpretFailure.UnsupportedInstruction:
                    raise InterpretError.UnsupportedInstruction
                    break
                Dispatch, InterpretFailure.InvocationContextUnavailable:
                    raise InterpretError.InvocationContextUnavailable
                    break
                Dispatch, InterpretFailure.StepLimitExceeded:
                    raise InterpretError.StepLimitExceeded
                    break
                Dispatch, InterpretFailure.Assertion:
                    raise InterpretError.Assertion
                    break
                Dispatch, InterpretFailure.Panic:
                    raise InterpretError.Panic
                    break
                Dispatch, InterpretFailure.Raised:
                    raise InterpretError.Raised
                    break


    public:
        # Resource helpers shared by packed bytecode and the reference engine.
        # They retain the interpreter's typed error contract while keeping the
        # bytecode value machine independent of its private failure state.
        def path_value_input_valid(value: sview) -> bool:
            return path_shape_text_valid(value)


        def path_value_output_valid(value: sview) -> bool:
            return path_shape_result_valid(value)


        def parse_decimal_value(text: sview) -> f64 error[InterpretError]:
            raise InterpretError.InvalidNumber if not decimal_text_valid(text)
            return parse_decimal(text)


        def decode_literal_text_value(text: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return decode_literal_text(text)


        def parse_integer_value(text: sview) -> i64 error[InterpretError]:
            valid: mutable bool = false
            value: i64 = parse_integer(text, valid)
            raise InterpretError.InvalidNumber if not valid
            return value


        def format_integer_value(value: i64) -> sview can[Memory.Allocate, Console.Format, Abort.Panic]:
            output: heap u8& = int_to_string(value)
            too_large: mutable bool = false
            length: usize = host_cstring_length_bounded(output, too_large)
            return "" if too_large
            return sview(output, 0, length.i64())


        def parse_float_value(text: sview) -> f64 error[InterpretError]:
            return try parse_decimal_value(text)


        def format_float_value(value: f64) -> sview can[Memory.Allocate, Console.Format, Abort.Panic]:
            scratch: heap u8& = float_to_string_scratch(value)
            too_large: mutable bool = false
            length: usize = host_cstring_length_bounded(scratch, too_large)
            return "" if too_large
            bytes: mutable dstr = ctx_fstr_alloc(length)
            return "" if bytes.items == null
            ctx_fstr_append(bytes, scratch, length)
            return bytes_view(bytes)


        def format_bool_value(value: bool) -> sview:
            return "true" if value else "false"


        # Render arrays and dictionaries with a stable, Python-shaped spelling.
        # Text members remain unquoted because Elisascript text is already a
        # concrete byte view; callers that need escaping can apply an explicit
        # text operation before formatting.  Malformed values return an empty
        # view, while valid aggregates are always bracketed and therefore never
        # ambiguous with that sentinel.
        def format_runtime_value_text(storage: darray[RuntimeValue]&, value: RuntimeValue) -> sview can[Memory.Allocate, Abort.Panic]:
            output: mutable dstr = []
            frames: mutable darray[RuntimeFormatFrame] = [RuntimeFormatFrame{value: value, state: RuntimeFormatFrameState.Enter}]
            valid: mutable bool = true
            while frames.count > 0 and valid:
                return "" if frames.count > INTERPRET_MAX_FORMAT_FRAMES
                frame_index: usize = frames.count - 1
                frame: mutable RuntimeFormatFrame = frames[frame_index]
                if frame.state == RuntimeFormatFrameState.Enter:
                    match frame.value.kind:
                        RuntimeValueKind.Void:
                            return "" if output.count > INTERPRET_MAX_FORMAT_BYTES - 4
                            output.push(118)
                            output.push(111)
                            output.push(105)
                            output.push(100)
                            _ = frames.pop()
                        RuntimeValueKind.Bool:
                            text: sview = "true" if frame.value.boolean else "false"
                            for offset in 0..<sview_len(text) |output, text|:
                                return "" if output.count >= INTERPRET_MAX_FORMAT_BYTES
                                output.push(sview_at(text, offset))
                            _ = frames.pop()
                        RuntimeValueKind.Int:
                            number: heap u8& = int_to_string(frame.value.integer)
                            too_large: mutable bool = false
                            length: usize = host_cstring_length_bounded(number, too_large)
                            return "" if too_large
                            for offset in 0..<length |output, number|:
                                return "" if output.count >= INTERPRET_MAX_FORMAT_BYTES
                                output.push(number[offset])
                            _ = frames.pop()
                        RuntimeValueKind.Float:
                            number: heap u8& = float_to_string_scratch(frame.value.decimal)
                            too_large: mutable bool = false
                            length: usize = host_cstring_length_bounded(number, too_large)
                            return "" if too_large
                            for offset in 0..<length |output, number|:
                                return "" if output.count >= INTERPRET_MAX_FORMAT_BYTES
                                output.push(number[offset])
                            _ = frames.pop()
                        RuntimeValueKind.Text:
                            for offset in 0..<sview_len(frame.value.text) |output, frame|:
                                return "" if output.count >= INTERPRET_MAX_FORMAT_BYTES
                                output.push(sview_at(frame.value.text, offset))
                            _ = frames.pop()
                        RuntimeValueKind.Array:
                            valid <- runtime_array_range_valid(storage, frame.value)
                            if valid:
                                return "" if output.count >= INTERPRET_MAX_FORMAT_BYTES
                                output.push(91)
                                frame.state <- RuntimeFormatFrameState.ArrayItem
                                frames[frame_index] <- frame
                            else:
                                return ""
                        RuntimeValueKind.Map:
                            valid <- runtime_map_range_valid(storage, frame.value)
                            if valid:
                                return "" if output.count >= INTERPRET_MAX_FORMAT_BYTES
                                output.push(123)
                                frame.state <- RuntimeFormatFrameState.MapItem
                                frames[frame_index] <- frame
                            else:
                                return ""
                        RuntimeValueKind.ProcessCapture:
                            return ""
                elif frame.state == RuntimeFormatFrameState.ArrayItem:
                    if frame.index >= frame.value.array_count:
                        return "" if output.count >= INTERPRET_MAX_FORMAT_BYTES
                        output.push(93)
                        _ = frames.pop()
                    else:
                        return "" if output.count > INTERPRET_MAX_FORMAT_BYTES - 2
                        output.push(44) if frame.index > 0
                        output.push(32) if frame.index > 0
                        child: RuntimeValue = storage[frame.value.array_start.usize() + frame.index.usize()]
                        frame.index <- frame.index + 1
                        frames[frame_index] <- frame
                        frames.push(RuntimeFormatFrame{value: child, state: RuntimeFormatFrameState.Enter})
                elif frame.state == RuntimeFormatFrameState.MapItem:
                    if frame.index >= frame.value.map_count:
                        return "" if output.count >= INTERPRET_MAX_FORMAT_BYTES
                        output.push(125)
                        _ = frames.pop()
                    else:
                        return "" if output.count > INTERPRET_MAX_FORMAT_BYTES - 2
                        output.push(44) if frame.index > 0
                        output.push(32) if frame.index > 0
                        key: RuntimeValue = storage[frame.value.map_start.usize() + frame.index.usize() * 2]
                        frame.state <- RuntimeFormatFrameState.MapValue
                        frames[frame_index] <- frame
                        frames.push(RuntimeFormatFrame{value: key, state: RuntimeFormatFrameState.Enter})
                else:
                    return "" if output.count > INTERPRET_MAX_FORMAT_BYTES - 2
                    output.push(58)
                    output.push(32)
                    value_offset: usize = frame.value.map_start.usize() + frame.index.usize() * 2 + 1
                    child: RuntimeValue = storage[value_offset]
                    frame.index <- frame.index + 1
                    frame.state <- RuntimeFormatFrameState.MapItem
                    frames[frame_index] <- frame
                    frames.push(RuntimeFormatFrame{value: child, state: RuntimeFormatFrameState.Enter})
            return "" if not valid or output.count == 0 or output.count > INTERPRET_MAX_FORMAT_BYTES
            owned: mutable dstr = ctx_fstr_alloc(output.count)
            return "" if owned.items == null
            ctx_fstr_append(owned, output.items, output.count)
            return bytes_view(owned)


        def path_join_value(base: sview, leaf: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return "" if not path_shape_text_valid(base) or not path_shape_text_valid(leaf)
            return "" if not path_join_length_fits(base, leaf)
            joined: dstr = Fs::join(&perm_arena, base, leaf)
            result: sview = bytes_view(joined)
            return "" if not path_shape_result_valid(result)
            return result


        def path_parent_value(path: sview) -> sview:
            return "" if not path_shape_text_valid(path)
            return Fs::parent(path)


        def path_name_value(path: sview) -> sview:
            return "" if not path_shape_text_valid(path)
            return Fs::filename(path)


        def path_extension_value(path: sview) -> sview:
            return "" if not path_shape_text_valid(path)
            return Fs::extension(path)


        def path_stem_value(path: sview) -> sview:
            return "" if not path_shape_text_valid(path)
            return Fs::stem(path)


        def path_is_absolute_value(path: sview) -> bool:
            return false if not path_shape_text_valid(path)
            return sview_len(path) > 0 and sview_at(path, 0) == 47


        def path_normalize_value(path: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return "" if not path_shape_text_valid(path)
            normalized: dstr = Fs::normalize(&perm_arena, path)
            result: sview = bytes_view(normalized)
            return "" if not path_shape_result_valid(result)
            return result


        def path_absolute_value(path: sview) -> sview error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            raise InterpretError.FileIo if not path_shape_text_valid(path)
            current: sview = try current_directory_value()
            raise InterpretError.FileIo if not path_join_length_fits(current, path)
            joined: dstr = Fs::join(&perm_arena, current, path)
            raise InterpretError.FileIo if not path_shape_result_valid(bytes_view(joined))
            normalized: dstr = Fs::normalize(&perm_arena, bytes_view(joined))
            result: sview = bytes_view(normalized)
