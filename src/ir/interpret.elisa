                    _ = interpret_close_file(machine, input_stream)
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                stdout_stream: mutable heap void& = stdout_handle
                stdout_descriptor: int = elisascript_posix_fileno(stdout_stream)
                if stdout_descriptor < 0:
                    _ = interpret_close_file(machine, input_stream)
                    _ = interpret_close_file(machine, stdout_stream)
