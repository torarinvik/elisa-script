                            collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            needle: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_array_count(machine, storage, collection, needle)
                            break

                        Dispatch, Opcode.Contains:
                            needle: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_contains(machine, storage, needle, collection)
                            break

                        Dispatch, Opcode.StartsWith:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            prefix_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_text_boundary(machine, text_value, prefix_value, true)
                            break

                        Dispatch, Opcode.EndsWith:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            suffix_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_text_boundary(machine, text_value, suffix_value, false)
                            break

                        Dispatch, Opcode.TextRemoveBoundary:
