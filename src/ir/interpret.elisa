include "./runtime_model.elisa"
include "../runtime/temporary_path_model.elisa"
include "../runtime/environment_read_budget_model.elisa"
include "../runtime/process_spawn_wait_model.elisa"


error InterpretError:
    VerificationFailed
    UnknownFunction
    ArgumentMismatch
    MissingValue
    TypeMismatch
    DivisionByZero
    IntegerOverflow
    InvalidNumber
    FileIo
    Process
    OutputLimit
    Environment
    Directory
    Console
    Time
    RangeStepZero
    InvalidShift
    IndexOutOfBounds
    InvalidContinuation
    InvalidControlFlow
    UnsupportedInstruction
    StepLimitExceeded
    Assertion
    Panic
    Raised
    InvocationContextUnavailable


extend EsIr:
    using EsRuntime

    private:
        const enum InterpretFailure of u8:
            None
            UnknownFunction
            ArgumentMismatch
            MissingValue
            TypeMismatch
            DivisionByZero
            IntegerOverflow
            InvalidNumber
            FileIo
            Process
            OutputLimit
            Environment
            Directory
            Console
            Time
            RangeStepZero
            InvalidShift
            IndexOutOfBounds
            InvalidContinuation
            InvalidControlFlow
            UnsupportedInstruction
            StepLimitExceeded
            Assertion
            Panic
            Raised
            InvocationContextUnavailable


        struct ContinuationFrame:
            handler: sview
            policy: ContinuationPolicy
            consumed: mutable bool
            resumptions: mutable u32
            replay_start: usize
            replay_count: usize
            # Stable resumption token derived from the handler name. Zero is
            # retained for legacy frames assembled without typed IDs.
            resumption_id: u64 = 0


        struct ContinuationCallFrame:
            function_index: usize
            resume_block: u32
            resume_instruction: usize
            result_id: u32
            snapshot_start: usize
            snapshot_count: usize
            value_snapshot_start: usize
            value_snapshot_count: usize
            handler_snapshot_start: usize
            handler_snapshot_count: usize
            error_guard_snapshot_start: usize
            error_guard_snapshot_count: usize


        struct ErrorGuard:
            target: u32
            handler_depth: usize
            # Empty metadata denotes a catch-all guard. Non-empty fields match
            # only the corresponding explicit raised error variant.
            effect_family: sview = ""
            effect_operation: sview = ""
            operation_id: u64 = 0


        const enum ContinuationLookupState of u8:
            Search
            Done


        struct ContinuationLookup:
            state: mutable ContinuationLookupState
            index: mutable usize
            found: mutable bool


        const enum ContinuationPolicyState of u8:
            Select
            Done


        const enum ContinuationDecisionKind of u8:
            Terminal
            LinearAvailable
            LinearConsumed
            MultiShot
            Invalid


        struct ContinuationPolicyCursor:
            state: mutable ContinuationPolicyState
            policy: ContinuationPolicy
            consumed: bool
            result: mutable ContinuationDecisionKind


        struct ContinuationDecision:
            kind: ContinuationDecisionKind
            failure: mutable InterpretFailure
            accepted: mutable bool
            tail_resume: mutable bool


        const enum PerformDispatchState of u8:
            SearchHandler
            SearchClause
            Invoke
            Done


        struct PerformDispatch:
            state: mutable PerformDispatchState
            installed_index: mutable usize
            handler_index: mutable usize
            clause_index: mutable usize
            result: mutable RuntimeValue


        # Process captures use temporary files, but the parent still needs a
        # host-side allocation guard before materializing a child's output.
        # Keep this conservative default shared by the reference interpreter
        # and the packed bytecode helpers that construct a local Machine.
        const INTERPRET_DEFAULT_MAX_PROCESS_OUTPUT_BYTES: u64 = 67108864
        const INTERPRET_DEFAULT_MAX_FILE_INPUT_BYTES: u64 = 67108864
        const INTERPRET_DEFAULT_MAX_STDIN_BYTES: u64 = 67108864
        const INTERPRET_DEFAULT_MAX_PROCESS_INPUT_BYTES: u64 = 67108864
        # Every length-delimited value crossing a POSIX C-string boundary is
        # copied with one terminator byte. Keep the shared adapter bounded even
        # for filesystem/environment callers that do not have process argv
        # accounting around them.
        const INTERPRET_MAX_CSTRING_BYTES: usize = ES_RUNTIME_DEFAULT_MAX_CSTRING_BYTES
        # POSIX path operands are admitted separately from general C-string
        # payloads.  A pathname component/operand must fit in the portable
        # host-side path envelope before any NUL scan, allocation, or syscall.
        const INTERPRET_MAX_PATH_BYTES: usize = 4096
        # The legacy /tmp spelling reserves a 4,072-byte prefix budget. Explicit
        # parents share that cap and also validate the complete dynamic template.
        const INTERPRET_MAX_TEMPORARY_PREFIX_BYTES: usize = INTERPRET_MAX_PATH_BYTES - 1 - 17 - 6
        # Process argv vectors are copied into owned C strings before fork.
        # Bound the element count before reserve so a malformed runtime array
        # cannot request an unbounded pointer/string allocation.
        const INTERPRET_DEFAULT_MAX_PROCESS_ARGUMENTS: usize = 1048576
        # The element count alone does not bound the bytes copied into owned
        # C strings. Keep the aggregate terminated executable/argv payload
        # bounded before any per-element duplication.
        const INTERPRET_DEFAULT_MAX_PROCESS_ARGUMENT_BYTES: usize = 67108864
        # Continuation snapshots retain SSA ids, runtime values, and active
        # handler names until their dynamic handler returns. Bound each pool so
        # multi-shot replay cannot turn nested calls into unbounded retained
        # state; exhaustion is reported as InvalidContinuation.
        const module ContinuationLimits:
            FRAMES: usize = 100000
            VALUES: usize = 1000000
            RESUMPTIONS: u32 = 100000


        struct Machine:
            steps: mutable u64
            step_limit: u64
            # One policy travels with the machine instead of being rebuilt by
            # nested calls.  Existing bridge-specific fields remain as local
            # enforcement points until all host resources share this ledger.
            resource_policy: RuntimeResourcePolicy = RuntimeResourcePolicy{}
            resource_usage: mutable RuntimeResourceUsage = RuntimeResourceUsage{}
            # Immutable launch metadata is shared by nested calls and replay.
            invocation_context: ScriptInvocationContext = ScriptInvocationContext{}
            failure: mutable InterpretFailure
            # Explicit `raise Family.Tag` failures retain their static identity
            # while unwinding through nested calls. Built-in failures leave these
            # fields empty and continue to match only catch-all guards.
            failure_family: mutable sview = ""
            failure_operation: mutable sview = ""
            failure_operation_id: mutable u64 = 0
            # Ordered payload values for the currently unwinding raised error.
            # Explicit catch arms consume this side channel through typed
            # ErrorPayload instructions; it remains private to the interpreter.
            failure_payloads: mutable darray[RuntimeValue] = []
            continuations: mutable darray[ContinuationFrame]
            continuation_frames: mutable darray[ContinuationCallFrame] = []
            active_calls: mutable darray[ContinuationCallFrame] = []
            continuation_ids: mutable darray[u32] = []
            continuation_values: mutable darray[RuntimeValue] = []
            continuation_handlers: mutable darray[sview] = []
            continuation_error_guards: mutable darray[ErrorGuard] = []
            resume_requested: mutable bool
            resume_value: mutable RuntimeValue
            # Line-oriented stdin reads consume exactly one line at a time, so
            # repeated `input()` calls can share the same interpreter machine.
            stdin_eof: mutable bool = false
            process_output_limit: u64 = INTERPRET_DEFAULT_MAX_PROCESS_OUTPUT_BYTES
            file_input_limit: u64 = INTERPRET_DEFAULT_MAX_FILE_INPUT_BYTES
            stdin_input_limit: u64 = INTERPRET_DEFAULT_MAX_STDIN_BYTES
            process_input_limit: u64 = INTERPRET_DEFAULT_MAX_PROCESS_INPUT_BYTES
            process_argument_limit: usize = INTERPRET_DEFAULT_MAX_PROCESS_ARGUMENTS
            process_argument_bytes_limit: usize = INTERPRET_DEFAULT_MAX_PROCESS_ARGUMENT_BYTES
            globals: mutable darray[RuntimeValue] = []


        # Panic denotes an interpreter invariant failure and must survive
        # later cleanup/error classification. Ordinary errors retain the
        # existing last-error-wins behavior, and a new Panic may replace any
        # earlier recoverable failure.
        def interpret_set_failure(machine: mutable Machine&, failure: InterpretFailure) -> void:
            if machine.failure != InterpretFailure.Panic:
                machine.failure <- failure


        struct DirectoryScanner:
            names: mutable darray[dstr]
            kinds: mutable darray[u8]
            directory: mutable heap void&?
            opened: mutable bool
            failed: mutable bool
            name_bytes: mutable usize = 0
            eintr_retries: mutable usize = 0


        struct GlobWalker:
            matches: mutable darray[dstr]
            failed: mutable bool
            match_bytes: mutable usize = 0


        const enum StdioReadState of u8:
            Data
            End
            Error


        const enum StdioLineReadState of u8:
            Progress
            Done
            End
            Error


        struct StdioReader:
            bytes: mutable dstr
            failed: mutable bool
            ended: mutable bool = false
            limit: u64 = INTERPRET_DEFAULT_MAX_STDIN_BYTES
            # Count every byte consumed from fd 0, including a line delimiter.
            # The retained payload may omit LF/CR, but the host-read budget may
            # never be bypassed by repeatedly probing after the limit.
            consumed: mutable u64 = 0
            eintr_retries: mutable usize = 0


        const enum StdioWriteState of u8:
            Progress
            Done
            Error


        struct StdioWriter:
            fd: FileDescriptor
            data: u8&
            length: usize
            offset: mutable usize
            failed: mutable bool


        const enum ProcessInputState of u8:
            Progress
            Done
            Error


        struct ProcessInputWriter:
            stream: heap void&
            data: u8&
            length: usize
            offset: mutable usize
            failed: mutable bool


        const enum ProcessWaitState of u8:
            Progress
            Exited
            Error


        const module ProcessWait:
            NOHANG: int = 1
            SIGNAL_TERM: int = 15
            SIGNAL_KILL: int = 9
            POLL_MICROSECONDS: u32 = 1000
            TERM_GRACE_POLLS: u64 = 100
            MAX_RUNTIME_MICROS: u64 = EsProcess::PROCESS_DEFAULT_TIMEOUT_MICROS
            MAX_POLLS: u64 = 120000


        const module PosixRetry:
            EINTR_RETRIES: usize = 8


        struct ProcessWaiter:
            pid: int
            status: mutable int
            failed: mutable bool
            # Release a process slot only after waitpid confirms that the
            # direct child has been reaped. Failed cleanup retains the slot
            # rather than under-reporting a possibly live process.
            reaped: mutable bool = false
            # Negative-PID signaling is safe only after the parent has
            # successfully placed the child in its own process group. Keep
            # this explicit because a failed setpgid must never let cleanup
            # target an unrelated group that happens to share the PID.
            group_ready: bool = false
            polls: mutable u64 = 0
            # Optional temporary streams are sampled while the child is alive.
            # Keeping these handles on the waiter makes the poll/kill protocol
            # explicit instead of relying on a post-exit allocation check.
            stdout_stream: mutable heap void&? = null
            stderr_stream: mutable heap void&? = null
            # Combined remaining budget for captured stdout plus stderr.
            output_limit: u64 = 0
            output_exceeded: mutable bool = false
            timeout_micros: u64 = ProcessWait::MAX_RUNTIME_MICROS
            started_at: mutable EsMonotonicTime::MonotonicTimestamp = EsMonotonicTime::MonotonicTimestamp{seconds: 0, nanoseconds: 0}
            clock_started: mutable bool = false
            timed_out: mutable bool = false
            eintr_retries: mutable usize = 0


        def stdio_read_append_fits(reader: StdioReader&, additional: usize) -> bool:
            current: u64 = reader.consumed
            return false if current > reader.limit
            return additional.u64() <= reader.limit - current


        struct InstructionDispatch:
            value: mutable RuntimeValue
            opcode: Opcode
            produces_value: mutable bool


        # Aggregate formatting uses an explicit stack instead of host recursion.
        # This keeps nested values bounded by caller-owned storage and makes the
        # traversal compatible with the interpreter's state-machine discipline.
        const enum RuntimeFormatFrameState of u8:
            Enter
            ArrayItem
            MapItem
            MapValue


        struct RuntimeFormatFrame:
            value: RuntimeValue
            state: mutable RuntimeFormatFrameState
            index: mutable u32 = 0


        const INTERPRET_MAX_FORMAT_BYTES: usize = 67108864
        const INTERPRET_MAX_FORMAT_FRAMES: usize = 1000000
        # Directory scans retain owned names until sorting and publication. Keep
        # both the entry count and aggregate name bytes bounded so a single
        # hostile directory cannot consume unbounded interpreter memory.
        const INTERPRET_MAX_DIRECTORY_ENTRIES: usize = 262144
        const INTERPRET_MAX_DIRECTORY_NAME_BYTES: usize = 67108864
        const INTERPRET_MAX_GLOB_VARIANTS: usize = 262144
        const INTERPRET_MAX_GLOB_MATCHES: usize = 1048576
        const INTERPRET_MAX_GLOB_VARIANT_BYTES: usize = 67108864
        const INTERPRET_MAX_GLOB_MATCH_BYTES: usize = 67108864
        const INTERPRET_MAX_TEXT_REPLACEMENT_BYTES: usize = 67108864
        const INTERPRET_MAX_TEXT_OUTPUT_BYTES: usize = 67108864
        # Recursive group descent and repeated-atom backtracking both use the
        # host call stack. Reject patterns that would require an unbounded
        # stack before matching can begin, while keeping the ordinary work
        # budget available for shallower patterns.
        # Recursive regex matching consumes one unit at every matcher state.
        # Keep the budget shared by one complete operation, including all
        # scanner positions and capture probes, so backtracking cannot reset it.
        # The public wrappers use the runtime policy ceiling as well; keeping
        # this alias tied to the cross-backend default prevents direct-bytecode
        # adapters from accepting more work than policy-aware interpretation.
        const module RegexLimits:
            PATTERN_BYTES: usize = 65536
            TEXT_BYTES: usize = 67108864
            OUTPUT_BYTES: usize = 67108864
            GROUP_DEPTH: usize = 1024
            REPEAT_DEPTH: usize = 8192
            WORK: u64 = ES_RUNTIME_DEFAULT_MAX_REGEX_WORK


        const INTERPRET_MAX_DECIMAL_TEXT_BYTES: usize = 67108864
        # IEEE-754 values have already saturated to zero or infinity long before
        # this many decimal scale steps. Cap the effective exponent so malformed
        # input cannot overflow the parser's i64 accumulator or turn one float
        # literal into an unbounded state-machine walk.
        const INTERPRET_MAX_DECIMAL_EXPONENT_STEPS: i64 = 4096


        const enum ErrorGuardSearchState of u8:
            Search
            Done


        struct ErrorGuardSearchCursor:
            state: mutable ErrorGuardSearchState
            index: mutable usize
            match_index: mutable usize


        const enum ErrorGuardRecoveryState of u8:
            Search
            Restore
            Done


        struct ErrorGuardRecoveryCursor:
            state: mutable ErrorGuardRecoveryState
            match_index: mutable usize
            recovery_target: mutable u32
            recovered: mutable bool


        const enum TerminatorDispatchState of u8:
            Select
            Done
            Invalid


        const enum TerminatorDispatchAction of u8:
            Return
            Jump
            Invalid


        struct TerminatorDispatch:
            state: mutable TerminatorDispatchState
            action: mutable TerminatorDispatchAction
            target: mutable u32
            edge_start: mutable u32
            edge_count: mutable u16
            failure: mutable InterpretFailure


        const enum DecimalClass of u8:
            Digit
            Separator
            Dot
            Exponent
            Plus
            Minus
            Other


        struct DecimalParser:
            text: sview
            value: mutable f64
            digit_weight: mutable f64
            exponent: mutable i64
            fractional_digits: mutable i64
            scale_adjustment: mutable i64
            index: mutable usize
            negative: mutable bool
            exponent_negative: mutable bool


        const enum IntegerParseClass of u8:
            End
            Digit
            Separator
            Other


        struct IntegerParser:
            text: sview
            index: mutable usize
            value: mutable i64
            digits: mutable u32
            negative: mutable bool
            valid: mutable bool


        def integer_parse_class(parser: IntegerParser&) -> IntegerParseClass:
            return IntegerParseClass.End if parser.index >= sview_len(parser.text)
            byte: u8 = sview_at(parser.text, parser.index)
            return IntegerParseClass.Digit if byte >= 48 and byte <= 57
            return IntegerParseClass.Separator if byte == 95
            return IntegerParseClass.Other


        @inline(always)
        def integer_separator_valid(parser: IntegerParser&) -> bool:
            length: usize = sview_len(parser.text)
            false return if parser.index == 0 or parser.index >= length
            false return if length - parser.index <= 1
            previous: u8 = sview_at(parser.text, parser.index - 1)
            following: u8 = sview_at(parser.text, parser.index + 1)
            return previous >= 48 and previous <= 57 and following >= 48 and following <= 57


        def consume_integer_digit(parser: mutable IntegerParser&) -> void:
            digit: i64 = (sview_at(parser.text, parser.index) - 48).i64()
            parser.value <- parser.value * 10 - digit
            parser.digits <- parser.digits + 1


        def integer_digit_fits(parser: IntegerParser&) -> bool:
            digit: i64 = (sview_at(parser.text, parser.index) - 48).i64()
            limit: i64 = -9223372036854775807 - 1 if parser.negative else -9223372036854775807
            return not (parser.value < limit / 10 or (parser.value == limit / 10 and -digit < limit % 10))


        def parse_integer(text: sview, valid: mutable bool&) -> i64:
            parser: mutable IntegerParser = IntegerParser{text: text, index: 0, value: 0, digits: 0, negative: false, valid: true}
            machine over integer_parse_class(parser):
                state Start
                state Digits
                state Done
                start Start

                Start, IntegerParseClass.End:
                    parser.valid <- false
                    -> Done
                Start, IntegerParseClass.Other if sview_at(parser.text, parser.index) == 45:
                    parser.negative <- true
                    parser.index <- parser.index + 1
                    -> Digits
                Start, IntegerParseClass.Other if sview_at(parser.text, parser.index) == 43:
                    parser.index <- parser.index + 1
                    -> Digits
                Start, IntegerParseClass.Digit if integer_digit_fits(parser):
                    consume_integer_digit(parser)
                    parser.index <- parser.index + 1
                    -> Digits
                Start, IntegerParseClass.Digit:
                    parser.valid <- false
                    -> Done
                Start, IntegerParseClass.Separator:
                    parser.valid <- false
                    -> Done
                Start, IntegerParseClass.Other:
                    parser.valid <- false
                    -> Done

                Digits, IntegerParseClass.Digit if integer_digit_fits(parser):
                    consume_integer_digit(parser)
                    parser.index <- parser.index + 1
                    -> Digits
                Digits, IntegerParseClass.Digit:
                    parser.valid <- false
                    -> Done
                Digits, IntegerParseClass.Separator if integer_separator_valid(parser):
                    parser.index <- parser.index + 1
                    -> Digits
                Digits, IntegerParseClass.Separator:
                    parser.valid <- false
                    -> Done
                Digits, IntegerParseClass.End if parser.digits == 0:
                    parser.valid <- false
                    -> Done
                Digits, IntegerParseClass.End:
                    -> Done
                Digits, IntegerParseClass.Other:
                    parser.valid <- false
                    -> Done

                Done, IntegerParseClass.End | IntegerParseClass.Digit | IntegerParseClass.Separator | IntegerParseClass.Other:
                    break

            valid <- parser.valid
            return parser.value if parser.negative else -parser.value


        const enum DecimalValidationClass of u8:
            End
            Digit
            Separator
            Dot
            Exponent
            Plus
            Minus
            Other


        struct DecimalValidationCursor:
            text: sview
            index: mutable usize
            digits: mutable usize
            exponent_digits: mutable usize
            valid: mutable bool


        def decimal_validation_class(cursor: DecimalValidationCursor&) -> DecimalValidationClass:
            return DecimalValidationClass.End if cursor.index >= sview_len(cursor.text)
            byte: u8 = sview_at(cursor.text, cursor.index)
            return DecimalValidationClass.Digit if byte >= 48 and byte <= 57
            return DecimalValidationClass.Separator if byte == 95
            return DecimalValidationClass.Dot if byte == 46
            return DecimalValidationClass.Exponent if byte == 69 or byte == 101
            return DecimalValidationClass.Plus if byte == 43
            return DecimalValidationClass.Minus if byte == 45
            return DecimalValidationClass.Other


        @inline(always)
        def decimal_separator_followed_by_digit(cursor: DecimalValidationCursor&) -> bool:
            length: usize = sview_len(cursor.text)
            # Prove the following byte exists before forming `index + 1`.
            # Hostile views can advertise a maximum-width length; doing the
            # addition first would wrap and turn the lookahead into an
            # unrelated byte at the start of the view.
            return false if cursor.index == 0 or cursor.index >= length or length - cursor.index <= 1
            previous: u8 = sview_at(cursor.text, cursor.index - 1)
            following: u8 = sview_at(cursor.text, cursor.index + 1)
            return previous >= 48 and previous <= 57 and following >= 48 and following <= 57


        def decimal_text_valid(text: sview) -> bool:
            return false if sview_len(text) > INTERPRET_MAX_DECIMAL_TEXT_BYTES
            cursor: mutable DecimalValidationCursor = DecimalValidationCursor{text: text, index: 0, digits: 0, exponent_digits: 0, valid: true}
            machine over decimal_validation_class(cursor):
                state Start
                state Sign
                state Whole
                state Fraction
                state ExponentLead
                state ExponentSign
                state ExponentDigits
                state Done
                start Start

                Start, DecimalValidationClass.Plus | DecimalValidationClass.Minus:
                    cursor.index <- cursor.index + 1
                    -> Sign
                Start, DecimalValidationClass.Digit:
                    cursor.digits <- cursor.digits + 1
                    cursor.index <- cursor.index + 1
                    -> Whole
                Start, DecimalValidationClass.Dot:
                    cursor.index <- cursor.index + 1
                    -> Fraction
                Start, DecimalValidationClass.End | DecimalValidationClass.Separator | DecimalValidationClass.Exponent | DecimalValidationClass.Other:
                    cursor.valid <- false
                    -> Done

                Sign, DecimalValidationClass.Digit:
                    cursor.digits <- cursor.digits + 1
                    cursor.index <- cursor.index + 1
                    -> Whole
                Sign, DecimalValidationClass.Dot:
                    cursor.index <- cursor.index + 1
                    -> Fraction
                Sign, DecimalValidationClass.End | DecimalValidationClass.Separator | DecimalValidationClass.Exponent | DecimalValidationClass.Plus | DecimalValidationClass.Minus | DecimalValidationClass.Other:
                    cursor.valid <- false
                    -> Done

                Whole, DecimalValidationClass.Digit:
                    cursor.digits <- cursor.digits + 1
                    cursor.index <- cursor.index + 1
                    -> Whole
                Whole, DecimalValidationClass.Separator if decimal_separator_followed_by_digit(cursor):
                    cursor.index <- cursor.index + 1
                    -> Whole
                Whole, DecimalValidationClass.Separator:
                    cursor.valid <- false
                    -> Done
                Whole, DecimalValidationClass.Dot:
                    cursor.index <- cursor.index + 1
                    -> Fraction
                Whole, DecimalValidationClass.Exponent:
                    cursor.index <- cursor.index + 1
                    -> ExponentLead
                Whole, DecimalValidationClass.End if cursor.digits > 0:
                    -> Done
                Whole, DecimalValidationClass.Plus | DecimalValidationClass.Minus | DecimalValidationClass.Other:
                    cursor.valid <- false
                    -> Done
                Whole, DecimalValidationClass.End:
                    cursor.valid <- false
                    -> Done

                Fraction, DecimalValidationClass.Digit:
                    cursor.digits <- cursor.digits + 1
                    cursor.index <- cursor.index + 1
                    -> Fraction
                Fraction, DecimalValidationClass.Separator if decimal_separator_followed_by_digit(cursor):
                    cursor.index <- cursor.index + 1
                    -> Fraction
                Fraction, DecimalValidationClass.Exponent if cursor.digits > 0:
                    cursor.index <- cursor.index + 1
                    -> ExponentLead
                Fraction, DecimalValidationClass.End if cursor.digits > 0:
                    -> Done
                Fraction, DecimalValidationClass.Dot | DecimalValidationClass.Separator | DecimalValidationClass.Plus | DecimalValidationClass.Minus | DecimalValidationClass.Other:
                    cursor.valid <- false
                    -> Done
                Fraction, DecimalValidationClass.Exponent:
                    cursor.valid <- false
                    -> Done
                Fraction, DecimalValidationClass.End:
                    cursor.valid <- false
                    -> Done

                ExponentLead, DecimalValidationClass.Plus | DecimalValidationClass.Minus:
                    cursor.index <- cursor.index + 1
                    -> ExponentSign
                ExponentLead, DecimalValidationClass.Digit:
                    cursor.exponent_digits <- cursor.exponent_digits + 1
                    cursor.index <- cursor.index + 1
                    -> ExponentDigits
                ExponentLead, DecimalValidationClass.End | DecimalValidationClass.Separator | DecimalValidationClass.Dot | DecimalValidationClass.Exponent | DecimalValidationClass.Other:
                    cursor.valid <- false
                    -> Done

                ExponentSign, DecimalValidationClass.Digit:
                    cursor.exponent_digits <- cursor.exponent_digits + 1
                    cursor.index <- cursor.index + 1
                    -> ExponentDigits
                ExponentSign, DecimalValidationClass.End | DecimalValidationClass.Separator | DecimalValidationClass.Dot | DecimalValidationClass.Exponent | DecimalValidationClass.Plus | DecimalValidationClass.Minus | DecimalValidationClass.Other:
                    cursor.valid <- false
                    -> Done

                ExponentDigits, DecimalValidationClass.Digit:
                    cursor.exponent_digits <- cursor.exponent_digits + 1
                    cursor.index <- cursor.index + 1
                    -> ExponentDigits
                ExponentDigits, DecimalValidationClass.Separator if decimal_separator_followed_by_digit(cursor):
                    cursor.index <- cursor.index + 1
                    -> ExponentDigits
                ExponentDigits, DecimalValidationClass.Separator:
                    cursor.valid <- false
                    -> Done
                ExponentDigits, DecimalValidationClass.End if cursor.exponent_digits > 0:
                    -> Done
                ExponentDigits, DecimalValidationClass.Dot | DecimalValidationClass.Exponent | DecimalValidationClass.Plus | DecimalValidationClass.Minus | DecimalValidationClass.Other:
                    cursor.valid <- false
                    -> Done
                ExponentDigits, DecimalValidationClass.End:
                    cursor.valid <- false
                    -> Done

                Done, DecimalValidationClass.End | DecimalValidationClass.Digit | DecimalValidationClass.Separator | DecimalValidationClass.Dot | DecimalValidationClass.Exponent | DecimalValidationClass.Plus | DecimalValidationClass.Minus | DecimalValidationClass.Other:
                    break

            return cursor.valid


        struct RegexMatchSpan:
            start: usize
            end: usize
            found: bool


        struct RegexWorkBudget:
            remaining: mutable u64
            exhausted: mutable bool = false
            spent: mutable u64 = 0
            accounted: mutable u64 = 0


        struct RegexQuantifier:
            end: usize
            minimum: usize
            maximum: usize
            found: bool
            unbounded: bool


        def decimal_class(parser: DecimalParser&) -> DecimalClass:
            return DecimalClass.Other if parser.index >= sview_len(parser.text)
            byte: u8 = sview_at(parser.text, parser.index)
            return DecimalClass.Digit if byte >= 48 and byte <= 57
            return DecimalClass.Separator if byte == 95
            return DecimalClass.Dot if byte == 46
            return DecimalClass.Exponent if byte == 69 or byte == 101
            return DecimalClass.Plus if byte == 43
            return DecimalClass.Minus if byte == 45
            return DecimalClass.Other


        def consume_decimal_digit(parser: mutable DecimalParser&, fractional: bool) -> void:
            digit: f64 = (sview_at(parser.text, parser.index) - 48).f64()
            # Treat the mantissa as one digit stream and account for the
            # fractional scale only after every digit has been consumed. This
            # avoids losing leading fractional digits when a repeated 0.1
            # place underflows, and avoids overflowing a long integer before
            # its explicit exponent can compensate it.
            parser.value <- parser.value * 10.0 + digit * parser.digit_weight
            parser.fractional_digits <- parser.fractional_digits + 1 if fractional
            # Keep the accumulated mantissa below 1e301. The accumulator and
            # digit weight represent the original integer mantissa divided by
            # 10^scale_adjustment, so rescaling both preserves its value.
            if parser.value >= 1e300:
                parser.value <- parser.value * 1e-100
                parser.digit_weight <- parser.digit_weight * 1e-100
                parser.scale_adjustment <- parser.scale_adjustment + 100
            parser.index <- parser.index + 1


        def decimal_exponent_magnitude_limit(parser: DecimalParser&) -> i64:
            # Preserve enough exponent digits to cancel the already-seen
            # fractional and accumulator scales, plus the bounded IEEE range.
            # The validated text ceiling keeps this sum far inside i64.
            return INTERPRET_MAX_DECIMAL_EXPONENT_STEPS + parser.fractional_digits + parser.scale_adjustment


        def consume_exponent_digit(parser: mutable DecimalParser&) -> void:
            digit: i64 = (sview_at(parser.text, parser.index) - 48).i64()
            # Exponents are non-negative while their digits are consumed. Keep
            # enough magnitude for the mantissa scales to cancel, then saturate
            # so exponent text cannot overflow i64 or create unbounded work.
            limit: i64 = decimal_exponent_magnitude_limit(parser)
            if parser.exponent < limit:
                if parser.exponent > (limit - digit) / 10:
                    parser.exponent <- limit
                else:
                    parser.exponent <- parser.exponent * 10 + digit
            parser.index <- parser.index + 1


        def parse_decimal(text: sview) -> f64:
            parser: mutable DecimalParser = DecimalParser{text: text, value: 0.0, digit_weight: 1.0, exponent: 0, fractional_digits: 0, scale_adjustment: 0, index: 0, negative: false, exponent_negative: false}
            machine over decimal_class(parser) while parser.index < sview_len(parser.text):
                state Lead
                state Whole
                state Fraction
                state ExponentLead
                state ExponentDigits
                state Done
                start Lead

                Lead, DecimalClass.Minus:
                    parser.negative <- true
                    parser.index <- parser.index + 1
                    -> Whole
                # `decimal_text_valid` accepts both signs.  Consume a leading
                # plus here as well; leaving it in place previously sent the
                # state machine to `Whole/Other` and returned 0.0 for `+1.25`.
                Lead, DecimalClass.Plus:
                    parser.index <- parser.index + 1
                    -> Whole
                Lead, DecimalClass.Digit | DecimalClass.Separator | DecimalClass.Dot | DecimalClass.Exponent | DecimalClass.Other:
                    -> Whole

                Whole, DecimalClass.Digit:
                    consume_decimal_digit(parser, false)
                    -> Whole
                Whole, DecimalClass.Separator:
                    parser.index <- parser.index + 1
                    -> Whole
                Whole, DecimalClass.Dot:
                    parser.index <- parser.index + 1
                    -> Fraction
                Whole, DecimalClass.Exponent:
                    parser.index <- parser.index + 1
                    -> ExponentLead
                Whole, DecimalClass.Plus | DecimalClass.Minus | DecimalClass.Other:
                    -> Done

                Fraction, DecimalClass.Digit:
                    consume_decimal_digit(parser, true)
                    -> Fraction
                Fraction, DecimalClass.Separator:
                    parser.index <- parser.index + 1
                    -> Fraction
                Fraction, DecimalClass.Exponent:
                    parser.index <- parser.index + 1
                    -> ExponentLead
                Fraction, DecimalClass.Dot | DecimalClass.Plus | DecimalClass.Minus | DecimalClass.Other:
                    -> Done

                ExponentLead, DecimalClass.Minus:
                    parser.exponent_negative <- true
                    parser.index <- parser.index + 1
                    -> ExponentDigits
                ExponentLead, DecimalClass.Plus:
                    parser.index <- parser.index + 1
                    -> ExponentDigits
                ExponentLead, DecimalClass.Digit:
                    -> ExponentDigits
                ExponentLead, DecimalClass.Separator | DecimalClass.Dot | DecimalClass.Exponent | DecimalClass.Other:
                    -> Done

                ExponentDigits, DecimalClass.Digit:
                    consume_exponent_digit(parser)
                    -> ExponentDigits
                ExponentDigits, DecimalClass.Separator:
                    parser.index <- parser.index + 1
                    -> ExponentDigits
                ExponentDigits, DecimalClass.Dot | DecimalClass.Exponent | DecimalClass.Plus | DecimalClass.Minus | DecimalClass.Other:
                    -> Done

                Done, DecimalClass.Digit | DecimalClass.Separator | DecimalClass.Dot | DecimalClass.Exponent | DecimalClass.Plus | DecimalClass.Minus | DecimalClass.Other:
                    break

            parser.exponent <- -parser.exponent if parser.exponent_negative
            parser.exponent <- parser.exponent - parser.fractional_digits + parser.scale_adjustment
            parser.exponent <- INTERPRET_MAX_DECIMAL_EXPONENT_STEPS if parser.exponent > INTERPRET_MAX_DECIMAL_EXPONENT_STEPS
            parser.exponent <- -INTERPRET_MAX_DECIMAL_EXPONENT_STEPS if parser.exponent < -INTERPRET_MAX_DECIMAL_EXPONENT_STEPS
            machine over parser.exponent > 0 while parser.exponent != 0:
                state Scale
                start Scale
                Scale, true:
                    parser.value <- parser.value * 10.0
                    parser.exponent <- parser.exponent - 1
                    -> Scale
                Scale, _:
                    parser.value <- parser.value * 0.1
                    parser.exponent <- parser.exponent + 1
                    -> Scale
            return -parser.value if parser.negative
            return parser.value


        def find_function(module: Module&, name: sview) -> usize:
            for index in 0..<module.functions.count |module, name|:
                index return if module.functions[index].name == name
            return module.functions.count


        def find_block(fn: Function&, id: u32) -> usize:
            for index in 0..<fn.blocks.count |fn, id|:
                index return if fn.blocks[index].id == id
            return fn.blocks.count


        def frame_value(ids: darray[u32]&, values: darray[RuntimeValue]&, id: u32, machine: mutable Machine&) -> RuntimeValue:
            for index in 0..<ids.count |ids, values, id|:
                values[index] return if ids[index] == id
            interpret_set_failure(machine, InterpretFailure.MissingValue)
            return runtime_void()


        def set_frame_value(ids: mutable darray[u32]&, values: mutable darray[RuntimeValue]&, id: u32, value: RuntimeValue) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<ids.count |ids, values, id, value|:
                if ids[index] == id:
                    values[index] <- value
                    return
            ids.push(id)
            values.push(value)


        def tick(machine: mutable Machine&) -> bool:
            if machine.steps >= machine.step_limit:
                interpret_set_failure(machine, InterpretFailure.StepLimitExceeded)
                return false
            if not runtime_resource_add_steps(machine.resource_usage, machine.resource_policy, 1):
                interpret_set_failure(machine, InterpretFailure.StepLimitExceeded)
                return false
            machine.steps <- machine.steps + 1
            return true


        def literal_hex_digit(byte: u8) -> i64:
            return (byte - 48).i64() if byte >= 48 and byte <= 57
            return (byte - 97 + 10).i64() if byte >= 97 and byte <= 102
            return (byte - 65 + 10).i64() if byte >= 65 and byte <= 70
            return -1


        def append_literal_utf8(output: mutable dstr&, codepoint: i64) -> void:
            if codepoint < 128:
                output.push(codepoint.u8())
                return
            if codepoint < 2048:
                output.push((192 + codepoint / 64).u8())
                output.push((128 + codepoint % 64).u8())
                return
            if codepoint < 65536:
                output.push((224 + codepoint / 4096).u8())
                output.push((128 + (codepoint / 64) % 64).u8())
                output.push((128 + codepoint % 64).u8())
                return
            output.push((240 + codepoint / 262144).u8())
            output.push((128 + (codepoint / 4096) % 64).u8())
            output.push((128 + (codepoint / 64) % 64).u8())
            output.push((128 + codepoint % 64).u8())


        # Lexer tokens intentionally retain the source interior. Decode the
        # ordinary Elisa escape set at the IR boundary so the interpreter and
        # packed bytecode see the same bytes as the regular compiler. Unknown or
        # malformed escapes stay verbatim instead of being guessed; this matters
        # for regex and shell-like payloads that deliberately use backslashes.
        def decode_literal_text(text: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            decoded: mutable dstr = []
            index: mutable usize = 0
            length: usize = sview_len(text)
            while index < length:
                byte: u8 = sview_at(text, index)
                if byte != 92 or index >= length - 1:
                    decoded.push(byte)
                    index <- index + 1
                    continue
                next_byte: u8 = sview_at(text, index + 1)
                if next_byte == 120 or next_byte == 117:
                    hex_digits: usize = 2 if next_byte == 120 else 4
                    hex_value: mutable i64 = 0
                    hex_width: usize = 2 + hex_digits
                    hex_ok: mutable bool = hex_width <= length - index
                    hex_index: mutable usize = 0
                    while hex_index < hex_digits and hex_ok:
                        digit: i64 = literal_hex_digit(sview_at(text, index + 2 + hex_index))
                        if digit < 0:
                            hex_ok <- false
                        else:
                            hex_value <- hex_value * 16 + digit
                        hex_index <- hex_index + 1
                    if hex_ok:
                        if next_byte == 117:
                            # A high UTF-16 surrogate must be immediately followed by a
                            # low-surrogate escape.  Decode the pair to one Unicode scalar;
                            # preserve malformed/lone surrogates verbatim so the reference
                            # interpreter agrees with the backend and never emits invalid UTF-8.
                            if hex_value >= 55296 and hex_value <= 56319:
                                pair_available: bool = index <= length and length - index >= 12
                                pair_ok: mutable bool = pair_available and sview_at(text, index + 6) == 92 and sview_at(text, index + 7) == 117
                                low_value: mutable i64 = 0
                                low_index: mutable usize = 0
                                while low_index < 4 and pair_ok:
                                    low_at: i64 = literal_hex_digit(sview_at(text, index + 8 + low_index))
                                    if low_at < 0:
                                        pair_ok <- false
                                    else:
                                        low_value <- low_value * 16 + low_at
                                    low_index <- low_index + 1
                                if pair_ok and low_value >= 56320 and low_value <= 57343:
                                    scalar: i64 = 65536 + ((hex_value - 55296) * 1024) + (low_value - 56320)
                                    append_literal_utf8(decoded, scalar)
                                    index <- index + 12
                                    continue
                                decoded.push(byte)
                                index <- index + 1
                                continue
                            if hex_value >= 56320 and hex_value <= 57343:
                                decoded.push(byte)
                                index <- index + 1
                                continue
                            append_literal_utf8(decoded, hex_value)
                        else:
                            decoded.push(hex_value.u8())
                        index <- index + hex_width
                        continue
                if next_byte == 110 or next_byte == 116 or next_byte == 114 or next_byte == 48 or next_byte == 92 or next_byte == 34 or next_byte == 39:
                    decoded.push(10 if next_byte == 110 else 9 if next_byte == 116 else 13 if next_byte == 114 else 0 if next_byte == 48 else next_byte)
                    index <- index + 2
                    continue
                # Unknown, malformed, and trailing escapes remain source bytes.
                decoded.push(byte)
                index <- index + 1
            return "" if decoded.count == 0
            bytes: mutable dstr = ctx_fstr_alloc(decoded.count)
            if bytes.items == null:
                return ""
            ctx_fstr_append(bytes, decoded.items, decoded.count)
            return bytes_view(bytes)


        def evaluate_constant(instruction: Instruction, machine: mutable Machine&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            match instruction.result_type.kind:
                TypeKind.Bool:
                    return runtime_bool(instruction.boolean)
                TypeKind.Int:
                    return runtime_int(instruction.integer)
                TypeKind.Float:
                    if not decimal_text_valid(instruction.decimal):
                        interpret_set_failure(machine, InterpretFailure.InvalidNumber)
                        return runtime_void()
                    return runtime_float(parse_decimal(instruction.decimal))
                TypeKind.Text | TypeKind.Char | TypeKind.Named:
                    return runtime_text(decode_literal_text(instruction.text))
                _:
                    interpret_set_failure(machine, InterpretFailure.UnsupportedInstruction)
                    return runtime_void()


        def global_literal_value(literal: GlobalLiteral, machine: mutable Machine&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            return runtime_bool(literal.boolean) if literal.kind == TypeKind.Bool
            return runtime_int(literal.integer) if literal.kind == TypeKind.Int
            if literal.kind == TypeKind.Float:
                if not decimal_text_valid(literal.decimal):
                    interpret_set_failure(machine, InterpretFailure.InvalidNumber)
                    return runtime_void()
                return runtime_float(parse_decimal(literal.decimal))
            return runtime_text(decode_literal_text(literal.text)) if literal.kind in {TypeKind.Char, TypeKind.Text, TypeKind.Named}
            interpret_set_failure(machine, InterpretFailure.UnsupportedInstruction)
            return runtime_void()


        def global_value(binding: Global, machine: mutable Machine&, storage: mutable darray[RuntimeValue]&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if binding.type.kind == TypeKind.Array:
                return runtime_array(0, 0) if not binding.initialized
                if not runtime_storage_span_u32_valid(storage, binding.aggregate_values.count):
                    interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                    return runtime_void()
                start: usize = storage.count
                for literal in binding.aggregate_values |machine, storage|:
                    value: RuntimeValue = global_literal_value(literal, machine)
                    if machine.failure != InterpretFailure.None:
                        storage.truncate(start)
                        return runtime_void()
                    storage.push(value)
                return runtime_array(start.u32(), binding.aggregate_values.count.u32())
            if binding.type.kind == TypeKind.Map:
                if binding.aggregate_values.count % 2 != 0:
                    interpret_set_failure(machine, InterpretFailure.InvalidControlFlow)
                    return runtime_void()
                return runtime_map(0, 0) if not binding.initialized
                if not runtime_storage_span_u32_valid(storage, binding.aggregate_values.count):
                    interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                    return runtime_void()
                start: usize = storage.count
                for literal in binding.aggregate_values |machine, storage|:
                    value: RuntimeValue = global_literal_value(literal, machine)
                    if machine.failure != InterpretFailure.None:
                        storage.truncate(start)
                        return runtime_void()
                    storage.push(value)
                return runtime_map(start.u32(), (binding.aggregate_values.count / 2).u32())
            if binding.type.kind == TypeKind.Bool:
                return runtime_bool(binding.boolean) if binding.initialized
                return runtime_bool(false)
            if binding.type.kind == TypeKind.Int:
                return runtime_int(binding.integer) if binding.initialized
                return runtime_int(0)
            if binding.type.kind == TypeKind.Float:
                if binding.initialized and not decimal_text_valid(binding.decimal):
                    interpret_set_failure(machine, InterpretFailure.InvalidNumber)
                    return runtime_void()
                return runtime_float(parse_decimal(binding.decimal)) if binding.initialized else runtime_float(0.0)
            return runtime_text(decode_literal_text(binding.text)) if binding.initialized else runtime_text("") if binding.type.kind in {TypeKind.Char, TypeKind.Text} or text_backed_named_type(binding.type) else runtime_void()


        def evaluate_global_load(instruction: Instruction, machine: mutable Machine&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if instruction.integer < 0 or instruction.integer > 4294967295 or instruction.integer.usize() >= machine.globals.count:
                interpret_set_failure(machine, InterpretFailure.InvalidControlFlow)
                return runtime_void()
            value: RuntimeValue = machine.globals[instruction.integer.usize()]
            interpret_set_failure(machine, InterpretFailure.TypeMismatch) if not runtime_global_matches(value, instruction.result_type)
            return value


        def evaluate_global_store(instruction: Instruction, fn: Function&, ids: darray[u32]&, values: darray[RuntimeValue]&, module: Module&, machine: mutable Machine&) -> void:
            if instruction.integer < 0 or instruction.integer > 4294967295 or instruction.integer.usize() >= machine.globals.count or instruction.operand_count != 1:
                interpret_set_failure(machine, InterpretFailure.InvalidControlFlow)
                return
            stored: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
            interpret_set_failure(machine, InterpretFailure.TypeMismatch) if not runtime_global_matches(stored, module.globals[instruction.integer.usize()].type)
            machine.globals[instruction.integer.usize()] <- stored if machine.failure == InterpretFailure.None


        def runtime_global_matches(value: RuntimeValue, type: Type&) -> bool:
            return value.kind == RuntimeValueKind.Bool if type.kind == TypeKind.Bool
            return value.kind == RuntimeValueKind.Int if type.kind == TypeKind.Int
            return value.kind == RuntimeValueKind.Float if type.kind == TypeKind.Float
            return value.kind == RuntimeValueKind.Array if type.kind == TypeKind.Array
            return value.kind == RuntimeValueKind.Map if type.kind == TypeKind.Map
            return value.kind == RuntimeValueKind.ProcessCapture if type.kind == TypeKind.Named and type.name == "ProcessCapture"
            return value.kind == RuntimeValueKind.Text if type.kind in {TypeKind.Char, TypeKind.Text} or text_backed_named_type(type)
            return false


        def evaluate_parse_int(operand: RuntimeValue, machine: mutable Machine&) -> RuntimeValue:
            if operand.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            valid: mutable bool = false
            value: i64 = parse_integer(operand.text, valid)
            if not valid:
                interpret_set_failure(machine, InterpretFailure.InvalidNumber)
                return runtime_void()
            return runtime_int(value)


        def evaluate_format_int(operand: RuntimeValue, machine: mutable Machine&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if operand.kind != RuntimeValueKind.Int:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            formatted: heap u8& = int_to_string(operand.integer)
            too_large: mutable bool = false
            length: usize = host_cstring_length_bounded(formatted, too_large)
            if too_large:
                interpret_set_failure(machine, InterpretFailure.Console)
                return runtime_void()
            return runtime_text(sview(formatted, 0, length.i64()))


        def evaluate_parse_float(operand: RuntimeValue, machine: mutable Machine&) -> RuntimeValue:
            if operand.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not decimal_text_valid(operand.text):
                interpret_set_failure(machine, InterpretFailure.InvalidNumber)
                return runtime_void()
            return runtime_float(parse_decimal(operand.text))


        def evaluate_format_float(operand: RuntimeValue, machine: mutable Machine&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if operand.kind != RuntimeValueKind.Float:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            scratch: heap u8& = float_to_string_scratch(operand.decimal)
            too_large: mutable bool = false
            length: usize = host_cstring_length_bounded(scratch, too_large)
            if too_large:
                interpret_set_failure(machine, InterpretFailure.Console)
                return runtime_void()
            bytes: mutable dstr = ctx_fstr_alloc(length)
            if bytes.items == null:
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            ctx_fstr_append(bytes, scratch, length)
            return runtime_text(bytes_view(bytes))


        def evaluate_format_bool(operand: RuntimeValue, machine: mutable Machine&) -> RuntimeValue:
            if operand.kind != RuntimeValueKind.Bool:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            return runtime_text("true") if operand.boolean else runtime_text("false")


        def evaluate_format_nominal(operand: RuntimeValue, machine: mutable Machine&) -> RuntimeValue:
            if operand.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            return runtime_text(operand.text)


        def evaluate_format_char(operand: RuntimeValue, machine: mutable Machine&) -> RuntimeValue:
            # Char constants use the shared text payload at runtime.  The static
            # verifier guarantees the source operand is `char`; this check keeps
            # malformed external IR from being treated as a successful format.
            if operand.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            return runtime_text(operand.text)


        def evaluate_format_aggregate(storage: darray[RuntimeValue]&, operand: RuntimeValue, machine: mutable Machine&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if operand.kind != RuntimeValueKind.Array and operand.kind != RuntimeValueKind.Map:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if operand.kind == RuntimeValueKind.Array and not runtime_array_range_valid(storage, operand) or operand.kind == RuntimeValueKind.Map and not runtime_map_range_valid(storage, operand):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            formatted: sview = format_runtime_value_text(storage, operand)
            if formatted == "":
                interpret_set_failure(machine, InterpretFailure.Console)
                return runtime_void()
            return runtime_text(formatted)


        def integer_min(type: Type&) -> i64:
            return -128 if type.signed and type.bits == 8
            return -32768 if type.signed and type.bits == 16
            return -2147483648 if type.signed and type.bits == 32
            return -9223372036854775807 - 1 if type.signed and type.bits == 64
            return 0


        def integer_max(type: Type&) -> i64:
            return 127 if type.signed and type.bits == 8
            return 32767 if type.signed and type.bits == 16
            return 2147483647 if type.signed and type.bits == 32
            return 9223372036854775807 if type.signed and type.bits == 64
            return 255 if type.bits == 8
            return 65535 if type.bits == 16
            return 4294967295 if type.bits == 32
            return 9223372036854775807


        def checked_narrow_int(machine: mutable Machine&, value: i64, type: Type&) -> RuntimeValue:
            # Runtime integers are represented as i64, so unsigned 64-bit
            # values still need the representable non-negative half-range
            # checked even though their nominal width is 64.
            if (not type.signed or type.bits < 64) and (value < integer_min(type) or value > integer_max(type)):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            return runtime_int(value)


        def checked_narrow_arithmetic(machine: mutable Machine&, opcode: Opcode, left: i64, right: i64, type: Type&) -> RuntimeValue:
            minimum: i64 = integer_min(type)
            maximum: i64 = integer_max(type)
            if opcode == Opcode.Add:
                # `minimum - right` overflows when right is i64::MIN.  Handle
                # that endpoint explicitly before evaluating the subtraction.
                if right == -9223372036854775807 - 1:
                    if minimum != -9223372036854775807 - 1 or left < 0:
                        interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                        return runtime_void()
                if (right > 0 and left > maximum - right) or (right < 0 and right != -9223372036854775807 - 1 and left < minimum - right):
                    interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                    return runtime_void()
                return runtime_int(left + right)
            if opcode == Opcode.Subtract:
                if (right < 0 and left > maximum + right) or (right > 0 and left < minimum + right):
                    interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                    return runtime_void()
                return runtime_int(left - right)
            if opcode == Opcode.Multiply:
                overflow: mutable bool = false
                if left > 0:
                    overflow <- right > maximum / left if right > 0
                    overflow <- right < minimum / left if right < 0
                elif left < 0:
                    overflow <- left < minimum / right if right > 0
                    if right < 0:
                        # Every nonzero negative value times i64::MIN is
                        # outside the signed range; in particular, -1 * MIN
                        # is +2^63, not a representable i64.
                        overflow <- left != 0 if right == -9223372036854775807 - 1
                        overflow <- left != 0 and right < maximum / left if right != -9223372036854775807 - 1
                if overflow:
                    interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                    return runtime_void()
                return runtime_int(left * right)
            interpret_set_failure(machine, InterpretFailure.TypeMismatch)
            return runtime_void()


        def evaluate_negate(operand: RuntimeValue, result_type: Type&, machine: mutable Machine&) -> RuntimeValue:
            match operand.kind:
                RuntimeValueKind.Int:
                    if not result_type.signed and operand.integer != 0:
                        interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                        return runtime_void()
                    if operand.integer == -9223372036854775807 - 1:
                        interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                        return runtime_void()
                    return checked_narrow_int(machine, -operand.integer, result_type)
                RuntimeValueKind.Float:
                    return runtime_float(-operand.decimal)
                _:
                    interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                    return runtime_void()


        def evaluate_not(operand: RuntimeValue, machine: mutable Machine&) -> RuntimeValue:
            if operand.kind != RuntimeValueKind.Bool:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            return runtime_bool(not operand.boolean)


        def evaluate_assertion(condition: RuntimeValue, machine: mutable Machine&) -> void:
            if condition.kind != RuntimeValueKind.Bool:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return
            interpret_set_failure(machine, InterpretFailure.Assertion) if not condition.boolean


        def evaluate_raise(machine: mutable Machine&, instruction: Instruction&, fn: Function&, ids: darray[u32]&, values: darray[RuntimeValue]&) -> void:
            # Error variants are carried in the instruction's static family/tag
            # metadata. Payload values are copied from the current frame in
            # source order so a matching catch arm can extract them without
            # changing the unwind protocol.
            machine.failure_payloads.truncate(0)
            for offset in 0..<instruction.operand_count.usize() |machine, fn, instruction, ids, values|:
                payload: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + offset], machine)
                return if machine.failure != InterpretFailure.None
                machine.failure_payloads.push(payload)
            interpret_set_failure(machine, InterpretFailure.Raised)
            machine.failure_family <- instruction.effect_family
            machine.failure_operation <- instruction.effect_operation
            machine.failure_operation_id <- instruction.operation_id


        def evaluate_error_payload(machine: mutable Machine&, index: i64, result_type: Type&) -> RuntimeValue:
            # Payload indices arrive through an i64 instruction field.  Check
            # the upper bound in the wide domain before narrowing so a large
            # hostile index cannot wrap on a narrower host and alias payload 0.
            if index < 0 or index > machine.failure_payloads.count.i64() or index.usize() >= machine.failure_payloads.count:
                interpret_set_failure(machine, InterpretFailure.MissingValue)
                return runtime_void()
            value: RuntimeValue = machine.failure_payloads[index.usize()]
            if not runtime_global_matches(value, result_type):
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            return value


        def evaluate_panic(machine: mutable Machine&) -> void:
            # Panic is an abort effect, not an error-set variant. It therefore
            # bypasses the ordinary error guards and reaches the public
            # `InterpretError.Panic` boundary unchanged.
            interpret_set_failure(machine, InterpretFailure.Panic)


        def evaluate_bit_not(operand: RuntimeValue, result_type: Type&, machine: mutable Machine&) -> RuntimeValue:
            if operand.kind != RuntimeValueKind.Int:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if (not result_type.signed or result_type.bits < 64) and (operand.integer < integer_min(result_type) or operand.integer > integer_max(result_type)):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            if not result_type.signed and result_type.bits < 64:
                return checked_narrow_int(machine, (~operand.integer) & integer_max(result_type), result_type)
            return checked_narrow_int(machine, ~operand.integer, result_type)


        def runtime_values_equal(storage: darray[RuntimeValue]&, left: RuntimeValue, right: RuntimeValue, depth: usize = 0) -> bool:
            false return if depth > ES_RUNTIME_DEFAULT_MAX_VALUE_EQUAL_DEPTH
            false return if left.kind != right.kind
            left.integer == right.integer return if left.kind == RuntimeValueKind.Int
            left.boolean == right.boolean return if left.kind == RuntimeValueKind.Bool
            left.decimal == right.decimal return if left.kind == RuntimeValueKind.Float
            left.text == right.text return if left.kind == RuntimeValueKind.Text
            return left.process_exit_status == right.process_exit_status and left.process_stdout == right.process_stdout and left.process_stderr == right.process_stderr if left.kind == RuntimeValueKind.ProcessCapture
            return runtime_arrays_equal(storage, left, right, depth) if left.kind == RuntimeValueKind.Array
            return runtime_maps_equal(storage, left, right, depth) if left.kind == RuntimeValueKind.Map
            return left.kind == RuntimeValueKind.Void


        def runtime_arrays_equal(storage: darray[RuntimeValue]&, left: RuntimeValue, right: RuntimeValue, depth: usize = 0) -> bool:
            false return if depth > ES_RUNTIME_DEFAULT_MAX_VALUE_EQUAL_DEPTH
            false return if left.array_count != right.array_count
            false return if not runtime_array_range_valid(storage, left) or not runtime_array_range_valid(storage, right)
            for offset in 0..<left.array_count.usize() |storage, left, right|:
                false return if not runtime_values_equal(storage, storage[left.array_start.usize() + offset], storage[right.array_start.usize() + offset], depth + 1)
            return true


        def runtime_maps_equal(storage: darray[RuntimeValue]&, left: RuntimeValue, right: RuntimeValue, depth: usize = 0) -> bool:
            false return if depth > ES_RUNTIME_DEFAULT_MAX_VALUE_EQUAL_DEPTH
            false return if left.kind != RuntimeValueKind.Map or right.kind != RuntimeValueKind.Map
            false return if left.map_count != right.map_count
            false return if not runtime_map_range_valid(storage, left) or not runtime_map_range_valid(storage, right)
            matched: mutable darray[bool] = []
            for _ in 0..<right.map_count.usize() |matched|:
                matched.push(false)
            for left_offset in 0..<left.map_count.usize() |storage, left, right|:
                left_key: RuntimeValue = storage[left.map_start.usize() + left_offset * 2]
                left_value: RuntimeValue = storage[left.map_start.usize() + left_offset * 2 + 1]
                found: mutable bool = false
                for right_offset in 0..<right.map_count.usize() |storage, right, left_key, left_value, found, matched|:
                    right_key: RuntimeValue = storage[right.map_start.usize() + right_offset * 2]
                    right_value: RuntimeValue = storage[right.map_start.usize() + right_offset * 2 + 1]
                    if not matched[right_offset] and runtime_values_equal(storage, left_key, right_key, depth + 1) and runtime_values_equal(storage, left_value, right_value, depth + 1):
                        found <- true
                        matched[right_offset] <- true
                false return if not found
            return true


        def evaluate_binary(opcode: Opcode, left: RuntimeValue, right: RuntimeValue, result_type: Type&, storage: darray[RuntimeValue]&, machine: mutable Machine&) -> RuntimeValue:
            if opcode == Opcode.Equal or opcode == Opcode.NotEqual:
                if left.kind != right.kind:
                    interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                    return runtime_void()
                equal: mutable bool = false
                equal <- left.integer == right.integer if left.kind == RuntimeValueKind.Int
                equal <- left.boolean == right.boolean if left.kind == RuntimeValueKind.Bool
                equal <- left.decimal == right.decimal if left.kind == RuntimeValueKind.Float
                equal <- left.text == right.text if left.kind == RuntimeValueKind.Text
                equal <- left.process_exit_status == right.process_exit_status and left.process_stdout == right.process_stdout and left.process_stderr == right.process_stderr if left.kind == RuntimeValueKind.ProcessCapture
                equal <- runtime_arrays_equal(storage, left, right) if left.kind == RuntimeValueKind.Array
                equal <- runtime_maps_equal(storage, left, right) if left.kind == RuntimeValueKind.Map
                return runtime_bool(equal) if opcode == Opcode.Equal
                return runtime_bool(not equal)
            if left.kind == RuntimeValueKind.Text and right.kind == RuntimeValueKind.Text and opcode in {Opcode.Less, Opcode.LessEqual, Opcode.Greater, Opcode.GreaterEqual}:
                left_before_right: bool = runtime_text_less(left.text, right.text)
                right_before_left: bool = runtime_text_less(right.text, left.text)
                return runtime_bool(left_before_right) if opcode == Opcode.Less
                return runtime_bool(not right_before_left) if opcode == Opcode.LessEqual
                return runtime_bool(right_before_left) if opcode == Opcode.Greater
                return runtime_bool(not left_before_right)
            if left.kind == RuntimeValueKind.Int and right.kind == RuntimeValueKind.Int:
                return checked_narrow_int(machine, left.integer & right.integer, result_type) if opcode == Opcode.BitAnd
                return checked_narrow_int(machine, left.integer | right.integer, result_type) if opcode == Opcode.BitOr
                return checked_narrow_int(machine, left.integer ^ right.integer, result_type) if opcode == Opcode.BitXor
                if opcode == Opcode.ShiftLeft or opcode == Opcode.ShiftRight:
                    if right.integer < 0 or right.integer >= result_type.bits.i64():
                        interpret_set_failure(machine, InterpretFailure.InvalidShift)
                        return runtime_void()
                    if opcode == Opcode.ShiftLeft:
                        shift: u32 = right.integer.u32()
                        if result_type.signed and (left.integer > integer_max(result_type) >> shift or left.integer < integer_min(result_type) >> shift):
                            interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                            return runtime_void()
                        if not result_type.signed and (left.integer < 0 or left.integer > integer_max(result_type) >> shift):
                            interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                            return runtime_void()
                    return checked_narrow_int(machine, left.integer << right.integer.u32(), result_type) if opcode == Opcode.ShiftLeft
                    return runtime_int(left.integer >> right.integer.u32())
                return checked_narrow_arithmetic(machine, opcode, left.integer, right.integer, result_type) if opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply}
                if opcode == Opcode.Divide or opcode == Opcode.Remainder:
                    if right.integer == 0:
                        interpret_set_failure(machine, InterpretFailure.DivisionByZero)
                        return runtime_void()
                    if left.integer == -9223372036854775807 - 1 and right.integer == -1:
                        interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                        return runtime_void()
                    return checked_narrow_int(machine, left.integer / right.integer, result_type) if opcode == Opcode.Divide
                    return checked_narrow_int(machine, left.integer % right.integer, result_type)
                return runtime_bool(left.integer < right.integer) if opcode == Opcode.Less
                return runtime_bool(left.integer <= right.integer) if opcode == Opcode.LessEqual
                return runtime_bool(left.integer > right.integer) if opcode == Opcode.Greater
                return runtime_bool(left.integer >= right.integer)
            if left.kind == RuntimeValueKind.Float and right.kind == RuntimeValueKind.Float and opcode != Opcode.Remainder:
                return runtime_float(left.decimal + right.decimal) if opcode == Opcode.Add
                return runtime_float(left.decimal - right.decimal) if opcode == Opcode.Subtract
                return runtime_float(left.decimal * right.decimal) if opcode == Opcode.Multiply
                return runtime_float(left.decimal / right.decimal) if opcode == Opcode.Divide
                return runtime_bool(left.decimal < right.decimal) if opcode == Opcode.Less
                return runtime_bool(left.decimal <= right.decimal) if opcode == Opcode.LessEqual
                return runtime_bool(left.decimal > right.decimal) if opcode == Opcode.Greater
                return runtime_bool(left.decimal >= right.decimal)
            interpret_set_failure(machine, InterpretFailure.TypeMismatch)
            return runtime_void()


        # Evaluate a dynamic integer-range bound. The step is evaluated once by
        # lowering and remains loop-invariant; its sign chooses the direction,
        # while the instruction mode preserves the source range's endpoint rule.
        # A zero step is a checked, recoverable range error rather than an empty
        # loop, matching Python's range contract.
        def evaluate_range_condition(current: RuntimeValue, high: RuntimeValue, step: RuntimeValue, mode: i64, machine: mutable Machine&) -> RuntimeValue:
            if current.kind != RuntimeValueKind.Int or high.kind != RuntimeValueKind.Int or step.kind != RuntimeValueKind.Int or mode < 0 or mode > 2:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if step.integer == 0:
                interpret_set_failure(machine, InterpretFailure.RangeStepZero)
                return runtime_void()
            if mode == 0:
                return runtime_bool(current.integer < high.integer) if step.integer > 0 else runtime_bool(current.integer > high.integer)
            if mode == 1:
                return runtime_bool(current.integer <= high.integer) if step.integer > 0 else runtime_bool(current.integer >= high.integer)
            return runtime_bool(current.integer > high.integer) if step.integer > 0 else runtime_bool(current.integer < high.integer)


        def note_observation(machine: mutable Machine&, observations: mutable darray[Observation]&, trace: u64, value: RuntimeValue) -> void can[Memory.Allocate, Abort.Panic]:
            if observations.count >= ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS:
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return
            observations.push(Observation{trace: trace, value: value})


        def note_unsupported(machine: mutable Machine&) -> void:
            interpret_set_failure(machine, InterpretFailure.UnsupportedInstruction)


        def runtime_handler_index(module: Module&, name: sview) -> usize:
            for index in 0..<module.handlers.count |module, name|:
                index return if module.handlers[index].name == name
            return module.handlers.count


        def continuation_pool_append_fits(current: usize, additional: usize, limit: usize) -> bool:
            return false if current > limit
            return additional <= limit - current


        def process_argument_count_fits(machine: Machine&, arguments: RuntimeValue) -> bool:
            return arguments.array_count.usize() <= machine.process_argument_limit


        # Check one borrowed text field before any delimiter/NUL scan or
        # terminated-buffer allocation. A zero policy means that this optional
        # byte ceiling is disabled; the aggregate argv/environment guards still
        # apply whenever a caller installs a non-zero ceiling.
        def process_text_length_fits(machine: Machine&, value: sview) -> bool:
            return true if machine.process_argument_bytes_limit == 0
            return sview_len(value) < machine.process_argument_bytes_limit


        def process_argument_bytes_add_fits(total: usize, additional: usize, limit: usize) -> bool:
            return false if total > limit
            return additional <= limit - total


        # Every POSIX argument/environment field is copied through the shared
        # terminated-buffer adapter. Account for its trailing NUL here without
        # evaluating `payload_length + 1` until the bounded subtraction proves
        # that the increment is representable under the caller's limit.
        def process_argument_cstring_bytes_add_fits(total: usize, payload_length: usize, limit: usize) -> bool:
            return false if payload_length >= limit
            return process_argument_bytes_add_fits(total, payload_length + 1, limit)


        # Check the aggregate terminated C-string payload before process
        # adapters reserve and duplicate every argument. Non-text elements are
        # left to the caller's existing type validation so this resource guard
        # never changes the diagnostic for malformed typed argv values.
        def process_argument_bytes_fits(machine: Machine&, storage: darray[RuntimeValue]&, executable: RuntimeValue, arguments: RuntimeValue) -> bool:
            return true if machine.process_argument_bytes_limit == 0
            total: mutable usize = 0
            return false if not process_argument_cstring_bytes_add_fits(total, sview_len(executable.text), machine.process_argument_bytes_limit)
            total <- total + sview_len(executable.text) + 1
            for offset in 0..<arguments.array_count.usize() |storage, arguments, machine, total|:
                argument: RuntimeValue = storage[arguments.array_start.usize() + offset]
                if argument.kind == RuntimeValueKind.Text:
                    length: usize = sview_len(argument.text)
                    return false if not process_argument_cstring_bytes_add_fits(total, length, machine.process_argument_bytes_limit)
                    total <- total + length + 1
            return true


        # Environment names and values are copied into independent owned
        # buffers by the child-spawn adapter. Bound their aggregate text before
        # that duplication; non-text entries remain the caller's type error.
        def process_environment_bytes_fits(machine: Machine&, storage: darray[RuntimeValue]&, environment: RuntimeValue) -> bool:
            return true if machine.process_argument_bytes_limit == 0 or environment.kind != RuntimeValueKind.Map
            total: mutable usize = 0
            for offset in 0..<environment.map_count.usize() |storage, environment, machine, total|:
                name: RuntimeValue = storage[environment.map_start.usize() + offset * 2]
                value: RuntimeValue = storage[environment.map_start.usize() + offset * 2 + 1]
                continue if name.kind != RuntimeValueKind.Text or value.kind != RuntimeValueKind.Text
                if name.kind == RuntimeValueKind.Text:
                    name_length: usize = sview_len(name.text)
                    return false if not process_argument_cstring_bytes_add_fits(total, name_length, machine.process_argument_bytes_limit)
                    total <- total + name_length + 1
                if value.kind == RuntimeValueKind.Text:
                    value_length: usize = sview_len(value.text)
                    # `setenv` materializes `name=value\0`, so reserve the
                    # separator in addition to both terminated fields.
                    return false if not process_argument_bytes_add_fits(total, 1, machine.process_argument_bytes_limit)
                    total <- total + 1
                    return false if not process_argument_cstring_bytes_add_fits(total, value_length, machine.process_argument_bytes_limit)
                    total <- total + value_length + 1
            return true


        def process_input_bytes_fits(machine: Machine&, input: RuntimeValue) -> bool:
            return true if machine.process_input_limit == 0
            return sview_len(input.text).u64() <= machine.process_input_limit


        def handler_covers(handler: Handler&, family: sview) -> bool:
            return any covered in handler.handles where covered == family


        # A handler with no clauses intentionally masks the whole declared
        # family. A handler that declares clauses, however, only handles the
        # exact operations named by those clauses; unmatched operations must
        # continue searching through outer dynamic handlers.
        def runtime_operation_matches(family: sview, operation: sview, operation_id: u64, clause: HandlerClause) -> bool:
            return false if clause.effect_family != family or clause.effect_operation != operation
            return true if clause.operation_id == 0 or operation_id == 0
            return clause.operation_id == operation_id


        def runtime_handler_covers_operation(handler: Handler&, family: sview, operation: sview, operation_id: u64) -> bool:
            return false if not handler_covers(handler, family)
            return true if handler.clauses.count == 0
            return any clause in handler.clauses where runtime_operation_matches(family, operation, operation_id, clause)


        def continuation_decision(policy: ContinuationPolicy, consumed: bool) -> ContinuationDecisionKind:
            cursor: mutable ContinuationPolicyCursor = ContinuationPolicyCursor{state: ContinuationPolicyState.Select, policy: policy, consumed: consumed, result: ContinuationDecisionKind.MultiShot}
            machine over cursor.state:
                state Select
                start Select

                Select, ContinuationPolicyState.Select if cursor.policy == ContinuationPolicy.Terminal:
                    cursor.result <- ContinuationDecisionKind.Terminal
                    cursor.state <- ContinuationPolicyState.Done
                    -> Select
                Select, ContinuationPolicyState.Select if cursor.policy == ContinuationPolicy.Linear and cursor.consumed:
                    cursor.result <- ContinuationDecisionKind.LinearConsumed
                    cursor.state <- ContinuationPolicyState.Done
                    -> Select
                Select, ContinuationPolicyState.Select if cursor.policy == ContinuationPolicy.Linear:
                    cursor.result <- ContinuationDecisionKind.LinearAvailable
                    cursor.state <- ContinuationPolicyState.Done
                    -> Select
                Select, ContinuationPolicyState.Select if cursor.policy == ContinuationPolicy.Affine and cursor.consumed:
                    cursor.result <- ContinuationDecisionKind.LinearConsumed
                    cursor.state <- ContinuationPolicyState.Done
                    -> Select
                Select, ContinuationPolicyState.Select if cursor.policy == ContinuationPolicy.Affine:
                    cursor.result <- ContinuationDecisionKind.LinearAvailable
                    cursor.state <- ContinuationPolicyState.Done
                    -> Select
                Select, ContinuationPolicyState.Select:
                    cursor.result <- ContinuationDecisionKind.Invalid if cursor.policy not in {ContinuationPolicy.Terminal, ContinuationPolicy.Linear, ContinuationPolicy.Affine, ContinuationPolicy.MultiReplay, ContinuationPolicy.MultiClone} else ContinuationDecisionKind.MultiShot
                    cursor.state <- ContinuationPolicyState.Done
                    -> Select

                Select, ContinuationPolicyState.Done:
                    break

            return cursor.result


        def continuation_frame_storage_valid(machine: Machine&, frame: ContinuationCallFrame&) -> bool:
            return false if frame.snapshot_count != frame.value_snapshot_count
            return false if frame.snapshot_start > machine.continuation_ids.count
            return false if frame.snapshot_count > machine.continuation_ids.count - frame.snapshot_start
            return false if frame.value_snapshot_start > machine.continuation_values.count
            return false if frame.value_snapshot_count > machine.continuation_values.count - frame.value_snapshot_start
            return false if frame.handler_snapshot_start > machine.continuation_handlers.count
            return false if frame.handler_snapshot_count > machine.continuation_handlers.count - frame.handler_snapshot_start
            return false if frame.error_guard_snapshot_count > ES_RUNTIME_DEFAULT_MAX_ERROR_GUARD_DEPTH
            return false if frame.error_guard_snapshot_start > machine.continuation_error_guards.count
            return false if frame.error_guard_snapshot_count > machine.continuation_error_guards.count - frame.error_guard_snapshot_start
            for offset in 0..<frame.error_guard_snapshot_count |machine, frame|:
                guard: ErrorGuard = machine.continuation_error_guards[frame.error_guard_snapshot_start + offset]
                return false if guard.handler_depth > frame.handler_snapshot_count
            return true


        def continuation_snapshot_values_replay_safe(machine: Machine&, values: darray[RuntimeValue]&) -> bool:
            for value in values:
                return false if value.kind == RuntimeValueKind.Array or value.kind == RuntimeValueKind.Map
            for frame in machine.active_calls:
                return false if not continuation_frame_storage_valid(machine, frame)
                for offset in 0..<frame.snapshot_count |machine, frame|:
                    value: RuntimeValue = machine.continuation_values[frame.value_snapshot_start + offset]
                    return false if value.kind == RuntimeValueKind.Array or value.kind == RuntimeValueKind.Map
            return true


        def error_guard_recoverable(failure: InterpretFailure) -> bool:
            return false if failure == InterpretFailure.InvocationContextUnavailable
            return failure in {InterpretFailure.DivisionByZero, InterpretFailure.IntegerOverflow, InterpretFailure.InvalidNumber, InterpretFailure.FileIo, InterpretFailure.Process, InterpretFailure.OutputLimit, InterpretFailure.Environment, InterpretFailure.Directory, InterpretFailure.Console, InterpretFailure.Time, InterpretFailure.RangeStepZero, InterpretFailure.InvalidShift, InterpretFailure.IndexOutOfBounds, InterpretFailure.Assertion, InterpretFailure.Raised}


        def lookup_continuation(frames: darray[ContinuationFrame]&, handler: sview) -> usize:
            cursor: mutable ContinuationLookup = ContinuationLookup{state: ContinuationLookupState.Search, index: frames.count, found: false}
            machine over cursor.state:
                state Dispatch
                start Dispatch

                Dispatch, ContinuationLookupState.Search if cursor.index == 0:
                    cursor.state <- ContinuationLookupState.Done
                    -> Dispatch
                Dispatch, ContinuationLookupState.Search if frames[cursor.index - 1].handler == handler:
                    cursor.index <- cursor.index - 1
                    cursor.found <- true
                    cursor.state <- ContinuationLookupState.Done
                    -> Dispatch
                Dispatch, ContinuationLookupState.Search:
                    cursor.index <- cursor.index - 1
                    -> Dispatch

                Dispatch, ContinuationLookupState.Done:
                    break

            return cursor.index if cursor.found else frames.count


        def request_continuation_resume(machine: mutable Machine&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, module: Module&, handler_stack: mutable darray[sview]&, instruction: Instruction, payload_id: u32, ids: darray[u32]&, values: darray[RuntimeValue]&) -> void can[Memory.Allocate, Abort.Panic]:
            if instruction.operand_count != 1:
                interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                return
            continuation_index: usize = lookup_continuation(machine.continuations, instruction.symbol)
            if continuation_index == machine.continuations.count:
                interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                return
            continuation: ContinuationFrame = machine.continuations[continuation_index]
            if instruction.resumption_id != 0 and continuation.resumption_id != 0 and instruction.resumption_id != continuation.resumption_id:
                interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                return
            payload: RuntimeValue = frame_value(ids, values, payload_id, machine)
            return if machine.failure != InterpretFailure.None
            decision: mutable ContinuationDecision = ContinuationDecision{kind: continuation_decision(continuation.policy, continuation.consumed), failure: InterpretFailure.None, accepted: false, tail_resume: false}
            machine over decision.kind:
                state Dispatch
                start Dispatch

                Dispatch, ContinuationDecisionKind.Terminal:
                    decision.failure <- InterpretFailure.InvalidContinuation
                    break

                Dispatch, ContinuationDecisionKind.LinearAvailable:
                    decision.accepted <- true
                    decision.tail_resume <- true
                    break

                Dispatch, ContinuationDecisionKind.LinearConsumed:
                    decision.failure <- InterpretFailure.InvalidContinuation
                    break

                Dispatch, ContinuationDecisionKind.MultiShot:
                    decision.accepted <- true
                    break

                Dispatch, ContinuationDecisionKind.Invalid:
                    decision.failure <- InterpretFailure.InvalidContinuation
                    break

            if decision.failure != InterpretFailure.None:
                machine.failure <- decision.failure
                return
            if continuation.policy in {ContinuationPolicy.MultiReplay, ContinuationPolicy.MultiClone} and not continuation_snapshot_values_replay_safe(machine, values):
                interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                return
            if continuation.replay_count == 0:
                interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                return
            if continuation.replay_start > machine.continuation_frames.count:
                interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                return
            if continuation.replay_count > machine.continuation_frames.count - continuation.replay_start:
                interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                return
            if continuation.resumptions >= ContinuationLimits::RESUMPTIONS or continuation.resumptions == 4294967295:
                interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                return
            machine.continuations[continuation_index].consumed <- true if decision.tail_resume
            machine.continuations[continuation_index].resumptions <- machine.continuations[continuation_index].resumptions + 1
            if decision.tail_resume:
                machine.resume_value <- payload
                machine.resume_requested <- true
                return
            empty_arguments: darray[RuntimeValue] = []
            replay_value: mutable RuntimeValue = payload
            for frame_offset in 0..<continuation.replay_count |machine, continuation, frame_offset, replay_value, observations, storage, module, empty_arguments|:
                replay_frame: ContinuationCallFrame = machine.continuation_frames[continuation.replay_start + frame_offset]
                if not continuation_frame_storage_valid(machine, replay_frame):
                    interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                    return
                replay_ids: mutable darray[u32] = []
                replay_values: mutable darray[RuntimeValue] = []
                replay_handlers: mutable darray[sview] = []
                replay_error_guards: mutable darray[ErrorGuard] = []
                for offset in 0..<replay_frame.snapshot_count |replay_ids, replay_values, machine, replay_frame|:
                    replay_ids.push(machine.continuation_ids[replay_frame.snapshot_start + offset])
                    replay_values.push(machine.continuation_values[replay_frame.value_snapshot_start + offset])
                for offset in 0..<replay_frame.handler_snapshot_count |replay_handlers, machine, replay_frame|:
                    replay_handlers.push(machine.continuation_handlers[replay_frame.handler_snapshot_start + offset])
                for offset in 0..<replay_frame.error_guard_snapshot_count |replay_error_guards, machine, replay_frame|:
                    replay_error_guards.push(machine.continuation_error_guards[replay_frame.error_guard_snapshot_start + offset])
                if replay_frame.result_id != 0 and machine.failure == InterpretFailure.None:
                    set_frame_value(replay_ids, replay_values, replay_frame.result_id, replay_value)
                machine.resume_value <- execute_function(machine, observations, storage, replay_handlers, module, replay_frame.function_index, empty_arguments, replay_frame.resume_block, replay_frame.resume_instruction, replay_ids, replay_values, replay_error_guards, true)
                return if machine.failure != InterpretFailure.None and not error_guard_recoverable(machine.failure)
                replay_value <- machine.resume_value if machine.failure == InterpretFailure.None
            machine.resume_requested <- false


        def pop_runtime_handler(machine: mutable Machine&, handler_stack: mutable darray[sview]&, expected: sview) -> void:
            if handler_stack.count == 0 or handler_stack[handler_stack.count - 1] != expected:
                interpret_set_failure(machine, InterpretFailure.InvalidControlFlow)
                return
            _ = handler_stack.pop()


        def evaluate_call(machine: mutable Machine&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handler_stack: mutable darray[sview]&, error_guards: mutable darray[ErrorGuard]&, module: Module&, fn: Function&, function_index: usize, current_block: u32, instruction_index: usize, instruction: Instruction, ids: darray[u32]&, values: darray[RuntimeValue]&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            callee_index: usize = find_function(module, instruction.symbol)
            call_arguments: mutable darray[RuntimeValue] = []
            for offset in 0..<instruction.operand_count.usize() |machine, fn, instruction, ids, values, call_arguments|:
                call_arguments.push(frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + offset], machine))
            if not continuation_pool_append_fits(machine.continuation_ids.count, ids.count, ContinuationLimits::VALUES) or not continuation_pool_append_fits(machine.continuation_values.count, values.count, ContinuationLimits::VALUES) or not continuation_pool_append_fits(machine.continuation_handlers.count, handler_stack.count, ContinuationLimits::VALUES) or not continuation_pool_append_fits(machine.continuation_error_guards.count, error_guards.count, ContinuationLimits::VALUES) or not continuation_pool_append_fits(machine.active_calls.count, 1, ContinuationLimits::FRAMES):
                interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                return runtime_void()
            snapshot_start: usize = machine.continuation_ids.count
            value_snapshot_start: usize = machine.continuation_values.count
            handler_snapshot_start: usize = machine.continuation_handlers.count
            error_guard_snapshot_start: usize = machine.continuation_error_guards.count
            machine.continuation_ids.extend(ids)
            machine.continuation_values.extend(values)
            machine.continuation_handlers.extend(handler_stack)
            machine.continuation_error_guards.extend(error_guards)
            machine.active_calls.push(ContinuationCallFrame{function_index: function_index, resume_block: current_block, resume_instruction: instruction_index + 1, result_id: instruction.result, snapshot_start: snapshot_start, snapshot_count: ids.count, value_snapshot_start: value_snapshot_start, value_snapshot_count: values.count, handler_snapshot_start: handler_snapshot_start, handler_snapshot_count: handler_stack.count, error_guard_snapshot_start: error_guard_snapshot_start, error_guard_snapshot_count: error_guards.count})
            result: RuntimeValue = execute_function(machine, observations, storage, handler_stack, module, callee_index, call_arguments) if machine.failure == InterpretFailure.None else runtime_void()
            _ = machine.active_calls.pop()
            # A completed direct call cannot be resumed unless it was captured
            # by an enclosing effect. Any such enclosing callback has already
            # finished before this call returns, so reclaim this call's suffix
            # while preserving the outer caller's prefix.
            machine.continuation_ids.truncate(snapshot_start)
            machine.continuation_values.truncate(value_snapshot_start)
            machine.continuation_handlers.truncate(handler_snapshot_start)
            machine.continuation_error_guards.truncate(error_guard_snapshot_start)
            return result


        def invoke_perform(machine: mutable Machine&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handler_stack: mutable darray[sview]&, error_guards: mutable darray[ErrorGuard]&, module: Module&, fn: Function&, function_index: usize, current_block: u32, instruction_index: usize, instruction: Instruction, ids: darray[u32]&, values: darray[RuntimeValue]&, handler_index: usize, clause_index: usize) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            arguments: mutable darray[RuntimeValue] = []
            for offset in 0..<instruction.operand_count.usize() |machine, fn, instruction, ids, values, arguments|:
                arguments.push(frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + offset], machine))
            callback_index: usize = find_function(module, module.handlers[handler_index].clauses[clause_index].function)
            policy: ContinuationPolicy = module.handlers[handler_index].continuation
            if policy in {ContinuationPolicy.MultiReplay, ContinuationPolicy.MultiClone} and not continuation_snapshot_values_replay_safe(machine, values):
                interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                return runtime_void()
            if machine.active_calls.count >= ContinuationLimits::FRAMES:
                interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                return runtime_void()
            replay_frames_needed: usize = machine.active_calls.count + 1
            if not continuation_pool_append_fits(machine.continuation_ids.count, ids.count, ContinuationLimits::VALUES) or not continuation_pool_append_fits(machine.continuation_values.count, values.count, ContinuationLimits::VALUES) or not continuation_pool_append_fits(machine.continuation_handlers.count, handler_stack.count, ContinuationLimits::VALUES) or not continuation_pool_append_fits(machine.continuation_error_guards.count, error_guards.count, ContinuationLimits::VALUES) or not continuation_pool_append_fits(machine.continuation_frames.count, replay_frames_needed, ContinuationLimits::FRAMES) or not continuation_pool_append_fits(machine.continuations.count, 1, ContinuationLimits::FRAMES):
                interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                return runtime_void()
            snapshot_start: usize = machine.continuation_ids.count
            value_snapshot_start: usize = machine.continuation_values.count
            handler_snapshot_start: usize = machine.continuation_handlers.count
            error_guard_snapshot_start: usize = machine.continuation_error_guards.count
            machine.continuation_ids.extend(ids)
            machine.continuation_values.extend(values)
            machine.continuation_handlers.extend(handler_stack)
            machine.continuation_error_guards.extend(error_guards)
            replay_start: usize = machine.continuation_frames.count
            machine.continuation_frames.push(ContinuationCallFrame{function_index: function_index, resume_block: current_block, resume_instruction: instruction_index + 1, result_id: instruction.result, snapshot_start: snapshot_start, snapshot_count: ids.count, value_snapshot_start: value_snapshot_start, value_snapshot_count: values.count, handler_snapshot_start: handler_snapshot_start, handler_snapshot_count: handler_stack.count, error_guard_snapshot_start: error_guard_snapshot_start, error_guard_snapshot_count: error_guards.count})
            active_index: mutable usize = machine.active_calls.count
            while active_index > 0 |machine, active_index|:
                active_index <- active_index - 1
                machine.continuation_frames.push(machine.active_calls[active_index])
            replay_count: usize = machine.continuation_frames.count - replay_start
            machine.continuations.push(ContinuationFrame{handler: module.handlers[handler_index].name, resumption_id: effect_operation_identity("Resume", module.handlers[handler_index].name), policy: module.handlers[handler_index].continuation, consumed: false, resumptions: 0, replay_start: replay_start, replay_count: replay_count})
            callback_value: RuntimeValue = execute_function(machine, observations, storage, handler_stack, module, callback_index, arguments)
            _ = machine.continuations.pop()
            # No continuation can outlive the dynamic handler callback. Reclaim
            # its replay frames and copied snapshots while preserving any outer
            # call's prefix in the shared pools.
            machine.continuation_frames.truncate(replay_start)
            machine.continuation_ids.truncate(snapshot_start)
            machine.continuation_values.truncate(value_snapshot_start)
            machine.continuation_handlers.truncate(handler_snapshot_start)
            machine.continuation_error_guards.truncate(error_guard_snapshot_start)
            result: mutable RuntimeValue = callback_value
            if machine.resume_requested:
                result <- machine.resume_value
                machine.resume_requested <- false
            return result


        def evaluate_perform(machine: mutable Machine&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handler_stack: mutable darray[sview]&, error_guards: mutable darray[ErrorGuard]&, module: Module&, fn: Function&, function_index: usize, current_block: u32, instruction_index: usize, instruction: Instruction, ids: darray[u32]&, values: darray[RuntimeValue]&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            cursor: mutable PerformDispatch = PerformDispatch{state: PerformDispatchState.SearchHandler, installed_index: handler_stack.count, handler_index: module.handlers.count, clause_index: 0, result: runtime_void()}
            machine over cursor.state:
                state Dispatch
                start Dispatch

                Dispatch, PerformDispatchState.SearchHandler if cursor.installed_index == 0:
                    note_unsupported(machine)
                    cursor.state <- PerformDispatchState.Done
                    -> Dispatch
                Dispatch, PerformDispatchState.SearchHandler:
                    cursor.installed_index <- cursor.installed_index - 1
                    cursor.handler_index <- runtime_handler_index(module, handler_stack[cursor.installed_index])
                    cursor.state <- PerformDispatchState.SearchClause if cursor.handler_index < module.handlers.count and runtime_handler_covers_operation(module.handlers[cursor.handler_index], instruction.effect_family, instruction.effect_operation, instruction.operation_id) else PerformDispatchState.SearchHandler
                    -> Dispatch

                Dispatch, PerformDispatchState.SearchClause if cursor.clause_index >= module.handlers[cursor.handler_index].clauses.count:
                    note_unsupported(machine)
                    cursor.state <- PerformDispatchState.Done
                    -> Dispatch
                Dispatch, PerformDispatchState.SearchClause if runtime_operation_matches(instruction.effect_family, instruction.effect_operation, instruction.operation_id, module.handlers[cursor.handler_index].clauses[cursor.clause_index]):
                    cursor.state <- PerformDispatchState.Invoke
                    -> Dispatch
                Dispatch, PerformDispatchState.SearchClause:
                    cursor.clause_index <- cursor.clause_index + 1
                    -> Dispatch

                Dispatch, PerformDispatchState.Invoke:
                    cursor.result <- invoke_perform(machine, observations, storage, handler_stack, error_guards, module, fn, function_index, current_block, instruction_index, instruction, ids, values, cursor.handler_index, cursor.clause_index)
                    cursor.state <- PerformDispatchState.Done
                    -> Dispatch

                Dispatch, PerformDispatchState.Done:
                    break

            return cursor.result


        def evaluate_array(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, fn: Function&, instruction: Instruction, ids: darray[u32]&, values: darray[RuntimeValue]&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if not runtime_storage_span_u32_valid(storage, instruction.operand_count.usize()):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            storage_start: usize = storage.count
            start: u32 = storage.count.u32()
            for offset in 0..<instruction.operand_count.usize() |machine, storage, fn, instruction, ids, values|:
                value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + offset], machine)
                if machine.failure != InterpretFailure.None:
                    storage.truncate(storage_start)
                    return runtime_void()
                storage.push(value)
            return runtime_array(start, instruction.operand_count.u32())


        def evaluate_map(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, fn: Function&, instruction: Instruction, ids: darray[u32]&, values: darray[RuntimeValue]&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if instruction.operand_count % 2 != 0:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_storage_span_u32_valid(storage, instruction.operand_count.usize()):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            storage_start: usize = storage.count
            start: u32 = storage.count.u32()
            for offset in 0..<instruction.operand_count.usize() |machine, storage, fn, instruction, ids, values|:
                value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + offset], machine)
                if machine.failure != InterpretFailure.None:
                    storage.truncate(storage_start)
                    return runtime_void()
                storage.push(value)
            return runtime_map(start, (instruction.operand_count / 2).u32())


        def evaluate_map_keys(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, collection: RuntimeValue) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Map:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_map_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if not runtime_storage_span_u32_valid(storage, collection.map_count.usize()):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            start: u32 = storage.count.u32()
            for offset in 0..<collection.map_count.usize() |storage, collection|:
                storage.push(storage[collection.map_start.usize() + offset * 2])
            return runtime_array(start, collection.map_count)


        def evaluate_map_values(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, collection: RuntimeValue) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Map:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_map_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if not runtime_storage_span_u32_valid(storage, collection.map_count.usize()):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            start: u32 = storage.count.u32()
            for offset in 0..<collection.map_count.usize() |storage, collection|:
                storage.push(storage[collection.map_start.usize() + offset * 2 + 1])
            return runtime_array(start, collection.map_count)


        def evaluate_index(machine: mutable Machine&, storage: darray[RuntimeValue]&, collection: RuntimeValue, index: RuntimeValue) -> RuntimeValue:
            if collection.kind == RuntimeValueKind.Map:
                if not runtime_map_range_valid(storage, collection):
                    interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                    return runtime_void()
                for offset in 0..<collection.map_count.usize() |machine, storage, collection, index|:
                    key: RuntimeValue = storage[collection.map_start.usize() + offset * 2]
                    return storage[collection.map_start.usize() + offset * 2 + 1] if runtime_values_equal(storage, key, index)
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if index.kind != RuntimeValueKind.Int or (collection.kind not in {RuntimeValueKind.Array, RuntimeValueKind.Text}):
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if collection.kind == RuntimeValueKind.Array and not runtime_array_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            length: i64 = collection.array_count.i64() if collection.kind == RuntimeValueKind.Array else sview_len(collection.text).i64()
            normalized: mutable i64 = index.integer
            normalized <- normalized + length if normalized < 0
            if normalized < 0 or normalized >= length:
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            return runtime_text(collection.text[normalized.usize():normalized.usize() + 1]) if collection.kind == RuntimeValueKind.Text
            return storage[collection.array_start.usize() + normalized.usize()]


        # Check a collection index without raising for an ordinary miss.  This is the
        # predicate used by lazy `get collection[index] else fallback` lowering; malformed
        # storage and mismatched runtime values remain typed interpreter failures.
        def evaluate_index_valid(machine: mutable Machine&, storage: darray[RuntimeValue]&, collection: RuntimeValue, index: RuntimeValue) -> RuntimeValue:
            if collection.kind == RuntimeValueKind.Map:
                if not runtime_map_range_valid(storage, collection):
                    interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                    return runtime_void()
                for offset in 0..<collection.map_count.usize() |storage, collection, index|:
                    key: RuntimeValue = storage[collection.map_start.usize() + offset * 2]
                    return runtime_bool(true) if runtime_values_equal(storage, key, index)
                return runtime_bool(false)
            if collection.kind != RuntimeValueKind.Array and collection.kind != RuntimeValueKind.Text or index.kind != RuntimeValueKind.Int:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if collection.kind == RuntimeValueKind.Array and not runtime_array_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            length: i64 = collection.array_count.i64() if collection.kind == RuntimeValueKind.Array else sview_len(collection.text).i64()
            normalized: mutable i64 = index.integer
            normalized <- normalized + length if normalized < 0
            return runtime_bool(normalized >= 0 and normalized < length)


        # Extract one element from a dynamically-sized array only when its
        # runtime arity matches the statically lowered destructuring pattern.
        # This keeps unpacking simultaneous and checked: a short or long array
        # raises the same typed IndexOutOfBounds failure used by ordinary
        # indexing, and no target is mutated before all elements are read.
        def evaluate_unpack_array(machine: mutable Machine&, storage: darray[RuntimeValue]&, collection: RuntimeValue, index: RuntimeValue, expected_count: i64) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Array or index.kind != RuntimeValueKind.Int:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if expected_count <= 0 or collection.array_count.i64() != expected_count or index.integer < 0 or index.integer >= expected_count:
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if not runtime_array_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            return storage[collection.array_start.usize() + index.integer.usize()]


        def evaluate_length(machine: mutable Machine&, collection: RuntimeValue) -> RuntimeValue:
            if collection.kind not in {RuntimeValueKind.Array, RuntimeValueKind.Map, RuntimeValueKind.Text}:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            return runtime_int(sview_len(collection.text).i64()) if collection.kind == RuntimeValueKind.Text
            return runtime_int(collection.map_count.i64()) if collection.kind == RuntimeValueKind.Map
            return runtime_int(collection.array_count.i64())


        def evaluate_slice(machine: mutable Machine&, storage: darray[RuntimeValue]&, collection: RuntimeValue, low: RuntimeValue, high: RuntimeValue) -> RuntimeValue:
            if (collection.kind not in {RuntimeValueKind.Array, RuntimeValueKind.Text}) or low.kind != RuntimeValueKind.Int or high.kind != RuntimeValueKind.Int:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if collection.kind == RuntimeValueKind.Array and not runtime_array_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            length: i64 = collection.array_count.i64() if collection.kind == RuntimeValueKind.Array else sview_len(collection.text).i64()
            if low.integer < 0 or high.integer < low.integer or high.integer > length:
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            return runtime_text(collection.text[low.integer.usize():high.integer.usize()]) if collection.kind == RuntimeValueKind.Text
            if not runtime_array_subslice_start_valid(collection, low.integer.usize()):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            return runtime_array(collection.array_start + low.integer.u32(), (high.integer - low.integer).u32())


        def evaluate_pop_array_value(machine: mutable Machine&, storage: darray[RuntimeValue]&, collection: RuntimeValue, index: RuntimeValue, has_index: bool) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Array:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_array_range_valid(storage, collection) or collection.array_count == 0:
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if has_index and index.kind != RuntimeValueKind.Int:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            normalized: mutable i64 = collection.array_count.i64() - 1
            if has_index:
                normalized <- index.integer
                normalized <- normalized + collection.array_count.i64() if normalized < 0
            if normalized < 0 or normalized >= collection.array_count.i64():
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            return storage[collection.array_start.usize() + normalized.usize()]


        def evaluate_pop_array(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, collection: RuntimeValue, index: RuntimeValue, has_index: bool) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Array:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_array_range_valid(storage, collection) or collection.array_count == 0:
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if has_index and index.kind != RuntimeValueKind.Int:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            normalized: mutable i64 = collection.array_count.i64() - 1
            if has_index:
                normalized <- index.integer
                normalized <- normalized + collection.array_count.i64() if normalized < 0
            if normalized < 0 or normalized >= collection.array_count.i64():
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            return runtime_array(collection.array_start, collection.array_count - 1) if normalized == collection.array_count.i64() - 1
            if not runtime_storage_span_u32_valid(storage, collection.array_count.usize() - 1):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            start: u32 = storage.count.u32()
            storage.reserve(storage.count + collection.array_count.usize() - 1)
            for offset in 0..<collection.array_count.usize() |storage, collection, normalized|:
                storage.push(storage[collection.array_start.usize() + offset]) if offset.i64() != normalized
            return runtime_array(start, collection.array_count - 1)


        def evaluate_pop_map_value(machine: mutable Machine&, storage: darray[RuntimeValue]&, collection: RuntimeValue, key: RuntimeValue, default_value: RuntimeValue, has_default: bool) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Map:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_map_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            for offset in 0..<collection.map_count.usize() |machine, storage, collection, key|:
                stored_key: RuntimeValue = storage[collection.map_start.usize() + offset * 2]
                if runtime_values_equal(storage, stored_key, key):
                    return storage[collection.map_start.usize() + offset * 2 + 1]
            return default_value if has_default
            interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
            return runtime_void()


        def evaluate_pop_map(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, collection: RuntimeValue, key: RuntimeValue) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Map:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_map_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            found: mutable bool = false
            for offset in 0..<collection.map_count.usize() |machine, storage, collection, key, found|:
                stored_key: RuntimeValue = storage[collection.map_start.usize() + offset * 2]
                if runtime_values_equal(storage, stored_key, key):
                    found <- true
            return collection if not found
            if not runtime_storage_pairs_u32_valid(storage, collection.map_count.usize() - 1):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            start: u32 = storage.count.u32()
            remaining: mutable u32 = 0
            for offset in 0..<collection.map_count.usize() |machine, storage, collection, key, start, remaining|:
                stored_key: RuntimeValue = storage[collection.map_start.usize() + offset * 2]
                stored_value: RuntimeValue = storage[collection.map_start.usize() + offset * 2 + 1]
                if not runtime_values_equal(storage, stored_key, key):
                    storage.push(stored_key)
                    storage.push(stored_value)
                    remaining <- remaining + 1
            return runtime_map(start, remaining)


        def evaluate_setdefault_map_value(machine: mutable Machine&, storage: darray[RuntimeValue]&, collection: RuntimeValue, key: RuntimeValue, default_value: RuntimeValue) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Map:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_map_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            for offset in 0..<collection.map_count.usize() |machine, storage, collection, key|:
                stored_key: RuntimeValue = storage[collection.map_start.usize() + offset * 2]
                if runtime_values_equal(storage, stored_key, key):
                    return storage[collection.map_start.usize() + offset * 2 + 1]
            return default_value


        def evaluate_setdefault_map(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, collection: RuntimeValue, key: RuntimeValue, default_value: RuntimeValue) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Map:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_map_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            for offset in 0..<collection.map_count.usize() |machine, storage, collection, key|:
                stored_key: RuntimeValue = storage[collection.map_start.usize() + offset * 2]
                return collection if runtime_values_equal(storage, stored_key, key)
            if collection.map_count == 4294967295u32:
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            if not runtime_storage_pairs_u32_valid(storage, collection.map_count.usize() + 1):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            start: u32 = storage.count.u32()
            for offset in 0..<collection.map_count.usize() |storage, collection|:
                storage.push(storage[collection.map_start.usize() + offset * 2])
                storage.push(storage[collection.map_start.usize() + offset * 2 + 1])
            storage.push(key)
            storage.push(default_value)
            return runtime_map(start, collection.map_count + 1)


        def evaluate_reverse_array(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, collection: RuntimeValue) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Array:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_array_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if not runtime_storage_span_u32_valid(storage, collection.array_count.usize()):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            result_start: u32 = storage.count.u32()
            storage.reserve(storage.count + collection.array_count.usize())
            for offset in 0..<collection.array_count.usize() |storage, collection|:
                storage.push(storage[collection.array_start.usize() + collection.array_count.usize() - offset - 1])
            return runtime_array(result_start, collection.array_count)


        def evaluate_insert_array(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, collection: RuntimeValue, index: RuntimeValue, value: RuntimeValue) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Array or index.kind != RuntimeValueKind.Int:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_array_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            length: i64 = collection.array_count.i64()
            insertion: mutable i64 = index.integer
            if insertion < 0:
                if insertion < -length:
                    insertion <- 0
                else:
                    insertion <- length + insertion
            insertion <- length if insertion > length
            if collection.array_count == 4294967295u32:
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            if not runtime_storage_span_u32_valid(storage, collection.array_count.usize() + 1):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            result_start: u32 = storage.count.u32()
            for offset in 0..<collection.array_count.usize() |storage, collection, insertion, value|:
                storage.push(value) if offset.i64() == insertion
                storage.push(storage[collection.array_start.usize() + offset])
            storage.push(value) if insertion == length
            return runtime_array(result_start, collection.array_count + 1)


        def evaluate_copy_array(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, collection: RuntimeValue) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Array:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_array_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if not runtime_storage_span_u32_valid(storage, collection.array_count.usize()):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            result_start: u32 = storage.count.u32()
            storage.reserve(storage.count + collection.array_count.usize())
            for offset in 0..<collection.array_count.usize() |storage, collection|:
                storage.push(storage[collection.array_start.usize() + offset])
            return runtime_array(result_start, collection.array_count)


        def evaluate_copy_map(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, collection: RuntimeValue) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Map:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_map_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if not runtime_storage_pairs_u32_valid(storage, collection.map_count.usize()):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            result_start: u32 = storage.count.u32()
            for offset in 0..<collection.map_count.usize() |storage, collection|:
                storage.push(storage[collection.map_start.usize() + offset * 2])
                storage.push(storage[collection.map_start.usize() + offset * 2 + 1])
            return runtime_map(result_start, collection.map_count)


        def text_contains(haystack: sview, needle: sview) -> bool:
            needle_length: usize = sview_len(needle)
            haystack_length: usize = sview_len(haystack)
            true return if needle_length == 0
            false return if needle_length > haystack_length
            for start in 0..=haystack_length - needle_length |haystack, needle, needle_length|:
                matched: mutable bool = true
                for offset in 0..<needle_length |haystack, needle, start, matched|:
                    matched <- false if sview_at(haystack, start + offset) != sview_at(needle, offset)
                true return if matched
            return false


        def text_starts_with(haystack: sview, prefix: sview) -> bool:
            prefix_length: usize = sview_len(prefix)
            false return if prefix_length > sview_len(haystack)
            for offset in 0..<prefix_length |haystack, prefix|:
                false return if sview_at(haystack, offset) != sview_at(prefix, offset)
            return true


        def text_ends_with(haystack: sview, suffix: sview) -> bool:
            suffix_length: usize = sview_len(suffix)
            haystack_length: usize = sview_len(haystack)
            false return if suffix_length > haystack_length
            start: usize = haystack_length - suffix_length
            for offset in 0..<suffix_length |haystack, suffix, start|:
                false return if sview_at(haystack, start + offset) != sview_at(suffix, offset)
            return true


        def text_count(machine: mutable Machine&, haystack: sview, needle: sview) -> usize:
            haystack_length: usize = sview_len(haystack)
            needle_length: usize = sview_len(needle)
            if needle_length == 0:
                if haystack_length.u64() >= 9223372036854775807u64:
                    interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                    return 0
                return haystack_length + 1
            count: mutable usize = 0
            cursor: mutable usize = 0
            while cursor <= haystack_length and needle_length <= haystack_length - cursor |haystack, needle, haystack_length, needle_length, count, cursor|:
                matched: mutable bool = true
                for offset in 0..<needle_length |haystack, needle, cursor, matched|:
                    matched <- false if sview_at(haystack, cursor + offset) != sview_at(needle, offset)
                if matched:
                    count <- count + 1
                    cursor <- cursor + needle_length
                else:
                    cursor <- cursor + 1
            return count


        def text_find(haystack: sview, needle: sview) -> i64:
            haystack_length: usize = sview_len(haystack)
            needle_length: usize = sview_len(needle)
            return 0 if needle_length == 0
            return -1 if needle_length > haystack_length
            for start in 0..=haystack_length - needle_length |haystack, needle, needle_length|:
                matched: mutable bool = true
                for offset in 0..<needle_length |haystack, needle, start, matched|:
                    matched <- false if sview_at(haystack, start + offset) != sview_at(needle, offset)
                return start.i64() if matched
            return -1


        def text_rfind(haystack: sview, needle: sview) -> i64:
            haystack_length: usize = sview_len(haystack)
            needle_length: usize = sview_len(needle)
            return haystack_length.i64() if needle_length == 0
            return -1 if needle_length > haystack_length
            last: mutable i64 = -1
            for start in 0..=haystack_length - needle_length |haystack, needle, needle_length, last|:
                matched: mutable bool = true
                for offset in 0..<needle_length |haystack, needle, start, matched|:
                    matched <- false if sview_at(haystack, start + offset) != sview_at(needle, offset)
                last <- start.i64() if matched
            return last


        # The scripting profile is byte-oriented.  `isdecimal` and `isnumeric`
        # therefore intentionally share the ASCII decimal rule, while
        # `isprintable` accepts the visible ASCII range only; this avoids
        # locale/Unicode-version differences between backends.
        def text_is_predicate(value: sview, mode: i64) -> bool:
            length: usize = sview_len(value)
            return true if mode == 6 and length == 0
            false return if length == 0
            all_digits: mutable bool = true
            all_alpha: mutable bool = true
            all_alnum: mutable bool = true
            all_space: mutable bool = true
            all_lower: mutable bool = true
            all_upper: mutable bool = true
            has_alpha: mutable bool = false
            all_ascii: mutable bool = true
            all_printable: mutable bool = true
            for index in 0..<length |value, all_digits, all_alpha, all_alnum, all_space, all_lower, all_upper, has_alpha, all_ascii, all_printable|:
                byte: u8 = sview_at(value, index)
                digit: bool = byte >= 48 and byte <= 57
                alpha: bool = (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)
                all_digits <- false if not digit
                all_alpha <- false if not alpha
                all_alnum <- false if not digit and not alpha
                all_space <- false if not text_ascii_whitespace(byte)
                has_alpha <- true if alpha
                all_lower <- false if byte >= 65 and byte <= 90
                all_upper <- false if byte >= 97 and byte <= 122
                all_ascii <- false if byte > 127
                all_printable <- false if byte < 32 or byte > 126
            return all_digits if mode == 0 or mode == 7 or mode == 8
            return all_alpha if mode == 1
            return all_alnum if mode == 2
            return all_space if mode == 3
            return has_alpha and all_lower if mode == 4
            return has_alpha and all_upper if mode == 5
            return all_ascii if mode == 6
            return all_printable


        def evaluate_text_boundary(machine: mutable Machine&, text_value: RuntimeValue, boundary: RuntimeValue, starts: bool) -> RuntimeValue:
            if text_value.kind != RuntimeValueKind.Text or boundary.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            return runtime_bool(text_starts_with(text_value.text, boundary.text)) if starts
            return runtime_bool(text_ends_with(text_value.text, boundary.text))


        def evaluate_text_remove_boundary(machine: mutable Machine&, text_value: RuntimeValue, boundary: RuntimeValue, starts: bool) -> RuntimeValue:
            if text_value.kind != RuntimeValueKind.Text or boundary.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            boundary_length: usize = sview_len(boundary.text)
            text_length: usize = sview_len(text_value.text)
            if starts:
                return runtime_text(text_value.text[boundary_length:text_length]) if text_starts_with(text_value.text, boundary.text)
                return runtime_text(text_value.text)
            return runtime_text(text_value.text[0:text_length - boundary_length]) if text_ends_with(text_value.text, boundary.text)
            return runtime_text(text_value.text)


        def evaluate_text_count(machine: mutable Machine&, text_value: RuntimeValue, needle: RuntimeValue) -> RuntimeValue:
            if text_value.kind != RuntimeValueKind.Text or needle.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            count: usize = text_count(machine, text_value.text, needle.text)
            return runtime_void() if machine.failure != InterpretFailure.None
            if count.u64() > 9223372036854775807u64:
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            return runtime_int(count.i64())


        def evaluate_array_count(machine: mutable Machine&, storage: darray[RuntimeValue]&, collection: RuntimeValue, needle: RuntimeValue) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Array:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_array_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            # Array cardinalities are stored as u32, but the public integer
            # result is i64.  Keep the accumulator wide so a full u32-sized
            # array cannot wrap back to zero while counting matching values.
            count: mutable i64 = 0
            for offset in 0..<collection.array_count.usize() |machine, storage, collection, needle, count|:
                count <- count + 1 if runtime_values_equal(storage, storage[collection.array_start.usize() + offset], needle)
            return runtime_int(count)


        def evaluate_text_find(machine: mutable Machine&, text_value: RuntimeValue, needle: RuntimeValue) -> RuntimeValue:
            if text_value.kind != RuntimeValueKind.Text or needle.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            return runtime_int(text_find(text_value.text, needle.text))


        def evaluate_array_find(machine: mutable Machine&, storage: darray[RuntimeValue]&, collection: RuntimeValue, needle: RuntimeValue) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Array:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_array_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            for offset in 0..<collection.array_count.usize() |machine, storage, collection, needle|:
                return runtime_int(offset.i64()) if runtime_values_equal(storage, storage[collection.array_start.usize() + offset], needle)
            return runtime_int(-1)


        def evaluate_array_index(machine: mutable Machine&, storage: darray[RuntimeValue]&, collection: RuntimeValue, needle: RuntimeValue) -> RuntimeValue:
            result: RuntimeValue = evaluate_array_find(machine, storage, collection, needle)
            return runtime_void() if machine.failure != InterpretFailure.None
            if result.integer < 0:
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            return result


        def evaluate_remove_array(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, collection: RuntimeValue, needle: RuntimeValue) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Array:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_array_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            removed: mutable i64 = -1
            for offset in 0..<collection.array_count.usize() |machine, storage, collection, needle, removed|:
                if removed < 0 and runtime_values_equal(storage, storage[collection.array_start.usize() + offset], needle):
                    removed <- offset.i64()
            if removed < 0:
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if not runtime_storage_span_u32_valid(storage, collection.array_count.usize() - 1):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            result_start: u32 = storage.count.u32()
            storage.reserve(storage.count + collection.array_count.usize() - 1)
            for offset in 0..<collection.array_count.usize() |storage, collection, removed|:
                storage.push(storage[collection.array_start.usize() + offset]) if offset.i64() != removed
            return runtime_array(result_start, collection.array_count - 1)


        def runtime_text_less(left: sview, right: sview) -> bool:
            left_length: usize = sview_len(left)
            right_length: usize = sview_len(right)
            common: usize = left_length if left_length < right_length else right_length
            for offset in 0..<common |left, right|:
                return true if sview_at(left, offset) < sview_at(right, offset)
                return false if sview_at(left, offset) > sview_at(right, offset)
            return left_length < right_length


        def runtime_value_less(machine: mutable Machine&, left: RuntimeValue, right: RuntimeValue) -> bool:
            if left.kind != right.kind:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return false
            return left.boolean == false and right.boolean == true if left.kind == RuntimeValueKind.Bool
            return left.integer < right.integer if left.kind == RuntimeValueKind.Int
            return left.decimal < right.decimal if left.kind == RuntimeValueKind.Float
            return runtime_text_less(left.text, right.text) if left.kind == RuntimeValueKind.Text
            interpret_set_failure(machine, InterpretFailure.TypeMismatch)
            return false


        def evaluate_sort_array(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, collection: RuntimeValue) -> RuntimeValue:
            if collection.kind != RuntimeValueKind.Array:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_array_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if not runtime_storage_span_u32_valid(storage, collection.array_count.usize()):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            first_kind: mutable RuntimeValueKind = RuntimeValueKind.Void
            for offset in 0..<collection.array_count.usize() |machine, storage, collection, first_kind|:
                value: RuntimeValue = storage[collection.array_start.usize() + offset]
                if value.kind not in {RuntimeValueKind.Bool, RuntimeValueKind.Int, RuntimeValueKind.Float, RuntimeValueKind.Text}:
                    interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                    return runtime_void()
                first_kind <- value.kind if offset == 0
                if offset > 0 and value.kind != first_kind:
                    interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                    return runtime_void()
            result_start: u32 = storage.count.u32()
            storage.reserve(storage.count + collection.array_count.usize())
            for offset in 0..<collection.array_count.usize() |storage, collection|:
                storage.push(storage[collection.array_start.usize() + offset])
            for offset in 1..<collection.array_count.usize() |machine, storage, result_start|:
                current: RuntimeValue = storage[result_start.usize() + offset]
                cursor: mutable usize = offset
                while cursor > 0 |machine, storage, result_start, current, cursor|:
                    previous: RuntimeValue = storage[result_start.usize() + cursor - 1]
                    should_move: bool = runtime_value_less(machine, current, previous)
                    break if machine.failure != InterpretFailure.None or not should_move
                    storage[result_start.usize() + cursor] <- previous
                    cursor <- cursor - 1
                return runtime_void() if machine.failure != InterpretFailure.None
                storage[result_start.usize() + cursor] <- current
            return runtime_array(result_start, collection.array_count)


        def evaluate_text_rfind(machine: mutable Machine&, text_value: RuntimeValue, needle: RuntimeValue) -> RuntimeValue:
            if text_value.kind != RuntimeValueKind.Text or needle.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            return runtime_int(text_rfind(text_value.text, needle.text))


        def evaluate_text_partition(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, text_value: RuntimeValue, separator: RuntimeValue, reverse: bool) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if text_value.kind != RuntimeValueKind.Text or separator.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_storage_span_u32_valid(storage, 3):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            result_start: u32 = storage.count.u32()
            split_at: i64 = text_rfind(text_value.text, separator.text) if reverse else text_find(text_value.text, separator.text)
            if split_at < 0:
                if reverse:
                    storage.push(runtime_text(""))
                    storage.push(runtime_text(""))
                    storage.push(runtime_text(text_value.text))
                else:
                    storage.push(runtime_text(text_value.text))
                    storage.push(runtime_text(""))
                    storage.push(runtime_text(""))
                return runtime_array(result_start, 3)
            split_index: usize = split_at.usize()
            separator_end: usize = split_index + sview_len(separator.text)
            storage.push(runtime_text(text_value.text[0:split_index]))
            storage.push(runtime_text(separator.text))
            storage.push(runtime_text(text_value.text[separator_end:sview_len(text_value.text)]))
            return runtime_array(result_start, 3)


        def evaluate_text_index(machine: mutable Machine&, text_value: RuntimeValue, needle: RuntimeValue, reverse: bool) -> RuntimeValue:
            if text_value.kind != RuntimeValueKind.Text or needle.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            result: i64 = text_rfind(text_value.text, needle.text) if reverse else text_find(text_value.text, needle.text)
            if result < 0:
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            return runtime_int(result)


        def evaluate_text_predicate(machine: mutable Machine&, text_value: RuntimeValue, mode: i64) -> RuntimeValue:
            if text_value.kind != RuntimeValueKind.Text or mode < 0 or mode > 9:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            return runtime_bool(text_is_predicate(text_value.text, mode))


        def text_ascii_whitespace(value: u8) -> bool:
            return value in {9, 10, 11, 12, 13, 32}


        def evaluate_text_trim(machine: mutable Machine&, text_value: RuntimeValue, mode: i64) -> RuntimeValue:
            if text_value.kind != RuntimeValueKind.Text or mode < 0 or mode > 2:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            low: mutable usize = 0
            high: mutable usize = sview_len(text_value.text)
            while mode != 2 and low < high and text_ascii_whitespace(sview_at(text_value.text, low)) |text_value, low, high, mode|:
                low <- low + 1
            while mode != 1 and high > low and text_ascii_whitespace(sview_at(text_value.text, high - 1)) |text_value, low, high, mode|:
                high <- high - 1
            return runtime_text(text_value.text[low:high])


        # Case conversion is deliberately byte-oriented and deterministic in the
        # initial scripting profile. ASCII letters are folded; all other UTF-8
        # bytes pass through unchanged, so the operation never corrupts text.
        def evaluate_text_case(machine: mutable Machine&, text_value: RuntimeValue, upper: bool) -> RuntimeValue:
            if text_value.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            length: usize = sview_len(text_value.text)
            if length > INTERPRET_MAX_TEXT_OUTPUT_BYTES:
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            return runtime_text("") if length == 0
            output: mutable dstr = ctx_fstr_alloc(length)
            if output.items == null:
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            items: mutable u8& = output.items
            output.count <- length
            for index in 0..<length |output, text_value, upper|:
                byte: mutable u8 = sview_at(text_value.text, index)
                if upper and byte >= 97 and byte <= 122:
                    byte <- byte - 32
                if not upper and byte >= 65 and byte <= 90:
                    byte <- byte + 32
                items[index] <- byte
            return runtime_text(bytes_view(output))


        def evaluate_contains(machine: mutable Machine&, storage: darray[RuntimeValue]&, needle: RuntimeValue, collection: RuntimeValue) -> RuntimeValue:
            if collection.kind == RuntimeValueKind.Text and needle.kind == RuntimeValueKind.Text:
                return runtime_bool(text_contains(collection.text, needle.text))
            if collection.kind == RuntimeValueKind.Array:
                if not runtime_array_range_valid(storage, collection):
                    interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                    return runtime_void()
                for offset in 0..<collection.array_count.usize() |storage, collection, needle|:
                    runtime_bool(true) return if runtime_values_equal(storage, needle, storage[collection.array_start.usize() + offset])
                return runtime_bool(false)
            if collection.kind == RuntimeValueKind.Map:
                if not runtime_map_range_valid(storage, collection):
                    interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                    return runtime_void()
                for offset in 0..<collection.map_count.usize() |storage, collection, needle|:
                    runtime_bool(true) return if runtime_values_equal(storage, needle, storage[collection.map_start.usize() + offset * 2])
                return runtime_bool(false)
            interpret_set_failure(machine, InterpretFailure.TypeMismatch)
            return runtime_void()


        def regex_ascii_digit(value: u8) -> bool:
            return value >= 48 and value <= 57


        def regex_ascii_word(value: u8) -> bool:
            return regex_ascii_digit(value) or (value >= 65 and value <= 90) or (value >= 97 and value <= 122) or value == 95


        def regex_ascii_space(value: u8) -> bool:
            return value in {9, 10, 11, 12, 13, 32}


        def regex_replacement_within_budget(replacement: sview) -> bool:
            return sview_len(replacement) <= RegexLimits::TEXT_BYTES


        def regex_pattern_depth_within_budget(pattern: sview) -> bool:
            depth: mutable usize = 0
            in_class: mutable bool = false
            escaped: mutable bool = false
            for index in 0..<sview_len(pattern) |pattern|:
                byte: u8 = sview_at(pattern, index)
                if escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif in_class:
                    in_class <- false if byte == 93
                elif byte == 91:
                    in_class <- true
                elif byte == 40:
                    return false if depth >= RegexLimits::GROUP_DEPTH
                    depth <- depth + 1
                elif byte == 41 and depth > 0:
                    depth <- depth - 1
            return true


        def regex_input_within_budget(text: sview, pattern: sview) -> bool:
            return sview_len(text) <= RegexLimits::TEXT_BYTES and sview_len(pattern) <= RegexLimits::PATTERN_BYTES and regex_pattern_depth_within_budget(pattern)


        def regex_work_step(budget: mutable RegexWorkBudget&) -> bool:
            return false if budget.exhausted
            if budget.remaining == 0:
                budget.exhausted <- true
                return false
            budget.remaining <- budget.remaining - 1
            budget.spent <- budget.spent + 1
            return true


        def regex_work_bytes(budget: mutable RegexWorkBudget&, length: usize) -> bool:
            return false if budget.exhausted
            if length.u64() > budget.remaining:
                budget.exhausted <- true
                return false
            budget.remaining <- budget.remaining - length.u64()
            budget.spent <- budget.spent + length.u64()
            return true


        # Regex helpers consume a local state-machine budget, while the
        # interpreter also exposes one shared per-run resource ledger. Charge
        # only the newly spent portion so nested matcher helpers cannot double
        # count work when an operation performs several scans.
        def regex_work_account(machine: mutable Machine&, budget: mutable RegexWorkBudget&) -> bool:
            if budget.spent > budget.accounted:
                delta: u64 = budget.spent - budget.accounted
                if not runtime_resource_add_regex_work(machine.resource_usage, machine.resource_policy, delta):
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return true
                budget.accounted <- budget.spent
            return budget.exhausted or machine.failure != InterpretFailure.None


        def regex_work_budget_limit(machine: Machine&) -> u64:
            return machine.resource_policy.regex_work


        def regex_escape_matches(code: u8, value: u8) -> bool:
            return regex_ascii_digit(value) if code == 100
            return not regex_ascii_digit(value) if code == 68
            return regex_ascii_word(value) if code == 119
            return not regex_ascii_word(value) if code == 87
            return regex_ascii_space(value) if code == 115
            return not regex_ascii_space(value) if code == 83
            return code == value


        # Perl-compatible word boundaries are zero-width atoms.  The matcher is
        # byte-oriented by design, so a boundary is the transition between an
        # ASCII `\w` byte and a non-word byte (or the beginning/end of text).
        def regex_boundary_matches(text: sview, text_index: usize, inverted: bool) -> bool:
            previous_word: bool = text_index > 0 and regex_ascii_word(sview_at(text, text_index - 1))
            next_word: bool = text_index < sview_len(text) and regex_ascii_word(sview_at(text, text_index))
            boundary: bool = previous_word != next_word
            return not boundary if inverted else boundary


        def regex_class_width(pattern: sview, pattern_index: usize) -> usize:
            cursor: mutable usize = pattern_index + 1
            cursor <- cursor + 1 if cursor < sview_len(pattern) and sview_at(pattern, cursor) == 94
            # Perl/Python-style character classes may place `]` first (after
            # the optional negation marker) to include it literally. Skip
            # that member before searching for the actual closing bracket.
            cursor <- cursor + 1 if cursor < sview_len(pattern) and sview_at(pattern, cursor) == 93
            escaped: mutable bool = false
            while cursor < sview_len(pattern):
                byte: u8 = sview_at(pattern, cursor)
                if escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 93:
                    return cursor - pattern_index + 1
                cursor <- cursor + 1
            return 1


        def regex_class_matches(pattern: sview, pattern_index: usize, width: usize, value: u8) -> bool:
            class_end: usize = pattern_index + width - 1
            cursor: mutable usize = pattern_index + 1
            negated: bool = cursor < class_end and sview_at(pattern, cursor) == 94
            cursor <- cursor + 1 if negated
            found: mutable bool = false
            while cursor < class_end and not found:
                first: mutable u8 = sview_at(pattern, cursor)
                first_width: mutable usize = 1
                if first == 92 and cursor < class_end and class_end - cursor > 1:
                    first_width <- 2
                    found <- regex_escape_matches(sview_at(pattern, cursor + 1), value)
                else:
                    found <- first == value
                range_marker: usize = cursor + first_width
                if not found and first_width == 1 and range_marker < class_end and class_end - range_marker > 1 and sview_at(pattern, range_marker) == 45:
                    last: u8 = sview_at(pattern, range_marker + 1)
                    found <- value >= first and value <= last
                    cursor <- range_marker + 2
                else:
                    cursor <- cursor + first_width
            return not found if negated else found


        # Return the width of a balanced parenthesized group, or one for an
        # unmatched opener. Escapes and character classes do not affect group
        # depth, so `[(]` and `\\(` remain literal atoms.
        def regex_group_width(pattern: sview, pattern_index: usize, pattern_end: usize) -> usize:
            cursor: mutable usize = pattern_index + 1
            depth: mutable usize = 1
            class_depth: mutable usize = 0
            escaped: mutable bool = false
            while cursor < pattern_end:
                byte: u8 = sview_at(pattern, cursor)
                if escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 91:
                    class_depth <- class_depth + 1
                elif byte == 93 and class_depth > 0:
                    class_depth <- class_depth - 1
                elif class_depth == 0 and byte == 40:
                    depth <- depth + 1
                elif class_depth == 0 and byte == 41:
                    depth <- depth - 1
                    return cursor - pattern_index + 1 if depth == 0
                cursor <- cursor + 1
            return 1


        # Named groups use the Perl spelling `(?<name>...)`. The name is part of
        # the pattern syntax, not a literal atom, so matching and capture
        # extraction both begin after its closing `>` marker. Unknown or
        # unterminated markers fall back to the ordinary group start and are
        # rejected naturally by the regular matcher.
        def regex_group_content_start(pattern: sview, pattern_index: usize, group_end: usize) -> usize:
            return group_end if pattern_index >= group_end
            return pattern_index + 1 if group_end - pattern_index < 3 or sview_at(pattern, pattern_index + 1) != 63 or sview_at(pattern, pattern_index + 2) != 60
            cursor: mutable usize = pattern_index + 3
            while cursor < group_end:
                return cursor + 1 if sview_at(pattern, cursor) == 62
                cursor <- cursor + 1
            return pattern_index + 1


        def regex_group_name(pattern: sview, pattern_index: usize, group_end: usize) -> sview:
            return sview("", 0, 0) if pattern_index >= group_end or group_end - pattern_index < 3 or sview_at(pattern, pattern_index + 1) != 63 or sview_at(pattern, pattern_index + 2) != 60
            cursor: mutable usize = pattern_index + 3
            while cursor < group_end:
                return pattern[pattern_index + 3:cursor] if sview_at(pattern, cursor) == 62
                cursor <- cursor + 1
            return sview("", 0, 0)


        def regex_atom_width_until(pattern: sview, pattern_index: usize, pattern_end: usize) -> usize:
            return 0 if pattern_index >= pattern_end
            return 2 if sview_at(pattern, pattern_index) == 92 and pattern_end - pattern_index > 1
            if sview_at(pattern, pattern_index) == 91:
                return regex_class_width(pattern, pattern_index)
            return regex_group_width(pattern, pattern_index, pattern_end) if sview_at(pattern, pattern_index) == 40
            return 1


        def regex_atom_width(pattern: sview, pattern_index: usize) -> usize:
            return regex_atom_width_until(pattern, pattern_index, sview_len(pattern))


        # Parse a bounded repetition suffix beginning at `{`.  Invalid, reversed,
        # or unterminated bounds are left as literal pattern text so malformed
        # patterns cannot silently acquire a different meaning. Bounds are exact
        # host-sized counts, independent of the length of their source spelling.
        # Reject unrepresentable counts before multiplication or narrowing.
        def regex_quantifier_digit(value: mutable usize&, digit: usize) -> bool:
            wide: u64 = value.u64()
            return false if wide > 1844674407370955161u64
            return false if wide == 1844674407370955161u64 and digit > 5
            next: u64 = wide * 10u64 + digit.u64()
            narrowed: usize = next.usize()
            return false if narrowed.u64() != next
            value <- narrowed
            return true


        def regex_braced_quantifier(pattern: sview, pattern_index: usize, pattern_end: usize) -> RegexQuantifier:
            invalid: RegexQuantifier = RegexQuantifier{end: pattern_index, minimum: 0, maximum: 0, found: false, unbounded: false}
            return invalid if pattern_index >= pattern_end or sview_at(pattern, pattern_index) != 123
            cursor: mutable usize = pattern_index + 1
            return invalid if cursor >= pattern_end or sview_at(pattern, cursor) < 48 or sview_at(pattern, cursor) > 57
            minimum: mutable usize = 0
            while cursor < pattern_end and sview_at(pattern, cursor) >= 48 and sview_at(pattern, cursor) <= 57:
                digit: usize = (sview_at(pattern, cursor) - 48).usize()
                return invalid if not regex_quantifier_digit(minimum, digit)
                cursor <- cursor + 1
            if cursor < pattern_end and sview_at(pattern, cursor) == 125:
                return RegexQuantifier{end: cursor + 1, minimum: minimum, maximum: minimum, found: true, unbounded: false}
            return invalid if cursor >= pattern_end or sview_at(pattern, cursor) != 44
            cursor <- cursor + 1
            if cursor < pattern_end and sview_at(pattern, cursor) == 125:
                return RegexQuantifier{end: cursor + 1, minimum: minimum, maximum: 0, found: true, unbounded: true}
            return invalid if cursor >= pattern_end or sview_at(pattern, cursor) < 48 or sview_at(pattern, cursor) > 57
            maximum: mutable usize = 0
            while cursor < pattern_end and sview_at(pattern, cursor) >= 48 and sview_at(pattern, cursor) <= 57:
                digit: usize = (sview_at(pattern, cursor) - 48).usize()
                return invalid if not regex_quantifier_digit(maximum, digit)
                cursor <- cursor + 1
            return invalid if cursor >= pattern_end or sview_at(pattern, cursor) != 125 or maximum < minimum
            return RegexQuantifier{end: cursor + 1, minimum: minimum, maximum: maximum, found: true, unbounded: false}


        def regex_branch_end_until(pattern: sview, branch_start: usize, pattern_end: usize) -> usize:
            cursor: mutable usize = branch_start
            class_depth: mutable usize = 0
            group_depth: mutable usize = 0
            escaped: mutable bool = false
            while cursor < pattern_end:
                byte: u8 = sview_at(pattern, cursor)
                if escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 91:
                    class_depth <- class_depth + 1
                elif byte == 93 and class_depth > 0:
                    class_depth <- class_depth - 1
                elif class_depth == 0 and byte == 40:
                    group_depth <- group_depth + 1
                elif class_depth == 0 and byte == 41 and group_depth > 0:
                    group_depth <- group_depth - 1
                elif byte == 124 and class_depth == 0 and group_depth == 0:
                    return cursor
                cursor <- cursor + 1
            return pattern_end


        def regex_branch_end(pattern: sview, branch_start: usize) -> usize:
            return regex_branch_end_until(pattern, branch_start, sview_len(pattern))


        def regex_atom_match_end(pattern: sview, pattern_index: usize, pattern_end: usize, text: sview, text_index: usize, budget: mutable RegexWorkBudget&) -> i64:
            return -1 if not regex_work_step(budget)
            return -1 if pattern_index >= pattern_end
            atom: u8 = sview_at(pattern, pattern_index)
            if atom == 40:
                width: usize = regex_group_width(pattern, pattern_index, pattern_end)
                return -1 if not regex_work_bytes(budget, width)
                return -1 if width <= 1
                group_end: usize = pattern_index + width - 1
                return regex_match_expression_end(pattern, regex_group_content_start(pattern, pattern_index, group_end), group_end, text, text_index, budget)
            if atom == 92 and pattern_end - pattern_index > 1:
                escape: u8 = sview_at(pattern, pattern_index + 1)
                if escape == 98 or escape == 66:
                    return text_index.i64() if regex_boundary_matches(text, text_index, escape == 66) else -1
            return -1 if text_index >= sview_len(text)
            value: u8 = sview_at(text, text_index)
            return text_index.i64() + 1 if atom == 46
            return text_index.i64() + 1 if atom == 92 and pattern_end - pattern_index > 1 and regex_escape_matches(sview_at(pattern, pattern_index + 1), value)
            if atom == 91:
                width: usize = regex_class_width(pattern, pattern_index)
                return -1 if not regex_work_bytes(budget, width)
                return text_index.i64() + 1 if width > 1 and regex_class_matches(pattern, pattern_index, width, value)
                return -1
            return text_index.i64() + 1 if atom == value else -1


        def regex_repeat_atom_is_fixed_width(pattern: sview, atom_start: usize, atom_end: usize) -> bool:
            return false if atom_start >= atom_end
            atom: u8 = sview_at(pattern, atom_start)
            return false if atom == 40 or atom == 94 or atom == 36
            return true if atom == 46
            if atom == 91:
                return regex_class_width(pattern, atom_start) == atom_end - atom_start
            return false if atom != 92 or atom_end - atom_start != 2
            return sview_at(pattern, atom_start + 1) != 98 and sview_at(pattern, atom_start + 1) != 66


        def regex_repeat_fixed_atom_end(pattern: sview, atom_start: usize, atom_end: usize, suffix_start: usize, suffix_end: usize, text: sview, text_index: usize, minimum: usize, maximum: usize, budget: mutable RegexWorkBudget&) -> i64:
            count: mutable usize = 0
            cursor: mutable usize = text_index
            while count < maximum:
                endpoint: i64 = regex_atom_match_end(pattern, atom_start, atom_end, text, cursor, budget)
                break if endpoint != cursor.i64() + 1
                cursor <- endpoint.usize()
                count <- count + 1
            return -1 if count < minimum
            while true:
                endpoint: i64 = regex_match_segment_end(pattern, suffix_start, suffix_end, text, cursor, budget)
                return endpoint if endpoint >= 0
                return -1 if count == minimum
                count <- count - 1
                cursor <- cursor - 1
            return -1


        def regex_repeat_segment_end(pattern: sview, atom_start: usize, atom_end: usize, suffix_start: usize, suffix_end: usize, text: sview, text_index: usize, minimum: usize, maximum: usize, count: usize, budget: mutable RegexWorkBudget&) -> i64:
            return -1 if not regex_work_step(budget)
            return regex_repeat_fixed_atom_end(pattern, atom_start, atom_end, suffix_start, suffix_end, text, text_index, minimum, maximum, budget) if count == 0 and regex_repeat_atom_is_fixed_width(pattern, atom_start, atom_end)
            if count < maximum:
                if count >= RegexLimits::REPEAT_DEPTH:
                    budget.exhausted <- true
                    return -1
                endpoint: i64 = regex_atom_match_end(pattern, atom_start, atom_end, text, text_index, budget)
                if endpoint > text_index.i64():
                    deeper: i64 = regex_repeat_segment_end(pattern, atom_start, atom_end, suffix_start, suffix_end, text, endpoint.usize(), minimum, maximum, count + 1, budget)
                    return deeper if deeper >= 0
                if endpoint == text_index.i64():
                    # Repeating this zero-width atom cannot change its
                    # endpoint. Account for the successful repetition and
                    # satisfy any remaining minimum without recursive calls
                    # at the same position, then evaluate the suffix once.
                    completed: usize = count + 1
                    missing: mutable usize = minimum - completed if completed < minimum else 0
                    while missing > 0:
                        return -1 if not regex_work_step(budget)
                        missing <- missing - 1
                    return regex_match_segment_end(pattern, suffix_start, suffix_end, text, text_index, budget)
            return regex_match_segment_end(pattern, suffix_start, suffix_end, text, text_index, budget) if count >= minimum else -1


        def regex_match_segment_end(pattern: sview, pattern_index: usize, pattern_end: usize, text: sview, text_index: usize, budget: mutable RegexWorkBudget&) -> i64:
            return -1 if not regex_work_step(budget)
            return text_index.i64() if pattern_index >= pattern_end
            if sview_at(pattern, pattern_index) == 36 and pattern_end - pattern_index == 1:
                return text_index.i64() if text_index == sview_len(text) else -1
            width: usize = regex_atom_width_until(pattern, pattern_index, pattern_end)
            return -1 if width == 0
            return -1 if not regex_work_bytes(budget, width)
            next: mutable usize = pattern_index + width
            quantifier: u8 = sview_at(pattern, next) if next < pattern_end else 0
            return -1 if quantifier == 123 and not regex_work_bytes(budget, pattern_end - next)
            bounded: RegexQuantifier = regex_braced_quantifier(pattern, next, pattern_end) if quantifier == 123 else RegexQuantifier{end: next, minimum: 0, maximum: 0, found: false, unbounded: false}
            has_quantifier: bool = quantifier in {42, 43, 63} or bounded.found
            # A group can have several valid endpoints at the same input
            # position (for example `(a|ab)`). Match each branch together with
            # the surrounding suffix so a failed suffix re-enters the next
            # branch instead of committing to the first endpoint too early.
            if sview_at(pattern, pattern_index) == 40 and not has_quantifier:
                return -1 if width <= 1
                group_end: usize = pattern_index + width - 1
                branch_start: mutable usize = regex_group_content_start(pattern, pattern_index, group_end)
                # The closing boundary also denotes a valid empty branch:
                # both () and the final arm of (a|) must try the suffix.
                while branch_start <= group_end:
                    return -1 if not regex_work_step(budget)
                    branch_end: usize = regex_branch_end_until(pattern, branch_start, group_end)
                    return -1 if not regex_work_bytes(budget, branch_end - branch_start)
                    anchored: bool = branch_start < branch_end and sview_at(pattern, branch_start) == 94
                    inner_start: usize = branch_start + 1 if anchored else branch_start
                    endpoint: i64 = regex_match_segment_end(pattern, inner_start, branch_end, text, text_index, budget) if not anchored or text_index == 0 else -1
                    if endpoint >= 0:
                        suffix_endpoint: i64 = regex_match_segment_end(pattern, next, pattern_end, text, endpoint.usize(), budget)
                        return suffix_endpoint if suffix_endpoint >= 0
                    break if branch_end == group_end
                    branch_start <- branch_end + 1
                return -1
            if quantifier in {42, 43, 63}:
                minimum: usize = 0 if quantifier == 42 or quantifier == 63 else 1
                maximum: usize = 1 if quantifier == 63 else sview_len(text) - text_index + 1
                return regex_repeat_segment_end(pattern, pattern_index, next, next + 1, pattern_end, text, text_index, minimum, maximum, 0, budget)
            if bounded.found:
                maximum: mutable usize = sview_len(text) - text_index + 1 if bounded.unbounded else bounded.maximum
                # Zero-width atoms can satisfy a minimum larger than the text.
                maximum <- bounded.minimum if bounded.unbounded and maximum < bounded.minimum
                return regex_repeat_segment_end(pattern, pattern_index, next, bounded.end, pattern_end, text, text_index, bounded.minimum, maximum, 0, budget)
            endpoint: i64 = regex_atom_match_end(pattern, pattern_index, next, text, text_index, budget)
            return -1 if endpoint < 0
            return regex_match_segment_end(pattern, next, pattern_end, text, endpoint.usize(), budget)


        def regex_match_expression_end(pattern: sview, pattern_start: usize, pattern_end: usize, text: sview, text_index: usize, budget: mutable RegexWorkBudget&) -> i64:
            return -1 if not regex_work_step(budget)
            return -1 if not regex_work_bytes(budget, pattern_end - pattern_start)
            branch_start: mutable usize = pattern_start
            while branch_start <= pattern_end:
                branch_end: usize = regex_branch_end_until(pattern, branch_start, pattern_end)
                anchored: bool = branch_start < branch_end and sview_at(pattern, branch_start) == 94
                atom_start: usize = branch_start + 1 if anchored else branch_start
                endpoint: i64 = regex_match_segment_end(pattern, atom_start, branch_end, text, text_index, budget) if not anchored or text_index == 0 else -1
                return endpoint if endpoint >= 0
                break if branch_end == pattern_end
                branch_start <- branch_end + 1
            return -1


        def regex_match_segment(pattern: sview, pattern_index: usize, pattern_end: usize, text: sview, text_index: usize, budget: mutable RegexWorkBudget&) -> bool:
            return regex_match_segment_end(pattern, pattern_index, pattern_end, text, text_index, budget) >= 0


        def regex_find_match(text: sview, pattern: sview, start_at: usize, budget: mutable RegexWorkBudget&) -> RegexMatchSpan:
            start: mutable usize = start_at
            length: usize = sview_len(text)
            while start <= length:
                return RegexMatchSpan{start: 0, end: 0, found: false} if not regex_work_bytes(budget, sview_len(pattern))
                endpoint: i64 = regex_match_expression_end(pattern, 0, sview_len(pattern), text, start, budget)
                return RegexMatchSpan{start: start, end: endpoint.usize(), found: true} if endpoint >= 0
                return RegexMatchSpan{start: 0, end: 0, found: false} if budget.exhausted
                break if start == length
                start <- start + 1
            return RegexMatchSpan{start: 0, end: 0, found: false}


        def regex_search(text: sview, pattern: sview, budget: mutable RegexWorkBudget&) -> bool:
            start: mutable usize = 0
            length: usize = sview_len(text)
            while start <= length:
                return false if not regex_work_bytes(budget, sview_len(pattern))
                true return if regex_match_expression_end(pattern, 0, sview_len(pattern), text, start, budget) >= 0
                return false if budget.exhausted
                break if start == length
                start <- start + 1
            return false


        def append_regex_text(out: mutable dstr&, value: sview, start: usize, end: usize) -> void:
            for index in start..<end |out, value|:
                out.push(sview_at(value, index))


        def append_regex_output(out: mutable dstr&, value: sview, start: usize, end: usize, budget: mutable RegexWorkBudget&) -> void:
            return if budget.exhausted
            if start > end:
                budget.exhausted <- true
                return
            if end > sview_len(value):
                budget.exhausted <- true
                return
            if out.count > RegexLimits::OUTPUT_BYTES:
                budget.exhausted <- true
                return
            if end - start > RegexLimits::OUTPUT_BYTES - out.count:
                budget.exhausted <- true
                return
            for index in start..<end |out, value|:
                out.push(sview_at(value, index))


        def append_regex_byte(out: mutable dstr&, value: u8, budget: mutable RegexWorkBudget&) -> void:
            return if budget.exhausted
            if out.count >= RegexLimits::OUTPUT_BYTES:
                budget.exhausted <- true
                return
            out.push(value)


        # Capture extraction is intentionally conservative. The search matcher
        # supports nested groups and quantified groups, but deriving captures
        # from its endpoint-only result would be ambiguous in those cases. We
        # therefore expose captures for a flat sequence of non-quantified
        # groups plus `?`-optional groups; an optional group that does not
        # participate becomes an empty capture while its name remains stable.
        # Other quantified/ambiguous layouts remain unsupported and leave the
        # replacement/capture result deterministic until a full capture state
        # machine is added later.
        def regex_capture_group_layout(pattern: sview, opens: mutable darray[usize]&, starts: mutable darray[usize]&, ends: mutable darray[usize]&, names: mutable darray[sview]&, optional: mutable darray[bool]&) -> bool can[Memory.Allocate, Abort.Panic]:
            cursor: mutable usize = 0
            class_depth: mutable usize = 0
            group_depth: mutable usize = 0
            escaped: mutable bool = false
            top_level_alternation: mutable bool = false
            while cursor < sview_len(pattern):
                byte: u8 = sview_at(pattern, cursor)
                if escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 91:
                    class_depth <- class_depth + 1
                elif byte == 93 and class_depth > 0:
                    class_depth <- class_depth - 1
                elif class_depth == 0 and byte == 124 and group_depth == 0:
                    top_level_alternation <- true
                elif class_depth == 0 and byte == 40:
                    return false if group_depth > 0
                    opens.push(cursor)
                    group_end: usize = regex_group_width(pattern, cursor, sview_len(pattern)) + cursor - 1
                    starts.push(regex_group_content_start(pattern, cursor, group_end))
                    names.push(regex_group_name(pattern, cursor, group_end))
                    quantifier_index: usize = group_end + 1
                    optional.push(quantifier_index < sview_len(pattern) and sview_at(pattern, quantifier_index) == 63)
                    group_depth <- group_depth + 1
                elif class_depth == 0 and byte == 41:
                    return false if group_depth == 0
                    ends.push(cursor)
                    group_depth <- group_depth - 1
                    quantifier_index: usize = cursor + 1
                    return false if quantifier_index < sview_len(pattern) and (sview_at(pattern, quantifier_index) in {42, 43} or regex_braced_quantifier(pattern, quantifier_index, sview_len(pattern)).found)
                cursor <- cursor + 1
            return group_depth == 0 and not top_level_alternation and opens.count == starts.count and starts.count == ends.count and ends.count == names.count and names.count == optional.count


        def regex_capture_spans_for_match(text: sview, pattern: sview, span: RegexMatchSpan, captures: mutable darray[RegexMatchSpan]&, names: mutable darray[sview]&, budget: mutable RegexWorkBudget&) -> bool can[Memory.Allocate, Abort.Panic]:
            opens: mutable darray[usize] = []
            starts: mutable darray[usize] = []
            ends: mutable darray[usize] = []
            optional: mutable darray[bool] = []
            return false if not regex_work_bytes(budget, sview_len(pattern))
            return false if not regex_capture_group_layout(pattern, opens, starts, ends, names, optional)
            for group_index in 0..<opens.count.usize() |text, pattern, span, captures, opens, starts, ends, optional, budget|:
                open: usize = opens[group_index]
                inner_start: usize = starts[group_index]
                inner_end: usize = ends[group_index]
                suffix_start: mutable usize = inner_end + 1
                suffix_start <- suffix_start + 1 if optional[group_index]
                prefix_endpoint: i64 = regex_match_expression_end(pattern, 0, open, text, span.start, budget)
                return false if budget.exhausted
                found: mutable bool = false
                candidate: mutable usize = span.start
                while candidate <= span.end and not found:
                    return false if not regex_work_step(budget)
                    if prefix_endpoint == candidate.i64():
                        group_endpoint: i64 = regex_match_expression_end(pattern, inner_start, inner_end, text, candidate, budget)
                        return false if budget.exhausted
                        if group_endpoint >= 0 and group_endpoint.usize() <= span.end:
                            suffix_endpoint: i64 = regex_match_expression_end(pattern, suffix_start, sview_len(pattern), text, group_endpoint.usize(), budget)
                            return false if budget.exhausted
                            if suffix_endpoint == span.end.i64():
                                captures.push(RegexMatchSpan{start: candidate, end: group_endpoint.usize(), found: true})
                                found <- true
                    break if candidate == span.end
                    candidate <- candidate + 1
                if not found and optional[group_index] and prefix_endpoint >= 0:
                    suffix_endpoint: i64 = regex_match_expression_end(pattern, suffix_start, sview_len(pattern), text, prefix_endpoint.usize(), budget)
                    if suffix_endpoint == span.end.i64():
                        captures.push(RegexMatchSpan{start: 0, end: 0, found: false})
                        found <- true
                return false if budget.exhausted or not found
            return true


        # `$0` expands to the complete match and `$1` through `$9` expand to
        # proven capture spans. `${name}` and `$<name>` expand named groups when
        # their spans are proven. The Perl/Python spellings `\0`, `\1` through
        # `\9`, and `\g<name>` are accepted for the same captures. `$$` emits a
        # literal dollar and `&` provides the AWK/sed whole-match spelling;
        # `\&` escapes that ampersand. Unknown or ambiguous references remain
        # literal. Tokens are consumed atomically, including for an empty match.
        def append_regex_replacement(out: mutable dstr&, replacement: sview, text: sview, span: RegexMatchSpan, captures: darray[RegexMatchSpan]&, names: darray[sview]&, budget: mutable RegexWorkBudget&) -> void:
            index: mutable usize = 0
            while index < sview_len(replacement):
                return if not regex_work_step(budget)
                byte: u8 = sview_at(replacement, index)
                if byte == 92 and sview_len(replacement) - index > 1 and sview_at(replacement, index + 1) == 38:
                    append_regex_byte(out, 38, budget)
                    index <- index + 2
                elif byte == 92 and sview_len(replacement) - index > 1 and sview_at(replacement, index + 1) == 92:
                    append_regex_byte(out, 92, budget)
                    index <- index + 2
                elif byte == 92 and sview_len(replacement) - index > 1 and (sview_at(replacement, index + 1) == 48 or (sview_at(replacement, index + 1) >= 49 and sview_at(replacement, index + 1) <= 57)):
                    reference: u8 = sview_at(replacement, index + 1)
                    if reference == 48:
                        append_regex_output(out, text, span.start, span.end, budget)
                    else:
                        capture_index: usize = (reference - 49).usize()
                        if capture_index < captures.count.usize() and captures[capture_index].found:
                            capture: RegexMatchSpan = captures[capture_index]
                            append_regex_output(out, text, capture.start, capture.end, budget)
                        else:
                            append_regex_byte(out, byte, budget)
                            append_regex_byte(out, reference, budget)
                    index <- index + 2
                elif byte == 92 and sview_len(replacement) - index > 3 and sview_at(replacement, index + 1) == 103 and sview_at(replacement, index + 2) == 60:
                    cursor: mutable usize = index + 3
                    while cursor < sview_len(replacement) and sview_at(replacement, cursor) != 62:
                        return if not regex_work_step(budget)
                        cursor <- cursor + 1
                    if cursor < sview_len(replacement):
                        name: sview = replacement[index + 3:cursor]
                        if name == "0":
                            append_regex_output(out, text, span.start, span.end, budget)
                        elif sview_len(name) == 1 and sview_at(name, 0) >= 49 and sview_at(name, 0) <= 57:
                            capture_index: usize = (sview_at(name, 0) - 49).usize()
                            if capture_index < captures.count.usize() and captures[capture_index].found:
                                capture: RegexMatchSpan = captures[capture_index]
                                append_regex_output(out, text, capture.start, capture.end, budget)
                            else:
                                append_regex_output(out, replacement, index, cursor + 1, budget)
                        else:
                            named_index: mutable usize = 0
                            named_match_index: mutable usize = names.count
                            named_matches: mutable usize = 0
                            while named_index < names.count:
                                return if not regex_work_step(budget)
                                return if not regex_work_bytes(budget, sview_len(name))
                                if names[named_index] == name:
                                    named_match_index <- named_index
                                    named_matches <- named_matches + 1
                                named_index <- named_index + 1
                            if name != "" and named_matches == 1 and named_match_index < captures.count and captures[named_match_index].found:
                                capture: RegexMatchSpan = captures[named_match_index]
                                append_regex_output(out, text, capture.start, capture.end, budget)
                            else:
                                append_regex_output(out, replacement, index, cursor + 1, budget)
                        index <- cursor + 1
                    else:
                        append_regex_byte(out, byte, budget)
                        index <- index + 1
                elif byte == 38:
                    append_regex_output(out, text, span.start, span.end, budget)
                    index <- index + 1
                elif byte == 36 and sview_len(replacement) - index > 1 and (sview_at(replacement, index + 1) == 123 or sview_at(replacement, index + 1) == 60):
                    marker: u8 = sview_at(replacement, index + 1)
                    closing: u8 = 125 if marker == 123 else 62
                    cursor: mutable usize = index + 2
                    while cursor < sview_len(replacement) and sview_at(replacement, cursor) != closing:
                        return if not regex_work_step(budget)
                        cursor <- cursor + 1
                    if cursor < sview_len(replacement):
                        name: sview = replacement[index + 2:cursor]
                        named_index: mutable usize = 0
                        named_match_index: mutable usize = names.count
                        named_matches: mutable usize = 0
                        while named_index < names.count:
                            return if not regex_work_step(budget)
                            return if not regex_work_bytes(budget, sview_len(name))
                            if names[named_index] == name:
                                named_match_index <- named_index
                                named_matches <- named_matches + 1
                            named_index <- named_index + 1
                        if name != "" and named_matches == 1 and named_match_index < captures.count and captures[named_match_index].found:
                            capture: RegexMatchSpan = captures[named_match_index]
                            append_regex_output(out, text, capture.start, capture.end, budget)
                        else:
                            append_regex_output(out, replacement, index, cursor + 1, budget)
                        index <- cursor + 1
                    else:
                        append_regex_byte(out, byte, budget)
                        index <- index + 1
                elif byte == 36 and sview_len(replacement) - index > 1:
                    reference: u8 = sview_at(replacement, index + 1)
                    if reference == 36:
                        append_regex_byte(out, 36, budget)
                        index <- index + 2
                    elif reference == 48:
                        append_regex_output(out, text, span.start, span.end, budget)
                        index <- index + 2
                    elif reference >= 49 and reference <= 57:
                        capture_index: usize = (reference - 49).usize()
                        if capture_index < captures.count.usize() and captures[capture_index].found:
                            capture: RegexMatchSpan = captures[capture_index]
                            append_regex_output(out, text, capture.start, capture.end, budget)
                        else:
                            append_regex_byte(out, 36, budget)
                            append_regex_byte(out, reference, budget)
                        index <- index + 2
                    else:
                        append_regex_byte(out, sview_at(replacement, index), budget)
                        index <- index + 1
                else:
                    append_regex_byte(out, byte, budget)
                    index <- index + 1


        def regex_replace_snapshot(text: sview, pattern: sview, replacement: sview, budget: mutable RegexWorkBudget&) -> sview can[Memory.Allocate, Abort.Panic]:
            output: mutable dstr = []
            cursor: mutable usize = 0
            length: usize = sview_len(text)
            while cursor <= length:
                span: RegexMatchSpan = regex_find_match(text, pattern, cursor, budget)
                return "" if budget.exhausted
                if not span.found:
                    append_regex_output(output, text, cursor, length, budget)
                    return "" if budget.exhausted
                    break
                append_regex_output(output, text, cursor, span.start, budget)
                return "" if budget.exhausted
                captures: mutable darray[RegexMatchSpan] = []
                names: mutable darray[sview] = []
                regex_capture_spans_for_match(text, pattern, span, captures, names, budget)
                return "" if budget.exhausted
                append_regex_replacement(output, replacement, text, span, captures, names, budget)
                return "" if budget.exhausted
                if span.start == span.end:
                    if span.start < length:
                        append_regex_byte(output, sview_at(text, span.start), budget)
                        return "" if budget.exhausted
                        cursor <- span.start + 1
                    else:
                        # The end-of-input match is terminal. Do not create a
                        # synthetic `length + 1` cursor that can wrap a hostile
                        # usize-sized view.
                        break
                else:
                    cursor <- span.end
            return "" if output.count == 0
            owned: mutable dstr = ctx_fstr_alloc(output.count)
            if owned.items == null:
                budget.exhausted <- true
                return ""
            ctx_fstr_append(owned, output.items, output.count)
            return bytes_view(owned)


        def evaluate_regex_replace(machine: mutable Machine&, text: RuntimeValue, pattern: RuntimeValue, replacement: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if text.kind != RuntimeValueKind.Text or pattern.kind != RuntimeValueKind.Text or replacement.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not regex_input_within_budget(text.text, pattern.text) or not regex_replacement_within_budget(replacement.text):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            budget: mutable RegexWorkBudget = RegexWorkBudget{remaining: regex_work_budget_limit(machine)}
            value: sview = regex_replace_snapshot(text.text, pattern.text, replacement.text, budget)
            if regex_work_account(machine, budget):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            return runtime_text(value)


        def append_text_replacement(machine: mutable Machine&, output: mutable dstr&, value: sview, start: usize, end: usize) -> bool:
            if start > end:
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return false
            if end > sview_len(value):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return false
            if output.count > INTERPRET_MAX_TEXT_REPLACEMENT_BYTES:
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return false
            if end - start > INTERPRET_MAX_TEXT_REPLACEMENT_BYTES - output.count:
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return false
            append_regex_text(output, value, start, end)
            return true


        def text_replace_snapshot(machine: mutable Machine&, text: sview, old: sview, replacement: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            output: mutable dstr = []
            text_length: usize = sview_len(text)
            old_length: usize = sview_len(old)
            if old_length == 0:
                return "" if not append_text_replacement(machine, output, replacement, 0, sview_len(replacement))
                for index in 0..<text_length |machine, output, text, replacement|:
                    return "" if not append_text_replacement(machine, output, text, index, index + 1)
                    return "" if not append_text_replacement(machine, output, replacement, 0, sview_len(replacement))
                if text_length > 0:
                    return "" if not append_text_replacement(machine, output, replacement, 0, sview_len(replacement))
            else:
                cursor: mutable usize = 0
                while cursor < text_length:
                    if cursor <= text_length and old_length <= text_length - cursor and text_matches_at(text, old, cursor):
                        return "" if not append_text_replacement(machine, output, replacement, 0, sview_len(replacement))
                        cursor <- cursor + old_length
                    else:
                        return "" if not append_text_replacement(machine, output, text, cursor, cursor + 1)
                        cursor <- cursor + 1
            return "" if output.count == 0
            owned: mutable dstr = ctx_fstr_alloc(output.count)
            if owned.items == null:
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return ""
            ctx_fstr_append(owned, output.items, output.count)
            return bytes_view(owned)


        def evaluate_text_replace(machine: mutable Machine&, text: RuntimeValue, old: RuntimeValue, replacement: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if text.kind != RuntimeValueKind.Text or old.kind != RuntimeValueKind.Text or replacement.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            value: sview = text_replace_snapshot(machine, text.text, old.text, replacement.text)
            return runtime_void() if machine.failure != InterpretFailure.None
            return runtime_text(value)


        def evaluate_regex_split(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, text: RuntimeValue, pattern: RuntimeValue) -> RuntimeValue:
            if text.kind != RuntimeValueKind.Text or pattern.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not regex_input_within_budget(text.text, pattern.text):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            fields: mutable darray[RegexMatchSpan] = []
            field_start: mutable usize = 0
            cursor: mutable usize = 0
            length: usize = sview_len(text.text)
            budget: mutable RegexWorkBudget = RegexWorkBudget{remaining: regex_work_budget_limit(machine)}
            while cursor <= length:
                span: RegexMatchSpan = regex_find_match(text.text, pattern.text, cursor, budget)
                if regex_work_account(machine, budget):
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                if not span.found:
                    fields.push(RegexMatchSpan{start: field_start, end: length, found: true})
                    break
                fields.push(RegexMatchSpan{start: field_start, end: span.start, found: true})
                if span.start == span.end:
                    field_start <- span.start
                    if span.start < length:
                        cursor <- span.start + 1
                    else:
                        # The end-of-input match is terminal.  A synthetic
                        # `length + 1` sentinel can wrap a hostile usize-sized
                        # view, so leave the loop explicitly instead.
                        break
                else:
                    cursor <- span.end
                    field_start <- span.end
            if not runtime_storage_span_u32_valid(storage, fields.count):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            result_start: u32 = storage.count.u32()
            for field in fields |storage, text|:
                storage.push(runtime_text(text.text[field.start:field.end]))
            return runtime_array(result_start, fields.count.u32())


        def evaluate_regex_find(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, text: RuntimeValue, pattern: RuntimeValue) -> RuntimeValue:
            if text.kind != RuntimeValueKind.Text or pattern.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not regex_input_within_budget(text.text, pattern.text):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            matches: mutable darray[RegexMatchSpan] = []
            cursor: mutable usize = 0
            length: usize = sview_len(text.text)
            budget: mutable RegexWorkBudget = RegexWorkBudget{remaining: regex_work_budget_limit(machine)}
            while cursor <= length:
                span: RegexMatchSpan = regex_find_match(text.text, pattern.text, cursor, budget)
                if regex_work_account(machine, budget):
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                if not span.found:
                    break
                matches.push(span)
                if span.start == span.end:
                    if span.start < length:
                        cursor <- span.start + 1
                    else:
                        # There is no later position after an empty match at
                        # EOF; terminate instead of constructing a wrapping
                        # `length + 1` cursor.
                        break
                else:
                    cursor <- span.end
            if not runtime_storage_span_u32_valid(storage, matches.count):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            result_start: u32 = storage.count.u32()
            for matched_span in matches |storage, text|:
                storage.push(runtime_text(text.text[matched_span.start:matched_span.end]))
            return runtime_array(result_start, matches.count.u32())


        # RegexCapture uses integer mode 0 for the historical whole-match plus
        # capture-value result and mode 1 for the descriptor-oriented receiver
        # API (`Regex.capture_names`). Both modes share the same conservative
        # flat-group layout proof, so unsupported nested/quantified layouts
        # fail closed with an empty array instead of guessing metadata.
        def evaluate_regex_capture(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, text: RuntimeValue, pattern: RuntimeValue, mode: i64 = 0) -> RuntimeValue:
            if mode not in {0, 1}:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if text.kind != RuntimeValueKind.Text or pattern.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not regex_input_within_budget(text.text, pattern.text):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            # The result offset is published as a u32 even when the caller
            # supplies an already-populated storage pool.  Validate the
            # existing cursor before narrowing it; otherwise a malformed or
            # oversized pool could silently wrap the offset before the empty
            # match path returns.
            if not runtime_storage_span_u32_valid(storage, 0):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            result_start: u32 = storage.count.u32()
            budget: mutable RegexWorkBudget = RegexWorkBudget{remaining: regex_work_budget_limit(machine)}
            span: RegexMatchSpan = regex_find_match(text.text, pattern.text, 0, budget)
            if regex_work_account(machine, budget):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            return runtime_array(result_start, 0) if not span.found
            captures: mutable darray[RegexMatchSpan] = []
            names: mutable darray[sview] = []
            captures_found: bool = regex_capture_spans_for_match(text.text, pattern.text, span, captures, names, budget)
            if regex_work_account(machine, budget):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            if mode == 1:
                if not captures_found:
                    return runtime_array(result_start, 0)
                if not runtime_storage_span_u32_valid(storage, names.count):
                    interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                    return runtime_void()
                if captures_found:
                    for name in names |storage|:
                        storage.push(runtime_text(name))
                return runtime_array(result_start, storage.count.u32() - result_start)
            result_count: mutable usize = 1
            result_count <- result_count + captures.count if captures_found
            if not runtime_storage_span_u32_valid(storage, result_count):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            storage.push(runtime_text(text.text[span.start:span.end]))
            if captures_found:
                for capture in captures |storage, text|:
                    storage.push(runtime_text(text.text[capture.start:capture.end]) if capture.found else runtime_text(""))
            return runtime_array(result_start, storage.count.u32() - result_start)


        # Named capture lookup shares the conservative flat-layout proof used
        # by RegexCapture. Unknown, duplicate, absent, or non-participating
        # names return empty text rather than guessing a capture identity.
        def evaluate_regex_capture_named(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, text: RuntimeValue, pattern: RuntimeValue, name: RuntimeValue) -> RuntimeValue:
            if text.kind != RuntimeValueKind.Text or pattern.kind != RuntimeValueKind.Text or name.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not regex_input_within_budget(text.text, pattern.text):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            budget: mutable RegexWorkBudget = RegexWorkBudget{remaining: regex_work_budget_limit(machine)}
            if not regex_work_bytes(budget, sview_len(name.text)):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            span: RegexMatchSpan = regex_find_match(text.text, pattern.text, 0, budget)
            if regex_work_account(machine, budget):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            return runtime_text("") if not span.found
            captures: mutable darray[RegexMatchSpan] = []
            names: mutable darray[sview] = []
            captures_found: bool = regex_capture_spans_for_match(text.text, pattern.text, span, captures, names, budget)
            if regex_work_account(machine, budget):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            return runtime_text("") if not captures_found
            match_index: mutable usize = names.count
            matches: mutable usize = 0
            for index in 0..<names.count.usize() |names, name, match_index, matches, budget|:
                if not regex_work_step(budget):
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                if names[index] == name.text:
                    match_index <- index
                    matches <- matches + 1
            if regex_work_account(machine, budget):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            return runtime_text("") if matches != 1 or match_index >= captures.count.usize() or not captures[match_index].found
            capture: RegexMatchSpan = captures[match_index]
            return runtime_text(text.text[capture.start:capture.end])


        # RegexSearch carries a small mode in Instruction.integer so the
        # existing verified opcode can serve Python-shaped receiver methods:
        # 0 = unanchored search, 1 = match at the beginning, 2 = full match.
        def evaluate_regex_search(machine: mutable Machine&, text: RuntimeValue, pattern: RuntimeValue, mode: i64) -> RuntimeValue:
            if text.kind != RuntimeValueKind.Text or pattern.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not regex_input_within_budget(text.text, pattern.text):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            budget: mutable RegexWorkBudget = RegexWorkBudget{remaining: regex_work_budget_limit(machine)}
            if mode == 0:
                found: bool = regex_search(text.text, pattern.text, budget)
                if regex_work_account(machine, budget):
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                return runtime_bool(found)
            if mode == 1:
                if not regex_work_bytes(budget, sview_len(pattern.text)):
                    _ = regex_work_account(machine, budget)
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                endpoint: i64 = regex_match_expression_end(pattern.text, 0, sview_len(pattern.text), text.text, 0, budget)
                if regex_work_account(machine, budget):
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                return runtime_bool(endpoint >= 0)
            if mode == 2:
                if not regex_work_bytes(budget, sview_len(pattern.text)):
                    _ = regex_work_account(machine, budget)
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                endpoint: i64 = regex_match_expression_end(pattern.text, 0, sview_len(pattern.text), text.text, 0, budget)
                if regex_work_account(machine, budget):
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                return runtime_bool(endpoint >= 0 and endpoint.usize() == sview_len(text.text))
            interpret_set_failure(machine, InterpretFailure.TypeMismatch)
            return runtime_void()


        def text_matches_at(text: sview, separator: sview, start: usize) -> bool:
            text_length: usize = sview_len(text)
            separator_length: usize = sview_len(separator)
            false return if start > text_length
            false return if separator_length > text_length - start
            for offset in 0..<sview_len(separator) |text, separator, start|:
                false return if sview_at(text, start + offset) != sview_at(separator, offset)
            return true


        def publish_split_fields(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, fields: darray[sview]) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if not runtime_storage_span_u32_valid(storage, fields.count):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            result_start: u32 = storage.count.u32()
            for field in fields |storage|:
                storage.push(runtime_text(field))
            return runtime_array(result_start, fields.count.u32())


        def evaluate_split(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, text: RuntimeValue, separator: RuntimeValue, mode: i64, maxsplit: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if text.kind != RuntimeValueKind.Text or mode < 0 or mode > 2 or maxsplit.kind != RuntimeValueKind.Int:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            length: usize = sview_len(text.text)
            parts: mutable darray[sview] = []
            if mode == 1:
                if maxsplit.integer != -1:
                    interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                    return runtime_void()
                cursor: mutable usize = 0
                while cursor < length and text_ascii_whitespace(sview_at(text.text, cursor)) |text, cursor, length, parts|:
                    cursor <- cursor + 1
                while cursor < length:
                    field_start: mutable usize = cursor
                    while cursor < length and not text_ascii_whitespace(sview_at(text.text, cursor)) |text, cursor, length, field_start|:
                        cursor <- cursor + 1
                    parts.push(text.text[field_start:cursor])
                    while cursor < length and text_ascii_whitespace(sview_at(text.text, cursor)) |text, cursor, length, field_start, parts|:
                        cursor <- cursor + 1
                return publish_split_fields(machine, storage, parts)
            if separator.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if maxsplit.integer == 0:
                parts.push(text.text)
                return publish_split_fields(machine, storage, parts)
            separator_length: usize = sview_len(separator.text)
            if separator_length == 0:
                if maxsplit.integer > 0:
                    split_count: usize = maxsplit.integer.usize() if maxsplit.integer < sview_len(text.text).i64() else sview_len(text.text)
                    for index in 0..<split_count |text, parts|:
                        parts.push(text.text[index:index + 1])
                    parts.push(text.text[split_count:sview_len(text.text)]) if split_count < sview_len(text.text)
                    return publish_split_fields(machine, storage, parts)
                for index in 0..<sview_len(text.text) |text, parts|:
                    parts.push(text.text[index:index + 1])
                return publish_split_fields(machine, storage, parts)
            if mode == 2:
                field_end: mutable usize = sview_len(text.text)
                cursor: mutable usize = field_end
                splits: mutable i64 = 0
                while cursor >= separator_length:
                    candidate: usize = cursor - separator_length
                    if text_matches_at(text.text, separator.text, candidate):
                        break if maxsplit.integer > -1 and splits >= maxsplit.integer
                        parts.push(text.text[candidate + separator_length:field_end])
                        splits <- splits + 1
                        field_end <- candidate
                        cursor <- candidate
                    else:
                        cursor <- cursor - 1
                parts.push(text.text[0:field_end])
                left: mutable usize = 0
                right: mutable usize = parts.count - 1
                while left < right:
                    swapped: sview = parts[left]
                    parts[left] <- parts[right]
                    parts[right] <- swapped
                    left <- left + 1
                    right <- right - 1
                return publish_split_fields(machine, storage, parts)
            field_start: mutable usize = 0
            cursor: mutable usize = 0
            splits: mutable i64 = 0
            while cursor <= sview_len(text.text) and separator_length <= sview_len(text.text) - cursor:
                if text_matches_at(text.text, separator.text, cursor):
                    break if maxsplit.integer > -1 and splits >= maxsplit.integer
                    parts.push(text.text[field_start:cursor])
                    splits <- splits + 1
                    cursor <- cursor + separator_length
                    field_start <- cursor
                else:
                    cursor <- cursor + 1
            parts.push(text.text[field_start:sview_len(text.text)])
            return publish_split_fields(machine, storage, parts)


        # Python-compatible line splitting: LF and CR delimiters are recognized,
        # CRLF is consumed as one delimiter, and a trailing delimiter does not
        # create an extra empty line. Empty input produces an empty array.
        def evaluate_split_lines(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, text: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if text.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            length: usize = sview_len(text.text)
            fields: mutable darray[sview] = []
            line_start: mutable usize = 0
            cursor: mutable usize = 0
            while cursor < length:
                delimiter: bool = sview_at(text.text, cursor) == 10 or sview_at(text.text, cursor) == 13
                if delimiter:
                    fields.push(text.text[line_start:cursor])
                    if sview_at(text.text, cursor) == 13 and cursor < length - 1 and sview_at(text.text, cursor + 1) == 10:
                        cursor <- cursor + 2
                    else:
                        cursor <- cursor + 1
                    line_start <- cursor
                else:
                    cursor <- cursor + 1
            fields.push(text.text[line_start:length]) if line_start < length
            if not runtime_storage_span_u32_valid(storage, fields.count):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            result_start: u32 = storage.count.u32()
            for field in fields |storage|:
                storage.push(runtime_text(field))
            return runtime_array(result_start, fields.count.u32())


        def evaluate_join(machine: mutable Machine&, storage: darray[RuntimeValue]&, fields: RuntimeValue, separator: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if fields.kind != RuntimeValueKind.Array or separator.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_array_range_valid(storage, fields):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            return runtime_text("") if fields.array_count == 0
            separator_count: usize = fields.array_count.usize() - 1
            separator_length: usize = sview_len(separator.text)
            total: mutable usize = 0
            for _ in 0..<separator_count |machine, separator_length, total|:
                next_total: usize = total + separator_length
                if next_total < total:
                    interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                    return runtime_void()
                if next_total > INTERPRET_MAX_TEXT_OUTPUT_BYTES:
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                total <- next_total
            for offset in 0..<fields.array_count.usize() |machine, storage, fields, total|:
                field: RuntimeValue = storage[fields.array_start.usize() + offset]
                if field.kind != RuntimeValueKind.Text:
                    interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                    return runtime_void()
                field_length: usize = sview_len(field.text)
                next_total: usize = total + field_length
                if next_total < total:
                    interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                    return runtime_void()
                if next_total > INTERPRET_MAX_TEXT_OUTPUT_BYTES:
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                total <- next_total
            return runtime_text("") if total == 0
            bytes: mutable dstr = ctx_fstr_alloc(total)
            if bytes.items == null:
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            for offset in 0..<fields.array_count.usize() |storage, fields, separator, bytes|:
                if offset > 0:
                    ctx_fstr_append(bytes, separator.text.data, separator_length)
                field: RuntimeValue = storage[fields.array_start.usize() + offset]
                ctx_fstr_append(bytes, field.text.data, sview_len(field.text))
            return runtime_text(bytes_view(bytes))


        def nul_terminated_text(value: sview) -> dstr can[Memory.Allocate, Abort.Panic]:
            length: usize = sview_len(value)
            # Reject a payload whose terminator would cross the host-string
            # ceiling before evaluating `length + 1` or allocating.
            return [] if length >= INTERPRET_MAX_CSTRING_BYTES
            allocation_length: usize = length + 1
            return [] if allocation_length == 0
            allocation_i64: i64 = allocation_length.i64()
            return [] if allocation_i64 < 0 or allocation_i64.usize() != allocation_length
            bytes: mutable dstr = ctx_fstr_alloc(allocation_length)
            return bytes if bytes.items == null
            ctx_fstr_append(bytes, value.data, sview_len(value))
            ctx_fstr_append(bytes, "\0", 1)
            return bytes


        def path_text_valid(value: sview) -> bool:
            length: usize = sview_len(value)
            return false if length == 0 or length >= INTERPRET_MAX_PATH_BYTES
            return not text_has_nul(value)


        # Pure Path operations do not cross libc, so they may accept an empty
        # spelling such as `path_normalize(path"")`. They still need the same
        # finite path envelope before `Fs::join`, `Fs::normalize`, or
        # `Fs::relative` allocate from the permanent arena; otherwise two
        # ordinary text operands could create an oversized derived path.
        def path_shape_text_valid(value: sview) -> bool:
            return false if sview_len(value) >= INTERPRET_MAX_PATH_BYTES
            return not text_has_nul(value)


    public:
        def path_shape_result_valid(value: sview) -> bool:
            return false if sview_len(value) == 0
            return path_shape_text_valid(value)


        # Fs::join allocates its result directly in the permanent arena. Check
        # the exact lexical join size first so two individually admitted path
        # fields cannot create an oversized derived allocation.
    private:
        def path_join_length_fits(base: sview, leaf: sview) -> bool:
            leaf_length: usize = sview_len(leaf)
            return leaf_length < INTERPRET_MAX_PATH_BYTES if leaf_length > 0 and sview_at(leaf, 0) == 47
            base_length: usize = sview_len(base)
            total: mutable usize = base_length + leaf_length
            return false if total < base_length
            if base_length > 0 and sview_at(base, base_length - 1) != 47:
                return false if total >= INTERPRET_MAX_PATH_BYTES
                total <- total + 1
            return total < INTERPRET_MAX_PATH_BYTES


        def nul_terminated_path(value: sview) -> dstr can[Memory.Allocate, Abort.Panic]:
            return [] if not path_text_valid(value)
            return nul_terminated_text(value)


        def host_cstring_length_bounded(value: u8&, too_large: mutable bool) -> usize:
            too_large <- false
            length: mutable usize = 0
            limit: usize = INTERPRET_MAX_CSTRING_BYTES - 1
            while length <= limit:
                return length if value[length] == 0
                length <- length + 1
            too_large <- true
            return length


        def host_environment_cstring_length_bounded(value: u8&, limit: usize, too_large: mutable bool) -> usize:
            too_large <- false
            for index in 0..<(limit + 1) |value, limit, too_large|:
                match EsEnvironmentReadBudget::classify_byte(value[index], index, limit):
                    EsEnvironmentReadBudget::ByteAction.Payload:
                        continue
                    EsEnvironmentReadBudget::ByteAction.Terminator:
                        return index
                    EsEnvironmentReadBudget::ByteAction.Exceeded:
                        too_large <- true
                        return index
            too_large <- true
            return limit + 1


        # libc-returned path strings are admitted through the path envelope,
        # not the broader process/text C-string ceiling. The terminator must
        # appear before byte 4096 so the resulting owned value remains a valid
        # Path before any allocation or public return.
        def host_path_cstring_length_bounded(value: u8&, too_large: mutable bool) -> usize:
            too_large <- false
            length: mutable usize = 0
            while length < INTERPRET_MAX_PATH_BYTES:
                return length if value[length] == 0
                length <- length + 1
            too_large <- true
            return length


        def evaluate_path_exists(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            return runtime_bool(false) if not path_text_valid(path.text)
            c_path: dstr = nul_terminated_path(path.text)
            return runtime_bool(false) if c_path.items == null
            can Blocking.IO, Memory.Allocate, Memory.Release:
                return runtime_bool(file_exists(c_path.items.cast[cstr]))


        def evaluate_is_file(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                return runtime_bool(false)
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                return runtime_bool(false)
            info: mutable ElisascriptStat = zeroed
            path_items: u8& = c_path.items
            can Blocking.IO:
                return runtime_bool(false) if elisascript_posix_stat(path_items.cast[cstr], info) != 0
                return runtime_bool((info.mode & EsRuntime::DarwinStatMode::MASK) == EsRuntime::DarwinStatMode::REGULAR)


        def evaluate_path_access(machine: mutable Machine&, path: RuntimeValue, mode: int) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text) or ((mode not in {1, 2, 4})):
                return runtime_bool(false)
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                return runtime_bool(false)
            path_items: u8& = c_path.items
            can Blocking.IO:
                return runtime_bool(elisascript_posix_access(path_items.cast[cstr], mode) == 0)


        def evaluate_touch_path(machine: mutable Machine&, path: RuntimeValue, exist_ok: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text or exist_ok.kind != RuntimeValueKind.Bool:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                # Python's Path.touch(exist_ok=False) reports an existing entry
                # as an error before attempting to open it.  The default
                # one-operand form and exist_ok=true retain ordinary touch
                # behavior: create when absent and refresh timestamps otherwise.
                if not exist_ok.boolean:
                    existing: mutable ElisascriptStat = zeroed
                    if elisascript_posix_lstat(path_items.cast[cstr], existing) == 0:
                        interpret_set_failure(machine, InterpretFailure.FileIo)
                        return runtime_void()
                # Opening in append mode creates a missing file without changing
                # the bytes of an existing one.  utimes(NULL) then gives both
                # cases the shell/Python touch timestamp semantics.
                handle: mutable heap void&? = interpret_open_file(machine, path_items, "ab")
                if handle == null:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                stream: mutable heap void& = handle
                close_status: int = interpret_close_file(machine, stream)
                if close_status != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                if elisascript_posix_utimes(path_items.cast[cstr], null) != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                return runtime_bool(true)


        def evaluate_chmod_path(machine: mutable Machine&, path: RuntimeValue, mode: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text or mode.kind != RuntimeValueKind.Int:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            if mode.integer < 0 or mode.integer > 4294967295:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate:
                if elisascript_posix_chmod(path_items.cast[cstr], mode.integer.u32()) != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                return runtime_bool(true)


        def evaluate_file_size(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            info: mutable ElisascriptStat = zeroed
            path_items: u8& = c_path.items
            can Blocking.IO:
                if elisascript_posix_stat(path_items.cast[cstr], info) != 0 or info.size < 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                return runtime_int(info.size)


        def evaluate_file_mode(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            info: mutable ElisascriptStat = zeroed
            path_items: u8& = c_path.items
            can Blocking.IO:
                if elisascript_posix_stat(path_items.cast[cstr], info) != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                return runtime_int(info.mode.u64())


        def evaluate_file_timestamp(machine: mutable Machine&, path: RuntimeValue, timestamp: i64) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            info: mutable ElisascriptStat = zeroed
            path_items: u8& = c_path.items
            can Blocking.IO:
                if elisascript_posix_stat(path_items.cast[cstr], info) != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                return runtime_int(info.access_time.seconds) if timestamp == 1
                return runtime_int(info.change_time.seconds) if timestamp == 2
                return runtime_int(info.modify_time.seconds)


        def evaluate_file_mtime(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            return evaluate_file_timestamp(machine, path, 0)


        def evaluate_file_atime(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            return evaluate_file_timestamp(machine, path, 1)


        def evaluate_file_ctime(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            return evaluate_file_timestamp(machine, path, 2)


        def evaluate_is_symlink(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                return runtime_bool(false)
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                return runtime_bool(false)
            info: mutable ElisascriptStat = zeroed
            path_items: u8& = c_path.items
            can Blocking.IO:
                return runtime_bool(false) if elisascript_posix_lstat(path_items.cast[cstr], info) != 0
                return runtime_bool((info.mode & EsRuntime::DarwinStatMode::MASK) == EsRuntime::DarwinStatMode::SYMLINK)


        def evaluate_read_link(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            path_items: u8& = c_path.items
            capacity: mutable usize = 256
            # POSIX readlink does not append a NUL byte. Retry when the result
            # exactly fills the buffer, up to the shared 4 KiB Path envelope,
            # and retry interrupted calls through a bounded EINTR budget. Then
            # report the same FileIo failure as other typed file metadata
            # operations.
            eintr_retries: mutable usize = 0
            while capacity <= INTERPRET_MAX_PATH_BYTES:
                target: mutable dstr = ctx_fstr_alloc(capacity)
                if target.items == null:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                target_items: mutable u8& = target.items
                count: mutable isize = 0
                can Blocking.IO:
                    count <- elisascript_posix_readlink(path_items.cast[cstr], target_items, capacity)
                if count < 0:
                    errno: mutable int& = elisascript_posix_errno()
                    if errno[0] == EsRuntime::DarwinErrno::EINTR and eintr_retries < PosixRetry::EINTR_RETRIES:
                        eintr_retries <- eintr_retries + 1
                        continue
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                eintr_retries <- 0
                if count < capacity:
                    if count.usize() == 0 or count.usize() >= INTERPRET_MAX_PATH_BYTES:
                        interpret_set_failure(machine, InterpretFailure.FileIo)
                        return runtime_void()
                    target.count <- count.usize()
                    return runtime_text(bytes_view(target))
                capacity <- capacity * 2 if capacity < INTERPRET_MAX_PATH_BYTES else INTERPRET_MAX_PATH_BYTES + 1
            interpret_set_failure(machine, InterpretFailure.FileIo)
            return runtime_void()


        def evaluate_symlink_path(machine: mutable Machine&, target: RuntimeValue, link: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if target.kind != RuntimeValueKind.Text or link.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(target.text) or not path_text_valid(link.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            c_target: dstr = nul_terminated_path(target.text)
            c_link: dstr = nul_terminated_path(link.text)
            if c_target.items == null or c_link.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            target_items: u8& = c_target.items
            link_items: u8& = c_link.items
            can Blocking.IO:
                if elisascript_posix_symlink(target_items.cast[cstr], link_items.cast[cstr]) != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                return runtime_bool(true)


        def evaluate_read_text(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            # A nominal Path may still arrive from a host boundary or a
            # dynamically constructed value.  Reject empty and embedded-NUL
            # names before converting to a C string; otherwise fopen would
            # either report an opaque platform error or silently truncate at
            # the first NUL byte.
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                handle: mutable heap void&? = interpret_open_file(machine, path_items, "rb")
                if handle == null:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                stream: mutable heap void& = handle
                if fseek(stream, 0, FILEIO_SEEK_END) != 0:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                size: i64 = ftell(stream)
                if size < 0:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                if size.u64() > machine.file_input_limit:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                host_size: usize = size.usize()
                if host_size.i64() != size:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                if fseek(stream, 0, FILEIO_SEEK_SET) != 0:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                if size == 0:
                    _ = interpret_close_file(machine, stream)
                    return runtime_text("")
                bytes: mutable dstr = ctx_fstr_alloc(host_size)
                if bytes.items == null:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                byte_items: mutable u8& = bytes.items
                read_count: usize = read_stream_fully(stream, byte_items, host_size)
                close_status: int = interpret_close_file(machine, stream)
                if read_count != host_size or close_status != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                bytes.count <- host_size
                return runtime_text(bytes_view(bytes))


        def evaluate_write_text(machine: mutable Machine&, path: RuntimeValue, text: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text or text.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                handle: mutable heap void&? = interpret_open_file(machine, path_items, "wb")
                if handle == null:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                stream: mutable heap void& = handle
                written: mutable usize = 0
                written <- write_stream_fully(stream, text.text.data, sview_len(text.text)) if sview_len(text.text) > 0
                close_status: int = interpret_close_file(machine, stream)
                if written != sview_len(text.text) or close_status != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                return runtime_int(written.i64())


        def evaluate_append_text(machine: mutable Machine&, path: RuntimeValue, text: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text or text.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                handle: mutable heap void&? = interpret_open_file(machine, path_items, "ab")
                if handle == null:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                stream: mutable heap void& = handle
                written: mutable usize = 0
                written <- write_stream_fully(stream, text.text.data, sview_len(text.text)) if sview_len(text.text) > 0
                close_status: int = interpret_close_file(machine, stream)
                if written != sview_len(text.text) or close_status != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                return runtime_int(written.i64())


        def evaluate_read_bytes(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                handle: mutable heap void&? = interpret_open_file(machine, path_items, "rb")
                if handle == null:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                stream: mutable heap void& = handle
                if fseek(stream, 0, FILEIO_SEEK_END) != 0:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                size: i64 = ftell(stream)
                if size < 0:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                if size.u64() > machine.file_input_limit:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                host_size: usize = size.usize()
                if host_size.i64() != size:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                if not runtime_storage_span_u32_valid(storage, host_size):
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                    return runtime_void()
                if fseek(stream, 0, FILEIO_SEEK_SET) != 0:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                start: u32 = storage.count.u32()
                if size == 0:
                    close_status: int = interpret_close_file(machine, stream)
                    if close_status != 0:
                        interpret_set_failure(machine, InterpretFailure.FileIo)
                        return runtime_void()
                    return runtime_array(start, 0)
                bytes: mutable dstr = ctx_fstr_alloc(host_size)
                if bytes.items == null:
                    _ = interpret_close_file(machine, stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                byte_items: mutable u8& = bytes.items
                read_count: usize = read_stream_fully(stream, byte_items, host_size)
                close_status: int = interpret_close_file(machine, stream)
                if read_count != host_size or close_status != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                for offset in 0..<host_size |storage, byte_items|:
                    storage.push(runtime_int(byte_items[offset].i64()))
                return runtime_array(start, host_size.u32())


        def evaluate_write_bytes(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, path: RuntimeValue, values: RuntimeValue, append: bool) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text or values.kind != RuntimeValueKind.Array:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            if not runtime_array_range_valid(storage, values):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            count: usize = values.array_count.usize()
            bytes: mutable dstr = ctx_fstr_alloc(count)
            if count > 0:
                if bytes.items == null:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                byte_items: mutable u8& = bytes.items
                for offset in 0..<count |machine, storage, values, byte_items|:
                    value: RuntimeValue = storage[values.array_start.usize() + offset]
                    if value.kind != RuntimeValueKind.Int or value.integer < 0 or value.integer > 255:
                        interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                        return runtime_void()
                    byte_items[offset] <- value.integer.u8()
                path_items: u8& = c_path.items
                can Blocking.IO, Memory.Allocate, Memory.Release:
                    handle: mutable heap void&? = interpret_open_file(machine, path_items, "ab" if append else "wb")
                    if handle == null:
                        interpret_set_failure(machine, InterpretFailure.FileIo)
                        return runtime_void()
                    stream: mutable heap void& = handle
                    written: usize = write_stream_fully(stream, byte_items, count)
                    close_status: int = interpret_close_file(machine, stream)
                    if written != count or close_status != 0:
                        interpret_set_failure(machine, InterpretFailure.FileIo)
                        return runtime_void()
                    return runtime_int(written.i64())
            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                handle: mutable heap void&? = interpret_open_file(machine, path_items, "ab" if append else "wb")
                if handle == null:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                stream: mutable heap void& = handle
                written: usize = 0
                close_status: int = interpret_close_file(machine, stream)
                if written != count or close_status != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                return runtime_int(written.i64())


        def evaluate_remove_path(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            path_items: u8& = c_path.items
            can Blocking.IO:
                return runtime_bool(remove_file(path_items.cast[cstr]))


        def evaluate_copy_path(machine: mutable Machine&, source: RuntimeValue, destination: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if source.kind != RuntimeValueKind.Text or destination.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(source.text) or not path_text_valid(destination.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            # Never open the destination for truncating write when the caller
            # asks to copy a path onto itself; the source would be destroyed
            # before its bytes could be read.
            if source.text == destination.text:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            c_source: dstr = nul_terminated_path(source.text)
            c_destination: dstr = nul_terminated_path(destination.text)
            if c_source.items == null or c_destination.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            source_items: u8& = c_source.items
            destination_items: u8& = c_destination.items
            source_info: mutable ElisascriptStat = zeroed
            destination_info: mutable ElisascriptStat = zeroed
            can Blocking.IO:
                source_exists: bool = elisascript_posix_stat(source_items.cast[cstr], source_info) == 0
                destination_exists: bool = elisascript_posix_stat(destination_items.cast[cstr], destination_info) == 0
                if source_exists and destination_exists and source_info.device == destination_info.device and source_info.inode == destination_info.inode:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
            can Blocking.IO, Memory.Allocate, Memory.Release:
                source_handle: mutable heap void&? = interpret_open_file(machine, source_items, "rb")
                if source_handle == null:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                source_stream: mutable heap void& = source_handle
                if fseek(source_stream, 0, FILEIO_SEEK_END) != 0:
                    _ = interpret_close_file(machine, source_stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                size: i64 = ftell(source_stream)
                if size < 0 or fseek(source_stream, 0, FILEIO_SEEK_SET) != 0:
                    _ = interpret_close_file(machine, source_stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                if size.u64() > machine.file_input_limit:
                    _ = interpret_close_file(machine, source_stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                host_size: usize = size.usize()
                if host_size.i64() != size:
                    _ = interpret_close_file(machine, source_stream)
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                bytes: mutable dstr = ctx_fstr_alloc(host_size)
                read_count: mutable usize = 0
                if size > 0:
                    if bytes.items == null:
                        _ = interpret_close_file(machine, source_stream)
                        interpret_set_failure(machine, InterpretFailure.FileIo)
                        return runtime_void()
                    byte_items: mutable u8& = bytes.items
                    read_count <- read_stream_fully(source_stream, byte_items, host_size)
                source_close: int = interpret_close_file(machine, source_stream)
                if read_count != host_size or source_close != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                destination_handle: mutable heap void&? = interpret_open_file(machine, destination_items, "wb")
                if destination_handle == null:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                destination_stream: mutable heap void& = destination_handle
                written: mutable usize = 0
                if size > 0:
                    if bytes.items == null:
                        _ = interpret_close_file(machine, destination_stream)
                        interpret_set_failure(machine, InterpretFailure.FileIo)
                        return runtime_void()
                    byte_items: mutable u8& = bytes.items
                    written <- write_stream_fully(destination_stream, byte_items, host_size)
                destination_close: int = interpret_close_file(machine, destination_stream)
                if written != host_size or destination_close != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                return runtime_bool(true)


        def evaluate_move_path(machine: mutable Machine&, source: RuntimeValue, destination: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if source.kind != RuntimeValueKind.Text or destination.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(source.text) or not path_text_valid(destination.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            c_source: dstr = nul_terminated_path(source.text)
            c_destination: dstr = nul_terminated_path(destination.text)
            if c_source.items == null or c_destination.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            source_items: u8& = c_source.items
            destination_items: u8& = c_destination.items
            can Blocking.IO:
                if elisascript_posix_rename(source_items, destination_items) != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return runtime_void()
                return runtime_bool(true)


        def remove_tree_entry(machine: mutable Machine&, path: sview, depth: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            if depth > 128:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return false
            if not path_text_valid(path):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return false
            c_path: dstr = nul_terminated_path(path)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return false
            info: mutable ElisascriptStat = zeroed
            path_items: u8& = c_path.items
            can Blocking.IO:
                if elisascript_posix_lstat(path_items.cast[cstr], info) != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return false
            if (info.mode & EsRuntime::DarwinStatMode::MASK) != EsRuntime::DarwinStatMode::DIRECTORY:
                can Blocking.IO:
                    if not remove_file(path_items.cast[cstr]):
                        interpret_set_failure(machine, InterpretFailure.FileIo)
                        return false
                return true
            scanner: mutable DirectoryScanner = DirectoryScanner{names: [], kinds: [], directory: null, opened: false, failed: false}
            read_owned_directory(machine, path, scanner)
            if not scanner.opened or scanner.failed:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return false
            for name in scanner.names |machine, path, depth|:
                child: sview = path_join_value(path, bytes_view(name))
                return false if not remove_tree_entry(machine, child, depth + 1)
            can Blocking.IO:
                if elisascript_posix_rmdir(path_items.cast[cstr]) != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return false
            return true


        def evaluate_remove_tree(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            return runtime_bool(remove_tree_entry(machine, path.text, 0))


        # A recursive copy must reject a destination that is the source itself
        # or one of its lexical descendants. Otherwise the first directory
        # creation makes the destination visible to the source scanner and the
        # copy walks its own output until the generic depth guard fires. Use
        # normalized lexical spellings so `.`/`..` aliases cannot bypass the
        # boundary check without adding an undeclared current-directory read;
        # a second canonical check below handles destination-parent symlinks.
        def copy_tree_destination_overlaps_source(machine: mutable Machine&, source: sview, destination: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            normalized_source: dstr = Fs::normalize(&perm_arena, source)
            normalized_destination: dstr = Fs::normalize(&perm_arena, destination)
            source_text: sview = bytes_view(normalized_source)
            destination_text: sview = bytes_view(normalized_destination)
            if not path_shape_result_valid(source_text) or not path_shape_result_valid(destination_text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return false
            source_length: usize = sview_len(source_text)
            destination_length: usize = sview_len(destination_text)
            return false if destination_length < source_length
            return false if not text_starts_with(destination_text, source_text)
            return true if destination_length == source_length
            return true if source_text == "." and sview_at(destination_text, 0) != 47
            return true if source_length == 1 and sview_at(source_text, 0) == 47
            return sview_at(destination_text, source_length) == 47


        # Lexical normalization cannot see a symlink in the destination's
        # parent. Resolve the existing source and destination parent before
        # the first mkdir so an alias such as `alias/nested`, where `alias`
        # points into the source tree, is rejected without mutating the tree.
        # The destination leaf itself may not exist yet, so only its parent is
        # canonicalized. A failed realpath is already a failed filesystem
        # operation for the source or its required destination parent.
        def copy_tree_destination_canonical_overlaps_source(machine: mutable Machine&, source: sview, destination: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            canonical_source: RuntimeValue = evaluate_path_real(machine, runtime_text(source))
            return false if machine.failure != InterpretFailure.None
            # Decompose a normalized destination.  Without this, a valid
            # relative destination such as `build-out` produces an empty
            # parent and is sent to `realpath("")`, while `build-out/`
            # produces an empty filename.  Both spellings are ordinary
            # filesystem paths and must reach the same canonical overlap
            # check before the destination mkdir.
            normalized_destination: dstr = Fs::normalize(&perm_arena, destination)
            normalized_destination_text: sview = bytes_view(normalized_destination)
            if not path_shape_result_valid(normalized_destination_text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return false
            parent_spelling: sview = Fs::parent(normalized_destination_text)
            destination_parent: sview = "." if parent_spelling == "" else parent_spelling
            canonical_parent: RuntimeValue = evaluate_path_real(machine, runtime_text(destination_parent))
            return false if machine.failure != InterpretFailure.None
            destination_leaf: sview = Fs::filename(normalized_destination_text)
            if not path_shape_text_valid(destination_leaf) or not path_join_length_fits(canonical_parent.text, destination_leaf):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return false
            canonical_destination: dstr = Fs::join(&perm_arena, canonical_parent.text, destination_leaf)
            canonical_destination_text: sview = bytes_view(canonical_destination)
            if not path_shape_result_valid(canonical_destination_text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return false
            return copy_tree_destination_overlaps_source(machine, canonical_source.text, canonical_destination_text)


        def copy_tree_entry(machine: mutable Machine&, source: sview, destination: sview, depth: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            if depth > 128:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return false
            if not path_text_valid(source) or not path_text_valid(destination):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return false
            c_source: dstr = nul_terminated_path(source)
            c_destination: dstr = nul_terminated_path(destination)
            if c_source.items == null or c_destination.items == null:
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return false
            info: mutable ElisascriptStat = zeroed
            source_items: u8& = c_source.items
            destination_items: u8& = c_destination.items
            can Blocking.IO:
                if elisascript_posix_lstat(source_items.cast[cstr], info) != 0:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return false
            mode: u16 = info.mode & EsRuntime::DarwinStatMode::MASK
            if mode == EsRuntime::DarwinStatMode::SYMLINK:
                target: RuntimeValue = evaluate_read_link(machine, runtime_text(source))
                return false if machine.failure != InterpretFailure.None
                created: RuntimeValue = evaluate_symlink_path(machine, target, runtime_text(destination))
                return false if machine.failure != InterpretFailure.None
                return created.boolean
            if mode == EsRuntime::DarwinStatMode::DIRECTORY:
                can Blocking.IO:
                    if elisascript_posix_mkdir(destination_items.cast[cstr], 493) != 0:
                        interpret_set_failure(machine, InterpretFailure.FileIo)
                        return false
                scanner: mutable DirectoryScanner = DirectoryScanner{names: [], kinds: [], directory: null, opened: false, failed: false}
                read_owned_directory(machine, source, scanner)
                if not scanner.opened or scanner.failed:
                    interpret_set_failure(machine, InterpretFailure.FileIo)
                    return false
                for name in scanner.names |machine, source, destination, depth|:
                    child_source: sview = path_join_value(source, bytes_view(name))
                    child_destination: sview = path_join_value(destination, bytes_view(name))
                    return false if not copy_tree_entry(machine, child_source, child_destination, depth + 1)
                return true
            copied: RuntimeValue = evaluate_copy_path(machine, runtime_text(source), runtime_text(destination))
            return false if machine.failure != InterpretFailure.None
            return copied.boolean


        def evaluate_copy_tree(machine: mutable Machine&, source: RuntimeValue, destination: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if source.kind != RuntimeValueKind.Text or destination.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(source.text) or not path_text_valid(destination.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            if copy_tree_destination_overlaps_source(machine, source.text, destination.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            return runtime_void() if machine.failure != InterpretFailure.None
            if copy_tree_destination_canonical_overlaps_source(machine, source.text, destination.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            return runtime_void() if machine.failure != InterpretFailure.None
            return runtime_bool(copy_tree_entry(machine, source.text, destination.text, 0))


        def evaluate_make_executable(machine: mutable Machine&, value: RuntimeValue) -> RuntimeValue:
            if value.kind != RuntimeValueKind.Text or sview_len(value.text) == 0:
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if not process_text_length_fits(machine, value.text):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if text_has_nul(value.text):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            return runtime_text(value.text)


