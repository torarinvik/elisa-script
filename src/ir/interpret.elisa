                            maxsplit_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine) if instruction.operand_count == 3 else runtime_int(-1)
                            dispatch.value <- evaluate_split(machine, storage, text_value, separator_value, instruction.integer, maxsplit_value)
                            break

