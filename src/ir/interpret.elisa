                interpret_set_failure(machine, InterpretFailure.Environment)
                return runtime_void()
            return runtime_bool(true)


        def create_directories_entry(machine: mutable Machine&, path: sview, depth: usize, mode: int) -> bool can[Memory.Allocate, Abort.Panic]:
            if depth > 128:
                interpret_set_failure(machine, InterpretFailure.Directory)
                return false
            if not path_text_valid(path):
                interpret_set_failure(machine, InterpretFailure.Directory)
                return false
            c_path: dstr = nul_terminated_path(path)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.Directory)
                return false
            info: mutable ElisascriptStat = zeroed
            path_items: u8& = c_path.items
            can Blocking.IO:
                if elisascript_posix_stat(path_items.cast[cstr], info) == 0:
                    return true if (info.mode & EsRuntime::DarwinStatMode::MASK) == EsRuntime::DarwinStatMode::DIRECTORY
                    interpret_set_failure(machine, InterpretFailure.Directory)
                    return false
            parent: sview = path_parent_value(path)
            if sview_len(parent) > 0 and parent != path:
                return false if not create_directories_entry(machine, parent, depth + 1, mode)
            can Blocking.IO:
                if elisascript_posix_mkdir(path_items.cast[cstr], mode) == 0:
                    return true
                # A concurrent creator may have installed the directory after
                # the initial stat; accept that race only when it is truly a dir.
                if elisascript_posix_stat(path_items.cast[cstr], info) == 0 and (info.mode & EsRuntime::DarwinStatMode::MASK) == EsRuntime::DarwinStatMode::DIRECTORY:
                    return true
            interpret_set_failure(machine, InterpretFailure.Directory)
            return false


        def evaluate_create_directories(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            return runtime_bool(create_directories_entry(machine, path.text, 0, 493))


        # Path.mkdir mirrors Python's typed mode, parents, and exist_ok controls.
        # The legacy one-operand CreateDirectory form supplies mode 493 and both
        # boolean controls false.
        def evaluate_path_mkdir(machine: mutable Machine&, path: RuntimeValue, mode: RuntimeValue, parents: RuntimeValue, exist_ok: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text or mode.kind != RuntimeValueKind.Int or parents.kind != RuntimeValueKind.Bool or exist_ok.kind != RuntimeValueKind.Bool:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if mode.integer < 0 or mode.integer > 4095:
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            if parents.boolean:
                info: mutable ElisascriptStat = zeroed
                c_path: dstr = nul_terminated_path(path.text)
                if c_path.items == null:
                    interpret_set_failure(machine, InterpretFailure.Directory)
                    return runtime_void()
                path_items: u8& = c_path.items
                final_exists: mutable bool = false
                can Blocking.IO:
                    final_exists <- elisascript_posix_stat(path_items.cast[cstr], info) == 0
                if final_exists and not exist_ok.boolean:
                    interpret_set_failure(machine, InterpretFailure.Directory)
                    return runtime_void()
                return runtime_bool(create_directories_entry(machine, path.text, 0, mode.integer.i32()))
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            path_items: u8& = c_path.items
            status: mutable int = -1
            info: mutable ElisascriptStat = zeroed
            can Blocking.IO:
                status <- elisascript_posix_mkdir(path_items.cast[cstr], mode.integer.i32())
                if status != 0 and exist_ok.boolean and elisascript_posix_stat(path_items.cast[cstr], info) == 0:
                    status <- 0 if (info.mode & EsRuntime::DarwinStatMode::MASK) == EsRuntime::DarwinStatMode::DIRECTORY else status
            if status != 0:
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            return runtime_bool(true)


        def evaluate_directory_mutation(machine: mutable Machine&, opcode: Opcode, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            path_items: u8& = c_path.items
            status: mutable int = -1
            can Blocking.IO:
                status <- elisascript_posix_mkdir(path_items.cast[cstr], 493) if opcode == Opcode.CreateDirectory
                status <- elisascript_posix_rmdir(path_items.cast[cstr]) if opcode == Opcode.RemoveDirectory
                status <- elisascript_posix_chdir(path_items.cast[cstr]) if opcode == Opcode.ChangeDirectory
            if status != 0:
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            return runtime_bool(true)


        def evaluate_current_directory(machine: mutable Machine&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            can Blocking.IO, Memory.Allocate, Memory.Release:
                found: mutable heap u8&? = elisascript_posix_getcwd(null, 0)
                if found == null:
                    interpret_set_failure(machine, InterpretFailure.Directory)
                    return runtime_void()
                found_items: mutable heap u8& = found
                too_large: mutable bool = false
                length: usize = host_path_cstring_length_bounded(found_items, too_large)
                if too_large or length == 0:
                    free(found_items.cast[heap void&])
                    interpret_set_failure(machine, InterpretFailure.Directory)
                    return runtime_void()
                bytes: mutable dstr = ctx_fstr_alloc(length)
                if bytes.items == null:
                    free(found_items.cast[heap void&])
                    interpret_set_failure(machine, InterpretFailure.Directory)
                    return runtime_void()
                ctx_fstr_append(bytes, found_items, length)
                free(found_items.cast[heap void&])
                return runtime_text(bytes_view(bytes))


        def append_directory_name(scanner: mutable DirectoryScanner&, entry: ElisascriptDirectoryEntry&) -> void can[Memory.Allocate, Abort.Panic]:
            length: usize = entry.name_length.usize()
            # The Darwin bridge exposes a fixed-size inline name buffer.  Treat
            # an ABI-mismatched or hostile length as a directory failure rather
            # than allowing the copy below to read beyond that field.
            if length > 1024:
                scanner.failed <- true
                return
            return if length == 1 and entry.name[0] == 46
            return if length == 2 and entry.name[0] == 46 and entry.name[1] == 46
            if scanner.names.count >= INTERPRET_MAX_DIRECTORY_ENTRIES or scanner.name_bytes > INTERPRET_MAX_DIRECTORY_NAME_BYTES:
                scanner.failed <- true
                return
            if length > INTERPRET_MAX_DIRECTORY_NAME_BYTES - scanner.name_bytes:
                scanner.failed <- true
                return
            name: mutable dstr = ctx_fstr_alloc(length)
            if name.items == null:
                scanner.failed <- true
                return
            ctx_fstr_append(name, &entry.name[0], length)
            scanner.names.push(name)
            scanner.kinds.push(entry.kind)
            scanner.name_bytes <- scanner.name_bytes + length


        def directory_next(scanner: mutable DirectoryScanner&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if scanner.directory == null
            directory: mutable heap void& = scanner.directory
            can Blocking.IO:
                error_pointer: mutable int& = elisascript_posix_errno()
                error_pointer[0] <- 0
                entry: mutable ElisascriptDirectoryEntry&? = elisascript_posix_readdir(directory)
                if entry == null:
                    if error_pointer[0] == EsRuntime::DarwinErrno::EINTR and scanner.eintr_retries < PosixRetry::EINTR_RETRIES:
                        scanner.eintr_retries <- scanner.eintr_retries + 1
                        return true
                    scanner.failed <- error_pointer[0] != 0
                    return false
                scanner.eintr_retries <- 0
                live_entry: mutable ElisascriptDirectoryEntry& = entry
                append_directory_name(scanner, live_entry)
                return false if scanner.failed
                return true


        def directory_name_less(left: dstr, right: dstr) -> bool:
            left_view: sview = bytes_view(left)
            right_view: sview = bytes_view(right)
            shared: usize = sview_len(left_view) if sview_len(left_view) < sview_len(right_view) else sview_len(right_view)
            for index in 0..<shared |left_view, right_view|:
                true return if sview_at(left_view, index) < sview_at(right_view, index)
                false return if sview_at(left_view, index) > sview_at(right_view, index)
            return sview_len(left_view) < sview_len(right_view)


        def sort_directory_names(names: mutable darray[dstr]&) -> void:
            for index in 1..<names.count |names|:
                cursor: mutable usize = index
                while cursor > 0 and directory_name_less(names[cursor], names[cursor - 1]):
                    previous: dstr = names[cursor - 1]
                    names[cursor - 1] <- names[cursor]
                    names[cursor] <- previous
                    cursor <- cursor - 1


        def sort_directory_entries(names: mutable darray[dstr]&, kinds: mutable darray[u8]&) -> void:
            for index in 1..<names.count |names, kinds|:
                cursor: mutable usize = index
                while cursor > 0 and directory_name_less(names[cursor], names[cursor - 1]):
                    previous_name: dstr = names[cursor - 1]
                    previous_kind: u8 = kinds[cursor - 1]
                    names[cursor - 1] <- names[cursor]
                    kinds[cursor - 1] <- kinds[cursor]
                    names[cursor] <- previous_name
                    kinds[cursor] <- previous_kind
                    cursor <- cursor - 1


        def read_owned_directory(machine: mutable Machine&, path: sview, scanner: mutable DirectoryScanner&) -> void can[Memory.Allocate, Abort.Panic]:
            c_path: dstr = nul_terminated_path(path)
            if c_path.items == null:
                scanner.failed <- true
                return
            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                handle: mutable heap void&? = interpret_open_directory(machine, path_items.cast[cstr])
                return if handle == null
                directory: mutable heap void& = handle
                scanner.directory <- directory
                scanner.opened <- true
                machine over directory_next(scanner):
                    state Scan
                    start Scan

                    Scan, true:
                        -> Scan
                    Scan, _:
                        break
                close_status: int = interpret_close_directory(machine, directory)
                scanner.directory <- null
                scanner.failed <- true if scanner.failed or close_status != 0 else false
                sort_directory_entries(scanner.names, scanner.kinds) if not scanner.failed


        def evaluate_list_directory(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            scanner: mutable DirectoryScanner = DirectoryScanner{names: [], kinds: [], directory: null, opened: false, failed: false}
            read_owned_directory(machine, path.text, scanner)
            if not scanner.opened or scanner.failed:
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            if not runtime_storage_span_u32_valid(storage, scanner.names.count):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            start: u32 = storage.count.u32()
            storage.reserve(storage.count + scanner.names.count)
            for name in scanner.names |storage|:
                storage.push(runtime_text(bytes_view(name)))
            return runtime_array(start, scanner.names.count.u32())


        # Path.iterdir keeps the deterministic directory scan used by
        # list_directory, but materializes each child as a rooted path payload.
        # Unlike globbing, this deliberately includes dot entries and performs
        # no pattern filtering; the scanner has already removed only `.`/`..`.
        def evaluate_path_iterdir(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            scanner: mutable DirectoryScanner = DirectoryScanner{names: [], kinds: [], directory: null, opened: false, failed: false}
            read_owned_directory(machine, path.text, scanner)
            if not scanner.opened or scanner.failed:
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            if not runtime_storage_span_u32_valid(storage, scanner.names.count):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            storage_start: usize = storage.count
            start: u32 = storage.count.u32()
            storage.reserve(storage.count + scanner.names.count)
            for name in scanner.names |storage, path|:
                if not path_join_length_fits(path.text, bytes_view(name)):
                    storage.truncate(storage_start)
                    interpret_set_failure(machine, InterpretFailure.Directory)
                    return runtime_void()
                child: dstr = Fs::join(&perm_arena, path.text, bytes_view(name))
                if not path_shape_result_valid(bytes_view(child)):
                    storage.truncate(storage_start)
                    interpret_set_failure(machine, InterpretFailure.Directory)
                    return runtime_void()
                storage.push(runtime_text(bytes_view(child)))
            return runtime_array(start, scanner.names.count.u32())


        def evaluate_is_directory(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text):
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            c_path: dstr = nul_terminated_path(path.text)
            if c_path.items == null:
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                handle: mutable heap void&? = interpret_open_directory(machine, path_items.cast[cstr])
                return runtime_bool(false) if handle == null
                directory: mutable heap void& = handle
                if interpret_close_directory(machine, directory) != 0:
                    interpret_set_failure(machine, InterpretFailure.Directory)
                    return runtime_void()
                return runtime_bool(true)


        def glob_class_width(pattern: sview, index: usize, end: usize) -> usize:
            cursor: mutable usize = index + 1
            escaped: mutable bool = false
            while cursor < end:
                byte: u8 = sview_at(pattern, cursor)
                if escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 93:
                    return cursor - index + 1
                cursor <- cursor + 1
            return 1


        def glob_class_matches(pattern: sview, index: usize, width: usize, value: u8) -> bool:
            class_end: usize = index + width - 1
            cursor: mutable usize = index + 1
            negated: bool = cursor < class_end and (sview_at(pattern, cursor) == 33 or sview_at(pattern, cursor) == 94)
            cursor <- cursor + 1 if negated
            found: mutable bool = false
            while cursor < class_end and not found:
                first: mutable u8 = sview_at(pattern, cursor)
                first_width: mutable usize = 1
                if first == 92 and cursor < class_end and class_end - cursor > 1:
                    first <- sview_at(pattern, cursor + 1)
                    first_width <- 2
                found <- first == value
                range_marker: usize = cursor + first_width
                if not found and range_marker < class_end and class_end - range_marker > 1 and sview_at(pattern, range_marker) == 45:
                    last: u8 = sview_at(pattern, range_marker + 1)
                    found <- value >= first and value <= last
                    cursor <- range_marker + 2
                else:
                    cursor <- cursor + first_width
            return not found if negated else found


        def glob_component_match_at(pattern: sview, pattern_index: usize, pattern_end: usize, name: sview, name_index: usize) -> bool:
            return name_index == sview_len(name) if pattern_index >= pattern_end
            token: u8 = sview_at(pattern, pattern_index)
            if token == 42:
                next: mutable usize = pattern_index + 1
                while next < pattern_end and sview_at(pattern, next) == 42:
                    next <- next + 1
                return true if next >= pattern_end
                for candidate in name_index..=sview_len(name) |pattern, pattern_end, name, next|:
                    true return if glob_component_match_at(pattern, next, pattern_end, name, candidate)
                return false
            return false if name_index >= sview_len(name)
            if token == 63:
                return glob_component_match_at(pattern, pattern_index + 1, pattern_end, name, name_index + 1)
            if token == 92 and pattern_end - pattern_index > 1:
                return false if sview_at(pattern, pattern_index + 1) != sview_at(name, name_index)
                return glob_component_match_at(pattern, pattern_index + 2, pattern_end, name, name_index + 1)
            if token == 91:
                width: usize = glob_class_width(pattern, pattern_index, pattern_end)
                if width > 1:
                    return false if not glob_class_matches(pattern, pattern_index, width, sview_at(name, name_index))
                    return glob_component_match_at(pattern, pattern_index + width, pattern_end, name, name_index + 1)
            return false if token != sview_at(name, name_index)
            return glob_component_match_at(pattern, pattern_index + 1, pattern_end, name, name_index + 1)


        def glob_component_matches(pattern: sview, start: usize, end: usize, name: sview) -> bool:
            explicit_dot: bool = start < end and (sview_at(pattern, start) == 46 or (sview_at(pattern, start) == 92 and start + 1 < end and sview_at(pattern, start + 1) == 46))
            return false if sview_len(name) > 0 and sview_at(name, 0) == 46 and not explicit_dot
            return glob_component_match_at(pattern, start, end, name, 0)


        def glob_join_path(base: dstr, name: dstr) -> dstr can[Memory.Allocate, Abort.Panic]:
            base_view: sview = bytes_view(base)
            name_view: sview = bytes_view(name)
            separator: bool = sview_len(base_view) > 0 and sview_at(base_view, sview_len(base_view) - 1) != 47
            total: mutable usize = sview_len(base_view) + sview_len(name_view)
            return [] if total < sview_len(base_view)
            return [] if total >= INTERPRET_MAX_PATH_BYTES
            if separator:
                expanded: usize = total + 1
                return [] if expanded < total
                return [] if expanded >= INTERPRET_MAX_PATH_BYTES
                total <- expanded
            joined: mutable dstr = ctx_fstr_alloc(total)
            return joined if joined.items == null
            ctx_fstr_append(joined, base_view.data, sview_len(base_view))
            ctx_fstr_append(joined, "/", 1) if separator
            ctx_fstr_append(joined, name_view.data, sview_len(name_view))
            return joined


        def append_glob_match(walker: mutable GlobWalker&, path: dstr) -> void can[Memory.Allocate, Abort.Panic]:
            return if walker.failed
            if walker.matches.count >= INTERPRET_MAX_GLOB_MATCHES:
                walker.failed <- true
                return
            if path.items == null:
                walker.failed <- true
                return
            view: sview = bytes_view(path)
            length: usize = sview_len(view)
            if walker.match_bytes > INTERPRET_MAX_GLOB_MATCH_BYTES:
                walker.failed <- true
                return
            if length > INTERPRET_MAX_GLOB_MATCH_BYTES - walker.match_bytes:
                walker.failed <- true
                return
            owned: mutable dstr = ctx_fstr_alloc(length)
            if owned.items == null:
                walker.failed <- true
                return
            ctx_fstr_append(owned, view.data, sview_len(view))
            walker.matches.push(owned)
            walker.match_bytes <- walker.match_bytes + length


        def append_glob_range(out: mutable dstr&, source: sview, start: usize, end: usize) -> void:
            ctx_fstr_append(out, source.data + start, end - start)


        def copy_glob_pattern(prefix: sview, alternative: sview, suffix: sview, suffix_start: usize) -> dstr can[Memory.Allocate, Abort.Panic]:
            left: usize = sview_len(prefix)
            suffix_length: usize = sview_len(suffix)
            return [] if suffix_start > suffix_length
            remaining_length: usize = suffix_length - suffix_start
            total: mutable usize = left + sview_len(alternative)
            return [] if total < left
            expanded: usize = total + remaining_length
            return [] if expanded < total
            total <- expanded
            result: mutable dstr = ctx_fstr_alloc(total)
            return result if result.items == null
            append_glob_range(result, prefix, 0, left)
            ctx_fstr_append(result, alternative.data, sview_len(alternative))
            append_glob_range(result, suffix, suffix_start, sview_len(suffix))
            return result


        def next_glob_alternative(pattern: sview, start: usize, close: usize) -> usize:
            cursor: mutable usize = start
            nested: mutable usize = 0
            in_class: mutable bool = false
            while cursor < close:
                byte: u8 = sview_at(pattern, cursor)
                if byte == 92:
                    cursor <- cursor + 2
                    continue
                if byte == 91:
                    in_class <- true
                elif byte == 93:
                    in_class <- false
                elif not in_class and byte == 123:
                    nested <- nested + 1
                elif not in_class and byte == 125 and nested > 0:
                    nested <- nested - 1
                elif not in_class and byte == 44 and nested == 0:
                    return cursor
                cursor <- cursor + 1
            return close


        def collect_glob_variants(variants: mutable darray[dstr]&, pattern: sview, failed: mutable bool&, variant_bytes: mutable usize&) -> void can[Memory.Allocate, Abort.Panic]:
            return if failed[0]
            open: mutable usize = 0
            close: mutable usize = sview_len(pattern)
            comma: mutable usize = sview_len(pattern)
            depth: mutable usize = 0
            cursor: mutable usize = 0
            in_class: mutable bool = false
            while cursor < sview_len(pattern):
                byte: u8 = sview_at(pattern, cursor)
                if byte == 92:
                    cursor <- cursor + 2
                    continue
                if byte == 91:
                    in_class <- true
                elif byte == 93:
                    in_class <- false
                elif not in_class and byte == 123:
                    if depth == 0:
                        open <- cursor
                    depth <- depth + 1
                elif not in_class and byte == 125 and depth > 0:
                    depth <- depth - 1
                    close <- cursor if depth == 0
                    break if depth == 0
                elif not in_class and byte == 44 and depth == 1:
                    comma <- cursor if comma == sview_len(pattern)
                cursor <- cursor + 1
            if open == 0 and (sview_len(pattern) == 0 or sview_at(pattern, 0) != 123):
                if variants.count >= INTERPRET_MAX_GLOB_VARIANTS or variant_bytes > INTERPRET_MAX_GLOB_VARIANT_BYTES:
                    failed <- true
                    return
                if sview_len(pattern) > INTERPRET_MAX_GLOB_VARIANT_BYTES - variant_bytes:
                    failed <- true
                    return
                variant_length: usize = sview_len(pattern)
                variant: mutable dstr = ctx_fstr_alloc(variant_length)
                if variant.items == null:
                    failed <- true
                    return
                ctx_fstr_append(&variant, pattern.data, sview_len(pattern))
                variants.push(variant)
                variant_bytes <- variant_bytes + variant_length
                return
            if close == sview_len(pattern) or comma == sview_len(pattern):
                if variants.count >= INTERPRET_MAX_GLOB_VARIANTS or variant_bytes > INTERPRET_MAX_GLOB_VARIANT_BYTES:
                    failed <- true
                    return
                if sview_len(pattern) > INTERPRET_MAX_GLOB_VARIANT_BYTES - variant_bytes:
                    failed <- true
                    return
                variant_length: usize = sview_len(pattern)
                variant: mutable dstr = ctx_fstr_alloc(variant_length)
                if variant.items == null:
                    failed <- true
                    return
                ctx_fstr_append(&variant, pattern.data, sview_len(pattern))
                variants.push(variant)
                variant_bytes <- variant_bytes + variant_length
                return
            prefix: sview = string_view_slice(pattern, 0, open.i64())
            suffix: sview = pattern
            left: usize = open + 1
            alternative_start: mutable usize = left
            alternative_end: mutable usize = next_glob_alternative(pattern, alternative_start, close)
            while alternative_start <= close:
                alternative: sview = string_view_slice(pattern, alternative_start.i64(), alternative_end.i64())
                variant: dstr = copy_glob_pattern(prefix, alternative, suffix, close + 1)
                if variant.items == null:
                    failed <- true
                    return
                collect_glob_variants(variants, bytes_view(variant), failed, variant_bytes)
                break if alternative_end == close
                alternative_start <- alternative_end + 1
                alternative_end <- next_glob_alternative(pattern, alternative_start, close)


        def glob_walk(machine: mutable Machine&, walker: mutable GlobWalker&, base: dstr, pattern: sview, pattern_index: usize, depth: usize) -> void can[Memory.Allocate, Abort.Panic]:
            return if walker.failed
            if depth > 128:
                walker.failed <- true
                return
            index: mutable usize = pattern_index
            while index < sview_len(pattern) and sview_at(pattern, index) == 47:
                index <- index + 1
            if index >= sview_len(pattern):
                append_glob_match(walker, base) if base.count > 0
                return
            component_end: mutable usize = index
            while component_end < sview_len(pattern) and sview_at(pattern, component_end) != 47:
                component_end <- component_end + 1
            next_index: mutable usize = component_end
            while next_index < sview_len(pattern) and sview_at(pattern, next_index) == 47:
                next_index <- next_index + 1
            recursive: bool = component_end - index == 2 and sview_at(pattern, index) == 42 and sview_at(pattern, index + 1) == 42
            directory_path: sview = bytes_view(base) if base.count > 0 else "."
            scanner: mutable DirectoryScanner = DirectoryScanner{names: [], kinds: [], directory: null, opened: false, failed: false}
            if recursive:
                glob_walk(machine, walker, base, pattern, next_index, depth + 1)
                read_owned_directory(machine, directory_path, scanner)
                if scanner.failed:
                    walker.failed <- true
                    return
                return if not scanner.opened
                for entry_index in 0..<scanner.names.count |walker, base, pattern, index, depth, scanner|:
                    name: dstr = scanner.names[entry_index]
                    name_view: sview = bytes_view(name)
                    continue if sview_len(name_view) > 0 and sview_at(name_view, 0) == 46
                    child: dstr = glob_join_path(base, name)
                    if child.items == null:
                        walker.failed <- true
                        return
                    kind: u8 = scanner.kinds[entry_index]
                    append_glob_match(walker, child) if next_index >= sview_len(pattern)
                    glob_walk(machine, walker, child, pattern, index, depth + 1) if kind == 4 or kind == 0
                return
            read_owned_directory(machine, directory_path, scanner)
            if scanner.failed:
                walker.failed <- true
                return
            return if not scanner.opened
            for entry_index in 0..<scanner.names.count |walker, base, pattern, index, component_end, next_index, depth, scanner|:
                name: dstr = scanner.names[entry_index]
                continue if not glob_component_matches(pattern, index, component_end, bytes_view(name))
                child: dstr = glob_join_path(base, name)
                if child.items == null:
                    walker.failed <- true
                    return
                if next_index >= sview_len(pattern):
                    append_glob_match(walker, child)
                else:
                    glob_walk(machine, walker, child, pattern, next_index, depth + 1)


        def evaluate_expand_glob(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, pattern: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if pattern.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(pattern.text):
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            variants: mutable darray[dstr] = []
            variants_failed: mutable bool = false
            variant_bytes: mutable usize = 0
            collect_glob_variants(variants, pattern.text, variants_failed, variant_bytes)
            if variants_failed:
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            walker: mutable GlobWalker = GlobWalker{matches: [], failed: false}
            for variant in variants |walker|:
                base: mutable dstr = []
                pattern_index: mutable usize = 0
                variant_view: sview = bytes_view(variant)
                if sview_at(variant_view, 0) == 47:
                    base <- ctx_fstr_alloc(1)
                    if base.items == null:
                        walker.failed <- true
                        break
                    ctx_fstr_append(base, "/", 1)
                    pattern_index <- 1
                glob_walk(machine, walker, base, variant_view, pattern_index, 0)
            if walker.failed:
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            sort_directory_names(walker.matches)
            unique_matches: mutable usize = 0
            previous: mutable sview = ""
            have_previous: mutable bool = false
            for matched in walker.matches |previous, have_previous, unique_matches|:
                view: sview = bytes_view(matched)
                if not have_previous or view != previous:
                    unique_matches <- unique_matches + 1
                    previous <- view
                    have_previous <- true
            if not runtime_storage_span_u32_valid(storage, unique_matches):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            start: u32 = storage.count.u32()
            previous <- ""
            have_previous <- false
            for matched in walker.matches |storage, previous, have_previous|:
                view: sview = bytes_view(matched)
                if not have_previous or view != previous:
                    storage.push(runtime_text(view))
                    previous <- view
                    have_previous <- true
            return runtime_array(start, unique_matches.u32())


        def evaluate_path_glob(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, path: RuntimeValue, pattern: RuntimeValue, recursive: bool) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text or pattern.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not path_text_valid(path.text) or not path_text_valid(pattern.text):
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            pattern_text: mutable sview = pattern.text
            if recursive:
                pattern_length: usize = sview_len(pattern.text)
                prefixed_length: usize = pattern_length + 3
                if prefixed_length < pattern_length:
                    interpret_set_failure(machine, InterpretFailure.Directory)
                    return runtime_void()
                prefixed: mutable dstr = ctx_fstr_alloc(prefixed_length)
                if prefixed.items == null:
                    interpret_set_failure(machine, InterpretFailure.Directory)
                    return runtime_void()
                ctx_fstr_append(prefixed, "**/", 3)
                ctx_fstr_append(prefixed, pattern.text.data, sview_len(pattern.text))
                pattern_text <- bytes_view(prefixed)
            if not path_text_valid(pattern_text):
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            if not path_join_length_fits(path.text, pattern_text):
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            joined: dstr = Fs::join(&perm_arena, path.text, pattern_text)
            if not path_shape_result_valid(bytes_view(joined)):
                interpret_set_failure(machine, InterpretFailure.Directory)
                return runtime_void()
            return evaluate_expand_glob(machine, storage, runtime_text(bytes_view(joined)))


        def stdio_read_next(reader: mutable StdioReader&) -> StdioReadState can[Memory.Allocate, Abort.Panic]:
            chunk: mutable u8[4096] = zeroed
            current: u64 = reader.consumed
            if current > reader.limit:
                reader.failed <- true
                return StdioReadState.Error
            remaining: u64 = reader.limit - current
            capacity: mutable usize = 4096
            if remaining < capacity.u64():
                capacity <- remaining.usize()
            if capacity == 0:
                reader.failed <- true
                return StdioReadState.Error
            can Blocking.IO:
                amount: isize = elisascript_posix_read(0, (&chunk[0]).cast[mutable void&], capacity)
                if amount < 0:
                    errno: mutable int& = elisascript_posix_errno()
                    if errno[0] == EsRuntime::DarwinErrno::EINTR and reader.eintr_retries < PosixRetry::EINTR_RETRIES:
                        reader.eintr_retries <- reader.eintr_retries + 1
                        return StdioReadState.Data
                    reader.failed <- true
                    return StdioReadState.Error
                if amount == 0:
                    return StdioReadState.End
                reader.eintr_retries <- 0
                if amount.usize() > capacity:
                    reader.failed <- true
                    return StdioReadState.Error
                count: usize = amount.usize()
                if not stdio_read_append_fits(reader, count):
                    reader.failed <- true
                    return StdioReadState.Error
                reader.consumed <- reader.consumed + count.u64()
                for index in 0..<count |reader, chunk|:
                    reader.bytes.push(chunk[index])
                return StdioReadState.Data


        def stdio_read_line_next(reader: mutable StdioReader&) -> StdioLineReadState can[Memory.Allocate, Abort.Panic]:
            chunk: mutable u8[1] = zeroed
            if not stdio_read_append_fits(reader, 1):
                reader.failed <- true
                return StdioLineReadState.Error
            can Blocking.IO:
                amount: isize = elisascript_posix_read(0, (&chunk[0]).cast[mutable void&], 1)
                if amount < 0:
                    errno: mutable int& = elisascript_posix_errno()
                    if errno[0] == EsRuntime::DarwinErrno::EINTR and reader.eintr_retries < PosixRetry::EINTR_RETRIES:
                        reader.eintr_retries <- reader.eintr_retries + 1
                        return StdioLineReadState.Progress
                    reader.failed <- true
                    return StdioLineReadState.Error
                if amount == 0:
                    return StdioLineReadState.End
                reader.eintr_retries <- 0
                if amount > 1:
                    reader.failed <- true
                    return StdioLineReadState.Error
                reader.consumed <- reader.consumed + 1
                return StdioLineReadState.Done if chunk[0] == 10
                reader.bytes.push(chunk[0])
                return StdioLineReadState.Progress


        def stdio_write_next(writer: mutable StdioWriter&) -> StdioWriteState can[Console.Write]:
            return StdioWriteState.Done if writer.offset >= writer.length
            remaining: usize = writer.length - writer.offset
            buffer: mutable u8& = writer.data + writer.offset
            can Blocking.IO:
                amount: isize = runtime_write(writer.fd, buffer.cast[void&], remaining)
                if amount <= 0 or amount.usize() > remaining:
                    writer.failed <- true
                    return StdioWriteState.Error
                writer.offset <- writer.offset + amount.usize()
                return StdioWriteState.Done if writer.offset >= writer.length
                return StdioWriteState.Progress


        def evaluate_read_stdin(machine: mutable Machine&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            reader: mutable StdioReader = StdioReader{bytes: [], failed: false, limit: machine.stdin_input_limit}
            can Blocking.IO, Memory.Allocate, Abort.Panic:
                machine over stdio_read_next(reader):
                    state Read
                    start Read

                    Read, StdioReadState.Data:
                        -> Read
                    Read, StdioReadState.End:
                        break
                    Read, StdioReadState.Error:
                        break
            if reader.failed:
                interpret_set_failure(machine, InterpretFailure.Console)
                return runtime_void()
            return runtime_text("") if reader.bytes.count == 0
            bytes: mutable dstr = ctx_fstr_alloc(reader.bytes.count)
            if bytes.items == null:
                interpret_set_failure(machine, InterpretFailure.Console)
                return runtime_void()
            ctx_fstr_append(bytes, reader.bytes.items, reader.bytes.count)
            return runtime_text(bytes_view(bytes))


        # Read one logical line without over-reading stdin. Unlike read_stdin,
        # which intentionally drains the descriptor, this primitive is suitable
        # for Python-style input() and repeated prompts in one program.
        def evaluate_read_stdin_line(machine: mutable Machine&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if machine.stdin_eof:
                interpret_set_failure(machine, InterpretFailure.Console)
                return runtime_void()
            reader: mutable StdioReader = StdioReader{bytes: [], failed: false, limit: machine.stdin_input_limit}
            can Blocking.IO, Memory.Allocate, Abort.Panic:
                machine over stdio_read_line_next(reader):
                    state Read
                    start Read

                    Read, StdioLineReadState.Progress:
                        -> Read
                    Read, StdioLineReadState.Done:
                        break
                    Read, StdioLineReadState.End:
                        reader.ended <- true
                        break
                    Read, StdioLineReadState.Error:
                        break
            if reader.failed:
                interpret_set_failure(machine, InterpretFailure.Console)
                return runtime_void()
            if reader.ended and reader.bytes.count == 0:
                machine.stdin_eof <- true
                interpret_set_failure(machine, InterpretFailure.Console)
                return runtime_void()
            bytes: mutable dstr = ctx_fstr_alloc(reader.bytes.count)
            if bytes.items == null:
                interpret_set_failure(machine, InterpretFailure.Console)
                return runtime_void()
            ctx_fstr_append(bytes, reader.bytes.items, reader.bytes.count)
            line: sview = bytes_view(bytes)
            # Accept both Unix and Windows line endings, matching Python's
            # input() behavior of returning the line without its terminator.
            return runtime_text(string_view_prefix(line, line.len - 1)) if line.len > 0 and sview_at(line, (line.len - 1).usize()) == 13
            return runtime_text(line)


        def evaluate_write_stream(machine: mutable Machine&, text: RuntimeValue, fd: FileDescriptor) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if text.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            writer: mutable StdioWriter = StdioWriter{fd: fd, data: text.text.data, length: sview_len(text.text), offset: 0, failed: false}
            # Reject an entire write that cannot fit before any bytes reach the
            # host stream. The post-write accounting below still records actual
            # successful progress, but must never be the first limit check.
            if machine.resource_usage.output_bytes > machine.resource_policy.output_bytes or writer.length > machine.resource_policy.output_bytes - machine.resource_usage.output_bytes:
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            can Blocking.IO:
                machine over stdio_write_next(writer):
                    state Write
                    start Write

                    Write, StdioWriteState.Progress:
                        -> Write
                    Write, StdioWriteState.Done:
                        break
                    Write, StdioWriteState.Error:
                        break
            if writer.failed:
                # A host stream can fail after accepting a prefix. Account for
                # those bytes before returning so a recoverable Console handler
                # cannot make already-emitted output disappear from the budget.
                if not runtime_resource_add_output(machine.resource_usage, machine.resource_policy, writer.offset):
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                interpret_set_failure(machine, InterpretFailure.Console)
                return runtime_void()
            if not runtime_resource_add_output(machine.resource_usage, machine.resource_policy, writer.offset):
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            return runtime_int(writer.offset.i64())


        def evaluate_concat(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, left: RuntimeValue, right: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if left.kind == RuntimeValueKind.Map and right.kind == RuntimeValueKind.Map:
                if not runtime_map_range_valid(storage, left) or not runtime_map_range_valid(storage, right):
                    interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                    return runtime_void()
                additional: mutable usize = 0
                for offset in 0..<right.map_count.usize() |machine, storage, left, right, additional|:
                    key: RuntimeValue = storage[right.map_start.usize() + offset * 2]
                    present: mutable bool = false
                    for existing in 0..<left.map_count.usize() |machine, storage, left, key, present|:
                        present <- true if runtime_values_equal(storage, storage[left.map_start.usize() + existing * 2], key)
                    for prior in 0..<offset |machine, storage, right, key, present|:
                        present <- true if runtime_values_equal(storage, storage[right.map_start.usize() + prior * 2], key)
                    additional <- additional + 1 if not present
                if not runtime_storage_two_pair_spans_u32_valid(storage, left.map_count.usize(), additional):
                    interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                    return runtime_void()
                start: u32 = storage.count.u32()
                for offset in 0..<left.map_count.usize() |storage, left|:
                    storage.push(storage[left.map_start.usize() + offset * 2])
                    storage.push(storage[left.map_start.usize() + offset * 2 + 1])
                merged_count: mutable u32 = left.map_count
                for offset in 0..<right.map_count.usize() |machine, storage, left, right, start, merged_count|:
                    key: RuntimeValue = storage[right.map_start.usize() + offset * 2]
                    value: RuntimeValue = storage[right.map_start.usize() + offset * 2 + 1]
                    found: mutable bool = false
                    for existing in 0..<merged_count.usize() |machine, storage, start, key, value, found|:
                        existing_key: RuntimeValue = storage[start.usize() + existing * 2]
                        if runtime_values_equal(storage, existing_key, key):
                            storage[start.usize() + existing * 2 + 1] <- value
                            found <- true
                            break
                    if not found:
                        if merged_count == 4294967295u32:
                            interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                            return runtime_void()
                        storage.push(key)
                        storage.push(value)
                        merged_count <- merged_count + 1
                return runtime_map(start, merged_count)
            if left.kind == RuntimeValueKind.Array and right.kind == RuntimeValueKind.Array:
                if not runtime_array_range_valid(storage, left) or not runtime_array_range_valid(storage, right):
                    interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                    return runtime_void()
                if left.array_count > 4294967295u32 - right.array_count:
                    interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                    return runtime_void()
                if not runtime_storage_two_spans_u32_valid(storage, left.array_count.usize(), right.array_count.usize()):
                    interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                    return runtime_void()
                start: u32 = storage.count.u32()
                for offset in 0..<left.array_count.usize() |storage, left|:
                    storage.push(storage[left.array_start.usize() + offset])
                for offset in 0..<right.array_count.usize() |storage, right|:
                    storage.push(storage[right.array_start.usize() + offset])
                return runtime_array(start, left.array_count + right.array_count)
            if left.kind == RuntimeValueKind.Text and right.kind == RuntimeValueKind.Text:
                left_length: usize = sview_len(left.text)
                right_length: usize = sview_len(right.text)
                total: usize = left_length + right_length
                if total < left_length:
                    interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                    return runtime_void()
                if total > INTERPRET_MAX_TEXT_OUTPUT_BYTES:
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                return runtime_text("") if total == 0
                bytes: mutable dstr = ctx_fstr_alloc(total)
                if bytes.items == null:
                    interpret_set_failure(machine, InterpretFailure.OutputLimit)
                    return runtime_void()
                ctx_fstr_append(bytes, left.text.data, left_length)
                ctx_fstr_append(bytes, right.text.data, right_length)
                return runtime_text(bytes_view(bytes))
            interpret_set_failure(machine, InterpretFailure.TypeMismatch)
            return runtime_void()


        def evaluate_set_index(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, collection: RuntimeValue, index: RuntimeValue, replacement: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if collection.kind == RuntimeValueKind.Map:
                if not runtime_map_range_valid(storage, collection):
                    interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                    return runtime_void()
                found: mutable bool = false
                for offset in 0..<collection.map_count.usize() |machine, storage, collection, index, found|:
                    key: RuntimeValue = storage[collection.map_start.usize() + offset * 2]
                    found <- true if runtime_values_equal(storage, key, index)
                if not found:
                    if collection.map_count == 4294967295u32:
                        interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                        return runtime_void()
                    if not runtime_storage_pairs_u32_valid(storage, collection.map_count.usize() + 1):
                        interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                        return runtime_void()
                if found and not runtime_storage_pairs_u32_valid(storage, collection.map_count.usize()):
                    interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                    return runtime_void()
                start: u32 = storage.count.u32()
                for offset in 0..<collection.map_count.usize() |machine, storage, collection, index, replacement, start, found|:
                    key: RuntimeValue = storage[collection.map_start.usize() + offset * 2]
                    old_value: RuntimeValue = storage[collection.map_start.usize() + offset * 2 + 1]
                    storage.push(key)
                    storage.push(replacement) if runtime_values_equal(storage, key, index)
                    storage.push(old_value) if not runtime_values_equal(storage, key, index)
                if not found:
                    storage.push(index)
                    storage.push(replacement)
                return runtime_map(start, collection.map_count + 1) if not found
                return runtime_map(start, collection.map_count)
            if collection.kind != RuntimeValueKind.Array or index.kind != RuntimeValueKind.Int:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_array_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            normalized: mutable i64 = index.integer
            normalized <- normalized + collection.array_count.i64() if normalized < 0
            if normalized < 0 or normalized >= collection.array_count.i64():
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            old_value: RuntimeValue = storage[collection.array_start.usize() + normalized.usize()]
            if old_value.kind != replacement.kind:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_storage_span_u32_valid(storage, collection.array_count.usize()):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            start: u32 = storage.count.u32()
            storage.reserve(storage.count + collection.array_count.usize())
            for offset in 0..<collection.array_count.usize() |storage, collection|:
                storage.push(storage[collection.array_start.usize() + offset])
            storage[start.usize() + normalized.usize()] <- replacement
            return runtime_array(start, collection.array_count)


        def evaluate_delete_index(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, collection: RuntimeValue, index: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if collection.kind != RuntimeValueKind.Map:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if not runtime_map_range_valid(storage, collection):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            found: mutable bool = false
            for offset in 0..<collection.map_count.usize() |machine, storage, collection, index, found|:
                key: RuntimeValue = storage[collection.map_start.usize() + offset * 2]
                if runtime_values_equal(storage, key, index):
                    found <- true
            return collection if not found
            if not runtime_storage_pairs_u32_valid(storage, collection.map_count.usize() - 1):
                interpret_set_failure(machine, InterpretFailure.IntegerOverflow)
                return runtime_void()
            start: u32 = storage.count.u32()
            remaining: mutable u32 = 0
            for offset in 0..<collection.map_count.usize() |machine, storage, collection, index, start, remaining|:
                key: RuntimeValue = storage[collection.map_start.usize() + offset * 2]
                value: RuntimeValue = storage[collection.map_start.usize() + offset * 2 + 1]
                if not runtime_values_equal(storage, key, index):
                    storage.push(key)
                    storage.push(value)
                    remaining <- remaining + 1
            return runtime_map(start, remaining)


        # Select a block terminator through explicit control states. Branch value
        # lookup happens before the machine so its missing-value failure remains
        # owned by the interpreter machine, not by the control selector.
        def select_terminator(machine: mutable Machine&, fn: Function&, terminator: Terminator, ids: darray[u32]&, values: darray[RuntimeValue]&) -> TerminatorDispatch:
            condition: mutable RuntimeValue = runtime_void()
            if terminator.kind == TerminatorKind.Branch:
                condition <- frame_value(ids, values, terminator.operand, machine)
            initial_state: mutable TerminatorDispatchState = TerminatorDispatchState.Select
            initial_state <- TerminatorDispatchState.Invalid if machine.failure != InterpretFailure.None
            cursor: mutable TerminatorDispatch = TerminatorDispatch{state: initial_state, action: TerminatorDispatchAction.Invalid, target: 0, edge_start: 0, edge_count: 0, failure: InterpretFailure.None}
            machine over cursor.state:
                state Select
                start Select

                Select, TerminatorDispatchState.Select if terminator.kind == TerminatorKind.Return:
                    cursor.action <- TerminatorDispatchAction.Return
                    cursor.state <- TerminatorDispatchState.Done
                    -> Select
                Select, TerminatorDispatchState.Select if terminator.kind == TerminatorKind.Jump:
                    cursor.action <- TerminatorDispatchAction.Jump
                    cursor.target <- terminator.target0
                    cursor.edge_start <- terminator.edge0_arg_start
                    cursor.edge_count <- terminator.edge0_arg_count
                    cursor.state <- TerminatorDispatchState.Done
                    -> Select
                Select, TerminatorDispatchState.Select if terminator.kind == TerminatorKind.Branch and condition.kind == RuntimeValueKind.Bool and condition.boolean:
                    cursor.action <- TerminatorDispatchAction.Jump
                    cursor.target <- terminator.target0
                    cursor.edge_start <- terminator.edge0_arg_start
                    cursor.edge_count <- terminator.edge0_arg_count
                    cursor.state <- TerminatorDispatchState.Done
                    -> Select
                Select, TerminatorDispatchState.Select if terminator.kind == TerminatorKind.Branch and condition.kind == RuntimeValueKind.Bool:
                    cursor.action <- TerminatorDispatchAction.Jump
                    cursor.target <- terminator.target1
                    cursor.edge_start <- terminator.edge1_arg_start
                    cursor.edge_count <- terminator.edge1_arg_count
                    cursor.state <- TerminatorDispatchState.Done
                    -> Select
                Select, TerminatorDispatchState.Select if terminator.kind == TerminatorKind.Branch:
                    cursor.failure <- InterpretFailure.TypeMismatch
                    cursor.state <- TerminatorDispatchState.Invalid
                    -> Select
                Select, TerminatorDispatchState.Select:
                    cursor.failure <- InterpretFailure.InvalidControlFlow
                    cursor.state <- TerminatorDispatchState.Invalid
                    -> Select

                Select, TerminatorDispatchState.Done | TerminatorDispatchState.Invalid:
                    break

            cursor.failure <- machine.failure if machine.failure != InterpretFailure.None
            interpret_set_failure(machine, cursor.failure) if cursor.failure != InterpretFailure.None
            return cursor


        def error_guard_matches(machine: Machine&, guard: ErrorGuard&) -> bool:
            return true if guard.effect_family == "" and guard.effect_operation == ""
            return machine.failure == InterpretFailure.Raised and machine.failure_family == guard.effect_family and machine.failure_operation == guard.effect_operation and (guard.operation_id == 0 or machine.failure_operation_id == 0 or machine.failure_operation_id == guard.operation_id)


        def matching_error_guard_index(machine: Machine&, guards: darray[ErrorGuard]&) -> usize:
            cursor: mutable ErrorGuardSearchCursor = ErrorGuardSearchCursor{state: ErrorGuardSearchState.Search, index: guards.count, match_index: guards.count}
            while true:
                match cursor.state:

                    ErrorGuardSearchState.Search if cursor.index == 0:
                        cursor.state <- ErrorGuardSearchState.Done
                        continue
                    ErrorGuardSearchState.Search:
                        cursor.index <- cursor.index - 1
                        guard: ErrorGuard = guards[cursor.index]
                        if error_guard_matches(machine, guard):
                            cursor.match_index <- cursor.index
                            cursor.state <- ErrorGuardSearchState.Done
                        continue

                    ErrorGuardSearchState.Done:
                        break

            return cursor.match_index


        def recover_error_guard(machine: mutable Machine&, guards: mutable darray[ErrorGuard]&, handler_stack: mutable darray[sview]&, recovery_target: mutable u32&) -> bool:
            # Use one unwind transition for in-frame failures and inherited
            # failures arriving at a resumed caller frame.
            cursor: mutable ErrorGuardRecoveryCursor = ErrorGuardRecoveryCursor{state: ErrorGuardRecoveryState.Search, match_index: guards.count, recovery_target: 0, recovered: false}
            while true:
                match cursor.state:

                    ErrorGuardRecoveryState.Search if machine.failure == InterpretFailure.None or not error_guard_recoverable(machine.failure) or guards.count == 0:
                        cursor.state <- ErrorGuardRecoveryState.Done
                        continue
                    ErrorGuardRecoveryState.Search:
                        cursor.match_index <- matching_error_guard_index(machine, guards)
                        cursor.state <- ErrorGuardRecoveryState.Restore if cursor.match_index < guards.count else ErrorGuardRecoveryState.Done
                        continue

                    ErrorGuardRecoveryState.Restore:
                        guard: ErrorGuard = guards[cursor.match_index]
                        if guard.handler_depth > handler_stack.count:
                            interpret_set_failure(machine, InterpretFailure.InvalidControlFlow)
                            cursor.state <- ErrorGuardRecoveryState.Done
                            continue
                        guards.truncate(cursor.match_index)
                        handler_stack.truncate(guard.handler_depth)
                        preserve_payloads: bool = guard.effect_family != "" and guard.effect_operation != ""
                        interpret_set_failure(machine, InterpretFailure.None)
                        machine.failure_family <- ""
                        machine.failure_operation <- ""
                        machine.failure_operation_id <- 0
                        machine.failure_payloads.truncate(0) if not preserve_payloads
                        cursor.recovery_target <- guard.target
                        cursor.recovered <- true
                        cursor.state <- ErrorGuardRecoveryState.Done
                        continue

                    ErrorGuardRecoveryState.Done:
                        break

            recovery_target <- cursor.recovery_target if cursor.recovered
            return cursor.recovered


        def execute_function(machine: mutable Machine&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handler_stack: mutable darray[sview]&, module: Module&, function_index: usize, arguments: darray[RuntimeValue]&, resume_block: u32 = 0, resume_instruction: usize = 0, initial_ids: darray[u32] = [], initial_values: darray[RuntimeValue] = [], initial_error_guards: darray[ErrorGuard] = [], resume_frame: bool = false) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if machine.active_calls.count >= ES_RUNTIME_DEFAULT_MAX_EXECUTION_CALL_DEPTH or handler_stack.count >= ES_RUNTIME_DEFAULT_MAX_EXECUTION_CALL_DEPTH:
                interpret_set_failure(machine, InterpretFailure.OutputLimit)
                return runtime_void()
            if function_index >= module.functions.count:
                interpret_set_failure(machine, InterpretFailure.UnknownFunction)
                return runtime_void()
            fn: Function = module.functions[function_index]
            resuming: mutable bool = resume_frame
            if not resuming and arguments.count != fn.parameters.count:
                interpret_set_failure(machine, InterpretFailure.ArgumentMismatch)
                return runtime_void()
            if not resuming and not runtime_values_ranges_valid(storage, arguments):
                interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                return runtime_void()
            if not resuming:
                argument_validation: RuntimeValueTypeCheckResult = runtime_arguments_match_parameters(arguments, fn.parameters, storage)
                interpret_set_failure(machine, InterpretFailure.TypeMismatch) if argument_validation == RuntimeValueTypeCheckResult.TypeMismatch
                interpret_set_failure(machine, InterpretFailure.OutputLimit) if argument_validation == RuntimeValueTypeCheckResult.WorkLimit
                return runtime_void() if argument_validation != RuntimeValueTypeCheckResult.Matches

            ids: mutable darray[u32] = []
            values: mutable darray[RuntimeValue] = []
            error_guards: mutable darray[ErrorGuard] = []
            if resuming:
                if initial_ids.count != initial_values.count:
                    interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                    return runtime_void()
                if initial_error_guards.count > ES_RUNTIME_DEFAULT_MAX_ERROR_GUARD_DEPTH:
                    interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                    return runtime_void()
                if not runtime_values_ranges_valid(storage, initial_values):
                    interpret_set_failure(machine, InterpretFailure.IndexOutOfBounds)
                    return runtime_void()
                for guard in initial_error_guards:
                    if guard.handler_depth > handler_stack.count:
                        interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                        return runtime_void()
                ids.extend(initial_ids)
                values.extend(initial_values)
                error_guards.extend(initial_error_guards)
            else:
                for index in 0..<arguments.count |fn, arguments, ids, values|:
                    ids.push(fn.parameters[index].value)
                    values.push(arguments[index])
            current_block: mutable u32 = fn.entry if not resuming else resume_block
            guard_limit_failure: mutable bool = false
            recovered_jump: mutable bool = false
            recovery_target: mutable u32 = 0
            if machine.failure != InterpretFailure.None:
                recovered_jump <- recover_error_guard(machine, error_guards, handler_stack, recovery_target)
                if recovered_jump:
                    current_block <- recovery_target
                    resuming <- false

            while machine.failure == InterpretFailure.None:
                runtime_void() return if not tick(machine)
                block_index: usize = find_block(fn, current_block)
                if block_index == fn.blocks.count:
                    interpret_set_failure(machine, InterpretFailure.InvalidControlFlow)
                    return runtime_void()
                block: mutable Block = fn.blocks[block_index]
                instruction_start: mutable usize = block.instruction_start.usize()
                instruction_end: usize = block.instruction_start.usize() + block.instruction_count.usize()
                if resuming:
                    if resume_instruction < instruction_start or resume_instruction > instruction_end:
                        interpret_set_failure(machine, InterpretFailure.InvalidContinuation)
                        return runtime_void()
                    instruction_start <- resume_instruction
                    resuming <- false
                recovered_jump <- false
                for instruction_index in instruction_start..<instruction_end |machine, observations, storage, handler_stack, module, fn, ids, values, guard_limit_failure, recovered_jump, recovery_target|:
                    runtime_void() return if not tick(machine)
                    guard_limit_failure <- false
                    instruction: Instruction = fn.instruction_pool[instruction_index]
                    dispatch: mutable InstructionDispatch = InstructionDispatch{value: runtime_void(), opcode: instruction.opcode, produces_value: instruction.result != 0}
                    while true:
                        match dispatch.opcode:

                            Opcode.Constant:
                                dispatch.value <- evaluate_constant(instruction, machine)
                                break

                            Opcode.LoadGlobal:
                                dispatch.value <- evaluate_global_load(instruction, machine)
                                break

                            Opcode.StoreGlobal:
                                evaluate_global_store(instruction, fn, ids, values, module, machine)
                                dispatch.produces_value <- false
                                break

                            Opcode.Copy:
                                dispatch.value <- frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                break

                            Opcode.FormatNominal:
                                operand: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_format_nominal(operand, machine)
                                break

                            Opcode.FormatChar:
                                operand: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_format_char(operand, machine)
                                break

                            Opcode.FormatAggregate:
                                operand: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_format_aggregate(storage, operand, machine)
                                break

                            Opcode.Negate:
                                operand: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_negate(operand, instruction.result_type, machine)
                                break

                            Opcode.Not:
                                operand: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_not(operand, machine)
                                break

                            Opcode.BitNot:
                                operand: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_bit_not(operand, instruction.result_type, machine)
                                break

                            Opcode.MakeArray:
                                dispatch.value <- evaluate_array(machine, storage, fn, instruction, ids, values)
                                break

                            Opcode.MakeMap:
                                dispatch.value <- evaluate_map(machine, storage, fn, instruction, ids, values)
                                break

                            Opcode.MapKeys:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_map_keys(machine, storage, collection)
                                break

                            Opcode.MapValues:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_map_values(machine, storage, collection)
                                break

                            Opcode.Index:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                index: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_index(machine, storage, collection, index)
                                break

                            Opcode.IndexValid:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                index: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_index_valid(machine, storage, collection, index)
                                break

                            Opcode.UnpackArray:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                index: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_unpack_array(machine, storage, collection, index, instruction.integer)
                                break

                            Opcode.ErrorGuardPush:
                                dispatch.produces_value <- false
                                break

                            Opcode.ErrorGuardPop:
                                dispatch.produces_value <- false
                                break

                            Opcode.Length:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_length(machine, collection)
                                break

                            Opcode.Slice:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                low: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                high: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                                dispatch.value <- evaluate_slice(machine, storage, collection, low, high)
                                break

                            Opcode.PopArrayValue:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                index: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine) if instruction.operand_count == 2 else runtime_void()
                                dispatch.value <- evaluate_pop_array_value(machine, storage, collection, index, instruction.operand_count == 2)
                                break

                            Opcode.PopArray:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                index: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine) if instruction.operand_count == 2 else runtime_void()
                                dispatch.value <- evaluate_pop_array(machine, storage, collection, index, instruction.operand_count == 2)
                                break

                            Opcode.PopMapValue:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                key: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                default_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine) if instruction.operand_count == 3 else runtime_void()
                                dispatch.value <- evaluate_pop_map_value(machine, storage, collection, key, default_value, instruction.operand_count == 3)
                                break

                            Opcode.PopMap:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                key: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_pop_map(machine, storage, collection, key)
                                break

                            Opcode.SetDefaultMapValue:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                key: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                default_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                                dispatch.value <- evaluate_setdefault_map_value(machine, storage, collection, key, default_value)
                                break

                            Opcode.SetDefaultMap:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                key: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                default_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                                dispatch.value <- evaluate_setdefault_map(machine, storage, collection, key, default_value)
                                break

                            Opcode.ReverseArray:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_reverse_array(machine, storage, collection)
                                break

                            Opcode.InsertArray:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                index: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                                dispatch.value <- evaluate_insert_array(machine, storage, collection, index, value)
                                break

                            Opcode.CopyArray:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_copy_array(machine, storage, collection)
                                break

                            Opcode.CopyMap:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_copy_map(machine, storage, collection)
                                break

                            Opcode.ArrayCount:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                needle: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_array_count(machine, storage, collection, needle)
                                break

                            Opcode.Contains:
                                needle: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_contains(machine, storage, needle, collection)
                                break

                            Opcode.StartsWith:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                prefix_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_text_boundary(machine, text_value, prefix_value, true)
                                break

                            Opcode.EndsWith:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                suffix_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_text_boundary(machine, text_value, suffix_value, false)
                                break

                            Opcode.TextRemoveBoundary:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                boundary_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_text_remove_boundary(machine, text_value, boundary_value, instruction.integer == 0)
                                break

                            Opcode.TextCount:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                needle_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_text_count(machine, text_value, needle_value)
                                break

                            Opcode.TextFind:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                needle_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_text_find(machine, text_value, needle_value)
                                break

                            Opcode.ArrayFind:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                needle: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_array_find(machine, storage, collection, needle)
                                break

                            Opcode.ArrayIndex:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                needle: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_array_index(machine, storage, collection, needle)
                                break

                            Opcode.RemoveArray:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                needle: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_remove_array(machine, storage, collection, needle)
                                break

                            Opcode.SortArray:
                                collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_sort_array(machine, storage, collection)
                                break

                            Opcode.TextRFind:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                needle_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_text_rfind(machine, text_value, needle_value)
                                break

                            Opcode.TextIndex:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                needle_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_text_index(machine, text_value, needle_value, false)
                                break

                            Opcode.TextRIndex:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                needle_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_text_index(machine, text_value, needle_value, true)
                                break

                            Opcode.TextPartition:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                separator_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_text_partition(machine, storage, text_value, separator_value, instruction.integer == 1)
                                break

                            Opcode.TextPredicate:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_text_predicate(machine, text_value, instruction.integer)
                                break

                            Opcode.TextReplace:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                old_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                replacement_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                                dispatch.value <- evaluate_text_replace(machine, text_value, old_value, replacement_value)
                                break

                            Opcode.TrimText:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_text_trim(machine, text_value, instruction.integer)
                                break

                            Opcode.LowerText:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_text_case(machine, text_value, false)
                                break

                            Opcode.UpperText:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_text_case(machine, text_value, true)
                                break

                            Opcode.RegexSearch:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                pattern_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_regex_search(machine, text_value, pattern_value, instruction.integer)
                                break

                            Opcode.RegexReplace:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                pattern_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                replacement_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                                dispatch.value <- evaluate_regex_replace(machine, text_value, pattern_value, replacement_value)
                                break

                            Opcode.RegexSplit:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                pattern_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_regex_split(machine, storage, text_value, pattern_value)
                                break

                            Opcode.RegexFind:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                pattern_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_regex_find(machine, storage, text_value, pattern_value)
                                break

                            Opcode.RegexCapture:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                pattern_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                dispatch.value <- evaluate_regex_capture(machine, storage, text_value, pattern_value, instruction.integer)
                                break

                            Opcode.RegexCaptureNamed:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                pattern_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                name_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                                dispatch.value <- evaluate_regex_capture_named(machine, storage, text_value, pattern_value, name_value)
                                break

                            Opcode.Split if instruction.operand_count >= 2:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                separator_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                                maxsplit_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine) if instruction.operand_count == 3 else runtime_int(-1)
                                dispatch.value <- evaluate_split(machine, storage, text_value, separator_value, instruction.integer, maxsplit_value)
                                break

                            Opcode.Split:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_split(machine, storage, text_value, runtime_void(), instruction.integer, runtime_int(-1))
                                break

                            Opcode.SplitLines:
                                text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                dispatch.value <- evaluate_split_lines(machine, storage, text_value)
                                break

                            Opcode.Join:
                                fields_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                                separator_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
