        def regex_search_text(text: sview, pattern: sview) -> bool:
            return regex_search(text, pattern)


        def regex_match_text(text: sview, pattern: sview) -> bool:
            return regex_match_expression_end(pattern, 0, sview_len(pattern), text, 0) >= 0


        def regex_fullmatch_text(text: sview, pattern: sview) -> bool:
            endpoint: i64 = regex_match_expression_end(pattern, 0, sview_len(pattern), text, 0)
            return endpoint >= 0 and endpoint.usize() == sview_len(text)


        def regex_replace_text(text: sview, pattern: sview, replacement: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return regex_replace_snapshot(text, pattern, replacement)


