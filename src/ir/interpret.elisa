        def text_has_nul(value: sview) -> bool:
            for index in 0..<sview_len(value) |value|:
                true return if sview_at(value, index) == 0
            return false


        def evaluate_get_environment(machine: mutable Machine&, name: RuntimeValue, presence_only: bool = false, max_value_bytes: i64 = EsEnvironmentReadBudget::Limits::MAX_VALUE_BYTES) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            value_limit: usize = try EsEnvironmentReadBudget::admit_limit(max_value_bytes) else err:
                interpret_set_failure(machine, InterpretFailure.Environment)
                return runtime_void()
            if value_limit >= INTERPRET_MAX_CSTRING_BYTES:
                interpret_set_failure(machine, InterpretFailure.Environment)
                return runtime_void()
            if name.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if sview_len(name.text) == 0 or not process_text_length_fits(machine, name.text):
                interpret_set_failure(machine, InterpretFailure.Environment)
                return runtime_void()
            if text_has_nul(name.text) or sview_contains_byte(name.text, 61):
                interpret_set_failure(machine, InterpretFailure.Environment)
                return runtime_void()
            c_name: dstr = nul_terminated_text(name.text)
            if c_name.items == null:
                interpret_set_failure(machine, InterpretFailure.Environment)
                return runtime_void()
            name_items: u8& = c_name.items
            found: u8&? = elisascript_posix_getenv(name_items.cast[cstr])
            return runtime_bool(found != null) if presence_only
            if found == null:
                interpret_set_failure(machine, InterpretFailure.Environment)
                return runtime_void()
            found_items: u8& = found
            too_large: mutable bool = false
            # Admit the terminator before allocating owned payload storage.
            # Never scan past the caller's limit plus one terminator probe.
            length: usize = host_environment_cstring_length_bounded(found_items, value_limit, too_large)
            interpret_set_failure(machine, InterpretFailure.Environment) if too_large
            return runtime_void() if too_large
            return runtime_text("") if length == 0
            bytes: mutable dstr = ctx_fstr_alloc(length)
            if bytes.items == null:
                interpret_set_failure(machine, InterpretFailure.Environment)
                return runtime_void()
            ctx_fstr_append(bytes, found_items, length)
            return runtime_text(bytes_view(bytes))


        def evaluate_set_environment(machine: mutable Machine&, name: RuntimeValue, value: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if name.kind != RuntimeValueKind.Text or value.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if sview_len(name.text) == 0 or not process_text_length_fits(machine, name.text) or not process_text_length_fits(machine, value.text):
                interpret_set_failure(machine, InterpretFailure.Environment)
                return runtime_void()
            if text_has_nul(name.text) or sview_contains_byte(name.text, 61) or text_has_nul(value.text):
                interpret_set_failure(machine, InterpretFailure.Environment)
                return runtime_void()
            c_name: dstr = nul_terminated_text(name.text)
            c_value: dstr = nul_terminated_text(value.text)
            if c_name.items == null or c_value.items == null:
                interpret_set_failure(machine, InterpretFailure.Environment)
                return runtime_void()
            name_items: u8& = c_name.items
            value_items: u8& = c_value.items
            if elisascript_posix_setenv(name_items.cast[cstr], value_items.cast[cstr], 1) != 0:
                interpret_set_failure(machine, InterpretFailure.Environment)
                return runtime_void()
            return runtime_bool(true)


        def evaluate_unset_environment(machine: mutable Machine&, name: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if name.kind != RuntimeValueKind.Text:
                interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                return runtime_void()
            if sview_len(name.text) == 0 or not process_text_length_fits(machine, name.text):
