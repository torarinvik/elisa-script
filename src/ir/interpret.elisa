                waiter: mutable ProcessWaiter = ProcessWaiter{pid: pid, group_ready: group_ready, status: 0, failed: false, stdout_stream: stdout_stream, stderr_stream: stderr_stream, output_limit: capture_output_limit, timeout_micros: timeout_micros}
