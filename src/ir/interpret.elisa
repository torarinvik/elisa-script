                            needle: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_array_find(machine, storage, collection, needle)
                            break

                        Dispatch, Opcode.ArrayIndex:
                            collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            needle: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_array_index(machine, storage, collection, needle)
                            break

                        Dispatch, Opcode.RemoveArray:
                            collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            needle: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_remove_array(machine, storage, collection, needle)
                            break

                        Dispatch, Opcode.SortArray:
                            collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_sort_array(machine, storage, collection)
                            break

                        Dispatch, Opcode.TextRFind:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            needle_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_text_rfind(machine, text_value, needle_value)
                            break

                        Dispatch, Opcode.TextIndex:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            needle_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_text_index(machine, text_value, needle_value, false)
                            break

                        Dispatch, Opcode.TextRIndex:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            needle_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_text_index(machine, text_value, needle_value, true)
                            break

                        Dispatch, Opcode.TextPartition:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            separator_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_text_partition(machine, storage, text_value, separator_value, instruction.integer == 1)
                            break

                        Dispatch, Opcode.TextPredicate:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_text_predicate(machine, text_value, instruction.integer)
                            break

                        Dispatch, Opcode.TextReplace:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            old_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            replacement_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                            dispatch.value <- evaluate_text_replace(machine, text_value, old_value, replacement_value)
                            break

                        Dispatch, Opcode.TrimText:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_text_trim(machine, text_value, instruction.integer)
                            break

                        Dispatch, Opcode.LowerText:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_text_case(machine, text_value, false)
                            break

                        Dispatch, Opcode.UpperText:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_text_case(machine, text_value, true)
                            break

                        Dispatch, Opcode.RegexSearch:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            pattern_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_regex_search(machine, text_value, pattern_value, instruction.integer)
                            break

                        Dispatch, Opcode.RegexReplace:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            pattern_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            replacement_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                            dispatch.value <- evaluate_regex_replace(machine, text_value, pattern_value, replacement_value)
                            break

                        Dispatch, Opcode.RegexSplit:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
