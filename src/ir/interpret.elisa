                return runtime_void()
            if not process_argument_bytes_fits(machine, storage, executable, arguments):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            if not process_input_bytes_fits(machine, input):
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            executable_bytes: dstr = nul_terminated_text(executable.text)
            if executable_bytes.items == null:
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            executable_items: u8& = executable_bytes.items
            owned_arguments: mutable darray[dstr] = []
            argv: mutable darray[cstr] = []
            owned_arguments.reserve(arguments.array_count.usize())
            argv.reserve(arguments.array_count.usize())
            argv.push(executable_items.cast[cstr])
            for offset in 0..<arguments.array_count.usize() |machine, storage, arguments, owned_arguments, argv|:
                argument: RuntimeValue = storage[arguments.array_start.usize() + offset]
                if argument.kind != RuntimeValueKind.Text:
                    interpret_set_failure(machine, InterpretFailure.TypeMismatch)
                    return runtime_void()
                if not process_text_length_fits(machine, argument.text):
