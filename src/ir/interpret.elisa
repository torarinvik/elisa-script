                            arguments_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_capture_process_stream(machine, storage, executable_value, arguments_value, 2)
                            break

                        Dispatch, Opcode.CaptureProcessStdoutWithStdin:
