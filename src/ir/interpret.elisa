        # Direct bytecode uses these ledger-aware boundaries so each write is
        # admitted against cumulative stdout and stderr before touching the host
        # stream. The mutable ledger is updated even when a partial host write
        # later fails with a recoverable Console error.
        def write_stdout_value_with_output_ledger(text: sview, output_used: mutable usize&) -> i64 error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            policy: RuntimeResourcePolicy = RuntimeResourcePolicy{}
            usage: RuntimeResourceUsage = RuntimeResourceUsage{output_bytes: output_used}
            machine: mutable Machine = Machine{steps: 0, step_limit: 1, resource_policy: policy, resource_usage: usage, failure: InterpretFailure.None, continuations: [], resume_requested: false, resume_value: runtime_void()}
            value: RuntimeValue = evaluate_write_stream(machine, runtime_text(text), FileDescriptor.Output)
            output_used <- machine.resource_usage.output_bytes
            if machine.failure != InterpretFailure.None:
                try raise_interpret_failure(machine.failure)
            return value.integer


        def write_stderr_value_with_output_ledger(text: sview, output_used: mutable usize&) -> i64 error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            policy: RuntimeResourcePolicy = RuntimeResourcePolicy{}
            usage: RuntimeResourceUsage = RuntimeResourceUsage{output_bytes: output_used}
            machine: mutable Machine = Machine{steps: 0, step_limit: 1, resource_policy: policy, resource_usage: usage, failure: InterpretFailure.None, continuations: [], resume_requested: false, resume_value: runtime_void()}
            value: RuntimeValue = evaluate_write_stream(machine, runtime_text(text), FileDescriptor.Error)
            output_used <- machine.resource_usage.output_bytes
            if machine.failure != InterpretFailure.None:
                try raise_interpret_failure(machine.failure)
            return value.integer


        def write_stdout_value(text: sview) -> i64 error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            output_used: mutable usize = 0
            return try write_stdout_value_with_output_ledger(text, output_used)


        def write_stderr_value(text: sview) -> i64 error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            output_used: mutable usize = 0
            return try write_stderr_value_with_output_ledger(text, output_used)


        def regex_search_text(text: sview, pattern: sview) -> bool error[InterpretError]:
            raise InterpretError.OutputLimit if not regex_input_within_budget(text, pattern)
            budget: mutable RegexWorkBudget = RegexWorkBudget{remaining: RegexLimits::WORK}
            value: bool = regex_search(text, pattern, budget)
            raise InterpretError.OutputLimit if budget.exhausted
            return value


        def regex_match_text(text: sview, pattern: sview) -> bool error[InterpretError]:
            raise InterpretError.OutputLimit if not regex_input_within_budget(text, pattern)
            budget: mutable RegexWorkBudget = RegexWorkBudget{remaining: RegexLimits::WORK}
            raise InterpretError.OutputLimit if not regex_work_bytes(budget, sview_len(pattern))
            endpoint: i64 = regex_match_expression_end(pattern, 0, sview_len(pattern), text, 0, budget)
            raise InterpretError.OutputLimit if budget.exhausted
            return endpoint >= 0


        def regex_fullmatch_text(text: sview, pattern: sview) -> bool error[InterpretError]:
            raise InterpretError.OutputLimit if not regex_input_within_budget(text, pattern)
            budget: mutable RegexWorkBudget = RegexWorkBudget{remaining: RegexLimits::WORK}
            raise InterpretError.OutputLimit if not regex_work_bytes(budget, sview_len(pattern))
            endpoint: i64 = regex_match_expression_end(pattern, 0, sview_len(pattern), text, 0, budget)
            raise InterpretError.OutputLimit if budget.exhausted
            return endpoint >= 0 and endpoint.usize() == sview_len(text)


        def regex_replace_text(text: sview, pattern: sview, replacement: sview) -> sview error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            raise InterpretError.OutputLimit if not regex_input_within_budget(text, pattern) or not regex_replacement_within_budget(replacement)
            budget: mutable RegexWorkBudget = RegexWorkBudget{remaining: RegexLimits::WORK}
            value: sview = regex_replace_snapshot(text, pattern, replacement, budget)
            raise InterpretError.OutputLimit if budget.exhausted
            return value


        # Quote user text for the replacement language without allowing a
        # literal `$1`, `&`, `\1`, or `\&` to become a capture reference. The
        # result is still bounded by the shared replacement output ceiling and
        # can be passed directly to `regex_replace_text` or `Regex.sub`.
        def regex_quote_replacement(value: sview) -> sview error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            raise InterpretError.OutputLimit if not regex_replacement_within_budget(value)
            output: mutable dstr = []
            for byte in value |output|:
                if byte == 92:
                    raise InterpretError.OutputLimit if output.count > RegexLimits::OUTPUT_BYTES - 2
                    output.push(92)
                    output.push(92)
                elif byte == 36:
                    raise InterpretError.OutputLimit if output.count > RegexLimits::OUTPUT_BYTES - 2
                    output.push(36)
                    output.push(36)
                elif byte == 38:
                    raise InterpretError.OutputLimit if output.count > RegexLimits::OUTPUT_BYTES - 2
                    output.push(92)
                    output.push(38)
                else:
                    raise InterpretError.OutputLimit if output.count >= RegexLimits::OUTPUT_BYTES
                    output.push(byte)
            return "" if output.count == 0
            owned: mutable dstr = ctx_fstr_alloc(output.count)
            raise InterpretError.OutputLimit if owned.items == null
            ctx_fstr_append(owned, output.items, output.count)
            return bytes_view(owned)


