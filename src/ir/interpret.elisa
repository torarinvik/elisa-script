                return runtime_void()
            current: RuntimeValue = evaluate_current_directory(machine)
            return runtime_void() if machine.failure != InterpretFailure.None
            if not path_join_length_fits(current.text, path.text):
                interpret_set_failure(machine, InterpretFailure.FileIo)
                return runtime_void()
            joined: dstr = Fs::join(&perm_arena, current.text, path.text)
            if not path_shape_result_valid(bytes_view(joined)):
                interpret_set_failure(machine, InterpretFailure.FileIo)
