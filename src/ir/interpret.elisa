                if input_handle == null:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                input_stream: mutable heap void& = input_handle
                input_descriptor: int = elisascript_posix_fileno(input_stream)
                if input_descriptor < 0:
                    _ = fclose(input_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                input_writer: mutable ProcessInputWriter = ProcessInputWriter{stream: input_stream, data: input.text.data, length: sview_len(input.text), offset: 0, failed: false}
                machine over process_input_next(input_writer):
                    state Write
                    start Write

                    Write, ProcessInputState.Progress:
                        -> Write
                    Write, ProcessInputState.Done:
                        break
                    Write, ProcessInputState.Error:
                        break
                if input_writer.failed or fseek(input_stream, 0, FILEIO_SEEK_SET) != 0:
                    _ = fclose(input_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                output_handle: mutable heap void&? = elisascript_posix_tmpfile()
                if output_handle == null:
                    _ = fclose(input_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                output_stream: mutable heap void& = output_handle
                output_descriptor: int = elisascript_posix_fileno(output_stream)
                if output_descriptor < 0:
                    _ = fclose(input_stream)
                    _ = fclose(output_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                pid: int = elisascript_posix_fork()
                if pid < 0:
                    _ = fclose(input_stream)
                    _ = fclose(output_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                if pid == 0:
                    elisascript_posix_exit(126) if elisascript_posix_dup2(input_descriptor, 0) < 0
                    elisascript_posix_exit(126) if elisascript_posix_dup2(output_descriptor, 1) < 0
                    _ = elisascript_posix_execvp(executable_items.cast[cstr], argv_items)
                    elisascript_posix_exit(127)
                    return runtime_void()
                waiter: mutable ProcessWaiter = ProcessWaiter{pid: pid, status: 0, failed: false}
                machine over process_wait_next(waiter):
                    state Wait
                    start Wait

                    Wait, ProcessWaitState.Exited:
                        break
                    Wait, ProcessWaitState.Error:
                        break
                input_close_status: int = fclose(input_stream)
                if waiter.failed or input_close_status != 0 or fseek(output_stream, 0, FILEIO_SEEK_END) != 0:
                    _ = fclose(output_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                size: i64 = ftell(output_stream)
                if size < 0 or fseek(output_stream, 0, FILEIO_SEEK_SET) != 0:
                    _ = fclose(output_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                if size == 0:
                    close_status: int = fclose(output_stream)
                    if close_status != 0:
                        machine.failure <- InterpretFailure.Process
                        return runtime_void()
                    return runtime_text("")
                bytes: mutable dstr = ctx_fstr_alloc(size.usize())
                if bytes.items == null:
                    _ = fclose(output_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                byte_items: mutable u8& = bytes.items
                read_count: usize = fread(byte_items.cast[mutable void&], 1, size.usize(), output_stream)
                close_status: int = fclose(output_stream)
                if read_count != size.usize() or close_status != 0:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                bytes.count <- size.usize()
                return runtime_text(bytes_view(bytes))


        def text_has_nul(value: sview) -> bool:
            for index in 0..<sview_len(value) |value|:
                true return if sview_at(value, index) == 0
            return false


        def evaluate_get_environment(machine: mutable Machine&, name: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if name.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(name.text) == 0 or text_has_nul(name.text):
                machine.failure <- InterpretFailure.Environment
                return runtime_void()
            c_name: dstr = nul_terminated_text(name.text)
            if c_name.items == null:
                machine.failure <- InterpretFailure.Environment
                return runtime_void()
            name_items: u8& = c_name.items
            found: u8&? = elisascript_posix_getenv(name_items.cast[cstr])
            if found == null:
                machine.failure <- InterpretFailure.Environment
                return runtime_void()
            found_items: u8& = found
            length: usize = runtime_strlen(found_items)
            return runtime_text("") if length == 0
            bytes: mutable dstr = ctx_fstr_alloc(length)
            ctx_fstr_append(bytes, found_items, length)
            return runtime_text(bytes_view(bytes))


        def evaluate_set_environment(machine: mutable Machine&, name: RuntimeValue, value: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if name.kind != RuntimeValueKind.Text or value.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(name.text) == 0 or text_has_nul(name.text) or text_has_nul(value.text):
                machine.failure <- InterpretFailure.Environment
                return runtime_void()
            c_name: dstr = nul_terminated_text(name.text)
            c_value: dstr = nul_terminated_text(value.text)
            if c_name.items == null or c_value.items == null:
                machine.failure <- InterpretFailure.Environment
                return runtime_void()
            name_items: u8& = c_name.items
            value_items: u8& = c_value.items
            if elisascript_posix_setenv(name_items.cast[cstr], value_items.cast[cstr], 1) != 0:
                machine.failure <- InterpretFailure.Environment
                return runtime_void()
            return runtime_bool(true)


        def evaluate_unset_environment(machine: mutable Machine&, name: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if name.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(name.text) == 0 or text_has_nul(name.text):
                machine.failure <- InterpretFailure.Environment
                return runtime_void()
            c_name: dstr = nul_terminated_text(name.text)
            if c_name.items == null:
                machine.failure <- InterpretFailure.Environment
                return runtime_void()
            name_items: u8& = c_name.items
            if elisascript_posix_unsetenv(name_items.cast[cstr]) != 0:
                machine.failure <- InterpretFailure.Environment
                return runtime_void()
            return runtime_bool(true)


        def evaluate_directory_mutation(machine: mutable Machine&, opcode: Opcode, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(path.text) == 0 or text_has_nul(path.text):
                machine.failure <- InterpretFailure.Directory
                return runtime_void()
            c_path: dstr = nul_terminated_text(path.text)
            if c_path.items == null:
                machine.failure <- InterpretFailure.Directory
                return runtime_void()
            path_items: u8& = c_path.items
            status: mutable int = -1
            can Blocking.IO:
                status <- elisascript_posix_mkdir(path_items.cast[cstr], 493) if opcode == Opcode.CreateDirectory
                status <- elisascript_posix_rmdir(path_items.cast[cstr]) if opcode == Opcode.RemoveDirectory
                status <- elisascript_posix_chdir(path_items.cast[cstr]) if opcode == Opcode.ChangeDirectory
            if status != 0:
                machine.failure <- InterpretFailure.Directory
                return runtime_void()
            return runtime_bool(true)


        def evaluate_current_directory(machine: mutable Machine&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            can Blocking.IO, Memory.Allocate, Memory.Release:
                found: mutable heap u8&? = elisascript_posix_getcwd(null, 0)
                if found == null:
                    machine.failure <- InterpretFailure.Directory
                    return runtime_void()
                found_items: mutable heap u8& = found
                length: usize = runtime_strlen(found_items)
                if length == 0:
                    free(found_items.cast[heap void&])
                    machine.failure <- InterpretFailure.Directory
                    return runtime_void()
                bytes: mutable dstr = ctx_fstr_alloc(length)
                ctx_fstr_append(bytes, found_items, length)
                free(found_items.cast[heap void&])
                return runtime_text(bytes_view(bytes))


        def append_directory_name(scanner: mutable DirectoryScanner&, entry: ElisascriptDirectoryEntry&) -> void can[Memory.Allocate, Abort.Panic]:
            length: usize = entry.name_length.usize()
            return if length == 1 and entry.name[0] == 46
            return if length == 2 and entry.name[0] == 46 and entry.name[1] == 46
            name: mutable dstr = ctx_fstr_alloc(length)
            ctx_fstr_append(name, &entry.name[0], length)
            scanner.names.push(name)
            scanner.kinds.push(entry.kind)


        def directory_next(scanner: mutable DirectoryScanner&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if scanner.directory == null
            directory: mutable heap void& = scanner.directory
            can Blocking.IO:
                error_pointer: mutable int& = elisascript_darwin_errno()
                error_pointer[0] <- 0
                entry: mutable ElisascriptDirectoryEntry&? = elisascript_posix_readdir(directory)
                if entry == null:
                    scanner.failed <- error_pointer[0] != 0
                    return false
                live_entry: mutable ElisascriptDirectoryEntry& = entry
                append_directory_name(scanner, live_entry)
                return true


        def directory_name_less(left: dstr, right: dstr) -> bool:
            left_view: sview = bytes_view(left)
            right_view: sview = bytes_view(right)
            shared: usize = sview_len(left_view) if sview_len(left_view) < sview_len(right_view) else sview_len(right_view)
            for index in 0..<shared |left_view, right_view|:
                true return if sview_at(left_view, index) < sview_at(right_view, index)
                false return if sview_at(left_view, index) > sview_at(right_view, index)
            return sview_len(left_view) < sview_len(right_view)


        def sort_directory_names(names: mutable darray[dstr]&) -> void:
            for index in 1..<names.count |names|:
                cursor: mutable usize = index
                while cursor > 0 and directory_name_less(names[cursor], names[cursor - 1]):
                    previous: dstr = names[cursor - 1]
                    names[cursor - 1] <- names[cursor]
                    names[cursor] <- previous
                    cursor <- cursor - 1


        def sort_directory_entries(names: mutable darray[dstr]&, kinds: mutable darray[u8]&) -> void:
            for index in 1..<names.count |names, kinds|:
                cursor: mutable usize = index
                while cursor > 0 and directory_name_less(names[cursor], names[cursor - 1]):
                    previous_name: dstr = names[cursor - 1]
                    previous_kind: u8 = kinds[cursor - 1]
                    names[cursor - 1] <- names[cursor]
                    kinds[cursor - 1] <- kinds[cursor]
                    names[cursor] <- previous_name
                    kinds[cursor] <- previous_kind
                    cursor <- cursor - 1


        def read_owned_directory(path: sview, scanner: mutable DirectoryScanner&) -> void can[Memory.Allocate, Abort.Panic]:
            c_path: dstr = nul_terminated_text(path)
            if c_path.items == null:
                scanner.failed <- true
                return
            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                handle: mutable heap void&? = elisascript_posix_opendir(path_items.cast[cstr])
                return if handle == null
                directory: mutable heap void& = handle
                scanner.directory <- directory
                scanner.opened <- true
                machine over directory_next(scanner):
                    state Scan
                    start Scan

                    Scan, true:
                        -> Scan
                    Scan, _:
                        break
                close_status: int = elisascript_posix_closedir(directory)
                scanner.failed <- true if scanner.failed or close_status != 0 else false
                sort_directory_entries(scanner.names, scanner.kinds) if not scanner.failed


        def evaluate_list_directory(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(path.text) == 0 or text_has_nul(path.text):
                machine.failure <- InterpretFailure.Directory
                return runtime_void()
            scanner: mutable DirectoryScanner = DirectoryScanner{names: [], kinds: [], directory: null, opened: false, failed: false}
            read_owned_directory(path.text, scanner)
            if not scanner.opened or scanner.failed:
                machine.failure <- InterpretFailure.Directory
                return runtime_void()
            start: u32 = storage.count.u32()
            storage.reserve(storage.count + scanner.names.count)
            for name in scanner.names |storage|:
                storage.push(runtime_text(bytes_view(name)))
            return runtime_array(start, scanner.names.count.u32())


        def evaluate_is_directory(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(path.text) == 0 or text_has_nul(path.text):
                machine.failure <- InterpretFailure.Directory
                return runtime_void()
            c_path: dstr = nul_terminated_text(path.text)
            if c_path.items == null:
                machine.failure <- InterpretFailure.Directory
                return runtime_void()
            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                handle: mutable heap void&? = elisascript_posix_opendir(path_items.cast[cstr])
                return runtime_bool(false) if handle == null
                directory: mutable heap void& = handle
                if elisascript_posix_closedir(directory) != 0:
                    machine.failure <- InterpretFailure.Directory
                    return runtime_void()
                return runtime_bool(true)


        def glob_class_width(pattern: sview, index: usize, end: usize) -> usize:
            cursor: mutable usize = index + 1
            escaped: mutable bool = false
            while cursor < end:
                byte: u8 = sview_at(pattern, cursor)
                if escaped:
                    escaped <- false
                elif byte == 92:
                    escaped <- true
                elif byte == 93:
                    return cursor - index + 1
                cursor <- cursor + 1
            return 1


        def glob_class_matches(pattern: sview, index: usize, width: usize, value: u8) -> bool:
            class_end: usize = index + width - 1
            cursor: mutable usize = index + 1
            negated: bool = cursor < class_end and (sview_at(pattern, cursor) == 33 or sview_at(pattern, cursor) == 94)
            cursor <- cursor + 1 if negated
            found: mutable bool = false
            while cursor < class_end and not found:
                first: mutable u8 = sview_at(pattern, cursor)
                first_width: mutable usize = 1
                if first == 92 and cursor + 1 < class_end:
                    first <- sview_at(pattern, cursor + 1)
                    first_width <- 2
                found <- first == value
                range_marker: usize = cursor + first_width
                if not found and range_marker + 1 < class_end and sview_at(pattern, range_marker) == 45:
                    last: u8 = sview_at(pattern, range_marker + 1)
                    found <- value >= first and value <= last
                    cursor <- range_marker + 2
                else:
                    cursor <- cursor + first_width
            return not found if negated else found


        def glob_component_match_at(pattern: sview, pattern_index: usize, pattern_end: usize, name: sview, name_index: usize) -> bool:
            return name_index == sview_len(name) if pattern_index >= pattern_end
            token: u8 = sview_at(pattern, pattern_index)
            if token == 42:
                next: mutable usize = pattern_index + 1
                while next < pattern_end and sview_at(pattern, next) == 42:
                    next <- next + 1
                return true if next >= pattern_end
                for candidate in name_index..=sview_len(name) |pattern, pattern_end, name, next|:
                    true return if glob_component_match_at(pattern, next, pattern_end, name, candidate)
                return false
            return false if name_index >= sview_len(name)
            if token == 63:
                return glob_component_match_at(pattern, pattern_index + 1, pattern_end, name, name_index + 1)
            if token == 92 and pattern_index + 1 < pattern_end:
                return false if sview_at(pattern, pattern_index + 1) != sview_at(name, name_index)
                return glob_component_match_at(pattern, pattern_index + 2, pattern_end, name, name_index + 1)
            if token == 91:
                width: usize = glob_class_width(pattern, pattern_index, pattern_end)
                if width > 1:
                    return false if not glob_class_matches(pattern, pattern_index, width, sview_at(name, name_index))
                    return glob_component_match_at(pattern, pattern_index + width, pattern_end, name, name_index + 1)
            return false if token != sview_at(name, name_index)
            return glob_component_match_at(pattern, pattern_index + 1, pattern_end, name, name_index + 1)


        def glob_component_matches(pattern: sview, start: usize, end: usize, name: sview) -> bool:
            explicit_dot: bool = start < end and (sview_at(pattern, start) == 46 or (sview_at(pattern, start) == 92 and start + 1 < end and sview_at(pattern, start + 1) == 46))
            return false if sview_len(name) > 0 and sview_at(name, 0) == 46 and not explicit_dot
            return glob_component_match_at(pattern, start, end, name, 0)


        def glob_join_path(base: dstr, name: dstr) -> dstr can[Memory.Allocate, Abort.Panic]:
            base_view: sview = bytes_view(base)
            name_view: sview = bytes_view(name)
            separator: bool = sview_len(base_view) > 0 and sview_at(base_view, sview_len(base_view) - 1) != 47
            total: usize = sview_len(base_view) + sview_len(name_view) + (1 if separator else 0)
            joined: mutable dstr = ctx_fstr_alloc(total)
            ctx_fstr_append(joined, base_view.data, sview_len(base_view))
            ctx_fstr_append(joined, "/", 1) if separator
            ctx_fstr_append(joined, name_view.data, sview_len(name_view))
            return joined


        def append_glob_match(walker: mutable GlobWalker&, path: dstr) -> void can[Memory.Allocate, Abort.Panic]:
            view: sview = bytes_view(path)
            owned: mutable dstr = ctx_fstr_alloc(sview_len(view))
            ctx_fstr_append(owned, view.data, sview_len(view))
            walker.matches.push(owned)


        def append_glob_range(out: mutable dstr&, source: sview, start: usize, end: usize) -> void:
            ctx_fstr_append(out, source.data + start, end - start)


        def copy_glob_pattern(prefix: sview, alternative: sview, suffix: sview, suffix_start: usize) -> dstr can[Memory.Allocate, Abort.Panic]:
            left: usize = sview_len(prefix)
            total: usize = left + sview_len(alternative) + sview_len(suffix) - suffix_start
            result: mutable dstr = ctx_fstr_alloc(total)
            append_glob_range(result, prefix, 0, left)
            ctx_fstr_append(result, alternative.data, sview_len(alternative))
            append_glob_range(result, suffix, suffix_start, sview_len(suffix))
            return result


        def next_glob_alternative(pattern: sview, start: usize, close: usize) -> usize:
            cursor: mutable usize = start
            nested: mutable usize = 0
            in_class: mutable bool = false
            while cursor < close:
                byte: u8 = sview_at(pattern, cursor)
                if byte == 92:
                    cursor <- cursor + 2
                    continue
                if byte == 91:
                    in_class <- true
                elif byte == 93:
                    in_class <- false
                elif not in_class and byte == 123:
                    nested <- nested + 1
                elif not in_class and byte == 125 and nested > 0:
                    nested <- nested - 1
                elif not in_class and byte == 44 and nested == 0:
                    return cursor
                cursor <- cursor + 1
            return close


        def collect_glob_variants(variants: mutable darray[dstr]&, pattern: sview) -> void can[Memory.Allocate, Abort.Panic]:
            open: mutable usize = 0
            close: mutable usize = sview_len(pattern)
            comma: mutable usize = sview_len(pattern)
            depth: mutable usize = 0
            cursor: mutable usize = 0
            in_class: mutable bool = false
            while cursor < sview_len(pattern):
                byte: u8 = sview_at(pattern, cursor)
                if byte == 92:
                    cursor <- cursor + 2
                    continue
                if byte == 91:
                    in_class <- true
                elif byte == 93:
                    in_class <- false
                elif not in_class and byte == 123:
                    if depth == 0:
                        open <- cursor
                    depth <- depth + 1
                elif not in_class and byte == 125 and depth > 0:
                    depth <- depth - 1
                    close <- cursor if depth == 0
                    break if depth == 0
                elif not in_class and byte == 44 and depth == 1:
                    comma <- cursor if comma == sview_len(pattern)
                cursor <- cursor + 1
            if open == 0 and (sview_len(pattern) == 0 or sview_at(pattern, 0) != 123):
                variant: mutable dstr = ctx_fstr_alloc(sview_len(pattern))
                ctx_fstr_append(variant, pattern.data, sview_len(pattern))
                variants.push(variant)
                return
            if close == sview_len(pattern) or comma == sview_len(pattern):
                variant: mutable dstr = ctx_fstr_alloc(sview_len(pattern))
                ctx_fstr_append(variant, pattern.data, sview_len(pattern))
                variants.push(variant)
                return
            prefix: sview = string_view_slice(pattern, 0, open.i64())
            suffix: sview = pattern
            left: usize = open + 1
            alternative_start: mutable usize = left
            alternative_end: mutable usize = next_glob_alternative(pattern, alternative_start, close)
            while alternative_start <= close:
                alternative: sview = string_view_slice(pattern, alternative_start.i64(), alternative_end.i64())
                variant: dstr = copy_glob_pattern(prefix, alternative, suffix, close + 1)
                collect_glob_variants(variants, bytes_view(variant))
                break if alternative_end == close
                alternative_start <- alternative_end + 1
                alternative_end <- next_glob_alternative(pattern, alternative_start, close)


        def glob_walk(walker: mutable GlobWalker&, base: dstr, pattern: sview, pattern_index: usize, depth: usize) -> void can[Memory.Allocate, Abort.Panic]:
            if depth > 128:
                walker.failed <- true
                return
            index: mutable usize = pattern_index
            while index < sview_len(pattern) and sview_at(pattern, index) == 47:
                index <- index + 1
            if index >= sview_len(pattern):
                append_glob_match(walker, base) if base.count > 0
                return
            component_end: mutable usize = index
            while component_end < sview_len(pattern) and sview_at(pattern, component_end) != 47:
                component_end <- component_end + 1
            next_index: mutable usize = component_end
            while next_index < sview_len(pattern) and sview_at(pattern, next_index) == 47:
                next_index <- next_index + 1
            recursive: bool = component_end - index == 2 and sview_at(pattern, index) == 42 and sview_at(pattern, index + 1) == 42
            directory_path: sview = bytes_view(base) if base.count > 0 else "."
            scanner: mutable DirectoryScanner = DirectoryScanner{names: [], kinds: [], directory: null, opened: false, failed: false}
            if recursive:
                glob_walk(walker, base, pattern, next_index, depth + 1)
                read_owned_directory(directory_path, scanner)
                if scanner.failed:
                    walker.failed <- true
                    return
                return if not scanner.opened
                for entry_index in 0..<scanner.names.count |walker, base, pattern, index, depth, scanner|:
                    name: dstr = scanner.names[entry_index]
                    name_view: sview = bytes_view(name)
                    continue if sview_len(name_view) > 0 and sview_at(name_view, 0) == 46
                    child: dstr = glob_join_path(base, name)
                    kind: u8 = scanner.kinds[entry_index]
                    append_glob_match(walker, child) if next_index >= sview_len(pattern)
                    glob_walk(walker, child, pattern, index, depth + 1) if kind == 4 or kind == 0
                return
            read_owned_directory(directory_path, scanner)
            if scanner.failed:
                walker.failed <- true
                return
            return if not scanner.opened
            for entry_index in 0..<scanner.names.count |walker, base, pattern, index, component_end, next_index, depth, scanner|:
                name: dstr = scanner.names[entry_index]
                continue if not glob_component_matches(pattern, index, component_end, bytes_view(name))
                child: dstr = glob_join_path(base, name)
                if next_index >= sview_len(pattern):
                    append_glob_match(walker, child)
                else:
                    glob_walk(walker, child, pattern, next_index, depth + 1)


        def evaluate_expand_glob(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, pattern: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if pattern.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(pattern.text) == 0 or text_has_nul(pattern.text):
                machine.failure <- InterpretFailure.Directory
                return runtime_void()
            variants: mutable darray[dstr] = []
            collect_glob_variants(variants, pattern.text)
            walker: mutable GlobWalker = GlobWalker{matches: [], failed: false}
            for variant in variants |walker|:
                base: mutable dstr = []
                pattern_index: mutable usize = 0
                variant_view: sview = bytes_view(variant)
                if sview_at(variant_view, 0) == 47:
                    base <- ctx_fstr_alloc(1)
                    ctx_fstr_append(base, "/", 1)
                    pattern_index <- 1
                glob_walk(walker, base, variant_view, pattern_index, 0)
            if walker.failed:
                machine.failure <- InterpretFailure.Directory
                return runtime_void()
            sort_directory_names(walker.matches)
            start: u32 = storage.count.u32()
            previous: mutable sview = ""
            have_previous: mutable bool = false
            for matched in walker.matches |storage, previous, have_previous|:
                view: sview = bytes_view(matched)
                if not have_previous or view != previous:
                    storage.push(runtime_text(view))
                    previous <- view
                    have_previous <- true
            return runtime_array(start, (storage.count.u32() - start))


        def stdio_read_next(reader: mutable StdioReader&) -> StdioReadState can[Memory.Allocate, Abort.Panic]:
            chunk: mutable u8[4096] = zeroed
            can Blocking.IO:
                amount: isize = elisascript_posix_read(0, (&chunk[0]).cast[mutable void&], 4096)
                if amount < 0:
                    reader.failed <- true
                    return StdioReadState.Error
                if amount == 0:
                    return StdioReadState.End
                count: usize = amount.usize()
                for index in 0..<count |reader, chunk|:
                    reader.bytes.push(chunk[index])
                return StdioReadState.Data


        def stdio_write_next(writer: mutable StdioWriter&) -> StdioWriteState can[Console.Write]:
            return StdioWriteState.Done if writer.offset >= writer.length
            remaining: usize = writer.length - writer.offset
            buffer: mutable u8& = writer.data + writer.offset
            can Blocking.IO:
                amount: isize = runtime_write(writer.fd, buffer.cast[void&], remaining)
                if amount <= 0:
                    writer.failed <- true
                    return StdioWriteState.Error
                writer.offset <- writer.offset + amount.usize()
                return StdioWriteState.Done if writer.offset >= writer.length
                return StdioWriteState.Progress


        def evaluate_read_stdin(machine: mutable Machine&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            reader: mutable StdioReader = StdioReader{bytes: [], failed: false}
            can Blocking.IO, Memory.Allocate, Abort.Panic:
                machine over stdio_read_next(reader):
                    state Read
                    start Read

                    Read, StdioReadState.Data:
                        -> Read
                    Read, StdioReadState.End:
                        break
                    Read, StdioReadState.Error:
                        break
            if reader.failed:
                machine.failure <- InterpretFailure.Console
                return runtime_void()
            return runtime_text("") if reader.bytes.count == 0
            bytes: mutable dstr = ctx_fstr_alloc(reader.bytes.count)
            ctx_fstr_append(bytes, reader.bytes.items, reader.bytes.count)
            return runtime_text(bytes_view(bytes))


        def evaluate_write_stream(machine: mutable Machine&, text: RuntimeValue, fd: FileDescriptor) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if text.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            writer: mutable StdioWriter = StdioWriter{fd: fd, data: text.text.data, length: sview_len(text.text), offset: 0, failed: false}
            can Blocking.IO:
                machine over stdio_write_next(writer):
                    state Write
                    start Write

                    Write, StdioWriteState.Progress:
                        -> Write
                    Write, StdioWriteState.Done:
                        break
                    Write, StdioWriteState.Error:
                        break
            if writer.failed:
                machine.failure <- InterpretFailure.Console
                return runtime_void()
            return runtime_int(writer.offset.i64())


        def evaluate_concat(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, left: RuntimeValue, right: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if left.kind == RuntimeValueKind.Array and right.kind == RuntimeValueKind.Array:
                if not runtime_array_range_valid(storage, left) or not runtime_array_range_valid(storage, right):
                    machine.failure <- InterpretFailure.IndexOutOfBounds
                    return runtime_void()
                start: u32 = storage.count.u32()
                storage.reserve(storage.count + left.array_count.usize() + right.array_count.usize())
                for offset in 0..<left.array_count.usize() |storage, left|:
                    storage.push(storage[left.array_start.usize() + offset])
                for offset in 0..<right.array_count.usize() |storage, right|:
                    storage.push(storage[right.array_start.usize() + offset])
                return runtime_array(start, left.array_count + right.array_count)
            if left.kind == RuntimeValueKind.Text and right.kind == RuntimeValueKind.Text:
                left_length: usize = sview_len(left.text)
                right_length: usize = sview_len(right.text)
                bytes: mutable dstr = ctx_fstr_alloc(left_length + right_length)
                ctx_fstr_append(bytes, left.text.data, left_length)
                ctx_fstr_append(bytes, right.text.data, right_length)
                return runtime_text(bytes_view(bytes))
            machine.failure <- InterpretFailure.TypeMismatch
            return runtime_void()


        def evaluate_set_index(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, collection: RuntimeValue, index: RuntimeValue, replacement: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if collection.kind != RuntimeValueKind.Array or index.kind != RuntimeValueKind.Int:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if not runtime_array_range_valid(storage, collection):
                machine.failure <- InterpretFailure.IndexOutOfBounds
                return runtime_void()
            if index.integer < 0 or index.integer >= collection.array_count.i64():
                machine.failure <- InterpretFailure.IndexOutOfBounds
                return runtime_void()
            old_value: RuntimeValue = storage[collection.array_start.usize() + index.integer.usize()]
            if old_value.kind != replacement.kind:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            start: u32 = storage.count.u32()
            storage.reserve(storage.count + collection.array_count.usize())
            for offset in 0..<collection.array_count.usize() |storage, collection|:
                storage.push(storage[collection.array_start.usize() + offset])
            storage[start.usize() + index.integer.usize()] <- replacement
            return runtime_array(start, collection.array_count)


        # Select a block terminator through explicit control states. Branch value
        # lookup happens before the machine so its missing-value failure remains
        # owned by the interpreter machine, not by the control selector.
        def select_terminator(machine: mutable Machine&, fn: Function&, terminator: Terminator, ids: darray[u32]&, values: darray[RuntimeValue]&) -> TerminatorDispatch:
            condition: mutable RuntimeValue = runtime_void()
            if terminator.kind == TerminatorKind.Branch:
                condition <- frame_value(ids, values, terminator.operand, machine)
            initial_state: mutable TerminatorDispatchState = TerminatorDispatchState.Select
            initial_state <- TerminatorDispatchState.Invalid if machine.failure != InterpretFailure.None
            cursor: mutable TerminatorDispatch = TerminatorDispatch{state: initial_state, action: TerminatorDispatchAction.Invalid, target: 0, edge_start: 0, edge_count: 0, failure: InterpretFailure.None}
            machine over cursor.state:
                state Select
                start Select

                Select, TerminatorDispatchState.Select if terminator.kind == TerminatorKind.Return:
                    cursor.action <- TerminatorDispatchAction.Return
                    cursor.state <- TerminatorDispatchState.Done
                    -> Select
                Select, TerminatorDispatchState.Select if terminator.kind == TerminatorKind.Jump:
                    cursor.action <- TerminatorDispatchAction.Jump
                    cursor.target <- terminator.target0
                    cursor.edge_start <- terminator.edge0_arg_start
                    cursor.edge_count <- terminator.edge0_arg_count
                    cursor.state <- TerminatorDispatchState.Done
                    -> Select
                Select, TerminatorDispatchState.Select if terminator.kind == TerminatorKind.Branch and condition.kind == RuntimeValueKind.Bool and condition.boolean:
                    cursor.action <- TerminatorDispatchAction.Jump
                    cursor.target <- terminator.target0
                    cursor.edge_start <- terminator.edge0_arg_start
                    cursor.edge_count <- terminator.edge0_arg_count
                    cursor.state <- TerminatorDispatchState.Done
                    -> Select
                Select, TerminatorDispatchState.Select if terminator.kind == TerminatorKind.Branch and condition.kind == RuntimeValueKind.Bool:
                    cursor.action <- TerminatorDispatchAction.Jump
                    cursor.target <- terminator.target1
                    cursor.edge_start <- terminator.edge1_arg_start
                    cursor.edge_count <- terminator.edge1_arg_count
                    cursor.state <- TerminatorDispatchState.Done
                    -> Select
                Select, TerminatorDispatchState.Select if terminator.kind == TerminatorKind.Branch:
                    cursor.failure <- InterpretFailure.TypeMismatch
                    cursor.state <- TerminatorDispatchState.Invalid
                    -> Select
                Select, TerminatorDispatchState.Select:
                    cursor.failure <- InterpretFailure.InvalidControlFlow
                    cursor.state <- TerminatorDispatchState.Invalid
                    -> Select

                Select, TerminatorDispatchState.Done | TerminatorDispatchState.Invalid:
                    break

            cursor.failure <- machine.failure if machine.failure != InterpretFailure.None
            machine.failure <- cursor.failure if cursor.failure != InterpretFailure.None
            return cursor


        def execute_function(machine: mutable Machine&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handler_stack: mutable darray[sview]&, module: Module&, function_index: usize, arguments: darray[RuntimeValue]&, resume_block: u32 = 0, resume_instruction: usize = 0, initial_ids: darray[u32] = [], initial_values: darray[RuntimeValue] = []) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if function_index >= module.functions.count:
                machine.failure <- InterpretFailure.UnknownFunction
                return runtime_void()
            fn: Function = module.functions[function_index]
            resuming: mutable bool = resume_block != 0
            if not resuming and arguments.count != fn.parameters.count:
                machine.failure <- InterpretFailure.ArgumentMismatch
                return runtime_void()

            ids: mutable darray[u32] = []
            values: mutable darray[RuntimeValue] = []
            if resuming:
                if initial_ids.count != initial_values.count:
                    machine.failure <- InterpretFailure.InvalidContinuation
                    return runtime_void()
                ids.extend(initial_ids)
                values.extend(initial_values)
            else:
                for index in 0..<arguments.count |fn, arguments, ids, values|:
                    ids.push(fn.parameters[index].value)
                    values.push(arguments[index])
            current_block: mutable u32 = fn.entry if not resuming else resume_block

            while machine.failure == InterpretFailure.None:
                runtime_void() return if not tick(machine)
                block_index: usize = find_block(fn, current_block)
                if block_index == fn.blocks.count:
                    machine.failure <- InterpretFailure.InvalidControlFlow
                    return runtime_void()
                block: Block = fn.blocks[block_index]
                instruction_start: mutable usize = block.instruction_start.usize()
                instruction_end: usize = block.instruction_start.usize() + block.instruction_count.usize()
                if resuming:
                    if resume_instruction < instruction_start or resume_instruction > instruction_end:
                        machine.failure <- InterpretFailure.InvalidContinuation
                        return runtime_void()
                    instruction_start <- resume_instruction
                    resuming <- false
                for instruction_index in instruction_start..<instruction_end |machine, observations, storage, handler_stack, module, fn, ids, values|:
                    runtime_void() return if not tick(machine)
                    instruction: Instruction = fn.instruction_pool[instruction_index]
                    dispatch: mutable InstructionDispatch = InstructionDispatch{value: runtime_void(), opcode: instruction.opcode, produces_value: instruction.result != 0}
                    machine over dispatch.opcode:
                        state Dispatch
                        start Dispatch

                        Dispatch, Opcode.Constant:
                            dispatch.value <- evaluate_constant(instruction, machine)
                            break

                        Dispatch, Opcode.Copy:
                            dispatch.value <- frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            break

                        Dispatch, Opcode.Negate:
                            operand: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_negate(operand, instruction.result_type, machine)
                            break

                        Dispatch, Opcode.Not:
                            operand: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_not(operand, machine)
                            break

                        Dispatch, Opcode.BitNot:
                            operand: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_bit_not(operand, instruction.result_type, machine)
                            break

                        Dispatch, Opcode.MakeArray:
                            dispatch.value <- evaluate_array(machine, storage, fn, instruction, ids, values)
                            break

                        Dispatch, Opcode.Index:
                            collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            index: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_index(machine, storage, collection, index)
                            break

                        Dispatch, Opcode.Length:
                            collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_length(machine, collection)
                            break

                        Dispatch, Opcode.Slice:
                            collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            low: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            high: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                            dispatch.value <- evaluate_slice(machine, storage, collection, low, high)
                            break

                        Dispatch, Opcode.Contains:
                            needle: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_contains(machine, storage, needle, collection)
                            break

                        Dispatch, Opcode.RegexSearch:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            pattern_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_regex_search(machine, text_value, pattern_value)
                            break

                        Dispatch, Opcode.RegexReplace:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            pattern_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            replacement_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                            dispatch.value <- evaluate_regex_replace(machine, text_value, pattern_value, replacement_value)
                            break

                        Dispatch, Opcode.Split:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            separator_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_split(machine, storage, text_value, separator_value)
                            break

                        Dispatch, Opcode.Join:
                            fields_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            separator_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_join(machine, storage, fields_value, separator_value)
                            break

                        Dispatch, Opcode.PathExists:
                            path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_path_exists(machine, path_value)
                            break

                        Dispatch, Opcode.ReadText:
                            path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_read_text(machine, path_value)
                            break

                        Dispatch, Opcode.WriteText:
                            path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_write_text(machine, path_value, text_value)
                            break

                        Dispatch, Opcode.RemovePath:
                            path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_remove_path(machine, path_value)
                            break

                        Dispatch, Opcode.CopyPath:
                            source_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            destination_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_copy_path(machine, source_value, destination_value)
                            break

                        Dispatch, Opcode.MovePath:
                            source_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            destination_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_move_path(machine, source_value, destination_value)
                            break

                        Dispatch, Opcode.MakeExecutable:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_make_executable(machine, text_value)
                            break

                        Dispatch, Opcode.MakePath | Opcode.MakeGlob | Opcode.MakeRegex | Opcode.MakeUrl:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_make_typed_text(machine, text_value)
                            break

                        Dispatch, Opcode.RunProcess:
                            executable_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            arguments_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_run_process(machine, storage, executable_value, arguments_value)
                            break

                        Dispatch, Opcode.CaptureProcessStdout:
                            executable_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            arguments_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_capture_process_stream(machine, storage, executable_value, arguments_value, 1)
                            break

                        Dispatch, Opcode.CaptureProcessStderr:
                            executable_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            arguments_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_capture_process_stream(machine, storage, executable_value, arguments_value, 2)
                            break

                        Dispatch, Opcode.CaptureProcessStdoutWithStdin:
                            executable_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            arguments_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            input_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                            dispatch.value <- evaluate_capture_process_stdout_with_stdin(machine, storage, executable_value, arguments_value, input_value)
                            break

                        Dispatch, Opcode.CaptureProcessResult:
                            executable_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            arguments_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            input_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                            dispatch.value <- evaluate_capture_process_result(machine, storage, executable_value, arguments_value, input_value)
                            break

                        Dispatch, Opcode.ProcessResultExitStatus | Opcode.ProcessResultStdout | Opcode.ProcessResultStderr:
                            capture_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_process_result_accessor(machine, capture_value, instruction.opcode)
                            break

                        Dispatch, Opcode.GetEnvironment:
                            name_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_get_environment(machine, name_value)
                            break

                        Dispatch, Opcode.SetEnvironment:
                            name_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            environment_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_set_environment(machine, name_value, environment_value)
                            break

                        Dispatch, Opcode.UnsetEnvironment:
                            name_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_unset_environment(machine, name_value)
                            break

                        Dispatch, Opcode.CreateDirectory | Opcode.RemoveDirectory | Opcode.ChangeDirectory:
                            path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_directory_mutation(machine, instruction.opcode, path_value)
                            break

                        Dispatch, Opcode.CurrentDirectory:
                            dispatch.value <- evaluate_current_directory(machine)
                            break

                        Dispatch, Opcode.ListDirectory:
                            path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_list_directory(machine, storage, path_value)
                            break

                        Dispatch, Opcode.IsDirectory:
                            path_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_is_directory(machine, path_value)
                            break

                        Dispatch, Opcode.ExpandGlob:
                            pattern_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_expand_glob(machine, storage, pattern_value)
                            break

                        Dispatch, Opcode.ReadStdin:
                            dispatch.value <- evaluate_read_stdin(machine)
                            break

                        Dispatch, Opcode.WriteStdout:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_write_stream(machine, text_value, FileDescriptor.Output)
                            break

                        Dispatch, Opcode.WriteStderr:
                            text_value: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_write_stream(machine, text_value, FileDescriptor.Error)
                            break

                        Dispatch, Opcode.Concat:
                            left: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            right: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_concat(machine, storage, left, right)
                            break

                        Dispatch, Opcode.SetIndex:
                            collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            index: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            replacement: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                            dispatch.value <- evaluate_set_index(machine, storage, collection, index, replacement)
                            break

                        Dispatch, Opcode.Add | Opcode.Subtract | Opcode.Multiply | Opcode.Divide | Opcode.Remainder | Opcode.Equal | Opcode.NotEqual | Opcode.Less | Opcode.LessEqual | Opcode.Greater | Opcode.GreaterEqual | Opcode.BitAnd | Opcode.BitOr | Opcode.BitXor | Opcode.ShiftLeft | Opcode.ShiftRight:
                            left: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            right: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_binary(instruction.opcode, left, right, instruction.result_type, storage, machine)
                            break

                        Dispatch, Opcode.Call:
                            dispatch.value <- evaluate_call(machine, observations, storage, handler_stack, module, fn, function_index, current_block, instruction_index, instruction, ids, values)
                            break

                        Dispatch, Opcode.Observe:
                            observed: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            note_observation(observations, instruction.trace.id, observed)
                            dispatch.produces_value <- false
                            break

                        Dispatch, Opcode.HandlerPush:
                            handler_stack.push(instruction.symbol)
                            dispatch.produces_value <- false
                            break

                        Dispatch, Opcode.HandlerPop:
                            pop_runtime_handler(machine, handler_stack, instruction.symbol)
                            dispatch.produces_value <- false
                            break

                        Dispatch, Opcode.Perform:
                            dispatch.value <- evaluate_perform(machine, observations, storage, handler_stack, module, fn, function_index, current_block, instruction_index, instruction, ids, values)
                            break

                        Dispatch, Opcode.Resume:
                            payload_id: u32 = fn.operand_pool[instruction.operand_start.usize()]
                            request_continuation_resume(machine, observations, storage, module, handler_stack, instruction, payload_id, ids, values)
                            dispatch.value <- machine.resume_value
                            break
                    return dispatch.value if machine.resume_requested
                    set_frame_value(ids, values, instruction.result, dispatch.value) if machine.failure == InterpretFailure.None and dispatch.produces_value

                runtime_void() return if machine.failure != InterpretFailure.None
                terminator: Terminator = block.terminator
                transfer: TerminatorDispatch = select_terminator(machine, fn, terminator, ids, values)
                runtime_void() return if machine.failure != InterpretFailure.None
                if transfer.action == TerminatorDispatchAction.Return:
                    return runtime_void() if terminator.operand_count == 0
                    return frame_value(ids, values, terminator.operand, machine)
                if transfer.action != TerminatorDispatchAction.Jump:
                    machine.failure <- InterpretFailure.InvalidControlFlow
                    return runtime_void()
                target: u32 = transfer.target
                edge_start: u32 = transfer.edge_start
                edge_count: u16 = transfer.edge_count
                target_index: usize = find_block(fn, target)
                if target_index == fn.blocks.count or edge_count != fn.blocks[target_index].parameter_count:
                    machine.failure <- InterpretFailure.InvalidControlFlow
                    return runtime_void()
                pending: mutable darray[RuntimeValue] = []
                for offset in 0..<edge_count.usize() |machine, fn, edge_start, ids, values, pending|:
                    pending.push(frame_value(ids, values, fn.edge_arg_pool[edge_start.usize() + offset], machine))
                for offset in 0..<edge_count.usize() |fn, target_index, pending, ids, values|:
                    parameter: Parameter = fn.block_parameter_pool[fn.blocks[target_index].parameter_start.usize() + offset]
                    set_frame_value(ids, values, parameter.value, pending[offset])
                current_block <- target
            return runtime_void()


        def raise_interpret_failure(failure: InterpretFailure) -> void error[InterpretError]:
            machine over failure:
                state Dispatch
                start Dispatch

                Dispatch, InterpretFailure.None:
                    break
                Dispatch, InterpretFailure.UnknownFunction:
                    raise InterpretError.UnknownFunction
                    break
                Dispatch, InterpretFailure.ArgumentMismatch:
                    raise InterpretError.ArgumentMismatch
                    break
                Dispatch, InterpretFailure.MissingValue:
                    raise InterpretError.MissingValue
                    break
                Dispatch, InterpretFailure.TypeMismatch:
                    raise InterpretError.TypeMismatch
                    break
                Dispatch, InterpretFailure.DivisionByZero:
                    raise InterpretError.DivisionByZero
                    break
                Dispatch, InterpretFailure.IntegerOverflow:
                    raise InterpretError.IntegerOverflow
                    break
                Dispatch, InterpretFailure.FileIo:
                    raise InterpretError.FileIo
                    break
                Dispatch, InterpretFailure.Process:
                    raise InterpretError.Process
                    break
                Dispatch, InterpretFailure.Environment:
                    raise InterpretError.Environment
                    break
                Dispatch, InterpretFailure.Directory:
                    raise InterpretError.Directory
                    break
                Dispatch, InterpretFailure.Console:
                    raise InterpretError.Console
                    break
                Dispatch, InterpretFailure.InvalidShift:
                    raise InterpretError.InvalidShift
                    break
                Dispatch, InterpretFailure.IndexOutOfBounds:
                    raise InterpretError.IndexOutOfBounds
                    break
                Dispatch, InterpretFailure.InvalidContinuation:
                    raise InterpretError.InvalidContinuation
                    break
                Dispatch, InterpretFailure.InvalidControlFlow:
                    raise InterpretError.InvalidControlFlow
                    break
                Dispatch, InterpretFailure.UnsupportedInstruction:
                    raise InterpretError.UnsupportedInstruction
                    break
                Dispatch, InterpretFailure.StepLimitExceeded:
                    raise InterpretError.StepLimitExceeded
                    break


    public:
        # Resource helpers shared by packed bytecode and the reference engine.
        # They retain the interpreter's typed error contract while keeping the
        # bytecode value machine independent of its private failure state.
        def parse_decimal_value(text: sview) -> f64:
            return parse_decimal(text)


        def path_exists_text(path: sview) -> bool error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            machine: mutable Machine = Machine{steps: 0, step_limit: 1, failure: InterpretFailure.None, continuations: [], resume_requested: false, resume_value: runtime_void()}
            value: RuntimeValue = evaluate_path_exists(machine, runtime_text(path))
            try raise_interpret_failure(machine.failure) if machine.failure != InterpretFailure.None
            return value.boolean


