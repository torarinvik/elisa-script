            machine: mutable Machine = Machine{steps: 0, step_limit: 1, failure: InterpretFailure.None, continuations: [], resume_requested: false, resume_value: runtime_void()}
            value: RuntimeValue = evaluate_regex_split(machine, storage, runtime_text(text), runtime_text(pattern))
