                if not process_resource_acquire(machine):
                    _ = interpret_close_file(machine, input_stream)
                    _ = interpret_close_file(machine, stdout_stream)
                    _ = interpret_close_file(machine, stderr_stream)
                    return runtime_void()
                pid: int = elisascript_posix_fork()
                if pid < 0:
                    _ = interpret_close_file(machine, input_stream)
                    _ = interpret_close_file(machine, stdout_stream)
                    _ = interpret_close_file(machine, stderr_stream)
                    process_resource_release(machine)
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                if pid == 0:
                    elisascript_posix_exit(126) if not process_setpgid_child()
                    if working_directory_items != null:
                        directory_items: mutable u8& = working_directory_items
                        elisascript_posix_exit(126) if elisascript_posix_chdir(directory_items.cast[cstr]) != 0
