                return runtime_int(written.i64())


        def evaluate_read_bytes(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(path.text) == 0 or text_has_nul(path.text):
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            c_path: dstr = nul_terminated_text(path.text)
            if c_path.items == null:
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                handle: mutable heap void&? = fopen(path_items, "rb")
                if handle == null:
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                stream: mutable heap void& = handle
                if fseek(stream, 0, FILEIO_SEEK_END) != 0:
                    _ = fclose(stream)
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                size: i64 = ftell(stream)
                if size < 0:
                    _ = fclose(stream)
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                if size.u64() > machine.file_input_limit:
                    _ = fclose(stream)
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                if fseek(stream, 0, FILEIO_SEEK_SET) != 0:
                    _ = fclose(stream)
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                start: u32 = storage.count.u32()
                if size == 0:
                    close_status: int = fclose(stream)
                    if close_status != 0:
                        machine.failure <- InterpretFailure.FileIo
                        return runtime_void()
                    return runtime_array(start, 0)
                bytes: mutable dstr = ctx_fstr_alloc(size.usize())
                if bytes.items == null:
                    _ = fclose(stream)
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                byte_items: mutable u8& = bytes.items
                read_count: usize = fread(byte_items.cast[mutable void&], 1, size.usize(), stream)
                close_status: int = fclose(stream)
                if read_count != size.usize() or close_status != 0:
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                for offset in 0..<size.usize() |storage, byte_items|:
                    storage.push(runtime_int(byte_items[offset].i64()))
                return runtime_array(start, size.u32())


        def evaluate_write_bytes(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, path: RuntimeValue, values: RuntimeValue, append: bool) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text or values.kind != RuntimeValueKind.Array:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(path.text) == 0 or text_has_nul(path.text):
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            if not runtime_array_range_valid(storage, values):
                machine.failure <- InterpretFailure.IndexOutOfBounds
                return runtime_void()
            c_path: dstr = nul_terminated_text(path.text)
            if c_path.items == null:
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            count: usize = values.array_count.usize()
            bytes: mutable dstr = ctx_fstr_alloc(count)
            if count > 0:
                if bytes.items == null:
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                byte_items: mutable u8& = bytes.items
                for offset in 0..<count |machine, storage, values, byte_items|:
                    value: RuntimeValue = storage[values.array_start.usize() + offset]
                    if value.kind != RuntimeValueKind.Int or value.integer < 0 or value.integer > 255:
                        machine.failure <- InterpretFailure.TypeMismatch
                        return runtime_void()
                    byte_items[offset] <- value.integer.u8()
                path_items: u8& = c_path.items
                can Blocking.IO, Memory.Allocate, Memory.Release:
                    handle: mutable heap void&? = fopen(path_items, "ab" if append else "wb")
                    if handle == null:
                        machine.failure <- InterpretFailure.FileIo
                        return runtime_void()
                    stream: mutable heap void& = handle
                    written: usize = fwrite(byte_items.cast[void&], 1, count, stream)
                    close_status: int = fclose(stream)
                    if written != count or close_status != 0:
                        machine.failure <- InterpretFailure.FileIo
                        return runtime_void()
                    return runtime_int(written.i64())
            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                handle: mutable heap void&? = fopen(path_items, "ab" if append else "wb")
                if handle == null:
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                stream: mutable heap void& = handle
                written: usize = 0
                close_status: int = fclose(stream)
                if written != count or close_status != 0:
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                return runtime_int(written.i64())


        def evaluate_remove_path(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(path.text) == 0 or text_has_nul(path.text):
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            c_path: dstr = nul_terminated_text(path.text)
            if c_path.items == null:
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            path_items: u8& = c_path.items
            can Blocking.IO:
                return runtime_bool(remove_file(path_items.cast[cstr]))


        def evaluate_copy_path(machine: mutable Machine&, source: RuntimeValue, destination: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if source.kind != RuntimeValueKind.Text or destination.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(source.text) == 0 or sview_len(destination.text) == 0 or text_has_nul(source.text) or text_has_nul(destination.text):
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            c_source: dstr = nul_terminated_text(source.text)
            c_destination: dstr = nul_terminated_text(destination.text)
            if c_source.items == null or c_destination.items == null:
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            source_items: u8& = c_source.items
            destination_items: u8& = c_destination.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                source_handle: mutable heap void&? = fopen(source_items, "rb")
                if source_handle == null:
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                source_stream: mutable heap void& = source_handle
                if fseek(source_stream, 0, FILEIO_SEEK_END) != 0:
                    _ = fclose(source_stream)
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                size: i64 = ftell(source_stream)
                if size < 0 or fseek(source_stream, 0, FILEIO_SEEK_SET) != 0:
                    _ = fclose(source_stream)
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                if size.u64() > machine.file_input_limit:
                    _ = fclose(source_stream)
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                bytes: mutable dstr = ctx_fstr_alloc(size.usize())
                read_count: mutable usize = 0
                if size > 0:
                    if bytes.items == null:
                        _ = fclose(source_stream)
                        machine.failure <- InterpretFailure.FileIo
                        return runtime_void()
                    byte_items: mutable u8& = bytes.items
                    read_count <- fread(byte_items.cast[mutable void&], 1, size.usize(), source_stream)
                source_close: int = fclose(source_stream)
                if read_count != size.usize() or source_close != 0:
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                destination_handle: mutable heap void&? = fopen(destination_items, "wb")
                if destination_handle == null:
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                destination_stream: mutable heap void& = destination_handle
                written: mutable usize = 0
                if size > 0:
                    if bytes.items == null:
                        _ = fclose(destination_stream)
                        machine.failure <- InterpretFailure.FileIo
                        return runtime_void()
                    byte_items: mutable u8& = bytes.items
                    written <- fwrite(byte_items.cast[void&], 1, size.usize(), destination_stream)
                destination_close: int = fclose(destination_stream)
                if written != size.usize() or destination_close != 0:
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                return runtime_bool(true)


        def evaluate_move_path(machine: mutable Machine&, source: RuntimeValue, destination: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if source.kind != RuntimeValueKind.Text or destination.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(source.text) == 0 or sview_len(destination.text) == 0 or text_has_nul(source.text) or text_has_nul(destination.text):
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            c_source: dstr = nul_terminated_text(source.text)
            c_destination: dstr = nul_terminated_text(destination.text)
            if c_source.items == null or c_destination.items == null:
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            source_items: u8& = c_source.items
            destination_items: u8& = c_destination.items
            can Blocking.IO:
                if elisascript_posix_rename(source_items, destination_items) != 0:
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                return runtime_bool(true)


        def remove_tree_entry(machine: mutable Machine&, path: sview, depth: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            if depth > 128:
                machine.failure <- InterpretFailure.FileIo
                return false
            if sview_len(path) == 0 or text_has_nul(path):
                machine.failure <- InterpretFailure.FileIo
                return false
            c_path: dstr = nul_terminated_text(path)
            if c_path.items == null:
                machine.failure <- InterpretFailure.FileIo
                return false
            info: mutable ElisascriptStat = zeroed
            path_items: u8& = c_path.items
            can Blocking.IO:
                if elisascript_posix_lstat(path_items.cast[cstr], info) != 0:
                    machine.failure <- InterpretFailure.FileIo
                    return false
            if (info.mode & ELISASCRIPT_STAT_MODE_MASK) != ELISASCRIPT_STAT_MODE_DIRECTORY:
                can Blocking.IO:
                    if not remove_file(path_items.cast[cstr]):
                        machine.failure <- InterpretFailure.FileIo
                        return false
                return true
            scanner: mutable DirectoryScanner = DirectoryScanner{names: [], kinds: [], directory: null, opened: false, failed: false}
            read_owned_directory(path, scanner)
            if not scanner.opened or scanner.failed:
                machine.failure <- InterpretFailure.FileIo
                return false
            for name in scanner.names |machine, path, depth|:
                child: sview = path_join_value(path, bytes_view(name))
                return false if not remove_tree_entry(machine, child, depth + 1)
            can Blocking.IO:
                if elisascript_posix_rmdir(path_items.cast[cstr]) != 0:
                    machine.failure <- InterpretFailure.FileIo
                    return false
            return true


        def evaluate_remove_tree(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            return runtime_bool(remove_tree_entry(machine, path.text, 0))


        def copy_tree_entry(machine: mutable Machine&, source: sview, destination: sview, depth: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            if depth > 128:
                machine.failure <- InterpretFailure.FileIo
                return false
            if sview_len(source) == 0 or sview_len(destination) == 0 or text_has_nul(source) or text_has_nul(destination):
                machine.failure <- InterpretFailure.FileIo
                return false
            c_source: dstr = nul_terminated_text(source)
            c_destination: dstr = nul_terminated_text(destination)
            if c_source.items == null or c_destination.items == null:
                machine.failure <- InterpretFailure.FileIo
                return false
            info: mutable ElisascriptStat = zeroed
            source_items: u8& = c_source.items
            destination_items: u8& = c_destination.items
            can Blocking.IO:
                if elisascript_posix_lstat(source_items.cast[cstr], info) != 0:
                    machine.failure <- InterpretFailure.FileIo
                    return false
            mode: u16 = info.mode & ELISASCRIPT_STAT_MODE_MASK
            if mode == ELISASCRIPT_STAT_MODE_SYMLINK:
                target: RuntimeValue = evaluate_read_link(machine, runtime_text(source))
                return false if machine.failure != InterpretFailure.None
                created: RuntimeValue = evaluate_symlink_path(machine, target, runtime_text(destination))
                return false if machine.failure != InterpretFailure.None
                return created.boolean
            if mode == ELISASCRIPT_STAT_MODE_DIRECTORY:
                can Blocking.IO:
                    if elisascript_posix_mkdir(destination_items.cast[cstr], 493) != 0:
                        machine.failure <- InterpretFailure.FileIo
                        return false
                scanner: mutable DirectoryScanner = DirectoryScanner{names: [], kinds: [], directory: null, opened: false, failed: false}
                read_owned_directory(source, scanner)
                if not scanner.opened or scanner.failed:
                    machine.failure <- InterpretFailure.FileIo
                    return false
                for name in scanner.names |machine, source, destination, depth|:
                    child_source: sview = path_join_value(source, bytes_view(name))
                    child_destination: sview = path_join_value(destination, bytes_view(name))
                    return false if not copy_tree_entry(machine, child_source, child_destination, depth + 1)
                return true
            copied: RuntimeValue = evaluate_copy_path(machine, runtime_text(source), runtime_text(destination))
            return false if machine.failure != InterpretFailure.None
            return copied.boolean


        def evaluate_copy_tree(machine: mutable Machine&, source: RuntimeValue, destination: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if source.kind != RuntimeValueKind.Text or destination.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(source.text) == 0 or sview_len(destination.text) == 0 or text_has_nul(source.text) or text_has_nul(destination.text):
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            return runtime_bool(copy_tree_entry(machine, source.text, destination.text, 0))


        def evaluate_make_executable(machine: mutable Machine&, value: RuntimeValue) -> RuntimeValue:
            if value.kind != RuntimeValueKind.Text or sview_len(value.text) == 0 or text_has_nul(value.text):
                machine.failure <- InterpretFailure.Process
                return runtime_void()
            return runtime_text(value.text)


        def evaluate_make_typed_text(machine: mutable Machine&, value: RuntimeValue) -> RuntimeValue:
            if value.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            return runtime_text(value.text)


        def evaluate_path_join(machine: mutable Machine&, base: RuntimeValue, leaf: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if base.kind != RuntimeValueKind.Text or leaf.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            joined: dstr = Fs::join(&perm_arena, base.text, leaf.text)
            return runtime_text(bytes_view(joined))


        def evaluate_path_parent(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue:
            if path.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            return runtime_text(Fs::parent(path.text))


        def evaluate_path_name(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue:
            if path.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            return runtime_text(Fs::filename(path.text))


        def evaluate_path_extension(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue:
            if path.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            return runtime_text(Fs::extension(path.text))


        def evaluate_path_stem(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue:
            if path.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            return runtime_text(Fs::stem(path.text))


        def evaluate_path_is_absolute(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue:
            if path.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            return runtime_bool(sview_len(path.text) > 0 and sview_at(path.text, 0) == 47)


        def evaluate_path_normalize(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            normalized: dstr = Fs::normalize(&perm_arena, path.text)
            return runtime_text(bytes_view(normalized))


        def evaluate_path_absolute(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            current: RuntimeValue = evaluate_current_directory(machine)
            return runtime_void() if machine.failure != InterpretFailure.None
            joined: dstr = Fs::join(&perm_arena, current.text, path.text)
            normalized: dstr = Fs::normalize(&perm_arena, bytes_view(joined))
            return runtime_text(bytes_view(normalized))


        def evaluate_path_real(machine: mutable Machine&, path: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if path.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(path.text) == 0 or text_has_nul(path.text):
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            c_path: dstr = nul_terminated_text(path.text)
            if c_path.items == null:
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            path_items: u8& = c_path.items
            can Blocking.IO, Memory.Allocate, Memory.Release:
                found: mutable heap u8&? = elisascript_posix_realpath(path_items.cast[cstr], null)
                if found == null:
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                found_items: mutable heap u8& = found
                length: usize = runtime_strlen(found_items)
                if length == 0:
                    free(found_items.cast[heap void&])
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                bytes: mutable dstr = ctx_fstr_alloc(length)
                if bytes.items == null:
                    free(found_items.cast[heap void&])
                    machine.failure <- InterpretFailure.FileIo
                    return runtime_void()
                ctx_fstr_append(bytes, found_items, length)
                free(found_items.cast[heap void&])
                return runtime_text(bytes_view(bytes))


        # Secure temporary paths are created directly through POSIX mkstemp/mkdtemp.
        # The returned Path is permanent, while the file descriptor from mkstemp is
        # closed before the operation succeeds; callers own cleanup through the
        # ordinary typed remove_path/remove_tree operations.
        def evaluate_create_temporary(machine: mutable Machine&, prefix: RuntimeValue, directory: bool) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if prefix.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if text_has_nul(prefix.text) or sview_contains_byte(prefix.text, 47) or sview_len(prefix.text) > 4096:
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            template_length: usize = 17 + sview_len(prefix.text) + 6
            template: mutable dstr = ctx_fstr_alloc(template_length + 1)
            if template.items == null:
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            ctx_fstr_append(template, "/tmp/elisascript-", 17)
            ctx_fstr_append(template, prefix.text.data, sview_len(prefix.text))
            ctx_fstr_append(template, "XXXXXX", 6)
            ctx_fstr_append(template, "\0", 1)
            template.count <- template_length
            template_items: mutable u8& = template.items
            if directory:
                can Blocking.IO, Memory.Allocate:
                    created: mutable u8&? = elisascript_posix_mkdtemp(template_items)
                    if created == null:
                        machine.failure <- InterpretFailure.FileIo
                        return runtime_void()
                return runtime_text(bytes_view(template))
            descriptor: mutable int = 0
            can Blocking.IO:
                descriptor <- elisascript_posix_mkstemp(template_items)
            if descriptor < 0:
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            close_status: mutable int = 0
            can Blocking.IO:
                close_status <- elisascript_posix_close(descriptor)
            if close_status != 0:
                can Blocking.IO:
                    _ = unlink(template_items)
                machine.failure <- InterpretFailure.FileIo
                return runtime_void()
            return runtime_text(bytes_view(template))


        def evaluate_path_relative(machine: mutable Machine&, target: RuntimeValue, base: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if target.kind != RuntimeValueKind.Text or base.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            relative: dstr = Fs::relative(&perm_arena, target.text, base.text)
            return runtime_text(bytes_view(relative))


        # Sleep is deliberately expressed as a single semantic operation. The
        # POSIX bridge only accepts microseconds, so the interpreter chunks long
        # integer waits and fractional seconds into bounded calls. Invalid
        # (negative, NaN, or infinite) seconds are typed time failures rather
        # than silently truncating into an accidental host duration.
        def evaluate_sleep(machine: mutable Machine&, duration: RuntimeValue, unit: i64) -> RuntimeValue:
            if unit != 0 and unit != 1:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if duration.kind == RuntimeValueKind.Int:
                if duration.integer < 0:
                    machine.failure <- InterpretFailure.Time
                    return runtime_void()
                remaining: mutable i64 = duration.integer
                if unit == 0:
                    while remaining > 0 |machine, remaining|:
                        can Blocking.IO:
                            if elisascript_posix_usleep(1000000u32) != 0:
                                machine.failure <- InterpretFailure.Time
                                return runtime_void()
                        remaining <- remaining - 1
                else:
                    while remaining > 0 |machine, remaining|:
                        chunk: i64 = 1000 if remaining > 1000 else remaining
                        can Blocking.IO:
                            if elisascript_posix_usleep((chunk * 1000).u32()) != 0:
                                machine.failure <- InterpretFailure.Time
                                return runtime_void()
                        remaining <- remaining - chunk
                return runtime_void()
            if duration.kind != RuntimeValueKind.Float or unit != 0:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if duration.decimal != duration.decimal or duration.decimal < 0.0 or duration.decimal > 9223372036854.0:
                machine.failure <- InterpretFailure.Time
                return runtime_void()
            remaining_seconds: mutable f64 = duration.decimal
            while remaining_seconds > 0.0 |machine, remaining_seconds|:
                chunk_seconds: f64 = 1.0 if remaining_seconds > 1.0 else remaining_seconds
                microseconds: mutable u32 = (chunk_seconds * 1000000.0).u32()
                microseconds <- 1u32 if microseconds == 0u32
                can Blocking.IO:
                    if elisascript_posix_usleep(microseconds) != 0:
                        machine.failure <- InterpretFailure.Time
                        return runtime_void()
                remaining_seconds <- remaining_seconds - chunk_seconds
            return runtime_void()


        def evaluate_run_process(machine: mutable Machine&, storage: darray[RuntimeValue]&, executable: RuntimeValue, arguments: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if executable.kind != RuntimeValueKind.Text or arguments.kind != RuntimeValueKind.Array or text_has_nul(executable.text):
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(executable.text) == 0:
                machine.failure <- InterpretFailure.Process
                return runtime_void()
            if not runtime_array_range_valid(storage, arguments):
                machine.failure <- InterpretFailure.IndexOutOfBounds
                return runtime_void()
            executable_bytes: dstr = nul_terminated_text(executable.text)
            if executable_bytes.items == null:
                machine.failure <- InterpretFailure.Process
                return runtime_void()
            executable_items: u8& = executable_bytes.items
            owned_arguments: mutable darray[dstr] = []
            argv: mutable darray[cstr] = []
            owned_arguments.reserve(arguments.array_count.usize())
            argv.reserve(arguments.array_count.usize())
            argv.push(executable_items.cast[cstr])
            for offset in 0..<arguments.array_count.usize() |machine, storage, arguments, owned_arguments, argv|:
                argument: RuntimeValue = storage[arguments.array_start.usize() + offset]
                if argument.kind != RuntimeValueKind.Text or text_has_nul(argument.text):
                    machine.failure <- InterpretFailure.TypeMismatch
                    return runtime_void()
                argument_bytes: dstr = nul_terminated_text(argument.text)
                if argument_bytes.items == null:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                owned_arguments.push(argument_bytes)
                argument_storage: mutable u8&? = owned_arguments[owned_arguments.count - 1].items
                if argument_storage == null:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                argument_items: mutable u8& = argument_storage
                argv.push(argument_items.cast[cstr])
            argv.push(executable_items.cast[cstr])
            if argv.items == null:
                machine.failure <- InterpretFailure.Process
                return runtime_void()
            terminator: mutable void& = (&argv[argv.count - 1]).cast[mutable void&] can Unsafe.PointerCast
            _ = memset(terminator, 0, size_of(uintptr))
            argv_items: void& = argv.items.cast[void&] can Unsafe.PointerCast
            can Blocking.IO:
                pid: int = elisascript_posix_fork()
                if pid < 0:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                if pid == 0:
                    # Give each launched job its own group so timeout cleanup can
                    # terminate descendants without affecting the interpreter.
                    _ = elisascript_posix_setpgid(0, 0)
                    _ = elisascript_posix_execvp(executable_items.cast[cstr], argv_items)
                    elisascript_posix_exit(127)
                    return runtime_void()
                _ = elisascript_posix_setpgid(pid, pid)
                waiter: mutable ProcessWaiter = ProcessWaiter{pid: pid, status: 0, failed: false}
                machine over process_wait_next(waiter):
                    state Wait
                    start Wait

                    Wait, ProcessWaitState.Progress:
                        -> Wait
                    Wait, ProcessWaitState.Exited:
                        break
                    Wait, ProcessWaitState.Error:
                        break
                if waiter.failed:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                signal_number: int = waiter.status & 0x7f
                return runtime_int(((waiter.status >> 8) & 0xff).i64()) if signal_number == 0
                return runtime_int((128 + signal_number).i64())


        def evaluate_capture_process_stream(machine: mutable Machine&, storage: darray[RuntimeValue]&, executable: RuntimeValue, arguments: RuntimeValue, output_fd: int) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if executable.kind != RuntimeValueKind.Text or arguments.kind != RuntimeValueKind.Array or text_has_nul(executable.text):
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(executable.text) == 0:
                machine.failure <- InterpretFailure.Process
                return runtime_void()
            if not runtime_array_range_valid(storage, arguments):
                machine.failure <- InterpretFailure.IndexOutOfBounds
                return runtime_void()
            executable_bytes: dstr = nul_terminated_text(executable.text)
            if executable_bytes.items == null:
                machine.failure <- InterpretFailure.Process
                return runtime_void()
            executable_items: u8& = executable_bytes.items
            owned_arguments: mutable darray[dstr] = []
            argv: mutable darray[cstr] = []
            owned_arguments.reserve(arguments.array_count.usize())
            argv.reserve(arguments.array_count.usize())
            argv.push(executable_items.cast[cstr])
            for offset in 0..<arguments.array_count.usize() |machine, storage, arguments, owned_arguments, argv|:
                argument: RuntimeValue = storage[arguments.array_start.usize() + offset]
                if argument.kind != RuntimeValueKind.Text or text_has_nul(argument.text):
                    machine.failure <- InterpretFailure.TypeMismatch
                    return runtime_void()
                argument_bytes: dstr = nul_terminated_text(argument.text)
                if argument_bytes.items == null:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                owned_arguments.push(argument_bytes)
                argument_storage: mutable u8&? = owned_arguments[owned_arguments.count - 1].items
                if argument_storage == null:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                argument_items: mutable u8& = argument_storage
                argv.push(argument_items.cast[cstr])
            argv.push(executable_items.cast[cstr])
            if argv.items == null:
                machine.failure <- InterpretFailure.Process
                return runtime_void()
            terminator: mutable void& = (&argv[argv.count - 1]).cast[mutable void&] can Unsafe.PointerCast
            _ = memset(terminator, 0, size_of(uintptr))
            argv_items: void& = argv.items.cast[void&] can Unsafe.PointerCast
            can Blocking.IO, Memory.Allocate, Memory.Release:
                handle: mutable heap void&? = elisascript_posix_tmpfile()
                if handle == null:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                stream: mutable heap void& = handle
                descriptor: int = elisascript_posix_fileno(stream)
                if descriptor < 0:
                    _ = fclose(stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                pid: int = elisascript_posix_fork()
                if pid < 0:
                    _ = fclose(stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                if pid == 0:
                    _ = elisascript_posix_setpgid(0, 0)
                    elisascript_posix_exit(126) if elisascript_posix_dup2(descriptor, output_fd) < 0
                    _ = elisascript_posix_execvp(executable_items.cast[cstr], argv_items)
                    elisascript_posix_exit(127)
                    return runtime_void()
                _ = elisascript_posix_setpgid(pid, pid)
                waiter: mutable ProcessWaiter = ProcessWaiter{pid: pid, status: 0, failed: false, stdout_stream: stream, output_limit: machine.process_output_limit}
                machine over process_wait_next(waiter):
                    state Wait
                    start Wait

                    Wait, ProcessWaitState.Progress:
                        -> Wait
                    Wait, ProcessWaitState.Exited:
                        break
                    Wait, ProcessWaitState.Error:
                        break
                if waiter.output_exceeded:
                    _ = fclose(stream)
                    machine.failure <- InterpretFailure.OutputLimit
                    return runtime_void()
                if waiter.failed or fseek(stream, 0, FILEIO_SEEK_END) != 0:
                    _ = fclose(stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                captured: sview = read_process_output(machine, stream)
                if machine.failure != InterpretFailure.None:
                    return runtime_void()
                return runtime_text(captured)


        def process_input_next(writer: mutable ProcessInputWriter&) -> ProcessInputState:
            return ProcessInputState.Done if writer.offset >= writer.length
            remaining: usize = writer.length - writer.offset
            buffer: mutable u8& = writer.data + writer.offset
            can Blocking.IO:
                amount: usize = fwrite(buffer.cast[void&], 1, remaining, writer.stream)
                if amount == 0:
                    writer.failed <- true
                    return ProcessInputState.Error
                writer.offset <- writer.offset + amount
                return ProcessInputState.Done if writer.offset >= writer.length
                return ProcessInputState.Progress


        # Terminate and reap the private process group on every parent-side
        # wait failure. The direct PID covers the fork/setpgid race; the group
        # signal handles descendants. Keeping this protocol in one helper
        # prevents a failed poll from stranding a child or zombie.
        def process_wait_terminate(waiter: mutable ProcessWaiter&) -> void can[Blocking.IO]:
            _ = elisascript_posix_kill(-waiter.pid, INTERPRET_PROCESS_WAIT_KILL)
            _ = elisascript_posix_kill(waiter.pid, INTERPRET_PROCESS_WAIT_KILL)
            _ = elisascript_posix_waitpid(waiter.pid, waiter.status, 0)


        def process_wait_stream_exceeded(waiter: mutable ProcessWaiter&, stream: heap void&) -> bool can[Blocking.IO]:
            if waiter.output_limit == 0:
                return false
            if fseek(stream, 0, FILEIO_SEEK_END) != 0:
                waiter.failed <- true
                process_wait_terminate(waiter)
                return true
            size: i64 = ftell(stream)
            if size < 0:
                waiter.failed <- true
                process_wait_terminate(waiter)
                return true
            if size.u64() <= waiter.output_limit:
                return false
            process_wait_terminate(waiter)
            waiter.output_exceeded <- true
            return true

        def process_wait_output_exceeded(waiter: mutable ProcessWaiter&) -> bool can[Blocking.IO]:
            return false if waiter.output_limit == 0
            exceeded: mutable bool = false
            if waiter.stdout_stream != null:
                stdout_stream: heap void& = waiter.stdout_stream
                exceeded <- process_wait_stream_exceeded(waiter, stdout_stream)
                return true if exceeded
            if waiter.stderr_stream != null:
                stderr_stream: heap void& = waiter.stderr_stream
                exceeded <- process_wait_stream_exceeded(waiter, stderr_stream)
            return exceeded


        def process_wait_next(waiter: mutable ProcessWaiter&) -> ProcessWaitState can[Blocking.IO]:
            waited: int = elisascript_posix_waitpid(waiter.pid, waiter.status, INTERPRET_PROCESS_WAIT_NOHANG)
            if waited != waiter.pid:
                if waited < 0:
                    process_wait_terminate(waiter)
                    waiter.failed <- true
                    return ProcessWaitState.Error
                return ProcessWaitState.Error if process_wait_output_exceeded(waiter)
                if waiter.polls >= INTERPRET_PROCESS_WAIT_MAX_POLLS:
                    process_wait_terminate(waiter)
                    waiter.failed <- true
                    return ProcessWaitState.Error
                if elisascript_posix_usleep(INTERPRET_PROCESS_WAIT_POLL_MICROSECONDS) != 0:
                    process_wait_terminate(waiter)
                    waiter.failed <- true
                    return ProcessWaitState.Error
                waiter.polls <- waiter.polls + 1
                return ProcessWaitState.Progress
            return ProcessWaitState.Exited


        def read_process_output(machine: mutable Machine&, stream: heap void&) -> sview can[Blocking.IO, Memory.Allocate, Memory.Release]:
            if fseek(stream, 0, FILEIO_SEEK_END) != 0:
                machine.failure <- InterpretFailure.Process
                _ = fclose(stream)
                return ""
            size: i64 = ftell(stream)
            if size < 0:
                machine.failure <- InterpretFailure.Process
                _ = fclose(stream)
                return ""
            if size.u64() > machine.process_output_limit:
                machine.failure <- InterpretFailure.OutputLimit
                _ = fclose(stream)
                return ""
            host_size: usize = size.usize()
            if host_size.i64() != size:
                machine.failure <- InterpretFailure.Process
                _ = fclose(stream)
                return ""
            if fseek(stream, 0, FILEIO_SEEK_SET) != 0:
                machine.failure <- InterpretFailure.Process
                _ = fclose(stream)
                return ""
            if size == 0:
                close_status: int = fclose(stream)
                if close_status != 0:
                    machine.failure <- InterpretFailure.Process
                    return ""
                return ""
            bytes: mutable dstr = ctx_fstr_alloc(host_size)
            if bytes.items == null:
                machine.failure <- InterpretFailure.Process
                _ = fclose(stream)
                return ""
            byte_items: mutable u8& = bytes.items
            read_count: usize = fread(byte_items.cast[mutable void&], 1, host_size, stream)
            close_status: int = fclose(stream)
            if read_count != host_size or close_status != 0:
                machine.failure <- InterpretFailure.Process
                return ""
            bytes.count <- host_size
            return bytes_view(bytes)


        # Execute a shell-free pipeline by staging each stage's stdout as the
        # next stage's stdin. This deliberately reuses the checked one-shot
        # ProcessCapture path, so argv handling, output limits, child setup, and
        # bounded waits are identical to standalone process execution.
        def evaluate_capture_process_pipeline(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, executables: RuntimeValue, arguments: RuntimeValue, input: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if executables.kind != RuntimeValueKind.Array or arguments.kind != RuntimeValueKind.Array or input.kind != RuntimeValueKind.Text:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if not runtime_array_range_valid(storage, executables) or not runtime_array_range_valid(storage, arguments):
                machine.failure <- InterpretFailure.IndexOutOfBounds
                return runtime_void()
            if executables.array_count == 0 or executables.array_count != arguments.array_count:
                machine.failure <- InterpretFailure.Process
                return runtime_void()
            current_input: mutable RuntimeValue = input
            final_capture: mutable RuntimeValue = runtime_void()
            for offset in 0..<executables.array_count.usize() |machine, storage, executables, arguments, offset, current_input, final_capture|:
                executable: RuntimeValue = storage[executables.array_start.usize() + offset]
                stage_arguments: RuntimeValue = storage[arguments.array_start.usize() + offset]
                if executable.kind != RuntimeValueKind.Text or stage_arguments.kind != RuntimeValueKind.Array:
                    machine.failure <- InterpretFailure.TypeMismatch
                    return runtime_void()
                final_capture <- evaluate_capture_process_result(machine, storage, executable, stage_arguments, current_input, runtime_void(), runtime_void())
                return runtime_void() if machine.failure != InterpretFailure.None
                current_input <- runtime_text(final_capture.process_stdout)
            return final_capture


        def evaluate_capture_process_result(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, executable: RuntimeValue, arguments: RuntimeValue, input: RuntimeValue, working_directory: RuntimeValue, environment: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if executable.kind != RuntimeValueKind.Text or arguments.kind != RuntimeValueKind.Array or input.kind != RuntimeValueKind.Text or (working_directory.kind != RuntimeValueKind.Void and working_directory.kind != RuntimeValueKind.Text) or (environment.kind != RuntimeValueKind.Void and environment.kind != RuntimeValueKind.Map) or text_has_nul(executable.text) or working_directory.kind == RuntimeValueKind.Text and text_has_nul(working_directory.text):
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if sview_len(executable.text) == 0:
                machine.failure <- InterpretFailure.Process
                return runtime_void()
            if not runtime_array_range_valid(storage, arguments):
                machine.failure <- InterpretFailure.IndexOutOfBounds
                return runtime_void()
            executable_bytes: dstr = nul_terminated_text(executable.text)
            if executable_bytes.items == null:
                machine.failure <- InterpretFailure.Process
                return runtime_void()
            executable_items: u8& = executable_bytes.items
            working_directory_bytes: mutable dstr = []
            working_directory_items: mutable u8&? = null
            if working_directory.kind == RuntimeValueKind.Text:
                working_directory_bytes <- nul_terminated_text(working_directory.text)
                if working_directory_bytes.items == null:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                directory_storage: mutable u8&? = working_directory_bytes.items
                if directory_storage == null:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                working_directory_items <- directory_storage
            environment_names: mutable darray[dstr] = []
            environment_values: mutable darray[dstr] = []
            if environment.kind == RuntimeValueKind.Map:
                if not runtime_map_range_valid(storage, environment):
                    machine.failure <- InterpretFailure.IndexOutOfBounds
                    return runtime_void()
                environment_names.reserve(environment.map_count.usize())
                environment_values.reserve(environment.map_count.usize())
                for offset in 0..<environment.map_count.usize() |machine, storage, environment, environment_names, environment_values|:
                    name: RuntimeValue = storage[environment.map_start.usize() + offset * 2]
                    value: RuntimeValue = storage[environment.map_start.usize() + offset * 2 + 1]
                    if name.kind != RuntimeValueKind.Text or value.kind != RuntimeValueKind.Text or sview_len(name.text) == 0 or text_has_nul(name.text) or sview_contains_byte(name.text, 61) or text_has_nul(value.text):
                        machine.failure <- InterpretFailure.TypeMismatch
                        return runtime_void()
                    name_bytes: dstr = nul_terminated_text(name.text)
                    value_bytes: dstr = nul_terminated_text(value.text)
                    if name_bytes.items == null or value_bytes.items == null:
                        machine.failure <- InterpretFailure.Process
                        return runtime_void()
                    if any existing in environment_names where bytes_view(existing) == name.text:
                        machine.failure <- InterpretFailure.TypeMismatch
                        return runtime_void()
                    environment_names.push(name_bytes)
                    environment_values.push(value_bytes)
            owned_arguments: mutable darray[dstr] = []
            argv: mutable darray[cstr] = []
            owned_arguments.reserve(arguments.array_count.usize())
            argv.reserve(arguments.array_count.usize())
            argv.push(executable_items.cast[cstr])
            for offset in 0..<arguments.array_count.usize() |machine, storage, arguments, owned_arguments, argv|:
                argument: RuntimeValue = storage[arguments.array_start.usize() + offset]
                if argument.kind != RuntimeValueKind.Text or text_has_nul(argument.text):
                    machine.failure <- InterpretFailure.TypeMismatch
                    return runtime_void()
                argument_bytes: dstr = nul_terminated_text(argument.text)
                if argument_bytes.items == null:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                owned_arguments.push(argument_bytes)
                argument_storage: mutable u8&? = owned_arguments[owned_arguments.count - 1].items
                if argument_storage == null:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                argument_items: mutable u8& = argument_storage
                argv.push(argument_items.cast[cstr])
            argv.push(executable_items.cast[cstr])
            if argv.items == null:
                machine.failure <- InterpretFailure.Process
                return runtime_void()
            terminator: mutable void& = (&argv[argv.count - 1]).cast[mutable void&] can Unsafe.PointerCast
            _ = memset(terminator, 0, size_of(uintptr))
            argv_items: void& = argv.items.cast[void&] can Unsafe.PointerCast
            can Blocking.IO, Memory.Allocate, Memory.Release:
                input_handle: mutable heap void&? = elisascript_posix_tmpfile()
                if input_handle == null:
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                input_stream: mutable heap void& = input_handle
                input_descriptor: int = elisascript_posix_fileno(input_stream)
                if input_descriptor < 0:
                    _ = fclose(input_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                input_writer: mutable ProcessInputWriter = ProcessInputWriter{stream: input_stream, data: input.text.data, length: sview_len(input.text), offset: 0, failed: false}
                machine over process_input_next(input_writer):
                    state Write
                    start Write

                    Write, ProcessInputState.Progress:
                        -> Write
                    Write, ProcessInputState.Done:
                        break
                    Write, ProcessInputState.Error:
                        break
                if input_writer.failed or fseek(input_stream, 0, FILEIO_SEEK_SET) != 0:
                    _ = fclose(input_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                stdout_handle: mutable heap void&? = elisascript_posix_tmpfile()
                if stdout_handle == null:
                    _ = fclose(input_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                stdout_stream: mutable heap void& = stdout_handle
                stdout_descriptor: int = elisascript_posix_fileno(stdout_stream)
                if stdout_descriptor < 0:
                    _ = fclose(input_stream)
                    _ = fclose(stdout_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                stderr_handle: mutable heap void&? = elisascript_posix_tmpfile()
                if stderr_handle == null:
                    _ = fclose(input_stream)
                    _ = fclose(stdout_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                stderr_stream: mutable heap void& = stderr_handle
                stderr_descriptor: int = elisascript_posix_fileno(stderr_stream)
                if stderr_descriptor < 0:
                    _ = fclose(input_stream)
                    _ = fclose(stdout_stream)
                    _ = fclose(stderr_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                pid: int = elisascript_posix_fork()
                if pid < 0:
                    _ = fclose(input_stream)
                    _ = fclose(stdout_stream)
                    _ = fclose(stderr_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                if pid == 0:
                    _ = elisascript_posix_setpgid(0, 0)
                    if working_directory_items != null:
                        directory_items: mutable u8& = working_directory_items
                        elisascript_posix_exit(126) if elisascript_posix_chdir(directory_items.cast[cstr]) != 0
                    for offset in 0..<environment_names.count |environment_names, environment_values|:
                        name_storage: mutable u8&? = environment_names[offset].items
                        value_storage: mutable u8&? = environment_values[offset].items
                        if name_storage == null or value_storage == null:
                            elisascript_posix_exit(126)
                        else:
                            name_items: mutable u8& = name_storage
                            value_items: mutable u8& = value_storage
                            elisascript_posix_exit(126) if elisascript_posix_setenv(name_items.cast[cstr], value_items.cast[cstr], 1) != 0
                    elisascript_posix_exit(126) if elisascript_posix_dup2(input_descriptor, 0) < 0
                    elisascript_posix_exit(126) if elisascript_posix_dup2(stdout_descriptor, 1) < 0
                    elisascript_posix_exit(126) if elisascript_posix_dup2(stderr_descriptor, 2) < 0
                    _ = elisascript_posix_execvp(executable_items.cast[cstr], argv_items)
                    elisascript_posix_exit(127)
                    return runtime_void()
                _ = elisascript_posix_setpgid(pid, pid)
                waiter: mutable ProcessWaiter = ProcessWaiter{pid: pid, status: 0, failed: false, stdout_stream: stdout_stream, stderr_stream: stderr_stream, output_limit: machine.process_output_limit}
                machine over process_wait_next(waiter):
                    state Wait
                    start Wait

                    Wait, ProcessWaitState.Progress:
                        -> Wait
                    Wait, ProcessWaitState.Exited:
                        break
                    Wait, ProcessWaitState.Error:
                        break
                if waiter.output_exceeded:
                    _ = fclose(input_stream)
                    _ = fclose(stdout_stream)
                    _ = fclose(stderr_stream)
                    machine.failure <- InterpretFailure.OutputLimit
                    return runtime_void()
                input_close_status: int = fclose(input_stream)
                if waiter.failed or input_close_status != 0:
                    _ = fclose(stdout_stream)
                    _ = fclose(stderr_stream)
                    machine.failure <- InterpretFailure.Process
                    return runtime_void()
                stdout_text: sview = read_process_output(machine, stdout_stream)
                if machine.failure != InterpretFailure.None:
                    _ = fclose(stderr_stream)
                    return runtime_void()
                stderr_text: sview = read_process_output(machine, stderr_stream)
                if machine.failure != InterpretFailure.None:
                    return runtime_void()
                signal_number: int = waiter.status & 0x7f
                exit_status: i64 = ((waiter.status >> 8) & 0xff).i64() if signal_number == 0 else (128 + signal_number).i64()
                return runtime_process_capture(exit_status, stdout_text, stderr_text)


        def evaluate_process_result_accessor(machine: mutable Machine&, capture: RuntimeValue, opcode: Opcode) -> RuntimeValue:
            if capture.kind != RuntimeValueKind.ProcessCapture:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            return runtime_int(capture.process_exit_status) if opcode == Opcode.ProcessResultExitStatus
            return runtime_text(capture.process_stdout) if opcode == Opcode.ProcessResultStdout
            return runtime_text(capture.process_stderr) if opcode == Opcode.ProcessResultStderr
            machine.failure <- InterpretFailure.UnsupportedInstruction
            return runtime_void()


        def evaluate_capture_process_stream_with_stdin(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, executable: RuntimeValue, arguments: RuntimeValue, input: RuntimeValue, output_fd: int) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if executable.kind != RuntimeValueKind.Text or arguments.kind != RuntimeValueKind.Array or input.kind != RuntimeValueKind.Text or text_has_nul(executable.text):
                machine.failure <- InterpretFailure.TypeMismatch
