error InterpretError:
    VerificationFailed
    UnknownFunction
    ArgumentMismatch
    MissingValue
    TypeMismatch
    DivisionByZero
    InvalidShift
    IndexOutOfBounds
    InvalidControlFlow
    UnsupportedInstruction
    StepLimitExceeded


extend EsIr:
    public:
        const enum RuntimeValueKind of u8:
            Void
            Bool
            Int
            Float
            Array
            Text


        struct RuntimeValue:
            text: sview = ""
            decimal: f64 = 0.0
            integer: i64 = 0
            array_start: u32 = 0
            array_count: u32 = 0
            kind: RuntimeValueKind
            boolean: bool = false


        struct Observation:
            trace: u64
            value: RuntimeValue


        struct Execution:
            value: RuntimeValue
            steps: u64


    private:
        const enum InterpretFailure of u8:
            None
            UnknownFunction
            ArgumentMismatch
            MissingValue
            TypeMismatch
            DivisionByZero
            InvalidShift
            IndexOutOfBounds
            InvalidControlFlow
            UnsupportedInstruction
            StepLimitExceeded


        struct Machine:
            steps: mutable u64
            step_limit: u64
            failure: mutable InterpretFailure


        struct InstructionDispatch:
            value: mutable RuntimeValue
            opcode: Opcode
            produces_value: mutable bool


        const enum DecimalClass of u8:
            Digit
            Dot
            Exponent
            Plus
            Minus
            Other


        struct DecimalParser:
            text: sview
            value: mutable f64
            place: mutable f64
            exponent: mutable i64
            index: mutable usize
            negative: mutable bool
            exponent_negative: mutable bool


        def runtime_void() -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Void}


        def runtime_bool(value: bool) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Bool, boolean: value}


        def runtime_int(value: i64) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Int, integer: value}


        def runtime_float(value: f64) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Float, decimal: value}


        def runtime_text(value: sview) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Text, text: value}


        def runtime_array(start: u32, count: u32) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Array, array_start: start, array_count: count}


        def decimal_class(parser: DecimalParser&) -> DecimalClass:
            return DecimalClass.Other if parser.index >= sview_len(parser.text)
            byte: u8 = sview_at(parser.text, parser.index)
            return DecimalClass.Digit if byte >= 48 and byte <= 57
            return DecimalClass.Dot if byte == 46
            return DecimalClass.Exponent if byte == 69 or byte == 101
            return DecimalClass.Plus if byte == 43
            return DecimalClass.Minus if byte == 45
            return DecimalClass.Other


        def consume_decimal_digit(parser: mutable DecimalParser&, fractional: bool) -> void:
            digit: f64 = (sview_at(parser.text, parser.index) - 48).f64()
            if fractional:
                parser.value <- parser.value + digit * parser.place
                parser.place <- parser.place * 0.1
            else:
                parser.value <- parser.value * 10.0 + digit
            parser.index <- parser.index + 1


        def consume_exponent_digit(parser: mutable DecimalParser&) -> void:
            parser.exponent <- parser.exponent * 10 + (sview_at(parser.text, parser.index) - 48).i64()
            parser.index <- parser.index + 1


        def parse_decimal(text: sview) -> f64:
            parser: mutable DecimalParser = DecimalParser{text: text, value: 0.0, place: 0.1, exponent: 0, index: 0, negative: false, exponent_negative: false}
            machine over decimal_class(parser) while parser.index < sview_len(parser.text):
                state Lead
                state Whole
                state Fraction
                state ExponentLead
                state ExponentDigits
                state Done
                start Lead

                Lead, DecimalClass.Minus:
                    parser.negative <- true
                    parser.index <- parser.index + 1
                    -> Whole
                Lead, DecimalClass.Digit | DecimalClass.Dot | DecimalClass.Exponent | DecimalClass.Plus | DecimalClass.Other:
                    -> Whole

                Whole, DecimalClass.Digit:
                    consume_decimal_digit(parser, false)
                    -> Whole
                Whole, DecimalClass.Dot:
                    parser.index <- parser.index + 1
                    -> Fraction
                Whole, DecimalClass.Exponent:
                    parser.index <- parser.index + 1
                    -> ExponentLead
                Whole, DecimalClass.Plus | DecimalClass.Minus | DecimalClass.Other:
                    -> Done

                Fraction, DecimalClass.Digit:
                    consume_decimal_digit(parser, true)
                    -> Fraction
                Fraction, DecimalClass.Exponent:
                    parser.index <- parser.index + 1
                    -> ExponentLead
                Fraction, DecimalClass.Dot | DecimalClass.Plus | DecimalClass.Minus | DecimalClass.Other:
                    -> Done

                ExponentLead, DecimalClass.Minus:
                    parser.exponent_negative <- true
                    parser.index <- parser.index + 1
                    -> ExponentDigits
                ExponentLead, DecimalClass.Plus:
                    parser.index <- parser.index + 1
                    -> ExponentDigits
                ExponentLead, DecimalClass.Digit:
                    -> ExponentDigits
                ExponentLead, DecimalClass.Dot | DecimalClass.Exponent | DecimalClass.Other:
                    -> Done

                ExponentDigits, DecimalClass.Digit:
                    consume_exponent_digit(parser)
                    -> ExponentDigits
                ExponentDigits, DecimalClass.Dot | DecimalClass.Exponent | DecimalClass.Plus | DecimalClass.Minus | DecimalClass.Other:
                    -> Done

                Done, DecimalClass.Digit | DecimalClass.Dot | DecimalClass.Exponent | DecimalClass.Plus | DecimalClass.Minus | DecimalClass.Other:
                    break

            parser.exponent <- -parser.exponent if parser.exponent_negative
            machine over parser.exponent > 0 while parser.exponent != 0:
                state Scale
                start Scale
                Scale, true:
                    parser.value <- parser.value * 10.0
                    parser.exponent <- parser.exponent - 1
                    -> Scale
                Scale, _:
                    parser.value <- parser.value * 0.1
                    parser.exponent <- parser.exponent + 1
                    -> Scale
            return -parser.value if parser.negative
            return parser.value


        def find_function(module: Module&, name: sview) -> usize:
            for index in 0..<module.functions.count |module, name|:
                index return if module.functions[index].name == name
            return module.functions.count


        def find_block(fn: Function&, id: u32) -> usize:
            for index in 0..<fn.blocks.count |fn, id|:
                index return if fn.blocks[index].id == id
            return fn.blocks.count


        def frame_value(ids: darray[u32]&, values: darray[RuntimeValue]&, id: u32, machine: mutable Machine&) -> RuntimeValue:
            for index in 0..<ids.count |ids, values, id|:
                values[index] return if ids[index] == id
            machine.failure <- InterpretFailure.MissingValue
            return runtime_void()


        def set_frame_value(ids: mutable darray[u32]&, values: mutable darray[RuntimeValue]&, id: u32, value: RuntimeValue) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<ids.count |ids, values, id, value|:
                if ids[index] == id:
                    values[index] <- value
                    return
            ids.push(id)
            values.push(value)


        def tick(machine: mutable Machine&) -> bool:
            machine.steps <- machine.steps + 1
            if machine.steps > machine.step_limit:
                machine.failure <- InterpretFailure.StepLimitExceeded
                return false
            return true


        def evaluate_constant(instruction: Instruction, machine: mutable Machine&) -> RuntimeValue:
            match instruction.result_type.kind:
                TypeKind.Bool:
                    return runtime_bool(instruction.boolean)
                TypeKind.Int:
                    return runtime_int(instruction.integer)
                TypeKind.Float:
                    return runtime_float(parse_decimal(instruction.decimal))
                TypeKind.Text | TypeKind.Char:
                    return runtime_text(instruction.text)
                _:
                    machine.failure <- InterpretFailure.UnsupportedInstruction
                    return runtime_void()


        def evaluate_negate(operand: RuntimeValue, machine: mutable Machine&) -> RuntimeValue:
            match operand.kind:
                RuntimeValueKind.Int:
                    return runtime_int(-operand.integer)
                RuntimeValueKind.Float:
                    return runtime_float(-operand.decimal)
                _:
                    machine.failure <- InterpretFailure.TypeMismatch
                    return runtime_void()


        def evaluate_not(operand: RuntimeValue, machine: mutable Machine&) -> RuntimeValue:
            if operand.kind != RuntimeValueKind.Bool:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            return runtime_bool(not operand.boolean)


        def evaluate_bit_not(operand: RuntimeValue, machine: mutable Machine&) -> RuntimeValue:
            if operand.kind != RuntimeValueKind.Int:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            return runtime_int(~operand.integer)


        def runtime_values_equal(left: RuntimeValue, right: RuntimeValue) -> bool:
            false return if left.kind != right.kind
            left.integer == right.integer return if left.kind == RuntimeValueKind.Int
            left.boolean == right.boolean return if left.kind == RuntimeValueKind.Bool
            left.decimal == right.decimal return if left.kind == RuntimeValueKind.Float
            left.text == right.text return if left.kind == RuntimeValueKind.Text
            return left.kind == RuntimeValueKind.Void


        def runtime_arrays_equal(storage: darray[RuntimeValue]&, left: RuntimeValue, right: RuntimeValue) -> bool:
            false return if left.array_count != right.array_count
            for offset in 0..<left.array_count.usize() |storage, left, right|:
                false return if not runtime_values_equal(storage[left.array_start.usize() + offset], storage[right.array_start.usize() + offset])
            return true


        def evaluate_binary(opcode: Opcode, left: RuntimeValue, right: RuntimeValue, result_type: Type&, storage: darray[RuntimeValue]&, machine: mutable Machine&) -> RuntimeValue:
            if opcode == Opcode.Equal or opcode == Opcode.NotEqual:
                if left.kind != right.kind:
                    machine.failure <- InterpretFailure.TypeMismatch
                    return runtime_void()
                equal: mutable bool = false
                equal <- left.integer == right.integer if left.kind == RuntimeValueKind.Int
                equal <- left.boolean == right.boolean if left.kind == RuntimeValueKind.Bool
                equal <- left.decimal == right.decimal if left.kind == RuntimeValueKind.Float
                equal <- left.text == right.text if left.kind == RuntimeValueKind.Text
                equal <- runtime_arrays_equal(storage, left, right) if left.kind == RuntimeValueKind.Array
                return runtime_bool(equal) if opcode == Opcode.Equal
                return runtime_bool(not equal)
            if left.kind == RuntimeValueKind.Int and right.kind == RuntimeValueKind.Int:
                return runtime_int(left.integer & right.integer) if opcode == Opcode.BitAnd
                return runtime_int(left.integer | right.integer) if opcode == Opcode.BitOr
                return runtime_int(left.integer ^ right.integer) if opcode == Opcode.BitXor
                if opcode == Opcode.ShiftLeft or opcode == Opcode.ShiftRight:
                    if right.integer < 0 or right.integer >= result_type.bits.i64():
                        machine.failure <- InterpretFailure.InvalidShift
                        return runtime_void()
                    return runtime_int(left.integer << right.integer.u32()) if opcode == Opcode.ShiftLeft
                    return runtime_int(left.integer >> right.integer.u32())
                return runtime_int(left.integer + right.integer) if opcode == Opcode.Add
                return runtime_int(left.integer - right.integer) if opcode == Opcode.Subtract
                return runtime_int(left.integer * right.integer) if opcode == Opcode.Multiply
                if opcode == Opcode.Divide or opcode == Opcode.Remainder:
                    if right.integer == 0:
                        machine.failure <- InterpretFailure.DivisionByZero
                        return runtime_void()
                    return runtime_int(left.integer / right.integer) if opcode == Opcode.Divide
                    return runtime_int(left.integer % right.integer)
                return runtime_bool(left.integer < right.integer) if opcode == Opcode.Less
                return runtime_bool(left.integer <= right.integer) if opcode == Opcode.LessEqual
                return runtime_bool(left.integer > right.integer) if opcode == Opcode.Greater
                return runtime_bool(left.integer >= right.integer)
            if left.kind == RuntimeValueKind.Float and right.kind == RuntimeValueKind.Float and opcode != Opcode.Remainder:
                return runtime_float(left.decimal + right.decimal) if opcode == Opcode.Add
                return runtime_float(left.decimal - right.decimal) if opcode == Opcode.Subtract
                return runtime_float(left.decimal * right.decimal) if opcode == Opcode.Multiply
                return runtime_float(left.decimal / right.decimal) if opcode == Opcode.Divide
                return runtime_bool(left.decimal < right.decimal) if opcode == Opcode.Less
                return runtime_bool(left.decimal <= right.decimal) if opcode == Opcode.LessEqual
                return runtime_bool(left.decimal > right.decimal) if opcode == Opcode.Greater
                return runtime_bool(left.decimal >= right.decimal)
            machine.failure <- InterpretFailure.TypeMismatch
            return runtime_void()


        def note_observation(observations: mutable darray[Observation]&, trace: u64, value: RuntimeValue) -> void can[Memory.Allocate, Abort.Panic]:
            observations.push(Observation{trace: trace, value: value})


        def note_unsupported(machine: mutable Machine&) -> void:
            machine.failure <- InterpretFailure.UnsupportedInstruction


        def runtime_handler_index(module: Module&, name: sview) -> usize:
            for index in 0..<module.handlers.count |module, name|:
                index return if module.handlers[index].name == name
            return module.handlers.count


        def handler_covers(handler: Handler&, family: sview) -> bool:
            return any covered in handler.handles where covered == family


        def pop_runtime_handler(machine: mutable Machine&, handler_stack: mutable darray[sview]&, expected: sview) -> void:
            if handler_stack.count == 0 or handler_stack[handler_stack.count - 1] != expected:
                machine.failure <- InterpretFailure.InvalidControlFlow
                return
            _ = handler_stack.pop()


        def evaluate_call(machine: mutable Machine&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handler_stack: mutable darray[sview]&, module: Module&, fn: Function&, instruction: Instruction, ids: darray[u32]&, values: darray[RuntimeValue]&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            callee_index: usize = find_function(module, instruction.symbol)
            call_arguments: mutable darray[RuntimeValue] = []
            for offset in 0..<instruction.operand_count.usize() |machine, fn, instruction, ids, values, call_arguments|:
                call_arguments.push(frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + offset], machine))
            return execute_function(machine, observations, storage, handler_stack, module, callee_index, call_arguments) if machine.failure == InterpretFailure.None
            return runtime_void()


        def evaluate_perform(machine: mutable Machine&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handler_stack: mutable darray[sview]&, module: Module&, fn: Function&, instruction: Instruction, ids: darray[u32]&, values: darray[RuntimeValue]&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            while installed > 0 |installed: usize = handler_stack.count|:
                installed <- installed - 1
                handler_index: usize = runtime_handler_index(module, handler_stack[installed])
                if handler_index < module.handlers.count:
                    handler: Handler = module.handlers[handler_index]
                    if handler_covers(handler, instruction.effect_family):
                        for clause in handler.clauses |machine, observations, storage, handler_stack, module, fn, instruction, ids, values|:
                            if clause.effect_family == instruction.effect_family and clause.effect_operation == instruction.effect_operation:
                                arguments: mutable darray[RuntimeValue] = []
                                for offset in 0..<instruction.operand_count.usize() |machine, fn, instruction, ids, values, arguments|:
                                    arguments.push(frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + offset], machine))
                                callback_index: usize = find_function(module, clause.function)
                                return execute_function(machine, observations, storage, handler_stack, module, callback_index, arguments) if machine.failure == InterpretFailure.None
                                return runtime_void()
                        note_unsupported(machine)
                        return runtime_void()
            note_unsupported(machine)
            return runtime_void()


        def evaluate_array(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, fn: Function&, instruction: Instruction, ids: darray[u32]&, values: darray[RuntimeValue]&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            start: u32 = storage.count.u32()
            for offset in 0..<instruction.operand_count.usize() |machine, storage, fn, instruction, ids, values|:
                storage.push(frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + offset], machine))
            return runtime_array(start, instruction.operand_count.u32())


        def evaluate_index(machine: mutable Machine&, storage: darray[RuntimeValue]&, collection: RuntimeValue, index: RuntimeValue) -> RuntimeValue:
            if index.kind != RuntimeValueKind.Int or collection.kind not in {RuntimeValueKind.Array, RuntimeValueKind.Text}:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            length: i64 = collection.array_count.i64() if collection.kind == RuntimeValueKind.Array else sview_len(collection.text).i64()
            if index.integer < 0 or index.integer >= length:
                machine.failure <- InterpretFailure.IndexOutOfBounds
                return runtime_void()
            return runtime_text(collection.text[index.integer.usize():index.integer.usize() + 1]) if collection.kind == RuntimeValueKind.Text
            return storage[collection.array_start.usize() + index.integer.usize()]


        def evaluate_length(machine: mutable Machine&, collection: RuntimeValue) -> RuntimeValue:
            if collection.kind not in {RuntimeValueKind.Array, RuntimeValueKind.Text}:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            return runtime_int(sview_len(collection.text).i64()) if collection.kind == RuntimeValueKind.Text
            return runtime_int(collection.array_count.i64())


        def evaluate_slice(machine: mutable Machine&, collection: RuntimeValue, low: RuntimeValue, high: RuntimeValue) -> RuntimeValue:
            if collection.kind not in {RuntimeValueKind.Array, RuntimeValueKind.Text} or low.kind != RuntimeValueKind.Int or high.kind != RuntimeValueKind.Int:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            length: i64 = collection.array_count.i64() if collection.kind == RuntimeValueKind.Array else sview_len(collection.text).i64()
            if low.integer < 0 or high.integer < low.integer or high.integer > length:
                machine.failure <- InterpretFailure.IndexOutOfBounds
                return runtime_void()
            return runtime_text(collection.text[low.integer.usize():high.integer.usize()]) if collection.kind == RuntimeValueKind.Text
            return runtime_array(collection.array_start + low.integer.u32(), (high.integer - low.integer).u32())


        def text_contains(haystack: sview, needle: sview) -> bool:
            needle_length: usize = sview_len(needle)
            haystack_length: usize = sview_len(haystack)
            true return if needle_length == 0
            false return if needle_length > haystack_length
            for start in 0..=haystack_length - needle_length |haystack, needle, needle_length|:
                matched: mutable bool = true
                for offset in 0..<needle_length |haystack, needle, start, matched|:
                    matched <- false if sview_at(haystack, start + offset) != sview_at(needle, offset)
                true return if matched
            return false


        def evaluate_contains(machine: mutable Machine&, storage: darray[RuntimeValue]&, needle: RuntimeValue, collection: RuntimeValue) -> RuntimeValue:
            if collection.kind == RuntimeValueKind.Text and needle.kind == RuntimeValueKind.Text:
                return runtime_bool(text_contains(collection.text, needle.text))
            if collection.kind == RuntimeValueKind.Array:
                for offset in 0..<collection.array_count.usize() |storage, collection, needle|:
                    runtime_bool(true) return if runtime_values_equal(needle, storage[collection.array_start.usize() + offset])
                return runtime_bool(false)
            machine.failure <- InterpretFailure.TypeMismatch
            return runtime_void()


        def evaluate_concat(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, left: RuntimeValue, right: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if left.kind == RuntimeValueKind.Array and right.kind == RuntimeValueKind.Array:
                start: u32 = storage.count.u32()
                storage.reserve(storage.count + left.array_count.usize() + right.array_count.usize())
                for offset in 0..<left.array_count.usize() |storage, left|:
                    storage.push(storage[left.array_start.usize() + offset])
                for offset in 0..<right.array_count.usize() |storage, right|:
                    storage.push(storage[right.array_start.usize() + offset])
                return runtime_array(start, left.array_count + right.array_count)
            if left.kind == RuntimeValueKind.Text and right.kind == RuntimeValueKind.Text:
                left_length: usize = sview_len(left.text)
                right_length: usize = sview_len(right.text)
                bytes: mutable dstr = ctx_fstr_alloc(left_length + right_length)
                ctx_fstr_append(bytes, left.text.data, left_length)
                ctx_fstr_append(bytes, right.text.data, right_length)
                return runtime_text(bytes_view(bytes))
            machine.failure <- InterpretFailure.TypeMismatch
            return runtime_void()


        def evaluate_set_index(machine: mutable Machine&, storage: mutable darray[RuntimeValue]&, collection: RuntimeValue, index: RuntimeValue, replacement: RuntimeValue) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if collection.kind != RuntimeValueKind.Array or index.kind != RuntimeValueKind.Int:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            if index.integer < 0 or index.integer >= collection.array_count.i64():
                machine.failure <- InterpretFailure.IndexOutOfBounds
                return runtime_void()
            old_value: RuntimeValue = storage[collection.array_start.usize() + index.integer.usize()]
            if old_value.kind != replacement.kind:
                machine.failure <- InterpretFailure.TypeMismatch
                return runtime_void()
            start: u32 = storage.count.u32()
            storage.reserve(storage.count + collection.array_count.usize())
            for offset in 0..<collection.array_count.usize() |storage, collection|:
                storage.push(storage[collection.array_start.usize() + offset])
            storage[start.usize() + index.integer.usize()] <- replacement
            return runtime_array(start, collection.array_count)


        def execute_function(machine: mutable Machine&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handler_stack: mutable darray[sview]&, module: Module&, function_index: usize, arguments: darray[RuntimeValue]&) -> RuntimeValue can[Memory.Allocate, Abort.Panic]:
            if function_index >= module.functions.count:
                machine.failure <- InterpretFailure.UnknownFunction
                return runtime_void()
            fn: Function = module.functions[function_index]
            if arguments.count != fn.parameters.count:
                machine.failure <- InterpretFailure.ArgumentMismatch
                return runtime_void()

            ids: mutable darray[u32] = []
            values: mutable darray[RuntimeValue] = []
            for index in 0..<arguments.count |fn, arguments, ids, values|:
                ids.push(fn.parameters[index].value)
                values.push(arguments[index])
            current_block: mutable u32 = fn.entry

            while machine.failure == InterpretFailure.None:
                runtime_void() return if not tick(machine)
                block_index: usize = find_block(fn, current_block)
                if block_index == fn.blocks.count:
                    machine.failure <- InterpretFailure.InvalidControlFlow
                    return runtime_void()
                block: Block = fn.blocks[block_index]
                instruction_end: usize = block.instruction_start.usize() + block.instruction_count.usize()
                for instruction_index in block.instruction_start.usize()..<instruction_end |machine, observations, storage, handler_stack, module, fn, ids, values|:
                    runtime_void() return if not tick(machine)
                    instruction: Instruction = fn.instruction_pool[instruction_index]
                    dispatch: mutable InstructionDispatch = InstructionDispatch{value: runtime_void(), opcode: instruction.opcode, produces_value: instruction.result != 0}
                    machine over dispatch.opcode:
                        state Dispatch
                        start Dispatch

                        Dispatch, Opcode.Constant:
                            dispatch.value <- evaluate_constant(instruction, machine)
                            break

                        Dispatch, Opcode.Copy:
                            dispatch.value <- frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            break

                        Dispatch, Opcode.Negate:
                            operand: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_negate(operand, machine)
                            break

                        Dispatch, Opcode.Not:
                            operand: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_not(operand, machine)
                            break

                        Dispatch, Opcode.BitNot:
                            operand: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_bit_not(operand, machine)
                            break

                        Dispatch, Opcode.MakeArray:
                            dispatch.value <- evaluate_array(machine, storage, fn, instruction, ids, values)
                            break

                        Dispatch, Opcode.Index:
                            collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            index: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_index(machine, storage, collection, index)
                            break

                        Dispatch, Opcode.Length:
                            collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            dispatch.value <- evaluate_length(machine, collection)
                            break

                        Dispatch, Opcode.Slice:
                            collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            low: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            high: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                            dispatch.value <- evaluate_slice(machine, collection, low, high)
                            break

                        Dispatch, Opcode.Contains:
                            needle: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_contains(machine, storage, needle, collection)
                            break

                        Dispatch, Opcode.Concat:
                            left: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            right: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_concat(machine, storage, left, right)
                            break

                        Dispatch, Opcode.SetIndex:
                            collection: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            index: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            replacement: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 2], machine)
                            dispatch.value <- evaluate_set_index(machine, storage, collection, index, replacement)
                            break

                        Dispatch, Opcode.Add | Opcode.Subtract | Opcode.Multiply | Opcode.Divide | Opcode.Remainder | Opcode.Equal | Opcode.NotEqual | Opcode.Less | Opcode.LessEqual | Opcode.Greater | Opcode.GreaterEqual | Opcode.BitAnd | Opcode.BitOr | Opcode.BitXor | Opcode.ShiftLeft | Opcode.ShiftRight:
                            left: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            right: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize() + 1], machine)
                            dispatch.value <- evaluate_binary(instruction.opcode, left, right, instruction.result_type, storage, machine)
                            break

                        Dispatch, Opcode.Call:
                            dispatch.value <- evaluate_call(machine, observations, storage, handler_stack, module, fn, instruction, ids, values)
                            break

                        Dispatch, Opcode.Observe:
                            observed: RuntimeValue = frame_value(ids, values, fn.operand_pool[instruction.operand_start.usize()], machine)
                            note_observation(observations, instruction.trace.id, observed)
                            dispatch.produces_value <- false
                            break

                        Dispatch, Opcode.HandlerPush:
                            handler_stack.push(instruction.symbol)
                            dispatch.produces_value <- false
                            break

                        Dispatch, Opcode.HandlerPop:
                            pop_runtime_handler(machine, handler_stack, instruction.symbol)
                            dispatch.produces_value <- false
                            break

                        Dispatch, Opcode.Perform:
                            dispatch.value <- evaluate_perform(machine, observations, storage, handler_stack, module, fn, instruction, ids, values)
                            break

                        Dispatch, Opcode.Resume:
                            note_unsupported(machine)
                            break
                    set_frame_value(ids, values, instruction.result, dispatch.value) if machine.failure == InterpretFailure.None and dispatch.produces_value

                runtime_void() return if machine.failure != InterpretFailure.None
                terminator: Terminator = block.terminator
                if terminator.kind == TerminatorKind.Return:
                    return runtime_void() if terminator.operand_count == 0
                    return frame_value(ids, values, terminator.operand, machine)
                target: mutable u32 = 0
                edge_start: mutable u32 = 0
                edge_count: mutable u16 = 0
                if terminator.kind == TerminatorKind.Jump:
                    target <- terminator.target0
                    edge_start <- terminator.edge0_arg_start
                    edge_count <- terminator.edge0_arg_count
                else:
                    if terminator.kind == TerminatorKind.Branch:
                        condition: RuntimeValue = frame_value(ids, values, terminator.operand, machine)
                        if condition.kind != RuntimeValueKind.Bool:
                            machine.failure <- InterpretFailure.TypeMismatch
                            return runtime_void()
                        target <- terminator.target0 if condition.boolean else terminator.target1
                        edge_start <- terminator.edge0_arg_start if condition.boolean else terminator.edge1_arg_start
                        edge_count <- terminator.edge0_arg_count if condition.boolean else terminator.edge1_arg_count
                    else:
                        machine.failure <- InterpretFailure.InvalidControlFlow
                        return runtime_void()
                target_index: usize = find_block(fn, target)
                if target_index == fn.blocks.count or edge_count != fn.blocks[target_index].parameter_count:
                    machine.failure <- InterpretFailure.InvalidControlFlow
                    return runtime_void()
                pending: mutable darray[RuntimeValue] = []
                for offset in 0..<edge_count.usize() |machine, fn, edge_start, ids, values, pending|:
                    pending.push(frame_value(ids, values, fn.edge_arg_pool[edge_start.usize() + offset], machine))
                for offset in 0..<edge_count.usize() |fn, target_index, pending, ids, values|:
                    parameter: Parameter = fn.block_parameter_pool[fn.blocks[target_index].parameter_start.usize() + offset]
                    set_frame_value(ids, values, parameter.value, pending[offset])
                current_block <- target
            return runtime_void()


        def raise_interpret_failure(failure: InterpretFailure) -> void error[InterpretError]:
            if failure == InterpretFailure.UnknownFunction:
                raise InterpretError.UnknownFunction
            if failure == InterpretFailure.ArgumentMismatch:
                raise InterpretError.ArgumentMismatch
            if failure == InterpretFailure.MissingValue:
                raise InterpretError.MissingValue
            if failure == InterpretFailure.TypeMismatch:
                raise InterpretError.TypeMismatch
            if failure == InterpretFailure.DivisionByZero:
                raise InterpretError.DivisionByZero
            if failure == InterpretFailure.InvalidShift:
                raise InterpretError.InvalidShift
            if failure == InterpretFailure.IndexOutOfBounds:
                raise InterpretError.IndexOutOfBounds
            if failure == InterpretFailure.InvalidControlFlow:
                raise InterpretError.InvalidControlFlow
            if failure == InterpretFailure.UnsupportedInstruction:
                raise InterpretError.UnsupportedInstruction
            if failure == InterpretFailure.StepLimitExceeded:
                raise InterpretError.StepLimitExceeded


    public:
        def interpret(module: Module&, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            raise InterpretError.VerificationFailed if verify(module).count != 0
            function_index: usize = find_function(module, entry)
            raise InterpretError.UnknownFunction if function_index == module.functions.count
            machine: mutable Machine = Machine{steps: 0, step_limit: step_limit, failure: InterpretFailure.None}
            handler_stack: mutable darray[sview] = []
            value: RuntimeValue = execute_function(machine, observations, storage, handler_stack, module, function_index, arguments)
            try raise_interpret_failure(machine.failure) if machine.failure != InterpretFailure.None
            return Execution{value: value, steps: machine.steps}
