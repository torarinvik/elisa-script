# Typed metadata around the canonical verified-IR stream.
#
# This is intentionally a small artifact primitive: execution reports can carry
# the canonical stream's compact correlation fingerprint and cryptographic
# identity without depending on a host serializer or backend-specific
# instruction numbering. The byte stream is emitted separately by
# `canonical_module_bytes` so its inferred region stays with the artifact writer
# that owns it. Rich differential reports add observations and process metadata
# around these values later.


module EsIrArtifact:
    using EsIr

    private:
        # Artifact labels are metadata, not an unbounded payload. Keep a
        # malformed report from retaining oversized borrowed views while still
        # allowing backend-specific labels and source revisions.
        const ARTIFACT_MAX_METADATA_TEXT_BYTES: usize = 4096


    public:
        struct ModuleArtifact:
            format_version: u8 = 2
            backend: sview = ""
            source_revision: sview = ""
            fingerprint: u64
            digest_0: u64
            digest_1: u64
            digest_2: u64
            digest_3: u64


        def make_module_artifact(module: Module&, backend: sview, source_revision: sview) -> ModuleArtifact can[Memory.Allocate, Abort.Panic]:
            return ModuleArtifact{format_version: 2, backend: backend, source_revision: source_revision, fingerprint: module_fingerprint(module), digest_0: canonical_module_digest_word(module, 0), digest_1: canonical_module_digest_word(module, 1), digest_2: canonical_module_digest_word(module, 2), digest_3: canonical_module_digest_word(module, 3)}


        def artifact_metadata_valid(artifact: ModuleArtifact&) -> bool:
            return false if artifact.format_version != 2 or sview_len(artifact.backend) == 0
            return false if sview_len(artifact.backend) > ARTIFACT_MAX_METADATA_TEXT_BYTES or sview_len(artifact.source_revision) > ARTIFACT_MAX_METADATA_TEXT_BYTES
            return false if artifact.digest_0 == 0 or artifact.digest_1 == 0 or artifact.digest_2 == 0 or artifact.digest_3 == 0
            return true


        def artifact_fingerprint_matches_module(artifact: ModuleArtifact&, module: Module&) -> bool can[Memory.Allocate, Abort.Panic]:
            return artifact_metadata_valid(artifact) and artifact.fingerprint == module_fingerprint(module) and artifact.digest_0 == canonical_module_digest_word(module, 0) and artifact.digest_1 == canonical_module_digest_word(module, 1) and artifact.digest_2 == canonical_module_digest_word(module, 2) and artifact.digest_3 == canonical_module_digest_word(module, 3)
