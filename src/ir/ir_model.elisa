include "../../vendor/elisa-compiler/elisacore_std/elisacore_runtime.elisa"


module EsIr:
    public:
        # Closed, backend-neutral value vocabulary. `Named` preserves Elisa nominal
        # identity; `Function` and `Block` are control-flow references, not pointers.
        const enum TypeKind of u8:
            Void
            Bool
            Int
            Float
            Char
            Text
            Bytes
            Array
            Map
            Named
            Function
            Block


        struct Type:
            name: mutable sview = ""
            element_name: sview = ""
            element_element_name: sview = ""
            element_element_element_name: sview = ""
            element_element_element_element_name: sview = ""
            element_element_element_element_element_name: sview = ""
            bits: u16 = 0
            element_bits: u16 = 0
            element_element_bits: u16 = 0
            element_element_element_bits: u16 = 0
            element_element_element_element_bits: u16 = 0
            element_element_element_element_element_bits: u16 = 0
            kind: TypeKind
            element_kind: TypeKind = TypeKind.Void
            element_element_kind: TypeKind = TypeKind.Void
            element_element_element_kind: TypeKind = TypeKind.Void
            element_element_element_element_kind: TypeKind = TypeKind.Void
            element_element_element_element_element_kind: TypeKind = TypeKind.Void
            signed: bool = false
            element_signed: bool = false
            element_element_signed: bool = false
            element_element_element_signed: bool = false
            element_element_element_element_signed: bool = false
            element_element_element_element_element_signed: bool = false
            # Module-local interned identity. Zero means the legacy inline
            # descriptor has not been assigned an id yet.
            descriptor_id: mutable u32 = 0


        # Flat, pointer-free structural type descriptor. Children live in a shared
        # u32 pool, so recursive shapes do not require recursive Elisa values or
        # allocator-sensitive pointers. Row ids are one-based; id 0 is unknown.
        struct TypeDescriptor:
            name: sview = ""
            child_start: u32 = 0
            bits: u16 = 0
            child_count: u16 = 0
            kind: TypeKind
            signed: bool = false


        struct TypeTable:
            rows: mutable darray[TypeDescriptor]
            children: mutable darray[u32]


        struct SourceSpan:
            file: sview
            line: u32
            column: u32
            end_line: u32
            end_column: u32


        # Operations remain semantic until the final target lowering. In particular,
        # Perform is never disguised as a runtime call in this IR.
        const enum Opcode of u8:
            Constant
            Copy
            Add
            Subtract
            Multiply
            Divide
            Equal
            Less
            Remainder
            NotEqual
            LessEqual
            Greater
            GreaterEqual
            Negate
            Not
            BitNot
            BitAnd
            BitOr
            BitXor
            ShiftLeft
            ShiftRight
            MakeArray
            MakeMap
            MapKeys
            MakePath
            MakeGlob
            MakeRegex
            MakeUrl
            Index
            IndexValid
            ErrorGuardPush
            ErrorGuardPop
            Length
            Slice
            Contains
            RegexSearch
            RegexReplace
            RegexSplit
            RegexFind
            RegexCapture
            Split
            Join
            ParseInt
            FormatInt
            ParseFloat
            FormatFloat
            FormatBool
            PathJoin
            PathParent
            PathName
            PathExtension
            PathStem
            PathIsAbsolute
            PathNormalize
            PathAbsolute
            PathExists
            IsFile
            PathAccess
            TouchPath
            ChmodPath
            FileSize
            FileMode
            FileMTime
            IsSymlink
            ReadLink
            SymlinkPath
            RemoveTree
            CopyTree
            ReadText
            ReadBytes
            WriteText
            WriteBytes
            RemovePath
            CopyPath
            MovePath
            MakeExecutable
            RunProcess
            CaptureProcessStdout
            CaptureProcessStderr
            CaptureProcessStdoutWithStdin
            CaptureProcessResult
            CaptureProcessResultInDirectory
            CaptureProcessResultWithEnvironment
            CaptureProcessResultInDirectoryWithEnvironment
            ProcessResultExitStatus
            ProcessResultStdout
            ProcessResultStderr
            GetEnvironment
            SetEnvironment
            UnsetEnvironment
            CreateDirectory
            CreateDirectories
            RemoveDirectory
            CurrentDirectory
            ChangeDirectory
            ListDirectory
            IsDirectory
            ExpandGlob
            ReadStdin
            WriteStdout
            WriteStderr
            Concat
            SetIndex
            DeleteIndex
            Call
            Perform
            Observe
            HandlerPush
            HandlerPop
            Resume
            StartsWith
            EndsWith
            TextReplace
            TrimText
            PopArrayValue
            PopArray
            LowerText
            UpperText
            SplitLines
            MapValues
            TextCount
            TextFind
            TextRFind
            TextPredicate
            ReverseArray
            InsertArray
            CopyArray
            TextRemoveBoundary
            ArrayCount
            ArrayFind
            RemoveArray
            SortArray
            PopMapValue
            PopMap
            SetDefaultMapValue
            SetDefaultMap
            ReadStdinLine
            AppendText
            AppendBytes
            RangeCondition
            FileATime
            FileCTime
            PathGlob
            PathRGlob
            CaptureProcessStderrWithStdin
            CopyMap
            PathRelative
            Sleep
            PathReal
            CreateTemporary
            Assert


        const enum ContinuationPolicy of u8:
            Terminal
            Linear
            Affine
            MultiReplay
            MultiClone


        const enum CaptureClass of u8:
            Unrestricted
            Affine
            Linear
            Borrowed
            RegionBound
            Opaque


        struct ContinuationCapture:
            name: sview
            type: mutable Type
            class: CaptureClass


        # A clause names an ordinary typed IR function. Its parameters are the
        # performed operation payload and its return type is the resumed value.
        struct HandlerClause:
            effect_family: sview
            effect_operation: sview
            function: sview


        # Handler failures remain Elisa error sets. They are never wrapped in a Result
        # value and never conflated with the effects handled or introduced here.
        struct Handler:
            name: sview
            handles: darray[sview]
            introduces_effects: darray[sview]
            errors: darray[sview]
            continuation: ContinuationPolicy
            clauses: darray[HandlerClause] = []
            captures: mutable darray[ContinuationCapture] = []
            replay_safe_effects: darray[sview] = []


        const enum TerminatorKind of u8:
            Return
            Jump
            Branch
            Unreachable


        # A stable identity lets reference and candidate executions align effect events
        # even when backend instruction layouts differ.
        struct TraceSite:
            id: u64
            label: sview = ""


        struct Parameter:
            value: u32
            type: mutable Type
            name: sview = ""


        struct Instruction:
            span: SourceSpan
            result_type: mutable Type
            trace: TraceSite = TraceSite{id: 0, label: ""}
            decimal: sview = ""
            text: sview = ""
            symbol: sview = ""
            effect_family: sview = ""
            effect_operation: sview = ""
            integer: i64 = 0
            result: u32
            operand_start: u32 = 0
            operand_count: u16 = 0
            opcode: Opcode
            boolean: bool = false
            # Constant payload or direct-call symbol. Only the field selected by the
            # opcode is meaningful; backends never need to recover it from source text.
            # Populated only by Perform/Observe. A Perform names `Family.Operation` as two
            # fields so effect rows and handler dispatch do not depend on string splitting.
            # Zero result means this instruction has no value; non-zero ids are local SSA.


        struct Terminator:
            span: SourceSpan
            operand: u32 = 0
            target0: u32 = 0
            target1: u32 = 0
            edge0_arg_start: u32 = 0
            edge1_arg_start: u32 = 0
            kind: TerminatorKind
            operand_count: u8 = 0
            target_count: u8 = 0
            edge0_arg_count: u16 = 0
            edge1_arg_count: u16 = 0


        struct Block:
            id: u32
            parameter_start: u32
            parameter_count: u16
            instruction_start: u32
            instruction_count: u32
            terminator: mutable Terminator


        struct Function:
            name: sview
            parameters: mutable darray[Parameter]
            return_type: mutable Type
            effects: darray[sview]
            # All instruction operands live here. Instructions name a contiguous slice,
            # avoiding tiny region-bearing allocations and producing a serialization-ready form.
            operand_pool: darray[u32]
            # Jump/branch arguments are separate from instruction operands. Each successor
            # edge owns a slice whose types and arity must match the target block parameters.
            edge_arg_pool: darray[u32]
            block_parameter_pool: mutable darray[Parameter]
            instruction_pool: mutable darray[Instruction]
            blocks: darray[Block]
            entry: u32
            errors: darray[sview] = []


        struct Module:
            name: sview
            functions: mutable darray[Function]
            handlers: mutable darray[Handler] = []
            # Optional interned structural type table. Keeping this at module scope
            # lets all backends share recursive type identity without threading a
            # side table through every instruction helper.
            type_table: mutable TypeTable = TypeTable{rows: [], children: []}


        const enum IssueKind of u8:
            InvalidTypeTable
            MissingEntry
            DuplicateBlock
            UnknownTarget
            DuplicateValue
            UndefinedValue
            NonDominatingValue
            EdgeArgumentArity
            EdgeArgumentType
            MissingEffect
            MissingError
            MissingTraceSite
            DuplicateTraceSite
            InvalidPerform
            InvalidObserve
            InvalidInstruction
            InvalidTerminator
            UnknownHandler
            DuplicateHandler
            UnbalancedHandler
            InvalidResume
            UnsafeMultiShot
            HandlerContract


        struct Issue:
            kind: IssueKind
            function: sview
            block: u32
            value: u32 = 0
            trace: u64 = 0
            message: sview
