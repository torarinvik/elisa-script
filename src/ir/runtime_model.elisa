# Runtime values shared by the reference interpreter, bytecode backends, and
# differential adapters. This file intentionally has no execution dependencies.

extend EsIr:
    public:
        const enum RuntimeValueKind of u8:
            Void
            Bool
            Int
            Float
            Array
            Map
            Text
            ProcessCapture


        struct RuntimeValue:
            text: sview = ""
            process_stdout: sview = ""
            process_stderr: sview = ""
            decimal: f64 = 0.0
            integer: i64 = 0
            process_exit_status: i64 = 0
            array_start: u32 = 0
            array_count: u32 = 0
            map_start: u32 = 0
            map_count: u32 = 0
            kind: RuntimeValueKind
            boolean: bool = false


        struct Observation:
            trace: u64
            value: RuntimeValue


        const enum ExecutionEngine of u8:
            ReferenceInterpreter
            DirectBytecode
            BytecodeInterpreterFallback


        # Ordered observation traces are caller-owned, but an unbounded `observe`
        # loop must not turn that ownership into an implicit memory commitment.
        # Both execution engines enforce this shared default before appending.
        const ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS: usize = 1048576
        # Caller-owned flat runtime values are also bounded independently from
        # the serialized u32 offset domain. This keeps repeated aggregate
        # construction from turning a valid offset space into an unbounded host
        # allocation while preserving the same limit in interpreter and bytecode.
        const ES_RUNTIME_DEFAULT_MAX_STORAGE_VALUES: usize = 1048576
        # Both execution engines still recurse through their host call adapters
        # for ordinary calls. Keep that temporary implementation boundary in one
        # shared contract so interpreter and direct bytecode cannot silently
        # diverge in stack-depth behavior.
        const ES_RUNTIME_DEFAULT_MAX_EXECUTION_CALL_DEPTH: usize = 4096
        # Aggregate equality may revisit shared or cyclic flat storage. Keep
        # recursive comparison bounded identically across interpreter and
        # direct-bytecode engines until a fully iterative comparator is shared.
        const ES_RUNTIME_DEFAULT_MAX_VALUE_EQUAL_DEPTH: usize = 128
        # Error-recovery guards are explicit stack records in both engines.
        # Keep their nesting ceiling separate from call depth but shared across
        # implementations so malformed control flow cannot get a backend-only
        # budget.
        const ES_RUNTIME_DEFAULT_MAX_ERROR_GUARD_DEPTH: usize = 4096
        # Shared host-string ceiling for every POSIX C-string adapter. A
        # terminator must fit below this bound; callers account for it before
        # allocating or crossing the host ABI.
        const ES_RUNTIME_DEFAULT_MAX_CSTRING_BYTES: usize = 67108864

        # A run owns one policy object shared by the interpreter, bytecode
        # facade, and differential adapters.  The fields intentionally cover
        # resources that can otherwise be reset by a nested call or callback;
        # host-specific enforcement remains in the bridge that owns the
        # resource, while admission and telemetry use this common shape.
        const ES_RUNTIME_DEFAULT_MAX_STEPS: u64 = 1000000
        const ES_RUNTIME_DEFAULT_MAX_ELAPSED_MICROS: u64 = 0
        const ES_RUNTIME_DEFAULT_MAX_MEMORY_BYTES: usize = 67108864
        const ES_RUNTIME_DEFAULT_MAX_OPEN_HANDLES: usize = 4096
        const ES_RUNTIME_DEFAULT_MAX_PROCESSES: usize = 1024
        const ES_RUNTIME_DEFAULT_MAX_OUTPUT_BYTES: usize = 67108864
        const ES_RUNTIME_DEFAULT_MAX_REGEX_WORK: u64 = 67108864
        const ES_RUNTIME_DEFAULT_MAX_RETAINED_TRACES: usize = ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS
        const ES_RUNTIME_DEFAULT_MAX_CONCURRENT_TASKS: usize = 1024


        struct RuntimeResourcePolicy:
            steps: u64 = ES_RUNTIME_DEFAULT_MAX_STEPS
            elapsed_micros: u64 = ES_RUNTIME_DEFAULT_MAX_ELAPSED_MICROS
            memory_bytes: usize = ES_RUNTIME_DEFAULT_MAX_MEMORY_BYTES
            open_handles: usize = ES_RUNTIME_DEFAULT_MAX_OPEN_HANDLES
            processes: usize = ES_RUNTIME_DEFAULT_MAX_PROCESSES
            output_bytes: usize = ES_RUNTIME_DEFAULT_MAX_OUTPUT_BYTES
            regex_work: u64 = ES_RUNTIME_DEFAULT_MAX_REGEX_WORK
            retained_traces: usize = ES_RUNTIME_DEFAULT_MAX_RETAINED_TRACES
            concurrent_tasks: usize = ES_RUNTIME_DEFAULT_MAX_CONCURRENT_TASKS


        struct RuntimeResourceUsage:
            steps: u64 = 0
            elapsed_micros: u64 = 0
            memory_bytes: usize = 0
            open_handles: usize = 0
            processes: usize = 0
            output_bytes: usize = 0
            regex_work: u64 = 0
            retained_traces: usize = 0
            concurrent_tasks: usize = 0


        # A zero elapsed-time budget means that no wall-clock source has been
        # attached yet; all other zero budgets are exact zero limits. This
        # keeps the contract explicit while the portable runtime remains
        # independent of a platform timer ABI.
        def runtime_resource_policy_valid(policy: RuntimeResourcePolicy&) -> bool:
            return false if policy.memory_bytes > ES_RUNTIME_DEFAULT_MAX_MEMORY_BYTES
            return false if policy.output_bytes > ES_RUNTIME_DEFAULT_MAX_OUTPUT_BYTES
            return false if policy.retained_traces > ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS
            return true


        def runtime_resource_usage_within_policy(usage: RuntimeResourceUsage&, policy: RuntimeResourcePolicy&) -> bool:
            return false if usage.steps > policy.steps
            return false if usage.elapsed_micros > policy.elapsed_micros and policy.elapsed_micros != 0
            return false if usage.memory_bytes > policy.memory_bytes
            return false if usage.open_handles > policy.open_handles
            return false if usage.processes > policy.processes
            return false if usage.output_bytes > policy.output_bytes
            return false if usage.regex_work > policy.regex_work
            return false if usage.retained_traces > policy.retained_traces
            return false if usage.concurrent_tasks > policy.concurrent_tasks
            return true


        def runtime_resource_policy_with_step_limit(policy: RuntimeResourcePolicy, step_limit: u64) -> RuntimeResourcePolicy:
            result: mutable RuntimeResourcePolicy = policy
            result.steps <- step_limit
            return result


        # Backend-neutral capability telemetry carried with an execution. The
        # bytecode module owns the richer `BytecodeCapabilityReport`; this small
        # snapshot keeps the runtime and differential layers independent of that
        # backend module while preserving the facts needed for parity evidence.
        struct ExecutionCapability:
            direct_supported: bool = false
            function_count: u64 = 0
            instruction_count: u64 = 0
            global_count: u64 = 0


        struct Execution:
            value: RuntimeValue
            steps: u64
            # The policy and accumulated usage are returned with the value so
            # callers cannot mistake a nested/fallback execution for a fresh
            # budget.  Backends may expose additional counters later, but this
            # record is the stable cross-backend minimum.
            policy: RuntimeResourcePolicy = RuntimeResourcePolicy{}
            usage: RuntimeResourceUsage = RuntimeResourceUsage{}
            # The engine identity is part of the observation contract. A
            # bytecode compatibility call may deliberately report fallback
            # rather than making an interpreter run look like VM evidence.
            engine: ExecutionEngine = ExecutionEngine.ReferenceInterpreter
            # `capability_known` is false for execution paths that do not have a
            # backend preflight report (for example, a direct interpreter call).
            # Bytecode entrypoints set it before returning, including fallback.
            capability_known: mutable bool = false
            capability: mutable ExecutionCapability = ExecutionCapability{}


        def runtime_void() -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Void}


        def runtime_bool(value: bool) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Bool, boolean: value}


        def runtime_int(value: i64) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Int, integer: value}


        def runtime_float(value: f64) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Float, decimal: value}


        def runtime_text(value: sview) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Text, text: value}


        def runtime_process_capture(exit_status: i64, stdout: sview, stderr: sview) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.ProcessCapture, process_exit_status: exit_status, process_stdout: stdout, process_stderr: stderr}


        def runtime_array(start: u32, count: u32) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Array, array_start: start, array_count: count}


        def runtime_map(start: u32, count: u32) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Map, map_start: start, map_count: count}


        # Deterministic byte-oriented text ordering shared by direct backends.
        # `sview` deliberately has no locale or Unicode collation semantics;
        # compare unsigned bytes and use the shorter prefix as the tie-breaker.
        def runtime_text_lex_less(left: sview, right: sview) -> bool:
            left_length: usize = sview_len(left)
            right_length: usize = sview_len(right)
            common: usize = left_length if left_length < right_length else right_length
            for offset in 0..<common |left, right|:
                return true if sview_at(left, offset) < sview_at(right, offset)
                return false if sview_at(left, offset) > sview_at(right, offset)
            return left_length < right_length


    public:
        # Runtime snapshots cross interpreter, bytecode, and differential
        # adapter boundaries. Keep the enum admission predicate public so every
        # consumer can reject malformed nested values before a kind-specific
        # match or aggregate index.
        def runtime_value_kind_valid(kind: RuntimeValueKind) -> bool:
            return kind in {RuntimeValueKind.Void, RuntimeValueKind.Bool, RuntimeValueKind.Int, RuntimeValueKind.Float, RuntimeValueKind.Array, RuntimeValueKind.Map, RuntimeValueKind.Text, RuntimeValueKind.ProcessCapture}


    private:
        # Array/map payload offsets are serialized as u32.  A host darray may be
        # wider than that, but a view must still keep every addressed element in
        # the representable offset domain.  Use subtraction and `count - 1` so
        # neither the host usize nor the u32 maximum can wrap during validation.
        const RUNTIME_U32_MAX: usize = 4294967295


        def runtime_u32_array_span_valid(start: usize, count: usize) -> bool:
            return true if count == 0
            return false if start > RUNTIME_U32_MAX
            return count - 1 <= RUNTIME_U32_MAX - start


        def runtime_u32_map_span_valid(start: usize, count: usize) -> bool:
            return true if count == 0
            return false if start >= RUNTIME_U32_MAX
            remaining: usize = RUNTIME_U32_MAX - start
            return count - 1 <= (remaining - 1) / 2


    public:
        # Array payloads live in caller-owned flat storage.  Validate the complete
        # half-open range without evaluating `start + count` first: a malformed
        # externally supplied value must not wrap around the host integer width.
        def runtime_array_range_valid(storage: darray[RuntimeValue]&, value: RuntimeValue) -> bool:
            false return if value.kind != RuntimeValueKind.Array
            false return if storage.count > ES_RUNTIME_DEFAULT_MAX_STORAGE_VALUES
            start: usize = value.array_start.usize()
            false return if start > storage.count
            false return if not runtime_u32_array_span_valid(start, value.array_count.usize())
            return value.array_count.usize() <= storage.count - start


        # Map payloads use caller-owned flat storage as interleaved key/value pairs.
        # Validate the complete pair range without evaluating `count * 2` first so a
        # malformed externally supplied value cannot wrap the host integer width.
        def runtime_map_range_valid(storage: darray[RuntimeValue]&, value: RuntimeValue) -> bool:
            false return if value.kind != RuntimeValueKind.Map
            false return if storage.count > ES_RUNTIME_DEFAULT_MAX_STORAGE_VALUES
            start: usize = value.map_start.usize()
            false return if start > storage.count
            count: usize = value.map_count.usize()
            false return if not runtime_u32_map_span_valid(start, count)
            false return if count > (storage.count - start) / 2
            return true


        # Validate every aggregate value crossing a function/backend boundary
        # before its body can return or index it. Scalar values need no backing
        # storage check; aggregate views must satisfy their complete flat-pool
        # span predicates above. The caller-owned flat pool is checked as well:
        # nested values are addressed directly by later opcodes, so validating
        # only the root argument slice would leave an unknown kind or dangling
        # nested view reachable after admission.
        def runtime_values_ranges_valid(storage: darray[RuntimeValue]&, values: darray[RuntimeValue]&) -> bool:
            return false if storage.count > ES_RUNTIME_DEFAULT_MAX_STORAGE_VALUES
            return false if values.count > ES_RUNTIME_DEFAULT_MAX_STORAGE_VALUES
            for stored in storage:
                false return if not runtime_value_kind_valid(stored.kind)
                false return if stored.kind == RuntimeValueKind.Array and not runtime_array_range_valid(storage, stored)
                false return if stored.kind == RuntimeValueKind.Map and not runtime_map_range_valid(storage, stored)
            for value in values:
                false return if not runtime_value_kind_valid(value.kind)
                false return if value.kind == RuntimeValueKind.Array and not runtime_array_range_valid(storage, value)
                false return if value.kind == RuntimeValueKind.Map and not runtime_map_range_valid(storage, value)
            return true


        # Aggregate constructors append payloads to the caller-owned flat pool
        # and publish the old count as a u32 offset.  Validate the complete
        # append span before narrowing either endpoint; subtraction keeps both
        # the host usize and serialized u32 domains from wrapping.
        def runtime_storage_span_u32_valid(storage: darray[RuntimeValue]&, additional: usize) -> bool:
            return false if storage.count > ES_RUNTIME_DEFAULT_MAX_STORAGE_VALUES or storage.count > RUNTIME_U32_MAX
            return false if additional > ES_RUNTIME_DEFAULT_MAX_STORAGE_VALUES - storage.count
            return additional <= RUNTIME_U32_MAX - storage.count


        # Validate two sequential append segments without first adding their
        # lengths.  This is used by concatenation paths where the second segment
        # may be skipped selectively but must never move the flat-pool cursor
        # outside the serialized u32 domain.
        def runtime_storage_two_spans_u32_valid(storage: darray[RuntimeValue]&, first: usize, second: usize) -> bool:
            return false if not runtime_storage_span_u32_valid(storage, first)
            return second <= ES_RUNTIME_DEFAULT_MAX_STORAGE_VALUES - storage.count - first and second <= RUNTIME_U32_MAX - storage.count - first


        # Text splitting and regex materialization can produce one more field
        # than input bytes (the empty-input field).  Require a spare u32 slot
        # before comparing the host text length, avoiding an explicit `length +
        # 1` that could wrap on a narrow host.
        def runtime_storage_text_fields_u32_valid(storage: darray[RuntimeValue]&, text_length: usize) -> bool:
            return false if storage.count >= ES_RUNTIME_DEFAULT_MAX_STORAGE_VALUES
            return text_length < ES_RUNTIME_DEFAULT_MAX_STORAGE_VALUES - storage.count


        # Map constructors append two runtime values per logical entry.  Keep
        # the pair multiplication out of the predicate so a 32-bit host cannot
        # wrap before the u32 publication bound is checked.
        def runtime_storage_pairs_u32_valid(storage: darray[RuntimeValue]&, pairs: usize) -> bool:
            return false if storage.count > ES_RUNTIME_DEFAULT_MAX_STORAGE_VALUES or storage.count > RUNTIME_U32_MAX
            return false if pairs > (ES_RUNTIME_DEFAULT_MAX_STORAGE_VALUES - storage.count) / 2
            return pairs <= (RUNTIME_U32_MAX - storage.count) / 2


        def runtime_storage_two_pair_spans_u32_valid(storage: darray[RuntimeValue]&, first: usize, second: usize) -> bool:
            return false if not runtime_storage_pairs_u32_valid(storage, first)
            remaining: usize = (ES_RUNTIME_DEFAULT_MAX_STORAGE_VALUES - storage.count) / 2
            return second <= remaining - first and second <= (RUNTIME_U32_MAX - storage.count) / 2 - first
