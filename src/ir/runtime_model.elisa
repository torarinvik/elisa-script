# Runtime values shared by the reference interpreter, bytecode backends, and
# differential adapters. This file intentionally has no execution dependencies.

extend EsIr:
    public:
        const enum RuntimeValueKind of u8:
            Void
            Bool
            Int
            Float
            Array
            Text
            ProcessCapture


        struct RuntimeValue:
            text: sview = ""
            process_stdout: sview = ""
            process_stderr: sview = ""
            decimal: f64 = 0.0
            integer: i64 = 0
            process_exit_status: i64 = 0
            array_start: u32 = 0
            array_count: u32 = 0
            kind: RuntimeValueKind
            boolean: bool = false


        struct Observation:
            trace: u64
            value: RuntimeValue


        struct Execution:
            value: RuntimeValue
            steps: u64


        def runtime_void() -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Void}


        def runtime_bool(value: bool) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Bool, boolean: value}


        def runtime_int(value: i64) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Int, integer: value}


        def runtime_float(value: f64) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Float, decimal: value}


        def runtime_text(value: sview) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Text, text: value}


        def runtime_process_capture(exit_status: i64, stdout: sview, stderr: sview) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.ProcessCapture, process_exit_status: exit_status, process_stdout: stdout, process_stderr: stderr}


        def runtime_array(start: u32, count: u32) -> RuntimeValue:
            return RuntimeValue{kind: RuntimeValueKind.Array, array_start: start, array_count: count}
