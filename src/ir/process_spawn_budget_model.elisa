# Portable launch accounting; no native launch, wait or signal operation.
# These public records are data, not capabilities. The host coordinator must
# retain exclusive access to the same owner, ledger and runtime usage throughout.
include "ir_model.elisa"
include "runtime_model.elisa"
include "../runtime/process_spawn_owner_model.elisa"
include "../runtime/resource_model.elisa"

module EsProcessSpawnBudget:
    public:
        struct Reservation:
            resource_id: u64 = 0
            owner_token: u64 = 0
            held: bool = false


        error BudgetError:
            InvalidReservation
            InvalidPolicy
            InvalidUsage
            ProcessLimit
            Unreaped


        def reserve(child: mutable EsProcessSpawnOwner::Owner&, budget: mutable Reservation&, ledger: mutable EsResource::ResourceLedger&, usage: mutable EsIr::RuntimeResourceUsage&, policy: EsIr::RuntimeResourcePolicy&, id: u64, owner_token: u64) -> void error[BudgetError, EsResource::ResourceContractError] can[Memory.Allocate, Abort.Panic]:
            raise BudgetError.InvalidReservation if budget.held or budget.resource_id != 0 or budget.owner_token != 0
            raise BudgetError.InvalidReservation if child.state != EsProcessSpawnOwner::State.Fresh or child.resource_id != 0 or child.owner_token != 0 or child.pid != 0 or child.diagnostic_pid != 0 or child.code != 0 or child.attempts != 0 or child.saw_denied
            raise BudgetError.InvalidPolicy if not EsIr::runtime_resource_policy_valid(policy)
            raise BudgetError.InvalidUsage if not EsIr::runtime_resource_usage_within_policy(usage, policy)
            raise BudgetError.ProcessLimit if not EsIr::runtime_resource_acquire(usage, policy, EsIr::RuntimeResourceCounter.Process)
            # Retain the acquired counter in caller-held state before any
            # fallible ledger reservation or allocation. Typed failure rolls
            # it back; allocation panic/cancellation still needs a finalizer.
            budget.resource_id <- id
            budget.owner_token <- owner_token
            budget.held <- true
            catch EsResource::resource_ledger_acquire(ledger, id, EsResource::ResourceKind.Process, owner_token):
                ok _:
                    pass
                error failure:
                    raise BudgetError.InvalidUsage if not EsIr::runtime_resource_release(usage, EsIr::RuntimeResourceCounter.Process)
                    budget <- Reservation{}
                    raise failure
            child.resource_id <- id
            child.owner_token <- owner_token
            child.state <- EsProcessSpawnOwner::State.Reserved


        def require_reserved(child: EsProcessSpawnOwner::Owner&, budget: Reservation&, ledger: EsResource::ResourceLedger&, usage: EsIr::RuntimeResourceUsage&, owner_token: u64) -> void error[BudgetError, EsResource::ResourceContractError]:
            try require_held(child, budget, ledger, usage, owner_token)
            raise BudgetError.InvalidReservation if not EsProcessSpawnOwner::can_attempt(child)


        def require_running(child: EsProcessSpawnOwner::Owner&, budget: Reservation&, ledger: EsResource::ResourceLedger&, usage: EsIr::RuntimeResourceUsage&, owner_token: u64) -> void error[BudgetError, EsResource::ResourceContractError]:
            try require_held(child, budget, ledger, usage, owner_token)
            raise BudgetError.InvalidReservation if child.state != EsProcessSpawnOwner::State.Running or child.pid <= 1 or child.code != 0 or child.diagnostic_pid != child.pid or child.attempts == 0 or child.attempts > EsProcessSpawnOwner::Limits::ATTEMPTS


        def release_no_child(child: EsProcessSpawnOwner::Owner&, budget: mutable Reservation&, ledger: mutable EsResource::ResourceLedger&, usage: mutable EsIr::RuntimeResourceUsage&, owner_token: u64) -> void error[BudgetError, EsResource::ResourceContractError]:
            raise BudgetError.InvalidReservation if not EsProcessSpawnOwner::can_release_without_wait(child)
            try release_held(child, budget, ledger, usage, owner_token)


        def require_released_no_child(child: EsProcessSpawnOwner::Owner&, budget: Reservation&, ledger: EsResource::ResourceLedger&, owner_token: u64) -> void error[BudgetError, EsResource::ResourceContractError]:
            raise BudgetError.InvalidReservation if not EsProcessSpawnOwner::can_release_without_wait(child) or child.diagnostic_pid != 0 or budget.held
            raise BudgetError.InvalidReservation if owner_token == 0 or budget.owner_token != owner_token or child.owner_token != owner_token or budget.resource_id == 0 or child.resource_id != budget.resource_id
            lease: EsResource::ResourceLease = try EsResource::resource_lease_for_owner(ledger, budget.resource_id, owner_token)
            raise BudgetError.InvalidReservation if lease.kind != EsResource::ResourceKind.Process or lease.state != EsResource::ResourceLeaseState.Released


        def release_unstarted(child: mutable EsProcessSpawnOwner::Owner&, budget: mutable Reservation&, ledger: mutable EsResource::ResourceLedger&, usage: mutable EsIr::RuntimeResourceUsage&, owner_token: u64) -> void error[BudgetError, EsResource::ResourceContractError]:
            try require_reserved(child, budget, ledger, usage, owner_token)
            raise BudgetError.InvalidReservation if child.attempts != 0 or child.diagnostic_pid != 0 or child.code != 0 or child.saw_denied
            child.state <- EsProcessSpawnOwner::State.NoChild
            try release_held(child, budget, ledger, usage, owner_token)


        def release_reaped(child: EsProcessSpawnOwner::Owner&, budget: mutable Reservation&, ledger: mutable EsResource::ResourceLedger&, usage: mutable EsIr::RuntimeResourceUsage&, owner_token: u64) -> void error[BudgetError, EsResource::ResourceContractError]:
            raise BudgetError.Unreaped if child.state != EsProcessSpawnOwner::State.Reaped or child.pid <= 1
            try release_held(child, budget, ledger, usage, owner_token)

    private:
        def require_held(child: EsProcessSpawnOwner::Owner&, budget: Reservation&, ledger: EsResource::ResourceLedger&, usage: EsIr::RuntimeResourceUsage&, owner_token: u64) -> void error[BudgetError, EsResource::ResourceContractError]:
            raise BudgetError.InvalidReservation if not budget.held or owner_token == 0 or budget.owner_token != owner_token or child.owner_token != owner_token or budget.resource_id == 0 or child.resource_id != budget.resource_id
            raise BudgetError.InvalidUsage if usage.processes == 0
            lease: EsResource::ResourceLease = try EsResource::resource_lease_for_owner(ledger, budget.resource_id, owner_token)
            raise BudgetError.InvalidReservation if lease.kind != EsResource::ResourceKind.Process or lease.state != EsResource::ResourceLeaseState.Acquired


        def release_held(child: EsProcessSpawnOwner::Owner&, budget: mutable Reservation&, ledger: mutable EsResource::ResourceLedger&, usage: mutable EsIr::RuntimeResourceUsage&, owner_token: u64) -> void error[BudgetError, EsResource::ResourceContractError]:
            try require_held(child, budget, ledger, usage, owner_token)
            _ = try EsResource::advance_resource_lease(ledger, budget.resource_id, owner_token, EsResource::ResourceEvent.BeginClose)
            _ = try EsResource::advance_resource_lease(ledger, budget.resource_id, owner_token, EsResource::ResourceEvent.CompleteClose)
            raise BudgetError.InvalidUsage if not EsIr::runtime_resource_release(usage, EsIr::RuntimeResourceCounter.Process)
            budget.held <- false
