                            return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                        zero: LoweredValue = emit_constant(state, operand.type, 0, "", "", false, ir_span(pos))
                        negative: LoweredValue = emit_comparison(state, Opcode.Less, operand.value, zero.value, pos)
                        selected_block: u32 = fresh_block(state)
                        alternative_block: u32 = fresh_block(state)
                        merge_block: u32 = fresh_block(state)
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: negative.value, operand_count: 1, target0: selected_block, target1: alternative_block, target_count: 2, span: ir_span(pos)}
                        finish_block(state)

                        state.current_block <- selected_block
                        state.terminated <- false
                        negated: u32 = fresh_value(state)
                        negate_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(operand.value)
                        state.instructions.push(Instruction{opcode: Opcode.Negate, result: negated, result_type: operand.type, operand_start: negate_start, operand_count: 1, span: ir_span(pos)})
                        selected_edge_start: u32 = state.edge_arg_pool.count.u32()
                        state.edge_arg_pool.push(negated)
                        state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: selected_edge_start, edge0_arg_count: 1, span: ir_span(pos)}
                        finish_block(state)

                        state.current_block <- alternative_block
                        state.terminated <- false
                        alternative_edge_start: u32 = state.edge_arg_pool.count.u32()
                        state.edge_arg_pool.push(operand.value)
                        state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: alternative_edge_start, edge0_arg_count: 1, span: ir_span(pos)}
                        finish_block(state)

                        result: u32 = fresh_value(state)
                        state.pending_parameter_blocks.push(merge_block)
                        state.pending_parameters.push(Parameter{value: result, type: operand.type, name: "abs"})
                        state.current_block <- merge_block
                        state.terminated <- false
                        return LoweredValue{valid: true, value: result, type: operand.type}
                    if callee_name == "sorted" and callee_index == state.function_names.count:
                        result_type: mutable Type = unknown_ir_type()
                        valid_shape: mutable bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
                        if arguments.count == 2:
                            valid_shape <- argument_names.count == 2 and argument_names[0] == "" and (argument_names[1] == "" or argument_names[1] == "reverse")
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "sorted requires an array and an optional reverse bool")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        collection: LoweredValue = lower_expression(arguments[0], state)
                        if not collection.valid or collection.type.kind != TypeKind.Array:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "sorted requires an array value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        result_type <- collection.type
                        element_type: Type = array_element_type(collection.type)
                        if element_type.kind not in {TypeKind.Bool, TypeKind.Int, TypeKind.Float, TypeKind.Char, TypeKind.Text}:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "sorted requires an array of bool, integer, float, char, or text values")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        reverse_value: mutable LoweredValue = LoweredValue{valid: true, value: 0, type: type_from_name("bool")}
                        if arguments.count == 2:
                            bool_type: Type = type_from_name("bool")
                            reverse_value <- lower_expression_expected(arguments[1], bool_type, state)
                            if not reverse_value.valid or reverse_value.type.kind != TypeKind.Bool:
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "sorted reverse argument must be bool")
                                return LoweredValue{valid: false, value: 0, type: result_type}
                        result: u32 = fresh_value(state)
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(collection.value)
                        state.instructions.push(Instruction{opcode: Opcode.SortArray, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                        if arguments.count == 2:
                            match arguments[1]:
                                Expr.BoolLit(value):
                                    if value:
                                        reversed_result: u32 = fresh_value(state)
                                        reversed_start: u32 = state.operand_pool.count.u32()
                                        state.operand_pool.push(result)
                                        state.instructions.push(Instruction{opcode: Opcode.ReverseArray, result: reversed_result, result_type: result_type, operand_start: reversed_start, operand_count: 1, span: ir_span(pos)})
                                        return LoweredValue{valid: true, value: reversed_result, type: result_type}
                                _:
                                    pass
                            if arguments[1] is not Expr.BoolLit:
                                selected_block: u32 = fresh_block(state)
                                alternative_block: u32 = fresh_block(state)
                                merge_block: u32 = fresh_block(state)
                                state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: reverse_value.value, operand_count: 1, target0: selected_block, target1: alternative_block, target_count: 2, span: ir_span(pos)}
                                finish_block(state)

                                state.current_block <- selected_block
                                state.terminated <- false
                                reversed_result: u32 = fresh_value(state)
                                reversed_start: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(result)
                                state.instructions.push(Instruction{opcode: Opcode.ReverseArray, result: reversed_result, result_type: result_type, operand_start: reversed_start, operand_count: 1, span: ir_span(pos)})
                                selected_edge_start: u32 = state.edge_arg_pool.count.u32()
                                state.edge_arg_pool.push(reversed_result)
                                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: selected_edge_start, edge0_arg_count: 1, span: ir_span(pos)}
                                finish_block(state)

                                state.current_block <- alternative_block
                                state.terminated <- false
                                alternative_edge_start: u32 = state.edge_arg_pool.count.u32()
                                state.edge_arg_pool.push(result)
                                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: alternative_edge_start, edge0_arg_count: 1, span: ir_span(pos)}
                                finish_block(state)

                                merged_result: u32 = fresh_value(state)
                                state.pending_parameter_blocks.push(merge_block)
                                state.pending_parameters.push(Parameter{value: merged_result, type: result_type, name: "sorted"})
                                state.current_block <- merge_block
                                state.terminated <- false
                                return LoweredValue{valid: true, value: merged_result, type: result_type}
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_name == "reversed" and callee_index == state.function_names.count:
                        result_type: mutable Type = unknown_ir_type()
                        valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "reversed requires exactly one positional array value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        collection: LoweredValue = lower_expression(arguments[0], state)
                        if not collection.valid or collection.type.kind != TypeKind.Array:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "reversed requires an array value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        result_type <- collection.type
                        result: u32 = fresh_value(state)
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(collection.value)
                        state.instructions.push(Instruction{opcode: Opcode.ReverseArray, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if (callee_name == "min" or callee_name == "max") and callee_index == state.function_names.count:
                        result_type: mutable Type = unknown_ir_type()
                        valid_shape: mutable bool = arguments.count > 0
                        if argument_names.count != 0:
                            valid_shape <- argument_names.count == arguments.count
                            for argument_name in argument_names |valid_shape|:
                                valid_shape <- false if argument_name != ""
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "min/max requires one array value or at least two positional orderable values")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        collection: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                        collection_type: mutable Type = unknown_ir_type()
                        if arguments.count == 1:
                            collection <- lower_expression(arguments[0], state)
                            if not collection.valid or collection.type.kind != TypeKind.Array:
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "min/max requires an array value when called with one argument")
                                return LoweredValue{valid: false, value: 0, type: result_type}
                            collection_type <- collection.type
                            result_type <- array_element_type(collection.type)
                        else:
                            first: LoweredValue = lower_expression(arguments[0], state)
                            if not first.valid:
                                return LoweredValue{valid: false, value: 0, type: result_type}
                            result_type <- first.type
                            operands: mutable darray[u32] = [first.value]
                            for offset in 1..<arguments.count |arguments, state, result_type, operands|:
                                value: LoweredValue = lower_expression_expected(arguments[offset], result_type, state)
                                if not value.valid:
                                    return LoweredValue{valid: false, value: 0, type: result_type}
                                if not same_type(value.type, result_type):
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "min/max values must have one exact static type")
                                    return LoweredValue{valid: false, value: 0, type: result_type}
                                operands.push(value.value)
                            collection_type <- array_ir_type(result_type)
                            collection_value: u32 = fresh_value(state)
                            collection_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.extend(operands)
                            state.instructions.push(Instruction{opcode: Opcode.MakeArray, result: collection_value, result_type: collection_type, operand_start: collection_start, operand_count: operands.count.u16(), span: ir_span(pos)})
                            collection <- LoweredValue{valid: true, value: collection_value, type: collection_type}
                        if result_type.kind not in {TypeKind.Bool, TypeKind.Int, TypeKind.Float, TypeKind.Char, TypeKind.Text}:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "min/max requires an array of bool, integer, float, char, or text values")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        ordered: u32 = fresh_value(state)
                        sort_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(collection.value)
                        state.instructions.push(Instruction{opcode: Opcode.SortArray, result: ordered, result_type: collection.type, operand_start: sort_start, operand_count: 1, span: ir_span(pos)})
                        index: LoweredValue = emit_constant(state, type_from_name("i64"), -1 if callee_name == "max" else 0, "", "", false, ir_span(pos))
                        result: u32 = fresh_value(state)
                        index_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(ordered)
                        state.operand_pool.push(index.value)
                        state.instructions.push(Instruction{opcode: Opcode.Index, result: result, result_type: result_type, operand_start: index_start, operand_count: 2, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if (callee_name == "sum" or callee_name == "product") and callee_index == state.function_names.count:
                        valid_shape: mutable bool = arguments.count == 1 or arguments.count == 2
                        if argument_names.count != 0:
                            valid_shape <- argument_names.count == arguments.count
                            for offset in 0..<argument_names.count |argument_names, valid_shape|:
                                valid_shape <- false if argument_names[offset] != "" and not (offset == 1 and argument_names[offset] == "start")
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "sum/product requires one array, text, or integer-range value and an optional typed start")
                            return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                        return lower_integer_fold_comprehension(callee_name, "__value", arguments[0], Expr.Absent, Expr.Absent, pos, state, arguments[1] if arguments.count == 2 else Expr.Absent)
                    if (callee_name == "any" or callee_name == "all") and callee_index == state.function_names.count:
                        valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "any/all requires exactly one positional array or integer-range value")
                            return LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
                        return lower_query_comprehension("__value", arguments[0], Expr.Absent, Expr.Absent, pos, state, callee_name)
                    if (callee_name == "starts_with" or callee_name == "startswith") and callee_index == state.function_names.count:
                        result_type: Type = type_from_name("bool")
                        valid_shape: bool = arguments.count == 2 and (argument_names.count == 0 or (argument_names.count == 2 and argument_names[0] == "" and argument_names[1] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "starts_with requires text and prefix positional values")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        text_value: LoweredValue = lower_expression(arguments[0], state)
                        prefix_value: LoweredValue = lower_expression(arguments[1], state)
                        valid_types: bool = text_value.valid and prefix_value.valid and text_value.type.kind == TypeKind.Text and prefix_value.type.kind == TypeKind.Text
                        if not valid_types:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "starts_with requires two sview text values")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(text_value.value)
                        state.operand_pool.push(prefix_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.StartsWith, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if (callee_name == "ends_with" or callee_name == "endswith") and callee_index == state.function_names.count:
                        result_type: Type = type_from_name("bool")
                        valid_shape: bool = arguments.count == 2 and (argument_names.count == 0 or (argument_names.count == 2 and argument_names[0] == "" and argument_names[1] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "ends_with requires text and suffix positional values")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        text_value: LoweredValue = lower_expression(arguments[0], state)
                        suffix_value: LoweredValue = lower_expression(arguments[1], state)
                        valid_types: bool = text_value.valid and suffix_value.valid and text_value.type.kind == TypeKind.Text and suffix_value.type.kind == TypeKind.Text
                        if not valid_types:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "ends_with requires two sview text values")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(text_value.value)
                        state.operand_pool.push(suffix_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.EndsWith, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_name == "replace" and callee_index == state.function_names.count:
                        result_type: Type = type_from_name("sview")
                        valid_shape: bool = arguments.count == 3 and (argument_names.count == 0 or (argument_names.count == 3 and argument_names[0] == "" and argument_names[1] == "" and argument_names[2] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "replace requires text, old text, and replacement positional values")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        text_value: LoweredValue = lower_expression(arguments[0], state)
                        old_value: LoweredValue = lower_expression(arguments[1], state)
                        replacement_value: LoweredValue = lower_expression(arguments[2], state)
                        valid_types: bool = text_value.valid and old_value.valid and replacement_value.valid and text_value.type.kind == TypeKind.Text and old_value.type.kind == TypeKind.Text and replacement_value.type.kind == TypeKind.Text
                        if not valid_types:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "replace requires three sview text values")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(text_value.value)
                        state.operand_pool.push(old_value.value)
                        state.operand_pool.push(replacement_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.TextReplace, result: result, result_type: result_type, operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if (callee_name == "partition" or callee_name == "rpartition") and callee_index == state.function_names.count:
                        return lower_text_partition_builtin(arguments, argument_names, pos, state, callee_name == "rpartition")
                    if (callee_name == "strip" or callee_name == "trim") and callee_index == state.function_names.count:
                        result_type: Type = type_from_name("sview")
                        valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "strip/trim requires one positional text value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        text_value: LoweredValue = lower_expression(arguments[0], state)
                        if not text_value.valid or text_value.type.kind != TypeKind.Text:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "strip/trim requires an sview text value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(text_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.TrimText, result: result, result_type: result_type, integer: 0, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if (callee_name == "lower" or callee_name == "upper" or callee_name == "casefold") and callee_index == state.function_names.count:
                        result_type: Type = type_from_name("sview")
                        valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "lower/upper/casefold requires one positional text value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        text_value: LoweredValue = lower_expression(arguments[0], state)
                        if not text_value.valid or text_value.type.kind != TypeKind.Text:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "lower/upper/casefold requires an sview text value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        return lower_text_case_value(text_value.value, callee_name == "upper", pos, state)
                    if callee_name == "__fstr" and callee_index == state.function_names.count:
                        return lower_fstring(arguments, argument_names, pos, state)
                    if callee_name == "matches" and callee_index == state.function_names.count:
                        valid_shape: bool = arguments.count == 2 and (argument_names.count == 0 or (argument_names[0] == "" and argument_names[1] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "matches requires text and one positional Regex value")
                            return LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
                        text_value: LoweredValue = lower_expression(arguments[0], state)
                        pattern_value: LoweredValue = lower_expression(arguments[1], state)
                        valid_types: bool = text_value.valid and pattern_value.valid and text_value.type.kind == TypeKind.Text and pattern_value.type.kind == TypeKind.Named and pattern_value.type.name == "Regex"
                        if not valid_types:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "matches requires an sview haystack and Regex pattern")
                            return LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(text_value.value)
                        state.operand_pool.push(pattern_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.RegexSearch, result: result, result_type: type_from_name("bool"), operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: type_from_name("bool")}
                    if callee_name == "replace_regex" and callee_index == state.function_names.count:
                        result_type: Type = type_from_name("sview")
                        valid_shape: bool = arguments.count == 3 and (argument_names.count == 0 or (argument_names[0] == "" and argument_names[1] == "" and argument_names[2] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "replace_regex requires text, Regex, and replacement text values")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        text_value: LoweredValue = lower_expression(arguments[0], state)
                        pattern_value: LoweredValue = lower_expression(arguments[1], state)
                        replacement_value: LoweredValue = lower_expression(arguments[2], state)
                        valid_text: bool = text_value.valid and text_value.type.kind == TypeKind.Text
                        valid_pattern: bool = pattern_value.valid and pattern_value.type.kind == TypeKind.Named and pattern_value.type.name == "Regex"
                        valid_replacement: bool = replacement_value.valid and replacement_value.type.kind == TypeKind.Text
                        if not valid_text or not valid_pattern or not valid_replacement:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "replace_regex requires sview text, Regex pattern, and sview replacement")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(text_value.value)
                        state.operand_pool.push(pattern_value.value)
                        state.operand_pool.push(replacement_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.RegexReplace, result: result, result_type: result_type, operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_name == "split_regex" and callee_index == state.function_names.count:
                        result_type: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Text}
                        valid_shape: bool = arguments.count == 2 and (argument_names.count == 0 or (argument_names[0] == "" and argument_names[1] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "split_regex requires text and one positional Regex value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        text_value: LoweredValue = lower_expression(arguments[0], state)
                        pattern_value: LoweredValue = lower_expression(arguments[1], state)
                        valid_types: bool = text_value.valid and pattern_value.valid and text_value.type.kind == TypeKind.Text and pattern_value.type.kind == TypeKind.Named and pattern_value.type.name == "Regex"
                        if not valid_types:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "split_regex requires sview text and Regex pattern operands")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(text_value.value)
