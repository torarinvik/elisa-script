            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "strip/trim/lstrip/rstrip method requires no arguments")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            if not text_value.valid or text_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "strip/trim method requires a text receiver")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.TrimText if method_spec.opcode == "TrimText" else Opcode.TrimText
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, integer: method_spec.lowering_mode, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_trim_method(receiver_name: sview, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            receiver_pos: Ast::Pos = Ast::Pos{line: pos.line, column: pos.column, offset: pos.offset, end_line: pos.end_line, end_column: pos.end_column, end_offset: pos.end_offset}
            return lower_text_trim_expression(Expr.Ident(receiver_name, receiver_pos), method_name, arguments, argument_names, pos, state)


        def lower_text_split_expression(receiver_expression: Ast::Expr, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method_name)
            result_type: Type = typed_builtin_result_type(method_spec)
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: result_type}
            valid_shape: bool = method_spec.known and method_spec.opcode == "Split" and typed_builtin_method_call_shape("Text", method_name, arguments, argument_names)
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "split method requires an optional separator and i64 maxsplit")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            if not text_value.valid or text_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "split method requires a text receiver")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            mode: i64 = 1 if arguments.count == 0 else method_spec.lowering_mode
            if arguments.count >= 1:
                separator_value: LoweredValue = lower_expression(arguments[0], state)
                if not separator_value.valid or separator_value.type.kind != TypeKind.Text:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "split method separator must be text")
                    return invalid
                state.operand_pool.push(separator_value.value)
            if arguments.count == 2:
                maxsplit_type: Type = type_from_name("i64")
                maxsplit_value: LoweredValue = lower_expression_expected(arguments[1], maxsplit_type, state)
                if not maxsplit_value.valid or not same_type(maxsplit_value.type, maxsplit_type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "split method maxsplit must be a signed i64 value")
                    return invalid
                state.operand_pool.push(maxsplit_value.value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.Split if method_spec.opcode == "Split" else Opcode.Split
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, integer: mode, operand_start: operand_start, operand_count: 1 if arguments.count == 0 else (2 if arguments.count == 1 else 3), span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_split_method(receiver_name: sview, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            receiver_pos: Ast::Pos = Ast::Pos{line: pos.line, column: pos.column, offset: pos.offset, end_line: pos.end_line, end_column: pos.end_column, end_offset: pos.end_offset}
            return lower_text_split_expression(Expr.Ident(receiver_name, receiver_pos), method_name, arguments, argument_names, pos, state)


        def lower_text_rsplit_method(receiver_name: sview, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            receiver_pos: Ast::Pos = Ast::Pos{line: pos.line, column: pos.column, offset: pos.offset, end_line: pos.end_line, end_column: pos.end_column, end_offset: pos.end_offset}
            return lower_text_split_expression(Expr.Ident(receiver_name, receiver_pos), method_name, arguments, argument_names, pos, state)


        def lower_text_rsplit_expression(receiver_expression: Ast::Expr, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            return lower_text_split_expression(receiver_expression, method_name, arguments, argument_names, pos, state)


        # Lower Python's typed dictionary `mapping.keys()` view as the existing
        # insertion-ordered MapKeys array operation.  The receiver is evaluated
        # once, and sets are rejected even though they share the map payload
        # representation internally.
        def lower_map_keys_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            if arguments.count != 0 or argument_names.count != 0:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "keys method requires no arguments")
                return invalid
            collection: LoweredValue = lower_expression(receiver_expression, state)
            if not collection.valid or collection.type.kind != TypeKind.Map or collection.type.name == "__elisascript_set":
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "keys method requires a dictionary receiver")
                return invalid
            key_type: Type = map_key_type(collection.type)
            result_type: Type = array_ir_type(key_type)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.MapKeys, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Lower Python's typed dictionary `mapping.values()` view as an owned
        # insertion-ordered array through the dedicated MapValues operation.
        # The full value descriptor is retained, including bounded nested maps
        # and arrays, so no element type is erased at the scripting boundary.
        def lower_map_values_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            if arguments.count != 0 or argument_names.count != 0:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "values method requires no arguments")
                return invalid
            collection: LoweredValue = lower_expression(receiver_expression, state)
            if not collection.valid or collection.type.kind != TypeKind.Map or collection.type.name == "__elisascript_set":
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "values method requires a dictionary receiver")
                return invalid
            value_type: mutable Type = map_value_type(collection.type)
            result_type: Type = array_ir_type(value_type)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.MapValues, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Lower Python's `text.count(substring)` as a typed non-overlapping
        # occurrence count. Empty substrings count boundaries, matching the
        # familiar Python rule while keeping the result in the exact `usize`
        # collection-count domain used by Elisascript queries.
        def lower_collection_count_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            collection: LoweredValue = lower_expression(receiver_expression, state)
            if not collection.valid or collection.type.kind != TypeKind.Text and collection.type.kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "count method requires a text or array receiver")
                return LoweredValue{valid: false, value: 0, type: type_from_name("usize")}
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Array", "count") if collection.type.kind == TypeKind.Array else EsBuiltin::typed_builtin_method_spec("Text", "count")
            result_type: Type = typed_builtin_result_type(method_spec)
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: result_type}
            text_count_shape: bool = method_spec.known and method_spec.opcode == "TextCount" and typed_builtin_method_call_shape("Text", "count", arguments, argument_names)
            array_count_shape: bool = method_spec.known and method_spec.opcode == "ArrayCount" and typed_builtin_method_call_shape("Array", "count", arguments, argument_names)
            valid_shape: bool = text_count_shape or array_count_shape
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "count method requires one positional value")
                return invalid
            element_type: Type = type_from_name("sview") if collection.type.kind == TypeKind.Text else array_element_type(collection.type)
            needle: LoweredValue = lower_expression_expected(arguments[0], element_type, state)
            if not needle.valid or not same_type(needle.type, element_type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "count value must match the receiver element type")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            state.operand_pool.push(needle.value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.TextCount if method_spec.opcode == "TextCount" else Opcode.ArrayCount
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Lower the zero-length predicate shared by global `is_empty(value)` and
        # Python-shaped `value.is_empty()`/`value.isempty()` calls.  Length is
        # already defined for all three collection families, so no new runtime
        # opcode or implicit truthiness conversion is required.
        def lower_collection_is_empty_expression(receiver_expression: Ast::Expr, spec: EsBuiltin::BuiltinSpec, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = typed_builtin_result_type(spec) if spec.known else type_from_name("bool")
            if not spec.known or spec.opcode != "Equal" or spec.lowering_steps != "Length,Equal":
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "is_empty registry row has no Length,Equal lowering sequence")
                return LoweredValue{valid: false, value: 0, type: result_type}
            collection: LoweredValue = lower_expression(receiver_expression, state)
            if not collection.valid or collection.type.kind not in {TypeKind.Array, TypeKind.Map, TypeKind.Text}:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "is_empty requires an array, dictionary, or text value")
                return LoweredValue{valid: false, value: 0, type: result_type}
            length_type: Type = type_from_name("usize")
            length_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            length_value: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.Length, result: length_value, result_type: length_type, operand_start: length_start, operand_count: 1, span: ir_span(pos)})
            zero: LoweredValue = emit_constant(state, length_type, 0, "", "", false, ir_span(pos))
            return emit_comparison(state, Opcode.Equal, length_value, zero.value, pos)


        def lower_collection_nonempty_expression(receiver_expression: Ast::Expr, spec: EsBuiltin::BuiltinSpec, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = typed_builtin_result_type(spec) if spec.known else type_from_name("bool")
            if not spec.known or (spec.opcode != "Greater" and spec.opcode != "FileSize"):
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "is_nonempty registry row has no supported comparison opcode")
                return LoweredValue{valid: false, value: 0, type: result_type}
            collection: LoweredValue = lower_expression(receiver_expression, state)
            if collection.valid and collection.type.kind == TypeKind.Named and collection.type.name == "Path":
                state.required_effects.push("File.Read") if not has_text(state.required_effects, "File.Read")
                state.required_errors.push("FileIoError") if not has_text(state.required_errors, "FileIoError")
                size_result: u32 = fresh_value(state)
                size_operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(collection.value)
                state.instructions.push(Instruction{opcode: Opcode.FileSize, result: size_result, result_type: type_from_name("usize"), operand_start: size_operand_start, operand_count: 1, span: ir_span(pos)})
                zero_value: LoweredValue = emit_constant(state, type_from_name("usize"), 0, "", "", false, ir_span(pos))
                return emit_comparison(state, Opcode.Greater, size_result, zero_value.value, pos)
            if not collection.valid or collection.type.kind not in {TypeKind.Array, TypeKind.Map, TypeKind.Text}:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "is_nonempty requires an array, dictionary, text, or Path value")
                return LoweredValue{valid: false, value: 0, type: result_type}
            length_type: Type = type_from_name("usize")
            length_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            length_value: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.Length, result: length_value, result_type: length_type, operand_start: length_start, operand_count: 1, span: ir_span(pos)})
            zero: LoweredValue = emit_constant(state, length_type, 0, "", "", false, ir_span(pos))
            return emit_comparison(state, Opcode.Greater, length_value, zero.value, pos)


        def lower_text_count_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("usize")}
            valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text count method requires one positional substring")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            needle_value: LoweredValue = lower_expression(arguments[0], state)
            if not text_value.valid or not needle_value.valid or text_value.type.kind != TypeKind.Text or needle_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text count method requires text receiver and substring")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            state.operand_pool.push(needle_value.value)
            result: u32 = fresh_value(state)
            result_type: Type = type_from_name("usize")
            state.instructions.push(Instruction{opcode: Opcode.TextCount, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Lower Python's `text.find(substring)` and `array.find(element)` with an
        # explicit signed `i64` result. A miss is represented by -1, matching the
        # scripting search contract. Checked `.index`/`.rindex` use the companion
        # operation below and report a typed bounds error on a miss.
        def lower_collection_find_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&, array_only: bool) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            collection: LoweredValue = lower_expression(receiver_expression, state)
            if not collection.valid or collection.type.kind != TypeKind.Text and collection.type.kind != TypeKind.Array or array_only and collection.type.kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "find requires a text or array receiver; index requires an array receiver")
                return LoweredValue{valid: false, value: 0, type: type_from_name("i64")}
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Array", "find") if collection.type.kind == TypeKind.Array else EsBuiltin::typed_builtin_method_spec("Text", "find")
            result_type: Type = typed_builtin_result_type(method_spec)
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: result_type}
            text_find_shape: bool = method_spec.known and method_spec.opcode == "TextFind" and typed_builtin_method_call_shape("Text", "find", arguments, argument_names)
            array_find_shape: bool = method_spec.known and method_spec.opcode == "ArrayFind" and typed_builtin_method_call_shape("Array", "find", arguments, argument_names)
            valid_shape: bool = text_find_shape or array_find_shape
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "find/index method requires one positional value")
                return invalid
            element_type: Type = type_from_name("sview") if collection.type.kind == TypeKind.Text else array_element_type(collection.type)
            needle: LoweredValue = lower_expression_expected(arguments[0], element_type, state)
            if not needle.valid or not same_type(needle.type, element_type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "find/index value must match the receiver element type")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            state.operand_pool.push(needle.value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.TextFind if method_spec.opcode == "TextFind" else Opcode.ArrayFind
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Lower Python's `text.index(substring)` and `text.rindex(substring)`.
        # Unlike `find`/`rfind`, a missing substring is an IndexError-style
        # effect at runtime. Array `.index` keeps the existing first-match
        # search contract for compatibility with the scripting profile.
        def lower_collection_index_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&, method_name: sview) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            collection: LoweredValue = lower_expression(receiver_expression, state)
            if not collection.valid or collection.type.kind != TypeKind.Text and collection.type.kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "index/rindex requires a text or array receiver")
                return LoweredValue{valid: false, value: 0, type: type_from_name("i64")}
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Array", method_name) if collection.type.kind == TypeKind.Array else EsBuiltin::typed_builtin_method_spec("Text", method_name)
            result_type: Type = typed_builtin_result_type(method_spec)
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: result_type}
            text_index_shape: bool = method_spec.known and (method_spec.opcode == "TextIndex" or method_spec.opcode == "TextRIndex") and typed_builtin_method_call_shape("Text", method_name, arguments, argument_names)
            array_index_shape: bool = method_spec.known and method_spec.opcode == "ArrayIndex" and typed_builtin_method_call_shape("Array", method_name, arguments, argument_names)
            valid_shape: bool = (collection.type.kind == TypeKind.Array and array_index_shape) or (collection.type.kind == TypeKind.Text and text_index_shape)
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "index/rindex method requires one positional value")
                return invalid
            if method_spec.opcode == "TextRIndex" and collection.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "rindex requires a text receiver")
                return invalid
            element_type: Type = type_from_name("sview") if collection.type.kind == TypeKind.Text else array_element_type(collection.type)
            needle: LoweredValue = lower_expression_expected(arguments[0], element_type, state)
            if not needle.valid or not same_type(needle.type, element_type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "index/rindex value must match the receiver element type")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            state.operand_pool.push(needle.value)
            result: u32 = fresh_value(state)
            opcode: mutable Opcode = Opcode.ArrayIndex
            record_builtin_contract(method_spec, state) if method_spec.known
            state.required_errors.push("IndexOutOfBounds") if not method_spec.known and not has_text(state.required_errors, "IndexOutOfBounds")
            if collection.type.kind == TypeKind.Text:
                opcode <- Opcode.TextRIndex if method_spec.opcode == "TextRIndex" else Opcode.TextIndex
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_find_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("i64")}
            valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text find method requires one positional substring")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            needle_value: LoweredValue = lower_expression(arguments[0], state)
            if not text_value.valid or not needle_value.valid or text_value.type.kind != TypeKind.Text or needle_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text find method requires text receiver and substring")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            state.operand_pool.push(needle_value.value)
            result: u32 = fresh_value(state)
            result_type: Type = type_from_name("i64")
            state.instructions.push(Instruction{opcode: Opcode.TextFind, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_rfind_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&, method_name: sview) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method_name)
            result_type: Type = typed_builtin_result_type(method_spec)
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: result_type}
            valid_shape: bool = method_spec.known and method_spec.opcode == "TextRFind" and typed_builtin_method_call_shape("Text", method_name, arguments, argument_names)
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text rfind method requires one positional substring")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            needle_value: LoweredValue = lower_expression(arguments[0], state)
            if not text_value.valid or not needle_value.valid or text_value.type.kind != TypeKind.Text or needle_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text rfind method requires text receiver and substring")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            state.operand_pool.push(needle_value.value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.TextRFind if method_spec.opcode == "TextRFind" else Opcode.TextRFind
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Lower Python's `text.partition(separator)` and `text.rpartition`
        # methods.  The fixed three-field array is intentionally ordinary
        # darray[sview] so existing Elisa destructuring can consume it without
        # introducing a tuple runtime representation.
        def lower_text_partition_expression(receiver_expression: Ast::Expr, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method_name)
            result_type: Type = typed_builtin_result_type(method_spec)
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: result_type}
            valid_shape: bool = method_spec.known and method_spec.opcode == "TextPartition" and arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text partition method requires one positional separator")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            separator_value: LoweredValue = lower_expression(arguments[0], state)
            if not text_value.valid or not separator_value.valid or text_value.type.kind != TypeKind.Text or separator_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text partition method requires text receiver and separator")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            state.operand_pool.push(separator_value.value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.TextPartition if method_spec.opcode == "TextPartition" else Opcode.TextPartition
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, integer: method_spec.lowering_mode, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_partition_builtin(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, spec: EsBuiltin::BuiltinSpec, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = typed_builtin_result_type(spec)
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: result_type}
            valid_shape: bool = spec.opcode == "TextPartition" and typed_builtin_call_shape(spec.name, arguments, argument_names)
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "partition requires text and one positional separator")
                return invalid
            text_value: LoweredValue = lower_expression(arguments[0], state)
            separator_value: LoweredValue = lower_expression(arguments[1], state)
