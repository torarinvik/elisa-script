            pattern_value: LoweredValue = lower_expression(receiver_expression, state)
            text_value: LoweredValue = lower_expression(arguments[0], state)
            valid_types: bool = pattern_value.valid and text_value.valid and pattern_value.type.kind == TypeKind.Named and pattern_value.type.name == "Regex" and text_value.type.kind == TypeKind.Text
            if not valid_types:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Regex.split requires a Regex receiver and sview haystack")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            state.operand_pool.push(pattern_value.value)
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.RegexSplit, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Lower Python's typed dictionary default lookup.  Elisascript keeps the
        # fallback lazy by routing the method through the same IndexValid CFG used
        # by `get mapping[key] else fallback`; a missing key therefore never
        # evaluates the ordinary index path, and both branches merge one exact
        # static value type.
        def lower_collection_get_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Map", "get")
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            valid_shape: bool = method_spec.known and method_spec.opcode == "IndexValid" and typed_builtin_method_call_shape("Map", "get", arguments, argument_names)
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "get requires a key and one positional default value")
                return invalid
            collection: LoweredValue = lower_expression(receiver_expression, state)
            index: LoweredValue = lower_expression(arguments[0], state)
            if not collection.valid or not index.valid:
                return invalid
            if collection.type.kind != TypeKind.Map or collection.type.name == "__elisascript_set":
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "get requires a dictionary receiver")
                return invalid
            return lower_checked_index_values(collection, index, arguments[1], pos, state)


        def lower_collection_get(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            receiver_pos: Ast::Pos = Ast::Pos{line: pos.line, column: pos.column, offset: pos.offset, end_line: pos.end_line, end_column: pos.end_column, end_offset: pos.end_offset}
            return lower_collection_get_expression(Expr.Ident(receiver_name, receiver_pos), arguments, argument_names, pos, state)


        # Lower the small Python pathlib method surface that has a direct typed
        # opcode.  Path properties are handled by the bare-field arm below;
        # these call forms keep the receiver nominal and preserve each operation's
        # effect/error contract.
        def lower_path_method(receiver_expression: Ast::Expr, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            path_value: LoweredValue = lower_expression(receiver_expression, state)
            if not path_value.valid or path_value.type.kind != TypeKind.Named or path_value.type.name != "Path":
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "path method requires a nominal Path receiver")
                return invalid
            path_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Path", method_name)
            positional: mutable bool = argument_names.count == 0 or argument_names.count == arguments.count
            if positional and argument_names.count != 0:
                for argument_name in argument_names |positional|:
                    positional <- false if argument_name != ""
            if path_spec.known and path_spec.opcode == "PathJoin" and path_spec.argument_types == "text" and path_spec.lowering_steps == "":
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.joinpath requires one positional sview value")
                    return invalid
                leaf_type: mutable Type = type_from_name("sview")
                leaf_value: LoweredValue = lower_expression_expected(arguments[0], leaf_type, state)
                if not leaf_value.valid or leaf_value.type.kind != TypeKind.Text:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.joinpath requires an sview value")
                    return invalid
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                state.operand_pool.push(leaf_value.value)
                result: u32 = fresh_value(state)
                state.instructions.push(Instruction{opcode: Opcode.PathJoin, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if path_spec.known and path_spec.opcode == "PathIterDir":
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.iterdir requires no arguments")
                    return invalid
                record_builtin_contract(path_spec, state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                result: u32 = fresh_value(state)
                state.instructions.push(Instruction{opcode: Opcode.PathIterDir, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if path_spec.known and path_spec.opcode == "PathJoin" and path_spec.lowering_steps == "PathParent,PathJoin":
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.with_name requires one positional sview value")
                    return invalid
                name_expected_type: Type = type_from_name("sview")
                name_value: LoweredValue = lower_expression_expected(arguments[0], name_expected_type, state)
                if not name_value.valid or name_value.type.kind != TypeKind.Text:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.with_name requires an sview value")
                    return invalid
                record_builtin_contract(path_spec, state)
                parent_result: u32 = fresh_value(state)
                parent_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                state.instructions.push(Instruction{opcode: Opcode.PathParent, result: parent_result, result_type: result_type, operand_start: parent_start, operand_count: 1, span: ir_span(pos)})
                join_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(parent_result)
                state.operand_pool.push(name_value.value)
                result: u32 = fresh_value(state)
                state.instructions.push(Instruction{opcode: Opcode.PathJoin, result: result, result_type: result_type, operand_start: join_start, operand_count: 2, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if path_spec.known and path_spec.opcode == "PathJoin" and path_spec.lowering_steps == "PathParent,PathStem,Concat,PathJoin":
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.with_suffix requires one positional sview suffix")
                    return invalid
                suffix_expected_type: Type = type_from_name("sview")
                suffix_value: LoweredValue = lower_expression_expected(arguments[0], suffix_expected_type, state)
                if not suffix_value.valid or suffix_value.type.kind != TypeKind.Text:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.with_suffix requires an sview suffix")
                    return invalid
                record_builtin_contract(path_spec, state)
                parent_result: u32 = fresh_value(state)
                parent_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                state.instructions.push(Instruction{opcode: Opcode.PathParent, result: parent_result, result_type: result_type, operand_start: parent_start, operand_count: 1, span: ir_span(pos)})
                stem_result: u32 = fresh_value(state)
                stem_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                state.instructions.push(Instruction{opcode: Opcode.PathStem, result: stem_result, result_type: type_from_name("sview"), operand_start: stem_start, operand_count: 1, span: ir_span(pos)})
                leaf: LoweredValue = emit_binary(state, Opcode.Concat, stem_result, suffix_value.value, type_from_name("sview"), pos)
                join_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(parent_result)
                state.operand_pool.push(leaf.value)
                result: u32 = fresh_value(state)
                state.instructions.push(Instruction{opcode: Opcode.PathJoin, result: result, result_type: result_type, operand_start: join_start, operand_count: 2, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if path_spec.known and path_spec.opcode == "SymlinkPath":
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.symlink_to requires one positional target Path value")
                    return invalid
                target_value: LoweredValue = lower_expression(arguments[0], state)
                if not target_value.valid or target_value.type.kind != TypeKind.Named or target_value.type.name != "Path":
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.symlink_to requires a nominal Path target")
                    return invalid
                record_builtin_contract(path_spec, state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(target_value.value)
                state.operand_pool.push(path_value.value)
                result: u32 = fresh_value(state)
                state.instructions.push(Instruction{opcode: Opcode.SymlinkPath, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if path_spec.known and (path_spec.opcode == "PathGlob" or path_spec.opcode == "PathRGlob") and path_spec.argument_types == "text":
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.glob and Path.rglob require one positional sview pattern")
                    return invalid
                pattern_type: mutable Type = type_from_name("sview")
                pattern_value: LoweredValue = lower_expression_expected(arguments[0], pattern_type, state)
                if not pattern_value.valid or pattern_value.type.kind != TypeKind.Text:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.glob and Path.rglob require an sview pattern")
                    return invalid
                record_builtin_contract(path_spec, state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                state.operand_pool.push(pattern_value.value)
                result: u32 = fresh_value(state)
                opcode: Opcode = Opcode.PathRGlob if path_spec.opcode == "PathRGlob" else Opcode.PathGlob
                state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if path_spec.known and path_spec.opcode == "ReadText":
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.read_text and Path.read_lines require no arguments")
                    return invalid
                record_builtin_contract(path_spec, state)
                if path_spec.return_type == "darray[text]":
                    text_result: u32 = fresh_value(state)
                    read_operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(path_value.value)
                    state.instructions.push(Instruction{opcode: Opcode.ReadText, result: text_result, result_type: type_from_name("sview"), operand_start: read_operand_start, operand_count: 1, span: ir_span(pos)})
                    separator: LoweredValue = emit_constant(state, type_from_name("sview"), 0, "", "\n", false, ir_span(pos))
                    split_operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(text_result)
                    state.operand_pool.push(separator.value)
                    result: u32 = fresh_value(state)
                    state.instructions.push(Instruction{opcode: Opcode.Split, result: result, result_type: result_type, integer: 0, operand_start: split_operand_start, operand_count: 2, span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: result_type}
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                result: u32 = fresh_value(state)
                state.instructions.push(Instruction{opcode: Opcode.ReadText, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if path_spec.known and path_spec.opcode == "ReadBytes":
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.read_bytes requires no arguments")
                    return invalid
                record_builtin_contract(path_spec, state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                result: u32 = fresh_value(state)
                state.instructions.push(Instruction{opcode: Opcode.ReadBytes, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if path_spec.known and (path_spec.opcode == "WriteText" or path_spec.opcode == "AppendText"):
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path text writers require one positional value")
                    return invalid
                payload: mutable LoweredValue = invalid
                if path_spec.argument_types == "darray[text]":
                    lines_type: Type = array_ir_type(type_from_name("sview"))
                    lines_value: LoweredValue = lower_expression_expected(arguments[0], lines_type, state)
                    if not lines_value.valid or lines_value.type.kind != TypeKind.Array or lines_value.type.element_kind != TypeKind.Text:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path line writers require a darray[sview] value")
                        return invalid
                    separator: LoweredValue = emit_constant(state, type_from_name("sview"), 0, "", "\n", false, ir_span(pos))
                    join_operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(lines_value.value)
                    state.operand_pool.push(separator.value)
                    joined: u32 = fresh_value(state)
                    state.instructions.push(Instruction{opcode: Opcode.Join, result: joined, result_type: type_from_name("sview"), operand_start: join_operand_start, operand_count: 2, span: ir_span(pos)})
                    payload <- LoweredValue{valid: true, value: joined, type: type_from_name("sview")}
                else:
                    text_value: LoweredValue = lower_expression_expected(arguments[0], type_from_name("sview"), state)
                    if not text_value.valid or text_value.type.kind != TypeKind.Text:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path text writers require an sview value")
                        return invalid
                    payload <- text_value
                record_builtin_contract(path_spec, state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                state.operand_pool.push(payload.value)
                result: u32 = fresh_value(state)
                opcode: Opcode = Opcode.AppendText if path_spec.opcode == "AppendText" else Opcode.WriteText
                state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if path_spec.known and (path_spec.opcode == "WriteBytes" or path_spec.opcode == "AppendBytes"):
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path byte writers require one positional darray[u8] value")
                    return invalid
                bytes_value: LoweredValue = lower_expression(arguments[0], state)
                byte_type: Type = type_from_name("u8")
                byte_element_type: Type = array_element_type(bytes_value.type) if bytes_value.type.kind == TypeKind.Array else type_from_name("void")
                if not bytes_value.valid or bytes_value.type.kind != TypeKind.Array or not same_type(byte_element_type, byte_type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path byte writers require a darray[u8] value")
                    return invalid
                record_builtin_contract(path_spec, state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                state.operand_pool.push(bytes_value.value)
                result: u32 = fresh_value(state)
                opcode: Opcode = Opcode.AppendBytes if path_spec.opcode == "AppendBytes" else Opcode.WriteBytes
                state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if path_spec.known and path_spec.opcode == "RemovePath":
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.unlink requires no arguments")
                    return invalid
                record_builtin_contract(path_spec, state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                result: u32 = fresh_value(state)
                state.instructions.push(Instruction{opcode: Opcode.RemovePath, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if path_spec.known and path_spec.opcode == "MovePath":
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.rename requires one positional target Path value")
                    return invalid
                destination_value: LoweredValue = lower_expression(arguments[0], state)
                if not destination_value.valid or destination_value.type.kind != TypeKind.Named or destination_value.type.name != "Path":
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.rename requires a nominal Path target")
                    return invalid
                record_builtin_contract(path_spec, state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                state.operand_pool.push(destination_value.value)
                result: u32 = fresh_value(state)
                state.instructions.push(Instruction{opcode: Opcode.MovePath, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if path_spec.known and path_spec.opcode == "TouchPath":
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.touch accepts an optional named exist_ok bool control")
                    return invalid
                record_builtin_contract(path_spec, state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                exist_ok_value: mutable LoweredValue = invalid
                if arguments.count == 1:
                    exist_ok_expected_type: Type = type_from_name("bool")
                    exist_ok_value <- lower_expression_expected(arguments[0], exist_ok_expected_type, state)
                    if not exist_ok_value.valid or exist_ok_value.type.kind != TypeKind.Bool:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.touch exist_ok control must be a bool value")
                        return invalid
                    state.operand_pool.push(exist_ok_value.value)
                result: u32 = fresh_value(state)
                state.instructions.push(Instruction{opcode: Opcode.TouchPath, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1 if arguments.count == 0 else 2, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if path_spec.known and path_spec.opcode == "ChmodPath":
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.chmod requires one positional u64 mode value")
                    return invalid
                mode_type: mutable Type = type_from_name("u64")
                mode_value: LoweredValue = lower_expression_expected(arguments[0], mode_type, state)
                if not mode_value.valid or mode_value.type.kind != TypeKind.Int or mode_value.type.bits != 64 or mode_value.type.signed:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.chmod requires a u64 mode value")
                    return invalid
                record_builtin_contract(path_spec, state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                state.operand_pool.push(mode_value.value)
                result: u32 = fresh_value(state)
                state.instructions.push(Instruction{opcode: Opcode.ChmodPath, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if path_spec.known and path_spec.opcode == "PathRelative" and path_spec.argument_types == "Path":
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.relative_to requires one positional Path value")
                    return invalid
                base_value: LoweredValue = lower_expression(arguments[0], state)
                if not base_value.valid or base_value.type.kind != TypeKind.Named or base_value.type.name != "Path":
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.relative_to requires a nominal Path base")
                    return invalid
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                state.operand_pool.push(base_value.value)
                result: u32 = fresh_value(state)
                state.instructions.push(Instruction{opcode: Opcode.PathRelative, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if method_name == "mkdir":
                result_type: Type = type_from_name("bool")
                valid_shape: bool = arguments.count == 0 or (argument_names.count == arguments.count and arguments.count <= 3)
                if not valid_shape:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.mkdir accepts named mode, parents, and exist_ok controls")
                    return invalid
                state.required_effects.push("Directory.Write") if not has_text(state.required_effects, "Directory.Write")
                state.required_errors.push("DirectoryError") if not has_text(state.required_errors, "DirectoryError")
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                mode_value: mutable LoweredValue = emit_constant(state, type_from_name("u64"), 493, "", "", false, ir_span(pos)) if arguments.count > 0 else invalid
                parents_value: mutable LoweredValue = emit_constant(state, type_from_name("bool"), 0, "", "", false, ir_span(pos)) if arguments.count > 0 else invalid
                exist_ok_value: mutable LoweredValue = emit_constant(state, type_from_name("bool"), 0, "", "", false, ir_span(pos)) if arguments.count > 0 else invalid
                saw_mode: mutable bool = false
                saw_parents: mutable bool = false
                saw_exist_ok: mutable bool = false
                for argument_index in 0..<arguments.count |arguments, argument_names, argument_index, mode_value, parents_value, exist_ok_value, saw_mode, saw_parents, saw_exist_ok, state|:
                    argument_name: sview = argument_names[argument_index] if argument_names.count != 0 else ""
                    if argument_name != "mode" and argument_name != "parents" and argument_name != "exist_ok":
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.mkdir supports only mode, parents, and exist_ok named controls")
                        return invalid
                    if argument_name == "mode" and saw_mode or argument_name == "parents" and saw_parents or argument_name == "exist_ok" and saw_exist_ok:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.mkdir controls may appear at most once")
                        return invalid
                    if argument_name == "mode":
                        control_u64_type: Type = type_from_name("u64")
                        control: LoweredValue = lower_expression_expected(arguments[argument_index], control_u64_type, state)
                        if not control.valid or control.type.kind != TypeKind.Int or control.type.bits != 64 or control.type.signed:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.mkdir mode control must be a u64 value")
                            return invalid
                        mode_value <- control
                        saw_mode <- true
                    else:
                        control_bool_type: Type = type_from_name("bool")
                        control: LoweredValue = lower_expression_expected(arguments[argument_index], control_bool_type, state)
                        if not control.valid or control.type.kind != TypeKind.Bool:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.mkdir parents and exist_ok controls must be bool values")
                            return invalid
                        parents_value <- control if argument_name == "parents" else parents_value
                        exist_ok_value <- control if argument_name == "exist_ok" else exist_ok_value
                        saw_parents <- true if argument_name == "parents" else saw_parents
                        saw_exist_ok <- true if argument_name == "exist_ok" else saw_exist_ok
                result: u32 = fresh_value(state)
                if arguments.count > 0:
                    # The interpreter and verifier use one canonical control
                    # layout: path, mode, parents, exist_ok.  Preserve the
                    # defaults for omitted named controls so a single
                    # `mode`, `parents`, or `exist_ok` argument cannot shift
                    # the following operands or read into the next instruction.
                    state.operand_pool.push(mode_value.value)
                    state.operand_pool.push(parents_value.value)
                    state.operand_pool.push(exist_ok_value.value)
                operand_count: u16 = 1 if arguments.count == 0 else 4
                state.instructions.push(Instruction{opcode: Opcode.CreateDirectory, result: result, result_type: result_type, operand_start: operand_start, operand_count: operand_count, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if path_spec.known and path_spec.opcode == "RemoveDirectory":
                result_type: Type = typed_builtin_result_type(path_spec)
                if not typed_builtin_method_call_shape("Path", method_name, arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "Path.rmdir requires no arguments")
                    return invalid
                record_builtin_contract(path_spec, state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(path_value.value)
                result: u32 = fresh_value(state)
                state.instructions.push(Instruction{opcode: Opcode.RemoveDirectory, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            result_type: mutable Type = typed_builtin_result_type(path_spec) if path_spec.known else (type_from_name("bool") if method_name == "exists" or method_name == "is_dir" or method_name == "is_file" or method_name == "is_symlink" else (Type{kind: TypeKind.Named, name: "Path"} if method_name == "readlink" or method_name == "read_link" or method_name == "normalize" or method_name == "absolute" or method_name == "realpath" or method_name == "resolve" else type_from_name("sview")))
            valid_shape: bool = typed_builtin_method_call_shape("Path", method_name, arguments, argument_names) if path_spec.known else arguments.count == 0 and argument_names.count == 0
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "path shape methods require no arguments")
                return invalid
            opcode: mutable Opcode = Opcode.PathExists
            instruction_integer: mutable i64 = 0
            if path_spec.known and path_spec.opcode == "PathParent":
                opcode <- Opcode.PathParent
            elif path_spec.known and path_spec.opcode == "PathName":
                opcode <- Opcode.PathName
            elif path_spec.known and path_spec.opcode == "PathExtension":
                opcode <- Opcode.PathExtension
            elif path_spec.known and path_spec.opcode == "PathStem":
                opcode <- Opcode.PathStem
            elif path_spec.known and path_spec.opcode == "PathExists":
                record_builtin_contract(path_spec, state)
                opcode <- Opcode.PathExists
            elif path_spec.known and path_spec.opcode == "IsFile":
                record_builtin_contract(path_spec, state)
                opcode <- Opcode.IsFile
            elif path_spec.known and path_spec.opcode == "IsSymlink":
                record_builtin_contract(path_spec, state)
                opcode <- Opcode.IsSymlink
            elif path_spec.known and path_spec.opcode == "ReadLink":
                record_builtin_contract(path_spec, state)
                opcode <- Opcode.ReadLink
            elif path_spec.known and path_spec.opcode == "IsDirectory":
                record_builtin_contract(path_spec, state)
                opcode <- Opcode.IsDirectory
            elif path_spec.known and path_spec.opcode == "PathIsAbsolute":
                opcode <- Opcode.PathIsAbsolute
            elif path_spec.known and path_spec.opcode == "PathNormalize":
                opcode <- Opcode.PathNormalize
            elif path_spec.known and path_spec.opcode == "PathReal":
                record_builtin_contract(path_spec, state)
                opcode <- Opcode.PathReal
            elif path_spec.known and path_spec.opcode == "PathAbsolute":
                record_builtin_contract(path_spec, state)
                opcode <- Opcode.PathAbsolute
            elif path_spec.known and path_spec.opcode == "PathAccess":
                record_builtin_contract(path_spec, state)
                state.required_effects.push("File.Read") if not has_text(state.required_effects, "File.Read")
                opcode <- Opcode.PathAccess
                # PathAccess carries the POSIX mode in the instruction payload;
                # the verifier accepts only the three explicit access bits.
                instruction_integer <- path_spec.lowering_mode
            else:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "unsupported Path method")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(path_value.value)
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, integer: instruction_integer, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Lower Python-style `values.pop()`/`values.pop(index)` as a typed pair
        # of semantic array operations. PopArrayValue produces the removed
        # element (and raises IndexOutOfBounds for an empty/out-of-range array);
        # PopArray produces the shortened view that rebinds the mutable SSA name.
        # Keeping the two results separate lets expression and statement forms
        # share exactly the same bounds and ownership behavior without
        # introducing a tuple type into the initial IR.
        def lower_collection_copy_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            if arguments.count != 0 or argument_names.count != 0:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "copy method requires no arguments")
                return invalid
            collection: LoweredValue = lower_expression(receiver_expression, state)
            if not collection.valid or collection.type.kind not in {TypeKind.Array, TypeKind.Map}:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "copy method requires an array or map receiver")
                return invalid
            result: u32 = fresh_value(state)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            copy_opcode: Opcode = Opcode.CopyMap if collection.type.kind == TypeKind.Map else Opcode.CopyArray
            state.instructions.push(Instruction{opcode: copy_opcode, result: result, result_type: collection.type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: collection.type}


        def lower_collection_insert(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "collection mutation receiver has no local binding")
                return true
            if state.types[binding].kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "insert requires an array receiver")
                return true
            if not state.mutables[binding]:
                add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "insert requires a mutable array binding")
                return true
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Array", "insert")
            if not method_spec.known or method_spec.opcode != "InsertArray" or not typed_builtin_method_call_shape("Array", "insert", arguments, argument_names):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "insert requires an integer index and one positional element")
                return true
            index: LoweredValue = lower_expression(arguments[0], state)
            element_type: Type = array_element_type(state.types[binding])
            element: LoweredValue = lower_expression_expected(arguments[1], element_type, state)
            if not index.valid or not element.valid:
                return true
            if index.type.kind != TypeKind.Int:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "insert index must have an integer type")
                return true
            if not same_type(element.type, element_type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "inserted value must match the array element type")
                return true
            result: u32 = fresh_value(state)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(state.values[binding])
            state.operand_pool.push(index.value)
            state.operand_pool.push(element.value)
            state.instructions.push(Instruction{opcode: Opcode.InsertArray, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
            state.values[binding] <- result
            return true


        def lower_collection_reverse(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "collection mutation receiver has no local binding")
                return true
            if state.types[binding].kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "reverse requires an array receiver")
                return true
            if not state.mutables[binding]:
                add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "reverse requires a mutable array binding")
                return true
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Array", "reverse")
            if not method_spec.known or method_spec.opcode != "ReverseArray" or not typed_builtin_method_call_shape("Array", "reverse", arguments, argument_names):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "reverse requires no arguments")
                return true
            result: u32 = fresh_value(state)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(state.values[binding])
            state.instructions.push(Instruction{opcode: Opcode.ReverseArray, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            state.values[binding] <- result
            return true


        def lower_collection_pop(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "collection mutation receiver has no local binding")
                return invalid
            if state.types[binding].kind == TypeKind.Map:
                if state.types[binding].name == "__elisascript_set":
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "pop requires a dictionary receiver")
                    return invalid
                if not state.mutables[binding]:
                    add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "pop requires a mutable dictionary binding")
                    return invalid
                method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Map", "pop")
                if not method_spec.known or method_spec.opcode != "PopMapValue" or not typed_builtin_method_call_shape("Map", "pop", arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "dictionary pop requires one key and an optional positional default value")
                    return invalid
                key_type: Type = map_key_type(state.types[binding])
                key: LoweredValue = lower_expression_expected(arguments[0], key_type, state)
                if not key.valid:
                    return invalid
                if not same_type(key.type, key_type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "popped key must match the dictionary key type")
                    return invalid
                value_type: Type = map_value_type(state.types[binding])
                default_value: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: value_type}
                if arguments.count == 2:
                    default_value <- lower_expression_expected(arguments[1], value_type, state)
                    if not default_value.valid:
                        return invalid
                    if not same_type(default_value.type, value_type):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "pop default must match the dictionary value type")
                        return invalid
                collection: u32 = state.values[binding]
                popped: u32 = fresh_value(state)
                popped_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(collection)
                state.operand_pool.push(key.value)
                state.operand_pool.push(default_value.value) if default_value.valid
                state.instructions.push(Instruction{opcode: Opcode.PopMapValue, result: popped, result_type: value_type, operand_start: popped_start, operand_count: 3 if default_value.valid else 2, span: ir_span(pos)})
                shortened: u32 = fresh_value(state)
                shortened_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(collection)
                state.operand_pool.push(key.value)
                state.instructions.push(Instruction{opcode: Opcode.PopMap, result: shortened, result_type: state.types[binding], operand_start: shortened_start, operand_count: 2, span: ir_span(pos)})
                state.values[binding] <- shortened
                return LoweredValue{valid: true, value: popped, type: value_type}
            if state.types[binding].kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "pop requires an array receiver")
                return invalid
            if not state.mutables[binding]:
                add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "pop requires a mutable array binding")
                return invalid
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Array", "pop")
            if not method_spec.known or method_spec.opcode != "PopArrayValue" or not typed_builtin_method_call_shape("Array", "pop", arguments, argument_names):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "array pop requires an optional positional integer index")
                return invalid

            collection: u32 = state.values[binding]
            element_type: Type = array_element_type(state.types[binding])
            index: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("i64")}
            if arguments.count == 1:
                index <- lower_expression(arguments[0], state)
                if not index.valid:
                    return invalid
                if index.type.kind != TypeKind.Int:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "array pop index must have an integer type")
                    return invalid
            element: u32 = fresh_value(state)
            element_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection)
            state.operand_pool.push(index.value) if index.valid
            state.instructions.push(Instruction{opcode: Opcode.PopArrayValue, result: element, result_type: element_type, operand_start: element_start, operand_count: 2 if index.valid else 1, span: ir_span(pos)})
            shortened: u32 = fresh_value(state)
            shortened_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection)
            state.operand_pool.push(index.value) if index.valid
            state.instructions.push(Instruction{opcode: Opcode.PopArray, result: shortened, result_type: state.types[binding], operand_start: shortened_start, operand_count: 2 if index.valid else 1, span: ir_span(pos)})
            state.values[binding] <- shortened
            return LoweredValue{valid: true, value: element, type: element_type}


        # Lower Python's typed dictionary `setdefault(key, default)` as a pair
        # of semantic operations.  The value operation returns the existing
        # value (or the default when the key is absent), while the map operation
        # rebinds the mutable SSA name only when insertion is needed.  Keeping
        # these results separate avoids introducing a tuple type into the IR and
        # makes expression and statement forms share one exact evaluation.
        def lower_collection_setdefault(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "collection mutation receiver has no local binding")
                return invalid
            if state.types[binding].kind != TypeKind.Map or state.types[binding].name == "__elisascript_set":
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "setdefault requires a dictionary receiver")
                return invalid
            if not state.mutables[binding]:
                add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "setdefault requires a mutable dictionary binding")
                return invalid
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Map", "setdefault")
            if not method_spec.known or method_spec.opcode != "SetDefaultMapValue" or not typed_builtin_method_call_shape("Map", "setdefault", arguments, argument_names):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "setdefault requires a key and one positional default value")
                return invalid
            key_type: Type = map_key_type(state.types[binding])
            key: LoweredValue = lower_expression_expected(arguments[0], key_type, state)
            if not key.valid:
                return invalid
            if not same_type(key.type, key_type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "setdefault key must match the dictionary key type")
                return invalid
            value_type: Type = map_value_type(state.types[binding])
            default_value: LoweredValue = lower_expression_expected(arguments[1], value_type, state)
            if not default_value.valid:
                return invalid
            if not same_type(default_value.type, value_type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "setdefault default must match the dictionary value type")
                return invalid
            collection: u32 = state.values[binding]
            value_result: u32 = fresh_value(state)
            value_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection)
            state.operand_pool.push(key.value)
            state.operand_pool.push(default_value.value)
            state.instructions.push(Instruction{opcode: Opcode.SetDefaultMapValue, result: value_result, result_type: value_type, operand_start: value_start, operand_count: 3, span: ir_span(pos)})
            map_result: u32 = fresh_value(state)
            map_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection)
            state.operand_pool.push(key.value)
            state.operand_pool.push(default_value.value)
            state.instructions.push(Instruction{opcode: Opcode.SetDefaultMap, result: map_result, result_type: state.types[binding], operand_start: map_start, operand_count: 3, span: ir_span(pos)})
            state.values[binding] <- map_result
            return LoweredValue{valid: true, value: value_result, type: value_type}


        def lower_collection_sort(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "sort receiver has no local binding")
                return true
            if state.types[binding].kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "sort requires an array receiver")
                return true
            if not state.mutables[binding]:
                add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "sort requires a mutable array binding")
                return true
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Array", "sort")
            if not method_spec.known or method_spec.opcode != "SortArray" or not typed_builtin_method_call_shape("Array", "sort", arguments, argument_names):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "sort accepts an optional reverse bool")
                return true
            element_type: Type = array_element_type(state.types[binding])
            if element_type.kind not in {TypeKind.Bool, TypeKind.Int, TypeKind.Float, TypeKind.Char, TypeKind.Text}:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "sort requires an array of bool, integer, float, char, or text values")
                return true
            reverse_value: mutable LoweredValue = LoweredValue{valid: true, value: 0, type: type_from_name("bool")}
            if arguments.count == 1:
                bool_type: Type = type_from_name("bool")
                reverse_value <- lower_expression_expected(arguments[0], bool_type, state)
                if not reverse_value.valid or reverse_value.type.kind != TypeKind.Bool:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "sort reverse argument must be bool")
                    return true
            result: u32 = fresh_value(state)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(state.values[binding])
            state.instructions.push(Instruction{opcode: Opcode.SortArray, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            if arguments.count == 1:
                match arguments[0]:
                    Expr.BoolLit(value):
                        if value:
                            reversed_result: u32 = fresh_value(state)
                            reversed_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(result)
                            state.instructions.push(Instruction{opcode: Opcode.ReverseArray, result: reversed_result, result_type: state.types[binding], operand_start: reversed_start, operand_count: 1, span: ir_span(pos)})
                            state.values[binding] <- reversed_result
                            return true
                    _:
                        pass
                if arguments[0] is not Expr.BoolLit:
                    selected_block: u32 = fresh_block(state)
                    alternative_block: u32 = fresh_block(state)
                    merge_block: u32 = fresh_block(state)
                    state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: reverse_value.value, operand_count: 1, target0: selected_block, target1: alternative_block, target_count: 2, span: ir_span(pos)}
                    finish_block(state)

                    state.current_block <- selected_block
                    state.terminated <- false
                    reversed_result: u32 = fresh_value(state)
                    reversed_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(result)
                    state.instructions.push(Instruction{opcode: Opcode.ReverseArray, result: reversed_result, result_type: state.types[binding], operand_start: reversed_start, operand_count: 1, span: ir_span(pos)})
                    selected_edge_start: u32 = state.edge_arg_pool.count.u32()
                    state.edge_arg_pool.push(reversed_result)
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: selected_edge_start, edge0_arg_count: 1, span: ir_span(pos)}
                    finish_block(state)

                    state.current_block <- alternative_block
                    state.terminated <- false
                    alternative_edge_start: u32 = state.edge_arg_pool.count.u32()
                    state.edge_arg_pool.push(result)
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: alternative_edge_start, edge0_arg_count: 1, span: ir_span(pos)}
                    finish_block(state)

                    merged_result: u32 = fresh_value(state)
                    state.pending_parameter_blocks.push(merge_block)
                    state.pending_parameters.push(Parameter{value: merged_result, type: state.types[binding], name: "sort"})
                    state.current_block <- merge_block
                    state.terminated <- false
                    state.values[binding] <- merged_result
                    return true
            state.values[binding] <- result
            return true


        def lower_collection_mutation(expression: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            receiver_name: mutable sview = ""
            method_name: mutable sview = ""
            arguments: mutable darray[Ast::Expr] = []
            argument_names: mutable darray[sview] = []
            match expression:
                Expr.Call(Expr.Field(Expr.Ident(name, ident_pos), method, field_pos), call_arguments, call_argument_names, call_pos):
                    if method == "push" or method == "append" or method == "pop" or method == "setdefault" or method == "extend" or method == "add" or method == "clear" or method == "remove" or method == "discard" or method == "reverse" or method == "insert" or method == "sort" or method == "update":
                        receiver_name <- name
                        method_name <- method
                        arguments.extend(call_arguments)
                        argument_names.extend(call_argument_names)
                _:
                    pass
            false return if receiver_name == ""
            false return if lowered_function_index(state, method_name) < state.function_names.count
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "collection mutation receiver has no local binding")
                return true
            discard_alias: mutable bool = false
            if method_name == "discard":
                if state.types[binding].kind != TypeKind.Map or state.types[binding].name != "__elisascript_set":
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "discard requires a set receiver")
                    return true
                discard_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Set", "discard")
                if not scripting_set_builtin_available(state, method_name) or not discard_spec.known or discard_spec.opcode != "DeleteIndex" or not typed_builtin_method_call_shape("Set", "discard", arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "discard requires exactly one positional element")
                    return true
                record_builtin_contract(discard_spec, state)
                discard_alias <- true
                method_name <- "remove"
            if method_name == "pop":
                _ = lower_collection_pop(receiver_name, arguments, argument_names, pos, state)
                return true
            if method_name == "setdefault":
                _ = lower_collection_setdefault(receiver_name, arguments, argument_names, pos, state)
                return true
            if method_name == "reverse":
                false return if not scripting_array_builtin_available(state, method_name)
                _ = lower_collection_reverse(receiver_name, arguments, argument_names, pos, state)
                return true
            if method_name == "insert":
                false return if not scripting_array_builtin_available(state, method_name)
                _ = lower_collection_insert(receiver_name, arguments, argument_names, pos, state)
                return true
            if method_name == "sort":
                false return if not scripting_array_builtin_available(state, method_name)
                _ = lower_collection_sort(receiver_name, arguments, argument_names, pos, state)
                return true
            if method_name == "clear":
                if state.types[binding].kind != TypeKind.Map and state.types[binding].kind != TypeKind.Array:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "clear requires an array, map, or set receiver")
                    return true
                if not state.mutables[binding]:
                    add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "clear requires a mutable array, map, or set binding")
                    return true
                named_argument: mutable bool = false
                for argument_name in argument_names |named_argument|:
                    named_argument <- true if argument_name != ""
                if arguments.count != 0 or named_argument:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "clear requires no arguments")
                    return true
                if state.types[binding].kind == TypeKind.Array:
                    false return if not scripting_array_builtin_available(state, method_name)
                    method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Array", "clear")
                    if not method_spec.known or method_spec.opcode != "MakeArray" or not typed_builtin_method_call_shape("Array", "clear", arguments, argument_names):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "clear requires no arguments")
                        return true
                    record_builtin_contract(method_spec, state)
                elif state.types[binding].name == "__elisascript_set":
                    false return if not (scripting_set_builtin_available(state, method_name) and method_name == "clear")
                    method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Set", "clear")
                    if not method_spec.known or method_spec.opcode != "MakeMap" or not typed_builtin_method_call_shape("Set", "clear", arguments, argument_names):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "clear requires no arguments")
                        return true
                    record_builtin_contract(method_spec, state)
                else:
                    false return if not (scripting_map_builtin_available(state, method_name) and method_name == "clear")
                    method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Map", "clear")
                    if not method_spec.known or method_spec.opcode != "MakeMap" or not typed_builtin_method_call_shape("Map", "clear", arguments, argument_names):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "clear requires no arguments")
                        return true
                    record_builtin_contract(method_spec, state)
                result: u32 = fresh_value(state)
                if state.types[binding].kind == TypeKind.Map:
                    state.instructions.push(Instruction{opcode: Opcode.MakeMap, result: result, result_type: state.types[binding], operand_start: state.operand_pool.count.u32(), operand_count: 0, span: ir_span(pos)})
                else:
                    state.instructions.push(Instruction{opcode: Opcode.MakeArray, result: result, result_type: state.types[binding], operand_start: state.operand_pool.count.u32(), operand_count: 0, span: ir_span(pos)})
                state.values[binding] <- result
                return true
            map_update_builtin: bool = scripting_map_builtin_available(state, method_name) and method_name == "update"
            if method_name == "update":
                false return if not map_update_builtin
                if state.types[binding].kind != TypeKind.Map or state.types[binding].name == "__elisascript_set":
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "update requires a dictionary receiver")
                    return true
                if not state.mutables[binding]:
                    add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "update requires a mutable dictionary binding")
                    return true
                method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Map", "update")
                if not method_spec.known or method_spec.opcode != "Concat" or not typed_builtin_method_call_shape("Map", "update", arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "update requires exactly one positional dictionary")
                    return true
                other: LoweredValue = lower_expression_expected(arguments[0], state.types[binding], state)
                if not other.valid:
                    return true
                if not same_type(other.type, state.types[binding]):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "updated dictionary must have the receiver's exact type")
                    return true
                result: u32 = fresh_value(state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(state.values[binding])
                state.operand_pool.push(other.value)
                state.instructions.push(Instruction{opcode: Opcode.Concat, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                state.values[binding] <- result
                return true
            if method_name == "remove":
                if state.types[binding].kind == TypeKind.Array:
                    if not state.mutables[binding]:
                        add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "remove requires a mutable array binding")
                        return true
                    method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Array", "remove")
                    if not scripting_array_builtin_available(state, method_name) or not method_spec.known or method_spec.opcode != "RemoveArray" or not typed_builtin_method_call_shape("Array", "remove", arguments, argument_names):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "remove requires exactly one positional element")
                        return true
                    element_type: Type = array_element_type(state.types[binding])
                    element: LoweredValue = lower_expression_expected(arguments[0], element_type, state)
                    if not element.valid:
                        return true
                    if not same_type(element.type, element_type):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "removed value must match the array element type")
                        return true
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(state.values[binding])
                    state.operand_pool.push(element.value)
                    state.instructions.push(Instruction{opcode: Opcode.RemoveArray, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                    state.values[binding] <- result
                    return true
                if state.types[binding].kind != TypeKind.Map:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "remove requires an array, map, or set receiver")
                    return true
                if not state.mutables[binding]:
                    add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "remove requires a mutable map or set binding")
                    return true
                named_argument: mutable bool = false
                for argument_name in argument_names |named_argument|:
                    named_argument <- true if argument_name != ""
                if arguments.count != 1 or named_argument:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "remove requires exactly one positional element")
                    return true
                if state.types[binding].name != "__elisascript_set":
                    false return if not (scripting_map_builtin_available(state, method_name) and method_name == "remove")
                    method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Map", "remove")
                    if not method_spec.known or method_spec.opcode != "DeleteIndex" or not typed_builtin_method_call_shape("Map", "remove", arguments, argument_names):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "remove requires exactly one positional element")
                        return true
                    record_builtin_contract(method_spec, state)
                elif not discard_alias:
                    false return if not (scripting_set_builtin_available(state, method_name) and method_name == "remove")
                    method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Set", "remove")
                    if not method_spec.known or method_spec.opcode != "DeleteIndex" or not typed_builtin_method_call_shape("Set", "remove", arguments, argument_names):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "remove requires exactly one positional element")
                        return true
                    record_builtin_contract(method_spec, state)
                result: u32 = fresh_value(state)
                element_type: Type = map_key_type(state.types[binding])
                element: LoweredValue = lower_expression_expected(arguments[0], element_type, state)
                if element.valid and not same_type(element.type, element_type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "removed key must match the map or set key type")
                    return true
                if not element.valid:
                    return true
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(state.values[binding])
                state.operand_pool.push(element.value)
                state.instructions.push(Instruction{opcode: Opcode.DeleteIndex, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                state.values[binding] <- result
                return true
            if method_name == "add":
                if state.types[binding].kind != TypeKind.Map or state.types[binding].name != "__elisascript_set":
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "add requires a set receiver")
                    return true
                if not state.mutables[binding]:
                    add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "add requires a mutable set binding")
                    return true
                named_argument: mutable bool = false
                for argument_name in argument_names |named_argument|:
                    named_argument <- true if argument_name != ""
                if arguments.count != 1 or named_argument:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "add requires exactly one positional element")
                    return true
                false return if not (scripting_set_builtin_available(state, method_name) and method_name == "add")
                method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Set", "add")
                if not method_spec.known or method_spec.opcode != "SetIndex" or not typed_builtin_method_call_shape("Set", "add", arguments, argument_names):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "add requires exactly one positional element")
                    return true
                record_builtin_contract(method_spec, state)
                element_type: Type = map_key_type(state.types[binding])
                element: LoweredValue = lower_expression_expected(arguments[0], element_type, state)
                if element.valid and not same_type(element.type, element_type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "added value must match the set element type")
                    return true
                if element.valid:
                    marker_type: Type = type_from_name("bool")
                    marker: LoweredValue = emit_constant(state, marker_type, 0, "", "", true, ir_span(pos))
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(state.values[binding])
                    state.operand_pool.push(element.value)
                    state.operand_pool.push(marker.value)
                    state.instructions.push(Instruction{opcode: Opcode.SetIndex, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
                    state.values[binding] <- result
                return true
            if state.types[binding].kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "push, append, pop, setdefault, extend, remove, reverse, insert, sort, and update require an array or dictionary receiver")
                return true
            if not state.mutables[binding]:
                add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "push, append, pop, extend, remove, reverse, and sort require a mutable array binding")
                return true
            if (method_name == "push" or method_name == "append" or method_name == "extend") and not scripting_array_builtin_available(state, method_name):
                false return
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Array", method_name)
            if (method_name == "push" or method_name == "append" or method_name == "extend") and (not method_spec.known or method_spec.opcode != "Concat" or not typed_builtin_method_call_shape("Array", method_name, arguments, argument_names)):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "push, append, pop, extend, and reverse require exactly one positional argument")
                return true

            appended: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: state.types[binding]}
            if method_name == "extend":
                appended <- lower_expression_expected(arguments[0], state.types[binding], state)
                if appended.valid and not same_type(appended.type, state.types[binding]):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "extend argument must have the receiver's exact array type")
                    return true
            else:
                element_type: Type = array_element_type(state.types[binding])
                element: LoweredValue = lower_expression_expected(arguments[0], element_type, state)
                if element.valid and not same_type(element.type, element_type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "pushed value must match the array element type")
                    return true
                if element.valid:
                    singleton: u32 = fresh_value(state)
                    singleton_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(element.value)
                    state.instructions.push(Instruction{opcode: Opcode.MakeArray, result: singleton, result_type: state.types[binding], operand_start: singleton_start, operand_count: 1, span: ir_span(pos)})
                    appended <- LoweredValue{valid: true, value: singleton, type: state.types[binding]}
            if appended.valid:
                result: u32 = fresh_value(state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(state.values[binding])
                state.operand_pool.push(appended.value)
                state.instructions.push(Instruction{opcode: Opcode.Concat, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                state.values[binding] <- result
            return true


        def lower_range_for(variables: darray[sview]&, iterable: Ast::Expr, body: darray[Ast::Stmt]&, return_type: Type, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            range_low: mutable Ast::Expr = Expr.Absent
            range_high: mutable Ast::Expr = Expr.Absent
            step_expression: mutable Ast::Expr = Expr.Absent
            range_operator: mutable TokenKind = TokenKind.Range
            have_range: mutable bool = false
            have_step: mutable bool = false
            dynamic_range_step: mutable bool = false
            match iterable:
                Expr.Binary(low, operator, high, range_pos):
                    if operator in {TokenKind.RangeLt, TokenKind.RangeLe, TokenKind.RangeGt}:
                        range_low <- low
                        range_high <- high
                        range_operator <- operator
                        have_range <- true
                    elif operator == TokenKind.Range:
                        match low:
                            Expr.Binary(inner_low, inner_operator, inner_high, inner_pos):
                                if inner_operator in {TokenKind.RangeLt, TokenKind.RangeLe, TokenKind.RangeGt}:
                                    range_low <- inner_low
                                    range_high <- inner_high
                                    range_operator <- inner_operator
                                    step_expression <- high
                                    have_range <- true
                                    have_step <- true
                            _:
                                pass
                _:
                    pass
            false return if not have_range
            if variables.count != 1:
                add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "range for lowering requires exactly one binder")
                return true

            low: LoweredValue = lower_expression(range_low, state)
            if not low.valid:
                return true
            high: LoweredValue = lower_expression_expected(range_high, low.type, state)
            if not high.valid:
                return true
            if low.type.kind != TypeKind.Int or not same_type(low.type, high.type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range bounds must have the same integer type")
                return true
            step: mutable LoweredValue = emit_constant(state, low.type, 1, "", "", false, ir_span(pos))
            if have_step:
                positive_literal: mutable bool = false
                step_literal: mutable bool = false
                match step_expression:
                    Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                        step_literal <- true
                        positive_literal <- value > 0
                    _:
                        pass
                if step_literal and not positive_literal:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range stride must be a positive integer constant or a typed integer expression")
                    return true
                if positive_literal:
                    step <- lower_expression_expected(step_expression, low.type, state)
                else:
                    dynamic_range_step <- true
                    step <- lower_expression_expected(step_expression, low.type, state)
                if not step.valid or not same_type(step.type, low.type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range stride must match the bound type")
                    return true
                state.required_errors.push("RangeStepZero") if dynamic_range_step and not has_text(state.required_errors, "RangeStepZero")

            header_block: u32 = fresh_block(state)
            body_block: u32 = fresh_block(state)
            latch_block: u32 = fresh_block(state)
            exit_block: u32 = fresh_block(state)
            assigned_names: mutable darray[sview] = []
            collect_assigned_names(body, assigned_names)
            include_mutable_element_owners(state, assigned_names)
            carried_indices: mutable darray[u32] = []
            for assigned_name in assigned_names |state, carried_indices|:
                assigned_index: usize = binding_index(state, assigned_name)
                carried_indices.push(assigned_index.u32()) if assigned_index < state.names.count
            context_start: u32 = state.loop_carried_indices.count.u32()
            state.loop_carried_indices.extend(carried_indices)
            state.loop_context_starts.push(context_start)
            if carried_indices.count > LOWER_U16_MAX:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "range loop binding count exceeds the IR u16 limit")
            state.loop_context_counts.push(carried_indices.count.u16() if carried_indices.count <= LOWER_U16_MAX else 0)
            state.loop_handler_depths.push(state.active_handlers.count.u32())
            context: usize = state.loop_context_counts.count - 1

            entry_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.edge_arg_pool.push(low.value)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: entry_args.start, edge0_arg_count: entry_args.count + 1, span: ir_span(pos)}
            finish_block(state)

            header_values: mutable darray[u32] = []
            latch_values: mutable darray[u32] = []
            exit_values: mutable darray[u32] = []
            for binding_u32 in carried_indices |state, header_block, latch_block, exit_block, header_values, latch_values, exit_values|:
                binding: usize = binding_u32.usize()
                header_value: u32 = fresh_value(state)
                latch_value: u32 = fresh_value(state)
                exit_value: u32 = fresh_value(state)
                state.pending_parameter_blocks.push(header_block)
                state.pending_parameters.push(Parameter{value: header_value, type: state.types[binding], name: state.names[binding]})
                state.pending_parameter_blocks.push(latch_block)
                state.pending_parameters.push(Parameter{value: latch_value, type: state.types[binding], name: state.names[binding]})
                state.pending_parameter_blocks.push(exit_block)
                state.pending_parameters.push(Parameter{value: exit_value, type: state.types[binding], name: state.names[binding]})
                header_values.push(header_value)
                latch_values.push(latch_value)
                exit_values.push(exit_value)
            counter: u32 = fresh_value(state)
            state.pending_parameter_blocks.push(header_block)
            state.pending_parameters.push(Parameter{value: counter, type: low.type, name: "range-counter"})
            for offset in 0..<carried_indices.count |state, carried_indices, header_values|:
                state.values[carried_indices[offset].usize()] <- header_values[offset]

            state.current_block <- header_block
            state.terminated <- false
            condition: u32 = fresh_value(state)
            condition_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(counter)
            state.operand_pool.push(high.value)
            if dynamic_range_step:
                state.operand_pool.push(step.value)
                direction: i64 = 2 if range_operator == TokenKind.RangeGt else (1 if range_operator == TokenKind.RangeLe else 0)
                state.instructions.push(Instruction{opcode: Opcode.RangeCondition, result: condition, result_type: type_from_name("bool"), operand_start: condition_start, operand_count: 3, integer: direction, span: ir_span(pos)})
            else:
                comparison: Opcode = Opcode.Greater if range_operator == TokenKind.RangeGt else (Opcode.LessEqual if range_operator == TokenKind.RangeLe else Opcode.Less)
                state.instructions.push(Instruction{opcode: comparison, result: condition, result_type: type_from_name("bool"), operand_start: condition_start, operand_count: 2, span: ir_span(pos)})
            exit_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition, operand_count: 1, target0: body_block, target1: exit_block, target_count: 2, edge1_arg_start: exit_args.start, edge1_arg_count: exit_args.count, span: ir_span(pos)}
            finish_block(state)

            outer_scope: usize = state.names.count
            state.structured_depth <- state.structured_depth + 1
            state.break_targets.push(exit_block)
            state.continue_targets.push(latch_block)
            state.current_block <- body_block
            state.terminated <- false
            state.names.push(variables[0])
            state.values.push(counter)
            state.types.push(low.type)
            state.mutables.push(false)
            for nested in body |state, return_type|:
                lower_statement(nested, return_type, state)
            if not state.terminated:
                body_args: (start: u32, count: u16) = append_context_arguments(state, context)
                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: latch_block, target_count: 1, edge0_arg_start: body_args.start, edge0_arg_count: body_args.count, span: ir_span(pos)}
            finish_block(state)
            _ = state.break_targets.pop()
            _ = state.continue_targets.pop()
            state.names.truncate(outer_scope)
            state.values.truncate(outer_scope)
            state.types.truncate(outer_scope)
            state.mutables.truncate(outer_scope)
            for offset in 0..<carried_indices.count |state, carried_indices, latch_values|:
                state.values[carried_indices[offset].usize()] <- latch_values[offset]

            state.current_block <- latch_block
            state.terminated <- false
            next_counter: u32 = fresh_value(state)
            step_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(counter)
            state.operand_pool.push(step.value)
            step_opcode: Opcode = Opcode.Subtract if range_operator == TokenKind.RangeGt else Opcode.Add
            state.instructions.push(Instruction{opcode: step_opcode, result: next_counter, result_type: low.type, operand_start: step_start, operand_count: 2, span: ir_span(pos)})
            backedge_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.edge_arg_pool.push(next_counter)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: backedge_args.start, edge0_arg_count: backedge_args.count + 1, span: ir_span(pos)}
            finish_block(state)

            state.structured_depth <- state.structured_depth - 1
            for offset in 0..<carried_indices.count |state, carried_indices, exit_values|:
                state.values[carried_indices[offset].usize()] <- exit_values[offset]
            _ = state.loop_context_starts.pop()
            _ = state.loop_context_counts.pop()
            _ = state.loop_handler_depths.pop()
            state.loop_carried_indices <- state.loop_carried_indices.truncate(context_start.usize())
            state.current_block <- exit_block
            state.terminated <- false
            return true


        # Lower the shortest length of two array/text sources.  The result is a
        # loop-invariant usize carried through a tiny state-machine merge, so
        # `zip(left, right)` can reuse the ordinary indexed loop without ever
        # allocating pairs or evaluating either source more than once.
        def lower_zip_limit(left: LoweredValue, right: LoweredValue, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            index_type: Type = type_from_name("usize")
            left_length: u32 = fresh_value(state)
            left_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(left.value)
            state.instructions.push(Instruction{opcode: Opcode.Length, result: left_length, result_type: index_type, operand_start: left_start, operand_count: 1, span: ir_span(pos)})
            right_length: u32 = fresh_value(state)
            right_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(right.value)
            state.instructions.push(Instruction{opcode: Opcode.Length, result: right_length, result_type: index_type, operand_start: right_start, operand_count: 1, span: ir_span(pos)})
            condition: u32 = fresh_value(state)
            condition_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(left_length)
            state.operand_pool.push(right_length)
            state.instructions.push(Instruction{opcode: Opcode.Less, result: condition, result_type: type_from_name("bool"), operand_start: condition_start, operand_count: 2, span: ir_span(pos)})

            selected_block: u32 = fresh_block(state)
            alternative_block: u32 = fresh_block(state)
            merge_block: u32 = fresh_block(state)
            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition, operand_count: 1, target0: selected_block, target1: alternative_block, target_count: 2, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- selected_block
            state.terminated <- false
            selected_edge_start: u32 = state.edge_arg_pool.count.u32()
            state.edge_arg_pool.push(left_length)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: selected_edge_start, edge0_arg_count: 1, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- alternative_block
            state.terminated <- false
            alternative_edge_start: u32 = state.edge_arg_pool.count.u32()
            state.edge_arg_pool.push(right_length)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: alternative_edge_start, edge0_arg_count: 1, span: ir_span(pos)}
            finish_block(state)

            result: u32 = fresh_value(state)
            state.pending_parameter_blocks.push(merge_block)
            state.pending_parameters.push(Parameter{value: result, type: index_type, name: "zip-limit"})
            state.current_block <- merge_block
            state.terminated <- false
            return LoweredValue{valid: true, value: result, type: index_type}


        # Python's enumerate accepts an optional starting cursor.  Keep the
        # loop binding exactly usize-typed: non-negative integer literals are
        # safely normalized to usize, while dynamic starts must already be an
        # exact usize value rather than relying on a lossy coercion.
        def lower_enumerate_start(expression: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            index_type: Type = type_from_name("usize")
            match expression:
                Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                    if value >= 0:
                        return emit_constant(state, index_type, value, "", "", false, ir_span(pos))
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "enumerate start must be a non-negative integer")
                    return LoweredValue{valid: false, value: 0, type: index_type}
                _:
                    pass
            lowered: LoweredValue = lower_expression(expression, state)
            if not lowered.valid or lowered.type.kind != TypeKind.Int or not same_type(lowered.type, index_type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "enumerate start must have exact usize type")
                return LoweredValue{valid: false, value: 0, type: index_type}
            return lowered


        def pattern_integer_value(text: sview, expected: Type&, valid: mutable bool&) -> i64:
            valid <- false
            length: usize = sview_len(text)
            return 0 if length == 0
            index: mutable usize = 0
            negative: mutable bool = false
            if sview_at(text, index) == 45:
                negative <- true
                index <- index + 1
            return 0 if index == length
            base: mutable i64 = 10
            if index + 1 < length and sview_at(text, index) == 48 and (sview_at(text, index + 1) == 120 or sview_at(text, index + 1) == 88):
                base <- 16
                index <- index + 2
            digit_start: usize = index
            magnitude: mutable i64 = 0
            while index < length |text, index, base, magnitude|:
                byte: u8 = sview_at(text, index)
                digit: mutable i64 = -1
                if byte >= 48 and byte <= 57:
                    digit <- (byte - 48).i64()
                elif base == 16 and byte >= 65 and byte <= 70:
                    digit <- (byte - 55).i64()
                elif base == 16 and byte >= 97 and byte <= 102:
                    digit <- (byte - 87).i64()
                break if digit < 0
                return 0 if magnitude > (9223372036854775807 - digit) / base
                magnitude <- magnitude * base + digit
                index <- index + 1
            return 0 if index == digit_start
            if index < length:
                suffix: sview = text[index:length]
                suffix_type: Type = type_from_name(suffix)
                return 0 if suffix_type.kind != TypeKind.Int or not same_type(suffix_type, expected)
            if negative:
                negative_fits: bool = negative_integer_literal_fits(magnitude, expected)
                valid <- negative_fits
                return -magnitude if negative_fits
            positive_fits: bool = positive_integer_literal_fits(magnitude, expected)
            valid <- positive_fits
            return magnitude if positive_fits
            return 0


        def lower_match_literal(text: sview, expected: Type, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            if expected.kind == TypeKind.Int:
                valid: mutable bool = false
                value: i64 = pattern_integer_value(text, expected, valid)
                if valid:
                    return emit_constant(state, expected, value, "", "", false, ir_span(pos))
            elif expected.kind == TypeKind.Bool:
                emit_constant(state, expected, 0, "", "", true, ir_span(pos)) return if text == "true"
                emit_constant(state, expected, 0, "", "", false, ir_span(pos)) return if text == "false"
            elif expected.kind == TypeKind.Float:
                return emit_constant(state, expected, 0, text, "", false, ir_span(pos))
            elif expected.kind == TypeKind.Text:
                return emit_constant(state, expected, 0, "", text, false, ir_span(pos))
            elif expected.kind == TypeKind.Char:
                length: usize = sview_len(text)
                return emit_constant(state, expected, 0, "", text[1:length - 1], false, ir_span(pos)) if length >= 2 and sview_at(text, 0) == 39 and sview_at(text, length - 1) == 39
            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "match literal does not have the scrutinee's scalar type")
            return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}


        def append_binding_arguments(state: mutable LowerState&, indices: darray[u32]&) -> (start: u32, count: u16) can[Memory.Allocate, Abort.Panic]:
            start: u32 = state.edge_arg_pool.count.u32()
            if indices.count > LOWER_U16_MAX:
                add_issue(state, LowerIssueKind.UnsupportedExpression, 0, "edge binding count exceeds the IR u16 limit")
                return (start, 0)
            for binding in indices |state|:
                state.edge_arg_pool.push(state.values[binding.usize()])
            return (start, indices.count.u16())


        # Regular scalar match arms keep their source-order semantics when an
        # `A | B` pattern is expanded into adjacent arms that share the original
        # guard and body.  This mirrors the parser's decision-table expansion and
        # lets the existing typed arm lowering handle each alternative independently.
        def expand_match_or_arms(arms: darray[Ast::MatchArm]&, expanded: mutable darray[Ast::MatchArm]&) -> bool can[Memory.Allocate, Abort.Panic]:
            expanded_any: mutable bool = false
            for arm in arms |arms, expanded, expanded_any|:
                match arm.pattern:
                    Pattern.Or(options):
                        expanded_any <- true
                        for option in options |expanded, arm|:
                            expanded.push(Ast::MatchArm{pattern: option, body: arm.body, guard: arm.guard})
                    _:
                        expanded.push(arm)
            return expanded_any


        def supported_scalar_match(arms: darray[Ast::MatchArm]&, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            supported: mutable bool = true
            for index in 0..<arms.count |arms, pos, state, supported|:
                arm: Ast::MatchArm = arms[index]
                catch_all: mutable bool = false
                match arm.pattern:
                    Pattern.Literal(text) | Pattern.Pin(text) | Pattern.Range(text, _, _):
                        pass
                    Pattern.Wildcard | Pattern.Binding(_):
                        catch_all <- true
                    _:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "initial match lowering supports scalar literals, pins, bindings, and wildcard patterns")
                        supported <- false
                guarded: mutable bool = false
                match arm.guard:
                    Expr.Absent:
                        pass
                    _:
                        guarded <- true
                if catch_all and not guarded and index + 1 != arms.count:
                    add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "a catch-all match arm must be last")
                    supported <- false
            return supported


        def scalar_match_exhaustive(type: Type&, arms: darray[Ast::MatchArm]&) -> bool:
            saw_true: mutable bool = false
            saw_false: mutable bool = false
            for arm in arms |saw_true, saw_false|:
                guarded: mutable bool = false
                match arm.guard:
                    Expr.Absent:
                        pass
                    _:
                        guarded <- true
                continue if guarded
                match arm.pattern:
                    Pattern.Wildcard | Pattern.Binding(_):
                        return true
                    Pattern.Literal(text):
                        saw_true <- true if text == "true"
                        saw_false <- true if text == "false"
                    _:
                        pass
            return type.kind == TypeKind.Bool and saw_true and saw_false


        # Array/list patterns are lowered through the same explicit CFG as scalar
        # matches.  The initial structural subset intentionally stays small: a
        # pattern may contain array-element bindings, literals, or wildcards,
        # followed by one optional `...rest` tail.  Nested patterns remain
        # rejected until the IR has a first-class aggregate-pattern representation.
        def array_match_pattern_parts(pattern: Ast::Pattern, prefixes: mutable darray[Ast::Pattern]&, rest_name: mutable sview&, has_rest: mutable bool&, valid: mutable bool&) -> bool:
            match pattern:
                Pattern.Tuple(elements):
                    seen_rest: mutable bool = false
                    for element in elements |prefixes, rest_name, has_rest, valid, seen_rest|:
                        match element:
                            Pattern.Rest(name):
                                valid <- false if seen_rest
                                seen_rest <- true
                                has_rest <- true
                                rest_name <- name
                            Pattern.Binding(_) | Pattern.Literal(_) | Pattern.Wildcard:
                                valid <- false if seen_rest
                                prefixes.push(element) if not seen_rest
                            _:
                                valid <- false
                    return true
                Pattern.Rest(name):
                    rest_name <- name
                    has_rest <- true
                    return true
                _:
                    pass
            return false


        def array_match_pattern_is_structural(pattern: Ast::Pattern) -> bool:
            match pattern:
                Pattern.Tuple(_) | Pattern.Rest(_):
                    return true
                Pattern.Or(options):
                    return any option in options where array_match_pattern_is_structural(option)
                _:
                    pass
            return false


        def array_match_has_structural_pattern(arms: darray[Ast::MatchArm]&) -> bool:
            return any arm in arms where array_match_pattern_is_structural(arm.pattern)


        def supported_array_match(arms: darray[Ast::MatchArm]&, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            supported: mutable bool = true
            for index in 0..<arms.count |arms, pos, state, supported|:
                arm: Ast::MatchArm = arms[index]
                catch_all: mutable bool = false
                match arm.pattern:
                    Pattern.Tuple(_) | Pattern.Rest(_):
                        prefixes: mutable darray[Ast::Pattern] = []
                        rest_name: mutable sview = ""
                        has_rest: mutable bool = false
                        valid: mutable bool = true
                        array_match_pattern_parts(arm.pattern, prefixes, rest_name, has_rest, valid)
                        if not valid:
                            add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "array match patterns support element bindings, literals, or wildcards and one trailing rest pattern")
                            supported <- false
                        catch_all <- has_rest and prefixes.count == 0
                    Pattern.Wildcard | Pattern.Binding(_):
                        catch_all <- true
                    _:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "array match lowering supports prefix/rest patterns, bindings, and wildcard arms")
                        supported <- false
                guarded: mutable bool = false
                match arm.guard:
                    Expr.Absent:
                        pass
                    _:
                        guarded <- true
                if catch_all and not guarded and index + 1 != arms.count:
                    add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "a catch-all array match arm must be last")
                    supported <- false
            return supported


        def array_match_exhaustive(arms: darray[Ast::MatchArm]&) -> bool:
            for arm in arms:
                guarded: mutable bool = false
                match arm.guard:
                    Expr.Absent:
                        pass
                    _:
                        guarded <- true
                continue if guarded
                match arm.pattern:
                    Pattern.Wildcard | Pattern.Binding(_) | Pattern.Rest(_):
                        return true
                    Pattern.Tuple(elements):
                        if elements.count == 1:
                            match elements[0]:
                                Pattern.Rest(_):
                                    return true
                                _:
                                    pass
                    _:
                        pass
            return false


        def lower_array_match_bindings(prefixes: darray[Ast::Pattern]&, rest_name: sview, has_rest: bool, scrutinee: LoweredValue&, length_value: u32, pos: Ast::Pos&, state: mutable LowerState&) -> void can[Memory.Allocate, Abort.Panic]:
            element_type: Type = array_element_type(scrutinee.type)
            for index in 0..<prefixes.count |prefixes, scrutinee, element_type, pos, state|:
                match prefixes[index]:
                    Pattern.Binding(name):
                        index_value: LoweredValue = emit_constant(state, type_from_name("usize"), index.i64(), "", "", false, ir_span(pos))
                        element_value: u32 = fresh_value(state)
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(scrutinee.value)
                        state.operand_pool.push(index_value.value)
                        state.instructions.push(Instruction{opcode: Opcode.Index, result: element_value, result_type: element_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                        state.names.push(name)
                        state.values.push(element_value)
                        state.types.push(element_type)
                        state.mutables.push(false)
                    _:
                        pass
            if has_rest and rest_name != "" and rest_name != "_":
                low_value: LoweredValue = emit_constant(state, type_from_name("usize"), prefixes.count.i64(), "", "", false, ir_span(pos))
                rest_value: u32 = fresh_value(state)
                rest_operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(scrutinee.value)
                state.operand_pool.push(low_value.value)
                state.operand_pool.push(length_value)
                state.instructions.push(Instruction{opcode: Opcode.Slice, result: rest_value, result_type: scrutinee.type, operand_start: rest_operand_start, operand_count: 3, span: ir_span(pos)})
                state.names.push(rest_name)
                state.values.push(rest_value)
                state.types.push(scrutinee.type)
                state.mutables.push(false)


        def lower_array_match(scrutinee_expression: Ast::Expr, arms: darray[Ast::MatchArm]&, return_type: Type, pos: Ast::Pos&, state: mutable LowerState&) -> void can[Memory.Allocate, Abort.Panic]:
            expanded_arms: mutable darray[Ast::MatchArm] = []
            if expand_match_or_arms(arms, expanded_arms):
                lower_array_match(scrutinee_expression, expanded_arms, return_type, pos, state)
                return
            scrutinee: LoweredValue = lower_expression(scrutinee_expression, state)
            return if not scrutinee.valid or not supported_array_match(arms, pos, state)
            if scrutinee.type.kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "structural array match requires an array scrutinee")
                return

            scope_mark: usize = state.names.count
            base_values: mutable darray[u32] = []
            base_values.extend(state.values)
            assigned_names: mutable darray[sview] = []
            for arm in arms |assigned_names|:
                collect_assigned_names(arm.body, assigned_names)
            include_mutable_element_owners(state, assigned_names)
            carried_indices: mutable darray[u32] = []
            for name in assigned_names |state, carried_indices|:
                index: usize = binding_index(state, name)
                carried_indices.push(index.u32()) if index < scope_mark

            merge_block: u32 = fresh_block(state)
            merged_values: mutable darray[u32] = []
            for binding_u32 in carried_indices |state, merge_block, merged_values|:
                binding: usize = binding_u32.usize()
                merged: u32 = fresh_value(state)
                state.pending_parameter_blocks.push(merge_block)
                state.pending_parameters.push(Parameter{value: merged, type: state.types[binding], name: state.names[binding]})
                merged_values.push(merged)

            state.structured_depth <- state.structured_depth + 1
            any_fallthrough: mutable bool = arms.count == 0
            exhaustive: bool = array_match_exhaustive(arms)
            for arm_index in 0..<arms.count |state, arms, pos, scrutinee, return_type, scope_mark, base_values, carried_indices, merge_block, any_fallthrough, exhaustive|:
                arm: Ast::MatchArm = arms[arm_index]
                body_block: u32 = fresh_block(state)
                final_arm: bool = arm_index + 1 == arms.count
                next_test_block: u32 = merge_block if final_arm and exhaustive else fresh_block(state)
                guarded: mutable bool = false
                match arm.guard:
                    Expr.Absent:
                        pass
                    _:
                        guarded <- true
                matched_block: u32 = fresh_block(state) if guarded else body_block
                binder: mutable sview = ""
                catch_all: mutable bool = false
                condition: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
                prefixes: mutable darray[Ast::Pattern] = []
                rest_name: mutable sview = ""
                has_rest: mutable bool = false
                element_type: Type = array_element_type(scrutinee.type)
                length_value: mutable u32 = 0
                test_emitted: mutable bool = false
                match arm.pattern:
                    Pattern.Tuple(_) | Pattern.Rest(_):
                        pattern_valid: mutable bool = true
                        array_match_pattern_parts(arm.pattern, prefixes, rest_name, has_rest, pattern_valid)
                        if pattern_valid:
                            length_value <- fresh_value(state)
                            length_operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(scrutinee.value)
                            state.instructions.push(Instruction{opcode: Opcode.Length, result: length_value, result_type: type_from_name("usize"), operand_start: length_operand_start, operand_count: 1, span: ir_span(pos)})
                            shape_value: LoweredValue = emit_constant(state, type_from_name("usize"), prefixes.count.i64(), "", "", false, ir_span(pos))
                            shape_result: u32 = fresh_value(state)
                            shape_operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(length_value)
                            state.operand_pool.push(shape_value.value)
                            shape_opcode: Opcode = Opcode.GreaterEqual if has_rest else Opcode.Equal
                            state.instructions.push(Instruction{opcode: shape_opcode, result: shape_result, result_type: type_from_name("bool"), operand_start: shape_operand_start, operand_count: 2, span: ir_span(pos)})
                            literal_positions: mutable darray[usize] = []
                            for prefix_index in 0..<prefixes.count |prefixes, literal_positions|:
                                match prefixes[prefix_index]:
                                    Pattern.Literal(_):
                                        literal_positions.push(prefix_index)
                                    _:
                                        pass
                            if literal_positions.count != 0:
                                literal_check_block: u32 = fresh_block(state)
                                if next_test_block == merge_block:
                                    shape_fallthrough_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                                    state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: shape_result, operand_count: 1, target0: literal_check_block, target1: next_test_block, target_count: 2, edge1_arg_start: shape_fallthrough_args.start, edge1_arg_count: shape_fallthrough_args.count, span: ir_span(pos)}
                                    any_fallthrough <- true
                                else:
                                    state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: shape_result, operand_count: 1, target0: literal_check_block, target1: next_test_block, target_count: 2, span: ir_span(pos)}
                                finish_block(state)
                                test_emitted <- true
                                state.current_block <- literal_check_block
                                state.terminated <- false
                                literal_failed: mutable bool = false
                                for literal_offset in 0..<literal_positions.count |state, prefixes, literal_positions, scrutinee, element_type, literal_failed, matched_block, next_test_block, merge_block, carried_indices, any_fallthrough|:
                                    if not literal_failed:
                                        prefix_index: usize = literal_positions[literal_offset]
                                        literal_text: mutable sview = ""
                                        match prefixes[prefix_index]:
                                            Pattern.Literal(text):
                                                literal_text <- text
                                            _:
                                                pass
                                        literal: LoweredValue = lower_match_literal(literal_text, element_type, pos, state)
                                        if literal.valid:
                                            index_value: LoweredValue = emit_constant(state, type_from_name("usize"), prefix_index.i64(), "", "", false, ir_span(pos))
                                            element_value: u32 = fresh_value(state)
                                            element_operand_start: u32 = state.operand_pool.count.u32()
                                            state.operand_pool.push(scrutinee.value)
                                            state.operand_pool.push(index_value.value)
                                            state.instructions.push(Instruction{opcode: Opcode.Index, result: element_value, result_type: element_type, operand_start: element_operand_start, operand_count: 2, span: ir_span(pos)})
                                            comparison: u32 = fresh_value(state)
                                            comparison_operand_start: u32 = state.operand_pool.count.u32()
                                            state.operand_pool.push(element_value)
                                            state.operand_pool.push(literal.value)
                                            state.instructions.push(Instruction{opcode: Opcode.Equal, result: comparison, result_type: type_from_name("bool"), operand_start: comparison_operand_start, operand_count: 2, span: ir_span(pos)})
                                            final_literal: bool = literal_offset + 1 == literal_positions.count
                                            literal_next_block: u32 = matched_block if final_literal else fresh_block(state)
                                            if next_test_block == merge_block:
                                                literal_fallthrough_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                                                state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: comparison, operand_count: 1, target0: literal_next_block, target1: next_test_block, target_count: 2, edge1_arg_start: literal_fallthrough_args.start, edge1_arg_count: literal_fallthrough_args.count, span: ir_span(pos)}
                                                any_fallthrough <- true
                                            else:
                                                state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: comparison, operand_count: 1, target0: literal_next_block, target1: next_test_block, target_count: 2, span: ir_span(pos)}
                                            finish_block(state)
                                            if not final_literal:
                                                state.current_block <- literal_next_block
                                                state.terminated <- false
                                        else:
                                            literal_failed <- true
                                            state.terminator <- Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)}
                                            finish_block(state)
                            else:
                                condition <- LoweredValue{valid: true, value: shape_result, type: type_from_name("bool")}
                    Pattern.Binding(name):
                        binder <- name
                        catch_all <- true
                    Pattern.Wildcard:
                        catch_all <- true
                    _:
                        pass
                if not test_emitted:
                    if catch_all:
                        state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: matched_block, target_count: 1, span: ir_span(pos)}
                    elif condition.valid:
                        if next_test_block == merge_block:
                            fallthrough_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition.value, operand_count: 1, target0: matched_block, target1: next_test_block, target_count: 2, edge1_arg_start: fallthrough_args.start, edge1_arg_count: fallthrough_args.count, span: ir_span(pos)}
                            any_fallthrough <- true
                        else:
                            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition.value, operand_count: 1, target0: matched_block, target1: next_test_block, target_count: 2, span: ir_span(pos)}
                    finish_block(state)

                if guarded:
                    for index in 0..<scope_mark |state, base_values|:
                        state.values[index] <- base_values[index]
                    state.current_block <- matched_block
                    state.terminated <- false
                    if prefixes.count != 0 or has_rest:
                        lower_array_match_bindings(prefixes, rest_name, has_rest, scrutinee, length_value, pos, state)
                    elif binder != "":
                        state.names.push(binder)
                        state.values.push(scrutinee.value)
                        state.types.push(scrutinee.type)
                        state.mutables.push(false)
                    guard_value: LoweredValue = lower_expression(arm.guard, state)
                    guard_valid: mutable bool = guard_value.valid
                    if guard_value.valid and guard_value.type.kind != TypeKind.Bool:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "match arm guard must have boolean type")
                        guard_valid <- false
                    if guard_valid:
                        if next_test_block == merge_block:
                            guard_fallthrough_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: guard_value.value, operand_count: 1, target0: body_block, target1: next_test_block, target_count: 2, edge1_arg_start: guard_fallthrough_args.start, edge1_arg_count: guard_fallthrough_args.count, span: ir_span(pos)}
                            any_fallthrough <- true
                        else:
                            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: guard_value.value, operand_count: 1, target0: body_block, target1: next_test_block, target_count: 2, span: ir_span(pos)}
                    else:
                        state.terminator <- Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)}
                    finish_block(state)
                    state.names.truncate(scope_mark)
                    state.values.truncate(scope_mark)
                    state.types.truncate(scope_mark)
                    state.mutables.truncate(scope_mark)

                for index in 0..<scope_mark |state, base_values|:
                    state.values[index] <- base_values[index]
                state.current_block <- body_block
                state.terminated <- false
                if prefixes.count != 0 or has_rest:
                    lower_array_match_bindings(prefixes, rest_name, has_rest, scrutinee, length_value, pos, state)
                elif binder != "":
                    state.names.push(binder)
                    state.values.push(scrutinee.value)
                    state.types.push(scrutinee.type)
                    state.mutables.push(false)
                for nested in arm.body |state, return_type|:
                    lower_statement(nested, return_type, state)
                if not state.terminated:
                    arm_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: arm_args.start, edge0_arg_count: arm_args.count, span: ir_span(pos)}
                    any_fallthrough <- true
                finish_block(state)
                state.names.truncate(scope_mark)
                state.values.truncate(scope_mark)
                state.types.truncate(scope_mark)
                state.mutables.truncate(scope_mark)
                for index in 0..<scope_mark |state, base_values|:
                    state.values[index] <- base_values[index]
                state.current_block <- next_test_block
                state.terminated <- false

            if arms.count == 0:
                empty_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: empty_args.start, edge0_arg_count: empty_args.count, span: ir_span(pos)}
                finish_block(state)
            elif not exhaustive or not any_fallthrough:
                state.terminator <- Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)}
                finish_block(state)
            state.structured_depth <- state.structured_depth - 1
            if any_fallthrough:
                for offset in 0..<carried_indices.count |state, carried_indices, merged_values|:
                    state.values[carried_indices[offset].usize()] <- merged_values[offset]
                state.current_block <- merge_block
                state.terminated <- false
            else:
                state.terminated <- true


        def lower_scalar_match(scrutinee_expression: Ast::Expr, arms: darray[Ast::MatchArm]&, return_type: Type, pos: Ast::Pos&, state: mutable LowerState&) -> void can[Memory.Allocate, Abort.Panic]:
            expanded_arms: mutable darray[Ast::MatchArm] = []
            if expand_match_or_arms(arms, expanded_arms):
                lower_scalar_match(scrutinee_expression, expanded_arms, return_type, pos, state)
                return
            scrutinee: LoweredValue = lower_expression(scrutinee_expression, state)
            return if not scrutinee.valid or not supported_scalar_match(arms, pos, state)
            if scrutinee.type.kind not in {TypeKind.Int, TypeKind.Float, TypeKind.Bool, TypeKind.Char, TypeKind.Text}:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "scalar match requires an integer, float, boolean, character, or text scrutinee")
                return

            scope_mark: usize = state.names.count
            base_values: mutable darray[u32] = []
            base_values.extend(state.values)
            assigned_names: mutable darray[sview] = []
            for arm in arms |assigned_names|:
                collect_assigned_names(arm.body, assigned_names)
            include_mutable_element_owners(state, assigned_names)
            carried_indices: mutable darray[u32] = []
            for name in assigned_names |state, carried_indices|:
                index: usize = binding_index(state, name)
                carried_indices.push(index.u32()) if index < scope_mark

            merge_block: u32 = fresh_block(state)
            merged_values: mutable darray[u32] = []
            for binding_u32 in carried_indices |state, merge_block, merged_values|:
                binding: usize = binding_u32.usize()
                merged: u32 = fresh_value(state)
                state.pending_parameter_blocks.push(merge_block)
                state.pending_parameters.push(Parameter{value: merged, type: state.types[binding], name: state.names[binding]})
                merged_values.push(merged)

            state.structured_depth <- state.structured_depth + 1
            any_fallthrough: mutable bool = arms.count == 0
            exhaustive: bool = scalar_match_exhaustive(scrutinee.type, arms)
            for arm_index in 0..<arms.count |state, arms, pos, scrutinee, return_type, scope_mark, base_values, carried_indices, merge_block, any_fallthrough, exhaustive|:
                arm: Ast::MatchArm = arms[arm_index]
                body_block: u32 = fresh_block(state)
                final_arm: bool = arm_index + 1 == arms.count
                next_test_block: u32 = merge_block if final_arm and not exhaustive else fresh_block(state)
                guarded: mutable bool = false
                match arm.guard:
                    Expr.Absent:
                        pass
                    _:
                        guarded <- true
                matched_block: u32 = fresh_block(state) if guarded else body_block
                binder: mutable sview = ""
                catch_all: mutable bool = false
                condition: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
                match arm.pattern:
                    Pattern.Literal(text):
                        literal: LoweredValue = lower_match_literal(text, scrutinee.type, pos, state)
                        if literal.valid:
                            result: u32 = fresh_value(state)
                            operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(scrutinee.value)
                            state.operand_pool.push(literal.value)
                            state.instructions.push(Instruction{opcode: Opcode.Equal, result: result, result_type: type_from_name("bool"), operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                            condition <- LoweredValue{valid: true, value: result, type: type_from_name("bool")}
                    Pattern.Range(lo_text, hi_text, inclusive):
                        if scrutinee.type.kind != TypeKind.Int and scrutinee.type.kind != TypeKind.Float:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range pattern requires a numeric scalar scrutinee")
                        else:
                            low: LoweredValue = lower_match_literal(lo_text, scrutinee.type, pos, state)
                            high: LoweredValue = lower_match_literal(hi_text, scrutinee.type, pos, state)
                            if low.valid and high.valid:
                                lower_result: u32 = fresh_value(state)
                                lower_operands: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(scrutinee.value)
                                state.operand_pool.push(low.value)
                                state.instructions.push(Instruction{opcode: Opcode.GreaterEqual, result: lower_result, result_type: type_from_name("bool"), operand_start: lower_operands, operand_count: 2, span: ir_span(pos)})
                                upper_test_block: u32 = fresh_block(state)
                                if next_test_block == merge_block:
                                    lower_fallthrough_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                                    state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: lower_result, operand_count: 1, target0: upper_test_block, target1: next_test_block, target_count: 2, edge1_arg_start: lower_fallthrough_args.start, edge1_arg_count: lower_fallthrough_args.count, span: ir_span(pos)}
                                    any_fallthrough <- true
                                else:
                                    state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: lower_result, operand_count: 1, target0: upper_test_block, target1: next_test_block, target_count: 2, span: ir_span(pos)}
                                finish_block(state)
                                state.current_block <- upper_test_block
                                state.terminated <- false
                                upper_result: u32 = fresh_value(state)
                                upper_operands: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(scrutinee.value)
                                state.operand_pool.push(high.value)
                                upper_opcode: Opcode = Opcode.LessEqual if inclusive else Opcode.Less
                                state.instructions.push(Instruction{opcode: upper_opcode, result: upper_result, result_type: type_from_name("bool"), operand_start: upper_operands, operand_count: 2, span: ir_span(pos)})
                                condition <- LoweredValue{valid: true, value: upper_result, type: type_from_name("bool")}
                    Pattern.Pin(name):
                        pinned: LoweredValue = lookup_binding(state, name)
                        if not pinned.valid or not same_type(pinned.type, scrutinee.type):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "pinned match binding must exist and match the scrutinee type")
                        else:
                            result: u32 = fresh_value(state)
                            operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(scrutinee.value)
                            state.operand_pool.push(pinned.value)
                            state.instructions.push(Instruction{opcode: Opcode.Equal, result: result, result_type: type_from_name("bool"), operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                            condition <- LoweredValue{valid: true, value: result, type: type_from_name("bool")}
                    Pattern.Binding(name):
                        binder <- name
                        catch_all <- true
                    Pattern.Wildcard:
                        catch_all <- true
                    _:
                        pass
                if catch_all:
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: matched_block, target_count: 1, span: ir_span(pos)}
                elif condition.valid:
                    if final_arm and not exhaustive:
                        unmatched_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition.value, operand_count: 1, target0: matched_block, target1: next_test_block, target_count: 2, edge1_arg_start: unmatched_args.start, edge1_arg_count: unmatched_args.count, span: ir_span(pos)}
                        any_fallthrough <- true
                    else:
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition.value, operand_count: 1, target0: matched_block, target1: next_test_block, target_count: 2, span: ir_span(pos)}
                finish_block(state)

                if guarded:
                    for index in 0..<scope_mark |state, base_values|:
                        state.values[index] <- base_values[index]
                    state.current_block <- matched_block
                    state.terminated <- false
                    if binder != "":
                        state.names.push(binder)
                        state.values.push(scrutinee.value)
                        state.types.push(scrutinee.type)
                        state.mutables.push(false)
                    guard_value: LoweredValue = lower_expression(arm.guard, state)
                    guard_valid: mutable bool = guard_value.valid
                    if guard_value.valid and guard_value.type.kind != TypeKind.Bool:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "match arm guard must have boolean type")
                        guard_valid <- false
                    if guard_valid:
                        if next_test_block == merge_block:
                            guard_fallthrough_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: guard_value.value, operand_count: 1, target0: body_block, target1: next_test_block, target_count: 2, edge1_arg_start: guard_fallthrough_args.start, edge1_arg_count: guard_fallthrough_args.count, span: ir_span(pos)}
                            any_fallthrough <- true
                        else:
                            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: guard_value.value, operand_count: 1, target0: body_block, target1: next_test_block, target_count: 2, span: ir_span(pos)}
                    finish_block(state)
                    state.names.truncate(scope_mark)
                    state.values.truncate(scope_mark)
                    state.types.truncate(scope_mark)
                    state.mutables.truncate(scope_mark)

                for index in 0..<scope_mark |state, base_values|:
                    state.values[index] <- base_values[index]
                state.current_block <- body_block
                state.terminated <- false
                if binder != "":
                    state.names.push(binder)
                    state.values.push(scrutinee.value)
                    state.types.push(scrutinee.type)
                    state.mutables.push(false)
                for nested in arm.body |state, return_type|:
                    lower_statement(nested, return_type, state)
                if not state.terminated:
                    arm_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: arm_args.start, edge0_arg_count: arm_args.count, span: ir_span(pos)}
                    any_fallthrough <- true
                finish_block(state)
                state.names.truncate(scope_mark)
                state.values.truncate(scope_mark)
                state.types.truncate(scope_mark)
                state.mutables.truncate(scope_mark)
                for index in 0..<scope_mark |state, base_values|:
                    state.values[index] <- base_values[index]
                state.current_block <- next_test_block
                state.terminated <- false

            if arms.count == 0:
                empty_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: empty_args.start, edge0_arg_count: empty_args.count, span: ir_span(pos)}
                finish_block(state)
            elif exhaustive:
                state.terminator <- Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)}
                finish_block(state)
            state.structured_depth <- state.structured_depth - 1
            if any_fallthrough:
                for offset in 0..<carried_indices.count |state, carried_indices, merged_values|:
                    state.values[carried_indices[offset].usize()] <- merged_values[offset]
                state.current_block <- merge_block
                state.terminated <- false
            else:
                state.terminated <- true


        # Expression-form scalar matches use the same ordered decision states as
        # statement matches, but each successful arm contributes one value to an
        # SSA merge parameter.  Keeping this separate from the statement helper
        # avoids making the latter carry an optional result through every arm and
        # preserves its existing mutable-binding merge behavior.
        def lower_scalar_match_value(scrutinee_expression: Ast::Expr, arms: darray[Ast::MatchArm]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            expanded_arms: mutable darray[Ast::MatchArm] = []
            if expand_match_or_arms(arms, expanded_arms):
                return lower_scalar_match_value(scrutinee_expression, expanded_arms, pos, state)
            scrutinee: LoweredValue = lower_expression(scrutinee_expression, state)
            return LoweredValue{valid: false, value: 0, type: unknown_ir_type()} if not scrutinee.valid
            if not supported_scalar_match(arms, pos, state):
                return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            if scrutinee.type.kind not in {TypeKind.Int, TypeKind.Float, TypeKind.Bool, TypeKind.Char, TypeKind.Text}:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "expression match requires an integer, float, boolean, character, or text scrutinee")
                return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            if not scalar_match_exhaustive(scrutinee.type, arms):
                add_issue(state, LowerIssueKind.MissingReturn, pos.line, "expression match must be exhaustive or end with an unguarded catch-all arm")
                return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}

            # Expression arms are value blocks.  Probe their tails before creating
            # the merge parameter so every edge agrees on one statically known type.
            result_type: mutable Type = unknown_ir_type()
            result_known: mutable bool = false
            arm_values: mutable darray[Ast::Expr] = []
            arm_binders: mutable darray[sview] = []
            for arm in arms |state, pos, scrutinee, result_type, result_known, arm_values, arm_binders|:
                if arm.body.count != 1:
                    add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "expression match arms must contain exactly one value expression")
                    arm_values.push(Expr.Invalid)
                    arm_binders.push("")
                    continue
                tail_expression: mutable Ast::Expr = Expr.Invalid
                match arm.body[0]:
                    Stmt.Expr(expression, _):
                        tail_expression <- expression
                    _:
                        pass
                if tail_expression is Expr.Invalid:
                    add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "expression match arms must end in a value expression")
                    arm_values.push(Expr.Invalid)
                    arm_binders.push("")
                    continue
                binder: mutable sview = ""
                match arm.pattern:
                    Pattern.Binding(name):
                        binder <- name
                    _:
                        pass
                # The probe helper snapshots all emitted IR and diagnostics.  A
                # synthetic name is used for arms without a binder so identifiers
                # in the value still resolve against the surrounding lexical scope.
                probe_name: sview = binder if binder != "" else "__elisascript_match_probe"
                probed: LoweredValue = probe_comprehension_body(tail_expression, probe_name, scrutinee.type, "", unknown_ir_type(), pos, state)
                if not probed.valid:
                    add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "expression match arm value must be a straight-line typed expression")
                elif not result_known:
                    result_type <- probed.type
                    result_known <- true
                elif not same_type(result_type, probed.type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "expression match arms must produce one static type")
                arm_values.push(tail_expression)
                arm_binders.push(binder)
            if not result_known:
                return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}

            scope_mark: usize = state.names.count
            base_values: mutable darray[u32] = []
            base_values.extend(state.values)
            assigned_names: mutable darray[sview] = []
            for arm in arms |assigned_names|:
                collect_assigned_names(arm.body, assigned_names)
            include_mutable_element_owners(state, assigned_names)
            carried_indices: mutable darray[u32] = []
            for name in assigned_names |state, carried_indices|:
                index: usize = binding_index(state, name)
                carried_indices.push(index.u32()) if index < scope_mark

            merge_block: u32 = fresh_block(state)
            merged_values: mutable darray[u32] = []
            for binding_u32 in carried_indices |state, merge_block, merged_values|:
                binding: usize = binding_u32.usize()
                merged: u32 = fresh_value(state)
                state.pending_parameter_blocks.push(merge_block)
                state.pending_parameters.push(Parameter{value: merged, type: state.types[binding], name: state.names[binding]})
                merged_values.push(merged)
            result: u32 = fresh_value(state)
            state.pending_parameter_blocks.push(merge_block)
            state.pending_parameters.push(Parameter{value: result, type: result_type, name: "match-result"})

            state.structured_depth <- state.structured_depth + 1
            for arm_index in 0..<arms.count |state, arms, arm_values, arm_binders, pos, scrutinee, scope_mark, base_values, carried_indices, merge_block, result_type|:
                arm: Ast::MatchArm = arms[arm_index]
                body_block: u32 = fresh_block(state)
                next_test_block: u32 = fresh_block(state)
                guarded: mutable bool = false
                match arm.guard:
                    Expr.Absent:
                        pass
                    _:
                        guarded <- true
                matched_block: u32 = fresh_block(state) if guarded else body_block
                binder: sview = arm_binders[arm_index]
                catch_all: mutable bool = false
                range_test: mutable bool = false
                condition: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
                match arm.pattern:
                    Pattern.Literal(text):
                        literal: LoweredValue = lower_match_literal(text, scrutinee.type, pos, state)
                        if literal.valid:
                            condition <- emit_comparison(state, Opcode.Equal, scrutinee.value, literal.value, pos)
                    Pattern.Range(lo_text, hi_text, inclusive):
                        if scrutinee.type.kind != TypeKind.Int and scrutinee.type.kind != TypeKind.Float:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range pattern requires a numeric scalar scrutinee")
                        else:
                            low: LoweredValue = lower_match_literal(lo_text, scrutinee.type, pos, state)
                            high: LoweredValue = lower_match_literal(hi_text, scrutinee.type, pos, state)
                            if low.valid and high.valid:
                                lower_result: u32 = fresh_value(state)
                                lower_operands: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(scrutinee.value)
                                state.operand_pool.push(low.value)
                                state.instructions.push(Instruction{opcode: Opcode.GreaterEqual, result: lower_result, result_type: type_from_name("bool"), operand_start: lower_operands, operand_count: 2, span: ir_span(pos)})
                                upper_test_block: u32 = fresh_block(state)
                                lower_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                                state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: lower_result, operand_count: 1, target0: upper_test_block, target1: next_test_block, target_count: 2, edge1_arg_start: lower_args.start, edge1_arg_count: lower_args.count, span: ir_span(pos)}
                                finish_block(state)
                                state.current_block <- upper_test_block
                                state.terminated <- false
                                upper_result: u32 = fresh_value(state)
                                upper_operands: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(scrutinee.value)
                                state.operand_pool.push(high.value)
                                upper_opcode: Opcode = Opcode.LessEqual if inclusive else Opcode.Less
                                state.instructions.push(Instruction{opcode: upper_opcode, result: upper_result, result_type: type_from_name("bool"), operand_start: upper_operands, operand_count: 2, span: ir_span(pos)})
                                condition <- LoweredValue{valid: true, value: upper_result, type: type_from_name("bool")}
                                range_test <- true
                    Pattern.Pin(name):
                        pinned: LoweredValue = lookup_binding(state, name)
                        if not pinned.valid or not same_type(pinned.type, scrutinee.type):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "pinned match binding must exist and match the scrutinee type")
                        else:
                            condition <- emit_comparison(state, Opcode.Equal, scrutinee.value, pinned.value, pos)
                    Pattern.Binding(_):
                        catch_all <- true
                    Pattern.Wildcard:
                        catch_all <- true
                    _:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "expression match supports scalar literals, pins, bindings, and wildcard patterns")
                if range_test:
                    range_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                    state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition.value, operand_count: 1, target0: matched_block, target1: next_test_block, target_count: 2, edge1_arg_start: range_args.start, edge1_arg_count: range_args.count, span: ir_span(pos)} if condition.valid
                    state.terminator <- Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)} if not condition.valid
                elif catch_all:
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: matched_block, target_count: 1, span: ir_span(pos)}
                elif condition.valid:
                    fallthrough_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                    state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition.value, operand_count: 1, target0: matched_block, target1: next_test_block, target_count: 2, edge1_arg_start: fallthrough_args.start, edge1_arg_count: fallthrough_args.count, span: ir_span(pos)}
                else:
                    state.terminator <- Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)}
                finish_block(state)

                if guarded:
                    for index in 0..<scope_mark |state, base_values|:
                        state.values[index] <- base_values[index]
                    state.current_block <- matched_block
                    state.terminated <- false
                    if binder != "":
                        state.names.push(binder)
                        state.values.push(scrutinee.value)
                        state.types.push(scrutinee.type)
                        state.mutables.push(false)
                    guard_value: LoweredValue = lower_expression(arm.guard, state)
                    if guard_value.valid and guard_value.type.kind == TypeKind.Bool:
                        guard_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: guard_value.value, operand_count: 1, target0: body_block, target1: next_test_block, target_count: 2, edge1_arg_start: guard_args.start, edge1_arg_count: guard_args.count, span: ir_span(pos)}
                    else:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "match arm guard must have boolean type") if guard_value.valid
                        state.terminator <- Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)}
                    finish_block(state)
                    state.names.truncate(scope_mark)
                    state.values.truncate(scope_mark)
                    state.types.truncate(scope_mark)
                    state.mutables.truncate(scope_mark)

                for index in 0..<scope_mark |state, base_values|:
                    state.values[index] <- base_values[index]
                state.current_block <- body_block
                state.terminated <- false
                if binder != "":
                    state.names.push(binder)
                    state.values.push(scrutinee.value)
                    state.types.push(scrutinee.type)
                    state.mutables.push(false)
                arm_value: LoweredValue = lower_expression(arm_values[arm_index], state)
                if arm_value.valid and same_type(arm_value.type, result_type):
                    arm_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                    state.edge_arg_pool.push(arm_value.value)
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: arm_args.start, edge0_arg_count: arm_args.count + 1, span: ir_span(pos)}
                else:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "expression match arm value does not match the merged result type") if arm_value.valid
                    state.terminator <- Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)}
                finish_block(state)
                state.names.truncate(scope_mark)
                state.values.truncate(scope_mark)
                state.types.truncate(scope_mark)
                state.mutables.truncate(scope_mark)
                for index in 0..<scope_mark |state, base_values|:
                    state.values[index] <- base_values[index]
                state.current_block <- next_test_block
                state.terminated <- false

            state.terminator <- Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)}
            finish_block(state)
            state.structured_depth <- state.structured_depth - 1
            for offset in 0..<carried_indices.count |state, carried_indices, merged_values|:
                state.values[carried_indices[offset].usize()] <- merged_values[offset]
            state.current_block <- merge_block
            state.terminated <- false
            return LoweredValue{valid: true, value: result, type: result_type}


        def emit_set_index_value(collection: LoweredValue, index: LoweredValue, replacement: LoweredValue, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            return LoweredValue{valid: false, value: 0, type: unknown_ir_type()} if not collection.valid or not index.valid or not replacement.valid
            if collection.type.kind != TypeKind.Array and collection.type.kind != TypeKind.Map:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed assignment requires an array or dictionary at every updated level")
                return LoweredValue{valid: false, value: 0, type: collection.type}
            result: u32 = fresh_value(state)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            state.operand_pool.push(index.value)
            state.operand_pool.push(replacement.value)
            state.instructions.push(Instruction{opcode: Opcode.SetIndex, result: result, result_type: collection.type, operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: collection.type}


        # Lower `matrix[row, column] <- value` without introducing a special
        # runtime opcode.  Every receiver/index is evaluated once, the innermost
        # element is replaced, and the updated aggregate is rebuilt toward the
        # mutable root through typed immutable-update values.
        def lower_multi_index_assignment(target: Ast::Expr, operator: TokenKind, value: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            base_expression: mutable Ast::Expr = Expr.Invalid
            index_expressions: mutable darray[Ast::Expr] = []
            match target:
                Expr.IndexN(collection, arguments, _):
                    base_expression <- collection
                    index_expressions.extend(arguments)
                _:
                    return false
            if index_expressions.count == 0:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "multi-index assignment requires at least one index")
                return true
            target_name: mutable sview = ""
            match base_expression:
                Expr.Ident(name, _):
                    target_name <- name
                _:
                    add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "multi-index assignment target must name a local or module global")
                    return true
            index: usize = binding_index(state, target_name)
            global_index: usize = global_binding_index(state, target_name)
            if index == state.names.count and global_index == state.global_names.count:
                add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "multi-index assignment target must name a known local or module global")
                return true
            if not supported_assignment_operator(operator):
                add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "multi-index assignment supports <- and typed arithmetic or bitwise compound assignment")
                return true
            root: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            is_global: bool = index == state.names.count
            if is_global:
                root <- emit_global_load(state, global_index, pos)
            else:
                if not state.mutables[index]:
                    add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "multi-index assignment requires a mutable root binding")
                    return true
                root <- LoweredValue{valid: true, value: state.values[index], type: state.types[index]}
            if root.type.kind != TypeKind.Array and root.type.kind != TypeKind.Map:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "multi-index assignment requires an array or dictionary root")
                return true

            collections: mutable darray[LoweredValue] = [root]
            indices: mutable darray[LoweredValue] = []
            current: mutable LoweredValue = root
            for index_expression in index_expressions |index_expressions, pos, state, collections, indices, current|:
                lowered_index: LoweredValue = lower_expression(index_expression, state)
                if not lowered_index.valid:
                    return true
                indices.push(lowered_index)
                last: bool = indices.count == index_expressions.count
                if not last:
                    nested: LoweredValue = lower_index_value(current, lowered_index, pos, state)
                    if not nested.valid:
                        return true
                    collections.push(nested)
                    current <- nested

            final_collection: LoweredValue = collections[collections.count - 1]
            final_index: LoweredValue = indices[indices.count - 1]
            current_element: LoweredValue = lower_index_value(final_collection, final_index, pos, state)
            if not current_element.valid:
                return true
            replacement: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: current_element.type}
            if operator == TokenKind.LArrow:
                replacement <- lower_expression_expected(value, current_element.type, state)
                if replacement.valid and not same_type(replacement.type, current_element.type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "multi-index assignment value must match the collection element type")
                    replacement.valid <- false
            else:
                lowered: LoweredValue = lower_expression_expected(value, current_element.type, state)
                if lowered.valid:
                    opcode: Opcode = compound_opcode(operator)
                    arithmetic: bool = opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder}
                    bitwise: bool = opcode in {Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight}
                    operands_match: bool = same_type(current_element.type, lowered.type)
                    valid_arithmetic: bool = arithmetic and operands_match and numeric_type(current_element.type) and (opcode != Opcode.Remainder or current_element.type.kind == TypeKind.Int)
                    valid_bitwise: bool = bitwise and operands_match and current_element.type.kind == TypeKind.Int
                    if not valid_arithmetic and not valid_bitwise:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "multi-index compound assignment operands do not have compatible static types")
                    else:
                        operation_result: u32 = fresh_value(state)
                        operation_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(current_element.value)
                        state.operand_pool.push(lowered.value)
                        state.instructions.push(Instruction{opcode: opcode, result: operation_result, result_type: current_element.type, operand_start: operation_start, operand_count: 2, span: ir_span(pos)})
                        replacement <- LoweredValue{valid: true, value: operation_result, type: current_element.type}
            if not replacement.valid:
                return true
            updated: mutable LoweredValue = emit_set_index_value(final_collection, final_index, replacement, pos, state)
            if not updated.valid:
                return true
            parent: mutable usize = collections.count - 1
            while parent > 0 |parent, collections, indices, updated, pos, state|:
                parent <- parent - 1
                updated <- emit_set_index_value(collections[parent], indices[parent], updated, pos, state)
                return true if not updated.valid
            if is_global:
                store_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(updated.value)
                state.instructions.push(Instruction{opcode: Opcode.StoreGlobal, result: 0, result_type: void_ir_type(), integer: global_index.i64(), operand_start: store_start, operand_count: 1, span: ir_span(pos)})
            else:
                state.values[index] <- updated.value
                synchronize_mutable_element(state, index, pos)
            return true


        def lower_statement(statement: Ast::Stmt, return_type: Type, state: mutable LowerState&) -> void can[Memory.Allocate, Abort.Panic]:
            if state.terminated:
                return
            match statement:
                Stmt.VarDecl(name, type_expression, value, pos):
                    declared: Type = type_from_expression(type_expression)
                    lowered: LoweredValue = lower_expression(value, state) if type_expression is Expr.Invalid else lower_expression_expected(value, declared, state)
                    if lowered.valid:
                        binding_type: Type = lowered.type if type_expression is Expr.Invalid else declared
                        if type_expression is not Expr.Invalid and not same_type(declared, lowered.type):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "binding initializer does not match its declared type")
                        else:
                            state.names.push(name)
                            state.values.push(lowered.value)
                            state.types.push(binding_type)
                            state.mutables.push(mutable_binding_type(type_expression))
                Stmt.Expr(expression, pos):
                    match expression:
                        Expr.Invalid:
                            pass
                        _:
                            if not lower_collection_mutation(expression, pos, state):
                                _ = lower_expression(expression, state)
                Stmt.Assign(target, operator, value, pos):
                    if lower_destructuring_assignment(target, operator, value, pos, state):
                        return
                    if lower_multi_index_assignment(target, operator, value, pos, state):
                        return
                    target_name: mutable sview = ""
                    index_expression: mutable Ast::Expr = Expr.Absent
                    indexed: mutable bool = false
                    match target:
                        Expr.Ident(name, target_pos):
                            target_name <- name
                        Expr.Index(Expr.Ident(name, target_pos), target_index, index_pos):
                            target_name <- name
                            index_expression <- target_index
                            indexed <- true
                        _:
                            pass
                    index: usize = binding_index(state, target_name)
                    global_index: usize = global_binding_index(state, target_name)
                    if target_name == "" or (index == state.names.count and global_index == state.global_names.count):
                        add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "assignment target must name a known local or module global")
                    elif indexed:
                        if index == state.names.count:
                            global_type: Type = state.global_types[global_index]
                            if global_type.kind != TypeKind.Array and global_type.kind != TypeKind.Map:
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed assignment requires an array or dictionary binding")
                            elif not supported_assignment_operator(operator):
                                add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "indexed assignment supports <- and typed arithmetic or bitwise compound assignment")
                            else:
                                lowered_index: LoweredValue = lower_expression(index_expression, state)
                                element_type: Type = map_value_type(global_type) if global_type.kind == TypeKind.Map else array_element_type(global_type)
                                index_type: Type = map_key_type(global_type) if global_type.kind == TypeKind.Map else type_from_name("i64")
                                index_valid: bool = lowered_index.valid and ((global_type.kind == TypeKind.Map and same_type(lowered_index.type, index_type)) or (global_type.kind == TypeKind.Array and lowered_index.type.kind == TypeKind.Int))
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed assignment index must match the collection index type") if lowered_index.valid and not index_valid
                                if index_valid:
                                    current_global: LoweredValue = emit_global_load(state, global_index, pos)
                                    replacement: mutable LoweredValue = LoweredValue{value: 0, type: void_ir_type(), valid: false}
                                    if operator == TokenKind.LArrow:
                                        lowered_replacement: LoweredValue = lower_expression_expected(value, element_type, state)
                                        if lowered_replacement.valid and same_type(lowered_replacement.type, element_type):
                                            replacement <- lowered_replacement
                                        elif lowered_replacement.valid:
                                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed assignment value must match the collection element type")
                                    else:
                                        current: u32 = fresh_value(state)
                                        index_operands: u32 = state.operand_pool.count.u32()
                                        state.operand_pool.push(current_global.value)
                                        state.operand_pool.push(lowered_index.value)
                                        state.instructions.push(Instruction{opcode: Opcode.Index, result: current, result_type: element_type, operand_start: index_operands, operand_count: 2, span: ir_span(pos)})
                                        lowered: LoweredValue = lower_expression_expected(value, element_type, state)
                                        if lowered.valid:
                                            opcode: Opcode = compound_opcode(operator)
                                            arithmetic: bool = opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder}
                                            bitwise: bool = opcode in {Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight}
                                            operands_match: bool = same_type(element_type, lowered.type)
                                            valid_arithmetic: bool = arithmetic and operands_match and numeric_type(element_type) and (opcode != Opcode.Remainder or element_type.kind == TypeKind.Int)
                                            valid_bitwise: bool = bitwise and operands_match and element_type.kind == TypeKind.Int
                                            if not valid_arithmetic and not valid_bitwise:
                                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed compound assignment operands do not have compatible static types")
                                            else:
                                                result: u32 = fresh_value(state)
                                                operation_operands: u32 = state.operand_pool.count.u32()
                                                state.operand_pool.push(current)
                                                state.operand_pool.push(lowered.value)
                                                state.instructions.push(Instruction{opcode: opcode, result: result, result_type: element_type, operand_start: operation_operands, operand_count: 2, span: ir_span(pos)})
                                                replacement <- LoweredValue{value: result, type: element_type, valid: true}
                                    if replacement.valid:
                                        result: u32 = fresh_value(state)
                                        operand_start: u32 = state.operand_pool.count.u32()
                                        state.operand_pool.push(current_global.value)
                                        state.operand_pool.push(lowered_index.value)
                                        state.operand_pool.push(replacement.value)
                                        state.instructions.push(Instruction{opcode: Opcode.SetIndex, result: result, result_type: global_type, operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
                                        store_start: u32 = state.operand_pool.count.u32()
                                        state.operand_pool.push(result)
                                        state.instructions.push(Instruction{opcode: Opcode.StoreGlobal, result: 0, result_type: void_ir_type(), integer: global_index.i64(), operand_start: store_start, operand_count: 1, span: ir_span(pos)})
                            return
                        if not state.mutables[index]:
                            add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "indexed assignment requires a mutable array binding")
                        elif not supported_assignment_operator(operator):
                            add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "indexed assignment supports <- and typed arithmetic or bitwise compound assignment")
                        elif state.types[index].kind != TypeKind.Array and state.types[index].kind != TypeKind.Map:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed assignment requires an array or dictionary binding")
                        else:
                            lowered_index: LoweredValue = lower_expression(index_expression, state)
                            element_type: Type = map_value_type(state.types[index]) if state.types[index].kind == TypeKind.Map else array_element_type(state.types[index])
                            index_type: Type = map_key_type(state.types[index]) if state.types[index].kind == TypeKind.Map else type_from_name("i64")
                            if lowered_index.valid and ((state.types[index].kind == TypeKind.Map and not same_type(lowered_index.type, index_type)) or (state.types[index].kind == TypeKind.Array and lowered_index.type.kind != TypeKind.Int)):
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed assignment index must match the collection index type")
                            elif lowered_index.valid:
                                replacement: mutable LoweredValue = LoweredValue{value: 0, type: void_ir_type(), valid: false}
                                if operator == TokenKind.LArrow:
                                    lowered_replacement: LoweredValue = lower_expression_expected(value, element_type, state)
                                    if lowered_replacement.valid and not same_type(lowered_replacement.type, element_type):
                                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed assignment value must match the array element type")
                                    elif lowered_replacement.valid:
                                        replacement <- lowered_replacement
                                else:
                                    current: u32 = fresh_value(state)
                                    index_operands: u32 = state.operand_pool.count.u32()
                                    state.operand_pool.push(state.values[index])
                                    state.operand_pool.push(lowered_index.value)
                                    state.instructions.push(Instruction{opcode: Opcode.Index, result: current, result_type: element_type, operand_start: index_operands, operand_count: 2, span: ir_span(pos)})
                                    lowered: LoweredValue = lower_expression_expected(value, element_type, state)
                                    if lowered.valid:
                                        opcode: Opcode = compound_opcode(operator)
                                        arithmetic: bool = opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder}
                                        bitwise: bool = opcode in {Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight}
                                        operands_match: bool = same_type(element_type, lowered.type)
                                        valid_arithmetic: bool = arithmetic and operands_match and numeric_type(element_type) and (opcode != Opcode.Remainder or element_type.kind == TypeKind.Int)
                                        valid_bitwise: bool = bitwise and operands_match and element_type.kind == TypeKind.Int
                                        if not valid_arithmetic and not valid_bitwise:
                                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed compound assignment operands do not have compatible static types")
                                        else:
                                            result: u32 = fresh_value(state)
                                            operation_operands: u32 = state.operand_pool.count.u32()
                                            state.operand_pool.push(current)
                                            state.operand_pool.push(lowered.value)
                                            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: element_type, operand_start: operation_operands, operand_count: 2, span: ir_span(pos)})
                                            replacement <- LoweredValue{value: result, type: element_type, valid: true}
                                if replacement.valid:
                                    result: u32 = fresh_value(state)
                                    operand_start: u32 = state.operand_pool.count.u32()
                                    state.operand_pool.push(state.values[index])
                                    state.operand_pool.push(lowered_index.value)
                                    state.operand_pool.push(replacement.value)
                                    state.instructions.push(Instruction{opcode: Opcode.SetIndex, result: result, result_type: state.types[index], operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
                                    state.values[index] <- result
                    elif index == state.names.count:
                        global_type: Type = state.global_types[global_index]
                        if not supported_assignment_operator(operator):
                            add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "global assignment supports <- and typed arithmetic or bitwise compound assignment")
                        else:
                            current_global: LoweredValue = emit_global_load(state, global_index, pos)
                            replacement: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: global_type}
                            if operator == TokenKind.LArrow:
                                replacement <- lower_expression_expected(value, global_type, state)
                            else:
                                lowered: LoweredValue = lower_expression_expected(value, global_type, state)
                                if lowered.valid:
                                    opcode: Opcode = compound_opcode(operator)
                                    arithmetic: bool = opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder}
                                    bitwise: bool = opcode in {Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight}
                                    valid_arithmetic: bool = arithmetic and same_type(global_type, lowered.type) and numeric_type(global_type) and (opcode != Opcode.Remainder or global_type.kind == TypeKind.Int)
                                    valid_bitwise: bool = bitwise and same_type(global_type, lowered.type) and global_type.kind == TypeKind.Int
                                    if not valid_arithmetic and not valid_bitwise:
                                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "global compound assignment operands do not have compatible static types")
                                    else:
                                        result: u32 = fresh_value(state)
                                        operand_start: u32 = state.operand_pool.count.u32()
                                        state.operand_pool.push(current_global.value)
                                        state.operand_pool.push(lowered.value)
                                        state.instructions.push(Instruction{opcode: opcode, result: result, result_type: global_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                                        replacement <- LoweredValue{valid: true, value: result, type: global_type}
                            if replacement.valid:
                                store_start: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(replacement.value)
                                state.instructions.push(Instruction{opcode: Opcode.StoreGlobal, result: 0, result_type: void_ir_type(), integer: global_index.i64(), operand_start: store_start, operand_count: 1, span: ir_span(pos)})
                    else:
                        rebound: mutable bool = false
                        if not state.mutables[index]:
                            add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "assignment requires a mutable local binding")
                        elif not supported_assignment_operator(operator):
                            add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "SSA rebinding supports <- and typed arithmetic or bitwise compound assignment")
                        elif operator == TokenKind.LArrow:
                            lowered: LoweredValue = lower_expression_expected(value, state.types[index], state)
                            if lowered.valid:
                                if not same_type(state.types[index], lowered.type):
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "assignment cannot change a binding's static type")
                                else:
                                    state.values[index] <- lowered.value
                                    rebound <- true
                        else:
                            lowered: LoweredValue = lower_expression_expected(value, state.types[index], state)
                            if lowered.valid:
                                opcode: Opcode = compound_opcode(operator)
                                arithmetic: bool = opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder}
                                bitwise: bool = opcode in {Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight}
                                operands_match: bool = same_type(state.types[index], lowered.type)
                                valid_arithmetic: bool = arithmetic and operands_match and numeric_type(state.types[index]) and (opcode != Opcode.Remainder or state.types[index].kind == TypeKind.Int)
                                valid_bitwise: bool = bitwise and operands_match and state.types[index].kind == TypeKind.Int
                                if not valid_arithmetic and not valid_bitwise:
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "compound assignment operands do not have compatible static types")
                                else:
                                    result: u32 = fresh_value(state)
                                    operand_start: u32 = state.operand_pool.count.u32()
                                    state.operand_pool.push(state.values[index])
                                    state.operand_pool.push(lowered.value)
                                    state.instructions.push(Instruction{opcode: opcode, result: result, result_type: state.types[index], operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                                    state.values[index] <- result
                                    rebound <- true
                        synchronize_mutable_element(state, index, pos) if rebound
                Stmt.Return(value_opt, pos):
                    if value_opt is value:
                        lowered: LoweredValue = lower_expression_expected(value, return_type, state)
                        return_valid: mutable bool = lowered.valid
                        if lowered.valid and not same_type(return_type, lowered.type):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "return value does not match the function return type")
                            return_valid <- false
                        emit_handler_unwind(state, 0, pos) if return_valid
                        state.terminator <- Terminator{kind: TerminatorKind.Return, operand: lowered.value, operand_count: 1, span: ir_span(pos)} if return_valid
                    else:
                        if return_type.kind != TypeKind.Void:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "non-void function return requires a value")
                        else:
                            emit_handler_unwind(state, 0, pos)
                            state.terminator <- Terminator{kind: TerminatorKind.Return, span: ir_span(pos)}
                    state.terminated <- true
                Stmt.If(condition, then_body, else_body, pos):
                    condition_value: LoweredValue = lower_expression(condition, state)
                    condition_valid: mutable bool = condition_value.valid
                    if condition_value.valid and condition_value.type.kind != TypeKind.Bool:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "if condition must have boolean type")
                        condition_valid <- false
                    if condition_valid:
                        then_block: u32 = fresh_block(state)
                        else_block: u32 = fresh_block(state)
                        merge_block: u32 = fresh_block(state)
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition_value.value, operand_count: 1, target0: then_block, target1: else_block, target_count: 2, span: ir_span(pos)}
                        finish_block(state)

                        scope_mark: usize = state.names.count
                        state.structured_depth <- state.structured_depth + 1
                        base_values: mutable darray[u32] = []
                        base_values.extend(state.values)
                        state.current_block <- then_block
                        state.terminated <- false
                        for nested in then_body |state, return_type|:
                            lower_statement(nested, return_type, state)
                        then_falls_through: bool = not state.terminated
                        state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, span: ir_span(pos)} if then_falls_through
                        then_values: mutable darray[u32] = []
                        for index in 0..<scope_mark |state, then_values|:
                            then_values.push(state.values[index])
                        then_block_index: usize = state.blocks.count
                        finish_block(state)
                        state.names.truncate(scope_mark)
                        state.values.truncate(scope_mark)
                        state.types.truncate(scope_mark)
                        state.mutables.truncate(scope_mark)
                        for index in 0..<scope_mark |state, base_values|:
                            state.values[index] <- base_values[index]

                        state.current_block <- else_block
                        state.terminated <- false
                        for nested in else_body |state, return_type|:
                            lower_statement(nested, return_type, state)
                        else_falls_through: bool = not state.terminated
                        state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, span: ir_span(pos)} if else_falls_through
                        else_values: mutable darray[u32] = []
                        for index in 0..<scope_mark |state, else_values|:
                            else_values.push(state.values[index])
                        else_block_index: usize = state.blocks.count
                        finish_block(state)
                        state.names.truncate(scope_mark)
                        state.values.truncate(scope_mark)
                        state.types.truncate(scope_mark)
                        state.mutables.truncate(scope_mark)
                        state.structured_depth <- state.structured_depth - 1

                        if then_falls_through or else_falls_through:
                            if then_falls_through and else_falls_through:
                                then_edge_start: u32 = state.edge_arg_pool.count.u32()
                                merge_count: mutable u16 = 0
                                for index in 0..<scope_mark |state, then_values, else_values, merge_block, merge_count|:
                                    if then_values[index] != else_values[index]:
                                        state.edge_arg_pool.push(then_values[index])
                                        merge_count <- merge_count + 1
                                else_edge_start: u32 = state.edge_arg_pool.count.u32()
                                for index in 0..<scope_mark |state, then_values, else_values|:
                                    state.edge_arg_pool.push(else_values[index]) if then_values[index] != else_values[index]
                                state.blocks[then_block_index].terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: then_edge_start, edge0_arg_count: merge_count, span: ir_span(pos)}
                                state.blocks[else_block_index].terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: else_edge_start, edge0_arg_count: merge_count, span: ir_span(pos)}
                                for index in 0..<scope_mark |state, then_values, else_values, merge_block|:
                                    if then_values[index] != else_values[index]:
                                        merged_value: u32 = fresh_value(state)
                                        state.pending_parameter_blocks.push(merge_block)
                                        state.pending_parameters.push(Parameter{value: merged_value, type: state.types[index], name: state.names[index]})
                                        state.values[index] <- merged_value
                                    else:
                                        state.values[index] <- then_values[index]
                            else:
                                for index in 0..<scope_mark |state, then_values, else_values, then_falls_through|:
                                    state.values[index] <- then_values[index] if then_falls_through else else_values[index]
                            state.current_block <- merge_block
                            state.terminated <- false
                        else:
                            state.terminated <- true
                Stmt.While(condition, body, pos):
                    header_block: u32 = fresh_block(state)
                    body_block: u32 = fresh_block(state)
                    exit_block: u32 = fresh_block(state)
                    assigned_names: mutable darray[sview] = []
                    collect_assigned_names(body, assigned_names)
                    include_mutable_element_owners(state, assigned_names)
                    carried_indices: mutable darray[u32] = []
                    for assigned_name in assigned_names |state, carried_indices|:
                        assigned_index: usize = binding_index(state, assigned_name)
                        carried_indices.push(assigned_index.u32()) if assigned_index < state.names.count
                    context_start: u32 = state.loop_carried_indices.count.u32()
                    state.loop_carried_indices.extend(carried_indices)
                    state.loop_context_starts.push(context_start)
                    if carried_indices.count > LOWER_U16_MAX:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "while loop binding count exceeds the IR u16 limit")
                    state.loop_context_counts.push(carried_indices.count.u16() if carried_indices.count <= LOWER_U16_MAX else 0)
                    state.loop_handler_depths.push(state.active_handlers.count.u32())
                    context: usize = state.loop_context_counts.count - 1

                    entry_args: (start: u32, count: u16) = append_context_arguments(state, context)
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: entry_args.start, edge0_arg_count: entry_args.count, span: ir_span(pos)}
                    finish_block(state)

                    exit_values: mutable darray[u32] = []
                    for binding_u32 in carried_indices |state, header_block, exit_block, exit_values|:
                        binding: usize = binding_u32.usize()
                        header_value: u32 = fresh_value(state)
                        exit_value: u32 = fresh_value(state)
                        state.pending_parameter_blocks.push(header_block)
                        state.pending_parameters.push(Parameter{value: header_value, type: state.types[binding], name: state.names[binding]})
                        state.pending_parameter_blocks.push(exit_block)
                        state.pending_parameters.push(Parameter{value: exit_value, type: state.types[binding], name: state.names[binding]})
                        state.values[binding] <- header_value
                        exit_values.push(exit_value)

                    state.current_block <- header_block
                    state.terminated <- false
                    condition_value: LoweredValue = lower_expression(condition, state)
                    condition_valid: mutable bool = condition_value.valid
                    if condition_value.valid and condition_value.type.kind != TypeKind.Bool:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "while condition must have boolean type")
                        condition_valid <- false
                    if condition_valid:
                        exit_args: (start: u32, count: u16) = append_context_arguments(state, context)
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition_value.value, operand_count: 1, target0: body_block, target1: exit_block, target_count: 2, edge1_arg_start: exit_args.start, edge1_arg_count: exit_args.count, span: ir_span(pos)}
                    finish_block(state)

                    scope_mark: usize = state.names.count
                    state.structured_depth <- state.structured_depth + 1
                    state.break_targets.push(exit_block)
                    state.continue_targets.push(header_block)
                    state.current_block <- body_block
                    state.terminated <- false
                    for nested in body |state, return_type|:
                        lower_statement(nested, return_type, state)
                    if not state.terminated:
                        backedge_args: (start: u32, count: u16) = append_context_arguments(state, context)
                        state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: backedge_args.start, edge0_arg_count: backedge_args.count, span: ir_span(pos)}
                    finish_block(state)
                    _ = state.break_targets.pop()
                    _ = state.continue_targets.pop()
                    state.names.truncate(scope_mark)
                    state.values.truncate(scope_mark)
                    state.types.truncate(scope_mark)
                    state.mutables.truncate(scope_mark)
                    state.structured_depth <- state.structured_depth - 1
                    for offset in 0..<carried_indices.count |state, carried_indices, exit_values|:
                        state.values[carried_indices[offset].usize()] <- exit_values[offset]
                    _ = state.loop_context_starts.pop()
                    _ = state.loop_context_counts.pop()
                    _ = state.loop_handler_depths.pop()
                    state.loop_carried_indices <- state.loop_carried_indices.truncate(context_start.usize())

                    state.current_block <- exit_block
                    state.terminated <- false
                Stmt.For(bind, variables, iterable, body, pos):
                    mutable_iteration: bool = bind == "mutable"
                    iterable_name: mutable sview = ""
                    enumerate_sugar: mutable bool = false
                    enumerate_source: mutable Ast::Expr = Expr.Absent
                    enumerate_start: mutable Ast::Expr = Expr.Absent
                    items_sugar: mutable bool = false
                    items_source: mutable Ast::Expr = Expr.Absent
                    range_sugar: mutable bool = false
                    range_source: mutable Ast::Expr = Expr.Absent
                    zip_sugar: mutable bool = false
                    zip_left_source: mutable Ast::Expr = Expr.Absent
                    zip_right_source: mutable Ast::Expr = Expr.Absent
                    match iterable:
                        Expr.Ident(name, iterable_pos):
                            iterable_name <- name
                        Expr.Call(callee, arguments, argument_names, call_pos):
                            match callee:
                                Expr.Field(object, field, field_pos):
                                    if field == "enumerate" and arguments.count == 0 and argument_names.count == 0:
                                        enumerate_sugar <- true
                                        enumerate_source <- object
                                    if field == "items" and arguments.count == 0 and argument_names.count == 0:
                                        items_sugar <- true
                                        items_source <- object
                                Expr.Ident(name, name_pos):
                                    valid_range_names: mutable bool = arguments.count > 0 and arguments.count <= 3 and (argument_names.count == 0 or argument_names.count == arguments.count)
                                    if valid_range_names:
                                        for argument_name in argument_names |valid_range_names|:
                                            valid_range_names <- false if argument_name != ""
                                    if name == "range" and valid_range_names and lowered_function_index(state, name) == state.function_names.count:
                                        range_sugar <- true
                                        if arguments.count == 1:
                                            range_source <- Expr.Binary(Expr.IntLit(0), TokenKind.RangeLt, arguments[0], call_pos)
                                        elif arguments.count == 2:
                                            range_source <- Expr.Binary(arguments[0], TokenKind.RangeLt, arguments[1], call_pos)
                                        else:
                                            range_operator: mutable TokenKind = TokenKind.RangeLt
                                            range_step: mutable Ast::Expr = arguments[2]
                                            match arguments[2]:
                                                Expr.Unary(step_operator, magnitude, step_pos):
                                                    if step_operator == TokenKind.Minus:
                                                        match magnitude:
                                                            Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                                                                if value > 0:
                                                                    range_operator <- TokenKind.RangeGt
                                                                    range_step <- magnitude
                                                            _:
                                                                pass
                                                _:
                                                    pass
                                            bounded_range: Ast::Expr = Expr.Binary(arguments[0], range_operator, arguments[1], call_pos)
                                            range_source <- Expr.Binary(bounded_range, TokenKind.Range, range_step, call_pos)
                                    valid_enumerate_names: mutable bool = arguments.count >= 1 and arguments.count <= 2 and (argument_names.count == 0 or argument_names.count == arguments.count)
                                    if valid_enumerate_names and argument_names.count != 0:
                                        for argument_name in argument_names |valid_enumerate_names|:
                                            valid_enumerate_names <- false if argument_name != "" and argument_name != "start"
                                        valid_enumerate_names <- false if argument_names.count == 2 and argument_names[0] != ""
                                    if name == "enumerate" and valid_enumerate_names and lowered_function_index(state, name) == state.function_names.count:
                                        enumerate_sugar <- true
                                        enumerate_source <- arguments[0]
                                        enumerate_start <- arguments[1] if arguments.count == 2
                                    valid_zip_names: mutable bool = arguments.count == 2 and (argument_names.count == 0 or argument_names.count == arguments.count)
                                    if valid_zip_names:
                                        for argument_name in argument_names |valid_zip_names|:
                                            valid_zip_names <- false if argument_name != ""
                                    if name == "zip" and valid_zip_names and lowered_function_index(state, name) == state.function_names.count:
                                        zip_sugar <- true
                                        zip_left_source <- arguments[0]
                                        zip_right_source <- arguments[1]
                                _:
                                    pass
                        _:
                            pass
                    collection_owner: usize = binding_index(state, iterable_name)
                    if variables.count == 0 or variables.count > 2 or bind not in {"", "mutable"}:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "for lowering supports one read binding, or two bindings for a dictionary, array, or text iterable")
                    elif enumerate_sugar and variables.count != 2:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "enumerate iteration requires index and value bindings")
                    elif items_sugar and variables.count != 2:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "items iteration requires key and value bindings")
                    elif range_sugar and variables.count != 1:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "range iteration requires exactly one element binding")
                    elif zip_sugar and variables.count != 2:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "zip iteration requires exactly two element bindings")
                    elif mutable_iteration and variables.count != 1:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "mutable iteration supports exactly one element binding")
                    elif mutable_iteration and iterable_name == "":
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "mutable iteration requires a named mutable array binding")
                    elif mutable_iteration and collection_owner == state.names.count:
                        add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "mutable iteration requires a known array binding")
                    elif mutable_iteration and not state.mutables[collection_owner]:
                        add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "mutable iteration requires a mutable array binding")
                    elif mutable_iteration and state.types[collection_owner].kind != TypeKind.Array:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "mutable iteration requires an array binding")
                    elif not enumerate_sugar and not items_sugar and not zip_sugar and not mutable_iteration and lower_range_for(variables, range_source if range_sugar else iterable, body, return_type, pos, state):
                        pass
                    else:
                        collection_expression: mutable Ast::Expr = iterable
                        collection_expression <- enumerate_source if enumerate_sugar
                        collection_expression <- items_source if items_sugar
                        collection: mutable LoweredValue = lower_expression(collection_expression, state) if not zip_sugar else LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                        zip_right_collection: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                        if zip_sugar:
                            collection <- lower_expression(zip_left_source, state)
                            zip_right_collection <- lower_expression(zip_right_source, state)
                        if not collection.valid:
                            pass
                        elif zip_sugar and not zip_right_collection.valid:
                            pass
                        elif zip_sugar and collection.type.kind not in {TypeKind.Array, TypeKind.Text}:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "zip iteration requires array or text sources")
                        elif zip_sugar and zip_right_collection.type.kind not in {TypeKind.Array, TypeKind.Text}:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "zip iteration requires array or text sources")
                        elif collection.type.kind == TypeKind.Map and mutable_iteration:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "mutable iteration requires an array binding")
                        elif enumerate_sugar and collection.type.kind not in {TypeKind.Array, TypeKind.Text}:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "enumerate iteration requires an array or text source")
                        elif items_sugar and collection.type.kind != TypeKind.Map:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "items iteration requires a dictionary source")
                        elif variables.count == 2 and collection.type.kind not in {TypeKind.Map, TypeKind.Array, TypeKind.Text}:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "two for-bindings require a dictionary, array, or text iterable")
                        elif collection.type.kind not in {TypeKind.Array, TypeKind.Map, TypeKind.Text}:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "for iterable must have an array, dictionary, or text type")
                        else:
                            pair_iteration: bool = variables.count == 2
                            map_pair: bool = pair_iteration and not enumerate_sugar and collection.type.kind == TypeKind.Map
                            indexed_pair: bool = enumerate_sugar or (pair_iteration and collection.type.kind in {TypeKind.Array, TypeKind.Text} and not zip_sugar)
                            map_collection: u32 = collection.value
                            map_element_type: Type = map_value_type(collection.type) if collection.type.kind == TypeKind.Map else void_ir_type()
                            if collection.type.kind == TypeKind.Map:
                                key_type: Type = map_key_type(collection.type)
                                keys_type: Type = array_ir_type(key_type)
                                keys_result: u32 = fresh_value(state)
                                keys_operand_start: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(collection.value)
                                state.instructions.push(Instruction{opcode: Opcode.MapKeys, result: keys_result, result_type: keys_type, operand_start: keys_operand_start, operand_count: 1, span: ir_span(pos)})
                                collection <- LoweredValue{valid: true, value: keys_result, type: keys_type}
                            header_block: u32 = fresh_block(state)
                            body_block: u32 = fresh_block(state)
                            latch_block: u32 = fresh_block(state)
                            exit_block: u32 = fresh_block(state)
                            assigned_names: mutable darray[sview] = []
                            collect_assigned_names(body, assigned_names)
                            add_unique_name(assigned_names, iterable_name) if mutable_iteration
                            include_mutable_element_owners(state, assigned_names)
                            carried_indices: mutable darray[u32] = []
                            for assigned_name in assigned_names |state, carried_indices|:
                                assigned_index: usize = binding_index(state, assigned_name)
                                carried_indices.push(assigned_index.u32()) if assigned_index < state.names.count
                            context_start: u32 = state.loop_carried_indices.count.u32()
                            state.loop_carried_indices.extend(carried_indices)
                            state.loop_context_starts.push(context_start)
                            if carried_indices.count > LOWER_U16_MAX:
                                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "for loop binding count exceeds the IR u16 limit")
                            state.loop_context_counts.push(carried_indices.count.u16() if carried_indices.count <= LOWER_U16_MAX else 0)
                            state.loop_handler_depths.push(state.active_handlers.count.u32())
                            context: usize = state.loop_context_counts.count - 1

                            index_type: Type = type_from_name("usize")
                            # Keep the source cursor independent from the
                            # public enumerate index. A non-zero start must
                            # not be used for collection indexing or the loop
                            # bound; add it only when materializing the first
                            # binding in the body.
                            enumerate_offset: mutable LoweredValue = LoweredValue{valid: true, value: 0, type: index_type}
                            if enumerate_sugar and enumerate_start is not Expr.Absent:
                                enumerate_offset <- lower_enumerate_start(enumerate_start, pos, state)
                            initial_index: LoweredValue = emit_constant(state, index_type, 0, "", "", false, ir_span(pos))
                            entry_args: (start: u32, count: u16) = append_context_arguments(state, context)
                            state.edge_arg_pool.push(initial_index.value)
                            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: entry_args.start, edge0_arg_count: entry_args.count + 1, span: ir_span(pos)}
                            finish_block(state)

                            header_values: mutable darray[u32] = []
                            latch_values: mutable darray[u32] = []
                            exit_values: mutable darray[u32] = []
                            for binding_u32 in carried_indices |state, header_block, latch_block, exit_block, header_values, latch_values, exit_values|:
                                binding: usize = binding_u32.usize()
                                header_value: u32 = fresh_value(state)
                                latch_value: u32 = fresh_value(state)
                                exit_value: u32 = fresh_value(state)
                                state.pending_parameter_blocks.push(header_block)
                                state.pending_parameters.push(Parameter{value: header_value, type: state.types[binding], name: state.names[binding]})
                                state.pending_parameter_blocks.push(latch_block)
                                state.pending_parameters.push(Parameter{value: latch_value, type: state.types[binding], name: state.names[binding]})
                                state.pending_parameter_blocks.push(exit_block)
                                state.pending_parameters.push(Parameter{value: exit_value, type: state.types[binding], name: state.names[binding]})
                                header_values.push(header_value)
                                latch_values.push(latch_value)
                                exit_values.push(exit_value)
                            index_value: u32 = fresh_value(state)
                            state.pending_parameter_blocks.push(header_block)
                            state.pending_parameters.push(Parameter{value: index_value, type: index_type, name: "for-index"})
                            for offset in 0..<carried_indices.count |state, carried_indices, header_values|:
                                state.values[carried_indices[offset].usize()] <- header_values[offset]
                            active_collection: u32 = state.values[collection_owner] if mutable_iteration else collection.value

                            state.current_block <- header_block
                            state.terminated <- false
                            length_result: mutable u32 = 0
                            if zip_sugar:
                                zip_limit: LoweredValue = lower_zip_limit(collection, zip_right_collection, pos, state)
                                length_result <- zip_limit.value
                            else:
                                length_result <- fresh_value(state)
                                length_operand_start: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(active_collection)
                                state.instructions.push(Instruction{opcode: Opcode.Length, result: length_result, result_type: index_type, operand_start: length_operand_start, operand_count: 1, span: ir_span(pos)})
                            condition_result: u32 = fresh_value(state)
                            condition_operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(index_value)
                            state.operand_pool.push(length_result)
                            state.instructions.push(Instruction{opcode: Opcode.Less, result: condition_result, result_type: type_from_name("bool"), operand_start: condition_operand_start, operand_count: 2, span: ir_span(pos)})
                            exit_args: (start: u32, count: u16) = append_context_arguments(state, context)
                            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition_result, operand_count: 1, target0: body_block, target1: exit_block, target_count: 2, edge1_arg_start: exit_args.start, edge1_arg_count: exit_args.count, span: ir_span(pos)}
                            finish_block(state)

                            outer_scope: usize = state.names.count
                            relation_scope: usize = state.element_binding_indices.count
                            state.structured_depth <- state.structured_depth + 1
                            state.break_targets.push(exit_block)
                            state.continue_targets.push(latch_block)
                            state.current_block <- body_block
                            state.terminated <- false
                            element_result: u32 = fresh_value(state)
                            element_operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(active_collection)
                            state.operand_pool.push(index_value)
                            element_type: Type = type_from_name("char") if collection.type.kind == TypeKind.Text else array_element_type(collection.type)
                            state.instructions.push(Instruction{opcode: Opcode.Index, result: element_result, result_type: element_type, operand_start: element_operand_start, operand_count: 2, span: ir_span(pos)})
                            zip_element_result: mutable u32 = 0
                            zip_element_type: mutable Type = void_ir_type()
                            if zip_sugar:
                                zip_element_result <- fresh_value(state)
                                zip_element_operand_start: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(zip_right_collection.value)
                                state.operand_pool.push(index_value)
                                zip_element_type <- type_from_name("char") if zip_right_collection.type.kind == TypeKind.Text else array_element_type(zip_right_collection.type)
                                state.instructions.push(Instruction{opcode: Opcode.Index, result: zip_element_result, result_type: zip_element_type, operand_start: zip_element_operand_start, operand_count: 2, span: ir_span(pos)})
                            enumerate_index_value: mutable u32 = index_value
                            if enumerate_sugar and enumerate_start is not Expr.Absent:
                                enumerate_index: LoweredValue = emit_binary(state, Opcode.Add, index_value, enumerate_offset.value, index_type, pos)
                                enumerate_index_value <- enumerate_index.value
                            if map_pair:
                                state.names.push(variables[0])
                                state.values.push(element_result)
                                state.types.push(element_type)
                                state.mutables.push(false)
                                value_result: u32 = fresh_value(state)
                                value_operand_start: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(map_collection)
                                state.operand_pool.push(element_result)
                                state.instructions.push(Instruction{opcode: Opcode.Index, result: value_result, result_type: map_element_type, operand_start: value_operand_start, operand_count: 2, span: ir_span(pos)})
                                state.names.push(variables[1])
                                state.values.push(value_result)
                                state.types.push(map_element_type)
                                state.mutables.push(false)
                            elif zip_sugar:
                                state.names.push(variables[0])
                                state.values.push(element_result)
                                state.types.push(element_type)
                                state.mutables.push(false)
                                state.names.push(variables[1])
                                state.values.push(zip_element_result)
                                state.types.push(zip_element_type)
                                state.mutables.push(false)
                            elif indexed_pair:
                                # Arrays and text expose the loop cursor as the
                                # first binding, matching Python's enumerate
                                # shape while retaining exact usize typing.
                                state.names.push(variables[0])
                                state.values.push(enumerate_index_value)
                                state.types.push(index_type)
                                state.mutables.push(false)
                                state.names.push(variables[1])
                                state.values.push(element_result)
                                state.types.push(element_type)
                                state.mutables.push(false)
                            else:
                                state.names.push(variables[0])
                                state.values.push(element_result)
                                state.types.push(element_type)
                                state.mutables.push(mutable_iteration)
                            if mutable_iteration:
                                state.element_binding_indices.push(outer_scope.u32())
                                state.element_owner_indices.push(collection_owner.u32())
                                state.element_index_values.push(index_value)
                            for nested in body |state, return_type|:
                                lower_statement(nested, return_type, state)
                            if not state.terminated:
                                body_args: (start: u32, count: u16) = append_context_arguments(state, context)
                                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: latch_block, target_count: 1, edge0_arg_start: body_args.start, edge0_arg_count: body_args.count, span: ir_span(pos)}
                            finish_block(state)
                            _ = state.break_targets.pop()
                            _ = state.continue_targets.pop()
                            state.names.truncate(outer_scope)
                            state.values.truncate(outer_scope)
                            state.types.truncate(outer_scope)
                            state.mutables.truncate(outer_scope)
                            state.element_binding_indices.truncate(relation_scope)
                            state.element_owner_indices.truncate(relation_scope)
                            state.element_index_values.truncate(relation_scope)
                            for offset in 0..<carried_indices.count |state, carried_indices, latch_values|:
                                state.values[carried_indices[offset].usize()] <- latch_values[offset]

                            state.current_block <- latch_block
                            state.terminated <- false
                            one: LoweredValue = emit_constant(state, index_type, 1, "", "", false, ir_span(pos))
                            next_index: u32 = fresh_value(state)
                            increment_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(index_value)
                            state.operand_pool.push(one.value)
                            state.instructions.push(Instruction{opcode: Opcode.Add, result: next_index, result_type: index_type, operand_start: increment_start, operand_count: 2, span: ir_span(pos)})
                            backedge_args: (start: u32, count: u16) = append_context_arguments(state, context)
                            state.edge_arg_pool.push(next_index)
                            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: backedge_args.start, edge0_arg_count: backedge_args.count + 1, span: ir_span(pos)}
                            finish_block(state)

                            state.structured_depth <- state.structured_depth - 1
                            for offset in 0..<carried_indices.count |state, carried_indices, exit_values|:
                                state.values[carried_indices[offset].usize()] <- exit_values[offset]
                            _ = state.loop_context_starts.pop()
                            _ = state.loop_context_counts.pop()
                            _ = state.loop_handler_depths.pop()
                            state.loop_carried_indices <- state.loop_carried_indices.truncate(context_start.usize())
                            state.current_block <- exit_block
                            state.terminated <- false
                Stmt.Match(scrutinee, arms, pos):
                    lower_array_match(scrutinee, arms, return_type, pos, state) if array_match_has_structural_pattern(arms) else lower_scalar_match(scrutinee, arms, return_type, pos, state)
                Stmt.Break(label, pos):
                    if label != "":
                        add_issue(state, LowerIssueKind.UnsupportedLoopLabel, pos.line, "labeled break is not in the initial IR lowering subset")
                    else:
                        if state.break_targets.count == 0:
                            add_issue(state, LowerIssueKind.LoopControlOutsideLoop, pos.line, "break has no enclosing loop")
                        else:
                            target: u32 = state.break_targets[state.break_targets.count - 1]
                            context: usize = state.loop_context_counts.count - 1
                            emit_handler_unwind(state, state.loop_handler_depths[context].usize(), pos)
                            edge_args: (start: u32, count: u16) = append_context_arguments(state, context)
                            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: target, target_count: 1, edge0_arg_start: edge_args.start, edge0_arg_count: edge_args.count, span: ir_span(pos)}
                            state.terminated <- true
                Stmt.Continue(label, pos):
                    if label != "":
                        add_issue(state, LowerIssueKind.UnsupportedLoopLabel, pos.line, "labeled continue is not in the initial IR lowering subset")
                    else:
                        if state.continue_targets.count == 0:
                            add_issue(state, LowerIssueKind.LoopControlOutsideLoop, pos.line, "continue has no enclosing loop")
                        else:
                            target: u32 = state.continue_targets[state.continue_targets.count - 1]
                            context: usize = state.loop_context_counts.count - 1
                            emit_handler_unwind(state, state.loop_handler_depths[context].usize(), pos)
                            edge_args: (start: u32, count: u16) = append_context_arguments(state, context)
                            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: target, target_count: 1, edge0_arg_start: edge_args.start, edge0_arg_count: edge_args.count, span: ir_span(pos)}
                            state.terminated <- true
                Stmt.Block(kind, clause, binding, body, pos):
                    if kind == "signal":
                        if clause.count == 0:
                            add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "signal must name an effect operation")
                        elif not valid_effect_reference(clause[0]):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "signal effect reference must use `Family.Operation` form")
                        else:
                            reference: sview = clause[0]
                            operands: mutable darray[u32] = []
                            operand_types: mutable darray[Type] = []
                            valid: mutable bool = true
                            for payload_statement in body |state, operands, operand_types, valid|:
                                match payload_statement:
                                    Stmt.Expr(payload_expression, payload_pos):
                                        lowered_payload: LoweredValue = lower_expression(payload_expression, state)
                                        operands.push(lowered_payload.value) if lowered_payload.valid
                                        operand_types.push(lowered_payload.type) if lowered_payload.valid
                                        valid <- false if not lowered_payload.valid
                                    _:
                                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "signal payload must contain value expressions")
                                        valid <- false
                            if valid and effect_operation_declared(state.source_file, effect_family(reference), effect_operation(reference)) and operands.count != effect_operation_declared_arity(state.source_file, effect_family(reference), effect_operation(reference)):
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "signal payload arity does not match the declared effect operation")
                                valid <- false
                            declared_result: Type = effect_operation_result_type(state.source_file, effect_family(reference), effect_operation(reference))
                            if valid and effect_operation_result_is_known(declared_result) and declared_result.kind != TypeKind.Void:
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "signal requires a void declared effect operation result")
                                valid <- false
                            if valid and operand_types.count > 0:
                                for payload_index in 0..<operand_types.count |state, reference, operand_types, payload_index, valid, pos|:
                                    declared_payload: Type = effect_operation_payload_type(state.source_file, effect_family(reference), effect_operation(reference), payload_index)
                                    if effect_operation_payload_is_known(declared_payload) and not same_type(declared_payload, operand_types[payload_index]):
                                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "signal payload type does not match the declared effect operation payload")
                                        valid <- false
                            if valid and operands.count > LOWER_U16_MAX:
                                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "signal payload count exceeds the IR operand limit")
                                valid <- false
                            if valid:
                                operand_start: u32 = state.operand_pool.count.u32()
                                state.operand_pool.extend(operands)
                                state.instructions.push(Instruction{opcode: Opcode.Perform, result: 0, result_type: void_ir_type(), operand_start: operand_start, operand_count: operands.count.u16(), effect_family: effect_family(reference), effect_operation: effect_operation(reference), operation_id: Ast::effect_operation_identity(effect_family(reference), effect_operation(reference)), trace: trace_site(state, reference, pos), span: ir_span(pos)})
                    else:
                        if kind == "with" and clause.count >= 2 and clause[0] == "handler":
                            handler_name: sview = clause[1]
                            add_handler_contract(state, handler_name)
                            state.instructions.push(Instruction{opcode: Opcode.HandlerPush, result: 0, result_type: void_ir_type(), symbol: handler_name, trace: trace_site(state, handler_name, pos), span: ir_span(pos)})
                            handler_depth: usize = state.active_handlers.count
                            state.active_handlers.push(handler_name)
                            scope_mark: usize = state.names.count
                            for nested in body |state, return_type|:
                                lower_statement(nested, return_type, state)
                            state.names.truncate(scope_mark)
                            state.values.truncate(scope_mark)
                            state.types.truncate(scope_mark)
                            state.mutables.truncate(scope_mark)
                            state.instructions.push(Instruction{opcode: Opcode.HandlerPop, result: 0, result_type: void_ir_type(), symbol: handler_name, trace: trace_site(state, "handler-pop", pos), span: ir_span(pos)}) if not state.terminated
                            state.active_handlers.truncate(handler_depth)
                        else:
                            if kind == "can" or kind == "trusted":
                                scope_mark: usize = state.names.count
                                for nested in body |state, return_type|:
                                    lower_statement(nested, return_type, state)
                                state.names.truncate(scope_mark)
                                state.values.truncate(scope_mark)
                                state.types.truncate(scope_mark)
                                state.mutables.truncate(scope_mark)
                            else:
                                add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "control block is not in the initial IR lowering subset")
                _:
                    add_issue(state, LowerIssueKind.UnsupportedStatement, 0, "statement is not in the initial IR lowering subset")


        def lower_function(name: sview, params: darray[Ast::ParamDecl]&, return_type_opt: Ast::Expr?, body: darray[Ast::Stmt]&, effects: darray[sview]&, declared_error_start: u32, declared_error_count: u16, pos: Ast::Pos&, function_names: darray[sview]&, function_returns: darray[Type]&, function_parameter_starts: darray[u32]&, function_parameter_counts: darray[u16]&, function_parameter_types: darray[Type]&, function_parameter_names: darray[sview]&, function_parameter_has_defaults: darray[bool]&, function_parameter_defaults: darray[Ast::Expr]&, function_effect_starts: darray[u32]&, function_effect_counts: darray[u16]&, function_effects: darray[sview]&, function_error_starts: darray[u32]&, function_error_counts: darray[u16]&, function_errors: darray[sview]&, handlers: darray[Handler]&, comprehension_kinds: darray[Ast::EnumAnnotation]&, source_file: Ast::File&, constant_names: darray[sview]&, constant_types: darray[Type]&, constant_values: darray[Ast::Expr]&, global_names: darray[sview]&, global_types: darray[Type]&, type_table: mutable TypeTable&, outer_issues: mutable darray[LowerIssue]&) -> Function can[Memory.Allocate, Abort.Panic]:
            return_type: mutable Type = void_ir_type()
            return_type <- interned_type_from_expression(return_expression, type_table) if return_type_opt is return_expression
            state: mutable LowerState = LowerState{function: name, next_value: 1, current_block: 1, next_block: 2, instruction_start: 0, structured_depth: 0, blocks: [], names: [], values: [], types: [], mutables: [], instructions: [], operand_pool: [], edge_arg_pool: [], issues: [], break_targets: [], continue_targets: [], pending_parameter_blocks: [], pending_parameters: [], block_parameter_pool: [], loop_context_starts: [], loop_context_counts: [], loop_carried_indices: [], loop_handler_depths: [], element_binding_indices: [], element_owner_indices: [], element_index_values: [], active_handlers: [], terminated: false, terminator: Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)}, function_names: function_names, function_returns: function_returns, function_parameter_starts: function_parameter_starts, function_parameter_counts: function_parameter_counts, function_parameter_types: function_parameter_types, function_parameter_names: function_parameter_names, function_parameter_has_defaults: function_parameter_has_defaults, function_parameter_defaults: function_parameter_defaults, function_effect_starts: function_effect_starts, function_effect_counts: function_effect_counts, function_effects: function_effects, function_error_starts: function_error_starts, function_error_counts: function_error_counts, function_errors: function_errors, handlers: handlers, comprehension_kinds: comprehension_kinds, source_file: source_file, type_table: type_table, function_return_type: return_type, required_effects: [], required_errors: [], constant_names: constant_names, constant_types: constant_types, constant_values: constant_values, global_names: global_names, global_types: global_types}
            state.required_effects.extend(effects)
            for error_offset in 0..<declared_error_count.usize() |state, declared_error_start|:
                declared_error: sview = function_errors[declared_error_start.usize() + error_offset]
                state.required_errors.push(declared_error) if declared_error != "" and not has_text(state.required_errors, declared_error)
            # Materialize immutable module constants before parameters so normal
            # lexical lookup gives parameters and locals precedence.  Constants
            # are lowered once per function entry and remain ordinary typed SSA
            # values from that point onward.
            for constant_index in 0..<constant_names.count |state, constant_names, constant_types, constant_values|:
                declared_constant_type: Type = constant_types[constant_index]
                constant_value: LoweredValue = lower_expression_expected(constant_values[constant_index], declared_constant_type, state) if declared_constant_type.kind != TypeKind.Named or declared_constant_type.name != "" else lower_expression(constant_values[constant_index], state)
                if not constant_value.valid:
                    add_issue(state, LowerIssueKind.TypeMismatch, 0, "module constant initializer could not be lowered")
                    continue
                if (declared_constant_type.kind != TypeKind.Named or declared_constant_type.name != "") and not same_type(constant_value.type, declared_constant_type):
                    add_issue(state, LowerIssueKind.TypeMismatch, 0, "module constant initializer does not match its declared type")
                    continue
                state.names.push(constant_names[constant_index])
                state.values.push(constant_value.value)
                state.types.push(constant_value.type)
                state.mutables.push(false)

            lowered_params: mutable darray[Parameter] = []
            for parameter in params |state, lowered_params|:
                parameter_type: Type = interned_type_from_expression(parameter.type_expression, type_table)
                value: u32 = fresh_value(state)
                lowered_params.push(Parameter{value: value, type: parameter_type, name: parameter.name})
                state.names.push(parameter.name)
                state.values.push(value)
                state.types.push(parameter_type)
                state.mutables.push(parameter.is_mutable or mutable_binding_type(parameter.type_expression))
            for statement in body |state, return_type|:
                lower_statement(statement, return_type, state)
            if not state.terminated:
                if return_type.kind == TypeKind.Void:
                    state.terminator <- Terminator{kind: TerminatorKind.Return, span: ir_span(pos)}
                else:
                    add_issue(state, LowerIssueKind.MissingReturn, pos.line, "non-void function did not lower to a return")
            finish_block(state) if state.current_block != 0
            for found in state.issues |outer_issues|:
                outer_issues.push(found)
            return Function{name: name, parameters: lowered_params, return_type: return_type, effects: state.required_effects, operand_pool: state.operand_pool, edge_arg_pool: state.edge_arg_pool, block_parameter_pool: state.block_parameter_pool, instruction_pool: state.instructions, blocks: state.blocks, entry: 1, errors: state.required_errors}


    public:
        # Lower a semantically checked parser file. The caller must run Semantic::check first;
        # this boundary assumes the source is well typed and reports only lowering coverage.
        def lower_file_with_handlers(file: Ast::File&, module_name: sview, handlers: darray[Handler]&) -> LowerResult can[Memory.Allocate, Abort.Panic]:
            issues: mutable darray[LowerIssue] = []
            names: mutable darray[sview] = []
            returns: mutable darray[Type] = []
            parameter_starts: mutable darray[u32] = []
            parameter_counts: mutable darray[u16] = []
            parameter_types: mutable darray[Type] = []
            parameter_names: mutable darray[sview] = []
            parameter_has_defaults: mutable darray[bool] = []
            parameter_defaults: mutable darray[Ast::Expr] = []
            effect_starts: mutable darray[u32] = []
            effect_counts: mutable darray[u16] = []
            signature_effects: mutable darray[sview] = []
            error_starts: mutable darray[u32] = []
            error_counts: mutable darray[u16] = []
            signature_errors: mutable darray[sview] = []
            constant_names: mutable darray[sview] = []
            constant_types: mutable darray[Type] = []
            constant_values: mutable darray[Ast::Expr] = []
            global_names: mutable darray[sview] = []
            global_types: mutable darray[Type] = []
            globals: mutable darray[Global] = []
            type_table: mutable TypeTable = TypeTable{rows: [], children: []}
            for declaration in file.top_decls |names, returns, parameter_starts, parameter_counts, parameter_types, parameter_names, parameter_has_defaults, parameter_defaults, effect_starts, effect_counts, signature_effects, error_starts, error_counts, signature_errors, file|:
                match declaration:
                    Decl.Func(name, params, return_type_opt, body, effects, decorators, pos):
                        return_type: mutable Type = void_ir_type()
                        return_type <- interned_type_from_expression(return_expression, type_table) if return_type_opt is return_expression
                        names.push(name)
                        returns.push(return_type)
                        parameter_starts.push(parameter_types.count.u32())
                        if params.count > LOWER_U16_MAX:
                            issues.push(LowerIssue{kind: LowerIssueKind.UnsupportedDeclaration, function: name, line: pos.line, message: "function parameter count exceeds the IR u16 limit"})
                        parameter_counts.push(params.count.u16() if params.count <= LOWER_U16_MAX else 0)
                        for parameter in params |parameter_types, parameter_names, parameter_has_defaults, parameter_defaults|:
                            parameter_types.push(interned_type_from_expression(parameter.type_expression, type_table))
                            parameter_names.push(parameter.name)
                            parameter_has_defaults.push(parameter.has_default)
                            parameter_defaults.push(parameter.default_value)
                        effect_starts.push(signature_effects.count.u32())
                        if effects.count > LOWER_U16_MAX:
                            issues.push(LowerIssue{kind: LowerIssueKind.UnsupportedDeclaration, function: name, line: pos.line, message: "function effect count exceeds the IR u16 limit"})
                        effect_counts.push(effects.count.u16() if effects.count <= LOWER_U16_MAX else 0)
                        signature_effects.extend(effects)
                        error_start: u32 = signature_errors.count.u32()
                        for annotation in file.enum_annotations |signature_errors, pos|:
                            signature_errors.push(annotation.name) if annotation.owner == "__error_set_family" and annotation.line == pos.line and annotation.name != ""
                        if signature_errors.count.u32() == error_start:
                            for error_index in 0..<file.error_set_func_lines.count |file, pos, signature_errors|:
                                signature_errors.push(file.error_set_func_names[error_index]) if file.error_set_func_lines[error_index] == pos.line and file.error_set_func_names[error_index] != ""
                        error_starts.push(error_start)
                        error_count: usize = (signature_errors.count.u32() - error_start).usize()
                        if error_count > LOWER_U16_MAX:
                            issues.push(LowerIssue{kind: LowerIssueKind.UnsupportedDeclaration, function: name, line: pos.line, message: "function error count exceeds the IR u16 limit"})
                        error_counts.push(error_count.u16() if error_count <= LOWER_U16_MAX else 0)
                    Decl.Const(name, type_expression, value, is_mutable, pos):
                        if is_mutable:
                            declared: Type = interned_type_from_expression(type_expression, type_table) if type_expression is not Ast::Expr.Absent else unknown_ir_type()
                            _ = lower_global_probe(name, declared, value, globals)
                            global_names.push(name)
                            global_types.push(declared)
                        elif value is not Ast::Expr.Invalid:
                            constant_names.push(name)
                            constant_types.push(interned_type_from_expression(type_expression, type_table) if type_expression is not Ast::Expr.Absent else unknown_ir_type())
                            constant_values.push(value)
                    _:
                        pass
            functions: mutable darray[Function] = []
            # Host-provided descriptors remain the compatibility path.  Source decorators
            # extend a private copy so loading a file never mutates the caller's handler
            # configuration, while every function sees the same complete dynamic-handler set.
            effective_handlers: mutable darray[Handler] = []
            effective_handlers.extend(handlers)
            derive_source_handlers(file.top_decls, file, effective_handlers, issues)
            for declaration in file.top_decls |functions, issues, names, returns, parameter_starts, parameter_counts, parameter_types, parameter_names, parameter_has_defaults, parameter_defaults, effect_starts, effect_counts, signature_effects, error_starts, error_counts, signature_errors, constant_names, constant_types, constant_values, global_names, global_types, globals|:
                match declaration:
                    Decl.Func(name, params, return_type_opt, body, effects, decorators, pos):
                        function_index: usize = functions.count
                        functions.push(lower_function(name, params, return_type_opt, body, effects, error_starts[function_index], error_counts[function_index], pos, names, returns, parameter_starts, parameter_counts, parameter_types, parameter_names, parameter_has_defaults, parameter_defaults, effect_starts, effect_counts, signature_effects, error_starts, error_counts, signature_errors, effective_handlers, file.enum_annotations, file, constant_names, constant_types, constant_values, global_names, global_types, type_table, issues))
                    Decl.Const(name, type_expression, value, is_mutable, pos):
                        if is_mutable:
                            declared: Type = interned_type_from_expression(type_expression, type_table) if type_expression is not Ast::Expr.Absent else unknown_ir_type()
                            probe_globals: mutable darray[Global] = []
                            probe_valid: bool = lower_global_probe(name, declared, value, probe_globals)
                            issues.push(LowerIssue{kind: LowerIssueKind.UnsupportedDeclaration, function: "", line: pos.line, message: "module globals require a supported scalar or one-level collection type and literal initializer"}) if not global_type_supported(declared) or not probe_valid
                    # Error families are represented in parser metadata and in
                    # function error rows; they need no runtime declaration in
                    # this closed IR.
                    Decl.Enum(name, variants, is_const, storage_type, pos):
                        pass
                    _:
                        issues.push(LowerIssue{kind: LowerIssueKind.UnsupportedDeclaration, function: "", line: 0, message: "declaration is not in the initial IR lowering subset"})
            lowered_handlers: mutable darray[Handler] = []
            lowered_handlers.extend(effective_handlers)
            lowered_module: mutable Module = Module{name: module_name, functions: functions, globals: globals, handlers: lowered_handlers}
            intern_module_types(lowered_module)
            return LowerResult{module: lowered_module, issues: issues}


        def lower_file(file: Ast::File&, module_name: sview) -> LowerResult can[Memory.Allocate, Abort.Panic]:
            handlers: darray[Handler] = []
            return lower_file_with_handlers(file, module_name, handlers)
