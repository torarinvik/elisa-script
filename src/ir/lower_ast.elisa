include "../../vendor/elisa-compiler/src/parser/parser.elisa"

using Ast
using Lexer


extend EsIr:
    public:
        const enum LowerIssueKind of u8:
            UnsupportedDeclaration
            UnsupportedStatement
            UnsupportedExpression
            UnknownBinding
            UnknownCallee
            UnknownType
            MissingReturn
            LoopControlOutsideLoop
            UnsupportedLoopLabel
            UnsupportedAssignmentTarget
            ImmutableBinding
            MutableMergePending
            TypeMismatch
            MissingError


        struct LowerIssue:
            function: sview
            message: sview
            line: u32
            kind: LowerIssueKind


        struct LowerResult:
            module: Module
            issues: darray[LowerIssue]


    private:
        struct LoweredValue:
            valid: bool
            value: u32
            type: Type


        struct RangeMembership:
            value: LoweredValue
            recognized: bool


        struct GlobalProbe:
            valid: bool
            binding: Global


        struct GlobalLiteralProbe:
            valid: bool
            literal: GlobalLiteral


        # A comprehension may iterate a materialized array/text value or an
        # integer range directly.  Ranges stay syntax-level here: the lowering
        # carries the current counter through the same explicit CFG used by
        # statement `for` loops, so no temporary array is allocated.
        struct ComprehensionRange:
            recognized: mutable bool
            low: mutable Ast::Expr
            high: mutable Ast::Expr
            step: mutable Ast::Expr
            operator: mutable TokenKind


        struct ComprehensionPairProbe:
            valid: bool
            key_type: Type
            value_type: Type


        struct LowerState:
            terminator: mutable Terminator
            blocks: mutable darray[Block]
            names: mutable darray[sview]
            values: mutable darray[u32]
            types: mutable darray[Type]
            mutables: mutable darray[bool]
            instructions: mutable darray[Instruction]
            operand_pool: mutable darray[u32]
            edge_arg_pool: mutable darray[u32]
            issues: mutable darray[LowerIssue]
            break_targets: mutable darray[u32]
            continue_targets: mutable darray[u32]
            pending_parameter_blocks: mutable darray[u32]
            pending_parameters: mutable darray[Parameter]
            block_parameter_pool: mutable darray[Parameter]
            loop_context_starts: mutable darray[u32]
            loop_context_counts: mutable darray[u16]
            loop_carried_indices: mutable darray[u32]
            loop_handler_depths: mutable darray[u32]
            element_binding_indices: mutable darray[u32]
            element_owner_indices: mutable darray[u32]
            element_index_values: mutable darray[u32]
            active_handlers: mutable darray[sview]
            function: sview
            function_names: darray[sview]&
            function_returns: darray[Type]&
            function_parameter_starts: darray[u32]&
            function_parameter_counts: darray[u16]&
            function_parameter_types: darray[Type]&
            function_parameter_names: darray[sview]&
            function_parameter_has_defaults: darray[bool]&
            function_parameter_defaults: darray[Ast::Expr]&
            function_effect_starts: darray[u32]&
            function_effect_counts: darray[u16]&
            function_effects: darray[sview]&
            function_error_starts: darray[u32]&
            function_error_counts: darray[u16]&
            function_errors: darray[sview]&
            handlers: darray[Handler]&
            comprehension_kinds: darray[Ast::EnumAnnotation]&
            source_file: Ast::File&
            type_table: mutable TypeTable&
            function_return_type: Type
            required_effects: mutable darray[sview]
            required_errors: mutable darray[sview]
            # Immutable module constants are materialized as typed SSA values at
            # function entry.  Keeping the names in a separate scope means a
            # function parameter or local declaration can shadow a constant just
            # like it does in the source language.
            constant_names: darray[sview]&
            constant_types: darray[Type]&
            constant_values: darray[Ast::Expr]&
            # Mutable module bindings are shared storage. Locals still win lexical
            # lookup; these parallel arrays keep the lowering state pointer-free.
            global_names: darray[sview]&
            global_types: darray[Type]&
            next_value: mutable u32
            current_block: mutable u32
            next_block: mutable u32
            instruction_start: mutable u32
            structured_depth: mutable u32
            terminated: mutable bool


        def zero_span() -> SourceSpan:
            return SourceSpan{file: "", line: 0, column: 0, end_line: 0, end_column: 0}


        def ir_span(pos: Ast::Pos&) -> SourceSpan:
            return SourceSpan{file: "", line: pos.line, column: pos.column, end_line: pos.end_line, end_column: pos.end_column}


        def comprehension_range_parts(iterable: Ast::Expr) -> ComprehensionRange:
            range: mutable ComprehensionRange = ComprehensionRange{recognized: false, low: Expr.Absent, high: Expr.Absent, step: Expr.Absent, operator: TokenKind.Range}
            match iterable:
                Expr.Binary(low, operator, high, _):
                    if operator == TokenKind.RangeLt or operator == TokenKind.RangeLe or operator == TokenKind.RangeGt:
                        range.low <- low
                        range.high <- high
                        range.operator <- operator
                        range.recognized <- true
                    elif operator == TokenKind.Range:
                        match low:
                            Expr.Binary(inner_low, inner_operator, inner_high, _):
                                if inner_operator == TokenKind.RangeLt or inner_operator == TokenKind.RangeLe or inner_operator == TokenKind.RangeGt:
                                    range.low <- inner_low
                                    range.high <- inner_high
                                    range.step <- high
                                    range.operator <- inner_operator
                                    range.recognized <- true
                            _:
                                pass
                _:
                    pass
            return range


        def trace_hash_text(hash: u64, text: sview) -> u64:
            value: mutable u64 = hash
            for byte in text |value|:
                value <- (value ^ byte.u64()) * 1099511628211
            return value


        def trace_site(state: LowerState&, label: sview, pos: Ast::Pos&) -> TraceSite:
            hash: mutable u64 = trace_hash_text(1469598103934665603, state.function)
            hash <- trace_hash_text(hash, label)
            hash <- (hash ^ pos.line.u64()) * 1099511628211
            hash <- (hash ^ pos.column.u64()) * 1099511628211
            hash <- 1 if hash == 0
            return TraceSite{id: hash, label: label}


        def effect_family(reference: sview) -> sview:
            for index in 0..<sview_len(reference) |reference|:
                reference[0:index] return if sview_at(reference, index) == 46
            return reference


        def effect_operation(reference: sview) -> sview:
            for index in 0..<sview_len(reference) |reference|:
                reference[index + 1:sview_len(reference)] return if sview_at(reference, index) == 46
            return "signal"


        struct RaiseReference:
            owner: sview = ""
            tag: sview = ""
            valid: bool = false
            # Optional payload expressions from `raise Error.Tag(value, …)`. The
            # first IR increment keeps them ordered in the Raise operand slice;
            # matching catch arms extract them through typed ErrorPayload values.
            payloads: darray[Ast::Expr] = []


        def error_payload_variant_position(file: Ast::File&, family: sview, operation: sview) -> usize:
            enum_index: mutable usize = 0
            while enum_index < file.payload_enum_names.count:
                if file.payload_enum_names[enum_index] == family:
                    variant_start: usize = file.payload_enum_variant_starts[enum_index]
                    variant_count: usize = file.payload_enum_variant_counts[enum_index]
                    for offset in 0..<variant_count |file, variant_start, operation|:
                        variant_index: usize = variant_start + offset
                        return variant_index if file.payload_enum_variant_names[variant_index] == operation
                enum_index <- enum_index + 1
            return file.payload_enum_variant_names.count


        def error_payload_field_count(file: Ast::File&, family: sview, operation: sview) -> usize:
            variant_index: usize = error_payload_variant_position(file, family, operation)
            return 0 if variant_index >= file.payload_enum_variant_field_counts.count
            return file.payload_enum_variant_field_counts[variant_index]


        def error_payload_variant_declared(file: Ast::File&, family: sview, operation: sview) -> bool:
            family_declared: mutable bool = false
            for declared_family in file.error_set_decl_names |family_declared|:
                family_declared <- true if declared_family == family
            return false if not family_declared
            return true if error_payload_variant_position(file, family, operation) < file.payload_enum_variant_names.count
            enum_index: mutable usize = 0
            while enum_index < file.enum_decl_names.count:
                if file.enum_decl_names[enum_index] == family:
                    variant_start: usize = file.enum_decl_variant_starts[enum_index]
                    variant_count: usize = file.enum_decl_variant_counts[enum_index]
                    for offset in 0..<variant_count |file, variant_start, operation|:
                        return true if file.enum_decl_variant_names[variant_start + offset] == operation
                enum_index <- enum_index + 1
            return false


        def error_payload_field_type(state: LowerState&, family: sview, operation: sview, index: usize) -> Type can[Memory.Allocate, Abort.Panic]:
            variant_index: usize = error_payload_variant_position(state.source_file, family, operation)
            return unknown_ir_type() if variant_index >= state.source_file.payload_enum_variant_field_counts.count
            return unknown_ir_type() if index >= state.source_file.payload_enum_variant_field_counts[variant_index]
            field_start: usize = state.source_file.payload_enum_variant_field_starts[variant_index]
            return interned_type_from_expression(state.source_file.payload_enum_variant_fields[field_start + index], state.type_table)


        # The parser keeps `raise Error.Tag` and `raise Error.Tag(payload, …)` as
        # call-shaped expressions. Keep extraction strict: only a direct field or
        # a positional call of that field is an error constructor; bare `raise`
        # and arbitrary call expressions are not silently converted into a failure.
        def raised_error_reference(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&) -> RaiseReference:
            return RaiseReference{} if arguments.count != 1 or (argument_names.count != 0 and (argument_names.count != 1 or argument_names[0] != ""))
            match arguments[0]:
                Expr.Field(Expr.Ident(owner, _), tag, _):
                    return RaiseReference{owner: owner, tag: tag, valid: owner != "" and tag != ""}
                Expr.Call(Expr.Field(Expr.Ident(owner, _), tag, _), payloads, payload_names, _):
                    for payload_name in payload_names:
                        return RaiseReference{} if payload_name != ""
                    return RaiseReference{owner: owner, tag: tag, valid: owner != "" and tag != "", payloads: payloads}
                _:
                    pass
            return RaiseReference{}


        def lower_raise_expression(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = void_ir_type()
            reference: RaiseReference = raised_error_reference(arguments, argument_names)
            if not reference.valid:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "raise requires one positional Error.Tag reference or constructor")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if not error_payload_variant_declared(state.source_file, reference.owner, reference.tag):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "raised error variant is not declared")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if not has_text(state.required_errors, reference.owner):
                add_issue(state, LowerIssueKind.MissingError, pos.line, "raised error family is absent from the function error row")
            expected_payload_count: usize = error_payload_field_count(state.source_file, reference.owner, reference.tag)
            if reference.payloads.count != expected_payload_count:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "raised error payload arity does not match its declaration")
                return LoweredValue{valid: false, value: 0, type: result_type}
            payload_values: mutable darray[u32] = []
            valid_payloads: mutable bool = true
            for payload_index in 0..<reference.payloads.count |state, reference, valid_payloads|:
                payload: Ast::Expr = reference.payloads[payload_index]
                declared_payload: Type = error_payload_field_type(state, reference.owner, reference.tag, payload_index)
                lowered_payload: LoweredValue = lower_expression_expected(payload, declared_payload, state) if not (declared_payload.kind == TypeKind.Named and declared_payload.name == "") else lower_expression(payload, state)
                valid_payloads <- false if not lowered_payload.valid
                if lowered_payload.valid and not (declared_payload.kind == TypeKind.Named and declared_payload.name == "") and not same_type(lowered_payload.type, declared_payload):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "raised error payload does not match its declared field type")
                    valid_payloads <- false
                payload_values.push(lowered_payload.value) if lowered_payload.valid
            return LoweredValue{valid: false, value: 0, type: result_type} if not valid_payloads
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.extend(payload_values)
            state.instructions.push(Instruction{opcode: Opcode.Raise, result: 0, result_type: result_type, operand_start: operand_start, operand_count: reference.payloads.count.u16(), effect_family: reference.owner, effect_operation: reference.tag, trace: trace_site(state, reference.tag, pos), span: ir_span(pos)})
            return LoweredValue{valid: true, value: 0, type: result_type}


        # Lower the non-recoverable `panic([message])` builtin. The optional
        # operand is still lowered so a message expression's effects happen in
        # source order, while the runtime keeps the abort distinct from the
        # recoverable error-set path used by `raise`.
        def lower_panic_expression(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = void_ir_type()
            valid_shape: mutable bool = arguments.count <= 1
            if argument_names.count != 0:
                for argument_name in argument_names:
                    valid_shape <- false if argument_name != ""
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "panic accepts at most one positional message value")
                return LoweredValue{valid: false, value: 0, type: result_type}
            message_value: mutable u32 = 0
            if arguments.count == 1:
                message: LoweredValue = lower_expression(arguments[0], state)
                return LoweredValue{valid: false, value: 0, type: result_type} if not message.valid
                message_value <- message.value
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(message_value) if arguments.count == 1
            state.required_effects.push("Abort.Panic") if not has_text(state.required_effects, "Abort.Panic")
            state.instructions.push(Instruction{opcode: Opcode.Panic, result: 0, result_type: result_type, effect_family: "Abort", effect_operation: "Panic", operand_start: operand_start, operand_count: arguments.count.u16(), trace: trace_site(state, "panic", pos), span: ir_span(pos)})
            return LoweredValue{valid: true, value: 0, type: result_type}


        # Effect references are intentionally split into exactly the same two
        # pieces used by the IR verifier.  A bare family must never be silently
        # converted into a synthetic `Family.signal` operation: that would make
        # malformed source look like a valid effect while bypassing handler clause
        # selection.  Keep this check small and byte-oriented so signal and value
        # perform share one deterministic spelling rule.
        def valid_effect_reference(reference: sview) -> bool:
            length: usize = sview_len(reference)
            return false if length < 3
            dots: mutable usize = 0
            for index in 0..<length |reference, dots|:
                dots <- dots + 1 if sview_at(reference, index) == 46
            return dots == 1 and sview_at(reference, 0) != 46 and sview_at(reference, length - 1) != 46


        def void_ir_type() -> Type:
            return Type{name: "", bits: 0, kind: TypeKind.Void, signed: false}


        def unknown_ir_type() -> Type:
            return Type{name: "", bits: 0, kind: TypeKind.Named, signed: false}


        def type_from_name(name: sview) -> Type:
            Type{name: "", bits: 0, kind: TypeKind.Void, signed: false} return if name == "void"
            Type{name: "", bits: 1, kind: TypeKind.Bool, signed: false} return if name == "bool"
            Type{name: "", bits: 8, kind: TypeKind.Char, signed: false} return if name == "char"
            Type{name: "", bits: 8, kind: TypeKind.Int, signed: false} return if name == "u8"
            Type{name: "", bits: 16, kind: TypeKind.Int, signed: false} return if name == "u16"
            Type{name: "", bits: 32, kind: TypeKind.Int, signed: false} return if name == "u32"
            Type{name: "", bits: 64, kind: TypeKind.Int, signed: false} return if name == "u" or name == "u64" or name == "usize"
            Type{name: "", bits: 8, kind: TypeKind.Int, signed: true} return if name == "i8"
            Type{name: "", bits: 16, kind: TypeKind.Int, signed: true} return if name == "i16"
            Type{name: "", bits: 32, kind: TypeKind.Int, signed: true} return if name == "i32"
            Type{name: "", bits: 64, kind: TypeKind.Int, signed: true} return if name == "i64" or name == "isize" or name == "int"
            Type{name: "", bits: 32, kind: TypeKind.Float, signed: true} return if name == "f32"
            Type{name: "", bits: 64, kind: TypeKind.Float, signed: true} return if name == "f64" or name == "float"
            Type{name: "", bits: 0, kind: TypeKind.Text, signed: false} return if name == "sview" or name == "cstr" or name == "dstr" or name == "Text"
            return Type{name: name, bits: 0, kind: TypeKind.Named, signed: false}


        def typed_literal_type(prefix: sview) -> Type:
            Type{kind: TypeKind.Named, name: "Path"} return if prefix == "path"
            Type{kind: TypeKind.Named, name: "Glob"} return if prefix == "glob"
            Type{kind: TypeKind.Named, name: "Regex"} return if prefix == "regex"
            Type{kind: TypeKind.Named, name: "Executable"} return if prefix == "exe"
            Type{kind: TypeKind.Named, name: "Url"} return if prefix == "url"
            return unknown_ir_type()


        def compiler_typed_literal(prefix: sview) -> bool:
            return prefix in {"path", "glob", "regex", "exe", "url"}


        def typed_literal_opcode(prefix: sview) -> Opcode:
            return Opcode.MakePath if prefix == "path"
            return Opcode.MakeGlob if prefix == "glob"
            return Opcode.MakeRegex if prefix == "regex"
            return Opcode.MakeExecutable if prefix == "exe"
            return Opcode.MakeUrl if prefix == "url"
            return Opcode.Constant


        def positive_integer_literal_fits(value: i64, type: Type&) -> bool:
            false return if type.kind != TypeKind.Int
            return not type.signed and type.bits == 64 if value < 0
            return true if type.bits == 64
            if type.signed:
                return value <= 127 if type.bits == 8
                return value <= 32767 if type.bits == 16
                return value <= 2147483647 if type.bits == 32
                return false
            return value <= 255 if type.bits == 8
            return value <= 65535 if type.bits == 16
            return value <= 4294967295 if type.bits == 32
            return false


        def negative_integer_literal_fits(magnitude: i64, type: Type&) -> bool:
            false return if type.kind != TypeKind.Int or not type.signed or magnitude < 0
            return magnitude <= 128 if type.bits == 8
            return magnitude <= 32768 if type.bits == 16
            return magnitude <= 2147483648 if type.bits == 32
            return true if type.bits == 64
            return false


        def type_from_expression(expression: Ast::Expr) -> Type:
            match expression:
                Expr.Ident(name, pos):
                    return type_from_name(name)
                Expr.Unary(operator, operand, pos):
                    return type_from_expression(operand)
                Expr.Index(collection, element_expression, pos):
                    match collection:
                        Expr.Ident(name, collection_pos):
                            if name == "array" or name == "Array" or name == "darray":
                                element_type: Type = type_from_expression(element_expression)
                                return array_ir_type(element_type)
                            if name == "set" or name == "Set":
                                # The first IR keeps set payloads in the existing
                                # deterministic map storage: each element is a key
                                # with a canonical `true` marker value. Source
                                # semantics still distinguish `set[T]` from maps.
                                element_type: mutable Type = type_from_expression(element_expression)
                                return set_ir_type(element_type)
                        _:
                            pass
                    return unknown_ir_type()
                Expr.IndexN(collection, arguments, pos):
                    match collection:
                        Expr.Ident(name, collection_pos):
                            if (name == "dict" or name == "Dict" or name == "map" or name == "Map") and arguments.count == 2:
                                key_type: Type = type_from_expression(arguments[0])
                                value_type: Type = type_from_expression(arguments[1])
                                return map_ir_type(key_type, value_type)
                        _:
                            pass
                    return unknown_ir_type()
                _:
                    return unknown_ir_type()


        def interned_type_from_expression(expression: Ast::Expr, table: mutable TypeTable&) -> Type can[Memory.Allocate, Abort.Panic]:
            value: mutable Type = type_from_expression(expression)
            value.descriptor_id <- intern_structural_type(value, table)
            return value


        def mutable_binding_type(expression: Ast::Expr) -> bool:
            match expression:
                Expr.Unary(operator, operand, pos):
                    return true if operator == TokenKind.Mutable
                    return mutable_binding_type(operand)
                _:
                    return false


        def array_ir_type_legacy(element: Type&) -> Type:
            return Type{kind: TypeKind.Array, element_kind: element.kind, element_name: element.name, element_bits: element.bits, element_element_kind: element.element_kind, element_element_name: element.element_name, element_element_bits: element.element_bits, element_element_element_kind: element.element_element_kind, element_element_element_name: element.element_element_name, element_element_element_bits: element.element_element_bits, element_element_element_signed: element.element_element_signed, element_element_element_element_kind: element.element_element_element_kind, element_element_element_element_name: element.element_element_element_name, element_element_element_element_bits: element.element_element_element_bits, element_element_element_element_signed: element.element_element_element_signed, element_element_element_element_element_kind: element.element_element_element_element_kind, element_element_element_element_element_name: element.element_element_element_element_name, element_element_element_element_element_bits: element.element_element_element_element_bits, element_element_element_element_element_signed: element.element_element_element_element_signed, element_element_signed: element.element_signed, element_signed: element.signed}


        # Extend the legacy array constructor with the sixth nested descriptor
        # layer. Keeping this adapter separate preserves the old flat helper for
        # compatibility while new lowering paths retain the full inline shape.
        def array_ir_type(element: Type&) -> Type:
            result: mutable Type = array_ir_type_legacy(element)
            result.element_element_element_element_element_element_kind <- element.element_element_element_element_element_kind
            result.element_element_element_element_element_element_name <- element.element_element_element_element_element_name
            result.element_element_element_element_element_element_bits <- element.element_element_element_element_element_bits
            result.element_element_element_element_element_element_signed <- element.element_element_element_element_element_signed
            return result


        # Map types keep the key and value descriptors inline. The value may use
        # the six compatibility layers; deeper aggregate shapes wait for the table.
        def map_ir_type_legacy(key: Type&, value: Type&) -> Type:
            return Type{kind: TypeKind.Map, element_kind: key.kind, element_name: key.name, element_bits: key.bits, element_signed: key.signed, element_element_kind: value.kind, element_element_name: value.name, element_element_bits: value.bits, element_element_signed: value.signed, element_element_element_kind: value.element_kind, element_element_element_name: value.element_name, element_element_element_bits: value.element_bits, element_element_element_signed: value.element_signed, element_element_element_element_kind: value.element_element_kind, element_element_element_element_name: value.element_element_name, element_element_element_element_bits: value.element_element_bits, element_element_element_element_signed: value.element_element_signed, element_element_element_element_element_kind: value.element_element_element_kind, element_element_element_element_element_name: value.element_element_element_name, element_element_element_element_element_bits: value.element_element_element_bits, element_element_element_element_element_signed: value.element_element_element_signed}


        # Preserve one additional value layer for map and set descriptors.
        def map_ir_type(key: Type&, value: Type&) -> Type:
            result: mutable Type = map_ir_type_legacy(key, value)
            result.element_element_element_element_element_element_kind <- value.element_element_element_element_kind
            result.element_element_element_element_element_element_name <- value.element_element_element_element_name
            result.element_element_element_element_element_element_bits <- value.element_element_element_element_bits
            result.element_element_element_element_element_element_signed <- value.element_element_element_element_signed
            return result


        # Sets share the first IR's map payload layout, but retain a marker in the
        # outer descriptor so set-only methods cannot be called on dict[T, bool].
        def set_ir_type(element: Type&) -> Type:
            marker: mutable Type = type_from_name("bool")
            result: mutable Type = map_ir_type(element, marker)
            result.name <- "__elisascript_set"
            return result


        # Map descriptors remain inline for compatibility. They can recurse through
        # nested maps, while map-held arrays retain the six-layer inline bound.
        # Keep keys scalar/nominal and reject only control-flow/void payloads;
        # backends that cannot execute a recursive aggregate can fall back to the VM.
        def dictionary_value_type_supported(value: Type&) -> bool:
            return false if value.kind in {TypeKind.Function, TypeKind.Block, TypeKind.Void}
            if value.kind == TypeKind.Map:
                key: Type = map_key_type(value)
                return false if key.kind in {TypeKind.Array, TypeKind.Map, TypeKind.Function, TypeKind.Block, TypeKind.Void}
                nested_map_value: mutable Type = map_value_type(value)
                return dictionary_value_type_supported(nested_map_value)
            if value.kind == TypeKind.Array:
                # The flat map descriptor has room for six array layers in a
                # value. Nested maps and arrays of nested maps are supported
                # recursively, but a seventh array layer still requires the table.
                if value.element_kind == TypeKind.Map:
                    nested_map: mutable Type = array_element_type(value)
                    return dictionary_value_type_supported(nested_map)
                return false if value.element_kind in {TypeKind.Function, TypeKind.Block, TypeKind.Void}
                return false if value.element_kind == TypeKind.Array and value.element_element_kind == TypeKind.Array and value.element_element_element_kind == TypeKind.Array and value.element_element_element_element_kind == TypeKind.Array and value.element_element_element_element_element_kind == TypeKind.Array and value.element_element_element_element_element_element_kind in {TypeKind.Array, TypeKind.Map, TypeKind.Function, TypeKind.Block, TypeKind.Void}
            return true


        def owned_ir_type_legacy(value: Type&) -> Type:
            return Type{kind: value.kind, name: value.name, bits: value.bits, signed: value.signed, element_kind: value.element_kind, element_name: value.element_name, element_bits: value.element_bits, element_signed: value.element_signed, element_element_kind: value.element_element_kind, element_element_name: value.element_element_name, element_element_bits: value.element_element_bits, element_element_signed: value.element_element_signed, element_element_element_kind: value.element_element_element_kind, element_element_element_name: value.element_element_element_name, element_element_element_bits: value.element_element_element_bits, element_element_element_signed: value.element_element_element_signed, element_element_element_element_kind: value.element_element_element_element_kind, element_element_element_element_name: value.element_element_element_element_name, element_element_element_element_bits: value.element_element_element_element_bits, element_element_element_element_signed: value.element_element_element_element_signed, element_element_element_element_element_kind: value.element_element_element_element_element_kind, element_element_element_element_element_name: value.element_element_element_element_element_name, element_element_element_element_element_bits: value.element_element_element_element_element_bits, element_element_element_element_element_signed: value.element_element_element_element_element_signed}


        def owned_ir_type(value: Type&) -> Type:
            result: mutable Type = owned_ir_type_legacy(value)
            result.element_element_element_element_element_element_kind <- value.element_element_element_element_element_kind
            result.element_element_element_element_element_element_name <- value.element_element_element_element_element_name
            result.element_element_element_element_element_element_bits <- value.element_element_element_element_element_element_bits
            result.element_element_element_element_element_element_signed <- value.element_element_element_element_element_element_signed
            return result


        def fresh_value(state: mutable LowerState&) -> u32:
            value: u32 = state.next_value
            state.next_value <- state.next_value + 1
            return value


        def fresh_block(state: mutable LowerState&) -> u32:
            block: u32 = state.next_block
            state.next_block <- state.next_block + 1
            return block


        def finish_block(state: mutable LowerState&) -> void can[Memory.Allocate, Abort.Panic]:
            parameter_start: u32 = state.block_parameter_pool.count.u32()
            parameter_count: mutable u16 = 0
            for index in 0..<state.pending_parameter_blocks.count |state, parameter_count|:
                if state.pending_parameter_blocks[index] == state.current_block:
                    state.block_parameter_pool.push(state.pending_parameters[index])
                    parameter_count <- parameter_count + 1
            state.blocks.push(Block{id: state.current_block, parameter_start: parameter_start, parameter_count: parameter_count, instruction_start: state.instruction_start, instruction_count: state.instructions.count.u32() - state.instruction_start, terminator: state.terminator})
            state.terminator <- Terminator{kind: TerminatorKind.Unreachable, span: zero_span()}
            state.current_block <- 0
            state.instruction_start <- state.instructions.count.u32()


        def add_issue(state: mutable LowerState&, kind: LowerIssueKind, line: u32, message: sview) -> void can[Memory.Allocate, Abort.Panic]:
            state.issues.push(LowerIssue{kind: kind, function: state.function, line: line, message: message})


        def lookup_binding(state: LowerState&, name: sview) -> LoweredValue:
            while index > 0 |index: usize = state.names.count|:
                index <- index - 1
                LoweredValue{valid: true, value: state.values[index], type: state.types[index]} return if state.names[index] == name
            return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}


        def binding_index(state: LowerState&, name: sview) -> usize:
            while index > 0 |index: usize = state.names.count|:
                index <- index - 1
                index return if state.names[index] == name
            return state.names.count


        def global_binding_index(state: LowerState&, name: sview) -> usize:
            for index in 0..<state.global_names.count |state, name|:
                return index if state.global_names[index] == name
            return state.global_names.count


        def emit_global_load(state: mutable LowerState&, index: usize, pos: Ast::Pos&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            return LoweredValue{valid: false, value: 0, type: unknown_ir_type()} if index >= state.global_names.count
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.LoadGlobal, result: result, result_type: state.global_types[index], integer: index.i64(), span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: state.global_types[index]}


        def lower_global_literal(declared: Type, initializer: Ast::Expr) -> GlobalLiteralProbe:
            invalid: GlobalLiteralProbe = GlobalLiteralProbe{valid: false, literal: GlobalLiteral{kind: TypeKind.Void}}
            result: mutable GlobalLiteral = GlobalLiteral{kind: declared.kind}
            match initializer:
                Expr.IntLit(value):
                    return invalid if declared.kind != TypeKind.Int or declared.bits != 64 or not declared.signed
                    result.integer <- value
                Expr.IntLitTyped(value, suffix):
                    suffix_type: Type = type_from_name(suffix)
                    return invalid if declared.kind != TypeKind.Int or not same_type(declared, suffix_type)
                    result.integer <- value
                Expr.FloatLit(text):
                    return invalid if declared.kind != TypeKind.Float
                    result.decimal <- text
                Expr.StringLit(text):
                    return invalid if declared.kind != TypeKind.Text and not text_backed_named_type(declared)
                    result.text <- text
                Expr.CharLit(text):
                    return invalid if declared.kind != TypeKind.Char
                    result.text <- text
                Expr.BoolLit(value):
                    return invalid if declared.kind != TypeKind.Bool
                    result.boolean <- value
                Expr.Call(Expr.Ident(prefix, _), arguments, argument_names, _):
                    return invalid if declared.kind != TypeKind.Named or arguments.count != 1 or (argument_names.count != 0 and argument_names[0] != "")
                    expected_prefix: sview = "path" if declared.name == "Path" else "glob" if declared.name == "Glob" else "regex" if declared.name == "Regex" else "exe" if declared.name == "Executable" else "url" if declared.name == "Url" else ""
                    return invalid if expected_prefix == "" or prefix != expected_prefix
                    match arguments[0]:
                        Expr.StringLit(text):
                            result.text <- text
                        _:
                            return invalid
                _:
                    return invalid
            return GlobalLiteralProbe{valid: true, literal: result}


        def lower_global_probe(name: sview, declared: Type, initializer: Ast::Expr) -> GlobalProbe:
            result: mutable Global = Global{name: name, type: declared}
            return GlobalProbe{valid: true, binding: result} if initializer is Expr.Invalid
            match initializer:
                Expr.Array(elements, _):
                    return GlobalProbe{valid: false, binding: result} if declared.kind != TypeKind.Array or not global_type_supported(array_element_type(declared))
                    element_type: Type = array_element_type(declared)
                    for element in elements |result, element_type|:
                        literal: GlobalLiteralProbe = lower_global_literal(element_type, element)
                        return GlobalProbe{valid: false, binding: result} if not literal.valid
                        result.aggregate_values.push(literal.literal)
                    result.initialized <- true
                    return GlobalProbe{valid: true, binding: result}
                Expr.DictLit(entries, _):
                    return GlobalProbe{valid: false, binding: result} if declared.kind != TypeKind.Map or not global_type_supported(map_key_type(declared)) or not global_type_supported(map_value_type(declared))
                    key_type: Type = map_key_type(declared)
                    value_type: Type = map_value_type(declared)
                    for entry in entries |result, key_type, value_type|:
                        key_literal: GlobalLiteralProbe = lower_global_literal(key_type, entry.key)
                        value_literal: GlobalLiteralProbe = lower_global_literal(value_type, entry.value)
                        return GlobalProbe{valid: false, binding: result} if not key_literal.valid or not value_literal.valid
                        result.aggregate_values.push(key_literal.literal)
                        result.aggregate_values.push(value_literal.literal)
                    result.initialized <- true
                    return GlobalProbe{valid: true, binding: result}
                _:
                    pass
            match initializer:
                Expr.IntLit(value):
                    return GlobalProbe{valid: false, binding: result} if declared.kind != TypeKind.Int or declared.bits != 64 or not declared.signed
                    result.integer <- value
                    result.initialized <- true
                Expr.IntLitTyped(value, suffix):
                    suffix_type: Type = type_from_name(suffix)
                    return GlobalProbe{valid: false, binding: result} if declared.kind != TypeKind.Int or not same_type(declared, suffix_type)
                    result.integer <- value
                    result.initialized <- true
                Expr.FloatLit(text):
                    return GlobalProbe{valid: false, binding: result} if declared.kind != TypeKind.Float
                    result.decimal <- text
                    result.initialized <- true
                Expr.StringLit(text):
                    return GlobalProbe{valid: false, binding: result} if declared.kind != TypeKind.Text
                    result.text <- text
                    result.initialized <- true
                Expr.CharLit(text):
                    return GlobalProbe{valid: false, binding: result} if declared.kind != TypeKind.Char
                    result.text <- text
                    result.initialized <- true
                Expr.BoolLit(value):
                    return GlobalProbe{valid: false, binding: result} if declared.kind != TypeKind.Bool
                    result.boolean <- value
                    result.initialized <- true
                Expr.Call(Expr.Ident(prefix, _), arguments, argument_names, _):
                    return GlobalProbe{valid: false, binding: result} if declared.kind != TypeKind.Named or arguments.count != 1 or (argument_names.count != 0 and argument_names[0] != "")
                    expected_prefix: sview = "path" if declared.name == "Path" else "glob" if declared.name == "Glob" else "regex" if declared.name == "Regex" else "exe" if declared.name == "Executable" else "url" if declared.name == "Url" else ""
                    return GlobalProbe{valid: false, binding: result} if expected_prefix == "" or prefix != expected_prefix
                    match arguments[0]:
                        Expr.StringLit(text):
                            result.text <- text
                            result.initialized <- true
                        _:
                            return GlobalProbe{valid: false, binding: result}
                _:
                    return GlobalProbe{valid: false, binding: result}
            return GlobalProbe{valid: true, binding: result}


        def add_unique_name(names: mutable darray[sview]&, name: sview) -> void can[Memory.Allocate, Abort.Panic]:
            names.push(name) if name != "" and not any existing in names where existing == name


        def add_handler_contract(state: mutable LowerState&, handler_name: sview) -> void can[Memory.Allocate, Abort.Panic]:
            index: usize = handler_index(state.handlers, handler_name)
            if index < state.handlers.count:
                for effect in state.handlers[index].introduces_effects |state|:
                    state.required_effects.push(effect) if effect != "" and not has_text(state.required_effects, effect)
                for error_set in state.handlers[index].errors |state|:
                    state.required_errors.push(error_set) if error_set != "" and not has_text(state.required_errors, error_set)


        # Source-level dynamic handlers are deliberately a narrow decorator DSL rather than
        # a second effect-language grammar.  A callback such as
        # `@handler("recorder", "Progress.Tick")` contributes one exact operation clause;
        # the callback's ordinary typed parameters and return type remain the source of truth
        # for payload and resumption typing.  An optional third argument selects the existing
        # continuation policy (`Linear`, `Affine`, `MultiReplay`, or `MultiClone`).
        def source_handler_annotation_arg(file: Ast::File&, annotation: Ast::Annotation&, offset: usize) -> sview:
            index: usize = annotation.arg_start.usize() + offset
            return file.annotation_args[index] if index < file.annotation_args.count and offset < annotation.arg_count.usize()
            return sview("", 0, 0)


        def source_handler_policy(name: sview, valid: mutable bool&) -> ContinuationPolicy:
            valid <- true
            return ContinuationPolicy.Linear if name == "Linear"
            return ContinuationPolicy.Affine if name == "Affine"
            return ContinuationPolicy.MultiReplay if name == "MultiReplay"
            return ContinuationPolicy.MultiClone if name == "MultiClone"
            valid <- false
            return ContinuationPolicy.Linear


        def source_handler_issue(issues: mutable darray[LowerIssue]&, function_name: sview, line: u32, message: sview) -> void can[Memory.Allocate, Abort.Panic]:
            issues.push(LowerIssue{kind: LowerIssueKind.TypeMismatch, function: function_name, line: line, message: message})


        def derive_source_handler_clause(file: Ast::File&, function_name: sview, decorator: Ast::Annotation&, handlers: mutable darray[Handler]&, issues: mutable darray[LowerIssue]&) -> void can[Memory.Allocate, Abort.Panic]:
            line: u32 = decorator.line
            count: usize = decorator.arg_count.usize()
            if count != 2 and count != 3:
                source_handler_issue(issues, function_name, line, "@handler expects a handler name, an exact Family.Operation reference, and an optional continuation policy")
                return
            handler_name: sview = source_handler_annotation_arg(file, decorator, 0)
            reference: sview = source_handler_annotation_arg(file, decorator, 1)
            if handler_name == "" or reference == "":
                source_handler_issue(issues, function_name, line, "@handler arguments must not be empty")
                return
            if not valid_effect_reference(reference):
                source_handler_issue(issues, function_name, line, "@handler operation must use Family.Operation form")
                return
            explicit_policy: mutable bool = false
            policy: mutable ContinuationPolicy = ContinuationPolicy.Linear
            if count == 3:
                explicit_policy <- true
                valid_policy: mutable bool = false
                policy <- source_handler_policy(source_handler_annotation_arg(file, decorator, 2), valid_policy)
                if not valid_policy:
                    source_handler_issue(issues, function_name, line, "@handler continuation policy must be Linear, Affine, MultiReplay, or MultiClone")
                    return
            index: usize = handler_index(handlers, handler_name)
            if index == handlers.count:
                handlers.push(Handler{name: handler_name, handles: [effect_family(reference)], introduces_effects: [], errors: [], continuation: policy, clauses: []})
                index <- handlers.count - 1
            elif explicit_policy and handlers[index].continuation != policy:
                source_handler_issue(issues, function_name, line, "@handler declarations for one handler must use one continuation policy")
                return
            family: sview = effect_family(reference)
            operation: sview = effect_operation(reference)
            handlers[index].handles.push(family) if not has_text(handlers[index].handles, family)
            for clause in handlers[index].clauses:
                if clause.effect_family == family and clause.effect_operation == operation:
                    source_handler_issue(issues, function_name, line, "@handler declares the same effect operation more than once")
                    return
            handlers[index].clauses.push(HandlerClause{effect_family: family, effect_operation: operation, function: function_name})


        def derive_source_handlers(declarations: darray[Ast::Decl]&, file: Ast::File&, handlers: mutable darray[Handler]&, issues: mutable darray[LowerIssue]&) -> void can[Memory.Allocate, Abort.Panic]:
            for declaration in declarations |file, handlers, issues|:
                match declaration:
                    Decl.Func(name, _, _, _, _, decorators, _):
                        for decorator in decorators |file, name, handlers, issues|:
                            derive_source_handler_clause(file, name, decorator, handlers, issues) if decorator.name == "handler"
                    Decl.Module(_, body, _):
                        derive_source_handlers(body, file, handlers, issues)
                    Decl.Scoped(body, _):
                        derive_source_handlers(body, file, handlers, issues)
                    _:
                        pass


        def comprehension_kind(state: LowerState&, pos: Ast::Pos&) -> sview:
            for annotation in state.comprehension_kinds |pos|:
                return annotation.name if annotation.owner == "__comprehension_kind" and annotation.line == pos.line
            # Hand-built ASTs from older clients have no parser side-table marker; retain
            # their historical array interpretation while parsed set/map/query forms carry
            # an explicit kind.
            return "array"


        def comprehension_query_kind(state: LowerState&, pos: Ast::Pos&) -> sview:
            for annotation in state.comprehension_kinds |pos|:
                return annotation.name if annotation.owner == "__query" and annotation.line == pos.line
            return ""


        def comprehension_extra_binder(state: LowerState&, pos: Ast::Pos&) -> sview:
            # Extra comprehension/query binders are line-paired parser annotations.
            # The canonical binder remains the `Expr.Comprehension` variable; only
            # dictionary and array projections currently consume this extension.
            for annotation in state.comprehension_kinds |pos|:
                return annotation.owner if annotation.name == "__query_binder" and annotation.line == pos.line
            return ""


        def comprehension_extra_binder_count(state: LowerState&, pos: Ast::Pos&) -> usize:
            count: mutable usize = 0
            for annotation in state.comprehension_kinds |pos, count|:
                count <- count + 1 if annotation.name == "__query_binder" and annotation.line == pos.line
            return count


        def emit_handler_unwind(state: mutable LowerState&, target_depth: usize, pos: Ast::Pos&) -> void can[Memory.Allocate, Abort.Panic]:
            while handler_index > target_depth |handler_index: usize = state.active_handlers.count|:
                handler_index <- handler_index - 1
                state.instructions.push(Instruction{opcode: Opcode.HandlerPop, result: 0, result_type: void_ir_type(), symbol: state.active_handlers[handler_index], trace: trace_site(state, "handler-unwind", pos), span: ir_span(pos)})


        def synchronize_mutable_element(state: mutable LowerState&, binding: usize, pos: Ast::Pos&) -> void can[Memory.Allocate, Abort.Panic]:
            for relation in 0..<state.element_binding_indices.count |state, binding|:
                if state.element_binding_indices[relation].usize() == binding:
                    owner: usize = state.element_owner_indices[relation].usize()
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(state.values[owner])
                    state.operand_pool.push(state.element_index_values[relation])
                    state.operand_pool.push(state.values[binding])
                    state.instructions.push(Instruction{opcode: Opcode.SetIndex, result: result, result_type: state.types[owner], operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
                    state.values[owner] <- result
                    return


        def supported_assignment_operator(operator: TokenKind) -> bool:
            return operator in {TokenKind.LArrow, TokenKind.PlusEq, TokenKind.MinusEq, TokenKind.StarEq, TokenKind.SlashEq, TokenKind.PercentEq, TokenKind.AmpEq, TokenKind.PipeEq, TokenKind.CaretEq, TokenKind.LShiftEq, TokenKind.RShiftEq}


        def compound_opcode(operator: TokenKind) -> Opcode:
            Opcode.Add return if operator == TokenKind.PlusEq
            Opcode.Subtract return if operator == TokenKind.MinusEq
            Opcode.Multiply return if operator == TokenKind.StarEq
            Opcode.Divide return if operator == TokenKind.SlashEq
            Opcode.Remainder return if operator == TokenKind.PercentEq
            Opcode.BitAnd return if operator == TokenKind.AmpEq
            Opcode.BitOr return if operator == TokenKind.PipeEq
            Opcode.BitXor return if operator == TokenKind.CaretEq
            Opcode.ShiftLeft return if operator == TokenKind.LShiftEq
            Opcode.ShiftRight return if operator == TokenKind.RShiftEq
            return Opcode.Copy


        def collect_assigned_names(statements: darray[Ast::Stmt]&, names: mutable darray[sview]&) -> void can[Memory.Allocate, Abort.Panic]:
            for statement in statements |names|:
                match statement:
                    Stmt.Expr(expression, pos):
                        match expression:
                            Expr.Call(Expr.Field(Expr.Ident(name, ident_pos), method, field_pos), arguments, argument_names, call_pos):
                                add_unique_name(names, name) if method == "push" or method == "append" or method == "pop" or method == "extend" or method == "add" or method == "clear" or method == "remove" or method == "reverse" or method == "insert" or method == "sort"
                            _:
                                pass
                    Stmt.Assign(target, operator, value, pos):
                        match target:
                            Expr.Ident(name, target_pos):
                                add_unique_name(names, name) if supported_assignment_operator(operator)
                            Expr.Index(Expr.Ident(name, target_pos), index_expression, index_pos):
                                add_unique_name(names, name) if supported_assignment_operator(operator)
                            _:
                                pass
                    Stmt.If(condition, then_body, else_body, pos):
                        collect_assigned_names(then_body, names)
                        collect_assigned_names(else_body, names)
                    Stmt.While(condition, body, pos):
                        collect_assigned_names(body, names)
                    Stmt.For(bind, variables, iterable, body, pos):
                        collect_assigned_names(body, names)
                    Stmt.Match(scrutinee, arms, pos):
                        for arm in arms |names|:
                            collect_assigned_names(arm.body, names)
                    Stmt.Block(kind, clause, binding, body, pos):
                        collect_assigned_names(body, names)
                    _:
                        pass


        def include_mutable_element_owners(state: LowerState&, names: mutable darray[sview]&) -> void can[Memory.Allocate, Abort.Panic]:
            assigned_count: usize = names.count
            for assigned in 0..<assigned_count |state, names|:
                binding: usize = binding_index(state, names[assigned])
                for relation in 0..<state.element_binding_indices.count |state, names, binding|:
                    if state.element_binding_indices[relation].usize() == binding:
                        owner: usize = state.element_owner_indices[relation].usize()
                        add_unique_name(names, state.names[owner])


        # Lower a tuple-destructuring assignment. The parser stores
        # comma-separated targets as an Expr.Array, while a literal RHS may be
        # Expr.Array (parenless commas) or Expr.Tuple (parenthesized commas).
        # Evaluate every RHS element before mutating or introducing any target
        # so swaps and other simultaneous assignments retain source semantics.
        # A non-literal RHS uses checked UnpackArray instructions; its static
        # array element type still keeps every target strongly typed.
        def lower_destructuring_assignment(target: Ast::Expr, operator: TokenKind, value: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            targets: darray[Ast::Expr] = []
            match target:
                Expr.Array(target_elements, target_pos):
                    targets.extend(target_elements)
                _:
                    return false
            return false if targets.count == 0

            values: darray[Ast::Expr] = []
            dynamic_value: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            dynamic_unpack: mutable bool = false
            binding_count_before_targets: usize = state.names.count
            match value:
                Expr.Array(value_elements, value_pos) | Expr.Tuple(value_elements, value_pos):
                    values.extend(value_elements)
                _:
                    dynamic_unpack <- true
                    dynamic_value <- lower_expression(value, state)
            if dynamic_unpack and (not dynamic_value.valid or dynamic_value.type.kind != TypeKind.Array):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "dynamic destructuring requires an array value")
                return true
            if not dynamic_unpack and targets.count != values.count:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "destructuring assignment target and value counts must match")
                return true

            lowered_values: mutable darray[LoweredValue] = []
            valid: mutable bool = true
            if dynamic_unpack:
                state.required_errors.push("IndexOutOfBounds") if not has_text(state.required_errors, "IndexOutOfBounds")
                element_type: Type = array_element_type(dynamic_value.type)
                for index in 0..<targets.count |state, dynamic_value, lowered_values, element_type, pos|:
                    index_value: LoweredValue = emit_constant(state, type_from_name("i64"), index.i64(), "", "", false, ir_span(pos))
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(dynamic_value.value)
                    state.operand_pool.push(index_value.value)
                    state.instructions.push(Instruction{opcode: Opcode.UnpackArray, result: result, result_type: element_type, integer: targets.count.i64(), operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                    lowered_values.push(LoweredValue{valid: true, value: result, type: element_type})
            else:
                for value_expression in values |state, lowered_values, valid|:
                    lowered: LoweredValue = lower_expression(value_expression, state)
                    lowered_values.push(lowered)
                    valid <- false if not lowered.valid
            return true if not valid

            target_names: mutable darray[sview] = []
            target_indices: mutable darray[usize] = []
            for target_expression in targets |state, target_names, target_indices, valid|:
                match target_expression:
                    Expr.Ident(target_name, target_pos):
                        target_names.push(target_name)
                        target_indices.push(binding_index(state, target_name))
                    _:
                        add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "destructuring assignment targets must be identifiers")
                        valid <- false
            return true if not valid
            for left_index in 0..<target_names.count |state, target_names, left_index, valid|:
                continue if target_names[left_index] == "_"
                for right_index in 0..<left_index |state, target_names, left_index, right_index, valid|:
                    if target_names[right_index] != "_" and target_names[right_index] == target_names[left_index]:
                        add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "destructuring assignment cannot repeat a target name")
                        valid <- false
            return true if not valid

            # `=` introduces fresh bindings. Existing names must use `<-` (or a
            # compound operator), matching the ordinary scalar assignment rules.
            if operator == TokenKind.Assign:
                for index in 0..<target_names.count |state, target_names, target_indices, lowered_values, index|:
                    continue if target_names[index] == "_"
                    if target_indices[index] != binding_count_before_targets:
                        add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "destructuring `=` targets must introduce fresh bindings")
                    else:
                        state.names.push(target_names[index])
                        state.values.push(lowered_values[index].value)
                        state.types.push(lowered_values[index].type)
                        state.mutables.push(false)
                return true

            if not supported_assignment_operator(operator):
                add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "destructuring assignment supports <- and typed arithmetic or bitwise compound operators")
                return true

            # Mutation targets are applied only after all RHS expressions have
            # been lowered, preserving simultaneous assignment behavior.
            for index in 0..<target_names.count |state, target_names, target_indices, lowered_values, index|:
                continue if target_names[index] == "_"
                target_index: usize = target_indices[index]
                if target_index == state.names.count:
                    add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "destructuring mutation target has no local binding")
                    continue
                if not state.mutables[target_index]:
                    add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "destructuring mutation requires mutable local bindings")
                    continue
                replacement: mutable LoweredValue = lowered_values[index]
                if operator != TokenKind.LArrow:
                    current_type: Type = state.types[target_index]
                    operands_match: bool = same_type(current_type, replacement.type)
                    opcode: Opcode = compound_opcode(operator)
                    arithmetic: bool = opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder}
                    bitwise: bool = opcode in {Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight}
                    valid_operation: bool = (arithmetic and operands_match and numeric_type(current_type) and (opcode != Opcode.Remainder or current_type.kind == TypeKind.Int)) or (bitwise and operands_match and current_type.kind == TypeKind.Int)
                    if not valid_operation:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "destructuring compound operands do not have compatible static types")
                        continue
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(state.values[target_index])
                    state.operand_pool.push(replacement.value)
                    state.instructions.push(Instruction{opcode: opcode, result: result, result_type: current_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                    replacement <- LoweredValue{valid: true, value: result, type: current_type}
                if not same_type(state.types[target_index], replacement.type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "destructuring assignment cannot change a binding's static type")
                    continue
                state.values[target_index] <- replacement.value
                synchronize_mutable_element(state, target_index, pos)
            return true


        def append_context_arguments(state: mutable LowerState&, context: usize) -> (start: u32, count: u16) can[Memory.Allocate, Abort.Panic]:
            start: u32 = state.edge_arg_pool.count.u32()
            carried_start: usize = state.loop_context_starts[context].usize()
            count: u16 = state.loop_context_counts[context]
            for offset in 0..<count.usize() |state, carried_start|:
                binding: usize = state.loop_carried_indices[carried_start + offset].usize()
                state.edge_arg_pool.push(state.values[binding])
            return (start, count)


        def lookup_return_type(state: LowerState&, name: sview) -> LoweredValue:
            for index in 0..<state.function_names.count |state|:
                LoweredValue{valid: true, value: 0, type: state.function_returns[index]} return if state.function_names[index] == name
            return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}


        def lowered_function_index(state: LowerState&, name: sview) -> usize:
            for index in 0..<state.function_names.count |state, name|:
                index return if state.function_names[index] == name
            return state.function_names.count


        def emit_constant(state: mutable LowerState&, type: Type, integer: i64, decimal: sview, text: sview, boolean: bool, span: SourceSpan) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.Constant, result: result, result_type: type, integer: integer, decimal: decimal, text: text, boolean: boolean, span: span})
            return LoweredValue{valid: true, value: result, type: type}


        def emit_comparison(state: mutable LowerState&, opcode: Opcode, left: u32, right: u32, pos: Ast::Pos&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result: u32 = fresh_value(state)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(left)
            state.operand_pool.push(right)
            result_type: Type = type_from_name("bool")
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def emit_binary(state: mutable LowerState&, opcode: Opcode, left: u32, right: u32, result_type: Type, pos: Ast::Pos&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result: u32 = fresh_value(state)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(left)
            state.operand_pool.push(right)
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Lowering a comprehension needs the projected element type before the
        # accumulator loop can be typed. Probe straight-line expressions in a
        # temporary lexical binding, then roll back every emitted artifact. CFG
        # expressions are intentionally rejected here until a general region
        # expression lowering can thread their merges through the comprehension.
        def probe_comprehension_body(expression: Ast::Expr, variable: sview, element_type: Type, extra_variable: sview, extra_type: Type, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            names_count: usize = state.names.count
            values_count: usize = state.values.count
            types_count: usize = state.types.count
            mutables_count: usize = state.mutables.count
            instruction_count: usize = state.instructions.count
            operand_count: usize = state.operand_pool.count
            edge_count: usize = state.edge_arg_pool.count
            block_count: usize = state.blocks.count
            pending_block_count: usize = state.pending_parameter_blocks.count
            pending_parameter_count: usize = state.pending_parameters.count
            block_parameter_count: usize = state.block_parameter_pool.count
            issue_count: usize = state.issues.count
            required_effect_count: usize = state.required_effects.count
            required_error_count: usize = state.required_errors.count
            next_value: u32 = state.next_value
            next_block: u32 = state.next_block
            current_block: u32 = state.current_block
            instruction_start: u32 = state.instruction_start
            structured_depth: u32 = state.structured_depth
            terminated: bool = state.terminated
            state.names.push(variable)
            state.values.push(1)
            state.types.push(element_type)
            state.mutables.push(false)
            if extra_variable != "":
                state.names.push(extra_variable)
                state.values.push(2)
                state.types.push(extra_type)
                state.mutables.push(false)
            probed: LoweredValue = lower_expression(expression, state)
            projected_type: Type = probed.type
            straight_line: bool = probed.valid and state.instructions.count >= instruction_count and state.blocks.count == block_count and state.pending_parameter_blocks.count == pending_block_count and state.pending_parameters.count == pending_parameter_count and state.block_parameter_pool.count == block_parameter_count and state.current_block == current_block and state.terminated == terminated and state.structured_depth == structured_depth
            state.names.truncate(names_count)
            state.values.truncate(values_count)
            state.types.truncate(types_count)
            state.mutables.truncate(mutables_count)
            state.instructions.truncate(instruction_count)
            state.operand_pool.truncate(operand_count)
            state.edge_arg_pool.truncate(edge_count)
            state.blocks.truncate(block_count)
            state.pending_parameter_blocks.truncate(pending_block_count)
            state.pending_parameters.truncate(pending_parameter_count)
            state.block_parameter_pool.truncate(block_parameter_count)
            state.issues.truncate(issue_count)
            state.required_effects.truncate(required_effect_count)
            state.required_errors.truncate(required_error_count)
            state.next_value <- next_value
            state.next_block <- next_block
            state.current_block <- current_block
            state.instruction_start <- instruction_start
            state.structured_depth <- structured_depth
            state.terminated <- terminated
            return LoweredValue{valid: straight_line, value: 0, type: projected_type}


        # Dict comprehensions keep the pair as an AST tuple because the shared parser node
        # predates first-class tuple values. Probe both sides in one temporary binder scope;
        # the same rollback guarantees as the list projection probe prevent speculative SSA
        # definitions or diagnostics from leaking into the final map loop.
        def probe_comprehension_pair(expression: Ast::Expr, variable: sview, element_type: Type, extra_variable: sview, extra_type: Type, pos: Ast::Pos&, state: mutable LowerState&) -> ComprehensionPairProbe can[Memory.Allocate, Abort.Panic]:
            unknown: Type = unknown_ir_type()
            match expression:
                Expr.Tuple(elements, tuple_pos):
                    if elements.count != 2:
                        return ComprehensionPairProbe{valid: false, key_type: unknown, value_type: unknown}
                    names_count: usize = state.names.count
                    values_count: usize = state.values.count
                    types_count: usize = state.types.count
                    mutables_count: usize = state.mutables.count
                    instruction_count: usize = state.instructions.count
                    operand_count: usize = state.operand_pool.count
                    edge_count: usize = state.edge_arg_pool.count
                    block_count: usize = state.blocks.count
                    pending_block_count: usize = state.pending_parameter_blocks.count
                    pending_parameter_count: usize = state.pending_parameters.count
                    block_parameter_count: usize = state.block_parameter_pool.count
                    issue_count: usize = state.issues.count
                    required_effect_count: usize = state.required_effects.count
                    required_error_count: usize = state.required_errors.count
                    next_value: u32 = state.next_value
                    next_block: u32 = state.next_block
                    current_block: u32 = state.current_block
                    instruction_start: u32 = state.instruction_start
                    structured_depth: u32 = state.structured_depth
                    terminated: bool = state.terminated
                    state.names.push(variable)
                    state.values.push(1)
                    state.types.push(element_type)
                    state.mutables.push(false)
                    if extra_variable != "":
                        state.names.push(extra_variable)
                        state.values.push(2)
                        state.types.push(extra_type)
                        state.mutables.push(false)
                    key: LoweredValue = lower_expression(elements[0], state)
                    value: LoweredValue = lower_expression(elements[1], state)
                    key_type: Type = key.type
                    value_type: Type = value.type
                    straight_line: bool = key.valid and value.valid and state.instructions.count >= instruction_count and state.blocks.count == block_count and state.pending_parameter_blocks.count == pending_block_count and state.pending_parameters.count == pending_parameter_count and state.block_parameter_pool.count == block_parameter_count and state.current_block == current_block and state.terminated == terminated and state.structured_depth == structured_depth
                    state.names.truncate(names_count)
                    state.values.truncate(values_count)
                    state.types.truncate(types_count)
                    state.mutables.truncate(mutables_count)
                    state.instructions.truncate(instruction_count)
                    state.operand_pool.truncate(operand_count)
                    state.edge_arg_pool.truncate(edge_count)
                    state.blocks.truncate(block_count)
                    state.pending_parameter_blocks.truncate(pending_block_count)
                    state.pending_parameters.truncate(pending_parameter_count)
                    state.block_parameter_pool.truncate(block_parameter_count)
                    state.issues.truncate(issue_count)
                    state.required_effects.truncate(required_effect_count)
                    state.required_errors.truncate(required_error_count)
                    state.next_value <- next_value
                    state.next_block <- next_block
                    state.current_block <- current_block
                    state.instruction_start <- instruction_start
                    state.structured_depth <- structured_depth
                    state.terminated <- terminated
                    return ComprehensionPairProbe{valid: straight_line, key_type: key_type, value_type: value_type}
                _:
                    return ComprehensionPairProbe{valid: false, key_type: unknown, value_type: unknown}


        def lower_array_comprehension(variable: sview, iterable: Ast::Expr, condition: Ast::Expr, body: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: mutable Type = unknown_ir_type()
            source_kind: mutable sview = comprehension_kind(state, pos)
            projection: mutable Ast::Expr = body
            if source_kind == "query" and comprehension_query_kind(state, pos) == "each":
                projection <- Expr.Ident(variable, Ast::Pos{line: pos.line, column: pos.column, offset: pos.offset, end_line: pos.end_line, end_column: pos.end_column, end_offset: pos.end_offset})
                source_kind <- "array"
            body_absent: mutable bool = false
            match projection:
                Expr.Absent:
                    body_absent <- true
                _:
                    pass
            if source_kind != "array":
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "only list comprehensions are in the initial IR lowering subset")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if variable == "" or body_absent:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "only projected array comprehensions are in the initial IR lowering subset")
                return LoweredValue{valid: false, value: 0, type: result_type}
            normalized_iterable: mutable Ast::Expr = iterable
            match iterable:
                Expr.Call(Expr.Ident(name, name_pos), arguments, argument_names, call_pos):
                    valid_names: mutable bool = arguments.count > 0 and arguments.count <= 3 and (argument_names.count == 0 or argument_names.count == arguments.count)
                    if valid_names and argument_names.count != 0:
                        for argument_name in argument_names |valid_names|:
                            valid_names <- false if argument_name != ""
                    if name == "range" and valid_names and lowered_function_index(state, name) == state.function_names.count:
                        if arguments.count == 1:
                            normalized_iterable <- Expr.Binary(Expr.IntLit(0), TokenKind.RangeLt, arguments[0], call_pos)
                        elif arguments.count == 2:
                            normalized_iterable <- Expr.Binary(arguments[0], TokenKind.RangeLt, arguments[1], call_pos)
                        else:
                            range_operator: mutable TokenKind = TokenKind.RangeLt
                            range_step: mutable Ast::Expr = arguments[2]
                            match arguments[2]:
                                Expr.Unary(step_operator, magnitude, step_pos):
                                    if step_operator == TokenKind.Minus:
                                        match magnitude:
                                            Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                                                if value > 0:
                                                    range_operator <- TokenKind.RangeGt
                                                    range_step <- magnitude
                                            _:
                                                pass
                                _:
                                    pass
                            bounded_range: Ast::Expr = Expr.Binary(arguments[0], range_operator, arguments[1], call_pos)
                            normalized_iterable <- Expr.Binary(bounded_range, TokenKind.Range, range_step, call_pos)
                _:
                    pass
            range_spec: ComprehensionRange = comprehension_range_parts(normalized_iterable)
            range_mode: bool = range_spec.recognized
            extra_variable: sview = comprehension_extra_binder(state, pos)
            zip_mode: mutable bool = false
            zip_left_source: mutable Ast::Expr = Expr.Absent
            zip_right_source: mutable Ast::Expr = Expr.Absent
            enumerate_mode: mutable bool = false
            enumerate_source: mutable Ast::Expr = Expr.Absent
            enumerate_start: mutable Ast::Expr = Expr.Absent
            match iterable:
                Expr.Call(Expr.Ident(name, name_pos), arguments, argument_names, call_pos):
                    valid_zip_names: mutable bool = arguments.count == 2 and (argument_names.count == 0 or argument_names.count == arguments.count)
                    if valid_zip_names:
                        for argument_name in argument_names |valid_zip_names|:
                            valid_zip_names <- false if argument_name != ""
                    if name == "zip" and valid_zip_names and lowered_function_index(state, name) == state.function_names.count:
                        zip_mode <- true
                        zip_left_source <- arguments[0]
                        zip_right_source <- arguments[1]
                    valid_enumerate_names: mutable bool = arguments.count >= 1 and arguments.count <= 2 and (argument_names.count == 0 or argument_names.count == arguments.count)
                    if valid_enumerate_names and argument_names.count != 0:
                        for argument_name in argument_names |valid_enumerate_names|:
                            valid_enumerate_names <- false if argument_name != "" and argument_name != "start"
                        valid_enumerate_names <- false if argument_names.count == 2 and argument_names[0] != ""
                    if name == "enumerate" and valid_enumerate_names and lowered_function_index(state, name) == state.function_names.count:
                        enumerate_mode <- true
                        enumerate_source <- arguments[0]
                        enumerate_start <- arguments[1] if arguments.count == 2
                _:
                    pass
            map_mode: bool = extra_variable != "" and not zip_mode and not enumerate_mode
            extra_binder_count: usize = comprehension_extra_binder_count(state, pos)
            collection: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            iteration_collection: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            map_collection: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            range_low: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            range_high: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            range_step: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            dynamic_range_step: mutable bool = false
            extra_type: mutable Type = unknown_ir_type()
            zip_right_collection: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            zip_limit: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            if extra_binder_count > 1:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "array comprehensions support at most key and value binders")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if zip_mode and extra_variable == "":
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "zip comprehensions require two element binders")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if enumerate_mode and extra_variable == "":
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "enumerate comprehensions require index and value binders")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if range_mode and map_mode:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "array comprehensions cannot combine range iteration with multiple binders")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if range_mode:
                range_low <- lower_expression(range_spec.low, state)
                if not range_low.valid:
                    return LoweredValue{valid: false, value: 0, type: result_type}
                range_high <- lower_expression_expected(range_spec.high, range_low.type, state)
                if not range_high.valid or range_low.type.kind != TypeKind.Int or not same_type(range_low.type, range_high.type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range comprehension bounds must have the same integer type")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                range_step <- emit_constant(state, range_low.type, 1, "", "", false, ir_span(pos))
                if range_spec.step is not Expr.Absent:
                    positive_literal: mutable bool = false
                    step_literal: mutable bool = false
                    match range_spec.step:
                        Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                            step_literal <- true
                            positive_literal <- value > 0
                        _:
                            pass
                    if step_literal and not positive_literal:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range comprehension stride must be a positive integer constant or a typed integer expression")
                        return LoweredValue{valid: false, value: 0, type: result_type}
                    if positive_literal:
                        range_step <- lower_expression_expected(range_spec.step, range_low.type, state)
                    else:
                        dynamic_range_step <- true
                        range_step <- lower_expression_expected(range_spec.step, range_low.type, state)
                    if not range_step.valid or not same_type(range_step.type, range_low.type):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range comprehension stride must match the bound type")
                        return LoweredValue{valid: false, value: 0, type: result_type}
                    state.required_errors.push("RangeStepZero") if dynamic_range_step and not has_text(state.required_errors, "RangeStepZero")
            elif zip_mode:
                collection <- lower_expression(zip_left_source, state)
                zip_right_collection <- lower_expression(zip_right_source, state)
                if not collection.valid or not zip_right_collection.valid:
                    return LoweredValue{valid: false, value: 0, type: result_type}
                if collection.type.kind not in {TypeKind.Array, TypeKind.Text} or zip_right_collection.type.kind not in {TypeKind.Array, TypeKind.Text}:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "zip comprehensions require array or text sources")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                iteration_collection <- collection
                extra_type <- type_from_name("char") if zip_right_collection.type.kind == TypeKind.Text else array_element_type(zip_right_collection.type)
            elif enumerate_mode:
                collection <- lower_expression(enumerate_source, state)
                if not collection.valid:
                    return LoweredValue{valid: false, value: 0, type: result_type}
                if collection.type.kind not in {TypeKind.Array, TypeKind.Text}:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "enumerate comprehensions require an array or text source")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                iteration_collection <- collection
                extra_type <- type_from_name("char") if collection.type.kind == TypeKind.Text else array_element_type(collection.type)
            elif map_mode:
                collection <- lower_expression(iterable, state)
                if not collection.valid:
                    return LoweredValue{valid: false, value: 0, type: result_type}
                if collection.type.kind != TypeKind.Map:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "multiple array comprehension binders require a dictionary iterable")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                map_collection <- collection
                extra_type <- map_value_type(collection.type)
                key_type: Type = map_key_type(collection.type)
                keys_type: Type = array_ir_type(key_type)
                keys_result: u32 = fresh_value(state)
                keys_operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(collection.value)
                state.instructions.push(Instruction{opcode: Opcode.MapKeys, result: keys_result, result_type: keys_type, operand_start: keys_operand_start, operand_count: 1, span: ir_span(pos)})
                iteration_collection <- LoweredValue{valid: true, value: keys_result, type: keys_type}
            else:
                collection <- lower_expression(iterable, state)
                if not collection.valid:
                    return LoweredValue{valid: false, value: 0, type: result_type}
                if collection.type.kind != TypeKind.Array and collection.type.kind != TypeKind.Text:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "array comprehensions require an array, text, or integer range iterable")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                iteration_collection <- collection
            element_type: Type = range_low.type if range_mode else (map_key_type(collection.type) if map_mode else (type_from_name("char") if collection.type.kind == TypeKind.Text else array_element_type(collection.type)))
            index_type: Type = range_low.type if range_mode else type_from_name("usize")
            variable_type: Type = index_type if enumerate_mode else element_type
            projected: LoweredValue = probe_comprehension_body(projection, variable, variable_type, extra_variable, extra_type, pos, state)
            if not projected.valid:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "comprehension projection must be a straight-line typed expression")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if projected.type.kind in {TypeKind.Void, TypeKind.Function, TypeKind.Block}:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "comprehension projection must produce a storable value")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if projected.type.kind == TypeKind.Array and projected.type.element_kind == TypeKind.Array and projected.type.element_element_kind == TypeKind.Array and projected.type.element_element_element_kind == TypeKind.Array and projected.type.element_element_element_element_kind == TypeKind.Array and projected.type.element_element_element_element_element_kind == TypeKind.Array:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "comprehension results nested deeper than six levels are not implemented yet")
                return LoweredValue{valid: false, value: 0, type: result_type}
            result_type <- array_ir_type(projected.type)
            initial_result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.MakeArray, result: initial_result, result_type: result_type, operand_start: state.operand_pool.count.u32(), operand_count: 0, span: ir_span(pos)})
            initial: LoweredValue = LoweredValue{valid: true, value: initial_result, type: result_type}

            accumulator_name: sview = "__es_comprehension_accumulator"
            state.names.push(accumulator_name)
            state.values.push(initial.value)
            state.types.push(result_type)
            state.mutables.push(true)
            accumulator_index: usize = state.names.count - 1
            context_start: u32 = state.loop_carried_indices.count.u32()
            state.loop_carried_indices.push(accumulator_index.u32())
            state.loop_context_starts.push(context_start)
            state.loop_context_counts.push(1)
            state.loop_handler_depths.push(state.active_handlers.count.u32())
            context: usize = state.loop_context_counts.count - 1
            header_block: u32 = fresh_block(state)
            body_block: u32 = fresh_block(state)
            condition_absent: mutable bool = false
            match condition:
                Expr.Absent:
                    condition_absent <- true
                _:
                    pass
            append_block: u32 = body_block if condition_absent else fresh_block(state)
            latch_block: u32 = fresh_block(state)
            exit_block: u32 = fresh_block(state)
            enumerate_offset: mutable LoweredValue = LoweredValue{valid: true, value: 0, type: index_type}
            if enumerate_mode and enumerate_start is not Expr.Absent:
                enumerate_offset <- lower_enumerate_start(enumerate_start, pos, state)
            initial_index: LoweredValue = range_low if range_mode else emit_constant(state, index_type, 0, "", "", false, ir_span(pos))
            entry_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.edge_arg_pool.push(initial_index.value)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: entry_args.start, edge0_arg_count: entry_args.count + 1, span: ir_span(pos)}
            finish_block(state)

            header_accumulator: u32 = fresh_value(state)
            latch_accumulator: u32 = fresh_value(state)
            exit_accumulator: u32 = fresh_value(state)
            header_index: u32 = fresh_value(state)
            state.pending_parameter_blocks.push(header_block)
            state.pending_parameters.push(Parameter{value: header_accumulator, type: result_type, name: accumulator_name})
            state.pending_parameter_blocks.push(latch_block)
            state.pending_parameters.push(Parameter{value: latch_accumulator, type: result_type, name: accumulator_name})
            state.pending_parameter_blocks.push(exit_block)
            state.pending_parameters.push(Parameter{value: exit_accumulator, type: result_type, name: accumulator_name})
            state.pending_parameter_blocks.push(header_block)
            state.pending_parameters.push(Parameter{value: header_index, type: index_type, name: "comprehension-index"})
            state.values[accumulator_index] <- header_accumulator

            # A map iterable uses its key snapshot for the canonical binder and
            # performs the value lookup only when the iteration body is entered.
            state.current_block <- header_block
            state.terminated <- false
            condition_result: u32 = fresh_value(state)
            if range_mode:
                condition_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(header_index)
                state.operand_pool.push(range_high.value)
                if dynamic_range_step:
                    state.operand_pool.push(range_step.value)
                    direction: i64 = 2 if range_spec.operator == TokenKind.RangeGt else (1 if range_spec.operator == TokenKind.RangeLe else 0)
                    state.instructions.push(Instruction{opcode: Opcode.RangeCondition, result: condition_result, result_type: type_from_name("bool"), operand_start: condition_start, operand_count: 3, integer: direction, span: ir_span(pos)})
                else:
                    comparison: Opcode = Opcode.Greater if range_spec.operator == TokenKind.RangeGt else (Opcode.LessEqual if range_spec.operator == TokenKind.RangeLe else Opcode.Less)
                    state.instructions.push(Instruction{opcode: comparison, result: condition_result, result_type: type_from_name("bool"), operand_start: condition_start, operand_count: 2, span: ir_span(pos)})
            else:
                length_result: mutable u32 = 0
                if zip_mode:
                    zip_limit <- lower_zip_limit(collection, zip_right_collection, pos, state)
                    length_result <- zip_limit.value
                else:
                    length_result <- fresh_value(state)
                    length_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(iteration_collection.value)
                    state.instructions.push(Instruction{opcode: Opcode.Length, result: length_result, result_type: index_type, operand_start: length_start, operand_count: 1, span: ir_span(pos)})
                condition_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(header_index)
                state.operand_pool.push(length_result)
                state.instructions.push(Instruction{opcode: Opcode.Less, result: condition_result, result_type: type_from_name("bool"), operand_start: condition_start, operand_count: 2, span: ir_span(pos)})
            exit_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition_result, operand_count: 1, target0: body_block, target1: exit_block, target_count: 2, edge1_arg_start: exit_args.start, edge1_arg_count: exit_args.count, span: ir_span(pos)}
            finish_block(state)

            outer_scope: usize = state.names.count
            state.structured_depth <- state.structured_depth + 1
            state.break_targets.push(exit_block)
            state.continue_targets.push(latch_block)
            state.current_block <- body_block
            state.terminated <- false
            element_result: u32 = header_index if range_mode else fresh_value(state)
            if not range_mode:
                element_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(iteration_collection.value)
                state.operand_pool.push(header_index)
                state.instructions.push(Instruction{opcode: Opcode.Index, result: element_result, result_type: element_type, operand_start: element_start, operand_count: 2, span: ir_span(pos)})
            if enumerate_mode:
                enumerate_index_value: mutable u32 = header_index
                if enumerate_start is not Expr.Absent:
                    enumerate_index: LoweredValue = emit_binary(state, Opcode.Add, header_index, enumerate_offset.value, index_type, pos)
                    enumerate_index_value <- enumerate_index.value
                state.names.push(variable)
                state.values.push(enumerate_index_value)
                state.types.push(index_type)
                state.mutables.push(false)
                state.names.push(extra_variable)
                state.values.push(element_result)
                state.types.push(element_type)
                state.mutables.push(false)
            else:
                state.names.push(variable)
                state.values.push(element_result)
                state.types.push(element_type)
                state.mutables.push(false)
                if map_mode:
                    value_result: u32 = fresh_value(state)
                    value_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(map_collection.value)
                    state.operand_pool.push(element_result)
                    state.instructions.push(Instruction{opcode: Opcode.Index, result: value_result, result_type: extra_type, operand_start: value_start, operand_count: 2, span: ir_span(pos)})
                    state.names.push(extra_variable)
                    state.values.push(value_result)
                    state.types.push(extra_type)
                    state.mutables.push(false)
                elif zip_mode:
                    zip_element_result: u32 = fresh_value(state)
                    zip_element_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(zip_right_collection.value)
                    state.operand_pool.push(header_index)
                    state.instructions.push(Instruction{opcode: Opcode.Index, result: zip_element_result, result_type: extra_type, operand_start: zip_element_start, operand_count: 2, span: ir_span(pos)})
                    state.names.push(extra_variable)
                    state.values.push(zip_element_result)
                    state.types.push(extra_type)
                    state.mutables.push(false)
            filter_value: mutable LoweredValue = LoweredValue{valid: true, value: 0, type: type_from_name("bool")}
            if not condition_absent:
                filter_value <- lower_expression(condition, state)
                if filter_value.valid and filter_value.type.kind != TypeKind.Bool:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "comprehension filter must have boolean type")
                    filter_value <- LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
                if filter_value.valid:
                    skip_args: (start: u32, count: u16) = append_context_arguments(state, context)
                    state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: filter_value.value, operand_count: 1, target0: append_block, target1: latch_block, target_count: 2, edge1_arg_start: skip_args.start, edge1_arg_count: skip_args.count, span: ir_span(pos)}
                else:
                    skip_args: (start: u32, count: u16) = append_context_arguments(state, context)
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: latch_block, target_count: 1, edge0_arg_start: skip_args.start, edge0_arg_count: skip_args.count, span: ir_span(pos)}
                finish_block(state)

            state.current_block <- append_block
            state.terminated <- false
            projected_value: mutable LoweredValue = lower_expression(projection, state)
            if projected_value.valid and not same_type(projected_value.type, projected.type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "comprehension projection type changed during lowering")
                projected_value <- LoweredValue{valid: false, value: 0, type: projected.type}
            if projected_value.valid:
                singleton: u32 = fresh_value(state)
                singleton_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(projected_value.value)
                state.instructions.push(Instruction{opcode: Opcode.MakeArray, result: singleton, result_type: result_type, operand_start: singleton_start, operand_count: 1, span: ir_span(pos)})
                appended: LoweredValue = emit_binary(state, Opcode.Concat, state.values[accumulator_index], singleton, result_type, pos)
                state.values[accumulator_index] <- appended.value
            append_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: latch_block, target_count: 1, edge0_arg_start: append_args.start, edge0_arg_count: append_args.count, span: ir_span(pos)} if not state.terminated
            finish_block(state)
            _ = state.break_targets.pop()
            _ = state.continue_targets.pop()
            state.names.truncate(outer_scope)
            state.values.truncate(outer_scope)
            state.types.truncate(outer_scope)
            state.mutables.truncate(outer_scope)

            state.current_block <- latch_block
            state.terminated <- false
            state.values[accumulator_index] <- latch_accumulator
            one: LoweredValue = range_step if range_mode else emit_constant(state, index_type, 1, "", "", false, ir_span(pos))
            next_index: u32 = fresh_value(state)
            increment_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(header_index)
            state.operand_pool.push(one.value)
            step_opcode: Opcode = Opcode.Subtract if range_mode and range_spec.operator == TokenKind.RangeGt else Opcode.Add
            state.instructions.push(Instruction{opcode: step_opcode, result: next_index, result_type: index_type, operand_start: increment_start, operand_count: 2, span: ir_span(pos)})
            backedge_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.edge_arg_pool.push(next_index)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: backedge_args.start, edge0_arg_count: backedge_args.count + 1, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- exit_block
            state.terminated <- false
            state.values[accumulator_index] <- exit_accumulator
            result: LoweredValue = LoweredValue{valid: filter_value.valid and projected_value.valid, value: exit_accumulator, type: result_type}
            _ = state.loop_context_starts.pop()
            _ = state.loop_context_counts.pop()
            _ = state.loop_handler_depths.pop()
            state.loop_carried_indices.truncate(context_start.usize())
            state.structured_depth <- state.structured_depth - 1
            state.names.truncate(accumulator_index)
            state.values.truncate(accumulator_index)
            state.types.truncate(accumulator_index)
            state.mutables.truncate(accumulator_index)
            return result


        # Set comprehensions reuse the map loop with a canonical `true` marker for
        # every projected element. The source semantic layer still enforces set
        # element rules; the IR representation preserves deterministic key order
        # and membership/count behavior without introducing a second hash table.
        def lower_set_comprehension(variable: sview, iterable: Ast::Expr, condition: Ast::Expr, body: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            marker: Ast::Expr = Expr.BoolLit(true)
            tuple_pos: Ast::Pos = Ast::Pos{line: pos.line, column: pos.column, offset: pos.offset, end_line: pos.end_line, end_column: pos.end_column, end_offset: pos.end_offset}
            pair: Ast::Expr = Expr.Tuple([body, marker], tuple_pos)
            return lower_map_comprehension(variable, iterable, condition, pair, pos, state)


        # Dict comprehensions use the same loop-carried state machine as list
        # comprehensions, but update a typed map through immutable `SetIndex` copies.
        # Duplicate keys therefore retain the runtime's ordinary replacement semantics,
        # while new keys are appended in source iteration order.
        def lower_map_comprehension(variable: sview, iterable: Ast::Expr, condition: Ast::Expr, body: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: mutable Type = unknown_ir_type()
            body_pair: mutable bool = false
            match body:
                Expr.Tuple(elements, tuple_pos):
                    body_pair <- elements.count == 2
                _:
                    pass
            if not body_pair:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "dict comprehensions require one key/value projection pair")
                return LoweredValue{valid: false, value: 0, type: result_type}
            normalized_iterable: mutable Ast::Expr = iterable
            match iterable:
                Expr.Call(Expr.Ident(name, name_pos), arguments, argument_names, call_pos):
                    valid_names: mutable bool = arguments.count > 0 and arguments.count <= 3 and (argument_names.count == 0 or argument_names.count == arguments.count)
                    if valid_names and argument_names.count != 0:
                        for argument_name in argument_names |valid_names|:
                            valid_names <- false if argument_name != ""
                    if name == "range" and valid_names and lowered_function_index(state, name) == state.function_names.count:
                        if arguments.count == 1:
                            normalized_iterable <- Expr.Binary(Expr.IntLit(0), TokenKind.RangeLt, arguments[0], call_pos)
                        elif arguments.count == 2:
                            normalized_iterable <- Expr.Binary(arguments[0], TokenKind.RangeLt, arguments[1], call_pos)
                        else:
                            range_operator: mutable TokenKind = TokenKind.RangeLt
                            range_step: mutable Ast::Expr = arguments[2]
                            match arguments[2]:
                                Expr.Unary(step_operator, magnitude, step_pos):
                                    if step_operator == TokenKind.Minus:
                                        match magnitude:
                                            Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                                                if value > 0:
                                                    range_operator <- TokenKind.RangeGt
                                                    range_step <- magnitude
                                            _:
                                                pass
                                _:
                                    pass
                            bounded_range: Ast::Expr = Expr.Binary(arguments[0], range_operator, arguments[1], call_pos)
                            normalized_iterable <- Expr.Binary(bounded_range, TokenKind.Range, range_step, call_pos)
                _:
                    pass
            range_spec: ComprehensionRange = comprehension_range_parts(normalized_iterable)
            range_mode: bool = range_spec.recognized
            extra_variable: sview = comprehension_extra_binder(state, pos)
            enumerate_mode: mutable bool = false
            enumerate_source: mutable Ast::Expr = Expr.Absent
            enumerate_start: mutable Ast::Expr = Expr.Absent
            items_mode: mutable bool = false
            items_source: mutable Ast::Expr = Expr.Absent
            extra_binder_count: usize = comprehension_extra_binder_count(state, pos)
            collection: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            iteration_collection: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            map_collection: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            range_low: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            range_high: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            range_step: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            dynamic_range_step: mutable bool = false
            extra_type: mutable Type = unknown_ir_type()
            if extra_binder_count > 1:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "dictionary comprehensions support at most key and value binders")
                return LoweredValue{valid: false, value: 0, type: result_type}
            match iterable:
                Expr.Call(Expr.Ident(name, name_pos), arguments, argument_names, call_pos):
                    valid_enumerate_names: mutable bool = arguments.count >= 1 and arguments.count <= 2 and (argument_names.count == 0 or argument_names.count == arguments.count)
                    if valid_enumerate_names and argument_names.count != 0:
                        for argument_name in argument_names |valid_enumerate_names|:
                            valid_enumerate_names <- false if argument_name != "" and argument_name != "start"
                        valid_enumerate_names <- false if argument_names.count == 2 and argument_names[0] != ""
                    if name == "enumerate" and valid_enumerate_names and lowered_function_index(state, name) == state.function_names.count:
                        enumerate_mode <- true
                        enumerate_source <- arguments[0]
                        enumerate_start <- arguments[1] if arguments.count == 2
                Expr.Call(Expr.Field(object, field, field_pos), arguments, argument_names, call_pos):
                    if field == "items" and arguments.count == 0 and argument_names.count == 0:
                        items_mode <- true
                        items_source <- object
                _:
                    pass
            map_mode: bool = extra_variable != "" and not enumerate_mode
            if enumerate_mode and extra_variable == "":
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "enumerate dictionary comprehensions require index and value binders")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if items_mode and extra_variable == "":
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "items comprehensions require key and value binders")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if range_mode and map_mode:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "dictionary comprehensions cannot combine range iteration with multiple binders")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if range_mode:
                range_low <- lower_expression(range_spec.low, state)
                if not range_low.valid:
                    return LoweredValue{valid: false, value: 0, type: result_type}
                range_high <- lower_expression_expected(range_spec.high, range_low.type, state)
                if not range_high.valid or range_low.type.kind != TypeKind.Int or not same_type(range_low.type, range_high.type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range dict comprehension bounds must have the same integer type")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                range_step <- emit_constant(state, range_low.type, 1, "", "", false, ir_span(pos))
                if range_spec.step is not Expr.Absent:
                    positive_literal: mutable bool = false
                    step_literal: mutable bool = false
                    match range_spec.step:
                        Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                            step_literal <- true
                            positive_literal <- value > 0
                        _:
                            pass
                    if step_literal and not positive_literal:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range dict comprehension stride must be a positive integer constant or a typed integer expression")
                        return LoweredValue{valid: false, value: 0, type: result_type}
                    if positive_literal:
                        range_step <- lower_expression_expected(range_spec.step, range_low.type, state)
                    else:
                        dynamic_range_step <- true
                        range_step <- lower_expression_expected(range_spec.step, range_low.type, state)
                    if not range_step.valid or not same_type(range_step.type, range_low.type):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range dict comprehension stride must match the bound type")
                        return LoweredValue{valid: false, value: 0, type: result_type}
                    state.required_errors.push("RangeStepZero") if dynamic_range_step and not has_text(state.required_errors, "RangeStepZero")
            elif map_mode:
                collection_expression: mutable Ast::Expr = iterable
                collection_expression <- items_source if items_mode
                collection <- lower_expression(collection_expression, state)
                if not collection.valid:
                    return LoweredValue{valid: false, value: 0, type: result_type}
                if collection.type.kind != TypeKind.Map:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "multiple dict comprehension binders require a dictionary iterable")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                map_collection <- collection
                extra_type <- map_value_type(collection.type)
                keys_result: u32 = fresh_value(state)
                keys_operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(collection.value)
                key_type: Type = map_key_type(collection.type)
                keys_type: Type = array_ir_type(key_type)
                state.instructions.push(Instruction{opcode: Opcode.MapKeys, result: keys_result, result_type: keys_type, operand_start: keys_operand_start, operand_count: 1, span: ir_span(pos)})
                iteration_collection <- LoweredValue{valid: true, value: keys_result, type: keys_type}
            elif enumerate_mode:
                collection <- lower_expression(enumerate_source, state)
                if not collection.valid:
                    return LoweredValue{valid: false, value: 0, type: result_type}
                if collection.type.kind not in {TypeKind.Array, TypeKind.Text}:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "enumerate dictionary comprehensions require an array or text source")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                iteration_collection <- collection
                extra_type <- type_from_name("char") if collection.type.kind == TypeKind.Text else array_element_type(collection.type)
            else:
                collection <- lower_expression(iterable, state)
                if not collection.valid:
                    return LoweredValue{valid: false, value: 0, type: result_type}
                if collection.type.kind != TypeKind.Array and collection.type.kind != TypeKind.Text:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "dict comprehensions require an array, text, or integer range iterable")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                iteration_collection <- collection
            element_type: Type = range_low.type if range_mode else (map_key_type(collection.type) if map_mode else (type_from_name("char") if collection.type.kind == TypeKind.Text else array_element_type(collection.type)))
            index_type: Type = range_low.type if range_mode else type_from_name("usize")
            variable_type: Type = index_type if enumerate_mode else element_type
            pair: ComprehensionPairProbe = probe_comprehension_pair(body, variable, variable_type, extra_variable, extra_type, pos, state)
            if not pair.valid:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "dict comprehension projections must be straight-line typed expressions")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if pair.key_type.kind in {TypeKind.Array, TypeKind.Map, TypeKind.Function, TypeKind.Block, TypeKind.Void} or not dictionary_value_type_supported(pair.value_type):
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "dict comprehension keys must be scalar or nominal values, and values must use a supported inline aggregate shape")
                return LoweredValue{valid: false, value: 0, type: result_type}
            result_type <- map_ir_type(pair.key_type, pair.value_type)
            result_type.name <- "__elisascript_set" if comprehension_kind(state, pos) == "set"
            initial_result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.MakeMap, result: initial_result, result_type: result_type, operand_start: state.operand_pool.count.u32(), operand_count: 0, span: ir_span(pos)})

            accumulator_name: sview = "__es_comprehension_accumulator"
            state.names.push(accumulator_name)
            state.values.push(initial_result)
            state.types.push(result_type)
            state.mutables.push(true)
            accumulator_index: usize = state.names.count - 1
            context_start: u32 = state.loop_carried_indices.count.u32()
            state.loop_carried_indices.push(accumulator_index.u32())
            state.loop_context_starts.push(context_start)
            state.loop_context_counts.push(1)
            state.loop_handler_depths.push(state.active_handlers.count.u32())
            context: usize = state.loop_context_counts.count - 1
            header_block: u32 = fresh_block(state)
            body_block: u32 = fresh_block(state)
            condition_absent: mutable bool = false
            match condition:
                Expr.Absent:
                    condition_absent <- true
                _:
                    pass
            append_block: u32 = body_block if condition_absent else fresh_block(state)
            latch_block: u32 = fresh_block(state)
            exit_block: u32 = fresh_block(state)
            enumerate_offset: mutable LoweredValue = LoweredValue{valid: true, value: 0, type: index_type}
            if enumerate_mode and enumerate_start is not Expr.Absent:
                enumerate_offset <- lower_enumerate_start(enumerate_start, pos, state)
            initial_index: LoweredValue = range_low if range_mode else emit_constant(state, index_type, 0, "", "", false, ir_span(pos))
            entry_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.edge_arg_pool.push(initial_index.value)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: entry_args.start, edge0_arg_count: entry_args.count + 1, span: ir_span(pos)}
            finish_block(state)

            header_accumulator: u32 = fresh_value(state)
            latch_accumulator: u32 = fresh_value(state)
            exit_accumulator: u32 = fresh_value(state)
            header_index: u32 = fresh_value(state)
            state.pending_parameter_blocks.push(header_block)
            state.pending_parameters.push(Parameter{value: header_accumulator, type: result_type, name: accumulator_name})
            state.pending_parameter_blocks.push(latch_block)
            state.pending_parameters.push(Parameter{value: latch_accumulator, type: result_type, name: accumulator_name})
            state.pending_parameter_blocks.push(exit_block)
            state.pending_parameters.push(Parameter{value: exit_accumulator, type: result_type, name: accumulator_name})
            state.pending_parameter_blocks.push(header_block)
            state.pending_parameters.push(Parameter{value: header_index, type: index_type, name: "comprehension-index"})
            state.values[accumulator_index] <- header_accumulator

            # Map comprehensions may iterate a dictionary through its key snapshot;
            # array/text/range paths use the same header shape with their own source.
            state.current_block <- header_block
            state.terminated <- false
            condition_result: u32 = fresh_value(state)
            if range_mode:
                condition_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(header_index)
                state.operand_pool.push(range_high.value)
                if dynamic_range_step:
                    state.operand_pool.push(range_step.value)
                    direction: i64 = 2 if range_spec.operator == TokenKind.RangeGt else (1 if range_spec.operator == TokenKind.RangeLe else 0)
                    state.instructions.push(Instruction{opcode: Opcode.RangeCondition, result: condition_result, result_type: type_from_name("bool"), operand_start: condition_start, operand_count: 3, integer: direction, span: ir_span(pos)})
                else:
                    comparison: Opcode = Opcode.Greater if range_spec.operator == TokenKind.RangeGt else (Opcode.LessEqual if range_spec.operator == TokenKind.RangeLe else Opcode.Less)
                    state.instructions.push(Instruction{opcode: comparison, result: condition_result, result_type: type_from_name("bool"), operand_start: condition_start, operand_count: 2, span: ir_span(pos)})
            else:
                length_result: u32 = fresh_value(state)
                length_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(iteration_collection.value)
                state.instructions.push(Instruction{opcode: Opcode.Length, result: length_result, result_type: index_type, operand_start: length_start, operand_count: 1, span: ir_span(pos)})
                condition_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(header_index)
                state.operand_pool.push(length_result)
                state.instructions.push(Instruction{opcode: Opcode.Less, result: condition_result, result_type: type_from_name("bool"), operand_start: condition_start, operand_count: 2, span: ir_span(pos)})
            exit_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition_result, operand_count: 1, target0: body_block, target1: exit_block, target_count: 2, edge1_arg_start: exit_args.start, edge1_arg_count: exit_args.count, span: ir_span(pos)}
            finish_block(state)

            outer_scope: usize = state.names.count
            state.structured_depth <- state.structured_depth + 1
            state.break_targets.push(exit_block)
            state.continue_targets.push(latch_block)
            state.current_block <- body_block
            state.terminated <- false
            element_result: u32 = header_index if range_mode else fresh_value(state)
            if not range_mode:
                element_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(iteration_collection.value)
                state.operand_pool.push(header_index)
                state.instructions.push(Instruction{opcode: Opcode.Index, result: element_result, result_type: element_type, operand_start: element_start, operand_count: 2, span: ir_span(pos)})
            if enumerate_mode:
                enumerate_index_value: mutable u32 = header_index
                if enumerate_start is not Expr.Absent:
                    enumerate_index: LoweredValue = emit_binary(state, Opcode.Add, header_index, enumerate_offset.value, index_type, pos)
                    enumerate_index_value <- enumerate_index.value
                state.names.push(variable)
                state.values.push(enumerate_index_value)
                state.types.push(index_type)
                state.mutables.push(false)
                state.names.push(extra_variable)
                state.values.push(element_result)
                state.types.push(element_type)
                state.mutables.push(false)
            else:
                state.names.push(variable)
                state.values.push(element_result)
                state.types.push(element_type)
                state.mutables.push(false)
                if map_mode:
                    value_result: u32 = fresh_value(state)
                    value_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(map_collection.value)
                    state.operand_pool.push(element_result)
                    state.instructions.push(Instruction{opcode: Opcode.Index, result: value_result, result_type: extra_type, operand_start: value_start, operand_count: 2, span: ir_span(pos)})
                    state.names.push(extra_variable)
                    state.values.push(value_result)
                    state.types.push(extra_type)
                    state.mutables.push(false)
            filter_value: mutable LoweredValue = LoweredValue{valid: true, value: 0, type: type_from_name("bool")}
            if not condition_absent:
                filter_value <- lower_expression(condition, state)
                if filter_value.valid and filter_value.type.kind != TypeKind.Bool:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "comprehension filter must have boolean type")
                    filter_value <- LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
                if filter_value.valid:
                    skip_args: (start: u32, count: u16) = append_context_arguments(state, context)
                    state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: filter_value.value, operand_count: 1, target0: append_block, target1: latch_block, target_count: 2, edge1_arg_start: skip_args.start, edge1_arg_count: skip_args.count, span: ir_span(pos)}
                else:
                    skip_args: (start: u32, count: u16) = append_context_arguments(state, context)
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: latch_block, target_count: 1, edge0_arg_start: skip_args.start, edge0_arg_count: skip_args.count, span: ir_span(pos)}
                finish_block(state)

            state.current_block <- append_block
            state.terminated <- false
            pair_value_valid: mutable bool = false
            match body:
                Expr.Tuple(elements, tuple_pos):
                    key: LoweredValue = lower_expression(elements[0], state)
                    value: LoweredValue = lower_expression(elements[1], state)
                    pair_value_valid <- key.valid and value.valid and same_type(key.type, pair.key_type) and same_type(value.type, pair.value_type)
                    if pair_value_valid and key.type.kind in {TypeKind.Array, TypeKind.Map, TypeKind.Function, TypeKind.Block, TypeKind.Void}:
                        pair_value_valid <- false
                    if pair_value_valid and not dictionary_value_type_supported(value.type):
                        pair_value_valid <- false
                    if not pair_value_valid:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "dict comprehension projection types changed during lowering")
                    if pair_value_valid:
                        updated: u32 = fresh_value(state)
                        update_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(state.values[accumulator_index])
                        state.operand_pool.push(key.value)
                        state.operand_pool.push(value.value)
                        state.instructions.push(Instruction{opcode: Opcode.SetIndex, result: updated, result_type: result_type, operand_start: update_start, operand_count: 3, span: ir_span(pos)})
                        state.values[accumulator_index] <- updated
                _:
                    pass
            append_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: latch_block, target_count: 1, edge0_arg_start: append_args.start, edge0_arg_count: append_args.count, span: ir_span(pos)} if not state.terminated
            finish_block(state)
            _ = state.break_targets.pop()
            _ = state.continue_targets.pop()
            state.names.truncate(outer_scope)
            state.values.truncate(outer_scope)
            state.types.truncate(outer_scope)
            state.mutables.truncate(outer_scope)

            state.current_block <- latch_block
            state.terminated <- false
            state.values[accumulator_index] <- latch_accumulator
            one: LoweredValue = range_step if range_mode else emit_constant(state, index_type, 1, "", "", false, ir_span(pos))
            next_index: u32 = fresh_value(state)
            increment_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(header_index)
            state.operand_pool.push(one.value)
            step_opcode: Opcode = Opcode.Subtract if range_mode and range_spec.operator == TokenKind.RangeGt else Opcode.Add
            state.instructions.push(Instruction{opcode: step_opcode, result: next_index, result_type: index_type, operand_start: increment_start, operand_count: 2, span: ir_span(pos)})
            backedge_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.edge_arg_pool.push(next_index)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: backedge_args.start, edge0_arg_count: backedge_args.count + 1, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- exit_block
            state.terminated <- false
            state.values[accumulator_index] <- exit_accumulator
            result: LoweredValue = LoweredValue{valid: filter_value.valid and pair_value_valid, value: exit_accumulator, type: result_type}
            _ = state.loop_context_starts.pop()
            _ = state.loop_context_counts.pop()
            _ = state.loop_handler_depths.pop()
            state.loop_carried_indices.truncate(context_start.usize())
            state.structured_depth <- state.structured_depth - 1
            state.names.truncate(accumulator_index)
            state.values.truncate(accumulator_index)
            state.types.truncate(accumulator_index)
            state.mutables.truncate(accumulator_index)
            return result


        # Quantifier comprehensions (`any`/`exists` and `all`/`forall`) reduce an
        # array, text, integer-range, or two-binder dictionary iterable to one typed boolean. The
        # predicate is evaluated once per element; a matching existential or
        # failing universal branches directly to the exit state, while the
        # opposite result advances through the latch. Non-boolean truthiness is
        # intentionally rejected.
        def lower_query_comprehension(variable: sview, iterable: Ast::Expr, condition: Ast::Expr, body: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&, selector_override: sview) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = type_from_name("bool")
            selector: sview = selector_override if selector_override != "" else comprehension_query_kind(state, pos)
            existential: bool = selector == "any" or selector == "exists"
            universal: bool = selector == "all" or selector == "forall"
            if not existential and not universal:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "only any/all quantifiers are in the initial IR lowering subset")
                return LoweredValue{valid: false, value: 0, type: result_type}
            body_absent: mutable bool = false
            match body:
                Expr.Absent:
                    body_absent <- true
                _:
                    pass
            if variable == "" or not body_absent:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "quantifiers require a bound predicate rather than a projection")
                return LoweredValue{valid: false, value: 0, type: result_type}
            normalized_iterable: mutable Ast::Expr = iterable
            match iterable:
                Expr.Call(Expr.Ident(name, name_pos), arguments, argument_names, call_pos):
                    valid_names: mutable bool = arguments.count > 0 and arguments.count <= 3 and (argument_names.count == 0 or argument_names.count == arguments.count)
                    if valid_names and argument_names.count != 0:
                        for argument_name in argument_names |valid_names|:
                            valid_names <- false if argument_name != ""
                    if name == "range" and valid_names and lowered_function_index(state, name) == state.function_names.count:
                        if arguments.count == 1:
                            normalized_iterable <- Expr.Binary(Expr.IntLit(0), TokenKind.RangeLt, arguments[0], call_pos)
                        elif arguments.count == 2:
                            normalized_iterable <- Expr.Binary(arguments[0], TokenKind.RangeLt, arguments[1], call_pos)
                        else:
                            range_operator: mutable TokenKind = TokenKind.RangeLt
                            range_step: mutable Ast::Expr = arguments[2]
                            match arguments[2]:
                                Expr.Unary(step_operator, magnitude, step_pos):
                                    if step_operator == TokenKind.Minus:
                                        match magnitude:
                                            Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                                                if value > 0:
                                                    range_operator <- TokenKind.RangeGt
                                                    range_step <- magnitude
                                            _:
                                                pass
                                _:
                                    pass
                            bounded_range: Ast::Expr = Expr.Binary(arguments[0], range_operator, arguments[1], call_pos)
                            normalized_iterable <- Expr.Binary(bounded_range, TokenKind.Range, range_step, call_pos)
                _:
                    pass
            range_spec: ComprehensionRange = comprehension_range_parts(normalized_iterable)
            range_mode: bool = range_spec.recognized
            extra_variable: sview = comprehension_extra_binder(state, pos)
            map_mode: bool = extra_variable != ""
            extra_binder_count: usize = comprehension_extra_binder_count(state, pos)
            collection: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            iteration_collection: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            map_collection: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            range_low: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            range_high: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            range_step: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            dynamic_range_step: mutable bool = false
            extra_type: mutable Type = unknown_ir_type()
            if extra_binder_count > 1:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "quantifiers support at most key and value binders")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if range_mode and map_mode:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "quantifiers cannot combine range iteration with multiple binders")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if range_mode:
                range_low <- lower_expression(range_spec.low, state)
                if not range_low.valid:
                    return LoweredValue{valid: false, value: 0, type: result_type}
                range_high <- lower_expression_expected(range_spec.high, range_low.type, state)
                if not range_high.valid or range_low.type.kind != TypeKind.Int or not same_type(range_low.type, range_high.type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range quantifier bounds must have the same integer type")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                range_step <- emit_constant(state, range_low.type, 1, "", "", false, ir_span(pos))
                if range_spec.step is not Expr.Absent:
                    positive_literal: mutable bool = false
                    step_literal: mutable bool = false
                    match range_spec.step:
                        Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                            step_literal <- true
                            positive_literal <- value > 0
                        _:
                            pass
                    if step_literal and not positive_literal:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range quantifier stride must be a positive integer constant or a typed integer expression")
                        return LoweredValue{valid: false, value: 0, type: result_type}
                    if positive_literal:
                        range_step <- lower_expression_expected(range_spec.step, range_low.type, state)
                    else:
                        dynamic_range_step <- true
                        range_step <- lower_expression_expected(range_spec.step, range_low.type, state)
                    if not range_step.valid or not same_type(range_step.type, range_low.type):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range quantifier stride must match the bound type")
                        return LoweredValue{valid: false, value: 0, type: result_type}
                    state.required_errors.push("RangeStepZero") if dynamic_range_step and not has_text(state.required_errors, "RangeStepZero")
            elif map_mode:
                collection <- lower_expression(iterable, state)
                if not collection.valid:
                    return LoweredValue{valid: false, value: 0, type: result_type}
                if collection.type.kind != TypeKind.Map:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "multiple quantifier binders require a dictionary iterable")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                map_collection <- collection
                extra_type <- map_value_type(collection.type)
                key_type: Type = map_key_type(collection.type)
                keys_type: Type = array_ir_type(key_type)
                keys_result: u32 = fresh_value(state)
                keys_operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(collection.value)
                state.instructions.push(Instruction{opcode: Opcode.MapKeys, result: keys_result, result_type: keys_type, operand_start: keys_operand_start, operand_count: 1, span: ir_span(pos)})
                iteration_collection <- LoweredValue{valid: true, value: keys_result, type: keys_type}
            else:
                collection <- lower_expression(iterable, state)
                if not collection.valid:
                    return LoweredValue{valid: false, value: 0, type: result_type}
                if collection.type.kind != TypeKind.Array and collection.type.kind != TypeKind.Text:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "quantifiers require an array, text, or integer range iterable")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                iteration_collection <- collection
            element_type: Type = range_low.type if range_mode else (map_key_type(collection.type) if map_mode else (type_from_name("char") if collection.type.kind == TypeKind.Text else array_element_type(collection.type)))
            condition_absent: mutable bool = false
            match condition:
                Expr.Absent:
                    condition_absent <- true
                _:
                    pass
            if condition_absent and element_type.kind != TypeKind.Bool:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "quantifier predicates must have boolean type")
                return LoweredValue{valid: false, value: 0, type: result_type}

            accumulator_name: sview = "__es_comprehension_accumulator"
            initial_accumulator: LoweredValue = emit_constant(state, result_type, 0, "", "", not existential, ir_span(pos))
            state.names.push(accumulator_name)
            state.values.push(initial_accumulator.value)
            state.types.push(result_type)
            state.mutables.push(true)
            accumulator_index: usize = state.names.count - 1
            context_start: u32 = state.loop_carried_indices.count.u32()
            state.loop_carried_indices.push(accumulator_index.u32())
            state.loop_context_starts.push(context_start)
            state.loop_context_counts.push(1)
            state.loop_handler_depths.push(state.active_handlers.count.u32())
            context: usize = state.loop_context_counts.count - 1
            header_block: u32 = fresh_block(state)
            body_block: u32 = fresh_block(state)
            latch_block: u32 = fresh_block(state)
            exit_block: u32 = fresh_block(state)
            index_type: Type = range_low.type if range_mode else type_from_name("usize")
            initial_index: LoweredValue = range_low if range_mode else emit_constant(state, index_type, 0, "", "", false, ir_span(pos))
            entry_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.edge_arg_pool.push(initial_index.value)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: entry_args.start, edge0_arg_count: entry_args.count + 1, span: ir_span(pos)}
            finish_block(state)

            header_accumulator: u32 = fresh_value(state)
            latch_accumulator: u32 = fresh_value(state)
            exit_accumulator: u32 = fresh_value(state)
            header_index: u32 = fresh_value(state)
            state.pending_parameter_blocks.push(header_block)
            state.pending_parameters.push(Parameter{value: header_accumulator, type: result_type, name: accumulator_name})
            state.pending_parameter_blocks.push(latch_block)
            state.pending_parameters.push(Parameter{value: latch_accumulator, type: result_type, name: accumulator_name})
            state.pending_parameter_blocks.push(exit_block)
            state.pending_parameters.push(Parameter{value: exit_accumulator, type: result_type, name: accumulator_name})
            state.pending_parameter_blocks.push(header_block)
            state.pending_parameters.push(Parameter{value: header_index, type: index_type, name: "comprehension-index"})
            state.values[accumulator_index] <- header_accumulator

            state.current_block <- header_block
            state.terminated <- false
            condition_result: u32 = fresh_value(state)
            if range_mode:
                condition_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(header_index)
                state.operand_pool.push(range_high.value)
                comparison: Opcode = Opcode.Greater if range_spec.operator == TokenKind.RangeGt else (Opcode.LessEqual if range_spec.operator == TokenKind.RangeLe else Opcode.Less)
                state.instructions.push(Instruction{opcode: comparison, result: condition_result, result_type: result_type, operand_start: condition_start, operand_count: 2, span: ir_span(pos)})
            else:
                length_result: u32 = fresh_value(state)
                length_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(iteration_collection.value)
                state.instructions.push(Instruction{opcode: Opcode.Length, result: length_result, result_type: index_type, operand_start: length_start, operand_count: 1, span: ir_span(pos)})
                condition_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(header_index)
                state.operand_pool.push(length_result)
                state.instructions.push(Instruction{opcode: Opcode.Less, result: condition_result, result_type: result_type, operand_start: condition_start, operand_count: 2, span: ir_span(pos)})
            exit_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition_result, operand_count: 1, target0: body_block, target1: exit_block, target_count: 2, edge1_arg_start: exit_args.start, edge1_arg_count: exit_args.count, span: ir_span(pos)}
            finish_block(state)

            outer_scope: usize = state.names.count
            state.structured_depth <- state.structured_depth + 1
            state.break_targets.push(exit_block)
            state.continue_targets.push(latch_block)
            state.current_block <- body_block
            state.terminated <- false
            element_result: u32 = header_index if range_mode else fresh_value(state)
            if not range_mode:
                element_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(iteration_collection.value)
                state.operand_pool.push(header_index)
                state.instructions.push(Instruction{opcode: Opcode.Index, result: element_result, result_type: element_type, operand_start: element_start, operand_count: 2, span: ir_span(pos)})
            state.names.push(variable)
            state.values.push(element_result)
            state.types.push(element_type)
            state.mutables.push(false)
            if map_mode:
                value_result: u32 = fresh_value(state)
                value_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(map_collection.value)
                state.operand_pool.push(element_result)
                state.instructions.push(Instruction{opcode: Opcode.Index, result: value_result, result_type: extra_type, operand_start: value_start, operand_count: 2, span: ir_span(pos)})
                state.names.push(extra_variable)
                state.values.push(value_result)
                state.types.push(extra_type)
                state.mutables.push(false)
            predicate: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: result_type}
            if condition_absent:
                predicate <- LoweredValue{valid: true, value: element_result, type: result_type}
            else:
                predicate <- lower_expression(condition, state)
            predicate_valid: mutable bool = predicate.valid and predicate.type.kind == TypeKind.Bool and state.current_block == body_block and not state.terminated
            if predicate.valid and predicate.type.kind != TypeKind.Bool:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "quantifier predicate must have boolean type")
            if not predicate_valid:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "quantifier predicate must be a straight-line boolean expression") if predicate.valid
                invalid_args: (start: u32, count: u16) = append_context_arguments(state, context)
                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: latch_block, target_count: 1, edge0_arg_start: invalid_args.start, edge0_arg_count: invalid_args.count, span: ir_span(pos)} if not state.terminated
            else:
                early_value: LoweredValue = emit_constant(state, result_type, 0, "", "", existential, ir_span(pos))
                current_args: (start: u32, count: u16) = append_context_arguments(state, context)
                early_start: u32 = state.edge_arg_pool.count.u32()
                state.edge_arg_pool.push(early_value.value)
                state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: predicate.value, operand_count: 1, target0: (exit_block if existential else latch_block), target1: (latch_block if existential else exit_block), target_count: 2, edge0_arg_start: (early_start if existential else current_args.start), edge0_arg_count: 1, edge1_arg_start: (current_args.start if existential else early_start), edge1_arg_count: 1, span: ir_span(pos)}
            finish_block(state)
            _ = state.break_targets.pop()
            _ = state.continue_targets.pop()
            state.names.truncate(outer_scope)
            state.values.truncate(outer_scope)
            state.types.truncate(outer_scope)
            state.mutables.truncate(outer_scope)

            state.current_block <- latch_block
            state.terminated <- false
            state.values[accumulator_index] <- latch_accumulator
            one: LoweredValue = range_step if range_mode else emit_constant(state, index_type, 1, "", "", false, ir_span(pos))
            next_index: u32 = fresh_value(state)
            increment_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(header_index)
            state.operand_pool.push(one.value)
            step_opcode: Opcode = Opcode.Subtract if range_mode and range_spec.operator == TokenKind.RangeGt else Opcode.Add
            state.instructions.push(Instruction{opcode: step_opcode, result: next_index, result_type: index_type, operand_start: increment_start, operand_count: 2, span: ir_span(pos)})
            backedge_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.edge_arg_pool.push(next_index)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: backedge_args.start, edge0_arg_count: backedge_args.count + 1, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- exit_block
            state.terminated <- false
            state.values[accumulator_index] <- exit_accumulator
            result: LoweredValue = LoweredValue{valid: predicate_valid, value: exit_accumulator, type: result_type}
            _ = state.loop_context_starts.pop()
            _ = state.loop_context_counts.pop()
            _ = state.loop_handler_depths.pop()
            state.loop_carried_indices.truncate(context_start.usize())
            state.structured_depth <- state.structured_depth - 1
            state.names.truncate(accumulator_index)
            state.values.truncate(accumulator_index)
            state.types.truncate(accumulator_index)
            state.mutables.truncate(accumulator_index)
            return result


        # Integer folds (`count`, `sum`, and `product`) use one explicit
        # state-machine loop and never materialize a temporary collection. Count
        # accepts any array/text/range element type or dictionary entries and carries a usize;
        # sum/product require an integer element and carry that exact type. An
        # absent condition in a hand-built AST folds every element.
        def lower_integer_fold_comprehension(fold_kind: sview, variable: sview, iterable: Ast::Expr, condition: Ast::Expr, body: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&, initial_expression: Ast::Expr) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: mutable Type = unknown_ir_type()
            if fold_kind != "count" and fold_kind != "sum" and fold_kind != "product":
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "only count/sum/product queries are in the initial fold lowering subset")
                return LoweredValue{valid: false, value: 0, type: result_type}
            body_absent: mutable bool = false
            match body:
                Expr.Absent:
                    body_absent <- true
                _:
                    pass
            if variable == "" or not body_absent:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "count queries require a bound predicate rather than a projection")
                return LoweredValue{valid: false, value: 0, type: result_type}
            normalized_iterable: mutable Ast::Expr = iterable
            match iterable:
                Expr.Call(Expr.Ident(name, name_pos), arguments, argument_names, call_pos):
                    valid_names: mutable bool = arguments.count > 0 and arguments.count <= 3 and (argument_names.count == 0 or argument_names.count == arguments.count)
                    if valid_names and argument_names.count != 0:
                        for argument_name in argument_names |valid_names|:
                            valid_names <- false if argument_name != ""
                    if name == "range" and valid_names and lowered_function_index(state, name) == state.function_names.count:
                        if arguments.count == 1:
                            normalized_iterable <- Expr.Binary(Expr.IntLit(0), TokenKind.RangeLt, arguments[0], call_pos)
                        elif arguments.count == 2:
                            normalized_iterable <- Expr.Binary(arguments[0], TokenKind.RangeLt, arguments[1], call_pos)
                        else:
                            range_operator: mutable TokenKind = TokenKind.RangeLt
                            range_step: mutable Ast::Expr = arguments[2]
                            match arguments[2]:
                                Expr.Unary(step_operator, magnitude, step_pos):
                                    if step_operator == TokenKind.Minus:
                                        match magnitude:
                                            Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                                                if value > 0:
                                                    range_operator <- TokenKind.RangeGt
                                                    range_step <- magnitude
                                            _:
                                                pass
                                _:
                                    pass
                            bounded_range: Ast::Expr = Expr.Binary(arguments[0], range_operator, arguments[1], call_pos)
                            normalized_iterable <- Expr.Binary(bounded_range, TokenKind.Range, range_step, call_pos)
                _:
                    pass
            range_spec: ComprehensionRange = comprehension_range_parts(normalized_iterable)
            range_mode: bool = range_spec.recognized
            extra_variable: sview = comprehension_extra_binder(state, pos)
            map_mode: bool = extra_variable != ""
            extra_binder_count: usize = comprehension_extra_binder_count(state, pos)
            collection: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            iteration_collection: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            map_collection: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            range_low: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            range_high: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            range_step: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            dynamic_range_step: mutable bool = false
            extra_type: mutable Type = unknown_ir_type()
            if extra_binder_count > 1:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "integer folds support at most key and value binders")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if range_mode and map_mode:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "integer folds cannot combine range iteration with multiple binders")
                return LoweredValue{valid: false, value: 0, type: result_type}
            if range_mode:
                range_low <- lower_expression(range_spec.low, state)
                if not range_low.valid:
                    return LoweredValue{valid: false, value: 0, type: result_type}
                range_high <- lower_expression_expected(range_spec.high, range_low.type, state)
                if not range_high.valid or range_low.type.kind != TypeKind.Int or not same_type(range_low.type, range_high.type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range fold bounds must have the same integer type")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                range_step <- emit_constant(state, range_low.type, 1, "", "", false, ir_span(pos))
                if range_spec.step is not Expr.Absent:
                    positive_literal: mutable bool = false
                    step_literal: mutable bool = false
                    match range_spec.step:
                        Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                            step_literal <- true
                            positive_literal <- value > 0
                        _:
                            pass
                    if step_literal and not positive_literal:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range fold stride must be a positive integer constant or a typed integer expression")
                        return LoweredValue{valid: false, value: 0, type: result_type}
                    if positive_literal:
                        range_step <- lower_expression_expected(range_spec.step, range_low.type, state)
                    else:
                        dynamic_range_step <- true
                        range_step <- lower_expression_expected(range_spec.step, range_low.type, state)
                    if not range_step.valid or not same_type(range_step.type, range_low.type):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range fold stride must match the bound type")
                        return LoweredValue{valid: false, value: 0, type: result_type}
                    state.required_errors.push("RangeStepZero") if dynamic_range_step and not has_text(state.required_errors, "RangeStepZero")
            elif map_mode:
                collection <- lower_expression(iterable, state)
                if not collection.valid:
                    return LoweredValue{valid: false, value: 0, type: result_type}
                if collection.type.kind != TypeKind.Map:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "multiple integer fold binders require a dictionary iterable")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                map_collection <- collection
                extra_type <- map_value_type(collection.type)
                key_type: Type = map_key_type(collection.type)
                keys_type: Type = array_ir_type(key_type)
                keys_result: u32 = fresh_value(state)
                keys_operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(collection.value)
                state.instructions.push(Instruction{opcode: Opcode.MapKeys, result: keys_result, result_type: keys_type, operand_start: keys_operand_start, operand_count: 1, span: ir_span(pos)})
                iteration_collection <- LoweredValue{valid: true, value: keys_result, type: keys_type}
            else:
                collection <- lower_expression(iterable, state)
                if not collection.valid:
                    return LoweredValue{valid: false, value: 0, type: result_type}
                if collection.type.kind != TypeKind.Array and collection.type.kind != TypeKind.Text:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "integer folds require an array, text, or integer range iterable")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                iteration_collection <- collection
            element_type: Type = range_low.type if range_mode else (map_key_type(collection.type) if map_mode else (type_from_name("char") if collection.type.kind == TypeKind.Text else array_element_type(collection.type)))
            fold_element_type: Type = extra_type if map_mode else element_type
            if fold_kind == "count":
                result_type <- type_from_name("usize")
            else:
                if fold_element_type.kind != TypeKind.Int:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "sum and product require an integer iterable")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                result_type <- fold_element_type
            initial_accumulator: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: result_type}
            match initial_expression:
                Expr.Absent:
                    initial_accumulator <- emit_constant(state, result_type, 1 if fold_kind == "product" else 0, "", "", false, ir_span(pos))
                _:
                    initial_accumulator <- lower_expression_expected(initial_expression, result_type, state)
                    if not initial_accumulator.valid or not same_type(initial_accumulator.type, result_type):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "fold start value must match the exact integer element type")
                        return LoweredValue{valid: false, value: 0, type: result_type}
            condition_absent: mutable bool = false
            match condition:
                Expr.Absent:
                    condition_absent <- true
                _:
                    pass

            accumulator_name: sview = "__es_comprehension_accumulator"
            state.names.push(accumulator_name)
            state.values.push(initial_accumulator.value)
            state.types.push(result_type)
            state.mutables.push(true)
            accumulator_index: usize = state.names.count - 1
            context_start: u32 = state.loop_carried_indices.count.u32()
            state.loop_carried_indices.push(accumulator_index.u32())
            state.loop_context_starts.push(context_start)
            state.loop_context_counts.push(1)
            state.loop_handler_depths.push(state.active_handlers.count.u32())
            context: usize = state.loop_context_counts.count - 1
            header_block: u32 = fresh_block(state)
            body_block: u32 = fresh_block(state)
            hit_block: u32 = fresh_block(state)
            latch_block: u32 = fresh_block(state)
            exit_block: u32 = fresh_block(state)
            index_type: Type = range_low.type if range_mode else type_from_name("usize")
            initial_index: LoweredValue = range_low if range_mode else emit_constant(state, index_type, 0, "", "", false, ir_span(pos))
            entry_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.edge_arg_pool.push(initial_index.value)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: entry_args.start, edge0_arg_count: entry_args.count + 1, span: ir_span(pos)}
            finish_block(state)

            header_accumulator: u32 = fresh_value(state)
            latch_accumulator: u32 = fresh_value(state)
            exit_accumulator: u32 = fresh_value(state)
            header_index: u32 = fresh_value(state)
            state.pending_parameter_blocks.push(header_block)
            state.pending_parameters.push(Parameter{value: header_accumulator, type: result_type, name: accumulator_name})
            state.pending_parameter_blocks.push(latch_block)
            state.pending_parameters.push(Parameter{value: latch_accumulator, type: result_type, name: accumulator_name})
            state.pending_parameter_blocks.push(exit_block)
            state.pending_parameters.push(Parameter{value: exit_accumulator, type: result_type, name: accumulator_name})
            state.pending_parameter_blocks.push(header_block)
            state.pending_parameters.push(Parameter{value: header_index, type: index_type, name: "comprehension-index"})
            state.values[accumulator_index] <- header_accumulator

            state.current_block <- header_block
            state.terminated <- false
            condition_result: u32 = fresh_value(state)
            if range_mode:
                condition_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(header_index)
                state.operand_pool.push(range_high.value)
                if dynamic_range_step:
                    state.operand_pool.push(range_step.value)
                    direction: i64 = 2 if range_spec.operator == TokenKind.RangeGt else (1 if range_spec.operator == TokenKind.RangeLe else 0)
                    state.instructions.push(Instruction{opcode: Opcode.RangeCondition, result: condition_result, result_type: type_from_name("bool"), operand_start: condition_start, operand_count: 3, integer: direction, span: ir_span(pos)})
                else:
                    comparison: Opcode = Opcode.Greater if range_spec.operator == TokenKind.RangeGt else (Opcode.LessEqual if range_spec.operator == TokenKind.RangeLe else Opcode.Less)
                    state.instructions.push(Instruction{opcode: comparison, result: condition_result, result_type: type_from_name("bool"), operand_start: condition_start, operand_count: 2, span: ir_span(pos)})
            else:
                length_result: u32 = fresh_value(state)
                length_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(iteration_collection.value)
                state.instructions.push(Instruction{opcode: Opcode.Length, result: length_result, result_type: index_type, operand_start: length_start, operand_count: 1, span: ir_span(pos)})
                condition_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(header_index)
                state.operand_pool.push(length_result)
                state.instructions.push(Instruction{opcode: Opcode.Less, result: condition_result, result_type: type_from_name("bool"), operand_start: condition_start, operand_count: 2, span: ir_span(pos)})
            exit_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition_result, operand_count: 1, target0: body_block, target1: exit_block, target_count: 2, edge1_arg_start: exit_args.start, edge1_arg_count: exit_args.count, span: ir_span(pos)}
            finish_block(state)

            outer_scope: usize = state.names.count
            state.structured_depth <- state.structured_depth + 1
            state.break_targets.push(exit_block)
            state.continue_targets.push(latch_block)
            state.current_block <- body_block
            state.terminated <- false
            element_result: u32 = header_index if range_mode else fresh_value(state)
            if not range_mode:
                element_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(iteration_collection.value)
                state.operand_pool.push(header_index)
                state.instructions.push(Instruction{opcode: Opcode.Index, result: element_result, result_type: element_type, operand_start: element_start, operand_count: 2, span: ir_span(pos)})
            state.names.push(variable)
            state.values.push(element_result)
            state.types.push(element_type)
            state.mutables.push(false)
            fold_element_result: mutable u32 = element_result
            if map_mode:
                value_result: u32 = fresh_value(state)
                value_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(map_collection.value)
                state.operand_pool.push(element_result)
                state.instructions.push(Instruction{opcode: Opcode.Index, result: value_result, result_type: extra_type, operand_start: value_start, operand_count: 2, span: ir_span(pos)})
                state.names.push(extra_variable)
                state.values.push(value_result)
                state.types.push(extra_type)
                state.mutables.push(false)
                fold_element_result <- value_result
            predicate: mutable LoweredValue = LoweredValue{valid: true, value: 0, type: type_from_name("bool")}
            if not condition_absent:
                predicate <- lower_expression(condition, state)
                if predicate.valid and predicate.type.kind != TypeKind.Bool:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "integer fold predicate must have boolean type")
                    predicate <- LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
                if predicate.valid and state.current_block == body_block and not state.terminated:
                    hit_args: (start: u32, count: u16) = append_context_arguments(state, context)
                    state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: predicate.value, operand_count: 1, target0: hit_block, target1: latch_block, target_count: 2, edge1_arg_start: hit_args.start, edge1_arg_count: hit_args.count, span: ir_span(pos)}
                elif not state.terminated:
                    invalid_args: (start: u32, count: u16) = append_context_arguments(state, context)
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: latch_block, target_count: 1, edge0_arg_start: invalid_args.start, edge0_arg_count: invalid_args.count, span: ir_span(pos)}
            else:
                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: hit_block, target_count: 1, span: ir_span(pos)}
            finish_block(state)
            _ = state.break_targets.pop()
            _ = state.continue_targets.pop()
            state.names.truncate(outer_scope)
            state.values.truncate(outer_scope)
            state.types.truncate(outer_scope)
            state.mutables.truncate(outer_scope)

            state.current_block <- hit_block
            state.terminated <- false
            state.values[accumulator_index] <- header_accumulator
            one_count: LoweredValue = emit_constant(state, result_type, 1, "", "", false, ir_span(pos))
            fold_opcode: Opcode = Opcode.Add if fold_kind == "count" or fold_kind == "sum" else Opcode.Multiply
            fold_operand: u32 = one_count.value if fold_kind == "count" else fold_element_result
            updated_count: LoweredValue = emit_binary(state, fold_opcode, state.values[accumulator_index], fold_operand, result_type, pos)
            state.values[accumulator_index] <- updated_count.value if updated_count.valid
            hit_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: latch_block, target_count: 1, edge0_arg_start: hit_args.start, edge0_arg_count: hit_args.count, span: ir_span(pos)} if not state.terminated
            finish_block(state)

            state.current_block <- latch_block
            state.terminated <- false
            state.values[accumulator_index] <- latch_accumulator
            one_index: LoweredValue = range_step if range_mode else emit_constant(state, index_type, 1, "", "", false, ir_span(pos))
            next_index: u32 = fresh_value(state)
            increment_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(header_index)
            state.operand_pool.push(one_index.value)
            step_opcode: Opcode = Opcode.Subtract if range_mode and range_spec.operator == TokenKind.RangeGt else Opcode.Add
            state.instructions.push(Instruction{opcode: step_opcode, result: next_index, result_type: index_type, operand_start: increment_start, operand_count: 2, span: ir_span(pos)})
            backedge_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.edge_arg_pool.push(next_index)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: backedge_args.start, edge0_arg_count: backedge_args.count + 1, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- exit_block
            state.terminated <- false
            state.values[accumulator_index] <- exit_accumulator
            result: LoweredValue = LoweredValue{valid: condition_absent or predicate.valid, value: exit_accumulator, type: result_type}
            _ = state.loop_context_starts.pop()
            _ = state.loop_context_counts.pop()
            _ = state.loop_handler_depths.pop()
            state.loop_carried_indices.truncate(context_start.usize())
            state.structured_depth <- state.structured_depth - 1
            state.names.truncate(accumulator_index)
            state.values.truncate(accumulator_index)
            state.types.truncate(accumulator_index)
            state.mutables.truncate(accumulator_index)
            return result


        # The parser lowers every f-string to `__fstr(chunk, value, chunk, ...)`.
        # Text pieces pass through directly; integer values, f32/f64, and text-backed
        # nominal pieces use deterministic formatting opcodes. Other values stay
        # rejected until their textual representation is specified by the language
        # rather than guessed by a backend.
        def lower_fstring_piece(expression: Ast::Expr, result_type: Type, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            piece: LoweredValue = lower_expression(expression, state)
            return LoweredValue{valid: false, value: 0, type: result_type} if not piece.valid
            return piece if piece.type.kind == TypeKind.Text
            if piece.type.kind == TypeKind.Char:
                result: u32 = fresh_value(state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(piece.value)
                state.instructions.push(Instruction{opcode: Opcode.FormatChar, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if piece.type.kind == TypeKind.Int:
                result: u32 = fresh_value(state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(piece.value)
                state.instructions.push(Instruction{opcode: Opcode.FormatInt, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if piece.type.kind == TypeKind.Float and (piece.type.bits == 32 or piece.type.bits == 64):
                result: u32 = fresh_value(state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(piece.value)
                state.instructions.push(Instruction{opcode: Opcode.FormatFloat, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if piece.type.kind == TypeKind.Bool:
                result: u32 = fresh_value(state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(piece.value)
                state.instructions.push(Instruction{opcode: Opcode.FormatBool, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if piece.type.kind == TypeKind.Named and piece.type.name in {"Path", "Glob", "Regex", "Executable", "Url"}:
                result: u32 = fresh_value(state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(piece.value)
                state.instructions.push(Instruction{opcode: Opcode.FormatNominal, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            if piece.type.kind == TypeKind.Array or piece.type.kind == TypeKind.Map:
                result: u32 = fresh_value(state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(piece.value)
                state.instructions.push(Instruction{opcode: Opcode.FormatAggregate, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                return LoweredValue{valid: true, value: result, type: result_type}
            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "f-string interpolation requires text, char, integer, f32/f64, bool, text-backed nominal, array, or dictionary value")
            return LoweredValue{valid: false, value: 0, type: result_type}


        def lower_fstring(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = type_from_name("sview")
            valid_shape: bool = arguments.count > 0 and (argument_names.count == 0 or all name in argument_names where name == "")
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "f-string pieces must be positional values")
                return LoweredValue{valid: false, value: 0, type: result_type}
            result: mutable LoweredValue = lower_fstring_piece(arguments[0], result_type, pos, state)
            return result if not result.valid
            for argument_index in 1..<arguments.count |arguments, argument_names, argument_index, state, result, result_type, pos|:
                piece: LoweredValue = lower_fstring_piece(arguments[argument_index], result_type, pos, state)
                if not piece.valid:
                    result <- LoweredValue{valid: false, value: 0, type: result_type}
                else:
                    result <- emit_binary(state, Opcode.Concat, result.value, piece.value, result_type, pos)
            return result


        def lower_range_membership(needle: LoweredValue, range_expression: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&) -> RangeMembership can[Memory.Allocate, Abort.Panic]:
            low_expression: mutable Ast::Expr = Expr.Absent
            high_expression: mutable Ast::Expr = Expr.Absent
            step_expression: mutable Ast::Expr = Expr.Absent
            operator: mutable TokenKind = TokenKind.Range
            recognized: mutable bool = false
            stepped: mutable bool = false
            dynamic_stride: mutable bool = false
            match range_expression:
                Expr.Binary(low, range_operator, high, range_pos):
                    if range_operator in {TokenKind.RangeLt, TokenKind.RangeLe, TokenKind.RangeGt}:
                        low_expression <- low
                        high_expression <- high
                        operator <- range_operator
                        recognized <- true
                    elif range_operator == TokenKind.Range:
                        match low:
                            Expr.Binary(inner_low, inner_operator, inner_high, inner_pos):
                                if inner_operator in {TokenKind.RangeLt, TokenKind.RangeLe, TokenKind.RangeGt}:
                                    low_expression <- inner_low
                                    high_expression <- inner_high
                                    step_expression <- high
                                    operator <- inner_operator
                                    recognized <- true
                                    stepped <- true
                            _:
                                pass
                _:
                    pass
            return RangeMembership{recognized: false, value: LoweredValue{valid: false, value: 0, type: type_from_name("bool")}} if not recognized
            low: LoweredValue = lower_expression_expected(low_expression, needle.type, state)
            high: LoweredValue = lower_expression_expected(high_expression, needle.type, state)
            if not low.valid or not high.valid or not same_type(needle.type, low.type) or not same_type(needle.type, high.type) or not numeric_type(needle.type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range membership requires matching numeric needle and bound types")
                return RangeMembership{recognized: true, value: LoweredValue{valid: false, value: 0, type: type_from_name("bool")}}
            step: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: needle.type}
            if stepped:
                positive_literal: mutable bool = false
                step_literal: mutable bool = false
                match step_expression:
                    Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                        step_literal <- true
                        positive_literal <- value > 0
                    _:
                        pass
                if needle.type.kind != TypeKind.Int:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range membership stride requires an integer needle and bounds")
                    return RangeMembership{recognized: true, value: LoweredValue{valid: false, value: 0, type: type_from_name("bool")}}
                if step_literal and not positive_literal:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range membership stride must be a positive integer constant or a typed integer expression")
                    return RangeMembership{recognized: true, value: LoweredValue{valid: false, value: 0, type: type_from_name("bool")}}
                dynamic_stride <- not positive_literal
                step <- lower_expression_expected(step_expression, needle.type, state)
                if not step.valid or not same_type(step.type, needle.type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range membership stride must match the needle type")
                    return RangeMembership{recognized: true, value: LoweredValue{valid: false, value: 0, type: type_from_name("bool")}}
                state.required_errors.push("RangeStepZero") if dynamic_stride and not has_text(state.required_errors, "RangeStepZero")

            upper_test_block: u32 = fresh_block(state)
            false_block: u32 = fresh_block(state)
            true_block: u32 = fresh_block(state)
            merge_block: u32 = fresh_block(state)
            success_block: mutable u32 = true_block
            alignment_block: mutable u32 = 0
            if stepped:
                alignment_block <- fresh_block(state)
                success_block <- alignment_block
            first: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
            if dynamic_stride:
                first_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(low.value) if operator != TokenKind.RangeGt else state.operand_pool.push(needle.value)
                state.operand_pool.push(needle.value) if operator != TokenKind.RangeGt else state.operand_pool.push(low.value)
                state.operand_pool.push(step.value)
                first_result: u32 = fresh_value(state)
                first_mode: i64 = 1
                state.instructions.push(Instruction{opcode: Opcode.RangeCondition, result: first_result, result_type: type_from_name("bool"), operand_start: first_start, operand_count: 3, integer: first_mode, span: ir_span(pos)})
                first <- LoweredValue{valid: true, value: first_result, type: type_from_name("bool")}
            else:
                first_opcode: Opcode = Opcode.LessEqual if operator == TokenKind.RangeGt else Opcode.GreaterEqual
                first <- emit_comparison(state, first_opcode, needle.value, low.value, pos)
            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: first.value, operand_count: 1, target0: upper_test_block, target1: false_block, target_count: 2, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- upper_test_block
            state.terminated <- false
            second: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
            if dynamic_stride:
                second_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(needle.value)
                state.operand_pool.push(high.value)
                state.operand_pool.push(step.value)
                second_result: u32 = fresh_value(state)
                second_mode: i64 = 2 if operator == TokenKind.RangeGt else (1 if operator == TokenKind.RangeLe else 0)
                state.instructions.push(Instruction{opcode: Opcode.RangeCondition, result: second_result, result_type: type_from_name("bool"), operand_start: second_start, operand_count: 3, integer: second_mode, span: ir_span(pos)})
                second <- LoweredValue{valid: true, value: second_result, type: type_from_name("bool")}
            else:
                second_opcode: Opcode = Opcode.Greater if operator == TokenKind.RangeGt else (Opcode.LessEqual if operator == TokenKind.RangeLe else Opcode.Less)
                second <- emit_comparison(state, second_opcode, needle.value, high.value, pos)
            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: second.value, operand_count: 1, target0: success_block, target1: false_block, target_count: 2, span: ir_span(pos)}
            finish_block(state)

            if stepped:
                state.current_block <- alignment_block
                state.terminated <- false
                offset: LoweredValue = emit_binary(state, Opcode.Subtract, low.value, needle.value, needle.type, pos) if operator == TokenKind.RangeGt else emit_binary(state, Opcode.Subtract, needle.value, low.value, needle.type, pos)
                remainder: LoweredValue = emit_binary(state, Opcode.Remainder, offset.value, step.value, needle.type, pos)
                zero: LoweredValue = emit_constant(state, needle.type, 0, "", "", false, ir_span(pos))
                aligned: LoweredValue = emit_comparison(state, Opcode.Equal, remainder.value, zero.value, pos)
                state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: aligned.value, operand_count: 1, target0: true_block, target1: false_block, target_count: 2, span: ir_span(pos)}
                finish_block(state)

            state.current_block <- true_block
            state.terminated <- false
            true_value: LoweredValue = emit_constant(state, type_from_name("bool"), 0, "", "", true, ir_span(pos))
            true_edge: u32 = state.edge_arg_pool.count.u32()
            state.edge_arg_pool.push(true_value.value)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: true_edge, edge0_arg_count: 1, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- false_block
            state.terminated <- false
            false_value: LoweredValue = emit_constant(state, type_from_name("bool"), 0, "", "", false, ir_span(pos))
            false_edge: u32 = state.edge_arg_pool.count.u32()
            state.edge_arg_pool.push(false_value.value)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: false_edge, edge0_arg_count: 1, span: ir_span(pos)}
            finish_block(state)

            result: u32 = fresh_value(state)
            result_type: Type = type_from_name("bool")
            state.pending_parameter_blocks.push(merge_block)
            state.pending_parameters.push(Parameter{value: result, type: result_type, name: "range-membership"})
            state.current_block <- merge_block
            state.terminated <- false
            return RangeMembership{recognized: true, value: LoweredValue{valid: true, value: result, type: result_type}}


        # Lower the lazy checked-index form produced by `get values[index] else fallback`.
        # The predicate is a first-class IR instruction so the fallback block is not entered
        # (and its expressions are not evaluated) on a successful access.  This keeps the
        # source-level recovery semantics explicit in the CFG instead of eagerly materializing
        # a fallback value beside the ordinary `Index` operation.
        def lower_checked_index_values(collection: LoweredValue, index: LoweredValue, fallback_expression: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not collection.valid or not index.valid
            result_type: mutable Type = unknown_ir_type()
            valid_index: mutable bool = false
            if collection.type.kind == TypeKind.Map:
                key_type: Type = map_key_type(collection.type)
                result_type <- map_value_type(collection.type)
                valid_index <- same_type(index.type, key_type)
            elif collection.type.kind == TypeKind.Array:
                result_type <- array_element_type(collection.type)
                valid_index <- index.type.kind == TypeKind.Int
            elif collection.type.kind == TypeKind.Text:
                result_type <- type_from_name("char")
                valid_index <- index.type.kind == TypeKind.Int
            else:
                pass
            if not valid_index:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "checked indexing requires an array, dictionary, or text with a matching index type")
                return LoweredValue{valid: false, value: 0, type: result_type}

            predicate: u32 = fresh_value(state)
            predicate_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            state.operand_pool.push(index.value)
            state.instructions.push(Instruction{opcode: Opcode.IndexValid, result: predicate, result_type: type_from_name("bool"), operand_start: predicate_start, operand_count: 2, span: ir_span(pos)})
            success_block: u32 = fresh_block(state)
            fallback_block: u32 = fresh_block(state)
            merge_block: u32 = fresh_block(state)
            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: predicate, operand_count: 1, target0: success_block, target1: fallback_block, target_count: 2, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- success_block
            state.terminated <- false
            indexed: u32 = fresh_value(state)
            index_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            state.operand_pool.push(index.value)
            state.instructions.push(Instruction{opcode: Opcode.Index, result: indexed, result_type: result_type, operand_start: index_start, operand_count: 2, span: ir_span(pos)})
            success_edge: u32 = state.edge_arg_pool.count.u32()
            state.edge_arg_pool.push(indexed)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: success_edge, edge0_arg_count: 1, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- fallback_block
            state.terminated <- false
            fallback: LoweredValue = lower_expression_expected(fallback_expression, result_type, state)
            fallback_edge: mutable u32 = 0
            if fallback.valid:
                fallback_edge <- state.edge_arg_pool.count.u32()
                state.edge_arg_pool.push(fallback.value)
                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: fallback_edge, edge0_arg_count: 1, span: ir_span(pos)}
            finish_block(state)

            result: u32 = fresh_value(state)
            state.pending_parameter_blocks.push(merge_block)
            state.pending_parameters.push(Parameter{value: result, type: result_type, name: "checked-index"})
            state.current_block <- merge_block
            state.terminated <- false
            return LoweredValue{valid: fallback.valid, value: result, type: result_type}


        def lower_checked_index(collection_expression: Ast::Expr, index_expression: Ast::Expr, fallback_expression: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            collection: LoweredValue = lower_expression(collection_expression, state)
            index: LoweredValue = lower_expression(index_expression, state)
            return lower_checked_index_values(collection, index, fallback_expression, pos, state)


        # Lower value recovery for an error-producing expression, e.g.
        # `try parse_int(text) else 0`.  The guard is lexical in the IR: any
        # interpreter failure raised while evaluating the guarded expression
        # transfers to the fallback block, clears the private failure state,
        # and merges the recovered value through a typed block parameter (or
        # resumes through a zero-parameter void merge for statement recovery).
        def lower_error_recovery(guarded_expression: Ast::Expr, fallback_expression: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            fallback_block: u32 = fresh_block(state)
            merge_block: u32 = fresh_block(state)
            state.instructions.push(Instruction{opcode: Opcode.ErrorGuardPush, result: 0, result_type: void_ir_type(), integer: fallback_block.i64(), span: ir_span(pos)})
            guarded: LoweredValue = lower_expression(guarded_expression, state)
            if not guarded.valid:
                return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            if guarded.type.kind == TypeKind.Void:
                # A void fallible operation is recoverable as a statement.  `else void`
                # is the explicit no-op spelling, while another void expression may be
                # used when the fallback needs to perform an observation or cleanup.  The
                # merge has no parameters because neither path produces a value.
                state.instructions.push(Instruction{opcode: Opcode.ErrorGuardPop, result: 0, result_type: void_ir_type(), span: ir_span(pos)})
                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, span: ir_span(pos)}
                finish_block(state)

                state.current_block <- fallback_block
                state.terminated <- false
                fallback_valid: mutable bool = true
                match fallback_expression:
                    Expr.Ident(fallback_name, fallback_pos):
                        # `void` is a language keyword in the recovery position, not a
                        # local binding and therefore needs no IR instruction.
                        fallback_valid <- fallback_name == "void"
                        add_issue(state, LowerIssueKind.UnknownBinding, fallback_pos.line, "void recovery fallback must be the `void` keyword") if not fallback_valid
                    _:
                        fallback: LoweredValue = lower_expression(fallback_expression, state)
                        fallback_valid <- fallback.valid
                        if fallback.valid and fallback.type.kind != TypeKind.Void:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "void recovery fallback must produce void")
                            fallback_valid <- false
                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, span: ir_span(pos)} if fallback_valid
                finish_block(state)

                state.current_block <- merge_block
                state.terminated <- false
                return LoweredValue{valid: fallback_valid, value: 0, type: void_ir_type()}
            state.instructions.push(Instruction{opcode: Opcode.ErrorGuardPop, result: 0, result_type: void_ir_type(), span: ir_span(pos)})
            success_edge: u32 = state.edge_arg_pool.count.u32()
            state.edge_arg_pool.push(guarded.value)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: success_edge, edge0_arg_count: 1, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- fallback_block
            state.terminated <- false
            fallback: LoweredValue = lower_expression_expected(fallback_expression, guarded.type, state)
            fallback_edge: mutable u32 = 0
            if fallback.valid:
                fallback_edge <- state.edge_arg_pool.count.u32()
                state.edge_arg_pool.push(fallback.value)
                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: fallback_edge, edge0_arg_count: 1, span: ir_span(pos)}
            finish_block(state)

            result: u32 = fresh_value(state)
            state.pending_parameter_blocks.push(merge_block)
            state.pending_parameters.push(Parameter{value: result, type: guarded.type, name: "error-recovery"})
            state.current_block <- merge_block
            state.terminated <- false
            return LoweredValue{valid: fallback.valid, value: result, type: guarded.type}


        # Lower the expression-position `catch EXPR:` form. Recovery remains a
        # compact guard/fallback CFG, but explicit `Error.Tag` arms carry their
        # family and tag in the guard metadata and may bind positional payloads.
        # The reference interpreter extracts those payloads through typed
        # ErrorPayload instructions, including terminating variant arms.
        def lower_catch_expression(guarded_expression: Ast::Expr, arms: darray[Ast::MatchArm]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            if arms.count != 2:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "catch expressions currently require one success arm and one error arm")
                return invalid
            success_arm: Ast::MatchArm = arms[0]
            error_arm: Ast::MatchArm = arms[1]
            match success_arm.pattern:
                Pattern.Binding(_) | Pattern.Wildcard:
                    pass
                _:
                    add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "catch success arm must use a binding or wildcard pattern")
                    return invalid
            match success_arm.guard:
                Expr.Absent:
                    pass
                _:
                    add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "catch success arms cannot have guards")
                    return invalid
            catch_all: mutable bool = false
            error_family: mutable sview = ""
            error_operation: mutable sview = ""
            error_payload_fields: mutable darray[Ast::Pattern] = []
            match error_arm.pattern:
                Pattern.Wildcard:
                    catch_all <- true
                Pattern.TypeBind(error_type_name, _):
                    catch_all <- error_type_name == "error"
                Pattern.Variant(error_reference, fields):
                    if not valid_effect_reference(error_reference):
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "catch error variants require a Family.Tag pattern")
                        return invalid
                    error_family <- effect_family(error_reference)
                    error_operation <- effect_operation(error_reference)
                    if not error_payload_variant_declared(state.source_file, error_family, error_operation):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "catch error variant is not declared")
                        return invalid
                    expected_payload_count: usize = error_payload_field_count(state.source_file, error_family, error_operation)
                    if fields.count != expected_payload_count:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "catch error variant payload arity does not match its declaration")
                        return invalid
                    for field in fields:
                        match field:
                            Pattern.Binding(_) | Pattern.Wildcard:
                                pass
                            _:
                                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "error payload patterns support only bindings or wildcards")
                                return invalid
                    error_payload_fields.extend(fields)
                _:
                    pass
            if not catch_all and (error_family == "" or error_operation == ""):
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "catch expression requires a final wildcard, error catch-all, or Family.Tag arm")
                return invalid
            match error_arm.guard:
                Expr.Absent:
                    pass
                _:
                    add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "catch error arms cannot have guards")
                    return invalid
            success_expression: mutable Ast::Expr = Expr.Invalid
            success_expression_found: mutable bool = false
            if success_arm.body.count == 1:
                match success_arm.body[0]:
                    Stmt.Expr(value, _):
                        success_expression <- value
                        success_expression_found <- true
                    _:
                        pass
            error_expression: mutable Ast::Expr = Expr.Invalid
            error_expression_found: mutable bool = false
            error_return_expression: mutable Ast::Expr = Expr.Invalid
            error_return_found: mutable bool = false
            error_return_has_value: mutable bool = false
            if error_arm.body.count == 1:
                match error_arm.body[0]:
                    Stmt.Expr(value, _):
                        error_expression <- value
                        error_expression_found <- true
                    Stmt.Return(value, _):
                        error_return_found <- true
                        if value is return_value:
                            error_return_expression <- return_value
                            error_return_has_value <- true
                    _:
                        pass
            if not success_expression_found or (not error_expression_found and not error_return_found) or (error_expression_found and error_return_found):
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "catch arm bodies must each contain one value expression, or the error arm may terminate with return")
                return invalid
            fallback_block: u32 = fresh_block(state)
            merge_block: u32 = fresh_block(state)
            state.instructions.push(Instruction{opcode: Opcode.ErrorGuardPush, result: 0, result_type: void_ir_type(), integer: fallback_block.i64(), effect_family: error_family, effect_operation: error_operation, span: ir_span(pos)})
            guarded: LoweredValue = lower_expression(guarded_expression, state)
            if not guarded.valid:
                return invalid
            if guarded.type.kind == TypeKind.Void:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "catch expression requires a value-producing guarded expression")
                return invalid
            state.instructions.push(Instruction{opcode: Opcode.ErrorGuardPop, result: 0, result_type: void_ir_type(), span: ir_span(pos)})

            scope_mark: usize = state.names.count
            match success_arm.pattern:
                Pattern.Binding(success_name):
                    state.names.push(success_name)
                    state.values.push(guarded.value)
                    state.types.push(guarded.type)
                    state.mutables.push(false)
                _:
                    pass
            success_value: LoweredValue = lower_expression_expected(success_expression, guarded.type, state)
            state.names.truncate(scope_mark)
            state.values.truncate(scope_mark)
            state.types.truncate(scope_mark)
            state.mutables.truncate(scope_mark)
            if not success_value.valid:
                return invalid
            success_edge: u32 = state.edge_arg_pool.count.u32()
            state.edge_arg_pool.push(success_value.value)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: success_edge, edge0_arg_count: 1, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- fallback_block
            state.terminated <- false
            payload_scope_mark: usize = state.names.count
            payload_bindings_valid: mutable bool = true
            for payload_index in 0..<error_payload_fields.count |state, error_payload_fields, error_family, error_operation|:
                payload_type: Type = error_payload_field_type(state, error_family, error_operation, payload_index)
                if payload_type.kind == TypeKind.Named and payload_type.name == "":
                    add_issue(state, LowerIssueKind.UnknownType, pos.line, "error payload binding has no declared type")
                    payload_bindings_valid <- false
                    continue
                match error_payload_fields[payload_index]:
                    Pattern.Binding(payload_name):
                        payload_value: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.ErrorPayload, result: payload_value, result_type: payload_type, integer: payload_index.i64(), span: ir_span(pos)})
                        state.names.push(payload_name)
                        state.values.push(payload_value)
                        state.types.push(payload_type)
                        state.mutables.push(false)
                    Pattern.Wildcard:
                        pass
                    _:
                        payload_bindings_valid <- false
            if not payload_bindings_valid:
                return invalid
            fallback_valid: mutable bool = true
            if error_return_found:
                if error_return_has_value:
                    returned: LoweredValue = lower_expression_expected(error_return_expression, state.function_return_type, state)
                    fallback_valid <- returned.valid and same_type(returned.type, state.function_return_type)
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "catch error return value does not match the function return type") if returned.valid and not same_type(returned.type, state.function_return_type)
                    if fallback_valid:
                        emit_handler_unwind(state, 0, pos)
                        state.terminator <- Terminator{kind: TerminatorKind.Return, operand: returned.value, operand_count: 1, span: ir_span(pos)}
                        state.terminated <- true
                else:
                    if state.function_return_type.kind == TypeKind.Void:
                        emit_handler_unwind(state, 0, pos)
                        state.terminator <- Terminator{kind: TerminatorKind.Return, span: ir_span(pos)}
                        state.terminated <- true
                    else:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "non-void function catch error return requires a value")
                        fallback_valid <- false
            else:
                fallback: LoweredValue = lower_expression_expected(error_expression, guarded.type, state)
                fallback_valid <- fallback.valid
                if fallback.valid:
                    fallback_edge: u32 = state.edge_arg_pool.count.u32()
                    state.edge_arg_pool.push(fallback.value)
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: fallback_edge, edge0_arg_count: 1, span: ir_span(pos)}
            state.names.truncate(payload_scope_mark)
            state.values.truncate(payload_scope_mark)
            state.types.truncate(payload_scope_mark)
            state.mutables.truncate(payload_scope_mark)
            finish_block(state)

            result: u32 = fresh_value(state)
            state.pending_parameter_blocks.push(merge_block)
            state.pending_parameters.push(Parameter{value: result, type: guarded.type, name: "catch"})
            state.current_block <- merge_block
            state.terminated <- false
            return LoweredValue{valid: success_value.valid and fallback_valid, value: result, type: guarded.type}


        # Lower terminating recovery such as `try parse_int(text) else return 0i64`.
        # The success edge merges the guarded value into the surrounding expression;
        # the recovery block is required to terminate (`return`, `break`, or
        # `continue`) so it never needs a value-producing merge edge.
        def lower_error_control_flow(guarded_expression: Ast::Expr, recovery: darray[Ast::Stmt]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            fallback_block: u32 = fresh_block(state)
            merge_block: u32 = fresh_block(state)
            state.instructions.push(Instruction{opcode: Opcode.ErrorGuardPush, result: 0, result_type: void_ir_type(), integer: fallback_block.i64(), span: ir_span(pos)})
            guarded: LoweredValue = lower_expression(guarded_expression, state)
            if not guarded.valid:
                return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            if guarded.type.kind == TypeKind.Void:
                # Statement-form terminating recovery also supports void operations:
                # `try assert(condition) else return` either falls through on success or
                # terminates in the recovery block after an assertion failure.
                state.instructions.push(Instruction{opcode: Opcode.ErrorGuardPop, result: 0, result_type: void_ir_type(), span: ir_span(pos)})
                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, span: ir_span(pos)}
                finish_block(state)

                state.current_block <- fallback_block
                state.terminated <- false
                for statement in recovery |state|:
                    lower_statement(statement, state.function_return_type, state)
                if not state.terminated:
                    add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "terminating recovery clause must end control flow")
                    state.terminator <- Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)}
                finish_block(state)

                state.current_block <- merge_block
                state.terminated <- false
                return LoweredValue{valid: true, value: 0, type: void_ir_type()}
            state.instructions.push(Instruction{opcode: Opcode.ErrorGuardPop, result: 0, result_type: void_ir_type(), span: ir_span(pos)})
            success_edge: u32 = state.edge_arg_pool.count.u32()
            state.edge_arg_pool.push(guarded.value)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: success_edge, edge0_arg_count: 1, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- fallback_block
            state.terminated <- false
            for statement in recovery |state|:
                lower_statement(statement, state.function_return_type, state)
            if not state.terminated:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "terminating recovery clause must end control flow")
                state.terminator <- Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)}
            finish_block(state)

            result: u32 = fresh_value(state)
            state.pending_parameter_blocks.push(merge_block)
            state.pending_parameters.push(Parameter{value: result, type: guarded.type, name: "error-control"})
            state.current_block <- merge_block
            state.terminated <- false
            return LoweredValue{valid: true, value: result, type: guarded.type}


        # Python's `print` is a small typed convenience over the existing
        # console write effects. Each value argument is converted using the same
        # scalar formatting rules as `str`, joined with a typed `sep` value, and
        # followed by a typed `end` value. `echo` and `println` are stdout aliases
        # and `eprint` selects stderr; all four share one stream/error contract
        # across the interpreter, bytecode VM, and future native backends.
        def lower_print(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&, stderr: bool) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = type_from_name("usize")
            if argument_names.count != 0 and argument_names.count != arguments.count:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "print argument labels must match the argument count")
                return LoweredValue{valid: false, value: 0, type: result_type}

            text_type: Type = type_from_name("sview")
            separator: mutable LoweredValue = emit_constant(state, text_type, 0, "", " ", false, ir_span(pos))
            ending: mutable LoweredValue = emit_constant(state, text_type, 0, "", "\n", false, ir_span(pos))
            values: mutable darray[LoweredValue] = []
            saw_named_control: mutable bool = false
            saw_separator: mutable bool = false
            saw_end: mutable bool = false
            saw_flush: mutable bool = false
            for argument_index in 0..<arguments.count |arguments, argument_names, argument_index, state, text_type, separator, ending, values, saw_named_control, saw_separator, saw_end, saw_flush, pos|:
                argument_name: sview = "" if argument_names.count == 0 else argument_names[argument_index]
                if argument_name == "":
                    if saw_named_control:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "print positional values must precede sep and end controls")
                        return LoweredValue{valid: false, value: 0, type: result_type}
                    value: LoweredValue = lower_expression(arguments[argument_index], state)
                    if not value.valid:
                        return LoweredValue{valid: false, value: 0, type: result_type}
                    values.push(value)
                    continue
                saw_named_control <- true
                if argument_name != "sep" and argument_name != "end" and argument_name != "flush":
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "print supports only typed sep, end, and flush controls")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                if argument_name == "flush":
                    if saw_flush:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "print accepts at most one flush control")
                        return LoweredValue{valid: false, value: 0, type: result_type}
                    flush_value: LoweredValue = lower_expression_expected(arguments[argument_index], type_from_name("bool"), state)
                    if not flush_value.valid or flush_value.type.kind != TypeKind.Bool:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "print flush control must be a bool value")
                        return LoweredValue{valid: false, value: 0, type: result_type}
                    # Stream writes use the POSIX write primitive directly, so
                    # bytes are visible immediately and there is no user-space
                    # buffer to drain. Accept Python's `flush` spelling while
                    # preserving that stronger unbuffered stream contract.
                    saw_flush <- true
                    continue
                control: LoweredValue = lower_expression_expected(arguments[argument_index], text_type, state)
                if not control.valid or control.type.kind != TypeKind.Text:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "print sep and end controls must be sview values")
                    return LoweredValue{valid: false, value: 0, type: result_type}
                if argument_name == "sep":
                    if saw_separator:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "print accepts at most one sep control")
                        return LoweredValue{valid: false, value: 0, type: result_type}
                    separator <- control
                    saw_separator <- true
                else:
                    if saw_end:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "print accepts at most one end control")
                        return LoweredValue{valid: false, value: 0, type: result_type}
                    ending <- control
                    saw_end <- true

            rendered: mutable LoweredValue = emit_constant(state, text_type, 0, "", "", false, ir_span(pos))
            for argument_index in 0..<values.count |values, argument_index, state, rendered, separator, text_type, pos|:
                if argument_index != 0:
                    rendered <- emit_binary(state, Opcode.Concat, rendered.value, separator.value, text_type, pos)
                value: mutable LoweredValue = values[argument_index]
                if value.type.kind == TypeKind.Text:
                    pass
                else:
                    opcode: mutable Opcode = Opcode.FormatBool
                    supported: mutable bool = true
                    if value.type.kind == TypeKind.Int:
                        opcode <- Opcode.FormatInt
                    elif value.type.kind == TypeKind.Float and (value.type.bits == 32 or value.type.bits == 64):
                        opcode <- Opcode.FormatFloat
                    elif value.type.kind == TypeKind.Named and value.type.name in {"Path", "Glob", "Regex", "Executable", "Url"}:
                        opcode <- Opcode.FormatNominal
                    elif value.type.kind == TypeKind.Array or value.type.kind == TypeKind.Map:
                        opcode <- Opcode.FormatAggregate
                    elif value.type.kind == TypeKind.Char:
                        opcode <- Opcode.FormatChar
                    elif value.type.kind != TypeKind.Bool:
                        supported <- false
                    if not supported:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "print values must be text, char, integer, f32/f64, bool, text-backed nominal, array, or dictionary value")
                        return LoweredValue{valid: false, value: 0, type: result_type}
                    formatted: u32 = fresh_value(state)
                    formatted_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(value.value)
                    state.instructions.push(Instruction{opcode: opcode, result: formatted, result_type: text_type, operand_start: formatted_start, operand_count: 1, span: ir_span(pos)})
                    value <- LoweredValue{valid: true, value: formatted, type: text_type}
                rendered <- emit_binary(state, Opcode.Concat, rendered.value, value.value, text_type, pos)
            rendered <- emit_binary(state, Opcode.Concat, rendered.value, ending.value, text_type, pos)
            state.required_effects.push("Console.Write") if not has_text(state.required_effects, "Console.Write")
            state.required_errors.push("ConsoleError") if not has_text(state.required_errors, "ConsoleError")
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(rendered.value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.WriteStderr if stderr else Opcode.WriteStdout
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Lower one environment lookup.  Keeping this operation in a helper
        # lets `get_environment` and the scripting-profile `get_environment_or`
        # share exactly the same effect and error row while the latter wraps
        # the lookup in a lexical error guard.
        def lower_environment_read(name_expression: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = type_from_name("sview")
            text_type: Type = type_from_name("sview")
            name_value: LoweredValue = lower_expression_expected(name_expression, text_type, state)
            if not name_value.valid or name_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "get_environment requires an sview name")
                return LoweredValue{valid: false, value: 0, type: result_type}
            state.required_effects.push("Environment.Read") if not has_text(state.required_effects, "Environment.Read")
            state.required_errors.push("EnvironmentError") if not has_text(state.required_errors, "EnvironmentError")
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(name_value.value)
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.GetEnvironment, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Python's `os.environ.get(name, fallback)` shape is useful in shell
        # ports: a missing variable is ordinary control flow rather than a
        # process-level failure.  The fallback is evaluated only on the error
        # edge, preserving the same lazy semantics as `try ... else ...`.
        def lower_environment_or(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = type_from_name("sview")
            valid_shape: bool = arguments.count == 2 and (argument_names.count == 0 or (argument_names.count == 2 and argument_names[0] == "" and argument_names[1] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "get_environment_or requires two positional sview values")
                return LoweredValue{valid: false, value: 0, type: result_type}
            fallback_block: u32 = fresh_block(state)
            merge_block: u32 = fresh_block(state)
            state.instructions.push(Instruction{opcode: Opcode.ErrorGuardPush, result: 0, result_type: void_ir_type(), integer: fallback_block.i64(), span: ir_span(pos)})
            guarded: LoweredValue = lower_environment_read(arguments[0], pos, state)
            if not guarded.valid:
                return LoweredValue{valid: false, value: 0, type: result_type}
            state.instructions.push(Instruction{opcode: Opcode.ErrorGuardPop, result: 0, result_type: void_ir_type(), span: ir_span(pos)})
            success_edge: u32 = state.edge_arg_pool.count.u32()
            state.edge_arg_pool.push(guarded.value)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: success_edge, edge0_arg_count: 1, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- fallback_block
            state.terminated <- false
            fallback: LoweredValue = lower_expression_expected(arguments[1], result_type, state)
            fallback_edge: mutable u32 = 0
            if fallback.valid:
                fallback_edge <- state.edge_arg_pool.count.u32()
                state.edge_arg_pool.push(fallback.value)
                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: fallback_edge, edge0_arg_count: 1, span: ir_span(pos)}
            finish_block(state)

            result: u32 = fresh_value(state)
            state.pending_parameter_blocks.push(merge_block)
            state.pending_parameters.push(Parameter{value: result, type: result_type, name: "environment-or"})
            state.current_block <- merge_block
            state.terminated <- false
            return LoweredValue{valid: fallback.valid, value: result, type: result_type}


        # Run a typed, shell-free pipeline. Each executable is paired with one
        # argument array at the same index; stdout from one stage becomes stdin
        # for the next. Stages are intentionally buffered through the existing
        # ProcessCapture transport, so pipe backpressure cannot deadlock a script.
        def lower_capture_process_pipeline(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = Type{kind: TypeKind.Named, name: "ProcessCapture"}
            executable_array_type: Type = array_ir_type(Type{kind: TypeKind.Named, name: "Executable"})
            stage_arguments_type: Type = array_ir_type(type_from_name("sview"))
            arguments_array_type: Type = array_ir_type(stage_arguments_type)
            valid_shape: bool = arguments.count == 3 and (argument_names.count == 0 or (argument_names[0] == "" and argument_names[1] == "" and argument_names[2] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "capture_process_pipeline requires positional darray[Executable], darray[darray[sview]], and sview values")
                return LoweredValue{valid: false, value: 0, type: result_type}
            executables_value: LoweredValue = lower_expression_expected(arguments[0], executable_array_type, state)
            arguments_value: LoweredValue = lower_expression_expected(arguments[1], arguments_array_type, state)
            input_value: LoweredValue = lower_expression(arguments[2], state)
            valid_input: bool = input_value.valid and input_value.type.kind == TypeKind.Text
            if not executables_value.valid or not same_type(executables_value.type, executable_array_type) or not arguments_value.valid or not same_type(arguments_value.type, arguments_array_type) or not valid_input:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "capture_process_pipeline requires darray[Executable], darray[darray[sview]], and sview operands")
                return LoweredValue{valid: false, value: 0, type: result_type}
            state.required_effects.push("Process.Run") if not has_text(state.required_effects, "Process.Run")
            state.required_errors.push("ProcessError") if not has_text(state.required_errors, "ProcessError")
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(executables_value.value)
            state.operand_pool.push(arguments_value.value)
            state.operand_pool.push(input_value.value)
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.CaptureProcessPipeline, result: result, result_type: result_type, operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Run a process while feeding typed stdin, returning only its exit
        # status. The capture-result opcode is deliberately reused so this
        # convenience keeps the same temporary-file transport and one-shot
        # status/output snapshot as the explicit ProcessCapture API.
        def lower_run_process_with_stdin(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = type_from_name("i64")
            argument_array_type: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Text}
            valid_shape: bool = arguments.count == 3 and (argument_names.count == 0 or (argument_names[0] == "" and argument_names[1] == "" and argument_names[2] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "run_process_with_stdin requires positional Executable, darray[sview], and sview values")
                return LoweredValue{valid: false, value: 0, type: result_type}
            executable_value: LoweredValue = lower_expression(arguments[0], state)
            arguments_value: LoweredValue = lower_expression_expected(arguments[1], argument_array_type, state)
            input_value: LoweredValue = lower_expression(arguments[2], state)
            valid_executable: bool = executable_value.valid and executable_value.type.kind == TypeKind.Named and executable_value.type.name == "Executable"
            valid_arguments: bool = arguments_value.valid and same_type(arguments_value.type, argument_array_type)
            valid_input: bool = input_value.valid and input_value.type.kind == TypeKind.Text
            if not valid_executable or not valid_arguments or not valid_input:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "run_process_with_stdin requires nominal Executable, darray[sview], and sview operands")
                return LoweredValue{valid: false, value: 0, type: result_type}
            state.required_effects.push("Process.Run") if not has_text(state.required_effects, "Process.Run")
            state.required_errors.push("ProcessError") if not has_text(state.required_errors, "ProcessError")
            capture_type: Type = Type{kind: TypeKind.Named, name: "ProcessCapture"}
            capture_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(executable_value.value)
            state.operand_pool.push(arguments_value.value)
            state.operand_pool.push(input_value.value)
            capture: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.CaptureProcessResult, result: capture, result_type: capture_type, operand_start: capture_start, operand_count: 3, span: ir_span(pos)})
            status_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(capture)
            status: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.ProcessResultExitStatus, result: status, result_type: result_type, operand_start: status_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: status, type: result_type}


        # Run a process in a typed child working directory and return only its
        # status. An empty stdin snapshot keeps this facade equivalent to the
        # ordinary `run_process` contract while reusing the directory-aware
        # ProcessCapture implementation.
        def lower_run_process_in_directory(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = type_from_name("i64")
            argument_array_type: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Text}
            directory_type: Type = Type{kind: TypeKind.Named, name: "Path"}
            valid_shape: bool = arguments.count == 3 and (argument_names.count == 0 or (argument_names[0] == "" and argument_names[1] == "" and argument_names[2] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "run_process_in_directory requires positional Executable, darray[sview], and Path values")
                return LoweredValue{valid: false, value: 0, type: result_type}
            executable_value: LoweredValue = lower_expression(arguments[0], state)
            arguments_value: LoweredValue = lower_expression_expected(arguments[1], argument_array_type, state)
            directory_value: LoweredValue = lower_expression_expected(arguments[2], directory_type, state)
            valid_executable: bool = executable_value.valid and executable_value.type.kind == TypeKind.Named and executable_value.type.name == "Executable"
            valid_arguments: bool = arguments_value.valid and same_type(arguments_value.type, argument_array_type)
            valid_directory: bool = directory_value.valid and same_type(directory_value.type, directory_type)
            if not valid_executable or not valid_arguments or not valid_directory:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "run_process_in_directory requires nominal Executable, darray[sview], and Path operands")
                return LoweredValue{valid: false, value: 0, type: result_type}
            state.required_effects.push("Process.Run") if not has_text(state.required_effects, "Process.Run")
            state.required_errors.push("ProcessError") if not has_text(state.required_errors, "ProcessError")
            empty_input: LoweredValue = emit_constant(state, type_from_name("sview"), 0, "", "", false, ir_span(pos))
            capture_type: Type = Type{kind: TypeKind.Named, name: "ProcessCapture"}
            capture_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(executable_value.value)
            state.operand_pool.push(arguments_value.value)
            state.operand_pool.push(empty_input.value)
            state.operand_pool.push(directory_value.value)
            capture: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.CaptureProcessResultInDirectory, result: capture, result_type: capture_type, operand_start: capture_start, operand_count: 4, span: ir_span(pos)})
            status_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(capture)
            status: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.ProcessResultExitStatus, result: status, result_type: result_type, operand_start: status_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: status, type: result_type}


        # Run a process with typed child-only environment overrides and return
        # only its status. The empty stdin snapshot and result accessor keep
        # this convenience aligned with the explicit capture API.
        def lower_run_process_with_environment(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = type_from_name("i64")
            argument_array_type: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Text}
            environment_type: Type = map_ir_type(type_from_name("sview"), type_from_name("sview"))
            valid_shape: bool = arguments.count == 3 and (argument_names.count == 0 or (argument_names[0] == "" and argument_names[1] == "" and argument_names[2] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "run_process_with_environment requires positional Executable, darray[sview], and dict[sview, sview] values")
                return LoweredValue{valid: false, value: 0, type: result_type}
            executable_value: LoweredValue = lower_expression(arguments[0], state)
            arguments_value: LoweredValue = lower_expression_expected(arguments[1], argument_array_type, state)
            environment_value: LoweredValue = lower_expression_expected(arguments[2], environment_type, state)
            valid_executable: bool = executable_value.valid and executable_value.type.kind == TypeKind.Named and executable_value.type.name == "Executable"
            valid_arguments: bool = arguments_value.valid and same_type(arguments_value.type, argument_array_type)
            valid_environment: bool = environment_value.valid and same_type(environment_value.type, environment_type)
            if not valid_executable or not valid_arguments or not valid_environment:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "run_process_with_environment requires nominal Executable, darray[sview], and dict[sview, sview] operands")
                return LoweredValue{valid: false, value: 0, type: result_type}
            state.required_effects.push("Process.Run") if not has_text(state.required_effects, "Process.Run")
            state.required_errors.push("ProcessError") if not has_text(state.required_errors, "ProcessError")
            empty_input: LoweredValue = emit_constant(state, type_from_name("sview"), 0, "", "", false, ir_span(pos))
            capture_type: Type = Type{kind: TypeKind.Named, name: "ProcessCapture"}
            capture_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(executable_value.value)
            state.operand_pool.push(arguments_value.value)
            state.operand_pool.push(empty_input.value)
            state.operand_pool.push(environment_value.value)
            capture: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.CaptureProcessResultWithEnvironment, result: capture, result_type: capture_type, operand_start: capture_start, operand_count: 4, span: ir_span(pos)})
            status_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(capture)
            status: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.ProcessResultExitStatus, result: status, result_type: result_type, operand_start: status_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: status, type: result_type}


        # Run a process with both child-only working-directory and environment
        # controls, returning only its status. This is the composed status
        # facade for the full differential/process-capture contract.
        def lower_run_process_in_directory_with_environment(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = type_from_name("i64")
            argument_array_type: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Text}
            directory_type: Type = Type{kind: TypeKind.Named, name: "Path"}
            environment_type: Type = map_ir_type(type_from_name("sview"), type_from_name("sview"))
            valid_shape: bool = arguments.count == 4 and (argument_names.count == 0 or (argument_names[0] == "" and argument_names[1] == "" and argument_names[2] == "" and argument_names[3] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "run_process_in_directory_with_environment requires positional Executable, darray[sview], Path, and dict[sview, sview] values")
                return LoweredValue{valid: false, value: 0, type: result_type}
            executable_value: LoweredValue = lower_expression(arguments[0], state)
            arguments_value: LoweredValue = lower_expression_expected(arguments[1], argument_array_type, state)
            directory_value: LoweredValue = lower_expression_expected(arguments[2], directory_type, state)
            environment_value: LoweredValue = lower_expression_expected(arguments[3], environment_type, state)
            valid_executable: bool = executable_value.valid and executable_value.type.kind == TypeKind.Named and executable_value.type.name == "Executable"
            valid_arguments: bool = arguments_value.valid and same_type(arguments_value.type, argument_array_type)
            valid_directory: bool = directory_value.valid and same_type(directory_value.type, directory_type)
            valid_environment: bool = environment_value.valid and same_type(environment_value.type, environment_type)
            if not valid_executable or not valid_arguments or not valid_directory or not valid_environment:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "run_process_in_directory_with_environment requires nominal Executable, darray[sview], Path, and dict[sview, sview] operands")
                return LoweredValue{valid: false, value: 0, type: result_type}
            state.required_effects.push("Process.Run") if not has_text(state.required_effects, "Process.Run")
            state.required_errors.push("ProcessError") if not has_text(state.required_errors, "ProcessError")
            empty_input: LoweredValue = emit_constant(state, type_from_name("sview"), 0, "", "", false, ir_span(pos))
            capture_type: Type = Type{kind: TypeKind.Named, name: "ProcessCapture"}
            capture_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(executable_value.value)
            state.operand_pool.push(arguments_value.value)
            state.operand_pool.push(empty_input.value)
            state.operand_pool.push(directory_value.value)
            state.operand_pool.push(environment_value.value)
            capture: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.CaptureProcessResultInDirectoryWithEnvironment, result: capture, result_type: capture_type, operand_start: capture_start, operand_count: 5, span: ir_span(pos)})
            status_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(capture)
            status: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.ProcessResultExitStatus, result: status, result_type: result_type, operand_start: status_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: status, type: result_type}


        def lower_expression(expression: Ast::Expr, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            match expression:
                Expr.IntLit(value):
                    return emit_constant(state, type_from_name("i64"), value, "", "", false, zero_span())
                Expr.IntLitTyped(value, suffix):
                    literal_type: Type = type_from_name(suffix)
                    if not positive_integer_literal_fits(value, literal_type):
                        add_issue(state, LowerIssueKind.TypeMismatch, 0, "integer literal is outside its explicit suffix range")
                        return LoweredValue{valid: false, value: 0, type: literal_type}
                    return emit_constant(state, literal_type, value, "", "", false, zero_span())
                Expr.FloatLit(text):
                    return emit_constant(state, type_from_name("f64"), 0, text, "", false, zero_span())
                Expr.StringLit(text):
                    return emit_constant(state, type_from_name("sview"), 0, "", text, false, zero_span())
                Expr.CharLit(text):
                    return emit_constant(state, type_from_name("char"), 0, "", text, false, zero_span())
                Expr.BoolLit(value):
                    return emit_constant(state, type_from_name("bool"), 0, "", "", value, zero_span())
                Expr.Ident(name, pos):
                    if name == "raise":
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "raise requires one positional Error.Tag reference")
                        return LoweredValue{valid: false, value: 0, type: void_ir_type()}
                    binding: mutable LoweredValue = lookup_binding(state, name)
                    if not binding.valid:
                        global_index: usize = global_binding_index(state, name)
                        binding <- emit_global_load(state, global_index, pos) if global_index < state.global_names.count
                    add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "identifier has no lowered local binding") if not binding.valid
                    return binding
                Expr.Paren(inner, pos):
                    return lower_expression(inner, state)
                Expr.Block(statements, value, captures, pos):
                    if captures.count != 0:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "capturing value blocks require ownership-aware closure lowering")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    scope_mark: usize = state.names.count
                    for statement in statements |state|:
                        lower_statement(statement, state.function_return_type, state)
                    if state.terminated:
                        state.names.truncate(scope_mark)
                        state.values.truncate(scope_mark)
                        state.types.truncate(scope_mark)
                        state.mutables.truncate(scope_mark)
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    lowered_value: LoweredValue = lower_expression(value, state)
                    state.names.truncate(scope_mark)
                    state.values.truncate(scope_mark)
                    state.types.truncate(scope_mark)
                    state.mutables.truncate(scope_mark)
                    return lowered_value
                Expr.Array(elements, pos):
                    if elements.count == 0:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "empty array literals require an explicit element type")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    element_type: mutable Type = unknown_ir_type()
                    valid: mutable bool = true
                    element_values: mutable darray[u32] = []
                    for index in 0..<elements.count |elements, state, element_type, valid, element_values|:
                        element: LoweredValue = lower_expression(elements[index], state)
                        if not element.valid:
                            valid <- false
                        else:
                            element_type <- element.type if index == 0
                            if index > 0 and not same_type(element_type, element.type):
                                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "array literal elements must have one static type")
                                valid <- false
                            element_values.push(element.value)
                    if element_type.kind == TypeKind.Array and element_type.element_kind == TypeKind.Array and element_type.element_element_kind == TypeKind.Array and element_type.element_element_element_kind == TypeKind.Array and element_type.element_element_element_element_kind == TypeKind.Array and element_type.element_element_element_element_element_kind == TypeKind.Array:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "arrays nested deeper than six levels are not implemented yet")
                        valid <- false
                    LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not valid
                    result_type: Type = array_ir_type(element_type)
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.extend(element_values)
                    state.instructions.push(Instruction{opcode: Opcode.MakeArray, result: result, result_type: result_type, operand_start: operand_start, operand_count: elements.count.u16(), span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: result_type}
                Expr.Tuple(elements, pos):
                    # The closed IR has no heterogeneous tuple descriptor yet, but
                    # homogeneous tuple values have exactly the same storage and
                    # equality semantics as a dynamic array. Preserve the tuple
                    # spelling only through parsing and lower it after checking all
                    # elements against the first element's static type.
                    if elements.count == 0:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "empty tuple values require an explicit darray element type")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    element_type: mutable Type = unknown_ir_type()
                    valid: mutable bool = true
                    element_values: mutable darray[u32] = []
                    for index in 0..<elements.count |elements, state, element_type, valid, element_values|:
                        element: LoweredValue = lower_expression(elements[index], state)
                        if not element.valid:
                            valid <- false
                        else:
                            element_type <- element.type if index == 0
                            if index > 0 and not same_type(element_type, element.type):
                                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "tuple values must have one static type until heterogeneous tuple types are available")
                                valid <- false
                            element_values.push(element.value)
                    LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not valid
                    result_type: Type = array_ir_type(element_type)
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.extend(element_values)
                    state.instructions.push(Instruction{opcode: Opcode.MakeArray, result: result, result_type: result_type, operand_start: operand_start, operand_count: elements.count.u16(), span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: result_type}
                Expr.SetLit(elements, pos):
                    if elements.count == 0:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "empty set literals require an explicit set[T] type")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    element_type: mutable Type = unknown_ir_type()
                    valid: mutable bool = true
                    operands: mutable darray[u32] = []
                    marker_type: Type = type_from_name("bool")
                    for index in 0..<elements.count |elements, state, element_type, valid, operands|:
                        element: LoweredValue = lower_expression(elements[index], state)
                        if not element.valid:
                            valid <- false
                        else:
                            element_type <- element.type if index == 0
                            if index > 0 and not same_type(element_type, element.type):
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "set literal elements must have one static type")
                                valid <- false
                            if element.type.kind in {TypeKind.Array, TypeKind.Map, TypeKind.Function, TypeKind.Block, TypeKind.Void}:
                                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "set elements must be scalar or nominal values")
                                valid <- false
                            marker: LoweredValue = emit_constant(state, marker_type, 0, "", "", true, ir_span(pos))
                            operands.push(element.value)
                            operands.push(marker.value)
                    LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not valid
                    result_type: Type = set_ir_type(element_type)
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.extend(operands)
                    state.instructions.push(Instruction{opcode: Opcode.MakeMap, result: result, result_type: result_type, operand_start: operand_start, operand_count: operands.count.u16(), span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: result_type}
                Expr.Comprehension(variable, iterable, condition, body, pos):
                    return lower_set_comprehension(variable, iterable, condition, body, pos, state) if comprehension_kind(state, pos) == "set"
                    return lower_map_comprehension(variable, iterable, condition, body, pos, state) if comprehension_kind(state, pos) == "map"
                    return lower_integer_fold_comprehension(comprehension_query_kind(state, pos), variable, iterable, condition, body, pos, state, Expr.Absent) if comprehension_kind(state, pos) == "query" and (comprehension_query_kind(state, pos) == "count" or comprehension_query_kind(state, pos) == "sum" or comprehension_query_kind(state, pos) == "product")
                    return lower_query_comprehension(variable, iterable, condition, body, pos, state, "") if comprehension_kind(state, pos) == "query" and comprehension_query_kind(state, pos) != "each"
                    return lower_array_comprehension(variable, iterable, condition, body, pos, state)
                Expr.DictLit(entries, pos):
                    if entries.count == 0:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "empty dictionary literals require an explicit dict[K, V] type")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    key_type: mutable Type = unknown_ir_type()
                    value_type: mutable Type = unknown_ir_type()
                    valid: mutable bool = true
                    operands: mutable darray[u32] = []
                    for index in 0..<entries.count |entries, state, key_type, value_type, valid, operands|:
                        key: LoweredValue = lower_expression(entries[index].key, state)
                        value: LoweredValue = lower_expression(entries[index].value, state)
                        if not key.valid or not value.valid:
                            valid <- false
                        else:
                            key_type <- key.type if index == 0
                            value_type <- value.type if index == 0
                            if index > 0 and (not same_type(key_type, key.type) or not same_type(value_type, value.type)):
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "dictionary entries must have one static key and value type")
                                valid <- false
                            if key.type.kind in {TypeKind.Array, TypeKind.Map, TypeKind.Function, TypeKind.Block, TypeKind.Void} or not dictionary_value_type_supported(value.type):
                                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "dictionary keys must be scalar or nominal values, and values must use a supported inline aggregate shape")
                                valid <- false
                            operands.push(key.value)
                            operands.push(value.value)
                    LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not valid
                    result_type: Type = map_ir_type(key_type, value_type)
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.extend(operands)
                    state.instructions.push(Instruction{opcode: Opcode.MakeMap, result: result, result_type: result_type, operand_start: operand_start, operand_count: operands.count.u16(), span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: result_type}
                Expr.Index(collection, index_expression, pos):
                    lowered_collection: LoweredValue = lower_expression(collection, state)
                    lowered_index: LoweredValue = lower_expression(index_expression, state)
                    LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not lowered_collection.valid or not lowered_index.valid
                    if lowered_collection.type.kind == TypeKind.Map:
                        key_type: Type = map_key_type(lowered_collection.type)
                        if not same_type(lowered_index.type, key_type):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "dictionary index must match its key type")
                            return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                        result_type: Type = map_value_type(lowered_collection.type)
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(lowered_collection.value)
                        state.operand_pool.push(lowered_index.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.Index, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if lowered_collection.type.kind != TypeKind.Array and lowered_collection.type.kind != TypeKind.Text:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "index lowering requires an array, dictionary, or text value")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    if lowered_index.type.kind != TypeKind.Int:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "collection index must have an integer type")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    result_type: Type = type_from_name("char") if lowered_collection.type.kind == TypeKind.Text else array_element_type(lowered_collection.type)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(lowered_collection.value)
                    state.operand_pool.push(lowered_index.value)
                    result: u32 = fresh_value(state)
                    state.instructions.push(Instruction{opcode: Opcode.Index, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: result_type}
                Expr.Slice(collection, low_expression, high_expression, pos):
                    lowered_collection: LoweredValue = lower_expression(collection, state)
                    LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not lowered_collection.valid
                    if lowered_collection.type.kind not in {TypeKind.Array, TypeKind.Text}:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "slice lowering requires an array or text value")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    bound_type: Type = type_from_name("usize")
                    low: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: bound_type}
                    match low_expression:
                        Expr.Absent:
                            low <- emit_constant(state, bound_type, 0, "", "", false, ir_span(pos))
                        _:
                            low <- lower_expression(low_expression, state)
                    high: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: bound_type}
                    match high_expression:
                        Expr.Absent:
                            high_result: u32 = fresh_value(state)
                            high_operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(lowered_collection.value)
                            state.instructions.push(Instruction{opcode: Opcode.Length, result: high_result, result_type: bound_type, operand_start: high_operand_start, operand_count: 1, span: ir_span(pos)})
                            high <- LoweredValue{valid: true, value: high_result, type: bound_type}
                        _:
                            high <- lower_expression(high_expression, state)
                    LoweredValue{valid: false, value: 0, type: lowered_collection.type} return if not low.valid or not high.valid
                    if low.type.kind != TypeKind.Int or high.type.kind != TypeKind.Int:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "slice bounds must have integer types")
                        return LoweredValue{valid: false, value: 0, type: lowered_collection.type}
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(lowered_collection.value)
                    state.operand_pool.push(low.value)
                    state.operand_pool.push(high.value)
                    result: u32 = fresh_value(state)
                    state.instructions.push(Instruction{opcode: Opcode.Slice, result: result, result_type: lowered_collection.type, operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: lowered_collection.type}
                Expr.Field(collection, field, pos):
                    lowered_collection: LoweredValue = lower_expression(collection, state)
                    LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not lowered_collection.valid
                    # Process captures expose both explicit Elisa-style names
                    # and the conventional Python subprocess field spellings.
                    # Keep these as compiler-known fields over the nominal
                    # ProcessCapture type so the operation remains statically
                    # typed while ports can write `result.returncode`,
                    # `result.stdout`, and `result.stderr` directly.
                    if lowered_collection.type.kind == TypeKind.Named and lowered_collection.type.name == "ProcessCapture":
                        process_field: bool = field == "returncode" or field == "exit_status" or field == "status" or field == "process_exit_status" or field == "stdout" or field == "process_stdout" or field == "stderr" or field == "process_stderr"
                        if process_field:
                            process_opcode: mutable Opcode = Opcode.ProcessResultExitStatus
                            process_result_type: mutable Type = type_from_name("i64")
                            process_opcode <- Opcode.ProcessResultStdout if field == "stdout" or field == "process_stdout"
                            process_opcode <- Opcode.ProcessResultStderr if field == "stderr" or field == "process_stderr"
                            process_result_type <- type_from_name("sview") if field == "stdout" or field == "process_stdout" or field == "stderr" or field == "process_stderr"
                            operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(lowered_collection.value)
                            result: u32 = fresh_value(state)
                            state.instructions.push(Instruction{opcode: process_opcode, result: result, result_type: process_result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                            return LoweredValue{valid: true, value: result, type: process_result_type}
                    if lowered_collection.type.kind == TypeKind.Named and lowered_collection.type.name == "Path":
                        path_shape: mutable Opcode = Opcode.PathParent
                        path_result_type: mutable Type = Type{kind: TypeKind.Named, name: "Path"}
                        valid_path_field: mutable bool = field == "parent"
                        if field == "name" or field == "suffix" or field == "stem":
                            valid_path_field <- true
                            path_result_type <- type_from_name("sview")
                            path_shape <- Opcode.PathName if field == "name" else (Opcode.PathExtension if field == "suffix" else Opcode.PathStem)
                        if valid_path_field:
                            operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(lowered_collection.value)
                            result: u32 = fresh_value(state)
                            state.instructions.push(Instruction{opcode: path_shape, result: result, result_type: path_result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                            return LoweredValue{valid: true, value: result, type: path_result_type}
                    if field != "count" or lowered_collection.type.kind not in {TypeKind.Array, TypeKind.Map, TypeKind.Text}:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "field lowering supports array.count, dictionary.count, text.count, and ProcessCapture status/output fields")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    result_type: Type = type_from_name("usize")
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(lowered_collection.value)
                    result: u32 = fresh_value(state)
                    state.instructions.push(Instruction{opcode: Opcode.Length, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: result_type}
                Expr.Unary(operator, operand, pos):
                    if operator == TokenKind.Minus:
                        match operand:
                            Expr.IntLitTyped(magnitude, suffix):
                                literal_type: Type = type_from_name(suffix)
                                if not negative_integer_literal_fits(magnitude, literal_type):
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "negative integer literal is outside its explicit signed suffix range")
                                    return LoweredValue{valid: false, value: 0, type: literal_type}
                                return emit_constant(state, literal_type, 0 - magnitude, "", "", false, ir_span(pos))
                            _:
                                pass
                    lowered_operand: LoweredValue = lower_expression(operand, state)
                    LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not lowered_operand.valid
                    if operator == TokenKind.Plus:
                        return lowered_operand
                    opcode: mutable Opcode = Opcode.Negate
                    supported: mutable bool = operator == TokenKind.Minus or operator == TokenKind.Not or operator == TokenKind.Bang or operator == TokenKind.Tilde
                    opcode <- Opcode.Not if operator == TokenKind.Not or operator == TokenKind.Bang
                    opcode <- Opcode.BitNot if operator == TokenKind.Tilde
                    if not supported:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "unary operator is not in the core IR lowering subset")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    if opcode == Opcode.Negate and not numeric_type(lowered_operand.type):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "numeric negation requires an integer or floating-point operand")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    if opcode == Opcode.Negate and lowered_operand.type.kind == TypeKind.Int and not lowered_operand.type.signed:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "numeric negation requires a signed integer or floating-point operand")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    if opcode == Opcode.Not and lowered_operand.type.kind != TypeKind.Bool:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "boolean negation requires a boolean operand")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    if opcode == Opcode.BitNot and lowered_operand.type.kind != TypeKind.Int:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "bitwise complement requires an integer operand")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    result_type: Type = type_from_name("bool") if opcode == Opcode.Not else lowered_operand.type
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(lowered_operand.value)
                    state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: result_type}
                Expr.Binary(left, operator, right, pos):
                    match left:
                        Expr.Index(collection_expression, index_expression, index_pos):
                            if operator == TokenKind.Else:
                                return lower_checked_index(collection_expression, index_expression, right, pos, state)
                        _:
                            pass
                    lowered_left: LoweredValue = lower_expression(left, state)
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not lowered_left.valid
                        if lowered_left.type.kind != TypeKind.Bool:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "short-circuit operators require boolean operands")
                            return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                        right_block: u32 = fresh_block(state)
                        short_block: u32 = fresh_block(state)
                        merge_block: u32 = fresh_block(state)
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: lowered_left.value, operand_count: 1, target0: (right_block if operator == TokenKind.And else short_block), target1: (short_block if operator == TokenKind.And else right_block), target_count: 2, span: ir_span(pos)}
                        finish_block(state)

                        state.current_block <- right_block
                        state.terminated <- false
                        lowered_right: LoweredValue = lower_expression(right, state)
                        right_valid: mutable bool = lowered_right.valid
                        if lowered_right.valid and lowered_right.type.kind != TypeKind.Bool:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "short-circuit operators require boolean operands")
