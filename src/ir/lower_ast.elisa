        def is_regex_literal_expression(expression: Ast::Expr) -> bool:
            match expression:
                Expr.Call(callee, arguments, argument_names, _):
                    match callee:
                        Expr.Ident(name, _):
                            return name == "regex" and arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
                        _:
                            return false
                _:
                    return false


        def is_regex_receiver_expression(expression: Ast::Expr, state: LowerState&) -> bool:
            match expression:
                Expr.Ident(receiver_name, _):
                    receiver_binding: usize = binding_index(state, receiver_name)
                    return receiver_binding < state.names.count and state.types[receiver_binding].kind == TypeKind.Named and state.types[receiver_binding].name == "Regex"
                _:
                    return is_regex_literal_expression(expression)


        # Python's `pattern.split(text)` receiver spelling.  The result and
