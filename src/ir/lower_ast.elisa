                        directory_predicate_spec: EsBuiltin::BuiltinSpec = registry_spec
                        result_type: Type = typed_builtin_result_type(directory_predicate_spec)
                        if directory_predicate_spec.opcode != "IsDirectory" or not typed_builtin_call_shape(callee_name, arguments, argument_names):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "is_directory requires one positional Path value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        path_value: LoweredValue = lower_expression(arguments[0], state)
                        valid_path: bool = path_value.valid and path_value.type.kind == TypeKind.Named and path_value.type.name == "Path"
                        if not valid_path:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "is_directory requires a nominal Path operand")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(path_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.IsDirectory, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_index == state.function_names.count and registry_spec.receiver == "global" and registry_spec.argument_types == "Glob" and registry_spec.opcode == "ExpandGlob":
                        glob_spec: EsBuiltin::BuiltinSpec = registry_spec
                        result_type: Type = typed_builtin_result_type(glob_spec)
                        if glob_spec.opcode != "ExpandGlob" or not typed_builtin_call_shape(callee_name, arguments, argument_names):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "expand_glob requires one positional Glob value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        pattern_value: LoweredValue = lower_expression(arguments[0], state)
                        valid_pattern: bool = pattern_value.valid and pattern_value.type.kind == TypeKind.Named and pattern_value.type.name == "Glob"
                        if not valid_pattern:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "expand_glob requires a nominal Glob operand")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(pattern_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.ExpandGlob, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_index == state.function_names.count and registry_spec.receiver == "global" and registry_spec.argument_types == "" and registry_spec.opcode == "ReadStdin":
                        stdin_spec: EsBuiltin::BuiltinSpec = registry_spec
                        result_type: Type = typed_builtin_result_type(stdin_spec)
                        if not typed_builtin_call_shape(callee_name, arguments, argument_names):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "read_stdin takes no arguments")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.ReadStdin, result: result, result_type: result_type, operand_start: state.operand_pool.count.u32(), operand_count: arguments.count.u16(), span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_index == state.function_names.count and registry_spec.receiver == "global" and registry_spec.argument_types == "" and registry_spec.opcode == "ReadStdinLine":
                        stdin_line_spec: EsBuiltin::BuiltinSpec = registry_spec
                        result_type: Type = typed_builtin_result_type(stdin_line_spec)
                        if not typed_builtin_call_shape(callee_name, arguments, argument_names):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "read_stdin_line takes no arguments")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.ReadStdinLine, result: result, result_type: result_type, operand_start: state.operand_pool.count.u32(), operand_count: arguments.count.u16(), span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_index == state.function_names.count and registry_spec.receiver == "global" and registry_spec.argument_types == "text" and registry_spec.opcode == "ReadStdinLine":
                        input_spec: EsBuiltin::BuiltinSpec = registry_spec
                        result_type: Type = typed_builtin_result_type(input_spec)
                        valid_shape: bool = input_spec.opcode == "ReadStdinLine" and typed_builtin_call_shape(input_spec.name, arguments, argument_names)
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "input accepts zero or one positional sview prompt")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        state.required_effects.push(input_spec.effects) if input_spec.effects != "" and not has_text(state.required_effects, input_spec.effects)
                        state.required_effects.push("Console.Write") if arguments.count == 1 and not has_text(state.required_effects, "Console.Write")
                        state.required_errors.push(input_spec.errors) if input_spec.errors != "" and not has_text(state.required_errors, input_spec.errors)
                        if arguments.count == 1:
                            prompt_value: LoweredValue = lower_expression_expected(arguments[0], result_type, state)
                            if not prompt_value.valid or prompt_value.type.kind != TypeKind.Text:
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "input prompt must be an sview value")
                                return LoweredValue{valid: false, value: 0, type: result_type}
                            prompt_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(prompt_value.value)
                            prompt_result: u32 = fresh_value(state)
                            state.instructions.push(Instruction{opcode: Opcode.WriteStdout, result: prompt_result, result_type: type_from_name("usize"), operand_start: prompt_start, operand_count: 1, span: ir_span(pos)})
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.ReadStdinLine, result: result, result_type: result_type, operand_start: state.operand_pool.count.u32(), operand_count: 0, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_index == state.function_names.count and (registry_spec.opcode == "WriteStdout" or registry_spec.opcode == "WriteStderr"):
                        stream_spec: EsBuiltin::BuiltinSpec = registry_spec
                        result_type: Type = typed_builtin_result_type(stream_spec)
                        if not typed_builtin_call_shape(callee_name, arguments, argument_names):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "standard-stream write requires one positional text value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        text_value: LoweredValue = lower_expression(arguments[0], state)
                        if not text_value.valid or text_value.type.kind != TypeKind.Text:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "standard-stream write requires an sview value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(text_value.value)
                        opcode: Opcode = Opcode.WriteStderr if stream_spec.opcode == "WriteStderr" else Opcode.WriteStdout
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    directory_builtin: bool = registry_spec.known and registry_spec.receiver == "global" and registry_spec.argument_types == "Path" and (registry_spec.opcode == "CreateDirectory" or registry_spec.opcode == "CreateDirectories" or registry_spec.opcode == "RemoveDirectory" or registry_spec.opcode == "ChangeDirectory")
                    if directory_builtin and callee_index == state.function_names.count:
                        directory_mutation_spec: EsBuiltin::BuiltinSpec = registry_spec
                        result_type: Type = typed_builtin_result_type(directory_mutation_spec)
                        valid_directory_mutation_spec: bool = directory_mutation_spec.argument_types == "Path"
                        if not valid_directory_mutation_spec or not typed_builtin_call_shape(callee_name, arguments, argument_names):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "directory mutation requires one positional Path value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        path_value: LoweredValue = lower_expression(arguments[0], state)
                        valid_path: bool = path_value.valid and path_value.type.kind == TypeKind.Named and path_value.type.name == "Path"
                        if not valid_path:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "directory mutation requires a nominal Path operand")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        opcode: Opcode = Opcode.CreateDirectory if directory_mutation_spec.opcode == "CreateDirectory" else Opcode.CreateDirectories if directory_mutation_spec.opcode == "CreateDirectories" else Opcode.RemoveDirectory if directory_mutation_spec.opcode == "RemoveDirectory" else Opcode.ChangeDirectory
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(path_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_index == state.function_names.count and compiler_typed_literal(callee_name):
                        valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "typed literal construction requires one positional sview value")
                            return LoweredValue{valid: false, value: 0, type: typed_literal_type(callee_name)}
                        match arguments[0]:
                            Expr.StringLit(payload):
                                return emit_constant(state, typed_literal_type(callee_name), 0, "", payload, false, ir_span(pos))
                            _:
                                text_type: Type = type_from_name("sview")
                                text_value: LoweredValue = lower_expression_expected(arguments[0], text_type, state)
                                if not text_value.valid or text_value.type.kind != TypeKind.Text:
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "typed literal construction requires an sview value")
                                    return LoweredValue{valid: false, value: 0, type: typed_literal_type(callee_name)}
                                operand_start: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(text_value.value)
                                result: u32 = fresh_value(state)
                                state.instructions.push(Instruction{opcode: typed_literal_opcode(callee_name), result: result, result_type: typed_literal_type(callee_name), operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                                return LoweredValue{valid: true, value: result, type: typed_literal_type(callee_name)}
                    signature: LoweredValue = lookup_return_type(state, callee_name)
                    if callee_name == "" or not signature.valid:
                        add_issue(state, LowerIssueKind.UnknownCallee, pos.line, "only known direct function calls are in the initial lowering subset")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    if argument_names.count != 0 and argument_names.count != arguments.count:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "call argument metadata does not match its argument list")
                        return LoweredValue{valid: false, value: 0, type: signature.type}
                    expected_count: u16 = state.function_parameter_counts[callee_index]
                    parameter_start: usize = state.function_parameter_starts[callee_index].usize()
                    operands: mutable darray[u32] = []
                    operand_types: mutable darray[Type] = []
                    provided: mutable darray[bool] = []
                    for parameter in 0..<expected_count.usize() |operands, operand_types, provided|:
                        operands.push(0)
                        operand_types.push(void_ir_type())
                        provided.push(false)
                    valid: mutable bool = true
                    positional: mutable usize = 0
                    saw_named: mutable bool = false
                    for argument_index in 0..<arguments.count |arguments, argument_names, operands, operand_types, provided, valid, positional, saw_named, state, parameter_start, expected_count, pos|:
                        argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                        parameter: mutable usize = expected_count.usize()
                        if argument_name == "":
                            if saw_named:
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "positional call argument cannot follow a named argument")
                            else:
                                parameter <- positional
                                positional <- positional + 1
                        else:
                            saw_named <- true
                            for candidate in 0..<expected_count.usize() |state, parameter_start, argument_name, parameter, expected_count|:
                                parameter <- candidate if parameter == expected_count.usize() and state.function_parameter_names[parameter_start + candidate] == argument_name
                        if parameter >= expected_count.usize():
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "call argument does not name an available function parameter")
                            valid <- false
                        elif provided[parameter]:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "function parameter is supplied more than once")
                            valid <- false
                        else:
                            lowered_argument: LoweredValue = lower_expression_expected(arguments[argument_index], state.function_parameter_types[parameter_start + parameter], state)
                            if lowered_argument.valid:
                                operands[parameter] <- lowered_argument.value
                                operand_types[parameter] <- lowered_argument.type
                                provided[parameter] <- true
                                if not same_type(lowered_argument.type, state.function_parameter_types[parameter_start + parameter]):
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "call argument does not match the function parameter type")
                                    valid <- false
                            else:
                                valid <- false
                    default_scope: usize = state.names.count
                    for parameter in 0..<expected_count.usize() |state, parameter_start, operands, operand_types, provided, valid, pos|:
                        if not provided[parameter]:
                            if state.function_parameter_has_defaults[parameter_start + parameter]:
                                lowered_default: LoweredValue = lower_expression_expected(state.function_parameter_defaults[parameter_start + parameter], state.function_parameter_types[parameter_start + parameter], state)
                                if lowered_default.valid and same_type(lowered_default.type, state.function_parameter_types[parameter_start + parameter]):
                                    operands[parameter] <- lowered_default.value
                                    operand_types[parameter] <- lowered_default.type
                                    provided[parameter] <- true
                                else:
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "default argument does not match the function parameter type") if lowered_default.valid
                                    valid <- false
                            else:
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "call omits a required function parameter")
                                valid <- false
                        if provided[parameter]:
                            state.names.push(state.function_parameter_names[parameter_start + parameter])
                            state.values.push(operands[parameter])
                            state.types.push(operand_types[parameter])
                            state.mutables.push(false)
                    state.names.truncate(default_scope)
                    state.values.truncate(default_scope)
                    state.types.truncate(default_scope)
                    state.mutables.truncate(default_scope)
                    LoweredValue{valid: false, value: 0, type: signature.type} return if not valid
                    effect_start: usize = state.function_effect_starts[callee_index].usize()
                    effect_count: usize = state.function_effect_counts[callee_index].usize()
                    for offset in 0..<effect_count |state, effect_start|:
                        required_effect: sview = state.function_effects[effect_start + offset]
                        covered: bool = active_handler_covers(state.active_handlers, state.handlers, effect_family(required_effect), effect_operation(required_effect))
                        state.required_effects.push(required_effect) if not covered and not has_text(state.required_effects, required_effect)
                    error_start: usize = state.function_error_starts[callee_index].usize()
                    error_count: usize = state.function_error_counts[callee_index].usize()
                    for error_offset in 0..<error_count |state, error_start, error_count|:
                        required_error: sview = state.function_errors[error_start + error_offset]
                        state.required_errors.push(required_error) if required_error != "" and not has_text(state.required_errors, required_error)
                    result: mutable u32 = 0
                    result <- fresh_value(state) if signature.type.kind != TypeKind.Void
                    operand_start: u32 = state.operand_pool.count.u32()
                    for operand in operands |state|:
                        state.operand_pool.push(operand)
                    state.instructions.push(Instruction{opcode: Opcode.Call, result: result, result_type: signature.type, operand_start: operand_start, operand_count: operands.count.u16(), symbol: callee_name, span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: signature.type}
                _:
                    add_issue(state, LowerIssueKind.UnsupportedExpression, 0, "expression is not in the initial IR lowering subset")
                    return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}


        # `perform("Family.Operation", payload...)` is the value-producing sibling
        # of the Elisa `signal` statement. The expected destination type supplies
        # the operation result type, while the effect reference and ordered payloads
        # remain explicit and statically checked. Keeping this intrinsic in the
        # expected-type path prevents an untyped result from leaking into ordinary
        # expression lowering.
        def lower_perform_expression(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, expected: Type, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            if expected.kind == TypeKind.Void:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "perform requires a non-void destination type")
                return LoweredValue{valid: false, value: 0, type: expected}
            valid_shape: bool = arguments.count >= 1 and (argument_names.count == 0 or (argument_names.count == arguments.count and all name in argument_names where name == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "perform requires an effect reference followed by positional payloads")
                return LoweredValue{valid: false, value: 0, type: expected}
            reference: mutable sview = ""
            match arguments[0]:
                Expr.StringLit(value):
                    reference <- value
                _:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "perform effect reference must be a string literal")
                    return LoweredValue{valid: false, value: 0, type: expected}
            family: sview = effect_family(reference)
            operation: sview = effect_operation(reference)
            if not valid_effect_reference(reference):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "perform effect reference must use `Family.Operation` form")
                return LoweredValue{valid: false, value: 0, type: expected}
            if effect_operation_declared(state.source_file, family, operation) and arguments.count - 1 != effect_operation_declared_arity(state.source_file, family, operation):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "perform payload arity does not match the declared effect operation")
                return LoweredValue{valid: false, value: 0, type: expected}
            declared_result: Type = effect_operation_result_type(state.source_file, family, operation)
            if effect_operation_result_is_known(declared_result) and not same_type(declared_result, expected):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "perform result type does not match the declared effect operation result")
                return LoweredValue{valid: false, value: 0, type: expected}
            payloads: mutable darray[LoweredValue] = []
            valid_payloads: mutable bool = true
            if arguments.count > 1:
                for argument_index in 1..<arguments.count |arguments, argument_index, state, payloads, valid_payloads, family, operation, pos|:
                    payload: LoweredValue = lower_expression(arguments[argument_index], state)
                    valid_payloads <- false if not payload.valid
                    if payload.valid:
                        payloads.push(payload)
                        declared_payload: Type = effect_operation_payload_type(state.source_file, family, operation, argument_index - 1)
                        if effect_operation_payload_is_known(declared_payload) and not same_type(declared_payload, payload.type):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "perform payload type does not match the declared effect operation payload")
                            valid_payloads <- false
            return LoweredValue{valid: false, value: 0, type: expected} if not valid_payloads
            if payloads.count > LOWER_U16_MAX:
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "perform payload count exceeds the IR operand limit")
                return LoweredValue{valid: false, value: 0, type: expected}
            if not active_handler_covers(state.active_handlers, state.handlers, family, operation) and not effect_granted(state.required_effects, reference):
                state.required_effects.push(reference)
            operand_start: u32 = state.operand_pool.count.u32()
            for payload in payloads |state|:
                state.operand_pool.push(payload.value)
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.Perform, result: result, result_type: expected, operand_start: operand_start, operand_count: payloads.count.u16(), effect_family: family, effect_operation: operation, operation_id: Ast::effect_operation_identity(family, operation), trace: trace_site(state, reference, pos), span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: expected}


        def lower_expression_expected(expression: Ast::Expr, expected: Type, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            match expression:
                Expr.Call(Expr.Ident(name, _), arguments, argument_names, pos) if name == "perform" and lowered_function_index(state, name) == state.function_names.count:
                    return lower_perform_expression(arguments, argument_names, expected, pos, state)
                _:
                    pass
            match expression:
                Expr.Array(elements, pos):
                    if expected.kind == TypeKind.Array:
                        if elements.count > LOWER_U16_MAX:
                            add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "array literal exceeds the IR operand limit")
                            return LoweredValue{valid: false, value: 0, type: expected}
                        element_expected: Type = array_element_type(expected)
                        element_values: mutable darray[u32] = []
                        valid: mutable bool = true
                        for index in 0..<elements.count |elements, element_expected, state, element_values, valid|:
                            element: LoweredValue = lower_expression_expected(elements[index], element_expected, state)
                            if not element.valid or not same_type(element.type, element_expected):
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "array literal element does not match the destination array element type") if element.valid
                                valid <- false
                            else:
                                element_values.push(element.value)
                        if not valid:
                            return LoweredValue{valid: false, value: 0, type: expected}
                        result: u32 = fresh_value(state)
                        result_type: Type = owned_ir_type(expected)
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.extend(element_values)
                        state.instructions.push(Instruction{opcode: Opcode.MakeArray, result: result, result_type: result_type, operand_start: operand_start, operand_count: elements.count.u16(), span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                Expr.Tuple(elements, pos):
                    # Python ports commonly use a tuple literal where an
                    # explicitly typed homogeneous sequence is expected.  Keep
                    # this adaptation deliberately contextual: each element is
                    # checked against the destination array element type and the
                    # emitted value has ordinary array semantics.  A tuple in an
                    # unconstrained position still falls through to the explicit
                    # unsupported-expression diagnostic below, preserving the
                    # distinction until first-class recursive tuples are added.
                    if expected.kind == TypeKind.Array:
                        if elements.count > LOWER_U16_MAX:
                            add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "tuple literal exceeds the IR operand limit")
                            return LoweredValue{valid: false, value: 0, type: expected}
                        element_expected: Type = array_element_type(expected)
                        element_values: mutable darray[u32] = []
                        valid: mutable bool = true
                        for index in 0..<elements.count |elements, element_expected, state, element_values, valid|:
                            element: LoweredValue = lower_expression_expected(elements[index], element_expected, state)
                            if not element.valid or not same_type(element.type, element_expected):
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "tuple literal element does not match the destination array element type") if element.valid
                                valid <- false
                            else:
                                element_values.push(element.value)
                        if not valid:
                            return LoweredValue{valid: false, value: 0, type: expected}
                        result: u32 = fresh_value(state)
                        result_type: Type = owned_ir_type(expected)
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.extend(element_values)
                        state.instructions.push(Instruction{opcode: Opcode.MakeArray, result: result, result_type: result_type, operand_start: operand_start, operand_count: elements.count.u16(), span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                Expr.DictLit(entries, pos):
                    if entries.count == 0 and expected.kind == TypeKind.Map:
                        result: u32 = fresh_value(state)
                        result_type: Type = owned_ir_type(expected)
                        state.instructions.push(Instruction{opcode: Opcode.MakeMap, result: result, result_type: result_type, operand_start: state.operand_pool.count.u32(), operand_count: 0, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                _:
                    pass
            return lower_expression(expression, state)


        def lower_text_case_value_with_spec(value: u32, method_spec: EsBuiltin::BuiltinSpec, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue:
            result_type: Type = typed_builtin_result_type(method_spec)
            if not method_spec.known or (method_spec.opcode != "LowerText" and method_spec.opcode != "UpperText"):
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "text case registry row has no LowerText or UpperText opcode")
                return LoweredValue{valid: false, value: 0, type: result_type}
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.UpperText if method_spec.opcode == "UpperText" else Opcode.LowerText
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_case_value(value: u32, method_name: sview, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue:
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_spec(method_name)
            return lower_text_case_value_with_spec(value, method_spec, pos, state)


        def lower_text_case_method(receiver_name: sview, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "text case-conversion receiver has no local binding")
                return invalid
            if state.types[binding].kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "lower/upper requires a text receiver")
                return invalid
            if not typed_builtin_method_call_shape("Text", method_name, arguments, argument_names):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "lower/upper requires no arguments")
                return invalid
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method_name)
            return lower_text_case_value_with_spec(state.values[binding], method_spec, pos, state)


        def lower_text_case_expression(receiver_expression: Ast::Expr, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            if not typed_builtin_method_call_shape("Text", method_name, arguments, argument_names):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "lower/upper requires no arguments")
                return invalid
            receiver: LoweredValue = lower_expression(receiver_expression, state)
            if not receiver.valid or receiver.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "lower/upper requires a text receiver")
                return invalid
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method_name)
            return lower_text_case_value_with_spec(receiver.value, method_spec, pos, state)


        # Elisa's runtime exposes a `count` field for collections; ports from
        # Python/Perl also commonly use a zero-argument `text.len()` helper.
        # Keep that spelling a registry-backed Text method and lower it to the
        # same verified Length operation as global `len(text)` and `.count`.
        def lower_text_length_expression(receiver_expression: Ast::Expr, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method_name)
            result_type: Type = typed_builtin_result_type(method_spec)
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: result_type}
            if not method_spec.known or method_spec.opcode != "Length" or not typed_builtin_method_call_shape("Text", method_name, arguments, argument_names):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text len method requires no arguments")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            if not text_value.valid or text_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text len method requires a text receiver")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.Length, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_split_lines_value(value: u32, method_spec: EsBuiltin::BuiltinSpec, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue:
            result_type: Type = typed_builtin_result_type(method_spec)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.SplitLines if method_spec.opcode == "SplitLines" else Opcode.SplitLines
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_split_lines_method(receiver_name: sview, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "splitlines receiver has no local binding")
                return invalid
            if state.types[binding].kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "splitlines requires a text receiver")
                return invalid
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method_name)
            if not typed_builtin_method_call_shape("Text", method_name, arguments, argument_names):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "splitlines requires no arguments")
                return invalid
            return lower_text_split_lines_value(state.values[binding], method_spec, pos, state)


        def lower_text_join_expression(receiver_expression: Ast::Expr, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method_name)
            result_type: Type = typed_builtin_result_type(method_spec)
            valid_shape: bool = method_spec.known and method_spec.opcode == "Join" and typed_builtin_method_call_shape("Text", method_name, arguments, argument_names)
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "join method requires one positional darray[sview] value")
                return LoweredValue{valid: false, value: 0, type: result_type}
            separator_value: LoweredValue = lower_expression(receiver_expression, state)
            fields_value: LoweredValue = lower_expression(arguments[0], state)
            valid_fields: bool = fields_value.valid and fields_value.type.kind == TypeKind.Array and fields_value.type.element_kind == TypeKind.Text
            valid_types: bool = separator_value.valid and separator_value.type.kind == TypeKind.Text and valid_fields
            if not valid_types:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "join method requires a text separator receiver and darray[sview] fields")
                return LoweredValue{valid: false, value: 0, type: result_type}
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(fields_value.value)
            state.operand_pool.push(separator_value.value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.Join if method_spec.opcode == "Join" else Opcode.Join
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_split_lines_expression(receiver_expression: Ast::Expr, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method_name)
            result_type: Type = typed_builtin_result_type(method_spec)
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: result_type}
            if not method_spec.known or method_spec.opcode != "SplitLines" or not typed_builtin_method_call_shape("Text", method_name, arguments, argument_names):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "splitlines requires no arguments")
                return invalid
            receiver: LoweredValue = lower_expression(receiver_expression, state)
            if not receiver.valid or receiver.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "splitlines requires a text receiver")
                return invalid
            return lower_text_split_lines_value(receiver.value, method_spec, pos, state)


        def lower_text_boundary_expression(receiver_expression: Ast::Expr, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method_name)
            result_type: Type = typed_builtin_result_type(method_spec)
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: result_type}
            valid_shape: bool = method_spec.known and (method_spec.opcode == "StartsWith" or method_spec.opcode == "EndsWith") and typed_builtin_method_call_shape("Text", method_name, arguments, argument_names)
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "startswith/endswith requires one positional text prefix or suffix")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            boundary_value: LoweredValue = lower_expression(arguments[0], state)
            if not text_value.valid or not boundary_value.valid or text_value.type.kind != TypeKind.Text or boundary_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "startswith/endswith requires text receiver and boundary")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            state.operand_pool.push(boundary_value.value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.StartsWith if method_spec.opcode == "StartsWith" else Opcode.EndsWith
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_boundary_method(receiver_name: sview, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            receiver_pos: Ast::Pos = Ast::Pos{line: pos.line, column: pos.column, offset: pos.offset, end_line: pos.end_line, end_column: pos.end_column, end_offset: pos.end_offset}
            return lower_text_boundary_expression(Expr.Ident(receiver_name, receiver_pos), method_name, arguments, argument_names, pos, state)


        # Lower membership in the collection-first spelling used by shell and
        # Python adapters. Arrays compare exact element values, dictionaries
        # inspect keys, and text accepts either text or a char literal (char
        # literals are text-backed in the runtime model). The operand order is
        # normalized to Contains(needle, collection) for the shared verifier
        # and both execution backends.
        def lower_collection_contains_expression(collection_expression: Ast::Expr, needle_expression: Ast::Expr, spec: EsBuiltin::BuiltinSpec, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = typed_builtin_result_type(spec)
            if not spec.known or spec.opcode != "Contains":
                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "contains registry row has no Contains opcode")
                return LoweredValue{valid: false, value: 0, type: result_type}
            collection: LoweredValue = lower_expression(collection_expression, state)
            if not collection.valid or collection.type.kind not in {TypeKind.Array, TypeKind.Map, TypeKind.Text}:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "contains requires an array, dictionary, or text collection")
                return LoweredValue{valid: false, value: 0, type: result_type}
            element_type: Type = map_key_type(collection.type) if collection.type.kind == TypeKind.Map else array_element_type(collection.type)
            needle: LoweredValue = lower_expression(needle_expression, state)
            valid_needle: bool = needle.valid and (same_type(needle.type, element_type) if collection.type.kind in {TypeKind.Array, TypeKind.Map} else needle.type.kind in {TypeKind.Char, TypeKind.Text})
            if not valid_needle:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "contains needle must match the collection element or dictionary key type")
                return LoweredValue{valid: false, value: 0, type: result_type}
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(needle.value)
            state.operand_pool.push(collection.value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.Contains if spec.opcode == "Contains" else Opcode.Equal
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_collection_contains_method(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            array_receiver: bool = is_array_receiver_expression(receiver_expression, state)
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Array", "contains") if array_receiver else EsBuiltin::typed_builtin_method_spec("Text", "contains")
            result_type: Type = typed_builtin_result_type(method_spec) if method_spec.known else type_from_name("bool")
            valid_shape: bool = typed_builtin_method_call_shape("Array", "contains", arguments, argument_names) if array_receiver else typed_builtin_method_call_shape("Text", "contains", arguments, argument_names)
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "contains method requires one positional needle")
                return LoweredValue{valid: false, value: 0, type: result_type}
            return lower_collection_contains_expression(receiver_expression, arguments[0], method_spec, pos, state)


        def lower_text_remove_boundary_expression(receiver_expression: Ast::Expr, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method_name)
            result_type: Type = typed_builtin_result_type(method_spec)
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: result_type}
            if not method_spec.known or method_spec.opcode != "TextRemoveBoundary" or not typed_builtin_method_call_shape("Text", method_name, arguments, argument_names):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "removeprefix/removesuffix requires one positional text boundary")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            boundary_value: LoweredValue = lower_expression(arguments[0], state)
            if not text_value.valid or not boundary_value.valid or text_value.type.kind != TypeKind.Text or boundary_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "removeprefix/removesuffix requires text receiver and boundary")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            state.operand_pool.push(boundary_value.value)
            result: u32 = fresh_value(state)
            mode: i64 = method_spec.lowering_mode
            opcode: Opcode = Opcode.TextRemoveBoundary if method_spec.opcode == "TextRemoveBoundary" else Opcode.TextRemoveBoundary
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, integer: mode, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_replace_expression(receiver_expression: Ast::Expr, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method_name)
            result_type: Type = typed_builtin_result_type(method_spec)
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: result_type}
            valid_shape: bool = method_spec.known and method_spec.opcode == "TextReplace" and typed_builtin_method_call_shape("Text", method_name, arguments, argument_names)
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text replace method requires old and replacement positional values")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            old_value: LoweredValue = lower_expression(arguments[0], state)
            replacement_value: LoweredValue = lower_expression(arguments[1], state)
            if not text_value.valid or not old_value.valid or not replacement_value.valid or text_value.type.kind != TypeKind.Text or old_value.type.kind != TypeKind.Text or replacement_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text replace method requires text receiver and arguments")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            state.operand_pool.push(old_value.value)
            state.operand_pool.push(replacement_value.value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.TextReplace if method_spec.opcode == "TextReplace" else Opcode.TextReplace
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_replace_method(receiver_name: sview, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            receiver_pos: Ast::Pos = Ast::Pos{line: pos.line, column: pos.column, offset: pos.offset, end_line: pos.end_line, end_column: pos.end_column, end_offset: pos.end_offset}
            return lower_text_replace_expression(Expr.Ident(receiver_name, receiver_pos), method_name, arguments, argument_names, pos, state)


        def lower_text_trim_expression(receiver_expression: Ast::Expr, method_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            method_spec: EsBuiltin::BuiltinSpec = EsBuiltin::typed_builtin_method_spec("Text", method_name)
            result_type: Type = typed_builtin_result_type(method_spec)
