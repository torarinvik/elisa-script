                    signature: LoweredValue = lookup_return_type(state, callee_name)
                    if callee_name == "" or not signature.valid:
                        add_issue(state, LowerIssueKind.UnknownCallee, pos.line, "only known direct function calls are in the initial lowering subset")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    expected_count: u16 = state.function_parameter_counts[callee_index]
                    parameter_start: usize = state.function_parameter_starts[callee_index].usize()
                    operands: mutable darray[u32] = []
                    operand_types: mutable darray[Type] = []
                    provided: mutable darray[bool] = []
                    for parameter in 0..<expected_count.usize() |operands, operand_types, provided|:
                        operands.push(0)
                        operand_types.push(void_ir_type())
                        provided.push(false)
                    valid: mutable bool = true
                    positional: mutable usize = 0
                    saw_named: mutable bool = false
                    for argument_index in 0..<arguments.count |arguments, argument_names, operands, operand_types, provided, valid, positional, saw_named, state, parameter_start, expected_count, pos|:
                        argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                        parameter: mutable usize = expected_count.usize()
                        if argument_name == "":
                            if saw_named:
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "positional call argument cannot follow a named argument")
                            else:
                                parameter <- positional
                                positional <- positional + 1
                        else:
                            saw_named <- true
                            for candidate in 0..<expected_count.usize() |state, parameter_start, argument_name, parameter, expected_count|:
                                parameter <- candidate if parameter == expected_count.usize() and state.function_parameter_names[parameter_start + candidate] == argument_name
                        if parameter >= expected_count.usize():
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "call argument does not name an available function parameter")
                            valid <- false
                        elif provided[parameter]:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "function parameter is supplied more than once")
                            valid <- false
                        else:
                            lowered_argument: LoweredValue = lower_expression_expected(arguments[argument_index], state.function_parameter_types[parameter_start + parameter], state)
                            if lowered_argument.valid:
                                operands[parameter] <- lowered_argument.value
                                operand_types[parameter] <- lowered_argument.type
                                provided[parameter] <- true
                                if not same_type(lowered_argument.type, state.function_parameter_types[parameter_start + parameter]):
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "call argument does not match the function parameter type")
                                    valid <- false
                            else:
                                valid <- false
                    default_scope: usize = state.names.count
                    for parameter in 0..<expected_count.usize() |state, parameter_start, operands, operand_types, provided, valid, pos|:
                        if not provided[parameter]:
                            if state.function_parameter_has_defaults[parameter_start + parameter]:
                                lowered_default: LoweredValue = lower_expression_expected(state.function_parameter_defaults[parameter_start + parameter], state.function_parameter_types[parameter_start + parameter], state)
                                if lowered_default.valid and same_type(lowered_default.type, state.function_parameter_types[parameter_start + parameter]):
                                    operands[parameter] <- lowered_default.value
                                    operand_types[parameter] <- lowered_default.type
                                    provided[parameter] <- true
                                else:
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "default argument does not match the function parameter type") if lowered_default.valid
                                    valid <- false
                            else:
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "call omits a required function parameter")
                                valid <- false
                        if provided[parameter]:
                            state.names.push(state.function_parameter_names[parameter_start + parameter])
                            state.values.push(operands[parameter])
                            state.types.push(operand_types[parameter])
                            state.mutables.push(false)
                    state.names.truncate(default_scope)
                    state.values.truncate(default_scope)
                    state.types.truncate(default_scope)
                    state.mutables.truncate(default_scope)
                    LoweredValue{valid: false, value: 0, type: signature.type} return if not valid
                    effect_start: usize = state.function_effect_starts[callee_index].usize()
                    effect_count: usize = state.function_effect_counts[callee_index].usize()
                    for offset in 0..<effect_count |state, effect_start|:
                        required_effect: sview = state.function_effects[effect_start + offset]
                        covered: bool = active_handler_covers(state.active_handlers, state.handlers, effect_family(required_effect))
                        state.required_effects.push(required_effect) if not covered and not has_text(state.required_effects, required_effect)
                    error_start: usize = state.function_error_starts[callee_index].usize()
                    error_count: usize = state.function_error_counts[callee_index].usize()
                    for error_offset in 0..<error_count |state, error_start, error_count|:
                        required_error: sview = state.function_errors[error_start + error_offset]
                        state.required_errors.push(required_error) if required_error != "" and not has_text(state.required_errors, required_error)
                    result: mutable u32 = 0
                    result <- fresh_value(state) if signature.type.kind != TypeKind.Void
                    operand_start: u32 = state.operand_pool.count.u32()
                    for operand in operands |state|:
                        state.operand_pool.push(operand)
                    state.instructions.push(Instruction{opcode: Opcode.Call, result: result, result_type: signature.type, operand_start: operand_start, operand_count: operands.count.u16(), symbol: callee_name, span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: signature.type}
                _:
                    add_issue(state, LowerIssueKind.UnsupportedExpression, 0, "expression is not in the initial IR lowering subset")
                    return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}


        def lower_expression_expected(expression: Ast::Expr, expected: Type&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            match expression:
                Expr.Array(elements, pos):
                    if elements.count == 0 and expected.kind == TypeKind.Array:
                        result: u32 = fresh_value(state)
                        result_type: Type = owned_ir_type(expected)
                        state.instructions.push(Instruction{opcode: Opcode.MakeArray, result: result, result_type: result_type, operand_start: state.operand_pool.count.u32(), operand_count: 0, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                Expr.DictLit(entries, pos):
                    if entries.count == 0 and expected.kind == TypeKind.Map:
                        result: u32 = fresh_value(state)
                        result_type: Type = owned_ir_type(expected)
                        state.instructions.push(Instruction{opcode: Opcode.MakeMap, result: result, result_type: result_type, operand_start: state.operand_pool.count.u32(), operand_count: 0, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                _:
                    pass
            return lower_expression(expression, state)


        def lower_text_case_value(value: u32, upper: bool, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue:
            result_type: Type = type_from_name("sview")
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.UpperText if upper else Opcode.LowerText
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_case_method(receiver_name: sview, upper: bool, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "text case-conversion receiver has no local binding")
                return invalid
            if state.types[binding].kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "lower/upper requires a text receiver")
                return invalid
            named_argument: mutable bool = false
            for argument_name in argument_names |named_argument|:
                named_argument <- true if argument_name != ""
            if arguments.count != 0 or named_argument:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "lower/upper requires no arguments")
                return invalid
            return lower_text_case_value(state.values[binding], upper, pos, state)


        def lower_text_case_expression(receiver_expression: Ast::Expr, upper: bool, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            named_argument: mutable bool = false
            for argument_name in argument_names |named_argument|:
                named_argument <- true if argument_name != ""
            if arguments.count != 0 or named_argument:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "lower/upper requires no arguments")
                return invalid
            receiver: LoweredValue = lower_expression(receiver_expression, state)
            if not receiver.valid or receiver.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "lower/upper requires a text receiver")
                return invalid
            return lower_text_case_value(receiver.value, upper, pos, state)


        def lower_text_split_lines_value(value: u32, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue:
            result_type: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Text}
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(value)
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.SplitLines, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_split_lines_method(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "splitlines receiver has no local binding")
                return invalid
            if state.types[binding].kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "splitlines requires a text receiver")
                return invalid
            named_argument: mutable bool = false
            for argument_name in argument_names |named_argument|:
                named_argument <- true if argument_name != ""
            if arguments.count != 0 or named_argument:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "splitlines requires no arguments")
                return invalid
            return lower_text_split_lines_value(state.values[binding], pos, state)


        def lower_text_join_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result_type: Type = type_from_name("sview")
            valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "join method requires one positional darray[sview] value")
                return LoweredValue{valid: false, value: 0, type: result_type}
            separator_value: LoweredValue = lower_expression(receiver_expression, state)
            fields_value: LoweredValue = lower_expression(arguments[0], state)
            valid_fields: bool = fields_value.valid and fields_value.type.kind == TypeKind.Array and fields_value.type.element_kind == TypeKind.Text
            valid_types: bool = separator_value.valid and separator_value.type.kind == TypeKind.Text and valid_fields
            if not valid_types:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "join method requires a text separator receiver and darray[sview] fields")
                return LoweredValue{valid: false, value: 0, type: result_type}
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(fields_value.value)
            state.operand_pool.push(separator_value.value)
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.Join, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_split_lines_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            named_argument: mutable bool = false
            for argument_name in argument_names |named_argument|:
                named_argument <- true if argument_name != ""
            if arguments.count != 0 or named_argument:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "splitlines requires no arguments")
                return invalid
            receiver: LoweredValue = lower_expression(receiver_expression, state)
            if not receiver.valid or receiver.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "splitlines requires a text receiver")
                return invalid
            return lower_text_split_lines_value(receiver.value, pos, state)


        def lower_text_boundary_expression(receiver_expression: Ast::Expr, starts: bool, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
            valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "startswith/endswith requires one positional text prefix or suffix")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            boundary_value: LoweredValue = lower_expression(arguments[0], state)
            if not text_value.valid or not boundary_value.valid or text_value.type.kind != TypeKind.Text or boundary_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "startswith/endswith requires text receiver and boundary")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            state.operand_pool.push(boundary_value.value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.StartsWith if starts else Opcode.EndsWith
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: type_from_name("bool"), operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: type_from_name("bool")}


        def lower_text_boundary_method(receiver_name: sview, starts: bool, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            receiver_pos: Ast::Pos = Ast::Pos{line: pos.line, column: pos.column, offset: pos.offset, end_line: pos.end_line, end_column: pos.end_column, end_offset: pos.end_offset}
            return lower_text_boundary_expression(Expr.Ident(receiver_name, receiver_pos), starts, arguments, argument_names, pos, state)


        def lower_text_remove_boundary_expression(receiver_expression: Ast::Expr, starts: bool, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("sview")}
            valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "removeprefix/removesuffix requires one positional text boundary")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            boundary_value: LoweredValue = lower_expression(arguments[0], state)
            if not text_value.valid or not boundary_value.valid or text_value.type.kind != TypeKind.Text or boundary_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "removeprefix/removesuffix requires text receiver and boundary")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            state.operand_pool.push(boundary_value.value)
            result: u32 = fresh_value(state)
            mode: i64 = 0 if starts else 1
            state.instructions.push(Instruction{opcode: Opcode.TextRemoveBoundary, result: result, result_type: type_from_name("sview"), integer: mode, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: type_from_name("sview")}


        def lower_text_replace_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("sview")}
            valid_shape: bool = arguments.count == 2 and (argument_names.count == 0 or (argument_names.count == 2 and argument_names[0] == "" and argument_names[1] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text replace method requires old and replacement positional values")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            old_value: LoweredValue = lower_expression(arguments[0], state)
            replacement_value: LoweredValue = lower_expression(arguments[1], state)
            if not text_value.valid or not old_value.valid or not replacement_value.valid or text_value.type.kind != TypeKind.Text or old_value.type.kind != TypeKind.Text or replacement_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text replace method requires text receiver and arguments")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            state.operand_pool.push(old_value.value)
            state.operand_pool.push(replacement_value.value)
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.TextReplace, result: result, result_type: type_from_name("sview"), operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: type_from_name("sview")}


        def lower_text_replace_method(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            receiver_pos: Ast::Pos = Ast::Pos{line: pos.line, column: pos.column, offset: pos.offset, end_line: pos.end_line, end_column: pos.end_column, end_offset: pos.end_offset}
            return lower_text_replace_expression(Expr.Ident(receiver_name, receiver_pos), arguments, argument_names, pos, state)


        def lower_text_trim_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&, mode: i64) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("sview")}
            valid_shape: bool = arguments.count == 0 and argument_names.count == 0
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "strip/trim/lstrip/rstrip method requires no arguments")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            if not text_value.valid or text_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "strip/trim method requires a text receiver")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.TrimText, result: result, result_type: type_from_name("sview"), integer: mode, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: type_from_name("sview")}


        def lower_text_trim_method(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&, mode: i64) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            receiver_pos: Ast::Pos = Ast::Pos{line: pos.line, column: pos.column, offset: pos.offset, end_line: pos.end_line, end_column: pos.end_column, end_offset: pos.end_offset}
            return lower_text_trim_expression(Expr.Ident(receiver_name, receiver_pos), arguments, argument_names, pos, state, mode)


        def lower_text_split_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: Type{kind: TypeKind.Array, element_kind: TypeKind.Text}}
            valid_names: bool = argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == "")
            valid_shape: bool = (arguments.count == 0 and argument_names.count == 0) or (arguments.count == 1 and valid_names)
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "split method requires zero arguments or one positional text separator")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            if not text_value.valid or text_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "split method requires a text receiver")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            mode: i64 = 1 if arguments.count == 0 else 0
            if arguments.count == 1:
                separator_value: LoweredValue = lower_expression(arguments[0], state)
                if not separator_value.valid or separator_value.type.kind != TypeKind.Text:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "split method separator must be text")
                    return invalid
                state.operand_pool.push(separator_value.value)
            result: u32 = fresh_value(state)
            result_type: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Text}
            state.instructions.push(Instruction{opcode: Opcode.Split, result: result, result_type: result_type, integer: mode, operand_start: operand_start, operand_count: 1 if arguments.count == 0 else 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_split_method(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            receiver_pos: Ast::Pos = Ast::Pos{line: pos.line, column: pos.column, offset: pos.offset, end_line: pos.end_line, end_column: pos.end_column, end_offset: pos.end_offset}
            return lower_text_split_expression(Expr.Ident(receiver_name, receiver_pos), arguments, argument_names, pos, state)


        # Lower Python's typed dictionary `mapping.keys()` view as the existing
        # insertion-ordered MapKeys array operation.  The receiver is evaluated
        # once, and sets are rejected even though they share the map payload
        # representation internally.
        def lower_map_keys_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            if arguments.count != 0 or argument_names.count != 0:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "keys method requires no arguments")
                return invalid
            collection: LoweredValue = lower_expression(receiver_expression, state)
            if not collection.valid or collection.type.kind != TypeKind.Map or collection.type.name == "__elisascript_set":
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "keys method requires a dictionary receiver")
                return invalid
            key_type: Type = map_key_type(collection.type)
            result_type: Type = array_ir_type(key_type)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.MapKeys, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Lower Python's typed dictionary `mapping.values()` view as an owned
        # insertion-ordered array through the dedicated MapValues operation.
        # The full value descriptor is retained, including bounded nested maps
        # and arrays, so no element type is erased at the scripting boundary.
        def lower_map_values_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            if arguments.count != 0 or argument_names.count != 0:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "values method requires no arguments")
                return invalid
            collection: LoweredValue = lower_expression(receiver_expression, state)
            if not collection.valid or collection.type.kind != TypeKind.Map or collection.type.name == "__elisascript_set":
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "values method requires a dictionary receiver")
                return invalid
            value_type: mutable Type = map_value_type(collection.type)
            result_type: Type = array_ir_type(value_type)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.MapValues, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Lower Python's `text.count(substring)` as a typed non-overlapping
        # occurrence count. Empty substrings count boundaries, matching the
        # familiar Python rule while keeping the result in the exact `usize`
        # collection-count domain used by Elisascript queries.
        def lower_collection_count_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("usize")}
            valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "count method requires one positional value")
                return invalid
            collection: LoweredValue = lower_expression(receiver_expression, state)
            if not collection.valid or collection.type.kind != TypeKind.Text and collection.type.kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "count method requires a text or array receiver")
                return invalid
            element_type: Type = type_from_name("sview") if collection.type.kind == TypeKind.Text else array_element_type(collection.type)
            needle: LoweredValue = lower_expression_expected(arguments[0], element_type, state)
            if not needle.valid or not same_type(needle.type, element_type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "count value must match the receiver element type")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            state.operand_pool.push(needle.value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.TextCount if collection.type.kind == TypeKind.Text else Opcode.ArrayCount
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: type_from_name("usize"), operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: type_from_name("usize")}


        def lower_text_count_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("usize")}
            valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text count method requires one positional substring")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            needle_value: LoweredValue = lower_expression(arguments[0], state)
            if not text_value.valid or not needle_value.valid or text_value.type.kind != TypeKind.Text or needle_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text count method requires text receiver and substring")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            state.operand_pool.push(needle_value.value)
            result: u32 = fresh_value(state)
            result_type: Type = type_from_name("usize")
            state.instructions.push(Instruction{opcode: Opcode.TextCount, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Lower Python's `text.find(substring)` and `array.find(element)` with an
        # explicit signed `i64` result. A miss is represented by -1, matching the
        # scripting search contract; `array.index(element)` shares this first-match
        # operation while restricting its receiver to arrays.
        def lower_collection_find_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&, array_only: bool) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("i64")}
            valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "find/index method requires one positional value")
                return invalid
            collection: LoweredValue = lower_expression(receiver_expression, state)
            if not collection.valid or collection.type.kind != TypeKind.Text and collection.type.kind != TypeKind.Array or array_only and collection.type.kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "find requires a text or array receiver; index requires an array receiver")
                return invalid
            element_type: Type = type_from_name("sview") if collection.type.kind == TypeKind.Text else array_element_type(collection.type)
            needle: LoweredValue = lower_expression_expected(arguments[0], element_type, state)
            if not needle.valid or not same_type(needle.type, element_type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "find/index value must match the receiver element type")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            state.operand_pool.push(needle.value)
            result: u32 = fresh_value(state)
            opcode: Opcode = Opcode.TextFind if collection.type.kind == TypeKind.Text else Opcode.ArrayFind
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: type_from_name("i64"), operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: type_from_name("i64")}


        def lower_text_find_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("i64")}
            valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text find method requires one positional substring")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            needle_value: LoweredValue = lower_expression(arguments[0], state)
            if not text_value.valid or not needle_value.valid or text_value.type.kind != TypeKind.Text or needle_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text find method requires text receiver and substring")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            state.operand_pool.push(needle_value.value)
            result: u32 = fresh_value(state)
            result_type: Type = type_from_name("i64")
            state.instructions.push(Instruction{opcode: Opcode.TextFind, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_rfind_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("i64")}
            valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == ""))
            if not valid_shape:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text rfind method requires one positional substring")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            needle_value: LoweredValue = lower_expression(arguments[0], state)
            if not text_value.valid or not needle_value.valid or text_value.type.kind != TypeKind.Text or needle_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text rfind method requires text receiver and substring")
                return invalid
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            state.operand_pool.push(needle_value.value)
            result: u32 = fresh_value(state)
            result_type: Type = type_from_name("i64")
            state.instructions.push(Instruction{opcode: Opcode.TextRFind, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_text_predicate_expression(receiver_expression: Ast::Expr, predicate: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
            if arguments.count != 0 or argument_names.count != 0:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text predicate method requires no arguments")
                return invalid
            text_value: LoweredValue = lower_expression(receiver_expression, state)
            if not text_value.valid or text_value.type.kind != TypeKind.Text:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "text predicate method requires a text receiver")
                return invalid
            mode: mutable i64 = 0
            mode <- 1 if predicate == "isalpha"
            mode <- 2 if predicate == "isalnum"
            mode <- 3 if predicate == "isspace"
            mode <- 4 if predicate == "islower"
            mode <- 5 if predicate == "isupper"
            mode <- 6 if predicate == "isascii"
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(text_value.value)
            result: u32 = fresh_value(state)
            result_type: Type = type_from_name("bool")
            state.instructions.push(Instruction{opcode: Opcode.TextPredicate, result: result, result_type: result_type, integer: mode, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        # Lower Python's typed dictionary default lookup.  Elisascript keeps the
        # fallback lazy by routing the method through the same IndexValid CFG used
        # by `get mapping[key] else fallback`; a missing key therefore never
        # evaluates the ordinary index path, and both branches merge one exact
        # static value type.
        def lower_collection_get(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "dictionary lookup receiver has no local binding")
                return invalid
            if state.types[binding].kind != TypeKind.Map or state.types[binding].name == "__elisascript_set":
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "get requires a dictionary receiver")
                return invalid
            named_argument: mutable bool = false
            for argument_name in argument_names |named_argument|:
                named_argument <- true if argument_name != ""
            if arguments.count != 2 or named_argument:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "get requires a key and one positional default value")
                return invalid
            receiver_pos: Ast::Pos = Ast::Pos{line: pos.line, column: pos.column, offset: pos.offset, end_line: pos.end_line, end_column: pos.end_column, end_offset: pos.end_offset}
            receiver: Ast::Expr = Expr.Ident(receiver_name, receiver_pos)
            return lower_checked_index(receiver, arguments[0], arguments[1], pos, state)


        # Lower Python-style `values.pop()`/`values.pop(index)` as a typed pair
        # of semantic array operations. PopArrayValue produces the removed
        # element (and raises IndexOutOfBounds for an empty/out-of-range array);
        # PopArray produces the shortened view that rebinds the mutable SSA name.
        # Keeping the two results separate lets expression and statement forms
        # share exactly the same bounds and ownership behavior without
        # introducing a tuple type into the initial IR.
        def lower_collection_copy_expression(receiver_expression: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            if arguments.count != 0 or argument_names.count != 0:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "copy method requires no arguments")
                return invalid
            collection: LoweredValue = lower_expression(receiver_expression, state)
            if not collection.valid or collection.type.kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "copy method requires an array receiver")
                return invalid
            result: u32 = fresh_value(state)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection.value)
            state.instructions.push(Instruction{opcode: Opcode.CopyArray, result: result, result_type: collection.type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: collection.type}


        def lower_collection_insert(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "collection mutation receiver has no local binding")
                return true
            if state.types[binding].kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "insert requires an array receiver")
                return true
            if not state.mutables[binding]:
                add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "insert requires a mutable array binding")
                return true
            named_argument: mutable bool = false
            for argument_name in argument_names |named_argument|:
                named_argument <- true if argument_name != ""
            if arguments.count != 2 or named_argument:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "insert requires an integer index and one positional element")
                return true
            index: LoweredValue = lower_expression(arguments[0], state)
            element_type: Type = array_element_type(state.types[binding])
            element: LoweredValue = lower_expression_expected(arguments[1], element_type, state)
            if not index.valid or not element.valid:
                return true
            if index.type.kind != TypeKind.Int:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "insert index must have an integer type")
                return true
            if not same_type(element.type, element_type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "inserted value must match the array element type")
                return true
            result: u32 = fresh_value(state)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(state.values[binding])
            state.operand_pool.push(index.value)
            state.operand_pool.push(element.value)
            state.instructions.push(Instruction{opcode: Opcode.InsertArray, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
            state.values[binding] <- result
            return true


        def lower_collection_reverse(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "collection mutation receiver has no local binding")
                return true
            if state.types[binding].kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "reverse requires an array receiver")
                return true
            if not state.mutables[binding]:
                add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "reverse requires a mutable array binding")
                return true
            named_argument: mutable bool = false
            for argument_name in argument_names |named_argument|:
                named_argument <- true if argument_name != ""
            if arguments.count != 0 or named_argument:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "reverse requires no arguments")
                return true
            result: u32 = fresh_value(state)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(state.values[binding])
            state.instructions.push(Instruction{opcode: Opcode.ReverseArray, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            state.values[binding] <- result
            return true


        def lower_collection_pop(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "collection mutation receiver has no local binding")
                return invalid
            if state.types[binding].kind == TypeKind.Map:
                if state.types[binding].name == "__elisascript_set":
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "pop requires a dictionary receiver")
                    return invalid
                if not state.mutables[binding]:
                    add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "pop requires a mutable dictionary binding")
                    return invalid
                named_argument: mutable bool = false
                for argument_name in argument_names |named_argument|:
                    named_argument <- true if argument_name != ""
                if arguments.count < 1 or arguments.count > 2 or named_argument:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "dictionary pop requires one key and an optional positional default value")
                    return invalid
                key_type: Type = map_key_type(state.types[binding])
                key: LoweredValue = lower_expression_expected(arguments[0], key_type, state)
                if not key.valid:
                    return invalid
                if not same_type(key.type, key_type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "popped key must match the dictionary key type")
                    return invalid
                value_type: Type = map_value_type(state.types[binding])
                default_value: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: value_type}
                if arguments.count == 2:
                    default_value <- lower_expression_expected(arguments[1], value_type, state)
                    if not default_value.valid:
                        return invalid
                    if not same_type(default_value.type, value_type):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "pop default must match the dictionary value type")
                        return invalid
                collection: u32 = state.values[binding]
                popped: u32 = fresh_value(state)
                popped_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(collection)
                state.operand_pool.push(key.value)
                state.operand_pool.push(default_value.value) if default_value.valid
                state.instructions.push(Instruction{opcode: Opcode.PopMapValue, result: popped, result_type: value_type, operand_start: popped_start, operand_count: 3 if default_value.valid else 2, span: ir_span(pos)})
                shortened: u32 = fresh_value(state)
                shortened_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(collection)
                state.operand_pool.push(key.value)
                state.instructions.push(Instruction{opcode: Opcode.PopMap, result: shortened, result_type: state.types[binding], operand_start: shortened_start, operand_count: 2, span: ir_span(pos)})
                state.values[binding] <- shortened
                return LoweredValue{valid: true, value: popped, type: value_type}
            if state.types[binding].kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "pop requires an array receiver")
                return invalid
            if not state.mutables[binding]:
                add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "pop requires a mutable array binding")
                return invalid
            named_argument: mutable bool = false
            for argument_name in argument_names |named_argument|:
                named_argument <- true if argument_name != ""
            if arguments.count > 1 or named_argument:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "array pop requires an optional positional integer index")
                return invalid

            collection: u32 = state.values[binding]
            element_type: Type = array_element_type(state.types[binding])
            index: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("i64")}
            if arguments.count == 1:
                index <- lower_expression(arguments[0], state)
                if not index.valid:
                    return invalid
                if index.type.kind != TypeKind.Int:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "array pop index must have an integer type")
                    return invalid
            element: u32 = fresh_value(state)
            element_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection)
            state.operand_pool.push(index.value) if index.valid
            state.instructions.push(Instruction{opcode: Opcode.PopArrayValue, result: element, result_type: element_type, operand_start: element_start, operand_count: 2 if index.valid else 1, span: ir_span(pos)})
            shortened: u32 = fresh_value(state)
            shortened_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection)
            state.operand_pool.push(index.value) if index.valid
            state.instructions.push(Instruction{opcode: Opcode.PopArray, result: shortened, result_type: state.types[binding], operand_start: shortened_start, operand_count: 2 if index.valid else 1, span: ir_span(pos)})
            state.values[binding] <- shortened
            return LoweredValue{valid: true, value: element, type: element_type}


        # Lower Python's typed dictionary `setdefault(key, default)` as a pair
        # of semantic operations.  The value operation returns the existing
        # value (or the default when the key is absent), while the map operation
        # rebinds the mutable SSA name only when insertion is needed.  Keeping
        # these results separate avoids introducing a tuple type into the IR and
        # makes expression and statement forms share one exact evaluation.
        def lower_collection_setdefault(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            invalid: LoweredValue = LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "collection mutation receiver has no local binding")
                return invalid
            if state.types[binding].kind != TypeKind.Map or state.types[binding].name == "__elisascript_set":
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "setdefault requires a dictionary receiver")
                return invalid
            if not state.mutables[binding]:
                add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "setdefault requires a mutable dictionary binding")
                return invalid
            named_argument: mutable bool = false
            for argument_name in argument_names |named_argument|:
                named_argument <- true if argument_name != ""
            if arguments.count != 2 or named_argument:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "setdefault requires a key and one positional default value")
                return invalid
            key_type: Type = map_key_type(state.types[binding])
            key: LoweredValue = lower_expression_expected(arguments[0], key_type, state)
            if not key.valid:
                return invalid
            if not same_type(key.type, key_type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "setdefault key must match the dictionary key type")
                return invalid
            value_type: Type = map_value_type(state.types[binding])
            default_value: LoweredValue = lower_expression_expected(arguments[1], value_type, state)
            if not default_value.valid:
                return invalid
            if not same_type(default_value.type, value_type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "setdefault default must match the dictionary value type")
                return invalid
            collection: u32 = state.values[binding]
            value_result: u32 = fresh_value(state)
            value_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection)
            state.operand_pool.push(key.value)
            state.operand_pool.push(default_value.value)
            state.instructions.push(Instruction{opcode: Opcode.SetDefaultMapValue, result: value_result, result_type: value_type, operand_start: value_start, operand_count: 3, span: ir_span(pos)})
            map_result: u32 = fresh_value(state)
            map_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(collection)
            state.operand_pool.push(key.value)
            state.operand_pool.push(default_value.value)
            state.instructions.push(Instruction{opcode: Opcode.SetDefaultMap, result: map_result, result_type: state.types[binding], operand_start: map_start, operand_count: 3, span: ir_span(pos)})
            state.values[binding] <- map_result
            return LoweredValue{valid: true, value: value_result, type: value_type}


        def lower_collection_sort(receiver_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "sort receiver has no local binding")
                return true
            if state.types[binding].kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "sort requires an array receiver")
                return true
            if not state.mutables[binding]:
                add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "sort requires a mutable array binding")
                return true
            named_argument: mutable bool = false
            for argument_name in argument_names |named_argument|:
                named_argument <- true if argument_name != ""
            if arguments.count != 0 or named_argument:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "sort requires no arguments")
                return true
            element_type: Type = array_element_type(state.types[binding])
            if element_type.kind not in {TypeKind.Bool, TypeKind.Int, TypeKind.Float, TypeKind.Char, TypeKind.Text}:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "sort requires an array of bool, integer, float, char, or text values")
                return true
            result: u32 = fresh_value(state)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(state.values[binding])
            state.instructions.push(Instruction{opcode: Opcode.SortArray, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
            state.values[binding] <- result
            return true


        def lower_collection_mutation(expression: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            receiver_name: mutable sview = ""
            method_name: mutable sview = ""
            arguments: mutable darray[Ast::Expr] = []
            argument_names: mutable darray[sview] = []
            match expression:
                Expr.Call(Expr.Field(Expr.Ident(name, ident_pos), method, field_pos), call_arguments, call_argument_names, call_pos):
                    if method == "push" or method == "append" or method == "pop" or method == "setdefault" or method == "extend" or method == "add" or method == "clear" or method == "remove" or method == "reverse" or method == "insert" or method == "sort" or method == "update":
                        receiver_name <- name
                        method_name <- method
                        arguments.extend(call_arguments)
                        argument_names.extend(call_argument_names)
                _:
                    pass
            false return if receiver_name == ""
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "collection mutation receiver has no local binding")
                return true
            if method_name == "pop":
                _ = lower_collection_pop(receiver_name, arguments, argument_names, pos, state)
                return true
            if method_name == "setdefault":
                _ = lower_collection_setdefault(receiver_name, arguments, argument_names, pos, state)
                return true
            if method_name == "reverse":
                _ = lower_collection_reverse(receiver_name, arguments, argument_names, pos, state)
                return true
            if method_name == "insert":
                _ = lower_collection_insert(receiver_name, arguments, argument_names, pos, state)
                return true
            if method_name == "sort":
                _ = lower_collection_sort(receiver_name, arguments, argument_names, pos, state)
                return true
            if method_name == "clear":
                if state.types[binding].kind != TypeKind.Map and state.types[binding].kind != TypeKind.Array:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "clear requires an array, map, or set receiver")
                    return true
                if not state.mutables[binding]:
                    add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "clear requires a mutable array, map, or set binding")
                    return true
                named_argument: mutable bool = false
                for argument_name in argument_names |named_argument|:
                    named_argument <- true if argument_name != ""
                if arguments.count != 0 or named_argument:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "clear requires no arguments")
                    return true
                result: u32 = fresh_value(state)
                if state.types[binding].kind == TypeKind.Map:
                    state.instructions.push(Instruction{opcode: Opcode.MakeMap, result: result, result_type: state.types[binding], operand_start: state.operand_pool.count.u32(), operand_count: 0, span: ir_span(pos)})
                else:
                    state.instructions.push(Instruction{opcode: Opcode.MakeArray, result: result, result_type: state.types[binding], operand_start: state.operand_pool.count.u32(), operand_count: 0, span: ir_span(pos)})
                state.values[binding] <- result
                return true
            if method_name == "update":
                if state.types[binding].kind != TypeKind.Map or state.types[binding].name == "__elisascript_set":
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "update requires a dictionary receiver")
                    return true
                if not state.mutables[binding]:
                    add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "update requires a mutable dictionary binding")
                    return true
                named_argument: mutable bool = false
                for argument_name in argument_names |named_argument|:
                    named_argument <- true if argument_name != ""
                if arguments.count != 1 or named_argument:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "update requires exactly one positional dictionary")
                    return true
                other: LoweredValue = lower_expression_expected(arguments[0], state.types[binding], state)
                if not other.valid:
                    return true
                if not same_type(other.type, state.types[binding]):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "updated dictionary must have the receiver's exact type")
                    return true
                result: u32 = fresh_value(state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(state.values[binding])
                state.operand_pool.push(other.value)
                state.instructions.push(Instruction{opcode: Opcode.Concat, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                state.values[binding] <- result
                return true
            if method_name == "remove":
                if state.types[binding].kind == TypeKind.Array:
                    if not state.mutables[binding]:
                        add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "remove requires a mutable array binding")
                        return true
                    named_argument: mutable bool = false
                    for argument_name in argument_names |named_argument|:
                        named_argument <- true if argument_name != ""
                    if arguments.count != 1 or named_argument:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "remove requires exactly one positional element")
                        return true
                    element_type: Type = array_element_type(state.types[binding])
                    element: LoweredValue = lower_expression_expected(arguments[0], element_type, state)
                    if not element.valid:
                        return true
                    if not same_type(element.type, element_type):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "removed value must match the array element type")
                        return true
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(state.values[binding])
                    state.operand_pool.push(element.value)
                    state.instructions.push(Instruction{opcode: Opcode.RemoveArray, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                    state.values[binding] <- result
                    return true
                if state.types[binding].kind != TypeKind.Map:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "remove requires an array, map, or set receiver")
                    return true
                if not state.mutables[binding]:
                    add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "remove requires a mutable map or set binding")
                    return true
                named_argument: mutable bool = false
                for argument_name in argument_names |named_argument|:
                    named_argument <- true if argument_name != ""
                if arguments.count != 1 or named_argument:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "remove requires exactly one positional element")
                    return true
                result: u32 = fresh_value(state)
                element_type: Type = map_key_type(state.types[binding])
                element: LoweredValue = lower_expression_expected(arguments[0], element_type, state)
                if element.valid and not same_type(element.type, element_type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "removed key must match the map or set key type")
                    return true
                if not element.valid:
                    return true
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(state.values[binding])
                state.operand_pool.push(element.value)
                state.instructions.push(Instruction{opcode: Opcode.DeleteIndex, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                state.values[binding] <- result
                return true
            if method_name == "add":
                if state.types[binding].kind != TypeKind.Map or state.types[binding].name != "__elisascript_set":
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "add requires a set receiver")
                    return true
                if not state.mutables[binding]:
                    add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "add requires a mutable set binding")
                    return true
                named_argument: mutable bool = false
                for argument_name in argument_names |named_argument|:
                    named_argument <- true if argument_name != ""
                if arguments.count != 1 or named_argument:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "add requires exactly one positional element")
                    return true
                element_type: Type = map_key_type(state.types[binding])
                element: LoweredValue = lower_expression_expected(arguments[0], element_type, state)
                if element.valid and not same_type(element.type, element_type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "added value must match the set element type")
                    return true
                if element.valid:
                    marker_type: Type = type_from_name("bool")
                    marker: LoweredValue = emit_constant(state, marker_type, 0, "", "", true, ir_span(pos))
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(state.values[binding])
                    state.operand_pool.push(element.value)
                    state.operand_pool.push(marker.value)
                    state.instructions.push(Instruction{opcode: Opcode.SetIndex, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
                    state.values[binding] <- result
                return true
            if state.types[binding].kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "push, append, pop, setdefault, extend, remove, reverse, insert, sort, and update require an array or dictionary receiver")
                return true
            if not state.mutables[binding]:
                add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "push, append, pop, extend, remove, reverse, and sort require a mutable array binding")
                return true
            named_argument: mutable bool = false
            for argument_name in argument_names |named_argument|:
                named_argument <- true if argument_name != ""
            if arguments.count != 1 or named_argument:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "push, append, pop, extend, and reverse require exactly one positional argument")
                return true

            appended: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: state.types[binding]}
            if method_name == "extend":
                appended <- lower_expression_expected(arguments[0], state.types[binding], state)
                if appended.valid and not same_type(appended.type, state.types[binding]):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "extend argument must have the receiver's exact array type")
                    return true
            else:
                element_type: Type = array_element_type(state.types[binding])
                element: LoweredValue = lower_expression_expected(arguments[0], element_type, state)
                if element.valid and not same_type(element.type, element_type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "pushed value must match the array element type")
                    return true
                if element.valid:
                    singleton: u32 = fresh_value(state)
                    singleton_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(element.value)
                    state.instructions.push(Instruction{opcode: Opcode.MakeArray, result: singleton, result_type: state.types[binding], operand_start: singleton_start, operand_count: 1, span: ir_span(pos)})
                    appended <- LoweredValue{valid: true, value: singleton, type: state.types[binding]}
            if appended.valid:
                result: u32 = fresh_value(state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(state.values[binding])
                state.operand_pool.push(appended.value)
                state.instructions.push(Instruction{opcode: Opcode.Concat, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                state.values[binding] <- result
            return true


        def lower_range_for(variables: darray[sview]&, iterable: Ast::Expr, body: darray[Ast::Stmt]&, return_type: Type, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            range_low: mutable Ast::Expr = Expr.Absent
            range_high: mutable Ast::Expr = Expr.Absent
            step_expression: mutable Ast::Expr = Expr.Absent
            range_operator: mutable TokenKind = TokenKind.Range
            have_range: mutable bool = false
            have_step: mutable bool = false
            match iterable:
                Expr.Binary(low, operator, high, range_pos):
                    if operator in {TokenKind.RangeLt, TokenKind.RangeLe, TokenKind.RangeGt}:
                        range_low <- low
                        range_high <- high
                        range_operator <- operator
                        have_range <- true
                    elif operator == TokenKind.Range:
                        match low:
                            Expr.Binary(inner_low, inner_operator, inner_high, inner_pos):
                                if inner_operator in {TokenKind.RangeLt, TokenKind.RangeLe, TokenKind.RangeGt}:
                                    range_low <- inner_low
                                    range_high <- inner_high
                                    range_operator <- inner_operator
                                    step_expression <- high
                                    have_range <- true
                                    have_step <- true
                            _:
                                pass
                _:
                    pass
            false return if not have_range
            if variables.count != 1:
                add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "range for lowering requires exactly one binder")
                return true

            low: LoweredValue = lower_expression(range_low, state)
            if not low.valid:
                return true
            high: LoweredValue = lower_expression_expected(range_high, low.type, state)
            if not high.valid:
                return true
            if low.type.kind != TypeKind.Int or not same_type(low.type, high.type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range bounds must have the same integer type")
                return true
            step: mutable LoweredValue = emit_constant(state, low.type, 1, "", "", false, ir_span(pos))
            if have_step:
                positive_literal: mutable bool = false
                match step_expression:
                    Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                        positive_literal <- value > 0
                    _:
                        pass
                if not positive_literal:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range stride must be a positive integer constant")
                    return true
                step <- lower_expression_expected(step_expression, low.type, state)
                if not step.valid or not same_type(step.type, low.type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range stride must match the bound type")
                    return true

            header_block: u32 = fresh_block(state)
            body_block: u32 = fresh_block(state)
            latch_block: u32 = fresh_block(state)
            exit_block: u32 = fresh_block(state)
            assigned_names: mutable darray[sview] = []
            collect_assigned_names(body, assigned_names)
            include_mutable_element_owners(state, assigned_names)
            carried_indices: mutable darray[u32] = []
            for assigned_name in assigned_names |state, carried_indices|:
                assigned_index: usize = binding_index(state, assigned_name)
                carried_indices.push(assigned_index.u32()) if assigned_index < state.names.count
            context_start: u32 = state.loop_carried_indices.count.u32()
            state.loop_carried_indices.extend(carried_indices)
            state.loop_context_starts.push(context_start)
            state.loop_context_counts.push(carried_indices.count.u16())
            state.loop_handler_depths.push(state.active_handlers.count.u32())
            context: usize = state.loop_context_counts.count - 1

            entry_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.edge_arg_pool.push(low.value)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: entry_args.start, edge0_arg_count: entry_args.count + 1, span: ir_span(pos)}
            finish_block(state)

            header_values: mutable darray[u32] = []
            latch_values: mutable darray[u32] = []
            exit_values: mutable darray[u32] = []
            for binding_u32 in carried_indices |state, header_block, latch_block, exit_block, header_values, latch_values, exit_values|:
                binding: usize = binding_u32.usize()
                header_value: u32 = fresh_value(state)
                latch_value: u32 = fresh_value(state)
                exit_value: u32 = fresh_value(state)
                state.pending_parameter_blocks.push(header_block)
                state.pending_parameters.push(Parameter{value: header_value, type: state.types[binding], name: state.names[binding]})
                state.pending_parameter_blocks.push(latch_block)
                state.pending_parameters.push(Parameter{value: latch_value, type: state.types[binding], name: state.names[binding]})
                state.pending_parameter_blocks.push(exit_block)
                state.pending_parameters.push(Parameter{value: exit_value, type: state.types[binding], name: state.names[binding]})
                header_values.push(header_value)
                latch_values.push(latch_value)
                exit_values.push(exit_value)
            counter: u32 = fresh_value(state)
            state.pending_parameter_blocks.push(header_block)
            state.pending_parameters.push(Parameter{value: counter, type: low.type, name: "range-counter"})
            for offset in 0..<carried_indices.count |state, carried_indices, header_values|:
                state.values[carried_indices[offset].usize()] <- header_values[offset]

            state.current_block <- header_block
            state.terminated <- false
            comparison: Opcode = Opcode.Greater if range_operator == TokenKind.RangeGt else (Opcode.LessEqual if range_operator == TokenKind.RangeLe else Opcode.Less)
            condition: u32 = fresh_value(state)
            condition_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(counter)
            state.operand_pool.push(high.value)
            state.instructions.push(Instruction{opcode: comparison, result: condition, result_type: type_from_name("bool"), operand_start: condition_start, operand_count: 2, span: ir_span(pos)})
            exit_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition, operand_count: 1, target0: body_block, target1: exit_block, target_count: 2, edge1_arg_start: exit_args.start, edge1_arg_count: exit_args.count, span: ir_span(pos)}
            finish_block(state)

            outer_scope: usize = state.names.count
            state.structured_depth <- state.structured_depth + 1
            state.break_targets.push(exit_block)
            state.continue_targets.push(latch_block)
            state.current_block <- body_block
            state.terminated <- false
            state.names.push(variables[0])
            state.values.push(counter)
            state.types.push(low.type)
            state.mutables.push(false)
            for nested in body |state, return_type|:
                lower_statement(nested, return_type, state)
            if not state.terminated:
                body_args: (start: u32, count: u16) = append_context_arguments(state, context)
                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: latch_block, target_count: 1, edge0_arg_start: body_args.start, edge0_arg_count: body_args.count, span: ir_span(pos)}
            finish_block(state)
            _ = state.break_targets.pop()
            _ = state.continue_targets.pop()
            state.names.truncate(outer_scope)
            state.values.truncate(outer_scope)
            state.types.truncate(outer_scope)
            state.mutables.truncate(outer_scope)
            for offset in 0..<carried_indices.count |state, carried_indices, latch_values|:
                state.values[carried_indices[offset].usize()] <- latch_values[offset]

            state.current_block <- latch_block
            state.terminated <- false
            next_counter: u32 = fresh_value(state)
            step_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(counter)
            state.operand_pool.push(step.value)
            step_opcode: Opcode = Opcode.Subtract if range_operator == TokenKind.RangeGt else Opcode.Add
            state.instructions.push(Instruction{opcode: step_opcode, result: next_counter, result_type: low.type, operand_start: step_start, operand_count: 2, span: ir_span(pos)})
            backedge_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.edge_arg_pool.push(next_counter)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: backedge_args.start, edge0_arg_count: backedge_args.count + 1, span: ir_span(pos)}
            finish_block(state)

            state.structured_depth <- state.structured_depth - 1
            for offset in 0..<carried_indices.count |state, carried_indices, exit_values|:
                state.values[carried_indices[offset].usize()] <- exit_values[offset]
            _ = state.loop_context_starts.pop()
            _ = state.loop_context_counts.pop()
            _ = state.loop_handler_depths.pop()
            state.loop_carried_indices <- state.loop_carried_indices.truncate(context_start.usize())
            state.current_block <- exit_block
            state.terminated <- false
            return true


        def decimal_pattern_integer(text: sview, valid: mutable bool&) -> i64:
            valid <- false
            0 return if sview_len(text) == 0
            index: mutable usize = 0
            negative: mutable bool = false
            if sview_at(text, 0) == 45:
                negative <- true
                index <- 1
            0 return if index == sview_len(text)
            value: mutable i64 = 0
            while index < sview_len(text) |text, value, valid|:
                byte: u8 = sview_at(text, index)
                if byte < 48 or byte > 57:
                    return 0
                value <- value * 10 + (byte - 48).i64()
                index <- index + 1
            valid <- true
            return -value if negative
            return value


        def lower_match_literal(text: sview, expected: Type, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            if expected.kind == TypeKind.Int:
                valid: mutable bool = false
                value: i64 = decimal_pattern_integer(text, valid)
                if valid:
                    return emit_constant(state, expected, value, "", "", false, ir_span(pos))
            elif expected.kind == TypeKind.Bool:
                emit_constant(state, expected, 0, "", "", true, ir_span(pos)) return if text == "true"
                emit_constant(state, expected, 0, "", "", false, ir_span(pos)) return if text == "false"
            elif expected.kind == TypeKind.Float:
                return emit_constant(state, expected, 0, text, "", false, ir_span(pos))
            elif expected.kind == TypeKind.Text:
                return emit_constant(state, expected, 0, "", text, false, ir_span(pos))
            elif expected.kind == TypeKind.Char:
                length: usize = sview_len(text)
                return emit_constant(state, expected, 0, "", text[1:length - 1], false, ir_span(pos)) if length >= 2 and sview_at(text, 0) == 39 and sview_at(text, length - 1) == 39
            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "match literal does not have the scrutinee's scalar type")
            return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}


        def append_binding_arguments(state: mutable LowerState&, indices: darray[u32]&) -> (start: u32, count: u16) can[Memory.Allocate, Abort.Panic]:
            start: u32 = state.edge_arg_pool.count.u32()
            for binding in indices |state|:
                state.edge_arg_pool.push(state.values[binding.usize()])
            return (start, indices.count.u16())


        def supported_scalar_match(arms: darray[Ast::MatchArm]&, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            supported: mutable bool = true
            for index in 0..<arms.count |arms, pos, state, supported|:
                arm: Ast::MatchArm = arms[index]
                catch_all: mutable bool = false
                match arm.pattern:
                    Pattern.Literal(text) | Pattern.Pin(text) | Pattern.Range(text, _, _):
                        pass
                    Pattern.Wildcard | Pattern.Binding(_):
                        catch_all <- true
                    _:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "initial match lowering supports scalar literals, pins, bindings, and wildcard patterns")
                        supported <- false
                guarded: mutable bool = false
                match arm.guard:
                    Expr.Absent:
                        pass
                    _:
                        guarded <- true
                if catch_all and not guarded and index + 1 != arms.count:
                    add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "a catch-all match arm must be last")
                    supported <- false
            return supported


        def scalar_match_exhaustive(type: Type&, arms: darray[Ast::MatchArm]&) -> bool:
            saw_true: mutable bool = false
            saw_false: mutable bool = false
            for arm in arms |saw_true, saw_false|:
                guarded: mutable bool = false
                match arm.guard:
                    Expr.Absent:
                        pass
                    _:
                        guarded <- true
                continue if guarded
                match arm.pattern:
                    Pattern.Wildcard | Pattern.Binding(_):
                        return true
                    Pattern.Literal(text):
                        saw_true <- true if text == "true"
                        saw_false <- true if text == "false"
                    _:
                        pass
            return type.kind == TypeKind.Bool and saw_true and saw_false


        def lower_scalar_match(scrutinee_expression: Ast::Expr, arms: darray[Ast::MatchArm]&, return_type: Type, pos: Ast::Pos&, state: mutable LowerState&) -> void can[Memory.Allocate, Abort.Panic]:
            scrutinee: LoweredValue = lower_expression(scrutinee_expression, state)
            return if not scrutinee.valid or not supported_scalar_match(arms, pos, state)
            if scrutinee.type.kind not in {TypeKind.Int, TypeKind.Float, TypeKind.Bool, TypeKind.Char, TypeKind.Text}:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "scalar match requires an integer, float, boolean, character, or text scrutinee")
                return

            scope_mark: usize = state.names.count
            base_values: mutable darray[u32] = []
            base_values.extend(state.values)
            assigned_names: mutable darray[sview] = []
            for arm in arms |assigned_names|:
                collect_assigned_names(arm.body, assigned_names)
            include_mutable_element_owners(state, assigned_names)
            carried_indices: mutable darray[u32] = []
            for name in assigned_names |state, carried_indices|:
                index: usize = binding_index(state, name)
                carried_indices.push(index.u32()) if index < scope_mark

            merge_block: u32 = fresh_block(state)
            merged_values: mutable darray[u32] = []
            for binding_u32 in carried_indices |state, merge_block, merged_values|:
                binding: usize = binding_u32.usize()
                merged: u32 = fresh_value(state)
                state.pending_parameter_blocks.push(merge_block)
                state.pending_parameters.push(Parameter{value: merged, type: state.types[binding], name: state.names[binding]})
                merged_values.push(merged)

            state.structured_depth <- state.structured_depth + 1
            any_fallthrough: mutable bool = arms.count == 0
            exhaustive: bool = scalar_match_exhaustive(scrutinee.type, arms)
            for arm_index in 0..<arms.count |state, arms, pos, scrutinee, return_type, scope_mark, base_values, carried_indices, merge_block, any_fallthrough, exhaustive|:
                arm: Ast::MatchArm = arms[arm_index]
                body_block: u32 = fresh_block(state)
                final_arm: bool = arm_index + 1 == arms.count
                next_test_block: u32 = merge_block if final_arm and not exhaustive else fresh_block(state)
                guarded: mutable bool = false
                match arm.guard:
                    Expr.Absent:
                        pass
                    _:
                        guarded <- true
                matched_block: u32 = fresh_block(state) if guarded else body_block
                binder: mutable sview = ""
                catch_all: mutable bool = false
                condition: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
                match arm.pattern:
                    Pattern.Literal(text):
                        literal: LoweredValue = lower_match_literal(text, scrutinee.type, pos, state)
                        if literal.valid:
                            result: u32 = fresh_value(state)
                            operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(scrutinee.value)
                            state.operand_pool.push(literal.value)
                            state.instructions.push(Instruction{opcode: Opcode.Equal, result: result, result_type: type_from_name("bool"), operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                            condition <- LoweredValue{valid: true, value: result, type: type_from_name("bool")}
                    Pattern.Range(lo_text, hi_text, inclusive):
                        if scrutinee.type.kind != TypeKind.Int and scrutinee.type.kind != TypeKind.Float:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range pattern requires a numeric scalar scrutinee")
                        else:
                            low: LoweredValue = lower_match_literal(lo_text, scrutinee.type, pos, state)
                            high: LoweredValue = lower_match_literal(hi_text, scrutinee.type, pos, state)
                            if low.valid and high.valid:
                                lower_result: u32 = fresh_value(state)
                                lower_operands: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(scrutinee.value)
                                state.operand_pool.push(low.value)
                                state.instructions.push(Instruction{opcode: Opcode.GreaterEqual, result: lower_result, result_type: type_from_name("bool"), operand_start: lower_operands, operand_count: 2, span: ir_span(pos)})
                                upper_test_block: u32 = fresh_block(state)
                                if next_test_block == merge_block:
                                    lower_fallthrough_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                                    state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: lower_result, operand_count: 1, target0: upper_test_block, target1: next_test_block, target_count: 2, edge1_arg_start: lower_fallthrough_args.start, edge1_arg_count: lower_fallthrough_args.count, span: ir_span(pos)}
                                    any_fallthrough <- true
                                else:
                                    state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: lower_result, operand_count: 1, target0: upper_test_block, target1: next_test_block, target_count: 2, span: ir_span(pos)}
                                finish_block(state)
                                state.current_block <- upper_test_block
                                state.terminated <- false
                                upper_result: u32 = fresh_value(state)
                                upper_operands: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(scrutinee.value)
                                state.operand_pool.push(high.value)
                                upper_opcode: Opcode = Opcode.LessEqual if inclusive else Opcode.Less
                                state.instructions.push(Instruction{opcode: upper_opcode, result: upper_result, result_type: type_from_name("bool"), operand_start: upper_operands, operand_count: 2, span: ir_span(pos)})
                                condition <- LoweredValue{valid: true, value: upper_result, type: type_from_name("bool")}
                    Pattern.Pin(name):
                        pinned: LoweredValue = lookup_binding(state, name)
                        if not pinned.valid or not same_type(pinned.type, scrutinee.type):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "pinned match binding must exist and match the scrutinee type")
                        else:
                            result: u32 = fresh_value(state)
                            operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(scrutinee.value)
                            state.operand_pool.push(pinned.value)
                            state.instructions.push(Instruction{opcode: Opcode.Equal, result: result, result_type: type_from_name("bool"), operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                            condition <- LoweredValue{valid: true, value: result, type: type_from_name("bool")}
                    Pattern.Binding(name):
                        binder <- name
                        catch_all <- true
                    Pattern.Wildcard:
                        catch_all <- true
                    _:
                        pass
                if catch_all:
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: matched_block, target_count: 1, span: ir_span(pos)}
                elif condition.valid:
                    if final_arm and not exhaustive:
                        unmatched_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition.value, operand_count: 1, target0: matched_block, target1: next_test_block, target_count: 2, edge1_arg_start: unmatched_args.start, edge1_arg_count: unmatched_args.count, span: ir_span(pos)}
                        any_fallthrough <- true
                    else:
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition.value, operand_count: 1, target0: matched_block, target1: next_test_block, target_count: 2, span: ir_span(pos)}
                finish_block(state)

                if guarded:
                    for index in 0..<scope_mark |state, base_values|:
                        state.values[index] <- base_values[index]
                    state.current_block <- matched_block
                    state.terminated <- false
                    if binder != "":
                        state.names.push(binder)
                        state.values.push(scrutinee.value)
                        state.types.push(scrutinee.type)
                        state.mutables.push(false)
                    guard_value: LoweredValue = lower_expression(arm.guard, state)
                    guard_valid: mutable bool = guard_value.valid
                    if guard_value.valid and guard_value.type.kind != TypeKind.Bool:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "match arm guard must have boolean type")
                        guard_valid <- false
                    if guard_valid:
                        if next_test_block == merge_block:
                            guard_fallthrough_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: guard_value.value, operand_count: 1, target0: body_block, target1: next_test_block, target_count: 2, edge1_arg_start: guard_fallthrough_args.start, edge1_arg_count: guard_fallthrough_args.count, span: ir_span(pos)}
                            any_fallthrough <- true
                        else:
                            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: guard_value.value, operand_count: 1, target0: body_block, target1: next_test_block, target_count: 2, span: ir_span(pos)}
                    finish_block(state)
                    state.names.truncate(scope_mark)
                    state.values.truncate(scope_mark)
                    state.types.truncate(scope_mark)
                    state.mutables.truncate(scope_mark)

                for index in 0..<scope_mark |state, base_values|:
                    state.values[index] <- base_values[index]
                state.current_block <- body_block
                state.terminated <- false
                if binder != "":
                    state.names.push(binder)
                    state.values.push(scrutinee.value)
                    state.types.push(scrutinee.type)
                    state.mutables.push(false)
                for nested in arm.body |state, return_type|:
                    lower_statement(nested, return_type, state)
                if not state.terminated:
                    arm_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: arm_args.start, edge0_arg_count: arm_args.count, span: ir_span(pos)}
                    any_fallthrough <- true
                finish_block(state)
                state.names.truncate(scope_mark)
                state.values.truncate(scope_mark)
                state.types.truncate(scope_mark)
                state.mutables.truncate(scope_mark)
                for index in 0..<scope_mark |state, base_values|:
                    state.values[index] <- base_values[index]
                state.current_block <- next_test_block
                state.terminated <- false

            if arms.count == 0:
                empty_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: empty_args.start, edge0_arg_count: empty_args.count, span: ir_span(pos)}
                finish_block(state)
            elif exhaustive:
                state.terminator <- Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)}
                finish_block(state)
            state.structured_depth <- state.structured_depth - 1
            if any_fallthrough:
                for offset in 0..<carried_indices.count |state, carried_indices, merged_values|:
                    state.values[carried_indices[offset].usize()] <- merged_values[offset]
                state.current_block <- merge_block
                state.terminated <- false
            else:
                state.terminated <- true


        def lower_statement(statement: Ast::Stmt, return_type: Type, state: mutable LowerState&) -> void can[Memory.Allocate, Abort.Panic]:
            if state.terminated:
                return
            match statement:
                Stmt.VarDecl(name, type_expression, value, pos):
                    declared: Type = type_from_expression(type_expression)
                    lowered: LoweredValue = lower_expression(value, state) if type_expression is Expr.Invalid else lower_expression_expected(value, declared, state)
                    if lowered.valid:
                        binding_type: Type = lowered.type if type_expression is Expr.Invalid else declared
                        if type_expression is not Expr.Invalid and not same_type(declared, lowered.type):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "binding initializer does not match its declared type")
                        else:
                            state.names.push(name)
                            state.values.push(lowered.value)
                            state.types.push(binding_type)
                            state.mutables.push(mutable_binding_type(type_expression))
                Stmt.Expr(expression, pos):
                    match expression:
                        Expr.Invalid:
                            pass
                        _:
                            if not lower_collection_mutation(expression, pos, state):
                                _ = lower_expression(expression, state)
                Stmt.Assign(target, operator, value, pos):
                    target_name: mutable sview = ""
                    index_expression: mutable Ast::Expr = Expr.Absent
                    indexed: mutable bool = false
                    match target:
                        Expr.Ident(name, target_pos):
                            target_name <- name
                        Expr.Index(Expr.Ident(name, target_pos), target_index, index_pos):
                            target_name <- name
                            index_expression <- target_index
                            indexed <- true
                        _:
                            pass
                    index: usize = binding_index(state, target_name)
                    if target_name == "" or index == state.names.count:
                        add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "initial SSA lowering supports assignment to a known local name")
                    elif indexed:
                        if not state.mutables[index]:
                            add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "indexed assignment requires a mutable array binding")
                        elif not supported_assignment_operator(operator):
                            add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "indexed assignment supports <- and typed arithmetic or bitwise compound assignment")
                        elif state.types[index].kind != TypeKind.Array and state.types[index].kind != TypeKind.Map:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed assignment requires an array or dictionary binding")
                        else:
                            lowered_index: LoweredValue = lower_expression(index_expression, state)
                            element_type: Type = map_value_type(state.types[index]) if state.types[index].kind == TypeKind.Map else array_element_type(state.types[index])
                            index_type: Type = map_key_type(state.types[index]) if state.types[index].kind == TypeKind.Map else type_from_name("i64")
                            if lowered_index.valid and ((state.types[index].kind == TypeKind.Map and not same_type(lowered_index.type, index_type)) or (state.types[index].kind == TypeKind.Array and lowered_index.type.kind != TypeKind.Int)):
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed assignment index must match the collection index type")
                            elif lowered_index.valid:
                                replacement: mutable LoweredValue = LoweredValue{value: 0, type: void_ir_type(), valid: false}
                                if operator == TokenKind.LArrow:
                                    lowered_replacement: LoweredValue = lower_expression_expected(value, element_type, state)
                                    if lowered_replacement.valid and not same_type(lowered_replacement.type, element_type):
                                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed assignment value must match the array element type")
                                    elif lowered_replacement.valid:
                                        replacement <- lowered_replacement
                                else:
                                    current: u32 = fresh_value(state)
                                    index_operands: u32 = state.operand_pool.count.u32()
                                    state.operand_pool.push(state.values[index])
                                    state.operand_pool.push(lowered_index.value)
                                    state.instructions.push(Instruction{opcode: Opcode.Index, result: current, result_type: element_type, operand_start: index_operands, operand_count: 2, span: ir_span(pos)})
                                    lowered: LoweredValue = lower_expression_expected(value, element_type, state)
                                    if lowered.valid:
                                        opcode: Opcode = compound_opcode(operator)
                                        arithmetic: bool = opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder}
                                        bitwise: bool = opcode in {Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight}
                                        operands_match: bool = same_type(element_type, lowered.type)
                                        valid_arithmetic: bool = arithmetic and operands_match and numeric_type(element_type) and (opcode != Opcode.Remainder or element_type.kind == TypeKind.Int)
                                        valid_bitwise: bool = bitwise and operands_match and element_type.kind == TypeKind.Int
                                        if not valid_arithmetic and not valid_bitwise:
                                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed compound assignment operands do not have compatible static types")
                                        else:
                                            result: u32 = fresh_value(state)
                                            operation_operands: u32 = state.operand_pool.count.u32()
                                            state.operand_pool.push(current)
                                            state.operand_pool.push(lowered.value)
                                            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: element_type, operand_start: operation_operands, operand_count: 2, span: ir_span(pos)})
                                            replacement <- LoweredValue{value: result, type: element_type, valid: true}
                                if replacement.valid:
                                    result: u32 = fresh_value(state)
                                    operand_start: u32 = state.operand_pool.count.u32()
                                    state.operand_pool.push(state.values[index])
                                    state.operand_pool.push(lowered_index.value)
                                    state.operand_pool.push(replacement.value)
                                    state.instructions.push(Instruction{opcode: Opcode.SetIndex, result: result, result_type: state.types[index], operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
                                    state.values[index] <- result
                    else:
                        rebound: mutable bool = false
                        if not state.mutables[index]:
                            add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "assignment requires a mutable local binding")
                        elif not supported_assignment_operator(operator):
                            add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "SSA rebinding supports <- and typed arithmetic or bitwise compound assignment")
                        elif operator == TokenKind.LArrow:
                            lowered: LoweredValue = lower_expression_expected(value, state.types[index], state)
                            if lowered.valid:
                                if not same_type(state.types[index], lowered.type):
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "assignment cannot change a binding's static type")
                                else:
                                    state.values[index] <- lowered.value
                                    rebound <- true
                        else:
                            lowered: LoweredValue = lower_expression_expected(value, state.types[index], state)
                            if lowered.valid:
                                opcode: Opcode = compound_opcode(operator)
                                arithmetic: bool = opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder}
                                bitwise: bool = opcode in {Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight}
                                operands_match: bool = same_type(state.types[index], lowered.type)
                                valid_arithmetic: bool = arithmetic and operands_match and numeric_type(state.types[index]) and (opcode != Opcode.Remainder or state.types[index].kind == TypeKind.Int)
                                valid_bitwise: bool = bitwise and operands_match and state.types[index].kind == TypeKind.Int
                                if not valid_arithmetic and not valid_bitwise:
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "compound assignment operands do not have compatible static types")
                                else:
                                    result: u32 = fresh_value(state)
                                    operand_start: u32 = state.operand_pool.count.u32()
                                    state.operand_pool.push(state.values[index])
                                    state.operand_pool.push(lowered.value)
                                    state.instructions.push(Instruction{opcode: opcode, result: result, result_type: state.types[index], operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                                    state.values[index] <- result
                                    rebound <- true
                        synchronize_mutable_element(state, index, pos) if rebound
                Stmt.Return(value_opt, pos):
                    if value_opt is value:
                        lowered: LoweredValue = lower_expression_expected(value, return_type, state)
                        return_valid: mutable bool = lowered.valid
                        if lowered.valid and not same_type(return_type, lowered.type):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "return value does not match the function return type")
                            return_valid <- false
                        emit_handler_unwind(state, 0, pos) if return_valid
                        state.terminator <- Terminator{kind: TerminatorKind.Return, operand: lowered.value, operand_count: 1, span: ir_span(pos)} if return_valid
                    else:
                        if return_type.kind != TypeKind.Void:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "non-void function return requires a value")
                        else:
                            emit_handler_unwind(state, 0, pos)
                            state.terminator <- Terminator{kind: TerminatorKind.Return, span: ir_span(pos)}
                    state.terminated <- true
                Stmt.If(condition, then_body, else_body, pos):
                    condition_value: LoweredValue = lower_expression(condition, state)
                    condition_valid: mutable bool = condition_value.valid
                    if condition_value.valid and condition_value.type.kind != TypeKind.Bool:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "if condition must have boolean type")
                        condition_valid <- false
                    if condition_valid:
                        then_block: u32 = fresh_block(state)
                        else_block: u32 = fresh_block(state)
                        merge_block: u32 = fresh_block(state)
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition_value.value, operand_count: 1, target0: then_block, target1: else_block, target_count: 2, span: ir_span(pos)}
                        finish_block(state)

                        scope_mark: usize = state.names.count
                        state.structured_depth <- state.structured_depth + 1
                        base_values: mutable darray[u32] = []
                        base_values.extend(state.values)
                        state.current_block <- then_block
                        state.terminated <- false
                        for nested in then_body |state, return_type|:
                            lower_statement(nested, return_type, state)
                        then_falls_through: bool = not state.terminated
                        state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, span: ir_span(pos)} if then_falls_through
                        then_values: mutable darray[u32] = []
                        for index in 0..<scope_mark |state, then_values|:
                            then_values.push(state.values[index])
                        then_block_index: usize = state.blocks.count
                        finish_block(state)
                        state.names.truncate(scope_mark)
                        state.values.truncate(scope_mark)
                        state.types.truncate(scope_mark)
                        state.mutables.truncate(scope_mark)
                        for index in 0..<scope_mark |state, base_values|:
                            state.values[index] <- base_values[index]

                        state.current_block <- else_block
                        state.terminated <- false
                        for nested in else_body |state, return_type|:
                            lower_statement(nested, return_type, state)
                        else_falls_through: bool = not state.terminated
                        state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, span: ir_span(pos)} if else_falls_through
                        else_values: mutable darray[u32] = []
                        for index in 0..<scope_mark |state, else_values|:
                            else_values.push(state.values[index])
                        else_block_index: usize = state.blocks.count
                        finish_block(state)
                        state.names.truncate(scope_mark)
                        state.values.truncate(scope_mark)
                        state.types.truncate(scope_mark)
                        state.mutables.truncate(scope_mark)
                        state.structured_depth <- state.structured_depth - 1

                        if then_falls_through or else_falls_through:
                            if then_falls_through and else_falls_through:
                                then_edge_start: u32 = state.edge_arg_pool.count.u32()
                                merge_count: mutable u16 = 0
                                for index in 0..<scope_mark |state, then_values, else_values, merge_block, merge_count|:
                                    if then_values[index] != else_values[index]:
                                        state.edge_arg_pool.push(then_values[index])
                                        merge_count <- merge_count + 1
                                else_edge_start: u32 = state.edge_arg_pool.count.u32()
                                for index in 0..<scope_mark |state, then_values, else_values|:
                                    state.edge_arg_pool.push(else_values[index]) if then_values[index] != else_values[index]
                                state.blocks[then_block_index].terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: then_edge_start, edge0_arg_count: merge_count, span: ir_span(pos)}
                                state.blocks[else_block_index].terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: else_edge_start, edge0_arg_count: merge_count, span: ir_span(pos)}
                                for index in 0..<scope_mark |state, then_values, else_values, merge_block|:
                                    if then_values[index] != else_values[index]:
                                        merged_value: u32 = fresh_value(state)
                                        state.pending_parameter_blocks.push(merge_block)
                                        state.pending_parameters.push(Parameter{value: merged_value, type: state.types[index], name: state.names[index]})
                                        state.values[index] <- merged_value
                                    else:
                                        state.values[index] <- then_values[index]
                            else:
                                for index in 0..<scope_mark |state, then_values, else_values, then_falls_through|:
                                    state.values[index] <- then_values[index] if then_falls_through else else_values[index]
                            state.current_block <- merge_block
                            state.terminated <- false
                        else:
                            state.terminated <- true
                Stmt.While(condition, body, pos):
                    header_block: u32 = fresh_block(state)
                    body_block: u32 = fresh_block(state)
                    exit_block: u32 = fresh_block(state)
                    assigned_names: mutable darray[sview] = []
                    collect_assigned_names(body, assigned_names)
                    include_mutable_element_owners(state, assigned_names)
                    carried_indices: mutable darray[u32] = []
                    for assigned_name in assigned_names |state, carried_indices|:
                        assigned_index: usize = binding_index(state, assigned_name)
                        carried_indices.push(assigned_index.u32()) if assigned_index < state.names.count
                    context_start: u32 = state.loop_carried_indices.count.u32()
                    state.loop_carried_indices.extend(carried_indices)
                    state.loop_context_starts.push(context_start)
                    state.loop_context_counts.push(carried_indices.count.u16())
                    state.loop_handler_depths.push(state.active_handlers.count.u32())
                    context: usize = state.loop_context_counts.count - 1

                    entry_args: (start: u32, count: u16) = append_context_arguments(state, context)
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: entry_args.start, edge0_arg_count: entry_args.count, span: ir_span(pos)}
                    finish_block(state)

                    exit_values: mutable darray[u32] = []
                    for binding_u32 in carried_indices |state, header_block, exit_block, exit_values|:
                        binding: usize = binding_u32.usize()
                        header_value: u32 = fresh_value(state)
                        exit_value: u32 = fresh_value(state)
                        state.pending_parameter_blocks.push(header_block)
                        state.pending_parameters.push(Parameter{value: header_value, type: state.types[binding], name: state.names[binding]})
                        state.pending_parameter_blocks.push(exit_block)
                        state.pending_parameters.push(Parameter{value: exit_value, type: state.types[binding], name: state.names[binding]})
                        state.values[binding] <- header_value
                        exit_values.push(exit_value)

                    state.current_block <- header_block
                    state.terminated <- false
                    condition_value: LoweredValue = lower_expression(condition, state)
                    condition_valid: mutable bool = condition_value.valid
                    if condition_value.valid and condition_value.type.kind != TypeKind.Bool:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "while condition must have boolean type")
                        condition_valid <- false
                    if condition_valid:
                        exit_args: (start: u32, count: u16) = append_context_arguments(state, context)
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition_value.value, operand_count: 1, target0: body_block, target1: exit_block, target_count: 2, edge1_arg_start: exit_args.start, edge1_arg_count: exit_args.count, span: ir_span(pos)}
                    finish_block(state)

                    scope_mark: usize = state.names.count
                    state.structured_depth <- state.structured_depth + 1
                    state.break_targets.push(exit_block)
                    state.continue_targets.push(header_block)
                    state.current_block <- body_block
                    state.terminated <- false
                    for nested in body |state, return_type|:
                        lower_statement(nested, return_type, state)
                    if not state.terminated:
                        backedge_args: (start: u32, count: u16) = append_context_arguments(state, context)
                        state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: backedge_args.start, edge0_arg_count: backedge_args.count, span: ir_span(pos)}
                    finish_block(state)
                    _ = state.break_targets.pop()
                    _ = state.continue_targets.pop()
                    state.names.truncate(scope_mark)
                    state.values.truncate(scope_mark)
                    state.types.truncate(scope_mark)
                    state.mutables.truncate(scope_mark)
                    state.structured_depth <- state.structured_depth - 1
                    for offset in 0..<carried_indices.count |state, carried_indices, exit_values|:
                        state.values[carried_indices[offset].usize()] <- exit_values[offset]
                    _ = state.loop_context_starts.pop()
                    _ = state.loop_context_counts.pop()
                    _ = state.loop_handler_depths.pop()
                    state.loop_carried_indices <- state.loop_carried_indices.truncate(context_start.usize())

                    state.current_block <- exit_block
                    state.terminated <- false
                Stmt.For(bind, variables, iterable, body, pos):
                    mutable_iteration: bool = bind == "mutable"
                    iterable_name: mutable sview = ""
                    enumerate_sugar: mutable bool = false
                    enumerate_source: mutable Ast::Expr = Expr.Absent
                    items_sugar: mutable bool = false
                    items_source: mutable Ast::Expr = Expr.Absent
                    range_sugar: mutable bool = false
                    range_source: mutable Ast::Expr = Expr.Absent
                    match iterable:
                        Expr.Ident(name, iterable_pos):
                            iterable_name <- name
                        Expr.Call(callee, arguments, argument_names, call_pos):
                            match callee:
                                Expr.Field(object, field, field_pos):
                                    if field == "enumerate" and arguments.count == 0 and argument_names.count == 0:
                                        enumerate_sugar <- true
                                        enumerate_source <- object
                                    if field == "items" and arguments.count == 0 and argument_names.count == 0:
                                        items_sugar <- true
                                        items_source <- object
                                Expr.Ident(name, name_pos):
                                    valid_range_names: mutable bool = arguments.count > 0 and arguments.count <= 3 and (argument_names.count == 0 or argument_names.count == arguments.count)
                                    if valid_range_names:
                                        for argument_name in argument_names |valid_range_names|:
                                            valid_range_names <- false if argument_name != ""
                                    if name == "range" and valid_range_names and lowered_function_index(state, name) == state.function_names.count:
                                        range_sugar <- true
                                        if arguments.count == 1:
                                            range_source <- Expr.Binary(Expr.IntLit(0), TokenKind.RangeLt, arguments[0], call_pos)
                                        elif arguments.count == 2:
                                            range_source <- Expr.Binary(arguments[0], TokenKind.RangeLt, arguments[1], call_pos)
                                        else:
                                            range_operator: mutable TokenKind = TokenKind.RangeLt
                                            range_step: mutable Ast::Expr = arguments[2]
                                            match arguments[2]:
                                                Expr.Unary(step_operator, magnitude, step_pos):
                                                    if step_operator == TokenKind.Minus:
                                                        match magnitude:
                                                            Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                                                                if value > 0:
                                                                    range_operator <- TokenKind.RangeGt
                                                                    range_step <- magnitude
                                                            _:
                                                                pass
                                                _:
                                                    pass
                                            bounded_range: Ast::Expr = Expr.Binary(arguments[0], range_operator, arguments[1], call_pos)
                                            range_source <- Expr.Binary(bounded_range, TokenKind.Range, range_step, call_pos)
                                _:
                                    pass
                        _:
                            pass
                    collection_owner: usize = binding_index(state, iterable_name)
                    if variables.count == 0 or variables.count > 2 or bind not in {"", "mutable"}:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "for lowering supports one read binding, or two bindings for a dictionary, array, or text iterable")
                    elif enumerate_sugar and variables.count != 2:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "enumerate iteration requires index and value bindings")
                    elif items_sugar and variables.count != 2:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "items iteration requires key and value bindings")
                    elif range_sugar and variables.count != 1:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "range iteration requires exactly one element binding")
                    elif mutable_iteration and variables.count != 1:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "mutable iteration supports exactly one element binding")
                    elif mutable_iteration and iterable_name == "":
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "mutable iteration requires a named mutable array binding")
                    elif mutable_iteration and collection_owner == state.names.count:
                        add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "mutable iteration requires a known array binding")
                    elif mutable_iteration and not state.mutables[collection_owner]:
                        add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "mutable iteration requires a mutable array binding")
                    elif mutable_iteration and state.types[collection_owner].kind != TypeKind.Array:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "mutable iteration requires an array binding")
                    elif not enumerate_sugar and not items_sugar and not mutable_iteration and lower_range_for(variables, range_source if range_sugar else iterable, body, return_type, pos, state):
                        pass
                    else:
                        collection_expression: mutable Ast::Expr = iterable
                        collection_expression <- enumerate_source if enumerate_sugar
                        collection_expression <- items_source if items_sugar
                        collection: mutable LoweredValue = lower_expression(collection_expression, state)
                        if not collection.valid:
                            pass
                        elif collection.type.kind == TypeKind.Map and mutable_iteration:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "mutable iteration requires an array binding")
                        elif enumerate_sugar and collection.type.kind not in {TypeKind.Array, TypeKind.Text}:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "enumerate iteration requires an array or text source")
                        elif items_sugar and collection.type.kind != TypeKind.Map:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "items iteration requires a dictionary source")
                        elif variables.count == 2 and collection.type.kind not in {TypeKind.Map, TypeKind.Array, TypeKind.Text}:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "two for-bindings require a dictionary, array, or text iterable")
                        elif collection.type.kind not in {TypeKind.Array, TypeKind.Map, TypeKind.Text}:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "for iterable must have an array, dictionary, or text type")
                        else:
                            pair_iteration: bool = variables.count == 2
                            map_pair: bool = pair_iteration and not enumerate_sugar and collection.type.kind == TypeKind.Map
                            indexed_pair: bool = enumerate_sugar or (pair_iteration and collection.type.kind in {TypeKind.Array, TypeKind.Text})
                            map_collection: u32 = collection.value
                            map_element_type: Type = map_value_type(collection.type) if collection.type.kind == TypeKind.Map else void_ir_type()
                            if collection.type.kind == TypeKind.Map:
                                key_type: Type = map_key_type(collection.type)
                                keys_type: Type = array_ir_type(key_type)
                                keys_result: u32 = fresh_value(state)
                                keys_operand_start: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(collection.value)
                                state.instructions.push(Instruction{opcode: Opcode.MapKeys, result: keys_result, result_type: keys_type, operand_start: keys_operand_start, operand_count: 1, span: ir_span(pos)})
                                collection <- LoweredValue{valid: true, value: keys_result, type: keys_type}
                            header_block: u32 = fresh_block(state)
                            body_block: u32 = fresh_block(state)
                            latch_block: u32 = fresh_block(state)
                            exit_block: u32 = fresh_block(state)
                            assigned_names: mutable darray[sview] = []
                            collect_assigned_names(body, assigned_names)
                            add_unique_name(assigned_names, iterable_name) if mutable_iteration
                            include_mutable_element_owners(state, assigned_names)
                            carried_indices: mutable darray[u32] = []
                            for assigned_name in assigned_names |state, carried_indices|:
                                assigned_index: usize = binding_index(state, assigned_name)
                                carried_indices.push(assigned_index.u32()) if assigned_index < state.names.count
                            context_start: u32 = state.loop_carried_indices.count.u32()
                            state.loop_carried_indices.extend(carried_indices)
                            state.loop_context_starts.push(context_start)
                            state.loop_context_counts.push(carried_indices.count.u16())
                            state.loop_handler_depths.push(state.active_handlers.count.u32())
                            context: usize = state.loop_context_counts.count - 1

                            index_type: Type = type_from_name("usize")
                            initial_index: LoweredValue = emit_constant(state, index_type, 0, "", "", false, ir_span(pos))
                            entry_args: (start: u32, count: u16) = append_context_arguments(state, context)
                            state.edge_arg_pool.push(initial_index.value)
                            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: entry_args.start, edge0_arg_count: entry_args.count + 1, span: ir_span(pos)}
                            finish_block(state)

                            header_values: mutable darray[u32] = []
                            latch_values: mutable darray[u32] = []
                            exit_values: mutable darray[u32] = []
                            for binding_u32 in carried_indices |state, header_block, latch_block, exit_block, header_values, latch_values, exit_values|:
                                binding: usize = binding_u32.usize()
                                header_value: u32 = fresh_value(state)
                                latch_value: u32 = fresh_value(state)
                                exit_value: u32 = fresh_value(state)
                                state.pending_parameter_blocks.push(header_block)
                                state.pending_parameters.push(Parameter{value: header_value, type: state.types[binding], name: state.names[binding]})
                                state.pending_parameter_blocks.push(latch_block)
                                state.pending_parameters.push(Parameter{value: latch_value, type: state.types[binding], name: state.names[binding]})
                                state.pending_parameter_blocks.push(exit_block)
                                state.pending_parameters.push(Parameter{value: exit_value, type: state.types[binding], name: state.names[binding]})
                                header_values.push(header_value)
                                latch_values.push(latch_value)
                                exit_values.push(exit_value)
                            index_value: u32 = fresh_value(state)
                            state.pending_parameter_blocks.push(header_block)
                            state.pending_parameters.push(Parameter{value: index_value, type: index_type, name: "for-index"})
                            for offset in 0..<carried_indices.count |state, carried_indices, header_values|:
                                state.values[carried_indices[offset].usize()] <- header_values[offset]
                            active_collection: u32 = state.values[collection_owner] if mutable_iteration else collection.value

                            state.current_block <- header_block
                            state.terminated <- false
                            length_result: u32 = fresh_value(state)
                            length_operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(active_collection)
                            state.instructions.push(Instruction{opcode: Opcode.Length, result: length_result, result_type: index_type, operand_start: length_operand_start, operand_count: 1, span: ir_span(pos)})
                            condition_result: u32 = fresh_value(state)
                            condition_operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(index_value)
                            state.operand_pool.push(length_result)
                            state.instructions.push(Instruction{opcode: Opcode.Less, result: condition_result, result_type: type_from_name("bool"), operand_start: condition_operand_start, operand_count: 2, span: ir_span(pos)})
                            exit_args: (start: u32, count: u16) = append_context_arguments(state, context)
                            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition_result, operand_count: 1, target0: body_block, target1: exit_block, target_count: 2, edge1_arg_start: exit_args.start, edge1_arg_count: exit_args.count, span: ir_span(pos)}
                            finish_block(state)

                            outer_scope: usize = state.names.count
                            relation_scope: usize = state.element_binding_indices.count
                            state.structured_depth <- state.structured_depth + 1
                            state.break_targets.push(exit_block)
                            state.continue_targets.push(latch_block)
                            state.current_block <- body_block
                            state.terminated <- false
                            element_result: u32 = fresh_value(state)
                            element_operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(active_collection)
                            state.operand_pool.push(index_value)
                            element_type: Type = type_from_name("char") if collection.type.kind == TypeKind.Text else array_element_type(collection.type)
                            state.instructions.push(Instruction{opcode: Opcode.Index, result: element_result, result_type: element_type, operand_start: element_operand_start, operand_count: 2, span: ir_span(pos)})
                            if map_pair:
                                state.names.push(variables[0])
                                state.values.push(element_result)
                                state.types.push(element_type)
                                state.mutables.push(false)
                                value_result: u32 = fresh_value(state)
                                value_operand_start: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(map_collection)
                                state.operand_pool.push(element_result)
                                state.instructions.push(Instruction{opcode: Opcode.Index, result: value_result, result_type: map_element_type, operand_start: value_operand_start, operand_count: 2, span: ir_span(pos)})
                                state.names.push(variables[1])
                                state.values.push(value_result)
                                state.types.push(map_element_type)
                                state.mutables.push(false)
                            elif indexed_pair:
                                # Arrays and text expose the loop cursor as the
                                # first binding, matching Python's enumerate
                                # shape while retaining exact usize typing.
                                state.names.push(variables[0])
                                state.values.push(index_value)
                                state.types.push(index_type)
                                state.mutables.push(false)
                                state.names.push(variables[1])
                                state.values.push(element_result)
                                state.types.push(element_type)
                                state.mutables.push(false)
                            else:
                                state.names.push(variables[0])
                                state.values.push(element_result)
                                state.types.push(element_type)
                                state.mutables.push(mutable_iteration)
                            if mutable_iteration:
                                state.element_binding_indices.push(outer_scope.u32())
                                state.element_owner_indices.push(collection_owner.u32())
                                state.element_index_values.push(index_value)
                            for nested in body |state, return_type|:
                                lower_statement(nested, return_type, state)
                            if not state.terminated:
                                body_args: (start: u32, count: u16) = append_context_arguments(state, context)
                                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: latch_block, target_count: 1, edge0_arg_start: body_args.start, edge0_arg_count: body_args.count, span: ir_span(pos)}
                            finish_block(state)
                            _ = state.break_targets.pop()
                            _ = state.continue_targets.pop()
                            state.names.truncate(outer_scope)
                            state.values.truncate(outer_scope)
                            state.types.truncate(outer_scope)
                            state.mutables.truncate(outer_scope)
                            state.element_binding_indices.truncate(relation_scope)
                            state.element_owner_indices.truncate(relation_scope)
                            state.element_index_values.truncate(relation_scope)
                            for offset in 0..<carried_indices.count |state, carried_indices, latch_values|:
                                state.values[carried_indices[offset].usize()] <- latch_values[offset]

                            state.current_block <- latch_block
                            state.terminated <- false
                            one: LoweredValue = emit_constant(state, index_type, 1, "", "", false, ir_span(pos))
                            next_index: u32 = fresh_value(state)
                            increment_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(index_value)
                            state.operand_pool.push(one.value)
                            state.instructions.push(Instruction{opcode: Opcode.Add, result: next_index, result_type: index_type, operand_start: increment_start, operand_count: 2, span: ir_span(pos)})
                            backedge_args: (start: u32, count: u16) = append_context_arguments(state, context)
                            state.edge_arg_pool.push(next_index)
                            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: backedge_args.start, edge0_arg_count: backedge_args.count + 1, span: ir_span(pos)}
                            finish_block(state)

                            state.structured_depth <- state.structured_depth - 1
                            for offset in 0..<carried_indices.count |state, carried_indices, exit_values|:
                                state.values[carried_indices[offset].usize()] <- exit_values[offset]
                            _ = state.loop_context_starts.pop()
                            _ = state.loop_context_counts.pop()
                            _ = state.loop_handler_depths.pop()
                            state.loop_carried_indices <- state.loop_carried_indices.truncate(context_start.usize())
                            state.current_block <- exit_block
                            state.terminated <- false
                Stmt.Match(scrutinee, arms, pos):
                    lower_scalar_match(scrutinee, arms, return_type, pos, state)
                Stmt.Break(label, pos):
                    if label != "":
                        add_issue(state, LowerIssueKind.UnsupportedLoopLabel, pos.line, "labeled break is not in the initial IR lowering subset")
                    else:
                        if state.break_targets.count == 0:
                            add_issue(state, LowerIssueKind.LoopControlOutsideLoop, pos.line, "break has no enclosing loop")
                        else:
                            target: u32 = state.break_targets[state.break_targets.count - 1]
                            context: usize = state.loop_context_counts.count - 1
                            emit_handler_unwind(state, state.loop_handler_depths[context].usize(), pos)
                            edge_args: (start: u32, count: u16) = append_context_arguments(state, context)
                            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: target, target_count: 1, edge0_arg_start: edge_args.start, edge0_arg_count: edge_args.count, span: ir_span(pos)}
                            state.terminated <- true
                Stmt.Continue(label, pos):
                    if label != "":
                        add_issue(state, LowerIssueKind.UnsupportedLoopLabel, pos.line, "labeled continue is not in the initial IR lowering subset")
                    else:
                        if state.continue_targets.count == 0:
                            add_issue(state, LowerIssueKind.LoopControlOutsideLoop, pos.line, "continue has no enclosing loop")
                        else:
                            target: u32 = state.continue_targets[state.continue_targets.count - 1]
                            context: usize = state.loop_context_counts.count - 1
                            emit_handler_unwind(state, state.loop_handler_depths[context].usize(), pos)
                            edge_args: (start: u32, count: u16) = append_context_arguments(state, context)
                            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: target, target_count: 1, edge0_arg_start: edge_args.start, edge0_arg_count: edge_args.count, span: ir_span(pos)}
                            state.terminated <- true
                Stmt.Block(kind, clause, binding, body, pos):
                    if kind == "signal":
                        if clause.count == 0:
                            add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "signal must name an effect operation")
                        else:
                            reference: sview = clause[0]
                            operands: mutable darray[u32] = []
                            valid: mutable bool = true
                            for payload_statement in body |state, operands, valid|:
                                match payload_statement:
                                    Stmt.Expr(payload_expression, payload_pos):
                                        lowered_payload: LoweredValue = lower_expression(payload_expression, state)
                                        operands.push(lowered_payload.value) if lowered_payload.valid
                                        valid <- false if not lowered_payload.valid
                                    _:
                                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "signal payload must contain value expressions")
                                        valid <- false
                            if valid:
                                operand_start: u32 = state.operand_pool.count.u32()
                                state.operand_pool.extend(operands)
                                state.instructions.push(Instruction{opcode: Opcode.Perform, result: 0, result_type: void_ir_type(), operand_start: operand_start, operand_count: operands.count.u16(), effect_family: effect_family(reference), effect_operation: effect_operation(reference), trace: trace_site(state, reference, pos), span: ir_span(pos)})
                    else:
                        if kind == "with" and clause.count >= 2 and clause[0] == "handler":
                            handler_name: sview = clause[1]
                            add_handler_contract(state, handler_name)
                            state.instructions.push(Instruction{opcode: Opcode.HandlerPush, result: 0, result_type: void_ir_type(), symbol: handler_name, trace: trace_site(state, handler_name, pos), span: ir_span(pos)})
                            handler_depth: usize = state.active_handlers.count
                            state.active_handlers.push(handler_name)
                            scope_mark: usize = state.names.count
                            for nested in body |state, return_type|:
                                lower_statement(nested, return_type, state)
                            state.names.truncate(scope_mark)
                            state.values.truncate(scope_mark)
                            state.types.truncate(scope_mark)
                            state.mutables.truncate(scope_mark)
                            state.instructions.push(Instruction{opcode: Opcode.HandlerPop, result: 0, result_type: void_ir_type(), symbol: handler_name, trace: trace_site(state, "handler-pop", pos), span: ir_span(pos)}) if not state.terminated
                            state.active_handlers.truncate(handler_depth)
                        else:
                            if kind == "can" or kind == "trusted":
                                scope_mark: usize = state.names.count
                                for nested in body |state, return_type|:
                                    lower_statement(nested, return_type, state)
                                state.names.truncate(scope_mark)
                                state.values.truncate(scope_mark)
                                state.types.truncate(scope_mark)
                                state.mutables.truncate(scope_mark)
                            else:
                                add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "control block is not in the initial IR lowering subset")
                _:
                    add_issue(state, LowerIssueKind.UnsupportedStatement, 0, "statement is not in the initial IR lowering subset")


        def lower_function(name: sview, params: darray[Ast::ParamDecl]&, return_type_opt: Ast::Expr?, body: darray[Ast::Stmt]&, effects: darray[sview]&, declared_error_start: u32, declared_error_count: u16, pos: Ast::Pos&, function_names: darray[sview]&, function_returns: darray[Type]&, function_parameter_starts: darray[u32]&, function_parameter_counts: darray[u16]&, function_parameter_types: darray[Type]&, function_parameter_names: darray[sview]&, function_parameter_has_defaults: darray[bool]&, function_parameter_defaults: darray[Ast::Expr]&, function_effect_starts: darray[u32]&, function_effect_counts: darray[u16]&, function_effects: darray[sview]&, function_error_starts: darray[u32]&, function_error_counts: darray[u16]&, function_errors: darray[sview]&, handlers: darray[Handler]&, comprehension_kinds: darray[Ast::EnumAnnotation]&, type_table: mutable TypeTable&, outer_issues: mutable darray[LowerIssue]&) -> Function can[Memory.Allocate, Abort.Panic]:
            return_type: mutable Type = void_ir_type()
            return_type <- interned_type_from_expression(return_expression, type_table) if return_type_opt is return_expression
            state: mutable LowerState = LowerState{function: name, next_value: 1, current_block: 1, next_block: 2, instruction_start: 0, structured_depth: 0, blocks: [], names: [], values: [], types: [], mutables: [], instructions: [], operand_pool: [], edge_arg_pool: [], issues: [], break_targets: [], continue_targets: [], pending_parameter_blocks: [], pending_parameters: [], block_parameter_pool: [], loop_context_starts: [], loop_context_counts: [], loop_carried_indices: [], loop_handler_depths: [], element_binding_indices: [], element_owner_indices: [], element_index_values: [], active_handlers: [], terminated: false, terminator: Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)}, function_names: function_names, function_returns: function_returns, function_parameter_starts: function_parameter_starts, function_parameter_counts: function_parameter_counts, function_parameter_types: function_parameter_types, function_parameter_names: function_parameter_names, function_parameter_has_defaults: function_parameter_has_defaults, function_parameter_defaults: function_parameter_defaults, function_effect_starts: function_effect_starts, function_effect_counts: function_effect_counts, function_effects: function_effects, function_error_starts: function_error_starts, function_error_counts: function_error_counts, function_errors: function_errors, handlers: handlers, comprehension_kinds: comprehension_kinds, function_return_type: return_type, required_effects: [], required_errors: []}
            state.required_effects.extend(effects)
            for error_offset in 0..<declared_error_count.usize() |state, declared_error_start|:
                declared_error: sview = function_errors[declared_error_start.usize() + error_offset]
                state.required_errors.push(declared_error) if declared_error != "" and not has_text(state.required_errors, declared_error)
            lowered_params: mutable darray[Parameter] = []
            for parameter in params |state, lowered_params|:
                parameter_type: Type = interned_type_from_expression(parameter.type_expression, type_table)
                value: u32 = fresh_value(state)
                lowered_params.push(Parameter{value: value, type: parameter_type, name: parameter.name})
                state.names.push(parameter.name)
                state.values.push(value)
                state.types.push(parameter_type)
                state.mutables.push(parameter.is_mutable or mutable_binding_type(parameter.type_expression))
            for statement in body |state, return_type|:
                lower_statement(statement, return_type, state)
            if not state.terminated:
                if return_type.kind == TypeKind.Void:
                    state.terminator <- Terminator{kind: TerminatorKind.Return, span: ir_span(pos)}
                else:
                    add_issue(state, LowerIssueKind.MissingReturn, pos.line, "non-void function did not lower to a return")
            finish_block(state) if state.current_block != 0
            for found in state.issues |outer_issues|:
                outer_issues.push(found)
            return Function{name: name, parameters: lowered_params, return_type: return_type, effects: state.required_effects, operand_pool: state.operand_pool, edge_arg_pool: state.edge_arg_pool, block_parameter_pool: state.block_parameter_pool, instruction_pool: state.instructions, blocks: state.blocks, entry: 1, errors: state.required_errors}


    public:
        # Lower a semantically checked parser file. The caller must run Semantic::check first;
        # this boundary assumes the source is well typed and reports only lowering coverage.
        def lower_file_with_handlers(file: Ast::File&, module_name: sview, handlers: darray[Handler]&) -> LowerResult can[Memory.Allocate, Abort.Panic]:
            names: mutable darray[sview] = []
            returns: mutable darray[Type] = []
            parameter_starts: mutable darray[u32] = []
            parameter_counts: mutable darray[u16] = []
            parameter_types: mutable darray[Type] = []
            parameter_names: mutable darray[sview] = []
            parameter_has_defaults: mutable darray[bool] = []
            parameter_defaults: mutable darray[Ast::Expr] = []
            effect_starts: mutable darray[u32] = []
            effect_counts: mutable darray[u16] = []
            signature_effects: mutable darray[sview] = []
            error_starts: mutable darray[u32] = []
            error_counts: mutable darray[u16] = []
            signature_errors: mutable darray[sview] = []
            type_table: mutable TypeTable = TypeTable{rows: [], children: []}
            for declaration in file.top_decls |names, returns, parameter_starts, parameter_counts, parameter_types, parameter_names, parameter_has_defaults, parameter_defaults, effect_starts, effect_counts, signature_effects, error_starts, error_counts, signature_errors, file|:
                match declaration:
                    Decl.Func(name, params, return_type_opt, body, effects, decorators, pos):
                        return_type: mutable Type = void_ir_type()
                        return_type <- interned_type_from_expression(return_expression, type_table) if return_type_opt is return_expression
                        names.push(name)
                        returns.push(return_type)
                        parameter_starts.push(parameter_types.count.u32())
                        parameter_counts.push(params.count.u16())
                        for parameter in params |parameter_types, parameter_names, parameter_has_defaults, parameter_defaults|:
                            parameter_types.push(interned_type_from_expression(parameter.type_expression, type_table))
                            parameter_names.push(parameter.name)
                            parameter_has_defaults.push(parameter.has_default)
                            parameter_defaults.push(parameter.default_value)
                        effect_starts.push(signature_effects.count.u32())
                        effect_counts.push(effects.count.u16())
                        signature_effects.extend(effects)
                        error_start: u32 = signature_errors.count.u32()
                        for annotation in file.enum_annotations |signature_errors, pos|:
                            signature_errors.push(annotation.name) if annotation.owner == "__error_set_family" and annotation.line == pos.line and annotation.name != ""
                        if signature_errors.count.u32() == error_start:
                            for error_index in 0..<file.error_set_func_lines.count |file, pos, signature_errors|:
                                signature_errors.push(file.error_set_func_names[error_index]) if file.error_set_func_lines[error_index] == pos.line and file.error_set_func_names[error_index] != ""
                        error_starts.push(error_start)
                        error_counts.push((signature_errors.count.u32() - error_start).u16())
                    _:
                        pass
            functions: mutable darray[Function] = []
            issues: mutable darray[LowerIssue] = []
            for declaration in file.top_decls |functions, issues, names, returns, parameter_starts, parameter_counts, parameter_types, parameter_names, parameter_has_defaults, parameter_defaults, effect_starts, effect_counts, signature_effects, error_starts, error_counts, signature_errors|:
                match declaration:
                    Decl.Func(name, params, return_type_opt, body, effects, decorators, pos):
                        function_index: usize = functions.count
                        functions.push(lower_function(name, params, return_type_opt, body, effects, error_starts[function_index], error_counts[function_index], pos, names, returns, parameter_starts, parameter_counts, parameter_types, parameter_names, parameter_has_defaults, parameter_defaults, effect_starts, effect_counts, signature_effects, error_starts, error_counts, signature_errors, handlers, file.enum_annotations, type_table, issues))
                    _:
                        issues.push(LowerIssue{kind: LowerIssueKind.UnsupportedDeclaration, function: "", line: 0, message: "declaration is not in the initial IR lowering subset"})
            lowered_handlers: mutable darray[Handler] = []
            lowered_handlers.extend(handlers)
            lowered_module: mutable Module = Module{name: module_name, functions: functions, handlers: lowered_handlers}
            intern_module_types(lowered_module)
            return LowerResult{module: lowered_module, issues: issues}


        def lower_file(file: Ast::File&, module_name: sview) -> LowerResult can[Memory.Allocate, Abort.Panic]:
            handlers: darray[Handler] = []
            return lower_file_with_handlers(file, module_name, handlers)
