include "../../vendor/elisa-compiler/src/parser/parser.elisa"

using Ast
using Lexer


extend EsIr:
    public:
        const enum LowerIssueKind of u8:
            UnsupportedDeclaration
            UnsupportedStatement
            UnsupportedExpression
            UnknownBinding
            UnknownCallee
            UnknownType
            MissingReturn
            LoopControlOutsideLoop
            UnsupportedLoopLabel
            UnsupportedAssignmentTarget
            ImmutableBinding
            MutableMergePending
            TypeMismatch


        struct LowerIssue:
            function: sview
            message: sview
            line: u32
            kind: LowerIssueKind


        struct LowerResult:
            module: Module
            issues: darray[LowerIssue]


    private:
        struct LoweredValue:
            valid: bool
            value: u32
            type: Type


        struct RangeMembership:
            value: LoweredValue
            recognized: bool


        struct LowerState:
            terminator: mutable Terminator
            blocks: mutable darray[Block]
            names: mutable darray[sview]
            values: mutable darray[u32]
            types: mutable darray[Type]
            mutables: mutable darray[bool]
            instructions: mutable darray[Instruction]
            operand_pool: mutable darray[u32]
            edge_arg_pool: mutable darray[u32]
            issues: mutable darray[LowerIssue]
            break_targets: mutable darray[u32]
            continue_targets: mutable darray[u32]
            pending_parameter_blocks: mutable darray[u32]
            pending_parameters: mutable darray[Parameter]
            block_parameter_pool: mutable darray[Parameter]
            loop_context_starts: mutable darray[u32]
            loop_context_counts: mutable darray[u16]
            loop_carried_indices: mutable darray[u32]
            loop_handler_depths: mutable darray[u32]
            element_binding_indices: mutable darray[u32]
            element_owner_indices: mutable darray[u32]
            element_index_values: mutable darray[u32]
            active_handlers: mutable darray[sview]
            function: sview
            function_names: darray[sview]&
            function_returns: darray[Type]&
            function_parameter_starts: darray[u32]&
            function_parameter_counts: darray[u16]&
            function_parameter_types: darray[Type]&
            function_parameter_names: darray[sview]&
            function_parameter_has_defaults: darray[bool]&
            function_parameter_defaults: darray[Ast::Expr]&
            function_effect_starts: darray[u32]&
            function_effect_counts: darray[u16]&
            function_effects: darray[sview]&
            function_errors: darray[sview]&
            handlers: darray[Handler]&
            function_return_type: Type
            required_effects: mutable darray[sview]
            required_errors: mutable darray[sview]
            next_value: mutable u32
            current_block: mutable u32
            next_block: mutable u32
            instruction_start: mutable u32
            structured_depth: mutable u32
            terminated: mutable bool


        def zero_span() -> SourceSpan:
            return SourceSpan{file: "", line: 0, column: 0, end_line: 0, end_column: 0}


        def ir_span(pos: Ast::Pos&) -> SourceSpan:
            return SourceSpan{file: "", line: pos.line, column: pos.column, end_line: pos.end_line, end_column: pos.end_column}


        def trace_hash_text(hash: u64, text: sview) -> u64:
            value: mutable u64 = hash
            for byte in text |value|:
                value <- (value ^ byte.u64()) * 1099511628211
            return value


        def trace_site(state: LowerState&, label: sview, pos: Ast::Pos&) -> TraceSite:
            hash: mutable u64 = trace_hash_text(1469598103934665603, state.function)
            hash <- trace_hash_text(hash, label)
            hash <- (hash ^ pos.line.u64()) * 1099511628211
            hash <- (hash ^ pos.column.u64()) * 1099511628211
            hash <- 1 if hash == 0
            return TraceSite{id: hash, label: label}


        def effect_family(reference: sview) -> sview:
            for index in 0..<sview_len(reference) |reference|:
                reference[0:index] return if sview_at(reference, index) == 46
            return reference


        def effect_operation(reference: sview) -> sview:
            for index in 0..<sview_len(reference) |reference|:
                reference[index + 1:sview_len(reference)] return if sview_at(reference, index) == 46
            return "signal"


        def void_ir_type() -> Type:
            return Type{name: "", bits: 0, kind: TypeKind.Void, signed: false}


        def unknown_ir_type() -> Type:
            return Type{name: "", bits: 0, kind: TypeKind.Named, signed: false}


        def type_from_name(name: sview) -> Type:
            Type{name: "", bits: 0, kind: TypeKind.Void, signed: false} return if name == "void"
            Type{name: "", bits: 1, kind: TypeKind.Bool, signed: false} return if name == "bool"
            Type{name: "", bits: 8, kind: TypeKind.Char, signed: false} return if name == "char"
            Type{name: "", bits: 8, kind: TypeKind.Int, signed: false} return if name == "u8"
            Type{name: "", bits: 16, kind: TypeKind.Int, signed: false} return if name == "u16"
            Type{name: "", bits: 32, kind: TypeKind.Int, signed: false} return if name == "u32"
            Type{name: "", bits: 64, kind: TypeKind.Int, signed: false} return if name == "u" or name == "u64" or name == "usize"
            Type{name: "", bits: 8, kind: TypeKind.Int, signed: true} return if name == "i8"
            Type{name: "", bits: 16, kind: TypeKind.Int, signed: true} return if name == "i16"
            Type{name: "", bits: 32, kind: TypeKind.Int, signed: true} return if name == "i32"
            Type{name: "", bits: 64, kind: TypeKind.Int, signed: true} return if name == "i64" or name == "isize" or name == "int"
            Type{name: "", bits: 32, kind: TypeKind.Float, signed: true} return if name == "f32"
            Type{name: "", bits: 64, kind: TypeKind.Float, signed: true} return if name == "f64" or name == "float"
            Type{name: "", bits: 0, kind: TypeKind.Text, signed: false} return if name == "sview" or name == "cstr" or name == "dstr" or name == "Text"
            return Type{name: name, bits: 0, kind: TypeKind.Named, signed: false}


        def typed_literal_type(prefix: sview) -> Type:
            Type{kind: TypeKind.Named, name: "Path"} return if prefix == "path"
            Type{kind: TypeKind.Named, name: "Glob"} return if prefix == "glob"
            Type{kind: TypeKind.Named, name: "Regex"} return if prefix == "regex"
            Type{kind: TypeKind.Named, name: "Executable"} return if prefix == "exe"
            Type{kind: TypeKind.Named, name: "Url"} return if prefix == "url"
            return unknown_ir_type()


        def compiler_typed_literal(prefix: sview) -> bool:
            return prefix in {"path", "glob", "regex", "exe", "url"}


        def positive_integer_literal_fits(value: i64, type: Type&) -> bool:
            false return if type.kind != TypeKind.Int
            return not type.signed and type.bits == 64 if value < 0
            return true if type.bits == 64
            if type.signed:
                return value <= 127 if type.bits == 8
                return value <= 32767 if type.bits == 16
                return value <= 2147483647 if type.bits == 32
                return false
            return value <= 255 if type.bits == 8
            return value <= 65535 if type.bits == 16
            return value <= 4294967295 if type.bits == 32
            return false


        def negative_integer_literal_fits(magnitude: i64, type: Type&) -> bool:
            false return if type.kind != TypeKind.Int or not type.signed or magnitude < 0
            return magnitude <= 128 if type.bits == 8
            return magnitude <= 32768 if type.bits == 16
            return magnitude <= 2147483648 if type.bits == 32
            return true if type.bits == 64
            return false


        def type_from_expression(expression: Ast::Expr) -> Type:
            match expression:
                Expr.Ident(name, pos):
                    return type_from_name(name)
                Expr.Unary(operator, operand, pos):
                    return type_from_expression(operand)
                Expr.Index(collection, element_expression, pos):
                    match collection:
                        Expr.Ident(name, collection_pos):
                            if name == "array" or name == "Array" or name == "darray":
                                element_type: Type = type_from_expression(element_expression)
                                return array_ir_type(element_type)
                        _:
                            pass
                    return unknown_ir_type()
                _:
                    return unknown_ir_type()


        def mutable_binding_type(expression: Ast::Expr) -> bool:
            match expression:
                Expr.Unary(operator, operand, pos):
                    return true if operator == TokenKind.Mutable
                    return mutable_binding_type(operand)
                _:
                    return false


        def array_ir_type(element: Type&) -> Type:
            return Type{kind: TypeKind.Array, element_kind: element.kind, element_name: element.name, element_bits: element.bits, element_signed: element.signed}


        def owned_ir_type(value: Type&) -> Type:
            return Type{kind: value.kind, name: value.name, bits: value.bits, signed: value.signed, element_kind: value.element_kind, element_name: value.element_name, element_bits: value.element_bits, element_signed: value.element_signed}


        def fresh_value(state: mutable LowerState&) -> u32:
            value: u32 = state.next_value
            state.next_value <- state.next_value + 1
            return value


        def fresh_block(state: mutable LowerState&) -> u32:
            block: u32 = state.next_block
            state.next_block <- state.next_block + 1
            return block


        def finish_block(state: mutable LowerState&) -> void can[Memory.Allocate, Abort.Panic]:
            parameter_start: u32 = state.block_parameter_pool.count.u32()
            parameter_count: mutable u16 = 0
            for index in 0..<state.pending_parameter_blocks.count |state, parameter_count|:
                if state.pending_parameter_blocks[index] == state.current_block:
                    state.block_parameter_pool.push(state.pending_parameters[index])
                    parameter_count <- parameter_count + 1
            state.blocks.push(Block{id: state.current_block, parameter_start: parameter_start, parameter_count: parameter_count, instruction_start: state.instruction_start, instruction_count: state.instructions.count.u32() - state.instruction_start, terminator: state.terminator})
            state.terminator <- Terminator{kind: TerminatorKind.Unreachable, span: zero_span()}
            state.current_block <- 0
            state.instruction_start <- state.instructions.count.u32()


        def add_issue(state: mutable LowerState&, kind: LowerIssueKind, line: u32, message: sview) -> void can[Memory.Allocate, Abort.Panic]:
            state.issues.push(LowerIssue{kind: kind, function: state.function, line: line, message: message})


        def lookup_binding(state: LowerState&, name: sview) -> LoweredValue:
            while index > 0 |index: usize = state.names.count|:
                index <- index - 1
                LoweredValue{valid: true, value: state.values[index], type: state.types[index]} return if state.names[index] == name
            return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}


        def binding_index(state: LowerState&, name: sview) -> usize:
            while index > 0 |index: usize = state.names.count|:
                index <- index - 1
                index return if state.names[index] == name
            return state.names.count


        def add_unique_name(names: mutable darray[sview]&, name: sview) -> void can[Memory.Allocate, Abort.Panic]:
            names.push(name) if name != "" and not any existing in names where existing == name


        def add_handler_contract(state: mutable LowerState&, handler_name: sview) -> void can[Memory.Allocate, Abort.Panic]:
            index: usize = handler_index(state.handlers, handler_name)
            if index < state.handlers.count:
                for effect in state.handlers[index].introduces_effects |state|:
                    state.required_effects.push(effect) if effect != "" and not has_text(state.required_effects, effect)
                for error_set in state.handlers[index].errors |state|:
                    state.required_errors.push(error_set) if error_set != "" and not has_text(state.required_errors, error_set)


        def emit_handler_unwind(state: mutable LowerState&, target_depth: usize, pos: Ast::Pos&) -> void can[Memory.Allocate, Abort.Panic]:
            while handler_index > target_depth |handler_index: usize = state.active_handlers.count|:
                handler_index <- handler_index - 1
                state.instructions.push(Instruction{opcode: Opcode.HandlerPop, result: 0, result_type: void_ir_type(), symbol: state.active_handlers[handler_index], trace: trace_site(state, "handler-unwind", pos), span: ir_span(pos)})


        def synchronize_mutable_element(state: mutable LowerState&, binding: usize, pos: Ast::Pos&) -> void can[Memory.Allocate, Abort.Panic]:
            for relation in 0..<state.element_binding_indices.count |state, binding|:
                if state.element_binding_indices[relation].usize() == binding:
                    owner: usize = state.element_owner_indices[relation].usize()
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(state.values[owner])
                    state.operand_pool.push(state.element_index_values[relation])
                    state.operand_pool.push(state.values[binding])
                    state.instructions.push(Instruction{opcode: Opcode.SetIndex, result: result, result_type: state.types[owner], operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
                    state.values[owner] <- result
                    return


        def supported_assignment_operator(operator: TokenKind) -> bool:
            return operator in {TokenKind.LArrow, TokenKind.PlusEq, TokenKind.MinusEq, TokenKind.StarEq, TokenKind.SlashEq, TokenKind.PercentEq, TokenKind.AmpEq, TokenKind.PipeEq, TokenKind.CaretEq, TokenKind.LShiftEq, TokenKind.RShiftEq}


        def compound_opcode(operator: TokenKind) -> Opcode:
            Opcode.Add return if operator == TokenKind.PlusEq
            Opcode.Subtract return if operator == TokenKind.MinusEq
            Opcode.Multiply return if operator == TokenKind.StarEq
            Opcode.Divide return if operator == TokenKind.SlashEq
            Opcode.Remainder return if operator == TokenKind.PercentEq
            Opcode.BitAnd return if operator == TokenKind.AmpEq
            Opcode.BitOr return if operator == TokenKind.PipeEq
            Opcode.BitXor return if operator == TokenKind.CaretEq
            Opcode.ShiftLeft return if operator == TokenKind.LShiftEq
            Opcode.ShiftRight return if operator == TokenKind.RShiftEq
            return Opcode.Copy


        def collect_assigned_names(statements: darray[Ast::Stmt]&, names: mutable darray[sview]&) -> void can[Memory.Allocate, Abort.Panic]:
            for statement in statements |names|:
                match statement:
                    Stmt.Expr(expression, pos):
                        match expression:
                            Expr.Call(Expr.Field(Expr.Ident(name, ident_pos), method, field_pos), arguments, argument_names, call_pos):
                                add_unique_name(names, name) if method == "push" or method == "extend"
                            _:
                                pass
                    Stmt.Assign(target, operator, value, pos):
                        match target:
                            Expr.Ident(name, target_pos):
                                add_unique_name(names, name) if supported_assignment_operator(operator)
                            Expr.Index(Expr.Ident(name, target_pos), index_expression, index_pos):
                                add_unique_name(names, name) if supported_assignment_operator(operator)
                            _:
                                pass
                    Stmt.If(condition, then_body, else_body, pos):
                        collect_assigned_names(then_body, names)
                        collect_assigned_names(else_body, names)
                    Stmt.While(condition, body, pos):
                        collect_assigned_names(body, names)
                    Stmt.For(bind, variables, iterable, body, pos):
                        collect_assigned_names(body, names)
                    Stmt.Match(scrutinee, arms, pos):
                        for arm in arms |names|:
                            collect_assigned_names(arm.body, names)
                    Stmt.Block(kind, clause, binding, body, pos):
                        collect_assigned_names(body, names)
                    _:
                        pass


        def include_mutable_element_owners(state: LowerState&, names: mutable darray[sview]&) -> void can[Memory.Allocate, Abort.Panic]:
            assigned_count: usize = names.count
            for assigned in 0..<assigned_count |state, names|:
                binding: usize = binding_index(state, names[assigned])
                for relation in 0..<state.element_binding_indices.count |state, names, binding|:
                    if state.element_binding_indices[relation].usize() == binding:
                        owner: usize = state.element_owner_indices[relation].usize()
                        add_unique_name(names, state.names[owner])


        def append_context_arguments(state: mutable LowerState&, context: usize) -> (start: u32, count: u16) can[Memory.Allocate, Abort.Panic]:
            start: u32 = state.edge_arg_pool.count.u32()
            carried_start: usize = state.loop_context_starts[context].usize()
            count: u16 = state.loop_context_counts[context]
            for offset in 0..<count.usize() |state, carried_start|:
                binding: usize = state.loop_carried_indices[carried_start + offset].usize()
                state.edge_arg_pool.push(state.values[binding])
            return (start, count)


        def lookup_return_type(state: LowerState&, name: sview) -> LoweredValue:
            for index in 0..<state.function_names.count |state|:
                LoweredValue{valid: true, value: 0, type: state.function_returns[index]} return if state.function_names[index] == name
            return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}


        def lowered_function_index(state: LowerState&, name: sview) -> usize:
            for index in 0..<state.function_names.count |state, name|:
                index return if state.function_names[index] == name
            return state.function_names.count


        def emit_constant(state: mutable LowerState&, type: Type, integer: i64, decimal: sview, text: sview, boolean: bool, span: SourceSpan) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result: u32 = fresh_value(state)
            state.instructions.push(Instruction{opcode: Opcode.Constant, result: result, result_type: type, integer: integer, decimal: decimal, text: text, boolean: boolean, span: span})
            return LoweredValue{valid: true, value: result, type: type}


        def emit_comparison(state: mutable LowerState&, opcode: Opcode, left: u32, right: u32, pos: Ast::Pos&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result: u32 = fresh_value(state)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(left)
            state.operand_pool.push(right)
            result_type: Type = type_from_name("bool")
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def emit_binary(state: mutable LowerState&, opcode: Opcode, left: u32, right: u32, result_type: Type, pos: Ast::Pos&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            result: u32 = fresh_value(state)
            operand_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(left)
            state.operand_pool.push(right)
            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
            return LoweredValue{valid: true, value: result, type: result_type}


        def lower_range_membership(needle: LoweredValue, range_expression: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&) -> RangeMembership can[Memory.Allocate, Abort.Panic]:
            low_expression: mutable Ast::Expr = Expr.Absent
            high_expression: mutable Ast::Expr = Expr.Absent
            step_expression: mutable Ast::Expr = Expr.Absent
            operator: mutable TokenKind = TokenKind.Range
            recognized: mutable bool = false
            stepped: mutable bool = false
            match range_expression:
                Expr.Binary(low, range_operator, high, range_pos):
                    if range_operator in {TokenKind.RangeLt, TokenKind.RangeLe, TokenKind.RangeGt}:
                        low_expression <- low
                        high_expression <- high
                        operator <- range_operator
                        recognized <- true
                    elif range_operator == TokenKind.Range:
                        match low:
                            Expr.Binary(inner_low, inner_operator, inner_high, inner_pos):
                                if inner_operator in {TokenKind.RangeLt, TokenKind.RangeLe, TokenKind.RangeGt}:
                                    low_expression <- inner_low
                                    high_expression <- inner_high
                                    step_expression <- high
                                    operator <- inner_operator
                                    recognized <- true
                                    stepped <- true
                            _:
                                pass
                _:
                    pass
            return RangeMembership{recognized: false, value: LoweredValue{valid: false, value: 0, type: type_from_name("bool")}} if not recognized
            low: LoweredValue = lower_expression_expected(low_expression, needle.type, state)
            high: LoweredValue = lower_expression_expected(high_expression, needle.type, state)
            if not low.valid or not high.valid or not same_type(needle.type, low.type) or not same_type(needle.type, high.type) or not numeric_type(needle.type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range membership requires matching numeric needle and bound types")
                return RangeMembership{recognized: true, value: LoweredValue{valid: false, value: 0, type: type_from_name("bool")}}
            step: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: needle.type}
            if stepped:
                positive_literal: mutable bool = false
                match step_expression:
                    Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                        positive_literal <- value > 0
                    _:
                        pass
                if needle.type.kind != TypeKind.Int or not positive_literal:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range membership stride must be a positive integer constant")
                    return RangeMembership{recognized: true, value: LoweredValue{valid: false, value: 0, type: type_from_name("bool")}}
                step <- lower_expression_expected(step_expression, needle.type, state)
                if not step.valid or not same_type(step.type, needle.type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range membership stride must match the needle type")
                    return RangeMembership{recognized: true, value: LoweredValue{valid: false, value: 0, type: type_from_name("bool")}}

            upper_test_block: u32 = fresh_block(state)
            false_block: u32 = fresh_block(state)
            true_block: u32 = fresh_block(state)
            merge_block: u32 = fresh_block(state)
            success_block: mutable u32 = true_block
            alignment_block: mutable u32 = 0
            if stepped:
                alignment_block <- fresh_block(state)
                success_block <- alignment_block
            first_opcode: Opcode = Opcode.LessEqual if operator == TokenKind.RangeGt else Opcode.GreaterEqual
            first: LoweredValue = emit_comparison(state, first_opcode, needle.value, low.value, pos)
            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: first.value, operand_count: 1, target0: upper_test_block, target1: false_block, target_count: 2, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- upper_test_block
            state.terminated <- false
            second_opcode: Opcode = Opcode.Greater if operator == TokenKind.RangeGt else (Opcode.LessEqual if operator == TokenKind.RangeLe else Opcode.Less)
            second: LoweredValue = emit_comparison(state, second_opcode, needle.value, high.value, pos)
            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: second.value, operand_count: 1, target0: success_block, target1: false_block, target_count: 2, span: ir_span(pos)}
            finish_block(state)

            if stepped:
                state.current_block <- alignment_block
                state.terminated <- false
                offset: LoweredValue = emit_binary(state, Opcode.Subtract, low.value, needle.value, needle.type, pos) if operator == TokenKind.RangeGt else emit_binary(state, Opcode.Subtract, needle.value, low.value, needle.type, pos)
                remainder: LoweredValue = emit_binary(state, Opcode.Remainder, offset.value, step.value, needle.type, pos)
                zero: LoweredValue = emit_constant(state, needle.type, 0, "", "", false, ir_span(pos))
                aligned: LoweredValue = emit_comparison(state, Opcode.Equal, remainder.value, zero.value, pos)
                state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: aligned.value, operand_count: 1, target0: true_block, target1: false_block, target_count: 2, span: ir_span(pos)}
                finish_block(state)

            state.current_block <- true_block
            state.terminated <- false
            true_value: LoweredValue = emit_constant(state, type_from_name("bool"), 0, "", "", true, ir_span(pos))
            true_edge: u32 = state.edge_arg_pool.count.u32()
            state.edge_arg_pool.push(true_value.value)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: true_edge, edge0_arg_count: 1, span: ir_span(pos)}
            finish_block(state)

            state.current_block <- false_block
            state.terminated <- false
            false_value: LoweredValue = emit_constant(state, type_from_name("bool"), 0, "", "", false, ir_span(pos))
            false_edge: u32 = state.edge_arg_pool.count.u32()
            state.edge_arg_pool.push(false_value.value)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: false_edge, edge0_arg_count: 1, span: ir_span(pos)}
            finish_block(state)

            result: u32 = fresh_value(state)
            result_type: Type = type_from_name("bool")
            state.pending_parameter_blocks.push(merge_block)
            state.pending_parameters.push(Parameter{value: result, type: result_type, name: "range-membership"})
            state.current_block <- merge_block
            state.terminated <- false
            return RangeMembership{recognized: true, value: LoweredValue{valid: true, value: result, type: result_type}}


        def lower_expression(expression: Ast::Expr, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            match expression:
                Expr.IntLit(value):
                    return emit_constant(state, type_from_name("i64"), value, "", "", false, zero_span())
                Expr.IntLitTyped(value, suffix):
                    literal_type: Type = type_from_name(suffix)
                    if not positive_integer_literal_fits(value, literal_type):
                        add_issue(state, LowerIssueKind.TypeMismatch, 0, "integer literal is outside its explicit suffix range")
                        return LoweredValue{valid: false, value: 0, type: literal_type}
                    return emit_constant(state, literal_type, value, "", "", false, zero_span())
                Expr.FloatLit(text):
                    return emit_constant(state, type_from_name("f64"), 0, text, "", false, zero_span())
                Expr.StringLit(text):
                    return emit_constant(state, type_from_name("sview"), 0, "", text, false, zero_span())
                Expr.CharLit(text):
                    return emit_constant(state, type_from_name("char"), 0, "", text, false, zero_span())
                Expr.BoolLit(value):
                    return emit_constant(state, type_from_name("bool"), 0, "", "", value, zero_span())
                Expr.Ident(name, pos):
                    binding: LoweredValue = lookup_binding(state, name)
                    add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "identifier has no lowered local binding") if not binding.valid
                    return binding
                Expr.Paren(inner, pos):
                    return lower_expression(inner, state)
                Expr.Block(statements, value, captures, pos):
                    if captures.count != 0:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "capturing value blocks require ownership-aware closure lowering")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    scope_mark: usize = state.names.count
                    for statement in statements |state|:
                        lower_statement(statement, state.function_return_type, state)
                    if state.terminated:
                        state.names.truncate(scope_mark)
                        state.values.truncate(scope_mark)
                        state.types.truncate(scope_mark)
                        state.mutables.truncate(scope_mark)
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    lowered_value: LoweredValue = lower_expression(value, state)
                    state.names.truncate(scope_mark)
                    state.values.truncate(scope_mark)
                    state.types.truncate(scope_mark)
                    state.mutables.truncate(scope_mark)
                    return lowered_value
                Expr.Array(elements, pos):
                    if elements.count == 0:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "empty array literals require an explicit element type")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    element_type: mutable Type = unknown_ir_type()
                    valid: mutable bool = true
                    element_values: mutable darray[u32] = []
                    for index in 0..<elements.count |elements, state, element_type, valid, element_values|:
                        element: LoweredValue = lower_expression(elements[index], state)
                        if not element.valid:
                            valid <- false
                        else:
                            element_type <- element.type if index == 0
                            if index > 0 and not same_type(element_type, element.type):
                                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "array literal elements must have one static type")
                                valid <- false
                            element_values.push(element.value)
                    if element_type.kind == TypeKind.Array:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "nested array type metadata is not implemented yet")
                        valid <- false
                    LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not valid
                    result_type: Type = array_ir_type(element_type)
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.extend(element_values)
                    state.instructions.push(Instruction{opcode: Opcode.MakeArray, result: result, result_type: result_type, operand_start: operand_start, operand_count: elements.count.u16(), span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: result_type}
                Expr.Index(collection, index_expression, pos):
                    lowered_collection: LoweredValue = lower_expression(collection, state)
                    lowered_index: LoweredValue = lower_expression(index_expression, state)
                    LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not lowered_collection.valid or not lowered_index.valid
                    if lowered_collection.type.kind != TypeKind.Array and lowered_collection.type.kind != TypeKind.Text:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "index lowering requires an array or text value")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    if lowered_index.type.kind != TypeKind.Int:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "collection index must have an integer type")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    result_type: Type = type_from_name("char") if lowered_collection.type.kind == TypeKind.Text else array_element_type(lowered_collection.type)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(lowered_collection.value)
                    state.operand_pool.push(lowered_index.value)
                    result: u32 = fresh_value(state)
                    state.instructions.push(Instruction{opcode: Opcode.Index, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: result_type}
                Expr.Slice(collection, low_expression, high_expression, pos):
                    lowered_collection: LoweredValue = lower_expression(collection, state)
                    LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not lowered_collection.valid
                    if lowered_collection.type.kind not in {TypeKind.Array, TypeKind.Text}:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "slice lowering requires an array or text value")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    bound_type: Type = type_from_name("usize")
                    low: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: bound_type}
                    match low_expression:
                        Expr.Absent:
                            low <- emit_constant(state, bound_type, 0, "", "", false, ir_span(pos))
                        _:
                            low <- lower_expression(low_expression, state)
                    high: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: bound_type}
                    match high_expression:
                        Expr.Absent:
                            high_result: u32 = fresh_value(state)
                            high_operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(lowered_collection.value)
                            state.instructions.push(Instruction{opcode: Opcode.Length, result: high_result, result_type: bound_type, operand_start: high_operand_start, operand_count: 1, span: ir_span(pos)})
                            high <- LoweredValue{valid: true, value: high_result, type: bound_type}
                        _:
                            high <- lower_expression(high_expression, state)
                    LoweredValue{valid: false, value: 0, type: lowered_collection.type} return if not low.valid or not high.valid
                    if low.type.kind != TypeKind.Int or high.type.kind != TypeKind.Int:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "slice bounds must have integer types")
                        return LoweredValue{valid: false, value: 0, type: lowered_collection.type}
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(lowered_collection.value)
                    state.operand_pool.push(low.value)
                    state.operand_pool.push(high.value)
                    result: u32 = fresh_value(state)
                    state.instructions.push(Instruction{opcode: Opcode.Slice, result: result, result_type: lowered_collection.type, operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: lowered_collection.type}
                Expr.Field(collection, field, pos):
                    lowered_collection: LoweredValue = lower_expression(collection, state)
                    LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not lowered_collection.valid
                    if field != "count" or lowered_collection.type.kind not in {TypeKind.Array, TypeKind.Text}:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "field lowering supports array.count and text.count")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    result_type: Type = type_from_name("usize")
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(lowered_collection.value)
                    result: u32 = fresh_value(state)
                    state.instructions.push(Instruction{opcode: Opcode.Length, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: result_type}
                Expr.Unary(operator, operand, pos):
                    if operator == TokenKind.Minus:
                        match operand:
                            Expr.IntLitTyped(magnitude, suffix):
                                literal_type: Type = type_from_name(suffix)
                                if not negative_integer_literal_fits(magnitude, literal_type):
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "negative integer literal is outside its explicit signed suffix range")
                                    return LoweredValue{valid: false, value: 0, type: literal_type}
                                return emit_constant(state, literal_type, 0 - magnitude, "", "", false, ir_span(pos))
                            _:
                                pass
                    lowered_operand: LoweredValue = lower_expression(operand, state)
                    LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not lowered_operand.valid
                    if operator == TokenKind.Plus:
                        return lowered_operand
                    opcode: mutable Opcode = Opcode.Negate
                    supported: mutable bool = operator == TokenKind.Minus or operator == TokenKind.Not or operator == TokenKind.Bang or operator == TokenKind.Tilde
                    opcode <- Opcode.Not if operator == TokenKind.Not or operator == TokenKind.Bang
                    opcode <- Opcode.BitNot if operator == TokenKind.Tilde
                    if not supported:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "unary operator is not in the core IR lowering subset")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    if opcode == Opcode.Negate and not numeric_type(lowered_operand.type):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "numeric negation requires an integer or floating-point operand")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    if opcode == Opcode.Negate and lowered_operand.type.kind == TypeKind.Int and not lowered_operand.type.signed:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "numeric negation requires a signed integer or floating-point operand")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    if opcode == Opcode.Not and lowered_operand.type.kind != TypeKind.Bool:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "boolean negation requires a boolean operand")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    if opcode == Opcode.BitNot and lowered_operand.type.kind != TypeKind.Int:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "bitwise complement requires an integer operand")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    result_type: Type = type_from_name("bool") if opcode == Opcode.Not else lowered_operand.type
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(lowered_operand.value)
                    state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: result_type}
                Expr.Binary(left, operator, right, pos):
                    lowered_left: LoweredValue = lower_expression(left, state)
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not lowered_left.valid
                        if lowered_left.type.kind != TypeKind.Bool:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "short-circuit operators require boolean operands")
                            return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                        right_block: u32 = fresh_block(state)
                        short_block: u32 = fresh_block(state)
                        merge_block: u32 = fresh_block(state)
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: lowered_left.value, operand_count: 1, target0: (right_block if operator == TokenKind.And else short_block), target1: (short_block if operator == TokenKind.And else right_block), target_count: 2, span: ir_span(pos)}
                        finish_block(state)

                        state.current_block <- right_block
                        state.terminated <- false
                        lowered_right: LoweredValue = lower_expression(right, state)
                        right_valid: mutable bool = lowered_right.valid
                        if lowered_right.valid and lowered_right.type.kind != TypeKind.Bool:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "short-circuit operators require boolean operands")
                            right_valid <- false
                        if right_valid:
                            right_edge_start: u32 = state.edge_arg_pool.count.u32()
                            state.edge_arg_pool.push(lowered_right.value)
                            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: right_edge_start, edge0_arg_count: 1, span: ir_span(pos)}
                        finish_block(state)

                        state.current_block <- short_block
                        state.terminated <- false
                        short_value: LoweredValue = emit_constant(state, type_from_name("bool"), 0, "", "", operator == TokenKind.Or, ir_span(pos))
                        short_edge_start: u32 = state.edge_arg_pool.count.u32()
                        state.edge_arg_pool.push(short_value.value)
                        state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: short_edge_start, edge0_arg_count: 1, span: ir_span(pos)}
                        finish_block(state)

                        result: u32 = fresh_value(state)
                        result_type: Type = type_from_name("bool")
                        state.pending_parameter_blocks.push(merge_block)
                        state.pending_parameters.push(Parameter{value: result, type: result_type, name: "short-circuit"})
                        state.current_block <- merge_block
                        state.terminated <- false
                        return LoweredValue{valid: right_valid, value: result, type: result_type}
                    if operator == TokenKind.In and lowered_left.valid:
                        range_membership: RangeMembership = lower_range_membership(lowered_left, right, pos, state)
                        return range_membership.value if range_membership.recognized
                    lowered_right: LoweredValue = lower_expression(right, state)
                    LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not lowered_left.valid or not lowered_right.valid
                    if operator == TokenKind.In:
                        if lowered_right.type.kind not in {TypeKind.Array, TypeKind.Text}:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "membership right operand must be an array or text value")
                            return LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
                        element_type: Type = array_element_type(lowered_right.type)
                        valid_needle: bool = same_type(lowered_left.type, element_type) if lowered_right.type.kind == TypeKind.Array else lowered_left.type.kind in {TypeKind.Char, TypeKind.Text}
                        if not valid_needle:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "membership needle type does not match the collection element type")
                            return LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
                        result: u32 = fresh_value(state)
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(lowered_left.value)
                        state.operand_pool.push(lowered_right.value)
                        result_type: Type = type_from_name("bool")
                        state.instructions.push(Instruction{opcode: Opcode.Contains, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if operator == TokenKind.Plus and lowered_left.type.kind in {TypeKind.Array, TypeKind.Text}:
                        if not same_type(lowered_left.type, lowered_right.type):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "concatenation operands must have the same array or text type")
                            return LoweredValue{valid: false, value: 0, type: lowered_left.type}
                        result: u32 = fresh_value(state)
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(lowered_left.value)
                        state.operand_pool.push(lowered_right.value)
                        state.instructions.push(Instruction{opcode: Opcode.Concat, result: result, result_type: lowered_left.type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: lowered_left.type}
                    opcode: mutable Opcode = Opcode.Add
                    supported: mutable bool = true
                    opcode <- Opcode.Add if operator == TokenKind.Plus
                    opcode <- Opcode.Subtract if operator == TokenKind.Minus
                    opcode <- Opcode.Multiply if operator == TokenKind.Star
                    opcode <- Opcode.Divide if operator == TokenKind.Slash
                    opcode <- Opcode.Remainder if operator == TokenKind.Percent
                    opcode <- Opcode.Equal if operator == TokenKind.EqEq
                    opcode <- Opcode.NotEqual if operator == TokenKind.BangEq
                    opcode <- Opcode.Less if operator == TokenKind.Lt
                    opcode <- Opcode.LessEqual if operator == TokenKind.LtEq
                    opcode <- Opcode.Greater if operator == TokenKind.Gt
                    opcode <- Opcode.GreaterEqual if operator == TokenKind.GtEq
                    opcode <- Opcode.BitAnd if operator == TokenKind.Ampersand
                    opcode <- Opcode.BitOr if operator == TokenKind.Pipe
                    opcode <- Opcode.BitXor if operator == TokenKind.Caret
                    opcode <- Opcode.ShiftLeft if operator == TokenKind.LShift
                    opcode <- Opcode.ShiftRight if operator == TokenKind.RShift
                    supported <- false if operator not in {TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent, TokenKind.EqEq, TokenKind.BangEq, TokenKind.Lt, TokenKind.LtEq, TokenKind.Gt, TokenKind.GtEq, TokenKind.Ampersand, TokenKind.Pipe, TokenKind.Caret, TokenKind.LShift, TokenKind.RShift}
                    if not supported:
                        add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "binary operator is not in the initial IR lowering subset")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    comparison: bool = operator in {TokenKind.EqEq, TokenKind.BangEq, TokenKind.Lt, TokenKind.LtEq, TokenKind.Gt, TokenKind.GtEq}
                    operands_match: bool = same_type(lowered_left.type, lowered_right.type)
                    arithmetic: bool = operator in {TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent}
                    equality: bool = operator == TokenKind.EqEq or operator == TokenKind.BangEq
                    ordering: bool = operator in {TokenKind.Lt, TokenKind.LtEq, TokenKind.Gt, TokenKind.GtEq}
                    bitwise: bool = operator in {TokenKind.Ampersand, TokenKind.Pipe, TokenKind.Caret, TokenKind.LShift, TokenKind.RShift}
                    valid_arithmetic: bool = arithmetic and operands_match and numeric_type(lowered_left.type) and (operator != TokenKind.Percent or lowered_left.type.kind == TypeKind.Int)
                    valid_equality: bool = equality and operands_match and equality_type(lowered_left.type)
                    valid_ordering: bool = ordering and operands_match and numeric_type(lowered_left.type)
                    valid_bitwise: bool = bitwise and operands_match and lowered_left.type.kind == TypeKind.Int
                    if not valid_arithmetic and not valid_equality and not valid_ordering and not valid_bitwise:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "binary operands do not have compatible static types for this operator")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    result_type: Type = type_from_name("bool") if comparison else lowered_left.type
                    result: u32 = fresh_value(state)
                    operand_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(lowered_left.value)
                    state.operand_pool.push(lowered_right.value)
                    state.instructions.push(Instruction{opcode: opcode, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: result_type}
                Expr.If(condition, selected, alternative, pos):
                    lowered_condition: LoweredValue = lower_expression(condition, state)
                    LoweredValue{valid: false, value: 0, type: unknown_ir_type()} return if not lowered_condition.valid
                    if lowered_condition.type.kind != TypeKind.Bool:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "conditional expression requires a boolean condition")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    selected_block: u32 = fresh_block(state)
                    alternative_block: u32 = fresh_block(state)
                    merge_block: u32 = fresh_block(state)
                    state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: lowered_condition.value, operand_count: 1, target0: selected_block, target1: alternative_block, target_count: 2, span: ir_span(pos)}
                    finish_block(state)

                    state.current_block <- selected_block
                    state.terminated <- false
                    selected_value: LoweredValue = lower_expression(selected, state)
                    if selected_value.valid:
                        selected_edge_start: u32 = state.edge_arg_pool.count.u32()
                        state.edge_arg_pool.push(selected_value.value)
                        state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: selected_edge_start, edge0_arg_count: 1, span: ir_span(pos)}
                    finish_block(state)

                    state.current_block <- alternative_block
                    state.terminated <- false
                    alternative_value: LoweredValue = lower_expression(alternative, state)
                    alternative_valid: mutable bool = alternative_value.valid
                    if selected_value.valid and alternative_value.valid and not same_type(selected_value.type, alternative_value.type):
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "conditional expression branches must produce the same static type")
                        alternative_valid <- false
                    if alternative_valid:
                        alternative_edge_start: u32 = state.edge_arg_pool.count.u32()
                        state.edge_arg_pool.push(alternative_value.value)
                        state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: alternative_edge_start, edge0_arg_count: 1, span: ir_span(pos)}
                    finish_block(state)

                    result: u32 = fresh_value(state)
                    result_type: Type = selected_value.type
                    state.pending_parameter_blocks.push(merge_block)
                    state.pending_parameters.push(Parameter{value: result, type: result_type, name: "conditional"})
                    state.current_block <- merge_block
                    state.terminated <- false
                    return LoweredValue{valid: selected_value.valid and alternative_valid, value: result, type: result_type}
                Expr.Call(callee, arguments, argument_names, pos):
                    callee_name: mutable sview = ""
                    match callee:
                        Expr.Ident(name, callee_pos):
                            callee_name <- name
                        _:
                            pass
                    if callee_name == "observe":
                        if arguments.count != 1:
                            add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "observe requires exactly one value")
                            return LoweredValue{valid: false, value: 0, type: void_ir_type()}
                        observed: LoweredValue = lower_expression(arguments[0], state)
                        if observed.valid:
                            operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(observed.value)
                            state.instructions.push(Instruction{opcode: Opcode.Observe, result: 0, result_type: void_ir_type(), operand_start: operand_start, operand_count: 1, trace: trace_site(state, "observe", pos), span: ir_span(pos)})
                        return LoweredValue{valid: observed.valid, value: 0, type: void_ir_type()}
                    callee_index: usize = lowered_function_index(state, callee_name)
                    if callee_name == "matches" and callee_index == state.function_names.count:
                        valid_shape: bool = arguments.count == 2 and (argument_names.count == 0 or (argument_names[0] == "" and argument_names[1] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "matches requires text and one positional Regex value")
                            return LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
                        text_value: LoweredValue = lower_expression(arguments[0], state)
                        pattern_value: LoweredValue = lower_expression(arguments[1], state)
                        valid_types: bool = text_value.valid and pattern_value.valid and text_value.type.kind == TypeKind.Text and pattern_value.type.kind == TypeKind.Named and pattern_value.type.name == "Regex"
                        if not valid_types:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "matches requires an sview haystack and Regex pattern")
                            return LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(text_value.value)
                        state.operand_pool.push(pattern_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.RegexSearch, result: result, result_type: type_from_name("bool"), operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: type_from_name("bool")}
                    if callee_name == "split" and callee_index == state.function_names.count:
                        result_type: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Text}
                        valid_shape: bool = arguments.count == 2 and (argument_names.count == 0 or (argument_names[0] == "" and argument_names[1] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "split requires text and one positional text separator")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        text_value: LoweredValue = lower_expression(arguments[0], state)
                        separator_value: LoweredValue = lower_expression(arguments[1], state)
                        valid_types: bool = text_value.valid and separator_value.valid and text_value.type.kind == TypeKind.Text and separator_value.type.kind == TypeKind.Text
                        if not valid_types:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "split requires sview text and separator operands")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(text_value.value)
                        state.operand_pool.push(separator_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.Split, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_name == "join" and callee_index == state.function_names.count:
                        result_type: Type = type_from_name("sview")
                        valid_shape: bool = arguments.count == 2 and (argument_names.count == 0 or (argument_names[0] == "" and argument_names[1] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "join requires fields and one positional text separator")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        fields_value: LoweredValue = lower_expression(arguments[0], state)
                        separator_value: LoweredValue = lower_expression(arguments[1], state)
                        valid_fields: bool = fields_value.valid and fields_value.type.kind == TypeKind.Array and fields_value.type.element_kind == TypeKind.Text
                        valid_types: bool = valid_fields and separator_value.valid and separator_value.type.kind == TypeKind.Text
                        if not valid_types:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "join requires darray[sview] fields and an sview separator")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(fields_value.value)
                        state.operand_pool.push(separator_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.Join, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_name == "path_exists" and callee_index == state.function_names.count:
                        result_type: Type = type_from_name("bool")
                        valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or argument_names[0] == "")
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "path_exists requires one positional Path value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        path_value: LoweredValue = lower_expression(arguments[0], state)
                        valid_path: bool = path_value.valid and path_value.type.kind == TypeKind.Named and path_value.type.name == "Path"
                        if not valid_path:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "path_exists requires a nominal Path operand")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        state.required_effects.push("File.Read") if not has_text(state.required_effects, "File.Read")
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(path_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.PathExists, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_name == "read_text" and callee_index == state.function_names.count:
                        result_type: Type = type_from_name("sview")
                        valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or argument_names[0] == "")
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "read_text requires one positional Path value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        path_value: LoweredValue = lower_expression(arguments[0], state)
                        valid_path: bool = path_value.valid and path_value.type.kind == TypeKind.Named and path_value.type.name == "Path"
                        if not valid_path:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "read_text requires a nominal Path operand")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        state.required_effects.push("File.Read") if not has_text(state.required_effects, "File.Read")
                        state.required_errors.push("FileIoError") if not has_text(state.required_errors, "FileIoError")
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(path_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.ReadText, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_name == "write_text" and callee_index == state.function_names.count:
                        result_type: Type = type_from_name("usize")
                        valid_shape: bool = arguments.count == 2 and (argument_names.count == 0 or (argument_names[0] == "" and argument_names[1] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "write_text requires positional Path and sview values")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        path_value: LoweredValue = lower_expression(arguments[0], state)
                        text_value: LoweredValue = lower_expression(arguments[1], state)
                        valid_path: bool = path_value.valid and path_value.type.kind == TypeKind.Named and path_value.type.name == "Path"
                        valid_types: bool = valid_path and text_value.valid and text_value.type.kind == TypeKind.Text
                        if not valid_types:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "write_text requires nominal Path and sview operands")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        state.required_effects.push("File.Write") if not has_text(state.required_effects, "File.Write")
                        state.required_errors.push("FileIoError") if not has_text(state.required_errors, "FileIoError")
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(path_value.value)
                        state.operand_pool.push(text_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.WriteText, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_name == "remove_path" and callee_index == state.function_names.count:
                        result_type: Type = type_from_name("bool")
                        valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or argument_names[0] == "")
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "remove_path requires one positional Path value")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        path_value: LoweredValue = lower_expression(arguments[0], state)
                        valid_path: bool = path_value.valid and path_value.type.kind == TypeKind.Named and path_value.type.name == "Path"
                        if not valid_path:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "remove_path requires a nominal Path operand")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        state.required_effects.push("File.Write") if not has_text(state.required_effects, "File.Write")
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(path_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.RemovePath, result: result, result_type: result_type, operand_start: operand_start, operand_count: 1, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_name == "run_process" and callee_index == state.function_names.count:
                        result_type: Type = type_from_name("i64")
                        argument_array_type: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Text}
                        valid_shape: bool = arguments.count == 2 and (argument_names.count == 0 or (argument_names[0] == "" and argument_names[1] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "run_process requires positional Executable and darray[sview] values")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        executable_value: LoweredValue = lower_expression(arguments[0], state)
                        arguments_value: LoweredValue = lower_expression_expected(arguments[1], argument_array_type, state)
                        valid_executable: bool = executable_value.valid and executable_value.type.kind == TypeKind.Named and executable_value.type.name == "Executable"
                        valid_arguments: bool = arguments_value.valid and same_type(arguments_value.type, argument_array_type)
                        if not valid_executable or not valid_arguments:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "run_process requires nominal Executable and darray[sview] operands")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        state.required_effects.push("Process.Run") if not has_text(state.required_effects, "Process.Run")
                        state.required_errors.push("ProcessError") if not has_text(state.required_errors, "ProcessError")
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(executable_value.value)
                        state.operand_pool.push(arguments_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.RunProcess, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_name == "capture_process_stdout" and callee_index == state.function_names.count:
                        result_type: Type = type_from_name("sview")
                        argument_array_type: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Text}
                        valid_shape: bool = arguments.count == 2 and (argument_names.count == 0 or (argument_names[0] == "" and argument_names[1] == ""))
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "capture_process_stdout requires positional Executable and darray[sview] values")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        executable_value: LoweredValue = lower_expression(arguments[0], state)
                        arguments_value: LoweredValue = lower_expression_expected(arguments[1], argument_array_type, state)
                        valid_executable: bool = executable_value.valid and executable_value.type.kind == TypeKind.Named and executable_value.type.name == "Executable"
                        valid_arguments: bool = arguments_value.valid and same_type(arguments_value.type, argument_array_type)
                        if not valid_executable or not valid_arguments:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "capture_process_stdout requires nominal Executable and darray[sview] operands")
                            return LoweredValue{valid: false, value: 0, type: result_type}
                        state.required_effects.push("Process.Run") if not has_text(state.required_effects, "Process.Run")
                        state.required_errors.push("ProcessError") if not has_text(state.required_errors, "ProcessError")
                        operand_start: u32 = state.operand_pool.count.u32()
                        state.operand_pool.push(executable_value.value)
                        state.operand_pool.push(arguments_value.value)
                        result: u32 = fresh_value(state)
                        state.instructions.push(Instruction{opcode: Opcode.CaptureProcessStdout, result: result, result_type: result_type, operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                    if callee_index == state.function_names.count and compiler_typed_literal(callee_name):
                        valid_shape: bool = arguments.count == 1 and (argument_names.count == 0 or argument_names[0] == "")
                        if not valid_shape:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "typed literal construction requires one positional constant string")
                            return LoweredValue{valid: false, value: 0, type: typed_literal_type(callee_name)}
                        match arguments[0]:
                            Expr.StringLit(payload):
                                return emit_constant(state, typed_literal_type(callee_name), 0, "", payload, false, ir_span(pos))
                            _:
                                add_issue(state, LowerIssueKind.UnsupportedExpression, pos.line, "typed literal construction requires a compile-time string payload")
                                return LoweredValue{valid: false, value: 0, type: typed_literal_type(callee_name)}
                    signature: LoweredValue = lookup_return_type(state, callee_name)
                    if callee_name == "" or not signature.valid:
                        add_issue(state, LowerIssueKind.UnknownCallee, pos.line, "only known direct function calls are in the initial lowering subset")
                        return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}
                    expected_count: u16 = state.function_parameter_counts[callee_index]
                    parameter_start: usize = state.function_parameter_starts[callee_index].usize()
                    operands: mutable darray[u32] = []
                    operand_types: mutable darray[Type] = []
                    provided: mutable darray[bool] = []
                    for parameter in 0..<expected_count.usize() |operands, operand_types, provided|:
                        operands.push(0)
                        operand_types.push(void_ir_type())
                        provided.push(false)
                    valid: mutable bool = true
                    positional: mutable usize = 0
                    saw_named: mutable bool = false
                    for argument_index in 0..<arguments.count |arguments, argument_names, operands, operand_types, provided, valid, positional, saw_named, state, parameter_start, expected_count, pos|:
                        argument_name: sview = argument_names[argument_index] if argument_index < argument_names.count else ""
                        parameter: mutable usize = expected_count.usize()
                        if argument_name == "":
                            if saw_named:
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "positional call argument cannot follow a named argument")
                            else:
                                parameter <- positional
                                positional <- positional + 1
                        else:
                            saw_named <- true
                            for candidate in 0..<expected_count.usize() |state, parameter_start, argument_name, parameter, expected_count|:
                                parameter <- candidate if parameter == expected_count.usize() and state.function_parameter_names[parameter_start + candidate] == argument_name
                        if parameter >= expected_count.usize():
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "call argument does not name an available function parameter")
                            valid <- false
                        elif provided[parameter]:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "function parameter is supplied more than once")
                            valid <- false
                        else:
                            lowered_argument: LoweredValue = lower_expression_expected(arguments[argument_index], state.function_parameter_types[parameter_start + parameter], state)
                            if lowered_argument.valid:
                                operands[parameter] <- lowered_argument.value
                                operand_types[parameter] <- lowered_argument.type
                                provided[parameter] <- true
                                if not same_type(lowered_argument.type, state.function_parameter_types[parameter_start + parameter]):
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "call argument does not match the function parameter type")
                                    valid <- false
                            else:
                                valid <- false
                    default_scope: usize = state.names.count
                    for parameter in 0..<expected_count.usize() |state, parameter_start, operands, operand_types, provided, valid, pos|:
                        if not provided[parameter]:
                            if state.function_parameter_has_defaults[parameter_start + parameter]:
                                lowered_default: LoweredValue = lower_expression_expected(state.function_parameter_defaults[parameter_start + parameter], state.function_parameter_types[parameter_start + parameter], state)
                                if lowered_default.valid and same_type(lowered_default.type, state.function_parameter_types[parameter_start + parameter]):
                                    operands[parameter] <- lowered_default.value
                                    operand_types[parameter] <- lowered_default.type
                                    provided[parameter] <- true
                                else:
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "default argument does not match the function parameter type") if lowered_default.valid
                                    valid <- false
                            else:
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "call omits a required function parameter")
                                valid <- false
                        if provided[parameter]:
                            state.names.push(state.function_parameter_names[parameter_start + parameter])
                            state.values.push(operands[parameter])
                            state.types.push(operand_types[parameter])
                            state.mutables.push(false)
                    state.names.truncate(default_scope)
                    state.values.truncate(default_scope)
                    state.types.truncate(default_scope)
                    state.mutables.truncate(default_scope)
                    LoweredValue{valid: false, value: 0, type: signature.type} return if not valid
                    effect_start: usize = state.function_effect_starts[callee_index].usize()
                    effect_count: usize = state.function_effect_counts[callee_index].usize()
                    for offset in 0..<effect_count |state, effect_start|:
                        required_effect: sview = state.function_effects[effect_start + offset]
                        covered: bool = active_handler_covers(state.active_handlers, state.handlers, effect_family(required_effect))
                        state.required_effects.push(required_effect) if not covered and not has_text(state.required_effects, required_effect)
                    required_error: sview = state.function_errors[callee_index]
                    state.required_errors.push(required_error) if required_error != "" and not has_text(state.required_errors, required_error)
                    result: mutable u32 = 0
                    result <- fresh_value(state) if signature.type.kind != TypeKind.Void
                    operand_start: u32 = state.operand_pool.count.u32()
                    for operand in operands |state|:
                        state.operand_pool.push(operand)
                    state.instructions.push(Instruction{opcode: Opcode.Call, result: result, result_type: signature.type, operand_start: operand_start, operand_count: operands.count.u16(), symbol: callee_name, span: ir_span(pos)})
                    return LoweredValue{valid: true, value: result, type: signature.type}
                _:
                    add_issue(state, LowerIssueKind.UnsupportedExpression, 0, "expression is not in the initial IR lowering subset")
                    return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}


        def lower_expression_expected(expression: Ast::Expr, expected: Type&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            match expression:
                Expr.Array(elements, pos):
                    if elements.count == 0 and expected.kind == TypeKind.Array:
                        result: u32 = fresh_value(state)
                        result_type: Type = owned_ir_type(expected)
                        state.instructions.push(Instruction{opcode: Opcode.MakeArray, result: result, result_type: result_type, operand_start: state.operand_pool.count.u32(), operand_count: 0, span: ir_span(pos)})
                        return LoweredValue{valid: true, value: result, type: result_type}
                _:
                    pass
            return lower_expression(expression, state)


        def lower_collection_mutation(expression: Ast::Expr, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            receiver_name: mutable sview = ""
            method_name: mutable sview = ""
            arguments: mutable darray[Ast::Expr] = []
            argument_names: mutable darray[sview] = []
            match expression:
                Expr.Call(Expr.Field(Expr.Ident(name, ident_pos), method, field_pos), call_arguments, call_argument_names, call_pos):
                    if method == "push" or method == "extend":
                        receiver_name <- name
                        method_name <- method
                        arguments.extend(call_arguments)
                        argument_names.extend(call_argument_names)
                _:
                    pass
            false return if receiver_name == ""
            binding: usize = binding_index(state, receiver_name)
            if binding == state.names.count:
                add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "collection mutation receiver has no local binding")
                return true
            if state.types[binding].kind != TypeKind.Array:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "push and extend require an array receiver")
                return true
            if not state.mutables[binding]:
                add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "push and extend require a mutable array binding")
                return true
            named_argument: mutable bool = false
            for argument_name in argument_names |named_argument|:
                named_argument <- true if argument_name != ""
            if arguments.count != 1 or named_argument:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "push and extend require exactly one positional argument")
                return true

            appended: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: state.types[binding]}
            if method_name == "extend":
                appended <- lower_expression_expected(arguments[0], state.types[binding], state)
                if appended.valid and not same_type(appended.type, state.types[binding]):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "extend argument must have the receiver's exact array type")
                    return true
            else:
                element_type: Type = array_element_type(state.types[binding])
                element: LoweredValue = lower_expression_expected(arguments[0], element_type, state)
                if element.valid and not same_type(element.type, element_type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "pushed value must match the array element type")
                    return true
                if element.valid:
                    singleton: u32 = fresh_value(state)
                    singleton_start: u32 = state.operand_pool.count.u32()
                    state.operand_pool.push(element.value)
                    state.instructions.push(Instruction{opcode: Opcode.MakeArray, result: singleton, result_type: state.types[binding], operand_start: singleton_start, operand_count: 1, span: ir_span(pos)})
                    appended <- LoweredValue{valid: true, value: singleton, type: state.types[binding]}
            if appended.valid:
                result: u32 = fresh_value(state)
                operand_start: u32 = state.operand_pool.count.u32()
                state.operand_pool.push(state.values[binding])
                state.operand_pool.push(appended.value)
                state.instructions.push(Instruction{opcode: Opcode.Concat, result: result, result_type: state.types[binding], operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                state.values[binding] <- result
            return true


        def lower_range_for(variables: darray[sview]&, iterable: Ast::Expr, body: darray[Ast::Stmt]&, return_type: Type, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            range_low: mutable Ast::Expr = Expr.Absent
            range_high: mutable Ast::Expr = Expr.Absent
            step_expression: mutable Ast::Expr = Expr.Absent
            range_operator: mutable TokenKind = TokenKind.Range
            have_range: mutable bool = false
            have_step: mutable bool = false
            match iterable:
                Expr.Binary(low, operator, high, range_pos):
                    if operator in {TokenKind.RangeLt, TokenKind.RangeLe, TokenKind.RangeGt}:
                        range_low <- low
                        range_high <- high
                        range_operator <- operator
                        have_range <- true
                    elif operator == TokenKind.Range:
                        match low:
                            Expr.Binary(inner_low, inner_operator, inner_high, inner_pos):
                                if inner_operator in {TokenKind.RangeLt, TokenKind.RangeLe, TokenKind.RangeGt}:
                                    range_low <- inner_low
                                    range_high <- inner_high
                                    range_operator <- inner_operator
                                    step_expression <- high
                                    have_range <- true
                                    have_step <- true
                            _:
                                pass
                _:
                    pass
            false return if not have_range
            if variables.count != 1:
                add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "range for lowering requires exactly one binder")
                return true

            low: LoweredValue = lower_expression(range_low, state)
            if not low.valid:
                return true
            high: LoweredValue = lower_expression_expected(range_high, low.type, state)
            if not high.valid:
                return true
            if low.type.kind != TypeKind.Int or not same_type(low.type, high.type):
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range bounds must have the same integer type")
                return true
            step: mutable LoweredValue = emit_constant(state, low.type, 1, "", "", false, ir_span(pos))
            if have_step:
                positive_literal: mutable bool = false
                match step_expression:
                    Expr.IntLit(value) | Expr.IntLitTyped(value, _):
                        positive_literal <- value > 0
                    _:
                        pass
                if not positive_literal:
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range stride must be a positive integer constant")
                    return true
                step <- lower_expression_expected(step_expression, low.type, state)
                if not step.valid or not same_type(step.type, low.type):
                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range stride must match the bound type")
                    return true

            header_block: u32 = fresh_block(state)
            body_block: u32 = fresh_block(state)
            latch_block: u32 = fresh_block(state)
            exit_block: u32 = fresh_block(state)
            assigned_names: mutable darray[sview] = []
            collect_assigned_names(body, assigned_names)
            include_mutable_element_owners(state, assigned_names)
            carried_indices: mutable darray[u32] = []
            for assigned_name in assigned_names |state, carried_indices|:
                assigned_index: usize = binding_index(state, assigned_name)
                carried_indices.push(assigned_index.u32()) if assigned_index < state.names.count
            context_start: u32 = state.loop_carried_indices.count.u32()
            state.loop_carried_indices.extend(carried_indices)
            state.loop_context_starts.push(context_start)
            state.loop_context_counts.push(carried_indices.count.u16())
            state.loop_handler_depths.push(state.active_handlers.count.u32())
            context: usize = state.loop_context_counts.count - 1

            entry_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.edge_arg_pool.push(low.value)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: entry_args.start, edge0_arg_count: entry_args.count + 1, span: ir_span(pos)}
            finish_block(state)

            header_values: mutable darray[u32] = []
            latch_values: mutable darray[u32] = []
            exit_values: mutable darray[u32] = []
            for binding_u32 in carried_indices |state, header_block, latch_block, exit_block, header_values, latch_values, exit_values|:
                binding: usize = binding_u32.usize()
                header_value: u32 = fresh_value(state)
                latch_value: u32 = fresh_value(state)
                exit_value: u32 = fresh_value(state)
                state.pending_parameter_blocks.push(header_block)
                state.pending_parameters.push(Parameter{value: header_value, type: state.types[binding], name: state.names[binding]})
                state.pending_parameter_blocks.push(latch_block)
                state.pending_parameters.push(Parameter{value: latch_value, type: state.types[binding], name: state.names[binding]})
                state.pending_parameter_blocks.push(exit_block)
                state.pending_parameters.push(Parameter{value: exit_value, type: state.types[binding], name: state.names[binding]})
                header_values.push(header_value)
                latch_values.push(latch_value)
                exit_values.push(exit_value)
            counter: u32 = fresh_value(state)
            state.pending_parameter_blocks.push(header_block)
            state.pending_parameters.push(Parameter{value: counter, type: low.type, name: "range-counter"})
            for offset in 0..<carried_indices.count |state, carried_indices, header_values|:
                state.values[carried_indices[offset].usize()] <- header_values[offset]

            state.current_block <- header_block
            state.terminated <- false
            comparison: Opcode = Opcode.Greater if range_operator == TokenKind.RangeGt else (Opcode.LessEqual if range_operator == TokenKind.RangeLe else Opcode.Less)
            condition: u32 = fresh_value(state)
            condition_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(counter)
            state.operand_pool.push(high.value)
            state.instructions.push(Instruction{opcode: comparison, result: condition, result_type: type_from_name("bool"), operand_start: condition_start, operand_count: 2, span: ir_span(pos)})
            exit_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition, operand_count: 1, target0: body_block, target1: exit_block, target_count: 2, edge1_arg_start: exit_args.start, edge1_arg_count: exit_args.count, span: ir_span(pos)}
            finish_block(state)

            outer_scope: usize = state.names.count
            state.structured_depth <- state.structured_depth + 1
            state.break_targets.push(exit_block)
            state.continue_targets.push(latch_block)
            state.current_block <- body_block
            state.terminated <- false
            state.names.push(variables[0])
            state.values.push(counter)
            state.types.push(low.type)
            state.mutables.push(false)
            for nested in body |state, return_type|:
                lower_statement(nested, return_type, state)
            if not state.terminated:
                body_args: (start: u32, count: u16) = append_context_arguments(state, context)
                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: latch_block, target_count: 1, edge0_arg_start: body_args.start, edge0_arg_count: body_args.count, span: ir_span(pos)}
            finish_block(state)
            _ = state.break_targets.pop()
            _ = state.continue_targets.pop()
            state.names.truncate(outer_scope)
            state.values.truncate(outer_scope)
            state.types.truncate(outer_scope)
            state.mutables.truncate(outer_scope)
            for offset in 0..<carried_indices.count |state, carried_indices, latch_values|:
                state.values[carried_indices[offset].usize()] <- latch_values[offset]

            state.current_block <- latch_block
            state.terminated <- false
            next_counter: u32 = fresh_value(state)
            step_start: u32 = state.operand_pool.count.u32()
            state.operand_pool.push(counter)
            state.operand_pool.push(step.value)
            step_opcode: Opcode = Opcode.Subtract if range_operator == TokenKind.RangeGt else Opcode.Add
            state.instructions.push(Instruction{opcode: step_opcode, result: next_counter, result_type: low.type, operand_start: step_start, operand_count: 2, span: ir_span(pos)})
            backedge_args: (start: u32, count: u16) = append_context_arguments(state, context)
            state.edge_arg_pool.push(next_counter)
            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: backedge_args.start, edge0_arg_count: backedge_args.count + 1, span: ir_span(pos)}
            finish_block(state)

            state.structured_depth <- state.structured_depth - 1
            for offset in 0..<carried_indices.count |state, carried_indices, exit_values|:
                state.values[carried_indices[offset].usize()] <- exit_values[offset]
            _ = state.loop_context_starts.pop()
            _ = state.loop_context_counts.pop()
            _ = state.loop_handler_depths.pop()
            state.loop_carried_indices <- state.loop_carried_indices.truncate(context_start.usize())
            state.current_block <- exit_block
            state.terminated <- false
            return true


        def decimal_pattern_integer(text: sview, valid: mutable bool&) -> i64:
            valid <- false
            0 return if sview_len(text) == 0
            index: mutable usize = 0
            negative: mutable bool = false
            if sview_at(text, 0) == 45:
                negative <- true
                index <- 1
            0 return if index == sview_len(text)
            value: mutable i64 = 0
            while index < sview_len(text) |text, value, valid|:
                byte: u8 = sview_at(text, index)
                if byte < 48 or byte > 57:
                    return 0
                value <- value * 10 + (byte - 48).i64()
                index <- index + 1
            valid <- true
            return -value if negative
            return value


        def lower_match_literal(text: sview, expected: Type, pos: Ast::Pos&, state: mutable LowerState&) -> LoweredValue can[Memory.Allocate, Abort.Panic]:
            if expected.kind == TypeKind.Int:
                valid: mutable bool = false
                value: i64 = decimal_pattern_integer(text, valid)
                if valid:
                    return emit_constant(state, expected, value, "", "", false, ir_span(pos))
            elif expected.kind == TypeKind.Bool:
                emit_constant(state, expected, 0, "", "", true, ir_span(pos)) return if text == "true"
                emit_constant(state, expected, 0, "", "", false, ir_span(pos)) return if text == "false"
            elif expected.kind == TypeKind.Float:
                return emit_constant(state, expected, 0, text, "", false, ir_span(pos))
            elif expected.kind == TypeKind.Text:
                return emit_constant(state, expected, 0, "", text, false, ir_span(pos))
            elif expected.kind == TypeKind.Char:
                length: usize = sview_len(text)
                return emit_constant(state, expected, 0, "", text[1:length - 1], false, ir_span(pos)) if length >= 2 and sview_at(text, 0) == 39 and sview_at(text, length - 1) == 39
            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "match literal does not have the scrutinee's scalar type")
            return LoweredValue{valid: false, value: 0, type: unknown_ir_type()}


        def append_binding_arguments(state: mutable LowerState&, indices: darray[u32]&) -> (start: u32, count: u16) can[Memory.Allocate, Abort.Panic]:
            start: u32 = state.edge_arg_pool.count.u32()
            for binding in indices |state|:
                state.edge_arg_pool.push(state.values[binding.usize()])
            return (start, indices.count.u16())


        def supported_scalar_match(arms: darray[Ast::MatchArm]&, pos: Ast::Pos&, state: mutable LowerState&) -> bool can[Memory.Allocate, Abort.Panic]:
            supported: mutable bool = true
            for index in 0..<arms.count |arms, pos, state, supported|:
                arm: Ast::MatchArm = arms[index]
                catch_all: mutable bool = false
                match arm.pattern:
                    Pattern.Literal(text) | Pattern.Pin(text) | Pattern.Range(text, _, _):
                        pass
                    Pattern.Wildcard | Pattern.Binding(_):
                        catch_all <- true
                    _:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "initial match lowering supports scalar literals, pins, bindings, and wildcard patterns")
                        supported <- false
                guarded: mutable bool = false
                match arm.guard:
                    Expr.Absent:
                        pass
                    _:
                        guarded <- true
                if catch_all and not guarded and index + 1 != arms.count:
                    add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "a catch-all match arm must be last")
                    supported <- false
            return supported


        def scalar_match_exhaustive(type: Type&, arms: darray[Ast::MatchArm]&) -> bool:
            saw_true: mutable bool = false
            saw_false: mutable bool = false
            for arm in arms |saw_true, saw_false|:
                guarded: mutable bool = false
                match arm.guard:
                    Expr.Absent:
                        pass
                    _:
                        guarded <- true
                continue if guarded
                match arm.pattern:
                    Pattern.Wildcard | Pattern.Binding(_):
                        return true
                    Pattern.Literal(text):
                        saw_true <- true if text == "true"
                        saw_false <- true if text == "false"
                    _:
                        pass
            return type.kind == TypeKind.Bool and saw_true and saw_false


        def lower_scalar_match(scrutinee_expression: Ast::Expr, arms: darray[Ast::MatchArm]&, return_type: Type, pos: Ast::Pos&, state: mutable LowerState&) -> void can[Memory.Allocate, Abort.Panic]:
            scrutinee: LoweredValue = lower_expression(scrutinee_expression, state)
            return if not scrutinee.valid or not supported_scalar_match(arms, pos, state)
            if scrutinee.type.kind not in {TypeKind.Int, TypeKind.Float, TypeKind.Bool, TypeKind.Char, TypeKind.Text}:
                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "scalar match requires an integer, float, boolean, character, or text scrutinee")
                return

            scope_mark: usize = state.names.count
            base_values: mutable darray[u32] = []
            base_values.extend(state.values)
            assigned_names: mutable darray[sview] = []
            for arm in arms |assigned_names|:
                collect_assigned_names(arm.body, assigned_names)
            include_mutable_element_owners(state, assigned_names)
            carried_indices: mutable darray[u32] = []
            for name in assigned_names |state, carried_indices|:
                index: usize = binding_index(state, name)
                carried_indices.push(index.u32()) if index < scope_mark

            merge_block: u32 = fresh_block(state)
            merged_values: mutable darray[u32] = []
            for binding_u32 in carried_indices |state, merge_block, merged_values|:
                binding: usize = binding_u32.usize()
                merged: u32 = fresh_value(state)
                state.pending_parameter_blocks.push(merge_block)
                state.pending_parameters.push(Parameter{value: merged, type: state.types[binding], name: state.names[binding]})
                merged_values.push(merged)

            state.structured_depth <- state.structured_depth + 1
            any_fallthrough: mutable bool = arms.count == 0
            exhaustive: bool = scalar_match_exhaustive(scrutinee.type, arms)
            for arm_index in 0..<arms.count |state, arms, pos, scrutinee, return_type, scope_mark, base_values, carried_indices, merge_block, any_fallthrough, exhaustive|:
                arm: Ast::MatchArm = arms[arm_index]
                body_block: u32 = fresh_block(state)
                final_arm: bool = arm_index + 1 == arms.count
                next_test_block: u32 = merge_block if final_arm and not exhaustive else fresh_block(state)
                guarded: mutable bool = false
                match arm.guard:
                    Expr.Absent:
                        pass
                    _:
                        guarded <- true
                matched_block: u32 = fresh_block(state) if guarded else body_block
                binder: mutable sview = ""
                catch_all: mutable bool = false
                condition: mutable LoweredValue = LoweredValue{valid: false, value: 0, type: type_from_name("bool")}
                match arm.pattern:
                    Pattern.Literal(text):
                        literal: LoweredValue = lower_match_literal(text, scrutinee.type, pos, state)
                        if literal.valid:
                            result: u32 = fresh_value(state)
                            operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(scrutinee.value)
                            state.operand_pool.push(literal.value)
                            state.instructions.push(Instruction{opcode: Opcode.Equal, result: result, result_type: type_from_name("bool"), operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                            condition <- LoweredValue{valid: true, value: result, type: type_from_name("bool")}
                    Pattern.Range(lo_text, hi_text, inclusive):
                        if scrutinee.type.kind != TypeKind.Int and scrutinee.type.kind != TypeKind.Float:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "range pattern requires a numeric scalar scrutinee")
                        else:
                            low: LoweredValue = lower_match_literal(lo_text, scrutinee.type, pos, state)
                            high: LoweredValue = lower_match_literal(hi_text, scrutinee.type, pos, state)
                            if low.valid and high.valid:
                                lower_result: u32 = fresh_value(state)
                                lower_operands: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(scrutinee.value)
                                state.operand_pool.push(low.value)
                                state.instructions.push(Instruction{opcode: Opcode.GreaterEqual, result: lower_result, result_type: type_from_name("bool"), operand_start: lower_operands, operand_count: 2, span: ir_span(pos)})
                                upper_test_block: u32 = fresh_block(state)
                                if next_test_block == merge_block:
                                    lower_fallthrough_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                                    state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: lower_result, operand_count: 1, target0: upper_test_block, target1: next_test_block, target_count: 2, edge1_arg_start: lower_fallthrough_args.start, edge1_arg_count: lower_fallthrough_args.count, span: ir_span(pos)}
                                    any_fallthrough <- true
                                else:
                                    state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: lower_result, operand_count: 1, target0: upper_test_block, target1: next_test_block, target_count: 2, span: ir_span(pos)}
                                finish_block(state)
                                state.current_block <- upper_test_block
                                state.terminated <- false
                                upper_result: u32 = fresh_value(state)
                                upper_operands: u32 = state.operand_pool.count.u32()
                                state.operand_pool.push(scrutinee.value)
                                state.operand_pool.push(high.value)
                                upper_opcode: Opcode = Opcode.LessEqual if inclusive else Opcode.Less
                                state.instructions.push(Instruction{opcode: upper_opcode, result: upper_result, result_type: type_from_name("bool"), operand_start: upper_operands, operand_count: 2, span: ir_span(pos)})
                                condition <- LoweredValue{valid: true, value: upper_result, type: type_from_name("bool")}
                    Pattern.Pin(name):
                        pinned: LoweredValue = lookup_binding(state, name)
                        if not pinned.valid or not same_type(pinned.type, scrutinee.type):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "pinned match binding must exist and match the scrutinee type")
                        else:
                            result: u32 = fresh_value(state)
                            operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(scrutinee.value)
                            state.operand_pool.push(pinned.value)
                            state.instructions.push(Instruction{opcode: Opcode.Equal, result: result, result_type: type_from_name("bool"), operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                            condition <- LoweredValue{valid: true, value: result, type: type_from_name("bool")}
                    Pattern.Binding(name):
                        binder <- name
                        catch_all <- true
                    Pattern.Wildcard:
                        catch_all <- true
                    _:
                        pass
                if catch_all:
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: matched_block, target_count: 1, span: ir_span(pos)}
                elif condition.valid:
                    if final_arm and not exhaustive:
                        unmatched_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition.value, operand_count: 1, target0: matched_block, target1: next_test_block, target_count: 2, edge1_arg_start: unmatched_args.start, edge1_arg_count: unmatched_args.count, span: ir_span(pos)}
                        any_fallthrough <- true
                    else:
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition.value, operand_count: 1, target0: matched_block, target1: next_test_block, target_count: 2, span: ir_span(pos)}
                finish_block(state)

                if guarded:
                    for index in 0..<scope_mark |state, base_values|:
                        state.values[index] <- base_values[index]
                    state.current_block <- matched_block
                    state.terminated <- false
                    if binder != "":
                        state.names.push(binder)
                        state.values.push(scrutinee.value)
                        state.types.push(scrutinee.type)
                        state.mutables.push(false)
                    guard_value: LoweredValue = lower_expression(arm.guard, state)
                    guard_valid: mutable bool = guard_value.valid
                    if guard_value.valid and guard_value.type.kind != TypeKind.Bool:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "match arm guard must have boolean type")
                        guard_valid <- false
                    if guard_valid:
                        if next_test_block == merge_block:
                            guard_fallthrough_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: guard_value.value, operand_count: 1, target0: body_block, target1: next_test_block, target_count: 2, edge1_arg_start: guard_fallthrough_args.start, edge1_arg_count: guard_fallthrough_args.count, span: ir_span(pos)}
                            any_fallthrough <- true
                        else:
                            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: guard_value.value, operand_count: 1, target0: body_block, target1: next_test_block, target_count: 2, span: ir_span(pos)}
                    finish_block(state)
                    state.names.truncate(scope_mark)
                    state.values.truncate(scope_mark)
                    state.types.truncate(scope_mark)
                    state.mutables.truncate(scope_mark)

                for index in 0..<scope_mark |state, base_values|:
                    state.values[index] <- base_values[index]
                state.current_block <- body_block
                state.terminated <- false
                if binder != "":
                    state.names.push(binder)
                    state.values.push(scrutinee.value)
                    state.types.push(scrutinee.type)
                    state.mutables.push(false)
                for nested in arm.body |state, return_type|:
                    lower_statement(nested, return_type, state)
                if not state.terminated:
                    arm_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: arm_args.start, edge0_arg_count: arm_args.count, span: ir_span(pos)}
                    any_fallthrough <- true
                finish_block(state)
                state.names.truncate(scope_mark)
                state.values.truncate(scope_mark)
                state.types.truncate(scope_mark)
                state.mutables.truncate(scope_mark)
                for index in 0..<scope_mark |state, base_values|:
                    state.values[index] <- base_values[index]
                state.current_block <- next_test_block
                state.terminated <- false

            if arms.count == 0:
                empty_args: (start: u32, count: u16) = append_binding_arguments(state, carried_indices)
                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: empty_args.start, edge0_arg_count: empty_args.count, span: ir_span(pos)}
                finish_block(state)
            elif exhaustive:
                state.terminator <- Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)}
                finish_block(state)
            state.structured_depth <- state.structured_depth - 1
            if any_fallthrough:
                for offset in 0..<carried_indices.count |state, carried_indices, merged_values|:
                    state.values[carried_indices[offset].usize()] <- merged_values[offset]
                state.current_block <- merge_block
                state.terminated <- false
            else:
                state.terminated <- true


        def lower_statement(statement: Ast::Stmt, return_type: Type, state: mutable LowerState&) -> void can[Memory.Allocate, Abort.Panic]:
            if state.terminated:
                return
            match statement:
                Stmt.VarDecl(name, type_expression, value, pos):
                    declared: Type = type_from_expression(type_expression)
                    lowered: LoweredValue = lower_expression(value, state) if type_expression is Expr.Invalid else lower_expression_expected(value, declared, state)
                    if lowered.valid:
                        binding_type: Type = lowered.type if type_expression is Expr.Invalid else declared
                        if type_expression is not Expr.Invalid and not same_type(declared, lowered.type):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "binding initializer does not match its declared type")
                        else:
                            state.names.push(name)
                            state.values.push(lowered.value)
                            state.types.push(binding_type)
                            state.mutables.push(mutable_binding_type(type_expression))
                Stmt.Expr(expression, pos):
                    match expression:
                        Expr.Invalid:
                            pass
                        _:
                            if not lower_collection_mutation(expression, pos, state):
                                _ = lower_expression(expression, state)
                Stmt.Assign(target, operator, value, pos):
                    target_name: mutable sview = ""
                    index_expression: mutable Ast::Expr = Expr.Absent
                    indexed: mutable bool = false
                    match target:
                        Expr.Ident(name, target_pos):
                            target_name <- name
                        Expr.Index(Expr.Ident(name, target_pos), target_index, index_pos):
                            target_name <- name
                            index_expression <- target_index
                            indexed <- true
                        _:
                            pass
                    index: usize = binding_index(state, target_name)
                    if target_name == "" or index == state.names.count:
                        add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "initial SSA lowering supports assignment to a known local name")
                    elif indexed:
                        if not state.mutables[index]:
                            add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "indexed assignment requires a mutable array binding")
                        elif not supported_assignment_operator(operator):
                            add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "indexed assignment supports <- and typed arithmetic or bitwise compound assignment")
                        elif state.types[index].kind != TypeKind.Array:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed assignment requires an array binding")
                        else:
                            lowered_index: LoweredValue = lower_expression(index_expression, state)
                            element_type: Type = array_element_type(state.types[index])
                            if lowered_index.valid and lowered_index.type.kind != TypeKind.Int:
                                add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed assignment index must be an integer")
                            elif lowered_index.valid:
                                replacement: mutable LoweredValue = LoweredValue{value: 0, type: void_ir_type(), valid: false}
                                if operator == TokenKind.LArrow:
                                    lowered_replacement: LoweredValue = lower_expression_expected(value, element_type, state)
                                    if lowered_replacement.valid and not same_type(lowered_replacement.type, element_type):
                                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed assignment value must match the array element type")
                                    elif lowered_replacement.valid:
                                        replacement <- lowered_replacement
                                else:
                                    current: u32 = fresh_value(state)
                                    index_operands: u32 = state.operand_pool.count.u32()
                                    state.operand_pool.push(state.values[index])
                                    state.operand_pool.push(lowered_index.value)
                                    state.instructions.push(Instruction{opcode: Opcode.Index, result: current, result_type: element_type, operand_start: index_operands, operand_count: 2, span: ir_span(pos)})
                                    lowered: LoweredValue = lower_expression_expected(value, element_type, state)
                                    if lowered.valid:
                                        opcode: Opcode = compound_opcode(operator)
                                        arithmetic: bool = opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder}
                                        bitwise: bool = opcode in {Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight}
                                        operands_match: bool = same_type(element_type, lowered.type)
                                        valid_arithmetic: bool = arithmetic and operands_match and numeric_type(element_type) and (opcode != Opcode.Remainder or element_type.kind == TypeKind.Int)
                                        valid_bitwise: bool = bitwise and operands_match and element_type.kind == TypeKind.Int
                                        if not valid_arithmetic and not valid_bitwise:
                                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "indexed compound assignment operands do not have compatible static types")
                                        else:
                                            result: u32 = fresh_value(state)
                                            operation_operands: u32 = state.operand_pool.count.u32()
                                            state.operand_pool.push(current)
                                            state.operand_pool.push(lowered.value)
                                            state.instructions.push(Instruction{opcode: opcode, result: result, result_type: element_type, operand_start: operation_operands, operand_count: 2, span: ir_span(pos)})
                                            replacement <- LoweredValue{value: result, type: element_type, valid: true}
                                if replacement.valid:
                                    result: u32 = fresh_value(state)
                                    operand_start: u32 = state.operand_pool.count.u32()
                                    state.operand_pool.push(state.values[index])
                                    state.operand_pool.push(lowered_index.value)
                                    state.operand_pool.push(replacement.value)
                                    state.instructions.push(Instruction{opcode: Opcode.SetIndex, result: result, result_type: state.types[index], operand_start: operand_start, operand_count: 3, span: ir_span(pos)})
                                    state.values[index] <- result
                    else:
                        rebound: mutable bool = false
                        if not state.mutables[index]:
                            add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "assignment requires a mutable local binding")
                        elif not supported_assignment_operator(operator):
                            add_issue(state, LowerIssueKind.UnsupportedAssignmentTarget, pos.line, "SSA rebinding supports <- and typed arithmetic or bitwise compound assignment")
                        elif operator == TokenKind.LArrow:
                            lowered: LoweredValue = lower_expression_expected(value, state.types[index], state)
                            if lowered.valid:
                                if not same_type(state.types[index], lowered.type):
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "assignment cannot change a binding's static type")
                                else:
                                    state.values[index] <- lowered.value
                                    rebound <- true
                        else:
                            lowered: LoweredValue = lower_expression_expected(value, state.types[index], state)
                            if lowered.valid:
                                opcode: Opcode = compound_opcode(operator)
                                arithmetic: bool = opcode in {Opcode.Add, Opcode.Subtract, Opcode.Multiply, Opcode.Divide, Opcode.Remainder}
                                bitwise: bool = opcode in {Opcode.BitAnd, Opcode.BitOr, Opcode.BitXor, Opcode.ShiftLeft, Opcode.ShiftRight}
                                operands_match: bool = same_type(state.types[index], lowered.type)
                                valid_arithmetic: bool = arithmetic and operands_match and numeric_type(state.types[index]) and (opcode != Opcode.Remainder or state.types[index].kind == TypeKind.Int)
                                valid_bitwise: bool = bitwise and operands_match and state.types[index].kind == TypeKind.Int
                                if not valid_arithmetic and not valid_bitwise:
                                    add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "compound assignment operands do not have compatible static types")
                                else:
                                    result: u32 = fresh_value(state)
                                    operand_start: u32 = state.operand_pool.count.u32()
                                    state.operand_pool.push(state.values[index])
                                    state.operand_pool.push(lowered.value)
                                    state.instructions.push(Instruction{opcode: opcode, result: result, result_type: state.types[index], operand_start: operand_start, operand_count: 2, span: ir_span(pos)})
                                    state.values[index] <- result
                                    rebound <- true
                        synchronize_mutable_element(state, index, pos) if rebound
                Stmt.Return(value_opt, pos):
                    if value_opt is value:
                        lowered: LoweredValue = lower_expression_expected(value, return_type, state)
                        return_valid: mutable bool = lowered.valid
                        if lowered.valid and not same_type(return_type, lowered.type):
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "return value does not match the function return type")
                            return_valid <- false
                        emit_handler_unwind(state, 0, pos) if return_valid
                        state.terminator <- Terminator{kind: TerminatorKind.Return, operand: lowered.value, operand_count: 1, span: ir_span(pos)} if return_valid
                    else:
                        if return_type.kind != TypeKind.Void:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "non-void function return requires a value")
                        else:
                            emit_handler_unwind(state, 0, pos)
                            state.terminator <- Terminator{kind: TerminatorKind.Return, span: ir_span(pos)}
                    state.terminated <- true
                Stmt.If(condition, then_body, else_body, pos):
                    condition_value: LoweredValue = lower_expression(condition, state)
                    condition_valid: mutable bool = condition_value.valid
                    if condition_value.valid and condition_value.type.kind != TypeKind.Bool:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "if condition must have boolean type")
                        condition_valid <- false
                    if condition_valid:
                        then_block: u32 = fresh_block(state)
                        else_block: u32 = fresh_block(state)
                        merge_block: u32 = fresh_block(state)
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition_value.value, operand_count: 1, target0: then_block, target1: else_block, target_count: 2, span: ir_span(pos)}
                        finish_block(state)

                        scope_mark: usize = state.names.count
                        state.structured_depth <- state.structured_depth + 1
                        base_values: mutable darray[u32] = []
                        base_values.extend(state.values)
                        state.current_block <- then_block
                        state.terminated <- false
                        for nested in then_body |state, return_type|:
                            lower_statement(nested, return_type, state)
                        then_falls_through: bool = not state.terminated
                        state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, span: ir_span(pos)} if then_falls_through
                        then_values: mutable darray[u32] = []
                        for index in 0..<scope_mark |state, then_values|:
                            then_values.push(state.values[index])
                        then_block_index: usize = state.blocks.count
                        finish_block(state)
                        state.names.truncate(scope_mark)
                        state.values.truncate(scope_mark)
                        state.types.truncate(scope_mark)
                        state.mutables.truncate(scope_mark)
                        for index in 0..<scope_mark |state, base_values|:
                            state.values[index] <- base_values[index]

                        state.current_block <- else_block
                        state.terminated <- false
                        for nested in else_body |state, return_type|:
                            lower_statement(nested, return_type, state)
                        else_falls_through: bool = not state.terminated
                        state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, span: ir_span(pos)} if else_falls_through
                        else_values: mutable darray[u32] = []
                        for index in 0..<scope_mark |state, else_values|:
                            else_values.push(state.values[index])
                        else_block_index: usize = state.blocks.count
                        finish_block(state)
                        state.names.truncate(scope_mark)
                        state.values.truncate(scope_mark)
                        state.types.truncate(scope_mark)
                        state.mutables.truncate(scope_mark)
                        state.structured_depth <- state.structured_depth - 1

                        if then_falls_through or else_falls_through:
                            if then_falls_through and else_falls_through:
                                then_edge_start: u32 = state.edge_arg_pool.count.u32()
                                merge_count: mutable u16 = 0
                                for index in 0..<scope_mark |state, then_values, else_values, merge_block, merge_count|:
                                    if then_values[index] != else_values[index]:
                                        state.edge_arg_pool.push(then_values[index])
                                        merge_count <- merge_count + 1
                                else_edge_start: u32 = state.edge_arg_pool.count.u32()
                                for index in 0..<scope_mark |state, then_values, else_values|:
                                    state.edge_arg_pool.push(else_values[index]) if then_values[index] != else_values[index]
                                state.blocks[then_block_index].terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: then_edge_start, edge0_arg_count: merge_count, span: ir_span(pos)}
                                state.blocks[else_block_index].terminator <- Terminator{kind: TerminatorKind.Jump, target0: merge_block, target_count: 1, edge0_arg_start: else_edge_start, edge0_arg_count: merge_count, span: ir_span(pos)}
                                for index in 0..<scope_mark |state, then_values, else_values, merge_block|:
                                    if then_values[index] != else_values[index]:
                                        merged_value: u32 = fresh_value(state)
                                        state.pending_parameter_blocks.push(merge_block)
                                        state.pending_parameters.push(Parameter{value: merged_value, type: state.types[index], name: state.names[index]})
                                        state.values[index] <- merged_value
                                    else:
                                        state.values[index] <- then_values[index]
                            else:
                                for index in 0..<scope_mark |state, then_values, else_values, then_falls_through|:
                                    state.values[index] <- then_values[index] if then_falls_through else else_values[index]
                            state.current_block <- merge_block
                            state.terminated <- false
                        else:
                            state.terminated <- true
                Stmt.While(condition, body, pos):
                    header_block: u32 = fresh_block(state)
                    body_block: u32 = fresh_block(state)
                    exit_block: u32 = fresh_block(state)
                    assigned_names: mutable darray[sview] = []
                    collect_assigned_names(body, assigned_names)
                    include_mutable_element_owners(state, assigned_names)
                    carried_indices: mutable darray[u32] = []
                    for assigned_name in assigned_names |state, carried_indices|:
                        assigned_index: usize = binding_index(state, assigned_name)
                        carried_indices.push(assigned_index.u32()) if assigned_index < state.names.count
                    context_start: u32 = state.loop_carried_indices.count.u32()
                    state.loop_carried_indices.extend(carried_indices)
                    state.loop_context_starts.push(context_start)
                    state.loop_context_counts.push(carried_indices.count.u16())
                    state.loop_handler_depths.push(state.active_handlers.count.u32())
                    context: usize = state.loop_context_counts.count - 1

                    entry_args: (start: u32, count: u16) = append_context_arguments(state, context)
                    state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: entry_args.start, edge0_arg_count: entry_args.count, span: ir_span(pos)}
                    finish_block(state)

                    exit_values: mutable darray[u32] = []
                    for binding_u32 in carried_indices |state, header_block, exit_block, exit_values|:
                        binding: usize = binding_u32.usize()
                        header_value: u32 = fresh_value(state)
                        exit_value: u32 = fresh_value(state)
                        state.pending_parameter_blocks.push(header_block)
                        state.pending_parameters.push(Parameter{value: header_value, type: state.types[binding], name: state.names[binding]})
                        state.pending_parameter_blocks.push(exit_block)
                        state.pending_parameters.push(Parameter{value: exit_value, type: state.types[binding], name: state.names[binding]})
                        state.values[binding] <- header_value
                        exit_values.push(exit_value)

                    state.current_block <- header_block
                    state.terminated <- false
                    condition_value: LoweredValue = lower_expression(condition, state)
                    condition_valid: mutable bool = condition_value.valid
                    if condition_value.valid and condition_value.type.kind != TypeKind.Bool:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "while condition must have boolean type")
                        condition_valid <- false
                    if condition_valid:
                        exit_args: (start: u32, count: u16) = append_context_arguments(state, context)
                        state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition_value.value, operand_count: 1, target0: body_block, target1: exit_block, target_count: 2, edge1_arg_start: exit_args.start, edge1_arg_count: exit_args.count, span: ir_span(pos)}
                    finish_block(state)

                    scope_mark: usize = state.names.count
                    state.structured_depth <- state.structured_depth + 1
                    state.break_targets.push(exit_block)
                    state.continue_targets.push(header_block)
                    state.current_block <- body_block
                    state.terminated <- false
                    for nested in body |state, return_type|:
                        lower_statement(nested, return_type, state)
                    if not state.terminated:
                        backedge_args: (start: u32, count: u16) = append_context_arguments(state, context)
                        state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: backedge_args.start, edge0_arg_count: backedge_args.count, span: ir_span(pos)}
                    finish_block(state)
                    _ = state.break_targets.pop()
                    _ = state.continue_targets.pop()
                    state.names.truncate(scope_mark)
                    state.values.truncate(scope_mark)
                    state.types.truncate(scope_mark)
                    state.mutables.truncate(scope_mark)
                    state.structured_depth <- state.structured_depth - 1
                    for offset in 0..<carried_indices.count |state, carried_indices, exit_values|:
                        state.values[carried_indices[offset].usize()] <- exit_values[offset]
                    _ = state.loop_context_starts.pop()
                    _ = state.loop_context_counts.pop()
                    _ = state.loop_handler_depths.pop()
                    state.loop_carried_indices <- state.loop_carried_indices.truncate(context_start.usize())

                    state.current_block <- exit_block
                    state.terminated <- false
                Stmt.For(bind, variables, iterable, body, pos):
                    mutable_iteration: bool = bind == "mutable"
                    iterable_name: mutable sview = ""
                    match iterable:
                        Expr.Ident(name, iterable_pos):
                            iterable_name <- name
                        _:
                            pass
                    collection_owner: usize = binding_index(state, iterable_name)
                    if variables.count != 1 or bind not in {"", "mutable"}:
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "for lowering supports one read or mutable element binding")
                    elif mutable_iteration and iterable_name == "":
                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "mutable iteration requires a named mutable array binding")
                    elif mutable_iteration and collection_owner == state.names.count:
                        add_issue(state, LowerIssueKind.UnknownBinding, pos.line, "mutable iteration requires a known array binding")
                    elif mutable_iteration and not state.mutables[collection_owner]:
                        add_issue(state, LowerIssueKind.ImmutableBinding, pos.line, "mutable iteration requires a mutable array binding")
                    elif mutable_iteration and state.types[collection_owner].kind != TypeKind.Array:
                        add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "mutable iteration requires an array binding")
                    elif not mutable_iteration and lower_range_for(variables, iterable, body, return_type, pos, state):
                        pass
                    else:
                        collection: LoweredValue = lower_expression(iterable, state)
                        if not collection.valid:
                            pass
                        elif collection.type.kind not in {TypeKind.Array, TypeKind.Text}:
                            add_issue(state, LowerIssueKind.TypeMismatch, pos.line, "for iterable must have an array or text type")
                        else:
                            header_block: u32 = fresh_block(state)
                            body_block: u32 = fresh_block(state)
                            latch_block: u32 = fresh_block(state)
                            exit_block: u32 = fresh_block(state)
                            assigned_names: mutable darray[sview] = []
                            collect_assigned_names(body, assigned_names)
                            add_unique_name(assigned_names, iterable_name) if mutable_iteration
                            include_mutable_element_owners(state, assigned_names)
                            carried_indices: mutable darray[u32] = []
                            for assigned_name in assigned_names |state, carried_indices|:
                                assigned_index: usize = binding_index(state, assigned_name)
                                carried_indices.push(assigned_index.u32()) if assigned_index < state.names.count
                            context_start: u32 = state.loop_carried_indices.count.u32()
                            state.loop_carried_indices.extend(carried_indices)
                            state.loop_context_starts.push(context_start)
                            state.loop_context_counts.push(carried_indices.count.u16())
                            state.loop_handler_depths.push(state.active_handlers.count.u32())
                            context: usize = state.loop_context_counts.count - 1

                            index_type: Type = type_from_name("usize")
                            initial_index: LoweredValue = emit_constant(state, index_type, 0, "", "", false, ir_span(pos))
                            entry_args: (start: u32, count: u16) = append_context_arguments(state, context)
                            state.edge_arg_pool.push(initial_index.value)
                            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: entry_args.start, edge0_arg_count: entry_args.count + 1, span: ir_span(pos)}
                            finish_block(state)

                            header_values: mutable darray[u32] = []
                            latch_values: mutable darray[u32] = []
                            exit_values: mutable darray[u32] = []
                            for binding_u32 in carried_indices |state, header_block, latch_block, exit_block, header_values, latch_values, exit_values|:
                                binding: usize = binding_u32.usize()
                                header_value: u32 = fresh_value(state)
                                latch_value: u32 = fresh_value(state)
                                exit_value: u32 = fresh_value(state)
                                state.pending_parameter_blocks.push(header_block)
                                state.pending_parameters.push(Parameter{value: header_value, type: state.types[binding], name: state.names[binding]})
                                state.pending_parameter_blocks.push(latch_block)
                                state.pending_parameters.push(Parameter{value: latch_value, type: state.types[binding], name: state.names[binding]})
                                state.pending_parameter_blocks.push(exit_block)
                                state.pending_parameters.push(Parameter{value: exit_value, type: state.types[binding], name: state.names[binding]})
                                header_values.push(header_value)
                                latch_values.push(latch_value)
                                exit_values.push(exit_value)
                            index_value: u32 = fresh_value(state)
                            state.pending_parameter_blocks.push(header_block)
                            state.pending_parameters.push(Parameter{value: index_value, type: index_type, name: "for-index"})
                            for offset in 0..<carried_indices.count |state, carried_indices, header_values|:
                                state.values[carried_indices[offset].usize()] <- header_values[offset]
                            active_collection: u32 = state.values[collection_owner] if mutable_iteration else collection.value

                            state.current_block <- header_block
                            state.terminated <- false
                            length_result: u32 = fresh_value(state)
                            length_operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(active_collection)
                            state.instructions.push(Instruction{opcode: Opcode.Length, result: length_result, result_type: index_type, operand_start: length_operand_start, operand_count: 1, span: ir_span(pos)})
                            condition_result: u32 = fresh_value(state)
                            condition_operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(index_value)
                            state.operand_pool.push(length_result)
                            state.instructions.push(Instruction{opcode: Opcode.Less, result: condition_result, result_type: type_from_name("bool"), operand_start: condition_operand_start, operand_count: 2, span: ir_span(pos)})
                            exit_args: (start: u32, count: u16) = append_context_arguments(state, context)
                            state.terminator <- Terminator{kind: TerminatorKind.Branch, operand: condition_result, operand_count: 1, target0: body_block, target1: exit_block, target_count: 2, edge1_arg_start: exit_args.start, edge1_arg_count: exit_args.count, span: ir_span(pos)}
                            finish_block(state)

                            outer_scope: usize = state.names.count
                            relation_scope: usize = state.element_binding_indices.count
                            state.structured_depth <- state.structured_depth + 1
                            state.break_targets.push(exit_block)
                            state.continue_targets.push(latch_block)
                            state.current_block <- body_block
                            state.terminated <- false
                            element_result: u32 = fresh_value(state)
                            element_operand_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(active_collection)
                            state.operand_pool.push(index_value)
                            element_type: Type = type_from_name("char") if collection.type.kind == TypeKind.Text else array_element_type(collection.type)
                            state.instructions.push(Instruction{opcode: Opcode.Index, result: element_result, result_type: element_type, operand_start: element_operand_start, operand_count: 2, span: ir_span(pos)})
                            state.names.push(variables[0])
                            state.values.push(element_result)
                            state.types.push(element_type)
                            state.mutables.push(mutable_iteration)
                            if mutable_iteration:
                                state.element_binding_indices.push(outer_scope.u32())
                                state.element_owner_indices.push(collection_owner.u32())
                                state.element_index_values.push(index_value)
                            for nested in body |state, return_type|:
                                lower_statement(nested, return_type, state)
                            if not state.terminated:
                                body_args: (start: u32, count: u16) = append_context_arguments(state, context)
                                state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: latch_block, target_count: 1, edge0_arg_start: body_args.start, edge0_arg_count: body_args.count, span: ir_span(pos)}
                            finish_block(state)
                            _ = state.break_targets.pop()
                            _ = state.continue_targets.pop()
                            state.names.truncate(outer_scope)
                            state.values.truncate(outer_scope)
                            state.types.truncate(outer_scope)
                            state.mutables.truncate(outer_scope)
                            state.element_binding_indices.truncate(relation_scope)
                            state.element_owner_indices.truncate(relation_scope)
                            state.element_index_values.truncate(relation_scope)
                            for offset in 0..<carried_indices.count |state, carried_indices, latch_values|:
                                state.values[carried_indices[offset].usize()] <- latch_values[offset]

                            state.current_block <- latch_block
                            state.terminated <- false
                            one: LoweredValue = emit_constant(state, index_type, 1, "", "", false, ir_span(pos))
                            next_index: u32 = fresh_value(state)
                            increment_start: u32 = state.operand_pool.count.u32()
                            state.operand_pool.push(index_value)
                            state.operand_pool.push(one.value)
                            state.instructions.push(Instruction{opcode: Opcode.Add, result: next_index, result_type: index_type, operand_start: increment_start, operand_count: 2, span: ir_span(pos)})
                            backedge_args: (start: u32, count: u16) = append_context_arguments(state, context)
                            state.edge_arg_pool.push(next_index)
                            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: header_block, target_count: 1, edge0_arg_start: backedge_args.start, edge0_arg_count: backedge_args.count + 1, span: ir_span(pos)}
                            finish_block(state)

                            state.structured_depth <- state.structured_depth - 1
                            for offset in 0..<carried_indices.count |state, carried_indices, exit_values|:
                                state.values[carried_indices[offset].usize()] <- exit_values[offset]
                            _ = state.loop_context_starts.pop()
                            _ = state.loop_context_counts.pop()
                            _ = state.loop_handler_depths.pop()
                            state.loop_carried_indices <- state.loop_carried_indices.truncate(context_start.usize())
                            state.current_block <- exit_block
                            state.terminated <- false
                Stmt.Match(scrutinee, arms, pos):
                    lower_scalar_match(scrutinee, arms, return_type, pos, state)
                Stmt.Break(label, pos):
                    if label != "":
                        add_issue(state, LowerIssueKind.UnsupportedLoopLabel, pos.line, "labeled break is not in the initial IR lowering subset")
                    else:
                        if state.break_targets.count == 0:
                            add_issue(state, LowerIssueKind.LoopControlOutsideLoop, pos.line, "break has no enclosing loop")
                        else:
                            target: u32 = state.break_targets[state.break_targets.count - 1]
                            context: usize = state.loop_context_counts.count - 1
                            emit_handler_unwind(state, state.loop_handler_depths[context].usize(), pos)
                            edge_args: (start: u32, count: u16) = append_context_arguments(state, context)
                            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: target, target_count: 1, edge0_arg_start: edge_args.start, edge0_arg_count: edge_args.count, span: ir_span(pos)}
                            state.terminated <- true
                Stmt.Continue(label, pos):
                    if label != "":
                        add_issue(state, LowerIssueKind.UnsupportedLoopLabel, pos.line, "labeled continue is not in the initial IR lowering subset")
                    else:
                        if state.continue_targets.count == 0:
                            add_issue(state, LowerIssueKind.LoopControlOutsideLoop, pos.line, "continue has no enclosing loop")
                        else:
                            target: u32 = state.continue_targets[state.continue_targets.count - 1]
                            context: usize = state.loop_context_counts.count - 1
                            emit_handler_unwind(state, state.loop_handler_depths[context].usize(), pos)
                            edge_args: (start: u32, count: u16) = append_context_arguments(state, context)
                            state.terminator <- Terminator{kind: TerminatorKind.Jump, target0: target, target_count: 1, edge0_arg_start: edge_args.start, edge0_arg_count: edge_args.count, span: ir_span(pos)}
                            state.terminated <- true
                Stmt.Block(kind, clause, binding, body, pos):
                    if kind == "signal":
                        if clause.count == 0:
                            add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "signal must name an effect operation")
                        else:
                            reference: sview = clause[0]
                            operands: mutable darray[u32] = []
                            valid: mutable bool = true
                            for payload_statement in body |state, operands, valid|:
                                match payload_statement:
                                    Stmt.Expr(payload_expression, payload_pos):
                                        lowered_payload: LoweredValue = lower_expression(payload_expression, state)
                                        operands.push(lowered_payload.value) if lowered_payload.valid
                                        valid <- false if not lowered_payload.valid
                                    _:
                                        add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "signal payload must contain value expressions")
                                        valid <- false
                            if valid:
                                operand_start: u32 = state.operand_pool.count.u32()
                                state.operand_pool.extend(operands)
                                state.instructions.push(Instruction{opcode: Opcode.Perform, result: 0, result_type: void_ir_type(), operand_start: operand_start, operand_count: operands.count.u16(), effect_family: effect_family(reference), effect_operation: effect_operation(reference), trace: trace_site(state, reference, pos), span: ir_span(pos)})
                    else:
                        if kind == "with" and clause.count >= 2 and clause[0] == "handler":
                            handler_name: sview = clause[1]
                            add_handler_contract(state, handler_name)
                            state.instructions.push(Instruction{opcode: Opcode.HandlerPush, result: 0, result_type: void_ir_type(), symbol: handler_name, trace: trace_site(state, handler_name, pos), span: ir_span(pos)})
                            handler_depth: usize = state.active_handlers.count
                            state.active_handlers.push(handler_name)
                            scope_mark: usize = state.names.count
                            for nested in body |state, return_type|:
                                lower_statement(nested, return_type, state)
                            state.names.truncate(scope_mark)
                            state.values.truncate(scope_mark)
                            state.types.truncate(scope_mark)
                            state.mutables.truncate(scope_mark)
                            state.instructions.push(Instruction{opcode: Opcode.HandlerPop, result: 0, result_type: void_ir_type(), symbol: handler_name, trace: trace_site(state, "handler-pop", pos), span: ir_span(pos)}) if not state.terminated
                            state.active_handlers.truncate(handler_depth)
                        else:
                            if kind == "can" or kind == "trusted":
                                scope_mark: usize = state.names.count
                                for nested in body |state, return_type|:
                                    lower_statement(nested, return_type, state)
                                state.names.truncate(scope_mark)
                                state.values.truncate(scope_mark)
                                state.types.truncate(scope_mark)
                                state.mutables.truncate(scope_mark)
                            else:
                                add_issue(state, LowerIssueKind.UnsupportedStatement, pos.line, "control block is not in the initial IR lowering subset")
                _:
                    add_issue(state, LowerIssueKind.UnsupportedStatement, 0, "statement is not in the initial IR lowering subset")


        def lower_function(name: sview, params: darray[Ast::ParamDecl]&, return_type_opt: Ast::Expr?, body: darray[Ast::Stmt]&, effects: darray[sview]&, declared_error: sview, pos: Ast::Pos&, function_names: darray[sview]&, function_returns: darray[Type]&, function_parameter_starts: darray[u32]&, function_parameter_counts: darray[u16]&, function_parameter_types: darray[Type]&, function_parameter_names: darray[sview]&, function_parameter_has_defaults: darray[bool]&, function_parameter_defaults: darray[Ast::Expr]&, function_effect_starts: darray[u32]&, function_effect_counts: darray[u16]&, function_effects: darray[sview]&, function_errors: darray[sview]&, handlers: darray[Handler]&, outer_issues: mutable darray[LowerIssue]&) -> Function can[Memory.Allocate, Abort.Panic]:
            return_type: mutable Type = void_ir_type()
            return_type <- type_from_expression(return_expression) if return_type_opt is return_expression
            state: mutable LowerState = LowerState{function: name, next_value: 1, current_block: 1, next_block: 2, instruction_start: 0, structured_depth: 0, blocks: [], names: [], values: [], types: [], mutables: [], instructions: [], operand_pool: [], edge_arg_pool: [], issues: [], break_targets: [], continue_targets: [], pending_parameter_blocks: [], pending_parameters: [], block_parameter_pool: [], loop_context_starts: [], loop_context_counts: [], loop_carried_indices: [], loop_handler_depths: [], element_binding_indices: [], element_owner_indices: [], element_index_values: [], active_handlers: [], terminated: false, terminator: Terminator{kind: TerminatorKind.Unreachable, span: ir_span(pos)}, function_names: function_names, function_returns: function_returns, function_parameter_starts: function_parameter_starts, function_parameter_counts: function_parameter_counts, function_parameter_types: function_parameter_types, function_parameter_names: function_parameter_names, function_parameter_has_defaults: function_parameter_has_defaults, function_parameter_defaults: function_parameter_defaults, function_effect_starts: function_effect_starts, function_effect_counts: function_effect_counts, function_effects: function_effects, function_errors: function_errors, handlers: handlers, function_return_type: return_type, required_effects: [], required_errors: []}
            state.required_effects.extend(effects)
            state.required_errors.push(declared_error) if declared_error != ""
            lowered_params: mutable darray[Parameter] = []
            for parameter in params |state, lowered_params|:
                parameter_type: Type = type_from_expression(parameter.type_expression)
                value: u32 = fresh_value(state)
                lowered_params.push(Parameter{value: value, type: parameter_type, name: parameter.name})
                state.names.push(parameter.name)
                state.values.push(value)
                state.types.push(parameter_type)
                state.mutables.push(parameter.is_mutable or mutable_binding_type(parameter.type_expression))
            for statement in body |state, return_type|:
                lower_statement(statement, return_type, state)
            if not state.terminated:
                if return_type.kind == TypeKind.Void:
                    state.terminator <- Terminator{kind: TerminatorKind.Return, span: ir_span(pos)}
                else:
                    add_issue(state, LowerIssueKind.MissingReturn, pos.line, "non-void function did not lower to a return")
            finish_block(state) if state.current_block != 0
            for found in state.issues |outer_issues|:
                outer_issues.push(found)
            return Function{name: name, parameters: lowered_params, return_type: return_type, effects: state.required_effects, operand_pool: state.operand_pool, edge_arg_pool: state.edge_arg_pool, block_parameter_pool: state.block_parameter_pool, instruction_pool: state.instructions, blocks: state.blocks, entry: 1, errors: state.required_errors}


    public:
        # Lower a semantically checked parser file. The caller must run Semantic::check first;
        # this boundary assumes the source is well typed and reports only lowering coverage.
        def lower_file_with_handlers(file: Ast::File&, module_name: sview, handlers: darray[Handler]&) -> LowerResult can[Memory.Allocate, Abort.Panic]:
            names: mutable darray[sview] = []
            returns: mutable darray[Type] = []
            parameter_starts: mutable darray[u32] = []
            parameter_counts: mutable darray[u16] = []
            parameter_types: mutable darray[Type] = []
            parameter_names: mutable darray[sview] = []
            parameter_has_defaults: mutable darray[bool] = []
            parameter_defaults: mutable darray[Ast::Expr] = []
            effect_starts: mutable darray[u32] = []
            effect_counts: mutable darray[u16] = []
            signature_effects: mutable darray[sview] = []
            signature_errors: mutable darray[sview] = []
            for declaration in file.top_decls |names, returns, parameter_starts, parameter_counts, parameter_types, parameter_names, parameter_has_defaults, parameter_defaults, effect_starts, effect_counts, signature_effects, signature_errors, file|:
                match declaration:
                    Decl.Func(name, params, return_type_opt, body, effects, decorators, pos):
                        return_type: mutable Type = void_ir_type()
                        return_type <- type_from_expression(return_expression) if return_type_opt is return_expression
                        names.push(name)
                        returns.push(return_type)
                        parameter_starts.push(parameter_types.count.u32())
                        parameter_counts.push(params.count.u16())
                        for parameter in params |parameter_types, parameter_names, parameter_has_defaults, parameter_defaults|:
                            parameter_types.push(type_from_expression(parameter.type_expression))
                            parameter_names.push(parameter.name)
                            parameter_has_defaults.push(parameter.has_default)
                            parameter_defaults.push(parameter.default_value)
                        effect_starts.push(signature_effects.count.u32())
                        effect_counts.push(effects.count.u16())
                        signature_effects.extend(effects)
                        declared_error: mutable sview = ""
                        for error_index in 0..<file.error_set_func_lines.count |file, pos, declared_error|:
                            declared_error <- file.error_set_func_names[error_index] if file.error_set_func_lines[error_index] == pos.line
                        signature_errors.push(declared_error)
                    _:
                        pass
            functions: mutable darray[Function] = []
            issues: mutable darray[LowerIssue] = []
            for declaration in file.top_decls |functions, issues, names, returns, parameter_starts, parameter_counts, parameter_types, parameter_names, parameter_has_defaults, parameter_defaults, effect_starts, effect_counts, signature_effects, signature_errors|:
                match declaration:
                    Decl.Func(name, params, return_type_opt, body, effects, decorators, pos):
                        declared_error: mutable sview = ""
                        for error_index in 0..<file.error_set_func_lines.count |file, pos, declared_error|:
                            declared_error <- file.error_set_func_names[error_index] if file.error_set_func_lines[error_index] == pos.line
                        functions.push(lower_function(name, params, return_type_opt, body, effects, declared_error, pos, names, returns, parameter_starts, parameter_counts, parameter_types, parameter_names, parameter_has_defaults, parameter_defaults, effect_starts, effect_counts, signature_effects, signature_errors, handlers, issues))
                    _:
                        issues.push(LowerIssue{kind: LowerIssueKind.UnsupportedDeclaration, function: "", line: 0, message: "declaration is not in the initial IR lowering subset"})
            lowered_handlers: mutable darray[Handler] = []
            lowered_handlers.extend(handlers)
            return LowerResult{module: Module{name: module_name, functions: functions, handlers: lowered_handlers}, issues: issues}


        def lower_file(file: Ast::File&, module_name: sview) -> LowerResult can[Memory.Allocate, Abort.Panic]:
            handlers: darray[Handler] = []
            return lower_file_with_handlers(file, module_name, handlers)
