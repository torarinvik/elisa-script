# Unwired private waiter handoff. Include only after interpret.elisa defines
# Machine/ProcessWaiter and its host helpers. No default facade includes this.
include "process_spawn_budget_model.elisa"
include "process_spawn_budget_darwin.elisa"
include "process_spawn_session_storage.elisa"
include "../runtime/process_spawn_wait_model.elisa"
include "../runtime/process_launch_completion_model.elisa"
include "process_launch_error_adapter.elisa"

extend EsIr:
    private:
        # Session belongs to the enclosing run/task, not this call's stack.
        # Quarantine preserves opaque/native owners and canonical history.
        def evaluate_prepared_session(machine: mutable Machine&, session: mutable PreparedSpawnSession&, timeout_micros: u64, storage: EsProcessLaunchStorage::Prepared&, tables: EsProcessLaunchVectors::BorrowedTables&, runtime_storage: mutable darray[RuntimeValue]&) -> RuntimeValue can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            if machine.failure != InterpretFailure.None or session.state != SpawnSessionState.Ready:
                session.state <- SpawnSessionState.Quarantined
                interpret_set_failure(machine, InterpretFailure.Panic)
                rejected: EsProcessLaunchCompletion::Report = completion_report(session.launch, true)
                return finish_prepared_launch(machine, session.launch.child, session.launch.budget, session.ledger, session.owner_token, timeout_micros, rejected, session.launch.failure)
            ids: SpawnResourceIds = try prepare_session_launch(session) else failure:
                session.state <- SpawnSessionState.Quarantined
                interpret_set_failure(machine, InterpretFailure.Panic)
                rejected: EsProcessLaunchCompletion::Report = completion_report(session.launch, true)
                return finish_prepared_launch(machine, session.launch.child, session.launch.budget, session.ledger, session.owner_token, timeout_micros, rejected, session.launch.failure)
            value: RuntimeValue = evaluate_prepared_launch(machine, session.launch, session.ledger, ids.process, ids.attributes, session.owner_token, timeout_micros, storage, tables)
            if machine.failure == InterpretFailure.Panic:
                session.state <- SpawnSessionState.Quarantined
                return runtime_void()
            try settle_session_launch(session) else failure:
                session.state <- SpawnSessionState.Quarantined
                interpret_set_failure(machine, InterpretFailure.Panic)
                return runtime_void()
            # Process/Time handlers may recover only after all owners retired.
            # This helper does not clear the machine's failure or usage/policy.
            # A reaped child's wait failure has no launch receipt and remains
            # a generic Process error. It must not be fabricated into a cause.
            if machine.failure == InterpretFailure.Process and not EsProcessLaunchFailure::is_pristine(session.launch.failure):
                publish_session_launch_failure(machine, runtime_storage, session, storage)
                session.state <- SpawnSessionState.Quarantined if machine.failure == InterpretFailure.Panic
            return value


        # Called only by a qualified host entry with caller-held launch storage.
        # It remains reachable only inside EsIr; no source primitive or public
        # launcher includes this file. In particular, a fatal unresolved owner
        # must outlive this return rather than be discarded by a stack wrapper.
        def evaluate_prepared_launch(machine: mutable Machine&, launch: mutable BudgetedLaunch&, ledger: mutable EsResource::ResourceLedger&, process_id: u64, attribute_id: u64, owner_token: u64, timeout_micros: u64, storage: EsProcessLaunchStorage::Prepared&, tables: EsProcessLaunchVectors::BorrowedTables&) -> RuntimeValue can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            if machine.failure != InterpretFailure.None or launch.phase != LaunchPhase.Fresh:
                # Do not start a second workflow from a failed machine or reuse
                # a consumed native owner. Still dispatch any already captured
                # Running child for mandatory cleanup before fatal return.
                interpret_set_failure(machine, InterpretFailure.Panic)
                rejected: EsProcessLaunchCompletion::Report = completion_report(launch, true)
                return finish_prepared_launch(machine, launch.child, launch.budget, ledger, owner_token, timeout_micros, rejected, launch.failure)
            # Sample before reservation/setup/search/spawn, not after the
            # child is already running. This is a clock carrier only: PID 0
            # is never passed to wait/signal helpers. Zero disables the clock.
            clock: mutable ProcessWaiter = ProcessWaiter{pid: 0, status: 0, failed: false, timeout_micros: timeout_micros}
            if not process_wait_clock_start(clock):
                # No owner was acquired by this invocation. Still visit the
                # fatal dispatcher in case Fresh phase hides stale ownership.
                # Do not invent a launch receipt for a clock/admission error.
                interpret_set_failure(machine, InterpretFailure.Panic)
                rejected: EsProcessLaunchCompletion::Report = completion_report(launch, true)
                return finish_prepared_launch(machine, launch.child, launch.budget, ledger, owner_token, timeout_micros, rejected, launch.failure)
            launch_failed: mutable bool = false
            # The machine's existing usage/policy are shared with reservation
            # and completion. Do not create a fresh policy/counter for a child.
            catch launch_prepared_budgeted(launch, ledger, machine.resource_usage, machine.resource_policy, process_id, attribute_id, owner_token, storage, tables):
                ok:
                    pass
                error failure:
                    launch_failed <- true
            report: EsProcessLaunchCompletion::Report = completion_report(launch, launch_failed)
            # Even a typed setup/search/cleanup error must visit this dispatcher:
            # a captured Running PID cannot be hidden by an early error return.
            return finish_prepared_launch(machine, launch.child, launch.budget, ledger, owner_token, timeout_micros, report, launch.failure, clock.started_at, clock.clock_started)


        def finish_prepared_launch(machine: mutable Machine&, child: mutable EsProcessSpawnOwner::Owner&, budget: mutable EsProcessSpawnBudget::Reservation&, ledger: mutable EsResource::ResourceLedger&, owner_token: u64, timeout_micros: u64, report: EsProcessLaunchCompletion::Report, diagnostic: mutable EsProcessLaunchFailure::Receipt&, started_at: EsMonotonicTime::MonotonicTimestamp = EsMonotonicTime::MonotonicTimestamp{seconds: 0, nanoseconds: 0}, clock_started: bool = false) -> RuntimeValue can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            match EsProcessLaunchCompletion::route(child, budget.held, report):
                EsProcessLaunchCompletion::Route.Wait:
                    # Missing origin or stale diagnostic state cannot bypass
                    # mandatory live-child cleanup or restart its timeout.
                    if not clock_started or not EsProcessLaunchFailure::is_pristine(diagnostic):
                        return await_spawned_process(machine, child, budget, ledger, owner_token, timeout_micros, true, started_at, clock_started)
                    return await_spawned_process(machine, child, budget, ledger, owner_token, timeout_micros, false, started_at, clock_started)
                EsProcessLaunchCompletion::Route.TerminateThenPanic:
                    return await_spawned_process(machine, child, budget, ledger, owner_token, timeout_micros, true, started_at, clock_started)
                EsProcessLaunchCompletion::Route.ProcessFailure:
                    if child.state == EsProcessSpawnOwner::State.NoChild:
                        catch EsProcessSpawnBudget::require_released_no_child(child, budget, ledger, owner_token):
                            ok:
                                pass
                            error failure:
                                interpret_set_failure(machine, InterpretFailure.Panic)
                                return runtime_void()
                    else:
                        # Fresh admission failure has no reservation to query.
                        if budget.resource_id != 0 or budget.owner_token != 0:
                            interpret_set_failure(machine, InterpretFailure.Panic)
                            return runtime_void()
                    if machine.failure == InterpretFailure.Panic:
                        # Failed/reentrant entries preserve the original cause.
                        return runtime_void()
                    if not EsProcessLaunchFailure::is_pristine(diagnostic):
                        interpret_set_failure(machine, InterpretFailure.Panic)
                        return runtime_void()
                    catch EsProcessLaunchFailure::from_report(child, report):
                        ok receipt:
                            diagnostic <- receipt
                        error failure:
                            interpret_set_failure(machine, InterpretFailure.Panic)
                            return runtime_void()
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                EsProcessLaunchCompletion::Route.Panic:
                    interpret_set_failure(machine, InterpretFailure.Panic)
                    return runtime_void()


        # Preconditions beyond public data: a fresh qualified Darwin spawn
        # succeeded with SETPGROUP/group zero; caller retains exclusive owners,
        # canonical ledger and this machine's usage. Cleanup was attempted and
        # any error/uncertain outcome is represented by cleanup_failed. Never
        # call with a diagnostic PID from an Unknown spawn observation.
        def await_spawned_process(machine: mutable Machine&, child: mutable EsProcessSpawnOwner::Owner&, budget: mutable EsProcessSpawnBudget::Reservation&, ledger: mutable EsResource::ResourceLedger&, owner_token: u64, timeout_micros: u64, cleanup_failed: bool, started_at: EsMonotonicTime::MonotonicTimestamp, clock_started: bool) -> RuntimeValue can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            catch EsProcessSpawnBudget::require_running(child, budget, ledger, machine.resource_usage, owner_token):
                ok:
                    pass
                error failure:
                    # Do not signal a PID whose canonical ownership failed.
                    # Retain state/capacity and prevent recoverable continuation.
                    interpret_set_failure(machine, InterpretFailure.Panic)
                    return runtime_void()
            waiter: mutable ProcessWaiter = prepared_process_waiter(child.pid.int(), timeout_micros, cleanup_failed, started_at, clock_started)
            if cleanup_failed:
                # A post-spawn attribute error must not throw away a live PID.
                process_wait_terminate(waiter)
            else:
                machine over process_wait_next(waiter):
                    state Wait
                    start Wait

                    Wait, ProcessWaitState.Progress:
                        -> Wait
                    Wait, ProcessWaitState.Exited:
                        break
                    Wait, ProcessWaitState.Error:
                        break
            if waiter.ownership_uncertain or not waiter.reaped or not EsProcessSpawnWait::exact_reap(waiter.pid.i64(), child.pid.i64(), waiter.status.i64()):
                interpret_set_failure(machine, InterpretFailure.Panic)
                return runtime_void()
            # Capture terminal observation before fallible canonical close.
            if not EsProcessSpawnOwner::record_reap(child, child.pid, true):
                interpret_set_failure(machine, InterpretFailure.Panic)
                return runtime_void()
            catch EsProcessSpawnBudget::release_reaped(child, budget, ledger, machine.resource_usage, owner_token):
                ok:
                    pass
                error failure:
                    interpret_set_failure(machine, InterpretFailure.Panic)
                    return runtime_void()
            # Do not also call process_resource_complete: the paired release
            # above already consumed the exact same runtime Process counter.
            if cleanup_failed:
                # Reaping resolves child capacity, not uncertain attribute
                # allocation or a broken coordinator/ledger invariant. Do not
                # permit a recoverable Process handler to retry this launch.
                interpret_set_failure(machine, InterpretFailure.Panic)
                return runtime_void()
            if waiter.timed_out:
                interpret_set_failure(machine, InterpretFailure.Time)
                return runtime_void()
            if waiter.failed:
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            status: i64 = try EsProcessSpawnWait::exit_status(waiter.status.i64()) else failure:
                interpret_set_failure(machine, InterpretFailure.Panic)
                return runtime_void()
            return runtime_int(status)


        # Pure handoff: preserve the original origin and timeout together.
        # Never turn an expired finite timeout into the disabled-zero sentinel.
        def prepared_process_waiter(pid: int, timeout_micros: u64, cleanup_failed: bool, started_at: EsMonotonicTime::MonotonicTimestamp, clock_started: bool) -> ProcessWaiter:
            return ProcessWaiter{pid: pid, group_ready: true, status: 0, failed: cleanup_failed, timeout_micros: timeout_micros, started_at: started_at, clock_started: clock_started}
