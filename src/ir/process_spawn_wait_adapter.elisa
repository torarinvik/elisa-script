# Unwired private waiter handoff. Include only after interpret.elisa defines
# Machine/ProcessWaiter and its host helpers. No default facade includes this.
include "process_spawn_budget_model.elisa"
include "process_spawn_budget_darwin.elisa"
include "../runtime/process_spawn_wait_model.elisa"
include "../runtime/process_launch_completion_model.elisa"

extend EsIr:
    private:
        # Called only by a qualified host entry with caller-held launch storage.
        # It remains reachable only inside EsIr; no source primitive or public
        # launcher includes this file. In particular, a fatal unresolved owner
        # must outlive this return rather than be discarded by a stack wrapper.
        def evaluate_prepared_launch(machine: mutable Machine&, launch: mutable BudgetedLaunch&, ledger: mutable EsResource::ResourceLedger&, process_id: u64, attribute_id: u64, owner_token: u64, timeout_micros: u64, storage: EsProcessLaunchStorage::Prepared&, tables: EsProcessLaunchVectors::BorrowedTables&) -> RuntimeValue can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            if machine.failure != InterpretFailure.None or launch.phase != LaunchPhase.Fresh:
                # Do not start a second workflow from a failed machine or reuse
                # a consumed native owner. Still dispatch any already captured
                # Running child for mandatory cleanup before fatal return.
                interpret_set_failure(machine, InterpretFailure.Panic)
                rejected: EsProcessLaunchCompletion::Report = completion_report(launch, true)
                return finish_prepared_launch(machine, launch.child, launch.budget, ledger, owner_token, timeout_micros, rejected)
            launch_failed: mutable bool = false
            # The machine's existing usage/policy are shared with reservation
            # and completion. Do not create a fresh policy/counter for a child.
            catch launch_prepared_budgeted(launch, ledger, machine.resource_usage, machine.resource_policy, process_id, attribute_id, owner_token, storage, tables):
                ok:
                    pass
                error failure:
                    launch_failed <- true
            report: EsProcessLaunchCompletion::Report = completion_report(launch, launch_failed)
            # Even a typed setup/search/cleanup error must visit this dispatcher:
            # a captured Running PID cannot be hidden by an early error return.
            return finish_prepared_launch(machine, launch.child, launch.budget, ledger, owner_token, timeout_micros, report)


        def finish_prepared_launch(machine: mutable Machine&, child: mutable EsProcessSpawnOwner::Owner&, budget: mutable EsProcessSpawnBudget::Reservation&, ledger: mutable EsResource::ResourceLedger&, owner_token: u64, timeout_micros: u64, report: EsProcessLaunchCompletion::Report) -> RuntimeValue can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            match EsProcessLaunchCompletion::route(child, budget.held, report):
                EsProcessLaunchCompletion::Route.Wait:
                    return await_spawned_process(machine, child, budget, ledger, owner_token, timeout_micros, false)
                EsProcessLaunchCompletion::Route.TerminateThenPanic:
                    return await_spawned_process(machine, child, budget, ledger, owner_token, timeout_micros, true)
                EsProcessLaunchCompletion::Route.ProcessFailure:
                    if child.state == EsProcessSpawnOwner::State.NoChild:
                        catch EsProcessSpawnBudget::require_released_no_child(child, budget, ledger, owner_token):
                            ok:
                                pass
                            error failure:
                                interpret_set_failure(machine, InterpretFailure.Panic)
                                return runtime_void()
                    else:
                        # Fresh admission failure has no reservation to query.
                        if budget.resource_id != 0 or budget.owner_token != 0:
                            interpret_set_failure(machine, InterpretFailure.Panic)
                            return runtime_void()
                    interpret_set_failure(machine, InterpretFailure.Process)
                    return runtime_void()
                EsProcessLaunchCompletion::Route.Panic:
                    interpret_set_failure(machine, InterpretFailure.Panic)
                    return runtime_void()


        # Preconditions beyond public data: a fresh qualified Darwin spawn
        # succeeded with SETPGROUP/group zero; caller retains exclusive owners,
        # canonical ledger and this machine's usage. Cleanup was attempted and
        # any error/uncertain outcome is represented by cleanup_failed. Never
        # call with a diagnostic PID from an Unknown spawn observation.
        def await_spawned_process(machine: mutable Machine&, child: mutable EsProcessSpawnOwner::Owner&, budget: mutable EsProcessSpawnBudget::Reservation&, ledger: mutable EsResource::ResourceLedger&, owner_token: u64, timeout_micros: u64, cleanup_failed: bool) -> RuntimeValue can[Blocking.IO, Memory.Allocate, Abort.Panic]:
            catch EsProcessSpawnBudget::require_running(child, budget, ledger, machine.resource_usage, owner_token):
                ok:
                    pass
                error failure:
                    # Do not signal a PID whose canonical ownership failed.
                    # Retain state/capacity and prevent recoverable continuation.
                    interpret_set_failure(machine, InterpretFailure.Panic)
                    return runtime_void()
            waiter: mutable ProcessWaiter = ProcessWaiter{pid: child.pid.int(), group_ready: true, status: 0, failed: cleanup_failed, timeout_micros: timeout_micros}
            if cleanup_failed:
                # A post-spawn attribute error must not throw away a live PID.
                process_wait_terminate(waiter)
            else:
                machine over process_wait_next(waiter):
                    state Wait
                    start Wait

                    Wait, ProcessWaitState.Progress:
                        -> Wait
                    Wait, ProcessWaitState.Exited:
                        break
                    Wait, ProcessWaitState.Error:
                        break
            if not waiter.reaped or not EsProcessSpawnWait::exact_reap(waiter.pid.i64(), child.pid.i64(), waiter.status.i64()):
                interpret_set_failure(machine, InterpretFailure.Panic)
                return runtime_void()
            # Capture terminal observation before fallible canonical close.
            if not EsProcessSpawnOwner::record_reap(child, child.pid, true):
                interpret_set_failure(machine, InterpretFailure.Panic)
                return runtime_void()
            catch EsProcessSpawnBudget::release_reaped(child, budget, ledger, machine.resource_usage, owner_token):
                ok:
                    pass
                error failure:
                    interpret_set_failure(machine, InterpretFailure.Panic)
                    return runtime_void()
            # Do not also call process_resource_complete: the paired release
            # above already consumed the exact same runtime Process counter.
            if cleanup_failed:
                # Reaping resolves child capacity, not uncertain attribute
                # allocation or a broken coordinator/ledger invariant. Do not
                # permit a recoverable Process handler to retry this launch.
                interpret_set_failure(machine, InterpretFailure.Panic)
                return runtime_void()
            if waiter.timed_out:
                interpret_set_failure(machine, InterpretFailure.Time)
                return runtime_void()
            if waiter.failed:
                interpret_set_failure(machine, InterpretFailure.Process)
                return runtime_void()
            status: i64 = try EsProcessSpawnWait::exit_status(waiter.status.i64()) else failure:
                interpret_set_failure(machine, InterpretFailure.Panic)
                return runtime_void()
            return runtime_int(status)
