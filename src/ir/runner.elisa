# Canonical end-to-end execution boundary for `.elisascript` programs.
#
# Keeping source loading, verification, bytecode lowering, and execution in one
# typed entry point prevents adapters (including differential tests and a future
# command-line driver) from accidentally selecting a different semantic path.
# The bytecode engine remains target-independent: it uses direct state-machine
# dispatch when the module is eligible and falls back to the reference
# interpreter for dynamic effects and continuations.

using EsBytecode


extend EsIr:
    public:
        # Compile and execute source text through the canonical bytecode path.
        # Source and runtime failures remain their original Elisa error families;
        # callers can therefore distinguish malformed programs from execution
        # failures without a result-shaped sentinel.
        def execute_elisascript_source(filename: u8&, source: u8&, module_name: sview, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            region script_source_execution(1048576):
                module: Module = try lower_elisascript_source(filename, source, module_name)
                lowered: BytecodeLowerResult = lower_bytecode(module)
                raise InterpretError.VerificationFailed if lowered.issues.count != 0
                return execute_bytecode(lowered.module, entry, arguments, observations, storage, step_limit)


        # File-backed counterpart used by script launchers. The source loader
        # owns the file bytes and source-span filename, so the returned execution
        # is independent of the caller's temporary buffers.
        def execute_elisascript_file(filename: u8&, module_name: sview, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            region script_file_execution(1048576):
                module: Module = try lower_elisascript_file(filename, module_name)
                lowered: BytecodeLowerResult = lower_bytecode(module)
                raise InterpretError.VerificationFailed if lowered.issues.count != 0
                return execute_bytecode(lowered.module, entry, arguments, observations, storage, step_limit)
