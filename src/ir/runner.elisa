# Canonical end-to-end execution boundary for `.elisascript` programs.
#
# Keeping source loading, verification, bytecode lowering, and execution in one
# typed entry point prevents adapters (including differential tests and a future
# command-line driver) from accidentally selecting a different semantic path.
# The bytecode engine remains target-independent: it uses direct state-machine
# dispatch when the module is eligible and falls back to the reference
# interpreter for dynamic effects and continuations.

using EsBytecode
using EsCli


error ElisascriptEntrypointError:
    MissingMain
    InvalidMainSignature


error ElisascriptCliError:
    MissingSource
    InvalidSourceExtension
    EmbeddedNul
    TooManyArguments
    ArgumentsTooLarge


extend EsIr:
    public:
        const module LauncherLimits:
            # Launcher-wide resource contracts are public so the native ABI
            # shim can reject impossible argc before it walks host argv storage.
            ARGUMENTS: usize = 1048576
            ARGUMENT_BYTES: usize = 67108864
            # Raw argc includes the executable name and the `.elisascript` source
            # path in addition to the script arguments admitted above. Keep this
            # derived ABI ceiling beside its source budget so host shims cannot
            # silently drift from the typed parser contract.
            ARGC: i64 = 1048578

        # A launcher-facing request keeps argv as borrowed string views. The
        # driver owns the original argv storage; execution copies these values
        # into the runtime storage before the call crosses the source boundary.
        struct ElisascriptCliRequest:
            source: mutable sview = ""
            arguments: mutable darray[sview] = []
            mode: mutable CliMode = CliMode.Run
            color: mutable CliColorMode = CliColorMode.Auto
            strict_engine: mutable bool = false
            option_end_seen: mutable bool = false


    private:
        const enum ElisascriptCliState of u8:
            Validate
            ValidateArguments
            Done


        struct ElisascriptCliCursor:
            state: mutable ElisascriptCliState
            index: mutable usize
            total_bytes: mutable usize


    public:
        # A launcher-facing diagnostic keeps phase information without changing
        # the programmatic runner's typed error rows. The driver can render the
        # phase and detail, while callers that need ordinary propagation continue
        # using `execute_elisascript_program_file` below.
        struct ElisascriptProgramDiagnostic:
            failed: mutable bool = false
            phase: mutable sview = ""
            detail: mutable sview = ""
            execution: mutable Execution = Execution{value: runtime_void(), steps: 0}
            source_error_known: mutable bool = false
            source_error: mutable ElisascriptSourceError = ElisascriptSourceError.FileIo
            source_parse_diagnostic_known: mutable bool = false
            source_parse_diagnostic_kind: mutable Ast::ParseErrorKind = Ast::ParseErrorKind.ExpectedToken
            source_semantic_diagnostic_known: mutable bool = false
            source_semantic_diagnostic_kind: mutable Semantic::DiagnosticKind = Semantic::DiagnosticKind.UndefinedName
            source_diagnostic_line: mutable u32 = 0
            source_diagnostic_column: mutable u32 = 0
            source_diagnostic_end_line: mutable u32 = 0
            source_diagnostic_end_column: mutable u32 = 0
            source_diagnostic_payload_hash: mutable u64 = 0
            source_diagnostic_payload_context: mutable dstr = []
            source_diagnostic_payload_name: mutable dstr = []
            source_diagnostic_payload_expected: mutable dstr = []
            source_diagnostic_payload_actual: mutable dstr = []
            source_diagnostic_payload_detail: mutable dstr = []
            source_diagnostic_payload_detail2: mutable dstr = []
            source_diagnostic_payload_detail3: mutable dstr = []
            source_diagnostic_payload_excerpt: mutable dstr = []
            source_diagnostic_payload_expected_count: mutable u32 = 0
            source_diagnostic_payload_actual_count: mutable u32 = 0
            source_diagnostic_payload_truncated: mutable bool = false
            source_lower_issue_known: mutable bool = false
            source_lower_issue_kind: mutable LowerIssueKind = LowerIssueKind.TypeMismatch
            source_lower_issue_line: mutable u32 = 0
            entrypoint_error_known: mutable bool = false
            entrypoint_error: mutable ElisascriptEntrypointError = ElisascriptEntrypointError.MissingMain
            bytecode_issue_known: mutable bool = false
            bytecode_issue_kind: mutable IssueKind = IssueKind.InvalidInstruction
            bytecode_issue_block: mutable u32 = 0
            bytecode_issue_value: mutable u32 = 0
            bytecode_issue_trace: mutable u64 = 0
            runtime_error_known: mutable bool = false
            runtime_error: mutable InterpretError = InterpretError.Process


    private:
        # Diagnostic fingerprints are stable comparison keys for differential
        # fixtures and launcher logs.  They deliberately cover the complete
        # host-visible diagnostic record rather than only the human message;
        # changing a phase, enum variant, span, payload field, or truncation
        # bit must produce a different snapshot.  The version seed reserves a
        # migration point if this record ever gains a field with new semantics.
        const module DiagnosticSnapshot:
            VERSION: u64 = 1


        def elisascript_diagnostic_snapshot_mix(hash: mutable u64&, value: u64) -> void:
            hash <- hash ^ value
            hash <- hash * 0x100000001b3


        def elisascript_diagnostic_snapshot_mix_text(hash: mutable u64&, value: sview) -> void:
            elisascript_diagnostic_snapshot_mix(hash, ctx_hash_sview(value))
            elisascript_diagnostic_snapshot_mix(hash, sview_len(value).u64())


        def elisascript_program_diagnostic_failure(result: mutable ElisascriptProgramDiagnostic&, phase: sview, detail: sview) -> void:
            result.failed <- true
            result.phase <- phase
            result.detail <- detail


        # Runtime aggregate offsets are serialized as u32. Check the complete
        # argv slice before narrowing either the existing storage start or the
        # caller-provided argument count; subtraction keeps a hostile host-size
        # value from wrapping during validation.
        const module RuntimeArgumentLimits:
            U32_MAX: usize = 4294967295
            ARGUMENTS: usize = LauncherLimits::ARGUMENTS
            ARGUMENT_BYTES: usize = LauncherLimits::ARGUMENT_BYTES


        def elisascript_runtime_arguments_fit(storage_count: usize, argument_count: usize) -> bool:
            return false if storage_count > RuntimeArgumentLimits::U32_MAX
            return false if argument_count > RuntimeArgumentLimits::ARGUMENTS
            return argument_count <= RuntimeArgumentLimits::U32_MAX - storage_count


        def elisascript_runtime_argument_bytes_fit(arguments: darray[sview]) -> bool:
            total: mutable usize = 0
            for argument in arguments:
                return false if total > RuntimeArgumentLimits::ARGUMENT_BYTES
                length: usize = sview_len(argument)
                return false if length > RuntimeArgumentLimits::ARGUMENT_BYTES - total
                total <- total + length
            return true


    public:
        # Return a deterministic, versioned fingerprint for the launcher
        # diagnostic snapshot.  This is intentionally not a replacement for
        # the typed fields: callers retain the exact enums, coordinates, and
        # bounded payload text for inspection, while the fingerprint provides
        # a compact equality key for differential reports and golden fixtures.
        def elisascript_program_diagnostic_snapshot_fingerprint(diagnostic: ElisascriptProgramDiagnostic&) -> u64:
            fingerprint: mutable u64 = 0xcbf29ce484222325
            elisascript_diagnostic_snapshot_mix(fingerprint, DiagnosticSnapshot::VERSION)
            elisascript_diagnostic_snapshot_mix(fingerprint, 1 if diagnostic.failed else 0)
            elisascript_diagnostic_snapshot_mix_text(fingerprint, diagnostic.phase)
            elisascript_diagnostic_snapshot_mix_text(fingerprint, diagnostic.detail)
            elisascript_diagnostic_snapshot_mix(fingerprint, 1 if diagnostic.source_error_known else 0)
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.source_error.u8().u64())
            elisascript_diagnostic_snapshot_mix(fingerprint, 1 if diagnostic.source_parse_diagnostic_known else 0)
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.source_parse_diagnostic_kind.u8().u64())
            elisascript_diagnostic_snapshot_mix(fingerprint, 1 if diagnostic.source_semantic_diagnostic_known else 0)
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.source_semantic_diagnostic_kind.u8().u64())
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.source_diagnostic_line.u64())
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.source_diagnostic_column.u64())
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.source_diagnostic_end_line.u64())
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.source_diagnostic_end_column.u64())
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.source_diagnostic_payload_hash)
            elisascript_diagnostic_snapshot_mix_text(fingerprint, bytes_view(diagnostic.source_diagnostic_payload_context))
            elisascript_diagnostic_snapshot_mix_text(fingerprint, bytes_view(diagnostic.source_diagnostic_payload_name))
            elisascript_diagnostic_snapshot_mix_text(fingerprint, bytes_view(diagnostic.source_diagnostic_payload_expected))
            elisascript_diagnostic_snapshot_mix_text(fingerprint, bytes_view(diagnostic.source_diagnostic_payload_actual))
            elisascript_diagnostic_snapshot_mix_text(fingerprint, bytes_view(diagnostic.source_diagnostic_payload_detail))
            elisascript_diagnostic_snapshot_mix_text(fingerprint, bytes_view(diagnostic.source_diagnostic_payload_detail2))
            elisascript_diagnostic_snapshot_mix_text(fingerprint, bytes_view(diagnostic.source_diagnostic_payload_detail3))
            elisascript_diagnostic_snapshot_mix_text(fingerprint, bytes_view(diagnostic.source_diagnostic_payload_excerpt))
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.source_diagnostic_payload_expected_count.u64())
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.source_diagnostic_payload_actual_count.u64())
            elisascript_diagnostic_snapshot_mix(fingerprint, 1 if diagnostic.source_diagnostic_payload_truncated else 0)
            elisascript_diagnostic_snapshot_mix(fingerprint, 1 if diagnostic.source_lower_issue_known else 0)
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.source_lower_issue_kind.u8().u64())
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.source_lower_issue_line.u64())
            elisascript_diagnostic_snapshot_mix(fingerprint, 1 if diagnostic.entrypoint_error_known else 0)
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.entrypoint_error.u8().u64())
            elisascript_diagnostic_snapshot_mix(fingerprint, 1 if diagnostic.bytecode_issue_known else 0)
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.bytecode_issue_kind.u8().u64())
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.bytecode_issue_block.u64())
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.bytecode_issue_value.u64())
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.bytecode_issue_trace)
            elisascript_diagnostic_snapshot_mix(fingerprint, 1 if diagnostic.runtime_error_known else 0)
            elisascript_diagnostic_snapshot_mix(fingerprint, diagnostic.runtime_error.u8().u64())
            return fingerprint


        # Compare diagnostic snapshots structurally after (or instead of) using
        # the compact fingerprint.  This closes the collision gap for golden
        # fixtures: every field included in the fingerprint is compared here,
        # including bounded owned text and the explicit truncation state.
        def elisascript_program_diagnostic_snapshot_equal(left: ElisascriptProgramDiagnostic&, right: ElisascriptProgramDiagnostic&) -> bool:
            return false if left.failed != right.failed or left.phase != right.phase or left.detail != right.detail
            return false if left.source_error_known != right.source_error_known or left.source_error != right.source_error
            return false if left.source_parse_diagnostic_known != right.source_parse_diagnostic_known or left.source_parse_diagnostic_kind != right.source_parse_diagnostic_kind
            return false if left.source_semantic_diagnostic_known != right.source_semantic_diagnostic_known or left.source_semantic_diagnostic_kind != right.source_semantic_diagnostic_kind
            return false if left.source_diagnostic_line != right.source_diagnostic_line or left.source_diagnostic_column != right.source_diagnostic_column or left.source_diagnostic_end_line != right.source_diagnostic_end_line or left.source_diagnostic_end_column != right.source_diagnostic_end_column
            return false if left.source_diagnostic_payload_hash != right.source_diagnostic_payload_hash
            return false if bytes_view(left.source_diagnostic_payload_context) != bytes_view(right.source_diagnostic_payload_context) or bytes_view(left.source_diagnostic_payload_name) != bytes_view(right.source_diagnostic_payload_name) or bytes_view(left.source_diagnostic_payload_expected) != bytes_view(right.source_diagnostic_payload_expected) or bytes_view(left.source_diagnostic_payload_actual) != bytes_view(right.source_diagnostic_payload_actual)
            return false if bytes_view(left.source_diagnostic_payload_detail) != bytes_view(right.source_diagnostic_payload_detail) or bytes_view(left.source_diagnostic_payload_detail2) != bytes_view(right.source_diagnostic_payload_detail2) or bytes_view(left.source_diagnostic_payload_detail3) != bytes_view(right.source_diagnostic_payload_detail3) or bytes_view(left.source_diagnostic_payload_excerpt) != bytes_view(right.source_diagnostic_payload_excerpt)
            return false if left.source_diagnostic_payload_expected_count != right.source_diagnostic_payload_expected_count or left.source_diagnostic_payload_actual_count != right.source_diagnostic_payload_actual_count or left.source_diagnostic_payload_truncated != right.source_diagnostic_payload_truncated
            return false if left.source_lower_issue_known != right.source_lower_issue_known or left.source_lower_issue_kind != right.source_lower_issue_kind or left.source_lower_issue_line != right.source_lower_issue_line
            return false if left.entrypoint_error_known != right.entrypoint_error_known or left.entrypoint_error != right.entrypoint_error
            return false if left.bytecode_issue_known != right.bytecode_issue_known or left.bytecode_issue_kind != right.bytecode_issue_kind or left.bytecode_issue_block != right.bytecode_issue_block or left.bytecode_issue_value != right.bytecode_issue_value or left.bytecode_issue_trace != right.bytecode_issue_trace
            return false if left.runtime_error_known != right.runtime_error_known or left.runtime_error != right.runtime_error
            return true


    private:
        # Reusing a diagnostic record must never leak a prior phase, enum, or
        # owned payload into the next run. Keep the complete reset beside the
        # record's fingerprint/equality contract so adding a field has one
        # obvious lifecycle home instead of another ad-hoc caller reset.
        def elisascript_program_diagnostic_reset(result: mutable ElisascriptProgramDiagnostic&) -> void:
            result.failed <- false
            result.phase <- ""
            result.detail <- ""
            result.execution <- Execution{value: runtime_void(), steps: 0}
            result.source_error_known <- false
            result.source_error <- ElisascriptSourceError.FileIo
            result.source_parse_diagnostic_known <- false
            result.source_parse_diagnostic_kind <- Ast::ParseErrorKind.ExpectedToken
            result.source_semantic_diagnostic_known <- false
            result.source_semantic_diagnostic_kind <- Semantic::DiagnosticKind.UndefinedName
            result.source_diagnostic_line <- 0
            result.source_diagnostic_column <- 0
            result.source_diagnostic_end_line <- 0
            result.source_diagnostic_end_column <- 0
            result.source_diagnostic_payload_hash <- 0
            result.source_diagnostic_payload_context <- []
            result.source_diagnostic_payload_name <- []
            result.source_diagnostic_payload_expected <- []
            result.source_diagnostic_payload_actual <- []
            result.source_diagnostic_payload_detail <- []
            result.source_diagnostic_payload_detail2 <- []
            result.source_diagnostic_payload_detail3 <- []
            result.source_diagnostic_payload_excerpt <- []
            result.source_diagnostic_payload_expected_count <- 0
            result.source_diagnostic_payload_actual_count <- 0
            result.source_diagnostic_payload_truncated <- false
            result.source_lower_issue_known <- false
            result.source_lower_issue_kind <- LowerIssueKind.TypeMismatch
            result.source_lower_issue_line <- 0
            result.entrypoint_error_known <- false
            result.entrypoint_error <- ElisascriptEntrypointError.MissingMain
            result.bytecode_issue_known <- false
            result.bytecode_issue_kind <- IssueKind.InvalidInstruction
            result.bytecode_issue_block <- 0
            result.bytecode_issue_value <- 0
            result.bytecode_issue_trace <- 0
            result.runtime_error_known <- false
            result.runtime_error <- InterpretError.Process


        # Parse argv after the launcher name. No shell-like splitting or
        # environment expansion happens here: each incoming element remains one
        # typed text argument, which preserves spaces and empty values exactly.
        # The first element is the source path and must use the `.elisascript`
        # extension accepted by the file source boundary.
        def parse_elisascript_cli[@r](arguments: darray[sview]&, result: mutable ElisascriptCliRequest& @r) -> void error[ElisascriptCliError] can[Memory.Allocate, Abort.Panic]:
            cursor: mutable ElisascriptCliCursor = ElisascriptCliCursor{state: ElisascriptCliState.Validate, index: 1, total_bytes: 0}
            machine over cursor.state:
                state Validate
                start Validate

                Validate, ElisascriptCliState.Validate if arguments.count == 0:
                    raise ElisascriptCliError.MissingSource
                    break

                Validate, ElisascriptCliState.Validate if sview_contains_byte(arguments[0], 0):
                    raise ElisascriptCliError.EmbeddedNul
                    break

                Validate, ElisascriptCliState.Validate if not sview_ends_with(arguments[0], ".elisascript"):
                    raise ElisascriptCliError.InvalidSourceExtension
                    break

                Validate, ElisascriptCliState.Validate if arguments.count - 1 > LauncherLimits::ARGUMENTS:
                    raise ElisascriptCliError.TooManyArguments
                    break

                Validate, ElisascriptCliState.Validate:
                    cursor.state <- ElisascriptCliState.ValidateArguments
                    -> Validate

                Validate, ElisascriptCliState.ValidateArguments if cursor.index >= arguments.count:
                    cursor.state <- ElisascriptCliState.Done
                    -> Validate

                Validate, ElisascriptCliState.ValidateArguments if sview_len(arguments[cursor.index]) > LauncherLimits::ARGUMENT_BYTES - cursor.total_bytes:
                    raise ElisascriptCliError.ArgumentsTooLarge
                    break

                Validate, ElisascriptCliState.ValidateArguments if sview_contains_byte(arguments[cursor.index], 0):
                    raise ElisascriptCliError.EmbeddedNul
                    break

                Validate, ElisascriptCliState.ValidateArguments:
                    cursor.total_bytes <- cursor.total_bytes + sview_len(arguments[cursor.index])
                    cursor.index <- cursor.index + 1
                    -> Validate

                Validate, ElisascriptCliState.Done:
                    break

            result.source <- arguments[0]
            result.arguments <- []
            for index in 1..<arguments.count |result|:
                result.arguments.push(arguments[index])


    private:
        const enum ElisascriptEntrypointState of u8:
            Search
            Validate
            Done


        struct ElisascriptEntrypointCursor:
            state: mutable ElisascriptEntrypointState
            index: mutable usize
            found: mutable bool


        def elisascript_main_signature_valid(function: Function&) -> bool:
            expected_arguments: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Text}
            expected_return: Type = Type{kind: TypeKind.Int, bits: 64, signed: true}
            return function.parameters.count == 1 and same_type(function.parameters[0].type, expected_arguments) and same_type(function.return_type, expected_return)


        # The launcher ABI is intentionally narrow: one text-array argument and
        # an i64 exit status. Effects and Elisa error rows remain unconstrained so
        # scripts can use the complete standard library without an adapter-specific
        # wrapper.
    public:
        def validate_elisascript_entrypoint(module: Module&) -> void error[ElisascriptEntrypointError]:
            cursor: mutable ElisascriptEntrypointCursor = ElisascriptEntrypointCursor{state: ElisascriptEntrypointState.Search, index: 0, found: false}
            machine over cursor.state:
                state Validate
                start Validate

                Validate, ElisascriptEntrypointState.Search if cursor.index >= module.functions.count and not cursor.found:
                    raise ElisascriptEntrypointError.MissingMain
                    break

                Validate, ElisascriptEntrypointState.Search if cursor.index >= module.functions.count:
                    cursor.state <- ElisascriptEntrypointState.Done
                    -> Validate

                Validate, ElisascriptEntrypointState.Search if module.functions[cursor.index].name != "main":
                    cursor.index <- cursor.index + 1
                    -> Validate

                Validate, ElisascriptEntrypointState.Search:
                    cursor.found <- true
                    cursor.state <- ElisascriptEntrypointState.Validate
                    -> Validate

                Validate, ElisascriptEntrypointState.Validate if not elisascript_main_signature_valid(module.functions[cursor.index]):
                    raise ElisascriptEntrypointError.InvalidMainSignature
                    break

                Validate, ElisascriptEntrypointState.Validate:
                    cursor.state <- ElisascriptEntrypointState.Done
                    -> Validate

                Validate, ElisascriptEntrypointState.Done:
                    break


    private:
        const enum ElisascriptProgramDiagnosticMode of u8:
            VerifyOnly
            Execute
            ExecuteDirectOnly


        const enum ScriptInvocationContextBuildState of u8:
            Prepare
            NormalizeAbsolute
            ReadPhysicalDirectory
            ResolvePhysicalDirectory
            ReadLogicalDirectory
            ResolveLogicalDirectory
            JoinRelativeSource
            ValidateResult
            Done


        struct ScriptInvocationContextBuildCursor:
            state: mutable ScriptInvocationContextBuildState
            source_name: mutable sview = ""
            physical_directory: mutable sview = ""
            physical_real: mutable sview = ""
            base_directory: mutable sview = ""
            logical_directory: mutable sview = ""
            source_path: mutable sview = ""


        def elisascript_absolute_normalized_directory(value: sview) -> sview can[Memory.Allocate, Abort.Panic]:
            return "" if not path_shape_result_valid(value) or not path_is_absolute_value(value)
            normalized: sview = path_normalize_value(value)
            return "" if not path_shape_result_valid(normalized) or not path_is_absolute_value(normalized)
            return normalized


        # Resolve Bash-compatible launch spelling before script code can change
        # cwd. Relative names use a valid logical PWD when it resolves to the
        # physical startup directory, otherwise the physical cwd. This is the
        # shell-style logical launch spelling, not the kernel-resolved file
        # identity: `..` is lexically normalized before symlink traversal just
        # as `dirname "$0"` followed by `cd -L` does. Preserve symlink path
        # components, including a final script symlink.
        def elisascript_script_invocation_context(filename: u8&) -> ScriptInvocationContext error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            too_large: mutable bool = false
            filename_length: usize = elisascript_source_filename_length_bounded(filename, too_large)
            raise InterpretError.InvocationContextUnavailable if too_large or filename_length == 0
            cursor: mutable ScriptInvocationContextBuildCursor = ScriptInvocationContextBuildCursor{state: ScriptInvocationContextBuildState.Prepare}
            machine over cursor.state:
                state Build
                start Build

                Build, ScriptInvocationContextBuildState.Prepare:
                    cursor.source_name <- filename[0:filename_length]
                    raise InterpretError.InvocationContextUnavailable if not path_shape_text_valid(cursor.source_name)
                    cursor.state <- ScriptInvocationContextBuildState.NormalizeAbsolute if path_is_absolute_value(cursor.source_name)
                    cursor.state <- ScriptInvocationContextBuildState.ReadPhysicalDirectory if not path_is_absolute_value(cursor.source_name)
                    -> Build

                Build, ScriptInvocationContextBuildState.NormalizeAbsolute:
                    cursor.source_path <- path_normalize_value(cursor.source_name)
                    cursor.state <- ScriptInvocationContextBuildState.ValidateResult
                    -> Build

                Build, ScriptInvocationContextBuildState.ReadPhysicalDirectory:
                    catch current_directory_value():
                        ok current:
                            cursor.physical_directory <- current
                        error failure:
                            raise InterpretError.InvocationContextUnavailable
                    raise InterpretError.InvocationContextUnavailable if not path_shape_result_valid(cursor.physical_directory) or not path_is_absolute_value(cursor.physical_directory)
                    cursor.base_directory <- cursor.physical_directory
                    cursor.state <- ScriptInvocationContextBuildState.ResolvePhysicalDirectory
                    -> Build

                Build, ScriptInvocationContextBuildState.ResolvePhysicalDirectory:
                    catch path_real_value(cursor.physical_directory):
                        ok resolved:
                            cursor.physical_real <- resolved
                        error failure:
                            raise InterpretError.InvocationContextUnavailable
                    cursor.state <- ScriptInvocationContextBuildState.ReadLogicalDirectory
                    -> Build

                Build, ScriptInvocationContextBuildState.ReadLogicalDirectory:
                    catch get_environment_value("PWD"):
                        ok logical_directory:
                            cursor.logical_directory <- elisascript_absolute_normalized_directory(logical_directory)
                        error failure:
                            cursor.logical_directory <- ""
                    cursor.state <- ScriptInvocationContextBuildState.ResolveLogicalDirectory if cursor.logical_directory != ""
                    cursor.state <- ScriptInvocationContextBuildState.JoinRelativeSource if cursor.logical_directory == ""
                    -> Build

                Build, ScriptInvocationContextBuildState.ResolveLogicalDirectory:
                    catch path_real_value(cursor.logical_directory):
                        ok resolved:
                            cursor.base_directory <- cursor.logical_directory if resolved == cursor.physical_real
                        error failure:
                            pass
                    cursor.state <- ScriptInvocationContextBuildState.JoinRelativeSource
                    -> Build

                Build, ScriptInvocationContextBuildState.JoinRelativeSource:
                    joined_source: sview = path_join_value(cursor.base_directory, cursor.source_name)
                    raise InterpretError.InvocationContextUnavailable if not path_shape_result_valid(joined_source)
                    cursor.source_path <- path_normalize_value(joined_source)
                    cursor.state <- ScriptInvocationContextBuildState.ValidateResult
                    -> Build

                Build, ScriptInvocationContextBuildState.ValidateResult:
                    raise InterpretError.InvocationContextUnavailable if not path_shape_result_valid(cursor.source_path) or not path_is_absolute_value(cursor.source_path)
                    cursor.state <- ScriptInvocationContextBuildState.Done
                    -> Build

                Build, ScriptInvocationContextBuildState.Done:
                    break

            return ScriptInvocationContext{source_path: cursor.source_path, available: true}


        # Invocation metadata is optional until a script reads it. A failure
        # to capture launch spelling must not stop a file-backed program that
        # never calls `Script::source_path()`.
        def elisascript_optional_script_invocation_context(filename: u8&) -> ScriptInvocationContext can[Memory.Allocate, Abort.Panic]:
            catch elisascript_script_invocation_context(filename):
                ok context:
                    return context
                error failure:
                    return ScriptInvocationContext{}


        def elisascript_execute_program_bytecode(module: BytecodeModule&, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, mode: ElisascriptProgramDiagnosticMode, invocation_context: ScriptInvocationContext = ScriptInvocationContext{}) -> Execution error[InterpretError] can[Memory.Allocate, Abort.Panic]:
            return execute_bytecode_direct_only(module, "main", arguments, observations, storage, ES_RUNTIME_DEFAULT_MAX_STEPS, ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS, invocation_context) if mode == ElisascriptProgramDiagnosticMode.ExecuteDirectOnly
            return execute_bytecode(module, "main", arguments, observations, storage, ES_RUNTIME_DEFAULT_MAX_STEPS, ES_RUNTIME_DEFAULT_MAX_OBSERVATIONS, invocation_context)


        # Canonical file-backed program pipeline for launchers that need a
        # phase-aware diagnostic instead of a generic propagated error. Every
        # stage remains the same typed source/IR/bytecode path as the ordinary
        # entrypoint; only the final host-facing error representation changes.
        def elisascript_program_file_diagnostic(filename: u8&, arguments: darray[sview]&, result: mutable ElisascriptProgramDiagnostic&, mode: ElisascriptProgramDiagnosticMode) -> void can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            elisascript_program_diagnostic_reset(result)
            region script_program_file_diagnostic(1048576):
                module: mutable Module = Module{name: "", functions: []}
                source_diagnostic: mutable ElisascriptSourceDiagnosticSummary = ElisascriptSourceDiagnosticSummary{}
                lower_issue: mutable ElisascriptLowerIssueSummary = ElisascriptLowerIssueSummary{}
                handlers: darray[Handler] = []
                catch lower_elisascript_file_with_handlers_diagnostic(filename, "elisascript-program", handlers, source_diagnostic, lower_issue):
                    ok loaded:
                        module <- loaded
                    error failure:
                        result.source_error_known <- true
                        result.source_error <- failure
                        result.source_parse_diagnostic_known <- source_diagnostic.parse_known
                        result.source_parse_diagnostic_kind <- source_diagnostic.parse_kind
                        result.source_semantic_diagnostic_known <- source_diagnostic.semantic_known
                        result.source_semantic_diagnostic_kind <- source_diagnostic.semantic_kind
                        result.source_diagnostic_line <- source_diagnostic.line
                        result.source_diagnostic_column <- source_diagnostic.column
                        result.source_diagnostic_end_line <- source_diagnostic.end_line
                        result.source_diagnostic_end_column <- source_diagnostic.end_column
                        result.source_diagnostic_payload_hash <- source_diagnostic.payload_hash
                        result.source_diagnostic_payload_context <- source_diagnostic.payload_context
                        result.source_diagnostic_payload_name <- source_diagnostic.payload_name
                        result.source_diagnostic_payload_expected <- source_diagnostic.payload_expected
                        result.source_diagnostic_payload_actual <- source_diagnostic.payload_actual
                        result.source_diagnostic_payload_detail <- source_diagnostic.payload_detail
                        result.source_diagnostic_payload_detail2 <- source_diagnostic.payload_detail2
                        result.source_diagnostic_payload_detail3 <- source_diagnostic.payload_detail3
                        result.source_diagnostic_payload_excerpt <- source_diagnostic.payload_excerpt
                        result.source_diagnostic_payload_expected_count <- source_diagnostic.payload_expected_count
                        result.source_diagnostic_payload_actual_count <- source_diagnostic.payload_actual_count
                        result.source_diagnostic_payload_truncated <- source_diagnostic.payload_truncated
                        result.source_lower_issue_known <- lower_issue.known
                        result.source_lower_issue_kind <- lower_issue.kind
                        result.source_lower_issue_line <- lower_issue.line
                        return elisascript_program_diagnostic_failure(result, "source", "unable to load, parse, type-check, lower, or verify program")
                if mode != ElisascriptProgramDiagnosticMode.VerifyOnly:
                    catch validate_elisascript_entrypoint(module):
                        ok:
                            pass
                        error failure:
                            result.entrypoint_error_known <- true
                            result.entrypoint_error <- failure
                            return elisascript_program_diagnostic_failure(result, "entrypoint", "main must have signature main(arguments: darray[sview]) -> i64")
                lowered: BytecodeLowerResult = lower_bytecode(module)
                if lowered.issues.count != 0:
                    issue: Issue = lowered.issues[0]
                    result.bytecode_issue_known <- true
                    result.bytecode_issue_kind <- issue.kind
                    result.bytecode_issue_block <- issue.block
                    result.bytecode_issue_value <- issue.value
                    result.bytecode_issue_trace <- issue.trace
                    return elisascript_program_diagnostic_failure(result, "bytecode", "verified bytecode lowering rejected the program")
                return if mode == ElisascriptProgramDiagnosticMode.VerifyOnly
                observations: mutable darray[Observation] = []
                storage: mutable darray[RuntimeValue] = []
                if not elisascript_runtime_arguments_fit(storage.count, arguments.count) or not elisascript_runtime_argument_bytes_fit(arguments):
                    result.runtime_error_known <- true
                    result.runtime_error <- InterpretError.ArgumentMismatch
                    return elisascript_program_diagnostic_failure(result, "runtime", "program arguments exceed the runtime aggregate limit")
                argument_start: u32 = storage.count.u32()
                for argument in arguments |storage|:
                    storage.push(runtime_text(argument))
                runtime_arguments: darray[RuntimeValue] = [runtime_array(argument_start, arguments.count.u32())]
                invocation_context: ScriptInvocationContext = elisascript_optional_script_invocation_context(filename)
                catch elisascript_execute_program_bytecode(lowered.module, runtime_arguments, observations, storage, mode, invocation_context):
                    ok execution:
                        result.execution <- execution
                    error failure:
                        result.runtime_error_known <- true
                        result.runtime_error <- failure
                        return elisascript_program_diagnostic_failure(result, "runtime", "program execution failed")


    public:
        # Execute the standard file-backed program with a phase-aware diagnostic.
        def execute_elisascript_program_file_diagnostic(filename: u8&, arguments: darray[sview]&, result: mutable ElisascriptProgramDiagnostic&) -> void can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            elisascript_program_file_diagnostic(filename, arguments, result, ElisascriptProgramDiagnosticMode.Execute)


        # Strict-engine execution is evidence-oriented: it accepts only the
        # direct bytecode engine and reports UnsupportedInstruction instead of
        # silently switching to the reference interpreter.
        def execute_elisascript_program_file_direct_only_diagnostic(filename: u8&, arguments: darray[sview]&, result: mutable ElisascriptProgramDiagnostic&) -> void can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            elisascript_program_file_diagnostic(filename, arguments, result, ElisascriptProgramDiagnosticMode.ExecuteDirectOnly)


        # `--check` shares parsing, type-checking, IR verification, and bytecode
        # verification with the launcher but deliberately does not require a
        # `main` entrypoint, stage argv into runtime storage, or execute code.
        # Reuse the complete diagnostic record so check failures retain the
        # same source and verifier provenance as an ordinary run.
        def check_elisascript_program_file_diagnostic(filename: u8&, result: mutable ElisascriptProgramDiagnostic&) -> void can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            no_arguments: darray[sview] = []
            elisascript_program_file_diagnostic(filename, no_arguments, result, ElisascriptProgramDiagnosticMode.VerifyOnly)


        # Compile and execute a standard program from source text with
        # caller-supplied dynamic handlers. The caller's storage receives the
        # argv text values, allowing the entry function to inspect them with
        # ordinary checked array operations.
        def execute_elisascript_program_source_with_handlers(filename: u8&, source: u8&, module_name: sview, arguments: darray[sview]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handlers: darray[Handler]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, ElisascriptEntrypointError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            region script_program_source(1048576):
                module: Module = try lower_elisascript_source_with_handlers(filename, source, module_name, handlers)
                try validate_elisascript_entrypoint(module)
                lowered: BytecodeLowerResult = lower_bytecode(module)
                raise InterpretError.VerificationFailed if lowered.issues.count != 0
                raise InterpretError.ArgumentMismatch if not elisascript_runtime_arguments_fit(storage.count, arguments.count) or not elisascript_runtime_argument_bytes_fit(arguments)
                argument_start: u32 = storage.count.u32()
                for argument in arguments |storage|:
                    storage.push(runtime_text(argument))
                runtime_arguments: darray[RuntimeValue] = [runtime_array(argument_start, arguments.count.u32())]
                return execute_bytecode(lowered.module, "main", runtime_arguments, observations, storage, step_limit)


        # Length-delimited counterpart for hosts that own source bytes rather
        # than a terminated C string. The source loader rejects embedded NULs
        # before this runner can construct a module.
        def execute_elisascript_program_source_bytes_with_handlers(filename: u8&, source: u8&, source_length: usize, module_name: sview, arguments: darray[sview]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handlers: darray[Handler]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, ElisascriptEntrypointError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            region script_program_source_bytes(1048576):
                module: Module = try lower_elisascript_source_bytes_with_handlers(filename, source, source_length, module_name, handlers)
                try validate_elisascript_entrypoint(module)
                lowered: BytecodeLowerResult = lower_bytecode(module)
                raise InterpretError.VerificationFailed if lowered.issues.count != 0
                raise InterpretError.ArgumentMismatch if not elisascript_runtime_arguments_fit(storage.count, arguments.count) or not elisascript_runtime_argument_bytes_fit(arguments)
                argument_start: u32 = storage.count.u32()
                for argument in arguments |storage|:
                    storage.push(runtime_text(argument))
                runtime_arguments: darray[RuntimeValue] = [runtime_array(argument_start, arguments.count.u32())]
                return execute_bytecode(lowered.module, "main", runtime_arguments, observations, storage, step_limit)


        def execute_elisascript_program_source_bytes(filename: u8&, source: u8&, source_length: usize, module_name: sview, arguments: darray[sview]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, ElisascriptEntrypointError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            handlers: darray[Handler] = []
            return execute_elisascript_program_source_bytes_with_handlers(filename, source, source_length, module_name, arguments, observations, storage, handlers, step_limit)


        # Standard program execution without dynamic handlers remains the
        # compact default used by the launcher.
        def execute_elisascript_program_source(filename: u8&, source: u8&, module_name: sview, arguments: darray[sview]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, ElisascriptEntrypointError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            handlers: darray[Handler] = []
            return execute_elisascript_program_source_with_handlers(filename, source, module_name, arguments, observations, storage, handlers, step_limit)


        # File-backed standard program entry point. This is the ABI the bundled
        # `.elisascript` command-line driver calls without knowing internal IR
        # function names or constructing runtime values itself.
        def execute_elisascript_program_file_with_handlers(filename: u8&, arguments: darray[sview]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handlers: darray[Handler]&, step_limit: u64 = 1000000, output_limit: usize = EsIr::ES_RUNTIME_DEFAULT_MAX_OUTPUT_BYTES) -> Execution error[ElisascriptSourceError, ElisascriptEntrypointError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            region script_program_file(1048576):
                module: Module = try lower_elisascript_file_with_handlers(filename, "elisascript-program", handlers)
                try validate_elisascript_entrypoint(module)
                lowered: BytecodeLowerResult = lower_bytecode(module)
                raise InterpretError.VerificationFailed if lowered.issues.count != 0
                invocation_context: ScriptInvocationContext = elisascript_optional_script_invocation_context(filename)
                raise InterpretError.ArgumentMismatch if not elisascript_runtime_arguments_fit(storage.count, arguments.count) or not elisascript_runtime_argument_bytes_fit(arguments)
                argument_start: u32 = storage.count.u32()
                for argument in arguments |storage|:
                    storage.push(runtime_text(argument))
                runtime_arguments: darray[RuntimeValue] = [runtime_array(argument_start, arguments.count.u32())]
                policy: mutable RuntimeResourcePolicy = runtime_resource_policy_with_step_limit(RuntimeResourcePolicy{}, step_limit)
                policy.output_bytes <- output_limit
                return execute_bytecode_with_resource_policy(lowered.module, "main", runtime_arguments, observations, storage, policy, invocation_context)


        def execute_elisascript_program_file(filename: u8&, arguments: darray[sview]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, ElisascriptEntrypointError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            handlers: darray[Handler] = []
            return execute_elisascript_program_file_with_handlers(filename, arguments, observations, storage, handlers, step_limit)


        # Compile and execute source text through the canonical bytecode path.
        # Source and runtime failures remain their original Elisa error families;
        # callers can therefore distinguish malformed programs from execution
        # failures without a result-shaped sentinel.
        def execute_elisascript_source_with_handlers(filename: u8&, source: u8&, module_name: sview, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handlers: darray[Handler]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            region script_source_execution(1048576):
                module: Module = try lower_elisascript_source_with_handlers(filename, source, module_name, handlers)
                lowered: BytecodeLowerResult = lower_bytecode(module)
                raise InterpretError.VerificationFailed if lowered.issues.count != 0
                return execute_bytecode(lowered.module, entry, arguments, observations, storage, step_limit)


        # Length-delimited entry-point execution preserves the same typed
        # handlers, storage, and error families as the C-string source API.
        def execute_elisascript_source_bytes_with_handlers(filename: u8&, source: u8&, source_length: usize, module_name: sview, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handlers: darray[Handler]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            region script_source_bytes_execution(1048576):
                module: Module = try lower_elisascript_source_bytes_with_handlers(filename, source, source_length, module_name, handlers)
                lowered: BytecodeLowerResult = lower_bytecode(module)
                raise InterpretError.VerificationFailed if lowered.issues.count != 0
                return execute_bytecode(lowered.module, entry, arguments, observations, storage, step_limit)


        def execute_elisascript_source_bytes(filename: u8&, source: u8&, source_length: usize, module_name: sview, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            handlers: darray[Handler] = []
            return execute_elisascript_source_bytes_with_handlers(filename, source, source_length, module_name, entry, arguments, observations, storage, handlers, step_limit)


        def execute_elisascript_source(filename: u8&, source: u8&, module_name: sview, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            handlers: darray[Handler] = []
            return execute_elisascript_source_with_handlers(filename, source, module_name, entry, arguments, observations, storage, handlers, step_limit)


        # File-backed counterpart used by script launchers. The source loader
        # owns the file bytes and source-span filename, so the returned execution
        # is independent of the caller's temporary buffers.
        def execute_elisascript_file_with_handlers(filename: u8&, module_name: sview, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handlers: darray[Handler]&, step_limit: u64 = 1000000, output_limit: usize = EsIr::ES_RUNTIME_DEFAULT_MAX_OUTPUT_BYTES) -> Execution error[ElisascriptSourceError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            region script_file_execution(1048576):
                module: Module = try lower_elisascript_file_with_handlers(filename, module_name, handlers)
                lowered: BytecodeLowerResult = lower_bytecode(module)
                raise InterpretError.VerificationFailed if lowered.issues.count != 0
                invocation_context: ScriptInvocationContext = elisascript_optional_script_invocation_context(filename)
                policy: mutable RuntimeResourcePolicy = runtime_resource_policy_with_step_limit(RuntimeResourcePolicy{}, step_limit)
                policy.output_bytes <- output_limit
                return execute_bytecode_with_resource_policy(lowered.module, entry, arguments, observations, storage, policy, invocation_context)


        def execute_elisascript_file(filename: u8&, module_name: sview, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            handlers: darray[Handler] = []
            return execute_elisascript_file_with_handlers(filename, module_name, entry, arguments, observations, storage, handlers, step_limit)
