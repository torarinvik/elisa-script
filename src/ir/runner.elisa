# Canonical end-to-end execution boundary for `.elisascript` programs.
#
# Keeping source loading, verification, bytecode lowering, and execution in one
# typed entry point prevents adapters (including differential tests and a future
# command-line driver) from accidentally selecting a different semantic path.
# The bytecode engine remains target-independent: it uses direct state-machine
# dispatch when the module is eligible and falls back to the reference
# interpreter for dynamic effects and continuations.

using EsBytecode


error ElisascriptEntrypointError:
    MissingMain
    InvalidMainSignature


error ElisascriptCliError:
    MissingSource
    InvalidSourceExtension
    EmbeddedNul


extend EsIr:
    public:
        # A launcher-facing request keeps argv as borrowed string views. The
        # driver owns the original argv storage; execution copies these values
        # into the runtime storage before the call crosses the source boundary.
        struct ElisascriptCliRequest:
            source: mutable sview = ""
            arguments: mutable darray[sview] = []


    private:
        const enum ElisascriptCliState of u8:
            Validate
            Done


        struct ElisascriptCliCursor:
            state: mutable ElisascriptCliState


    public:
        # A launcher-facing diagnostic keeps phase information without changing
        # the programmatic runner's typed error rows. The driver can render the
        # phase and detail, while callers that need ordinary propagation continue
        # using `execute_elisascript_program_file` below.
        struct ElisascriptProgramDiagnostic:
            failed: mutable bool = false
            phase: mutable sview = ""
            detail: mutable sview = ""
            execution: mutable Execution = Execution{value: runtime_void(), steps: 0}
            source_error_known: mutable bool = false
            source_error: mutable ElisascriptSourceError = ElisascriptSourceError.FileIo
            entrypoint_error_known: mutable bool = false
            entrypoint_error: mutable ElisascriptEntrypointError = ElisascriptEntrypointError.MissingMain
            runtime_error_known: mutable bool = false
            runtime_error: mutable InterpretError = InterpretError.Process


    private:
        def elisascript_program_diagnostic_failure(result: mutable ElisascriptProgramDiagnostic&, phase: sview, detail: sview) -> void:
            result.failed <- true
            result.phase <- phase
            result.detail <- detail


        # Runtime aggregate offsets are serialized as u32. Check the complete
        # argv slice before narrowing either the existing storage start or the
        # caller-provided argument count; subtraction keeps a hostile host-size
        # value from wrapping during validation.
        const ELISASCRIPT_RUNTIME_U32_MAX: usize = 4294967295
        const ELISASCRIPT_MAX_ARGUMENT_BYTES: usize = 67108864


        def elisascript_runtime_arguments_fit(storage_count: usize, argument_count: usize) -> bool:
            return false if storage_count > ELISASCRIPT_RUNTIME_U32_MAX
            return argument_count <= ELISASCRIPT_RUNTIME_U32_MAX - storage_count


        def elisascript_runtime_argument_bytes_fit(arguments: darray[sview]) -> bool:
            total: mutable usize = 0
            for argument in arguments:
                return false if total > ELISASCRIPT_MAX_ARGUMENT_BYTES
                length: usize = sview_len(argument)
                return false if length > ELISASCRIPT_MAX_ARGUMENT_BYTES - total
                total <- total + length
            return true


    public:
        # Parse argv after the launcher name. No shell-like splitting or
        # environment expansion happens here: each incoming element remains one
        # typed text argument, which preserves spaces and empty values exactly.
        # The first element is the source path and must use the `.elisascript`
        # extension accepted by the file source boundary.
        def parse_elisascript_cli[@r](arguments: darray[sview]&, result: mutable ElisascriptCliRequest& @r) -> void error[ElisascriptCliError] can[Memory.Allocate, Abort.Panic]:
            cursor: mutable ElisascriptCliCursor = ElisascriptCliCursor{state: ElisascriptCliState.Validate}
            machine over cursor.state:
                state Validate
                start Validate

                Validate, ElisascriptCliState.Validate if arguments.count == 0:
                    raise ElisascriptCliError.MissingSource
                    break

                Validate, ElisascriptCliState.Validate if sview_contains_byte(arguments[0], 0):
                    raise ElisascriptCliError.EmbeddedNul
                    break

                Validate, ElisascriptCliState.Validate if not sview_ends_with(arguments[0], ".elisascript"):
                    raise ElisascriptCliError.InvalidSourceExtension
                    break

                Validate, ElisascriptCliState.Validate:
                    cursor.state <- ElisascriptCliState.Done
                    -> Validate

                Validate, ElisascriptCliState.Done:
                    break

            result.source <- arguments[0]
            result.arguments <- []
            for index in 1..<arguments.count |result|:
                result.arguments.push(arguments[index])


    private:
        const enum ElisascriptEntrypointState of u8:
            Search
            Validate
            Done


        struct ElisascriptEntrypointCursor:
            state: mutable ElisascriptEntrypointState
            index: mutable usize
            found: mutable bool


        def elisascript_main_signature_valid(function: Function&) -> bool:
            expected_arguments: Type = Type{kind: TypeKind.Array, element_kind: TypeKind.Text}
            expected_return: Type = Type{kind: TypeKind.Int, bits: 64, signed: true}
            return function.parameters.count == 1 and same_type(function.parameters[0].type, expected_arguments) and same_type(function.return_type, expected_return)


        # The launcher ABI is intentionally narrow: one text-array argument and
        # an i64 exit status. Effects and Elisa error rows remain unconstrained so
        # scripts can use the complete standard library without an adapter-specific
        # wrapper.
    public:
        def validate_elisascript_entrypoint(module: Module&) -> void error[ElisascriptEntrypointError]:
            cursor: mutable ElisascriptEntrypointCursor = ElisascriptEntrypointCursor{state: ElisascriptEntrypointState.Search, index: 0, found: false}
            machine over cursor.state:
                state Validate
                start Validate

                Validate, ElisascriptEntrypointState.Search if cursor.index >= module.functions.count and not cursor.found:
                    raise ElisascriptEntrypointError.MissingMain
                    break

                Validate, ElisascriptEntrypointState.Search if cursor.index >= module.functions.count:
                    cursor.state <- ElisascriptEntrypointState.Done
                    -> Validate

                Validate, ElisascriptEntrypointState.Search if module.functions[cursor.index].name != "main":
                    cursor.index <- cursor.index + 1
                    -> Validate

                Validate, ElisascriptEntrypointState.Search:
                    cursor.found <- true
                    cursor.state <- ElisascriptEntrypointState.Validate
                    -> Validate

                Validate, ElisascriptEntrypointState.Validate if not elisascript_main_signature_valid(module.functions[cursor.index]):
                    raise ElisascriptEntrypointError.InvalidMainSignature
                    break

                Validate, ElisascriptEntrypointState.Validate:
                    cursor.state <- ElisascriptEntrypointState.Done
                    -> Validate

                Validate, ElisascriptEntrypointState.Done:
                    break


        # Canonical file-backed program pipeline for launchers that need a
        # phase-aware diagnostic instead of a generic propagated error. Every
        # stage remains the same typed source/IR/bytecode path as the ordinary
        # entrypoint; only the final host-facing error representation changes.
        def execute_elisascript_program_file_diagnostic(filename: u8&, arguments: darray[sview]&, result: mutable ElisascriptProgramDiagnostic&) -> void can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            result.failed <- false
            result.phase <- ""
            result.detail <- ""
            result.source_error_known <- false
            result.entrypoint_error_known <- false
            result.runtime_error_known <- false
            region script_program_file_diagnostic(1048576):
                module: mutable Module = Module{name: "", functions: []}
                catch lower_elisascript_file(filename, "elisascript-program"):
                    ok loaded:
                        module <- loaded
                    error failure:
                        result.source_error_known <- true
                        result.source_error <- failure
                        return elisascript_program_diagnostic_failure(result, "source", "unable to load, parse, type-check, lower, or verify program")
                catch validate_elisascript_entrypoint(module):
                    ok:
                        pass
                    error failure:
                        result.entrypoint_error_known <- true
                        result.entrypoint_error <- failure
                        return elisascript_program_diagnostic_failure(result, "entrypoint", "main must have signature main(arguments: darray[sview]) -> i64")
                lowered: BytecodeLowerResult = lower_bytecode(module)
                if lowered.issues.count != 0:
                    return elisascript_program_diagnostic_failure(result, "bytecode", "verified bytecode lowering rejected the program")
                observations: mutable darray[Observation] = []
                storage: mutable darray[RuntimeValue] = []
                if not elisascript_runtime_arguments_fit(storage.count, arguments.count) or not elisascript_runtime_argument_bytes_fit(arguments):
                    result.runtime_error_known <- true
                    result.runtime_error <- InterpretError.ArgumentMismatch
                    return elisascript_program_diagnostic_failure(result, "runtime", "program arguments exceed the runtime aggregate limit")
                argument_start: u32 = storage.count.u32()
                for argument in arguments |storage|:
                    storage.push(runtime_text(argument))
                runtime_arguments: darray[RuntimeValue] = [runtime_array(argument_start, arguments.count.u32())]
                catch execute_bytecode(lowered.module, "main", runtime_arguments, observations, storage):
                    ok execution:
                        result.execution <- execution
                    error failure:
                        result.runtime_error_known <- true
                        result.runtime_error <- failure
                        return elisascript_program_diagnostic_failure(result, "runtime", "program execution failed")


        # Compile and execute a standard program from source text with
        # caller-supplied dynamic handlers. The caller's storage receives the
        # argv text values, allowing the entry function to inspect them with
        # ordinary checked array operations.
        def execute_elisascript_program_source_with_handlers(filename: u8&, source: u8&, module_name: sview, arguments: darray[sview]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handlers: darray[Handler]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, ElisascriptEntrypointError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            region script_program_source(1048576):
                module: Module = try lower_elisascript_source_with_handlers(filename, source, module_name, handlers)
                try validate_elisascript_entrypoint(module)
                raise InterpretError.ArgumentMismatch if not elisascript_runtime_arguments_fit(storage.count, arguments.count) or not elisascript_runtime_argument_bytes_fit(arguments)
                argument_start: u32 = storage.count.u32()
                for argument in arguments |storage|:
                    storage.push(runtime_text(argument))
                runtime_arguments: darray[RuntimeValue] = [runtime_array(argument_start, arguments.count.u32())]
                lowered: BytecodeLowerResult = lower_bytecode(module)
                raise InterpretError.VerificationFailed if lowered.issues.count != 0
                return execute_bytecode(lowered.module, "main", runtime_arguments, observations, storage, step_limit)


        # Length-delimited counterpart for hosts that own source bytes rather
        # than a terminated C string. The source loader rejects embedded NULs
        # before this runner can construct a module.
        def execute_elisascript_program_source_bytes_with_handlers(filename: u8&, source: u8&, source_length: usize, module_name: sview, arguments: darray[sview]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handlers: darray[Handler]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, ElisascriptEntrypointError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            region script_program_source_bytes(1048576):
                module: Module = try lower_elisascript_source_bytes_with_handlers(filename, source, source_length, module_name, handlers)
                try validate_elisascript_entrypoint(module)
                raise InterpretError.ArgumentMismatch if not elisascript_runtime_arguments_fit(storage.count, arguments.count) or not elisascript_runtime_argument_bytes_fit(arguments)
                argument_start: u32 = storage.count.u32()
                for argument in arguments |storage|:
                    storage.push(runtime_text(argument))
                runtime_arguments: darray[RuntimeValue] = [runtime_array(argument_start, arguments.count.u32())]
                lowered: BytecodeLowerResult = lower_bytecode(module)
                raise InterpretError.VerificationFailed if lowered.issues.count != 0
                return execute_bytecode(lowered.module, "main", runtime_arguments, observations, storage, step_limit)


        def execute_elisascript_program_source_bytes(filename: u8&, source: u8&, source_length: usize, module_name: sview, arguments: darray[sview]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, ElisascriptEntrypointError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            handlers: darray[Handler] = []
            return execute_elisascript_program_source_bytes_with_handlers(filename, source, source_length, module_name, arguments, observations, storage, handlers, step_limit)


        # Standard program execution without dynamic handlers remains the
        # compact default used by the launcher.
        def execute_elisascript_program_source(filename: u8&, source: u8&, module_name: sview, arguments: darray[sview]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, ElisascriptEntrypointError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            handlers: darray[Handler] = []
            return execute_elisascript_program_source_with_handlers(filename, source, module_name, arguments, observations, storage, handlers, step_limit)


        # File-backed standard program entry point. This is the ABI the bundled
        # `.elisascript` command-line driver calls without knowing internal IR
        # function names or constructing runtime values itself.
        def execute_elisascript_program_file_with_handlers(filename: u8&, arguments: darray[sview]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handlers: darray[Handler]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, ElisascriptEntrypointError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            region script_program_file(1048576):
                module: Module = try lower_elisascript_file_with_handlers(filename, "elisascript-program", handlers)
                try validate_elisascript_entrypoint(module)
                raise InterpretError.ArgumentMismatch if not elisascript_runtime_arguments_fit(storage.count, arguments.count) or not elisascript_runtime_argument_bytes_fit(arguments)
                argument_start: u32 = storage.count.u32()
                for argument in arguments |storage|:
                    storage.push(runtime_text(argument))
                runtime_arguments: darray[RuntimeValue] = [runtime_array(argument_start, arguments.count.u32())]
                lowered: BytecodeLowerResult = lower_bytecode(module)
                raise InterpretError.VerificationFailed if lowered.issues.count != 0
                return execute_bytecode(lowered.module, "main", runtime_arguments, observations, storage, step_limit)


        def execute_elisascript_program_file(filename: u8&, arguments: darray[sview]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, ElisascriptEntrypointError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            handlers: darray[Handler] = []
            return execute_elisascript_program_file_with_handlers(filename, arguments, observations, storage, handlers, step_limit)


        # Compile and execute source text through the canonical bytecode path.
        # Source and runtime failures remain their original Elisa error families;
        # callers can therefore distinguish malformed programs from execution
        # failures without a result-shaped sentinel.
        def execute_elisascript_source_with_handlers(filename: u8&, source: u8&, module_name: sview, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handlers: darray[Handler]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            region script_source_execution(1048576):
                module: Module = try lower_elisascript_source_with_handlers(filename, source, module_name, handlers)
                lowered: BytecodeLowerResult = lower_bytecode(module)
                raise InterpretError.VerificationFailed if lowered.issues.count != 0
                return execute_bytecode(lowered.module, entry, arguments, observations, storage, step_limit)


        # Length-delimited entry-point execution preserves the same typed
        # handlers, storage, and error families as the C-string source API.
        def execute_elisascript_source_bytes_with_handlers(filename: u8&, source: u8&, source_length: usize, module_name: sview, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handlers: darray[Handler]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            region script_source_bytes_execution(1048576):
                module: Module = try lower_elisascript_source_bytes_with_handlers(filename, source, source_length, module_name, handlers)
                lowered: BytecodeLowerResult = lower_bytecode(module)
                raise InterpretError.VerificationFailed if lowered.issues.count != 0
                return execute_bytecode(lowered.module, entry, arguments, observations, storage, step_limit)


        def execute_elisascript_source_bytes(filename: u8&, source: u8&, source_length: usize, module_name: sview, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            handlers: darray[Handler] = []
            return execute_elisascript_source_bytes_with_handlers(filename, source, source_length, module_name, entry, arguments, observations, storage, handlers, step_limit)


        def execute_elisascript_source(filename: u8&, source: u8&, module_name: sview, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            handlers: darray[Handler] = []
            return execute_elisascript_source_with_handlers(filename, source, module_name, entry, arguments, observations, storage, handlers, step_limit)


        # File-backed counterpart used by script launchers. The source loader
        # owns the file bytes and source-span filename, so the returned execution
        # is independent of the caller's temporary buffers.
        def execute_elisascript_file_with_handlers(filename: u8&, module_name: sview, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, handlers: darray[Handler]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            region script_file_execution(1048576):
                module: Module = try lower_elisascript_file_with_handlers(filename, module_name, handlers)
                lowered: BytecodeLowerResult = lower_bytecode(module)
                raise InterpretError.VerificationFailed if lowered.issues.count != 0
                return execute_bytecode(lowered.module, entry, arguments, observations, storage, step_limit)


        def execute_elisascript_file(filename: u8&, module_name: sview, entry: sview, arguments: darray[RuntimeValue]&, observations: mutable darray[Observation]&, storage: mutable darray[RuntimeValue]&, step_limit: u64 = 1000000) -> Execution error[ElisascriptSourceError, InterpretError] can[Memory.Allocate, Abort.Panic, Blocking.IO, Console.Format, Console.Write, Memory.Release, Unsafe.PointerCast]:
            handlers: darray[Handler] = []
            return execute_elisascript_file_with_handlers(filename, module_name, entry, arguments, observations, storage, handlers, step_limit)
