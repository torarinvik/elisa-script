# Canonical source boundary for `.elisascript` files.
#
# Callers should use this entry point when source text comes from a file or an
# adapter. It keeps extension validation, parser diagnostics, lowering coverage,
# and target-independent IR verification in one deterministic pipeline. Every
# failure remains an Elisa error rather than a result-shaped sentinel.

using Ast
using Lexer
using EsEncoding

include "../../vendor/elisa-compiler/src/semantic/semantic.elisa"


error ElisascriptSourceError:
    InvalidExtension
    EmbeddedNul
    InvalidUtf8
    SourceTooLarge
    FileIo
    ParseFailed
    SemanticFailed
    LowerFailed
    VerificationFailed


def elisascript_source_bytes_have_nul(source: u8&, length: usize) -> bool:
    for index in 0..<length |source|:
        true return if source[index] == 0
    return false


extend EsIr:
    public:
        const module SourceLimits:
            # Keep the parser arena bounded before any C-string scan or region
            # allocation. The arena's historical 64x sizing remains available for
            # ordinary scripts, but a hostile input cannot request an unbounded
            # multiply or consume the host while diagnostics are being built.
            SOURCE_BYTES: usize = 4194304
            # Filenames cross the same C-string ABI as source buffers. Keep their
            # validation bounded independently so an unterminated host pointer
            # cannot make extension checking scan arbitrary memory.
            FILENAME_BYTES: usize = 4096
            # Diagnostic payloads are copied into permanent storage only through a
            # bounded adapter. This preserves actionable names/types without letting
            # a hostile source token turn one failed load into an unbounded retention.
            DIAGNOSTIC_TEXT_BYTES: usize = 4096
            # Keep one source-line excerpt plus its caret independently bounded.
            # The coordinates remain authoritative when a long or multi-line span
            # cannot fit in this human-readable rendering.
            DIAGNOSTIC_EXCERPT_LINE_BYTES: usize = 1024
            DIAGNOSTIC_EXCERPT_CARET_BYTES: usize = 1024

        # A lowering diagnostic retains only region-independent facts. LowerIssue's
        # function/message views belong to the parser arena and must never escape it;
        # this summary is safe for launcher records.
        struct ElisascriptLowerIssueSummary:
            known: mutable bool = false
            kind: mutable LowerIssueKind = LowerIssueKind.TypeMismatch
            line: mutable u32 = 0

        # Parser and semantic findings are copied into primitive coordinates before the
        # parser region is released. The original `context`, `name`, and expected/actual
        # views remain region-owned and deliberately do not cross this boundary.
        struct ElisascriptSourceDiagnosticSummary:
            parse_known: mutable bool = false
            parse_kind: mutable Ast::ParseErrorKind = Ast::ParseErrorKind.ExpectedToken
            semantic_known: mutable bool = false
            semantic_kind: mutable Semantic::DiagnosticKind = Semantic::DiagnosticKind.UndefinedName
            line: mutable u32 = 0
            column: mutable u32 = 0
            end_line: mutable u32 = 0
            end_column: mutable u32 = 0
            payload_hash: mutable u64 = 0
            payload_context: mutable dstr = []
            payload_name: mutable dstr = []
            payload_expected: mutable dstr = []
            payload_actual: mutable dstr = []
            payload_detail: mutable dstr = []
            payload_detail2: mutable dstr = []
            payload_detail3: mutable dstr = []
            payload_excerpt: mutable dstr = []
            payload_expected_count: mutable u32 = 0
            payload_actual_count: mutable u32 = 0
            payload_truncated: mutable bool = false

    private:
        def elisascript_source_reset_diagnostic(summary: mutable ElisascriptSourceDiagnosticSummary&) -> void:
            summary.parse_known <- false
            summary.parse_kind <- Ast::ParseErrorKind.ExpectedToken
            summary.semantic_known <- false
            summary.semantic_kind <- Semantic::DiagnosticKind.UndefinedName
            summary.line <- 0
            summary.column <- 0
            summary.end_line <- 0
            summary.end_column <- 0
            summary.payload_hash <- 0
            summary.payload_context <- []
            summary.payload_name <- []
            summary.payload_expected <- []
            summary.payload_actual <- []
            summary.payload_detail <- []
            summary.payload_detail2 <- []
            summary.payload_detail3 <- []
            summary.payload_excerpt <- []
            summary.payload_expected_count <- 0
            summary.payload_actual_count <- 0
            summary.payload_truncated <- false


        def elisascript_source_copy_diagnostic_text(value: sview, destination: mutable dstr&, truncated: mutable bool&) -> void can[Memory.Allocate, Abort.Panic]:
            destination <- []
            length: usize = sview_len(value)
            if length > SourceLimits::DIAGNOSTIC_TEXT_BYTES:
                truncated <- true
                return
            return if length == 0
            destination <- ctx_fstr_alloc(length)
            if destination.items == null:
                truncated <- true
                return
            ctx_fstr_append(destination, value.data, length)


        def elisascript_source_line_bounds(source: u8&, source_length: usize, line: u32, start: mutable usize&, end: mutable usize&) -> bool:
            return false if line == 0
            target: usize = line.usize()
            current: mutable usize = 1
            index: mutable usize = 0
            line_start: mutable usize = 0
            while index < source_length and current < target:
                if source[index] == 10:
                    current <- current + 1
                    line_start <- index + 1
                index <- index + 1
            return false if current != target
            line_end: mutable usize = line_start
            while line_end < source_length and source[line_end] != 10:
                line_end <- line_end + 1
            start <- line_start
            end <- line_end
            return true


        def elisascript_source_capture_excerpt(source: u8&, source_length: usize, line: u32, column: u32, end_line: u32, end_column: u32, summary: mutable ElisascriptSourceDiagnosticSummary&) -> void can[Memory.Allocate, Abort.Panic]:
            return if line == 0 or column == 0
            line_start: mutable usize = 0
            line_end: mutable usize = 0
            return if not elisascript_source_line_bounds(source, source_length, line, line_start, line_end)

            line_length: mutable usize = line_end - line_start
            line_limit: usize = SourceLimits::DIAGNOSTIC_EXCERPT_LINE_BYTES
            if line_length > line_limit:
                line_length <- line_limit
                summary.payload_truncated <- true
            caret_offset: mutable usize = column.usize() - 1
            caret_limit: usize = SourceLimits::DIAGNOSTIC_EXCERPT_CARET_BYTES - 1
            if caret_offset > caret_limit:
                caret_offset <- caret_limit
                summary.payload_truncated <- true
            caret_length: mutable usize = 1
            if end_line == line and end_column > column:
                caret_length <- (end_column - column).usize()
            caret_length <- 1 if caret_length == 0
            if caret_length > SourceLimits::DIAGNOSTIC_EXCERPT_CARET_BYTES:
                caret_length <- SourceLimits::DIAGNOSTIC_EXCERPT_CARET_BYTES
                summary.payload_truncated <- true
            summary.payload_truncated <- true if end_line != 0 and end_line != line

            excerpt: mutable dstr = ctx_fstr_alloc(SourceLimits::DIAGNOSTIC_TEXT_BYTES)
            if excerpt.items == null:
                summary.payload_truncated <- true
                return
            ctx_fstr_append(excerpt, source + line_start, line_length)
            ctx_fstr_append(excerpt, "\n", 1)
            padding: mutable usize = 0
            while padding < caret_offset:
                ctx_fstr_append(excerpt, " ", 1)
                padding <- padding + 1
            caret: mutable usize = 0
            while caret < caret_length:
                ctx_fstr_append(excerpt, "^", 1)
                caret <- caret + 1
            summary.payload_excerpt <- excerpt


        def elisascript_source_capture_parse_diagnostic(file: Ast::File&, source: u8&, source_length: usize, summary: mutable ElisascriptSourceDiagnosticSummary&) -> void:
            return if file.errors.count == 0
            parse_error: Ast::ParseError = file.errors[0]
            summary.parse_known <- true
            summary.parse_kind <- parse_error.kind
            summary.line <- parse_error.line
            summary.column <- parse_error.column
            summary.end_line <- parse_error.end_line
            summary.end_column <- parse_error.end_column
            summary.payload_hash <- ctx_hash_sview(parse_error.context)
            elisascript_source_copy_diagnostic_text(parse_error.context, summary.payload_context, summary.payload_truncated)
            elisascript_source_capture_excerpt(source, source_length, summary.line, summary.column, summary.end_line, summary.end_column, summary)


        def elisascript_source_capture_semantic_diagnostic(table: Semantic::SymbolTable&, source: u8&, source_length: usize, summary: mutable ElisascriptSourceDiagnosticSummary&) -> bool:
            for diagnostic in table.diagnostics:
                continue if Semantic::diagnostic_severity(diagnostic) != 1 or diagnostic.kind == Semantic::DiagnosticKind.NegativeIndex
                summary.semantic_known <- true
                summary.semantic_kind <- diagnostic.kind
                summary.line <- diagnostic.line
                summary.column <- diagnostic.pos.column
                summary.end_line <- diagnostic.pos.end_line
                summary.end_column <- diagnostic.pos.end_column
                payload_hash: mutable u64 = ctx_hash_sview(diagnostic.name)
                payload_hash <- payload_hash * 0x100000001b3 + ctx_hash_sview(diagnostic.expected)
                payload_hash <- payload_hash * 0x100000001b3 + ctx_hash_sview(diagnostic.actual)
                payload_hash <- payload_hash * 0x100000001b3 + ctx_hash_sview(diagnostic.detail)
                summary.payload_hash <- payload_hash
                elisascript_source_copy_diagnostic_text(diagnostic.name, summary.payload_name, summary.payload_truncated)
                elisascript_source_copy_diagnostic_text(diagnostic.expected, summary.payload_expected, summary.payload_truncated)
                elisascript_source_copy_diagnostic_text(diagnostic.actual, summary.payload_actual, summary.payload_truncated)
                elisascript_source_copy_diagnostic_text(diagnostic.detail, summary.payload_detail, summary.payload_truncated)
                elisascript_source_copy_diagnostic_text(diagnostic.detail2, summary.payload_detail2, summary.payload_truncated)
                elisascript_source_copy_diagnostic_text(diagnostic.detail3, summary.payload_detail3, summary.payload_truncated)
                summary.payload_expected_count <- diagnostic.expected_count
                summary.payload_actual_count <- diagnostic.actual_count
                elisascript_source_capture_excerpt(source, source_length, summary.line, summary.column, summary.end_line, summary.end_column, summary)
                return true
            return false


        def elisascript_source_cstring_length_bounded(source: u8&, too_large: mutable bool&) -> usize:
            too_large <- false
            length: mutable usize = 0
            # Permit a terminator exactly at the content-size boundary, but
            # never probe one byte beyond that bounded terminator position.
            while length <= SourceLimits::SOURCE_BYTES:
                return length if source[length] == 0
                length <- length + 1
            too_large <- true
            return length

        def elisascript_source_filename_length_bounded(filename: u8&, too_large: mutable bool&) -> usize:
            too_large <- false
            length: mutable usize = 0
            while length < SourceLimits::FILENAME_BYTES - 1:
                return length if filename[length] == 0
                length <- length + 1
            return length if filename[length] == 0
            too_large <- true
            return length

        const enum ElisascriptSourceExtensionState of u8:
            ValidateExtension
            Done


        struct ElisascriptSourceCursor:
            state: mutable ElisascriptSourceExtensionState
            valid: mutable bool


    public:
        # The extension check is deliberately a small state machine. Keeping it
        # separate makes the source loader's first refusal deterministic and
        # prevents a path with a similar prefix from being accepted.
        def elisascript_source_filename_valid(filename: u8&) -> bool:
            cursor: mutable ElisascriptSourceCursor = ElisascriptSourceCursor{state: ElisascriptSourceExtensionState.ValidateExtension, valid: true}
            too_large: mutable bool = false
            filename_length: usize = elisascript_source_filename_length_bounded(filename, too_large)
            # Never pass an unterminated/overlong host pointer to `sview(...)`.
            # The runtime constructor derives its bound with `strlen`, which
            # would undo this helper's bounded scan and walk arbitrary memory.
            return false if too_large
            name: sview = filename[0:filename_length]
            machine over cursor.state:
                state Validate
                start Validate

                Validate, ElisascriptSourceExtensionState.ValidateExtension if not sview_ends_with(name, ".elisascript"):
                    cursor.valid <- false
                    cursor.state <- ElisascriptSourceExtensionState.Done
                    -> Validate

                Validate, ElisascriptSourceExtensionState.ValidateExtension:
                    cursor.state <- ElisascriptSourceExtensionState.Done
                    -> Validate

                Validate, ElisascriptSourceExtensionState.Done:
                    break

            return cursor.valid


        def elisascript_source_validate_extension(filename: u8&) -> void error[ElisascriptSourceError]:
            raise ElisascriptSourceError.InvalidExtension if not elisascript_source_filename_valid(filename)


        # Public bounded length for file adapters that must retain the filename
        # in permanent source-span storage. The helper deliberately reports the
        # same typed extension error as validation instead of exposing the
        # private scanner or falling back to an unbounded C-string walk.
        def elisascript_source_filename_length(filename: u8&) -> usize error[ElisascriptSourceError]:
            too_large: mutable bool = false
            length: usize = elisascript_source_filename_length_bounded(filename, too_large)
            raise ElisascriptSourceError.InvalidExtension if too_large
            return length


    private:
    public:
        # One typed source-to-IR boundary with caller-supplied dynamic handlers.
        # Host descriptors are copied into the resulting module; source callback
        # decorators are derived by the lowerer into a private extension of that set.
        # The test catalog is returned separately because it is source-region
        # metadata, not part of the serialized Module identity.
        def lower_elisascript_source_buffer_with_handlers_diagnostic_and_tests(filename: u8&, source: u8&, module_name: sview, handlers: darray[Handler]&, source_diagnostic: mutable ElisascriptSourceDiagnosticSummary&, lower_issue: mutable ElisascriptLowerIssueSummary&, test_functions: mutable darray[ElisascriptTestFunction]&) -> Module error[ElisascriptSourceError] can[Memory.Allocate, Abort.Panic]:
            elisascript_source_reset_diagnostic(source_diagnostic)
            lower_issue.known <- false
            lower_issue.kind <- LowerIssueKind.TypeMismatch
            lower_issue.line <- 0
            test_functions.truncate(0)
            try elisascript_source_validate_extension(filename)
            too_large: mutable bool = false
            source_length: usize = elisascript_source_cstring_length_bounded(source, too_large)
            raise ElisascriptSourceError.SourceTooLarge if too_large
            source_cursor: mutable EsEncoding::Utf8Cursor = EsEncoding::Utf8Cursor{}
            raise ElisascriptSourceError.InvalidUtf8 if not EsEncoding::utf8_validate(source, source_length, source_cursor) or not EsEncoding::utf8_complete(source_cursor)
            # Keep the returned IR in the caller's region, alive through execution.
            tokens: darray[Token] = frontend_tokenize(filename, source)
            file: Ast::File = frontend_parser_parse_file(source, tokens)
            if file.errors.count != 0:
                elisascript_source_capture_parse_diagnostic(file, source, source_length, source_diagnostic)
                raise ElisascriptSourceError.ParseFailed
            semantic: Semantic::SymbolTable = Semantic::check(file)
            if elisascript_source_capture_semantic_diagnostic(semantic, source, source_length, source_diagnostic):
                raise ElisascriptSourceError.SemanticFailed
            lowered: LowerResult = lower_file_with_handlers(file, module_name, handlers)
            if lowered.issues.count != 0:
                lower_issue.known <- true
                lower_issue.kind <- lowered.issues[0].kind
                lower_issue.line <- lowered.issues[0].line
                raise ElisascriptSourceError.LowerFailed
            raise ElisascriptSourceError.VerificationFailed if verify(lowered.module).count != 0
            test_functions.extend(lowered.test_functions)
            return lowered.module


        # Compatibility wrapper retaining the original compact diagnostic API.
        def lower_elisascript_source_buffer_with_handlers_diagnostic(filename: u8&, source: u8&, module_name: sview, handlers: darray[Handler]&, source_diagnostic: mutable ElisascriptSourceDiagnosticSummary&, lower_issue: mutable ElisascriptLowerIssueSummary&) -> Module error[ElisascriptSourceError] can[Memory.Allocate, Abort.Panic]:
            test_functions: mutable darray[ElisascriptTestFunction] = []
            return lower_elisascript_source_buffer_with_handlers_diagnostic_and_tests(filename, source, module_name, handlers, source_diagnostic, lower_issue, test_functions)


        # Source-buffer callers that need `--test` discovery receive the catalog
        # through caller-owned storage while retaining the existing Module API.
        def lower_elisascript_source_buffer_with_handlers_tests(filename: u8&, source: u8&, module_name: sview, handlers: darray[Handler]&, test_functions: mutable darray[ElisascriptTestFunction]&) -> Module error[ElisascriptSourceError] can[Memory.Allocate, Abort.Panic]:
            source_diagnostic: mutable ElisascriptSourceDiagnosticSummary = ElisascriptSourceDiagnosticSummary{}
            lower_issue: mutable ElisascriptLowerIssueSummary = ElisascriptLowerIssueSummary{}
            return lower_elisascript_source_buffer_with_handlers_diagnostic_and_tests(filename, source, module_name, handlers, source_diagnostic, lower_issue, test_functions)


        # Ordinary callers keep the compact source API; diagnostic callers opt
        # into the bounded primitive summary without changing the typed error row.
        def lower_elisascript_source_buffer_with_handlers(filename: u8&, source: u8&, module_name: sview, handlers: darray[Handler]&) -> Module error[ElisascriptSourceError] can[Memory.Allocate, Abort.Panic]:
            source_diagnostic: mutable ElisascriptSourceDiagnosticSummary = ElisascriptSourceDiagnosticSummary{}
            lower_issue: mutable ElisascriptLowerIssueSummary = ElisascriptLowerIssueSummary{}
            return lower_elisascript_source_buffer_with_handlers_diagnostic(filename, source, module_name, handlers, source_diagnostic, lower_issue)


        # Length-delimited source loading is the binary-safe boundary for hosts
        # that already own a byte span. It rejects embedded NULs before making a
        # terminated parser buffer, so no source suffix can disappear through a
        # C-string compatibility call.
        def lower_elisascript_source_bytes_with_handlers(filename: u8&, source: u8&, source_length: usize, module_name: sview, handlers: darray[Handler]&) -> Module error[ElisascriptSourceError] can[Memory.Allocate, Abort.Panic]:
            test_functions: mutable darray[ElisascriptTestFunction] = []
            return lower_elisascript_source_bytes_with_handlers_tests(filename, source, source_length, module_name, handlers, test_functions)


        # Length-delimited counterpart that also returns the test catalog. The
        # bytes are copied into the loader context's permanent source region;
        # metadata views therefore remain valid for the same lifetime as the
        # returned Module/context, not merely the caller's input span.
        def lower_elisascript_source_bytes_with_handlers_tests(filename: u8&, source: u8&, source_length: usize, module_name: sview, handlers: darray[Handler]&, test_functions: mutable darray[ElisascriptTestFunction]&) -> Module error[ElisascriptSourceError] can[Memory.Allocate, Abort.Panic]:
            try elisascript_source_validate_extension(filename)
            raise ElisascriptSourceError.SourceTooLarge if source_length > SourceLimits::SOURCE_BYTES
            raise ElisascriptSourceError.EmbeddedNul if elisascript_source_bytes_have_nul(source, source_length)
            source_cursor: mutable EsEncoding::Utf8Cursor = EsEncoding::Utf8Cursor{}
            raise ElisascriptSourceError.InvalidUtf8 if not EsEncoding::utf8_validate(source, source_length, source_cursor) or not EsEncoding::utf8_complete(source_cursor)
            buffer: mutable dstr = ctx_fstr_alloc(source_length + 1)
            if buffer.items == null:
                raise ElisascriptSourceError.LowerFailed
            ctx_fstr_append(buffer, source, source_length)
            ctx_fstr_append(buffer, "\0", 1)
            buffer_items: mutable u8& = buffer.items
            return lower_elisascript_source_buffer_with_handlers_tests(filename, buffer_items, module_name, handlers, test_functions)


        def lower_elisascript_source_with_handlers(filename: u8&, source: u8&, module_name: sview, handlers: darray[Handler]&) -> Module error[ElisascriptSourceError] can[Memory.Allocate, Abort.Panic]:
            return lower_elisascript_source_buffer_with_handlers(filename, source, module_name, handlers)


        def lower_elisascript_source_with_handlers_tests(filename: u8&, source: u8&, module_name: sview, handlers: darray[Handler]&, test_functions: mutable darray[ElisascriptTestFunction]&) -> Module error[ElisascriptSourceError] can[Memory.Allocate, Abort.Panic]:
            return lower_elisascript_source_buffer_with_handlers_tests(filename, source, module_name, handlers, test_functions)


        def lower_elisascript_source_bytes(filename: u8&, source: u8&, source_length: usize, module_name: sview) -> Module error[ElisascriptSourceError] can[Memory.Allocate, Abort.Panic]:
            handlers: darray[Handler] = []
            return lower_elisascript_source_bytes_with_handlers(filename, source, source_length, module_name, handlers)


        def lower_elisascript_source_bytes_tests(filename: u8&, source: u8&, source_length: usize, module_name: sview, test_functions: mutable darray[ElisascriptTestFunction]&) -> Module error[ElisascriptSourceError] can[Memory.Allocate, Abort.Panic]:
            handlers: darray[Handler] = []
            return lower_elisascript_source_bytes_with_handlers_tests(filename, source, source_length, module_name, handlers, test_functions)


        # Source loading without dynamic handlers remains the compact default.
        def lower_elisascript_source(filename: u8&, source: u8&, module_name: sview) -> Module error[ElisascriptSourceError] can[Memory.Allocate, Abort.Panic]:
            handlers: darray[Handler] = []
            return lower_elisascript_source_with_handlers(filename, source, module_name, handlers)
