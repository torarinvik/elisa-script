# Elisascript command-line driver.
#
# The host ABI is intentionally tiny (`main(argc, argv)`). Everything after
# that boundary is typed: argv becomes darray[sview], the request parser checks
# the source contract. The driver enters the same typed source, verifier,
# bytecode, and execution boundaries explicitly so each failure can retain its
# phase and source path instead of being converted into a generic sentinel.

include "../ir/ir.elisa"

using EsIr


module EsDriver:
    private:
        const ES_DRIVER_MAX_ARGC: i64 = 1048578

        def write_stderr(message: sview) -> void can[Console.Write, Unsafe.PointerCast]:
            return if sview_is_empty(message)
            _ = runtime_write(FileDescriptor.Error, message.data.cast[void&], sview_len(message)) can Console.Write


        def host_argument_view(pointer: cstr, limit: usize, too_large: mutable bool) -> sview:
            too_large <- false
            bytes: u8& = pointer.cast[u8&]
            length: mutable usize = 0
            while length < limit:
                return sview(bytes, 0, length.i64()) if bytes[length] == 0
                length <- length + 1
            too_large <- true
            return ""


        def collect_arguments(argc: i64, slots: mutable cstr&&, valid: mutable bool&) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            valid <- true
            arguments: mutable darray[sview] = []
            index: mutable i64 = 1
            while index < argc |index, slots, arguments|:
                too_large: mutable bool = false
                argument: sview = host_argument_view(slots[index.usize()], EsIr::ES_RUNTIME_DEFAULT_MAX_CSTRING_BYTES, too_large)
                if too_large:
                    valid <- false
                    return arguments
                arguments.push(argument)
                index <- index + 1
            return arguments


        def parse[@r](arguments: darray[sview]&, request: mutable ElisascriptCliRequest& @r) -> bool can[Memory.Allocate, Abort.Panic]:
            try parse_elisascript_cli(arguments, request) else return false
            return true


        def report_failure(source: sview, phase: sview, detail: sview) -> i64 can[Console.Write, Unsafe.PointerCast]:
            write_stderr("elisascript: ")
            write_stderr(source)
            write_stderr(": ")
            write_stderr(phase)
            write_stderr(": ")
            write_stderr(detail)
            write_stderr("\n")
            return 1

    public:
        def run(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Blocking.IO, Memory.Release]:
            if argc < 0 or argc > ES_DRIVER_MAX_ARGC:
                write_stderr("elisascript: argument vector exceeds the launcher limit\n")
                return 2
            slots: mutable cstr&& = argv.cast[mutable cstr&&]
            arguments_valid: mutable bool = true
            raw_arguments: darray[sview] = collect_arguments(argc, slots, arguments_valid)
            if not arguments_valid:
                write_stderr("elisascript: argument exceeds the host C-string limit\n")
                return 2
            request: mutable EsIr::ElisascriptCliRequest = EsIr::ElisascriptCliRequest{source: "", arguments: []}
            if not parse(raw_arguments, request):
                write_stderr("usage: elisascript <file.elisascript> [arguments...]\n")
                return 2

            source_length: usize = sview_len(request.source)
            if source_length >= EsIr::ES_RUNTIME_DEFAULT_MAX_CSTRING_BYTES:
                return report_failure(request.source, "source", "source path exceeds the host C-string limit")
            allocation_length: usize = source_length + 1
            allocation_i64: i64 = allocation_length.i64()
            if allocation_length == 0 or allocation_i64 < 0 or allocation_i64.usize() != allocation_length:
                write_stderr("elisascript: source path is too large\n")
                return 1
            path_bytes: mutable dstr = ctx_fstr_alloc(allocation_length)
            if path_bytes.items == null:
                write_stderr("elisascript: unable to allocate source path\n")
                return 1
            ctx_fstr_append(path_bytes, request.source.data, source_length)
            ctx_fstr_append(path_bytes, "\0", 1)
            path_items: mutable u8& = path_bytes.items

            diagnostic: EsIr::ElisascriptProgramDiagnostic = EsIr::ElisascriptProgramDiagnostic{}
            EsIr::execute_elisascript_program_file_diagnostic(path_items, request.arguments, diagnostic)
            if diagnostic.failed:
                return report_failure(request.source, diagnostic.phase, diagnostic.detail)
            execution: EsIr::Execution = diagnostic.execution
            if execution.value.kind == EsIr::RuntimeValueKind.Int:
                return execution.value.integer
            return report_failure(request.source, "entrypoint", "main returned a non-integer status")


def main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Blocking.IO, Memory.Release]:
    return EsDriver::run(argc, argv)
