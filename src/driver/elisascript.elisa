# Elisascript command-line driver.
#
# The host ABI is intentionally tiny (`main(argc, argv)`). Everything after
# that boundary is typed: argv becomes darray[sview], the request parser checks
# the source contract. The driver enters the same typed source, verifier,
# bytecode, and execution boundaries explicitly so each failure can retain its
# phase and source path instead of being converted into a generic sentinel.

include "../ir/execution.elisa"

using EsIr
using EsCli
using EsScriptTest
using EsOutput
using EsOutputTransport
using EsOutputTransportPosix
using EsRuntime


module EsDriver:
    private:
        const module WritePolicy:
            EINTR_RETRIES: usize = 8

        const enum HostArgumentFailure of u8:
            None
            HostCString
            SourceFilename
            ArgumentBytes

        def write_stderr(message: sview) -> void can[Console.Write, Unsafe.PointerCast]:
            return if sview_is_empty(message)
            offset: mutable usize = 0
            eintr_retries: mutable usize = 0
            length: usize = sview_len(message)
            while offset < length:
                remaining: usize = length - offset
                buffer: mutable u8& = &message.data[offset]
                amount: isize = runtime_write(FileDescriptor.Error, buffer.cast[void&], remaining) can Console.Write
                if amount < 0:
                    errno: mutable i32& = EsRuntime::elisascript_posix_errno()
                    return if errno[0] != EsRuntime::DarwinErrno::EINTR or eintr_retries >= WritePolicy::EINTR_RETRIES
                    eintr_retries <- eintr_retries + 1
                elif amount == 0 or amount.usize() > remaining:
                    return
                else:
                    offset <- offset + amount.usize()
                    eintr_retries <- 0


        def host_argument_view(pointer: cstr, limit: usize, too_large: mutable bool) -> sview:
            too_large <- false
            bytes: u8& = pointer.cast[u8&]
            length: mutable usize = 0
            while length <= limit:
                return sview(pointer, 0, length.i64()) if bytes[length] == 0
                length <- length + 1
            too_large <- true
            return ""


        def collect_arguments(argc: i64, slots: mutable cstr&&, valid: mutable bool&, failure: mutable HostArgumentFailure&) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            valid <- true
            failure <- HostArgumentFailure.None
            arguments: mutable darray[sview] = []
            index: mutable i64 = 1
            total_argument_bytes: mutable usize = 0
            while index < argc |index, slots, arguments, valid, total_argument_bytes|:
                too_large: mutable bool = false
                argument_limit: mutable usize = EsIr::ES_RUNTIME_DEFAULT_MAX_CSTRING_BYTES - 1
                if index == 1:
                    # The first post-executable slot is the source path. Keep
                    # its raw scan at the filename ceiling instead of walking
                    # a hostile borrowed path up to the general 64 MiB C-string
                    # budget before the typed parser can reject it.
                    argument_limit <- EsIr::SourceLimits::FILENAME_BYTES - 1
                if index > 1:
                    if total_argument_bytes > EsIr::LauncherLimits::ARGUMENT_BYTES:
                        valid <- false
                        return arguments
                    remaining: usize = EsIr::LauncherLimits::ARGUMENT_BYTES - total_argument_bytes
                    argument_limit <- remaining if remaining < argument_limit
                argument: sview = host_argument_view(slots[index.usize()], argument_limit, too_large)
                if too_large:
                    valid <- false
                    failure <- HostArgumentFailure.SourceFilename if index == 1 else HostArgumentFailure.HostCString
                    # A clamped scan proves that this argument crossed the
                    # remaining aggregate launcher budget, even when its
                    # complete host C-string might also be overlong. Keep the
                    # diagnostic tied to the first bounded contract that was
                    # conclusively violated instead of misreporting it as a
                    # per-string C-string failure.
                    failure <- HostArgumentFailure.ArgumentBytes if index > 1 and argument_limit < EsIr::ES_RUNTIME_DEFAULT_MAX_CSTRING_BYTES - 1
                    return arguments
                if index > 1:
                    argument_length: usize = sview_len(argument)
                    if argument_length > EsIr::LauncherLimits::ARGUMENT_BYTES - total_argument_bytes:
                        valid <- false
                        return arguments
                    total_argument_bytes <- total_argument_bytes + argument_length
                arguments.push(argument)
                index <- index + 1
            return arguments


        def parse[@r](arguments: darray[sview]&, request: mutable ElisascriptCliRequest& @r) -> bool can[Memory.Allocate, Abort.Panic]:
            invocation: CliInvocation = try parse_cli_arguments(arguments) else return false
            request.source <- invocation.source_path
            request.arguments <- invocation.script_arguments
            request.test_selection <- invocation.test_selection
            request.mode <- invocation.mode
            request.color <- invocation.color
            request.report_format <- invocation.report_format
            request.strict_engine <- invocation.strict_engine
            request.option_end_seen <- invocation.option_end_seen
            return true


        def report_failure(source: sview, phase: sview, detail: sview) -> i64 can[Console.Write, Unsafe.PointerCast]:
            write_stderr("elisascript: ")
            write_stderr(source)
            write_stderr(": ")
            write_stderr(phase)
            write_stderr(": ")
            write_stderr(detail)
            write_stderr("\n")
            return 1


        def write_decimal_u32(value: u32) -> void can[Memory.Allocate, Abort.Panic, Console.Write, Unsafe.PointerCast]:
            digits: mutable darray[u8] = []
            remaining: mutable u64 = value.u64()
            if remaining == 0:
                digits.push(48)
            else:
                while remaining > 0 |remaining, digits|:
                    digits.push((48 + (remaining % 10).u8()))
                    remaining <- remaining / 10
                reverse(digits)
            write_stderr(bytes_view(digits))


        def report_failure_with_span_context(source: sview, phase: sview, detail: sview, context: sview, excerpt: sview, line: u32, column: u32, end_line: u32, end_column: u32, payload_truncated: bool = false) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Unsafe.PointerCast]:
            write_stderr("elisascript: ")
            write_stderr(source)
            write_stderr(": ")
            write_stderr(phase)
            write_stderr(": ")
            write_stderr(detail)
            if not sview_is_empty(context):
                write_stderr(" (")
                write_stderr(context)
                write_stderr(")")
            if not sview_is_empty(excerpt):
                write_stderr("\n")
                write_stderr(excerpt)
            if line != 0:
                write_stderr(" at ")
                write_decimal_u32(line)
                if column != 0:
                    write_stderr(":")
                    write_decimal_u32(column)
                    if end_line != 0 and end_line != line:
                        write_stderr("-")
                        write_decimal_u32(end_line)
                        write_stderr(":")
                        write_decimal_u32(end_column)
                    elif end_column != 0:
                        write_stderr("-")
                        write_decimal_u32(end_column)
            write_stderr(" [diagnostic payload truncated]") if payload_truncated
            write_stderr("\n")
            return 1


        def report_failure_with_span(source: sview, phase: sview, detail: sview, excerpt: sview, line: u32, column: u32, end_line: u32, end_column: u32, payload_truncated: bool = false) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Unsafe.PointerCast]:
            return report_failure_with_span_context(source, phase, detail, "", excerpt, line, column, end_line, end_column, payload_truncated)


        # Keep the host-facing diagnostic stable without flattening the typed
        # error channel. The runner retains the original enum; the driver only
        # adds its variant spelling to the phase line for scripts and tools that
        # cannot inspect the programmatic error union directly.
        def source_error_detail(failure: ElisascriptSourceError) -> sview:
            return "InvalidExtension" if failure == ElisascriptSourceError.InvalidExtension
            return "EmbeddedNul" if failure == ElisascriptSourceError.EmbeddedNul
            return "InvalidUtf8" if failure == ElisascriptSourceError.InvalidUtf8
            return "SourceTooLarge" if failure == ElisascriptSourceError.SourceTooLarge
            return "FileIo" if failure == ElisascriptSourceError.FileIo
            return "ParseFailed" if failure == ElisascriptSourceError.ParseFailed
            return "SemanticFailed" if failure == ElisascriptSourceError.SemanticFailed
            return "LowerFailed" if failure == ElisascriptSourceError.LowerFailed
            return "VerificationFailed" if failure == ElisascriptSourceError.VerificationFailed
            return "UnknownSourceError"


        def parse_error_detail(kind: Ast::ParseErrorKind) -> sview:
            return "ExpectedToken" if kind == Ast::ParseErrorKind.ExpectedToken
            return "UnexpectedToken" if kind == Ast::ParseErrorKind.UnexpectedToken
            return "ExpectedDeclaration" if kind == Ast::ParseErrorKind.ExpectedDeclaration
            return "ExpectedExpression" if kind == Ast::ParseErrorKind.ExpectedExpression
            return "MismatchedWithBindings" if kind == Ast::ParseErrorKind.MismatchedWithBindings
            return "SubmitOutsidePool" if kind == Ast::ParseErrorKind.SubmitOutsidePool
            return "UnknownParseError"


        def report_program_failure(source: sview, diagnostic: ElisascriptProgramDiagnostic&) -> i64 can[Memory.Allocate, Abort.Panic, Console.Format, Console.Write, Unsafe.PointerCast]:
            detail: mutable sview = diagnostic.detail
            detail <- source_error_detail(diagnostic.source_error) if diagnostic.source_error_known
            if diagnostic.source_parse_diagnostic_known:
                detail <- parse_error_detail(diagnostic.source_parse_diagnostic_kind)
                return report_failure_with_span_context(source, diagnostic.phase, detail, bytes_view(diagnostic.source_diagnostic_payload_context), bytes_view(diagnostic.source_diagnostic_payload_excerpt), diagnostic.source_diagnostic_line, diagnostic.source_diagnostic_column, diagnostic.source_diagnostic_end_line, diagnostic.source_diagnostic_end_column, diagnostic.source_diagnostic_payload_truncated)
            if diagnostic.source_semantic_diagnostic_known:
                semantic_diagnostic: Semantic::Diagnostic = Semantic::Diagnostic{name: bytes_view(diagnostic.source_diagnostic_payload_name), line: diagnostic.source_diagnostic_line, kind: diagnostic.source_semantic_diagnostic_kind, expected: bytes_view(diagnostic.source_diagnostic_payload_expected), actual: bytes_view(diagnostic.source_diagnostic_payload_actual), expected_count: diagnostic.source_diagnostic_payload_expected_count, actual_count: diagnostic.source_diagnostic_payload_actual_count, detail: bytes_view(diagnostic.source_diagnostic_payload_detail), detail2: bytes_view(diagnostic.source_diagnostic_payload_detail2), detail3: bytes_view(diagnostic.source_diagnostic_payload_detail3)}
                message: darray[u8] = Semantic::diagnostic_message(semantic_diagnostic)
                return report_failure_with_span(source, diagnostic.phase, bytes_view(message), bytes_view(diagnostic.source_diagnostic_payload_excerpt), diagnostic.source_diagnostic_line, diagnostic.source_diagnostic_column, diagnostic.source_diagnostic_end_line, diagnostic.source_diagnostic_end_column, diagnostic.source_diagnostic_payload_truncated)
            detail <- lower_issue_detail(diagnostic.source_lower_issue_kind) if diagnostic.source_lower_issue_known
            if diagnostic.source_lower_issue_known:
                return report_failure_with_span(source, diagnostic.phase, detail, "", diagnostic.source_lower_issue_line, 0, 0, 0)
            detail <- entrypoint_error_detail(diagnostic.entrypoint_error) if diagnostic.entrypoint_error_known
            detail <- bytecode_issue_detail(diagnostic.bytecode_issue_kind) if diagnostic.bytecode_issue_known
            detail <- runtime_error_detail(diagnostic.runtime_error) if diagnostic.runtime_error_known
            return report_failure(source, diagnostic.phase, detail)


        def build_test_setup_failure_report(detail: sview, options: EsOutput::OutputOptions, report: mutable EsOutput::OutputDocument&) -> void error[EsOutput::OutputContractError] can[Memory.Allocate, Abort.Panic]:
            candidate: mutable EsOutput::OutputDocument = EsOutput::OutputDocument{options: options}
            try EsOutput::advance_output_document(candidate, EsOutput::OutputDocumentEvent.Begin, EsOutput::OutputRecord{name: "", status: EsOutput::OutputStatus.Pass})
            try EsOutput::advance_output_document(candidate, EsOutput::OutputDocumentEvent.Append, EsOutput::OutputRecord{name: "test setup", status: EsOutput::OutputStatus.Error, message: detail})
            try EsOutput::advance_output_document(candidate, EsOutput::OutputDocumentEvent.Seal, EsOutput::OutputRecord{name: "", status: EsOutput::OutputStatus.Pass})
            report <- candidate


        # Machine report modes must stay machine-readable even when loading or
        # test selection fails before an in-process test report exists.
        def report_test_setup_failure_machine(requested_format: EsCli::CliReportFormat, detail: sview) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Unsafe.PointerCast, Blocking.IO]:
            options: mutable EsOutput::OutputOptions = EsOutput::OutputOptions{color: EsOutput::OutputColorMode.Never}
            options.format <- EsOutput::OutputFormat.Json if requested_format == EsCli::CliReportFormat.Json
            options.format <- EsOutput::OutputFormat.Junit if requested_format == EsCli::CliReportFormat.Junit
            report: mutable EsOutput::OutputDocument = EsOutput::OutputDocument{}
            report_ready: bool =
                catch build_test_setup_failure_report(detail, options, report):
                    ok:
                        true
                    error failure:
                        _ = failure
                        false
            return 1 if not report_ready
            policy: EsOutputTransport::OutputTransportPolicy = EsOutputTransport::OutputTransportPolicy{color_enabled: false}
            catch EsOutputTransportPosix::write_output_document_fd(report, 1, policy):
                written_bytes:
                    _ = written_bytes
                    true
                error failure:
                    _ = failure
                    false
            return 1


        def lower_issue_detail(kind: EsIr::LowerIssueKind) -> sview:
            return "UnsupportedDeclaration" if kind == EsIr::LowerIssueKind.UnsupportedDeclaration
            return "UnsupportedStatement" if kind == EsIr::LowerIssueKind.UnsupportedStatement
            return "UnsupportedExpression" if kind == EsIr::LowerIssueKind.UnsupportedExpression
            return "UnknownBinding" if kind == EsIr::LowerIssueKind.UnknownBinding
            return "UnknownCallee" if kind == EsIr::LowerIssueKind.UnknownCallee
            return "UnknownType" if kind == EsIr::LowerIssueKind.UnknownType
            return "MissingReturn" if kind == EsIr::LowerIssueKind.MissingReturn
            return "LoopControlOutsideLoop" if kind == EsIr::LowerIssueKind.LoopControlOutsideLoop
            return "UnsupportedLoopLabel" if kind == EsIr::LowerIssueKind.UnsupportedLoopLabel
            return "UnsupportedAssignmentTarget" if kind == EsIr::LowerIssueKind.UnsupportedAssignmentTarget
            return "ImmutableBinding" if kind == EsIr::LowerIssueKind.ImmutableBinding
            return "MutableMergePending" if kind == EsIr::LowerIssueKind.MutableMergePending
            return "TypeMismatch" if kind == EsIr::LowerIssueKind.TypeMismatch
            return "MissingError" if kind == EsIr::LowerIssueKind.MissingError
            return "UnknownLoweringIssue"


        def entrypoint_error_detail(failure: ElisascriptEntrypointError) -> sview:
            return "MissingMain" if failure == ElisascriptEntrypointError.MissingMain
            return "InvalidMainSignature" if failure == ElisascriptEntrypointError.InvalidMainSignature
            return "UnknownEntrypointError"


        def bytecode_issue_detail(kind: EsIr::IssueKind) -> sview:
            return "InvalidTypeTable" if kind == EsIr::IssueKind.InvalidTypeTable
            return "MissingEntry" if kind == EsIr::IssueKind.MissingEntry
            return "DuplicateBlock" if kind == EsIr::IssueKind.DuplicateBlock
            return "UnknownTarget" if kind == EsIr::IssueKind.UnknownTarget
            return "DuplicateValue" if kind == EsIr::IssueKind.DuplicateValue
            return "UndefinedValue" if kind == EsIr::IssueKind.UndefinedValue
            return "NonDominatingValue" if kind == EsIr::IssueKind.NonDominatingValue
            return "EdgeArgumentArity" if kind == EsIr::IssueKind.EdgeArgumentArity
            return "EdgeArgumentType" if kind == EsIr::IssueKind.EdgeArgumentType
            return "MissingEffect" if kind == EsIr::IssueKind.MissingEffect
            return "MissingError" if kind == EsIr::IssueKind.MissingError
            return "MissingTraceSite" if kind == EsIr::IssueKind.MissingTraceSite
            return "DuplicateTraceSite" if kind == EsIr::IssueKind.DuplicateTraceSite
            return "InvalidPerform" if kind == EsIr::IssueKind.InvalidPerform
            return "InvalidObserve" if kind == EsIr::IssueKind.InvalidObserve
            return "InvalidInstruction" if kind == EsIr::IssueKind.InvalidInstruction
            return "InvalidTerminator" if kind == EsIr::IssueKind.InvalidTerminator
            return "UnknownHandler" if kind == EsIr::IssueKind.UnknownHandler
            return "DuplicateHandler" if kind == EsIr::IssueKind.DuplicateHandler
            return "UnbalancedHandler" if kind == EsIr::IssueKind.UnbalancedHandler
            return "InvalidResume" if kind == EsIr::IssueKind.InvalidResume
            return "UnsafeMultiShot" if kind == EsIr::IssueKind.UnsafeMultiShot
            return "HandlerContract" if kind == EsIr::IssueKind.HandlerContract
            return "UnknownBytecodeIssue"


        def runtime_error_detail(failure: InterpretError) -> sview:
            return "VerificationFailed" if failure == InterpretError.VerificationFailed
            return "UnknownFunction" if failure == InterpretError.UnknownFunction
            return "ArgumentMismatch" if failure == InterpretError.ArgumentMismatch
            return "MissingValue" if failure == InterpretError.MissingValue
            return "TypeMismatch" if failure == InterpretError.TypeMismatch
            return "DivisionByZero" if failure == InterpretError.DivisionByZero
            return "IntegerOverflow" if failure == InterpretError.IntegerOverflow
            return "InvalidNumber" if failure == InterpretError.InvalidNumber
            return "FileIo" if failure == InterpretError.FileIo
            return "Process" if failure == InterpretError.Process
            return "ProcessReplacementUnavailable" if failure == InterpretError.ProcessReplacementUnavailable
            return "OutputLimit" if failure == InterpretError.OutputLimit
            return "Environment" if failure == InterpretError.Environment
            return "Directory" if failure == InterpretError.Directory
            return "Console" if failure == InterpretError.Console
            return "Time" if failure == InterpretError.Time
            return "RangeStepZero" if failure == InterpretError.RangeStepZero
            return "InvalidShift" if failure == InterpretError.InvalidShift
            return "IndexOutOfBounds" if failure == InterpretError.IndexOutOfBounds
            return "InvalidContinuation" if failure == InterpretError.InvalidContinuation
            return "InvalidControlFlow" if failure == InterpretError.InvalidControlFlow
            return "UnsupportedInstruction" if failure == InterpretError.UnsupportedInstruction
            return "InvocationContextUnavailable" if failure == InterpretError.InvocationContextUnavailable
            return "StepLimitExceeded" if failure == InterpretError.StepLimitExceeded
            return "Assertion" if failure == InterpretError.Assertion
            return "Panic" if failure == InterpretError.Panic
            return "Raised" if failure == InterpretError.Raised
            return "UnknownRuntimeError"


        # The in-process test runner returns a terminal typed session and a
        # sealed report. Keep command routing here, with report formatting and
        # host writes delegated to the bounded output modules.
        def run_test_mode(path_items: u8&, source: sview, requested_color: EsCli::CliColorMode, requested_format: EsCli::CliReportFormat, selected_names: darray[sview]) -> i64 can[Memory.Allocate, Abort.Panic, Console.Write, Unsafe.PointerCast, Blocking.IO]:
            result: mutable EsIr::ElisascriptTestRun = EsIr::ElisascriptTestRun{}
            setup_detail: mutable sview = ""
            catch EsIr::execute_elisascript_file_tests(path_items, "elisascript-cli-test", result, selected_names: selected_names):
                ok:
                    setup_detail <- ""
                    true
                error failure:
                    setup_detail <- "InvalidExtension" if failure == ElisascriptSourceError.InvalidExtension
                    setup_detail <- "EmbeddedNul" if failure == ElisascriptSourceError.EmbeddedNul
                    setup_detail <- "InvalidUtf8" if failure == ElisascriptSourceError.InvalidUtf8
                    setup_detail <- "SourceTooLarge" if failure == ElisascriptSourceError.SourceTooLarge
                    setup_detail <- "FileIo" if failure == ElisascriptSourceError.FileIo
                    setup_detail <- "ParseFailed" if failure == ElisascriptSourceError.ParseFailed
                    setup_detail <- "SemanticFailed" if failure == ElisascriptSourceError.SemanticFailed
                    setup_detail <- "LowerFailed" if failure == ElisascriptSourceError.LowerFailed
                    setup_detail <- "VerificationFailed" if failure == ElisascriptSourceError.VerificationFailed
                    setup_detail <- "NoTests" if failure == EsScriptTest::ScriptTestError.NoTests
                    setup_detail <- "TestLimitExceeded" if failure == EsScriptTest::ScriptTestError.TestLimitExceeded
                    setup_detail <- "FunctionNotFound" if failure == EsScriptTest::ScriptTestError.FunctionNotFound
                    setup_detail <- "FunctionSignatureInvalid" if failure == EsScriptTest::ScriptTestError.FunctionSignatureInvalid
                    setup_detail <- "TestSelectionLimitExceeded" if failure == EsScriptTest::ScriptTestError.SelectionLimitExceeded
                    setup_detail <- "TestSelectionInvalid" if failure == EsScriptTest::ScriptTestError.SelectionInvalid
                    setup_detail <- "DuplicateTestSelection" if failure == EsScriptTest::ScriptTestError.DuplicateSelection
                    setup_detail <- "TestSelectionNotFound" if failure == EsScriptTest::ScriptTestError.SelectionNotFound
                    setup_detail <- "TestSetupFailed" if setup_detail == ""
                    false
            if setup_detail != "":
                return report_test_setup_failure_machine(requested_format, setup_detail) if requested_format == EsCli::CliReportFormat.Json or requested_format == EsCli::CliReportFormat.Junit
                return report_failure(source, "test", setup_detail)

            options: mutable EsOutput::OutputOptions = EsOutput::OutputOptions{}
            color_enabled: mutable bool = false
            if requested_format == EsCli::CliReportFormat.Json:
                options.format <- EsOutput::OutputFormat.Json
                options.color <- EsOutput::OutputColorMode.Never
            elif requested_format == EsCli::CliReportFormat.Junit:
                options.format <- EsOutput::OutputFormat.Junit
                options.color <- EsOutput::OutputColorMode.Never
            else:
                if requested_color == EsCli::CliColorMode.Always:
                    options.color <- EsOutput::OutputColorMode.Always
                    color_enabled <- true
                elif requested_color == EsCli::CliColorMode.Never:
                    options.color <- EsOutput::OutputColorMode.Never
                else:
                    color_enabled <- EsRuntime::elisascript_posix_isatty(1)
            report: mutable EsOutput::OutputDocument = EsOutput::OutputDocument{}
            report_ready: bool =
                catch EsIr::build_elisascript_test_report(result, options, report):
                    ok:
                        true
                    error failure:
                        _ = failure
                        false
            if not report_ready:
                return report_failure(source, "test-report", "unable to build test report")

            policy: EsOutputTransport::OutputTransportPolicy = EsOutputTransport::OutputTransportPolicy{color_enabled: color_enabled}
            output_written: bool =
                catch EsOutputTransportPosix::write_output_document_fd(report, 1, policy):
                    written_bytes:
                        _ = written_bytes
                        true
                    error failure:
                        _ = failure
                        false
            if not output_written:
                return report_failure(source, "test-output", "unable to write complete test report")
            return 1 if result.session.state == EsScriptTest::ScriptTestState.Failed
            return 130 if result.session.state == EsScriptTest::ScriptTestState.Cancelled
            return 0

    public:
        def run(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Format, Console.Write, Blocking.IO, Memory.Release]:
            if argc < 0 or argc > EsIr::LauncherLimits::ARGC:
                write_stderr("elisascript: argument vector exceeds the launcher limit\n")
                return 2
            slots: mutable cstr&& = argv.cast[mutable cstr&&]
            arguments_valid: mutable bool = true
            argument_failure: mutable HostArgumentFailure = HostArgumentFailure.None
            raw_arguments: darray[sview] = collect_arguments(argc, slots, arguments_valid, argument_failure)
            if not arguments_valid:
                return report_failure("", "source", "source path exceeds filename limit") if argument_failure == HostArgumentFailure.SourceFilename
                return report_failure("", "arguments", "script arguments exceed aggregate byte limit") if argument_failure == HostArgumentFailure.ArgumentBytes
                write_stderr("elisascript: argument exceeds the host C-string limit\n")
                return 2
            request: mutable EsIr::ElisascriptCliRequest = EsIr::ElisascriptCliRequest{source: "", arguments: []}
            if not parse(raw_arguments, request):
                write_stderr("usage: elisascript <file.elisascript> [arguments...]\n")
                return 2

            if request.mode == EsCli::CliMode.Help:
                write_stderr("usage: elisascript [--run|--check|--test|--fmt|--doc] [--select NAME ...] [--color auto|always|never] [--format human|json|junit] <file.elisascript> [--] [arguments...]\n")
                write_stderr("       elisascript --version\n")
                return 0
            if request.mode == EsCli::CliMode.Version:
                write_stderr("elisascript 0.1\n")
                return 0
            if request.mode != EsCli::CliMode.Run and request.mode != EsCli::CliMode.Check and request.mode != EsCli::CliMode.Test:
                return report_failure("", "driver", "requested launcher mode is not implemented")

            source_length: usize = sview_len(request.source)
            if source_length >= EsIr::ES_RUNTIME_DEFAULT_MAX_CSTRING_BYTES:
                return report_failure("", "source", "source path exceeds the host C-string limit")
            if source_length >= EsIr::SourceLimits::FILENAME_BYTES:
                return report_failure("", "source", "source path exceeds the filename limit")
            allocation_length: usize = source_length + 1
            allocation_i64: i64 = allocation_length.i64()
            if allocation_length == 0 or allocation_i64 < 0 or allocation_i64.usize() != allocation_length:
                write_stderr("elisascript: source path is too large\n")
                return 1
            path_bytes: mutable dstr = ctx_fstr_alloc(allocation_length)
            if path_bytes.items == null:
                write_stderr("elisascript: unable to allocate source path\n")
                return 1
            ctx_fstr_append(path_bytes, request.source.data, source_length)
            ctx_fstr_append(path_bytes, "\0", 1)
            path_items: mutable u8& = path_bytes.items

            diagnostic: EsIr::ElisascriptProgramDiagnostic = EsIr::ElisascriptProgramDiagnostic{}
            if request.mode == EsCli::CliMode.Check:
                EsIr::check_elisascript_program_file_diagnostic(path_items, diagnostic)
                if diagnostic.failed:
                    return report_program_failure(request.source, diagnostic)
                return 0
            if request.mode == EsCli::CliMode.Test:
                return run_test_mode(path_items, request.source, request.color, request.report_format, request.test_selection)
            if request.strict_engine:
                EsIr::execute_elisascript_program_file_direct_only_diagnostic(path_items, request.arguments, diagnostic)
            else:
                EsIr::execute_elisascript_program_file_standalone_diagnostic(path_items, request.arguments, diagnostic)
            if diagnostic.failed:
                return report_program_failure(request.source, diagnostic)
            execution: EsIr::Execution = diagnostic.execution
            if execution.value.kind == EsIr::RuntimeValueKind.Int:
                return execution.value.integer
            return report_failure(request.source, "entrypoint", "main returned a non-integer status")


def main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Format, Console.Write, Blocking.IO, Memory.Release]:
    return EsDriver::run(argc, argv)
