# Elisascript command-line driver.
#
# The host ABI is intentionally tiny (`main(argc, argv)`). Everything after
# that boundary is typed: argv becomes darray[sview], the request parser checks
# the source contract. The driver enters the same typed source, verifier,
# bytecode, and execution boundaries explicitly so each failure can retain its
# phase and source path instead of being converted into a generic sentinel.

include "../ir/ir.elisa"

using EsIr


module EsDriver:
    private:
        const ES_DRIVER_MAX_ARGC: i64 = 1048578

        def write_stderr(message: sview) -> void can[Console.Write, Unsafe.PointerCast]:
            return if sview_is_empty(message)
            offset: mutable usize = 0
            length: usize = sview_len(message)
            while offset < length:
                remaining: usize = length - offset
                buffer: mutable u8& = message.data + offset
                amount: isize = runtime_write(FileDescriptor.Error, buffer.cast[void&], remaining) can Console.Write
                return if amount <= 0 or amount.usize() > remaining
                offset <- offset + amount.usize()


        def host_argument_view(pointer: cstr, limit: usize, too_large: mutable bool) -> sview:
            too_large <- false
            bytes: u8& = pointer.cast[u8&]
            length: mutable usize = 0
            while length <= limit:
                return sview(bytes, 0, length.i64()) if bytes[length] == 0
                length <- length + 1
            too_large <- true
            return ""


        def collect_arguments(argc: i64, slots: mutable cstr&&, valid: mutable bool&) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            valid <- true
            arguments: mutable darray[sview] = []
            index: mutable i64 = 1
            total_argument_bytes: mutable usize = 0
            while index < argc |index, slots, arguments, valid, total_argument_bytes|:
                too_large: mutable bool = false
                argument_limit: mutable usize = EsIr::ES_RUNTIME_DEFAULT_MAX_CSTRING_BYTES - 1
                if index > 1:
                    if total_argument_bytes > EsIr::ES_LAUNCHER_MAX_ARGUMENT_BYTES:
                        valid <- false
                        return arguments
                    remaining: usize = EsIr::ES_LAUNCHER_MAX_ARGUMENT_BYTES - total_argument_bytes
                    argument_limit <- remaining if remaining < argument_limit
                argument: sview = host_argument_view(slots[index.usize()], argument_limit, too_large)
                if too_large:
                    valid <- false
                    return arguments
                if index > 1:
                    argument_length: usize = sview_len(argument)
                    if argument_length > EsIr::ES_LAUNCHER_MAX_ARGUMENT_BYTES - total_argument_bytes:
                        valid <- false
                        return arguments
                    total_argument_bytes <- total_argument_bytes + argument_length
                arguments.push(argument)
                index <- index + 1
            return arguments


        def parse[@r](arguments: darray[sview]&, request: mutable ElisascriptCliRequest& @r) -> bool can[Memory.Allocate, Abort.Panic]:
            try parse_elisascript_cli(arguments, request) else return false
            return true


        def report_failure(source: sview, phase: sview, detail: sview) -> i64 can[Console.Write, Unsafe.PointerCast]:
            write_stderr("elisascript: ")
            write_stderr(source)
            write_stderr(": ")
            write_stderr(phase)
            write_stderr(": ")
            write_stderr(detail)
            write_stderr("\n")
            return 1


        # Keep the host-facing diagnostic stable without flattening the typed
        # error channel. The runner retains the original enum; the driver only
        # adds its variant spelling to the phase line for scripts and tools that
        # cannot inspect the programmatic error union directly.
        def source_error_detail(failure: ElisascriptSourceError) -> sview:
            return "InvalidExtension" if failure == ElisascriptSourceError.InvalidExtension
            return "EmbeddedNul" if failure == ElisascriptSourceError.EmbeddedNul
            return "SourceTooLarge" if failure == ElisascriptSourceError.SourceTooLarge
            return "FileIo" if failure == ElisascriptSourceError.FileIo
            return "ParseFailed" if failure == ElisascriptSourceError.ParseFailed
            return "SemanticFailed" if failure == ElisascriptSourceError.SemanticFailed
            return "LowerFailed" if failure == ElisascriptSourceError.LowerFailed
            return "VerificationFailed" if failure == ElisascriptSourceError.VerificationFailed
            return "UnknownSourceError"


        def entrypoint_error_detail(failure: ElisascriptEntrypointError) -> sview:
            return "MissingMain" if failure == ElisascriptEntrypointError.MissingMain
            return "InvalidMainSignature" if failure == ElisascriptEntrypointError.InvalidMainSignature
            return "UnknownEntrypointError"


        def runtime_error_detail(failure: InterpretError) -> sview:
            return "VerificationFailed" if failure == InterpretError.VerificationFailed
            return "UnknownFunction" if failure == InterpretError.UnknownFunction
            return "ArgumentMismatch" if failure == InterpretError.ArgumentMismatch
            return "MissingValue" if failure == InterpretError.MissingValue
            return "TypeMismatch" if failure == InterpretError.TypeMismatch
            return "DivisionByZero" if failure == InterpretError.DivisionByZero
            return "IntegerOverflow" if failure == InterpretError.IntegerOverflow
            return "InvalidNumber" if failure == InterpretError.InvalidNumber
            return "FileIo" if failure == InterpretError.FileIo
            return "Process" if failure == InterpretError.Process
            return "OutputLimit" if failure == InterpretError.OutputLimit
            return "Environment" if failure == InterpretError.Environment
            return "Directory" if failure == InterpretError.Directory
            return "Console" if failure == InterpretError.Console
            return "Time" if failure == InterpretError.Time
            return "RangeStepZero" if failure == InterpretError.RangeStepZero
            return "InvalidShift" if failure == InterpretError.InvalidShift
            return "IndexOutOfBounds" if failure == InterpretError.IndexOutOfBounds
            return "InvalidContinuation" if failure == InterpretError.InvalidContinuation
            return "InvalidControlFlow" if failure == InterpretError.InvalidControlFlow
            return "UnsupportedInstruction" if failure == InterpretError.UnsupportedInstruction
            return "StepLimitExceeded" if failure == InterpretError.StepLimitExceeded
            return "Assertion" if failure == InterpretError.Assertion
            return "Panic" if failure == InterpretError.Panic
            return "Raised" if failure == InterpretError.Raised
            return "UnknownRuntimeError"

    public:
        def run(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Blocking.IO, Memory.Release]:
            if argc < 0 or argc > ES_DRIVER_MAX_ARGC:
                write_stderr("elisascript: argument vector exceeds the launcher limit\n")
                return 2
            slots: mutable cstr&& = argv.cast[mutable cstr&&]
            arguments_valid: mutable bool = true
            raw_arguments: darray[sview] = collect_arguments(argc, slots, arguments_valid)
            if not arguments_valid:
                write_stderr("elisascript: argument exceeds the host C-string limit\n")
                return 2
            request: mutable EsIr::ElisascriptCliRequest = EsIr::ElisascriptCliRequest{source: "", arguments: []}
            if not parse(raw_arguments, request):
                write_stderr("usage: elisascript <file.elisascript> [arguments...]\n")
                return 2

            source_length: usize = sview_len(request.source)
            if source_length >= EsIr::ES_RUNTIME_DEFAULT_MAX_CSTRING_BYTES:
                return report_failure(request.source, "source", "source path exceeds the host C-string limit")
            allocation_length: usize = source_length + 1
            allocation_i64: i64 = allocation_length.i64()
            if allocation_length == 0 or allocation_i64 < 0 or allocation_i64.usize() != allocation_length:
                write_stderr("elisascript: source path is too large\n")
                return 1
            path_bytes: mutable dstr = ctx_fstr_alloc(allocation_length)
            if path_bytes.items == null:
                write_stderr("elisascript: unable to allocate source path\n")
                return 1
            ctx_fstr_append(path_bytes, request.source.data, source_length)
            ctx_fstr_append(path_bytes, "\0", 1)
            path_items: mutable u8& = path_bytes.items

            diagnostic: EsIr::ElisascriptProgramDiagnostic = EsIr::ElisascriptProgramDiagnostic{}
            EsIr::execute_elisascript_program_file_diagnostic(path_items, request.arguments, diagnostic)
            if diagnostic.failed:
                detail: sview = diagnostic.detail
                detail <- source_error_detail(diagnostic.source_error) if diagnostic.source_error_known
                detail <- entrypoint_error_detail(diagnostic.entrypoint_error) if diagnostic.entrypoint_error_known
                detail <- runtime_error_detail(diagnostic.runtime_error) if diagnostic.runtime_error_known
                return report_failure(request.source, diagnostic.phase, detail)
            execution: EsIr::Execution = diagnostic.execution
            if execution.value.kind == EsIr::RuntimeValueKind.Int:
                return execution.value.integer
            return report_failure(request.source, "entrypoint", "main returned a non-integer status")


def main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Blocking.IO, Memory.Release]:
    return EsDriver::run(argc, argv)
