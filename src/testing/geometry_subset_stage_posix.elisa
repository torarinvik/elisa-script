# Exclusive temporary-directory staging adapter for the typed geometry parity
# cases. It writes only fixed, validated package leaves and the bounded TSV.
include "geometry_subset_stage_model.elisa"

using EsGeometrySubsetStageModel
using EsGeometrySubsetPackageCases
using EsEngineGeometrySubsetPackageBuilder


module EsGeometrySubsetStagePosix:
    public:
        struct Receipt:
            directory: Path
            manifest_path: Path
            case_count: usize
            total_package_bytes: usize


        error StageIoError:
            IncompleteWrite(file_name: sview)
            CleanupFailed


        def stage_geometry_packages() -> Receipt error[FileIoError, StripPackageError, EsGeometrySubsetManifest::ManifestError, StagePlanError, StageIoError] can[File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            cases: darray[GeneratedCase] = try EsGeometrySubsetStageModel::package_cases()
            return try stage_cases(cases)


        def stage_geometry_packages_with_deformation(morph_package: sview, skin_package: sview) -> Receipt error[FileIoError, StripPackageError, EsGeometrySubsetDeformationCases::DeformationCasesError, EsGeometrySubsetManifest::ManifestError, StagePlanError, StageIoError] can[File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            cases: darray[GeneratedCase] = try EsGeometrySubsetStageModel::package_cases_with_deformation(morph_package, skin_package)
            return try stage_cases(cases)


        def stage_geometry_packages_with_meshopt(compressed_package: sview, raw_positions_base64: sview) -> Receipt error[FileIoError, StripPackageError, EsGeometrySubsetMeshoptCases::MeshoptCasesError, EsGeometrySubsetManifest::ManifestError, StagePlanError, StageIoError] can[File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            cases: darray[GeneratedCase] = try EsGeometrySubsetStageModel::package_cases_with_meshopt(compressed_package, raw_positions_base64)
            return try stage_cases(cases)


        def stage_geometry_packages_with_scene_variants(scene_package: sview) -> Receipt error[FileIoError, StripPackageError, EsGeometrySubsetSceneCases::SceneCasesError, EsGeometrySubsetManifest::ManifestError, StagePlanError, StageIoError] can[File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            cases: darray[GeneratedCase] = try EsGeometrySubsetStageModel::package_cases_with_scene_variants(scene_package)
            return try stage_cases(cases)


        def stage_geometry_packages_with_hierarchy(hierarchy_package: sview) -> Receipt error[FileIoError, StripPackageError, EsGeometrySubsetHierarchyCases::HierarchyCasesError, EsGeometrySubsetManifest::ManifestError, StagePlanError, StageIoError] can[File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            cases: darray[GeneratedCase] = try EsGeometrySubsetStageModel::package_cases_with_hierarchy(hierarchy_package)
            return try stage_cases(cases)


    private:
        const module Limits:
            TEMP_PREFIX: sview = "elisa-geometry-subsets-"
            MANIFEST_NAME: sview = "cases.tsv"


        def stage_cases(cases: darray[GeneratedCase]) -> Receipt error[FileIoError, EsGeometrySubsetManifest::ManifestError, StagePlanError, StageIoError] can[File.Write, Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            directory: Path = try temp_directory(Limits::TEMP_PREFIX)
            catch stage_and_write(directory, cases):
                ok plan:
                    return plan
                error failure:
                    cleaned: bool = try remove_tree(directory) else false
                    raise StageIoError.CleanupFailed if not cleaned
                    raise failure


        def stage_and_write(directory: Path, cases: darray[GeneratedCase]) -> Receipt error[FileIoError, EsGeometrySubsetManifest::ManifestError, StagePlanError, StageIoError] can[File.Write, Memory.Allocate, Abort.Panic, Console.Format]:
            plan: Plan = try stage_plan(f"{directory}", cases)
            return try write_plan(directory, plan)


        def stage_plan(directory: sview, cases: darray[GeneratedCase]) -> Plan error[EsGeometrySubsetManifest::ManifestError, StagePlanError] can[Memory.Allocate, Abort.Panic, Console.Format]:
            manifest: darray[u8] = try EsGeometrySubsetStageModel::manifest_bytes(directory, cases)
            total: mutable usize = 0
            for current in cases |total|:
                total <- total + current.package_bytes.count
            return Plan{cases: cases, manifest_bytes: manifest, total_package_bytes: total}


        def write_plan(directory: Path, plan: Plan) -> Receipt error[FileIoError, StageIoError] can[File.Write, Memory.Allocate, Abort.Panic]:
            for current in plan.cases:
                target: Path = directory.joinpath(current.file_name)
                written: usize = try write_bytes(target, current.package_bytes)
                raise StageIoError.IncompleteWrite(current.file_name) if written != current.package_bytes.count

            manifest_path: Path = directory.joinpath(Limits::MANIFEST_NAME)
            manifest_written: usize = try write_bytes(manifest_path, plan.manifest_bytes)
            raise StageIoError.IncompleteWrite(Limits::MANIFEST_NAME) if manifest_written != plan.manifest_bytes.count
            return Receipt{
                directory: directory,
                manifest_path: manifest_path,
                case_count: plan.cases.count,
                total_package_bytes: plan.total_package_bytes
            }
