# Typed fixture descriptions for geometry_subset_occlusion_strength_cases.py.
# Package serialization is intentionally left to the geometry test adapter.

module EsGeometrySubsetOcclusionStrengthCases:
    public:
        const enum Verdict of u8:
            Accept
            Reject


        const enum NumberKind of u8:
            Finite
            NaN
            PositiveInfinity


        struct NumberValue:
            kind: NumberKind
            finite_value: f64 = 0.0


        struct Subset:
            first_index: u32
            index_count: u32
            material_slot: u32


        struct Case:
            verdict: Verdict
            file_name: sview
            material_slots: u32
            triangle_count: u32 = 2u32
            subsets: darray[Subset] = []
            has_material_records: bool = false
            material_record_count: u32 = 0u32
            occlusion_strength_stride: sview = "4"
            has_occlusion_strength_data_field: bool = true
            occlusion_strengths: darray[NumberValue] = []
            expected_diagnostic: sview = ""


        def cases() -> darray[Case] can[Memory.Allocate, Abort.Panic]:
            two_subsets: darray[Subset] = [
                Subset{first_index: 0u32, index_count: 3u32, material_slot: 0u32},
                Subset{first_index: 3u32, index_count: 3u32, material_slot: 1u32}
            ]
            one_subset: darray[Subset] = [Subset{first_index: 0u32, index_count: 6u32, material_slot: 0u32}]
            standard_strengths: darray[NumberValue] = [
                NumberValue{kind: NumberKind.Finite, finite_value: 0.25},
                NumberValue{kind: NumberKind.Finite, finite_value: 0.75}
            ]
            one_strength: darray[NumberValue] = [NumberValue{kind: NumberKind.Finite, finite_value: 0.75}]
            return [
                occlusion_strength_case(
                    Verdict.Accept, "occlusion-strength.pkg", two_subsets, 2u32, true,
                    2u32, standard_strengths, "4", true, ""),
                occlusion_strength_case(
                    Verdict.Reject, "occlusion-strength-without-materials.pkg", two_subsets,
                    2u32, false, 0u32, standard_strengths, "4", true, Messages::RECORDS),
                occlusion_strength_case(
                    Verdict.Reject, "occlusion-strength-stride.pkg", one_subset, 1u32, true,
                    1u32, one_strength, "8", true, Messages::RECORDS),
                occlusion_strength_case(
                    Verdict.Reject, "occlusion-strength-no-records.pkg", one_subset, 1u32,
                    true, 1u32, one_strength, "4", false, Messages::RECORDS),
                occlusion_strength_case(
                    Verdict.Reject, "occlusion-strength-count.pkg", one_subset, 1u32, true,
                    1u32, standard_strengths, "4", true, Messages::RECORDS),
                occlusion_strength_case(
                    Verdict.Reject, "occlusion-strength-negative.pkg", one_subset, 1u32,
                    true, 1u32, [NumberValue{kind: NumberKind.Finite, finite_value: -0.01}],
                    "4", true, Messages::RANGE),
                occlusion_strength_case(
                    Verdict.Reject, "occlusion-strength-overflow.pkg", one_subset, 1u32,
                    true, 1u32, [NumberValue{kind: NumberKind.Finite, finite_value: 1.01}],
                    "4", true, Messages::RANGE),
                occlusion_strength_case(
                    Verdict.Reject, "occlusion-strength-nan.pkg", one_subset, 1u32, true,
                    1u32, [NumberValue{kind: NumberKind.NaN}], "4", true, Messages::RANGE),
                occlusion_strength_case(
                    Verdict.Reject, "occlusion-strength-infinite.pkg", one_subset, 1u32,
                    true, 1u32, [NumberValue{kind: NumberKind.PositiveInfinity}],
                    "4", true, Messages::RANGE)
            ]


    private:
        const module Messages:
            RECORDS: sview = "invalid cooked slot occlusion strengths"
            RANGE: sview = "cooked slot occlusion strength is out of range"


        def occlusion_strength_case(verdict: Verdict, file_name: sview, subsets: darray[Subset], material_slots: u32, has_material_records: bool, material_record_count: u32, occlusion_strengths: darray[NumberValue], occlusion_strength_stride: sview, has_occlusion_strength_data_field: bool, expected_diagnostic: sview) -> Case:
            return Case{
                verdict: verdict,
                file_name: file_name,
                subsets: subsets,
                material_slots: material_slots,
                has_material_records: has_material_records,
                material_record_count: material_record_count,
                occlusion_strength_stride: occlusion_strength_stride,
                has_occlusion_strength_data_field: has_occlusion_strength_data_field,
                occlusion_strengths: occlusion_strengths,
                expected_diagnostic: expected_diagnostic
            }
