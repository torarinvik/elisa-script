# Bounded deterministic input-generator contract for differential testing.
#
# Generators do not receive ambient randomness. Each case seed is derived from
# one recorded base seed and its ordinal, while the session bounds case count
# and aggregate generated bytes before an adapter materializes a case.

module EsDifferentialGenerator:
    public:
        const DIFFERENTIAL_GENERATOR_MAX_CASES: usize = 1048576
        const DIFFERENTIAL_GENERATOR_MAX_BYTES: usize = 268435456


        const enum DifferentialGeneratorState of u8:
            Planned
            Running
            Completed
            Failed
            Cancelled


        const enum DifferentialGeneratorEvent of u8:
            Begin
            Generate
            Complete
            Fail
            Cancel


        struct DifferentialGeneratorPolicy:
            base_seed: u64
            max_cases: usize = DIFFERENTIAL_GENERATOR_MAX_CASES
            max_bytes: usize = DIFFERENTIAL_GENERATOR_MAX_BYTES


        struct DifferentialGeneratedInput:
            case_index: usize
            seed: u64
            fingerprint: u64
            payload_bytes: usize = 0


        struct DifferentialGeneratorSession:
            policy: DifferentialGeneratorPolicy
            state: DifferentialGeneratorState = DifferentialGeneratorState.Planned
            next_case: usize = 0
            generated_bytes: usize = 0
            inputs: darray[DifferentialGeneratedInput] = []


        error DifferentialGeneratorError:
            InvalidState
            InvalidEvent
            InvalidPolicy
            CaseLimitExceeded
            ByteLimitExceeded
            CaseOrderInvalid
            SeedMismatch
            FingerprintMissing
            CompleteNotReady
            CancelNotReady


    private:
        const DIFFERENTIAL_GENERATOR_SEED_MULTIPLIER: u64 = 0x9e3779b97f4a7c15


        def differential_generator_state_valid(state: DifferentialGeneratorState) -> bool:
            return state in {DifferentialGeneratorState.Planned, DifferentialGeneratorState.Running, DifferentialGeneratorState.Completed, DifferentialGeneratorState.Failed, DifferentialGeneratorState.Cancelled}


        def differential_generator_event_valid(event: DifferentialGeneratorEvent) -> bool:
            return event in {DifferentialGeneratorEvent.Begin, DifferentialGeneratorEvent.Generate, DifferentialGeneratorEvent.Complete, DifferentialGeneratorEvent.Fail, DifferentialGeneratorEvent.Cancel}


        def differential_generator_policy_valid(policy: DifferentialGeneratorPolicy) -> bool:
            return policy.max_cases != 0 and policy.max_cases <= DIFFERENTIAL_GENERATOR_MAX_CASES and policy.max_bytes != 0 and policy.max_bytes <= DIFFERENTIAL_GENERATOR_MAX_BYTES


        def differential_generator_case_seed(policy: DifferentialGeneratorPolicy, case_index: usize) -> u64:
            derived: u64 = policy.base_seed ^ (case_index.u64() * DIFFERENTIAL_GENERATOR_SEED_MULTIPLIER)
            return derived if derived != 0 else 1


    public:
        def validate_differential_generator_session(session: DifferentialGeneratorSession&) -> bool error[DifferentialGeneratorError]:
            raise DifferentialGeneratorError.InvalidState if not differential_generator_state_valid(session.state)
            raise DifferentialGeneratorError.InvalidPolicy if not differential_generator_policy_valid(session.policy)
            raise DifferentialGeneratorError.CaseLimitExceeded if session.next_case > session.policy.max_cases or session.inputs.count > session.policy.max_cases
            raise DifferentialGeneratorError.ByteLimitExceeded if session.generated_bytes > session.policy.max_bytes
            raise DifferentialGeneratorError.CaseOrderInvalid if session.next_case != session.inputs.count
            expected_bytes: mutable usize = 0
            for index in 0..<session.inputs.count |session, expected_bytes|:
                input: DifferentialGeneratedInput = session.inputs[index]
                raise DifferentialGeneratorError.CaseOrderInvalid if input.case_index != index
                raise DifferentialGeneratorError.SeedMismatch if input.seed != differential_generator_case_seed(session.policy, input.case_index)
                raise DifferentialGeneratorError.FingerprintMissing if input.fingerprint == 0
                raise DifferentialGeneratorError.ByteLimitExceeded if input.payload_bytes > session.policy.max_bytes - expected_bytes
                expected_bytes <- expected_bytes + input.payload_bytes
            raise DifferentialGeneratorError.ByteLimitExceeded if session.generated_bytes != expected_bytes
            return true


        def advance_differential_generator(session: mutable DifferentialGeneratorSession&, event: DifferentialGeneratorEvent, input: DifferentialGeneratedInput = DifferentialGeneratedInput{case_index: 0, seed: 1, fingerprint: 1}) -> DifferentialGeneratorState error[DifferentialGeneratorError]:
            try validate_differential_generator_session(session)
            raise DifferentialGeneratorError.InvalidEvent if not differential_generator_event_valid(event)
            if event == DifferentialGeneratorEvent.Begin:
                raise DifferentialGeneratorError.InvalidState if session.state != DifferentialGeneratorState.Planned
                session.state <- DifferentialGeneratorState.Running
            elif event == DifferentialGeneratorEvent.Generate:
                raise DifferentialGeneratorError.InvalidState if session.state != DifferentialGeneratorState.Running
                raise DifferentialGeneratorError.CaseLimitExceeded if session.next_case >= session.policy.max_cases
                raise DifferentialGeneratorError.CaseOrderInvalid if input.case_index != session.next_case
                raise DifferentialGeneratorError.SeedMismatch if input.seed != differential_generator_case_seed(session.policy, input.case_index)
                raise DifferentialGeneratorError.FingerprintMissing if input.fingerprint == 0
                raise DifferentialGeneratorError.ByteLimitExceeded if input.payload_bytes > session.policy.max_bytes - session.generated_bytes
                session.inputs.push(input)
                session.next_case <- session.next_case + 1
                session.generated_bytes <- session.generated_bytes + input.payload_bytes
            elif event == DifferentialGeneratorEvent.Complete:
                raise DifferentialGeneratorError.CompleteNotReady if session.state != DifferentialGeneratorState.Running or session.inputs.count == 0
                session.state <- DifferentialGeneratorState.Completed
            elif event == DifferentialGeneratorEvent.Fail:
                raise DifferentialGeneratorError.InvalidState if session.state != DifferentialGeneratorState.Running
                session.state <- DifferentialGeneratorState.Failed
            elif event == DifferentialGeneratorEvent.Cancel:
                raise DifferentialGeneratorError.CancelNotReady if session.state != DifferentialGeneratorState.Planned and session.state != DifferentialGeneratorState.Running
                session.state <- DifferentialGeneratorState.Cancelled
            return session.state
