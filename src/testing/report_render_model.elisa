# Bounded deterministic Human, JSON, and JUnit rendering for differential reports.
#
# This adapter deliberately serializes the typed report and repeat evidence as
# data. It never infers outcome from summary text, process status, or messages.

module EsDifferentialReportRender:
    using EsDifferentialReport
    using EsDifferentialStability

    public:
        const module Limits:
            MAX_BYTES: usize = 33554432


        error DifferentialReportRenderError:
            InvalidLimit
            InvalidFormat
            InvalidEnum
            XmlCharacterInvalid
            OutputLimitExceeded


    private:
        const module Internal:
            JSON_HEX: sview = "0123456789abcdef"


        def report_render_append_byte(output: mutable darray[u8]&, byte: u8, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialReportRenderError.OutputLimitExceeded if output.count >= limit
            output.push(byte)


        def report_render_append_text(output: mutable darray[u8]&, text: sview, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialReportRenderError.OutputLimitExceeded if output.count > limit
            raise DifferentialReportRenderError.OutputLimitExceeded if sview_len(text) > limit - output.count
            for index in 0..<sview_len(text) |output, text, limit|:
                output.push(sview_at(text, index))


        def report_render_append_hex_byte(output: mutable darray[u8]&, value: u8, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            try report_render_append_text(output, "\\u00", limit)
            try report_render_append_byte(output, sview_at(Internal::JSON_HEX, ((value >> 4) & 15u8).usize()), limit)
            try report_render_append_byte(output, sview_at(Internal::JSON_HEX, (value & 15u8).usize()), limit)


        def report_render_append_json_string(output: mutable darray[u8]&, value: sview, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            try report_render_append_byte(output, 34u8, limit)
            for index in 0..<sview_len(value) |output, value, limit|:
                byte: u8 = sview_at(value, index)
                if byte == 34u8 or byte == 92u8:
                    try report_render_append_byte(output, 92u8, limit)
                    try report_render_append_byte(output, byte, limit)
                elif byte == 8u8:
                    try report_render_append_text(output, "\\b", limit)
                elif byte == 9u8:
                    try report_render_append_text(output, "\\t", limit)
                elif byte == 10u8:
                    try report_render_append_text(output, "\\n", limit)
                elif byte == 12u8:
                    try report_render_append_text(output, "\\f", limit)
                elif byte == 13u8:
                    try report_render_append_text(output, "\\r", limit)
                elif byte < 32u8:
                    try report_render_append_hex_byte(output, byte, limit)
                else:
                    # The report validator has already established UTF-8, so
                    # non-ASCII code units can be copied without transcoding.
                    try report_render_append_byte(output, byte, limit)
            try report_render_append_byte(output, 34u8, limit)


        def report_render_append_u64(output: mutable darray[u8]&, value: u64, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            digits: mutable darray[u8] = []
            remaining: mutable u64 = value
            if remaining == 0u64:
                digits.push(48u8)
            while remaining != 0u64:
                digit: u8 = (remaining % 10u64).u8()
                digits.push(48u8 + digit)
                remaining <- remaining / 10u64
            for index in 0..<digits.count |output, digits, limit|:
                try report_render_append_byte(output, digits[digits.count - index - 1], limit)


        def report_render_append_usize(output: mutable darray[u8]&, value: usize, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            try report_render_append_u64(output, value.u64(), limit)


        def report_render_append_bool(output: mutable darray[u8]&, value: bool, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            if value:
                try report_render_append_text(output, "true", limit)
            else:
                try report_render_append_text(output, "false", limit)


        def report_render_status_name(status: DifferentialReportStatus) -> sview error[DifferentialReportRenderError]:
            return "passed" if status == DifferentialReportStatus.Passed
            return "failed" if status == DifferentialReportStatus.Failed
            return "skipped" if status == DifferentialReportStatus.Skipped
            return "inconclusive" if status == DifferentialReportStatus.Inconclusive
            raise DifferentialReportRenderError.InvalidEnum


        def report_render_category_name(category: DifferentialReportCategory) -> sview error[DifferentialReportRenderError]:
            return "none" if category == DifferentialReportCategory.None
            return "value_mismatch" if category == DifferentialReportCategory.ValueMismatch
            return "error_mismatch" if category == DifferentialReportCategory.ErrorMismatch
            return "observation_mismatch" if category == DifferentialReportCategory.ObservationMismatch
            return "process_failure" if category == DifferentialReportCategory.ProcessFailure
            return "timeout" if category == DifferentialReportCategory.Timeout
            return "crash" if category == DifferentialReportCategory.Crash
            return "artifact_failure" if category == DifferentialReportCategory.ArtifactFailure
            return "invalid_input" if category == DifferentialReportCategory.InvalidInput
            return "infrastructure_failure" if category == DifferentialReportCategory.InfrastructureFailure
            return "flaky" if category == DifferentialReportCategory.Flaky
            raise DifferentialReportRenderError.InvalidEnum


        def report_render_comparison_kind_name(kind: DifferentialReportDifferenceKind) -> sview error[DifferentialReportRenderError]:
            return "unavailable" if kind == DifferentialReportDifferenceKind.Unavailable
            return "equal" if kind == DifferentialReportDifferenceKind.Equal
            return "engine" if kind == DifferentialReportDifferenceKind.Engine
            return "exit_status" if kind == DifferentialReportDifferenceKind.ExitStatus
            return "error" if kind == DifferentialReportDifferenceKind.Error
            return "stdout" if kind == DifferentialReportDifferenceKind.Stdout
            return "stderr" if kind == DifferentialReportDifferenceKind.Stderr
            return "return_value" if kind == DifferentialReportDifferenceKind.ReturnValue
            return "observation_count" if kind == DifferentialReportDifferenceKind.ObservationCount
            return "observation_trace" if kind == DifferentialReportDifferenceKind.ObservationTrace
            return "observation_value" if kind == DifferentialReportDifferenceKind.ObservationValue
            return "outcome" if kind == DifferentialReportDifferenceKind.Outcome
            return "case_invalid" if kind == DifferentialReportDifferenceKind.CaseInvalid
            return "observation_contract" if kind == DifferentialReportDifferenceKind.ObservationContract
            raise DifferentialReportRenderError.InvalidEnum


        def report_render_stability_state_name(state: DifferentialStabilityState) -> sview error[DifferentialReportRenderError]:
            return "planned" if state == DifferentialStabilityState.Planned
            return "running" if state == DifferentialStabilityState.Running
            return "completed" if state == DifferentialStabilityState.Completed
            return "failed" if state == DifferentialStabilityState.Failed
            return "cancelled" if state == DifferentialStabilityState.Cancelled
            raise DifferentialReportRenderError.InvalidEnum


        def report_render_stability_classification_name(classification: DifferentialStabilityClassification) -> sview error[DifferentialReportRenderError]:
            return "unknown" if classification == DifferentialStabilityClassification.Unknown
            return "stable_equal" if classification == DifferentialStabilityClassification.StableEqual
            return "stable_mismatch" if classification == DifferentialStabilityClassification.StableMismatch
            return "nondeterministic" if classification == DifferentialStabilityClassification.Nondeterministic
            raise DifferentialReportRenderError.InvalidEnum


        def report_render_nondeterminism_policy_name(policy: DifferentialNondeterminismPolicy) -> sview error[DifferentialReportRenderError]:
            return "reject" if policy == DifferentialNondeterminismPolicy.Reject
            return "report" if policy == DifferentialNondeterminismPolicy.Report
            raise DifferentialReportRenderError.InvalidEnum


        def report_render_append_fingerprint(output: mutable darray[u8]&, value: u64, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            # Fingerprints are decimal JSON strings to avoid lossy IEEE-754
            # parsing by common consumers such as JavaScript.
            temporary: mutable darray[u8] = []
            try report_render_append_u64(temporary, value, 20)
            try report_render_append_byte(output, 34u8, limit)
            for index in 0..<temporary.count |output, temporary, limit|:
                try report_render_append_byte(output, temporary[index], limit)
            try report_render_append_byte(output, 34u8, limit)


        def report_render_append_stability(output: mutable darray[u8]&, evidence: DifferentialStabilitySession&, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            try report_render_append_text(output, "{\"state\":", limit)
            state_name: sview = try report_render_stability_state_name(evidence.state)
            try report_render_append_json_string(output, state_name, limit)
            try report_render_append_text(output, ",\"classification\":", limit)
            classification_name: sview = try report_render_stability_classification_name(evidence.classification)
            try report_render_append_json_string(output, classification_name, limit)
            try report_render_append_text(output, ",\"policy\":{\"minimum_repeats\":", limit)
            try report_render_append_usize(output, evidence.policy.minimum_repeats, limit)
            try report_render_append_text(output, ",\"maximum_repeats\":", limit)
            try report_render_append_usize(output, evidence.policy.maximum_repeats, limit)
            try report_render_append_text(output, ",\"nondeterminism\":", limit)
            nondeterminism_name: sview = try report_render_nondeterminism_policy_name(evidence.policy.nondeterminism)
            try report_render_append_json_string(output, nondeterminism_name, limit)
            try report_render_append_text(output, "},\"next_repeat\":", limit)
            try report_render_append_usize(output, evidence.next_repeat, limit)
            try report_render_append_text(output, ",\"has_baseline\":", limit)
            try report_render_append_bool(output, evidence.has_baseline, limit)
            try report_render_append_text(output, ",\"baseline_reference_fingerprint\":", limit)
            try report_render_append_fingerprint(output, evidence.baseline_reference_fingerprint, limit)
            try report_render_append_text(output, ",\"baseline_candidate_fingerprint\":", limit)
            try report_render_append_fingerprint(output, evidence.baseline_candidate_fingerprint, limit)
            try report_render_append_text(output, ",\"baseline_comparison_fingerprint\":", limit)
            try report_render_append_fingerprint(output, evidence.baseline_comparison_fingerprint, limit)
            try report_render_append_text(output, ",\"baseline_equal\":", limit)
            try report_render_append_bool(output, evidence.baseline_equal, limit)
            try report_render_append_text(output, ",\"stable_repeats\":", limit)
            try report_render_append_usize(output, evidence.stable_repeats, limit)
            try report_render_append_text(output, ",\"has_nondeterminism\":", limit)
            try report_render_append_bool(output, evidence.has_nondeterminism, limit)
            try report_render_append_text(output, ",\"observations\":[", limit)
            for index in 0..<evidence.observations.count |output, evidence, limit|:
                observation: DifferentialStabilityObservation = evidence.observations[index]
                try report_render_append_text(output, "," if index != 0 else "", limit)
                try report_render_append_text(output, "{\"repeat_index\":", limit)
                try report_render_append_usize(output, observation.repeat_index, limit)
                try report_render_append_text(output, ",\"reference_fingerprint\":", limit)
                try report_render_append_fingerprint(output, observation.reference_fingerprint, limit)
                try report_render_append_text(output, ",\"candidate_fingerprint\":", limit)
                try report_render_append_fingerprint(output, observation.candidate_fingerprint, limit)
                try report_render_append_text(output, ",\"comparison_fingerprint\":", limit)
                try report_render_append_fingerprint(output, observation.comparison_fingerprint, limit)
                try report_render_append_text(output, ",\"equal\":", limit)
                try report_render_append_bool(output, observation.equal, limit)
                try report_render_append_byte(output, 125u8, limit)
            try report_render_append_text(output, "]}", limit)


        def report_render_xml_text_valid(value: sview) -> bool:
            for index in 0..<sview_len(value) |value|:
                byte: u8 = sview_at(value, index)
                return false if byte < 32u8 and byte not in {9u8, 10u8, 13u8}
                if byte == 239u8 and index + 2 < sview_len(value):
                    return false if sview_at(value, index + 1) == 191u8 and sview_at(value, index + 2) in {190u8, 191u8}
            return true


        def report_render_xml_fields_valid(report: DifferentialReport&) -> bool:
            return false if not report_render_xml_text_valid(report.case_name)
            return false if not report_render_xml_text_valid(report.summary)
            return false if not report_render_xml_text_valid(report.reference_engine)
            return false if not report_render_xml_text_valid(report.candidate_engine)
            return false if not report_render_xml_text_valid(report.reference_detail)
            return false if not report_render_xml_text_valid(report.candidate_detail)
            return false if not report_render_xml_text_valid(report.artifact_path)
            for message in report.messages |report|:
                return false if not report_render_xml_text_valid(message)
            return true


        def report_render_append_xml_escaped(output: mutable darray[u8]&, value: sview, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            for index in 0..<sview_len(value) |output, value, limit|:
                byte: u8 = sview_at(value, index)
                if byte == 38u8:
                    try report_render_append_text(output, "&amp;", limit)
                elif byte == 60u8:
                    try report_render_append_text(output, "&lt;", limit)
                elif byte == 62u8:
                    try report_render_append_text(output, "&gt;", limit)
                elif byte == 34u8:
                    try report_render_append_text(output, "&quot;", limit)
                elif byte == 39u8:
                    try report_render_append_text(output, "&apos;", limit)
                elif byte == 9u8:
                    try report_render_append_text(output, "&#x9;", limit)
                elif byte == 10u8:
                    try report_render_append_text(output, "&#xA;", limit)
                elif byte == 13u8:
                    try report_render_append_text(output, "&#xD;", limit)
                else:
                    try report_render_append_byte(output, byte, limit)


        def report_render_append_xml_attribute(output: mutable darray[u8]&, value: sview, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            try report_render_append_byte(output, 34u8, limit)
            try report_render_append_xml_escaped(output, value, limit)
            try report_render_append_byte(output, 34u8, limit)


        def report_render_append_xml_property(output: mutable darray[u8]&, name: sview, value: sview, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            try report_render_append_text(output, "        <property name=", limit)
            try report_render_append_xml_attribute(output, name, limit)
            try report_render_append_text(output, " value=", limit)
            try report_render_append_xml_attribute(output, value, limit)
            try report_render_append_text(output, "/>", limit)
            try report_render_append_byte(output, 10u8, limit)


        def report_render_append_xml_property_usize(output: mutable darray[u8]&, name: sview, value: usize, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            temporary: mutable darray[u8] = []
            try report_render_append_usize(temporary, value, 24)
            try report_render_append_xml_property(output, name, sview(temporary.items, 0, temporary.count), limit)


        def report_render_append_xml_attribute_usize(output: mutable darray[u8]&, value: usize, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            temporary: mutable darray[u8] = []
            try report_render_append_usize(temporary, value, 24)
            try report_render_append_xml_attribute(output, sview(temporary.items, 0, temporary.count), limit)


        def report_render_junit_failure_count(report: DifferentialReport&) -> usize:
            return 1 if report.status == DifferentialReportStatus.Failed and report.category in {DifferentialReportCategory.ValueMismatch, DifferentialReportCategory.ErrorMismatch, DifferentialReportCategory.ObservationMismatch} else 0


        def report_render_junit_error_count(report: DifferentialReport&) -> usize:
            return 1 if report.status == DifferentialReportStatus.Failed and report.category in {DifferentialReportCategory.ProcessFailure, DifferentialReportCategory.Timeout, DifferentialReportCategory.Crash, DifferentialReportCategory.ArtifactFailure, DifferentialReportCategory.InvalidInput, DifferentialReportCategory.InfrastructureFailure} else 0


        def report_render_junit_skipped_count(report: DifferentialReport&) -> usize:
            return 1 if report.status == DifferentialReportStatus.Skipped or report.status == DifferentialReportStatus.Inconclusive else 0


        def report_render_append_junit_outcome(output: mutable darray[u8]&, report: DifferentialReport&, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            if report.status == DifferentialReportStatus.Passed:
                return
            elif report_render_junit_failure_count(report) != 0:
                try report_render_append_text(output, "      <failure type=", limit)
                category_name: sview = try report_render_category_name(report.category)
                try report_render_append_xml_attribute(output, category_name, limit)
                try report_render_append_text(output, " message=", limit)
                try report_render_append_xml_attribute(output, report.summary, limit)
                try report_render_append_text(output, "/>", limit)
                try report_render_append_byte(output, 10u8, limit)
            elif report_render_junit_error_count(report) != 0:
                try report_render_append_text(output, "      <error type=", limit)
                category_name: sview = try report_render_category_name(report.category)
                try report_render_append_xml_attribute(output, category_name, limit)
                try report_render_append_text(output, " message=", limit)
                try report_render_append_xml_attribute(output, report.summary, limit)
                try report_render_append_text(output, "/>", limit)
                try report_render_append_byte(output, 10u8, limit)
            elif report_render_junit_skipped_count(report) != 0:
                try report_render_append_text(output, "      <skipped message=", limit)
                try report_render_append_xml_attribute(output, report.summary, limit)
                try report_render_append_text(output, "/>", limit)
                try report_render_append_byte(output, 10u8, limit)
            else:
                raise DifferentialReportRenderError.InvalidEnum


        def report_render_append_junit_properties(output: mutable darray[u8]&, report: DifferentialReport&, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            status_name: sview = try report_render_status_name(report.status)
            category_name: sview = try report_render_category_name(report.category)
            comparison_kind_name: sview = try report_render_comparison_kind_name(report.comparison_kind)
            try report_render_append_text(output, "      <properties>", limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_xml_property(output, "elisascript.status", status_name, limit)
            try report_render_append_xml_property(output, "elisascript.category", category_name, limit)
            try report_render_append_xml_property(output, "elisascript.comparison_kind", comparison_kind_name, limit)
            try report_render_append_xml_property_usize(output, "elisascript.comparison_index", report.comparison_index.usize(), limit)
            try report_render_append_xml_property(output, "elisascript.summary", report.summary, limit)
            try report_render_append_xml_property(output, "elisascript.reference_engine", report.reference_engine, limit)
            try report_render_append_xml_property(output, "elisascript.candidate_engine", report.candidate_engine, limit)
            try report_render_append_xml_property(output, "elisascript.reference_detail", report.reference_detail, limit)
            try report_render_append_xml_property(output, "elisascript.candidate_detail", report.candidate_detail, limit)
            reference_detail_omitted: sview = "true" if report.reference_detail_omitted else "false"
            try report_render_append_xml_property(output, "elisascript.reference_detail_omitted", reference_detail_omitted, limit)
            candidate_detail_omitted: sview = "true" if report.candidate_detail_omitted else "false"
            try report_render_append_xml_property(output, "elisascript.candidate_detail_omitted", candidate_detail_omitted, limit)
            try report_render_append_xml_property(output, "elisascript.artifact_path", report.artifact_path, limit)
            try report_render_append_xml_property_usize(output, "elisascript.repeat_count", report.repeat_count, limit)
            deterministic_text: sview = "true" if report.deterministic else "false"
            try report_render_append_xml_property(output, "elisascript.deterministic", deterministic_text, limit)
            evidence_present_text: sview = "true" if report.has_stability_evidence else "false"
            try report_render_append_xml_property(output, "elisascript.has_stability_evidence", evidence_present_text, limit)
            stability_bytes: mutable darray[u8] = []
            if report.has_stability_evidence:
                try report_render_append_stability(stability_bytes, report.stability_evidence, limit)
                try report_render_append_xml_property(output, "elisascript.stability_evidence", sview(stability_bytes.items, 0, stability_bytes.count), limit)
            else:
                try report_render_append_xml_property(output, "elisascript.stability_evidence", "null", limit)
            for index in 0..<report.messages.count |output, report, limit|:
                message_name: mutable darray[u8] = []
                try report_render_append_text(message_name, "elisascript.message.", 64)
                try report_render_append_usize(message_name, index, 64)
                try report_render_append_xml_property(output, sview(message_name.items, 0, message_name.count), report.messages[index], limit)
            try report_render_append_text(output, "      </properties>", limit)
            try report_render_append_byte(output, 10u8, limit)


        def report_render_append_human(report: DifferentialReport&, output: mutable darray[u8]&, limit: usize) -> void error[DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            status_name: sview = try report_render_status_name(report.status)
            category_name: sview = try report_render_category_name(report.category)
            comparison_kind_name: sview = try report_render_comparison_kind_name(report.comparison_kind)
            try report_render_append_text(output, "Differential report", limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "status: ", limit)
            try report_render_append_text(output, status_name, limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "category: ", limit)
            try report_render_append_text(output, category_name, limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "comparison_kind: ", limit)
            try report_render_append_text(output, comparison_kind_name, limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "comparison_index: ", limit)
            try report_render_append_usize(output, report.comparison_index.usize(), limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "case_name: ", limit)
            try report_render_append_json_string(output, report.case_name, limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "summary: ", limit)
            try report_render_append_json_string(output, report.summary, limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "reference_engine: ", limit)
            try report_render_append_json_string(output, report.reference_engine, limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "candidate_engine: ", limit)
            try report_render_append_json_string(output, report.candidate_engine, limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "reference_detail: ", limit)
            try report_render_append_json_string(output, report.reference_detail, limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "reference_detail_omitted: ", limit)
            if report.reference_detail_omitted:
                try report_render_append_text(output, "true", limit)
            else:
                try report_render_append_text(output, "false", limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "candidate_detail: ", limit)
            try report_render_append_json_string(output, report.candidate_detail, limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "candidate_detail_omitted: ", limit)
            if report.candidate_detail_omitted:
                try report_render_append_text(output, "true", limit)
            else:
                try report_render_append_text(output, "false", limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "artifact_path: ", limit)
            try report_render_append_json_string(output, report.artifact_path, limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "repeat_count: ", limit)
            try report_render_append_usize(output, report.repeat_count, limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "deterministic: ", limit)
            if report.deterministic:
                try report_render_append_text(output, "true", limit)
            else:
                try report_render_append_text(output, "false", limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "has_stability_evidence: ", limit)
            if report.has_stability_evidence:
                try report_render_append_text(output, "true", limit)
                try report_render_append_byte(output, 10u8, limit)
                try report_render_append_text(output, "stability_evidence: ", limit)
                try report_render_append_stability(output, report.stability_evidence, limit)
            else:
                try report_render_append_text(output, "false", limit)
                try report_render_append_byte(output, 10u8, limit)
                try report_render_append_text(output, "stability_evidence: null", limit)
            try report_render_append_byte(output, 10u8, limit)
            try report_render_append_text(output, "messages:", limit)
            try report_render_append_byte(output, 10u8, limit)
            for message in report.messages |report, output, limit|:
                try report_render_append_text(output, "  - ", limit)
                try report_render_append_json_string(output, message, limit)
                try report_render_append_byte(output, 10u8, limit)
            try report_render_append_byte(output, 10u8, limit)


    public:
        def render_differential_report_json(report: DifferentialReport&, max_bytes: usize = Limits::MAX_BYTES) -> darray[u8] error[DifferentialReportError, DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialReportRenderError.InvalidLimit if max_bytes == 0 or max_bytes > Limits::MAX_BYTES
            try validate_differential_report(report)
            raise DifferentialReportRenderError.InvalidFormat if report.format != DifferentialReportFormat.Json
            output: mutable darray[u8] = []
            try report_render_append_text(output, "{\"version\":1,\"format\":\"json\",\"status\":", max_bytes)
            status_name: sview = try report_render_status_name(report.status)
            try report_render_append_json_string(output, status_name, max_bytes)
            try report_render_append_text(output, ",\"category\":", max_bytes)
            category_name: sview = try report_render_category_name(report.category)
            try report_render_append_json_string(output, category_name, max_bytes)
            try report_render_append_text(output, ",\"comparison_kind\":", max_bytes)
            comparison_kind_name: sview = try report_render_comparison_kind_name(report.comparison_kind)
            try report_render_append_json_string(output, comparison_kind_name, max_bytes)
            try report_render_append_text(output, ",\"comparison_index\":", max_bytes)
            try report_render_append_usize(output, report.comparison_index.usize(), max_bytes)
            try report_render_append_text(output, ",\"case_name\":", max_bytes)
            try report_render_append_json_string(output, report.case_name, max_bytes)
            try report_render_append_text(output, ",\"summary\":", max_bytes)
            try report_render_append_json_string(output, report.summary, max_bytes)
            try report_render_append_text(output, ",\"reference_engine\":", max_bytes)
            try report_render_append_json_string(output, report.reference_engine, max_bytes)
            try report_render_append_text(output, ",\"candidate_engine\":", max_bytes)
            try report_render_append_json_string(output, report.candidate_engine, max_bytes)
            try report_render_append_text(output, ",\"reference_detail\":", max_bytes)
            try report_render_append_json_string(output, report.reference_detail, max_bytes)
            try report_render_append_text(output, ",\"candidate_detail\":", max_bytes)
            try report_render_append_json_string(output, report.candidate_detail, max_bytes)
            try report_render_append_text(output, ",\"reference_detail_omitted\":", max_bytes)
            try report_render_append_bool(output, report.reference_detail_omitted, max_bytes)
            try report_render_append_text(output, ",\"candidate_detail_omitted\":", max_bytes)
            try report_render_append_bool(output, report.candidate_detail_omitted, max_bytes)
            try report_render_append_text(output, ",\"artifact_path\":", max_bytes)
            try report_render_append_json_string(output, report.artifact_path, max_bytes)
            try report_render_append_text(output, ",\"repeat_count\":", max_bytes)
            try report_render_append_usize(output, report.repeat_count, max_bytes)
            try report_render_append_text(output, ",\"deterministic\":", max_bytes)
            try report_render_append_bool(output, report.deterministic, max_bytes)
            try report_render_append_text(output, ",\"has_stability_evidence\":", max_bytes)
            try report_render_append_bool(output, report.has_stability_evidence, max_bytes)
            try report_render_append_text(output, ",\"stability_evidence\":", max_bytes)
            if report.has_stability_evidence:
                try report_render_append_stability(output, report.stability_evidence, max_bytes)
            else:
                try report_render_append_text(output, "null", max_bytes)
            try report_render_append_text(output, ",\"messages\":[", max_bytes)
            for index in 0..<report.messages.count |output, report, max_bytes|:
                try report_render_append_text(output, "," if index != 0 else "", max_bytes)
                try report_render_append_json_string(output, report.messages[index], max_bytes)
            try report_render_append_text(output, "]}\n", max_bytes)
            return output


        def render_differential_report_human(report: DifferentialReport&, max_bytes: usize = Limits::MAX_BYTES) -> darray[u8] error[DifferentialReportError, DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialReportRenderError.InvalidLimit if max_bytes == 0 or max_bytes > Limits::MAX_BYTES
            try validate_differential_report(report)
            raise DifferentialReportRenderError.InvalidFormat if report.format != DifferentialReportFormat.Human
            output: mutable darray[u8] = []
            try report_render_append_human(report, output, max_bytes)
            return output


        def render_differential_report_junit(report: DifferentialReport&, max_bytes: usize = Limits::MAX_BYTES) -> darray[u8] error[DifferentialReportError, DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialReportRenderError.InvalidLimit if max_bytes == 0 or max_bytes > Limits::MAX_BYTES
            try validate_differential_report(report)
            raise DifferentialReportRenderError.InvalidFormat if report.format != DifferentialReportFormat.Junit
            raise DifferentialReportRenderError.XmlCharacterInvalid if not report_render_xml_fields_valid(report)
            output: mutable darray[u8] = []
            failures: usize = report_render_junit_failure_count(report)
            errors: usize = report_render_junit_error_count(report)
            skipped: usize = report_render_junit_skipped_count(report)
            try report_render_append_text(output, "<?xml version=", max_bytes)
            try report_render_append_xml_attribute(output, "1.0", max_bytes)
            try report_render_append_text(output, " encoding=", max_bytes)
            try report_render_append_xml_attribute(output, "UTF-8", max_bytes)
            try report_render_append_text(output, "?>", max_bytes)
            try report_render_append_byte(output, 10u8, max_bytes)
            try report_render_append_text(output, "<testsuites tests=", max_bytes)
            try report_render_append_xml_attribute(output, "1", max_bytes)
            try report_render_append_text(output, " failures=", max_bytes)
            try report_render_append_xml_attribute_usize(output, failures, max_bytes)
            try report_render_append_text(output, " errors=", max_bytes)
            try report_render_append_xml_attribute_usize(output, errors, max_bytes)
            try report_render_append_text(output, " skipped=", max_bytes)
            try report_render_append_xml_attribute_usize(output, skipped, max_bytes)
            try report_render_append_text(output, ">", max_bytes)
            try report_render_append_byte(output, 10u8, max_bytes)
            try report_render_append_text(output, "  <testsuite name=", max_bytes)
            try report_render_append_xml_attribute(output, "elisascript-differential", max_bytes)
            try report_render_append_text(output, " tests=", max_bytes)
            try report_render_append_xml_attribute(output, "1", max_bytes)
            try report_render_append_text(output, " failures=", max_bytes)
            try report_render_append_xml_attribute_usize(output, failures, max_bytes)
            try report_render_append_text(output, " errors=", max_bytes)
            try report_render_append_xml_attribute_usize(output, errors, max_bytes)
            try report_render_append_text(output, " skipped=", max_bytes)
            try report_render_append_xml_attribute_usize(output, skipped, max_bytes)
            try report_render_append_text(output, ">", max_bytes)
            try report_render_append_byte(output, 10u8, max_bytes)
            try report_render_append_text(output, "    <testcase name=", max_bytes)
            try report_render_append_xml_attribute(output, report.case_name, max_bytes)
            try report_render_append_text(output, " classname=", max_bytes)
            try report_render_append_xml_attribute(output, "differential", max_bytes)
            try report_render_append_text(output, ">", max_bytes)
            try report_render_append_byte(output, 10u8, max_bytes)
            try report_render_append_junit_properties(output, report, max_bytes)
            try report_render_append_junit_outcome(output, report, max_bytes)
            if report.messages.count != 0:
                try report_render_append_text(output, "      <system-out>", max_bytes)
                for index in 0..<report.messages.count |output, report, max_bytes|:
                    if index != 0:
                        try report_render_append_byte(output, 10u8, max_bytes)
                    try report_render_append_xml_escaped(output, report.messages[index], max_bytes)
                try report_render_append_text(output, "</system-out>", max_bytes)
                try report_render_append_byte(output, 10u8, max_bytes)
            try report_render_append_text(output, "    </testcase>", max_bytes)
            try report_render_append_byte(output, 10u8, max_bytes)
            try report_render_append_text(output, "  </testsuite>", max_bytes)
            try report_render_append_byte(output, 10u8, max_bytes)
            try report_render_append_text(output, "</testsuites>", max_bytes)
            try report_render_append_byte(output, 10u8, max_bytes)
            return output


        def render_differential_report(report: DifferentialReport&, max_bytes: usize = Limits::MAX_BYTES) -> darray[u8] error[DifferentialReportError, DifferentialReportRenderError] can[Memory.Allocate, Abort.Panic]:
            raise DifferentialReportRenderError.InvalidLimit if max_bytes == 0 or max_bytes > Limits::MAX_BYTES
            try validate_differential_report(report)
            if report.format == DifferentialReportFormat.Human:
                return try render_differential_report_human(report, max_bytes)
            elif report.format == DifferentialReportFormat.Json:
                return try render_differential_report_json(report, max_bytes)
            elif report.format == DifferentialReportFormat.Junit:
                return try render_differential_report_junit(report, max_bytes)
            raise DifferentialReportRenderError.InvalidEnum
