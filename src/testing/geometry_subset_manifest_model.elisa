# Typed serializer for elisa-engine/scripts/geometry_subset_manifest.py.
# Each accepted expectation is explicit and validated before a tab-separated
# line is emitted for native/geometry_subset_test.cpp.
include "../runtime/python_text_model.elisa"

using EsPythonText


module EsGeometrySubsetManifest:
    public:
        const enum Verdict of u8:
            Accept
            Reject


        struct Subset:
            first_index: u32
            index_count: u32
            material_slot: u32


        struct Material:
            factors: darray[f32]
            alpha_mode: u32
            flags: u32
            texture_indices: darray[u32] = []


        struct TextureSection:
            name: sview
            checksum: u32


        struct ClearcoatFactors:
            factor: f32
            roughness: f32
            normal_scale: f32


        struct Uv1Expectation:
            vertex_count: u32 = 0u32
            source: sview = ""
            resolution: u32 = 0u32
            padding: u32 = 0u32
            chart_count: u32 = 0u32


        struct MeshPlacement:
            mesh: u32
            node: u32
            vertex_start: u32
            vertex_count: u32
            index_start: u32
            index_count: u32
            subset_start: u32
            subset_count: u32
            transform: darray[f32]


        struct Expectation:
            index_count: u32 = 0u32
            material_slots: u32 = 0u32
            subsets: darray[Subset] = []
            has_materials: bool = false
            materials: darray[Material] = []
            has_sections: bool = false
            sections: darray[TextureSection] = []
            has_clearcoat_factors: bool = false
            clearcoat_factors: darray[ClearcoatFactors] = []
            has_slot_names: bool = false
            slot_names: darray[sview] = []
            has_normal_scales: bool = false
            normal_scales: darray[f32] = []
            has_occlusion_strengths: bool = false
            occlusion_strengths: darray[f32] = []
            has_animations: bool = false
            animation_count: u32 = 0u32
            has_morphs: bool = false
            morph_count: u32 = 0u32
            has_cameras: bool = false
            camera_count: u32 = 0u32
            has_lights: bool = false
            light_count: u32 = 0u32
            has_inverse_binds: bool = false
            inverse_bind_values: darray[f32] = []
            has_uv1: bool = false
            uv1: Uv1Expectation = Uv1Expectation{}
            has_mesh_placements: bool = false
            mesh_placements: darray[MeshPlacement] = []


        struct LoaderCase:
            verdict: Verdict
            file_name: sview
            expected_diagnostic: sview = ""
            expectation: Expectation = Expectation{}


        error ManifestError:
            InvalidUtf8
            InvalidMaterialFactorCount
            TooManyMaterialTextureIndices
            InvalidPlacementTransformCount
            TooManyRecords
            LineTooLarge


        def manifest_line(directory: sview, test_case: LoaderCase) -> darray[u8] error[ManifestError] can[Memory.Allocate, Abort.Panic, Console.Format]:
            raise ManifestError.TooManyRecords if test_case.expectation.subsets.count > Limits::MAX_RECORDS
            raise ManifestError.TooManyRecords if test_case.expectation.materials.count > Limits::MAX_RECORDS or test_case.expectation.sections.count > Limits::MAX_RECORDS
            raise ManifestError.TooManyRecords if test_case.expectation.clearcoat_factors.count > Limits::MAX_RECORDS or test_case.expectation.slot_names.count > Limits::MAX_RECORDS
            raise ManifestError.TooManyRecords if test_case.expectation.normal_scales.count > Limits::MAX_RECORDS or test_case.expectation.occlusion_strengths.count > Limits::MAX_RECORDS
            raise ManifestError.TooManyRecords if test_case.expectation.inverse_bind_values.count > Limits::MAX_RECORDS or test_case.expectation.mesh_placements.count > Limits::MAX_RECORDS

            output: mutable darray[u8] = []
            if test_case.verdict == Verdict.Accept:
                try manifest_append_text(output, "accept")
            else:
                try manifest_append_text(output, "reject")
            try manifest_append_byte(output, 9u8)
            try manifest_append_path(output, directory, test_case.file_name)

            if test_case.verdict == Verdict.Reject:
                try manifest_append_byte(output, 9u8)
                try manifest_append_text(output, test_case.expected_diagnostic)
                return output

            expectation: Expectation = test_case.expectation
            try manifest_append_tab_u32(output, expectation.index_count)
            try manifest_append_tab_u32(output, expectation.material_slots)
            for subset in expectation.subsets |output|:
                try manifest_append_tab_u32(output, subset.first_index)
                try manifest_append_tab_u32(output, subset.index_count)
                try manifest_append_tab_u32(output, subset.material_slot)

            if expectation.has_materials:
                try manifest_append_marker(output, "materials")
                for material in expectation.materials |output|:
                    raise ManifestError.InvalidMaterialFactorCount if material.factors.count != Limits::MATERIAL_FACTORS
                    raise ManifestError.TooManyMaterialTextureIndices if material.texture_indices.count > Limits::TEXTURE_REFERENCES
                    for factor in material.factors |output|:
                        try manifest_append_tab_f32(output, factor)
                    try manifest_append_tab_u32(output, material.alpha_mode)
                    try manifest_append_tab_u32(output, material.flags)
                    for texture in material.texture_indices |output|:
                        try manifest_append_tab_u32(output, texture)
                    for _ in material.texture_indices.count..<Limits::TEXTURE_REFERENCES |output|:
                        try manifest_append_tab_u32(output, 0u32)

            if expectation.has_sections:
                try manifest_append_marker(output, "sections")
                for section in expectation.sections |output|:
                    try manifest_append_tab_text(output, section.name)
                    try manifest_append_tab_u32(output, section.checksum)

            if expectation.has_clearcoat_factors:
                try manifest_append_marker(output, "clearcoat_factors")
                for factors in expectation.clearcoat_factors |output|:
                    try manifest_append_tab_f32(output, factors.factor)
                    try manifest_append_tab_f32(output, factors.roughness)
                    try manifest_append_tab_f32(output, factors.normal_scale)

            if expectation.has_slot_names:
                try manifest_append_marker(output, "slot_names")
                for name in expectation.slot_names |output|:
                    try manifest_append_tab_hex_utf8(output, name)

            if expectation.has_normal_scales:
                try manifest_append_marker(output, "normal_scales")
                for value in expectation.normal_scales |output|:
                    try manifest_append_tab_f32(output, value)

            if expectation.has_occlusion_strengths:
                try manifest_append_marker(output, "occlusion_strengths")
                for value in expectation.occlusion_strengths |output|:
                    try manifest_append_tab_f32(output, value)

            if expectation.has_animations:
                try manifest_append_marker(output, "animations")
                try manifest_append_tab_u32(output, expectation.animation_count)
            if expectation.has_morphs:
                try manifest_append_marker(output, "morphs")
                try manifest_append_tab_u32(output, expectation.morph_count)
            if expectation.has_cameras:
                try manifest_append_marker(output, "cameras")
                try manifest_append_tab_u32(output, expectation.camera_count)
            if expectation.has_lights:
                try manifest_append_marker(output, "lights")
                try manifest_append_tab_u32(output, expectation.light_count)

            if expectation.has_inverse_binds:
                try manifest_append_marker(output, "inverse_binds")
                for value in expectation.inverse_bind_values |output|:
                    try manifest_append_tab_f32(output, value)

            if expectation.has_uv1:
                try manifest_append_marker(output, "uv1")
                try manifest_append_tab_u32(output, expectation.uv1.vertex_count)
                try manifest_append_tab_text(output, expectation.uv1.source)
                try manifest_append_tab_u32(output, expectation.uv1.resolution)
                try manifest_append_tab_u32(output, expectation.uv1.padding)
                try manifest_append_tab_u32(output, expectation.uv1.chart_count)

            if expectation.has_mesh_placements:
                try manifest_append_marker(output, "mesh_placements")
                try manifest_append_tab_u32(output, expectation.mesh_placements.count.u32())
                for placement in expectation.mesh_placements |output|:
                    raise ManifestError.InvalidPlacementTransformCount if placement.transform.count != Limits::TRANSFORM_COMPONENTS
                    try manifest_append_tab_u32(output, placement.mesh)
                    try manifest_append_tab_u32(output, placement.node)
                    try manifest_append_tab_u32(output, placement.vertex_start)
                    try manifest_append_tab_u32(output, placement.vertex_count)
                    try manifest_append_tab_u32(output, placement.index_start)
                    try manifest_append_tab_u32(output, placement.index_count)
                    try manifest_append_tab_u32(output, placement.subset_start)
                    try manifest_append_tab_u32(output, placement.subset_count)
                    for value in placement.transform |output|:
                        try manifest_append_tab_f32(output, value)
            return output


    private:
        const module Limits:
            MAX_RECORDS: usize = 65536
            MAX_LINE_BYTES: usize = 1048576
            MATERIAL_FACTORS: usize = 10
            TEXTURE_REFERENCES: usize = 8
            TRANSFORM_COMPONENTS: usize = 12


        const module Hex:
            DIGITS: sview = "0123456789abcdef"


        def manifest_append_byte(output: mutable darray[u8]&, value: u8) -> void error[ManifestError] can[Memory.Allocate, Abort.Panic]:
            raise ManifestError.LineTooLarge if output.count >= Limits::MAX_LINE_BYTES
            output.push(value)


        def manifest_append_text(output: mutable darray[u8]&, value: sview) -> void error[ManifestError] can[Memory.Allocate, Abort.Panic]:
            catch decode_utf8(value):
                ok decoded:
                    _ = decoded
                error failure:
                    _ = failure
                    raise ManifestError.InvalidUtf8
            for byte in value |output|:
                try manifest_append_byte(output, byte)


        def manifest_append_tab_text(output: mutable darray[u8]&, value: sview) -> void error[ManifestError] can[Memory.Allocate, Abort.Panic]:
            try manifest_append_byte(output, 9u8)
            try manifest_append_text(output, value)


        def manifest_append_u32(output: mutable darray[u8]&, value: u32) -> void error[ManifestError] can[Memory.Allocate, Abort.Panic]:
            digits: mutable darray[u8] = []
            remaining: mutable u32 = value
            if remaining == 0u32:
                try manifest_append_byte(output, 48u8)
                return
            while remaining > 0u32:
                digits.push((remaining % 10u32).u8() + 48u8)
                remaining <- remaining / 10u32
            for index in 0..<digits.count |digits, output|:
                try manifest_append_byte(output, digits[digits.count - index - 1])


        def manifest_append_tab_u32(output: mutable darray[u8]&, value: u32) -> void error[ManifestError] can[Memory.Allocate, Abort.Panic]:
            try manifest_append_byte(output, 9u8)
            try manifest_append_u32(output, value)


        def manifest_append_f32(output: mutable darray[u8]&, value: f32) -> void error[ManifestError] can[Memory.Allocate, Abort.Panic, Console.Format]:
            try manifest_append_text(output, format_float(value.f64()))


        def manifest_append_tab_f32(output: mutable darray[u8]&, value: f32) -> void error[ManifestError] can[Memory.Allocate, Abort.Panic, Console.Format]:
            try manifest_append_byte(output, 9u8)
            try manifest_append_f32(output, value)


        def manifest_append_marker(output: mutable darray[u8]&, marker: sview) -> void error[ManifestError] can[Memory.Allocate, Abort.Panic]:
            try manifest_append_byte(output, 9u8)
            try manifest_append_text(output, marker)


        def manifest_append_tab_hex_utf8(output: mutable darray[u8]&, value: sview) -> void error[ManifestError] can[Memory.Allocate, Abort.Panic]:
            catch decode_utf8(value):
                ok decoded:
                    _ = decoded
                error failure:
                    _ = failure
                    raise ManifestError.InvalidUtf8
            try manifest_append_byte(output, 9u8)
            for byte in value |output|:
                try manifest_append_byte(output, sview_at(Hex::DIGITS, (byte >> 4).usize()))
                try manifest_append_byte(output, sview_at(Hex::DIGITS, (byte & 15u8).usize()))


        def manifest_append_path(output: mutable darray[u8]&, directory: sview, file_name: sview) -> void error[ManifestError] can[Memory.Allocate, Abort.Panic]:
            directory_length: usize = sview_len(directory)
            file_length: usize = sview_len(file_name)
            if file_length > 0 and sview_at(file_name, 0) == 47u8:
                try manifest_append_text(output, file_name)
                return
            if directory == "." or directory_length == 0:
                if file_length > 0:
                    try manifest_append_text(output, file_name)
                else:
                    try manifest_append_byte(output, 46u8)
                return
            directory_end: mutable usize = directory_length
            while directory_end > 1 and sview_at(directory, directory_end - 1) == 47u8:
                directory_end <- directory_end - 1
            try manifest_append_text(output, directory[0:directory_end])
            if file_length > 0 and sview_at(directory, directory_end - 1) != 47u8:
                try manifest_append_byte(output, 47u8)
            if file_length > 0:
                try manifest_append_text(output, file_name)
