# Connect typed geometry fixture specifications to the cooked-package
# serializer; the engine loader/case runner remains an adapter responsibility.
include "geometry_subset_normal_scale_cases.elisa"
include "geometry_subset_occlusion_strength_cases.elisa"
include "geometry_subset_clearcoat_cases.elisa"
include "geometry_subset_partition_cases.elisa"
include "geometry_subset_material_cases.elisa"
include "geometry_subset_texture_cases.elisa"
include "geometry_subset_meshopt_cases.elisa"
include "geometry_subset_scene_cases.elisa"
include "geometry_subset_hierarchy_cases.elisa"
include "geometry_subset_morph_cases.elisa"
include "geometry_subset_uv1_cases.elisa"
include "geometry_subset_deformation_cases.elisa"
include "geometry_subset_manifest_model.elisa"
include "../../ports/elisa-engine/scripts/geometry_subset_package_builder_model.elisa"

using EsEngineGeometrySubsetPackageBuilder
using EsGeometrySubsetPartitionCases
using EsGeometrySubsetMaterialCases
using EsGeometrySubsetTextureCases
using EsGeometrySubsetMeshoptCases
using EsGeometrySubsetSceneCases
using EsGeometrySubsetHierarchyCases
using EsGeometrySubsetMorphCases
using EsGeometrySubsetUv1Cases
using EsGeometrySubsetDeformationCases


module EsGeometrySubsetPackageCases:
    public:
        const enum Verdict of u8:
            Accept
            Reject


        struct GeneratedCase:
            verdict: Verdict
            file_name: sview
            package_bytes: darray[u8]
            expected_diagnostic: sview
            loader_expectation: EsGeometrySubsetManifest::Expectation


        # Order matches geometry_subset_cases.py: normal-scale, occlusion,
        # then clearcoat cases.
        def sidecar_packages() -> darray[GeneratedCase] error[StripPackageError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            generated: mutable darray[GeneratedCase] = []
            normal_scale_cases: darray[EsGeometrySubsetNormalScaleCases::Case] = EsGeometrySubsetNormalScaleCases::cases()
            for source in normal_scale_cases |generated|:
                package_input: StripPackageInput = normal_scale_input(source)
                try package_emit(generated, package_verdict(source.verdict == EsGeometrySubsetNormalScaleCases::Verdict::Accept), source.file_name, package_input, source.expected_diagnostic)

            occlusion_cases: darray[EsGeometrySubsetOcclusionStrengthCases::Case] = EsGeometrySubsetOcclusionStrengthCases::cases()
            for source in occlusion_cases |generated|:
                package_input: StripPackageInput = occlusion_input(source)
                try package_emit(generated, package_verdict(source.verdict == EsGeometrySubsetOcclusionStrengthCases::Verdict::Accept), source.file_name, package_input, source.expected_diagnostic)

            clearcoat_cases: darray[EsGeometrySubsetClearcoatCases::Case] = EsGeometrySubsetClearcoatCases::cases()
            for source in clearcoat_cases |generated|:
                package_input: StripPackageInput = clearcoat_input(source)
                try package_emit(generated, package_verdict(source.verdict == EsGeometrySubsetClearcoatCases::Verdict::Accept), source.file_name, package_input, source.expected_diagnostic)
            return generated


        # Compose partition, material/name, material-sidecar, and texture-record fixtures.
        # Asset-cooker cases are added by a later integration layer.
        def geometry_packages() -> darray[GeneratedCase] error[StripPackageError] can[Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            generated: mutable darray[GeneratedCase] = []
            partition_cases: darray[EsGeometrySubsetPartitionCases::Case] = EsGeometrySubsetPartitionCases::cases()
            for source in partition_cases |generated|:
                try package_emit(generated, package_verdict(source.verdict == EsGeometrySubsetPartitionCases::Verdict::Accept), source.file_name, source.input, source.expected_diagnostic)

            material_cases: darray[EsGeometrySubsetMaterialCases::Case] = EsGeometrySubsetMaterialCases::cases()
            for source in material_cases |generated|:
                package_input: StripPackageInput = material_input(source)
                try package_emit(generated, package_verdict(source.verdict == EsGeometrySubsetMaterialCases::Verdict::Accept), source.file_name, package_input, source.expected_diagnostic)

            sidecars: darray[GeneratedCase] = try sidecar_packages()
            for source in sidecars |generated|:
                generated.push(source)

            texture_cases: darray[EsGeometrySubsetTextureCases::Case] = EsGeometrySubsetTextureCases::cases()
            for source in texture_cases |generated|:
                package_input: StripPackageInput = texture_input(source)
                try package_emit(generated, package_verdict(source.verdict == EsGeometrySubsetTextureCases::Verdict::Accept), source.file_name, package_input, source.expected_diagnostic)
            return generated


        # Extend the currently ported cooked-package slice with the standalone
        # skin/morph cases. The full Python aggregator's interleaved ordering
        # remains an integration task for its asset-cooker adapter.
        def geometry_packages_with_deformation(morph_package: sview, skin_package: sview) -> darray[GeneratedCase] error[StripPackageError, DeformationCasesError] can[Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            generated: mutable darray[GeneratedCase] = try geometry_packages()
            deformation_cases: darray[EsGeometrySubsetDeformationCases::Case] = try EsGeometrySubsetDeformationCases::cases(morph_package, skin_package)
            for source in deformation_cases |generated|:
                generated.push(GeneratedCase{
                    verdict: Verdict.Reject,
                    file_name: source.file_name,
                    package_bytes: source.package_bytes,
                    expected_diagnostic: source.expected_diagnostic,
                    loader_expectation: EsGeometrySubsetManifest::Expectation{}
                })
            return generated


        # Add cooker-derived meshoptimizer rejection variants to the current
        # typed slice. Full Python aggregator ordering still awaits its asset
        # cooker adapter.
        def geometry_packages_with_meshopt(compressed_package: sview, raw_positions_base64: sview) -> darray[GeneratedCase] error[StripPackageError, EsGeometrySubsetMeshoptCases::MeshoptCasesError] can[Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            generated: mutable darray[GeneratedCase] = try geometry_packages()
            meshopt_cases: darray[EsGeometrySubsetMeshoptCases::Case] = try EsGeometrySubsetMeshoptCases::cases(compressed_package, raw_positions_base64)
            for source in meshopt_cases |generated|:
                generated.push(GeneratedCase{
                    verdict: Verdict.Reject,
                    file_name: source.file_name,
                    package_bytes: source.package_bytes,
                    expected_diagnostic: source.expected_diagnostic,
                    loader_expectation: EsGeometrySubsetManifest::Expectation{}
                })
            return generated


        # Add the three cooker-derived scene rejection variants to the current
        # typed slice; source acquisition and full aggregator order remain in
        # the asset-cooker integration layer.
        def geometry_packages_with_scene_variants(scene_package: sview) -> darray[GeneratedCase] error[StripPackageError, EsGeometrySubsetSceneCases::SceneCasesError] can[Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            generated: mutable darray[GeneratedCase] = try geometry_packages()
            scene_cases: darray[EsGeometrySubsetSceneCases::Case] = try EsGeometrySubsetSceneCases::cases(scene_package)
            for source in scene_cases |generated|:
                generated.push(GeneratedCase{
                    verdict: Verdict.Reject,
                    file_name: source.file_name,
                    package_bytes: source.package_bytes,
                    expected_diagnostic: source.expected_diagnostic,
                    loader_expectation: EsGeometrySubsetManifest::Expectation{}
                })
            return generated


        # Add the cooker-derived mesh-placement rejection variants to the
        # current typed slice; full aggregator ordering remains an adapter task.
        def geometry_packages_with_hierarchy(hierarchy_package: sview) -> darray[GeneratedCase] error[StripPackageError, EsGeometrySubsetHierarchyCases::HierarchyCasesError] can[Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            generated: mutable darray[GeneratedCase] = try geometry_packages()
            hierarchy_cases: darray[EsGeometrySubsetHierarchyCases::Case] = try EsGeometrySubsetHierarchyCases::cases(hierarchy_package)
            for source in hierarchy_cases |generated|:
                generated.push(GeneratedCase{
                    verdict: Verdict.Reject,
                    file_name: source.file_name,
                    package_bytes: source.package_bytes,
                    expected_diagnostic: source.expected_diagnostic,
                    loader_expectation: EsGeometrySubsetManifest::Expectation{}
                })
            return generated


        # Add direct morph metadata mutations to the current typed slice.
        def geometry_packages_with_morph_variants(morph_package: sview) -> darray[GeneratedCase] error[StripPackageError, EsGeometrySubsetMorphCases::MorphCasesError] can[Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            generated: mutable darray[GeneratedCase] = try geometry_packages()
            morph_cases: darray[EsGeometrySubsetMorphCases::Case] = try EsGeometrySubsetMorphCases::cases(morph_package)
            for source in morph_cases |generated|:
                generated.push(GeneratedCase{
                    verdict: Verdict.Reject,
                    file_name: source.file_name,
                    package_bytes: source.package_bytes,
                    expected_diagnostic: source.expected_diagnostic,
                    loader_expectation: EsGeometrySubsetManifest::Expectation{}
                })
            return generated


        # Append the six UV1 loader-rejection variants. The atlas and its
        # out-of-range encoded stream are supplied by the cooker adapter.
        def geometry_packages_with_uv1(atlas_package: sview, invalid_uv1_stream_base64: sview) -> darray[GeneratedCase] error[StripPackageError, EsGeometrySubsetUv1Cases::Uv1CasesError] can[Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            generated: mutable darray[GeneratedCase] = try geometry_packages()
            uv1_cases: darray[EsGeometrySubsetUv1Cases::Case] = try EsGeometrySubsetUv1Cases::cases(atlas_package, invalid_uv1_stream_base64)
            for source in uv1_cases |generated|:
                generated.push(GeneratedCase{
                    verdict: Verdict.Reject,
                    file_name: source.file_name,
                    package_bytes: source.package_bytes,
                    expected_diagnostic: source.expected_diagnostic,
                    loader_expectation: EsGeometrySubsetManifest::Expectation{}
                })
            return generated


        # Compose every cooker-derived malformed geometry slice into one
        # bounded staging input. The base aggregator's cross-family placement
        # remains incomplete until its asset-cooker adapter is ported.
        def geometry_packages_with_cooked_variants(compressed_package: sview, raw_positions_base64: sview, morph_package: sview, skin_package: sview, scene_package: sview, hierarchy_package: sview) -> darray[GeneratedCase] error[StripPackageError, EsGeometrySubsetMeshoptCases::MeshoptCasesError, EsGeometrySubsetDeformationCases::DeformationCasesError, EsGeometrySubsetSceneCases::SceneCasesError, EsGeometrySubsetHierarchyCases::HierarchyCasesError, EsGeometrySubsetMorphCases::MorphCasesError] can[Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            generated: mutable darray[GeneratedCase] = try geometry_packages()

            meshopt_cases: darray[EsGeometrySubsetMeshoptCases::Case] = try EsGeometrySubsetMeshoptCases::cases(compressed_package, raw_positions_base64)
            for source in meshopt_cases |generated|:
                generated.push(GeneratedCase{
                    verdict: Verdict.Reject,
                    file_name: source.file_name,
                    package_bytes: source.package_bytes,
                    expected_diagnostic: source.expected_diagnostic,
                    loader_expectation: EsGeometrySubsetManifest::Expectation{}
                })

            deformation_cases: darray[EsGeometrySubsetDeformationCases::Case] = try EsGeometrySubsetDeformationCases::cases(morph_package, skin_package)
            for source in deformation_cases |generated|:
                generated.push(GeneratedCase{
                    verdict: Verdict.Reject,
                    file_name: source.file_name,
                    package_bytes: source.package_bytes,
                    expected_diagnostic: source.expected_diagnostic,
                    loader_expectation: EsGeometrySubsetManifest::Expectation{}
                })

            scene_cases: darray[EsGeometrySubsetSceneCases::Case] = try EsGeometrySubsetSceneCases::cases(scene_package)
            for source in scene_cases |generated|:
                generated.push(GeneratedCase{
                    verdict: Verdict.Reject,
                    file_name: source.file_name,
                    package_bytes: source.package_bytes,
                    expected_diagnostic: source.expected_diagnostic,
                    loader_expectation: EsGeometrySubsetManifest::Expectation{}
                })

            hierarchy_cases: darray[EsGeometrySubsetHierarchyCases::Case] = try EsGeometrySubsetHierarchyCases::cases(hierarchy_package)
            for source in hierarchy_cases |generated|:
                generated.push(GeneratedCase{
                    verdict: Verdict.Reject,
                    file_name: source.file_name,
                    package_bytes: source.package_bytes,
                    expected_diagnostic: source.expected_diagnostic,
                    loader_expectation: EsGeometrySubsetManifest::Expectation{}
                })

            morph_cases: darray[EsGeometrySubsetMorphCases::Case] = try EsGeometrySubsetMorphCases::cases(morph_package)
            for source in morph_cases |generated|:
                generated.push(GeneratedCase{
                    verdict: Verdict.Reject,
                    file_name: source.file_name,
                    package_bytes: source.package_bytes,
                    expected_diagnostic: source.expected_diagnostic,
                    loader_expectation: EsGeometrySubsetManifest::Expectation{}
                })
            return generated


        # Emit the exact newline-terminated TSV stream consumed by the native
        # geometry loader test. The caller stages each GeneratedCase package
        # at directory/file_name before invoking the loader.
        def sidecar_manifest_lines(directory: sview) -> darray[u8] error[StripPackageError, EsGeometrySubsetManifest::ManifestError] can[Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast]:
            generated: darray[GeneratedCase] = try sidecar_packages()
            return try sidecar_manifest_lines_for(directory, generated)


        def sidecar_manifest_lines_for(directory: sview, generated: darray[GeneratedCase]) -> darray[u8] error[EsGeometrySubsetManifest::ManifestError] can[Memory.Allocate, Abort.Panic, Console.Format]:
            output: mutable darray[u8] = []
            for generated_case in generated |output|:
                manifest_case: EsGeometrySubsetManifest::LoaderCase = EsGeometrySubsetManifest::LoaderCase{
                    verdict: package_manifest_verdict(generated_case.verdict),
                    file_name: generated_case.file_name,
                    expected_diagnostic: generated_case.expected_diagnostic,
                    expectation: generated_case.loader_expectation
                }
                line: darray[u8] = try EsGeometrySubsetManifest::manifest_line(directory, manifest_case)
                for byte in line |output|:
                    output.push(byte)
                output.push(10u8)
            return output


    private:
        const module Paint:
            BASE_R: f32 = 0.08f32
            BASE_G: f32 = 0.0f32
            BASE_B: f32 = 0.0f32
            BASE_A: f32 = 1.0f32
            METALLIC: f32 = 0.25f32
            ROUGHNESS: f32 = 0.75f32
            EMISSIVE_R: f32 = 1.0f32
            EMISSIVE_G: f32 = 0.0f32
            EMISSIVE_B: f32 = 0.0f32
            ALPHA_CUTOFF: f32 = 0.5f32


        const module NumberBits:
            QUIET_NAN: u32 = 0x7fc00000u32
            POSITIVE_INFINITY: u32 = 0x7f800000u32


        def package_verdict(accepted: bool) -> Verdict:
            return Verdict.Accept if accepted else Verdict.Reject


        def package_manifest_verdict(verdict: Verdict) -> EsGeometrySubsetManifest::Verdict:
            return EsGeometrySubsetManifest::Verdict::Accept if verdict == Verdict.Accept
            return EsGeometrySubsetManifest::Verdict::Reject


        def package_case_omits(omitted_fields: darray[sview], key: sview) -> bool:
            for field in omitted_fields |key|:
                return true if field == key
            return false


        def package_paint_records(record_count: u32) -> darray[MaterialRecord] can[Memory.Allocate, Abort.Panic]:
            records: mutable darray[MaterialRecord] = []
            paint: MaterialRecord = MaterialRecord{
                factors: [Paint::BASE_R, Paint::BASE_G, Paint::BASE_B, Paint::BASE_A,
                    Paint::METALLIC, Paint::ROUGHNESS, Paint::EMISSIVE_R, Paint::EMISSIVE_G,
                    Paint::EMISSIVE_B, Paint::ALPHA_CUTOFF],
                tag0: 0u32,
                tag1: 1u32
            }
            for _ in 0..<record_count |records|:
                records.push(paint)
            return records


        def package_float_from_bits(bits: u32) -> f32 can[Unsafe.PointerCast]:
            value: mutable f32 = 0.0f32
            _ = memcpy((&value).cast[mutable void&], (&bits).cast[void&], 4)
            return value


        def normal_scale_number(value: EsGeometrySubsetNormalScaleCases::NumberValue) -> f32 can[Unsafe.PointerCast]:
            return package_float_from_bits(NumberBits::QUIET_NAN) if value.kind == EsGeometrySubsetNormalScaleCases::NumberKind::NaN
            return package_float_from_bits(NumberBits::POSITIVE_INFINITY) if value.kind == EsGeometrySubsetNormalScaleCases::NumberKind::PositiveInfinity
            return value.finite_value.f32()


        def occlusion_number(value: EsGeometrySubsetOcclusionStrengthCases::NumberValue) -> f32 can[Unsafe.PointerCast]:
            return package_float_from_bits(NumberBits::QUIET_NAN) if value.kind == EsGeometrySubsetOcclusionStrengthCases::NumberKind::NaN
            return package_float_from_bits(NumberBits::POSITIVE_INFINITY) if value.kind == EsGeometrySubsetOcclusionStrengthCases::NumberKind::PositiveInfinity
            return value.finite_value.f32()


        def clearcoat_number(value: EsGeometrySubsetClearcoatCases::NumberValue) -> f32 can[Unsafe.PointerCast]:
            return package_float_from_bits(NumberBits::QUIET_NAN) if value.kind == EsGeometrySubsetClearcoatCases::NumberKind::NaN
            return value.finite_value.f32()


        def normal_scale_input(source: EsGeometrySubsetNormalScaleCases::Case) -> StripPackageInput can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            subsets: mutable darray[Subset] = []
            for subset in source.subsets |subsets|:
                subsets.push(Subset{
                    first_index: subset.first_index,
                    index_count: subset.index_count,
                    material_slot: subset.material_slot
                })
            normal_scales: mutable darray[f32] = []
            for value in source.normal_scales |normal_scales|:
                normal_scales.push(normal_scale_number(value))
            omitted: mutable darray[sview] = []
            if not source.has_normal_scale_data_field:
                omitted.push("slot_normal_scales_b64")
            return StripPackageInput{
                triangle_count: source.triangle_count,
                has_subsets: true,
                subsets: subsets,
                has_material_slots: true,
                material_slots: source.material_slots,
                has_materials: source.has_material_records,
                materials: package_paint_records(source.material_record_count),
                has_normal_scales: true,
                normal_scales: normal_scales,
                normal_scale_stride: source.normal_scale_stride,
                omitted_fields: omitted
            }


        def occlusion_input(source: EsGeometrySubsetOcclusionStrengthCases::Case) -> StripPackageInput can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            subsets: mutable darray[Subset] = []
            for subset in source.subsets |subsets|:
                subsets.push(Subset{
                    first_index: subset.first_index,
                    index_count: subset.index_count,
                    material_slot: subset.material_slot
                })
            strengths: mutable darray[f32] = []
            for value in source.occlusion_strengths |strengths|:
                strengths.push(occlusion_number(value))
            omitted: mutable darray[sview] = []
            if not source.has_occlusion_strength_data_field:
                omitted.push("slot_occlusion_strengths_b64")
            return StripPackageInput{
                triangle_count: source.triangle_count,
                has_subsets: true,
                subsets: subsets,
                has_material_slots: true,
                material_slots: source.material_slots,
                has_materials: source.has_material_records,
                materials: package_paint_records(source.material_record_count),
                has_occlusion_strengths: true,
                occlusion_strengths: strengths,
                occlusion_strength_stride: source.occlusion_strength_stride,
                omitted_fields: omitted
            }


        def clearcoat_input(source: EsGeometrySubsetClearcoatCases::Case) -> StripPackageInput can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            subsets: mutable darray[Subset] = []
            for subset in source.subsets |subsets|:
                subsets.push(Subset{
                    first_index: subset.first_index,
                    index_count: subset.index_count,
                    material_slot: subset.material_slot
                })
            factors: mutable darray[ClearcoatRecord] = []
            for value in source.clearcoat_factors |factors|:
                factors.push(ClearcoatRecord{
                    factor: clearcoat_number(value.factor),
                    roughness: clearcoat_number(value.roughness),
                    normal_scale: clearcoat_number(value.normal_scale)
                })
            omitted: mutable darray[sview] = []
            if not source.has_clearcoat_factor_data_field:
                omitted.push("slot_clearcoat_factors_b64")
            return StripPackageInput{
                triangle_count: source.triangle_count,
                has_subsets: true,
                subsets: subsets,
                has_material_slots: true,
                material_slots: source.material_slots,
                has_materials: source.has_material_records,
                materials: package_paint_records(source.material_record_count),
                has_clearcoat_factors: true,
                clearcoat_factors: factors,
                clearcoat_factor_stride: source.clearcoat_factor_stride,
                omitted_fields: omitted
            }


        def material_input(source: EsGeometrySubsetMaterialCases::Case) -> StripPackageInput can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            subsets: mutable darray[Subset] = []
            for subset in source.subsets |subsets|:
                subsets.push(Subset{
                    first_index: subset.first_index,
                    index_count: subset.index_count,
                    material_slot: subset.material_slot
                })
            records: mutable darray[MaterialRecord] = []
            for record in source.materials |records|:
                factors: mutable darray[f32] = []
                for value in record.factors |factors|:
                    factors.push(material_number(value))
                records.push(MaterialRecord{
                    factors: factors,
                    tag0: record.alpha_mode,
                    tag1: record.flags
                })
            return StripPackageInput{
                triangle_count: source.triangle_count,
                has_subsets: source.has_subsets,
                subsets: subsets,
                has_material_slots: source.has_material_slots,
                material_slots: source.material_slots,
                has_materials: source.has_material_records,
                materials: records,
                material_stride: source.material_stride,
                omitted_fields: source.omitted_fields,
                has_material_names: source.material_names.count > 0,
                material_names: source.material_names,
                has_material_name_payload: source.has_material_name_payload,
                material_name_payload: source.material_name_payload,
                skinned: source.skinned
            }


        def texture_input(source: EsGeometrySubsetTextureCases::Case) -> StripPackageInput can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            subsets: darray[Subset] = [
                Subset{first_index: 0u32, index_count: 3u32, material_slot: 0u32},
                Subset{first_index: 3u32, index_count: 3u32, material_slot: 1u32}
            ]
            materials: mutable darray[MaterialRecord] = []
            for material in source.materials |materials|:
                materials.push(MaterialRecord{
                    factors: material.factors,
                    tag0: material.alpha_mode,
                    tag1: material.flags
                })
            references: mutable darray[TextureReference] = []
            for reference in source.references |references|:
                references.push(TextureReference{values: reference.values})
            return StripPackageInput{
                triangle_count: 2u32,
                has_subsets: true,
                subsets: subsets,
                has_material_slots: true,
                material_slots: 2u32,
                has_materials: source.has_material_records,
                materials: materials,
                omitted_fields: source.omitted_fields,
                has_textures: true,
                textures: TextureTable{
                    names: source.texture_names,
                    references: references,
                    has_count_override: source.has_texture_count_override,
                    count_override: source.texture_count_override,
                    stride: source.texture_stride
                }
            }


        def package_emit(output: mutable darray[GeneratedCase]&, verdict: Verdict, file_name: sview, input: StripPackageInput, expected_diagnostic: sview) -> void error[StripPackageError] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            package: darray[u8] = try EsEngineGeometrySubsetPackageBuilder::strip_package(input)
            expectation: EsGeometrySubsetManifest::Expectation = package_loader_expectation(input)
            output.push(GeneratedCase{
                verdict: verdict,
                file_name: file_name,
                package_bytes: package,
                expected_diagnostic: expected_diagnostic,
                loader_expectation: expectation
            })


        def package_loader_expectation(input: StripPackageInput) -> EsGeometrySubsetManifest::Expectation can[Memory.Allocate, Abort.Panic]:
            subsets: mutable darray[EsGeometrySubsetManifest::Subset] = []
            for subset in input.subsets |subsets|:
                subsets.push(EsGeometrySubsetManifest::Subset{
                    first_index: subset.first_index,
                    index_count: subset.index_count,
                    material_slot: subset.material_slot
                })
            expected_material_slots: u32 = input.material_slots if input.has_subsets else 1u32
            if not input.has_subsets:
                subsets.push(EsGeometrySubsetManifest::Subset{
                    first_index: 0u32,
                    index_count: input.triangle_count * 3u32,
                    material_slot: 0u32
                })
            materials: mutable darray[EsGeometrySubsetManifest::Material] = []
            for material in input.materials |materials|:
                materials.push(EsGeometrySubsetManifest::Material{
                    factors: material.factors,
                    alpha_mode: material.tag0,
                    flags: material.tag1
                })
            clearcoat: mutable darray[EsGeometrySubsetManifest::ClearcoatFactors] = []
            for factors in input.clearcoat_factors |clearcoat|:
                clearcoat.push(EsGeometrySubsetManifest::ClearcoatFactors{
                    factor: factors.factor,
                    roughness: factors.roughness,
                    normal_scale: factors.normal_scale
                })
            has_normal_scale_data: bool = input.has_normal_scales and not package_case_omits(input.omitted_fields, "slot_normal_scales_b64")
            has_occlusion_data: bool = input.has_occlusion_strengths and not package_case_omits(input.omitted_fields, "slot_occlusion_strengths_b64")
            has_clearcoat_data: bool = input.has_clearcoat_factors and not package_case_omits(input.omitted_fields, "slot_clearcoat_factors_b64")
            has_slot_name_data: bool = input.has_material_names and not package_case_omits(input.omitted_fields, "slot_material_names_b64")
            return EsGeometrySubsetManifest::Expectation{
                index_count: input.triangle_count * 3u32,
                material_slots: expected_material_slots,
                subsets: subsets,
                has_materials: input.has_materials and not package_case_omits(input.omitted_fields, "slot_materials_b64"),
                materials: materials,
                has_slot_names: has_slot_name_data,
                slot_names: input.material_names,
                has_clearcoat_factors: has_clearcoat_data,
                clearcoat_factors: clearcoat,
                has_normal_scales: has_normal_scale_data,
                normal_scales: input.normal_scales,
                has_occlusion_strengths: has_occlusion_data,
                occlusion_strengths: input.occlusion_strengths
            }


        def material_number(value: EsGeometrySubsetMaterialCases::NumberValue) -> f32 can[Unsafe.PointerCast]:
            return package_float_from_bits(NumberBits::QUIET_NAN) if value.kind == EsGeometrySubsetMaterialCases::NumberKind.NaN
            return package_float_from_bits(NumberBits::POSITIVE_INFINITY) if value.kind == EsGeometrySubsetMaterialCases::NumberKind.PositiveInfinity
            return value.finite_value.f32()
