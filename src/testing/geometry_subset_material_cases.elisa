# Typed fixture descriptions for the material/slot-name cases in
# elisa-engine/scripts/geometry_subset_cases.py.

module EsGeometrySubsetMaterialCases:
    public:
        const enum Verdict of u8:
            Accept
            Reject


        const enum NumberKind of u8:
            Finite
            NaN
            PositiveInfinity


        struct NumberValue:
            kind: NumberKind
            finite_value: f64 = 0.0


        struct Subset:
            first_index: u32
            index_count: u32
            material_slot: u32


        struct Material:
            factors: darray[NumberValue]
            alpha_mode: u32
            flags: u32


        struct Case:
            verdict: Verdict
            file_name: sview
            triangle_count: u32 = 2u32
            has_subsets: bool = true
            subsets: darray[Subset] = []
            has_material_slots: bool = true
            material_slots: u32 = 2u32
            has_material_records: bool = true
            materials: darray[Material] = []
            material_stride: sview = "48"
            omitted_fields: darray[sview] = []
            material_names: darray[sview] = []
            has_material_name_payload: bool = false
            material_name_payload: darray[u8] = []
            skinned: bool = false
            expected_diagnostic: sview = ""


        def cases() -> darray[Case] can[Memory.Allocate, Abort.Panic]:
            two: darray[Subset] = [
                Subset{first_index: 0u32, index_count: 3u32, material_slot: 0u32},
                Subset{first_index: 3u32, index_count: 3u32, material_slot: 1u32}
            ]
            one: darray[Subset] = [Subset{first_index: 0u32, index_count: 6u32, material_slot: 0u32}]
            glass_record: Material = material(
                [finite(0.0), finite(0.0), finite(0.08), finite(0.5), finite(0.0), finite(0.9), finite(0.0), finite(0.0), finite(1.0), finite(0.5)],
                2u32, 0u32)
            paint_record: Material = material(
                [finite(0.08), finite(0.0), finite(0.0), finite(1.0), finite(0.25), finite(0.75), finite(1.0), finite(0.0), finite(0.0), finite(0.5)],
                0u32, 1u32)
            zeros_record: Material = material(
                [finite(0.0), finite(0.0), finite(0.0), finite(0.0), finite(0.0), finite(0.0), finite(0.0), finite(0.0), finite(0.0), finite(0.0)],
                0u32, 0u32)
            ones_record: Material = material(
                [finite(1.0), finite(1.0), finite(1.0), finite(1.0), finite(1.0), finite(1.0), finite(1.0), finite(1.0), finite(1.0), finite(1.0)],
                2u32, 1u32)

            return [
                material_case(Verdict.Accept, "materials.pkg", [glass_record, paint_record], "", subsets: two),
                material_case(Verdict.Accept, "material-names.pkg", [glass_record, paint_record], "", subsets: two, material_names: ["First", "Second"]),
                material_case(Verdict.Accept, "single-material.pkg", [paint_record], "", subsets: one, material_slots: 1u32),
                material_case(Verdict.Accept, "material-bounds.pkg", [zeros_record, ones_record], "", subsets: two),
                material_case(Verdict.Reject, "materials-without-subsets.pkg", [paint_record], Messages::MATERIAL_RECORDS, has_subsets: false),
                material_case(Verdict.Reject, "material-names-without-materials.pkg", [], Messages::MATERIAL_NAMES,
                    subsets: two, has_material_records: false, has_material_name_payload: true),
                material_case(Verdict.Reject, "material-names-truncated.pkg", [glass_record, paint_record], Messages::MATERIAL_NAMES,
                    subsets: two, has_material_name_payload: true, material_name_payload: [4u8, 0u8]),
                material_case(Verdict.Reject, "material-name-too-long.pkg", [glass_record, paint_record], Messages::MATERIAL_NAME,
                    subsets: two, has_material_name_payload: true, material_name_payload: too_long_name_payload()),
                material_case(Verdict.Reject, "material-name-invalid-utf8.pkg", [glass_record, paint_record], Messages::MATERIAL_NAME,
                    subsets: two, has_material_name_payload: true,
                    material_name_payload: [2u8, 0u8, 0u8, 0u8, 192u8, 175u8, 0u8, 0u8, 0u8, 0u8]),
                material_case(Verdict.Reject, "material-name-nul.pkg", [glass_record, paint_record], Messages::MATERIAL_NAME,
                    subsets: two, has_material_name_payload: true,
                    material_name_payload: [1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]),
                material_case(Verdict.Reject, "material-names-trailing.pkg", [glass_record, paint_record], Messages::MATERIAL_NAMES,
                    subsets: two, has_material_name_payload: true,
                    material_name_payload: [1u8, 0u8, 0u8, 0u8, 97u8, 1u8, 0u8, 0u8, 0u8, 98u8, 120u8]),
                material_case(Verdict.Accept, "skinned-materials.pkg", [paint_record], "", subsets: one,
                    material_slots: 1u32, skinned: true),
                material_case(Verdict.Reject, "material-stride.pkg", [glass_record, paint_record], Messages::MATERIAL_RECORDS,
                    subsets: two, material_stride: "44"),
                material_case(Verdict.Reject, "material-no-stride.pkg", [glass_record, paint_record], Messages::MATERIAL_RECORDS,
                    subsets: two, omitted_fields: ["slot_material_stride"]),
                material_case(Verdict.Reject, "material-no-records.pkg", [glass_record, paint_record], Messages::MATERIAL_RECORDS,
                    subsets: two, omitted_fields: ["slot_materials_b64"]),
                material_case(Verdict.Reject, "material-short.pkg", [glass_record], Messages::MATERIAL_RECORDS, subsets: two),
                material_case(Verdict.Reject, "material-long.pkg", [glass_record, paint_record, paint_record], Messages::MATERIAL_RECORDS, subsets: two),
                material_case(Verdict.Reject, "material-above-one.pkg", [glass_record, with_factor(paint_record, 0u32, finite(1.5))], Messages::MATERIAL_RANGE, subsets: two),
                material_case(Verdict.Reject, "material-negative.pkg", [with_factor(glass_record, 5u32, finite(-0.25)), paint_record], Messages::MATERIAL_RANGE, subsets: two),
                material_case(Verdict.Reject, "material-nan.pkg", [glass_record, with_factor(paint_record, 4u32, nan())], Messages::MATERIAL_RANGE, subsets: two),
                material_case(Verdict.Reject, "material-infinite.pkg", [glass_record, with_factor(paint_record, 8u32, positive_infinity())], Messages::MATERIAL_RANGE, subsets: two),
                material_case(Verdict.Reject, "material-cutoff.pkg", [glass_record, with_factor(paint_record, 9u32, finite(1.5))], Messages::MATERIAL_RANGE, subsets: two),
                material_case(Verdict.Reject, "material-mask.pkg", [with_alpha_mode(glass_record, 1u32), paint_record], Messages::NEEDS_TEXTURE, subsets: two),
                material_case(Verdict.Reject, "material-mode.pkg", [with_alpha_mode(glass_record, 3u32), paint_record], Messages::MATERIAL_RANGE, subsets: two),
                material_case(Verdict.Reject, "material-flags.pkg", [glass_record, with_flags(paint_record, 4u32)], Messages::MATERIAL_RANGE, subsets: two),
                material_case(Verdict.Reject, "material-occlusion.pkg", [glass_record, with_flags(paint_record, 2u32)], Messages::NEEDS_TEXTURE, subsets: two)
            ]


    private:
        const module Messages:
            MATERIAL_RECORDS: sview = "invalid cooked slot material records"
            MATERIAL_RANGE: sview = "cooked slot material is out of range"
            NEEDS_TEXTURE: sview = "cooked slot material lacks the texture it needs"
            MATERIAL_NAMES: sview = "invalid cooked slot material names"
            MATERIAL_NAME: sview = "invalid cooked slot material name"


        def finite(value: f64) -> NumberValue:
            return NumberValue{kind: NumberKind.Finite, finite_value: value}


        def nan() -> NumberValue:
            return NumberValue{kind: NumberKind.NaN}


        def positive_infinity() -> NumberValue:
            return NumberValue{kind: NumberKind.PositiveInfinity}


        def material(factors: darray[NumberValue], alpha_mode: u32, flags: u32) -> Material:
            return Material{factors: factors, alpha_mode: alpha_mode, flags: flags}


        def with_factor(source: Material, index: u32, replacement: NumberValue) -> Material can[Memory.Allocate, Abort.Panic]:
            factors: mutable darray[NumberValue] = []
            for factor_index in 0..<source.factors.count |source, factors|:
                factors.push(replacement if factor_index.u32() == index else source.factors[factor_index])
            return Material{factors: factors, alpha_mode: source.alpha_mode, flags: source.flags}


        def with_alpha_mode(source: Material, alpha_mode: u32) -> Material:
            return Material{factors: source.factors, alpha_mode: alpha_mode, flags: source.flags}


        def with_flags(source: Material, flags: u32) -> Material:
            return Material{factors: source.factors, alpha_mode: source.alpha_mode, flags: flags}


        def material_case(verdict: Verdict, file_name: sview, materials: darray[Material], expected_diagnostic: sview,
            material_slots: u32 = 2u32, has_subsets: bool = true, has_material_slots: bool = true,
            has_material_records: bool = true, subsets: darray[Subset] = [], material_stride: sview = "48",
            omitted_fields: darray[sview] = [], material_names: darray[sview] = [],
            has_material_name_payload: bool = false, material_name_payload: darray[u8] = [], skinned: bool = false) -> Case:
            return Case{
                verdict: verdict,
                file_name: file_name,
                triangle_count: 2u32,
                has_subsets: has_subsets,
                subsets: subsets,
                has_material_slots: has_material_slots,
                material_slots: material_slots,
                has_material_records: has_material_records,
                materials: materials,
                material_stride: material_stride,
                omitted_fields: omitted_fields,
                material_names: material_names,
                has_material_name_payload: has_material_name_payload,
                material_name_payload: material_name_payload,
                skinned: skinned,
                expected_diagnostic: expected_diagnostic
            }


        def too_long_name_payload() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            payload: mutable darray[u8] = [1u8, 1u8, 0u8, 0u8]
            for _ in 0..<257 |payload|:
                payload.push(97u8)
            for _ in 0..<4 |payload|:
                payload.push(0u8)
            return payload
