# Typed fixture descriptions for the strip texture cases in
# elisa-engine/scripts/geometry_subset_cases.py.

module EsGeometrySubsetTextureCases:
    public:
        const enum Verdict of u8:
            Accept
            Reject


        struct Material:
            factors: darray[f32]
            alpha_mode: u32
            flags: u32


        struct Reference:
            values: darray[u32]


        struct Case:
            verdict: Verdict
            file_name: sview
            expected_diagnostic: sview = ""
            materials: darray[Material] = []
            has_material_records: bool = true
            texture_names: darray[sview] = []
            references: darray[Reference] = []
            texture_stride: sview = "20"
            has_texture_count_override: bool = false
            texture_count_override: u32 = 0u32
            omitted_fields: darray[sview] = []


        def cases() -> darray[Case] can[Memory.Allocate, Abort.Panic, Console.Format]:
            zeros: darray[u32] = [0u32, 0u32, 0u32, 0u32]
            albedo: darray[u32] = [1u32, 0u32, 0u32, 0u32]
            zero_references: darray[Reference] = [Reference{values: zeros}, Reference{values: zeros}]
            albedo_references: darray[Reference] = [Reference{values: albedo}, Reference{values: zeros}]
            two: darray[Reference] = [
                Reference{values: [1u32, 0u32, 0u32, 0u32]},
                Reference{values: [2u32, 0u32, 0u32, 0u32]}
            ]
            all_references: darray[Reference] = [
                Reference{values: [1u32, 2u32, 3u32, 4u32]},
                Reference{values: [1u32, 2u32, 3u32, 4u32]}
            ]
            one: darray[Reference] = [Reference{values: albedo}]
            three: darray[Reference] = [Reference{values: albedo}, Reference{values: albedo}, Reference{values: albedo}]
            too_many_names: darray[sview] = []
            for index in 0..<65 |too_many_names|:
                too_many_names.push(f"image_{index}")

            return [
                texture_case("texture-count-zero.pkg", Messages::TEXTURE_RECORDS, [], zero_references),
                texture_case("texture-count-mismatch.pkg", Messages::TEXTURE_RECORDS, ["albedo"], albedo_references,
                    has_texture_count_override: true, texture_count_override: 2u32),
                texture_case("texture-too-many.pkg", Messages::TEXTURE_RECORDS, too_many_names, all_references),
                texture_case("texture-stride.pkg", Messages::TEXTURE_RECORDS, ["albedo"], albedo_references,
                    texture_stride: "12"),
                texture_case("texture-no-count.pkg", Messages::TEXTURE_RECORDS, ["albedo"], albedo_references,
                    omitted_fields: ["texture_count"]),
                texture_case("texture-no-names.pkg", Messages::TEXTURE_RECORDS, ["albedo"], albedo_references,
                    omitted_fields: ["texture_names_b64"]),
                texture_case("texture-no-stride.pkg", Messages::TEXTURE_RECORDS, ["albedo"], albedo_references,
                    omitted_fields: ["slot_texture_stride"]),
                texture_case("texture-no-records.pkg", Messages::TEXTURE_RECORDS, ["albedo"], albedo_references,
                    omitted_fields: ["slot_textures_b64"]),
                texture_case("texture-short.pkg", Messages::TEXTURE_RECORDS, ["albedo"], one),
                texture_case("texture-long.pkg", Messages::TEXTURE_RECORDS, ["albedo"], three),
                texture_case("texture-without-materials.pkg", Messages::TEXTURE_RECORDS, ["albedo"], albedo_references,
                    has_material_records: false, materials: []),
                texture_case("texture-duplicate.pkg", Messages::SECTION_NAME, ["albedo", "albedo"], two),
                named("texture-mesh.pkg", "mesh"),
                named("texture-manifest.pkg", "manifest"),
                named("texture-empty-name.pkg", ""),
                named("texture-uppercase.pkg", "Albedo"),
                named("texture-path.pkg", "../albedo"),
                named("texture-nul.pkg", "albedo\0x"),
                named("texture-long-name.pkg", "aaaaaaaaaaaaaaaa"),
                texture_case("texture-beyond.pkg", Messages::MISSING_IMAGE, ["albedo"], [
                    Reference{values: albedo},
                    Reference{values: [0u32, 0u32, 2u32, 0u32]}
                ]),
                texture_case("texture-unsampled.pkg", Messages::UNSAMPLED, ["albedo", "spare"], albedo_references),
                texture_case("mask-without-base.pkg", Messages::NEEDS_TEXTURE, ["normal"], [
                    Reference{values: [0u32, 1u32, 0u32, 0u32]},
                    Reference{values: zeros}
                ], materials: [masked_material(), paint_material()]),
                texture_case("occlusion-without-surface.pkg", Messages::NEEDS_TEXTURE, ["albedo"], [
                    Reference{values: zeros},
                    Reference{values: albedo}
                ], materials: [glass_material(), surfaced_material()])
            ]


    private:
        const module Messages:
            TEXTURE_RECORDS: sview = "invalid cooked slot texture records"
            SECTION_NAME: sview = "invalid cooked texture section name"
            MISSING_IMAGE: sview = "cooked slot texture names a missing image"
            UNSAMPLED: sview = "cooked texture image is never sampled"
            NEEDS_TEXTURE: sview = "cooked slot material lacks the texture it needs"


        def standard_materials() -> darray[Material] can[Memory.Allocate, Abort.Panic]:
            return [glass_material(), paint_material()]


        def glass_material() -> Material can[Memory.Allocate, Abort.Panic]:
            return Material{
                factors: [0.0f32, 0.0f32, 0.08f32, 0.5f32, 0.0f32, 0.9f32, 0.0f32, 0.0f32, 1.0f32, 0.5f32],
                alpha_mode: 2u32,
                flags: 0u32
            }


        def paint_material() -> Material can[Memory.Allocate, Abort.Panic]:
            return Material{
                factors: [0.08f32, 0.0f32, 0.0f32, 1.0f32, 0.25f32, 0.75f32, 1.0f32, 0.0f32, 0.0f32, 0.5f32],
                alpha_mode: 0u32,
                flags: 1u32
            }


        def masked_material() -> Material can[Memory.Allocate, Abort.Panic]:
            return Material{
                factors: [0.0f32, 0.5f32, 0.0f32, 1.0f32, 0.0f32, 0.9f32, 0.0f32, 0.0f32, 0.0f32, 0.25f32],
                alpha_mode: 1u32,
                flags: 0u32
            }


        def surfaced_material() -> Material can[Memory.Allocate, Abort.Panic]:
            return Material{
                factors: [1.0f32, 1.0f32, 1.0f32, 1.0f32, 1.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.5f32],
                alpha_mode: 0u32,
                flags: 3u32
            }


        def texture_case(file_name: sview, expected_diagnostic: sview, texture_names: darray[sview],
            references: darray[Reference], materials: darray[Material] = [],
            has_material_records: bool = true, texture_stride: sview = "20",
            has_texture_count_override: bool = false, texture_count_override: u32 = 0u32,
            omitted_fields: darray[sview] = []) -> Case can[Memory.Allocate, Abort.Panic]:
            material_records: mutable darray[Material] = materials
            if has_material_records and materials.count == 0:
                material_records <- standard_materials()
            return Case{
                verdict: Verdict.Reject,
                file_name: file_name,
                expected_diagnostic: expected_diagnostic,
                materials: material_records,
                has_material_records: has_material_records,
                texture_names: texture_names,
                references: references,
                texture_stride: texture_stride,
                has_texture_count_override: has_texture_count_override,
                texture_count_override: texture_count_override,
                omitted_fields: omitted_fields
            }


        def named(file_name: sview, name: sview) -> Case can[Memory.Allocate, Abort.Panic]:
            return texture_case(file_name, Messages::SECTION_NAME, [name], [
                Reference{values: [1u32, 0u32, 0u32, 0u32]},
                Reference{values: [0u32, 0u32, 0u32, 0u32]}
            ])
