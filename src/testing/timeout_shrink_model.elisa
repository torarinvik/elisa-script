# Rerun-confirmed timeout/termination shrink evidence.
#
# This module records candidate budgets; it never launches or kills a process.
# A host adapter reruns the same world at smaller timeouts and records both
# accepted and rejected comparison outcomes. Only accepted attempts reduce the
# active timeout. Explicit exhaustion is an adapter claim, not proof that every
# possible timeout was tested.

module EsDifferentialTimeout:
    using EsDifferential

    public:
        const module Limits:
            CANDIDATES: usize = 64


        const enum DifferentialTimeoutSide of u8:
            Reference
            Candidate


        const enum DifferentialTimeoutState of u8:
            Planned
            Running
            CandidatePending
            Complete
            Cancelled


        const enum DifferentialTimeoutEvent of u8:
            Begin
            Propose
            Accept
            Reject
            Exhaust
            Cancel


        struct DifferentialTimeoutPolicy:
            side: DifferentialTimeoutSide
            minimum_steps: u64 = 1
            maximum_candidates: usize = Limits::CANDIDATES
            mismatch_kind: DifferentialDifferenceKind


        struct DifferentialTimeoutCandidate:
            ordinal: usize
            timeout_steps: u64
            comparison_fingerprint: u64
            observed_kind: DifferentialDifferenceKind
            accepted: bool = false


        struct DifferentialTimeoutSession:
            policy: DifferentialTimeoutPolicy
            state: DifferentialTimeoutState = DifferentialTimeoutState.Planned
            current_timeout_steps: u64
            pending: DifferentialTimeoutCandidate = DifferentialTimeoutCandidate{ordinal: 0, timeout_steps: 0, comparison_fingerprint: 0, observed_kind: DifferentialDifferenceKind.Equal}
            has_pending: bool = false
            candidates: darray[DifferentialTimeoutCandidate] = []
            exhausted: bool = false
            initial_timeout_steps: u64


        error DifferentialTimeoutError:
            InvalidState
            InvalidEvent
            PolicyInvalid
            TimeoutInvalid
            CandidateOrderInvalid
            CandidateNotPending
            CandidateNotSmaller
            MismatchCategory
            CandidateLimitExceeded
            MinimalityUnproven
            CancelNotReady
            CandidateDecisionInvalid
            ComparisonKindInvalid


    private:
        def differential_timeout_side_valid(side: DifferentialTimeoutSide) -> bool:
            return side in {DifferentialTimeoutSide.Reference, DifferentialTimeoutSide.Candidate}


        def differential_timeout_state_valid(state: DifferentialTimeoutState) -> bool:
            return state in {DifferentialTimeoutState.Planned, DifferentialTimeoutState.Running, DifferentialTimeoutState.CandidatePending, DifferentialTimeoutState.Complete, DifferentialTimeoutState.Cancelled}


        def differential_timeout_event_valid(event: DifferentialTimeoutEvent) -> bool:
            return event in {DifferentialTimeoutEvent.Begin, DifferentialTimeoutEvent.Propose, DifferentialTimeoutEvent.Accept, DifferentialTimeoutEvent.Reject, DifferentialTimeoutEvent.Exhaust, DifferentialTimeoutEvent.Cancel}


        def differential_timeout_comparison_kind_valid(kind: DifferentialDifferenceKind) -> bool:
            return kind in {DifferentialDifferenceKind.Equal, DifferentialDifferenceKind.Engine, DifferentialDifferenceKind.ExitStatus, DifferentialDifferenceKind.Error, DifferentialDifferenceKind.Stdout, DifferentialDifferenceKind.Stderr, DifferentialDifferenceKind.ReturnValue, DifferentialDifferenceKind.ObservationCount, DifferentialDifferenceKind.ObservationTrace, DifferentialDifferenceKind.ObservationValue, DifferentialDifferenceKind.Outcome, DifferentialDifferenceKind.CaseInvalid, DifferentialDifferenceKind.ObservationContract}


        def differential_timeout_policy_valid(policy: DifferentialTimeoutPolicy) -> bool:
            return differential_timeout_side_valid(policy.side) and policy.minimum_steps != 0 and policy.maximum_candidates != 0 and policy.maximum_candidates <= Limits::CANDIDATES and differential_timeout_comparison_kind_valid(policy.mismatch_kind) and policy.mismatch_kind != DifferentialDifferenceKind.Equal


    public:
        def validate_differential_timeout(session: DifferentialTimeoutSession&) -> bool error[DifferentialTimeoutError]:
            raise DifferentialTimeoutError.InvalidState if not differential_timeout_state_valid(session.state)
            raise DifferentialTimeoutError.PolicyInvalid if not differential_timeout_policy_valid(session.policy)
            raise DifferentialTimeoutError.TimeoutInvalid if session.initial_timeout_steps < session.policy.minimum_steps
            raise DifferentialTimeoutError.TimeoutInvalid if session.current_timeout_steps < session.policy.minimum_steps
            raise DifferentialTimeoutError.CandidateLimitExceeded if session.candidates.count > session.policy.maximum_candidates
            raise DifferentialTimeoutError.CandidateNotPending if session.state == DifferentialTimeoutState.CandidatePending and not session.has_pending
            raise DifferentialTimeoutError.InvalidState if session.state != DifferentialTimeoutState.CandidatePending and session.has_pending
            raise DifferentialTimeoutError.InvalidState if session.exhausted and session.state != DifferentialTimeoutState.Complete
            raise DifferentialTimeoutError.MinimalityUnproven if session.state == DifferentialTimeoutState.Complete and not session.exhausted
            expected_timeout_steps: mutable u64 = session.initial_timeout_steps
            for index in 0..<session.candidates.count |session|:
                candidate: DifferentialTimeoutCandidate = session.candidates[index]
                raise DifferentialTimeoutError.CandidateOrderInvalid if candidate.ordinal != index
                raise DifferentialTimeoutError.TimeoutInvalid if candidate.timeout_steps < session.policy.minimum_steps
                raise DifferentialTimeoutError.CandidateNotSmaller if candidate.timeout_steps >= expected_timeout_steps
                raise DifferentialTimeoutError.TimeoutInvalid if candidate.comparison_fingerprint == 0
                raise DifferentialTimeoutError.ComparisonKindInvalid if not differential_timeout_comparison_kind_valid(candidate.observed_kind)
                raise DifferentialTimeoutError.MismatchCategory if candidate.accepted and candidate.observed_kind != session.policy.mismatch_kind
                raise DifferentialTimeoutError.CandidateDecisionInvalid if not candidate.accepted and candidate.observed_kind == session.policy.mismatch_kind
                expected_timeout_steps <- candidate.timeout_steps if candidate.accepted
            raise DifferentialTimeoutError.CandidateOrderInvalid if session.current_timeout_steps != expected_timeout_steps
            if session.has_pending:
                raise DifferentialTimeoutError.CandidateOrderInvalid if session.pending.ordinal != session.candidates.count
                raise DifferentialTimeoutError.CandidateNotSmaller if session.pending.timeout_steps >= session.current_timeout_steps or session.pending.timeout_steps < session.policy.minimum_steps
                raise DifferentialTimeoutError.TimeoutInvalid if session.pending.comparison_fingerprint == 0
                raise DifferentialTimeoutError.ComparisonKindInvalid if not differential_timeout_comparison_kind_valid(session.pending.observed_kind)
                raise DifferentialTimeoutError.CandidateDecisionInvalid if session.pending.accepted
            return true


        def advance_differential_timeout(session: mutable DifferentialTimeoutSession&, event: DifferentialTimeoutEvent, candidate: DifferentialTimeoutCandidate = DifferentialTimeoutCandidate{ordinal: 0, timeout_steps: 0, comparison_fingerprint: 0, observed_kind: DifferentialDifferenceKind.Equal}) -> DifferentialTimeoutState error[DifferentialTimeoutError]:
            try validate_differential_timeout(session)
            raise DifferentialTimeoutError.InvalidEvent if not differential_timeout_event_valid(event)
            if event == DifferentialTimeoutEvent.Begin:
                raise DifferentialTimeoutError.InvalidState if session.state != DifferentialTimeoutState.Planned
                raise DifferentialTimeoutError.TimeoutInvalid if session.current_timeout_steps == 0
                session.state <- DifferentialTimeoutState.Running
            elif event == DifferentialTimeoutEvent.Propose:
                raise DifferentialTimeoutError.InvalidState if session.state != DifferentialTimeoutState.Running
                raise DifferentialTimeoutError.CandidateLimitExceeded if session.candidates.count >= session.policy.maximum_candidates
                raise DifferentialTimeoutError.CandidateOrderInvalid if candidate.ordinal != session.candidates.count
                raise DifferentialTimeoutError.CandidateNotSmaller if candidate.timeout_steps >= session.current_timeout_steps or candidate.timeout_steps < session.policy.minimum_steps
                raise DifferentialTimeoutError.CandidateDecisionInvalid if candidate.accepted
                raise DifferentialTimeoutError.TimeoutInvalid if candidate.comparison_fingerprint == 0
                raise DifferentialTimeoutError.ComparisonKindInvalid if not differential_timeout_comparison_kind_valid(candidate.observed_kind)
                session.pending <- candidate
                session.has_pending <- true
                session.state <- DifferentialTimeoutState.CandidatePending
            elif event == DifferentialTimeoutEvent.Accept:
                raise DifferentialTimeoutError.CandidateNotPending if session.state != DifferentialTimeoutState.CandidatePending or not session.has_pending
                raise DifferentialTimeoutError.MismatchCategory if session.pending.observed_kind != session.policy.mismatch_kind
                session.candidates.push(DifferentialTimeoutCandidate{ordinal: session.pending.ordinal, timeout_steps: session.pending.timeout_steps, comparison_fingerprint: session.pending.comparison_fingerprint, observed_kind: session.pending.observed_kind, accepted: true})
                session.current_timeout_steps <- session.pending.timeout_steps
                session.pending <- DifferentialTimeoutCandidate{ordinal: 0, timeout_steps: 0, comparison_fingerprint: 0, observed_kind: DifferentialDifferenceKind.Equal}
                session.has_pending <- false
                session.state <- DifferentialTimeoutState.Running
            elif event == DifferentialTimeoutEvent.Reject:
                raise DifferentialTimeoutError.CandidateNotPending if session.state != DifferentialTimeoutState.CandidatePending or not session.has_pending
                raise DifferentialTimeoutError.CandidateDecisionInvalid if session.pending.observed_kind == session.policy.mismatch_kind
                session.candidates.push(session.pending)
                session.pending <- DifferentialTimeoutCandidate{ordinal: 0, timeout_steps: 0, comparison_fingerprint: 0, observed_kind: DifferentialDifferenceKind.Equal}
                session.has_pending <- false
                session.state <- DifferentialTimeoutState.Running
            elif event == DifferentialTimeoutEvent.Exhaust:
                raise DifferentialTimeoutError.InvalidState if session.state != DifferentialTimeoutState.Running or session.has_pending
                session.exhausted <- true
                session.state <- DifferentialTimeoutState.Complete
            elif event == DifferentialTimeoutEvent.Cancel:
                raise DifferentialTimeoutError.CancelNotReady if session.state != DifferentialTimeoutState.Planned and session.state != DifferentialTimeoutState.Running and session.state != DifferentialTimeoutState.CandidatePending
                session.pending <- DifferentialTimeoutCandidate{ordinal: 0, timeout_steps: 0, comparison_fingerprint: 0, observed_kind: DifferentialDifferenceKind.Equal}
                session.has_pending <- false
                session.state <- DifferentialTimeoutState.Cancelled
            return session.state
