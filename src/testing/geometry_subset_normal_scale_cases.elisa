# Typed fixture descriptions for geometry_subset_normal_scale_cases.py.
# Package serialization is intentionally left to the geometry test adapter.

module EsGeometrySubsetNormalScaleCases:
    public:
        const enum Verdict of u8:
            Accept
            Reject


        const enum NumberKind of u8:
            Finite
            NaN
            PositiveInfinity


        struct NumberValue:
            kind: NumberKind
            finite_value: f64 = 0.0


        struct Subset:
            first_index: u32
            index_count: u32
            material_slot: u32


        struct Case:
            verdict: Verdict
            file_name: sview
            material_slots: u32
            triangle_count: u32 = 2u32
            subsets: darray[Subset] = []
            has_material_records: bool = false
            material_record_count: u32 = 0u32
            normal_scale_stride: sview = "4"
            has_normal_scale_data_field: bool = true
            normal_scales: darray[NumberValue] = []
            expected_diagnostic: sview = ""


        def cases() -> darray[Case] can[Memory.Allocate, Abort.Panic]:
            two_subsets: darray[Subset] = [
                Subset{first_index: 0u32, index_count: 3u32, material_slot: 0u32},
                Subset{first_index: 3u32, index_count: 3u32, material_slot: 1u32}
            ]
            one_subset: darray[Subset] = [Subset{first_index: 0u32, index_count: 6u32, material_slot: 0u32}]
            standard_scales: darray[NumberValue] = [
                NumberValue{kind: NumberKind.Finite, finite_value: 0.75},
                NumberValue{kind: NumberKind.Finite, finite_value: -0.75}
            ]
            one_scale: darray[NumberValue] = [NumberValue{kind: NumberKind.Finite, finite_value: 0.75}]
            return [
                normal_scale_case(
                    Verdict.Accept, "normal-scale.pkg", two_subsets, 2u32, true, 2u32,
                    standard_scales, "4", true, ""),
                normal_scale_case(
                    Verdict.Reject, "normal-scale-without-materials.pkg", two_subsets,
                    2u32, false, 0u32, standard_scales, "4", true, Messages::RECORDS),
                normal_scale_case(
                    Verdict.Reject, "normal-scale-stride.pkg", one_subset, 1u32, true,
                    1u32, one_scale, "8", true, Messages::RECORDS),
                normal_scale_case(
                    Verdict.Reject, "normal-scale-no-records.pkg", one_subset, 1u32,
                    true, 1u32, one_scale, "4", false, Messages::RECORDS),
                normal_scale_case(
                    Verdict.Reject, "normal-scale-count.pkg", one_subset, 1u32, true,
                    1u32, standard_scales, "4", true, Messages::RECORDS),
                normal_scale_case(
                    Verdict.Reject, "normal-scale-overflow.pkg", one_subset, 1u32, true,
                    1u32, [NumberValue{kind: NumberKind.Finite, finite_value: Limits::WICKED_NORMAL_SCALE + 1.0}],
                    "4", true, Messages::RANGE),
                normal_scale_case(
                    Verdict.Reject, "normal-scale-nan.pkg", one_subset, 1u32, true, 1u32,
                    [NumberValue{kind: NumberKind.NaN}], "4", true, Messages::RANGE),
                normal_scale_case(
                    Verdict.Reject, "normal-scale-infinite.pkg", one_subset, 1u32, true,
                    1u32, [NumberValue{kind: NumberKind.PositiveInfinity}], "4", true, Messages::RANGE)
            ]


    private:
        const module Limits:
            WICKED_NORMAL_SCALE: f64 = 65504.0


        const module Messages:
            RECORDS: sview = "invalid cooked slot normal scales"
            RANGE: sview = "cooked slot normal scale is out of range"


        def normal_scale_case(verdict: Verdict, file_name: sview, subsets: darray[Subset], material_slots: u32, has_material_records: bool, material_record_count: u32, normal_scales: darray[NumberValue], normal_scale_stride: sview, has_normal_scale_data_field: bool, expected_diagnostic: sview) -> Case:
            return Case{
                verdict: verdict,
                file_name: file_name,
                subsets: subsets,
                material_slots: material_slots,
                has_material_records: has_material_records,
                material_record_count: material_record_count,
                normal_scale_stride: normal_scale_stride,
                has_normal_scale_data_field: has_normal_scale_data_field,
                normal_scales: normal_scales,
                expected_diagnostic: expected_diagnostic
            }
