# Typed UV1 loader cases from elisa-engine/scripts/test_geometry_uv1.py.
# Atlas cooking and invalid-stream encoding remain caller responsibilities.
include "../runtime/python_text_model.elisa"
include "geometry_subset_manifest_model.elisa"

using EsPythonText


module EsGeometrySubsetUv1Cases:
    public:
        error Uv1CasesError:
            NonAsciiPackage
            PackageTooLarge
            AtlasEncodingMismatch
            MissingExpectedField
            InvalidExpectedChartCount


        const enum Verdict of u8:
            Accept
            Reject


        struct CookedInputs:
            atlas_package: sview
            skinned_package: sview
            invalid_uv1_stream_base64: sview
            atlas_vertex_count: u32
            skinned_vertex_count: u32


        struct Case:
            verdict: Verdict
            file_name: sview
            package_bytes: darray[u8]
            expected_diagnostic: sview
            loader_expectation: EsGeometrySubsetManifest::Expectation


        # Inputs are complete outputs of the asset-cooker adapter. Vertex
        # counts come from normalized geometry; chart counts are read from the
        # package as canonical unsigned decimals, with duplicate keys last-wins.
        def cases(inputs: CookedInputs) -> darray[Case] error[Uv1CasesError] can[Memory.Allocate, Abort.Panic]:
            raise Uv1CasesError.PackageTooLarge if len(inputs.atlas_package) > Limits::MAX_PACKAGE_BYTES
            raise Uv1CasesError.PackageTooLarge if len(inputs.skinned_package) > Limits::MAX_PACKAGE_BYTES
            raise Uv1CasesError.PackageTooLarge if len(inputs.invalid_uv1_stream_base64) > Limits::MAX_PACKAGE_BYTES
            for byte in inputs.atlas_package:
                raise Uv1CasesError.NonAsciiPackage if byte > 127u8
            for byte in inputs.skinned_package:
                raise Uv1CasesError.NonAsciiPackage if byte > 127u8
            for byte in inputs.invalid_uv1_stream_base64:
                raise Uv1CasesError.NonAsciiPackage if byte > 127u8
            has_encoded_atlas: bool = try uv1_has_field(inputs.atlas_package, Syntax::ENCODED_STREAM_NAME)
            has_raw_atlas: bool = try uv1_has_field(inputs.atlas_package, Syntax::RAW_STREAM_NAME)
            raise Uv1CasesError.AtlasEncodingMismatch if not has_encoded_atlas
            raise Uv1CasesError.AtlasEncodingMismatch if has_raw_atlas
            atlas_chart_count: u32 = try uv1_chart_count(inputs.atlas_package)
            skinned_chart_count: u32 = try uv1_chart_count(inputs.skinned_package)

            authored_package: darray[u8] = try uv1_authored_package(inputs.atlas_package)
            missing_data: darray[u8] = try uv1_without_data(inputs.atlas_package)
            bad_stride: darray[u8] = try uv1_mutate_field(inputs.atlas_package, Syntax::STRIDE_FIELD, Syntax::BAD_STRIDE)
            bad_source: darray[u8] = try uv1_mutate_field(inputs.atlas_package, Syntax::SOURCE_FIELD, Syntax::BAD_SOURCE)
            bad_revision: darray[u8] = try uv1_mutate_field(inputs.atlas_package, Syntax::REVISION_FIELD, Syntax::BAD_REVISION)
            bad_atlas_range: darray[u8] = try uv1_invalid_atlas(inputs.atlas_package, inputs.invalid_uv1_stream_base64)
            bad_encoding: darray[u8] = try uv1_mutate_field(inputs.atlas_package, Syntax::ENCODED_STREAM_FIELD, Syntax::CORRUPT_VALUE)
            return [
                Case{verdict: Verdict.Accept, file_name: "uv1.pkg", package_bytes: uv1_copy(inputs.atlas_package), expected_diagnostic: "", loader_expectation: uv1_panel_expectation(inputs.atlas_vertex_count, atlas_chart_count, true)},
                Case{verdict: Verdict.Accept, file_name: "uv1-authored.pkg", package_bytes: authored_package, expected_diagnostic: "", loader_expectation: uv1_panel_expectation(inputs.atlas_vertex_count, 0u32, false)},
                Case{verdict: Verdict.Accept, file_name: "skinned-uv1.pkg", package_bytes: uv1_copy(inputs.skinned_package), expected_diagnostic: "", loader_expectation: uv1_skinned_expectation(inputs.skinned_vertex_count, skinned_chart_count)},
                Case{verdict: Verdict.Reject, file_name: "uv1-no-data.pkg", package_bytes: missing_data, expected_diagnostic: Syntax::MISSING_DATA_DIAGNOSTIC, loader_expectation: EsGeometrySubsetManifest::Expectation{}},
                Case{verdict: Verdict.Reject, file_name: "uv1-stride.pkg", package_bytes: bad_stride, expected_diagnostic: Syntax::INVALID_STREAM_DIAGNOSTIC, loader_expectation: EsGeometrySubsetManifest::Expectation{}},
                Case{verdict: Verdict.Reject, file_name: "uv1-source.pkg", package_bytes: bad_source, expected_diagnostic: Syntax::UNKNOWN_SOURCE_DIAGNOSTIC, loader_expectation: EsGeometrySubsetManifest::Expectation{}},
                Case{verdict: Verdict.Reject, file_name: "uv1-revision.pkg", package_bytes: bad_revision, expected_diagnostic: Syntax::INVALID_ATLAS_DIAGNOSTIC, loader_expectation: EsGeometrySubsetManifest::Expectation{}},
                Case{verdict: Verdict.Reject, file_name: "uv1-atlas-range.pkg", package_bytes: bad_atlas_range, expected_diagnostic: Syntax::ATLAS_RANGE_DIAGNOSTIC, loader_expectation: EsGeometrySubsetManifest::Expectation{}},
                Case{verdict: Verdict.Reject, file_name: "uv1-corrupt-encoded.pkg", package_bytes: bad_encoding, expected_diagnostic: Syntax::INVALID_STREAM_DIAGNOSTIC, loader_expectation: EsGeometrySubsetManifest::Expectation{}}
            ]


    private:
        const module Limits:
            MAX_PACKAGE_BYTES: usize = 16777216


        const module Number:
            ASCII_ZERO: u8 = 48u8
            ASCII_NINE: u8 = 57u8
            DECIMAL_RADIX: u32 = 10u32
            MAX_U32: u32 = 4294967295u32


        const module Syntax:
            RAW_STREAM_NAME: sview = "uv1s_b64"
            ENCODED_STREAM_NAME: sview = "uv1s_meshopt_b64"
            ENCODED_STREAM_FIELD: sview = "uv1s_meshopt_b64="
            STRIDE_FIELD: sview = "uv1_stride="
            SOURCE_FIELD: sview = "uv1_source="
            SOURCE_NAME: sview = "uv1_source"
            REVISION_FIELD: sview = "uv1_generator_revision="
            MESHOPT_CODEC_FIELD: sview = "meshopt_codec="
            MESHOPT_CODEC_VALUE: sview = "meshopt_codec=meshoptimizer-v1.2"
            BAD_STRIDE: sview = "16"
            BAD_SOURCE: sview = "future"
            BAD_REVISION: sview = "unknown"
            CORRUPT_VALUE: sview = "AA=="
            AUTHORED_SOURCE: sview = "uv1_source=gltf"
            MISSING_DATA_DIAGNOSTIC: sview = "incomplete cooked geometry UV1 stream"
            INVALID_STREAM_DIAGNOSTIC: sview = "invalid cooked geometry UV1 stream"
            UNKNOWN_SOURCE_DIAGNOSTIC: sview = "unknown cooked geometry UV1 source"
            INVALID_ATLAS_DIAGNOSTIC: sview = "invalid cooked geometry UV1 atlas metadata"
            ATLAS_RANGE_DIAGNOSTIC: sview = "cooked geometry UV1 atlas coordinates are outside [0, 1]"


        const module AuthoredMetadata:
            REVISION: sview = "uv1_generator_revision"
            RESOLUTION: sview = "uv1_resolution"
            PADDING: sview = "uv1_padding"
            CHART_COUNT: sview = "uv1_chart_count"


        def uv1_copy(source: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            output: mutable darray[u8] = []
            output.reserve(len(source))
            for byte in source |output|:
                output.push(byte)
            return output


        def uv1_has_field(source: sview, field_name: sview) -> bool error[Uv1CasesError] can[Memory.Allocate, Abort.Panic]:
            lines: darray[sview] = try EsPythonText::split_lines(source) else failure:
                _ = failure
                raise Uv1CasesError.NonAsciiPackage
            for line in lines |field_name|:
                return true if uv1_field_name(line) == field_name
            return false


        # Python builds a dict from package lines, so duplicate keys are
        # last-wins before int() parses the chart count. Cooked packages emit
        # canonical unsigned decimal text here.
        def uv1_chart_count(source: sview) -> u32 error[Uv1CasesError] can[Memory.Allocate, Abort.Panic]:
            lines: darray[sview] = try EsPythonText::split_lines(source) else failure:
                _ = failure
                raise Uv1CasesError.NonAsciiPackage
            selected_value: mutable sview = ""
            found: mutable bool = false
            for line in lines |selected_value, found|:
                field_name: sview = uv1_field_name(line)
                if field_name == AuthoredMetadata::CHART_COUNT:
                    selected_value <- line[len(field_name) + 1:len(line)]
                    found <- true
            raise Uv1CasesError.MissingExpectedField if not found
            raise Uv1CasesError.InvalidExpectedChartCount if len(selected_value) == 0
            parsed: mutable u32 = 0u32
            for byte in selected_value |parsed|:
                raise Uv1CasesError.InvalidExpectedChartCount if byte < Number::ASCII_ZERO or byte > Number::ASCII_NINE
                digit: u32 = (byte - Number::ASCII_ZERO).u32()
                raise Uv1CasesError.InvalidExpectedChartCount if parsed > (Number::MAX_U32 - digit) / Number::DECIMAL_RADIX
                parsed <- parsed * Number::DECIMAL_RADIX + digit
            return parsed


        def uv1_authored_package(source: sview) -> darray[u8] error[Uv1CasesError] can[Memory.Allocate, Abort.Panic]:
            lines: darray[sview] = try EsPythonText::split_lines(source) else failure:
                _ = failure
                raise Uv1CasesError.NonAsciiPackage
            output: mutable darray[u8] = []
            emitted_line: mutable bool = false
            for line in lines |output, emitted_line|:
                field_name: sview = uv1_field_name(line)
                authored_metadata: bool = field_name == AuthoredMetadata::REVISION or field_name == AuthoredMetadata::RESOLUTION or field_name == AuthoredMetadata::PADDING or field_name == AuthoredMetadata::CHART_COUNT
                if not authored_metadata:
                    if field_name == Syntax::SOURCE_NAME:
                        uv1_append_line(output, emitted_line, line, true, Syntax::AUTHORED_SOURCE, "")
                    else:
                        uv1_append_line(output, emitted_line, line, false, "", "")
            output.push(10u8)
            raise Uv1CasesError.PackageTooLarge if output.count > Limits::MAX_PACKAGE_BYTES
            return output


        def uv1_panel_subsets() -> darray[EsGeometrySubsetManifest::Subset] can[Memory.Allocate, Abort.Panic]:
            return [
                EsGeometrySubsetManifest::Subset{first_index: 0u32, index_count: 6u32, material_slot: 1u32},
                EsGeometrySubsetManifest::Subset{first_index: 6u32, index_count: 6u32, material_slot: 0u32},
                EsGeometrySubsetManifest::Subset{first_index: 12u32, index_count: 6u32, material_slot: 1u32}
            ]


        def uv1_skinned_subsets() -> darray[EsGeometrySubsetManifest::Subset] can[Memory.Allocate, Abort.Panic]:
            return [
                EsGeometrySubsetManifest::Subset{first_index: 0u32, index_count: 6u32, material_slot: 1u32},
                EsGeometrySubsetManifest::Subset{first_index: 6u32, index_count: 6u32, material_slot: 0u32},
                EsGeometrySubsetManifest::Subset{first_index: 12u32, index_count: 12u32, material_slot: 1u32},
                EsGeometrySubsetManifest::Subset{first_index: 24u32, index_count: 6u32, material_slot: 0u32},
                EsGeometrySubsetManifest::Subset{first_index: 30u32, index_count: 6u32, material_slot: 1u32}
            ]


        def uv1_panel_materials() -> darray[EsGeometrySubsetManifest::Material] can[Memory.Allocate, Abort.Panic]:
            return [
                EsGeometrySubsetManifest::Material{
                    factors: [0.0f32, 0.0f32, 0.08f32, 1.0f32, 0.0f32, 0.9f32, 0.0f32, 0.0f32, 1.0f32, 0.5f32],
                    alpha_mode: 0u32,
                    flags: 1u32
                },
                EsGeometrySubsetManifest::Material{
                    factors: [0.08f32, 0.0f32, 0.0f32, 1.0f32, 0.25f32, 0.75f32, 1.0f32, 0.0f32, 0.0f32, 0.5f32],
                    alpha_mode: 0u32,
                    flags: 1u32
                }
            ]


        def uv1_panel_expectation(vertex_count: u32, chart_count: u32, generated_atlas: bool) -> EsGeometrySubsetManifest::Expectation can[Memory.Allocate, Abort.Panic]:
            source: sview = "xatlas" if generated_atlas else "gltf"
            resolution: u32 = 128u32 if generated_atlas else 0u32
            padding: u32 = 4u32 if generated_atlas else 0u32
            return EsGeometrySubsetManifest::Expectation{
                index_count: 18u32,
                material_slots: 2u32,
                subsets: uv1_panel_subsets(),
                has_materials: true,
                materials: uv1_panel_materials(),
                has_uv1: true,
                uv1: EsGeometrySubsetManifest::Uv1Expectation{
                    vertex_count: vertex_count,
                    source: source,
                    resolution: resolution,
                    padding: padding,
                    chart_count: chart_count
                }
            }


        def uv1_inverse_bind_values() -> darray[f32] can[Memory.Allocate, Abort.Panic]:
            return [
                1.0f32, 0.0f32, 0.0f32, 0.0f32,
                0.0f32, 1.0f32, 0.0f32, 0.0f32,
                0.0f32, 0.0f32, 1.0f32, 0.0f32,
                -2.0f32, 0.0f32, 0.25f32, 1.0f32,
                1.0f32, 0.0f32, 0.0f32, 0.0f32,
                0.0f32, 1.0f32, 0.0f32, 0.0f32,
                0.0f32, 0.0f32, 1.0f32, 0.0f32,
                -2.0f32, -1.0f32, 0.25f32, 1.0f32
            ]


        def uv1_skinned_expectation(vertex_count: u32, chart_count: u32) -> EsGeometrySubsetManifest::Expectation can[Memory.Allocate, Abort.Panic]:
            return EsGeometrySubsetManifest::Expectation{
                index_count: 36u32,
                material_slots: 2u32,
                subsets: uv1_skinned_subsets(),
                has_materials: true,
                materials: uv1_panel_materials(),
                has_animations: true,
                animation_count: 1u32,
                has_morphs: true,
                morph_count: 1u32,
                has_inverse_binds: true,
                inverse_bind_values: uv1_inverse_bind_values(),
                has_uv1: true,
                uv1: EsGeometrySubsetManifest::Uv1Expectation{
                    vertex_count: vertex_count,
                    source: "xatlas",
                    resolution: 128u32,
                    padding: 4u32,
                    chart_count: chart_count
                }
            }


        def uv1_starts_with(value: sview, prefix: sview) -> bool:
            return false if len(value) < len(prefix)
            return value[0:len(prefix)] == prefix


        def uv1_append_line(output: mutable darray[u8]&, emitted_line: mutable bool&, line: sview, replace_line: bool, field_prefix: sview, value: sview) -> void can[Memory.Allocate, Abort.Panic]:
            if emitted_line:
                output.push(10u8)
            if replace_line:
                for byte in field_prefix |output|:
                    output.push(byte)
                for byte in value |output|:
                    output.push(byte)
            else:
                for byte in line |output|:
                    output.push(byte)
            emitted_line <- true


        def uv1_mutate_field(source: sview, field_prefix: sview, value: sview) -> darray[u8] error[Uv1CasesError] can[Memory.Allocate, Abort.Panic]:
            lines: darray[sview] = try EsPythonText::split_lines(source) else failure:
                _ = failure
                raise Uv1CasesError.NonAsciiPackage
            output: mutable darray[u8] = []
            found: mutable bool = false
            emitted_line: mutable bool = false
            for line in lines |output, found, emitted_line|:
                matches_field: bool = not found and uv1_starts_with(line, field_prefix)
                if matches_field:
                    found <- true
                    uv1_append_line(output, emitted_line, line, true, field_prefix, value)
                else:
                    uv1_append_line(output, emitted_line, line, false, field_prefix, value)
            if not found:
                uv1_append_line(output, emitted_line, "", true, field_prefix, value)
            output.push(10u8)
            raise Uv1CasesError.PackageTooLarge if output.count > Limits::MAX_PACKAGE_BYTES
            return output


        def uv1_without_data(source: sview) -> darray[u8] error[Uv1CasesError] can[Memory.Allocate, Abort.Panic]:
            lines: darray[sview] = try EsPythonText::split_lines(source) else failure:
                _ = failure
                raise Uv1CasesError.NonAsciiPackage
            output: mutable darray[u8] = []
            emitted_line: mutable bool = false
            for line in lines |output, emitted_line|:
                field_name: sview = uv1_field_name(line)
                remove_line: bool = field_name == Syntax::RAW_STREAM_NAME or field_name == Syntax::ENCODED_STREAM_NAME
                if not remove_line:
                    uv1_append_line(output, emitted_line, line, false, "", "")
            output.push(10u8)
            raise Uv1CasesError.PackageTooLarge if output.count > Limits::MAX_PACKAGE_BYTES
            return output


        def uv1_invalid_atlas(source: sview, invalid_stream_base64: sview) -> darray[u8] error[Uv1CasesError] can[Memory.Allocate, Abort.Panic]:
            lines: darray[sview] = try EsPythonText::split_lines(source) else failure:
                _ = failure
                raise Uv1CasesError.NonAsciiPackage
            output: mutable darray[u8] = []
            emitted_line: mutable bool = false
            has_meshopt_codec: mutable bool = false
            for line in lines |output, emitted_line, has_meshopt_codec|:
                if uv1_starts_with(line, Syntax::MESHOPT_CODEC_FIELD):
                    has_meshopt_codec <- true
                field_name: sview = uv1_field_name(line)
                is_uv1_stream: bool = field_name == Syntax::RAW_STREAM_NAME or field_name == Syntax::ENCODED_STREAM_NAME
                if not is_uv1_stream:
                    uv1_append_line(output, emitted_line, line, false, "", "")
            if not has_meshopt_codec:
                uv1_append_line(output, emitted_line, "", true, Syntax::MESHOPT_CODEC_VALUE, "")
            uv1_append_line(output, emitted_line, "", true, Syntax::ENCODED_STREAM_FIELD, invalid_stream_base64)
            output.push(10u8)
            raise Uv1CasesError.PackageTooLarge if output.count > Limits::MAX_PACKAGE_BYTES
            return output


        def uv1_field_name(line: sview) -> sview:
            cursor: mutable usize = 0
            while cursor < len(line) |line, cursor|:
                return line[0:cursor] if sview_at(line, cursor) == 61u8
                cursor <- cursor + 1
            return line
