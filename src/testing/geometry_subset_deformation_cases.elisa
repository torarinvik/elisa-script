# Typed fixture generator for malformed cooked skin and morph packages.
module EsGeometrySubsetDeformationCases:
    public:
        const enum Verdict of u8:
            Reject


        struct Case:
            verdict: Verdict
            file_name: sview
            package_bytes: darray[u8]
            expected_diagnostic: sview


        def rejection_cases(morph: sview, corrupt_skin_indices: sview, corrupt_skin_weights: sview) -> darray[Case] can[Memory.Allocate, Abort.Panic]:
            morph_without_positions: darray[u8] = deformation_remove_position_lines(morph)
            morph_corrupt_position: darray[u8] = deformation_replace_first(morph, Syntax::POSITION_STREAM, Syntax::CORRUPT_SUFFIX)
            morph_corrupt_normal: darray[u8] = deformation_replace_first(morph, Syntax::NORMAL_STREAM, Syntax::CORRUPT_SUFFIX)
            morph_extra_target: mutable darray[u8] = deformation_copy(morph)
            for byte in Syntax::EXTRA_TARGET |morph_extra_target|:
                morph_extra_target.push(byte)
            return [
                Case{verdict: Verdict.Reject, file_name: "skin-corrupt-indices.pkg", package_bytes: deformation_copy(corrupt_skin_indices), expected_diagnostic: Syntax::INVALID_SKIN_STREAM},
                Case{verdict: Verdict.Reject, file_name: "skin-corrupt-weights.pkg", package_bytes: deformation_copy(corrupt_skin_weights), expected_diagnostic: Syntax::INVALID_SKIN_STREAM},
                Case{verdict: Verdict.Reject, file_name: "morph-missing-position.pkg", package_bytes: morph_without_positions, expected_diagnostic: Syntax::MORPH_POSITION_STREAM},
                Case{verdict: Verdict.Reject, file_name: "morph-corrupt-position.pkg", package_bytes: morph_corrupt_position, expected_diagnostic: Syntax::MORPH_POSITION_STREAM},
                Case{verdict: Verdict.Reject, file_name: "morph-corrupt-normal.pkg", package_bytes: morph_corrupt_normal, expected_diagnostic: Syntax::MORPH_NORMAL_STREAM},
                Case{verdict: Verdict.Reject, file_name: "morph-extra-target.pkg", package_bytes: morph_extra_target, expected_diagnostic: Syntax::MORPH_STREAM_FIELDS}
            ]


    private:
        const module Syntax:
            POSITION_RAW: sview = "morph_0_positions_b64="
            POSITION_STREAM: sview = "morph_0_positions_meshopt_b64="
            NORMAL_STREAM: sview = "morph_0_normals_meshopt_b64="
            CORRUPT_SUFFIX: sview = "AA=="
            EXTRA_TARGET: sview = "morph_1_positions_meshopt_b64=AA==\n"
            INVALID_SKIN_STREAM: sview = "invalid cooked geometry skin counts or influence streams"
            MORPH_POSITION_STREAM: sview = "morph position stream"
            MORPH_NORMAL_STREAM: sview = "morph normal stream"
            MORPH_STREAM_FIELDS: sview = "morph stream fields"


        def deformation_starts_with(value: sview, prefix: sview) -> bool:
            return false if len(value) < len(prefix)
            return value[0:len(prefix)] == prefix


        def deformation_copy(value: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            result: mutable darray[u8] = []
            result.reserve(len(value))
            for byte in value |result|:
                result.push(byte)
            return result


        def deformation_replace_first(value: sview, needle: sview, suffix: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            result: mutable darray[u8] = []
            cursor: mutable usize = 0
            while cursor <= len(value) and len(needle) <= len(value) - cursor |value, needle, suffix, result, cursor|:
                if value[cursor:cursor + len(needle)] == needle:
                    for byte in value[0:cursor] |result|:
                        result.push(byte)
                    for byte in needle |result|:
                        result.push(byte)
                    for byte in suffix |result|:
                        result.push(byte)
                    for byte in value[cursor + len(needle):len(value)] |result|:
                        result.push(byte)
                    return result
                cursor <- cursor + 1
            return deformation_copy(value)


        def deformation_append_line(output: mutable darray[u8]&, source: sview, start: usize, end: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            line: sview = source[start:end]
            if not deformation_starts_with(line, Syntax::POSITION_RAW) and not deformation_starts_with(line, Syntax::POSITION_STREAM):
                for byte in line |output|:
                    output.push(byte)
                output.push(10u8)
                return true
            return false


        # Python bytes.splitlines() followed by join(..., b"\\n") and a final
        # newline: package lines are ASCII and CR, LF, and CRLF are normalized.
        def deformation_remove_position_lines(source: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            output: mutable darray[u8] = []
            cursor: mutable usize = 0
            line_start: mutable usize = 0
            kept_lines: mutable usize = 0
            while cursor < len(source) |source, output, cursor, line_start, kept_lines|:
                byte: u8 = sview_at(source, cursor)
                if byte == 10u8 or byte == 13u8:
                    kept_lines <- kept_lines + 1 if deformation_append_line(output, source, line_start, cursor)
                    cursor <- cursor + 1
                    if byte == 13u8 and cursor < len(source) and sview_at(source, cursor) == 10u8:
                        cursor <- cursor + 1
                    line_start <- cursor
                else:
                    cursor <- cursor + 1
            if line_start < len(source):
                kept_lines <- kept_lines + 1 if deformation_append_line(output, source, line_start, len(source))
            if kept_lines == 0:
                output.push(10u8)
            return output
