# Typed fixture descriptions for the partition/slot cases in
# elisa-engine/scripts/geometry_subset_cases.py.
include "../../ports/elisa-engine/scripts/geometry_subset_package_builder_model.elisa"

using EsEngineGeometrySubsetPackageBuilder


module EsGeometrySubsetPartitionCases:
    public:
        const enum Verdict of u8:
            Accept
            Reject


        struct Case:
            verdict: Verdict
            file_name: sview
            input: StripPackageInput
            expected_diagnostic: sview = ""


        def cases() -> darray[Case] can[Memory.Allocate, Abort.Panic]:
            one: darray[Subset] = [Subset{first_index: 0u32, index_count: 6u32, material_slot: 0u32}]
            two: darray[Subset] = [
                Subset{first_index: 0u32, index_count: 3u32, material_slot: 0u32},
                Subset{first_index: 3u32, index_count: 3u32, material_slot: 1u32}
            ]
            sixteen: darray[Subset] = partition_subsets(16u32, 3u32)
            seventeen: darray[Subset] = partition_subsets(17u32, 3u32)
            return [
                partition_case(Verdict.Accept, "legacy.pkg", StripPackageInput{triangle_count: 2u32}, ""),
                partition_case(Verdict.Accept, "explicit-single.pkg", partition_input(2u32, one, 1u32), ""),
                partition_case(Verdict.Accept, "unused-slot.pkg", partition_input(2u32, [
                    Subset{first_index: 0u32, index_count: 3u32, material_slot: 2u32},
                    Subset{first_index: 3u32, index_count: 3u32, material_slot: 0u32}
                ], 3u32), ""),
                partition_case(Verdict.Accept, "sixteen.pkg", partition_input(16u32, sixteen, 16u32), ""),
                partition_case(Verdict.Accept, "skinned.pkg", StripPackageInput{triangle_count: 2u32, skinned: true}, ""),
                partition_case(Verdict.Reject, "gap.pkg", partition_input(3u32, [
                    Subset{first_index: 0u32, index_count: 3u32, material_slot: 0u32},
                    Subset{first_index: 6u32, index_count: 3u32, material_slot: 0u32}
                ], 1u32), Messages::PARTITION),
                partition_case(Verdict.Reject, "overlap.pkg", partition_input(3u32, [
                    Subset{first_index: 0u32, index_count: 6u32, material_slot: 0u32},
                    Subset{first_index: 3u32, index_count: 6u32, material_slot: 1u32}
                ], 2u32), Messages::PARTITION),
                partition_case(Verdict.Reject, "split-triangle.pkg", partition_input(2u32, [
                    Subset{first_index: 0u32, index_count: 4u32, material_slot: 0u32},
                    Subset{first_index: 4u32, index_count: 2u32, material_slot: 1u32}
                ], 2u32), Messages::PARTITION),
                partition_case(Verdict.Reject, "empty-subset.pkg", partition_input(2u32, [
                    Subset{first_index: 0u32, index_count: 6u32, material_slot: 0u32},
                    Subset{first_index: 6u32, index_count: 0u32, material_slot: 1u32}
                ], 2u32), Messages::PARTITION),
                partition_case(Verdict.Reject, "missing-slot.pkg", partition_input(2u32, [
                    Subset{first_index: 0u32, index_count: 3u32, material_slot: 0u32},
                    Subset{first_index: 3u32, index_count: 3u32, material_slot: 2u32}
                ], 2u32), Messages::MISSING_SLOT),
                partition_case(Verdict.Reject, "short.pkg", partition_input(3u32, two, 2u32), Messages::PARTITION),
                partition_case(Verdict.Reject, "overrun.pkg", partition_input(2u32, [
                    Subset{first_index: 0u32, index_count: 3u32, material_slot: 0u32},
                    Subset{first_index: 3u32, index_count: 6u32, material_slot: 1u32}
                ], 2u32), Messages::PARTITION),
                partition_case(Verdict.Reject, "wrapping.pkg", partition_input(2u32, [
                    Subset{first_index: 0u32, index_count: 3u32, material_slot: 0u32},
                    Subset{first_index: 3u32, index_count: 0xffffffffu32, material_slot: 1u32}
                ], 2u32), Messages::PARTITION),
                partition_case(Verdict.Reject, "triple-wrap.pkg", partition_input(2u32, [
                    Subset{first_index: 0u32, index_count: 0xc0000000u32, material_slot: 0u32},
                    Subset{first_index: 0xc0000000u32, index_count: 0xc0000000u32, material_slot: 0u32},
                    Subset{first_index: 0x80000000u32, index_count: 0xc0000000u32, material_slot: 0u32},
                    Subset{first_index: 0x40000000u32, index_count: 0xc0000006u32, material_slot: 0u32}
                ], 1u32), Messages::PARTITION),
                partition_case(Verdict.Reject, "seventeen.pkg", partition_input(17u32, seventeen, 16u32), Messages::RECORDS),
                partition_case(Verdict.Reject, "seventeen-slots.pkg", partition_input(2u32, [
                    Subset{first_index: 0u32, index_count: 6u32, material_slot: 16u32}
                ], 17u32), Messages::RECORDS),
                partition_case(Verdict.Reject, "zero-slots.pkg", partition_input(2u32, one, 0u32), Messages::RECORDS),
                partition_case(Verdict.Reject, "count-mismatch.pkg", StripPackageInput{
                    triangle_count: 2u32,
                    has_subsets: true,
                    subsets: two,
                    has_material_slots: true,
                    material_slots: 2u32,
                    has_subset_count_override: true,
                    subset_count_override: 3u32
                }, Messages::RECORDS),
                partition_case(Verdict.Reject, "stride.pkg", StripPackageInput{
                    triangle_count: 2u32,
                    has_subsets: true,
                    subsets: one,
                    has_material_slots: true,
                    material_slots: 1u32,
                    subset_stride: "16"
                }, Messages::RECORDS),
                partition_case(Verdict.Reject, "no-slots.pkg", StripPackageInput{
                    triangle_count: 2u32,
                    has_subsets: true,
                    subsets: one,
                    has_material_slots: true,
                    material_slots: 1u32,
                    omitted_fields: ["material_slots"]
                }, Messages::RECORDS),
                partition_case(Verdict.Reject, "no-records.pkg", StripPackageInput{
                    triangle_count: 2u32,
                    has_subsets: true,
                    subsets: one,
                    has_material_slots: true,
                    material_slots: 1u32,
                    omitted_fields: ["subsets_b64"]
                }, Messages::RECORDS),
                partition_case(Verdict.Accept, "skinned-subsets.pkg", partition_input(2u32, two, 2u32, true), ""),
                partition_case(Verdict.Accept, "skinned-single.pkg", partition_input(2u32, one, 1u32, true), "")
            ]


    private:
        const module Limits:
            MATERIAL_SLOTS: u32 = 16u32


        const module Messages:
            PARTITION: sview = "subsets do not partition the index stream"
            RECORDS: sview = "invalid cooked geometry subset records"
            MISSING_SLOT: sview = "subset names a missing material slot"


        def partition_input(triangle_count: u32, subsets: darray[Subset], material_slots: u32, skinned: bool = false) -> StripPackageInput:
            return StripPackageInput{
                triangle_count: triangle_count,
                has_subsets: true,
                subsets: subsets,
                has_material_slots: true,
                material_slots: material_slots,
                skinned: skinned
            }


        def partition_case(verdict: Verdict, file_name: sview, input: StripPackageInput, expected_diagnostic: sview) -> Case:
            return Case{verdict: verdict, file_name: file_name, input: input, expected_diagnostic: expected_diagnostic}


        def partition_subsets(count: u32, indices_per_subset: u32) -> darray[Subset] can[Memory.Allocate, Abort.Panic]:
            output: mutable darray[Subset] = []
            for index in 0..<count |output|:
                start: u32 = index * indices_per_subset
                output.push(Subset{first_index: start, index_count: indices_per_subset, material_slot: index % Limits::MATERIAL_SLOTS})
            return output
