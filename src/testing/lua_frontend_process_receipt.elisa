# Typed interpretation of one supervised child result in the Lua frontend
# differential workflow. Process outcomes, exec confirmation, RSS-guard
# enforcement, and cleanup facts stay separate so timeouts, signals, spawn
# failures, output limits, and uncertain descendants cannot become rejection.

module EsLuaFrontendProcessReceipt:
    using EsProcess

    public:
        const enum LuaFrontendChildRole of u8:
            EmitHeader
            EmitObject
            LinkCandidate
            LinkReference
            RunCandidate
            RunReference


        const enum LuaFrontendCleanupFact of u8:
            ConfirmedQuiescent
            DescendantsUnknown
            CleanupFailed


        const enum LuaFrontendSpawnFact of u8:
            ExecConfirmed
            ExecFailed
            ExecUnknown


        const enum LuaFrontendRssGuardFact of u8:
            Enforced
            LimitExceeded
            NotEnforced


        const enum LuaFrontendReceiptClass of u8:
            BuildSucceeded
            BuildFailed
            Accepted
            Rejected
            InfrastructureFailure


        struct LuaFrontendProcessReceipt:
            role: LuaFrontendChildRole = LuaFrontendChildRole.EmitHeader
            result: EsProcess::ProcessResult
            cleanup: LuaFrontendCleanupFact = LuaFrontendCleanupFact.DescendantsUnknown
            spawn: LuaFrontendSpawnFact = LuaFrontendSpawnFact.ExecUnknown
            rss_guard: LuaFrontendRssGuardFact = LuaFrontendRssGuardFact.NotEnforced
            classification: LuaFrontendReceiptClass = LuaFrontendReceiptClass.InfrastructureFailure


        error LuaFrontendProcessReceiptError:
            InvalidChildRole
            InvalidCleanupFact
            InvalidSpawnFact
            InvalidRssGuardFact
            InvalidExitStatus


    private:
        def lua_frontend_child_role_valid(role: LuaFrontendChildRole) -> bool:
            return role in {LuaFrontendChildRole.EmitHeader, LuaFrontendChildRole.EmitObject, LuaFrontendChildRole.LinkCandidate, LuaFrontendChildRole.LinkReference, LuaFrontendChildRole.RunCandidate, LuaFrontendChildRole.RunReference}


        def lua_frontend_cleanup_fact_valid(fact: LuaFrontendCleanupFact) -> bool:
            return fact in {LuaFrontendCleanupFact.ConfirmedQuiescent, LuaFrontendCleanupFact.DescendantsUnknown, LuaFrontendCleanupFact.CleanupFailed}


        def lua_frontend_spawn_fact_valid(fact: LuaFrontendSpawnFact) -> bool:
            return fact in {LuaFrontendSpawnFact.ExecConfirmed, LuaFrontendSpawnFact.ExecFailed, LuaFrontendSpawnFact.ExecUnknown}


        def lua_frontend_rss_guard_fact_valid(fact: LuaFrontendRssGuardFact) -> bool:
            return fact in {LuaFrontendRssGuardFact.Enforced, LuaFrontendRssGuardFact.LimitExceeded, LuaFrontendRssGuardFact.NotEnforced}


        def lua_frontend_role_is_build(role: LuaFrontendChildRole) -> bool:
            return role == LuaFrontendChildRole.EmitHeader or role == LuaFrontendChildRole.EmitObject or role == LuaFrontendChildRole.LinkCandidate or role == LuaFrontendChildRole.LinkReference


    public:
        def make_lua_frontend_process_receipt(role: LuaFrontendChildRole, result: EsProcess::ProcessResult, cleanup: LuaFrontendCleanupFact, spawn: LuaFrontendSpawnFact, rss_guard: LuaFrontendRssGuardFact) -> LuaFrontendProcessReceipt error[EsProcess::ProcessResultError, LuaFrontendProcessReceiptError]:
            raise LuaFrontendProcessReceiptError.InvalidChildRole if not lua_frontend_child_role_valid(role)
            raise LuaFrontendProcessReceiptError.InvalidCleanupFact if not lua_frontend_cleanup_fact_valid(cleanup)
            raise LuaFrontendProcessReceiptError.InvalidSpawnFact if not lua_frontend_spawn_fact_valid(spawn)
            raise LuaFrontendProcessReceiptError.InvalidRssGuardFact if not lua_frontend_rss_guard_fact_valid(rss_guard)
            checked_result: mutable EsProcess::ProcessResult = result
            _ = try EsProcess::validate_process_result(checked_result)
            raise LuaFrontendProcessReceiptError.InvalidExitStatus if result.kind == EsProcess::ProcessResultKind.Exited and result.exit_status > 255

            classification: mutable LuaFrontendReceiptClass = LuaFrontendReceiptClass.InfrastructureFailure
            if cleanup == LuaFrontendCleanupFact.ConfirmedQuiescent and spawn == LuaFrontendSpawnFact.ExecConfirmed and rss_guard == LuaFrontendRssGuardFact.Enforced and result.kind == EsProcess::ProcessResultKind.Exited:
                if lua_frontend_role_is_build(role):
                    classification <- LuaFrontendReceiptClass.BuildSucceeded if result.exit_status == 0
                    classification <- LuaFrontendReceiptClass.BuildFailed if result.exit_status != 0
                else:
                    classification <- LuaFrontendReceiptClass.Accepted if result.exit_status == 0
                    classification <- LuaFrontendReceiptClass.Rejected if result.exit_status != 0

            return LuaFrontendProcessReceipt{role: role, result: result, cleanup: cleanup, spawn: spawn, rss_guard: rss_guard, classification: classification}
