# Typed port of the direct morph metadata replacements in
# elisa-engine/scripts/geometry_subset_cases.py.
module EsGeometrySubsetMorphCases:
    public:
        error MorphCasesError:
            PackageTooLarge


        const enum Verdict of u8:
            Reject


        struct Case:
            verdict: Verdict
            file_name: sview
            package_bytes: darray[u8]
            expected_diagnostic: sview


        # Inputs are complete cooker-produced packages. Python bytes.replace
        # changes only the first match and returns the original bytes on miss.
        def cases(morph_package: sview) -> darray[Case] error[MorphCasesError] can[Memory.Allocate, Abort.Panic]:
            raise MorphCasesError.PackageTooLarge if len(morph_package) > Limits::MAX_PACKAGE_BYTES
            bad_stride: darray[u8] = morph_replace_first(morph_package, Syntax::POSITION_STRIDE_12, Syntax::POSITION_STRIDE_16)
            empty_targets: darray[u8] = morph_replace_first(morph_package, Syntax::TARGET_COUNT_1, Syntax::TARGET_COUNT_0)
            return [
                Case{verdict: Verdict.Reject, file_name: "morph-stride.pkg", package_bytes: bad_stride, expected_diagnostic: Syntax::MORPH_DIAGNOSTIC},
                Case{verdict: Verdict.Reject, file_name: "morph-empty.pkg", package_bytes: empty_targets, expected_diagnostic: Syntax::MORPH_DIAGNOSTIC}
            ]


    private:
        const module Limits:
            MAX_PACKAGE_BYTES: usize = 16777216


        const module Syntax:
            POSITION_STRIDE_12: sview = "morph_target_position_stride=12"
            POSITION_STRIDE_16: sview = "morph_target_position_stride=16"
            TARGET_COUNT_1: sview = "morph_targets=1"
            TARGET_COUNT_0: sview = "morph_targets=0"
            MORPH_DIAGNOSTIC: sview = "morph metadata"


        def morph_copy(source: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            result: mutable darray[u8] = []
            result.reserve(len(source))
            for byte in source |result|:
                result.push(byte)
            return result


        def morph_replace_first(source: sview, needle: sview, replacement: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            source_length: usize = len(source)
            needle_length: usize = len(needle)
            cursor: mutable usize = 0
            found: mutable bool = false
            while cursor <= source_length and needle_length <= source_length - cursor and not found |source, needle, cursor, found|:
                if source[cursor:cursor + needle_length] == needle:
                    found <- true
                else:
                    cursor <- cursor + 1
            if not found:
                return morph_copy(source)

            output: mutable darray[u8] = []
            output.reserve(source_length - needle_length + len(replacement))
            for byte in source[0:cursor] |output|:
                output.push(byte)
            for byte in replacement |output|:
                output.push(byte)
            for byte in source[cursor + needle_length:source_length] |output|:
                output.push(byte)
            return output
