# Typed ports of the meshoptimizer package mutations in
# elisa-engine/scripts/geometry_subset_cases.py.
include "../runtime/python_text_model.elisa"

using EsPythonText


module EsGeometrySubsetMeshoptCases:
    public:
        error MeshoptCasesError:
            NonAsciiPackage


        const enum Verdict of u8:
            Reject


        struct Case:
            verdict: Verdict
            file_name: sview
            package_bytes: darray[u8]
            expected_diagnostic: sview


        # The caller supplies the cooker-produced compressed package and the
        # raw position stream's Base64 encoding, preserving all other fields.
        def cases(compressed_package: sview, raw_positions_base64: sview) -> darray[Case] error[MeshoptCasesError] can[Memory.Allocate, Abort.Panic]:
            no_declaration: darray[u8] = try meshopt_mutate_field(compressed_package, Syntax::CODEC_FIELD, "", true)
            unknown_codec: darray[u8] = try meshopt_mutate_field(compressed_package, Syntax::CODEC_FIELD, Syntax::UNKNOWN_CODEC, false)
            duplicate_position: darray[u8] = try meshopt_mutate_field(compressed_package, Syntax::RAW_POSITIONS_FIELD, raw_positions_base64, false)
            corrupt_position: darray[u8] = try meshopt_mutate_field(compressed_package, Syntax::POSITION_STREAM_FIELD, Syntax::CORRUPT_VALUE, false)
            corrupt_indices: darray[u8] = try meshopt_mutate_field(compressed_package, Syntax::INDEX_STREAM_FIELD, Syntax::CORRUPT_VALUE, false)
            corrupt_tangent: darray[u8] = try meshopt_mutate_field(compressed_package, Syntax::TANGENT_STREAM_FIELD, Syntax::CORRUPT_VALUE, false)
            unknown_stream: darray[u8] = try meshopt_mutate_field(compressed_package, Syntax::UNKNOWN_STREAM_FIELD, Syntax::CORRUPT_VALUE, false)
            return [
                Case{verdict: Verdict.Reject, file_name: "meshopt-no-declaration.pkg", package_bytes: no_declaration, expected_diagnostic: Syntax::CODEC_DIAGNOSTIC},
                Case{verdict: Verdict.Reject, file_name: "meshopt-unknown-codec.pkg", package_bytes: unknown_codec, expected_diagnostic: Syntax::CODEC_DIAGNOSTIC},
                Case{verdict: Verdict.Reject, file_name: "meshopt-duplicate-position.pkg", package_bytes: duplicate_position, expected_diagnostic: Syntax::VERTEX_DIAGNOSTIC},
                Case{verdict: Verdict.Reject, file_name: "meshopt-corrupt-position.pkg", package_bytes: corrupt_position, expected_diagnostic: Syntax::VERTEX_DIAGNOSTIC},
                Case{verdict: Verdict.Reject, file_name: "meshopt-corrupt-indices.pkg", package_bytes: corrupt_indices, expected_diagnostic: Syntax::INDEX_DIAGNOSTIC},
                Case{verdict: Verdict.Reject, file_name: "meshopt-corrupt-tangent.pkg", package_bytes: corrupt_tangent, expected_diagnostic: Syntax::TANGENT_DIAGNOSTIC},
                Case{verdict: Verdict.Reject, file_name: "meshopt-unknown-stream.pkg", package_bytes: unknown_stream, expected_diagnostic: Syntax::UNKNOWN_STREAM_DIAGNOSTIC}
            ]


    private:
        const module Syntax:
            CODEC_FIELD: sview = "meshopt_codec="
            RAW_POSITIONS_FIELD: sview = "positions_b64="
            POSITION_STREAM_FIELD: sview = "positions_meshopt_b64="
            INDEX_STREAM_FIELD: sview = "indices_meshopt_b64="
            TANGENT_STREAM_FIELD: sview = "tangents_meshopt_b64="
            UNKNOWN_STREAM_FIELD: sview = "unknown_meshopt_b64="
            UNKNOWN_CODEC: sview = "meshoptimizer-v9"
            CORRUPT_VALUE: sview = "AA=="
            CODEC_DIAGNOSTIC: sview = "unsupported or inconsistent cooked geometry meshoptimizer codec"
            VERTEX_DIAGNOSTIC: sview = "invalid cooked geometry vertex streams"
            INDEX_DIAGNOSTIC: sview = "invalid cooked geometry index stream"
            TANGENT_DIAGNOSTIC: sview = "invalid cooked geometry tangent stream"
            UNKNOWN_STREAM_DIAGNOSTIC: sview = "unsupported meshoptimizer cooked geometry stream"


        def meshopt_starts_with(value: sview, prefix: sview) -> bool:
            return false if len(value) < len(prefix)
            return value[0:len(prefix)] == prefix


        def meshopt_copy_bytes(source: sview) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            result: mutable darray[u8] = []
            result.reserve(len(source))
            for byte in source |result|:
                result.push(byte)
            return result


        def meshopt_append_line(output: mutable darray[u8]&, line: sview, emitted_line: mutable bool&, replace: bool, field_prefix: sview, value: sview) -> void can[Memory.Allocate, Abort.Panic]:
            if emitted_line:
                output.push(10u8)
            if replace:
                for byte in field_prefix |output|:
                    output.push(byte)
                for byte in value |output|:
                    output.push(byte)
            else:
                for byte in line |output|:
                    output.push(byte)
            emitted_line <- true


        def meshopt_mutate_field(source: sview, field_prefix: sview, value: sview, remove_field: bool) -> darray[u8] error[MeshoptCasesError] can[Memory.Allocate, Abort.Panic]:
            for byte in source:
                raise MeshoptCasesError.NonAsciiPackage if byte > 127u8
            for byte in value:
                raise MeshoptCasesError.NonAsciiPackage if byte > 127u8

            lines: darray[sview] = try EsPythonText::split_lines(source) else err:
                _ = err
                raise MeshoptCasesError.NonAsciiPackage
            output: mutable darray[u8] = []
            field_found: mutable bool = false
            emitted_line: mutable bool = false
            for line in lines |output, field_found, emitted_line, field_prefix, value, remove_field|:
                matches_field: bool = not field_found and meshopt_starts_with(line, field_prefix)
                if matches_field:
                    field_found <- true
                    if not remove_field:
                        meshopt_append_line(output, line, emitted_line, true, field_prefix, value)
                else:
                    meshopt_append_line(output, line, emitted_line, false, field_prefix, value)

            if remove_field and not field_found:
                return meshopt_copy_bytes(source)
            if not remove_field and not field_found:
                meshopt_append_line(output, "", emitted_line, true, field_prefix, value)
            output.push(10u8)
            return output
