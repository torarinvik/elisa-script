# Typed projection from a completed differential comparison into the public
# Human/JSON/JUnit report record. The adapter keeps comparison precedence and
# runner identity intact; serializers remain downstream and cannot reinterpret
# a free-form reason string.
#
# This file is included at the end of differential.elisa, after EsDifferential
# declares DifferentialCase and DifferentialComparison.

module EsDifferentialReportAdapter:
    using EsDifferential
    using EsDifferentialReport

    public:
        error DifferentialReportAdapterError:
            InvalidCase
            InvalidComparison


    private:
        def report_adapter_difference_kind_valid(kind: DifferentialDifferenceKind) -> bool:
            return kind in {DifferentialDifferenceKind.Equal, DifferentialDifferenceKind.Engine, DifferentialDifferenceKind.ExitStatus, DifferentialDifferenceKind.Error, DifferentialDifferenceKind.Stdout, DifferentialDifferenceKind.Stderr, DifferentialDifferenceKind.ReturnValue, DifferentialDifferenceKind.ObservationCount, DifferentialDifferenceKind.ObservationTrace, DifferentialDifferenceKind.ObservationValue, DifferentialDifferenceKind.Outcome, DifferentialDifferenceKind.CaseInvalid, DifferentialDifferenceKind.ObservationContract}


        def report_adapter_run_outcome_valid(outcome: DifferentialRunOutcome) -> bool:
            return outcome in {DifferentialRunOutcome.Completed, DifferentialRunOutcome.NormalError, DifferentialRunOutcome.SpawnFailure, DifferentialRunOutcome.Crash, DifferentialRunOutcome.Timeout, DifferentialRunOutcome.OutputLimit, DifferentialRunOutcome.CompileFailure}


        def report_adapter_category(comparison: DifferentialComparison&) -> DifferentialReportCategory error[DifferentialReportAdapterError]:
            if comparison.kind == DifferentialDifferenceKind.CaseInvalid:
                return DifferentialReportCategory.InvalidInput
            if comparison.kind == DifferentialDifferenceKind.Engine:
                return DifferentialReportCategory.InfrastructureFailure
            if comparison.kind == DifferentialDifferenceKind.Error:
                return DifferentialReportCategory.ErrorMismatch
            if comparison.kind == DifferentialDifferenceKind.ObservationCount or comparison.kind == DifferentialDifferenceKind.ObservationTrace or comparison.kind == DifferentialDifferenceKind.ObservationValue or comparison.kind == DifferentialDifferenceKind.ObservationContract:
                return DifferentialReportCategory.ObservationMismatch
            if comparison.kind == DifferentialDifferenceKind.Outcome:
                return DifferentialReportCategory.Timeout if comparison.reference_outcome == DifferentialRunOutcome.Timeout or comparison.candidate_outcome == DifferentialRunOutcome.Timeout
                return DifferentialReportCategory.Crash if comparison.reference_outcome == DifferentialRunOutcome.Crash or comparison.candidate_outcome == DifferentialRunOutcome.Crash
                return DifferentialReportCategory.InfrastructureFailure if comparison.reference_outcome == DifferentialRunOutcome.OutputLimit or comparison.candidate_outcome == DifferentialRunOutcome.OutputLimit
                return DifferentialReportCategory.InfrastructureFailure if comparison.reference_outcome == DifferentialRunOutcome.SpawnFailure or comparison.candidate_outcome == DifferentialRunOutcome.SpawnFailure or comparison.reference_outcome == DifferentialRunOutcome.CompileFailure or comparison.candidate_outcome == DifferentialRunOutcome.CompileFailure
                return DifferentialReportCategory.ErrorMismatch if comparison.reference_outcome == DifferentialRunOutcome.NormalError or comparison.candidate_outcome == DifferentialRunOutcome.NormalError
                return DifferentialReportCategory.ProcessFailure
            if comparison.kind == DifferentialDifferenceKind.ExitStatus or comparison.kind == DifferentialDifferenceKind.Stdout or comparison.kind == DifferentialDifferenceKind.Stderr or comparison.kind == DifferentialDifferenceKind.ReturnValue:
                return DifferentialReportCategory.ValueMismatch
            raise DifferentialReportAdapterError.InvalidComparison


    public:
        def make_differential_report(case: DifferentialCase&, reference: DifferentialRun&, candidate: DifferentialRun&, format: DifferentialReportFormat = DifferentialReportFormat.Json, artifact_path: sview = "") -> DifferentialReport error[DifferentialReportError, DifferentialReportAdapterError, DifferentialRunnerError] can[Memory.Allocate, Abort.Panic]:
            case_check: DifferentialCaseCheck = validate_differential_case(case)
            raise DifferentialReportAdapterError.InvalidCase if not case_check.valid
            raise DifferentialReportAdapterError.InvalidComparison if not report_adapter_run_outcome_valid(reference.outcome) or not report_adapter_run_outcome_valid(candidate.outcome)
            comparison: DifferentialComparison = try compare_differential_case_runs(case, reference, candidate)
            raise DifferentialReportAdapterError.InvalidComparison if not report_adapter_difference_kind_valid(comparison.kind)
            raise DifferentialReportAdapterError.InvalidComparison if not report_adapter_run_outcome_valid(comparison.reference_outcome) or not report_adapter_run_outcome_valid(comparison.candidate_outcome)
            category: mutable DifferentialReportCategory = DifferentialReportCategory.None
            if not comparison.equal:
                category <- try report_adapter_category(comparison)
            inconclusive: bool = not comparison.equal and (comparison.kind == DifferentialDifferenceKind.Engine or (comparison.kind == DifferentialDifferenceKind.Outcome and category == DifferentialReportCategory.InfrastructureFailure))
            status: DifferentialReportStatus = DifferentialReportStatus.Passed if comparison.equal else DifferentialReportStatus.Inconclusive if inconclusive else DifferentialReportStatus.Failed
            summary: sview = "differential comparison equal" if comparison.equal else comparison.reason if comparison.reason != "" else "differential comparison mismatch"
            report: mutable DifferentialReport = DifferentialReport{format: format, status: status, category: category, case_name: case.name, summary: summary, reference_engine: case.reference.name, candidate_engine: case.candidate.name, artifact_path: artifact_path}
            try validate_differential_report(report)
            return report
