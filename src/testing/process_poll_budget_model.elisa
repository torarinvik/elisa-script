# Pure bounded wait-attempt accounting. No clock, syscall or ownership claim.
module EsProcessPollBudget:
    public:
        error PollBudgetError:
            InvalidLimit
            Exhausted


        # Charge before every native wait attempt, including interrupted ones.
        # consumed < limit guarantees addition cannot wrap, even at u64::MAX.
        def take_poll(consumed: u64, limit: u64) -> u64 error[PollBudgetError]:
            raise PollBudgetError.InvalidLimit if limit == 0u64
            raise PollBudgetError.Exhausted if consumed >= limit
            return consumed + 1u64
