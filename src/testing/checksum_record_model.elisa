# Exact default text-mode SHA-256 record emitted by /usr/bin/shasum 6.02.
# This checks formatting only; it computes no digest and proves no tool identity.
# Source qualification must still bind the host checksum tool and its runtime.
include "../../vendor/elisa-compiler/elisacore_std/elisacore_runtime.elisa"

module EsChecksumRecord:
    public:
        const module Limits:
            FILENAME_BYTES: usize = 4096
            DIGEST_BYTES: usize = 64
            RECORD_BYTES: usize = 8260


        error RecordError:
            InvalidDigest
            InvalidFilename
            FilenameTooLong


        # Filename bytes are literal, not shell syntax or UTF-8 text. Shasum
        # escapes LF/backslash and adds a leading backslash if either occurs.
        # Fixed bounds and exact length precede every observed-byte read.
        def sha256_text_record_matches(observed: sview, digest: sview, filename: sview) -> bool error[RecordError]:
            raise RecordError.InvalidDigest if sview_len(digest) != Limits::DIGEST_BYTES
            for byte in digest:
                raise RecordError.InvalidDigest if not ((byte >= 48u8 and byte <= 57u8) or (byte >= 97u8 and byte <= 102u8))
            count: usize = sview_len(filename)
            raise RecordError.InvalidFilename if count == 0
            raise RecordError.FilenameTooLong if count > Limits::FILENAME_BYTES
            escaped: mutable bool = false
            encoded_count: mutable usize = count
            for byte in filename |escaped, encoded_count|:
                raise RecordError.InvalidFilename if byte == 0u8
                if byte == 92u8 or byte == 10u8:
                    escaped <- true
                    encoded_count <- encoded_count + 1
            expected_count: usize = Limits::DIGEST_BYTES + 2 + encoded_count + 1 + (1 if escaped else 0)
            return false if sview_len(observed) != expected_count or expected_count > Limits::RECORD_BYTES
            offset: mutable usize = 0
            if escaped:
                return false if sview_at(observed, offset) != 92u8
                offset <- offset + 1
            for byte in digest |offset|:
                return false if sview_at(observed, offset) != byte
                offset <- offset + 1
            return false if sview_at(observed, offset) != 32u8 or sview_at(observed, offset + 1) != 32u8
            offset <- offset + 2
            for byte in filename |offset|:
                if byte == 92u8 or byte == 10u8:
                    return false if sview_at(observed, offset) != 92u8
                    offset <- offset + 1
                    encoded: u8 = 92u8 if byte == 92u8 else 110u8
                    return false if sview_at(observed, offset) != encoded
                else:
                    return false if sview_at(observed, offset) != byte
                offset <- offset + 1
            return offset + 1 == expected_count and sview_at(observed, offset) == 10u8
