# Typed fixture descriptions for geometry_subset_clearcoat_cases.py.
# Package serialization is intentionally left to the geometry test adapter.

module EsGeometrySubsetClearcoatCases:
    public:
        const enum Verdict of u8:
            Accept
            Reject


        const enum NumberKind of u8:
            Finite
            NaN


        struct NumberValue:
            kind: NumberKind
            finite_value: f64 = 0.0


        struct ClearcoatFactors:
            factor: NumberValue
            roughness: NumberValue
            normal_scale: NumberValue


        struct Subset:
            first_index: u32
            index_count: u32
            material_slot: u32


        struct Case:
            verdict: Verdict
            file_name: sview
            material_slots: u32
            triangle_count: u32 = 2u32
            subsets: darray[Subset] = []
            has_material_records: bool = false
            material_record_count: u32 = 0u32
            clearcoat_factor_stride: sview = "12"
            has_clearcoat_factor_data_field: bool = true
            clearcoat_factors: darray[ClearcoatFactors] = []
            expected_diagnostic: sview = ""


        def cases() -> darray[Case] can[Memory.Allocate, Abort.Panic]:
            one_subset: darray[Subset] = [Subset{first_index: 0u32, index_count: 6u32, material_slot: 0u32}]
            valid_factors: darray[ClearcoatFactors] = [ClearcoatFactors{
                factor: NumberValue{kind: NumberKind.Finite, finite_value: 0.8},
                roughness: NumberValue{kind: NumberKind.Finite, finite_value: 0.35},
                normal_scale: NumberValue{kind: NumberKind.Finite, finite_value: 0.6}
            }]
            return [
                clearcoat_case(
                    Verdict.Accept, "clearcoat-factors.pkg", one_subset, 1u32, true,
                    1u32, valid_factors, "12", true, ""),
                clearcoat_case(
                    Verdict.Reject, "clearcoat-factors-without-materials.pkg", one_subset,
                    1u32, false, 0u32, valid_factors, "12", true, Messages::RECORDS),
                clearcoat_case(
                    Verdict.Reject, "clearcoat-factors-stride.pkg", one_subset, 1u32,
                    true, 1u32, valid_factors, "4", true, Messages::RECORDS),
                clearcoat_case(
                    Verdict.Reject, "clearcoat-factors-missing-data.pkg", one_subset, 1u32,
                    true, 1u32, valid_factors, "12", false, Messages::RECORDS),
                clearcoat_case(
                    Verdict.Reject, "clearcoat-factors-count.pkg", one_subset, 1u32, true,
                    1u32, [valid_factors[0], valid_factors[0]], "12", true, Messages::RECORDS),
                clearcoat_case(
                    Verdict.Reject, "clearcoat-factor-negative.pkg", one_subset, 1u32,
                    true, 1u32, [ClearcoatFactors{
                        factor: NumberValue{kind: NumberKind.Finite, finite_value: -0.01},
                        roughness: NumberValue{kind: NumberKind.Finite, finite_value: 0.0},
                        normal_scale: NumberValue{kind: NumberKind.Finite, finite_value: 1.0}
                    }], "12", true, Messages::RANGE),
                clearcoat_case(
                    Verdict.Reject, "clearcoat-roughness-overflow.pkg", one_subset, 1u32,
                    true, 1u32, [ClearcoatFactors{
                        factor: NumberValue{kind: NumberKind.Finite, finite_value: 0.5},
                        roughness: NumberValue{kind: NumberKind.Finite, finite_value: 1.01},
                        normal_scale: NumberValue{kind: NumberKind.Finite, finite_value: 1.0}
                    }], "12", true, Messages::RANGE),
                clearcoat_case(
                    Verdict.Reject, "clearcoat-normal-scale-overflow.pkg", one_subset,
                    1u32, true, 1u32, [ClearcoatFactors{
                        factor: NumberValue{kind: NumberKind.Finite, finite_value: 0.5},
                        roughness: NumberValue{kind: NumberKind.Finite, finite_value: 0.5},
                        normal_scale: NumberValue{kind: NumberKind.Finite, finite_value: Limits::WICKED_NORMAL_SCALE + 1.0}
                    }], "12", true, Messages::RANGE),
                clearcoat_case(
                    Verdict.Reject, "clearcoat-normal-scale-nan.pkg", one_subset, 1u32,
                    true, 1u32, [ClearcoatFactors{
                        factor: NumberValue{kind: NumberKind.Finite, finite_value: 0.5},
                        roughness: NumberValue{kind: NumberKind.Finite, finite_value: 0.5},
                        normal_scale: NumberValue{kind: NumberKind.NaN}
                    }], "12", true, Messages::RANGE)
            ]


    private:
        const module Limits:
            WICKED_NORMAL_SCALE: f64 = 65504.0


        const module Messages:
            RECORDS: sview = "invalid cooked slot clearcoat factors"
            RANGE: sview = "cooked slot clearcoat factors are out of range"


        def clearcoat_case(verdict: Verdict, file_name: sview, subsets: darray[Subset], material_slots: u32, has_material_records: bool, material_record_count: u32, clearcoat_factors: darray[ClearcoatFactors], clearcoat_factor_stride: sview, has_clearcoat_factor_data_field: bool, expected_diagnostic: sview) -> Case:
            return Case{
                verdict: verdict,
                file_name: file_name,
                subsets: subsets,
                material_slots: material_slots,
                has_material_records: has_material_records,
                material_record_count: material_record_count,
                clearcoat_factor_stride: clearcoat_factor_stride,
                has_clearcoat_factor_data_field: has_clearcoat_factor_data_field,
                clearcoat_factors: clearcoat_factors,
                expected_diagnostic: expected_diagnostic
            }
